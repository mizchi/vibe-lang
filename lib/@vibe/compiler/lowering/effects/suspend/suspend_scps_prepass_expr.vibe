/// ============================================================
/// ADR-0076 Phase 3a+3b (#817, docs/internal/design/effect-evidence-passing.md 追記27-29):
/// suspend CPS -- lowering for the third handler class ("suspend": a
/// handler arm STORES `resume` as a first-class value and calls it later,
/// at most once, from a different dynamic extent -- exactly ADR-0068's
/// Async::suspend shape, the scheduler primitive @vibe/concurrent needs).
///
/// Trigger: a `handle` site where at least one arm references `resume` as a
/// bare VALUE (not only as the direct call `resume(x)` -- #942 keeps the
/// tail constraint on that form, and the checker's arm-scope binding of
/// `resume` makes the value form legal in declared-effect arms). Sites with
/// no value reference are completely untouched -- they keep today's
/// replay / Phase-2-inline / evidence-dict paths bit-for-bit.
///
/// Lowering (everything built from EXISTING AST nodes -- no new IR, no new
/// runtime type). Per EFFECT E (injected once, shared by every site and
/// clone -- 3b's call-crossing requires a step type independent of any one
/// handle site):
///
///   enum __ScpsStep_E {                    // variants keyed by NAME
///     __ScpsDone_E(R);                     // computation finished with R
///     __ScpsY_E_op(P..., (Q) -> __ScpsStep_E)  // one per DECLARED op:
///   }                                      //   payload + continuation
///
///   let rec __scps_bubble_E = (st, k) -> match st {   // step composition
///     __ScpsDone_E(v) => k(v),
///     __ScpsY_E_op(p.., kk) => __ScpsY_E_op(p.., (rv) ->
///       __scps_bubble_E(kk(rv), k))        // re-wrap: bubble one level up
///   }
///
/// Per triggered handle site: the body is split at each direct `perform`
/// on its evaluation spine into continuation closures producing
/// __ScpsStep_E values, and the whole handle expression becomes
///
///   let rec __scps_driveN = (st) -> match st {
///     __ScpsDone_E(v) => v,
///     __ScpsY_E_op(p.., k) => {
///       let __scps_onceN = [false]
///       let resume = (rv) -> if __scps_onceN[0] { diag + trap } else {
///         __scps_onceN[0] = true; __scps_driveN(k(rv)) }
///       ARM                              // original arm body, unchanged --
///     }                                  // `resume` is now a plain local
///   }
///   __scps_driveN(<split body>)
///
/// 3b (yield bubbling / selective CPS, wasm_of_ocaml-style): a call in the
/// body (or in a clone body) to a named top-level function `f` whose
/// declared row CONTAINS E is now supported. A CPS CLONE `__scps_cps_E_f`
/// is synthesized -- f's body run through the SAME spine split, so the
/// clone returns __ScpsStep_E (its direct performs become __ScpsY
/// constructions, its own calls to other row-carrying functions become
/// bubble compositions, recursively over a worklist). The ORIGINAL f is
/// left completely untouched for every other caller (tail-resumptive
/// handles via replay / Phase 2 / evidence-dict) -- the double-compilation
/// approach, so this pass never conflicts with those paths. Call sites in
/// suspend-lowered code become
///
///   let x = f(a)  REST   ==>   __scps_bubble_E(__scps_cps_E_f(a),
///                                              (x) -> <split REST>)
///   tail f(a)            ==>   __scps_cps_E_f(a)      // step passthrough
///
/// A clone's EFn carries eff=None deliberately: evidence_dict_pass scans
/// declared rows to build its needing set, and a clone (whose performs are
/// already gone) must not sink an effect's evidence eligibility.
///
///   An arm that stores `resume` and returns without calling it makes the
///   whole handle return the arm's value (the suspend). Calling the stored
///   closure later runs the remaining body up to the next perform, where the
///   SAME driver dispatches the next arm -- a scheduler receives the next
///   continuation exactly as ADR-0068 requires. One-shot is enforced
///   dynamically: the second call of the same continuation writes a
///   diagnostic to stderr and traps (assert(false) miscompiles inside
///   closures, #1095, and Exception::Throw would leak past a no-Error-row
///   entry as a raw exception -- see the trap construction below). Direct
///   tail `resume(v)` calls in a triggered arm route through the same
///   closure (codegen's prefer_bound_call), so the one-shot flag covers
///   them too.
///
/// Eligibility (checked per site and per clone; an INELIGIBLE triggered
/// site is a hard compile error via the returned error list -- never a
/// silent fallback, because a value-referencing arm cannot compile on the
/// replay path at all):
///   - every `perform` of a handled operation, and every call to a
///     row-carrying (needing) function, appears directly on the body's
///     let/seq/tail/branch-tail spine, which includes a `while` / `loop`
///     body (converted to a recursive step-returning closure, #1230/#1536 --
///     including one carrying `break` / `continue`, but not `return`).
///     `for` forms and nested expression positions are not eligible;
///   - every OTHER call in the body is provably unable to perform E:
///     a `perform` of another effect, a hand-audited pure builtin
///     (idp_pure_builtin_names), an enum/suberror constructor application,
///     or a named top-level function whose declared row is CONCRETE and
///     does not contain E (checker row soundness: an unhandled perform of
///     E inside f forces E -- or a row variable -- into f's declared row,
///     so a concrete E-free row cannot reach one). A row-VARIABLE row
///     (`with e` / `with X + e`) on a non-needing callee is
///     ineligible -- the variable could be instantiated to E via a closure
///     argument this pass cannot see;
///   - no nested handle, and no closure containing a handled-op perform or
///     needing call -- except an ABORTIVE handle (#1537: arms of another
///     effect that never mention `resume`, like an `Exception::Throw` catch),
///     which is split with its body and re-installed around every resumed
///     continuation (scps_split_handle).
/// Arm BODIES are unrestricted (under the driver they are plain code).
///
/// A grouped site uses one driver whose target table lists every handled
/// user effect. Its yields retain the source effect and operation identity;
/// non-resumable Exception arms protect only the body segments.
///
/// Runs BEFORE evidence_dict_pass on both backends (the linear
/// compile_wasi_module_linked_impl and, since #3009, the gc
/// backend_body_wasi_module_gc_impl), so that pass only ever sees the sites
/// this one left alone.
export fn suspend_cps_pass(_ stmts: Array[Stmt]) -> Array[String] {
  // A suspend site needs one driver for the whole group. Splitting first
  // hides sibling effects from its continuation and return-owner analysis.
  // Split only the ordinary handler sets left after those drivers exist.
  let errs = scps_lower_handle_sites(stmts)
  // The census describes the list as this pass left it, which is what the
  // split reads its binders from (#4041). Nothing after the pass keeps it
  // current, so it is not kept past the pass.
  if Array::length(errs) == 0 {
    for e in evidence_split_handler_sets_with_binders(stmts = stmts, binders = scps_census_kept()) {
      Array::push(errs, value = e)
    }
  } else ()
  scps_census_drop()
  errs
}

fn scps_lower_handle_sites(_ stmts: Array[Stmt]) -> Array[String] {
  scps_lower_handle_sites_with(stmts = stmts, extra = array_empty_str())
}

// review-lint: allow-program-walk (drives the pass: builds its tables, then rewrites each statement in turn)
/// `extra`: effects put in step mode although no arm stores `resume` -- the
/// retry below (#3540).
fn scps_lower_handle_sites_with(stmts: Array[Stmt], extra: Array[String]) -> Array[String] {
  let errs = array_empty_str()
  // A census kept from another statement list does not describe this one.
  scps_census_drop()
  // #3176: a call spelled like an audited pure builtin reaches the program's
  // own function when the program declares one; judge it by that row.
  idp_note_program_decls(stmts)
  // #1102 perf: allocation-free pre-scan. scps_rewrite reconstructs every
  // node, so it must only run on statements that actually contain a
  // triggered handle — and when NOTHING triggers (every ordinary program,
  // including the compiler itself), skip the fact-table construction
  // below entirely. See scps_expr_has_trigger.
  let mut any_trigger = false
  let mut i0 = 0
  while i0 < Array::length(stmts) {
    if scps_stmt_has_trigger(Array::get(stmts, at = i0)) {
      any_trigger = true
    } else {
      ()
    }
    i0 = i0 + 1
  }
  if !any_trigger {
    errs
  } else {
    let snapshot = Array::slice(stmts, start = 0, end = Array::length(stmts))
    let effect_defs = edp_collect_effect_defs(stmts)
    let fn_defs = edp_collect_fn_defs(stmts)
    let es_names = array_empty()
    let es_members_list = array_empty()
    edp_es_collect_into(stmts = stmts, es_names = es_names, es_members_list = es_members_list)
    let ctor_names = scps_collect_ctor_names(stmts)
    // Locally bound names, for `scps_inert_taint`'s callee test.
    scps_census_note(stmts)
    // #3182: a local alias of a top-level function is lowered as the
    // function. The binders are noted again because the dropped aliases
    // bound names; with no alias, the statements are as they were.
    if scps_inline_fn_aliases_stmts(stmts = stmts, fn_defs = fn_defs) {
      scps_census_drop()
    } else ()
    scps_census_note(stmts)
    let groups = scps_collect_groups(stmts)
    let ctx = (stmts, effect_defs, fn_defs, es_names, es_members_list, ctor_names, groups)
    let st = (scps_ctr_box(), array_empty_str(), array_empty_str(), array_empty_str(), array_empty_str(), scps_empty_stmts(), errs)
    scps_owner_reset()
    // closure-CPS (追記31 Vertical B) phase 1: the CPS-mode effect set.
    let cps_effs = scps_collect_cps_effs(stmts = stmts, groups = groups)
    scps_note_step_mode(cps_effs = cps_effs, extra = extra)
    let ecfgs = array_empty_ecfg()
    let mut ce = 0
    while ce < Array::length(cps_effs) {
      Array::push(ecfgs, value = scps_ecfg_for(ctx = ctx, eff = Array::get(cps_effs, at = ce)))
      ce = ce + 1
    }
    // phase 2 (prepass, ALL statements): step-split needing literals and fix
    // up arg conventions at E-row param positions. Records which effects got
    // step-compiled closure values (split_effs) for the phase-5 guard.
    let split_effs = array_empty_str()
    scps_prepass_stmts(stmts = stmts, ecfgs = ecfgs, ctx = ctx, st = st, split_effs = split_effs)
    // phase 3: transform triggered handle sites (scope threads the lexical
    // step-typed bindings down to each site).
    let scope = array_empty_scope()
    let mut i = 0
    while i < Array::length(stmts) {
      if scps_stmt_has_trigger(Array::get(stmts, at = i)) {
        Array::truncate(scps_cur_stmt, length = 0)
        Array::push(scps_cur_stmt, value = i)
        scps_set_owner_stmt(Array::get(stmts, at = i))
        match Array::get(stmts, at = i) {
          SLet(exported, is_rec, name, ty, expr) => Array::set(stmts, at = i, value = SLet(exported, is_rec, name, ty, scps_rewrite_root(e = expr, ctx = ctx, st = st, cps_effs = cps_effs, scope = scope))),
          SLetMut(name, ty, expr) => Array::set(stmts, at = i, value = SLetMut(name, ty, scps_rewrite_root(e = expr, ctx = ctx, st = st, cps_effs = cps_effs, scope = scope))),
          SExpr(expr) => Array::set(stmts, at = i, value = SExpr(scps_rewrite_root(e = expr, ctx = ctx, st = st, cps_effs = cps_effs, scope = scope))),
          STest(tn, expr) => Array::set(stmts, at = i, value = STest(tn, scps_rewrite_root(e = expr, ctx = ctx, st = st, cps_effs = cps_effs, scope = scope))),
          SBench(bn, expr) => Array::set(stmts, at = i, value = SBench(bn, scps_rewrite_root(e = expr, ctx = ctx, st = st, cps_effs = cps_effs, scope = scope))),
          _ => ()
        }
        scps_census_replaced(stmts = stmts, i = i)
      } else {
        ()
      }
      i = i + 1
    }
    // phase 4: process the clone worklist -- it can grow while being
    // processed (a clone's own body may need further clones).
    let (_, _, _, q_eff, q_fn, inj, _) = st
    let mut qi = 0
    while qi < Array::length(q_fn) {
      scps_set_owner_clone(eff = Array::get(q_eff, at = qi), fname = Array::get(q_fn, at = qi))
      scps_emit_clone(eff = Array::get(q_eff, at = qi), fname = Array::get(q_fn, at = qi), ctx = ctx, st = st)
      qi = qi + 1
    }
    let mut j = 0
    while j < Array::length(inj) {
      Array::push(stmts, value = Array::get(inj, at = j))
      j = j + 1
    }
    scps_census_appended(stmts)
    let guarded_members: Array[String] = []
    for target in split_effs {
      for member in scps_group_members(groups = groups, target = target) {
        if !edp_str_array_contains(arr = guarded_members, v = member) {
          Array::push(guarded_members, value = member)
        }
      }
    }
    // phase 5: convention-consistency guard.
    if Array::length(split_effs) > 0 {
      let mut gi = 0
      while gi < Array::length(stmts) {
        match scps_stmt_expr_of(Array::get(stmts, at = gi)) {
          Some(expr) => scps_guard_untriggered(e = expr, guard_effs = guarded_members, errs = errs),
          None => ()
        }
        gi = gi + 1
      }
    } else {
      ()
    }
    // #3540: a handle driven only for a `return` / `throw` arm calls a
    // function value of an effect no arm stores `resume` for, so nothing was
    // handed over in the step convention and that call was refused. Lower the
    // program again with those effects in step mode, which passes every such
    // value as a step; keep the refusal when that does not compile either
    // (the convention guard above refuses a handle of the effect that resumes
    // in place).
    let wanted = scps_step_mode_wanted()
    if Array::length(errs) > 0 && Array::length(wanted) > 0 && Array::length(extra) == 0 {
      Array::truncate(stmts, length = 0)
      for s0 in snapshot {
        Array::push(stmts, value = s0)
      }
      scps_census_drop()
      let retried = scps_lower_handle_sites_with(stmts = stmts, extra = wanted)
      if Array::length(retried) == 0 {
        retried
      } else {
        errs
      }
    } else {
      errs
    }
  }
}

// review-lint: allow-program-walk (drives the pass: builds its tables, then rewrites each statement in turn)
/// Phase 2 over every statement: step-split the literals that need a
/// CPS-mode effect and fix up argument conventions (scps_prepass_expr).
/// `split_effs` collects the effects something was step-compiled for.
fn scps_prepass_stmts(stmts: Array[Stmt], ecfgs: Array[(String, Array[String], Array[String])], ctx: (Array[Stmt], Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], Array[String], Array[Array[String]], Array[String], Array[(String, Array[String])]), st: (Array[Int], Array[String], Array[String], Array[String], Array[String], Array[Stmt], Array[String]), split_effs: Array[String]) -> Unit {
  let mut ip = 0
  while ip < (if Array::length(ecfgs) > 0 {
    Array::length(stmts)
  } else {
    0
  }) {
    scps_set_owner_stmt(Array::get(stmts, at = ip))
    match Array::get(stmts, at = ip) {
      // A TOP-LEVEL fn value is the 3b needing-fn world: the ORIGINAL must
      // stay untouched (dual entry -- cps callers go through the
      // __scps_cps_* clone), so the literal-split rule must not apply to
      // the top node itself; only its body's NESTED literals are prepass
      // material. Splitting it here double-wrapped the clone (emit_clone
      // re-split an already-split body into Done(Y(..))).
      SLet(exported, is_rec, name, ty, expr) => Array::set(stmts, at = ip, value = SLet(exported, is_rec, name, ty, match expr {
        EFn(tps, tbs, params, ret, eff, b) => EFn(tps, tbs, params, ret, eff, scps_prepass_expr(e = b, ecfgs = ecfgs, ctx = ctx, st = st, split_effs = split_effs, scope = scps_scope_bind_params(scope = array_empty_kind_scope(), params = params, eff = "", ctx = ctx))),
        _ => scps_prepass_expr(e = expr, ecfgs = ecfgs, ctx = ctx, st = st, split_effs = split_effs, scope = array_empty_kind_scope())
      })),
      SLetMut(name, ty, expr) => Array::set(stmts, at = ip, value = SLetMut(name, ty, match expr {
        EFn(tps, tbs, params, ret, eff, b) => EFn(tps, tbs, params, ret, eff, scps_prepass_expr(e = b, ecfgs = ecfgs, ctx = ctx, st = st, split_effs = split_effs, scope = scps_scope_bind_params(scope = array_empty_kind_scope(), params = params, eff = "", ctx = ctx))),
        _ => scps_prepass_expr(e = expr, ecfgs = ecfgs, ctx = ctx, st = st, split_effs = split_effs, scope = array_empty_kind_scope())
      })),
      SExpr(expr) => Array::set(stmts, at = ip, value = SExpr(scps_prepass_expr(e = expr, ecfgs = ecfgs, ctx = ctx, st = st, split_effs = split_effs, scope = array_empty_kind_scope()))),
      STest(tn, expr) => Array::set(stmts, at = ip, value = STest(tn, scps_prepass_expr(e = expr, ecfgs = ecfgs, ctx = ctx, st = st, split_effs = split_effs, scope = array_empty_kind_scope()))),
      SBench(bn, expr) => Array::set(stmts, at = ip, value = SBench(bn, scps_prepass_expr(e = expr, ecfgs = ecfgs, ctx = ctx, st = st, split_effs = split_effs, scope = array_empty_kind_scope()))),
      _ => ()
    }
    scps_census_replaced(stmts = stmts, i = ip)
    ip = ip + 1
  }
}

// review-lint: allow-program-walk (answers a summary question: whether the prepass splits one effect, on a copy)
/// #3192: does this program step-compile a closure value for `eff`?
///
/// The linker asks before it injects the `Async` entry boundary. That
/// boundary is tail-resumptive unless the program spawns suspendable tasks,
/// and a tail-resumptive handler cannot call a step-compiled closure: the
/// convention guard (phase 5 of suspend_cps_pass) refuses the program. So
/// whenever a closure is step-compiled -- an `Async` closure literal the
/// entry calls, say -- the boundary takes its suspend-class spelling instead.
/// Nothing is step-compiled unless some handler of `eff` already stores
/// `resume`, so a program with none never moves. The prepass runs on a copy
/// of the statement list and a throwaway state; `stmts` is left as it was.
export fn suspend_prepass_splits(stmts: Array[Stmt], eff: String) -> Bool {
  let groups = scps_collect_groups(stmts)
  let matching: Array[String] = []
  for target in scps_collect_cps_effs(stmts = stmts, groups = groups) {
    if edp_str_array_contains(arr = scps_group_members(groups = groups, target = target), v = eff) {
      Array::push(matching, value = target)
    }
  }
  if Array::length(matching) == 0 {
    false
  } else {
    let copy = Array::slice(stmts, start = 0, end = Array::length(stmts))
    let es_names = array_empty()
    let es_members_list = array_empty()
    edp_es_collect_into(stmts = copy, es_names = es_names, es_members_list = es_members_list)
    let fn_defs = edp_collect_fn_defs(copy)
    scps_census_drop()
    scps_census_note(copy)
    // #3182: the same alias substitution suspend_cps_pass makes, so this
    // answer is about the program that pass will lower.
    if scps_inline_fn_aliases_stmts(stmts = copy, fn_defs = fn_defs) {
      scps_census_drop()
    } else ()
    scps_census_note(copy)
    let ctx = (copy, edp_collect_effect_defs(copy), fn_defs, es_names, es_members_list, scps_collect_ctor_names(copy), groups)
    let st = (scps_ctr_box(), array_empty_str(), array_empty_str(), array_empty_str(), array_empty_str(), scps_empty_stmts(), array_empty_str())
    scps_owner_reset()
    let split_effs = array_empty_str()
    scps_prepass_stmts(stmts = copy, ecfgs = for target in matching {
      scps_ecfg_for(ctx = ctx, eff = target)
    }, ctx = ctx, st = st, split_effs = split_effs)
    // The census describes `copy`, which is thrown away.
    scps_census_drop()
    let mut split = false
    for target in split_effs {
      if edp_str_array_contains(arr = scps_group_members(groups = groups, target = target), v = eff) {
        split = true
      }
    }
    split
  }
}

// review-lint: allow-program-walk (drops the originals no statement references, until none is left)
/// Drop the ORIGINAL of a function the suspend lowering cloned
/// (`__scps_cps_<E>_<f>`) once nothing references it any more.
///
/// The clone is what every suspend-lowered call site calls; the original is
/// left for tail-resumptive callers, whose handles evidence_dict_pass
/// migrates. When no such caller exists, the original keeps its raw
/// `perform` and nothing lowers it. The linear lane never compiles it (the
/// late reachability prune drops it), but the gc lane compiles every
/// top-level function and refused the program with "unsupported perform"
/// (#3064: every handle of an effect whose arm leaves with `return` through a
/// callee takes this lowering). Exported functions stay; the drop repeats
/// until no further original becomes unreferenced, so a chain of callees
/// (`ask2` calling `ask`) goes together.
export fn scps_drop_orphaned_originals(_ stmts: Array[Stmt]) -> Unit {
  let mut changed = true
  while changed {
    changed = false
    let mut i = 0
    while i < Array::length(stmts) && !changed {
      match Array::get(stmts, at = i) {
        SLet(exported, _, name, _, EFn(_, _, _, _, _, _)) => if !exported && !String::starts_with(name, prefix = "__scps_") && scps_has_clone_of(stmts = stmts, fname = name) && !scps_referenced_elsewhere(stmts = stmts, at = i, name = name) {
          let kept = scps_empty_stmts()
          let mut j = 0
          while j < Array::length(stmts) {
            if j != i {
              Array::push(kept, value = Array::get(stmts, at = j))
            } else {
              ()
            }
            j = j + 1
          }
          Array::truncate(stmts, length = 0)
          let mut k = 0
          while k < Array::length(kept) {
            Array::push(stmts, value = Array::get(kept, at = k))
            k = k + 1
          }
          changed = true
        } else {
          ()
        },
        _ => ()
      }
      i = i + 1
    }
  }
}

// review-lint: allow-program-walk (answers a summary question: whether one function has a clone)
fn scps_has_clone_of(stmts: Array[Stmt], fname: String) -> Bool {
  let suffix = String::concat("_", scps_sanitize(fname))
  let mut found = false
  let mut i = 0
  while i < Array::length(stmts) && !found {
    match Array::get(stmts, at = i) {
      SLet(_, _, name, _, _) => if String::starts_with(name, prefix = "__scps_cps_") && String::ends_with(name, suffix = suffix) {
        found = true
      } else {
        ()
      },
      _ => ()
    }
    i = i + 1
  }
  found
}

// review-lint: allow-program-walk (answers a summary question: whether one name is referenced outside one statement)
fn scps_referenced_elsewhere(stmts: Array[Stmt], at: Int, name: String) -> Bool {
  let mut found = false
  let mut i = 0
  while i < Array::length(stmts) && !found {
    if i != at {
      match scps_stmt_expr_of(Array::get(stmts, at = i)) {
        Some(expr) => if scps_refs_name(e = expr, x = name) {
          found = true
        } else {
          ()
        },
        // A statement that can name the function without an expression
        // keeps the original alive.
        None => match Array::get(stmts, at = i) {
          SExport(names) => if edp_str_array_contains(arr = names, v = name) {
            found = true
          } else {
            ()
          },
          SAliasDecl(a, b) => if a == name || b == name {
            found = true
          } else {
            ()
          },
          SExample(_, ex) => if scps_refs_name(e = ex, x = name) {
            found = true
          } else {
            ()
          },
          _ => ()
        }
      }
    } else {
      ()
    }
    i = i + 1
  }
  found
}

// --- per-site transform: driver synthesis. Returns None (with a pushed
// error) when the site is ineligible -- the caller keeps the original
// node, and the pass's caller turns the error list into a hard compile
// failure (a value-referencing arm can never compile on the replay path,
// so silence is not an option).

fn scps_transform_handle(body: Expr, arms: Array[(Pat, Expr)], ik: String, why: String, ctx: (Array[Stmt], Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], Array[String], Array[Array[String]], Array[String], Array[(String, Array[String])]), st: (Array[Int], Array[String], Array[String], Array[String], Array[String], Array[Stmt], Array[String]), scope: Array[(String, String, Bool)]) -> Option[Expr] {
  let errs = scps_st_errs(st)
  let (_, _, _, _, _, _, groups) = ctx
  let eff = scps_group_target(arms = arms, groups = groups)
  let members = scps_group_members(groups = groups, target = eff)
  let mut shape_ok = true
  for arm in arms {
    let (p, _) = arm
    match p {
      PCtor(q, _) => {
        let ci = String::index_of(q, needle = "::")
        if ci <= 0 {
          shape_ok = false
        } else if !edp_str_array_contains(arr = members, v = q[0: ci]) {
          shape_ok = false
        }
      },
      _ => shape_ok = false
    }
  }
  let (eff_declared, decl_ops) = scps_effect_decl_ops(ctx = ctx, eff = eff)
  if !shape_ok || idp_arms_discharge_error(arms) || !eff_declared {
    Array::push(errs, value = String::concat(scps_driver_lead(why = why, eff = eff), "this handle has an Error arm (Error is non-resumable), an unqualified arm, or handles a non-declared effect -- not supported by the suspend lowering"))
    None
  } else {
    let ops_qnames = scps_target_qnames(ctx = ctx, eff = eff)
    let needing = scps_needing_for(ctx = ctx, eff = eff)
    let site = scps_next_site(st)
    // closure-CPS (追記31 Vertical B): lexical bindings whose row carries
    // the handled effect (enclosing-fn params with an annotated E-row, and
    // let-bound literals the prepass step-split) are callable step sources
    // inside this body. Last binding of a name wins ("" row = mask).
    let cps_seed = array_empty_str()
    let seen_scope = array_empty_str()
    let mut sci = Array::length(scope) - 1
    while sci >= 0 {
      let (snm, srow, _) = Array::get(scope, at = sci)
      if edp_str_array_contains(arr = seen_scope, v = snm) {
        ()
      } else {
        Array::push(seen_scope, value = snm)
        if srow != "" && scps_step_mode(eff) && scps_row_contains(ctx = ctx, row = srow, eff = eff) {
          Array::push(cps_seed, value = snm)
        } else {
          ()
        }
      }
      sci = sci - 1
    }
    let sctx = (eff, ops_qnames, needing, site, cps_seed)
    // Every currently visible binding participates, not just step sources:
    // an opaque local must mask every same-spelled top-level authorization.
    let call_scope = scps_scope_from_visible(visible = scope, eff = eff, ctx = ctx)
    if scps_step_param_refused(body = body, sctx = sctx, ctx = ctx, scope = call_scope, errs = errs) {
      None
    } else if !scps_calls_ok(e = body, sctx = sctx, ctx = ctx, scope = call_scope) {
      // #1536 / #1514 parity: name the offending call and carry its offset
      // as the ` [@off=N:M]` marker the located lanes resolve (and every
      // lane strips), same contract as the handle-side culprit marker.
      let (culprit_lead, culprit_clause, culprit_marker) = scps_culprit_parts(e = body, sctx = sctx, ctx = ctx, scope = call_scope)
      // #3520: for `Async` the handle is the entry's own boundary, which the
      // program never wrote, so a lead about "a handler arm" named nothing
      // the reader could edit. Lead with the edits that apply instead.
      let async_lead = if culprit_lead == "" && is_runtime_scheduled_effect(eff) {
        "run the code that suspends in a `TaskGroup::spawn_suspend` task, or give the parameter it is handed to a row with `Async` (`f: () -> T with Async`) -- the entry's `Async` code reaches a call that cannot suspend: "
      } else {
        ""
      }
      let mut scps_msg = String::concat(String::concat(String::concat(async_lead, culprit_lead), scps_driver_lead(why = why, eff = eff)), "the handle body calls something this suspend lowering cannot see through (a local closure, a method-style callee, a nested handle, or a function whose declared row has a row variable)")
      scps_msg = String::concat(scps_msg, culprit_clause)
      scps_msg = String::concat(scps_msg, " -- only `perform`, pure builtins, constructors, provably effect-free functions, and functions whose concrete row carries the handled effect may be called in the handled body")
      scps_msg = String::concat(scps_msg, culprit_marker)
      Array::push(errs, value = scps_msg)
      None
    } else {
      // #1536: a `for` over a proved array is lowered here too, not only in a
      // needing fn's clone -- the handle body is a spine like any other. It has
      // no parameters of its own, so the proof comes from array literals bound
      // on that spine.
      let body2 = scps_elim_array_for(e = body, known = array_empty_str(), kstr = array_empty_str(), site = site, ctr = scps_anf_ctr(), ctx = ctx)
      let (split_ok, split_body) = scps_split_tail(e = body2, sctx = sctx, ctx = ctx, st = st)
      if !split_ok {
        Array::push(errs, value = String::concat(scps_driver_lead(why = why, eff = eff), "a perform of the handled effect (or a call to a function that performs it) is not directly on the handle body's let/seq/tail/branch-tail spine (a loop body containing `return`, a `for` form, nested closures/handles, and a selected `&&` / `||` right operand that transfers control with `return` / `break` / `continue` are not eligible; a suspension inside an `if` / `match` branch or a `&&` / `||` right operand IS eligible wherever the selection or the short-circuit itself is strictly evaluated (a statement, the tail, the whole value of a `let` / `let mut` / assignment, or a strictly evaluated part of a compound); a `while` / `loop` spine is, including one carrying `break` / `continue`, and so is a suspension inside an operand, a call argument or a constructor payload)"))
        None
      } else {
        scps_ensure_effect_runtime(eff = eff, ctx = ctx, st = st)
        let drive = scps_local(prefix = "__scps_drive", site = site)
        let kname = scps_local(prefix = "__scps_k", site = site)
        let once = scps_local(prefix = "__scps_once", site = site)
        let rv = scps_local(prefix = "__scps_rv", site = site)
        let vname = scps_local(prefix = "__scps_v", site = site)
        let dmarms = scps_empty_arms()
        let done_pats = scps_empty_pats()
        Array::push(done_pats, value = PBind(vname))
        Array::push(dmarms, value = (PCtor(scps_done_name(eff), done_pats), EIdent(vname, -1)))
        let mut di = 0
        while di < Array::length(arms) {
          let (p, ab) = Array::get(arms, at = di)
          let (aq, subpats) = match p {
            PCtor(q, sp) => (q, sp),
            _ => ("", scps_empty_pats())
          }
          let ypats = scps_empty_pats()
          let mut pi = 0
          while pi < Array::length(subpats) {
            Array::push(ypats, value = Array::get(subpats, at = pi))
            pi = pi + 1
          }
          Array::push(ypats, value = PBind(kname))
          let once_get = ECall(builtin_ref("Array::get"), [
            EIdent(once, -1),
            EInt(0)
          ], -1, [])
          // One-shot violation: write the diagnostic and TRAP via an
          // out-of-bounds Array::get (clean `unreachable`, verified to
          // trap correctly INSIDE a closure). NOT assert(false) (#1095:
          // assert inside a closure miscompiles to a null indirect call)
          // and NOT Exception::Throw (the #944 entry boundary only wraps
          // entries whose declared row carries Error, so a synthesized
          // throw in a program with no Error row would leak to the host
          // as a raw WebAssembly.Exception with no message at all).
          // #3009: `abort` (print, then trap) rather than
          // `Stderr::write_stream`: the host stream import made every module
          // with a capturing arm depend on the vibe host, so a gc test could
          // not run under plain wasmtime.
          let trap = ECall(EIdent("abort", -1), [
            EString("vibe: resume one-shot continuation called twice", -1)
          ], -1, [])
          let set_true = ECall(builtin_ref("Array::set"), [
            EIdent(once, -1),
            EInt(0),
            EBool(true)
          ], -1, builtin_callee_resolution("Array::set"))
          let drive_call = ECall(EIdent(drive, -1), [
            ECall(EIdent(kname, -1), [EIdent(rv, -1)], -1, [])
          ], -1, [])
          let rfn = scps_mk_fn1(param = rv, body = EIf(once_get, trap, ESeq(set_true, drive_call)))
          // `ik` is the hygienic spelling the implicit-resume wrap calls
          // (scps_wrap_tail_resume). When the arm's own payload binder is
          // named `resume`, that binder stays visible: rebinding `resume` to
          // the continuation here would hide the payload the arm reads.
          let ab_bound = if scps_pat_binds_resume(p) {
            ab
          } else {
            ELet("resume", rfn, ab, -1)
          }
          let lowered = ELet(once, EArray([EBool(false)]), ELet(ik, rfn, ab_bound, -1), -1)
          Array::push(dmarms, value = (PCtor(scps_y_name(eff = eff, opname = scps_target_op_name(ctx = ctx, eff = eff, qname = aq)), ypats), lowered))
          di = di + 1
        }
        let stn = scps_local(prefix = "__scps_st", site = site)
        let dfn = scps_mk_fn1(param = stn, body = EMatch(EIdent(stn, -1), dmarms))
        Some(ELetRec(drive, dfn, ECall(EIdent(drive, -1), [split_body], -1, [])))
      }
    }
  }
}

/// Is argument `a` (found in a proven-slot position at a by-name call
/// site) suspend-inert? A closure literal must have a taint-free body and
/// must not itself declare a row carrying `eff`; a bare identifier is
/// accepted only as the enclosing top-level fn's own function-typed param
/// whose slot is (recursively) proven and never rebound anywhere in that
/// fn's body. Everything else is not provable.
fn scps_arg_is_inert(a: Expr, has_encl: Bool, encl_params: Array[(String, Option[TypeExpr])], encl_body: Expr, eff: String, needing: Array[String], ctx: (Array[Stmt], Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], Array[String], Array[Array[String]], Array[String], Array[(String, Array[String])]), encl_name: String, visiting: Array[String]) -> Bool {
  match a {
    EFn(_, _, aparams, _, ef, b) => {
      let row_ok = match ef {
        Some(row) => !scps_row_contains(ctx = ctx, row = row, eff = eff) && !scps_row_has_var(row),
        None => true
      }
      // The taint scan starts with ONLY the literal's own params as
      // locally-bound names: any other bare identifier in the body is a
      // captured value of unknown provenance and taints (it may alias a
      // step-compiled closure -- Codex review on #1602).
      // #1536: the literal's own params PLUS enclosing names bound to
      // provably-inert literals. Everything else stays a captured value of
      // unknown provenance and taints, as before.
      let seed = scps_locals_with_params(locals = array_empty_str(), params = aparams)
      if has_encl {
        scps_inert_local_literals(e = encl_body, eff = eff, needing = needing, ctx = ctx, out = seed)
      } else {
        ()
      }
      row_ok && !scps_inert_taint(e = b, eff = eff, needing = needing, locals = seed, ctx = ctx)
    },
    EIdent(an, _) => if has_encl {
      let mut slot = -1
      let mut i = 0
      while i < Array::length(encl_params) {
        let (pnm, _) = Array::get(encl_params, at = i)
        if pnm == an && slot < 0 {
          slot = i
        } else {
          ()
        }
        i = i + 1
      }
      if slot < 0 {
        false
      } else if scps_binds_name(e = encl_body, x = an) {
        false
      } else {
        scps_param_slot_inert(fname = encl_name, slot = slot, eff = eff, needing = needing, ctx = ctx, visiting = visiting)
      }
    } else {
      false
    },
    _ => false
  }
}

/// True when every occurrence of `fname` in `e` is a by-name call whose
/// argument in `slot` is suspend-inert -- and `fname` never escapes as a
/// bare value. Binders shadowing `fname` stop the scan (calls below them
/// are not calls to the top-level fn).
fn scps_slot_sites_ok(e: Expr, fname: String, slot: Int, has_encl: Bool, encl_params: Array[(String, Option[TypeExpr])], encl_body: Expr, eff: String, needing: Array[String], ctx: (Array[Stmt], Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], Array[String], Array[Array[String]], Array[String], Array[(String, Array[String])]), encl_name: String, visiting: Array[String]) -> Bool {
  // Phase 3 has already rewritten suspend-context call sites of `fname`
  // to its CPS-clone spelling (args preserved) by the time phase 4 runs
  // this proof, so a site counts under EITHER name -- missing the
  // rewritten spelling would let a tainted argument through unseen.
  let cname = scps_clone_name(eff = eff, fname = fname)
  match e {
    EIdent(nm, _) => nm != fname && nm != cname,
    ECall(callee, args, _, _) => {
      let head_ok = match callee {
        EIdent(nm, _) => if nm == fname || nm == cname {
          let mut shape_ok = slot < Array::length(args)
          let mut ai = 0
          while ai < Array::length(args) {
            match Array::get(args, at = ai) {
              ELabeledArg(_, _, _) => {
                shape_ok = false
              },
              ESpread(_) => {
                shape_ok = false
              },
              _ => ()
            }
            ai = ai + 1
          }
          shape_ok && scps_arg_is_inert(a = Array::get(args, at = slot), has_encl = has_encl, encl_params = encl_params, encl_body = encl_body, eff = eff, needing = needing, ctx = ctx, encl_name = encl_name, visiting = visiting)
        } else {
          true
        },
        _ => scps_slot_sites_ok(e = callee, fname = fname, slot = slot, has_encl = has_encl, encl_params = encl_params, encl_body = encl_body, eff = eff, needing = needing, ctx = ctx, encl_name = encl_name, visiting = visiting)
      }
      let mut ok = head_ok
      let mut i = 0
      while i < Array::length(args) {
        // Bare-ident args recurse like everything else: EIdent(fname) in
        // ANY argument position (including a self-call's own slot) is a
        // value escape and must fail via the EIdent arm.
        if !scps_slot_sites_ok(e = Array::get(args, at = i), fname = fname, slot = slot, has_encl = has_encl, encl_params = encl_params, encl_body = encl_body, eff = eff, needing = needing, ctx = ctx, encl_name = encl_name, visiting = visiting) {
          ok = false
        } else {
          ()
        }
        i = i + 1
      }
      ok
    },
    EFn(_, _, params, _, _, b) => if scps_params_bind_name(params = params, x = fname) {
      true
    } else {
      scps_slot_sites_ok(e = b, fname = fname, slot = slot, has_encl = has_encl, encl_params = encl_params, encl_body = encl_body, eff = eff, needing = needing, ctx = ctx, encl_name = encl_name, visiting = visiting)
    },
    ELet(nm, v, b, _) => scps_slot_sites_ok(e = v, fname = fname, slot = slot, has_encl = has_encl, encl_params = encl_params, encl_body = encl_body, eff = eff, needing = needing, ctx = ctx, encl_name = encl_name, visiting = visiting) && (nm == fname || scps_slot_sites_ok(e = b, fname = fname, slot = slot, has_encl = has_encl, encl_params = encl_params, encl_body = encl_body, eff = eff, needing = needing, ctx = ctx, encl_name = encl_name, visiting = visiting)),
    ELetMut(nm, v, b, _) => scps_slot_sites_ok(e = v, fname = fname, slot = slot, has_encl = has_encl, encl_params = encl_params, encl_body = encl_body, eff = eff, needing = needing, ctx = ctx, encl_name = encl_name, visiting = visiting) && (nm == fname || scps_slot_sites_ok(e = b, fname = fname, slot = slot, has_encl = has_encl, encl_params = encl_params, encl_body = encl_body, eff = eff, needing = needing, ctx = ctx, encl_name = encl_name, visiting = visiting)),
    ELetRec(nm, v, b) => if nm == fname {
      true
    } else {
      scps_slot_sites_ok(e = v, fname = fname, slot = slot, has_encl = has_encl, encl_params = encl_params, encl_body = encl_body, eff = eff, needing = needing, ctx = ctx, encl_name = encl_name, visiting = visiting) && scps_slot_sites_ok(e = b, fname = fname, slot = slot, has_encl = has_encl, encl_params = encl_params, encl_body = encl_body, eff = eff, needing = needing, ctx = ctx, encl_name = encl_name, visiting = visiting)
    },
    ESeq(a, b) => scps_slot_sites_ok(e = a, fname = fname, slot = slot, has_encl = has_encl, encl_params = encl_params, encl_body = encl_body, eff = eff, needing = needing, ctx = ctx, encl_name = encl_name, visiting = visiting) && scps_slot_sites_ok(e = b, fname = fname, slot = slot, has_encl = has_encl, encl_params = encl_params, encl_body = encl_body, eff = eff, needing = needing, ctx = ctx, encl_name = encl_name, visiting = visiting),
    EIf(c, t, el) => scps_slot_sites_ok(e = c, fname = fname, slot = slot, has_encl = has_encl, encl_params = encl_params, encl_body = encl_body, eff = eff, needing = needing, ctx = ctx, encl_name = encl_name, visiting = visiting) && scps_slot_sites_ok(e = t, fname = fname, slot = slot, has_encl = has_encl, encl_params = encl_params, encl_body = encl_body, eff = eff, needing = needing, ctx = ctx, encl_name = encl_name, visiting = visiting) && scps_slot_sites_ok(e = el, fname = fname, slot = slot, has_encl = has_encl, encl_params = encl_params, encl_body = encl_body, eff = eff, needing = needing, ctx = ctx, encl_name = encl_name, visiting = visiting),
    EMatch(s, arms) => {
      let mut ok = scps_slot_sites_ok(e = s, fname = fname, slot = slot, has_encl = has_encl, encl_params = encl_params, encl_body = encl_body, eff = eff, needing = needing, ctx = ctx, encl_name = encl_name, visiting = visiting)
      let mut i = 0
      while i < Array::length(arms) {
        let (p, ex) = Array::get(arms, at = i)
        if scps_pat_binds_name(p = p, x = fname) {
          ()
        } else if !scps_slot_sites_ok(e = ex, fname = fname, slot = slot, has_encl = has_encl, encl_params = encl_params, encl_body = encl_body, eff = eff, needing = needing, ctx = ctx, encl_name = encl_name, visiting = visiting) {
          ok = false
        } else {
          ()
        }
        i = i + 1
      }
      ok
    },
    EHandle(b, arms) => {
      let mut ok = scps_slot_sites_ok(e = b, fname = fname, slot = slot, has_encl = has_encl, encl_params = encl_params, encl_body = encl_body, eff = eff, needing = needing, ctx = ctx, encl_name = encl_name, visiting = visiting)
      let mut i = 0
      while i < Array::length(arms) {
        let (p, ex) = Array::get(arms, at = i)
        if scps_pat_binds_name(p = p, x = fname) {
          ()
        } else if !scps_slot_sites_ok(e = ex, fname = fname, slot = slot, has_encl = has_encl, encl_params = encl_params, encl_body = encl_body, eff = eff, needing = needing, ctx = ctx, encl_name = encl_name, visiting = visiting) {
          ok = false
        } else {
          ()
        }
        i = i + 1
      }
      ok
    },
    EWhile(c, b) => scps_slot_sites_ok(e = c, fname = fname, slot = slot, has_encl = has_encl, encl_params = encl_params, encl_body = encl_body, eff = eff, needing = needing, ctx = ctx, encl_name = encl_name, visiting = visiting) && scps_slot_sites_ok(e = b, fname = fname, slot = slot, has_encl = has_encl, encl_params = encl_params, encl_body = encl_body, eff = eff, needing = needing, ctx = ctx, encl_name = encl_name, visiting = visiting),
    EForIn(nm, idx, it, b) => {
      let shadowed = nm == fname || match idx {
        Some(inm) => inm == fname,
        None => false
      }
      scps_slot_sites_ok(e = it, fname = fname, slot = slot, has_encl = has_encl, encl_params = encl_params, encl_body = encl_body, eff = eff, needing = needing, ctx = ctx, encl_name = encl_name, visiting = visiting) && (shadowed || scps_slot_sites_ok(e = b, fname = fname, slot = slot, has_encl = has_encl, encl_params = encl_params, encl_body = encl_body, eff = eff, needing = needing, ctx = ctx, encl_name = encl_name, visiting = visiting))
    },
    ELoop(pairs, b) => {
      let mut shadowed = false
      let mut ok = true
      let mut i = 0
      while i < Array::length(pairs) {
        let (nm, v) = Array::get(pairs, at = i)
        if nm == fname {
          shadowed = true
        } else {
          ()
        }
        if !scps_slot_sites_ok(e = v, fname = fname, slot = slot, has_encl = has_encl, encl_params = encl_params, encl_body = encl_body, eff = eff, needing = needing, ctx = ctx, encl_name = encl_name, visiting = visiting) {
          ok = false
        } else {
          ()
        }
        i = i + 1
      }
      ok && (shadowed || scps_slot_sites_ok(e = b, fname = fname, slot = slot, has_encl = has_encl, encl_params = encl_params, encl_body = encl_body, eff = eff, needing = needing, ctx = ctx, encl_name = encl_name, visiting = visiting))
    },
    EBinOp(_, l, r, _) => scps_slot_sites_ok(e = l, fname = fname, slot = slot, has_encl = has_encl, encl_params = encl_params, encl_body = encl_body, eff = eff, needing = needing, ctx = ctx, encl_name = encl_name, visiting = visiting) && scps_slot_sites_ok(e = r, fname = fname, slot = slot, has_encl = has_encl, encl_params = encl_params, encl_body = encl_body, eff = eff, needing = needing, ctx = ctx, encl_name = encl_name, visiting = visiting),
    EUnaryOp(_, a) => scps_slot_sites_ok(e = a, fname = fname, slot = slot, has_encl = has_encl, encl_params = encl_params, encl_body = encl_body, eff = eff, needing = needing, ctx = ctx, encl_name = encl_name, visiting = visiting),
    EAssign(_, v, b, _) => scps_slot_sites_ok(e = v, fname = fname, slot = slot, has_encl = has_encl, encl_params = encl_params, encl_body = encl_body, eff = eff, needing = needing, ctx = ctx, encl_name = encl_name, visiting = visiting) && scps_slot_sites_ok(e = b, fname = fname, slot = slot, has_encl = has_encl, encl_params = encl_params, encl_body = encl_body, eff = eff, needing = needing, ctx = ctx, encl_name = encl_name, visiting = visiting),
    EAssignOp(_, _, v, b, _) => scps_slot_sites_ok(e = v, fname = fname, slot = slot, has_encl = has_encl, encl_params = encl_params, encl_body = encl_body, eff = eff, needing = needing, ctx = ctx, encl_name = encl_name, visiting = visiting) && scps_slot_sites_ok(e = b, fname = fname, slot = slot, has_encl = has_encl, encl_params = encl_params, encl_body = encl_body, eff = eff, needing = needing, ctx = ctx, encl_name = encl_name, visiting = visiting),
    EReturn(a) => scps_slot_sites_ok(e = a, fname = fname, slot = slot, has_encl = has_encl, encl_params = encl_params, encl_body = encl_body, eff = eff, needing = needing, ctx = ctx, encl_name = encl_name, visiting = visiting),
    EDot(o, _, _, _) => scps_slot_sites_ok(e = o, fname = fname, slot = slot, has_encl = has_encl, encl_params = encl_params, encl_body = encl_body, eff = eff, needing = needing, ctx = ctx, encl_name = encl_name, visiting = visiting),
    ELabeledArg(_, _, v) => scps_slot_sites_ok(e = v, fname = fname, slot = slot, has_encl = has_encl, encl_params = encl_params, encl_body = encl_body, eff = eff, needing = needing, ctx = ctx, encl_name = encl_name, visiting = visiting),
    EBreak(opt) => match opt {
      Some(a) => scps_slot_sites_ok(e = a, fname = fname, slot = slot, has_encl = has_encl, encl_params = encl_params, encl_body = encl_body, eff = eff, needing = needing, ctx = ctx, encl_name = encl_name, visiting = visiting),
      None => true
    },
    EContinue(args) => scps_slot_sites_ok_exprs(es = args, fname = fname, slot = slot, has_encl = has_encl, encl_params = encl_params, encl_body = encl_body, eff = eff, needing = needing, ctx = ctx, encl_name = encl_name, visiting = visiting),
    ETuple(items) => scps_slot_sites_ok_exprs(es = items, fname = fname, slot = slot, has_encl = has_encl, encl_params = encl_params, encl_body = encl_body, eff = eff, needing = needing, ctx = ctx, encl_name = encl_name, visiting = visiting),
    EArray(items) => scps_slot_sites_ok_exprs(es = items, fname = fname, slot = slot, has_encl = has_encl, encl_params = encl_params, encl_body = encl_body, eff = eff, needing = needing, ctx = ctx, encl_name = encl_name, visiting = visiting),
    ERecord(_, fields, _) => scps_slot_sites_ok_pairs(pairs = fields, fname = fname, slot = slot, has_encl = has_encl, encl_params = encl_params, encl_body = encl_body, eff = eff, needing = needing, ctx = ctx, encl_name = encl_name, visiting = visiting),
    EMap(fields) => scps_slot_sites_ok_pairs(pairs = fields, fname = fname, slot = slot, has_encl = has_encl, encl_params = encl_params, encl_body = encl_body, eff = eff, needing = needing, ctx = ctx, encl_name = encl_name, visiting = visiting),
    ESpread(a) => scps_slot_sites_ok(e = a, fname = fname, slot = slot, has_encl = has_encl, encl_params = encl_params, encl_body = encl_body, eff = eff, needing = needing, ctx = ctx, encl_name = encl_name, visiting = visiting),
    _ => true
  }
}

fn scps_slot_sites_ok_exprs(es: Array[Expr], fname: String, slot: Int, has_encl: Bool, encl_params: Array[(String, Option[TypeExpr])], encl_body: Expr, eff: String, needing: Array[String], ctx: (Array[Stmt], Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], Array[String], Array[Array[String]], Array[String], Array[(String, Array[String])]), encl_name: String, visiting: Array[String]) -> Bool {
  let mut i = 0
  let mut ok = true
  while i < Array::length(es) {
    if !scps_slot_sites_ok(e = Array::get(es, at = i), fname = fname, slot = slot, has_encl = has_encl, encl_params = encl_params, encl_body = encl_body, eff = eff, needing = needing, ctx = ctx, encl_name = encl_name, visiting = visiting) {
      ok = false
    } else {
      ()
    }
    i = i + 1
  }
  ok
}

fn scps_slot_sites_ok_pairs(pairs: Array[(String, Expr)], fname: String, slot: Int, has_encl: Bool, encl_params: Array[(String, Option[TypeExpr])], encl_body: Expr, eff: String, needing: Array[String], ctx: (Array[Stmt], Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], Array[String], Array[Array[String]], Array[String], Array[(String, Array[String])]), encl_name: String, visiting: Array[String]) -> Bool {
  let mut i = 0
  let mut ok = true
  while i < Array::length(pairs) {
    let (_, v) = Array::get(pairs, at = i)
    if !scps_slot_sites_ok(e = v, fname = fname, slot = slot, has_encl = has_encl, encl_params = encl_params, encl_body = encl_body, eff = eff, needing = needing, ctx = ctx, encl_name = encl_name, visiting = visiting) {
      ok = false
    } else {
      ()
    }
    i = i + 1
  }
  ok
}

/// Prove param slot `slot` of top-level fn `fname` suspend-inert for
/// `eff`: the slot's declared type must be function-typed with a row that
/// is absent, or concrete and eff-free; and every by-name occurrence of
/// `fname` program-wide must be a call passing an inert value in that
/// slot. Delegation cycles are handled coinductively: a slot already on
/// the `visiting` stack contributes no new taint evidence and is treated
/// as inert within its own proof.
fn scps_param_slot_inert(fname: String, slot: Int, eff: String, needing: Array[String], ctx: (Array[Stmt], Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], Array[String], Array[Array[String]], Array[String], Array[(String, Array[String])]), visiting: Array[String]) -> Bool {
  let key = String::concat(String::concat(fname, "||"), Int::to_string(slot))
  if edp_str_array_contains(arr = visiting, v = key) {
    true
  } else {
    let (stmts, _, fn_defs, _, _, _, _) = ctx
    let slot_ok = match edp_params_of_fn(stmts = stmts, fn_defs = fn_defs, nm = fname) {
      Some(params) => if slot < Array::length(params) {
        let (_, pty) = Array::get(params, at = slot)
        let prow = scps_ty_row(pty)
        match pty {
          Some(TyFn(_, _, _)) => !scps_row_contains(ctx = ctx, row = prow, eff = eff) && !scps_row_has_var(prow),
          _ => false
        }
      } else {
        false
      },
      None => false
    }
    if !slot_ok {
      false
    } else {
      let visiting2 = Array::slice(visiting, start = 0, end = Array::length(visiting))
      Array::push(visiting2, value = key)
      let mut ok = true
      let mut i = 0
      while i < Array::length(stmts) {
        match Array::get(stmts, at = i) {
          SLet(_, _, dnm, _, dexpr) => match dexpr {
            EFn(_, _, dparams, _, _, dbody) => {
              if !scps_slot_sites_ok(e = dbody, fname = fname, slot = slot, has_encl = true, encl_params = dparams, encl_body = dbody, eff = eff, needing = needing, ctx = ctx, encl_name = dnm, visiting = visiting2) {
                ok = false
              } else {
                ()
              }
            },
            _ => if !scps_slot_sites_ok(e = dexpr, fname = fname, slot = slot, has_encl = false, encl_params = scps_empty_params(), encl_body = EUnit, eff = eff, needing = needing, ctx = ctx, encl_name = "", visiting = visiting2) {
              ok = false
            } else {
              ()
            }
          },
          SLetMut(_, _, mexpr) => if !scps_slot_sites_ok(e = mexpr, fname = fname, slot = slot, has_encl = false, encl_params = scps_empty_params(), encl_body = EUnit, eff = eff, needing = needing, ctx = ctx, encl_name = "", visiting = visiting2) {
            ok = false
          } else {
            ()
          },
          SExpr(sexpr) => if !scps_slot_sites_ok(e = sexpr, fname = fname, slot = slot, has_encl = false, encl_params = scps_empty_params(), encl_body = EUnit, eff = eff, needing = needing, ctx = ctx, encl_name = "", visiting = visiting2) {
            ok = false
          } else {
            ()
          },
          STest(_, texpr) => if !scps_slot_sites_ok(e = texpr, fname = fname, slot = slot, has_encl = false, encl_params = scps_empty_params(), encl_body = EUnit, eff = eff, needing = needing, ctx = ctx, encl_name = "", visiting = visiting2) {
            ok = false
          } else {
            ()
          },
          SBench(_, bexpr) => if !scps_slot_sites_ok(e = bexpr, fname = fname, slot = slot, has_encl = false, encl_params = scps_empty_params(), encl_body = EUnit, eff = eff, needing = needing, ctx = ctx, encl_name = "", visiting = visiting2) {
            ok = false
          } else {
            ()
          },
          _ => ()
        }
        i = i + 1
      }
      ok
    }
  }
}

// --- CPS clone emission (3b). The clone's EFn deliberately carries
// ret=None and eff=None: the return type is now __ScpsStep_E (an
// annotation would lie, and codegen ignores it post-check), and the row
// must not re-enter evidence_dict_pass's needing collection (the clone
// no longer performs anything directly).

fn scps_emit_clone(eff: String, fname: String, ctx: (Array[Stmt], Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], Array[String], Array[Array[String]], Array[String], Array[(String, Array[String])]), st: (Array[Int], Array[String], Array[String], Array[String], Array[String], Array[Stmt], Array[String])) -> Unit {
  let (stmts, _, fn_defs, _, _, _, _) = ctx
  let errs = scps_st_errs(st)
  let mut def_idx = -1
  let mut fi = 0
  while fi < Array::length(fn_defs) {
    let (idx, _, _, name, _, _) = Array::get(fn_defs, at = fi)
    if name == fname {
      def_idx = idx
    } else {
      ()
    }
    fi = fi + 1
  }
  if def_idx < 0 {
    Array::push(errs, value = String::concat(String::concat("suspend lowering: internal error -- no top-level definition found for `", fname), "` while emitting its CPS clone"))
  } else {
    match Array::get(stmts, at = def_idx) {
      SLet(_, _, _, _, EFn(tps, tbs, params, _, _, fbody)) => {
        scps_ensure_effect_runtime(eff = eff, ctx = ctx, st = st)
        let (_, decl_ops) = scps_effect_decl_ops(ctx = ctx, eff = eff)
        let ops_qnames = scps_target_qnames(ctx = ctx, eff = eff)
        let needing = scps_needing_for(ctx = ctx, eff = eff)
        let site = scps_next_site(st)
        // closure-CPS (追記31 Vertical B): the clone's own params whose
        // annotated row carries the effect are step-typed closure sources
        // (`run_with(f: () -> T with E)` called from a suspend body).
        let cps_seed = array_empty_str()
        let mut cpi = 0
        while cpi < Array::length(params) {
          let (pnm, pty) = Array::get(params, at = cpi)
          let prow = scps_ty_row(pty)
          if prow != "" && scps_step_mode(eff) && scps_row_contains(ctx = ctx, row = prow, eff = eff) {
            Array::push(cps_seed, value = pnm)
          } else {
            ()
          }
          cpi = cpi + 1
        }
        // #1536 (a): a row-free (or concrete eff-free row) function-typed
        // param whose every by-name call site provably receives a
        // suspend-inert value is renamed into the reserved __scps_inert_
        // namespace inside this clone, which both eligibility walkers
        // already accept and the split leaves as a plain call (see the
        // inert see-through block above). An unproven param stays as-is
        // and keeps the existing rejection.
        let cparams = scps_empty_params()
        // Explicit authority for compiler-renamed inert parameters. Do not
        // infer this from the reserved spelling: source may use that prefix.
        let inert_generated = array_empty_str()
        let mut fbody2 = fbody
        let mut ipi = 0
        while ipi < Array::length(params) {
          let (pnm, pty) = Array::get(params, at = ipi)
          let prow = scps_ty_row(pty)
          let in_seed = edp_str_array_contains(arr = cps_seed, v = pnm)
          let candidate = match pty {
            Some(TyFn(_, _, _)) => !in_seed && !scps_row_contains(ctx = ctx, row = prow, eff = eff) && !scps_row_has_var(prow),
            _ => false
          }
          if candidate && scps_param_slot_inert(fname = fname, slot = ipi, eff = eff, needing = needing, ctx = ctx, visiting = array_empty_str()) {
            let inm = String::concat(String::concat(scps_local(prefix = "__scps_inert_", site = site), "_"), pnm)
            Array::push(cparams, value = (inm, pty))
            Array::push(inert_generated, value = inm)
            fbody2 = scps_rename_ident(e = fbody2, x = pnm, nx = inm)
          } else {
            Array::push(cparams, value = (pnm, pty))
          }
          ipi = ipi + 1
        }
        let sctx = (eff, ops_qnames, needing, site, cps_seed)
        let call_scope = scps_scope_from_params(params = cparams, eff = eff, inert_generated = inert_generated, ctx = ctx)
        if scps_step_param_refused(body = fbody2, sctx = sctx, ctx = ctx, scope = call_scope, errs = errs) {
          ()
        } else if !scps_calls_ok(e = fbody2, sctx = sctx, ctx = ctx, scope = call_scope) {
          // #1536 / #1514 parity: name the offending call inside `fname`'s
          // body. The offset indexes the module that defines `fname`, which
          // may not be the entry file -- verify_culprit_off_marker degrades
          // a basis mismatch to the unlocated message.
          let (culprit_lead, culprit_clause, culprit_marker) = scps_culprit_parts(e = fbody2, sctx = sctx, ctx = ctx, scope = call_scope)
          let mut scps_msg = String::concat(culprit_lead, String::concat(String::concat(String::concat("function `", fname), String::concat("` (whose row carries ", eff)), ") is called from a suspend-class handle body, but its own body calls something the suspend lowering cannot see through (a local closure, a method-style callee, a nested handle, or a row-variable callee)"))
          scps_msg = String::concat(scps_msg, culprit_clause)
          scps_msg = String::concat(scps_msg, "")
          scps_msg = String::concat(scps_msg, culprit_marker)
          Array::push(errs, value = scps_msg)
        } else {
          // #1536: `return v` in this body means "this function's value is v",
          // which is what its tail means -- hoist it there. Anything left
          // unreachable by that hoist is refused below rather than split.
          // #1536: rewrite `for x in xs` over a PROVED array into the indexed
          // while form first -- the split handles `while`, and the proof comes
          // from this function's own parameter annotations plus array literals
          // bound on the spine, so no checker channel is needed.
          let fbody2a = scps_elim_array_for(e = fbody2, known = scps_array_names_seed(cparams), kstr = scps_string_names_seed(cparams), site = site, ctr = scps_anf_ctr(), ctx = ctx)
          let fbody3 = scps_elim_returns(e = match scps_elim_loop_returns(e = fbody2a, site = site) {
            Some(lifted) => lifted,
            None => fbody2a
          }, site = site)
          if scps_body_has_return(fbody3) {
            Array::push(errs, value = scps_return_in_split_msg(String::concat(String::concat(String::concat("function `", fname), String::concat("` (whose row carries ", eff)), ") is called from a suspend-class handle body, so its body")))
          } else {
            let (split_ok, split_body) = scps_split_tail(e = fbody3, sctx = sctx, ctx = ctx, st = st)
            if !split_ok {
              Array::push(errs, value = String::concat(String::concat(String::concat("function `", fname), String::concat("` (whose row carries ", eff)), ") is called from a suspend-class handle body, but a perform of that effect (or a call to a function that performs it) is not directly on its body's let/seq/tail/branch-tail spine (a loop body containing `return`, a `for` form, nested closures/handles, and a selected `&&` / `||` right operand that transfers control with `return` / `break` / `continue` are not eligible; a suspension inside an `if` / `match` branch or a `&&` / `||` right operand IS eligible wherever the selection or the short-circuit itself is strictly evaluated (a statement, the tail, the whole value of a `let` / `let mut` / assignment, or a strictly evaluated part of a compound); a `while` / `loop` spine is, including one carrying `break` / `continue`, and so is a suspension inside an operand, a call argument or a constructor payload)"))
            } else {
              Array::push(scps_st_inj(st), value = SLet(false, true, scps_clone_name(eff = eff, fname = fname), None, EFn(tps, tbs, cparams, None, None, split_body)))
            }
          }
        }
      },
      _ => Array::push(errs, value = String::concat(String::concat("suspend lowering: internal error -- `", fname), "` is not a plain top-level function definition"))
    }
  }
}

// --- the whole-program rewrite walk. Bottom-up at EHandle: inner sites
// transform first, then this site's own trigger is evaluated on the
// already-rewritten arms/body. closure-CPS (追記31 Vertical B): the walk
// threads each visible binding's row and separate plain-data fact. Function
// parameters keep their annotations, step literals name their exact target,
// and every other binder masks the previous binding. Driver eligibility can
// therefore trust data captures without trusting an opaque shadowing binder.

fn scps_scope_push_pat(p: Pat, scope: Array[(String, String, Bool)]) -> Unit {
  match p {
    PBind(n) => Array::push(scope, value = (n, "", false)),
    PCtor(_, ps) => {
      let mut i = 0
      while i < Array::length(ps) {
        scps_scope_push_pat(p = Array::get(ps, at = i), scope = scope)
        i = i + 1
      }
    },
    PTuple(ps) => {
      let mut i = 0
      while i < Array::length(ps) {
        scps_scope_push_pat(p = Array::get(ps, at = i), scope = scope)
        i = i + 1
      }
    },
    POr(a, b) => {
      scps_scope_push_pat(p = a, scope = scope)
      scps_scope_push_pat(p = b, scope = scope)
    },
    PStruct(_, fields) => {
      let mut i = 0
      while i < Array::length(fields) {
        let (_, fp) = Array::get(fields, at = i)
        scps_scope_push_pat(p = fp, scope = scope)
        i = i + 1
      }
    },
    _ => ()
  }
}

/// The row to record for a let binding of `v`: the effect a step-split
/// literal was split for, else "" (mask).
fn scps_let_bind_row(v: Expr, cps_effs: Array[String]) -> String {
  let mut row = ""
  let mut i = 0
  while i < Array::length(cps_effs) {
    let eff = Array::get(cps_effs, at = i)
    if row == "" && scps_literal_returns_step(v = v, eff = eff) {
      row = eff
    } else {
      ()
    }
    i = i + 1
  }
  row
}

/// #2962: wrap every tail value of a non-capturing handler arm in a call of
/// the driver's continuation, so that inside a suspend-transformed handle
/// (one of its sibling arms captures `resume` as a value) the arm resumes
/// the way it does under the tail-resumptive lowering, instead of
/// delivering its value as the driver's final result. The walk is
/// `edp_strip_tail_resume`'s inverse and covers the same tail shapes; a tail
/// that already is a `resume(..)` call of the CONTINUATION is kept, and a
/// `return` leaves the enclosing function so it is not a value to resume
/// with. The call is spelled with `ik`, a name minted fresh for the handle
/// and bound to the same continuation as `resume` by the driver, rather
/// than `resume` itself: an arm whose payload binder or local `let` is named
/// `resume` (`sh`) would otherwise call the user's binding (Codex P0 on
/// #2985), and under such a shadow a tail `resume(x)` IS a user call whose
/// value is the implicit resume value, so it is wrapped like any other.
fn scps_wrap_tail_resume(expr: Expr, ik: String, sh: Bool) -> Expr {
  match expr {
    EIf(c, t, e) => EIf(c, scps_wrap_tail_resume(expr = t, ik = ik, sh = sh), scps_wrap_tail_resume(expr = e, ik = ik, sh = sh)),
    EMatch(s, arms) => EMatch(s, for a in arms {
      let (p, ex) = a
      (p, scps_wrap_tail_resume(expr = ex, ik = ik, sh = sh || scps_pat_binds_resume(p)))
    }),
    ELet(n, v, b, off) => ELet(n, v, scps_wrap_tail_resume(expr = b, ik = ik, sh = sh || n == "resume"), off),
    ELetMut(n, v, b, off) => ELetMut(n, v, scps_wrap_tail_resume(expr = b, ik = ik, sh = sh || n == "resume"), off),
    ELetRec(n, v, b) => ELetRec(n, v, scps_wrap_tail_resume(expr = b, ik = ik, sh = sh || n == "resume")),
    ESeq(a, b) => ESeq(a, scps_wrap_tail_resume(expr = b, ik = ik, sh = sh)),
    EAssign(n, v, c, target_off) => EAssign(n, v, scps_wrap_tail_resume(expr = c, ik = ik, sh = sh), target_off),
    EAssignOp(n, op, v, c, target_off) => EAssignOp(n, op, v, scps_wrap_tail_resume(expr = c, ik = ik, sh = sh), target_off),
    EReturn(_) => expr,
    ECall(callee, _, _, _) => match callee {
      EIdent(nm, _) => if nm == "resume" && !sh {
        expr
      } else {
        ECall(EIdent(ik, -1), [expr], -1, [])
      },
      _ => ECall(EIdent(ik, -1), [expr], -1, [])
    },
    _ => ECall(EIdent(ik, -1), [expr], -1, [])
  }
}

/// #3064 (P0): does a handle whose arm leaves the function with `return`
/// have to go through the driver below instead of evidence passing?
///
/// Evidence passing (evidence_dict_pass) splices an arm INLINE only at a
/// `perform` it can see directly in the handle body. Everywhere else -- a
/// callee whose row carries the effect, a closure that performs it -- the arm
/// runs as a closure in the evidence dictionary, and a `return` in a closure
/// returns from THAT closure: its value came back as the value of `perform`,
/// an implicit resume. Measured on main: `handle { ask(3) + 1 } with {
/// Cfg::Get(x) => return x + 40 }` followed by `r * 10` answered 1440 where
/// the function must return 43, on linear and gc, with no diagnostic. The
/// driver lowering already records an arm's `return` in a cell and performs
/// it after the handle (#2985), so such a handle is sent there.
///
/// The handle stays on evidence passing only when every place the effect can
/// be performed from its body is a direct `perform` outside any closure:
/// every other call must be provably unable to perform it (a pure builtin, a
/// constructor, `perform` of another effect, or a top-level function whose
/// concrete row lacks it and that no binder shadows). Anything this walk
/// cannot see through answers true -- the driver lowering then either handles
/// the shape or refuses it with a diagnostic, never a wrong answer.
fn scps_arm_return_needs_driver(body: Expr, arms: Array[(Pat, Expr)], ctx: (Array[Stmt], Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], Array[String], Array[Array[String]], Array[String], Array[(String, Array[String])]), scope: Array[(String, String, Bool)]) -> Bool {
  if !scps_body_arms_have_return(arms) {
    false
  } else {
    let (_, _, _, _, _, _, groups) = ctx
    let eff = scps_group_target(arms = arms, groups = groups)
    let mut uniform = true
    for arm in arms {
      let (p, _) = arm; match p {
        PCtor(q, _) => if !is_exception_throw_handler_name(q) && String::index_of(q, needle = "::") <= 0 {
          uniform = false
        },
        _ => uniform = false
      }
    }
    let (declared, decl_ops) = scps_effect_decl_ops(ctx = ctx, eff = eff)
    if !uniform || !declared {
      false
    } else {
      let ops = scps_target_qnames(ctx = ctx, eff = eff)
      let needing = scps_needing_for(ctx = ctx, eff = eff)
      scps_reaches_arm_indirectly(e = body, root = body, eff = eff, ops = ops, needing = needing, ctx = ctx, scope = scope, in_fn = false)
    }
  }
}

fn scps_scope_row_has(scope: Array[(String, String, Bool)], nm: String, eff: String, ctx: (Array[Stmt], Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], Array[String], Array[Array[String]], Array[String], Array[(String, Array[String])])) -> Bool {
  let mut found = false
  let mut i = 0
  while i < Array::length(scope) {
    let (snm, srow, _) = Array::get(scope, at = i)
    if snm == nm && (scps_row_contains(ctx = ctx, row = srow, eff = eff) || scps_row_has_var(srow)) {
      found = true
    } else {
      ()
    }
    i = i + 1
  }
  found
}

fn scps_name_is_local(root: Expr, scope: Array[(String, String, Bool)], nm: String) -> Bool {
  let mut found = false
  let mut i = 0
  while i < Array::length(scope) {
    let (snm, _, _) = Array::get(scope, at = i)
    if snm == nm {
      found = true
    } else {
      ()
    }
    i = i + 1
  }
  found || scps_binds_name(e = root, x = nm)
}

fn scps_reaches_arm_indirectly(e: Expr, root: Expr, eff: String, ops: Array[String], needing: Array[String], ctx: (Array[Stmt], Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], Array[String], Array[Array[String]], Array[String], Array[(String, Array[String])]), scope: Array[(String, String, Bool)], in_fn: Bool) -> Bool {
  match e {
    // A function passed as a value: a needing top-level function, or an
    // enclosing binding whose declared type carries the effect.
    EIdent(nm, _) => edp_str_array_contains(arr = needing, v = nm) || scps_scope_row_has(scope = scope, nm = nm, eff = eff, ctx = ctx),
    ECall(callee, args, _, _) => match callee {
      EIdent(nm, _) => if nm == "perform" {
        if scps_as_target_perform(e = e, ops = ops) >= 0 && in_fn {
          true
        } else {
          scps_reaches_arm_indirectly_exprs(es = scps_perform_args(e), root = root, eff = eff, ops = ops, needing = needing, ctx = ctx, scope = scope, in_fn = in_fn)
        }
      } else if scps_name_is_local(root = root, scope = scope, nm = nm) || edp_str_array_contains(arr = needing, v = nm) {
        true
      } else {
        // A builtin cannot perform a declared effect, and a function whose
        // row lacks it can reach it only through a closure argument (a row
        // variable instantiated to it) -- the arguments are walked for that.
        let (is_fn, row) = scps_fn_row_of(ctx = ctx, name = nm)
        let effect_free = if is_fn {
          !scps_row_contains(ctx = ctx, row = row, eff = eff)
        } else {
          idp_is_pure_builtin_call(nm) || scps_is_safe_mut_builtin(nm) || scps_is_ctor_name(ctx = ctx, nm = nm) || match lookup_registry_builtin(nm) {
            Some(_) => true,
            None => false
          }
        }
        if effect_free {
          scps_reaches_arm_indirectly_exprs(es = args, root = root, eff = eff, ops = ops, needing = needing, ctx = ctx, scope = scope, in_fn = in_fn)
        } else {
          true
        }
      },
      _ => true
    },
    EFn(_, _, _, _, _, b) => scps_reaches_arm_indirectly(e = b, root = root, eff = eff, ops = ops, needing = needing, ctx = ctx, scope = scope, in_fn = true),
    EHandle(b, harms) => {
      // A nested handle's arms may themselves run as evidence closures.
      let mut hit = scps_reaches_arm_indirectly(e = b, root = root, eff = eff, ops = ops, needing = needing, ctx = ctx, scope = scope, in_fn = in_fn)
      let mut i = 0
      while i < Array::length(harms) && !hit {
        let (_, ex) = Array::get(harms, at = i)
        hit = scps_reaches_arm_indirectly(e = ex, root = root, eff = eff, ops = ops, needing = needing, ctx = ctx, scope = scope, in_fn = true)
        i = i + 1
      }
      hit
    },
    _ => scps_reaches_arm_indirectly_exprs(es = expr_children(e), root = root, eff = eff, ops = ops, needing = needing, ctx = ctx, scope = scope, in_fn = in_fn)
  }
}

fn scps_reaches_arm_indirectly_exprs(es: Array[Expr], root: Expr, eff: String, ops: Array[String], needing: Array[String], ctx: (Array[Stmt], Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], Array[String], Array[Array[String]], Array[String], Array[(String, Array[String])]), scope: Array[(String, String, Bool)], in_fn: Bool) -> Bool {
  let mut hit = false
  let mut i = 0
  while i < Array::length(es) && !hit {
    hit = scps_reaches_arm_indirectly(e = Array::get(es, at = i), root = root, eff = eff, ops = ops, needing = needing, ctx = ctx, scope = scope, in_fn = in_fn)
    i = i + 1
  }
  hit
}

fn scps_rewrite_root(e: Expr, ctx: (Array[Stmt], Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], Array[String], Array[Array[String]], Array[String], Array[(String, Array[String])]), st: (Array[Int], Array[String], Array[String], Array[String], Array[String], Array[Stmt], Array[String]), cps_effs: Array[String], scope: Array[(String, String, Bool)]) -> Expr {
  let root_name = scps_seq_float_fresh(x = "returnroot", k = e, b = EUnit, site = scps_next_site(st))
  let owner = (root_name, [false])
  let mark = Array::length(scope)
  Array::push(scope, value = (root_name, "", true))
  let rewritten = scps_rewrite(e = e, ctx = ctx, st = st, cps_effs = cps_effs, scope = scope, return_frame = owner)
  Array::truncate(scope, length = mark)
  if Array::get(owner.1, at = 0) {
    scps_frame_wrap(name = root_name, body = scps_frame_rewrite_returns(e = rewritten, name = root_name))
  } else {
    rewritten
  }
}

fn scps_rewrite(e: Expr, ctx: (Array[Stmt], Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], Array[String], Array[Array[String]], Array[String], Array[(String, Array[String])]), st: (Array[Int], Array[String], Array[String], Array[String], Array[String], Array[Stmt], Array[String]), cps_effs: Array[String], scope: Array[(String, String, Bool)], return_frame: (String, Array[Bool])) -> Expr {
  match e {
    EHandle(body, arms) => {
      let rbody = scps_rewrite(e = body, ctx = ctx, st = st, cps_effs = cps_effs, scope = scope, return_frame = return_frame)
      let rarms = for a in arms {
        let (p, ex) = a
        let amark = Array::length(scope)
        scps_scope_push_pat(p = p, scope = scope)
        let rex = scps_rewrite(e = ex, ctx = ctx, st = st, cps_effs = cps_effs, scope = scope, return_frame = return_frame)
        Array::truncate(scope, length = amark)
        (p, rex)
      }
      let mut triggered = false
      let mut ai = 0
      while ai < Array::length(rarms) {
        let (ap, ab) = Array::get(rarms, at = ai)
        if scps_arm_refs_resume_value(e = ab, sh = scps_pat_binds_resume(ap)) {
          triggered = true
        } else {
          ()
        }
        ai = ai + 1
      }
      // #3064: an arm's `return` must leave the function even when the arm
      // would otherwise run as an evidence closure.
      // #3547: a refusal names what sent the handle here, so remember it.
      let return_escape = !triggered && scps_arm_return_needs_driver(body = rbody, arms = rarms, ctx = ctx, scope = scope)
      if return_escape {
        triggered = true
      } else {
        ()
      }
      // #3540: an arm whose `throw` an exception handler inside the body
      // would catch must run where the handle is, which only the driver does.
      let throw_escape = !triggered && scps_arm_throw_needs_driver(body = rbody, arms = rarms, ctx = ctx, scope = scope)
      if throw_escape {
        triggered = true
      } else {
        ()
      }
      let emark = Array::length(scps_st_errs(st))
      let why = if return_escape {
        "return"
      } else {
        "resume"
      }
      let lowered = scps_rewrite_triggered_handle(rbody = rbody, rarms = rarms, triggered = triggered, why = why, ctx = ctx, st = st, scope = scope, return_frame = return_frame)
      if throw_escape && Array::length(scps_st_errs(st)) > emark {
        // The driver cannot take this handle; its refusal would blame a
        // `resume` capture the program does not have. Name the real conflict.
        Array::truncate(scps_st_errs(st), length = emark)
        Array::push(scps_st_errs(st), value = String::concat(scps_throw_escape_msg(rarms), scps_throw_marker(arms = rarms, ctx = ctx, scope = scope)))
        EHandle(rbody, rarms)
      } else {
        lowered
      }
    },
    EFn(tps, tbs, params, ret, eff, b) => {
      let fmark = Array::length(scope)
      let mut fpi = 0
      while fpi < Array::length(params) {
        let (pnm, pty) = Array::get(params, at = fpi)
        Array::push(scope, value = (pnm, scps_ty_row(pty), match pty {
          Some(ty) => scps_ty_is_plain_data(ty),
          None => false
        }))
        fpi = fpi + 1
      }
      let frame_name = scps_seq_float_fresh(x = "returnframe", k = b, b = EUnit, site = scps_next_site(st))
      let own_frame = (frame_name, [false])
      Array::push(scope, value = (frame_name, "", true))
      let rb = scps_rewrite(e = b, ctx = ctx, st = st, cps_effs = cps_effs, scope = scope, return_frame = own_frame)
      Array::truncate(scope, length = fmark)
      EFn(tps, tbs, params, ret, eff, if Array::get(own_frame.1, at = 0) {
        scps_frame_wrap(name = frame_name, body = scps_frame_rewrite_returns(e = rb, name = frame_name))
      } else {
        rb
      })
    },
    _ => scps_rewrite_rest(e = e, ctx = ctx, st = st, cps_effs = cps_effs, scope = scope, return_frame = return_frame)
  }
}

/// The lowering of one `handle` after its body and arms were rewritten:
/// through the suspend driver when `triggered`, unchanged otherwise.
fn scps_rewrite_triggered_handle(rbody: Expr, rarms: Array[(Pat, Expr)], triggered: Bool, why: String, ctx: (Array[Stmt], Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], Array[String], Array[Array[String]], Array[String], Array[(String, Array[String])]), st: (Array[Int], Array[String], Array[String], Array[String], Array[String], Array[Stmt], Array[String]), scope: Array[(String, String, Bool)], return_frame: (String, Array[Bool])) -> Expr {
  if triggered {
    let own_arms: Array[(Pat, Expr)] = []
    let catch_arms: Array[(Pat, Expr)] = []
    for arm in rarms {
      let (pat, _) = arm
      let catches = match pat {
        PCtor(q, _) => is_exception_throw_handler_name(q),
        _ => false
      }
      if catches {
        Array::push(catch_arms, value = arm)
      } else {
        Array::push(own_arms, value = arm)
      }
    }
    // #2962 (Codex P0 on #2985): a sibling arm that captures `resume`
    // sends the WHOLE handle through the driver below, where an arm's
    // value is the driver's final result -- so a bare arm (`Get() =>
    // "abcd"`) next to a capturing one ABORTED the handle with its value,
    // while the checker (and the tail-resumptive lowering the same arm
    // takes with no such sibling) reads a bare tail value as an implicit
    // `resume`. Measured: an Int-valued handle over `Get() -> String`
    // answered `296352743426`, the string delivered as the Int. The tail
    // values of every non-capturing arm are wrapped in `resume(..)` here,
    // so the driver runs the continuation for them exactly as the
    // non-suspend lowering does. The continuation is called through
    // `ik`, a fresh name the driver binds beside `resume`, so an arm
    // whose payload binder or local `let` is named `resume` resumes too
    // (Codex P0 on #2985) instead of calling the user's binding.
    let iksite = scps_next_site(st)
    let ik = scps_seq_float_fresh(x = "iresume", k = EHandle(rbody, rarms), b = EUnit, site = iksite)
    let sarms = for a in own_arms {
      let (ap, ab) = a
      let ashadow = scps_pat_binds_resume(ap)
      if scps_arm_refs_resume_value(e = ab, sh = ashadow) {
        (ap, ab)
      } else {
        (ap, scps_wrap_tail_resume(expr = ab, ik = ik, sh = ashadow))
      }
    }
    // #1536: a `return` in a HANDLE body means "leave the enclosing
    // function", not "the handle's value", so it cannot be hoisted to the
    // body's tail the way a function's own return is. The value is
    // recorded in a cell declared OUTSIDE the handle, the body finishes
    // with a placeholder, and the real return happens after the handle --
    // where it is an ordinary spine return the hoist handles if this whole
    // thing is itself inside a body being split.
    // A `return` inside an ARM has the same problem as one inside the
    // body: the arm runs inside the driver's step closure, so a bare
    // `return v` handed `v` to the driver as the handle's value (measured
    // `420` for `Get() => return 42` followed by `r * 10`, Codex P2 on
    // #2985). The arms go through the same cell rewrite as the body, AFTER
    // the implicit-resume wrap, so the recorded placeholder stays an
    // unwrapped tail (an abort of the driver) and the real return happens
    // after the handle.
    if scps_loop_ctl_remains(rbody) || scps_loop_arms_ctl_remain(sarms) {
      // #3019: a `break` / `continue` in this handle that targets a loop
      // OUTSIDE it. The handle runs inside the driver's step closure, so
      // codegen emitted a branch to a label the closure does not have and
      // the module failed validation (`expected 1 elements on the stack
      // for branch`) after a clean `vibe check`. Refused with the edit
      // until the record-and-transfer rewrite `return` gets exists for
      // loop transfers too.
      Array::push(scps_st_errs(st), value = if why == "return" {
        String::concat(scps_driver_lead(why = why, eff = scps_arms_effect_name(rarms)), "a `break` / `continue` inside this `handle` leaves a loop outside it, which the rewritten body cannot do -- or set a flag inside the handle and `break` after it")
      } else {
        "a `break` / `continue` inside this `handle` leaves a loop outside it, but a handler arm captures `resume` as a value, so the handle runs as a closure the transfer cannot leave -- set a flag inside the handle and `break` after it, or `return` from the function instead"
      })
      EHandle(rbody, rarms)
    } else if scps_body_has_return(rbody) || scps_body_arms_have_return(sarms) || scps_body_arms_have_return(catch_arms) {
      let frame_name = return_frame.0
      if frame_name == "" {
        Array::push(scps_st_errs(st), value = "a return in a suspending handler has no enclosing function")
        EHandle(rbody, rarms)
      } else {
        Array::set(return_frame.1, at = 0, value = true)
        let captured = scps_frame_rewrite_returns(e = rbody, name = frame_name)
        let sarms_ret = for arm in sarms {
          (arm.0, scps_frame_rewrite_returns(e = arm.1, name = frame_name))
        }
        let catch_ret = for arm in catch_arms {
          (arm.0, scps_frame_rewrite_returns(e = arm.1, name = frame_name))
        }
        let protected_body = if Array::length(catch_ret) == 0 {
          captured
        } else {
          EHandle(captured, catch_ret)
        }
        match scps_transform_handle(body = protected_body, arms = sarms_ret, ik = ik, why = why, ctx = ctx, st = st, scope = scope) {
          Some(lowered) => lowered,
          None => EHandle(protected_body, sarms_ret)
        }
      }
    } else {
      let protected_body = if Array::length(catch_arms) == 0 {
        rbody
      } else {
        EHandle(rbody, catch_arms)
      }
      match scps_transform_handle(body = protected_body, arms = sarms, ik = ik, why = why, ctx = ctx, st = st, scope = scope) {
        Some(t) => t,
        None => EHandle(protected_body, sarms)
      }
    }
  } else {
    EHandle(rbody, rarms)
  }
}

/// `scps_rewrite` for every node but `EHandle` and `EFn`.
fn scps_rewrite_rest(e: Expr, ctx: (Array[Stmt], Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], Array[String], Array[Array[String]], Array[String], Array[(String, Array[String])]), st: (Array[Int], Array[String], Array[String], Array[String], Array[String], Array[Stmt], Array[String]), cps_effs: Array[String], scope: Array[(String, String, Bool)], return_frame: (String, Array[Bool])) -> Expr {
  match e {
    ELet(n, v, b, off) => {
      let rv = scps_rewrite(e = v, ctx = ctx, st = st, cps_effs = cps_effs, scope = scope, return_frame = return_frame)
      let lmark = Array::length(scope)
      Array::push(scope, value = (n, scps_let_bind_row(v = rv, cps_effs = cps_effs), scps_value_is_data(v = rv, scope = scps_scope_from_visible(visible = scope, eff = "", ctx = ctx))))
      let rb = scps_rewrite(e = b, ctx = ctx, st = st, cps_effs = cps_effs, scope = scope, return_frame = return_frame)
      Array::truncate(scope, length = lmark)
      ELet(n, rv, rb, off)
    },
    ELetMut(n, v, b, off) => {
      let rv = scps_rewrite(e = v, ctx = ctx, st = st, cps_effs = cps_effs, scope = scope, return_frame = return_frame)
      let lmark = Array::length(scope)
      Array::push(scope, value = (n, "", false))
      let rb = scps_rewrite(e = b, ctx = ctx, st = st, cps_effs = cps_effs, scope = scope, return_frame = return_frame)
      Array::truncate(scope, length = lmark)
      ELetMut(n, rv, rb, off)
    },
    ELetRec(n, v, b) => {
      let lmark = Array::length(scope)
      Array::push(scope, value = (n, "", false))
      let rv = scps_rewrite(e = v, ctx = ctx, st = st, cps_effs = cps_effs, scope = scope, return_frame = return_frame)
      let rb = scps_rewrite(e = b, ctx = ctx, st = st, cps_effs = cps_effs, scope = scope, return_frame = return_frame)
      Array::truncate(scope, length = lmark)
      ELetRec(n, rv, rb)
    },
    ESeq(a, b) => ESeq(scps_rewrite(e = a, ctx = ctx, st = st, cps_effs = cps_effs, scope = scope, return_frame = return_frame), scps_rewrite(e = b, ctx = ctx, st = st, cps_effs = cps_effs, scope = scope, return_frame = return_frame)),
    EIf(c, t, el) => EIf(scps_rewrite(e = c, ctx = ctx, st = st, cps_effs = cps_effs, scope = scope, return_frame = return_frame), scps_rewrite(e = t, ctx = ctx, st = st, cps_effs = cps_effs, scope = scope, return_frame = return_frame), scps_rewrite(e = el, ctx = ctx, st = st, cps_effs = cps_effs, scope = scope, return_frame = return_frame)),
    EMatch(s, arms) => EMatch(scps_rewrite(e = s, ctx = ctx, st = st, cps_effs = cps_effs, scope = scope, return_frame = return_frame), for a in arms {
      let (p, ex) = a
      let amark = Array::length(scope)
      scps_scope_push_pat(p = p, scope = scope)
      let rex = scps_rewrite(e = ex, ctx = ctx, st = st, cps_effs = cps_effs, scope = scope, return_frame = return_frame)
      Array::truncate(scope, length = amark)
      (p, rex)
    }),
    EWhile(c, b) => EWhile(scps_rewrite(e = c, ctx = ctx, st = st, cps_effs = cps_effs, scope = scope, return_frame = return_frame), scps_rewrite(e = b, ctx = ctx, st = st, cps_effs = cps_effs, scope = scope, return_frame = return_frame)),
    EForIn(n, idx, it, b) => {
      let rit = scps_rewrite(e = it, ctx = ctx, st = st, cps_effs = cps_effs, scope = scope, return_frame = return_frame)
      let fmark = Array::length(scope)
      Array::push(scope, value = (n, "", false))
      match idx {
        Some(ix) => Array::push(scope, value = (ix, "", false)),
        None => ()
      }
      let rb = scps_rewrite(e = b, ctx = ctx, st = st, cps_effs = cps_effs, scope = scope, return_frame = return_frame)
      Array::truncate(scope, length = fmark)
      EForIn(n, idx, rit, rb)
    },
    ECall(callee, args, off, callee_resolution) => ECall(scps_rewrite(e = callee, ctx = ctx, st = st, cps_effs = cps_effs, scope = scope, return_frame = return_frame), for a in args {
      scps_rewrite(e = a, ctx = ctx, st = st, cps_effs = cps_effs, scope = scope, return_frame = return_frame)
    }, off, callee_resolution),
    EBinOp(op, l, r, boff) => EBinOp(op, scps_rewrite(e = l, ctx = ctx, st = st, cps_effs = cps_effs, scope = scope, return_frame = return_frame), scps_rewrite(e = r, ctx = ctx, st = st, cps_effs = cps_effs, scope = scope, return_frame = return_frame), boff),
    EUnaryOp(op, e2) => EUnaryOp(op, scps_rewrite(e = e2, ctx = ctx, st = st, cps_effs = cps_effs, scope = scope, return_frame = return_frame)),
    EAssign(n, v, c, target_off) => EAssign(n, scps_rewrite(e = v, ctx = ctx, st = st, cps_effs = cps_effs, scope = scope, return_frame = return_frame), scps_rewrite(e = c, ctx = ctx, st = st, cps_effs = cps_effs, scope = scope, return_frame = return_frame), target_off),
    EAssignOp(n, op, v, c, target_off) => EAssignOp(n, op, scps_rewrite(e = v, ctx = ctx, st = st, cps_effs = cps_effs, scope = scope, return_frame = return_frame), scps_rewrite(e = c, ctx = ctx, st = st, cps_effs = cps_effs, scope = scope, return_frame = return_frame), target_off),
    EDot(o, f, off1, off2) => EDot(scps_rewrite(e = o, ctx = ctx, st = st, cps_effs = cps_effs, scope = scope, return_frame = return_frame), f, off1, off2),
    ELabeledArg(l, n, v) => ELabeledArg(l, n, scps_rewrite(e = v, ctx = ctx, st = st, cps_effs = cps_effs, scope = scope, return_frame = return_frame)),
    EReturn(e2) => EReturn(scps_rewrite(e = e2, ctx = ctx, st = st, cps_effs = cps_effs, scope = scope, return_frame = return_frame)),
    EBreak(opt) => EBreak(match opt {
      Some(e2) => Some(scps_rewrite(e = e2, ctx = ctx, st = st, cps_effs = cps_effs, scope = scope, return_frame = return_frame)),
      None => None
    }),
    EContinue(args) => EContinue(for a in args {
      scps_rewrite(e = a, ctx = ctx, st = st, cps_effs = cps_effs, scope = scope, return_frame = return_frame)
    }),
    ETuple(elems) => ETuple(for a in elems {
      scps_rewrite(e = a, ctx = ctx, st = st, cps_effs = cps_effs, scope = scope, return_frame = return_frame)
    }),
    EArray(elems) => EArray(for a in elems {
      scps_rewrite(e = a, ctx = ctx, st = st, cps_effs = cps_effs, scope = scope, return_frame = return_frame)
    }),
    ERecord(n, fields, tas) => ERecord(n, for f in fields {
      let (fn2, v) = f
      (fn2, scps_rewrite(e = v, ctx = ctx, st = st, cps_effs = cps_effs, scope = scope, return_frame = return_frame))
    }, tas),
    EMap(fields) => EMap(for f in fields {
      let (fn2, v) = f
      (fn2, scps_rewrite(e = v, ctx = ctx, st = st, cps_effs = cps_effs, scope = scope, return_frame = return_frame))
    }),
    ESpread(e2) => ESpread(scps_rewrite(e = e2, ctx = ctx, st = st, cps_effs = cps_effs, scope = scope, return_frame = return_frame)),
    ELoop(pairs, b) => {
      let rpairs = for p in pairs {
        let (n, v) = p
        (n, scps_rewrite(e = v, ctx = ctx, st = st, cps_effs = cps_effs, scope = scope, return_frame = return_frame))
      }
      let lmark = Array::length(scope)
      let mut lpi = 0
      while lpi < Array::length(pairs) {
        let (n, _) = Array::get(pairs, at = lpi)
        Array::push(scope, value = (n, "", false))
        lpi = lpi + 1
      }
      let rb = scps_rewrite(e = b, ctx = ctx, st = st, cps_effs = cps_effs, scope = scope, return_frame = return_frame)
      Array::truncate(scope, length = lmark)
      ELoop(rpairs, rb)
    },
    _ => e
  }
}

/// The statement `scps_rewrite` is in, for `scps_program_may_catch_elsewhere`.
let scps_cur_stmt: Array[Int] = []

/// #3540 (P0): does a handle whose arm can THROW have to run its arms through
/// the driver below instead of being lowered in place?
///
/// In place, an arm runs where its effect is performed: spliced at a direct
/// `perform`, or as the evidence closure a needing call runs inside its
/// callee. An exception is one wasm tag caught by the dynamically innermost
/// exception handler, so a `throw` in the arm was caught by any exception
/// handler between that point and the `handle` -- while the arm's effects
/// belong to the code around the `handle` (the checker types them there).
/// Measured on main: an `Ask::Get() => throw("not an int")` arm over a body
/// that reaches the perform inside `handle { .. } with { Exception[Int]::
/// Throw(code) => code * 2 }` answered `r=274877906954` (the string's pointer
/// doubled as an Int) where the outer `Exception[String]` arm must answer -1.
/// The driver runs an arm at the handle, after the body has suspended out of
/// its own handlers.
///
/// True when some arm of a non-exception effect may throw and an exception
/// handler can sit between a perform of that effect and the handle: one
/// written in the body whose own body can reach the perform, or one in code
/// the arm's evidence may run inside (the body reaches the perform other than
/// directly, and the program has an exception handler some call could be
/// running). Anything this cannot see through answers true; the driver then
/// lowers the handle or it is refused with the edit, never answered wrongly.
fn scps_arm_throw_needs_driver(body: Expr, arms: Array[(Pat, Expr)], ctx: (Array[Stmt], Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], Array[String], Array[Array[String]], Array[String], Array[(String, Array[String])]), scope: Array[(String, String, Bool)]) -> Bool {
  // A sibling exception arm protects the handled body, never the user
  // effect arm itself. Calling that arm through evidence would run it
  // under the sibling's dynamic catch, so use the driver even for a direct
  // perform in the body.
  if idp_arms_discharge_error(arms) {
    for arm in arms {
      let (pat, ab) = arm
      let user_arm = match pat {
        PCtor(q, _) => !is_exception_throw_handler_name(q),
        _ => false
      }
      if user_arm && scps_arm_may_throw(e = ab, root = ab, ctx = ctx, scope = scope) {
        return true
      }
    }
  }
  // Per effect, the operations whose arm may throw. Only a perform of one of
  // THOSE runs a throwing arm, so only their reachability matters: in a
  // handle over `A` and `B` whose `A` arm throws, a `B` perform under an
  // inner exception handler runs `B`'s arm there, which cannot throw.
  let effs = array_empty_str()
  let eff_ops: Array[Array[String]] = []
  for a in arms {
    let (p, ab) = a
    match p {
      PCtor(q, _) => if !is_exception_throw_handler_name(q) && scps_arm_may_throw(e = ab, root = ab, ctx = ctx, scope = scope) {
        let ci = String::index_of(q, needle = "::")
        let qe = if ci > 0 {
          String::substring(q, start = 0, end = ci)
        } else {
          q
        }
        let mut slot = 0 - 1
        let mut i = 0
        while i < Array::length(effs) {
          if Array::get(effs, at = i) == qe {
            slot = i
          } else {
            ()
          }
          i = i + 1
        }
        if slot < 0 {
          Array::push(effs, value = qe)
          Array::push(eff_ops, value = [q])
        } else {
          Array::push(Array::get(eff_ops, at = slot), value = q)
        }
      } else {
        ()
      },
      _ => ()
    }
  }
  let mut hit = false
  let mut ei = 0
  while ei < Array::length(effs) && !hit {
    let eff = Array::get(effs, at = ei)
    let (declared, _) = scps_effect_decl_ops(ctx = ctx, eff = eff)
    if !declared {
      hit = true
    } else {
      let ops = Array::get(eff_ops, at = ei)
      let needing = scps_needing_for(ctx = ctx, eff = eff)
      if scps_catch_reaches(e = body, root = body, eff = eff, ops = ops, needing = needing, ctx = ctx, scope = scope) {
        hit = true
      } else if scps_reaches_arm_indirectly(e = body, root = body, eff = eff, ops = ops, needing = needing, ctx = ctx, scope = scope, in_fn = false) && scps_program_may_catch_elsewhere(ctx) {
        hit = true
      } else {
        ()
      }
    }
    ei = ei + 1
  }
  hit
}

/// May evaluating this arm expression throw? `root` is the arm, whose own
/// binders make a callee local (and so unseen).
fn scps_arm_may_throw(e: Expr, root: Expr, ctx: (Array[Stmt], Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], Array[String], Array[Array[String]], Array[String], Array[(String, Array[String])]), scope: Array[(String, String, Bool)]) -> Bool {
  match e {
    ECall(callee, args, _, _) => match callee {
      EIdent(nm, _) => if nm == "throw" {
        true
      } else if nm == "perform" {
        is_exception_effect_name(edp_user_perform_effect_of(e)) || scps_arms_may_throw_exprs(es = scps_perform_args(e), root = root, ctx = ctx, scope = scope)
      } else if scps_name_is_local(root = root, scope = scope, nm = nm) {
        // A local whose one binding in this statement is a lambda literal is
        // judged by that lambda (its declared row, then its body).
        match scps_known_local_lambda(ctx = ctx, nm = nm) {
          Some((lrow, lbody)) => if scps_row_may_throw(ctx = ctx, row = lrow) {
            true
          } else if edp_str_array_contains(arr = scps_lambda_visiting, v = nm) {
            scps_arms_may_throw_exprs(es = args, root = root, ctx = ctx, scope = scope)
          } else {
            Array::push(scps_lambda_visiting, value = nm)
            let hit = scps_arm_may_throw(e = lbody, root = lbody, ctx = ctx, scope = scope)
            Array::truncate(scps_lambda_visiting, length = Array::length(scps_lambda_visiting) - 1)
            hit || scps_arms_may_throw_exprs(es = args, root = root, ctx = ctx, scope = scope)
          },
          None => true
        }
      } else {
        let (is_fn, row) = scps_fn_row_of(ctx = ctx, name = nm)
        let seen_through = if is_fn {
          !scps_row_may_throw(ctx = ctx, row = row)
        } else {
          nm == "resume" || nm == "__to_string" || idp_is_pure_builtin_call(nm) || scps_is_safe_mut_builtin(nm) || scps_is_ctor_name(ctx = ctx, nm = nm) || match lookup_registry_builtin(nm) {
            Some(_) => true,
            None => false
          }
        }
        if seen_through {
          scps_arms_may_throw_exprs(es = args, root = root, ctx = ctx, scope = scope)
        } else {
          true
        }
      },
      _ => true
    },
    EIdent(nm, _) => if scps_name_is_local(root = root, scope = scope, nm = nm) {
      scps_scope_row_has(scope = scope, nm = nm, eff = "Exception", ctx = ctx)
    } else {
      let (is_fn, row) = scps_fn_row_of(ctx = ctx, name = nm)
      is_fn && scps_row_may_throw(ctx = ctx, row = row)
    },
    _ => scps_arms_may_throw_exprs(es = expr_children(e), root = root, ctx = ctx, scope = scope)
  }
}

fn scps_arms_may_throw_exprs(es: Array[Expr], root: Expr, ctx: (Array[Stmt], Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], Array[String], Array[Array[String]], Array[String], Array[(String, Array[String])]), scope: Array[(String, String, Bool)]) -> Bool {
  let mut hit = false
  let mut i = 0
  while i < Array::length(es) && !hit {
    hit = scps_arm_may_throw(e = Array::get(es, at = i), root = root, ctx = ctx, scope = scope)
    i = i + 1
  }
  hit
}

/// Local lambdas `scps_arm_may_throw` is inside, so a recursive one ends.
let scps_lambda_visiting: Array[String] = []

/// (declared row, body) of the lambda literal `nm` names in the statement
/// being rewritten, when that `let` is the ONLY binding of `nm` there --
/// a parameter, a pattern, a `let mut` or a second `let` of the same name
/// could be what a call resolves to, so any of those answers None.
fn scps_known_local_lambda(ctx: (Array[Stmt], Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], Array[String], Array[Array[String]], Array[String], Array[(String, Array[String])]), nm: String) -> Option[(String, Expr)] {
  let (stmts, _, _, _, _, _, _) = ctx
  let cur = if Array::length(scps_cur_stmt) > 0 {
    Array::get(scps_cur_stmt, at = 0)
  } else {
    0 - 1
  }
  if cur < 0 || cur >= Array::length(stmts) {
    None
  } else {
    let root = match Array::get(stmts, at = cur) {
      SLet(_, _, _, _, v) => Some(v),
      SLetMut(_, _, v) => Some(v),
      SExpr(v) => Some(v),
      STest(_, v) => Some(v),
      SBench(_, v) => Some(v),
      _ => None
    }
    match root {
      Some(v) => {
        let found: Array[(String, Expr)] = []
        let others = [0]
        scps_find_local_lambda(e = v, nm = nm, found = found, others = others)
        if Array::length(found) == 1 && Array::get(others, at = 0) == 0 {
          Some(Array::get(found, at = 0))
        } else {
          None
        }
      },
      None => None
    }
  }
}

/// Every binding of `nm` in `e`: a `let nm = <lambda>` goes to `found`, any
/// other binder counts in `others[0]`.
fn scps_find_local_lambda(e: Expr, nm: String, found: Array[(String, Expr)], others: Array[Int]) -> Unit {
  let mut other = 0
  match e {
    ELet(n, v, _, _) => if n == nm {
      match v {
        EFn(_, _, _, _, eff, body) => Array::push(found, value = (match eff {
          Some(r) => r,
          None => ""
        }, body)),
        _ => {
          other = 1
        }
      }
    } else (),
    ELetMut(n, _, _, _) => if n == nm {
      other = 1
    } else (),
    ELetRec(n, _, _) => if n == nm {
      other = 1
    } else (),
    EFn(_, _, params, _, _, _) => {
      let mut i = 0
      while i < Array::length(params) {
        let (pn, _) = Array::get(params, at = i)
        if pn == nm || pn == String::concat(nm, "?") {
          other = 1
        } else ()
        i = i + 1
      }
    },
    ELoop(states, _) => {
      let mut i = 0
      while i < Array::length(states) {
        let (sn, _) = Array::get(states, at = i)
        if sn == nm {
          other = 1
        } else ()
        i = i + 1
      }
    },
    EForIn(n, idx, _, _) => if n == nm || match idx {
      Some(ix) => ix == nm,
      None => false
    } {
      other = 1
    } else (),
    EMatch(_, arms) => if scps_arms_bind_name(arms = arms, nm = nm) {
      other = 1
    } else (),
    EHandle(_, arms) => if scps_arms_bind_name(arms = arms, nm = nm) {
      other = 1
    } else (),
    _ => ()
  }
  if other > 0 {
    Array::set(others, at = 0, value = Array::get(others, at = 0) + 1)
  } else ()
  let kids = expr_children(e)
  let mut k = 0
  while k < Array::length(kids) {
    scps_find_local_lambda(e = Array::get(kids, at = k), nm = nm, found = found, others = others)
    k = k + 1
  }
}

fn scps_arms_bind_name(arms: Array[(Pat, Expr)], nm: String) -> Bool {
  let mut hit = false
  let mut i = 0
  while i < Array::length(arms) {
    let (p, _) = Array::get(arms, at = i)
    if scps_pat_binds_name(p = p, x = nm) {
      hit = true
    } else ()
    i = i + 1
  }
  hit
}

/// The source offset of the innermost call in an arm that may throw, for the
/// refusal's position; -1 when none carries one.
fn scps_throw_site_offset(e: Expr, root: Expr, ctx: (Array[Stmt], Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], Array[String], Array[Array[String]], Array[String], Array[(String, Array[String])]), scope: Array[(String, String, Bool)]) -> Int {
  let kids = expr_children(e)
  let mut found = 0 - 1
  let mut i = 0
  while i < Array::length(kids) && found < 0 {
    let k = Array::get(kids, at = i)
    if scps_arm_may_throw(e = k, root = root, ctx = ctx, scope = scope) {
      found = scps_throw_site_offset(e = k, root = root, ctx = ctx, scope = scope)
    } else ()
    i = i + 1
  }
  if found >= 0 {
    found
  } else {
    match e {
      ECall(EIdent(nm, off), args, _, _) => if nm == "perform" && Array::length(args) == 1 {
        match Array::get(args, at = 0) {
          ECall(EIdent(_, ooff), _, _, _) => ooff,
          EIdent(_, ooff) => ooff,
          _ => off
        }
      } else {
        off
      },
      EIdent(_, off) => off,
      _ => 0 - 1
    }
  }
}

fn scps_row_may_throw(ctx: (Array[Stmt], Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], Array[String], Array[Array[String]], Array[String], Array[(String, Array[String])]), row: String) -> Bool {
  if scps_row_has_var(row) || scps_row_contains(ctx = ctx, row = row, eff = "Exception") {
    true
  } else {
    let mut hit = false
    for item in String::split(row, sep = ",") {
      let label = String::trim(item)
      if String::length(label) > 0 && is_exception_label(label) {
        hit = true
      } else {
        ()
      }
    }
    hit
  }
}

/// Is there a `handle` with an exception arm inside `e` whose own body can
/// reach a perform of `eff`?
fn scps_catch_reaches(e: Expr, root: Expr, eff: String, ops: Array[String], needing: Array[String], ctx: (Array[Stmt], Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], Array[String], Array[Array[String]], Array[String], Array[(String, Array[String])]), scope: Array[(String, String, Bool)]) -> Bool {
  let here = match e {
    EHandle(hb, harms) => idp_arms_discharge_error(harms) && scps_reaches_arm_indirectly(e = hb, root = root, eff = eff, ops = ops, needing = needing, ctx = ctx, scope = scope, in_fn = true),
    _ => false
  }
  if here {
    true
  } else {
    let kids = expr_children(e)
    let mut hit = false
    let mut i = 0
    while i < Array::length(kids) && !hit {
      hit = scps_catch_reaches(e = Array::get(kids, at = i), root = root, eff = eff, ops = ops, needing = needing, ctx = ctx, scope = scope)
      i = i + 1
    }
    hit
  }
}

/// Could a call made from the statement being rewritten be running inside an
/// exception handler? One inside any function (top-level or a lambda) can be;
/// the current top-level function's own handlers count only when its name is
/// referenced, since a call can then re-enter it.
fn scps_program_may_catch_elsewhere(_ ctx: (Array[Stmt], Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], Array[String], Array[Array[String]], Array[String], Array[(String, Array[String])])) -> Bool {
  let (stmts, _, _, _, _, _, _) = ctx
  let cur = if Array::length(scps_cur_stmt) > 0 {
    Array::get(scps_cur_stmt, at = 0)
  } else {
    0 - 1
  }
  let mut hit = false
  let mut i = 0
  while i < Array::length(stmts) && !hit {
    hit = match Array::get(stmts, at = i) {
      SLet(_, _, nm, _, v) => match v {
        EFn(_, _, _, _, _, b) => scps_has_catch(e = b, top = i != cur || scps_name_referenced(stmts = stmts, nm = nm)),
        _ => scps_has_catch(e = v, top = false)
      },
      SLetMut(_, _, v) => scps_has_catch(e = v, top = false),
      SExpr(v) => scps_has_catch(e = v, top = false),
      STest(_, v) => scps_has_catch(e = v, top = false),
      SBench(_, v) => scps_has_catch(e = v, top = false),
      _ => false
    }
    i = i + 1
  }
  hit
}

/// A `handle` with an exception arm in `e`; at its top level only when `top`,
/// and anywhere inside a lambda.
fn scps_has_catch(e: Expr, top: Bool) -> Bool {
  match e {
    EFn(_, _, _, _, _, b) => scps_has_catch(e = b, top = true),
    _ => {
      let here = match e {
        EHandle(_, harms) => top && idp_arms_discharge_error(harms),
        _ => false
      }
      if here {
        true
      } else {
        let kids = expr_children(e)
        let mut hit = false
        let mut i = 0
        while i < Array::length(kids) && !hit {
          hit = scps_has_catch(e = Array::get(kids, at = i), top = top)
          i = i + 1
        }
        hit
      }
    }
  }
}

// review-lint: allow-program-walk (answers a summary question: whether one name is referenced)
fn scps_name_referenced(stmts: Array[Stmt], nm: String) -> Bool {
  let mut hit = false
  let mut i = 0
  while i < Array::length(stmts) && !hit {
    hit = match Array::get(stmts, at = i) {
      SLet(_, _, _, _, v) => edp_rq_fold(q = RQRefsName(nm), e = v) > 0,
      SLetMut(_, _, v) => edp_rq_fold(q = RQRefsName(nm), e = v) > 0,
      SExpr(v) => edp_rq_fold(q = RQRefsName(nm), e = v) > 0,
      STest(_, v) => edp_rq_fold(q = RQRefsName(nm), e = v) > 0,
      SBench(_, v) => edp_rq_fold(q = RQRefsName(nm), e = v) > 0,
      _ => false
    }
    i = i + 1
  }
  hit
}

/// #3547: how a refusal from the handle's driver lowering begins -- with
/// what sent the handle there. `why` is "resume" when an arm captures
/// `resume` as a value (the historic wording, which already names the
/// arm's own construct) and "return" when an arm leaves the function with
/// `return` while the body reaches the effect only through a call; that
/// one used to borrow the `resume` wording for a program that captures
/// nothing, so it now leads with the edits that avoid the driver: a direct
/// `perform` in the body runs the arm where the `handle` is.
fn scps_driver_lead(why: String, eff: String) -> String {
  if why == "return" {
    String::concat(String::concat(String::concat("write `perform ", eff), String::concat("::..` in the `handle` body itself instead of calling a function that performs it, or `resume` with a value and `return` after the `handle` -- a handler arm for `", eff)), "` here leaves the function with `return`, and since the body reaches the effect through a call, the body is rewritten into steps so that arm can run where the `handle` is, but ")
  } else {
    "a handler arm captures `resume` as a value, but "
  }
}

/// ` [@off=N]` at the first throwing site of a non-exception arm.
fn scps_throw_marker(arms: Array[(Pat, Expr)], ctx: (Array[Stmt], Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], Array[String], Array[Array[String]], Array[String], Array[(String, Array[String])]), scope: Array[(String, String, Bool)]) -> String {
  let mut at = 0 - 1
  for a in arms {
    let (p, ab) = a
    match p {
      PCtor(q, _) => if at < 0 && !is_exception_throw_handler_name(q) && scps_arm_may_throw(e = ab, root = ab, ctx = ctx, scope = scope) {
        at = scps_throw_site_offset(e = ab, root = ab, ctx = ctx, scope = scope)
      } else (),
      _ => ()
    }
  }
  if at >= 0 {
    String::concat(" [@off=", String::concat(__to_string(at), "]"))
  } else {
    ""
  }
}

fn scps_prepass_bind_local(scope: Array[(String, Int)], name: String, value: Expr, ctx: (Array[Stmt], Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], Array[String], Array[Array[String]], Array[String], Array[(String, Array[String])])) -> Array[(String, Int)] {
  let kind = match value {
    EIdent(target, _) => scps_prepass_alias_class(scope = scope, target = target, ctx = ctx),
    // A plain local closure does not acquire the step call convention merely
    // because it is later passed to `spawn_suspend`. Kind 2 is reserved for a
    // literal the prepass has already split for Async.
    EFn(_, _, _, _, _, _) => if scps_literal_is_own_step_for(v = value, eff = "Async") {
      2
    } else {
      1
    },
    _ => 0
  }
  scps_scope_bind(scope = scope, name = name, kind = kind)
}

/// #3555: an optional parameter (`task?: () -> T with Async`) is declared
/// `Option[..]`, and a supplied argument arrives as `Some(closure)`. The
/// closure is the slot the call-convention fixups judge: left wrapped, a pure
/// literal was not Done-wrapped and the scheduler's step call trapped. Each
/// such argument is replaced by its payload, its wrapper kept index for index
/// (`EUnit` elsewhere; the shared empty array when there is none).
fn scps_unwrap_optional_slots(fparams: Array[(String, Option[TypeExpr])], rargs: Array[Expr]) -> Array[Expr] {
  let mut out = scps_no_opt_wraps
  let mut aj = 0
  while aj < Array::length(rargs) && aj < Array::length(fparams) {
    let w = Array::get(rargs, at = aj)
    match w {
      ECall(EIdent(ctor, _), cargs, _, _) => if (ctor == "Some" || ctor == "Option::Some") && Array::length(cargs) == 1 && scps_is_optional_fn_ty(Array::get(fparams, at = aj).1) {
        if Array::length(out) == 0 {
          out = []
          while Array::length(out) < Array::length(rargs) {
            Array::push(out, value = EUnit)
          }
        } else {
          ()
        }
        Array::set(out, at = aj, value = w)
        Array::set(rargs, at = aj, value = Array::get(cargs, at = 0))
      } else {
        ()
      },
      _ => ()
    }
    aj = aj + 1
  }
  out
}

let scps_no_opt_wraps: Array[Expr] = []

/// Is the parameter type `Option[(..) -> ..]`?
fn scps_is_optional_fn_ty(_ pty: Option[TypeExpr]) -> Bool {
  match pty {
    Some(TyApp(head, targs)) => head == "Option" && Array::length(targs) == 1 && match Array::get(targs, at = 0) {
      TyFn(_, _, _) => true,
      _ => false
    },
    _ => false
  }
}

/// The type the fixups judge argument `aj` against: the option's element
/// where `scps_unwrap_optional_slots` unwrapped it, else the parameter's.
fn scps_slot_param_ty(fparams: Array[(String, Option[TypeExpr])], aj: Int, opt_wraps: Array[Expr]) -> Option[TypeExpr] {
  let (_, pty) = Array::get(fparams, at = aj)
  if aj < Array::length(opt_wraps) {
    match (Array::get(opt_wraps, at = aj), pty) {
      (ECall(_, _, _, _), Some(TyApp(_, targs))) => Some(Array::get(targs, at = 0)),
      _ => pty
    }
  } else {
    pty
  }
}

/// Put each unwrapped payload, as the fixups left it, back in its `Some`.
fn scps_rewrap_optional_slots(rargs: Array[Expr], opt_wraps: Array[Expr]) -> Unit {
  let mut aj = 0
  while aj < Array::length(opt_wraps) {
    match Array::get(opt_wraps, at = aj) {
      ECall(ctor, _, coff, cres) => {
        let payload = Array::get(rargs, at = aj)
        Array::set(rargs, at = aj, value = ECall(ctor, [payload], coff, cres))
      },
      _ => ()
    }
    aj = aj + 1
  }
}

/// #3517: is parameter `aj` the task closure of a spawn-shaped callee -- the
/// last parameter, after a `TaskGroup` first one (`TaskGroup::spawn`,
/// `Parallel::map`, and a wrapper with their shape)?
fn scps_is_task_param(fparams: Array[(String, Option[TypeExpr])], aj: Int) -> Bool {
  if aj == 0 || aj != Array::length(fparams) - 1 {
    false
  } else {
    let (_, first_ty) = Array::get(fparams, at = 0)
    match first_ty {
      Some(TyApp(head, _)) => head == "TaskGroup",
      Some(TyName(head)) => head == "TaskGroup",
      _ => false
    }
  }
}

/// #3517: an argument the prepass step-compiled for `eff` at its own level: a
/// split closure literal, or a local bound to one (scope kind 2, which
/// `scps_prepass_bind_local` reserves for an `Async` step literal).
fn scps_arg_is_own_step_for(arg: Expr, eff: String, scope: Array[(String, Int)]) -> Bool {
  match arg {
    EFn(_, _, _, _, _, _) => scps_literal_is_own_step_for(v = arg, eff = eff),
    EIdent(name, _) => is_runtime_scheduled_effect(eff) && scps_local_class(scope = scope, name = name) == 2,
    _ => false
  }
}

/// #3523: a top-level function whose row carries the effect, passed by name.
/// Its original is what the scheduler calls, on the plain convention, so a
/// suspension in it reached no handler and trapped (Codex on #3524).
fn scps_arg_names_needing_fn(arg: Expr, needing: Array[String], scope: Array[(String, Int)]) -> Bool {
  match arg {
    EIdent(name, _) => scps_local_class(scope = scope, name = name) < 0 && edp_str_array_contains(arr = needing, v = name),
    _ => false
  }
}

fn scps_task_cannot_suspend_msg(fname: String, eff: String) -> String {
  let head = String::concat(String::concat("`", fname), String::concat("` runs its task to completion, so the task cannot suspend, but this task closure uses `", String::concat(eff, "`")))
  if is_runtime_scheduled_effect(eff) {
    String::concat(head, " (directly or through a function whose row carries it): start the task with `TaskGroup::spawn_suspend` from `@vibe/concurrent/experimental` instead, or move that call out of the task")
  } else {
    String::concat(head, String::concat(": handle `", String::concat(eff, "` inside the task, or move the performing call out of the task")))
  }
}

fn scps_callee_marker(_ callee: Expr) -> String {
  match callee {
    EIdent(_, coff) => if coff >= 0 {
      String::concat(" [@off=", String::concat(__to_string(coff), "]"))
    } else {
      ""
    },
    _ => ""
  }
}

fn scps_prepass_callee_params(scope: Array[(String, Int)], name: String, ctx: (Array[Stmt], Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], Array[String], Array[Array[String]], Array[String], Array[(String, Array[String])])) -> Option[Array[(String, Option[TypeExpr])]] {
  let local = scps_local_class(scope = scope, name = name)
  if local >= 3 {
    scps_fn_def_params_at(ctx = ctx, def_idx = local - 3)
  } else if local >= 0 {
    None
  } else {
    scps_fn_def_params(ctx = ctx, name = name)
  }
}

/// Step-split one literal for `eff`. Pushes errors on ineligibility;
/// returns the literal unchanged in that case (the error is fatal anyway).
fn scps_split_literal(tps: Array[String], tbs: Array[(String, Array[String])], params: Array[(String, Option[TypeExpr])], b: Expr, ecfg: (String, Array[String], Array[String]), ctx: (Array[Stmt], Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], Array[String], Array[Array[String]], Array[String], Array[(String, Array[String])]), st: (Array[Int], Array[String], Array[String], Array[String], Array[String], Array[Stmt], Array[String])) -> Expr {
  let (eff, ops_qnames, needing) = ecfg
  let errs = scps_st_errs(st)
  let site = scps_next_site(st)
  let cps_seed = array_empty_str()
  let mut cpi = 0
  while cpi < Array::length(params) {
    let (pnm, pty) = Array::get(params, at = cpi)
    let prow = scps_ty_row(pty)
    if prow != "" && scps_row_contains(ctx = ctx, row = prow, eff = eff) {
      Array::push(cps_seed, value = pnm)
    } else {
      ()
    }
    cpi = cpi + 1
  }
  let sctx = (eff, ops_qnames, needing, site, cps_seed)
  let call_scope = scps_scope_from_params(params = params, eff = eff, inert_generated = array_empty_str(), ctx = ctx)
  if !scps_calls_ok(e = b, sctx = sctx, ctx = ctx, scope = call_scope) {
    // #1536 / #1514 parity: name the offending call in the literal's body.
    let (culprit_lead, culprit_clause, culprit_marker) = scps_culprit_parts(e = b, sctx = sctx, ctx = ctx, scope = call_scope)
    let mut scps_msg = String::concat(culprit_lead, String::concat(String::concat("a closure literal whose row carries ", eff), " calls something the suspend lowering cannot see through (a local closure, a method-style callee, a nested handle, or a row-variable callee)"))
    scps_msg = String::concat(scps_msg, culprit_clause)
    scps_msg = String::concat(scps_msg, "")
    scps_msg = String::concat(scps_msg, culprit_marker)
    Array::push(errs, value = scps_msg)
    EFn(tps, tbs, params, None, None, b)
  } else if scps_body_has_return(scps_elim_returns(e = match scps_elim_loop_returns(e = b, site = site) {
    Some(lifted) => lifted,
    None => b
  }, site = site)) {
    Array::push(errs, value = scps_return_in_split_msg(String::concat(String::concat("a closure literal whose row carries ", eff), " (suspend class) is split into continuations, so its body")))
    EFn(tps, tbs, params, None, None, b)
  } else {
    // #1536: same hoist -- `return v` in a closure literal is that closure's
    // own value, which is what its tail is.
    let (split_ok, split_body) = scps_split_tail(e = scps_elim_array_for(e = scps_elim_returns(e = match scps_elim_loop_returns(e = b, site = site) {
      Some(lifted) => lifted,
      None => b
    }, site = site), known = scps_array_names_seed(params), kstr = scps_string_names_seed(params), site = site, ctr = scps_anf_ctr(), ctx = ctx), sctx = sctx, ctx = ctx, st = st)
    if !split_ok {
      Array::push(errs, value = String::concat(String::concat("a closure literal whose row carries ", eff), " performs it (or calls a function that performs it) off the let/seq/tail/branch-tail spine (a loop body containing `return`, a `for` form, nested closures/handles, and a selected `&&` / `||` right operand that transfers control with `return` / `break` / `continue` are not eligible; a suspension inside an `if` / `match` branch or a `&&` / `||` right operand IS eligible wherever the selection or the short-circuit itself is strictly evaluated (a statement, the tail, the whole value of a `let` / `let mut` / assignment, or a strictly evaluated part of a compound); a `while` / `loop` spine is, including one carrying `break` / `continue`, and so is a suspension inside an operand, a call argument or a constructor payload)"))
      EFn(tps, tbs, params, None, None, b)
    } else {
      scps_ensure_effect_runtime(eff = eff, ctx = ctx, st = st)
      EFn(tps, tbs, params, None, None, split_body)
    }
  }
}

fn scps_prepass_expr(e: Expr, ecfgs: Array[(String, Array[String], Array[String])], ctx: (Array[Stmt], Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], Array[String], Array[Array[String]], Array[String], Array[(String, Array[String])]), st: (Array[Int], Array[String], Array[String], Array[String], Array[String], Array[Stmt], Array[String]), split_effs: Array[String], scope: Array[(String, Int)]) -> Expr {
  match e {
    EFn(tps, tbs, params, ret, eff, b) => {
      let b2 = scps_prepass_expr(e = b, ecfgs = ecfgs, ctx = ctx, st = st, split_effs = split_effs, scope = scps_scope_bind_params(scope = scope, params = params, eff = "", ctx = ctx))
      let mut hit_eff = ""
      let mut multi = false
      let mut ei = 0
      while ei < Array::length(ecfgs) {
        let (ceff, cops, cneeding) = Array::get(ecfgs, at = ei)
        let probe = (ceff, cops, cneeding, 0, array_empty_str())
        // #3192: calling a closure this literal binds itself, and that the
        // prepass already step-compiled (`b2` holds it split), suspends too.
        // Left unsplit, the literal called it under the plain convention and
        // got the step object back as the value.
        if scps_lit_needs(e = b2, sctx = probe) || scps_calls_step_local(e = b2, eff = ceff, names = scps_no_names, add = true, skip_discharged = true, ops = cops) {
          if hit_eff == "" {
            hit_eff = ceff
          } else {
            multi = true
          }
        } else {
          ()
        }
        ei = ei + 1
      }
      if multi {
        Array::push(scps_st_errs(st), value = "a closure literal raw-performs more than one suspend-class effect -- not supported (split the effect or handle one of them inside the literal)")
        EFn(tps, tbs, params, ret, eff, b2)
      } else if hit_eff != "" {
        let mut cfg = ("", array_empty_str(), array_empty_str())
        let mut ci = 0
        while ci < Array::length(ecfgs) {
          let (ceff, _, _) = Array::get(ecfgs, at = ci)
          if ceff == hit_eff {
            cfg = Array::get(ecfgs, at = ci)
          } else {
            ()
          }
          ci = ci + 1
        }
        if edp_str_array_contains(arr = split_effs, v = hit_eff) {
          ()
        } else {
          Array::push(split_effs, value = hit_eff)
        }
        scps_split_literal(tps = tps, tbs = tbs, params = params, b = b2, ecfg = cfg, ctx = ctx, st = st)
      } else {
        EFn(tps, tbs, params, ret, eff, b2)
      }
    },
    ECall(callee, args, off, callee_resolution) => {
      let mut rcallee = scps_prepass_expr(e = callee, ecfgs = ecfgs, ctx = ctx, st = st, split_effs = split_effs, scope = scope)
      let rargs = for a in args {
        scps_prepass_expr(e = a, ecfgs = ecfgs, ctx = ctx, st = st, split_effs = split_effs, scope = scope)
      }
      // arg-position convention fixups against the callee's declared params.
      //
      // #1723: this lookup is BY NAME against the module's top level and this
      // walk tracks no local bindings, so a local shadowing `fname` would have
      // the top-level function's parameter rows applied to a call that never
      // reaches it -- Done-wrapping a pure literal the local closure then calls
      // under the plain convention (the #1707 shape, inverted). It is currently
      // unreachable ONLY because the checker refuses those programs first, and
      // it refuses them for the same shadowing reason (#1723 is that bug). Fix
      // the checker and this opens: thread a locals set through
      // scps_prepass_expr in the same change.
      match rcallee {
        EIdent(fname, _) => {
          match scps_prepass_callee_params(scope = scope, name = fname, ctx = ctx) {
            Some(fparams) => {
              let opt_wraps = scps_unwrap_optional_slots(fparams = fparams, rargs = rargs)
              let mut aj = 0
              while aj < Array::length(rargs) {
                if aj < Array::length(fparams) {
                  let pty = scps_slot_param_ty(fparams = fparams, aj = aj, opt_wraps = opt_wraps)
                  let prow = scps_ty_row(pty)
                  // Every resolved Async-taking parameter uses the step call
                  // convention, including wrappers around spawn_suspend.
                  if scps_row_contains(ctx = ctx, row = prow, eff = "Async") {
                    match Array::get(rargs, at = aj) {
                      EIdent(task_name, _) => if scps_local_class(scope = scope, name = task_name) == 1 {
                        Array::push(scps_st_errs(st), value = String::concat("pass the task closure inline at `", String::concat(fname, String::concat("` instead of passing `", String::concat(task_name, "`: this local closure has the plain call convention")))))
                      } else {
                        ()
                      },
                      _ => ()
                    }
                  } else {
                    ()
                  }
                  // #1707: the mirror of the fixup below. A literal the prepass
                  // STEP-SPLIT returns `__ScpsStep_E`, so it may only land in a
                  // parameter whose declared row carries E. Passed to a plain
                  // parameter, the callee calls it under the ordinary convention
                  // and hands the step OBJECT back as the value -- that compiled
                  // clean and silently returned a heap pointer as an Int.
                  let mut ei0 = 0
                  while ei0 < Array::length(ecfgs) {
                    let (ceff0, _, cneeding0) = Array::get(ecfgs, at = ei0)
                    // A parameter whose row is a row VARIABLE is exempt: the
                    // variable can be instantiated to this effect at the call
                    // site, which is exactly what makes
                    // `TaskGroup::run[T, rg, e](body: (..) -> T with e)` able to
                    // receive a step-returning literal. Only a CONCRETE row that
                    // does not carry the effect is a plain-convention parameter.
                    if !scps_row_has_var(prow) && !scps_row_contains(ctx = ctx, row = prow, eff = ceff0) && scps_literal_is_step_for(v = Array::get(rargs, at = aj), eff = ceff0) {
                      Array::push(scps_st_errs(st), value = String::concat(String::concat(String::concat("a closure literal that performs `", ceff0), "` (so it is compiled to return a step) is passed to a parameter of `"), String::concat(String::concat(fname, "` whose type does not declare that effect -- the callee would call it under the plain convention and hand the step object back as the value. Declare the parameter as `(..) -> .. with "), String::concat(ceff0, "`, or move the performing call out of the literal"))))
                    } else if scps_row_has_var(prow) && !scps_row_contains(ctx = ctx, row = prow, eff = ceff0) && scps_is_task_param(fparams = fparams, aj = aj) && (scps_arg_is_own_step_for(arg = Array::get(rargs, at = aj), eff = ceff0, scope = scope) || scps_arg_names_needing_fn(arg = Array::get(rargs, at = aj), needing = cneeding0, scope = scope)) {
                      // #3517: the row-variable exemption above does not hold
                      // for a task parameter. A spawn-shaped callee (a
                      // `TaskGroup` first, the task closure last) stores the
                      // closure and its scheduler calls it later under the plain
                      // convention, so no clone of the callee can thread the
                      // step through. `TaskGroup::spawn(g, () -> { sleep_wait(10)
                      // 100 })` compiled clean and `join` answered 1604.
                      Array::push(scps_st_errs(st), value = String::concat(scps_task_cannot_suspend_msg(fname = fname, eff = ceff0), scps_callee_marker(rcallee)))
                    } else {
                      ()
                    }
                    ei0 = ei0 + 1
                  }
                  if prow != "" {
                    let mut ei2 = 0
                    while ei2 < Array::length(ecfgs) {
                      let (ceff, _, cneeding) = Array::get(ecfgs, at = ei2)
                      if scps_row_contains(ctx = ctx, row = prow, eff = ceff) {
                        match Array::get(rargs, at = aj) {
                          EFn(atps, atbs, aparams, aret, aeff, ab) => if scps_literal_is_step_for(v = Array::get(rargs, at = aj), eff = ceff) {
                            ()
                          } else {
                            // pure literal in an E-row position: Done-wrap so
                            // it matches the step convention.
                            let mut cfg2 = ("", array_empty_str(), array_empty_str())
                            let mut ci2 = 0
                            while ci2 < Array::length(ecfgs) {
                              let (ceff2, _, _) = Array::get(ecfgs, at = ci2)
                              if ceff2 == ceff {
                                cfg2 = Array::get(ecfgs, at = ci2)
                              } else {
                                ()
                              }
                              ci2 = ci2 + 1
                            }
                            if edp_str_array_contains(arr = split_effs, v = ceff) {
                              ()
                            } else {
                              Array::push(split_effs, value = ceff)
                            }
                            Array::set(rargs, at = aj, value = scps_split_literal(tps = atps, tbs = atbs, params = aparams, b = ab, ecfg = cfg2, ctx = ctx, st = st))
                          },
                          EIdent(anm, aoff) => if edp_str_array_contains(arr = cneeding, v = anm) {
                            scps_need_clone(eff = ceff, fname = anm, st = st)
                            if edp_str_array_contains(arr = split_effs, v = ceff) {
                              ()
                            } else {
                              Array::push(split_effs, value = ceff)
                            }
                            Array::set(rargs, at = aj, value = EIdent(scps_clone_name(eff = ceff, fname = anm), aoff))
                          } else {
                            ()
                          },
                          _ => ()
                        }
                      } else {
                        ()
                      }
                      ei2 = ei2 + 1
                    }
                  } else {
                    ()
                  }
                } else {
                  ()
                }
                aj = aj + 1
              }
              scps_rewrap_optional_slots(rargs = rargs, opt_wraps = opt_wraps)
            },
            None => ()
          }
        },
        _ => ()
      }
      ECall(rcallee, rargs, off, callee_resolution)
    },
    EHandle(b, arms) => EHandle(scps_prepass_expr(e = b, ecfgs = ecfgs, ctx = ctx, st = st, split_effs = split_effs, scope = scope), for a in arms {
      let (p, ex) = a
      (p, scps_prepass_expr(e = ex, ecfgs = ecfgs, ctx = ctx, st = st, split_effs = split_effs, scope = scps_scope_bind_pat(scope = scope, p = p)))
    }),
    ELet(n, v, b, off) => {
      let v2 = scps_prepass_expr(e = v, ecfgs = ecfgs, ctx = ctx, st = st, split_effs = split_effs, scope = scope)
      ELet(n, v2, scps_prepass_expr(e = b, ecfgs = ecfgs, ctx = ctx, st = st, split_effs = split_effs, scope = scps_prepass_bind_local(scope = scope, name = n, value = v2, ctx = ctx)), off)
    },
    ELetMut(n, v, b, off) => ELetMut(n, scps_prepass_expr(e = v, ecfgs = ecfgs, ctx = ctx, st = st, split_effs = split_effs, scope = scope), scps_prepass_expr(e = b, ecfgs = ecfgs, ctx = ctx, st = st, split_effs = split_effs, scope = scps_scope_bind(scope = scope, name = n, kind = 0)), off),
    ELetRec(n, v, b) => {
      let inner = scps_scope_bind(scope = scope, name = n, kind = 0)
      ELetRec(n, scps_prepass_expr(e = v, ecfgs = ecfgs, ctx = ctx, st = st, split_effs = split_effs, scope = inner), scps_prepass_expr(e = b, ecfgs = ecfgs, ctx = ctx, st = st, split_effs = split_effs, scope = inner))
    },
    ESeq(a, b) => ESeq(scps_prepass_expr(e = a, ecfgs = ecfgs, ctx = ctx, st = st, split_effs = split_effs, scope = scope), scps_prepass_expr(e = b, ecfgs = ecfgs, ctx = ctx, st = st, split_effs = split_effs, scope = scope)),
    EIf(c, t, el) => EIf(scps_prepass_expr(e = c, ecfgs = ecfgs, ctx = ctx, st = st, split_effs = split_effs, scope = scope), scps_prepass_expr(e = t, ecfgs = ecfgs, ctx = ctx, st = st, split_effs = split_effs, scope = scope), scps_prepass_expr(e = el, ecfgs = ecfgs, ctx = ctx, st = st, split_effs = split_effs, scope = scope)),
    EMatch(s, arms) => EMatch(scps_prepass_expr(e = s, ecfgs = ecfgs, ctx = ctx, st = st, split_effs = split_effs, scope = scope), for a in arms {
      let (p, ex) = a
      (p, scps_prepass_expr(e = ex, ecfgs = ecfgs, ctx = ctx, st = st, split_effs = split_effs, scope = scps_scope_bind_pat(scope = scope, p = p)))
    }),
    EWhile(c, b) => EWhile(scps_prepass_expr(e = c, ecfgs = ecfgs, ctx = ctx, st = st, split_effs = split_effs, scope = scope), scps_prepass_expr(e = b, ecfgs = ecfgs, ctx = ctx, st = st, split_effs = split_effs, scope = scope)),
    EForIn(n, idx, it, b) => {
      let inner = scps_scope_bind_opt(scope = scps_scope_bind(scope = scope, name = n, kind = 0), name = idx, kind = 0)
      EForIn(n, idx, scps_prepass_expr(e = it, ecfgs = ecfgs, ctx = ctx, st = st, split_effs = split_effs, scope = scope), scps_prepass_expr(e = b, ecfgs = ecfgs, ctx = ctx, st = st, split_effs = split_effs, scope = inner))
    },
    EBinOp(op, l, r, boff) => EBinOp(op, scps_prepass_expr(e = l, ecfgs = ecfgs, ctx = ctx, st = st, split_effs = split_effs, scope = scope), scps_prepass_expr(e = r, ecfgs = ecfgs, ctx = ctx, st = st, split_effs = split_effs, scope = scope), boff),
    EUnaryOp(op, x) => EUnaryOp(op, scps_prepass_expr(e = x, ecfgs = ecfgs, ctx = ctx, st = st, split_effs = split_effs, scope = scope)),
    EAssign(n, v, c, target_off) => EAssign(n, scps_prepass_expr(e = v, ecfgs = ecfgs, ctx = ctx, st = st, split_effs = split_effs, scope = scope), scps_prepass_expr(e = c, ecfgs = ecfgs, ctx = ctx, st = st, split_effs = split_effs, scope = scope), target_off),
    EAssignOp(n, op, v, c, target_off) => EAssignOp(n, op, scps_prepass_expr(e = v, ecfgs = ecfgs, ctx = ctx, st = st, split_effs = split_effs, scope = scope), scps_prepass_expr(e = c, ecfgs = ecfgs, ctx = ctx, st = st, split_effs = split_effs, scope = scope), target_off),
    EDot(o, f, off1, off2) => EDot(scps_prepass_expr(e = o, ecfgs = ecfgs, ctx = ctx, st = st, split_effs = split_effs, scope = scope), f, off1, off2),
    ELabeledArg(l, n, v) => ELabeledArg(l, n, scps_prepass_expr(e = v, ecfgs = ecfgs, ctx = ctx, st = st, split_effs = split_effs, scope = scope)),
    EReturn(x) => EReturn(scps_prepass_expr(e = x, ecfgs = ecfgs, ctx = ctx, st = st, split_effs = split_effs, scope = scope)),
    EBreak(opt) => EBreak(match opt {
      Some(x) => Some(scps_prepass_expr(e = x, ecfgs = ecfgs, ctx = ctx, st = st, split_effs = split_effs, scope = scope)),
      None => None
    }),
    EContinue(args) => EContinue(for a in args {
      scps_prepass_expr(e = a, ecfgs = ecfgs, ctx = ctx, st = st, split_effs = split_effs, scope = scope)
    }),
    ETuple(items) => ETuple(for a in items {
      scps_prepass_expr(e = a, ecfgs = ecfgs, ctx = ctx, st = st, split_effs = split_effs, scope = scope)
    }),
    EArray(items) => EArray(for a in items {
      scps_prepass_expr(e = a, ecfgs = ecfgs, ctx = ctx, st = st, split_effs = split_effs, scope = scope)
    }),
    ERecord(n, fields, tas) => ERecord(n, for f in fields {
      let (fn2, v) = f
      (fn2, scps_prepass_expr(e = v, ecfgs = ecfgs, ctx = ctx, st = st, split_effs = split_effs, scope = scope))
    }, tas),
    EMap(fields) => EMap(for f in fields {
      let (fn2, v) = f
      (fn2, scps_prepass_expr(e = v, ecfgs = ecfgs, ctx = ctx, st = st, split_effs = split_effs, scope = scope))
    }),
    ESpread(x) => ESpread(scps_prepass_expr(e = x, ecfgs = ecfgs, ctx = ctx, st = st, split_effs = split_effs, scope = scope)),
    ELoop(pairs, b) => {
      let names = array_empty_str()
      let rpairs = for p in pairs {
        let (n, v) = p
        Array::push(names, value = n)
        (n, scps_prepass_expr(e = v, ecfgs = ecfgs, ctx = ctx, st = st, split_effs = split_effs, scope = scope))
      }
      ELoop(rpairs, scps_prepass_expr(e = b, ecfgs = ecfgs, ctx = ctx, st = st, split_effs = split_effs, scope = scps_scope_bind_names(scope = scope, names = names, kind = 0)))
    },
    _ => e
  }
}

// Phase 5 (guard): once ANY literal/arg was step-compiled for an effect,
// the step convention is global for that effect's closure values -- an
// UNTRIGGERED handle for it left in the program (evidence/Phase 2/replay
// bound) would call them under the value convention. v1: hard error.

fn scps_guard_untriggered(e: Expr, guard_effs: Array[String], errs: Array[String]) -> Unit {
  match e {
    EHandle(b, arms) => {
      scps_guard_untriggered(e = b, guard_effs = guard_effs, errs = errs)
      for guard_arm in arms {
        let (p0, _) = guard_arm
        match p0 {
          PCtor(q, _) => {
            let ci = String::index_of(q, needle = "::")
            if ci > 0 && edp_str_array_contains(arr = guard_effs, v = String::substring(q, start = 0, end = ci)) {
              // #3161: lead with the edit. A top-level function keeps both
              // conventions (the suspend lowering clones it and leaves the
              // original for this handler); a closure literal gets only one.
              let ge = String::substring(q, start = 0, end = ci)
              let edit = String::concat(String::concat(String::concat("a closure literal that performs `", ge), "` is called under a handler that resumes in place; declare it as a top-level `fn .. with "), String::concat(ge, "` instead, or make every handler of it store `resume`"))
              let async_edit = if is_runtime_scheduled_effect(ge) {
                " (for `Async`, run the closure in a `TaskGroup::spawn_suspend` task)"
              } else {
                ""
              }
              Array::push(errs, value = String::concat(String::concat(String::concat(edit, async_edit), String::concat(" -- effect ", ge)), " has step-compiled closure values (a literal or argument was CPS-lowered for it), but this handle for it does not capture `resume` as a value: mixing the step convention with tail-resumptive/replay handling of the same effect is not supported"))
            } else {
              ()
            }
          },
          _ => ()
        }
      }
      let mut i = 0
      while i < Array::length(arms) {
        let (_, ex) = Array::get(arms, at = i)
        scps_guard_untriggered(e = ex, guard_effs = guard_effs, errs = errs)
        i = i + 1
      }
    },
    EFn(_, _, _, _, _, b) => scps_guard_untriggered(e = b, guard_effs = guard_effs, errs = errs),
    ELet(_, v, b, _) => {
      scps_guard_untriggered(e = v, guard_effs = guard_effs, errs = errs)
      scps_guard_untriggered(e = b, guard_effs = guard_effs, errs = errs)
    },
    ELetMut(_, v, b, _) => {
      scps_guard_untriggered(e = v, guard_effs = guard_effs, errs = errs)
      scps_guard_untriggered(e = b, guard_effs = guard_effs, errs = errs)
    },
    ELetRec(_, v, b) => {
      scps_guard_untriggered(e = v, guard_effs = guard_effs, errs = errs)
      scps_guard_untriggered(e = b, guard_effs = guard_effs, errs = errs)
    },
    ESeq(a, b) => {
      scps_guard_untriggered(e = a, guard_effs = guard_effs, errs = errs)
      scps_guard_untriggered(e = b, guard_effs = guard_effs, errs = errs)
    },
    EIf(c, t, el) => {
      scps_guard_untriggered(e = c, guard_effs = guard_effs, errs = errs)
      scps_guard_untriggered(e = t, guard_effs = guard_effs, errs = errs)
      scps_guard_untriggered(e = el, guard_effs = guard_effs, errs = errs)
    },
    EMatch(s, arms) => {
      scps_guard_untriggered(e = s, guard_effs = guard_effs, errs = errs)
      let mut i = 0
      while i < Array::length(arms) {
        let (_, ex) = Array::get(arms, at = i)
        scps_guard_untriggered(e = ex, guard_effs = guard_effs, errs = errs)
        i = i + 1
      }
    },
    ECall(callee, args, _, _) => {
      scps_guard_untriggered(e = callee, guard_effs = guard_effs, errs = errs)
      let mut i = 0
      while i < Array::length(args) {
        scps_guard_untriggered(e = Array::get(args, at = i), guard_effs = guard_effs, errs = errs)
        i = i + 1
      }
    },
    EWhile(c, b) => {
      scps_guard_untriggered(e = c, guard_effs = guard_effs, errs = errs)
      scps_guard_untriggered(e = b, guard_effs = guard_effs, errs = errs)
    },
    EForIn(_, _, it, b) => {
      scps_guard_untriggered(e = it, guard_effs = guard_effs, errs = errs)
      scps_guard_untriggered(e = b, guard_effs = guard_effs, errs = errs)
    },
    ELoop(pairs, b) => {
      let mut i = 0
      while i < Array::length(pairs) {
        let (_, v) = Array::get(pairs, at = i)
        scps_guard_untriggered(e = v, guard_effs = guard_effs, errs = errs)
        i = i + 1
      }
      scps_guard_untriggered(e = b, guard_effs = guard_effs, errs = errs)
    },
    EBinOp(_, l, r, _) => {
      scps_guard_untriggered(e = l, guard_effs = guard_effs, errs = errs)
      scps_guard_untriggered(e = r, guard_effs = guard_effs, errs = errs)
    },
    EUnaryOp(_, x) => scps_guard_untriggered(e = x, guard_effs = guard_effs, errs = errs),
    EAssign(_, v, c, _) => {
      scps_guard_untriggered(e = v, guard_effs = guard_effs, errs = errs)
      scps_guard_untriggered(e = c, guard_effs = guard_effs, errs = errs)
    },
    EAssignOp(_, _, v, c, _) => {
      scps_guard_untriggered(e = v, guard_effs = guard_effs, errs = errs)
      scps_guard_untriggered(e = c, guard_effs = guard_effs, errs = errs)
    },
    EReturn(x) => scps_guard_untriggered(e = x, guard_effs = guard_effs, errs = errs),
    EDot(o, _, _, _) => scps_guard_untriggered(e = o, guard_effs = guard_effs, errs = errs),
    ELabeledArg(_, _, v) => scps_guard_untriggered(e = v, guard_effs = guard_effs, errs = errs),
    EBreak(opt) => match opt {
      Some(x) => scps_guard_untriggered(e = x, guard_effs = guard_effs, errs = errs),
      None => ()
    },
    EContinue(args) => {
      let mut i = 0
      while i < Array::length(args) {
        scps_guard_untriggered(e = Array::get(args, at = i), guard_effs = guard_effs, errs = errs)
        i = i + 1
      }
    },
    ETuple(items) => {
      let mut i = 0
      while i < Array::length(items) {
        scps_guard_untriggered(e = Array::get(items, at = i), guard_effs = guard_effs, errs = errs)
        i = i + 1
      }
    },
    EArray(items) => {
      let mut i = 0
      while i < Array::length(items) {
        scps_guard_untriggered(e = Array::get(items, at = i), guard_effs = guard_effs, errs = errs)
        i = i + 1
      }
    },
    ERecord(_, fields, _) => {
      let mut i = 0
      while i < Array::length(fields) {
        let (_, v) = Array::get(fields, at = i)
        scps_guard_untriggered(e = v, guard_effs = guard_effs, errs = errs)
        i = i + 1
      }
    },
    EMap(fields) => {
      let mut i = 0
      while i < Array::length(fields) {
        let (_, v) = Array::get(fields, at = i)
        scps_guard_untriggered(e = v, guard_effs = guard_effs, errs = errs)
        i = i + 1
      }
    },
    ESpread(x) => scps_guard_untriggered(e = x, guard_effs = guard_effs, errs = errs),
    _ => ()
  }
}

/// --- allocation-free trigger pre-scan (#1102 perf). scps_rewrite
/// reconstructs every node it walks, so running it unconditionally deep-
/// copied the ENTIRE program's top-level bodies on every compile — for a
/// program with no suspend-class handles at all (the compiler itself:
/// ~4k handles, every one a plain `with Exception`) that was pure allocation
/// churn, a measurable slice of the selfcompile heap KPI. This walk
/// allocates nothing and answers "does this expression contain ANY handle
/// arm that value-references `resume`?"; the pass skips fact-table
/// construction entirely when no statement triggers, and leaves
/// non-triggering statements' trees fully shared (unreconstructed).
fn scps_expr_has_trigger(_ e: Expr) -> Bool {
  edp_rq_fold(q = RQTrigger, e = e) > 0
}

fn scps_stmt_has_trigger(_ s: Stmt) -> Bool {
  match s {
    SLet(_, _, _, _, expr) => scps_expr_has_trigger(expr),
    SLetMut(_, _, expr) => scps_expr_has_trigger(expr),
    SExpr(expr) => scps_expr_has_trigger(expr),
    STest(_, expr) => scps_expr_has_trigger(expr),
    SBench(_, expr) => scps_expr_has_trigger(expr),
    _ => false
  }
}
