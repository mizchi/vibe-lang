import @vibe/compiler/core {
  Expr, Pat, Stmt
}
import @vibe/core {
  struct MutSet
}
import @vibe/compiler/lowering/effects/queries {
  EdpReadQuery, edp_handle_statement_index, edp_handle_statement_indices, edp_rq_fold
}
import @vibe/compiler/lowering/effects/evidence {
  edp_erase_effect_handles_with_index
}

fn indexed_handle(_ name: String) -> Expr {
  EHandle(EInt(0), [(PCtor(name + "::Get", []), EInt(1))])
}

fn oracle_statement_indices(stmts: Array[Stmt], effect: String) -> Array[Int] {
  let out: Array[Int] = []
  let mut i = 0
  while i < Array::length(stmts) {
    let found = match Array::get(stmts, at = i) {
      SLet(_, _, _, _, expr) => edp_rq_fold(q = RQHandlesEffect(effect), e = expr),
      SLetMut(_, _, expr) => edp_rq_fold(q = RQHandlesEffect(effect), e = expr),
      SExpr(expr) => edp_rq_fold(q = RQHandlesEffect(effect), e = expr),
      STest(_, expr) => edp_rq_fold(q = RQHandlesEffect(effect), e = expr),
      SBench(_, expr) => edp_rq_fold(q = RQHandlesEffect(effect), e = expr),
      _ => 0
    }
    if found > 0 {
      Array::push(out, value = i)
    } else ()
    i = i + 1
  }
  out
}

test "handle statement index preserves owner order and deduplicates nested sites" {
  let stmts = [
    SExpr(ESeq(indexed_handle("Ask"), indexed_handle("Ask"))),
    SLet(false, false, "f", None, EFn([], [], [], None, None, indexed_handle("Other"))),
    SLetMut("x", None, indexed_handle("Ask")),
    STest("test", indexed_handle("Ask")),
    SBench("bench", indexed_handle("Ask")),
    SModule(false, "ignored", [SExpr(indexed_handle("Ask"))])
  ]
  let index = edp_handle_statement_index(stmts)
  inspect(edp_handle_statement_indices(index = index, effect = "Ask"), content = "[0, 2, 3, 4]")
  inspect(edp_handle_statement_indices(index = index, effect = "Other"), content = "[1]")
  inspect(edp_handle_statement_indices(index = index, effect = "Missing"), content = "[]")
}

test "handle index agrees with the independent containment query across containers" {
  let hit = indexed_handle("Ask")
  let containers = [
    ETuple([EInt(0), hit]),
    EArray([hit]),
    ERecord("R", [("x", hit)], []),
    EMap([("x", hit)]),
    EIf(EBool(false), EInt(0), hit),
    ELet("x", EInt(0), hit, -1),
    ELetMut("x", hit, EInt(0), -1),
    ELetRec("x", hit, EInt(0)),
    EAssign("x", EInt(0), hit, -1),
    EAssignOp("x", "+", hit, EInt(0), -1),
    ESeq(EInt(0), hit),
    EMatch(EInt(0), [(PWild, hit)]),
    EHandle(EInt(0), [(PCtor("Other::Get", []), hit)]),
    EWhile(EBool(false), hit),
    ELoop([("x", hit)], EInt(0)),
    ELoop([], hit),
    EForIn("x", None, EArray([]), hit),
    ECall(EIdent("f", -1), [hit], -1, []),
    ECall(hit, [], -1, []),
    EBinOp("+", hit, EInt(0), -1),
    EUnaryOp("-", hit),
    EFn([], [], [], None, None, hit),
    EDot(hit, "x", -1, -1),
    ELabeledArg("", "x", hit),
    EReturn(hit),
    EBreak(Some(hit)),
    EContinue([hit]),
    ESpread(hit),
    EHandle(hit, []),
    EHandle(hit, [(PCtor("Get", []), EInt(0))]),
    EHandle(EInt(0), [(PWild, hit), (PCtor("Ask::Get", []), EInt(0))])
  ]
  let stmts: Array[Stmt] = []
  for expr in containers {
    Array::push(stmts, value = SExpr(expr))
  }
  let index = edp_handle_statement_index(stmts)
  for effect in ["Ask", "Other", "Missing"] {
    inspect(edp_handle_statement_indices(index = index, effect = effect) == oracle_statement_indices(stmts = stmts, effect = effect), content = "true")
  }
}

test "removed nested handler arms leave safe candidate supersets" {
  let stmts = [
    SExpr(EHandle(EInt(7), [(PCtor("Ask::Get", []), indexed_handle("Other"))]))
  ]
  let index = edp_handle_statement_index(stmts)
  let names: MutSet[String] = MutSet::new_string()
  edp_erase_effect_handles_with_index(stmts = stmts, ename = "Ask", analyze = false, perf_fns = [
  ], inert = names, fn_names = names, statement_indices = Some(edp_handle_statement_indices(index = index, effect = "Ask")))
  inspect(edp_handle_statement_indices(index = index, effect = "Other"), content = "[0]")
  inspect(edp_handle_statement_indices(index = edp_handle_statement_index(stmts), effect = "Other"), content = "[]")
  edp_erase_effect_handles_with_index(stmts = stmts, ename = "Other", analyze = false, perf_fns = [
  ], inert = names, fn_names = names, statement_indices = Some(edp_handle_statement_indices(index = index, effect = "Other")))
  inspect(match Array::get(stmts, at = 0) {
    SExpr(EInt(7)) => true,
    _ => false
  }, content = "true")
}

test "every qualified arm contributes a candidate effect including exception labels" {
  let stmts = [
    SExpr(EHandle(EInt(0), [
      (PCtor("Error::Throw", []), EInt(0)),
      (PCtor("Ask::Get", []), EInt(0))
    ])),
    SExpr(EHandle(EInt(0), [
      (POr(PCtor("Ask::Get", []), PCtor("Other::Get", [])), EInt(0))
    ])),
    SExpr(EHandle(EInt(0), [(PCtor("::Get", []), EInt(0))]))
  ]
  let index = edp_handle_statement_index(stmts)
  inspect(edp_handle_statement_indices(index = index, effect = "Error"), content = "[0]")
  inspect(edp_handle_statement_indices(index = index, effect = "Ask"), content = "[0]")
  inspect(edp_handle_statement_indices(index = index, effect = "Other"), content = "[]")
}

test "a grouped handler indexes each effect once and the query sees later arms" {
  let expr = EHandle(EInt(7), [
    (PCtor("Ask::Get", []), EInt(1)),
    (PCtor("Other::Get", []), EInt(2)),
    (PCtor("Ask::Next", []), EInt(3))
  ])
  let index = edp_handle_statement_index([SExpr(expr)])
  inspect(edp_handle_statement_indices(index = index, effect = "Ask"), content = "[0]")
  inspect(edp_handle_statement_indices(index = index, effect = "Other"), content = "[0]")
  inspect(edp_rq_fold(q = RQHandlesEffect("Ask"), e = expr), content = "1")
  inspect(edp_rq_fold(q = RQHandlesEffect("Other"), e = expr), content = "1")
  inspect(edp_rq_fold(q = RQHandlesEffect("Missing"), e = expr), content = "0")
}

test "vacuous discharge removes only its own arms from a grouped handler" {
  let stmts = [
    SExpr(EHandle(EInt(7), [
      (PCtor("Ask::Get", []), EInt(1)),
      (PCtor("Other::Get", []), EInt(2)),
      (PCtor("Ask::Next", []), EInt(3))
    ]))
  ]
  let index = edp_handle_statement_index(stmts)
  let names: MutSet[String] = MutSet::new_string()
  edp_erase_effect_handles_with_index(stmts = stmts, ename = "Ask", analyze = false, perf_fns = [
  ], inert = names, fn_names = names, statement_indices = Some(edp_handle_statement_indices(index = index, effect = "Ask")))
  inspect(match Array::get(stmts, at = 0) {
    SExpr(EHandle(EInt(7), arms)) => Array::length(arms) == 1 && match Array::get(arms, at = 0) {
      (PCtor("Other::Get", binds), EInt(2)) => Array::length(binds) == 0,
      _ => false
    },
    _ => false
  }, content = "true")
  edp_erase_effect_handles_with_index(stmts = stmts, ename = "Other", analyze = false, perf_fns = [
  ], inert = names, fn_names = names, statement_indices = Some(edp_handle_statement_indices(index = index, effect = "Other")))
  inspect(match Array::get(stmts, at = 0) {
    SExpr(EInt(7)) => true,
    _ => false
  }, content = "true")
}
