//# What a statement asks of the rest of the program (#4041)
//
// In the suspend CPS and evidence passes, a statement's output is to be a
// function of that statement and the answers to the questions it asks of the
// rest of the program. Each such question goes through a function here, so
// that #4042 can record a statement's questions with their answers and keep
// its output across builds while those answers stand. The review lint
// (`scripts/review_lint.vibex`, `allow-program-walk`) reports a new walk of
// the program anywhere else in these packages.

import @vibe/compiler/core {
  Stmt
}

/// Whether `stmt` declares `name` as a type alias, a struct, or a `let` /
/// `let mut`. Every other statement declares no name.
fn edp_program_declares(stmt: Stmt, name: String) -> Bool {
  match stmt {
    STypeAlias(_, declared, _, _) => declared == name,
    SStruct(_, declared, _, _, _, _) => declared == name,
    SLet(_, _, declared, _, _) => declared == name,
    SLetMut(declared, _, _) => declared == name,
    _ => false
  }
}

// review-lint: allow-program-walk (answers a summary question: the declarations of one name)
/// The statements of `stmts` that declare `name` as a type alias, a struct,
/// or a top-level `let` / `let mut`, in program order. A reader that looks a
/// declaration up by name walks these instead of the program: the statements
/// it leaves out are the ones whose name the reader's own test rejects.
export fn edp_program_decls_named(stmts: Array[Stmt], name: String) -> Array[Stmt] {
  let out: Array[Stmt] = []
  for stmt in stmts {
    if edp_program_declares(stmt = stmt, name = name) {
      Array::push(out, value = stmt)
    }
  }
  out
}
