import @vibe/compiler/core {
  Expr,
  Pat,
  Stmt,
  Type,
  TypeExpr,
  expr_child_at,
  expr_children,
  expr_children_pop,
  expr_children_push,
  expr_children_top,
  is_exception_effect_name,
  is_exception_throw_handler_name,
  lookup_registry_builtin
}

import @vibe/core {
  array_empty, struct MutMap, struct MutSet
}

import @vibe/compiler/lowering/effects/direct {
  idp_is_host_future_named_raw, idp_is_host_stream_named_raw, idp_is_pure_builtin_call
}

/// --- ADR-0076 追記34 V2: replay-frontier removal support. ---------------
///
/// The effect name a `perform` targets, or "" when `expr` is not a perform.
/// EVERY perform counts here, including ones whose op is host-mapped
/// (`perform Fs::ReadFile` etc.): a user handle over a host-effect label is
/// the in-tree MOCKING pattern (lib/@vibe/fs's fs_effect_test /
/// index_import_test), and keeping those handles makes edp migrate them
/// like any user effect -- the arm now receives the operation's ARGUMENTS
/// and its resume value wins outright (under replay the real builtin ran
/// first, side effects included, and the arm was thrown its RESULT). Only
/// a perform with NO handle anywhere compiles to the direct builtin call
/// (see compile_call.vibe's op_is_builtin branch).
export fn edp_user_perform_effect_of(_ expr: Expr) -> String {
  match expr {
    ECall(callee, args, _, _) => match callee {
      EIdent(nm, _) => if nm == "perform" && Array::length(args) == 1 {
        let q = match Array::get(args, at = 0) {
          ECall(inner, _, _, _) => match inner {
            EIdent(qn, _) => qn,
            _ => ""
          },
          EIdent(qn, _) => qn,
          _ => ""
        }
        if String::length(q) > 0 {
          edp_effect_name_of(q)
        } else {
          ""
        }
      } else {
        ""
      },
      _ => ""
    },
    _ => ""
  }
}

export enum EdpReadQuery {
  RQPerformsUserEffect(String);
  // #2386: MEMBERSHIP sets, not arrays. This query runs per CALL NODE of
  // every body the performing-fns fixpoint walks, and `fn_names` is every
  // top-level function in the program -- 2700 of them on the compiler's own
  // CLI closure. As arrays, `edp_callee_is_resolvable`'s two lookups were a
  // linear scan each, and a callee that is NOT a user function (a builtin, a
  // local, an indirect target) pays the whole array before answering.
  RQOpaqueCall(MutSet[String], MutSet[String]);
  // Membership in a supplied set of named callees. Reachability uses the
  // fused summary below; this query also supplies the independent test oracle.
  RQCallsAny(MutSet[String]);
  // Return 1 for a direct perform or opaque call; otherwise collect known
  // callees into the scratch output. The AST itself remains read-only.
  RQPerformSummary(String, MutSet[String], MutSet[String], Array[String]);
  // The effect-independent half of RQPerformSummary, for every effect at
  // once: never stops, records each node's performed effect (deduplicated),
  // sets the flag on an opaque call, and collects known callees exactly as
  // RQPerformSummary does on a tree it does not hit. See edp_perform_facts.
  RQPerformFacts(MutSet[String], MutSet[String], Array[String], Array[String], Array[Bool]);
  RQEdpBindsName(String);
  RQIdentUses(String);
  RQSafeClosureBindings(String, String, Array[String], Array[String], Array[String], Array[Array[String]]);
  RQDirectCalls(String);
  RQMentionsStep(String, String, String);
  RQContainsSusp((String, Array[String], Array[String], Int, Array[String]));
  RQLoopControl;
  RQBodyReturn;
  RQScpsBindsName(String);
  RQRefsName(String);
  RQLiteralNeeds((String, Array[String], Array[String], Int, Array[String]));
  RQTrigger;
  RQHandlesEffect(String);
  RQNeedingValueArg(Array[String]);
  // #1916: does the tree contain any EForIn? Gates forin_discard_pass's
  // per-statement rebuild without allocating (expr_children-based recursion
  // allocates a children array per node, which defeats the pass's purpose).
  RQContainsForIn
}

fn edp_rq_is_count(_ q: EdpReadQuery) -> Bool {
  match q {
    RQIdentUses(_) => true,
    RQSafeClosureBindings(_, _, _, _, _, _) => true,
    RQDirectCalls(_) => true,
    _ => false
  }
}

fn edp_rq_stops_array_on_hit(_ q: EdpReadQuery) -> Bool {
  match q {
    RQPerformsUserEffect(_) => true,
    RQOpaqueCall(_, _) => true,
    RQCallsAny(_) => true,
    RQPerformSummary(_, _, _, _) => true,
    RQEdpBindsName(_) => true,
    RQHandlesEffect(_) => true,
    RQNeedingValueArg(_) => true,
    _ => false
  }
}

fn edp_rq_merge(q: EdpReadQuery, a: Int, b: Int) -> Int {
  if edp_rq_is_count(q) {
    a + b
  } else if a > 0 || b > 0 {
    1
  } else {
    0
  }
}

fn edp_rq_two(q: EdpReadQuery, a: Expr, b: Expr) -> Int {
  let av = edp_rq_fold(q = q, e = a)
  if !edp_rq_is_count(q) && av > 0 {
    1
  } else {
    edp_rq_merge(q = q, a = av, b = edp_rq_fold(q = q, e = b))
  }
}

fn edp_rq_three(q: EdpReadQuery, a: Expr, b: Expr, c: Expr) -> Int {
  let ab = edp_rq_two(q = q, a = a, b = b)
  if !edp_rq_is_count(q) && ab > 0 {
    1
  } else {
    edp_rq_merge(q = q, a = ab, b = edp_rq_fold(q = q, e = c))
  }
}

export fn edp_rq_exprs(q: EdpReadQuery, es: Array[Expr]) -> Int {
  let mut total = 0
  let mut i = 0
  while i < Array::length(es) && !(edp_rq_stops_array_on_hit(q) && total > 0) {
    total = edp_rq_merge(q = q, a = total, b = edp_rq_fold(q = q, e = Array::get(es, at = i)))
    i = i + 1
  }
  total
}

fn edp_rq_plain_binder(q: EdpReadQuery, name: String) -> Int {
  match q {
    RQEdpBindsName(x) => if name == x {
      1
    } else {
      0
    },
    RQScpsBindsName(x) => if name == x {
      1
    } else {
      0
    },
    _ => 0
  }
}

fn edp_rq_params(q: EdpReadQuery, params: Array[(String, Option[TypeExpr])]) -> Int {
  let mut hit = 0
  let mut i = 0
  while i < Array::length(params) && !(edp_rq_stops_array_on_hit(q) && hit > 0) {
    let (name, _) = Array::get(params, at = i)
    let local = match q {
      RQEdpBindsName(x) => if edp_strip_tilde(name) == x {
        1
      } else {
        0
      },
      RQScpsBindsName(x) => if name == x {
        1
      } else {
        0
      },
      _ => 0
    }
    hit = edp_rq_merge(q = q, a = hit, b = local)
    i = i + 1
  }
  hit
}

fn edp_rq_pat(q: EdpReadQuery, p: Pat) -> Int {
  match q {
    RQEdpBindsName(x) => if scps_pat_binds_name(p = p, x = x) {
      1
    } else {
      0
    },
    RQScpsBindsName(x) => if scps_pat_binds_name(p = p, x = x) {
      1
    } else {
      0
    },
    _ => 0
  }
}

fn edp_rq_pairs(q: EdpReadQuery, pairs: Array[(String, Expr)], names_bind: Bool) -> Int {
  let mut total = 0
  let mut i = 0
  while i < Array::length(pairs) && !(edp_rq_stops_array_on_hit(q) && total > 0) {
    let (name, value) = Array::get(pairs, at = i)
    let local = if names_bind {
      edp_rq_plain_binder(q = q, name = name)
    } else {
      0
    }
    let item = if !edp_rq_is_count(q) && local > 0 {
      1
    } else {
      edp_rq_merge(q = q, a = local, b = edp_rq_fold(q = q, e = value))
    }
    total = edp_rq_merge(q = q, a = total, b = item)
    i = i + 1
  }
  total
}

export fn edp_rq_arms(q: EdpReadQuery, arms: Array[(Pat, Expr)], is_handle: Bool) -> Int {
  let mut total = 0
  let mut i = 0
  while i < Array::length(arms) && !(edp_rq_stops_array_on_hit(q) && total > 0) {
    let (pat, body) = Array::get(arms, at = i)
    let local = match q {
      // #3064: an arm that leaves the function with `return` may need the
      // suspend driver too (scps_arm_return_needs_driver decides precisely);
      // this pre-scan only has to be conservative.
      // #3540: so may an arm that can throw (scps_arm_throw_needs_driver).
      RQTrigger => if is_handle && (scps_arm_refs_resume_value(e = body, sh = scps_pat_binds_resume(pat)) || edp_rq_fold(q = RQBodyReturn, e = body) > 0 || (!is_exception_throw_handler_name(edp_pat_qname(pat)) && scps_arm_may_throw_syntactic(body))) {
        1
      } else {
        0
      },
      _ => edp_rq_pat(q = q, p = pat)
    }
    let item = if !edp_rq_is_count(q) && local > 0 {
      1
    } else {
      edp_rq_merge(q = q, a = local, b = edp_rq_fold(q = q, e = body))
    }
    total = edp_rq_merge(q = q, a = total, b = item)
    i = i + 1
  }
  total
}

fn edp_rq_after_exprs(q: EdpReadQuery, first: Expr, rest: Array[Expr]) -> Int {
  let a = edp_rq_fold(q = q, e = first)
  if a > 0 && !edp_rq_is_count(q) && match q {
    RQTrigger => false,
    _ => true
  } {
    1
  } else {
    edp_rq_merge(q = q, a = a, b = edp_rq_exprs(q = q, es = rest))
  }
}

fn edp_rq_after_arms(q: EdpReadQuery, first: Expr, arms: Array[(Pat, Expr)], is_handle: Bool) -> Int {
  let a = edp_rq_fold(q = q, e = first)
  if a > 0 && !edp_rq_is_count(q) && match q {
    RQMentionsStep(_, _, _) => false,
    RQLiteralNeeds(_) => false,
    RQTrigger => false,
    _ => true
  } {
    1
  } else {
    edp_rq_merge(q = q, a = a, b = edp_rq_arms(q = q, arms = arms, is_handle = is_handle))
  }
}

fn edp_rq_loop(q: EdpReadQuery, pairs: Array[(String, Expr)], body: Expr, names_bind: Bool, body_first: Bool, always_scan: Bool) -> Int {
  let a = if body_first {
    edp_rq_fold(q = q, e = body)
  } else {
    edp_rq_pairs(q = q, pairs = pairs, names_bind = names_bind)
  }
  if a > 0 && !always_scan && !edp_rq_is_count(q) {
    1
  } else {
    let b = if body_first {
      edp_rq_pairs(q = q, pairs = pairs, names_bind = names_bind)
    } else {
      edp_rq_fold(q = q, e = body)
    }
    edp_rq_merge(q = q, a = a, b = b)
  }
}

fn edp_rq_local(q: EdpReadQuery, e: Expr) -> Int {
  match q {
    RQPerformsUserEffect(effect) => if edp_user_perform_effect_of(e) == effect {
      1
    } else {
      0
    },
    RQOpaqueCall(inert, fn_names) => match e {
      ECall(EIdent(name, _), _, _, _) => if edp_callee_is_resolvable(nm = name, inert = inert, fn_names = fn_names) {
        0
      } else {
        1
      },
      ECall(_, _, _, _) => 1,
      _ => 0
    },
    RQCallsAny(names) => match e {
      ECall(EIdent(name, _), _, _, _) => if MutSet::has(names, x = name) {
        1
      } else {
        0
      },
      _ => 0
    },
    RQPerformSummary(effect, inert, fn_names, calls) => if edp_user_perform_effect_of(e) == effect {
      1
    } else {
      match e {
        ECall(EIdent(name, _), _, _, _) => if !edp_callee_is_resolvable(nm = name, inert = inert, fn_names = fn_names) {
          1
        } else {
          if MutSet::has(fn_names, x = name) {
            Array::push(calls, value = name)
          }
          0
        },
        ECall(_, _, _, _) => 1,
        _ => 0
      }
    },
    RQPerformFacts(inert, fn_names, calls, effects, opaque) => {
      let performed = edp_user_perform_effect_of(e)
      if String::length(performed) > 0 && !edp_str_array_contains(arr = effects, v = performed) {
        Array::push(effects, value = performed)
      }
      match e {
        ECall(EIdent(name, _), _, _, _) => if !edp_callee_is_resolvable(nm = name, inert = inert, fn_names = fn_names) {
          Array::set(opaque, at = 0, value = true)
        } else if MutSet::has(fn_names, x = name) {
          Array::push(calls, value = name)
        } else {
          ()
        },
        ECall(_, _, _, _) => Array::set(opaque, at = 0, value = true),
        _ => ()
      }
      0
    },
    RQEdpBindsName(_)|RQScpsBindsName(_) => match e {
      ELet(name, _, _, _) => edp_rq_plain_binder(q = q, name = name),
      ELetMut(name, _, _, _) => edp_rq_plain_binder(q = q, name = name),
      ELetRec(name, _, _) => edp_rq_plain_binder(q = q, name = name),
      EForIn(name, index, _, _) => edp_rq_merge(q = q, a = edp_rq_plain_binder(q = q, name = name), b = match index {
        Some(i) => edp_rq_plain_binder(q = q, name = i),
        None => 0
      }),
      EFn(_, _, params, _, _, _) => edp_rq_params(q = q, params = params),
      _ => 0
    },
    RQIdentUses(name) => match e {
      EIdent(n, _) => if n == name {
        1
      } else {
        0
      },
      _ => 0
    },
    RQSafeClosureBindings(xname, ename, needing, pure_fns, es_names, es_members_list) => match e {
      ELet(name, value, _, _) => if name == xname && edp_efn_eligible_for_migration(expr = value, ename = ename, needing = needing, pure_fns = pure_fns, es_names = es_names, es_members_list = es_members_list) {
        1
      } else {
        0
      },
      ELetRec(name, value, _) => if name == xname && edp_efn_eligible_for_migration(expr = value, ename = ename, needing = needing, pure_fns = pure_fns, es_names = es_names, es_members_list = es_members_list) {
        1
      } else {
        0
      },
      _ => 0
    },
    RQDirectCalls(name) => match e {
      ECall(EIdent(n, _), _, _, _) => if n == name {
        1
      } else {
        0
      },
      _ => 0
    },
    RQMentionsStep(done, prefix, bubble) => match e {
      EIdent(name, _) => if name == done || name == bubble || String::starts_with(name, prefix = prefix) {
        1
      } else {
        0
      },
      _ => 0
    },
    RQContainsSusp(sctx) => {
      let (_, ops, _, _, _) = sctx
      if scps_as_target_perform(e = e, ops = ops) >= 0 || scps_as_needing_call(e = e, sctx = sctx) != "" || scps_as_cps_local_call(e = e, sctx = sctx) != "" {
        1
      } else {
        0
      }
    },
    RQLoopControl => match e {
      EBreak(_) => 1,
      EContinue(_) => 1,
      EReturn(_) => 1,
      _ => 0
    },
    RQBodyReturn => match e {
      EReturn(_) => 1,
      _ => 0
    },
    RQRefsName(name) => match e {
      EIdent(n, _) => if n == name {
        1
      } else {
        0
      },
      EAssign(n, _, _, _) => if n == name {
        1
      } else {
        0
      },
      EAssignOp(n, _, _, _, _) => if n == name {
        1
      } else {
        0
      },
      _ => 0
    },
    RQLiteralNeeds(sctx) => {
      let (_, ops, _, _, _) = sctx
      if scps_as_target_perform(e = e, ops = ops) >= 0 || scps_as_needing_call(e = e, sctx = sctx) != "" {
        1
      } else {
        0
      }
    },
    RQTrigger => 0,
    RQHandlesEffect(ename) => match e {
      EHandle(_, arms) => if edp_handle_matches_effect(arms = arms, ename = ename) {
        1
      } else {
        0
      },
      _ => 0
    },
    RQContainsForIn => match e {
      EForIn(_, _, _, _) => 1,
      _ => 0
    },
    RQNeedingValueArg(names) => match e {
      // The eta-wrap walk also peels annotated aliases. An unannotated local
      // alias can precede that ascription, so keep the whole statement in the
      // walk when its source name is a needing function.
      ELet(_, EIdent(source, _), _, _) => if edp_str_array_contains(arr = names, v = source) {
        1
      } else {
        0
      },
      ELetRec(_, EIdent(source, _), _) => if edp_str_array_contains(arr = names, v = source) {
        1
      } else {
        0
      },
      ECall(_, args, _, _) => {
        let mut ai = 0
        let mut hit = 0
        while ai < Array::length(args) && hit == 0 {
          match Array::get(args, at = ai) {
            EIdent(an, _) => if edp_str_array_contains(arr = names, v = an) {
              hit = 1
            } else {
              ()
            },
            _ => ()
          }
          ai = ai + 1
        }
        hit
      },
      _ => 0
    }
  }
}

fn edp_rq_handle_discharges(q: EdpReadQuery, arms: Array[(Pat, Expr)]) -> Bool {
  match q {
    RQLiteralNeeds(sctx) => {
      let (_, ops, _, _, _) = sctx
      scps_arms_discharge_ops(arms = arms, ops = ops)
    },
    _ => false
  }
}

export fn edp_rq_fold(q: EdpReadQuery, e: Expr) -> Int {
  let local = edp_rq_local(q = q, e = e)
  if !edp_rq_is_count(q) && local > 0 {
    1
  } else {
    let children = match e {
      EInt(_) => 0,
      EFloat(_) => 0,
      EString(_, _) => 0,
      EBool(_) => 0,
      EIdent(_, _) => 0,
      ETuple(items) => edp_rq_exprs(q = q, es = items),
      EArray(items) => edp_rq_exprs(q = q, es = items),
      ERecord(_, fields, _) => edp_rq_pairs(q = q, pairs = fields, names_bind = false),
      EIf(c, t, other) => edp_rq_three(q = q, a = c, b = t, c = other),
      ELet(_, value, body, _) => edp_rq_two(q = q, a = value, b = body),
      ELetRec(_, value, body) => edp_rq_two(q = q, a = value, b = body),
      ELetMut(_, value, body, _) => edp_rq_two(q = q, a = value, b = body),
      EAssign(_, value, body, _) => edp_rq_two(q = q, a = value, b = body),
      EAssignOp(_, _, value, body, _) => edp_rq_two(q = q, a = value, b = body),
      ESeq(a, b) => edp_rq_two(q = q, a = a, b = b),
      EMatch(subject, arms) => edp_rq_after_arms(q = q, first = subject, arms = arms, is_handle = false),
      EHandle(body, arms) => if edp_rq_handle_discharges(q = q, arms = arms) {
        edp_rq_arms(q = q, arms = arms, is_handle = true)
      } else {
        edp_rq_after_arms(q = q, first = body, arms = arms, is_handle = true)
      },
      EWhile(cond, body) => edp_rq_two(q = q, a = cond, b = body),
      ELoop(pairs, body) => match q {
        RQBodyReturn => edp_rq_fold(q = q, e = body),
        RQPerformsUserEffect(_) => edp_rq_loop(q = q, pairs = pairs, body = body, names_bind = false, body_first = true, always_scan = false),
        RQMentionsStep(_, _, _) => edp_rq_loop(q = q, pairs = pairs, body = body, names_bind = false, body_first = true, always_scan = true),
        RQScpsBindsName(_) => edp_rq_loop(q = q, pairs = pairs, body = body, names_bind = true, body_first = true, always_scan = true),
        RQRefsName(_) => edp_rq_loop(q = q, pairs = pairs, body = body, names_bind = false, body_first = true, always_scan = true),
        RQLiteralNeeds(_) => edp_rq_loop(q = q, pairs = pairs, body = body, names_bind = false, body_first = true, always_scan = true),
        RQTrigger => edp_rq_loop(q = q, pairs = pairs, body = body, names_bind = false, body_first = true, always_scan = true),
        RQEdpBindsName(_) => edp_rq_loop(q = q, pairs = pairs, body = body, names_bind = true, body_first = false, always_scan = false),
        _ => edp_rq_loop(q = q, pairs = pairs, body = body, names_bind = false, body_first = false, always_scan = false)
      },
      EForIn(_, _, iter, body) => edp_rq_two(q = q, a = iter, b = body),
      ECall(callee, args, _, _) => match q {
        RQOpaqueCall(_, _) => edp_rq_exprs(q = q, es = args),
        RQDirectCalls(_) => match callee {
          EIdent(_, _) => edp_rq_exprs(q = q, es = args),
          _ => edp_rq_after_exprs(q = q, first = callee, rest = args)
        },
        _ => edp_rq_after_exprs(q = q, first = callee, rest = args)
      },
      EBinOp(_, left, right, _) => edp_rq_two(q = q, a = left, b = right),
      EUnaryOp(_, value) => edp_rq_fold(q = q, e = value),
      EFn(_, _, _, _, _, body) => match q {
        RQLoopControl => 0,
        RQBodyReturn => 0,
        _ => edp_rq_fold(q = q, e = body)
      },
      EDot(owner, _, _, _) => edp_rq_fold(q = q, e = owner),
      ELabeledArg(_, _, value) => edp_rq_fold(q = q, e = value),
      EReturn(value) => edp_rq_fold(q = q, e = value),
      EBreak(value) => match value {
        Some(v) => edp_rq_fold(q = q, e = v),
        None => 0
      },
      EContinue(args) => edp_rq_exprs(q = q, es = args),
      EMap(fields) => edp_rq_pairs(q = q, pairs = fields, names_bind = false),
      ESpread(value) => edp_rq_fold(q = q, e = value),
      EStringInterp(_) => 0,
      EUnit => 0
    }
    edp_rq_merge(q = q, a = local, b = children)
  }
}

/// Is this callee one whose target this analysis can name? Anything else
/// (an opaque closure parameter, a local binding, an indirect callee) can
/// reach arbitrary code, performs included.
export fn edp_callee_is_resolvable(nm: String, inert: MutSet[String], fn_names: MutSet[String]) -> Bool {
  nm == "perform" || nm == "resume" || edp_is_pure_builtin_call(nm) || edp_name_is_host_raw_shape(nm) || MutSet::has(inert, x = nm) || MutSet::has(fn_names, x = nm)
}

/// Function-level conservative effect reachability. Each body is visited once
/// for this effect, then only incoming call edges are visited. Duplicate names
/// union their definitions; an opaque call seeds any queried effect. The caller
/// must rebuild this summary after rewriting the input AST.
///
/// Result order is deterministic queue order and is used only for membership.
/// It does not define the order of generated functions or handler arms.
export fn edp_performing_names(names: Array[String], bodies: Array[Option[Expr]], effect: String, inert: MutSet[String], fn_names: MutSet[String]) -> Array[String] {
  let callers: MutMap[String, Array[String]] = MutMap::new_string()
  let member: MutSet[String] = MutSet::new_string()
  let out: Array[String] = []
  // Neither the query nor its scratch call list escapes this analysis. The
  // graph copies names into its own rows before the next body resets scratch.
  let calls: Array[String] = []
  let query = RQPerformSummary(effect, inert, fn_names, calls)
  let mut i = 0
  while i < Array::length(names) {
    let name = Array::get(names, at = i)
    if !MutSet::has(member, x = name) {
      match Array::get(bodies, at = i) {
        Some(body) => {
          Array::truncate(calls, length = 0)
          if edp_rq_fold(q = query, e = body) > 0 {
            MutSet::add(member, x = name)
            Array::push(out, value = name)
          } else {
            for callee in calls {
              match MutMap::get(callers, k = callee) {
                Some(entries) => Array::push(entries, value = name),
                None => MutMap::set(callers, k = callee, v = [name])
              }
            }
          }
        },
        None => ()
      }
    }
    i = i + 1
  }
  let mut head = 0
  while head < Array::length(out) {
    match MutMap::get(callers, k = Array::get(out, at = head)) {
      Some(entries) => for name in entries {
        if !MutSet::has(member, x = name) {
          MutSet::add(member, x = name)
          Array::push(out, value = name)
        }
      },
      None => ()
    }
    head = head + 1
  }
  out
}

/// Effect-independent reachability facts of one tree: whether it makes an
/// opaque call, the effects it performs directly, and the known callees in
/// visit order. RQPerformSummary(effect) hits a tree exactly when it is opaque
/// or performs `effect` (`perform` itself is resolvable, so a perform node is
/// never the opaque call), and on a tree it does not hit it visits every node
/// this walk visits, in the same order, so the callees match. One walk of the
/// facts answers what one RQPerformSummary walk per effect answered.
export fn edp_perform_facts(e: Expr, inert: MutSet[String], fn_names: MutSet[String]) -> (Bool, Array[String], Array[String]) {
  let calls: Array[String] = []
  let effects: Array[String] = []
  let opaque = [false]
  edp_rq_fold(q = RQPerformFacts(inert, fn_names, calls, effects, opaque), e = e)
  (Array::get(opaque, at = 0), effects, calls)
}

/// Would RQPerformSummary(effect) or RQPerformsUserEffect(effect) hit the
/// tree these facts describe? The empty effect name matches every
/// non-perform node, and every tree holds one, so both hit any tree for it.
export fn edp_perform_facts_hit(facts: (Bool, Array[String], Array[String]), effect: String) -> Bool {
  let (opaque, effects, _) = facts
  String::length(effect) == 0 || opaque || edp_str_array_contains(arr = effects, v = effect)
}

/// Does the tree perform `effect` directly (RQPerformsUserEffect)?
export fn edp_perform_facts_performs(facts: (Bool, Array[String], Array[String]), effect: String) -> Bool {
  let (_, effects, _) = facts
  String::length(effect) == 0 || edp_str_array_contains(arr = effects, v = effect)
}

/// edp_performing_names over precomputed edp_perform_facts of the bodies,
/// with the same `inert` / `fn_names`. Same visit order, same graph, same
/// queue, so the same result in the same order.
export fn edp_performing_names_from_facts(names: Array[String], facts: Array[Option[(Bool, Array[String], Array[String])]], effect: String) -> Array[String] {
  edp_performing_names_over(names = names, facts = facts, callers = edp_performing_callers(names = names, facts = facts), effect = effect)
}

/// The reverse call graph edp_performing_names_over walks: for each callee,
/// every name whose body calls it, in `names` order. It does not depend on
/// the effect, so one graph serves every effect asked about.
///
/// A graph built for one effect alone would leave out the edges of the names
/// whose bodies hit that effect. Keeping them changes nothing: such a name is
/// in the result before the walk starts, and the walk only adds a name that
/// is not, so it skips that entry wherever it stands.
export fn edp_performing_callers(names: Array[String], facts: Array[Option[(Bool, Array[String], Array[String])]]) -> MutMap[String, Array[String]] {
  let callers: MutMap[String, Array[String]] = MutMap::new_string()
  let mut i = 0
  while i < Array::length(names) {
    match Array::get(facts, at = i) {
      Some(fact) => {
        let (_, _, calls) = fact
        let name = Array::get(names, at = i)
        for callee in calls {
          match MutMap::get(callers, k = callee) {
            Some(entries) => Array::push(entries, value = name),
            None => MutMap::set(callers, k = callee, v = [name])
          }
        }
      },
      None => ()
    }
    i = i + 1
  }
  callers
}

/// edp_performing_names_from_facts over `callers`, the
/// edp_performing_callers of the same `names` / `facts`.
export fn edp_performing_names_over(names: Array[String], facts: Array[Option[(Bool, Array[String], Array[String])]], callers: MutMap[String, Array[String]], effect: String) -> Array[String] {
  let member: MutSet[String] = MutSet::new_string()
  let out: Array[String] = []
  let mut i = 0
  while i < Array::length(names) {
    let name = Array::get(names, at = i)
    if !MutSet::has(member, x = name) {
      match Array::get(facts, at = i) {
        Some(fact) => if edp_perform_facts_hit(facts = fact, effect = effect) {
          MutSet::add(member, x = name)
          Array::push(out, value = name)
        } else (),
        None => ()
      }
    }
    i = i + 1
  }
  let mut head = 0
  while head < Array::length(out) {
    match MutMap::get(callers, k = Array::get(out, at = head)) {
      Some(entries) => for name in entries {
        if !MutSet::has(member, x = name) {
          MutSet::add(member, x = name)
          Array::push(out, value = name)
        }
      },
      None => ()
    }
    head = head + 1
  }
  out
}

/// The names edp_performing_names_over answers for every non-empty effect
/// alike: those whose body makes a call this analysis cannot see through,
/// and every name that reaches one through `callers`.
export fn edp_performing_opaque_names(names: Array[String], facts: Array[Option[(Bool, Array[String], Array[String])]], callers: MutMap[String, Array[String]]) -> Array[String] {
  let member: MutSet[String] = MutSet::new_string()
  let out: Array[String] = []
  let mut i = 0
  while i < Array::length(names) {
    match Array::get(facts, at = i) {
      Some(fact) => {
        let (opaque, _, _) = fact
        let name = Array::get(names, at = i)
        if opaque && !MutSet::has(member, x = name) {
          MutSet::add(member, x = name)
          Array::push(out, value = name)
        } else ()
      },
      None => ()
    }
    i = i + 1
  }
  edp_performing_close(out = out, member = member, callers = callers, from = 0, skip = member)
  out
}

/// The members of edp_performing_names_over's answer for `effect`, in
/// another order, given the edp_performing_opaque_names of the same graph
/// (`opaque`, and its members as `opaque_set`). Only the names that perform
/// `effect` directly, and what reaches them, are walked; the rest of the
/// answer is `opaque`, which does not depend on the effect. The two walks
/// meet the same set because a name is in the answer exactly when it
/// reaches a seed of either.
export fn edp_performing_names_beyond(names: Array[String], facts: Array[Option[(Bool, Array[String], Array[String])]], callers: MutMap[String, Array[String]], opaque: Array[String], opaque_set: MutSet[String], effect: String) -> Array[String] {
  if String::length(effect) == 0 {
    // Every tree hits the empty effect, so every name with a body is a seed.
    edp_performing_names_over(names = names, facts = facts, callers = callers, effect = effect)
  } else {
    let out: Array[String] = []
    for name in opaque {
      Array::push(out, value = name)
    }
    let from = Array::length(out)
    let member: MutSet[String] = MutSet::new_string()
    let mut i = 0
    while i < Array::length(names) {
      match Array::get(facts, at = i) {
        Some(fact) => if edp_perform_facts_performs(facts = fact, effect = effect) {
          let name = Array::get(names, at = i)
          if !MutSet::has(opaque_set, x = name) && !MutSet::has(member, x = name) {
            MutSet::add(member, x = name)
            Array::push(out, value = name)
          } else ()
        } else (),
        None => ()
      }
      i = i + 1
    }
    edp_performing_close(out = out, member = member, callers = callers, from = from, skip = opaque_set)
    out
  }
}

/// Append to `out` every name that reaches `out[from..]` through `callers`,
/// each once: not already in `member`, nor in `skip`. New names join
/// `member`.
fn edp_performing_close(out: Array[String], member: MutSet[String], callers: MutMap[String, Array[String]], from: Int, skip: MutSet[String]) -> Unit {
  let mut head = from
  while head < Array::length(out) {
    match MutMap::get(callers, k = Array::get(out, at = head)) {
      Some(entries) => for name in entries {
        if !MutSet::has(member, x = name) && !MutSet::has(skip, x = name) {
          MutSet::add(member, x = name)
          Array::push(out, value = name)
        }
      },
      None => ()
    }
    head = head + 1
  }
}

/// Local copy of dlh_strip_tilde (desugar_trait_dict.vibe) -- see
/// edp_pat_binds' own doc comment just below for why this file keeps local
/// copies rather than adding new cross-file callers.
export fn edp_strip_tilde(_ n: String) -> String {
  let ln = String::length(n)
  if ln > 0 && n[ln - 1: ln] == "~" {
    n[0: ln - 1]
  } else {
    n
  }
}

/// Local copy of a pattern's bound names (mirrors dlh_pat_binds in
/// desugar_trait_dict.vibe -- kept as a separate local copy rather than a
/// cross-file import to avoid the bootstrap flatten gotcha documented
/// elsewhere in this file: a brand-new cross-file export + its first
/// cross-file caller in the SAME commit gets silently dropped by the
/// merge/flatten tool).
export fn edp_pat_binds(p: Pat, out: Array[String]) -> Unit {
  match p {
    PBind(n) => Array::push(out, value = n),
    PCtor(_, args) => {
      let mut i = 0
      while i < Array::length(args) {
        edp_pat_binds(p = Array::get(args, at = i), out = out)
        i = i + 1
      }
    },
    PTuple(ps) => {
      let mut i = 0
      while i < Array::length(ps) {
        edp_pat_binds(p = Array::get(ps, at = i), out = out)
        i = i + 1
      }
    },
    POr(a, b) => {
      edp_pat_binds(p = a, out = out)
      edp_pat_binds(p = b, out = out)
    },
    PStruct(_, fields) => {
      let mut i = 0
      while i < Array::length(fields) {
        let (_, fp) = Array::get(fields, at = i)
        edp_pat_binds(p = fp, out = out)
        i = i + 1
      }
    },
    _ => ()
  }
}

fn edp_es_expand_into(es_names: Array[String], es_members_list: Array[Array[String]], name: String, path: Array[String], out: Array[String]) -> Unit {
  if edp_str_array_contains(arr = path, v = name) {
    ()
  } else {
    let idx = edp_str_array_index_of(arr = es_names, v = name)
    if idx < 0 {
      if edp_str_array_contains(arr = out, v = name) {
        ()
      } else {
        Array::push(out, value = name)
      }
    } else {
      Array::push(path, value = name)
      let members = Array::get(es_members_list, at = idx)
      let mut mi = 0
      while mi < Array::length(members) {
        edp_es_expand_into(es_names = es_names, es_members_list = es_members_list, name = Array::get(members, at = mi), path = path, out = out)
        mi = mi + 1
      }
      Array::truncate(path, length = Array::length(path) - 1)
    }
  }
}

/// Strip a qualified operation label (`Ask::Get`) down to its effect prefix
/// (`Ask`); a bare label (already an effect name, or a row-variable label
/// this pass doesn't recognize either way) passes through unchanged.
/// #1340 (ADR-0071): a generic instantiation label (`State[Int]`) strips to
/// its base effect name too — codegen identifies an algebraic effect by
/// NAME at runtime; the instantiation is type-level only, so every row
/// consumer in this pass (migration eligibility, CPS row scans) must see
/// `State`, not `State[Int]`.
export fn edp_effect_name_of(_ label: String) -> String {
  let bidx = String::index_of(label, needle = "[")
  let base = if bidx > 0 {
    String::substring(label, start = 0, end = bidx)
  } else {
    label
  }
  let idx = String::index_of(base, needle = "::")
  if idx > 0 {
    String::substring(base, start = 0, end = idx)
  } else {
    base
  }
}

/// Resolve one raw row-item label to the underlying effect NAME(s) it
/// requires: expand it first if it's a known effectset (pushing each
/// expanded leaf's effect prefix), or just push its own effect prefix
/// directly otherwise. Appends into `out` (deduped by the caller).
export fn edp_resolve_effect_names_into(label: String, es_names: Array[String], es_members_list: Array[Array[String]], out: Array[String]) -> Unit {
  if edp_str_array_contains(arr = es_names, v = label) {
    let leaves = array_empty()
    edp_es_expand_into(es_names = es_names, es_members_list = es_members_list, name = label, path = array_empty(), out = leaves)
    let mut li = 0
    while li < Array::length(leaves) {
      let ename = edp_effect_name_of(Array::get(leaves, at = li))
      if edp_str_array_contains(arr = out, v = ename) {
        ()
      } else {
        Array::push(out, value = ename)
      }
      li = li + 1
    }
  } else {
    let ename = edp_effect_name_of(label)
    if edp_str_array_contains(arr = out, v = ename) {
      ()
    } else {
      Array::push(out, value = ename)
    }
  }
}

fn edp_str_array_index_of(arr: Array[String], v: String) -> Int {
  let mut i = 0
  let mut found = -1
  while i < Array::length(arr) {
    if Array::get(arr, at = i) == v {
      found = i
    } else {
      ()
    }
    i = i + 1
  }
  found
}

/// Row CONTAINMENT: a function whose row is several comma-joined effect
/// names (e.g. "Ask, Fs") qualifies for EACH effect's migration
/// independently, alongside a bare exact-match row. A row-variable label is
/// still excluded (containment only matches literal effect names present in
/// the row string).
///
/// This relaxation was tried and reverted TWICE on 2026-07-23 before being
/// shipped for real: both rounds crashed on
/// fixtures/effect_handle_multi_effect_row_fallback.vibe with an uncaught
/// exception, and two rounds of code-reading-only diagnosis (an EDot
/// artifact from one effect's own rewrite tripping a later effect's
/// eligibility re-scan; a needing function's body being directly another
/// effect's own `EHandle`) both turned out to be real but NOT the actual
/// cause once retested. Runtime instrumentation (temporarily exporting
/// every per-effect wasm exception tag by name, so an uncaught exception's
/// tag could be decoded from outside the module) finally isolated the true
/// cause: it had nothing to do with multi-effect rows at all.
/// edp_rewrite_needing_body's traversal was missing several positions
/// edp_has_unsafe_construct (its own eligibility check) already covered --
/// most simply, a `perform` bound via `let` rather than written as a bare
/// tail expression -- so a migrated function's own perform could pass
/// eligibility but be silently left un-rewritten, orphaning it once the
/// migration also dropped its handle site's `EHandle`. That bug (fixed
/// separately, see edp_rewrite_needing_body's doc comment) is what both
/// crashes actually were; `both_helper` in the multi-effect fixture happens
/// to bind both of its performs via `let`, so containment relaxation merely
/// exercised it via a different code path than the single-effect fixtures
/// that found and fixed it directly.
///
/// With that fixed, re-testing the SAME multi-effect fixture under
/// containment (2026-07-23, round 3) -- confirmed via a temporary
/// migration-plan probe that `Ask`'s plan really is produced and applied,
/// not merely "coincidentally not crashing" -- compiles, self-hosts
/// (stage2==stage3), and runs to the SAME stable value the pre-Phase-3
/// replay fallback already produced (3018): `both_helper` needs `{Ask,
/// Fs}`; `Ask`'s migration succeeds (its only needing function and handle
/// site are both clean); `Fs`'s is correctly rejected on its own terms
/// because `ask_only_wrapper` (needing `Fs`) has a body that is directly
/// `handle {...} with { Ask::Get(..) => ... }` -- a genuine, deliberate
/// `edp_has_unsafe_construct` rejection (nested EHandle), independent of
/// this bug and independent of containment. `Ask` migrating to evidence-
/// dict while `Fs` stays on replay is safe: the two effects use disjoint
/// per-tag memory regions and neither codegen path depends on the other's
/// presence, so a needing function may freely have SOME of its performs
/// migrated and others still raw (edp_qname_is_for_effect already ensures
/// `edp_rewrite_needing_body` only ever touches performs for the effect
/// currently being migrated).
///
/// Follow-up (2026-07-23, same day): the directly-nested-handle scope
/// boundary noted above ("only the innermost effect of a nested handle
/// pair can migrate") is now also resolved -- edp_has_unsafe_construct
/// recurses into a nested EHandle for a DIFFERENT effect instead of
/// rejecting it outright, so BOTH effects of a `handle ... with A { handle
/// ... with B {...} }` nest (or the equivalent wrapper-function split this
/// fixture's own `ask_only_wrapper` uses) can migrate independently. See
/// edp_has_unsafe_construct's doc comment for that change, and fixtures/
/// effect_handle_multi_effect_nested_handles.vibe for a minimal regression
/// lock without the wrapper-function indirection. This fixture
/// (effect_handle_multi_effect_row_fallback.vibe) was updated accordingly:
/// `Fs` now migrates too (verified via the same migration-plan-probe
/// technique, not just "doesn't crash"), and its pinned value changed from
/// 3018 (the replay-inflated value, `Fs`'s handler body replaying an extra
/// time each pass) to 2017 (the semantically-ideal value once neither
/// effect duplicates any surrounding side effect) -- itself confirming
/// this is a genuine correctness improvement, not merely broader coverage.
/// Effectset-aware: `row` is comma-split, each item resolved to its
/// underlying effect name(s) via edp_resolve_effect_names_into (a no-op
/// pass-through for an already-bare effect name -- see that function's doc
/// comment, and edp_es_collect_into's for why this needs its own effectset
/// tables rather than trusting the row string to already be expanded).
/// `ename` qualifies if it appears in ANY item's resolved set.
export fn edp_row_is_exactly(row: String, ename: String, es_names: Array[String], es_members_list: Array[Array[String]]) -> Bool {
  if row == ename {
    true
  } else {
    let parts = String::split(row, sep = ",")
    let mut i = 0
    let mut found = false
    while i < Array::length(parts) {
      let label = String::trim(Array::get(parts, at = i))
      let resolved = array_empty()
      edp_resolve_effect_names_into(label = label, es_names = es_names, es_members_list = es_members_list, out = resolved)
      if edp_str_array_contains(arr = resolved, v = ename) {
        found = true
      } else {
        ()
      }
      i = i + 1
    }
    found
  }
}

export fn edp_str_array_contains(arr: Array[String], v: String) -> Bool {
  let mut i = 0
  let mut found = false
  // `&& !found`: this used to keep scanning past the match to the end of the
  // array. Free on a miss, which is the case that dominates, but a hit paid
  // the whole array for an answer it already had.
  while i < Array::length(arr) && !found {
    if Array::get(arr, at = i) == v {
      found = true
    } else {
      ()
    }
    i = i + 1
  }
  found
}

fn empty_str_array() -> Array[String] {
  array_empty()
}

/// --- eligibility: the same conservative-bail-out shape as
/// inline_direct_perform.vibe's idp_has_unsafe_construct, plus several
/// relaxations: a call to a name in `needing` is safe (that callee's own
/// body is scanned the same way as part of this same migration attempt); a
/// nested `EHandle` for a DIFFERENT effect than the one currently being
/// checked (`ename`) is safe to look inside rather than an automatic
/// rejection; and a call to a function the checker has ALREADY proven pure
/// (`pure_fns`, see edp_pure_fn_names) is safe regardless of whether it
/// happens to be hand-listed as a builtin -- see below.
///
/// Branching constructs (EIf/EMatch/EWhile/EForIn/ELoop) ARE recursed into
/// (not unconditionally unsafe): a needing-function call nested inside one
/// used to compile to invalid wasm, but that was root-caused (docs/effect-
/// evidence-passing.md "追記 6") to a since-fixed handle-site rewrite bug
/// (edp_find_rewrite_handles replaced the old collect-then-re-find-by-
/// equality design that silently failed to re-locate branching handle
/// bodies), not anything inherent to branching itself -- see
/// fixtures/effect_handle_call_evidence_branch.vibe for the regression lock
/// on branching being genuinely safe now.
///
/// `EHandle(body, arms)` for effect `ename` itself stays unconditionally
/// unsafe (nested handling of the SAME effect inside itself is not a shape
/// this pass targets). A NESTED handle for a DIFFERENT effect, though, is
/// exactly the "wrapper function discharges one effect, caller discharges
/// another" and "directly-nested `handle A { handle B {...} }`" shapes --
/// recursing into its body (and treating a `resume(...)` call in its own
/// arms as safe, mirroring the "perform"/needing-call special cases; a
/// handler arm's plain `resume` cannot itself hide anything unsafe for a
/// DIFFERENT effect's migration) lets both shapes become eligible. See
/// edp_row_is_exactly's doc comment for the history of the wrapper-function
/// shape; this is the natural follow-up covering direct nesting too.
///
/// A call to a function whose OWN declared effect row is checker-verified
/// empty (`pure_fns`) is safe without even recursing into ITS body: by the
/// checker's own soundness (#942, the same guarantee edp_collect_fn_defs's
/// doc comment cites for the row string itself) a function with no `with`
/// clause cannot perform ANY effect, ever, so it cannot possibly hide a
/// perform of `ename`, a call to a needing function, or anything else this
/// pass would need to rewrite -- generalizing the old hand-audited
/// `idp_pure_builtin_names` allowlist (kept as-is for the handful of
/// builtins the checker doesn't track as ordinary functions) to every
/// user-defined pure function too. Only the call's OWN ARGS still need
/// checking (they're evaluated in the CALLER's context, where a perform of
/// `ename` or a needing-call could legitimately appear).
///
/// edp_rewrite_needing_body/edp_rewrite_handle_body mirror the EHandle/
/// needing-call traversal exactly (see their own doc comments for why the
/// two must always agree, per "追記 10") -- a call to a `pure_fns` member
/// needs NO corresponding rewrite-side change, since it already falls
/// through those functions' existing "recurse into args, leave the call
/// itself unchanged" default case, which is exactly correct here too.
///
/// `EDot(obj, field, ..)` -- a plain `.field` read, NOT a call through it
/// (calling through a field is `ECall(EDot(..), args)`, which the ECall
/// case above still rejects via its `_ => true` fallback for any callee
/// shape besides a bare `EIdent`) -- is safe to recurse into `obj` for
/// rather than reject outright. Unlike the `needing`/`pure_fns` checks,
/// this needs NO type information and carries NO name-shadowing risk: it
/// isn't a name lookup at all, just "does the object expression being
/// read from hide anything unsafe", which the recursive traversal already
/// answers soundly for any `obj` shape. The field name itself is a bare
/// string, not a sub-expression, so there's nothing else to check.
/// edp_rewrite_needing_body/edp_rewrite_handle_body gained a matching
/// `EDot` case (recursing into `obj`, leaving the field name untouched)
/// for the same "the two traversals must agree" reason as everywhere else
/// in this function.
///
/// `EFn(.., body)` -- a closure LITERAL -- now recurses into its own body
/// with the exact same check, instead of being unconditionally unsafe.
/// This is sound for the same structural reason as everywhere else in
/// this function: if the closure's body, scanned by this SAME recursive
/// traversal, contains nothing this pass doesn't already know how to
/// classify (a `perform` of `ename`, a call to a `needing`/`pure_fns`
/// member, or any of the other already-recognized safe shapes), then
/// whatever the closure eventually does when invoked -- once, many times,
/// stored and called later, whatever -- is exactly as well-understood as
/// any other code this pass already rewrites; nothing about closures
/// specifically weakens that. A `perform ename::Op` found inside the
/// closure's body IS rewritten (edp_rewrite_needing_body/edp_rewrite_
/// handle_body gained a matching `EFn` case, recursing into the body the
/// same way), using the closure's LEXICALLY CAPTURED `dict_pname` from
/// its enclosing scope -- an ordinary captured variable reference, no
/// different from any other value a closure captures, valid for as long
/// as the closure itself is (standard closure-capture semantics, entirely
/// orthogonal to anything effect-handling-specific). The closure's own
/// declared effect row (if any) is not consulted here; it's the type
/// checker's own bookkeeping, unrelated to whether this AST-level rewrite
/// can soundly transform the closure's body.
/// ADR-0076 追記34 V2: the traversal is scope-tracked. `ls_names` /
/// `ls_flags` are a parallel-array binding environment (last-wins lookup):
/// flag TRUE means the name is `let`/`let rec`-bound to a closure LITERAL
/// in the current scope -- a call through it is safe, because the
/// literal's own body is scanned by this very traversal at its definition
/// site (any perform inside it is rewritten in place by
/// edp_rewrite_needing_body, with the dict reaching it as an ordinary
/// closure capture). Flag FALSE marks every other binder (params, `let
/// mut`, for/loop/match/arm binders, non-literal lets), and a FALSE hit
/// makes the call UNSAFE even when the name also matches `needing` /
/// `pure_fns` -- a local rebind shadows the top-level meaning, so trusting
/// the global sets there was never sound. Without the TRUE case, ANY
/// local helper closure inside an effectful function sank its whole
/// effect's eligibility -- tolerable when the replay engine existed as a
/// fallback, a language-breaking rejection once it was removed (追記34
/// V2), which is why the scope tracking arrived in the same change that
/// deleted replay.
export fn edp_has_unsafe_construct(expr: Expr, needing: Array[String], ename: String, pure_fns: Array[String]) -> Bool {
  edp_has_unsafe_construct_sc(expr = expr, needing = needing, ename = ename, pure_fns = pure_fns, ls_names = empty_str_array(), ls_flags = edp_empty_bool_array())
}

export fn edp_empty_bool_array() -> Array[Bool] {
  let out: Array[Bool] = []
  out
}

fn edp_expr_is_fn_literal(_ e: Expr) -> Bool {
  match e {
    EFn(_, _, _, _, _, _) => true,
    _ => false
  }
}

/// Last-wins lookup: 1 = bound to a closure literal (call safe), 0 = bound
/// to anything else (call unsafe), -1 = not locally bound at all.
fn edp_local_safe_lookup(ls_names: Array[String], ls_flags: Array[Bool], name: String) -> Int {
  let mut i = Array::length(ls_names) - 1
  let mut out = -1
  while i >= 0 && out < 0 {
    if Array::get(ls_names, at = i) == name {
      out = if Array::get(ls_flags, at = i) {
        1
      } else {
        0
      }
    } else {
      ()
    }
    i = i - 1
  }
  out
}

fn edp_ls_push_pat(p: Pat, ls_names: Array[String], ls_flags: Array[Bool]) -> Unit {
  let names = array_empty()
  edp_pat_binds(p = p, out = names)
  let mut i = 0
  while i < Array::length(names) {
    Array::push(ls_names, value = Array::get(names, at = i))
    Array::push(ls_flags, value = false)
    i = i + 1
  }
}

/// Is `(p) -> p` -- one parameter, a body that is exactly that parameter --
/// the ascription closure codegen recognises (`__asc`, or its shadow-renamed
/// `__shadow_*___asc` spelling)?
export fn edp_is_identity_ascription(params: Array[(String, Option[TypeExpr])], body: Expr) -> Bool {
  if Array::length(params) != 1 {
    false
  } else {
    let (pname, _) = Array::get(params, at = 0)
    let is_asc = pname == "__asc" || (String::starts_with(pname, prefix = "__shadow_") && String::ends_with(pname, suffix = "___asc"))
    is_asc && match body {
      EIdent(bname, _) => bname == pname,
      _ => false
    }
  }
}

fn edp_has_unsafe_construct_sc(expr: Expr, needing: Array[String], ename: String, pure_fns: Array[String], ls_names: Array[String], ls_flags: Array[Bool]) -> Bool {
  match expr {
    EFn(_, _, params, _, _, body) => {
      let base = Array::length(ls_names)
      let mut pi = 0
      while pi < Array::length(params) {
        let (pn, ty) = Array::get(params, at = pi)
        Array::push(ls_names, value = edp_strip_tilde(pn))
        // A checked row-free function parameter cannot perform the effect.
        Array::push(ls_flags, value = match ty {
          Some(TyFn(_, _, None)) => true,
          _ => false
        })
        pi = pi + 1
      }
      let r = edp_has_unsafe_construct_sc(expr = body, needing = needing, ename = ename, pure_fns = pure_fns, ls_names = ls_names, ls_flags = ls_flags)
      Array::truncate(ls_names, length = base)
      Array::truncate(ls_flags, length = base)
      r
    },
    // #2500 item 2: a nested handle for `ename` ITSELF is no longer an
    // automatic rejection. The constructs that make a region unsafe are the
    // same either way -- what differs is only WHICH arms the rewrite splices
    // into it, and both rewriters now make that distinction (the inner body
    // takes the inner arms, which shadow the outer for exactly that region;
    // the inner ARMS take the outer ones, because an arm runs outside its own
    // handle's coverage). Scanning body and arms the same way as a foreign
    // handle is therefore the honest question here too. The two rewriters and
    // this scan must keep agreeing -- 追記 10.
    EHandle(body, arms) => edp_has_unsafe_construct_sc(expr = body, needing = needing, ename = ename, pure_fns = pure_fns, ls_names = ls_names, ls_flags = ls_flags) || edp_arms_have_unsafe_construct(arms = arms, needing = needing, ename = ename, pure_fns = pure_fns, ls_names = ls_names, ls_flags = ls_flags),
    EIf(c, t, e) => edp_has_unsafe_construct_sc(expr = c, needing = needing, ename = ename, pure_fns = pure_fns, ls_names = ls_names, ls_flags = ls_flags) || edp_has_unsafe_construct_sc(expr = t, needing = needing, ename = ename, pure_fns = pure_fns, ls_names = ls_names, ls_flags = ls_flags) || edp_has_unsafe_construct_sc(expr = e, needing = needing, ename = ename, pure_fns = pure_fns, ls_names = ls_names, ls_flags = ls_flags),
    EMatch(s, arms) => edp_has_unsafe_construct_sc(expr = s, needing = needing, ename = ename, pure_fns = pure_fns, ls_names = ls_names, ls_flags = ls_flags) || edp_arms_have_unsafe_construct(arms = arms, needing = needing, ename = ename, pure_fns = pure_fns, ls_names = ls_names, ls_flags = ls_flags),
    EWhile(c, b) => edp_has_unsafe_construct_sc(expr = c, needing = needing, ename = ename, pure_fns = pure_fns, ls_names = ls_names, ls_flags = ls_flags) || edp_has_unsafe_construct_sc(expr = b, needing = needing, ename = ename, pure_fns = pure_fns, ls_names = ls_names, ls_flags = ls_flags),
    EForIn(n, idx, it, b) => {
      if edp_has_unsafe_construct_sc(expr = it, needing = needing, ename = ename, pure_fns = pure_fns, ls_names = ls_names, ls_flags = ls_flags) {
        true
      } else {
        let base = Array::length(ls_names)
        Array::push(ls_names, value = n)
        Array::push(ls_flags, value = false)
        match idx {
          Some(iname) => {
            Array::push(ls_names, value = iname)
            Array::push(ls_flags, value = false)
          },
          None => ()
        }
        let r = edp_has_unsafe_construct_sc(expr = b, needing = needing, ename = ename, pure_fns = pure_fns, ls_names = ls_names, ls_flags = ls_flags)
        Array::truncate(ls_names, length = base)
        Array::truncate(ls_flags, length = base)
        r
      }
    },
    ELoop(pairs, b) => {
      if edp_pairs_have_unsafe_construct(pairs = pairs, needing = needing, ename = ename, pure_fns = pure_fns, ls_names = ls_names, ls_flags = ls_flags) {
        true
      } else {
        let base = Array::length(ls_names)
        let mut li = 0
        while li < Array::length(pairs) {
          let (ln, _) = Array::get(pairs, at = li)
          Array::push(ls_names, value = ln)
          Array::push(ls_flags, value = false)
          li = li + 1
        }
        let r = edp_has_unsafe_construct_sc(expr = b, needing = needing, ename = ename, pure_fns = pure_fns, ls_names = ls_names, ls_flags = ls_flags)
        Array::truncate(ls_names, length = base)
        Array::truncate(ls_flags, length = base)
        r
      }
    },
    ELet(n, v, b, _) => {
      if edp_has_unsafe_construct_sc(expr = v, needing = needing, ename = ename, pure_fns = pure_fns, ls_names = ls_names, ls_flags = ls_flags) {
        true
      } else {
        let base = Array::length(ls_names)
        Array::push(ls_names, value = n)
        Array::push(ls_flags, value = edp_expr_is_fn_literal(v))
        let r = edp_has_unsafe_construct_sc(expr = b, needing = needing, ename = ename, pure_fns = pure_fns, ls_names = ls_names, ls_flags = ls_flags)
        Array::truncate(ls_names, length = base)
        Array::truncate(ls_flags, length = base)
        r
      }
    },
    ELetMut(n, v, b, _) => {
      if edp_has_unsafe_construct_sc(expr = v, needing = needing, ename = ename, pure_fns = pure_fns, ls_names = ls_names, ls_flags = ls_flags) {
        true
      } else {
        let base = Array::length(ls_names)
        Array::push(ls_names, value = n)
        Array::push(ls_flags, value = false)
        let r = edp_has_unsafe_construct_sc(expr = b, needing = needing, ename = ename, pure_fns = pure_fns, ls_names = ls_names, ls_flags = ls_flags)
        Array::truncate(ls_names, length = base)
        Array::truncate(ls_flags, length = base)
        r
      }
    },
    ELetRec(n, v, b) => {
      let base = Array::length(ls_names)
      Array::push(ls_names, value = n)
      Array::push(ls_flags, value = edp_expr_is_fn_literal(v))
      let r = edp_has_unsafe_construct_sc(expr = v, needing = needing, ename = ename, pure_fns = pure_fns, ls_names = ls_names, ls_flags = ls_flags) || edp_has_unsafe_construct_sc(expr = b, needing = needing, ename = ename, pure_fns = pure_fns, ls_names = ls_names, ls_flags = ls_flags)
      Array::truncate(ls_names, length = base)
      Array::truncate(ls_flags, length = base)
      r
    },
    ESeq(a, b) => edp_has_unsafe_construct_sc(expr = a, needing = needing, ename = ename, pure_fns = pure_fns, ls_names = ls_names, ls_flags = ls_flags) || edp_has_unsafe_construct_sc(expr = b, needing = needing, ename = ename, pure_fns = pure_fns, ls_names = ls_names, ls_flags = ls_flags),
    ECall(callee, args, _, _) => match callee {
      // A type ascription -- how an annotated `let x: T = v` reaches this
      // pass, `((__asc: T) -> __asc)(v)` -- is an identity closure applied on
      // the spot: it performs nothing and runs nothing but its argument, so
      // only the argument is scanned. Treating it as an opaque call refused
      // every handle whose body held an annotated `let` next to a nested
      // handle of the same effect -- including the entry provider around a
      // test that records into `let seen: Array[String] = []` from a mock
      // arm (#1962).
      EFn(_, _, aparams, _, _, abody) => if edp_is_identity_ascription(params = aparams, body = abody) && Array::length(args) == 1 {
        edp_has_unsafe_construct_sc(expr = Array::get(args, at = 0), needing = needing, ename = ename, pure_fns = pure_fns, ls_names = ls_names, ls_flags = ls_flags)
      } else {
        true
      },
      EIdent(nm, _) => if nm == "perform" && Array::length(args) == 1 {
        edp_perform_operand_has_unsafe_construct(operand = Array::get(args, at = 0), needing = needing, ename = ename, pure_fns = pure_fns, ls_names = ls_names, ls_flags = ls_flags)
      } else if nm == "resume" {
        edp_exprs_have_unsafe_construct(exprs = args, needing = needing, ename = ename, pure_fns = pure_fns, ls_names = ls_names, ls_flags = ls_flags)
      } else {
        let local = edp_local_safe_lookup(ls_names = ls_names, ls_flags = ls_flags, name = nm)
        if local == 1 {
          edp_exprs_have_unsafe_construct(exprs = args, needing = needing, ename = ename, pure_fns = pure_fns, ls_names = ls_names, ls_flags = ls_flags)
        } else if local == 0 {
          true
        } else if edp_is_pure_builtin_call(nm) {
          edp_exprs_have_unsafe_construct(exprs = args, needing = needing, ename = ename, pure_fns = pure_fns, ls_names = ls_names, ls_flags = ls_flags)
        } else if edp_builtin_is_first_order(nm) {
          // #2109: effectful, but it cannot run a user closure, so it cannot
          // hide a perform of `ename` from this handle.
          edp_exprs_have_unsafe_construct(exprs = args, needing = needing, ename = ename, pure_fns = pure_fns, ls_names = ls_names, ls_flags = ls_flags)
        } else if edp_str_array_contains(arr = needing, v = nm) {
          edp_exprs_have_unsafe_construct(exprs = args, needing = needing, ename = ename, pure_fns = pure_fns, ls_names = ls_names, ls_flags = ls_flags)
        } else if edp_str_array_contains(arr = pure_fns, v = nm) {
          edp_exprs_have_unsafe_construct(exprs = args, needing = needing, ename = ename, pure_fns = pure_fns, ls_names = ls_names, ls_flags = ls_flags)
        } else if edp_argcond_admits(nm = nm, args = args, ename = ename, needing = needing, pure_fns = pure_fns) {
          // #2065: a higher-order row-variable callee, every one of whose
          // function-typed parameters receives a literal that cannot perform
          // `ename` here -- see edp_argcond_admits.
          edp_exprs_have_unsafe_construct(exprs = args, needing = needing, ename = ename, pure_fns = pure_fns, ls_names = ls_names, ls_flags = ls_flags)
        } else {
          true
        }
      },
      _ => true
    },
    EBinOp(_, l, r, _) => edp_has_unsafe_construct_sc(expr = l, needing = needing, ename = ename, pure_fns = pure_fns, ls_names = ls_names, ls_flags = ls_flags) || edp_has_unsafe_construct_sc(expr = r, needing = needing, ename = ename, pure_fns = pure_fns, ls_names = ls_names, ls_flags = ls_flags),
    EUnaryOp(_, e2) => edp_has_unsafe_construct_sc(expr = e2, needing = needing, ename = ename, pure_fns = pure_fns, ls_names = ls_names, ls_flags = ls_flags),
    EAssign(_, v, c, _) => edp_has_unsafe_construct_sc(expr = v, needing = needing, ename = ename, pure_fns = pure_fns, ls_names = ls_names, ls_flags = ls_flags) || edp_has_unsafe_construct_sc(expr = c, needing = needing, ename = ename, pure_fns = pure_fns, ls_names = ls_names, ls_flags = ls_flags),
    EAssignOp(_, _, v, c, _) => edp_has_unsafe_construct_sc(expr = v, needing = needing, ename = ename, pure_fns = pure_fns, ls_names = ls_names, ls_flags = ls_flags) || edp_has_unsafe_construct_sc(expr = c, needing = needing, ename = ename, pure_fns = pure_fns, ls_names = ls_names, ls_flags = ls_flags),
    EDot(o, _, _, _) => edp_has_unsafe_construct_sc(expr = o, needing = needing, ename = ename, pure_fns = pure_fns, ls_names = ls_names, ls_flags = ls_flags),
    ELabeledArg(_, _, v) => edp_has_unsafe_construct_sc(expr = v, needing = needing, ename = ename, pure_fns = pure_fns, ls_names = ls_names, ls_flags = ls_flags),
    EReturn(e2) => edp_has_unsafe_construct_sc(expr = e2, needing = needing, ename = ename, pure_fns = pure_fns, ls_names = ls_names, ls_flags = ls_flags),
    EBreak(opt) => match opt {
      Some(e2) => edp_has_unsafe_construct_sc(expr = e2, needing = needing, ename = ename, pure_fns = pure_fns, ls_names = ls_names, ls_flags = ls_flags),
      None => false
    },
    EContinue(args) => edp_exprs_have_unsafe_construct(exprs = args, needing = needing, ename = ename, pure_fns = pure_fns, ls_names = ls_names, ls_flags = ls_flags),
    ETuple(elems) => edp_exprs_have_unsafe_construct(exprs = elems, needing = needing, ename = ename, pure_fns = pure_fns, ls_names = ls_names, ls_flags = ls_flags),
    EArray(elems) => edp_exprs_have_unsafe_construct(exprs = elems, needing = needing, ename = ename, pure_fns = pure_fns, ls_names = ls_names, ls_flags = ls_flags),
    ERecord(_, fields, _) => edp_fields_have_unsafe_construct(fields = fields, needing = needing, ename = ename, pure_fns = pure_fns, ls_names = ls_names, ls_flags = ls_flags),
    EMap(fields) => edp_fields_have_unsafe_construct(fields = fields, needing = needing, ename = ename, pure_fns = pure_fns, ls_names = ls_names, ls_flags = ls_flags),
    ESpread(e2) => edp_has_unsafe_construct_sc(expr = e2, needing = needing, ename = ename, pure_fns = pure_fns, ls_names = ls_names, ls_flags = ls_flags),
    // `_ => false` also covers `EStringInterp` -- verified (2026-07-23), not
    // an oversight: `expand_interp_stmts` (entry/source_compile/wasi_only/
    // preprocess_interp.vibe) always fully rewrites every `EStringInterp`
    // into ordinary EBinOp/ECall string-concat nodes BEFORE check_program,
    // itself called before this pass ever runs (see
    // preprocess_compile.vibe's `expand_interp_stmts(stmts); check_program
    // (stmts); ...compile_wasi_module_*_impl(stmts, ...)` ordering, all four
    // entry variants). An `EStringInterp` node containing an embedded
    // `perform` therefore can never actually reach this traversal -- by the
    // time it would, the perform is already an ordinary sub-expression of a
    // string-concat chain, visited through EBinOp/ECall like any other.
    // Checked directly (not assumed) after noticing this pass's own match
    // arms, unlike edp_has_unsafe_construct's sibling in perceus.vibe/
    // common_analysis.vibe/checker_warning.vibe/etc., never explicitly
    // lists `EStringInterp` at all -- worth confirming once rather than
    // leaving it as a plausible-looking gap for a future reader to
    // re-investigate from scratch.
    _ => false
  }
}

//# #2065 wall 1: the call-site argument-inertness rule (evidence side)
//
// A callee whose row carries a VARIABLE is withheld from `pure_fns`, because
// the variable can be instantiated to the migrated effect at the call site
// and the perform then happens inside the callee, out of this handle's
// sight. `edp_callee_first_order` (evidence.vibe) admits the callees whose
// parameters take no function: no argument can carry a row, so the variable
// can only be the empty row. That leaves every HIGHER-ORDER one refused --
// and `TaskGroup::run((g) -> { 42 })` is higher-order.
//
// Whether the variable can become `ename` is a property of what actually
// arrives at THIS call, which is the argument the suspend pass has made
// since #1727 (`scps_callee_fn_args_inert`). This is its evidence-side port:
// when every function-typed parameter receives a closure LITERAL that cannot
// perform `ename` -- its declared row names neither `ename` nor a variable,
// and its body neither performs `ename` nor calls a function that needs it --
// no argument can instantiate the variable to `ename`, so the call is
// `ename`-free for the same reason a first-order one is. The literal's own
// body is still scanned by the ordinary recursion over the arguments.
//
// Fails closed on everything else: a name, a call result or a field access in
// a function-typed position (their rows are not readable here), a missing
// argument, and any callee the evidence pass did not record -- it records only
// callees whose every parameter is annotated.
//
// Pass state, written by the evidence pass (`edp_argcond_reset` /
// `edp_argcond_note`) before it scans for an effect; consulted only for the
// effect it names.
let edp_argcond_effect: Array[String] = [""]
let edp_argcond_names: Array[String] = []
let edp_argcond_masks: Array[Array[Bool]] = []
// Every name the program binds locally (a parameter, a `let`, a pattern), so
// a callee spelled like a pure top-level function is trusted only when no
// local binding could be what it resolves to (Codex on #3059).
let edp_argcond_binders: Array[MutSet[String]] = [MutSet::new_string()]

/// Record every locally bound name in `stmts` for `edp_expr_reaches_effect`.
export fn edp_argcond_note_binders(_ stmts: Array[Stmt]) -> Unit {
  edp_argcond_use_binders(edp_collect_program_binders(stmts))
}

/// Collect one read-only name census for an unchanged statement list.
export fn edp_collect_program_binders(_ stmts: Array[Stmt]) -> MutSet[String] {
  let out = MutSet::new_string()
  let mut i = 0
  while i < Array::length(stmts) {
    edp_collect_statement_binders(stmt = Array::get(stmts, at = i), out = out)
    i = i + 1
  }
  out
}

fn edp_collect_statement_binders(stmt: Stmt, out: MutSet[String]) -> Unit {
  match stmt {
    SLet(_, _, _, _, e) => edp_collect_binders(e = e, out = out),
    SLetMut(_, _, e) => edp_collect_binders(e = e, out = out),
    STest(_, e) => edp_collect_binders(e = e, out = out),
    SBench(_, e) => edp_collect_binders(e = e, out = out),
    SExpr(e) => edp_collect_binders(e = e, out = out),
    SLetPat(p, e) => {
      edp_note_pat_binders(p = p, out = out)
      edp_collect_binders(e = e, out = out)
    },
    _ => ()
  }
}

// While non-empty, binders are appended to the top log instead of inserted.
let edp_binder_logs: Array[Array[String]] = []
let edp_binder_log_sink: MutSet[String] = MutSet::new_string()

/// The binders edp_collect_program_binders would insert for this one
/// statement, in visit order and with repeats: inserting them into a set gives
/// that statement's share of the census, without a set per statement.
export fn edp_statement_binder_log(_ stmt: Stmt) -> Array[String] {
  let log: Array[String] = []
  Array::push(edp_binder_logs, value = log)
  edp_collect_statement_binders(stmt = stmt, out = edp_binder_log_sink)
  Array::truncate(edp_binder_logs, length = Array::length(edp_binder_logs) - 1)
  log
}

/// Select a census already collected from the tree this query will read.
export fn edp_argcond_use_binders(_ binders: MutSet[String]) -> Unit {
  Array::set(edp_argcond_binders, at = 0, value = binders)
}

/// Does some local binding in the program last passed to
/// `edp_argcond_note_binders` have this spelling?
export fn edp_is_program_binder(_ name: String) -> Bool {
  MutSet::has(Array::get(edp_argcond_binders, at = 0), x = name)
}

fn edp_note_binder(name: String, out: MutSet[String]) -> Unit {
  let logs = Array::length(edp_binder_logs)
  if logs > 0 {
    Array::push(Array::get(edp_binder_logs, at = logs - 1), value = name)
  } else {
    MutSet::insert(out, x = name)
  }
  ()
}

fn edp_note_pat_binders(p: Pat, out: MutSet[String]) -> Unit {
  match p {
    PBind(n) => edp_note_binder(name = n, out = out),
    PCtor(_, ps) => {
      for q in ps {
        edp_note_pat_binders(p = q, out = out)
      }
      ()
    },
    PTuple(ps) => {
      for q in ps {
        edp_note_pat_binders(p = q, out = out)
      }
      ()
    },
    POr(a, b) => {
      edp_note_pat_binders(p = a, out = out)
      edp_note_pat_binders(p = b, out = out)
    },
    PStruct(_, fields) => {
      for f in fields {
        edp_note_pat_binders(p = f.1, out = out)
      }
      ()
    },
    _ => ()
  }
}

fn edp_collect_binders(e: Expr, out: MutSet[String]) -> Unit {
  match e {
    EFn(_, _, params, _, _, _) => {
      for param in params {
        edp_note_binder(name = param.0, out = out)
      }
      ()
    },
    ELet(nm, _, _, _) => edp_note_binder(name = nm, out = out),
    ELetMut(nm, _, _, _) => edp_note_binder(name = nm, out = out),
    ELetRec(nm, _, _) => edp_note_binder(name = nm, out = out),
    // Loop-state names (`loop (h = f) { .. }`) are bindings too (Codex on
    // #3059).
    ELoop(states, _) => {
      for state in states {
        edp_note_binder(name = state.0, out = out)
      }
      ()
    },
    EForIn(nm, idx, _, _) => {
      edp_note_binder(name = nm, out = out)
      match idx {
        Some(n) => edp_note_binder(name = n, out = out),
        None => ()
      }
    },
    EMatch(_, arms) => {
      for arm in arms {
        edp_note_pat_binders(p = arm.0, out = out)
      }
      ()
    },
    EHandle(_, arms) => {
      for arm in arms {
        edp_note_pat_binders(p = arm.0, out = out)
      }
      ()
    },
    _ => ()
  }
  let mark = expr_children_push(e)
  let end = expr_children_top()
  let mut i = mark
  while i < end {
    edp_collect_binders(e = expr_child_at(i), out = out)
    i = i + 1
  }
  expr_children_pop(mark)
}

export fn edp_argcond_reset(_ ename: String) -> Unit {
  Array::set(edp_argcond_effect, at = 0, value = ename)
  Array::truncate(edp_argcond_names, length = 0)
  Array::truncate(edp_argcond_masks, length = 0)
}

/// `fn_params[i]` is true when parameter `i` is function-typed.
export fn edp_argcond_note(ename: String, name: String, fn_params: Array[Bool]) -> Unit {
  if Array::get(edp_argcond_effect, at = 0) == ename && !edp_str_array_contains(arr = edp_argcond_names, v = name) {
    Array::push(edp_argcond_names, value = name)
    Array::push(edp_argcond_masks, value = fn_params)
  } else {
    ()
  }
}

fn edp_argcond_admits(nm: String, args: Array[Expr], ename: String, needing: Array[String], pure_fns: Array[String]) -> Bool {
  if Array::get(edp_argcond_effect, at = 0) != ename {
    false
  } else {
    let mut slot = -1
    let mut i = 0
    while i < Array::length(edp_argcond_names) {
      if slot < 0 && Array::get(edp_argcond_names, at = i) == nm {
        slot = i
      } else {
        ()
      }
      i = i + 1
    }
    if slot < 0 {
      false
    } else {
      let mask = Array::get(edp_argcond_masks, at = slot)
      let mut ok = Array::length(args) >= Array::length(mask)
      let mut p = 0
      while ok && p < Array::length(mask) {
        if Array::get(mask, at = p) && !edp_literal_cannot_perform(arg = Array::get(args, at = p), ename = ename, needing = needing, pure_fns = pure_fns) {
          ok = false
        } else {
          ()
        }
        p = p + 1
      }
      ok
    }
  }
}

fn edp_literal_cannot_perform(arg: Expr, ename: String, needing: Array[String], pure_fns: Array[String]) -> Bool {
  match arg {
    EFn(_, _, _, _, eff, body) => {
      let row_ok = match eff {
        Some(row) => {
          let parts = String::split(row, sep = ",")
          let mut clean = true
          let mut i = 0
          while i < Array::length(parts) {
            let label = String::trim(Array::get(parts, at = i))
            let first = if String::length(label) > 0 {
              String::char_code_at(label, at = 0)
            } else {
              0
            }
            if edp_effect_name_of(label) == ename || (first >= 97 && first <= 122) {
              clean = false
            } else {
              ()
            }
            i = i + 1
          }
          clean
        },
        None => true
      }
      row_ok && !edp_expr_reaches_effect(e = body, ename = ename, needing = needing, pure_fns = pure_fns)
    },
    _ => false
  }
}

/// Could `e` perform `ename`? Conservative, the evidence-side mirror of the
/// suspend pass's `scps_inert_taint`: a call counts as SAFE only when its
/// callee is a pure or first-order builtin (neither can run user code that
/// performs) or a top-level function already proven irrelevant to `ename`
/// (`pure_fns`). Every other callee taints the literal -- a function that
/// needs `ename`, and equally a name the literal CAPTURES or binds locally,
/// whose row is not readable here: `(y) -> h(y)` with a captured
/// `h: (Int) -> Int with Ask` performs `Ask` without naming it (Codex on
/// #3059). So does a callee that is not a name at all.
fn edp_expr_reaches_effect(e: Expr, ename: String, needing: Array[String], pure_fns: Array[String]) -> Bool {
  if edp_user_perform_effect_of(e) == ename {
    true
  } else {
    match e {
      ECall(EIdent(nm, _), args, _, _) => {
        // A builtin's spelling reaches the builtin only when no binder in the
        // program has it: `not: (Bool) -> Bool with Async` captured by the
        // literal makes `not(true)` perform (Codex on #3059).
        let unshadowed = !edp_is_program_binder(nm)
        let callee_ok = nm == "perform" || nm == "resume" || (unshadowed && (edp_is_pure_builtin_call(nm) || edp_builtin_is_first_order(nm) || (edp_str_array_contains(arr = pure_fns, v = nm) && !edp_str_array_contains(arr = needing, v = nm))))
        !callee_ok || edp_exprs_reach_effect(es = args, ename = ename, needing = needing, pure_fns = pure_fns)
      },
      ECall(_, _, _, _) => true,
      EHandle(body, arms) => edp_expr_reaches_effect(e = body, ename = ename, needing = needing, pure_fns = pure_fns) || edp_arm_bodies_reach_effect(arms = arms, ename = ename, needing = needing, pure_fns = pure_fns),
      EMatch(scrut, arms) => edp_expr_reaches_effect(e = scrut, ename = ename, needing = needing, pure_fns = pure_fns) || edp_arm_bodies_reach_effect(arms = arms, ename = ename, needing = needing, pure_fns = pure_fns),
      _ => edp_exprs_reach_effect(es = expr_children(e), ename = ename, needing = needing, pure_fns = pure_fns)
    }
  }
}

fn edp_exprs_reach_effect(es: Array[Expr], ename: String, needing: Array[String], pure_fns: Array[String]) -> Bool {
  let mut i = 0
  let mut found = false
  while !found && i < Array::length(es) {
    found = edp_expr_reaches_effect(e = Array::get(es, at = i), ename = ename, needing = needing, pure_fns = pure_fns)
    i = i + 1
  }
  found
}

fn edp_arm_bodies_reach_effect(arms: Array[(Pat, Expr)], ename: String, needing: Array[String], pure_fns: Array[String]) -> Bool {
  let mut i = 0
  let mut found = false
  while !found && i < Array::length(arms) {
    found = edp_expr_reaches_effect(e = Array::get(arms, at = i).1, ename = ename, needing = needing, pure_fns = pure_fns)
    i = i + 1
  }
  found
}

/// #2109: is this builtin FIRST-ORDER -- does its signature take no function
/// anywhere in its parameters?
///
/// A builtin cannot itself `perform` a user effect (host operations are not
/// user code), so the only way one can hide a perform from an enclosing
/// `handle` is by CALLING a closure the program handed it. `Array::foreach`
/// and friends do exactly that and must stay opaque; `println`, `Fs::read_file`
/// and the rest of the first-order host surface cannot. Read off the registry
/// signature rather than a hand-kept list, so a new host builtin is classified
/// the moment it is declared.
///
/// This is what makes `handle { println("x") f() } with { Ask::Get(..) => .. }` compile.
/// It did not, on either lane, and the diagnostic said the handled body may
/// "perform directly, call a named top-level `fn`, or call a closure literal
/// that carries an effect row annotation" -- three forms, none of which
/// describes a print.
fn edp_type_has_fn(_ t: Type) -> Bool {
  match t {
    CtFn(_, _, _) => true,
    CtArray(e) => edp_type_has_fn(e),
    CtOption(e) => edp_type_has_fn(e),
    CtTuple(es) => edp_types_have_fn(es),
    CtNamed(_, args) => edp_types_have_fn(args),
    CtForAll(_, _, body) => edp_type_has_fn(body),
    _ => false
  }
}

fn edp_types_have_fn(_ ts: Array[Type]) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(ts) {
    if edp_type_has_fn(Array::get(ts, at = i)) {
      found = true
    } else {
      ()
    }
    i = i + 1
  }
  found
}

fn edp_builtin_is_first_order(_ nm: String) -> Bool {
  match lookup_registry_builtin(nm) {
    Some(ty) => match ty {
      CtFn(params, _, _) => !edp_types_have_fn(params),
      _ => false
    },
    None => false
  }
}

// #2373: this used to be a SECOND copy of the list, whose doc comment claimed
// to mirror `idp_pure_builtin_names` "exactly" while three names
// (`Array::concat`, `HostStream::next`, `HostStream::close`) were only in the
// idp copy. The divergence was invisible because it ran in the harmless
// direction -- edp's consumer has fallbacks (the registry first-order probe in
// `edp_has_unsafe_construct`, the raw-half prefixes below) and idp's
// (`scps_named_call_ok`, suspend-class lowering) has none -- so nothing failed
// and nothing checked it either. A mirror gate would have enforced the copy;
// there is no copy to enforce now, which is the same guarantee without a
// script that can rot. The audit criterion is one criterion for both consumers
// ("can neither perform a user effect nor invoke a function-typed argument"),
// so a name belongs to both lists or to neither -- see
// idp_pure_builtin_names' doc comment for what adding one requires.
//
// #1875 R3: the memo is idp's (initialized once -- module_let_memo_test.vibe
// is the spec). edp_is_pure_builtin_call runs per CALL NODE inside every
// safety scan and read query (RQOpaqueCall via edp_callee_is_resolvable,
// edp_has_unsafe_construct_sc), so rebuilding the ~100-entry table per probe
// was ~17MB of allocation for one analyzed effect's performing-fns fixpoint
// alone.
export fn edp_is_pure_builtin_call(_ nm: String) -> Bool {
  idp_is_pure_builtin_call(nm)
}

/// ADR-0076 追記34 V2: raw host-import calls are INERT for eligibility --
/// a host import can neither perform a user effect nor invoke a
/// user-supplied closure, so a call to one hides nothing this pass needs
/// to see. The in-tree convention for direct host wrappers is
/// `vibe_<area>_<op>_raw` (lib/@vibe/http's client side and lib/@vibe/fs's
/// stat_token route around the perform machinery through exactly these --
/// see http.vibe's #794 doc comment); such a name qualifies ONLY when no
/// top-level statement binds it (a same-named user fn resolves to that
/// binding instead and is judged by the ordinary needing/pure rules; a
/// same-named top-level VALUE stays conservatively unsafe). Collected
/// callees are appended into the `pure_fns` ("inert callee") set the
/// safety scans already thread everywhere.
export fn edp_name_is_host_raw_shape(_ nm: String) -> Bool {
  String::starts_with(nm, prefix = "vibe_") && String::ends_with(nm, suffix = "_raw")
}

fn edp_perform_operand_has_unsafe_construct(operand: Expr, needing: Array[String], ename: String, pure_fns: Array[String], ls_names: Array[String], ls_flags: Array[Bool]) -> Bool {
  match operand {
    EIdent(_, _) => false,
    ECall(op_callee, op_args, _, _) => match op_callee {
      EIdent(_, _) => edp_exprs_have_unsafe_construct(exprs = op_args, needing = needing, ename = ename, pure_fns = pure_fns, ls_names = ls_names, ls_flags = ls_flags),
      _ => true
    },
    _ => true
  }
}

fn edp_exprs_have_unsafe_construct(exprs: Array[Expr], needing: Array[String], ename: String, pure_fns: Array[String], ls_names: Array[String], ls_flags: Array[Bool]) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(exprs) {
    if edp_has_unsafe_construct_sc(expr = Array::get(exprs, at = i), needing = needing, ename = ename, pure_fns = pure_fns, ls_names = ls_names, ls_flags = ls_flags) {
      found = true
    } else {
      ()
    }
    i = i + 1
  }
  found
}

fn edp_fields_have_unsafe_construct(fields: Array[(String, Expr)], needing: Array[String], ename: String, pure_fns: Array[String], ls_names: Array[String], ls_flags: Array[Bool]) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(fields) {
    let (_, v) = Array::get(fields, at = i)
    if edp_has_unsafe_construct_sc(expr = v, needing = needing, ename = ename, pure_fns = pure_fns, ls_names = ls_names, ls_flags = ls_flags) {
      found = true
    } else {
      ()
    }
    i = i + 1
  }
  found
}

fn edp_pairs_have_unsafe_construct(pairs: Array[(String, Expr)], needing: Array[String], ename: String, pure_fns: Array[String], ls_names: Array[String], ls_flags: Array[Bool]) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(pairs) {
    let (_, v) = Array::get(pairs, at = i)
    if edp_has_unsafe_construct_sc(expr = v, needing = needing, ename = ename, pure_fns = pure_fns, ls_names = ls_names, ls_flags = ls_flags) {
      found = true
    } else {
      ()
    }
    i = i + 1
  }
  found
}

/// #965-style scope discipline for arm binders: each arm's pattern binds
/// mask any outer local-safe closure binding of the same name for the
/// arm's own body only.
fn edp_arms_have_unsafe_construct(arms: Array[(Pat, Expr)], needing: Array[String], ename: String, pure_fns: Array[String], ls_names: Array[String], ls_flags: Array[Bool]) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(arms) {
    let (p, ex) = Array::get(arms, at = i)
    let base = Array::length(ls_names)
    edp_ls_push_pat(p = p, ls_names = ls_names, ls_flags = ls_flags)
    if edp_has_unsafe_construct_sc(expr = ex, needing = needing, ename = ename, pure_fns = pure_fns, ls_names = ls_names, ls_flags = ls_flags) {
      found = true
    } else {
      ()
    }
    Array::truncate(ls_names, length = base)
    Array::truncate(ls_flags, length = base)
    i = i + 1
  }
  found
}

export fn edp_pat_qname(_ pat: Pat) -> String {
  match pat {
    PCtor(name, _) => name,
    _ => ""
  }
}

export fn edp_handle_matches_effect(arms: Array[(Pat, Expr)], ename: String) -> Bool {
  let mut i = 0
  while i < Array::length(arms) {
    let (p, _) = Array::get(arms, at = i)
    let (effect, _) = edp_split_qualified(edp_pat_qname(p))
    let matches = match effect {
      Some(name) => name == ename,
      None => false
    }
    if matches {
      return true
    }
    i = i + 1
  }
  false
}

export fn edp_split_qualified(_ name: String) -> (Option[String], String) {
  let idx = String::index_of(name, needle = "::")
  if idx > 0 {
    (Some(String::substring(name, start = 0, end = idx)), String::substring(name, start = idx + 2, end = String::length(name)))
  } else {
    (None, name)
  }
}

export fn edp_efn_eligible_for_migration(expr: Expr, ename: String, needing: Array[String], pure_fns: Array[String], es_names: Array[String], es_members_list: Array[Array[String]]) -> Bool {
  match expr {
    EFn(_, _, _, _, eff, body) => {
      let row = match eff {
        Some(s) => s,
        None => ""
      }
      edp_row_is_exactly(row = row, ename = ename, es_names = es_names, es_members_list = es_members_list) && !edp_has_unsafe_construct(expr = body, needing = needing, ename = ename, pure_fns = pure_fns)
    },
    _ => false
  }
}

// --- type-shape queries shared by the suspend and evidence passes -------

/// Does this annotation mention a FUNCTION type anywhere -- directly, or
/// nested inside a type argument or a tuple?
///
/// Shared because both row-variable rules are built on it: the suspend
/// pass's `scps_callee_first_order` and the evidence pass's
/// `edp_callee_first_order` (#2065 wall 1) ask the same question of a
/// callee's annotations, and a second copy would be a second thing to keep
/// in step.
export fn scps_ty_has_fn(_ t: TypeExpr) -> Bool {
  match t {
    TyFn(_, _, _) => true,
    TyApp(_, args) => scps_ty_list_has_fn(args),
    TyTuple(items) => scps_ty_list_has_fn(items),
    _ => false
  }
}

export fn scps_ty_list_has_fn(_ ts: Array[TypeExpr]) -> Bool {
  let mut i = 0
  let mut hit = false
  while i < Array::length(ts) {
    if scps_ty_has_fn(Array::get(ts, at = i)) {
      hit = true
    } else {
      ()
    }
    i = i + 1
  }
  hit
}

// --- trigger detection: does an arm body reference `resume` as a bare
// value (not as the immediate callee of a call)? Shadow tracking mirrors
// checker.vibe's check_arm_resume_tail: any enclosing binder named
// `resume` turns references into ordinary variable uses.

export fn scps_pat_binds_resume(_ p: Pat) -> Bool {
  match p {
    PBind(n) => n == "resume",
    PCtor(_, ps) => scps_pats_bind_resume(ps),
    PTuple(ps) => scps_pats_bind_resume(ps),
    POr(a, b) => scps_pat_binds_resume(a) || scps_pat_binds_resume(b),
    PStruct(_, fields) => {
      let mut i = 0
      let mut found = false
      while i < Array::length(fields) {
        let (_, fp) = Array::get(fields, at = i)
        if scps_pat_binds_resume(fp) {
          found = true
        } else {
          ()
        }
        i = i + 1
      }
      found
    },
    _ => false
  }
}

fn scps_pats_bind_resume(_ ps: Array[Pat]) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(ps) {
    if scps_pat_binds_resume(Array::get(ps, at = i)) {
      found = true
    } else {
      ()
    }
    i = i + 1
  }
  found
}

fn scps_fn_params_bind_resume(_ params: Array[(String, Option[TypeExpr])]) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(params) {
    let (pn, _) = Array::get(params, at = i)
    let ln = String::length(pn)
    // A labeled (`~`) OR optional (`?`) parameter keeps its marker in the raw
    // AST name; strip either, the way the checker's param_base_name does, so
    // a `resume?` parameter shadows the continuation for BOTH walks (#2985
    // review: the checker saw the shadow and classified the arm as an implicit
    // resume while this walk saw a captured `resume` and chose suspend).
    let base = if ln > 0 && (pn[ln - 1: ln] == "~" || pn[ln - 1: ln] == "?") {
      pn[0: ln - 1]
    } else {
      pn
    }
    if base == "resume" {
      found = true
    } else {
      ()
    }
    i = i + 1
  }
  found
}

/// #3540: the allocation-light pre-scan half of `scps_arm_throw_needs_driver`
/// -- may this handler arm throw? Syntax only, so it answers true for any call
/// it cannot classify without the program's rows (a user function, a local
/// closure, a computed callee); the suspend pass decides precisely.
fn scps_arm_may_throw_syntactic(_ e: Expr) -> Bool {
  match e {
    ECall(callee, args, _, _) => match callee {
      EIdent(nm, _) => if nm == "throw" {
        true
      } else if nm == "perform" {
        is_exception_effect_name(edp_user_perform_effect_of(e)) || scps_any_may_throw_syntactic(scps_syntactic_perform_operands(args))
      } else if nm == "resume" || nm == "__to_string" || idp_is_pure_builtin_call(nm) || match lookup_registry_builtin(nm) {
        Some(_) => true,
        None => false
      } {
        scps_any_may_throw_syntactic(args)
      } else {
        true
      },
      _ => true
    },
    _ => scps_any_may_throw_syntactic(expr_children(e))
  }
}

/// The arguments of a `perform`'s operation: the operation itself is not a
/// call to classify.
fn scps_syntactic_perform_operands(_ args: Array[Expr]) -> Array[Expr] {
  if Array::length(args) == 1 {
    match Array::get(args, at = 0) {
      ECall(EIdent(_, _), oargs, _, _) => oargs,
      EIdent(_, _) => [],
      other => [other]
    }
  } else {
    args
  }
}

fn scps_any_may_throw_syntactic(_ es: Array[Expr]) -> Bool {
  let mut hit = false
  let mut i = 0
  while i < Array::length(es) && !hit {
    hit = scps_arm_may_throw_syntactic(Array::get(es, at = i))
    i = i + 1
  }
  hit
}

export fn scps_arm_refs_resume_value(e: Expr, sh: Bool) -> Bool {
  scps_arm_refs_resume_value_at(e = e, sh = sh, in_fn = false)
}

/// The walk itself. `in_fn` = inside a nested lambda literal: there even the
/// direct call form `resume(v)` is a CAPTURE of the continuation (the
/// closure keeps it and may run it later, after the arm has returned), so
/// it counts as a value reference. Outside a lambda the callee position is
/// the tail-resumptive form and is not.
fn scps_arm_refs_resume_value_at(e: Expr, sh: Bool, in_fn: Bool) -> Bool {
  match e {
    EIdent(nm, _) => nm == "resume" && !sh,
    ECall(callee, args, _, _) => {
      // The immediate callee position `resume(x)` is the direct call form
      // (#942's territory), NOT a value reference. Everything else in the
      // call -- including a computed callee -- is walked normally.
      let callee_hit = match callee {
        EIdent(cn, _) => in_fn && cn == "resume" && !sh,
        _ => scps_arm_refs_resume_value_at(e = callee, sh = sh, in_fn = in_fn)
      }
      callee_hit || scps_exprs_ref_resume_value(es = args, sh = sh, in_fn = in_fn)
    },
    ELet(n, v, b, _) => scps_arm_refs_resume_value_at(e = v, sh = sh, in_fn = in_fn) || scps_arm_refs_resume_value_at(e = b, sh = sh || n == "resume", in_fn = in_fn),
    ELetMut(n, v, b, _) => scps_arm_refs_resume_value_at(e = v, sh = sh, in_fn = in_fn) || scps_arm_refs_resume_value_at(e = b, sh = sh || n == "resume", in_fn = in_fn),
    ELetRec(n, v, b) => scps_arm_refs_resume_value_at(e = v, sh = sh || n == "resume", in_fn = in_fn) || scps_arm_refs_resume_value_at(e = b, sh = sh || n == "resume", in_fn = in_fn),
    ESeq(a, b) => scps_arm_refs_resume_value_at(e = a, sh = sh, in_fn = in_fn) || scps_arm_refs_resume_value_at(e = b, sh = sh, in_fn = in_fn),
    EIf(c, t, el) => scps_arm_refs_resume_value_at(e = c, sh = sh, in_fn = in_fn) || scps_arm_refs_resume_value_at(e = t, sh = sh, in_fn = in_fn) || scps_arm_refs_resume_value_at(e = el, sh = sh, in_fn = in_fn),
    EMatch(s, arms) => {
      let mut hit = scps_arm_refs_resume_value_at(e = s, sh = sh, in_fn = in_fn)
      let mut i = 0
      while i < Array::length(arms) {
        let (p, ex) = Array::get(arms, at = i)
        if scps_arm_refs_resume_value_at(e = ex, sh = sh || scps_pat_binds_resume(p), in_fn = in_fn) {
          hit = true
        } else {
          ()
        }
        i = i + 1
      }
      hit
    },
    EHandle(b, arms) => {
      let mut hit = scps_arm_refs_resume_value_at(e = b, sh = sh, in_fn = in_fn)
      let mut i = 0
      while i < Array::length(arms) {
        let (_, ex) = Array::get(arms, at = i)
        // A nested handle's arms rebind `resume` for THEMSELVES (their
        // value references belong to the inner site, detected when the
        // rewrite reaches that inner EHandle) -- shadowed here.
        if scps_arm_refs_resume_value_at(e = ex, sh = true, in_fn = in_fn) {
          hit = true
        } else {
          ()
        }
        i = i + 1
      }
      hit
    },
    EFn(_, _, params, _, _, b) => scps_arm_refs_resume_value_at(e = b, sh = sh || scps_fn_params_bind_resume(params), in_fn = true),
    EWhile(c, b) => scps_arm_refs_resume_value_at(e = c, sh = sh, in_fn = in_fn) || scps_arm_refs_resume_value_at(e = b, sh = sh, in_fn = in_fn),
    EForIn(v1, v2, it, b) => {
      let for_sh = v1 == "resume" || (match v2 {
        Some(v2n) => v2n == "resume",
        None => false
      })
      scps_arm_refs_resume_value_at(e = it, sh = sh, in_fn = in_fn) || scps_arm_refs_resume_value_at(e = b, sh = sh || for_sh, in_fn = in_fn)
    },
    ELoop(pairs, b) => {
      let mut hit = false
      let mut loop_sh = sh
      let mut i = 0
      while i < Array::length(pairs) {
        let (n, v) = Array::get(pairs, at = i)
        if n == "resume" {
          loop_sh = true
        } else {
          ()
        }
        if scps_arm_refs_resume_value_at(e = v, sh = sh, in_fn = in_fn) {
          hit = true
        } else {
          ()
        }
        i = i + 1
      }
      hit || scps_arm_refs_resume_value_at(e = b, sh = loop_sh, in_fn = in_fn)
    },
    EBinOp(_, l, r, _) => scps_arm_refs_resume_value_at(e = l, sh = sh, in_fn = in_fn) || scps_arm_refs_resume_value_at(e = r, sh = sh, in_fn = in_fn),
    EUnaryOp(_, e2) => scps_arm_refs_resume_value_at(e = e2, sh = sh, in_fn = in_fn),
    EAssign(_, v, c, _) => scps_arm_refs_resume_value_at(e = v, sh = sh, in_fn = in_fn) || scps_arm_refs_resume_value_at(e = c, sh = sh, in_fn = in_fn),
    EAssignOp(_, _, v, c, _) => scps_arm_refs_resume_value_at(e = v, sh = sh, in_fn = in_fn) || scps_arm_refs_resume_value_at(e = c, sh = sh, in_fn = in_fn),
    EReturn(e2) => scps_arm_refs_resume_value_at(e = e2, sh = sh, in_fn = in_fn),
    EDot(o, _, _, _) => scps_arm_refs_resume_value_at(e = o, sh = sh, in_fn = in_fn),
    ELabeledArg(_, _, v) => scps_arm_refs_resume_value_at(e = v, sh = sh, in_fn = in_fn),
    EBreak(opt) => match opt {
      Some(e2) => scps_arm_refs_resume_value_at(e = e2, sh = sh, in_fn = in_fn),
      None => false
    },
    EContinue(args) => scps_exprs_ref_resume_value(es = args, sh = sh, in_fn = in_fn),
    ETuple(elems) => scps_exprs_ref_resume_value(es = elems, sh = sh, in_fn = in_fn),
    EArray(elems) => scps_exprs_ref_resume_value(es = elems, sh = sh, in_fn = in_fn),
    ERecord(_, fields, _) => scps_fields_ref_resume_value(fields = fields, sh = sh, in_fn = in_fn),
    EMap(fields) => scps_fields_ref_resume_value(fields = fields, sh = sh, in_fn = in_fn),
    ESpread(e2) => scps_arm_refs_resume_value_at(e = e2, sh = sh, in_fn = in_fn),
    _ => false
  }
}

fn scps_exprs_ref_resume_value(es: Array[Expr], sh: Bool, in_fn: Bool) -> Bool {
  let mut i = 0
  let mut hit = false
  while i < Array::length(es) {
    if scps_arm_refs_resume_value_at(e = Array::get(es, at = i), sh = sh, in_fn = in_fn) {
      hit = true
    } else {
      ()
    }
    i = i + 1
  }
  hit
}

fn scps_fields_ref_resume_value(fields: Array[(String, Expr)], sh: Bool, in_fn: Bool) -> Bool {
  let mut i = 0
  let mut hit = false
  while i < Array::length(fields) {
    let (_, v) = Array::get(fields, at = i)
    if scps_arm_refs_resume_value_at(e = v, sh = sh, in_fn = in_fn) {
      hit = true
    } else {
      ()
    }
    i = i + 1
  }
  hit
}

// --- handled-op perform / needing-call detection. sctx = (effect name,
// qualified op names ("E::op", declaration order), needing fn names,
// per-site ordinal for generated locals).

fn scps_op_index(ops: Array[String], q: String) -> Int {
  let mut i = 0
  let mut found = -1
  while i < Array::length(ops) {
    if Array::get(ops, at = i) == q {
      found = i
    } else {
      ()
    }
    i = i + 1
  }
  found
}

/// If `e` is exactly `perform Op(args)` / `perform Op` for a handled op,
/// return the op's index in ops; -1 otherwise.
export fn scps_as_target_perform(e: Expr, ops: Array[String]) -> Int {
  match e {
    ECall(callee, pargs, _, _) => match callee {
      EIdent(nm, _) => if nm == "perform" && Array::length(pargs) == 1 {
        match Array::get(pargs, at = 0) {
          EIdent(q, _) => scps_op_index(ops = ops, q = q),
          ECall(opc, _, _, _) => match opc {
            EIdent(q, _) => scps_op_index(ops = ops, q = q),
            _ => -1
          },
          _ => -1
        }
      } else {
        -1
      },
      _ => -1
    },
    _ => -1
  }
}

/// If `e` is a call to a needing (row-contains-E) top-level function,
/// return its name; "" otherwise.
export fn scps_as_needing_call(e: Expr, sctx: (String, Array[String], Array[String], Int, Array[String])) -> String {
  let (_, _, needing, _, _) = sctx
  match e {
    ECall(callee, _, _, _) => match callee {
      EIdent(nm, _) => if nm != "perform" && edp_str_array_contains(arr = needing, v = nm) {
        nm
      } else {
        ""
      },
      _ => ""
    },
    _ => ""
  }
}

// --- closure-CPS (ADR-0076 追記31 Vertical B) helpers. A "cps local" is a
// binding in scope whose closure value is compiled step-returning for the
// handled effect: a param whose declared TyFn row contains E, or a local
// let-bound to a literal the prepass step-split. Calls through one are
// needing-shaped (the call already returns __ScpsStep_E) but need NO clone.

export fn scps_as_cps_local_call(e: Expr, sctx: (String, Array[String], Array[String], Int, Array[String])) -> String {
  let (_, _, _, _, cps_locals) = sctx
  match e {
    ECall(callee, _, _, _) => match callee {
      EIdent(nm, _) => if edp_str_array_contains(arr = cps_locals, v = nm) {
        nm
      } else {
        ""
      },
      _ => ""
    },
    _ => ""
  }
}

/// Does `p` bind the name `x` (so an arm under it sees a different `x`)?
export fn scps_pat_binds_name(p: Pat, x: String) -> Bool {
  match p {
    PBind(n) => n == x,
    PCtor(_, ps) => scps_pats_bind_name(ps = ps, x = x),
    PTuple(ps) => scps_pats_bind_name(ps = ps, x = x),
    POr(a, b) => scps_pat_binds_name(p = a, x = x) || scps_pat_binds_name(p = b, x = x),
    PStruct(_, fields) => {
      let mut i = 0
      let mut hit = false
      while i < Array::length(fields) {
        let (_, fp) = Array::get(fields, at = i)
        if scps_pat_binds_name(p = fp, x = x) {
          hit = true
        } else {
          ()
        }
        i = i + 1
      }
      hit
    },
    _ => false
  }
}

fn scps_pats_bind_name(ps: Array[Pat], x: String) -> Bool {
  let mut i = 0
  let mut hit = false
  while i < Array::length(ps) {
    if scps_pat_binds_name(p = Array::get(ps, at = i), x = x) {
      hit = true
    } else {
      ()
    }
    i = i + 1
  }
  hit
}

/// A nested handler discharges this entire target only when it handles
/// every effect represented by the target's source operation list.
export fn scps_arms_discharge_ops(arms: Array[(Pat, Expr)], ops: Array[String]) -> Bool {
  if Array::length(ops) == 0 {
    return false
  }
  for op in ops {
    let (effect, _) = edp_split_qualified(op)
    let handled = match effect {
      Some(name) => edp_handle_matches_effect(arms = arms, ename = name),
      None => false
    }
    if !handled {
      return false
    }
  }
  true
}

// --- Statement writes the evidence pass's per-statement facts must see -----
//
// The evidence pass keeps facts per top-level statement and walks a statement
// again only when it was replaced. Every pass step that replaces a statement
// after the facts exist does so through edp_mf_set_stmt; review_lint.vibex
// rejects a raw `Array::set(stmts, ..)` in the files that hold those steps.

let edp_mf_dirty: Array[Int] = []

/// Replace a statement, marking it for the evidence pass's statement facts.
export fn edp_mf_set_stmt(stmts: Array[Stmt], i: Int, stmt: Stmt) -> Unit {
  Array::set(stmts, at = i, value = stmt)
  Array::push(edp_mf_dirty, value = i)
}

/// Statements replaced since the last edp_mf_dirty_reset, in write order.
export fn edp_mf_dirty_indices() -> Array[Int] {
  Array::concat(edp_mf_dirty, [])
}

export fn edp_mf_dirty_reset() -> Unit {
  Array::truncate(edp_mf_dirty, length = 0)
}
