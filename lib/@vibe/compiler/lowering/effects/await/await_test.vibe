import @vibe/compiler/core {
  Expr, Stmt
}
import @vibe/compiler/lowering/effects/await {
  await_poll_pass
}

test "ready futures lower without adding poll helpers" {
  let ready = ECall(EIdent("Future::ready", 1), [EInt(42)], 2)
  let stmts = [SExpr(ECall(EIdent("await", 3), [ready], 4))]
  await_poll_pass(stmts, false, false)
  inspect(Array::length(stmts), content = "1")
  inspect(match Array::get(stmts, 0) {
    SExpr(EInt(v)) => v,
    _ => -1
  }, content = "42")
}
