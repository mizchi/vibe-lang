import @vibe/ast {
  builtin_ref, is_builtin_ref_offset
}

import @vibe/compiler/core {
  Expr, Pat, Stmt, TypeExpr
}

import @vibe/core {
  array_empty
}

fn array_empty_str() -> Array[String] {
  Array::slice([""], 0, 0)
}

//# await の poll-wait 展開 (#1230, ADR-0068 / docs/internal/design/wasi-p3-async.md M1b-3c)

/// #1230: expand `await(f)` into the suspend-and-retry loop that a PENDING
/// future needs, before any of the effect passes run.
///
/// `Future[T]` is the two-element `[state, payload]` array
/// (compile_call.vibe's `future_ready_expr`); state 0 is ready. `await` used
/// to be lowered in compile_call, which emits wasm directly -- far too late
/// for the `perform Async::Suspend(..)` a pending future has to raise, since
/// suspend_cps_pass and evidence_dict_pass have both already run by then.
/// Doing it here, right after desugar_trait_dicts (which is what produces the
/// `await(..)` calls of an async-iterator `for` loop) and before rewrite_self_tail_calls,
/// puts the perform on the ordinary AST where those passes see it like any
/// hand-written one.
///
/// The shape is the one `@vibe/concurrent`'s own blocking helpers use
/// (`Receiver::recv_wait`: re-check, `perform Async::Suspend(1)`, re-check):
///
/// ```text
/// let __aw_f_N = <future>
/// while 0 < Array::get(__aw_f_N, 0) {
///   let __aw_w_N = perform Async::Suspend(1)
///   ()
/// }
/// Array::get(__aw_f_N, 1)
/// ```
///
/// 1 is the poll-wait reason (concurrent.vibe's payload convention: 0 =
/// cooperative yield, 1 = poll wait, negative = sleep debt), so a driver that
/// parks the continuation re-runs it and the loop re-reads the state slot --
/// the producer resolves a future by writing slot 1 and clearing slot 0.
///
/// Every future in the tree today is created ready, so the loop is not entered
/// at runtime; what this buys is that `await` is now CORRECT for a pending
/// future, leaving "add a producer" as the only remaining step rather than
/// "add a producer AND rework await under the effect passes".
///
/// `await(Future::ready(x))` collapses to `x` outright: the ready-future fast
/// path the spec calls for, and it keeps the common case free of both the
/// array and the loop.
export fn await_poll_pass(stmts: Array[Stmt], host_future: Bool, waiter_hooks: Bool, cell_note: String) -> Unit {
  // A user-defined top-level `await` shadows the builtin; leave those calls
  // alone (compile_call applies the same rule via `prefer_bound_call`).
  // #3163: so does a LOCAL one -- a parameter, a `let`, a lambda parameter, a
  // loop or pattern binder named `await` -- and a user-defined top-level
  // `Future::ready` is not the builtin whose payload the fast path reads.
  // Both used to be decided by spelling alone, so a function handed in as
  // `await` was replaced by the builtin (`let s: String = await(..)` read the
  // future's Int as a String) and `await(Future::ready(5))` answered 5 past a
  // user `Future::ready` that resolves to something else. The walk carries
  // which of the two names are shadowed (`sh`, see `awp_bind`).
  //
  // `host_future` (ADR-0089 step 4, #1218): the caller's "program calls
  // host_future_get" key -- selects the waitable-aware __aw_poll form (see
  // awp_poll_fn_def). Passed in rather than scanned here so the deep
  // call-scan lives once, next to the boundary machinery's other keys
  // (linked_compile's lc_expr_calls_host_future).
  //
  // `waiter_hooks` (ADR-0089 #1218, resolve -> direct wake): the program
  // can call `__aw_wait` / `__aw_notify_resolve` (@vibe/concurrent's
  // direct-wake hooks -- linked imports or local defs). __aw_poll then
  // routes each poll round through `__aw_wait` (register as waiter +
  // suspend) instead of a bare perform, and compile_call appends the
  // notify to every Future::resolve lowering, so in-task awaiters of a
  // pending future are woken by the resolve instead of re-polled every
  // pump round. host_future takes precedence: the waitable form needs its
  // own payload protocol, and host-future programs are entry-boundary
  // driven (no in-guest scheduler to direct-wake).
  //
  // `cell_note` (#1537): the name @vibe/concurrent's `__aw_note` has in this
  // program ("" when it cannot call it; a merged program spells a dependency's
  // export with its module suffix). `__aw_pay` hands it the cell it is about
  // to park on, so a release of that read can poison the cell (see
  // awp_pay_fn_def).
  //
  // #3198 review: a program's own top-level `await` no longer skips the pass.
  // It shadows every `await` the program WROTE (the `await` bit starts set),
  // but an `await` the compiler synthesized -- the async `for` desugar's
  // `await(C::next(..))` -- is `builtin_ref("await")` and always means the
  // builtin, whatever the program binds under that name.
  {
    let ctr = [0]
    let await_sh = if awp_program_defines_await(stmts) {
      awp_await_bound_bit()
    } else {
      0
    }
    let sh = if awp_program_defines(stmts, "Future::ready") {
      await_sh|awp_ready_shadowed_bit()
    } else {
      await_sh
    }
    let mut i = 0
    while i < Array::length(stmts) {
      match Array::get(stmts, i) {
        SLet(ex, isrec, nm, ty, expr) => {
          Array::set(stmts, i, SLet(ex, isrec, nm, ty, awp_tail(expr, ctr, sh)))
        },
        SLetMut(nm, ty, expr) => {
          Array::set(stmts, i, SLetMut(nm, ty, awp_tail(expr, ctr, sh)))
        },
        SExpr(expr) => {
          Array::set(stmts, i, SExpr(awp_tail(expr, ctr, sh)))
        },
        STest(nm, expr) => {
          Array::set(stmts, i, STest(nm, awp_tail(expr, ctr, sh)))
        },
        SBench(nm, expr) => {
          Array::set(stmts, i, SBench(nm, awp_tail(expr, ctr, sh)))
        },
        _ => ()
      }
      i = i + 1
    }
    // ADR-0089 D1 increment 4 (#1218): the poll loop lives in a synthesized
    // NAMED top-level fn, injected once per program iff some await actually
    // expanded (ctr counts expansions; the ready-future fast path leaves it
    // untouched). See awp_wrap for why the call-shape matters.
    if Array::get(ctr, 0) > 0 {
      Array::push(stmts, awp_poll_fn_def(host_future, waiter_hooks))
      if host_future {
        Array::push(stmts, awp_pay_fn_def(cell_note))
        Array::push(stmts, awp_settle_fn_def())
      } else {
        ()
      }
    } else {
      ()
    }
  }
}

/// The synthesized `__aw_poll(fut) -> Int with Async` definition:
///
/// ```text
/// while 0 < Array::get(fut, 0) {
///   let __aw_w = perform Async::Suspend(1)
///   ()
/// }
/// Array::get(fut, 1)
/// ```
///
/// ADR-0089 step 4 (#1218): when the program calls `host_future_get`
/// (`host_future` true), the loop instead computes the suspend payload per
/// iteration and settles the cell from the resume value:
///
/// ```text
/// while 0 < Array::get(fut, 0) {
///   let __aw_p = __aw_pay(fut)                  // 1, or handle + 2 (waitable)
///   let __aw_w = perform Async::Suspend(__aw_p)
///   let __aw_s = __aw_settle(fut, __aw_w)       // waitable: cell <- resumed value
///   ()
/// }
/// Array::get(fut, 1)
/// ```
///
/// The helpers are synthesized row-free top-level fns (awp_pay_fn_def /
/// awp_settle_fn_def) so the loop spine stays a let-chain of
/// effect-free-fn calls around the perform -- the shape the suspend CPS
/// split accepts. The non-host-future form is kept byte-identical for
/// every program that never touches `host_future_get`.
///
/// `waiter_hooks` (resolve -> direct wake, ADR-0089 #1218): route the
/// round through the library's `__aw_wait(fut)` -- an IMPORTED (or local)
/// concrete-Async-row named fn, the same callee shape as recv_wait, so
/// both the suspend CPS split and the evidence migration accept it
/// (measured via a hand-written mimic before wiring):
///
/// ```text
/// while 0 < Array::get(fut, 0) {
///   let __aw_w = __aw_wait(fut)     // register as waiter + Suspend(1)
///   ()
/// }
/// Array::get(fut, 1)
/// ```
fn awp_poll_fn_def(host_future: Bool, waiter_hooks: Bool) -> Stmt {
  let fut = EIdent("__aw_fut", -1)
  let state = ECall(builtin_ref("Array::get"), [fut, EInt(0)], -1)
  // EBinOp("<"), NOT the `lt` builtin the old inline expansion used: the
  // evidence migration's see-through scan does not know `lt` as a pure
  // callee, so a `while lt(...)` condition makes this fn -- and therefore
  // every handle whose body awaits -- ineligible (measured: reduced case
  // v9 REJECTED with `lt`, identical fn with `<` compiles and runs).
  let pending = EBinOp("<", EInt(0), state, -1)
  let payload = ECall(builtin_ref("Array::get"), [fut, EInt(1)], -1)
  let loop_body = if host_future {
    let suspend = ECall(EIdent("perform", -1), [
      ECall(EIdent("Async::Suspend", -1), [EIdent("__aw_p", -1)], -1)
    ], -1)
    let pay = ECall(EIdent("__aw_pay", -1), [fut], -1)
    let settle = ECall(EIdent("__aw_settle", -1), [fut, EIdent("__aw_w", -1)], -1)
    ELet("__aw_p", pay, ELet("__aw_w", suspend, ELet("__aw_s", settle, EUnit, -1), -1), -1)
  } else if waiter_hooks {
    let wait_call = ECall(EIdent("__aw_wait", -1), [fut], -1)
    ELet("__aw_w", wait_call, EUnit, -1)
  } else {
    let suspend = ECall(EIdent("perform", -1), [
      ECall(EIdent("Async::Suspend", -1), [EInt(1)], -1)
    ], -1)
    ELet("__aw_w", suspend, EUnit, -1)
  }
  let body = ESeq(EWhile(pending, loop_body), payload)
  let params: Array[(String, Option[TypeExpr])] = [("__aw_fut", None)]
  SLet(false, false, "__aw_poll", None, EFn(array_empty_str(), array_empty(), params, None, Some("Async"), body))
}

/// `__aw_pay(f) -> Int`: the suspend payload for one poll round. A waitable
/// cell (state 2, ADR-0089 step 4) parks with `handle + 2` -- the reserved
/// waitable band (0 = yield, 1 = poll wait, negative = sleep debt; the +2
/// keeps even handle 0/1 out of the low reasons). Anything else is the
/// plain poll-wait retry.
fn awp_pay_fn_def(cell_note: String) -> Stmt {
  let f = EIdent("__awp_f", -1)
  let state = ECall(builtin_ref("Array::get"), [f, EInt(0)], -1)
  // `hnd`, not `handle` -- `handle` is the effect-handler keyword.
  let hnd = ECall(builtin_ref("Array::get"), [f, EInt(1)], -1)
  let pay = EIf(EBinOp("==", state, EInt(2), -1), EBinOp("+", hnd, EInt(2), -1), EInt(1))
  // #1537 (Codex on #3091): state 9 is a cell whose host read was released
  // -- its last waiter was cancelled, or (#3131) it went unawaited while
  // every WIT result slot filled and its slot was reclaimed. Its handle may
  // since name another call's result, so the await refuses rather than read
  // it.
  let poisoned = ESeq(ECall(EIdent("abort", -1), [
    EString("vibe: await on a host future whose read was released (its waiter was cancelled, or 512 later calls reclaimed it unawaited)", -1)
  ], -1), EInt(1))
  let checked = EIf(EBinOp("==", state, EInt(9), -1), poisoned, pay)
  let body = if cell_note != "" {
    ELet("__awp_n", ECall(EIdent(cell_note, -1), [f], -1), checked, -1)
  } else {
    checked
  }
  let params: Array[(String, Option[TypeExpr])] = [("__awp_f", None)]
  SLet(false, false, "__aw_pay", None, EFn(array_empty_str(), array_empty(), params, None, None, body))
}

/// `__aw_settle(f, v) -> Int`: after a waitable park resumes, `v` is the
/// value the boundary read from the host future -- write it into the cell
/// (payload first, then state, the Future::resolve ordering) so the poll
/// loop observes readiness. Poll-wait rounds (state != 2) ignore `v`.
fn awp_settle_fn_def() -> Stmt {
  let f = EIdent("__aws_f", -1)
  let state = ECall(builtin_ref("Array::get"), [f, EInt(0)], -1)
  let set_payload = ECall(builtin_ref("Array::set"), [
    f,
    EInt(1),
    EIdent("__aws_v", -1)
  ], -1)
  let set_state = ECall(builtin_ref("Array::set"), [f, EInt(0), EInt(0)], -1)
  let body = EIf(EBinOp("==", state, EInt(2), -1), ESeq(set_payload, ESeq(set_state, EInt(0))), EInt(0))
  let params: Array[(String, Option[TypeExpr])] = [
    ("__aws_f", None),
    ("__aws_v", None)
  ]
  SLet(false, false, "__aw_settle", None, EFn(array_empty_str(), array_empty(), params, None, None, body))
}

fn awp_program_defines_await(stmts: Array[Stmt]) -> Bool {
  awp_program_defines(stmts, "await")
}

fn awp_program_defines(stmts: Array[Stmt], name: String) -> Bool {
  let mut found = false
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SLet(_, _, nm, _, _) => if nm == name {
        found = true
      } else {
        ()
      },
      SLetMut(nm, _, _) => if nm == name {
        found = true
      } else {
        ()
      },
      SExternLet(nm, _) => if nm == name {
        found = true
      } else {
        ()
      },
      _ => ()
    }
    i = i + 1
  }
  found
}

/// #1230: pull every unconditionally-evaluated `await` out of `e` into
/// `binds`, replacing each with a fresh identifier.
///
/// The expansion must NOT be spliced in where the await stood. It is a
/// `let`/`while`/read sequence, and vibe has no block expression, so
/// `let a = await(..)` would produce `ELet(a, ELet(f, .., ESeq(EWhile(..),
/// ..)), ..)` -- a shape no source program can write and, with two of them in
/// one function, one the downstream passes do not converge on (the compiler
/// itself recursed without bound). Hoisting instead keeps every synthesized
/// node on the ordinary let/seq spine, which is exactly the discipline
/// scps_split_tail already follows for the same reason.
///
/// Only positions that are evaluated unconditionally and in order are lifted.
/// A branch, a loop body, a closure body, or a nested spine is left to its
/// OWN spine rewrite (awp_rewrite), so an await under a condition never
/// escapes ahead of it.
fn awp_lift(e: Expr, ctr: Array[Int], binds: Array[(String, Expr, String)], sh: Int) -> Expr {
  match e {
    ECall(callee, args, off) => {
      let callee_nm = match callee {
        EIdent(cn, _) => cn,
        _ => ""
      }
      let synthesized = match callee {
        EIdent(_, coff) => is_builtin_ref_offset(coff),
        _ => false
      }
      if callee_nm == "await" && Array::length(args) == 1 && (synthesized || !awp_await_bound(sh)) {
        let inner = awp_lift(Array::get(args, 0), ctr, binds, sh)
        match awp_ready_payload(inner, sh) {
          Some(payload) => payload,
          None => {
            let n = Array::get(ctr, 0)
            Array::set(ctr, 0, n + 1)
            let fname = String::concat("__aw_f_", Int::to_string(n))
            let vname = String::concat("__aw_v_", Int::to_string(n))
            Array::push(binds, (fname, inner, vname))
            EIdent(vname, -1)
          }
        }
      } else {
        let new_callee = if callee_nm == "" {
          awp_lift(callee, ctr, binds, sh)
        } else {
          callee
        }
        ECall(new_callee, awp_lift_exprs(args, ctr, binds, sh), off)
      }
    },
    EBinOp(op, l, r, boff) => EBinOp(op, awp_lift(l, ctr, binds, sh), awp_lift(r, ctr, binds, sh), boff),
    EUnaryOp(op, x) => EUnaryOp(op, awp_lift(x, ctr, binds, sh)),
    EDot(o, f, o1, o2) => EDot(awp_lift(o, ctr, binds, sh), f, o1, o2),
    ELabeledArg(l, n, v) => ELabeledArg(l, n, awp_lift(v, ctr, binds, sh)),
    ETuple(items) => ETuple(awp_lift_exprs(items, ctr, binds, sh)),
    EArray(items) => EArray(awp_lift_exprs(items, ctr, binds, sh)),
    ESpread(x) => ESpread(awp_lift(x, ctr, binds, sh)),
    ERecord(n, fields, tas) => ERecord(n, awp_lift_pairs(fields, ctr, binds, sh), tas),
    EMap(fields) => EMap(awp_lift_pairs(fields, ctr, binds, sh)),
    // Everything else is either conditional, a loop, a closure, or a spine of
    // its own: hand it to awp_rewrite so its awaits are hoisted THERE.
    _ => awp_rewrite(e, ctr, sh)
  }
}

fn awp_lift_exprs(es: Array[Expr], ctr: Array[Int], binds: Array[(String, Expr, String)], sh: Int) -> Array[Expr] {
  for x in es {
    awp_lift(x, ctr, binds, sh)
  }
}

fn awp_lift_pairs(pairs: Array[(String, Expr)], ctr: Array[Int], binds: Array[(String, Expr, String)], sh: Int) -> Array[(String, Expr)] {
  for p in pairs {
    let (n, v) = p
    (n, awp_lift(v, ctr, binds, sh))
  }
}

/// Wrap `inner` in one suspend-and-retry block per lifted await, innermost
/// last so the bindings evaluate in source order:
///
/// ```text
/// let __aw_f_N = <future>
/// while 0 < Array::get(__aw_f_N, 0) {
///   let __aw_w_N = perform Async::Suspend(1)
///   ()
/// }
/// let __aw_v_N = Array::get(__aw_f_N, 1)
/// <inner>
/// ```
fn awp_wrap(binds: Array[(String, Expr, String)], inner: Expr) -> Expr {
  // ADR-0089 D1 increment 4 (#1218): the poll loop is a CALL to the
  // synthesized named `__aw_poll` (see awp_poll_fn_def), not an inline
  // `while`. The shapes are semantically identical, but only the call is
  // visible to the TAIL-RESUMPTIVE evidence migration -- a
  // `handle ... with Async` body may contain "direct performs, calls to
  // named top-level functions, or row-annotated closure literals", and an
  // inline loop-wrapped perform is none of those (measured: the
  // await-discharge fixture was rejected with "not eligible for
  // evidence-passing migration" until this changed). This is the same
  // asymmetry increment 1 solved for `sleep` by injecting `__slp_perform`;
  // the suspend-class path is indifferent (a needing-fn call on the spine
  // vs an inline loop both split), so the named form serves both.
  let mut out = inner
  let mut i = Array::length(binds) - 1
  while i >= 0 {
    let (fname, fut, vname) = Array::get(binds, i)
    let poll = ECall(EIdent("__aw_poll", -1), [EIdent(fname, -1)], -1)
    out = ELet(fname, fut, ELet(vname, poll, out, -1), -1)
    i = i - 1
  }
  out
}

/// Rewrite an expression in a SPINE position, hoisting the awaits of its
/// unconditional sub-expression in front of it.
fn awp_spine(e: Expr, ctr: Array[Int], rebuild_is_tail: Bool, sh: Int) -> Expr {
  let _ = rebuild_is_tail
  let binds = array_empty()
  let lifted = awp_lift(e, ctr, binds, sh)
  awp_wrap(binds, lifted)
}

/// `Future::ready(x)` awaited immediately is just `x` -- no array, no loop.
fn awp_ready_payload(fut: Expr, sh: Int) -> Option[Expr] {
  match fut {
    ECall(callee, args, _) => match callee {
      EIdent(nm, _) => if nm == "Future::ready" && Array::length(args) == 1 && !awp_ready_user_defined(sh) {
        Some(Array::get(args, 0))
      } else {
        None
      },
      _ => None
    },
    _ => None
  }
}

/// A spine node's own rewrite: recurse structurally, hoisting the awaits of
/// each unconditionally-evaluated slot in front of that slot's construct.
/// Anything that is NOT a spine node is returned untouched -- awp_tail is the
/// entry that lifts a bare tail expression, and keeping the two fallbacks
/// disjoint is what makes the mutual recursion terminate.
fn awp_rewrite(e: Expr, ctr: Array[Int], sh: Int) -> Expr {
  match e {
    ELet(n, v, b, off) => {
      let binds = array_empty()
      let v2 = awp_lift(v, ctr, binds, sh)
      awp_wrap(binds, ELet(n, v2, awp_tail(b, ctr, awp_bind(sh, n)), off))
    },
    ELetMut(n, v, b, off) => {
      let binds = array_empty()
      let v2 = awp_lift(v, ctr, binds, sh)
      awp_wrap(binds, ELetMut(n, v2, awp_tail(b, ctr, awp_bind(sh, n)), off))
    },
    ELetRec(n, v, b) => {
      let inner = awp_bind(sh, n)
      ELetRec(n, awp_tail(v, ctr, inner), awp_tail(b, ctr, inner))
    },
    ESeq(a, b) => {
      let binds = array_empty()
      let a2 = awp_lift(a, ctr, binds, sh)
      awp_wrap(binds, ESeq(a2, awp_tail(b, ctr, sh)))
    },
    EAssign(n, v, c) => {
      let binds = array_empty()
      let v2 = awp_lift(v, ctr, binds, sh)
      awp_wrap(binds, EAssign(n, v2, awp_tail(c, ctr, sh)))
    },
    EAssignOp(n, op, v, c) => {
      let binds = array_empty()
      let v2 = awp_lift(v, ctr, binds, sh)
      awp_wrap(binds, EAssignOp(n, op, v2, awp_tail(c, ctr, sh)))
    },
    EIf(c, t, el) => {
      let binds = array_empty()
      let c2 = awp_lift(c, ctr, binds, sh)
      awp_wrap(binds, EIf(c2, awp_tail(t, ctr, sh), awp_tail(el, ctr, sh)))
    },
    EMatch(sc, arms) => {
      let binds = array_empty()
      let sc2 = awp_lift(sc, ctr, binds, sh)
      awp_wrap(binds, EMatch(sc2, awp_rewrite_arms(arms, ctr, sh)))
    },
    // A loop condition is re-evaluated every iteration, so nothing can be
    // hoisted out of it; both parts get their own spine instead.
    EWhile(c, b) => EWhile(awp_tail(c, ctr, sh), awp_tail(b, ctr, sh)),
    EForIn(n, idx, it, b) => {
      let binds = array_empty()
      let it2 = awp_lift(it, ctr, binds, sh)
      let body_sh = match idx {
        Some(ix) => awp_bind(awp_bind(sh, n), ix),
        None => awp_bind(sh, n)
      }
      awp_wrap(binds, EForIn(n, idx, it2, awp_tail(b, ctr, body_sh)))
    },
    ELoop(pairs, b) => ELoop(awp_rewrite_pairs(pairs, ctr, sh), awp_tail(b, ctr, awp_bind_pairs(sh, pairs))),
    EFn(tps, tbs, params, ret, eff, b) => EFn(tps, tbs, params, ret, eff, awp_tail(b, ctr, awp_bind_params(sh, params))),
    EHandle(b, arms) => EHandle(awp_tail(b, ctr, sh), awp_rewrite_arms(arms, ctr, sh)),
    EReturn(x) => {
      let binds = array_empty()
      let x2 = awp_lift(x, ctr, binds, sh)
      awp_wrap(binds, EReturn(x2))
    },
    EBreak(opt) => match opt {
      Some(x) => {
        let binds = array_empty()
        let x2 = awp_lift(x, ctr, binds, sh)
        awp_wrap(binds, EBreak(Some(x2)))
      },
      None => e
    },
    EContinue(args) => {
      let binds = array_empty()
      let args2 = awp_lift_exprs(args, ctr, binds, sh)
      awp_wrap(binds, EContinue(args2))
    },
    _ => e
  }
}

/// A TAIL (or statement) position: a spine node recurses structurally, and
/// anything else is a value whose awaits are hoisted in front of it.
fn awp_tail(e: Expr, ctr: Array[Int], sh: Int) -> Expr {
  match e {
    ELet(_, _, _, _) => awp_rewrite(e, ctr, sh),
    ELetMut(_, _, _, _) => awp_rewrite(e, ctr, sh),
    ELetRec(_, _, _) => awp_rewrite(e, ctr, sh),
    ESeq(_, _) => awp_rewrite(e, ctr, sh),
    EAssign(_, _, _) => awp_rewrite(e, ctr, sh),
    EAssignOp(_, _, _, _) => awp_rewrite(e, ctr, sh),
    EIf(_, _, _) => awp_rewrite(e, ctr, sh),
    EMatch(_, _) => awp_rewrite(e, ctr, sh),
    EWhile(_, _) => awp_rewrite(e, ctr, sh),
    EForIn(_, _, _, _) => awp_rewrite(e, ctr, sh),
    ELoop(_, _) => awp_rewrite(e, ctr, sh),
    EFn(_, _, _, _, _, _) => awp_rewrite(e, ctr, sh),
    EHandle(_, _) => awp_rewrite(e, ctr, sh),
    EReturn(_) => awp_rewrite(e, ctr, sh),
    EBreak(_) => awp_rewrite(e, ctr, sh),
    EContinue(_) => awp_rewrite(e, ctr, sh),
    _ => awp_spine(e, ctr, true, sh)
  }
}

fn awp_rewrite_pairs(pairs: Array[(String, Expr)], ctr: Array[Int], sh: Int) -> Array[(String, Expr)] {
  for p in pairs {
    let (n, v) = p
    (n, awp_tail(v, ctr, sh))
  }
}

fn awp_rewrite_arms(arms: Array[(Pat, Expr)], ctr: Array[Int], sh: Int) -> Array[(Pat, Expr)] {
  for a in arms {
    let (p, ex) = a
    (p, awp_tail(ex, ctr, awp_bind_pat(sh, p)))
  }
}

//# Which builtin spellings are shadowed where the walk stands (#3163)

/// Bit of `sh`: a binder named `await` is in scope, so `await(..)` calls that
/// binding and is not the builtin.
fn awp_await_bound_bit() -> Int {
  1
}

/// Bit of `sh`: the program declares its own top-level `Future::ready`, so
/// `await(Future::ready(x))` is not the ready-future fast path.
fn awp_ready_shadowed_bit() -> Int {
  2
}

fn awp_await_bound(sh: Int) -> Bool {
  (sh&awp_await_bound_bit()) != 0
}

fn awp_ready_user_defined(sh: Int) -> Bool {
  (sh&awp_ready_shadowed_bit()) != 0
}

/// `sh` inside the scope of a binder named `name`.
fn awp_bind(sh: Int, name: String) -> Int {
  if name == "await" {
    sh|awp_await_bound_bit()
  } else {
    sh
  }
}

fn awp_bind_params(sh: Int, params: Array[(String, Option[TypeExpr])]) -> Int {
  let mut out = sh
  let mut i = 0
  while i < Array::length(params) {
    let (n, _) = Array::get(params, i)
    let ln = String::length(n)
    let base = if ln > 0 && (n[ln - 1: ln] == "~" || n[ln - 1: ln] == "?") {
      n[0: ln - 1]
    } else {
      n
    }
    out = awp_bind(out, base)
    i = i + 1
  }
  out
}

fn awp_bind_pairs(sh: Int, pairs: Array[(String, Expr)]) -> Int {
  let mut out = sh
  let mut i = 0
  while i < Array::length(pairs) {
    let (n, _) = Array::get(pairs, i)
    out = awp_bind(out, n)
    i = i + 1
  }
  out
}

fn awp_bind_pat(sh: Int, p: Pat) -> Int {
  if awp_pat_binds_await(p) {
    sh|awp_await_bound_bit()
  } else {
    sh
  }
}

fn awp_pat_binds_await(p: Pat) -> Bool {
  match p {
    PBind(n) => n == "await",
    PCtor(_, subs) => awp_pats_bind_await(subs),
    PTuple(subs) => awp_pats_bind_await(subs),
    POr(l, r) => awp_pat_binds_await(l) || awp_pat_binds_await(r),
    PStruct(_, fields) => {
      let mut found = false
      let mut i = 0
      while i < Array::length(fields) {
        let (_, fp) = Array::get(fields, i)
        if awp_pat_binds_await(fp) {
          found = true
        } else {
          ()
        }
        i = i + 1
      }
      found
    },
    _ => false
  }
}

fn awp_pats_bind_await(ps: Array[Pat]) -> Bool {
  let mut found = false
  let mut i = 0
  while i < Array::length(ps) {
    if awp_pat_binds_await(Array::get(ps, i)) {
      found = true
    } else {
      ()
    }
    i = i + 1
  }
  found
}
