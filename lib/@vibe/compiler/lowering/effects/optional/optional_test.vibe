import @vibe/compiler/core {
  Expr, Stmt
}
import @vibe/compiler/lowering/effects/optional {
  lower_optional_performs
}
import @vibe/parser {
  print_expr
}

test "denied optional calls erase their argument preparation"allows Exception {
  let call = ECall(EIdent("perform?", 0), [
    ECall(EIdent("Fs::read_file", 1), [ECall(EIdent("prepare_path", 2), [], 3)], 4)
  ], 5)
  let stmts = [SExpr(call)]
  lower_optional_performs(stmts, [])
  inspect(match Array::get(stmts, 0) {
    SExpr(e) => print_expr(e),
    _ => "unexpected"
  }, content = "$vibe_attempt_not_granted")
}
