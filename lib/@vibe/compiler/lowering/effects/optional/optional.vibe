import @vibe/compiler/core {
  EffectOwner, Expr, Pat, Stmt, expr_any_node, lookup_registry_builtin, program_declares_extern_effect, program_extern_effect_names
}

import @vibe/core {
  array_empty
}

/// #2236 / ADR-0088: lower optional capability calls against one frozen
/// resolution table. Missing entries use the non-interactive default,
/// `NotGranted`. A denied call is erased before its arguments are visited, so
/// preparing an operation that will not run cannot itself trigger effects.
fn opq_provider_name(_ operation: String) -> String {
  let sep = String::index_of(operation, needle = "::")
  if sep < 0 {
    operation
  } else {
    String::substring(operation, start = 0, end = sep)
  }
}

fn opq_attempt_not_granted_name() -> String {
  "$vibe_attempt_not_granted"
}

fn opq_attempt_errored_name() -> String {
  "$vibe_attempt_errored"
}

fn opq_attempt_granted_name() -> String {
  "$vibe_attempt_granted"
}

fn opq_collect_source_value_names(stmts: Array[Stmt], names: Array[String]) -> Unit {
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, at = i) {
      SLet(_, _, name, _, _) => Array::push(names, value = name),
      SLetMut(name, _, _) => Array::push(names, value = name),
      // ADR-0124 (#4082): an `extern effect` not bound yet (the whole-program
      // route lowers `perform?` before `bind_extern_effects`). The space keeps
      // the entry from matching any source name.
      SEffectDef(_, name, _, _, HostProvided) => Array::push(names, value = opq_extern_effect_entry(name)),
      SModule(_, _, body) => opq_collect_source_value_names(stmts = body, names = names),
      _ => ()
    }
    i = i + 1
  }
}

fn opq_source_value_exists(names: Array[String], name: String) -> Bool {
  let mut found = false
  let mut i = 0
  while i < Array::length(names) && !found {
    found = Array::get(names, at = i) == name
    i = i + 1
  }
  found
}

fn opq_extern_effect_entry(_ effect: String) -> String {
  String::concat("extern effect ", effect)
}

/// ADR-0124 (#4082): whether `operation` belongs to an `extern effect`, the
/// one kind of source declaration `perform?` reaches: its grade is granted by
/// a provider bound at launch. The declaration is in `source_names` until
/// `bind_extern_effects` replaces it with bindings, and recorded by that pass
/// after.
fn opq_is_extern_operation(source_names: Array[String], operation: String) -> Bool {
  let provider = opq_provider_name(operation)
  provider != operation && (program_declares_extern_effect(provider) || opq_source_value_exists(names = source_names, name = opq_extern_effect_entry(provider)))
}

/// Spelling alone is not builtin provenance: a source declaration may shadow
/// a registry operation with the same qualified name. The checker accepts the
/// source call, so fail here before a denied branch can erase it or a granted
/// branch can wrap it as an optional capability result.
fn opq_require_registry_operation(source_names: Array[String], operation: String) -> Unit with Exception {
  if opq_is_extern_operation(source_names = source_names, operation = operation) {
    ()
  } else {
    opq_require_builtin_operation(source_names = source_names, operation = operation)
  }
}

fn opq_require_builtin_operation(source_names: Array[String], operation: String) -> Unit with Exception {
  let registered = match lookup_registry_builtin(operation) {
    Some(_) => true,
    None => false
  }
  if registered {
    if opq_source_value_exists(names = source_names, name = operation) {
      throw(String::concat("`perform? ", String::concat(operation, "(..)` resolves to a source function, not a capability operation; rename the source function or call the capability under an unshadowed name")))
    } else {
      ()
    }
  } else {
    throw(String::concat("`perform? ", String::concat(operation, "(..)` is not a registered capability operation")))
  }
}

fn opq_resolution(resolution: Array[(String, String)], operation: String) -> String with Exception {
  let provider = opq_provider_name(operation)
  let mut default_status = "NotGranted"
  let mut provider_status = ""
  let mut exact_status = ""
  let mut i = 0
  while i < Array::length(resolution) {
    let (name, status) = Array::get(resolution, at = i)
    if status != "Granted" && status != "NotGranted" {
      throw(String::concat("optional capability resolution for `", String::concat(name, String::concat("` must be `Granted` or `NotGranted`, got `", String::concat(status, "`")))))
    } else if name == "*" {
      default_status = status
    } else if name == operation {
      exact_status = status
    } else if name == provider {
      provider_status = status
    } else {
      ()
    }
    i = i + 1
  }
  if exact_status != "" {
    exact_status
  } else if provider_status != "" {
    provider_status
  } else {
    default_status
  }
}

fn opq_contains_source_test_like(_ stmts: Array[Stmt]) -> Bool {
  let mut found = false
  let mut i = 0
  while i < Array::length(stmts) && !found {
    found = match Array::get(stmts, at = i) {
      STest(_, _) => true,
      SBench(_, _) => true,
      SExample(_, _) => true,
      SModule(_, _, body) => opq_contains_source_test_like(body),
      _ => false
    }
    i = i + 1
  }
  found
}

/// Resolve authority once for the whole compiled artifact. A `__no_entry__`
/// artifact containing test-like blocks has ambient full authority over the
/// standard providers, including every top-level helper those blocks can
/// reach. An `extern effect` is the exception (#4082): its grant is a bound
/// provider, so a test artifact grants it only through the caller's table --
/// the rows `vibe test --provide` adds -- and answers `NotGranted` otherwise,
/// rather than importing an operation no runner can link. Other
/// non-interactive artifacts keep the caller's fail-closed resolution table.
/// The GC source pipeline passes `generated_test_artifact = true` from the
/// actual STest / SBench lowering result; user-controlled `__test_` names
/// carry no authority.
export fn optional_perform_artifact_resolution(stmts: Array[Stmt], entry_name: String, generated_test_artifact: Bool, resolution: Array[(String, String)]) -> Array[(String, String)] {
  let source_test_artifact = entry_name == "__no_entry__" && opq_contains_source_test_like(stmts)
  let gc_lowered_test_artifact = entry_name == "_start" && generated_test_artifact
  if source_test_artifact || gc_lowered_test_artifact {
    // `opq_resolution` reads the last matching row, so the caller's grants
    // come after the extern effects' denials.
    let out: Array[(String, String)] = [("*", "Granted")]
    for effect in opq_extern_effect_names(stmts) {
      Array::push(out, value = (effect, "NotGranted"))
    }
    for row in resolution {
      Array::push(out, value = row)
    }
    out
  } else {
    resolution
  }
}

/// Every `extern effect` of the program: the declarations still in `stmts`
/// (the whole-program route resolves before `bind_extern_effects`) and the
/// ones that pass has already bound (the split route).
fn opq_extern_effect_names(_ stmts: Array[Stmt]) -> Array[String] {
  let names: Array[String] = []
  opq_collect_source_value_names(stmts = stmts, names = names)
  let out = program_extern_effect_names()
  let marker = opq_extern_effect_entry("")
  for name in names {
    if String::starts_with(name, prefix = marker) {
      Array::push(out, value = String::substring(name, start = String::length(marker), end = String::length(name)))
    }
  }
  out
}

fn opq_expr_array(items: Array[Expr], resolution: Array[(String, String)], source_names: Array[String]) -> Array[Expr] with Exception {
  for item in items {
    opq_expr(e = item, resolution = resolution, source_names = source_names)
  }
}

fn opq_pairs(items: Array[(String, Expr)], resolution: Array[(String, String)], source_names: Array[String]) -> Array[(String, Expr)] with Exception {
  for item in items {
    let (name, value) = item
    (name, opq_expr(e = value, resolution = resolution, source_names = source_names))
  }
}

fn opq_arms(items: Array[(Pat, Expr)], resolution: Array[(String, String)], source_names: Array[String]) -> Array[(Pat, Expr)] with Exception {
  for item in items {
    let (pat, body) = item
    (pat, opq_expr(e = body, resolution = resolution, source_names = source_names))
  }
}

fn opq_expr(e: Expr, resolution: Array[(String, String)], source_names: Array[String]) -> Expr with Exception {
  match e {
    ECall(EIdent("perform?", _), args, off, callee_resolution) => if Array::length(args) == 1 {
      match Array::get(args, at = 0) {
        ECall(EIdent(operation, op_ident_off), op_args, op_call_off, callee_resolution) => {
          opq_require_registry_operation(source_names = source_names, operation = operation)
          if opq_resolution(resolution = resolution, operation = operation) == "Granted" {
            let error_name = "$vibe_optional_error"
            let call = ECall(EIdent(operation, op_ident_off), opq_expr_array(items = op_args, resolution = resolution, source_names = source_names), op_call_off, callee_resolution)
            EHandle(ECall(EIdent(opq_attempt_granted_name(), off), [call], off, callee_resolution), [
              (PCtor("Exception::Throw", [PBind(error_name)]), ECall(EIdent(opq_attempt_errored_name(), off), [
                EIdent(error_name, off)
              ], off, callee_resolution))
            ])
          } else {
            EIdent(opq_attempt_not_granted_name(), off)
          }
        },
        _ => throw("`perform?` takes a capability-operation call, like `perform? Fs::read_file(path)`")
      }
    } else {
      throw("`perform?` takes exactly one capability-operation call")
    },
    ECall(callee, args, off, callee_resolution) => ECall(opq_expr(e = callee, resolution = resolution, source_names = source_names), opq_expr_array(items = args, resolution = resolution, source_names = source_names), off, callee_resolution),
    ETuple(items) => ETuple(opq_expr_array(items = items, resolution = resolution, source_names = source_names)),
    EArray(items) => EArray(opq_expr_array(items = items, resolution = resolution, source_names = source_names)),
    ERecord(name, fields, targs) => ERecord(name, opq_pairs(items = fields, resolution = resolution, source_names = source_names), targs),
    EIf(cond, then_expr, else_expr) => EIf(opq_expr(e = cond, resolution = resolution, source_names = source_names), opq_expr(e = then_expr, resolution = resolution, source_names = source_names), opq_expr(e = else_expr, resolution = resolution, source_names = source_names)),
    ELet(name, value, body, off) => ELet(name, opq_expr(e = value, resolution = resolution, source_names = source_names), opq_expr(e = body, resolution = resolution, source_names = source_names), off),
    ELetRec(name, value, body) => ELetRec(name, opq_expr(e = value, resolution = resolution, source_names = source_names), opq_expr(e = body, resolution = resolution, source_names = source_names)),
    ELetMut(name, value, body, off) => ELetMut(name, opq_expr(e = value, resolution = resolution, source_names = source_names), opq_expr(e = body, resolution = resolution, source_names = source_names), off),
    EAssign(name, value, body, target_off) => EAssign(name, opq_expr(e = value, resolution = resolution, source_names = source_names), opq_expr(e = body, resolution = resolution, source_names = source_names), target_off),
    EAssignOp(name, op, value, body, target_off) => EAssignOp(name, op, opq_expr(e = value, resolution = resolution, source_names = source_names), opq_expr(e = body, resolution = resolution, source_names = source_names), target_off),
    ESeq(first, second) => ESeq(opq_expr(e = first, resolution = resolution, source_names = source_names), opq_expr(e = second, resolution = resolution, source_names = source_names)),
    EMatch(scrutinee, arms) => EMatch(opq_expr(e = scrutinee, resolution = resolution, source_names = source_names), opq_arms(items = arms, resolution = resolution, source_names = source_names)),
    EHandle(body, arms) => EHandle(opq_expr(e = body, resolution = resolution, source_names = source_names), opq_arms(items = arms, resolution = resolution, source_names = source_names)),
    EWhile(cond, body) => EWhile(opq_expr(e = cond, resolution = resolution, source_names = source_names), opq_expr(e = body, resolution = resolution, source_names = source_names)),
    ELoop(pairs, body) => ELoop(opq_pairs(items = pairs, resolution = resolution, source_names = source_names), opq_expr(e = body, resolution = resolution, source_names = source_names)),
    EForIn(name, index, iterable, body) => EForIn(name, index, opq_expr(e = iterable, resolution = resolution, source_names = source_names), opq_expr(e = body, resolution = resolution, source_names = source_names)),
    EBinOp(op, left, right, boff) => EBinOp(op, opq_expr(e = left, resolution = resolution, source_names = source_names), opq_expr(e = right, resolution = resolution, source_names = source_names), boff),
    EUnaryOp(op, value) => EUnaryOp(op, opq_expr(e = value, resolution = resolution, source_names = source_names)),
    EFn(tparams, bounds, params, ret, eff, body) => EFn(tparams, bounds, params, ret, eff, opq_expr(e = body, resolution = resolution, source_names = source_names)),
    EDot(object, field, start, end) => EDot(opq_expr(e = object, resolution = resolution, source_names = source_names), field, start, end),
    ELabeledArg(kind, name, value) => ELabeledArg(kind, name, opq_expr(e = value, resolution = resolution, source_names = source_names)),
    EReturn(value) => EReturn(opq_expr(e = value, resolution = resolution, source_names = source_names)),
    EBreak(value) => match value {
      Some(inner) => EBreak(Some(opq_expr(e = inner, resolution = resolution, source_names = source_names))),
      None => e
    },
    EContinue(args) => EContinue(opq_expr_array(items = args, resolution = resolution, source_names = source_names)),
    EMap(fields) => EMap(opq_pairs(items = fields, resolution = resolution, source_names = source_names)),
    ESpread(value) => ESpread(opq_expr(e = value, resolution = resolution, source_names = source_names)),
    _ => e
  }
}

export fn lower_optional_performs(stmts: Array[Stmt], resolution: Array[(String, String)]) -> Unit with Exception {
  let source_names = array_empty()
  opq_collect_source_value_names(stmts = stmts, names = source_names)
  lower_optional_performs_with_source_names(stmts = stmts, resolution = resolution, source_names = source_names)
}

/// The source-shadow name set `lower_optional_performs` derives, WITHOUT
/// lowering. #2647 Codex round 4: a `perform?` whose spelling resolves to a
/// SOURCE function rather than a registered capability is rejected, and the
/// set that decides which is which is collected from the statements handed in.
/// A per-module driver holding only the caller sees no imported definition and
/// treats the spelling as a capability -- silently lowering to Granted or
/// NotGranted where the whole program rejects. So the set is collected once on
/// the merged program and handed down, exactly like the resolution itself.
export fn collect_optional_perform_source_names(_ stmts: Array[Stmt]) -> Array[String] {
  let source_names = array_empty()
  opq_collect_source_value_names(stmts = stmts, names = source_names)
  source_names
}

fn opq_is_optional_call(_ e: Expr) -> Bool {
  match e {
    ECall(EIdent("perform?", _), _, _, _) => true,
    _ => false
  }
}

fn opq_entry(e: Expr, resolution: Array[(String, String)], source_names: Array[String]) -> Expr with Exception {
  if expr_any_node(expr = e, pred = opq_is_optional_call) {
    opq_expr(e = e, resolution = resolution, source_names = source_names)
  } else {
    e
  }
}

export fn lower_optional_performs_with_source_names(stmts: Array[Stmt], resolution: Array[(String, String)], source_names: Array[String]) -> Unit with Exception {
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, at = i) {
      SLet(exported, recursive, name, ty, value) => Array::set(stmts, at = i, value = SLet(exported, recursive, name, ty, opq_entry(e = value, resolution = resolution, source_names = source_names))),
      SLetMut(name, ty, value) => Array::set(stmts, at = i, value = SLetMut(name, ty, opq_entry(e = value, resolution = resolution, source_names = source_names))),
      STest(name, body) => Array::set(stmts, at = i, value = STest(name, opq_entry(e = body, resolution = resolution, source_names = source_names))),
      SBench(name, body) => Array::set(stmts, at = i, value = SBench(name, opq_entry(e = body, resolution = resolution, source_names = source_names))),
      SExample(name, body) => Array::set(stmts, at = i, value = SExample(name, opq_entry(e = body, resolution = resolution, source_names = source_names))),
      SExpr(value) => Array::set(stmts, at = i, value = SExpr(opq_entry(e = value, resolution = resolution, source_names = source_names))),
      SLetPat(pat, value) => Array::set(stmts, at = i, value = SLetPat(pat, opq_entry(e = value, resolution = resolution, source_names = source_names))),
      SModule(exported, name, body) => {
        lower_optional_performs_with_source_names(stmts = body, resolution = resolution, source_names = source_names)
        Array::set(stmts, at = i, value = SModule(exported, name, body))
      },
      _ => ()
    }
    i = i + 1
  }
}
