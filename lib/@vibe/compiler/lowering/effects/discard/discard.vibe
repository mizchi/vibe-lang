import @vibe/compiler/core {
  Expr, Pat, Stmt, TypeExpr
}

import @vibe/compiler/lowering/effects/queries {
  EdpReadQuery, edp_rq_fold
}

/// --- #1916: discard-position `for` normalization ------------------------
///
/// A statement-position `for` still compiles as a comprehension: the linear
/// lowering materializes a result array per execution, and the discarded
/// array never gets a drop, so every whole-program walk written with
/// statement `for` loops pays permanent bump-heap growth per node (the
/// #1875 R4 measurement: ~2.1MB per used effect in one such walk alone).
///
/// The codegen fix lives in compile_expr_tail.vibe's ESeq head (a `for`
/// whose value is dropped right after compiles via compile_forin_loop's
/// no-collect form). This pass funnels every OTHER syntactic discard
/// position into that one shape by wrapping the loop as
/// `ESeq(for .., EUnit)`: statement roots (SExpr / test / bench bodies),
/// sequence heads recursively, while bodies, let/assign continuations,
/// if/match tails under a discarded context, and the body tail of a
/// function whose declared return type is Unit. The wrap changes the
/// loop's VALUE from the collected array to `()` -- legal exactly because
/// the context provably discards it (for declared-Unit bodies the checker
/// has already forced the value to Unit).
///
/// Runs at the END of effect_lowering_prelude, after every effect pass:
/// the trait-iterator / pull / HostStream `for` shapes are already
/// rewritten to Unit-valued whiles by then (#1679), so any surviving
/// EForIn is the residual builtin lowering this optimization targets.
/// EHandle stays untouched (conservative -- its arms/body feed the Error
/// handler codegen).
fn fdp_has_forin(_ e: Expr) -> Bool {
  edp_rq_fold(q = RQContainsForIn, e = e) > 0
}

fn fdp_ret_is_unit(_ ret: Option[TypeExpr]) -> Bool {
  match ret {
    Some(TyUnit) => true,
    Some(TyName(n)) => n == "Unit",
    _ => false
  }
}

fn fdp_expr(e: Expr, discard: Bool) -> Expr {
  // Subtrees without any `for` need no wraps: share them instead of
  // rebuilding (the rebuild's own allocation would otherwise rival the
  // churn this pass removes).
  if !fdp_has_forin(e) {
    e
  } else {
    fdp_expr_rebuild(e = e, discard = discard)
  }
}

/// #1923 review (Codex P2): a function body is typically one deep
/// right-nested let/seq spine, so per-node recursion re-scans the remaining
/// tail at every level (O(N^2)) and risks the wasm call stack on generated
/// code (the same hazard check_seq_spine exists for in the checker). Walk
/// the spine iteratively: each head value is gated and processed exactly
/// once, the non-spine tail once, and the nodes are folded back
/// right-to-left.
fn fdp_spine(root: Expr, discard: Bool) -> Expr {
  let parts: Array[Expr] = []
  let mut cur = root
  let mut walking = true
  while walking {
    match cur {
      ESeq(_, b) => {
        Array::push(parts, value = cur)
        cur = b
      },
      ELet(_, _, b, _) => {
        Array::push(parts, value = cur)
        cur = b
      },
      ELetRec(_, _, b) => {
        Array::push(parts, value = cur)
        cur = b
      },
      ELetMut(_, _, b, _) => {
        Array::push(parts, value = cur)
        cur = b
      },
      EAssign(_, _, b, _) => {
        Array::push(parts, value = cur)
        cur = b
      },
      EAssignOp(_, _, _, b, _) => {
        Array::push(parts, value = cur)
        cur = b
      },
      _ => {
        walking = false
      }
    }
  }
  let mut acc = fdp_expr(e = cur, discard = discard)
  let mut i = Array::length(parts) - 1
  while i >= 0 {
    acc = match Array::get(parts, at = i) {
      ESeq(a, _) => ESeq(fdp_expr(e = a, discard = true), acc),
      ELet(n, v, _, off) => ELet(n, fdp_expr(e = v, discard = false), acc, off),
      ELetRec(n, v, _) => ELetRec(n, fdp_expr(e = v, discard = false), acc),
      ELetMut(n, v, _, off) => ELetMut(n, fdp_expr(e = v, discard = false), acc, off),
      EAssign(n, v, _, target_off) => EAssign(n, fdp_expr(e = v, discard = false), acc, target_off),
      EAssignOp(n, op, v, _, target_off) => EAssignOp(n, op, fdp_expr(e = v, discard = false), acc, target_off),
      _ => acc
    }
    i = i - 1
  }
  acc
}

fn fdp_expr_rebuild(e: Expr, discard: Bool) -> Expr {
  match e {
    EForIn(nm, idx, it, b, for_off) => {
      let it2 = fdp_expr(e = it, discard = false)
      if discard {
        // The no-collect form drops the body value each iteration, so the
        // body tail is itself a discard position.
        ESeq(EForIn(nm, idx, it2, fdp_expr(e = b, discard = true), for_off), EUnit)
      } else {
        EForIn(nm, idx, it2, fdp_expr(e = b, discard = false), for_off)
      }
    },
    ESeq(_, _) => fdp_spine(root = e, discard = discard),
    ELet(_, _, _, _) => fdp_spine(root = e, discard = discard),
    ELetRec(_, _, _) => fdp_spine(root = e, discard = discard),
    ELetMut(_, _, _, _) => fdp_spine(root = e, discard = discard),
    EAssign(_, _, _, _) => fdp_spine(root = e, discard = discard),
    EAssignOp(_, _, _, _, _) => fdp_spine(root = e, discard = discard),
    EIf(c, t, el) => EIf(fdp_expr(e = c, discard = false), fdp_expr(e = t, discard = discard), fdp_expr(e = el, discard = discard)),
    EMatch(s, arms) => {
      let arms2: Array[(Pat, Expr)] = []
      let mut i = 0
      while i < Array::length(arms) {
        let (p, ex) = Array::get(arms, at = i)
        Array::push(arms2, value = (p, fdp_expr(e = ex, discard = discard)))
        i = i + 1
      }
      EMatch(fdp_expr(e = s, discard = false), arms2)
    },
    // #3043: a discarded handle discards each arm's value, which is only the
    // handle's result. The body's value is discarded too unless an arm can
    // observe it through `resume` (Codex on #3061).
    EHandle(hb, harms) => {
      let harms2: Array[(Pat, Expr)] = []
      let mut resumes = false
      let mut i = 0
      while i < Array::length(harms) {
        let (p, ex) = Array::get(harms, at = i)
        if edp_rq_fold(q = RQIdentUses("resume"), e = ex) > 0 {
          resumes = true
        }
        Array::push(harms2, value = (p, fdp_expr(e = ex, discard = discard)))
        i = i + 1
      }
      EHandle(fdp_expr(e = hb, discard = discard && !resumes), harms2)
    },
    EWhile(c, b) => EWhile(fdp_expr(e = c, discard = false), fdp_expr(e = b, discard = true)),
    ELoop(pairs, b) => {
      let pairs2: Array[(String, Expr)] = []
      let mut i = 0
      while i < Array::length(pairs) {
        let (n, v) = Array::get(pairs, at = i)
        Array::push(pairs2, value = (n, fdp_expr(e = v, discard = false)))
        i = i + 1
      }
      ELoop(pairs2, fdp_expr(e = b, discard = false))
    },
    EFn(tps, tbs, params, ret, eff, b) => EFn(tps, tbs, params, ret, eff, fdp_expr(e = b, discard = fdp_ret_is_unit(ret))),
    ECall(callee, args, off, callee_resolution) => {
      let args2: Array[Expr] = []
      let mut i = 0
      while i < Array::length(args) {
        Array::push(args2, value = fdp_expr(e = Array::get(args, at = i), discard = false))
        i = i + 1
      }
      ECall(fdp_expr(e = callee, discard = false), args2, off, callee_resolution)
    },
    EBinOp(op, l, r, boff) => EBinOp(op, fdp_expr(e = l, discard = false), fdp_expr(e = r, discard = false), boff),
    EUnaryOp(op, x) => EUnaryOp(op, fdp_expr(e = x, discard = false)),
    EDot(o, f, a, b2) => EDot(fdp_expr(e = o, discard = false), f, a, b2),
    ELabeledArg(k, n, v) => ELabeledArg(k, n, fdp_expr(e = v, discard = false)),
    EReturn(x) => EReturn(fdp_expr(e = x, discard = false)),
    EBreak(opt) => match opt {
      Some(x) => EBreak(Some(fdp_expr(e = x, discard = false))),
      None => e
    },
    EContinue(args) => {
      let args2: Array[Expr] = []
      let mut i = 0
      while i < Array::length(args) {
        Array::push(args2, value = fdp_expr(e = Array::get(args, at = i), discard = false))
        i = i + 1
      }
      EContinue(args2)
    },
    ETuple(items) => {
      let items2: Array[Expr] = []
      let mut i = 0
      while i < Array::length(items) {
        Array::push(items2, value = fdp_expr(e = Array::get(items, at = i), discard = false))
        i = i + 1
      }
      ETuple(items2)
    },
    EArray(items) => {
      let items2: Array[Expr] = []
      let mut i = 0
      while i < Array::length(items) {
        Array::push(items2, value = fdp_expr(e = Array::get(items, at = i), discard = false))
        i = i + 1
      }
      EArray(items2)
    },
    ERecord(nm, fields, targs) => {
      let fields2: Array[(String, Expr)] = []
      let mut i = 0
      while i < Array::length(fields) {
        let (n, v) = Array::get(fields, at = i)
        Array::push(fields2, value = (n, fdp_expr(e = v, discard = false)))
        i = i + 1
      }
      ERecord(nm, fields2, targs)
    },
    EMap(fields) => {
      let fields2: Array[(String, Expr)] = []
      let mut i = 0
      while i < Array::length(fields) {
        let (n, v) = Array::get(fields, at = i)
        Array::push(fields2, value = (n, fdp_expr(e = v, discard = false)))
        i = i + 1
      }
      EMap(fields2)
    },
    ESpread(x) => ESpread(fdp_expr(e = x, discard = false)),
    _ => e
  }
}

export fn forin_discard_pass(_ stmts: Array[Stmt]) -> Unit {
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, at = i) {
      SLet(ex, isrec, nm, ty, expr) => if fdp_has_forin(expr) {
        Array::set(stmts, at = i, value = SLet(ex, isrec, nm, ty, fdp_expr(e = expr, discard = false)))
      } else {
        ()
      },
      SLetMut(nm, ty, expr) => if fdp_has_forin(expr) {
        Array::set(stmts, at = i, value = SLetMut(nm, ty, fdp_expr(e = expr, discard = false)))
      } else {
        ()
      },
      SExpr(expr) => if fdp_has_forin(expr) {
        Array::set(stmts, at = i, value = SExpr(fdp_expr(e = expr, discard = true)))
      } else {
        ()
      },
      STest(tn, expr) => if fdp_has_forin(expr) {
        Array::set(stmts, at = i, value = STest(tn, fdp_expr(e = expr, discard = true)))
      } else {
        ()
      },
      SBench(bn, expr) => if fdp_has_forin(expr) {
        Array::set(stmts, at = i, value = SBench(bn, fdp_expr(e = expr, discard = true)))
      } else {
        ()
      },
      _ => ()
    }
    i = i + 1
  }
}
