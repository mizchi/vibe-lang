import @vibe/compiler/core {
  Expr, Stmt
}
import @vibe/compiler/lowering/effects/discard {
  forin_discard_pass
}

test "for-loop values are discarded only in discarded contexts" {
  let loop_expr = EForIn("x", None, EArray([EInt(1)]), EInt(2))
  let stmts = [SExpr(loop_expr), SLet(false, false, "values", None, loop_expr)]
  forin_discard_pass(stmts)
  inspect(match Array::get(stmts, 0) {
    SExpr(ESeq(EForIn(_, _, _, _), EUnit)) => true,
    _ => false
  }, content = "true")
  inspect(match Array::get(stmts, 1) {
    SLet(_, _, _, _, EForIn(_, _, _, _)) => true,
    _ => false
  }, content = "true")
}
