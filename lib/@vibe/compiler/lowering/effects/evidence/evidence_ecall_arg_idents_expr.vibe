/// Any top-level fn with a row-E-typed parameter?
/// The first top-level fn whose declared parameters carry `ename` in a
/// function type -- the row-carrying closure VALUE the V1 guard is about
/// when no closure literal was found (#2065).
///
/// `edp_any_row_typed_param` answers the same scan with a Bool, and applies
/// NO reachability test: an entirely unused declaration satisfies it. That
/// is what made the guard's generic wording unactionable -- the reader is
/// told to look at "a handle body, a needing function, or a row-carrying
/// closure literal" while the decisive contributor is a signature elsewhere
/// in the file that nothing calls. Naming it is the whole point.
/// `a`, `a` and `b`, `a`, `b` and `c` -- for naming culprits in a message.
export fn edp_join_and(names: Array[String]) -> String {
  let n = Array::length(names)
  let mut out = ""
  let mut i = 0
  while i < n {
    // #3185: a program's own definition of a builtin-called name runs under
    // `NAME$user`; the message names what the program wrote.
    let nm = String::concat(String::concat("`", builtin_shadow_source_name(Array::get(names, i))), "`")
    if i == 0 {
      out = nm
    } else if i == n - 1 {
      out = String::concat(String::concat(out, " and "), nm)
    } else {
      out = String::concat(String::concat(out, ", "), nm)
    }
    i = i + 1
  }
  out
}

export fn edp_row_typed_param_owner(stmts: Array[Stmt], fn_defs: Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], ename: String, es_names: Array[String], es_members_list: Array[Array[String]]) -> String {
  let mut out = ""
  let mut i = 0
  while i < Array::length(fn_defs) {
    let (idx, _, _, _, _, _) = Array::get(fn_defs, i)
    match Array::get(stmts, idx) {
      SLet(_, _, snm, _, EFn(_, _, params, _, _, _)) => if String::length(out) == 0 && Array::length(edp_row_typed_param_names(params, ename, es_names, es_members_list)) > 0 {
        out = snm
      } else {
        ()
      },
      _ => ()
    }
    i = i + 1
  }
  out
}

export fn edp_any_row_typed_param(stmts: Array[Stmt], fn_defs: Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], ename: String, es_names: Array[String], es_members_list: Array[Array[String]]) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(fn_defs) {
    let (idx, _, _, _, _, _) = Array::get(fn_defs, i)
    match Array::get(stmts, idx) {
      SLet(_, _, _, _, EFn(_, _, params, _, _, _)) => if Array::length(edp_row_typed_param_names(params, ename, es_names, es_members_list)) > 0 {
        found = true
      } else {
        ()
      },
      _ => ()
    }
    i = i + 1
  }
  found
}

/// Whole-program count of every `EIdent(name)` occurrence -- full coverage
/// mirroring edp_has_unsafe_construct/edp_rewrite_needing_body's own node
/// list (see those functions' doc comments for why missing a position here
/// would be unsafe, not just incomplete: undercounting could make a
/// closure look falsely single-use).
export fn edp_count_ident_uses_stmts(stmts: Array[Stmt], name: String) -> Int {
  let mut total = 0
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SLet(_, _, _, _, expr) => {
        total = total + edp_count_ident_uses(expr, name)
      },
      _ => ()
    }
    i = i + 1
  }
  total
}

/// #1261: the parameter list of the top-level function named `nm`, or None
/// when `nm` is not a plain top-level `SLet name = EFn(..)`.
export fn edp_params_of_fn(stmts: Array[Stmt], fn_defs: Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], nm: String) -> Option[Array[(String, Option[TypeExpr])]] {
  let mut out: Option[Array[(String, Option[TypeExpr])]] = None
  let mut i = 0
  while i < Array::length(fn_defs) {
    let (idx, _, _, name, _, _) = Array::get(fn_defs, i)
    if name == nm {
      match Array::get(stmts, idx) {
        SLet(_, _, _, _, EFn(_, _, params, _, _, _)) => {
          out = Some(params)
        },
        _ => ()
      }
    } else {
      ()
    }
    i = i + 1
  }
  out
}

/// #3370: a closure literal with no written row, passed at a parameter of a
/// top-level function whose declared type carries a row, takes that row.
/// A call through such a parameter always prepends the dict
/// (`edp_row_typed_param_names`), but the type-directed sweep gives a literal
/// its dict parameter only when the literal's own row carries the effect
/// (`edp_efn_row_carries`). So `run_str(() -> put_abc())` -- and even
/// `run_str(() -> 3)` -- compiled the literal at arity 0, `run_str` called it
/// with the dict, and wasm trapped (`null function or function signature
/// mismatch`). Stamping the slot's row makes the tree the same as the
/// written `() -> Int with Box[String] { .. }`, which already worked. A
/// labeled argument is matched to its parameter by name; a callee a binding
/// in scope shadows is left alone. A row-free top-level function passed by
/// name there is wrapped the same way (#3424, `edp_slot_wrapper`).
export fn edp_stamp_slot_rows(stmts: Array[Stmt], fn_defs: Array[(Int, Bool, Bool, String, Option[TypeExpr], String)]) -> Unit {
  // #3424: the top-level functions with no row of their own. Passed by name
  // at a row-typed parameter, one is compiled without the dict the callee
  // passes, so the slot gets a wrapper literal that takes it.
  let pure_names = MutSet::new_string()
  for def in fn_defs {
    let (_, _, _, fname, _, frow) = def
    if String::length(String::trim(frow)) == 0 {
      MutSet::insert(pure_names, fname)
    } else {
      ()
    }
  }
  // #3424 (Codex on #3437): a snapshot's fresh name must be one no binder
  // and no top-level name of the program spells. The census is taken only
  // when a snapshot is first asked for (`edp_snap_fresh_name`).
  Array::truncate(edp_snap_taken, 0)
  Array::truncate(edp_snap_program, 0)
  Array::push(edp_snap_program, (stmts, fn_defs))
  edp_note_program_aliases(stmts)
  edp_note_row_field_structs(stmts)
  edp_slot_refusals_reset()
  let slot_callees = edp_slot_callee_names(stmts, fn_defs)
  edp_note_slot_methods(slot_callees)
  // This walk replaces statement bodies in place; the lookup reads live params.
  let fn_index = edp_fn_statement_index(fn_defs)
  let mut i = 0
  while i < Array::length(stmts) {
    edp_stamp_returned_closure(stmts, i, pure_names)
    let stmt = Array::get(stmts, i)
    let body = match stmt {
      SLet(_, _, _, _, e) => Some(e),
      SLetMut(_, _, e) => Some(e),
      SExpr(e) => Some(e),
      STest(_, e) => Some(e),
      SBench(_, e) => Some(e),
      SLetPat(_, e) => Some(e),
      _ => None
    }
    match body {
      Some(e) => if edp_expr_passes_literal_arg(e, pure_names) || edp_expr_passes_value_to_slot(e, slot_callees) || edp_expr_builds_row_field(e) {
        let stamped = edp_stamp_expr(e, stmts, fn_index, [], pure_names)
        match stmt {
          SLet(exported, is_rec, nm, ty, _) => Array::set(stmts, i, SLet(exported, is_rec, nm, ty, stamped)),
          SLetMut(nm, ty, _) => Array::set(stmts, i, SLetMut(nm, ty, stamped)),
          SExpr(_) => Array::set(stmts, i, SExpr(stamped)),
          STest(tn, _) => Array::set(stmts, i, STest(tn, stamped)),
          SBench(bn, _) => Array::set(stmts, i, SBench(bn, stamped)),
          SLetPat(pt, _) => Array::set(stmts, i, SLetPat(pt, stamped)),
          _ => ()
        }
      } else {
        ()
      },
      None => ()
    }
    i = i + 1
  }
  ()
}

/// #3435: a function whose declared result is a function type with a row
/// (`fn mid() -> (() -> Int with Box[Int]) { () -> mk() }`) hands its caller a
/// closure the caller calls with the dict, as a callee calls one written at
/// its row-typed parameter. The returned literal took no dict, so `drive(mid())`
/// passed one it had no parameter for and the module failed to instantiate
/// ("not enough arguments on the stack for call"). The closure in tail
/// position takes the declared row, the way `edp_stamp_slot_arg_at` gives a
/// parameter's; one that calls a local closure is left as written.
fn edp_stamp_returned_closure(stmts: Array[Stmt], i: Int, pure_names: MutSet[String]) -> Unit {
  match Array::get(stmts, i) {
    SLet(exported, is_rec, nm, ty, EFn(tps, tbs, ps, Some(rty), eff, fb)) => {
      let scope: Array[String] = []
      let mut pi = 0
      while pi < Array::length(ps) {
        Array::push(scope, edp_param_base_name(Array::get(ps, pi).0))
        pi = pi + 1
      }
      match edp_stamp_declared_result(fb, rty, stmts, scope, pure_names) {
        Some(fb2) => Array::set(stmts, i, SLet(exported, is_rec, nm, ty, EFn(tps, tbs, ps, Some(rty), eff, fb2))),
        None => ()
      }
    },
    _ => ()
  }
}

/// `fb` with the closures it returns stamped at the declared result `rty`:
/// a function type with a row (#3435), or a tuple holding one at any depth
/// (#3582: `-> (() -> Int with Ask, Int)` handed back its literal at the pure
/// arity, and the caller's call through `t.0` trapped). None when `rty` gives
/// no slot.
fn edp_stamp_declared_result(fb: Expr, rty: TypeExpr, stmts: Array[Stmt], scope: Array[String], pure_names: MutSet[String]) -> Option[Expr] {
  match edp_result_slot(stmts, rty) {
    Some(slot) => Some(edp_stamp_result(fb, slot, scope, pure_names)),
    None => match edp_tuple_result_types(stmts, rty) {
      Some(tys) => Some(edp_stamp_tuple_tail(fb, tys, true, Some(tys), stmts, scope, pure_names)),
      None => None
    }
  }
}

/// #3582: `e` with each tuple it evaluates to, in a tail position (`tail`) or
/// as a `return`'s value, stamped element by element at the declared element
/// types `tys`. An element at a row-typed function type is stamped as a
/// returned closure is (`edp_stamp_tail`); a nested tuple type recurses on its
/// tails alone. `rets` is the function's own result for a `return`'s value
/// (None: leave `return`s alone). A nested lambda's `return` is its own and is
/// not entered.
fn edp_stamp_tuple_tail(e: Expr, tys: Array[TypeExpr], tail: Bool, rets: Option[Array[TypeExpr]], stmts: Array[Stmt], scope: Array[String], pure_names: MutSet[String]) -> Expr {
  let base = Array::length(scope)
  let out = match e {
    ETuple(items) => if tail && Array::length(items) == Array::length(tys) {
      let stamped: Array[Expr] = []
      let mut k = 0
      while k < Array::length(items) {
        let item = edp_stamp_tuple_tail(Array::get(items, k), tys, false, rets, stmts, scope, pure_names)
        let ty = Array::get(tys, k)
        Array::push(stamped, match edp_result_slot(stmts, ty) {
          Some(slot) => edp_stamp_tail(item, slot, scope, pure_names),
          None => match edp_tuple_result_types(stmts, ty) {
            Some(inner) => edp_stamp_tuple_tail(item, inner, true, None, stmts, scope, pure_names),
            None => item
          }
        })
        k = k + 1
      }
      ETuple(stamped)
    } else {
      ETuple(for x in items {
        edp_stamp_tuple_tail(x, tys, false, rets, stmts, scope, pure_names)
      })
    },
    EReturn(x) => match rets {
      Some(rtys) => EReturn(edp_stamp_tuple_tail(x, rtys, true, rets, stmts, scope, pure_names)),
      None => e
    },
    ESeq(a, b) => ESeq(edp_stamp_tuple_tail(a, tys, false, rets, stmts, scope, pure_names), edp_stamp_tuple_tail(b, tys, tail, rets, stmts, scope, pure_names)),
    ELet(n, v, b, off) => {
      let v2 = edp_stamp_tuple_tail(v, tys, false, rets, stmts, scope, pure_names)
      Array::push(scope, n)
      ELet(n, v2, edp_stamp_tuple_tail(b, tys, tail, rets, stmts, scope, pure_names), off)
    },
    ELetMut(n, v, b, off) => {
      let v2 = edp_stamp_tuple_tail(v, tys, false, rets, stmts, scope, pure_names)
      Array::push(scope, n)
      ELetMut(n, v2, edp_stamp_tuple_tail(b, tys, tail, rets, stmts, scope, pure_names), off)
    },
    ELetRec(n, v, b) => {
      Array::push(scope, n)
      ELetRec(n, v, edp_stamp_tuple_tail(b, tys, tail, rets, stmts, scope, pure_names))
    },
    EIf(c, t, el) => EIf(edp_stamp_tuple_tail(c, tys, false, rets, stmts, scope, pure_names), edp_stamp_tuple_tail(t, tys, tail, rets, stmts, scope, pure_names), edp_stamp_tuple_tail(el, tys, tail, rets, stmts, scope, pure_names)),
    EMatch(sc, arms) => EMatch(edp_stamp_tuple_tail(sc, tys, false, rets, stmts, scope, pure_names), edp_stamp_tuple_arms(arms, tys, tail, rets, stmts, scope, pure_names)),
    EHandle(bd, arms) => EHandle(edp_stamp_tuple_tail(bd, tys, tail, rets, stmts, scope, pure_names), edp_stamp_tuple_arms(arms, tys, tail, rets, stmts, scope, pure_names)),
    EAssign(n, v, c, off) => EAssign(n, edp_stamp_tuple_tail(v, tys, false, rets, stmts, scope, pure_names), edp_stamp_tuple_tail(c, tys, tail, rets, stmts, scope, pure_names), off),
    EAssignOp(n, op, v, c, off) => EAssignOp(n, op, edp_stamp_tuple_tail(v, tys, false, rets, stmts, scope, pure_names), edp_stamp_tuple_tail(c, tys, tail, rets, stmts, scope, pure_names), off),
    EWhile(c, b) => EWhile(edp_stamp_tuple_tail(c, tys, false, rets, stmts, scope, pure_names), edp_stamp_tuple_tail(b, tys, false, rets, stmts, scope, pure_names)),
    ECall(callee, args, off, res) => ECall(edp_stamp_tuple_tail(callee, tys, false, rets, stmts, scope, pure_names), for x in args {
      edp_stamp_tuple_tail(x, tys, false, rets, stmts, scope, pure_names)
    }, off, res),
    EBinOp(op, l, r, boff) => EBinOp(op, edp_stamp_tuple_tail(l, tys, false, rets, stmts, scope, pure_names), edp_stamp_tuple_tail(r, tys, false, rets, stmts, scope, pure_names), boff),
    EUnaryOp(op, x) => EUnaryOp(op, edp_stamp_tuple_tail(x, tys, false, rets, stmts, scope, pure_names)),
    // A `return` anywhere else in the body leaves the function too, as
    // `edp_stamp_returns` walks it (Codex on #3610: a `return` in a loop).
    EForIn(n, idx, it, b) => {
      let it2 = edp_stamp_tuple_tail(it, tys, false, rets, stmts, scope, pure_names)
      Array::push(scope, n)
      match idx {
        Some(ix) => Array::push(scope, ix),
        None => ()
      }
      EForIn(n, idx, it2, edp_stamp_tuple_tail(b, tys, false, rets, stmts, scope, pure_names))
    },
    ELoop(pairs, b) => {
      let pairs2 = for pr in pairs {
        let (n, v) = pr
        (n, edp_stamp_tuple_tail(v, tys, false, rets, stmts, scope, pure_names))
      }
      for pr in pairs {
        Array::push(scope, pr.0)
      }
      ELoop(pairs2, edp_stamp_tuple_tail(b, tys, false, rets, stmts, scope, pure_names))
    },
    EDot(o, f, o1, o2) => EDot(edp_stamp_tuple_tail(o, tys, false, rets, stmts, scope, pure_names), f, o1, o2),
    ELabeledArg(l, ln, v) => ELabeledArg(l, ln, edp_stamp_tuple_tail(v, tys, false, rets, stmts, scope, pure_names)),
    EBreak(Some(x)) => EBreak(Some(edp_stamp_tuple_tail(x, tys, false, rets, stmts, scope, pure_names))),
    EContinue(args) => EContinue(for x in args {
      edp_stamp_tuple_tail(x, tys, false, rets, stmts, scope, pure_names)
    }),
    EArray(items) => EArray(for x in items {
      edp_stamp_tuple_tail(x, tys, false, rets, stmts, scope, pure_names)
    }),
    ERecord(rn, fields, tas) => ERecord(rn, for f in fields {
      (f.0, edp_stamp_tuple_tail(f.1, tys, false, rets, stmts, scope, pure_names))
    }, tas),
    EMap(fields) => EMap(for f in fields {
      (f.0, edp_stamp_tuple_tail(f.1, tys, false, rets, stmts, scope, pure_names))
    }),
    ESpread(x) => ESpread(edp_stamp_tuple_tail(x, tys, false, rets, stmts, scope, pure_names)),
    _ => e
  }
  Array::truncate(scope, base)
  out
}

fn edp_stamp_tuple_arms(arms: Array[(Pat, Expr)], tys: Array[TypeExpr], tail: Bool, rets: Option[Array[TypeExpr]], stmts: Array[Stmt], scope: Array[String], pure_names: MutSet[String]) -> Array[(Pat, Expr)] {
  for a in arms {
    let (pp, ex) = a
    let base = Array::length(scope)
    for pn in edp_pat_names(pp) {
      Array::push(scope, pn)
    }
    let ex2 = edp_stamp_tuple_tail(ex, tys, tail, rets, stmts, scope, pure_names)
    Array::truncate(scope, base)
    (pp, ex2)
  }
}

/// A function body `fb` with the closure it returns stamped at `slot`: each
/// tail position, and the value of every `return` in it (Codex on #3447).
fn edp_stamp_result(fb: Expr, slot: (Int, String), scope: Array[String], pure_names: MutSet[String]) -> Expr {
  edp_stamp_tail(edp_stamp_returns(fb, slot, scope, pure_names), slot, scope, pure_names)
}

/// `e` with each `return`'s value stamped as a tail is. A nested lambda's
/// `return` is its own and is not entered.
fn edp_stamp_returns(e: Expr, slot: (Int, String), scope: Array[String], pure_names: MutSet[String]) -> Expr {
  match e {
    EReturn(x) => EReturn(edp_stamp_tail(edp_stamp_returns(x, slot, scope, pure_names), slot, scope, pure_names)),
    ESeq(a, b) => ESeq(edp_stamp_returns(a, slot, scope, pure_names), edp_stamp_returns(b, slot, scope, pure_names)),
    ELet(n, v, b, off) => {
      let v2 = edp_stamp_returned_let(n, edp_stamp_returns(v, slot, scope, pure_names), b, slot, scope, pure_names)
      Array::push(scope, n)
      let b2 = edp_stamp_returns(b, slot, scope, pure_names)
      Array::truncate(scope, Array::length(scope) - 1)
      ELet(n, v2, b2, off)
    },
    ELetRec(n, v, b) => {
      Array::push(scope, n)
      let b2 = edp_stamp_returns(b, slot, scope, pure_names)
      Array::truncate(scope, Array::length(scope) - 1)
      ELetRec(n, v, b2)
    },
    ELetMut(n, v, b, off) => {
      let (v2, b1) = edp_stamp_returned_mut(n, edp_stamp_returns(v, slot, scope, pure_names), b, slot, scope, pure_names)
      Array::push(scope, n)
      let b2 = edp_stamp_returns(b1, slot, scope, pure_names)
      Array::truncate(scope, Array::length(scope) - 1)
      ELetMut(n, v2, b2, off)
    },
    EIf(c, t, el) => EIf(edp_stamp_returns(c, slot, scope, pure_names), edp_stamp_returns(t, slot, scope, pure_names), edp_stamp_returns(el, slot, scope, pure_names)),
    EMatch(sc, arms) => EMatch(edp_stamp_returns(sc, slot, scope, pure_names), for a in arms {
      let (pp, ex) = a
      let base = Array::length(scope)
      for pn in edp_pat_names(pp) {
        Array::push(scope, pn)
      }
      let ex2 = edp_stamp_returns(ex, slot, scope, pure_names)
      Array::truncate(scope, base)
      (pp, ex2)
    }),
    EWhile(c, b) => EWhile(edp_stamp_returns(c, slot, scope, pure_names), edp_stamp_returns(b, slot, scope, pure_names)),
    EAssign(n, v, c, off) => EAssign(n, edp_stamp_returns(v, slot, scope, pure_names), edp_stamp_returns(c, slot, scope, pure_names), off),
    EAssignOp(n, op, v, c, off) => EAssignOp(n, op, edp_stamp_returns(v, slot, scope, pure_names), edp_stamp_returns(c, slot, scope, pure_names), off),
    EForIn(n, idx, it, b) => {
      let it2 = edp_stamp_returns(it, slot, scope, pure_names)
      let base = Array::length(scope)
      Array::push(scope, n)
      match idx {
        Some(ix) => Array::push(scope, ix),
        None => ()
      }
      let b2 = edp_stamp_returns(b, slot, scope, pure_names)
      Array::truncate(scope, base)
      EForIn(n, idx, it2, b2)
    },
    ELoop(pairs, b) => {
      let base = Array::length(scope)
      let pairs2 = for pr in pairs {
        let (n, v) = pr
        (n, edp_stamp_returns(v, slot, scope, pure_names))
      }
      for pr in pairs {
        Array::push(scope, pr.0)
      }
      let b2 = edp_stamp_returns(b, slot, scope, pure_names)
      Array::truncate(scope, base)
      ELoop(pairs2, b2)
    },
    EHandle(bd, arms) => EHandle(edp_stamp_returns(bd, slot, scope, pure_names), for a in arms {
      let (pp, ex) = a
      let base = Array::length(scope)
      for pn in edp_pat_names(pp) {
        Array::push(scope, pn)
      }
      let ex2 = edp_stamp_returns(ex, slot, scope, pure_names)
      Array::truncate(scope, base)
      (pp, ex2)
    }),
    // A `return` inside an operand, an argument or an aggregate's element
    // leaves the function as well (Codex on #3447: `[1, if c { return f }
    // else { 2 }]`).
    ECall(callee, args, off, res) => ECall(edp_stamp_returns(callee, slot, scope, pure_names), edp_stamp_returns_all(args, slot, scope, pure_names), off, res),
    EBinOp(op, l, r, boff) => EBinOp(op, edp_stamp_returns(l, slot, scope, pure_names), edp_stamp_returns(r, slot, scope, pure_names), boff),
    EUnaryOp(op, x) => EUnaryOp(op, edp_stamp_returns(x, slot, scope, pure_names)),
    EDot(o, f, o1, o2) => EDot(edp_stamp_returns(o, slot, scope, pure_names), f, o1, o2),
    ELabeledArg(l, ln, v) => ELabeledArg(l, ln, edp_stamp_returns(v, slot, scope, pure_names)),
    EBreak(Some(x)) => EBreak(Some(edp_stamp_returns(x, slot, scope, pure_names))),
    EContinue(args) => EContinue(edp_stamp_returns_all(args, slot, scope, pure_names)),
    ETuple(items) => ETuple(edp_stamp_returns_all(items, slot, scope, pure_names)),
    EArray(items) => EArray(edp_stamp_returns_all(items, slot, scope, pure_names)),
    ERecord(rn, fields, tas) => ERecord(rn, for f in fields {
      (f.0, edp_stamp_returns(f.1, slot, scope, pure_names))
    }, tas),
    EMap(fields) => EMap(for f in fields {
      (f.0, edp_stamp_returns(f.1, slot, scope, pure_names))
    }),
    ESpread(x) => ESpread(edp_stamp_returns(x, slot, scope, pure_names)),
    _ => e
  }
}

fn edp_stamp_returns_all(es: Array[Expr], slot: (Int, String), scope: Array[String], pure_names: MutSet[String]) -> Array[Expr] {
  for x in es {
    edp_stamp_returns(x, slot, scope, pure_names)
  }
}

/// A closure bound by `let` and returned by its name -- in a tail position or
/// through `return` (Codex on #3447: `let f = () -> mk(); return f`) -- is
/// the result itself, when every use of the name the binding reaches is such
/// a return. It takes the declared row then; otherwise it is left as written.
fn edp_stamp_returned_let(n: String, v: Expr, b: Expr, slot: (Int, String), scope: Array[String], pure_names: MutSet[String]) -> Expr {
  match v {
    EFn(_, _, _, _, None, lb) => {
      let results = edp_tail_name_count(b, n) + edp_return_name_count(b, n)
      if results > 0 && results == edp_free_use_count(b, n) && !edp_literal_calls_local(v, lb, scope) {
        edp_stamp_slot_arg_at(v, scope, pure_names, Some(slot))
      } else {
        v
      }
    },
    // #3472: a call's result handed back by its name is checked like one
    // returned directly; the value stays as written either way.
    ECall(EIdent(_, _), _, _, _) => if edp_tail_name_count(b, n) + edp_return_name_count(b, n) > 0 {
      edp_stamp_slot_arg_at(v, scope, pure_names, Some(slot))
    } else {
      v
    },
    ECall(EDot(_, _, _, _), _, _, _) => if edp_tail_name_count(b, n) + edp_return_name_count(b, n) > 0 {
      edp_stamp_slot_arg_at(v, scope, pure_names, Some(slot))
    } else {
      v
    },
    _ => v
  }
}

/// The uses of `n` in `e` that the binding around `e` reaches: a binder of `n`
/// inside `e` hides it in its scope (Codex on #3447: `let _ = ((f: Int) ->
/// f)(0)` is not a use of the outer `f`).
fn edp_free_use_count(e: Expr, n: String) -> Int {
  let marker = "#free-use"
  edp_count_ident_uses(edp_rename_free(e, n, marker), marker)
}

/// A `let mut n = v` whose body `b` hands `n` back as the result, with the
/// initializer and every value assigned to `n` stamped at `slot` (Codex on
/// #3452: `let mut f = () -> mk(); f = () -> 3; f`). Each of them can be the
/// value returned, so all of them take the row or none do. A value is read
/// through its tail positions, as a returned body is (#3463: `f = if c { ..
/// } else { .. }`), and an assignment inside a lambda that captures `n`
/// counts. When one cannot be stamped (`edp_mut_value_stampable`), or an
/// assignment sits where the walk does not reach, all are left as written.
fn edp_stamp_returned_mut(n: String, v: Expr, b: Expr, slot: (Int, String), scope: Array[String], pure_names: MutSet[String]) -> (Expr, Expr) {
  if !edp_assigns_free(b, n) {
    (edp_stamp_returned_let(n, v, b, slot, scope, pure_names), b)
  } else {
    let results = edp_tail_name_count(b, n) + edp_return_name_count(b, n)
    if results > 0 && results == edp_free_use_count(b, n) && edp_mut_value_stampable(v, scope, pure_names) {
      let marker = "#ret-mut"
      let renamed = edp_rename_free(b, n, marker)
      // [values met, values that cannot be stamped]
      let state = [0, 0]
      // The binding itself is in scope for the values assigned to it.
      let stamped = edp_stamp_assigned_scoped(renamed, [marker], marker, slot, scope, pure_names, state)
      if Array::get(state, 1) == 0 && Array::get(state, 0) == edp_count_assigns_name(renamed, marker) {
        (edp_stamp_tail(v, slot, scope, pure_names), edp_rename_free(stamped, marker, n))
      } else {
        edp_refuse_returned_mut_calls(n, v, b, slot, scope)
        (v, b)
      }
    } else {
      if results > 0 {
        edp_refuse_returned_mut_calls(n, v, b, slot, scope)
      }
      (v, b)
    }
  }
}

/// #3472: a returned `let mut` left as written hands back whichever value it
/// holds, so a call among them whose callee declares a row-free function
/// result is refused with the row to declare, as one returned directly is.
fn edp_refuse_returned_mut_calls(n: String, v: Expr, b: Expr, slot: (Int, String), scope: Array[String]) -> Unit {
  if Array::length(edp_snap_program) > 0 {
    let (pstmts, pdefs) = Array::get(edp_snap_program, 0)
    let (_, row) = slot
    // No callee: the slot is the function's declared result.
    let _ = edp_take_slot_callee()
    edp_refuse_tail_calls(v, pstmts, pdefs, row, scope)
    edp_refuse_assigned_calls(edp_rename_free(b, n, "#ret-mut"), "#ret-mut", pstmts, pdefs, row, scope)
  }
}

/// #3472: whether the top-level function `fname` declares a function result
/// that carries a row. The closure it returns takes the dict already, so a
/// returned `let mut` may hold it beside values it stamps.
fn edp_call_result_has_row(fname: String) -> Bool {
  if Array::length(edp_snap_program) > 0 {
    let (pstmts, pdefs) = Array::get(edp_snap_program, 0)
    edp_fn_result_has_row(pstmts, pdefs, fname)
  } else {
    false
  }
}

/// Can a value a returned `let mut` holds take the declared row, or keep its
/// own? It is read through its tail positions as `edp_stamp_tail` stamps them.
/// A literal that calls a local closure cannot be stamped in place, and a
/// local binding's name is a closure nothing here stamps. A row-free top-level
/// function's name is wrapped; any other name, a builtin or a constructor
/// among them, is not (Codex on #3466: `f = String::length`). A `return`
/// hands back no value here. A call whose callee declares the row on its
/// result is already adapted; any other value, a call to a row-free result
/// among them, is a closure `edp_stamp_tail` cannot adapt (Codex on #3466:
/// `f = pure_factory()`), and that call is refused (#3472).
fn edp_mut_value_stampable(val: Expr, scope: Array[String], pure_names: MutSet[String]) -> Bool {
  match val {
    EFn(_, _, _, _, None, lb) => !edp_literal_calls_local(val, lb, scope),
    EFn(_, _, _, _, Some(_), _) => true,
    EIdent(x, _) => MutSet::has(pure_names, x) && !edp_scope_has(scope, x),
    EReturn(_) => true,
    // #3472: a call whose callee's declared result carries the row hands
    // back a closure that takes the dict; `edp_stamp_tail` leaves it as is.
    ECall(EIdent(f, _), _, _, _) => !edp_scope_has(scope, f) && edp_call_result_has_row(f),
    ESeq(_, b) => edp_mut_value_stampable(b, scope, pure_names),
    EIf(_, t, el) => edp_mut_value_stampable(t, scope, pure_names) && edp_mut_value_stampable(el, scope, pure_names),
    EAssign(_, _, c, _) => edp_mut_value_stampable(c, scope, pure_names),
    ELet(x, _, b, _) => edp_mut_value_stampable_in(b, [x], scope, pure_names),
    ELetMut(x, _, b, _) => edp_mut_value_stampable_in(b, [x], scope, pure_names),
    ELetRec(x, _, b) => edp_mut_value_stampable_in(b, [x], scope, pure_names),
    EMatch(_, arms) => edp_mut_arms_stampable(arms, scope, pure_names),
    EHandle(bd, arms) => edp_mut_value_stampable(bd, scope, pure_names) && edp_mut_arms_stampable(arms, scope, pure_names),
    _ => false
  }
}

fn edp_mut_value_stampable_in(e: Expr, names: Array[String], scope: Array[String], pure_names: MutSet[String]) -> Bool {
  let inner: Array[String] = []
  for x in scope {
    Array::push(inner, x)
  }
  for x in names {
    Array::push(inner, x)
  }
  edp_mut_value_stampable(e, inner, pure_names)
}

fn edp_mut_arms_stampable(arms: Array[(Pat, Expr)], scope: Array[String], pure_names: MutSet[String]) -> Bool {
  let mut ok = true
  for a in arms {
    if !edp_mut_value_stampable_in(a.1, edp_pat_names(a.0), scope, pure_names) {
      ok = false
    } else {
      ()
    }
  }
  ok
}

/// `e` with each value assigned to `marker` stamped at `slot`, through its
/// tail positions. Each binder passed on the way is laid on `scope`, so a
/// literal that calls a local the body declares is seen to (Codex on #3462:
/// `let helper = () -> 3; f = () -> helper()`). `state[0]` counts the values
/// met and `state[1]` the ones that cannot be stamped, which are left as
/// written; a value that itself assigns `marker` is one of those.
fn edp_stamp_assigned_lits(e: Expr, marker: String, slot: (Int, String), scope: Array[String], pure_names: MutSet[String], state: Array[Int]) -> Expr {
  match e {
    EAssign(m, v, c, off) => {
      let v2 = if m == marker {
        Array::set(state, 0, Array::get(state, 0) + 1)
        if edp_mut_value_stampable(v, scope, pure_names) && edp_count_assigns_name(v, marker) == 0 {
          edp_stamp_tail(v, slot, scope, pure_names)
        } else {
          Array::set(state, 1, Array::get(state, 1) + 1)
          v
        }
      } else {
        edp_stamp_assigned_lits(v, marker, slot, scope, pure_names, state)
      }
      EAssign(m, v2, edp_stamp_assigned_lits(c, marker, slot, scope, pure_names, state), off)
    },
    EAssignOp(m, op, v, c, off) => EAssignOp(m, op, edp_stamp_assigned_lits(v, marker, slot, scope, pure_names, state), edp_stamp_assigned_lits(c, marker, slot, scope, pure_names, state), off),
    ESeq(a, b) => ESeq(edp_stamp_assigned_lits(a, marker, slot, scope, pure_names, state), edp_stamp_assigned_lits(b, marker, slot, scope, pure_names, state)),
    ELet(x, v, b, off) => ELet(x, edp_stamp_assigned_lits(v, marker, slot, scope, pure_names, state), edp_stamp_assigned_scoped(b, [
      x
    ], marker, slot, scope, pure_names, state), off),
    ELetMut(x, v, b, off) => ELetMut(x, edp_stamp_assigned_lits(v, marker, slot, scope, pure_names, state), edp_stamp_assigned_scoped(b, [
      x
    ], marker, slot, scope, pure_names, state), off),
    ELetRec(x, v, b) => ELetRec(x, v, edp_stamp_assigned_scoped(b, [x], marker, slot, scope, pure_names, state)),
    // A lambda that captures the binding can assign it whenever it runs
    // (#3463), so its body is walked with its parameters in scope.
    EFn(tps, tbs, ps, ret, eff, fb) => EFn(tps, tbs, ps, ret, eff, edp_stamp_assigned_scoped(fb, for pp in ps {
      edp_param_base_name(pp.0)
    }, marker, slot, scope, pure_names, state)),
    EIf(c, t, el) => EIf(edp_stamp_assigned_lits(c, marker, slot, scope, pure_names, state), edp_stamp_assigned_lits(t, marker, slot, scope, pure_names, state), edp_stamp_assigned_lits(el, marker, slot, scope, pure_names, state)),
    EMatch(sc, arms) => EMatch(edp_stamp_assigned_lits(sc, marker, slot, scope, pure_names, state), for a in arms {
      (a.0, edp_stamp_assigned_scoped(a.1, edp_pat_names(a.0), marker, slot, scope, pure_names, state))
    }),
    EHandle(bd, arms) => EHandle(edp_stamp_assigned_lits(bd, marker, slot, scope, pure_names, state), for a in arms {
      (a.0, edp_stamp_assigned_scoped(a.1, edp_pat_names(a.0), marker, slot, scope, pure_names, state))
    }),
    EWhile(c, b) => EWhile(edp_stamp_assigned_lits(c, marker, slot, scope, pure_names, state), edp_stamp_assigned_lits(b, marker, slot, scope, pure_names, state)),
    EForIn(x, idx, it, b) => {
      let names = [x]
      match idx {
        Some(i) => Array::push(names, i),
        None => ()
      }
      EForIn(x, idx, edp_stamp_assigned_lits(it, marker, slot, scope, pure_names, state), edp_stamp_assigned_scoped(b, names, marker, slot, scope, pure_names, state))
    },
    // An initializer is read before its own binder is in scope.
    ELoop(pairs, b) => ELoop(for pr in pairs {
      (pr.0, edp_stamp_assigned_lits(pr.1, marker, slot, scope, pure_names, state))
    }, edp_stamp_assigned_scoped(b, for pr in pairs {
      pr.0
    }, marker, slot, scope, pure_names, state)),
    // An assignment can sit under a `return`, an operand, an argument or an
    // aggregate element, as a `return` can for `edp_stamp_returns` (Codex on
    // #3462: `return { f = () -> 3; f }`).
    EReturn(x) => EReturn(edp_stamp_assigned_lits(x, marker, slot, scope, pure_names, state)),
    ECall(callee, args, off, res) => ECall(edp_stamp_assigned_lits(callee, marker, slot, scope, pure_names, state), for x in args {
      edp_stamp_assigned_lits(x, marker, slot, scope, pure_names, state)
    }, off, res),
    EBinOp(op, l, r, boff) => EBinOp(op, edp_stamp_assigned_lits(l, marker, slot, scope, pure_names, state), edp_stamp_assigned_lits(r, marker, slot, scope, pure_names, state), boff),
    EUnaryOp(op, x) => EUnaryOp(op, edp_stamp_assigned_lits(x, marker, slot, scope, pure_names, state)),
    EDot(o, f, o1, o2) => EDot(edp_stamp_assigned_lits(o, marker, slot, scope, pure_names, state), f, o1, o2),
    ELabeledArg(l, ln, v) => ELabeledArg(l, ln, edp_stamp_assigned_lits(v, marker, slot, scope, pure_names, state)),
    EBreak(Some(x)) => EBreak(Some(edp_stamp_assigned_lits(x, marker, slot, scope, pure_names, state))),
    EContinue(args) => EContinue(for x in args {
      edp_stamp_assigned_lits(x, marker, slot, scope, pure_names, state)
    }),
    ETuple(items) => ETuple(for x in items {
      edp_stamp_assigned_lits(x, marker, slot, scope, pure_names, state)
    }),
    EArray(items) => EArray(for x in items {
      edp_stamp_assigned_lits(x, marker, slot, scope, pure_names, state)
    }),
    ERecord(rn, fields, tas) => ERecord(rn, for fl in fields {
      (fl.0, edp_stamp_assigned_lits(fl.1, marker, slot, scope, pure_names, state))
    }, tas),
    EMap(fields) => EMap(for fl in fields {
      (fl.0, edp_stamp_assigned_lits(fl.1, marker, slot, scope, pure_names, state))
    }),
    ESpread(x) => ESpread(edp_stamp_assigned_lits(x, marker, slot, scope, pure_names, state)),
    _ => e
  }
}

/// `edp_stamp_assigned_lits` over `e` with `names` bound on top of `scope`.
fn edp_stamp_assigned_scoped(e: Expr, names: Array[String], marker: String, slot: (Int, String), scope: Array[String], pure_names: MutSet[String], state: Array[Int]) -> Expr {
  let base = Array::length(scope)
  for n in names {
    Array::push(scope, n)
  }
  let out = edp_stamp_assigned_lits(e, marker, slot, scope, pure_names, state)
  Array::truncate(scope, base)
  out
}

/// Does `e` assign the binding `n` it reaches, a nested lambda that captures it
/// included? An inner binder of the spelling is not `n` (Codex on #3452:
/// `let _ = { let mut f = 0; f = 1; f }`), so the free uses are renamed first,
/// as `edp_free_use_count` does.
fn edp_assigns_free(e: Expr, n: String) -> Bool {
  let marker = "#free-assign"
  edp_assigns_name(edp_rename_free(e, n, marker), marker)
}

/// Each arm of a `match` or `handle` stamped as a tail, its pattern's binders in
/// scope.
fn edp_stamp_tail_arms(arms: Array[(Pat, Expr)], slot: (Int, String), scope: Array[String], pure_names: MutSet[String]) -> Array[(Pat, Expr)] {
  for a in arms {
    let (pp, ex) = a
    let base = Array::length(scope)
    for pn in edp_pat_names(pp) {
      Array::push(scope, pn)
    }
    let ex2 = edp_stamp_tail(ex, slot, scope, pure_names)
    Array::truncate(scope, base)
    (pp, ex2)
  }
}

/// `e` with the closure it evaluates to, in each tail position, given `slot`.
fn edp_stamp_tail(e: Expr, slot: (Int, String), scope: Array[String], pure_names: MutSet[String]) -> Expr {
  match e {
    ESeq(a, b) => ESeq(a, edp_stamp_tail(b, slot, scope, pure_names)),
    ELet(n, v, b, off) => {
      // A closure bound here and returned by its name (`let f = () -> mk();
      // f`) is the result itself, when the body uses the name nowhere else
      // (Codex on #3447).
      let v2 = edp_stamp_returned_let(n, v, b, slot, scope, pure_names)
      Array::push(scope, n)
      let b2 = edp_stamp_tail(b, slot, scope, pure_names)
      Array::truncate(scope, Array::length(scope) - 1)
      ELet(n, v2, b2, off)
    },
    ELetMut(n, v, b, off) => {
      // A mutable binding returned by its name is the result as an immutable
      // one is (Codex on #3447), and so is every closure assigned to it.
      let (v2, b1) = edp_stamp_returned_mut(n, v, b, slot, scope, pure_names)
      Array::push(scope, n)
      let b2 = edp_stamp_tail(b1, slot, scope, pure_names)
      Array::truncate(scope, Array::length(scope) - 1)
      ELetMut(n, v2, b2, off)
    },
    // A recursive binding keeps the rest of its block as its continuation
    // (Codex on #3447).
    ELetRec(n, v, b) => {
      Array::push(scope, n)
      let b2 = edp_stamp_tail(b, slot, scope, pure_names)
      Array::truncate(scope, Array::length(scope) - 1)
      ELetRec(n, v, b2)
    },
    EIf(c, t, el) => EIf(c, edp_stamp_tail(t, slot, scope, pure_names), edp_stamp_tail(el, slot, scope, pure_names)),
    EMatch(sc, arms) => EMatch(sc, edp_stamp_tail_arms(arms, slot, scope, pure_names)),
    // An assignment keeps the rest of its block as its continuation, and a
    // handle's value is its body's or an arm's (Codex on #3447).
    EAssign(n, v, c, off) => EAssign(n, v, edp_stamp_tail(c, slot, scope, pure_names), off),
    EAssignOp(n, op, v, c, off) => EAssignOp(n, op, v, edp_stamp_tail(c, slot, scope, pure_names), off),
    EHandle(bd, arms) => EHandle(edp_stamp_tail(bd, slot, scope, pure_names), edp_stamp_tail_arms(arms, slot, scope, pure_names)),
    EFn(_, _, _, _, None, lb) => if edp_literal_calls_local(e, lb, scope) {
      e
    } else {
      edp_stamp_slot_arg_at(e, scope, pure_names, Some(slot))
    },
    EIdent(_, _) => edp_stamp_slot_arg_at(e, scope, pure_names, Some(slot)),
    // #3472: a call's result is returned as written. When the callee
    // declares a row-free function result, the closure it hands back takes
    // no dict and the caller passes one, so it is refused with the row to
    // declare (`edp_refuse_rowless_result`); a callee whose result carries
    // the row is left alone.
    ECall(EIdent(_, _), _, _, _) => edp_stamp_slot_arg_at(e, scope, pure_names, Some(slot)),
    // Codex on #3467: a method-style factory (`maker.mk()`) too.
    ECall(EDot(_, _, _, _), _, _, _) => edp_stamp_slot_arg_at(e, scope, pure_names, Some(slot)),
    _ => e
  }
}

/// #3347: a top-level `let side: Thunk = () -> Int { .. }` keeps its alias
/// annotation on the statement, and the literal has no row: a written
/// `() -> Int with Ask` is folded into the literal by the parser, an alias is
/// not. The literal takes the alias's row, and the annotation is expanded, so
/// the statement reads as the written one does. This runs first in the pass:
/// the handle erasure and the needing-function table read top-level rows.
export fn edp_stamp_alias_annotated_lets(stmts: Array[Stmt]) -> Unit {
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SLet(exported, is_rec, nm, Some(ty), EFn(tps, tbs, ps, ret, None, b)) => match edp_alias_fn_type(stmts, ty) {
        Some(TyFn(fps, fr, Some(row))) => if edp_literal_calls_local(EFn(tps, tbs, ps, ret, None, b), b, [
        ]) {
          ()
        } else {
          Array::set(stmts, i, SLet(exported, is_rec, nm, Some(TyFn(fps, fr, Some(row))), EFn(tps, tbs, ps, ret, Some(row), b)))
        },
        _ => ()
      },
      _ => ()
    }
    i = i + 1
  }
  ()
}

/// Does `e` contain a named call with a row-free closure literal argument, a
/// row-free top-level function passed by name, or a `let`-bound row-free
/// literal? A read-only scan, so a statement with none is not rebuilt
/// (#1875).
fn edp_expr_passes_literal_arg(e: Expr, pure_names: MutSet[String]) -> Bool {
  let mut found = false
  let stack: Array[Expr] = [e]
  while !found && Array::length(stack) > 0 {
    let n = Array::length(stack)
    let cur = Array::get(stack, n - 1)
    Array::truncate(stack, n - 1)
    match cur {
      ECall(EIdent(_, _), args, _, _) => if edp_args_pass_literal(args, pure_names) {
        found = true
      },
      // Codex on #3467: a method-style call too (`runner.run(() -> ..)`).
      ECall(EDot(_, _, _, _), args, _, _) => if edp_args_pass_literal(args, pure_names) {
        found = true
      },
      ECall(EFn(_, _, _, _, _, _), cargs, _, _) => if Array::length(cargs) == 1 {
        match Array::get(cargs, 0) {
          EFn(_, _, _, _, None, _) => {
            found = true
          },
          _ => ()
        }
      } else {
        ()
      },
      // A row-free one may take a row from its uses; one with a row is
      // bound under a name of its own (`edp_unique_row_lit_name`, #3416).
      ELet(_, EFn(_, _, _, _, _, _), _, _) => {
        found = true
      },
      // A lambda that returns a closure at a declared row (Codex on #3447).
      EFn(_, _, _, Some(TyFn(_, _, Some(_))), _, _) => {
        found = true
      },
      // #3582: or a tuple that may hold one.
      EFn(_, _, _, Some(TyTuple(_)), _, _) => {
        found = true
      },
      _ => ()
    }
    expr_children_into(cur, stack)
  }
  found
}

/// Does a literal's `body` call a local binding -- one in `scope`, one the
/// literal binds itself, or a local closure already hoisted to a top-level
/// `__hoisted_lam_*` function? The migration cannot see through such a call,
/// so stamping it would turn an accepted program into a refused one; such a
/// literal is left as written.
fn edp_literal_calls_local(lit: Expr, body: Expr, scope: Array[String]) -> Bool {
  // Scoped as the copy's own census is (`edp_call_census`): a call counts as
  // the literal's own binder only where that binder is in scope, so a call to
  // a top-level `helper` beside a `let helper` in another branch is not one
  // (Codex on #3437). Read unscoped, it left the literal unstamped and the
  // callee's dict met a closure of its source arity.
  let names: Array[String] = []
  match lit {
    EFn(_, _, ps, _, _, _) => {
      let mut pi = 0
      while pi < Array::length(ps) {
        Array::push(names, edp_param_base_name(Array::get(ps, pi).0))
        pi = pi + 1
      }
    },
    _ => ()
  }
  let called: Array[String] = []
  !edp_call_census(body, names, scope, called) || Array::length(called) > 0
}

/// #3424: the closure literals `let`-bound around the expression the stamp is
/// walking, innermost last, each with the index its name has in `scope`.
let edp_local_lit_names: Array[String] = []
let edp_local_lit_slots: Array[Int] = []
let edp_local_lit_vals: Array[Expr] = []

/// #3424: the `scope` indices of the mutable bindings (`let mut`, `loop`)
/// around the walk, and the snapshots `edp_copy_snapshots` asked for: a fresh
/// name bound to `src` right after the closure at slot, which is where `src`
/// still names what the closure reads.
let edp_local_mut_slots: Array[Int] = []
let edp_snap_slots: Array[Int] = []
let edp_snap_fresh: Array[String] = []
let edp_snap_src: Array[String] = []
let edp_snap_counter: Array[Int] = [0]

/// Every name the program binds or declares, so a snapshot's name is one
/// nothing in the program spells. Filled from `edp_snap_program` on the first
/// snapshot, so a compile that needs none pays nothing for it.
let edp_snap_taken: Array[MutSet[String]] = []
let edp_snap_program: Array[(Array[Stmt], Array[(Int, Bool, Bool, String, Option[TypeExpr], String)])] = [
]

fn edp_snap_taken_set() -> Unit {
  if Array::length(edp_snap_taken) == 0 && Array::length(edp_snap_program) > 0 {
    let (stmts, fn_defs) = Array::get(edp_snap_program, 0)
    let taken = edp_collect_program_binders(stmts)
    for st in stmts {
      match st {
        SLet(_, _, tn, _, _) => MutSet::insert(taken, tn),
        SLetMut(tn, _, _) => MutSet::insert(taken, tn),
        _ => ()
      }
    }
    for def in fn_defs {
      let (_, _, _, dname, _, _) = def
      MutSet::insert(taken, dname)
    }
    Array::push(edp_snap_taken, taken)
  } else {
    ()
  }
}

fn edp_snap_fresh_name(name: String) -> String {
  edp_snap_taken_set()
  let mut fresh = ""
  let mut found = false
  while !found {
    let k = Array::get(edp_snap_counter, 0)
    Array::set(edp_snap_counter, 0, k + 1)
    fresh = String::concat("__edpc", String::concat(Int::to_string(k), String::concat("_", name)))
    found = Array::length(edp_snap_taken) == 0 || !MutSet::has(Array::get(edp_snap_taken, 0), fresh)
  }
  if Array::length(edp_snap_taken) > 0 {
    MutSet::insert(Array::get(edp_snap_taken, 0), fresh)
  } else {
    ()
  }
  fresh
}

/// #3416: a closure literal with a row of its own, `let`-bound, under a name
/// no other binder of the program spells. The migration passes the dict at a
/// call through a name bound to such a literal, and it decides that by NAME:
/// a name some other binder also spells is dropped from that set
/// (`edp_filter_unpoisoned`), while the literal still takes the dict
/// parameter. So `let run = () -> Int with Box[Int] { .. }; run()` in one
/// function and `let run = (x: Int) -> Int { .. }` in another compiled to a
/// call with one argument too few and trapped ("null function or function
/// signature mismatch"). The body is left as written when it holds a part the
/// rename cannot read (an interpolation's text).
fn edp_unique_row_lit_name(name: String, v: Expr, body: Expr) -> (String, Expr) {
  match v {
    EFn(_, _, _, _, Some(row), _) => if String::length(String::trim(row)) == 0 {
      (name, body)
    } else {
      let free: Array[String] = []
      edp_free_names(body, empty_str_array(), free)
      if edp_str_array_contains(free, edp_free_names_opaque) {
        (name, body)
      } else {
        let fresh = edp_snap_fresh_name(name)
        (fresh, edp_rename_free(body, name, fresh))
      }
    },
    _ => (name, body)
  }
}

/// #3424: a row-free literal at a row-typed slot that calls local closures
/// (`let helper = () -> 3; run_str(() -> helper())`), rebuilt with a copy of
/// each one's binding at the top of its body, or None.
///
/// The literal is left at arity 0 otherwise and traps when the callee passes
/// it a dict. Stamping it as written is refused: the migration's eligibility
/// scan reads the literal's body on its own, where `helper` is an unknown
/// call. With the binding copied in, the scan reads `helper`'s literal at its
/// definition and the call through it as a call through a local literal, the
/// shape it already rewrites -- a perform inside `helper` takes the dict the
/// callee passes, which is the handler a perform reaches at run time.
///
/// The copy must mean what the original binding means. So every local the
/// literal calls must be a row-free closure literal bound by `let`, not one of
/// the literal's own binders, nor a hoisted lambda, nor a closure that itself
/// calls a local. A name the copy reads that is rebound between its definition
/// and the literal, or by the literal's parameters, is read through a snapshot
/// taken right after the closure (`edp_copy_snapshots`); where no snapshot is
/// sound the copy is declined.
fn edp_copy_local_helpers(tps: Array[String], tbs: Array[(String, Array[String])], ps: Array[(String, Option[TypeExpr])], ret: Option[TypeExpr], body: Expr, scope: Array[String]) -> Option[Expr] {
  let param_names: Array[String] = []
  for p in ps {
    Array::push(param_names, edp_param_base_name(p.0))
  }
  // Scoped (Codex on #3437): a name the literal binds only shadows the outer
  // local where that binding is in scope, so a call to the outer `helper`
  // still counts beside an inner `helper` bound in another branch.
  let called: Array[String] = []
  let mut ok = edp_call_census(body, param_names, scope, called)
  // Each copy, outermost binding first, so a later one may mention an earlier.
  let slots: Array[Int] = []
  let vals: Array[Expr] = []
  // Snapshots the copies need, committed only when every copy is made.
  let snaps: Array[(Int, String, String)] = []
  let mut ci = 0
  while ok && ci < Array::length(called) {
    let cn = Array::get(called, ci)
    let slot = edp_scope_last_index(scope, cn)
    let found = edp_local_lit_at(cn, slot)
    match found {
      Some(EFn(_, _, _, _, None, hb)) => {
        let helper = Array::get(edp_local_lit_vals, edp_local_lit_index(cn, slot))
        if edp_literal_calls_local(helper, hb, scope) {
          ok = false
        } else {
          match edp_copy_snapshots(helper, cn, slot, scope, param_names, snaps) {
            Some(renamed) => {
              Array::push(slots, slot)
              Array::push(vals, renamed)
            },
            None => {
              ok = false
            }
          }
        }
      },
      _ => {
        ok = false
      }
    }
    ci = ci + 1
  }
  if ok && Array::length(vals) > 0 {
    for snap in snaps {
      Array::push(edp_snap_slots, snap.0)
      Array::push(edp_snap_fresh, snap.1)
      Array::push(edp_snap_src, snap.2)
    }
  } else {
    ()
  }
  if !ok || Array::length(vals) == 0 {
    None
  } else {
    // Innermost first while wrapping, so the outermost ends up outside.
    let mut out = body
    let mut k = Array::length(called)
    while k > 0 {
      let mut best = 0 - 1
      let mut bi = 0
      while bi < Array::length(slots) {
        if Array::get(slots, bi) >= 0 && (best < 0 || Array::get(slots, bi) > Array::get(slots, best)) {
          best = bi
        } else {
          ()
        }
        bi = bi + 1
      }
      out = ELet(Array::get(called, best), Array::get(vals, best), out, -1)
      Array::set(slots, best, 0 - 1)
      k = k - 1
    }
    Some(EFn(tps, tbs, ps, ret, None, out))
  }
}

/// The locals in `scope` that `e` calls, into `called`, with the binders
/// around each call scoped as `edp_free_names` scopes them. False when `e`
/// calls something the copy cannot stand for: a name `bound` holds (the
/// literal's own binders and parameters, whose meaning the migration cannot
/// see through) or a hoisted lambda.
fn edp_call_census(e: Expr, bound: Array[String], scope: Array[String], called: Array[String]) -> Bool {
  match e {
    ECall(EIdent(cn, _), args, _, _) => {
      let here = if edp_str_array_contains(bound, cn) || String::starts_with(cn, "__hoisted_lam_") {
        false
      } else {
        if edp_scope_has(scope, cn) && !edp_str_array_contains(called, cn) {
          Array::push(called, cn)
        } else {
          ()
        }
        true
      }
      let mut ok = here
      for a in args {
        ok = ok && edp_call_census(a, bound, scope, called)
      }
      ok
    },
    ELet(n, v, b, _) => edp_call_census(v, bound, scope, called) && edp_call_census(b, edp_names_with(bound, [
      n
    ]), scope, called),
    ELetMut(n, v, b, _) => edp_call_census(v, bound, scope, called) && edp_call_census(b, edp_names_with(bound, [
      n
    ]), scope, called),
    ELetRec(n, v, b) => {
      let inner = edp_names_with(bound, [n])
      edp_call_census(v, inner, scope, called) && edp_call_census(b, inner, scope, called)
    },
    EFn(_, _, fps, _, _, fb) => {
      let names: Array[String] = []
      for p in fps {
        Array::push(names, edp_param_base_name(p.0))
      }
      edp_call_census(fb, edp_names_with(bound, names), scope, called)
    },
    EMatch(sc, arms) => {
      let mut ok = edp_call_census(sc, bound, scope, called)
      for arm in arms {
        ok = ok && edp_call_census(arm.1, edp_names_with(bound, edp_pat_names(arm.0)), scope, called)
      }
      ok
    },
    EHandle(bd, arms) => {
      let mut ok = edp_call_census(bd, bound, scope, called)
      for arm in arms {
        ok = ok && edp_call_census(arm.1, edp_names_with(bound, edp_pat_names(arm.0)), scope, called)
      }
      ok
    },
    EForIn(n, idx, it, b) => {
      let names = [n]
      match idx {
        Some(i) => Array::push(names, i),
        None => ()
      }
      edp_call_census(it, bound, scope, called) && edp_call_census(b, edp_names_with(bound, names), scope, called)
    },
    ELoop(pairs, b) => {
      let mut ok = true
      let names: Array[String] = []
      for pair in pairs {
        ok = ok && edp_call_census(pair.1, bound, scope, called)
        Array::push(names, pair.0)
      }
      ok && edp_call_census(b, edp_names_with(bound, names), scope, called)
    },
    _ => {
      let mut ok = true
      for child in expr_children(e) {
        ok = ok && edp_call_census(child, bound, scope, called)
      }
      ok
    }
  }
}

/// #3424: the copy of `helper` (bound to `cn` at `slot`) to put in the literal,
/// or None. A name the copy reads that is rebound between the closure and the
/// literal, or by the literal's parameters, would read that other binding once
/// copied. When the binding the closure reads is an immutable local, the copy
/// reads a snapshot of it instead -- `let fresh = name`, bound right after the
/// closure, where `name` still means what the closure saw (queued in `snaps`).
/// A mutable one (`let mut`, a `loop` variable), the closure's own name, a
/// name that is not local, or text the walk cannot read (an interpolation)
/// declines the copy.
fn edp_copy_snapshots(helper: Expr, cn: String, slot: Int, scope: Array[String], param_names: Array[String], snaps: Array[(Int, String, String)]) -> Option[Expr] {
  let free: Array[String] = []
  edp_free_names(helper, [], free)
  let mut ok = true
  let mut out = helper
  for name in free {
    if !ok {
      ()
    } else if name == edp_free_names_opaque {
      ok = false
    } else if edp_str_array_contains(param_names, name) || edp_scope_index_after(scope, name, slot) {
      let j = edp_scope_last_index_before(scope, name, slot)
      if j < 0 || name == cn || edp_int_array_has(edp_local_mut_slots, j) {
        ok = false
      } else {
        let fresh = edp_snap_fresh_name(name)
        Array::push(snaps, (slot, fresh, name))
        out = edp_rename_free(out, name, fresh)
      }
    } else {
      ()
    }
  }
  if ok {
    Some(out)
  } else {
    None
  }
}

/// `body` of the closure bound at `slot`, under the snapshots queued for it.
fn edp_wrap_snapshots(body: Expr, slot: Int) -> Expr {
  let mut out = body
  let keep_slots: Array[Int] = []
  let keep_fresh: Array[String] = []
  let keep_src: Array[String] = []
  let mut i = 0
  while i < Array::length(edp_snap_slots) {
    if Array::get(edp_snap_slots, i) == slot {
      out = ELet(Array::get(edp_snap_fresh, i), EIdent(Array::get(edp_snap_src, i), 0 - 1), out, -1)
    } else {
      Array::push(keep_slots, Array::get(edp_snap_slots, i))
      Array::push(keep_fresh, Array::get(edp_snap_fresh, i))
      Array::push(keep_src, Array::get(edp_snap_src, i))
    }
    i = i + 1
  }
  if Array::length(keep_slots) != Array::length(edp_snap_slots) {
    Array::truncate(edp_snap_slots, 0)
    Array::truncate(edp_snap_fresh, 0)
    Array::truncate(edp_snap_src, 0)
    let mut k = 0
    while k < Array::length(keep_slots) {
      Array::push(edp_snap_slots, Array::get(keep_slots, k))
      Array::push(edp_snap_fresh, Array::get(keep_fresh, k))
      Array::push(edp_snap_src, Array::get(keep_src, k))
      k = k + 1
    }
  } else {
    ()
  }
  out
}

/// The innermost index of `name` in `scope` below `slot`, or -1.
fn edp_scope_last_index_before(scope: Array[String], name: String, slot: Int) -> Int {
  let mut i = if slot < Array::length(scope) {
    slot
  } else {
    Array::length(scope)
  }
  let mut found = 0 - 1
  while found < 0 && i > 0 {
    i = i - 1
    if Array::get(scope, i) == name {
      found = i
    } else {
      ()
    }
  }
  found
}

fn edp_int_array_has(xs: Array[Int], x: Int) -> Bool {
  let mut found = false
  for v in xs {
    if v == x {
      found = true
    } else {
      ()
    }
  }
  found
}

fn edp_scope_last_index(scope: Array[String], name: String) -> Int {
  let mut i = Array::length(scope)
  let mut found = 0 - 1
  while found < 0 && i > 0 {
    i = i - 1
    if Array::get(scope, i) == name {
      found = i
    } else {
      ()
    }
  }
  found
}

fn edp_scope_index_after(scope: Array[String], name: String, slot: Int) -> Bool {
  let mut i = slot + 1
  let mut found = false
  while !found && i < Array::length(scope) {
    found = Array::get(scope, i) == name
    i = i + 1
  }
  found
}

/// The index in `edp_local_lit_*` of the literal bound to `name` at `slot`, or
/// -1. A name rebound at another slot (a parameter, a pattern) is not it.
fn edp_local_lit_index(name: String, slot: Int) -> Int {
  let mut i = Array::length(edp_local_lit_names)
  let mut found = 0 - 1
  while found < 0 && i > 0 {
    i = i - 1
    if Array::get(edp_local_lit_names, i) == name && Array::get(edp_local_lit_slots, i) == slot {
      found = i
    } else {
      ()
    }
  }
  found
}

/// #3424: the first local a literal calls that is no `let`-bound literal
/// (true), else the first it calls (false).
fn edp_uncopiable_local(body: Expr, ps: Array[(String, Option[TypeExpr])], scope: Array[String]) -> (String, Bool) {
  let called: Array[String] = []
  let _ = edp_call_census(body, for p in ps {
    edp_param_base_name(p.0)
  }, scope, called)
  let mut out = ("", false)
  for cn in called {
    match edp_local_lit_at(cn, edp_scope_last_index(scope, cn)) {
      None => if !out.1 {
        out = (cn, true)
      },
      Some(_) => if out.0 == "" {
        out = (cn, false)
      }
    }
  }
  out
}

fn edp_local_lit_at(name: String, slot: Int) -> Option[Expr] {
  let i = if slot < 0 {
    0 - 1
  } else {
    edp_local_lit_index(name, slot)
  }
  if i < 0 {
    None
  } else {
    Some(Array::get(edp_local_lit_vals, i))
  }
}

/// The arity and row of the function type a top-level function's parameter
/// `pos` declares, when that type carries a row.
fn edp_slot_fn_type(stmts: Array[Stmt], fn_index: MutMap[String, Array[Int]], callee: String, pos: Int) -> Option[(Int, String)] {
  match edp_indexed_params_of_fn(stmts, fn_index, callee) {
    Some(params) => if pos < Array::length(params) {
      let (_, pty) = Array::get(params, pos)
      match pty {
        Some(TyFn(ptys, _, Some(row))) => if edp_slot_row_stampable(row) {
          Some((Array::length(ptys), row))
        } else {
          None
        },
        _ => None
      }
    } else {
      None
    },
    None => None
  }
}

/// `(p0, .., pn) -> name(p0, .., pn)` under `row`: a row-free function passed
/// by name at a row-typed slot, wrapped so the dict its callee passes has a
/// parameter to land in (#3424).
fn edp_slot_wrapper(name: String, arity: Int, row: String) -> Expr {
  let params: Array[(String, Option[TypeExpr])] = []
  let args: Array[Expr] = []
  // The parameters must not shadow `name` inside the wrapper; a function
  // spelled with the usual prefix gets the other one (Codex on #3426).
  let prefix = if String::starts_with(name, "__edpw_") {
    "__edpx_"
  } else {
    "__edpw_"
  }
  let mut k = 0
  while k < arity {
    let pn = String::concat(prefix, Int::to_string(k))
    Array::push(params, (pn, None))
    Array::push(args, EIdent(pn, 0 - 1))
    k = k + 1
  }
  EFn([], [], params, None, Some(row), ECall(EIdent(name, 0 - 1), args, 0 - 1, [
  ]))
}

/// The row a top-level function's parameter `pos` declares on its function
/// type, or None.
fn edp_slot_row(stmts: Array[Stmt], fn_index: MutMap[String, Array[Int]], callee: String, pos: Int) -> Option[String] {
  match edp_indexed_params_of_fn(stmts, fn_index, callee) {
    Some(params) => if pos < Array::length(params) {
      let (_, pty) = Array::get(params, pos)
      match pty {
        Some(TyFn(_, _, Some(row))) => if edp_slot_row_stampable(row) {
          Some(row)
        } else {
          None
        },
        _ => None
      }
    } else {
      None
    },
    None => None
  }
}

fn edp_stamp_expr(e: Expr, stmts: Array[Stmt], fn_index: MutMap[String, Array[Int]], scope: Array[String], pure_names: MutSet[String]) -> Expr {
  match e {
    ECall(callee, args, off, res) => match edp_alias_ascribed_literal(callee, args, stmts, scope) {
      Some(lit) => edp_stamp_expr(lit, stmts, fn_index, scope, pure_names),
      None => edp_stamp_call(callee, args, off, res, stmts, fn_index, scope, pure_names)
    },
    EFn(tps, tbs, params, ret, eff, body) => {
      let base = Array::length(scope)
      for param in params {
        Array::push(scope, edp_param_base_name(param.0))
      }
      edp_note_params(base, params)
      let body1 = edp_stamp_expr(body, stmts, fn_index, scope, pure_names)
      // A local lambda whose declared result is a function type with a row
      // returns a closure its caller calls with the dict, as a top-level
      // function does (Codex on #3447).
      let body2 = match ret {
        Some(rty) => match edp_stamp_declared_result(body1, rty, stmts, scope, pure_names) {
          Some(b2) => b2,
          None => body1
        },
        None => body1
      }
      Array::truncate(scope, base)
      edp_drop_params_from(base)
      EFn(tps, tbs, params, ret, eff, body2)
    },
    ELet(n0, v, b0, off) => {
      let v2 = edp_stamp_let_literal(n0, edp_stamp_expr(v, stmts, fn_index, scope, pure_names), b0, stmts, fn_index, scope)
      let (n, b) = edp_unique_row_lit_name(n0, v2, b0)
      // #3424: a closure literal stays visible to a literal in its body that
      // calls it (`edp_copy_local_helpers` copies only a row-free one), and
      // to an argument written at one of its row-typed parameters
      // (`edp_local_slot_fn_type`, #3416), whether or not it has a row.
      let mark = Array::length(edp_local_lit_names)
      match v2 {
        EFn(_, _, _, _, _, _) => {
          Array::push(edp_local_lit_names, n)
          Array::push(edp_local_lit_slots, Array::length(scope))
          Array::push(edp_local_lit_vals, v2)
        },
        _ => ()
      }
      let hslot = Array::length(scope)
      let b2 = edp_stamp_scoped(b, [n], stmts, fn_index, scope, pure_names)
      Array::truncate(edp_local_lit_names, mark)
      Array::truncate(edp_local_lit_slots, mark)
      Array::truncate(edp_local_lit_vals, mark)
      ELet(n, v2, edp_wrap_snapshots(b2, hslot), off)
    },
    ELetRec(n, v, b) => ELetRec(n, edp_stamp_scoped(v, [n], stmts, fn_index, scope, pure_names), edp_stamp_scoped(b, [
      n
    ], stmts, fn_index, scope, pure_names)),
    ELetMut(n, v, b, off) => {
      let v2 = edp_stamp_expr(v, stmts, fn_index, scope, pure_names)
      let mmark = Array::length(edp_local_mut_slots)
      Array::push(edp_local_mut_slots, Array::length(scope))
      let b2 = edp_stamp_scoped(b, [n], stmts, fn_index, scope, pure_names)
      Array::truncate(edp_local_mut_slots, mmark)
      ELetMut(n, v2, b2, off)
    },
    ESeq(a, b) => ESeq(edp_stamp_expr(a, stmts, fn_index, scope, pure_names), edp_stamp_expr(b, stmts, fn_index, scope, pure_names)),
    EIf(c, t, el) => EIf(edp_stamp_expr(c, stmts, fn_index, scope, pure_names), edp_stamp_expr(t, stmts, fn_index, scope, pure_names), edp_stamp_expr(el, stmts, fn_index, scope, pure_names)),
    EMatch(sc, arms) => EMatch(edp_stamp_expr(sc, stmts, fn_index, scope, pure_names), for a in arms {
      let (pp, ex) = a
      (pp, edp_stamp_scoped(ex, edp_pat_names(pp), stmts, fn_index, scope, pure_names))
    }),
    EHandle(bd, arms) => EHandle(edp_stamp_expr(bd, stmts, fn_index, scope, pure_names), for a in arms {
      let (pp, ex) = a
      (pp, edp_stamp_scoped(ex, edp_pat_names(pp), stmts, fn_index, scope, pure_names))
    }),
    EWhile(c, b) => EWhile(edp_stamp_expr(c, stmts, fn_index, scope, pure_names), edp_stamp_expr(b, stmts, fn_index, scope, pure_names)),
    EForIn(n, idx, it, b) => {
      let it2 = edp_stamp_expr(it, stmts, fn_index, scope, pure_names)
      let names = [n]
      match idx {
        Some(iname) => Array::push(names, iname),
        None => ()
      }
      EForIn(n, idx, it2, edp_stamp_scoped(b, names, stmts, fn_index, scope, pure_names))
    },
    ELoop(pairs, b) => {
      let names: Array[String] = []
      let pairs2 = for pr in pairs {
        let (n, v) = pr
        Array::push(names, n)
        (n, edp_stamp_expr(v, stmts, fn_index, scope, pure_names))
      }
      let mmark = Array::length(edp_local_mut_slots)
      let mut li = 0
      while li < Array::length(names) {
        Array::push(edp_local_mut_slots, Array::length(scope) + li)
        li = li + 1
      }
      let b2 = edp_stamp_scoped(b, names, stmts, fn_index, scope, pure_names)
      Array::truncate(edp_local_mut_slots, mmark)
      ELoop(pairs2, b2)
    },
    EBinOp(op, l, r, boff) => EBinOp(op, edp_stamp_expr(l, stmts, fn_index, scope, pure_names), edp_stamp_expr(r, stmts, fn_index, scope, pure_names), boff),
    EUnaryOp(op, x) => EUnaryOp(op, edp_stamp_expr(x, stmts, fn_index, scope, pure_names)),
    EAssign(n, v, c, target_off) => EAssign(n, edp_stamp_expr(v, stmts, fn_index, scope, pure_names), edp_stamp_expr(c, stmts, fn_index, scope, pure_names), target_off),
    EAssignOp(n, op, v, c, target_off) => EAssignOp(n, op, edp_stamp_expr(v, stmts, fn_index, scope, pure_names), edp_stamp_expr(c, stmts, fn_index, scope, pure_names), target_off),
    EReturn(x) => EReturn(edp_stamp_expr(x, stmts, fn_index, scope, pure_names)),
    EDot(o, f, o1, o2) => EDot(edp_stamp_expr(o, stmts, fn_index, scope, pure_names), f, o1, o2),
    ELabeledArg(l, n, v) => ELabeledArg(l, n, edp_stamp_expr(v, stmts, fn_index, scope, pure_names)),
    EBreak(opt) => EBreak(match opt {
      Some(x) => Some(edp_stamp_expr(x, stmts, fn_index, scope, pure_names)),
      None => None
    }),
    EContinue(args) => EContinue(for a in args {
      edp_stamp_expr(a, stmts, fn_index, scope, pure_names)
    }),
    ETuple(items) => ETuple(for a in items {
      edp_stamp_expr(a, stmts, fn_index, scope, pure_names)
    }),
    EArray(items) => EArray(for a in items {
      edp_stamp_expr(a, stmts, fn_index, scope, pure_names)
    }),
    // #3582: a field whose declared type carries a row is a slot like a
    // parameter of that type: whoever reads the field calls it with the dict.
    ERecord(n, fields, tas) => ERecord(n, for f in fields {
      let (fn2, v) = f
      let v2 = edp_stamp_expr(v, stmts, fn_index, scope, pure_names)
      match edp_field_slot(n, fn2) {
        Some(slot) => {
          edp_set_slot_callee(edp_field_slot_callee(n, fn2), true)
          (fn2, edp_stamp_slot_arg_at(v2, scope, pure_names, Some(slot)))
        },
        None => (fn2, v2)
      }
    }, tas),
    EMap(fields) => EMap(for f in fields {
      let (fn2, v) = f
      (fn2, edp_stamp_expr(v, stmts, fn_index, scope, pure_names))
    }),
    ESpread(x) => ESpread(edp_stamp_expr(x, stmts, fn_index, scope, pure_names)),
    _ => e
  }
}

/// #3424: a row-free literal bound by `let` and passed by that name. When
/// every use of the name is an argument at a row-typed parameter of a
/// top-level function, and all those rows agree, the literal takes the row
/// the way one written at the slot does: the callee passes the dict, and the
/// literal had no parameter for it. Any other use (a direct call, a capture,
/// a slot without a row, two different rows) leaves it as written.
fn edp_stamp_let_literal(name: String, v: Expr, body: Expr, stmts: Array[Stmt], fn_index: MutMap[String, Array[Int]], scope: Array[String]) -> Expr {
  match v {
    EFn(tps, tbs, ps, ret, None, lb) => if edp_literal_calls_local(v, lb, scope) {
      v
    } else {
      let total = edp_count_ident_uses(body, name)
      let rows: Array[String] = []
      // The scan below does not track scopes, so a callee any binder in
      // `body` spells is taken to be that local, not the top-level function
      // (Codex on #3426).
      let inner = edp_collect_program_binders([SExpr(body)])
      edp_slot_uses_of(body, name, stmts, fn_index, scope, inner, rows)
      if total > 0 && Array::length(rows) == total && edp_rows_agree(rows) {
        EFn(tps, tbs, ps, ret, Some(Array::get(rows, 0)), lb)
      } else {
        v
      }
    },
    _ => v
  }
}

/// The slot rows of every use of `name` passed as an argument of a top-level
/// function. A use at a slot with no stampable row records "" so it never
/// agrees.
fn edp_slot_uses_of(e: Expr, name: String, stmts: Array[Stmt], fn_index: MutMap[String, Array[Int]], scope: Array[String], inner: MutSet[String], rows: Array[String]) -> Unit {
  let stack: Array[Expr] = [e]
  while Array::length(stack) > 0 {
    let n = Array::length(stack)
    let cur = Array::get(stack, n - 1)
    Array::truncate(stack, n - 1)
    match cur {
      ECall(EIdent(cn, _), args, _, _) => if !edp_scope_has(scope, cn) && !MutSet::has(inner, cn) && cn != name {
        let mut labeled = false
        for a in args {
          match a {
            ELabeledArg(_, _, _) => {
              labeled = true
            },
            _ => ()
          }
        }
        let mut ai = 0
        while ai < Array::length(args) {
          match Array::get(args, ai) {
            EIdent(an, _) => if an == name {
              Array::push(rows, if labeled {
                ""
              } else {
                edp_slot_row_or_empty(stmts, fn_index, cn, ai)
              })
            } else {
              ()
            },
            ELabeledArg(l, _, EIdent(an, _)) => if an == name {
              Array::push(rows, edp_slot_row_or_empty(stmts, fn_index, cn, edp_param_index_by_label(stmts, fn_index, cn, l)))
            } else {
              ()
            },
            _ => ()
          }
          ai = ai + 1
        }
      } else {
        ()
      },
      _ => ()
    }
    expr_children_into(cur, stack)
  }
  ()
}

fn edp_slot_row_or_empty(stmts: Array[Stmt], fn_index: MutMap[String, Array[Int]], callee: String, pos: Int) -> String {
  if pos < 0 {
    ""
  } else {
    match edp_slot_row(stmts, fn_index, callee, pos) {
      Some(row) => row,
      None => ""
    }
  }
}

fn edp_rows_agree(rows: Array[String]) -> Bool {
  let mut ok = Array::length(rows) > 0
  for r in rows {
    if r == "" || r != Array::get(rows, 0) {
      ok = false
    } else {
      ()
    }
  }
  ok
}

fn edp_stamp_call(callee: Expr, args: Array[Expr], off: Int, res: Array[Int], stmts: Array[Stmt], fn_index: MutMap[String, Array[Int]], scope: Array[String], pure_names: MutSet[String]) -> Expr {
  let callee2 = edp_stamp_expr(callee, stmts, fn_index, scope, pure_names)
  let mut labeled = false
  for a in args {
    match a {
      ELabeledArg(_, _, _) => {
        labeled = true
      },
      _ => ()
    }
  }
  // A callee a binding in scope shadows is not the top-level function; a
  // local lambda's own parameters are read instead (#3416).
  // Codex on #3467: a method-style call (`runner.run(h)`) whose method only
  // one slot-taking `T::run` spells is that function, its receiver the
  // first argument.
  let (named, shift) = match callee {
    EIdent(cn, _) => if edp_scope_has(scope, cn) {
      ("", 0)
    } else {
      (cn, 0)
    },
    EDot(_, m, _, _) => (edp_slot_method(m), 1),
    _ => ("", 0)
  }
  let local_callee = match callee {
    EIdent(cn, _) => if edp_scope_has(scope, cn) {
      cn
    } else {
      ""
    },
    _ => ""
  }
  let out: Array[Expr] = []
  let mut ai = 0
  while ai < Array::length(args) {
    let a2 = edp_stamp_expr(Array::get(args, ai), stmts, fn_index, scope, pure_names)
    // A labeled argument names its parameter; a positional one beside a
    // labeled one has no position to trust, so only the labeled one is
    // stamped there.
    let a3 = match a2 {
      ELabeledArg(l, m, v) => if String::length(named) > 0 {
        let lpos = edp_param_index_by_label(stmts, fn_index, named, l)
        edp_set_slot_callee(named, edp_callee_param_used(stmts, fn_index, named, lpos))
        ELabeledArg(l, m, edp_stamp_slot_arg(v, stmts, fn_index, scope, pure_names, named, lpos))
      } else {
        a2
      },
      other => if String::length(named) > 0 && !labeled {
        edp_set_slot_callee(named, edp_callee_param_used(stmts, fn_index, named, ai + shift))
        edp_stamp_slot_arg(other, stmts, fn_index, scope, pure_names, named, ai + shift)
      } else if String::length(local_callee) > 0 && !labeled {
        edp_set_slot_callee(local_callee, true)
        edp_stamp_slot_arg_at(other, scope, pure_names, edp_local_slot_fn_type(local_callee, scope, ai))
      } else {
        other
      }
    }
    Array::push(out, a3)
    ai = ai + 1
  }
  ECall(callee2, out, off, res)
}

/// #3347: `let side: Thunk = () -> Int { .. }` with `type Thunk = () -> Int
/// with Ask` reaches this pass as the identity ascription
/// `((__asc: Thunk) -> __asc)(lit)`, and the literal had no row: a direct
/// `() -> Int with Ask` annotation is folded into the literal by the parser,
/// an alias is not. The literal takes the alias's row, and the wrapper goes,
/// so the tree is the one the direct annotation gives.
fn edp_alias_ascribed_literal(callee: Expr, args: Array[Expr], stmts: Array[Stmt], scope: Array[String]) -> Option[Expr] {
  match callee {
    EFn(_, _, aparams, _, _, abody) => if Array::length(args) == 1 && edp_is_identity_ascription(aparams, abody) {
      let (_, aty) = Array::get(aparams, 0)
      match (aty, Array::get(args, 0)) {
        (Some(ty), EFn(tps, tbs, ps, ret, None, b)) => match edp_alias_fn_row(stmts, ty) {
          Some(row) => if edp_literal_calls_local(Array::get(args, 0), b, scope) {
            None
          } else {
            Some(EFn(tps, tbs, ps, ret, Some(row), b))
          },
          None => None
        },
        _ => None
      }
    } else {
      None
    },
    _ => None
  }
}

/// `e` walked with `names` bound on top of `scope`.
fn edp_stamp_scoped(e: Expr, names: Array[String], stmts: Array[Stmt], fn_index: MutMap[String, Array[Int]], scope: Array[String], pure_names: MutSet[String]) -> Expr {
  let base = Array::length(scope)
  for n in names {
    Array::push(scope, n)
  }
  let out = edp_stamp_expr(e, stmts, fn_index, scope, pure_names)
  Array::truncate(scope, base)
  out
}

/// One argument at the parameter `pos` of the top-level `callee` (-1: no
/// such parameter). A row-free literal takes the slot's row (#3370), and a
/// row-free top-level function passed by name is wrapped (#3424).
fn edp_stamp_slot_arg(a: Expr, stmts: Array[Stmt], fn_index: MutMap[String, Array[Int]], scope: Array[String], pure_names: MutSet[String], callee: String, pos: Int) -> Expr {
  if pos < 0 {
    a
  } else {
    edp_stamp_slot_arg_at(a, scope, pure_names, edp_slot_fn_type(stmts, fn_index, callee, pos))
  }
}

/// One argument at a parameter whose function type is `slot` (its arity and
/// row), or left as written when the slot carries no stampable row. The slot
/// is read first, so a literal is copied (`edp_copy_local_helpers`, which
/// queues snapshots) only where it will be stamped.
fn edp_stamp_slot_arg_at(a: Expr, scope: Array[String], pure_names: MutSet[String], slot: Option[(Int, String)]) -> Expr {
  // #3424: the call this argument is passed to, for a refusal's message.
  let callee = edp_take_slot_callee()
  match slot {
    None => a,
    Some((arity, row)) => match a {
      EFn(tps, tbs, ps, ret, None, b) => {
        let lit = if edp_literal_calls_local(a, b, scope) {
          edp_copy_local_helpers(tps, tbs, ps, ret, b, scope)
        } else {
          Some(a)
        }
        match lit {
          Some(EFn(ltps, ltbs, lps, lret, None, lb)) => EFn(ltps, ltbs, lps, lret, Some(row), lb),
          _ => {
            edp_refuse_uncopied_literal(callee, row, edp_uncopiable_local(b, ps, scope))
            a
          }
        }
      },
      EIdent(an, _) => if MutSet::has(pure_names, an) && !edp_scope_has(scope, an) {
        edp_slot_wrapper(an, arity, row)
      } else {
        if edp_scope_has(scope, an) {
          edp_refuse_rowless_param(an, edp_scope_last_index(scope, an), callee, row)
        } else {
          ()
        }
        a
      },
      ECall(EIdent(fname, _), _, _, _) => {
        if !edp_scope_has(scope, fname) && Array::length(edp_snap_program) > 0 {
          let (pstmts, pdefs) = Array::get(edp_snap_program, 0)
          edp_refuse_rowless_result(pstmts, pdefs, fname, callee, row)
        } else {
          ()
        }
        a
      },
      ECall(EDot(_, m, _, _), _, _, _) => {
        if Array::length(edp_snap_program) > 0 {
          let (pstmts, pdefs) = Array::get(edp_snap_program, 0)
          edp_refuse_rowless_method_result(pstmts, pdefs, m, callee, row)
        }
        a
      },
      _ => a
    }
  }
}

/// #3416: the slot at `pos` of a LOCAL lambda the call names -- a literal
/// bound by `let` in scope -- read from its parameter annotation the
/// way `edp_slot_fn_type` reads a top-level function's. Its handle passes a
/// row-typed parameter the dict (`edp_rh_extend`), so a callback literal
/// written there needs the parameter too.
fn edp_local_slot_fn_type(callee: String, scope: Array[String], pos: Int) -> Option[(Int, String)] {
  match edp_local_lit_at(callee, edp_scope_last_index(scope, callee)) {
    Some(EFn(_, _, params, _, _, _)) => if pos >= 0 && pos < Array::length(params) {
      let (_, pty) = Array::get(params, pos)
      match pty {
        Some(TyFn(ptys, _, Some(row))) => if edp_slot_row_stampable(row) {
          Some((Array::length(ptys), row))
        } else {
          None
        },
        _ => None
      }
    } else {
      None
    },
    _ => None
  }
}

fn edp_scope_has(scope: Array[String], name: String) -> Bool {
  let mut i = Array::length(scope)
  let mut found = false
  while !found && i > 0 {
    i = i - 1
    if Array::get(scope, i) == name {
      found = true
    } else {
      ()
    }
  }
  found
}

/// A parameter's name without its labeled (`~`) or optional (`?`) marker.

/// The index of the parameter of the top-level `callee` a label names, or -1.
fn edp_param_index_by_label(stmts: Array[Stmt], fn_index: MutMap[String, Array[Int]], callee: String, label: String) -> Int {
  match edp_indexed_params_of_fn(stmts, fn_index, callee) {
    Some(params) => {
      let mut found = 0 - 1
      let mut i = 0
      while found < 0 && i < Array::length(params) {
        let (pn, _) = Array::get(params, i)
        if edp_param_base_name(pn) == label {
          found = i
        } else {
          ()
        }
        i = i + 1
      }
      found
    },
    None => 0 - 1
  }
}

/// #1261: is `nm`'s value legal to hand to parameter `pos` of `callee_nm`?
/// The evidence migration prepends a dict parameter to every needing
/// function, and a call THROUGH a parameter only gets the dict prepended
/// when that parameter's declared type carries the row
/// (edp_row_typed_param_names). So a needing function reaching a row-FREE
/// function-typed slot is compiled at one arity and called at another --
/// wasm's own `null function or function signature mismatch`.
fn edp_arg_slot_accepts_needing(stmts: Array[Stmt], fn_defs: Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], callee_nm: String, pos: Int, ename: String, es_names: Array[String], es_members_list: Array[Array[String]]) -> Bool {
  // Deliberately accept unless the slot is PROVEN row-free-and-function-
  // typed: an unknown callee (a local binding aliasing a needing function
  // -- fixtures/effect_local_closure_wrapper_referenced_as_value.vibe), an
  // unannotated parameter, or a non-function annotation all stay legal, so
  // this guard only fires on the shape that demonstrably traps.
  match edp_params_of_fn(stmts, fn_defs, callee_nm) {
    Some(params) => if pos < Array::length(params) {
      let (_, pty) = Array::get(params, pos)
      match pty {
        Some(TyFn(_, _, _)) => edp_type_is_fn_row_exactly(pty, ename, es_names, es_members_list),
        _ => true
      }
    } else {
      true
    },
    None => true
  }
}

/// #1261: the first needing-function name that ESCAPES as a value into a
/// slot the migration cannot reach (see edp_arg_slot_accepts_needing), or
/// "" when every use is a direct call or a row-carrying parameter slot.
///
/// This is the codegen-side backstop for the fact that the checker and this
/// pass classify the SAME closure literal differently: the checker charges a
/// literal's `perform` to the ENCLOSING function and leaves the literal
/// itself row-free, while dlh_hoist_expr backfills the row from the body
/// (追記20) so the hoisted function lands in `needing` here. Nothing on the
/// checker side then rejects handing that value to a row-free `(x) -> y`
/// parameter. Per 追記34 V2, an un-migratable shape is a hard error, never a
/// silent fallback -- the alternative is a runtime trap.
fn edp_needing_escape(e: Expr, needing: Array[String], ename: String, stmts: Array[Stmt], fn_defs: Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], es_names: Array[String], es_members_list: Array[Array[String]]) -> String {
  match e {
    ECall(callee, args, _, _) => {
      let callee_nm = match callee {
        EIdent(cn, _) => cn,
        _ => ""
      }
      let mut hit = if callee_nm == "" {
        edp_needing_escape(callee, needing, ename, stmts, fn_defs, es_names, es_members_list)
      } else {
        ""
      }
      let mut i = 0
      while i < Array::length(args) && hit == "" {
        let a = Array::get(args, i)
        let bare = match a {
          EIdent(an, _) => if edp_str_array_contains(needing, an) {
            an
          } else {
            ""
          },
          _ => ""
        }
        if bare == "" {
          hit = edp_needing_escape(a, needing, ename, stmts, fn_defs, es_names, es_members_list)
        } else if callee_nm != "" && edp_arg_slot_accepts_needing(stmts, fn_defs, callee_nm, i, ename, es_names, es_members_list) {
          ()
        } else {
          hit = bare
        }
        i = i + 1
      }
      hit
    },
    EFn(_, _, _, _, _, b) => edp_needing_escape(b, needing, ename, stmts, fn_defs, es_names, es_members_list),
    EHandle(b, arms) => edp_needing_escape_or(edp_needing_escape(b, needing, ename, stmts, fn_defs, es_names, es_members_list), edp_needing_escape_arms(arms, needing, ename, stmts, fn_defs, es_names, es_members_list)),
    EIf(c, t, el) => edp_needing_escape_or(edp_needing_escape(c, needing, ename, stmts, fn_defs, es_names, es_members_list), edp_needing_escape_or(edp_needing_escape(t, needing, ename, stmts, fn_defs, es_names, es_members_list), edp_needing_escape(el, needing, ename, stmts, fn_defs, es_names, es_members_list))),
    EMatch(s, arms) => edp_needing_escape_or(edp_needing_escape(s, needing, ename, stmts, fn_defs, es_names, es_members_list), edp_needing_escape_arms(arms, needing, ename, stmts, fn_defs, es_names, es_members_list)),
    EWhile(c, b) => edp_needing_escape_or(edp_needing_escape(c, needing, ename, stmts, fn_defs, es_names, es_members_list), edp_needing_escape(b, needing, ename, stmts, fn_defs, es_names, es_members_list)),
    EForIn(_, _, it, b) => edp_needing_escape_or(edp_needing_escape(it, needing, ename, stmts, fn_defs, es_names, es_members_list), edp_needing_escape(b, needing, ename, stmts, fn_defs, es_names, es_members_list)),
    ELoop(pairs, b) => edp_needing_escape_or(edp_needing_escape_pairs(pairs, needing, ename, stmts, fn_defs, es_names, es_members_list), edp_needing_escape(b, needing, ename, stmts, fn_defs, es_names, es_members_list)),
    ELet(_, v, b, _) => edp_needing_escape_or(edp_needing_escape(v, needing, ename, stmts, fn_defs, es_names, es_members_list), edp_needing_escape(b, needing, ename, stmts, fn_defs, es_names, es_members_list)),
    ELetMut(_, v, b, _) => edp_needing_escape_or(edp_needing_escape(v, needing, ename, stmts, fn_defs, es_names, es_members_list), edp_needing_escape(b, needing, ename, stmts, fn_defs, es_names, es_members_list)),
    ELetRec(_, v, b) => edp_needing_escape_or(edp_needing_escape(v, needing, ename, stmts, fn_defs, es_names, es_members_list), edp_needing_escape(b, needing, ename, stmts, fn_defs, es_names, es_members_list)),
    ESeq(a, b) => edp_needing_escape_or(edp_needing_escape(a, needing, ename, stmts, fn_defs, es_names, es_members_list), edp_needing_escape(b, needing, ename, stmts, fn_defs, es_names, es_members_list)),
    EBinOp(_, l, r, _) => edp_needing_escape_or(edp_needing_escape(l, needing, ename, stmts, fn_defs, es_names, es_members_list), edp_needing_escape(r, needing, ename, stmts, fn_defs, es_names, es_members_list)),
    EUnaryOp(_, x) => edp_needing_escape(x, needing, ename, stmts, fn_defs, es_names, es_members_list),
    EAssign(_, v, c, _) => edp_needing_escape_or(edp_needing_escape(v, needing, ename, stmts, fn_defs, es_names, es_members_list), edp_needing_escape(c, needing, ename, stmts, fn_defs, es_names, es_members_list)),
    EAssignOp(_, _, v, c, _) => edp_needing_escape_or(edp_needing_escape(v, needing, ename, stmts, fn_defs, es_names, es_members_list), edp_needing_escape(c, needing, ename, stmts, fn_defs, es_names, es_members_list)),
    EDot(o, _, _, _) => edp_needing_escape(o, needing, ename, stmts, fn_defs, es_names, es_members_list),
    ELabeledArg(_, _, v) => edp_needing_escape(v, needing, ename, stmts, fn_defs, es_names, es_members_list),
    EReturn(x) => edp_needing_escape(x, needing, ename, stmts, fn_defs, es_names, es_members_list),
    EBreak(opt) => match opt {
      Some(x) => edp_needing_escape(x, needing, ename, stmts, fn_defs, es_names, es_members_list),
      None => ""
    },
    EContinue(args) => edp_needing_escape_exprs(args, needing, ename, stmts, fn_defs, es_names, es_members_list),
    ETuple(items) => edp_needing_escape_exprs(items, needing, ename, stmts, fn_defs, es_names, es_members_list),
    EArray(items) => edp_needing_escape_exprs(items, needing, ename, stmts, fn_defs, es_names, es_members_list),
    ERecord(_, fields, _) => edp_needing_escape_pairs(fields, needing, ename, stmts, fn_defs, es_names, es_members_list),
    EMap(fields) => edp_needing_escape_pairs(fields, needing, ename, stmts, fn_defs, es_names, es_members_list),
    ESpread(x) => edp_needing_escape(x, needing, ename, stmts, fn_defs, es_names, es_members_list),
    _ => ""
  }
}

fn edp_needing_escape_or(a: String, b: String) -> String {
  if a == "" {
    b
  } else {
    a
  }
}

fn edp_needing_escape_exprs(es: Array[Expr], needing: Array[String], ename: String, stmts: Array[Stmt], fn_defs: Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], es_names: Array[String], es_members_list: Array[Array[String]]) -> String {
  let mut hit = ""
  let mut i = 0
  while i < Array::length(es) && hit == "" {
    hit = edp_needing_escape(Array::get(es, i), needing, ename, stmts, fn_defs, es_names, es_members_list)
    i = i + 1
  }
  hit
}

fn edp_needing_escape_pairs(pairs: Array[(String, Expr)], needing: Array[String], ename: String, stmts: Array[Stmt], fn_defs: Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], es_names: Array[String], es_members_list: Array[Array[String]]) -> String {
  let mut hit = ""
  let mut i = 0
  while i < Array::length(pairs) && hit == "" {
    let (_, v) = Array::get(pairs, i)
    hit = edp_needing_escape(v, needing, ename, stmts, fn_defs, es_names, es_members_list)
    i = i + 1
  }
  hit
}

fn edp_needing_escape_arms(arms: Array[(Pat, Expr)], needing: Array[String], ename: String, stmts: Array[Stmt], fn_defs: Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], es_names: Array[String], es_members_list: Array[Array[String]]) -> String {
  let mut hit = ""
  let mut i = 0
  while i < Array::length(arms) && hit == "" {
    let (_, ex) = Array::get(arms, i)
    hit = edp_needing_escape(ex, needing, ename, stmts, fn_defs, es_names, es_members_list)
    i = i + 1
  }
  hit
}

export fn edp_needing_escape_stmts(stmts: Array[Stmt], needing: Array[String], ename: String, fn_defs: Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], es_names: Array[String], es_members_list: Array[Array[String]]) -> String {
  let mut hit = ""
  let mut i = 0
  while i < Array::length(stmts) && hit == "" {
    match Array::get(stmts, i) {
      SLet(_, _, _, _, expr) => {
        hit = edp_needing_escape(expr, needing, ename, stmts, fn_defs, es_names, es_members_list)
      },
      SLetMut(_, _, expr) => {
        hit = edp_needing_escape(expr, needing, ename, stmts, fn_defs, es_names, es_members_list)
      },
      SExpr(expr) => {
        hit = edp_needing_escape(expr, needing, ename, stmts, fn_defs, es_names, es_members_list)
      },
      STest(_, expr) => {
        hit = edp_needing_escape(expr, needing, ename, stmts, fn_defs, es_names, es_members_list)
      },
      SBench(_, expr) => {
        hit = edp_needing_escape(expr, needing, ename, stmts, fn_defs, es_names, es_members_list)
      },
      _ => ()
    }
    i = i + 1
  }
  hit
}

/// #1261: the eta-expansion `(__edpw_0, ..) -> nm(__edpw_0, ..)` of needing
/// function `nm`, or None when `nm` has no copyable parameter list.
///
/// This is what lets a needing function's VALUE reach a slot the evidence
/// migration cannot follow. The wrapper is an ordinary closure literal, so
/// the migration's own body rewrites (edp_rewrite_needing_body /
/// edp_rewrite_handle_body, both of which recurse into closure literals)
/// prepend the dict to the call INSIDE it exactly as they would to any other
/// direct call to `nm`. The value that escapes is therefore a plain
/// row-free-arity function that closes over the evidence, and the receiving
/// row-free parameter calls it at the arity it was compiled with.
///
/// The evidence captured is the one in scope where the value escapes, which
/// is the correct one: the checker charges a closure literal's `perform` to
/// the ENCLOSING function, so the handler that discharges it is by
/// construction the one enclosing the escape site.
///
/// Fresh `__edpw_N` parameter names (never the callee's own) keep the
/// wrapper from introducing a binder that shadows a needing function name --
/// edp_alpha_rename_shadowed has already run by the time this synthesizes
/// anything.
fn edp_etawrap_value(stmts: Array[Stmt], fn_defs: Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], nm: String) -> Option[Expr] {
  match edp_params_of_fn(stmts, fn_defs, nm) {
    Some(params) => {
      // A labeled parameter cannot be reached by the wrapper's positional
      // forwarding, so those shapes stay un-wrapped (and are reported by
      // edp_needing_escape instead of silently miscompiled).
      let mut plain = true
      let mut ci = 0
      while ci < Array::length(params) {
        let (pn, _) = Array::get(params, ci)
        if String::starts_with(pn, "~") || String::starts_with(pn, "?") {
          plain = false
        } else {
          ()
        }
        ci = ci + 1
      }
      if plain {
        let wparams = array_empty()
        let cargs = array_empty()
        let mut i = 0
        while i < Array::length(params) {
          let wn = String::concat("__edpw_", Int::to_string(i))
          Array::push(wparams, (wn, None))
          Array::push(cargs, EIdent(wn, -1))
          i = i + 1
        }
        Some(EFn(empty_str_array(), array_empty(), wparams, None, None, ECall(EIdent(nm, -1), cargs, -1, [
        ])))
      } else {
        None
      }
    },
    None => None
  }
}

/// #1261: replace every needing-function VALUE that is about to escape into
/// a slot the migration cannot follow with its eta-expansion
/// (edp_etawrap_value), in place.
///
/// `in_scope` tracks whether this position is one the migration will
/// actually rewrite -- inside a needing function's body, or inside the body
/// of a `handle` for `ename`. Only there does the wrapper's inner call get
/// the dict prepended; wrapping anywhere else would swap one arity mismatch
/// for another, so those positions are left alone for edp_needing_escape to
/// reject. The scope rules mirror the rewrites exactly: both recurse into
/// closure literals, a nested handle for a DIFFERENT effect keeps the
/// current scope for body and arms alike, and a handle for `ename` itself
/// puts only its BODY in scope (its arms are never rewritten by either).
export fn edp_etawrap_stmts(stmts: Array[Stmt], needing: Array[String], ename: String, fn_defs: Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], es_names: Array[String], es_members_list: Array[Array[String]]) -> Unit {
  let _ = edp_etawrap_stmts_with_rebuild(stmts, needing, ename, fn_defs, es_names, es_members_list)
}

/// Report every statement rebuild, including identity rewrites, so callers
/// can invalidate observations of the previous tree conservatively.
export fn edp_etawrap_stmts_with_rebuild(stmts: Array[Stmt], needing: Array[String], ename: String, fn_defs: Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], es_names: Array[String], es_members_list: Array[Array[String]]) -> Bool {
  let mut rebuilt = false
  let wc = (stmts, fn_defs, es_names, es_members_list)
  // #1875 R3: the walk only ever changes a call ARGUMENT that is a bare
  // identifier of a needing function -- on every other statement it is an
  // identity rebuild of the whole tree. Gate the rebuild behind the exact
  // necessary condition, read-only.
  let nq = RQNeedingValueArg(needing)
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SLet(ex, isrec, nm, ty, expr) => if edp_rq_fold(nq, expr) > 0 {
        let scope = edp_str_array_contains(needing, nm)
        rebuilt = true
        Array::set(stmts, i, SLet(ex, isrec, nm, ty, edp_etawrap_expr(expr, scope, needing, ename, wc, array_empty())))
      } else {
        ()
      },
      SLetMut(nm, ty, expr) => if edp_rq_fold(nq, expr) > 0 {
        rebuilt = true
        Array::set(stmts, i, SLetMut(nm, ty, edp_etawrap_expr(expr, false, needing, ename, wc, array_empty())))
      } else {
        ()
      },
      SExpr(expr) => if edp_rq_fold(nq, expr) > 0 {
        rebuilt = true
        Array::set(stmts, i, SExpr(edp_etawrap_expr(expr, false, needing, ename, wc, array_empty())))
      } else {
        ()
      },
      STest(nm, expr) => if edp_rq_fold(nq, expr) > 0 {
        rebuilt = true
        Array::set(stmts, i, STest(nm, edp_etawrap_expr(expr, false, needing, ename, wc, array_empty())))
      } else {
        ()
      },
      SBench(nm, expr) => if edp_rq_fold(nq, expr) > 0 {
        rebuilt = true
        Array::set(stmts, i, SBench(nm, edp_etawrap_expr(expr, false, needing, ename, wc, array_empty())))
      } else {
        ()
      },
      _ => ()
    }
    i = i + 1
  }
  rebuilt
}

/// After checking, an ascribed alias of a needing function has the same value
/// as the bare name. The parser's identity call is a type-checking artifact;
/// leaving it here makes the escape guard mistake its argument for a row-free
/// callback slot. Only peel the exact checked identity shape with this row.
/// A local immutable alias carries the original needing function's call
/// convention. The last row for a name wins, including an empty row from a
/// shadowing binder that must hide an outer alias.
fn edp_alias_root(name: String, needing: Array[String], aliases: Array[(String, String)]) -> String {
  let mut i = Array::length(aliases)
  while i > 0 {
    i = i - 1
    let (bound, root) = Array::get(aliases, i)
    if bound == name {
      return root
    }
  }
  if edp_str_array_contains(needing, name) {
    name
  } else {
    ""
  }
}

fn edp_ascribed_needing_alias(callee: Expr, args: Array[Expr], needing: Array[String], ename: String, es_names: Array[String], es_members_list: Array[Array[String]], aliases: Array[(String, String)]) -> Option[Expr] {
  if Array::length(args) != 1 {
    None
  } else {
    match (callee, Array::get(args, 0)) {
      (EFn(tps, _, params, ret, eff, EIdent(body_name, _)), EIdent(alias, _)) => if Array::length(tps) == 0 && Array::length(params) == 1 && ret == None && eff == None && edp_alias_root(alias, needing, aliases) != "" {
        let (param_name, pty) = Array::get(params, 0)
        let is_asc = param_name == "__asc" || (String::starts_with(param_name, "__shadow_") && String::ends_with(param_name, "___asc"))
        if is_asc && body_name == param_name && edp_type_is_fn_row_exactly(pty, ename, es_names, es_members_list) {
          Some(EIdent(edp_alias_root(alias, needing, aliases), -1))
        } else {
          None
        }
      } else {
        None
      },
      _ => None
    }
  }
}

fn edp_etawrap_expr(e: Expr, in_scope: Bool, needing: Array[String], ename: String, wc: (Array[Stmt], Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], Array[String], Array[Array[String]]), aliases: Array[(String, String)]) -> Expr {
  match e {
    ECall(callee, args, off, callee_resolution) => {
      let (wstmts, wfn_defs, wes_names, wes_members) = wc
      match edp_ascribed_needing_alias(callee, args, needing, ename, wes_names, wes_members, aliases) {
        Some(alias) => return alias,
        None => ()
      }
      let callee_nm = match callee {
        EIdent(cn, _) => cn,
        _ => ""
      }
      let new_callee = if callee_nm == "" {
        edp_etawrap_expr(callee, in_scope, needing, ename, wc, aliases)
      } else {
        callee
      }
      let new_args = array_empty()
      let mut i = 0
      while i < Array::length(args) {
        let a = Array::get(args, i)
        let bare = match a {
          EIdent(an, _) => edp_alias_root(an, needing, aliases),
          _ => ""
        }
        let wrapped = if bare != "" && in_scope && callee_nm != "" && !edp_arg_slot_accepts_needing(wstmts, wfn_defs, callee_nm, i, ename, wes_names, wes_members) {
          edp_etawrap_value(wstmts, wfn_defs, bare)
        } else {
          None
        }
        match wrapped {
          Some(w) => Array::push(new_args, w),
          None => Array::push(new_args, edp_etawrap_expr(a, in_scope, needing, ename, wc, aliases))
        }
        i = i + 1
      }
      ECall(new_callee, new_args, off, callee_resolution)
    },
    EFn(tps, tbs, params, ret, eff, b) => {
      let mark = Array::length(aliases)
      for param in params {
        let (name, _) = param
        Array::push(aliases, (edp_strip_tilde(name), ""))
      }
      let body = edp_etawrap_expr(b, in_scope, needing, ename, wc, aliases)
      Array::truncate(aliases, mark)
      EFn(tps, tbs, params, ret, eff, body)
    },
    EHandle(b, arms) => {
      let matches = edp_handle_matches_effect(arms, ename)
      let body_scope = if matches {
        true
      } else {
        in_scope
      }
      let arm_scope = if matches {
        false
      } else {
        in_scope
      }
      EHandle(edp_etawrap_expr(b, body_scope, needing, ename, wc, aliases), edp_etawrap_arms(arms, arm_scope, needing, ename, wc, aliases))
    },
    EIf(c, t, el) => EIf(edp_etawrap_expr(c, in_scope, needing, ename, wc, aliases), edp_etawrap_expr(t, in_scope, needing, ename, wc, aliases), edp_etawrap_expr(el, in_scope, needing, ename, wc, aliases)),
    EMatch(s, arms) => EMatch(edp_etawrap_expr(s, in_scope, needing, ename, wc, aliases), edp_etawrap_arms(arms, in_scope, needing, ename, wc, aliases)),
    EWhile(c, b) => EWhile(edp_etawrap_expr(c, in_scope, needing, ename, wc, aliases), edp_etawrap_expr(b, in_scope, needing, ename, wc, aliases)),
    EForIn(n, idx, it, b) => {
      let iter = edp_etawrap_expr(it, in_scope, needing, ename, wc, aliases)
      let mark = Array::length(aliases)
      Array::push(aliases, (n, ""))
      match idx {
        Some(index) => Array::push(aliases, (index, "")),
        None => ()
      }
      let body = edp_etawrap_expr(b, in_scope, needing, ename, wc, aliases)
      Array::truncate(aliases, mark)
      EForIn(n, idx, iter, body)
    },
    ELoop(pairs, b) => {
      let values = edp_etawrap_pairs(pairs, in_scope, needing, ename, wc, aliases)
      let mark = Array::length(aliases)
      for pair in pairs {
        let (name, _) = pair
        Array::push(aliases, (name, ""))
      }
      let body = edp_etawrap_expr(b, in_scope, needing, ename, wc, aliases)
      Array::truncate(aliases, mark)
      ELoop(values, body)
    },
    ELet(n, v, b, off) => {
      let value = edp_etawrap_expr(v, in_scope, needing, ename, wc, aliases)
      let root = match value {
        EIdent(name, _) => edp_alias_root(name, needing, aliases),
        _ => ""
      }
      let mark = Array::length(aliases)
      Array::push(aliases, (n, root))
      let body = edp_etawrap_expr(b, in_scope, needing, ename, wc, aliases)
      Array::truncate(aliases, mark)
      ELet(n, value, body, off)
    },
    ELetMut(n, v, b, off) => {
      let value = edp_etawrap_expr(v, in_scope, needing, ename, wc, aliases)
      let mark = Array::length(aliases)
      Array::push(aliases, (n, ""))
      let body = edp_etawrap_expr(b, in_scope, needing, ename, wc, aliases)
      Array::truncate(aliases, mark)
      ELetMut(n, value, body, off)
    },
    ELetRec(n, v, b) => {
      let mark = Array::length(aliases)
      Array::push(aliases, (n, ""))
      let value = edp_etawrap_expr(v, in_scope, needing, ename, wc, aliases)
      let root = match value {
        EIdent(name, _) => edp_alias_root(name, needing, aliases),
        _ => ""
      }
      Array::set(aliases, mark, (n, root))
      let body = edp_etawrap_expr(b, in_scope, needing, ename, wc, aliases)
      Array::truncate(aliases, mark)
      ELetRec(n, value, body)
    },
    ESeq(a, b) => ESeq(edp_etawrap_expr(a, in_scope, needing, ename, wc, aliases), edp_etawrap_expr(b, in_scope, needing, ename, wc, aliases)),
    EBinOp(op, l, r, boff) => EBinOp(op, edp_etawrap_expr(l, in_scope, needing, ename, wc, aliases), edp_etawrap_expr(r, in_scope, needing, ename, wc, aliases), boff),
    EUnaryOp(op, x) => EUnaryOp(op, edp_etawrap_expr(x, in_scope, needing, ename, wc, aliases)),
    EAssign(n, v, c, target_off) => EAssign(n, edp_etawrap_expr(v, in_scope, needing, ename, wc, aliases), edp_etawrap_expr(c, in_scope, needing, ename, wc, aliases), target_off),
    EAssignOp(n, op, v, c, target_off) => EAssignOp(n, op, edp_etawrap_expr(v, in_scope, needing, ename, wc, aliases), edp_etawrap_expr(c, in_scope, needing, ename, wc, aliases), target_off),
    EDot(o, f, o1, o2) => EDot(edp_etawrap_expr(o, in_scope, needing, ename, wc, aliases), f, o1, o2),
    ELabeledArg(l, n, v) => ELabeledArg(l, n, edp_etawrap_expr(v, in_scope, needing, ename, wc, aliases)),
    EReturn(x) => EReturn(edp_etawrap_expr(x, in_scope, needing, ename, wc, aliases)),
    EBreak(opt) => EBreak(match opt {
      Some(x) => Some(edp_etawrap_expr(x, in_scope, needing, ename, wc, aliases)),
      None => None
    }),
    EContinue(args) => EContinue(edp_etawrap_exprs(args, in_scope, needing, ename, wc, aliases)),
    ETuple(items) => ETuple(edp_etawrap_exprs(items, in_scope, needing, ename, wc, aliases)),
    EArray(items) => EArray(edp_etawrap_exprs(items, in_scope, needing, ename, wc, aliases)),
    ERecord(n, fields, tas) => ERecord(n, edp_etawrap_pairs(fields, in_scope, needing, ename, wc, aliases), tas),
    EMap(fields) => EMap(edp_etawrap_pairs(fields, in_scope, needing, ename, wc, aliases)),
    ESpread(x) => ESpread(edp_etawrap_expr(x, in_scope, needing, ename, wc, aliases)),
    _ => e
  }
}

fn edp_etawrap_exprs(es: Array[Expr], in_scope: Bool, needing: Array[String], ename: String, wc: (Array[Stmt], Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], Array[String], Array[Array[String]]), aliases: Array[(String, String)]) -> Array[Expr] {
  for x in es {
    edp_etawrap_expr(x, in_scope, needing, ename, wc, aliases)
  }
}

fn edp_etawrap_pairs(pairs: Array[(String, Expr)], in_scope: Bool, needing: Array[String], ename: String, wc: (Array[Stmt], Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], Array[String], Array[Array[String]]), aliases: Array[(String, String)]) -> Array[(String, Expr)] {
  for p in pairs {
    let (n, v) = p
    (n, edp_etawrap_expr(v, in_scope, needing, ename, wc, aliases))
  }
}

fn edp_etawrap_arms(arms: Array[(Pat, Expr)], in_scope: Bool, needing: Array[String], ename: String, wc: (Array[Stmt], Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], Array[String], Array[Array[String]]), aliases: Array[(String, String)]) -> Array[(Pat, Expr)] {
  for a in arms {
    let (p, ex) = a
    let names = empty_str_array()
    edp_pat_binds(p, names)
    let mark = Array::length(aliases)
    for name in names {
      Array::push(aliases, (name, ""))
    }
    let body = edp_etawrap_expr(ex, in_scope, needing, ename, wc, aliases)
    Array::truncate(aliases, mark)
    (p, body)
  }
}

export fn edp_count_ident_uses(expr: Expr, name: String) -> Int {
  edp_rq_fold(RQIdentUses(name), expr)
}

/// Whole-program count of `let`-bound (top-level SLet or nested ELet/
/// ELetRec) closure literals named `xname` that are individually eligible
/// (edp_efn_eligible_for_migration). Same full coverage as
/// edp_count_ident_uses.
export fn edp_count_safe_closure_bindings_stmts(stmts: Array[Stmt], xname: String, ename: String, needing: Array[String], pure_fns: Array[String], es_names: Array[String], es_members_list: Array[Array[String]]) -> Int {
  let mut total = 0
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SLet(_, _, nm, _, expr) => {
        let self_hit = if nm == xname && edp_efn_eligible_for_migration(expr, ename, needing, pure_fns, es_names, es_members_list) {
          1
        } else {
          0
        }
        total = total + self_hit + edp_count_safe_closure_bindings(expr, xname, ename, needing, pure_fns, es_names, es_members_list)
      },
      _ => ()
    }
    i = i + 1
  }
  total
}

fn edp_count_safe_closure_bindings(expr: Expr, xname: String, ename: String, needing: Array[String], pure_fns: Array[String], es_names: Array[String], es_members_list: Array[Array[String]]) -> Int {
  edp_rq_fold(RQSafeClosureBindings(xname, ename, needing, pure_fns, es_names, es_members_list), expr)
}

/// Whole-program scan for `gname(args)` calls, collecting the bare
/// identifier found at `args[argpos]`. A call to `gname` whose argument at
/// that position is EITHER missing (arity mismatch we can't reason about)
/// OR present but not a bare identifier (a literal, a field access, an
/// inline lambda, ...) pushes the sentinel "##edp_unsafe##" instead --
/// edp_closure_param_universally_safe treats its presence, anywhere in the
/// result, as an unconditional "not safe" for the whole position.
export fn edp_collect_ecall_arg_idents_with_keep(stmts: Array[Stmt], gname: String, argpos: Int, keep: Array[Bool]) -> Array[String] {
  let ctors: Array[String] = []
  edp_append_ctor_inert_names(stmts, ctors)
  let out = array_empty()
  let mut i = 0
  while i < Array::length(stmts) {
    if Array::length(keep) == 0 || (i < Array::length(keep) && Array::get(keep, i)) {
      match Array::get(stmts, i) {
        SLet(_, _, _, _, expr) => edp_collect_ecall_arg_idents_expr(expr, gname, argpos, out, ctors),
        SLetMut(_, _, expr) => edp_collect_ecall_arg_idents_expr(expr, gname, argpos, out, ctors),
        SExpr(expr) => edp_collect_ecall_arg_idents_expr(expr, gname, argpos, out, ctors),
        STest(_, expr) => edp_collect_ecall_arg_idents_expr(expr, gname, argpos, out, ctors),
        SBench(_, expr) => edp_collect_ecall_arg_idents_expr(expr, gname, argpos, out, ctors),
        _ => ()
      }
    } else {
      ()
    }
    i = i + 1
  }
  out
}

export fn edp_collect_ecall_arg_idents(stmts: Array[Stmt], gname: String, argpos: Int) -> Array[String] {
  edp_collect_ecall_arg_idents_with_keep(stmts, gname, argpos, array_empty())
}

/// A local binder hides a constructor of the same name in its scope.
export fn edp_usage_ctor_mask(ctors: Array[String], name: String) -> Array[String] {
  if !edp_str_array_contains(ctors, name) {
    ctors
  } else {
    let out: Array[String] = []
    for ctor in ctors {
      if ctor != name {
        Array::push(out, ctor)
      } else {
        ()
      }
    }
    out
  }
}

export fn edp_usage_ctor_params(ctors: Array[String], params: Array[(String, Option[TypeExpr])]) -> Array[String] {
  let mut out = ctors
  for param in params {
    let (name, _) = param
    out = edp_usage_ctor_mask(out, edp_strip_tilde(name))
  }
  out
}

export fn edp_usage_ctor_loop(ctors: Array[String], pairs: Array[(String, Expr)]) -> Array[String] {
  let mut out = ctors
  for pair in pairs {
    let (name, _) = pair
    out = edp_usage_ctor_mask(out, name)
  }
  out
}

export fn edp_usage_ctor_for(ctors: Array[String], name: String, index_name: Option[String]) -> Array[String] {
  let out = edp_usage_ctor_mask(ctors, name)
  match index_name {
    Some(index) => edp_usage_ctor_mask(out, index),
    None => out
  }
}

export fn edp_usage_ctor_pat(ctors: Array[String], pat: Pat) -> Array[String] {
  let bound: Array[String] = []
  edp_pat_binds(pat, bound)
  let mut out = ctors
  for name in bound {
    out = edp_usage_ctor_mask(out, name)
  }
  out
}

/// An unused binding still evaluates its initializer. Value constructors
/// store closure literals without invoking them; other forms keep the normal
/// conservative scan so an eager call cannot disappear from eligibility.
fn edp_collect_ecall_arg_idents_unused_value(expr: Expr, gname: String, argpos: Int, out: Array[String], ctors: Array[String]) -> Unit {
  match expr {
    EFn(_, _, _, _, _, _) => (),
    ECall(EIdent(name, _), args, _, _) => if edp_str_array_contains(ctors, name) {
      for arg in args {
        edp_collect_ecall_arg_idents_unused_value(arg, gname, argpos, out, ctors)
      }
    } else {
      edp_collect_ecall_arg_idents_expr(expr, gname, argpos, out, ctors)
    },
    EArray(items) => for item in items {
      edp_collect_ecall_arg_idents_unused_value(item, gname, argpos, out, ctors)
    },
    ETuple(items) => for item in items {
      edp_collect_ecall_arg_idents_unused_value(item, gname, argpos, out, ctors)
    },
    ERecord(_, fields, _) => for field in fields {
      let (_, value) = field
      edp_collect_ecall_arg_idents_unused_value(value, gname, argpos, out, ctors)
    },
    EMap(fields) => for field in fields {
      let (_, value) = field
      edp_collect_ecall_arg_idents_unused_value(value, gname, argpos, out, ctors)
    },
    _ => edp_collect_ecall_arg_idents_expr(expr, gname, argpos, out, ctors)
  }
}

/// Only references to this particular binding make its closure reachable.
/// A later binder with the same spelling owns its continuation's uses.
export fn edp_binding_used_in(expr: Expr, name: String, ctors: Array[String]) -> Bool {
  match expr {
    EIdent(nm, _) => nm == name,
    ELet(nm, value, body, _) => {
      let inner = edp_usage_ctor_mask(ctors, nm)
      let in_value = if nm == name || edp_binding_used_in(body, nm, inner) {
        edp_binding_used_in(value, name, ctors)
      } else {
        edp_binding_used_in_unused_value(value, name, ctors)
      }
      in_value || (nm != name && edp_binding_used_in(body, name, inner))
    },
    ELetMut(nm, value, body, _) => {
      let inner = edp_usage_ctor_mask(ctors, nm)
      let in_value = if nm == name || edp_binding_used_in(body, nm, inner) {
        edp_binding_used_in(value, name, ctors)
      } else {
        edp_binding_used_in_unused_value(value, name, ctors)
      }
      in_value || (nm != name && edp_binding_used_in(body, name, inner))
    },
    ELetRec(nm, value, body) => if nm == name {
      false
    } else {
      let inner = edp_usage_ctor_mask(ctors, nm)
      let in_value = if edp_binding_used_in(body, nm, inner) {
        edp_binding_used_in(value, name, inner)
      } else {
        edp_binding_used_in_unused_value(value, name, inner)
      }
      in_value || edp_binding_used_in(body, name, inner)
    },
    EFn(_, _, params, _, _, body) => {
      let mut shadows = false
      for param in params {
        let (pn, _) = param
        if edp_strip_tilde(pn) == name {
          shadows = true
        } else {
          ()
        }
      }
      !shadows && edp_binding_used_in(body, name, edp_usage_ctor_params(ctors, params))
    },
    EMatch(scrutinee, arms) => edp_binding_used_in(scrutinee, name, ctors) || edp_binding_used_in_arms(arms, name, ctors),
    EHandle(body, arms) => edp_binding_used_in(body, name, ctors) || edp_binding_used_in_arms(arms, name, ctors),
    EForIn(nm, idx, iter, body) => edp_binding_used_in(iter, name, ctors) || (nm != name && idx != Some(name) && edp_binding_used_in(body, name, edp_usage_ctor_for(ctors, nm, idx))),
    ELoop(pairs, body) => {
      let mut used = false
      let mut shadows = false
      for pair in pairs {
        let (pn, value) = pair
        used = used || edp_binding_used_in(value, name, ctors)
        shadows = shadows || pn == name
      }
      used || (!shadows && edp_binding_used_in(body, name, edp_usage_ctor_loop(ctors, pairs)))
    },
    _ => edp_binding_used_in_exprs(expr_children(expr), name, ctors)
  }
}

/// A dormant value constructor evaluates its fields but does not enter a
/// closure body stored in one of them.
fn edp_binding_used_in_unused_value(expr: Expr, name: String, ctors: Array[String]) -> Bool {
  match expr {
    EFn(_, _, _, _, _, _) => false,
    EIdent(_, _) => false,
    ECall(EIdent(ctor, _), args, _, _) => if edp_str_array_contains(ctors, ctor) {
      edp_binding_used_in_unused_exprs(args, name, ctors)
    } else {
      edp_binding_used_in(expr, name, ctors)
    },
    EArray(items) => edp_binding_used_in_unused_exprs(items, name, ctors),
    ETuple(items) => edp_binding_used_in_unused_exprs(items, name, ctors),
    ERecord(_, fields, _) => {
      let mut used = false
      for field in fields {
        let (_, value) = field
        used = used || edp_binding_used_in_unused_value(value, name, ctors)
      }
      used
    },
    EMap(fields) => {
      let mut used = false
      for field in fields {
        let (_, value) = field
        used = used || edp_binding_used_in_unused_value(value, name, ctors)
      }
      used
    },
    _ => edp_binding_used_in(expr, name, ctors)
  }
}

fn edp_binding_used_in_unused_exprs(exprs: Array[Expr], name: String, ctors: Array[String]) -> Bool {
  let mut used = false
  for expr in exprs {
    used = used || edp_binding_used_in_unused_value(expr, name, ctors)
  }
  used
}

fn edp_binding_used_in_exprs(exprs: Array[Expr], name: String, ctors: Array[String]) -> Bool {
  let mut used = false
  let mut i = 0
  while !used && i < Array::length(exprs) {
    used = edp_binding_used_in(Array::get(exprs, i), name, ctors)
    i = i + 1
  }
  used
}

fn edp_binding_used_in_arms(arms: Array[(Pat, Expr)], name: String, ctors: Array[String]) -> Bool {
  let mut used = false
  let mut i = 0
  while !used && i < Array::length(arms) {
    let (pat, body) = Array::get(arms, i)
    let bound: Array[String] = []
    edp_pat_binds(pat, bound)
    if !edp_str_array_contains(bound, name) {
      used = edp_binding_used_in(body, name, edp_usage_ctor_pat(ctors, pat))
    } else {
      ()
    }
    i = i + 1
  }
  used
}

fn edp_collect_ecall_arg_idents_expr(expr: Expr, gname: String, argpos: Int, out: Array[String], ctors: Array[String]) -> Unit {
  match expr {
    ECall(callee, args, _, _) => {
      match callee {
        EIdent(nm, _) => if nm == gname {
          if Array::length(args) > argpos {
            match Array::get(args, argpos) {
              EIdent(xn, _) => Array::push(out, xn),
              _ => Array::push(out, "##edp_unsafe##")
            }
          } else {
            Array::push(out, "##edp_unsafe##")
          }
        } else {
          ()
        },
        _ => ()
      }
      edp_collect_ecall_arg_idents_expr(callee, gname, argpos, out, ctors)
      edp_collect_ecall_arg_idents_exprs(args, gname, argpos, out, ctors)
    },
    EFn(_, _, params, _, _, body) => {
      let mut shadows = false
      for param in params {
        let (pn, _) = param
        shadows = shadows || edp_strip_tilde(pn) == gname
      }
      if !shadows {
        edp_collect_ecall_arg_idents_expr(body, gname, argpos, out, edp_usage_ctor_params(ctors, params))
      } else {
        ()
      }
    },
    EHandle(body, arms) => {
      edp_collect_ecall_arg_idents_expr(body, gname, argpos, out, ctors)
      edp_collect_ecall_arg_idents_arms(arms, gname, argpos, out, ctors)
    },
    EIf(c, t, e) => {
      edp_collect_ecall_arg_idents_expr(c, gname, argpos, out, ctors)
      edp_collect_ecall_arg_idents_expr(t, gname, argpos, out, ctors)
      edp_collect_ecall_arg_idents_expr(e, gname, argpos, out, ctors)
    },
    EMatch(s, arms) => {
      edp_collect_ecall_arg_idents_expr(s, gname, argpos, out, ctors)
      edp_collect_ecall_arg_idents_arms(arms, gname, argpos, out, ctors)
    },
    EWhile(c, b) => {
      edp_collect_ecall_arg_idents_expr(c, gname, argpos, out, ctors)
      edp_collect_ecall_arg_idents_expr(b, gname, argpos, out, ctors)
    },
    EForIn(name, index_name, it, b) => {
      edp_collect_ecall_arg_idents_expr(it, gname, argpos, out, ctors)
      if name != gname && index_name != Some(gname) {
        edp_collect_ecall_arg_idents_expr(b, gname, argpos, out, edp_usage_ctor_for(ctors, name, index_name))
      } else {
        ()
      }
    },
    ELoop(pairs, b) => {
      let mut i = 0
      let mut shadows = false
      while i < Array::length(pairs) {
        let (name, v) = Array::get(pairs, i)
        edp_collect_ecall_arg_idents_expr(v, gname, argpos, out, ctors)
        shadows = shadows || name == gname
        i = i + 1
      }
      if !shadows {
        edp_collect_ecall_arg_idents_expr(b, gname, argpos, out, edp_usage_ctor_loop(ctors, pairs))
      } else {
        ()
      }
    },
    ELet(name, v, b, _) => {
      let inner = edp_usage_ctor_mask(ctors, name)
      // A closure literal with no use in its continuation cannot call the
      // owner. Do not let its body refuse a live call with another argument.
      if !edp_binding_used_in(b, name, inner) {
        edp_collect_ecall_arg_idents_unused_value(v, gname, argpos, out, ctors)
      } else {
        edp_collect_ecall_arg_idents_expr(v, gname, argpos, out, ctors)
      }
      if name != gname {
        edp_collect_ecall_arg_idents_expr(b, gname, argpos, out, inner)
      } else {
        ()
      }
    },
    ELetMut(name, v, b, _) => {
      let inner = edp_usage_ctor_mask(ctors, name)
      if !edp_binding_used_in(b, name, inner) {
        edp_collect_ecall_arg_idents_unused_value(v, gname, argpos, out, ctors)
      } else {
        edp_collect_ecall_arg_idents_expr(v, gname, argpos, out, ctors)
      }
      if name != gname {
        edp_collect_ecall_arg_idents_expr(b, gname, argpos, out, inner)
      } else {
        ()
      }
    },
    ELetRec(name, v, b) => {
      if name != gname {
        let inner = edp_usage_ctor_mask(ctors, name)
        if !edp_binding_used_in(b, name, inner) {
          edp_collect_ecall_arg_idents_unused_value(v, gname, argpos, out, inner)
        } else {
          edp_collect_ecall_arg_idents_expr(v, gname, argpos, out, inner)
        }
        edp_collect_ecall_arg_idents_expr(b, gname, argpos, out, inner)
      } else {
        ()
      }
    },
    ESeq(a, b) => {
      edp_collect_ecall_arg_idents_expr(a, gname, argpos, out, ctors)
      edp_collect_ecall_arg_idents_expr(b, gname, argpos, out, ctors)
    },
    EBinOp(_, l, r, _) => {
      edp_collect_ecall_arg_idents_expr(l, gname, argpos, out, ctors)
      edp_collect_ecall_arg_idents_expr(r, gname, argpos, out, ctors)
    },
    EUnaryOp(_, e2) => edp_collect_ecall_arg_idents_expr(e2, gname, argpos, out, ctors),
    EAssign(_, v, c, _) => {
      edp_collect_ecall_arg_idents_expr(v, gname, argpos, out, ctors)
      edp_collect_ecall_arg_idents_expr(c, gname, argpos, out, ctors)
    },
    EAssignOp(_, _, v, c, _) => {
      edp_collect_ecall_arg_idents_expr(v, gname, argpos, out, ctors)
      edp_collect_ecall_arg_idents_expr(c, gname, argpos, out, ctors)
    },
    EDot(o, _, _, _) => edp_collect_ecall_arg_idents_expr(o, gname, argpos, out, ctors),
    ELabeledArg(_, _, v) => edp_collect_ecall_arg_idents_expr(v, gname, argpos, out, ctors),
    EReturn(e2) => edp_collect_ecall_arg_idents_expr(e2, gname, argpos, out, ctors),
    EBreak(opt) => match opt {
      Some(e2) => edp_collect_ecall_arg_idents_expr(e2, gname, argpos, out, ctors),
      None => ()
    },
    EContinue(args) => edp_collect_ecall_arg_idents_exprs(args, gname, argpos, out, ctors),
    ETuple(elems) => edp_collect_ecall_arg_idents_exprs(elems, gname, argpos, out, ctors),
    EArray(elems) => edp_collect_ecall_arg_idents_exprs(elems, gname, argpos, out, ctors),
    ERecord(_, fields, _) => {
      let mut i = 0
      while i < Array::length(fields) {
        let (_, v) = Array::get(fields, i)
        edp_collect_ecall_arg_idents_expr(v, gname, argpos, out, ctors)
        i = i + 1
      }
    },
    EMap(fields) => {
      let mut i = 0
      while i < Array::length(fields) {
        let (_, v) = Array::get(fields, i)
        edp_collect_ecall_arg_idents_expr(v, gname, argpos, out, ctors)
        i = i + 1
      }
    },
    ESpread(e2) => edp_collect_ecall_arg_idents_expr(e2, gname, argpos, out, ctors),
    _ => ()
  }
}

fn edp_collect_ecall_arg_idents_exprs(exprs: Array[Expr], gname: String, argpos: Int, out: Array[String], ctors: Array[String]) -> Unit {
  let mut i = 0
  while i < Array::length(exprs) {
    edp_collect_ecall_arg_idents_expr(Array::get(exprs, i), gname, argpos, out, ctors)
    i = i + 1
  }
}

fn edp_collect_ecall_arg_idents_arms(arms: Array[(Pat, Expr)], gname: String, argpos: Int, out: Array[String], ctors: Array[String]) -> Unit {
  let mut i = 0
  while i < Array::length(arms) {
    let (pat, ex) = Array::get(arms, i)
    let bound: Array[String] = []
    edp_pat_binds(pat, bound)
    if !edp_str_array_contains(bound, gname) {
      edp_collect_ecall_arg_idents_expr(ex, gname, argpos, out, edp_usage_ctor_pat(ctors, pat))
    } else {
      ()
    }
    i = i + 1
  }
}
