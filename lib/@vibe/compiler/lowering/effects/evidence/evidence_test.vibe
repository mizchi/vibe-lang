import @vibe/compiler/core {
  Expr, Pat, Stmt, TypeExpr
}
import @vibe/compiler/lowering/effects/evidence {
  edp_bind_census, edp_collect_fn_defs, edp_drop_self_discharging_needing, evidence_dict_pass
}

test "the evidence census distinguishes a binding from a reference" {
  let stmts = [SExpr(ELet("bound", EInt(1), EIdent("used", 8), 0))]
  inspect(edp_bind_census(stmts, ["bound", "used", "bound"]), content = "[true, false, true]")
  inspect(evidence_dict_pass(stmts, ""), content = "[]")
}

fn inert_row_program(side_row: String) -> Array[Stmt] {
  let ask = ECall(EIdent("ask", 0), [], 0)
  let side_body = if side_row == "Ask" {
    ask
  } else {
    EIdent("n", 0)
  }
  [
    SEffectDef(false, "Ask", [], [("Get", [], TyName("Int"))]),
    SLet(false, false, "ask", None, EFn([], [], [], Some(TyName("Int")), Some("Ask"), ECall(EIdent("perform", 0), [
      ECall(EIdent("Ask::Get", 0), [], 0)
    ], 0))),
    SLet(false, false, "side", None, EFn([], [], [("n", Some(TyName("Int")))], Some(TyName("Int")), Some(side_row), side_body)),
    SLet(false, false, "main", None, EFn([], [], [], Some(TyName("Int")), Some("Stdout"), EHandle(ECall(EIdent("side", 0), [
      ask
    ], 0), [(PCtor("Ask::Get", []), ECall(EIdent("resume", 0), [EInt(42)], 0))])))
  ]
}

/// The same program, but `side` takes a FUNCTION -- the one difference
/// `edp_callee_first_order` keys on (#2065). Under a row VARIABLE that
/// parameter can carry the handled effect into the callee, so the row stays
/// opaque here where the first-order shape above is now admitted.
fn ho_row_program(side_row: String) -> Array[Stmt] {
  ho_row_program_with(side_row, EFn([], [], [("y", Some(TyName("Int")))], Some(TyName("Int")), None, EIdent("y", 0)))
}

/// `ho_row_program` with `g_arg` in the function-typed position.
fn ho_row_program_with(side_row: String, g_arg: Expr) -> Array[Stmt] {
  let ask = ECall(EIdent("ask", 0), [], 0)
  [
    SEffectDef(false, "Ask", [], [("Get", [], TyName("Int"))]),
    SLet(false, false, "ask", None, EFn([], [], [], Some(TyName("Int")), Some("Ask"), ECall(EIdent("perform", 0), [
      ECall(EIdent("Ask::Get", 0), [], 0)
    ], 0))),
    SLet(false, false, "side", None, EFn([], [], [
      ("n", Some(TyName("Int"))),
      ("g", Some(TyFn([TyName("Int")], TyName("Int"), None)))
    ], Some(TyName("Int")), Some(side_row), ECall(EIdent("g", 0), [
      EIdent("n", 0)
    ], 0))),
    SLet(false, false, "ask_plus", None, EFn([], [], [
      ("v", Some(TyName("Int")))
    ], Some(TyName("Int")), Some("Ask"), ECall(EIdent("perform", 0), [
      ECall(EIdent("Ask::Get", 0), [], 0)
    ], 0))),
    SLet(false, false, "main", None, EFn([], [], [], Some(TyName("Int")), Some("Stdout"), EHandle(ECall(EIdent("side", 0), [
      ask,
      g_arg
    ], 0), [(PCtor("Ask::Get", []), ECall(EIdent("resume", 0), [EInt(42)], 0))])))
  ]
}

fn lowered_side_arity(side_row: String) -> Int {
  let stmts = inert_row_program(side_row)
  let errors = evidence_dict_pass(stmts, "main")
  assert(Array::length(errors) == 0)
  let mut arity = -1
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SLet(_, _, "side", _, EFn(_, _, params, _, _, _)) => arity = Array::length(params),
      _ => ()
    }
    i = i + 1
  }
  arity
}

test "inert row membership does not suppress a later program's required dictionary" {
  inspect([
    lowered_side_arity("Stdout"),
    lowered_side_arity("Ask"),
    lowered_side_arity("Stdout")
  ], "[1, 2, 1]")
}

/// #2065 wall 1. This test used to assert that a row variable is opaque
/// FULL STOP, and `inert_row_program` happens to build `side` as
/// `fn side(n: Int) -> Int with e` -- one annotated non-function parameter,
/// i.e. exactly the first-order shape `edp_callee_first_order` now admits,
/// because no argument can carry a row into it and so `e` can only be the
/// empty row.
///
/// The pair is the point: opacity is a property of the callee's SHAPE, not
/// of the row variable alone. Asserting only the first-order half would pass
/// for a port that admitted everything; only the higher-order half, for one
/// that admitted nothing.
test "a first-order row-variable callee is admitted" {
  inspect(Array::length(evidence_dict_pass(inert_row_program("e"), "main")) == 0, content = "true")
}

// #2065 wall 1: a HIGHER-ORDER row-variable callee is admitted exactly when
// every function-typed argument is a literal that cannot perform the effect.
test "a higher-order row-variable callee is admitted with an inert literal argument" {
  inspect(Array::length(evidence_dict_pass(ho_row_program("e"), "main")) == 0, content = "true")
}

test "a higher-order row-variable callee stays opaque when the argument could perform" {
  // A NAME in the function-typed position: its row is not readable here.
  let named = ho_row_program_with("e", EIdent("ask_plus", 0))
  // A literal whose body performs the handled effect.
  let performing = ho_row_program_with("e", EFn([], [], [
    ("y", Some(TyName("Int")))
  ], Some(TyName("Int")), None, ECall(EIdent("perform", 0), [
    ECall(EIdent("Ask::Get", 0), [], 0)
  ], 0)))
  // A literal that calls a function needing the handled effect.
  let calling = ho_row_program_with("e", EFn([], [], [
    ("y", Some(TyName("Int")))
  ], Some(TyName("Int")), None, ECall(EIdent("ask_plus", 0), [EIdent("y", 0)], 0)))
  // A literal whose declared row names the handled effect.
  let declared = ho_row_program_with("e", EFn([], [], [
    ("y", Some(TyName("Int")))
  ], Some(TyName("Int")), Some("Ask"), EIdent("y", 0)))
  inspect([
    Array::length(evidence_dict_pass(named, "main")) > 0,
    Array::length(evidence_dict_pass(performing, "main")) > 0,
    Array::length(evidence_dict_pass(calling, "main")) > 0,
    Array::length(evidence_dict_pass(declared, "main")) > 0
  ], content = "[true, true, true, true]")
}

//# #2500: the self-discharge spine

/// A row-`Emit` function whose body is `body`. `edp_drop_self_discharging_
/// needing` keeps such a function OUT of the evidence migration's `needing`
/// set when its body discharges `Emit` itself: it never needs a dict passed
/// TO it, and leaving it in is not merely a missed optimization -- its own
/// handle then reads as an unsafe nested handle and sinks the migration for
/// the WHOLE effect.
///
/// The shape matters because of how these functions arise. A hand-written
/// `fn` that handles what it performs carries no row at all, so it is never
/// a candidate; but `dlh_hoist_expr` hoists a local closure to top level and
/// backfills its row from the performs in its body INCLUDING the ones its own
/// handle discharges, so the hoisted form arrives here declared `with Emit`.
/// Before #2500 only a body that WAS the handle qualified, which is why
/// `let r = handle {..}; r` behaved differently from the same code written as
/// a named `fn`.
fn sd_drops(body: Expr) -> Bool {
  let stmts = [
    SEffectDef(false, "Emit", [], [("Emit", [TyName("Int")], TyName("Unit"))]),
    SLet(false, false, "selfd", None, EFn([], [], [], Some(TyName("Int")), Some("Emit"), body))
  ]
  let fn_defs = edp_collect_fn_defs(stmts)
  Array::length(edp_drop_self_discharging_needing(["selfd"], stmts, fn_defs, "Emit", [
  ])) == 0
}

fn sd_perform(op: String, arg: Expr) -> Expr {
  ECall(EIdent("perform", 0), [ECall(EIdent(op, 0), [arg], 0)], 0)
}

fn sd_emit_handle() -> Expr {
  EHandle(sd_perform("Emit::Emit", EInt(10)), [
    (PCtor("Emit::Emit", [PBind("_v")]), ECall(EIdent("resume", 0), [EInt(0)], 0))
  ])
}

test "#2500: a body that IS the handle is self-discharging" {
  inspect(sd_drops(sd_emit_handle()), content = "true")
}

test "#2500: a binding or a sequence before the handle does not hide it" {
  inspect(sd_drops(ELet("n", EInt(0), sd_emit_handle(), 0)), content = "true")
  inspect(sd_drops(ELetMut("n", EInt(0), sd_emit_handle(), 0)), content = "true")
  inspect(sd_drops(ESeq(EInt(1), sd_emit_handle())), content = "true")
}

test "#2500: the handle may be the bound VALUE rather than the body" {
  inspect(sd_drops(ELet("r", sd_emit_handle(), EIdent("r", 0), 0)), content = "true")
}

test "#2500: a handle for another effect is transparent to this one" {
  let outer = EHandle(sd_emit_handle(), [
    (PCtor("Other::Op", []), ECall(EIdent("resume", 0), [EInt(1)], 0))
  ])
  inspect(sd_drops(outer), content = "true")
}

/// The conservative boundary, and what makes the rows above able to fail: a
/// perform of `Emit` OUTSIDE the handle really does need the dict, and an
/// arm of a foreign handle runs outside its own handle's coverage, so a
/// perform there escapes the same way. Both keep the function in `needing`.
test "#2500: a perform outside the handle keeps the function needing" {
  inspect(sd_drops(ELet("x", sd_perform("Emit::Emit", EInt(1)), sd_emit_handle(), 0)), content = "false")
  inspect(sd_drops(ESeq(sd_perform("Emit::Emit", EInt(1)), sd_emit_handle())), content = "false")
  let leaky = EHandle(sd_emit_handle(), [
    (PCtor("Other::Op", []), sd_perform("Emit::Emit", EInt(2)))
  ])
  inspect(sd_drops(leaky), content = "false")
}

/// At least one handle must be reached: a body that merely never performs
/// `Emit` is not self-discharging, it is perform-free, which is a different
/// predicate (edp_fn_is_perform_free) with a different consequence.
test "#2500: a body with no handle at all is not self-discharging" {
  inspect(sd_drops(EInt(0)), content = "false")
  inspect(sd_drops(ELet("n", EInt(0), EIdent("n", 0), 0)), content = "false")
}
