  idp_is_pure_builtin_call, idp_note_program_decls, idp_pure_builtin_names
}

import @vibe/compiler/lowering/effects/queries {
  EdpReadQuery,
  edp_callee_is_resolvable,
  edp_handle_matches_effect,
  edp_has_unsafe_construct,
  edp_is_pure_builtin_call,
  edp_mf_set_stmt,
  edp_pat_binds,
  edp_perform_facts,
