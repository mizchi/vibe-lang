}

export fn edp_performs_user_effect_expr(expr: Expr, ename: String) -> Bool {
  edp_rq_fold(q = RQPerformsUserEffect(ename), e = expr) > 0
}

fn edp_performs_user_effect_exprs(es: Array[Expr], ename: String) -> Bool {
  edp_rq_exprs(q = RQPerformsUserEffect(ename), es = es) > 0
}

/// --- per-handle vacuity (#1119 Codex review, P2) -------------------------
///
/// Whether a SPECIFIC handle is vacuous is a question about ITS OWN body,
/// not about the program. The first cut asked "does the program perform E
/// anywhere", which is too coarse: `lib/@vibe/http` declares server-side
/// wrappers that DO `perform Http::Listen`, so the program-level answer was
/// yes and http_e2e_test's client-only handle — whose body reaches nothing
/// but direct host calls — stayed, then hard-errored (Http is a checker
/// BUILTIN effect, so migration has no operation list to build a dict
/// from). Per-handle reachability is also strictly more precise for the
/// declared-effect pun sites the coarse rule already covered.
///
/// `perf_fns` is the transitive set of top-level functions that can perform
/// E (edp_collect_performing_fns). A body "may perform" if it contains a
/// direct `perform E::op`, calls a member of `perf_fns`, or makes any call
/// this analysis cannot resolve to a known-inert target — the unresolved
/// case is deliberately conservative, since guessing wrong here would erase
/// a handler that really does fire.
fn edp_body_may_perform(body: Expr, ename: String, perf_fns: Array[String], inert: MutSet[String], fn_names: MutSet[String]) -> Bool {
  if edp_user_perform_effect_of(body) == ename {
    true
  } else {
    match body {
      ECall(callee, args, _, _) => match callee {
        EIdent(nm, _) => if nm == "perform" {
          // A perform of a DIFFERENT effect: only its operand's arguments
          // can reach further code.
          edp_may_perform_exprs(es = args, ename = ename, perf_fns = perf_fns, inert = inert, fn_names = fn_names)
        } else if edp_str_array_contains(arr = perf_fns, v = nm) {
          true
        } else if edp_callee_is_resolvable(nm = nm, inert = inert, fn_names = fn_names) {
          // Known-inert, or a known top-level fn already proven not to
          // perform E (it would be in perf_fns otherwise -- the set's
          // seed (b) also covers fns that call opaque targets).
          edp_may_perform_exprs(es = args, ename = ename, perf_fns = perf_fns, inert = inert, fn_names = fn_names)
        } else {
          true
        },
        _ => true
      },
      EHandle(b, arms) => if edp_handle_matches_effect(arms = arms, ename = ename) {
        // A nested same-effect handle discharges its own body; only the
        // arms can still reach outward.
        edp_may_perform_arms(arms = arms, ename = ename, perf_fns = perf_fns, inert = inert, fn_names = fn_names)
      } else {
        edp_body_may_perform(body = b, ename = ename, perf_fns = perf_fns, inert = inert, fn_names = fn_names) || edp_may_perform_arms(arms = arms, ename = ename, perf_fns = perf_fns, inert = inert, fn_names = fn_names)
      },
      EFn(_, _, _, _, _, b) => edp_body_may_perform(body = b, ename = ename, perf_fns = perf_fns, inert = inert, fn_names = fn_names),
      EIf(c, t, e2) => edp_body_may_perform(body = c, ename = ename, perf_fns = perf_fns, inert = inert, fn_names = fn_names) || edp_body_may_perform(body = t, ename = ename, perf_fns = perf_fns, inert = inert, fn_names = fn_names) || edp_body_may_perform(body = e2, ename = ename, perf_fns = perf_fns, inert = inert, fn_names = fn_names),
      EMatch(s, arms) => edp_body_may_perform(body = s, ename = ename, perf_fns = perf_fns, inert = inert, fn_names = fn_names) || edp_may_perform_arms(arms = arms, ename = ename, perf_fns = perf_fns, inert = inert, fn_names = fn_names),
      EWhile(c, b) => edp_body_may_perform(body = c, ename = ename, perf_fns = perf_fns, inert = inert, fn_names = fn_names) || edp_body_may_perform(body = b, ename = ename, perf_fns = perf_fns, inert = inert, fn_names = fn_names),
      EForIn(_, _, it, b) => edp_body_may_perform(body = it, ename = ename, perf_fns = perf_fns, inert = inert, fn_names = fn_names) || edp_body_may_perform(body = b, ename = ename, perf_fns = perf_fns, inert = inert, fn_names = fn_names),
      ELoop(pairs, b) => edp_may_perform_pairs(pairs = pairs, ename = ename, perf_fns = perf_fns, inert = inert, fn_names = fn_names) || edp_body_may_perform(body = b, ename = ename, perf_fns = perf_fns, inert = inert, fn_names = fn_names),
      ELet(_, v, b, _) => edp_body_may_perform(body = v, ename = ename, perf_fns = perf_fns, inert = inert, fn_names = fn_names) || edp_body_may_perform(body = b, ename = ename, perf_fns = perf_fns, inert = inert, fn_names = fn_names),
      ELetMut(_, v, b, _) => edp_body_may_perform(body = v, ename = ename, perf_fns = perf_fns, inert = inert, fn_names = fn_names) || edp_body_may_perform(body = b, ename = ename, perf_fns = perf_fns, inert = inert, fn_names = fn_names),
      ELetRec(_, v, b) => edp_body_may_perform(body = v, ename = ename, perf_fns = perf_fns, inert = inert, fn_names = fn_names) || edp_body_may_perform(body = b, ename = ename, perf_fns = perf_fns, inert = inert, fn_names = fn_names),
      ESeq(a, b) => edp_body_may_perform(body = a, ename = ename, perf_fns = perf_fns, inert = inert, fn_names = fn_names) || edp_body_may_perform(body = b, ename = ename, perf_fns = perf_fns, inert = inert, fn_names = fn_names),
      EAssign(_, v, c, _) => edp_body_may_perform(body = v, ename = ename, perf_fns = perf_fns, inert = inert, fn_names = fn_names) || edp_body_may_perform(body = c, ename = ename, perf_fns = perf_fns, inert = inert, fn_names = fn_names),
      EAssignOp(_, _, v, c, _) => edp_body_may_perform(body = v, ename = ename, perf_fns = perf_fns, inert = inert, fn_names = fn_names) || edp_body_may_perform(body = c, ename = ename, perf_fns = perf_fns, inert = inert, fn_names = fn_names),
      EReturn(e2) => edp_body_may_perform(body = e2, ename = ename, perf_fns = perf_fns, inert = inert, fn_names = fn_names),
      EDot(o, _, _, _) => edp_body_may_perform(body = o, ename = ename, perf_fns = perf_fns, inert = inert, fn_names = fn_names),
      EBinOp(_, l, r, _) => edp_body_may_perform(body = l, ename = ename, perf_fns = perf_fns, inert = inert, fn_names = fn_names) || edp_body_may_perform(body = r, ename = ename, perf_fns = perf_fns, inert = inert, fn_names = fn_names),
      EUnaryOp(_, e2) => edp_body_may_perform(body = e2, ename = ename, perf_fns = perf_fns, inert = inert, fn_names = fn_names),
      ELabeledArg(_, _, v) => edp_body_may_perform(body = v, ename = ename, perf_fns = perf_fns, inert = inert, fn_names = fn_names),
      EBreak(opt) => match opt {
        Some(e2) => edp_body_may_perform(body = e2, ename = ename, perf_fns = perf_fns, inert = inert, fn_names = fn_names),
        None => false
      },
      EContinue(args) => edp_may_perform_exprs(es = args, ename = ename, perf_fns = perf_fns, inert = inert, fn_names = fn_names),
      ETuple(elems) => edp_may_perform_exprs(es = elems, ename = ename, perf_fns = perf_fns, inert = inert, fn_names = fn_names),
      EArray(elems) => edp_may_perform_exprs(es = elems, ename = ename, perf_fns = perf_fns, inert = inert, fn_names = fn_names),
      ERecord(_, fields, _) => edp_may_perform_fields(fields = fields, ename = ename, perf_fns = perf_fns, inert = inert, fn_names = fn_names),
      EMap(fields) => edp_may_perform_fields(fields = fields, ename = ename, perf_fns = perf_fns, inert = inert, fn_names = fn_names),
      ESpread(e2) => edp_body_may_perform(body = e2, ename = ename, perf_fns = perf_fns, inert = inert, fn_names = fn_names),
      _ => false
    }
  }
}

fn edp_may_perform_exprs(es: Array[Expr], ename: String, perf_fns: Array[String], inert: MutSet[String], fn_names: MutSet[String]) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(es) && !found {
    found = edp_body_may_perform(body = Array::get(es, at = i), ename = ename, perf_fns = perf_fns, inert = inert, fn_names = fn_names)
    i = i + 1
  }
  found
}

fn edp_may_perform_arms(arms: Array[(Pat, Expr)], ename: String, perf_fns: Array[String], inert: MutSet[String], fn_names: MutSet[String]) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(arms) && !found {
    let (_, ex) = Array::get(arms, at = i)
    found = edp_body_may_perform(body = ex, ename = ename, perf_fns = perf_fns, inert = inert, fn_names = fn_names)
    i = i + 1
  }
  found
}

fn edp_may_perform_pairs(pairs: Array[(String, Expr)], ename: String, perf_fns: Array[String], inert: MutSet[String], fn_names: MutSet[String]) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(pairs) && !found {
    let (_, v) = Array::get(pairs, at = i)
    found = edp_body_may_perform(body = v, ename = ename, perf_fns = perf_fns, inert = inert, fn_names = fn_names)
    i = i + 1
  }
  found
}

fn edp_may_perform_fields(fields: Array[(String, Expr)], ename: String, perf_fns: Array[String], inert: MutSet[String], fn_names: MutSet[String]) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(fields) && !found {
    let (_, v) = Array::get(fields, at = i)
    found = edp_body_may_perform(body = v, ename = ename, perf_fns = perf_fns, inert = inert, fn_names = fn_names)
    i = i + 1
  }
  found
}

/// Top-level function names that can perform `ename`. Seeded with BOTH
///   (a) the ones whose body carries a direct `perform ename::op`
///       (syntactically, anywhere inside -- nested closures included, since
///       a literal defined here can be called from anywhere), and
///   (b) the ones whose body makes a call this analysis cannot resolve (an
///       opaque closure parameter, an indirect callee, a local binding) --
///       such a call can reach ANY code in the program, performs included.
/// Then closed transitively over calls-by-name until the set stops growing.
///
/// (b) is not optional: `apply_twice(f) = f() + f()` performs nothing
/// directly and calls nothing by name, so without it the whole set missed
/// it and a handle over `apply_twice(inner)` looked vacuous -- gate 40ap
/// caught exactly that ("null function or function signature mismatch",
/// the erased handler's dict never built). Only ever consulted when the
/// program really does perform `ename` somewhere; when it doesn't, every
/// site is vacuous by construction and no reachability question is asked.
export fn edp_collect_performing_fns(stmts: Array[Stmt], fn_defs: Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], ename: String, inert: MutSet[String], fn_names: MutSet[String]) -> Array[String] {
  let names: Array[String] = []
  let bodies: Array[Option[Expr]] = []
  for def in fn_defs {
    let (idx, _, _, name, _, _) = def
    Array::push(names, value = name)
    // Resolve through the definition's own statement index. Looking up by
    // name would discard non-last duplicate definitions and be unsound.
    Array::push(bodies, value = match Array::get(stmts, at = idx) {
      SLet(_, _, _, _, EFn(_, _, _, _, _, body)) => Some(body),
      _ => None
    })
  }
  edp_performing_names(names = names, bodies = bodies, effect = ename, inert = inert, fn_names = fn_names)
}

/// #2479: the dedup used to scan `out` per definition (O(fns²), 56 ms of a
/// warm compiler-closure compile); `seen` is its membership side.
export fn edp_all_fn_names(_ fn_defs: Array[(Int, Bool, Bool, String, Option[TypeExpr], String)]) -> Array[String] {
  let out: Array[String] = Array::with_capacity(Array::length(fn_defs))
  let seen: MutSet[String] = MutSet::with_capacity(hash_fn = hash_string, eq_fn = eq_string, capacity = Array::length(fn_defs) * 10 / 7 + 1)
  let mut i = 0
  while i < Array::length(fn_defs) {
    let (_, _, _, nm, _, _) = Array::get(fn_defs, at = i)
    if MutSet::has(seen, x = nm) {
      ()
    } else {
      MutSet::add(seen, x = nm)
      Array::push(out, value = nm)
    }
    i = i + 1
  }
  out
}

/// edp_perform_facts of each statement edp_program_user_performs reads, and
/// None for every other form. A `fn` statement's facts are its body's: an
/// `EFn` node is no call and no perform, and the walk descends into its body
/// alone, so edp_collect_performing_fns_from_facts can read them by index.
export fn edp_statement_perform_facts(stmts: Array[Stmt], inert: MutSet[String], fn_names: MutSet[String]) -> Array[Option[(Bool, Array[String], Array[String])]] {
  let out: Array[Option[(Bool, Array[String], Array[String])]] = Array::with_capacity(Array::length(stmts))
  let mut i = 0
  while i < Array::length(stmts) {
    Array::push(out, value = edp_one_statement_perform_facts(stmt = Array::get(stmts, at = i), inert = inert, fn_names = fn_names))
    i = i + 1
  }
  out
}

fn edp_one_statement_perform_facts(stmt: Stmt, inert: MutSet[String], fn_names: MutSet[String]) -> Option[(Bool, Array[String], Array[String])] {
  match stmt {
    SLet(_, _, _, _, expr) => Some(edp_perform_facts(e = expr, inert = inert, fn_names = fn_names)),
    SLetMut(_, _, expr) => Some(edp_perform_facts(e = expr, inert = inert, fn_names = fn_names)),
    SExpr(expr) => Some(edp_perform_facts(e = expr, inert = inert, fn_names = fn_names)),
    STest(_, expr) => Some(edp_perform_facts(e = expr, inert = inert, fn_names = fn_names)),
    SBench(_, expr) => Some(edp_perform_facts(e = expr, inert = inert, fn_names = fn_names)),
    _ => None
  }
}

/// Recompute the facts of the statements a rewrite may have replaced. The
/// caller names a superset of them; an unchanged statement recomputes to the
/// facts it already had.
export fn edp_refresh_statement_perform_facts(stmts: Array[Stmt], facts: Array[Option[(Bool, Array[String], Array[String])]], indices: Array[Int], inert: MutSet[String], fn_names: MutSet[String]) -> Unit {
  let mut k = 0
  while k < Array::length(indices) {
    let i = Array::get(indices, at = k)
    if i >= 0 && i < Array::length(stmts) {
      Array::set(facts, at = i, value = edp_one_statement_perform_facts(stmt = Array::get(stmts, at = i), inert = inert, fn_names = fn_names))
    } else ()
    k = k + 1
  }
}

/// edp_program_user_performs, answered from edp_statement_perform_facts of
/// the same statements.
export fn edp_facts_program_user_performs(facts: Array[Option[(Bool, Array[String], Array[String])]], ename: String) -> Bool {
  let mut found = false
  let mut i = 0
  while i < Array::length(facts) && !found {
    match Array::get(facts, at = i) {
      Some(fact) => {
        found = edp_perform_facts_performs(facts = fact, effect = ename)
      },
      None => ()
    }
    i = i + 1
  }
  found
}

/// edp_collect_performing_fns, answered from edp_statement_perform_facts of
/// the same statements, built with the same `inert` / `fn_names`.
export fn edp_collect_performing_fns_from_facts(stmts: Array[Stmt], fn_defs: Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], facts: Array[Option[(Bool, Array[String], Array[String])]], ename: String) -> Array[String] {
  let names: Array[String] = []
  let body_facts: Array[Option[(Bool, Array[String], Array[String])]] = []
  for def in fn_defs {
    let (idx, _, _, name, _, _) = def
    Array::push(names, value = name)
    Array::push(body_facts, value = match Array::get(stmts, at = idx) {
      SLet(_, _, _, _, EFn(_, _, _, _, _, _)) => Array::get(facts, at = idx),
      _ => None
    })
  }
  edp_performing_names_from_facts(names = names, facts = body_facts, effect = ename)
}

export fn edp_program_user_performs(stmts: Array[Stmt], ename: String) -> Bool {
  let mut found = false
  let mut i = 0
  while i < Array::length(stmts) && !found {
    match Array::get(stmts, at = i) {
      SLet(_, _, _, _, expr) => {
        found = edp_performs_user_effect_expr(expr = expr, ename = ename)
      },
      SLetMut(_, _, expr) => {
        found = edp_performs_user_effect_expr(expr = expr, ename = ename)
      },
      SExpr(expr) => {
        found = edp_performs_user_effect_expr(expr = expr, ename = ename)
      },
      STest(_, expr) => {
        found = edp_performs_user_effect_expr(expr = expr, ename = ename)
      },
      SBench(_, expr) => {
        found = edp_performs_user_effect_expr(expr = expr, ename = ename)
      },
      _ => ()
    }
    i = i + 1
  }
  found
}

/// Erase a `handle { body } with ename { ... }` (replace the node with its
/// own body) when the body provably cannot perform `ename`; see
/// edp_body_may_perform for the reachability rule. Handles whose body can
/// (or might) perform stay put for ordinary migration.
fn edp_erase_effect_handles_expr(expr: Expr, ename: String, analyze: Bool, perf_fns: Array[String], inert: MutSet[String], fn_names: MutSet[String]) -> Expr {
  match expr {
    EHandle(body, arms) => {
      let body2 = edp_erase_effect_handles_expr(expr = body, ename = ename, analyze = analyze, perf_fns = perf_fns, inert = inert, fn_names = fn_names)
      if edp_handle_matches_effect(arms = arms, ename = ename) && (!analyze || !edp_body_may_perform(body = body, ename = ename, perf_fns = perf_fns, inert = inert, fn_names = fn_names)) {
        let rest: Array[(Pat, Expr)] = []
        for arm in arms {
          if !edp_handle_matches_effect(arms = [arm], ename = ename) {
            let (p, ex) = arm
            Array::push(rest, value = (p, edp_erase_effect_handles_expr(expr = ex, ename = ename, analyze = analyze, perf_fns = perf_fns, inert = inert, fn_names = fn_names)))
          }
        }
        if Array::length(rest) == 0 {
          body2
        } else {
          EHandle(body2, rest)
        }
      } else {
        EHandle(body2, for a in arms {
          let (p, ex) = a
          (p, edp_erase_effect_handles_expr(expr = ex, ename = ename, analyze = analyze, perf_fns = perf_fns, inert = inert, fn_names = fn_names))
        })
      }
    },
    EFn(tps, tbs, params, ret, eff, body) => EFn(tps, tbs, params, ret, eff, edp_erase_effect_handles_expr(expr = body, ename = ename, analyze = analyze, perf_fns = perf_fns, inert = inert, fn_names = fn_names)),
    EIf(c, t, e2) => EIf(edp_erase_effect_handles_expr(expr = c, ename = ename, analyze = analyze, perf_fns = perf_fns, inert = inert, fn_names = fn_names), edp_erase_effect_handles_expr(expr = t, ename = ename, analyze = analyze, perf_fns = perf_fns, inert = inert, fn_names = fn_names), edp_erase_effect_handles_expr(expr = e2, ename = ename, analyze = analyze, perf_fns = perf_fns, inert = inert, fn_names = fn_names)),
    EMatch(s, arms) => EMatch(edp_erase_effect_handles_expr(expr = s, ename = ename, analyze = analyze, perf_fns = perf_fns, inert = inert, fn_names = fn_names), for a in arms {
      let (p, ex) = a
      (p, edp_erase_effect_handles_expr(expr = ex, ename = ename, analyze = analyze, perf_fns = perf_fns, inert = inert, fn_names = fn_names))
    }),
    EWhile(c, b) => EWhile(edp_erase_effect_handles_expr(expr = c, ename = ename, analyze = analyze, perf_fns = perf_fns, inert = inert, fn_names = fn_names), edp_erase_effect_handles_expr(expr = b, ename = ename, analyze = analyze, perf_fns = perf_fns, inert = inert, fn_names = fn_names)),
    EForIn(n, idx, it, b) => EForIn(n, idx, edp_erase_effect_handles_expr(expr = it, ename = ename, analyze = analyze, perf_fns = perf_fns, inert = inert, fn_names = fn_names), edp_erase_effect_handles_expr(expr = b, ename = ename, analyze = analyze, perf_fns = perf_fns, inert = inert, fn_names = fn_names)),
    ELoop(pairs, b) => ELoop(for pr in pairs {
      let (n, v) = pr
      (n, edp_erase_effect_handles_expr(expr = v, ename = ename, analyze = analyze, perf_fns = perf_fns, inert = inert, fn_names = fn_names))
    }, edp_erase_effect_handles_expr(expr = b, ename = ename, analyze = analyze, perf_fns = perf_fns, inert = inert, fn_names = fn_names)),
    ELet(n, v, b, off) => ELet(n, edp_erase_effect_handles_expr(expr = v, ename = ename, analyze = analyze, perf_fns = perf_fns, inert = inert, fn_names = fn_names), edp_erase_effect_handles_expr(expr = b, ename = ename, analyze = analyze, perf_fns = perf_fns, inert = inert, fn_names = fn_names), off),
    ELetMut(n, v, b, off) => ELetMut(n, edp_erase_effect_handles_expr(expr = v, ename = ename, analyze = analyze, perf_fns = perf_fns, inert = inert, fn_names = fn_names), edp_erase_effect_handles_expr(expr = b, ename = ename, analyze = analyze, perf_fns = perf_fns, inert = inert, fn_names = fn_names), off),
    ELetRec(n, v, b) => ELetRec(n, edp_erase_effect_handles_expr(expr = v, ename = ename, analyze = analyze, perf_fns = perf_fns, inert = inert, fn_names = fn_names), edp_erase_effect_handles_expr(expr = b, ename = ename, analyze = analyze, perf_fns = perf_fns, inert = inert, fn_names = fn_names)),
    ESeq(a, b) => ESeq(edp_erase_effect_handles_expr(expr = a, ename = ename, analyze = analyze, perf_fns = perf_fns, inert = inert, fn_names = fn_names), edp_erase_effect_handles_expr(expr = b, ename = ename, analyze = analyze, perf_fns = perf_fns, inert = inert, fn_names = fn_names)),
    EAssign(n, v, c, target_off) => EAssign(n, edp_erase_effect_handles_expr(expr = v, ename = ename, analyze = analyze, perf_fns = perf_fns, inert = inert, fn_names = fn_names), edp_erase_effect_handles_expr(expr = c, ename = ename, analyze = analyze, perf_fns = perf_fns, inert = inert, fn_names = fn_names), target_off),
    EAssignOp(n, op, v, c, target_off) => EAssignOp(n, op, edp_erase_effect_handles_expr(expr = v, ename = ename, analyze = analyze, perf_fns = perf_fns, inert = inert, fn_names = fn_names), edp_erase_effect_handles_expr(expr = c, ename = ename, analyze = analyze, perf_fns = perf_fns, inert = inert, fn_names = fn_names), target_off),
    EReturn(e2) => EReturn(edp_erase_effect_handles_expr(expr = e2, ename = ename, analyze = analyze, perf_fns = perf_fns, inert = inert, fn_names = fn_names)),
    EDot(o, f, off1, off2) => EDot(edp_erase_effect_handles_expr(expr = o, ename = ename, analyze = analyze, perf_fns = perf_fns, inert = inert, fn_names = fn_names), f, off1, off2),
    ECall(callee, args, off, callee_resolution) => ECall(edp_erase_effect_handles_expr(expr = callee, ename = ename, analyze = analyze, perf_fns = perf_fns, inert = inert, fn_names = fn_names), edp_erase_effect_handles_exprs(es = args, ename = ename, analyze = analyze, perf_fns = perf_fns, inert = inert, fn_names = fn_names), off, callee_resolution),
    EBinOp(op, l, r, boff) => EBinOp(op, edp_erase_effect_handles_expr(expr = l, ename = ename, analyze = analyze, perf_fns = perf_fns, inert = inert, fn_names = fn_names), edp_erase_effect_handles_expr(expr = r, ename = ename, analyze = analyze, perf_fns = perf_fns, inert = inert, fn_names = fn_names), boff),
    EUnaryOp(op, e2) => EUnaryOp(op, edp_erase_effect_handles_expr(expr = e2, ename = ename, analyze = analyze, perf_fns = perf_fns, inert = inert, fn_names = fn_names)),
    ELabeledArg(l, n, v) => ELabeledArg(l, n, edp_erase_effect_handles_expr(expr = v, ename = ename, analyze = analyze, perf_fns = perf_fns, inert = inert, fn_names = fn_names)),
    EBreak(opt) => EBreak(match opt {
      Some(e2) => Some(edp_erase_effect_handles_expr(expr = e2, ename = ename, analyze = analyze, perf_fns = perf_fns, inert = inert, fn_names = fn_names)),
      None => None
    }),
    EContinue(args) => EContinue(edp_erase_effect_handles_exprs(es = args, ename = ename, analyze = analyze, perf_fns = perf_fns, inert = inert, fn_names = fn_names)),
    ETuple(elems) => ETuple(edp_erase_effect_handles_exprs(es = elems, ename = ename, analyze = analyze, perf_fns = perf_fns, inert = inert, fn_names = fn_names)),
    EArray(elems) => EArray(edp_erase_effect_handles_exprs(es = elems, ename = ename, analyze = analyze, perf_fns = perf_fns, inert = inert, fn_names = fn_names)),
    ERecord(rn, fields, targs) => ERecord(rn, for f in fields {
      let (fn2, v) = f
      (fn2, edp_erase_effect_handles_expr(expr = v, ename = ename, analyze = analyze, perf_fns = perf_fns, inert = inert, fn_names = fn_names))
    }, targs),
    EMap(fields) => EMap(for f in fields {
      let (fn2, v) = f
      (fn2, edp_erase_effect_handles_expr(expr = v, ename = ename, analyze = analyze, perf_fns = perf_fns, inert = inert, fn_names = fn_names))
    }),
    ESpread(e2) => ESpread(edp_erase_effect_handles_expr(expr = e2, ename = ename, analyze = analyze, perf_fns = perf_fns, inert = inert, fn_names = fn_names)),
    _ => expr
  }
}

fn edp_erase_effect_handles_exprs(es: Array[Expr], ename: String, analyze: Bool, perf_fns: Array[String], inert: MutSet[String], fn_names: MutSet[String]) -> Array[Expr] {
  for e in es {
    edp_erase_effect_handles_expr(expr = e, ename = ename, analyze = analyze, perf_fns = perf_fns, inert = inert, fn_names = fn_names)
  }
}

export fn edp_erase_effect_handles(stmts: Array[Stmt], ename: String, analyze: Bool, perf_fns: Array[String], inert: MutSet[String], fn_names: MutSet[String]) -> Unit {
  edp_erase_effect_handles_with_index(stmts = stmts, ename = ename, analyze = analyze, perf_fns = perf_fns, inert = inert, fn_names = fn_names, statement_indices = None)
}

/// Reuse statement candidates while lowering preserves statement ownership.
/// Every candidate is checked against its current expression before use.
export fn edp_erase_effect_handles_with_index(stmts: Array[Stmt], ename: String, analyze: Bool, perf_fns: Array[String], inert: MutSet[String], fn_names: MutSet[String], statement_indices: Option[Array[Int]]) -> Unit {
  // #1875 R3: edp_erase_effect_handles_expr is a RECONSTRUCTING walk -- on a
  // statement with no matching handle site it rebuilds the whole expression
  // tree only to return a structurally identical copy. Handle sites are rare
  // (a handful of statements in a whole merged program), so gate the rebuild
  // behind a read-only containment query and leave every other statement
  // untouched.
  let hq = RQHandlesEffect(ename)
  let candidate_count = match statement_indices {
    Some(indices) => Array::length(indices),
    None => Array::length(stmts)
  }
  let mut site_pos = 0
  while site_pos < candidate_count {
    let i = match statement_indices {
      Some(indices) => Array::get(indices, at = site_pos),
      None => site_pos
    }
    match Array::get(stmts, at = i) {
      SLet(exported, is_rec, name, ty, expr) => if edp_rq_fold(q = hq, e = expr) > 0 {
        edp_mf_set_stmt(stmts = stmts, i = i, stmt = SLet(exported, is_rec, name, ty, edp_erase_effect_handles_expr(expr = expr, ename = ename, analyze = analyze, perf_fns = perf_fns, inert = inert, fn_names = fn_names)))
      } else {
        ()
      },
      SLetMut(nm, ty, expr) => if edp_rq_fold(q = hq, e = expr) > 0 {
        edp_mf_set_stmt(stmts = stmts, i = i, stmt = SLetMut(nm, ty, edp_erase_effect_handles_expr(expr = expr, ename = ename, analyze = analyze, perf_fns = perf_fns, inert = inert, fn_names = fn_names)))
      } else {
        ()
      },
      SExpr(expr) => if edp_rq_fold(q = hq, e = expr) > 0 {
        edp_mf_set_stmt(stmts = stmts, i = i, stmt = SExpr(edp_erase_effect_handles_expr(expr = expr, ename = ename, analyze = analyze, perf_fns = perf_fns, inert = inert, fn_names = fn_names)))
      } else {
        ()
      },
      STest(tn, expr) => if edp_rq_fold(q = hq, e = expr) > 0 {
        edp_mf_set_stmt(stmts = stmts, i = i, stmt = STest(tn, edp_erase_effect_handles_expr(expr = expr, ename = ename, analyze = analyze, perf_fns = perf_fns, inert = inert, fn_names = fn_names)))
      } else {
        ()
      },
      SBench(bn, expr) => if edp_rq_fold(q = hq, e = expr) > 0 {
        edp_mf_set_stmt(stmts = stmts, i = i, stmt = SBench(bn, edp_erase_effect_handles_expr(expr = expr, ename = ename, analyze = analyze, perf_fns = perf_fns, inert = inert, fn_names = fn_names)))
      } else {
        ()
      },
      _ => ()
    }
    site_pos = site_pos + 1
  }
}

/// --- V2 step 2: seed-scoped α-rename of shadowing binders. --------------
///
/// edp_rewrite_needing_body / edp_rewrite_handle_body match call sites by
/// NAME ONLY, so #1074's edp_drop_shadowed_needing conservatively dropped
/// any needing name shadowed anywhere -- and the site then fell back to
/// replay. With replay removed that fallback is a hard error, and "a local
/// variable somewhere reuses an effectful function's name" is far too
/// common to reject. Instead of teaching every rewriter scope tracking,
/// rename the SHADOWING binders themselves (`__edpsh_N_<name>`, plain
/// α-conversion, semantics-free): afterwards the name-only match is exact,
/// edp_drop_shadowed_needing finds nothing to drop, and the shadowed-
/// needing class migrates like any other program. The same trick is
/// already proven program-wide by the RC lane's uniquify_shadowed_bindings
/// (#712, normalize/index.vibe) -- this is its seed-scoped local cousin
/// (local copy per this file's convention; only binders whose name is in
/// `seed` are touched, everything else is left byte-identical). Any binder
/// shape this traversal might ever miss stays shadowed and is still caught
/// by edp_drop_shadowed_needing, so the failure mode is the OLD
/// conservative behavior (now a loud ineligibility error), never a
/// miscompile.
/// The tag of the top-level statement `edp_ar_expr` is renaming (#3829).
let edp_ar_owner: Array[String] = [""]

export fn edp_ar_set_owner(_ tag: String) -> Unit {
  Array::set(edp_ar_owner, at = 0, value = tag)
}

/// #1119 Codex review (P2): the generated spelling must not collide with a
/// name the program ALREADY uses. If user code binds `__edpsh_0_helper`
/// itself and also shadows a needing `helper`, a blind counter would rename
/// the shadow ONTO the existing binding -- two distinct bindings become one
/// name before any later uniquification can tell them apart, so reads of
/// the pre-existing one can resolve to the renamed shadow (wrong value, no
/// diagnostic). `taken` carries every `__edpsh_`-prefixed name already
/// present anywhere in the program (edp_collect_prefixed_names, one scan);
/// the counter skips past any candidate that hits it.
///
/// #3829: `counter` counts within the owning top-level statement and the name
/// carries that statement's tag (`edp_ar_owner`), so it is unique across the
/// program without being numbered by the statements before it.
fn edp_ar_fresh(counter: Array[Int], name: String, taken: Array[String]) -> String {
  let mut out = ""
  while out == "" {
    let n = Array::get(counter, at = 0)
    Array::set(counter, at = 0, value = n + 1)
    let cand = String::concat(String::concat(String::concat(String::concat(String::concat("__edpsh_", __to_string(n)), "o"), Array::get(edp_ar_owner, at = 0)), "_"), name)
    if edp_str_array_contains(arr = taken, v = cand) {
      ()
    } else {
      out = cand
    }
  }
  out
}

/// Every name starting with `prefix` that appears anywhere in `stmts` --
/// as a binder OR as a reference. Prefix-filtered (not a full identifier
/// census) because the only collisions that matter are against the
/// generated `__edpsh_` namespace, and the compiler program carries
/// thousands of ordinary identifiers a full collection would scan on
/// every membership test.
export fn edp_collect_prefixed_names(stmts: Array[Stmt], prefix: String, out: Array[String]) -> Unit {
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, at = i) {
      SLet(_, _, nm, _, expr) => {
        edp_prefix_push(nm = nm, prefix = prefix, out = out)
        edp_collect_prefixed_expr(expr = expr, prefix = prefix, out = out)
      },
      SLetMut(nm, _, expr) => {
        edp_prefix_push(nm = nm, prefix = prefix, out = out)
        edp_collect_prefixed_expr(expr = expr, prefix = prefix, out = out)
      },
      SExpr(expr) => edp_collect_prefixed_expr(expr = expr, prefix = prefix, out = out),
      STest(_, expr) => edp_collect_prefixed_expr(expr = expr, prefix = prefix, out = out),
      SBench(_, expr) => edp_collect_prefixed_expr(expr = expr, prefix = prefix, out = out),
      _ => ()
    }
    i = i + 1
  }
}

fn edp_prefix_push(nm: String, prefix: String, out: Array[String]) -> Unit {
  if String::starts_with(nm, prefix = prefix) && !edp_str_array_contains(arr = out, v = nm) {
    Array::push(out, value = nm)
  } else {
    ()
  }
}

fn edp_collect_prefixed_pat(p: Pat, prefix: String, out: Array[String]) -> Unit {
  let names = array_empty()
  edp_pat_binds(p = p, out = names)
  let mut i = 0
  while i < Array::length(names) {
    edp_prefix_push(nm = Array::get(names, at = i), prefix = prefix, out = out)
    i = i + 1
  }
}

fn edp_collect_prefixed_exprs(es: Array[Expr], prefix: String, out: Array[String]) -> Unit {
  let mut i = 0
  while i < Array::length(es) {
    edp_collect_prefixed_expr(expr = Array::get(es, at = i), prefix = prefix, out = out)
    i = i + 1
  }
}

fn edp_collect_prefixed_expr(expr: Expr, prefix: String, out: Array[String]) -> Unit {
  match expr {
    EIdent(nm, _) => edp_prefix_push(nm = nm, prefix = prefix, out = out),
    EFn(_, _, params, _, _, body) => {
      let mut i = 0
      while i < Array::length(params) {
        let (pn, _) = Array::get(params, at = i)
        edp_prefix_push(nm = edp_strip_tilde(pn), prefix = prefix, out = out)
        i = i + 1
      }
      edp_collect_prefixed_expr(expr = body, prefix = prefix, out = out)
    },
    EHandle(b, arms) => {
      edp_collect_prefixed_expr(expr = b, prefix = prefix, out = out)
      let mut i = 0
      while i < Array::length(arms) {
        let (p, ex) = Array::get(arms, at = i)
        edp_collect_prefixed_pat(p = p, prefix = prefix, out = out)
        edp_collect_prefixed_expr(expr = ex, prefix = prefix, out = out)
        i = i + 1
      }
    },
    EMatch(s, arms) => {
      edp_collect_prefixed_expr(expr = s, prefix = prefix, out = out)
      let mut i = 0
      while i < Array::length(arms) {
        let (p, ex) = Array::get(arms, at = i)
        edp_collect_prefixed_pat(p = p, prefix = prefix, out = out)
        edp_collect_prefixed_expr(expr = ex, prefix = prefix, out = out)
        i = i + 1
      }
    },
    EIf(c, t, e2) => {
      edp_collect_prefixed_expr(expr = c, prefix = prefix, out = out)
      edp_collect_prefixed_expr(expr = t, prefix = prefix, out = out)
      edp_collect_prefixed_expr(expr = e2, prefix = prefix, out = out)
    },
    EWhile(c, b) => {
      edp_collect_prefixed_expr(expr = c, prefix = prefix, out = out)
      edp_collect_prefixed_expr(expr = b, prefix = prefix, out = out)
    },
    EForIn(n, idx, it, b) => {
      edp_prefix_push(nm = n, prefix = prefix, out = out)
      match idx {
        Some(iname) => edp_prefix_push(nm = iname, prefix = prefix, out = out),
        None => ()
      }
      edp_collect_prefixed_expr(expr = it, prefix = prefix, out = out)
      edp_collect_prefixed_expr(expr = b, prefix = prefix, out = out)
    },
    ELoop(pairs, b) => {
      let mut i = 0
      while i < Array::length(pairs) {
        let (pn, v) = Array::get(pairs, at = i)
        edp_prefix_push(nm = pn, prefix = prefix, out = out)
        edp_collect_prefixed_expr(expr = v, prefix = prefix, out = out)
        i = i + 1
      }
      edp_collect_prefixed_expr(expr = b, prefix = prefix, out = out)
    },
    ELet(n, v, b, _) => {
      edp_prefix_push(nm = n, prefix = prefix, out = out)
      edp_collect_prefixed_expr(expr = v, prefix = prefix, out = out)
      edp_collect_prefixed_expr(expr = b, prefix = prefix, out = out)
    },
    ELetMut(n, v, b, _) => {
      edp_prefix_push(nm = n, prefix = prefix, out = out)
      edp_collect_prefixed_expr(expr = v, prefix = prefix, out = out)
      edp_collect_prefixed_expr(expr = b, prefix = prefix, out = out)
    },
    ELetRec(n, v, b) => {
      edp_prefix_push(nm = n, prefix = prefix, out = out)
      edp_collect_prefixed_expr(expr = v, prefix = prefix, out = out)
      edp_collect_prefixed_expr(expr = b, prefix = prefix, out = out)
    },
    ESeq(a, b) => {
      edp_collect_prefixed_expr(expr = a, prefix = prefix, out = out)
      edp_collect_prefixed_expr(expr = b, prefix = prefix, out = out)
    },
    EAssign(n, v, c, _) => {
      edp_prefix_push(nm = n, prefix = prefix, out = out)
      edp_collect_prefixed_expr(expr = v, prefix = prefix, out = out)
      edp_collect_prefixed_expr(expr = c, prefix = prefix, out = out)
    },
    EAssignOp(n, _, v, c, _) => {
      edp_prefix_push(nm = n, prefix = prefix, out = out)
      edp_collect_prefixed_expr(expr = v, prefix = prefix, out = out)
      edp_collect_prefixed_expr(expr = c, prefix = prefix, out = out)
    },
    EReturn(e2) => edp_collect_prefixed_expr(expr = e2, prefix = prefix, out = out),
    EDot(o, _, _, _) => edp_collect_prefixed_expr(expr = o, prefix = prefix, out = out),
    ECall(callee, args, _, _) => {
      edp_collect_prefixed_expr(expr = callee, prefix = prefix, out = out)
      edp_collect_prefixed_exprs(es = args, prefix = prefix, out = out)
    },
    EBinOp(_, l, r, _) => {
      edp_collect_prefixed_expr(expr = l, prefix = prefix, out = out)
      edp_collect_prefixed_expr(expr = r, prefix = prefix, out = out)
    },
    EUnaryOp(_, e2) => edp_collect_prefixed_expr(expr = e2, prefix = prefix, out = out),
    ELabeledArg(_, _, v) => edp_collect_prefixed_expr(expr = v, prefix = prefix, out = out),
    EBreak(opt) => match opt {
      Some(e2) => edp_collect_prefixed_expr(expr = e2, prefix = prefix, out = out),
      None => ()
    },
    EContinue(args) => edp_collect_prefixed_exprs(es = args, prefix = prefix, out = out),
    ETuple(elems) => edp_collect_prefixed_exprs(es = elems, prefix = prefix, out = out),
    EArray(elems) => edp_collect_prefixed_exprs(es = elems, prefix = prefix, out = out),
    ERecord(_, fields, _) => {
      let mut i = 0
      while i < Array::length(fields) {
        let (_, v) = Array::get(fields, at = i)
        edp_collect_prefixed_expr(expr = v, prefix = prefix, out = out)
        i = i + 1
      }
    },
    EMap(fields) => {
      let mut i = 0
      while i < Array::length(fields) {
        let (_, v) = Array::get(fields, at = i)
        edp_collect_prefixed_expr(expr = v, prefix = prefix, out = out)
        i = i + 1
      }
    },
    ESpread(e2) => edp_collect_prefixed_expr(expr = e2, prefix = prefix, out = out),
    _ => ()
  }
}

fn edp_ar_lookup(env_names: Array[String], env_repl: Array[String], name: String) -> String {
  let mut i = Array::length(env_names) - 1
  let mut out = name
  let mut found = false
  while i >= 0 && !found {
    if Array::get(env_names, at = i) == name {
      out = Array::get(env_repl, at = i)
      found = true
    } else {
      ()
    }
    i = i - 1
  }
  out
}

fn edp_ar_bind(name: String, seed: Array[String], env_names: Array[String], env_repl: Array[String], counter: Array[Int], taken: Array[String]) -> String {
  if edp_str_array_contains(arr = seed, v = name) {
    let fresh = edp_ar_fresh(counter = counter, name = name, taken = taken)
    Array::push(env_names, value = name)
    Array::push(env_repl, value = fresh)
    fresh
  } else {
    name
  }
}

fn edp_ar_pat_rewrite(p: Pat, env_names: Array[String], env_repl: Array[String]) -> Pat {
  match p {
    PBind(n) => PBind(edp_ar_lookup(env_names = env_names, env_repl = env_repl, name = n)),
    PCtor(nm, args) => PCtor(nm, for a in args {
      edp_ar_pat_rewrite(p = a, env_names = env_names, env_repl = env_repl)
    }),
    PTuple(ps) => PTuple(for a in ps {
      edp_ar_pat_rewrite(p = a, env_names = env_names, env_repl = env_repl)
    }),
    POr(a, b) => POr(edp_ar_pat_rewrite(p = a, env_names = env_names, env_repl = env_repl), edp_ar_pat_rewrite(p = b, env_names = env_names, env_repl = env_repl)),
    PStruct(nm, fields) => PStruct(nm, for f in fields {
      let (fname, fp) = f
      (fname, edp_ar_pat_rewrite(p = fp, env_names = env_names, env_repl = env_repl))
    }),
    _ => p
  }
}

/// Two-phase like normalize's uq_bind_pat: bind every seed-colliding name
/// first (POr binds the same name on both sides -- last mapping wins for
/// both, keeping the sides consistent), then rewrite the pattern via
/// lookup.
fn edp_ar_bind_pat(p: Pat, seed: Array[String], env_names: Array[String], env_repl: Array[String], counter: Array[Int], taken: Array[String]) -> Pat {
  let names = array_empty()
  edp_pat_binds(p = p, out = names)
  let mut i = 0
  while i < Array::length(names) {
    let _ = edp_ar_bind(name = Array::get(names, at = i), seed = seed, env_names = env_names, env_repl = env_repl, counter = counter, taken = taken)
    i = i + 1
  }
  edp_ar_pat_rewrite(p = p, env_names = env_names, env_repl = env_repl)
}

fn edp_ar_exprs(es: Array[Expr], seed: Array[String], env_names: Array[String], env_repl: Array[String], counter: Array[Int], taken: Array[String]) -> Array[Expr] {
  for e in es {
    edp_ar_expr(expr = e, seed = seed, env_names = env_names, env_repl = env_repl, counter = counter, taken = taken)
  }
}

export fn edp_ar_expr(expr: Expr, seed: Array[String], env_names: Array[String], env_repl: Array[String], counter: Array[Int], taken: Array[String]) -> Expr {
  match expr {
    EIdent(n, off) => EIdent(edp_ar_lookup(env_names = env_names, env_repl = env_repl, name = n), off),
    EFn(tps, tbs, params, ret, eff, body) => {
      let base = Array::length(env_names)
      let params2: Array[(String, Option[TypeExpr])] = []
      let mut i = 0
      while i < Array::length(params) {
        let (pn, pty) = Array::get(params, at = i)
        // Calls have had their labels resolved before effect lowering. Keep
        // the marker, but rename the lexical name, not the marked spelling.
        let name = edp_strip_tilde(pn)
        let renamed = edp_ar_bind(name = name, seed = seed, env_names = env_names, env_repl = env_repl, counter = counter, taken = taken)
        let pn2 = if pn != name {
          String::concat(renamed, "~")
        } else {
          renamed
        }
        Array::push(params2, value = (pn2, pty))
        i = i + 1
      }
      let body2 = edp_ar_expr(expr = body, seed = seed, env_names = env_names, env_repl = env_repl, counter = counter, taken = taken)
      Array::truncate(env_names, length = base)
      Array::truncate(env_repl, length = base)
      EFn(tps, tbs, params2, ret, eff, body2)
    },
    EHandle(body, arms) => EHandle(edp_ar_expr(expr = body, seed = seed, env_names = env_names, env_repl = env_repl, counter = counter, taken = taken), for a in arms {
      let (p, ex) = a
      let base = Array::length(env_names)
      let p2 = edp_ar_bind_pat(p = p, seed = seed, env_names = env_names, env_repl = env_repl, counter = counter, taken = taken)
      let ex2 = edp_ar_expr(expr = ex, seed = seed, env_names = env_names, env_repl = env_repl, counter = counter, taken = taken)
      Array::truncate(env_names, length = base)
      Array::truncate(env_repl, length = base)
      (p2, ex2)
    }),
    EMatch(s, arms) => EMatch(edp_ar_expr(expr = s, seed = seed, env_names = env_names, env_repl = env_repl, counter = counter, taken = taken), for a in arms {
      let (p, ex) = a
      let base = Array::length(env_names)
      let p2 = edp_ar_bind_pat(p = p, seed = seed, env_names = env_names, env_repl = env_repl, counter = counter, taken = taken)
      let ex2 = edp_ar_expr(expr = ex, seed = seed, env_names = env_names, env_repl = env_repl, counter = counter, taken = taken)
      Array::truncate(env_names, length = base)
      Array::truncate(env_repl, length = base)
      (p2, ex2)
    }),
    EIf(c, t, e2) => EIf(edp_ar_expr(expr = c, seed = seed, env_names = env_names, env_repl = env_repl, counter = counter, taken = taken), edp_ar_expr(expr = t, seed = seed, env_names = env_names, env_repl = env_repl, counter = counter, taken = taken), edp_ar_expr(expr = e2, seed = seed, env_names = env_names, env_repl = env_repl, counter = counter, taken = taken)),
    EWhile(c, b) => EWhile(edp_ar_expr(expr = c, seed = seed, env_names = env_names, env_repl = env_repl, counter = counter, taken = taken), edp_ar_expr(expr = b, seed = seed, env_names = env_names, env_repl = env_repl, counter = counter, taken = taken)),
    EForIn(n, idx, it, b) => {
      let it2 = edp_ar_expr(expr = it, seed = seed, env_names = env_names, env_repl = env_repl, counter = counter, taken = taken)
      let base = Array::length(env_names)
      let n2 = edp_ar_bind(name = n, seed = seed, env_names = env_names, env_repl = env_repl, counter = counter, taken = taken)
      let idx2 = match idx {
        Some(iname) => Some(edp_ar_bind(name = iname, seed = seed, env_names = env_names, env_repl = env_repl, counter = counter, taken = taken)),
        None => None
      }
      let b2 = edp_ar_expr(expr = b, seed = seed, env_names = env_names, env_repl = env_repl, counter = counter, taken = taken)
      Array::truncate(env_names, length = base)
      Array::truncate(env_repl, length = base)
      EForIn(n2, idx2, it2, b2)
    },
    ELoop(pairs, b) => {
      let inits2: Array[Expr] = []
      let mut i = 0
      while i < Array::length(pairs) {
        let (_, v) = Array::get(pairs, at = i)
        Array::push(inits2, value = edp_ar_expr(expr = v, seed = seed, env_names = env_names, env_repl = env_repl, counter = counter, taken = taken))
        i = i + 1
      }
      let base = Array::length(env_names)
      let pairs2: Array[(String, Expr)] = []
      let mut j = 0
      while j < Array::length(pairs) {
        let (pn, _) = Array::get(pairs, at = j)
        Array::push(pairs2, value = (edp_ar_bind(name = pn, seed = seed, env_names = env_names, env_repl = env_repl, counter = counter, taken = taken), Array::get(inits2, at = j)))
        j = j + 1
      }
      let b2 = edp_ar_expr(expr = b, seed = seed, env_names = env_names, env_repl = env_repl, counter = counter, taken = taken)
      Array::truncate(env_names, length = base)
      Array::truncate(env_repl, length = base)
      ELoop(pairs2, b2)
    },
    ELet(n, v, b, off) => {
      let v2 = edp_ar_expr(expr = v, seed = seed, env_names = env_names, env_repl = env_repl, counter = counter, taken = taken)
      let base = Array::length(env_names)
      let n2 = edp_ar_bind(name = n, seed = seed, env_names = env_names, env_repl = env_repl, counter = counter, taken = taken)
      let b2 = edp_ar_expr(expr = b, seed = seed, env_names = env_names, env_repl = env_repl, counter = counter, taken = taken)
      Array::truncate(env_names, length = base)
      Array::truncate(env_repl, length = base)
      ELet(n2, v2, b2, off)
    },
    ELetMut(n, v, b, off) => {
      let v2 = edp_ar_expr(expr = v, seed = seed, env_names = env_names, env_repl = env_repl, counter = counter, taken = taken)
      let base = Array::length(env_names)
      let n2 = edp_ar_bind(name = n, seed = seed, env_names = env_names, env_repl = env_repl, counter = counter, taken = taken)
      let b2 = edp_ar_expr(expr = b, seed = seed, env_names = env_names, env_repl = env_repl, counter = counter, taken = taken)
      Array::truncate(env_names, length = base)
      Array::truncate(env_repl, length = base)
      ELetMut(n2, v2, b2, off)
    },
    ELetRec(n, v, b) => {
      let base = Array::length(env_names)
      let n2 = edp_ar_bind(name = n, seed = seed, env_names = env_names, env_repl = env_repl, counter = counter, taken = taken)
      let v2 = edp_ar_expr(expr = v, seed = seed, env_names = env_names, env_repl = env_repl, counter = counter, taken = taken)
      let b2 = edp_ar_expr(expr = b, seed = seed, env_names = env_names, env_repl = env_repl, counter = counter, taken = taken)
      Array::truncate(env_names, length = base)
      Array::truncate(env_repl, length = base)
      ELetRec(n2, v2, b2)
    },
    ESeq(a, b) => ESeq(edp_ar_expr(expr = a, seed = seed, env_names = env_names, env_repl = env_repl, counter = counter, taken = taken), edp_ar_expr(expr = b, seed = seed, env_names = env_names, env_repl = env_repl, counter = counter, taken = taken)),
    EAssign(n, v, c, target_off) => EAssign(edp_ar_lookup(env_names = env_names, env_repl = env_repl, name = n), edp_ar_expr(expr = v, seed = seed, env_names = env_names, env_repl = env_repl, counter = counter, taken = taken), edp_ar_expr(expr = c, seed = seed, env_names = env_names, env_repl = env_repl, counter = counter, taken = taken), target_off),
    EAssignOp(n, op, v, c, target_off) => EAssignOp(edp_ar_lookup(env_names = env_names, env_repl = env_repl, name = n), op, edp_ar_expr(expr = v, seed = seed, env_names = env_names, env_repl = env_repl, counter = counter, taken = taken), edp_ar_expr(expr = c, seed = seed, env_names = env_names, env_repl = env_repl, counter = counter, taken = taken), target_off),
    EReturn(e2) => EReturn(edp_ar_expr(expr = e2, seed = seed, env_names = env_names, env_repl = env_repl, counter = counter, taken = taken)),
    EDot(o, f, off1, off2) => EDot(edp_ar_expr(expr = o, seed = seed, env_names = env_names, env_repl = env_repl, counter = counter, taken = taken), f, off1, off2),
    ECall(callee, args, off, callee_resolution) => ECall(edp_ar_expr(expr = callee, seed = seed, env_names = env_names, env_repl = env_repl, counter = counter, taken = taken), edp_ar_exprs(es = args, seed = seed, env_names = env_names, env_repl = env_repl, counter = counter, taken = taken), off, callee_resolution),
    EBinOp(op, l, r, boff) => EBinOp(op, edp_ar_expr(expr = l, seed = seed, env_names = env_names, env_repl = env_repl, counter = counter, taken = taken), edp_ar_expr(expr = r, seed = seed, env_names = env_names, env_repl = env_repl, counter = counter, taken = taken), boff),
    EUnaryOp(op, e2) => EUnaryOp(op, edp_ar_expr(expr = e2, seed = seed, env_names = env_names, env_repl = env_repl, counter = counter, taken = taken)),
    ELabeledArg(l, n, v) => ELabeledArg(l, n, edp_ar_expr(expr = v, seed = seed, env_names = env_names, env_repl = env_repl, counter = counter, taken = taken)),
    EBreak(opt) => EBreak(match opt {
      Some(e2) => Some(edp_ar_expr(expr = e2, seed = seed, env_names = env_names, env_repl = env_repl, counter = counter, taken = taken)),
      None => None
    }),
    EContinue(args) => EContinue(edp_ar_exprs(es = args, seed = seed, env_names = env_names, env_repl = env_repl, counter = counter, taken = taken)),
    ETuple(elems) => ETuple(edp_ar_exprs(es = elems, seed = seed, env_names = env_names, env_repl = env_repl, counter = counter, taken = taken)),
    EArray(elems) => EArray(edp_ar_exprs(es = elems, seed = seed, env_names = env_names, env_repl = env_repl, counter = counter, taken = taken)),
    ERecord(rn, fields, targs) => ERecord(rn, for f in fields {
      let (fn2, v) = f
      (fn2, edp_ar_expr(expr = v, seed = seed, env_names = env_names, env_repl = env_repl, counter = counter, taken = taken))
    }, targs),
    EMap(fields) => EMap(for f in fields {
      let (fn2, v) = f
      (fn2, edp_ar_expr(expr = v, seed = seed, env_names = env_names, env_repl = env_repl, counter = counter, taken = taken))
    }),
    ESpread(e2) => ESpread(edp_ar_expr(expr = e2, seed = seed, env_names = env_names, env_repl = env_repl, counter = counter, taken = taken)),
    _ => expr
  }
}

/// --- effectset-aware row resolution.
///
/// A needing function's row string (EFn's own `eff` slot, taken verbatim by
/// edp_collect_fn_defs) can be spelled with an `effectset` alias --
/// `with AskAll` where `effectset AskAll = { Ask }` -- instead of the
/// bare effect name. checker_stmt.vibe's own effectset-expansion
/// (es_expand_stmts_effect_rows) deliberately runs on a NON-mutating COPY of
/// `stmts` used only for type-checking (see check_program's comment: "codegen
/// never reads the row's text content") -- the EFn node codegen actually
/// receives keeps the alias UNEXPANDED. That comment's premise no longer
/// holds now that evidence_dict_pass reads row text directly: without this,
/// `AskAll`-declared functions were silently excluded from migration even in
/// the simplest case (an effectset that's just a whole-effect alias),
/// invisibly falling back to the pre-existing replay codegen -- found by
/// writing a small effectset fixture and confirming, via a temporary
/// migration-plan probe, that no plan was produced for it at all, THEN
/// tracing why (edp_needing_names' string match against the still-literal
/// "AskAll" label never matches a bare "Ask" query) rather than assuming.
///
/// Fixed the same way wit_gen.vibe/contract.vibe/checker_stmt.vibe each
/// already fix the identical problem for their own consumers: a small LOCAL
/// copy of the ES-table/cycle-safe-expansion shape (no new cross-file
/// reference -- see docs/internal/design/effectset.md's bootstrap gotcha), re-run here on
/// `stmts` as evidence_dict_pass actually receives them. Resolving down to
/// EFFECT-name granularity (not operation-level) is enough for this pass's
/// purposes even for an operation-level effectset (`effectset Env::Read = {
/// Env::get, ...}`): the dict struct this pass builds always has one field
/// per operation the EFFECT declares (edp_make_dict_struct_stmt, from
/// effect_defs) and a handle site's arms already provide real closures for
/// every operation regardless of which subset a caller's row happened to
/// mention, so "does this row require effect X at all" is exactly the
/// question edp_needing_names needs answered, whether the original
/// declaration enumerated operations, named an effectset, or wrote the bare
/// effect name.
export fn edp_es_collect_into(stmts: Array[Stmt], es_names: Array[String], es_members_list: Array[Array[String]]) -> Unit {
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, at = i) {
      SEffectSet(_, esname, esmembers) => {
        Array::push(es_names, value = esname)
        Array::push(es_members_list, value = esmembers)
      },
      _ => ()
    }
    i = i + 1
  }
}

// --- collection.

/// ADR-0076 追記34 V2: dedup by NAME. The merge lane can pull the same
/// effect-declaring file in twice under two import spellings (lib/@vibe/fs's
/// fs_effect.vibe reaches index_import_test both through the package index
/// and through a direct `./fs_effect.vibe` import), leaving two identical
/// `SEffectDef`s in the merged program. Planning the same label twice made
/// edp_apply_migration run twice, double-prepending the dict parameter on
/// every needing definition while handle-site calls (consumed by the first
/// application) carried it once -- an arity-broken invalid module ("not
/// enough arguments on the stack", found live on index_import_test the
/// moment test-block handles joined migration). Harmless pre-V2 only
/// because zero collected handle sites meant the duplicated label never
/// got a plan at all.
export fn edp_collect_effect_defs(_ stmts: Array[Stmt]) -> Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])] {
  let out = array_empty()
  let seen = empty_str_array()
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, at = i) {
      SEffectDef(_, name, _, ops) => if edp_str_array_contains(arr = seen, v = name) {
        ()
      } else {
        Array::push(seen, value = name)
        Array::push(out, value = (name, ops))
      },
      _ => ()
    }
    i = i + 1
  }
  out
}

/// (stmt index, exported, is_rec, name, top-level type annotation, declared
/// effect row string ("" for none) -- taken directly from the EFn's own
/// `eff` slot, the same field #942/the checker already validate).
export fn edp_collect_fn_defs(_ stmts: Array[Stmt]) -> Array[(Int, Bool, Bool, String, Option[TypeExpr], String)] {
  let out = array_empty()
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, at = i) {
      SLet(exported, is_rec, name, ty, expr) => match expr {
        EFn(_, _, _, _, eff, _) => {
          let row = match eff {
            Some(s) => s,
            None => ""
          }
          Array::push(out, value = (i, exported, is_rec, name, ty, row))
        },
        _ => ()
      },
      _ => ()
    }
    i = i + 1
  }
  out
}

export fn edp_needing_names(fn_defs: Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], ename: String, es_names: Array[String], es_members_list: Array[Array[String]]) -> Array[String] {
  let out = array_empty()
  let mut i = 0
  while i < Array::length(fn_defs) {
    let (_, _, _, name, _, row) = Array::get(fn_defs, at = i)
    if edp_row_is_exactly(row = row, ename = ename, es_names = es_names, es_members_list = es_members_list) {
      Array::push(out, value = name)
    } else {
      ()
    }
    i = i + 1
  }
  out
}

/// #1875 R2: one row string parsed into its resolved effect label set --
/// the split/trim/effectset-resolve edp_row_is_exactly performs, done once.
/// A bare effect name resolves to itself (pass-through), so a label-set
/// containment check answers exactly edp_row_is_exactly's question
/// (including its `row == ename` fast path: the parsed set of "Ask" is
/// ["Ask"]).
fn edp_parse_row_labels(row: String, es_names: Array[String], es_members_list: Array[Array[String]]) -> Array[String] {
  let out = array_empty()
  if row == "" {
    out
  } else {
    let parts = String::split(row, sep = ",")
    let mut i = 0
    while i < Array::length(parts) {
      edp_resolve_effect_names_into(label = String::trim(Array::get(parts, at = i)), es_names = es_names, es_members_list = es_members_list, out = out)
      i = i + 1
    }
    out
  }
}

/// #1875 R2: per-fn resolved row label sets, with the row STRINGS interned
/// -- a program has thousands of fn rows but only dozens of distinct row
/// spellings ("", "Exception", "Exception, Fs", ...), so each spelling is
/// parsed once and every fn sharing it references the same label array.
/// Before this table, edp_needing_names re-split and re-resolved every
/// fn's row string PER DECLARED EFFECT (via alpha-rename and the migration
/// planner), which measured ~9.5MB of allocation per effect declaration on
/// the selfcompile closure.
export fn edp_fn_row_label_table(fn_defs: Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], es_names: Array[String], es_members_list: Array[Array[String]]) -> Array[Array[String]] {
  let seen_rows = empty_str_array()
  let seen_labels = array_empty()
  let table = array_empty()
  let mut i = 0
  while i < Array::length(fn_defs) {
    let (_, _, _, _, _, row) = Array::get(fn_defs, at = i)
    let mut hit = 0 - 1
    let mut si = 0
    while si < Array::length(seen_rows) {
      if Array::get(seen_rows, at = si) == row {
        hit = si
      } else {
        ()
      }
      si = si + 1
    }
    if hit >= 0 {
      Array::push(table, value = Array::get(seen_labels, at = hit))
    } else {
      let labels = edp_parse_row_labels(row = row, es_names = es_names, es_members_list = es_members_list)
      Array::push(seen_rows, value = row)
      Array::push(seen_labels, value = labels)
      Array::push(table, value = labels)
    }
    i = i + 1
  }
  table
}

/// edp_needing_names over the pre-parsed label table: same answer, no
/// re-parsing. `row_labels` must be parallel to `fn_defs`
/// (edp_fn_row_label_table over the same array).
export fn edp_needing_names_tab(fn_defs: Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], row_labels: Array[Array[String]], ename: String) -> Array[String] {
  let out = array_empty()
  let mut i = 0
  while i < Array::length(fn_defs) {
    let (_, _, _, name, _, _) = Array::get(fn_defs, at = i)
    if edp_str_array_contains(arr = Array::get(row_labels, at = i), v = ename) {
      Array::push(out, value = name)
    } else {
      ()
    }
    i = i + 1
  }
  out
}

/// #2386: the membership side of a name array, for a query that asks per
/// call node rather than per name.
export fn edp_name_set(_ names: Array[String]) -> MutSet[String] {
  // Sized for the map's LOAD FACTOR, not for the entry count. `MutMap::set`
  // rehashes to 2x when `(size + tombs + 1) * 10 > cap * 7`, so a capacity of
  // exactly `n` still rebuilds the table at insertion `0.7n` and lands at
  // `2n` slots -- which is why passing `n` measured the same as letting it
  // grow from 16 (42 KB apart on `selfcompile_kpi`: 2700 + 5400 slots against
  // 16 + 32 + ... + 4096). `ceil(10n/7)` is the smallest capacity at which the
  // last insertion does not trip that test (Codex review on #2644).
  let s: MutSet[String] = MutSet::with_capacity(hash_fn = hash_string, eq_fn = eq_string, capacity = Array::length(names) * 10 / 7 + 1)
  let mut i = 0
  while i < Array::length(names) {
    MutSet::add(s, x = Array::get(names, at = i))
    i = i + 1
  }
  s
}

// --- naming.

export fn edp_dict_struct_name(_ ename: String) -> String {
  String::concat("__EvDict_", ename)
}

export fn edp_dict_param_name(_ ename: String) -> String {
  String::concat("__ev_", ename)
}

export fn edp_strip_effect_prefix(qname: String, ename: String) -> String {
  let prefix = String::concat(ename, "::")
  let plen = String::length(prefix)
  if String::length(qname) > plen && String::substring(qname, start = 0, end = plen) == prefix {
    String::substring(qname, start = plen, end = String::length(qname))
  } else {
    qname
  }
}

export fn edp_struct_decl_exists(stmts: Array[Stmt], sname: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(stmts) {
    match Array::get(stmts, at = i) {
      SStruct(_, n, _, _, _, _) => if n == sname {
        found = true
      } else {
        ()
      },
      _ => ()
    }
    i = i + 1
  }
  found
}

export fn edp_make_dict_struct_stmt(ename: String, ops: Array[(String, Array[TypeExpr], TypeExpr)]) -> Stmt {
  let fields = array_empty()
  let mut i = 0
  while i < Array::length(ops) {
    let (opname, params, ret) = Array::get(ops, at = i)
    Array::push(fields, value = (opname, TyFn(params, ret, None)))
    i = i + 1
  }
  SStruct(false, edp_dict_struct_name(ename), fields, empty_str_array(), empty_str_array(), empty_str_array())
}

export fn empty_str_array() -> Array[String] {
  array_empty()
}

/// #2373: the two consumers of the pure-builtin allowlist must not become two
/// spellings of it again. `idp_is_pure_builtin_call` gates suspend-class
/// lowering (`scps_named_call_ok`, which has no fallback: a name it does not
/// recognize REFUSES the program naming the call) and `edp_is_pure_builtin_
/// call` gates the evidence pass's safety scans (which do have fallbacks, so a
/// name missing there only sinks eligibility silently). The failure directions
/// are opposite, so neither list is the safe one to forget -- which is exactly
/// how the second copy sat three names behind the first without anything
/// failing. Both predicates now read one table; this asserts they answer
/// alike, including the negative control that makes the assertion mean
/// something (a predicate that returned `true` for everything would satisfy
/// the positive half alone). Same shape as `is_borrow_ret_builtin`'s
/// agreement test (#1979). Called from tests/pure_builtin_name_agreement_
/// test.vibe.
export fn verify_pure_builtin_name_agreement() -> Unit with Exception {
  // The question is about the table, not about a program: forget whatever
  // program was lowered last (#3176, `idp_note_program_decls`).
  let no_program: Array[Stmt] = []
  idp_note_program_decls(no_program)
  let names = idp_pure_builtin_names()
  if Array::length(names) == 0 {
    throw("pure-builtin allowlist is empty: idp_pure_builtin_names() has no entries, so every agreement check below is vacuous")
  } else {
    ()
  }
  let mut i = 0
  while i < Array::length(names) {
    let nm = Array::get(names, at = i)
    if !idp_is_pure_builtin_call(nm) {
      throw("pure-builtin allowlist drift: '\{nm}' is in idp_pure_builtin_names but idp_is_pure_builtin_call rejects it. The direct-perform pass and scps_named_call_ok read this predicate; a listed name it rejects refuses a program naming the call.")
    } else {
      ()
    }
    if !edp_is_pure_builtin_call(nm) {
      throw("pure-builtin allowlist drift: '\{nm}' is in idp_pure_builtin_names but edp_is_pure_builtin_call rejects it. The evidence pass reads the SAME audited set -- if a second copy of the list was reintroduced, delete it and point edp_is_pure_builtin_call back at idp_pure_builtin_names().")
    } else {
      ()
    }
    i = i + 1
  }
  // Negative control: `Array::push` mutates and `println` writes, so neither
  // is on the audited set. Without this, both loops above would pass for a
  // predicate that answered `true` unconditionally.
  if idp_is_pure_builtin_call("Array::push") || edp_is_pure_builtin_call("Array::push") {
    throw("pure-builtin allowlist drift: 'Array::push' is not on the audited set but a predicate accepts it")
  } else {
    ()
  }
  if idp_is_pure_builtin_call("println") || edp_is_pure_builtin_call("println") {
    throw("pure-builtin allowlist drift: 'println' is not on the audited set but a predicate accepts it")
  } else {
    ()
  }
}

/// Every top-level function name whose declared effect row is
/// checker-verified empty (`""`, meaning no `with` clause at all -- #942's
/// same guarantee edp_collect_fn_defs's own doc comment cites). See
/// edp_has_unsafe_construct's doc comment for why a call to one of these is
/// always safe to treat as inert.
export fn edp_pure_fn_names(_ fn_defs: Array[(Int, Bool, Bool, String, Option[TypeExpr], String)]) -> Array[String] {
  let out = array_empty()
  let mut i = 0
  while i < Array::length(fn_defs) {
    let (_, _, _, name, _, row) = Array::get(fn_defs, at = i)
    if row == "" {
      Array::push(out, value = name)
    } else {
      ()
    }
    i = i + 1
  }
  out
}

/// #2109: a top-level fn whose declared row does not mention `ename` cannot
/// PERFORM it, so a call to it hides nothing from a `handle .. with ename`.
///
/// The row is complete by construction: the checker requires every effect a
/// body can require -- directly, transitively, or through a parameter's own
/// row (#626, #885) -- to appear in the declaring signature, and this pass
/// runs after it. A callee declaring `with Console` therefore cannot reach a
/// `perform Ask::Get`, and treating the call as opaque only made ordinary code
/// uncompilable: `handle { println("x") f() } with { Ask::Get(..) => .. }` and every
/// `assert_eq` inside a handled body were rejected with a diagnostic that
/// enumerates three legal forms the program already satisfies.
///
/// Row VARIABLES are excluded, and that exclusion is the reason this is sound
/// rather than merely plausible: a polymorphic row can be instantiated with
/// the handled effect at the call site, and the perform then happens inside
/// the callee where the handler cannot see it. Effect names are CamelCase
/// (#1458), so a lowercase-initial label is taken to be a variable -- the
/// conservative direction.
fn edp_label_is_row_var(_ label: String) -> Bool {
  String::length(label) > 0 && String::char_code_at(label, at = 0) >= 97 && String::char_code_at(label, at = 0) <= 122
}

export fn edp_row_labels_have_var(_ labels: Array[String]) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(labels) {
    if edp_label_is_row_var(Array::get(labels, at = i)) {
      found = true
    } else {
      ()
    }
    i = i + 1
  }
  found
}

fn edp_collect_handle_sites_exprs(es: Array[Expr], ename: String, out: Array[(Expr, Array[(Pat, Expr)])]) -> Unit {
  let mut i = 0
  while i < Array::length(es) {
    edp_collect_handle_sites_expr(expr = Array::get(es, at = i), ename = ename, out = out)
    i = i + 1
  }
}

fn edp_collect_handle_sites_pairs(pairs: Array[(String, Expr)], ename: String, out: Array[(Expr, Array[(Pat, Expr)])]) -> Unit {
  let mut i = 0
  while i < Array::length(pairs) {
    let (_, v) = Array::get(pairs, at = i)
    edp_collect_handle_sites_expr(expr = v, ename = ename, out = out)
    i = i + 1
  }
}

export fn edp_collect_handle_sites_expr(expr: Expr, ename: String, out: Array[(Expr, Array[(Pat, Expr)])]) -> Unit {
  match expr {
    EHandle(body, arms) => {
      if edp_handle_matches_effect(arms = arms, ename = ename) {
        Array::push(out, value = (body, arms))
      } else {
        edp_collect_handle_sites_expr(expr = body, ename = ename, out = out)
      }
      // Every arm is outside this handler and can own independent sites.
      let mut ai = 0
      while ai < Array::length(arms) {
        edp_collect_handle_sites_expr(expr = Array::get(arms, at = ai).1, ename = ename, out = out)
        ai = ai + 1
      }
    },
    EFn(_, _, _, _, _, b) => edp_collect_handle_sites_expr(expr = b, ename = ename, out = out),
    ELet(_, v, b, _) => {
      edp_collect_handle_sites_expr(expr = v, ename = ename, out = out)
      edp_collect_handle_sites_expr(expr = b, ename = ename, out = out)
    },
    ELetMut(_, v, b, _) => {
      edp_collect_handle_sites_expr(expr = v, ename = ename, out = out)
      edp_collect_handle_sites_expr(expr = b, ename = ename, out = out)
    },
    ELetRec(_, v, b) => {
      edp_collect_handle_sites_expr(expr = v, ename = ename, out = out)
      edp_collect_handle_sites_expr(expr = b, ename = ename, out = out)
    },
    ESeq(a, b) => {
      edp_collect_handle_sites_expr(expr = a, ename = ename, out = out)
      edp_collect_handle_sites_expr(expr = b, ename = ename, out = out)
    },
    EIf(c, t, e) => {
      edp_collect_handle_sites_expr(expr = c, ename = ename, out = out)
      edp_collect_handle_sites_expr(expr = t, ename = ename, out = out)
      edp_collect_handle_sites_expr(expr = e, ename = ename, out = out)
    },
    EMatch(s, arms) => {
      edp_collect_handle_sites_expr(expr = s, ename = ename, out = out)
      // #1875 R4: while-index instead of `for` in this walk (and below) --
      // a statement-position `for` collects a discarded result array per
      // execution, which a whole-program per-effect walk pays per node.
      let mut mi = 0
      while mi < Array::length(arms) {
        let (_, ex) = Array::get(arms, at = mi)
        edp_collect_handle_sites_expr(expr = ex, ename = ename, out = out)
        mi = mi + 1
      }
    },
    EWhile(c, b) => {
      edp_collect_handle_sites_expr(expr = c, ename = ename, out = out)
      edp_collect_handle_sites_expr(expr = b, ename = ename, out = out)
    },
    EForIn(_, _, it, b) => {
      edp_collect_handle_sites_expr(expr = it, ename = ename, out = out)
      edp_collect_handle_sites_expr(expr = b, ename = ename, out = out)
    },
    ECall(callee, args, _, _) => {
      edp_collect_handle_sites_expr(expr = callee, ename = ename, out = out)
      let mut ai = 0
      while ai < Array::length(args) {
        edp_collect_handle_sites_expr(expr = Array::get(args, at = ai), ename = ename, out = out)
        ai = ai + 1
      }
    },
    EBinOp(_, l, r, _) => {
      edp_collect_handle_sites_expr(expr = l, ename = ename, out = out)
      edp_collect_handle_sites_expr(expr = r, ename = ename, out = out)
    },
    EUnaryOp(_, e2) => edp_collect_handle_sites_expr(expr = e2, ename = ename, out = out),
    EAssign(_, v, c, _) => {
      edp_collect_handle_sites_expr(expr = v, ename = ename, out = out)
      edp_collect_handle_sites_expr(expr = c, ename = ename, out = out)
    },
    EAssignOp(_, _, v, c, _) => {
      edp_collect_handle_sites_expr(expr = v, ename = ename, out = out)
      edp_collect_handle_sites_expr(expr = c, ename = ename, out = out)
    },
    EDot(o, _, _, _) => edp_collect_handle_sites_expr(expr = o, ename = ename, out = out),
    ELabeledArg(_, _, v) => edp_collect_handle_sites_expr(expr = v, ename = ename, out = out),
    EReturn(e2) => edp_collect_handle_sites_expr(expr = e2, ename = ename, out = out),
    EBreak(opt) => match opt {
      Some(e2) => edp_collect_handle_sites_expr(expr = e2, ename = ename, out = out),
      None => ()
    },
    EContinue(args) => edp_collect_handle_sites_exprs(es = args, ename = ename, out = out),
    ETuple(elems) => edp_collect_handle_sites_exprs(es = elems, ename = ename, out = out),
    EArray(elems) => edp_collect_handle_sites_exprs(es = elems, ename = ename, out = out),
    ERecord(_, fields, _) => edp_collect_handle_sites_pairs(pairs = fields, ename = ename, out = out),
    EMap(fields) => edp_collect_handle_sites_pairs(pairs = fields, ename = ename, out = out),
    ESpread(e2) => edp_collect_handle_sites_expr(expr = e2, ename = ename, out = out),
    ELoop(pairs, b) => {
      edp_collect_handle_sites_pairs(pairs = pairs, ename = ename, out = out)
      edp_collect_handle_sites_expr(expr = b, ename = ename, out = out)
    },
    _ => ()
  }
}

export fn edp_find_fn_body(stmts: Array[Stmt], fn_defs: Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], name: String) -> Option[Expr] {
  let mut i = 0
  let mut result = None
  while i < Array::length(fn_defs) {
    let (idx, _, _, nm, _, _) = Array::get(fn_defs, at = i)
    if nm == name {
      match Array::get(stmts, at = idx) {
        SLet(_, _, _, _, EFn(_, _, _, _, _, body)) => {
          result = Some(body)
        },
        _ => ()
      }
    } else {
      ()
    }
    i = i + 1
  }
  result
}

// --- #1070 (general case): a needing function calling an opaque
// closure-typed PARAMETER of its own (`f()` where `f: () -> R with
// {ename}`), instead of another named needing function. Static (AST-only)
// analysis can never fully prove what closure VALUE flows into an
// arbitrary parameter, so this is scoped deliberately narrowly and
// conservatively: a parameter position is only ever treated as safe to
// forward the dict through if EVERY call site of the owning function in
// the whole program can be proven, by itself, to pass a migratable
// closure LITERAL at that exact position (edp_closure_param_universally_
// safe) -- any call passing something else (a non-identifier expression,
// a missing argument, or an identifier that isn't a provably single-use,
// row-matching, safe-bodied `let`-bound closure literal) makes the WHOLE
// position ineligible, and the owning function falls back to its
// pre-existing (unsafe -> replay) treatment exactly as before this
// change. This two-sided requirement is essential, not a nicety: if only
// the call site were rewritten (forwarding a dict argument) without the
// actual closure VALUE also being recompiled to accept it, the extra
// argument would land on a closure whose compiled arity doesn't expect
// it -- silently wrong at best, a wrong-arity crash at worst. Provably
// requiring BOTH sides before touching either is what keeps this sound.

/// A parameter's declared type denotes a function whose row is EXACTLY
/// `ename` (same effectset-aware matching edp_needing_names uses for
/// top-level functions, reused here for a parameter's own type instead of
/// a function's declared row).
export fn edp_type_is_fn_row_exactly(pty: Option[TypeExpr], ename: String, es_names: Array[String], es_members_list: Array[Array[String]]) -> Bool {
  match pty {
    Some(t) => match t {
      TyFn(_, _, roweff) => match roweff {
        Some(row) => edp_row_is_exactly(row = row, ename = ename, es_names = es_names, es_members_list = es_members_list),
        None => false
      },
      _ => false
    },
    None => false
  }
}

/// Like edp_find_fn_body but also returns the function's own params (needed
/// to inspect a parameter's declared type, which edp_collect_fn_defs never
/// captures).
export fn edp_find_fn_params_and_body(stmts: Array[Stmt], fn_defs: Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], name: String) -> Option[(Array[(String, Option[TypeExpr])], Expr)] {
  let mut i = 0
  let mut result = None
  while i < Array::length(fn_defs) {
    let (idx, _, _, nm, _, _) = Array::get(fn_defs, at = i)
    if nm == name {
      match Array::get(stmts, at = idx) {
        SLet(_, _, _, _, EFn(_, _, params, _, _, body)) => {
          result = Some((params, body))
        },
        _ => ()
      }
    } else {
      ()
    }
    i = i + 1
  }
  result
}

// Is `expr` an EFn literal whose OWN declared row is exactly `ename` and
// whose body contains nothing edp_has_unsafe_construct rejects? This is
// the exact eligibility bar a top-level needing function must also clear
// -- reused here for a LOCAL closure literal considered for the same
// dict-parameter treatment.
// --- ADR-0076 追記34 V1: type-directed closure evidence.
//
// closure-value mode for effect E: the program contains a VALUE of a
// function type whose row carries E — an annotated closure literal
// (`() -> T with E { .. }`) or a fn-typed parameter annotation. In
// this mode migration is TYPE-directed and TOTAL: every row-E literal
// gets the `__ev_E` leading param, every call through a row-E-typed name
// forwards evidence, and a named needing fn used as a value already has
// the same arity after its own rewrite. The same row type always means
// the same arity program-wide, so the #1070-family call-site proofs
// (single-use / universal-call-site / no-value-reference /
// handle-confinement) are unnecessary here — they remain only for
// programs with NO row-E values (mode off), where behavior is unchanged.
// Ineligibility in this mode is a HARD error surfaced through
// evidence_dict_pass's returned error list (never a silent replay
// fallback) — the frontier-deletion prerequisite.

/// #1116 Codex review (P1): the idempotency check must be EFFECT-SPECIFIC.
/// A `with A + B` literal gets `__ev_A` from A's sweep; a blanket
/// `starts_with(p0, "__ev_")` would then make B's sweep skip it, so B's
/// perform escapes after B's handler is removed. Check for THIS effect's
/// dict param by exact name, scanning ALL params (a prior effect's param
/// is prepended AHEAD of this one, so it is not necessarily param 0).
export fn edp_params_have_dict(params: Array[(String, Option[TypeExpr])], dict_pname: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(params) {
    let (pn, _) = Array::get(params, at = i)
    if pn == dict_pname {
      found = true
    } else {
      ()
    }
    i = i + 1
  }
  found
}

export fn edp_efn_row_carries(expr: Expr, ename: String, es_names: Array[String], es_members_list: Array[Array[String]]) -> Bool {
  match expr {
    EFn(_, _, params, _, eff, _) => match eff {
      Some(row) => {
        let already = edp_params_have_dict(params = params, dict_pname = edp_dict_param_name(ename))
        !already && edp_row_is_exactly(row = row, ename = ename, es_names = es_names, es_members_list = es_members_list)
      },
      None => false
    },
    _ => false
  }
}

export fn edp_row_typed_param_names(params: Array[(String, Option[TypeExpr])], ename: String, es_names: Array[String], es_members_list: Array[Array[String]]) -> Array[String] {
  let out = empty_str_array()
  let mut i = 0
  while i < Array::length(params) {
    let (pn, pty) = Array::get(params, at = i)
    if edp_type_is_fn_row_exactly(pty = pty, ename = ename, es_names = es_names, es_members_list = es_members_list) {
      Array::push(out, value = edp_strip_tilde(pn))
    } else {
      ()
    }
    i = i + 1
  }
  out
}

/// Scan (read-only) for row-E closure literals: `binds` collects names
/// DIRECTLY let/letrec-bound to one (call sites through those names get
/// evidence prepended), `lits` collects every row-E literal expression
/// (each body must pass the safety check; the sweep migrates them all).
/// Top-level `SLet name = <row-E EFn>` is deliberately NOT a bind — that
/// is a needing fn (row containment on its own eff slot) and the needing
/// rewrite owns it.
export fn edp_row_lit_scan(stmts: Array[Stmt], ename: String, needing: Array[String], es_names: Array[String], es_members_list: Array[Array[String]], binds: Array[String], lits: Array[Expr]) -> Unit {
  let mut i = 0
  while i < Array::length(stmts) {
    edp_row_lit_scan_stmt(stmt = Array::get(stmts, at = i), ename = ename, needing = needing, es_names = es_names, es_members_list = es_members_list, binds = binds, lits = lits)
    i = i + 1
  }
}

/// edp_row_lit_scan over only the statements `indices` names, ascending.
/// Equal to the whole scan when every statement left out holds nothing it
/// would collect (see edp_mf_row_lit_scan).
export fn edp_row_lit_scan_in(stmts: Array[Stmt], indices: Array[Int], ename: String, needing: Array[String], es_names: Array[String], es_members_list: Array[Array[String]], binds: Array[String], lits: Array[Expr]) -> Unit {
  for i in indices {
    edp_row_lit_scan_stmt(stmt = Array::get(stmts, at = i), ename = ename, needing = needing, es_names = es_names, es_members_list = es_members_list, binds = binds, lits = lits)
  }
  ()
}

/// The region of a statement edp_row_lit_scan reads: a top-level `fn`'s body
/// (the function value itself is the needing rewrite's), or the whole
/// expression of the other forms it reads.
export fn edp_row_lit_region(_ stmt: Stmt) -> Option[Expr] {
  match stmt {
    SLet(_, _, _, _, expr) => match expr {
      EFn(_, _, _, _, _, fb) => Some(fb),
      _ => Some(expr)
    },
    SLetMut(_, _, expr) => Some(expr),
    SExpr(expr) => Some(expr),
    STest(_, expr) => Some(expr),
    SBench(_, expr) => Some(expr),
    _ => None
  }
}

fn edp_row_lit_scan_stmt(stmt: Stmt, ename: String, needing: Array[String], es_names: Array[String], es_members_list: Array[Array[String]], binds: Array[String], lits: Array[Expr]) -> Unit {
  match edp_row_lit_region(stmt) {
    Some(expr) => edp_row_lit_scan_expr(e = expr, ename = ename, needing = needing, es_names = es_names, es_members_list = es_members_list, binds = binds, lits = lits),
    None => ()
  }
}

/// #1116 Codex review (P1): `binds` is a program-wide flat name list, so a
/// name bound to a row-E literal in one scope would widen EVERY same-named
/// call — including an unrelated pure `f` bound in another scope, which
/// would be miscompiled to `f(__ev_E)`. Collect POISONED names: any name
/// bound (anywhere, any binder form) to something that is NOT an
/// evidence-taking value for this effect. A name that is both a row-E bind
/// somewhere and poisoned elsewhere is dropped from the widening set —
/// call sites through it then fail eligibility (a hard error, loud) rather
/// than silently mismatching arity. Names bound uniquely to a row-E value
/// (the common shape: `let inner = () -> _ with E {..}`) are never
/// poisoned and stay widened.
export fn edp_filter_unpoisoned(binds: Array[String], poison: Array[String]) -> Array[String] {
  let out = empty_str_array()
  let mut i = 0
  while i < Array::length(binds) {
    let nm = Array::get(binds, at = i)
    if edp_str_array_contains(arr = poison, v = nm) || edp_str_array_contains(arr = out, v = nm) {
      ()
    } else {
      Array::push(out, value = nm)
    }
    i = i + 1
  }
  out
}

export fn edp_collect_poison_stmts(stmts: Array[Stmt], ename: String, needing: Array[String], es_names: Array[String], es_members_list: Array[Array[String]], poison: Array[String]) -> Unit {
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, at = i) {
      // #1117 Codex P1: the top-level binder NAME must be poisoned too when
      // its value is not evidence-taking. A top-level `let f = <pure>`
      // sharing a name with a nested row-E closure `f` would otherwise keep
      // `f` widened and rewrite the top-level call with an extra evidence
      // arg. A row-E EFn / needing-ref top-level binding stays un-poisoned
      // (it is itself widened via the needing rewrite).
      SLet(_, _, snm, _, expr) => match expr {
        EFn(_, _, params, _, _, fb) => {
          if edp_row_lit_bindable(v = expr, ename = ename, needing = needing, es_names = es_names, es_members_list = es_members_list) {
            ()
          } else {
            edp_poison_add(nm = snm, poison = poison)
          }
          edp_poison_params(params = params, ename = ename, es_names = es_names, es_members_list = es_members_list, poison = poison)
          edp_collect_poison_expr(e = fb, ename = ename, needing = needing, es_names = es_names, es_members_list = es_members_list, poison = poison)
        },
        _ => {
          if edp_row_lit_bindable(v = expr, ename = ename, needing = needing, es_names = es_names, es_members_list = es_members_list) {
            ()
          } else {
            edp_poison_add(nm = snm, poison = poison)
          }
          edp_collect_poison_expr(e = expr, ename = ename, needing = needing, es_names = es_names, es_members_list = es_members_list, poison = poison)
        }
      },
      SLetMut(snm, _, expr) => {
        edp_poison_add(nm = snm, poison = poison)
        edp_collect_poison_expr(e = expr, ename = ename, needing = needing, es_names = es_names, es_members_list = es_members_list, poison = poison)
      },
      SExpr(expr) => edp_collect_poison_expr(e = expr, ename = ename, needing = needing, es_names = es_names, es_members_list = es_members_list, poison = poison),
      STest(_, expr) => edp_collect_poison_expr(e = expr, ename = ename, needing = needing, es_names = es_names, es_members_list = es_members_list, poison = poison),
      SBench(_, expr) => edp_collect_poison_expr(e = expr, ename = ename, needing = needing, es_names = es_names, es_members_list = es_members_list, poison = poison),
      _ => ()
    }
    i = i + 1
  }
}

/// #1117 Codex P2: a parameter whose type is a row-E function is ITSELF
/// evidence-taking (widened by edp_row_typed_param_names), so poisoning it
/// would wrongly drop a legitimately-widened name and hard-error a valid
/// program. Poison only params that will NOT receive this effect's
/// evidence.
fn edp_poison_params(params: Array[(String, Option[TypeExpr])], ename: String, es_names: Array[String], es_members_list: Array[Array[String]], poison: Array[String]) -> Unit {
  let mut i = 0
  while i < Array::length(params) {
    let (pn, pty) = Array::get(params, at = i)
    if edp_type_is_fn_row_exactly(pty = pty, ename = ename, es_names = es_names, es_members_list = es_members_list) {
      ()
    } else {
      let nm = edp_strip_tilde(pn)
      if edp_str_array_contains(arr = poison, v = nm) {
        ()
      } else {
        Array::push(poison, value = nm)
      }
    }
    i = i + 1
  }
}

fn edp_poison_add(nm: String, poison: Array[String]) -> Unit {
  if edp_str_array_contains(arr = poison, v = nm) {
    ()
  } else {
    Array::push(poison, value = nm)
  }
}

fn edp_collect_poison_expr(e: Expr, ename: String, needing: Array[String], es_names: Array[String], es_members_list: Array[Array[String]], poison: Array[String]) -> Unit {
  match e {
    ELet(n, v, b, _) => {
      if !edp_row_lit_bindable(v = v, ename = ename, needing = needing, es_names = es_names, es_members_list = es_members_list) {
        edp_poison_add(nm = n, poison = poison)
      } else {
        ()
      }
      edp_collect_poison_expr(e = v, ename = ename, needing = needing, es_names = es_names, es_members_list = es_members_list, poison = poison)
      edp_collect_poison_expr(e = b, ename = ename, needing = needing, es_names = es_names, es_members_list = es_members_list, poison = poison)
    },
    ELetRec(n, v, b) => {
      if !edp_row_lit_bindable(v = v, ename = ename, needing = needing, es_names = es_names, es_members_list = es_members_list) {
        edp_poison_add(nm = n, poison = poison)
      } else {
        ()
      }
      edp_collect_poison_expr(e = v, ename = ename, needing = needing, es_names = es_names, es_members_list = es_members_list, poison = poison)
      edp_collect_poison_expr(e = b, ename = ename, needing = needing, es_names = es_names, es_members_list = es_members_list, poison = poison)
    },
    ELetMut(n, v, b, _) => {
      edp_poison_add(nm = n, poison = poison)
      edp_collect_poison_expr(e = v, ename = ename, needing = needing, es_names = es_names, es_members_list = es_members_list, poison = poison)
      edp_collect_poison_expr(e = b, ename = ename, needing = needing, es_names = es_names, es_members_list = es_members_list, poison = poison)
    },
    EFn(_, _, params, _, _, fb) => {
      edp_poison_params(params = params, ename = ename, es_names = es_names, es_members_list = es_members_list, poison = poison)
      edp_collect_poison_expr(e = fb, ename = ename, needing = needing, es_names = es_names, es_members_list = es_members_list, poison = poison)
    },
    ESeq(a, b) => {
      edp_collect_poison_expr(e = a, ename = ename, needing = needing, es_names = es_names, es_members_list = es_members_list, poison = poison)
      edp_collect_poison_expr(e = b, ename = ename, needing = needing, es_names = es_names, es_members_list = es_members_list, poison = poison)
    },
    EIf(c, t, el) => {
      edp_collect_poison_expr(e = c, ename = ename, needing = needing, es_names = es_names, es_members_list = es_members_list, poison = poison)
      edp_collect_poison_expr(e = t, ename = ename, needing = needing, es_names = es_names, es_members_list = es_members_list, poison = poison)
      edp_collect_poison_expr(e = el, ename = ename, needing = needing, es_names = es_names, es_members_list = es_members_list, poison = poison)
    },
    EMatch(sc, arms) => {
      edp_collect_poison_expr(e = sc, ename = ename, needing = needing, es_names = es_names, es_members_list = es_members_list, poison = poison)
      let mut ai = 0
      while ai < Array::length(arms) {
        let (pp, ex) = Array::get(arms, at = ai)
        edp_poison_pat(p = pp, poison = poison)
        edp_collect_poison_expr(e = ex, ename = ename, needing = needing, es_names = es_names, es_members_list = es_members_list, poison = poison)
        ai = ai + 1
      }
    },
    EHandle(bd, arms) => {
      edp_collect_poison_expr(e = bd, ename = ename, needing = needing, es_names = es_names, es_members_list = es_members_list, poison = poison)
      let mut ai = 0
      while ai < Array::length(arms) {
        let (pp, ex) = Array::get(arms, at = ai)
        edp_poison_pat(p = pp, poison = poison)
        edp_collect_poison_expr(e = ex, ename = ename, needing = needing, es_names = es_names, es_members_list = es_members_list, poison = poison)
        ai = ai + 1
      }
    },
    ECall(callee, args, _, _) => {
      edp_collect_poison_expr(e = callee, ename = ename, needing = needing, es_names = es_names, es_members_list = es_members_list, poison = poison)
      let mut ai = 0
      while ai < Array::length(args) {
        edp_collect_poison_expr(e = Array::get(args, at = ai), ename = ename, needing = needing, es_names = es_names, es_members_list = es_members_list, poison = poison)
        ai = ai + 1
      }
    },
    EWhile(c, b) => {
      edp_collect_poison_expr(e = c, ename = ename, needing = needing, es_names = es_names, es_members_list = es_members_list, poison = poison)
      edp_collect_poison_expr(e = b, ename = ename, needing = needing, es_names = es_names, es_members_list = es_members_list, poison = poison)
    },
    EForIn(n, idx, it, b) => {
      edp_poison_add(nm = n, poison = poison)
      match idx {
        Some(ix) => edp_poison_add(nm = ix, poison = poison),
        None => ()
      }
      edp_collect_poison_expr(e = it, ename = ename, needing = needing, es_names = es_names, es_members_list = es_members_list, poison = poison)
      edp_collect_poison_expr(e = b, ename = ename, needing = needing, es_names = es_names, es_members_list = es_members_list, poison = poison)
    },
    ELoop(pairs, b) => {
      let mut pi = 0
      while pi < Array::length(pairs) {
        let (n, v) = Array::get(pairs, at = pi)
        edp_poison_add(nm = n, poison = poison)
        edp_collect_poison_expr(e = v, ename = ename, needing = needing, es_names = es_names, es_members_list = es_members_list, poison = poison)
        pi = pi + 1
      }
      edp_collect_poison_expr(e = b, ename = ename, needing = needing, es_names = es_names, es_members_list = es_members_list, poison = poison)
    },
    EBinOp(_, l, r, _) => {
      edp_collect_poison_expr(e = l, ename = ename, needing = needing, es_names = es_names, es_members_list = es_members_list, poison = poison)
      edp_collect_poison_expr(e = r, ename = ename, needing = needing, es_names = es_names, es_members_list = es_members_list, poison = poison)
    },
    EUnaryOp(_, x) => edp_collect_poison_expr(e = x, ename = ename, needing = needing, es_names = es_names, es_members_list = es_members_list, poison = poison),
    EAssign(_, v, c, _) => {
      edp_collect_poison_expr(e = v, ename = ename, needing = needing, es_names = es_names, es_members_list = es_members_list, poison = poison)
      edp_collect_poison_expr(e = c, ename = ename, needing = needing, es_names = es_names, es_members_list = es_members_list, poison = poison)
    },
    EAssignOp(_, _, v, c, _) => {
      edp_collect_poison_expr(e = v, ename = ename, needing = needing, es_names = es_names, es_members_list = es_members_list, poison = poison)
      edp_collect_poison_expr(e = c, ename = ename, needing = needing, es_names = es_names, es_members_list = es_members_list, poison = poison)
    },
    EReturn(x) => edp_collect_poison_expr(e = x, ename = ename, needing = needing, es_names = es_names, es_members_list = es_members_list, poison = poison),
    EDot(o, _, _, _) => edp_collect_poison_expr(e = o, ename = ename, needing = needing, es_names = es_names, es_members_list = es_members_list, poison = poison),
    ELabeledArg(_, _, v) => edp_collect_poison_expr(e = v, ename = ename, needing = needing, es_names = es_names, es_members_list = es_members_list, poison = poison),
    EBreak(opt) => match opt {
      Some(x) => edp_collect_poison_expr(e = x, ename = ename, needing = needing, es_names = es_names, es_members_list = es_members_list, poison = poison),
      None => ()
    },
    EContinue(args) => {
      let mut ai = 0
      while ai < Array::length(args) {
        edp_collect_poison_expr(e = Array::get(args, at = ai), ename = ename, needing = needing, es_names = es_names, es_members_list = es_members_list, poison = poison)
        ai = ai + 1
      }
    },
    ETuple(items) => {
      let mut ai = 0
      while ai < Array::length(items) {
        edp_collect_poison_expr(e = Array::get(items, at = ai), ename = ename, needing = needing, es_names = es_names, es_members_list = es_members_list, poison = poison)
        ai = ai + 1
      }
    },
    EArray(items) => {
      let mut ai = 0
      while ai < Array::length(items) {
        edp_collect_poison_expr(e = Array::get(items, at = ai), ename = ename, needing = needing, es_names = es_names, es_members_list = es_members_list, poison = poison)
        ai = ai + 1
      }
    },
    ERecord(_, fields, _) => {
      let mut ai = 0
      while ai < Array::length(fields) {
        let (_, v) = Array::get(fields, at = ai)
        edp_collect_poison_expr(e = v, ename = ename, needing = needing, es_names = es_names, es_members_list = es_members_list, poison = poison)
        ai = ai + 1
      }
    },
    EMap(fields) => {
      let mut ai = 0
      while ai < Array::length(fields) {
        let (_, v) = Array::get(fields, at = ai)
        edp_collect_poison_expr(e = v, ename = ename, needing = needing, es_names = es_names, es_members_list = es_members_list, poison = poison)
        ai = ai + 1
      }
    },
    ESpread(x) => edp_collect_poison_expr(e = x, ename = ename, needing = needing, es_names = es_names, es_members_list = es_members_list, poison = poison),
    _ => ()
  }
}

fn edp_poison_pat(p: Pat, poison: Array[String]) -> Unit {
  let names = empty_str_array()
  edp_pat_binds(p = p, out = names)
  let mut i = 0
  while i < Array::length(names) {
    edp_poison_add(nm = Array::get(names, at = i), poison = poison)
    i = i + 1
  }
}

/// A binding counts as evidence-taking when its value is a row-E literal
/// OR a direct value reference to a needing fn (post-migration both have
/// the __ev-leading arity, so calls through the binding prepend evidence).
fn edp_row_lit_bindable(v: Expr, ename: String, needing: Array[String], es_names: Array[String], es_members_list: Array[Array[String]]) -> Bool {
  if edp_efn_row_carries(expr = v, ename = ename, es_names = es_names, es_members_list = es_members_list) {
    true
  } else {
    match v {
      EIdent(nm, _) => edp_str_array_contains(arr = needing, v = nm),
      _ => false
    }
  }
}

fn edp_row_lit_scan_expr(e: Expr, ename: String, needing: Array[String], es_names: Array[String], es_members_list: Array[Array[String]], binds: Array[String], lits: Array[Expr]) -> Unit {
  if edp_efn_row_carries(expr = e, ename = ename, es_names = es_names, es_members_list = es_members_list) {
    Array::push(lits, value = e)
  } else {
    ()
  }
  match e {
    ELet(n, v, b, _) => {
      if edp_row_lit_bindable(v = v, ename = ename, needing = needing, es_names = es_names, es_members_list = es_members_list) {
        Array::push(binds, value = n)
      } else {
        ()
      }
      edp_row_lit_scan_expr(e = v, ename = ename, needing = needing, es_names = es_names, es_members_list = es_members_list, binds = binds, lits = lits)
      edp_row_lit_scan_expr(e = b, ename = ename, needing = needing, es_names = es_names, es_members_list = es_members_list, binds = binds, lits = lits)
    },
    ELetRec(n, v, b) => {
      if edp_row_lit_bindable(v = v, ename = ename, needing = needing, es_names = es_names, es_members_list = es_members_list) {
        Array::push(binds, value = n)
      } else {
        ()
      }
      edp_row_lit_scan_expr(e = v, ename = ename, needing = needing, es_names = es_names, es_members_list = es_members_list, binds = binds, lits = lits)
      edp_row_lit_scan_expr(e = b, ename = ename, needing = needing, es_names = es_names, es_members_list = es_members_list, binds = binds, lits = lits)
    },
    ELetMut(_, v, b, _) => {
      edp_row_lit_scan_expr(e = v, ename = ename, needing = needing, es_names = es_names, es_members_list = es_members_list, binds = binds, lits = lits)
      edp_row_lit_scan_expr(e = b, ename = ename, needing = needing, es_names = es_names, es_members_list = es_members_list, binds = binds, lits = lits)
    },
    EFn(_, _, _, _, _, fb) => edp_row_lit_scan_expr(e = fb, ename = ename, needing = needing, es_names = es_names, es_members_list = es_members_list, binds = binds, lits = lits),
    ESeq(a, b) => {
      edp_row_lit_scan_expr(e = a, ename = ename, needing = needing, es_names = es_names, es_members_list = es_members_list, binds = binds, lits = lits)
      edp_row_lit_scan_expr(e = b, ename = ename, needing = needing, es_names = es_names, es_members_list = es_members_list, binds = binds, lits = lits)
    },
    EIf(c, t, el) => {
      edp_row_lit_scan_expr(e = c, ename = ename, needing = needing, es_names = es_names, es_members_list = es_members_list, binds = binds, lits = lits)
      edp_row_lit_scan_expr(e = t, ename = ename, needing = needing, es_names = es_names, es_members_list = es_members_list, binds = binds, lits = lits)
      edp_row_lit_scan_expr(e = el, ename = ename, needing = needing, es_names = es_names, es_members_list = es_members_list, binds = binds, lits = lits)
    },
    EMatch(sc, arms) => {
      edp_row_lit_scan_expr(e = sc, ename = ename, needing = needing, es_names = es_names, es_members_list = es_members_list, binds = binds, lits = lits)
      let mut ai = 0
      while ai < Array::length(arms) {
        let (_, ex) = Array::get(arms, at = ai)
        edp_row_lit_scan_expr(e = ex, ename = ename, needing = needing, es_names = es_names, es_members_list = es_members_list, binds = binds, lits = lits)
        ai = ai + 1
      }
    },
    EHandle(bd, arms) => {
      edp_row_lit_scan_expr(e = bd, ename = ename, needing = needing, es_names = es_names, es_members_list = es_members_list, binds = binds, lits = lits)
      let mut ai = 0
      while ai < Array::length(arms) {
        let (_, ex) = Array::get(arms, at = ai)
        edp_row_lit_scan_expr(e = ex, ename = ename, needing = needing, es_names = es_names, es_members_list = es_members_list, binds = binds, lits = lits)
        ai = ai + 1
      }
    },
    ECall(callee, args, _, _) => {
      edp_row_lit_scan_expr(e = callee, ename = ename, needing = needing, es_names = es_names, es_members_list = es_members_list, binds = binds, lits = lits)
      let mut ai = 0
      while ai < Array::length(args) {
        edp_row_lit_scan_expr(e = Array::get(args, at = ai), ename = ename, needing = needing, es_names = es_names, es_members_list = es_members_list, binds = binds, lits = lits)
        ai = ai + 1
      }
    },
    EWhile(c, b) => {
      edp_row_lit_scan_expr(e = c, ename = ename, needing = needing, es_names = es_names, es_members_list = es_members_list, binds = binds, lits = lits)
      edp_row_lit_scan_expr(e = b, ename = ename, needing = needing, es_names = es_names, es_members_list = es_members_list, binds = binds, lits = lits)
    },
    EForIn(_, _, it, b) => {
      edp_row_lit_scan_expr(e = it, ename = ename, needing = needing, es_names = es_names, es_members_list = es_members_list, binds = binds, lits = lits)
      edp_row_lit_scan_expr(e = b, ename = ename, needing = needing, es_names = es_names, es_members_list = es_members_list, binds = binds, lits = lits)
    },
    ELoop(pairs, b) => {
      let mut pi = 0
      while pi < Array::length(pairs) {
        let (_, v) = Array::get(pairs, at = pi)
        edp_row_lit_scan_expr(e = v, ename = ename, needing = needing, es_names = es_names, es_members_list = es_members_list, binds = binds, lits = lits)
        pi = pi + 1
      }
      edp_row_lit_scan_expr(e = b, ename = ename, needing = needing, es_names = es_names, es_members_list = es_members_list, binds = binds, lits = lits)
    },
    EBinOp(_, l, r, _) => {
      edp_row_lit_scan_expr(e = l, ename = ename, needing = needing, es_names = es_names, es_members_list = es_members_list, binds = binds, lits = lits)
      edp_row_lit_scan_expr(e = r, ename = ename, needing = needing, es_names = es_names, es_members_list = es_members_list, binds = binds, lits = lits)
    },
    EUnaryOp(_, x) => edp_row_lit_scan_expr(e = x, ename = ename, needing = needing, es_names = es_names, es_members_list = es_members_list, binds = binds, lits = lits),
    EAssign(_, v, c, _) => {
      edp_row_lit_scan_expr(e = v, ename = ename, needing = needing, es_names = es_names, es_members_list = es_members_list, binds = binds, lits = lits)
      edp_row_lit_scan_expr(e = c, ename = ename, needing = needing, es_names = es_names, es_members_list = es_members_list, binds = binds, lits = lits)
    },
    EAssignOp(_, _, v, c, _) => {
      edp_row_lit_scan_expr(e = v, ename = ename, needing = needing, es_names = es_names, es_members_list = es_members_list, binds = binds, lits = lits)
      edp_row_lit_scan_expr(e = c, ename = ename, needing = needing, es_names = es_names, es_members_list = es_members_list, binds = binds, lits = lits)
    },
    EReturn(x) => edp_row_lit_scan_expr(e = x, ename = ename, needing = needing, es_names = es_names, es_members_list = es_members_list, binds = binds, lits = lits),
    EDot(o, _, _, _) => edp_row_lit_scan_expr(e = o, ename = ename, needing = needing, es_names = es_names, es_members_list = es_members_list, binds = binds, lits = lits),
    ELabeledArg(_, _, v) => edp_row_lit_scan_expr(e = v, ename = ename, needing = needing, es_names = es_names, es_members_list = es_members_list, binds = binds, lits = lits),
    EBreak(opt) => match opt {
      Some(x) => edp_row_lit_scan_expr(e = x, ename = ename, needing = needing, es_names = es_names, es_members_list = es_members_list, binds = binds, lits = lits),
      None => ()
    },
    EContinue(args) => {
      let mut ai = 0
      while ai < Array::length(args) {
        edp_row_lit_scan_expr(e = Array::get(args, at = ai), ename = ename, needing = needing, es_names = es_names, es_members_list = es_members_list, binds = binds, lits = lits)
        ai = ai + 1
      }
    },
    ETuple(items) => {
      let mut ai = 0
      while ai < Array::length(items) {
        edp_row_lit_scan_expr(e = Array::get(items, at = ai), ename = ename, needing = needing, es_names = es_names, es_members_list = es_members_list, binds = binds, lits = lits)
        ai = ai + 1
      }
    },
    EArray(items) => {
      let mut ai = 0
      while ai < Array::length(items) {
        edp_row_lit_scan_expr(e = Array::get(items, at = ai), ename = ename, needing = needing, es_names = es_names, es_members_list = es_members_list, binds = binds, lits = lits)
        ai = ai + 1
      }
    },
    ERecord(_, fields, _) => {
      let mut ai = 0
      while ai < Array::length(fields) {
        let (_, v) = Array::get(fields, at = ai)
        edp_row_lit_scan_expr(e = v, ename = ename, needing = needing, es_names = es_names, es_members_list = es_members_list, binds = binds, lits = lits)
        ai = ai + 1
      }
    },
    EMap(fields) => {
      let mut ai = 0
      while ai < Array::length(fields) {
        let (_, v) = Array::get(fields, at = ai)
        edp_row_lit_scan_expr(e = v, ename = ename, needing = needing, es_names = es_names, es_members_list = es_members_list, binds = binds, lits = lits)
        ai = ai + 1
      }
    },
    ESpread(x) => edp_row_lit_scan_expr(e = x, ename = ename, needing = needing, es_names = es_names, es_members_list = es_members_list, binds = binds, lits = lits),
    _ => ()
  }
}
