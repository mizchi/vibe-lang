// lib/@vibe/compiler/lowering/effects/evidence -- the read-only scans the
// returned-closure stamp (#3435) asks of a function body: how many tail
// positions and `return`s hand back a name, whether a name is assigned, and
// whether a row names an alias parameter.

import @vibe/compiler/core {
  Expr, Pat, expr_children, expr_children_into
}

import @vibe/compiler/lowering/effects/queries {
  EdpReadQuery, edp_rq_fold, edp_str_array_contains
}

import ./evidence_scan_view_expr.vibe {
  edp_pat_names, edp_rename_free
}

/// How many tail positions of `e` are the bare name `n`, reading tails as
/// `edp_stamp_tail` does and stopping where a binder rebinds `n`.
export fn edp_tail_name_count(e: Expr, n: String) -> Int {
  match e {
    EIdent(x, _) => if x == n {
      1
    } else {
      0
    },
    ESeq(_, b) => edp_tail_name_count(e = b, n = n),
    ELet(m, _, b, _) => if m == n {
      0
    } else {
      edp_tail_name_count(e = b, n = n)
    },
    ELetMut(m, _, b, _) => if m == n {
      0
    } else {
      edp_tail_name_count(e = b, n = n)
    },
    ELetRec(m, _, b) => if m == n {
      0
    } else {
      edp_tail_name_count(e = b, n = n)
    },
    EIf(_, t, el) => edp_tail_name_count(e = t, n = n) + edp_tail_name_count(e = el, n = n),
    EAssign(_, _, c, _) => edp_tail_name_count(e = c, n = n),
    EAssignOp(_, _, _, c, _) => edp_tail_name_count(e = c, n = n),
    EHandle(bd, arms) => edp_tail_name_count(e = bd, n = n) + edp_tail_name_count_arms(arms = arms, n = n),
    EMatch(_, arms) => edp_tail_name_count_arms(arms = arms, n = n),
    _ => 0
  }
}

/// How many `return`s in `e` hand back the bare name `n`, walking as
/// `edp_stamp_returns` does and stopping where a binder rebinds `n`.
export fn edp_return_name_count(e: Expr, n: String) -> Int {
  match e {
    EReturn(x) => edp_tail_name_count(e = x, n = n) + edp_return_name_count(e = x, n = n),
    ESeq(a, b) => edp_return_name_count(e = a, n = n) + edp_return_name_count(e = b, n = n),
    ELet(m, v, b, _) => edp_return_name_count(e = v, n = n) + if m == n {
      0
    } else {
      edp_return_name_count(e = b, n = n)
    },
    ELetMut(m, v, b, _) => edp_return_name_count(e = v, n = n) + if m == n {
      0
    } else {
      edp_return_name_count(e = b, n = n)
    },
    ELetRec(m, _, b) => if m == n {
      0
    } else {
      edp_return_name_count(e = b, n = n)
    },
    EIf(c, t, el) => edp_return_name_count(e = c, n = n) + edp_return_name_count(e = t, n = n) + edp_return_name_count(e = el, n = n),
    EWhile(c, b) => edp_return_name_count(e = c, n = n) + edp_return_name_count(e = b, n = n),
    EAssign(_, v, c, _) => edp_return_name_count(e = v, n = n) + edp_return_name_count(e = c, n = n),
    EAssignOp(_, _, v, c, _) => edp_return_name_count(e = v, n = n) + edp_return_name_count(e = c, n = n),
    EMatch(sc, arms) => edp_return_name_count(e = sc, n = n) + edp_return_name_count_arms(arms = arms, n = n),
    EHandle(bd, arms) => edp_return_name_count(e = bd, n = n) + edp_return_name_count_arms(arms = arms, n = n),
    EForIn(m, ix, it, b) => edp_return_name_count(e = it, n = n) + if m == n || ix == Some(n) {
      0
    } else {
      edp_return_name_count(e = b, n = n)
    },
    ELoop(pairs, b) => {
      let mut total = 0
      let mut shadows = false
      for pr in pairs {
        total = total + edp_return_name_count(e = pr.1, n = n)
        if pr.0 == n {
          shadows = true
        } else {
          ()
        }
      }
      if shadows {
        total
      } else {
        total + edp_return_name_count(e = b, n = n)
      }
    },
    // A nested lambda's `return` is its own. Every other form binds nothing,
    // so its children are counted as they are.
    EFn(_, _, _, _, _, _) => 0,
    _ => {
      let mut total = 0
      for c in expr_children(e) {
        total = total + edp_return_name_count(e = c, n = n)
      }
      total
    }
  }
}

fn edp_return_name_count_arms(arms: Array[(Pat, Expr)], n: String) -> Int {
  let mut total = 0
  for a in arms {
    if !edp_str_array_contains(arr = edp_pat_names(a.0), v = n) {
      total = total + edp_return_name_count(e = a.1, n = n)
    } else {
      ()
    }
  }
  total
}

fn edp_tail_name_count_arms(arms: Array[(Pat, Expr)], n: String) -> Int {
  let mut total = 0
  for a in arms {
    if !edp_str_array_contains(arr = edp_pat_names(a.0), v = n) {
      total = total + edp_tail_name_count(e = a.1, n = n)
    } else {
      ()
    }
  }
  total
}

/// How many assignments in `e` target the name `n`, a nested lambda's
/// included. Unscoped, as `edp_assigns_name` is.
export fn edp_count_assigns_name(e: Expr, n: String) -> Int {
  let mut count = 0
  let stack: Array[Expr] = [e]
  while Array::length(stack) > 0 {
    let k = Array::length(stack)
    let cur = Array::get(stack, at = k - 1)
    Array::truncate(stack, length = k - 1)
    match cur {
      EAssign(m, _, _, _) => if m == n {
        count = count + 1
      } else {
        ()
      },
      EAssignOp(m, _, _, _, _) => if m == n {
        count = count + 1
      } else {
        ()
      },
      _ => ()
    }
    for c in expr_children(cur) {
      Array::push(stack, value = c)
    }
  }
  count
}

/// Does `e` assign the name `n` anywhere? Unscoped: `edp_assigns_free` asks
/// it of a marker no binder spells.
export fn edp_assigns_name(e: Expr, n: String) -> Bool {
  let mut found = false
  let stack: Array[Expr] = [e]
  while !found && Array::length(stack) > 0 {
    let k = Array::length(stack)
    let cur = Array::get(stack, at = k - 1)
    Array::truncate(stack, length = k - 1)
    match cur {
      EAssign(m, _, _, _) => if m == n {
        found = true
      } else {
        ()
      },
      EAssignOp(m, _, _, _, _) => if m == n {
        found = true
      } else {
        ()
      },
      _ => ()
    }
    for c in expr_children(cur) {
      Array::push(stack, value = c)
    }
  }
  found
}

/// Does `row` spell any of `names` as a whole token?
export fn edp_row_mentions_any(row: String, names: Array[String]) -> Bool {
  let mut found = false
  let mut start = 0
  let mut i = 0
  let len = String::length(row)
  while i <= len {
    let boundary = i == len || {
      let c = String::byte_at(row, at = i)
      !(c >= 97 && c <= 122 || c >= 65 && c <= 90 || c >= 48 && c <= 57 || c == 95)
    }
    if boundary {
      if i > start && edp_str_array_contains(arr = names, v = String::substring(row, start = start, end = i)) {
        found = true
      } else {
        ()
      }
      start = i + 1
    } else {
      ()
    }
    i = i + 1
  }
  found
}

// Context may change a record's callbacks only if every read is a result and
// every assignment is visited here. A captured writer belongs to its lambda.
export fn edp_record_binding_returned(body: Expr, name: String, tail: Bool, returns: Bool) -> Bool {
  let results = (if tail {
    edp_tail_name_count(e = body, n = name)
  } else {
    0
  }) + (if returns {
    edp_return_name_count(e = body, n = name)
  } else {
    0
  })
  if results == 0 {
    return false
  }
  let marker = "#record-result"
  let renamed = edp_rename_free(e = body, from = name, to = marker)
  if edp_rq_fold(q = RQIdentUses(marker), e = renamed) != results {
    return false
  }
  let stack = [renamed]
  while Array::length(stack) > 0 {
    let n = Array::length(stack)
    let current = Array::get(stack, at = n - 1)
    Array::truncate(stack, length = n - 1)
    match current {
      EFn(_, _, _, _, _, _) => if edp_count_assigns_name(e = current, n = marker) > 0 {
        return false
      },
      _ => expr_children_into(expr = current, out = stack)
    }
  }
  true
}
