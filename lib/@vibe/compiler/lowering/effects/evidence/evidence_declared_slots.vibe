// lib/@vibe/compiler/lowering/effects/evidence -- the function-typed slots a
// DECLARED type gives a closure value: a function's declared result (#3435),
// an element of a declared tuple result, and a struct field (#3582). A
// closure written at such a slot is called with the row's dict by whoever
// reads it, so the stamp gives a row-free literal that row.

import @vibe/compiler/core {
  Expr, Stmt, TypeExpr, expr_children_into
}

import @vibe/ast {
  type_param_name
}

import @vibe/core {
  struct MutMap, struct MutSet
}

import ./evidence_scan_view_expr.vibe {
  edp_param_base_name
}

import ./evidence_fn_statement_index.vibe {
  edp_indexed_params_of_fn
}

import ./evidence_returned_scan_expr.vibe {
  edp_row_mentions_any
}

import ./evidence_slot_refusals.vibe {
  edp_args_pass_literal,
  edp_expr_passes_value_to_slot,
  edp_field_site_prefix,
  edp_parameter_type,
  edp_refuse_aliased_field_literal,
  edp_refuse_field_type_args,
  edp_refuse_uncopied_literal,
  edp_refuse_unstamped_field_literal,
  edp_row_top_labels,
  edp_set_slot_callee,
  edp_slot_row_stampable,
  edp_take_slot_callee,
  edp_unique_method_in
}

import @vibe/compiler/lowering/effects/queries {
  edp_is_identity_ascription, edp_str_array_contains
}

/// The slot (arity and row) a declared result `rty` gives the closure a
/// function returns, when it is a function type with a stampable row.
export fn edp_result_slot(stmts: Array[Stmt], rty: TypeExpr) -> Option[(Int, String)] {
  // A declared result spelled through an alias (`fn mid() -> Thunk`) is
  // expanded as an alias-annotated binding's is (Codex on #3447).
  // Only a name the program declares as an alias is looked up: every
  // function with a named result reaches this, and a scan of the
  // program per function cost the selfcompile KPI 3.6 MB.
  let resolved = match rty {
    TyFn(_, _, Some(_)) => Some(rty),
    TyName(an) => if edp_is_program_alias(an) {
      edp_result_alias_fn_type(stmts = stmts, ty = rty)
    } else {
      None
    },
    TyApp(an, _) => if edp_is_program_alias(an) {
      edp_result_alias_fn_type(stmts = stmts, ty = rty)
    } else {
      None
    },
    _ => None
  }
  match resolved {
    Some(TyFn(rptys, _, Some(rrow))) => if edp_slot_row_stampable(rrow) {
      Some((Array::length(rptys), rrow))
    } else {
      None
    },
    _ => None
  }
}

/// The function type a declared result spelled through an alias names,
/// following an alias of an alias, bare or applied, as the checker's
/// `dh_expand_type_alias` does (Codex on #3447: `type Gen[T] = Thunk`). An
/// applied alias's arguments are not substituted, so a row that names one of
/// its parameters is not read; the step bound stops a cycle.
fn edp_result_alias_fn_type(stmts: Array[Stmt], ty: TypeExpr) -> Option[TypeExpr] {
  let mut cur = ty
  let mut out: Option[TypeExpr] = None
  let mut steps = 0
  let mut done = false
  while !done && steps < 32 {
    let head = match cur {
      TyName(an) => an,
      TyApp(an, _) => an,
      _ => ""
    }
    let mut next: Option[(Array[String], TypeExpr)] = None
    if String::length(head) > 0 {
      for st in stmts {
        match st {
          STypeAlias(_, an, tparams, body) => if an == head {
            next = Some((tparams, body))
          } else {
            ()
          },
          _ => ()
        }
      }
    } else {
      ()
    }
    match next {
      Some((tparams, TyFn(ps, r, Some(row)))) => {
        if edp_slot_row_stampable(row) && !edp_row_mentions_any(row = row, names = edp_unkeyed_tparams(tparams)) {
          out = Some(TyFn(ps, r, Some(row)))
        } else {
          ()
        }
        done = true
      },
      Some((_, body)) => {
        cur = body
      },
      None => {
        done = true
      }
    }
    steps = steps + 1
  }
  out
}

/// The tuple type an alias `ty` names, through a chain of aliases, with an
/// applied alias's type arguments substituted for its parameters (Codex on
/// #3610: `type Pair[T] = (() -> Int with Ask, T)` as `Pair[Int]`), or None.
/// An element whose function row mentions a parameter is left without a slot,
/// as `edp_result_alias_fn_type` leaves such a function result.
fn edp_result_alias_tuple(stmts: Array[Stmt], ty: TypeExpr) -> Option[TypeExpr] {
  let mut cur = ty
  let mut out: Option[TypeExpr] = None
  let mut steps = 0
  let mut done = false
  while !done && steps < 32 {
    let (head, args) = match cur {
      TyName(an) => (an, []),
      TyApp(an, xs) => (an, xs),
      _ => ("", [])
    }
    let mut next: Option[TypeExpr] = None
    if String::length(head) > 0 {
      for st in stmts {
        match st {
          STypeAlias(_, an, tparams, body) => if an == head && Array::length(tparams) == Array::length(args) {
            next = Some(edp_type_expr_subst(te = body, names = edp_unkeyed_tparams(tparams), args = args))
          } else {
            ()
          },
          _ => ()
        }
      }
    } else {
      ()
    }
    match next {
      Some(TyTuple(items)) => {
        out = Some(TyTuple(items))
        done = true
      },
      Some(body) => {
        cur = body
      },
      None => {
        done = true
      }
    }
    steps = steps + 1
  }
  out
}

/// `te` with each parameter in `names` replaced by the matching `args`. A
/// function type whose row mentions a parameter becomes `TyUnit`, so it gives
/// no slot: its row is known only at an instantiation this pass cannot read.
export fn edp_type_expr_subst(te: TypeExpr, names: Array[String], args: Array[TypeExpr]) -> TypeExpr {
  match te {
    TyName(n) => {
      let mut out = te
      let mut i = 0
      while i < Array::length(names) {
        if Array::get(names, at = i) == n {
          out = Array::get(args, at = i)
        } else {
          ()
        }
        i = i + 1
      }
      out
    },
    TyApp(h, xs) => TyApp(h, for x in xs {
      edp_type_expr_subst(te = x, names = names, args = args)
    }),
    TyFn(ps, r, row) => match row {
      Some(rw) => if edp_row_mentions_any(row = rw, names = names) {
        TyUnit
      } else {
        TyFn(for x in ps {
          edp_type_expr_subst(te = x, names = names, args = args)
        }, edp_type_expr_subst(te = r, names = names, args = args), row)
      },
      None => TyFn(for x in ps {
        edp_type_expr_subst(te = x, names = names, args = args)
      }, edp_type_expr_subst(te = r, names = names, args = args), row)
    },
    TyTuple(xs) => TyTuple(for x in xs {
      edp_type_expr_subst(te = x, names = names, args = args)
    }),
    TyUnit => TyUnit
  }
}

/// The type-alias names the program declares, taken once per stamp pass
/// (`edp_note_program_aliases`).
let edp_program_aliases: Array[MutSet[String]] = []

export fn edp_note_program_aliases(_ stmts: Array[Stmt]) -> Unit {
  Array::truncate(edp_program_aliases, length = 0)
  let names = MutSet::new_string()
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, at = i) {
      STypeAlias(_, n, _, _) => MutSet::insert(names, x = n),
      _ => ()
    }
    i = i + 1
  }
  Array::push(edp_program_aliases, value = names)
}

fn edp_is_program_alias(_ name: String) -> Bool {
  Array::length(edp_program_aliases) > 0 && MutSet::has(Array::get(edp_program_aliases, at = 0), x = name)
}

/// #3582: per struct the program declares, its fields whose declared type is
/// a function type with a stampable row, each with that slot's arity and its
/// row as declared. Taken once per stamp pass (`edp_note_row_field_structs`).
let edp_row_field_structs: Array[MutMap[String, Array[(String, (Int, String))]]] = [
]

/// #3611: the type parameters of each struct in `edp_row_field_structs`, so a
/// field row that names one is instantiated at the literal (`edp_field_slot`).
let edp_row_field_tparams: Array[MutMap[String, Array[String]]] = []
let edp_nested_row_structs: Array[String] = []

/// #3582: a struct field declared `f: () -> Int with Ask` is called with the
/// row's dict by whoever reads it, exactly as a parameter of that type is. A
/// row that names one of the struct's own type parameters as a type argument
/// (`with Box[T]`) is kept with the parameters and instantiated where the
/// literal's type arguments are known (#3611). A row whose LABEL is a
/// parameter (`with E`) is not read, as for an alias
/// (`edp_result_alias_fn_type`). Run after `edp_note_program_aliases`: a
/// field spelled through an alias is expanded the way a result is.
export fn edp_note_row_field_structs(_ stmts: Array[Stmt]) -> Unit {
  Array::truncate(edp_row_field_structs, length = 0)
  Array::truncate(edp_row_field_tparams, length = 0)
  Array::truncate(edp_nested_row_structs, length = 0)
  let table: MutMap[String, Array[(String, (Int, String))]] = MutMap::new_string()
  let params: MutMap[String, Array[String]] = MutMap::new_string()
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, at = i) {
      SStruct(_, sname, fields, _, _, tparams) => {
        let row_params = edp_unkeyed_tparams(tparams)
        let slots: Array[(String, (Int, String))] = []
        let mut nested = false
        let mut k = 0
        while k < Array::length(fields) {
          let (fname, fty) = Array::get(fields, at = k)
          nested = nested || edp_type_contains_callback_row(ty = fty, stmts = stmts, fuel = 32)
          match edp_result_slot(stmts = stmts, rty = fty) {
            Some(slot) => if !edp_row_label_is_any(row = slot.1, names = row_params) {
              Array::push(slots, value = (fname, slot))
            },
            None => ()
          }
          k = k + 1
        }
        if nested {
          Array::push(edp_nested_row_structs, value = sname)
        }
        if Array::length(slots) > 0 {
          MutMap::set(table, k = sname, v = slots)
          MutMap::set(params, k = sname, v = row_params)
        }
      },
      _ => ()
    }
    i = i + 1
  }
  Array::push(edp_row_field_structs, value = table)
  Array::push(edp_row_field_tparams, value = params)
}

/// Does the head of some label of `row` (`A + B[..]`, `E::op`) name one of
/// `names`, outside any type argument?
fn edp_row_label_is_any(row: String, names: Array[String]) -> Bool {
  let mut hit = false
  for label in edp_row_top_labels(row) {
    let bracket = String::index_of(label, needle = "[")
    let head = if bracket > 0 {
      String::substring(label, start = 0, end = bracket)
    } else {
      label
    }
    if edp_row_mentions_any(row = head, names = names) {
      hit = true
    }
  }
  hit
}

fn edp_field_struct_tparams(_ sname: String) -> Array[String] {
  if Array::length(edp_row_field_tparams) == 0 {
    []
  } else {
    match MutMap::get(Array::get(edp_row_field_tparams, at = 0), k = sname) {
      Some(ps) => ps,
      None => []
    }
  }
}

/// The slot the field `fname` of the struct `sname` declares, or None. A row
/// naming the struct's type parameters (`with Box[T]`) is instantiated with
/// `targs`, the type arguments written at the literal or at the annotation it
/// is bound under (#3611: `Holder[String]::{ .. }` gives `Box[String]`).
/// Without them it is None, and `edp_field_row_unread` names the row.
export fn edp_field_slot(sname: String, fname: String, targs: Array[TypeExpr]) -> Option[(Int, String)] {
  match edp_field_slot_declared(sname = sname, fname = fname) {
    Some((arity, row)) => {
      let tparams = edp_field_struct_tparams(sname)
      if !edp_row_mentions_any(row = row, names = tparams) {
        Some((arity, row))
      } else if Array::length(targs) != Array::length(tparams) {
        None
      } else {
        match edp_row_subst_args(row = row, names = tparams, args = targs) {
          Some(row2) => if edp_slot_row_stampable(row2) {
            Some((arity, row2))
          } else {
            None
          },
          None => None
        }
      }
    },
    None => None
  }
}

/// #3611: the declared row of the field `fname` of `sname` when it names one
/// of the struct's type parameters and `targs` cannot instantiate it; else "".
fn edp_field_row_unread(sname: String, fname: String, targs: Array[TypeExpr]) -> String {
  match edp_field_slot_declared(sname = sname, fname = fname) {
    Some((_, row)) => match edp_field_slot(sname = sname, fname = fname, targs = targs) {
      Some(_) => "",
      None => row
    },
    None => ""
  }
}

/// The struct type parameters a field row names, quoted and joined for a
/// message (`T`, `K`).
fn edp_field_row_params(sname: String, row: String) -> String {
  let mut out = ""
  for p in edp_field_struct_tparams(sname) {
    if edp_row_mentions_any(row = row, names = [p]) {
      let q = String::concat("`", String::concat(p, "`"))
      out = if out == "" {
        q
      } else {
        String::concat(out, String::concat(", ", q))
      }
    }
  }
  out
}

/// `row` with each identifier inside a label's type arguments that is one of
/// `names` replaced by the matching `args`, spelled as a row item spells a
/// type (`Box[Array[Int]]`). None when an argument has no such spelling (a
/// tuple, a function, several arguments).
fn edp_row_subst_args(row: String, names: Array[String], args: Array[TypeExpr]) -> Option[String] {
  let mut out = ""
  let mut ok = true
  let mut depth = 0
  let mut start = 0
  let mut i = 0
  let len = String::length(row)
  while i <= len {
    let c = if i == len {
      0
    } else {
      String::byte_at(row, at = i)
    }
    let ident = c >= 97 && c <= 122 || c >= 65 && c <= 90 || c >= 48 && c <= 57 || c == 95
    if !ident {
      if i > start {
        let word = String::substring(row, start = start, end = i)
        let mut text = word
        if depth > 0 {
          let mut k = 0
          while k < Array::length(names) {
            if Array::get(names, at = k) == word {
              match edp_row_arg_text(Array::get(args, at = k)) {
                Some(t) => {
                  text = t
                },
                None => {
                  ok = false
                }
              }
            }
            k = k + 1
          }
        }
        out = String::concat(out, text)
      }
      if i < len {
        if c == 91 {
          depth = depth + 1
        } else if c == 93 {
          depth = depth - 1
        }
        out = String::concat(out, String::substring(row, start = i, end = i + 1))
      }
      start = i + 1
    }
    i = i + 1
  }
  if ok {
    Some(out)
  } else {
    None
  }
}

/// A type as a row item's type argument spells it, or None.
fn edp_row_arg_text(_ te: TypeExpr) -> Option[String] {
  match te {
    TyName(n) => Some(n),
    TyApp(h, xs) => if Array::length(xs) == 1 {
      match edp_row_arg_text(Array::get(xs, at = 0)) {
        Some(t) => Some(String::concat(h, String::concat("[", String::concat(t, "]")))),
        None => None
      }
    } else {
      None
    },
    _ => None
  }
}

/// #3611: the type arguments a record `e` is built at: its own written ones
/// (`Holder[String]::{ .. }`), else those of the annotation `ty` it is bound
/// under (`let h: Holder[String] = Holder::{ .. }`, also spelled through a
/// type alias), else none.
export fn edp_record_targs_under(stmts: Array[Stmt], ty: Option[TypeExpr], e: Expr) -> Array[TypeExpr] {
  match e {
    ERecord(rn, _, tas) => if Array::length(tas) > 0 {
      tas
    } else {
      match ty {
        Some(t) => edp_struct_args_of(stmts = stmts, ty = t, rn = rn),
        None => tas
      }
    },
    _ => []
  }
}

/// The type arguments `ty` applies the struct `rn` to, following a chain of
/// type aliases with their arguments substituted (`type HS = Holder[String]`);
/// empty when `ty` does not name `rn`.
fn edp_struct_args_of(stmts: Array[Stmt], ty: TypeExpr, rn: String) -> Array[TypeExpr] {
  let mut cur = ty
  let mut out: Array[TypeExpr] = []
  let mut steps = 0
  let mut done = false
  while !done && steps < 32 {
    let (head, args) = match cur {
      TyName(an) => (an, []),
      TyApp(an, xs) => (an, xs),
      _ => ("", [])
    }
    let mut next: Option[TypeExpr] = None
    if head == rn {
      out = args
    } else if String::length(head) > 0 && edp_is_program_alias(head) {
      for st in stmts {
        match st {
          STypeAlias(_, an, tparams, body) => if an == head && Array::length(tparams) == Array::length(args) {
            next = Some(edp_record_type_subst(ty = body, names = edp_unkeyed_tparams(tparams), args = args))
          },
          _ => ()
        }
      }
    }
    match next {
      Some(t) => {
        cur = t
      },
      None => {
        done = true
      }
    }
    steps = steps + 1
  }
  out
}

/// #3611: the type arguments a local `let h: Holder[String] = Holder::{ .. }`
/// gives its record, read through the parser's identity ascription
/// `((__asc: Holder[String]) -> __asc)(Holder::{ .. })`; None for any other
/// call.
export fn edp_ascribed_record_targs(stmts: Array[Stmt], callee: Expr, args: Array[Expr]) -> Option[Array[TypeExpr]] {
  match callee {
    EFn(_, _, aparams, _, _, abody) => if Array::length(args) == 1 && edp_is_identity_ascription(params = aparams, body = abody) {
      match Array::get(args, at = 0) {
        ERecord(_, _, _) => Some(edp_record_targs_under(stmts = stmts, ty = Array::get(aparams, at = 0).1, e = Array::get(args, at = 0))),
        _ => None
      }
    } else {
      None
    },
    _ => None
  }
}

/// #3611: without a readable instantiated field row, accept only a value
/// already proven to carry its own row. Unknown parameters, mutable values,
/// and call results must not silently take the row-free convention.
export fn edp_refuse_unread_field_row(sname: String, fname: String, targs: Array[TypeExpr], needs_row: Bool) -> Unit {
  let row = edp_field_row_unread(sname = sname, fname = fname, targs = targs)
  if row != "" && needs_row {
    edp_refuse_field_type_args(sname = sname, fname = fname, row = row, params = edp_field_row_params(sname = sname, row = row), written = Array::length(targs) > 0)
  }
}

/// Do the slot rows a `let`-bound literal's uses ask for all name one
/// stampable row? A use with no such row records "" (#3424).
export fn edp_rows_agree(_ rows: Array[String]) -> Bool {
  let mut ok = Array::length(rows) > 0
  for r in rows {
    if r == "" || r != Array::get(rows, at = 0) {
      ok = false
    } else {
      ()
    }
  }
  ok
}

fn edp_is_rowfree_literal(_ lit: Option[Expr]) -> Bool {
  match lit {
    Some(EFn(_, _, _, _, None, _)) => true,
    _ => false
  }
}

/// Codex on #3620: the row-free closure literals bound by `let` and stored by
/// name in a field whose row the stamp reads (`let g = () -> 1` then
/// `Holder[String]::{ f: g }`): each literal's name and `scope` index, the
/// field's row, and the field's slot-callee spelling. The field is read with
/// its row's dict, so the literal needs the row, which only its binding can
/// give it; `edp_settle_field_literal` decides there.
let edp_field_lit_names: Array[String] = []
let edp_field_lit_slots: Array[Int] = []
let edp_field_lit_rows: Array[String] = []
let edp_field_lit_callees: Array[String] = []

/// Codex on #3620: the local aliases of a closure literal bound by `let`
/// (`let alias = g`, transitively) around the walk: each alias's name and
/// `scope` index, the literal's name, and the literal.
let edp_local_alias_names: Array[String] = []
let edp_local_alias_slots: Array[Int] = []
let edp_local_alias_srcs: Array[String] = []
let edp_local_alias_vals: Array[Expr] = []

export fn edp_local_alias_mark() -> Int {
  Array::length(edp_local_alias_names)
}

export fn edp_drop_local_aliases(_ mark: Int) -> Unit {
  Array::truncate(edp_local_alias_names, length = mark)
  Array::truncate(edp_local_alias_slots, length = mark)
  Array::truncate(edp_local_alias_srcs, length = mark)
  Array::truncate(edp_local_alias_vals, length = mark)
}

/// The literal's name and the literal `name` bound at `slot` is an alias of.
fn edp_local_alias_at(name: String, slot: Int) -> Option[(String, Expr)] {
  let mut i = Array::length(edp_local_alias_names)
  let mut out = None
  while i > 0 {
    i = i - 1
    if Array::get(edp_local_alias_names, at = i) == name && Array::get(edp_local_alias_slots, at = i) == slot {
      out = Some((Array::get(edp_local_alias_srcs, at = i), Array::get(edp_local_alias_vals, at = i)))
      i = 0
    }
  }
  out
}

/// Note `let n = v` at `slot` when `v` -- (name, `scope` index, the literal
/// bound there) -- names a closure literal or an alias of one.
export fn edp_note_local_alias(n: String, slot: Int, v: (String, Int, Option[Expr])) -> Unit {
  let hit = match v.2 {
    Some(lit) => Some((v.0, lit)),
    None => edp_local_alias_at(name = v.0, slot = v.1)
  }
  match hit {
    Some(al) => {
      Array::push(edp_local_alias_names, value = n)
      Array::push(edp_local_alias_slots, value = slot)
      Array::push(edp_local_alias_srcs, value = al.0)
      Array::push(edp_local_alias_vals, value = al.1)
    },
    None => ()
  }
}

/// Where a binding's body starts noting field uses.
export fn edp_field_literal_mark() -> Int {
  Array::length(edp_field_lit_names)
}

/// Note a field of row `row` holding `lit` -- (name, `scope` index, the
/// literal bound there) -- when that is a row-free closure literal.
export fn edp_note_field_literal(lit: (String, Int, Option[Expr]), row: String, callee: String) -> Unit {
  match edp_local_alias_at(name = lit.0, slot = lit.1) {
    Some(al) => if edp_is_rowfree_literal(Some(al.1)) {
      edp_refuse_aliased_field_literal(alias = lit.0, src = al.0, callee = callee, row = row)
    },
    None => ()
  }
  if edp_is_rowfree_literal(lit.2) {
    Array::push(edp_field_lit_names, value = lit.0)
    Array::push(edp_field_lit_slots, value = lit.1)
    Array::push(edp_field_lit_rows, value = row)
    Array::push(edp_field_lit_callees, value = callee)
  }
}

/// Did the body after `mark` store the literal bound at `slot` in a field?
export fn edp_field_literal_pending(slot: Int, mark: Int) -> Bool {
  let mut i = mark
  let mut hit = false
  while !hit && i < Array::length(edp_field_lit_slots) {
    hit = Array::get(edp_field_lit_slots, at = i) == slot
    i = i + 1
  }
  hit
}

/// Remove the field uses noted after `mark` for the literal `name` bound at
/// `slot`, and answer the row it takes: the fields' row when they agree and
/// are all `total` of its uses, else "" with the build refused. A literal
/// that calls a local closure (`calls_local`) is refused as one written at a
/// field is (`edp_refuse_uncopied_literal`).
export fn edp_settle_field_literal(name: String, slot: Int, mark: Int, total: Int, calls_local: Bool) -> String {
  let mut row = ""
  let mut callee = ""
  let mut agree = true
  let mut count = 0
  let mut w = mark
  let mut i = mark
  while i < Array::length(edp_field_lit_names) {
    if Array::get(edp_field_lit_slots, at = i) == slot && Array::get(edp_field_lit_names, at = i) == name {
      if count == 0 {
        row = Array::get(edp_field_lit_rows, at = i)
        callee = Array::get(edp_field_lit_callees, at = i)
      } else if Array::get(edp_field_lit_rows, at = i) != row {
        agree = false
      }
      count = count + 1
    } else {
      Array::set(edp_field_lit_names, at = w, value = Array::get(edp_field_lit_names, at = i))
      Array::set(edp_field_lit_slots, at = w, value = Array::get(edp_field_lit_slots, at = i))
      Array::set(edp_field_lit_rows, at = w, value = Array::get(edp_field_lit_rows, at = i))
      Array::set(edp_field_lit_callees, at = w, value = Array::get(edp_field_lit_callees, at = i))
      w = w + 1
    }
    i = i + 1
  }
  Array::truncate(edp_field_lit_names, length = w)
  Array::truncate(edp_field_lit_slots, length = w)
  Array::truncate(edp_field_lit_rows, length = w)
  Array::truncate(edp_field_lit_callees, length = w)
  if count == 0 {
    ""
  } else if calls_local {
    edp_set_slot_callee(callee = callee, used = true)
    edp_refuse_uncopied_literal(callee = edp_take_slot_callee(), row = row, called = ("", false))
    ""
  } else if agree && count == total {
    row
  } else {
    edp_refuse_unstamped_field_literal(name = name, callee = callee, row = row)
    ""
  }
}

/// A closure value's declared row is authoritative at literals, parameters,
/// and declared callback results. A top-level function's OWN
/// row is not a closure ABI proof: a perform-free function may take no dict.
export fn edp_declared_value_has_row(value: Expr, slot: Int, stmts: Array[Stmt], fn_index: MutMap[String, Array[Int]]) -> Bool {
  match value {
    EFn(_, _, _, _, Some(row), _) => edp_slot_row_stampable(row),
    EIdent(_, _) => if slot >= 0 {
      match edp_parameter_type(slot) {
        Some(ty) => match edp_result_slot(stmts = stmts, rty = ty) {
          Some(_) => true,
          None => false
        },
        None => false
      }
    } else {
      false
    },
    ECall(callee, _, _, _) => edp_declared_factory_kind(value = callee, slot = slot, stmts = stmts, fn_index = fn_index) == 1,
    _ => false
  }
}

/// The slot the field `fname` of `sname` declares, its row as written.
export fn edp_field_slot_declared(sname: String, fname: String) -> Option[(Int, String)] {
  let mut out: Option[(Int, String)] = None
  if Array::length(edp_row_field_structs) > 0 {
    match MutMap::get(Array::get(edp_row_field_structs, at = 0), k = sname) {
      Some(slots) => {
        let mut k = 0
        while k < Array::length(slots) {
          let (fname2, slot) = Array::get(slots, at = k)
          if fname2 == fname {
            out = Some(slot)
          }
          k = k + 1
        }
      },
      None => ()
    }
  }
  out
}

/// Does `e` build a struct with a row-typed field? A read-only scan, so a
/// statement with none is not rebuilt (#1875).
export fn edp_expr_builds_row_field(_ e: Expr) -> Bool {
  if !edp_has_row_fields() && Array::length(edp_nested_row_structs) == 0 {
    false
  } else {
    let table = Array::get(edp_row_field_structs, at = 0)
    let mut found = false
    let stack: Array[Expr] = [e]
    while !found && Array::length(stack) > 0 {
      let n = Array::length(stack)
      let cur = Array::get(stack, at = n - 1)
      Array::truncate(stack, length = n - 1)
      match cur {
        ERecord(rn, _, _) => if MutMap::has(table, k = rn) || edp_str_array_contains(arr = edp_nested_row_structs, v = rn) {
          found = true
        },
        _ => ()
      }
      expr_children_into(expr = cur, out = stack)
    }
    found
  }
}

/// #3582: the element types of a declared tuple result `rty` when one of them,
/// at any depth of nested tuples, is a function type with a stampable row;
/// else None. The closure in that position is called with the dict, as one
/// returned alone at that type is (`edp_result_slot`).
export fn edp_tuple_result_types(stmts: Array[Stmt], rty0: TypeExpr) -> Option[Array[TypeExpr]] {
  // A tuple result spelled through an alias (`fn mk() -> Pair` with
  // `type Pair = (() -> Int with Ask, Int)`) is expanded as a function
  // result's alias is (`edp_result_slot`; Codex on #3610).
  let alias_head = match rty0 {
    TyName(an) => an,
    TyApp(an, _) => an,
    _ => ""
  }
  let rty = if String::length(alias_head) > 0 && edp_is_program_alias(alias_head) {
    match edp_result_alias_tuple(stmts = stmts, ty = rty0) {
      Some(t) => t,
      None => rty0
    }
  } else {
    rty0
  }
  match rty {
    TyTuple(items) => {
      let mut hit = false
      for t in items {
        let slot_here = match edp_result_slot(stmts = stmts, rty = t) {
          Some(_) => true,
          None => false
        }
        let nested = match edp_tuple_result_types(stmts = stmts, rty0 = t) {
          Some(_) => true,
          None => false
        }
        if slot_here || nested {
          hit = true
        }
      }
      if hit {
        Some(items)
      } else {
        None
      }
    },
    _ => None
  }
}

/// The slot-callee spelling of the field `fname` of `sname`, so a refusal
/// names the field rather than a call (`edp_slot_site`).
export fn edp_field_slot_callee(sname: String, fname: String) -> String {
  String::concat(edp_field_site_prefix(), String::concat("the value of the field `", String::concat(fname, String::concat("` of `", String::concat(sname, "`")))))
}

export fn edp_field_alias_has_rowfree_literal(name: String, slot: Int) -> Bool {
  match edp_local_alias_at(name = name, slot = slot) {
    Some(alias) => edp_is_rowfree_literal(Some(alias.1)),
    None => false
  }
}

/// `(p0, .., pn) -> name(p0, .., pn)` under `row`: a row-free function passed
/// by name at a row-typed slot, wrapped so the dict its callee passes has a
/// parameter to land in (#3424).
export fn edp_slot_wrapper(name: String, arity: Int, row: String) -> Expr {
  let params: Array[(String, Option[TypeExpr])] = []
  let args: Array[Expr] = []
  // The parameters must not shadow `name` inside the wrapper; a function
  // spelled with the usual prefix gets the other one (Codex on #3426).
  let prefix = if String::starts_with(name, prefix = "__edpw_") {
    "__edpx_"
  } else {
    "__edpw_"
  }
  let mut k = 0
  while k < arity {
    let pn = String::concat(prefix, Int::to_string(k))
    Array::push(params, value = (pn, None))
    Array::push(args, value = EIdent(pn, 0 - 1))
    k = k + 1
  }
  EFn([], [], params, None, Some(row), ECall(EIdent(name, 0 - 1), args, 0 - 1, [
  ]))
}

// Rows contain source tokens, whereas kinded binders use encoded AST keys.
export fn edp_unkeyed_tparams(_ params: Array[String]) -> Array[String] {
  let mut keyed = false
  for param in params {
    if type_param_name(param) != param {
      keyed = true
    }
  }
  if keyed {
    for param in params {
      type_param_name(param)
    }
  } else {
    params
  }
}

/// The arity and row of the function type a top-level function's parameter
/// `pos` declares, when that type carries a row.
export fn edp_slot_fn_type(stmts: Array[Stmt], fn_index: MutMap[String, Array[Int]], callee: String, pos: Int) -> Option[(Int, String)] {
  match edp_indexed_params_of_fn(stmts = stmts, index = fn_index, nm = callee) {
    Some(params) => if pos < Array::length(params) {
      let (_, pty) = Array::get(params, at = pos)
      match pty {
        Some(TyFn(ptys, _, Some(row))) => if edp_slot_row_stampable(row) {
          Some((Array::length(ptys), row))
        } else {
          None
        },
        _ => None
      }
    } else {
      None
    },
    None => None
  }
}

/// The row a top-level function's parameter `pos` declares on its function
/// type, or None.
export fn edp_slot_row(stmts: Array[Stmt], fn_index: MutMap[String, Array[Int]], callee: String, pos: Int) -> Option[String] {
  match edp_indexed_params_of_fn(stmts = stmts, index = fn_index, nm = callee) {
    Some(params) => if pos < Array::length(params) {
      let (_, pty) = Array::get(params, at = pos)
      match pty {
        Some(TyFn(_, _, Some(row))) => if edp_slot_row_stampable(row) {
          Some(row)
        } else {
          None
        },
        _ => None
      }
    } else {
      None
    },
    None => None
  }
}

/// Record convention proofs are unnecessary when no field declares a row.
export fn edp_has_row_fields() -> Bool {
  Array::length(edp_row_field_structs) > 0 && MutMap::size(Array::get(edp_row_field_structs, at = 0)) > 0
}

// A type ascription changes the type view, never the value's origin or ABI.
export fn edp_identity_value(_ value: Expr) -> Expr {
  let mut current = value
  let mut done = false
  while !done {
    match current {
      ECall(EFn(_, _, params, _, _, body), args, _, _) => if Array::length(args) == 1 && edp_is_identity_ascription(params = params, body = body) {
        current = Array::get(args, at = 0)
      } else {
        done = true
      },
      _ => done = true
    }
  }
  current
}

// Record views substitute row arguments because their concrete instantiation
// is available. Keep the deliberately lossy result-slot substitution separate.
export fn edp_record_type_subst(ty: TypeExpr, names: Array[String], args: Array[TypeExpr]) -> TypeExpr {
  if Array::length(names) == 0 {
    return ty
  }
  match ty {
    TyName(_) => edp_type_expr_subst(te = ty, names = names, args = args),
    TyApp(head, items) => {
      let values = for item in items {
        edp_record_type_subst(ty = item, names = names, args = args)
      }
      match edp_type_expr_subst(te = TyName(head), names = names, args = args) {
        TyName(n) => TyApp(n, values),
        _ => TyUnit
      }
    },
    TyFn(params, result, row) => {
      let next = match row {
        Some(r) => if edp_row_label_is_any(row = r, names = names) {
          None
        } else if edp_row_mentions_any(row = r, names = names) {
          edp_row_subst_args(row = r, names = names, args = args)
        } else {
          Some(r)
        },
        None => None
      }
      match (row, next) {
        (Some(_), None) => TyUnit,
        _ => TyFn(for param in params {
          edp_record_type_subst(ty = param, names = names, args = args)
        }, edp_record_type_subst(ty = result, names = names, args = args), next)
      }
    },
    TyTuple(items) => TyTuple(for item in items {
      edp_record_type_subst(ty = item, names = names, args = args)
    }),
    TyUnit => TyUnit
  }
}

// A known callback convention, never absence interpreted as row-free.
export fn edp_callback_kind(ty: TypeExpr, stmts: Array[Stmt], fuel: Int) -> Int {
  match ty {
    TyFn(_, _, _) => (),
    TyName(n) => if !edp_is_program_alias(n) {
      return -1
    },
    TyApp(n, _) => if !edp_is_program_alias(n) {
      return -1
    },
    _ => return -1
  }
  match edp_result_slot(stmts = stmts, rty = ty) {
    Some(_) => 1,
    None => match ty {
      TyFn(_, _, None) => 0,
      _ => {
        let (head, args) = match ty {
          TyName(n) => (n, []),
          TyApp(n, xs) => (n, xs),
          _ => ("", [])
        }
        let mut kind = -1
        if fuel > 0 && edp_is_program_alias(head) {
          for st in stmts {
            match st {
              STypeAlias(_, name, params, body) => if name == head && Array::length(params) == Array::length(args) {
                kind = edp_callback_kind(ty = edp_type_expr_subst(te = body, names = edp_unkeyed_tparams(params), args = args), stmts = stmts, fuel = fuel - 1)
              },
              _ => ()
            }
          }
        }
        kind
      }
    }
  }
}

// A callable's declared callback RESULT, independent of its own convention.
export fn edp_declared_factory_kind(value: Expr, slot: Int, stmts: Array[Stmt], fn_index: MutMap[String, Array[Int]]) -> Int {
  match value {
    EFn(_, _, _, Some(result), _, _) => edp_callback_kind(ty = result, stmts = stmts, fuel = 32),
    EIdent(name, _) => if slot >= 0 {
      match edp_parameter_type(slot) {
        Some(TyFn(_, result, _)) => edp_callback_kind(ty = result, stmts = stmts, fuel = 32),
        _ => -1
      }
    } else {
      let mut kind = -1
      match MutMap::get(fn_index, k = name) {
        Some(indices) => {
          let mut first = true
          let mut agrees = true
          for index in indices {
            let current = match Array::get(stmts, at = index) {
              SLet(_, _, _, _, EFn(_, _, _, Some(result), _, _)) => edp_callback_kind(ty = result, stmts = stmts, fuel = 32),
              _ => -1
            }
            if first {
              kind = current; first = false
            } else {
              agrees = agrees && kind == current
            }
          }
          if !agrees {
            kind = -1
          }
        },
        None => ()
      }
      kind
    },
    _ => -1
  }
}

// An explicit callback type argument (or alias) requires the producer walk.
export fn edp_record_callback_args(_ args: Array[TypeExpr]) -> Bool {
  let mut found = false
  for ty in args {
    match ty {
      TyFn(_, _, Some(_)) => found = true,
      TyName(n) => if edp_is_program_alias(n) {
        found = true
      },
      TyApp(n, _) => if edp_is_program_alias(n) {
        found = true
      },
      _ => ()
    }
  }
  found
}

export fn edp_slot_row_or_empty(stmts: Array[Stmt], fn_index: MutMap[String, Array[Int]], callee: String, pos: Int) -> String {
  if pos < 0 {
    ""
  } else {
    match edp_slot_row(stmts = stmts, fn_index = fn_index, callee = callee, pos = pos) {
      Some(row) => row,
      None => ""
    }
  }
}

// Include an outer record whose field supplies a nested callback's context.
fn edp_type_contains_callback_row(ty: TypeExpr, stmts: Array[Stmt], fuel: Int) -> Bool {
  if fuel <= 0 {
    return false
  }
  match ty {
    TyFn(_, _, Some(_)) => true,
    TyApp(n, args) => {
      let mut found = false
      for arg in args {
        found = found || edp_type_contains_callback_row(ty = arg, stmts = stmts, fuel = fuel - 1)
      }
      found || edp_alias_contains_callback_row(name = n, args = args, stmts = stmts, fuel = fuel)
    },
    TyName(n) => if edp_is_program_alias(n) {
      edp_alias_contains_callback_row(name = n, args = [], stmts = stmts, fuel = fuel)
    } else {
      false
    },
    TyTuple(items) => {
      let mut found = false
      for item in items {
        found = found || edp_type_contains_callback_row(ty = item, stmts = stmts, fuel = fuel - 1)
      }
      found
    },
    _ => false
  }
}

fn edp_alias_contains_callback_row(name: String, args: Array[TypeExpr], stmts: Array[Stmt], fuel: Int) -> Bool {
  let mut found = false
  if edp_is_program_alias(name) {
    for st in stmts {
      match st {
        STypeAlias(_, n, params, body) => if n == name && Array::length(params) == Array::length(args) {
          found = edp_type_contains_callback_row(ty = edp_record_type_subst(ty = body, names = edp_unkeyed_tparams(params), args = args), stmts = stmts, fuel = fuel - 1)
        },
        _ => ()
      }
    }
  }
  found
}

/// A parameter's name without its labeled (`~`) or optional (`?`) marker.

/// The index of the parameter of the top-level `callee` a label names, or -1.
export fn edp_param_index_by_label(stmts: Array[Stmt], fn_index: MutMap[String, Array[Int]], callee: String, label: String) -> Int {
  match edp_indexed_params_of_fn(stmts = stmts, index = fn_index, nm = callee) {
    Some(params) => {
      let mut found = 0 - 1
      let mut i = 0
      while found < 0 && i < Array::length(params) {
        let (pn, _) = Array::get(params, at = i)
        if edp_param_base_name(pn) == label {
          found = i
        } else {
          ()
        }
        i = i + 1
      }
      found
    },
    None => 0 - 1
  }
}

// Only nominal contexts that can carry a callback row need a producer walk.
export fn edp_record_context_type(ty: TypeExpr, stmts: Array[Stmt]) -> Bool {
  edp_record_context_type_in(ty = ty, stmts = stmts, fuel = 32)
}

fn edp_record_context_type_in(ty: TypeExpr, stmts: Array[Stmt], fuel: Int) -> Bool {
  if fuel <= 0 {
    return false
  }
  let head = match ty {
    TyName(n) => n,
    TyApp(n, _) => n,
    _ => return false
  }
  let args = match ty {
    TyApp(_, xs) => xs,
    _ => {
      if !edp_is_program_alias(head) && !edp_str_array_contains(arr = edp_nested_row_structs, v = head) && !edp_has_row_fields() {
        return false
      }
      []
    }
  }
  let mut found = edp_str_array_contains(arr = edp_nested_row_structs, v = head)
  if edp_has_row_fields() {
    found = found || MutMap::has(Array::get(edp_row_field_structs, at = 0), k = head)
  }
  for arg in args {
    found = found || edp_type_contains_callback_row(ty = arg, stmts = stmts, fuel = 32)
  }
  if !found && edp_is_program_alias(head) {
    for st in stmts {
      match st {
        STypeAlias(_, n, names, body) => if n == head && Array::length(names) == Array::length(args) {
          found = edp_record_context_type_in(ty = edp_record_type_subst(ty = body, names = edp_unkeyed_tparams(names), args = args), stmts = stmts, fuel = fuel - 1)
        },
        _ => ()
      }
    }
  }
  found
}

/// Does `e` contain a named call with a row-free closure literal argument, a
/// row-free top-level function passed by name, or a `let`-bound row-free
/// literal? A read-only scan, so a statement with none is not rebuilt
/// (#1875).
export fn edp_expr_passes_literal_arg(e: Expr, pure_names: MutSet[String], stmts: Array[Stmt]) -> Bool {
  let mut found = false
  let stack: Array[Expr] = [e]
  while !found && Array::length(stack) > 0 {
    let n = Array::length(stack)
    let cur = Array::get(stack, at = n - 1)
    Array::truncate(stack, length = n - 1)
    match cur {
      ECall(EIdent(_, _), args, _, _) => if edp_args_pass_literal(args = args, pure_names = pure_names) {
        found = true
      },
      // Codex on #3467: a method-style call too (`runner.run(() -> ..)`).
      ECall(EDot(_, _, _, _), args, _, _) => if edp_args_pass_literal(args = args, pure_names = pure_names) {
        found = true
      },
      ECall(EFn(_, _, _, _, _, _), cargs, _, _) => if Array::length(cargs) == 1 {
        match Array::get(cargs, at = 0) {
          EFn(_, _, _, _, None, _) => {
            found = true
          },
          _ => ()
        }
      } else {
        ()
      },
      ERecord(_, _, args) => if edp_record_callback_args(args) {
        found = true
      },
      // A row-free one may take a row from its uses; one with a row is
      // bound under a name of its own (`edp_unique_row_lit_name`, #3416).
      ELet(_, EFn(_, _, _, _, _, _), _, _) => {
        found = true
      },
      // A lambda that returns a closure at a declared row (Codex on #3447).
      EFn(_, _, _, Some(TyFn(_, _, Some(_))), _, _) => {
        found = true
      },
      // #3582: or a tuple that may hold one.
      EFn(_, _, _, Some(TyTuple(_)), _, _) => {
        found = true
      },
      EFn(_, _, params, _, _, _) => if edp_params_need_record_context(params = params, stmts = stmts) {
        found = true
      },
      _ => ()
    }
    expr_children_into(expr = cur, out = stack)
  }
  found
}

// Select callers as well as producers: a generic Cell literal has no row
// until its callee's nominal parameter supplies the missing type arguments.
export fn edp_note_record_slot_callees(stmts: Array[Stmt], defs: Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], names: MutSet[String]) -> Unit {
  for def in defs {
    match Array::get(stmts, at = def.0) {
      SLet(_, _, _, _, EFn(_, _, params, _, _, _)) => if edp_params_need_record_context(params = params, stmts = stmts) {
        MutSet::insert(names, x = def.3)
      },
      _ => ()
    }
  }
  ()
}

fn edp_params_need_record_context(params: Array[(String, Option[TypeExpr])], stmts: Array[Stmt]) -> Bool {
  let mut found = false
  for param in params {
    match param.1 {
      Some(ty) => found = found || edp_callable_record_context(ty = ty, stmts = stmts),
      None => ()
    }
  }
  found
}

fn edp_callable_record_context(ty: TypeExpr, stmts: Array[Stmt]) -> Bool {
  match ty {
    TyFn(params, result, _) => {
      let mut found = edp_callable_record_context(ty = result, stmts = stmts)
      for param in params {
        found = found || edp_callable_record_context(ty = param, stmts = stmts)
      }
      found
    },
    _ => edp_record_context_type(ty = ty, stmts = stmts)
  }
}

/// edp_stamp_slot_rows' three pre-checks on `e`, the body of a statement
/// whose edp_slot_facts_stmt are `facts` (#4040). Each pre-check is asked
/// only where the facts show a node it could hit on -- a literal-shaped
/// argument, a bare argument naming a row-free function, a record type
/// argument naming an alias, a lambda parameter needing a record's context,
/// a call to a slot callee, a record built -- so a statement the facts rule
/// out is not walked, and the answer is the pre-checks' own.
export fn edp_stamp_prechecks_hit(e: Expr, facts: (Bool, Array[String], Array[String], Array[String], Array[String], Array[String], Array[TypeExpr]), pure_names: MutSet[String], slot_callees: MutSet[String], stmts: Array[Stmt]) -> Bool {
  let (syntactic, idents, callees, methods, records, aliases, params) = facts
  let mut literal = syntactic
  for nm in idents {
    if MutSet::has(pure_names, x = nm) {
      literal = true
    } else ()
  }
  for nm in aliases {
    if edp_is_program_alias(nm) {
      literal = true
    } else ()
  }
  if !literal {
    for ty in params {
      if edp_callable_record_context(ty = ty, stmts = stmts) {
        literal = true
      } else ()
    }
  } else ()
  let mut slot = false
  if MutSet::size(slot_callees) > 0 {
    for nm in callees {
      if MutSet::has(slot_callees, x = nm) {
        slot = true
      } else ()
    }
    for m in methods {
      if edp_unique_method_in(names = slot_callees, m = m) != "" {
        slot = true
      } else ()
    }
  } else ()
  literal && edp_expr_passes_literal_arg(e = e, pure_names = pure_names, stmts = stmts) || slot && edp_expr_passes_value_to_slot(e = e, slot_callees = slot_callees) || Array::length(records) > 0 && edp_expr_builds_row_field(e)
}
