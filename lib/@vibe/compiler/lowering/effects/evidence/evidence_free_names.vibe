// lib/@vibe/compiler/lowering/effects/evidence -- the free names of an
// expression, which the evidence pass reads to decide whether a local helper
// can be copied together with the names it needs.

import @vibe/compiler/core {
  Expr, expr_children
}

import @vibe/compiler/lowering/effects/queries {
  edp_str_array_contains
}

import ./evidence_scan_view_expr.vibe {
  edp_param_base_name, edp_pat_names
}

/// Recorded by `edp_free_names` for a part it cannot read names out of (an
/// interpolation's text), so a copy is declined rather than trusted.
export let edp_free_names_opaque: String = "#opaque"

/// The names `e` reads or assigns that it does not bind itself, into `out`.
/// `bound` is the names bound around `e`. Every binder form is scoped (`let`,
/// `let mut`, `let rec`, parameters, match and handler arm patterns, `for`,
/// `loop`), and an assignment's target counts, because the AST keeps it as a
/// name rather than an `EIdent`.
export fn edp_free_names(e: Expr, bound: Array[String], out: Array[String]) -> Unit {
  match e {
    EIdent(n, _) => edp_free_name(n = n, bound = bound, out = out),
    EAssign(n, v, c, _) => {
      edp_free_name(n = n, bound = bound, out = out)
      edp_free_names(e = v, bound = bound, out = out)
      edp_free_names(e = c, bound = bound, out = out)
    },
    EAssignOp(n, _, v, c, _) => {
      edp_free_name(n = n, bound = bound, out = out)
      edp_free_names(e = v, bound = bound, out = out)
      edp_free_names(e = c, bound = bound, out = out)
    },
    ELet(n, v, b, _) => {
      edp_free_names(e = v, bound = bound, out = out)
      edp_free_names(e = b, bound = edp_names_with(bound = bound, names = [n]), out = out)
    },
    ELetMut(n, v, b, _) => {
      edp_free_names(e = v, bound = bound, out = out)
      edp_free_names(e = b, bound = edp_names_with(bound = bound, names = [n]), out = out)
    },
    ELetRec(n, v, b) => {
      let inner = edp_names_with(bound = bound, names = [n])
      edp_free_names(e = v, bound = inner, out = out)
      edp_free_names(e = b, bound = inner, out = out)
    },
    EFn(_, _, ps, _, _, body) => {
      let names: Array[String] = []
      for p in ps {
        Array::push(names, value = edp_param_base_name(p.0))
      }
      edp_free_names(e = body, bound = edp_names_with(bound = bound, names = names), out = out)
    },
    EMatch(sc, arms) => {
      edp_free_names(e = sc, bound = bound, out = out)
      for arm in arms {
        edp_free_names(e = arm.1, bound = edp_names_with(bound = bound, names = edp_pat_names(arm.0)), out = out)
      }
    },
    EHandle(bd, arms) => {
      edp_free_names(e = bd, bound = bound, out = out)
      for arm in arms {
        edp_free_names(e = arm.1, bound = edp_names_with(bound = bound, names = edp_pat_names(arm.0)), out = out)
      }
    },
    EForIn(n, idx, it, b) => {
      edp_free_names(e = it, bound = bound, out = out)
      let names = [n]
      match idx {
        Some(i) => Array::push(names, value = i),
        None => ()
      }
      edp_free_names(e = b, bound = edp_names_with(bound = bound, names = names), out = out)
    },
    ELoop(pairs, b) => {
      let names: Array[String] = []
      for pair in pairs {
        edp_free_names(e = pair.1, bound = bound, out = out)
        Array::push(names, value = pair.0)
      }
      edp_free_names(e = b, bound = edp_names_with(bound = bound, names = names), out = out)
    },
    EStringInterp(_) => Array::push(out, value = edp_free_names_opaque),
    _ => for child in expr_children(e) {
      edp_free_names(e = child, bound = bound, out = out)
    }
  }
}

fn edp_free_name(n: String, bound: Array[String], out: Array[String]) -> Unit {
  if !edp_str_array_contains(arr = bound, v = n) && !edp_str_array_contains(arr = out, v = n) {
    Array::push(out, value = n)
  } else {
    ()
  }
}

export fn edp_names_with(bound: Array[String], names: Array[String]) -> Array[String] {
  let out: Array[String] = []
  for n in bound {
    Array::push(out, value = n)
  }
  for n in names {
    Array::push(out, value = n)
  }
  out
}
