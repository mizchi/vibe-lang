import @vibe/compiler/core {
  Expr, Stmt, TypeExpr
}

import @vibe/core {
  struct MutMap
}

/// Index definition-table names once for a walk that preserves statement
/// positions. Keep every matching position, in definition-table order: the
/// last entry whose CURRENT statement is a plain function supplies the params.
/// The table's name, rather than the statement's name, is the lookup key,
/// exactly as in `edp_params_of_fn`.
export fn edp_fn_statement_index(fn_defs: Array[(Int, Bool, Bool, String, Option[TypeExpr], String)]) -> MutMap[String, Array[Int]] {
  let index: MutMap[String, Array[Int]] = MutMap::new_string()
  for def in fn_defs {
    let (idx, _, _, name, _, _) = def
    match MutMap::get(index, name) {
      Some(positions) => Array::push(positions, idx),
      None => MutMap::set(index, name, [idx])
    }
  }
  index
}

/// Read live parameters through a walk-local statement index. A later
/// non-function entry must not hide an earlier function of the same name.
/// Do not retain this index across statement insertion, removal or reordering.
export fn edp_indexed_params_of_fn(stmts: Array[Stmt], index: MutMap[String, Array[Int]], nm: String) -> Option[Array[(String, Option[TypeExpr])]] {
  let mut out: Option[Array[(String, Option[TypeExpr])]] = None
  match MutMap::get(index, nm) {
    Some(positions) => {
      let mut i = Array::length(positions)
      let mut found = false
      while i > 0 && !found {
        i = i - 1
        match Array::get(stmts, Array::get(positions, i)) {
          SLet(_, _, _, _, EFn(_, _, params, _, _, _)) => {
            out = Some(params)
            found = true
          },
          _ => ()
        }
      }
    },
    None => ()
  }
  out
}
