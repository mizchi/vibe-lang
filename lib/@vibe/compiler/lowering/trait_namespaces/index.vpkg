name = @vibe/compiler/lowering/trait_namespaces
version = 0.0.1
description =
  #|Trait namespace wrappers and method binders, scoped to an explicit module prefix.
deps = {
  @vibe/ast : 0.2.0
  @vibe/compiler/core : 0.0.1
  @vibe/core : 0.2.0
}

generated_hash =

fn dict_param_name(trait_name: String, tparam: String) -> String
fn collect_method_traits(stmts: Array[Stmt]) -> Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])]
fn inject_trait_method_generics_with_reporting_change(stmts: Array[Stmt], traits: Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], own_end: Int) -> Bool
fn trait_operation_is_derived_binding(stmt: Stmt, operation_name: String, trait_name: String, method_name: String) -> Bool
fn collect_trait_namespace_conflict_errors(stmts: Array[Stmt], env: TypeEnv) -> Array[String]
/// Insert wrappers for [0, own_end) and return the number of added statements.
/// The caller owns the module boundary; dependency statements remain unchanged.
fn derive_trait_namespace_operations(stmts: Array[Stmt], own_end: Int) -> Int
fn derive_imported_trait_namespace_operations(stmts: Array[Stmt], env: TypeEnv) -> Unit
fn inject_trait_method_generics_reporting_change(stmts: Array[Stmt], own_end: Int) -> Bool
fn collect_trait_supers(stmts: Array[Stmt]) -> Array[(String, Array[String])]
fn flatten_traits(traits_raw: Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], supers_map: Array[(String, Array[String])]) -> Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])]
fn flatten_trait_owners(tname: String, traits_raw: Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], supers_map: Array[(String, Array[String])]) -> Array[(String, String)]
fn lookup_trait_sigs(traits: Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], name: String) -> Option[Array[(String, Array[TypeExpr], TypeExpr)]]
fn substitute_constructor_alias_target(target: TypeExpr, params: Array[String], args: Array[TypeExpr]) -> TypeExpr
fn expand_constructor_alias(ret: TypeExpr, stmts: Array[Stmt], fuel: Int) -> TypeExpr
