import @vibe/compiler/core {
  Expr, ImportItem, ImportKind, Stmt, TypeEnv, TypeExpr, __to_string, flatten_trait_sigs_into, lookup_flat_trait_sigs, trait_definition
}

import @vibe/ast {
  impl_method_owner, impl_target_key, trait_ref_from_key, trait_ref_key, trait_ref_name, type_param_name
}

import @vibe/core {
  array_empty
}

fn empty_str_array() -> Array[String] {
  array_empty()
}

fn str_array_contains(arr: Array[String], val: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(arr) {
    if Array::get(arr, at = i) == val {
      found = true
      i = Array::length(arr)
    } else {
      i = i + 1
    }
  }
  found
}

fn split_qualified(_ name: String) -> Option[(String, String)] {
  let idx = String::index_of(name, needle = "::")
  if idx < 0 {
    None
  } else {
    let head = String::substring(name, start = 0, end = idx)
    let member = String::substring(name, start = idx + 2, end = String::length(name))
    Some((head, member))
  }
}

/// The hidden dict parameter name for `[T: Tr]`, e.g. `__dict_Measurable_T`.
export fn dict_param_name(trait_name: String, tparam: String) -> String {
  let applied = match trait_ref_from_key(trait_name) {
    Some(reference) => match reference {
      TyApp(_, _) => String::concat("_", impl_target_key(reference)),
      _ => ""
    },
    None => ""
  }
  String::concat("__dict_", String::concat(trait_ref_name(trait_name), String::concat(applied, String::concat("_", tparam))))
}

/// Collect traits whose flattened signature contains at least one method.
/// A marker-only trait stays inert, while `trait Child: Parent` is retained
/// when `Parent` contributes a method to the child's witness dictionary.
export fn collect_method_traits(_ stmts: Array[Stmt]) -> Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])] {
  let out = array_empty()
  push_method_traits(stmts = stmts, table = out)
  out
}

/// Append to `table` every declared trait it did not already hold whose
/// flattened signature contains a method -- `collect_method_traits`'s rule,
/// with `table`'s own entries joining the declarations as parents.
///
/// #3312: that second source of parents is the builtin `Eq` the lowering
/// injects as a SIGNATURE, with no declaration behind it (#2523). Collected
/// before the injection, a methodless `trait Key: Eq {}` flattened to nothing
/// and was dropped, and appending `Eq` afterwards could not bring it back:
/// `[T: Key]` threaded no witness and `x == y` compared two equal `Double`s
/// raw (`false`). The injection calls this again once `Eq` is in the table.
/// A marker parent contributes no method, so a methodless subtrait of a
/// program's own marker `Eq` stays a marker.
export fn push_method_traits(stmts: Array[Stmt], table: Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])]) -> Unit {
  let declared = collect_namespace_traits(stmts)
  let held = Array::length(table)
  let graph = array_empty()
  let mut g = 0
  while g < held {
    Array::push(graph, value = Array::get(table, at = g))
    g = g + 1
  }
  let mut d = 0
  while d < Array::length(declared) {
    Array::push(graph, value = Array::get(declared, at = d))
    d = d + 1
  }
  let flattened = flatten_traits(traits_raw = graph, supers_map = collect_trait_supers(stmts))
  let mut i = 0
  while i < Array::length(declared) {
    let (trait_name, declared_methods) = Array::get(declared, at = i)
    match lookup_trait_sigs(traits = flattened, name = trait_name) {
      Some(methods) => if Array::length(methods) > 0 && !table_prefix_holds(table = table, limit = held, name = trait_name) {
        Array::push(table, value = (trait_name, declared_methods))
      } else {
        ()
      },
      None => ()
    }
    i = i + 1
  }
}

fn table_prefix_holds(table: Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], limit: Int, name: String) -> Bool {
  let mut i = 0
  let mut found = false
  while !found && i < limit {
    let (tname, _) = Array::get(table, at = i)
    found = tname == trait_ref_name(name)
    i = i + 1
  }
  found
}

/// Collect every declared trait signature. Namespace derivation and dictionary
/// eligibility both need this complete graph to see methods inherited through
/// a subtrait that declares no methods of its own.
fn collect_namespace_traits(_ stmts: Array[Stmt]) -> Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])] {
  let out = array_empty()
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, at = i) {
      STrait(_, trait_name, supers, methods, _, _) => if trait_decl_is_yielding_marker(stmts = stmts, name = trait_name, supers = supers, methods = methods) {
        ()
      } else {
        Array::push(out, value = (trait_name, methods))
      },
      _ => ()
    }
    i = i + 1
  }
  out
}

/// #3636: is this `trait <name>` a pure marker (no methods, no supertraits)
/// that another declaration of the same name in the merged program fills in?
///
/// The tables here are keyed by name and the first declaration wins.
/// `@vibe/builtin` declares a marker `Default` so the bound is satisfiable
/// without `@vibe/core`, where the method-bearing `Default` lives, and a
/// program that imported `@vibe/builtin` first saw `Default` as the marker:
/// `[T: Default]` threaded no witness, and `T::default()` died in codegen as
/// "reached code generation unresolved". The opposite import order compiled
/// and printed `0`. A pure marker declares nothing the fuller declaration
/// lacks, so it yields to it. The checker has already resolved the bound to
/// the method-bearing trait, or the call would not be here.
fn trait_decl_is_yielding_marker(stmts: Array[Stmt], name: String, supers: Array[String], methods: Array[(String, Array[TypeExpr], TypeExpr)]) -> Bool {
  if Array::length(methods) > 0 || Array::length(supers) > 0 {
    false
  } else {
    let mut found = false
    let mut i = 0
    while !found && i < Array::length(stmts) {
      match Array::get(stmts, at = i) {
        STrait(_, other, other_supers, other_methods, _, _) => if other == name && (Array::length(other_methods) > 0 || Array::length(other_supers) > 0) {
          found = true
        } else {
          ()
        },
        _ => ()
      }
      i = i + 1
    }
    found
  }
}

/// Collect every trait's per-method generic binders (name -> [(method,
/// type_params, bounds)]) from STrait's 5th field. Only traits that declare a
/// non-empty binder on at least one method are kept, so this stays inert.
fn collect_trait_method_gens(_ stmts: Array[Stmt]) -> Array[(String, Array[(String, Array[String], Array[(String, Array[String])])])] {
  let out = array_empty()
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, at = i) {
      STrait(_, tname, _, _, method_gens, _) => {
        let mut any = false
        let mut j = 0
        while j < Array::length(method_gens) {
          let (_, tps, _) = Array::get(method_gens, at = j)
          if Array::length(tps) > 0 {
            any = true
          } else {
            ()
          }
          j = j + 1
        }
        if any {
          Array::push(out, value = (tname, method_gens))
        } else {
          ()
        }
      },
      _ => ()
    }
    i = i + 1
  }
  out
}

/// Look up a method's `(type_params, bounds)` in a trait's method-gen table.
/// Returns None when the method has no binder (empty type_params).
fn lookup_method_gen(table: Array[(String, Array[(String, Array[String], Array[(String, Array[String])])])], trait_name: String, method: String) -> Option[(Array[String], Array[(String, Array[String])])] {
  let mut i = 0
  let mut result = None
  while i < Array::length(table) {
    let (tn, gens) = Array::get(table, at = i)
    if tn == trait_ref_name(trait_name) {
      let mut j = 0
      while j < Array::length(gens) {
        let (mname, tps, bounds) = Array::get(gens, at = j)
        if mname == method && Array::length(tps) > 0 {
          result = Some((tps, bounds))
          j = Array::length(gens)
        } else {
          j = j + 1
        }
      }
      i = Array::length(table)
    } else {
      i = i + 1
    }
  }
  result
}

/// Map each impl method owner to the trait it implements. Concrete applied
/// targets have a specialization-specific internal owner; generic and bare
/// targets keep their constructor owner.
fn collect_impl_trait_map(_ stmts: Array[Stmt]) -> Array[(String, String)] {
  let out = array_empty()
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, at = i) {
      SImpl(tparams, _, trait_name, target) => Array::push(out, value = (impl_method_owner(tparams = tparams, trait_name = trait_name, target = target), trait_name)),
      _ => ()
    }
    i = i + 1
  }
  out
}

/// The declared parameter types of method `m` in trait `trait_name` (its 3-tuple
/// signature). Used to annotate the impl method's unannotated params so the
/// per-method type parameter `X` appears as `x: X`.
fn lookup_trait_method_param_types(traits: Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], trait_name: String, method: String) -> Option[Array[TypeExpr]] {
  match lookup_trait_sigs(traits = traits, name = trait_name) {
    Some(sigs) => {
      let mut j = 0
      let mut result = None
      while j < Array::length(sigs) {
        let (mname, ptypes, _) = Array::get(sigs, at = j)
        if mname == method {
          result = Some(ptypes)
          j = Array::length(sigs)
        } else {
          j = j + 1
        }
      }
      result
    },
    None => None
  }
}

/// Find the trait, among those `type_name` implements, that declares a
/// method-level binder for `method`. Returns its (type_params, bounds, param
/// types) so the impl method can be re-typed.
fn find_method_generic_for_impl(impl_map: Array[(String, String)], gen_table: Array[(String, Array[(String, Array[String], Array[(String, Array[String])])])], traits: Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], type_name: String, method: String) -> Option[(Array[String], Array[(String, Array[String])], Array[TypeExpr])] {
  let mut i = 0
  let mut result = None
  while i < Array::length(impl_map) {
    let (tn, trait_name) = Array::get(impl_map, at = i)
    if tn == type_name {
      match lookup_method_gen(table = gen_table, trait_name = trait_name, method = method) {
        Some(g) => {
          let (tps, bounds) = g
          match lookup_trait_method_param_types(traits = traits, trait_name = trait_name, method = method) {
            Some(ptypes) => {
              result = Some((tps, bounds, ptypes))
              i = Array::length(impl_map)
            },
            None => {
              i = i + 1
            }
          }
        },
        None => {
          i = i + 1
        }
      }
    } else {
      i = i + 1
    }
  }
  result
}

/// Annotate each parameter whose annotation is None with the trait method's
/// declared param type (when one exists at that index). Already-annotated params
/// keep their annotation.
fn annotate_params_from_sig(params: Array[(String, Option[TypeExpr])], ptypes: Array[TypeExpr]) -> Array[(String, Option[TypeExpr])] {
  let out = array_empty()
  let mut i = 0
  while i < Array::length(params) {
    let (pname, ann) = Array::get(params, at = i)
    // `__rc_heap` is the planner's heap marker (see seed_var_types below):
    // not an annotation the source wrote, so the trait's declared type
    // still fills the slot -- an impl method's `x` classified heap before
    // this pass ran kept the marker, the binder's `X` never reached it and
    // `X::show(x)` lost its witness (fixtures/trait_method_generic_test.vibe
    // trapped). The declared type carries the heap-ness anyway.
    let unannotated = match ann {
      Some(TyName(tn)) => tn == "__rc_heap",
      Some(_) => false,
      None => true
    }
    let new_ann = if !unannotated {
      ann
    } else if i < Array::length(ptypes) {
      Some(Array::get(ptypes, at = i))
    } else {
      ann
    }
    Array::push(out, value = (pname, new_ann))
    i = i + 1
  }
  out
}

/// The type parameters of the impl whose methods `owner` names, or None when
/// no impl does.
fn impl_tparams_of_owner(stmts: Array[Stmt], owner: String) -> Option[Array[String]] {
  let mut out = None
  let mut i = 0
  while (out is None) && i < Array::length(stmts) {
    match Array::get(stmts, at = i) {
      SImpl(tparams, _, trait_name, target) => if impl_method_owner(tparams = tparams, trait_name = trait_name, target = target) == owner {
        out = Some(tparams)
      } else {
        ()
      },
      _ => ()
    }
    i = i + 1
  }
  out
}

/// Whether an impl method declared no binder of its own: its type parameters
/// are exactly the ones the parser copied from its impl (#3580). A generic
/// impl's method (`impl [E] W for Array[E] { write(self, x) .. }`) carries
/// `[E]`, so testing for none at all skipped it, and `X::render(x)` in its
/// body was `unknown name`. A trait binder that reuses one of the impl's
/// names is left alone: appending it would bind the name twice.
fn impl_method_writes_no_binder(stmts: Array[Stmt], owner: String, tparams: Array[String], method_tparams: Array[String]) -> Bool {
  if Array::length(tparams) == 0 {
    true
  } else match impl_tparams_of_owner(stmts = stmts, owner = owner) {
    Some(impl_tparams) => {
      let mut same = Array::length(impl_tparams) == Array::length(tparams)
      let mut i = 0
      while same && i < Array::length(tparams) {
        same = Array::get(impl_tparams, at = i) == Array::get(tparams, at = i)
        i = i + 1
      }
      same && !Array::any(method_tparams, f = (mtp) -> Array::any(tparams, f = (tp) -> type_param_name(tp) == type_param_name(mtp)))
    },
    None => false
  }
}

/// In-place: for each impl method `C::m` whose trait declares a method-level
/// `[X: Bound]` binder, re-attach the binder to the EFn and annotate its params
/// with the trait method's declared types. Idempotent: an EFn that already
/// carries the binder has more type parameters than its impl, and is skipped.
fn inject_method_generics_reporting_change(stmts: Array[Stmt], impl_map: Array[(String, String)], gen_table: Array[(String, Array[(String, Array[String], Array[(String, Array[String])])])], traits: Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], own_end: Int) -> Bool {
  let mut changed = false
  let mut i = 0
  while i < own_end {
    match Array::get(stmts, at = i) {
      SLet(exp, isrec, qname, ann, body) => match body {
        EFn(tparams, bounds, params, ret, eff, fbody) => {
          match split_qualified(qname) {
            Some(parts) => {
              let (cname, method) = parts
              match find_method_generic_for_impl(impl_map = impl_map, gen_table = gen_table, traits = traits, type_name = cname, method = method) {
                Some(g) => if impl_method_writes_no_binder(stmts = stmts, owner = cname, tparams = tparams, method_tparams = g.0) {
                  let (mtparams, mtbounds, ptypes) = g
                  let new_params = annotate_params_from_sig(params = params, ptypes = ptypes)
                  let new_efn = EFn(Array::concat(tparams, mtparams), Array::concat(bounds, mtbounds), new_params, ret, eff, fbody)
                  Array::set(stmts, at = i, value = SLet(exp, isrec, qname, ann, new_efn))
                  changed = true
                } else {
                  ()
                },
                None => ()
              }
            },
            None => ()
          }
        },
        _ => ()
      },
      _ => ()
    }
    i = i + 1
  }
  changed
}

/// Re-attach trait-method `[X: Bound]` binders to impl free functions, given a
/// (possibly flattened) method-trait table for param-type lookup. Inert and
/// idempotent. Shared by `desugar_trait_dicts` (pre-codegen) and `check_program`
/// (so the FS-compile path, which type-checks before the desugar runs, also sees
/// the binder and can resolve `X::method`).
export fn inject_trait_method_generics_with_reporting_change(stmts: Array[Stmt], traits: Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], own_end: Int) -> Bool {
  assert(own_end >= 0 && own_end <= Array::length(stmts))
  let method_gen_table = collect_trait_method_gens(stmts)
  let injected = if Array::length(method_gen_table) > 0 {
    let impl_map = collect_impl_trait_map(stmts)
    inject_method_generics_reporting_change(stmts = stmts, impl_map = impl_map, gen_table = method_gen_table, traits = traits, own_end = own_end)
  } else {
    false
  }
  // Runs after the method-generic injection, which annotates every parameter
  // of the methods it re-types; this fills what is still unannotated.
  let annotated = annotate_impl_params_from_trait(stmts = stmts, traits = traits, own_end = own_end)
  injected || annotated
}

// ---- #3737: unannotated impl-method parameters ----
//
// `impl Describe for Double { describe(x) -> String { "\{x}" } }` parses to
// `SLet("Double::describe", EFn(.., [(x, None)], ..))`. With no annotation the
// checker generalized the binding over `x`, so every type-directed lowering
// in the body saw a type variable instead of `Double`: the interpolation
// printed the boxed value's address (`f64 300`), and `a < b` on two such
// parameters was refused against an `Int` it had guessed. The trait's
// signature says what each parameter is, `Self` being the impl's target, so
// the parameter is annotated with that before checking.
//
// Only types the impl's own module can spell are written in: `Self` (the
// target, which the impl itself names) and the builtin scalars, through
// `Array` / `Option` / tuples / pure function types. A user type the trait
// names may not be in scope where the impl is, and the checker's own advice
// for that case is to leave the position unannotated. A name the trait or the
// method binds as a type parameter is never written in. Generic impls
// (`impl[T] .. for Box[T]`) are left as they were.

fn impl_param_builtin_scalar(_ name: String) -> Bool {
  name == "Int" || name == "Double" || name == "Float" || name == "String" || name == "Bool" || name == "Char" || name == "Bytes" || name == "Unit"
}

fn impl_param_type_spellable(te: TypeExpr, formals: Array[String]) -> Bool {
  match te {
    TyName(n) => !Array::any(formals, f = (f) -> type_param_name(f) == n) && (n == "Self" || impl_param_builtin_scalar(n)),
    TyApp(head, args) => (head == "Array" || head == "Option") && Array::length(args) == 1 && impl_param_type_spellable(te = Array::get(args, at = 0), formals = formals),
    TyTuple(items) => Array::all(items, f = (t) -> impl_param_type_spellable(te = t, formals = formals)),
    TyFn(ps, r, eff) => eff == None && Array::all(ps, f = (t) -> impl_param_type_spellable(te = t, formals = formals)) && impl_param_type_spellable(te = r, formals = formals),
    TyUnit => true
  }
}

fn impl_param_self_as(te: TypeExpr, target: TypeExpr) -> TypeExpr {
  match te {
    TyName(n) => if n == "Self" {
      target
    } else {
      te
    },
    TyApp(head, args) => TyApp(head, Array::map(args, f = (t) -> impl_param_self_as(te = t, target = target))),
    TyTuple(items) => TyTuple(Array::map(items, f = (t) -> impl_param_self_as(te = t, target = target))),
    TyFn(ps, r, eff) => TyFn(Array::map(ps, f = (t) -> impl_param_self_as(te = t, target = target)), impl_param_self_as(te = r, target = target), eff),
    TyUnit => TyUnit
  }
}

/// The type-parameter names the trait `trait_name` binds, at trait level and
/// on `method`; None when the trait is not declared in `stmts`.
fn impl_param_trait_formals(stmts: Array[Stmt], trait_name: String, method: String) -> Option[Array[String]] {
  let mut out = None
  for s in stmts {
    match s {
      STrait(_, tname, _, _, method_gens, tparams) => if tname == trait_name {
        let names = empty_str_array()
        for tp in tparams {
          Array::push(names, value = tp)
        }
        for g in method_gens {
          let (mname, tps, _) = g
          if mname == method {
            for tp in tps {
              Array::push(names, value = tp)
            }
          } else {
            ()
          }
        }
        out = Some(names)
      } else {
        ()
      },
      _ => ()
    }
  }
  out
}

fn annotate_impl_params_from_trait(stmts: Array[Stmt], traits: Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], own_end: Int) -> Bool {
  let impls: Array[(String, String, TypeExpr)] = []
  for s in stmts {
    match s {
      SImpl(tps, _, tn, target) => if Array::length(tps) == 0 {
        Array::push(impls, value = (impl_method_owner(tparams = tps, trait_name = tn, target = target), tn, target))
      } else {
        ()
      },
      _ => ()
    }
  }
  let mut changed = false
  if Array::length(impls) > 0 {
    let mut i = 0
    while i < own_end {
      match Array::get(stmts, at = i) {
        SLet(exp, isrec, qname, ann, body) => match body {
          EFn(tparams, bounds, params, ret, eff, fbody) => if Array::length(tparams) == 0 {
            match split_qualified(qname) {
              Some(parts) => {
                let (owner, method) = parts
                match impl_param_annotation(stmts = stmts, traits = traits, impls = impls, owner = owner, method = method, params = params) {
                  Some(new_params) => {
                    Array::set(stmts, at = i, value = SLet(exp, isrec, qname, ann, EFn(tparams, bounds, new_params, ret, eff, fbody)))
                    changed = true
                  },
                  None => ()
                }
              },
              None => ()
            }
          } else {
            ()
          },
          _ => ()
        },
        _ => ()
      }
      i = i + 1
    }
  } else {
    ()
  }
  changed
}

/// The params of `owner::method` with each unannotated one the trait spells
/// spellably filled in, or None when nothing changes.
fn impl_param_annotation(stmts: Array[Stmt], traits: Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], impls: Array[(String, String, TypeExpr)], owner: String, method: String, params: Array[(String, Option[TypeExpr])]) -> Option[Array[(String, Option[TypeExpr])]] {
  let mut result = None
  for entry in impls {
    let (o, trait_name, target) = entry
    if o == owner && result == None {
      match lookup_trait_method_param_types(traits = traits, trait_name = trait_name, method = method) {
        Some(ptypes) => match impl_param_trait_formals(stmts = stmts, trait_name = trait_name, method = method) {
          Some(formals) => {
            let out: Array[(String, Option[TypeExpr])] = []
            let mut any = false
            let mut pi = 0
            while pi < Array::length(params) {
              let (pname, pann) = Array::get(params, at = pi)
              let unannotated = match pann {
                Some(TyName(tn)) => tn == "__rc_heap",
                Some(_) => false,
                None => true
              }
              if unannotated && pi < Array::length(ptypes) && impl_param_type_spellable(te = Array::get(ptypes, at = pi), formals = formals) {
                Array::push(out, value = (pname, Some(impl_param_self_as(te = Array::get(ptypes, at = pi), target = target))))
                any = true
              } else {
                Array::push(out, value = (pname, pann))
              }
              pi = pi + 1
            }
            if any {
              result = Some(out)
            } else {
              ()
            }
          },
          None => ()
        },
        None => ()
      }
    } else {
      ()
    }
  }
  result
}

/// Whether a value parameter can carry the witness for `name` through the
/// dictionary lowerer's supported receiver shapes. Keep this aligned with
/// find_recv_index / find_constructor_recv_index / find_array_elem_recv_index:
/// a nested occurrence (for example `(Int) -> Self`) is not recoverable.
fn trait_operation_type_is_carrier(ty: TypeExpr, name: String, stmts: Array[Stmt]) -> Bool {
  let expanded = expand_constructor_alias(ret = ty, stmts = stmts, fuel = Array::length(stmts) + 1)
  match expanded {
    TyName(current) => current == name,
    TyApp(head, args) => if head == name {
      true
    } else if head == "Array" && Array::length(args) == 1 {
      match Array::get(args, at = 0) {
        TyName(current) => current == name,
        _ => false
      }
    } else {
      false
    },
    TyFn(_, _, _) => false,
    TyTuple(_) => false,
    TyUnit => false
  }
}

fn trait_operation_params_have_carrier(params: Array[TypeExpr], name: String, stmts: Array[Stmt]) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(params) && !found {
    found = trait_operation_type_is_carrier(ty = Array::get(params, at = i), name = name, stmts = stmts); i = i + 1
  }
  found
}

fn trait_operation_type_mentions(ty: TypeExpr, name: String) -> Bool {
  match ty {
    TyName(current) => current == name,
    TyApp(head, args) => {
      let mut found = head == name
      let mut i = 0
      while i < Array::length(args) && !found {
        found = trait_operation_type_mentions(ty = Array::get(args, at = i), name = name)
        i = i + 1
      }
      found
    },
    TyFn(params, ret, _) => {
      let mut found = trait_operation_type_mentions(ty = ret, name = name)
      let mut i = 0
      while i < Array::length(params) && !found {
        found = trait_operation_type_mentions(ty = Array::get(params, at = i), name = name)
        i = i + 1
      }
      found
    },
    TyTuple(items) => {
      let mut found = false
      let mut i = 0
      while i < Array::length(items) && !found {
        found = trait_operation_type_mentions(ty = Array::get(items, at = i), name = name)
        i = i + 1
      }
      found
    },
    TyUnit => false
  }
}

fn trait_operation_surface_mentions(params: Array[TypeExpr], ret: TypeExpr, name: String) -> Bool {
  let mut found = trait_operation_type_mentions(ty = ret, name = name)
  let mut i = 0
  while i < Array::length(params) && !found {
    found = trait_operation_type_mentions(ty = Array::get(params, at = i), name = name)
    i = i + 1
  }
  found
}

fn trait_operation_method_shadows(method_params: Array[String], name: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(method_params) && !found {
    found = type_param_name(Array::get(method_params, at = i)) == name
    i = i + 1
  }
  found
}

fn trait_operation_fresh_self_param(base: String, header_params: Array[String], method_params: Array[String]) -> String {
  let mut candidate = base
  let mut suffix = 1
  while trait_operation_method_shadows(method_params = header_params, name = candidate) || trait_operation_method_shadows(method_params = method_params, name = candidate) {
    candidate = String::concat(base, String::concat("_", __to_string(suffix)))
    suffix = suffix + 1
  }
  candidate
}

fn trait_operation_shadows_header(method_params: Array[String], header_params: Array[String]) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(header_params) && !found {
    found = trait_operation_method_shadows(method_params = method_params, name = type_param_name(Array::get(header_params, at = i)))
    i = i + 1
  }
  found
}

fn trait_operation_substitute_self(ty: TypeExpr, replacement: String) -> TypeExpr {
  match ty {
    TyName(name) => if name == "Self" {
      TyName(replacement)
    } else {
      ty
    },
    TyApp(head, args) => TyApp(if head == "Self" {
      replacement
    } else {
      head
    }, for arg in args {
      trait_operation_substitute_self(ty = arg, replacement = replacement)
    }),
    TyFn(params, ret, effect) => TyFn(for param in params {
      trait_operation_substitute_self(ty = param, replacement = replacement)
    }, trait_operation_substitute_self(ty = ret, replacement = replacement), effect),
    TyTuple(items) => TyTuple(for item in items {
      trait_operation_substitute_self(ty = item, replacement = replacement)
    }),
    TyUnit => TyUnit
  }
}

fn trait_operation_binding_exists(stmts: Array[Stmt], name: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(stmts) && !found {
    match Array::get(stmts, at = i) {
      SLet(_, _, current, _, _) => if current == name {
        found = true
      } else {
        ()
      },
      SFnDecl(_, current, _, _, _) => if current == name {
        found = true
      } else {
        ()
      },
      _ => ()
    }
    i = i + 1
  }
  found
}

fn trait_operation_forwarding_args(params: Array[(String, Option[TypeExpr])], args: Array[Expr]) -> Bool {
  if Array::length(params) != Array::length(args) {
    false
  } else {
    let mut i = 0
    let mut same = true
    while i < Array::length(params) && same {
      let (param_name, _) = Array::get(params, at = i)
      match Array::get(args, at = i) {
        EIdent(arg_name, _) => if arg_name != param_name {
          same = false
        } else {
          ()
        },
        _ => {
          same = false
        }
      }
      i = i + 1
    }
    same
  }
}

fn trait_operation_desugared_forwarding_args(params: Array[(String, Option[TypeExpr])], args: Array[Expr]) -> Bool {
  if Array::length(params) != Array::length(args) + 1 {
    false
  } else {
    let mut i = 0
    let mut same = true
    while i < Array::length(args) && same {
      let (param_name, _) = Array::get(params, at = i + 1)
      match Array::get(args, at = i) {
        EIdent(arg_name, _) => if arg_name != param_name {
          same = false
        } else {
          ()
        },
        _ => {
          same = false
        }
      }
      i = i + 1
    }
    same
  }
}

fn trait_operation_forwarding_bound(bounds: Array[(String, Array[String])], callee: String, trait_name: String, method_name: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(bounds) && !found {
    let (param, refs) = Array::get(bounds, at = i)
    if callee == String::concat(type_param_name(param), String::concat("::", method_name)) {
      let mut ri = 0
      while ri < Array::length(refs) && !found {
        found = trait_ref_name(Array::get(refs, at = ri)) == trait_name
        ri = ri + 1
      }
    } else {
      ()
    }
    i = i + 1
  }
  found
}

fn trait_operation_desugared_forwarding_bound(bounds: Array[(String, Array[String])], dict_name: String, trait_name: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(bounds) && !found {
    let (param, refs) = Array::get(bounds, at = i)
    if dict_name == dict_param_name(trait_name = trait_name, tparam = type_param_name(param)) {
      let mut ri = 0
      while ri < Array::length(refs) && !found {
        found = trait_ref_name(Array::get(refs, at = ri)) == trait_name
        ri = ri + 1
      }
    } else {
      ()
    }
    i = i + 1
  }
  found
}

/// The offset every node of a synthesized `Trait::op` wrapper carries.
/// Negative, so every offset-keyed table filters it out like the parser's
/// own synthesized nodes, and distinct from the parser's -1 (interpolation,
/// indexing, `assert`, and a call in a `fn` declaration's body), so a
/// binding read from source can never pass for a generated one (#2357's
/// masquerade checks). Before #2388 slice 2b the wrapper's nodes carried
/// `2000000000 - i * 1000 - mi * 10`, which made a module's wrapper depend
/// on the trait's statement index.
fn trait_operation_synthetic_off() -> Int {
  0 - 2
}

/// Whether a `Trait::op` binding's call node was synthesized by
/// `derive_trait_namespace_operations` (see trait_operation_synthetic_off).
fn trait_operation_has_generated_offset(_ offset: Int) -> Bool {
  offset == trait_operation_synthetic_off()
}

fn trait_operation_type_option_equal(left: Option[TypeExpr], right: Option[TypeExpr]) -> Bool {
  match (left, right) {
    (Some(a), Some(b)) => impl_target_key(a) == impl_target_key(b),
    (None, None) => true,
    _ => false
  }
}

fn trait_operation_string_option_equal(left: Option[String], right: Option[String]) -> Bool {
  match (left, right) {
    (Some(a), Some(b)) => a == b,
    (None, None) => true,
    _ => false
  }
}

fn trait_operation_bounds_equal(left: Array[(String, Array[String])], right: Array[(String, Array[String])]) -> Bool {
  if Array::length(left) != Array::length(right) {
    false
  } else {
    let mut i = 0
    let mut same = true
    while i < Array::length(left) && same {
      let (left_name, left_refs) = Array::get(left, at = i)
      let (right_name, right_refs) = Array::get(right, at = i)
      same = left_name == right_name && str_arrays_equal(a = left_refs, b = right_refs)
      i = i + 1
    }
    same
  }
}

fn trait_operation_params_equal(left: Array[(String, Option[TypeExpr])], right: Array[(String, Option[TypeExpr])]) -> Bool {
  if Array::length(left) != Array::length(right) {
    false
  } else {
    let mut i = 0
    let mut same = true
    while i < Array::length(left) && same {
      let (left_name, left_type) = Array::get(left, at = i)
      let (right_name, right_type) = Array::get(right, at = i)
      same = left_name == right_name && trait_operation_type_option_equal(left = left_type, right = right_type)
      i = i + 1
    }
    same
  }
}

fn trait_operation_call_equal(left: Expr, right: Expr) -> Bool {
  match (left, right) {
    (ECall(EIdent(left_callee, _), left_args, _, _), ECall(EIdent(right_callee, _), right_args, _, _)) => left_callee == right_callee && {
      if Array::length(left_args) != Array::length(right_args) {
        false
      } else {
        let mut i = 0
        let mut same = true
        while i < Array::length(left_args) && same {
          match (Array::get(left_args, at = i), Array::get(right_args, at = i)) {
            (EIdent(left_name, _), EIdent(right_name, _)) => {
              same = left_name == right_name
            },
            _ => {
              same = false
            }
          }
          i = i + 1
        }
        same
      }
    },
    _ => false
  }
}

fn trait_operation_matches_expected_binding(stmt: Stmt, expected: Option[Stmt]) -> Bool {
  match expected {
    Some(SLet(expected_exported, true, expected_name, None, EFn(expected_type_params, expected_bounds, expected_params, expected_ret, expected_effect, expected_body))) => match stmt {
      SLet(exported, true, name, None, EFn(type_params, bounds, params, ret, effect, body)) => exported == expected_exported && name == expected_name && str_arrays_equal(a = type_params, b = expected_type_params) && trait_operation_bounds_equal(left = bounds, right = expected_bounds) && trait_operation_params_equal(left = params, right = expected_params) && trait_operation_type_option_equal(left = ret, right = expected_ret) && trait_operation_string_option_equal(left = effect, right = expected_effect) && trait_operation_call_equal(left = body, right = expected_body),
      _ => false
    },
    _ => false
  }
}

export fn trait_operation_is_derived_binding(stmt: Stmt, operation_name: String, trait_name: String, method_name: String) -> Bool {
  match stmt {
    SLet(_, true, name, None, EFn(_, bounds, params, _, _, ECall(EIdent(callee, _), args, call_off, _))) => name == operation_name && trait_operation_has_generated_offset(call_off) && trait_operation_forwarding_bound(bounds = bounds, callee = callee, trait_name = trait_name, method_name = method_name) && trait_operation_forwarding_args(params = params, args = args),
    SLet(_, true, name, None, EFn(_, bounds, params, _, _, ECall(EDot(EIdent(dict_name, _), called_method, _, _), args, call_off, _))) => name == operation_name && trait_operation_has_generated_offset(call_off) && called_method == method_name && Array::length(params) > 0 && {
      let (first_name, _) = Array::get(params, at = 0)
      first_name == dict_name && trait_operation_desugared_forwarding_bound(bounds = bounds, dict_name = dict_name, trait_name = trait_name) && trait_operation_desugared_forwarding_args(params = params, args = args)
    },
    _ => false
  }
}

fn expected_trait_operation_binding(definition_stmts: Array[Stmt], operation_name: String) -> Option[Stmt] {
  let probe = array_empty()
  let mut i = 0
  while i < Array::length(definition_stmts) {
    match Array::get(definition_stmts, at = i) {
      SLet(_, _, name, _, _) => if name == operation_name {
        ()
      } else {
        Array::push(probe, value = Array::get(definition_stmts, at = i))
      },
      SFnDecl(_, name, _, _, _) => if name == operation_name {
        ()
      } else {
        Array::push(probe, value = Array::get(definition_stmts, at = i))
      },
      _ => Array::push(probe, value = Array::get(definition_stmts, at = i))
    }
    i = i + 1
  }
  let _added = derive_trait_namespace_operations(stmts = probe, own_end = Array::length(probe))
  let mut found = None
  let mut done = false
  i = 0
  while i < Array::length(probe) && !done {
    match Array::get(probe, at = i) {
      SLet(_, _, name, _, _) => if name == operation_name {
        found = Some(Array::get(probe, at = i))
        done = true
      } else {
        ()
      },
      _ => ()
    }
    i = i + 1
  }
  found
}

fn trait_operation_manual_binding_exists(stmts: Array[Stmt], operation_name: String, trait_name: String, method_name: String, expected: Option[Stmt]) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(stmts) && !found {
    let stmt = Array::get(stmts, at = i)
    match stmt {
      SLet(_, _, name, _, _) => if name == operation_name && !trait_operation_is_derived_binding(stmt = stmt, operation_name = operation_name, trait_name = trait_name, method_name = method_name) && !trait_operation_matches_expected_binding(stmt = stmt, expected = expected) {
        found = true
      } else {
        ()
      },
      SLetMut(name, _, _) => if name == operation_name {
        found = true
      } else {
        ()
      },
      SExternLet(name, _) => if name == operation_name {
        found = true
      } else {
        ()
      },
      SFnDecl(_, name, _, _, _) => if name == operation_name {
        found = true
      } else {
        ()
      },
      _ => ()
    }
    i = i + 1
  }
  found
}

fn trait_namespace_conflict_note(trait_name: String, method_name: String, stmts: Array[Stmt], definition_stmts: Array[Stmt], errors: Array[String]) -> Unit {
  let operation_name = String::concat(trait_name, String::concat("::", method_name))
  let expected = expected_trait_operation_binding(definition_stmts = definition_stmts, operation_name = operation_name)
  if trait_operation_manual_binding_exists(stmts = stmts, operation_name = operation_name, trait_name = trait_name, method_name = method_name, expected = expected) {
    let message = String::concat("remove declaration `", String::concat(operation_name, String::concat("`: trait operations are generated from `trait ", String::concat(trait_name, "`"))))
    if !str_array_contains(arr = errors, val = message) {
      Array::push(errors, value = message)
    } else {
      ()
    }
  } else {
    ()
  }
}

fn append_imported_trait_probe(env: TypeEnv, lookup_name: String, local_name: String, seen: Array[String], probe: Array[Stmt]) -> Unit {
  if str_array_contains(arr = seen, val = local_name) {
    ()
  } else {
    match trait_definition(env = env, name = lookup_name) {
      Some((supers, methods, params, method_gens)) => {
        Array::push(seen, value = local_name)
        let mut si = 0
        while si < Array::length(supers) {
          let super_name = trait_ref_name(Array::get(supers, at = si))
          append_imported_trait_probe(env = env, lookup_name = super_name, local_name = super_name, seen = seen, probe = probe)
          si = si + 1
        }
        Array::push(probe, value = STrait(false, local_name, supers, methods, method_gens, params))
      },
      None => ()
    }
  }
}

fn imported_trait_probe(env: TypeEnv, local_name: String) -> Array[Stmt] {
  let probe = array_empty()
  append_imported_trait_probe(env = env, lookup_name = local_name, local_name = local_name, seen = empty_str_array(), probe = probe)
  probe
}

fn import_item_is_explicit_trait(_ item: ImportItem) -> Bool {
  match item.kind {
    Some(ImportTrait) => true,
    _ => false
  }
}

fn imported_trait_namespace_conflict_notes(items: Array[ImportItem], env: TypeEnv, stmts: Array[Stmt], errors: Array[String]) -> Unit {
  let mut i = 0
  while i < Array::length(items) {
    let item = Array::get(items, at = i)
    if import_item_is_explicit_trait(item) {
      let local_name = match item.alias {
        Some(alias) => alias,
        None => item.name
      }
      let probe = imported_trait_probe(env = env, local_name = local_name)
      let traits_raw = collect_namespace_traits(probe)
      let traits = flatten_traits(traits_raw = traits_raw, supers_map = collect_trait_supers(probe))
      match lookup_trait_sigs(traits = traits, name = local_name) {
        Some(methods) => {
          let mut mi = 0
          while mi < Array::length(methods) {
            let (method_name, _, _) = Array::get(methods, at = mi)
            trait_namespace_conflict_note(trait_name = local_name, method_name = method_name, stmts = stmts, definition_stmts = probe, errors = errors)
            mi = mi + 1
          }
        },
        None => ()
      }
    } else {
      ()
    }
    i = i + 1
  }
}

/// Reject source declarations that would replace a generated
/// `Trait::operation`. The generated wrapper is the trait declaration's public
/// contract, so silently preferring a hand-written value would bypass witness
/// selection and can return a different result from the selected impl (#2357).
export fn collect_trait_namespace_conflict_errors(stmts: Array[Stmt], env: TypeEnv) -> Array[String] {
  let errors = array_empty()
  let traits_raw = collect_namespace_traits(stmts)
  let supers_map = collect_trait_supers(stmts)
  let traits = flatten_traits(traits_raw = traits_raw, supers_map = supers_map)
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, at = i) {
      STrait(_, trait_name, _, declared_methods, _, _) => {
        let methods = match lookup_trait_sigs(traits = traits, name = trait_name) {
          Some(flattened) => flattened,
          None => declared_methods
        }
        let mut mi = 0
        while mi < Array::length(methods) {
          let (method_name, _, _) = Array::get(methods, at = mi)
          trait_namespace_conflict_note(trait_name = trait_name, method_name = method_name, stmts = stmts, definition_stmts = stmts, errors = errors)
          mi = mi + 1
        }
      },
      SImport(_, items) => imported_trait_namespace_conflict_notes(items = items, env = env, stmts = stmts, errors = errors),
      SReExport(_, items) => imported_trait_namespace_conflict_notes(items = items, env = env, stmts = stmts, errors = errors),
      SModule(_, _, body) => {
        let nested = collect_trait_namespace_conflict_errors(stmts = body, env = env)
        let mut ni = 0
        while ni < Array::length(nested) {
          let message = Array::get(nested, at = ni)
          if !str_array_contains(arr = errors, val = message) {
            Array::push(errors, value = message)
          } else {
            ()
          }
          ni = ni + 1
        }
      },
      _ => ()
    }
    i = i + 1
  }
  errors
}

fn trait_operation_dict_already_materialized(stmts: Array[Stmt], trait_name: String) -> Bool {
  let dict_name = String::concat(trait_name, "Dict")
  let mut i = 0
  let mut found = false
  while i < Array::length(stmts) && !found {
    match Array::get(stmts, at = i) {
      SStruct(_, name, _, _, _, _) => if name == dict_name {
        found = true
      } else {
        ()
      },
      _ => ()
    }
    i = i + 1
  }
  found
}

fn trait_operation_method_generics(method_gens: Array[(String, Array[String], Array[(String, Array[String])])], method_index: Int, method_name: String) -> (Array[String], Array[(String, Array[String])]) {
  if method_index < Array::length(method_gens) {
    let (source_name, params, bounds) = Array::get(method_gens, at = method_index)
    if source_name == method_name {
      (params, bounds)
    } else {
      (array_empty(), array_empty())
    }
  } else {
    (array_empty(), array_empty())
  }
}

fn trait_operation_bound_key(trait_name: String, header_params: Array[String]) -> String {
  if Array::length(header_params) == 0 {
    trait_ref_key(TyName(trait_name))
  } else {
    trait_ref_key(TyApp(trait_name, for param in header_params {
      TyName(type_param_name(param))
    }))
  }
}

fn trait_operation_param_name(ty: TypeExpr, index: Int, dispatch: String) -> String {
  if index == 0 {
    match ty {
      TyName(name) => if name == dispatch {
        "self"
      } else {
        "arg_0"
      },
      TyApp(head, _) => if head == dispatch {
        "xs"
      } else {
        "arg_0"
      },
      _ => "arg_0"
    }
  } else match ty {
    TyFn(_, _, _) => String::concat("f_", __to_string(index)),
    _ => String::concat("arg_", __to_string(index))
  }
}

/// Derive public `Trait::operation` wrappers without introducing bare names.
export fn derive_trait_namespace_operations(stmts: Array[Stmt], own_end: Int) -> Int {
  assert(own_end >= 0 && own_end <= Array::length(stmts))
  let additions = array_empty()
  // #2388: only the module's own traits get operations; the context (if any)
  // sits after `original_len` and is carried through the reorder untouched.
  let original_len = own_end
  let total = Array::length(stmts)
  let traits_raw = collect_namespace_traits(stmts)
  let supers_map = collect_trait_supers(stmts)
  let traits = flatten_traits(traits_raw = traits_raw, supers_map = supers_map)
  let method_gen_table = collect_trait_method_gens(stmts)
  let mut i = 0
  while i < original_len {
    match Array::get(stmts, at = i) {
      STrait(exported, trait_name, _, declared_methods, method_gens, header_params) => {
        let methods = match lookup_trait_sigs(traits = traits, name = trait_name) {
          Some(flattened) => flattened,
          None => declared_methods
        }
        let owners = flatten_trait_owners(tname = trait_name, traits_raw = traits_raw, supers_map = supers_map)
        let mut mi = 0
        while mi < Array::length(methods) {
          let (method_name, raw_params, raw_ret) = Array::get(methods, at = mi)
          let operation_name = String::concat(trait_name, String::concat("::", method_name))
          if !trait_operation_binding_exists(stmts = stmts, name = operation_name) && !trait_operation_dict_already_materialized(stmts = stmts, trait_name = trait_name) {
            let owner = lookup_str_pair(pairs = owners, key = method_name, fallback = trait_name)
            let (method_params, method_bounds) = match lookup_method_gen(table = method_gen_table, trait_name = owner, method = method_name) {
              Some(generics) => generics,
              None => trait_operation_method_generics(method_gens = method_gens, method_index = mi, method_name = method_name)
            }
            let self_param = trait_operation_fresh_self_param(base = String::concat("__trait_operation_self_", String::concat(trait_name, String::concat("_", method_name))), header_params = header_params, method_params = method_params)
            let shadows_header = trait_operation_shadows_header(method_params = method_params, header_params = header_params)
            let uses_self = !shadows_header && trait_operation_params_have_carrier(params = raw_params, name = "Self", stmts = stmts)
            let surface_mentions_self = trait_operation_surface_mentions(params = raw_params, ret = raw_ret, name = "Self")
            let mut dispatch = if uses_self {
              self_param
            } else {
              ""
            }
            let mut dispatch_key = dispatch
            let mut hi = 0
            // A trait parameter can dispatch an operation whose entire surface
            // is independent of the implementation target (`Mappable::map`).
            // It must never stand in for `Self`: `impl Factory[Int] for Box`
            // does not make `Int` the receiver of `Factory::build`.
            while hi < Array::length(header_params) && dispatch == "" && !shadows_header && !surface_mentions_self {
              let candidate_key = Array::get(header_params, at = hi)
              let candidate = type_param_name(candidate_key)
              if trait_operation_params_have_carrier(params = raw_params, name = candidate, stmts = stmts) {
                dispatch = candidate; dispatch_key = candidate_key
              } else {
                ()
              }
              hi = hi + 1
            }
            if dispatch != "" {
              // The wrapper's nodes are synthesized, not read from a source
              // position: they carry trait_operation_synthetic_off, which
              // every offset-keyed table filters out (negative). #2388: a
              // value derived from the trait's statement index made a
              // module's wrapper depend on its position in the program (and
              // on the lane: the checker derives per module, codegen on the
              // merged program), and the checker lane's Double call row at
              // that offset could alias a different merged wrapper's call.
              let synthetic_off = trait_operation_synthetic_off()
              let extra_params = if uses_self {
                [self_param]
              } else {
                array_empty()
              }
              let type_params = Array::concat(Array::concat(header_params, method_params), extra_params)
              let bounds = Array::concat(method_bounds, [
                (dispatch_key, [
                  trait_operation_bound_key(trait_name = trait_name, header_params = header_params)
                ])
              ])
              let value_params = array_empty()
              let call_args = array_empty()
              let mut pi = 0
              while pi < Array::length(raw_params) {
                let param_ty = trait_operation_substitute_self(ty = Array::get(raw_params, at = pi), replacement = dispatch)
                let param_name = trait_operation_param_name(ty = param_ty, index = pi, dispatch = dispatch)
                Array::push(value_params, value = (param_name, Some(param_ty)))
                Array::push(call_args, value = EIdent(param_name, synthetic_off))
                pi = pi + 1
              }
              let ret = trait_operation_substitute_self(ty = raw_ret, replacement = dispatch)
              let body = ECall(EIdent(String::concat(dispatch, String::concat("::", method_name)), synthetic_off), call_args, synthetic_off, [
              ])
              Array::push(additions, value = SLet(exported, true, operation_name, None, EFn(type_params, bounds, value_params, Some(ret), None, body)))
            } else {
              ()
            }
          } else {
            ()
          }
          mi = mi + 1
        }
      },
      _ => ()
    }
    i = i + 1
  }
  // Right after the last trait/impl, and NOT one statement further.
  //
  // #2570: this used to skip forward over the run of `SLet`/`SFnDecl` that
  // follows, which put every wrapper BELOW the module's top-level functions.
  // A `Trait::op(..)` inside a `fn` body was then a forward reference, and the
  // checker's forward-reference hoist pre-binds a value whose EFn carries type
  // parameters as `CtUnknown` -- every wrapper carries a `Self`-dispatch type
  // parameter, so every wrapper hoisted as `CtUnknown`, which unifies with
  // anything. Measured: result type, argument types and arity were all
  // unchecked, `let z: String = Num::zero(p)` on a `-> Double` operation
  // compiled and printed the Double's bits as a string, and the identical line
  // inside a `test` body -- which sits below the old insertion point -- was
  // correctly rejected. Inserting here makes the call an ordinary backward
  // reference, so the wrapper's own statement has already bound its real type.
  let mut insertion = 0
  let mut si = 0
  while si < original_len {
    match Array::get(stmts, at = si) {
      STrait(_, _, _, _, _, _) => {
        insertion = si + 1
      },
      SImpl(_, _, _, _) => {
        insertion = si + 1
      },
      _ => ()
    }
    si = si + 1
  }
  let ordered = array_empty()
  si = 0
  while si < original_len {
    if si == insertion {
      let mut ai = 0; while ai < Array::length(additions) {
        Array::push(ordered, value = Array::get(additions, at = ai)); ai = ai + 1
      }
    } else {
      ()
    }
    Array::push(ordered, value = Array::get(stmts, at = si))
    si = si + 1
  }
  if insertion == original_len {
    let mut ai = 0; while ai < Array::length(additions) {
      Array::push(ordered, value = Array::get(additions, at = ai)); ai = ai + 1
    }
  } else {
    ()
  }
  let mut ti = original_len
  while ti < total {
    Array::push(ordered, value = Array::get(stmts, at = ti))
    ti = ti + 1
  }
  let mut oi = 0
  while oi < Array::length(ordered) {
    if oi < total {
      Array::set(stmts, at = oi, value = Array::get(ordered, at = oi))
    } else {
      Array::push(stmts, value = Array::get(ordered, at = oi))
    }; oi = oi + 1
  }
  Array::length(additions)
}

fn imported_trait_operation_additions(items: Array[ImportItem], env: TypeEnv, stmts: Array[Stmt], additions: Array[Stmt]) -> Unit {
  let mut i = 0
  while i < Array::length(items) {
    let item = Array::get(items, at = i)
    if import_item_is_explicit_trait(item) {
      let local_name = match item.alias {
        Some(alias) => alias,
        None => item.name
      }
      let probe = imported_trait_probe(env = env, local_name = local_name)
      if Array::length(probe) > 0 {
        let original_probe_len = Array::length(probe)
        {
          let _added = derive_trait_namespace_operations(stmts = probe, own_end = Array::length(probe))
          let mut pi = original_probe_len
          while pi < Array::length(probe) {
            match Array::get(probe, at = pi) {
              SLet(_, _, operation_name, _, _) => match split_qualified(operation_name) {
                Some(parts) => {
                  let (operation_trait, _) = parts
                  if operation_trait == local_name && !trait_operation_binding_exists(stmts = stmts, name = operation_name) && !trait_operation_binding_exists(stmts = additions, name = operation_name) {
                    Array::push(additions, value = Array::get(probe, at = pi))
                  } else {
                    ()
                  }
                },
                None => ()
              },
              _ => ()
            }
            pi = pi + 1
          }
        }
      } else {
        ()
      }
    } else {
      ()
    }
    i = i + 1
  }
}

/// Materialize non-exported `Trait::operation` wrappers from the trait
/// declarations selected by this module's imports. The trait is the authority:
/// callers import only `trait Trait`, while bare operation names stay absent.
export fn derive_imported_trait_namespace_operations(stmts: Array[Stmt], env: TypeEnv) -> Unit {
  let additions = array_empty()
  let original_len = Array::length(stmts)
  let mut i = 0
  while i < original_len {
    match Array::get(stmts, at = i) {
      SImport(_, items) => imported_trait_operation_additions(items = items, env = env, stmts = stmts, additions = additions),
      SReExport(_, items) => imported_trait_operation_additions(items = items, env = env, stmts = stmts, additions = additions),
      SModule(_, _, body) => derive_imported_trait_namespace_operations(stmts = body, env = env),
      _ => ()
    }
    i = i + 1
  }
  let ordered = array_empty()
  let mut ai = 0
  while ai < Array::length(additions) {
    Array::push(ordered, value = Array::get(additions, at = ai))
    ai = ai + 1
  }
  i = 0
  while i < original_len {
    Array::push(ordered, value = Array::get(stmts, at = i))
    i = i + 1
  }
  i = 0
  while i < Array::length(ordered) {
    if i < original_len {
      Array::set(stmts, at = i, value = Array::get(ordered, at = i))
    } else {
      Array::push(stmts, value = Array::get(ordered, at = i))
    }
    i = i + 1
  }
}

/// Self-contained entry for callers that have not flattened the trait table
/// (the checker). Builds its own (flattened) method-trait table from `stmts`.
export fn inject_trait_method_generics_reporting_change(stmts: Array[Stmt], own_end: Int) -> Bool {
  assert(own_end >= 0 && own_end <= Array::length(stmts))
  let traits_raw = collect_method_traits(stmts)
  let supers_map = collect_trait_supers(stmts)
  let traits = flatten_traits(traits_raw = traits_raw, supers_map = supers_map)
  inject_trait_method_generics_with_reporting_change(stmts = stmts, traits = traits, own_end = own_end)
}

/// Collect each trait's declared supertraits (`trait B: A + ...`), for all
/// traits (method-bearing or not), so a method-bearing trait can inherit its
/// supertraits' methods.
export fn collect_trait_supers(_ stmts: Array[Stmt]) -> Array[(String, Array[String])] {
  let out = array_empty()
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, at = i) {
      // #3636: the same yielding rule as `collect_namespace_traits`.
      STrait(_, tname, supers, methods, _, _) => if trait_decl_is_yielding_marker(stmts = stmts, name = tname, supers = supers, methods = methods) {
        ()
      } else {
        Array::push(out, value = (tname, supers))
      },
      _ => ()
    }
    i = i + 1
  }
  out
}

/// Produce a method-trait table whose signatures are flattened across
/// supertraits, so all downstream code (dict struct, dispatch names, witness
/// materialization) sees one flat method set per trait.
export fn flatten_traits(traits_raw: Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], supers_map: Array[(String, Array[String])]) -> Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])] {
  let out = array_empty()
  let mut i = 0
  while i < Array::length(traits_raw) {
    let (tname, _) = Array::get(traits_raw, at = i)
    let acc_names = empty_str_array()
    let flat = array_empty()
    flatten_trait_sigs_into(tname = tname, traits_raw = traits_raw, supers_map = supers_map, acc_names = acc_names, out = flat, owners = array_empty(), visiting = empty_str_array())
    Array::push(out, value = (tname, flat))
    i = i + 1
  }
  out
}

fn lookup_str_pair(pairs: Array[(String, String)], key: String, fallback: String) -> String {
  let mut i = 0
  let mut found = fallback
  while i < Array::length(pairs) {
    let (k, v) = Array::get(pairs, at = i)
    if k == key {
      found = v
      i = Array::length(pairs)
    } else {
      i = i + 1
    }
  }
  found
}

/// Which trait DECLARES each method of `tname`'s flattened set.
///
/// Not a second implementation of the flattening rule: it runs
/// `flatten_trait_sigs_into`, the same recursion `flatten_traits` runs, and
/// reads the owner list it fills. A mirror of the rule would drift the first
/// time an override or a diamond changed which declaration wins.
export fn flatten_trait_owners(tname: String, traits_raw: Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], supers_map: Array[(String, Array[String])]) -> Array[(String, String)] {
  let owners = array_empty()
  flatten_trait_sigs_into(tname = tname, traits_raw = traits_raw, supers_map = supers_map, acc_names = empty_str_array(), out = array_empty(), owners = owners, visiting = empty_str_array())
  owners
}

export fn lookup_trait_sigs(traits: Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], name: String) -> Option[Array[(String, Array[TypeExpr], TypeExpr)]] {
  lookup_flat_trait_sigs(traits = traits, name = name)
}

fn constructor_alias_arg(params: Array[String], args: Array[TypeExpr], name: String) -> Option[TypeExpr] {
  let mut i = 0
  let mut result = None
  while i < Array::length(params) && i < Array::length(args) {
    if type_param_name(Array::get(params, at = i)) == name {
      result = Some(Array::get(args, at = i))
      i = Array::length(params)
    } else {
      i = i + 1
    }
  }
  result
}

export fn substitute_constructor_alias_target(target: TypeExpr, params: Array[String], args: Array[TypeExpr]) -> TypeExpr {
  match target {
    TyName(name) => match constructor_alias_arg(params = params, args = args, name = name) {
      Some(arg) => arg,
      None => target
    },
    TyApp(head, items) => {
      let substituted_items = for item in items {
        substitute_constructor_alias_target(target = item, params = params, args = args)
      }
      match constructor_alias_arg(params = params, args = args, name = head) {
        Some(TyName(actual_head)) => TyApp(actual_head, substituted_items),
        _ => TyApp(head, substituted_items)
      }
    },
    TyFn(fn_params, result, effect) => TyFn(for param in fn_params {
      substitute_constructor_alias_target(target = param, params = params, args = args)
    }, substitute_constructor_alias_target(target = result, params = params, args = args), effect),
    TyTuple(items) => TyTuple(for item in items {
      substitute_constructor_alias_target(target = item, params = params, args = args)
    }),
    TyUnit => target
  }
}

/// Expand aliases until a constructor-bearing parameter or result exposes its
/// outer constructor. The fuel bound makes cyclic aliases fail closed.
export fn expand_constructor_alias(ret: TypeExpr, stmts: Array[Stmt], fuel: Int) -> TypeExpr {
  if fuel <= 0 {
    ret
  } else match ret {
    TyName(head) => {
      let mut i = 0
      let mut result = ret
      let mut found = false
      while i < Array::length(stmts) {
        match Array::get(stmts, at = i) {
          STypeAlias(_, name, params, target) => if !found && name == head && Array::length(params) == 0 {
            result = expand_constructor_alias(ret = target, stmts = stmts, fuel = fuel - 1)
            found = true
          } else {
            ()
          },
          _ => ()
        }
        i = i + 1
      }
      result
    },
    TyApp(head, args) => {
      let mut i = 0
      let mut result = ret
      let mut found = false
      while i < Array::length(stmts) {
        match Array::get(stmts, at = i) {
          STypeAlias(_, name, params, target) => if !found && name == head && Array::length(params) == Array::length(args) {
            let expanded = substitute_constructor_alias_target(target = target, params = params, args = args)
            result = expand_constructor_alias(ret = expanded, stmts = stmts, fuel = fuel - 1)
            found = true
          } else {
            ()
          },
          _ => ()
        }
        i = i + 1
      }
      result
    },
    _ => ret
  }
}

fn str_arrays_equal(a: Array[String], b: Array[String]) -> Bool {
  if Array::length(a) != Array::length(b) {
    false
  } else {
    let mut i = 0
    let mut same = true
    while i < Array::length(a) {
      if Array::get(a, at = i) != Array::get(b, at = i) {
        same = false
      } else {
        ()
      }
      i = i + 1
    }
    same
  }
}
