//# Strict checked expression leaf-payload direct-return artifact v1

import @vibe/compiler/checker {
  check_program_direct_expression_return_observation, check_program_with_env_direct_expression_return_observation
}

import @vibe/compiler/checker/artifacts {
  CheckedExpressionLeafPayloadDirectReturnArtifact,
  canonical_checked_expression_leaf_payload_direct_return_artifact_snapshot,
  checked_expression_leaf_payload_direct_return_artifact_expression_path_at,
  checked_expression_leaf_payload_direct_return_artifact_from_observation,
  checked_expression_leaf_payload_direct_return_artifact_kind_at,
  checked_expression_leaf_payload_direct_return_artifact_payload_at,
  checked_expression_leaf_payload_direct_return_artifact_row_count,
  checked_expression_leaf_payload_direct_return_artifact_statement_path_at,
  checked_expression_leaf_payload_direct_return_artifact_type_at,
  decode_checked_expression_leaf_payload_direct_return_artifact_v1,
  encode_checked_expression_leaf_payload_direct_return_artifact_v1
}

import @vibe/compiler/core {
  Expr, Pat, Stmt, Type, TypeEnv, TypeExpr, env_bind
}

import @vibe/core {
  array_empty
}

fn leaf_payload_assert_path(actual: Option[Array[Int]], expected: Array[Int]) -> Unit {
  match actual {
    Some(path) => {
      assert(Array::length(path) == Array::length(expected))
      let mut i = 0
      while i < Array::length(path) {
        assert(Array::get(path, at = i) == Array::get(expected, at = i))
        i = i + 1
      }
    },
    None => assert(false)
  }
}

fn leaf_payload_assert_text(actual: Option[String], expected: String) -> Unit {
  match actual {
    Some(text) => assert(text == expected),
    None => assert(false)
  }
}

fn leaf_payload_assert_row(artifact: CheckedExpressionLeafPayloadDirectReturnArtifact, row: Int, statement_path: Array[Int], expression_path: Array[Int], kind: String, payload: String, ty: String) -> Unit {
  leaf_payload_assert_path(actual = checked_expression_leaf_payload_direct_return_artifact_statement_path_at(artifact = artifact, row_index = row), expected = statement_path)
  leaf_payload_assert_path(actual = checked_expression_leaf_payload_direct_return_artifact_expression_path_at(artifact = artifact, row_index = row), expected = expression_path)
  leaf_payload_assert_text(actual = checked_expression_leaf_payload_direct_return_artifact_kind_at(artifact = artifact, row_index = row), expected = kind)
  leaf_payload_assert_text(actual = checked_expression_leaf_payload_direct_return_artifact_payload_at(artifact = artifact, row_index = row), expected = payload)
  leaf_payload_assert_text(actual = checked_expression_leaf_payload_direct_return_artifact_type_at(artifact = artifact, row_index = row), expected = ty)
}

fn leaf_payload_push_piece(out: StringBuilder, text: String) -> Unit {
  StringBuilder::push(out, value = __to_string(String::length(text)))
  StringBuilder::push(out, value = ":")
  StringBuilder::push(out, value = text)
}

fn leaf_payload_entry(path: Array[Int], expr_path: Array[Int], kind: String, payload: String, ty: String) -> String {
  let out = StringBuilder::new()
  StringBuilder::push(out, value = __to_string(Array::length(path)))
  StringBuilder::push(out, value = "[")
  let mut i = 0
  while i < Array::length(path) {
    StringBuilder::push(out, value = __to_string(Array::get(path, at = i))); StringBuilder::push(out, value = ":"); i = i + 1
  }
  StringBuilder::push(out, value = "]")
  StringBuilder::push(out, value = __to_string(Array::length(expr_path)))
  StringBuilder::push(out, value = "[")
  let mut j = 0
  while j < Array::length(expr_path) {
    StringBuilder::push(out, value = __to_string(Array::get(expr_path, at = j))); StringBuilder::push(out, value = ":"); j = j + 1
  }
  StringBuilder::push(out, value = "]")
  leaf_payload_push_piece(out = out, text = kind)
  leaf_payload_push_piece(out = out, text = payload)
  leaf_payload_push_piece(out = out, text = ty)
  StringBuilder::freeze(out)
}

fn leaf_payload_encoded(_ entries: Array[String]) -> String {
  let out = StringBuilder::new()
  StringBuilder::push(out, value = "vibe-checked-expression-leaf-payload-direct-return-artifact:v1\n")
  StringBuilder::push(out, value = __to_string(Array::length(entries)))
  StringBuilder::push(out, value = "[")
  let mut i = 0
  while i < Array::length(entries) {
    leaf_payload_push_piece(out = out, text = Array::get(entries, at = i)); i = i + 1
  }
  StringBuilder::push(out, value = "]")
  StringBuilder::freeze(out)
}

fn leaf_payload_assert_none(_ text: String) -> Unit {
  match decode_checked_expression_leaf_payload_direct_return_artifact_v1(text) {
    None => (),
    Some(_) => assert(false)
  }
}

test "leaf payload artifact projects all selected leaves in retained preorder" {
  // #1877: 63-bit Int min, seed-safe spelling (see prelude/int.vibe).
  let minimum = 0 - ((2305843009213693951<<1)|1) - 1
  let maximum = 2305843009213693951
  let stmts = [
    SLet(false, false, "value", None, ETuple([
      EBool(true),
      EInt(maximum),
      EString("a:\n\t雪", -1),
      EUnit,
      ELet("x", EInt(minimum), EIdent("x", 17), 16)
    ]))
  ]
  match check_program_direct_expression_return_observation(stmts) {
    Some(observation) => match checked_expression_leaf_payload_direct_return_artifact_from_observation(observation) {
      Some(artifact) => {
        assert(checked_expression_leaf_payload_direct_return_artifact_row_count(artifact) == 6)
        leaf_payload_assert_row(artifact = artifact, row = 0, statement_path = [0], expression_path = [0], kind = "EBool", payload = "true", ty = "Z0")
        leaf_payload_assert_row(artifact = artifact, row = 1, statement_path = [0], expression_path = [1], kind = "EInt", payload = "2305843009213693951", ty = "I0")
        leaf_payload_assert_row(artifact = artifact, row = 2, statement_path = [0], expression_path = [2], kind = "EString", payload = "a:\n\t雪", ty = "S0")
        leaf_payload_assert_row(artifact = artifact, row = 3, statement_path = [0], expression_path = [3], kind = "EUnit", payload = "", ty = "U0")
        leaf_payload_assert_row(artifact = artifact, row = 4, statement_path = [0], expression_path = [4, 0], kind = "EInt", payload = "-4611686018427387904", ty = "I0")
        leaf_payload_assert_row(artifact = artifact, row = 5, statement_path = [0], expression_path = [4, 1], kind = "EIdent", payload = "x", ty = "I0")
      },
      None => assert(false)
    },
    None => assert(false)
  }
}

test "leaf payload artifact preserves nested type-first paths and final substitution" {
  let stmts = [
    SModule(false, "Outer", [
      SLet(false, false, "before", None, EIdent("Pick", 70)),
      SEnum(false, "Choice", array_empty(), [("Pick", array_empty())], array_empty()),
      SLet(false, false, "identity", None, EFn(array_empty(), array_empty(), [
        ("x", None)
      ], Some(TyName("Int")), None, EIdent("x", 71)))
    ])
  ]
  match check_program_direct_expression_return_observation(stmts) {
    Some(observation) => match checked_expression_leaf_payload_direct_return_artifact_from_observation(observation) {
      Some(artifact) => {
        assert(checked_expression_leaf_payload_direct_return_artifact_row_count(artifact) == 2)
        leaf_payload_assert_path(actual = checked_expression_leaf_payload_direct_return_artifact_statement_path_at(artifact = artifact, row_index = 0), expected = [
          0,
          0
        ])
        leaf_payload_assert_path(actual = checked_expression_leaf_payload_direct_return_artifact_expression_path_at(artifact = artifact, row_index = 0), expected = array_empty())
        leaf_payload_assert_text(actual = checked_expression_leaf_payload_direct_return_artifact_kind_at(artifact = artifact, row_index = 0), expected = "EIdent")
        leaf_payload_assert_text(actual = checked_expression_leaf_payload_direct_return_artifact_payload_at(artifact = artifact, row_index = 0), expected = "Pick")
        match checked_expression_leaf_payload_direct_return_artifact_type_at(artifact = artifact, row_index = 0) {
          Some(ty) => assert(String::length(ty) > 0),
          None => assert(false)
        }
        leaf_payload_assert_row(artifact = artifact, row = 1, statement_path = [0, 2], expression_path = [0], kind = "EIdent", payload = "x", ty = "I0")
      },
      None => assert(false)
    },
    None => assert(false)
  }
}

test "leaf payload artifact covers effectset topology and excludes nonleaves" {
  let stmts = [
    SEffectSet(false, "Caps", ["Fs", "Error"]),
    SLet(false, false, "f", None, EFn(array_empty(), array_empty(), array_empty(), None, Some("Caps"), EIf(EBool(false), EInt(1), EInt(2))))
  ]
  match check_program_direct_expression_return_observation(stmts) {
    Some(observation) => match checked_expression_leaf_payload_direct_return_artifact_from_observation(observation) {
      Some(artifact) => {
        assert(checked_expression_leaf_payload_direct_return_artifact_row_count(artifact) == 3)
        leaf_payload_assert_row(artifact = artifact, row = 0, statement_path = [1], expression_path = [0, 0], kind = "EBool", payload = "false", ty = "Z0")
        leaf_payload_assert_row(artifact = artifact, row = 1, statement_path = [1], expression_path = [0, 1], kind = "EInt", payload = "1", ty = "I0")
        leaf_payload_assert_row(artifact = artifact, row = 2, statement_path = [1], expression_path = [0, 2], kind = "EInt", payload = "2", ty = "I0")
      },
      None => assert(false)
    },
    None => assert(false)
  }
}

test "leaf payload artifact supports a successful zero-row program" {
  match check_program_direct_expression_return_observation([
    SEnum(false, "OnlyType", array_empty(), [("Only", array_empty())], array_empty())
  ]) {
    Some(observation) => match checked_expression_leaf_payload_direct_return_artifact_from_observation(observation) {
      Some(artifact) => {
        assert(checked_expression_leaf_payload_direct_return_artifact_row_count(artifact) == 0)
        assert(encode_checked_expression_leaf_payload_direct_return_artifact_v1(artifact) == "vibe-checked-expression-leaf-payload-direct-return-artifact:v1\n0[]")
      },
      None => assert(false)
    },
    None => assert(false)
  }
}

test "leaf payload decoder accepts five tags and rejects malformed payloads" {
  let encoded = leaf_payload_encoded([
    leaf_payload_entry(path = [0], expr_path = array_empty(), kind = "EInt", payload = "-4611686018427387904", ty = "I0"),
    leaf_payload_entry(path = [1], expr_path = array_empty(), kind = "EBool", payload = "false", ty = "B"),
    leaf_payload_entry(path = [2], expr_path = array_empty(), kind = "EString", payload = "a:\n雪", ty = "S"),
    leaf_payload_entry(path = [3], expr_path = array_empty(), kind = "EIdent", payload = "unusual_name", ty = "I0"),
    leaf_payload_entry(path = [4], expr_path = array_empty(), kind = "EUnit", payload = "", ty = "U")
  ])
  match decode_checked_expression_leaf_payload_direct_return_artifact_v1(encoded) {
    Some(artifact) => {
      assert(encode_checked_expression_leaf_payload_direct_return_artifact_v1(artifact) == encoded)
      match checked_expression_leaf_payload_direct_return_artifact_statement_path_at(artifact = artifact, row_index = 0) {
        Some(path) => Array::set(path, at = 0, value = 99),
        None => assert(false)
      }
      leaf_payload_assert_path(actual = checked_expression_leaf_payload_direct_return_artifact_statement_path_at(artifact = artifact, row_index = 0), expected = [
        0
      ])
    },
    None => assert(false)
  }
  let maximum_path = leaf_payload_encoded([
    leaf_payload_entry(path = [2305843009213693951], expr_path = array_empty(), kind = "EInt", payload = "2305843009213693951", ty = "I0")
  ])
  match decode_checked_expression_leaf_payload_direct_return_artifact_v1(maximum_path) {
    Some(artifact) => assert(encode_checked_expression_leaf_payload_direct_return_artifact_v1(artifact) == maximum_path),
    None => assert(false)
  }
  leaf_payload_assert_none("vibe-checked-expression-leaf-payload-direct-return-artifact:v2\n0[]")
  leaf_payload_assert_none("vibe-checked-expression-leaf-payload-direct-return-artifact:v1\n00[]")
  leaf_payload_assert_none("vibe-checked-expression-leaf-payload-direct-return-artifact:v1\n2305843009213693951[")
  leaf_payload_assert_none("vibe-checked-expression-leaf-payload-direct-return-artifact:v1\n1[2305843009213693951:")
  leaf_payload_assert_none(leaf_payload_encoded(["2305843009213693951["]))
  leaf_payload_assert_none(leaf_payload_encoded(["01[0:]0[]4:EInt1:12:I0"]))
  leaf_payload_assert_none(leaf_payload_encoded(["1[-1:]0[]4:EInt1:12:I0"]))
  leaf_payload_assert_none(leaf_payload_encoded([
    "1[4611686018427387904:]0[]4:EInt1:12:I0"
  ]))
  leaf_payload_assert_none(leaf_payload_encoded(["0[]0[]04:EInt1:12:I0"]))
  leaf_payload_assert_none(leaf_payload_encoded([
    leaf_payload_entry(path = array_empty(), expr_path = array_empty(), kind = "EInt", payload = "01", ty = "I0")
  ]))
  leaf_payload_assert_none(leaf_payload_encoded([
    leaf_payload_entry(path = array_empty(), expr_path = array_empty(), kind = "EInt", payload = "-0", ty = "I0")
  ]))
  leaf_payload_assert_none(leaf_payload_encoded([
    leaf_payload_entry(path = array_empty(), expr_path = array_empty(), kind = "EInt", payload = "4611686018427387904", ty = "I0")
  ]))
  leaf_payload_assert_none(leaf_payload_encoded([
    leaf_payload_entry(path = array_empty(), expr_path = array_empty(), kind = "EBool", payload = "True", ty = "B")
  ]))
  leaf_payload_assert_none(leaf_payload_encoded([
    leaf_payload_entry(path = array_empty(), expr_path = array_empty(), kind = "EUnit", payload = "x", ty = "U")
  ]))
  leaf_payload_assert_none(leaf_payload_encoded([
    leaf_payload_entry(path = array_empty(), expr_path = array_empty(), kind = "EFloat", payload = "1", ty = "F")
  ]))
  leaf_payload_assert_none("vibe-checked-expression-leaf-payload-direct-return-artifact:v1\n1[")
  leaf_payload_assert_none(String::concat(encoded, "x"))
}

test "upstream refusal leaves no leaf-payload artifact route" {
  let recognized = [
    SLet(false, false, "value", None, ECall(EIdent("Some", 10), [EInt(1)], 11, [
    ]))
  ]
  match check_program_direct_expression_return_observation(recognized) {
    None => (),
    Some(_) => assert(false)
  }
  let spread = [SLet(false, false, "value", None, ESpread(EInt(2)))]
  match check_program_direct_expression_return_observation(spread) {
    None => (),
    Some(_) => assert(false)
  }
  let synthetic = [
    SLet(false, false, "value", None, EDot(EIdent("mod", 40), "value", 41, 42))
  ]
  match check_program_with_env_direct_expression_return_observation(stmts = synthetic, initial_env = env_bind(env = EnvEmpty, name = "mod.value", ty = CtInt)) {
    None => (),
    Some(_) => assert(false)
  }
  let auxiliary = [
    SEffectDef(false, "Ask", array_empty(), [
      ("Get", array_empty(), TyName("Int"))
    ]),
    SLet(false, false, "handled", None, EHandle(EInt(1), [
      (PCtor("Ask::Get", array_empty()), ECall(EIdent("resume", -1), [
        EIdent("outer", 50)
      ], -1, []))
    ]))
  ]
  match check_program_with_env_direct_expression_return_observation(stmts = auxiliary, initial_env = env_bind(env = EnvEmpty, name = "outer", ty = CtInt)) {
    None => (),
    Some(_) => assert(false)
  }
}
