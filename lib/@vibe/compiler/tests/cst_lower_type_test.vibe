//# Imports

import @vibe/compiler/core {
  TypeExpr
}

import ../cst.vibe {
  CstChild, NodeKind
}

import ../lower.vibe {
  lower_type
}

import @vibe/compiler/syntax {
  Token
}

//# Misc

test "lower TyName" {
  let node = CNode(NNameType, [CToken(TIdent("Int"))])
  match lower_type(node) {
    TyName(name) => assert(name == "Int"),
    _ => assert(false)
  }
}

test "lower TyUnit" {
  let node = CNode(NUnitType, [CToken(TLParen), CToken(TRParen)])
  match lower_type(node) {
    TyUnit => assert(true),
    _ => assert(false)
  }
}

test "lower TyTuple" {
  let node = CNode(NTupleType, [
    CToken(TLParen),
    CNode(NNameType, [CToken(TIdent("Int"))]),
    CToken(TComma),
    CNode(NNameType, [CToken(TIdent("String"))]),
    CToken(TRParen)
  ])
  match lower_type(node) {
    TyTuple(elems) => assert(Array::length(elems) == 2),
    _ => assert(false)
  }
}

test "lower TyFn" {
  let node = CNode(NFnType, [
    CToken(TLParen),
    CNode(NNameType, [CToken(TIdent("Int"))]),
    CToken(TRParen),
    CToken(TThinArrow),
    CNode(NNameType, [CToken(TIdent("String"))])
  ])
  match lower_type(node) {
    TyFn(params, ret, effect_name) => {
      assert(Array::length(params) == 1)
      match effect_name {
        Some(_) => assert(false),
        None => assert(true)
      }
      match ret {
        TyName(n) => assert(n == "String"),
        _ => assert(false)
      }
    },
    _ => assert(false)
  }
}
