//# #1455: the dependency half of the qualified-constructor transport tests.
//
// Kept in a separate module on purpose: the whole point of the exercise is
// that `Attempt`'s variant list has to cross a module boundary, which it does
// through the `Enum::__variants__` carrier (checker.vibe's `encode_enum_def`).
// Declaring these enums in the test file itself would take the same-file path
// and prove nothing.

/// Parameterized: its `TDEnum` payloads carry the DECLARING compilation's
/// `CtVar` ids, so the importing module has to rebind the formal `T` to ids of
/// its own before `Attempt::Good` means anything.
export enum Attempt[T] {
  Good(T);
  Bad(String)
}

/// Monomorphic companion, for the #1490 path that already worked.
export enum Hue {
  Crimson;
  Cerulean
}

export fn make_good(v: Int) -> Attempt[Int] {
  Good(v)
}

export fn make_bad(msg: String) -> Attempt[Int] {
  Bad(msg)
}
