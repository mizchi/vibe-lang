//# Imports

// #897: package-form import (fs_compile/ is now an index.vpkg boundary) --
// closure_ordered_source_count_for_test is the renamed version of what used
// to be closure_order.vibe's own `closure_ordered_source_count` (see that
// file's #897 comment: renamed to resolve a same-directory export-name
// collision with fs_compile.vibe's unrelated same-named function).
import @vibe/compiler/entry/compiler/fs_compile {
  closure_ordered_source_count_for_test,
  first_import_resolved_path_for_test,
  first_import_source_len_for_test,
  resolve_relative_path_for_test,
  source_lookup_exists_for_test,
  source_lookup_or_throw_len_for_test
}

import @vibe/core {
  array_empty
}

//# Misc

test "resolve_relative_path_for_test: resolves nested ../../../ imports" {
  assert(resolve_relative_path_for_test("a/b/c", "../../../helper.vibe") == "helper.vibe")
}

test "closure_ordered_source_count_for_test: no imports returns 1" {
  let sources = array_empty()
  assert(eq(closure_ordered_source_count_for_test("let run: () -> Int = () -> { 1 }", "a/b/c/main.vibe", sources), 1))
}

test "source_lookup_exists_for_test: finds helper source by normalized path" {
  let helper_source = "export let add: (Int, Int) -> Int = (a, b) -> { a + b }"
  let sources = [("helper.vibe", helper_source)]
  assert(source_lookup_exists_for_test(sources, "helper.vibe"))
}

test "source_lookup_or_throw_len_for_test: returns helper source length" {
  let helper_source = "export let add: (Int, Int) -> Int = (a, b) -> { a + b }"
  let sources = [("helper.vibe", helper_source)]
  assert(eq(source_lookup_or_throw_len_for_test(sources, "helper.vibe"), String::length(helper_source)))
}

test "first_import_resolved_path_for_test: parses and resolves nested import" {
  let main_source = "import ../../../helper.vibe { add }\nlet run: () -> Int = () -> { add(1, 2) }"
  assert(first_import_resolved_path_for_test(main_source, "a/b/c/main.vibe") == "helper.vibe")
}

test "first_import_source_len_for_test: parses, resolves, and loads helper source" {
  let helper_source = "export let add: (Int, Int) -> Int = (a, b) -> { a + b }"
  let main_source = "import ../../../helper.vibe { add }\nlet run: () -> Int = () -> { add(1, 2) }"
  let sources = [("helper.vibe", helper_source)]
  assert(eq(first_import_source_len_for_test(main_source, "a/b/c/main.vibe", sources), String::length(helper_source)))
}

test "closure_ordered_source_count_for_test: resolves nested ../../../ imports" {
  let helper_source = "export let add: (Int, Int) -> Int = (a, b) -> { a + b }"
  let main_source = "import ../../../helper.vibe { add }\nlet run: () -> Int = () -> { add(1, 2) }"
  let sources = [("helper.vibe", helper_source)]
  assert(eq(closure_ordered_source_count_for_test(main_source, "a/b/c/main.vibe", sources), 2))
}
