//# Imports

import ./checker_parity_test_support.vibe {
  check_source_ok, check_source_err
}

//# Misc

// #983: every Map API's VALUE position was typed `CtUnknown` (the static
// builtin table cannot mint per-call vars), so `Map::set(m, "b", "str")`
// into a `Map[String, Int]` compiled clean and the consumer trapped at
// runtime — #938's ArrayBuilder hole, one container over. Map literals
// (`Map::new()` / `Map::from_pairs`) now carry a real value slot
// (`CtNamed("Map", [CtString, v])`, the shape a `Map[String, V]` annotation
// resolves to), `Map::set` checks the written value against it (ground-gated
// via check_assignable), `Map::get`/`Map::values`/`Map::delete` propagate it,
// and the #938 value restriction keeps a let-bound map's slot monomorphic.

test "983 repro: setting a String value into an Int-valued map is rejected" {
  assert(check_source_err("fn get_it(m: Map[String, Int]) -> Int {\n  Map::get(m, \"b\") + 1\n}\nfn main() -> Int {\n  let m = Map::from_pairs([(\"a\", 1)])\n  Map::set(m, \"b\", \"str\")\n  get_it(m)\n}"))
}

test "983: homogeneous set stays accepted" {
  assert(check_source_ok("fn get_it(m: Map[String, Int]) -> Int {\n  Map::get(m, \"b\") + 1\n}\nfn main() -> Int {\n  let m = Map::from_pairs([(\"a\", 1)])\n  Map::set(m, \"b\", 40)\n  get_it(m)\n}"))
}

test "983: empty map's slot is bound by the first set (value restriction)" {
  assert(check_source_err("fn main() -> Int {\n  let m = Map::new()\n  Map::set(m, \"a\", 1)\n  Map::set(m, \"b\", \"str\")\n  0\n}"))
  assert(check_source_ok("fn main() -> Int {\n  let m = Map::new()\n  Map::set(m, \"a\", 1)\n  Map::set(m, \"b\", 2)\n  0\n}"))
}

test "983: key type check is preserved" {
  assert(check_source_err("fn main() -> Int {\n  let m = Map::from_pairs([(\"a\", 1)])\n  Map::set(m, 2, 3)\n  0\n}"))
}

test "983: Map::get result reaches a wrong consume" {
  // Map::get returns the RAW stored value (0 on miss), not an Option.
  assert(check_source_err("fn main() -> Int {\n  let m = Map::from_pairs([(\"a\", 1)])\n  let s: String = Map::get(m, \"a\")\n  0\n}"))
  assert(check_source_ok("fn main() -> Int {\n  let m = Map::from_pairs([(\"a\", 1)])\n  let n: Int = Map::get(m, \"a\")\n  n\n}"))
}

test "983: annotated Map param checks set values" {
  assert(check_source_err("fn put(m: Map[String, Int]) -> Unit {\n  let _ = Map::set(m, \"k\", \"nope\")\n  ()\n}\nfn main() -> Int { 0 }"))
  assert(check_source_ok("fn put(m: Map[String, Int]) -> Unit {\n  let _ = Map::set(m, \"k\", 7)\n  ()\n}\nfn main() -> Int { 0 }"))
}

test "983: Map::values propagates the value slot" {
  assert(check_source_err("fn main() -> Int {\n  let m = Map::from_pairs([(\"a\", 1)])\n  let vs: Array[String] = Map::values(m)\n  0\n}"))
  assert(check_source_ok("fn main() -> Int {\n  let m = Map::from_pairs([(\"a\", 1)])\n  let vs: Array[Int] = Map::values(m)\n  Array::length(vs)\n}"))
}

test "983: untyped map receiver stays tolerated" {
  // A lambda parameter with no annotation gives the receiver no map shape —
  // the set/get checks must not fire (tolerate discipline).
  assert(check_source_ok("fn main() -> Int {\n  let put = (m) -> {\n    let _ = Map::set(m, \"k\", 7)\n    0\n  }\n  0\n}"))
}

test "983: heterogeneous map literal keeps being rejected (#938)" {
  assert(check_source_err("fn main() -> Int {\n  let m = Map::from_pairs([(\"a\", 1), (\"b\", \"two\")])\n  0\n}"))
}
