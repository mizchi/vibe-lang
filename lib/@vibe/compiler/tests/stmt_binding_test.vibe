//# Imports

import ./stmt_test_support.vibe {
  pp, ps
}

//# Misc

test "stmt_test" {
  let result = ps("test \"hello\" { 1 }")
  assert(result == "test \"hello\" { 1 }")
}

test "stmt_bench" {
  let result = ps("bench \"perf\" { 1 }")
  assert(result == "bench \"perf\" { 1 }")
}

test "stmt_export_names" {
  assert(ps("export { foo, bar }") == "export { foo, bar }")
}

test "stmt_expr" {
  assert(ps("1 + 2") == "(1 + 2)")
}

test "program_simple" {
  let src = "let x = 1\nlet y = 2"
  let result = pp(src)
  assert(result == "let x = 1\nlet y = 2")
}

test "program_enum_and_fn" {
  let src = "enum Bool { True; False }\nlet f = 1"
  let result = pp(src)
  assert(result == "enum Bool { True; False }\nlet f = 1")
}
