//# #3368: a compiler-owned head against a builtin value it is not

// `let x: Future[Int] = [1]` and a tuple where `FixedArray` is declared
// checked clean: the compiler-owned heads were exempt from the declared-type
// versus builtin-value check by name. Only the crossings the compiler relies
// on (`FixedArray` / `FrozenArray` / `ArrayBuilder` and `Array`, `MutBytes`
// and `Bytes`) stay accepted.
import @vibe/compiler/runtime {
  collect_all_diagnostics
}

test "a Future is not an array" {
  let src = "fn f() -> Int {\n  let x: Future[Int] = [1]\n  0\n}\n"
  inspect(collect_all_diagnostics(src), "[line 2:24-27: binding type mismatch for a local let: expected Future[Int], got Array[Int]]")
}

test "a FixedArray is not a tuple" {
  let src = "fn f() -> Int {\n  let x: FixedArray[Int] = (1, 2)\n  0\n}\n"
  inspect(collect_all_diagnostics(src), "[line 2:28-34: binding type mismatch for a local let: expected FixedArray[Int], got (Int, Int)]")
}

test "a MutBytes is not a String" {
  let src = "fn f() -> Int {\n  let x: MutBytes = \"abc\"\n  0\n}\n"
  inspect(collect_all_diagnostics(src), "[line 2:21-26: binding type mismatch for a local let: expected MutBytes, got String]")
}

test "a Map is not an array" {
  let src = "fn f() -> Int {\n  let x: Map[String, Int] = [1]\n  0\n}\n"
  inspect(collect_all_diagnostics(src), "[line 2:29-32: binding type mismatch for a local let: expected Map[String, Int], got Array[Int]]")
}

test "a FixedArray shares an array's representation" {
  let src = "fn f() -> Int {\n  let x: FixedArray[Int] = [1, 2]\n  0\n}\n"
  inspect(collect_all_diagnostics(src), "[]")
}
