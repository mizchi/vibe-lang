//# Imports

import ../coverage_suite_lib.vibe {
  CoverageCaseInput, SuiteReport, build_suite_report_from_json_texts, build_summary_text, evaluate_kpi, suite_report_json
}

//# Functions

fn sample_report_union() -> SuiteReport with Exception {
  build_suite_report_from_json_texts([
    CoverageCaseInput::{
      report_path: "a.report.json", report_json: "{\"entry_path\":\"lib/@vibe/compiler/lexer_test.vibe\",\"execution\":{\"ok\":true,\"error\":\"\"},\"stats\":{\"point_total\":99,\"point_hit\":1,\"line_total\":1,\"line_hit\":1,\"branch_total\":99,\"branch_hit\":1},\"points\":[\"0|branch_if_then|0|10\",\"0|branch_if_then|1|10\",\"1|line|1|11\"],\"lines\":[{\"line\":1,\"hit\":true,\"excluded\":false}]}"
    },
    CoverageCaseInput::{
      report_path: "b.report.json", report_json: "{\"entry_path\":\"lib/@vibe/compiler/lexer_test.vibe\",\"execution\":{\"ok\":true,\"error\":\"\"},\"stats\":{\"point_total\":77,\"point_hit\":0,\"line_total\":1,\"line_hit\":1,\"branch_total\":77,\"branch_hit\":0},\"points\":[\"0|branch_if_then|0|10\",\"1|line|0|11\",\"2|branch_if_else|1|12\"],\"lines\":[{\"line\":2,\"hit\":true,\"excluded\":false}]}"
    }
  ])
}

fn sample_report_aggregate() -> SuiteReport with Exception {
  build_suite_report_from_json_texts([
    CoverageCaseInput::{
      report_path: "a.report.json", report_json: "{\"entry_path\":\"lib/@vibe/compiler/coverage_run.vibe\",\"execution\":{\"ok\":true,\"error\":\"\"},\"stats\":{\"point_total\":200,\"point_hit\":60,\"line_total\":30,\"line_hit\":30,\"branch_total\":120,\"branch_hit\":40},\"lines\":[{\"line\":1,\"hit\":true,\"excluded\":false},{\"line\":2,\"hit\":true,\"excluded\":false}]}"
    },
    CoverageCaseInput::{
      report_path: "b.report.json", report_json: "{\"entry_path\":\"lib/@vibe/compiler/index.vibe\",\"execution\":{\"ok\":true,\"error\":\"\"},\"stats\":{\"point_total\":100,\"point_hit\":10,\"line_total\":20,\"line_hit\":10,\"branch_total\":80,\"branch_hit\":8},\"lines\":[{\"line\":1,\"hit\":false,\"excluded\":false},{\"line\":2,\"hit\":false,\"excluded\":true}]}"
    }
  ])
}

fn sample_report_union_object() -> SuiteReport with Exception {
  build_suite_report_from_json_texts([
    CoverageCaseInput::{
      report_path: "legacy-a.report.json", report_json: "{\"entry_path\":\"lib/@vibe/compiler/lexer_test.vibe\",\"execution\":{\"ok\":true,\"error\":\"\"},\"stats\":{\"point_total\":99,\"point_hit\":1,\"line_total\":1,\"line_hit\":1,\"branch_total\":99,\"branch_hit\":1},\"points\":[{\"kind\":\"branch_if_then\",\"line\":10,\"span\":{\"start\":100,\"end\":120},\"range\":{\"start\":{\"line\":9,\"character\":0},\"end\":{\"line\":9,\"character\":20}},\"hit\":false},{\"kind\":\"branch_if_then\",\"line\":10,\"span\":{\"start\":100,\"end\":120},\"range\":{\"start\":{\"line\":9,\"character\":0},\"end\":{\"line\":9,\"character\":20}},\"hit\":true},{\"kind\":\"line\",\"line\":11,\"span\":{\"start\":121,\"end\":140},\"range\":{\"start\":{\"line\":10,\"character\":0},\"end\":{\"line\":10,\"character\":19}},\"hit\":true}],\"lines\":[{\"line\":1,\"hit\":true,\"excluded\":false}]}"
    },
    CoverageCaseInput::{
      report_path: "legacy-b.report.json", report_json: "{\"entry_path\":\"lib/@vibe/compiler/lexer_test.vibe\",\"execution\":{\"ok\":true,\"error\":\"\"},\"stats\":{\"point_total\":77,\"point_hit\":0,\"line_total\":1,\"line_hit\":1,\"branch_total\":77,\"branch_hit\":0},\"points\":[{\"kind\":\"branch_if_then\",\"line\":10,\"span\":{\"start\":100,\"end\":120},\"range\":{\"start\":{\"line\":9,\"character\":0},\"end\":{\"line\":9,\"character\":20}},\"hit\":false},{\"kind\":\"line\",\"line\":11,\"span\":{\"start\":121,\"end\":140},\"range\":{\"start\":{\"line\":10,\"character\":0},\"end\":{\"line\":10,\"character\":19}},\"hit\":false},{\"kind\":\"branch_if_else\",\"line\":12,\"span\":{\"start\":141,\"end\":160},\"range\":{\"start\":{\"line\":11,\"character\":0},\"end\":{\"line\":11,\"character\":19}},\"hit\":true}],\"lines\":[{\"line\":2,\"hit\":true,\"excluded\":false}]}"
    }
  ])
}

fn sample_report_union_cross_entry() -> SuiteReport with Exception {
  build_suite_report_from_json_texts([
    CoverageCaseInput::{
      report_path: "cross-a.report.json", report_json: "{\"entry_path\":\"lib/@vibe/compiler/a_test.vibe\",\"execution\":{\"ok\":true,\"error\":\"\"},\"stats\":{\"point_total\":99,\"point_hit\":1,\"line_total\":1,\"line_hit\":1,\"branch_total\":99,\"branch_hit\":1},\"points\":[\"0|branch_if_then|0|10\",\"1|line|1|11\"],\"lines\":[{\"line\":1,\"hit\":true,\"excluded\":false}]}"
    },
    CoverageCaseInput::{
      report_path: "cross-b.report.json", report_json: "{\"entry_path\":\"lib/@vibe/compiler/b_test.vibe\",\"execution\":{\"ok\":true,\"error\":\"\"},\"stats\":{\"point_total\":77,\"point_hit\":0,\"line_total\":1,\"line_hit\":1,\"branch_total\":77,\"branch_hit\":0},\"points\":[\"0|branch_if_then|1|10\",\"1|line|0|11\",\"2|branch_if_else|1|12\"],\"lines\":[{\"line\":2,\"hit\":true,\"excluded\":false}]}"
    }
  ])
}

fn sample_report_summary_only_branch_gap() -> SuiteReport with Exception {
  build_suite_report_from_json_texts([
    CoverageCaseInput::{
      report_path: "summary-only.report.json", report_json: "format\tvibe-wasm-source-coverage-v4\nentry_path\tlib/@vibe/compiler/stage2_coverage_run.vibe\nexecution_ok\t1\nexecution_error\t\npoint_total\t0\npoint_hit\t0\nline_total\t0\nline_hit\t0\nbranch_total\t0\nbranch_hit\t0\ncase_branch_total\t5354\ncase_branch_hit\t0\n"
    },
    CoverageCaseInput::{
      report_path: "normal.report.json", report_json: "{\"entry_path\":\"lib/@vibe/compiler/fixture_test.vibe\",\"execution\":{\"ok\":true,\"error\":\"\"},\"stats\":{\"point_total\":100,\"point_hit\":50,\"line_total\":10,\"line_hit\":10,\"branch_total\":20,\"branch_hit\":10},\"lines\":[{\"line\":1,\"hit\":true,\"excluded\":false}]}"
    }
  ])
}

fn sample_report_union_cross_entry_custom() -> SuiteReport with Exception {
  build_suite_report_from_json_texts([
    CoverageCaseInput::{
      report_path: "cross-a.report.json", report_json: "format\tvibe-wasm-source-coverage-v4\nentry_path\tlib/@vibe/compiler/a_test.vibe\nexecution_ok\t1\nexecution_error\t\npoint_total\t2\npoint_hit\t1\nline_total\t1\nline_hit\t1\nbranch_total\t1\nbranch_hit\t0\nline_points\t121-140:1\nbranch_points\t100-120:0\n"
    },
    CoverageCaseInput::{
      report_path: "cross-b.report.json", report_json: "format\tvibe-wasm-source-coverage-v4\nentry_path\tlib/@vibe/compiler/b_test.vibe\nexecution_ok\t1\nexecution_error\t\npoint_total\t3\npoint_hit\t2\nline_total\t1\nline_hit\t1\nbranch_total\t2\nbranch_hit\t2\nline_points\t121-140:0\nbranch_points\t100-120:1,141-160:1\n"
    }
  ])
}

fn sample_report_same_key_different_kinds_custom() -> SuiteReport with Exception {
  build_suite_report_from_json_texts([
    CoverageCaseInput::{
      report_path: "same-key.report.json", report_json: "format\tvibe-wasm-source-coverage-v4\nentry_path\tlib/@vibe/compiler/a_test.vibe\nexecution_ok\t1\nexecution_error\t\npoint_total\t3\npoint_hit\t2\nline_total\t1\nline_hit\t1\nbranch_total\t2\nbranch_hit\t1\nline_points\t100-120:1\nbranch_points\t100-120:1,141-160:0\n"
    }
  ])
}

//# Misc

test "aggregate case_count" {
  let report = sample_report_aggregate()
  assert(eq(report.case_count, 2))
}

test "aggregate trap_case_count" {
  let report = sample_report_aggregate()
  assert(eq(report.trap_case_count, 0))
}

test "aggregate point_total" {
  let report = sample_report_aggregate()
  assert(eq(report.stats.point_total, 300))
}

test "aggregate point_hit" {
  let report = sample_report_aggregate()
  assert(eq(report.stats.point_hit, 70))
}

test "aggregate line_total" {
  let report = sample_report_aggregate()
  assert(eq(report.stats.line_total, 3))
}

test "aggregate line_hit" {
  let report = sample_report_aggregate()
  assert(eq(report.stats.line_hit, 2))
}

test "aggregate branch_total" {
  let report = sample_report_aggregate()
  assert(eq(report.stats.branch_total, 200))
}

test "aggregate branch_hit" {
  let report = sample_report_aggregate()
  assert(eq(report.stats.branch_hit, 48))
}

test "aggregate kpi pass" {
  let report = sample_report_aggregate()
  let pass_kpi = evaluate_kpi(report, Some(20.0), Some(60.0), Some(20.0))
  assert(pass_kpi.ok)
}

test "aggregate kpi fail" {
  let report = sample_report_aggregate()
  let fail_kpi = evaluate_kpi(report, Some(30.0), Some(70.0), Some(30.0))
  assert(not(fail_kpi.ok))
  assert(eq(Array::length(fail_kpi.failures), 3))
}

test "union point_total" {
  let report = sample_report_union()
  assert(eq(report.stats.point_total, 3))
}

test "union point_hit" {
  let report = sample_report_union()
  assert(eq(report.stats.point_hit, 3))
}

test "union branch_total" {
  let report = sample_report_union()
  assert(eq(report.stats.branch_total, 2))
}

test "union branch_hit" {
  let report = sample_report_union()
  assert(eq(report.stats.branch_hit, 2))
}

test "union line_total" {
  let report = sample_report_union()
  assert(eq(report.stats.line_total, 2))
}

test "union line_hit" {
  let report = sample_report_union()
  assert(eq(report.stats.line_hit, 2))
}

test "union legacy object points" {
  let report = sample_report_union_object()
  assert(eq(report.stats.point_total, 3))
  assert(eq(report.stats.point_hit, 3))
  assert(eq(report.stats.branch_total, 2))
  assert(eq(report.stats.branch_hit, 2))
}

test "union point ids across different entry paths" {
  let report = sample_report_union_cross_entry()
  assert(eq(report.stats.point_total, 3))
  assert(eq(report.stats.point_hit, 3))
  assert(eq(report.stats.branch_total, 2))
  assert(eq(report.stats.branch_hit, 2))
}

test "union compact custom point ids across different entry paths" {
  let report = sample_report_union_cross_entry_custom()
  assert(eq(report.stats.point_total, 3))
  assert(eq(report.stats.point_hit, 3))
  assert(eq(report.stats.branch_total, 2))
  assert(eq(report.stats.branch_hit, 2))
}

test "union compact custom keeps line and branch keys separate" {
  let report = sample_report_same_key_different_kinds_custom()
  assert(eq(report.stats.point_total, 3))
  assert(eq(report.stats.point_hit, 2))
  assert(eq(report.stats.branch_total, 2))
  assert(eq(report.stats.branch_hit, 1))
}

test "summary includes top branch gaps ranking" {
  let report = sample_report_aggregate()
  let kpi = evaluate_kpi(report, None, None, None)
  let summary = build_summary_text(report, kpi)
  assert(String::contains(summary, "top_branch_gaps:"))
  assert(String::contains(summary, "lib/@vibe/compiler/coverage_run.vibe 80 missed (40/120)"))
  assert(String::contains(summary, "lib/@vibe/compiler/index.vibe 72 missed (8/80)"))
}

test "summary ranking includes summary-only compact case branch stats" {
  let report = sample_report_summary_only_branch_gap()
  let kpi = evaluate_kpi(report, None, None, None)
  let summary = build_summary_text(report, kpi)
  assert(not(String::contains(summary, "top_branch_gaps:\n- lib/@vibe/compiler/stage2_coverage_run.vibe")))
  assert(String::contains(summary, "lib/@vibe/compiler/fixture_test.vibe 10 missed (10/20)"))
  assert(String::contains(summary, "top_non_aggregate_branch_gaps:"))
  assert(String::contains(summary, "lib/@vibe/compiler/stage2_coverage_run.vibe 5354 missed (0/5354)"))
}

test "suite report json includes top branch gaps" {
  let report = sample_report_summary_only_branch_gap()
  let kpi = evaluate_kpi(report, None, None, None)
  let json_text = suite_report_json(report, kpi)
  assert(String::contains(json_text, "\"top_branch_gaps\""))
  assert(String::contains(json_text, "\"entry_path\":\"lib/@vibe/compiler/fixture_test.vibe\""))
  assert(String::contains(json_text, "\"top_non_aggregate_branch_gaps\""))
  assert(String::contains(json_text, "\"entry_path\":\"lib/@vibe/compiler/stage2_coverage_run.vibe\""))
  assert(String::contains(json_text, "\"branch_miss\":5354"))
  assert(String::contains(json_text, "\"branch_total\":5354"))
  assert(String::contains(json_text, "\"branch_hit\":0"))
}
