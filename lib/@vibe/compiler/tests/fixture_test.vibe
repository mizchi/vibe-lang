//# Imports

import ./fixture_test_support.vibe {
  parse_ok
}

//# Misc

test "fixture_01_parse" {
  let src = "let dead: () -> Int = () -> { 0 }\nimport ./dep.vibe { dep }\ntrait Eq\nimpl Eq for Int\ntype Alias = Int\nlet helper: () -> Int = () -> { 1 }\nexport let run: () -> Int = () -> { helper() }\nexport let run_io: () -> Int with Error = () -> { run() }\nexport { run, run_io }"
  assert(parse_ok(src))
}

test "fixture_02_parse" {
  let src = "let helper: () -> Int = () -> { 1 + 2 }\nlet value = helper()\nexport let run: () -> Int = () -> { value }\nexport { run }"
  assert(parse_ok(src))
}

test "fixture_03_parse" {
  // #728 removed `module { ... }` blocks; this fixture used to wrap its body
  // in `export module math { ... }` (now a parse error) -- flattened to
  // top-level statements, which exercises the same dead-code/helper/type-alias
  // shapes this fixture is meant to cover.
  let src = "let dead: () -> Int = () -> { 0 }\nlet helper: () -> Int = () -> { 1 }\ntype Alias = Int\nexport let run: () -> Int = () -> { helper() }\nexport let run_io: () -> Int with Error = () -> { run() }\nexport { run, run_io }"
  assert(parse_ok(src))
}

test "fixture_04_parse" {
  let src = "let answer = 40 + 2\nlet id: (Int) -> Int = (x) -> { x }\nexport let run: () -> Int = () -> { answer }\nexport let keep: () -> Int = () -> { id(1) }\nexport { run, keep }"
  assert(parse_ok(src))
}

test "fixture_05_parse" {
  // 0.3.0 redundant-syntax removal: declaration members are ';'-separated;
  // ',' is a parse error (see fixture_05_decl_comma_rejected below).
  let src = "export struct Pair {\nleft: Int;\nright: Int\n}\nexport enum Choice {\nA;\nB(Int)\n}\nexport { Pair, Choice }"
  assert(parse_ok(src))
}

test "fixture_05_decl_comma_rejected" {
  // This fixture used ',' separators before the 0.3.0 removal; keep the old
  // spelling here as a REJECT case so the removal cannot silently regress.
  let struct_src = "export struct Pair {\nleft: Int,\nright: Int\n}\nexport { Pair }"
  let enum_src = "export enum Choice {\nA,\nB(Int)\n}\nexport { Choice }"
  assert(!parse_ok(struct_src))
  assert(!parse_ok(enum_src))
}

test "fixture_06_parse" {
  let src = "let sum: (x~: Int, y~: Int) -> Int = (x~, y~) -> { x + y }\nexport let run: () -> Int = () -> { sum(x~=1, y?=2) }\nexport { run }"
  assert(parse_ok(src))
}
