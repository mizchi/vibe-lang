//# Imports

import ./checker_parity_test_support.vibe {
  check_source_error_message, check_source_located_err_contains, check_source_ok
}

//# Misc

// #3538: an impl method is called through its trait's signature (`Name::name`
// or `T::name` under a bound) and dispatched to the impl's function, so the
// impl must have that signature. Before the check none of the refused rows
// below was reported, and each misbehaved at run time.

/// The parameter type the trait declares, refused with the edit.
test "a parameter type the trait does not declare is refused" {
  let src = "trait Name { name(Self, Int) -> Int }\nstruct P { x: Int }\nimpl Name for P { name(self, k: String) -> Int { String::length(k) } }\nfn main() -> Int { Name::name(P::{ x: 1 }, 12345) }\n"
  inspect(check_source_error_message(src), "change parameter `k` of `P::name` to `Int`: trait `Name` declares `name(Self, Int) -> Int` [@impl-method=Name|P|name|param|k]")
}

/// The diagnostic is located on the offending parameter.
test "the parameter diagnostic is located on the parameter" {
  let src = "trait Name { name(Self, Int) -> Int }\nstruct P { x: Int }\nimpl Name for P { name(self, k: String) -> Int { String::length(k) } }\nfn main() -> Int { Name::name(P::{ x: 1 }, 12345) }\n"
  assert(check_source_located_err_contains(src, "line 3:30-31: change parameter `k`"))
}

/// The return type the trait declares, refused with the edit.
test "a return type the trait does not declare is refused" {
  let src = "trait Name { name(Self) -> String }\nstruct P { x: Int }\nimpl Name for P { name(self) -> Int { 42 } }\nfn main() -> String { Name::name(P::{ x: 1 }) }\n"
  inspect(check_source_error_message(src), "change the return type of `P::name` to `String`: trait `Name` declares `name(Self) -> String` [@impl-method=Name|P|name|ret|]")
}

/// An extra parameter, refused with the edit.
test "an extra parameter is refused" {
  let src = "trait Name { name(Self) -> Int }\nstruct P { x: Int }\nimpl Name for P { name(self, k: Int) -> Int { k + self.x } }\nfn main() -> Int { Name::name(P::{ x: 1 }) }\n"
  inspect(check_source_error_message(src), "remove parameter `k` from `P::name`: trait `Name` declares `name(Self) -> Int`, which takes 1 parameter [@impl-method=Name|P|name|param|k]")
}

/// A missing parameter, refused with the edit.
test "a missing parameter is refused" {
  let src = "trait Name { name(Self, Int) -> Int }\nstruct P { x: Int }\nimpl Name for P { name(self) -> Int { self.x } }\nfn main() -> Int { Name::name(P::{ x: 1 }, 2) }\n"
  inspect(check_source_error_message(src), "add 1 parameter to `P::name`: trait `Name` declares `name(Self, Int) -> Int`, which takes 2 parameters [@impl-method=Name|P|name|name|]")
}

/// A method the trait does not declare, refused with the edit where the
/// binding name proves it was written in the impl block (an applied impl).
test "a method the trait does not declare is refused" {
  let src = "trait Conv[A] { conv(Self) -> A }\nstruct P { x: Int }\nimpl Conv[Int] for P {\n  conv(self) -> Int { self.x }\n  extra(self) -> Int { 7 }\n}\nfn main() -> Int { 0 }\n"
  inspect(check_source_error_message(src), "remove method `extra` from `impl Conv[Int] for P`, or declare it in trait `Conv`: the trait declares no method `extra`, so nothing can call it through the trait [@impl-method=Conv|P|extra|name|]")
}

/// The undeclared-method diagnostic is located on the method name.
test "the undeclared-method diagnostic is located on the method name" {
  let src = "trait Conv[A] { conv(Self) -> A }\nstruct P { x: Int }\nimpl Conv[Int] for P {\n  conv(self) -> Int { self.x }\n  extra(self) -> Int { 7 }\n}\nfn main() -> Int { 0 }\n"
  assert(check_source_located_err_contains(src, "line 5:3-8: remove method `extra`"))
}

/// A plain impl's method is the statement `fn P::m` also lowers to, so an
/// undeclared one cannot be told from a free function after the block; both
/// stay accepted.
test "a function after a plain impl is not taken for an undeclared method" {
  let src = "trait Name { name(Self) -> Int }\nstruct P { x: Int }\nimpl Name for P { name(self) -> Int { self.x } }\nfn P::make(x: Int) -> P { P::{ x: x } }\nfn main() -> Int { Name::name(P::make(1)) }\n"
  assert(check_source_ok(src))
}

/// A `with` clause the trait method does not declare, refused with the edit.
test "an impl method row wider than the trait's is refused" {
  let src = "trait Speak { speak(Self) -> Int }\nimpl Speak for Int { speak(x: Int) -> Int with Console { println(\"side effect\"); x } }\nfn go[T: Speak](x: T) -> Int { T::speak(x) }\nfn main() -> Int { go(3) }\n"
  inspect(check_source_error_message(src), "remove `with Console` from `Int::speak`: trait `Speak` declares `speak(Self) -> Int`, which performs no effects; a caller through the trait does not authorize `Console` [@impl-method=Speak|Int|speak|row|]")
}

/// The row diagnostic is located on the `with` clause.
test "the row diagnostic is located on the with clause" {
  let src = "trait Speak { speak(Self) -> Int }\nimpl Speak for Int { speak(x: Int) -> Int with Console { println(\"side effect\"); x } }\nfn main() -> Int { 0 }\n"
  assert(check_source_located_err_contains(src, "line 2:43-55: remove `with Console`"))
}

/// A matching impl, with `self` unannotated, still checks clean.
test "a matching impl is accepted" {
  let src = "trait Name { name(Self, Int) -> Int }\nstruct P { x: Int }\nimpl Name for P { name(self, k: Int) -> Int { k + self.x } }\nfn main() -> Int { Name::name(P::{ x: 1 }, 2) }\n"
  assert(check_source_ok(src))
}

/// `Self` is the impl's target, whichever way the impl spells it.
test "Self spelled as the target type is accepted" {
  let src = "trait Same { same(Self, Self) -> Bool }\nstruct P { x: Int }\nimpl Same for P { same(a: P, b: P) -> Bool { a.x == b.x } }\nfn main() -> Bool { Same::same(P::{ x: 1 }, P::{ x: 1 }) }\n"
  assert(check_source_ok(src))
}

/// A parameter typed as another struct than `Self` is refused.
test "a parameter that is not the target where the trait says Self is refused" {
  let src = "trait Same { same(Self, Self) -> Bool }\nstruct P { x: Int }\nstruct Q { y: Int }\nimpl Same for P { same(a: P, b: Q) -> Bool { a.x == b.y } }\nfn main() -> Bool { true }\n"
  inspect(check_source_error_message(src), "change parameter `b` of `P::same` to `P`: trait `Same` declares `same(Self, Self) -> Bool` [@impl-method=Same|P|same|param|b]")
}

/// A generic impl keeps compiling: its formals stand for themselves.
test "a generic impl over Array[T] is accepted" {
  let src = "trait Measured { size(Self) -> Int }\nimpl [T] Measured for Array[T] { size(self) -> Int { Array::length(self) } }\nfn main() -> Int { Measured::size([1, 2]) }\n"
  assert(check_source_ok(src))
}

/// A trait parameter the impl head applies is substituted.
test "an applied trait argument is substituted" {
  let src = "trait Conv[A] { conv(Self) -> A }\nstruct P { x: Int }\nimpl Conv[Int] for P { conv(self) -> Int { self.x } }\nfn main() -> Int { 0 }\n"
  assert(check_source_ok(src))
}

/// ... and holds the impl to it.
test "an applied trait argument the impl contradicts is refused" {
  let src = "trait Conv[A] { conv(Self) -> A }\nstruct P { x: Int }\nimpl Conv[Int] for P { conv(self) -> String { \"no\" } }\nfn main() -> Int { 0 }\n"
  inspect(check_source_error_message(src), "change the return type of `P::conv` to `Int`: trait `Conv[Int]` declares `conv(Self) -> A` [@impl-method=Conv|P|conv|ret|]")
}

/// An unapplied trait parameter is erased; the impl may spell it as anything.
test "an unapplied trait parameter is not compared" {
  let src = "trait Gen[A] { make(Self) -> A }\nstruct P { x: Int }\nimpl Gen for P { make(self) -> Int { self.x } }\nfn main() -> Int { 0 }\n"
  assert(check_source_ok(src))
}

/// A static method (no receiver) returning `Self`.
test "a static method returning Self is accepted" {
  let src = "trait Make { make() -> Self }\nstruct P { x: Int }\nimpl Make for P { make() -> P { P::{ x: 0 } } }\nfn main() -> Int { 0 }\n"
  assert(check_source_ok(src))
}

/// A method-level generic is not compared.
test "a method-level generic is accepted" {
  let src = "trait Show { show(Self) -> String }\ntrait Logger { write_object: [X: Show](Self, X) -> String }\nimpl Show for Int { show(self) -> String { __to_string(self) } }\nstruct B { p: String }\nimpl Logger for B { write_object(self, x: X) -> String { String::concat(self.p, X::show(x)) } }\nfn main() -> Int { 0 }\n"
  assert(check_source_ok(src))
}

/// A supertrait's method may be implemented under the subtrait.
test "an inherited method is declared" {
  let src = "trait Base { base(Self) -> Int }\ntrait Child: Base { child(Self) -> Int }\nstruct P { x: Int }\nimpl Child for P {\n  base(self) -> Int { self.x }\n  child(self) -> Int { self.x }\n}\nfn main() -> Int { 0 }\n"
  assert(check_source_ok(src))
}

/// A qualified free function is not an impl method, whatever its name.
test "a qualified free function is not held to a trait" {
  let src = "trait Name { name(Self) -> Int }\nstruct P { x: Int }\nimpl Name for P { name(self) -> Int { self.x } }\nfn P::other(self: P, k: String) -> Int { String::length(k) }\nfn main() -> Int { 0 }\n"
  assert(check_source_ok(src))
}

/// A generic impl over a bare builtin head (`impl [T] Len2 for Array`) names
/// every instantiation, so its `self` is not held to the zero-argument `Array`.
test "an impl for a bare builtin generic head accepts its receiver" {
  assert(check_source_ok("trait Len2[T] { len2(Self) -> Int }\nstruct Box[T] { v: T }\nimpl Len2 for Box { len2(self) -> Int { 1 } }\nimpl [T] Len2 for Array { len2(self) -> Int { Array::length(self) } }\nlet total = [U: Len2](x: U) -> Int { U::len2(x) }\nfn main() -> Int { total([10, 20, 30, 40]) + total(Box::{ v: 99 }) }"))
}

/// A bodyless impl dispatches to `P::m` wherever it is declared; behind any
/// other statement it used to escape the check, so its `String` reached a
/// caller of the trait's `Int`.
test "a bodyless impl's fallback behind another statement is held to the trait" {
  let src = "trait Name { name(Self) -> Int }\nstruct P { x: Int }\nimpl Name for P\nfn helper() -> Int { 3 }\nfn P::name(self: P) -> String { \"hello\" }\nfn main() -> Int { Name::name(P::{ x: 1 }) + helper() }\n"
  inspect(check_source_error_message(src), "change the return type of `P::name` to `Int`: trait `Name` declares `name(Self) -> Int` (`impl Name for P` has no body for `name`, so the trait dispatches to this function) [@fn=P::name]")
}

/// The fallback diagnostic is located on the function's own declaration.
test "the fallback diagnostic is located on the function" {
  let src = "trait Name { name(Self) -> Int }\nstruct P { x: Int }\nimpl Name for P\nfn helper() -> Int { 3 }\nfn P::name(self: P) -> String { \"hello\" }\nfn main() -> Int { Name::name(P::{ x: 1 }) + helper() }\n"
  assert(check_source_located_err_contains(src, "line 5:4-11: change the return type of `P::name`"))
}

/// ... and so is one declared before the impl.
test "a fallback declared before the impl is held to the trait" {
  let src = "trait Name { name(Self) -> Int }\nstruct P { x: Int }\nfn P::name(self: P) -> String { \"hello\" }\nimpl Name for P\nfn main() -> Int { Name::name(P::{ x: 1 }) }\n"
  inspect(check_source_error_message(src), "change the return type of `P::name` to `Int`: trait `Name` declares `name(Self) -> Int` (`impl Name for P` has no body for `name`, so the trait dispatches to this function) [@fn=P::name]")
}

/// A fallback that matches the trait is accepted.
test "a matching fallback is accepted" {
  let src = "trait Name { name(Self) -> Int }\nstruct P { x: Int }\nimpl Name for P\nfn helper() -> Int { 3 }\nfn P::name(self: P) -> Int { self.x }\nfn main() -> Int { Name::name(P::{ x: 1 }) + helper() }\n"
  assert(check_source_ok(src))
}

/// A `P::m` the bodyless impl's trait does not declare is not its method, and
/// is not refused as an undeclared one either.
test "a free function beside a bodyless applied impl is not refused" {
  let src = "trait Conv[A] { conv(Self) -> A }\nstruct P { x: Int }\nimpl Conv[Int] for P\nfn P::conv(self: P) -> Int { self.x }\nfn P::extra(self: P) -> String { \"x\" }\nfn main() -> Int { 0 }\n"
  assert(check_source_ok(src))
}

/// An inherited method takes the applied subtrait's arguments by position,
/// as a call through `[T: Child[Int]]` does.
test "an inherited method is held to the applied subtrait's argument" {
  let src = "trait Base[A] { get(Self) -> A }\ntrait Child[A]: Base {}\nstruct P { x: Int }\nimpl Child[Int] for P {\n  get(self) -> String { \"hello\" }\n}\nfn via[T: Child[Int]](v: T) -> Int { T::get(v) }\nfn main() -> Int { via(P::{ x: 1 }) }\n"
  inspect(check_source_error_message(src), "change the return type of `P::get` to `Int`: trait `Child[Int]` declares `get(Self) -> A` [@impl-method=Child|P|get|ret|]")
}

/// Trait operation bindings synthesized after the impl marker (here
/// `Base::get`, a supertrait's) do not end the impl block: an inherited
/// method in a plain subtrait impl is held to its trait. It used to escape
/// the check entirely.
test "an inherited method in a plain subtrait impl is held to its trait" {
  let src = "trait Base { get(Self) -> Int }\ntrait Child: Base { other(Self) -> Int }\nstruct P { x: Int }\nimpl Child for P {\n  get(self) -> String { \"hello\" }\n  other(self) -> Int { 1 }\n}\nfn main() -> Int { 0 }\n"
  inspect(check_source_error_message(src), "change the return type of `P::get` to `Int`: trait `Child` declares `get(Self) -> Int` [@impl-method=Child|P|get|ret|]")
}

/// ... and an inherited method that agrees with it is accepted.
test "an inherited method matching the applied subtrait is accepted" {
  let src = "trait Base[A] { get(Self) -> A }\ntrait Child[A]: Base {}\nstruct P { x: Int }\nimpl Child[Int] for P {\n  get(self) -> Int { self.x }\n}\nfn via[T: Child[Int]](v: T) -> Int { T::get(v) }\nfn main() -> Int { via(P::{ x: 1 }) }\n"
  assert(check_source_ok(src))
}

/// A bodyless GENERIC impl dispatches every instantiation to the one
/// fallback, so a fallback written for `Box[Int]` is refused: the witness for
/// `Box[String]` handed it a string, and `self.v + 1` read an address.
test "a fallback for one instantiation of a generic impl is refused" {
  let src = "trait Name { name(Self) -> Int }\nstruct Box[T] { v: T }\nimpl [T] Name for Box[T]\nfn Box::name(self: Box[Int]) -> Int { self.v + 1 }\nfn main() -> Int { 0 }\n"
  inspect(check_source_error_message(src), "declare `Box::name` generic over the impl's type parameters (`fn Box::name[T]`, taking `self: Box[T]`), or narrow the impl to `impl Name for Box[Int]`: `impl [T] Name for Box[T]` has no body for `name`, so the trait calls this function at every instantiation, but it takes `self: Box[Int]`, not `self: Box[T]` [@fn=Box::name]")
}

/// The diagnostic is located on the fallback's own declaration.
test "the generic-impl fallback diagnostic is located on the function" {
  let src = "trait Name { name(Self) -> Int }\nstruct Box[T] { v: T }\nimpl [T] Name for Box[T]\nfn Box::name(self: Box[Int]) -> Int { self.v + 1 }\nfn main() -> Int { 0 }\n"
  assert(check_source_located_err_contains(src, "line 4:4-13: declare `Box::name` generic"))
}

/// A return type fixed where the trait returns the impl's formal is refused
/// the same way.
test "a fallback returning one instantiation of the impl's formal is refused" {
  let src = "trait Get[A] { get(Self) -> A }\nstruct Box[T] { v: T }\nimpl [T] Get[T] for Box[T]\nfn Box::get[U](self: Box[U]) -> Int { 1 }\nfn main() -> Int { 0 }\n"
  inspect(check_source_error_message(src), "declare `Box::get` generic over the impl's type parameters (`fn Box::get[T]`, returning `T`), or narrow the impl to a concrete target: `impl [T] Get[T] for Box[T]` has no body for `get`, so the trait calls this function at every instantiation, but it returns `Int`, not `T` [@fn=Box::get]")
}

/// A fallback generic over the impl's formal, under any spelling, is accepted.
test "a fallback generic over the impl's formal is accepted" {
  assert(check_source_ok("trait Get[A] { get(Self) -> A }\nstruct Box[T] { v: T }\nimpl [T] Get[T] for Box[T]\nfn Box::get[U](self: Box[U]) -> U { self.v }\nfn main() -> Int { Get::get(Box::{ v: 3 }) }\n"))
}

/// ... with a bound on its own formal as on the impl's.
test "a bounded generic fallback of a bounded generic impl is accepted" {
  assert(check_source_ok("trait Name { name(Self) -> Int }\nstruct Tag[T] { t: T }\nimpl [T: Eq] Name for Tag[T]\nfn Tag::name[U: Eq](self: Tag[U]) -> Int { 5 }\nfn main() -> Int { 0 }\n"))
}

/// ... and so is a concrete impl whose fallback takes exactly its target.
test "a concrete impl's fallback for its target is accepted" {
  assert(check_source_ok("trait Name { name(Self) -> Int }\nstruct Box[T] { v: T }\nimpl Name for Box[Int]\nfn Box::name(self: Box[Int]) -> Int { self.v + 1 }\nfn main() -> Int { Name::name(Box::{ v: 3 }) }\n"))
}
