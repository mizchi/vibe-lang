//# Imports

import ../bytebuf.vibe {
  bytebuf_length, bytebuf_new, bytebuf_to_bytes
}

import @vibe/compiler/codegen/wasm_emit {
  build_add_module,
  build_arithmetic_module,
  build_call_module,
  build_factorial_module,
  build_fibonacci_module,
  build_hello_module,
  build_print_string_module,
  emit_header,
  emit_vibe_abi_custom_section,
  string_to_data
}

//# Misc

test "wasm header" {
  let buf = bytebuf_new()
  emit_header(buf)
  assert(bytebuf_length(buf) == 8)
  let bytes = bytebuf_to_bytes(buf)
  assert(Bytes::get(bytes, 0) == 0)
  assert(Bytes::get(bytes, 1) == 97)
  assert(Bytes::get(bytes, 2) == 115)
  assert(Bytes::get(bytes, 3) == 109)
  assert(Bytes::get(bytes, 4) == 1)
}

test "emit_vibe_abi_custom_section encodes raw host import ABI" {
  let buf = bytebuf_new()
  emit_vibe_abi_custom_section(buf, "raw")
  assert(bytebuf_length(buf) == 41)
  let bytes = bytebuf_to_bytes(buf)
  assert(Bytes::get(bytes, 0) == 0)
  assert(Bytes::get(bytes, 1) == 39)
  assert(Bytes::get(bytes, 2) == 8)
  assert(Bytes::get(bytes, 3) == 118)
  assert(Bytes::get(bytes, 4) == 105)
  assert(Bytes::get(bytes, 5) == 98)
  assert(Bytes::get(bytes, 6) == 101)
  assert(Bytes::get(bytes, 7) == 46)
  assert(Bytes::get(bytes, 8) == 97)
  assert(Bytes::get(bytes, 9) == 98)
  assert(Bytes::get(bytes, 10) == 105)
  assert(Bytes::get(bytes, 11) == 118)
  assert(Bytes::get(bytes, 20) == 10)
  assert(Bytes::get(bytes, 21) == 104)
  assert(Bytes::get(bytes, 40) == 10)
}

test "build_add_module produces valid wasm" {
  let bytes = build_add_module()
  assert(Bytes::length(bytes) > 20)
  assert(Bytes::get(bytes, 0) == 0)
  assert(Bytes::get(bytes, 1) == 97)
  assert(Bytes::get(bytes, 2) == 115)
  assert(Bytes::get(bytes, 3) == 109)
}

test "build_add_module validates with wasmtime" {
  let bytes = build_add_module()
  Fs::write_bytes("/tmp/test_vibe_add.wasm", bytes)
  sh("wasmtime run --invoke add /tmp/test_vibe_add.wasm 3 4")
}

test "arithmetic module: add" {
  let bytes = build_arithmetic_module()
  Fs::write_bytes("/tmp/test_vibe_arith.wasm", bytes)
  sh("wasmtime run --invoke add /tmp/test_vibe_arith.wasm 10 20")
}

