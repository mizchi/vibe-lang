//# The handle-eligibility diagnostic must describe the set it rejects (#2137)

// The message this pass emits when a `handle` survives the ADR-0076 evidence
// migration used to read:
//
//   "... so the handled body may only: perform directly, call a named
//    top-level `fn`, or call a closure literal that carries an effect row
//    annotation. A call through a local binding or a closure parameter hides
//    the perform and is what this rejects"
//
// Both halves were false. Measured on stage2 before the rewrite, ALL of these
// compile: a call through a closure PARAMETER whose type carries the row, a
// call through a local BINDING whose type carries the row, a call through a
// local binding whose closure literal is written inside the handled body, and
// a call through a local binding that merely aliases a performing top-level
// `fn`. A reader following the old message went looking for a rejection that
// never comes, and the two shapes that DO fail here fail for reasons it never
// mentioned.
//
// So this file pins the two things together: the accept/reject verdict for
// each shape, and the message the rejected ones actually produce. Splitting
// them is what let the message drift away from the behaviour in the first
// place -- an assertion on the text alone stays green while the rule under it
// moves, and an assertion on the verdict alone never notices the prose.
//
// Related: #1511 (the eligibility rule and the first rewrite of this message),
// #1514 (naming the culprit call), #2109 (first-order builtins are visible).

//# Imports

import @vibe/compiler/entry/source_compile {
  compile_source_wasi
}

import @vibe/compiler/entry/source_compile/gc_only {
  compile_source_gc_only
}

//# Misc

/// The shared prelude: an effect and a top-level `fn` that performs it.
/// `body` supplies whatever the case under test adds.
fn program(body: String) -> String {
  "effect Ask {\n  Get() -> Int\n}\n\nfn ask_once() -> Int with Ask {\n  perform Ask::Get()\n}\n\n\{body}"
}

fn compiles_linear(src: String) -> Bool {
  handle {
    let bytes = compile_source_wasi(src, "__no_entry__")
    Bytes::length(bytes) > 8
  } with { Exception::Throw(_) => false }
}

fn compiles_gc(src: String) -> Bool {
  handle {
    let bytes = compile_source_gc_only(src, "__no_entry__")
    Bytes::length(bytes) > 8
  } with { Exception::Throw(_) => false }
}

fn compiles_both(src: String) -> Bool with Exception {
  compiles_linear(src) && compiles_gc(src)
}

/// The diagnostic a rejected program produces, or "" when it compiles.
/// `effect_lowering_prelude` throws its first error as the message string.
fn reject_message(src: String) -> String {
  handle {
    let _ = compile_source_wasi(src, "__no_entry__")
    ""
  } with { Exception::Throw(msg) => msg }
}

//# Tests -- shapes the message CLAIMED were rejected, and are not

test "#2137: a call through a closure parameter carrying the row compiles" {
  // The old message said a closure parameter "hides the perform and is what
  // this rejects". It does not: the row on the parameter's type is what makes
  // the call visible.
  let src = program("fn apply(f: () -> Int with Ask) -> Int with Ask {\n  f()\n}\n\ntest \"t\" {\n  let r = handle {\n    apply(ask_once)\n  } with {\n    Ask::Get() => resume(42)\n  }\n  assert_eq(r, 42)\n}\n")
  assert(compiles_both(src))
}

test "#2137: a call through a local binding carrying the row compiles" {
  // The other half of the old culprit list. A local binding is fine when its
  // type carries the row -- which is exactly the edit the rewritten message
  // now suggests.
  let src = program("test \"t\" {\n  let side: (Int) -> Int with Ask = (n: Int) -> Int with Ask {\n    n\n  }\n  let r = handle {\n    side(ask_once())\n  } with {\n    Ask::Get() => resume(42)\n  }\n  assert_eq(r, 42)\n}\n")
  assert(compiles_both(src))
}

test "#2137: a local closure written inside the handled body compiles" {
  // Rowless, locally bound, called from the handled body -- and accepted,
  // because the traversal that decides eligibility is scope-tracked and sees
  // the literal's own body. Moving the `let` inward is the third repair the
  // rewritten message offers.
  let src = program("test \"t\" {\n  let r = handle {\n    let side = (n: Int) -> Int {\n      n\n    }\n    side(ask_once())\n  } with {\n    Ask::Get() => resume(42)\n  }\n  assert_eq(r, 42)\n}\n")
  assert(compiles_both(src))
}

test "#2137: a local binding aliasing a performing top-level fn compiles" {
  // #2137 reported this shape as rejected by the #1347 `can never fire` check.
  // Measured on stage2 (2026-08-20) it compiles: the #1261 eta-wrap turns the
  // alias into a row-carrying closure before eligibility is asked.
  let src = program("test \"t\" {\n  let alias = ask_once\n  let r = handle {\n    alias()\n  } with {\n    Ask::Get() => resume(42)\n  }\n  assert_eq(r, 42)\n}\n")
  assert(compiles_both(src))
}

test "#2137: a call to a top-level fn compiles" {
  // The control: the one form the old message named as eligible, and still is.
  let src = program("fn side(n: Int) -> Int {\n  n\n}\n\ntest \"t\" {\n  let r = handle {\n    side(ask_once())\n  } with {\n    Ask::Get() => resume(42)\n  }\n  assert_eq(r, 42)\n}\n")
  assert(compiles_both(src))
}

test "an annotated let beside a nested handle of the same effect compiles" {
  // `let seen: Array[Int] = [1]` reaches the eligibility walk as a type
  // ascription, `((__asc: Array[Int]) -> __asc)([1])` -- an identity closure
  // applied on the spot. It used to count as a call through an expression,
  // so a handle holding it next to a nested handle of the same effect was
  // refused (#1962: every recording mock inside a test, whose body the entry
  // provider wraps in a handle of its own, has exactly this shape).
  let src = program("test \"t\" {\n  let r = handle {\n    let seen: Array[Int] = [1]\n    let inner = handle {\n      ask_once()\n    } with {\n      Ask::Get() => resume(Array::length(seen) + 1)\n    }\n    inner\n  } with {\n    Ask::Get() => resume(0)\n  }\n  assert_eq(r, 2)\n}\n")
  assert(compiles_both(src))
}

test "a recording arm pushing into an annotated local compiles" {
  // The mock-and-record shape itself: the inner arm records every operation
  // into an annotated array bound inside the outer handle's body.
  let src = program("test \"t\" {\n  let r = handle {\n    let seen: Array[Int] = []\n    let inner = handle {\n      ask_once() + ask_once()\n    } with {\n      Ask::Get() => {\n        Array::push(seen, 1)\n        resume(20)\n      }\n    }\n    inner + Array::length(seen)\n  } with {\n    Ask::Get() => resume(0)\n  }\n  assert_eq(r, 42)\n}\n")
  assert(compiles_both(src))
}

//# Tests -- shapes that ARE rejected, and what the message says about them

test "#3124: a rowless lambda whose body is visibly pure compiles outside the handle" {
  // `side` performs nothing. The perform is `ask_once()`, written in the
  // handled body. The pass reads the lambda literal and treats the call as
  // inert, then still walks the argument.
  let src = program("test \"t\" {\n  let side = (n: Int) -> Int {\n    n\n  }\n  let r = handle {\n    side(ask_once())\n  } with {\n    Ask::Get() => resume(42)\n  }\n  assert_eq(r, 42)\n}\n")
  assert(compiles_both(src))
}

test "#3124: a later lambda does not inherit an earlier pure body of the same name" {
  // The inert set is keyed by spelling. Recording only the first `side`
  // would treat the performing one as pure and let the handle compile.
  let src = program("test \"t\" {\n  let side = (n: Int) -> Int {\n    n\n  }\n  let side = (n: Int) -> Int {\n    perform Ask::Get()\n  }\n  let r = handle {\n    side(1)\n  } with {\n    Ask::Get() => resume(42)\n  }\n  assert_eq(r, 42)\n}\n")
  assert(!compiles_linear(src))
}

test "#3124: a lambda parameter that shadows a pure fn is not read as that fn" {
  // `apply`'s body calls its PARAMETER `side`, not the pure top-level `fn
  // side`. Deciding the call from the flat inert set read it as the fn, so
  // `apply` looked inert, the handle below compiled, and the performing
  // callback answered wrong (a trap on gc). It must be refused exactly as
  // it is when no top-level name collides.
  let body = "test \"t\" {\n  let apply = (side: (Int) -> Int, n: Int) -> Int {\n    side(n)\n  }\n  let r = handle {\n    apply((n: Int) -> Int {\n      perform Ask::Get() + n\n    }, 1)\n  } with {\n    Ask::Get() => resume(42)\n  }\n  assert_eq(r, 43)\n}\n"
  let with_top = program("fn side(n: Int) -> Int {\n  n\n}\n\n\{body}")
  let without_top = program(body)
  assert(!compiles_linear(without_top))
  assert(!compiles_linear(with_top))
  let msg = reject_message(with_top)
  assert(String::contains(msg, "the call to 'apply'"))
}

test "#3124: a let inside the lambda that shadows a pure fn is not read as that fn" {
  let body = "test \"t\" {\n  let apply = (f: (Int) -> Int, n: Int) -> Int {\n    let side = f\n    side(n)\n  }\n  let r = handle {\n    apply((n: Int) -> Int {\n      perform Ask::Get() + n\n    }, 1)\n  } with {\n    Ask::Get() => resume(42)\n  }\n  assert_eq(r, 43)\n}\n"
  assert(!compiles_linear(program("fn side(n: Int) -> Int {\n  n\n}\n\n\{body}")))
}

test "#3124: a pure local lambda does not make an unrelated parameter of its spelling inert" {
  // The inert set is keyed by spelling and read at every call site. A pure
  // `let side` in the test admitted the spelling, so `through`'s closure
  // PARAMETER `side` became inert inside its handle, and the callback's
  // perform reached the OUTER handler: the program compiled and answered 50,
  // not 85. Without the unrelated `let side` it is refused -- and must be
  // refused with it too.
  let through = "fn through(side: (Int) -> Int) -> Int {\n  handle {\n    side(1) + ask_once()\n  } with {\n    Ask::Get() => resume(42)\n  }\n}\n\n"
  let call = "  let r = handle {\n    through((n: Int) -> Int {\n      perform Ask::Get() + n\n    })\n  } with {\n    Ask::Get() => resume(7)\n  }\n"
  let with_local = program("\{through}test \"t\" {\n  let side = (n: Int) -> Int {\n    n\n  }\n\{call}  assert_eq(r + side(0), 85)\n}\n")
  let without_local = program("\{through}test \"t\" {\n\{call}  assert_eq(r, 85)\n}\n")
  assert(!compiles_linear(without_local))
  assert(!compiles_linear(with_local))
  assert(String::contains(reject_message(with_local), "the call to 'side'"))
}

test "#3124: two pure lambdas may share a spelling" {
  let src = program("test \"t\" {\n  let side = (n: Int) -> Int {\n    n\n  }\n  let side = (n: Int) -> Int {\n    n\n  }\n  let r = handle {\n    side(ask_once())\n  } with {\n    Ask::Get() => resume(42)\n  }\n  assert_eq(r, 42)\n}\n")
  assert(compiles_both(src))
}

test "#3124: a rowless lambda whose body performs is still refused" {
  let src = program("test \"t\" {\n  let side = (n: Int) -> Int {\n    perform Ask::Get()\n  }\n  let r = handle {\n    side(1)\n  } with {\n    Ask::Get() => resume(42)\n  }\n  assert_eq(r, 42)\n}\n")
  assert(!compiles_linear(src))
}

test "#2137: a call through an expression says so instead of naming nothing" {
  // An immediately-applied closure literal: the callee is not a name at all,
  // so there is nothing to quote. The old message fell back to its enumeration
  // with the culprit clause silently dropped.
  let src = program("test \"t\" {\n  let r = handle {\n    ((n: Int) -> Int {\n      n\n    })(ask_once())\n  } with {\n    Ask::Get() => resume(42)\n  }\n  assert_eq(r, 42)\n}\n")
  assert(!compiles_linear(src))
  let msg = reject_message(src)
  assert(String::contains(msg, "handle of effect 'Ask' cannot be compiled here"))
  assert(String::contains(msg, "calls through an expression rather than a name"))
  assert(!String::contains(msg, "the handled body may only"))
}

test "#2137: an opaque callee one level down is not blamed on the handled body" {
  // The handled body here calls a named top-level `fn` -- the very form the
  // old message listed as eligible -- and is still rejected, because
  // `ask_once_via` reaches its `perform` through a rowless PARAMETER. The old
  // message told this reader to do what the program already does.
  let src = "effect Ask {\n  Get() -> Int\n}\n\nfn ask_once_via(g: (Int) -> Int) -> Int with Ask {\n  g(perform Ask::Get())\n}\n\ntest \"t\" {\n  let r = handle {\n    ask_once_via((n: Int) -> Int {\n      n\n    })\n  } with {\n    Ask::Get() => resume(42)\n  }\n  assert_eq(r, 42)\n}\n"
  assert(!compiles_linear(src))
  let msg = reject_message(src)
  assert(String::contains(msg, "handle of effect 'Ask' cannot be compiled here"))
  assert(String::contains(msg, "No call in the handled body itself is opaque"))
  assert(String::contains(msg, "look one level down"))
  assert(!String::contains(msg, "the handled body may only"))
  // The repair it offers -- give the parameter the row -- compiles.
  let repaired = "effect Ask {\n  Get() -> Int\n}\n\nfn ask_once_via(g: (Int) -> Int with Ask) -> Int with Ask {\n  g(perform Ask::Get())\n}\n\ntest \"t\" {\n  let r = handle {\n    ask_once_via((n: Int) -> Int with Ask {\n      n\n    })\n  } with {\n    Ask::Get() => resume(42)\n  }\n  assert_eq(r, 42)\n}\n"
  assert(compiles_both(repaired))
}

test "#3118: no branch of this diagnostic names a pass or an ADR" {
  // #2137 removed "the replay engine that used to accept this shape was
  // removed". #3118 removes the `(ADR-0076 ...)` tail. A pure outside
  // lambda now compiles (#3124); these two shapes are still rejected.
  let opaque_expr = program("test \"t\" {\n  let r = handle {\n    ((n: Int) -> Int {\n      n\n    })(ask_once())\n  } with {\n    Ask::Get() => resume(42)\n  }\n  assert_eq(r, 42)\n}\n")
  let deeper = "effect Ask {\n  Get() -> Int\n}\n\nfn ask_once_via(g: (Int) -> Int) -> Int with Ask {\n  g(perform Ask::Get())\n}\n\ntest \"t\" {\n  let r = handle {\n    ask_once_via((n: Int) -> Int {\n      n\n    })\n  } with {\n    Ask::Get() => resume(42)\n  }\n  assert_eq(r, 42)\n}\n"
  let msgs = [reject_message(opaque_expr), reject_message(deeper)]
  let mut i = 0
  while i < Array::length(msgs) {
    let m = Array::get(msgs, i)
    assert(String::length(m) > 0)
    assert(!String::contains(m, "replay engine"))
    assert(!String::contains(m, "ADR-0076"))
    i = i + 1
  }
}

test "#3180: a rowless closure that performs is named, and both edits compile" {
  // The handled body's only call is `side`, a closure bound outside it with no
  // effect row, and `side` itself performs `Ask`. It was refused as a handle
  // that "can never fire ... reaches no `perform`", which is false: it reaches
  // one, through `side`. Still refused; now the message says where and how.
  let src = program("fn run() -> Int with Ask {\n  let side = () -> Int {\n    perform Ask::Get()\n  }\n  handle {\n    side()\n  } with {\n    Ask::Get() => resume(42)\n  }\n}\n")
  assert(!compiles_linear(src))
  let msg = reject_message(src)
  assert(String::contains(msg, "give the local closure `side` an effect row"))
  assert(String::contains(msg, "with Ask { .. }"))
  assert(String::contains(msg, "directly in the handled body"))
  assert(!String::contains(msg, "can never fire"))
  assert(!String::contains(msg, "reaches no"))
  // The two edits it offers. (fixtures/handle_rowless_closure_row_edit_test
  // .vibe runs them: each answers through the inner handler.)
  let driver = "\ntest \"t\" {\n  let r = handle {\n    run()\n  } with {\n    Ask::Get() => resume(1)\n  }\n  assert_eq(r, 42)\n}\n"
  let with_row = program(String::concat("fn run() -> Int with Ask {\n  let side = () -> Int with Ask {\n    perform Ask::Get()\n  }\n  handle {\n    side()\n  } with {\n    Ask::Get() => resume(42)\n  }\n}\n", driver))
  assert(compiles_both(with_row))
  let inlined = program(String::concat("fn run() -> Int with Ask {\n  handle {\n    perform Ask::Get()\n  } with {\n    Ask::Get() => resume(42)\n  }\n}\n", driver))
  assert(compiles_both(inlined))
}

test "#3270: a rowless closure behind an alias annotation is named too" {
  // An alias annotation is not distributed onto the literal: the binding
  // holds the ascription `((__asc: Thunk) -> __asc)(lit)`. The closure walk
  // matched only a bare literal, so this fell back to "can never fire ...
  // reaches no `perform`" with no position, for `let` and `let mut` alike.
  let lets = ["let", "let mut"]
  let mut i = 0
  while i < Array::length(lets) {
    let src = program(String::concat("type Thunk = () -> Int\n\nfn run() -> Int with Ask {\n  ", String::concat(Array::get(lets, i), " side: Thunk = () -> Int {\n    perform Ask::Get()\n  }\n  handle {\n    side()\n  } with {\n    Ask::Get() => resume(42)\n  }\n}\n")))
    assert(!compiles_linear(src))
    let msg = reject_message(src)
    assert(String::contains(msg, "give the local closure `side` an effect row"))
    assert(String::contains(msg, "with Ask { .. }"))
    assert(!String::contains(msg, "can never fire"))
    assert(!String::contains(msg, "reaches no"))
    i = i + 1
  }
  // The edit as the message spells it -- the row on an unannotated literal.
  let driver = "\ntest \"t\" {\n  let r = handle {\n    run()\n  } with {\n    Ask::Get() => resume(1)\n  }\n  assert_eq(r, 42)\n}\n"
  let with_row = program(String::concat("type Thunk = () -> Int\n\nfn run() -> Int with Ask {\n  let side = () -> Int with Ask {\n    perform Ask::Get()\n  }\n  handle {\n    side()\n  } with {\n    Ask::Get() => resume(42)\n  }\n}\n", driver))
  assert(compiles_both(with_row))
}

test "#3347: a rowless alias is read through a chain and a type argument" {
  // The alias is expanded before the closure is judged rowless: through an
  // alias of an alias, and with its type parameters substituted.
  let decls = [
    "type Base = () -> Int\ntype Thunk = Base\n",
    "type Fn0[T] = () -> T\ntype Thunk = Fn0[Int]\n"
  ]
  let mut i = 0
  while i < Array::length(decls) {
    let src = program(String::concat(Array::get(decls, i), "\nfn run() -> Int with Ask {\n  let side: Thunk = () -> Int {\n    perform Ask::Get()\n  }\n  handle {\n    side()\n  } with {\n    Ask::Get() => resume(42)\n  }\n}\n"))
    assert(!compiles_linear(src))
    assert(String::contains(reject_message(src), "give the local closure `side` an effect row"))
    i = i + 1
  }
}

test "#3347: an alias that carries the row is not a rowless closure" {
  // `type Thunk = () -> Int with Ask` gives `side` the row exactly as
  // `let side: () -> Int with Ask = ..` would. The handle check used to read
  // the alias annotation as rowless and tell the reader to add the row the
  // alias already declares. It now counts the alias's row as the binding's,
  // like the written one, so this check no longer refuses the handle.
  // The evidence migration now reads the alias's row too: the literal takes
  // it, as a written annotation's row is folded into the literal, so the
  // handle compiles (#3347; `fixtures/alias_annotated_closure_handle_test.vibe`
  // answers 41).
  let driver = "\ntest \"t\" {\n  let r = handle {\n    run()\n  } with {\n    Ask::Get() => resume(1)\n  }\n  assert_eq(r, 42)\n}\n"
  let src = program(String::concat("type Thunk = () -> Int with Ask\n\nfn run() -> Int with Ask {\n  let side: Thunk = () -> Int {\n    perform Ask::Get()\n  }\n  handle {\n    side()\n  } with {\n    Ask::Get() => resume(42)\n  }\n}\n", driver))
  assert(compiles_linear(src))
  // `let mut` through the alias is refused like `let mut` with the row
  // written out: a call through an effect-typed mutable local.
  let written = program("fn run() -> Int with Ask {\n  let mut side: () -> Int with Ask = () -> Int {\n    perform Ask::Get()\n  }\n  handle {\n    side()\n  } with {\n    Ask::Get() => resume(42)\n  }\n}\n")
  let aliased = program("type Thunk = () -> Int with Ask\n\nfn run() -> Int with Ask {\n  let mut side: Thunk = () -> Int {\n    perform Ask::Get()\n  }\n  handle {\n    side()\n  } with {\n    Ask::Get() => resume(42)\n  }\n}\n")
  assert(String::contains(reject_message(written), "cannot compile a call through mutable local `side`"))
  assert(String::contains(reject_message(aliased), "cannot compile a call through mutable local `side`"))
}
