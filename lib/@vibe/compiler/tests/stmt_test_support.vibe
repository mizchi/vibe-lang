//# Imports

import @vibe/compiler/syntax {
  lex, print_program, print_stmt, print_type_expr
}

import ../parser.vibe {
  parse_program, parse_stmt, parse_type
}

//# Functions

export fn pp(src: String) -> String {
  handle {
    let tokens = lex(src)
    let stmts = parse_program(tokens)
    print_program(stmts)
  } with Exception {
    Throw(msg) => String::concat("ERROR: ", msg)
  }
}

export fn ps(src: String) -> String {
  handle {
    let tokens = lex(src)
    let (stmt, _) = parse_stmt(tokens, [], 0)
    print_stmt(stmt)
  } with Exception {
    Throw(msg) => String::concat("ERROR: ", msg)
  }
}

export fn pt(src: String) -> String {
  handle {
    let tokens = lex(src)
    let (ty, _) = parse_type(tokens, 0)
    print_type_expr(ty)
  } with Exception {
    Throw(msg) => String::concat("ERROR: ", msg)
  }
}
