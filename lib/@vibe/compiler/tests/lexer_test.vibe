/// Pins the scalar/SIMD handoff around one full v128 chunk. The lexer remains
/// byte-indexed, so a multibyte comment must stop at the same LF byte and an
/// EOF-terminated comment must not invent a newline token.
test "lex_long_line_comments_preserve_boundaries" {
  inspect(nth_token_name(source = "// 0123456789abcde\nlet x = 1", i = 0), "TLet")
  inspect(nth_token_name(source = "// 0123456789abcdef\nlet x = 1", i = 0), "TLet")
  inspect(nth_token_name(source = "// 0123456789abcdef0123456789abcdef\n42", i = 0), "TInt(42)")
  inspect(nth_token_name(source = "// 日本語0123456789abcdef\nvalue", i = 0), "TIdent(value)")
  inspect(nth_token_name(source = "// 0123456789abcdef0123456789abcdef", i = 0), "TEof")
}

