test "lex_string_interp_paren_removed" {
  // `\(expr)` interpolation was removed in 0.3.0 (redundant-syntax cleanup);
  // only `\{expr}` remains. The old spelling must be a lex error.
  assert(!lex_ok("\"value is \\(x + 1)\""))
}

test "lex_empty_input" {
  assert(lex_match("", [
    TEof
  ]))
}

