test "lex_int_form_float_f_suffix" {
  // Regression: integer-form float literals with an `f` suffix (`10f`, `0f`)
  // lex to a single TFloat, not TInt followed by an `f` ident — used by
  // vibe/prelude/test_import.vibe (`clamp(10f, 0f, 4f)`) (#492).
  assert(lex_match("10f", [
    TFloat(10.0),
    TEof
  ]))
  assert(lex_match("0f", [
    TFloat(0.0),
    TEof
  ]))
}

