}

test "tokens_match_negative" {
  assert(!tokens_match([
    TInt(1),
    TEof
  ], [
    TInt(2),
    TEof
  ]))
  assert(!tokens_match([
    TInt(1)
  ], [
    TInt(1),
    TEof
  ]))
}

