test "lex_int_form_float_f_suffix" {
  // Regression: integer-form float literals with an `f` suffix (`10f`, `0f`)
  // lex to a single Float literal token (TFloat32 since #3543), not TInt
  // followed by an `f` ident — used by @vibe/builtin/test_import.vibe
  // (`clamp(10f, 0f, 4f)`) (#492).
  assert(lex_match(source = "10f", expected = [TFloat32(10.0), TEof]))
  assert(lex_match(source = "0f", expected = [TFloat32(0.0), TEof]))
}

test "lex_float_f_suffix_rounds_to_f32" {
  // #3543: an `f` literal's payload is already the nearest f32. 2^24 + 1 is
  // the first integer an f32 cannot hold, and it ties to even.
  assert(lex_match(source = "16777217.0f", expected = [TFloat32(16777216.0), TEof]))
  assert(lex_match(source = "16777217.0", expected = [TFloat(16777217.0), TEof]))
  assert(lex_match(source = "0.5f", expected = [TFloat32(0.5), TEof]))
}

