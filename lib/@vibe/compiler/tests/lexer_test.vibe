    TIdent("x"),
    TMinusEq,
    TInt(1),
    TIdent("y"),
    TStarEq,
    TInt(2),
    TIdent("z"),
    TSlashEq,
    TInt(3),
    TIdent("w"),
    TPercentEq,
    TInt(4),
    TTilde,
    TIdent("a"),
    THash,
    TIdent("b"),
    TQuestion,
    TIdent("c"),
    TEof
