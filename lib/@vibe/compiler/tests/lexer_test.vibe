//# Imports

import @vibe/compiler/syntax {
  Token, collect_doc_comments, lex, lex_ok, token_to_string
}

//# Functions

fn lex_len(_ source: String) -> Int {
  handle {
    Array::length(lex(source))
  } with { Exception::Throw(_) => -1 }
}

/// "" when the source lexes cleanly, otherwise the lexer error message.
fn lex_err(_ source: String) -> String {
  handle {
    let n = Array::length(lex(source))
    if n > 0 {
      ""
    } else {
      ""
    }
  } with { Exception::Throw(msg) => msg }
}

fn tokens_match(actual: Array[Token], expected: Array[Token]) -> Bool {
  if Array::length(actual) != Array::length(expected) {
    false
  } else {
    let len = Array::length(actual)
    let rec go: (Int) -> Bool = (i) -> {
      if i >= len {
        true
      } else {
        let a = token_to_string(Array::get(actual, at = i))
        let b = token_to_string(Array::get(expected, at = i))
        if a == b {
          go(i + 1)
        } else false
      }
    }
    go(0)
  }
}

fn lex_match(source: String, expected: Array[Token]) -> Bool {
  handle {
    let tokens = lex(source)
    tokens_match(actual = tokens, expected = expected)
  } with { Exception::Throw(_) => false }
}

fn assert_string_interp_parts(source: String, expected: Array[String]) -> Bool {
  handle {
    let tokens = lex(source)
    match Array::get(tokens, at = 0) {
      TStringInterp(parts, _offsets) => if Array::length(parts) != Array::length(expected) {
        false
      } else {
        let len = Array::length(expected)
        let mut i = 0
        let mut ok = true
        while i < len {
          if Array::get(parts, at = i) != Array::get(expected, at = i) {
            ok = false
          }
          i = i + 1
        }
        ok
      }
      ,
      _ => false
    }
  } with { Exception::Throw(_) => false }
}

/// `token_to_string` of the `i`-th token, or "" when the source does not lex
/// or is shorter than that.
fn nth_token_name(source: String, i: Int) -> String {
  handle {
    let tokens = lex(source)
    if i < Array::length(tokens) {
      token_to_string(Array::get(tokens, at = i))
    } else {
      ""
    }
  } with { Exception::Throw(_) => "" }
}

//# Misc

test "lex_simple_arithmetic" {
  assert(lex_match(source = "1 + 2 * 3", expected = [TInt(1), TPlus, TInt(2), TStar, TInt(3), TEof]))
}

test "lex_identifiers_and_keywords" {
  // #1280: `fn` is a reserved word — it lexes as TFn, not TIdent("fn").
  assert(lex_match(source = "let x = fn y", expected = [
    TLet,
    TIdent("x"),
    TEq,
    TFn,
    TIdent("y"),
    TEof
  ]))
}

test "lex_comparison_operators" {
  assert(eq(lex_len("a == b != c < d <= e > f >= g"), 14))
}

test "lex_logical_operators" {
  assert(lex_match(source = "a && b || !c", expected = [
    TIdent("a"),
    TAnd,
    TIdent("b"),
    TOr,
    TNot,
    TIdent("c"),
    TEof
  ]))
}

test "lex_bitwise_operators" {
  assert(lex_match(source = "a & b | c ^ d << e >> f", expected = [
    TIdent("a"),
    TBitAnd,
    TIdent("b"),
    TBitOr,
    TIdent("c"),
    TBitXor,
    TIdent("d"),
    TLShift,
    TIdent("e"),
    TRShift,
    TIdent("f"),
    TEof
  ]))
}

test "lex_arrows_and_pipe" {
  assert(lex_match(source = "x -> y => z |> w", expected = [
    TIdent("x"),
    TThinArrow,
    TIdent("y"),
    TArrow,
    TIdent("z"),
    TPipeGt,
    TIdent("w"),
    TEof
  ]))
}

test "lex_delimiters" {
  assert(lex_match(source = "( ) { } [ ] , ; . : ::", expected = [
    TLParen,
    TRParen,
    TLBrace,
    TRBrace,
    TLBracket,
    TRBracket,
    TComma,
    TSemicolon,
    TDot,
    TColon,
    TDoubleColon,
    TEof
  ]))
}

test "lex_string_literal" {
  assert(lex_match(source = "\"hello world\"", expected = [TString("hello world"), TEof]))
}

test "lex_string_escape" {
  assert(lex_match(source = "\"a\\nb\\tc\"", expected = [TString("a\nb\tc"), TEof]))
}

test "lex_string_interp_basic" {
  assert(assert_string_interp_parts(source = "\"hello \\{name}\"", expected = ["hello ", "name", ""]))
}

test "lex_string_interp_multiple" {
  assert(assert_string_interp_parts(source = "\"\\{a} + \\{b} = \\{a + b}\"", expected = [
    "",
    "a",
    " + ",
    "b",
    " = ",
    "a + b",
    ""
  ]))
}

test "lex_string_interp_nested_braces" {
  assert(assert_string_interp_parts(source = "\"value \\{if ok { left } else { right }}\"", expected = [
    "value ",
    "if ok { left } else { right }",
    ""
  ]))
}

/// Keeps string semantics pinned across multiple SIMD-width ordinary runs.
/// The sparse quote/backslash/control events must still be handled by the
/// scalar state machine, including escapes and interpolation boundaries.
test "lex_long_string_runs_preserve_sparse_events" allows Exception {
  match Array::get(lex("\"abcdefghijklmnopqrstuvwxyz0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ\\nabcdefghijklmnopqrstuvwxyz0123456789\""), at = 0) {
    TString(value) => inspect(value, "abcdefghijklmnopqrstuvwxyz0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ\nabcdefghijklmnopqrstuvwxyz0123456789"),
    other => inspect(token_to_string(other), "TString")
  }
  match Array::get(lex("\"abcdefghijklmnopqrstuvwxyz0123456789\\{name}ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789\""), at = 0) {
    TStringInterp(parts, _offsets) => {
      inspect(Array::length(parts), "3")
      inspect(Array::get(parts, at = 0), "abcdefghijklmnopqrstuvwxyz0123456789")
      inspect(Array::get(parts, at = 1), "name")
      inspect(Array::get(parts, at = 2), "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789")
    }
    ,
    other => inspect(token_to_string(other), "TStringInterp")
  }
  match Array::get(lex("\"abcdefghijklmnopqrstuvwxyz日本語0123456789\nABCDEFGHIJKLMNOPQRSTUVWXYZ\""), at = 0) {
    TString(value) => inspect(value, "abcdefghijklmnopqrstuvwxyz日本語0123456789\nABCDEFGHIJKLMNOPQRSTUVWXYZ"),
    other => inspect(token_to_string(other), "TString")
  }
  inspect(lex_err("\"abcdefghijklmnopqrstuvwxyz0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ"), "unterminated string")
}

test "lex_integer" {
  assert(lex_match(source = "42", expected = [TInt(42), TEof]))
}

test "lex_hex_integer" {
  assert(lex_match(source = "0xFF", expected = [TInt(255), TEof]))
}

test "lex_float" {
  assert(eq(lex_len("3.14"), 2))
}

test "lex_newline_before_bracket_inserts_semicolon" {
  // `expr <newline> [..]` is two statements (array literal), not a subscript:
  // the lexer inserts a synthetic `;` after an expression-ending token.
  assert(lex_match(source = "a\n[b]", expected = [
    TIdent("a"),
    TSemicolon,
    TLBracket,
    TIdent("b"),
    TRBracket,
    TEof
  ]))
}

test "lex_comment_newline_before_bracket_inserts_semicolon" {
  assert(lex_match(source = "a // comment\n[b]", expected = [
    TIdent("a"),
    TSemicolon,
    TLBracket,
    TIdent("b"),
    TRBracket,
    TEof
  ]))
}

/// #1318/#1319: an interpolated string ends an expression exactly like a plain
/// one, so `"a\{b}c" <newline> (d)` is two statements. Without the synthetic
/// `;` the `(d)` line was absorbed as a call argument list of the string.
test "lex_newline_paren_after_string_interp_inserts_semicolon" {
  assert(eq(nth_token_name(source = "\"a\\{b}c\"\n(d)", i = 1), "TSemicolon"))
}

/// The plain-string neighbour of the case above, pinning that both string
/// token kinds behave identically here.
test "lex_newline_paren_after_plain_string_inserts_semicolon" {
  assert(eq(nth_token_name(source = "\"ac\"\n(d)", i = 1), "TSemicolon"))
}

/// Same-line `(` after an interpolated string stays a call suffix (no
/// synthetic `;`) — the fix must not split expressions that are one line.
test "lex_same_line_paren_after_string_interp_is_call" {
  assert(eq(nth_token_name(source = "\"a\\{b}c\"(d)", i = 1), "TLParen"))
}

test "lex_same_line_bracket_is_subscript" {
  // Same-line `[` stays a postfix subscript (no synthetic `;`).
  assert(lex_match(source = "a[b]", expected = [
    TIdent("a"),
    TLBracket,
    TIdent("b"),
    TRBracket,
    TEof
  ]))
}

/// #1680: a newline terminates `break`. Without this synthetic separator the
/// next statement was greedily parsed as the payload and could then disappear
/// entirely in a statement-like loop.
test "lex_newline_after_break_inserts_semicolon" {
  assert(lex_match(source = "break\nside_effect()", expected = [
    TBreak,
    TSemicolon,
    TIdent("side_effect"),
    TLParen,
    TRParen,
    TEof
  ]))
}

test "lex_same_line_break_payload_has_no_semicolon" {
  assert(lex_match(source = "break side_effect()", expected = [
    TBreak,
    TIdent("side_effect"),
    TLParen,
    TRParen,
    TEof
  ]))
}

test "lex_newline_after_bare_break_before_close_has_no_semicolon" {
  assert(lex_match(source = "{ break\n}", expected = [TLBrace, TBreak, TRBrace, TEof]))
}

test "lex_newline_bracket_after_nonexpr_no_semicolon" {
  // After a non-expression-ending token (`,`), a newline + `[` does NOT get a
  // synthetic `;` — it is a normal array literal (e.g. a call argument).
  assert(lex_match(source = "f(a,\n[b])", expected = [
    TIdent("f"),
    TLParen,
    TIdent("a"),
    TComma,
    TLBracket,
    TIdent("b"),
    TRBracket,
    TRParen,
    TEof
  ]))
}

test "lex_chained_tuple_index" {
  // Regression (#---): chained tuple projection `t.0.0` must lex as
  // ident dot int dot int — NOT ident dot float(0.0). A number right after a
  // single field dot does not absorb a following `.<digit>` as a float decimal.
  assert(lex_match(source = "t.0.0", expected = [TIdent("t"), TDot, TInt(0), TDot, TInt(0), TEof]))
}

test "lex_tuple_index_then_float_unaffected" {
  // A real float literal (not after a field dot) still lexes as TFloat.
  assert(lex_match(source = "0.5", expected = [TFloat(0.5), TEof]))
}

/// #3543: the bits of the `TFloat` that `source` lexes to, beside the bits of
/// `Double::parse(text)`, as `hi:lo hi:lo`; the two must be identical.
fn lexed_float_bits(source: String, text: String) -> String {
  let lexed = handle {
    match Array::get(lex(source), at = 0) {
      TFloat(d) => "\{Double::to_i64_bits_hi(d)}:\{Double::to_i64_bits_lo(d)}",
      // An `f` literal is a `Float` (#3543 item 1); its payload is the f32
      // value held as a Double.
      TFloat32(d) => "\{Double::to_i64_bits_hi(d)}:\{Double::to_i64_bits_lo(d)}",
      _ => "not a float"
    }
  } with { Exception::Throw(msg) => msg }
  let parsed = match Double::parse(text) {
    Some(d) => "\{Double::to_i64_bits_hi(d)}:\{Double::to_i64_bits_lo(d)}",
    None => "None"
  }
  "\{lexed} \{parsed}"
}

test "lex_float_literal_is_correctly_rounded" {
  // #3543: the lexer's literal conversion answers exactly what
  // `Double::parse` does. The integer one below DBL_MAX + half an ulp is
  // DBL_MAX (it used to lex to Infinity); `1 + 3 * 2^-53` is a midpoint and
  // ties to the even 1.0000000000000004 (it used to take the odd neighbour).
  let below = ""
  inspect(lexed_float_bits(source = String::concat(below, ".0"), text = below), content = "2146435071:4294967295 2146435071:4294967295")
  let mid = "1.00000000000000033306690738754696212708950042724609375"
  inspect(lexed_float_bits(source = mid, text = mid), content = "1072693248:2 1072693248:2")
  inspect(lexed_float_bits(source = "0.1", text = "0.1"), content = "1069128089:2576980378 1069128089:2576980378")
  inspect(lexed_float_bits(source = "2.5f", text = "2.5"), content = "1074003968:0 1074003968:0")
}

test "lex_comment_skip" {
  assert(lex_match(source = "a // comment\nb", expected = [
    TIdent("a"),
    TSemicolon,
    TIdent("b"),
    TEof
  ]))
}

/// #3546: a line that begins a statement after a line that ended an
/// expression is marked with a synthetic `;`, so the parser can refuse two
/// expressions juxtaposed on ONE line. A line continued by an operator, a
/// line after a `}` and a declaration-header word (`where`) are not marked.
test "lex_statement_line_break" {
  assert(lex_match(source = "x\ny", expected = [TIdent("x"), TSemicolon, TIdent("y"), TEof]))
  assert(lex_match(source = "x y", expected = [TIdent("x"), TIdent("y"), TEof]))
  assert(lex_match(source = "x\n+ y", expected = [TIdent("x"), TPlus, TIdent("y"), TEof]))
  assert(lex_match(source = "}\ny", expected = [TRBrace, TIdent("y"), TEof]))
  assert(lex_match(source = "Int\nwhere", expected = [TIdent("Int"), TIdent("where"), TEof]))
}

