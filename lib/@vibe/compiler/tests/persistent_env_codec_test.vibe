//# Imports

import @vibe/compiler/core {
  BindingOrigin,
  EffectOwner,
  Subst,
  Type,
  TypeDef,
  TypeEnv,
  TypeExpr,
  env_bind_mut,
  env_bind_with_origin,
  env_cache,
  env_cached,
  env_lookup,
  env_lookup_binding,
  env_mut_escape,
  env_selectable_type_defs,
  env_type_defs,
  env_value_binding,
  env_value_binding_with_origin,
  trait_method_sig,
  trait_supers,
  type_implements_trait,
  types_equal
}

