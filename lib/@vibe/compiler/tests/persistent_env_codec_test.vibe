  trait_ref_key, type_param_key
}

import @vibe/compiler/runtime {
  parse_persistent_type_env, persistent_type_env_cache_text
}

import @vibe/core {
  array_empty
}

//# Helpers

fn cached_polymorphic_type() -> Type {
  CtForAll([7], [(7, ["Eq"])], CtFn([CtVar(7)], CtNamed("Box", [CtVar(7)]), Some("Async")))
}

fn cached_kinded_type() -> Type {
  CtForAll([8, 9], array_empty(), CtFn([CtApplied(CtVar(8), [CtVar(9)])], CtApplied(CtVar(8), [
    CtVar(9)
  ]), None))
}

fn cached_flat_rest() -> TypeEnv {
  EnvFlat([
    ("shadow", env_value_binding(CtInt)),
    ("flat", env_value_binding(CtTuple([CtChar, CtBytes]))),
    ("cached", env_value_binding(cached_polymorphic_type())),
    ("kinded", env_value_binding(cached_kinded_type()))
  ])
}

fn cached_mut_codec_fixture(_ origin: BindingOrigin) -> TypeEnv {
  let base = env_bind_with_origin(env = EnvEmpty, name = "imported", ty = CtChar, origin = origin)
  env_cache(env_bind_mut(env = env_bind_mut(env = base, name = "true_cell", ty = CtInt, escapes = true), name = "false_cell", ty = CtBool, escapes = false))
}

fn codec_fixture() -> TypeEnv {
  let methods = [
    ("map", [
      TyFn([TyName("Self")], TyApp("Result", [TyName("T"), TyName("E")]), Some("Error")),
      TyTuple([TyName("T"), TyUnit])
    ], TyFn([TyName("Self")], TyApp("Option", [TyName("T")]), None))
  ]
  EnvBind("shadow", env_value_binding(CtString), EnvTraitImplGen("Functor", [
    "T"
  ], [("T", ["Show", "Eq", "Eq"])], CtNamed("Box", [CtVar(7)]), EnvTraitImpl("Renderable", CtNamed("Box", [
    CtUnknown
  ]), EnvTraitDef("Functor", ["Show"], true, methods, env_cached(names = [
    "cached",
    "flat",
    "shadow"
  ], bindings = [
    env_value_binding(cached_polymorphic_type()),
    env_value_binding(CtTuple([CtChar, CtBytes])),
    env_value_binding(CtInt)
  ], rest = cached_flat_rest()), [type_param_key(name = "F", arity = 1), "E"], [
    ("map", [type_param_key(name = "G", arity = 2)], [
      (type_param_key(name = "G", arity = 2), ["Eq", "Show"])
    ])
  ]))))
}

fn retained_trait_header_params(env: TypeEnv, name: String) -> Array[String] {
  match env {
    EnvEmpty => [],
    EnvBind(_, _, rest) => retained_trait_header_params(env = rest, name = name),
    EnvTraitDef(trait_name, _, _, _, rest, header_params, _) => if trait_name == name {
      header_params
    } else {
      retained_trait_header_params(env = rest, name = name)
    },
    EnvTraitImpl(_, _, rest) => retained_trait_header_params(env = rest, name = name),
    EnvShowWrappers(_, _, rest) => retained_trait_header_params(env = rest, name = name),
    EnvMutCell(_, _, rest) => retained_trait_header_params(env = rest, name = name),
    EnvTraitImplGen(_, _, _, _, rest) => retained_trait_header_params(env = rest, name = name),
    EnvTypeDefs(_, _, rest) => retained_trait_header_params(env = rest, name = name),
    EnvFlat(_) => [],
    EnvCached(_, _, rest) => retained_trait_header_params(env = rest, name = name)
  }
}

fn retained_trait_method_gens(env: TypeEnv, name: String) -> Array[(String, Array[String], Array[(String, Array[String])])] {
  match env {
    EnvEmpty => array_empty(),
    EnvBind(_, _, rest) => retained_trait_method_gens(env = rest, name = name),
    EnvTraitDef(trait_name, _, _, _, rest, _, method_gens) => if trait_name == name {
      method_gens
    } else {
      retained_trait_method_gens(env = rest, name = name)
    },
    EnvTraitImpl(_, _, rest) => retained_trait_method_gens(env = rest, name = name),
    EnvShowWrappers(_, _, rest) => retained_trait_method_gens(env = rest, name = name),
    EnvMutCell(_, _, rest) => retained_trait_method_gens(env = rest, name = name),
    EnvTraitImplGen(_, _, _, _, rest) => retained_trait_method_gens(env = rest, name = name),
    EnvTypeDefs(_, _, rest) => retained_trait_method_gens(env = rest, name = name),
    EnvFlat(_) => array_empty(),
    EnvCached(_, _, rest) => retained_trait_method_gens(env = rest, name = name)
  }
}

fn retained_generic_impl_bounds(env: TypeEnv, name: String) -> Array[(String, Array[String])] {
  match env {
    EnvEmpty => [],
    EnvBind(_, _, rest) => retained_generic_impl_bounds(env = rest, name = name),
    EnvTraitDef(_, _, _, _, rest, _, _) => retained_generic_impl_bounds(env = rest, name = name),
    EnvTraitImpl(_, _, rest) => retained_generic_impl_bounds(env = rest, name = name),
    EnvShowWrappers(_, _, rest) => retained_generic_impl_bounds(env = rest, name = name),
    EnvMutCell(_, _, rest) => retained_generic_impl_bounds(env = rest, name = name),
    EnvTraitImplGen(trait_name, _, bounds, _, rest) => if trait_name == name {
      bounds
    } else {
      retained_generic_impl_bounds(env = rest, name = name)
    },
    EnvTypeDefs(_, _, rest) => retained_generic_impl_bounds(env = rest, name = name),
    EnvFlat(_) => [],
    EnvCached(_, _, rest) => retained_generic_impl_bounds(env = rest, name = name)
  }
}

fn retained_impl_targets(env: TypeEnv, name: String) -> Array[Type] {
  match env {
    EnvEmpty => [],
    EnvBind(_, _, rest) => retained_impl_targets(env = rest, name = name),
    EnvTraitDef(_, _, _, _, rest, _, _) => retained_impl_targets(env = rest, name = name),
    EnvTraitImpl(trait_name, target, rest) => {
      if trait_name == name {
        Array::concat([target], retained_impl_targets(env = rest, name = name))
      } else {
        retained_impl_targets(env = rest, name = name)
      }
    },
    EnvShowWrappers(_, _, rest) => retained_impl_targets(env = rest, name = name),
    EnvMutCell(_, _, rest) => retained_impl_targets(env = rest, name = name),
    EnvTraitImplGen(trait_name, _, _, target, rest) => {
      if trait_name == name {
        Array::concat([target], retained_impl_targets(env = rest, name = name))
      } else {
        retained_impl_targets(env = rest, name = name)
      }
    },
    EnvTypeDefs(_, _, rest) => retained_impl_targets(env = rest, name = name),
    EnvFlat(_) => [],
    EnvCached(_, _, rest) => retained_impl_targets(env = rest, name = name)
  }
}

fn malformed_rejected(_ text: String) -> Bool {
  handle {
    match parse_persistent_type_env(text) {
      Some(_) => false,
      None => true
    }
  } with { Exception::Throw(_) => true }
}

//# Tests

test "persistent TypeEnv v10 bytes retain binding provenance" {
  let plain = EnvBind("x", env_value_binding(CtInt), EnvEmpty)
  let originated = env_bind_with_origin(env = EnvEmpty, name = "x", ty = CtInt, origin = BindingOriginModuleExport("/dep.vibe", "source_x"))
  let plain_text = persistent_type_env_cache_text(plain)
  let originated_text = persistent_type_env_cache_text(originated)
  assert(plain_text != originated_text)
  match parse_persistent_type_env(originated_text) {
    Some(decoded) => match env_lookup_binding(env = decoded, name = "x") {
      Some(binding) => match binding.origin {
        BindingOriginModuleExport(path, source) => assert(path == "/dep.vibe" && source == "source_x"),
        _ => assert(false)
      },
      None => assert(false)
    },
    None => assert(false)
  }
}

test "persistent TypeEnv v10 retains flat binding provenance" {
  let env = EnvFlat([
    ("x", env_value_binding_with_origin(ty = CtInt, origin = BindingOriginModuleExport("/dep.vibe", "source_x")))
  ])
  match parse_persistent_type_env(persistent_type_env_cache_text(env)) {
    Some(decoded) => match env_lookup_binding(env = decoded, name = "x") {
      Some(binding) => match binding.origin {
        BindingOriginModuleExport(path, source) => assert(path == "/dep.vibe" && source == "source_x"),
        _ => assert(false)
      },
      None => assert(false)
    },
    None => assert(false)
  }
}

test "fixpoint bytes retain cached mut TypeEnv v10" {
  let encoded = persistent_type_env_cache_text(cached_mut_codec_fixture(BindingOriginModuleExport("/dep.vibe", "source_imported")))
  match parse_persistent_type_env(encoded) {
    Some(decoded) => inspect(persistent_type_env_cache_text(decoded) == encoded, "true"),
    None => assert(false)
  }
}

test "truefact survives cached mut TypeEnv v10 decode" {
  let encoded = persistent_type_env_cache_text(cached_mut_codec_fixture(BindingOriginUnavailable))
  match parse_persistent_type_env(encoded) {
    Some(decoded) => match env_mut_escape(env = decoded, name = "true_cell") {
      Some(value) => inspect(value, "true"),
      None => assert(false)
    },
    None => assert(false)
  }
}

test "falsefact survives cached mut TypeEnv v10 decode" {
  let encoded = persistent_type_env_cache_text(cached_mut_codec_fixture(BindingOriginUnavailable))
  match parse_persistent_type_env(encoded) {
    Some(decoded) => match env_mut_escape(env = decoded, name = "false_cell") {
      Some(value) => inspect(value, "false"),
      None => assert(false)
    },
    None => assert(false)
  }
}

test "binding origin survives cached mut TypeEnv v10 decode" {
  let encoded = persistent_type_env_cache_text(cached_mut_codec_fixture(BindingOriginModuleExport("/dep.vibe", "source_imported")))
  match parse_persistent_type_env(encoded) {
    Some(decoded) => match env_lookup_binding(env = decoded, name = "imported") {
      Some(binding) => match binding.origin {
        BindingOriginModuleExport(path, source) => inspect(path == "/dep.vibe" && source == "source_imported" && types_equal(a = binding.ty, b = CtChar), "true"),
        _ => assert(false)
      },
      None => assert(false)
    },
    None => assert(false)
  }
}

test "persistent module interface v9 round-trips every variant and trait payload" {
  let env = codec_fixture()
  let encoded = persistent_type_env_cache_text(env)
  assert(String::starts_with(encoded, prefix = "version\t10\nenv\t"))
  // TDRE10 binds this canonical text externally but does not wrap the
  // production TypeEnv-v10 transport envelope itself.
  assert(String::index_of(encoded, needle = "TDRE10") < 0)
  match parse_persistent_type_env(encoded) {
    Some(decoded) => {
      assert(persistent_type_env_cache_text(decoded) == encoded)
      match env_lookup(env = decoded, name = "shadow") {
        Some(ty) => assert(types_equal(a = ty, b = CtString)),
        None => assert(false)
      }
      match env_lookup(env = decoded, name = "cached") {
        Some(ty) => assert(types_equal(a = ty, b = cached_polymorphic_type())),
        None => assert(false)
      }
      match env_lookup(env = decoded, name = "kinded") {
        Some(ty) => assert(types_equal(a = ty, b = cached_kinded_type())),
        None => assert(false)
      }
      assert(Array::get(trait_supers(env = decoded, name = "Functor"), at = 0) == "Show")
      let header_params = retained_trait_header_params(env = decoded, name = "Functor")
      assert(Array::length(header_params) == 2)
      assert(Array::get(header_params, at = 0) == type_param_key(name = "F", arity = 1))
      assert(Array::get(header_params, at = 1) == "E")
      let method_gens = retained_trait_method_gens(env = decoded, name = "Functor")
      assert(Array::length(method_gens) == 1)
      let (generic_method, generic_params, generic_bounds) = Array::get(method_gens, at = 0)
      assert(generic_method == "map")
      assert(Array::get(generic_params, at = 0) == type_param_key(name = "G", arity = 2))
      let (generic_bound_name, generic_bound_labels) = Array::get(generic_bounds, at = 0)
      assert(generic_bound_name == type_param_key(name = "G", arity = 2))
      assert(Array::get(generic_bound_labels, at = 0) == "Eq")
      let impl_bounds = retained_generic_impl_bounds(env = decoded, name = "Functor")
      assert(Array::length(impl_bounds) == 1)
      let (bound_name, bound_labels) = Array::get(impl_bounds, at = 0)
      assert(bound_name == "T")
      assert(Array::length(bound_labels) == 3)
      assert(Array::get(bound_labels, at = 0) == "Show")
      assert(Array::get(bound_labels, at = 1) == "Eq")
      assert(Array::get(bound_labels, at = 2) == "Eq")
      match trait_method_sig(env = decoded, trait_name = "Functor", method_name = "map") {
        Some((params, ret)) => {
          assert(Array::length(params) == 2)
          match Array::get(params, at = 0) {
            TyFn(_, _, Some("Error")) => assert(true),
            _ => assert(false)
          }
          match ret {
            TyFn(_, TyApp("Option", _), None) => assert(true),
            _ => assert(false)
          }
        },
        None => assert(false)
      }
    },
    None => assert(false)
  }
}

test "persistent module interface retains complete concrete and generic impl targets" {
  let int_box = CtNamed("Box", [CtInt])
  let string_box = CtNamed("Box", [CtString])
  let reordered_pair = CtNamed("Pair", [CtNamed("B", []), CtNamed("A", [])])
  let env = EnvTraitImpl("Observed", int_box, EnvTraitImpl("Observed", string_box, EnvTraitImplGen("Observed", [
    "A",
    "B"
  ], [], reordered_pair, EnvEmpty)))
  match parse_persistent_type_env(persistent_type_env_cache_text(env)) {
    Some(decoded) => {
      let targets = retained_impl_targets(env = decoded, name = "Observed")
      assert(Array::length(targets) == 3)
      assert(types_equal(a = Array::get(targets, at = 0), b = int_box))
      assert(types_equal(a = Array::get(targets, at = 1), b = string_box))
      assert(types_equal(a = Array::get(targets, at = 2), b = reordered_pair))
      assert(!types_equal(a = Array::get(targets, at = 0), b = Array::get(targets, at = 1)))
    },
    None => assert(false)
  }
}

test "persistent TypeEnv v10 retains applied trait bounds and impl heads" {
  let applied = trait_ref_key(TyApp("Value", [TyName("Int")]))
  let constructor_self = trait_ref_key(TyApp("Mappable", [
    TyName("$trait_bound_self$")
  ]))
  let env = EnvBind("read", env_value_binding(CtForAll([7], [
    (7, [applied, constructor_self])
  ], CtFn([CtVar(7)], CtInt, None))), EnvTraitDef("Value", [], false, [], EnvTraitImpl(applied, CtInt, EnvEmpty), [
    "A"
  ], []))
  match parse_persistent_type_env(persistent_type_env_cache_text(env)) {
    Some(decoded) => {
      match env_lookup(env = decoded, name = "read") {
        Some(CtForAll(_, bounds, _)) => {
          let (_, labels) = Array::get(bounds, at = 0)
          assert(Array::get(labels, at = 0) == applied)
          assert(Array::get(labels, at = 1) == constructor_self)
        },
        _ => assert(false)
      }
      assert(type_implements_trait(env = decoded, s = SubstEmpty, ty = CtInt, trait_name = applied))
    },
    None => assert(false)
  }
}

test "persistent module interface v9 round-trips enum struct and alias authority" {
  let defs = [
    TDEnum("Choice", ["T"], [("Pick", [CtNamed("T", [])])]),
    TDStruct("Box", [("value", CtNamed("T", []))], [], ["T"]),
    TDAlias("ChoiceBox", [], CtStruct("Box"))
  ]
  let env = EnvTypeDefs(defs, ["Choice", "Box", "ChoiceBox"], EnvBind("Choice", env_value_binding(CtEnum("Choice")), EnvEmpty))
  match parse_persistent_type_env(persistent_type_env_cache_text(env)) {
    Some(decoded) => {
      let decoded_defs = env_type_defs(decoded)
      assert(Array::length(decoded_defs) == 3)
      match (Array::get(decoded_defs, at = 0), Array::get(decoded_defs, at = 1), Array::get(decoded_defs, at = 2)) {
        (TDEnum(name, params, variants), TDStruct(struct_name, fields, _, struct_params), TDAlias(alias, _, CtStruct(target))) => {
          assert(name == "Choice")
          assert(Array::get(params, at = 0) == "T")
          let (variant, payload) = Array::get(variants, at = 0)
          assert(variant == "Pick")
          assert(Array::length(payload) == 1)
          assert(struct_name == "Box")
          assert(Array::get(struct_params, at = 0) == "T")
          assert(Array::get(fields, at = 0).0 == "value")
          assert(alias == "ChoiceBox")
          assert(target == "Box")
        },
        _ => assert(false)
      }
    },
    None => assert(false)
  }
}

test "persistent module interface v9 round-trips effect and effectset authority" {
  let env = EnvTypeDefs([
    TDEffect("Audit", [("Emit", [CtString], CtUnit)], [], [], ProgramHandled),
    TDEffectSet("Audits", ["Audit"])
  ], ["Audits"], EnvEmpty)
  match parse_persistent_type_env(persistent_type_env_cache_text(env)) {
    Some(decoded) => {
      let defs = env_type_defs(decoded)
      assert(Array::length(defs) == 2)
      assert(Array::length(env_selectable_type_defs(decoded)) == 1)
      assert(Array::get(env_selectable_type_defs(decoded), at = 0) == "Audits")
      match (Array::get(defs, at = 0), Array::get(defs, at = 1)) {
        (TDEffect(effect_name, ops, _, _, _), TDEffectSet(set_name, members)) => {
          assert(effect_name == "Audit")
          assert(Array::get(ops, at = 0).0 == "Emit")
          assert(set_name == "Audits")
          assert(Array::get(members, at = 0) == "Audit")
        },
        _ => assert(false)
      }
    },
    None => assert(false)
  }
}

test "an effect's resource kinds survive the persistent codec (ADR-0094)" {
  let env = EnvTypeDefs([
    TDEffect("Kv", [("Get", [CtString], CtString)], ["R"], ["Store::Bucket"], ProgramHandled),
    TDEffect("Log", [("Emit", [CtString], CtUnit)], ["T"], [""], ProgramHandled)
  ], [], EnvEmpty)
  let text = persistent_type_env_cache_text(env)
  // Only the effect with a resource kind takes the `Q` form; the other keeps
  // the earlier `K` bytes.
  assert(String::contains(text, needle = "Q2:Kv"))
  assert(String::contains(text, needle = "K3:Log"))
  match parse_persistent_type_env(text) {
    Some(decoded) => {
      let defs = env_type_defs(decoded)
      match (Array::get(defs, at = 0), Array::get(defs, at = 1)) {
        (TDEffect(_, _, kv_params, kv_kinds, _), TDEffect(_, _, log_params, log_kinds, _)) => {
          inspect(String::join(kv_params, sep = ","), content = "R")
          inspect(String::join(kv_kinds, sep = ","), content = "Store::Bucket")
          inspect(String::join(log_params, sep = ","), content = "T")
          inspect(Array::length(log_kinds), content = "1")
          inspect(Array::get(log_kinds, at = 0), content = "")
        },
        _ => assert(false)
      }
    },
    None => assert(false)
  }
}

test "legacy enum carrier bytes cannot alter v6 typedef authority" {
  let declared = TDEnum("Choice", [], [("Pick", [CtInt])])
  // This was the retired `Choice::__variants__` value carrier. It is valid
  // TypeEnv data but EnvTypeDefs must remain the only declaration authority.
  let env = EnvTypeDefs([declared], ["Choice"], EnvBind("Choice::__variants__", env_value_binding(CtNamed("__variants__", [
    CtNamed("Corrupt", [CtString])
  ])), EnvEmpty))
  match parse_persistent_type_env(persistent_type_env_cache_text(env)) {
    Some(decoded) => {
      let defs = env_type_defs(decoded)
      assert(Array::length(defs) == 1)
      match Array::get(defs, at = 0) {
        TDEnum(name, params, variants) => {
          assert(name == "Choice")
          assert(Array::length(params) == 0)
          let (variant, fields) = Array::get(variants, at = 0)
          assert(variant == "Pick")
          assert(Array::get(fields, at = 0) == CtInt)
        },
        _ => assert(false)
      }
    },
    None => assert(false)
  }
}

test "persistent module interface v9 rebuilds untrusted cached lookup indexes" {
  let corrupt = env_cached(names = ["shadow", "shadow", "cached"], bindings = [
    env_value_binding(CtBool),
    env_value_binding(CtString),
    env_value_binding(CtUnit)
  ], rest = cached_flat_rest())
  match parse_persistent_type_env(persistent_type_env_cache_text(corrupt)) {
    Some(decoded) => {
      match env_lookup(env = decoded, name = "cached") {
        Some(ty) => assert(types_equal(a = ty, b = cached_polymorphic_type())),
        None => assert(false)
      }
      match env_lookup(env = decoded, name = "flat") {
        Some(ty) => assert(types_equal(a = ty, b = CtTuple([CtChar, CtBytes]))),
        None => assert(false)
      }
      match env_lookup(env = decoded, name = "shadow") {
        Some(ty) => assert(types_equal(a = ty, b = CtInt)),
        None => assert(false)
      }
    },
    None => assert(false)
  }
}

test "persistent module interface v9 rejects old, truncated, and malformed envelopes" {
  assert(malformed_rejected("version\t1\nbind\tvalue\tI\n"))
  assert(malformed_rejected("version\t2\nenv\t1:0\n"))
  // Bare v3 was a value/trait-only TypeEnv, never an empty declaration interface.
  assert(malformed_rejected("version\t3\nenv\t1:0\n"))
  assert(malformed_rejected("version\t4\nenv\t1:0\n"))
  assert(malformed_rejected("version\t8\nenv\t1:0\n"))
  assert(malformed_rejected("version\t10\nenv\t"))
  assert(malformed_rejected("version\t10\nenv\t1:Z\n"))
  assert(malformed_rejected("version\t10\nenv\t2:00\n"))
  assert(malformed_rejected("version\t10\nenv\t4:B0:0\n"))
  assert(malformed_rejected("version\t10\nenv\t1:0\ntrailing"))
}

test "cached row IDs preserve the v9 transport bytes from the sorted-array representation" {
  // Captured from 397a0c4b2 before EnvCached gained an immutable name index.
  // Disk transport rebuilds the accelerator from the authoritative tail.
  let env = env_cached(names = ["Aa", "Aa", "BB"], bindings = [
    env_value_binding(CtBool),
    env_value_binding(CtString),
    env_value_binding(CtInt)
  ], rest = EnvBind("tail", env_value_binding(CtChar), EnvEmpty))
  inspect(persistent_type_env_cache_text(env), "version\t10\nenv\t46:C2[14:#active_region4:tail]2[1:U1:H]B4:tailHU0\n")
}
