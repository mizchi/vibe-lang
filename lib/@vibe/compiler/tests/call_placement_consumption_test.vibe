import @vibe/compiler/core {
  Expr, Stmt, Type, TypeEnv, call_placement_install, env_bind, restore_call_placements
}
import @vibe/compiler/checker {
  check_program_with_env_typed_lowering_located_observation
}
import @vibe/compiler/normalize {
  desugar_inspect_calls, lower_checked_call_placements
}
import @vibe/parser {
  lex_with_offsets, parse_program_located
}
import @vibe/compiler/syntax {
  print_program
}

fn parsed(_ source: String) -> Array[Stmt] with Exception {
  let (tokens, starts, _) = lex_with_offsets(source)
  parse_program_located(tokens = tokens, starts = starts, source = source)
}

fn placed(source: String, env: TypeEnv) -> Array[Stmt] with Exception {
  let (_, rows, _, _) = check_program_with_env_typed_lowering_located_observation(stmts = parsed(source), initial_env = env)
  let raw = parsed(source)
  match rows {
    Some(found) => restore_call_placements(stmts = raw, rows = found),
    None => assert(false)
  }
  lower_checked_call_placements(stmts = raw, require_checked = true)
  raw
}

/// The consumer follows the imported binding's checker answer without seeing
/// a declaration or an independent parameter-name table.
test "imported placements determine argument order" {
  let env = env_bind(env = env_bind(env = EnvEmpty, name = "f", ty = CtFn([
    CtInt,
    CtInt
  ], CtInt, None)), name = "#params:f", ty = CtRecord([
    ("y", CtUnknown),
    ("x", CtUnknown)
  ]))
  let result = placed(source = "fn main() -> Int { f(y = 3, x = 10) }", env = env)
  assert(print_program(result) == print_program(parsed("fn main() -> Int { f(3, 10) }")))
}

/// Omission and Some insertion are explicit indices in the packet, rather
/// than questions asked of a callee's spelling while lowering.
test "optional placements fill omitted slots and wrap written values" {
  let head = "fn f(x: Int, y?: Int) -> Int { x }\nfn main() -> Int { "
  for pair in [
    ("f(x = 10)", "f(10, None)"),
    ("f(x = 10, y = 3)", "f(10, Some(3))"),
    ("f(x = 10, y? = None)", "f(10, None)")
  ] {
    assert(print_program(placed(source = head + pair.0 + " }", env = EnvEmpty)) == print_program(parsed(head + pair.1 + " }")))
  }
}

/// Equal expressions are separate evaluations. Source indices keep their
/// written-order bindings distinct even when expression equality cannot.
test "equal calls keep separate written-order bindings" {
  let cell: Array[Int] = []
  call_placement_install(cell = cell, written = 2, mode = 0, slots = [4, 2])
  let first_call: Expr = ECall(EIdent("record", -1), [EString("same", -1)], -1, [
  ])
  let second_call: Expr = ECall(EIdent("record", -1), [EString("same", -1)], -1, [
  ])
  assert(first_call == second_call)
  let stmts = [SExpr(ECall(EIdent("f", 7), [first_call, second_call], 7, cell))]
  lower_checked_call_placements(stmts = stmts, require_checked = true)
  match Array::get(stmts, at = 0) {
    SExpr(ELet(first, ECall(EIdent("record", _), _, -1, _), ELet(second, ECall(EIdent("record", _), _, -1, _), ECall(EIdent("f", _), args, _, _), _), _)) => {
      assert(first != second)
      match (Array::get(args, at = 0), Array::get(args, at = 1)) {
        (EIdent(left, _), EIdent(right, _)) => assert(left == second && right == first),
        _ => assert(false)
      }
    },
    _ => assert(false)
  }
}

/// A rowless lane must name the source call and the edit instead of using
/// a syntactic declaration table as an alternate semantic authority.
test "strict lowering refuses an unchecked labeled call" {
  let message = handle {
    lower_checked_call_placements(stmts = parsed("fn f(x: Int) -> Int { x }\nfn main() -> Int { f(x = 3) }"), require_checked = true)
    ""
  } with { Exception::Throw(message) => message }
  assert(String::contains(message, needle = "checker argument placement for `f`"))
  assert(String::contains(message, needle = "check this source before lowering it"))
}

/// A rowless macro must not erase the only labeled source call before the
/// strict consumer can report its original name and the edit.
test "a rowless inspect expansion retains its placement refusal" {
  let stmts = parsed("fn main() -> Unit allows Console { inspect(1, content = \"1\") }")
  desugar_inspect_calls(stmts)
  let message = handle {
    lower_checked_call_placements(stmts = stmts, require_checked = true); ""
  } with { Exception::Throw(message) => message }
  assert(String::contains(message, needle = "checker argument placement for `inspect`"))
  assert(String::contains(message, needle = "check this source before lowering it"))
}

/// A header seeded through `initial_env` plus `#params:f` is an imported
/// declaration, so an unlabeled call to it is refused as a filesystem
/// import's would be (ADR-0120 Phase 4; Codex on #3881).
test "an unlabeled call to a seeded import header is refused" {
  let env = env_bind(env = env_bind(env = EnvEmpty, name = "f", ty = CtFn([
    CtInt,
    CtInt
  ], CtInt, None)), name = "#params:f", ty = CtRecord([
    ("y", CtUnknown),
    ("x", CtUnknown)
  ]))
  let message = handle {
    let _ = check_program_with_env_typed_lowering_located_observation(stmts = parsed("fn main() -> Int { f(10, 3) }"), initial_env = env)
    ""
  } with { Exception::Throw(message) => message }
  assert(String::contains(message, needle = "label the arguments of f: write `y = ` before argument 1, `x = ` before argument 2"))
}
