//# Focused pure tests for compiler-internal TDRE5 canonical record framing.

import @vibe/compiler/runtime {
  typing_dependency_record_decode_internal, typing_dependency_record_encode_internal
}

fn tdre5_fields_equal(actual: Array[String], expected: Array[String]) -> Bool {
  if Array::length(actual) != Array::length(expected) {
    false
  } else {
    let mut equal = true
    let mut i = 0
    while equal && i < Array::length(expected) {
      equal = Array::get(actual, at = i) == Array::get(expected, at = i)
      i = i + 1
    }
    equal
  }
}

fn tdre5_assert_decoded(decoded: Option[Array[String]], expected: Array[String], encoded: String, tag: String) -> Unit {
  match decoded {
    Some(fields) => {
      assert(tdre5_fields_equal(actual = fields, expected = expected))
      assert(typing_dependency_record_encode_internal(tag = tag, fields = fields) == encoded)
    },
    None => assert(false)
  }
}

fn tdre5_assert_rejected(text: String, expected_tag: String, expected_fields: Int) -> Unit {
  match typing_dependency_record_decode_internal(text = text, expected_tag = expected_tag, expected_fields = expected_fields) {
    Some(_) => assert(false),
    None => assert(true)
  }
}

test "TDRE5 canonical records round-trip empty and opaque special fields across every tag" {
  let empty: Array[String] = []
  let empty_tags = ["TDEO5", "TDI5", "TDRA5", "TDC5", "TDREW5"]
  let mut empty_i = 0
  while empty_i < Array::length(empty_tags) {
    let tag = Array::get(empty_tags, at = empty_i)
    let encoded = typing_dependency_record_encode_internal(tag = tag, fields = empty)
    tdre5_assert_decoded(decoded = typing_dependency_record_decode_internal(text = encoded, expected_tag = tag, expected_fields = 0), expected = empty, encoded = encoded, tag = tag)
    empty_i = empty_i + 1
  }
  let fields = [
    "",
    ":left[right]",
    "line one\nline two\r\n",
    "日本語🙂",
    "TDEO5/TDI5/TDRA5/TDC5/TDREW5"
  ]
  let tags = ["TDEO5", "TDI5", "TDRA5", "TDC5", "TDREW5"]
  let mut i = 0
  while i < Array::length(tags) {
    let tag = Array::get(tags, at = i)
    let encoded = typing_dependency_record_encode_internal(tag = tag, fields = fields)
    tdre5_assert_decoded(decoded = typing_dependency_record_decode_internal(text = encoded, expected_tag = tag, expected_fields = 5), expected = fields, encoded = encoded, tag = tag)
    i = i + 1
  }
}

test "TDRE5 decoder rejects wrong tags arity counts and noncanonical decimals" {
  assert(typing_dependency_record_encode_internal(tag = "TDRE5", fields = []) == "")
  tdre5_assert_rejected(text = "TDRE50[]", expected_tag = "TDRE5", expected_fields = 0)
  tdre5_assert_rejected(text = "0[]", expected_tag = "", expected_fields = 0)
  let tdeo = typing_dependency_record_encode_internal(tag = "TDEO5", fields = ["x"])
  tdre5_assert_rejected(text = tdeo, expected_tag = "TDI5", expected_fields = 1)
  tdre5_assert_rejected(text = tdeo, expected_tag = "TDEO5", expected_fields = 0)
  tdre5_assert_rejected(text = "TDEO50[]", expected_tag = "TDREW5", expected_fields = 0)
  tdre5_assert_rejected(text = "TDEO500[]", expected_tag = "TDEO5", expected_fields = 0)
  tdre5_assert_rejected(text = "TDEO5-1[]", expected_tag = "TDEO5", expected_fields = 1)
  tdre5_assert_rejected(text = "TDEO5+1[0:]", expected_tag = "TDEO5", expected_fields = 1)
  tdre5_assert_rejected(text = "TDEO5 1[0:]", expected_tag = "TDEO5", expected_fields = 1)
  tdre5_assert_rejected(text = "TDEO5[]", expected_tag = "TDEO5", expected_fields = 0)
  tdre5_assert_rejected(text = "TDEO51[01:x]", expected_tag = "TDEO5", expected_fields = 1)
  tdre5_assert_rejected(text = "TDEO51[00:]", expected_tag = "TDEO5", expected_fields = 1)
  tdre5_assert_rejected(text = "TDEO51[-1:x]", expected_tag = "TDEO5", expected_fields = 1)
  tdre5_assert_rejected(text = "TDEO51[+1:x]", expected_tag = "TDEO5", expected_fields = 1)
  tdre5_assert_rejected(text = "TDEO51[ 1:x]", expected_tag = "TDEO5", expected_fields = 1)
  tdre5_assert_rejected(text = "TDEO51[:x]", expected_tag = "TDEO5", expected_fields = 1)
  tdre5_assert_rejected(text = "TDEO52[0:]", expected_tag = "TDEO5", expected_fields = 2)
  tdre5_assert_rejected(text = "TDEO51[0:0:x]", expected_tag = "TDEO5", expected_fields = 1)
}

test "TDRE5 decoder rejects overflow truncation missing delimiters brackets and trailing data" {
  tdre5_assert_rejected(text = "", expected_tag = "TDC5", expected_fields = 0)
  tdre5_assert_rejected(text = "TDC", expected_tag = "TDC5", expected_fields = 0)
  tdre5_assert_rejected(text = "TDC52305843009213693951[]", expected_tag = "TDC5", expected_fields = 0)
  tdre5_assert_rejected(text = "TDC51[2305843009213693951:x]", expected_tag = "TDC5", expected_fields = 1)
  tdre5_assert_rejected(text = "TDC51[3:ab]", expected_tag = "TDC5", expected_fields = 1)
  tdre5_assert_rejected(text = "TDC51[0:", expected_tag = "TDC5", expected_fields = 1)
  tdre5_assert_rejected(text = "TDC51[1x]", expected_tag = "TDC5", expected_fields = 1)
  tdre5_assert_rejected(text = "TDC51{1:x}", expected_tag = "TDC5", expected_fields = 1)
  tdre5_assert_rejected(text = "TDC51[1:x", expected_tag = "TDC5", expected_fields = 1)
  tdre5_assert_rejected(text = "TDC51[1:x}", expected_tag = "TDC5", expected_fields = 1)
  tdre5_assert_rejected(text = "TDC51[1:x]trailing", expected_tag = "TDC5", expected_fields = 1)
  tdre5_assert_rejected(text = "TDC50[]\n", expected_tag = "TDC5", expected_fields = 0)
}
