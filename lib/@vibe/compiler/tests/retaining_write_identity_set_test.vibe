import ./checker_parity_test_support.vibe {
  check_source_report
}

// #3255: the builtin `Array::set` keeps its retained argument after the
// region write check moved to resolved identities. Its own file, because its
// expected text is the same as the `Array::push` refusal in
// `retaining_write_identity_test.vibe`, and `vibe test --update` picks a
// snapshot by its expected literal.

test "the builtin Array::set keeps its retained argument" {
  let set_src = "fn build() -> Int {\n  let sink: Array[MutList[Int]] = []\n  region r {\n    let cell = MutList::empty(r)\n    Array::set(sink, at = 0, value = cell)\n    0\n  }\n}\n"
  inspect(check_source_report(set_src), content = "region escapes its scope: a container write stores a value that captures this region into an outer binding")
}
