//# Imports

import @vibe/compiler/syntax {
  lex, parse_program, print_program
}
//# Functions

fn roundtrip(source: String) -> Bool {
  handle {
    let s1 = print_program(parse_program(lex(source)))
    let s2 = print_program(parse_program(lex(s1)))
    String::equals(s1, s2)
  } with Error {
    Throw(_) => false
  }
}

fn format_once(source: String) -> String with Error {
  print_program(parse_program(lex(source)))
}

//# Misc

test "int" {
  assert(roundtrip("42"))
}

test "float" {
  assert(roundtrip("3.14"))
}

test "string" {
  assert(roundtrip("\"hello\""))
}

test "bool true" {
  assert(roundtrip("true"))
}

test "bool false" {
  assert(roundtrip("false"))
}

test "char" {
  assert(roundtrip("'a'"))
}

test "binop" {
  assert(roundtrip("1 + 2 * 3"))
}

test "unary minus" {
  assert(roundtrip("-5"))
}

test "unary not" {
  assert(roundtrip("!true"))
}

test "comparison" {
  assert(roundtrip("1 < 2"))
}

test "logic" {
  assert(roundtrip("true && false || true"))
}

test "call" {
  assert(roundtrip("f(1, 2)"))
}

test "qualified call" {
  assert(roundtrip("String::length(\"hi\")"))
}

test "array" {
  assert(roundtrip("[1, 2, 3]"))
}

test "tuple" {
  assert(roundtrip("(1, 2, 3)"))
}

test "record" {
  assert(roundtrip("record { x: 1, y: 2 }"))
}

/// #836: named struct constructor literal, and its field shorthand (which
/// the printer always expands to the full `name: name` form, so both inputs
/// converge on the same printed output and stay round-trip stable).
test "struct literal ctor" {
  assert(roundtrip("Point::{ x: 1, y: 2 }"))
}

test "struct literal ctor field shorthand" {
  assert(roundtrip("Point::{ x, y }"))
}

test "map" {
  assert(roundtrip("Map::from_pairs([(\"a\", 1)])"))
  assert(roundtrip("Map::new()"))
}

test "if" {
  assert(roundtrip("if true { 1 } else { 0 }"))
}

test "block" {
  assert(roundtrip("{ let x = 1\nx }"))
}

test "match int" {
  assert(roundtrip("match 1 { 0 => 10, _ => 20 }"))
}

test "match string" {
  assert(roundtrip("match \"a\" { \"a\" => 1, _ => 0 }"))
}

test "pipe" {
  assert(roundtrip("5 |> f"))
}

test "let" {
  assert(roundtrip("let x = 42\nx"))
}

test "let mut" {
  assert(roundtrip("let mut x = 0\nx"))
}

test "let rec" {
  assert(roundtrip("let rec f: (Int) -> Int = (n) -> { if n <= 0 { 0 } else { f(n - 1) } }\nf(5)"))
}

test "let with type" {
  assert(roundtrip("let x: Int = 42\nx"))
}

test "assign" {
  assert(roundtrip("let mut x = 0\nx = 1\nx"))
}

test "assign add" {
  assert(roundtrip("let mut x = 0\nx += 1\nx"))
}

test "fn basic" {
  assert(roundtrip("let f: (Int) -> Int = (x) -> { x + 1 }\nf(5)"))
}

test "fn canonical typed let" {
  assert(roundtrip("let f: (Int) -> Int = (x) -> { x + 1 }\nf(5)"))
}

test "printer keeps spaces in effect sets" {
  let result = handle {
    format_once("let f: () -> Int with { Error } = () -> { 1 }")
  } with Error {
    Throw(e) => String::concat("ERROR: ", e)
  }
  assert(result == "let f: () -> Int with { Error } = () -> { 1 }")
}

test "fn multi param" {
  assert(roundtrip("let add: (Int, Int) -> Int = (a, b) -> { a + b }\nadd(1, 2)"))
}

test "fn no return type" {
  assert(roundtrip("let f = (x: Int) { x }"))
}

test "fn labeled" {
  assert(roundtrip("let f: (x~: Int) -> Int = (x~) -> { x }\nf(x=1)"))
}

test "fn generic" {
  assert(roundtrip("let id: [T](T) -> T = (x) -> { x }\nid(42)"))
}

test "while" {
  assert(roundtrip("let mut i = 0\nwhile i < 10 { i = i + 1 }\ni"))
}

test "for in" {
  assert(roundtrip("for x in [1, 2, 3] { x * 2 }"))
}

test "for in with index" {
  assert(roundtrip("let mut s = 0\nfor x, i in [1, 2, 3] { s = s + i }\ns"))
}

test "break" {
  assert(roundtrip("let mut i = 0\nwhile true { if i >= 5 { break }\ni = i + 1 }\ni"))
}

test "loop" {
  assert(roundtrip("loop (i = 0, acc = 0) { if i >= 5 { break(acc) } else { continue(i + 1, acc + i) } }"))
}

test "enum" {
  assert(roundtrip("enum Color { Red; Green; Blue }\nmatch Red { Red => 1, _ => 0 }"))
}

test "enum with payload" {
  assert(roundtrip("enum Opt { None; Some(Int) }\nmatch Some(42) { Some(n) => n, None => 0 }"))
}

test "struct" {
  assert(roundtrip("struct Point { x: Int; y: Int }\nlet p = Point::{ x: 1, y: 2 }\np.x"))
}

test "type alias" {
  assert(roundtrip("type Pair = (Int, Int)\nlet p: Pair = (1, 2)\np"))
}

test "suberror" {
  assert(roundtrip("suberror AppError { NotFound; BadInput(String) }"))
}

test "trait" {
  assert(roundtrip("trait Eq"))
}

test "handle" {
  assert(roundtrip("handle { 42 } with Error { Throw(_) => -1 }"))
}

test "handle throw" {
  assert(roundtrip("handle { throw(\"x\")\n0 } with Error { Throw(msg) => String::length(msg) }"))
}

test "effectful fn" {
  assert(roundtrip("let f: () -> Int with { Error } = () -> { throw(\"x\")\n0 }\nhandle { f() } with Error { Throw(_) => 99 }"))
}

test "pat wildcard" {
  assert(roundtrip("match 1 { _ => 0 }"))
}

test "pat bind" {
  assert(roundtrip("match 1 { x => x }"))
}

test "pat int" {
  assert(roundtrip("match 1 { 0 => 10, 1 => 20, _ => 30 }"))
}

test "pat string" {
  assert(roundtrip("match \"a\" { \"a\" => 1, _ => 0 }"))
}

test "pat bool" {
  assert(roundtrip("match true { true => 1, false => 0 }"))
}

test "pat tuple" {
  // #859: tuple-pattern let is only supported in a function/block body, not
  // at top level (where it's now a rejected parse error) -- round-trip
  // through a function body instead.
  assert(roundtrip("fn f() -> Int {\nlet (a, b) = (1, 2)\na + b\n}"))
}

test "pat ctor" {
  assert(roundtrip("enum Opt { None; Some(Int) }\nmatch Some(42) { Some(n) => n, None => 0 }"))
}

test "expr stmt starts with tuple after let" {
  assert(roundtrip("let x = 1\n(1, 2)"))
}

test "import" {
  assert(roundtrip("import ./foo.vibe { bar }"))
}

test "export" {
  assert(roundtrip("export { foo, bar }"))
}

test "export let" {
  assert(roundtrip("export let x = 42"))
}

test "export enum" {
  assert(roundtrip("export enum Color { Red; Blue }"))
}
