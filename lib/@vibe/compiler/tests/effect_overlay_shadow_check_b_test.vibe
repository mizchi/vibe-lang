import @vibe/compiler/core {
  Expr
}

import @vibe/core {
  array_empty
}

import @vibe/compiler/checker {
  check_perform_effects_expr_tx
}

test "B: unshadowed callback param call is still flagged" {
  let call_f = ECall(EIdent("f", -1), [EIdent("x", -1)], -1, [])
  let errors = check_perform_effects_expr_tx(root = call_f, root_declared = array_empty(), root_in_handle = false, fn_names = array_empty(), fn_effs = array_empty(), root_ov_names = [
    "f"
  ], root_ov_effs = [["Fs"]], checked_error_row = false)
  assert(Array::length(errors) == 1)
}
