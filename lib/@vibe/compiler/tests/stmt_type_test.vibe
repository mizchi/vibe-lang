//# Imports

import ./stmt_test_support.vibe {
  pt
}

//# Misc

test "type_name" {
  assert(pt("Int") == "Int")
}

test "type_unit" {
  assert(pt("()") == "()")
}

test "type_app_single" {
  assert(pt("Array[Int]") == "Array[Int]")
}

test "type_app_multi" {
  assert(pt("Map[String, Int]") == "Map[String, Int]")
}

test "type_fn" {
  assert(pt("(Int) -> String") == "(Int) -> String")
}

test "type_fn_multi_params" {
  assert(pt("(Int, String) -> Bool") == "(Int, String) -> Bool")
}

test "type_fn_unit_param" {
  assert(pt("() -> Int") == "() -> Int")
}

test "type_tuple" {
  assert(pt("(Int, String)") == "(Int, String)")
}

test "type_nested" {
  assert(pt("Array[Option[Int]]") == "Array[Option[Int]]")
}

test "type_option_sugar" {
  assert(pt("Int?") == "Option[Int]")
}

test "type_option_sugar_nested" {
  assert(pt("Array[Int]?") == "Option[Array[Int]]")
}

test "type_fn_returning_fn" {
  assert(pt("(Int) -> (String) -> Bool") == "(Int) -> (String) -> Bool")
}
