//# Imports

import @vibe/compiler/cache {
  AST_BINARY_MAGIC_A,
  AST_BINARY_MAGIC_S,
  AST_BINARY_MAGIC_T,
  AST_BINARY_MAGIC_V,
  AST_BINARY_VERSION,
  ast_binary_read_bool,
  ast_binary_read_byte,
  ast_binary_read_header,
  ast_binary_read_header_checked,
  ast_binary_read_module,
  ast_binary_read_optstr,
  ast_binary_read_span,
  ast_binary_read_string,
  ast_binary_read_string_checked,
  ast_binary_read_svarint,
  ast_binary_read_svarint_checked,
  ast_binary_read_varint,
  ast_binary_read_varint_checked,
  ast_binary_reader_new,
  ast_binary_reader_remaining,
  ast_binary_reader_take,
  ast_binary_write_bool,
  ast_binary_write_header,
  ast_binary_write_optstr,
  ast_binary_write_span,
  ast_binary_write_string,
  ast_binary_write_svarint,
  ast_binary_write_varint
}

test "ast_binary: child cursors cannot read adjacent bytes or nested UTF-8" {
  let r = ast_binary_reader_new(Bytes::from_array([1, 194, 162, 9]))
  let child = ast_binary_reader_take(r = r, length = 2)
  let outcome = handle {
    let _ = ast_binary_read_string_checked(child); "accepted"
  } with { Exception::Throw(msg) => msg }
  inspect(outcome, content = "ast_binary: string is not well-formed UTF-8 within its declared length")
  inspect(ast_binary_read_byte(r), content = "162")
  inspect(ast_binary_read_byte(r), content = "9")
  inspect(ast_binary_reader_remaining(r), content = "0")
  let bytes = ast_binary_reader_new(Bytes::from_array([42, 43, 44]))
  let outer = ast_binary_reader_take(r = bytes, length = 2)
  let inner = ast_binary_reader_take(r = outer, length = 1)
  inspect(ast_binary_read_byte(inner), content = "42")
  inspect(ast_binary_read_byte(inner), content = "-1")
  inspect(ast_binary_read_byte(outer), content = "43")
  inspect(ast_binary_read_byte(outer), content = "-1")
  inspect(ast_binary_read_byte(bytes), content = "44")
}

test "ast_binary: child lengths are checked before the parent advances" {
  let r = ast_binary_reader_new(Bytes::from_array([7, 8]))
  for length in [0 - 1, 3] {
    let outcome = handle {
      let _ = ast_binary_reader_take(r = r, length = length); "accepted"
    } with { Exception::Throw(msg) => msg }
    inspect(outcome, content = "ast_binary: child length exceeds remaining input")
    inspect(ast_binary_reader_remaining(r), content = "2")
  }
  let empty = ast_binary_reader_take(r = r, length = 0)
  inspect(ast_binary_read_byte(empty), content = "-1")
  inspect(ast_binary_read_byte(r), content = "7")
}

//# Functions

/// Assert the MESSAGE, not merely that something was refused: a decoder that
/// threw for the wrong reason would pass a bare "it refused" check.
fn svarint_outcome(_ raw: Array[Int]) -> String {
  handle {
    __to_string(ast_binary_read_svarint_checked(ast_binary_reader_new(Bytes::from_array(raw))))
  } with { Exception::Throw(msg) => msg }
}

fn varint_outcome(_ raw: Array[Int]) -> String {
  handle {
    __to_string(ast_binary_read_varint_checked(ast_binary_reader_new(Bytes::from_array(raw))))
  } with { Exception::Throw(msg) => msg }
}

fn module_outcome(_ raw: Array[Int]) -> String {
  handle {
    __to_string(Array::length(ast_binary_read_module(ast_binary_reader_new(Bytes::from_array(raw)))))
  } with { Exception::Throw(msg) => msg }
}

//# Misc — parity tests against docs/internal/compiler/ast_binary_abi.md

test "ast_binary: varint encodes/decodes the same canonical bytes" {
  // 0  → [0x00]
  let b1 = Bytes::new()
  ast_binary_write_varint(buf = b1, v = 0)
  assert(Bytes::length(b1) == 1)
  assert(Bytes::get(b1, at = 0) == 0)
  // 127 → [0x7F]
  let b2 = Bytes::new()
  ast_binary_write_varint(buf = b2, v = 127)
  assert(Bytes::length(b2) == 1)
  assert(Bytes::get(b2, at = 0) == 127)
  // 128 → [0x80, 0x01]
  let b3 = Bytes::new()
  ast_binary_write_varint(buf = b3, v = 128)
  assert(Bytes::length(b3) == 2)
  assert(Bytes::get(b3, at = 0) == 128)
  assert(Bytes::get(b3, at = 1) == 1)
  // 16384 → [0x80, 0x80, 0x01]
  let b4 = Bytes::new()
  ast_binary_write_varint(buf = b4, v = 16384)
  assert(Bytes::length(b4) == 3)
  assert(Bytes::get(b4, at = 0) == 128)
  assert(Bytes::get(b4, at = 1) == 128)
  assert(Bytes::get(b4, at = 2) == 1)
}

test "ast_binary: varint roundtrip" {
  let cases: Array[Int] = [0, 1, 42, 127, 128, 200, 16384, 1000000]
  let mut i = 0
  while i < Array::length(cases) {
    let v = Array::get(cases, at = i)
    let buf = Bytes::new()
    ast_binary_write_varint(buf = buf, v = v)
    let r = ast_binary_reader_new(buf)
    assert(ast_binary_read_varint(r) == v)
    i = i + 1
  }
}

test "ast_binary: svarint canonical bytes" {
  // sleb128: -1 → [0x7F]
  let b1 = Bytes::new()
  ast_binary_write_svarint(buf = b1, v = 0 - 1)
  assert(Bytes::length(b1) == 1)
  assert(Bytes::get(b1, at = 0) == 127)
  // 0 → [0x00]
  let b2 = Bytes::new()
  ast_binary_write_svarint(buf = b2, v = 0)
  assert(Bytes::length(b2) == 1)
  assert(Bytes::get(b2, at = 0) == 0)
  // 63 → [0x3F] (fits in 7 bits with sign-bit 0)
  let b3 = Bytes::new()
  ast_binary_write_svarint(buf = b3, v = 63)
  assert(Bytes::length(b3) == 1)
  assert(Bytes::get(b3, at = 0) == 63)
  // 64 → [0xC0, 0x00] (sign-bit 0 in 2nd byte to disambiguate from -64)
  let b4 = Bytes::new()
  ast_binary_write_svarint(buf = b4, v = 64)
  assert(Bytes::length(b4) == 2)
  assert(Bytes::get(b4, at = 0) == 192)
  assert(Bytes::get(b4, at = 1) == 0)
  // -64 → [0x40] (sign-bit 1)
  let b5 = Bytes::new()
  ast_binary_write_svarint(buf = b5, v = 0 - 64)
  assert(Bytes::length(b5) == 1)
  assert(Bytes::get(b5, at = 0) == 64)
}

test "ast_binary: svarint roundtrip incl negatives" {
  let cases: Array[Int] = [
    0,
    1,
    42,
    63,
    64,
    100,
    127,
    128,
    200,
    0 - 1,
    0 - 42,
    0 - 63,
    0 - 64,
    0 - 100,
    0 - 128
  ]
  let mut i = 0
  while i < Array::length(cases) {
    let v = Array::get(cases, at = i)
    let buf = Bytes::new()
    ast_binary_write_svarint(buf = buf, v = v)
    let r = ast_binary_reader_new(buf)
    let got = ast_binary_read_svarint(r)
    assert(got == v)
    i = i + 1
  }
}

test "ast_binary: bool roundtrip" {
  let b_true = Bytes::new()
  ast_binary_write_bool(buf = b_true, b = true)
  assert(Bytes::get(b_true, at = 0) == 1)
  let b_false = Bytes::new()
  ast_binary_write_bool(buf = b_false, b = false)
  assert(Bytes::get(b_false, at = 0) == 0)
  assert(ast_binary_read_bool(ast_binary_reader_new(b_true)))
  let r = ast_binary_reader_new(b_false)
  if ast_binary_read_bool(r) {
    assert(false)
  } else {
    assert(true)
  }
}

test "ast_binary: ASCII string roundtrip" {
  let buf = Bytes::new()
  ast_binary_write_string(buf = buf, s = "hello")
  // varint(5) followed by 5 ASCII bytes
  assert(Bytes::length(buf) == 6)
  assert(Bytes::get(buf, at = 0) == 5)
  assert(Bytes::get(buf, at = 1) == 104)
  // 'h'
  assert(Bytes::get(buf, at = 2) == 101)
  // 'e'
  assert(Bytes::get(buf, at = 3) == 108)
  // 'l'
  assert(Bytes::get(buf, at = 4) == 108)
  // 'l'
  assert(Bytes::get(buf, at = 5) == 111)
  // 'o'
  let r = ast_binary_reader_new(buf)
  let s = ast_binary_read_string(r)
  assert(s == "hello")
}

test "ast_binary: empty string roundtrip" {
  let buf = Bytes::new()
  ast_binary_write_string(buf = buf, s = "")
  assert(Bytes::length(buf) == 1)
  assert(Bytes::get(buf, at = 0) == 0)
  let r = ast_binary_reader_new(buf)
  let s = ast_binary_read_string(r)
  assert(s == "")
}

test "ast_binary: byte strings survive chunk boundaries and input mutation" {
  let buf = Bytes::new()
  ast_binary_write_varint(buf = buf, v = 2051)
  let mut i = 0
  while i < 2051 {
    Bytes::push(buf, value = i % 256)
    i = i + 1
  }
  let reader = ast_binary_reader_new(buf)
  let decoded = ast_binary_read_string(reader)
  inspect(String::length(decoded), content = "2051")
  let mut exact = true
  i = 0
  while i < 2051 {
    if String::char_code_at(decoded, at = i) != i % 256 {
      exact = false
    }
    i = i + 1
  }
  inspect(exact, content = "true")
  Bytes::set(buf, at = 2, value = 99)
  inspect(String::char_code_at(decoded, at = 0), content = "0")
  inspect(ast_binary_read_byte(reader), content = "-1")
}

test "ast_binary: optstr roundtrip" {
  let bn = Bytes::new()
  ast_binary_write_optstr(buf = bn, o = None)
  assert(Bytes::length(bn) == 1)
  assert(Bytes::get(bn, at = 0) == 0)
  let bs = Bytes::new()
  ast_binary_write_optstr(buf = bs, o = Some("hi"))
  // 0x01 + varint(2) + 'h','i'
  assert(Bytes::length(bs) == 4)
  assert(Bytes::get(bs, at = 0) == 1)
  assert(Bytes::get(bs, at = 1) == 2)
  let r1 = ast_binary_reader_new(bn)
  match ast_binary_read_optstr(r1) {
    None => assert(true)
    Some(_) => assert(false)
  }
  let r2 = ast_binary_reader_new(bs)
  match ast_binary_read_optstr(r2) {
    None => assert(false)
    Some(s) => assert(s == "hi")
  }
}

test "ast_binary: span roundtrip" {
  let buf = Bytes::new()
  ast_binary_write_span(buf = buf, start = 10, end = 42)
  let r = ast_binary_reader_new(buf)
  let p = ast_binary_read_span(r)
  let (start, end) = p
  assert(start == 10)
  assert(end == 42)
}

test "ast_binary: span(0,0) is two zero bytes" {
  let buf = Bytes::new()
  ast_binary_write_span(buf = buf, start = 0, end = 0)
  assert(Bytes::length(buf) == 2)
  assert(Bytes::get(buf, at = 0) == 0)
  assert(Bytes::get(buf, at = 1) == 0)
}

test "ast_binary: header magic + version" {
  let buf = Bytes::new()
  ast_binary_write_header(buf)
  // 4 magic bytes + 1 byte varint(1)
  assert(Bytes::length(buf) == 5)
  assert(Bytes::get(buf, at = 0) == AST_BINARY_MAGIC_V)
  assert(Bytes::get(buf, at = 1) == AST_BINARY_MAGIC_A)
  assert(Bytes::get(buf, at = 2) == AST_BINARY_MAGIC_S)
  assert(Bytes::get(buf, at = 3) == AST_BINARY_MAGIC_T)
  assert(Bytes::get(buf, at = 4) == AST_BINARY_VERSION)
  let r = ast_binary_reader_new(buf)
  let h = ast_binary_read_header(r)
  let (ok, v) = h
  assert(ok)
  assert(v == AST_BINARY_VERSION)
}

test "ast_binary: header bad magic rejected" {
  // Magic doesn't match → ok=false
  let buf = Bytes::new()
  Bytes::push(buf, value = 0)
  Bytes::push(buf, value = 0)
  Bytes::push(buf, value = 0)
  Bytes::push(buf, value = 0)
  Bytes::push(buf, value = 1)
  let r = ast_binary_reader_new(buf)
  let h = ast_binary_read_header(r)
  let (ok, _) = h
  if ok {
    assert(false)
  } else {
    assert(true)
  }
}

//# The empty module's bytes, pinned so any implementation of
//# docs/internal/compiler/ast_binary_abi.md can be checked against them: header (5 bytes) +
//# array_count varint(0) (1 byte) = 6 total, 'v','A','S','T', version=1,
//# count=0. This used to cite the MoonBit host's `serialize_module_binary`
//# as the producer; that host was retired in #594, so the citation named
//# something that no longer exists.
test "ast_binary: empty-module canonical bytes" {
  let expected = Bytes::new()
  Bytes::push(expected, value = AST_BINARY_MAGIC_V)
  Bytes::push(expected, value = AST_BINARY_MAGIC_A)
  Bytes::push(expected, value = AST_BINARY_MAGIC_S)
  Bytes::push(expected, value = AST_BINARY_MAGIC_T)
  Bytes::push(expected, value = AST_BINARY_VERSION)
  Bytes::push(expected, value = 0)
  // Compose the same locally and assert byte-by-byte.
  let actual = Bytes::new()
  ast_binary_write_header(actual)
  ast_binary_write_varint(buf = actual, v = 0)
  assert(Bytes::length(actual) == Bytes::length(expected))
  let mut i = 0
  while i < Bytes::length(expected) {
    assert(Bytes::get(actual, at = i) == Bytes::get(expected, at = i))
    i = i + 1
  }
}

//# Misc — what a CORRUPT blob must not be able to say (#2647 Codex round 13)

test "ast_binary: svarint padding must repeat the sign already accumulated" {
  // Nine 0x80 bytes then 0x7f. The range guard used to admit a final 127
  // whatever the accumulated sign was; its payload then shifted into
  // positions a 63-bit `Int` does not have, `shift` reached 70, and the
  // sign-extension arm was skipped -- so this answered 0 for a value the
  // format cannot represent. Measured before the fix: "0".
  assert_eq(svarint_outcome([128, 128, 128, 128, 128, 128, 128, 128, 128, 127]), "ast_binary: svarint exceeds the representable Int range")
  // The control at the boundary, so the guard cannot pass by refusing
  // everything long: -2^62 IS representable, and its canonical encoding is
  // eight 0x80 bytes then 0x40 -- nine bytes reaching bit 62.
  assert_eq(svarint_outcome([128, 128, 128, 128, 128, 128, 128, 128, 64]), "-4611686018427387904")
  // And the ordinary short forms still decode.
  assert_eq(svarint_outcome([127]), "-1")
  assert_eq(svarint_outcome([1]), "1")
}

test "ast_binary: a varint must be in canonical form" {
  // `0x81 0x00` is 1 spelled in two bytes. The RANGE guard cannot see it --
  // the padding group is empty, so `(b & 127) != 0` never fires -- which is
  // why reading the version through the checked reader alone would not have
  // closed this.
  assert_eq(varint_outcome([129, 0]), "ast_binary: varint is not in canonical form")
  // Canonical multi-byte encodings are untouched: 128 is [0x80, 0x01].
  assert_eq(varint_outcome([128, 1]), "128")
  // A single 0x00 is the canonical encoding of 0, not a padded anything.
  assert_eq(varint_outcome([0]), "0")
  assert_eq(varint_outcome([1]), "1")
}

test "ast_binary: the module decoder reads its version through the checked reader" {
  // Magic + version 6 + count 0 -- the empty module, accepted.
  assert_eq(module_outcome([118, 65, 83, 84, 6, 0]), "0")
  // Magic + a PADDED version 6 + count 0 (`134, 0` is 6 in two bytes). The raw
  // header reader answers `version == 6` and the blob used to decode as an
  // empty AST -- a wrong answer rather than a cache miss.
  assert_eq(module_outcome([118, 65, 83, 84, 134, 0, 0]), "ast_binary: varint is not in canonical form")
  // An unsupported version is still reported as one. `99`, not a neighbour of
  // the current version: this line used to say `2`, and the bump made `2` the
  // accepted one, so the assertion inverted into "refuse what we accept".
  assert_eq(module_outcome([118, 65, 83, 84, 99, 0]), "ast_binary: unsupported version 99")
  // The RETIRED versions are refused too, not read as the current one.
  assert_eq(module_outcome([118, 65, 83, 84, 1, 0]), "ast_binary: unsupported version 1")
  assert_eq(module_outcome([118, 65, 83, 84, 3, 0]), "ast_binary: unsupported version 3")
  assert_eq(module_outcome([118, 65, 83, 84, 4, 0]), "ast_binary: unsupported version 4")
  // Bad magic is still bad magic.
  assert_eq(module_outcome([0, 0, 0, 0, 1, 0]), "ast_binary: bad magic")
}

test "ast_binary: the checked header twin answers like the raw one on good input" {
  let buf = Bytes::new()
  ast_binary_write_header(buf)
  let (ok, v) = handle {
    ast_binary_read_header_checked(ast_binary_reader_new(buf))
  } with { Exception::Throw(_msg) => (false, 0) }
  assert(ok)
  assert(v == AST_BINARY_VERSION)
}

fn raw_string_packet(_ padding: Int) -> Bytes {
  let bytes = Bytes::new()
  // ASCII followed by the independently specified UTF-8 of é, 🍣 and NUL.
  ast_binary_write_varint(buf = bytes, v = padding + 7)
  let mut i = 0
  while i < padding {
    Bytes::push(bytes, value = 97)
    i = i + 1
  }
  for b in [195, 169, 240, 159, 141, 163, 0] {
    Bytes::push(bytes, value = b)
  }
  Bytes::push(bytes, value = 127)
  bytes
}

test "ast_binary: string boundaries preserve canonical UTF-8 NUL and cursor" {
  for padding in [0, 1016, 1017, 1018] {
    let reader = ast_binary_reader_new(raw_string_packet(padding))
    let value = ast_binary_read_string_checked(reader)
    inspect(String::length(value) == padding + 7, content = "true")
    inspect(String::char_code_at(value, at = padding), content = "195")
    inspect(String::char_code_at(value, at = padding + 1), content = "169")
    inspect(String::char_code_at(value, at = padding + 2), content = "240")
    inspect(String::char_code_at(value, at = padding + 3), content = "159")
    inspect(String::char_code_at(value, at = padding + 4), content = "141")
    inspect(String::char_code_at(value, at = padding + 5), content = "163")
    inspect(String::char_code_at(value, at = padding + 6), content = "0")
    inspect(ast_binary_read_byte(reader), content = "127")
  }
}

test "ast_binary: empty one-byte and truncated raw strings keep cursor semantics" {
  let empty = ast_binary_reader_new(Bytes::from_array([0, 127]))
  inspect(ast_binary_read_string(empty), content = "")
  inspect(ast_binary_read_byte(empty), content = "127")
  let single = ast_binary_reader_new(Bytes::from_array([1, 97, 127]))
  inspect(ast_binary_read_string(single), content = "a")
  inspect(ast_binary_read_byte(single), content = "127")
  let short = ast_binary_reader_new(Bytes::from_array([5, 97, 98, 195, 169]))
  inspect(ast_binary_read_string(short), content = "abé")
  inspect(ast_binary_read_byte(short), content = "-1")
  let refusal = handle {
    ast_binary_read_string_checked(ast_binary_reader_new(Bytes::from_array([
      5,
      97,
      98,
      195,
      169
    ])))
  } with { Exception::Throw(message) => message }
  inspect(refusal, content = "ast_binary: string length exceeds remaining input")
}
