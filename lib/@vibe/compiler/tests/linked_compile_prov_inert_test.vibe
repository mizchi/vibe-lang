import @vibe/compiler/codegen/common_base {
  DbgProv, codegen_body_cache_new, empty_dbg_prov, module_split_none
}

import @vibe/compiler/codegen/wasi {
  compile_wasi_module_linked_with_cache_policy,
  compile_wasi_module_rc_cached_impl_with_prov,
  compile_wasi_module_rc_cached_impl_with_typed_offsets,
  compile_wasi_module_rc_impl_with_prov_grants
}

import @vibe/compiler/core {
  Stmt
}

import @vibe/compiler/syntax {
  lex, lex_with_offsets, parse_program, parse_program_located
}

// #2575 item 2: the ordinary lane now carries the merged program's
// statement-to-module map to codegen. `prelude_run_per_module` is measured
// exact and cannot be CALLED by a production compile, because
// `effect_lowering_prelude` takes only the merged statement array -- nothing
// downstream can split it by module. Carrying the map is the prerequisite.
//
// Carrying it must change nothing until something reads it, and "must change
// nothing" has exactly one honest test: compile the same program both ways and
// compare the BYTES.
//
// WHAT THIS TEST DOES NOT COVER, measured rather than assumed. The owner-key
// scan in `compile_wasi_module_linked_impl_with_typed_offsets` was gated on
// `Array::length(prov.stmt_file_id) > 0` -- a PROXY for the break lane,
// correct only while the break lane was the only caller filling provenance.
// Filling it here would have switched that scan on for every ordinary compile
// (one `hoisted_lambda_owner_of_stmt` plus two pushes per top-level statement,
// ~9.9k of them on the compiler's own closure) with the arrays never read, so
// the guard now tests `debug_break`. Reverting it to the proxy and re-running
// this file still PASSES: the scan fills arrays nothing consumes, so it is
// pure COST and byte-inert. The guard is therefore not pinned here and cannot
// be -- where it shows up is the perf report's selfcompile allocation row.

fn program_stmts(_ src: String) -> Array[Stmt] with Exception {
  parse_program(lex(src))
}

/// The checker's typed-lowering tables, empty: this lane compiles a parsed
/// program directly, so there are no offsets to thread. Named rather than
/// spelled `[]` five times per call, which the formatter breaks across lines.
fn no_ints() -> Array[Int] {
  []
}

fn no_keys() -> Array[String] {
  []
}

fn rc_plain(_ stmts: Array[Stmt]) -> Bytes with Exception {
  compile_wasi_module_rc_cached_impl_with_typed_offsets(stmts_in = stmts, entry_name = "main", body_cache_in = codegen_body_cache_new(), body_cache_out = codegen_body_cache_new(), checker_float_call_offsets = no_ints(), checker_int_render_offsets = no_ints(), checker_bool_render_offsets = no_ints(), checker_eq_offsets = no_ints(), checker_eq_type_keys = no_keys())
}

fn rc_with_prov(stmts: Array[Stmt], prov: DbgProv) -> Bytes with Exception {
  compile_wasi_module_rc_cached_impl_with_prov(stmts_in = stmts, entry_name = "main", body_cache_in = codegen_body_cache_new(), body_cache_out = codegen_body_cache_new(), prov = prov, checker_float_call_offsets = no_ints(), checker_int_render_offsets = no_ints(), checker_bool_render_offsets = no_ints(), checker_eq_offsets = no_ints(), checker_eq_type_keys = no_keys())
}

fn src_two_modules() -> String {
  "fn helper(n: Int) -> Int {\n  n + 1\n}\n\nstruct Pt {\n  x: Int;\n  y: Int\n} derive (Eq)\n\nfn main() -> Int {\n  let a = Pt::{ x: helper(1), y: 2 }\n  let b = Pt::{ x: 2, y: 2 }\n  if a == b {\n    helper(10)\n  } else {\n    0\n  }\n}\n"
}

/// A map shaped like the one `ordinary_lane_dbg_prov` builds: every statement
/// attributed to one of two modules, split down the middle.
fn two_module_prov(_ n: Int) -> DbgProv {
  let ids: Array[Int] = []
  let mut i = 0
  while i < n {
    Array::push(ids, value = if i < n / 2 {
      0
    } else {
      1
    })
    i = i + 1
  }
  DbgProv::{ files: ["a.vibe", "b.vibe"], file_nls: [], stmt_file_id: ids }
}

test "carrying the statement-to-module map does not change a byte of the output" {
  let stmts = program_stmts(src_two_modules())
  let without = rc_plain(stmts)
  let with_map = rc_with_prov(stmts = program_stmts(src_two_modules()), prov = two_module_prov(Array::length(stmts)))
  // Same length AND same bytes. Length alone would pass on a module that
  // differed only in a function's contents, which is exactly what a wrongly
  // enabled owner scan or a misread file id would produce.
  inspect(Bytes::length(with_map) == Bytes::length(without), content = "true")
  let mut i = 0
  let mut first_diff = 0 - 1
  while i < Bytes::length(without) && i < Bytes::length(with_map) {
    if Bytes::get(with_map, at = i) != Bytes::get(without, at = i) && first_diff < 0 {
      first_diff = i
    } else {
      ()
    }
    i = i + 1
  }
  inspect(first_diff, content = "-1")
  // And the compile is not vacuously empty -- an entry that produced nothing
  // would compare equal to itself and prove nothing.
  inspect(Bytes::length(without) > 0, content = "true")
}

test "an empty map and a full one are the same compile" {
  // The wrapper passes `empty_dbg_prov()`, so this pins that the two entries
  // agree when the map carries nothing: a difference here would mean the new
  // parameter changed the compile by existing rather than by its contents.
  let stmts = program_stmts(src_two_modules())
  let via_wrapper = rc_plain(stmts)
  let via_empty = rc_with_prov(stmts = program_stmts(src_two_modules()), prov = empty_dbg_prov())
  inspect(Bytes::length(via_empty) == Bytes::length(via_wrapper), content = "true")
}

fn policy_program_stmts(_ source: String) -> Array[Stmt] with Exception {
  let (tokens, starts, _) = lex_with_offsets(source)
  parse_program_located(tokens = tokens, starts = starts, source = source)
}

fn policy_bytes_equal(a: Bytes, b: Bytes) -> Bool {
  if Bytes::length(a) != Bytes::length(b) {
    return false
  } else ()
  let mut i = 0
  while i < Bytes::length(a) {
    if Bytes::get(a, at = i) != Bytes::get(b, at = i) {
      return false
    } else ()
    i = i + 1
  }
  true
}

fn policy_plain(stmts: Array[Stmt], prov: DbgProv) -> Bytes with Exception {
  compile_wasi_module_rc_impl_with_prov_grants(stmts_in = stmts, entry_name = "main", prov = prov, checker_float_call_offsets = no_ints(), checker_int_render_offsets = no_ints(), checker_bool_render_offsets = no_ints(), checker_eq_offsets = no_ints(), checker_eq_type_keys = no_keys(), grants = [
  ], exports_stripped = false)
}

fn policy_live_prov(source: String, file: String, count: Int) -> DbgProv {
  let newlines: Array[Int] = []
  let mut i = 0
  while i < String::length(source) {
    if String::char_code_at(source, at = i) == 10 {
      Array::push(newlines, value = i)
    } else ()
    i = i + 1
  }
  let ids: Array[Int] = []
  let mut j = 0
  while j < count {
    Array::push(ids, value = 0); j = j + 1
  }
  DbgProv::{ files: [file], file_nls: [newlines], stmt_file_id: ids }
}

test "disabling body caching preserves RC production output" {
  let source = src_two_modules()
  let old = rc_with_prov(stmts = policy_program_stmts(source), prov = empty_dbg_prov())
  let plain = policy_plain(stmts = policy_program_stmts(source), prov = empty_dbg_prov())
  assert(Bytes::length(plain) > 0)
  inspect(policy_bytes_equal(a = old, b = plain), content = "true")
}

test "disabling body caching retains live production line maps" {
  let source = src_two_modules()
  let count = Array::length(policy_program_stmts(source))
  let old = rc_with_prov(stmts = policy_program_stmts(source), prov = policy_live_prov(source = source, file = "original.vibe", count = count))
  let plain = policy_plain(stmts = policy_program_stmts(source), prov = policy_live_prov(source = source, file = "original.vibe", count = count))
  let renamed = policy_plain(stmts = policy_program_stmts(source), prov = policy_live_prov(source = source, file = "renamed.vibe", count = count))
  inspect(policy_bytes_equal(a = old, b = plain), content = "true")
  inspect(!policy_bytes_equal(a = plain, b = renamed), content = "true")
}

test "disabled body cache ignores poisoned input and does not harvest output" {
  let source = src_two_modules()
  let harvested = codegen_body_cache_new()
  let expected = compile_wasi_module_rc_cached_impl_with_prov(stmts_in = policy_program_stmts(source), entry_name = "main", body_cache_in = codegen_body_cache_new(), body_cache_out = harvested, prov = empty_dbg_prov(), checker_float_call_offsets = no_ints(), checker_int_render_offsets = no_ints(), checker_bool_render_offsets = no_ints(), checker_eq_offsets = no_ints(), checker_eq_type_keys = no_keys())
  // Prove the input is populated, then poison every cached body. Replaying
  // these bytes cannot produce the expected nonempty, valid module.
  assert(Array::length(harvested.fn_indices) > 0)
  let bodies: Array[Bytes] = harvested.fn_bodies
  let mut i = 0
  while i < Array::length(bodies) {
    Array::set(bodies, at = i, value = Bytes::new())
    i = i + 1
  }
  let output = codegen_body_cache_new()
  let actual = compile_wasi_module_linked_with_cache_policy(stmts = policy_program_stmts(source), entry_name_in = "main", srcs = [
  ], linked_imports = [], library_mode = false, enable_rc = true, coverage = false, debug_trace = false, debug_break = false, rc_shadow = false, enable_late_dce = true, prov = empty_dbg_prov(), body_cache_in = harvested, body_cache_out = output, slice_lo = 0, slice_hi = -1, checker_float_call_offsets = no_ints(), checker_int_render_offsets = no_ints(), checker_bool_render_offsets = no_ints(), checker_eq_offsets = no_ints(), checker_eq_type_keys = no_keys(), split = module_split_none(), render = (_stmt) -> {
    ""
  }, grants = [], body_cache_enabled = false, exports_stripped = false)
  inspect(policy_bytes_equal(a = actual, b = expected), content = "true")
  inspect(Array::length(output.fn_indices), content = "0")
  inspect(Array::length(output.fn_bodies), content = "0")
  inspect(Array::length(output.guard_meta), content = "0")
  inspect(Array::length(output.guard_layout), content = "0")
  inspect(Array::length(output.guard_fold_names), content = "0")
}
