//# Imports

import @vibe/compiler/entry/cli_cache {
  parse_batch_jobs_tsv, prepare_jobs_cached, selfbuild_probe_cli_cache_counts, selfbuild_probe_cli_prepare_batch_parse_counts
}

import @vibe/core {
  array_empty
}

import ../type_db.vibe {
  db_new, db_typecheck_count
}

//# Functions

fn string_to_bytes(s: String) -> Bytes {
  let out = array_empty()
  let len = String::length(s)
  let mut i = 0
  while i < len {
    Array::push(out, String::char_code_at(s, i))
    i = i + 1
  }
  Bytes::from_array(out)
}

//# Misc

test "parse_batch_jobs_tsv: accepts two-column and three-column rows" {
  let jobs = parse_batch_jobs_tsv("/tmp/a.vibe\t/tmp/a.wasm\t_start\n/tmp/b.vibe\t/tmp/b.wasm\n")
  assert(eq(Array::length(jobs), 2))
  let (input1, output1, entry1) = Array::get(jobs, 0)
  assert(input1 == "/tmp/a.vibe")
  assert(output1 == "/tmp/a.wasm")
  assert(entry1 == "_start")
  let (input2, output2, entry2) = Array::get(jobs, 1)
  assert(input2 == "/tmp/b.vibe")
  assert(output2 == "/tmp/b.wasm")
  assert(entry2 == "")
}

test "prepare_jobs_cached: imported module warms and reuses TypeDb" {
  let helper_path = "/tmp/vibe_cli_cache_helper.vibe"
  let main_path = "/tmp/vibe_cli_cache_main.vibe"
  Fs::write_bytes(helper_path, string_to_bytes("export let add: (Int, Int) -> Int = (a, b) -> { a + b }"))
  Fs::write_bytes(main_path, string_to_bytes("import ./vibe_cli_cache_helper.vibe { add }\nlet _start: () -> Int = () -> { add(1, 2) }"))
  let jobs = [(main_path, "/tmp/vibe_cli_cache_stage1.wasm", "_start")]
  let db1 = prepare_jobs_cached(db_new(), jobs)
  let count1 = db_typecheck_count(db1)
  let db2 = prepare_jobs_cached(db1, jobs)
  let count2 = db_typecheck_count(db2)
  assert(eq(count2, count1))
}

test "selfbuild_probe_cli_cache_counts: file-backed job reuse stays warm" {
  let encoded = selfbuild_probe_cli_cache_counts()
  let count1 = encoded / 1000
  let count2 = encoded % 1000
  assert(count1 > 0)
  assert(eq(count2, count1))
}

test "selfbuild_probe_cli_prepare_batch_parse_counts: shared prepare reuses TypeDb across sibling jobs" {
  let encoded = selfbuild_probe_cli_prepare_batch_parse_counts()
  let fresh_total = encoded / 1000
  let shared_total = encoded % 1000
  assert(fresh_total > 0)
  assert(shared_total > 0)
  assert(shared_total < fresh_total)
}
