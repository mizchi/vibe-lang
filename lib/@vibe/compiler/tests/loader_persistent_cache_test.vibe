//# Imports

import @vibe/compiler/cache {
  build_source_groups_fingerprint,
  compact_string_fingerprint,
  persistent_manifest_header_cache_path,
  persistent_module_header_cache_path,
  persistent_source_group_cache_path,
  persistent_source_list_cache_path
}

import @vibe/core {
  array_empty, hex_encode
}

import @vibe/compiler/loader {
  collect_all_sources_fs, collect_source_groups_fs, load_or_parse_module_header_fs, load_persistent_source_group_fingerprint_if_valid
}

//# Functions

fn lookup_source(sources: Array[(String, String)], target_path: String) -> Option[String] {
  let mut i = 0
  let mut found = None
  while i < Array::length(sources) {
    let (path, source) = Array::get(sources, i)
    if path == target_path {
      found = Some(source)
      i = Array::length(sources)
    } else {
      i = i + 1
    }
  }
  found
}

fn string_to_bytes(s: String) -> Bytes {
  let out = array_empty()
  let len = String::length(s)
  let mut i = 0
  while i < len {
    Array::push(out, String::char_code_at(s, i))
    i = i + 1
  }
  Bytes::from_array(out)
}

fn lookup_group_source(groups: Array[(String, Array[(String, String)])], target_path: String) -> Option[String] {
  let mut gi = 0
  let mut found = None
  while gi < Array::length(groups) {
    let (_, sources) = Array::get(groups, gi)
    let mut si = 0
    while si < Array::length(sources) {
      let (path, source) = Array::get(sources, si)
      if path == target_path {
        found = Some(source)
        si = Array::length(sources)
        gi = Array::length(groups)
      } else {
        si = si + 1
      }
    }
    gi = gi + 1
  }
  found
}

fn remove_file_if_exists(path: String) -> Unit with Fs {
  if Fs::exists(path) {
    Fs::remove(path)
  } else {
    ()
  }
}

fn setup_manifest_fixture(base_dir: String, helper_source: String, main_source: String) -> (String, String, String) with Exception + Fs {
  let manifest_path = String::concat(base_dir, "/compiler_sources_manifest.tsv")
  let helper_path = String::concat(base_dir, "/helper.vibe")
  let main_path = String::concat(base_dir, "/main.vibe")
  Fs::mkdir_p(base_dir)
  Fs::write_bytes(manifest_path, string_to_bytes("core\thelper.vibe\nentry\tmain.vibe\n"))
  Fs::write_bytes(helper_path, string_to_bytes(helper_source))
  Fs::write_bytes(main_path, string_to_bytes(main_source))
  (manifest_path, helper_path, main_path)
}

//# Misc

test "load_persistent_source_group_fingerprint_if_valid: same-content rewrite keeps cache valid" {
  let helper_path = "/tmp/vibe_compiler_persistent_loader_same_helper.vibe"
  let main_path = "/tmp/vibe_compiler_persistent_loader_same_main.vibe"
  let helper_source = "export let add: () -> Int = () -> { 1 }"
  let main_source = "import ./vibe_compiler_persistent_loader_same_helper.vibe { add }\nlet run: () -> Int = () -> { add() }"
  Fs::write_bytes(helper_path, string_to_bytes(helper_source))
  Fs::write_bytes(main_path, string_to_bytes(main_source))
  remove_file_if_exists(persistent_source_group_cache_path(main_path))
  let groups = collect_source_groups_fs(main_path)
  let expected = build_source_groups_fingerprint(groups)
  Fs::write_bytes(helper_path, string_to_bytes(helper_source))
  Fs::write_bytes(main_path, string_to_bytes(main_source))
  match load_persistent_source_group_fingerprint_if_valid(main_path) {
    Some(fingerprint) => assert(fingerprint == expected),
    None => assert(false)
  }
}

test "load_persistent_source_group_fingerprint_if_valid: resolution-context change invalidates cache (#801)" {
  // A cache written while `.vibe/store/@scope/name` exists resolves @-refs
  // against a DIFFERENT package universe than the normal tree. Row validation
  // can never notice a package the poisoned cache is missing entirely, so the
  // loader records a resolution-context fingerprint (resctx) and must refuse
  // the cache once the visible package set changes (#801).
  let helper_path = "/tmp/vibe_compiler_persistent_loader_resctx_helper.vibe"
  let main_path = "/tmp/vibe_compiler_persistent_loader_resctx_main.vibe"
  let store_pkg_dir = ".vibe/store/@vibetest/resctx_probe801"
  let store_pkg_contract = String::concat(store_pkg_dir, "/index.vibei")
  Fs::write_bytes(helper_path, string_to_bytes("export let add: () -> Int = () -> { 1 }"))
  Fs::write_bytes(main_path, string_to_bytes("import ./vibe_compiler_persistent_loader_resctx_helper.vibe { add }\nlet run: () -> Int = () -> { add() }"))
  remove_file_if_exists(persistent_source_group_cache_path(main_path))
  // Context A: a store package is visible while the cache is written.
  Fs::mkdir_p(store_pkg_dir)
  Fs::write_bytes(store_pkg_contract, string_to_bytes("version 0.0.1\n\nlet version: String\n"))
  let groups = collect_source_groups_fs(main_path)
  let expected = build_source_groups_fingerprint(groups)
  // Same context: the cache must replay.
  match load_persistent_source_group_fingerprint_if_valid(main_path) {
    Some(fingerprint) => assert(fingerprint == expected),
    None => assert(false)
  }
  // Context B: the store package is gone -- the context-A cache must be
  // refused even though every row it lists still validates. (Remove the
  // whole probe scope so the working tree is left clean.)
  Fs::remove(".vibe/store/@vibetest")
  match load_persistent_source_group_fingerprint_if_valid(main_path) {
    Some(_) => assert(false),
    None => assert(true)
  }
  // A fresh collect in context B re-establishes a replayable cache.
  let groups_b = collect_source_groups_fs(main_path)
  let expected_b = build_source_groups_fingerprint(groups_b)
  match load_persistent_source_group_fingerprint_if_valid(main_path) {
    Some(fingerprint) => assert(fingerprint == expected_b),
    None => assert(false)
  }
}

test "collect_all_sources_fs: reuses valid source group cache when list cache is missing" {
  let (_, helper_path, main_path) = setup_manifest_fixture("/tmp/vibe_compiler_persistent_manifest_groups_to_list", "export let add: () -> Int = () -> { 1 }", "import ./helper.vibe { add }\nlet run: () -> Int = () -> { add() }")
  remove_file_if_exists(persistent_source_group_cache_path(main_path))
  remove_file_if_exists(persistent_source_list_cache_path(main_path))
  let groups = collect_source_groups_fs(main_path)
  assert(eq(Array::length(groups), 2))
  remove_file_if_exists(persistent_source_list_cache_path(main_path))
  let sources = collect_all_sources_fs(main_path)
  assert(eq(Array::length(sources), 2))
  assert(Fs::exists(persistent_source_list_cache_path(main_path)))
  match lookup_group_source(groups, helper_path) {
    Some(source) => assert(source == "export let add: () -> Int = () -> { 1 }"),
    None => assert(false)
  }
}

test "collect_source_groups_fs: reuses valid source list cache when group cache is missing" {
  let (_, helper_path, main_path) = setup_manifest_fixture("/tmp/vibe_compiler_persistent_manifest_list_to_groups", "export let add: () -> Int = () -> { 1 }", "import ./helper.vibe { add }\nlet run: () -> Int = () -> { add() }")
  remove_file_if_exists(persistent_source_group_cache_path(main_path))
  remove_file_if_exists(persistent_source_list_cache_path(main_path))
  let sources = collect_all_sources_fs(main_path)
  assert(eq(Array::length(sources), 2))
  remove_file_if_exists(persistent_source_group_cache_path(main_path))
  let groups = collect_source_groups_fs(main_path)
  assert(eq(Array::length(groups), 2))
  assert(Fs::exists(persistent_source_group_cache_path(main_path)))
  match lookup_group_source(groups, helper_path) {
    Some(source) => assert(source == "export let add: () -> Int = () -> { 1 }"),
    None => assert(false)
  }
}

test "collect_all_sources_fs: reuses aggregated manifest headers when source caches are missing" {
  let base_dir = "/tmp/vibe_compiler_persistent_manifest_headers"
  let (_, helper_path, main_path) = setup_manifest_fixture(base_dir, "export let add: () -> Int = () -> { 1 }", "import ./helper.vibe { add }\nlet run: () -> Int = () -> { add() }")
  remove_file_if_exists(persistent_manifest_header_cache_path(main_path))
  remove_file_if_exists(persistent_source_group_cache_path(main_path))
  remove_file_if_exists(persistent_source_list_cache_path(main_path))
  let initial = collect_all_sources_fs(main_path)
  assert(eq(Array::length(initial), 2))
  assert(Fs::exists(persistent_manifest_header_cache_path(main_path)))
  remove_file_if_exists(persistent_source_group_cache_path(main_path))
  remove_file_if_exists(persistent_source_list_cache_path(main_path))
  remove_file_if_exists(persistent_module_header_cache_path(main_path, compact_string_fingerprint(Fs::read_file(main_path))))
  remove_file_if_exists(persistent_module_header_cache_path(helper_path, compact_string_fingerprint(Fs::read_file(helper_path))))
  Fs::write_bytes(helper_path, string_to_bytes("export let add: () -> Int = () -> { 2 }"))
  let rebuilt = collect_all_sources_fs(main_path)
  assert(eq(Array::length(rebuilt), 2))
  match lookup_group_source([("recursive", rebuilt)], helper_path) {
    Some(source) => assert(source == "export let add: () -> Int = () -> { 2 }"),
    None => assert(false)
  }
}

test "collect_source_groups_fs: reuses aggregated manifest headers when source caches are missing" {
  let base_dir = "/tmp/vibe_compiler_persistent_manifest_group_headers"
  let (_, helper_path, main_path) = setup_manifest_fixture(base_dir, "export let add: () -> Int = () -> { 1 }", "import ./helper.vibe { add }\nlet run: () -> Int = () -> { add() }")
  remove_file_if_exists(persistent_manifest_header_cache_path(main_path))
  remove_file_if_exists(persistent_source_group_cache_path(main_path))
  remove_file_if_exists(persistent_source_list_cache_path(main_path))
  let initial = collect_source_groups_fs(main_path)
  assert(eq(Array::length(initial), 2))
  assert(Fs::exists(persistent_manifest_header_cache_path(main_path)))
  remove_file_if_exists(persistent_source_group_cache_path(main_path))
  remove_file_if_exists(persistent_source_list_cache_path(main_path))
  remove_file_if_exists(persistent_module_header_cache_path(main_path, compact_string_fingerprint(Fs::read_file(main_path))))
  remove_file_if_exists(persistent_module_header_cache_path(helper_path, compact_string_fingerprint(Fs::read_file(helper_path))))
  Fs::write_bytes(helper_path, string_to_bytes("export let add: () -> Int = () -> { 2 }"))
  let rebuilt = collect_source_groups_fs(main_path)
  assert(eq(Array::length(rebuilt), 2))
  match lookup_group_source(rebuilt, helper_path) {
    Some(source) => assert(source == "export let add: () -> Int = () -> { 2 }"),
    None => assert(false)
  }
}

test "collect_all_sources_fs: compiler index manifest follows source imports without hardcoded deps" {
  let entry_path = "lib/@vibe/compiler/compiler.vibe"
  let cache_probe_path = "lib/@vibe/compiler/cache_probe_support.vibe"
  remove_file_if_exists(persistent_manifest_header_cache_path(entry_path))
  remove_file_if_exists(persistent_source_group_cache_path(entry_path))
  remove_file_if_exists(persistent_source_list_cache_path(entry_path))
  let sources = collect_all_sources_fs(entry_path)
  match lookup_source(sources, cache_probe_path) {
    Some(_) => assert(true),
    None => assert(false)
  }
}

test "collect_all_sources_fs: resolves ../../../ imports from nested entry" {
  let base_dir = "/tmp/vibe_compiler_loader_nested_relative"
  let helper_path = String::concat(base_dir, "/helper.vibe")
  let entry_dir = String::concat(base_dir, "/a/b/c")
  let main_path = String::concat(entry_dir, "/main.vibe")
  Fs::mkdir_p(entry_dir)
  Fs::write_bytes(helper_path, string_to_bytes("export let add: () -> Int = () -> { 1 }"))
  Fs::write_bytes(main_path, string_to_bytes("import ../../../helper.vibe { add }\nlet run: () -> Int = () -> { add() }"))
  let sources = collect_all_sources_fs(main_path)
  assert(eq(Array::length(sources), 2))
  match lookup_group_source([("recursive", sources)], helper_path) {
    Some(source) => assert(source == "export let add: () -> Int = () -> { 1 }"),
    None => assert(false)
  }
}

test "load_or_parse_module_header_fs: warm cache reuses deps and exports" {
  let base_dir = "/tmp/vibe_compiler_persistent_module_header"
  let helper_path = String::concat(base_dir, "/helper.vibe")
  let main_path = String::concat(base_dir, "/main.vibe")
  let helper_source = "export let add: () -> Int = () -> { 1 }"
  let main_source = "import ./helper.vibe { add }\nexport let _start: () -> Int = () -> { add() }"
  Fs::mkdir_p(base_dir)
  Fs::write_bytes(helper_path, string_to_bytes(helper_source))
  Fs::write_bytes(main_path, string_to_bytes(main_source))
  remove_file_if_exists(persistent_module_header_cache_path(main_path, compact_string_fingerprint(main_source)))
  let (deps1, exports1, parse1) = load_or_parse_module_header_fs(main_path, main_source, 0)
  assert(eq(parse1, 1))
  assert(eq(Array::length(deps1), 1))
  assert(Array::get(deps1, 0) == helper_path)
  assert(eq(Array::length(exports1), 1))
  assert(Array::get(exports1, 0) == "_start")
  let (deps2, exports2, parse2) = load_or_parse_module_header_fs(main_path, main_source, 0)
  assert(eq(parse2, 0))
  assert(eq(Array::length(deps2), 1))
  assert(Array::get(deps2, 0) == helper_path)
  assert(eq(Array::length(exports2), 1))
  assert(Array::get(exports2, 0) == "_start")
}

test "load_or_parse_module_header_fs: package dep re-resolves when store copy vanishes (#801)" {
  // The header cache stores RESOLVED dep paths. `@scope/name` resolution
  // prefers .vibe/store over lib/, so a header cached while a store copy
  // existed must be refused (and re-resolved) once the store copy is gone —
  // otherwise the walk keeps aiming at the stale root.
  let base_dir = "/tmp/vibe_compiler_persistent_header_resctx"
  let main_path = String::concat(base_dir, "/main.vibe")
  // #943: the imported name must actually exist in the target contract —
  // the header lane now validates named imports against a boundary target's
  // export surface, so the old `{ x }` (declared nowhere in the fixture
  // contract) would throw "x is not exported" before this test's real
  // subject (dep re-resolution) is ever reached.
  let main_source = "import @vibetest/hdrprobe801 { version }\nexport let run: () -> Int = () -> { 1 }"
  let store_dir = ".vibe/store/@vibetest/hdrprobe801"
  let lib_dir = "lib/@vibetest/hdrprobe801"
  let contract = "version 0.0.1\n\nlet version: String\n"
  Fs::mkdir_p(base_dir)
  Fs::write_bytes(main_path, string_to_bytes(main_source))
  remove_file_if_exists(persistent_module_header_cache_path(main_path, compact_string_fingerprint(main_source)))
  Fs::mkdir_p(store_dir)
  Fs::write_bytes(String::concat(store_dir, "/index.vibei"), string_to_bytes(contract))
  Fs::mkdir_p(lib_dir)
  Fs::write_bytes(String::concat(lib_dir, "/index.vibei"), string_to_bytes(contract))
  // Cold parse: the store copy wins.
  let (deps1, _, parse1) = load_or_parse_module_header_fs(main_path, main_source, 0)
  assert(eq(parse1, 1))
  assert(eq(Array::length(deps1), 1))
  assert(Array::get(deps1, 0) == ".vibe/store/@vibetest/hdrprobe801/index.vibei")
  // Same context: warm replay, no parse.
  let (_, _, parse2) = load_or_parse_module_header_fs(main_path, main_source, 0)
  assert(eq(parse2, 0))
  // The store copy vanishes: lib/ is now the winner, so the cached header
  // (still listing the store path) must be re-resolved, not replayed.
  Fs::remove(".vibe/store/@vibetest")
  let (deps3, _, parse3) = load_or_parse_module_header_fs(main_path, main_source, 0)
  assert(eq(parse3, 1))
  assert(eq(Array::length(deps3), 1))
  assert(Array::get(deps3, 0) == "lib/@vibetest/hdrprobe801/index.vibei")
  Fs::remove("lib/@vibetest")
}

test "load_or_parse_module_header_fs: compiler source bundle uses cheap header scan" {
  let base_dir = "/tmp/vibe_compiler_generated_bundle_header"
  let bundle_path = String::concat(base_dir, "/compiler_sources_bundle.vibe")
  let bundle_source = String::concat("// AUTO-GENERATED\n", String::concat("let source_0 = (\"x\", \"y\")\n", String::concat("export let compiler_sources: () -> Array[(String, String)] = () -> { [] }\n", "export let compiler_source_groups: () -> Array[(String, Array[(String, String)])] = () -> { [] }\n")))
  Fs::mkdir_p(base_dir)
  Fs::write_bytes(bundle_path, string_to_bytes(bundle_source))
  remove_file_if_exists(persistent_module_header_cache_path(bundle_path, compact_string_fingerprint(bundle_source)))
  let (deps1, exports1, parse1) = load_or_parse_module_header_fs(bundle_path, bundle_source, 0)
  assert(eq(Array::length(deps1), 0))
  assert(eq(Array::length(exports1), 2))
  assert(Array::get(exports1, 0) == "compiler_sources")
  assert(Array::get(exports1, 1) == "compiler_source_groups")
  assert(eq(parse1, 0))
}

test "persistent_module_header_cache_path: uses compiled-safe filename" {
  let path = persistent_module_header_cache_path("/tmp/vibe_compiler_persistent_module_header/main.vibe", compact_string_fingerprint("export let run: () -> Int = () -> { 1 }"))
  assert(String::index_of(path, ":") < 0)
  assert(String::starts_with(path, "_build/vibe_selfhost_module_header_"))
}

test "v4 facade cache treats malformed dependency paths as misses" {
  let base_dir = "/tmp/vibe_facade_hex_miss_2338"
  let dep_dir = String::concat(base_dir, "/dep")
  let vpkg_path = String::concat(base_dir, "/index.vpkg")
  let box_path = String::concat(base_dir, "/box.vibe")
  let source_path = String::concat(dep_dir, "/source.vibe")
  if Fs::exists(base_dir) {
    Fs::remove(base_dir)
  } else {
    ()
  }
  Fs::mkdir_p(dep_dir)
  Fs::write_bytes(vpkg_path, string_to_bytes("name = @vibetest/hexmiss2338\nversion = 0.0.1\ndeps = {}\n\ngenerated_hash =\n\ntype Box[T]\n"))
  Fs::write_bytes(box_path, string_to_bytes("export ./dep/source.vibe { Box }\n"))
  Fs::write_bytes(source_path, string_to_bytes("export type Box[T] = T\n"))
  let first = handle {
    let _ = collect_all_sources_fs(vpkg_path)
    "ok"
  } with { Exception::Throw(msg) => String::concat("err:", msg) }
  inspect(first, content = "ok")
  let needle = hex_encode(source_path)
  let names = Fs::readdir("_build")
  let mut cache_path = ""
  let mut i = 0
  while i < Array::length(names) {
    let name = Array::get(names, i)
    if cache_path == "" && String::starts_with(name, "vibe_selfhost_contract_facade_") {
      let path = String::concat("_build/", name)
      if String::contains(Fs::read_file(path), needle) {
        cache_path = path
      } else {
        ()
      }
    } else {
      ()
    }
    i = i + 1
  }
  assert(cache_path != "")
  let original = Fs::read_file(cache_path)
  let at = String::index_of(original, needle)
  assert(at >= 0)
  let corrupted = String::concat(original[0: at], String::concat("zz", original[at + String::length(needle): String::length(original)]))
  Fs::write_bytes(cache_path, string_to_bytes(corrupted))
  let collected = handle {
    let _ = collect_all_sources_fs(vpkg_path)
    true
  } with { Exception::Throw(_) => false }
  Fs::write_bytes(cache_path, string_to_bytes(original))
  assert(collected)
}
