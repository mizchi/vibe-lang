//# Imports

import ./stmt_test_support.vibe {
  ps
}

//# Misc

test "stmt_enum_simple" {
  assert(ps("enum Color { Red; Green; Blue }") == "enum Color { Red; Green; Blue }")
}

test "stmt_enum_with_args" {
  assert(ps("enum Option { Some(Int); None }") == "enum Option { Some(Int); None }")
}

test "stmt_enum_exported" {
  assert(ps("export enum Color { Red; Green }") == "export enum Color { Red; Green }")
}

test "stmt_enum_generic_params" {
  // #735: `[T]` type params were dropped by print_stmt, so a printed generic
  // enum (contract facades, `vibe normalize`) became an ill-typed nullary decl.
  assert(ps("enum List[T] { Nil; Cons(T, List[T]) }") == "enum List[T] { Nil; Cons(T, List[T]) }")
  assert(ps("export enum Pair[A, B] { Mk(A, B) }") == "export enum Pair[A, B] { Mk(A, B) }")
}

test "stmt_enum_derive" {
  // #735 (same fix): `derive(...)` on an enum was also dropped.
  assert(ps("enum Color { Red; Green } derive(Eq)") == "enum Color { Red; Green } derive(Eq)")
}

test "stmt_type_alias_generic_params" {
  // #735 (same class): STypeAlias params.
  assert(ps("type Boxed[T] = (T, Int)") == "type Boxed[T] = (T, Int)")
}

test "stmt_struct" {
  assert(ps("struct Point { x: Int; y: Int }") == "struct Point { x: Int; y: Int }")
}

test "stmt_struct_exported" {
  assert(ps("export struct Point { x: Int }") == "export struct Point { x: Int }")
}
