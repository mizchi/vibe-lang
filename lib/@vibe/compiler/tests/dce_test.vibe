//# Imports

import @vibe/compiler/core {
  Expr, ImportItem, Pat, Stmt, TypeExpr, dce_keep_flags, dce_stmts, dce_stmts_before_trait_desugar, wat_callee_names
}

import @vibe/core {
  array_empty
}

//# Functions

fn no_ty() -> Option[TypeExpr] {
  None
}

//# Misc

test "empty stmts returns empty" {
  let stmts = array_empty()
  let result = dce_stmts(stmts, array_empty())
  assert(eq(Array::length(result), 0))
}

test "single used let is kept" {
  let stmts = [SLet(false, false, "foo", no_ty(), EInt(42))]
  let result = dce_stmts(stmts, ["foo"])
  assert(eq(Array::length(result), 1))
}

test "single unused let is removed" {
  let stmts = [SLet(false, false, "foo", no_ty(), EInt(42))]
  let result = dce_stmts(stmts, array_empty())
  assert(eq(Array::length(result), 0))
}

test "transitive dependency is kept" {
  let stmts = [
    SLet(false, false, "b", no_ty(), EInt(1)),
    SLet(false, false, "a", no_ty(), ECall(EIdent("b", -1), array_empty(), -1))
  ]
  let result = dce_stmts(stmts, ["a"])
  assert(eq(Array::length(result), 2))
}

test "SEnum is always kept" {
  let no_tys = array_empty()
  let stmts = [
    SEnum(false, "MyEnum", array_empty(), [("A", no_tys)], array_empty())
  ]
  let result = dce_stmts(stmts, array_empty())
  assert(eq(Array::length(result), 1))
}

test "SStruct is always kept" {
  let stmts = [
    SStruct(false, "MyStruct", [("x", TyName("Int"))], array_empty(), array_empty(), array_empty())
  ]
  let result = dce_stmts(stmts, array_empty())
  assert(eq(Array::length(result), 1))
}

test "SImport is always kept" {
  let stmts = [
    SImport("./foo.vibe", [ImportItem::{ kind: None, name: "bar", alias: None }])
  ]
  let result = dce_stmts(stmts, array_empty())
  assert(eq(Array::length(result), 1))
}

test "entry and deps kept, unrelated removed" {
  let stmts = [
    SLet(false, false, "helper", no_ty(), EInt(10)),
    SLet(false, false, "main", no_ty(), ECall(EIdent("helper", -1), array_empty(), -1)),
    SLet(false, false, "unused", no_ty(), EInt(99))
  ]
  let result = dce_stmts(stmts, ["main"])
  // main + helper kept, unused removed
  assert(eq(Array::length(result), 2))
}

test "multiple entry points" {
  let stmts = [
    SLet(false, false, "a", no_ty(), EInt(1)),
    SLet(false, false, "b", no_ty(), EInt(2)),
    SLet(false, false, "c", no_ty(), EInt(3))
  ]
  let result = dce_stmts(stmts, ["a", "c"])
  assert(eq(Array::length(result), 2))
}

test "SLetMut is handled" {
  let stmts = [
    SLetMut("counter", no_ty(), EInt(0)),
    SLet(false, false, "unused", no_ty(), EInt(1))
  ]
  let result = dce_stmts(stmts, ["counter"])
  assert(eq(Array::length(result), 1))
}

test "deep transitive chain" {
  let stmts = [
    SLet(false, false, "c", no_ty(), EInt(1)),
    SLet(false, false, "b", no_ty(), EIdent("c", -1)),
    SLet(false, false, "a", no_ty(), EIdent("b", -1)),
    SLet(false, false, "d", no_ty(), EInt(99))
  ]
  let result = dce_stmts(stmts, ["a"])
  // a -> b -> c kept, d removed
  assert(eq(Array::length(result), 3))
}

test "EFn body refs are collected" {
  let no_params = array_empty()
  let no_tp = array_empty()
  let no_tb = array_empty()
  let stmts = [
    SLet(false, false, "helper", no_ty(), EInt(42)),
    SLet(false, false, "f", no_ty(), EFn(no_tp, no_tb, no_params, no_ty(), None, EIdent("helper", -1))),
    SLet(false, false, "unused", no_ty(), EInt(0))
  ]
  let result = dce_stmts(stmts, ["f"])
  // f + helper kept, unused removed
  assert(eq(Array::length(result), 2))
}

test "STest is always kept" {
  let stmts = [
    STest("my test", EInt(1)),
    SLet(false, false, "unused", no_ty(), EInt(0))
  ]
  let result = dce_stmts(stmts, array_empty())
  // STest kept, unused removed
  assert(eq(Array::length(result), 1))
}

test "STest expression refs are kept" {
  let stmts = [
    SLet(false, false, "helper", no_ty(), EFn(array_empty(), array_empty(), [
      ("x", None)
    ], no_ty(), None, EIdent("x", -1))),
    STest("calls helper", ECall(EIdent("helper", -1), [EInt(41)], -1)),
    SLet(false, false, "unused", no_ty(), EInt(0))
  ]
  let result = dce_stmts(stmts, array_empty())
  assert(eq(Array::length(result), 2))
}

test "SBench expression refs are kept" {
  let stmts = [
    SLet(false, false, "helper", no_ty(), EInt(42)),
    SBench("reads helper", EIdent("helper", -1)),
    SLet(false, false, "unused", no_ty(), EInt(0))
  ]
  let result = dce_stmts(stmts, array_empty())
  assert(eq(Array::length(result), 2))
}

//# #2348: a WAT body's `call $name` edges

/// The parser's inline-wasm marker: `fn <name>(...) = wasm "<wat>"` reaches
/// every AST pass as `SFnDecl(.., EFn(.., ECall(EIdent("%wasm"), [EString])))`.
fn iw_marker_fn(name: String, wat: String) -> Stmt {
  SFnDecl(false, name, EFn(array_empty(), array_empty(), array_empty(), no_ty(), None, ECall(EIdent("%wasm", -1), [
    EString(wat, -1)
  ], -1)), array_empty(), array_empty())
}

test "#2348 dce: a helper only a WAT `call` names is reachable" {
  // Before the WAT scan, `collect_refs_into` answered `EString(_, _) => 0` and
  // this dropped `helper` -- out from under a live call. Codegen then reported
  // it missing while `vibe check`, which runs on the UNPRUNED statements,
  // reported clean.
  let stmts = [
    iw_marker_fn("helper", "(i64.sub (local.get $a) (local.get $b))"),
    iw_marker_fn("caller", "(call $helper (local.get $a) (i64.const 8))"),
    SLet(false, false, "main", no_ty(), ECall(EIdent("caller", -1), [EInt(10)], -1))
  ]
  let result = dce_stmts(stmts, ["main"])
  assert(eq(Array::length(result), 3))
}

test "#2348 dce: an inline-wasm fn nothing calls is still pruned" {
  // The control. Without it the test above would pass just as well if the
  // scan had been replaced by "never prune an inline-wasm fn".
  let stmts = [
    iw_marker_fn("helper", "(i64.sub (local.get $a) (local.get $b))"),
    iw_marker_fn("caller", "(i64.add (local.get $a) (i64.const 8))"),
    SLet(false, false, "main", no_ty(), ECall(EIdent("caller", -1), [EInt(10)], -1))
  ]
  let result = dce_stmts(stmts, ["main"])
  assert(eq(Array::length(result), 2))
}

test "#2348 dce: a local spelled like a fn is not a reference" {
  // The scan keys on the `call` keyword, not on `$name` anywhere, so
  // `(local.get $helper)` does not keep `helper` alive.
  let stmts = [
    iw_marker_fn("helper", "(i64.sub (local.get $a) (local.get $b))"),
    iw_marker_fn("caller", "(i64.add (local.get $helper) (i64.const 8))"),
    SLet(false, false, "main", no_ty(), ECall(EIdent("caller", -1), [EInt(10)], -1))
  ]
  let result = dce_stmts(stmts, ["main"])
  assert(eq(Array::length(result), 2))
}

test "#2348 dce: every callee of a multi-call body is reachable" {
  let stmts = [
    iw_marker_fn("h1", "(i64.sub (local.get $a) (local.get $b))"),
    iw_marker_fn("h2", "(i64.add (local.get $a) (local.get $b))"),
    iw_marker_fn("unused", "(i64.mul (local.get $a) (local.get $b))"),
    iw_marker_fn("caller", "(call $h1 (call $h2 (local.get $a) (i64.const 2)) (i64.const 8))"),
    SLet(false, false, "main", no_ty(), ECall(EIdent("caller", -1), [EInt(10)], -1))
  ]
  let result = dce_stmts(stmts, ["main"])
  assert(eq(Array::length(result), 4))
}

/// Like `iw_marker_fn`, with declared parameters -- the shadowing case.
fn iw_marker_fn_params(name: String, params: Array[String], wat: String) -> Stmt {
  let ps = array_empty()
  let mut i = 0
  while i < Array::length(params) {
    Array::push(ps, (Array::get(params, i), no_ty()))
    i = i + 1
  }
  SFnDecl(false, name, EFn(array_empty(), array_empty(), ps, no_ty(), None, ECall(EIdent("%wasm", -1), [
    EString(wat, -1)
  ], -1)), array_empty(), array_empty())
}

test "#2348 dce: a callee followed straight by a `;;` comment is an edge" {
  // `(call $helper;; why` is valid WAT -- the assembler ends a word at `;`
  // too. A scan that stopped only at whitespace read `helper;;`, matched
  // nothing, and DCE pruned the live helper.
  let names = wat_callee_names("(call $helper;; why\n (local.get $a))")
  assert(eq(Array::length(names), 1))
  assert(eq(Array::get(names, 0), "helper"))
  let stmts = [
    iw_marker_fn("helper", "(i64.sub (local.get $a) (local.get $b))"),
    iw_marker_fn("caller", "(call $helper;; why\n (local.get $a) (i64.const 8))"),
    SLet(false, false, "main", no_ty(), ECall(EIdent("caller", -1), [EInt(10)], -1))
  ]
  assert(eq(Array::length(dce_stmts(stmts, ["main"])), 3))
}

test "#2348 dce: a call written inside a comment is not an edge" {
  // Both comment forms the assembler accepts. Recording these would only
  // over-keep, but the scan can be exact here, so it is.
  assert(eq(Array::length(wat_callee_names(";; (call $ghost)\n(i64.const 1)")), 0))
  assert(eq(Array::length(wat_callee_names("(; (call $ghost) ;)(i64.const 1)")), 0))
  assert(eq(Array::length(wat_callee_names("(call ;; between\n $real (i64.const 1))")), 1))
}

test "#2348 dce: a parameter named like the callee does not hide the edge" {
  // `$helper` as a callee and `$helper` as a local are different namespaces,
  // and the assembler already keeps them apart. Filtering the callee through
  // the expression's value binders dropped the edge and pruned the helper.
  let stmts = [
    iw_marker_fn("helper", "(i64.sub (local.get $a) (local.get $b))"),
    iw_marker_fn_params("caller", ["helper"], "(call $helper (local.get $helper) (i64.const 8))"),
    SLet(false, false, "main", no_ty(), ECall(EIdent("caller", -1), [EInt(10)], -1))
  ]
  assert(eq(Array::length(dce_stmts(stmts, ["main"])), 3))
}

// #3111: before the trait-dictionary desugar, `[T: Measured]` calls
// `T::measure`, which names no binding; only the dictionary built later
// references `Pt::measure`. An early prune must keep every impl method, and
// the plain `dce_stmts` (the late prune, after the desugar) must not.
fn impl_dispatch_program() -> Array[Stmt] {
  [
    STrait(false, "Measured", array_empty(), [
      ("measure", [TyName("Self")], TyName("Int"))
    ], array_empty(), array_empty()),
    SImpl(array_empty(), array_empty(), "Measured", TyName("Pt")),
    SLet(false, false, "Pt::measure", no_ty(), ECall(EIdent("helper", -1), array_empty(), -1)),
    SLet(false, false, "helper", no_ty(), EInt(1)),
    SLet(false, false, "Pt::inherent", no_ty(), EInt(2)),
    SLet(false, false, "main", no_ty(), ECall(EIdent("T::measure", -1), array_empty(), -1))
  ]
}

fn kept_names(stmts: Array[Stmt]) -> String {
  let mut out = ""
  for stmt in stmts {
    match stmt {
      SLet(_, _, name, _, _) => out = String::concat(out, String::concat(name, " ")),
      _ => ()
    }
  }
  out
}

test "3111: the early prune keeps a method only a trait dictionary reaches" {
  let kept = dce_stmts_before_trait_desugar(impl_dispatch_program(), ["main"])
  inspect(kept_names(kept), "Pt::measure helper main ")
}

test "3111: the late prune still drops an undispatched impl method" {
  let kept = dce_stmts(impl_dispatch_program(), ["main"])
  inspect(kept_names(kept), "main ")
}

test "3111: an impl of a trait declared elsewhere keeps its owner's bindings" {
  let stmts = [
    SImpl(array_empty(), array_empty(), "Imported", TyName("Qt")),
    SLet(false, false, "Qt::go", no_ty(), EInt(1)),
    SLet(false, false, "Other::go", no_ty(), EInt(2)),
    SLet(false, false, "main", no_ty(), EInt(0))
  ]
  inspect(kept_names(dce_stmts_before_trait_desugar(stmts, ["main"])), "Qt::go main ")
}

test "#3193: break and continue payloads keep their callees" {
  let helper = SLet(false, false, "helper", no_ty(), EInt(7))
  let break_main = SLet(false, false, "main", no_ty(), ELoop([], EBreak(Some(ECall(EIdent("helper", -1), [], -1)))))
  let continue_main = SLet(false, false, "main", no_ty(), ELoop([], EContinue([ECall(EIdent("helper", -1), [], -1)])))
  inspect(Array::length(dce_stmts([helper, break_main], ["main"])), "2")
  inspect(Array::length(dce_stmts([helper, continue_main], ["main"])), "2")
}

test "#3193: a live interpolation with unresolved text keeps definitions" {
  let helper = SLet(false, false, "helper", no_ty(), EInt(7))
  let main = SLet(false, false, "main", no_ty(), EStringInterp(["", "helper()", ""]))
  inspect(Array::length(dce_stmts([helper, main], ["main"])), "2")
  let flags = dce_keep_flags([helper, main], ["main"])
  inspect(Array::get(flags, 0), "true")
}

test "#3193: a live function contract keeps its callees" {
  let helper = SLet(false, false, "helper", no_ty(), EInt(7))
  let body = EFn([], [], [], no_ty(), None, EInt(1))
  let main = SFnDecl(false, "main", body, [ECall(EIdent("helper", -1), [], -1)], [])
  inspect(Array::length(dce_stmts([helper, main], ["main"])), "2")
}

test "#3193: assignment targets keep top-level mutable bindings" {
  let counter = SLetMut("counter", no_ty(), EInt(0))
  let direct = SLet(false, false, "main", no_ty(), EAssign("counter", EInt(1), EInt(0)))
  let compound = SLet(false, false, "main", no_ty(), EAssignOp("counter", "+", EInt(1), EInt(0)))
  inspect(Array::length(dce_stmts([counter, direct], ["main"])), "2")
  inspect(Array::length(dce_stmts([counter, compound], ["main"])), "2")
}
