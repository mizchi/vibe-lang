import @vibe/compiler/core {
  BindingOrigin,
  Type,
  TypeEnv,
  env_bind,
  env_bind_mut,
  env_bind_with_origin,
  env_cache_complete,
  env_cache_read_snapshot,
  env_cached,
  env_lookup,
  env_lookup_binding_including_surface,
  env_mut_escape,
  env_value_binding,
  env_value_binding_with_origin,
  trait_supers,
  types_equal
}

fn assert_lookup_answers(env: TypeEnv, names: Array[String]) -> Unit {
  let snapshot = env_cache_read_snapshot(env)
  for name in names {
    let before = env_lookup_binding_including_surface(env = env, name = name)
    let after = env_lookup_binding_including_surface(env = snapshot, name = name)
    match (before, after) {
      (Some(left), Some(right)) => {
        assert_true(types_equal(a = left.ty, b = right.ty))
        assert(left.origin == right.origin)
      },
      (None, None) => (),
      _ => assert(false)
    }
  }
  ()
}

test "read snapshot preserves cache-only rows and their origins" {
  let origin = BindingOriginModuleExport("builtin.vibe", "AsyncIter")
  let env = env_cached(names = ["AsyncIter", "sleep"], bindings = [
    env_value_binding_with_origin(ty = CtUnknown, origin = origin),
    env_value_binding(CtFn([CtInt], CtInt, None))
  ], rest = EnvEmpty)
  assert_lookup_answers(env = env, names = ["AsyncIter", "sleep", "missing"])
  assert(env_lookup(env = env_cache_read_snapshot(env), name = "sleep") is Some(CtFn(_, _, None)))
}

test "read snapshot preserves cached precedence duplicate rows and flat tails" {
  let tail = EnvFlat([
    ("x", env_value_binding(CtInt)),
    ("tail", env_value_binding(CtChar))
  ])
  let inner = env_cached(names = ["only", "x", "x"], bindings = [
    env_value_binding(CtUnit),
    env_value_binding(CtString),
    env_value_binding(CtDouble)
  ], rest = tail)
  let env = env_bind(env = inner, name = "x", ty = CtBool)
  assert_lookup_answers(env = env, names = ["only", "x", "tail", "missing"])
  assert(env_lookup(env = env_cache_read_snapshot(inner), name = "x") is Some(CtString))
  assert(env_lookup(env = env_cache_read_snapshot(env), name = "x") is Some(CtBool))
}

test "read snapshot preserves cached surface barriers and local rebinding" {
  let origin = BindingOriginReExportSurface("facade", "x")
  let env = env_cached(names = ["x"], bindings = [
    env_value_binding_with_origin(ty = CtUnknown, origin = origin)
  ], rest = env_bind(env = EnvEmpty, name = "x", ty = CtInt))
  let snapshot = env_cache_read_snapshot(env)
  assert_lookup_answers(env = env, names = ["x", "missing"])
  assert(env_lookup(env = snapshot, name = "x") is None)
  assert(env_lookup(env = env_bind(env = snapshot, name = "x", ty = CtBool), name = "x") is Some(CtBool))
}

test "read snapshot honors existing complete misses and later tail binds" {
  let complete = env_cache_complete(env_bind(env = EnvEmpty, name = "visible", ty = CtInt))
  let extended = env_bind(env = complete, name = "added", ty = CtString)
  assert_lookup_answers(env = complete, names = ["visible", "added", "missing"])
  assert_lookup_answers(env = extended, names = ["visible", "added", "missing"])
  match complete {
    EnvCached(index, rows, rest) => {
      // Even a manually assembled node cannot turn an existing final miss
      // into a new visible binding merely by taking a read snapshot.
      let hidden = EnvCached(index, rows, env_bind(env = rest, name = "hidden", ty = CtChar))
      assert(env_lookup(env = hidden, name = "hidden") is None)
      assert_lookup_answers(env = hidden, names = [
        "visible",
        "hidden",
        "missing"
      ])
    },
    _ => assert(false)
  }
}

test "read snapshot keeps the original lookup behavior of unsorted cached rows" {
  let env = env_cached(names = ["z", "a"], bindings = [
    env_value_binding(CtString),
    env_value_binding(CtDouble)
  ], rest = env_bind(env = EnvEmpty, name = "z", ty = CtBool))
  assert_lookup_answers(env = env, names = ["z", "a", "missing"])
}

test "read snapshot preserves mutability facts and trait declaration walks" {
  let rest = EnvTraitDef("Trait", ["Base"], false, [], env_bind_mut(env = EnvEmpty, name = "cell", ty = CtInt, escapes = true), [
  ], [])
  let env = env_cached(names = ["only"], bindings = [
    env_value_binding(CtString)
  ], rest = rest)
  let snapshot = env_cache_read_snapshot(env)
  assert_lookup_answers(env = env, names = ["only", "cell", "missing"])
  assert(env_mut_escape(env = snapshot, name = "cell") is Some(true))
  assert_eq(Array::get(trait_supers(env = snapshot, name = "Trait"), at = 0), "Base")
}
