//# Imports

import @vibe/compiler/core {
  Expr, Pat, Stmt, TypeExpr
}

import @vibe/core {
  array_empty
}

import ../monoify.vibe {
  collect_call_sites, collect_call_sites_stmts, collect_generic_fns, count_instantiations, is_generic_fn, mono_name
}

//# Functions

let _no_tp = array_empty()

let _no_tb = array_empty()

let _no_params = array_empty()

//# Misc

test "is_generic_fn with type params returns true" {
  let expr = EFn(["T"], _no_tb, [("x", None)], None, None, EIdent("x", -1))
  assert(is_generic_fn(expr))
}

test "is_generic_fn without type params returns false" {
  let expr = EFn(_no_tp, _no_tb, [("x", None)], None, None, EIdent("x", -1))
  assert(not(is_generic_fn(expr)))
}

test "is_generic_fn on non-EFn returns false" {
  assert(not(is_generic_fn(EInt(42))))
}

test "collect_generic_fns finds generic functions" {
  let generic_fn = EFn(["T"], _no_tb, [("x", None)], None, None, EIdent("x", -1))
  let stmts = [SLet(false, false, "identity", None, generic_fn)]
  let result = collect_generic_fns(stmts)
  assert(eq(Array::length(result), 1))
  let (name, count) = Array::get(result, 0)
  assert(name == "identity")
  assert(eq(count, 1))
}

test "collect_generic_fns skips non-generic functions" {
  let normal_fn = EFn(_no_tp, _no_tb, [("x", None)], None, None, EIdent("x", -1))
  let stmts = [SLet(false, false, "foo", None, normal_fn)]
  let result = collect_generic_fns(stmts)
  assert(eq(Array::length(result), 0))
}

test "collect_call_sites finds matching calls" {
  let expr = ECall(EIdent("foo", -1), [EInt(1), EInt(2)], -1)
  let sites = collect_call_sites(expr, "foo")
  assert(eq(Array::length(sites), 1))
  let args = Array::get(sites, 0)
  assert(eq(Array::length(args), 2))
}

test "collect_call_sites ignores non-matching calls" {
  let expr = ECall(EIdent("bar", -1), [EInt(1)], -1)
  let sites = collect_call_sites(expr, "foo")
  assert(eq(Array::length(sites), 0))
}

test "collect_call_sites_stmts across multiple stmts" {
  let stmts = [
    SLet(false, false, "a", None, ECall(EIdent("foo", -1), [EInt(1)], -1)),
    SLet(false, false, "b", None, ECall(EIdent("foo", -1), [EInt(2)], -1)),
    SLet(false, false, "c", None, ECall(EIdent("bar", -1), [EInt(3)], -1))
  ]
  let sites = collect_call_sites_stmts(stmts, "foo")
  assert(eq(Array::length(sites), 2))
}

test "mono_name generates correct name" {
  let result = mono_name("add", "Int")
  assert(result == "add$Int")
}

test "count_instantiations counts call sites" {
  let stmts = [
    SLet(false, false, "a", None, ECall(EIdent("id", -1), [EInt(1)], -1)),
    SLet(false, false, "b", None, ECall(EIdent("id", -1), [EString("hello")], -1)),
    SExpr(ECall(EIdent("id", -1), [EBool(true)], -1))
  ]
  let count = count_instantiations(stmts, "id")
  assert(eq(count, 3))
}
