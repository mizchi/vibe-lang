//# Imports

import @vibe/compiler/entry/compiler/file_compile {
  compile_file_fs_mode, compile_file_fs_mode_cached
}

import @vibe/core {
  array_empty
}

import ../type_db.vibe {
  db_new
}

//# Functions

fn string_to_bytes(s: String) -> Bytes {
  let out = array_empty()
  let len = String::length(s)
  let mut i = 0
  while i < len {
    Array::push(out, String::char_code_at(s, i))
    i = i + 1
  }
  Bytes::from_array(out)
}

fn assert_wasm_magic(bytes: Bytes) -> Unit {
  assert(Bytes::get(bytes, 0) == 0)
  assert(Bytes::get(bytes, 1) == 97)
  assert(Bytes::get(bytes, 2) == 115)
  assert(Bytes::get(bytes, 3) == 109)
}

//# Misc

test "compile_file_fs_mode_cached: mvp prunes unused fs statements relative to no-dce" {
  let main_path = "/tmp/vibe_compiler_file_mode_main.vibe"
  let source = "let unused: () -> Int = () -> { 0 }\nlet run: () -> Int = () -> { 40 + 2 }"
  Fs::write_bytes(main_path, string_to_bytes(source))
  let (bytes_no_dce, db1) = compile_file_fs_mode_cached(db_new(), main_path, "run", "no-dce")
  let (bytes_mvp, _) = compile_file_fs_mode_cached(db1, main_path, "run", "mvp")
  assert_wasm_magic(bytes_no_dce)
  assert_wasm_magic(bytes_mvp)
  assert(Bytes::length(bytes_mvp) < Bytes::length(bytes_no_dce))
}

test "compile_file_fs_mode: dce-root prunes from a named root that is not a command entry" {
  // The lane `vibe build --component` uses. Before it, a command component had
  // to take `no-dce` -- `mvp` roots the DCE at `entry_name` and then hands the
  // same name to a codegen that requires a 0-parameter WASI entry, which
  // `vibe_command(args)` is not. So nothing pruned, and a command that reached
  // the compiler came to 40.5 MB (measured), eight times the whole CLI adapter.
  let main_path = "/tmp/vibe_compiler_dce_root_main.vibe"
  let source = "export fn unused_one(a: Int) -> Int {\n  a + 1\n}\n\nexport fn unused_two(a: Int) -> Int {\n  unused_one(a) + unused_one(a)\n}\n\nexport fn vibe_command(args: String) -> String {\n  args\n}\n"
  Fs::write_bytes(main_path, string_to_bytes(source))
  let bytes_no_dce = compile_file_fs_mode(main_path, "__no_entry__", "no-dce")
  let bytes_rooted = compile_file_fs_mode(main_path, "vibe_command", "dce-root")
  assert_wasm_magic(bytes_no_dce)
  assert_wasm_magic(bytes_rooted)
  // The point of the lane: what the root cannot reach is gone.
  assert(Bytes::length(bytes_rooted) < Bytes::length(bytes_no_dce))
}

test "compile_file_fs_mode: dce-root still emits a library, not a command entry" {
  // The second half of the false choice `mvp` forces. Rooting the DCE at a
  // parameterised function is only useful if codegen then emits a LIBRARY --
  // under `mvp` the same name becomes the WASI entry and the compile is
  // refused with "WASI entry function must take 0 parameters" (measured).
  let main_path = "/tmp/vibe_compiler_dce_root_lib.vibe"
  let source = "export fn vibe_command(args: String) -> String {\n  String::concat(args, \"!\")\n}\n"
  Fs::write_bytes(main_path, string_to_bytes(source))
  // `mvp` on the SAME name and source is refused, because it hands that name
  // to a codegen that requires a 0-parameter WASI entry. Asserting the refusal
  // is what makes this test about the separation of roles rather than about
  // the output merely being non-empty.
  let mvp_result = handle {
    let _ = compile_file_fs_mode(main_path, "vibe_command", "mvp")
    "COMPILED"
  } with { Exception::Throw(e) => e }
  assert(String::index_of(mvp_result, "0 parameters") >= 0)
  // `dce-root` takes the same name and succeeds, as a library.
  let bytes_rooted = compile_file_fs_mode(main_path, "vibe_command", "dce-root")
  assert_wasm_magic(bytes_rooted)
  assert(Bytes::length(bytes_rooted) > 8)
}

test "compile_file_fs_mode_cached: dce-root is accepted by the CACHED lane too" {
  // Codex review of #2863. `dce-root` was added to `compile_file_fs_mode`
  // alone, so this lane threw `unsupported compile mode: dce-root` -- and the
  // `.vibex` CLI's `build --component` takes it whenever the artifact cache is
  // live (VIBE_UNSTABLE=1), which is exactly the modules that import compiler
  // APIs. The launcher adapter, on the uncached lane, succeeded. Same flag,
  // two answers.
  let main_path = "/tmp/vibe_compiler_dce_root_cached.vibe"
  let source = "export fn unused_one(a: Int) -> Int {\n  a + 1\n}\n\nexport fn vibe_command(args: String) -> String {\n  args\n}\n"
  Fs::write_bytes(main_path, string_to_bytes(source))
  let (bytes_cached, _) = compile_file_fs_mode_cached(db_new(), main_path, "vibe_command", "dce-root")
  assert_wasm_magic(bytes_cached)
  // And it must AGREE with the uncached lane. A cached lane that accepted the
  // mode but compiled it as `no-dce` would pass a bare "did not throw" check
  // while emitting an unpruned artifact -- which is what two of the codegen
  // copies would have done, since they had no `no-dce` arm and no throw.
  let bytes_uncached = compile_file_fs_mode(main_path, "vibe_command", "dce-root")
  assert(Bytes::length(bytes_cached) == Bytes::length(bytes_uncached))
}

test "compile_file_fs_mode_cached: dce-root gets its own cache namespace" {
  // The in-memory artifact cache keys on (entry_path, kind, entry_name,
  // source_groups_fingerprint) and that fingerprint does NOT carry the mode,
  // so the two modes need different artifact KINDS. Everything below is held
  // equal EXCEPT the mode -- same file, same entry, same fingerprint -- so a
  // shared kind would hand the second call the first one's bytes.
  //
  // The entry is 0-parameter on purpose: that is the one shape BOTH modes
  // accept, which is what makes holding entry_name equal possible. Under
  // `no-dce` the entry name is the codegen entry, so a parameterised one is
  // refused with "WASI entry function must take 0 parameters".
  let main_path = "/tmp/vibe_compiler_dce_root_cache_ns.vibe"
  let source = "export fn unused_one(a: Int) -> Int {\n  a + 1\n}\n\nexport fn unused_two(a: Int) -> Int {\n  unused_one(a) + unused_one(a)\n}\n\nexport fn run() -> Int {\n  7\n}\n"
  Fs::write_bytes(main_path, string_to_bytes(source))
  let (bytes_no_dce, _) = compile_file_fs_mode_cached(db_new(), main_path, "run", "no-dce")
  let (bytes_rooted, _) = compile_file_fs_mode_cached(db_new(), main_path, "run", "dce-root")
  assert_wasm_magic(bytes_no_dce)
  assert_wasm_magic(bytes_rooted)
  // Measured: 2484 vs 2230. Equal lengths would mean one mode was answered
  // with the other's cached artifact.
  assert(Bytes::length(bytes_rooted) < Bytes::length(bytes_no_dce))
}

test "compile_file_fs_mode: an unknown mode is refused by name" {
  let main_path = "/tmp/vibe_compiler_dce_root_badmode.vibe"
  Fs::write_bytes(main_path, string_to_bytes("export fn vibe_command(a: String) -> String {\n  a\n}\n"))
  let result = handle {
    let _ = compile_file_fs_mode(main_path, "vibe_command", "dce-roooot")
    "OK"
  } with { Exception::Throw(e) => e }
  assert(String::index_of(result, "unsupported compile mode") >= 0)
}

test "compile_file_fs_mode_cached: release compile keeps test block refs" {
  let main_path = "/tmp/vibe_compiler_file_mode_tests_main.vibe"
  let source = "let inc: (Int) -> Int = (x) -> { x + 1 }\ntest \"call top-level\" { assert(inc(41) == 42) }\nlet run: () -> Int = () -> { inc(41) }"
  Fs::write_bytes(main_path, string_to_bytes(source))
  let (bytes_no_dce, db1) = compile_file_fs_mode_cached(db_new(), main_path, "run", "no-dce")
  let (bytes_mvp, _) = compile_file_fs_mode_cached(db1, main_path, "run", "mvp")
  assert_wasm_magic(bytes_no_dce)
  assert_wasm_magic(bytes_mvp)
}
