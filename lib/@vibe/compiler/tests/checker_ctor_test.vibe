//# Imports

import @vibe/compiler/core {
  Expr, Pat, Stmt, Subst, Type, TypeDef, TypeEnv, TypeExpr, env_lookup, types_equal
}

import @vibe/core {
  array_empty
}

import @vibe/compiler/checker {
  check_stmts
}

//# Functions

fn empty_defs() -> Array[TypeDef] {
  array_empty()
}

fn check_stmts_compat(_ stmts: Array[Stmt]) -> TypeEnv {
  let errors = array_empty()
  let (env, _, _) = check_stmts(raw_stmts = stmts, i = 0, env = EnvEmpty, defs = empty_defs(), s = SubstEmpty, c = 0, errors = errors, tytab = array_empty())
  env
}

//# Misc

test "enum nullary constructor typed as CtEnum" {
  let stmts = [
    SEnum(false, "Color", array_empty(), [
      ("Red", array_empty()),
      ("Green", array_empty()),
      ("Blue", array_empty())
    ], array_empty())
  ]
  let env = check_stmts_compat(stmts)
  match env_lookup(env = env, name = "Red") {
    Some(t) => assert(types_equal(a = t, b = CtEnum("Color"))),
    None => assert(false)
  }
  match env_lookup(env = env, name = "Green") {
    Some(t) => assert(types_equal(a = t, b = CtEnum("Color"))),
    None => assert(false)
  }
}

test "enum unary constructor typed as CtFn" {
  let stmts = [
    SEnum(false, "Option2", array_empty(), [
      ("Some2", [TyName("Int")]),
      ("None2", array_empty())
    ], array_empty())
  ]
  let env = check_stmts_compat(stmts)
  // Some2 should be a function Int -> Option2
  match env_lookup(env = env, name = "Some2") {
    Some(t) => assert(types_equal(a = t, b = CtFn([CtInt], CtEnum("Option2"), None))),
    None => assert(false)
  }
  // None2 should be CtEnum (nullary)
  match env_lookup(env = env, name = "None2") {
    Some(t) => assert(types_equal(a = t, b = CtEnum("Option2"))),
    None => assert(false)
  }
}

test "enum multi-arg constructor typed as CtFn" {
  let stmts = [
    SEnum(false, "Expr2", array_empty(), [
      ("Add2", [TyName("Int"), TyName("Int")]),
      ("Lit2", [TyName("Int")])
    ], array_empty())
  ]
  let env = check_stmts_compat(stmts)
  match env_lookup(env = env, name = "Add2") {
    Some(t) => assert(types_equal(a = t, b = CtFn([CtInt, CtInt], CtEnum("Expr2"), None))),
    None => assert(false)
  }
  match env_lookup(env = env, name = "Lit2") {
    Some(t) => assert(types_equal(a = t, b = CtFn([CtInt], CtEnum("Expr2"), None))),
    None => assert(false)
  }
}

test "struct constructor typed as CtFn" {
  let stmts = [
    SStruct(false, "Point", [("x", TyName("Int")), ("y", TyName("Int"))], array_empty(), array_empty(), array_empty())
  ]
  let env = check_stmts_compat(stmts)
  match env_lookup(env = env, name = "Point") {
    Some(t) => assert(types_equal(a = t, b = CtFn([CtInt, CtInt], CtStruct("Point"), None))),
    None => assert(false)
  }
}

test "calling enum constructor returns CtEnum" {
  let stmts = [
    SEnum(false, "MyOpt", array_empty(), [
      ("MySome", [TyName("Int")]),
      ("MyNone", array_empty())
    ], array_empty()),
    SLet(false, false, "x", None, ECall(EIdent("MySome", -1), [EInt(42)], -1, []))
  ]
  let env = check_stmts_compat(stmts)
  match env_lookup(env = env, name = "x") {
    Some(t) => assert(types_equal(a = t, b = CtEnum("MyOpt"))),
    None => assert(false)
  }
}

test "generic enum constructor instantiates payload into return" {
  let stmts = [
    SEnum(false, "Result2", ["T"], [
      ("Ok2", [TyName("T")]),
      ("Err2", array_empty())
    ], array_empty()),
    SLet(false, false, "x", None, ECall(EIdent("Ok2", -1), [EInt(42)], -1, []))
  ]
  let env = check_stmts_compat(stmts)
  match env_lookup(env = env, name = "x") {
    Some(t) => assert(types_equal(a = t, b = CtNamed("Result2", [CtInt]))),
    None => assert(false)
  }
}

test "enum type name still bound as CtEnum" {
  let stmts = [
    SEnum(false, "Dir", array_empty(), [
      ("Up", array_empty()),
      ("Down", array_empty())
    ], array_empty())
  ]
  let env = check_stmts_compat(stmts)
  match env_lookup(env = env, name = "Dir") {
    Some(t) => assert(types_equal(a = t, b = CtEnum("Dir"))),
    None => assert(false)
  }
}
