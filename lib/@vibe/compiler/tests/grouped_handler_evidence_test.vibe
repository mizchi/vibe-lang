test "sibling arms use the original outer handler context" {
  grouped_handler_run("grouped-sibling-contexts", "effect A { Op() -> Int }\neffect B { Op() -> Int }\nfn b_guarded() -> Int with B { perform B::Op() + 1 }\nfn main() -> Unit allows Console {\n let x = handle { handle { perform A::Op() } with { A::Op() => resume(perform B::Op() + 1); B::Op() => resume(5) } } with { B::Op() => resume(20) }\n let y = handle { handle { perform B::Op() } with { A::Op() => resume(100); B::Op() => resume(perform A::Op() + 2) } } with { A::Op() => resume(30) }\n println(\"\\{x}\"); println(\"\\{y}\")\n}\n", "21\n32\n")
}

test "ordinary row closures use their callers handler context" {
  grouped_handler_run("hoisted-sibling-contexts", "effect A { Op() -> Int }\neffect B { Op() -> Int }\nfn b_guarded() -> Int with B { perform B::Op() + 1 }\nfn main() -> Unit allows Console {\n let x = handle {\n  let armA = () -> Int with B { perform B::Op() + 1 }\n  handle { handle { perform A::Op() } with { A::Op() => resume(armA()) } } with { B::Op() => resume(5) }\n } with { B::Op() => resume(20) }\n let y = handle {\n  let armB = () -> Int with A { perform A::Op() + 2 }\n  handle { handle { perform B::Op() } with { A::Op() => resume(100) } } with { B::Op() => resume(armB()) }\n } with { A::Op() => resume(30) }\n println(\"\\{x}\"); println(\"\\{y}\")\n}\n", "6\n32\n")
}

