test "grouped suspend continuations remain one shot" {
  let source = "effect A { Op() -> Int } effect B { Op() -> Int } fn main()->Unit allows Console{let r=handle{perform A::Op()+perform B::Op()}with{A::Op()=>resume(100);B::Op()=>{let k=resume;k(5);k(6)}};println(\"\\{r}\")}"
  Fs::mkdir_p("_build/vibe_test/grouped_handlers")
  for lane in ["rc", "gc"] {
    let bytes = if lane == "gc" {
      compile_source_gc_only(source, "main")
    } else {
      compile_source_wasi_only_rc(source, "main")
    }
    let path = "_build/vibe_test/grouped_handlers/one-shot-" + lane + ".wasm"
    Fs::write_bytes(path, bytes)
    let result = process_sh_capture("bash scripts/run_wasm_vibe_host_runner.sh --invoke _start " + path)
    assert(result.exit_code != 0)
    assert(String::contains(result.stdout, "resume one-shot continuation called twice"))
  }
  ()
}

test "grouped suspend runtime names cannot capture generated source identifiers" {
  let source = "effect A {Op()->Int} effect B {Op()->Int} fn sentinel()->Int{7} fn main()->Unit {let r=handle{perform A::Op()+perform B::Op()+sentinel()}with{A::Op()=>resume(100);B::Op()=>{let k=resume;k(5)}};assert(r==112)}"
  let (tokens, starts, _) = lex_with_offsets(source)
  let stmts = parse_program_located(tokens, starts, source)
  let occupied = "__scps_bubble_$scps_group_0"
  let renamed = apply_export_renames_stmts(stmts, [("sentinel", occupied)])
  inspect(suspend_cps_pass(renamed), content = "[]")
  let mut definitions = 0
  for stmt in renamed {
    match stmt {
      SLet(_, _, name, _, _) => if name == occupied {
        definitions = definitions + 1
      },
      _ => ()
    }
  }
  inspect(definitions, content = "1")
  let fresh = apply_export_renames_stmts(parse_program_located(tokens, starts, source), [
    ("sentinel", occupied)
  ])
  let bytes = compile_generated_stmts_gc_only(fresh, "main")
  Fs::mkdir_p("_build/vibe_test/grouped_handlers")
  let path = "_build/vibe_test/grouped_handlers/group-runtime-collision.wasm"
  Fs::write_bytes(path, bytes)
  let result = process_sh_capture("bash scripts/run_wasm_vibe_host_runner.sh --invoke _start " + path)
  inspect(result.exit_code, content = "0")
  inspect(result.stdout, content = "")
}

test "delayed resume: grouped" {
  grouped_handler_run("nonlocal-return-grouped", "effect A {Op()->Int} effect B {Op()->Int} fn work()->Int{let saved:Array[(Int)->Int]=[];let early=handle{let b=perform B::Op();perform A::Op()+b}with{A::Op()=>return 7;B::Op()=>{Array::push(saved,resume);0}};let resumed=Array::get(saved,0)(5);99} fn main()->Unit allows Console{println(\"\\{work()}\")} ", "7\n")
}

