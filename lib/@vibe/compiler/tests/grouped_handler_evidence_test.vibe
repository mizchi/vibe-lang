test "a vacuous first effect does not erase another live effect" {
  grouped_handler_run("vacuous-first", "effect A { Op() -> Int }\neffect B { Op() -> Int }\nfn b_guarded() -> Int with B { perform B::Op() + 1 }\nfn main() -> Unit allows Console { let r = handle { b_guarded() } with { A::Op() => resume(100); B::Op() => resume(5) }; println(\"\\{r}\") }\n", "6\n")
}

test "a grouped dictionary binding cannot capture a generated AST identifier" {
  let source = "effect A { Op() -> Int } effect B { Op() -> Int } let sentinel = 7; fn b_guarded() -> Int with B { perform B::Op() + 1 } fn main() -> Unit allows Console { let r = handle { b_guarded() + perform A::Op() + sentinel } with { A::Op() => resume(100); B::Op() => resume(5) }; println(\"\\{r}\") }"
  let (tokens, starts, _) = lex_with_offsets(source)
  let stmts = parse_program_located(tokens, starts, source)
  let renamed = apply_export_renames_stmts(stmts, [("sentinel", "$edp_group_A")])
  let bytes = compile_generated_stmts_gc_only(renamed, "main")
  Fs::mkdir_p("_build/vibe_test/grouped_handlers")
  let path = "_build/vibe_test/grouped_handlers/generated-collision.wasm"
  Fs::write_bytes(path, bytes)
  let result = process_sh_capture("bash scripts/run_wasm_vibe_host_runner.sh --invoke _start " + path)
  inspect(result.exit_code, content = "0")
  inspect(result.stdout, content = "113\n")
}

