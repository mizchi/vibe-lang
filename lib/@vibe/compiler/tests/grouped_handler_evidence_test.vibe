}

test "grouped handlers migrate a callee of the second effect" {
  grouped_handler_run("grouped-original", "effect A { Op() -> Int }\neffect B { Op() -> Int }\nfn b_guarded() -> Int with B { perform B::Op() + 1 }\nfn main() -> Unit allows Console { let r = handle { let x = b_guarded(); x + perform A::Op() } with { A::Op() => resume(100); B::Op() => resume(5) }; println(\"\\{r}\") }\n", "106\n")
}

test "grouped handlers do not depend on arm order" {
  grouped_handler_run("grouped-reversed", "effect A { Op() -> Int }\neffect B { Op() -> Int }\nfn b_guarded() -> Int with B { perform B::Op() + 1 }\nfn main() -> Unit allows Console { let r = handle { let x = b_guarded(); x + perform A::Op() } with { B::Op() => resume(5); A::Op() => resume(100) }; println(\"\\{r}\") }\n", "106\n")
