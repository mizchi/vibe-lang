//# Imports

import @vibe/compiler/core {
  Expr, Pat, Subst, Type, TypeDef, TypeEnv, env_bind, env_lookup, types_equal
}

import @vibe/core {
  array_empty
}

import @vibe/compiler/checker {
  check_expr, check_pattern, check_qualified_pattern_refs, pat_has_unsupported_or_binding
}

//# Functions

fn no_args() -> Array[Type] {
  array_empty()
}

fn empty_pats() -> Array[Pat] {
  array_empty()
}

fn empty_defs() -> Array[TypeDef] {
  array_empty()
}

fn check(expr: Expr, env: TypeEnv) -> Type {
  let errors = array_empty()
  let (ty, _, _) = check_expr(expr, env, empty_defs(), SubstEmpty, 0, errors, array_empty())
  ty
}

/// Like `check`, but also returns the accumulated diagnostics (against a
/// caller-supplied `defs`, for enum-typed #951 or-pattern fixtures).
fn check_with_errors(expr: Expr, env: TypeEnv, defs: Array[TypeDef]) -> Array[String] {
  let errors = array_empty()
  let (_, _, _) = check_expr(expr, env, defs, SubstEmpty, 0, errors, array_empty())
  errors
}

fn str_contains(s: String, sub: String) -> Bool {
  String::index_of(s, sub) >= 0
}

fn any_error_contains(errors: Array[String], sub: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(errors) {
    if str_contains(Array::get(errors, i), sub) {
      found = true
    } else {
      ()
    }
    i = i + 1
  }
  found
}

/// #951 fixture: `enum E { A(Int); B(Int) }`.
fn e_defs() -> Array[TypeDef] {
  [TDEnum("E", array_empty(), [("A", [CtInt]), ("B", [CtInt])])]
}

//# Misc

test "PBind binds name to scrutinee type" {
  let env = check_pattern(PBind("x"), CtInt, EnvEmpty, empty_defs(), array_empty())
  match env_lookup(env, "x") {
    Some(ty) => assert(types_equal(ty, CtInt)),
    None => assert(false)
  }
}

test "PWild does not add bindings" {
  let env = check_pattern(PWild, CtInt, EnvEmpty, empty_defs(), array_empty())
  match env_lookup(env, "x") {
    Some(_) => assert(false),
    None => assert(true)
  }
}

test "PInt does not add bindings" {
  let env = check_pattern(PInt(42), CtInt, EnvEmpty, empty_defs(), array_empty())
  match env_lookup(env, "x") {
    Some(_) => assert(false),
    None => assert(true)
  }
}

test "PString does not add bindings" {
  let env = check_pattern(PString("hello"), CtString, EnvEmpty, empty_defs(), array_empty())
  match env_lookup(env, "x") {
    Some(_) => assert(false),
    None => assert(true)
  }
}

test "PBool does not add bindings" {
  let env = check_pattern(PBool(true), CtBool, EnvEmpty, empty_defs(), array_empty())
  match env_lookup(env, "x") {
    Some(_) => assert(false),
    None => assert(true)
  }
}

test "PTuple destructuring extracts element types" {
  let scr_ty = CtTuple([CtInt, CtString])
  let pat = PTuple([PBind("a"), PBind("b")])
  let env = check_pattern(pat, scr_ty, EnvEmpty, empty_defs(), array_empty())
  match env_lookup(env, "a") {
    Some(ty) => assert(types_equal(ty, CtInt)),
    None => assert(false)
  }
  match env_lookup(env, "b") {
    Some(ty) => assert(types_equal(ty, CtString)),
    None => assert(false)
  }
}

test "PTuple with non-tuple scrutinee binds to unknown" {
  let pat = PTuple([PBind("a"), PBind("b")])
  let env = check_pattern(pat, CtInt, EnvEmpty, empty_defs(), array_empty())
  match env_lookup(env, "a") {
    Some(ty) => assert(types_equal(ty, CtUnknown)),
    None => assert(false)
  }
}

test "PCtor with known enum extracts payload types" {
  let defs = [
    TDEnum("Option", array_empty(), [("Some", [CtInt]), ("None", no_args())])
  ]
  let pat = PCtor("Some", [PBind("val")])
  let env = check_pattern(pat, CtEnum("Option"), EnvEmpty, defs, array_empty())
  match env_lookup(env, "val") {
    Some(ty) => assert(types_equal(ty, CtInt)),
    None => assert(false)
  }
}

test "PCtor with unknown constructor binds to unknown" {
  let pat = PCtor("Unknown", [PBind("x")])
  let env = check_pattern(pat, CtUnknown, EnvEmpty, empty_defs(), array_empty())
  match env_lookup(env, "x") {
    Some(ty) => assert(types_equal(ty, CtUnknown)),
    None => assert(false)
  }
}

test "POr returns bindings from left" {
  let pat = POr(PBind("x"), PBind("x"))
  let env = check_pattern(pat, CtInt, EnvEmpty, empty_defs(), array_empty())
  match env_lookup(env, "x") {
    Some(ty) => assert(types_equal(ty, CtInt)),
    None => assert(false)
  }
}

test "match with PBind resolves type in arm body" {
  let expr = EMatch(EInt(1), [(PBind("x"), EIdent("x", -1))])
  let ty = check(expr, EnvEmpty)
  assert(types_equal(ty, CtInt))
}

test "match with multiple arms checks all" {
  let expr = EMatch(EInt(1), [
    (PInt(1), EString("one")),
    (PBind("n"), EIdent("n", -1)),
    (PWild, EString("other"))
  ])
  // Returns type of first arm
  let ty = check(expr, EnvEmpty)
  assert(types_equal(ty, CtString))
}

test "match with tuple pattern binds elements" {
  let env = env_bind(EnvEmpty, "pair", CtTuple([CtInt, CtString]))
  let expr = EMatch(EIdent("pair", -1), [
    (PTuple([PBind("a"), PBind("b")]), EIdent("b", -1))
  ])
  let ty = check(expr, env)
  assert(types_equal(ty, CtString))
}

test "PCtor Some on CtOption extracts element type" {
  let pat = PCtor("Some", [PBind("val")])
  let env = check_pattern(pat, CtOption(CtInt), EnvEmpty, empty_defs(), array_empty())
  match env_lookup(env, "val") {
    Some(ty) => assert(types_equal(ty, CtInt)),
    None => assert(false)
  }
}

test "PCtor None on CtOption binds nothing" {
  let pat = PCtor("None", empty_pats())
  let env = check_pattern(pat, CtOption(CtString), EnvEmpty, empty_defs(), array_empty())
  // None has no sub-patterns, env stays empty
  match env_lookup(env, "val") {
    Some(_) => assert(false),
    None => assert(true)
  }
}

test "match CtOption Some arm resolves element" {
  let env = env_bind(EnvEmpty, "x", CtOption(CtInt))
  let expr = EMatch(EIdent("x", -1), [
    (PCtor("Some", [PBind("n")]), EIdent("n", -1)),
    (PCtor("None", empty_pats()), EInt(0))
  ])
  let ty = check(expr, env)
  assert(types_equal(ty, CtInt))
}

// #951: `A(v) | B(v) => v` passes `check_pattern` (it only walks the LEFT
// branch, so `v` resolves via `A`'s payload) but codegen has no per-branch
// binding-extraction path for or-patterns and crashes with an unlocated
// "undefined variable" internal error. The checker now rejects any
// or-pattern that binds a variable in either branch — even when both
// branches use the same name and type — with a located diagnostic instead.

test "pat_has_unsupported_or_binding: same-name binding or-pattern is detected" {
  let pat = POr(PCtor("A", [PBind("v")]), PCtor("B", [PBind("v")]))
  assert(pat_has_unsupported_or_binding(pat))
}

test "pat_has_unsupported_or_binding: differing-name binding or-pattern is detected" {
  let pat = POr(PCtor("A", [PBind("v")]), PCtor("B", [PBind("w")]))
  assert(pat_has_unsupported_or_binding(pat))
}

test "pat_has_unsupported_or_binding: plain literal or-pattern is NOT flagged" {
  let pat = POr(PInt(1), POr(PInt(2), PInt(3)))
  assert(not(pat_has_unsupported_or_binding(pat)))
}

test "pat_has_unsupported_or_binding: nested inside a ctor arg is detected" {
  // `Some(A(v) | B(v))` — the or-pattern is not the top-level arm pattern,
  // it is nested inside another constructor's payload. codegen's nested
  // `emit_pat_test`/`emit_sub_tests` recursion has the same binding gap at
  // any depth, so detection must recurse into PCtor/PTuple/PStruct args too.
  let pat = PCtor("Some", [
    POr(PCtor("A", [PBind("v")]), PCtor("B", [PBind("v")]))
  ])
  assert(pat_has_unsupported_or_binding(pat))
}

test "#951 repro: `A(v) | B(v) => v` is rejected with a located diagnostic" {
  let env = env_bind(EnvEmpty, "e", CtEnum("E"))
  let pat = POr(PCtor("A", [PBind("v")]), PCtor("B", [PBind("v")]))
  let expr = EMatch(EIdent("e", -1), [(pat, EIdent("v", -1))])
  let errors = check_with_errors(expr, env, e_defs())
  assert(Array::length(errors) > 0)
  assert(any_error_contains(errors, "or-pattern bindings are not supported yet"))
}

test "#951: differing binding names across or-branches (`A(v) | B(w)`) is rejected" {
  let env = env_bind(EnvEmpty, "e", CtEnum("E"))
  let pat = POr(PCtor("A", [PBind("v")]), PCtor("B", [PBind("w")]))
  let expr = EMatch(EIdent("e", -1), [(pat, EIdent("v", -1))])
  let errors = check_with_errors(expr, env, e_defs())
  assert(Array::length(errors) > 0)
  assert(any_error_contains(errors, "or-pattern bindings are not supported yet"))
}

test "#951: literal/block arm body still gets a located reject (scrutinee anchor)" {
  // Codex P2 on #972: railway_expr_off has no case for literal / let / block
  // bodies (`A(v) | B(v) => { let w = v; w }`) and returns -1 — the reject
  // must then anchor on the match scrutinee instead of going unlocated.
  let env = env_bind(EnvEmpty, "e", CtEnum("E"))
  let pat = POr(PCtor("A", [PBind("v")]), PCtor("B", [PBind("v")]))
  let expr = EMatch(EIdent("e", 7), [(pat, EInt(5))])
  let errors = check_with_errors(expr, env, e_defs())
  assert(Array::length(errors) > 0)
  assert(any_error_contains(errors, "or-pattern bindings are not supported yet"))
  assert(any_error_contains(errors, "[@off=7]"))
}

test "#951: plain non-binding or-pattern arm still type-checks (regression guard)" {
  let expr = EMatch(EInt(2), [
    (POr(PInt(1), POr(PInt(2), PInt(3))), EInt(100)),
    (PWild, EInt(0))
  ])
  let errors = check_with_errors(expr, EnvEmpty, empty_defs())
  assert(Array::length(errors) == 0)
}

//# #1455 step 3: qualified variant pattern validation

/// Two enums that share no variant names, so a swapped qualifier is always a
/// genuine error rather than an accidental hit.
fn two_enum_defs() -> Array[TypeDef] {
  [
    TDEnum("Color", array_empty(), [
      ("Red", array_empty()),
      ("Green", array_empty())
    ]),
    TDEnum("Shape", array_empty(), [("Circle", [CtInt])])
  ]
}

fn qualified_ref_errors(refs: Array[(String, String)], defs: Array[TypeDef]) -> Array[String] {
  let errors = array_empty()
  check_qualified_pattern_refs(refs, defs, errors)
  errors
}

test "#1455: a qualifier that owns the variant is accepted" {
  let errors = qualified_ref_errors([
    ("Color", "Red"),
    ("Color", "Green"),
    ("Shape", "Circle")
  ], two_enum_defs())
  assert_eq(Array::length(errors), 0)
}

test "#1455: a qualifier naming the WRONG enum is rejected" {
  // The whole point of step 3: `Shape::Red` parses to the same PCtor("Red")
  // that the bare spelling does, so nothing downstream can catch it.
  let errors = qualified_ref_errors([("Shape", "Red")], two_enum_defs())
  assert_eq(Array::length(errors), 1)
  assert(any_error_contains(errors, "enum `Shape` has no variant `Red`"))
}

test "#1455: a qualifier that is not an enum at all stays silent" {
  // Handle-arm operation patterns (`Fs::ReadFile(p)`) reach the log through
  // the same parser branch, and so do entries left behind by a parse-only
  // path whose module this compilation never sees. Neither may fire.
  let errors = qualified_ref_errors([
    ("Fs", "ReadFile"),
    ("SomeOtherModule", "Whatever")
  ], two_enum_defs())
  assert_eq(Array::length(errors), 0)
}

test "#1455: every bad pair is reported, not just the first" {
  let errors = qualified_ref_errors([("Color", "Circle"), ("Shape", "Green")], two_enum_defs())
  assert_eq(Array::length(errors), 2)
  assert(any_error_contains(errors, "enum `Color` has no variant `Circle`"))
  assert(any_error_contains(errors, "enum `Shape` has no variant `Green`"))
}
