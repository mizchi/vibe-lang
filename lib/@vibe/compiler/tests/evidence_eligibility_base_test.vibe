import @vibe/compiler/core {
  Expr, Pat, Stmt, TypeExpr
}
import @vibe/compiler/lowering/effects/evidence {
  edp_all_sites_eligible,
  edp_all_sites_eligible_with_base,
  edp_all_sites_eligible_with_context,
  edp_append_ctor_inert_names,
  edp_append_free_host_inert_names,
  edp_append_visible_pure_lambda_names,
  edp_collect_fn_defs,
  edp_collect_handle_sites,
  edp_etawrap_stmts_with_rebuild,
  edp_fn_row_label_table,
  edp_pure_fn_names
}
import @vibe/compiler/lowering/effects/queries {
  edp_collect_program_binders
}
import @vibe/core {
  struct MutSet
}

fn top(name: String, value: Expr) -> Stmt {
  SLet(false, false, name, None, value)
}

fn pure_names(_ stmts: Array[Stmt]) -> Array[String] {
  let names: Array[String] = []
  edp_append_visible_pure_lambda_names(stmts = stmts, pure_fns = names)
  names
}

test "a direct call leaves the eligibility base valid" {
  let stmts = [
    top(name = "f", value = EFn([], [], [("x", None)], None, Some("Ask"), EInt(1))),
    top(name = "outer", value = EFn([], [], [], None, Some("Ask"), ECall(EIdent("f", -1), [
      EInt(7)
    ], -1, []))),
    top(name = "__edpw_0", value = EFn([], [], [], None, None, EInt(2)))
  ]
  let before = pure_names(stmts)
  assert(!edp_etawrap_stmts_with_rebuild(stmts = stmts, needing = ["f", "outer"], ename = "Ask", fn_defs = edp_collect_fn_defs(stmts), es_names = [
  ], es_members_list = []))
  inspect(before, content = "[__edpw_0]")
  assert_eq(pure_names(stmts), before)
}

test "an eta wrapper introduces a binder that invalidates earlier purity" {
  let stmts = [
    top(name = "f", value = EFn([], [], [("x", None)], None, Some("Ask"), EInt(1))),
    top(name = "outer", value = EFn([], [], [], None, Some("Ask"), ECall(EIdent("consume", -1), [
      EIdent("f", -1)
    ], -1, []))),
    top(name = "consume", value = EFn([], [], [
      ("callback", Some(TyFn([TyName("Int")], TyName("Int"), None)))
    ], None, Some("Console"), EUnit)),
    top(name = "__edpw_0", value = EFn([], [], [], None, None, EInt(2)))
  ]
  let before_binders = edp_collect_program_binders(stmts)
  assert(!MutSet::has(before_binders, x = "__edpw_0"))
  inspect(pure_names(stmts), content = "[__edpw_0]")
  assert(edp_etawrap_stmts_with_rebuild(stmts = stmts, needing = ["f", "outer"], ename = "Ask", fn_defs = edp_collect_fn_defs(stmts), es_names = [
  ], es_members_list = []))
  // The wrapper's parameter shadows this spelling in another scope.
  // Reusing the pre-wrap result would wrongly retain a globally inert name.
  inspect(pure_names(stmts), content = "[]")
  let after_binders = edp_collect_program_binders(stmts)
  assert(MutSet::has(after_binders, x = "__edpw_0"))
  assert(!MutSet::has(before_binders, x = "__edpw_0"))
}

test "eligibility reuses a base without changing it between attempts" {
  let stmts = [
    SEffectDef(false, "Ask", [], [("Get", [], TyName("Int"))]),
    top(name = "ask", value = EFn([], [], [], Some(TyName("Int")), Some("Ask"), ECall(EIdent("perform", 0), [
      ECall(EIdent("Ask::Get", 0), [], 0, [])
    ], 0, []))),
    top(name = "side", value = EFn([], [], [], Some(TyName("Int")), Some("Console"), EInt(7))),
    top(name = "main", value = EFn([], [], [], Some(TyName("Int")), None, EHandle(ECall(EIdent("ask", 0), [
    ], 0, []), [
      (PCtor("Ask::Get", []), ECall(EIdent("resume", 0), [EInt(42)], 0, []))
    ])))
  ]
  let defs = edp_collect_fn_defs(stmts)
  let rows = edp_fn_row_label_table(fn_defs = defs, es_names = [], es_members_list = [
  ])
  let sites = edp_collect_handle_sites(stmts = stmts, ename = "Ask")
  let base = edp_pure_fn_names(defs)
  edp_append_free_host_inert_names(stmts = stmts, pure_fns = base)
  edp_append_ctor_inert_names(stmts = stmts, pure_fns = base)
  edp_append_visible_pure_lambda_names(stmts = stmts, pure_fns = base)
  let before = String::join(base, sep = "\n")
  let binders = edp_collect_program_binders(stmts)
  let fresh = edp_all_sites_eligible(stmts = stmts, ename = "Ask", needing = [
    "ask"
  ], handle_sites = sites, fn_defs = defs, row_labels = rows)
  assert(fresh)
  for attempt in [0, 1] {
    assert_eq(edp_all_sites_eligible_with_base(stmts = stmts, ename = "Ask", needing = [
      "ask"
    ], handle_sites = sites, fn_defs = defs, row_labels = rows, base_inert = Some(base)), fresh)
    assert_eq(edp_all_sites_eligible_with_context(stmts = stmts, ename = "Ask", needing = [
      "ask"
    ], handle_sites = sites, fn_defs = defs, row_labels = rows, base_inert = Some(base), binders = Some(binders)), fresh)
    assert_eq(String::join(base, sep = "\n"), before)
  }
}
