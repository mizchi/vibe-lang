//# Imports

import ./printer_test_support.vibe {
  roundtrip
}

//# Misc

test "roundtrip fn" {
  let ok = handle {
    roundtrip("(x) -> x")
  } with Error {
    Throw(_) => false
  }
  assert(ok)
}

test "roundtrip fn typed" {
  let ok = handle {
    roundtrip("(x: Int) -> x")
  } with Error {
    Throw(_) => false
  }
  assert(ok)
}
