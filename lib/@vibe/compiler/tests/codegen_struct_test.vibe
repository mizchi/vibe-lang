//# Imports

import ./codegen_test_support.vibe {
  assert_wasm, compile_wasi
}

import ./codegen_gc_test_support.vibe {
  compile_wasi_gc
}

//# Misc

test "wasi: struct create and field access" {
  let bytes = compile_wasi(source = "struct Point { x: Int; y: Int }\nexport let main: () -> Int = () -> { let p = Point::{ x: 10, y: 20 }; p.x + p.y }", entry = "main")
  assert_wasm(bytes)
}

test "wasi: struct field order independence" {
  let bytes = compile_wasi(source = "struct Point { x: Int; y: Int }\nexport let main: () -> Int = () -> { let p = Point::{ y: 99, x: 1 }; p.x }", entry = "main")
  assert_wasm(bytes)
}

test "gc: struct create and field access" {
  let bytes = compile_wasi_gc(source = "struct Point { x: Int; y: Int }\nexport let main: () -> Int = () -> { let p = Point::{ x: 5, y: 15 }; p.x + p.y }", entry = "main")
  assert_wasm(bytes)
}

test "wasi: mut struct field write (ADR-0052)" {
  let bytes = compile_wasi(source = "struct Counter { mut n: Int }\nexport let main: () -> Int = () -> { let c = Counter::{ n: 1 }\nc.n = c.n + 41\nc.n }", entry = "main")
  assert_wasm(bytes)
}

test "gc: mut struct field write (ADR-0052)" {
  let bytes = compile_wasi_gc(source = "struct Counter { mut n: Int }\nexport let main: () -> Int = () -> { let c = Counter::{ n: 1 }\nc.n = c.n + 41\nc.n }", entry = "main")
  assert_wasm(bytes)
}

test "wasi: struct destructuring let" {
  let bytes = compile_wasi(source = "struct Point { x: Int; y: Int }\nexport let main: () -> Int = () -> { let p = Point::{ x: 10, y: 20 }\nlet Point::{ x, y } = p\nx + y }", entry = "main")
  assert_wasm(bytes)
}
