//# Imports

// #2827: a parameter whose INITIAL reference one branch spends and another
// keeps. The merge keeps the minimum remaining count (#705), so before this
// nothing released the parameter on the paths that did not consume it. It
// now takes the #2389 pair a plain `let` takes -- `path_drop` plus a
// `consume_mark` per spending occurrence -- and codegen releases it in the
// function epilogue under the flag those marks set. The shapes the epilogue
// cannot guard stay silent: an exit that might return a view, a consume
// inside a loop (codegen's own per-site rules), an
// unmarkable occurrence and a body that may hand back a view of it.

import @vibe/compiler/query {
  rc_plan_source, rc_validate_source, rc_validate_source_edited
}

import @vibe/compiler/perceus {
  PerceusAction, pa_is_exit_drop
}

//# Functions

fn plan_of(_ source: String) -> String with Exception {
  rc_plan_source(source = source, fn_filter = "", checked_error_row = false)
}

let prelude = "enum Node {\n  Leaf(Int);\n  Pair(Node, Node)\n}\nlet own: (Node) -> Node = (m) -> Pair(m, Leaf(0))\n"

let epilogue = "\nlet run: (Bool) -> Node = (c) -> pick(Pair(Leaf(1), Leaf(2)), c)\nlet main: () -> Int = () -> {\n  match run(true) {\n    _ => 0\n  }\n}"

test "an unannotated owned parameter gets a reference for every forwarding use" {
  let src = "fn take(_ xs: Array[Int]) -> Int { let owner = [xs]; Array::get(Array::get(owner, at = 0), at = 0) }\nlet callback = (xs) -> take(xs) + take(xs) + take(xs)\nfn main() -> Int { callback([1]) }"
  let plan = plan_of(src)
  assert(String::contains(plan, needle = "callback xs dup 2"))
  inspect(rc_validate_source(source = src, fn_filter = "callback", checked_error_row = false), content = "")
}

test "a parameter consumed in one if-branch only gets a guarded drop and a mark" {
  let src = String::concat(prelude, String::concat("let pick: (Node, Bool) -> Node = (t, c) -> {\n  if c {\n    own(t)\n  } else {\n    Leaf(0)\n  }\n}", epilogue))
  let plan = plan_of(src)
  assert(String::contains(plan, needle = "pick t path_drop 1"))
  assert(String::contains(plan, needle = "pick t consume_mark:"))
}

test "a parameter consumed in one match arm only gets the same pair" {
  let src = String::concat(prelude, String::concat("let pick: (Node, Bool) -> Node = (t, c) -> {\n  match c {\n    true => own(t),\n    false => Leaf(0)\n  }\n}", epilogue))
  let plan = plan_of(src)
  assert(String::contains(plan, needle = "pick t path_drop 1"))
  assert(String::contains(plan, needle = "pick t consume_mark:"))
}

test "a parameter consumed on every branch is not a split" {
  let src = String::concat(prelude, String::concat("let pick: (Node, Bool) -> Node = (t, c) -> {\n  if c {\n    own(t)\n  } else {\n    t\n  }\n}", epilogue))
  let plan = plan_of(src)
  assert(!String::contains(plan, needle = "pick t path_drop"))
  assert(!String::contains(plan, needle = "pick t consume_mark:"))
}

test "a split parameter of a heap-result function with an exit gets no path drop" {
  let src = String::concat(prelude, String::concat("let pick: (Node, Bool) -> Node = (t, c) -> {\n  if c {\n    return own(t)\n  } else {\n    ()\n  }\n  Leaf(0)\n}", epilogue))
  let plan = plan_of(src)
  assert(!String::contains(plan, needle = "pick t path_drop"))
  assert(!String::contains(plan, needle = "pick t consume_mark:"))
}

test "a parameter consumed inside a loop gets no path drop" {
  // Codegen retains a parameter at each owning call site in a loop and gives
  // the epilogue a drop for those sites (#725, #1085), which the merge's
  // count does not model. A use there does not spend the initial reference
  // today, and the planner declines the parameter outright as a backstop.
  let src = String::concat(prelude, String::concat("let pick: (Node, Bool) -> Node = (t, c) -> {\n  if c {\n    let mut acc = Leaf(0)\n    let mut i = 0\n    while i < 2 {\n      acc = own(t)\n      i = i + 1\n    }\n    acc\n  } else {\n    Leaf(0)\n  }\n}", epilogue))
  let plan = plan_of(src)
  assert(!String::contains(plan, needle = "pick t path_drop"))
  assert(!String::contains(plan, needle = "pick t consume_mark:"))
}

test "a parameter consumed only by a capture gets no path drop" {
  // A capture has no source offset, so codegen has no site to set the flag.
  let src = String::concat(prelude, String::concat("let pick: (Node, Bool) -> Node = (t, c) -> {\n  if c {\n    let f: () -> Node = () -> t\n    f()\n  } else {\n    Leaf(0)\n  }\n}", epilogue))
  let plan = plan_of(src)
  assert(!String::contains(plan, needle = "pick t path_drop"))
  assert(!String::contains(plan, needle = "pick t consume_mark:"))
}

test "a retained borrow-returning helper lets the callee release its parameter" {
  let src = String::concat(prelude, "let hold: (Array[Node]) -> Int = (xs) -> Array::length([\n  xs\n])\nlet view: (Array[Node]) -> Node = (xs) -> Array::get(xs, at = 0)\nlet pick: (Array[Node], Bool) -> Node = (xs, c) -> {\n  if c {\n    Leaf(hold(xs))\n  } else {\n    view(xs)\n  }\n}\nlet main: () -> Int = () -> {\n  match pick([\n    Leaf(1)\n  ], false) {\n    _ => 0\n  }\n}")
  let plan = plan_of(src)
  assert(String::contains(plan, needle = "pick xs path_drop"))
  assert(String::contains(plan, needle = "pick xs consume_mark:"))
  inspect(rc_validate_source(source = src, fn_filter = "pick", checked_error_row = false), content = "")
}

test "a parameter unused by the arm returning a local match payload gets a guarded drop" {
  let src = "enum Slot {\n  Full(Array[Int]);\n  Empty\n}\nfn pick(_ i: Int, _ fallback: Array[Int]) -> Array[Int] {\n  let slot = if i > 0 { Full([i]) } else { Empty }\n  match slot {\n    Full(value) => value,\n    Empty => fallback\n  }\n}\nfn main() -> Int { Array::length(pick(1, [2])) }"
  let plan = plan_of(src)
  assert(String::contains(plan, needle = "pick fallback path_drop 1"))
  assert(String::contains(plan, needle = "pick fallback consume_mark:"))
}

test "a prefix read can still make a parameter live through an arm without its name" {
  let src = "fn pick(_ c: Bool, _ xs: Array[Array[Int]]) -> Array[Int] {\n  let view = Array::get(xs, at = 0)\n  match c {\n    true => [Array::length([xs])],\n    false => view\n  }\n}\nfn main() -> Int { Array::length(pick(true, [[2]])) }"
  let plan = plan_of(src)
  assert(!String::contains(plan, needle = "pick xs path_drop"))
  assert(!String::contains(plan, needle = "pick xs consume_mark:"))
}

test "a scalar return releases a split parameter under the epilogue flag" {
  let src = "struct Box { xs: Array[Int] }\nfn sink(_ xs: Array[Int]) -> Int {\n  let box = Box::{ xs: xs }\n  Array::length(box.xs)\n}\nfn pick(_ xs: Array[Int], _ take: Bool, _ stop: Bool) -> Int {\n  let result = if take { sink(xs) } else { 0 }\n  if stop { return result }\n  result\n}\nfn main() -> Int { pick([1, 2], true, false) }"
  let plan = plan_of(src)
  assert(String::contains(plan, needle = "pick xs path_drop 1"))
  assert(String::contains(plan, needle = "pick xs consume_mark:"))
  assert(String::contains(plan, needle = "pick xs exit_drop:0:-1 1"))
  inspect(rc_validate_source(source = src, fn_filter = "pick", checked_error_row = false), content = "")
  let leaked = rc_validate_source_edited(source = src, fn_filter = "pick", edit = (_f: String, plan: Array[PerceusAction]) -> Array[PerceusAction] {
    let out: Array[PerceusAction] = []
    for action in plan {
      if !pa_is_exit_drop(action) || action.name != "xs" {
        Array::push(out, value = action)
      } else ()
    }
    out
  }, checked_error_row = false)
  assert(String::contains(leaked, needle = "owned value not consumed"))
}

test "a return inside a loop keeps the conservative split-parameter plan" {
  let src = "struct Box { xs: Array[Int] }\nfn sink(_ xs: Array[Int]) -> Int {\n  let box = Box::{ xs: xs }\n  Array::length(box.xs)\n}\nfn pick(_ xs: Array[Int], _ take: Bool, _ stop: Bool) -> Int {\n  let result = if take { sink(xs) } else { 0 }\n  let mut i = 0\n  while i < 2 {\n    if stop { return result }\n    i = i + 1\n  }\n  result\n}\nfn main() -> Int { pick([1, 2], true, false) }"
  let plan = plan_of(src)
  assert(!String::contains(plan, needle = "pick xs path_drop"))
  assert(!String::contains(plan, needle = "pick xs exit_drop:0:-1"))
}

test "owned return normalization releases split parameters on both return orders" {
  let prefix = "struct Holder { xs: Array[Array[Int]] }\nfn owned(_ xs: Array[Array[Int]]) -> Array[Int] {\n  let held = Holder::{ xs: xs }\n  [Array::get(Array::get(held.xs, 0), 0)]\n}\nfn pick(_ xs: Array[Array[Int]], _ take: Bool) -> Array[Int] {\n"
  let suffix = "\n}\nfn main() -> Int { Array::get(pick([[3]], false), 0) - 3 }"
  let bodies = [
    "  if take { return owned(xs) }\n  Array::get(xs, 0)",
    "  if take { return Array::get(xs, 0) }\n  owned(xs)"
  ]
  for body in bodies {
    let src = prefix + body + suffix
    let plan = plan_of(src)
    assert(String::contains(plan, needle = "pick xs exit_drop:0:"))
    inspect(rc_validate_source(source = src, fn_filter = "pick", checked_error_row = false), content = "")
  }
}

test "removing a retained-view return's exit release is rejected" {
  let src = "struct Holder { xs: Array[Array[Int]] }\nfn owned(_ xs: Array[Array[Int]]) -> Array[Int] {\n  let held = Holder::{ xs: xs }\n  [Array::get(Array::get(held.xs, 0), 0)]\n}\nfn pick(_ xs: Array[Array[Int]], _ take: Bool) -> Array[Int] {\n  if take { return Array::get(xs, 0) }\n  owned(xs)\n}\nfn main() -> Int { Array::get(pick([[3]], true), 0) - 3 }"
  let plan = plan_of(src)
  assert(String::contains(plan, needle = "pick xs exit_drop:0:2 1"))
  let leaked = rc_validate_source_edited(source = src, fn_filter = "pick", edit = (_f: String, plan: Array[PerceusAction]) -> Array[PerceusAction] {
    let out: Array[PerceusAction] = []
    for action in plan {
      if !pa_is_exit_drop(action) || action.name != "xs" {
        Array::push(out, value = action)
      } else ()
    }
    out
  }, checked_error_row = false)
  assert(String::contains(leaked, needle = "owned value not consumed"))
}

test "an explicitly returned match payload keeps the tail payload's conservative plan" {
  let prefix = "enum Slot { Full(Array[Int]); Empty }\nstruct Holder { slot: Slot }\nfn owned(_ slot: Slot) -> Array[Int] {\n  let held = Holder::{ slot: slot }\n  match held.slot { Full(value) => [Array::get(value, 0)], Empty => [0] }\n}\nfn pick(_ slot: Slot, _ take: Bool) -> Array[Int] {\n  if take { return owned(slot) }\n  match slot { Full(value) => "
  let suffix = ", Empty => [0] }\n}\nfn main() -> Int { Array::get(pick(Full([3]), false), 0) - 3 }"
  for result in ["value", "return value"] {
    let src = prefix + result + suffix
    let plan = plan_of(src)
    assert(!String::contains(plan, needle = "pick slot path_drop"))
    assert(!String::contains(plan, needle = "pick slot consume_mark:"))
  }
}
