  clear_caches_for(test_path)
  Fs::write_bytes(contract_path, string_to_bytes("fn public_value() -> Int\n"))
  Fs::write_bytes(impl_path, string_to_bytes("import ./impl_test.vibe { test_value }\n\nexport fn public_value() -> Int { test_value() }\n"))
  Fs::write_bytes(test_path, string_to_bytes("export fn test_value() -> Int { 42 }\n"))
  let failed = handle {
    let _ = collect_all_sources_fs(contract_path)
    false
  } with { Exception::Throw(msg) => String::contains(msg, "companion") && String::contains(msg, test_path) }
  assert(failed)
}

test "collect_all_sources_fs: explicit private and draft dependencies are same-owner sources" {
  let package_dir = "/tmp/vibe_compiler_vpkg_explicit_only/pkg"
  Fs::mkdir_p(package_dir)
  let contract_path = String::concat(package_dir, "/index.vpkg")
  let impl_path = String::concat(package_dir, "/impl.vibe")
  let private_path = String::concat(package_dir, "/_helper.vibe")
  let draft_path = String::concat(package_dir, "/experiment.draft.vibe")
  clear_caches_for(contract_path)
  clear_caches_for(impl_path)
  clear_caches_for(private_path)
  clear_caches_for(draft_path)
  Fs::write_bytes(contract_path, string_to_bytes("fn public_value() -> Int\n"))
  Fs::write_bytes(impl_path, string_to_bytes("import ./_helper.vibe { private_value }\nimport ./experiment.draft.vibe { draft_value }\n\nexport fn public_value() -> Int { private_value() + draft_value() }\n"))
  Fs::write_bytes(private_path, string_to_bytes("export fn private_value() -> Int { 20 }\n"))
  Fs::write_bytes(draft_path, string_to_bytes("export fn draft_value() -> Int { 22 }\n"))
  let sources = collect_all_sources_fs(contract_path)
  assert(contains_source_path(sources, private_path))
  assert(contains_source_path(sources, draft_path))
}

test "contract_package_hashes_fs: reachable explicit-only source content is covered" {
  let package_dir = "/tmp/vibe_compiler_vpkg_explicit_only_hash/pkg"
  Fs::mkdir_p(package_dir)
  let contract_path = String::concat(package_dir, "/index.vpkg")
  let impl_path = String::concat(package_dir, "/impl.vibe")
  let private_path = String::concat(package_dir, "/_helper.vibe")
  let draft_path = String::concat(package_dir, "/experiment.draft.vibe")
  Fs::write_bytes(contract_path, string_to_bytes("fn public_value() -> Int\n"))
  Fs::write_bytes(impl_path, string_to_bytes("import ./_helper.vibe { private_value }\nimport ./experiment.draft.vibe { draft_value }\n\nexport fn public_value() -> Int { private_value() + draft_value() }\n"))
  Fs::write_bytes(private_path, string_to_bytes("export fn private_value() -> Int { 20 }\n"))
  Fs::write_bytes(draft_path, string_to_bytes("export fn draft_value() -> Int { 22 }\n"))
  let (hash1, _) = contract_package_hashes_fs(contract_path)
  Fs::write_bytes(private_path, string_to_bytes("export fn private_value() -> Int { 21 }\n"))
  let (hash2, _) = contract_package_hashes_fs(contract_path)
  Fs::write_bytes(draft_path, string_to_bytes("export fn draft_value() -> Int { 23 }\n"))
  let (hash3, _) = contract_package_hashes_fs(contract_path)
  assert(hash1 != hash2)
  assert(hash2 != hash3)
}
