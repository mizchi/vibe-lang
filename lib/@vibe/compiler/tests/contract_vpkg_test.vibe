test "collect_all_sources_fs: owned package may import ownerless compatibility source" {
  let base_dir = "/tmp/vibe_compiler_ownerless_compatibility_source"
  let package_dir = String::concat(base_dir, "/pkg")
  Fs::mkdir_p(package_dir)
  let contract_path = String::concat(package_dir, "/index.vpkg")
  let impl_path = String::concat(package_dir, "/impl.vibe")
  let compatibility_path = String::concat(base_dir, "/shared.vibe")
  clear_caches_for(contract_path)
  clear_caches_for(impl_path)
  Fs::write_bytes(contract_path, string_to_bytes("fn package_value() -> Int\n"))
  Fs::write_bytes(impl_path, string_to_bytes("import ../shared.vibe { shared_value }\n\nexport fn package_value() -> Int { shared_value() }\n"))
  Fs::write_bytes(compatibility_path, string_to_bytes("export fn shared_value() -> Int { 42 }\n"))
  let sources = collect_all_sources_fs(contract_path)
  assert(contains_source_path(sources, compatibility_path))
}

test "contract_sibling_impl_raws: implicit roots are direct production siblings only" {
  let package_dir = "/tmp/vibe_compiler_direct_sibling_roots/pkg"
  let nested_dir = String::concat(package_dir, "/sub")
  Fs::mkdir_p(nested_dir)
  Fs::write_bytes(String::concat(package_dir, "/direct.vibe"), string_to_bytes("export fn direct() -> Int { 1 }\n"))
  Fs::write_bytes(String::concat(nested_dir, "/nested.vibe"), string_to_bytes("export fn nested() -> Int { 2 }\n"))
  let roots = contract_sibling_impl_raws(package_dir)
  assert(contains_string(roots, "./direct.vibe"))
  assert(!contains_string(roots, "./sub/nested.vibe"))
}

test "collect_all_sources_fs: index.vpkg and direct index.vibe entry is a hard error" {
  let package_dir = "/tmp/vibe_compiler_vpkg_legacy_index_conflict/pkg"
  Fs::mkdir_p(package_dir)
  let contract_path = String::concat(package_dir, "/index.vpkg")
  let legacy_path = String::concat(package_dir, "/index.vibe")
  clear_caches_for(contract_path)
  clear_caches_for(legacy_path)
  Fs::write_bytes(contract_path, string_to_bytes("fn contract_value() -> Int\n"))
  Fs::write_bytes(legacy_path, string_to_bytes("export fn legacy_value() -> Int { 1 }\n"))
  let failed = handle {
    let _ = collect_all_sources_fs(legacy_path)
    false
  } with { Exception::Throw(msg) => String::contains(msg, "index.vpkg") && String::contains(msg, "index.vibe") }
  assert(failed)
}

test "collect_all_sources_fs: warm cache cannot hide a new index spelling conflict" {
  let package_dir = "/tmp/vibe_compiler_vpkg_warm_conflict/pkg"
  Fs::mkdir_p(package_dir)
  let contract_path = String::concat(package_dir, "/index.vpkg")
  let impl_path = String::concat(package_dir, "/impl.vibe")
  let legacy_path = String::concat(package_dir, "/index.vibe")
  clear_caches_for(contract_path)
  remove_file_if_exists(legacy_path)
  Fs::write_bytes(contract_path, string_to_bytes("fn package_value() -> Int\n"))
  Fs::write_bytes(impl_path, string_to_bytes("export fn package_value() -> Int { 42 }\n"))
  let _ = collect_all_sources_fs(contract_path)
  Fs::write_bytes(legacy_path, string_to_bytes("export fn legacy_value() -> Int { 1 }\n"))
  let failed = handle {
    let _ = collect_all_sources_fs(contract_path)
    false
  } with { Exception::Throw(msg) => String::contains(msg, "index.vpkg") && String::contains(msg, "index.vibe") }
  assert(failed)
}

test "collect_all_sources_fs: warm cache observes a newly-added nested boundary" {
  let package_dir = "/tmp/vibe_compiler_vpkg_warm_nested_boundary/pkg"
  let nested_dir = String::concat(package_dir, "/sub")
  Fs::mkdir_p(nested_dir)
  let contract_path = String::concat(package_dir, "/index.vpkg")
  let impl_path = String::concat(package_dir, "/impl.vibe")
  let helper_path = String::concat(nested_dir, "/helper.vibe")
  let nested_contract = String::concat(nested_dir, "/index.vpkg")
  clear_caches_for(contract_path)
  remove_file_if_exists(nested_contract)
  Fs::write_bytes(contract_path, string_to_bytes("fn package_value() -> Int\n"))
  Fs::write_bytes(impl_path, string_to_bytes("import ./sub/helper.vibe { helper_value }\n\nexport fn package_value() -> Int { helper_value() }\n"))
  Fs::write_bytes(helper_path, string_to_bytes("export fn helper_value() -> Int { 42 }\n"))
  let _ = collect_all_sources_fs(contract_path)
  Fs::write_bytes(nested_contract, string_to_bytes("fn nested_value() -> Int\n"))
  let failed = handle {
    let _ = collect_all_sources_fs(contract_path)
    false
  } with { Exception::Throw(msg) => String::contains(msg, "package boundary") && String::contains(msg, nested_dir) }
  assert(failed)
}

test "collect_all_sources_fs: warm cache observes a new direct production root" {
  let package_dir = "/tmp/vibe_compiler_vpkg_warm_direct_root/pkg"
  Fs::mkdir_p(package_dir)
  let contract_path = String::concat(package_dir, "/index.vpkg")
  let impl_path = String::concat(package_dir, "/impl.vibe")
  let added_path = String::concat(package_dir, "/added.vibe")
  clear_caches_for(contract_path)
  remove_file_if_exists(added_path)
  Fs::write_bytes(contract_path, string_to_bytes("fn package_value() -> Int\n"))
  Fs::write_bytes(impl_path, string_to_bytes("export fn package_value() -> Int { 42 }\n"))
  let first = collect_all_sources_fs(contract_path)
  assert(!contains_source_path(first, added_path))
  Fs::write_bytes(added_path, string_to_bytes("// newly discovered direct root\n"))
  let second = collect_all_sources_fs(contract_path)
  assert(contains_source_path(second, added_path))
}

test "collect_all_sources_fs: symlink implementation source is rejected" {
  let package_dir = "/tmp/vibe_compiler_vpkg_symlink_source/pkg"
  Fs::mkdir_p(package_dir)
  let contract_path = String::concat(package_dir, "/index.vpkg")
  let target_path = String::concat(package_dir, "/impl_source.txt")
  let linked_path = String::concat(package_dir, "/impl.vibe")
  clear_caches_for(contract_path)
  Fs::write_bytes(contract_path, string_to_bytes("fn linked_value() -> Int\n"))
  Fs::write_bytes(target_path, string_to_bytes("export fn linked_value() -> Int { 42 }\n"))
  let _ = sh("ln -sf impl_source.txt /tmp/vibe_compiler_vpkg_symlink_source/pkg/impl.vibe")
  let failed = handle {
    let _ = collect_all_sources_fs(contract_path)
    false
  } with { Exception::Throw(msg) => String::contains(msg, "symlink") && String::contains(msg, linked_path) }
  assert(failed)
}

