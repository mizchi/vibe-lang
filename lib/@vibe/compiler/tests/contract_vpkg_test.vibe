  clear_caches_for(parent_contract)
  clear_caches_for(parent_impl)
  Fs::write_bytes(parent_contract, string_to_bytes("fn parent_value() -> Int\n"))
  Fs::write_bytes(parent_impl, string_to_bytes("import ./nested/nested_impl.vibe { nested_value }\n\nexport fn parent_value() -> Int { nested_value() + 1 }\n"))
  Fs::write_bytes(nested_contract, string_to_bytes("fn nested_value() -> Int\n"))
  Fs::write_bytes(nested_impl, string_to_bytes("export fn nested_value() -> Int { 41 }\n"))
  let failed = handle {
    let _ = collect_all_sources_fs(parent_contract)
    false
  } with { Exception::Throw(msg) => String::contains(msg, "package boundary") && String::contains(msg, nested_dir) }
  assert(failed)
