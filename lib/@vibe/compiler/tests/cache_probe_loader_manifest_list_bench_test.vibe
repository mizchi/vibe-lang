//# Imports

import ../loader_hotspot_probe.vibe {
  load_loader_hotspot_fixture,
  load_loader_hotspot_indexed_fixture,
  probe_loader_manifest_list_count,
  probe_loader_manifest_list_filter_indexed_count,
  probe_loader_manifest_list_filter_indexed_count_with_index,
  probe_loader_manifest_list_filter_source_indexed_count,
  probe_loader_manifest_list_filter_linear_count
}

//# Misc

test "bench: loader manifest list count" {
  let (_, _, preloaded_sources, _, needed_paths) = load_loader_hotspot_fixture()
  let count = probe_loader_manifest_list_count()
  let linear_count = probe_loader_manifest_list_filter_linear_count(
    preloaded_sources,
    needed_paths
  )
  let indexed_count = probe_loader_manifest_list_filter_indexed_count(
    preloaded_sources,
    needed_paths
  )
  let (_, _, indexed_preloaded_sources, _, indexed_needed_paths, indexed_preloaded_source_index, needed_path_index, _) = load_loader_hotspot_indexed_fixture()
  let prebuilt_indexed_count = probe_loader_manifest_list_filter_indexed_count_with_index(
    indexed_preloaded_sources,
    needed_path_index
  )
  let source_indexed_count = probe_loader_manifest_list_filter_source_indexed_count(
    indexed_needed_paths,
    indexed_preloaded_source_index
  )
  assert(eq(count, indexed_count))
  assert(eq(linear_count, indexed_count))
  assert(eq(indexed_count, prebuilt_indexed_count))
  assert(eq(indexed_count, source_indexed_count))
  assert(indexed_count > 30)
}
