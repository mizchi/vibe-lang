//# Imports

// ADR-0092 / #2389: plan-level reuse pairing -- the planner emits
// PaReuseToken/PaReuseAlloc candidates for same-arity constructor-rebuild
// arms, `vibe rc-plan` prints them, and ineligible shapes stay silent.

import @vibe/compiler/runtime {
  rc_plan_source
}

//# Functions

fn plan_of(source: String) -> String with Exception {
  rc_plan_source(source, "")
}

test "a tracked-let rebuild arm gets a reuse pair in the plan" {
  // The arm decomposes Pair, rebuilds a same-arity Pair through two
  // RC-tracked intermediate lets -- the exact shape the narrow Phase 1
  // fusion could not stage (its spine had planned actions).
  let src = "enum Node {\n  Leaf(Int);\n  Pair(Node, Node)\n}\nlet rec rebuild: (Node) -> Node = (n) -> {\n  match n {\n    Pair(a, b) => {\n      let a2 = rebuild(a)\n      let b2 = rebuild(b)\n      Pair(a2, b2)\n    },\n    Leaf(v) => Leaf(v + 1)\n  }\n}\nlet main: () -> Int = () -> {\n  match rebuild(Pair(Leaf(1), Leaf(2))) {\n    Pair(_, _) => 1,\n    Leaf(_) => 0\n  }\n}"
  let plan = plan_of(src)
  assert(String::contains(plan, "rebuild n reuse_token:2 1"))
  assert(String::contains(plan, "rebuild n reuse_alloc:2 1"))
}

test "rows carry the arity the codegen authorizes by" {
  // Two eligible rebuild arms over the SAME scrutinee at DIFFERENT
  // arities: the printed action carries the arity (`reuse_token:1` vs
  // `reuse_token:2`), because the codegen's authorization key is
  // (name, arity) -- without it the two rows would be indistinguishable
  // and the query could not reconstruct the plan it reports.
  let src = "enum Node {\n  Uno(Node);\n  Duo(Node, Node);\n  Z(Int)\n}\nlet rec walk: (Node) -> Node = (n) -> {\n  match n {\n    Uno(x) => {\n      let x2 = walk(x)\n      Uno(x2)\n    },\n    Duo(a, b) => {\n      let a2 = walk(a)\n      let b2 = walk(b)\n      Duo(a2, b2)\n    },\n    _ => Z(0)\n  }\n}\nlet main: () -> Int = () -> {\n  match walk(Duo(Z(1), Z(2))) {\n    _ => 0\n  }\n}"
  let plan = plan_of(src)
  assert(String::contains(plan, "walk n reuse_token:1 1"))
  assert(String::contains(plan, "walk n reuse_token:2 1"))
  assert(String::contains(plan, "walk n reuse_alloc:1 1"))
  assert(String::contains(plan, "walk n reuse_alloc:2 1"))
}

test "arms that keep the scrutinee alive or change arity stay unpaired" {
  // `keep` mentions the scrutinee in the arm body; `shrink`'s constructor
  // arm rebuilds at a DIFFERENT arity and its other arm is a wildcard
  // pattern (no decomposition to reuse). Neither may pair.
  let src = "enum Node {\n  Leaf(Int);\n  Pair(Node, Node)\n}\nlet keep: (Node) -> Node = (n) -> {\n  match n {\n    Pair(a, b) => {\n      let c = Pair(a, b)\n      n\n    },\n    Leaf(v) => n\n  }\n}\nlet shrink: (Node) -> Node = (n) -> {\n  match n {\n    Pair(a, _) => Leaf(0),\n    _ => Leaf(1)\n  }\n}\nlet main: () -> Int = () -> 0"
  let plan = plan_of(src)
  assert(!String::contains(plan, "keep n reuse_token"))
  assert(!String::contains(plan, "shrink n reuse_token"))
}

test "a lifted non-ident scrutinee reports its reuse pair on the lifted temp" {
  // The RC codegen plans the NORMALIZED body: `match mk(d) {..}` is lifted
  // to `let __m_scrut_0 = mk(d)\nmatch __m_scrut_0 {..}` before planning
  // (lift_match_scrutinees), and the rebuild arm pairs on that temp.
  // rc-plan must print the plan the codegen acts on, not a plan of the raw
  // body that has no such row (#2411 review).
  let src = "enum Node {\n  Leaf(Int);\n  Pair(Node, Node)\n}\nlet rec mk: (Int) -> Node = (d) -> {\n  if d <= 0 {\n    Leaf(1)\n  } else {\n    Pair(mk(d - 1), mk(d - 1))\n  }\n}\nlet crunch: (Int) -> Node = (d) -> {\n  match mk(d) {\n    Pair(a, b) => {\n      let a2 = a\n      let b2 = b\n      Pair(a2, b2)\n    },\n    _ => Leaf(0)\n  }\n}\nlet main: () -> Int = () -> 0"
  let plan = plan_of(src)
  assert(String::contains(plan, "crunch __m_scrut_0 reuse_token:2 1"))
  assert(String::contains(plan, "crunch __m_scrut_0 reuse_alloc:2 1"))
}

test "a control transfer inside the arm blocks the pairing" {
  // The return can skip the arm's tail, so the token could leak; the
  // planner must decline. A lambda-interior return must NOT block (it
  // leaves the lambda, not the arm).
  let src = "enum Node {\n  Leaf(Int);\n  Pair(Node, Node)\n}\nlet bail: (Node) -> Node = (n) -> {\n  match n {\n    Pair(a, b) => {\n      if false {\n        return Leaf(0)\n      } else {\n        ()\n      }\n      Pair(a, b)\n    },\n    _ => Leaf(1)\n  }\n}\nlet lam_ok: (Node) -> Node = (n) -> {\n  match n {\n    Pair(a, b) => {\n      let f = (x: Int) -> {\n        return x\n      }\n      let a2 = a\n      let b2 = b\n      Pair(a2, b2)\n    },\n    _ => Leaf(1)\n  }\n}\nlet main: () -> Int = () -> 0"
  let plan = plan_of(src)
  assert(!String::contains(plan, "bail n reuse_token"))
  assert(String::contains(plan, "lam_ok n reuse_token:2 1"))
}
