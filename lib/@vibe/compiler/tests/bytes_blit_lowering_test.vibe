import @vibe/compiler/codegen/builtin_bodies {
  gen_bytes_blit_linear_body
}
import ./codegen_test_support.vibe {
  compile_wasi, compile_wasi_rc
}
import @vibex/wasm_parser {
  get_code_body_range, module_code, module_exports, module_imports
}
import @vibex/wasm_runtime {
  disassemble
}

test "linear blit calls a range helper instead of emitting a byte loop" {
  let wasm = compile_wasi(source = "export fn copy() -> Unit { let dst = Bytes::new(); let src = Bytes::from_array([10, 20, 30]); Bytes::blit(dst, src, 1, 3) }", entry = "copy")
  let mut imports = 0
  for imp in module_imports(wasm) {
    let (_, _, kind, _) = imp
    if kind == 0 {
      imports = imports + 1
    }
  }
  let mut index = -1
  for exp in module_exports(wasm) {
    let (name, kind, idx) = exp
    if name == "copy" && kind == 0 {
      index = idx
    }
  }
  assert(index >= imports)
  let (offset, size, _) = Array::get(module_code(wasm), at = index - imports)
  let (start, end) = get_code_body_range(bytes = wasm, body_offset = offset, body_size = size)
  for instruction in disassemble(code = wasm, start = start, end_pos = end) {
    assert(!String::starts_with(instruction, prefix = "??"))
    assert(!String::starts_with(instruction, prefix = "loop"))
  }
}

fn assert_blit_bounds(source: String, label: String, expected: String) -> Unit with Exception + Fs + Process {
  let modules = [
    compile_wasi(source = source, entry = "main"),
    compile_wasi_rc(source = source, entry = "main")
  ]
  let mut i = 0
  for wasm in modules {
    let path = "/tmp/_bytes_blit_bounds_" + label + "_" + Int::to_string(i) + ".wasm"
    Fs::write_bytes(path, bytes = wasm)
    let output = sh_lines("wasmtime run -W exceptions=y --invoke main " + path + " 0 2>&1 || true")
    assert(String::contains(String::join(output, sep = "\n"), needle = expected))
    i = i + 1
  }
  ()
}

test "linear blit keeps negative and past-end source diagnostics" {
  assert_blit_bounds(source = "export fn main() -> Int { let src = Bytes::from_array([1, 2]); Bytes::blit(Bytes::new(), src, -1, 1); 0 }", label = "negative", expected = "Bytes::get: index -1 out of bounds for length 2")
  assert_blit_bounds(source = "export fn main() -> Int { let src = Bytes::from_array([1, 2]); Bytes::blit(Bytes::new(), src, 1, 3); 0 }", label = "end", expected = "Bytes::get: index 2 out of bounds for length 2")
  assert_blit_bounds(source = "export fn main() -> Int { let src = Bytes::from_array([1, 2]); Bytes::blit(Bytes::new(), src, (1 << 40) - 1, (1 << 40) + 1); 0 }", label = "wide", expected = "Bytes::get: index 1099511627775 out of bounds for length 2")
}

// Read the documented linear Bytes header to pin allocation policy, separately
// from content tests. Repeated 500/500/1-byte copies must not force a capacity
// beyond the old push loop's 1024 bytes (2 * requested length reserves 2008).
test "bulk blit keeps the capacity of repeated push" {
  let capacity = "(i64.extend_i32_u (i32.sub (i32.const 0) (i32.load (i32.wrap_i64 (local.get $b)))))"
  let body = "export fn main() -> Int { let src = Bytes::new(500); let dst = Bytes::new(); Bytes::blit(dst, src, 0, 500); Bytes::blit(dst, src, 0, 500); Bytes::blit(dst, src, 0, 1); capacity(dst) }"
  let plain = "fn capacity(b: Bytes) -> Int = wasm \"" + capacity + "\"\n" + body
  let tagged = "fn capacity(b: Bytes) -> Int = wasm \"(i64.shl " + capacity + " (i64.const 1))\"\n" + body
  let modules = [
    compile_wasi(source = plain, entry = "main"),
    compile_wasi_rc(source = tagged, entry = "main")
  ]
  let mut i = 0
  for wasm in modules {
    let path = "/tmp/_bytes_blit_capacity_" + Int::to_string(i) + ".wasm"
    Fs::write_bytes(path, bytes = wasm)
    let output = sh_lines("wasmtime run -W exceptions=y --invoke main " + path + " 0 2>/dev/null")
    assert(String::join(output, sep = "") == "1024")
    i = i + 1
  }
}

test "linear range helpers contain bulk memory copies on both allocation routes" {
  for rc in [false, true] {
    for arena in [-1, 65536] {
      let body = gen_bytes_blit_linear_body(enable_rc = rc, bytes_get_idx = 100, bytes_push_idx = 101, arena_ptr_addr = arena, arena_data_base = 66000, arena_limit = 131072)
      let mut copies = 0
      for instruction in disassemble(code = body, start = 0, end_pos = Bytes::length(body)) {
        assert(!String::starts_with(instruction, prefix = "??"))
        if instruction == "memory.copy" {
          copies = copies + 1
        }
      }
      // One copy preserves the destination on growth; one copies the range.
      inspect(copies, "2")
    }
  }
}
