import @vibe/compiler/core {
  Expr
}

import @vibe/core {
  array_empty
}

import @vibe/compiler/checker {
  check_perform_effects_expr_tx
}

test "A: shadowed ELet callback param is not treated as effectful" {
  let inner_lambda = EFn(array_empty(), array_empty(), array_empty(), None, None, EIdent("y", -1))
  let call_f = ECall(EIdent("f", -1), [EIdent("x", -1)], -1, [])
  let body = ELet("f", inner_lambda, call_f, -1)
  let errors = check_perform_effects_expr_tx(root = body, root_declared = array_empty(), root_in_handle = false, fn_names = array_empty(), fn_effs = array_empty(), root_ov_names = [
    "f"
  ], root_ov_effs = [["Fs"]])
  assert(Array::length(errors) == 0)
}
