//# Imports

// #3718 slice 1: `vibe rc-validate` checks each function's Perceus plan
// against the linear ownership discipline. The clean shapes below must answer
// "" (every checked binding balances on every path); the mutation cases edit
// ONE row of a real plan through the test seam and pin the line the validator
// gives for it, so a validator that stopped counting would fail here rather
// than stay quiet. The skip cases pin the shapes slice 1 reports as not
// checked instead of guessing at.

import @vibe/compiler/query {
  rc_plan_source, rc_validate_source, rc_validate_source_borrowing, rc_validate_source_edited
}

import @vibe/compiler/perceus {
  PerceusAction, pa_is_alias_dup, pa_is_consume_mark, pa_is_drop, pa_is_dup, pa_is_path_drop
}

//# Functions

// `keep` consumes its argument (it stores it), `len` only reads it.
let prologue = "enum D {\n  A(Array[Int])\n}\nlet keep: (D) -> Int = (d) -> {\n  let b = [d]\n  Array::length(b)\n}\nlet len: (D) -> Int = (d) -> {\n  match d {\n    A(xs) => Array::length(xs) + 0\n  }\n}\n"

let epilogue = "\nlet main: () -> Int = () -> {\n  run(true)\n}"

fn program(_ body: String) -> String {
  String::concat(prologue, String::concat(body, epilogue))
}

fn validate(_ body: String) -> String with Exception {
  rc_validate_source(source = program(body), fn_filter = "run")
}

fn plan(_ body: String) -> String with Exception {
  rc_plan_source(source = program(body), fn_filter = "run")
}

/// The plan without its first row `pick` accepts.
fn drop_first(plan: Array[PerceusAction], pick: (PerceusAction) -> Bool) -> Array[PerceusAction] {
  let out: Array[PerceusAction] = []
  let mut done = false
  for a in plan {
    if !done && pick(a) {
      done = true
    } else {
      Array::push(out, value = a)
    }
  }
  out
}

/// The plan with its first row `pick` accepts written twice.
fn twice_first(plan: Array[PerceusAction], pick: (PerceusAction) -> Bool) -> Array[PerceusAction] {
  let out: Array[PerceusAction] = []
  let mut done = false
  for a in plan {
    Array::push(out, value = a)
    if !done && pick(a) {
      done = true
      Array::push(out, value = a)
    } else {
      ()
    }
  }
  out
}

/// The plan with every consume mark of `name` moved to source offset `off`.
fn move_marks(plan: Array[PerceusAction], name: String, off: Int) -> Array[PerceusAction] {
  let out: Array[PerceusAction] = []
  for a in plan {
    if pa_is_consume_mark(a) && a.name == name {
      Array::push(out, value = PerceusAction::{
        kind: a.kind,
        name: a.name,
        binding_id: a.binding_id,
        use_offset: off,
        extra: a.extra
      })
    } else {
      Array::push(out, value = a)
    }
  }
  out
}

fn edited(body: String, edit: (String, Array[PerceusAction]) -> Array[PerceusAction]) -> String with Exception {
  rc_validate_source_edited(source = program(body), fn_filter = "run", edit = edit)
}

let two_consumes = "let run: (Bool) -> Int = (c) -> {\n  let d = A([1])\n  keep(d) + keep(d)\n}"

let borrow_then_consume = "let run: (Bool) -> Int = (c) -> {\n  let d = A([1])\n  let n = len(d)\n  n + keep(d)\n}"

let split = "let run: (Bool) -> Int = (c) -> {\n  let d = A([1])\n  if c {\n    keep(d)\n  } else {\n    0\n  }\n}"

let merge = "let run: (Bool) -> Int = (c) -> {\n  let d = A([1])\n  if c {\n    keep(d)\n  } else {\n    len(d)\n  }\n}"

//# Clean plans

test "two consumes of one binding take one dup" {
  inspect(plan(two_consumes), content = "run d dup 1")
  inspect(validate(two_consumes), content = "")
}

test "a borrow before the consume keeps the drop" {
  inspect(validate(borrow_then_consume), content = "")
}

test "a split release balances both branches" {
  inspect(validate(split), content = "")
}

test "a branch-dependent dup balances both branches" {
  inspect(validate(merge), content = "")
}

test "an alias that transfers and one that dups both balance" {
  inspect(validate("let run: (Bool) -> Int = (c) -> {\n  let d = A([1])\n  let e = d\n  keep(e)\n}"), content = "")
  inspect(validate("let run: (Bool) -> Int = (c) -> {\n  let d = A([1])\n  let e = d\n  keep(e) + keep(d)\n}"), content = "")
}

test "the same name in both branches is one consume" {
  inspect(validate("let run: (Bool) -> D = (c) -> {\n  let d = A([1])\n  if c {\n    d\n  } else {\n    d\n  }\n}"), content = "")
}

test "labeled arguments are planned through the checker's placement" {
  inspect(validate("let run: (Bool) -> Int = (c) -> {\n  let t = [1, 2]\n  Array::get(t, at = 0) + Array::length(t)\n}"), content = "")
}

//# Mutated plans

test "a deleted scope-end drop leaks" {
  let out = edited(body = borrow_then_consume, edit = (f: String, p: Array[PerceusAction]) -> Array[PerceusAction] {
    drop_first(plan = p, pick = (a: PerceusAction) -> Bool {
      pa_is_drop(a) && a.name == "d"
    })
  })
  inspect(out, content = "run d -: owned value not consumed")
}

test "a deleted dup releases one more than held" {
  let out = edited(body = two_consumes, edit = (f: String, p: Array[PerceusAction]) -> Array[PerceusAction] {
    drop_first(plan = p, pick = (a: PerceusAction) -> Bool {
      pa_is_dup(a) && a.name == "d"
    })
  })
  inspect(out, content = "run d -: owned value released 1 more than held")
}

test "a duplicated dup leaks" {
  let out = edited(body = two_consumes, edit = (f: String, p: Array[PerceusAction]) -> Array[PerceusAction] {
    twice_first(plan = p, pick = (a: PerceusAction) -> Bool {
      pa_is_dup(a) && a.name == "d"
    })
  })
  inspect(out, content = "run d -: owned value not consumed")
}

test "a deleted path drop leaks on the branch that did not consume" {
  let out = edited(body = split, edit = (f: String, p: Array[PerceusAction]) -> Array[PerceusAction] {
    drop_first(plan = p, pick = (a: PerceusAction) -> Bool {
      pa_is_path_drop(a) && a.name == "d"
    })
  })
  inspect(out, content = "run d if1:else: owned value not consumed")
}

test "a deleted consume mark releases twice on the consuming branch" {
  let out = edited(body = split, edit = (f: String, p: Array[PerceusAction]) -> Array[PerceusAction] {
    drop_first(plan = p, pick = (a: PerceusAction) -> Bool {
      pa_is_consume_mark(a) && a.name == "d"
    })
  })
  inspect(out, content = "run d if1:then: owned value released 1 more than held")
}

test "a consume mark on a borrowed occurrence is structural" {
  let out = edited(body = split, edit = (f: String, p: Array[PerceusAction]) -> Array[PerceusAction] {
    move_marks(plan = p, name = "d", off = 1)
  })
  inspect(out, content = "run d -: consume mark at offset 1 is not a consuming occurrence\nrun d if1:then: owned value released 1 more than held")
}

test "a borrowed parameter consumed without a dup" {
  let src = program("let run: (Bool) -> Int = (c) -> {\n  sink(d = A([1]))\n}\nlet sink: (D) -> Int = (d) -> {\n  keep(d)\n}")
  inspect(rc_validate_source_borrowing(source = src, fn_filter = "sink", borrow_fn = "sink", borrow_mask = 1), content = "sink d -: borrowed parameter consumed without a dup")
  inspect(rc_validate_source(source = src, fn_filter = "sink"), content = "")
}

//# Known leaks

test "a binding consumed on one branch and read in place on the other" {
  inspect(validate("let run: (Bool) -> Int = (c) -> {\n  let t = [1, 2]\n  if c {\n    keep(A(t))\n  } else {\n    Array::get(t, at = 0)\n  }\n}"), content = "run t if1:else: owned value not consumed")
}

// Slice 3 checks early exits: the plan takes a dup at the declaration for
// the guard's consume and releases it at the exit, so the path that never
// reaches the exit keeps it (112 B per call, measured). More exit shapes are
// in perceus_validate_exit_test.vibe.
test "an early return that consumes leaks the dup on the path that does not return" {
  inspect(validate("let run: (Bool) -> Int = (c) -> {\n  let d = A([1])\n  if c {\n    return keep(d)\n  } else {\n    ()\n  }\n  len(d)\n}"), content = "run d if1:else: owned value not consumed")
}

//# Not checked

test "a closure capture is not checked" {
  inspect(validate("let run: (Bool) -> Int = (c) -> {\n  let d = A([1])\n  let f = () -> keep(d)\n  f()\n}"), content = "run d -: not checked: closure capture\nrun * -: not checked: lambda body")
}

test "a reuse row is not checked" {
  inspect(validate("let run: (Bool) -> Int = (c) -> {\n  let d = A([1])\n  let e = match d {\n    A(xs) => A(xs)\n  }\n  keep(e)\n}"), content = "run d -: not checked: reuse row\nrun * -: not checked: 1 pattern binders, 0 let mut")
}

//# Loops

// #3718 slice 2: a loop body is taken 0, 1 and 2 times. A binding declared
// before the loop is loop-carried there, and codegen retains it where it is
// a call argument or an aggregate item, so those occurrences consume
// nothing; its own reference is released at its scope end.

let carried = "let run: (Bool) -> Int = (c) -> {\n  let d = A([1])\n  let mut k = 0\n  while k < 2 {\n    k = k + keep(d)\n  }\n  k\n}"

let carried_after = "let run: (Bool) -> Int = (c) -> {\n  let d = A([1])\n  let mut k = 0\n  while k < 2 {\n    k = k + keep(d)\n  }\n  k + keep(d)\n}"

let body_split = "let run: (Bool) -> Int = (c) -> {\n  let mut k = 0\n  while k < 2 {\n    let d = A([k])\n    if c {\n      keep(d)\n    } else {\n      0\n    }\n    k = k + 1\n  }\n  k\n}"

let carried_alias = "let run: (Bool) -> Int = (c) -> {\n  let d = A([1])\n  let mut k = 0\n  while k < 2 {\n    let e = d\n    k = k + keep(e)\n  }\n  k\n}"

// #3168: a parameterized `loop` whose value is discarded. Its result slot
// owns what `break d` stores, and its scope end releases it.
let loop_discarded = "let run: (Bool) -> Int = (c) -> {\n  loop (i = 0) {\n    let d = A([i])\n    if i == 2 {\n      break d\n    }\n    continue(i + 1)\n  }\n  0\n}"

let loop_used = "let run: (Bool) -> Int = (c) -> {\n  let r = loop (i = 0) {\n    let d = A([i])\n    if i == 2 {\n      break d\n    }\n    continue(i + 1)\n  }\n  keep(r)\n}"

test "a loop-carried binding passed to a consuming call keeps its drop" {
  inspect(plan(carried), content = "run __seq0 drop 1\nrun d drop 1")
  inspect(validate(carried), content = "")
}

test "a deleted drop of a loop-carried binding leaks" {
  let out = edited(body = carried, edit = (f: String, p: Array[PerceusAction]) -> Array[PerceusAction] {
    drop_first(plan = p, pick = (a: PerceusAction) -> Bool {
      pa_is_drop(a) && a.name == "d"
    })
  })
  inspect(out, content = "run d -: owned value not consumed")
}

test "a dup for a consume after the loop balances a loop-carried binding" {
  inspect(validate(carried_after), content = "")
}

test "a deleted dup after a loop releases one more than held" {
  let out = edited(body = carried_after, edit = (f: String, p: Array[PerceusAction]) -> Array[PerceusAction] {
    drop_first(plan = p, pick = (a: PerceusAction) -> Bool {
      pa_is_dup(a) && a.name == "d"
    })
  })
  inspect(out, content = "run d -: owned value released 1 more than held")
}

test "a duplicated dup around a loop leaks" {
  let out = edited(body = carried_after, edit = (f: String, p: Array[PerceusAction]) -> Array[PerceusAction] {
    twice_first(plan = p, pick = (a: PerceusAction) -> Bool {
      pa_is_dup(a) && a.name == "d"
    })
  })
  inspect(out, content = "run d -: owned value not consumed")
}

test "a split release inside a loop body balances each iteration" {
  inspect(validate(body_split), content = "")
}

test "a deleted path drop inside a loop body leaks on the branch that kept it" {
  let out = edited(body = body_split, edit = (f: String, p: Array[PerceusAction]) -> Array[PerceusAction] {
    drop_first(plan = p, pick = (a: PerceusAction) -> Bool {
      pa_is_path_drop(a) && a.name == "d"
    })
  })
  inspect(out, content = "run d if1:else: owned value not consumed")
}

test "a loop-carried alias without its alias dup is released once per iteration" {
  inspect(validate(carried_alias), content = "")
  let out = edited(body = carried_alias, edit = (f: String, p: Array[PerceusAction]) -> Array[PerceusAction] {
    drop_first(plan = p, pick = (a: PerceusAction) -> Bool {
      pa_is_alias_dup(a) && a.name == "e"
    })
  })
  inspect(out, content = "run d loop1:once: owned value released 1 more than held")
}

test "a break leaves a loop-carried binding live" {
  inspect(validate("let run: (Bool) -> Int = (c) -> {\n  let d = A([1])\n  let mut k = 0\n  while k < 3 {\n    if k > 1 {\n      break\n    }\n    k = k + keep(d)\n  }\n  k\n}"), content = "")
}

let carried_tuple = "let run: (Bool) -> Int = (c) -> {\n  let d = A([1])\n  let mut k = 0\n  while k < 2 {\n    let t = (d, 1)\n    k = k + t.1\n  }\n  k\n}"

let carried_iterable = "let run: (Bool) -> Int = (c) -> {\n  let d = A([1])\n  let mut k = 0\n  for x in [d] {\n    k = k + len(x)\n  }\n  k\n}"

/// The plan without `d`'s scope-end drop: what the planner gave both shapes
/// before #3879, when it counted the aggregate item as `d`'s consume.
fn pre_3879(f: String, p: Array[PerceusAction]) -> Array[PerceusAction] {
  drop_first(plan = p, pick = (a: PerceusAction) -> Bool {
    pa_is_drop(a) && a.name == "d"
  })
}

test "a loop-carried value stored into a tuple keeps its drop (#3879)" {
  // Codegen retains a loop-carried name at an aggregate item, so the plan
  // counts the item as a borrow and releases `d` at its scope end.
  inspect(plan(carried_tuple), content = "run t drop 1\nrun __seq0 drop 1\nrun d drop 1")
  inspect(validate(carried_tuple), content = "")
}

test "the pre-#3879 tuple plan leaks the loop-carried value" {
  // Before the fix the item transferred `d` into the tuple and `d` had no
  // drop; codegen's per-iteration retain left `d`'s own reference behind
  // (88 B per call under VIBE_RC=1).
  inspect(edited(body = carried_tuple, edit = pre_3879), content = "run d -: owned value not consumed")
}

test "an outer binding in a for iterable keeps its drop (#3879)" {
  // `compile_forin_loop` makes the enclosing locals loop-borrowed before it
  // compiles the iterable, so `[d]` retains `d` there; the plan now counts
  // that item as a borrow too.
  inspect(validate(carried_iterable), content = "run x -: not checked: loop binder (a for element or a loop parameter)")
}

test "the pre-#3879 for-iterable plan leaks the outer binding" {
  inspect(edited(body = carried_iterable, edit = pre_3879), content = "run d -: owned value not consumed\nrun x -: not checked: loop binder (a for element or a loop parameter)")
}

test "a parameter retained in a loop with no planned drop is not checked" {
  let src = String::concat(prologue, "let sink: (D) -> Int = (d) -> {\n  let mut k = 0\n  while k < 2 {\n    k = k + keep(d)\n  }\n  k\n}\nlet main: () -> Int = () -> {\n  sink(A([1]))\n}")
  inspect(rc_validate_source(source = src, fn_filter = "sink"), content = "")
  let out = rc_validate_source_edited(source = src, fn_filter = "sink", edit = (f: String, p: Array[PerceusAction]) -> Array[PerceusAction] {
    drop_first(plan = p, pick = (a: PerceusAction) -> Bool {
      pa_is_drop(a) && a.name == "d"
    })
  })
  inspect(out, content = "sink d -: not checked: loop: a parameter retained in a loop with no planned drop")
}

test "a discarded parameterized loop releases its break value (#3168)" {
  // Slice 3: `break d` leaves `d`'s scope, and the exit row releases what
  // the store into the result slot did not take.
  inspect(validate(loop_discarded), content = "")
  inspect(validate(loop_used), content = "")
}

test "the #3168 plan without the result slot's drop leaks the break value" {
  // Before the fix the slot was classified from its `0` placeholder and got
  // no scope-end drop; deleting the row the fix added rebuilds that plan.
  let out = edited(body = loop_discarded, edit = (f: String, p: Array[PerceusAction]) -> Array[PerceusAction] {
    drop_first(plan = p, pick = (a: PerceusAction) -> Bool {
      pa_is_drop(a) && a.name == "__loop_result"
    })
  })
  inspect(out, content = "run __loop_result loop1:once,if1:then: owned value not consumed")
}

// #3919: a compound `for` iterable whose result leaf names a loop-carried
// binding. Codegen retains the leaf and releases the iterable after the loop,
// so the plan reads the leaf as a borrow and `d` keeps its scope-end drop.
let tail_iterable = "let run: (Bool) -> Int = (c) -> {\n  let d = [A([1])]\n  let mut k = 0\n  for x in if c {\n    d\n  } else {\n    [A([2])]\n  } {\n    k = k + len(x)\n  }\n  k\n}"

test "a for iterable's branch leaf naming an outer binding is a borrow (#3919)" {
  inspect(plan(tail_iterable), content = "run x drop 1\nrun __seq0 drop 1\nrun __seq1 drop 1\nrun d drop 1")
  inspect(validate(tail_iterable), content = "run x -: not checked: loop binder (a for element or a loop parameter)")
}

test "a deleted drop of an iterable-tail borrow leaks" {
  // The leaf consumes nothing, so the drop is the only release of `d`'s own
  // reference. (Before #3919 the plan split `d` instead -- a consume mark on
  // the leaf and a path drop -- which leaks once codegen retains the leaf.)
  inspect(edited(body = tail_iterable, edit = pre_3879), content = "run d -: owned value not consumed\nrun x -: not checked: loop binder (a for element or a loop parameter)")
}

// #3933 review: only the iterable's RESULT leaves are retained. A name in a
// non-result position of the iterable -- here a compound call argument in a
// statement before the tail -- is consumed like anywhere else in the loop's
// retain context, and a loop-carried name consumed through a branch value
// is not checked. Counting it as a retained leaf read `d` as leaked.
let iter_statement = "let run: (Bool) -> Int = (c) -> {\n  let d = A([1])\n  let mut k = 0\n  for x in {\n    k = k + keep(if c {\n      d\n    } else {\n      A([2])\n    })\n    [A([0])]\n  } {\n    k = k + len(x)\n  }\n  k\n}"

test "a statement inside a for iterable is not a result leaf (#3933)" {
  inspect(plan(iter_statement), content = "run x drop 1\nrun __seq0 drop 1\nrun __seq1 drop 1\nrun d consume_mark:288 1\nrun d path_drop 1")
  inspect(validate(iter_statement), content = "run d -: not checked: loop: consumed through a branch or block value\nrun x -: not checked: loop binder (a for element or a loop parameter)")
}

test "a plan made to balance only by miscounting an iterable statement is not accepted (#3933)" {
  // Without its consume mark the path drop would release `d` on the path that
  // already handed it to `keep`. Counted as a retained result leaf, that
  // occurrence released nothing and the plan read as balanced.
  let out = edited(body = iter_statement, edit = (f: String, p: Array[PerceusAction]) -> Array[PerceusAction] {
    drop_first(plan = p, pick = (a: PerceusAction) -> Bool {
      pa_is_consume_mark(a) && a.name == "d"
    })
  })
  inspect(out, content = "run d -: not checked: loop: consumed through a branch or block value\nrun x -: not checked: loop binder (a for element or a loop parameter)")
}
