//# Imports

import @vibe/core {
  array_empty
}

import @vibe/compiler/entry/source_compile/wasi_only {
  compile_file_wasi_library
}

// #3132 review: a library that defines `export fn Array::length` has that
// definition renamed aside inside the compilation (so the compiler's own
// `Array::length` calls reach the builtin), but what leaves the compilation is
// the library's EXPORT SURFACE, and an importer looks the function up by the
// name the library wrote. The export must stay `Array::length`, never the
// internal `Array::length$user`. This lane also parses without source offsets,
// the case #3132's first provenance rule got wrong.

//# Functions

fn string_to_bytes(s: String) -> Bytes {
  let out = array_empty()
  let len = String::length(s)
  let mut i = 0
  while i < len {
    Array::push(out, String::char_code_at(s, i))
    i = i + 1
  }
  Bytes::from_array(out)
}

fn read_uleb(b: Bytes, pos: Int) -> (Int, Int) {
  let mut result = 0
  let mut shift = 0
  let mut p = pos
  let mut more = true
  while more {
    let byte = Bytes::get(b, p)
    result = result|((byte&127)<<shift)
    shift = shift + 7
    p = p + 1
    more = (byte&128) != 0
  }
  (result, p)
}

/// The function export names of a wasm module, from its export section (id 7).
fn function_export_names(b: Bytes) -> Array[String] {
  let names: Array[String] = []
  let mut pos = 8
  while pos < Bytes::length(b) {
    let id = Bytes::get(b, pos)
    let (size, body) = read_uleb(b, pos + 1)
    if id == 7 {
      let (count, first) = read_uleb(b, body)
      let mut p = first
      let mut i = 0
      while i < count {
        let (nlen, nstart) = read_uleb(b, p)
        let mut name = ""
        let mut k = 0
        while k < nlen {
          name = String::concat(name, String::from_char_code(Bytes::get(b, nstart + k)))
          k = k + 1
        }
        let kind = Bytes::get(b, nstart + nlen)
        let (_, after) = read_uleb(b, nstart + nlen + 1)
        if kind == 0 {
          Array::push(names, name)
        } else {
          ()
        }
        p = after
        i = i + 1
      }
    } else {
      ()
    }
    pos = body + size
  }
  names
}

fn contains_name(names: Array[String], name: String) -> Bool {
  let mut found = false
  let mut i = 0
  while i < Array::length(names) {
    if Array::get(names, i) == name {
      found = true
    } else {
      ()
    }
    i = i + 1
  }
  found
}

test "#3132 review: a library's own Array::length is exported under its source name" {
  let base_dir = "/tmp/vibe_builtin_shadow_library_export"
  let lib_path = String::concat(base_dir, "/lib.vibe")
  Fs::mkdir_p(base_dir)
  let src = "export fn Array::length(xs: Array[String]) -> Int {\n  let _ = xs\n  77\n}\n\nexport fn count_twice(xs: Array[String]) -> Int {\n  Array::length(xs) + Array::length(xs)\n}\n"
  Fs::write_bytes(lib_path, string_to_bytes(src))
  let names = function_export_names(compile_file_wasi_library(lib_path))
  assert(contains_name(names, "Array::length"))
  assert(!contains_name(names, "Array::length$user"))
  assert(contains_name(names, "count_twice"))
}
