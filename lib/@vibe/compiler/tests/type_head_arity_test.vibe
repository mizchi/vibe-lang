//# #3536: a type head must carry the arguments its declaration takes

// Three annotations named no checked type. A generic head written bare
// (`-> Array`, `-> Box`) resolved to a wildcard, so `["str"]` flowed into an
// `Array[Int]` and `+ 1` read the string's pointer. A cyclic alias
// (`type A = B` / `type B = A`) accepted every value the same way. An alias
// applied to too many arguments (`Bx[Int, String]`) dropped the extra one.
import @vibe/compiler/runtime {
  collect_all_diagnostics, collect_all_diagnostics_for_path
}

/// A bare builtin generic in a return type.
test "a bare Array return type is refused" {
  let src = "fn mk() -> Array {\n  [\"str\"]\n}\n"
  inspect(collect_all_diagnostics(src), "[write `Array[T]` with the type arguments it holds: `Array` takes 1 type argument, but none were given in the return type]")
}

/// A bare program generic in a return type.
test "a bare generic struct return type is refused" {
  let src = "struct Box[T] {\n  v: T\n}\n\nfn mk() -> Box {\n  Box::{ v: \"str\" }\n}\n"
  inspect(collect_all_diagnostics(src), "[write `Box[T]` with the type arguments it holds: `Box` takes 1 type argument, but none were given in the return type]")
}

/// A bare generic as a parameter type, nested in a tuple.
test "a bare Option nested in a parameter type is refused" {
  let src = "fn f(p: (Int, Option)) -> Int {\n  p.0\n}\n"
  inspect(collect_all_diagnostics(src), "[write `Option[T]` with the type arguments it holds: `Option` takes 1 type argument, but none were given in parameter `p`]")
}

/// A bare program generic as a parameter type read its field at any type.
test "a bare generic struct parameter type is refused" {
  let src = "struct Box[T] {\n  v: T\n}\n\nfn get(b: Box) -> Int {\n  b.v\n}\n"
  inspect(collect_all_diagnostics(src), "[write `Box[T]` with the type arguments it holds: `Box` takes 1 type argument, but none were given in parameter `b`]")
}

/// In a `let` annotation a bare head is a partial annotation the value fills.
test "a bare generic in a let annotation stays a partial annotation" {
  let src = "struct Box[T] {\n  v: T\n}\n\nfn f() -> Int {\n  let b: Box = Box::{ v: 1 }\n  b.v\n}\n"
  inspect(collect_all_diagnostics(src), "[]")
}

/// An impl method may name its own target bare where the target's formals
/// are erased.
test "an impl method naming its own target bare is accepted" {
  let src = "trait Next[T] {\n  next(Self) -> Option[(T, Self)]\n}\n\nstruct It[T] {\n  v: T\n}\n\nimpl Next for It {\n  next(self) -> Option[(T, It)] {\n    None\n  }\n}\n"
  inspect(collect_all_diagnostics(src), "[]")
}

/// Two aliases naming each other.
test "a cyclic alias pair is refused" {
  let src = "type A = B\ntype B = A\n\nfn f(x: A) -> Int {\n  x\n}\n"
  inspect(collect_all_diagnostics(src), "[type alias `A` refers to itself, and an alias is expanded in place, so it names no type -- declare a `struct` or `enum` to hold the recursive part, or point the alias at an existing type, type alias `B` refers to itself, and an alias is expanded in place, so it names no type -- declare a `struct` or `enum` to hold the recursive part, or point the alias at an existing type]")
}

/// An alias naming itself through an application.
test "a self-referencing alias is refused" {
  let src = "type L = Array[L]\n"
  inspect(collect_all_diagnostics(src), "[type alias `L` refers to itself, and an alias is expanded in place, so it names no type -- declare a `struct` or `enum` to hold the recursive part, or point the alias at an existing type]")
}

/// An alias applied to more arguments than it declares.
test "an alias applied to too many arguments is refused" {
  let src = "type Bx[T] = Array[T]\n\nfn f(x: Bx[Int, String]) -> Int {\n  Array::length(x)\n}\n"
  inspect(collect_all_diagnostics(src), "[write `Bx[T]`: `Bx` takes 1 type argument, but 2 were given in parameter `x`]")
}

/// A generic struct applied to fewer arguments than it declares.
test "a struct applied to too few arguments is refused" {
  let src = "struct P[A, B] {\n  a: A;\n  b: B\n}\n\nfn f(p: P[Int]) -> Int {\n  p.a\n}\n"
  inspect(collect_all_diagnostics(src), "[write `P[T, U]`: `P` takes 2 type arguments, but 1 was given in parameter `p`]")
}

/// The written forms with their arguments, and an acyclic alias chain.
test "applied heads and an acyclic alias chain are accepted" {
  let src = "struct Box[T] {\n  v: T\n}\n\ntype Bx[T] = Array[T]\ntype Ints = Bx[Int]\n\nfn mk() -> Box[Array[Int]] {\n  Box::{ v: [1] }\n}\n\nfn f(x: Ints, m: Map[String, Int]) -> Int {\n  Array::length(x)\n}\n"
  inspect(collect_all_diagnostics(src), "[]")
}

/// A type-constructor slot takes a bare constructor.
test "a bare constructor in a constructor slot is accepted" {
  let src = "enum K[T, F[_]] {\n  Hold(T, F[Int])\n}\n\nfn f(k: K[Int, Option]) -> Int {\n  0\n}\n"
  inspect(collect_all_diagnostics(src), "[]")
}

/// A declaration's type is as rigid as a signature's: a bare head in a struct
/// field stored an `Array[String]` a reader took back as an `Array[Int]`.
test "a bare Array struct field is refused" {
  let src = "struct Box {\n  xs: Array\n}\n"
  inspect(collect_all_diagnostics(src), "[write `Array[T]` with the type arguments it holds: `Array` takes 1 type argument, but none were given in field `xs` of struct `Box`]")
}

/// A bare program generic in an enum payload.
test "a bare generic enum payload is refused" {
  let src = "struct Box[T] {\n  v: T\n}\n\nenum Holder {\n  H(Box)\n}\n"
  inspect(collect_all_diagnostics(src), "[write `Box[T]` with the type arguments it holds: `Box` takes 1 type argument, but none were given in the payload of `Holder::H`]")
}

/// A bare head as a type alias body.
test "a bare Option alias body is refused" {
  let src = "type Maybe = Option\n"
  inspect(collect_all_diagnostics(src), "[write `Option[T]` with the type arguments it holds: `Option` takes 1 type argument, but none were given in the body of type alias `Maybe`]")
}

/// A bare head in an effect operation's result.
test "a bare Map effect operation result is refused" {
  let src = "effect Src {\n  Get() -> Map\n}\n"
  inspect(collect_all_diagnostics(src), "[write `Map[T, U]` with the type arguments it holds: `Map` takes 2 type arguments, but none were given in the signature of `Src::Get`]")
}

/// A bare head in a trait method signature is judged as the signature of the
/// method's dispatcher.
test "a bare Array trait method result is refused" {
  let src = "trait Source {\n  items(Self) -> Array\n}\n"
  inspect(collect_all_diagnostics(src), "[write `Array[T]` with the type arguments it holds: `Array` takes 1 type argument, but none were given in the return type]")
}

/// A bare head in an extern declaration's type.
test "a bare Array extern is refused" {
  let src = "extern let % host_items: Array\n"
  inspect(collect_all_diagnostics(src), "[write `Array[T]` with the type arguments it holds: `Array` takes 1 type argument, but none were given in extern declaration `%host_items`]")
}

/// Declarations naming their own formals, applied heads, a constructor slot,
/// a kinded formal, and a struct declared after its use are all accepted.
test "applied heads in declarations are accepted" {
  let src = "enum K[T, F[_]] {\n  Hold(T, F[Int])\n}\n\nstruct S[T, F[_]] {\n  xs: Array[T];\n  k: K[T, Option];\n  f: F[T];\n  later: Later[T]\n}\n\ntype Ys[T] = Array[Later[T]]\n\ntrait Source[T] {\n  items(Self) -> Array[T]\n}\n\nstruct Later[T] {\n  v: T\n}\n"
  inspect(collect_all_diagnostics(src), "[]")
}

/// #3551 review: a compiler-owned head has no declaration to count against,
/// so an applied one went uncounted -- `ArrayBuilder[String, Int]` accepted
/// an `ArrayBuilder[Int]` and froze it into an `Array[String]`.
test "a compiler-owned head applied to too many arguments is refused" {
  let src = "fn take(b: ArrayBuilder[String, Int]) -> Array[String] {\n  ArrayBuilder::freeze(b)\n}\n"
  inspect(collect_all_diagnostics(src), "[write `ArrayBuilder[T]`: `ArrayBuilder` takes 1 type argument, but 2 were given in parameter `b`]")
}

/// A compiler-owned head applied to too few arguments.
test "a compiler-owned head applied to too few arguments is refused" {
  let src = "fn f(m: MapBuilder[Int]) -> Int {\n  0\n}\n"
  inspect(collect_all_diagnostics(src), "[write `MapBuilder[T, U]`: `MapBuilder` takes 2 type arguments, but 1 was given in parameter `m`]")
}

/// `Future` takes one type argument and has no region slot.
test "a Future applied to two arguments is refused" {
  let src = "fn f(x: Future[Int, String]) -> Int {\n  0\n}\n"
  inspect(collect_all_diagnostics(src), "[write `Future[T]`: `Future` takes 1 type argument, but 2 were given in parameter `x`]")
}

/// A compiler-owned head that takes no arguments.
test "a compiler-owned head that takes none is refused when applied" {
  let src = "fn f(b: StringBuilder[Int]) -> Int {\n  0\n}\n"
  inspect(collect_all_diagnostics(src), "[write `StringBuilder` without type arguments: `StringBuilder` takes no type arguments, but 1 was given in parameter `b`]")
}

/// A region-first head may leave out its region and row together, never one
/// of them alone.
test "a region-first head applied to a count between its spellings is refused" {
  let src = "fn f(h: TaskHandle[Int, String]) -> Int {\n  0\n}\n"
  inspect(collect_all_diagnostics(src), "[write `TaskHandle[T]`, or `TaskHandle[rg, e, T]` with its region and row written out: `TaskHandle` takes 1 type argument besides its region and row, but 2 were given in parameter `h`]")
}

/// `TaskGroup` holds no payload past its region and row.
test "a TaskGroup applied to one argument is refused" {
  let src = "fn f(g: TaskGroup[Int]) -> Int {\n  0\n}\n"
  inspect(collect_all_diagnostics(src), "[write `TaskGroup`, or `TaskGroup[rg, e]` with its region and row written out: `TaskGroup` takes no type arguments besides its region and row, but 1 was given in parameter `g`]")
}

/// A region-last head takes its payload and then, optionally, its region.
test "a region-last head applied to too many arguments is refused" {
  let src = "fn f(l: MutList[Int, String, Bool]) -> Int {\n  0\n}\n"
  inspect(collect_all_diagnostics(src), "[write `MutList[T]`, or `MutList[T, r]` with its region written out: `MutList` takes 1 type argument besides its region, but 3 were given in parameter `l`]")
}

/// `MutBytes` holds no payload: bare, or with its region.
test "a MutBytes applied to two arguments is refused" {
  let src = "fn f(b: MutBytes[Int, String]) -> Int {\n  0\n}\n"
  inspect(collect_all_diagnostics(src), "[write `MutBytes`, or `MutBytes[r]` with its region written out: `MutBytes` takes no type arguments besides its region, but 2 were given in parameter `b`]")
}

/// Every legal applied spelling of the compiler-owned heads: the complete
/// one, and for a head with region (and row) slots the one that leaves
/// exactly those to the call.
test "the legal applied spellings of compiler-owned heads are accepted" {
  let src = "fn f(a: Future[Int], b: Task[Int], c: ArrayBuilder[Int], d: FrozenArray[Int], e: FixedArray[Int], m: MapBuilder[String, Int], t: Attempt[Int, String]) -> Int {\n  0\n}\n\nfn g(h: TaskHandle[Int], s: Sender[Int], r: Receiver[Int], l: MutList[Int], g: TaskGroup, b: MutBytes) -> Int {\n  0\n}\n\nfn full[rg, e](h: TaskHandle[rg, e, Int], s: Sender[rg, e, Int], r: Receiver[rg, e, Int], g: TaskGroup[rg, e]) -> Int {\n  0\n}\n\nfn region_last(l: MutList[Int, r], b: MutBytes[r]) -> Int with r {\n  0\n}\n"
  inspect(collect_all_diagnostics(src), "[]")
}

/// #3551 review: a program struct spelled like the shipped `TaskGroup[rg, e]`
/// was read as the compiler's own declaration, so a bare `TaskGroup` left both
/// formals unbound and `g.first` was accepted as a `String`. It is refused
/// where it is declared.
test "a program struct spelled like a shipped region-first head is refused" {
  let src = "struct TaskGroup[rg, e] {\n  first: rg;\n  second: e\n}\n\nfn as_str(g: TaskGroup) -> String {\n  g.first\n}\n"
  inspect(collect_all_diagnostics_for_path("main.vibe", src), "[rename this struct or its type parameters `rg` and `e`: `TaskGroup[rg, e]` is spelled like `@vibe/concurrent`'s own `TaskGroup`, whose region and row a call supplies, so a `TaskGroup` written without them would leave this struct's `rg` and `e` unbound and its fields readable at any type, line 7:5-10: write `TaskGroup[rg, e]` with its region and row to reach `first` (`fn f[rg, e](x: TaskGroup[rg, e])`), or use `TaskGroup`'s functions instead: a `TaskGroup` written without them leaves the field's type unbound here, so `first` could be read or written at any type]")
}

/// The applied spelling of a program `TaskHandle[rg, e, T]`.
test "a program TaskHandle spelled like the shipped one is refused" {
  let src = "struct TaskHandle[rg, e, T] {\n  tag: rg;\n  v: T\n}\n\nfn tag_of(h: TaskHandle[Int]) -> String {\n  h.tag\n}\n"
  inspect(collect_all_diagnostics_for_path("main.vibe", src), "[rename this struct or its type parameters `rg` and `e`: `TaskHandle[rg, e, T]` is spelled like `@vibe/concurrent`'s own `TaskHandle`, whose region and row a call supplies, so a `TaskHandle` written without them would leave this struct's `rg` and `e` unbound and its fields readable at any type, line 7:5-8: write `TaskHandle[rg, e, T]` with its region and row to reach `tag` (`fn f[rg, e, T](x: TaskHandle[rg, e, T])`), or use `TaskHandle`'s functions instead: a `TaskHandle` written without them leaves the field's type unbound here, so `tag` could be read or written at any type]")
}

/// The module that ships the declaration may write it.
test "the shipped module may declare the region-first shape" {
  let src = "export struct TaskGroup[rg, e] {\n  w: (rg) -> rg\n}\n"
  inspect(collect_all_diagnostics_for_path("lib/@vibe/concurrent/experimental/concurrent.vibe", src), "[]")
}

/// A path is the shipped module only by its whole package-relative tail.
test "a path that only ends like the shipped module's is refused" {
  let src = "export struct TaskGroup[rg, e] {\n  w: (rg) -> rg\n}\n"
  inspect(collect_all_diagnostics_for_path("lib/my@vibe/concurrent/experimental/concurrent.vibe", src), "[rename this struct or its type parameters `rg` and `e`: `TaskGroup[rg, e]` is spelled like `@vibe/concurrent`'s own `TaskGroup`, whose region and row a call supplies, so a `TaskGroup` written without them would leave this struct's `rg` and `e` unbound and its fields readable at any type]")
}

/// A program struct of the name with other formals is its own, held to them.
test "a program struct of a region-first name with other formals is held to them" {
  let src = "struct TaskGroup[A, B] {\n  first: A;\n  second: B\n}\n\nfn as_str(g: TaskGroup) -> String {\n  g.first\n}\n\nfn first_of(g: TaskGroup[Int, String]) -> Int {\n  g.first\n}\n"
  inspect(collect_all_diagnostics_for_path("main.vibe", src), "[write `TaskGroup[T, U]` with the type arguments it holds: `TaskGroup` takes 2 type arguments, but none were given in parameter `g`]")
}

/// #3551 review: a path that ends like the shipped module's is not the shipped
/// module. A program's relative import names its target by any path it likes
/// (`./@vibe/concurrent/experimental/concurrent.vibe` from a project root, or
/// under another directory), and each was read as the compiler's own
/// declaration, so `g.first` was accepted as a `String`.
test "a program module whose path only ends like the shipped one is refused" {
  let src = "export struct TaskGroup[rg, e] {\n  first: rg;\n  second: e\n}\n\nfn as_str(g: TaskGroup) -> String {\n  g.first\n}\n"
  let answers: Array[String] = []
  for path in [
    "@vibe/concurrent/experimental/concurrent.vibe",
    "vendor/@vibe/concurrent/experimental/concurrent.vibe",
    "app/lib/@vibe/concurrent/experimental/concurrent.vibe",
    "/tmp/p/@vibe/concurrent/experimental/concurrent.vibe"
  ] {
    let got = collect_all_diagnostics_for_path(path, src)
    // #3572: the field read through the bare spelling is refused as well.
    let verdict = if Array::length(got) >= 1 && String::starts_with(Array::get(got, 0), "rename this struct or its type parameters `rg` and `e`: `TaskGroup[rg, e]`") {
      "refused"
    } else {
      "\{got}"
    }
    Array::push(answers, "\{path}: \{verdict}")
  }
  inspect(String::join(answers, "\n"), "@vibe/concurrent/experimental/concurrent.vibe: refused\nvendor/@vibe/concurrent/experimental/concurrent.vibe: refused\napp/lib/@vibe/concurrent/experimental/concurrent.vibe: refused\n/tmp/p/@vibe/concurrent/experimental/concurrent.vibe: refused")
}

/// The workspace's package locations are the shipped module, however the path
/// that names one is spelled.
test "the workspace package locations of the shipped module may declare the shape" {
  let src = "export struct TaskGroup[rg, e] {\n  w: (rg) -> rg\n}\n"
  let answers: Array[String] = []
  for path in [
    "./lib/@vibe/concurrent/experimental/concurrent.vibe",
    ".vibe/store/@vibe/concurrent/experimental/concurrent.vibe",
    "lib/@vibe/concurrent/experimental/../experimental/concurrent.vibe"
  ] {
    Array::push(answers, "\{path}: \{collect_all_diagnostics_for_path(path, src)}")
  }
  inspect(String::join(answers, "\n"), "./lib/@vibe/concurrent/experimental/concurrent.vibe: []\n.vibe/store/@vibe/concurrent/experimental/concurrent.vibe: []\nlib/@vibe/concurrent/experimental/../experimental/concurrent.vibe: []")
}
