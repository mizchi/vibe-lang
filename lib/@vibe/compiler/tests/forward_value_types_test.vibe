  let message = forward_value_error("struct LocalHelper { greet: (String) -> Int }\nfn early() -> String { helper.greet(\"x\") }\nlet helper = LocalHelper::{ greet: (name) -> 5 }\nfn main() -> Int { String::length(early()) }\n")
