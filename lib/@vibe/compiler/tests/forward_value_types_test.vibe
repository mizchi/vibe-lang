test "#3493: polymorphic-alias-ok" {
  let message = forward_value_error("let identity = (x) -> x\nfn use_int() -> Int { alias(7) }\nfn use_string() -> String { alias(\"ok\") }\nlet alias = identity\nfn main() -> Int { use_int() + String::length(use_string()) }\n")
  inspect(message, content = "")
}

test "#3493: recursive-group-polymorphism-ok" {
  let message = forward_value_error("let (identity, apply) = ((x) -> x, (x) -> identity(x))\nfn int_value() -> Int { apply(7) }\nfn string_value() -> String { apply(\"ok\") }\n")
  inspect(message, content = "")
}

test "#3493: self-recursive-function-ok" {
  let message = forward_value_error("let rec size = (n) -> { if n == 0 { 0 } else { size(n - 1) + 1 } }\nfn main() -> Int { size(3) }\n")
  inspect(message, content = "")
}

test "#3493: struct-destructure-wrong" {
  let message = forward_value_error("struct Helper { n: Int }\nstruct Wrap { helper: Helper }\nfn early() -> String { helper.n }\nlet Wrap::{ helper } = Wrap::{ helper: Helper::{ n: 5 } }\n")
  inspect(String::length(message) > 0, content = "true")
}

test "#3493: transitive-call-ok" {
  let message = forward_value_error("struct Helper { n: Int }\nfn early() -> Int { alias.n }\nlet alias = make()\nlet make = () -> original\nlet original = Helper::{ n: 5 }\n")
  inspect(message, content = "")
}

test "#3493: transitive-call-wrong" {
  let message = forward_value_error("struct Helper { n: Int }\nfn early() -> String { alias.n }\nlet alias = make()\nlet make = () -> original\nlet original = Helper::{ n: 5 }\n")
  inspect(String::length(message) > 0, content = "true")
