test "#3493: own-initializer-ok" {
  let message = forward_value_error("struct LocalHelper { greet: (String) -> Int }\nstruct Later { eval: () -> Int }\nlet (helper, later) = (LocalHelper::{ greet: (name) -> 5 }, Later::{ eval: () -> { helper.greet(\"x\") } })\nfn main() -> Int { later.eval() }\n")
  inspect(message, content = "")
}

test "#3493: own-initializer-wrong" {
  let message = forward_value_error("struct LocalHelper { greet: (String) -> Int }\nstruct Later { eval: () -> String }\nlet (helper, later) = (LocalHelper::{ greet: (name) -> 5 }, Later::{ eval: () -> { helper.greet(\"x\") } })\nfn main() -> Int { String::length(later.eval()) }\n")
  inspect(String::length(message) > 0, content = "true")
}

test "#3493: own-struct-destructure-ok" {
  let message = forward_value_error("struct Helper { n: Int }\nstruct Wrap { helper: Helper; eval: () -> Int }\nlet Wrap::{ helper, eval } = Wrap::{ helper: Helper::{ n: 5 }, eval: () -> helper.n }\n")
  inspect(message, content = "")
}

test "#3493: own-struct-destructure-wrong" {
  let message = forward_value_error("struct Helper { n: Int }\nstruct Wrap { helper: Helper; eval: () -> String }\nlet Wrap::{ helper, eval } = Wrap::{ helper: Helper::{ n: 5 }, eval: () -> helper.n }\n")
