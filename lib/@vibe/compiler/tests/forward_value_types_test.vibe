// #3493: forward values are checked using inferred declaration types.
import @vibe/compiler/checker {
  check_program, check_program_statement_root_type_observation, check_program_type_table, local_let_types
}
import @vibe/compiler/checker/artifacts {
  checked_statement_root_type_observation_row_count,
  checked_statement_root_type_observation_statement_path_at,
  checked_statement_root_type_observation_type_at
}

import @vibe/compiler/core {
  Stmt
}
import @vibe/compiler/syntax {
  lex, lex_with_offsets, parse_program, parse_program_located
}

fn forward_value_error(source: String) -> String with Exception {
  // Parser failures must fail the test, never count as a checker refusal.
  let stmts = parse_program(lex(source))
  handle {
    let _ = check_program(stmts)
    ""
  } with { Exception::Throw(msg) => msg }
}

test "#3493: array-element-wrong" {
  let message = forward_value_error("fn early() -> String { Array::get(xs, 0) }\nlet xs = [1, 2]\nfn main() -> Int { String::length(early()) }\n")
  inspect(String::length(message) > 0, content = "true")
}

test "#3493: builtin-arg-wrong" {
  let message = forward_value_error("struct LocalHelper { greet: (String) -> Int }\nfn early() -> Int { String::length(helper.greet(\"x\")) }\nlet helper = LocalHelper::{ greet: (name) -> 5 }\nfn main() -> Int { early() }\n")
  inspect(String::length(message) > 0, content = "true")
}

test "#3493: call-result-wrong" {
  let message = forward_value_error("struct LocalHelper { greet: (String) -> Int }\nfn make_helper() -> LocalHelper { LocalHelper::{ greet: (name) -> 5 } }\nfn early() -> String { helper.greet(\"x\") }\nlet helper = make_helper()\nfn main() -> Int { String::length(early()) }\n")
  inspect(String::length(message) > 0, content = "true")
}

test "#3493: declared-let-wrong" {
  let message = forward_value_error("struct LocalHelper { greet: (String) -> Int }\nfn early() -> String { helper.greet(\"x\") }\nlet helper: LocalHelper = LocalHelper::{ greet: (name) -> 5 }\nfn main() -> Int { String::length(early()) }\n")
  inspect(String::length(message) > 0, content = "true")
}

test "#3493: destructuring-ok" {
  let message = forward_value_error("struct LocalHelper { greet: (String) -> Int }\nfn early() -> Int { helper.greet(\"x\") }\nlet (helper, n) = (LocalHelper::{ greet: (name) -> 5 }, 3)\nfn main() -> Int { early() + n }\n")
  inspect(message, content = "")
}

test "#3493: destructuring-wrong" {
  let message = forward_value_error("struct LocalHelper { greet: (String) -> Int }\nfn early() -> String { helper.greet(\"x\") }\nlet (helper, n) = (LocalHelper::{ greet: (name) -> 5 }, 3)\nfn main() -> Int { String::length(early()) }\n")
  inspect(String::length(message) > 0, content = "true")
}

