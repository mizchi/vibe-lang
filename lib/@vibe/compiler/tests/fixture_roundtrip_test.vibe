//# Imports

import ./fixture_test_support.vibe {
  roundtrip_ok
}

import @vibe/compiler/syntax {
  Token, lex, parse_program_preserving, print_program
}

//# Functions

fn _token_anchor(t: Token) -> Token {
  t
}

/// fn-PRESERVING pretty-print (ADR-0064 #727): parse keeping SFnDecl, then
/// print — mirrors normalize's pipeline so tests can assert the fn form
/// survives. Errors surface as an "ERROR: " prefix like roundtrip_ok's pp.
fn pp_preserving(src: String) -> String {
  handle {
    print_program(parse_program_preserving(lex(src)))
  } with Error {
    Throw(msg) => String::concat("ERROR: ", msg)
  }
}

//# Misc

test "fixture_01_roundtrip" {
  let src = "let dead: () -> Int = () -> { 0 }\nimport ./dep.vibe { dep }\ntrait Eq\nimpl Eq for Int\ntype Alias = Int\nlet helper: () -> Int = () -> { 1 }\nexport let run: () -> Int = () -> { helper() }\nexport let run_io: () -> Int with {Error} = () -> { run() }\nexport { run, run_io }"
  assert(roundtrip_ok(src))
}

test "fixture_02_roundtrip" {
  let src = "let helper: () -> Int = () -> { 1 + 2 }\nlet value = helper()\nexport let run: () -> Int = () -> { value }\nexport { run }"
  assert(roundtrip_ok(src))
}

test "fixture_03_roundtrip" {
  // #728 removed `module { ... }` blocks; see fixture_test.vibe's
  // fixture_03_parse for the same flattening rationale.
  let src = "let dead: () -> Int = () -> { 0 }\nlet helper: () -> Int = () -> { 1 }\ntype Alias = Int\nexport let run: () -> Int = () -> { helper() }\nexport let run_io: () -> Int with {Error} = () -> { run() }\nexport { run, run_io }"
  assert(roundtrip_ok(src))
}

test "fixture_04_roundtrip" {
  let src = "let answer = 40 + 2\nlet id: (Int) -> Int = (x) -> { x }\nexport let run: () -> Int = () -> { answer }\nexport let keep: () -> Int = () -> { id(1) }\nexport { run, keep }"
  assert(roundtrip_ok(src))
}

test "fixture_05_roundtrip" {
  // 0.3.0 redundant-syntax removal: declaration members are ';'-separated;
  // ',' is a parse error (reject coverage: fixture_test.vibe
  // fixture_05_decl_comma_rejected).
  let src = "export struct Pair {\nleft: Int;\nright: Int\n}\nexport enum Choice {\nA;\nB(Int)\n}\nexport { Pair, Choice }"
  assert(roundtrip_ok(src))
}

test "fixture_06_roundtrip" {
  let src = "let sum: (x~: Int, y~: Int) -> Int = (x~, y~) -> { x + y }\nexport let run: () -> Int = () -> { sum(x~=1, y?=2) }\nexport { run }"
  assert(roundtrip_ok(src))
}

/// ADR-0064 (#727/#731): `fn` declarations — including where-contracts —
/// must round-trip in fn form (parse -> print -> parse is stable and keeps
/// the declaration shape instead of rewriting to `let rec` + inline asserts).
test "fixture_fn_roundtrip" {
  let src = "fn add(x: Int, y: Int) -> Int { x + y }\nexport fn run() -> Int { add(40, 2) }\nexport { run }"
  assert(roundtrip_ok(src))
}

test "fixture_fn_where_roundtrip" {
  let src = "fn checked_add(x: Int, y: Int) -> Int where { requires: x >= 0, requires: y >= 0, ensures: result >= x } { x + y }\nexport fn run() -> Int { checked_add(40, 2) }\nexport { run }"
  assert(roundtrip_ok(src))
}

test "fixture_fn_where_keeps_fn_form" {
  let src = "fn checked_add(x: Int, y: Int) -> Int with { Error } where { requires: x >= 0, ensures: result >= x } { x + y }\nexport { checked_add }"
  let printed = pp_preserving(src)
  assert(String::contains(printed, "fn checked_add"))
  assert(String::contains(printed, "where { requires:"))
  assert(String::contains(printed, "ensures:"))
  assert(String::contains(printed, "with Error"))
  assert(not(String::contains(printed, "let rec checked_add")))
}
