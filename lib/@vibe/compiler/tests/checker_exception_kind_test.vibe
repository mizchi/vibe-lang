//# Imports

// ADR-0085 Phase 3 (#1344): `throw(v)` requires `Exception[typeof(v)]` in the
// enclosing row, and `Exception[E1]` neither authorizes nor discharges
// `Exception[E2]`. `Error` / `Exception` stay the ERASED spelling, compatible
// with every kind in both directions -- which is what keeps every pre-#1344
// row and diagnostic unchanged. End-to-end locks through
// collect_all_diagnostics.
import @vibe/compiler/runtime {
  collect_all_diagnostics
}

import @vibe/compiler/checker {
  set_error_row_checked
}

import @vibe/compiler/core {
  canonical_exception_effect_name,
  exception_effect_kind,
  exception_effect_labels_equal,
  exception_kinds_compatible,
  exception_label_kind,
  exception_throw_label_for_kind,
  is_exception_effect_name,
  is_exception_label,
  is_exception_throw_operation
}

//# Misc

/// The checked-`Error` row discipline is a process-wide switch that
/// `cli_main` turns on (#944, ADR-0073 stage B). This harness calls the
/// checker directly, so without flipping it here every `throw` site is exempt
/// from the row check and each assertion below would pass vacuously.
fn checked_diags(src: String) -> Array[String] with Error {
  set_error_row_checked(true)
  collect_all_diagnostics(src)
}

// --- label grammar (core/exception_effect.vibe)

test "exception_effect_kind reads the bracketed kind, and only for Exception" {
  assert(eq(exception_effect_kind("Exception[IoError]"), "IoError"))
  assert(eq(exception_effect_kind("Exception[Array[Int]]"), "Array[Int]"))
  assert(eq(exception_effect_kind("Exception"), ""))
  assert(eq(exception_effect_kind("Error"), ""))
  // `Error` stays the bracketless erased spelling: a bracket on it is not a
  // kinded exception label at all.
  assert(eq(exception_effect_kind("Error[IoError]"), ""))
  assert(eq(exception_effect_kind("State[Int]"), ""))
  // An unterminated bracket group is not a label.
  assert(eq(exception_effect_kind("Exception[IoError"), ""))
  // An EMPTY kind is not a kind.
  assert(eq(exception_effect_kind("Exception[]"), ""))
}

test "is_exception_effect_name accepts both erased spellings and kinded ones" {
  assert(is_exception_effect_name("Error"))
  assert(is_exception_effect_name("Exception"))
  assert(is_exception_effect_name("Exception[IoError]"))
  assert(!is_exception_effect_name("Fs"))
  assert(!is_exception_effect_name("State[Int]"))
}

test "canonical_exception_effect_name collapses erased spellings but never a kind" {
  assert(eq(canonical_exception_effect_name("Exception"), "Error"))
  assert(eq(canonical_exception_effect_name("Error"), "Error"))
  // Collapsing this would erase exactly what the row check compares.
  assert(eq(canonical_exception_effect_name("Exception[IoError]"), "Exception[IoError]"))
  assert(eq(canonical_exception_effect_name("Fs"), "Fs"))
}

test "throw operations are recognized in every spelling (one Wasm tag)" {
  assert(is_exception_throw_operation("Error::Throw"))
  assert(is_exception_throw_operation("Exception::Throw"))
  assert(is_exception_throw_operation("Exception[IoError]::Throw"))
  assert(!is_exception_throw_operation("Error::Other"))
  assert(!is_exception_throw_operation("Fs::Throw"))
}

test "exception_label_kind works on both the effect and operation forms" {
  assert(eq(exception_label_kind("Exception[IoError]"), "IoError"))
  assert(eq(exception_label_kind("Exception[IoError]::Throw"), "IoError"))
  assert(eq(exception_label_kind("Error::Throw"), ""))
  assert(is_exception_label("Error::Throw"))
  assert(is_exception_label("Exception[IoError]"))
  assert(!is_exception_label("Fs::read_file"))
}

test "erased kinds are compatible in both directions, distinct kinds are not" {
  assert(exception_kinds_compatible("", "IoError"))
  assert(exception_kinds_compatible("IoError", ""))
  assert(exception_kinds_compatible("IoError", "IoError"))
  assert(!exception_kinds_compatible("IoError", "ParseError"))
  assert(exception_effect_labels_equal("Error", "Exception[IoError]"))
  assert(!exception_effect_labels_equal("Exception[IoError]", "Exception[ParseError]"))
}

test "the throw label for a kind is the bare, writable row spelling" {
  // Not `Exception[IoError]::Throw`: the row grammar accepts `Eff::Op` and
  // `Eff[T]` but not `Eff[T]::Op`, so the fix-it must name the effect.
  assert(eq(exception_throw_label_for_kind("IoError"), "Exception[IoError]"))
  assert(eq(exception_throw_label_for_kind(""), "Error::Throw"))
}

// --- rows end to end

test "a matching Exception[E] row authorizes the throw" {
  let src = "enum IoError {\n  NotFound(String)\n}\n\nlet boom = () -> Int with { Exception[IoError] } {\n  throw(NotFound(\"x\"))\n}\n\nlet main = () -> Int {\n  handle {\n    boom()\n  } with Error {\n    Throw(_e) => 42\n  }\n}\n"
  assert(eq(Array::length(checked_diags(src)), 0))
}

test "a DIFFERENT Exception[E] row rejects the throw" {
  let src = "enum IoError {\n  NotFound(String)\n}\n\nenum ParseError {\n  Eof\n}\n\nlet boom = () -> Int with { Exception[ParseError] } {\n  throw(NotFound(\"x\"))\n}\n\nlet main = () -> Int {\n  handle {\n    boom()\n  } with Error {\n    Throw(_e) => 42\n  }\n}\n"
  let diags = checked_diags(src)
  assert(eq(Array::length(diags), 1))
  assert(String::contains(Array::get(diags, 0), "missing { Exception[IoError] }"))
}

test "the payload kind of a string literal is String" {
  let ok = "let boom = () -> Int with { Exception[String] } {\n  throw(\"plain\")\n}\n\nlet main = () -> Int {\n  handle {\n    boom()\n  } with Error {\n    Throw(_e) => 42\n  }\n}\n"
  assert(eq(Array::length(checked_diags(ok)), 0))
  let bad = "enum IoError {\n  NotFound(String)\n}\n\nlet boom = () -> Int with { Exception[IoError] } {\n  throw(\"plain\")\n}\n\nlet main = () -> Int {\n  handle {\n    boom()\n  } with Error {\n    Throw(_e) => 42\n  }\n}\n"
  let diags = checked_diags(bad)
  assert(eq(Array::length(diags), 1))
  assert(String::contains(Array::get(diags, 0), "missing { Exception[String] }"))
}

test "the erased Error row still authorizes a suberror throw (#786 unchanged)" {
  let src = "enum IoError {\n  NotFound(String)\n}\n\nlet boom = () -> Int with { Error } {\n  throw(NotFound(\"x\"))\n}\n\nlet main = () -> Int {\n  handle {\n    boom()\n  } with Error {\n    Throw(_e) => 42\n  }\n}\n"
  assert(eq(Array::length(checked_diags(src)), 0))
}

test "a row naming no exception label keeps the pinned Error::Throw diagnostic" {
  let src = "let boom = () -> Int with { Stdout } {\n  throw(\"x\")\n}\n\nlet main = () -> Int with { Stdout } {\n  handle {\n    boom()\n  } with Error {\n    Throw(_e) => 42\n  }\n}\n"
  let diags = checked_diags(src)
  assert(eq(Array::length(diags), 1))
  assert(String::contains(Array::get(diags, 0), "missing { Error::Throw }"))
}

test "an effectset union of exception kinds authorizes both" {
  let src = "enum IoError {\n  NotFound(String)\n}\n\nenum ParseError {\n  Eof\n}\n\neffectset ConfigExc = {\n  Exception[IoError],\n  Exception[ParseError]\n}\n\nlet boom = (b: Bool) -> Int with { ConfigExc } {\n  if b {\n    throw(NotFound(\"x\"))\n  } else {\n    throw(Eof)\n  }\n}\n\nlet main = () -> Int {\n  handle {\n    boom(true)\n  } with Error {\n    Throw(_e) => 42\n  }\n}\n"
  assert(eq(Array::length(checked_diags(src)), 0))
}

test "handle with Exception[E] discharges that kind only" {
  let ok = "enum IoError {\n  NotFound(String)\n}\n\nlet main = () -> Int {\n  handle {\n    throw(NotFound(\"x\"))\n  } with Exception[IoError] {\n    Throw(_e) => 42\n  }\n}\n"
  assert(eq(Array::length(checked_diags(ok)), 0))
  let bad = "enum IoError {\n  NotFound(String)\n}\n\nenum ParseError {\n  Eof\n}\n\nlet boom = () -> Int {\n  handle {\n    throw(NotFound(\"x\"))\n  } with Exception[ParseError] {\n    Throw(_e) => 42\n  }\n}\n\nlet main = () -> Int {\n  boom()\n}\n"
  let diags = checked_diags(bad)
  assert(eq(Array::length(diags), 1))
  assert(String::contains(Array::get(diags, 0), "missing { Exception[IoError] }"))
}

test "a kinded exception row cannot be laundered through a mismatched fn slot" {
  let src = "enum IoError {\n  NotFound(String)\n}\n\nenum ParseError {\n  Eof\n}\n\nlet boom = () -> Int with { Exception[IoError] } {\n  throw(NotFound(\"x\"))\n}\n\nlet take = (f: () -> Int with { Exception[ParseError] }) -> Int with { Exception[ParseError] } {\n  f()\n}\n\nlet main = () -> Int {\n  handle {\n    take(boom)\n  } with Error {\n    Throw(_e) => 42\n  }\n}\n"
  let diags = checked_diags(src)
  assert(eq(Array::length(diags), 1))
  assert(String::contains(Array::get(diags, 0), "effect would be dropped"))
}

test "an erased slot still accepts a kinded value (and the reverse)" {
  let into_erased = "enum IoError {\n  NotFound(String)\n}\n\nlet boom = () -> Int with { Exception[IoError] } {\n  throw(NotFound(\"x\"))\n}\n\nlet take = (f: () -> Int with { Error }) -> Int with { Error } {\n  f()\n}\n\nlet main = () -> Int {\n  handle {\n    take(boom)\n  } with Error {\n    Throw(_e) => 42\n  }\n}\n"
  assert(eq(Array::length(checked_diags(into_erased)), 0))
  let into_kinded = "enum IoError {\n  NotFound(String)\n}\n\nlet boom = () -> Int with { Error } {\n  throw(NotFound(\"x\"))\n}\n\nlet take = (f: () -> Int with { Exception[IoError] }) -> Int with { Exception[IoError] } {\n  f()\n}\n\nlet main = () -> Int {\n  handle {\n    take(boom)\n  } with Error {\n    Throw(_e) => 42\n  }\n}\n"
  assert(eq(Array::length(checked_diags(into_kinded)), 0))
}

test "an unresolved payload kind is authorized by any exception row (gradual)" {
  // A payload this pass cannot classify -- here a pattern binder, whose type
  // lives only in the inference substitution -- has no kind, and is compatible
  // with every declared exception label rather than an invented error.
  let src = "enum IoError {\n  NotFound(String)\n}\n\nenum ParseError {\n  Eof\n}\n\nlet boom = (r: IoError) -> Int with { Exception[ParseError] } {\n  match r {\n    NotFound(m) => throw(m)\n  }\n}\n\nlet main = () -> Int {\n  handle {\n    boom(NotFound(\"x\"))\n  } with Error {\n    Throw(_e) => 42\n  }\n}\n"
  assert(eq(Array::length(checked_diags(src)), 0))
}

// --- local binders (#1344 follow-up)
//
// The payload-kind scope threaded through the perform walk. Before it, every
// one of these throws fell back to the erased `Error::Throw`, which any
// exception row authorizes -- so the kind check was silently off for exactly
// the shape #1324's migration produces (`let e = ..; Err(e)` becoming
// `let e = ..; throw(e)`).

test "a local binder's payload kind comes from its initializer" {
  let ok = "enum IoError {\n  NotFound(String)\n}\n\nlet boom = () -> Int with { Exception[IoError] } {\n  let e = NotFound(\"x\")\n  throw(e)\n}\n\nlet main = () -> Int {\n  handle {\n    boom()\n  } with Error {\n    Throw(_e) => 42\n  }\n}\n"
  assert(eq(Array::length(checked_diags(ok)), 0))
  let bad = "enum IoError {\n  NotFound(String)\n}\n\nenum ParseError {\n  Eof\n}\n\nlet boom = () -> Int with { Exception[ParseError] } {\n  let e = NotFound(\"x\")\n  throw(e)\n}\n\nlet main = () -> Int {\n  handle {\n    boom()\n  } with Error {\n    Throw(_e) => 42\n  }\n}\n"
  let diags = checked_diags(bad)
  assert(eq(Array::length(diags), 1))
  assert(String::contains(Array::get(diags, 0), "missing { Exception[IoError] }"))
}

test "a local binder resolves through the module table too" {
  // `let e = make_err(..)` -- the initializer is itself resolved by the same
  // rules, so the local inherits the callee's RESULT kind.
  let src = "enum IoError {\n  NotFound(String)\n}\n\nenum ParseError {\n  Eof\n}\n\nlet make_err = (m: String) -> IoError {\n  NotFound(m)\n}\n\nlet boom = () -> Int with { Exception[ParseError] } {\n  let e = make_err(\"x\")\n  throw(e)\n}\n\nlet main = () -> Int {\n  handle {\n    boom()\n  } with Error {\n    Throw(_e) => 42\n  }\n}\n"
  let diags = checked_diags(src)
  assert(eq(Array::length(diags), 1))
  assert(String::contains(Array::get(diags, 0), "missing { Exception[IoError] }"))
}

test "an annotated parameter's payload kind comes from its annotation" {
  let src = "enum IoError {\n  NotFound(String)\n}\n\nenum ParseError {\n  Eof\n}\n\nlet boom = (e: IoError) -> Int with { Exception[ParseError] } {\n  throw(e)\n}\n\nlet main = () -> Int {\n  handle {\n    boom(NotFound(\"x\"))\n  } with Error {\n    Throw(_e) => 42\n  }\n}\n"
  let diags = checked_diags(src)
  assert(eq(Array::length(diags), 1))
  assert(String::contains(Array::get(diags, 0), "missing { Exception[IoError] }"))
}

test "a mut local and a lambda parameter carry kinds the same way" {
  let mut_local = "enum IoError {\n  NotFound(String)\n}\n\nenum ParseError {\n  Eof\n}\n\nlet boom = () -> Int with { Exception[ParseError] } {\n  let mut e = NotFound(\"x\")\n  throw(e)\n}\n\nlet main = () -> Int {\n  handle {\n    boom()\n  } with Error {\n    Throw(_e) => 42\n  }\n}\n"
  let diags = checked_diags(mut_local)
  assert(eq(Array::length(diags), 1))
  assert(String::contains(Array::get(diags, 0), "missing { Exception[IoError] }"))
  let lam = "enum IoError {\n  NotFound(String)\n}\n\nenum ParseError {\n  Eof\n}\n\nlet boom = () -> Int with { Exception[ParseError] } {\n  let f = (e: IoError) -> Int {\n    throw(e)\n  }\n  f(NotFound(\"x\"))\n}\n\nlet main = () -> Int {\n  handle {\n    boom()\n  } with Error {\n    Throw(_e) => 42\n  }\n}\n"
  let lam_diags = checked_diags(lam)
  assert(eq(Array::length(lam_diags), 1))
  assert(String::contains(Array::get(lam_diags, 0), "missing { Exception[IoError] }"))
}

test "a local binding shadows a same-named top-level one" {
  // The reason an unresolvable binder is recorded EXPLICITLY as "" instead of
  // being left out: lookup falls back to the module table when a name is
  // absent, so an omitted local would let the top-level `e` answer here and
  // report `missing { Exception[IoError] }` for a throw of a String.
  let src = "enum IoError {\n  NotFound(String)\n}\n\nlet e = NotFound(\"top\")\n\nlet boom = () -> Int with { Exception[String] } {\n  let e = \"boom\"\n  throw(e)\n}\n\nlet main = () -> Int {\n  handle {\n    boom()\n  } with Error {\n    Throw(_x) => 42\n  }\n}\n"
  assert(eq(Array::length(checked_diags(src)), 0))
}

test "an applied local shadows a same-named top-level function" {
  // The scope records a local's VALUE kind, never its RESULT kind, so applying
  // one is unresolvable -- and must NOT fall through to the top-level
  // `make_err`, whose result kind is a different type entirely.
  let src = "enum IoError {\n  NotFound(String)\n}\n\nenum ParseError {\n  Eof\n}\n\nlet make_err = (m: String) -> IoError {\n  NotFound(m)\n}\n\nlet boom = () -> Int with { Exception[ParseError] } {\n  let make_err = (_m: String) -> ParseError {\n    Eof\n  }\n  throw(make_err(\"x\"))\n}\n\nlet main = () -> Int {\n  handle {\n    boom()\n  } with Error {\n    Throw(_e) => 42\n  }\n}\n"
  assert(eq(Array::length(checked_diags(src)), 0))
}

test "a for-loop binder shadows a same-named top-level binding" {
  let src = "enum IoError {\n  NotFound(String)\n}\n\nlet x = NotFound(\"top\")\n\nlet boom = (xs: Array[String]) -> Int with { Exception[ParseError] } {\n  for x in xs {\n    throw(x)\n  }\n  0\n}\n\nenum ParseError {\n  Eof\n}\n\nlet main = () -> Int {\n  handle {\n    boom([\n      \"a\"\n    ])\n  } with Error {\n    Throw(_e) => 42\n  }\n}\n"
  assert(eq(Array::length(checked_diags(src)), 0))
}

test "struct-literal and float payloads carry their own kinds" {
  let rec_bad = "struct Wrapped {\n  msg: String\n}\n\nlet boom = () -> Int with { Exception[String] } {\n  throw(Wrapped::{ msg: \"x\" })\n}\n\nlet main = () -> Int {\n  handle {\n    boom()\n  } with Error {\n    Throw(_e) => 42\n  }\n}\n"
  let rec_diags = checked_diags(rec_bad)
  assert(eq(Array::length(rec_diags), 1))
  assert(String::contains(Array::get(rec_diags, 0), "missing { Exception[Wrapped] }"))
  let float_bad = "let boom = () -> Int with { Exception[Int] } {\n  throw(1.5)\n}\n\nlet main = () -> Int {\n  handle {\n    boom()\n  } with Error {\n    Throw(_e) => 42\n  }\n}\n"
  let float_diags = checked_diags(float_bad)
  assert(eq(Array::length(float_diags), 1))
  assert(String::contains(Array::get(float_diags, 0), "missing { Exception[Double] }"))
}
