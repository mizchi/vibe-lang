import ./checker_parity_test_support.vibe {
  check_source_error_message, check_source_ok
}

// #2386: retaining_write_region_check asks whether the callee retains an
// argument before it asks the environment for the active region, and
// direct_call_return asks the builtin table before it walks the chain.
// Both are pure reorders; these pin the answers they must keep giving.

test "a container write that stores a region-capturing closure into an outer binding is still reported" {
  let src = "fn build() -> Int {\n  let sink: Array[() -> Int] = []\n  region r {\n    let cell = MutList::empty(r)\n    Array::push(sink, () -> Int {\n      MutList::length(cell)\n    })\n  }\n  0\n}"
  inspect(check_source_error_message(src), content = "region escapes its scope: a container write stores a value that captures this region into an outer binding")
}

test "the same write outside a region, and a non-retaining call inside one, are fine" {
  assert(check_source_ok("fn build() -> Int {\n  let sink: Array[Int] = []\n  Array::push(sink, 1)\n  Array::length(sink)\n}"))
  assert(check_source_ok("fn build() -> Int {\n  region r {\n    let cell = MutList::empty(r)\n    MutList::length(cell)\n  }\n}"))
}

test "a builtin's direct return type still answers, and a user fn of a builtin's name still shadows it" {
  assert(check_source_ok("fn f() -> Int {\n  let n: Int = String::length(\"abc\")\n  n\n}"))
  inspect(check_source_error_message("fn String::length(s: String) -> String {\n  s\n}\nfn f() -> Int {\n  let n: Int = String::length(\"abc\")\n  n\n}"), content = "binding type mismatch for a local let: expected Int, got String [@fn=n]")
}

test "an alias of an outer container taken inside a region still carries the outer-binding marker" {
  let src = "fn build() -> Int {\n  let sink: Array[() -> Int] = []\n  region r {\n    let cell = MutList::empty(r)\n    let alias = sink\n    Array::push(alias, () -> Int {\n      MutList::length(cell)\n    })\n  }\n  0\n}"
  inspect(check_source_error_message(src), content = "region escapes its scope: a container write stores a value that captures this region into an outer binding")
}

// #3360: a closure handed to an element-callback builtin is checked before
// its parameter is bound to the element type, so a write of that parameter
// into an outer binding saw a type variable and no region. The same write in
// `for c in cells` was refused; through the callback it compiled.
test "a callback that stores its element into an outer binding is reported" {
  let map_src = "fn build() -> Int {\n  let sink: Array[MutList[Int]] = []\n  region r {\n    let cells = [MutList::empty(r)]\n    let _ = Array::map(cells, (c) -> {\n      Array::push(sink, c)\n      0\n    })\n  }\n  0\n}"
  assert(String::contains(check_source_error_message(map_src), "region escapes its scope"))
  let filter_src = "fn build() -> Int {\n  let sink: Array[MutList[Int]] = []\n  region r {\n    let cells = [MutList::empty(r)]\n    let _ = Array::filter(cells, (c) -> {\n      Array::push(sink, c)\n      true\n    })\n  }\n  0\n}"
  assert(String::contains(check_source_error_message(filter_src), "region escapes its scope"))
  let fold_src = "fn build() -> Int {\n  let sink: Array[Option[MutList[Int]]] = []\n  region r {\n    let cells = [MutList::empty(r)]\n    let _ = Array::fold(cells, 0, (acc, c) -> {\n      Array::push(sink, Some(c))\n      acc\n    })\n  }\n  0\n}"
  assert(String::contains(check_source_error_message(fold_src), "region escapes its scope"))
}

test "a callback passed to a generic function stores its element into an outer binding is reported" {
  // The callee's own parameter type, `(T) -> Int` with `T` fixed by the array
  // argument, is what the call unified; the callback's variable was not.
  let src = "fn each_of[T](xs: Array[T], f: (T) -> Int) -> Int {\n  Array::length(Array::map(xs, f))\n}\n\nfn build() -> Int {\n  let sink: Array[MutList[Int]] = []\n  region r {\n    let cells = [MutList::empty(r)]\n    let _ = each_of(cells, (c) -> {\n      Array::push(sink, c)\n      0\n    })\n  }\n  0\n}"
  assert(String::contains(check_source_error_message(src), "region escapes its scope"))
}

test "a binding in one branch of a callback does not hide the outer target in another (Codex on #3437)" {
  let src = "fn build(flag: Bool) -> Int {\n  let sink: Array[MutList[Int]] = []\n  region r {\n    let cells = [MutList::empty(r)]\n    let _ = Array::map(cells, (c) -> {\n      if flag {\n        let sink = [c]\n        Array::length(sink)\n      } else {\n        Array::push(sink, c)\n        0\n      }\n    })\n  }\n  0\n}"
  assert(String::contains(check_source_error_message(src), "region escapes its scope"))
}

test "a callback that stores its element nested in aggregates is reported (Codex on #3437)" {
  let src = "fn build() -> Int {\n  let sink: Array[Option[(MutList[Int], Int)]] = []\n  region r {\n    let cells = [MutList::empty(r)]\n    let _ = Array::map(cells, (c) -> {\n      Array::push(sink, Some((c, 0)))\n      0\n    })\n  }\n  0\n}"
  assert(String::contains(check_source_error_message(src), "region escapes its scope"))
}

test "a callback that stores its element through an if or a block is reported (Codex on #3437)" {
  let src = "fn build(flag: Bool) -> Int {\n  let sink: Array[MutList[Int]] = []\n  region r {\n    let cells = [MutList::empty(r)]\n    let _ = Array::map(cells, (c) -> {\n      Array::push(sink, if flag {\n        c\n      } else {\n        c\n      })\n      0\n    })\n  }\n  0\n}"
  assert(String::contains(check_source_error_message(src), "region escapes its scope"))
}

test "a callback that stores an alias of its element is reported (Codex on #3437)" {
  let alias_src = "fn build() -> Int {\n  let sink: Array[MutList[Int]] = []\n  region r {\n    let cells = [MutList::empty(r)]\n    let _ = Array::map(cells, (c) -> {\n      let alias = c\n      Array::push(sink, alias)\n      0\n    })\n  }\n  0\n}"
  assert(String::contains(check_source_error_message(alias_src), "region escapes its scope"))
  let wrapped_src = "fn build() -> Int {\n  let sink: Array[Option[MutList[Int]]] = []\n  region r {\n    let cells = [MutList::empty(r)]\n    let _ = Array::map(cells, (c) -> {\n      let w = Some(c)\n      Array::push(sink, w)\n      0\n    })\n  }\n  0\n}"
  assert(String::contains(check_source_error_message(wrapped_src), "region escapes its scope"))
  // An alias that shadows an earlier binder of its spelling (Codex on #3447).
  let shadow_src = "fn build(flag: Bool) -> Int {\n  let sink: Array[MutList[Int]] = []\n  region r {\n    let cells = [MutList::empty(r)]\n    let _ = Array::map(cells, (c) -> {\n      let alias = 0\n      if flag {\n        alias\n      } else {\n        let alias = c\n        Array::push(sink, alias)\n        0\n      }\n    })\n  }\n  0\n}"
  assert(String::contains(check_source_error_message(shadow_src), "region escapes its scope"))
  // An alias that reuses the parameter's own spelling (Codex on #3447).
  let self_src = "fn build() -> Int {\n  let sink: Array[MutList[Int]] = []\n  region r {\n    let cells = [MutList::empty(r)]\n    let _ = Array::map(cells, (c) -> {\n      let c = c\n      Array::push(sink, c)\n      0\n    })\n  }\n  0\n}"
  assert(String::contains(check_source_error_message(self_src), "region escapes its scope"))
  // An initializer that holds the parameter through a mutable binding
  // (Codex on #3447).
  let mut_src = "fn build() -> Int {\n  let sink: Array[MutList[Int]] = []\n  region r {\n    let cells = [MutList::empty(r)]\n    let _ = Array::map(cells, (c) -> {\n      let outer = {\n        let mut alias = c\n        alias\n      }\n      Array::push(sink, outer)\n      0\n    })\n  }\n  0\n}"
  assert(String::contains(check_source_error_message(mut_src), "region escapes its scope"))
  // A mutable alias the parameter reaches through an assignment (Codex on
  // #3452).
  let assigned_src = "fn build() -> Int {\n  let sink: Array[MutList[Int]] = []\n  region r {\n    let cells = [MutList::empty(r)]\n    let _ = Array::map(cells, (c) -> {\n      let outer = {\n        let mut alias = c\n        alias = c\n        alias\n      }\n      Array::push(sink, outer)\n      0\n    })\n  }\n  0\n}"
  assert(String::contains(check_source_error_message(assigned_src), "region escapes its scope"))
  let late_src = "fn build() -> Int {\n  let sink: Array[Option[MutList[Int]]] = []\n  region r {\n    let cells = [MutList::empty(r)]\n    let _ = Array::map(cells, (c) -> {\n      let outer = {\n        let mut alias = None\n        alias = Some(c)\n        alias\n      }\n      Array::push(sink, outer)\n      0\n    })\n  }\n  0\n}"
  assert(String::contains(check_source_error_message(late_src), "region escapes its scope"))
}

test "a mutable alias assigned the element in a branch, or written itself, is reported (Codex on #3452)" {
  // The assignment sits in a branch before the block returns the binding.
  let branch = "fn build() -> Int {\n  let sink: Array[Option[MutList[Int]]] = []\n  region r {\n    let cells = [MutList::empty(r)]\n    let _ = Array::map(cells, (c) -> {\n      let outer = {\n        let mut alias = None\n        if MutList::length(c) > 0 {\n          alias = Some(c)\n        } else {\n          ()\n        }\n        alias\n      }\n      Array::push(sink, outer)\n      0\n    })\n  }\n  0\n}"
  assert(String::contains(check_source_error_message(branch), "region escapes its scope"))
  // The assigned value rebinds the parameter's own spelling first.
  let rebound = "fn build() -> Int {\n  let sink: Array[MutList[Int]] = []\n  region r {\n    let cells = [MutList::empty(r)]\n    let _ = Array::map(cells, (c) -> {\n      let mut alias = Array::get(sink, 0)\n      alias = {\n        let c = c\n        c\n      }\n      Array::push(sink, alias)\n      0\n    })\n  }\n  0\n}"
  assert(String::contains(check_source_error_message(rebound), "region escapes its scope"))
  // Only the assignment holds the element: the initializer is read from the
  // outer container, so it does not carry the region on its own.
  let assigned = "fn build() -> Int {\n  let sink: Array[MutList[Int]] = []\n  region r {\n    let cells = [MutList::empty(r)]\n    let _ = Array::map(cells, (c) -> {\n      let mut alias = Array::get(sink, 0)\n      alias = c\n      Array::push(sink, alias)\n      0\n    })\n  }\n  0\n}"
  assert(String::contains(check_source_error_message(assigned), "region escapes its scope"))
}

test "a callback that stores its element in a map literal is reported (Codex on #3437)" {
  let src = "fn build() -> Int {\n  let sink: Array[Map[String, MutList[Int]]] = []\n  region r {\n    let cells = [MutList::empty(r)]\n    let _ = Array::map(cells, (c) -> {\n      Array::push(sink, Map::from_pairs([(\"k\", c)]))\n      0\n    })\n  }\n  0\n}"
  assert(String::contains(check_source_error_message(src), "region escapes its scope"))
}

test "a callback that keeps its element in its own binding, or stores a value read from it, is fine" {
  assert(check_source_ok("fn build() -> Int {\n  region r {\n    let cells = [MutList::empty(r)]\n    let _ = Array::map(cells, (c) -> {\n      let mine = [c]\n      Array::push(mine, c)\n      0\n    })\n  }\n  0\n}"))
  assert(check_source_ok("fn build() -> Int {\n  let sink: Array[Int] = []\n  region r {\n    let cells = [MutList::empty(r)]\n    let _ = Array::map(cells, (c) -> {\n      Array::push(sink, MutList::length(c))\n      0\n    })\n  }\n  Array::length(sink)\n}"))
  // An inner binding of the same spelling that is assigned the element does
  // not make the outer one hold it (Codex on #3452).
  assert(check_source_ok("fn build() -> Int {\n  let sink: Array[MutList[Int]] = []\n  region r {\n    let cells = [MutList::empty(r)]\n    let _ = Array::map(cells, (c) -> {\n      let mut alias = Array::get(sink, 0)\n      let n = {\n        let mut alias = c\n        alias = c\n        MutList::length(alias)\n      }\n      Array::push(sink, alias)\n      n\n    })\n  }\n  0\n}"))
  // An alias kept in the callback's own array stays inside it.
  assert(check_source_ok("fn build() -> Int {\n  region r {\n    let cells = [MutList::empty(r)]\n    let _ = Array::map(cells, (c) -> {\n      let alias = c\n      let mine = [alias]\n      Array::length(mine)\n    })\n  }\n  0\n}"))
}

// #3360: a callback bound by `let` and passed by its name is the literal it
// binds. The recheck read only a literal written at the call, so
// `let stash = (c) -> { Array::push(sink, c); 0 }; Array::map(cells, stash)`
// compiled where the same literal at the call was refused.
test "a callback passed by the name a let binds it to is rechecked" {
  let named_src = "fn build() -> Int {\n  let sink: Array[MutList[Int]] = []\n  region r {\n    let cells = [MutList::empty(r)]\n    let stash = (c) -> {\n      Array::push(sink, c)\n      0\n    }\n    let _ = Array::map(cells, stash)\n  }\n  0\n}"
  assert(String::contains(check_source_error_message(named_src), "region escapes its scope"))
  let generic_src = "fn each_of[T](xs: Array[T], f: (T) -> Int) -> Int {\n  Array::length(Array::map(xs, f))\n}\n\nfn build() -> Int {\n  let sink: Array[MutList[Int]] = []\n  region r {\n    let cells = [MutList::empty(r)]\n    let stash = (c) -> {\n      Array::push(sink, c)\n      0\n    }\n    let _ = each_of(cells, stash)\n  }\n  0\n}"
  assert(String::contains(check_source_error_message(generic_src), "region escapes its scope"))
  // Bound before the region opens.
  let outside_src = "fn build() -> Int {\n  let sink: Array[MutList[Int]] = []\n  let stash = (c) -> {\n    Array::push(sink, c)\n    0\n  }\n  region r {\n    let cells = [MutList::empty(r)]\n    let _ = Array::map(cells, stash)\n  }\n  0\n}"
  assert(String::contains(check_source_error_message(outside_src), "region escapes its scope"))
}

test "a named callback that keeps its element in its own binding is fine" {
  assert(check_source_ok("fn build() -> Int {\n  region r {\n    let cells = [MutList::empty(r)]\n    let keep = (c) -> {\n      let mine = [c]\n      Array::length(mine)\n    }\n    let _ = Array::map(cells, keep)\n  }\n  0\n}"))
}

// Codex on #3461: a callback held in a `let mut` is refused with the edit at a
// region-carrying slot, since which closure reaches the call is not known; a
// named callback's body is read where it was written, so a binding the call
// site shadows is not taken for the one the body captured.
test "a mutable or shadowed named callback does not pass the recheck" {
  let mut_src = "fn build() -> Int {\n  let sink: Array[MutList[Int]] = []\n  region r {\n    let cells = [MutList::empty(r)]\n    let mut stash = (c) -> {\n      Array::push(sink, c)\n      0\n    }\n    let _ = Array::map(cells, stash)\n  }\n  0\n}"
  assert(String::contains(check_source_error_message(mut_src), "cannot be checked here"))
  let alias_src = "fn build() -> Int {\n  let sink: Array[MutList[Int]] = []\n  region r {\n    let cells = [MutList::empty(r)]\n    let stash = (c) -> {\n      Array::push(sink, c)\n      0\n    }\n    let mut again = stash\n    let _ = Array::map(cells, again)\n  }\n  0\n}"
  assert(String::contains(check_source_error_message(alias_src), "cannot be checked here"))
  let shadow_src = "fn build() -> Int {\n  let sink: Array[MutList[Int]] = []\n  let stash = (c) -> {\n    Array::push(sink, c)\n    0\n  }\n  region r {\n    let cells = [MutList::empty(r)]\n    let sink: Array[MutList[Int]] = []\n    let _ = Array::map(cells, stash)\n    let _ = Array::length(sink)\n  }\n  0\n}"
  assert(String::contains(check_source_error_message(shadow_src), "region escapes its scope"))
}

test "a let mut callback over region-free values, and a region-local named write, are fine" {
  assert(check_source_ok("fn build() -> Int {\n  let sink: Array[Int] = []\n  let mut add = (n) -> {\n    Array::push(sink, n)\n    0\n  }\n  region r {\n    let _ = Array::map([1, 2], add)\n  }\n  Array::length(sink)\n}"))
  assert(check_source_ok("fn build() -> Int {\n  region r {\n    let cells = [MutList::empty(r)]\n    let local: Array[MutList[Int]] = []\n    let keep = (c) -> {\n      Array::push(local, c)\n      0\n    }\n    let _ = Array::map(cells, keep)\n    Array::length(local)\n  }\n}"))
}

// Codex on #3461: an immutable alias of a `let mut` callback is still
// untraced, and a module-level `let` closure is rechecked like a local one.
test "an alias of a mutable callback, and a module-level closure, do not pass the recheck" {
  let alias_of_mut = "fn build() -> Int {\n  let sink: Array[MutList[Int]] = []\n  region r {\n    let cells = [MutList::empty(r)]\n    let mut stash = (c) -> {\n      Array::push(sink, c)\n      0\n    }\n    let again = stash\n    let _ = Array::map(cells, again)\n  }\n  0\n}"
  assert(String::contains(check_source_error_message(alias_of_mut), "cannot be checked here"))
  let top_src = "let outer: Array[MutList[Int]] = []\nlet stash = (c) -> {\n  Array::push(outer, c)\n  0\n}\nfn build() -> Int {\n  region r {\n    let cells = [MutList::empty(r)]\n    let _ = Array::map(cells, stash)\n  }\n  0\n}"
  assert(String::contains(check_source_error_message(top_src), "region escapes its scope"))
}

// Codex on #3461: a module-level name the markers cannot trace is refused like
// a local one -- the end of a chain longer than the resolver follows, or a
// closure a call produced. A short chain to a closure that keeps its element
// still resolves and compiles.
test "an untraced module-level callback does not pass the recheck" {
  let chain_src = "let outer: Array[MutList[Int]] = []\nlet a0 = (c) -> {\n  Array::push(outer, c)\n  0\n}\nlet a1 = a0\nlet a2 = a1\nlet a3 = a2\nlet a4 = a3\nlet a5 = a4\nlet a6 = a5\nlet a7 = a6\nlet a8 = a7\nlet a9 = a8\nfn build() -> Int {\n  region r {\n    let cells = [MutList::empty(r)]\n    let _ = Array::map(cells, a9)\n  }\n  0\n}"
  assert(String::contains(check_source_error_message(chain_src), "cannot be checked here"))
  let made_src = "let outer: Array[MutList[Int]] = []\nfn make() -> (MutList[Int]) -> Int {\n  (c) -> {\n    Array::push(outer, c)\n    0\n  }\n}\nlet made = make()\nfn build() -> Int {\n  region r {\n    let cells = [MutList::empty(r)]\n    let _ = Array::map(cells, made)\n  }\n  0\n}"
  assert(String::contains(check_source_error_message(made_src), "cannot be checked here"))
  assert(check_source_ok("let a0 = (c) -> {\n  let mine = [c]\n  Array::length(mine)\n}\nlet a1 = a0\nlet a2 = a1\nfn build() -> Int {\n  region r {\n    let cells = [MutList::empty(r)]\n    let _ = Array::map(cells, a2)\n  }\n  0\n}"))
}
