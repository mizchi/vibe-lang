import ./checker_parity_test_support.vibe {
  check_source_error_message, check_source_ok
}

// #2386: retaining_write_region_check asks whether the callee retains an
// argument before it asks the environment for the active region, and
// direct_call_return asks the builtin table before it walks the chain.
// Both are pure reorders; these pin the answers they must keep giving.

test "a container write that stores a region-capturing closure into an outer binding is still reported" {
  let src = "fn build() -> Int {\n  let sink: Array[() -> Int] = []\n  region r {\n    let cell = MutList::empty(r)\n    Array::push(sink, () -> Int {\n      MutList::length(cell)\n    })\n  }\n  0\n}"
  inspect(check_source_error_message(src), content = "region escapes its scope: a container write stores a value that captures this region into an outer binding")
}

test "the same write outside a region, and a non-retaining call inside one, are fine" {
  assert(check_source_ok("fn build() -> Int {\n  let sink: Array[Int] = []\n  Array::push(sink, 1)\n  Array::length(sink)\n}"))
  assert(check_source_ok("fn build() -> Int {\n  region r {\n    let cell = MutList::empty(r)\n    MutList::length(cell)\n  }\n}"))
}

test "a builtin's direct return type still answers, and a user fn of a builtin's name still shadows it" {
  assert(check_source_ok("fn f() -> Int {\n  let n: Int = String::length(\"abc\")\n  n\n}"))
  inspect(check_source_error_message("fn String::length(s: String) -> String {\n  s\n}\nfn f() -> Int {\n  let n: Int = String::length(\"abc\")\n  n\n}"), content = "binding type mismatch for a local let: expected Int, got String [@fn=n]")
}

test "an alias of an outer container taken inside a region still carries the outer-binding marker" {
  let src = "fn build() -> Int {\n  let sink: Array[() -> Int] = []\n  region r {\n    let cell = MutList::empty(r)\n    let alias = sink\n    Array::push(alias, () -> Int {\n      MutList::length(cell)\n    })\n  }\n  0\n}"
  inspect(check_source_error_message(src), content = "region escapes its scope: a container write stores a value that captures this region into an outer binding")
}

// #3360: a closure handed to an element-callback builtin is checked before
// its parameter is bound to the element type, so a write of that parameter
// into an outer binding saw a type variable and no region. The same write in
// `for c in cells` was refused; through the callback it compiled.
test "a callback that stores its element into an outer binding is reported" {
  let map_src = "fn build() -> Int {\n  let sink: Array[MutList[Int]] = []\n  region r {\n    let cells = [MutList::empty(r)]\n    let _ = Array::map(cells, (c) -> {\n      Array::push(sink, c)\n      0\n    })\n  }\n  0\n}"
  assert(String::contains(check_source_error_message(map_src), "region escapes its scope"))
  let filter_src = "fn build() -> Int {\n  let sink: Array[MutList[Int]] = []\n  region r {\n    let cells = [MutList::empty(r)]\n    let _ = Array::filter(cells, (c) -> {\n      Array::push(sink, c)\n      true\n    })\n  }\n  0\n}"
  assert(String::contains(check_source_error_message(filter_src), "region escapes its scope"))
  let fold_src = "fn build() -> Int {\n  let sink: Array[Option[MutList[Int]]] = []\n  region r {\n    let cells = [MutList::empty(r)]\n    let _ = Array::fold(cells, 0, (acc, c) -> {\n      Array::push(sink, Some(c))\n      acc\n    })\n  }\n  0\n}"
  assert(String::contains(check_source_error_message(fold_src), "region escapes its scope"))
}

test "a callback passed to a generic function stores its element into an outer binding is reported" {
  // The callee's own parameter type, `(T) -> Int` with `T` fixed by the array
  // argument, is what the call unified; the callback's variable was not.
  let src = "fn each_of[T](xs: Array[T], f: (T) -> Int) -> Int {\n  Array::length(Array::map(xs, f))\n}\n\nfn build() -> Int {\n  let sink: Array[MutList[Int]] = []\n  region r {\n    let cells = [MutList::empty(r)]\n    let _ = each_of(cells, (c) -> {\n      Array::push(sink, c)\n      0\n    })\n  }\n  0\n}"
  assert(String::contains(check_source_error_message(src), "region escapes its scope"))
}

test "a binding in one branch of a callback does not hide the outer target in another (Codex on #3437)" {
  let src = "fn build(flag: Bool) -> Int {\n  let sink: Array[MutList[Int]] = []\n  region r {\n    let cells = [MutList::empty(r)]\n    let _ = Array::map(cells, (c) -> {\n      if flag {\n        let sink = [c]\n        Array::length(sink)\n      } else {\n        Array::push(sink, c)\n        0\n      }\n    })\n  }\n  0\n}"
  assert(String::contains(check_source_error_message(src), "region escapes its scope"))
}

test "a callback that stores its element nested in aggregates is reported (Codex on #3437)" {
  let src = "fn build() -> Int {\n  let sink: Array[Option[(MutList[Int], Int)]] = []\n  region r {\n    let cells = [MutList::empty(r)]\n    let _ = Array::map(cells, (c) -> {\n      Array::push(sink, Some((c, 0)))\n      0\n    })\n  }\n  0\n}"
  assert(String::contains(check_source_error_message(src), "region escapes its scope"))
}

test "a callback that keeps its element in its own binding, or stores a value read from it, is fine" {
  assert(check_source_ok("fn build() -> Int {\n  region r {\n    let cells = [MutList::empty(r)]\n    let _ = Array::map(cells, (c) -> {\n      let mine = [c]\n      Array::push(mine, c)\n      0\n    })\n  }\n  0\n}"))
  assert(check_source_ok("fn build() -> Int {\n  let sink: Array[Int] = []\n  region r {\n    let cells = [MutList::empty(r)]\n    let _ = Array::map(cells, (c) -> {\n      Array::push(sink, MutList::length(c))\n      0\n    })\n  }\n  Array::length(sink)\n}"))
}
