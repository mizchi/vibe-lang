import @vibe/compiler/core {
  Expr, Pat, Stmt, TypeEnv, TypeExpr
}
import @vibe/core {
  array_empty
}
import @vibe/compiler/checker/effects {
  afe_collect_callable_bodies,
  afe_expr_head_name,
  afe_handler_arm_locals,
  afe_no_locals,
  check_async_effects_expr,
  check_async_effects_stmt,
  check_async_effects_stmts
}

fn helper_body(_ head: String) -> Expr {
  EFn(array_empty(), array_empty(), array_empty(), Some(TyName("Unit")), Some("Carry"), ECall(EIdent("perform", -1), [
    ECall(EIdent("Carry::Yield", -1), [
      ERecord(head, array_empty(), array_empty())
    ], -1, [])
  ], -1, []))
}

fn helper(name: String, head: String) -> Stmt {
  SLet(false, false, name, None, helper_body(head))
}

// Exercise the actual callable lookup through handler-payload inference,
// rather than a second implementation of its name/ambiguity rules.
fn payload_head(_ name: String) -> Option[String] {
  let call = ECall(EIdent(name, -1), array_empty(), -1, [])
  let locals = afe_handler_arm_locals(body = call, pat = PCtor("Carry::Yield", [
    PBind("it")
  ]), env = EnvEmpty, locals = afe_no_locals())
  afe_expr_head_name(e = EIdent("it", -1), env = EnvEmpty, locals = locals)
}

fn begin(_ stmts: Array[Stmt]) -> Unit {
  let _ = check_async_effects_stmts(stmts = stmts, env = EnvEmpty)
  ()
}

test "callable payload lookup retains unique names and rejects missing names" {
  begin([
    helper(name = "emit", head = "Left"),
    helper(name = "other", head = "Right")
  ])
  assert(payload_head("emit") is Some("Left"))
  assert(payload_head("other") is Some("Right"))
  assert(payload_head("missing") is None)
}

test "duplicate callable names remain ambiguous in either order" {
  begin([
    helper(name = "emit", head = "Left"),
    helper(name = "emit", head = "Right")
  ])
  assert(payload_head("emit") is None)
  begin([
    helper(name = "emit", head = "Right"),
    helper(name = "emit", head = "Left")
  ])
  assert(payload_head("emit") is None)
  begin([
    helper(name = "emit", head = "Left"),
    helper(name = "emit", head = "Left")
  ])
  assert(payload_head("emit") is None)
}

test "nested modules and function declarations participate in callable ambiguity" {
  begin([SModule(false, "Nested", [helper(name = "emit", head = "Left")])])
  assert(payload_head("emit") is Some("Left"))
  afe_collect_callable_bodies([
    SFnDecl(false, "emit", helper_body("Right"), array_empty(), array_empty())
  ])
  assert(payload_head("emit") is None)
}

test "collecting additional bodies updates positive and missing lookups" {
  begin([helper(name = "emit", head = "Left")])
  assert(payload_head("emit") is Some("Left"))
  assert(payload_head("added") is None)
  afe_collect_callable_bodies([
    helper(name = "added", head = "Right"),
    helper(name = "emit", head = "Left")
  ])
  assert(payload_head("added") is Some("Right"))
  assert(payload_head("emit") is None)
}

test "program entries reset callable names and prior ambiguity" {
  begin([
    helper(name = "emit", head = "Left"),
    helper(name = "emit", head = "Right")
  ])
  assert(payload_head("emit") is None)
  begin([helper(name = "emit", head = "Right")])
  assert(payload_head("emit") is Some("Right"))
  begin([])
  assert(payload_head("emit") is None)
  begin([helper(name = "emit", head = "Left")])
  assert(payload_head("emit") is Some("Left"))
}

test "expression and statement entries clear the preceding program bodies" {
  begin([helper(name = "emit", head = "Left")])
  assert(payload_head("emit") is Some("Left"))
  let _ = check_async_effects_expr(expr = EInt(0), env = EnvEmpty, in_async = false)
  assert(payload_head("emit") is None)
  begin([helper(name = "emit", head = "Right")])
  assert(payload_head("emit") is Some("Right"))
  let _ = check_async_effects_stmt(stmt = SExpr(EInt(0)), env = EnvEmpty)
  assert(payload_head("emit") is None)
}
