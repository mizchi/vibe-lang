//# Imports

import @vibe/compiler/core {
  Expr, Pat, Stmt, Subst, Type, TypeDef, TypeEnv, TypeExpr, env_lookup, subst_apply, type_to_string, types_equal
}

import @vibe/core {
  array_empty
}

import @vibe/compiler/checker {
  check_program, check_stmts
}

//# Functions

let _no_tp = array_empty()

let _no_tb = array_empty()

let _no_methods: Array[(String, Array[TypeExpr], TypeExpr)] = ArrayBuilder::freeze(ArrayBuilder::new())

let _no_method_gens: Array[(String, Array[String], Array[(String, Array[String])])] = ArrayBuilder::freeze(ArrayBuilder::new())

//# Misc

test "infer identity fn" {
  let stmts = [
    SLet(false, false, "f", None, EFn(_no_tp, _no_tb, [("x", None)], None, None, EIdent("x", -1)))
  ]
  let env = check_program(stmts)
  match env_lookup(env, "f") {
    Some(t) => match t {
      CtForAll(vars, _, body) => {
        assert(eq(Array::length(vars), 1))
        match body {
          CtFn(_, _, _) => assert(true),
          _ => assert(false)
        }
      },
      _ => assert(false)
    },
    None => assert(false)
  }
}

test "infer from usage" {
  let body = EBinOp("+", EIdent("x", -1), EInt(1))
  let stmts = [
    SLet(false, false, "f", None, EFn(_no_tp, _no_tb, [("x", None)], None, None, body))
  ]
  let env = check_program(stmts)
  match env_lookup(env, "f") {
    Some(t) => match t {
      CtForAll(_, _, inner) => match inner {
        CtFn(_, ret, _) => assert(types_equal(ret, CtInt)),
        _ => assert(false)
      },
      CtFn(_, ret, _) => assert(types_equal(ret, CtInt)),
      _ => assert(false)
    },
    None => assert(false)
  }
}

test "infer unary minus defaults param to int" {
  let stmts = [
    SLet(false, false, "f", None, EFn(_no_tp, _no_tb, [("x", None)], None, None, EUnaryOp("-", EIdent("x", -1))))
  ]
  let env = check_program(stmts)
  match env_lookup(env, "f") {
    Some(t) => match t {
      CtFn(params, ret, _) => {
        assert(eq(Array::length(params), 1))
        assert(types_equal(Array::get(params, 0), CtInt))
        assert(types_equal(ret, CtInt))
      },
      _ => assert(false)
    },
    None => assert(false)
  }
}

test "infer call site" {
  let stmts = [
    SLet(false, false, "f", None, EFn(_no_tp, _no_tb, [
      ("x", Some(TyName("Int")))
    ], None, None, EIdent("x", -1))),
    SLet(false, false, "result", None, ECall(EIdent("f", -1), [EInt(42)], -1))
  ]
  let env = check_program(stmts)
  match env_lookup(env, "result") {
    Some(t) => assert(types_equal(t, CtInt)),
    None => assert(false)
  }
}

test "let type propagation" {
  let stmts = [
    SLet(false, false, "x", None, EInt(42)),
    SLet(false, false, "y", None, EIdent("x", -1))
  ]
  let env = check_program(stmts)
  match env_lookup(env, "y") {
    Some(t) => assert(types_equal(t, CtInt)),
    None => assert(false)
  }
}

test "let polymorphism" {
  // let id = (x) -> x; let a = id(42); let b = id("hello")
  // a should be Int, b should be String
  let id_fn = EFn(_no_tp, _no_tb, [("x", None)], None, None, EIdent("x", -1))
  let stmts = [
    SLet(false, false, "id", None, id_fn),
    SLet(false, false, "a", None, ECall(EIdent("id", -1), [EInt(42)], -1)),
    SLet(false, false, "b", None, ECall(EIdent("id", -1), [EString("hello")], -1))
  ]
  let env = check_program(stmts)
  match env_lookup(env, "a") {
    Some(t) => assert(types_equal(t, CtInt)),
    None => assert(false)
  }
  match env_lookup(env, "b") {
    Some(t) => assert(types_equal(t, CtString)),
    None => assert(false)
  }
}

test "trait bound basic" {
  // trait T; impl T for Int; let f: [A: T](A) -> A = (x) -> { x }; f(42) => Int
  let f_fn = EFn(["A"], [("A", ["T"])], [("x", Some(TyName("A")))], None, None, EIdent("x", -1))
  let stmts = [
    STrait(false, "T", _no_tp, _no_methods, _no_method_gens, _no_tp),
    SImpl(_no_tp, _no_tb, "T", "Int"),
    SLet(false, false, "f", None, f_fn),
    SLet(false, false, "result", None, ECall(EIdent("f", -1), [EInt(42)], -1))
  ]
  let env = check_program(stmts)
  match env_lookup(env, "result") {
    Some(t) => assert(types_equal(t, CtInt)),
    None => assert(false)
  }
}

test "trait registered in env" {
  // trait Show; impl Show for Int
  let stmts = [
    STrait(false, "Show", _no_tp, _no_methods, _no_method_gens, _no_tp),
    SImpl(_no_tp, _no_tb, "Show", "Int")
  ]
  let env = check_program(stmts)
  // The env should contain trait definitions — check it's not just EnvEmpty
  match env {
    EnvEmpty => assert(false),
    _ => assert(true)
  }
}

test "supertrait registered" {
  // trait A; trait B: A; impl B for Int
  let stmts = [
    STrait(false, "A", _no_tp, _no_methods, _no_method_gens, _no_tp),
    STrait(false, "B", ["A"], _no_methods, _no_method_gens, _no_tp),
    SImpl(_no_tp, _no_tb, "B", "Int")
  ]
  let env = check_program(stmts)
  match env {
    EnvEmpty => assert(false),
    _ => assert(true)
  }
}

test "overlap impl detected" {
  // Two impls of the same trait for the same type
  // trait T; impl T for Int; impl T for Int (should still compile, overlap just recorded)
  let stmts = [
    STrait(false, "T", _no_tp, _no_methods, _no_method_gens, _no_tp),
    SImpl(_no_tp, _no_tb, "T", "Int"),
    SImpl(_no_tp, _no_tb, "T", "Int")
  ]
  let env = check_program(stmts)
  match env {
    EnvEmpty => assert(false),
    _ => assert(true)
  }
}
