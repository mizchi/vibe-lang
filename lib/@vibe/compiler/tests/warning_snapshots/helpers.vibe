import @vibe/compiler/syntax {
  lex, parse_program
}
import ../../checker_warning.vibe {
  check_warnings
}
import @vibe/compiler/runtime {
  collect_all_diagnostics
}

// Scope analysis takes statements directly. It preserves the unused-binding
// checks from the former warning fixtures without claiming that the CLI emits
// these optional analysis results. CLI diagnostics are tested separately below.
export fn scope_warnings(source: String) -> String with Exception {
  let warnings = check_warnings(parse_program(lex(source)))
  let messages: Array[String] = []
  for warning in warnings {
    let (_, _, message) = warning
    Array::push(messages, message)
  }
  String::join(messages, "\n")
}

export fn diagnostics(source: String) -> String with Exception {
  String::join(collect_all_diagnostics(source), "\n")
}
