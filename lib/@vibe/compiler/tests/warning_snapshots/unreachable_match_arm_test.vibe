import ./helpers.vibe {
  diagnostics
}

// The current diagnostic API accepts this match. Also check its observable
// behavior so retiring the old warning text cannot discard the ordering claim.
test "catch all wins over a later matching arm" {
  inspect(diagnostics("fn main() -> String {\n  let x = 1\n  match x {\n    1 => \"one\",\n    _ => \"other\",\n    2 => \"two\"\n  }\n}"), "")
  let x = 2
  inspect(match x {
    1 => "one",
    _ => "other",
    2 => "two"
  }, "other")
}
