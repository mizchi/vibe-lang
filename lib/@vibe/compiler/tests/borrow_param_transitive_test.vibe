import @vibe/compiler/core {
  Expr, Stmt
}

import @vibe/compiler/codegen/common_analysis {
  borrow_fixpoint_link_parts, compute_borrow_disqualifiers, compute_borrow_param_user_fns, md_consume_count_pre
}

fn one_param_fn(name: String, param: String, body: Expr) -> Stmt {
  SLet(false, false, name, None, EFn([], [], [(param, None)], None, None, body))
}

fn mask_for(names: Array[String], masks: Array[Int], name: String) -> Int {
  let mut i = 0
  let mut found = 0
  while i < Array::length(names) {
    if Array::get(names, i) == name {
      found = Array::get(masks, i)
    } else {
      ()
    }
    i = i + 1
  }
  found
}

test "one transitive wrapper layer inherits a borrowed parameter" {
  let leaf = one_param_fn("leaf", "xs", ECall(EIdent("Array::length", -1), [
    EIdent("xs", -1)
  ], -1))
  let wrapper = one_param_fn("wrapper", "xs", ECall(EIdent("leaf", -1), [
    EIdent("xs", -1)
  ], -1))
  let masks: Array[Int] = []
  let names = compute_borrow_param_user_fns([leaf, wrapper], [], masks)
  assert_eq(mask_for(names, masks, "leaf"), 1)
  assert_eq(mask_for(names, masks, "wrapper"), 1)
}

test "direct recursion borrows a shared read-only argument" {
  let xs = EIdent("xs", -1)
  let walk = one_param_fn("walk", "xs", EIf(EBool(true), ECall(EIdent("Array::length", -1), [
    xs
  ], -1), ECall(EIdent("walk", -1), [xs], -1)))
  let masks: Array[Int] = []
  let names = compute_borrow_param_user_fns([walk], [], masks)
  inspect(mask_for(names, masks, "walk"), content = "1")
}

test "an owned argument propagates through recursive parameter permutations" {
  let body = EIf(EBool(true), EIdent("a", -1), ECall(EIdent("rotate", -1), [
    EIdent("b", -1),
    EIdent("c", -1),
    EIdent("a", -1)
  ], -1))
  let rotate = SLet(false, false, "rotate", None, EFn([], [], [
    ("a", None),
    ("b", None),
    ("c", None)
  ], None, None, body))
  let masks: Array[Int] = []
  let names = compute_borrow_param_user_fns([rotate], [], masks)
  inspect(mask_for(names, masks, "rotate"), content = "0")
}

test "a local binding named like the recursive function keeps its owned ABI" {
  let local = EFn([], [], [("x", None)], None, None, EIdent("x", -1))
  let walk = one_param_fn("walk", "xs", ELet("walk", local, ECall(EIdent("walk", -1), [
    EIdent("xs", -1)
  ], -1), -1))
  let masks: Array[Int] = []
  let names = compute_borrow_param_user_fns([walk], [], masks)
  inspect(mask_for(names, masks, "walk"), content = "0")
}

test "recursive borrowing keeps indirect calls and host entries owned" {
  let walk = one_param_fn("walk", "xs", ECall(EIdent("walk", -1), [
    EIdent("xs", -1)
  ], -1))
  let valued = SLet(false, false, "alias", None, EIdent("walk", -1))
  let masks: Array[Int] = []
  let names = compute_borrow_param_user_fns([walk, valued], [], masks)
  inspect(mask_for(names, masks, "walk"), content = "0")
  let host_masks: Array[Int] = []
  let host_names = compute_borrow_param_user_fns([walk], ["walk"], host_masks)
  inspect(mask_for(host_names, host_masks, "walk"), content = "0")
}

fn linked_masks(parts: Array[Array[Stmt]], masks: Array[Int]) -> Array[String] {
  let valued: Array[String] = []
  let nonident_fns: Array[String] = []
  let nonident_pos: Array[Int] = []
  let mut i = 0
  while i < Array::length(parts) {
    compute_borrow_disqualifiers(Array::get(parts, i), valued, nonident_fns, nonident_pos)
    i = i + 1
  }
  borrow_fixpoint_link_parts(parts, valued, nonident_fns, nonident_pos, [], masks)
}

test "recursive borrowing sees linked callees and global disqualifiers" {
  let leaf = one_param_fn("leaf", "xs", ECall(EIdent("Array::length", -1), [
    EIdent("xs", -1)
  ], -1))
  let walk = one_param_fn("walk", "xs", EIf(EBool(true), ECall(EIdent("leaf", -1), [
    EIdent("xs", -1)
  ], -1), ECall(EIdent("walk", -1), [EIdent("xs", -1)], -1)))
  let whole_masks: Array[Int] = []
  let whole_names = compute_borrow_param_user_fns([leaf, walk], [], whole_masks)
  let part_masks: Array[Int] = []
  let part_names = linked_masks([[walk], [leaf]], part_masks)
  inspect(mask_for(whole_names, whole_masks, "walk"), content = "1")
  inspect(mask_for(part_names, part_masks, "walk"), content = "1")
  let swap = SLet(false, false, "swap", None, EFn([], [], [
    ("a", None),
    ("b", None)
  ], None, None, EIf(EBool(true), EUnit, ECall(EIdent("swap", -1), [
    EIdent("b", -1),
    EIdent("a", -1)
  ], -1))))
  let caller = one_param_fn("caller", "xs", ECall(EIdent("swap", -1), [
    EArray([]),
    EIdent("xs", -1)
  ], -1))
  let wm: Array[Int] = []
  let wn = compute_borrow_param_user_fns([swap, caller], [], wm)
  let lm: Array[Int] = []
  let ln = linked_masks([[swap], [caller]], lm)
  inspect(mask_for(wn, wm, "swap"), content = "0")
  inspect(mask_for(ln, lm, "swap"), content = "0")
}

test "recursive borrowing keeps captured parameters owned" {
  let capture = EFn([], [], [], None, None, ECall(EIdent("Array::length", -1), [
    EIdent("xs", -1)
  ], -1))
  let walk = one_param_fn("walk", "xs", ESeq(capture, ECall(EIdent("walk", -1), [
    EIdent("xs", -1)
  ], -1)))
  let masks: Array[Int] = []
  let names = compute_borrow_param_user_fns([walk], [], masks)
  inspect(mask_for(names, masks, "walk"), content = "0")
}

test "recursive inference respects a global alias shadowing a builtin accessor" {
  let identity = one_param_fn("identity", "value", EIdent("value", -1))
  let alias = SLet(false, false, "Map::iter_get", None, EIdent("identity", -1))
  let xs = EIdent("xs", -1)
  let walk = one_param_fn("walk", "xs", EIf(EBool(true), ECall(EIdent("Map::iter_get", -1), [
    xs
  ], -1), ECall(EIdent("walk", -1), [xs], -1)))
  let masks: Array[Int] = []
  let names = compute_borrow_param_user_fns([identity, alias, walk], [], masks)
  inspect(mask_for(names, masks, "walk"), content = "0")
  let lm: Array[Int] = []
  let ln = linked_masks([[walk], [identity, alias]], lm)
  inspect(mask_for(ln, lm, "walk"), content = "0")
}

test "a function parameter may shadow the recursive callee" {
  let spellings = ["walk", "walk~", "walk?"]
  let results: Array[Int] = []
  let mut i = 0
  while i < Array::length(spellings) {
    let walk = SLet(false, false, "walk", None, EFn([], [], [
      ("xs", None),
      (Array::get(spellings, i), None)
    ], None, None, ECall(EIdent("walk", -1), [EIdent("xs", -1)], -1)))
    let masks: Array[Int] = []
    let names = compute_borrow_param_user_fns([walk], [], masks)
    Array::push(results, mask_for(names, masks, "walk")&1)
    i = i + 1
  }
  inspect(results, content = "[0, 0, 0]")
}

test "a local callee shadow does not inherit the top-level borrow ABI" {
  let reader = one_param_fn("reader", "xs", ECall(EIdent("Array::length", -1), [
    EIdent("xs", -1)
  ], -1))
  let local_reader = EFn([], [], [("value", None)], None, None, EIdent("value", -1))
  let shadowed = one_param_fn("shadowed", "xs", ELet("reader", local_reader, ECall(EIdent("reader", -1), [
    EIdent("xs", -1)
  ], -1), -1))
  let masks: Array[Int] = []
  let names = compute_borrow_param_user_fns([reader, shadowed], [], masks)
  assert_eq(mask_for(names, masks, "reader"), 1)
  assert_eq(mask_for(names, masks, "shadowed"), 0)
}

test "#2379 review: a source-owned Map accessor overrides the builtin borrow seed" {
  let checked = one_param_fn("Map::iter_get", "m", EIdent("m", -1))
  let unchecked = one_param_fn("Map::__iter_get_unchecked", "m", EIdent("m", -1))
  let masks: Array[Int] = []
  let names = compute_borrow_param_user_fns([checked, unchecked], [], masks)
  assert_eq(mask_for(names, masks, "Map::iter_get"), 0)
  assert_eq(mask_for(names, masks, "Map::__iter_get_unchecked"), 0)
  assert_eq(Array::length(names), 2)
  let checked_call = ECall(EIdent("Map::iter_get", -1), [EIdent("m", -1)], -1)
  let unchecked_call = ECall(EIdent("Map::__iter_get_unchecked", -1), [
    EIdent("m", -1)
  ], -1)
  assert_eq(md_consume_count_pre(checked_call, "m", names, masks), 1)
  assert_eq(md_consume_count_pre(unchecked_call, "m", names, masks), 1)
}

test "#3128: a source definition of any borrowing builtin keeps a zero-mask row" {
  // `Array::truncate` / `Array::length` / `String::join` borrow arg0 and
  // `Bytes::compare` borrows both operands as builtins. A source definition
  // that consumes them must be recorded, or md_borrow_mask_of falls back to
  // the builtin mask and every call site hands over a borrow the body drops.
  let truncate = one_param_fn("Array::truncate", "xs", EIdent("xs", -1))
  let length = one_param_fn("Array::length", "xs", EIdent("xs", -1))
  let join = one_param_fn("String::join", "xs", EIdent("xs", -1))
  let compare = SLet(false, false, "Bytes::compare", None, EFn([], [], [
    ("a", None),
    ("b", None)
  ], None, None, ETuple([EIdent("a", -1), EIdent("b", -1)])))
  let plain = one_param_fn("plain", "xs", EIdent("xs", -1))
  let masks: Array[Int] = []
  let names = compute_borrow_param_user_fns([
    truncate,
    length,
    join,
    compare,
    plain
  ], [], masks)
  assert_eq(Array::length(names), 4)
  assert_eq(mask_for(names, masks, "Array::truncate"), 0)
  assert_eq(mask_for(names, masks, "Bytes::compare"), 0)
  let call = ECall(EIdent("Array::truncate", -1), [EIdent("xs", -1), EInt(2)], -1)
  assert_eq(md_consume_count_pre(call, "xs", names, masks), 1)
  let cmp_call = ECall(EIdent("Bytes::compare", -1), [
    EIdent("a", -1),
    EIdent("b", -1)
  ], -1)
  assert_eq(md_consume_count_pre(cmp_call, "b", names, masks), 1)
  // Not shadowed: the builtin keeps borrowing.
  let plain_masks: Array[Int] = []
  let unshadowed = compute_borrow_param_user_fns([plain], [], plain_masks)
  assert_eq(Array::length(unshadowed), 0)
  assert_eq(md_consume_count_pre(call, "xs", unshadowed, plain_masks), 0)
}

test "#2379 review: a source-owned Map accessor may still infer a borrowed receiver" {
  let borrowed = one_param_fn("Map::iter_get", "m", ECall(EIdent("Array::length", -1), [
    EIdent("m", -1)
  ], -1))
  let masks: Array[Int] = []
  let names = compute_borrow_param_user_fns([borrowed], [], masks)
  assert_eq(mask_for(names, masks, "Map::iter_get"), 1)
  let call = ECall(EIdent("Map::iter_get", -1), [EIdent("m", -1)], -1)
  assert_eq(md_consume_count_pre(call, "m", names, masks), 0)
}
