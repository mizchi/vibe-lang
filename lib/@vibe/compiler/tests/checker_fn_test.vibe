//# Imports

import @vibe/compiler/core {
  Expr, Pat, Stmt, Type, TypeEnv, TypeExpr, env_bind, types_equal
}

import ./checker_test_support.vibe {
  check, no_tb, no_tp
}

//# Misc

test "call returns fn return type" {
  let env = env_bind(env = EnvEmpty, name = "f", ty = CtFn([CtInt], CtString, None))
  let expr = ECall(EIdent("f", -1), [EInt(42)], -1, [])
  assert(types_equal(a = check(expr = expr, env = env), b = CtString))
}

test "while returns unit" {
  let expr = EWhile(EBool(true), EInt(1))
  assert(types_equal(a = check(expr = expr, env = EnvEmpty), b = CtUnit))
}

test "for-in returns array" {
  let env = env_bind(env = EnvEmpty, name = "xs", ty = CtArray(CtInt))
  let expr = EForIn("x", None, EIdent("xs", -1), EString("a", -1))
  assert(types_equal(a = check(expr = expr, env = env), b = CtArray(CtString)))
}

test "match returns first arm type" {
  let expr = EMatch(EInt(1), [
    (PInt(1), EString("one", -1)),
    (PWild, EString("other", -1))
  ])
  assert(types_equal(a = check(expr = expr, env = EnvEmpty), b = CtString))
}

test "desugared pipe call returns fn return type" {
  let env = env_bind(env = EnvEmpty, name = "f", ty = CtFn([CtInt], CtString, None))
  let expr = ECall(EIdent("f", -1), [EInt(42)], -1, [])
  assert(types_equal(a = check(expr = expr, env = env), b = CtString))
}
