import @vibe/compiler/entry/compiler/fs_compile {
  closure_merged_stmts
}

import @vibe/compiler/codegen {
  desugar_trait_dicts
}

import @vibe/compiler/syntax {
  print_program
}

fn builtin_sources() -> Array[(String, String)] {
  [("@vibe/builtin.vibe", "export trait Iterator[T]")]
}

test "inline Iterator map devirtualizes before codegen" {
  let iterator_source = "import @vibe/builtin { trait Iterator }\nfn _start() -> Int { Array::length(Iterator::map([1, 2, 3], (x: Int) -> Int { x + 1 })) }"
  let through_iterator = closure_merged_stmts(main_source = iterator_source, main_path = "main.vibe", sources = builtin_sources(), checked_error_row = false)
  desugar_trait_dicts(through_iterator)
  let rewritten = print_program(through_iterator)
  assert(String::contains(rewritten, needle = "Array::map"))
  assert(!String::contains(rewritten, needle = "Iterator::map"))
}

test "inline Iterator flatmap devirtualizes before codegen" {
  let iterator_source = "import @vibe/builtin { trait Iterator }\nfn _start() -> Int { Array::length(Iterator::flatmap([1, 2], (x: Int) -> Array[Int] { [x, x] })) }"
  let through_iterator = closure_merged_stmts(main_source = iterator_source, main_path = "main.vibe", sources = builtin_sources(), checked_error_row = false)
  desugar_trait_dicts(through_iterator)
  let rewritten = print_program(through_iterator)
  assert(String::contains(rewritten, needle = "Array::flatmap"))
  assert(!String::contains(rewritten, needle = "Iterator::flatmap"))
}

test "inline Iterator iter devirtualizes without using async Array::iter" {
  let iterator_source = "import @vibe/builtin { trait Iterator }\nfn _start() -> Int { Iterator::iter([1, 2, 3], (_x: Int) -> Unit { () }) }"
  let through_iterator = closure_merged_stmts(main_source = iterator_source, main_path = "main.vibe", sources = builtin_sources(), checked_error_row = false)
  desugar_trait_dicts(through_iterator)
  let rewritten = print_program(through_iterator)
  assert(String::contains(rewritten, needle = "Array::iter_eager"))
  assert(!String::contains(rewritten, needle = "Iterator::iter"))
  assert(!String::contains(rewritten, needle = "Array::iter([1"))
}

// #3185: a program's own `Array::iter_eager` is renamed `Array::iter_eager$user`
// and answers only the calls the program wrote, so it no longer needs to block
// the intrinsic rewrite -- the devirtualized call reaches the builtin, never
// the program's function.
test "a program's own eager Array iterator does not take the intrinsic rewrite" {
  let iterator_source = "import @vibe/builtin { trait Iterator }\nfn Array::iter_eager(_xs: Array[Int], _f: (Int) -> Unit) -> Int { 77 }\nfn _start() -> Int { Iterator::iter([1, 2, 3], (_x: Int) -> Unit { () }) }"
  let through_iterator = closure_merged_stmts(main_source = iterator_source, main_path = "main.vibe", sources = builtin_sources(), checked_error_row = false)
  desugar_trait_dicts(through_iterator)
  let rewritten = print_program(through_iterator)
  assert(String::contains(rewritten, needle = "let rec Array::iter_eager$user = "))
  assert(String::contains(rewritten, needle = "Array::iter_eager([1, 2, 3]"))
  assert(!String::contains(rewritten, needle = "Array::iter_eager$user([1, 2, 3]"))
  assert(!String::contains(rewritten, needle = "Iterator::iter([1, 2, 3]"))
}

test "a later custom Iterator trait import blocks builtin intrinsics" {
  let custom_source = "export trait Iterator[T]\nexport fn Iterator::map(xs: Array[Int], _f: (Int) -> Int) -> Array[Int] { [77] }"
  let main_source = "import @vibe/builtin { trait Iterator }\nimport ./custom.vibe { trait Iterator }\nfn _start() -> Int { Array::get(Iterator::map([1], (x: Int) -> Int { x + 1 }), 0) }"
  let merged = closure_merged_stmts(main_source = main_source, main_path = "main.vibe", sources = [
    ("@vibe/builtin.vibe", "export trait Iterator[T]"),
    ("custom.vibe", custom_source)
  ], checked_error_row = false)
  desugar_trait_dicts(merged)
  let rewritten = print_program(merged)
  assert(!String::contains(rewritten, needle = "Array::map([1]"))
  assert(String::contains(rewritten, needle = "Iterator_exp_custom_vibe::map([1]"))
}

test "inline source boundaries retain plain re-export builtin blockers" {
  let main_source = "export ./dep.vibe { assert_eq }\nfn answer() -> Int { assert_eq(1, 2) }"
  let merged = closure_merged_stmts(main_source = main_source, main_path = "main.vibe", sources = [
    ("dep.vibe", "export fn assert_eq(a: Int, b: Int) -> Int { a + b }")
  ], checked_error_row = false)
  desugar_trait_dicts(merged)
  let rewritten = print_program(merged)
  assert(String::contains(rewritten, needle = "answer = () -> Int { assert_eq(1, 2) }"))
  assert(!String::contains(rewritten, needle = "assert_eq failed"))
}

test "inline merge publishes renamed provider-qualified trait helpers" {
  let dep_source = "import @vibe/builtin { trait Iterator as Iter }\nexport fn Iterator::map(xs: Array[Int], _f: (Int) -> Int) -> Array[Int] { [77] }"
  let main_source = "import ./dep.vibe { Iterator::map }\nfn answer() -> Int { Array::get(Iterator::map([1], (x: Int) -> Int { x }), 0) }"
  let merged = closure_merged_stmts(main_source = main_source, main_path = "main.vibe", sources = [
    ("@vibe/builtin.vibe", "export trait Iterator[T]"),
    ("dep.vibe", dep_source)
  ], checked_error_row = false)
  let rewritten = print_program(merged)
  assert(String::contains(rewritten, needle = "__local_trait_Iterator::map_exp_dep_vibe ="))
  assert(String::contains(rewritten, needle = "Array::get(__local_trait_Iterator::map_exp_dep_vibe("))
}

test "entry exports keep their qualified trait helper ABI" {
  let main_source = "import @vibe/builtin { trait Iterator as Iter }\nexport fn Iterator::map(xs: Array[Int], _f: (Int) -> Int) -> Array[Int] { [77] }\nfn _start() -> Int { Array::get(Iterator::map([1], (x: Int) -> Int { x }), 0) + Array::length(Iter::map([1], (x: Int) -> Int { x })) }"
  let standard_source = "export trait Iterator[T]\nexport fn Iterator::map(xs: Array[Int], f: (Int) -> Int) -> Array[Int] { Array::map(xs, f) }"
  let merged = closure_merged_stmts(main_source = main_source, main_path = "main.vibe", sources = [
    ("@vibe/builtin.vibe", standard_source)
  ], checked_error_row = false)
  let before_desugar = print_program(merged)
  assert(String::contains(before_desugar, needle = "export let rec Iterator::map ="))
  assert(!String::contains(before_desugar, needle = "__local_trait_Iterator::map"))
  desugar_trait_dicts(merged)
  let rewritten = print_program(merged)
  assert(String::contains(rewritten, needle = "Iterator::map([1]"))
  assert(String::contains(rewritten, needle = "Array::map([1]"))
}

test "a custom imported Iterator helper blocks intrinsic rewriting" {
  let custom_source = "export fn Iterator::map(xs: Array[Int], _f: (Int) -> Int) -> Array[Int] { [77] }"
  let main_source = "import @vibe/builtin { trait Iterator }\nimport ./custom.vibe { Iterator::map }\nfn _start() -> Int { Array::get(Iterator::map([1], (x: Int) -> Int { x }), 0) }"
  let merged = closure_merged_stmts(main_source = main_source, main_path = "main.vibe", sources = [
    ("@vibe/builtin.vibe", "export trait Iterator[T]"),
    ("custom.vibe", custom_source)
  ], checked_error_row = false)
  desugar_trait_dicts(merged)
  let rewritten = print_program(merged)
  assert(!String::contains(rewritten, needle = "Array::map([1]"))
  assert(String::contains(rewritten, needle = "Iterator::map([1]"))
  assert(String::contains(rewritten, needle = "Iterator::map = (xs: Array[Int]"))
}

test "a custom re-exported Iterator helper blocks intrinsic rewriting" {
  let custom_source = "export fn Iterator::map(xs: Array[Int], _f: (Int) -> Int) -> Array[Int] { [77] }"
  let main_source = "import @vibe/builtin { trait Iterator }\nexport ./custom.vibe { Iterator::map }\nfn _start() -> Int { Array::get(Iterator::map([1], (x: Int) -> Int { x }), 0) }"
  let merged = closure_merged_stmts(main_source = main_source, main_path = "main.vibe", sources = [
    ("@vibe/builtin.vibe", "export trait Iterator[T]"),
    ("custom.vibe", custom_source)
  ], checked_error_row = false)
  desugar_trait_dicts(merged)
  let rewritten = print_program(merged)
  assert(!String::contains(rewritten, needle = "Array::map([1]"))
  assert(String::contains(rewritten, needle = "Iterator::map([1]"))
  assert(String::contains(rewritten, needle = "Iterator::map = (xs: Array[Int]"))
}
