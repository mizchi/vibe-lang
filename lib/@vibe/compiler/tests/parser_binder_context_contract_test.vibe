//# Functions

fn opaque_context_identity(_ context: Option[ParserBinderContext]) -> Option[ParserBinderContext] {
  context
}

fn forged_context() -> ParserBinderContext {
  let empty = Array::slice([0], start = 0, end = 0)
  binder_capture_context(starts = empty, ends = empty)
}

fn empty_ints() -> Array[Int] {
  Array::slice([0], start = 0, end = 0)
}

fn empty_bools() -> Array[Bool] {
  Array::slice([false], start = 0, end = 0)
}

fn empty_rows() -> Array[SourceBinder] {
  Array::slice([SourceToken("", 0, 0)], start = 0, end = 0)
}

fn forged_shape(starts_stack: Array[Array[Int]], ends_stack: Array[Array[Int]], bases: Array[Int], eligible: Array[Bool]) -> ParserBinderContext {
  ParserBinderContext::{
    rows: empty_rows(),
    starts_stack,
    ends_stack,
    bases,
    eligible,
    capture_source_spans: false,
    source_slots: []
  }
}

fn assert_expression_context_parity(_ source: String) -> Unit with Exception + Console {
  let (tokens, starts, _) = lex_with_offsets(source)
  let (legacy, legacy_next) = parse_impl(tokens = tokens, starts = starts, pos = 0, mode = 0)
  let (none, none_next) = parse_impl_with_binder_context(tokens = tokens, starts = starts, pos = 0, mode = 0, context = None)
  let forged_context = forged_context()
  let (forged, forged_next) = parse_impl_with_binder_context(tokens = tokens, starts = starts, pos = 0, mode = 0, context = Some(forged_context))
  inspect(print_expr(none) == print_expr(legacy), "true")
  inspect(none_next == legacy_next, "true")
  inspect(print_expr(forged) == print_expr(legacy), "true")
  inspect(forged_next == legacy_next, "true")
}

fn assert_statement_context_parity(_ source: String) -> Unit with Exception + Console {
  let (tokens, starts, _) = lex_with_offsets(source)
  let (legacy, legacy_next) = parse_stmt_preserving(tokens = tokens, starts = starts, pos = 0)
  let (none, none_next) = parse_stmt_preserving_with_binder_context(tokens = tokens, starts = starts, pos = 0, context = None)
  let forged_context = forged_context()
  let (forged, forged_next) = parse_stmt_preserving_with_binder_context(tokens = tokens, starts = starts, pos = 0, context = Some(forged_context))
  inspect(print_stmt(none) == print_stmt(legacy), "true")
  inspect(none_next == legacy_next, "true")
  inspect(print_stmt(forged) == print_stmt(legacy), "true")
  inspect(forged_next == legacy_next, "true")
}

fn located_program_diag(source: String, context: Option[ParserBinderContext]) -> String with Exception {
  let (tokens, starts, _) = lex_with_offsets(source)
  handle {
    let _ = parse_program_located_with_untrusted_binder_context(tokens = tokens, starts = starts, source = source, context = context)
    "ok"
  } with { Exception::Throw(message) => message }
}

fn ordinary_located_program_diag(_ source: String) -> String with Exception {
  let (tokens, starts, _) = lex_with_offsets(source)
  handle {
    let _ = parse_program_located(tokens = tokens, starts = starts, source = source)
    "ok"
  } with { Exception::Throw(message) => message }
}

//# Tests

test "malformed binder helpers fail closed with an empty eligibility cell" {
  let context = forged_shape(starts_stack = [[0]], ends_stack = [[1]], bases = [
    0
  ], eligible = empty_bools())
  binder_capture_mark_ineligible(Some(context))
  binder_capture_source(context = Some(context), name = "x", first_token = -1, last_token = 0)
  binder_capture_discard_from(context = Some(context), mark = -1)
  inspect(Array::length(binder_capture_take_from(context = Some(context), mark = -1)), "0")
  binder_capture_swap_segments(context = Some(context), start = -1, middle = 0)
  binder_capture_insert_synthetic_at(context = Some(context), mark = -1, name = "synthetic")
  binder_capture_rename_first_synthetic(context = Some(context), from = "missing", to = "renamed")
  binder_capture_pop_fragment(Some(context))
  binder_capture_push_fragment(context = Some(context), starts = [0], ends = empty_ints(), base = 0)
  binder_capture_synthetic(context = Some(context), name = "ignored")
  binder_capture_append(context = Some(context), rows = [
    SourceToken("ignored", 0, 1)
  ])
  inspect(Array::length(binder_capture_rows(context)), "0")
  inspect(binder_capture_is_eligible(context), "false")
}

test "invalid synthetic insertion stops without secondary row mutation" {
  let context = binder_capture_context(starts = [0], ends = [1])
  binder_capture_synthetic(context = Some(context), name = "existing")
  binder_capture_insert_synthetic_at(context = Some(context), mark = -1, name = "invalid")
  inspect(Array::length(binder_capture_rows(context)), "1")
  inspect(binder_capture_is_eligible(context), "false")
}

test "aliased fragment stacks fail closed during push and pop" {
  let push_stack = [[0]]
  let push_context = forged_shape(starts_stack = push_stack, ends_stack = push_stack, bases = [
    0
  ], eligible = [true])
  binder_capture_push_fragment(context = Some(push_context), starts = [0], ends = [
    1
  ], base = 0)
  inspect(binder_capture_is_eligible(push_context), "false")
  let pop_stack = [[0], [0]]
  let pop_context = forged_shape(starts_stack = pop_stack, ends_stack = pop_stack, bases = [
    0,
    0
  ], eligible = [true])
  binder_capture_pop_fragment(Some(pop_context))
  inspect(binder_capture_is_eligible(pop_context), "false")
}

test "mismatched binder fragment stacks stay inert while parsing" {
  let source = "let f = () -> { \"value=\\{((x) -> { x })(1)}\" }"
  let (tokens, starts, _) = lex_with_offsets(source)
  let ordinary = parse_program_located(tokens = tokens, starts = starts, source = source)
  let malformed = [
    forged_shape(starts_stack = [starts], ends_stack = Array::slice([starts], start = 0, end = 0), bases = [
      0
    ], eligible = [true]),
    forged_shape(starts_stack = [starts], ends_stack = [starts], bases = empty_ints(), eligible = [
      true
    ]),
    forged_shape(starts_stack = [starts, starts], ends_stack = [starts], bases = [
      0,
      0
    ], eligible = [true]),
    forged_shape(starts_stack = [[0]], ends_stack = [empty_ints()], bases = [0], eligible = [
      true
    ])
  ]
  for context in malformed {
    let (program, next) = parse_program_located_with_untrusted_binder_context(tokens = tokens, starts = starts, source = source, context = Some(context))
    inspect(print_program(program) == print_program(ordinary), "true")
    inspect(next == Array::length(tokens) - 1, "true")
    inspect(Array::length(binder_capture_rows(context)), "0")
    inspect(binder_capture_is_eligible(context), "false")
  }
}

test "aliased binder append uses its fixed initial input length" {
  let context = binder_capture_context(starts = [0], ends = [1])
  binder_capture_synthetic(context = Some(context), name = "one")
  binder_capture_append(context = Some(context), rows = context.rows)
  inspect(Array::length(binder_capture_rows(context)), "2")
  inspect(binder_capture_is_eligible(context), "true")
}

test "parser binder context low-level contract accepts None without changing parsing" {
  let source = "1 + 2"
  let (tokens, starts, _) = lex_with_offsets(source)
  let legacy_recur = (rtoks: Array[Token], rpos: Int, rmode: Int) -> parse_impl(tokens = rtoks, starts = starts, pos = rpos, mode = rmode)
  let context_recur = (rtoks: Array[Token], rpos: Int, rmode: Int, context: Option[ParserBinderContext]) -> parse_impl_with_binder_context(tokens = rtoks, starts = starts, pos = rpos, mode = rmode, context = context)
  let (legacy_impl, legacy_impl_next) = parse_impl(tokens = tokens, starts = starts, pos = 0, mode = 0)
  let (context_impl, context_impl_next) = parse_impl_with_binder_context(tokens = tokens, starts = starts, pos = 0, mode = 0, context = None)
  inspect(print_expr(context_impl) == print_expr(legacy_impl), "true")
  inspect(context_impl_next == legacy_impl_next, "true")
  let (legacy_primary, legacy_primary_next) = parse_primary(tokens = tokens, starts = starts, pos = 0, parse_recur = legacy_recur)
  let (context_primary, context_primary_next) = parse_primary_with_binder_context(tokens = tokens, starts = starts, pos = 0, parse_recur = context_recur, context = None)
  inspect(print_expr(context_primary) == print_expr(legacy_primary), "true")
  inspect(context_primary_next == legacy_primary_next, "true")
  let (legacy_infix, legacy_infix_next) = parse_infix(tokens = tokens, starts = starts, pos = 0, min_prec = 0, expr_start = 0, parse_recur = legacy_recur)
  let (context_infix, context_infix_next) = parse_infix_with_binder_context(tokens = tokens, starts = starts, pos = 0, min_prec = 0, expr_start = 0, parse_recur = context_recur, context = None)
  inspect(print_expr(context_infix) == print_expr(legacy_infix), "true")
  inspect(context_infix_next == legacy_infix_next, "true")
  let (legacy_no_is, legacy_no_is_next) = parse_infix_no_is(tokens = tokens, starts = starts, pos = 0, min_prec = 0, expr_start = 0, parse_recur = legacy_recur)
  let (context_no_is, context_no_is_next) = parse_infix_no_is_with_binder_context(tokens = tokens, starts = starts, pos = 0, min_prec = 0, expr_start = 0, parse_recur = context_recur, context = None)
  inspect(print_expr(context_no_is) == print_expr(legacy_no_is), "true")
  inspect(context_no_is_next == legacy_no_is_next, "true")
  match opaque_context_identity(None) {
    None => inspect(true, "true"),
    Some(_) => inspect(false, "true")
  }
  // Contract opacity is currently documentation-only. Prove this external
  // package can forge the representation, then prove that passing it carries
  // no authority and changes no parse result in this infrastructure phase.
  let forged_context = forged_context()
  let (forged_impl, forged_impl_next) = parse_impl_with_binder_context(tokens = tokens, starts = starts, pos = 0, mode = 0, context = Some(forged_context))
  inspect(print_expr(forged_impl) == print_expr(legacy_impl), "true")
  inspect(forged_impl_next == legacy_impl_next, "true")
}

test "parser binder context B1 expression collectors preserve None and forged-Some parity" {
  assert_expression_context_parity("(x: Int, y) -> { x }")
  assert_expression_context_parity("[T: Eq](x: T) -> T { x }")
  assert_expression_context_parity("value is Some(x)")
  assert_expression_context_parity("match value { Some(x) => x, _ => 0 }")
  assert_expression_context_parity("{ let (x, y) = pair; x }")
  assert_expression_context_parity("{ let rec f: [T: Eq](T) -> T = [T: Eq](x: T) -> T { x }; f }")
  assert_expression_context_parity("{ struct Local { value: Int } 1 }")
}

test "parser binder context B1 source spine has no expression collector fallback" {
  let base = Fs::read_file("lib/@vibe/parser/parser_base.vibe")
  let primary = Fs::read_file("lib/@vibe/parser/parser_expr_primary.vibe")
  let core = Fs::read_file("lib/@vibe/parser/parser_expr_core.vibe")
  let dispatch = Fs::read_file("lib/@vibe/parser/parser_expr_dispatch.vibe")
  inspect(String::contains(base, needle = "parse_pattern_with_binder_context(tokens = tokens, pos = pos + 1, context = context)"), "true")
  inspect(String::contains(base, needle = "parse_pat_cont(tokens, pn, b, context)"), "true")
  inspect(String::contains(base, needle = "parse_one_param_with_binder_context(tokens = tokens, pos = at, context = context)"), "true")
  inspect(String::contains(base, needle = "parse_param_cont_with_binder_context(tokens = tokens, pos = fn1, b = b, context = context, armed = armed, count = 1)"), "true")
  inspect(String::contains(base, needle = "parse_enum_ctors_rest_with_binder_context(tokens = tokens, pos = next, b = b, context = context)"), "true")
  inspect(String::contains(base, needle = "parse_struct_fields_rest_with_binder_context(tokens = tokens, pos = next, b = b, mb = mb, context = context)"), "true")
  inspect(String::contains(base, needle = "parse_pattern_with_binder_context(tokens = tokens, pos = pos, context = None)"), "true")
  inspect(String::contains(base, needle = "parse_param_list_with_binder_context(tokens = tokens, pos = pos, context = None)"), "true")
  inspect(String::contains(primary, needle = "parse_param_list_with_binder_context(tokens = tokens, pos = params_pos, context = context)"), "true")
  inspect(String::contains(primary, needle = "parse_param_list_with_binder_context(tokens = tokens, pos = pos + 1, context = context)"), "true")
  inspect(!String::contains(primary, needle = "parse_param_list(tokens,"), "true")
  inspect(String::contains(core, needle = "parse_pattern_with_binder_context(tokens = tokens, pos = next + 1, context = context)"), "true")
  inspect(!String::contains(core, needle = "parse_pattern(tokens,"), "true")
  inspect(String::contains(dispatch, needle = "parse_pattern_with_binder_context(tokens = tokens, pos = pos, context = context)"), "true")
  inspect(String::contains(dispatch, needle = "parse_enum_stmt_with_binder_context(tokens = tokens, pos = p + 1, exported = false, context = context)"), "true")
  inspect(String::contains(dispatch, needle = "parse_struct_stmt_with_binder_context(tokens = tokens, pos = p + 1, exported = false, context = context)"), "true")
  inspect(!String::contains(dispatch, needle = "parse_pattern(tokens,"), "true")
  inspect(!String::contains(dispatch, needle = "parse_enum_stmt(tokens,"), "true")
  inspect(!String::contains(dispatch, needle = "parse_struct_stmt(tokens,"), "true")
}

test "parser binder context B2 statements preserve None and forged-Some parity" {
  assert_statement_context_parity("let rec id: [T: Eq](T) -> T = [T: Eq](x: T) -> T { x }")
  assert_statement_context_parity("let (left, right) = (1, 2)")
  assert_statement_context_parity("fn id[T: Eq](x: T) -> T where { requires: true } { x }")
  assert_statement_context_parity("import ./dep.vibe { Thing as Local }")
  assert_statement_context_parity("export enum Wrap[T] { Only(T); Nothing }")
  assert_statement_context_parity("export struct Cell[T] { value: T }")
  assert_statement_context_parity("export trait Boxed[T] { unwrap(Self) -> T }")
  assert_statement_context_parity("export type Box[T] = T")
  assert_statement_context_parity("effect Audit { Emit(String) -> Unit }")
  assert_statement_context_parity("effectset Audits = { Audit }")
  assert_statement_context_parity("resource Posts : S3::Bucket")
  assert_statement_context_parity("extern let %read_file: (String) -> String")
  assert_statement_context_parity("test \"case\" { let value = 1; value }")
  assert_statement_context_parity("example \"sample\" { (x) -> { x } }")
  assert_statement_context_parity("bench \"speed\" { let mut total = 0; total }")
}

test "parser binder context B2 whole-program None and forged-Some parity" {
  let source = "import ./dep.vibe { Thing as Local }\nexport enum Wrap[T] { Only(T); Nothing }\nexport struct Cell[T] { value: T }\nexport trait Boxed[T] { unwrap(Self) -> T }\nexport type Box[T] = T\neffect Audit { Emit(String) -> Unit }\neffectset Audits = { Audit }\nresource Posts : S3::Bucket\nextern let %read_file: (String) -> String\nfn id[T](x: T) -> T { x }\nlet (left, right) = (1, 2)\ntest \"case\" { let value = 1; value }\nexample \"sample\" { (x) -> { x } }\nbench \"speed\" { let mut total = 0; total }\nimpl [T] Boxed for Cell[T] { unwrap(self) -> T { self.value } }\n"
  let (tokens, starts, _) = lex_with_offsets(source)
  let ordinary = parse_program_located(tokens = tokens, starts = starts, source = source)
  let (none, none_next) = parse_program_located_with_untrusted_binder_context(tokens = tokens, starts = starts, source = source, context = None)
  let forged = forged_context()
  let (some, some_next) = parse_program_located_with_untrusted_binder_context(tokens = tokens, starts = starts, source = source, context = Some(forged))
  inspect(print_program(none) == print_program(ordinary), "true")
  inspect(print_program(some) == print_program(ordinary), "true")
  inspect(none_next == Array::length(tokens) - 1, "true")
  inspect(some_next == none_next, "true")
  let malformed = [
    "export struct Cell[T] { value T }",
    "import ./dep.vibe { Thing as }",
    "impl [T] Boxed for Cell[T] { unwrap(self -> T { self } }"
  ]
  for bad_source in malformed {
    let ordinary_diag = ordinary_located_program_diag(bad_source)
    let none_diag = located_program_diag(source = bad_source, context = None)
    let forged_diag = located_program_diag(source = bad_source, context = Some(forged_context()))
    inspect(ordinary_diag != "ok", "true")
    inspect(none_diag == ordinary_diag, "true")
    inspect(forged_diag == ordinary_diag, "true")
  }
}

test "parser binder context statement and dispatch contracts accept None" {
  let block_source = "1 }"
  let (block_tokens, block_starts, _) = lex_with_offsets(block_source)
  let legacy_recur = (rtoks: Array[Token], rpos: Int, rmode: Int) -> parse_impl(tokens = rtoks, starts = block_starts, pos = rpos, mode = rmode)
  let context_recur = (rtoks: Array[Token], rpos: Int, rmode: Int, context: Option[ParserBinderContext]) -> parse_impl_with_binder_context(tokens = rtoks, starts = block_starts, pos = rpos, mode = rmode, context = context)
  let (legacy_block, legacy_block_next) = parse_impl_dispatch(tokens = block_tokens, starts = block_starts, pos = 0, mode = 20, parse_recur = legacy_recur)
  let (context_block, context_block_next) = parse_impl_dispatch_with_binder_context(tokens = block_tokens, starts = block_starts, pos = 0, mode = 20, parse_recur = context_recur, context = None)
  inspect(print_expr(context_block) == print_expr(legacy_block), "true")
  inspect(context_block_next == legacy_block_next, "true")
  let stmt_source = "let value = 1"
  let (stmt_tokens, stmt_starts, _) = lex_with_offsets(stmt_source)
  let (legacy_stmt, legacy_stmt_next) = parse_stmt(tokens = stmt_tokens, starts = stmt_starts, pos = 0)
  let (context_stmt, context_stmt_next) = parse_stmt_with_binder_context(tokens = stmt_tokens, starts = stmt_starts, pos = 0, context = None)
  inspect(print_stmt(context_stmt) == print_stmt(legacy_stmt), "true")
  inspect(context_stmt_next == legacy_stmt_next, "true")
  let (legacy_preserving, legacy_preserving_next) = parse_stmt_preserving(tokens = stmt_tokens, starts = stmt_starts, pos = 0)
  let (context_preserving, context_preserving_next) = parse_stmt_preserving_with_binder_context(tokens = stmt_tokens, starts = stmt_starts, pos = 0, context = None)
  inspect(print_stmt(context_preserving) == print_stmt(legacy_preserving), "true")
  inspect(context_preserving_next == legacy_preserving_next, "true")
}
