  assert_contextual_function_region(parser, "export fn parse_stmt_preserving_with_binder_context", "export fn parse_stmt_preserving(", [
    "TLet => parse_let_stmt_with_binder_context",
    "_ => parse_export_stmt_with_binder_context(tokens, starts, pos + 1, context)",
    "TImport => parse_import_stmt_with_binder_context",
    "TTest => parse_test_stmt_with_binder_context",
    "TExample => parse_example_stmt_with_binder_context",
