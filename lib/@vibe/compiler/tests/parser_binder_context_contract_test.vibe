  Token,
  binder_capture_append,
  binder_capture_context,
  binder_capture_discard_from,
  binder_capture_insert_synthetic_at,
  binder_capture_is_eligible,
  binder_capture_mark_ineligible,
  binder_capture_pop_fragment,
  binder_capture_push_fragment,
  binder_capture_rename_first_synthetic,
  binder_capture_rows,
  binder_capture_source,
  binder_capture_swap_segments,
  binder_capture_synthetic,
  binder_capture_take_from,
  lex_with_offsets,
  parse_impl,
  parse_impl_dispatch,
  parse_impl_dispatch_with_binder_context,
  parse_impl_with_binder_context,
  parse_infix,
  parse_infix_no_is,
  parse_infix_no_is_with_binder_context,
  parse_infix_with_binder_context,
  parse_primary,
  parse_primary_with_binder_context,
  parse_program_located,
  parse_program_located_with_untrusted_binder_context,
