//# Imports

import ./parser_test_support.vibe {
  parse_print
}

//# Misc

test "parse add" {
  let result = handle {
    parse_print("1 + 2")
  } with Error {
    Throw(e) => String::concat("ERROR: ", e)
  }
  assert(result == "(1 + 2)")
}

test "parse mul" {
  let result = handle {
    parse_print("3 * 4")
  } with Error {
    Throw(e) => String::concat("ERROR: ", e)
  }
  assert(result == "(3 * 4)")
}

test "parse precedence" {
  let result = handle {
    parse_print("1 + 2 * 3")
  } with Error {
    Throw(e) => String::concat("ERROR: ", e)
  }
  assert(result == "(1 + (2 * 3))")
}

test "parse left assoc" {
  let result = handle {
    parse_print("1 + 2 + 3")
  } with Error {
    Throw(e) => String::concat("ERROR: ", e)
  }
  assert(result == "((1 + 2) + 3)")
}

test "parse parens" {
  let result = handle {
    parse_print("(1 + 2) * 3")
  } with Error {
    Throw(e) => String::concat("ERROR: ", e)
  }
  assert(result == "((1 + 2) * 3)")
}

test "parse unary minus" {
  let result = handle {
    parse_print("-1")
  } with Error {
    Throw(e) => String::concat("ERROR: ", e)
  }
  assert(result == "(-1)")
}

test "parse unary not" {
  let result = handle {
    parse_print("!x")
  } with Error {
    Throw(e) => String::concat("ERROR: ", e)
  }
  assert(result == "(!x)")
}
