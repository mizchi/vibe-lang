//# Imports

import ./checker_parity_test_support.vibe {
  check_source_err_contains, check_source_ok
}

//# Misc

// ADR-0122 (#3728): the parser reads `Float64` / `Float32` as `Double` /
// `Float` in every type position and `X::` namespace. A declaration that
// keeps the written spelling as its own name would then be referenced by the
// other one (`effect Float64` performed as `Double::Op`), so every kind that
// introduces a name usable in those positions refuses it.

test "Float64 / Float32 are refused as declaration names" {
  assert(check_source_err_contains("struct Float64 { v: Int }\nfn main() -> Int { 0 }", "rename this struct: `Float64`"))
  assert(check_source_err_contains("enum Float32[T] { A(T) }\nfn main() -> Int { 0 }", "rename this enum: `Float32`"))
  assert(check_source_err_contains("trait Float64 {\n  m(Self) -> Int\n}\nfn main() -> Int { 0 }", "rename this trait: `Float64`"))
  assert(check_source_err_contains("effect Float64 {\n  Op() -> Int\n}\nfn main() -> Int { 0 }", "rename this effect: `Float64`"))
  assert(check_source_err_contains("effect Ask {\n  Get() -> Int\n}\neffectset Float32 = { Ask }\nfn main() -> Int { 0 }", "rename this effect set: `Float32`"))
  assert(check_source_err_contains("import ./other.vibe { Hue as Float64 }\nfn main() -> Int { 0 }", "rename this import alias: `Float64`"))
}

test "a constructor named Float64 and a type parameter named Float64 are fine" {
  assert(check_source_ok("enum Num {\n  Float64(Int);\n  Other\n}\nfn main() -> Int { 0 }"))
  assert(check_source_ok("struct Holder[Float64] { value: Float64 }\nfn main() -> Int {\n  let h = Holder::{ value: \"text\" }\n  0\n}"))
}
