//# Imports

import @vibe/compiler/loader {
  check_module, collect_merged_stmts
}

import @vibe/compiler/syntax {
  print_program
}

import @vibe/core {
  array_empty
}

import @vibe/compiler/core {
  Type, TypeEnv, env_lookup
}

//# Functions

fn empty_cache() -> Array[(String, TypeEnv)] {
  array_empty()
}

fn empty_loading() -> Array[String] {
  array_empty()
}

//# Misc

test "check_module: single file no imports" {
  let source = "let x = 42"
  let sources = array_empty()
  let env = check_module(source, "main.vibe", sources, empty_loading(), empty_cache())
  match env_lookup(env, "x") {
    Some(_) => assert(true),
    None => assert(false)
  }
}

test "check_module: file with import resolves types" {
  let helper_src = "export let add: (Int, Int) -> Int = (a, b) -> { a + b }"
  let main_src = "import ./helpers.vibe { add }\nlet result = add(1, 2)"
  let sources = [("helpers.vibe", helper_src)]
  let env = check_module(main_src, "main.vibe", sources, empty_loading(), empty_cache())
  match env_lookup(env, "result") {
    Some(_) => assert(true),
    None => assert(false)
  }
}

test "check_module: import with alias" {
  let helper_src = "export let greet: () -> String = () -> { \"hi\" }"
  let main_src = "import ./helpers.vibe { greet as hello }\nlet msg = hello()"
  let sources = [("helpers.vibe", helper_src)]
  let env = check_module(main_src, "main.vibe", sources, empty_loading(), empty_cache())
  match env_lookup(env, "msg") {
    Some(_) => assert(true),
    None => assert(false)
  }
}

test "check_module: transitive imports" {
  let base_src = "export let base_val = 1"
  let mid_src = "import ./base.vibe { base_val }\nexport let mid_val = base_val"
  let main_src = "import ./mid.vibe { mid_val }\nlet result = mid_val"
  let sources = [("base.vibe", base_src), ("mid.vibe", mid_src)]
  let env = check_module(main_src, "main.vibe", sources, empty_loading(), empty_cache())
  match env_lookup(env, "result") {
    Some(_) => assert(true),
    None => assert(false)
  }
}

test "check_module: re-exported enum type imports constructors through index module" {
  let ast_src = "export enum TypeExpr { TyName(String); TyTuple(Array[TypeExpr]) }"
  let index_src = "export ./ast.vibe { TypeExpr }"
  let main_src = "import ./core { TypeExpr }\nlet ann: TypeExpr = TyTuple([TyName(\"Int\")])"
  let sources = [("core/ast.vibe", ast_src), ("core/index.vibe", index_src)]
  let env = check_module(main_src, "main.vibe", sources, empty_loading(), empty_cache())
  match env_lookup(env, "ann") {
    Some(CtUnknown) => assert(false),
    Some(_) => assert(true),
    None => assert(false)
  }
}

test "check_module: cache avoids duplicate checking" {
  let helper_src = "export let x = 1"
  let sources = [("helpers.vibe", helper_src)]
  let cache = empty_cache()
  let _ = check_module("import ./helpers.vibe { x }\nlet a = x", "a.vibe", sources, empty_loading(), cache)
  assert(Array::length(cache) > 0)
  let _ = check_module("import ./helpers.vibe { x }\nlet b = x", "b.vibe", sources, empty_loading(), cache)
  assert(true)
}

test "check_module: cached module does not reparse helper source for exports" {
  let cache = empty_cache()
  let good_sources = [("helpers.vibe", "export let x = 1")]
  let _ = check_module("import ./helpers.vibe { x }\nlet a = x", "a.vibe", good_sources, empty_loading(), cache)
  let broken_sources = [("helpers.vibe", "export let x =")]
  let env = check_module("import ./helpers.vibe { x }\nlet b = x", "b.vibe", broken_sources, empty_loading(), cache)
  match env_lookup(env, "b") {
    Some(_) => assert(true),
    None => assert(false)
  }
}

test "check_module: non-exported name not imported" {
  let helper_src = "let private_fn: () -> Int = () -> { 42 }\nexport let public_fn: () -> Int = () -> { 1 }"
  let main_src = "import ./helpers.vibe { private_fn }\nlet r = private_fn()"
  let sources = [("helpers.vibe", helper_src)]
  let env = check_module(main_src, "main.vibe", sources, empty_loading(), empty_cache())
  match env_lookup(env, "r") {
    Some(CtUnknown) => assert(true),
    None => assert(true),
    _ => assert(true)
  }
}

test "collect_merged_stmts rewrites `as` aliases to the original name (#1584)" {
  // The merged flat program only defines `env_probe`; before #1584 the
  // alias reference `ep(1)` survived the import-dropping merge untouched
  // and resolved to nothing at runtime (s5_entry_test / s5_wasm_test trap).
  let dep_src = "export fn env_probe(x: Int) -> Int {\n  x + 1\n}\n"
  let main_src = "import ./dep.vibe { env_probe as ep }\n\nexport fn use_alias() -> Int {\n  ep(1)\n}\n"
  let merged = collect_merged_stmts([
    ("dep.vibe", dep_src),
    ("main.vibe", main_src)
  ])
  let text = print_program(merged)
  assert(String::contains(text, "env_probe"))
  assert(!String::contains(text, "ep("))
}

test "collect_merged_stmts: a top-level def shadows a same-named import alias (#1584)" {
  // `fn shade` is declared in the importing file itself; references to
  // `shade` anywhere in that file must keep resolving to the local def,
  // not get rewritten to the aliased import's original name.
  let dep_src = "export fn tint(x: Int) -> Int {\n  x + 1\n}\n"
  let main_src = "import ./dep.vibe { tint as shade }\n\nfn shade() -> Int {\n  5\n}\n\nexport let picked = shade()\n"
  let merged = collect_merged_stmts([
    ("dep.vibe", dep_src),
    ("main.vibe", main_src)
  ])
  let text = print_program(merged)
  assert(String::contains(text, "shade()"))
  assert(!String::contains(text, "tint()"))
}
