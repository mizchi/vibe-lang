//# Imports

import @vibe/compiler/syntax {
  lex
}

import ../parser.vibe {
  parse_program
}

//# Misc

test "stmt_let_fn_tuple_return_with_nested_if_tuple" {
  let src = "let f: () -> (Int, Int) = () -> { let g: (Int) -> (Int, Int) = (idx) -> { if true { (idx, idx) } else { (idx, idx) } }; g(1) }"
  let ok = handle {
    let _ = parse_program(lex(src))
    true
  } with Exception {
    Throw(_) => false
  }
  assert(ok)
}

test "stmt_let_fn_tuple_return_with_nested_if_tuple_no_semi" {
  let src = "let f: () -> (Int, Int) = () -> { let g: (Int) -> (Int, Int) = (idx) -> { if true { (idx, idx) } else { (idx, idx) } } g(1) }"
  let ok = handle {
    let _ = parse_program(lex(src))
    true
  } with Exception {
    Throw(_) => false
  }
  assert(ok)
}

test "stmt_nested_lambda_tuple_if_regression_matrix" {
  let c1 = handle {
    let _ = parse_program(lex("let g: (Int) -> (Int, Int) = (idx) -> { if true { (idx, idx) } else { (idx, idx) } }"))
    true
  } with Exception {
    Throw(_) => false
  }
  let c2 = handle {
    let _ = parse_program(lex("let f: () -> (Int, Int) = () -> { let g: (Int) -> (Int, Int) = (idx) -> { (idx, idx) } g(1) }"))
    true
  } with Exception {
    Throw(_) => false
  }
  let c3 = handle {
    let _ = parse_program(lex("let f: () -> (Int, Int) = () -> { let g: (Int) -> (Int, Int) = (idx) -> { if true { (idx, idx) } else { (idx, idx) } } g(1) }"))
    true
  } with Exception {
    Throw(_) => false
  }
  assert(c1 && c2 && c3)
}

test "stmt_let_fn_array_return_with_multiple_params" {
  let ok = handle {
    let _ = parse_program(lex("let f: (Type, Type) -> Array[Type] = (a, b) -> { Array::slice([a, b], 0, 2) }"))
    true
  } with Exception {
    Throw(_) => false
  }
  assert(ok)
}
