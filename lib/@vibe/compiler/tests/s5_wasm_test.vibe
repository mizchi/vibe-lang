//# Imports

import @vibe/compiler/codegen {
  compile_wasi_module
}

import @vibe/core {
  array_empty
}

import ./s5_test_support.vibe {
  load_merged
}

//# Misc

/// Consolidated from s5_wasm_test / s5_size_test / s5_determinism_test
/// (2026-07, CI wall-time review): each independently re-parsed the whole
/// compiler source (load_merged) and fully self-compiled it to the
/// same "_start" entry, just to check a different narrow property of the
/// same output -- 4 full self-compiles total (wasm_test 1, size_test 1,
/// determinism_test 2) doing genuinely duplicate work. Lazily memoize each
/// compile behind a module-level cache cell (fixtures/module_let_memo_test.vibe:
/// module state persists across every test in this file), computed on first
/// use and shared by whichever tests need it -- cutting this to the 2
/// compiles determinism actually needs (proving determinism requires two
/// independent compiles to compare; one alone can't) while every other
/// assertion below reuses the first one for free.
let s5_cache1 = array_empty()
let s5_cache2 = array_empty()

fn s5_bytes1() -> Bytes with Exception + Fs {
  if Array::length(s5_cache1) == 0 {
    Array::push(s5_cache1, compile_wasi_module(load_merged(), "_start"))
  } else {
    ()
  }
  Array::get(s5_cache1, 0)
}

fn s5_bytes2() -> Bytes with Exception + Fs {
  if Array::length(s5_cache2) == 0 {
    Array::push(s5_cache2, compile_wasi_module(load_merged(), "_start"))
  } else {
    ()
  }
  Array::get(s5_cache2, 0)
}

test "S5: compile merged stmts to WASM" {
  let bytes = s5_bytes1()
  assert(Bytes::get(bytes, 0) == 0)
  assert(Bytes::get(bytes, 1) == 97)
  assert(Bytes::get(bytes, 2) == 115)
  assert(Bytes::get(bytes, 3) == 109)
  assert(Bytes::length(bytes) > 1000)
}

/// #897 follow-up: bounds refreshed AGAIN -- same class of staleness #769
/// already documented once (see the history above), now hitting the other
/// direction. The #897 top-level lib/@vibe/compiler/ vpkg migration (this
/// series) progressively consolidated many per-file compiler_sources_manifest.tsv
/// rows into single directory facade (`index.vpkg`) rows as each subdirectory
/// (and finally the compiler's own top level) got its contract boundary --
/// module_loader_collect_sources_test.vibe's own assertions document the same
/// shift ("codegen/wasi is now a contract package -- it arrives as its facade,
/// not a separate linked_compile.vibe row"). That shrinks this test's
/// STATIC-bundle self-compile (compiler_sources_bundle.vibe + this file's
/// load_merged) from the ~9MB observed on 2026-07-10 down to ~1.4MB (measured
/// directly: 1,444,540 bytes, reproduced identically both before and after the
/// #897 top-level batch's cli_probe_entry.vibe/coverage_suite_run.vibe fixes,
/// so it is NOT a side effect of those -- a pure manifest-consolidation
/// artifact of this migration series). Confirmed non-broken, not just
/// "smaller": the sibling "S5: compile merged stmts to WASM" test (real wasm
/// magic-byte check) and compiler_gate.sh's full stage0->1->2->3 self-hosting
/// fixpoint (a real compile+run, not a static bundle) both stay green.
/// Lower floor moved to keep a wide envelope with headroom under the new
/// baseline rather than pinning it exactly, same philosophy as #769's fix.
test "S5: check WASM output size (sanity envelope)" {
  let len = Bytes::length(s5_bytes1())
  assert(len > 800000)
  assert(len < 32000000)
}

test "S5: deterministic output (two compiles match)" {
  let bytes1 = s5_bytes1()
  let bytes2 = s5_bytes2()
  assert(Bytes::length(bytes1) == Bytes::length(bytes2))
  let mut i = 0
  while i < 100 {
    assert(bytes1[i] == bytes2[i])
    i = i + 1
  }
}
