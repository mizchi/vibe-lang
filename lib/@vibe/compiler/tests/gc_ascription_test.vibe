import @vibe/compiler/entry/source_compile/gc_only {
  compile_source_gc_only
}

test "GC emits the same module for a checked local annotation" {
  let plain = compile_source_gc_only(source = "fn source() -> Int { 42 } export fn answer() -> Int { let x = source(); x }", entry_name = "answer")
  let annotated = compile_source_gc_only(source = "fn source() -> Int { 42 } export fn answer() -> Int { let x: Int = source(); x }", entry_name = "answer")
  assert(Bytes::length(plain) > 0)
  assert(plain == annotated)
}

test "GC erases repeated and mutable annotation calls together" {
  let plain = compile_source_gc_only(source = "fn source() -> Int { 21 } export fn answer() -> Int { let mut a = source(); let b = source(); a = a + b; a }", entry_name = "answer")
  let annotated = compile_source_gc_only(source = "fn source() -> Int { 21 } export fn answer() -> Int { let mut a: Int = source(); let b: Int = source(); a = a + b; a }", entry_name = "answer")
  assert(Bytes::length(plain) > 0)
  assert(plain == annotated)
}
