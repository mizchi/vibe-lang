//# Imports

import @vibe/compiler/core {
  Subst, Type, occurs_in, subst_apply, subst_lookup, types_equal, unify
}

import @vibe/core {
  array_empty
}

//# Functions

fn is_none(_ opt: Option[Subst]) -> Bool {
  match opt {
    Some(_) => false,
    None => true
  }
}

fn is_some(_ opt: Option[Subst]) -> Bool {
  match opt {
    Some(_) => true,
    None => false
  }
}

let empty_bounds: Array[(Int, Array[String])] = array_empty()

//# Misc

test "unify Int with Int" {
  let result = unify(a = CtInt, b = CtInt, s = SubstEmpty)
  assert(is_some(result))
}

test "unify Int with String fails" {
  let result = unify(a = CtInt, b = CtString, s = SubstEmpty)
  assert(is_none(result))
}

test "unify Bool with Bool" {
  let result = unify(a = CtBool, b = CtBool, s = SubstEmpty)
  assert(is_some(result))
}

test "unify CtVar with Int binds var" {
  let result = unify(a = CtVar(0), b = CtInt, s = SubstEmpty)
  assert(is_some(result))
  match result {
    Some(s) => {
      let resolved = subst_apply(s = s, ty = CtVar(0))
      assert(types_equal(a = resolved, b = CtInt))
    },
    None => assert(false)
  }
}

test "unify Int with CtVar binds var" {
  let result = unify(a = CtInt, b = CtVar(0), s = SubstEmpty)
  assert(is_some(result))
  match result {
    Some(s) => {
      let resolved = subst_apply(s = s, ty = CtVar(0))
      assert(types_equal(a = resolved, b = CtInt))
    },
    None => assert(false)
  }
}

test "unify CtArray(Int) with CtArray(Int)" {
  let result = unify(a = CtArray(CtInt), b = CtArray(CtInt), s = SubstEmpty)
  assert(is_some(result))
}

test "unify CtArray(Int) with CtArray(String) fails" {
  let result = unify(a = CtArray(CtInt), b = CtArray(CtString), s = SubstEmpty)
  assert(is_none(result))
}

test "unify CtFn([Int], String) with CtFn([Int], String)" {
  let result = unify(a = CtFn([CtInt], CtString, None), b = CtFn([CtInt], CtString, None), s = SubstEmpty)
  assert(is_some(result))
}

test "unify CtFn([Int], String) with CtFn([Bool], String) fails" {
  let result = unify(a = CtFn([CtInt], CtString, None), b = CtFn([CtBool], CtString, None), s = SubstEmpty)
  assert(is_none(result))
}

test "unify CtTuple([Int, String]) with CtTuple([Int, String])" {
  let result = unify(a = CtTuple([CtInt, CtString]), b = CtTuple([
    CtInt,
    CtString
  ]), s = SubstEmpty)
  assert(is_some(result))
}

test "unify CtTuple([Int, String]) with CtTuple([Bool, String]) fails" {
  let result = unify(a = CtTuple([CtInt, CtString]), b = CtTuple([
    CtBool,
    CtString
  ]), s = SubstEmpty)
  assert(is_none(result))
}

test "unify CtEnum(Foo) with CtEnum(Foo)" {
  let result = unify(a = CtEnum("Foo"), b = CtEnum("Foo"), s = SubstEmpty)
  assert(is_some(result))
}

test "unify CtEnum(Foo) with CtEnum(Bar) fails" {
  let result = unify(a = CtEnum("Foo"), b = CtEnum("Bar"), s = SubstEmpty)
  assert(is_none(result))
}

test "unify CtStruct(Foo) with CtStruct(Foo)" {
  let result = unify(a = CtStruct("Foo"), b = CtStruct("Foo"), s = SubstEmpty)
  assert(is_some(result))
}

test "unify CtStruct(Foo) with CtStruct(Bar) fails" {
  let result = unify(a = CtStruct("Foo"), b = CtStruct("Bar"), s = SubstEmpty)
  assert(is_none(result))
}

test "unify CtNamed(X, [Int]) with CtNamed(X, [Int])" {
  let result = unify(a = CtNamed("X", [CtInt]), b = CtNamed("X", [CtInt]), s = SubstEmpty)
  assert(is_some(result))
}

test "unify CtNamed(X, [Int]) with CtNamed(X, [String]) fails" {
  let result = unify(a = CtNamed("X", [CtInt]), b = CtNamed("X", [CtString]), s = SubstEmpty)
  assert(is_none(result))
}

test "unify CtNamed(X, [Int]) with CtNamed(Y, [Int]) fails" {
  let result = unify(a = CtNamed("X", [CtInt]), b = CtNamed("Y", [CtInt]), s = SubstEmpty)
  assert(is_none(result))
}

test "unify CtOption(Int) with CtOption(Int)" {
  let result = unify(a = CtOption(CtInt), b = CtOption(CtInt), s = SubstEmpty)
  assert(is_some(result))
}

test "unify CtOption(Int) with CtOption(String) fails" {
  let result = unify(a = CtOption(CtInt), b = CtOption(CtString), s = SubstEmpty)
  assert(is_none(result))
}

test "unify CtEnum with CtStruct fails" {
  let result = unify(a = CtEnum("Foo"), b = CtStruct("Foo"), s = SubstEmpty)
  assert(is_none(result))
}

test "unify CtEnum with CtInt fails" {
  let result = unify(a = CtEnum("Foo"), b = CtInt, s = SubstEmpty)
  assert(is_none(result))
}

test "unify CtForAll body with concrete type" {
  // forall a. (a) -> a  unified with  (Int) -> Int
  let forall_ty = CtForAll([0], empty_bounds, CtFn([CtVar(0)], CtVar(0), None))
  let concrete = CtFn([CtInt], CtInt, None)
  let result = unify(a = forall_ty, b = concrete, s = SubstEmpty)
  assert(is_some(result))
}

test "unify two CtForAll with same structure" {
  // forall a. (a) -> a  unified with  forall b. (b) -> b
  let fa = CtForAll([0], empty_bounds, CtFn([CtVar(0)], CtVar(0), None))
  let fb = CtForAll([1], empty_bounds, CtFn([CtVar(1)], CtVar(1), None))
  let result = unify(a = fa, b = fb, s = SubstEmpty)
  assert(is_some(result))
}

test "unify CtForAll with incompatible type" {
  // forall a. (a) -> a  cannot unify with  (Int) -> String
  let forall_ty = CtForAll([0], empty_bounds, CtFn([CtVar(0)], CtVar(0), None))
  let incompatible = CtFn([CtInt], CtString, None)
  let result = unify(a = forall_ty, b = incompatible, s = SubstEmpty)
  assert(is_none(result))
}

test "unify concrete with CtForAll (symmetric)" {
  // (Int) -> Int  unified with  forall a. (a) -> a
  let concrete = CtFn([CtInt], CtInt, None)
  let forall_ty = CtForAll([0], empty_bounds, CtFn([CtVar(0)], CtVar(0), None))
  let result = unify(a = concrete, b = forall_ty, s = SubstEmpty)
  assert(is_some(result))
}

test "unify CtVar already bound resolves chain" {
  // var(0) -> var(1) -> Int, then unify var(0) with Int
  let s0 = SubstBind(0, CtVar(1), SubstEmpty)
  let s1 = SubstBind(1, CtInt, s0)
  let result = unify(a = CtVar(0), b = CtInt, s = s1)
  assert(is_some(result))
}

test "unify CtOption(CtVar) with CtOption(CtInt)" {
  let result = unify(a = CtOption(CtVar(0)), b = CtOption(CtInt), s = SubstEmpty)
  assert(is_some(result))
  match result {
    Some(s) => {
      let resolved = subst_apply(s = s, ty = CtVar(0))
      assert(types_equal(a = resolved, b = CtInt))
    },
    None => assert(false)
  }
}

test "unify CtEnum with bare CtNamed bridges (#492)" {
  // A self-referential enum ctor field type can resolve to CtEnum(X) while a
  // function annotation resolves to CtNamed(X, []) across module imports;
  // they denote the same type and must unify (both directions).
  let no_args = array_empty()
  let one_arg = Array::slice([CtInt], start = 0, end = 1)
  assert(is_some(unify(a = CtEnum("TomlValue"), b = CtNamed("TomlValue", no_args), s = SubstEmpty)))
  assert(is_some(unify(a = CtNamed("TomlValue", no_args), b = CtEnum("TomlValue"), s = SubstEmpty)))
  // Wrapped in Array, mirroring `Array[TomlValue]` return types.
  assert(is_some(unify(a = CtArray(CtEnum("TomlValue")), b = CtArray(CtNamed("TomlValue", no_args)), s = SubstEmpty)))
  // Struct bridges too (zero-arity).
  assert(is_some(unify(a = CtStruct("Point"), b = CtNamed("Point", no_args), s = SubstEmpty)))
  // Parametric enums (#517): an enum VALUE carries no type args, so CtEnum(X)
  // bridges with an applied CtNamed(X, args) of ANY arity (e.g. a bare `Result`
  // ctor value unifying with a `Result[U, E]` annotation), both directions.
  assert(is_some(unify(a = CtEnum("Box"), b = CtNamed("Box", one_arg), s = SubstEmpty)))
  assert(is_some(unify(a = CtNamed("Box", one_arg), b = CtEnum("Box"), s = SubstEmpty)))
  // Different names must NOT bridge.
  assert(is_none(unify(a = CtEnum("A"), b = CtNamed("B", no_args), s = SubstEmpty)))
}

test "occurs check prevents infinite type" {
  // unify var(0) with (var(0)) -> Int  should fail
  let result = unify(a = CtVar(0), b = CtFn([CtVar(0)], CtInt, None), s = SubstEmpty)
  assert(is_none(result))
}

test "occurs_in detects variable in function type" {
  assert(occurs_in(id = 0, ty = CtFn([CtVar(0)], CtInt, None)))
  assert(occurs_in(id = 0, ty = CtFn([CtInt], CtVar(0), None)))
  assert(not(occurs_in(id = 1, ty = CtFn([CtVar(0)], CtInt, None))))
}
