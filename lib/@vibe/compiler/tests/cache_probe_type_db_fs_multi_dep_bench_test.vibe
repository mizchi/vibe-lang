//# Imports

import ../_selfbuild_gate_block_a.vibe {
  selfbuild_probe_type_db_fs_multi_dep_parse_counts
}

//# Misc

test "bench: TypeDb fs multi-dep persistent dep cache" {
  let encoded = selfbuild_probe_type_db_fs_multi_dep_parse_counts()
  let count1 = encoded / 1000
  let count2 = encoded % 1000
  assert(eq(count1, 6))
  assert(eq(count2, 0))
}
