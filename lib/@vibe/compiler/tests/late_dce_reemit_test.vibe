import @vibe/compiler/codegen/wasi {
  late_dce_prune_module
}

//# Functions

fn leb_at(b: Bytes, p: Int) -> (Int, Int) {
  let mut r = 0
  let mut shift = 0
  let mut q = p
  let mut done = false
  while !done {
    let x = Bytes::get(b, q)
    q = q + 1
    r = r|((x&127)<<shift)
    shift = shift + 7
    if x < 128 {
      done = true
    } else {
      ()
    }
  }
  (r, q)
}

/// Entry count of the function section (id 3), or -1 without one.
fn function_count(m: Bytes) -> Int {
  let mut p = 8
  let mut found = 0 - 1
  while found < 0 && p < Bytes::length(m) {
    let sid = Bytes::get(m, p)
    let (n, body) = leb_at(m, p + 1)
    if sid == 3 {
      let (c, _) = leb_at(m, body)
      found = c
    } else {
      ()
    }
    p = body + n
  }
  found
}

/// First byte at which the two differ, or -1 when they are equal.
fn first_diff(a: Bytes, b: Bytes) -> Int {
  let n = if Bytes::length(a) < Bytes::length(b) {
    Bytes::length(a)
  } else {
    Bytes::length(b)
  }
  let mut i = 0
  let mut d = 0 - 1
  while d < 0 && i < n {
    if Bytes::get(a, i) != Bytes::get(b, i) {
      d = i
    } else {
      ()
    }
    i = i + 1
  }
  if d < 0 && Bytes::length(a) != Bytes::length(b) {
    n
  } else {
    d
  }
}

// A hand-built module with every section the re-emit rewrites: `main`
// (exported) calls function 2; function 1 is dead and its body is 132 bytes,
// so the code section and the dead body both carry two-byte LEB128 sizes;
// a funcref table with an active element segment naming function 2; a
// custom section "x" that must be copied as-is; and a "name" section whose
// function-name subsection names all three (the last name is 130 bytes, a
// two-byte length). The expected module is the same one assembled by hand
// with function 1 gone and function 2 renumbered to 1 everywhere: the
// `call` immediate, the element segment, and the name entries (the dead
// function's entry dropped).
//
// The re-emit writes each section behind a length its sizing walk computed,
// so a size that disagrees with the bytes written shows up here as an
// unchanged module (the pruner refuses), not as a subtly wrong one.
