//# Imports

// #2523: a MARKER comparison trait -- an `Eq` or `Ord` declared with no
// methods -- gives a `[T: Eq]` bound's `==` no dictionary to dispatch through,
// so it lowers to the builtin comparison. That is correct for the scalars that
// are tagged immediates or byte strings (`Int`, `Bool`, `Char`, `String`), and
// REFERENCE identity for anything else. The builtin `Eq` is no longer a marker
// (the checker registers it with `equals`), so these rows declare their own;
// the prelude's `Ord` still is one.
//
// Both ways a program could reach for it ended badly. `derive (Eq)` alone did
// not satisfy the bound (`no impl `Eq` for `Pt``); adding `impl Eq for Pt`
// replaced that error with a wrong answer. Measured on the production
// linear/RC lane with `fn bare[T: Eq](x: T, y: T) { x == y }`:
//
//   bare(1, 1)                       true    (correct)
//   bare(p1, p2)  equal, distinct    FALSE   (reference identity)
//   bare(p1, p3)  different          false
//   bare(p1, p1)  same object        TRUE    (reference identity)
//   p1 == p2      concrete site      true    (correct, structural)
//
// What is refused is the BOUND at this instantiation, not the impl: the impl
// stays a legal declaration (a marker impl can be a tag) and the concrete site
// keeps answering by content. Giving `Eq` an `equals(Self, Self) -> Bool`
// method makes it dispatch through a witness dictionary (ADR-0097).
//
// #3327: a bound that EXTENDS a marker (`trait Key: Eq {}`) is judged as that
// marker. It used to be read by its own name only and compared by reference.
//
// #3350: the question is whether the operator reaches a witness, not whether
// the trait is a marker. An `Eq` whose methods are something else, any `Ord`
// or `Add`, and a generic impl's parameter bound are judged the same way.

import @vibe/compiler/checker {
  check_program
}

import @vibe/compiler/syntax {
  lex, parse_program
}

//# Functions

fn diags_of(src: String) -> String {
  handle {
    let _ = check_program(parse_program(lex(src)))
    ""
  } with { Exception::Throw(msg) => msg }
}

fn rejects(src: String) -> Bool {
  String::length(diags_of(src)) > 0
}

/// A marker `Eq` with the builtin's scalar impls, a declared aggregate that
/// also has one, and a bounded generic that compares.
let eq_prelude = "trait Eq\nimpl Eq for Int\nimpl Eq for String\nstruct Pt {\n  v: Int\n}\nimpl Eq for Pt\nfn bare[T: Eq](x: T, y: T) -> Bool {\n  x == y\n}\n"

/// #3327: the same marker `Eq`, reached only through a methodless subtrait
/// `Key`, with impls of both at the scalars, at `Double` and at a struct.
let key_prelude = "trait Eq\ntrait Key: Eq\nimpl Eq for Int\nimpl Key for Int\nimpl Eq for String\nimpl Key for String\nimpl Eq for Double\nimpl Key for Double\nstruct Pt {\n  v: Int\n}\nimpl Eq for Pt\nimpl Key for Pt\nfn same[T: Key](x: T, y: T) -> Bool {\n  x == y\n}\n"

//# Tests

test "a marker Eq bound at a declared struct is refused" {
  inspect(rejects(String::concat(eq_prelude, "let r = bare(Pt::{ v: 1 }, Pt::{ v: 1 })\n")), "true")
}

test "the refusal names the edit, not just the missing impl" {
  let msg = diags_of(String::concat(eq_prelude, "let r = bare(Pt::{ v: 1 }, Pt::{ v: 1 })\n"))
  inspect(String::contains(msg, "is a marker trait (declared with no methods)"), "true")
  inspect(String::contains(msg, "compare `Pt` by REFERENCE"), "true")
  inspect(String::contains(msg, "Give `Eq` an `equals(Self, Self) -> Bool` method"), "true")
}

test "the same bound at a scalar is accepted" {
  inspect(rejects(String::concat(eq_prelude, "let r = bare(1, 1)\n")), "false")
  inspect(rejects(String::concat(eq_prelude, "let r = bare(\"a\", \"a\")\n")), "false")
}

// #2895: `Double` is NOT one of them. It carries a marker impl like the other
// four and so read as safe, while being the exact failure this guard exists to
// prevent. Measured on the committed seed and on a stage2 from this branch,
// identical both ways: `bare[T: Eq](1.5, 1.5)` answered FALSE (and so did
// `bare(0.0, 0.0)`) while the concrete `1.5 == 1.5` answered true, and under
// `[T: Ord]` both `lt(2.5, 1.5)` and `gt(2.5, 1.5)` answered as if the operands
// were addresses -- `true` and `false` respectively, which is wrong in both
// directions at once.
//
// A `Double` is not a tagged immediate the way an `Int` is, so the raw
// comparison the erased bound falls back to reads the box, not the number.
test "an Eq bound at Double is refused, because it answered FALSE for two equal ones" {
  inspect(rejects(String::concat("trait Eq\nimpl Eq for Double\nfn bare[T: Eq](x: T, y: T) -> Bool {\n  x == y\n}\n", "let r = bare(1.5, 1.5)\n")), "true")
}

test "an Ord bound at Double is refused too" {
  inspect(rejects("trait Ord\nimpl Ord for Double\nfn lt[T: Ord](x: T, y: T) -> Bool {\n  x < y\n}\nlet r = lt(2.5, 1.5)\n"), "true")
}

test "a concrete Double comparison is untouched" {
  inspect(rejects("let a = 1.5\nlet b = 1.5\nlet r = a == b\nlet t = a < b\n"), "false")
}

test "a concrete == on the same struct still checks clean" {
  inspect(rejects(String::concat(eq_prelude, "let a = Pt::{ v: 1 }\nlet b = Pt::{ v: 1 }\nlet r = a == b\n")), "false")
}

test "the impl on its own is still a legal declaration" {
  inspect(rejects(eq_prelude), "false")
}

test "an Eq that carries equals(Self, Self) -> Bool is left alone" {
  // The ADR-0097 shape: a real witness dictionary, so the bound is sound and
  // this guard must not fire.
  let src = "trait Eq {\n  equals(Self, Self) -> Bool\n}\nstruct Pt {\n  v: Int\n}\nimpl Eq for Pt {\n  equals(a: Pt, b: Pt) -> Bool {\n    a.v == b.v\n  }\n}\nfn bare[T: Eq](x: T, y: T) -> Bool {\n  T::equals(x, y)\n}\nlet r = bare(Pt::{ v: 1 }, Pt::{ v: 1 })\n"
  inspect(rejects(src), "false")
}

test "a marker Ord bound at a declared struct is refused too" {
  let src = "trait Ord\nimpl Ord for Int\nstruct Token {\n  value: Int\n}\nimpl Ord for Token\nfn smaller[T: Ord](a: T, b: T) -> Bool {\n  a < b\n}\nlet r = smaller(Token::{ value: 1 }, Token::{ value: 2 })\n"
  inspect(rejects(src), "true")
}

test "a non-comparison marker trait is untouched" {
  // `Sealed` is a tag: its bound never lowers to `==` or `<`, so nothing about
  // it can be silently wrong and this guard has no business refusing it.
  let src = "trait Sealed\nstruct Pt {\n  v: Int\n}\nimpl Sealed for Pt\nfn tagged[T: Sealed](x: T) -> Int {\n  0\n}\nlet r = tagged(Pt::{ v: 1 })\n"
  inspect(rejects(src), "false")
}

test "an Ord refusal does not advise giving Ord a method" {
  // `<` on an erased formal has no witness to dispatch through, so a method on
  // the program's `Ord` would stand the guard down and leave `<` comparing by
  // reference (#3327).
  let src = "trait Ord\nimpl Ord for Int\nstruct Token {\n  value: Int\n}\nimpl Ord for Token\nfn smaller[T: Ord](a: T, b: T) -> Bool {\n  a < b\n}\nlet r = smaller(Token::{ value: 1 }, Token::{ value: 2 })\n"
  let msg = diags_of(src)
  inspect(String::contains(msg, "giving `Ord` a method would not help"), "true")
  inspect(String::contains(msg, "at least one method"), "false")
}

test "a marker Eq bound at a struct with no impl does not claim one is declared" {
  let src = "trait Eq\nstruct Pt {\n  v: Int\n}\nfn bare[T: Eq](x: T, y: T) -> Bool {\n  x == y\n}\nlet r = bare(Pt::{ v: 1 }, Pt::{ v: 1 })\n"
  let msg = diags_of(src)
  inspect(String::contains(msg, "declaring `impl Eq for Pt` would not help"), "true")
  inspect(String::contains(msg, "IS declared"), "false")
}

// #3327: a bound that EXTENDS a marker comparison trait. Measured on main at
// 5f4de5023, every refused shape below checked clean and answered `false` for
// two equal values at run time.
test "a subtrait of a marker Eq is refused at a declared struct" {
  let msg = diags_of(String::concat(key_prelude, "let r = same(Pt::{ v: 1 }, Pt::{ v: 1 })\n"))
  inspect(String::contains(msg, "no impl `Eq` for `Pt` (`Key` extends `Eq`)"), "true")
  inspect(String::contains(msg, "compare `Pt` by REFERENCE"), "true")
  inspect(String::contains(msg, "Give `Eq` an `equals(Self, Self) -> Bool` method"), "true")
}

test "a subtrait of a marker Eq is refused at Double" {
  inspect(rejects(String::concat(key_prelude, "let r = same(1.5, 1.5)\n")), "true")
}

test "a subtrait of a marker Eq is accepted at a by-value scalar" {
  inspect(rejects(String::concat(key_prelude, "let r = same(1, 1)\n")), "false")
  inspect(rejects(String::concat(key_prelude, "let r = same(\"a\", \"a\")\n")), "false")
}

test "the supertrait chain is followed" {
  let src = "trait Eq\ntrait A: Eq\ntrait B: A\nstruct Pt {\n  v: Int\n}\nimpl Eq for Pt\nimpl A for Pt\nimpl B for Pt\nfn same[T: B](x: T, y: T) -> Bool {\n  x == y\n}\nlet r = same(Pt::{ v: 1 }, Pt::{ v: 1 })\n"
  inspect(String::contains(diags_of(src), "no impl `Eq` for `Pt` (`B` extends `Eq`)"), "true")
}

test "a method of the subtrait's own does not make its marker parent compare" {
  // `KeyDict` carries `key_of` and nothing `==` can dispatch through, so the
  // comparison still lowers to the builtin one.
  let src = "trait Eq\ntrait Key: Eq {\n  key_of(Self) -> Int\n}\nstruct Pt {\n  v: Int\n}\nimpl Eq for Pt\nimpl Key for Pt {\n  key_of(a: Pt) -> Int {\n    a.v\n  }\n}\nfn same[T: Key](x: T, y: T) -> Bool {\n  x == y\n}\nlet r = same(Pt::{ v: 1 }, Pt::{ v: 1 })\n"
  inspect(rejects(src), "true")
}

test "a subtrait that declares equals(Self, Self) -> Bool is accepted" {
  // `==` dispatches through that method -- measured correct before #3327 --
  // so the marker parent is not what compares.
  let src = "trait Eq\ntrait Key: Eq {\n  equals(Self, Self) -> Bool\n}\nstruct Pt {\n  v: Int\n}\nimpl Eq for Pt\nimpl Key for Pt {\n  equals(a: Pt, b: Pt) -> Bool {\n    a.v == b.v\n  }\n}\nfn same[T: Key](x: T, y: T) -> Bool {\n  x == y\n}\nlet r = same(Pt::{ v: 1 }, Pt::{ v: 1 })\n"
  inspect(rejects(src), "false")
}

test "an equals of another shape on the subtrait is no witness" {
  // The desugar dispatches only through `(Self, Self) -> Bool`
  // (fixtures/eq_bound_witness_shape_test.vibe).
  let src = "trait Eq\ntrait Key: Eq {\n  equals(Int, Int) -> Bool\n}\nstruct Pt {\n  v: Int\n}\nimpl Eq for Pt\nimpl Key for Pt {\n  equals(a: Int, b: Int) -> Bool {\n    true\n  }\n}\nfn same[T: Key](x: T, y: T) -> Bool {\n  x == y\n}\nlet r = same(Pt::{ v: 1 }, Pt::{ v: 1 })\n"
  inspect(rejects(src), "true")
}

/// Two supertraits that both declare `equals`, in the order `trait Key: <first>
/// + <second> + Eq {}`: the flattened dictionary keeps the FIRST one.
fn two_equals_src(first: String, second: String, body: String) -> String {
  let traits = "trait Eq\ntrait Good {\n  equals(Self, Self) -> Bool\n}\ntrait Bad {\n  equals(Int, Int) -> Bool\n}\n"
  let key = String::concat("trait Key: ", String::concat(first, String::concat(" + ", String::concat(second, " + Eq\n"))))
  let rest = String::concat("struct Pt {\n  v: Int\n}\nimpl Eq for Pt\nimpl Key for Pt {\n", String::concat(body, "}\nfn same[T: Key](x: T, y: T) -> Bool {\n  x == y\n}\nlet r = same(Pt::{ v: 1 }, Pt::{ v: 1 })\n"))
  String::concat(traits, String::concat(key, rest))
}

test "the witness is the flattened dictionary's first equals: Good first is accepted" {
  // Codex on #3349: the flattening keeps `Good`'s `equals(Self, Self)` and
  // drops `Bad`'s by name, so `==` dispatches through `Good`'s. A scan of the
  // whole closure refused this bound for the `equals` the dictionary drops.
  inspect(rejects(two_equals_src("Good", "Bad", "  equals(a: Pt, b: Pt) -> Bool {\n    a.v == b.v\n  }\n")), "false")
}

test "the witness is the flattened dictionary's first equals: Bad first is refused" {
  // Here the kept `equals` is `Bad`'s `(Int, Int)`, which `==` does not call,
  // so the comparison would fall back to the builtin one.
  inspect(rejects(two_equals_src("Bad", "Good", "  equals(a: Int, b: Int) -> Bool {\n    true\n  }\n")), "true")
}

test "a subtrait of the builtin Eq is untouched" {
  // The builtin `Eq` carries `equals`, and a methodless subtrait dispatches
  // through it (fixtures/eq_bound_inherited_methodless_witness_test.vibe).
  let src = "trait Key: Eq\nstruct Pt {\n  v: Int\n} derive (Eq)\nimpl Key for Pt\nfn same[T: Key](x: T, y: T) -> Bool {\n  x == y\n}\nlet r = same(Pt::{ v: 1 }, Pt::{ v: 1 })\n"
  inspect(rejects(src), "false")
}

test "a subtrait of the prelude's marker Ord is refused at a struct" {
  let src = "trait Ordered: Ord\nstruct Token {\n  value: Int\n}\nimpl Ord for Token\nimpl Ordered for Token\nfn keep[T: Ordered](a: T) -> T {\n  a\n}\nlet r = keep(Token::{ value: 1 })\n"
  inspect(String::contains(diags_of(src), "no impl `Ord` for `Token` (`Ordered` extends `Ord`)"), "true")
}

test "a subtrait of a non-comparison marker is untouched" {
  let src = "trait Sealed\ntrait Tagged: Sealed\nstruct Pt {\n  v: Int\n}\nimpl Sealed for Pt\nimpl Tagged for Pt\nfn tagged[T: Tagged](x: T) -> Int {\n  0\n}\nlet r = tagged(Pt::{ v: 1 })\n"
  inspect(rejects(src), "false")
}

// #3350: the guard asks whether the operator reaches a witness, not whether
// the trait is a marker. Measured on the #3327 compiler (43ee1c792), every
// refused shape below checked clean and answered by reference at run time.
test "an Eq whose methods do not include equals(Self, Self) is refused at a struct" {
  let src = "trait Eq {\n  tag(Self) -> Int\n}\nstruct Pt {\n  v: Int\n}\nimpl Eq for Pt {\n  tag(a: Pt) -> Int {\n    a.v\n  }\n}\nfn same[T: Eq](x: T, y: T) -> Bool {\n  x == y\n}\nlet r = same(Pt::{ v: 1 }, Pt::{ v: 1 })\n"
  let msg = diags_of(src)
  inspect(String::contains(msg, "`Eq` declares no `equals(Self, Self) -> Bool`"), "true")
  inspect(String::contains(msg, "marker trait"), "false")
}

test "the same Eq is accepted at a by-value scalar" {
  let src = "trait Eq {\n  tag(Self) -> Int\n}\nimpl Eq for Int {\n  tag(a: Int) -> Int {\n    a\n  }\n}\nfn same[T: Eq](x: T, y: T) -> Bool {\n  x == y\n}\nlet r = same(1, 1)\n"
  inspect(rejects(src), "false")
}

test "an Ord with a method is refused at a struct" {
  let src = "trait Ord {\n  rank(Self) -> Int\n}\nstruct Token {\n  value: Int\n}\nimpl Ord for Token {\n  rank(a: Token) -> Int {\n    a.value\n  }\n}\nfn smaller[T: Ord](a: T, b: T) -> Bool {\n  a < b\n}\nlet r = smaller(Token::{ value: 2 }, Token::{ value: 1 })\n"
  inspect(String::contains(diags_of(src), "`<` on the erased type has no witness to dispatch through"), "true")
}

test "an Add with a method is refused at Double" {
  let src = "trait Add {\n  plus(Self, Self) -> Self\n}\nimpl Add for Double {\n  plus(a: Double, b: Double) -> Double {\n    a + b\n  }\n}\nfn add2[T: Add](a: T, b: T) -> T {\n  a + b\n}\nlet r = add2(1.5, 2.25)\n"
  inspect(String::contains(diags_of(src), "no impl `Add` for `Double`"), "true")
}

/// A marker `Eq` and a generic impl of `Same` whose parameter is bounded by
/// `bound`; the caller appends the instantiation.
fn generic_impl_src(bound: String) -> String {
  let head = "trait Eq\ntrait Key: Eq\nimpl Eq for Int\nimpl Key for Int\nstruct Pt {\n  v: Int\n}\nimpl Eq for Pt\nimpl Key for Pt\ntrait Same {\n  same(Self, Self) -> Bool\n}\nstruct Box[T] {\n  v: T\n}\n"
  let imp = String::concat("impl [T: ", String::concat(bound, "] Same for Box[T] {\n  same(a: Box[T], b: Box[T]) -> Bool {\n    a.v == b.v\n  }\n}\nfn f[U: Same](a: U, b: U) -> Bool {\n  U::same(a, b)\n}\n"))
  String::concat(head, imp)
}

test "a generic impl's comparison bound is refused at a struct argument" {
  let msg = diags_of(String::concat(generic_impl_src("Eq"), "let r = f(Box::{ v: Pt::{ v: 1 } }, Box::{ v: Pt::{ v: 1 } })\n"))
  inspect(String::contains(msg, "no impl `Same` for `Box[Pt]` (its generic impl needs `Pt: Eq`)"), "true")
}

test "a generic impl's subtrait bound is refused the same way" {
  let msg = diags_of(String::concat(generic_impl_src("Key"), "let r = f(Box::{ v: Pt::{ v: 1 } }, Box::{ v: Pt::{ v: 1 } })\n"))
  inspect(String::contains(msg, "(its generic impl needs `Pt: Key`, and `Key` extends `Eq`)"), "true")
}

test "a direct call of the generic impl's method is refused too" {
  inspect(rejects(String::concat(generic_impl_src("Eq"), "let r = Same::same(Box::{ v: Pt::{ v: 1 } }, Box::{ v: Pt::{ v: 1 } })\n")), "true")
}

test "a generic impl's comparison bound still applies at a by-value scalar" {
  inspect(rejects(String::concat(generic_impl_src("Eq"), "let r = f(Box::{ v: 1 }, Box::{ v: 1 })\n")), "false")
}

test "over the builtin Eq, a wrong-shaped first equals is refused and named" {
  let src = "trait Good {\n  equals(Self, Self) -> Bool\n}\ntrait Bad {\n  equals(Int, Int) -> Bool\n}\ntrait Key: Bad + Good + Eq\nstruct Pt {\n  v: Int\n}\nimpl Key for Pt {\n  equals(a: Int, b: Int) -> Bool {\n    true\n  }\n}\nfn same[T: Key](x: T, y: T) -> Bool {\n  x == y\n}\nlet r = same(Pt::{ v: 1 }, Pt::{ v: 1 })\n"
  inspect(String::contains(diags_of(src), "witness dictionary keeps is `Bad`'s"), "true")
}

test "over the builtin Eq, a right-shaped first equals is accepted" {
  let src = "trait Good {\n  equals(Self, Self) -> Bool\n}\ntrait Bad {\n  equals(Int, Int) -> Bool\n}\ntrait Key: Good + Bad + Eq\nstruct Pt {\n  v: Int\n}\nimpl Key for Pt {\n  equals(a: Pt, b: Pt) -> Bool {\n    a.v == b.v\n  }\n}\nfn same[T: Key](x: T, y: T) -> Bool {\n  x == y\n}\nlet r = same(Pt::{ v: 1 }, Pt::{ v: 1 })\n"
  inspect(rejects(src), "false")
}
