//# Imports

import ./printer_test_support.vibe {
  roundtrip, roundtrip_eq
}

//# Misc

test "roundtrip if" {
  let ok = handle {
    roundtrip("if true { 1 } else { 2 }")
  } with Exception {
    Throw(_) => false
  }
  assert(ok)
}

test "roundtrip match" {
  let ok = handle {
    roundtrip("match x { 1 => true, _ => false }")
  } with Exception {
    Throw(_) => false
  }
  assert(ok)
}
