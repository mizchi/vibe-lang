//# Imports

import ./stmt_test_support.vibe {
  pp, ps
}

//# Misc

test "stmt_trait" {
  assert(ps("trait Show") == "trait Show")
}

test "stmt_type_alias" {
  assert(ps("type Name = String") == "type Name = String")
}

test "stmt_type_alias_exported" {
  assert(ps("export type Pair = (Int, String)") == "export type Pair = (Int, String)")
}

test "stmt_impl" {
  assert(pp("impl Show for Int") == "impl Show for Int")
}

test "stmt_impl_type_params_accepted" {
  // Generic impl headers are now supported (#492): `impl [A: Show] Show for Int`
  // parses (the printer renders the type-param names; bounds and target type
  // arguments are not round-tripped).
  let result = pp("impl [A: Show] Show for Int")
  assert(result == "impl [A] Show for Int")
}
