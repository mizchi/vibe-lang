//# Imports

import @vibe/compiler/core {
  Expr
}

import ../cst.vibe {
  CstChild, NodeKind
}

import ../lower.vibe {
  lower_expr
}

import @vibe/compiler/syntax {
  Token
}

//# Misc

test "lower EIf" {
  let node = CNode(NIfExpr, [
    CToken(TIf),
    CNode(NBoolExpr, [
      CToken(TIdent("true"))
    ]),
    CNode(NIntExpr, [
      CToken(TInt(1))
    ]),
    CToken(TElse),
    CNode(NIntExpr, [
      CToken(TInt(2))
    ])
  ])
  match lower_expr(node) {
    EIf(_, _, _) => assert(true),
    _ => assert(false)
  }
}

test "lower EIf no else" {
  let node = CNode(NIfExpr, [
    CToken(TIf),
    CNode(NBoolExpr, [
      CToken(TIdent("true"))
    ]),
    CNode(NIntExpr, [
      CToken(TInt(1))
    ])
  ])
  match lower_expr(node) {
    EIf(_, _, _) => assert(true),
    _ => assert(false)
  }
}

test "lower EMatch" {
  let node = CNode(NMatchExpr, [
    CToken(TMatch),
    CNode(NIdentExpr, [
      CToken(TIdent("x"))
    ]),
    CToken(TLBrace),
    CNode(NMatchArm, [
      CNode(NIntPat, [
        CToken(TInt(1))
      ]),
      CToken(TArrow),
      CNode(NStringExpr, [
        CToken(TString("one"))
      ])
    ]),
    CToken(TComma),
    CNode(NMatchArm, [
      CNode(NWildPat, [
        CToken(TIdent("_"))
      ]),
      CToken(TArrow),
      CNode(NStringExpr, [
        CToken(TString("other"))
      ])
    ]),
    CToken(TRBrace)
  ])
  match lower_expr(node) {
    EMatch(_, arms) => assert(Array::length(arms) == 2),
    _ => assert(false)
  }
}

test "lower EWhile" {
  let node = CNode(NWhileExpr, [
    CToken(TWhile),
    CNode(NBoolExpr, [
      CToken(TIdent("true"))
    ]),
    CNode(NIntExpr, [
      CToken(TInt(0))
    ])
  ])
  match lower_expr(node) {
    EWhile(_, _) => assert(true),
    _ => assert(false)
  }
}

test "lower EBreak none" {
  let node = CNode(NBreakExpr, [
    CToken(TBreak)
  ])
  match lower_expr(node) {
    EBreak(None) => assert(true),
    _ => assert(false)
  }
}

test "lower EBreak with value" {
  let node = CNode(NBreakExpr, [
    CToken(TBreak),
    CNode(NIntExpr, [
      CToken(TInt(42))
    ])
  ])
  match lower_expr(node) {
    EBreak(Some(_)) => assert(true),
    _ => assert(false)
  }
}

test "lower EContinue" {
  let node = CNode(NContinueExpr, [
    CToken(TContinue)
  ])
  match lower_expr(node) {
    EContinue(args) => assert(Array::length(args) == 0),
    _ => assert(false)
  }
}

test "lower NThrowExpr to perform Error::Throw" {
  // #640 Stage 3: NThrowExpr lowers to the Stage 2 parser desugar shape
  // (perform Error::Throw(expr)) instead of the retired EThrow node.
  let node = CNode(NThrowExpr, [
    CToken(TThrow),
    CNode(NStringExpr, [
      CToken(TString("err"))
    ])
  ])
  match lower_expr(node) {
    ECall(EIdent("perform", _), args, _) => {
      assert(Array::length(args) == 1)
      match Array::get(args, 0) {
        ECall(EIdent("Error::Throw", _), inner, _) => {
          assert(Array::length(inner) == 1)
          match Array::get(inner, 0) {
            EString(s) => assert(s == "err"),
            _ => assert(false)
          }
        },
        _ => assert(false)
      }
    },
    _ => assert(false)
  }
}

test "lower EForIn" {
  let node = CNode(NForInExpr, [
    CToken(TFor),
    CToken(TIdent("x")),
    CToken(TIn),
    CNode(NIdentExpr, [
      CToken(TIdent("xs"))
    ]),
    CNode(NIntExpr, [
      CToken(TInt(0))
    ])
  ])
  match lower_expr(node) {
    EForIn(name, None, _, _) => assert(name == "x"),
    _ => assert(false)
  }
}

test "lower indexed EForIn preserves index and value bindings" {
  let node = CNode(NForInExpr, [
    CToken(TFor),
    CToken(TIdent("i")),
    CToken(TComma),
    CToken(TIdent("x")),
    CToken(TIn),
    CNode(NIdentExpr, [
      CToken(TIdent("xs"))
    ]),
    CNode(NIntExpr, [
      CToken(TInt(0))
    ])
  ])
  match lower_expr(node) {
    EForIn(name, Some(index), _, _) => {
      assert(name == "x")
      assert(index == "i")
    },
    _ => assert(false)
  }
}
