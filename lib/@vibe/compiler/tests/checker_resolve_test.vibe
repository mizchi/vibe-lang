//# Imports

import @vibe/compiler/core {
  Expr, Pat, Stmt, Type, TypeDef, TypeExpr, types_equal
}

import @vibe/core {
  array_empty
}

import @vibe/compiler/checker {
  resolve_type_expr
}

//# Functions

fn empty_defs() -> Array[TypeDef] {
  array_empty()
}

//# Misc

test "resolve TyUnit" {
  let ty = resolve_type_expr(TyUnit, empty_defs())
  assert(types_equal(ty, CtUnit))
}

test "resolve TyName Int" {
  let ty = resolve_type_expr(TyName("Int"), empty_defs())
  assert(types_equal(ty, CtInt))
}

test "resolve TyName String" {
  let ty = resolve_type_expr(TyName("String"), empty_defs())
  assert(types_equal(ty, CtString))
}

test "resolve TyApp Array[Int]" {
  let ty = resolve_type_expr(TyApp("Array", [TyName("Int")]), empty_defs())
  assert(types_equal(ty, CtArray(CtInt)))
}

test "resolve TyApp Option[String]" {
  let ty = resolve_type_expr(TyApp("Option", [TyName("String")]), empty_defs())
  assert(types_equal(ty, CtOption(CtString)))
}

test "resolve TyTuple" {
  let ty = resolve_type_expr(TyTuple([TyName("Int"), TyName("Bool")]), empty_defs())
  assert(types_equal(ty, CtTuple([CtInt, CtBool])))
}

test "resolve TyFn" {
  let ty = resolve_type_expr(TyFn([TyName("Int")], TyName("String"), None), empty_defs())
  assert(types_equal(ty, CtFn([CtInt], CtString, None)))
}

test "resolve enum typedef" {
  let no_args = array_empty()
  let defs = [
    TDEnum("Color", array_empty(), [("Red", no_args), ("Blue", no_args)])
  ]
  let ty = resolve_type_expr(TyName("Color"), defs)
  assert(types_equal(ty, CtEnum("Color")))
}
