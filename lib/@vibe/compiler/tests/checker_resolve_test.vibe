//# Imports

import @vibe/compiler/core {
  Expr, Pat, Stmt, Type, TypeDef, TypeExpr, types_equal
}

import @vibe/core {
  array_empty
}

import @vibe/compiler/checker {
  resolve_type_expr
}

//# Functions

fn empty_defs() -> Array[TypeDef] {
  array_empty()
}

//# Misc

test "resolve TyUnit" {
  let ty = resolve_type_expr(te = TyUnit, defs = empty_defs())
  assert(types_equal(a = ty, b = CtUnit))
}

test "resolve TyName Int" {
  let ty = resolve_type_expr(te = TyName("Int"), defs = empty_defs())
  assert(types_equal(a = ty, b = CtInt))
}

test "resolve TyName String" {
  let ty = resolve_type_expr(te = TyName("String"), defs = empty_defs())
  assert(types_equal(a = ty, b = CtString))
}

test "resolve TyApp Array[Int]" {
  let ty = resolve_type_expr(te = TyApp("Array", [TyName("Int")]), defs = empty_defs())
  assert(types_equal(a = ty, b = CtArray(CtInt)))
}

test "resolve TyApp Option[String]" {
  let ty = resolve_type_expr(te = TyApp("Option", [TyName("String")]), defs = empty_defs())
  assert(types_equal(a = ty, b = CtOption(CtString)))
}

test "resolve TyTuple" {
  let ty = resolve_type_expr(te = TyTuple([TyName("Int"), TyName("Bool")]), defs = empty_defs())
  assert(types_equal(a = ty, b = CtTuple([CtInt, CtBool])))
}

test "resolve TyFn" {
  let ty = resolve_type_expr(te = TyFn([TyName("Int")], TyName("String"), None), defs = empty_defs())
  assert(types_equal(a = ty, b = CtFn([CtInt], CtString, None)))
}

test "resolve enum typedef" {
  let no_args = array_empty()
  let defs = [
    TDEnum("Color", array_empty(), [("Red", no_args), ("Blue", no_args)])
  ]
  let ty = resolve_type_expr(te = TyName("Color"), defs = defs)
  assert(types_equal(a = ty, b = CtEnum("Color")))
}
