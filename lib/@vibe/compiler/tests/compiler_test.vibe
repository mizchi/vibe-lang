//# Imports

import ../entry/source_compile {
  compile_source
}

//# Functions

fn assert_wasm_magic(bytes: Bytes) -> Unit {
  assert(Bytes::get(bytes, 0) == 0)
  assert(Bytes::get(bytes, 1) == 97)
  assert(Bytes::get(bytes, 2) == 115)
  assert(Bytes::get(bytes, 3) == 109)
}

//# Misc

test "compile_source: simple int expression produces valid WASM" {
  let bytes = compile_source("let x = 42")
  assert_wasm_magic(bytes)
}

test "compile_source: function definition produces valid WASM" {
  let bytes = compile_source("let add: (Int, Int) -> Int = (a, b) -> { a + b }")
  assert_wasm_magic(bytes)
}

test "compile_source: if expression produces valid WASM" {
  let bytes = compile_source("let f: (Int) -> Int = (x) -> { if x > 0 { x } else { 0 - x } }")
  assert_wasm_magic(bytes)
}
