//# Imports

// #741: sha1 moved to the @vibe/core contract package (#738); consume it
// through the contract boundary like any other package user. #766: maps
// (get_or/has_key) joined the same contract — collection/ folded into core/.
import @vibe/core {
  get_or, has_key, sha1
}

import @vibe/semver {
  Semver::major, Semver::minor, Semver::patch, Semver::to_string, bump_minor, enum Semver
}

//# Misc

test "library smoke: sha1 via the @vibe/core contract" {
  assert(sha1("abc") == "a9993e364706816aba3e25717850c26c9cd0d89d")
}

test "library smoke: collection maps" {
  let m = Map::from_pairs([("lang", 1), ("vibe", 2)])
  assert(has_key(m, "vibe"))
  assert(eq(get_or(m, "lang", 0), 1))
}

test "library smoke: semver fully qualified method" {
  let stable = Semver(1, 2, 3, "")
  assert(Semver::major(stable) == 1)
  assert(Semver::minor(stable) == 2)
  assert(Semver::patch(stable) == 3)
  assert(Semver::to_string(bump_minor(stable)) == "1.3.0")
}
