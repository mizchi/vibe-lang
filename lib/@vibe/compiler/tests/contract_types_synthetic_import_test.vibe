import @vibe/compiler/contract {
  contract_types_module_line
}

import @vibe/compiler/core {
  Stmt, TypeExpr
}

import @vibe/compiler/runtime {
  parse_program_with_path
}

test "contract types carrier is bare, not an explicit alias-kind claim" {
  let defs = [
    SStruct(true, "Record", [("value", TyName("Int"))], [], [], []),
    SEnum(true, "Choice", [], [("First", [])], []),
    STypeAlias(true, "Alias", [], TyName("Int"))
  ]
  let line = contract_types_module_line("import", "./types.vibe", defs)
  assert(line == "import ./types.vibe { Record, Choice, Alias }\n")
  match Array::get(parse_program_with_path("main.vibe", line), 0) {
    SImport(_, items) => {
      let mut i = 0
      while i < Array::length(items) {
        assert(Array::get(items, i).kind == None)
        i = i + 1
      }
    },
    _ => assert(false)
  }
}
