//# Imports

import ../checker/index.vibe {
  check_program
}

import ../syntax {
  lex, parse_program
}

//# Functions

// First checker error message for `source`, or "" when it checks clean.
// (check_program throws the first collected diagnostic.)
fn first_check_error(source: String) -> String {
  handle {
    let _ = check_program(parse_program(lex(source)))
    ""
  } with Error {
    Throw(msg) => msg
  }
}

//# Misc

// #941: docs/cheatsheet.md (#635) — "mixing Result and Option in one
// `let*`/`?` chain is a type error". Both mixing directions used to sail
// through a fully-annotated function and trap `unreachable` on the failure
// track at runtime (`Err(e)` returned as an `Option`, or `None` yielded as a
// `Result`). The checker must reject BOTH directions and keep accepting the
// same-monad chains.

test "?' on Result inside an Option-returning fn is rejected" {
  let src = "fn checked(x: Int) -> Result[Int, String] { if x < 0 { Err(\"neg\") } else { Ok(x) } }\nfn f(x: Int) -> Option[Int] { let v = checked(x)?; Some(v + 1) }\nfn main() -> Int { match f(-1) { Some(v) => 1000 + v, None => -1 } }\n"
  let msg = first_check_error(src)
  // The `?` desugar's failure track is `return Err(e)` — checked against the
  // enclosing fn's annotated return type (`__return__`).
  assert(String::contains(msg, "return type mismatch"))
  assert(String::contains(msg, "expected Option[Int]"))
  assert(String::contains(msg, "Result"))
}

test "?' on Option inside a Result-returning fn is rejected" {
  let src = "fn find(x: Int) -> Option[Int] { if x < 0 { None } else { Some(x) } }\nfn g(x: Int) -> Result[Int, String] { let v = find(x)?; Ok(v + 1) }\nfn main() -> Int { match g(-1) { Ok(v) => 1000 + v, Err(_) => -1 } }\n"
  let msg = first_check_error(src)
  // Failure track here is `return None`.
  assert(String::contains(msg, "return type mismatch"))
  assert(String::contains(msg, "expected Result[Int, String]"))
  assert(String::contains(msg, "Option"))
}

test "let* on Result inside an Option-returning fn is rejected" {
  let src = "fn checked(x: Int) -> Result[Int, String] { if x < 0 { Err(\"neg\") } else { Ok(x) } }\nfn f(x: Int) -> Option[Int] { let* v = checked(x)\n  Some(v + 1) }\nfn main() -> Int { match f(-1) { Some(v) => 1000 + v, None => -1 } }\n"
  let msg = first_check_error(src)
  // `let*` lowers to a plain railway match (`Err(e) => Err(e)` arm, no early
  // return), so the conflict surfaces as a match-arm inconsistency.
  assert(String::contains(msg, "match arms have incompatible types"))
  assert(String::contains(msg, "expected Option[Int]"))
  assert(String::contains(msg, "Result"))
}

test "let* on Option inside a Result-returning fn is rejected" {
  let src = "fn find(x: Int) -> Option[Int] { if x < 0 { None } else { Some(x) } }\nfn g(x: Int) -> Result[Int, String] { let* v = find(x)\n  Ok(v + 1) }\nfn main() -> Int { match g(-1) { Ok(v) => 1000 + v, Err(_) => -1 } }\n"
  let msg = first_check_error(src)
  assert(String::contains(msg, "match arms have incompatible types"))
  assert(String::contains(msg, "Result"))
  assert(String::contains(msg, "Option"))
}

test "same-monad ? chain on Result still checks clean" {
  let src = "fn checked(x: Int) -> Result[Int, String] { if x < 0 { Err(\"neg\") } else { Ok(x) } }\nfn f(x: Int) -> Result[Int, String] { let v = checked(x)?; let w = checked(v + 1)?; Ok(w + 1) }\nfn main() -> Int { match f(1) { Ok(v) => v, Err(_) => -1 } }\n"
  assert(first_check_error(src) == "")
}

test "same-monad ? chain on Option still checks clean" {
  let src = "fn find(x: Int) -> Option[Int] { if x < 0 { None } else { Some(x) } }\nfn g(x: Int) -> Option[Int] { let v = find(x)?; let w = find(v + 1)?; Some(w + 1) }\nfn main() -> Int { match g(1) { Some(v) => v, None => -1 } }\n"
  assert(first_check_error(src) == "")
}

test "same-monad let* chain on Result still checks clean" {
  let src = "fn checked(x: Int) -> Result[Int, String] { if x < 0 { Err(\"neg\") } else { Ok(x) } }\nfn f(x: Int) -> Result[Int, String] { let* v = checked(x)\n  let* w = checked(v + 1)\n  Ok(w + 1) }\nfn main() -> Int { match f(1) { Ok(v) => v, Err(_) => -1 } }\n"
  assert(first_check_error(src) == "")
}

test "same-monad let* chain on Option still checks clean" {
  let src = "fn find(x: Int) -> Option[Int] { if x < 0 { None } else { Some(x) } }\nfn g(x: Int) -> Option[Int] { let* v = find(x)\n  let* w = find(v + 1)\n  Some(w + 1) }\nfn main() -> Int { match g(1) { Some(v) => v, None => -1 } }\n"
  assert(first_check_error(src) == "")
}

test "unannotated nested lambda returning Result inside an Option fn checks clean" {
  // #964 (Codex P2): `return` targets the NEAREST enclosing function. An
  // unannotated lambda shadows the `__return__` sentinel (CtUnknown), so its
  // `return Ok(..)` must NOT be compared against the outer fn's Option[Int].
  let src = "fn outer(x: Int) -> Option[Int] {\n  let g = (y: Int) -> { return Ok(y + 1) }\n  match g(x) { Ok(v) => Some(v), Err(_) => None }\n}\nfn main() -> Int { match outer(1) { Some(v) => v, None => -1 } }\n"
  assert(first_check_error(src) == "")
}

test "unannotated nested lambda returning Option inside a Result fn checks clean" {
  let src = "fn router(x: Int) -> Result[Int, String] {\n  let h = (y: Int) -> { return Some(y + 1) }\n  match h(x) { Some(v) => Ok(v), None => Err(\"none\") }\n}\nfn main() -> Int { match router(1) { Ok(v) => v, Err(_) => -1 } }\n"
  assert(first_check_error(src) == "")
}

test "annotated nested lambda with conflicting-monad return is still rejected" {
  // The shadow above is for UNANNOTATED lambdas only: an explicit `-> Option[Int]`
  // annotation binds the sentinel, so `return Ok(..)` inside it conflicts (#941).
  let src = "fn outer(x: Int) -> Option[Int] {\n  let g = (y: Int) -> Option[Int] { return Ok(y + 1) }\n  g(x)\n}\nfn main() -> Int { match outer(1) { Some(v) => v, None => -1 } }\n"
  let msg = first_check_error(src)
  assert(String::contains(msg, "return type mismatch"))
  assert(String::contains(msg, "expected Option[Int]"))
  assert(String::contains(msg, "Result"))
}

test "Option-to-Result conversion via explicit match still checks clean" {
  // Explicitly converting between the monads (the documented alternative to
  // mixing) must stay accepted: the arms both yield the SAME railway head.
  let src = "fn find(x: Int) -> Option[Int] { if x < 0 { None } else { Some(x) } }\nfn g(x: Int) -> Result[Int, String] { match find(x) { Some(v) => Ok(v), None => Err(\"missing\") } }\nfn main() -> Int { match g(1) { Ok(v) => v, Err(_) => -1 } }\n"
  assert(first_check_error(src) == "")
}
