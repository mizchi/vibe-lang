//# Imports

import ../type_db.vibe {
  TypeDb, db_check_env, db_new, db_set_source, db_typecheck, db_typecheck_count
}

import @vibe/compiler/core {
  Type, TypeEnv, env_lookup
}

//# Misc

test "type_db cache hit keeps count" {
  let db0 = db_new()
  let db1 = db_set_source(db = db0, path = "a.vibe", source = "let x = 1")
  let db2 = db_typecheck(db = db1, path = "a.vibe")
  assert(eq(db_typecheck_count(db2), 1))
  let db3 = db_typecheck(db = db2, path = "a.vibe")
  assert(eq(db_typecheck_count(db3), 1))
}

test "type_db source change invalidates self" {
  let db0 = db_new()
  let db1 = db_set_source(db = db0, path = "a.vibe", source = "let x = 1")
  let db2 = db_typecheck(db = db1, path = "a.vibe")
  assert(eq(db_typecheck_count(db2), 1))
  let db3 = db_set_source(db = db2, path = "a.vibe", source = "let x = 2")
  let db4 = db_typecheck(db = db3, path = "a.vibe")
  assert(eq(db_typecheck_count(db4), 2))
}

test "type_db dependency change invalidates importer" {
  let db0 = db_new()
  let db1 = db_set_source(db = db_set_source(db = db0, path = "a.vibe", source = "import ./b.vibe { y }\nlet x = y"), path = "b.vibe", source = "export let y = 1")
  let db2 = db_typecheck(db = db1, path = "a.vibe")
  assert(eq(db_typecheck_count(db2), 2))
  let db3 = db_typecheck(db = db2, path = "a.vibe")
  assert(eq(db_typecheck_count(db3), 2))
  let db4 = db_set_source(db = db3, path = "b.vibe", source = "export let y = 2")
  let db5 = db_typecheck(db = db4, path = "a.vibe")
  assert(eq(db_typecheck_count(db5), 4))
}

test "type_db import extraction handles indented/no-space forms" {
  let db0 = db_new()
  let db1 = db_set_source(db = db_set_source(db = db0, path = "a.vibe", source = "  import ./b.vibe{ y }\nlet x = y"), path = "b.vibe", source = "export let y = 1")
  let db2 = db_typecheck(db = db1, path = "a.vibe")
  assert(eq(db_typecheck_count(db2), 2))
  let db3 = db_typecheck(db = db2, path = "a.vibe")
  assert(eq(db_typecheck_count(db3), 2))
  let db4 = db_set_source(db = db3, path = "b.vibe", source = "export let y = 2")
  let db5 = db_typecheck(db = db4, path = "a.vibe")
  assert(eq(db_typecheck_count(db5), 4))
}
