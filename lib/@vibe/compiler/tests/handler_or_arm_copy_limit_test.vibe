import @vibe/compiler/core {
  Expr, Pat, Stmt, split_handler_or_arms
}

fn alternatives(_ count: Int) -> Pat {
  let mut pat: Pat = PCtor("E::A", [])
  let mut i = 1
  while i < count {
    pat = POr(pat, PCtor("E::B", []))
    i = i + 1
  }
  pat
}

fn nested_arms(outer: Int, inner: Int) -> Array[Stmt] {
  let terminal = EHandle(EInt(0), [(alternatives(inner), EInt(1))])
  [SExpr(EHandle(EInt(0), [(alternatives(outer), terminal)]))]
}

fn split_verdict(stmts: Array[Stmt], with_binders: Bool, copies: Int) -> Bool {
  handle {
    split_handler_or_arms(stmts = stmts, with_binders = with_binders)
    false
  } with { Exception::Throw(msg) => String::contains(msg, needle = String::concat(__to_string(copies), " times, over the limit of 256")) }
}

test "a terminal arm expansion exceeding the limit is refused in both lanes" {
  assert(split_verdict(stmts = nested_arms(outer = 2, inner = 129), with_binders = false, copies = 258))
  assert(split_verdict(stmts = nested_arms(outer = 2, inner = 129), with_binders = true, copies = 258))
}

test "an incoming count at the limit cannot expand a terminal inner arm" {
  assert(split_verdict(stmts = nested_arms(outer = 256, inner = 257), with_binders = false, copies = 65792))
  assert(split_verdict(stmts = nested_arms(outer = 256, inner = 257), with_binders = true, copies = 65792))
}

test "exactly the limit remains accepted in both lanes" {
  split_handler_or_arms(stmts = nested_arms(outer = 16, inner = 16), with_binders = false)
  split_handler_or_arms(stmts = nested_arms(outer = 16, inner = 16), with_binders = true)
}

test "a single arm over the limit is refused" {
  assert(split_verdict(stmts = [SExpr(EHandle(EInt(0), [(alternatives(257), EInt(1))]))], with_binders = false, copies = 257))
}
