//# Imports

import ./checker_parity_test_support.vibe {
  check_source_err, check_source_ok
}

//# Misc

test "parity: int literal" {
  assert(check_source_ok("let _adr69 = () -> { 42 }"))
}

test "parity: let binding" {
  assert(check_source_ok("let x = 1\nlet _adr69 = () -> { x }"))
}

test "parity: function call" {
  assert(check_source_ok("let f: (Int) -> Int = (x) -> { x + 1 }\nlet _adr69 = () -> { f(5) }"))
}

test "parity: if expression" {
  assert(check_source_ok("let _adr69 = () -> { if true { 1 } else { 0 } }"))
}

test "parity: while loop" {
  assert(check_source_ok("let _adr69 = () -> { let mut s = 0\nlet mut i = 0\nwhile i < 10 { s = s + i\ni = i + 1 }\ns }"))
}

test "parity: match int" {
  assert(check_source_ok("let _adr69 = () -> { match 1 { 0 => 10, _ => 20 } }"))
}

test "parity: match string" {
  assert(check_source_ok("let _adr69 = () -> { match \"hi\" { \"hi\" => 1, _ => 0 } }"))
}

test "parity: block expression" {
  assert(check_source_ok("let x = { let a = 1\nlet b = 2\na + b }\nlet _adr69 = () -> { x }"))
}

test "parity: recursive function" {
  assert(check_source_ok("let rec f: (Int) -> Int = (n) -> { if n <= 0 { 0 } else { f(n - 1) + n } }\nlet _adr69 = () -> { f(10) }"))
}

test "parity: enum definition and match" {
  assert(check_source_ok("enum Color { Red; Green; Blue }\nlet f: (Color) -> Int = (c) -> { match c { Red => 1, Green => 2, Blue => 3 } }\nlet _adr69 = () -> { f(Red) }"))
}

test "parity: tuple" {
  // #859: tuple-pattern let is only supported in a function/block body, not
  // at top level -- the destructure moved inside the lambda accordingly.
  assert(check_source_ok("let p = (1, 2)\nlet _adr69 = () -> { let (a, b) = p\na + b }"))
}

test "parity: array literal" {
  assert(check_source_ok("let arr = [1, 2, 3]\nlet _adr69 = () -> { Array::length(arr) }"))
}

test "parity: string operations" {
  assert(check_source_ok("let s = \"hello\"\nlet _adr69 = () -> { String::length(s) }"))
}

test "parity: handle basic" {
  assert(check_source_ok("let r = handle { 42 } with Error { Throw(_) => -1 }\nlet _adr69 = () -> { r }"))
}

test "parity: handle with throw" {
  assert(check_source_ok("let r = handle { throw(\"x\")\n0 } with Error { Throw(msg) => String::length(msg) }\nlet _adr69 = () -> { r }"))
}

test "parity: effectful function" {
  assert(check_source_ok("let f: () -> Int with Error = () -> { throw(\"x\")\n0 }\nlet r = handle { f() } with Error { Throw(_) => 99 }\nlet _adr69 = () -> { r }"))
}

test "parity: generic identity" {
  assert(check_source_ok("let id: [T](T) -> T = (x) -> { x }\nlet _adr69 = () -> { id(42) }"))
}

test "parity: higher-order function" {
  assert(check_source_ok("let apply: ((Int) -> Int, Int) -> Int = (f, x) -> { f(x) }\nlet double: (Int) -> Int = (x) -> { x * 2 }\nlet _adr69 = () -> { apply(double, 5) }"))
}

test "parity: for-in loop" {
  assert(check_source_ok("let arr = [1, 2, 3]\nlet _adr69 = () -> { let mut s = 0\nfor x in arr { s = s + x }\ns }"))
}

test "parity: struct definition" {
  assert(check_source_ok("struct Point { x: Int; y: Int }\nlet p = Point::{ x: 1, y: 2 }\nlet _adr69 = () -> { p.x + p.y }"))
}

/// #836: named struct constructor literals accept the same field-shorthand as
/// anonymous record literals — `Point::{ x, y }` is shorthand for
/// `Point::{ x: x, y: y }`, matching in-scope bindings named after the fields.
test "parity: struct literal field shorthand" {
  assert(check_source_ok("struct Point { x: Int; y: Int }\nlet x = 1\nlet y = 2\nlet p = Point::{ x, y }\nlet _adr69 = () -> { p.x + p.y }"))
}

test "parity: struct literal field shorthand mixed with explicit fields" {
  assert(check_source_ok("struct Point { x: Int; y: Int }\nlet x = 1\nlet p = Point::{ x, y: 2 }\nlet _adr69 = () -> { p.x + p.y }"))
}

/// #886: explicit struct type arguments (`Pair[Int]::{ ... }`) parse and pin
/// the instantiation (deferred from #836). The explicit form checks clean; a
/// type-argument arity mismatch and a field value conflicting with the pinned
/// argument are both rejected.
test "parity: struct literal explicit type args accepted" {
  assert(check_source_ok("struct Pair[T] { left: T; right: T }\nlet _adr69 = () -> { Pair[Int]::{ left: 1, right: 2 } }"))
}

test "parity: struct literal explicit type args arity mismatch rejected" {
  assert(check_source_err("struct Pair[T] { left: T; right: T }\nlet _adr69 = () -> { Pair[Int, String]::{ left: 1, right: 2 } }"))
}

test "parity: struct literal explicit type args field conflict rejected" {
  assert(check_source_err("struct Pair[T] { left: T; right: T }\nlet _adr69 = () -> { Pair[String]::{ left: 1, right: 2 } }"))
}

test "parity: comparison ops" {
  assert(check_source_ok("let a = 5\nlet b = 10\nlet _adr69 = () -> { if a < b { 1 } else { 0 } }"))
}

test "parity: boolean ops" {
  assert(check_source_ok("let a = true\nlet b = false\nlet _adr69 = () -> { if a && !b { 1 } else { 0 } }"))
}

test "parity: float literal" {
  assert(check_source_ok("let x = 3.14\nlet _adr69 = () -> { if x > 3.0 { 1 } else { 0 } }"))
}

test "parity: nested function" {
  assert(check_source_ok("let outer: () -> Int = () -> {\n  let inner: (Int) -> Int = (x) -> { x * 2 }\n  inner(21)\n}\nlet _adr69 = () -> { outer() }"))
}

test "parity: option type" {
  assert(check_source_ok("let x: Option[Int] = Some(42)\nlet _adr69 = () -> { match x { Some(n) => n, None => 0 } }"))
}

test "parity: option sugar T?" {
  assert(check_source_ok("let x: Int? = Some(42)\nlet _adr69 = () -> { match x { Some(n) => n, None => 0 } }"))
}

test "parity err: unknown name" {
  assert(check_source_err("foo"))
}

test "parity err: if condition not bool" {
  assert(check_source_err("if 42 { 1 } else { 0 }"))
}

test "parity err: binop type mismatch" {
  assert(check_source_err("1 + \"hello\""))
}

test "parity: let mut and assign" {
  assert(check_source_ok("let _adr69 = () -> { let mut x = 0\nx = x + 1\nx }"))
}

test "parity: nested if-else" {
  assert(check_source_ok("let n = 5\nlet _adr69 = () -> { if n < 0 { -1 } else if n == 0 { 0 } else { 1 } }"))
}

test "parity: match with wildcard" {
  assert(check_source_ok("let _adr69 = () -> { match 42 { 0 => 100, _ => 200 } }"))
}

test "parity: match bool" {
  assert(check_source_ok("let _adr69 = () -> { match true { true => 1, false => 0 } }"))
}

test "parity: string concat" {
  assert(check_source_ok("let a = \"hello\"\nlet b = \" world\"\nlet _adr69 = () -> { a + b }"))
}

test "parity: arithmetic chain" {
  assert(check_source_ok("let x = 1 + 2 * 3 - 4 / 2\nlet _adr69 = () -> { x }"))
}

test "parity: comparison chain" {
  assert(check_source_ok("let a = 1 < 2\nlet b = 3 >= 2\nlet c = 4 != 5\nlet _adr69 = () -> { if a && b && c { 1 } else { 0 } }"))
}

test "parity: char literal" {
  assert(check_source_ok("let c = 'A'\nlet _adr69 = () -> { Char::to_int(c) }"))
}

test "parity: while with break" {
  assert(check_source_ok("let _adr69 = () -> { let mut i = 0\nwhile true { if i >= 10 { break }\ni = i + 1 }\ni }"))
}

test "parity: array push and length" {
  assert(check_source_ok("let arr = [1, 2, 3]\nlet _adr69 = () -> { Array::push(arr, 4)\nArray::length(arr) }"))
}

test "parity: array get" {
  assert(check_source_ok("let arr = [10, 20, 30]\nlet _adr69 = () -> { Array::get(arr, 1) }"))
}

test "parity: map literal" {
  assert(check_source_ok("let m = Map::from_pairs([(\"x\", 1), (\"y\", 2)])\nlet _adr69 = () -> { Map::get(m, \"x\") }"))
}

test "parity: closure capture" {
  assert(check_source_ok("let n = 10\nlet add_n: (Int) -> Int = (x) -> { x + n }\nlet _adr69 = () -> { add_n(5) }"))
}

test "parity: recursive enum" {
  assert(check_source_ok("enum List { Nil; Cons(Int, List) }\nlet rec len: (List) -> Int = (l) -> { match l { Nil => 0, Cons(_, rest) => 1 + len(rest) } }\nlet _adr69 = () -> { len(Cons(1, Cons(2, Nil))) }"))
}

