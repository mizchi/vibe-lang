//# The body cache across a build where a source function's ROW changed
//# (#3771). A row is what other bodies are lowered against -- arity, return
//# and borrow classes, thunk, folded constant -- so a caller compiled
//# against the old row is stale. A changed row no longer declines the whole
//# edit lane: the function's name joins the mention check, so every body
//# that spells it recompiles, and so does the function's own body.
//#
//# Measured: neither row here needs the marking. A folded constant's callers
//# are already withheld by the per-entry fold signature, and a changed return
//# class moves the used-builtin set, which declines first. The marking is the
//# rule that makes a changed row SAFE to tolerate at all -- a caller consumes
//# a row only through the name it spells -- not one a row here proves.
//#
//# Each row: a cold compile on the base, the edit to the middle file, then a
//# warm body-cached compile against a fresh one. `saved` is how many bodies
//# the warm compile did not rebuild; `equal` is byte equality with the fresh
//# compile.

import @vibe/compiler/entry/compiler/file_compile {
  codegen_body_cache_artifact_key, compile_file_fs_mode_rc, compile_file_fs_mode_rc_body_cached_counted
}

import @vibe/compiler/cache {
  persistent_artifact_cache_path
}

import @vibe/compiler/core {
  set_reloc_slot_width
}

fn bcr_bytes(_ s: String) -> Bytes {
  let out = Bytes::new()
  let mut i = 0
  while i < String::length(s) {
    Bytes::push(out, value = String::byte_at(s, at = i))
    i = i + 1
  }
  out
}

fn bcr_bytes_eq(a: Bytes, b: Bytes) -> Bool {
  let n = Bytes::length(a)
  if n != Bytes::length(b) {
    false
  } else {
    let mut i = 0
    let mut same = true
    while same && i < n {
      if Bytes::get(a, at = i) != Bytes::get(b, at = i) {
        same = false
      } else {
        i = i + 1
      }
    }
    same
  }
}

let bcr_b_path: String = "/tmp/vibe_body_cache_bcr_b.vibe"

let bcr_main_path: String = "/tmp/vibe_body_cache_bcr_main.vibe"

/// The middle file. `bcr_k` folds to the constant `k`, which every caller
/// inlines.
fn bcr_b(_ k: Int) -> String {
  String::join([
    "export let bcr_k: () -> Int = () -> { \{k} }",
    "export let bcr_eq: () -> Bool = () -> { [1, 2] == [1, 2] }"
  ], sep = "\n")
}

/// The downstream file: `bcr_use` calls `bcr_k`, `bcr_plain` never does.
fn bcr_main() -> String {
  String::join([
    "import ./vibe_body_cache_bcr_b.vibe { bcr_eq, bcr_k }",
    "let bcr_plain: (Int) -> Int = (n) -> { n * 3 + 1 }",
    "let bcr_use: (Int) -> Int = (n) -> { n + bcr_k() }",
    "let run: () -> Int = () -> { bcr_use(n = 2) + bcr_plain(n = 3) +  (if bcr_eq() { 1 } else { 0 }) }"
  ], sep = "\n")
}

//# #3941: every row runs at slot width 0 and at slot width 3. A relocation
//# that wrote a padded slot back minimal, or a cache slot shared between the
//# widths, answers differently at 3 than the same row at 0.

/// Run `row` at relocatable-slot width `width`, restoring width 0 after it.
fn bcr_at_slot_width(width: Int, row: () -> Unit with Console + Env + Exception + Fs) -> Unit with Console + Env + Exception + Fs {
  set_reloc_slot_width(width)
  handle {
    row()
    set_reloc_slot_width(0)
  } with { Exception::Throw(m) => {
    set_reloc_slot_width(0)
    throw(m)
  } }
}

/// The row behind the test "a folded constant changed recompiles exactly its callers"; run at slot widths 0 and 3.
fn bcr_row_1() -> Unit with Console + Env + Exception + Fs {
  let artifact_path = persistent_artifact_cache_path(kind = "codegen-body-cache", entry_name = "run", fingerprint = codegen_body_cache_artifact_key(bcr_main_path), checked_error_row = false)
  if Fs::exists(artifact_path) {
    Fs::remove(artifact_path)
  } else {
    ()
  }
  Fs::write_bytes(bcr_b_path, bytes = bcr_bytes(bcr_b(5)))
  Fs::write_bytes(bcr_main_path, bytes = bcr_bytes(bcr_main()))
  let cold_counts: Array[Int] = []
  let _cold = compile_file_fs_mode_rc_body_cached_counted(entry_path = bcr_main_path, entry_name = "run", cache_mode = "on", counts_out = cold_counts, exports_stripped = false, checked_error_row = false)
  Fs::write_bytes(bcr_b_path, bytes = bcr_bytes(bcr_b(6)))
  let warm_counts: Array[Int] = []
  let warm = compile_file_fs_mode_rc_body_cached_counted(entry_path = bcr_main_path, entry_name = "run", cache_mode = "on", counts_out = warm_counts, exports_stripped = false, checked_error_row = false)
  let fresh = compile_file_fs_mode_rc(entry_path = bcr_main_path, entry_name = "run", exports_stripped = false, checked_error_row = false)
  inspect("saved=\{Array::get(cold_counts, at = 1) - Array::get(warm_counts, at = 1)} equal=\{bcr_bytes_eq(a = warm, b = fresh)}", content = "saved=3 equal=true")
}

test "a folded constant changed recompiles exactly its callers" {
  bcr_row_1()
}

test "a folded constant changed recompiles exactly its callers, at slot width 3 (#3941)" {
  bcr_at_slot_width(width = 3, row = bcr_row_1)
}

/// The middle file for the return-class row: `bcr_s` returns `ret`, built by
/// `body`.
fn bcr_b_ret(ret: String, body: String) -> String {
  String::join([
    "export let bcr_s: (Int) -> \{ret} = (n) -> { \{body} }",
    "export let bcr_eq: () -> Bool = () -> { [1, 2] == [1, 2] }"
  ], sep = "\n")
}

/// `bcr_pass` hands `bcr_s`'s result to a generic, so it type-checks whatever
/// `bcr_s` returns -- and how it owns that result depends on the return class.
fn bcr_main_ret() -> String {
  String::join([
    "import ./vibe_body_cache_bcr_b.vibe { bcr_eq, bcr_s }",
    "fn bcr_gen[T](v: T) -> Int { 1 }",
    "let bcr_plain: (Int) -> Int = (n) -> { n * 3 + 1 }",
    "let bcr_pass: (Int) -> Int = (n) -> { bcr_gen(v = bcr_s(n = n)) + bcr_gen(v = bcr_s(n = n + 1)) }",
    "let run: () -> Int = () -> { bcr_pass(n = 2) + bcr_plain(n = 3) +  (if bcr_eq() { 1 } else { 0 }) + String::length(\"\\{bcr_plain(n = 1)}\") }"
  ], sep = "\n")
}

// A return class that changes also changes the set of builtins the program
// uses (here the string runtime), and that guard declines the lane first:
// the row is recorded, not reached. Kept so the case stays byte-exact.
/// The row behind the test "a return class changed declines and compiles byte-exact"; run at slot widths 0 and 3.
fn bcr_row_2() -> Unit with Console + Env + Exception + Fs {
  let artifact_path = persistent_artifact_cache_path(kind = "codegen-body-cache", entry_name = "run", fingerprint = codegen_body_cache_artifact_key(bcr_main_path), checked_error_row = false)
  if Fs::exists(artifact_path) {
    Fs::remove(artifact_path)
  } else {
    ()
  }
  Fs::write_bytes(bcr_b_path, bytes = bcr_bytes(bcr_b_ret(ret = "Int", body = "n")))
  Fs::write_bytes(bcr_main_path, bytes = bcr_bytes(bcr_main_ret()))
  let cold_counts: Array[Int] = []
  let _cold = compile_file_fs_mode_rc_body_cached_counted(entry_path = bcr_main_path, entry_name = "run", cache_mode = "on", counts_out = cold_counts, exports_stripped = false, checked_error_row = false)
  Fs::write_bytes(bcr_b_path, bytes = bcr_bytes(bcr_b_ret(ret = "String", body = "String::concat(\"s\", \"\\{n}\")")))
  let warm_counts: Array[Int] = []
  let warm = compile_file_fs_mode_rc_body_cached_counted(entry_path = bcr_main_path, entry_name = "run", cache_mode = "on", counts_out = warm_counts, exports_stripped = false, checked_error_row = false)
  let fresh = compile_file_fs_mode_rc(entry_path = bcr_main_path, entry_name = "run", exports_stripped = false, checked_error_row = false)
  inspect("saved=\{Array::get(cold_counts, at = 1) - Array::get(warm_counts, at = 1)} equal=\{bcr_bytes_eq(a = warm, b = fresh)}", content = "saved=0 equal=true")
}

test "a return class changed declines and compiles byte-exact" {
  bcr_row_2()
}

test "a return class changed declines and compiles byte-exact, at slot width 3 (#3941)" {
  bcr_at_slot_width(width = 3, row = bcr_row_2)
}
