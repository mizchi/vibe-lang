//# The package-header scan's blanked text (#2386). `extract_require_pins`
//# returns the source with every header directive line replaced by spaces
//# of the same length and everything after the header verbatim. The scan
//# returns the source itself when the header blanked nothing, and appends
//# the tail in one piece otherwise; every expectation below is the text
//# the line-by-line copy produced.

import @vibe/compiler/contract {
  extract_require_pins, extract_require_sources, is_require_source_spec, require_line_source_clause
}

fn spaces(n: Int) -> String {
  let sb = StringBuilder::new()
  let mut i = 0
  while i < n {
    StringBuilder::push(sb, " ")
    i = i + 1
  }
  StringBuilder::freeze(sb)
}

test "a source with no header is its own blanked text" {
  let src = "fn main() -> Int {\n  1\n}\n"
  let (pins, blanked) = extract_require_pins(src)
  assert_eq(Array::length(pins), 0)
  assert_eq(blanked, src)
}

test "leading comments and blank lines are kept verbatim, no trailing newline" {
  let src = "// c\n\nfn main() -> Int {\n  1\n}"
  let (pins, blanked) = extract_require_pins(src)
  assert_eq(Array::length(pins), 0)
  assert_eq(blanked, src)
}

test "a require line is blanked to its length and the body follows verbatim" {
  let src = "require @a/b 1.2.3\nfn main() -> Int {\n  1\n}\n"
  let (pins, blanked) = extract_require_pins(src)
  assert_eq(Array::length(pins), 1)
  let (rname, rver, rpin) = Array::get(pins, 0)
  assert_eq(rname, "@a/b")
  assert_eq(rver, "1.2.3")
  assert_eq(rpin, "")
  assert_eq(blanked, String::concat(spaces(18), "\nfn main() -> Int {\n  1\n}\n"))
}

test "header lines between directives stay, the tail keeps its newlines" {
  let src = "version = 0.1.0\n// x\nrequire @a/b 1.2.3\n\nfn f() -> Int {\n  2\n}\n"
  let (pins, blanked) = extract_require_pins(src)
  assert_eq(Array::length(pins), 1)
  assert_eq(blanked, String::concat(spaces(15), String::concat("\n// x\n", String::concat(spaces(18), "\n\nfn f() -> Int {\n  2\n}\n"))))
}

test "a header-only source is blanked line by line" {
  let src = "name = @a/b\nversion = 0.0.1\n"
  let (pins, blanked) = extract_require_pins(src)
  assert_eq(Array::length(pins), 0)
  assert_eq(blanked, String::concat(spaces(11), String::concat("\n", String::concat(spaces(15), "\n"))))
}

test "a directive after the first code line is not a header line" {
  let src = "fn main() -> Int {\n  1\n}\nrequire @a/b 1.2.3\n"
  let (pins, blanked) = extract_require_pins(src)
  assert_eq(Array::length(pins), 0)
  assert_eq(blanked, src)
}

test "a directive after a blanked header line, past code, stays verbatim" {
  let src = "require @a/b 1.2.3\nfn main() -> Int {\n  1\n}\nversion = 9.9.9\n"
  let (pins, blanked) = extract_require_pins(src)
  assert_eq(Array::length(pins), 1)
  assert_eq(blanked, String::concat(spaces(18), "\nfn main() -> Int {\n  1\n}\nversion = 9.9.9\n"))
}

test "the last header line without a trailing newline" {
  let src = "require @a/b 1.2.3"
  let (pins, blanked) = extract_require_pins(src)
  assert_eq(Array::length(pins), 1)
  assert_eq(blanked, spaces(18))
}

//# #2676: the `from <source-spec>` clause records where `vibe add` fetched
//# the package, so `vibe fetch` can restore the store on a fresh clone.

let zero_pin: String = "#pkg:sha1:0000000000000000000000000000000000000000"

test "#2676: a pinned require line with a from clause yields the pin and blanks whole" {
  let line = String::concat("require @a/b 1.2.3 = ", String::concat(zero_pin, " from github:acme/json@0123abc"))
  let src = String::concat(line, "\nfn main() -> Int {\n  1\n}\n")
  let (pins, blanked) = extract_require_pins(src)
  assert_eq(Array::length(pins), 1)
  let (rname, rver, rpin) = Array::get(pins, 0)
  assert_eq(rname, "@a/b")
  assert_eq(rver, "1.2.3")
  assert_eq(rpin, "pkg:sha1:0000000000000000000000000000000000000000")
  assert_eq(blanked, String::concat(spaces(String::length(line)), "\nfn main() -> Int {\n  1\n}\n"))
}

test "#2676: an unpinned require line may carry a from clause" {
  let src = "require @a/b 1.2.3 from git:file:///srv/acme.git@0123abc#packages/@a/b\nfn f() -> Int {\n  2\n}\n"
  let (pins, _) = extract_require_pins(src)
  assert_eq(Array::length(pins), 1)
  let (rname, _, rpin) = Array::get(pins, 0)
  assert_eq(rname, "@a/b")
  assert_eq(rpin, "")
}

test "#2676: a from clause without a ref, or with an unknown transport, is refused" {
  let no_ref = handle {
    let _ = extract_require_pins("require @a/b 1.2.3 from github:acme/json\n")
    ""
  } with { Exception::Throw(m) => m }
  assert(String::contains(no_ref, "require source must be"))
  let bad_transport = handle {
    let _ = extract_require_pins(String::concat("require @a/b 1.2.3 = ", String::concat(zero_pin, " from ftp://x@y\n")))
    ""
  } with { Exception::Throw(m) => m }
  assert(String::contains(bad_transport, "require source must be"))
  let dangling = handle {
    let _ = extract_require_pins("require @a/b 1.2.3 from\n")
    ""
  } with { Exception::Throw(m) => m }
  assert(String::contains(dangling, "malformed require line"))
}

test "#2676: is_require_source_spec accepts the two transports with a ref only" {
  assert(is_require_source_spec("github:acme/json@0123abc"))
  assert(is_require_source_spec("github:acme/json/packages/json@v1.2.0"))
  assert(is_require_source_spec("git:https://example.com/acme.git@0123abc#packages/json"))
  assert(!is_require_source_spec("github:acme/json"))
  assert(!is_require_source_spec("git:@abc"))
  assert(!is_require_source_spec("https://example.com/acme.git@abc"))
  assert(!is_require_source_spec(""))
}

test "#2676: require_line_source_clause is the tail the fill lane re-attaches" {
  assert_eq(require_line_source_clause("require @a/b 1.2.3 from github:acme/json@0123abc"), " from github:acme/json@0123abc")
  assert_eq(require_line_source_clause(String::concat("require @a/b 1.2.3 = ", String::concat(zero_pin, "   from   git:x@y"))), " from git:x@y")
  assert_eq(require_line_source_clause("require @a/b 1.2.3"), "")
  assert_eq(require_line_source_clause(String::concat("require @a/b 1.2.3 = ", zero_pin)), "")
}

fn source_rows(src: String) -> String with Exception {
  let rows = extract_require_sources(src)
  let sb = StringBuilder::new()
  let mut i = 0
  while i < Array::length(rows) {
    let (name, constraint, pin, from) = Array::get(rows, i)
    StringBuilder::push(sb, "\{name} \{constraint} [\{pin}] [\{from}]|")
    i = i + 1
  }
  StringBuilder::freeze(sb)
}

test "#3673: extract_require_sources pairs every pin with its from clause, in order" {
  let h = "pkg:b3:af1349b9f5f9a1a6a0404dea36dcc9499bcb25c9adc112b7cc9a93cae41f3262"
  let src = "name = @me/app\nversion = 1.0.0\nrequire @a/one 1.0.0\nrequire @a/two 1.0.0 = #\{h}\ndeps = {\n  @a/one : 1.0.0\n}\nrequire @a/three 2.0.0 from git:/tmp/r@abc\nrequire @a/four 3.0.0 = #\{h} from github:o/r@def\nfn main() -> Int {\n  1\n}\n"
  let rows = source_rows(src)
  assert(String::contains(rows, "@a/one 1.0.0 [] []|"))
  assert(String::contains(rows, "@a/three 2.0.0 [] [git:/tmp/r@abc]|"))
  assert(String::contains(rows, "[github:o/r@def]|"))
  assert_eq(Array::length(extract_require_sources(src)), 4)
  let (second, _, _, second_from) = Array::get(extract_require_sources(src), 1)
  assert_eq(second, "@a/two")
  assert_eq(second_from, "")
  let (fourth, _, _, _) = Array::get(extract_require_sources(src), 3)
  assert_eq(fourth, "@a/four")
}

test "#3673: extract_require_sources of a source with no header is empty" {
  assert_eq(Array::length(extract_require_sources("fn main() -> Int {\n  1\n}\n")), 0)
}

test "#3673: extract_require_sources refuses a malformed require line" {
  let refused = handle {
    let _ = extract_require_sources("require @a/one\nfn main() -> Int {\n  1\n}\n")
    false
  } with { Exception::Throw(_) => true }
  assert(refused)
}
