//# The evidence pass splits a declared row into labels at bracket depth zero

// #3620 review: `edp_row_label_is_any` and `edp_slot_row_stampable` split a
// row at every `+` and `,`, so `Pair[A, B]` read as the labels `Pair[A` and
// `B]`, and `B]` named a struct parameter `B`. The parser accepts no comma
// inside an effect row item today ("takes exactly one type argument for
// now"), so no program reaches it yet; the split is pinned here for when it
// does.

//# Imports

import @vibe/compiler/lowering/effects/evidence {
  edp_alias_fn_row,
  edp_field_slot,
  edp_note_program_aliases,
  edp_note_row_field_structs,
  edp_result_slot,
  edp_row_top_labels,
  edp_slot_row_stampable,
  evidence_dict_pass
}

import @vibe/compiler/core {
  Expr, Stmt, TypeExpr
}
import @vibe/ast {
  type_param_key
}

fn kinded_field_slot(row: String, args: Array[TypeExpr]) -> Option[(Int, String)] {
  let stmts = [
    SStruct(false, "H", [("f", TyFn([], TyName("Int"), Some(row)))], [], [], [
      type_param_key(name = "F", arity = 1)
    ])
  ]
  edp_note_row_field_structs(stmts)
  edp_field_slot(sname = "H", fname = "f", targs = args)
}

//# Tests

test "labels split at the top-level separators only" {
  inspect(edp_row_top_labels("Pair[A, B]"), "[Pair[A, B]]")
  inspect(edp_row_top_labels("Box[Map[String, T]] + Log"), "[Box[Map[String, T]], Log]")
  inspect(edp_row_top_labels("A, B"), "[A, B]")
  inspect(edp_row_top_labels("Tup[(String, T)]"), "[Tup[(String, T)]]")
}

test "a lowercase type argument is not read as a row variable" {
  inspect(edp_slot_row_stampable("Pair[String, b]"), "true")
  inspect(edp_slot_row_stampable("Box[Int] + e"), "false")
}

test "kinded field formals are substituted by their source names" {
  match kinded_field_slot(row = "Box[F[Int]]", args = [TyName("Option")]) {
    Some((_, row)) => assert_eq(row, "Box[Option[Int]]"),
    None => assert(false)
  }
}

test "a kinded field formal still requires its actual argument" {
  match kinded_field_slot(row = "Box[F[Int]]", args = []) {
    None => (),
    Some(_) => assert(false)
  }
}

test "a kinded formal in label position is not a concrete effect" {
  match kinded_field_slot(row = "F[Int]", args = [TyName("Option")]) {
    None => (),
    Some(_) => assert(false)
  }
}

test "a kinded alias row is withheld when it cannot be instantiated" {
  let stmts = [
    STypeAlias(false, "Thunk", [type_param_key(name = "F", arity = 1)], TyFn([], TyName("Int"), Some("Box[F[Int]]")))
  ]
  edp_note_program_aliases(stmts)
  match edp_result_slot(stmts = stmts, rty = TyApp("Thunk", [TyName("Option")])) {
    None => (),
    Some(_) => assert(false)
  }
}

test "indexed callback aliases preserve arity, declaration order, and stamp scope" {
  let stmts: Array[Stmt] = [
    STypeAlias(false, "Callback", [], TyName("Thunk")),
    STypeAlias(false, "Thunk", [], TyFn([], TyName("Int"), Some("First"))),
    STypeAlias(false, "Thunk", ["T"], TyFn([], TyName("T"), Some("Generic"))),
    STypeAlias(false, "Thunk", [], TyFn([], TyName("Int"), Some("Last"))),
    STypeAlias(false, "Cycle", [], TyName("Cycle"))
  ]
  edp_note_program_aliases(stmts)
  match edp_alias_fn_row(ty = TyName("Callback")) {
    Some(row) => assert_eq(row, "Last"),
    None => assert(false)
  }
  match edp_alias_fn_row(ty = TyApp("Thunk", [TyName("Int")])) {
    Some(row) => assert_eq(row, "Generic"),
    None => assert(false)
  }
  assert(edp_alias_fn_row(ty = TyName("Cycle")) is None)
  edp_note_program_aliases([])
  assert(edp_alias_fn_row(ty = TyName("Callback")) is None)
}

test "top-level closure stamping reads aliases from the current evidence pass" {
  edp_note_program_aliases([
    STypeAlias(false, "Thunk", [], TyFn([], TyName("Int"), Some("Previous")))
  ])
  let stmts: Array[Stmt] = [
    STypeAlias(false, "Thunk", [], TyFn([], TyName("Int"), Some("Current"))),
    SLet(false, false, "main", Some(TyName("Thunk")), EFn([], [], [], Some(TyName("Int")), None, EInt(42)))
  ]
  inspect(evidence_dict_pass(stmts = stmts, entry_name = "main"), content = "[]")
  match Array::get(stmts, at = 1) {
    SLet(_, _, "main", Some(TyFn(_, _, Some(row))), _) => inspect(row, content = "Current"),
    _ => assert(false)
  }
}
