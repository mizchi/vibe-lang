//# The evidence pass splits a declared row into labels at bracket depth zero

// #3620 review: `edp_row_label_is_any` and `edp_slot_row_stampable` split a
// row at every `+` and `,`, so `Pair[A, B]` read as the labels `Pair[A` and
// `B]`, and `B]` named a struct parameter `B`. The parser accepts no comma
// inside an effect row item today ("takes exactly one type argument for
// now"), so no program reaches it yet; the split is pinned here for when it
// does.

//# Imports

import @vibe/compiler/lowering/effects/evidence {
  edp_row_top_labels, edp_slot_row_stampable
}

//# Tests

test "labels split at the top-level separators only" {
  inspect(edp_row_top_labels("Pair[A, B]"), "[Pair[A, B]]")
  inspect(edp_row_top_labels("Box[Map[String, T]] + Log"), "[Box[Map[String, T]], Log]")
  inspect(edp_row_top_labels("A, B"), "[A, B]")
  inspect(edp_row_top_labels("Tup[(String, T)]"), "[Tup[(String, T)]]")
}

test "a lowercase type argument is not read as a row variable" {
  inspect(edp_slot_row_stampable("Pair[String, b]"), "true")
  inspect(edp_slot_row_stampable("Box[Int] + e"), "false")
}
