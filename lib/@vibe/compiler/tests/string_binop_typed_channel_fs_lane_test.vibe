//# Imports

import ./string_binop_typed_channel_fs_dep.vibe {
  sb_dep_tag
}

//# Functions

// #2391 slice 2: the typed String-binop channel on the FS lane -- the lane
// `vibe test` and `vibe run` take by default. The desugar tracker rewrites
// `a < b` to `str_lex_diff(a, b) < 0` and `a + b` to `String::concat(a, b)`
// only for operands it can classify syntactically; an operand it cannot
// classify used to keep the raw binop, which on the (ptr<<32)|len string
// repr compares POINTERS for `<` and adds the lengths for `+`.
//
// Measured on the stage2 before the wiring (2026-08-31, gen_main3 at
// 978ccef): each non-control shape below answered by address or garbled --
// the inferred lambda's and alias call's `p < q` printed `true` where
// content says `false` (allocation order), and the lambda `+` printed an
// empty string for "ab".
//
// The fix rides the same per-module carrier as the Double channel (#2425):
// the modular check records each String relational/`+` binop's anchor
// offset, the FS merge rebases and unions the tables, and
// rewrite_string_binops_stmts rewrites exactly those binops into the same
// forms the tracker emits. Every value below is built so allocation order
// disagrees with content order -- an address compare cannot pass by luck.

fn sb_mk(s: String) -> String {
  String::concat(s, "x")
}

fn sb_id[T](v: T) -> T {
  v
}

//# Tests

test "#2391 string channel: an inferred lambda's results compare by content" {
  let id = (x) -> {
    x
  }
  let p = id(String::concat("b", "x"))
  let q = id(String::concat("a", "x"))
  inspect(__to_string(p < q), "false")
  inspect(__to_string(p > q), "true")
  inspect(__to_string(p <= q), "false")
  inspect(__to_string(q >= p), "false")
}

test "#2391 string channel: a call through a local alias" {
  let f = sb_mk
  let p = f("b")
  let q = f("a")
  inspect(__to_string(p < q), "false")
}

test "#2391 string channel: `+` through an inferred lambda" {
  let id = (x) -> {
    x
  }
  let p = id(String::concat("a", ""))
  let q = id(String::concat("b", ""))
  inspect(p + q, "ab")
}

test "#2391 string channel: an IMPORTED function through an alias" {
  // The shape only the FS lane has: the callee's declaration lives in
  // another module, and the alias hides its name from the merged-program
  // tracker, so the result type reaches this comparison only through the
  // checker's import environment.
  let f = sb_dep_tag
  let p = f("b")
  let q = f("a")
  inspect(__to_string(p < q), "false")
}

test "#2391 string channel: shapes the pre-channel lowering already classified stay right" {
  // Tracked literals, a generic instantiated at String, and Array::get on an
  // annotated Array[String] all answered by content BEFORE this channel
  // (tracker, erased-generic dispatch, and element-shape recording
  // respectively); the rewrite must not disturb them.
  inspect(__to_string("aaa" < "bbb"), "true")
  let p = sb_id(String::concat("b", "x"))
  let q = sb_id(String::concat("a", "x"))
  inspect(__to_string(p < q), "false")
  let xs: Array[String] = []
  Array::push(xs, String::concat("b", "x"))
  Array::push(xs, String::concat("a", "x"))
  inspect(__to_string(Array::get(xs, 0) < Array::get(xs, 1)), "false")
}

test "#2391 string channel: Int comparisons and sums are not reclassified" {
  let id = (x) -> {
    x
  }
  let a = id(20)
  let b = id(3)
  inspect(__to_string(a < b), "false")
  inspect(__to_string(a + b), "23")
  inspect(__to_string(2 < 10), "true")
}

test "#2391 string channel: a match-scrutinee Int binop is not captured by the outer String `+`" {
  // Codex round 1 (#2429): the diagnostic anchor walk descends into a
  // match/sequence operand's first expression, so the outer String `+` and
  // the Int `+` inside the scrutinee shared n's offset, and the rewrite
  // corrupted the scrutinee -- measured pre-fix: r printed "y" (the
  // corrupted match value rendered empty) instead of "4y". The channel
  // anchor answers -1 for match/sequence operands and falls back to the
  // RIGHT operand, so the outer `+` still rewrites (by q's anchor) and the
  // scrutinee stays arithmetic.
  let id = (x) -> {
    x
  }
  let n = id(3)
  let q = id(String::concat("y", ""))
  let r = (match n + 1 {
    v => __to_string(v)
  }) + q
  inspect(r, "4y")
}

test "#2391 string channel: a block first-statement Int binop stays arithmetic" {
  let id = (x) -> {
    x
  }
  let n = id(3)
  let p = id(String::concat("x", ""))
  let q = id(String::concat("y", ""))
  let r = ({
    n + 1
    p
  }) + q
  inspect(r, "xy")
}

test "#2391 string channel: two composite String operands still classify" {
  // Codex round 2 (#2429): with BOTH operands composite (if/match), the
  // shallow anchor walk has no offset to give and the binop silently kept
  // its raw lowering -- measured pre-fix: r printed 2181843386369, the
  // i64.add of the two string reprs. The anchor now falls back to a deep
  // walk (if-condition / match-scrutinee / sequence-first); a deep anchor
  // that collides with a disagreeing binop is poisoned by the extraction,
  // so this fallback can classify but never misclassify.
  let id = (x) -> {
    x
  }
  let p = id(String::concat("x", ""))
  let q = id(String::concat("y", ""))
  let c = id(true)
  let r = (if c {
    p
  } else {
    q
  }) + (match c {
    true => q,
    false => p
  })
  inspect(r, "xy")
}

test "#2391 string channel: let-block operands classify through the value tail" {
  // Codex round 3 (#2429): a block whose statements are lets parses as an
  // ELet chain, which the first deep walk had no arm for -- both operands
  // unanchorable, the `+` stayed raw (measured pre-fix: 2181843386369).
  // The deep walk now follows a let's BODY, landing on the block's value.
  let id = (x) -> {
    x
  }
  let p = id(String::concat("x", ""))
  let q = id(String::concat("y", ""))
  let r = ({
    let a = p
    a
  }) + ({
    let b = q
    b
  })
  inspect(r, "xy")
}

test "#2391 string channel: an Int binop in the if CONDITION cannot poison the outer `+`" {
  // Codex round 3 (#2429): the first deep walk descended into the if
  // CONDITION, anchoring the outer String `+` on the Int `+` inside
  // `n + 1 == 2`; the verdict poison then discarded the shared anchor and
  // the outer stayed raw (measured pre-fix: 2199023255553). The deep walk
  // now descends into VALUE positions only (then-branch / first arm body /
  // sequence tail / let body), whose type is the operand's own -- so the
  // anchor lands on p and never meets the condition's arithmetic.
  let id = (x) -> {
    x
  }
  let n = id(1)
  let p = id(String::concat("x", ""))
  let q = id(String::concat("z", ""))
  let c = id(true)
  let r = (if n + 1 == 2 {
    p
  } else {
    q
  }) + (match c {
    true => id(String::concat("y", "")),
    false => q
  })
  inspect(r, "xy")
}

test "#2391 string channel: the Double half of the carrier still answers" {
  let f = () -> {
    2.5
  }
  inspect(__to_string(f()), "2.5")
}
