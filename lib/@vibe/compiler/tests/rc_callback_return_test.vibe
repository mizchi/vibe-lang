test "callback result reclamation: mixed_alias" {
  assert_reclaims("enum Node { Leaf(Int); Pair(Node, Node) }\nstruct Holder { node: Node }\nfn total(n: Node) -> Int { match n { Pair(a,b) => total(a) + total(b), Leaf(v) => v } }\nfn once(c: Bool) -> Int { let f = () -> { let ys = [Pair(Leaf(3), Leaf(4))]; let t = if c { Pair(Leaf(1), Leaf(2)) } else { Array::get(ys, 0) }; t }; let r = f(); total(r) }\nfn main() -> Int { let mut i = 0; while i < 20000 { let r = once(i % 2 == 0); i = i + 1 }; 0 }", "mixed_alias")
}

test "callback result reclamation: scalar_global_shadow" {
  assert_reclaims("enum Node { Leaf(Int); Pair(Node, Node) }\nstruct Holder { node: Node }\nfn total(n: Node) -> Int { match n { Pair(a,b) => total(a) + total(b), Leaf(v) => v } }\nfn make() -> Int { 1 }\nfn once(c: Bool) -> Int { let make = () -> Pair(Leaf(3), Leaf(4)); let r = make(); total(r) }\nfn main() -> Int { let mut i = 0; while i < 20000 { let r = once(i % 2 == 0); i = i + 1 }; 0 }", "scalar_global_shadow")
}

test "callback return: unannotated_named" {
  assert_lanes("enum Node { Leaf(Int); Pair(Node, Node) }\n\nfn total(n: Node) -> Int {\n  match n {\n    Pair(a, b) => total(a) + total(b),\n    Leaf(v) => v\n  }\n}\n\nlet first = (ys) -> Array::get(ys, 0)\nfn use2(c: Bool, mk: (Array[Node]) -> Node, xs: Array[Node]) -> Node {\n  let t = mk(xs)\n  if c { t } else { Leaf(9) }\n}\n\nfn pick(c: Bool) -> Int {\n  let xs = [Pair(Leaf(3), Leaf(4))]\n  let r = use2(c, first, xs)\n  let filler = Pair(Leaf(7), Leaf(8))\n  total(r) * 10000 + total(Array::get(xs, 0)) * 100 + total(filler)\n}\n\nfn main() -> Int { pick(false) }\n", "unannotated_named", "90715")
}

test "callback return: named_borrow_wrapper" {
  assert_lanes("enum Node { Leaf(Int); Pair(Node, Node) }\n\nfn total(n: Node) -> Int {\n  match n {\n    Pair(a, b) => total(a) + total(b),\n    Leaf(v) => v\n  }\n}\n\nfn first(ys: Array[Node]) -> Node { Array::get(ys, 0) }\nfn alias(ys: Array[Node]) -> Node { first(ys) }\nfn use2(c: Bool, mk: (Array[Node]) -> Node, xs: Array[Node]) -> Node {\n  let t = mk(xs)\n  if c { t } else { Leaf(9) }\n}\n\nfn pick(c: Bool) -> Int {\n  let xs = [Pair(Leaf(3), Leaf(4))]\n  let r = use2(c, alias, xs)\n  let filler = Pair(Leaf(7), Leaf(8))\n  total(r) * 10000 + total(Array::get(xs, 0)) * 100 + total(filler)\n}\n\nfn main() -> Int { pick(false) }\n", "named_borrow_wrapper", "90715")
}

test "callback return: float_alias_representation" {
  assert_lanes("fn main() -> Int { let f = (c: Bool) -> Double { let a = 1.5; let b = 2.5; let x = if c { a } else { b }; let y = x * x; if y == 6.25 { x } else { 0.0 } }; if f(false) == 2.5 { 1 } else { 0 } }", "float_alias_representation", "1")
}

test "callback return: bool_alias_representation" {
  assert_lanes("fn main() -> Int { let f = (c: Bool) -> Bool { let a = true; let b = false; let x = if c { a } else { b }; let s = __to_string(x); if s == \"false\" { x } else { true } }; if f(false) { 0 } else { 1 } }", "bool_alias_representation", "1")
}

test "callback return: string_alias_representation" {
  assert_lanes("fn main() -> Int { let f = (c: Bool) -> String { let a = \"zz\"; let b = \"aa\"; let x = if c { a } else { b }; if x < \"bb\" { x } else { \"wrong\" } }; if f(false) == \"aa\" { 1 } else { 0 } }", "string_alias_representation", "1")
}

test "callback return: marker_name_shadow" {
  assert_lanes("fn __lambda_return_owned(n: Int) -> Int { n + 3 }\nfn main() -> Int { let f = (n: Int) -> __lambda_return_owned(n); f(4) }", "marker_name_shadow", "7")
}

test "rc-classify uses the named callback return contract" {
  let direct = "fn first(xs: Array[Int]) -> Int { Array::get(xs, 0) }\nfn main() -> Int { first([3]) }"
  let valued = "fn first(xs: Array[Int]) -> Int { Array::get(xs, 0) }\nfn main() -> Int { let f = first; f([3]) }"
  let direct_rows: String = rc_classify_source(direct)
  let direct_borrows: Bool = String::contains(direct_rows, "first borrow_ret")
  inspect(direct_borrows, content = "true")
  let valued_rows: String = rc_classify_source(valued)
  let valued_borrows: Bool = String::contains(valued_rows, "first borrow_ret")
  inspect(valued_borrows, content = "false")
}

test "a local callback cannot inherit a scalar global return contract" {
  assert_reclaims("enum Node { Leaf(Int); Pair(Node, Node) }\nfn make() -> Int { 0 }\nfn once() -> Int { let make = () -> Pair(Leaf(1), Leaf(2)); let unused = make(); 0 }\nfn main() -> Int { let mut i = make(); while i < 20000 { let r = once(); i = i + 1 }; 0 }", "unused_scalar_shadow")
}

test "callback return: handled_return" {
  assert_lanes("enum Node { Leaf(Int); Pair(Node, Node) }\n\nfn total(n: Node) -> Int {\n  match n {\n    Pair(a, b) => total(a) + total(b),\n    Leaf(v) => v\n  }\n}\n\nfn use2(c: Bool, mk: (Array[Node]) -> Node, xs: Array[Node]) -> Node {\n  let t = mk(xs)\n  if c { t } else { Leaf(9) }\n}\n\nfn pick(c: Bool) -> Int {\n  let xs = [Pair(Leaf(3), Leaf(4))]\n  let r = use2(c, (ys) -> handle { Array::get(ys, 0) } with { Exception::Throw(_) => Leaf(0) }, xs)\n  let filler = Pair(Leaf(7), Leaf(8))\n  total(r) * 10000 + total(Array::get(xs, 0)) * 100 + total(filler)\n}\n\nfn main() -> Int { pick(false) }\n", "handled_return", "90715")
}

test "callback return: loop_return" {
  assert_lanes("enum Node { Leaf(Int); Pair(Node, Node) }\n\nfn total(n: Node) -> Int {\n  match n {\n    Pair(a, b) => total(a) + total(b),\n    Leaf(v) => v\n  }\n}\n\nfn use2(c: Bool, mk: (Array[Node]) -> Node, xs: Array[Node]) -> Node {\n  let t = mk(xs)\n  if c { t } else { Leaf(9) }\n}\n\nfn pick(c: Bool) -> Int {\n  let xs = [Pair(Leaf(3), Leaf(4))]\n  let r = use2(c, (ys) -> loop { break Array::get(ys, 0) }, xs)\n  let filler = Pair(Leaf(7), Leaf(8))\n  total(r) * 10000 + total(Array::get(xs, 0)) * 100 + total(filler)\n}\n\nfn main() -> Int { pick(false) }\n", "loop_return", "90715")
}
