import @vibe/compiler/runtime {
  rc_classify_source
}

// #2754: ordinary RC must agree with bump when a callback returns a borrow.
// Shadow RC alone masked the corruption by keeping the freed block intact.
import ./codegen_test_support.vibe {
  compile_wasi, compile_wasi_rc, compile_wasi_rc_shadow
}

fn run_value(bytes: Bytes, label: String) -> String with Fs + Process {
  let path = String::concat("/tmp/_callback_return_", String::concat(label, ".wasm"))
  Fs::write_bytes(path, bytes)
  let out = sh_lines(String::concat("wasmtime run -W exceptions=y --invoke main ", String::concat(path, " 0 2>/dev/null")))
  if Array::length(out) > 0 {
    Array::get(out, 0)
  } else {
    "<no output>"
  }
}

fn assert_lanes(src: String, label: String, expected: String) -> Unit with Exception + Fs + Process + Stdout {
  inspect(run_value(compile_wasi(src, "main"), String::concat(label, "_bump")), content = expected)
  inspect(run_value(compile_wasi_rc(src, "main"), String::concat(label, "_rc")), content = expected)
  inspect(run_value(compile_wasi_rc_shadow(src, "main"), String::concat(label, "_shadow")), content = expected)
}

test "callback parameter returning an array element" {
  assert_lanes("enum Node { Leaf(Int); Pair(Node, Node) }\n\nfn total(n: Node) -> Int {\n  match n {\n    Pair(a, b) => total(a) + total(b),\n    Leaf(v) => v\n  }\n}\n\nfn use2(c: Bool, mk: (Array[Node]) -> Node, xs: Array[Node]) -> Node {\n  let t = mk(xs)\n  if c { t } else { Leaf(9) }\n}\n\nfn pick(c: Bool) -> Int {\n  let xs = [Pair(Leaf(3), Leaf(4))]\n  let r = use2(c, (ys) -> Array::get(ys, 0), xs)\n  let filler = Pair(Leaf(7), Leaf(8))\n  total(r) * 10000 + total(Array::get(xs, 0)) * 100 + total(filler)\n}\n\nfn main() -> Int { pick(false) }\n", "parameter", "90715")
}

test "callback return: annotated" {
  assert_lanes("enum Node { Leaf(Int); Pair(Node, Node) }\n\nfn total(n: Node) -> Int {\n  match n {\n    Pair(a, b) => total(a) + total(b),\n    Leaf(v) => v\n  }\n}\n\nfn use2(c: Bool, mk: (Array[Node]) -> Node, xs: Array[Node]) -> Node {\n  let t = mk(xs)\n  if c { t } else { Leaf(9) }\n}\n\nfn pick(c: Bool) -> Int {\n  let xs = [Pair(Leaf(3), Leaf(4))]\n  let r = use2(c, (ys: Array[Node]) -> Array::get(ys, 0), xs)\n  let filler = Pair(Leaf(7), Leaf(8))\n  total(r) * 10000 + total(Array::get(xs, 0)) * 100 + total(filler)\n}\n\nfn main() -> Int { pick(false) }\n", "annotated", "90715")
}

test "callback return: named" {
  assert_lanes("enum Node { Leaf(Int); Pair(Node, Node) }\n\nfn total(n: Node) -> Int {\n  match n {\n    Pair(a, b) => total(a) + total(b),\n    Leaf(v) => v\n  }\n}\n\nfn first(ys: Array[Node]) -> Node { Array::get(ys, 0) }\n\nfn use2(c: Bool, mk: (Array[Node]) -> Node, xs: Array[Node]) -> Node {\n  let t = mk(xs)\n  if c { t } else { Leaf(9) }\n}\n\nfn pick(c: Bool) -> Int {\n  let xs = [Pair(Leaf(3), Leaf(4))]\n  let r = use2(c, first, xs)\n  let filler = Pair(Leaf(7), Leaf(8))\n  total(r) * 10000 + total(Array::get(xs, 0)) * 100 + total(filler)\n}\n\nfn main() -> Int { pick(false) }\n", "named", "90715")
}

