  assert_lanes(src = "fn main() -> Int { let f = (c: Bool) -> Bool { let a = true; let b = false; let x = if c { a } else { b }; let s = __to_string(x); if s == \"false\" { x } else { true } }; if f(false) { 0 } else { 1 } }", label = "bool_alias_representation", expected = "1")
}

