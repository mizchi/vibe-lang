  assert_reclaims("enum Node { Leaf(Int); Pair(Node, Node) }\nstruct Holder { node: Node }\nfn total(n: Node) -> Int { match n { Pair(a,b) => total(a) + total(b), Leaf(v) => v } }\nfn once(c: Bool) -> Int { let f = () -> { let n = Pair(Leaf(3), Leaf(4)); n }; let r = f(); total(r) }\nfn main() -> Int { let mut i = 0; while i < 20000 { let r = once(i % 2 == 0); i = i + 1 }; 0 }", "owned_alias")
