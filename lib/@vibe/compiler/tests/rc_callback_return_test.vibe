}

fn assert_reclaims(src: String, label: String) -> Unit with Exception + Fs + Process + Console {
  let path = String::concat("/tmp/_callback_heap_", String::concat(label, ".wasm"))
  Fs::write_bytes(path, bytes = compile_wasi_rc(source = src, entry = "main"))
  let check = " | node -e 'let s=\"\";process.stdin.on(\"data\",x=>s+=x);process.stdin.on(\"end\",()=>{const r=JSON.parse(s);console.log(r.result===0 && r.heap_used<2000)})'"
  let out = sh_lines(String::concat("node --experimental-wasm-exnref scripts/measure_heap.mjs ", String::concat(path, check)))
  let actual: String = if Array::length(out) > 0 {
    Array::get(out, at = 0)
  } else {
    "<no output>"
  }
  inspect(actual, content = "true")
}

test "callback result reclamation: fresh_call_root" {
  assert_reclaims(src = "enum Node { Leaf(Int); Pair(Node, Node) }\nstruct Holder { node: Node }\nfn total(n: Node) -> Int { match n { Pair(a,b) => total(a) + total(b), Leaf(v) => v } }\nfn once(c: Bool) -> Int { let f = () -> { let ys = [Pair(Leaf(3), Leaf(4))]; Array::get(ys, 0) }; let r = f(); total(r) }\nfn main() -> Int { let mut i = 0; while i < 20000 { let r = once(i % 2 == 0); i = i + 1 }; 0 }", label = "fresh_call_root")
}

test "callback result reclamation: fresh_projection_root" {
