test "callback return: early_return" {
  assert_lanes("enum Node { Leaf(Int); Pair(Node, Node) }\n\nfn total(n: Node) -> Int {\n  match n {\n    Pair(a, b) => total(a) + total(b),\n    Leaf(v) => v\n  }\n}\n\nfn use2(c: Bool, mk: (Array[Node]) -> Node, xs: Array[Node]) -> Node {\n  let t = mk(xs)\n  if c { t } else { Leaf(9) }\n}\n\nfn pick(c: Bool) -> Int {\n  let xs = [Pair(Leaf(3), Leaf(4))]\n  let r = use2(c, (ys) -> { if !c { return Array::get(ys, 0) }; Leaf(1) }, xs)\n  let filler = Pair(Leaf(7), Leaf(8))\n  total(r) * 10000 + total(Array::get(xs, 0)) * 100 + total(filler)\n}\n\nfn main() -> Int { pick(false) }\n", "early_return", "90715")
}

test "callback return: mixed_alias" {
  assert_lanes("enum Node { Leaf(Int); Pair(Node, Node) }\n\nfn total(n: Node) -> Int {\n  match n {\n    Pair(a, b) => total(a) + total(b),\n    Leaf(v) => v\n  }\n}\n\nfn use2(c: Bool, mk: (Array[Node]) -> Node, xs: Array[Node]) -> Node {\n  let t = mk(xs)\n  if c { t } else { Leaf(9) }\n}\n\nfn pick(c: Bool) -> Int {\n  let xs = [Pair(Leaf(3), Leaf(4))]\n  let r = use2(c, (ys) -> { let z = if c { Leaf(1) } else { Array::get(ys, 0) }; z }, xs)\n  let filler = Pair(Leaf(7), Leaf(8))\n  total(r) * 10000 + total(Array::get(xs, 0)) * 100 + total(filler)\n}\n\nfn main() -> Int { pick(false) }\n", "mixed_alias", "90715")
}

fn assert_reclaims(src: String, label: String) -> Unit with Exception + Fs + Process + Stdout {
  let path = String::concat("/tmp/_callback_heap_", String::concat(label, ".wasm"))
  Fs::write_bytes(path, compile_wasi_rc(src, "main"))
  let check = " | node -e 'let s=\"\";process.stdin.on(\"data\",x=>s+=x);process.stdin.on(\"end\",()=>{const r=JSON.parse(s);console.log(r.result===0 && r.heap_used<2000)})'"
  let out = sh_lines(String::concat("node --experimental-wasm-exnref scripts/measure_heap.mjs ", String::concat(path, check)))
  let actual: String = if Array::length(out) > 0 {
    Array::get(out, 0)
  } else {
    "<no output>"
  }
  inspect(actual, content = "true")
}

test "callback result reclamation: fresh_call_root" {
  assert_reclaims("enum Node { Leaf(Int); Pair(Node, Node) }\nstruct Holder { node: Node }\nfn total(n: Node) -> Int { match n { Pair(a,b) => total(a) + total(b), Leaf(v) => v } }\nfn once(c: Bool) -> Int { let f = () -> { let ys = [Pair(Leaf(3), Leaf(4))]; Array::get(ys, 0) }; let r = f(); total(r) }\nfn main() -> Int { let mut i = 0; while i < 20000 { let r = once(i % 2 == 0); i = i + 1 }; 0 }", "fresh_call_root")
}

test "callback result reclamation: fresh_projection_root" {
  assert_reclaims("enum Node { Leaf(Int); Pair(Node, Node) }\nstruct Holder { node: Node }\nfn total(n: Node) -> Int { match n { Pair(a,b) => total(a) + total(b), Leaf(v) => v } }\nfn once(c: Bool) -> Int { let f = () -> { let h = Holder::{ node: Pair(Leaf(3), Leaf(4)) }; h.node }; let r = f(); total(r) }\nfn main() -> Int { let mut i = 0; while i < 20000 { let r = once(i % 2 == 0); i = i + 1 }; 0 }", "fresh_projection_root")
}

