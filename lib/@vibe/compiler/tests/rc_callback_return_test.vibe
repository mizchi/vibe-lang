test "callback return: float_alias_representation" {
  assert_lanes(src = "fn main() -> Int { let f = (c: Bool) -> Float64 { let a = 1.5; let b = 2.5; let x = if c { a } else { b }; let y = x * x; if y == 6.25 { x } else { 0.0 } }; if f(false) == 2.5 { 1 } else { 0 } }", label = "float_alias_representation", expected = "1")
}

