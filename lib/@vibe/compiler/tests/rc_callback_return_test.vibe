  assert_lanes(src = "fn main() -> Int { let f = (c: Bool) -> String { let a = \"zz\"; let b = \"aa\"; let x = if c { a } else { b }; if x < \"bb\" { x } else { \"wrong\" } }; if f(false) == \"aa\" { 1 } else { 0 } }", label = "string_alias_representation", expected = "1")
