import @vibe/compiler/query {
  rc_classify_source
}

// #2754: ordinary RC must agree with bump when a callback returns a borrow.
// Shadow RC alone masked the corruption by keeping the freed block intact.
import ./codegen_test_support.vibe {
  compile_wasi, compile_wasi_rc, compile_wasi_rc_shadow
}

fn run_value(bytes: Bytes, label: String) -> String with Fs + Process {
  let path = String::concat("/tmp/_callback_return_", String::concat(label, ".wasm"))
  Fs::write_bytes(path, bytes = bytes)
  let out = sh_lines(String::concat("wasmtime run -W exceptions=y --invoke main ", String::concat(path, " 0 2>/dev/null")))
  if Array::length(out) > 0 {
    Array::get(out, at = 0)
  } else {
    "<no output>"
  }
}

fn assert_lanes(src: String, label: String, expected: String) -> Unit with Exception + Fs + Process + Console {
  inspect(run_value(bytes = compile_wasi(source = src, entry = "main"), label = String::concat(label, "_bump")), content = expected)
  inspect(run_value(bytes = compile_wasi_rc(source = src, entry = "main"), label = String::concat(label, "_rc")), content = expected)
  inspect(run_value(bytes = compile_wasi_rc_shadow(source = src, entry = "main"), label = String::concat(label, "_shadow")), content = expected)
}

test "callback parameter returning an array element" {
  assert_lanes(src = "enum Node { Leaf(Int); Pair(Node, Node) }\n\nfn total(n: Node) -> Int {\n  match n {\n    Pair(a, b) => total(a) + total(b),\n    Leaf(v) => v\n  }\n}\n\nfn use2(c: Bool, mk: (Array[Node]) -> Node, xs: Array[Node]) -> Node {\n  let t = mk(xs)\n  if c { t } else { Leaf(9) }\n}\n\nfn pick(c: Bool) -> Int {\n  let xs = [Pair(Leaf(3), Leaf(4))]\n  let r = use2(c, (ys) -> Array::get(ys, 0), xs)\n  let filler = Pair(Leaf(7), Leaf(8))\n  total(r) * 10000 + total(Array::get(xs, 0)) * 100 + total(filler)\n}\n\nfn main() -> Int { pick(false) }\n", label = "parameter", expected = "90715")
}

