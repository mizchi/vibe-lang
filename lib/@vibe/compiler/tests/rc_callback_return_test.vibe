test "callback return: marker_name_shadow" {
  assert_lanes(src = "fn __lambda_return_owned(n: Int) -> Int { n + 3 }\nfn main() -> Int { let f = (n: Int) -> __lambda_return_owned(n); f(4) }", label = "marker_name_shadow", expected = "7")
}

test "rc-classify uses the named callback return contract" {
  let direct = "fn first(xs: Array[Int]) -> Int { Array::get(xs, 0) }\nfn main() -> Int { first([3]) }"
  let valued = "fn first(xs: Array[Int]) -> Int { Array::get(xs, 0) }\nfn main() -> Int { let f = first; f([3]) }"
  let direct_rows: String = rc_classify_source(direct)
  let direct_borrows: Bool = String::contains(direct_rows, needle = "first borrow_ret")
  inspect(direct_borrows, content = "true")
  let valued_rows: String = rc_classify_source(valued)
  let valued_borrows: Bool = String::contains(valued_rows, needle = "first borrow_ret")
  inspect(valued_borrows, content = "false")
}

test "a local callback cannot inherit a scalar global return contract" {
  assert_reclaims(src = "enum Node { Leaf(Int); Pair(Node, Node) }\nfn make() -> Int { 0 }\nfn once() -> Int { let make = () -> Pair(Leaf(1), Leaf(2)); let unused = make(); 0 }\nfn main() -> Int { let mut i = make(); while i < 20000 { let r = once(); i = i + 1 }; 0 }", label = "unused_scalar_shadow")
}

test "callback return: handled_return" {
  assert_lanes(src = "enum Node { Leaf(Int); Pair(Node, Node) }\n\nfn total(n: Node) -> Int {\n  match n {\n    Pair(a, b) => total(a) + total(b),\n    Leaf(v) => v\n  }\n}\n\nfn use2(c: Bool, mk: (Array[Node]) -> Node, xs: Array[Node]) -> Node {\n  let t = mk(xs)\n  if c { t } else { Leaf(9) }\n}\n\nfn pick(c: Bool) -> Int {\n  let xs = [Pair(Leaf(3), Leaf(4))]\n  let r = use2(c, (ys) -> handle { Array::get(ys, 0) } with { Exception::Throw(_) => Leaf(0) }, xs)\n  let filler = Pair(Leaf(7), Leaf(8))\n  total(r) * 10000 + total(Array::get(xs, 0)) * 100 + total(filler)\n}\n\nfn main() -> Int { pick(false) }\n", label = "handled_return", expected = "90715")
}

test "callback return: loop_return" {
  assert_lanes(src = "enum Node { Leaf(Int); Pair(Node, Node) }\n\nfn total(n: Node) -> Int {\n  match n {\n    Pair(a, b) => total(a) + total(b),\n    Leaf(v) => v\n  }\n}\n\nfn use2(c: Bool, mk: (Array[Node]) -> Node, xs: Array[Node]) -> Node {\n  let t = mk(xs)\n  if c { t } else { Leaf(9) }\n}\n\nfn pick(c: Bool) -> Int {\n  let xs = [Pair(Leaf(3), Leaf(4))]\n  let r = use2(c, (ys) -> loop { break Array::get(ys, 0) }, xs)\n  let filler = Pair(Leaf(7), Leaf(8))\n  total(r) * 10000 + total(Array::get(xs, 0)) * 100 + total(filler)\n}\n\nfn main() -> Int { pick(false) }\n", label = "loop_return", expected = "90715")
}

// PR #2804: a mixed helper returns an owned value or an interior view.

test "callback return: may_view_helper_discard" {
  assert_lanes(src = "enum Node { Leaf(Int); Pair(Node, Node) }\nfn total(n: Node) -> Int { match n { Pair(a,b) => total(a) + total(b), Leaf(v) => v } }\nfn choose(c: Bool, xs: Array[Node]) -> Node { if c { Pair(Leaf(1), Leaf(2)) } else { Array::get(xs, 0) } }\nfn use2(c: Bool, mk: (Array[Node]) -> Node, xs: Array[Node]) -> Node { let t = mk(xs); if c { t } else { Leaf(9) } }\nfn pick(c: Bool) -> Int { let xs = [Pair(Leaf(3), Leaf(4))]; let r = use2(c, (ys) -> choose(false, ys), xs); let filler = Pair(Leaf(7), Leaf(8)); total(r)*10000 + total(Array::get(xs,0))*100 + total(filler) }\nfn main() -> Int { pick(false) }", label = "may_view_helper_discard", expected = "90715")
}

test "callback return: may_view_helper_keep" {
  assert_lanes(src = "enum Node { Leaf(Int); Pair(Node, Node) }\nfn total(n: Node) -> Int { match n { Pair(a,b) => total(a) + total(b), Leaf(v) => v } }\nfn choose(c: Bool, xs: Array[Node]) -> Node { if c { Pair(Leaf(1), Leaf(2)) } else { Array::get(xs, 0) } }\nfn use2(c: Bool, mk: (Array[Node]) -> Node, xs: Array[Node]) -> Node { let t = mk(xs); if c { t } else { Leaf(9) } }\nfn pick(c: Bool) -> Int { let xs = [Pair(Leaf(3), Leaf(4))]; let r = use2(c, (ys) -> choose(false, ys), xs); let filler = Pair(Leaf(7), Leaf(8)); total(r)*10000 + total(Array::get(xs,0))*100 + total(filler) }\nfn main() -> Int { pick(true) }", label = "may_view_helper_keep", expected = "70715")
}

test "callback result reclamation: may_view_helper" {
  assert_reclaims(src = "enum Node { Leaf(Int); Pair(Node, Node) }\nfn total(n: Node) -> Int { match n { Pair(a,b) => total(a) + total(b), Leaf(v) => v } }\nfn choose(c: Bool, xs: Array[Node]) -> Node { if c { Pair(Leaf(1), Leaf(2)) } else { Array::get(xs, 0) } }\nfn once(c: Bool) -> Int { let f = (xs: Array[Node]) -> choose(c, xs); let r = f([Pair(Leaf(3), Leaf(4))]); total(r) }\nfn main() -> Int { let mut i = 0; while i < 20000 { let r = once(i % 2 == 0); i = i + 1 }; 0 }", label = "may_view_helper")
}

test "callback return: may_view_helper_local_owner" {
  assert_lanes(src = "enum Node { Leaf(Int); Pair(Node, Node) }\nfn total(n: Node) -> Int { match n { Pair(a,b) => total(a) + total(b), Leaf(v) => v } }\nfn choose(c: Bool, xs: Array[Node]) -> Node { if c { Pair(Leaf(1), Leaf(2)) } else { Array::get(xs, 0) } }\nfn main() -> Int { let f = () -> { let xs = [Pair(Leaf(3), Leaf(4))]; choose(false, xs) }; let r = f(); let filler = Pair(Leaf(7), Leaf(8)); total(r)*100 + total(filler) }", label = "may_view_helper_local_owner", expected = "715")
}

test "callback result reclamation: may_view_helper_chain" {
  assert_reclaims(src = "enum Node { Leaf(Int); Pair(Node, Node) }\nfn total(n: Node) -> Int { match n { Pair(a,b) => total(a) + total(b), Leaf(v) => v } }\nfn choose(c: Bool, xs: Array[Node]) -> Node { if c { Pair(Leaf(1), Leaf(2)) } else { Array::get(xs, 0) } }\nfn relay3(c: Bool, xs: Array[Node]) -> Node { choose(c, xs) }\nfn relay2(c: Bool, xs: Array[Node]) -> Node { relay3(c, xs) }\nfn relay1(c: Bool, xs: Array[Node]) -> Node { relay2(c, xs) }\nfn once(c: Bool) -> Int { let f = (xs: Array[Node]) -> relay1(c, xs); let r = f([Pair(Leaf(3), Leaf(4))]); let direct = relay1(c, [Pair(Leaf(3), Leaf(4))]); total(r) + total(direct) }\nfn main() -> Int { let mut i = 0; while i < 20000 { let r = once(i % 2 == 0); i = i + 1 }; 0 }", label = "may_view_helper_chain")
}

test "callback result reclamation: may_view_named_callback" {
  assert_reclaims(src = "enum Node { Leaf(Int); Pair(Node, Node) }\nfn total(n: Node) -> Int { match n { Pair(a,b) => total(a) + total(b), Leaf(v) => v } }\nfn choose(c: Bool, xs: Array[Node]) -> Node { if c { Pair(Leaf(1), Leaf(2)) } else { Array::get(xs, 0) } }\nfn forward(c: Bool, xs: Array[Node]) -> Node { choose(c, xs) }\nfn once(c: Bool) -> Int { let f = forward; let r = f(c, [Pair(Leaf(3), Leaf(4))]); total(r) }\nfn main() -> Int { let mut i = 0; while i < 20000 { let r = once(i % 2 == 0); i = i + 1 }; 0 }", label = "may_view_named_callback")
}

test "callback result reclamation: may_view_builtin_spelling" {
  assert_reclaims(src = "enum Node { Leaf(Int); Pair(Node, Node) }\nfn total(n: Node) -> Int { match n { Pair(a,b) => total(a) + total(b), Leaf(v) => v } }\nfn map(c: Bool, xs: Array[Node]) -> Node { if c { Pair(Leaf(1), Leaf(2)) } else { Array::get(xs, 0) } }\nfn once(c: Bool) -> Int { let f = (xs: Array[Node]) -> map(c, xs); let r = f([Pair(Leaf(3), Leaf(4))]); total(r) }\nfn main() -> Int { let mut i = 0; while i < 20000 { let r = once(i % 2 == 0); i = i + 1 }; 0 }", label = "may_view_builtin_spelling")
