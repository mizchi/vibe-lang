test "callback return: projection" {
  assert_lanes(src = "enum Node { Leaf(Int); Pair(Node, Node) }\n\nfn total(n: Node) -> Int {\n  match n {\n    Pair(a, b) => total(a) + total(b),\n    Leaf(v) => v\n  }\n}\n\nstruct Holder { node: Node }\nfn use2(c: Bool, mk: (Array[Node]) -> Node, xs: Array[Node]) -> Node {\n  let t = mk(xs)\n  if c { t } else { Leaf(9) }\n}\n\nfn pick(c: Bool) -> Int {\n  let xs = [Pair(Leaf(3), Leaf(4))]\n  let r = use2(c, (ys) -> { let h = Holder::{ node: Array::get(ys, 0) }; h.node }, xs)\n  let filler = Pair(Leaf(7), Leaf(8))\n  total(r) * 10000 + total(Array::get(xs, 0)) * 100 + total(filler)\n}\n\nfn main() -> Int { pick(false) }\n", label = "projection", expected = "90715")
}

