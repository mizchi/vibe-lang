//# Imports

import @vibe/compiler/core {
  Pat
}

import ../cst.vibe {
  CstChild, NodeKind
}

import ../lower.vibe {
  lower_pat
}

import @vibe/compiler/syntax {
  Token
}

//# Misc

test "lower PWild" {
  let node = CNode(NWildPat, [CToken(TIdent("_"))])
  match lower_pat(node) {
    PWild => assert(true),
    _ => assert(false)
  }
}

test "lower PBind" {
  let node = CNode(NBindPat, [CToken(TIdent("x"))])
  match lower_pat(node) {
    PBind(name) => assert(name == "x"),
    _ => assert(false)
  }
}

test "lower PInt" {
  let node = CNode(NIntPat, [CToken(TInt(42))])
  match lower_pat(node) {
    PInt(n) => assert(n == 42),
    _ => assert(false)
  }
}

test "lower PString" {
  let node = CNode(NStringPat, [CToken(TString("hello"))])
  match lower_pat(node) {
    PString(s) => assert(s == "hello"),
    _ => assert(false)
  }
}

test "lower PBool true" {
  let node = CNode(NBoolPat, [CToken(TIdent("true"))])
  match lower_pat(node) {
    PBool(b) => assert(b == true),
    _ => assert(false)
  }
}

test "lower PBool false" {
  let node = CNode(NBoolPat, [CToken(TIdent("false"))])
  match lower_pat(node) {
    PBool(b) => assert(b == false),
    _ => assert(false)
  }
}

test "lower PTuple" {
  let node = CNode(NTuplePat, [
    CToken(TLParen),
    CNode(NBindPat, [CToken(TIdent("a"))]),
    CToken(TComma),
    CNode(NBindPat, [CToken(TIdent("b"))]),
    CToken(TRParen)
  ])
  match lower_pat(node) {
    PTuple(pats) => assert(Array::length(pats) == 2),
    _ => assert(false)
  }
}

test "lower PCtor no args" {
  let node = CNode(NCtorPat, [CToken(TIdent("None"))])
  match lower_pat(node) {
    PCtor(name, args) => {
      assert(name == "None")
      assert(Array::length(args) == 0)
    },
    _ => assert(false)
  }
}

test "lower PCtor with args" {
  let node = CNode(NCtorPat, [
    CToken(TIdent("Some")),
    CToken(TLParen),
    CNode(NBindPat, [CToken(TIdent("x"))]),
    CToken(TRParen)
  ])
  match lower_pat(node) {
    PCtor(name, args) => {
      assert(name == "Some")
      assert(Array::length(args) == 1)
    },
    _ => assert(false)
  }
}

test "lower POr" {
  let node = CNode(NOrPat, [
    CNode(NIntPat, [CToken(TInt(1))]),
    CToken(TBitOr),
    CNode(NIntPat, [CToken(TInt(2))])
  ])
  match lower_pat(node) {
    POr(_, _) => assert(true),
    _ => assert(false)
  }
}
