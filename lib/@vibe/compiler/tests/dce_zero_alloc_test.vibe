import @vibe/compiler/core {
  Expr, Stmt, dce_keep_flags, dce_keep_flags_via, dce_stmts, dce_stmts_before_trait_desugar
}

import @vibe/compiler/codegen/common_analysis {
  zero_alloc_check
}

fn za_fn(name: String, body: Expr) -> Stmt {
  SLet(false, false, name, None, EFn([], [], [], None, None, body))
}

test "late DCE removes a marker with its unused function" {
  let stmts = [
    SExpr(EIdent("@zero_alloc", -1)),
    za_fn(name = "unused", body = EInt(1)),
    SExpr(EIdent("@zero_alloc_strict", -1)),
    za_fn(name = "used", body = EInt(2))
  ]
  let kept = dce_stmts(stmts = stmts, entry_names = ["used"])
  inspect(Array::length(kept), "2")
  match Array::get(kept, at = 0) {
    SExpr(EIdent(name, _)) => inspect(name, "@zero_alloc_strict"),
    _ => assert_true(false)
  }
}

test "early DCE retains annotated functions and their transitive callees" {
  let stmts = [
    za_fn(name = "leaf", body = EInt(1)),
    za_fn(name = "helper", body = ECall(EIdent("leaf", -1), [], -1, [])),
    SExpr(EIdent("@zero_alloc", -1)),
    za_fn(name = "unused", body = ECall(EIdent("helper", -1), [], -1, [])),
    za_fn(name = "main", body = EInt(0)),
    za_fn(name = "dead", body = EInt(9))
  ]
  let early = dce_stmts_before_trait_desugar(stmts = stmts, entry_names = [
    "main"
  ])
  inspect(Array::length(early), "5")
  inspect(Array::length(dce_stmts(stmts = early, entry_names = ["main"])), "1")
}

test "early DCE retains marked preserved declarations for validation" {
  let stmts = [
    SExpr(EIdent("@zero_alloc_assume", -1)),
    SFnDecl(false, "unused", EFn([], [], [], None, None, EInt(0)), [], []),
    za_fn(name = "main", body = EInt(0))
  ]
  inspect(Array::length(dce_stmts_before_trait_desugar(stmts = stmts, entry_names = [
    "main"
  ])), "3")
  inspect(Array::length(dce_stmts(stmts = stmts, entry_names = ["main"])), "1")
}

test "malformed marker adjacency survives DCE for refusal" {
  let stmts = [
    SExpr(EIdent("@zero_alloc", -1)),
    SLet(false, false, "dead", None, EInt(0)),
    za_fn(name = "main", body = EInt(0))
  ]
  inspect(Array::length(dce_stmts(stmts = stmts, entry_names = ["main"])), "3")
}

test "trailing marker survives DCE for refusal" {
  let stmts = [
    za_fn(name = "main", body = EInt(0)),
    SExpr(EIdent("@zero_alloc", -1))
  ]
  inspect(Array::length(dce_stmts(stmts = stmts, entry_names = ["main"])), "2")
}

test "ordinary structural expressions retain their dependencies" {
  let stmts = [
    za_fn(name = "helper", body = EInt(1)),
    SExpr(ECall(EIdent("helper", -1), [], -1, []))
  ]
  inspect(Array::length(dce_stmts(stmts = stmts, entry_names = [])), "2")
}

test "an unused allocation contract is checked before late DCE" {
  let stmts = [
    za_fn(name = "helper", body = EArray([EInt(1)])),
    SExpr(EIdent("@zero_alloc", -1)),
    za_fn(name = "unused", body = ECall(EIdent("helper", -1), [], -1, [])),
    za_fn(name = "main", body = EInt(0))
  ]
  let early = dce_stmts_before_trait_desugar(stmts = stmts, entry_names = [
    "main"
  ])
  assert_true(String::contains(zero_alloc_check(early), needle = "fn 'unused' may allocate"))
}

test "a dead pure marker does not constrain the allocating entry" {
  let stmts = [
    SExpr(EIdent("@zero_alloc_strict", -1)),
    za_fn(name = "unused", body = EInt(1)),
    za_fn(name = "main", body = EArray([EInt(1)]))
  ]
  let early = dce_stmts_before_trait_desugar(stmts = stmts, entry_names = [
    "main"
  ])
  inspect(zero_alloc_check(early), "")
  let late = dce_stmts(stmts = early, entry_names = ["main"])
  inspect(Array::length(late), "1")
  inspect(zero_alloc_check(late), "")
}

test "keep flags remove each dead marker with its function" {
  let markers = ["@zero_alloc", "@zero_alloc_strict", "@zero_alloc_assume"]
  let mut i = 0
  while i < Array::length(markers) {
    let stmts = [
      SExpr(EIdent(Array::get(markers, at = i), -1)),
      za_fn(name = "unused", body = EInt(1)),
      za_fn(name = "main", body = EArray([EInt(3)]))
    ]
    let flags = dce_keep_flags(stmts = stmts, entry_names = ["main"])
    inspect(Array::length(flags), "3")
    assert_true(not(Array::get(flags, at = 0)))
    assert_true(not(Array::get(flags, at = 1)))
    assert_true(Array::get(flags, at = 2))
    i = i + 1
  }
}

test "keep flags preserve reachable markers and function declarations" {
  let stmts = [
    SExpr(EIdent("@zero_alloc_assume", -1)),
    SFnDecl(false, "used", EFn([], [], [], None, None, EInt(0)), [], [])
  ]
  let flags = dce_keep_flags(stmts = stmts, entry_names = ["used"])
  assert_true(Array::get(flags, at = 0))
  assert_true(Array::get(flags, at = 1))
}

test "split reachability preserves a marker reached only through a hidden body" {
  let stmts = [
    SExpr(EIdent("@zero_alloc_strict", -1)),
    za_fn(name = "helper", body = EInt(7)),
    za_fn(name = "main", body = EInt(0))
  ]
  let reach = [
    SExpr(EIdent("@zero_alloc_strict", -1)),
    za_fn(name = "helper", body = EInt(7)),
    za_fn(name = "hidden", body = ECall(EIdent("helper", -1), [], -1, [])),
    za_fn(name = "main", body = EInt(0))
  ]
  let flags = dce_keep_flags_via(stmts = stmts, reach_stmts = reach, entry_names = [
    "main"
  ])
  inspect(Array::length(flags), "3")
  assert_true(Array::get(flags, at = 0))
  assert_true(Array::get(flags, at = 1))
  assert_true(Array::get(flags, at = 2))
}

test "keep flags retain malformed marker adjacency without deleting intervening text" {
  let stmts = [
    SExpr(EIdent("@zero_alloc", -1)),
    SLet(false, false, "dead", None, EInt(0)),
    za_fn(name = "main", body = EInt(0))
  ]
  let flags = dce_keep_flags(stmts = stmts, entry_names = ["main"])
  assert_true(Array::get(flags, at = 0))
  assert_true(Array::get(flags, at = 1))
  assert_true(Array::get(flags, at = 2))
}

test "keep flags retain trailing markers and preceding dead functions for refusal" {
  let stmts = [
    za_fn(name = "dead", body = EInt(0)),
    za_fn(name = "main", body = EInt(0)),
    SExpr(EIdent("@zero_alloc", -1))
  ]
  let flags = dce_keep_flags(stmts = stmts, entry_names = ["main"])
  assert_true(Array::get(flags, at = 0))
  assert_true(Array::get(flags, at = 1))
  assert_true(Array::get(flags, at = 2))
}

test "duplicate function names keep both allocation contracts with the union of bodies" {
  let stmts = [
    SExpr(EIdent("@zero_alloc", -1)),
    za_fn(name = "same", body = EInt(1)),
    SExpr(EIdent("@zero_alloc_strict", -1)),
    za_fn(name = "same", body = EInt(2))
  ]
  let flags = dce_keep_flags(stmts = stmts, entry_names = ["same"])
  let mut i = 0
  while i < Array::length(flags) {
    assert_true(Array::get(flags, at = i))
    i = i + 1
  }
}
