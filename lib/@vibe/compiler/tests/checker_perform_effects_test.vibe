//# Imports

import @vibe/compiler/core {
  Expr, Pat, Stmt, TypeExpr
}

import @vibe/core {
  array_empty
}

import @vibe/compiler/checker {
  EffectError, check_perform_effects_expr, check_perform_effects_stmt, check_perform_effects_stmts, effect_error_to_string
}

//# Functions

/// #639: the perform-discipline pass now reports row mismatches as
/// EEEffectRowMismatch (set difference + fix-it hint).
fn is_perform_err(e: EffectError) -> Bool {
  match e {
    EEEffectRowMismatch(_, _, _, _) => true,
    _ => false
  }
}

/// `perform EffName::Op(arg)` reaches the checker as
/// ECall(EIdent("perform"), [ECall(EIdent("EffName::Op"), [arg])]).
fn perform_op(op: String, arg: Expr) -> Expr {
  ECall(EIdent("perform", -1), [
    ECall(EIdent(op, -1), [
      arg
    ], -1)
  ], -1)
}

fn fn_with(effect: Option[String], body: Expr) -> Expr {
  EFn(array_empty(), array_empty(), array_empty(), None, effect, body)
}

fn no_labels() -> Array[String] {
  array_empty()
}

//# Misc

test "perform of undeclared effect reports error" {
  let errors = check_perform_effects_expr(perform_op("Stdout::WriteStream", EString("hi")), no_labels(), false)
  assert(Array::length(errors) > 0)
  assert(is_perform_err(Array::get(errors, 0)))
}

test "perform of declared effect is OK" {
  let errors = check_perform_effects_expr(perform_op("Stdout::WriteStream", EString("hi")), [
    "Stdout"
  ], false)
  assert(eq(Array::length(errors), 0))
}

test "perform of a different declared effect still reports error" {
  let errors = check_perform_effects_expr(perform_op("Stdout::WriteStream", EString("hi")), [
    "Stdin"
  ], false)
  assert(Array::length(errors) > 0)
}

test "perform inside a handle is allowed regardless of declaration" {
  let inner = perform_op("Console::Print", EString("hi"))
  let handle_expr = EHandle(inner, [
    (PBind("k"), EInt(0))
  ])
  let errors = check_perform_effects_expr(handle_expr, no_labels(), false)
  assert(eq(Array::length(errors), 0))
}

test "perform via EFn with declared effect is OK" {
  let fn_expr = fn_with(Some("Stdout"), perform_op("Stdout::WriteStream", EString("hi")))
  let errors = check_perform_effects_expr(fn_expr, no_labels(), false)
  assert(eq(Array::length(errors), 0))
}

test "perform via EFn without the effect reports error" {
  let fn_expr = fn_with(None, perform_op("Stdout::WriteStream", EString("hi")))
  let errors = check_perform_effects_expr(fn_expr, no_labels(), false)
  assert(Array::length(errors) > 0)
}

test "explicitly pure callback lambda does not inherit outer effects" {
  // This closure is passed through a pure callback slot while the enclosing
  // lambda has Fs. Its explicit `with {}` must replace, not inherit, that row.
  let callback = fn_with(Some(""), perform_op("Fs::ReadFile", EString("p")))
  let outer = fn_with(Some("Fs"), ECall(EIdent("apply_pure", -1), [
    callback
  ], -1))
  let errors = check_perform_effects_expr(outer, no_labels(), false)
  assert(Array::length(errors) > 0)
}

test "perform rows trim and dedupe exact labels" {
  let fn_expr = fn_with(Some(" Fs, Fs "), perform_op("Fs::ReadFile", EString("p")))
  let errors = check_perform_effects_expr(fn_expr, no_labels(), false)
  assert(eq(Array::length(errors), 0))
}

test "effect-variable declaration authorizes any perform" {
  // `with { e }` (a polymorphic effect variable) authorizes performing anything
  // under the current representation (row-tail unification is future work).
  let errors = check_perform_effects_expr(perform_op("Stdout::WriteStream", EString("hi")), [
    "e"
  ], false)
  assert(eq(Array::length(errors), 0))
}

test "SLet signature effect authorizes perform in its body" {
  let body = fn_with(None, perform_op("Fs::ReadFile", EString("p")))
  let sig = TyFn([
    TyName("String")
  ], TyName("String"), Some("Error, Fs"))
  let stmt = SLet(false, false, "read", Some(sig), body)
  let errors = check_perform_effects_stmt(stmt)
  assert(eq(Array::length(errors), 0))
}

test "SLet without the effect flags perform in its body" {
  let body = fn_with(None, perform_op("Fs::ReadFile", EString("p")))
  let sig = TyFn([
    TyName("String")
  ], TyName("String"), Some("Error"))
  let stmt = SLet(false, false, "read", Some(sig), body)
  let errors = check_perform_effects_stmt(stmt)
  assert(Array::length(errors) > 0)
}

test "calling an effectful builtin without the effect reports error" {
  let call = ECall(EIdent("Fs::read_file", -1), [
    EString("p")
  ], -1)
  let errors = check_perform_effects_expr(call, no_labels(), false)
  assert(Array::length(errors) > 0)
}

test "calling an effectful builtin with the effect declared is OK" {
  let call = ECall(EIdent("Fs::read_file", -1), [
    EString("p")
  ], -1)
  let errors = check_perform_effects_expr(call, [
    "Fs"
  ], false)
  assert(eq(Array::length(errors), 0))
}

test "calling a pure builtin is never flagged" {
  let call = ECall(EIdent("Array::length", -1), [
    EIdent("xs", -1)
  ], -1)
  let errors = check_perform_effects_expr(call, no_labels(), false)
  assert(eq(Array::length(errors), 0))
}

test "effect checking visits non-call expression children" {
  let fs_call = ECall(EIdent("Fs::read_file", -1), [
    EString("p")
  ], -1)
  let map_expr = EMap([
    ("value", fs_call)
  ])
  let labeled_expr = ELabeledArg("value", "v", fs_call)
  let spread_expr = ESpread(fs_call)
  let break_expr = EBreak(Some(fs_call))
  let continue_expr = EContinue([
    fs_call
  ])
  assert(Array::length(check_perform_effects_expr(map_expr, no_labels(), false)) > 0)
  assert(Array::length(check_perform_effects_expr(labeled_expr, no_labels(), false)) > 0)
  assert(Array::length(check_perform_effects_expr(spread_expr, no_labels(), false)) > 0)
  assert(Array::length(check_perform_effects_expr(break_expr, no_labels(), false)) > 0)
  assert(Array::length(check_perform_effects_expr(continue_expr, no_labels(), false)) > 0)
}

// #626 criterion 2: a `handle ... with E` discharges E (its arms are qualified
// `E::Op`), so a perform of E inside needs no declaration — but a different
// effect still leaks.

test "handle discharges its own effect for an undeclared perform" {
  let body = perform_op("Console::Print", EString("hi"))
  let handle_expr = EHandle(body, [
    (PCtor("Console::Print", [
      PBind("s")
    ]), EInt(0))
  ])
  let errors = check_perform_effects_expr(handle_expr, no_labels(), false)
  assert(eq(Array::length(errors), 0))
}

test "handle does not discharge a different effect" {
  let body = perform_op("Logger::Log", EString("hi"))
  let handle_expr = EHandle(body, [
    (PCtor("Console::Print", [
      PBind("s")
    ]), EInt(0))
  ])
  let errors = check_perform_effects_expr(handle_expr, no_labels(), false)
  assert(Array::length(errors) > 0)
}

test "handle with an unqualified arm stays conservative" {
  let body = perform_op("Logger::Log", EString("hi"))
  let handle_expr = EHandle(body, [
    (PBind("k"), EInt(0))
  ])
  let errors = check_perform_effects_expr(handle_expr, no_labels(), false)
  assert(eq(Array::length(errors), 0))
}

// #639: effect-row mismatch diagnostics — set difference + with-clause fix-it.

test "row mismatch names the missing effect and suggests the augmented row" {
  let body = fn_with(None, perform_op("Fs::ReadFile", EString("p")))
  let sig = TyFn([
    TyName("String")
  ], TyName("String"), Some("Error"))
  let stmt = SLet(false, false, "read", Some(sig), body)
  let errors = check_perform_effects_stmt(stmt)
  assert(Array::length(errors) > 0)
  let msg = effect_error_to_string(Array::get(errors, 0))
  // #1161 (Codex review): the DIRECT check reports the qualified operation
  // (`Fs::ReadFile`), not the stripped base effect name, so a fix-it grants
  // only the specific missing operation.
  assert(String::contains(msg, "effect row mismatch for 'read': missing { Fs::ReadFile }"))
  assert(String::contains(msg, "declared with { Error }, requires { Error, Fs::ReadFile }"))
  assert(String::contains(msg, "hint: add 'with { Error, Fs::ReadFile }' to 'read'"))
}

test "row mismatch with no declared row suggests a full declaration" {
  let body = fn_with(None, perform_op("Fs::ReadFile", EString("p")))
  let stmt = SLet(false, false, "load", None, body)
  let errors = check_perform_effects_stmt(stmt)
  assert(Array::length(errors) > 0)
  let msg = effect_error_to_string(Array::get(errors, 0))
  // #1161 (Codex review): same operation-level precision as above.
  assert(String::contains(msg, "effect row mismatch for 'load': missing { Fs::ReadFile }"))
  assert(String::contains(msg, "no 'with' clause, requires { Fs::ReadFile }"))
  assert(String::contains(msg, "hint: declare 'fn load(...) -> T with { Fs::ReadFile }'"))
}

test "call-site mismatch aggregates, sorts, and blames the caller" {
  // helper declares { Fs, Env } (reversed order on purpose); the caller has no
  // row, so the whole difference surfaces at the CALL site, sorted, and the
  // hint targets the CALLER's declaration.
  let helper_body = fn_with(Some("Fs, Env"), EInt(1))
  let helper = SLet(false, false, "helper", None, helper_body)
  let caller_body = fn_with(None, ECall(EIdent("helper", -1), [
    EInt(0)
  ], -1))
  let caller = SLet(false, false, "wrap", None, caller_body)
  let errors = check_perform_effects_stmts([
    helper,
    caller
  ])
  assert(Array::length(errors) > 0)
  let msg = effect_error_to_string(Array::get(errors, 0))
  assert(String::contains(msg, "effect row mismatch for 'wrap': missing { Env, Fs }"))
  assert(String::contains(msg, "hint: declare 'fn wrap(...) -> T with { Env, Fs }'"))
}

// #1361: a LOCAL closure's declared row leaks at its CALL site, exactly like a
// top-level function's (#626) or a callback parameter's (#885). Before this the
// closure was checked against its OWN row (so it always satisfied itself) and
// the call site consulted only the top-level call-graph map, where a local name
// never appears -- so the row escaped silently, and the doctest / `vibe test`
// caches (file_entry_cacheable / file_tests_cacheable, which reuse this walk)
// judged such an entry deterministic.

test "calling a local closure leaks its declared row" {
  let closure = fn_with(Some("Env"), EInt(1))
  let body = ELet("f", closure, ECall(EIdent("f", -1), array_empty(), -1), -1)
  let errors = check_perform_effects_expr(body, [
    "Stdout"
  ], false)
  assert(Array::length(errors) > 0)
  let msg = effect_error_to_string(Array::get(errors, 0))
  assert(String::contains(msg, "missing { Env }"))
}

test "a caller declaring the local closure's row is OK" {
  let closure = fn_with(Some("Env"), EInt(1))
  let body = ELet("f", closure, ECall(EIdent("f", -1), array_empty(), -1), -1)
  let errors = check_perform_effects_expr(body, [
    "Stdout",
    "Env"
  ], false)
  assert(eq(Array::length(errors), 0))
}

test "a pure local closure leaks nothing" {
  let closure = fn_with(None, EInt(1))
  let body = ELet("f", closure, ECall(EIdent("f", -1), array_empty(), -1), -1)
  let errors = check_perform_effects_expr(body, no_labels(), false)
  assert(eq(Array::length(errors), 0))
}

test "defining an effectful local closure without calling it leaks nothing" {
  // Defining a closure performs nothing; only invoking it does.
  let closure = fn_with(Some("Env"), EInt(1))
  let body = ELet("f", closure, EInt(0), -1)
  let errors = check_perform_effects_expr(body, no_labels(), false)
  assert(eq(Array::length(errors), 0))
}

test "a later pure binding shadows an effectful local closure" {
  let effectful = fn_with(Some("Env"), EInt(1))
  let pure = fn_with(None, EInt(2))
  let inner = ELet("f", pure, ECall(EIdent("f", -1), array_empty(), -1), -1)
  let body = ELet("f", effectful, inner, -1)
  let errors = check_perform_effects_expr(body, no_labels(), false)
  assert(eq(Array::length(errors), 0))
}

test "a handle around the call discharges the local closure's row" {
  let closure = fn_with(Some("Env"), EInt(1))
  let call = ECall(EIdent("f", -1), array_empty(), -1)
  let body = ELet("f", closure, EHandle(call, [
    (PBind("k"), EInt(0))
  ]), -1)
  let errors = check_perform_effects_expr(body, no_labels(), false)
  assert(eq(Array::length(errors), 0))
}

test "calling a recursive local closure leaks its declared row" {
  let closure = fn_with(Some("Fs"), EInt(1))
  let body = ELetRec("go", closure, ECall(EIdent("go", -1), array_empty(), -1))
  let errors = check_perform_effects_expr(body, no_labels(), false)
  assert(Array::length(errors) > 0)
}

test "calling a local closure bound with let mut leaks its declared row" {
  let closure = fn_with(Some("Fs"), EInt(1))
  let body = ELetMut("f", closure, ECall(EIdent("f", -1), array_empty(), -1), -1)
  let errors = check_perform_effects_expr(body, no_labels(), false)
  assert(Array::length(errors) > 0)
}
