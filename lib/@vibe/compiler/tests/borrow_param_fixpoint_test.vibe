import @vibe/compiler/core {
  Expr, Stmt
}
import @vibe/compiler/codegen/common_analysis {
  borrow_fixpoint_link_parts, compute_borrow_disqualifiers, compute_borrow_param_user_fns
}

fn declaration(name: String, params: Array[String], body: Expr) -> Stmt {
  let ps = Array::map(params, f = (p) -> (p, None))
  SLet(false, false, name, None, EFn([], [], ps, None, None, body))
}

fn call(name: String, args: Array[String]) -> Expr {
  ECall(EIdent(name, -1), Array::map(args, f = (a) -> EIdent(a, -1)), -1, [])
}

fn masks_for(stmts: Array[Stmt], wanted: Array[String]) -> Array[Int] {
  let masks: Array[Int] = []
  let names = compute_borrow_param_user_fns(stmts = stmts, exclude = [], out_masks = masks)
  Array::map(wanted, f = (name) -> {
    let mut found = 0
    let mut i = 0
    while i < Array::length(names) {
      if Array::get(names, at = i) == name {
        found = Array::get(masks, at = i)
      }
      i = i + 1
    }
    found
  })
}

test "borrow inference follows long wrapper chains in either declaration order" {
  let chain: Array[Stmt] = []
  let wanted: Array[String] = []
  let mut i = 0
  while i < 8 {
    let name = "reader_\{i}"
    let next = if i == 7 {
      "Array::length"
    } else {
      "reader_\{i + 1}"
    }
    Array::push(wanted, value = name)
    Array::push(chain, value = declaration(name = name, params = ["xs"], body = call(name = next, args = [
      "xs"
    ])))
    i = i + 1
  }
  inspect(masks_for(stmts = chain, wanted = wanted), content = "[1, 1, 1, 1, 1, 1, 1, 1]")
  let reversed: Array[Stmt] = []
  i = Array::length(chain)
  while i > 0 {
    i = i - 1; Array::push(reversed, value = Array::get(chain, at = i))
  }
  inspect(masks_for(stmts = reversed, wanted = wanted), content = "[1, 1, 1, 1, 1, 1, 1, 1]")
}

test "recursive readers propagate their borrowed ABI back to wrappers" {
  let walk = declaration(name = "walk", params = ["xs"], body = EIf(EBool(true), call(name = "Array::length", args = [
    "xs"
  ]), call(name = "walk", args = ["xs"])))
  let wrapper = declaration(name = "wrapper", params = ["xs"], body = call(name = "walk", args = [
    "xs"
  ]))
  inspect(masks_for(stmts = [wrapper, walk], wanted = ["wrapper", "walk"]), content = "[1, 1]")
}

test "mutually recursive readers reach a borrowed fixed point" {
  let left = declaration(name = "left", params = ["xs"], body = EIf(EBool(true), call(name = "Array::length", args = [
    "xs"
  ]), call(name = "right", args = ["xs"])))
  let right = declaration(name = "right", params = ["xs"], body = call(name = "left", args = [
    "xs"
  ]))
  inspect(masks_for(stmts = [left, right], wanted = ["left", "right"]), content = "[1, 1]")
}

test "an owned return propagates through mutually recursive permutations" {
  let left = declaration(name = "left", params = ["a", "b", "c"], body = call(name = "right", args = [
    "b",
    "c",
    "a"
  ]))
  let right = declaration(name = "right", params = ["a", "b", "c"], body = EIf(EBool(true), EIdent("a", -1), call(name = "left", args = [
    "a",
    "b",
    "c"
  ])))
  inspect(masks_for(stmts = [left, right], wanted = ["left", "right"]), content = "[0, 0]")
}

test "temporary arguments propagate ownership through a recursive component" {
  let left = declaration(name = "left", params = ["a", "b"], body = call(name = "right", args = [
    "b",
    "a"
  ]))
  let right = declaration(name = "right", params = ["a", "b"], body = call(name = "left", args = [
    "a",
    "b"
  ]))
  let caller = SExpr(ECall(EIdent("right", -1), [EArray([]), EIdent("xs", -1)], -1, [
  ]))
  inspect(masks_for(stmts = [left, right, caller], wanted = ["left", "right"]), content = "[0, 0]")
}

test "function parameters shadow transitive callees including labeled spellings" {
  let reader = declaration(name = "reader", params = ["xs"], body = call(name = "Array::length", args = [
    "xs"
  ]))
  let wrappers = ["reader", "reader~", "reader?"]
  let got: Array[Int] = []
  let mut i = 0
  while i < Array::length(wrappers) {
    let wrapper = declaration(name = "wrapper", params = [
      "xs",
      Array::get(wrappers, at = i)
    ], body = call(name = "reader", args = ["xs"]))
    Array::push(got, value = Array::get(masks_for(stmts = [reader, wrapper], wanted = [
      "wrapper"
    ]), at = 0)&1)
    i = i + 1
  }
  inspect(got, content = "[0, 0, 0]")
}

test "a source-owned builtin cannot seed borrowing into a wrapper" {
  let owned = declaration(name = "Map::iter_get", params = ["xs"], body = EIdent("xs", -1))
  let wrapper = declaration(name = "wrapper", params = ["xs"], body = call(name = "Map::iter_get", args = [
    "xs"
  ]))
  inspect(masks_for(stmts = [owned, wrapper], wanted = [
    "Map::iter_get",
    "wrapper"
  ]), content = "[0, 0]")
}

test "module linking follows transitive edges and global exclusions" {
  let leaf = declaration(name = "leaf", params = ["xs"], body = call(name = "Array::length", args = [
    "xs"
  ]))
  let mid = declaration(name = "mid", params = ["xs"], body = call(name = "leaf", args = [
    "xs"
  ]))
  let root = declaration(name = "root", params = ["xs"], body = call(name = "mid", args = [
    "xs"
  ]))
  let parts = [[root], [mid], [leaf]]
  let valued: Array[String] = []
  let nonident: Array[String] = []
  let positions: Array[Int] = []
  let mut i = 0
  while i < Array::length(parts) {
    compute_borrow_disqualifiers(stmts = Array::get(parts, at = i), out_valued = valued, out_nonident_fns = nonident, out_nonident_pos = positions)
    i = i + 1
  }
  let masks: Array[Int] = []
  let names = borrow_fixpoint_link_parts(parts = parts, valued = valued, nonident_fns = nonident, nonident_pos = positions, exclude = [
  ], out_masks = masks)
  inspect(names, content = "[leaf, mid, root]")
  inspect(masks, content = "[1, 1, 1]")
  let excluded_masks: Array[Int] = []
  let excluded_names = borrow_fixpoint_link_parts(parts = parts, valued = valued, nonident_fns = nonident, nonident_pos = positions, exclude = [
    "leaf"
  ], out_masks = excluded_masks)
  inspect(excluded_names, content = "[]")
  let valued_masks: Array[Int] = []
  let valued_names = borrow_fixpoint_link_parts(parts = parts, valued = ["leaf"], nonident_fns = nonident, nonident_pos = positions, exclude = [
  ], out_masks = valued_masks)
  inspect(valued_names, content = "[]")
}

test "duplicate definitions do not publish a speculative borrowed ABI" {
  let leaf = declaration(name = "leaf", params = ["xs"], body = call(name = "Array::length", args = [
    "xs"
  ]))
  let owned = declaration(name = "leaf", params = ["xs"], body = EIdent("xs", -1))
  let wrapper = declaration(name = "wrapper", params = ["xs"], body = call(name = "leaf", args = [
    "xs"
  ]))
  inspect(masks_for(stmts = [leaf, owned, wrapper], wanted = ["leaf", "wrapper"]), content = "[0, 0]")
  inspect(masks_for(stmts = [owned, leaf, wrapper], wanted = ["leaf", "wrapper"]), content = "[0, 0]")
}

test "capturing a parameter keeps its recursive callers owned" {
  let closure = EFn([], [], [], None, None, call(name = "Array::length", args = [
    "xs"
  ]))
  let left = declaration(name = "left", params = ["xs"], body = ESeq(closure, call(name = "right", args = [
    "xs"
  ])))
  let right = declaration(name = "right", params = ["xs"], body = call(name = "left", args = [
    "xs"
  ]))
  inspect(masks_for(stmts = [left, right], wanted = ["left", "right"]), content = "[0, 0]")
}
