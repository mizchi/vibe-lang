import @vibe/compiler/cache {
  ast_cache_enabled,
  compact_source_fingerprint_memo,
  load_persistent_ast_with_cfg,
  persistent_artifact_cache_path,
  persistent_artifact_cache_path_with_cfg,
  set_persistent_cache_cfg_flags,
  store_persistent_artifact_with_cfg,
  store_persistent_ast_with_cfg
}
import @vibe/compiler/config {
  Config
}
import @vibe/compiler/core {
  Stmt
}
import @vibe/compiler/loader {
  ast_cache_prefetch_fs,
  parse_program_located_shared,
  parse_program_located_shared_fs,
  parse_program_located_shared_fs_configured,
  parse_program_located_shared_ran_parser
}
import @vibe/parser {
  cfg_ambient_flags_csv, set_cfg_ambient_flags
}

let fs_cfg_source: String = "#cfg(alpha)\nexport let a = 11\n#cfg(beta)\nexport let b = 22\n#cfg(beta)\nexport let c = 33\n#cfg(poison)\nexport let p = 44\n#cfg(poison)\nexport let q = 55\n#cfg(poison)\nexport let r = 66\n"

fn reset_fs_cfg_compatibility() -> Unit {
  set_cfg_ambient_flags([])
  set_persistent_cache_cfg_flags("")
}

fn fs_cfg_parse(path: String, cfg: String) -> Array[Stmt] with Env + Exception + Fs {
  handle {
    parse_program_located_shared_fs_configured(path = path, source = fs_cfg_source)
  } with { Config::CfgFlags() => resume(cfg) }
}

fn fs_cfg_cache_path(path: String, cfg: String) -> String with Env {
  persistent_artifact_cache_path_with_cfg(kind = "selfhost_ast_v1", entry_name = path, fingerprint = compact_source_fingerprint_memo(path = path, source = fs_cfg_source), cfg_csv = cfg)
}

fn fs_cfg_remove_cache(_ path: String) -> Unit with Env + Fs {
  for cfg in ["alpha", "beta", "poison"] {
    let cache_path = fs_cfg_cache_path(path = path, cfg = cfg)
    if Fs::exists(cache_path) {
      Fs::remove(cache_path)
    } else {
      ()
    }
  }
  ()
}

fn fs_cfg_evict_memo(_ path: String) -> Unit with Exception {
  let mut i = 0
  while i < 1025 {
    let _ = parse_program_located_shared(path = "\{path}-evict-\{i}", source = "let evict = 0")
    i = i + 1
  }
}

test "configured FS parses ignore poisoned cells and namespace the shared memo" {
  set_cfg_ambient_flags(["poison"])
  set_persistent_cache_cfg_flags("poison")
  handle {
    let path = "/tmp/invocation-config-fs-memo.vibe"
    assert_eq(Array::length(parse_program_located_shared(path = path, source = fs_cfg_source)), 3)
    assert_eq(Array::length(fs_cfg_parse(path = path, cfg = " alpha, ")), 1)
    assert_eq(Array::length(fs_cfg_parse(path = path, cfg = "beta")), 2)
    assert_eq(Array::length(fs_cfg_parse(path = path, cfg = "alpha")), 1)
    assert(!parse_program_located_shared_ran_parser())
    assert_eq(cfg_ambient_flags_csv(), "poison")
    assert_eq(Array::length(parse_program_located_shared(path = path, source = fs_cfg_source)), 3)
    assert(!parse_program_located_shared_ran_parser())
    reset_fs_cfg_compatibility()
  } with { Exception::Throw(message) => {
    reset_fs_cfg_compatibility()
    throw(message)
  } }
}

test "compatibility shared parses preserve flags passed directly to the setter" {
  set_cfg_ambient_flags([" alpha ", "beta,alpha"])
  handle {
    assert_eq(Array::length(parse_program_located_shared(path = "/tmp/invocation-config-raw-pure.vibe", source = fs_cfg_source)), 0)
    assert_eq(Array::length(parse_program_located_shared_fs(path = "/tmp/invocation-config-raw-fs.vibe", source = fs_cfg_source)), 0)
    set_cfg_ambient_flags(["beta,alpha"])
    let path = "/tmp/invocation-config-comma-fs.vibe"
    assert_eq(Array::length(parse_program_located_shared_fs(path = path, source = fs_cfg_source)), 0)
    assert_eq(Array::length(fs_cfg_parse(path = path, cfg = "beta,alpha")), 3)
    // A memo or prefetch of the canonical CSV must not serve the literal
    // comma-containing flag when the compatibility caller asks again.
    assert(!ast_cache_prefetch_fs(path = path, source = fs_cfg_source))
    assert_eq(Array::length(parse_program_located_shared_fs(path = path, source = fs_cfg_source)), 0)
    assert(parse_program_located_shared_ran_parser())
    reset_fs_cfg_compatibility()
  } with { Exception::Throw(message) => {
    reset_fs_cfg_compatibility()
    throw(message)
  } }
}

test "an FS parse resumes after successful and failing inner Config invocations" {
  set_cfg_ambient_flags(["poison"])
  set_persistent_cache_cfg_flags("poison")
  handle {
    let outer = handle {
      parse_program_located_shared_fs_configured(path = "/tmp/invocation-config-fs-reentrant.vibe", source = fs_cfg_source)
    } with { Config::CfgFlags() => {
      assert_eq(Array::length(fs_cfg_parse(path = "/tmp/invocation-config-fs-reentrant.vibe", cfg = "beta")), 2)
      let failed = handle {
        handle {
          let _ = parse_program_located_shared_fs_configured(path = "/tmp/invocation-config-fs-fail.vibe", source = "#cfg(fail)\nexport let broken =\n")
          false
        } with { Config::CfgFlags() => resume("fail") }
      } with { Exception::Throw(_) => true }
      assert(failed)
      resume("alpha")
    } }
    assert_eq(Array::length(outer), 1)
    assert_eq(Array::length(fs_cfg_parse(path = "/tmp/invocation-config-fs-reentrant.vibe", cfg = "alpha")), 1)
    assert(!parse_program_located_shared_ran_parser())
    assert_eq(cfg_ambient_flags_csv(), "poison")
    reset_fs_cfg_compatibility()
  } with { Exception::Throw(message) => {
    reset_fs_cfg_compatibility()
    throw(message)
  } }
}

test "explicit AST namespaces survive a different legacy cache setting" {
  set_persistent_cache_cfg_flags("")
  let empty_path = persistent_artifact_cache_path(kind = "selfhost_ast_v1", entry_name = "identity.vibe", fingerprint = "source")
  assert_eq(empty_path, persistent_artifact_cache_path_with_cfg(kind = "selfhost_ast_v1", entry_name = "identity.vibe", fingerprint = "source", cfg_csv = ""))
  set_persistent_cache_cfg_flags("poison")
  handle {
    let path = "/tmp/invocation-config-fs-stored-\{Profiler::now_us()}.vibe"
    let fingerprint = compact_source_fingerprint_memo(path = path, source = fs_cfg_source)
    let alpha = fs_cfg_parse(path = path, cfg = "alpha")
    let beta = fs_cfg_parse(path = path, cfg = "beta")
    store_persistent_ast_with_cfg(path = path, source_fingerprint = fingerprint, stmts = alpha, cfg_csv = "alpha")
    store_persistent_ast_with_cfg(path = path, source_fingerprint = fingerprint, stmts = beta, cfg_csv = "beta")
    assert(fs_cfg_cache_path(path = path, cfg = "alpha") != fs_cfg_cache_path(path = path, cfg = "beta"))
    match load_persistent_ast_with_cfg(path = path, source_fingerprint = fingerprint, cfg_csv = "alpha") {
      Some(stmts) => assert_eq(Array::length(stmts), 1),
      None => assert(false)
    }
    match load_persistent_ast_with_cfg(path = path, source_fingerprint = fingerprint, cfg_csv = "beta") {
      Some(stmts) => assert_eq(Array::length(stmts), 2),
      None => assert(false)
    }
    assert(load_persistent_ast_with_cfg(path = path, source_fingerprint = fingerprint, cfg_csv = "poison") is None)
    store_persistent_artifact_with_cfg(kind = "selfhost_ast_v1", entry_name = path, fingerprint = fingerprint, bytes = Bytes::from_array([
      255
    ]), cfg_csv = "poison")
    assert(load_persistent_ast_with_cfg(path = path, source_fingerprint = fingerprint, cfg_csv = "poison") is None)
    fs_cfg_remove_cache(path)
    reset_fs_cfg_compatibility()
  } with { Exception::Throw(message) => {
    reset_fs_cfg_compatibility()
    throw(message)
  } }
}

/// Run this file with VIBE_EXPERIMENTAL_AST_CACHE=1 as well as the default.
/// Evict through the real memo bound: a warm hit must come from disk, rather
/// than a reset helper or the in-memory answer from the preceding parse.
test "configured FS cold and disk-warm parses agree when AST caching is enabled" {
  assert_eq(ast_cache_enabled(), Env::get("VIBE_EXPERIMENTAL_AST_CACHE") == "1")
  if ast_cache_enabled() {
    set_cfg_ambient_flags(["poison"])
    set_persistent_cache_cfg_flags("poison")
    handle {
      let path = "/tmp/invocation-config-fs-warm-\{Profiler::now_us()}.vibe"
      assert_eq(Array::length(fs_cfg_parse(path = path, cfg = "alpha")), 1)
      assert(parse_program_located_shared_ran_parser())
      assert_eq(Array::length(fs_cfg_parse(path = path, cfg = "beta")), 2)
      assert(parse_program_located_shared_ran_parser())
      fs_cfg_evict_memo(path)
      assert_eq(Array::length(fs_cfg_parse(path = path, cfg = "alpha")), 1)
      assert(!parse_program_located_shared_ran_parser())
      assert_eq(Array::length(fs_cfg_parse(path = path, cfg = "beta")), 2)
      assert(!parse_program_located_shared_ran_parser())
      // The compatibility FS entry must pair its parser snapshot with its
      // cache identity even when the legacy namespace cell disagrees.
      set_cfg_ambient_flags(["alpha"])
      fs_cfg_evict_memo(path)
      assert_eq(Array::length(parse_program_located_shared_fs(path = path, source = fs_cfg_source)), 1)
      assert(!parse_program_located_shared_ran_parser())
      fs_cfg_remove_cache(path)
      reset_fs_cfg_compatibility()
    } with { Exception::Throw(message) => {
      reset_fs_cfg_compatibility()
      throw(message)
    } }
  } else {
    ()
  }
}
