//# Imports

// #1343 / ADR-0094 実装順 1: ADR-0084 の分類 metadata (#1458 で
// `runtime` が加わり四分類)
// (lib/@vibe/compiler/core/effect_taxonomy.vibe) と、そこから派生する二つの
// リストのロック。
//
// この slice は **表面挙動不変** が要件なので、派生リストが吸収前のリテラル列
// (`test_bench_ambient_effects` の 8 要素、`file_entry_cacheable` の
// `cache_safe_row` 4 要素) と**要素順まで一致**することを固定する。分類の
// 意味 (何が capability で何が core ambient か) はここが唯一の定義なので、
// それ自体もここで pin する。
import @vibe/compiler/core {
  effect_class,
  effect_class_algebraic,
  effect_class_capability,
  effect_class_core_ambient,
  effect_class_runtime,
  effect_default_resource_kind,
  entry_cache_safe_effects,
  is_capability_effect,
  is_core_ambient_effect,
  is_row_transparent_effect,
  is_runtime_effect,
  is_singleton_resource_kind,
  predeclared_resources,
  process_root_resource_kind,
  taxonomy_effect_names,
  test_bench_ambient_effects,
  verify_effect_taxonomy_coverage
}

//# Misc

fn join_row(labels: Array[String]) -> String {
  String::join(labels, ",")
}

test "effect_class: host capabilities" {
  assert_eq(effect_class("Fs"), "capability")
  assert_eq(effect_class("Env"), "capability")
  assert_eq(effect_class("Stdin"), "capability")
  assert_eq(effect_class("Stdout"), "capability")
  assert_eq(effect_class("Stderr"), "capability")
  assert_eq(effect_class("Console"), "capability")
  assert_eq(effect_class("Process"), "capability")
  assert_eq(effect_class("Profiler"), "capability")
  assert_eq(effect_class("Http"), "capability")
  assert_eq(effect_class("Socket"), "capability")
  assert_eq(effect_class("Llm"), "capability")
  assert(is_capability_effect("Fs"))
  assert(not(is_capability_effect("Error")))
}

test "effect_class: core ambient" {
  // ADR-0084 の第三カテゴリ。`Exception[K]` は表に行が無くても
  // is_exception_label 経由で core ambient になる (kind ごとに行を足す
  // わけにいかないので、そこだけ述語で拾う)。
  assert_eq(effect_class("Error"), "core_ambient")
  assert_eq(effect_class("Exception"), "core_ambient")
  assert_eq(effect_class("Exception[IoError]"), "core_ambient")
  assert_eq(effect_class("Error::Throw"), "core_ambient")
  assert_eq(effect_class("Exception[IoError]::Throw"), "core_ambient")
  assert(not(is_core_ambient_effect("Fs")))
  // #1458: `Async` は第四カテゴリへ移った。core ambient ではない。
  assert(not(is_core_ambient_effect("Async")))
}

test "effect_class: runtime (#1458)" {
  // 第四カテゴリ。row を素通りする点は core ambient と同じだが、
  // discharge するのは runtime であって「誰も discharge しない」ではない。
  // 今日の唯一のメンバー。
  assert_eq(effect_class("Async"), "runtime")
  assert_eq(effect_class_runtime(), effect_class("Async"))
  assert(is_runtime_effect("Async"))
  assert(not(is_runtime_effect("Error")))
  assert(not(is_runtime_effect("Fs")))
  assert(not(is_runtime_effect("Ask")))
}

test "#1458: row-transparent is the union the call sites actually want" {
  // checker_effects の builtin_call_effect と wit_gen は「権限として数えない
  // か」だけを見ており、discharge するのが誰かは問うていない。#1458 で
  // クラスが二つに割れたので、その二つの和がこの述語。両方の呼び出し側の
  // 挙動が不変であることは、この和が分割前の core_ambient と一致すること
  // で担保される。
  assert(is_row_transparent_effect("Error"))
  assert(is_row_transparent_effect("Exception"))
  assert(is_row_transparent_effect("Exception[IoError]"))
  assert(is_row_transparent_effect("Async"))
  assert(not(is_row_transparent_effect("Fs")))
  assert(not(is_row_transparent_effect("Console")))
  assert(not(is_row_transparent_effect("Ask")))
}

test "effect_class: unknown labels are algebraic" {
  // ADR-0094 Decision 4: 表に無い名前 = resource パラメータを持たない
  // user effect。row ラベルが実在の effect を指すかは今のところ検査されない
  // (ADR-0094 の実測 5) ので、存在しないラベルも同じ扱いになる。
  assert_eq(effect_class("Ask"), "algebraic")
  assert_eq(effect_class("State"), "algebraic")
  assert_eq(effect_class("Frobnicate"), "algebraic")
  assert(not(is_capability_effect("Ask")))
  assert(not(is_core_ambient_effect("Ask")))
}

test "effect_class: operation and instantiation labels reduce to the effect" {
  // ADR-0071 の operation 粒度 (`Fs::read_file`) と #1340 の generic
  // instantiation (`State[Int]`) は、どちらも base effect 名で分類される。
  assert_eq(effect_class("Fs::read_file"), "capability")
  assert_eq(effect_class("Http::request"), "capability")
  assert_eq(effect_class("State[Int]"), "algebraic")
  assert_eq(effect_class("Ask::Get"), "algebraic")
}

test "class name accessors match effect_class output" {
  assert_eq(effect_class_capability(), effect_class("Fs"))
  assert_eq(effect_class_core_ambient(), effect_class("Error"))
  assert_eq(effect_class_runtime(), effect_class("Async"))
  assert_eq(effect_class_algebraic(), effect_class("Ask"))
}

test "test/bench ambient row is unchanged by the taxonomy refactor" {
  // 吸収前の checker_effects.vibe のリテラル列 + #1461 の `Exception`。
  // 要素順込みで固定する。`Error` と `Exception` は同じ erased ラベルの
  // 二つの綴りで、この列は名前で突き合わされるので両方載せる。
  assert_eq(join_row(test_bench_ambient_effects()), "Fs,Env,Stdin,Stdout,Stderr,Console,Process,Profiler,Error,Exception")
}

test "entry cache-safe row is unchanged by the taxonomy refactor" {
  // 吸収前の file_entry_cacheable の cache_safe_row そのもの。
  assert_eq(join_row(entry_cache_safe_effects()), "Stdout,Console,Error,Exception,Async")
}

test "network and external-service capabilities are NOT test/bench ambient" {
  // 宣言なしで踏ませない側。ambient 集合に混ざると `with Http` を書かない
  // test が黙ってネットワークに出られるようになる。
  let ambient = test_bench_ambient_effects()
  assert(not(array_has_str(ambient, "Http")))
  assert(not(array_has_str(ambient, "Socket")))
  assert(not(array_has_str(ambient, "Llm")))
  assert(not(array_has_str(ambient, "Async")))
}

test "only the tty capability is cache-safe" {
  // #819 の doctest キャッシュにとって stdout は entry の産物。他の
  // capability が混ざると、byte-identical な wasm の出力が実行ごとに
  // 変わりうるのにキャッシュされてしまう。
  // #1460: `Console` は `Stdout` を含む統合 capability なので同じ側。
  // 「tty へ書く capability だけ」という不変条件は変わっていない。
  let safe = entry_cache_safe_effects()
  let mut i = 0
  while i < Array::length(safe) {
    let name = Array::get(safe, i)
    if is_capability_effect(name) {
      assert(name == "Stdout" || name == "Console")
    } else {
      // #1458: 非 capability 側は core ambient と runtime (`Async`) の二つ。
      assert(is_row_transparent_effect(name))
    }
    i = i + 1
  }
}

test "capabilities carry a default resource kind, the others do not" {
  // ADR-0094 Decision 5 の受け皿。`resource` 宣言 (ADR-0075 Phase 2) が
  // 未実装なので `Process::Root` はまだ検査には使われていないが、列が
  // 空になっていないことは pin しておく。
  let names = taxonomy_effect_names()
  let mut i = 0
  while i < Array::length(names) {
    let name = Array::get(names, i)
    if is_capability_effect(name) {
      assert_eq(effect_default_resource_kind(name), "Process::Root")
    } else {
      assert_eq(effect_default_resource_kind(name), "")
    }
    i = i + 1
  }
  assert_eq(effect_default_resource_kind("Fs::read_file"), "Process::Root")
  // 表に無い名前は "" (user effect には既定 resource kind が無い)。
  assert_eq(effect_default_resource_kind("Ask"), "")
}

test "every builtin registry effect label has a taxonomy row" {
  // drift guard: 新しい host builtin が新しい effect 名を持ち込んだのに
  // 表への追加を忘れると、その capability は黙って `algebraic` に化ける
  // (= in-process の handler で discharge できる effect として扱われる)。
  // core/builtin_registry.vibe の verify_effect_taxonomy_coverage が名前付きで
  // 落とす。
  verify_effect_taxonomy_coverage()
}

fn array_has_str(arr: Array[String], needle: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(arr) {
    if Array::get(arr, i) == needle {
      found = true
    } else {
      ()
    }
    i = i + 1
  }
  found
}

//# ADR-0075 Phase 2 の resource kind (#1343 実装順 2)

test "#1343: Process::Root is the singleton kind every capability defaults to" {
  // `default_resource_kind` 列はもともとどこにも宣言の無い名前を指していた。
  // 実装順 2 で `Process::Root` に実体が付いたので、列と実体が同じ文字列を
  // 指していることを固定する — ずれると `resource X : Process::Root` の
  // 拒否だけが効いて、既定展開が別の kind を向く。
  assert_eq(process_root_resource_kind(), "Process::Root")
  assert_eq(effect_default_resource_kind("Fs"), process_root_resource_kind())
  assert_eq(effect_default_resource_kind("Http"), process_root_resource_kind())
  assert(is_singleton_resource_kind(process_root_resource_kind()))
  // ADR-0075 自身の例。singleton ではないので resource を宣言できる。
  assert(not(is_singleton_resource_kind("S3::Bucket")))
}

test "#1343: the predeclared resource is Process::Root, of its own kind" {
  // singleton kind の住人は kind 名と同じ名前 — process は一つしかないので、
  // 別名を与えても指す先は同じものにしかならない。checker の重複検査は
  // この表を種にするので、プログラムが ambient process root を自分の宣言で
  // 覆い隠すことはできない。
  let pre = predeclared_resources()
  assert_eq(Array::length(pre), 1)
  let (rname, rkind) = Array::get(pre, 0)
  assert_eq(rname, process_root_resource_kind())
  assert_eq(rkind, process_root_resource_kind())
}
