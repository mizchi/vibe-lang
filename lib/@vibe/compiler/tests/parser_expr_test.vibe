//# Imports

import ./parser_test_support.vibe {
  parse_print
}

import @vibe/compiler/syntax {
  lex
}

import ../parser.vibe {
  parse_ok
}

//# Misc

test "parse int" {
  let result = handle {
    parse_print("42")
  } with { Exception::Throw(e) => String::concat("ERROR: ", e) }
  assert(result == "42")
}

test "parse string" {
  let result = handle {
    parse_print("\"hello\"")
  } with { Exception::Throw(e) => String::concat("ERROR: ", e) }
  assert(result == "\"hello\"")
}

test "parse bool true" {
  let result = handle {
    parse_print("true")
  } with { Exception::Throw(e) => String::concat("ERROR: ", e) }
  assert(result == "true")
}

test "parse bool false" {
  let result = handle {
    parse_print("false")
  } with { Exception::Throw(e) => String::concat("ERROR: ", e) }
  assert(result == "false")
}

test "parse ident" {
  let result = handle {
    parse_print("foo")
  } with { Exception::Throw(e) => String::concat("ERROR: ", e) }
  assert(result == "foo")
}

test "parse print keeps canonical perform syntax" {
  let result = handle {
    parse_print("perform Logger::Log(\"hi\")")
  } with { Exception::Throw(e) => String::concat("ERROR: ", e) }
  assert(result == "perform Logger::Log(\"hi\")")
}

test "parse slice with computed end" {
  assert(parse_ok(lex("input[pos: pos + n]")))
}

test "parse slice to end" {
  assert(parse_ok(lex("input[pos:]")))
}

test "parse typed block lambda without return annotation" {
  assert(parse_ok(lex("(start: Int, end: Int, len: Int) { start + end + len }")))
}

test "parse match with tuple scrutinee" {
  assert(parse_ok(lex("match (a, b) { (_, _) => 0 }")))
}
