//# Imports

import @vibe/compiler/codegen/builtin_bodies {
  gen_arr_get_body,
  gen_arr_len_body,
  gen_arr_set_body,
  gen_bytes_get_body,
  gen_bytes_set_body,
  gen_oob_abort_body,
  gen_print_i64_body,
  gen_print_i64_raw_body,
  gen_rc_drop_body,
  gen_rc_dup_body,
  gen_simd_scan_string_special_body,
  gen_str_char_code_at_body,
  gen_str_eq_body,
  gen_str_len_body,
  gen_str_lex_diff_body,
  static_arr_get_body,
  static_arr_len_body,
  static_str_char_code_at_body,
  static_str_eq_body,
  static_str_len_body
}

//# Functions

fn bytes_equal(left: Bytes, right: Bytes, i: Int) -> Bool {
  if i >= Bytes::length(left) {
    true
  } else if Bytes::get(left, at = i) != Bytes::get(right, at = i) {
    false
  } else {
    bytes_equal(left = left, right = right, i = i + 1)
  }
}

fn expect_same_bytes(left: Bytes, right: Bytes) -> Unit {
  assert(Bytes::length(left) == Bytes::length(right))
  assert(bytes_equal(left = left, right = right, i = 0))
}

//# Misc

test "generated str_eq body is nonempty" {
  // #748: gen_str_eq_body grew a 16-byte SIMD chunk fast path; the static
  // twin keeps the retired scalar bytes and is no longer byte-identical
  // (linked_compile now emits the generator directly).
  assert(Bytes::length(gen_str_eq_body()) > Bytes::length(static_str_eq_body()))
}

test "str_lex_diff body is nonempty and rc variant is larger" {
  // #746: the RC variant appends the tag shift (i64.const 1; i64.shl), so it
  // must be strictly longer than the untagged body.
  assert(Bytes::length(gen_str_lex_diff_body(false)) > 0)
  assert(Bytes::length(gen_str_lex_diff_body(true)) > Bytes::length(gen_str_lex_diff_body(false)))
}

test "string-special SIMD body is nonempty and rc variant retags its index" {
  assert(Bytes::length(gen_simd_scan_string_special_body(false)) > 0)
  assert(Bytes::length(gen_simd_scan_string_special_body(true)) > Bytes::length(gen_simd_scan_string_special_body(false)))
}

test "static arr_len body matches generated body" {
  expect_same_bytes(left = static_arr_len_body(), right = gen_arr_len_body(false))
}

test "static arr_get body matches generated body" {
  // #2199: oob_abort_idx < 0 selects the historical bare-trap form, which
  // is what the static twin pins; the real lanes pass the abort helper.
  expect_same_bytes(left = static_arr_get_body(), right = gen_arr_get_body(enable_rc = false, oob_prefix_fat = 0 - 1, oob_abort_idx = 0 - 1))
}

test "static str_char_code_at body matches generated body" {
  // #2199: same bare-trap pin as arr_get above.
  expect_same_bytes(left = static_str_char_code_at_body(), right = gen_str_char_code_at_body(enable_rc = false, oob_prefix_fat = 0 - 1, oob_abort_idx = 0 - 1))
}

test "OOB abort form is strictly larger on every bounds-checked body" {
  // The abort form adds the prefix const + idx/len pushes + call in the OOB
  // branch and nothing else, so it must be strictly longer than the
  // bare-trap form on each of the five sites, on both lanes.
  assert(Bytes::length(gen_arr_get_body(enable_rc = false, oob_prefix_fat = 4242, oob_abort_idx = 7)) > Bytes::length(gen_arr_get_body(enable_rc = false, oob_prefix_fat = 0 - 1, oob_abort_idx = 0 - 1)))
  assert(Bytes::length(gen_arr_set_body(enable_rc = false, oob_prefix_fat = 4242, oob_abort_idx = 7)) > Bytes::length(gen_arr_set_body(enable_rc = false, oob_prefix_fat = 0 - 1, oob_abort_idx = 0 - 1)))
  assert(Bytes::length(gen_bytes_get_body(enable_rc = false, oob_prefix_fat = 4242, oob_abort_idx = 7)) > Bytes::length(gen_bytes_get_body(enable_rc = false, oob_prefix_fat = 0 - 1, oob_abort_idx = 0 - 1)))
  assert(Bytes::length(gen_bytes_set_body(enable_rc = false, oob_prefix_fat = 4242, oob_abort_idx = 7)) > Bytes::length(gen_bytes_set_body(enable_rc = false, oob_prefix_fat = 0 - 1, oob_abort_idx = 0 - 1)))
  assert(Bytes::length(gen_str_char_code_at_body(enable_rc = false, oob_prefix_fat = 4242, oob_abort_idx = 7)) > Bytes::length(gen_str_char_code_at_body(enable_rc = false, oob_prefix_fat = 0 - 1, oob_abort_idx = 0 - 1)))
  assert(Bytes::length(gen_arr_get_body(enable_rc = true, oob_prefix_fat = 4242, oob_abort_idx = 7)) > Bytes::length(gen_arr_get_body(enable_rc = true, oob_prefix_fat = 0 - 1, oob_abort_idx = 0 - 1)))
}

test "print_i64_raw drops exactly the newline emission" {
  // gen_print_i64_raw_body is gen_print_i64_body minus the store of byte 10
  // at scratch address 47 (three instructions); the iov end constant differs
  // in value only, and everything else is shared.
  assert(Bytes::length(gen_print_i64_raw_body()) > 0)
  assert(Bytes::length(gen_print_i64_raw_body()) < Bytes::length(gen_print_i64_body()))
}

test "shadow UAF abort form is strictly larger than a bare unreachable" {
  // #1987: naming the freeing seq adds the abort call in place of `unreachable`.
  assert(Bytes::length(gen_rc_dup_body(rc_shadow = true, uaf_abort_idx = 7, prefix_fat = 4242)) > Bytes::length(gen_rc_dup_body(rc_shadow = true, uaf_abort_idx = 0 - 1, prefix_fat = 0)))
  assert(Bytes::length(gen_rc_drop_body(self_idx = 3, rc_shadow = true, bins_base = 0, uaf_abort_idx = 7, prefix_fat = 4242, map_arms = true, closure_arms = true, array_arm = true)) > Bytes::length(gen_rc_drop_body(self_idx = 3, rc_shadow = true, bins_base = 0, uaf_abort_idx = 0 - 1, prefix_fat = 0, map_arms = true, closure_arms = true, array_arm = true)))
}

test "each rc_drop arm a program cannot use makes the body smaller" {
  // A program that makes no map block gets rc_drop without its class-6 and
  // class-9 arms, one with no nested lambda without the class-7 / class-8
  // arms, and one that makes no array without the class-5 arm; everything
  // else in the body is shared. Checked on both sides of the shadow switch.
  let full = Bytes::length(gen_rc_drop_body(self_idx = 3, rc_shadow = false, bins_base = 0, uaf_abort_idx = 0 - 1, prefix_fat = 0, map_arms = true, closure_arms = true, array_arm = true))
  assert(Bytes::length(gen_rc_drop_body(self_idx = 3, rc_shadow = false, bins_base = 0, uaf_abort_idx = 0 - 1, prefix_fat = 0, map_arms = false, closure_arms = true, array_arm = true)) < full)
  assert(Bytes::length(gen_rc_drop_body(self_idx = 3, rc_shadow = false, bins_base = 0, uaf_abort_idx = 0 - 1, prefix_fat = 0, map_arms = true, closure_arms = false, array_arm = true)) < full)
  assert(Bytes::length(gen_rc_drop_body(self_idx = 3, rc_shadow = false, bins_base = 0, uaf_abort_idx = 0 - 1, prefix_fat = 0, map_arms = true, closure_arms = true, array_arm = false)) < full)
  let shadow_full = Bytes::length(gen_rc_drop_body(self_idx = 3, rc_shadow = true, bins_base = 0, uaf_abort_idx = 7, prefix_fat = 4242, map_arms = true, closure_arms = true, array_arm = true))
  assert(Bytes::length(gen_rc_drop_body(self_idx = 3, rc_shadow = true, bins_base = 0, uaf_abort_idx = 7, prefix_fat = 4242, map_arms = false, closure_arms = true, array_arm = true)) < shadow_full)
  assert(Bytes::length(gen_rc_drop_body(self_idx = 3, rc_shadow = true, bins_base = 0, uaf_abort_idx = 7, prefix_fat = 4242, map_arms = true, closure_arms = false, array_arm = true)) < shadow_full)
  assert(Bytes::length(gen_rc_drop_body(self_idx = 3, rc_shadow = true, bins_base = 0, uaf_abort_idx = 7, prefix_fat = 4242, map_arms = true, closure_arms = true, array_arm = false)) < shadow_full)
}

test "oob_abort body is nonempty and grows with larger fragment constants" {
  // Sanity on the shared abort helper: it must emit something, and the fat
  // constants are LEB-encoded so a large constant produces a longer body.
  assert(Bytes::length(gen_oob_abort_body(print_str_idx = 1, print_i64_raw_idx = 2, oob_mid_fat = 3, oob_nl_fat = 4)) > 0)
  assert(Bytes::length(gen_oob_abort_body(print_str_idx = 1, print_i64_raw_idx = 2, oob_mid_fat = 1099511627776, oob_nl_fat = 4)) > Bytes::length(gen_oob_abort_body(print_str_idx = 1, print_i64_raw_idx = 2, oob_mid_fat = 3, oob_nl_fat = 4)))
}

test "static str_len body matches generated body" {
  expect_same_bytes(left = static_str_len_body(), right = gen_str_len_body(false))
}
