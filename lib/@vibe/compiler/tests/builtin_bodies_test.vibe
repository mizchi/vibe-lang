//# Imports

import @vibe/compiler/codegen/builtin_bodies {
  gen_arr_get_body,
  gen_arr_len_body,
  gen_arr_set_body,
  gen_simd_scan_string_special_body,
  gen_str_eq_body,
  gen_str_len_body,
  gen_str_lex_diff_body,
  static_arr_get_body,
  static_arr_len_body,
  static_str_eq_body,
  static_str_len_body
}

//# Functions

fn bytes_equal(left: Bytes, right: Bytes, i: Int) -> Bool {
  if i >= Bytes::length(left) {
    true
  } else if Bytes::get(left, i) != Bytes::get(right, i) {
    false
  } else {
    bytes_equal(left, right, i + 1)
  }
}

fn expect_same_bytes(left: Bytes, right: Bytes) -> Unit {
  assert(Bytes::length(left) == Bytes::length(right))
  assert(bytes_equal(left, right, 0))
}

//# Misc

test "generated str_eq body is nonempty" {
  // #748: gen_str_eq_body grew a 16-byte SIMD chunk fast path; the static
  // twin keeps the retired scalar bytes and is no longer byte-identical
  // (linked_compile now emits the generator directly).
  assert(Bytes::length(gen_str_eq_body()) > Bytes::length(static_str_eq_body()))
}

test "str_lex_diff body is nonempty and rc variant is larger" {
  // #746: the RC variant appends the tag shift (i64.const 1; i64.shl), so it
  // must be strictly longer than the untagged body.
  assert(Bytes::length(gen_str_lex_diff_body(false)) > 0)
  assert(Bytes::length(gen_str_lex_diff_body(true)) > Bytes::length(gen_str_lex_diff_body(false)))
}

test "string-special SIMD body is nonempty and rc variant retags its index" {
  assert(Bytes::length(gen_simd_scan_string_special_body(false)) > 0)
  assert(Bytes::length(gen_simd_scan_string_special_body(true)) > Bytes::length(gen_simd_scan_string_special_body(false)))
}

test "static arr_len body matches generated body" {
  expect_same_bytes(static_arr_len_body(), gen_arr_len_body(false))
}

test "static arr_get body matches generated body" {
  // #2199: print_str_idx < 0 selects the historical bare-trap form, which
  // is what the static twin pins; the real lanes pass a message constant.
  expect_same_bytes(static_arr_get_body(), gen_arr_get_body(false, 0 - 1, 0 - 1))
}

test "arr_get/arr_set OOB message form is strictly larger" {
  // The print-then-trap form adds the i64.const + call prefix in the OOB
  // branch and nothing else.
  assert(Bytes::length(gen_arr_get_body(false, 4242, 7)) > Bytes::length(gen_arr_get_body(false, 0 - 1, 0 - 1)))
  assert(Bytes::length(gen_arr_set_body(false, 4242, 7)) > Bytes::length(gen_arr_set_body(false, 0 - 1, 0 - 1)))
}

test "static str_len body matches generated body" {
  expect_same_bytes(static_str_len_body(), gen_str_len_body(false))
}
