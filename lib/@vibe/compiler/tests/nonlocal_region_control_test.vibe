import @vibe/process {
  process_sh_capture
}
import @vibe/compiler/core {
  bytebuf_new, bytebuf_push, bytebuf_push_section, bytebuf_push_string, bytebuf_to_bytes, leb128_encode_u32
}
import @vibe/compiler/codegen/common_base {
  emit_region_enter, emit_region_try_epilogue, emit_region_try_prologue
}
import @vibe/compiler/codegen/wasm_emit {
  emit_block_i64,
  emit_br,
  emit_drop,
  emit_end,
  emit_i32_const,
  emit_i32_load,
  emit_i64_const,
  emit_i64_extend_i32_s,
  emit_i64_ne,
  emit_if_void
}
fn region_control_raw(_ values: Array[Int]) -> Bytes {
  let b = bytebuf_new(); for v in values {
    bytebuf_push(buf = b, byte = v)
  }; b
}
fn region_control_module(tag: Int, nested: Bool, throws: Bool) -> Bytes {
  let out = region_control_raw([0, 97, 115, 109, 1, 0, 0, 0])
  bytebuf_push_section(out = out, section_id = 1, content = region_control_raw([
    3,
    96,
    0,
    1,
    126,
    96,
    1,
    126,
    0,
    96,
    0,
    0
  ]))
  bytebuf_push_section(out = out, section_id = 3, content = region_control_raw([2, 0, 2]))
  bytebuf_push_section(out = out, section_id = 5, content = region_control_raw([1, 0, 1]))
  bytebuf_push_section(out = out, section_id = 13, content = region_control_raw([2, 0, 1, 0, 1]))
  let exports = region_control_raw([3]); bytebuf_push_string(buf = exports, s = "main"); bytebuf_push(buf = exports, byte = 0); bytebuf_push(buf = exports, byte = 0)
  bytebuf_push_string(buf = exports, s = "_start"); bytebuf_push(buf = exports, byte = 0); bytebuf_push(buf = exports, byte = 1)
  bytebuf_push_string(buf = exports, s = "memory"); bytebuf_push(buf = exports, byte = 2); bytebuf_push(buf = exports, byte = 0)
  bytebuf_push_section(out = out, section_id = 7, content = exports)
  let body = region_control_raw([0])
  emit_block_i64(body); emit_block_i64(body)
  bytebuf_push(buf = body, byte = 31); bytebuf_push(buf = body, byte = 126); bytebuf_push(buf = body, byte = 1); bytebuf_push(buf = body, byte = 0); leb128_encode_u32(buf = body, value = tag); bytebuf_push(buf = body, byte = 0)
  emit_region_enter(buf = body, region_ptr_addr = 32); emit_region_try_prologue(buf = body, catch_tag = 0)
  if nested {
    emit_region_enter(buf = body, region_ptr_addr = 32); emit_region_try_prologue(buf = body, catch_tag = 0)
  }
  emit_i64_const(buf = body, value = 7)
  if throws {
    bytebuf_push(buf = body, byte = 8); leb128_encode_u32(buf = body, value = tag)
  }
  if nested {
    emit_region_try_epilogue(buf = body, region_ptr_addr = 32, catch_tag = 0)
  }
  emit_region_try_epilogue(buf = body, region_ptr_addr = 32, catch_tag = 0)
  emit_end(body); emit_br(buf = body, label = 1); emit_end(body)
  emit_drop(body)
  emit_i32_const(buf = body, value = 36); emit_i32_load(buf = body, align = 2, offset = 0); emit_i64_extend_i32_s(body)
  emit_end(body); emit_end(body)
  let code = region_control_raw([2]); leb128_encode_u32(buf = code, value = Bytes::length(body)); Bytes::append(code, bytes = body)
  let start = region_control_raw([0, 16, 0]); emit_i64_const(buf = start, value = if throws {
    0
  } else {
    7
  }); emit_i64_ne(start); emit_if_void(start); bytebuf_push(buf = start, byte = 0); emit_end(start); emit_end(start)
  leb128_encode_u32(buf = code, value = Bytes::length(start)); Bytes::append(code, bytes = start)
  bytebuf_push_section(out = out, section_id = 10, content = code)
  bytebuf_to_bytes(out)
}

test "region unwinding restores depth without changing exception tags" {
  Fs::mkdir_p("_build/vibe_test/region_control")
  for item in [
    ("normal", 1, false, false, "7\n"),
    ("source", 0, false, true, "0\n"),
    ("control", 1, false, true, "0\n"),
    ("nested", 1, true, true, "0\n")
  ] {
    let bytes = region_control_module(tag = item.1, nested = item.2, throws = item.3)
    let path = "_build/vibe_test/region_control/" + item.0 + ".wasm"
    Fs::write_bytes(path, bytes = bytes)
    let result = process_sh_capture("bash scripts/run_wasm_vibe_host_runner.sh --invoke main " + path)
    assert(result.exit_code == 0)
    assert(result.stdout == item.4)
  }
}
