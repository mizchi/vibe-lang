import @vibe/compiler/checker {
  check_program_with_env_typed_lowering_located_observation
}

import @vibe/compiler/core {
  Expr, Stmt, TypeEnv, lowering_row_encode, lowering_row_tag, restore_call_placements
}

import @vibe/parser {
  lex_with_offsets, parse_program_located
}

import @vibe/compiler/normalize {
  desugar_inspect_calls, desugar_trait_dicts_with_typed_eq
}

fn checked_placement_rows(source: String) -> Array[Int] with Exception {
  let (tokens, starts, _) = lex_with_offsets(source)
  let stmts = parse_program_located(tokens, starts, source)
  let (_, rows, _, _) = check_program_with_env_typed_lowering_located_observation(stmts, EnvEmpty)
  match rows {
    Some(found) => found,
    None => {
      assert(false); []
    }
  }
}

fn placement_packet(offset: Int, slots: Array[Int]) -> Array[Int] {
  let rows = [13, lowering_row_encode(offset, 8), 41, 10]
  for slot in slots {
    Array::push(rows, lowering_row_encode(slot, 11))
  }
  Array::push(rows, lowering_row_encode(offset, 12))
  rows
}

fn lowering_message(source: String, rows: Array[Int], expand_inspect: Bool) -> String with Exception {
  let (tokens, starts, _) = lex_with_offsets(source)
  let stmts = parse_program_located(tokens, starts, source)
  restore_call_placements(stmts, rows)
  if expand_inspect {
    desugar_inspect_calls(stmts)
  } else {
    ()
  }
  handle {
    desugar_trait_dicts_with_typed_eq(stmts, [], [])
    ""
  } with { Exception::Throw(message) => message }
}

/// This is the real build lowering entry, not a standalone row comparator.
test "lowering refuses a poisoned argument placement and names the source call" {
  let source = "fn f(x: Int, y: Int) -> Int { x - y }\nfn main() -> Int { f(y = 3, x = 10) }"
  let rows = checked_placement_rows(source)
  assert(lowering_message(source, rows, false) == "")
  let mut poisoned = false
  let mut i = 0
  while i + 1 < Array::length(rows) && !poisoned {
    if lowering_row_tag(Array::get(rows, i)) == 11 && lowering_row_tag(Array::get(rows, i + 1)) == 11 {
      let first = Array::get(rows, i)
      Array::set(rows, i, Array::get(rows, i + 1))
      Array::set(rows, i + 1, first)
      poisoned = true
    } else {
      ()
    }
    i = i + 1
  }
  assert(poisoned)
  let message = lowering_message(source, rows, false)
  assert(String::contains(message, "placement disagrees with the checker for `f`"))
}

/// A complete checked channel cannot silently treat a lost call row as rowless.
test "lowering refuses a missing row but retains explicit rowless phase1b behavior" {
  let source = "fn f(x: Int, y: Int) -> Int { x - y }\nfn main() -> Int { f(y = 3, x = 10) }"
  assert(String::contains(lowering_message(source, [13], false), "missing or invalid checker argument placement for `f`"))
  assert(lowering_message(source, [14], false) == "")
}

/// Inspect erases its call before dictionary lowering; its original diagnostic
/// must survive on the synthetic expression that takes the value's type.
test "a macro cannot erase a poisoned source call placement" {
  let source = "fn main() -> Unit allows Console { inspect(1, content = \"1\") }"
  let offset = String::index_of(source, "inspect(")
  let message = lowering_message(source, placement_packet(offset, [4, 2]), true)
  assert(String::contains(message, "placement disagrees with the checker for `inspect`"))
}

/// Mutable lambda declarations follow the binding typing resolves, across a
/// sequential assignment, with no independent syntax/name table lookup.
test "checker placements survive sequential mutable lambda assignments" {
  let source = "fn main() -> Int { let mut g = (x~: Int, y~: Int) -> Int { x - y }; let a = g(y = 3, x = 10); g = (y~: Int, x~: Int) -> Int { x - y }; a + g(y = 3, x = 10) }"
  assert(lowering_message(source, checked_placement_rows(source), false) == "")
}

/// Optional slots record omission and wrapping independently of the old fill.
test "checker placement agrees on optional omission wrapping and option values" {
  let head = "fn pick(x: Int, y?: Int) -> Int { x }\nfn main() -> Int { "
  for call in [
    "pick(x = 10)",
    "pick(y = 3, x = 10)",
    "pick(10)",
    "pick(10, 3)",
    "pick(y = None, x = 10)",
    "pick(y = Some(3), x = 10)"
  ] {
    let source = head + call + " }"
    assert(lowering_message(source, checked_placement_rows(source), false) == "")
  }
}
