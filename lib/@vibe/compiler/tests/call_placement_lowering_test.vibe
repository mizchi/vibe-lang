import @vibe/checker/engine {
  CheckJob, engine_check_module_impl
}
import @vibe/compiler/checker/artifacts/module {
  CheckedModuleArtifact, decode_checked_module_artifact, encode_checked_module_artifact
}
import @vibe/compiler/runtime/checked_module_cache {
  checked_module_cache_stats, commit_checked_module_artifact, set_checked_module_cache_mode
}
import @vibe/compiler/runtime {
  module_typed_lowering_bind_source, module_typed_lowering_memo_put, module_typed_lowering_memo_reset, parse_program_with_path
}

import @vibe/compiler/checker {
  check_program_with_env_typed_lowering_located_observation
}

import @vibe/compiler/core {
  Expr,
  Stmt,
  Type,
  TypeEnv,
  call_placement_checked_rows,
  env_bind,
  expr_any_node,
  lowering_row_encode,
  lowering_row_tag,
  restore_call_placements
}

import @vibe/parser {
  lex_with_offsets, parse_program_located
}

import @vibe/compiler/normalize {
  desugar_inspect_calls, desugar_trait_dicts_with_typed_eq
}

fn checked_placement_rows(_ source: String) -> Array[Int] with Exception {
  let (tokens, starts, _) = lex_with_offsets(source)
  let stmts = parse_program_located(tokens = tokens, starts = starts, source = source)
  let (_, rows, _, _) = check_program_with_env_typed_lowering_located_observation(stmts = stmts, initial_env = EnvEmpty)
  match rows {
    Some(found) => found,
    None => call_placement_checked_rows()
  }
}

fn placement_packet(offset: Int, slots: Array[Int]) -> Array[Int] {
  let rows = [13, lowering_row_encode(payload = offset, tag = 8), 41, 10]
  for slot in slots {
    Array::push(rows, value = lowering_row_encode(payload = slot, tag = 11))
  }
  Array::push(rows, value = lowering_row_encode(payload = offset, tag = 12))
  rows
}

fn lowering_message(source: String, rows: Array[Int], expand_inspect: Bool) -> String with Exception {
  let (tokens, starts, _) = lex_with_offsets(source)
  let stmts = parse_program_located(tokens = tokens, starts = starts, source = source)
  restore_call_placements(stmts = stmts, rows = rows)
  if expand_inspect {
    desugar_inspect_calls(stmts)
  } else {
    ()
  }
  handle {
    desugar_trait_dicts_with_typed_eq(stmts = stmts, typed_eq_offsets = [], typed_eq_keys = [
    ])
    ""
  } with { Exception::Throw(message) => message }
}

fn poison_placement(_ rows: Array[Int]) -> Unit {
  let mut poisoned = false
  let mut i = 0
  while i + 1 < Array::length(rows) && !poisoned {
    if lowering_row_tag(Array::get(rows, at = i)) == 11 && lowering_row_tag(Array::get(rows, at = i + 1)) == 11 {
      let first = Array::get(rows, at = i)
      Array::set(rows, at = i, value = Array::get(rows, at = i + 1))
      Array::set(rows, at = i + 1, value = first)
      poisoned = true
    } else {
      ()
    }
    i = i + 1
  }
  assert(poisoned)
}

/// This is the real build lowering entry, not a standalone row comparator.
test "lowering consumes valid argument placement instead of recomputing it" {
  let source = "fn f(x: Int, y: Int) -> Int { x - y }\nfn main() -> Int { f(x = 10, y = 3) }"
  let rows = checked_placement_rows(source)
  assert(lowering_message(source = source, rows = rows, expand_inspect = false) == "")
  poison_placement(rows)
  let message = lowering_message(source = source, rows = rows, expand_inspect = false)
  assert(message == "")
}

/// A complete checked channel cannot silently treat a lost call row as rowless.
test "lowering refuses labeled calls with missing and rowless placement channels" {
  let source = "fn f(x: Int, y: Int) -> Int { x - y }\nfn main() -> Int { f(x = 10, y = 3) }"
  assert(String::contains(lowering_message(source = source, rows = [13], expand_inspect = false), needle = "missing or invalid checker argument placement for `f`"))
  assert(String::contains(lowering_message(source = source, rows = [14], expand_inspect = false), needle = "missing or invalid checker argument placement for `f`"))
}

/// Inspect erases its call before dictionary lowering; its original diagnostic
/// must survive on the synthetic expression that takes the value's type.
test "a macro cannot erase a poisoned source call placement" {
  let source = "fn main() -> Unit allows Console { inspect(1, content = \"1\") }"
  let offset = String::index_of(source, needle = "inspect(")
  let message = lowering_message(source = source, rows = placement_packet(offset = offset, slots = [
    4,
    2
  ]), expand_inspect = true)
  assert(String::contains(message, needle = "placement disagrees with the checker for `inspect`"))
}

/// Mutable lambda declarations follow the binding typing resolves, across a
/// sequential assignment, with no independent syntax/name table lookup. A
/// call through the binding is positional (ADR-0120 Phase 4b); its omitted
/// optional slot is still placed.
test "checker placements survive sequential mutable lambda assignments" {
  let source = "fn main() -> Int { let mut g = (x: Int, y?: Int) -> Int { x }; let a = g(10); g = (y: Int, x?: Int) -> Int { y }; a + g(3) }"
  let message = lowering_message(source = source, rows = checked_placement_rows(source), expand_inspect = false)
  if message != "" {
    throw(message)
  } else {
    ()
  }
}

/// Optional slots record omission and wrapping independently of the old fill.
test "checker placement agrees on optional omission wrapping and option values" {
  let head = "fn pick(x: Int, y?: Int) -> Int { x }\nfn main() -> Int { "
  for call in [
    "pick(x = 10)",
    "pick(x = 10, y = 3)",
    "pick(x = 10, y? = None)",
    "pick(x = 10, y = 3)",
    "pick(x = 10, y = None)",
    "pick(x = 10, y = Some(3))"
  ] {
    let source = head + call + " }"
    assert(lowering_message(source = source, rows = checked_placement_rows(source), expand_inspect = false) == "")
  }
}

/// Completing an inferred recursive group must preserve the same declaration
/// headers that typing used inside the group's provisional environment.
test "recursive group generalization retains call placement headers" {
  for source in [
    "let rec f = (x: Int, y: Int) -> { if x == 0 { y } else { f(x = 0, y = y) } }\nfn main() -> Int { f(x = 0, y = 3) }",
    "let rec f = (x: Int, y: Int) -> { if x == 0 { y } else { g(x = 0, y = y) } }\nlet rec g = (x: Int, y: Int) -> { if x == 0 { y } else { f(x = 0, y = y) } }\nfn main() -> Int { f(x = 0, y = 3) }"
  ] {
    assert(lowering_message(source = source, rows = checked_placement_rows(source), expand_inspect = false) == "")
  }
}

fn cached_lowering_message(source: String, mutation: Int, roundtrip: Bool) -> String with Env + Fs + Exception {
  let path = "/tmp/vibe_call_placement_cache_guard.vibe"
  set_checked_module_cache_mode("on")
  let artifacts: Array[CheckedModuleArtifact] = []
  let job = CheckJob::{
    path,
    source,
    deps: [],
    dep_fps: [],
    dep_envs: [],
    ships_owned_heads: false
  }
  let _ = engine_check_module_impl(job = job, observe_typing_artifact = false, program_transport = None, artifact_output = Some((Bytes::from_array([
    7
  ]), artifacts)), interfaces = None)
  assert(Array::length(artifacts) == 1)
  let original = Array::get(artifacts, at = 0)
  let artifact = if roundtrip {
    match decode_checked_module_artifact(bytes = encode_checked_module_artifact(original), input_identity = original.input_identity) {
      Some(decoded) => decoded,
      None => {
        assert(false); original
      }
    }
  } else {
    original
  }
  let rows = artifact.lowering_offsets
  if mutation == 1 {
    poison_placement(rows)
  } else if mutation == 2 {
    Array::truncate(rows, length = 0)
    Array::push(rows, value = 13)
  } else {
    ()
  }
  commit_checked_module_artifact(path = path, source = source, artifact = artifact, fresh = false)
  module_typed_lowering_memo_reset()
  module_typed_lowering_memo_put(path = path, fingerprint = "placement-cache-guard", offsets = rows, eq_offs = artifact.eq_offsets, eq_keys = artifact.eq_keys)
  module_typed_lowering_bind_source(path = path, fingerprint = "placement-cache-guard", source = source)
  let parsed = parse_program_with_path(path = path, source = source)
  assert(checked_module_cache_stats().2 > 0)
  let message = handle {
    desugar_trait_dicts_with_typed_eq(stmts = parsed, typed_eq_offsets = [], typed_eq_keys = [
    ])
    let expected = if mutation == 1 {
      [EInt(3), EInt(10)]
    } else {
      [EInt(10), EInt(3)]
    }
    let mut found = false
    for stmt in parsed {
      match stmt {
        SLet(_, _, "main", _, body) => found = expr_any_node(expr = body, pred = (expr) -> match expr {
          ECall(EIdent("f", _), args, _, _) => args == expected,
          _ => false
        }),
        _ => ()
      }
    }
    assert(found)
    ""
  } with { Exception::Throw(message) => message }
  set_checked_module_cache_mode("off")
  message
}

/// Raw cached statements share cells with the checked tree (and serialize
/// those cells). That alone cannot certify that their arguments were rewritten.
test "raw cached source is rechecked before consuming its placements" {
  let source = "fn f(x: Int, y: Int) -> Int { x - y }\nfn main() -> Int { f(x = 10, y = 3) }"
  for roundtrip in [false, true] {
    assert(cached_lowering_message(source = source, mutation = 0, roundtrip = roundtrip) == "")
    assert(cached_lowering_message(source = source, mutation = 1, roundtrip = roundtrip) == "")
    assert(String::contains(cached_lowering_message(source = source, mutation = 2, roundtrip = roundtrip), needle = "missing or invalid checker argument placement for `f`"))
  }
}

/// Namespace qualification introduces no receiver, even when optional filling
/// has added one argument before the qualified call is typed.
test "qualified optional placement does not infer a receiver from arity" {
  let env = env_bind(env = env_bind(env = EnvEmpty, name = "helper.pick", ty = CtFn([
    CtInt,
    CtOption(CtInt)
  ], CtInt, None)), name = "#params:helper.pick", ty = CtRecord([
    ("x", CtUnknown),
    ("y?", CtUnknown)
  ]))
  for call in [
    "helper.pick(x = 10)",
    "helper.pick(x = 10, y = 3)",
    "helper.pick(x = 10, y = None)",
    "helper.pick(x = 10, y = 3)"
  ] {
    let source = "fn main() -> Int { " + call + " }"
    let (tokens, starts, _) = lex_with_offsets(source)
    let stmts = parse_program_located(tokens = tokens, starts = starts, source = source)
    let (_, rows, _, _) = check_program_with_env_typed_lowering_located_observation(stmts = stmts, initial_env = env)
    match rows {
      Some(_) => (),
      None => assert(false)
    }
  }
}

/// A build consuming checked rows must not resolve the declaration a second
/// time from a syntax-only name table that the checked import did not publish.
test "lowering consumes an imported placement without a syntactic header" {
  let env = env_bind(env = env_bind(env = EnvEmpty, name = "f", ty = CtFn([
    CtInt,
    CtInt
  ], CtInt, None)), name = "#params:f", ty = CtRecord([
    ("y", CtUnknown),
    ("x", CtUnknown)
  ]))
  let source = "fn main() -> Int { f(y = 3, x = 10) }"
  let (tokens, starts, _) = lex_with_offsets(source)
  let stmts = parse_program_located(tokens = tokens, starts = starts, source = source)
  let (_, rows, _, _) = check_program_with_env_typed_lowering_located_observation(stmts = stmts, initial_env = env)
  match rows {
    Some(found) => assert(lowering_message(source = source, rows = found, expand_inspect = false) == ""),
    None => assert(false)
  }
}
