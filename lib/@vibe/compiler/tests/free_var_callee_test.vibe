import @vibe/compiler/core {
  Expr
}
import @vibe/compiler/codegen/common_analysis {
  collect_free_vars_expr, collect_free_vars_indexed, collect_free_vars_indexed_self, collect_free_vars_used_builtins
}

/// How many more heap bytes scanning `name()` takes than scanning `name`.
/// Each scan allocates a scratch array (`collect_free_vars_expr`'s `encl`) and
/// frees it on the RC lane, so the first scan grows the heap by its size and
/// a later one reuses the block. One scan before measuring puts both
/// measured scans in that state; a temporary identifier node for the callee
/// would still have to grow the heap.
fn call_scan_extra_bytes(name: String, bound: Array[String], globals: Array[String]) -> Int with Profiler {
  let ident = EIdent(name, -1)
  let call = ECall(ident, [], -1, [])
  let out: Array[String] = []
  let _ = collect_free_vars_expr(expr = ident, bound = bound, fn_names = globals, out = out)
  let start = Profiler::heap_bytes()
  let _ = collect_free_vars_expr(expr = ident, bound = bound, fn_names = globals, out = out)
  let ident_bytes = Profiler::heap_bytes() - start
  let before = Profiler::heap_bytes()
  let _ = collect_free_vars_expr(expr = call, bound = bound, fn_names = globals, out = out)
  let call_bytes = Profiler::heap_bytes() - before
  call_bytes - ident_bytes
}

test "direct callees need no temporary identifier node" {
  let bytes = [
    call_scan_extra_bytes(name = "local", bound = ["local"], globals = []),
    call_scan_extra_bytes(name = "global", bound = [], globals = ["global"])
  ]
  inspect(bytes, content = "[0, 0]")
}

test "reads, callees and writes keep first-occurrence order and deduplicate" {
  let body = ETuple([
    EIdent("first", -1),
    ECall(EIdent("callee", -1), [EIdent("arg", -1)], -1, []),
    EAssign("callee", EIdent("value", -1), EUnit, -1),
    EAssignOp("slot", "+", EIdent("delta", -1), EIdent("first", -1), -1)
  ])
  inspect(collect_free_vars_indexed(body = body, param_names = [], fn_name_index = [
  ]), content = "[first, callee, arg, value, slot, delta]")
}

test "local and enclosing bindings keep precedence for each name occurrence" {
  let uses: Array[Expr] = [
    EIdent("name", -1),
    ECall(EIdent("name", -1), [], -1, []),
    EAssign("name", EInt(1), EUnit, -1),
    EAssignOp("name", "+", EInt(1), EUnit, -1)
  ]
  let globals = ["name"]
  let mut i = 0
  while i < Array::length(uses) {
    let use = Array::get(uses, at = i)
    inspect(collect_free_vars_indexed_self(body = use, param_names = [], fn_name_index = globals, self_name = "", encl = [
      "name"
    ]), content = "[name]")
    inspect(collect_free_vars_indexed_self(body = use, param_names = ["name"], fn_name_index = globals, self_name = "", encl = [
      "name"
    ]), content = "[]")
    inspect(collect_free_vars_indexed(body = use, param_names = [], fn_name_index = globals), content = "[]")
    i = i + 1
  }
}

test "inline builtin skipping applies only to unshadowed capture callees" {
  let ident = EIdent("not", -1)
  let call = ECall(ident, [EBool(true)], -1, [])
  inspect(collect_free_vars_indexed(body = ident, param_names = [], fn_name_index = [
  ]), content = "[not]")
  inspect(collect_free_vars_indexed(body = call, param_names = [], fn_name_index = [
  ]), content = "[]")
  inspect(collect_free_vars_used_builtins(body = call, param_names = [], fn_name_index = [
  ]), content = "[not]")
  inspect(collect_free_vars_indexed_self(body = call, param_names = [], fn_name_index = [
  ], self_name = "", encl = ["not"]), content = "[not]")
}

test "throw skips magic names while other performs keep their callees" {
  let payload = EIdent("payload", -1)
  let throw_call = ECall(EIdent("perform", -1), [
    ECall(EIdent("Exception::Throw", -1), [payload], -1, [])
  ], -1, [])
  let other_call = ECall(EIdent("perform", -1), [
    ECall(EIdent("Log::Emit", -1), [payload], -1, [])
  ], -1, [])
  inspect(collect_free_vars_indexed(body = throw_call, param_names = [], fn_name_index = [
  ]), content = "[payload]")
  inspect(collect_free_vars_used_builtins(body = throw_call, param_names = [], fn_name_index = [
  ]), content = "[payload]")
  inspect(collect_free_vars_indexed(body = other_call, param_names = [], fn_name_index = [
  ]), content = "[perform, Log::Emit, payload]")
  inspect(collect_free_vars_indexed(body = ECall(EIdent("perform", -1), [], -1, [
  ]), param_names = ["perform"], fn_name_index = []), content = "[]")
}

test "inline callee names obey local then enclosing then global precedence" {
  let call = ECall(EIdent("not", -1), [EIdent("argument", -1)], -1, [])
  let globals = ["not"]
  inspect(collect_free_vars_indexed_self(body = call, param_names = [], fn_name_index = globals, self_name = "", encl = [
    "not"
  ]), content = "[not, argument]")
  inspect(collect_free_vars_indexed_self(body = call, param_names = ["not"], fn_name_index = globals, self_name = "", encl = [
    "not"
  ]), content = "[argument]")
  inspect(collect_free_vars_indexed(body = call, param_names = [], fn_name_index = globals), content = "[argument]")
  inspect(collect_free_vars_used_builtins(body = call, param_names = [], fn_name_index = globals), content = "[argument]")
}

test "skipped callees still scan arguments and preserve prior value references" {
  let body = ETuple([
    EIdent("not", -1),
    ECall(EIdent("not", -1), [EIdent("first", -1)], -1, []),
    ECall(EIdent("global", -1), [EIdent("second", -1)], -1, []),
    ECall(EIdent("Path::resolve", -1), [EIdent("third", -1)], -1, []),
    ECall(EIdent("global", -1), [EIdent("first", -1)], -1, [])
  ])
  inspect(collect_free_vars_indexed(body = body, param_names = [], fn_name_index = [
    "global"
  ]), content = "[not, first, second, third]")
  inspect(collect_free_vars_used_builtins(body = body, param_names = [], fn_name_index = [
    "global"
  ]), content = "[not, first, second, Path::resolve, third]")
}
