//# Imports

import @vibe/compiler/entry/compiler {
  compile_source
}

import ./s5_test_support.vibe {
  load_merged, load_sources
}

//# Misc

test "S5: single-file compile" {
  let bytes = compile_source("let add: (Int, Int) -> Int = (a, b) -> { a + b }")
  assert(Bytes::length(bytes) > 0)
}

test "S5: sources bundle loads" {
  let sources = load_sources()
  assert(Array::length(sources) > 20)
}

test "S5: collect_merged_stmts from bundle" {
  let merged = load_merged()
  assert(Array::length(merged) > 100)
}
