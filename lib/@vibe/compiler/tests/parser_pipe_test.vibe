//# Imports

import ./parser_test_support.vibe {
  parse_print
}

//# Misc

test "parse pipe" {
  let result = handle {
    parse_print("x |> f |> g")
  } with Error {
    Throw(e) => String::concat("ERROR: ", e)
  }
  assert(result == "g(f(x))")
}

test "parse pipe with args" {
  let result = handle {
    parse_print("x |> f(1, 2)")
  } with Error {
    Throw(e) => String::concat("ERROR: ", e)
  }
  assert(result == "f(x, 1, 2)")
}

test "parse pipe mixed left without parens error" {
  let result = handle {
    parse_print("1 + 1 |> f")
  } with Error {
    Throw(e) => String::concat("ERROR: ", e)
  }
  assert(result == "ERROR: cannot mix '|>' with other infix operators without explicit parentheses")
}

test "parse pipe mixed right without parens error" {
  let result = handle {
    parse_print("x |> f + g")
  } with Error {
    Throw(e) => String::concat("ERROR: ", e)
  }
  assert(result == "ERROR: cannot mix '|>' with other infix operators without explicit parentheses")
}

test "parse pipe mixed with parens ok" {
  let result = handle {
    parse_print("(1 + 1) |> f")
  } with Error {
    Throw(e) => String::concat("ERROR: ", e)
  }
  assert(result == "f((1 + 1))")
}

test "parse pipe placeholder leading position" {
  let result = handle {
    parse_print("xs |> Array::map(_, parse_int)")
  } with Error {
    Throw(e) => String::concat("ERROR: ", e)
  }
  assert(result == "Array::map(xs, parse_int)")
}

test "parse pipe placeholder trailing position" {
  let result = handle {
    parse_print("x |> f(a, _)")
  } with Error {
    Throw(e) => String::concat("ERROR: ", e)
  }
  assert(result == "f(a, x)")
}

test "parse pipe placeholder middle position" {
  let result = handle {
    parse_print("x |> g(a, _, b)")
  } with Error {
    Throw(e) => String::concat("ERROR: ", e)
  }
  assert(result == "g(a, x, b)")
}

test "parse pipe placeholder sole argument" {
  let result = handle {
    parse_print("x |> f(_)")
  } with Error {
    Throw(e) => String::concat("ERROR: ", e)
  }
  assert(result == "f(x)")
}

test "parse pipe repeats bare placeholder" {
  let result = handle {
    parse_print("x |> pair(_, _)")
  } with Error {
    Throw(e) => String::concat("ERROR: ", e)
  }
  assert(result == "pair(x, x)")
}

test "parse pipe without placeholder still prepends" {
  let result = handle {
    parse_print("x |> f(a)")
  } with Error {
    Throw(e) => String::concat("ERROR: ", e)
  }
  assert(result == "f(x, a)")
}
