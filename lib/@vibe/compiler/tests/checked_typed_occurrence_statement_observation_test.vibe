//# #1379 Phase 3 statement-owner typed-occurrence observation

import @vibe/compiler/core {
  Expr, Stmt, Type, TypeEnv, TypeExpr, env_bind
}

import @vibe/compiler/checker {
  CheckedTypedOccurrenceStatementObservation,
  canonical_checked_typed_occurrence_statement_snapshot,
  check_program_result,
  check_program_typed_occurrence_statement_observation,
  check_program_with_env_typed_occurrence_statement_observation,
  checked_typed_occurrence_statement_observation_capture_ordinal_at,
  checked_typed_occurrence_statement_observation_row_count,
  checked_typed_occurrence_statement_observation_statement_path_at
}

import @vibe/core {
  array_empty
}

fn observation_fixture() -> Array[Stmt] {
  [
    // Checked after Choice by the type-declaration schedule, but this retained
    // statement path must stay root index zero.
    SLet(false, false, "before_type", None, EIdent("Pick", 10)),
    SEnum(false, "Choice", array_empty(), [
      ("Pick", array_empty())
    ], array_empty()),
    SModule(false, "Nested", [
      SLet(false, false, "inside", None, ESeq(EFn(array_empty(), array_empty(), [
        ("arg", None)
      ], None, None, EIdent("arg", 20)), ECall(EIdent("Array::length", 20), [
        EArray([
          EInt(1)
        ])
      ], 30)))
    ]),
    // Shared source offsets are intentionally retained as two capture rows
    // under the same owner, rather than being deduplicated by the observer.
    SLet(false, false, "outside", None, ESeq(EIdent("Pick", 40), EIdent("Pick", 40)))
  ]
}

fn ints_equal(left: Array[Int], right: Array[Int]) -> Bool {
  if Array::length(left) != Array::length(right) {
    false
  } else {
    let mut i = 0
    let mut equal = true
    while i < Array::length(left) {
      if Array::get(left, i) != Array::get(right, i) {
        equal = false
      } else {
        ()
      }
      i = i + 1
    }
    equal
  }
}

fn assert_row_path(observation: CheckedTypedOccurrenceStatementObservation, row_index: Int, expected: Array[Int]) -> Unit {
  match checked_typed_occurrence_statement_observation_statement_path_at(observation, row_index) {
    Some(path) => assert(ints_equal(path, expected)),
    None => assert(false)
  }
}

fn assert_row_ordinal(observation: CheckedTypedOccurrenceStatementObservation, row_index: Int, expected: Int) -> Unit {
  match checked_typed_occurrence_statement_observation_capture_ordinal_at(observation, row_index) {
    Some(ordinal) => assert(ordinal == expected),
    None => assert(false)
  }
}

fn path_is(observation: CheckedTypedOccurrenceStatementObservation, row_index: Int, expected: Array[Int]) -> Bool {
  match checked_typed_occurrence_statement_observation_statement_path_at(observation, row_index) {
    Some(path) => ints_equal(path, expected),
    None => false
  }
}

fn snapshot_contains(snapshot: String, wanted: String) -> Bool {
  String::index_of(snapshot, wanted) >= 0
}

fn shifted_offset_fixture(base: Int) -> Array[Stmt] {
  [
    SStruct(false, "Box", [
      ("value", TyName("Int"))
    ], array_empty(), array_empty(), array_empty()),
    SLet(false, false, "box", None, ECall(EIdent("Box", base + 1), [
      EInt(1)
    ], base + 2)),
    SLet(false, false, "value", None, EDot(EIdent("box", base + 3), "value", base + 4, base + 5))
  ]
}

fn legacy_offsets_differ(left: Array[(Int, Type)], right: Array[(Int, Type)]) -> Bool {
  if Array::length(left) != Array::length(right) {
    true
  } else {
    let mut i = 0
    let mut differs = false
    while i < Array::length(left) {
      let (left_offset, _) = Array::get(left, i)
      let (right_offset, _) = Array::get(right, i)
      if left_offset != right_offset {
        differs = true
      } else {
        ()
      }
      i = i + 1
    }
    differs
  }
}

fn effectset_fixture() -> Array[Stmt] {
  [
    SEffectSet(false, "Caps", [
      "Fs",
      "Error"
    ]),
    SLet(false, false, "f", None, EFn(array_empty(), array_empty(), array_empty(), None, Some("Caps"), ECall(EIdent("Array::length", 50), [
      EArray([
        EInt(1)
      ])
    ], 51)))
  ]
}

test "statement-owner accessors retain exact root and nested paths" {
  match check_program_typed_occurrence_statement_observation(observation_fixture()) {
    Some(observation) => {
      assert(checked_typed_occurrence_statement_observation_row_count(observation) == 5)
      // The type-scheduled declaration does not change the first source path.
      assert_row_path(observation, 0, [
        0
      ])
      assert_row_ordinal(observation, 0, 0)
      // The module container owns no rows; both belong to its child.
      assert_row_path(observation, 1, [
        2,
        0
      ])
      assert_row_path(observation, 2, [
        2,
        0
      ])
      assert_row_ordinal(observation, 1, 0)
      assert_row_ordinal(observation, 2, 1)
      let mut i = 0
      while i < checked_typed_occurrence_statement_observation_row_count(observation) {
        assert(!path_is(observation, i, [
          2
        ]))
        i = i + 1
      }
      // The same legacy offset appears twice, but capture ordinals stay exact.
      assert_row_path(observation, 3, [
        3
      ])
      assert_row_path(observation, 4, [
        3
      ])
      assert_row_ordinal(observation, 3, 0)
      assert_row_ordinal(observation, 4, 1)
      match checked_typed_occurrence_statement_observation_statement_path_at(observation, 5) {
        None => (),
        Some(_) => assert(false)
      }
      match checked_typed_occurrence_statement_observation_capture_ordinal_at(observation, -1) {
        None => (),
        Some(_) => assert(false)
      }
    },
    None => assert(false)
  }
}

test "statement-owner snapshot ignores legacy EIdent ECall and EDot offsets" {
  let before = shifted_offset_fixture(10)
  let after = shifted_offset_fixture(100)
  let before_legacy = check_program_result(before)
  let after_legacy = check_program_result(after)
  assert(legacy_offsets_differ(before_legacy.typed_occurrences, after_legacy.typed_occurrences))
  match check_program_typed_occurrence_statement_observation(shifted_offset_fixture(10)) {
    Some(before_observation) => match check_program_typed_occurrence_statement_observation(shifted_offset_fixture(100)) {
      Some(after_observation) => {
        assert(canonical_checked_typed_occurrence_statement_snapshot(before_observation) == canonical_checked_typed_occurrence_statement_snapshot(after_observation))
      },
      None => assert(false)
    },
    None => assert(false)
  }
}

test "statement-owner observation keeps final substitutions for generalized calls" {
  let stmts = [
    SLet(false, false, "identity", None, EFn(array_empty(), array_empty(), [
      ("x", None)
    ], None, None, EIdent("x", 60))),
    SLet(false, false, "answer", None, ECall(EIdent("identity", 61), [
      EInt(1)
    ], 62))
  ]
  match check_program_typed_occurrence_statement_observation(stmts) {
    Some(observation) => {
      let snapshot = canonical_checked_typed_occurrence_statement_snapshot(observation)
      // `ECall`'s fresh result variable is resolved by final_subst to Int.
      assert(snapshot_contains(snapshot, "2:I0"))
      assert_row_path(observation, 1, [
        1
      ])
    },
    None => assert(false)
  }
}

test "statement-owner ordinary and with-env effectset-expanded observations have parity" {
  match check_program_typed_occurrence_statement_observation(effectset_fixture()) {
    Some(ordinary) => match check_program_with_env_typed_occurrence_statement_observation(effectset_fixture(), env_bind(EnvEmpty, "seed", CtInt)) {
      Some(with_env) => {
        assert(checked_typed_occurrence_statement_observation_row_count(ordinary) == checked_typed_occurrence_statement_observation_row_count(with_env))
        assert(canonical_checked_typed_occurrence_statement_snapshot(ordinary) == canonical_checked_typed_occurrence_statement_snapshot(with_env))
      },
      None => assert(false)
    },
    None => assert(false)
  }
}
