//# Imports

import @vibe/compiler/checker/builtin_sigs {
  lookup_builtin, lookup_builtin_fallback
}

import @vibe/compiler/core {
  Expr, Stmt, Type, builtin_param_label_names, builtin_param_labels, builtin_registry_typed, expr_children
}

import @vibe/parser {
  parse_source_with_ranges
}

//# Functions

/// The parameter count of a builtin's checker type, or -1 when the type is not
/// a function.
fn builtin_type_arity(ty: Type) -> Int {
  match ty {
    CtFn(params, _, _) => Array::length(params),
    CtForAll(_, _, body) => builtin_type_arity(body),
    _ => -1
  }
}

// Read literals from parsed code, so comments and formatting cannot add or
// hide fallback names. The actual fallback lookup below decides which of
// these strings is a builtin; the syntax walk does not infer signatures.
fn fallback_name_literals(expr: Expr, out: Array[String]) -> Unit {
  match expr {
    EString(name, _) => Array::push(out, name),
    _ => ()
  }
  for child in expr_children(expr) {
    fallback_name_literals(child, out)
  }
  ()
}

fn fallback_stmt_literals(stmt: Stmt, out: Array[String]) -> Unit {
  match stmt {
    SLet(_, _, _, _, body) => fallback_name_literals(body, out),
    SFnDecl(_, _, body, _, _) => fallback_name_literals(body, out),
    SLetMut(_, _, body) => fallback_name_literals(body, out),
    SLetPat(_, body) => fallback_name_literals(body, out),
    SExpr(body) => fallback_name_literals(body, out),
    SModule(_, _, stmts) => {
      for s in stmts {
        fallback_stmt_literals(s, out)
      }
      ()
    },
    _ => ()
  }
}

fn fallback_name_is_synthesized(name: String) -> Bool {
  name == "Some" || name == "None" || name == "__index" || name == "__set_field" || name == "__rec_field" || name == "__exn_kind" || name == "__exn_message"
}

//# Misc

/// ADR-0120 Phase 1a (#3659): every checker-visible registry builtin carries
/// parameter labels, so a new builtin cannot ship without them. A builtin with
/// no row refuses every label (fails closed), which is why the census is a
/// test rather than a guess.
test "every checker-visible registry builtin has parameter labels" {
  let rows = builtin_registry_typed()
  let mut missing = 0
  for row in rows {
    let (name, _, _, _, visible) = row
    if visible {
      match builtin_param_labels(name) {
        Some(_) => (),
        None => {
          println("builtin without parameter labels: \{name}")
          missing = missing + 1
        }
      }
    } else {
      ()
    }
  }
  assert(missing == 0)
}

/// Non-registry builtins are discovered in the fallback implementation, not
/// in the labels table: deleting a fallback's row must fail this census too.
test "every checker-visible fallback builtin has matching parameter labels" {
  let dir = "lib/@vibe/compiler/checker/builtin_sigs"
  let mut files = 0
  let mut checked = 0
  let mut bad = 0
  for file in Fs::readdir(dir) {
    if String::ends_with(file, ".vibe") {
      files = files + 1
      let path = dir + "/" + file
      let stmts = parse_source_with_ranges(Fs::read_file(path))
      let names: Array[String] = []
      for stmt in stmts {
        fallback_stmt_literals(stmt, names)
      }
      for name in names {
        if fallback_name_is_synthesized(name) {
          ()
        } else {
          match lookup_builtin_fallback(name) {
            Some(ty) => {
              checked = checked + 1
              match builtin_param_labels(name) {
                Some(labels) => if builtin_type_arity(ty) != Array::length(labels) {
                  println("fallback builtin has wrong parameter-label arity: \{name}")
                  bad = bad + 1
                } else {
                  ()
                },
                None => {
                  println("fallback builtin without parameter labels: \{name}")
                  bad = bad + 1
                }
              }
            },
            None => ()
          }
        }
      }
    } else {
      ()
    }
  }
  assert(files > 0)
  assert(checked > 0)
  assert(bad == 0)
}

/// A row's arity must match the builtin's type, or a label would name a slot
/// the call does not have (or miss one it does).
test "every parameter-label row matches its builtin's arity" {
  let mut bad = 0
  for name in builtin_param_label_names() {
    let labels = match builtin_param_labels(name) {
      Some(ls) => ls,
      None => []
    }
    match lookup_builtin(name) {
      Some(ty) => {
        let arity = builtin_type_arity(ty)
        if arity != Array::length(labels) {
          println("parameter-label row for \{name} has \{Array::length(labels)} labels, its type has \{arity} parameters")
          bad = bad + 1
        } else {
          ()
        }
      },
      None => {
        println("parameter-label row names no checker-visible builtin: \{name}")
        bad = bad + 1
      }
    }
  }
  assert(bad == 0)
}

/// A label must be unique within a row, or two slots would answer to one
/// spelling.
test "parameter labels are unique within a builtin" {
  let mut bad = 0
  for name in builtin_param_label_names() {
    let labels = match builtin_param_labels(name) {
      Some(ls) => ls,
      None => []
    }
    let mut i = 0
    while i < Array::length(labels) {
      let li = Array::get(labels, i)
      let mut j = i + 1
      while j < Array::length(labels) {
        if li != "_" && li == Array::get(labels, j) {
          println("builtin \{name} repeats the label \{li}")
          bad = bad + 1
        } else {
          ()
        }
        j = j + 1
      }
      i = i + 1
    }
  }
  assert(bad == 0)
}

/// Each name appears once in the table.
test "parameter-label rows are not duplicated" {
  let names = builtin_param_label_names()
  let mut bad = 0
  let mut i = 0
  while i < Array::length(names) {
    let mut j = i + 1
    while j < Array::length(names) {
      if Array::get(names, i) == Array::get(names, j) {
        println("duplicated parameter-label row: \{Array::get(names, i)}")
        bad = bad + 1
      } else {
        ()
      }
      j = j + 1
    }
    i = i + 1
  }
  assert(bad == 0)
}

/// A legacy spelling answers for its canonical name, as `lookup_builtin`
/// resolves it.
test "a legacy builtin spelling has its canonical name's labels" {
  match builtin_param_labels("Fs::ReadFile") {
    Some(labels) => assert(Array::length(labels) == 1),
    None => assert(false)
  }
}
