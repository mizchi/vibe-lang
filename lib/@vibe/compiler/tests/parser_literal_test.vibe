//# Imports

import ./parser_test_support.vibe {
  parse_print
}

//# Misc

test "parse array" {
  let result = handle {
    parse_print("[1, 2, 3]")
  } with Exception {
    Throw(e) => String::concat("ERROR: ", e)
  }
  assert(result == "[1, 2, 3]")
}

test "parse tuple" {
  let result = handle {
    parse_print("(1, 2)")
  } with Exception {
    Throw(e) => String::concat("ERROR: ", e)
  }
  assert(result == "(1, 2)")
}

test "parse unit" {
  let result = handle {
    parse_print("()")
  } with Exception {
    Throw(e) => String::concat("ERROR: ", e)
  }
  assert(result == "()")
}
