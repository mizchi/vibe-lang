//# Imports

import @vibe/compiler/core {
  Stmt
}

import @vibe/compiler/loader {
  collect_merged_stmts, ingest_source_text_fs
}

import ../compiler_sources_bundle.vibe {
  compiler_sources
}

import ../selfbuild_runtime_entry_bundle.vibe {
  selfbuild_runtime_entry_source
}

//# Functions

export fn load_sources() -> Array[(String, String)] {
  compiler_sources()
}

/// #770: the bundle embeds RAW file text (generate_bundle.sh is a
/// bash/python tool with no vibe-level parser access, so it cannot desugar
/// `.vibei` contract packages at bundle-generation time). The production merge
/// path (entry/source_compile/wasi_only/merge_sources.vibe) applies the same
/// `.vibei` contract desugar via `ingest_source_text_fs` before parsing each
/// file; `collect_merged_stmts` alone does not, so handing it raw `.vibei` text
/// (e.g. lib/@vibe/ast/index.vpkg's bare `version 0.1.0` line and bodyless
/// `let name: Type` declarations) fails to parse ("expected = but got export").
/// Ingest each source through the same desugar step here before merging.
fn ingest_all(sources: Array[(String, String)]) -> Array[(String, String)] with Exception + Fs {
  let out = Array::slice([
    ("", "")
  ], 0, 0)
  let mut i = 0
  while i < Array::length(sources) {
    let (path, src) = Array::get(sources, i)
    Array::push(out, (path, ingest_source_text_fs(path, src)))
    i = i + 1
  }
  out
}

export fn load_merged() -> Array[Stmt] with Exception + Fs {
  // ADR-0069: the S5 tests compile the merge with a REAL entry (`_start` /
  // `selfbuild_entry`); a missing entry is a compile error now (the old runs
  // silently fell back to an empty test-runner `_start`). Append the runtime
  // entry source — the same statements the production stage build appends —
  // so those entries actually exist in the merge.
  let sources = ingest_all(load_sources())
  Array::push(sources, ("_selfbuild_runtime_entry.vibe", selfbuild_runtime_entry_source()))
  collect_merged_stmts(sources)
}
