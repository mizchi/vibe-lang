//# Imports

import ../checker_builtins.vibe {
  infer_array_element, infer_array_get, infer_array_length, infer_array_slice, infer_builtin_call, infer_map_op, infer_string_op
}

import @vibe/core {
  array_empty
}

import @vibe/compiler/core {
  Type, types_equal
}

//# Misc

test "infer_array_get with CtArray(CtInt) returns CtInt" {
  let result = infer_array_get(CtArray(CtInt))
  assert(types_equal(result, CtInt))
}

test "infer_array_get with non-array returns CtUnknown" {
  let result = infer_array_get(CtString)
  assert(types_equal(result, CtUnknown))
}

test "infer_array_element with CtArray(CtString) returns CtString" {
  let result = infer_array_element(CtArray(CtString))
  assert(types_equal(result, CtString))
}

test "infer_array_slice with CtArray(CtInt) returns CtArray(CtInt)" {
  let result = infer_array_slice(CtArray(CtInt))
  assert(types_equal(result, CtArray(CtInt)))
}

test "infer_array_length returns CtInt" {
  let result = infer_array_length()
  assert(types_equal(result, CtInt))
}

test "infer_string_op String::length returns CtInt" {
  let result = infer_string_op("String::length")
  assert(types_equal(result, CtInt))
}

test "infer_string_op String::concat returns CtString" {
  let result = infer_string_op("String::concat")
  assert(types_equal(result, CtString))
}

test "infer_string_op String::equals returns CtBool" {
  let result = infer_string_op("String::equals")
  assert(types_equal(result, CtBool))
}

test "infer_map_op map_has returns CtBool" {
  let result = infer_map_op("map_has")
  assert(types_equal(result, CtBool))
}

test "infer_map_op Map::keys returns CtArray(CtString)" {
  let result = infer_map_op("Map::keys")
  assert(types_equal(result, CtArray(CtString)))
}

test "infer_builtin_call Array::get with CtArray(CtInt)" {
  let result = infer_builtin_call("Array::get", [
    CtArray(CtInt),
    CtInt
  ])
  assert(types_equal(result, CtInt))
}

test "infer_builtin_call array_new returns CtArray(CtUnknown)" {
  let no_args: Array[Type] = array_empty()
  let result = infer_builtin_call("array_new", no_args)
  assert(types_equal(result, CtArray(CtUnknown)))
}

test "infer_builtin_call Array::length returns CtInt" {
  let result = infer_builtin_call("Array::length", [
    CtArray(CtString)
  ])
  assert(types_equal(result, CtInt))
}

test "infer_builtin_call String::equals returns CtBool" {
  let result = infer_builtin_call("String::equals", [
    CtString,
    CtString
  ])
  assert(types_equal(result, CtBool))
}

test "infer_builtin_call print returns CtUnit" {
  let result = infer_builtin_call("print", [
    CtString
  ])
  assert(types_equal(result, CtUnit))
}

test "infer_builtin_call eq returns CtBool" {
  let result = infer_builtin_call("eq", [
    CtInt,
    CtInt
  ])
  assert(types_equal(result, CtBool))
}

test "infer_builtin_call unknown_fn returns CtUnknown" {
  let result = infer_builtin_call("unknown_fn", [
    CtInt
  ])
  assert(types_equal(result, CtUnknown))
}

test "infer_builtin_call Http::respond returns Unit" {
  let result = infer_builtin_call("Http::respond", [
    CtUnknown,
    CtInt,
    CtString
  ])
  assert(types_equal(result, CtUnit))
}

test "infer_builtin_call Http::response_status returns Int" {
  let result = infer_builtin_call("Http::response_status", [
    CtUnknown
  ])
  assert(types_equal(result, CtInt))
}

test "infer_builtin_call Http::response_body returns String" {
  let result = infer_builtin_call("Http::response_body", [
    CtUnknown
  ])
  assert(types_equal(result, CtString))
}

test "infer_builtin_call sh returns String" {
  let result = infer_builtin_call("sh", [
    CtString
  ])
  assert(types_equal(result, CtString))
}

test "infer_builtin_call Fs::read_file returns String" {
  let result = infer_builtin_call("Fs::read_file", [
    CtString
  ])
  assert(types_equal(result, CtString))
}

test "infer_builtin_call Fs::write_file returns Unit" {
  let result = infer_builtin_call("Fs::write_file", [
    CtString,
    CtString
  ])
  assert(types_equal(result, CtUnit))
}

test "infer_builtin_call Fs::publish_immutable_text returns Bool" {
  let result = infer_builtin_call("Fs::publish_immutable_text", [
    CtString,
    CtString
  ])
  assert(types_equal(result, CtBool))
}

test "infer_builtin_call Fs::exists returns Bool" {
  let result = infer_builtin_call("Fs::exists", [
    CtString
  ])
  assert(types_equal(result, CtBool))
}

test "infer_builtin_call Fs::stat_token returns Int" {
  let result = infer_builtin_call("Fs::stat_token", [
    CtString
  ])
  assert(types_equal(result, CtInt))
}

test "infer_builtin_call Fs::readdir returns Array of String" {
  let result = infer_builtin_call("Fs::readdir", [
    CtString
  ])
  assert(types_equal(result, CtArray(CtString)))
}

test "infer_builtin_call Env::get returns String" {
  let result = infer_builtin_call("Env::get", [
    CtString
  ])
  assert(types_equal(result, CtString))
}

test "infer_builtin_call Env::args_len returns Int" {
  let no_args: Array[Type] = array_empty()
  let result = infer_builtin_call("Env::args_len", no_args)
  assert(types_equal(result, CtInt))
}

test "infer_builtin_call Env::args_get returns String" {
  let result = infer_builtin_call("Env::args_get", [
    CtInt
  ])
  assert(types_equal(result, CtString))
}

test "infer_builtin_call Double::to_int returns Int" {
  let result = infer_builtin_call("Double::to_int", [
    CtDouble
  ])
  assert(types_equal(result, CtInt))
}

test "infer_builtin_call Int::to_double returns Double" {
  let result = infer_builtin_call("Int::to_double", [
    CtInt
  ])
  assert(types_equal(result, CtDouble))
}
