import @vibe/compiler/core {
  Expr, Pat, Stmt, TypeExpr
}
import @vibe/core {
  struct MutSet
}
import @vibe/compiler/lowering/effects/queries {
  edp_collect_program_binders, edp_handle_statement_index, edp_mf_dirty_indices, edp_mf_dirty_reset, edp_mf_set_stmt
}
import @vibe/compiler/lowering/effects/evidence {
  edp_append_ctor_inert_names,
  edp_append_free_host_inert_names,
  edp_append_visible_pure_lambda_names,
  edp_collect_fn_defs,
  edp_etawrap_stmts_in,
  edp_mf_base,
  edp_mf_binders,
  edp_mf_effect_sites,
  edp_mf_handle_count,
  edp_mf_handle_statement_index,
  edp_mf_new,
  edp_mf_refresh,
  edp_mf_row_lit_scan,
  edp_mf_statements_naming,
  edp_needing_escape_stmts_in,
  edp_pure_fn_names,
  edp_row_lit_scan
}

fn call(_ name: String) -> Expr {
  ECall(EIdent(name, -1), [], -1, [])
}

fn pure_lambda() -> Expr {
  EFn([], [], [("x", None)], None, None, EIdent("x", -1))
}

fn host_lambda() -> Expr {
  EFn([], [], [("x", None)], None, None, call("vibe_clock_raw"))
}

fn top_fn(name: String, params: Array[(String, Option[TypeExpr])], body: Expr) -> Stmt {
  SLet(false, false, name, None, EFn([], [], params, None, None, body))
}

// The whole-program walks a migration used to run on every rewritten tree.
fn walked_base(_ stmts: Array[Stmt]) -> String {
  let base = edp_pure_fn_names(edp_collect_fn_defs(stmts))
  edp_append_free_host_inert_names(stmts = stmts, pure_fns = base)
  edp_append_ctor_inert_names(stmts = stmts, pure_fns = base)
  edp_append_visible_pure_lambda_names(stmts = stmts, pure_fns = base)
  String::join(base, sep = ",")
}

fn same_members(a: MutSet[String], b: MutSet[String]) -> Bool {
  let mut same = MutSet::size(a) == MutSet::size(b)
  for nm in MutSet::to_array(a) {
    if !MutSet::has(b, x = nm) {
      same = false
    }
  }
  same
}

// Refresh, then demand exactly the walked answer: same names in the same
// order, and the same binder census.
fn facts_agree(facts: Array[(Array[String], Array[Expr], Array[String], Array[String], Array[String], Bool, Array[String], Array[String], Array[Array[String]], Array[String])], stmts: Array[Stmt]) -> Bool {
  edp_mf_refresh(facts = facts, stmts = stmts)
  let from_facts = String::join(edp_mf_base(facts = facts, stmts = stmts, fn_defs = edp_collect_fn_defs(stmts)), sep = ",")
  from_facts == walked_base(stmts) && same_members(a = edp_mf_binders(facts), b = edp_collect_program_binders(stmts))
}

fn program() -> Array[Stmt] {
  let use_helper = ECall(EIdent("helper", -1), [EInt(1)], -1, [])
  [
    top_fn(name = "top", params = [], body = ELet("helper", pure_lambda(), use_helper, -1)),
    // `helper` is rebound as a parameter here, so it is not a sole spelling.
    top_fn(name = "other", params = [("helper", None)], body = ESeq(call("vibe_fs_raw"), EIdent("helper", -1))),
    SLetMut("m", None, ELet("only", pure_lambda(), call("vibe_fs_raw"), -1)),
    SExpr(ESeq(call("vibe_net_raw"), ELet("t", EInt(0), EIdent("t", -1), -1))),
    SEnum(false, "Choice", [], [("Yes", []), ("No", [])], [])
  ]
}

test "migration facts give the walked base and census, through marked rewrites and appends" {
  let stmts = program()
  let facts = edp_mf_new()
  assert(facts_agree(facts = facts, stmts = stmts))
  inspect(walked_base(stmts), content = "top,other,vibe_fs_raw,vibe_net_raw,Some,Ok,Err,Yes,No,only")
  // A marked rewrite: `other` no longer rebinds `helper`, so `helper` becomes
  // a sole lambda spelling, and a host callee moves.
  edp_mf_set_stmt(stmts = stmts, i = 1, stmt = top_fn(name = "other", params = [
  ], body = ESeq(call("vibe_env_raw"), EInt(0))))
  assert(facts_agree(facts = facts, stmts = stmts))
  inspect(walked_base(stmts), content = "top,other,vibe_env_raw,vibe_fs_raw,vibe_net_raw,Some,Ok,Err,Yes,No,helper,only")
  // An append past the end is walked as new.
  Array::push(stmts, value = top_fn(name = "late", params = [], body = ELet("only", host_lambda(), EInt(0), -1)))
  assert(facts_agree(facts = facts, stmts = stmts))
  // The same statement rewritten twice before one refresh.
  edp_mf_set_stmt(stmts = stmts, i = 3, stmt = SExpr(EInt(0)))
  edp_mf_set_stmt(stmts = stmts, i = 3, stmt = SExpr(ELet("t2", EInt(0), call("vibe_tty_raw"), -1)))
  assert(facts_agree(facts = facts, stmts = stmts))
}

test "a rewrite that stops binding a spelling to a lambda takes it out of the base" {
  // Two statements bind `twin` to a pure lambda, so every binder of the
  // spelling is a candidate and `twin` joins the base. Rewriting one of them
  // to bind `twin` to a plain value leaves one candidate against two binders.
  let use_twin = ECall(EIdent("twin", -1), [EInt(1)], -1, [])
  let stmts = [
    top_fn(name = "first", params = [], body = ELet("twin", pure_lambda(), use_twin, -1)),
    top_fn(name = "second", params = [], body = ELet("twin", pure_lambda(), use_twin, -1))
  ]
  let facts = edp_mf_new()
  assert(facts_agree(facts = facts, stmts = stmts))
  inspect(String::contains(walked_base(stmts), needle = "twin"), content = "true")
  edp_mf_set_stmt(stmts = stmts, i = 1, stmt = top_fn(name = "second", params = [
  ], body = ELet("twin", EInt(5), EIdent("twin", -1), -1)))
  assert(facts_agree(facts = facts, stmts = stmts))
  inspect(String::contains(walked_base(stmts), needle = "twin"), content = "false")
}

test "a rewrite that keeps the candidate names still changes the base" {
  // #3950: the base reuses the candidate positions while every statement's
  // candidate names stand. Rewriting `helper`'s lambda to call `asks`, which
  // has a row, keeps the names, so the positions are reused, but the lambda
  // it reads is the new one, and `helper` leaves the base.
  let use_helper = ECall(EIdent("helper", -1), [EInt(1)], -1, [])
  let asking = EFn([], [], [("x", None)], None, None, call("asks"))
  let stmts = [
    SLet(false, false, "asks", None, EFn([], [], [], None, Some("Ask"), EInt(0))),
    top_fn(name = "top", params = [], body = ELet("helper", pure_lambda(), use_helper, -1)),
    top_fn(name = "next", params = [], body = ELet("spare", pure_lambda(), EInt(0), -1))
  ]
  let facts = edp_mf_new()
  assert(facts_agree(facts = facts, stmts = stmts))
  inspect(walked_base(stmts), content = "top,next,Some,Ok,Err,helper,spare")
  edp_mf_set_stmt(stmts = stmts, i = 1, stmt = top_fn(name = "top", params = [], body = ELet("helper", asking, use_helper, -1)))
  assert(facts_agree(facts = facts, stmts = stmts))
  inspect(walked_base(stmts), content = "top,next,Some,Ok,Err,spare")
}

test "a rewrite that adds a candidate before another moves the positions" {
  // #3950: the positions index the candidates in statement order, so a new
  // candidate in front of `pure_one` moves it. Reading the old positions would
  // judge `pure_one` by the new impure lambda and leave it out of the base.
  let asking = EFn([], [], [("x", None)], None, None, call("asks"))
  let use_pure = ECall(EIdent("pure_one", -1), [EInt(1)], -1, [])
  let stmts = [
    SLet(false, false, "asks", None, EFn([], [], [], None, Some("Ask"), EInt(0))),
    top_fn(name = "top", params = [], body = ELet("pure_one", pure_lambda(), use_pure, -1))
  ]
  let facts = edp_mf_new()
  assert(facts_agree(facts = facts, stmts = stmts))
  inspect(walked_base(stmts), content = "top,Some,Ok,Err,pure_one")
  edp_mf_set_stmt(stmts = stmts, i = 1, stmt = top_fn(name = "top", params = [], body = ELet("first", asking, ELet("pure_one", pure_lambda(), use_pure, -1), -1)))
  assert(facts_agree(facts = facts, stmts = stmts))
  inspect(walked_base(stmts), content = "top,Some,Ok,Err,pure_one")
}

test "an appended candidate is judged, not admitted for want of a position" {
  // #3950: a candidate the positions do not know has no bodies to check, which
  // reads as "every body is pure". An appended statement must rebuild them.
  let asking = EFn([], [], [("x", None)], None, None, call("asks"))
  let stmts = [
    SLet(false, false, "asks", None, EFn([], [], [], None, Some("Ask"), EInt(0))),
    top_fn(name = "top", params = [], body = ELet("pure_one", pure_lambda(), EInt(0), -1))
  ]
  let facts = edp_mf_new()
  assert(facts_agree(facts = facts, stmts = stmts))
  Array::push(stmts, value = top_fn(name = "late", params = [], body = ELet("late_one", asking, EInt(0), -1)))
  assert(facts_agree(facts = facts, stmts = stmts))
  inspect(walked_base(stmts), content = "top,late,Some,Ok,Err,pure_one")
}

test "an unmarked rewrite is not seen, which is why every migration write is marked" {
  let stmts = program()
  let facts = edp_mf_new()
  assert(facts_agree(facts = facts, stmts = stmts))
  Array::set(stmts, at = 1, value = top_fn(name = "other", params = [], body = EInt(0)))
  assert(!facts_agree(facts = facts, stmts = stmts))
}

fn row_lambda(_ body: Expr) -> Expr {
  EFn([], [], [], None, Some("Ask"), body)
}

// The facts-filtered scan must collect exactly what the whole scan collects:
// the same binding names in the same order, and as many literals.
fn row_scans_agree(facts: Array[(Array[String], Array[Expr], Array[String], Array[String], Array[String], Bool, Array[String], Array[String], Array[Array[String]], Array[String])], stmts: Array[Stmt], needing: Array[String]) -> String {
  let es_names: Array[String] = []
  let es_members: Array[Array[String]] = []
  let whole_binds: Array[String] = []
  let whole_lits: Array[Expr] = []
  edp_row_lit_scan(stmts = stmts, ename = "Ask", needing = needing, es_names = es_names, es_members_list = es_members, binds = whole_binds, lits = whole_lits)
  let some_binds: Array[String] = []
  let some_lits: Array[Expr] = []
  edp_mf_row_lit_scan(facts = Some(facts), stmts = stmts, ename = "Ask", needing = needing, es_names = es_names, es_members_list = es_members, binds = some_binds, lits = some_lits)
  assert(String::join(whole_binds, sep = ",") == String::join(some_binds, sep = ","))
  assert(Array::length(whole_lits) == Array::length(some_lits))
  String::join(some_binds, sep = ",") + " lits=" + Int::to_string(Array::length(some_lits))
}

test "the facts-filtered row-literal scan collects what the whole scan collects" {
  let stmts = [
    top_fn(name = "owner", params = [], body = ELet("g", row_lambda(EInt(1)), EIdent("g", -1), -1)),
    SExpr(ELet("h", EIdent("needy", -1), EInt(0), -1)),
    SExpr(ELet("k", EIdent("other", -1), EInt(0), -1)),
    top_fn(name = "plain", params = [], body = EInt(0)),
    // A top-level function with a row is the needing rewrite's, not a literal.
    SLet(false, false, "rowed", None, row_lambda(EInt(2)))
  ]
  let facts = edp_mf_new()
  edp_mf_refresh(facts = facts, stmts = stmts)
  inspect(row_scans_agree(facts = facts, stmts = stmts, needing = ["needy"]), content = "g,h lits=1")
  inspect(row_scans_agree(facts = facts, stmts = stmts, needing = []), content = "g lits=1")
  // A marked rewrite that introduces a row literal is seen by the next scan.
  edp_mf_set_stmt(stmts = stmts, i = 3, stmt = top_fn(name = "plain", params = [
  ], body = ELet("late", row_lambda(EInt(3)), EInt(0), -1)))
  inspect(row_scans_agree(facts = facts, stmts = stmts, needing = ["needy"]), content = "g,h,late lits=2")
}

fn row_free_slot() -> TypeExpr {
  TyFn([TyName("Int")], TyName("Int"), None)
}

fn call_cb() -> Expr {
  ECall(EIdent("cb", -1), [EInt(1)], -1, [])
}

fn passing_program() -> Array[Stmt] {
  [
    top_fn(name = "f", params = [("x", None)], body = EIdent("x", -1)),
    // A row-free function slot: passing a needing function here escapes.
    top_fn(name = "g", params = [("cb", Some(row_free_slot()))], body = call_cb()),
    top_fn(name = "user", params = [], body = ECall(EIdent("g", -1), [
      EIdent("f", -1)
    ], -1, [])),
    top_fn(name = "alias", params = [], body = ELet("h", EIdent("f", -1), EInt(0), -1)),
    top_fn(name = "plain", params = [], body = ECall(EIdent("g", -1), [
      EIdent("other", -1)
    ], -1, [])),
    SExpr(EInt(0))
  ]
}

// The eta-wrap and escape walks restricted to the statements the facts name
// must answer what the whole walks answer, and rewrite the same statements.
fn wrap_and_escape(_ filtered: Bool) -> String {
  let stmts = passing_program()
  let fn_defs = edp_collect_fn_defs(stmts)
  let needing = ["f"]
  let es_names: Array[String] = []
  let es_members: Array[Array[String]] = []
  let facts = edp_mf_new()
  let escape_first = edp_needing_escape_stmts_in(stmts = stmts, indices = if filtered {
    Some(edp_mf_statements_naming(facts = facts, stmts = stmts, needing = needing, lets = false))
  } else {
    None
  }, needing = needing, ename = "Ask", fn_defs = fn_defs, es_names = es_names, es_members_list = es_members)
  let wrap_at = if filtered {
    Some(edp_mf_statements_naming(facts = facts, stmts = stmts, needing = needing, lets = true))
  } else {
    None
  }
  edp_mf_dirty_reset()
  let rebuilt = edp_etawrap_stmts_in(stmts = stmts, indices = wrap_at, needing = needing, ename = "Ask", fn_defs = fn_defs, es_names = es_names, es_members_list = es_members)
  let written: Array[String] = []
  for i in edp_mf_dirty_indices() {
    Array::push(written, value = Int::to_string(i))
  }
  let wrapped = if rebuilt {
    "yes"
  } else {
    "no"
  }
  "escape=" + escape_first + " rebuilt=" + wrapped + " written=" + String::join(written, sep = ",")
}

test "the facts-filtered eta-wrap and escape walks match the whole walks" {
  let whole = wrap_and_escape(false)
  assert(wrap_and_escape(true) == whole)
  inspect(whole, content = "escape=f rebuilt=yes written=2,3")
}

fn passes(_ arg: String) -> Stmt {
  SExpr(ECall(EIdent("g", -1), [EIdent(arg, -1)], -1, []))
}

fn naming(stmts: Array[Stmt], needing: Array[String], lets: Bool) -> String {
  let found: Array[String] = []
  for i in edp_mf_statements_naming(facts = edp_mf_new(), stmts = stmts, needing = needing, lets = lets) {
    Array::push(found, value = Int::to_string(i))
  }
  String::join(found, sep = ",")
}

test "the statements naming a needing function, whatever their names look like" {
  // #3950: a name is rejected by its first byte and length before it is
  // hashed. A non-member sharing both with a member, two long names sharing
  // the overflow bit, and a non-ASCII first byte must still answer as the set.
  let long_a = "a_function_name_long_enough_to_share_the_overflow_bit_with_another_one_a"
  let long_b = "a_function_name_long_enough_to_share_the_overflow_bit_with_another_one_b"
  let stmts = [
    passes("fa"),
    passes("fb"),
    passes(long_a),
    passes(long_b),
    SExpr(ELet("h", EIdent("fb", -1), EInt(0), -1)),
    passes("élan")
  ]
  let needing = ["fb", long_b, "élan"]
  inspect(naming(stmts = stmts, needing = needing, lets = false), content = "1,3,5")
  inspect(naming(stmts = stmts, needing = needing, lets = true), content = "1,3,4,5")
  inspect(naming(stmts = stmts, needing = [], lets = true), content = "")
}

fn handle_of(effect: String, body: Expr) -> Expr {
  EHandle(body, [
    (PCtor(effect + "::Get", []), EInt(1)),
    (PCtor(effect + "::Put", []), EInt(2))
  ])
}

fn perform_of(_ effect: String) -> Expr {
  ECall(EIdent("perform", -1), [ECall(EIdent(effect + "::Get", -1), [], -1, [])], -1, [
  ])
}

fn render_index(_ index: Array[(String, Array[Int])]) -> String {
  let parts: Array[String] = []
  for row in index {
    let (name, statements) = row
    let ns: Array[String] = []
    for i in statements {
      Array::push(ns, value = Int::to_string(i))
    }
    Array::push(parts, value = name + "=" + String::join(ns, sep = ","))
  }
  String::join(parts, sep = " ")
}

// The handle index and the effect sites read from the facts, beside the walk
// of the statements they replace (#4040).
fn sites_agree(facts: Array[(Array[String], Array[Expr], Array[String], Array[String], Array[String], Bool, Array[String], Array[String], Array[Array[String]], Array[String])], stmts: Array[Stmt]) -> Bool {
  edp_mf_refresh(facts = facts, stmts = stmts)
  render_index(edp_mf_handle_statement_index(facts)) == render_index(edp_handle_statement_index(stmts))
}

test "the handle index and effect sites come from the facts, through marked rewrites and appends" {
  let stmts = [
    // Two handles, the inner one nested in the outer's body; `Log` is first
    // indexed here, `Ask` is not.
    top_fn(name = "both", params = [], body = handle_of(effect = "Log", body = handle_of(effect = "Ask", body = perform_of("Ask")))),
    SEnum(false, "Choice", [], [("Yes", []), ("No", [])], []),
    SExpr(ESeq(perform_of("Log"), handle_of(effect = "Ask", body = EInt(0)))),
    // A `let` pattern statement is not one of the five forms the index reads.
    SLetPat(PBind("p"), handle_of(effect = "Gone", body = EInt(0)))
  ]
  let facts = edp_mf_new()
  assert(sites_agree(facts = facts, stmts = stmts))
  inspect(render_index(edp_mf_handle_statement_index(facts)), content = "Log=0 Ask=0,2")
  inspect(edp_mf_handle_count(facts = facts, i = 0), content = "2")
  inspect(edp_mf_handle_count(facts = facts, i = 1), content = "0")
  inspect(edp_mf_handle_count(facts = facts, i = 2), content = "1")
  let (qnames, performs) = edp_mf_effect_sites(facts)
  inspect(String::join(qnames, sep = ","), content = "Log::Get,Log::Put,Ask::Get,Ask::Put,Ask::Get,Ask::Put")
  inspect(String::join(performs, sep = ","), content = "Ask,Log")
  // A marked rewrite drops statement 0's handles and adds one of `Tick`.
  edp_mf_set_stmt(stmts = stmts, i = 0, stmt = top_fn(name = "both", params = [], body = handle_of(effect = "Tick", body = EInt(0))))
  assert(sites_agree(facts = facts, stmts = stmts))
  inspect(render_index(edp_mf_handle_statement_index(facts)), content = "Tick=0 Ask=2")
  // An appended statement is walked as new.
  Array::push(stmts, value = SExpr(handle_of(effect = "Log", body = perform_of("Log"))))
  assert(sites_agree(facts = facts, stmts = stmts))
  inspect(render_index(edp_mf_handle_statement_index(facts)), content = "Tick=0 Ask=2 Log=4")
}
