//# #1379 Phase 3 active direct-function effective-row observation tests.

import @vibe/compiler/checker {
  CheckedProgram, canonical_checked_effect_row_snapshot, check_program_result, check_program_with_env_result
}

import @vibe/compiler/checker/artifacts {
  canonical_checked_effective_effect_row_snapshot, checked_effective_effect_row_observation
}

import @vibe/compiler/core {
  Expr, Stmt, Subst, Type, TypeEnv, TypeExpr, env_bind, env_cached, env_value_binding
}

import @vibe/core {
  array_empty
}

fn direct_fn(row: Option[String], body: Expr) -> Expr {
  EFn(array_empty(), array_empty(), array_empty(), None, row, body)
}

fn checked_with(stmts: Array[Stmt], env: TypeEnv, subst: Subst) -> CheckedProgram {
  CheckedProgram::{
    checked_stmts: stmts,
    final_env: env,
    type_defs: array_empty(),
    final_subst: subst,
    typed_occurrences: array_empty()
  }
}

fn observed_snapshot(_ checked: CheckedProgram) -> Option[String] {
  match checked_effective_effect_row_observation(checked) {
    Some(observation) => canonical_checked_effective_effect_row_snapshot(observation),
    None => None
  }
}

fn assert_some_text(_ value: Option[String]) -> String {
  match value {
    Some(text) => text,
    None => {
      assert(false)
      ""
    }
  }
}

test "effective row observation keeps raw source options and canonicalizes only final row" {
  let stmts = [
    SLet(false, false, "f", Some(TyFn(array_empty(), TyUnit, Some("Source, Source"))), direct_fn(row = Some(""), body = EUnit))
  ]
  let checked = checked_with(stmts = stmts, env = EnvFlat([
    ("f", env_value_binding(CtFn(array_empty(), CtUnit, Some("Fs, Error, Fs"))))
  ]), subst = SubstEmpty)
  let snapshot = assert_some_text(observed_snapshot(checked))
  assert(String::contains(snapshot, needle = "S14:Source, Source"))
  assert(String::contains(snapshot, needle = "S0:"))
  assert(String::contains(snapshot, needle = canonical_checked_effect_row_snapshot(s = SubstEmpty, effect = Some("Error, Fs"))))
  let no_source_row = checked_with(stmts = [
    SLet(false, false, "f", Some(TyFn(array_empty(), TyUnit, Some("Source, Source"))), direct_fn(row = None, body = EUnit))
  ], env = EnvFlat([
    ("f", env_value_binding(CtFn(array_empty(), CtUnit, Some("Error, Fs"))))
  ]), subst = SubstEmpty)
  assert(snapshot != assert_some_text(observed_snapshot(no_source_row)))
  assert(canonical_checked_effect_row_snapshot(s = SubstEmpty, effect = Some("Fs, Error, Fs")) == canonical_checked_effect_row_snapshot(s = SubstEmpty, effect = Some("Error, Fs")))
  assert(canonical_checked_effect_row_snapshot(s = SubstEmpty, effect = Some("Exception[IoError]")) != canonical_checked_effect_row_snapshot(s = SubstEmpty, effect = Some("Exception[ParseError]")))
}

test "effective row observation resolves transitive effect variables" {
  let checked = checked_with(stmts = [
    SLet(false, false, "f", None, direct_fn(row = Some("e"), body = EUnit))
  ], env = EnvFlat([
    ("f", env_value_binding(CtFn(array_empty(), CtUnit, Some("e"))))
  ]), subst = SubstEffBind("e", "x", SubstEffBind("x", "Fs, Fs", SubstEmpty)))
  let snapshot = assert_some_text(observed_snapshot(checked))
  assert(String::contains(snapshot, needle = canonical_checked_effect_row_snapshot(s = SubstEmpty, effect = Some("Fs"))))
}

test "effective row observation selects active root shadows in source order and locates roots" {
  let checked = checked_with(stmts = [
    SLet(false, false, "a", None, direct_fn(row = Some("A"), body = EUnit)),
    SLet(false, false, "f", None, direct_fn(row = Some("Old"), body = EUnit)),
    SLet(false, false, "f", None, direct_fn(row = Some("New"), body = EUnit))
  ], env = EnvBind("f", env_value_binding(CtFn(array_empty(), CtUnit, Some("New"))), EnvBind("a", env_value_binding(CtFn(array_empty(), CtUnit, Some("A"))), EnvEmpty)), subst = SubstEmpty)
  let snapshot = assert_some_text(observed_snapshot(checked))
  assert(String::starts_with(snapshot, prefix = "vibe-checked-effective-effect-rows-observation:v1\n2:0:1:a"))
  assert(String::contains(snapshot, needle = "2:1:f"))
  assert(!String::contains(snapshot, needle = "S3:Old"))
  let shifted = checked_with(stmts = [
    SExpr(EUnit),
    SLet(false, false, "a", None, direct_fn(row = Some("A"), body = EUnit)),
    SLet(false, false, "f", None, direct_fn(row = Some("Old"), body = EUnit)),
    SLet(false, false, "f", None, direct_fn(row = Some("New"), body = EUnit))
  ], env = EnvBind("f", env_value_binding(CtFn(array_empty(), CtUnit, Some("New"))), EnvBind("a", env_value_binding(CtFn(array_empty(), CtUnit, Some("A"))), EnvEmpty)), subst = SubstEmpty)
  assert(snapshot != assert_some_text(observed_snapshot(shifted)))
}

test "effective row observation excludes non-root and mutable candidates and fails closed" {
  let checked = checked_with(stmts = [
    SLetMut("mut_fn", None, direct_fn(row = Some("Mut"), body = EUnit)),
    SModule(false, "Nested", [
      SLet(false, false, "hidden", None, direct_fn(row = Some("Hidden"), body = EUnit))
    ]),
    SLet(false, false, "outer", Some(TyName("NotFn")), direct_fn(row = Some("Root"), body = direct_fn(row = Some("NestedFn"), body = EUnit)))
  ], env = EnvFlat([
    ("outer", env_value_binding(CtFn(array_empty(), CtUnit, Some("Root"))))
  ]), subst = SubstEmpty)
  let snapshot = assert_some_text(observed_snapshot(checked))
  assert(String::starts_with(snapshot, prefix = "vibe-checked-effective-effect-rows-observation:v1\n1:"))
  assert(!String::contains(snapshot, needle = "Hidden"))
  assert(!String::contains(snapshot, needle = "NestedFn"))
  // An active selected owner without an authoritative final binding is rejected.
  let malformed = checked_with(stmts = [
    SLet(false, false, "missing", None, direct_fn(row = None, body = EUnit))
  ], env = EnvEmpty, subst = SubstEmpty)
  match observed_snapshot(malformed) {
    None => assert(true),
    Some(_) => assert(false)
  }
  // EnvFlat is an association list: duplicate names select the first match.
  let duplicate_flat = checked_with(stmts = [
    SLet(false, false, "f", None, direct_fn(row = None, body = EUnit))
  ], env = EnvFlat([
    ("f", env_value_binding(CtFn(array_empty(), CtUnit, Some("First")))),
    ("f", env_value_binding(CtFn(array_empty(), CtUnit, Some("Second"))))
  ]), subst = SubstEmpty)
  let duplicate_flat_snapshot = assert_some_text(observed_snapshot(duplicate_flat))
  assert(String::contains(duplicate_flat_snapshot, needle = canonical_checked_effect_row_snapshot(s = SubstEmpty, effect = Some("First"))))
  assert(!String::contains(duplicate_flat_snapshot, needle = canonical_checked_effect_row_snapshot(s = SubstEmpty, effect = Some("Second"))))
}

test "effectset expansion has identical direct-function association with imported env" {
  let stmts = [
    SEffectSet(false, "Caps", ["Fs", "Error"]),
    SLet(false, false, "f", None, direct_fn(row = Some("Caps"), body = EUnit))
  ]
  let ordinary = check_program_result(stmts)
  let imported = check_program_with_env_result(stmts = stmts, initial_env = env_bind(env = EnvEmpty, name = "seed", ty = CtInt))
  let ordinary_snapshot = assert_some_text(observed_snapshot(ordinary))
  let imported_snapshot = assert_some_text(observed_snapshot(imported))
  assert(ordinary_snapshot == imported_snapshot)
  // The retained source row remains raw while the final row saw expansion.
  assert(String::contains(ordinary_snapshot, needle = "S4:Caps"))
  assert(String::contains(ordinary_snapshot, needle = canonical_checked_effect_row_snapshot(s = SubstEmpty, effect = Some("Fs, Error"))))
}

test "effective row observation skips any earlier root binding shadowed by final non-function root" {
  let later_let = checked_with(stmts = [
    SLet(false, false, "f", None, direct_fn(row = Some("Old"), body = EUnit)),
    SLet(false, false, "f", None, EInt(1))
  ], env = EnvFlat([("f", env_value_binding(CtInt))]), subst = SubstEmpty)
  let later_let_snapshot = assert_some_text(observed_snapshot(later_let))
  assert(later_let_snapshot == "vibe-checked-effective-effect-rows-observation:v1\n0:")
  let later_mut = checked_with(stmts = [
    SLet(false, false, "f", None, direct_fn(row = Some("Old"), body = EUnit)),
    SLetMut("f", None, EInt(1))
  ], env = EnvFlat([("f", env_value_binding(CtInt))]), subst = SubstEmpty)
  let later_mut_snapshot = assert_some_text(observed_snapshot(later_mut))
  assert(later_mut_snapshot == "vibe-checked-effective-effect-rows-observation:v1\n0:")
}

test "effective row observation validates cached env state and keeps valid cached duplicates leftmost" {
  let direct = [
    SLet(false, false, "f", None, direct_fn(row = None, body = EUnit))
  ]
  let cached_duplicates = checked_with(stmts = direct, env = env_cached(names = [
    "f",
    "f"
  ], bindings = [
    env_value_binding(CtFn(array_empty(), CtUnit, Some("First"))),
    env_value_binding(CtFn(array_empty(), CtUnit, Some("Second")))
  ], rest = EnvEmpty), subst = SubstEmpty)
  let cached_duplicate_snapshot = assert_some_text(observed_snapshot(cached_duplicates))
  assert(String::contains(cached_duplicate_snapshot, needle = canonical_checked_effect_row_snapshot(s = SubstEmpty, effect = Some("First"))))
  assert(!String::contains(cached_duplicate_snapshot, needle = canonical_checked_effect_row_snapshot(s = SubstEmpty, effect = Some("Second"))))
  let unsorted_cached = checked_with(stmts = direct, env = env_cached(names = [
    "z",
    "f"
  ], bindings = [
    env_value_binding(CtFn(array_empty(), CtUnit, Some("Z"))),
    env_value_binding(CtFn(array_empty(), CtUnit, Some("F")))
  ], rest = EnvEmpty), subst = SubstEmpty)
  match observed_snapshot(unsorted_cached) {
    None => assert(true),
    Some(_) => assert(false)
  }
  let mismatched_cached = checked_with(stmts = direct, env = env_cached(names = [
    "f"
  ], bindings = [], rest = EnvEmpty), subst = SubstEmpty)
  match observed_snapshot(mismatched_cached) {
    None => assert(true),
    Some(_) => assert(false)
  }
}

test "effective row observation accepts production generalized direct functions" {
  let checked = check_program_result([
    SLet(false, false, "identity", None, EFn(array_empty(), array_empty(), [
      ("x", None)
    ], None, None, EIdent("x", -1)))
  ])
  let snapshot = assert_some_text(observed_snapshot(checked))
  assert(String::contains(snapshot, needle = "8:identity"))
  assert(String::contains(snapshot, needle = canonical_checked_effect_row_snapshot(s = SubstEmpty, effect = None)))
}

test "effective row observation resolves CtVar and effect chains without accepting cycles" {
  let via_type_var = checked_with(stmts = [
    SLet(false, false, "f", None, direct_fn(row = Some("e"), body = EUnit))
  ], env = EnvFlat([("f", env_value_binding(CtVar(1)))]), subst = SubstBind(1, CtVar(2), SubstBind(2, CtFn(array_empty(), CtUnit, Some("e")), SubstEffBind("e", "x", SubstEffBind("x", "Fs", SubstEmpty)))))
  let via_type_var_snapshot = assert_some_text(observed_snapshot(via_type_var))
  assert(String::contains(via_type_var_snapshot, needle = canonical_checked_effect_row_snapshot(s = SubstEmpty, effect = Some("Fs"))))
  let cyclic_effect = checked_with(stmts = [
    SLet(false, false, "f", None, direct_fn(row = Some("e"), body = EUnit))
  ], env = EnvFlat([
    ("f", env_value_binding(CtFn(array_empty(), CtUnit, Some("e"))))
  ]), subst = SubstEffBind("e", "x", SubstEffBind("x", "e", SubstEmpty)))
  match observed_snapshot(cyclic_effect) {
    None => assert(true),
    Some(_) => assert(false)
  }
}
