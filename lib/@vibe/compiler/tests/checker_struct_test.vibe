//# Imports

import ../checker_struct.vibe {
  check_duplicate_fields, check_missing_fields, check_record_fields, check_struct_arity, lookup_struct_field
}

import @vibe/core {
  array_empty
}

import @vibe/compiler/core {
  Type, TypeDef, types_equal
}

//# Functions

fn make_defs() -> Array[TypeDef] {
  [TDStruct("Point", [("x", CtInt), ("y", CtInt)], array_empty(), array_empty())]
}

//# Misc

test "check_duplicate_fields no duplicates" {
  let fields: Array[(String, Type)] = [("x", CtInt), ("y", CtInt)]
  let dupes = check_duplicate_fields(fields)
  assert(eq(Array::length(dupes), 0))
}

test "check_duplicate_fields with duplicates" {
  let fields: Array[(String, Type)] = [
    ("x", CtInt),
    ("y", CtInt),
    ("x", CtString)
  ]
  let dupes = check_duplicate_fields(fields)
  assert(eq(Array::length(dupes), 1))
  assert(Array::get(dupes, 0) == "x")
}

test "check_struct_arity matches" {
  let defs = make_defs()
  assert(check_struct_arity(defs, "Point", 2))
}

test "check_struct_arity mismatch" {
  let defs = make_defs()
  assert(not(check_struct_arity(defs, "Point", 3)))
}

test "check_struct_arity unknown struct" {
  let defs = make_defs()
  assert(check_struct_arity(defs, "Unknown", 5))
}

test "lookup_struct_field existing field" {
  let defs = make_defs()
  let ty = lookup_struct_field(defs, "Point", "x")
  assert(types_equal(ty, CtInt))
}

test "lookup_struct_field missing field" {
  let defs = make_defs()
  let ty = lookup_struct_field(defs, "Point", "z")
  assert(types_equal(ty, CtUnknown))
}

test "lookup_struct_field unknown struct" {
  let defs = make_defs()
  let ty = lookup_struct_field(defs, "Unknown", "x")
  assert(types_equal(ty, CtUnknown))
}

test "check_record_fields all valid" {
  let defs = make_defs()
  let bad = check_record_fields(defs, "Point", ["x", "y"])
  assert(eq(Array::length(bad), 0))
}

test "check_record_fields unknown field" {
  let defs = make_defs()
  let bad = check_record_fields(defs, "Point", ["x", "z"])
  assert(eq(Array::length(bad), 1))
  assert(Array::get(bad, 0) == "z")
}

test "check_missing_fields all present" {
  let defs = make_defs()
  let missing = check_missing_fields(defs, "Point", ["x", "y"])
  assert(eq(Array::length(missing), 0))
}

test "check_missing_fields some missing" {
  let defs = make_defs()
  let missing = check_missing_fields(defs, "Point", ["x"])
  assert(eq(Array::length(missing), 1))
  assert(Array::get(missing, 0) == "y")
}
