//# Imports

import @vibe/compiler/core {
  Expr
}

import ../cst.vibe {
  CstChild, NodeKind
}

import ../lower.vibe {
  lower_expr
}

import @vibe/compiler/syntax {
  Token
}

//# Misc

test "lower EInt" {
  let node = CNode(NIntExpr, [CToken(TInt(42))])
  match lower_expr(node) {
    EInt(n) => assert(n == 42),
    _ => assert(false)
  }
}

test "lower EFloat" {
  let node = CNode(NFloatExpr, [CToken(TFloat(3.14))])
  match lower_expr(node) {
    EFloat(_) => assert(true),
    _ => assert(false)
  }
}

test "lower EString" {
  let node = CNode(NStringExpr, [CToken(TString("hi"))])
  match lower_expr(node) {
    EString(s) => assert(s == "hi"),
    _ => assert(false)
  }
}

test "lower EBool" {
  let node = CNode(NBoolExpr, [CToken(TIdent("true"))])
  match lower_expr(node) {
    EBool(b) => assert(b == true),
    _ => assert(false)
  }
}

test "lower EIdent" {
  let node = CNode(NIdentExpr, [CToken(TIdent("foo"))])
  match lower_expr(node) {
    EIdent(name, _) => assert(name == "foo"),
    _ => assert(false)
  }
}

test "lower EUnit" {
  let node = CNode(NUnitExpr, [CToken(TLParen), CToken(TRParen)])
  match lower_expr(node) {
    EUnit => assert(true),
    _ => assert(false)
  }
}

test "lower ETuple" {
  let node = CNode(NTupleExpr, [
    CToken(TLParen),
    CNode(NIntExpr, [CToken(TInt(1))]),
    CToken(TComma),
    CNode(NIntExpr, [CToken(TInt(2))]),
    CToken(TRParen)
  ])
  match lower_expr(node) {
    ETuple(elems) => assert(Array::length(elems) == 2),
    _ => assert(false)
  }
}

test "lower EArray" {
  let node = CNode(NArrayExpr, [
    CToken(TLBracket),
    CNode(NIntExpr, [CToken(TInt(1))]),
    CToken(TComma),
    CNode(NIntExpr, [CToken(TInt(2))]),
    CToken(TRBracket)
  ])
  match lower_expr(node) {
    EArray(elems) => assert(Array::length(elems) == 2),
    _ => assert(false)
  }
}

test "lower ERecord" {
  let node = CNode(NRecordExpr, [
    CToken(TLBrace),
    CNode(NRecordField, [
      CToken(TIdent("x")),
      CToken(TColon),
      CNode(NIntExpr, [CToken(TInt(1))])
    ]),
    CToken(TRBrace)
  ])
  match lower_expr(node) {
    ERecord(_, fields, _) => assert(Array::length(fields) == 1)
    ,
    _ => assert(false)
  }
}
