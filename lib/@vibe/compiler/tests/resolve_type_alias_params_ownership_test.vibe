//# Imports

// #2279: `resolve_type_alias_params` returned `Array::get(args, idx)` for a
// parameter, so the result tree borrowed argument nodes. Walking or dropping
// that tree freed memory the `args` array still owned; a later allocation
// then trapped in `__rt_rc_alloc` far from the substituter.
//
// This file calls the function directly and consumes the result, so a
// regression fails here rather than in an unrelated capture-analysis walk.

import @vibe/compiler/core {
  Type, resolve_type_alias_params, type_to_string, types_equal
}

//# Tests

test "2279: consuming a substituted alias tree does not corrupt later allocation" {
  // type W2[R, T] = (MutList[T, R], R)
  let body = CtTuple([
    CtNamed("MutList", [CtNamed("T", []), CtNamed("R", [])]),
    CtNamed("R", [])
  ])
  let params = ["R", "T"]
  let args = [CtNamed("r", []), CtInt]
  let printed = {
    let resolved = resolve_type_alias_params(body, params, args)
    assert(types_equal(resolved, CtTuple([
      CtNamed("MutList", [CtInt, CtNamed("r", [])]),
      CtNamed("r", [])
    ])))
    type_to_string(resolved)
  }
  assert(printed == "(MutList[Int, r], r)")
  assert(type_to_string(Array::get(args, 0)) == "r")
  let acc: Array[String] = []
  let mut i = 0
  while i < 64 {
    Array::push(acc, String::concat("n", __to_string(i)))
    i = i + 1
  }
  assert(Array::length(acc) == 64)
}
