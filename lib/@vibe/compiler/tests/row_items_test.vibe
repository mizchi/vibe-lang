// #3417: one bracket-aware splitter in core reads a stored row's items
// (`row_items`) and a bracket's type arguments (`split_top_level_commas`).
// A comma inside brackets or parentheses belongs to its item.

import @vibe/compiler/core {
  row_items, split_top_level_commas
}

/// The items, each wrapped in `<>` so an empty item is visible.
fn shown(_ items: Array[String]) -> String {
  let marks: Array[String] = []
  for item in items {
    Array::push(marks, value = "<" + item + ">")
  }
  String::join(marks, sep = " ")
}

test "row items split at top-level commas only" {
  inspect(shown(row_items("IO, Box[Int]")), content = "<IO> <Box[Int]>")
  inspect(shown(row_items("Exception[(Int, Int) -> Int], Fs")), content = "<Exception[(Int, Int) -> Int]> <Fs>")
  inspect(shown(row_items("Map[String, Array[(Int, Int)]]")), content = "<Map[String, Array[(Int, Int)]]>")
  inspect(shown(row_items("  #einst:Box:17 ,Console  ")), content = "<#einst:Box:17> <Console>")
}

test "row items drop empty items" {
  inspect(shown(row_items("")), content = "")
  inspect(shown(row_items("A,, B, ")), content = "<A> <B>")
}

test "type arguments keep empty items" {
  inspect(shown(split_top_level_commas("")), content = "<>")
  inspect(shown(split_top_level_commas("Int, (String, Bool)")), content = "<Int> <(String, Bool)>")
  inspect(shown(split_top_level_commas("A,, B, ")), content = "<A> <> <B> <>")
}
