test "lookup_builtin arithmetic helper add" {
  match lookup_builtin("add") {
    Some(CtFn(params, ret, None)) => {
      assert(Array::length(params) == 2)
      match Array::get(params, 0) {
        CtInt => assert(true),
        _ => assert(false)
      }
      match Array::get(params, 1) {
        CtInt => assert(true),
        _ => assert(false)
      }
      match ret {
        CtInt => assert(true),
        _ => assert(false)
      }
    },
    _ => assert(false)
  }
}

test "lookup_builtin arithmetic helper sub" {
  match lookup_builtin("sub") {
    Some(CtFn(params, ret, None)) => {
