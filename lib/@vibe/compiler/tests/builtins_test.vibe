/// #1593: checker-visible registry rows are the single source of truth.
/// `lookup_builtin` consults the registry first, so carrying the same name in
/// this fallback chain would be a shadowed declaration that no production
/// lookup can reach. Fallback-only builtins remain valid; registry-backed ones
/// must never be reintroduced here.
test "checker-visible registry builtins are absent from fallback declarations" {
  let rows = builtin_registry_typed()
  let mut i = 0
  while i < Array::length(rows) {
    let (name, _, _, _, visible) = Array::get(rows, i)
    if visible {
      match lookup_builtin_fallback(name) {
        Some(_) => {
          println("checker-visible registry builtin is duplicated in fallback declarations: \{name}")
          assert(false)
        },
        None => ()
      }
    } else {
      ()
    }
    i = i + 1
  }
}
