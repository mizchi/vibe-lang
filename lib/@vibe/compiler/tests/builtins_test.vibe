test "lookup_builtin arithmetic helper lt" {
  match lookup_builtin("lt") {
    Some(CtFn(params, ret, None)) => {
      assert(Array::length(params) == 2)
      match Array::get(params, 0) {
        CtInt => assert(true),
        _ => assert(false)
      }
      match Array::get(params, 1) {
        CtInt => assert(true),
        _ => assert(false)
      }
      match ret {
        CtBool => assert(true),
        _ => assert(false)
      }
    },
    _ => assert(false)
  }
}

