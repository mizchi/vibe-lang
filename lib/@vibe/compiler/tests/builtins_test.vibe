//# Imports

import @vibe/compiler/checker {
  lookup_builtin, lookup_builtin_fallback
}

import @vibe/compiler/core {
  Type, builtin_registry_typed, type_to_string
}

//# Misc

test "lookup_builtin normalizes a legacy alias before registry lookup" {
  match lookup_builtin("Fs::ReadFile") {
    Some(_) => assert(true),
    None => assert(false)
  }
}

test "lookup_builtin hides codegen-internal registry rows" {
  match lookup_builtin("vibe_sh_lines_raw") {
    Some(_) => assert(false),
    None => assert(true)
  }
}

test "#1539 stdin provider raw names remain checker-invisible" {
  let names = [
    "vibe_stdin_provider_acquire_raw",
    "vibe_stdin_provider_read_raw",
    "vibe_stdin_provider_close_raw"
  ]
  let mut i = 0
  while i < Array::length(names) {
    match lookup_builtin(Array::get(names, i)) {
      Some(_) => assert(false),
      None => assert(true)
    }
    i = i + 1
  }
}

test "#1539 public StdinStream surface is visible with exact effects" {
  let expected = [
    "() -> StdinStream with Stdin",
    "(StdinStream) -> Int with Async",
    "(StdinStream) -> () with Async"
  ]
  let names = [
    "Stdin::read_via_stream",
    "StdinStream::next",
    "StdinStream::close"
  ]
  let rows = builtin_registry_typed()
  let mut ni = 0
  while ni < Array::length(names) {
    let mut ri = 0
    let mut found = false
    while ri < Array::length(rows) {
      let (name, ty, linear, gc, visible) = Array::get(rows, ri)
      if name == Array::get(names, ni) {
        assert(linear)
        assert(!gc)
        assert(visible)
        assert(type_to_string(ty) == Array::get(expected, ni))
        found = true
      } else {
        ()
      }
      ri = ri + 1
    }
    assert(found)
    ni = ni + 1
  }
}

