/// #835: Int64Array::make/length/get/set — cheatsheet-documented but
/// previously "unknown name" in the checker (absent from every lookup
/// table). See core/builtin_registry.vibe for the fix.
test "lookup_builtin Int64Array::make" {
  match lookup_builtin("Int64Array::make") {
    Some(_) => assert(true),
    None => assert(false)
  }
}

test "lookup_builtin Int64Array::length" {
  match lookup_builtin("Int64Array::length") {
    Some(_) => assert(true),
    None => assert(false)
  }
}

test "lookup_builtin Int64Array::get" {
  match lookup_builtin("Int64Array::get") {
    Some(_) => assert(true),
    None => assert(false)
  }
}

test "lookup_builtin Int64Array::set" {
  match lookup_builtin("Int64Array::set") {
    Some(_) => assert(true),
    None => assert(false)
  }
}

