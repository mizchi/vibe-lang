import @vibe/parser {
  lex, parse_program
}
import @vibe/compiler/perceus {
  compute_passthrough_returning
}

test "a direct callback return identifies its source parameter" {
  let stmts = parse_program(lex("fn borrow_callback(callback: (Int) -> Int) -> (Int) -> Int { callback }"))
  let rows = compute_passthrough_returning(stmts)
  inspect(Array::length(rows), "1")
  inspect(Array::get(rows, 0).0, "borrow_callback")
  inspect(Array::get(rows, 0).1, "0")
}

test "an explicit callback return identifies its source parameter" {
  let stmts = parse_program(lex("fn pass_explicit(callback: (Int) -> Int) -> (Int) -> Int { return callback }"))
  let rows = compute_passthrough_returning(stmts)
  inspect(Array::length(rows), "1")
  inspect(Array::get(rows, 0).0, "pass_explicit")
  inspect(Array::get(rows, 0).1, "0")
}

test "matching return branches identify one passthrough parameter" {
  let stmts = parse_program(lex("fn pass_match(callback: (Int) -> Int, choose: Bool) -> (Int) -> Int { match choose { true => return callback; false => return callback } }"))
  let rows = compute_passthrough_returning(stmts)
  inspect(Array::length(rows), "1")
  inspect(Array::get(rows, 0).0, "pass_match")
  inspect(Array::get(rows, 0).1, "0")
}

test "a labeled parameter is matched by its body spelling" {
  let stmts = parse_program(lex("fn pass_labeled(callback~: (Int) -> Int) -> (Int) -> Int { callback }"))
  let rows = compute_passthrough_returning(stmts)
  inspect(Array::length(rows), "1")
  inspect(Array::get(rows, 0).0, "pass_labeled")
  inspect(Array::get(rows, 0).1, "0")
}

test "a chain of helper calls keeps the original source parameter" {
  let stmts = parse_program(lex("fn pass1(callback: (Int) -> Int) -> (Int) -> Int { callback } fn pass2(callback: (Int) -> Int) -> (Int) -> Int { pass1(callback) } fn pass3(callback: (Int) -> Int) -> (Int) -> Int { pass2(callback) }"))
  let rows = compute_passthrough_returning(stmts)
  inspect(Array::length(rows), "3")
  inspect(Array::get(rows, 2).0, "pass3")
  inspect(Array::get(rows, 2).1, "0")
}

test "a pattern binder cannot stand in for the parameter it shadows" {
  let direct = parse_program(lex("fn pass(callback: (Int) -> Int, opt: Option[(Int) -> Int]) -> (Int) -> Int { match opt { Some(callback) => callback; None => callback } }"))
  inspect(Array::length(compute_passthrough_returning(direct)), "0")
  let forwarded = parse_program(lex("fn identity(callback: (Int) -> Int) -> (Int) -> Int { callback } fn pass(callback: (Int) -> Int, opt: Option[(Int) -> Int]) -> (Int) -> Int { match opt { Some(callback) => identity(callback); None => identity(callback) } }"))
  inspect(Array::length(compute_passthrough_returning(forwarded)), "1")
}

test "a helper with an early fresh return still takes ownership of its argument" {
  let stmts = parse_program(lex("fn pass_or_fresh(callback: (Int) -> Int, choose: Bool) -> (Int) -> Int { if choose { return make_fresh() }; callback }"))
  inspect(Array::length(compute_passthrough_returning(stmts)), "1")
}

test "an assignment continuation preserves a returned parameter" {
  let stmts = parse_program(lex("fn pass(callback: (Int) -> Int) -> (Int) -> Int { let mut n = 0; n = 1; callback }"))
  inspect(Array::length(compute_passthrough_returning(stmts)), "1")
}

test "a local alias chain preserves a returned parameter" {
  let stmts = parse_program(lex("fn pass(callback: (Int) -> Int) -> (Int) -> Int { let first = callback; let second = first; second }"))
  let rows = compute_passthrough_returning(stmts)
  inspect(Array::length(rows), "1")
  inspect(Array::get(rows, 0).0, "pass")
  inspect(Array::get(rows, 0).1, "0")
}

test "a shadowed local does not become a parameter passthrough" {
  let stmts = parse_program(lex("fn pass(callback: (Int) -> Int) -> (Int) -> Int { let alias = callback; let alias = make_fresh(); alias }"))
  inspect(Array::length(compute_passthrough_returning(stmts)), "0")
}
