//# #3536: a body may not make two declared type parameters one type

// Inside its body a declared formal is a unification variable, so
// `fn cast[T, U](x: T) -> U { x }` unified `T` with `U` while the scheme
// still quantified both. `let n: Int = cast("hello")` compiled and `n + 1`
// read the string's pointer (`137438953475`). The declaration is refused now.
import @vibe/compiler/runtime {
  collect_all_diagnostics
}

/// The issue's reproducer: a parameter returned as a different formal.
test "cast between two formals is refused" {
  let src = "fn cast[T, U](x: T) -> U {\n  x\n}\n"
  inspect(collect_all_diagnostics(src), "[line 2:3: write one type parameter in place of both `T` and `U`, or keep their values apart: the body makes `T` and `U` the same type, so a caller that picks two different types for them would read one as the other]")
}

/// The annotated generic `let` desugars to the same generic lambda.
test "an annotated generic let that casts is refused" {
  let src = "let cast2: [T, U](T) -> U = (x) -> {\n  x\n}\n"
  inspect(collect_all_diagnostics(src), "[line 2:3: write one type parameter in place of both `T` and `U`, or keep their values apart: the body makes `T` and `U` the same type, so a caller that picks two different types for them would read one as the other]")
}

/// A swap that forgets to swap makes `A` and `B` one type.
test "a swap returning its argument is refused" {
  let src = "fn swap[A, B](p: (A, B)) -> (B, A) {\n  p\n}\n"
  inspect(collect_all_diagnostics(src), "[line 2:3: write one type parameter in place of both `A` and `B`, or keep their values apart: the body makes `A` and `B` the same type, so a caller that picks two different types for them would read one as the other]")
}

/// The collapse may come from a branch join rather than a return.
test "two formals joined by an if are refused" {
  let src = "fn pick[A, B](c: Bool, a: A, b: B) -> A {\n  if c {\n    a\n  } else {\n    b\n  }\n}\n"
  inspect(collect_all_diagnostics(src), "[line 3:5: write one type parameter in place of both `A` and `B`, or keep their values apart: the body makes `A` and `B` the same type, so a caller that picks two different types for them would read one as the other]")
}

/// A nested generic lambda may not make its formal the enclosing one.
test "a nested binder collapsing into the enclosing formal is refused" {
  let src = "fn outer[T](x: T) -> T {\n  let inner = [U](y: U) -> T {\n    y\n  }\n  x\n}\n"
  inspect(collect_all_diagnostics(src), "[line 3:5: write one type parameter in place of both `U` and `T`, or keep their values apart: the body makes `U` and `T` the same type, so a caller that picks two different types for them would read one as the other]")
}

/// Identity keeps its one formal.
test "identity is accepted" {
  let src = "fn id[T](x: T) -> T {\n  x\n}\n\nfn use_it() -> Int {\n  id(1)\n}\n"
  inspect(collect_all_diagnostics(src), "[]")
}

/// A map-like higher-order function relates two formals only through `f`.
test "a map-like generic higher-order function is accepted" {
  let src = "fn map_all[A, B](xs: Array[A], f: (A) -> B) -> Array[B] {\n  let out: Array[B] = []\n  for x in xs {\n    Array::push(out, f(x))\n  }\n  out\n}\n\nfn compose[A, B, C](f: (B) -> C, g: (A) -> B) -> (A) -> C {\n  (x) -> f(g(x))\n}\n"
  inspect(collect_all_diagnostics(src), "[]")
}

/// A generic struct constructor keeps its formals apart.
test "a generic struct constructor is accepted" {
  let src = "struct Pair[A, B] {\n  first: A;\n  second: B\n}\n\nfn make_pair[A, B](a: A, b: B) -> Pair[A, B] {\n  Pair::{ first: a, second: b }\n}\n\nfn swap_pair[A, B](p: Pair[A, B]) -> Pair[B, A] {\n  Pair::{ first: p.second, second: p.first }\n}\n"
  inspect(collect_all_diagnostics(src), "[]")
}

/// A trait-bounded formal dispatches through its own method.
test "a trait-bounded formal calling its method is accepted" {
  let src = "trait Named {\n  name(Self) -> String\n}\n\nstruct Dog {\n  n: Int\n}\n\nimpl Named for Dog {\n  name(d: Dog) -> String {\n    \"dog\"\n  }\n}\n\nfn greet[T: Named, U: Named](a: T, b: U) -> String {\n  String::concat(T::name(a), U::name(b))\n}\n"
  inspect(collect_all_diagnostics(src), "[]")
}

/// A local generic lambda used at two types.
test "a local generic lambda is accepted" {
  let src = "fn use_both() -> Int {\n  let pair = [A, B](a: A, b: B) -> (A, B) {\n    (a, b)\n  }\n  let (n, _) = pair(1, \"s\")\n  n\n}\n"
  inspect(collect_all_diagnostics(src), "[]")
}
