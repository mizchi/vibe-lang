//# Imports

import ../core {
  append_import_alias_rewritten_non_import_stmts
}

import ../syntax {
  lex, parse_program, print_program
}

//# Misc

test "append import alias rewrite resolves import aliases" {
  let stmts = parse_program(lex("import ./dep.vibe { answer as local }\nexport let run: () -> Int = () -> { local() }"))
  let out = Array::slice(stmts, 0, 0)
  append_import_alias_rewritten_non_import_stmts(out, stmts)
  let printed = print_program(out)
  assert(String::contains(printed, "answer()"))
  assert(!String::contains(printed, "local()"))
}
