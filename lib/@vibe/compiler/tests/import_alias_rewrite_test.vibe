    dependency,
    provider,
    facade,
    entry
  ], "/virtual/entry.vibe")
  let renames = collect_import_value_renames(plan, "/virtual/entry.vibe", entry)
  inspect(Array::length(renames), "1")
  inspect(Array::get(renames, 0).0, "PublicAlias")
  inspect(Array::get(renames, 0).1, "Color")
}

test "a later plain enum re-export replaces an earlier alias" {
  // The checker rejects importing two distinct enums under PublicChoice, but
  // the merge planner must still avoid retaining the earlier alias mapping.
  let first = parse_program(lex("export enum Choice { First }"))
  let later = parse_program(lex("export enum PublicChoice { Local }"))
  let facade = parse_program(lex("export ./first.vibe { enum Choice as PublicChoice }\nexport ./later.vibe { enum PublicChoice }"))
  let entry = parse_program(lex("import ./facade.vibe { PublicChoice }\nlet answer = PublicChoice::Local"))
  let first_path = "/virtual/first.vibe"
  let later_path = "/virtual/later.vibe"
  let facade_path = "/virtual/facade.vibe"
  let entry_path = "/virtual/entry.vibe"
  let plan = build_export_rename_plan([
    first_path,
    later_path,
    facade_path,
    entry_path
  ], [first, later, facade, entry], entry_path)
  let renames = collect_import_value_renames(plan, entry_path, entry)
  inspect(Array::length(renames), "0")
}

test "an enum re-export chain is not limited to sixteen hops" {
  let paths: Array[String] = ["/virtual/provider.vibe"]
  let stmts_list: Array[Array[Stmt]] = [
    parse_program(lex("export enum Choice { First }"))
  ]
  let mut previous = "provider"
  let mut public_name = "Choice"
  let mut i = 0
  while i < 18 {
    let facade = "f" + Int::to_string(i)
    let next_name = "A" + Int::to_string(i)
    Array::push(paths, "/virtual/" + facade + ".vibe")
    Array::push(stmts_list, parse_program(lex("export ./" + previous + ".vibe { " + public_name + " as " + next_name + " }")))
    previous = facade
    public_name = next_name
    i = i + 1
  }
  let entry = parse_program(lex("import ./" + previous + ".vibe { " + public_name + " }\nlet answer = " + public_name + "::First"))
  let entry_path = "/virtual/entry.vibe"
  Array::push(paths, entry_path)
  Array::push(stmts_list, entry)
  let plan = build_export_rename_plan(paths, stmts_list, entry_path)
  let renames = collect_import_value_renames(plan, entry_path, entry)
  inspect(Array::length(renames), "1")
  inspect(Array::get(renames, 0).1, "Choice")
}

test "an enum alias change invalidates the export plan fingerprint" {
  let provider = parse_program(lex("export enum Old { First }\nexport enum New { First }"))
  let old_facade = parse_program(lex("export ./provider.vibe { enum Old as Public }"))
  let new_facade = parse_program(lex("export ./provider.vibe { enum New as Public }"))
  let entry = parse_program(lex("import ./facade.vibe { Public }\nlet result = Public::First"))
  let paths = [
    "/virtual/provider.vibe",
    "/virtual/facade.vibe",
    "/virtual/entry.vibe"
  ]
  let old_plan = build_export_rename_plan(paths, [provider, old_facade, entry], "/virtual/entry.vibe")
  let new_plan = build_export_rename_plan(paths, [provider, new_facade, entry], "/virtual/entry.vibe")
  inspect(export_plan_fingerprint_text(old_plan) == export_plan_fingerprint_text(new_plan), "false")
}

test "a new exported same-name enum invalidates the export plan fingerprint" {
  let provider = parse_program(lex("export enum Choice { First }"))
  let facade = parse_program(lex("export ./provider.vibe { enum Choice as PublicChoice }"))
  let sibling_before = parse_program(lex("export enum Other { Rival }"))
  let sibling_after = parse_program(lex("export enum Choice { Rival }"))
  let entry = parse_program(lex("import ./facade.vibe { PublicChoice }\nimport ./sibling.vibe { Rival }\nlet result = PublicChoice::First"))
  let paths = [
    "/virtual/provider.vibe",
    "/virtual/facade.vibe",
    "/virtual/sibling.vibe",
    "/virtual/entry.vibe"
  ]
  let old_plan = build_export_rename_plan(paths, [
    provider,
    facade,
    sibling_before,
    entry
  ], "/virtual/entry.vibe")
  let new_plan = build_export_rename_plan(paths, [
    provider,
    facade,
    sibling_after,
    entry
  ], "/virtual/entry.vibe")
  inspect(export_plan_fingerprint_text(old_plan) == export_plan_fingerprint_text(new_plan), "false")
}

test "an alias formal does not follow a same-spelled imported enum" {
  let hue = parse_program(lex("export enum Hue { Red }"))
  let provider = parse_program(lex("import ./hue.vibe { enum Hue as T }\nexport type Box[T] = T"))
  let facade = parse_program(lex("export ./provider.vibe { Box as PublicBox }"))
  let entry = parse_program(lex("import ./facade.vibe { PublicBox }"))
  let paths = [
    "/virtual/hue.vibe",
    "/virtual/provider.vibe",
    "/virtual/facade.vibe",
    "/virtual/entry.vibe"
  ]
  let plan = build_export_rename_plan(paths, [hue, provider, facade, entry], "/virtual/entry.vibe")
  inspect(Array::length(collect_import_value_renames(plan, "/virtual/entry.vibe", entry)), "0")
}

test "a higher-kinded alias formal does not follow a same-spelled enum" {
  let enum_f = parse_program(lex("export enum F { Red }"))
  let provider = parse_program(lex("import ./enum_f.vibe { enum F }\nexport type Apply[F[_], A] = F[A]"))
  let facade = parse_program(lex("export ./provider.vibe { Apply as PublicApply }"))
  let entry = parse_program(lex("import ./facade.vibe { PublicApply }"))
  let paths = [
    "/virtual/enum_f.vibe",
    "/virtual/provider.vibe",
    "/virtual/facade.vibe",
    "/virtual/entry.vibe"
  ]
  let plan = build_export_rename_plan(paths, [enum_f, provider, facade, entry], "/virtual/entry.vibe")
  inspect(Array::length(collect_import_value_renames(plan, "/virtual/entry.vibe", entry)), "0")
}

//# #2348: a WAT body's `call $name` survives the merge rename

/// The name a top-level value statement binds, however it is spelled.
fn iw_stmt_binding_name(stmt: Stmt) -> String {
  match stmt {
    SFnDecl(_, name, _, _, _) => name,
    SLet(_, _, name, _, _) => name,
    _ => ""
  }
}

test "#2348 merge: a WAT callee is renamed together with its definition" {
  // A private inline-wasm helper gets a namespaced name when its file is
  // merged. The `$helper` token lives inside an EString, so the generic
  // rewrite could not see it and the caller was left naming a fn that no
  // longer existed -- a program whose per-file `vibe check` is clean.
  let stmts = parse_program(lex("fn helper(a: Int, b: Int) -> Int = wasm\"(i64.sub (local.get $a) (local.get $b))\"\nexport fn caller(a: Int) -> Int = wasm\"(call $helper (local.get $a) (i64.const 8))\"\n"))
  let renamed = namespace_private_value_stmts("dep.vibe", stmts)
  let helper_name = iw_stmt_binding_name(Array::get(renamed, 0))
  // The definition really was renamed; without this the assertion below
  // would hold vacuously on a build where nothing is namespaced at all.
  assert(helper_name != "helper")
  assert(String::length(helper_name) > 6)
  let printed = print_program(renamed)
  // The callee token now names exactly the renamed definition ...
  assert(String::contains(printed, String::concat("call $", helper_name)))
  // ... and no longer the original spelling. The trailing space matters:
  // `call $helper` is a prefix of `call $helper_dep_vibe`.
  assert(!String::contains(printed, "call $helper "))
}

test "#2348 merge: a local spelled like a private fn is left alone" {
  // The rewrite keys on the `call` keyword, not on `$name` anywhere, so a
  // local or label that happens to share a renamed fn's name keeps its
  // spelling -- renaming it would silently change which slot the body reads.
  let stmts = parse_program(lex("fn helper(a: Int, b: Int) -> Int = wasm\"(i64.sub (local.get $a) (local.get $b))\"\nexport fn caller(a: Int) -> Int = wasm\"(i64.add (local.get $helper) (i64.const 8))\"\n"))
  let renamed = namespace_private_value_stmts("dep.vibe", stmts)
  assert(iw_stmt_binding_name(Array::get(renamed, 0)) != "helper")
  let printed = print_program(renamed)
  assert(String::contains(printed, "local.get $helper)"))
}

test "#2348 merge: a parameter named like the callee does not block the rename" {
  // The enclosing EFn removes its parameter names from the alias map before
  // the body is rewritten. A WAT `$name` callee is a wasm FUNCTION name, a
  // namespace of its own, so it must not inherit that shadowing -- it did,
  // and the caller was left naming a definition the merge had renamed.
  let renamed = namespace_private_value_stmts("dep.vibe", parse_program(lex("fn helper(a: Int, b: Int) -> Int = wasm\"(i64.sub (local.get $a) (local.get $b))\"\nexport fn caller(helper: Int) -> Int = wasm\"(call $helper (local.get $helper) (i64.const 8))\"\n")))
  assert(iw_stmt_binding_name(Array::get(renamed, 0)) != "helper")
  let printed = print_program(renamed)
  assert(!String::contains(printed, "call $helper "))
  // ... while the parameter read keeps its own spelling.
  assert(String::contains(printed, "local.get $helper)"))
}
