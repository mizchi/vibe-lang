  inspect(Array::get(renames, 2).0, "Api::B")
  inspect(Array::get(renames, 2).1, namespace_private_name("/virtual/provider.vibe", "B"))
}

//# #2348: a WAT body's `call $name` survives the merge rename

/// The name a top-level value statement binds, however it is spelled.
fn iw_stmt_binding_name(stmt: Stmt) -> String {
  match stmt {
    SFnDecl(_, name, _, _, _) => name,
    SLet(_, _, name, _, _) => name,
    _ => ""
  }
}

test "#2348 merge: a WAT callee is renamed together with its definition" {
  // A private inline-wasm helper gets a namespaced name when its file is
  // merged. The `$helper` token lives inside an EString, so the generic
  // rewrite could not see it and the caller was left naming a fn that no
  // longer existed -- a program whose per-file `vibe check` is clean.
  let stmts = parse_program(lex("fn helper(a: Int, b: Int) -> Int = wasm\"(i64.sub (local.get $a) (local.get $b))\"\nexport fn caller(a: Int) -> Int = wasm\"(call $helper (local.get $a) (i64.const 8))\"\n"))
  let renamed = namespace_private_value_stmts("dep.vibe", stmts)
  let helper_name = iw_stmt_binding_name(Array::get(renamed, 0))
  // The definition really was renamed; without this the assertion below
  // would hold vacuously on a build where nothing is namespaced at all.
  assert(helper_name != "helper")
  assert(String::length(helper_name) > 6)
  let printed = print_program(renamed)
  // The callee token now names exactly the renamed definition ...
  assert(String::contains(printed, String::concat("call $", helper_name)))
  // ... and no longer the original spelling. The trailing space matters:
  // `call $helper` is a prefix of `call $helper_dep_vibe`.
  assert(!String::contains(printed, "call $helper "))
}

test "a dependency-private qualified pattern tracks its renamed constructor" {
  let source = "enum Hidden { A; B }\nexport fn selected(x: Hidden) -> Int { match x { Hidden::A => 1, Hidden::B => 2 } }"
  let renamed = namespace_private_value_stmts("dep.vibe", parse_program(lex(source)))
  let mut enum_name = ""
  let mut ctor_name = ""
  let mut ref_qualifier = ""
  let mut ref_variant = ""
  for stmt in renamed {
    match stmt {
      SEnum(_, name, _, ctors, _) => {
        enum_name = name
        let (name, _) = Array::get(ctors, 0)
        ctor_name = name
      },
      SQualifiedPatternRefs(rows) => {
        let (qualifier, variant) = Array::get(rows, 0)
        ref_qualifier = qualifier
        ref_variant = variant
      },
      _ => ()
    }
  }
  assert(enum_name != "" && enum_name != "Hidden")
  assert(ctor_name != "" && ctor_name != "A")
  assert_eq(ref_qualifier, enum_name)
  assert_eq(ref_variant, ctor_name)
}

test "a local alias of a public enum keeps its public constructor spelling" {
  let source = "export enum Public { A }\nenum Hidden { A }\ntype Local = Public\nexport fn selected(x: Local) -> Int { match x { Local::A => 1 } }"
  let renamed = namespace_private_value_stmts("dep.vibe", parse_program(lex(source)))
  let mut ref_variant = ""
  for stmt in renamed {
    match stmt {
      SQualifiedPatternRefs(rows) => {
        let (_, variant) = Array::get(rows, 0)
        ref_variant = variant
      },
      _ => ()
    }
  }
  assert_eq(ref_variant, "A")
}

test "#2348 merge: a local spelled like a private fn is left alone" {
  // The rewrite keys on the `call` keyword, not on `$name` anywhere, so a
  // local or label that happens to share a renamed fn's name keeps its
  // spelling -- renaming it would silently change which slot the body reads.
  let stmts = parse_program(lex("fn helper(a: Int, b: Int) -> Int = wasm\"(i64.sub (local.get $a) (local.get $b))\"\nexport fn caller(a: Int) -> Int = wasm\"(i64.add (local.get $helper) (i64.const 8))\"\n"))
  let renamed = namespace_private_value_stmts("dep.vibe", stmts)
  assert(iw_stmt_binding_name(Array::get(renamed, 0)) != "helper")
  let printed = print_program(renamed)
  assert(String::contains(printed, "local.get $helper)"))
}

test "#2348 merge: a parameter named like the callee does not block the rename" {
  // The enclosing EFn removes its parameter names from the alias map before
  // the body is rewritten. A WAT `$name` callee is a wasm FUNCTION name, a
  // namespace of its own, so it must not inherit that shadowing -- it did,
  // and the caller was left naming a definition the merge had renamed.
  let renamed = namespace_private_value_stmts("dep.vibe", parse_program(lex("fn helper(a: Int, b: Int) -> Int = wasm\"(i64.sub (local.get $a) (local.get $b))\"\nexport fn caller(helper: Int) -> Int = wasm\"(call $helper (local.get $helper) (i64.const 8))\"\n")))
  assert(iw_stmt_binding_name(Array::get(renamed, 0)) != "helper")
  let printed = print_program(renamed)
  assert(!String::contains(printed, "call $helper "))
  // ... while the parameter read keeps its own spelling.
  assert(String::contains(printed, "local.get $helper)"))
}

fn plan_refusal(paths: Array[String], stmts_list: Array[Array[Stmt]], entry: String, entry_stmts: Array[Stmt]) -> String {
  handle {
    let plan = build_export_rename_plan(paths, stmts_list, entry)
    let _ = collect_import_value_renames(plan, entry, entry_stmts)
    "clean"
  } with { Exception::Throw(msg) => msg }
}

test "#3445: an import through a facade follows the later of two re-exports" {
  let a = parse_program(lex("export fn f(x: Int) -> Int { x }"))
  let b = parse_program(lex("export fn foo(x: Option[Int]) -> Int { 0 }"))
  let facade = parse_program(lex("export ./a.vibe { f as foo }\nexport ./b.vibe { foo }"))
  let entry = parse_program(lex("import ./facade.vibe { foo }\nlet answer = foo(None)"))
  let paths = [
    "/virtual/a.vibe",
    "/virtual/b.vibe",
    "/virtual/facade.vibe",
    "/virtual/entry.vibe"
  ]
  let plan = build_export_rename_plan(paths, [a, b, facade, entry], "/virtual/entry.vibe")
  let renames = collect_import_value_renames(plan, "/virtual/entry.vibe", entry)
  inspect(Array::length(renames), "1")
  let b_foo = Array::get(export_plan_renames_for(plan, "/virtual/b.vibe"), 0).1
  inspect(Array::get(renames, 0).1 == b_foo, "true")
}

test "#3448: two modules exporting a struct of one name are refused with the rename" {
  let depa = parse_program(lex("export struct Box { n: Int }\nfn Box::plain(x: Int) -> Box { Box::{ n: x } }"))
  let depb = parse_program(lex("export struct Box { m: Int }\nfn Box::plain(x: Int) -> Box { Box::{ m: x * 100 } }"))
  let entry = parse_program(lex("import ./depa.vibe { Box as A }\nimport ./depb.vibe { Box }\nlet answer = Box::plain(3).m"))
  let paths = [
    "/virtual/depa.vibe",
    "/virtual/depb.vibe",
    "/virtual/entry.vibe"
  ]
  let msg = plan_refusal(paths, [depa, depb, entry], "/virtual/entry.vibe", entry)
  inspect(String::starts_with(msg, "rename one of the structs named `Box`: `/virtual/depa.vibe` and `/virtual/depb.vibe` both declare it"), "true")
}

test "#3448: the entry's own type is its own and is not judged here" {
  // #3343: a program's own type is its own; a clash the entry sees through an
  // import is the checker's to refuse (#3035).
  let dep = parse_program(lex("export enum Hue {\n  Red;\n  Blue\n}\nexport fn red() -> Int {\n  1\n}"))
  let entry = parse_program(lex("import ./dep.vibe { red }\nenum Hue {\n  Green\n}\nlet answer = red()"))
  let paths = ["/virtual/dep.vibe", "/virtual/entry.vibe"]
  inspect(plan_refusal(paths, [dep, entry], "/virtual/entry.vibe", entry), "clean")
}

test "#3448: two dependencies publishing one definition are one type (#3036)" {
  let a = parse_program(lex("export struct Box[T] {\n  value: T\n}\nexport fn box_of(n: Int) -> Box[Int] {\n  Box::{ value: n }\n}"))
  let b = parse_program(lex("export struct Box[U] {\n  value: U\n}\nexport fn unbox(b: Box[Int]) -> Int {\n  b.value\n}"))
  let entry = parse_program(lex("import ./a.vibe { box_of }\nimport ./b.vibe { unbox }\nlet answer = unbox(box_of(1))"))
  let paths = ["/virtual/a.vibe", "/virtual/b.vibe", "/virtual/entry.vibe"]
  inspect(plan_refusal(paths, [a, b, entry], "/virtual/entry.vibe", entry), "clean")
  let ja = parse_program(lex("export struct Job {\n  run: () -> Unit with Fs + Env\n}\nexport fn ta(j: Job) -> Int {\n  1\n}"))
  let jb = parse_program(lex("export struct Job {\n  run: () -> Unit with Env + Fs + Env\n}\nexport fn tb(j: Job) -> Int {\n  1\n}"))
  let jentry = parse_program(lex("import ./a.vibe { ta }\nimport ./b.vibe { tb }\nlet answer = 1"))
  inspect(plan_refusal(paths, [ja, jb, jentry], "/virtual/entry.vibe", jentry), "clean")
  // A field spelled through the module's own transparent alias is that type
  // (Codex on #3467).
  let na = parse_program(lex("type N = Int\nexport struct Box[T] {\n  value: N\n}\nexport fn box_of(n: Int) -> Box[Int] {\n  Box::{ value: n }\n}"))
  let nb = parse_program(lex("type Ints[X] = Array[X]\nexport struct Box[U] {\n  value: Int\n}\nexport fn unbox(b: Box[Int]) -> Int {\n  b.value\n}"))
  inspect(plan_refusal(paths, [na, nb, entry], "/virtual/entry.vibe", entry), "clean")
  // So is one spelled through an alias the module imports (Codex on #3467).
  let shared = parse_program(lex("export type N = Int"))
  let ia = parse_program(lex("import ./aliases.vibe { N }\nexport struct Box[T] {\n  value: N\n}\nexport fn box_of(n: Int) -> Box[Int] {\n  Box::{ value: n }\n}"))
  let ipaths = [
    "/virtual/aliases.vibe",
    "/virtual/a.vibe",
    "/virtual/b.vibe",
    "/virtual/entry.vibe"
  ]
  inspect(plan_refusal(ipaths, [shared, ia, nb, entry], "/virtual/entry.vibe", entry), "clean")
  // An alias published through an export list is read the same way (Codex
  // on #3467).
  let listed = parse_program(lex("type N = Int\nexport { N }"))
  inspect(plan_refusal(ipaths, [listed, ia, nb, entry], "/virtual/entry.vibe", entry), "clean")
  // And through a facade that only re-exports it (Codex on #3467).
  let facade = parse_program(lex("export ./aliases.vibe { N }"))
  let via_facade = parse_program(lex("import ./facade.vibe { N }\nexport struct Box[T] {\n  value: N\n}\nexport fn box_of(n: Int) -> Box[Int] {\n  Box::{ value: n }\n}"))
  let fpaths = [
    "/virtual/aliases.vibe",
    "/virtual/facade.vibe",
    "/virtual/a.vibe",
    "/virtual/b.vibe",
    "/virtual/entry.vibe"
  ]
  inspect(plan_refusal(fpaths, [shared, facade, via_facade, nb, entry], "/virtual/entry.vibe", entry), "clean")
  // The two-step form re-exports it as well (Codex on #3467).
  let listed_facade = parse_program(lex("import ./aliases.vibe { N }\nexport { N }"))
  inspect(plan_refusal(fpaths, [shared, listed_facade, via_facade, nb, entry], "/virtual/entry.vibe", entry), "clean")
  // A file that does not import the alias reads its own `N`, a struct, so
  // the types stay apart (Codex on #3467).
  let own_n = parse_program(lex("struct N {\n  v: String\n}\nexport struct Box[T] {\n  value: N\n}\nexport fn box_of(n: Int) -> Box[Int] {\n  Box::{ value: N::{ v: \"\" } }\n}"))
  inspect(String::starts_with(plan_refusal(ipaths, [shared, own_n, nb, entry], "/virtual/entry.vibe", entry), "rename one of the structs named `Box`"), "true")
  // An alias read through its provider's own private alias is the same
  // type (Codex on #3467).
  let layered = parse_program(lex("type Hidden = Int\nexport type N = Hidden"))
  inspect(plan_refusal(ipaths, [layered, ia, nb, entry], "/virtual/entry.vibe", entry), "clean")
  // So is one spelled through an alias its provider imports.
  let base_alias = parse_program(lex("export type N = Int"))
  let relay_alias = parse_program(lex("import ./base.vibe { N }\nexport type M = N"))
  let im = parse_program(lex("import ./aliases.vibe { M }\nexport struct Box[T] {\n  value: M\n}\nexport fn box_of(n: Int) -> Box[Int] {\n  Box::{ value: n }\n}"))
  let rpaths = [
    "/virtual/base.vibe",
    "/virtual/aliases.vibe",
    "/virtual/a.vibe",
    "/virtual/b.vibe",
    "/virtual/entry.vibe"
  ]
  inspect(plan_refusal(rpaths, [base_alias, relay_alias, im, nb, entry], "/virtual/entry.vibe", entry), "clean")
  // And through a chain of such imports, however many deep (Codex on #3467).
  let relay2_alias = parse_program(lex("import ./aliases.vibe { M }\nexport type K = M"))
  let ik = parse_program(lex("import ./aliases2.vibe { K }\nexport struct Box[T] {\n  value: K\n}\nexport fn box_of(n: Int) -> Box[Int] {\n  Box::{ value: n }\n}"))
  let kpaths = [
    "/virtual/base.vibe",
    "/virtual/aliases.vibe",
    "/virtual/aliases2.vibe",
    "/virtual/a.vibe",
    "/virtual/b.vibe",
    "/virtual/entry.vibe"
  ]
  inspect(plan_refusal(kpaths, [
    base_alias,
    relay_alias,
    relay2_alias,
    ik,
    nb,
    entry
  ], "/virtual/entry.vibe", entry), "clean")
  // An `N` imported from another module is that module's, not the alias of
  // the same name (Codex on #3467).
  let nominal = parse_program(lex("export struct N {\n  v: String\n}"))
  let other_import = parse_program(lex("import ./nominal.vibe { N }\nexport struct Box[T] {\n  value: N\n}\nexport fn box_of(n: Int) -> Box[Int] {\n  Box::{ value: N::{ v: \"\" } }\n}"))
  let npaths = [
    "/virtual/aliases.vibe",
    "/virtual/nominal.vibe",
    "/virtual/a.vibe",
    "/virtual/b.vibe",
    "/virtual/entry.vibe"
  ]
  inspect(String::starts_with(plan_refusal(npaths, [
    shared,
    nominal,
    other_import,
    nb,
    entry
  ], "/virtual/entry.vibe", entry), "rename one of the structs named `Box`"), "true")
  // Another file exporting an `N` of its own does not change which one the
  // import reads: aliases are keyed by provider (Codex on #3467).
  let other_n = parse_program(lex("export type N = String"))
  let apaths = [
    "/virtual/aliases.vibe",
    "/virtual/aliases2.vibe",
    "/virtual/a.vibe",
    "/virtual/b.vibe",
    "/virtual/entry.vibe"
  ]
  inspect(plan_refusal(apaths, [shared, other_n, ia, nb, entry], "/virtual/entry.vibe", entry), "clean")
  // Imported from the provider whose `N` is `String`, it is another type.
  let ia2 = parse_program(lex("import ./aliases2.vibe { N }\nexport struct Box[T] {\n  value: N\n}\nexport fn box_of(n: Int) -> Box[Int] {\n  Box::{ value: \"\" }\n}"))
  inspect(String::starts_with(plan_refusal(apaths, [
    shared,
    other_n,
    ia2,
    nb,
    entry
  ], "/virtual/entry.vibe", entry), "rename one of the structs named `Box`"), "true")
  // A field of another type is another type.
  let c = parse_program(lex("export struct Box[U] {\n  value: Option[U]\n}\nexport fn unbox(b: Box[Int]) -> Int {\n  0\n}"))
  inspect(String::starts_with(plan_refusal(paths, [a, c, entry], "/virtual/entry.vibe", entry), "rename one of the structs named `Box`"), "true")
}

test "#3448: a private type of the same name in a dependency is not a collision" {
  let depa = parse_program(lex("struct Box { n: Int }\nexport fn make() -> Int { Box::{ n: 1 }.n }"))
  let depb = parse_program(lex("export struct Box { m: Int }"))
  let entry = parse_program(lex("import ./depa.vibe { make }\nimport ./depb.vibe { Box }\nlet answer = make()"))
  let paths = [
    "/virtual/depa.vibe",
    "/virtual/depb.vibe",
    "/virtual/entry.vibe"
  ]
  inspect(plan_refusal(paths, [depa, depb, entry], "/virtual/entry.vibe", entry), "clean")
}

test "#3448: a package member the program never reaches does not collide" {
  // As `import @vibe/core { str_lt }` merges every member of the package, the
  // facade's other member is in the program without being used.
  let used = parse_program(lex("export fn str_lt(a: Int, b: Int) -> Bool {\n  a < b\n}"))
  let unused = parse_program(lex("export enum Attempt {\n  Good;\n  Bad\n}\nexport fn attempt_good() -> Attempt {\n  Good\n}"))
  let facade = parse_program(lex("export ./used.vibe { str_lt }\nexport ./unused.vibe { Attempt, attempt_good }"))
  let other = parse_program(lex("export enum Attempt {\n  Mine\n}\nexport fn mine() -> Int {\n  1\n}"))
  let entry = parse_program(lex("import ./facade.vibe { str_lt }\nimport ./other.vibe { mine }\nlet answer = str_lt(1, mine())"))
  let paths = [
    "/virtual/used.vibe",
    "/virtual/unused.vibe",
    "/virtual/facade.vibe",
    "/virtual/other.vibe",
    "/virtual/entry.vibe"
  ]
  inspect(plan_refusal(paths, [used, unused, facade, other, entry], "/virtual/entry.vibe", entry), "clean")
  // Importing the member's function through the facade reaches it, and then
  // its `Attempt` and the other module's are two types in one program.
  let entry2 = parse_program(lex("import ./facade.vibe { attempt_good }\nimport ./other.vibe { mine }\nlet answer = mine()"))
  let msg = plan_refusal(paths, [used, unused, facade, other, entry2], "/virtual/entry.vibe", entry2)
  inspect(String::starts_with(msg, "rename one of the enums named `Attempt`"), "true")
}

test "#3448: a file reached through a facade's own re-export collides" {
  // Codex on #3467: `wrapper` calls `f`, which the facade binds by
  // re-exporting it, so `p.vibe` is in the program and its `Box` meets the
  // other module's.
  let p = parse_program(lex("export struct Box {\n  value: Int\n}\nexport fn f() -> Int {\n  1\n}"))
  let facade = parse_program(lex("export ./p.vibe { f }\nexport fn wrapper() -> Int {\n  f()\n}"))
  let other = parse_program(lex("export struct Box {\n  value: String\n}\nexport fn mine() -> Int {\n  1\n}"))
  let entry = parse_program(lex("import ./facade.vibe { wrapper }\nimport ./other.vibe { mine }\nlet answer = wrapper() + mine()"))
  let paths = [
    "/virtual/p.vibe",
    "/virtual/facade.vibe",
    "/virtual/other.vibe",
    "/virtual/entry.vibe"
  ]
  inspect(String::starts_with(plan_refusal(paths, [p, facade, other, entry], "/virtual/entry.vibe", entry), "rename one of the structs named `Box`"), "true")
  // A re-export the facade's own code never names reaches nothing (the #3036
  // control `dup_type_formal_marker_ok`).
  let pass_on = parse_program(lex("export ./p.vibe { Box }\nexport fn wrapper() -> Int {\n  1\n}"))
  inspect(plan_refusal(paths, [p, pass_on, other, entry], "/virtual/entry.vibe", entry), "clean")
}

test "#3448: an alias's constructor parameter in head position takes its argument" {
  // Codex on #3467: `Apply[Option, Int]` and `Apply[Array, Int]` both read as
  // `F[Int]`, and the two `Box` were taken for one type.
  let a = parse_program(lex("type Apply[F[_], A] = F[A]\nexport struct Box {\n  value: Apply[Option, Int]\n}\nexport fn box_a() -> Int {\n  1\n}"))
  let b = parse_program(lex("type Apply[F[_], A] = F[A]\nexport struct Box {\n  value: Apply[Array, Int]\n}\nexport fn box_b() -> Int {\n  1\n}"))
  let same = parse_program(lex("type Apply[F[_], A] = F[A]\nexport struct Box {\n  value: Option[Int]\n}\nexport fn box_b() -> Int {\n  1\n}"))
  let entry = parse_program(lex("import ./a.vibe { box_a }\nimport ./b.vibe { box_b }\nlet answer = box_a() + box_b()"))
  let paths = ["/virtual/a.vibe", "/virtual/b.vibe", "/virtual/entry.vibe"]
  inspect(String::starts_with(plan_refusal(paths, [a, b, entry], "/virtual/entry.vibe", entry), "rename one of the structs named `Box`"), "true")
  inspect(plan_refusal(paths, [a, same, entry], "/virtual/entry.vibe", entry), "clean")
}

test "#3448: a provider's own alias does not capture a kinded formal of the same name" {
  // Codex on #3467: `F` of `Apply[F[_], A]` was read as the provider's
  // `type F[T] = Option[T]`, so `Apply[Array, Int]` became `Option[Int]`.
  let provider = parse_program(lex("type F[T] = Option[T]\nexport type Apply[F[_], A] = F[A]"))
  let a = parse_program(lex("import ./aliases.vibe { Apply }\nexport struct Box {\n  value: Apply[Array, Int]\n}\nexport fn box_a() -> Int {\n  1\n}"))
  let b = parse_program(lex("export struct Box {\n  value: Option[Int]\n}\nexport fn box_b() -> Int {\n  1\n}"))
  let entry = parse_program(lex("import ./a.vibe { box_a }\nimport ./b.vibe { box_b }\nlet answer = box_a() + box_b()"))
  let paths = [
    "/virtual/aliases.vibe",
    "/virtual/a.vibe",
    "/virtual/b.vibe",
    "/virtual/entry.vibe"
  ]
  inspect(String::starts_with(plan_refusal(paths, [provider, a, b, entry], "/virtual/entry.vibe", entry), "rename one of the structs named `Box`"), "true")
}

test "#3448: a facade re-exporting one alias name twice provides the later one" {
  // Codex on #3467: both rows were kept and the first was read.
  let ai = parse_program(lex("export type N = Int"))
  let astr = parse_program(lex("export type N = String"))
  let facade = parse_program(lex("export ./ai.vibe { N }\nexport ./astr.vibe { N }"))
  let a = parse_program(lex("import ./facade.vibe { N }\nexport struct Box {\n  value: N\n}\nexport fn box_a() -> Int {\n  1\n}"))
  let b = parse_program(lex("export struct Box {\n  value: Int\n}\nexport fn box_b() -> Int {\n  1\n}"))
  let entry = parse_program(lex("import ./a.vibe { box_a }\nimport ./b.vibe { box_b }\nlet answer = box_a() + box_b()"))
  let paths = [
    "/virtual/ai.vibe",
    "/virtual/astr.vibe",
    "/virtual/facade.vibe",
    "/virtual/a.vibe",
    "/virtual/b.vibe",
    "/virtual/entry.vibe"
  ]
  inspect(String::starts_with(plan_refusal(paths, [
    ai,
    astr,
    facade,
    a,
    b,
    entry
  ], "/virtual/entry.vibe", entry), "rename one of the structs named `Box`"), "true")
}

test "#3448: a file's own applied alias wins over an imported one of its name" {
  // Codex on #3467: the imported `N[T] = String` was read for the local
  // `N[T] = Option[T]`.
  let provider = parse_program(lex("export type N[T] = String"))
  let a = parse_program(lex("import ./aliases.vibe { N }\ntype N[T] = Option[T]\nexport struct Box {\n  value: N[Int]\n}\nexport fn box_a() -> Int {\n  1\n}"))
  let b = parse_program(lex("export struct Box {\n  value: String\n}\nexport fn box_b() -> Int {\n  1\n}"))
  let entry = parse_program(lex("import ./a.vibe { box_a }\nimport ./b.vibe { box_b }\nlet answer = box_a() + box_b()"))
  let paths = [
    "/virtual/aliases.vibe",
    "/virtual/a.vibe",
    "/virtual/b.vibe",
    "/virtual/entry.vibe"
  ]
  inspect(String::starts_with(plan_refusal(paths, [provider, a, b, entry], "/virtual/entry.vibe", entry), "rename one of the structs named `Box`"), "true")
}

test "#3489: a row spelled through an effectset is the row of its members" {
  let a = parse_program(lex("effect Ask {\n  Get() -> Int\n}\neffectset All = { Ask }\nexport struct Job {\n  run: () -> Int with All\n}\nexport fn ja() -> Int {\n  1\n}"))
  let b = parse_program(lex("effect Ask {\n  Get() -> Int\n}\nexport struct Job {\n  run: () -> Int with Ask\n}\nexport fn jb() -> Int {\n  1\n}"))
  let entry = parse_program(lex("import ./a.vibe { ja }\nimport ./b.vibe { jb }\nlet answer = ja() + jb()"))
  let paths = ["/virtual/a.vibe", "/virtual/b.vibe", "/virtual/entry.vibe"]
  inspect(plan_refusal(paths, [a, b, entry], "/virtual/entry.vibe", entry), "clean")
  // Imported from the module that declares it.
  let sets = parse_program(lex("effect Ask {\n  Get() -> Int\n}\nexport effectset All = { Ask }"))
  let ia = parse_program(lex("import ./sets.vibe { All }\nexport struct Job {\n  run: () -> Int with All\n}\nexport fn ja() -> Int {\n  1\n}"))
  let ipaths = [
    "/virtual/sets.vibe",
    "/virtual/a.vibe",
    "/virtual/b.vibe",
    "/virtual/entry.vibe"
  ]
  inspect(plan_refusal(ipaths, [sets, ia, b, entry], "/virtual/entry.vibe", entry), "clean")
  // A set with another member is another row.
  let wide = parse_program(lex("effect Ask {\n  Get() -> Int\n}\neffect Tell {\n  Put(Int) -> Unit\n}\neffectset All = { Ask, Tell }\nexport struct Job {\n  run: () -> Int with All\n}\nexport fn ja() -> Int {\n  1\n}"))
  inspect(String::starts_with(plan_refusal(paths, [wide, b, entry], "/virtual/entry.vibe", entry), "rename one of the structs named `Job`"), "true")
}

test "#3448: a re-export a facade names only in a type reaches its provider" {
  // Codex on #3467: `read`'s parameter is the only place `Box` is spelled,
  // so a walk of expressions alone missed `p.vibe`.
  let p = parse_program(lex("export struct Box {\n  value: Int\n}"))
  let facade = parse_program(lex("export ./p.vibe { Box }\nexport fn read(b: Box) -> Int {\n  b.value\n}"))
  let other = parse_program(lex("export struct Box {\n  value: String\n}\nexport fn mine() -> Int {\n  1\n}"))
  let entry = parse_program(lex("import ./facade.vibe { read }\nimport ./other.vibe { mine }\nlet answer = mine()"))
  let paths = [
    "/virtual/p.vibe",
    "/virtual/facade.vibe",
    "/virtual/other.vibe",
    "/virtual/entry.vibe"
  ]
  inspect(String::starts_with(plan_refusal(paths, [p, facade, other, entry], "/virtual/entry.vibe", entry), "rename one of the structs named `Box`"), "true")
  // A result type and a field each name it too.
  let by_result = parse_program(lex("export ./p.vibe { Box }\nexport fn make() -> Option[Box] {\n  None\n}"))
  inspect(String::starts_with(plan_refusal(paths, [p, by_result, other, entry], "/virtual/entry.vibe", entry), "rename one of the structs named `Box`"), "true")
  let by_field = parse_program(lex("export ./p.vibe { Box }\nexport struct Holder {\n  b: Box\n}\nexport fn read() -> Int {\n  1\n}"))
  inspect(String::starts_with(plan_refusal(paths, [p, by_field, other, entry], "/virtual/entry.vibe", entry), "rename one of the structs named `Box`"), "true")
  // A type parameter spelled `Box` is that parameter, not the re-export
  // (Codex on #3492).
  let by_param = parse_program(lex("export ./p.vibe { Box }\nexport fn read[Box](x: Box) -> Box {\n  x\n}"))
  inspect(plan_refusal(paths, [p, by_param, other, entry], "/virtual/entry.vibe", entry), "clean")
  let by_struct_param = parse_program(lex("export ./p.vibe { Box }\nexport struct Holder[Box] {\n  b: Box\n}\nexport fn read() -> Int {\n  1\n}"))
  inspect(plan_refusal(paths, [p, by_struct_param, other, entry], "/virtual/entry.vibe", entry), "clean")
  // A facade's own `Box` is its own (Codex on #3492): a recursive field
  // naming it does not reach the re-export.
  let own_box = parse_program(lex("export ./p.vibe { Box }\nstruct Box {\n  next: Option[Box]\n}\nexport fn read() -> Int {\n  1\n}"))
  inspect(plan_refusal(paths, [p, own_box, other, entry], "/virtual/entry.vibe", entry), "clean")
  // An operation named like the re-export (`with Console::Box`) is not it
  // (Codex on #3492).
  let by_op = parse_program(lex("export ./p.vibe { Box }\nexport fn read() -> Int with Console::Box {\n  1\n}"))
  inspect(plan_refusal(paths, [p, by_op, other, entry], "/virtual/entry.vibe", entry), "clean")
}

test "#3448: builtin spellings the checker resolves alike are one type" {
  // Codex on #3467: `()` and `Unit`, `i32` and `Int`, `f64` and `Double`.
  let a = parse_program(lex("export struct Box {\n  u: Unit;\n  n: i32;\n  d: f64\n}\nexport fn ja() -> Int {\n  1\n}"))
  let b = parse_program(lex("export struct Box {\n  u: ();\n  n: Int;\n  d: Double\n}\nexport fn jb() -> Int {\n  1\n}"))
  let entry = parse_program(lex("import ./a.vibe { ja }\nimport ./b.vibe { jb }\nlet answer = ja() + jb()"))
  let paths = ["/virtual/a.vibe", "/virtual/b.vibe", "/virtual/entry.vibe"]
  inspect(plan_refusal(paths, [a, b, entry], "/virtual/entry.vibe", entry), "clean")
  // A spelling the checker keeps apart stays apart.
  let c = parse_program(lex("export struct Box {\n  u: Unit;\n  n: i64;\n  d: Double\n}\nexport fn jb() -> Int {\n  1\n}"))
  inspect(String::starts_with(plan_refusal(paths, [a, c, entry], "/virtual/entry.vibe", entry), "rename one of the structs named `Box`"), "true")
}

test "#3489: an exported effectset over another is read in its provider" {
  // Codex on #3492: `All = { Base }` over a private `Base = { Ask }`.
  let sets = parse_program(lex("effect Ask {\n  Get() -> Int\n}\neffectset Base = { Ask }\nexport effectset All = { Base }"))
  let a = parse_program(lex("import ./sets.vibe { All }\nexport struct Job {\n  run: () -> Int with All\n}\nexport fn ja() -> Int {\n  1\n}"))
  let b = parse_program(lex("effect Ask {\n  Get() -> Int\n}\nexport struct Job {\n  run: () -> Int with Ask\n}\nexport fn jb() -> Int {\n  1\n}"))
  let entry = parse_program(lex("import ./a.vibe { ja }\nimport ./b.vibe { jb }\nlet answer = ja() + jb()"))
  let paths = [
    "/virtual/sets.vibe",
    "/virtual/a.vibe",
    "/virtual/b.vibe",
    "/virtual/entry.vibe"
  ]
  inspect(plan_refusal(paths, [sets, a, b, entry], "/virtual/entry.vibe", entry), "clean")
}

test "#3448: a re-export named only in a generic bound reaches its provider" {
  // Codex on #3492: `[T: Key]` names `Key`, so `k.vibe` is in the program and
  // its `Box` meets the other module's.
  let k = parse_program(lex("export trait Key {\n  key(Self) -> Int\n}\nexport struct Box {\n  value: Int\n}"))
  let facade = parse_program(lex("export ./k.vibe { Key }\nexport fn use_key[T: Key](x: T) -> Int {\n  1\n}"))
  let other = parse_program(lex("export struct Box {\n  value: String\n}\nexport fn mine() -> Int {\n  1\n}"))
  let entry = parse_program(lex("import ./facade.vibe { use_key }\nimport ./other.vibe { mine }\nlet answer = mine()"))
  let paths = [
    "/virtual/k.vibe",
    "/virtual/facade.vibe",
    "/virtual/other.vibe",
    "/virtual/entry.vibe"
  ]
  inspect(String::starts_with(plan_refusal(paths, [k, facade, other, entry], "/virtual/entry.vibe", entry), "rename one of the structs named `Box`"), "true")
}

test "#3448: builtin spellings inside a row compare alike" {
  // Codex on #3492: `Probe[i32]` and `Probe[Int]` are one row label.
  let a = parse_program(lex("effect Probe[T] {\n  Take() -> T\n}\nexport struct Job {\n  run: () -> Int with Probe[i32]\n}\nexport fn ja() -> Int {\n  1\n}"))
  let b = parse_program(lex("effect Probe[T] {\n  Take() -> T\n}\nexport struct Job {\n  run: () -> Int with Probe[Int]\n}\nexport fn jb() -> Int {\n  1\n}"))
  let entry = parse_program(lex("import ./a.vibe { ja }\nimport ./b.vibe { jb }\nlet answer = ja() + jb()"))
  let paths = ["/virtual/a.vibe", "/virtual/b.vibe", "/virtual/entry.vibe"]
  inspect(plan_refusal(paths, [a, b, entry], "/virtual/entry.vibe", entry), "clean")
}

test "#3448: declarations a facade reads its re-exports through (Codex on #3492)" {
  let p = parse_program(lex("export struct Box {\n  value: Int\n}\nexport fn make() -> Box {\n  Box::{ value: 1 }\n}"))
  let other = parse_program(lex("export struct Box {\n  value: String\n}\nexport fn mine() -> Int {\n  1\n}"))
  let entry = parse_program(lex("import ./facade.vibe { read }\nimport ./other.vibe { mine }\nlet answer = mine()"))
  let paths = [
    "/virtual/p.vibe",
    "/virtual/facade.vibe",
    "/virtual/other.vibe",
    "/virtual/entry.vibe"
  ]
  // A top-level destructuring `let` names its pattern's head.
  let by_let_pat = parse_program(lex("export ./p.vibe { Box, make }\nlet Box::{ value: x } = make()\nexport fn read() -> Int {\n  x\n}"))
  inspect(String::starts_with(plan_refusal(paths, [p, by_let_pat, other, entry], "/virtual/entry.vibe", entry), "rename one of the structs named `Box`"), "true")
  // A facade's own `Box` is the one its alias target names.
  let own_alias = parse_program(lex("export ./p.vibe { Box }\nstruct Box {\n  n: Int\n}\ntype Local = Box\nexport fn read() -> Int {\n  1\n}"))
  inspect(plan_refusal(paths, [p, own_alias, other, entry], "/virtual/entry.vibe", entry), "clean")
  // A trait parameter spelled `Box` is the parameter in its supertraits.
  let super_param = parse_program(lex("export ./p.vibe { Box }\ntrait Key[T] {\n  key(Self) -> Int\n}\ntrait Uses[Box]: Key[Box] {\n  uses(Self) -> Int\n}\nexport fn read() -> Int {\n  1\n}"))
  inspect(plan_refusal(paths, [p, super_param, other, entry], "/virtual/entry.vibe", entry), "clean")
}

test "#3489: an effectset a facade re-exports is read in the facade's own rows" {
  // Codex on #3492: `export ./sets.vibe { All }` beside `with All`.
  let sets = parse_program(lex("effect Ask {\n  Get() -> Int\n}\nexport effectset All = { Ask }"))
  let facade = parse_program(lex("export ./sets.vibe { All }\nexport struct Job {\n  run: () -> Int with All\n}\nexport fn ja() -> Int {\n  1\n}"))
  let b = parse_program(lex("effect Ask {\n  Get() -> Int\n}\nexport struct Job {\n  run: () -> Int with Ask\n}\nexport fn jb() -> Int {\n  1\n}"))
  let entry = parse_program(lex("import ./a.vibe { ja }\nimport ./b.vibe { jb }\nlet answer = ja() + jb()"))
  let paths = [
    "/virtual/sets.vibe",
    "/virtual/a.vibe",
    "/virtual/b.vibe",
    "/virtual/entry.vibe"
  ]
  inspect(plan_refusal(paths, [sets, facade, b, entry], "/virtual/entry.vibe", entry), "clean")
}
