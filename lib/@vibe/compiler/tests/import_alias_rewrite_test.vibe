  append_builtin_iterator_operation_markers,
  append_builtin_iterator_plan_operation_markers,
  append_import_alias_rewritten_non_import_stmts,
  append_import_alias_rewritten_non_import_stmts_with_renames,
  apply_export_renames_stmts,
  build_export_rename_plan,
  builtin_iterator_namespace_from_marker,
  builtin_iterator_namespace_markers,
  builtin_iterator_serialized_boundary,
  builtin_iterator_serialized_boundary_from_markers,
  builtin_iterator_serialized_boundary_markers,
  collect_export_def_value_names,
  collect_import_value_renames,
  export_plan_fingerprint_text,
  export_plan_renames_for,
  namespace_exported_name,
  namespace_private_name,
