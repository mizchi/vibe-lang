//# Imports

import @vibe/compiler/core {
  append_builtin_iterator_operation_markers,
  append_builtin_iterator_plan_operation_markers,
  append_import_alias_rewritten_non_import_stmts,
  append_import_alias_rewritten_non_import_stmts_with_renames,
  apply_export_renames_stmts,
  build_export_rename_plan,
  builtin_iterator_namespace_from_marker,
  builtin_iterator_namespace_markers,
  builtin_iterator_serialized_boundary,
  builtin_iterator_serialized_boundary_from_markers,
  builtin_iterator_serialized_boundary_markers,
  collect_export_def_value_names,
  collect_import_value_renames,
  export_plan_renames_for,
  namespace_exported_name,
  trait_import_local_operation_renames
}

import @vibe/ast {
  ImportKind, Stmt, TypeExpr, impl_method_binding_name
}

import @vibe/compiler/syntax {
  lex, parse_program, print_program
}

import @vibe/compiler/codegen {
  desugar_trait_dicts
}

//# Misc

test "standard Iterator provenance is scoped to its local import namespace" {
  let imported = parse_program(lex("import @vibe/builtin { trait Iterator }\nlet answer = Iterator::map([1], (x: Int) -> Int { x })"))
  match Array::get(imported, 0) {
    SImport(path, items) => {
      inspect(path, "@vibe/builtin")
      inspect(Array::get(items, 0).name, "Iterator")
      inspect(match Array::get(items, 0).kind {
        Some(ImportTrait) => "trait",
        Some(_) => "other",
        None => "none"
      }, "trait")
    },
    _ => inspect("not an import", "an import")
  }
  let imported_markers = builtin_iterator_namespace_markers(imported)
  inspect(Array::length(imported_markers), "1")
  inspect(builtin_iterator_namespace_from_marker(Array::get(imported_markers, 0)), "Some(Iterator)")
  let shadowed = parse_program(lex("import @vibe/builtin { trait Iterator }\nfn Iterator::map(xs: Array[Int], _f: (Int) -> Int) -> Array[Int] { xs }"))
  inspect(Array::length(builtin_iterator_namespace_markers(shadowed)), "0")
  let aliased = parse_program(lex("import @vibe/builtin { trait Iterator as Iter }\nlet answer = Iter::map([1], (x: Int) -> Int { x })"))
  let alias_markers = builtin_iterator_namespace_markers(aliased)
  inspect(builtin_iterator_namespace_from_marker(Array::get(alias_markers, 0)), "Some(Iter)")
  let alias_with_canonical_helper = parse_program(lex("import @vibe/builtin { trait Iterator as Iter }\nfn Iterator::map(xs: Array[Int], _f: (Int) -> Int) -> Array[Int] { [77] }"))
  inspect(Array::length(builtin_iterator_namespace_markers(alias_with_canonical_helper)), "1")
  let alias_with_local_helper = parse_program(lex("import @vibe/builtin { trait Iterator as Iter }\nfn Iter::map(xs: Array[Int], _f: (Int) -> Int) -> Array[Int] { [77] }"))
  inspect(Array::length(builtin_iterator_namespace_markers(alias_with_local_helper)), "0")
  let imported_local_helper = parse_program(lex("import @vibe/builtin { trait Iterator }\nimport ./custom.vibe { Iterator::map }\nlet answer = Iterator::map([1], (x: Int) -> Int { x })"))
  inspect(Array::length(builtin_iterator_namespace_markers(imported_local_helper)), "0")
  let reexported_local_helper = parse_program(lex("import @vibe/builtin { trait Iterator }\nexport ./custom.vibe { Iterator::map }\nlet answer = Iterator::map([1], (x: Int) -> Int { x })"))
  inspect(Array::length(builtin_iterator_namespace_markers(reexported_local_helper)), "0")
  let local_flatmap = parse_program(lex("import @vibe/builtin { trait Iterator }\nfn Iterator::flatmap(xs: Array[Int], _f: (Int) -> Array[Int]) -> Array[Int] { xs }"))
  inspect(Array::length(builtin_iterator_namespace_markers(local_flatmap)), "0")
  let replaced_trait = parse_program(lex("import @vibe/builtin { trait Iterator }\nimport ./custom.vibe { trait Iterator }\nlet answer = Iterator::map([1], (x: Int) -> Int { x })"))
  inspect(Array::length(builtin_iterator_namespace_markers(replaced_trait)), "0")
  let collision_renames = trait_import_local_operation_renames(alias_with_canonical_helper, "/virtual/main.vibe")
  inspect(Array::length(collision_renames), "1")
  let (source_name, private_name) = Array::get(collision_renames, 0)
  inspect(source_name, "Iterator::map")
  assert(private_name != source_name)
  assert(!String::starts_with(private_name, "Iterator::"))
  let collision_rewritten = print_program(apply_export_renames_stmts(alias_with_canonical_helper, collision_renames))
  assert(String::contains(collision_rewritten, String::concat(private_name, " =")))
}

test "Iterator provenance cache carrier roundtrips through source text" {
  let imported = parse_program(lex("import @vibe/builtin { trait Iterator as Iter }"))
  let serialized = print_program([
    builtin_iterator_serialized_boundary(imported)
  ])
  let reparsed = parse_program(lex(serialized))
  match builtin_iterator_serialized_boundary_markers(Array::get(reparsed, 0)) {
    Some(markers) => {
      inspect(Array::length(markers), "1")
      inspect(builtin_iterator_namespace_from_marker(Array::get(markers, 0)), "Some(Iter)")
    },
    None => assert(false)
  }
  let no_imports = parse_program(lex("let value = 1"))
  match builtin_iterator_serialized_boundary_markers(builtin_iterator_serialized_boundary(no_imports)) {
    Some(markers) => inspect(Array::length(markers), "0"),
    None => assert(false)
  }
  let reexported = parse_program(lex("export ./dep.vibe { assert_eq }"))
  let reexported_roundtrip = parse_program(lex(print_program([
    builtin_iterator_serialized_boundary(reexported)
  ])))
  match builtin_iterator_serialized_boundary_markers(Array::get(reexported_roundtrip, 0)) {
    Some(markers) => {
      inspect(Array::length(markers), "1")
      inspect(Array::get(markers, 0), "assert_eq")
    },
    None => assert(false)
  }
}

test "source merging preserves Iterator provenance cache carriers" {
  let imported = parse_program(lex("import @vibe/builtin { trait Iterator as Iter }"))
  let serialized = print_program([
    builtin_iterator_serialized_boundary(imported)
  ])
  let stmts = parse_program(lex(String::concat(serialized, "let answer = Iter::map([1], (x: Int) -> Int { x + 1 })")))
  let out = Array::slice(stmts, 0, 0)
  append_import_alias_rewritten_non_import_stmts(out, stmts)
  inspect(Array::length(out), "2")
  match builtin_iterator_serialized_boundary_markers(Array::get(out, 0)) {
    Some(markers) => {
      inspect(Array::length(markers), "1")
      inspect(builtin_iterator_namespace_from_marker(Array::get(markers, 0)), "Some(Iter)")
    },
    None => assert(false)
  }
  assert(String::contains(print_program(out), "answer = Iter::map"))
}

test "Iterator provenance cache carriers do not act as source imports" {
  let imported = parse_program(lex("import @vibe/builtin { trait Iterator as Iter }"))
  let serialized = print_program([
    builtin_iterator_serialized_boundary(imported)
  ])
  let stmts = parse_program(lex(String::concat(serialized, "fn Iterator::map(xs: Array[Int], _f: (Int) -> Int) -> Array[Int] { [77] }")))
  inspect(Array::length(trait_import_local_operation_renames(stmts, "/virtual/merged.vibe")), "0")
}

test "a materialized aliased trait operation keeps its local namespace" {
  let stmts = parse_program(lex("import @vibe/builtin { trait Iterator as Iter }\nfn Iter::map(xs: Array[Int], _f: (Int) -> Int) -> Array[Int] { xs }\nlet standard = Iter::map([1], (x: Int) -> Int { x })\nlet canonical = Iterator::map([1], (x: Int) -> Int { x })"))
  let out = Array::slice(stmts, 0, 0)
  append_import_alias_rewritten_non_import_stmts(out, stmts)
  let printed = print_program(out)
  assert(String::contains(printed, "standard = Iter::map"))
  assert(String::contains(printed, "canonical = Iterator::map"))
}

test "provider-local operation separation applies to every trait alias" {
  let source = parse_program(lex("import ./traits.vibe { trait Reducible as R }\nfn Reducible::reduce(xs: Array[Int]) -> Int { Array::length(xs) }\nfn R::reduce(xs: Array[Int]) -> Int { Array::length(xs) }"))
  let renames = trait_import_local_operation_renames(source, "/virtual/main.vibe")
  inspect(Array::length(renames), "1")
  let (original, private_name) = Array::get(renames, 0)
  inspect(original, "Reducible::reduce")
  assert(String::starts_with(private_name, "__local_trait_Reducible::reduce"))
}

test "Iterator intrinsic provenance does not cross into a renamed local namespace" {
  let source = parse_program(lex("import @vibe/builtin { trait Iterator as Iter }\nfn Iterator::map(xs: Array[Int], _f: (Int) -> Int) -> Array[Int] { [77] }\nlet local = Iterator::map([1, 2], (x: Int) -> Int { x + 1 })\nlet standard = Iter::map([1, 2], (x: Int) -> Int { x + 1 })"))
  let renamed = apply_export_renames_stmts(source, trait_import_local_operation_renames(source, "/virtual/main.vibe"))
  inspect(handle {
    desugar_trait_dicts(renamed)
    "ok"
  } with { Exception::Throw(msg) => msg }, "ok")
  let printed = print_program(renamed)
  inspect(String::contains(printed, "local = __local_trait_Iterator::map_exp__virtual_main_vibe"), "true")
  inspect(String::contains(printed, "standard = Array::map"), "true")
}

test "trait imports resolve provider operations to unique flattened names" {
  let provider = parse_program(lex("export trait Iterator[T]\nexport fn Iterator::map[T, C: Iterator[T]](xs: C, f: (T) -> T) -> Array[T] { [f(C::iter_get(xs, 0))] }"))
  assert(Array::length(collect_export_def_value_names(provider)) == 1)
  let entry = parse_program(lex("import ./provider.vibe { trait Iterator as Iter }\nexport fn Iterator::map(xs: Array[Int], _f: (Int) -> Int) -> Array[Int] { [77] }\nlet standard = Iter::map([1], (x: Int) -> Int { x })\nlet local = Iterator::map([1], (x: Int) -> Int { x })"))
  let plan = build_export_rename_plan(["provider.vibe", "main.vibe"], [
    provider,
    entry
  ], "main.vibe")
  let provider_renames = export_plan_renames_for(plan, "provider.vibe")
  inspect(Array::length(provider_renames), "1")
  let (provider_name, provider_unique) = Array::get(provider_renames, 0)
  inspect(provider_name, "Iterator::map")
  assert(provider_unique != provider_name)
  let imported = collect_import_value_renames(plan, "main.vibe", entry)
  inspect(Array::length(imported), "1")
  inspect(Array::get(imported, 0).0, "Iter::map")
  inspect(Array::get(imported, 0).1, provider_unique)
  let standard_import = parse_program(lex("import @vibe/builtin { trait Iterator as Iter }"))
  let markers = builtin_iterator_namespace_markers(standard_import)
  append_builtin_iterator_operation_markers(markers, [
    ("Iter::map", provider_unique)
  ])
  inspect(Array::length(markers), "2")
  inspect(builtin_iterator_namespace_from_marker(Array::get(markers, 1)), String::concat("Some(", String::concat(String::substring(provider_unique, 0, String::index_of(provider_unique, "::")), ")")))
  let serialized = print_program([
    builtin_iterator_serialized_boundary_from_markers(markers)
  ])
  let optimized = parse_program(lex(String::concat(serialized, String::concat("let answer = ", String::concat(provider_unique, "(loop (i = 0) { let xs = [i]; break xs }, (x: Int) -> Int { x + 1 })")))))
  desugar_trait_dicts(optimized)
  assert(String::contains(print_program(optimized), "answer = Array::map"))
}

test "provider operation projection is trait-generic" {
  let provider = parse_program(lex("export trait Reducible[T]\nexport fn Reducible::reduce[T, C: Reducible[T]](_xs: C) -> Int { 1 }"))
  let entry = parse_program(lex("import ./provider.vibe { trait Reducible as R }\nlet answer = R::reduce([1])"))
  let plan = build_export_rename_plan(["provider.vibe", "main.vibe"], [
    provider,
    entry
  ], "main.vibe")
  let imported = collect_import_value_renames(plan, "main.vibe", entry)
  inspect(Array::length(imported), "1")
  inspect(Array::get(imported, 0).0, "R::reduce")
  assert(String::ends_with(Array::get(imported, 0).1, "::reduce"))
}

test "trait companion projection follows facade re-exports" {
  let provider_path = "/virtual/provider.vibe"
  let facade_path = "/virtual/facade.vibe"
  let entry_path = "/virtual/main.vibe"
  let provider = parse_program(lex("export trait Reducible[T]\nexport fn Reducible::reduce[T, C: Reducible[T]](_xs: C) -> Int { 41 }"))
  let facade = parse_program(lex("export ./provider.vibe { trait Reducible }"))
  let entry = parse_program(lex("import ./facade.vibe { trait Reducible as R }\nlet answer = R::reduce([1])"))
  let plan = build_export_rename_plan([provider_path, facade_path, entry_path], [
    provider,
    facade,
    entry
  ], entry_path)
  let imported = collect_import_value_renames(plan, entry_path, entry)
  inspect(Array::length(imported), "1")
  inspect(Array::get(imported, 0).0, "R::reduce")
  assert(String::ends_with(Array::get(imported, 0).1, "::reduce"))
}

test "#2379 review: builtin Iterator companion projection follows an export facade" {
  let builtin_path = "lib/@vibe/builtin/index.vpkg"
  let facade_path = "facade.vibe"
  let entry_path = "main.vibe"
  let builtin = parse_program(lex("export trait Iterator[T]\nexport fn Iterator::map[T, C: Iterator[T]](_xs: C, _f: (T) -> T) -> Array[T] { [] }"))
  let facade = parse_program(lex("import @vibe/builtin { trait Iterator }\nexport { Iterator }"))
  let entry = parse_program(lex("import ./facade.vibe { trait Iterator }\nlet answer = Iterator::map([1], (x: Int) -> Int { x })"))
  let plan = build_export_rename_plan([builtin_path, facade_path, entry_path], [
    builtin,
    facade,
    entry
  ], entry_path)
  let facade_renames = export_plan_renames_for(plan, facade_path)
  let imported = collect_import_value_renames(plan, entry_path, entry)
  inspect(Array::length(facade_renames), "1")
  inspect(Array::length(imported), "1")
  inspect(Array::get(imported, 0).0, "Iterator::map")
  let markers = builtin_iterator_namespace_markers(entry)
  inspect(Array::length(markers), "0")
  append_builtin_iterator_plan_operation_markers(markers, imported, plan)
  inspect(Array::length(markers), "1")
  let merged: Array[Stmt] = [
    builtin_iterator_serialized_boundary_from_markers(markers)
  ]
  append_import_alias_rewritten_non_import_stmts_with_renames(merged, entry, [], imported)
  desugar_trait_dicts(merged)
  assert(String::contains(print_program(merged), "answer = Array::map"))
}

test "#2379 review: a custom Iterator facade cannot forge builtin provenance" {
  let provider_path = "provider.vibe"
  let facade_path = "facade.vibe"
  let entry_path = "main.vibe"
  let provider = parse_program(lex("export trait Iterator[T]\nexport fn Iterator::map[T, C: Iterator[T]](_xs: C, _f: (T) -> T) -> Array[T] { [] }"))
  let facade = parse_program(lex("export ./provider.vibe { trait Iterator }"))
  let entry = parse_program(lex("import ./facade.vibe { trait Iterator }\nlet answer = Iterator::map([1], (x: Int) -> Int { x })"))
  let plan = build_export_rename_plan([provider_path, facade_path, entry_path], [
    provider,
    facade,
    entry
  ], entry_path)
  let imported = collect_import_value_renames(plan, entry_path, entry)
  let markers = builtin_iterator_namespace_markers(entry)
  append_builtin_iterator_plan_operation_markers(markers, imported, plan)
  inspect(Array::length(markers), "0")
  let merged: Array[Stmt] = [
    builtin_iterator_serialized_boundary_from_markers(markers)
  ]
  append_import_alias_rewritten_non_import_stmts_with_renames(merged, entry, [], imported)
  desugar_trait_dicts(merged)
  assert(!String::contains(print_program(merged), "answer = Array::map"))
}

test "#2379 review: the last trait import owns a facade re-export" {
  let builtin_path = "lib/@vibe/builtin/index.vpkg"
  let custom_path = "custom.vibe"
  let facade_path = "facade.vibe"
  let entry_path = "main.vibe"
  let provider = "export trait Iterator[T]\nexport fn Iterator::map[T, C: Iterator[T]](_xs: C, _f: (T) -> T) -> Array[T] { [] }"
  let builtin = parse_program(lex(provider))
  let custom = parse_program(lex(provider))
  let custom_last = parse_program(lex("import @vibe/builtin { trait Iterator }\nimport ./custom.vibe { trait Iterator }\nexport { Iterator }"))
  let entry = parse_program(lex("import ./facade.vibe { trait Iterator }\nlet answer = Iterator::map([1], (x: Int) -> Int { x })"))
  let custom_plan = build_export_rename_plan([
    builtin_path,
    custom_path,
    facade_path,
    entry_path
  ], [builtin, custom, custom_last, entry], entry_path)
  let custom_imported = collect_import_value_renames(custom_plan, entry_path, entry)
  let custom_markers = builtin_iterator_namespace_markers(entry)
  append_builtin_iterator_plan_operation_markers(custom_markers, custom_imported, custom_plan)
  inspect(Array::length(custom_markers), "0")
  let builtin_last = parse_program(lex("import ./custom.vibe { trait Iterator }\nimport @vibe/builtin { trait Iterator }\nexport { Iterator }"))
  let builtin_plan = build_export_rename_plan([
    builtin_path,
    custom_path,
    facade_path,
    entry_path
  ], [builtin, custom, builtin_last, entry], entry_path)
  let builtin_imported = collect_import_value_renames(builtin_plan, entry_path, entry)
  let builtin_markers = builtin_iterator_namespace_markers(entry)
  append_builtin_iterator_plan_operation_markers(builtin_markers, builtin_imported, builtin_plan)
  inspect(Array::length(builtin_markers), "1")
}

test "#2379 review: a local trait owns a facade export over an import" {
  let builtin_path = "lib/@vibe/builtin/index.vpkg"
  let facade_path = "facade.vibe"
  let entry_path = "main.vibe"
  let builtin = parse_program(lex("export trait Iterator[T]\nexport fn Iterator::map[T, C: Iterator[T]](_xs: C, _f: (T) -> T) -> Array[T] { [] }"))
  let facade = parse_program(lex("import @vibe/builtin { trait Iterator }\ntrait Iterator[T]\nexport { Iterator }"))
  let entry = parse_program(lex("import ./facade.vibe { trait Iterator }\nlet answer = Iterator::map([1], (x: Int) -> Int { x })"))
  let plan = build_export_rename_plan([builtin_path, facade_path, entry_path], [
    builtin,
    facade,
    entry
  ], entry_path)
  let imported = collect_import_value_renames(plan, entry_path, entry)
  let markers = builtin_iterator_namespace_markers(entry)
  append_builtin_iterator_plan_operation_markers(markers, imported, plan)
  inspect(Array::length(markers), "0")
}

test "Array Iterator flatmap specialization gets a provider-unique name" {
  let provider_path = "/virtual/provider.vibe"
  let entry_path = "/virtual/main.vibe"
  let provider = parse_program(lex("export trait Iterator[T]\nexport fn Iterator::flatmap(xs: Array[Int], f: (Int) -> Array[Int]) -> Array[Int] { Array::flatmap(xs, f) }\nexport fn Array::flatmap(xs: Array[Int], _f: (Int) -> Array[Int]) -> Array[Int] { [88] }"))
  let entry = parse_program(lex("import ./provider.vibe { trait Iterator }\nfn Array::flatmap(xs: Array[Int], _f: (Int) -> Array[Int]) -> Array[Int] { [77] }"))
  let plan = build_export_rename_plan([provider_path, entry_path], [
    provider,
    entry
  ], entry_path)
  let provider_renames = export_plan_renames_for(plan, provider_path)
  inspect(Array::length(provider_renames), "2")
  let mut specialization = ""
  for rename in provider_renames {
    if rename.0 == "Array::flatmap" {
      specialization = rename.1
    }
  }
  assert(String::starts_with(specialization, "Array_exp_"))
  assert(String::ends_with(specialization, "::flatmap"))
  let imported = collect_import_value_renames(plan, entry_path, entry)
  inspect(Array::length(imported), "1")
  inspect(Array::get(imported, 0).0, "Iterator::flatmap")
  let iterator_unique = Array::get(imported, 0).1
  let standard_import = parse_program(lex("import @vibe/builtin { trait Iterator }"))
  let markers = builtin_iterator_namespace_markers(standard_import)
  append_builtin_iterator_operation_markers(markers, [
    ("Iterator::flatmap", iterator_unique)
  ])
  let serialized = print_program([
    builtin_iterator_serialized_boundary_from_markers(markers)
  ])
  let optimized = parse_program(lex(String::concat(serialized, String::concat("let answer = ", String::concat(iterator_unique, "([1], (x: Int) -> Array[Int] { [x] })")))))
  desugar_trait_dicts(optimized)
  assert(String::contains(print_program(optimized), String::concat("answer = ", String::concat(specialization, "([1]"))))
}

test "append import alias rewrite resolves import aliases" {
  let stmts = parse_program(lex("import ./dep.vibe { answer as local }\nexport let run: () -> Int = () -> { local() }"))
  let out = Array::slice(stmts, 0, 0)
  append_import_alias_rewritten_non_import_stmts(out, stmts)
  let printed = print_program(out)
  assert(String::contains(printed, "answer()"))
  assert(!String::contains(printed, "local()"))
}

test "imported type aliases rewrite fn annotations but not type formals" {
  let stmts = parse_program(lex("import ./dep.vibe { StdinStream as S }\nfn take(stream: S) -> S { stream }\nfn id[S](value: S) -> S { value }"))
  let out = Array::slice(stmts, 0, 0)
  append_import_alias_rewritten_non_import_stmts(out, stmts)
  let printed = print_program(out)
  assert(String::contains(printed, "StdinStream"))
  assert(!String::contains(printed, "(stream: S)"))
  assert(String::contains(printed, "(value: S)"))
}

test "kinded constructor formals shadow imported type aliases" {
  let stmts = parse_program(lex("import ./dep.vibe { StdinStream as F }\nfn id[F[_], A](x: F[A]) -> F[A] { x }"))
  let out = Array::slice(stmts, 0, 0)
  append_import_alias_rewritten_non_import_stmts(out, stmts)
  let printed = print_program(out)
  assert(String::contains(printed, "(x: F[A])"))
  assert(String::contains(printed, "-> F[A]"))
  assert(!String::contains(printed, "StdinStream"))
}

test "import aliases rewrite concrete impl method owners with their targets" {
  let stmts = parse_program(lex("import ./dep.vibe { Box as B }\ntrait Measured { measure(Self) -> Int }\nimpl Measured for B[Int] { measure(self) -> Int { 1 } }"))
  let out = Array::slice(stmts, 0, 0)
  append_import_alias_rewritten_non_import_stmts(out, stmts)
  let printed = print_program(out)
  let old_name = impl_method_binding_name([], "Measured", TyApp("B", [
    TyName("Int")
  ]), "measure")
  let expected_name = impl_method_binding_name([], "Measured", TyApp("Box", [
    TyName("Int")
  ]), "measure")
  assert(String::contains(printed, expected_name))
  assert(!String::contains(printed, old_name))
}

test "kinded local alias impl targets substitute constructor arguments" {
  let stmts = parse_program(lex("trait Trait { }\nstruct Holder[F[_], A] { value: A }\ntype Wrap[G[_], A] = Holder[G, A]\nimpl Trait for Wrap[Array, Int] { }"))
  let out = Array::slice(stmts, 0, 0)
  append_import_alias_rewritten_non_import_stmts(out, stmts)
  let printed = print_program(out)
  assert(String::contains(printed, "impl Trait for Holder[Array, Int]"))
  assert(!String::contains(printed, "Holder[G, Int]"))
}

test "transparent aliases rewrite concrete impl method owners with their targets" {
  let stmts = parse_program(lex("type Vec[T] = Array[T]\ntrait Measured { measure(Self) -> Int }\nimpl Measured for Vec[Int] { measure(self) -> Int { 1 } }"))
  let out = Array::slice(stmts, 0, 0)
  append_import_alias_rewritten_non_import_stmts(out, stmts)
  let printed = print_program(out)
  let old_name = impl_method_binding_name([], "Measured", TyApp("Vec", [
    TyName("Int")
  ]), "measure")
  let expected_name = impl_method_binding_name([], "Measured", TyApp("Array", [
    TyName("Int")
  ]), "measure")
  assert(String::contains(printed, expected_name))
  assert(!String::contains(printed, old_name))
  assert(String::contains(printed, "impl Measured for Array[Int]"))
}

test "later plain re-export wins over an earlier import reference rename" {
  let a_path = "/virtual/a.vibe"
  let b_path = "/virtual/b.vibe"
  let facade_path = "/virtual/facade.vibe"
  let main_path = "/virtual/main.vibe"
  let a_stmts = parse_program(lex("export fn foo() -> Int { 1 }"))
  let b_stmts = parse_program(lex("export fn foo() -> Int { 2 }"))
  let facade_stmts = parse_program(lex("import ./a.vibe { foo }\nexport ./b.vibe { foo }\nexport fn bar() -> Int { foo() }"))
  let main_stmts = parse_program(lex("import ./facade.vibe { bar }\nexport fn answer() -> Int { bar() }"))
  let paths = [a_path, b_path, facade_path, main_path]
  let plan = build_export_rename_plan(paths, [
    a_stmts,
    b_stmts,
    facade_stmts,
    main_stmts
  ], main_path)
  let renames = collect_import_value_renames(plan, facade_path, facade_stmts)
  assert(Array::length(renames) == 1)
  let (local, target) = Array::get(renames, 0)
  assert(local == "foo")
  assert(target == namespace_exported_name(b_path, "foo"))
}

test "later aliased re-export blocks an earlier import reference rename" {
  let a_path = "/virtual/a.vibe"
  let b_path = "/virtual/b.vibe"
  let facade_path = "/virtual/facade.vibe"
  let main_path = "/virtual/main.vibe"
  let a_stmts = parse_program(lex("export fn old() -> Int { 1 }"))
  let b_stmts = parse_program(lex("export fn new() -> Int { 2 }"))
  let facade_stmts = parse_program(lex("import ./a.vibe { old as foo }\nexport ./b.vibe { new as foo }\nexport fn bar() -> Int { foo() }"))
  let main_stmts = parse_program(lex("import ./facade.vibe { bar }\nexport fn answer() -> Int { bar() }"))
  let plan = build_export_rename_plan([a_path, b_path, facade_path, main_path], [
    a_stmts,
    b_stmts,
    facade_stmts,
    main_stmts
  ], main_path)
  let renames = collect_import_value_renames(plan, facade_path, facade_stmts)
  assert(Array::length(renames) == 0)
}
