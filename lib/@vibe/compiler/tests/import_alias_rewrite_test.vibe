test "a re-exported alias follows an imported enum head" {
  let dependency = parse_program(lex("export enum Color { Red; Blue }"))
  let provider = parse_program(lex("import ./dependency.vibe { enum Color as Shade }\nexport type Alias = Shade"))
  let facade = parse_program(lex("export ./provider.vibe { Alias as PublicAlias }"))
  let entry = parse_program(lex("import ./facade.vibe { PublicAlias }\nlet answer = PublicAlias::Red"))
