//# Imports

// #849/Codex review (PR #899): VIBE_BUILD_CACHE_DIR override now lives in
// cache_underlying.vibe (the compiler-specific wrapper), not in the generic
// @vibe/cache package, so pure/component consumers of @vibe/cache never pick
// up a forced vibe.env_get host import. See cache_underlying.vibe's
// rebase_cache_path for the rationale.
import @vibe/compiler/cache {
  cache_load_persistent_artifact, cache_persistent_artifact_cache_path, cache_store_persistent_artifact
}

//# Misc

test "cache_persistent_artifact_cache_path: honors VIBE_BUILD_CACHE_DIR when set, defaults to .vibe/build/cache/vibe_ otherwise" {
  let path = cache_persistent_artifact_cache_path(version_tag = "v1", kind = "env_override_demo", entry_name = "seed-a", fingerprint = "")
  let override = Env::get("VIBE_BUILD_CACHE_DIR")
  if String::length(override) > 0 {
    let expected_prefix = if String::ends_with(override, suffix = "/") {
      String::concat(override, "vibe_")
    } else {
      String::concat(override, "/vibe_")
    }
    assert(String::starts_with(path, prefix = expected_prefix))
    assert(!(String::starts_with(path, prefix = ".vibe/build/cache/vibe_")))
  } else {
    assert(String::starts_with(path, prefix = ".vibe/build/cache/vibe_"))
  }
}

test "cache_persistent_artifact_cache_path: the key formula is unaffected by the root (same inputs -> same path)" {
  let a = cache_persistent_artifact_cache_path(version_tag = "v1", kind = "env_override_demo", entry_name = "seed-b", fingerprint = "")
  let b = cache_persistent_artifact_cache_path(version_tag = "v1", kind = "env_override_demo", entry_name = "seed-b", fingerprint = "")
  assert(a == b)
}

test "cache_store_persistent_artifact / cache_load_persistent_artifact: a real write lands under the overridden root" {
  let bytes = Bytes::new()
  Bytes::push(bytes, value = 42)
  cache_store_persistent_artifact(version_tag = "v1", kind = "env_override_demo_artifact", entry_name = "seed-c", fingerprint = "", bytes = bytes)
  let path = cache_persistent_artifact_cache_path(version_tag = "v1", kind = "env_override_demo_artifact", entry_name = "seed-c", fingerprint = "")
  let override = Env::get("VIBE_BUILD_CACHE_DIR")
  if String::length(override) > 0 {
    assert(Fs::exists(path))
    let expected_prefix = if String::ends_with(override, suffix = "/") {
      String::concat(override, "vibe_")
    } else {
      String::concat(override, "/vibe_")
    }
    assert(String::starts_with(path, prefix = expected_prefix))
  } else {
    assert(Fs::exists(path))
    assert(String::starts_with(path, prefix = ".vibe/build/cache/vibe_"))
  }
  match cache_load_persistent_artifact(version_tag = "v1", kind = "env_override_demo_artifact", entry_name = "seed-c", fingerprint = "") {
    Some(loaded) => assert(Bytes::get(loaded, at = 0) == 42),
    None => assert(false)
  }
}
