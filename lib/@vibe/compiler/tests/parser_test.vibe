test "parse let* railway bind chain" {
  // `let* x = e` is the railway bind: it must parse (and desugar) without
  // error, including chained binds (proposal 4).
  let ok = handle {
    let _ = parse_program(lex("let run = () -> { let* x = foo() \n let* y = bar(x) \n Ok(y) }\n0"))
    "ok"
  } with Exception {
    Throw(_) => "threw"
  }
  assert(ok == "ok")
}

test "let* parses to the type-directed railway sentinel" {
  // #635: `let* x = e <rest>` now parses to the type-directed sentinel
  //   __try_bind(e, (x) -> <rest>)
  // which the pre-check railway desugar lowers by `e`'s head type — Result by
  // default (today's behavior), Option when `e: Option[_]`. The parser has no
  // type info, so it emits the sentinel rather than committing to a match.
  let printed = handle {
    print_program(parse_program(lex("let run = () -> { let* x = foo() \n Ok(x) }")))
  } with Exception {
    Throw(e) => String::concat("ERROR: ", e)
  }
  assert(String::contains(printed, "__try_bind"))
  // The continuation closure carries the bound name + the rest of the block.
  assert(String::contains(printed, "Ok"))
}

test "Map::new and Map::from_pairs round-trip through the printer (#960)" {
  // #960 Stage 2: `Map::new()` / `Map::from_pairs([("k", v), ...])` are the
  // ONLY spellings — the parser desugars them into the EMap node and the
  // printer prints EMap back as the same API calls, so flat module source
  // round-trips.
  let empty = handle {
    parse_print("Map::new()")
  } with Exception {
    Throw(e) => String::concat("ERROR: ", e)
  }
  assert(empty == "Map::new()")
  let pairs = handle {
    parse_print("Map::from_pairs([(\"a\", 1), (\"b\", 2)])")
  } with Exception {
    Throw(e) => String::concat("ERROR: ", e)
  }
  assert(pairs == "Map::from_pairs([(\"a\", 1), (\"b\", 2)])")
  // Stage 2 removed the literal: `map { ... }` is a located parse error that
  // names the replacement API.
  let lit = handle {
    parse_print("map { \"a\": 1, \"b\": 2 }")
  } with Exception {
    Throw(e) => String::concat("ERROR: ", e)
  }
  assert(String::starts_with(lit, "ERROR: "))
  assert(String::contains(lit, "#960"))
  assert(String::contains(lit, "Map::from_pairs"))
  // `map` stays an ordinary identifier everywhere else (no `r#` needed).
  let ident = handle {
    parse_print("map(xs, f)")
  } with Exception {
    Throw(e) => String::concat("ERROR: ", e)
  }
  assert(ident == "map(xs, f)")
}

test "Map::from_pairs rejects non-literal arguments (#960)" {
  // Only an array literal of (string literal, value) tuple literals is
  // accepted for now — anything else must be a located parse error, never a
  // silent miscompile.
  let non_literal = handle {
    parse_print("Map::from_pairs(pairs)")
  } with Exception {
    Throw(e) => String::concat("ERROR: ", e)
  }
  assert(String::starts_with(non_literal, "ERROR: "))
  assert(String::contains(non_literal, "#960"))
  let bad_key = handle {
    parse_print("Map::from_pairs([(k, 1)])")
  } with Exception {
    Throw(e) => String::concat("ERROR: ", e)
  }
  assert(String::contains(bad_key, "#960"))
  assert(String::contains(bad_key, "string literal"))
  let non_tuple = handle {
    parse_print("Map::from_pairs([1, 2])")
  } with Exception {
    Throw(e) => String::concat("ERROR: ", e)
  }
  assert(String::contains(non_tuple, "tuple literal"))
  let new_args = handle {
    parse_print("Map::new(1)")
  } with Exception {
    Throw(e) => String::concat("ERROR: ", e)
  }
  assert(String::contains(new_args, "Map::new takes no arguments"))
}

//# #1284: loop continue/break argument arity

test "#1284: continue must pass every loop parameter" {
  // The asymmetry between `continue` and `break` is real and intentional:
  // `continue(..)` supplies the loop's PARAMETERS (as many as `loop (..)`
  // declares), `break e` supplies the loop's single RESULT. This test pins
  // the arity rule for `continue`; the `break`-is-one-value half is pinned
  // by the tuple test below.
  let exact = handle {
    let _ = parse_program(lex("loop (i = 0, sum = 0) { if i > 3 { break sum } continue(i + 1, sum + i) }"))
    "ok"
  } with Exception {
    Throw(e) => String::concat("ERROR: ", e)
  }
  assert(exact == "ok")
  // Bare `continue` repeats with every parameter unchanged — still legal.
  let bare = handle {
    let _ = parse_program(lex("loop (i = 0, sum = 0) { if i > 3 { break sum } continue }"))
    "ok"
  } with Exception {
    Throw(e) => String::concat("ERROR: ", e)
  }
  assert(bare == "ok")
}

test "#1284: a continue arity mismatch is a located error, not a silent miscompile" {
  // Too FEW arguments used to update a positional prefix of the parameters
  // and leave the rest unchanged — a rule no document ever stated.
  let too_few = handle {
    let _ = parse_program(lex("loop (i = 0, sum = 0) { if i > 3 { break sum } continue(i + 1) }"))
    "ok"
  } with Exception {
    Throw(e) => String::concat("ERROR: ", e)
  }
  assert(String::starts_with(too_few, "ERROR: "))
  assert(String::contains(too_few, "#1284"))
  assert(String::contains(too_few, "2 parameter(s) (i, sum)"))
  assert(String::contains(too_few, "1 argument(s)"))
  // Too MANY arguments fell into a pass-through arm that dropped the payload
  // entirely: the parameters were never assigned, so the loop spun forever
  // with its initial values — compile-clean, and the same failure shape #808
  // fixed for break/continue inside match arms.
  let too_many = handle {
    let _ = parse_program(lex("loop (i = 0, sum = 0) { if i > 3 { break sum } continue(i + 1, sum + i, 9) }"))
    "ok"
  } with Exception {
    Throw(e) => String::concat("ERROR: ", e)
  }
  assert(String::starts_with(too_many, "ERROR: "))
  assert(String::contains(too_many, "#1284"))
  assert(String::contains(too_many, "3 argument(s)"))
}

test "#1284: break takes one value, so a parenthesized list is a tuple" {
  // `break (a, b)` in a two-parameter loop is NOT the mirror of
  // `continue(a, b)` — a `loop` is an expression with a single value, so this
  // breaks with one tuple. It stays legal; the diagnostic above is what tells
  // a reader which of the two they wanted.
  let tup = handle {
    let _ = parse_program(lex("loop (i = 0, sum = 0) { if i > 3 { break (i, sum) } continue(i + 1, sum + i) }"))
    "ok"
  } with Exception {
    Throw(e) => String::concat("ERROR: ", e)
  }
  assert(tup == "ok")
}

//# #1283: guard ... is ... else

test "#1283: guard binds over the rest of the block when the else returns" {
  let ok = handle {
    let _ = parse_program(lex("let f: (Option[Int]) -> Int = (o) -> { guard o is Some(v) else { return -1 }\n  v + 1 }\nf(Some(1))"))
    "ok"
  } with Exception {
    Throw(e) => String::concat("ERROR: ", e)
  }
  assert(ok == "ok")
  // Every path of a branching else may return.
  let branched = handle {
    let _ = parse_program(lex("let f: (Option[Int]) -> Int = (o) -> { guard o is Some(v) else { if true { return -1 } else { return -2 } }\n  v }\nf(Some(1))"))
    "ok"
  } with Exception {
    Throw(e) => String::concat("ERROR: ", e)
  }
  assert(branched == "ok")
}

test "#1283: a guard else that does not diverge is rejected" {
  // This is the whole point of the form: the else arm sits where the REST OF
  // THE BLOCK would be, so a fallthrough would reach the following statements
  // with `v` unbound. The retired let-else accepted exactly this and silently
  // replaced the rest of the function with the else value.
  let fallthrough = handle {
    let _ = parse_program(lex("let f: (Option[Int]) -> Int = (o) -> { guard o is Some(v) else { 0 }\n  v }\nf(Some(1))"))
    "ok"
  } with Exception {
    Throw(e) => String::concat("ERROR: ", e)
  }
  assert(String::starts_with(fallthrough, "ERROR: "))
  assert(String::contains(fallthrough, "#1283"))
  assert(String::contains(fallthrough, "every path"))
  // An `if` with no `else` cannot diverge on both paths.
  let half_branch = handle {
    let _ = parse_program(lex("let f: (Option[Int]) -> Int = (o) -> { guard o is Some(v) else { if true { return -1 } }\n  v }\nf(Some(1))"))
    "ok"
  } with Exception {
    Throw(e) => String::concat("ERROR: ", e)
  }
  assert(String::starts_with(half_branch, "ERROR: "))
  assert(String::contains(half_branch, "#1283"))
}

test "#1283: a guard else that only throws gets its own message" {
  // `throw` is NOT accepted as divergence yet -- the #1283 decision defers the
  // checker's explicit abortive-effect judgement -- but it is the mistake most
  // likely to be made first, since let-else did accept it. So it must not fall
  // into the generic message.
  let thrown = handle {
    let _ = parse_program(lex("let f: (Option[Int]) -> Int with Exception = (o) -> { guard o is Some(v) else { throw(\"none\") }\n  v }\nf(Some(1))"))
    "ok"
  } with Exception {
    Throw(e) => String::concat("ERROR: ", e)
  }
  assert(String::starts_with(thrown, "ERROR: "))
  assert(String::contains(thrown, "#1283"))
  assert(String::contains(thrown, "ADR-0073"))
}

test "#1283: guard requires both `is` and `else`" {
  let no_is = handle {
    let _ = parse_program(lex("let f: (Option[Int]) -> Int = (o) -> { guard o else { return -1 }\n  0 }\nf(Some(1))"))
    "ok"
  } with Exception {
    Throw(e) => String::concat("ERROR: ", e)
  }
  assert(String::starts_with(no_is, "ERROR: "))
  assert(String::contains(no_is, "#1283"))
  let no_else = handle {
    let _ = parse_program(lex("let f: (Option[Int]) -> Int = (o) -> { guard o is Some(v)\n  v }\nf(Some(1))"))
    "ok"
  } with Exception {
    Throw(e) => String::concat("ERROR: ", e)
  }
  assert(String::starts_with(no_else, "ERROR: "))
  assert(String::contains(no_else, "#1283"))
}

test "#1283: the retired let-else spelling is rejected by name" {
  // A generic parse error here would send the reader looking for a typo. The
  // message has to say what replaced it, because the replacement is not a
  // drop-in: let-else's else supplied a VALUE for the remaining block.
  let old_form = handle {
    let _ = parse_program(lex("let f: (Option[Int]) -> Int = (o) -> { let Some(v) = o else { return -1 }\n  v }\nf(Some(1))"))
    "ok"
  } with Exception {
    Throw(e) => String::concat("ERROR: ", e)
  }
  assert(String::starts_with(old_form, "ERROR: "))
  assert(String::contains(old_form, "#1283"))
  assert(String::contains(old_form, "let-else"))
  assert(String::contains(old_form, "guard"))
  // The irrefutable pattern-let with NO else is a different construct and
  // stays legal.
  let no_else = handle {
    let _ = parse_program(lex("let f: (Option[Int]) -> Int = (o) -> { let Some(v) = o\n  v }\nf(Some(1))"))
    "ok"
  } with Exception {
    Throw(e) => String::concat("ERROR: ", e)
  }
  assert(no_else == "ok")
}

test "#1283: `guard` is a reserved word, escapable as r#guard" {
  let reserved = handle {
    let _ = parse_program(lex("let guard = 1\nguard"))
    "ok"
  } with Exception {
    Throw(e) => String::concat("ERROR: ", e)
  }
  assert(String::starts_with(reserved, "ERROR: "))
  let escaped = handle {
    let _ = parse_program(lex("let r#guard = 1\nr#guard"))
    "ok"
  } with Exception {
    Throw(e) => String::concat("ERROR: ", e)
  }
  assert(escaped == "ok")
}

//# #819: example blocks

test "#819: example parses and lowers to a test for every downstream stage" {
  // The default entry point lowers SExample to STest, so the printed program
  // is indistinguishable from a test -- that IS the contract: no downstream
  // pass learns a third block form, and the ~106 STest sites stay untouched.
  let lowered = handle {
    print_program(parse_program(lex("example \"adds\" { assert_eq(1 + 1, 2) }")))
  } with Exception {
    Throw(e) => String::concat("ERROR: ", e)
  }
  assert(String::contains(lowered, "test \"adds\""))
  assert(!String::contains(lowered, "example \"adds\""))
}

test "#819: the preserving entry point keeps the example distinguishable" {
  // Tooling that must tell an example from a test -- LSP hover, doc
  // extraction -- reads this parse, exactly as the printer/normalize
  // round-trip reads it to keep `fn` in `fn` form (ADR-0064 #727).
  let kept = handle {
    print_program(parse_program_preserving(lex("example \"adds\" { assert_eq(1 + 1, 2) }")))
  } with Exception {
    Throw(e) => String::concat("ERROR: ", e)
  }
  assert(String::contains(kept, "example \"adds\""))
}

test "#819: an example needs a name string" {
  let unnamed = handle {
    let _ = parse_program(lex("example { assert_eq(1, 1) }"))
    "ok"
  } with Exception {
    Throw(e) => String::concat("ERROR: ", e)
  }
  assert(String::starts_with(unnamed, "ERROR: "))
  assert(String::contains(unnamed, "example name string"))
}

test "#819: `example` is a reserved word, escapable as r#example" {
  let reserved = handle {
    let _ = parse_program(lex("let example = 1\nexample"))
    "ok"
  } with Exception {
    Throw(e) => String::concat("ERROR: ", e)
  }
  assert(String::starts_with(reserved, "ERROR: "))
  let escaped = handle {
    let _ = parse_program(lex("let r#example = 1\nr#example"))
    "ok"
  } with Exception {
    Throw(e) => String::concat("ERROR: ", e)
  }
  assert(escaped == "ok")
}

//# #1429: effect-row spellings

test "#1429: the braced row is rejected by name" {
  // The braced form was accepted through the migration and is now gone. The
  // rejection names the replacement AND `vibe fmt`, because a reader who hits
  // "expected an effect name" has no way to learn that the syntax moved.
  let braced = handle {
    print_program(parse_program(lex("let f: (Int) -> Int with { Error, Fs } = (x) -> { x }")))
  } with Exception {
    Throw(e) => String::concat("ERROR: ", e)
  }
  assert(String::starts_with(braced, "ERROR: "))
  assert(String::contains(braced, "removed in #1429"))
  assert(String::contains(braced, "with A + B"))
  assert(String::contains(braced, "vibe fmt"))
}

test "#1429: the braceless row parses and round-trips" {
  let braceless = handle {
    print_program(parse_program(lex("let f: (Int) -> Int with Exception + Fs = (x) -> { x }")))
  } with Exception {
    Throw(e) => String::concat("ERROR: ", e)
  }
  assert(!String::starts_with(braceless, "ERROR: "))
  assert(String::contains(braceless, "with Exception + Fs"))
  assert(!String::contains(braceless, "with {"))
}

test "#1429: `with ()` is the empty row and `with {}` is rejected" {
  let parens = handle {
    print_program(parse_program(lex("let f: (Int) -> Int with () = (x) -> { x }")))
  } with Exception {
    Throw(e) => String::concat("ERROR: ", e)
  }
  assert(!String::starts_with(parens, "ERROR: "))
  assert(String::contains(parens, "with ()"))
  let braces = handle {
    print_program(parse_program(lex("let f: (Int) -> Int with {} = (x) -> { x }")))
  } with Exception {
    Throw(e) => String::concat("ERROR: ", e)
  }
  assert(String::starts_with(braces, "ERROR: "))
  assert(String::contains(braces, "removed in #1429"))
}

//# #1345 / ADR-0088: the `allows` clause

test "#1345: `allows` folds into the single row" {
  // ADR-0088 decision 1: the split is a checked audit surface, not a second
  // row representation, so `with A allows C` and `with A + C` are the SAME
  // row and produce byte-identical output.
  let split = handle {
    print_program(parse_program(lex("let f: (Int) -> Int with Log::Emit allows Fs::read_file = (x) -> { x }")))
  } with Exception {
    Throw(e) => String::concat("ERROR: ", e)
  }
  let flat = handle {
    print_program(parse_program(lex("let f: (Int) -> Int with Log::Emit + Fs::read_file = (x) -> { x }")))
  } with Exception {
    Throw(e) => String::concat("ERROR: ", e)
  }
  assert(!String::starts_with(split, "ERROR: "))
  assert(split == flat)
  // The corollary, and a known gap: the printer cannot render the clause
  // back, so `vibe normalize` ERASES it. Pinned here so that whoever adds
  // AST-level preservation sees this assertion flip.
  assert(!String::contains(split, "allows"))
}

test "#1345: `with () allows C` is the capability-only row" {
  let out = handle {
    print_program(parse_program(lex("let f: (Int) -> Int with () allows Fs::read_file = (x) -> { x }")))
  } with Exception {
    Throw(e) => String::concat("ERROR: ", e)
  }
  assert(!String::starts_with(out, "ERROR: "))
  assert(String::contains(out, "with Fs::read_file"))
}

test "#1345: `allows` works in type position too" {
  // ADR-0088: the sugar is uniform across signature and type positions --
  // there is one row grammar, not a declaration-only spelling.
  let out = handle {
    print_program(parse_program(lex("let g: ((Int) -> Int with Log::Emit allows Fs::read_file, Int) -> Int = (f, x) -> { f(x) }")))
  } with Exception {
    Throw(e) => String::concat("ERROR: ", e)
  }
  assert(!String::starts_with(out, "ERROR: "))
  assert(String::contains(out, "with Log::Emit + Fs::read_file"))
}

test "#1345: `allows` is contextual, not reserved" {
  // ADR-0088 chose a contextual keyword so user code keeping a binding named
  // `allows` does not break. It is recognized only directly after a row.
  let out = handle {
    print_program(parse_program(lex("let allows = 7\nlet use_it = () -> { allows }")))
  } with Exception {
    Throw(e) => String::concat("ERROR: ", e)
  }
  assert(!String::starts_with(out, "ERROR: "))
  assert(String::contains(out, "let allows = 7"))
}

test "#1345: `allows` takes capability effects only" {
  // ADR-0088 decision 1. The check runs at PARSE time because that is the
  // only place the two clauses still exist -- they fold into one row
  // immediately after, and nothing downstream can tell them apart again.
  let ok = handle {
    print_program(parse_program(lex("let f: () -> Int with Exception allows Fs = () -> { 1 }")))
  } with Exception {
    Throw(e) => String::concat("ERROR: ", e)
  }
  assert(!String::starts_with(ok, "ERROR: "))
  // an algebraic effect in `allows`
  let alg = handle {
    print_program(parse_program(lex("let f: () -> Int with () allows Log = () -> { 1 }")))
  } with Exception {
    Throw(e) => String::concat("ERROR: ", e)
  }
  assert(String::contains(alg, "not a capability effect"))
  // a row variable in `allows` -- ADR-0088 rejects it because `allows`
  // promises every item is a statically known capability
  let rowvar = handle {
    print_program(parse_program(lex("let f: [r]() -> Int with () allows r = () -> { 1 }")))
  } with Exception {
    Throw(e) => String::concat("ERROR: ", e)
  }
  assert(String::contains(rowvar, "not a capability effect"))
}

test "#1345: a core ambient effect in `allows` names the right clause" {
  // `Error`/`Exception[E]` get their own message rather than the generic
  // "not a capability": the author wrote a real effect in the wrong clause,
  // and the fix is to move it, not to reclassify it.
  let out = handle {
    print_program(parse_program(lex("let f: () -> Int with () allows Error = () -> { 1 }")))
  } with Exception {
    Throw(e) => String::concat("ERROR: ", e)
  }
  assert(String::contains(out, "core ambient effect"))
  assert(String::contains(out, "`with` clause"))
}

test "#1345: the SPLIT `with` clause rejects capabilities, the bare one does not" {
  // ADR-0088: "通常関数の裸 with(混在可)は恒久的に合法" -- the restriction is
  // opt-in and starts only once the author writes `allows`.
  let bare = handle {
    print_program(parse_program(lex("let f: () -> Int with Fs = () -> { 1 }")))
  } with Exception {
    Throw(e) => String::concat("ERROR: ", e)
  }
  assert(!String::starts_with(bare, "ERROR: "))
  let split = handle {
    print_program(parse_program(lex("let f: () -> Int with Fs allows Http = () -> { 1 }")))
  } with Exception {
    Throw(e) => String::concat("ERROR: ", e)
  }
  assert(String::contains(split, "must appear in the `allows` clause"))
}

test "#1345: classification uses the base effect name, and excludes Async" {
  // A qualified operation classifies by its effect: `Fs::read_file` is a
  // capability because `Fs` is.
  let qualified = handle {
    print_program(parse_program(lex("let f: () -> Int with () allows Fs::read_file = () -> { 1 }")))
  } with Exception {
    Throw(e) => String::concat("ERROR: ", e)
  }
  assert(!String::starts_with(qualified, "ERROR: "))
  // `Async` is builtin-tagged but is NOT a capability: it is ADR-0089's
  // suspension effect, discharged by the runtime driver, with no resource
  // kind to grant. Deriving the list from "is it builtin" would get this
  // wrong, which is why it is written out.
  let async_cap = handle {
    print_program(parse_program(lex("let f: () -> Int with () allows Async = () -> { 1 }")))
  } with Exception {
    Throw(e) => String::concat("ERROR: ", e)
  }
  assert(String::contains(async_cap, "not a capability effect"))
}

test "#1345: the `?` grade suffix does NOT parse yet" {
  // Deliberately absent: the checker compares row items as opaque labels, so
  // `Cfg::Read?` would be a different effect from `Cfg::Read` and a function
  // declaring the Optional form would be told to declare BOTH. `?` ships with
  // the slice that gives it meaning (strict grade matching / `perform?`).
  let out = handle {
    print_program(parse_program(lex("let f: (Int) -> Int with () allows Fs::read_file? = (x) -> { x }")))
  } with Exception {
    Throw(e) => String::concat("ERROR: ", e)
  }
  assert(String::starts_with(out, "ERROR: "))
}

test "#1429: a parenthesized non-empty row is rejected by name" {
  // Accepting `with (A + B)` would put the brackets-or-not choice straight
  // back into the language under different punctuation, so it is a named
  // error rather than a second grouping syntax.
  let grouped = handle {
    let _ = parse_program(lex("let f: (Int) -> Int with (Error + Fs) = (x) -> { x }"))
    "ok"
  } with Exception {
    Throw(e) => String::concat("ERROR: ", e)
  }
  assert(String::starts_with(grouped, "ERROR: "))
  assert(String::contains(grouped, "#1429"))
  assert(String::contains(grouped, "EMPTY effect row"))
}

test "#1429: a braceless row in a nested function type ends at the comma" {
  // The separator is `+` and not `,` precisely so this parses: with a comma,
  // `(Int) -> Int with Exception, b: Int` is either one row of two labels or a
  // row of one followed by another parameter, and the parser cannot tell.
  let nested = handle {
    let _ = parse_program(lex("let g: ((Int) -> Int with Exception, Int) -> Int = (f, b) -> { f(b) }"))
    "ok"
  } with Exception {
    Throw(e) => String::concat("ERROR: ", e)
  }
  assert(nested == "ok")
}

test "#1429: an empty braceless row is a located error, not a silent empty row" {
  // `with` followed by the body brace would silently read as "no labels" if
  // the row reader tolerated an empty item list.
  let dangling = handle {
    let _ = parse_program(lex("let f: (Int) -> Int with = (x) -> { x }"))
    "ok"
  } with Exception {
    Throw(e) => String::concat("ERROR: ", e)
  }
  assert(String::starts_with(dangling, "ERROR: "))
  assert(String::contains(dangling, "effect name"))
}

//# ADR-0075 Phase 2: `resource` declarations (#1343 実装順 2)

test "#1343: `resource Name : Owner::Kind` parses and round-trips" {
  let printed = handle {
    print_program(parse_program(lex("resource Posts : S3::Bucket\n")))
  } with Exception {
    Throw(e) => String::concat("ERROR: ", e)
  }
  assert(String::contains(printed, "resource Posts: S3::Bucket"))
}

test "#1343: an UNQUALIFIED resource kind is rejected by name" {
  // A bare name here would be indistinguishable from a type, and ADR-0075 is
  // explicit that a resource kind is not a type.
  let bare = handle {
    let _ = parse_program(lex("resource Posts : Bucket\n"))
    "ok"
  } with Exception {
    Throw(e) => String::concat("ERROR: ", e)
  }
  assert(String::starts_with(bare, "ERROR: "))
  assert(String::contains(bare, "qualified"))
}

test "#1343: a QUALIFIED resource name says which side takes the path" {
  let swapped = handle {
    let _ = parse_program(lex("resource S3::Posts : Bucket\n"))
    "ok"
  } with Exception {
    Throw(e) => String::concat("ERROR: ", e)
  }
  assert(String::starts_with(swapped, "ERROR: "))
  assert(String::contains(swapped, "resource KIND"))
}

test "#1343: a `resource` declaration cannot be exported" {
  // ADR-0075 puts it at the `.vibex` root only; a reusable module abstracts
  // over a resource KIND parameter instead of naming a resource.
  let exported = handle {
    let _ = parse_program(lex("export resource Posts : S3::Bucket\n"))
    "ok"
  } with Exception {
    Throw(e) => String::concat("ERROR: ", e)
  }
  assert(String::starts_with(exported, "ERROR: "))
  assert(String::contains(exported, "cannot be exported"))
}

test "#1343: `resource` is still an ordinary identifier" {
  // The declaration form needs `<Ident> :` after the word, so a statement
  // that merely BEGINS with `resource` keeps meaning what it did. `effect`
  // and `effectset` claim their word unconditionally; this one does not.
  let asname = handle {
    let _ = parse_program(lex("let resource = 1\nlet n = resource + 1\n"))
    "ok"
  } with Exception {
    Throw(e) => String::concat("ERROR: ", e)
  }
  assert(asname == "ok")
  let called = handle {
    let _ = parse_program(lex("let resource = (x) -> { x }\nlet y = resource(1)\n"))
    "ok"
  } with Exception {
    Throw(e) => String::concat("ERROR: ", e)
  }
  assert(called == "ok")
}
