//# Imports

import @vibe/compiler/syntax {
  lex, print_program
}

import @vibe/ast {
  Stmt
}

import ../parser.vibe {
  parse_program, parse_program_preserving
}

import ./parser_test_support.vibe {
  parse_print
}

//# Misc

test "parse comparison" {
  let result = handle {
    parse_print("a == b")
  } with Exception {
    Throw(e) => String::concat("ERROR: ", e)
  }
  assert(result == "(a == b)")
}

test "parse qualified import/export names" {
  // Regression: import/export lists accept qualified `Ns::member` items
  // (e.g. `Int::abs`, `JsonSchema::validate`) — used by prelude/index.vibe
  // and vibe/x/index.vibe aggregators (#492).
  let imp = handle {
    let _ = parse_program(lex("import ./x.vibe { Foo::bar, baz as qux }\n0"))
    "ok"
  } with Exception {
    Throw(_) => "threw"
  }
  assert(imp == "ok")
  let exp = handle {
    let _ = parse_program(lex("export ./x.vibe { A::b }\n0"))
    "ok"
  } with Exception {
    Throw(_) => "threw"
  }
  assert(exp == "ok")
}

test "parse generic impl" {
  // Regression: impl statements accept a type-parameter header with bounds
  // and a generic target type, e.g. `impl [T: Eq] Eq for Option[T]` — used by
  // vibe/prelude/option.vibe (#492).
  let ok = handle {
    let _ = parse_program(lex("trait Eq\nimpl Eq for Int\nimpl [T: Eq] Eq for Option[T]\n0"))
    "ok"
  } with Exception {
    Throw(_) => "threw"
  }
  assert(ok == "ok")
}

test "trait header params roundtrip with supertrait and method-generic metadata" {
  let source = "trait Iterator[T, U]: Iterable { next[V: Show](T, U) -> V }"
  let parsed = parse_program(lex(source))
  match Array::get(parsed, 0) {
    STrait(_, "Iterator", supers, methods, method_gens, tparams) => {
      assert(Array::length(tparams) == 2)
      assert(Array::get(tparams, 0) == "T")
      assert(Array::get(tparams, 1) == "U")
      assert(Array::length(supers) == 1)
      assert(Array::get(supers, 0) == "Iterable")
      assert(Array::length(methods) == 1)
      assert(Array::length(method_gens) == 1)
    },
    _ => assert(false)
  }
  let printed = print_program(parsed)
  assert(printed == "trait Iterator[T, U]: Iterable {\n  next[V: Show](T, U) -> V\n}")
  assert(print_program(parse_program(lex(printed))) == printed)
}

test "print trait method generic bounds preserves semantic differences" {
  let show = handle {
    print_program(parse_program(lex("trait Identity { identity[U: Show](U) -> U }")))
  } with Exception {
    Throw(e) => String::concat("ERROR: ", e)
  }
  let eq = handle {
    print_program(parse_program(lex("trait Identity { identity[U: Eq](U) -> U }")))
  } with Exception {
    Throw(e) => String::concat("ERROR: ", e)
  }
  assert(show == "trait Identity {\n  identity[U: Show](U) -> U\n}")
  assert(show != eq)
  let reparsed = handle {
    print_program(parse_program(lex(show)))
  } with Exception {
    Throw(e) => String::concat("ERROR: ", e)
  }
  assert(reparsed == show)
}

test "print impl generic bounds preserves semantic differences" {
  let eq = handle {
    print_program(parse_program(lex("impl [T: Eq] Eq for Box")))
  } with Exception {
    Throw(e) => String::concat("ERROR: ", e)
  }
  let show = handle {
    print_program(parse_program(lex("impl [T: Show] Eq for Box")))
  } with Exception {
    Throw(e) => String::concat("ERROR: ", e)
  }
  assert(eq == "impl [T: Eq] Eq for Box")
  assert(eq != show)
  let reparsed = handle {
    print_program(parse_program(lex(eq)))
  } with Exception {
    Throw(e) => String::concat("ERROR: ", e)
  }
  assert(reparsed == eq)
}

test "parse value-position generic let keeps type params" {
  // Regression: `let f = [T: Ord](...)` (a value-position type-parameter
  // header, no `: Type` annotation) must put `[T: Ord]` onto the lambda's
  // type params and survive a print -> re-parse round-trip. Previously the
  // header was skipped and discarded, so the round-trip (used when merging
  // multi-module programs) lost it (#492).
  let p1 = handle {
    print_program(parse_program(lex("let ord_max = [T: Ord](a: T, b: T) -> T { if a < b { b } else a }")))
  } with Exception {
    Throw(e) => String::concat("ERR: ", e)
  }
  assert(String::index_of(p1, "[T: Ord]") >= 0)
  // and it is stable across a second round-trip
  let p2 = handle {
    print_program(parse_program(lex(p1)))
  } with Exception {
    Throw(_) => "threw"
  }
  assert(p1 == p2)
}

test "parse expression-position generic lambda keeps type params" {
  // The header is not immediately after a `let =`, so this takes the generic
  // expression-primary path rather than the declaration helper path.
  let p1 = handle {
    print_program(parse_program(lex("let callbacks = [[T: Ord](x: T) -> T { x }]\n0")))
  } with Exception {
    Throw(e) => String::concat("ERR: ", e)
  }
  assert(String::index_of(p1, "[T: Ord]") >= 0)
  let p2 = handle {
    print_program(parse_program(lex(p1)))
  } with Exception {
    Throw(_) => "threw"
  }
  assert(p1 == p2)
}

test "parse generic struct" {
  // Regression: struct declarations accept a type-parameter header
  // `struct Foo[T] { ... }` (and `[A, B]`) — used by vibe/prelude/string_view.vibe
  // (`struct ArrayView[T]`) (#492).
  let ok = handle {
    let _ = parse_program(lex("struct Box[T] { v: T }\nstruct Pair[A, B] { fst: A; snd: B }\n0"))
    "ok"
  } with Exception {
    Throw(_) => "threw"
  }
  assert(ok == "ok")
}

test "parse array trailing comma" {
  // Regression: array literals accept a trailing comma `[a, b,]` — used by
  // vibe/x/args/demo.vibe. Previously surfaced as a misleading
  // `unexpected token: ->` downstream parse error (#492).
  let ok = handle {
    let _ = parse_program(lex("let xs = [\"a\", \"b\", \"c\",]\nArray::length(xs)"))
    "ok"
  } with Exception {
    Throw(_) => "threw"
  }
  assert(ok == "ok")
}

test "parse tuple and call trailing comma" {
  // Regression: tuples `(a, b,)` and call argument lists `f(a, b,)` accept a
  // trailing comma — used by vibe/x/scan/scan.vibe. Previously surfaced as
  // `expected ')' or ','` (#492).
  // No top-level tuple-pattern destructure here (that is #1281's expansion,
  // unrelated to what this test covers) — just the tuple literal itself.
  let tup = handle {
    let _ = parse_program(lex("let t = (1, 2,)\nt"))
    "ok"
  } with Exception {
    Throw(_) => "threw"
  }
  assert(tup == "ok")
  let call = handle {
    let _ = parse_program(lex("let add = (a: Int, b: Int) -> Int { a + b }\nadd(1, 2,)"))
    "ok"
  } with Exception {
    Throw(_) => "threw"
  }
  assert(call == "ok")
}

test "parse generic type alias" {
  // Regression: type aliases accept a type-parameter header
  // `type Foo[T] = ...` — used by vibe/prelude/string_parser.vibe
  // (`type ParseResult[T] = Option[(T, Int)]`) (#492).
  let ok = handle {
    let _ = parse_program(lex("type ParseResult[T] = Option[(T, Int)]\ntype Pair[A, B] = (A, B)\n0"))
    "ok"
  } with Exception {
    Throw(_) => "threw"
  }
  assert(ok == "ok")
}

test "parse higher-order effect function type annotation" {
  // Regression: function types can appear as parenthesized parameter types
  // inside another function type, with an effect variable on both levels.
  let ok = handle {
    let _ = parse_program(lex("let apply: [e]((Int) -> Int with e, Int) -> Int with e = (f, x) -> { f(x) }\n0"))
    "ok"
  } with Exception {
    Throw(_) => "threw"
  }
  assert(ok == "ok")
}

test "parse higher-order effect function type annotation with trailing comma" {
  let source = "let chain: [e](\n  (Int) -> Int with e,\n  (Int) -> Int with e,\n  Int,\n) -> Int with e = (f, g, x) -> { add(f(x), g(x)) }\n0"
  let ok = handle {
    let _ = parse_program(lex(source))
    "ok"
  } with Exception {
    Throw(_) => "threw"
  }
  assert(ok == "ok")
}

