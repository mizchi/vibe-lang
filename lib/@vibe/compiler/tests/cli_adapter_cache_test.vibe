//# Imports

import ../cli_adapter_bundle.vibe {
  cli_adapter_merged_source, cli_adapter_module_source, cli_adapter_source_groups, cli_adapter_sources
}

//# Misc

test "cli adapter bundle exposes embedded closure" {
  assert(Array::length(cli_adapter_sources()) > 50)
}

test "cli adapter bundle preserves grouped layers" {
  // The bundle's group count grows as new layers (e.g. types,
  // codegen) are added; assert a lower bound rather than an exact match
  // so the test does not break every time a layer is split.
  assert(Array::length(cli_adapter_source_groups()) >= 5)
}

test "cli adapter merged source is embedded" {
  let merged_source = cli_adapter_merged_source()
  assert(String::length(merged_source) > 0)
}

test "cli adapter module source is embedded" {
  let merged_source = cli_adapter_merged_source()
  let module_source = cli_adapter_module_source()
  assert(String::length(module_source) > 0)
  // The module-only slice is at most as large as the merged bundle.
  // It used to be strictly smaller, but DCE rooted at `cli_main` keeps
  // everything in practice because cli_main transitively references
  // every helper, so we relax to `<=`.
  assert(String::length(module_source) <= String::length(merged_source))
}
