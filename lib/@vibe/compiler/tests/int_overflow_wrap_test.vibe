// #1877: Int arithmetic overflow wraps at the language's 62-bit range
// (-2^61 .. 2^61-1) with two's-complement semantics — the SAME values on
// every backend (bump / RC / wasm-gc). Before the fix each lane wrapped
// wherever its representation overflowed i64 (untagged at 64 bits, the RC
// lane's tagged `n<<1` at 63 bits for `+` but 62 for `*`), so the same
// program printed different numbers per backend with no diagnostic.
//
// `opaque` launders operands through a call so constant folding cannot
// pre-compute a result with the compiler's own (also-wrapping) arithmetic —
// these tests pin the RUNTIME op semantics. MIN (-2^61) is built by
// arithmetic: the literal 2305843009213693952 itself is rejected
// (IntLiteralOverflow), which is exactly the range these ops now respect.

fn opaque(x: Int) -> Int {
  x + 0
}

fn int_min() -> Int {
  0 - opaque(2305843009213693951) - 1
}

test "add wraps at the 62-bit boundary" {
  let b60 = opaque(1152921504606846976)
  let max = opaque(2305843009213693951)
  assert(b60 + b60 == int_min())
  assert(max + max == 0 - 2)
  assert(max + opaque(1) == int_min())
  assert(max + opaque(2) == int_min() + 1)
}

test "mul wraps at the 62-bit boundary" {
  let b60 = opaque(1152921504606846976)
  assert(b60 * opaque(2) == int_min())
  assert(b60 * opaque(3) == 0 - 1152921504606846976)
  assert(b60 * opaque(4) == 0)
  // deep wrap: the product of two large odd values is the same on every lane
  assert(opaque(1103515245) * opaque(2147483647) * opaque(7) == 0 - 1858277473740662011)
}

test "sub and unary minus wrap below the minimum" {
  let max = opaque(2305843009213693951)
  assert(0 - max - max == 2)
  assert(0 - int_min() == int_min())
  assert(int_min() - opaque(1) == max)
}

test "shl wraps like repeated doubling" {
  let max = opaque(2305843009213693951)
  assert((max << opaque(1)) == 0 - 2)
  assert((opaque(1) << opaque(61)) == int_min())
  assert((opaque(1) << opaque(62)) == 0)
}

test "compound assignment ops wrap identically" {
  let mut x = opaque(2305843009213693951)
  x += opaque(2)
  assert(x == int_min() + 1)
  let mut y = opaque(1152921504606846976)
  y *= opaque(4)
  assert(y == 0)
  let mut z = int_min()
  z -= opaque(1)
  assert(z == 2305843009213693951)
}

test "in-range arithmetic is untouched" {
  assert(opaque(21) * opaque(2) == 42)
  assert(opaque(1) << opaque(60) == 1152921504606846976)
  assert(0 - opaque(2305843009213693951) == 0 - 2305843009213693951)
  assert(opaque(2305843009213693951) % opaque(1000) == 951)
  assert((opaque(2305843009213693951) >> opaque(1)) == 1152921504606846975)
}
