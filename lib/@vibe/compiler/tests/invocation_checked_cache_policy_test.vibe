import @vibe/compiler/cache/policy {
  CheckedModuleCacheConfig, checked_module_cache_policy
}
import @vibe/compiler/cache {
  persistent_artifact_cache_path_in_namespace, store_persistent_artifact_in_namespace
}
import @vibe/compiler/config {
  target_cfg_from_csv, target_cfg_namespace
}
import @vibe/compiler/checker {
  check_program_result, typing_semantics_seed
}
import @vibe/compiler/checker/artifacts/module {
  CheckedModuleArtifact, checked_module_input_fingerprint, encode_checked_module_artifact
}
import @vibe/compiler/runtime/checked_module_cache {
  checked_module_artifact_stmts_configured,
  checked_module_artifact_stmts_in_namespace,
  checked_module_artifact_stmts_with_policy,
  checked_module_cache_input_identity_in_namespace,
  checked_module_cache_reset_in_namespace,
  checked_module_cache_stats,
  commit_checked_module_artifact_configured,
  commit_checked_module_artifact_in_namespace,
  commit_checked_module_artifact_with_policy,
  load_checked_module_artifact_configured,
  load_checked_module_artifact_in_namespace,
  load_checked_module_artifact_with_policy,
  set_checked_module_cache_mode
}
import @vibe/compiler/syntax {
  lex_with_offsets, parse_program_located
}

fn checked_policy_fixture(path: String, source: String, namespace: String) -> CheckedModuleArtifact with Env + Exception {
  let (tokens, offsets, _) = lex_with_offsets(source)
  let parsed_stmts = parse_program_located(tokens = tokens, starts = offsets, source = source)
  CheckedModuleArtifact::{
    input_identity: checked_module_cache_input_identity_in_namespace(path = path, source = source, semantics_seed = typing_semantics_seed(checked_error_row = false), deps = [
    ], namespace = namespace, checked_error_row = false),
    parsed_stmts,
    checked_program: check_program_result(parsed_stmts, checked_error_row = false),
    lowering_offsets: [7],
    eq_offsets: [],
    eq_keys: []
  }
}

fn checked_policy_key(path: String, artifact: CheckedModuleArtifact, namespace: String) -> String with Env {
  persistent_artifact_cache_path_in_namespace(kind = "checked-module-v1", entry_name = path, fingerprint = checked_module_input_fingerprint(artifact.input_identity), namespace = namespace, checked_error_row = false)
}

fn checked_policy_store(path: String, artifact: CheckedModuleArtifact, namespace: String) -> Unit with Env + Exception + Fs {
  store_persistent_artifact_in_namespace(kind = "checked-module-v1", entry_name = path, fingerprint = checked_module_input_fingerprint(artifact.input_identity), bytes = encode_checked_module_artifact(artifact), namespace = namespace, checked_error_row = false)
}

fn checked_policy_load_only(path: String, identity: Bytes, namespace: String) -> Bool with CheckedModuleCacheConfig + Env + Exception + Fs {
  load_checked_module_artifact_configured(path = path, input_identity = identity, namespace = namespace, checked_error_row = false) is Some(_)
}

fn checked_policy_handoff_only(path: String, source: String, namespace: String) -> Int with CheckedModuleCacheConfig + Exception {
  match checked_module_artifact_stmts_configured(path = path, source = source, namespace = namespace, checked_error_row = false) {
    Some(stmts) => Array::length(stmts),
    None => -1
  }
}

test "retained modes control disk use and statement handoff independently of the legacy mode" {
  let path = "/tmp/checked-policy-data-\{Profiler::now_us()}.vibe"
  let source = "export let value = 42"
  let namespace = target_cfg_namespace(target_cfg_from_csv("checked-policy-data"))
  let artifact = checked_policy_fixture(path = path, source = source, namespace = namespace)
  let key = checked_policy_key(path = path, artifact = artifact, namespace = namespace)
  let off = checked_module_cache_policy("off")
  let on = checked_module_cache_policy("on")
  let verify = checked_module_cache_policy("verify")
  set_checked_module_cache_mode("off", checked_error_row = false)
  checked_module_cache_reset_in_namespace(namespace = namespace, checked_error_row = false)
  commit_checked_module_artifact_with_policy(path = path, source = source, artifact = artifact, fresh = true, namespace = namespace, policy = off, checked_error_row = false)
  assert(!Fs::exists(key))
  let empty = checked_module_cache_stats()
  assert_eq((empty.0, empty.1, empty.2), (0, 0, 0))
  commit_checked_module_artifact_with_policy(path = path, source = source, artifact = artifact, fresh = true, namespace = namespace, policy = on, checked_error_row = false)
  assert(Fs::exists(key))
  for policy in [off, verify] {
    assert(load_checked_module_artifact_with_policy(path = path, input_identity = artifact.input_identity, namespace = namespace, policy = policy, checked_error_row = false) is None)
  }
  match load_checked_module_artifact_with_policy(path = path, input_identity = artifact.input_identity, namespace = namespace, policy = on, checked_error_row = false) {
    Some(loaded) => assert(encode_checked_module_artifact(loaded) == encode_checked_module_artifact(artifact)),
    None => assert(false)
  }
  assert(load_checked_module_artifact_with_policy(path = path, input_identity = Bytes::from_array([
    1
  ]), namespace = namespace, policy = on, checked_error_row = false) is None)
  assert(checked_module_artifact_stmts_with_policy(path = path, source = source, namespace = namespace, policy = off, checked_error_row = false) is None)
  assert(checked_module_artifact_stmts_in_namespace(path = path, source = source, namespace = namespace, checked_error_row = false) is None)
  match checked_module_artifact_stmts_with_policy(path = path, source = source, namespace = namespace, policy = on, checked_error_row = false) {
    Some(stmts) => {
      assert_eq(Array::length(stmts), 1); Array::truncate(stmts, length = 0)
    },
    None => assert(false)
  }
  assert_eq(handle {
    checked_policy_handoff_only(path = path, source = source, namespace = namespace)
  } with { CheckedModuleCacheConfig::Mode() => resume("verify") }, 1)
  assert(checked_module_artifact_stmts_with_policy(path = path, source = "changed", namespace = namespace, policy = on, checked_error_row = false) is None)
  let other = target_cfg_namespace(target_cfg_from_csv("checked-policy-other"))
  assert(load_checked_module_artifact_with_policy(path = path, input_identity = artifact.input_identity, namespace = other, policy = on, checked_error_row = false) is None)
  assert(checked_module_artifact_stmts_with_policy(path = path, source = source, namespace = other, policy = on, checked_error_row = false) is None)
  checked_module_cache_reset_in_namespace(namespace = namespace, checked_error_row = false)
  commit_checked_module_artifact_with_policy(path = path, source = source, artifact = artifact, fresh = false, namespace = namespace, policy = on, checked_error_row = false)
  let reused = checked_module_cache_stats()
  assert_eq((reused.0, reused.1), (1, 0))
  checked_module_cache_reset_in_namespace(namespace = other, checked_error_row = false)
  assert(checked_module_artifact_stmts_with_policy(path = path, source = source, namespace = namespace, policy = on, checked_error_row = false) is None)
  Fs::remove(key)
  set_checked_module_cache_mode("off", checked_error_row = false)
}

test "verify refuses a valid mismatch but repairs malformed entries and leaves canonical bytes untouched" {
  let path = "/tmp/checked-policy-verify-\{Profiler::now_us()}.vibe"
  let source = "export let value = 42"
  let namespace = target_cfg_namespace(target_cfg_from_csv("checked-policy-verify"))
  let artifact = checked_policy_fixture(path = path, source = source, namespace = namespace)
  let different = CheckedModuleArtifact::{
    input_identity: artifact.input_identity,
    parsed_stmts: [],
    checked_program: artifact.checked_program,
    lowering_offsets: artifact.lowering_offsets,
    eq_offsets: artifact.eq_offsets,
    eq_keys: artifact.eq_keys
  }
  let key = checked_policy_key(path = path, artifact = artifact, namespace = namespace)
  let verify = checked_module_cache_policy("verify")
  let on = checked_module_cache_policy("on")
  checked_policy_store(path = path, artifact = different, namespace = namespace)
  let previous = Fs::read_bytes(key)
  set_checked_module_cache_mode("on", checked_error_row = false)
  checked_module_cache_reset_in_namespace(namespace = namespace, checked_error_row = false)
  let unchecked = handle {
    commit_checked_module_artifact_with_policy(path = path, source = source, artifact = artifact, fresh = false, namespace = namespace, policy = verify, checked_error_row = false)
    false
  } with { Exception::Throw(message) => message == "recheck the module before committing with verify policy" }
  assert(unchecked)
  let refused = handle {
    commit_checked_module_artifact_with_policy(path = path, source = source, artifact = artifact, fresh = true, namespace = namespace, policy = verify, checked_error_row = false)
    false
  } with { Exception::Throw(message) => message == String::concat("checked module cache verification mismatch: ", path) }
  assert(refused)
  assert(Fs::read_bytes(key) == previous)
  let empty = checked_module_cache_stats()
  assert_eq((empty.0, empty.1, empty.2), (0, 0, 0))
  assert(checked_module_artifact_stmts_with_policy(path = path, source = source, namespace = namespace, policy = on, checked_error_row = false) is None)
  store_persistent_artifact_in_namespace(kind = "checked-module-v1", entry_name = path, fingerprint = checked_module_input_fingerprint(artifact.input_identity), bytes = Bytes::from_array([
    255
  ]), namespace = namespace, checked_error_row = false)
  commit_checked_module_artifact_with_policy(path = path, source = source, artifact = artifact, fresh = true, namespace = namespace, policy = verify, checked_error_row = false)
  match load_checked_module_artifact_with_policy(path = path, input_identity = artifact.input_identity, namespace = namespace, policy = on, checked_error_row = false) {
    Some(loaded) => assert(encode_checked_module_artifact(loaded) == encode_checked_module_artifact(artifact)),
    None => assert(false)
  }
  let token = Fs::stat_token(key)
  commit_checked_module_artifact_with_policy(path = path, source = source, artifact = artifact, fresh = true, namespace = namespace, policy = verify, checked_error_row = false)
  assert_eq(Fs::stat_token(key), token)
  Fs::write_bytes(key, bytes = Bytes::from_array([255]))
  commit_checked_module_artifact_with_policy(path = path, source = source, artifact = artifact, fresh = true, namespace = namespace, policy = verify, checked_error_row = false)
  assert(load_checked_module_artifact_with_policy(path = path, input_identity = artifact.input_identity, namespace = namespace, policy = on, checked_error_row = false) is Some(_))
  Fs::remove(key)
  set_checked_module_cache_mode("off", checked_error_row = false)
}

test "configured requests capture once across nested requests and legacy setting changes" {
  let path = "/tmp/checked-policy-nested-\{Profiler::now_us()}.vibe"
  let source = "export let value = 42"
  let namespace = target_cfg_namespace(target_cfg_from_csv("checked-policy-nested"))
  let artifact = checked_policy_fixture(path = path, source = source, namespace = namespace)
  let key = checked_policy_key(path = path, artifact = artifact, namespace = namespace)
  checked_policy_store(path = path, artifact = artifact, namespace = namespace)
  let counts = [0, 0, 0]
  assert(handle {
    checked_policy_load_only(path = path, identity = artifact.input_identity, namespace = namespace)
  } with { CheckedModuleCacheConfig::Mode() => {
    Array::set(counts, at = 0, value = Array::get(counts, at = 0) + 1)
    assert(!handle {
      checked_policy_load_only(path = path, identity = artifact.input_identity, namespace = namespace)
    } with { CheckedModuleCacheConfig::Mode() => resume("off") })
    set_checked_module_cache_mode("off", checked_error_row = false)
    resume("on")
  } })
  checked_module_cache_reset_in_namespace(namespace = namespace, checked_error_row = false)
  handle {
    commit_checked_module_artifact_configured(path = path, source = source, artifact = artifact, fresh = true, namespace = namespace, checked_error_row = false)
  } with { CheckedModuleCacheConfig::Mode() => {
    Array::set(counts, at = 1, value = Array::get(counts, at = 1) + 1)
    let refused = handle {
      handle {
        let _ = checked_policy_load_only(path = path, identity = artifact.input_identity, namespace = namespace)
        throw("nested refusal")
      } with { CheckedModuleCacheConfig::Mode() => resume("verify") }
      false
    } with { Exception::Throw(message) => message == "nested refusal" }
    assert(refused)
    resume("verify")
  } }
  assert_eq(handle {
    checked_policy_handoff_only(path = path, source = source, namespace = namespace)
  } with { CheckedModuleCacheConfig::Mode() => {
    Array::set(counts, at = 2, value = Array::get(counts, at = 2) + 1)
    assert_eq(handle {
      checked_policy_handoff_only(path = path, source = source, namespace = namespace)
    } with { CheckedModuleCacheConfig::Mode() => resume("off") }, -1)
    resume("on")
  } }, 1)
  assert_eq(Array::get(counts, at = 0), 1)
  assert_eq(Array::get(counts, at = 1), 1)
  assert_eq(Array::get(counts, at = 2), 1)
  Fs::remove(key)
  set_checked_module_cache_mode("off", checked_error_row = false)
}

test "legacy low-level APIs preserve unconditional publication and lookup with mode off" {
  let path = "/tmp/checked-policy-legacy-\{Profiler::now_us()}.vibe"
  let source = "export let value = 42"
  let namespace = target_cfg_namespace(target_cfg_from_csv("checked-policy-legacy"))
  let artifact = checked_policy_fixture(path = path, source = source, namespace = namespace)
  let key = checked_policy_key(path = path, artifact = artifact, namespace = namespace)
  set_checked_module_cache_mode("off", checked_error_row = false)
  checked_module_cache_reset_in_namespace(namespace = namespace, checked_error_row = false)
  commit_checked_module_artifact_in_namespace(path = path, source = source, artifact = artifact, fresh = true, namespace = namespace, checked_error_row = false)
  assert(Fs::exists(key))
  assert(load_checked_module_artifact_in_namespace(path = path, input_identity = artifact.input_identity, namespace = namespace, checked_error_row = false) is Some(_))
  assert(checked_module_artifact_stmts_in_namespace(path = path, source = source, namespace = namespace, checked_error_row = false) is None)
  let stats = checked_module_cache_stats()
  assert_eq((stats.0, stats.1, stats.2), (0, 1, 0))
  Fs::remove(key)
  set_checked_module_cache_mode("off", checked_error_row = false)
}
