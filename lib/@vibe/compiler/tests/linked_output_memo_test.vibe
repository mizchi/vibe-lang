//# #2825: the linked-output memo replays a compiled module only for the
//# identical input identity, and `verify` is the oracle that catches a
//# replay that is not what a fresh compile answers.
//#
//# Every row compiles a real two-file program through the production lane
//# (`compile_file_fs_mode_rc_grants_memo`) and compares against the same lane
//# with the memo off, so a passing row is about the bytes a user would run,
//# not about the memo's own bookkeeping.

import @vibe/compiler/entry/compiler/file_compile {
  compile_file_fs_mode_rc_grants_memo,
  linked_output_memo_env_names,
  linked_output_memo_identity,
  linked_output_memo_lookup,
  linked_output_memo_mode,
  linked_output_memo_store
}

import @vibe/compiler/loader {
  collect_source_groups_fs
}

//# Helpers

fn lom_bytes(_ s: String) -> Bytes {
  let out = Bytes::new()
  let mut i = 0
  while i < String::length(s) {
    Bytes::push(out, value = String::byte_at(s, at = i))
    i = i + 1
  }
  out
}

fn lom_bytes_eq(a: Bytes, b: Bytes) -> Bool {
  let n = Bytes::length(a)
  if n != Bytes::length(b) {
    false
  } else {
    let mut i = 0
    let mut same = true
    while same && i < n {
      if Bytes::get(a, at = i) != Bytes::get(b, at = i) {
        same = false
      } else {
        i = i + 1
      }
    }
    same
  }
}

let lom_leaf_path: String = "/tmp/vibe_linked_output_memo_leaf.vibe"

let lom_main_path: String = "/tmp/vibe_linked_output_memo_main.vibe"

fn lom_leaf(_ k: Int) -> String {
  "export fn leaf_value(x: Int) -> Int {\n  x + \{k}\n}\n"
}

fn lom_main() -> String {
  "import ./vibe_linked_output_memo_leaf.vibe {\n  leaf_value\n}\n\nfn main() -> Int {\n  leaf_value(x = 41)\n}\n"
}

fn lom_write(_ k: Int) -> Unit with Fs {
  Fs::write_bytes(lom_leaf_path, bytes = lom_bytes(lom_leaf(k)))
  Fs::write_bytes(lom_main_path, bytes = lom_bytes(lom_main()))
}

fn lom_identity(_ grants: Array[(String, String)]) -> String with Env + Exception + Fs {
  linked_output_memo_identity(lane = "rc", entry_path = lom_main_path, entry_name = "main", grants = grants, source_groups = collect_source_groups_fs(lom_main_path, checked_error_row = false), exports_stripped = false)
}

fn lom_compile(_ mode: String) -> Bytes with Env + Exception + Fs {
  compile_file_fs_mode_rc_grants_memo(entry_path = lom_main_path, entry_name = "main", grants = [
  ], memo_mode = mode, exports_stripped = false, checked_error_row = false)
}

//# Tests

test "#2825: an identical rebuild replays the stored module, byte for byte" {
  lom_write(1)
  let fresh = lom_compile("off")
  let stored = lom_compile("on")
  assert(lom_bytes_eq(a = stored, b = fresh))
  // The slot now answers for this identity...
  assert(linked_output_memo_lookup(lane = "rc", entry_path = lom_main_path, entry_name = "main", identity = lom_identity([
  ]), checked_error_row = false) is Some(_))
  // ...and the rebuild returns those bytes.
  assert(lom_bytes_eq(a = lom_compile("on"), b = fresh))
}

test "#2825: an edited dependency misses and compiles what a fresh compile does" {
  lom_write(1)
  let _ = lom_compile("on")
  let before = lom_identity([])
  lom_write(2)
  let after = lom_identity([])
  assert(before != after)
  assert(linked_output_memo_lookup(lane = "rc", entry_path = lom_main_path, entry_name = "main", identity = after, checked_error_row = false) is None)
  let fresh = lom_compile("off")
  assert(lom_bytes_eq(a = lom_compile("on"), b = fresh))
  // The edit is in the module, not only in the identity.
  lom_write(1)
  assert(!lom_bytes_eq(a = lom_compile("off"), b = fresh))
}

test "#2825: grants, entry and lane are part of the identity" {
  lom_write(1)
  let groups = collect_source_groups_fs(lom_main_path, checked_error_row = false)
  let base = linked_output_memo_identity(lane = "rc", entry_path = lom_main_path, entry_name = "main", grants = [
  ], source_groups = groups, exports_stripped = false)
  assert(base != linked_output_memo_identity(lane = "rc", entry_path = lom_main_path, entry_name = "main", grants = [
    ("Fs", "Granted")
  ], source_groups = groups, exports_stripped = false))
  assert(base != linked_output_memo_identity(lane = "rc", entry_path = lom_main_path, entry_name = "run", grants = [
  ], source_groups = groups, exports_stripped = false))
  assert(base != linked_output_memo_identity(lane = "rc-body-cached", entry_path = lom_main_path, entry_name = "main", grants = [
  ], source_groups = groups, exports_stripped = false))
  // Length-prefixed fields: moving a separator between two values is a
  // different identity, not the same text.
  let split_a = linked_output_memo_identity(lane = "rc", entry_path = lom_main_path, entry_name = "main", grants = [
    ("a\ngrant b", "c")
  ], source_groups = groups, exports_stripped = false)
  let split_b = linked_output_memo_identity(lane = "rc", entry_path = lom_main_path, entry_name = "main", grants = [
    ("a", "b\ngrant c")
  ], source_groups = groups, exports_stripped = false)
  assert(split_a != split_b)
}

test "#2825: every keyed variable is in the identity" {
  lom_write(1)
  let identity = lom_identity([])
  let names = linked_output_memo_env_names()
  let mut i = 0
  while i < Array::length(names) {
    let name = Array::get(names, at = i)
    assert(String::contains(identity, needle = "env \{String::length(name)}:\{name}\n"))
    i = i + 1
  }
}

test "#2825: a stored module for another identity of the same length is not replayed" {
  lom_write(1)
  let identity = lom_identity([])
  // Same length, one byte different: only a full comparison rejects it.
  let last = String::length(identity) - 2
  let forged = String::concat(String::substring(identity, start = 0, end = last), String::concat("#", String::substring(identity, start = last + 1, end = String::length(identity))))
  assert(String::length(forged) == String::length(identity))
  linked_output_memo_store(lane = "rc", entry_path = lom_main_path, entry_name = "main", identity = forged, wasm = lom_bytes("not a module"), checked_error_row = false)
  assert(linked_output_memo_lookup(lane = "rc", entry_path = lom_main_path, entry_name = "main", identity = identity, checked_error_row = false) is None)
  let fresh = lom_compile("off")
  assert(lom_bytes_eq(a = lom_compile("on"), b = fresh))
}

test "#2825: verify refuses a stored module that differs from a fresh compile" {
  lom_write(1)
  let identity = lom_identity([])
  linked_output_memo_store(lane = "rc", entry_path = lom_main_path, entry_name = "main", identity = identity, wasm = lom_bytes("not a module"), checked_error_row = false)
  // `on` trusts the identity -- this is the replay the identity licenses...
  assert(lom_bytes_eq(a = lom_compile("on"), b = lom_bytes("not a module")))
  // ...and `verify` is what proves the licence wrong.
  let refused = handle {
    let _ = lom_compile("verify")
    false
  } with { Exception::Throw(msg) => String::contains(msg, needle = "linked-output memo verify") }
  assert(refused)
  // The refusal replaced the slot, so the next default build cannot replay
  // the module verify just rejected.
  assert(lom_bytes_eq(a = lom_compile("on"), b = lom_compile("off")))
  // An honest slot verifies.
  assert(lom_bytes_eq(a = lom_compile("verify"), b = lom_compile("off")))
}

test "#2825: the mode switch defaults per caller and refuses a typo" {
  // The unit runner does not set VIBE_LINKED_OUTPUT_MEMO.
  assert(linked_output_memo_mode("on") == "on")
  assert(linked_output_memo_mode("off") == "off")
}
