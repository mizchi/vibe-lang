//# Imports

import @vibe/json {
  Json, json_as_arr, json_as_bool, json_as_obj, json_as_str, parse
}

import @vibe/core {
  array_empty
}

import @vibe/module {
  dir_of, resolve_path
}

import @vibex/shell {
  split, trim
}

import @vibe/compiler/core {
  Stmt
}

import @vibe/compiler/syntax {
  lex, print_program
}

import ../parser.vibe {
  parse_program, parse_program_preserving
}

import @vibe/compiler/runtime {
  TypeDb, db_new, db_set_source, db_typecheck
}

//# Types

export struct FixtureSpec {
  last: Option[String];
  effects: Option[Array[String]];
  error_contains: Option[String];
  todo: Bool;
  skip: Bool;
  version_refs: Map[String, String];
  symbol_refs: Map[String, String]
}

//# Functions

fn pp(src: String) -> String {
  handle {
    let tokens = lex(src)
    // fn-PRESERVING parse (ADR-0064 #727): round-trip checks must keep `fn`
    // declarations (and their where-contracts) in fn form, like normalize.
    let stmts = parse_program_preserving(tokens)
    print_program(stmts)
  } with { Exception::Throw(msg) => String::concat("ERROR: ", msg) }
}

fn json_get(obj: Map[String, Json], key: String) -> Option[Json] {
  if Map::has_key(obj, key) {
    Some(Map::get(obj, key))
  } else None
}

export fn parse_ok(src: String) -> Bool {
  let output = pp(src)
  if String::length(output) > 6 && output[0: 6] == "ERROR:" {
    false
  } else true
}

fn join_lines(lines: Array[String]) -> String {
  let len = Array::length(lines)
  let rec go: (Int, String) -> String = (i, acc) -> {
    if i >= len {
      acc
    } else {
      let next = Array::get(lines, i)
      let merged = if i == 0 {
        next
      } else {
        String::concat(String::concat(acc, "\n"), next)
      }
      go(i + 1, merged)
    }
  }
  go(0, "")
}

export fn roundtrip_ok(src: String) -> Bool {
  let output1 = pp(src)
  if String::length(output1) > 6 && output1[0: 6] == "ERROR:" {
    false
  } else {
    let output2 = pp(output1)
    output1 == output2
  }
}

fn seed_type_db(sources: Array[(String, String)]) -> TypeDb {
  let mut db = db_new()
  let mut i = 0
  while i < Array::length(sources) {
    let (path, source) = Array::get(sources, i)
    db = db_set_source(db, path, source)
    i = i + 1
  }
  db
}

fn sort_strings(items: Array[String]) -> Unit {
  let len = Array::length(items)
  if len < 2 {
    ()
  } else {
    let mut i = 0
    while i + 1 < len {
      let mut min_index = i
      let mut j = i + 1
      while j < len {
        let left = Array::get(items, j)
        let right = Array::get(items, min_index)
        if left < right {
          min_index = j
        }
        j = j + 1
      }
      if min_index != i {
        let tmp = Array::get(items, i)
        Array::set(items, i, Array::get(items, min_index))
        Array::set(items, min_index, tmp)
      }
      i = i + 1
    }
  }
}

fn empty_strings() -> Array[String] {
  array_empty()
}

fn split_fixture(source: String, path: String) -> (String, String) with Exception {
  let lines = split(source, "\n")
  let script_lines = ArrayBuilder::new()
  let data_lines = ArrayBuilder::new()
  let mut in_data = false
  let mut i = 0
  while i < Array::length(lines) {
    let line = Array::get(lines, i)
    if trim(line) == "__DATA__" {
      in_data = true
    } else if in_data {
      ArrayBuilder::push(data_lines, line)
    } else {
      ArrayBuilder::push(script_lines, line)
    }
    i = i + 1
  }
  if in_data {
    (join_lines(ArrayBuilder::freeze(script_lines)), join_lines(ArrayBuilder::freeze(data_lines)))
  } else {
    throw(String::concat(String::concat("[", path), "] missing __DATA__ section"))
  }
}

fn import_ref_name(raw_path: String, prefix: String) -> Option[String] {
  let prefix_len = String::length(prefix)
  let raw_len = String::length(raw_path)
  if raw_len >= prefix_len && raw_path[0: prefix_len] == prefix {
    Some(raw_path[prefix_len: raw_len])
  } else None
}

// #1324 slice 3: the five `json_expect_*` / `parse_json_root` wrappers that
// used to live here were each exactly
// `match json_as_X(j) { Ok(v) => v, Err(m) => throw(m) }` -- hand-rolled
// re-throws of a failure @vibe/json now throws itself. Call sites use
// `json_as_*` / `parse` directly.

fn json_bool_field(obj: Map[String, Json], key: String) -> Bool with Exception {
  match json_get(obj, key) {
    Some(JNull) => false,
    Some(json) => json_as_bool(json),
    None => false
  }
}

fn empty_string_map() -> Map[String, String] {
  let b = MapBuilder::new()
  MapBuilder::freeze(b)
}

fn json_string_field(obj: Map[String, Json], key: String, _path: String) -> Option[String] with Exception {
  match json_get(obj, key) {
    Some(JNull) => None,
    Some(json) => Some(json_as_str(json)),
    None => None
  }
}

fn empty_string_pairs() -> Array[(String, String)] {
  array_empty()
}

fn append_import_paths(stmts: Array[Stmt], acc: Array[String]) -> Array[String] {
  let mut out = acc
  let mut i = 0
  while i < Array::length(stmts) {
    out = match Array::get(stmts, i) {
      SImport(raw_path, _) => Array::concat(out, [raw_path]),
      SReExport(raw_path, _) => Array::concat(out, [raw_path]),
      SModule(_, _, body) => append_import_paths(body, out),
      _ => out
    }
    i = i + 1
  }
  out
}

fn json_string_map_field(obj: Map[String, Json], key: String) -> Map[String, String] with Exception {
  match json_get(obj, key) {
    Some(JNull) => empty_string_map(),
    Some(json) => {
      let raw = json_as_obj(json)
      let out = MapBuilder::new()
      let keys = Map::keys(raw)
      let mut i = 0
      while i < Array::length(keys) {
        let name = Array::get(keys, i)
        MapBuilder::set(out, name, json_as_str(Map::get(raw, name)))
        i = i + 1
      }
      MapBuilder::freeze(out)
    },
    None => empty_string_map()
  }
}

fn source_pairs_has_path(pairs: Array[(String, String)], path: String) -> Bool {
  let rec go: (Int) -> Bool = (i) -> {
    if i >= Array::length(pairs) {
      false
    } else {
      let (p, _) = Array::get(pairs, i)
      if p == path {
        true
      } else {
        go(i + 1)
      }
    }
  }
  go(0)
}

/// #768/#778: was missing its `with Fs` effect annotation entirely
/// (checker error: "use of undeclared effect"), and used `perform Fs::IsFile`
/// -- switched to the direct-call form like every other working Fs call
/// site (perform/effect-op codegen for magic host effects can crash with no
/// handler installed, see #778).
fn resolve_import_fs_path(from_path: String, raw_path: String) -> Option[String] with Fs {
  let raw_index = String::concat(raw_path, "/index.vibe")
  if Fs::is_file(raw_path) {
    Some(raw_path)
  } else if Fs::is_file(raw_index) {
    Some(raw_index)
  } else {
    let resolved = resolve_path(dir_of(from_path), raw_path)
    let resolved_index = String::concat(resolved, "/index.vibe")
    if Fs::is_file(resolved) {
      Some(resolved)
    } else if Fs::is_file(resolved_index) {
      Some(resolved_index)
    } else {
      let len = String::length(raw_path)
      let root_raw = if len >= 2 && raw_path[0: 2] == "./" {
        raw_path[2: len]
      } else {
        raw_path
      }
      let root_index = String::concat(root_raw, "/index.vibe")
      if Fs::is_file(root_raw) {
        Some(root_raw)
      } else if Fs::is_file(root_index) {
        Some(root_index)
      } else None
    }
  }
}

fn json_string_array_field(obj: Map[String, Json], key: String) -> Option[Array[String]] with Exception {
  match json_get(obj, key) {
    Some(JNull) => None,
    Some(json) => {
      let items = json_as_arr(json)
      let out = ArrayBuilder::new()
      let mut i = 0
      while i < Array::length(items) {
        ArrayBuilder::push(out, json_as_str(Array::get(items, i)))
        i = i + 1
      }
      Some(ArrayBuilder::freeze(out))
    },
    None => None
  }
}

export fn parse_fixture_spec(data: String, path: String) -> FixtureSpec with Exception {
  let (root, _) = parse(data)
  let obj = json_as_obj(root)
  let error_contains = match json_string_field(obj, "error_contains", path) {
    Some(value) => Some(value),
    None => json_string_field(obj, "compile_error", path)
  }
  FixtureSpec::{
    last: json_string_field(obj, "last", path),
    effects: json_string_array_field(obj, "effects"),
    error_contains: error_contains,
    todo: json_bool_field(obj, "todo") || json_bool_field(obj, "TODO"),
    skip: json_bool_field(obj, "skip"),
    version_refs: json_string_map_field(obj, "version_refs"),
    symbol_refs: json_string_map_field(obj, "symbol_refs")
  }
}

fn resolve_ref_import_path(current_path: String, raw_path: String, spec: FixtureSpec) -> String with Exception + Fs {
  match import_ref_name(raw_path, "version@") {
    Some(name) => if Map::has_key(spec.version_refs, name) {
      let target = Map::get(spec.version_refs, name)
      match resolve_import_fs_path(current_path, target) {
        Some(path) => path,
        None => throw(String::concat("unresolved version ref target: ", target))
      }
    } else {
      throw(String::concat("missing version ref: ", name))
    },
    None => match import_ref_name(raw_path, "symbol@") {
      Some(name) => if Map::has_key(spec.symbol_refs, name) {
        let target = Map::get(spec.symbol_refs, name)
        match resolve_import_fs_path(current_path, target) {
          Some(path) => path,
          None => throw(String::concat("unresolved symbol ref target: ", target))
        }
      } else {
        throw(String::concat("missing symbol ref: ", name))
      },
      None => raw_path
    }
  }
}

fn rewrite_ref_stmts(stmts: Array[Stmt], current_path: String, spec: FixtureSpec) -> Array[Stmt] with Exception + Fs {
  let out = ArrayBuilder::new()
  let mut i = 0
  while i < Array::length(stmts) {
    let next = match Array::get(stmts, i) {
      SImport(raw_path, names) => SImport(resolve_ref_import_path(current_path, raw_path, spec), names),
      SReExport(raw_path, names) => SReExport(resolve_ref_import_path(current_path, raw_path, spec), names),
      SModule(exported, name, body) => SModule(exported, name, rewrite_ref_stmts(body, current_path, spec)),
      stmt => stmt
    }
    ArrayBuilder::push(out, next)
    i = i + 1
  }
  ArrayBuilder::freeze(out)
}

fn rewrite_ref_import_line(line: String, current_path: String, spec: FixtureSpec) -> String with Exception + Fs {
  let version_idx = String::index_of(line, "version@")
  let symbol_idx = String::index_of(line, "symbol@")
  let marker_idx = if version_idx >= 0 {
    version_idx
  } else {
    symbol_idx
  }
  if marker_idx < 0 {
    line
  } else {
    let marker = if version_idx >= 0 {
      "version@"
    } else {
      "symbol@"
    }
    let marker_len = String::length(marker)
    let rest = line[marker_idx + marker_len: String::length(line)]
    let brace_idx = String::index_of(rest, "{")
    if brace_idx < 0 {
      line
    } else {
      let ref_name = trim(rest[0: brace_idx])
      let raw_path = String::concat(marker, ref_name)
      let resolved = resolve_ref_import_path(current_path, raw_path, spec)
      let before = line[0: marker_idx]
      let after = rest[brace_idx: String::length(rest)]
      String::concat(before, String::concat(resolved, after))
    }
  }
}

fn rewrite_ref_imports_in_source(source: String, current_path: String, spec: FixtureSpec) -> String with Exception + Fs {
  let lines = split(source, "\n")
  let out = ArrayBuilder::new()
  let mut i = 0
  while i < Array::length(lines) {
    ArrayBuilder::push(out, rewrite_ref_import_line(Array::get(lines, i), current_path, spec))
    i = i + 1
  }
  join_lines(ArrayBuilder::freeze(out))
}

fn strip_fixture_data_if_present(source: String) -> String {
  let lines = split(source, "\n")
  let script_lines = ArrayBuilder::new()
  let mut i = 0
  let mut in_data = false
  while i < Array::length(lines) {
    let line = Array::get(lines, i)
    if trim(line) == "__DATA__" {
      in_data = true
    } else if not(in_data) {
      ArrayBuilder::push(script_lines, line)
    }
    i = i + 1
  }
  if in_data {
    join_lines(ArrayBuilder::freeze(script_lines))
  } else {
    source
  }
}

fn rewrite_fixture_source(path: String, source: String, spec: FixtureSpec) -> String with Exception + Fs {
  let source1 = rewrite_ref_imports_in_source(strip_fixture_data_if_present(source), path, spec)
  let stmts = parse_program(lex(source1))
  let rewritten = rewrite_ref_stmts(stmts, path, spec)
  print_program(rewritten)
}

fn load_fixture_sources(path: String, spec: FixtureSpec, loaded: Array[(String, String)]) -> Array[(String, String)] with Exception + Fs {
  if source_pairs_has_path(loaded, path) {
    loaded
  } else {
    let source = Fs::read_file(path)
    let rewritten_source = rewrite_fixture_source(path, source, spec)
    let next_loaded = Array::concat(loaded, [(path, rewritten_source)])
    let stmts = parse_program(lex(rewritten_source))
    let import_paths = append_import_paths(stmts, empty_strings())
    let mut out = next_loaded
    let mut i = 0
    while i < Array::length(import_paths) {
      match resolve_import_fs_path(path, Array::get(import_paths, i)) {
        Some(dep_path) => {
          out = load_fixture_sources(dep_path, spec, out)
        },
        None => ()
      }
      i = i + 1
    }
    out
  }
}

fn load_real_fixture_sources(path: String) -> Array[(String, String)] with Fs + Exception {
  let source = Fs::read_file(path)
  let (_script, data) = split_fixture(source, path)
  let spec = parse_fixture_spec(data, path)
  load_fixture_sources(path, spec, empty_string_pairs())
}

fn rewrite_real_fixture_source(path: String) -> String with Fs + Exception {
  let source = Fs::read_file(path)
  let (_script, data) = split_fixture(source, path)
  let spec = parse_fixture_spec(data, path)
  rewrite_fixture_source(path, source, spec)
}

fn typecheck_real_fixture(path: String) -> Unit with Fs + Exception {
  let sources = load_real_fixture_sources(path)
  let _checked = db_typecheck(seed_type_db(sources), path)
  ()
}
