//# Imports

// #897 (ADR-0070 Phase 1): the directory-shared half of `index.vpkg`'s two
// import forms. `import @user/mod as mod only { x, y }` (PR #908/#909) stays
// namespaced (`mod.x` only, never shared). The UNQUALIFIED form,
// `import @user/mod { x, y }`, additionally registers `x`/`y` into the
// package DIRECTORY's shared scope: any sibling `.vibe` implementation file
// in the SAME directory as the `.vpkg` can use them without writing its own
// import line. This file covers the loader/checker-internal side of that at
// the API level (mirrors ./contract_vpkg_test.vibe's style): the end-to-end
// "it actually runs" happy path (incl. the shadowing precedence, checked by
// VALUE, not just by compile success) is covered separately by
// fixtures/contract_pkg_vpkg_shared_scope_test.vibe (run via `vibe test`,
// i.e. the same incremental lane exercised here).
//
// Both compile lanes are exercised directly, since the mechanism (a
// parse-time text-ingestion prepend in loader/index.vibe's
// `ingest_source_text_fs` / `collect_sources_rec`) is shared, but a gap in
// either lane's OWN reliance on that ingested text would silently only
// break one of `vibe build` vs `vibe test`/`vibe run` (#897 comments'
// documented precedent for this feature area):
//   - `compile_file_wasi_only` (entry/source_compile/wasi_only/merge_sources.vibe)
//     is the whole-program MERGE lane (`collect_merged_stmts_recursive` +
//     a single `check_program` over the fully-merged statement list) --
//     the same lane `scripts/generate_bundle.sh`'s bootstrap self-build uses.
//     Its `entry_name` must name a ZERO-ARG function/value (the WASI entry
//     point), so each fixture below adds a trivial 0-arg wrapper for it.
//   - `compile_file_fs_mode_rc` (entry/compiler/file_compile) is
//     the INCREMENTAL per-file lane `vibe test`/`vibe run` actually drive
//     (confirmed by tracing `scripts/vibe_test.sh`'s `cli_main` call down to
//     this exact function) -- `db_typecheck_fs`'s per-file env threading via
//     `collect_source_groups_fs`.
//
// Shadow-test arity note: the merge lane's shadow case below deliberately
// uses a DIFFERENT arity for the sibling's own local `seed` than
// `@vibe/random`'s (1 vs 2) so a wrong-binding-wins regression is a hard
// compile error, not a subtle wrong-value bug. The incremental lane's
// shadow case below deliberately does NOT do this -- `check_program_with_env`
// (checker/checker_stmt.vibe), the seeded-env entry point this lane's
// per-file typecheck uses, wraps its seed environment in `EnvCached`
// (core/types.vibe): `env_lookup`'s `EnvCached` arm returns the FROZEN
// cache's answer immediately whenever the name is present there, without
// ever consulting the fresher bindings threaded alongside it, so a same-
// named LOCAL declared later in the file cannot un-stick an inherited
// import's type for arity-checking purposes even though codegen (a
// separate, later mechanism -- see the #909 commit's "local bindings must
// win over func_table matches" fix in compile_call.vibe) still calls the
// right (local) definition. This reproduces identically for an ORDINARY
// hand-written `import @vibe/random { seed }` + a local `fn seed` of a
// DIFFERENT arity in the same file -- it is a pre-existing checker
// limitation orthogonal to #897, not something this feature introduces or
// need fix, so the incremental-lane case here uses a SAME-arity shadow
// (avoiding the false arity error) and the fixture test covers the
// stronger by-VALUE proof for this lane instead.

import @vibe/compiler/entry/source_compile/wasi_only {
  compile_file_wasi_only
}

import @vibe/core {
  array_empty
}

import @vibe/compiler/entry/compiler/file_compile {
  compile_file_fs_mode_rc
}

//# Functions

fn string_to_bytes(s: String) -> Bytes {
  let out = array_empty()
  let len = String::length(s)
  let mut i = 0
  while i < len {
    Array::push(out, String::char_code_at(s, i))
    i = i + 1
  }
  Bytes::from_array(out)
}

fn assert_wasm_magic(bytes: Bytes) -> Unit {
  assert(Bytes::get(bytes, 0) == 0)
  assert(Bytes::get(bytes, 1) == 97)
  assert(Bytes::get(bytes, 2) == 115)
  assert(Bytes::get(bytes, 3) == 109)
}

fn write_file(path: String, text: String) -> Unit with Fs {
  Fs::write_bytes(path, string_to_bytes(text))
}

//# Misc

/// #897 positive case: `impl.vibe` calls `seed` (from `@vibe/random`) with NO
/// import of its own -- only `index.vpkg`'s unqualified
/// `import @vibe/random { seed }` provides it, shared across the directory.
test "vpkg directory-shared import: merge lane resolves the inherited name (#897)" {
  let base_dir = "/tmp/vibe_compiler_vpkg_shared_scope_pos_897/pkg"
  Fs::mkdir_p(base_dir)
  let contract_path = String::concat(base_dir, "/index.vpkg")
  let impl_path = String::concat(base_dir, "/impl.vibe")
  write_file(contract_path, "import @vibe/random { seed }\n\nfn wrapped_seed(x: Int) -> Int\nfn entry_pos() -> Int\n")
  write_file(impl_path, "export fn wrapped_seed(x: Int) -> Int {\n  seed(x)\n}\n\nexport fn entry_pos() -> Int {\n  wrapped_seed(42)\n}\n")
  let bytes = compile_file_wasi_only(contract_path, "entry_pos")
  assert_wasm_magic(bytes)
}

test "vpkg directory-shared import: incremental fs_compile lane resolves the inherited name (#897)" {
  let base_dir = "/tmp/vibe_compiler_vpkg_shared_scope_pos_897/pkg"
  Fs::mkdir_p(base_dir)
  let contract_path = String::concat(base_dir, "/index.vpkg")
  let impl_path = String::concat(base_dir, "/impl.vibe")
  write_file(contract_path, "import @vibe/random { seed }\n\nfn wrapped_seed(x: Int) -> Int\nfn entry_pos() -> Int\n")
  write_file(impl_path, "export fn wrapped_seed(x: Int) -> Int {\n  seed(x)\n}\n\nexport fn entry_pos() -> Int {\n  wrapped_seed(42)\n}\n")
  let bytes = compile_file_fs_mode_rc(contract_path, "entry_pos")
  assert_wasm_magic(bytes)
}

/// The normal package scan excludes test/bench companions, but an explicitly
/// compiled companion still runs in the nearest enclosing vpkg's scope. It may
/// use both package-private production modules and dependency names declared by
/// that vpkg without becoming part of the package hash/build roots.
test "vpkg shared import: explicit test companion inherits nearest package scope" {
  let base_dir = "/tmp/vibe_compiler_vpkg_shared_scope_test_companion/pkg"
  Fs::mkdir_p(base_dir)
  let contract_path = String::concat(base_dir, "/index.vpkg")
  let impl_path = String::concat(base_dir, "/impl.vibe")
  let test_path = String::concat(base_dir, "/impl_test.vibe")
  write_file(contract_path, "import @vibe/random { seed }\n\nfn package_value(x: Int) -> Int\n")
  write_file(impl_path, "export fn package_value(x: Int) -> Int { x + 1 }\n")
  write_file(test_path, "import ./impl.vibe { package_value }\n\nexport fn test_companion_entry() -> Int {\n  package_value(seed(41))\n}\n")
  let bytes = compile_file_fs_mode_rc(test_path, "test_companion_entry")
  assert_wasm_magic(bytes)
}

test "vpkg shared import: explicit bench companion inherits nearest package scope" {
  let base_dir = "/tmp/vibe_compiler_vpkg_shared_scope_bench_companion/pkg"
  Fs::mkdir_p(base_dir)
  let contract_path = String::concat(base_dir, "/index.vpkg")
  let impl_path = String::concat(base_dir, "/impl.vibe")
  let bench_path = String::concat(base_dir, "/impl_bench.vibe")
  write_file(contract_path, "import @vibe/random { seed }\n\nfn package_value(x: Int) -> Int\n")
  write_file(impl_path, "export fn package_value(x: Int) -> Int { x + 1 }\n")
  write_file(bench_path, "import ./impl.vibe { package_value }\n\nexport fn bench_companion_entry() -> Int {\n  package_value(seed(41))\n}\n")
  let bytes = compile_file_fs_mode_rc(bench_path, "bench_companion_entry")
  assert_wasm_magic(bytes)
}

test "vpkg shared import: descendant companion inherits the nearest ancestor package scope" {
  let package_dir = "/tmp/vibe_compiler_vpkg_shared_scope_descendant/pkg"
  let test_dir = String::concat(package_dir, "/sub")
  Fs::mkdir_p(test_dir)
  write_file(String::concat(package_dir, "/index.vpkg"), "import @vibe/random { seed }\n\nfn package_value(x: Int) -> Int\n")
  write_file(String::concat(package_dir, "/impl.vibe"), "export fn package_value(x: Int) -> Int { x + 1 }\n")
  let test_path = String::concat(test_dir, "/descendant_test.vibe")
  write_file(test_path, "import ../impl.vibe { package_value }\n\nexport fn descendant_test_entry() -> Int {\n  package_value(seed(41))\n}\n")
  let bytes = compile_file_fs_mode_rc(test_path, "descendant_test_entry")
  assert_wasm_magic(bytes)
}

/// #897 shadowing case (merge lane): `shadow_impl.vibe` declares its OWN
/// `seed`, with a DIFFERENT arity (2, vs. `@vibe/random`'s 1) than the
/// inherited import -- deliberately so the two are impossible to confuse by
/// accident. Calling `seed(a, b)` (2 args) only type-checks if the sibling's
/// OWN local `seed` won the resolution; if the inherited arity-1 import had
/// incorrectly won instead, this would fail to compile ("function arity
/// mismatch" / too many arguments), so a successful compile IS the assertion.
test "vpkg directory-shared import: sibling's own local shadows the inherited import, merge lane (#897)" {
  let base_dir = "/tmp/vibe_compiler_vpkg_shared_scope_shadow_897/pkg"
  Fs::mkdir_p(base_dir)
  let contract_path = String::concat(base_dir, "/index.vpkg")
  let impl_path = String::concat(base_dir, "/shadow_impl.vibe")
  write_file(contract_path, "import @vibe/random { seed }\n\nfn use_local_seed(a: Int, b: Int) -> Int\nfn entry_shadow() -> Int\n")
  write_file(impl_path, "fn seed(a: Int, b: Int) -> Int { a + b }\n\nexport fn use_local_seed(a: Int, b: Int) -> Int {\n  seed(a, b)\n}\n\nexport fn entry_shadow() -> Int {\n  use_local_seed(1, 2)\n}\n")
  let bytes = compile_file_wasi_only(contract_path, "entry_shadow")
  assert_wasm_magic(bytes)
}

/// #897 shadowing case (incremental lane): same-arity shadow (see the file
/// header comment for why -- a different-arity shadow trips a pre-existing,
/// orthogonal checker limitation in this lane's seeded-env path that also
/// reproduces for an ordinary hand-written import, unrelated to #897). This
/// asserts the compile succeeds; fixtures/contract_pkg_vpkg_shared_scope_test.vibe
/// asserts the STRONGER by-value claim (the local definition's result, not
/// just successful compilation) for this exact lane.
test "vpkg directory-shared import: sibling's own local shadows the inherited import, incremental lane (#897)" {
  let base_dir = "/tmp/vibe_compiler_vpkg_shared_scope_shadow_incr_897/pkg"
  Fs::mkdir_p(base_dir)
  let contract_path = String::concat(base_dir, "/index.vpkg")
  let impl_path = String::concat(base_dir, "/shadow_impl.vibe")
  write_file(contract_path, "import @vibe/random { seed }\n\nfn use_local_seed(a: Int) -> Int\nfn entry_shadow() -> Int\n")
  write_file(impl_path, "fn seed(a: Int) -> Int { a + 1000 }\n\nexport fn use_local_seed(a: Int) -> Int {\n  seed(a)\n}\n\nexport fn entry_shadow() -> Int {\n  use_local_seed(5)\n}\n")
  let bytes = compile_file_fs_mode_rc(contract_path, "entry_shadow")
  assert_wasm_magic(bytes)
}

/// #897 negative case: `outside.vibe` sits ONE DIRECTORY ABOVE the `.vpkg`
/// (`base_dir`, not `base_dir/pkg` where the `.vpkg` actually lives) and
/// never imports `@vibe/random` itself -- the shared scope must not leak
/// upward/sideways out of the vpkg's own exact directory. Compiling it must
/// throw "unknown name", not silently resolve `seed`. `leak_probe` is 0-arg
/// itself, so this is a valid `compile_file_wasi_only` entry name too (the
/// failure being tested is name resolution, not the WASI-entry-arity rule
/// the positive/shadow cases above have to work around).
test "vpkg directory-shared import: a file outside the vpkg's own directory does not inherit it, merge lane (#897)" {
  let base_dir = "/tmp/vibe_compiler_vpkg_shared_scope_leak_897"
  let pkg_dir = String::concat(base_dir, "/pkg")
  Fs::mkdir_p(pkg_dir)
  write_file(String::concat(pkg_dir, "/index.vpkg"), "import @vibe/random { seed }\n\nfn noop(x: Int) -> Int\n")
  write_file(String::concat(pkg_dir, "/impl.vibe"), "export fn noop(x: Int) -> Int {\n  seed(x)\n}\n")
  let outside_path = String::concat(base_dir, "/outside.vibe")
  write_file(outside_path, "export fn leak_probe() -> Int {\n  seed(1)\n}\n")
  let failed = handle {
    let _ = compile_file_wasi_only(outside_path, "leak_probe")
    false
  } with Exception {
    Throw(msg) => String::contains(msg, "seed")
  }
  assert(failed)
}

test "vpkg directory-shared import: a file outside the vpkg's own directory does not inherit it, incremental lane (#897)" {
  let base_dir = "/tmp/vibe_compiler_vpkg_shared_scope_leak_897"
  let pkg_dir = String::concat(base_dir, "/pkg")
  Fs::mkdir_p(pkg_dir)
  write_file(String::concat(pkg_dir, "/index.vpkg"), "import @vibe/random { seed }\n\nfn noop(x: Int) -> Int\n")
  write_file(String::concat(pkg_dir, "/impl.vibe"), "export fn noop(x: Int) -> Int {\n  seed(x)\n}\n")
  let outside_path = String::concat(base_dir, "/outside.vibe")
  write_file(outside_path, "export fn leak_probe() -> Int {\n  seed(1)\n}\n")
  let failed = handle {
    let _ = compile_file_fs_mode_rc(outside_path, "leak_probe")
    false
  } with Exception {
    Throw(msg) => String::contains(msg, "seed")
  }
  assert(failed)
}
