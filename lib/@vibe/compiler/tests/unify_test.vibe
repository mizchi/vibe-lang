//# Imports

import @vibe/core {
  array_empty
}

import @vibe/compiler/core {
  Subst,
  Type,
  TypeEnv,
  TypeExpr,
  collect_tvars,
  fresh_var,
  generalize,
  instantiate,
  occurs_in,
  resolve_builtin,
  subst_add_bound,
  subst_apply,
  subst_lookup,
  trait_defined,
  trait_is_subtrait,
  trait_supers,
  type_implements_trait,
  types_equal,
  unify
}

//# Functions

let _no_methods: Array[(String, Array[TypeExpr], TypeExpr)] = ArrayBuilder::freeze(ArrayBuilder::new())

let _no_vb = array_empty()

let _no_supers = array_empty()

let _no_type_args = array_empty()

//# Misc

test "unify same types" {
  let result = unify(CtInt, CtInt, SubstEmpty)
  match result {
    Some(_) => assert(true),
    None => assert(false)
  }
}

test "unify var with concrete" {
  let result = unify(CtVar(0), CtInt, SubstEmpty)
  match result {
    Some(s) => match subst_lookup(s, 0) {
      Some(t) => assert(types_equal(t, CtInt)),
      None => assert(false)
    }
    ,
    None => assert(false)
  }
}

test "unify two vars" {
  let result = unify(CtVar(0), CtVar(1), SubstEmpty)
  match result {
    Some(_) => assert(true),
    None => assert(false)
  }
}

test "unify mismatch" {
  let result = unify(CtInt, CtString, SubstEmpty)
  match result {
    Some(_) => assert(false),
    None => assert(true)
  }
}

test "occurs check" {
  let result = unify(CtVar(0), CtArray(CtVar(0)), SubstEmpty)
  match result {
    Some(_) => assert(false),
    None => assert(true)
  }
}

test "subst_apply transitive" {
  let s1 = SubstBind(0, CtVar(1), SubstEmpty)
  let s2 = SubstBind(1, CtInt, s1)
  let result = subst_apply(s2, CtVar(0))
  assert(types_equal(result, CtInt))
}

test "unify CtFn" {
  let a = CtFn([CtVar(0)], CtVar(1), None)
  let b = CtFn([CtInt], CtString, None)
  let result = unify(a, b, SubstEmpty)
  match result {
    Some(s) => {
      assert(types_equal(subst_apply(s, CtVar(0)), CtInt))
      assert(types_equal(subst_apply(s, CtVar(1)), CtString))
    },
    None => assert(false)
  }
}

test "unify CtFn effect variable with concrete effect" {
  let a = CtFn([CtInt], CtInt, Some("e"))
  let b = CtFn([CtInt], CtInt, Some("Error"))
  match unify(a, b, SubstEmpty) {
    Some(_) => assert(true),
    None => assert(false)
  }
}

test "unify CtFn effect variable with pure function" {
  let a = CtFn([CtInt], CtInt, Some("e"))
  let b = CtFn([CtInt], CtInt, None)
  match unify(a, b, SubstEmpty) {
    Some(_) => assert(true),
    None => assert(false)
  }
}

test "unify with CtUnknown" {
  let r1 = unify(CtInt, CtUnknown, SubstEmpty)
  match r1 {
    Some(_) => assert(true),
    None => assert(false)
  }
  let r2 = unify(CtUnknown, CtString, SubstEmpty)
  match r2 {
    Some(_) => assert(true),
    None => assert(false)
  }
}

test "generalize with free vars" {
  let ty = CtFn([CtVar(0)], CtVar(0), None)
  let result = generalize(SubstEmpty, ty)
  match result {
    CtForAll(vars, _, _) => assert(eq(Array::length(vars), 1)),
    _ => assert(false)
  }
}

test "generalize no free vars" {
  let ty = CtFn([CtInt], CtInt, None)
  let result = generalize(SubstEmpty, ty)
  match result {
    CtForAll(_, _, _) => assert(false),
    CtFn(_, _, _) => assert(true),
    _ => assert(false)
  }
}

test "instantiate forall" {
  let ty = CtForAll([0], _no_vb, CtFn([CtVar(0)], CtVar(0), None))
  let (result, c1, _) = instantiate(ty, 10)
  match result {
    CtFn(params, ret, _) => {
      assert(types_equal(Array::get(params, 0), ret))
      assert(eq(c1, 11))
    },
    _ => assert(false)
  }
}

test "instantiate non-forall" {
  let (result, c1, _) = instantiate(CtInt, 5)
  assert(types_equal(result, CtInt))
  assert(eq(c1, 5))
}

test "trait_defined lookup" {
  let env = EnvTraitDef("Show", _no_supers, false, _no_methods, EnvEmpty, array_empty(), array_empty())
  assert(trait_defined(env, "Show"))
  assert(not(trait_defined(env, "Eq")))
}

test "resolve_builtin keeps i64 as named primitive" {
  match resolve_builtin("i64") {
    Some(ty) => assert(types_equal(ty, CtNamed("i64", _no_type_args))),
    None => assert(false)
  }
}

test "resolve_builtin keeps u32 as named primitive" {
  match resolve_builtin("u32") {
    Some(ty) => assert(types_equal(ty, CtNamed("u32", _no_type_args))),
    None => assert(false)
  }
}

test "trait_supers" {
  let env = EnvTraitDef("Ord", ["Eq", "PartialOrd"], false, _no_methods, EnvEmpty, array_empty(), array_empty())
  let supers = trait_supers(env, "Ord")
  assert(eq(Array::length(supers), 2))
  assert(Array::get(supers, 0) == "Eq")
  assert(Array::get(supers, 1) == "PartialOrd")
}

test "type_implements_trait concrete" {
  let env = EnvTraitImpl("Show", CtInt, EnvTraitDef("Show", _no_supers, false, _no_methods, EnvEmpty, array_empty(), array_empty()))
  assert(type_implements_trait(env, SubstEmpty, CtInt, "Show"))
}

test "type_implements_trait miss" {
  let env = EnvTraitDef("Show", _no_supers, false, _no_methods, EnvEmpty, array_empty(), array_empty())
  assert(not(type_implements_trait(env, SubstEmpty, CtInt, "Show")))
}

test "trait_is_subtrait" {
  // C: B, B: A
  let env = EnvTraitDef("C", ["B"], false, _no_methods, EnvTraitDef("B", ["A"], false, _no_methods, EnvTraitDef("A", _no_supers, false, _no_methods, EnvEmpty, array_empty(), array_empty()), array_empty(), array_empty()), array_empty(), array_empty())
  assert(trait_is_subtrait(env, "C", "A"))
  assert(trait_is_subtrait(env, "B", "A"))
  assert(not(trait_is_subtrait(env, "A", "C")))
}

test "generalize with bounds" {
  let ty = CtFn([CtVar(0)], CtVar(0), None)
  let s = subst_add_bound(SubstEmpty, 0, ["Show"])
  let result = generalize(s, ty)
  match result {
    CtForAll(vars, var_bounds, _) => {
      assert(eq(Array::length(vars), 1))
      assert(eq(Array::length(var_bounds), 1))
      let (vid, bounds) = Array::get(var_bounds, 0)
      assert(eq(vid, 0))
      assert(eq(Array::length(bounds), 1))
      assert(Array::get(bounds, 0) == "Show")
    },
    _ => assert(false)
  }
}

// #626 criterion 4: effect variables actually unify to their binding, instead
// of being an unconditional wildcard.

test "unify binds an effect variable to a concrete effect" {
  let fa = CtFn([CtInt], CtInt, Some("e"))
  let fb = CtFn([CtInt], CtInt, Some("Stdout"))
  // First: `e` unifies with Stdout -> succeeds, recording e := Stdout.
  match unify(fa, fb, SubstEmpty) {
    Some(s) => {
      // Second: with e now bound to Stdout, unifying the same `e`-typed fn with
      // a Stdin variant must FAIL (a wildcard would wrongly accept it).
      let fc = CtFn([CtInt], CtInt, Some("Stdin"))
      match unify(fa, fc, s) {
        Some(_) => assert(false),
        None => assert(true)
      }
    },
    None => assert(false)
  }
}

test "unify resolves a bound effect variable in subst_apply" {
  let fa = CtFn([CtInt], CtInt, Some("e"))
  let fb = CtFn([CtInt], CtInt, Some("Fs"))
  match unify(fa, fb, SubstEmpty) {
    Some(s) => {
      // subst_apply must rewrite the `e` annotation to its binding (Fs).
      match subst_apply(s, fa) {
        CtFn(_, _, eff) => match eff {
          Some(name) => assert(name == "Fs"),
          None => assert(false)
        },
        _ => assert(false)
      }
    },
    None => assert(false)
  }
}

test "unify of two conflicting concrete effects fails" {
  let fa = CtFn([CtInt], CtInt, Some("Fs"))
  let fb = CtFn([CtInt], CtInt, Some("Stdout"))
  match unify(fa, fb, SubstEmpty) {
    Some(_) => assert(false),
    None => assert(true)
  }
}

test "unify of reordered effect sets succeeds" {
  let fa = CtFn([CtInt], CtInt, Some("Stdout, Stdin"))
  let fb = CtFn([CtInt], CtInt, Some("Stdin, Stdout"))
  match unify(fa, fb, SubstEmpty) {
    Some(_) => assert(true),
    None => assert(false)
  }
}
