//# #3941: fixed-width relocatable `call` slots.
//#
//# The slot width is a compile-wide cell; every test that sets it restores 0
//# before it returns, so the cell's default (minimal LEB128, the production
//# encoding) is what any other test in the same instance sees.

//# Imports

import @vibe/compiler/core {
  leb128_encode_s32,
  leb128_encode_s_padded,
  leb128_encode_u32,
  leb128_encode_u32_padded,
  leb128_encode_u32_slot,
  leb128_s_min_width,
  leb128_u32_min_width,
  reloc_slot_width,
  set_reloc_slot_width
}

import @vibe/compiler/codegen/wasm_emit {
  emit_call,
  emit_call_indirect,
  emit_i32_const,
  emit_i32_const_ctor_tag,
  emit_i32_const_slot,
  emit_i64_const,
  emit_if_type_index,
  emit_i64_const_slot,
  emit_i64_const_str
}

//# Functions

fn ints_of(_ b: Bytes) -> Array[Int] {
  let out = []
  let mut i = 0
  while i < Bytes::length(b) {
    Array::push(out, value = Bytes::get(b, at = i))
    i = i + 1
  }
  out
}

fn call_bytes(_ idx: Int) -> Array[Int] {
  let b = Bytes::new()
  emit_call(buf = b, func_idx = idx)
  ints_of(b)
}

//# Tests

test "minimal width matches the minimal encoder" {
  let mut v = 0
  while v < 20000 {
    let b = Bytes::new()
    leb128_encode_u32(buf = b, value = v)
    assert_eq(leb128_u32_min_width(v), Bytes::length(b))
    v = v + 37
  }
  assert_eq(leb128_u32_min_width(2097151), 3)
  assert_eq(leb128_u32_min_width(2097152), 4)
}

test "padded encoding is a floor and decodes to the same value" {
  let b = Bytes::new()
  leb128_encode_u32_padded(buf = b, value = 5, width = 3)
  assert_eq(ints_of(b), [0x85, 0x80, 0x00])
  let c = Bytes::new()
  leb128_encode_u32_padded(buf = c, value = 128, width = 3)
  assert_eq(ints_of(c), [0x80, 0x81, 0x00])
  let d = Bytes::new()
  leb128_encode_u32_padded(buf = d, value = 2097152, width = 3)
  assert_eq(ints_of(d), [0x80, 0x80, 0x80, 0x01])
  let e = Bytes::new()
  leb128_encode_u32_padded(buf = e, value = 300, width = 0)
  let f = Bytes::new()
  leb128_encode_u32(buf = f, value = 300)
  assert_eq(ints_of(e), ints_of(f))
}

test "width 0 leaves emit_call byte-identical to the minimal encoding" {
  set_reloc_slot_width(0)
  assert_eq(reloc_slot_width(), 0)
  assert_eq(call_bytes(5), [0x10, 0x05])
  assert_eq(call_bytes(127), [0x10, 0x7F])
  assert_eq(call_bytes(128), [0x10, 0x80, 0x01])
  let b = Bytes::new()
  leb128_encode_u32_slot(buf = b, value = 200)
  assert_eq(ints_of(b), [0xC8, 0x01])
}

test "width 3 keeps a call's length independent of the callee's index" {
  set_reloc_slot_width(3)
  let a = call_bytes(127)
  let b = call_bytes(128)
  let c = call_bytes(16384)
  set_reloc_slot_width(0)
  assert_eq(a, [0x10, 0xFF, 0x80, 0x00])
  assert_eq(b, [0x10, 0x80, 0x81, 0x00])
  assert_eq(c, [0x10, 0x80, 0x80, 0x01])
}

test "the setter clamps to what a u32 LEB128 can hold" {
  set_reloc_slot_width(9)
  let hi = reloc_slot_width()
  set_reloc_slot_width(0 - 1)
  let lo = reloc_slot_width()
  set_reloc_slot_width(0)
  assert_eq(hi, 5)
  assert_eq(lo, 0)
}

fn i64_const_bytes(_ v: Int) -> Array[Int] {
  let b = Bytes::new()
  emit_i64_const_slot(buf = b, value = v)
  ints_of(b)
}

test "minimal signed width matches the minimal signed encoder" {
  let mut v = 0 - 9000
  while v < 9000 {
    let b = Bytes::new()
    leb128_encode_s32(buf = b, value = v)
    assert_eq(leb128_s_min_width(v), Bytes::length(b))
    v = v + 61
  }
  // 63 is one byte, 64 needs two: bit 6 is the sign.
  assert_eq(leb128_s_min_width(63), 1)
  assert_eq(leb128_s_min_width(64), 2)
  assert_eq(leb128_s_min_width(0 - 64), 1)
  assert_eq(leb128_s_min_width(0 - 65), 2)
}

test "padded signed encoding keeps the sign in the last byte" {
  let a = Bytes::new()
  leb128_encode_s_padded(buf = a, value = 2, width = 3)
  assert_eq(ints_of(a), [0x82, 0x80, 0x00])
  let b = Bytes::new()
  leb128_encode_s_padded(buf = b, value = 64, width = 3)
  assert_eq(ints_of(b), [0xC0, 0x80, 0x00])
  let c = Bytes::new()
  leb128_encode_s_padded(buf = c, value = 0 - 1, width = 3)
  assert_eq(ints_of(c), [0xFF, 0xFF, 0x7F])
}

test "width 0 leaves the slot constants byte-identical to the plain ones" {
  set_reloc_slot_width(0)
  let plain = Bytes::new()
  emit_i64_const(buf = plain, value = (31<<2)|2)
  let slotted = i64_const_bytes((31<<2)|2)
  let plain32 = Bytes::new()
  emit_i32_const(buf = plain32, value = 31)
  let slotted32 = Bytes::new()
  emit_i32_const_slot(buf = slotted32, value = 31)
  assert_eq(slotted, ints_of(plain))
  assert_eq(ints_of(slotted32), ints_of(plain32))
}

test "width 3 keeps a function value's length across the slot 15 -> 16 band" {
  // slot 15 is `i64.const 62` (one byte), slot 16 is `i64.const 66` (two):
  // the band a function value crosses is at 2^4 slots, not 2^7.
  set_reloc_slot_width(3)
  let a = i64_const_bytes((15<<2)|2)
  let b = i64_const_bytes((16<<2)|2)
  set_reloc_slot_width(0)
  assert_eq(a, [0x42, 0xBE, 0x80, 0x00])
  assert_eq(b, [0x42, 0xC2, 0x80, 0x00])
}

fn str_bytes(value: Int, fat: Bool) -> Array[Int] {
  let b = Bytes::new()
  emit_i64_const_str(buf = b, value = value, fat = fat)
  ints_of(b)
}

test "width 0 leaves string addresses byte-identical to a plain i64.const" {
  set_reloc_slot_width(0)
  let fat_value = (112650<<32)|73
  let plain = Bytes::new()
  emit_i64_const(buf = plain, value = fat_value)
  let plain_ref = Bytes::new()
  emit_i64_const(buf = plain_ref, value = 8191)
  assert_eq(str_bytes(value = fat_value, fat = true), ints_of(plain))
  assert_eq(str_bytes(value = 8191, fat = false), ints_of(plain_ref))
}

test "width 3 keeps string address lengths across their bands" {
  // A bare offset is two bytes below 8192 and three from it; a fat
  // `(offset << 32) | length` is seven bytes below offset 2^15 and eight
  // from it. At width 3 both sides of each band are the same length.
  set_reloc_slot_width(3)
  let ref_lo = Array::length(str_bytes(value = 8191, fat = false))
  let ref_hi = Array::length(str_bytes(value = 8192, fat = false))
  let fat_lo = Array::length(str_bytes(value = (32767<<32)|5, fat = true))
  let fat_hi = Array::length(str_bytes(value = (32768<<32)|5, fat = true))
  set_reloc_slot_width(0)
  assert_eq(ref_lo, 4)
  assert_eq(ref_hi, 4)
  assert_eq(fat_lo, 9)
  assert_eq(fat_hi, 9)
}

fn ctor_tag_len(_ tag: Int) -> Int {
  let b = Bytes::new()
  emit_i32_const_ctor_tag(buf = b, value = tag)
  Bytes::length(b)
}

test "width 0 leaves a constructor tag byte-identical to a plain i32.const" {
  set_reloc_slot_width(0)
  let tag = (37<<16)|2
  let plain = Bytes::new()
  emit_i32_const(buf = plain, value = tag)
  let padded = Bytes::new()
  emit_i32_const_ctor_tag(buf = padded, value = tag)
  assert_eq(ints_of(padded), ints_of(plain))
}

test "width 3 keeps a constructor tag's length across type index 15 -> 16" {
  // (15 << 16) is three signed-LEB bytes, (16 << 16) four. The tag width is
  // the slot width plus one, so both are four.
  set_reloc_slot_width(0)
  let lo0 = ctor_tag_len(15<<16)
  let hi0 = ctor_tag_len(16<<16)
  set_reloc_slot_width(3)
  let lo3 = ctor_tag_len(15<<16)
  let hi3 = ctor_tag_len(16<<16)
  set_reloc_slot_width(0)
  assert_eq(lo0, 4)
  assert_eq(hi0, 5)
  assert_eq(lo3, 5)
  assert_eq(hi3, 5)
}

test "a built-in constructor tag is never padded" {
  // Below 2 << 16 a tag never moves, so it keeps its minimal encoding.
  set_reloc_slot_width(3)
  let builtin = ctor_tag_len(1)
  let builtin_hi = ctor_tag_len((1<<16)|3)
  let user = ctor_tag_len(2<<16)
  set_reloc_slot_width(0)
  assert_eq(builtin, 2)
  assert_eq(builtin_hi, 4)
  assert_eq(user, 5)
}

test "call_indirect pads its type index and leaves the table index alone" {
  set_reloc_slot_width(0)
  let b0 = Bytes::new()
  emit_call_indirect(buf = b0, type_idx = 7)
  set_reloc_slot_width(3)
  let b3 = Bytes::new()
  emit_call_indirect(buf = b3, type_idx = 7)
  set_reloc_slot_width(0)
  assert_eq(ints_of(b0), [0x11, 0x07, 0x00])
  assert_eq(ints_of(b3), [0x11, 0x87, 0x80, 0x00, 0x00])
}

test "a constructor tag never exceeds the five bytes an i32.const may take" {
  // W + 1 would be six at W = 5; a six-byte i32.const fails validation.
  set_reloc_slot_width(5)
  let user = ctor_tag_len(2<<16)
  let wide = ctor_tag_len((2047<<16)|3)
  set_reloc_slot_width(0)
  assert_eq(user, 6)
  assert_eq(wide, 6)
}

test "a fat string address never exceeds nine bytes, the most a 63-bit Int needs" {
  // W + 5 would be ten at W = 5; a tenth byte carries no bits an Int has.
  set_reloc_slot_width(5)
  let fat = Array::length(str_bytes(value = (65536<<32)|7, fat = true))
  set_reloc_slot_width(0)
  assert_eq(fat, 10)
}

fn if_type_bytes(_ idx: Int) -> Array[Int] with Exception {
  let b = Bytes::new()
  emit_if_type_index(buf = b, type_idx = idx)
  ints_of(b)
}

test "width 0 leaves a type-index blocktype one byte" {
  set_reloc_slot_width(0)
  assert_eq(if_type_bytes(13), [0x04, 0x0D])
  assert_eq(if_type_bytes(63), [0x04, 0x3F])
}

test "width 3 pads a type-index blocktype as a signed LEB with a clear sign bit" {
  // 63 is the last index a single s33 byte holds; padded, bit 6 of the LAST
  // byte is the sign, so `0xBF 0x80 0x00` reads back as +63, not -1.
  set_reloc_slot_width(3)
  let lo = if_type_bytes(13)
  let hi = if_type_bytes(63)
  set_reloc_slot_width(0)
  assert_eq(lo, [0x04, 0x8D, 0x80, 0x00])
  assert_eq(hi, [0x04, 0xBF, 0x80, 0x00])
}
