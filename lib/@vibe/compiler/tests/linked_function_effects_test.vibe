import @vibe/compiler/codegen/wasi {
  LinkedFunctionEffects, lc_commit_function_effects, lc_function_effects_new
}

fn add_lambda(out: LinkedFunctionEffects, byte: Int) -> Unit {
  Array::push(out.lambdas.bodies, value = Bytes::from_array([byte]))
  Array::push(out.lambdas.param_counts, value = 1)
  Array::push(out.lambdas.captures, value = ["capture"])
  Array::push(out.lambdas.meta_i32, value = 2)
  Array::push(out.lambdas.meta_i64, value = 3)
  Array::set(out.lambda_next, at = 0, value = Array::get(out.lambda_next, at = 0) + 1)
}

fn add_ref(out: LinkedFunctionEffects, owner: Int, slot: Int) -> Unit {
  Array::push(out.slots, value = slot)
  Array::push(out.blind_owners, value = owner)
  Array::push(out.blind_offsets, value = 7)
  // A function-value record: the kind that pairs with a funcref slot.
  Array::push(out.blind_kinds, value = 101)
  Array::push(out.blind_syms, value = slot)
}

fn publish(src: LinkedFunctionEffects, dst: LinkedFunctionEffects, end: Int) -> Unit with Exception {
  lc_commit_function_effects(src = src, dst = dst.lambdas, slots = dst.slots, blind_owners = dst.blind_owners, blind_offsets = dst.blind_offsets, blind_kinds = dst.blind_kinds, blind_syms = dst.blind_syms, planned_end = end)
}

fn publication_error(src: LinkedFunctionEffects, dst: LinkedFunctionEffects, end: Int) -> String {
  handle {
    publish(src = src, dst = dst, end = end)
    "accepted"
  } with { Exception::Throw(msg) => msg }
}

fn assert_empty(_ dst: LinkedFunctionEffects) -> Unit with Exception {
  assert(Array::length(dst.lambdas.bodies) == 0)
  assert(Array::length(dst.lambdas.param_counts) == 0)
  assert(Array::length(dst.lambdas.captures) == 0)
  assert(Array::length(dst.lambdas.meta_i32) == 0)
  assert(Array::length(dst.lambdas.meta_i64) == 0)
  assert(Array::length(dst.slots) == 0)
  assert(Array::length(dst.blind_owners) == 0)
  assert(Array::length(dst.blind_offsets) == 0)
  assert(Array::length(dst.blind_kinds) == 0)
  assert(Array::length(dst.blind_syms) == 0)
}

test "independent functions own their tables and cursor" {
  let a = lc_function_effects_new(0)
  let b = lc_function_effects_new(5)
  add_lambda(out = b, byte = 22)
  add_ref(out = b, owner = 3, slot = 100)
  assert_empty(a)
  inspect(Array::get(a.lambda_next, at = 0), "0")
  inspect(Array::get(b.lambda_next, at = 0), "6")
}

test "completion order does not change canonical publication order" {
  let second = lc_function_effects_new(1)
  add_lambda(out = second, byte = 22)
  add_ref(out = second, owner = 2, slot = 102)
  let first = lc_function_effects_new(0)
  add_lambda(out = first, byte = 11)
  add_ref(out = first, owner = 1, slot = 101)
  let dst = lc_function_effects_new(0)
  publish(src = first, dst = dst, end = 1)
  publish(src = second, dst = dst, end = 2)
  inspect(Bytes::get(Array::get(dst.lambdas.bodies, at = 0), at = 0), "11")
  inspect(Bytes::get(Array::get(dst.lambdas.bodies, at = 1), at = 0), "22")
  inspect(Array::get(dst.slots, at = 0), "101")
  inspect(Array::get(dst.slots, at = 1), "102")
  inspect(Array::get(dst.blind_owners, at = 1), "2")
  inspect(Array::get(Array::get(dst.lambdas.captures, at = 1), at = 0), "capture")
  inspect(Array::get(dst.lambdas.meta_i64, at = 1), "3")
}

test "an out-of-order range is refused without publishing any rows" {
  let src = lc_function_effects_new(1)
  add_lambda(out = src, byte = 22)
  add_ref(out = src, owner = 2, slot = 102)
  let dst = lc_function_effects_new(0)
  inspect(publication_error(src = src, dst = dst, end = 2), "function effects: lambda range does not match canonical publication order")
  assert_empty(dst)
}

test "missing lambda metadata or an unfinished cursor cannot publish" {
  let src = lc_function_effects_new(0)
  add_lambda(out = src, byte = 11)
  let dst = lc_function_effects_new(0)
  Array::set(src.lambda_next, at = 0, value = 0)
  inspect(publication_error(src = src, dst = dst, end = 1), "function effects: lambda cursor did not reach the planned end")
  assert_empty(dst)
  Array::set(src.lambda_next, at = 0, value = 1)
  Array::truncate(src.lambdas.meta_i64, length = 0)
  inspect(publication_error(src = src, dst = dst, end = 1), "function effects: lambda metadata arrays are not aligned")
  assert_empty(dst)
}

test "missing blind references cannot publish even the valid lambda prefix" {
  let src = lc_function_effects_new(0)
  add_lambda(out = src, byte = 11)
  add_ref(out = src, owner = 1, slot = 101)
  Array::truncate(src.blind_syms, length = 0)
  let dst = lc_function_effects_new(0)
  inspect(publication_error(src = src, dst = dst, end = 1), "function effects: funcref slots and blind references are not aligned")
  assert_empty(dst)
}

test "a string reference publishes without a funcref slot" {
  let src = lc_function_effects_new(0)
  add_ref(out = src, owner = 4, slot = 9)
  // A string reference (#2669, kind 103) has no slot of its own.
  Array::push(src.blind_owners, value = 4)
  Array::push(src.blind_offsets, value = 11)
  Array::push(src.blind_kinds, value = 103)
  Array::push(src.blind_syms, value = 2)
  let dst = lc_function_effects_new(0)
  publish(src = src, dst = dst, end = 0)
  inspect(Array::length(dst.slots), "1")
  inspect(Array::length(dst.blind_kinds), "2")
  inspect(Array::get(dst.blind_kinds, at = 1), "103")
  // ...but a slot with no function-value record is still unpaired.
  let bad = lc_function_effects_new(0)
  Array::push(bad.slots, value = 9)
  Array::push(bad.blind_owners, value = 4)
  Array::push(bad.blind_offsets, value = 11)
  Array::push(bad.blind_kinds, value = 103)
  Array::push(bad.blind_syms, value = 2)
  inspect(publication_error(src = bad, dst = lc_function_effects_new(0), end = 0), "function effects: funcref slots and blind references are not aligned")
}

test "functions without lambdas still publish their function references" {
  let src = lc_function_effects_new(0)
  add_ref(out = src, owner = 4, slot = 104)
  let dst = lc_function_effects_new(0)
  publish(src = src, dst = dst, end = 0)
  inspect(Array::length(dst.lambdas.bodies), "0")
  inspect(Array::get(dst.slots, at = 0), "104")
  inspect(Array::get(dst.blind_syms, at = 0), "104")
}
