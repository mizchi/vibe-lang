//# Imports

import ./checker_parity_test_support.vibe {
  check_source_err, check_source_err_contains, check_source_ok
}

//# Misc

// #1001: `check_assignable`'s `head_kind` buckets every `CtNamed` into the
// same "kind 0" tolerated bucket regardless of NAME, and the one existing
// same-name check (`detect_narrowed_generic_mismatch`, #981) explicitly
// requires the two names to already match before it looks at anything else —
// so a genuinely DIFFERENT nominal type (`Result[Int,String]` vs the builtin
// `Option[Int]`) at a call argument position sailed through unreported.
// `nominal_head_conflict`/`nominal_name_of` (checker.vibe) close this by
// comparing the RESOLVED nominal identity (`CtOption` counts as "Option") of
// both sides wherever it's genuinely concrete, recursing through
// containers/CtNamed's own arguments to catch the mismatch nested arbitrarily
// deep.
//
// #1324 removed the prelude/injected `Result`, so each checked source below
// declares the enum itself. The subject is unchanged: a genuinely DIFFERENT
// nominal head at an argument position must be reported.

test "1001 repro: Result vs Option at argument position is rejected" {
  assert(check_source_err("enum Result[T, E] { Ok(T); Err(E) }\nfn use_result(x: Result[Int,String]) -> Int { 0 }\nfn bad(o: Option[Int]) -> Int { use_result(o) }\nfn main() -> Int { bad(Some(1)) }"))
}

test "1001: Option vs Result at argument position is rejected (reversed)" {
  assert(check_source_err("enum Result[T, E] { Ok(T); Err(E) }\nfn use_option(x: Option[Int]) -> Int { 0 }\nfn bad(r: Result[Int,String]) -> Int { use_option(r) }\nfn main() -> Int { bad(Ok(1)) }"))
}

test "1001 repro: nested nominal head mismatch inside Array is rejected" {
  assert(check_source_err("enum Result[T, E] { Ok(T); Err(E) }\nfn use_options(x: Array[Option[Int]]) -> Int { 0 }\nfn bad(x: Array[Result[Int,String]]) -> Int { use_options(x) }\nfn main() -> Int { bad([]) }"))
}

test "1001: nested nominal head mismatch inside a same-named CtNamed's own type arguments is rejected" {
  assert(check_source_err("enum Result[T, E] { Ok(T); Err(E) }\nstruct Box[T] { v: T }\nfn use_box_option(b: Box[Option[Int]]) -> Int { 0 }\nfn bad(b: Box[Result[Int,String]]) -> Int { use_box_option(b) }\nfn main() -> Int { 0 }"))
}

test "1001: matching nominal types (both Result) stay accepted" {
  assert(check_source_ok("enum Result[T, E] { Ok(T); Err(E) }\nfn use_result(x: Result[Int,String]) -> Int { 0 }\nfn main() -> Int { use_result(Ok(1)) }"))
}

test "1001: matching nominal types (both Option) stay accepted" {
  assert(check_source_ok("fn use_option(x: Option[Int]) -> Int { 0 }\nfn main() -> Int { use_option(Some(1)) }"))
}

test "1001: #981 same-name generic mismatch keeps being rejected (no regression)" {
  assert(check_source_err("struct Box[T] { v: T }\nfn get_int(b: Box[Int]) -> Int { b.v + 1 }\nfn main() -> Int {\n  let b: Box[String] = Box::{ v: \"hello\" }\n  get_int(b)\n}"))
}

// #1538: `HostStream` is a component handle cell, not the eager array that
// backs legacy `Stream[T]`. The boundary must fail before an eager consumer
// can read the cell as bytes. This deliberately uses a user-defined consumer
// too, so every `Stream[T]` parameter is protected rather than only a list of
// current Stream builtins.
test "1538: HostStream is rejected by a legacy Stream consumer" {
  assert(check_source_err("fn consume(s: Stream[Int]) -> Int { 0 }\nfn main() -> Int { consume(host_stream_named(\"body\")) }"))
}

/// #1954 removes the compiler-owned legacy Stream surface. A bare unknown
/// named type remains intentionally tolerated by the generic checker, so the
/// load-bearing boundary is that the old builtin consumer no longer resolves.
test "1954: legacy Stream consumer is unreachable" {
  assert(check_source_err("fn main() -> String { Stream::to_string(String::to_bytes(\"*\")) }"))
}

test "1954: String bytes satisfy an explicit ByteStream parameter" {
  assert(check_source_ok("fn consume(s: ByteStream) -> Int { 0 }\nfn main() -> Int { consume(String::to_bytes(\"*\")) }"))
}

test "1954: ByteStream does not expose its materialized representation" {
  assert(check_source_err("fn main() -> Int { Array::length(String::to_bytes(\"*\")) }"))
}

/// The retired names must not resolve -- an unknown name is the error now.
test "1538: the eager Stream combinators are gone" {
  assert(check_source_err("fn main() -> Int { let s = Stream::once(42); 0 }"))
  assert(check_source_err("fn main() -> Int { let s = Stream::empty(); 0 }"))
}

test "1538: HostStream retains its direct read lane" {
  assert(check_source_ok("fn read(s: HostStream) -> Int with Async { host_stream_next(s) }\nfn main() -> Int allows Async { read(host_stream_named(\"body\")) }"))
}

test "1539: exact StdinStream token is accepted" {
  assert(check_source_ok("fn use(s: StdinStream) -> Int with Async { StdinStream::next(s) }\nfn run() -> Int with Stdin + Async { use(Stdin::read_via_stream()) }"))
}

test "1539: StdinStream cannot cross Int, HostStream, Stream, or user-struct boundaries" {
  assert(check_source_err("fn use(s: StdinStream) -> Int { 0 }\nfn run() -> Int { use(1) }"))
  assert(check_source_err("fn use(s: StdinStream) -> Int { 0 }\nfn run() -> Int { use(host_stream_named(\"body\")) }"))
  assert(check_source_err("fn use(s: StdinStream) -> Int { 0 }\nfn run() -> Int { use(String::to_bytes(\"a\")) }"))
  assert(check_source_err("struct Fake { value: Int }\nfn use(s: StdinStream) -> Int { 0 }\nfn run() -> Int { use(Fake::{ value: 1 }) }"))
  assert(check_source_err("fn use(i: Int) -> Int { i }\nfn run() -> Int with Stdin { use(Stdin::read_via_stream()) }"))
  assert(check_source_err("fn use(s: HostStream) -> Int { 0 }\nfn run() -> Int with Stdin { use(Stdin::read_via_stream()) }"))
}

test "1539: a source struct named StdinStream cannot forge the token" {
  assert(check_source_err("struct StdinStream { value: Int }\nfn run() -> Int with Async { let s = StdinStream::{ value: 1 }; StdinStream::next(s) }"))
}

test "1539: StdinStream does not satisfy Send" {
  assert(check_source_err("fn require_send[T: Send](x: T) -> Int { 0 }\nfn run() -> Int with Stdin { require_send(Stdin::read_via_stream()) }"))
}

test "1539: acquisition and operations carry only their exact authority" {
  assert(check_source_err("fn run() -> Int { let s = Stdin::read_via_stream(); 0 }"))
  assert(check_source_ok("fn run() -> Int with Stdin { let s = Stdin::read_via_stream(); 0 }"))
  assert(check_source_err("fn run() -> Int with Stdin { let s = Stdin::read_via_stream(); StdinStream::next(s) }"))
  assert(check_source_ok("fn run() -> Int with Stdin + Async { let s = Stdin::read_via_stream(); StdinStream::next(s) }"))
  assert(check_source_ok("fn consume(s: StdinStream) -> Unit with Async { StdinStream::close(s) }\nfn run() -> Int with Stdin + Async { consume(Stdin::read_via_stream()); 0 }"))
}

test "1539: stdin provider builtins are direct-call-only" {
  assert(check_source_err("let acquire = Stdin::read_via_stream\nfn run() -> Int { 0 }"))
  assert(check_source_err("fn run() -> Int { let next = StdinStream::next; 0 }"))
  assert(check_source_err("fn run() -> Int { let close = StdinStream::close; 0 }"))
  assert(check_source_err("fn run() -> Int { let read = StdinStream::read_chunk; 0 }"))
  assert(check_source_err("fn run() -> Int { let op = if true { StdinStream::next } else { StdinStream::next }; 0 }"))
  assert(check_source_err("fn leak() -> (StdinStream) -> Int with Async { StdinStream::next }\nfn run() -> Int { 0 }"))
  assert(check_source_err("struct Holder { op: (StdinStream) -> Int with Async }\nfn run() -> Int { let _ = Holder::{ op: StdinStream::next }; 0 }"))
  assert(check_source_err("fn carry(op: (StdinStream) -> Int with Async) -> Int { 0 }\nfn run() -> Int { carry(StdinStream::next) }"))
}

test "1539: explicit effectful wrappers remain first-class" {
  assert(check_source_ok("fn acquire() -> StdinStream with Stdin { Stdin::read_via_stream() }\nfn next(s: StdinStream) -> Int with Async { StdinStream::next(s) }\nfn close(s: StdinStream) -> Unit with Async { StdinStream::close(s) }\nfn read(s: StdinStream, n: Int) -> Option[String] with Async { StdinStream::read_chunk(s, n) }\nfn run() -> Int with Stdin + Async { let a = acquire; let b = next; let c = close; let d = read; let s = a(); let _ = b(s); let _ = d(s, 1); c(s); 0 }"))
}

test "1001: genuinely generic parameter stays tolerated (no over-rejection)" {
  assert(check_source_ok("struct Box[T] { v: T }\nfn second[T](b: Box[T], d: Int) -> Int { d }\nfn main() -> Int {\n  let b: Box[String] = Box::{ v: \"hello\" }\n  second(b, 42)\n}"))
}

// #3326: a generic struct or enum APPLIED to arguments (`Cell[Int]`) resolves
// to `CtNamed`, which `head_kind` puts in the tolerated 0 bucket, and a builtin
// `Array` / tuple / function / record has no nominal name to compare -- so an
// `Array[Int]` passed where a `Cell[Int]` is declared fell through every gate,
// compiled clean, and `x.value` read the array's packed representation
// (4294967554 for `[1]`). A plain `struct P` was rejected because `CtStruct`
// has a head of its own, and `Option` because it has a nominal name.

test "3326: an Array is not a generic struct applied to its element type" {
  assert(check_source_err_contains("struct Cell[T] { value: T }\nfn main() -> Int { let x: Cell[Int] = [1]; x.value }", "expected Cell[Int], got Array[Int]"))
  assert(check_source_err_contains("struct Cell[T] { value: T }\nfn take(c: Cell[Int]) -> Int { c.value }\nfn main() -> Int { take([7]) }", "argument type mismatch for take: expected Cell[Int], got Array[Int]"))
  assert(check_source_err_contains("struct Cell[T] { value: T }\nfn mk() -> Cell[Int] { [1] }\nfn main() -> Int { mk().value }", "expected Cell[Int], got Array[Int]"))
  assert(check_source_err_contains("enum Wrap[T] { W(T); Empty }\nfn main() -> Int { let x: Wrap[Int] = [1]; 0 }", "expected Wrap[Int], got Array[Int]"))
}

test "3326: the reverse direction and nested positions are rejected too" {
  assert(check_source_err_contains("struct Cell[T] { value: T }\nfn len(a: Array[Int]) -> Int { Array::length(a) }\nfn main() -> Int { len(Cell::{ value: 1 }) }", "expected Array[Int], got Cell[Int]"))
  assert(check_source_err("struct Cell[T] { value: T }\nfn main() -> Int { let x: Array[Cell[Int]] = [[1]]; 0 }"))
  assert(check_source_err("struct Cell[T] { value: T }\nfn main() -> Int { let x: Array[Cell[Int]] = [1]; 0 }"))
  assert(check_source_err("struct Cell[T] { value: T }\nfn f(o: Option[Cell[Int]]) -> Int { 0 }\nfn main() -> Int { f(Some([1])) }"))
  assert(check_source_err("struct Cell[T] { value: T }\nfn f(t: (Cell[Int], Int)) -> Int { 0 }\nfn main() -> Int { f(([1], 2)) }"))
}

test "3326: a tuple, a function or a record is not an applied generic struct" {
  assert(check_source_err_contains("struct Cell[T] { value: T }\nfn main() -> Int { let x: Cell[Int] = (1, 2); x.value }", "expected Cell[Int], got (Int, Int)"))
  assert(check_source_err("struct Cell[T] { value: T }\nfn main() -> Int { let x: Cell[Int] = (n: Int) -> n; x.value }"))
  assert(check_source_err("struct Cell[T] { value: T }\nfn main() -> Int { let x: Cell[Int] = record { value: 1 }; x.value }"))
}

// The head is certain whatever the arguments are, so a generic callee or a
// generic body is the same mismatch, not a tolerated rigid formal.
test "3326: an applied generic struct with formal arguments still has a certain head" {
  assert(check_source_err("struct Cell[T] { value: T }\nfn get[T](c: Cell[T]) -> T { c.value }\nfn main() -> Int { get([7]) }"))
  assert(check_source_err("struct Cell[T] { value: T }\nfn f[T](x: T) -> Cell[T] { [x] }\nfn main() -> Int { f(1).value }"))
  assert(check_source_err("struct Cell[T] { value: T }\nstruct Holder[T] { c: Cell[T] }\nfn main() -> Int { let h: Holder[Int] = Holder::{ c: [1] }; h.c.value }"))
}

test "3326: what IS an Array keeps accepting one" {
  // A parameterized alias whose target is `Array` expands at resolution.
  assert(check_source_ok("type L[T] = Array[T]\nfn f(x: L[Int]) -> Int { Array::length(x) }\nfn main() -> Int { let y: L[Int] = [1]; f([1, 2]) + Array::length(y) }"))
  // A constructor formal instantiated at `Array`, directly and from a generic body.
  assert(check_source_ok("fn first[F[_]](x: F[Int]) -> Int { 0 }\nfn main() -> Int { first([1, 2]) }"))
  assert(check_source_ok("fn idf[F[_], A](x: F[A]) -> F[A] { x }\nfn g[A](xs: Array[A]) -> Array[A] { idf(xs) }\nfn main() -> Int { Array::length(g([1])) }"))
  assert(check_source_ok("struct Holder[F[_]] { value: F[Int] }\nfn main() -> Int { let h: Holder[Array] = Holder::{ value: [1] }; Array::length(h.value) }"))
  // `FixedArray` is a compiler-owned phantom over `Array`'s layout (#1140).
  assert(check_source_ok("fn f(xs: Array[Int]) -> Int { Array::length(xs) }\nfn main() -> Int { f(FixedArray::make(3, 0)) }"))
  // An Array as the struct's ARGUMENT, concrete and through a generic.
  assert(check_source_ok("struct Cell[T] { value: T }\nfn main() -> Int { let c: Cell[Array[Int]] = Cell::{ value: [1] }; Array::length(c.value) }"))
  assert(check_source_ok("struct Cell[T] { value: T }\nfn wrap[T](x: T) -> Cell[T] { Cell::{ value: x } }\nfn main() -> Int { let c: Cell[Array[Int]] = wrap([1]); Array::length(c.value) }"))
  assert(check_source_ok("struct Cell[T] { value: T }\nfn g[A](c: Cell[Array[A]]) -> Array[A] { c.value }\nfn main() -> Int { Array::length(g(Cell::{ value: [1] })) }"))
}

// #3326 review: a program may declare its own type under a compiler-owned
// spelling (`struct Future[T]`, fixtures/user_future_struct_field_call_test.vibe),
// and it resolves to the same `CtNamed` as the compiler's head. Ownership is
// read from the declaration table, not the spelling: a source type is an
// ordinary nominal type.
test "3326: a program's own type spelled like a compiler-owned head is not an Array" {
  assert(check_source_err_contains("struct Future[T] { v: T }\nfn main() -> Int { let x: Future[Int] = [1]; x.v }", "expected Future[Int], got Array[Int]"))
  assert(check_source_err("enum Task[T] { Done(T); Pending }\nfn main() -> Int { let x: Task[Int] = [1]; 0 }"))
  assert(check_source_err("struct Future[T] { v: T }\nfn main() -> Int { let x: Future[Int] = (1, 2); x.v }"))
  assert(check_source_err("struct Future[T] { v: T }\nfn len(a: Array[Int]) -> Int { Array::length(a) }\nfn main() -> Int { len(Future::{ v: 1 }) }"))
  // Declared after its use: ownership does not depend on declaration order.
  assert(check_source_err("fn len(a: Array[Int]) -> Int { Array::length(a) }\nfn main() -> Int { len(Future::{ v: 1 }) }\nstruct Future[T] { v: T }"))
}

// #3326 review (Codex P2): `FixedArray` / `ArrayBuilder` / `MutBytes` values
// stand in for a builtin value, and a program's type of the same spelling
// shares their `CtNamed`, so no owner can be told apart -- the builtin's own
// `FixedArray::make(..)` was refused where an `Array` is declared, and
// `let x: FixedArray[Int] = FixedArray::make(2, 7)` read the array as the
// struct. Those spellings are reserved, at any arity.
test "3326: a builtin whose values stand in for a builtin value keeps its spelling" {
  assert(check_source_err_contains("struct FixedArray[T] { v: T }\nfn take(xs: Array[Int]) -> Int { Array::length(xs) }\nfn main() -> Int { take(FixedArray::make(2, 1)) }", "rename this struct: `FixedArray` is a builtin type whose values may be used as `Array`"))
  assert(check_source_err_contains("enum ArrayBuilder[T] { B(T) }\nfn main() -> Int { 0 }", "rename this enum: `ArrayBuilder` is a builtin type whose values may be used as `Array`"))
  assert(check_source_err_contains("struct MutBytes { v: Int }\nfn main() -> Int { 0 }", "rename this struct: `MutBytes` is a builtin type whose values may be used as `Bytes`"))
  assert(check_source_err_contains("struct FixedArray[A, B] { a: A; b: B }\nfn main() -> Int { 0 }", "rename this struct: `FixedArray`"))
  // Renamed, the builtin's own value crosses into `Array` again.
  assert(check_source_ok("struct MyFixed[T] { v: T }\nfn take(xs: Array[Int]) -> Int { Array::length(xs) }\nfn main() -> Int { take(FixedArray::make(2, 1)) }"))
}

test "3326: the compiler's own FixedArray and ArrayBuilder still cross into Array" {
  assert(check_source_ok("fn f(xs: Array[Int]) -> Int { Array::length(xs) }\nfn main() -> Int { let b = ArrayBuilder::new(); ArrayBuilder::push(b, 1); f(b) }"))
  assert(check_source_ok("struct H { counts: Array[Int] }\nfn main() -> Int { let c = FixedArray::make(3, 0); let h = H::{ counts: c }; Array::length(h.counts) }"))
  assert(check_source_ok("struct Future[T] { apply: (T) -> T }\nfn run_it(f: Future[Int], x: Int) -> Int { f.apply(x) }\nfn main() -> Int { let f: Future[Int] = Future::{ apply: (n) -> n + 41 }; run_it(f, 1) }"))
}
