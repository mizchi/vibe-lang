//# Imports

import ./qualified_ctor_enum_support.vibe {
  Attempt, Hue, make_bad, make_good
}

//# Functions

fn unwrap(a: Attempt[Int]) -> Int {
  match a {
    Attempt::Good(v) => v
    Attempt::Bad(_) => 0
  }
}

fn unwrap_str(a: Attempt[String]) -> String {
  match a {
    Attempt::Good(v) => v
    Attempt::Bad(m) => m
  }
}

fn hue_name(h: Hue) -> String {
  match h {
    Hue::Crimson => "crimson"
    Hue::Cerulean => "cerulean"
  }
}

//# Misc

test "#1455: qualified ctor of an IMPORTED PARAMETERIZED enum" {
  // Before the variant list carried its formals across the boundary this was
  // `unknown name: Attempt::Good` -- `resolve_qualified_ctor_ident` fell back
  // to a flat `env_lookup` that could not see the imported scheme at all.
  assert_eq(unwrap(Attempt::Good(7)), 7)
  assert_eq(unwrap(Attempt::Bad("nope")), 0)
}

test "#1455: the rebuilt scheme is still generic, not pinned to one instance" {
  // Two different instantiations in one module: if the formal were bound to a
  // shared, non-quantified var the second one would unify against the first.
  assert_eq(unwrap(Attempt::Good(1)), 1)
  assert_eq(unwrap_str(Attempt::Good("s")), "s")
}

test "#1455: the imported ctor agrees with the dependency's own constructor" {
  assert_eq(unwrap(make_good(9)), 9)
  assert_eq(unwrap(make_bad("x")), 0)
}

test "#1455: qualified pattern on an imported parameterized enum" {
  assert_eq(unwrap(make_good(4)), 4)
}

test "#1490: the monomorphic path still works" {
  assert_eq(hue_name(Hue::Crimson), "crimson")
  assert_eq(hue_name(Cerulean), "cerulean")
}
