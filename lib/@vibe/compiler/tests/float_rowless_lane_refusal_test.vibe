//# #3543 / #3625: `Float` arithmetic is rounded to f32 at the sites the
//# checker files a row for, so a build lane needs those rows. The merged
//# lanes `vibe build --debug` reaches (`compile_file_wasi_library` for each
//# dependency, `compile_file_wasi_only`) parse every file located into one
//# offset space and take the rows from their own check, so a program with a
//# Float compiles there; the runtime answers (`0.33333334`,
//# `16777217.0f == 16777216.0f` is `true`) are pinned by the `build --debug`
//# rows of `tests/gates/early/extended_derive.sh`. A linked entry compiled
//# with no import-resolving check of its exact text behind it
//# (`compile_file_wasi_linked_artifacts` on its own) has no rows -- its own
//# check sees every imported name as unknown -- so it still refuses a
//# program that can hold a Float, with the edit, instead of computing the
//# sum as an f64; a program without one compiles as before.

//# Imports

import @vibe/core {
  array_empty
}

import @vibe/compiler/entry/source_compile/wasi_only {
  compile_file_wasi_library, compile_file_wasi_linked_artifacts, compile_file_wasi_only
}

//# Functions

fn string_to_bytes(_ s: String) -> Bytes {
  let out = array_empty()
  let len = String::length(s)
  let mut i = 0
  while i < len {
    Array::push(out, value = String::byte_at(s, at = i))
    i = i + 1
  }
  Bytes::from_array(out)
}

fn is_wasm(_ bytes: Bytes) -> Bool {
  Bytes::length(bytes) > 4 && Bytes::get(bytes, at = 0) == 0 && Bytes::get(bytes, at = 1) == 97 && Bytes::get(bytes, at = 2) == 115 && Bytes::get(bytes, at = 3) == 109
}

fn write_source(dir: String, name: String, source: String) -> String with Fs {
  let path = String::concat(dir, String::concat("/", name))
  Fs::mkdir_p(dir)
  Fs::write_bytes(path, bytes = string_to_bytes(source))
  path
}

fn library_lane(dir: String, source: String) -> String with Env + Fs {
  let path = write_source(dir = dir, name = "dep.vibe", source = source)
  handle {
    if is_wasm(compile_file_wasi_library(path)) {
      "wasm"
    } else {
      "not wasm"
    }
  } with { Exception::Throw(m) => m }
}

fn entry_lane(dir: String, source: String) -> String with Env + Fs {
  let path = write_source(dir = dir, name = "main.vibe", source = source)
  handle {
    if is_wasm(compile_file_wasi_only(entry_path = path, entry_name = "answer")) {
      "wasm"
    } else {
      "not wasm"
    }
  } with { Exception::Throw(m) => m }
}

fn linked_lane(dir: String, source: String) -> String with Env + Fs {
  let path = write_source(dir = dir, name = "main.vibe", source = source)
  handle {
    let (bytes, _, _) = compile_file_wasi_linked_artifacts(entry_path = path, entry_name = "answer")
    if is_wasm(bytes) {
      "wasm"
    } else {
      "not wasm"
    }
  } with { Exception::Throw(m) => m }
}

fn refusal() -> String {
  "build without `--debug`: this linked build has no type check of the exact text it compiles, so it cannot round `Float32` arithmetic to f32 (#3543); the default build, `vibe run` and `vibe test` can"
}

fn float_dep() -> String {
  "export fn third() -> Float32 {\n  1.0f / 3.0f\n}\n\nexport fn bump(x: Float32) -> Float32 {\n  let mut s = x\n  s += 1.0f\n  s\n}\n"
}

//# Misc

test "the library lane compiles the Float arithmetic it now rounds" {
  inspect(library_lane(dir = "/tmp/vibe_float_located_lib", source = float_dep()), content = "wasm")
}

test "the merged entry lane compiles Float arithmetic across an import" {
  let dir = "/tmp/vibe_float_located_entry"
  let _ = write_source(dir = dir, name = "dep.vibe", source = float_dep())
  inspect(entry_lane(dir = dir, source = "import ./dep.vibe { third, bump }\n\nexport fn answer() -> Int {\n  if bump(x = 16777216.0f) == 16777216.0f && third() + third() > 0.5f {\n    1\n  } else {\n    0\n  }\n}\n"), content = "wasm")
}

test "a linked entry with no checked rows still refuses a Float" {
  inspect(linked_lane(dir = "/tmp/vibe_float_rowless_linked", source = "fn scale(x: Float32) -> Float32 {\n  x * 2.0f\n}\n\nexport fn answer() -> Int {\n  1\n}\n") == refusal(), content = "true")
}

test "a linked entry refuses a Float made only through a width-named conversion" {
  // ADR-0122 (#3728): `Int::to_float32` / `Float64::to_float32` make a Float
  // as surely as `Int::to_float`; the guard must see them, or the sum below
  // is computed in f64 (16777217) instead of rounding to the f32 16777216.
  inspect(linked_lane(dir = "/tmp/vibe_float_rowless_linked_width", source = "export fn answer() -> Int {\n  let a = Int::to_float32(16777216)\n  let b = Int::to_float32(1)\n  let _ = a + b\n  1\n}\n") == refusal(), content = "true")
  inspect(linked_lane(dir = "/tmp/vibe_float_rowless_linked_width64", source = "export fn answer() -> Int {\n  let a = Float64::to_float32(0.1)\n  let _ = a + a\n  1\n}\n") == refusal(), content = "true")
}

test "a program without a Float still compiles on every lane" {
  inspect(library_lane(dir = "/tmp/vibe_float_rowless_lib_ok", source = "export fn half(x: Float64) -> Float64 {\n  x / 2.0\n}\n"), content = "wasm")
  inspect(entry_lane(dir = "/tmp/vibe_float_rowless_entry_ok", source = "export fn answer() -> Int {\n  1 + 2\n}\n"), content = "wasm")
  inspect(linked_lane(dir = "/tmp/vibe_float_rowless_linked_ok", source = "export fn answer() -> Int {\n  1 + 2\n}\n"), content = "wasm")
}
