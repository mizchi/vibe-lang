import @vibe/compiler/core {
  merged_offset_space_add, merged_offset_space_reset
}
import @vibe/compiler/syntax {
  lex_with_offsets, parse_program_located
}
import @vibe/compiler/codegen/wasi {
  LinkedModulePreparation, lc_finish_linked_module, lc_prepare_module_with_split_grants, lc_render_unused
}
import @vibe/compiler/codegen/common_base {
  CodegenBodyCache, DbgProv, codegen_body_cache_discard, codegen_body_cache_merge, codegen_body_cache_to_bytes, module_split_none
}
import @vibe/compiler/cache {
  ast_binary_read_string_checked, ast_binary_read_varint_checked, ast_binary_reader_new, ast_binary_with_string_pool
}
import @vibe/function_worker {
  finish_function_assembly,
  function_assembly_new,
  function_context_new,
  read_function_assembly,
  read_function_context,
  read_function_job,
  run_function_range,
  write_function_assembly,
  write_function_context,
  write_function_job
}
import @vibe/lowering_worker/linear {
  linear_body_cache_from_bytes
}
import @vibe/blake3/simd {
  blake3_bytes_simd
}

fn prepare_assembly_source(source: String, rc: Bool) -> LinkedModulePreparation with Exception {
  let path = "prepared-構築.vibe"
  merged_offset_space_reset()
  merged_offset_space_add(path = path, source = source, base = 0)
  let (tokens, starts, _) = lex_with_offsets(source)
  let stmts = parse_program_located(tokens = tokens, starts = starts, source = source)
  let owners: Array[Int] = []
  for stmt in stmts {
    Array::push(owners, value = 0)
  }
  let nls: Array[Int] = []
  let mut i = 0
  while i < String::length(source) {
    if String::char_code_at(source, at = i) == 10 {
      Array::push(nls, value = i)
    } else ()
    i = i + 1
  }
  let prov = DbgProv::{ files: [path], stmt_file_id: owners, file_nls: [nls] }
  lc_prepare_module_with_split_grants(stmts = stmts, entry_name_in = "main", srcs = [(path, source)], linked_imports = [], library_mode = false, enable_rc = rc, coverage = false, debug_trace = false, debug_break = false, rc_shadow = false, enable_late_dce = false, prov = prov, body_cache_in = codegen_body_cache_discard(), body_cache_out = codegen_body_cache_discard(), slice_lo = 0, slice_hi = -1, checker_float_call_offsets = [
  ], checker_int_render_offsets = [], checker_bool_render_offsets = [], checker_eq_offsets = [], checker_eq_type_keys = [], split = module_split_none(), render = lc_render_unused, grants = [])
}

fn owned_product(_ product: CodegenBodyCache) -> CodegenBodyCache with Exception {
  match linear_body_cache_from_bytes(codegen_body_cache_to_bytes(product)) {
    Some(value) => value,
    None => throw("test product transport failed")
  }
}

fn zero_bytes(_ bytes: Bytes) -> Unit {
  let mut i = 0
  while i < Bytes::length(bytes) {
    Bytes::set(bytes, at = i, value = 0); i = i + 1
  }
}

fn refuses_assembly(packet: Bytes, shared: Bytes, packet_digest: String, context_digest: String) -> Unit with Exception {
  let result = handle {
    read_function_assembly(bytes = packet, shared = shared, packet_digest = packet_digest, context_digest = context_digest)
    "accepted"
  } with { Exception::Throw(message) => message }
  assert(result != "accepted")
}

fn swap_assembly_row[T](values: Array[T], a: Int, b: Int) -> Unit {
  let value = Array::get(values, at = a)
  Array::set(values, at = a, value = Array::get(values, at = b))
  Array::set(values, at = b, value = value)
}

fn check_assembly(source: String, rc: Bool, large: Bool, order_probe: Bool) -> Unit with Exception {
  let expected = lc_finish_linked_module(prepare_assembly_source(source = source, rc = rc))
  let prepared = prepare_assembly_source(source = source, rc = rc)
  let ctx = function_context_new(plan = prepared.functions, input = prepared.input, debug_break = false, debug_trace = false, enable_rc = rc, rc_shadow = false)
  let shared = write_function_context(ctx)
  let context_digest = blake3_bytes_simd(shared)
  let n = prepared.input.num_user_funcs
  // Independently decode real assigned ranges, then merge reverse completion.
  // None of their expressions or output buffers comes from the parent heap.
  let left_ctx = read_function_context(shared)
  let left_job = read_function_job(ctx = left_ctx, bytes = write_function_job(ctx = ctx, digest = context_digest, lo = 0, hi = n / 2), digest = context_digest)
  let left = owned_product(run_function_range(ctx = left_ctx, lo = left_job.lo, hi = left_job.hi))
  let right_ctx = read_function_context(shared)
  let right_job = read_function_job(ctx = right_ctx, bytes = write_function_job(ctx = ctx, digest = context_digest, lo = n / 2, hi = n), digest = context_digest)
  let right = owned_product(run_function_range(ctx = right_ctx, lo = right_job.lo, hi = right_job.hi))
  let products = codegen_body_cache_merge(a = right, b = left)
  let assembly = function_assembly_new(prepared)
  assert(prepared.used)
  let consumed = handle {
    lc_finish_linked_module(prepared); "accepted"
  } with { Exception::Throw(message) => message }
  assert(consumed == "module preparation: already consumed")
  // A standalone packet must never inherit an ambient AST string-reference pool.
  let packet = ast_binary_with_string_pool(strings = FrozenArray::from_array([
    "vibe-function-assembly-1",
    context_digest
  ]), action = () -> {
    write_function_assembly(state = assembly, context_digest = context_digest)
  })
  let packet_digest = blake3_bytes_simd(packet)
  if large {
    assert(Bytes::length(shared) > 128 * 1024)
    assert(Bytes::length(packet) < 64 * 1024)
  } else ()
  // These checks independently exercise outer receipts and inner codec checks.
  let changed_packet = Bytes::slice(packet, start = 0, end = Bytes::length(packet))
  Bytes::set(changed_packet, at = Bytes::length(changed_packet) - 1, value = 123)
  refuses_assembly(packet = changed_packet, shared = shared, packet_digest = packet_digest, context_digest = context_digest)
  let changed_context = Bytes::slice(shared, start = 0, end = Bytes::length(shared))
  Bytes::set(changed_context, at = Bytes::length(changed_context) - 1, value = 123)
  refuses_assembly(packet = packet, shared = changed_context, packet_digest = packet_digest, context_digest = context_digest)
  for cut in [0, 1, 20, Bytes::length(packet) - 1] {
    let short = Bytes::slice(packet, start = 0, end = cut)
    refuses_assembly(packet = short, shared = shared, packet_digest = blake3_bytes_simd(short), context_digest = context_digest)
  }
  let extra = Bytes::slice(packet, start = 0, end = Bytes::length(packet))
  Bytes::push(extra, value = 42)
  refuses_assembly(packet = extra, shared = shared, packet_digest = blake3_bytes_simd(extra), context_digest = context_digest)
  let wrong_version = Bytes::slice(packet, start = 0, end = Bytes::length(packet))
  Bytes::set(wrong_version, at = String::length("vibe-function-assembly-1"), value = '9')
  refuses_assembly(packet = wrong_version, shared = shared, packet_digest = blake3_bytes_simd(wrong_version), context_digest = context_digest)
  let invalid_bool = Bytes::slice(packet, start = 0, end = Bytes::length(packet))
  let reader = ast_binary_reader_new(invalid_bool)
  ast_binary_read_string_checked(reader)
  ast_binary_read_string_checked(reader)
  Bytes::set(invalid_bool, at = reader.pos, value = 2)
  refuses_assembly(packet = invalid_bool, shared = shared, packet_digest = blake3_bytes_simd(invalid_bool), context_digest = context_digest)
  let invalid_header = Bytes::slice(packet, start = 0, end = Bytes::length(packet))
  Bytes::set(invalid_header, at = 1, value = 255)
  refuses_assembly(packet = invalid_header, shared = shared, packet_digest = blake3_bytes_simd(invalid_header), context_digest = context_digest)
  // Enter the actual literal decoder with matching outer digests and binding;
  // a receipt mismatch alone would not prove that UTF-8 is checked here.
  let invalid_utf8 = Bytes::slice(shared, start = 0, end = Bytes::length(shared))
  let literal_reader = ast_binary_reader_new(invalid_utf8)
  ast_binary_read_string_checked(literal_reader)
  let count = ast_binary_read_varint_checked(literal_reader)
  let mut literal = 0
  let mut changed = false
  while literal < count && !changed {
    let size = ast_binary_read_varint_checked(literal_reader)
    if size > 0 {
      Bytes::set(invalid_utf8, at = literal_reader.pos, value = 255)
      changed = true
    } else ()
    literal = literal + 1
  }
  assert(changed)
  let invalid_context_digest = blake3_bytes_simd(invalid_utf8)
  let bound_packet = Bytes::slice(packet, start = 0, end = Bytes::length(packet))
  let binding_reader = ast_binary_reader_new(bound_packet)
  ast_binary_read_string_checked(binding_reader)
  assert(ast_binary_read_varint_checked(binding_reader) == 64)
  let mut digit = 0
  while digit < 64 {
    Bytes::set(bound_packet, at = binding_reader.pos + digit, value = String::char_code_at(invalid_context_digest, at = digit))
    digit = digit + 1
  }
  refuses_assembly(packet = bound_packet, shared = invalid_utf8, packet_digest = blake3_bytes_simd(bound_packet), context_digest = invalid_context_digest)
  let received = read_function_assembly(bytes = packet, shared = shared, packet_digest = packet_digest, context_digest = context_digest)
  // Nothing beyond primitive owned data may survive the preparation boundary.
  Array::truncate(prepared.functions.bodies, length = 0)
  Array::truncate(prepared.functions.source_types, length = 0)
  Array::truncate(prepared.input.stmts, length = 0)
  Array::truncate(prepared.input.fn_stmt_indices, length = 0)
  Array::truncate(prepared.input.str_strs, length = 0)
  Array::truncate(prepared.input.fn_names_list, length = 0)
  Array::truncate(prepared.sections.str_offsets, length = 0)
  Array::truncate(prepared.sections.prov.files, length = 0)
  merged_offset_space_reset()
  merged_offset_space_add(path = "unrelated.vibe", source = "unrelated source", base = 0)
  zero_bytes(packet)
  zero_bytes(shared)
  let invalid = owned_product(products)
  Array::truncate(invalid.fn_meta_i32, length = 0)
  let bad_product = handle {
    finish_function_assembly(state = received, products = invalid); "accepted"
  } with { Exception::Throw(message) => message }
  assert(bad_product == "function product: function columns or count differ")
  assert(!received.replay.used)
  assert(Array::length(received.sections.lt_w.bodies) == 0)
  assert(Array::length(received.sections.table_slots_used) == 0)
  if order_probe {
    let reordered = owned_product(products)
    assert(Array::length(reordered.lam_indices) >= 2)
    assert(Array::get(reordered.lam_owner, at = 0) == Array::get(reordered.lam_owner, at = 1))
    swap_assembly_row(values = reordered.lam_indices, a = 0, b = 1)
    swap_assembly_row(values = reordered.lam_owner, a = 0, b = 1)
    swap_assembly_row(values = reordered.lam_bodies, a = 0, b = 1)
    swap_assembly_row(values = reordered.lam_param_counts, a = 0, b = 1)
    swap_assembly_row(values = reordered.lam_captures, a = 0, b = 1)
    swap_assembly_row(values = reordered.lam_meta_i32, a = 0, b = 1)
    swap_assembly_row(values = reordered.lam_meta_i64, a = 0, b = 1)
    let disorder = handle {
      finish_function_assembly(state = received, products = reordered); "accepted"
    } with { Exception::Throw(message) => message }
    assert(disorder == "function product: lambda rows are not in planned order")
    assert(!received.replay.used)
    assert(Array::length(received.sections.lt_w.bodies) == 0)
    assert(Array::length(received.sections.table_slots_used) == 0)
  } else ()
  let actual = finish_function_assembly(state = received, products = products)
  assert(Bytes::compare(expected, actual) == 0)
  let again = handle {
    finish_function_assembly(state = received, products = products); "accepted"
  } with { Exception::Throw(message) => message }
  assert(again == "function assembly: assembly was already consumed")
}

test "owned assembly finishes real products after discarding all preparing syntax" {
  for rc in [false, true] {
    check_assembly(source = "let seed = 23\nfn helper(a: Int, b: Int) -> Int { a - b }\nfn main() -> Int {\n  let f = (x: Int) -> helper(seed, x)\n  f(5)\n}\n", rc = rc, large = false, order_probe = false)
    check_assembly(source = "fn main() -> Unit allows Console { println(\"構築\") }\n", rc = rc, large = false, order_probe = false)
    check_assembly(source = "fn main() -> Int allows Exception {\n handle { throw(\"boom\") } with { Exception::Throw(_) => { 7 } }\n}\n", rc = rc, large = false, order_probe = false)
    check_assembly(source = "fn divide(n: Int) -> Int {\n n / 0\n}\nfn main() -> Int { divide(7) }\n", rc = rc, large = false, order_probe = false)
  }
}

test "decoded assembly preserves per-owner lambda order validation before mutation" {
  for rc in [false, true] {
    check_assembly(source = "fn choose(n: Int) -> (Int) -> Int { if n > 0 { (x) -> x - 2 } else { (x) -> x + 100 } }\nfn main() -> Int { let f = choose(1); f(9) }", rc = rc, large = false, order_probe = true)
  }
}

test "assembly packet reuses the shared literal pool instead of encoding it again" {
  let parts: Array[String] = []
  let mut i = 0
  while i < 8192 {
    Array::push(parts, value = "literal_pool_6b7c8d9e_unchanged_0123456789")
    i = i + 1
  }
  let source = "fn main() -> Unit allows Console { println(\"" + String::join(parts, sep = "") + "\") }\n"
  check_assembly(source = source, rc = false, large = true, order_probe = false)
  check_assembly(source = source, rc = true, large = true, order_probe = false)
}
