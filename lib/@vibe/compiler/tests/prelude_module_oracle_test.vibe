import @vibe/compiler/entry/compiler/file_compile {
  prelude_module_full_oracle_report_fs, prelude_module_import_closure_report_fs, prelude_module_oracle_report_fs
}

//# Functions

// #2388: the oracle runs every pre-codegen pass on the whole merged program
// and on each file's statements alone from the same state, and reports per
// pass whether the two agree. A two-file program whose entry rewrites through
// `inspect` (desugar_inspect_calls changes it) and calls across the import
// (the alias and evidence passes see both sides) must agree on every pass.

/// The report's `SYNTH ...` line, or "".
fn synth_line_of(report: String) -> String {
  let lines = String::split(report, "\n")
  let mut out = ""
  let mut i = 0
  while i < Array::length(lines) {
    let line = Array::get(lines, i)
    if String::starts_with(line, "SYNTH ") {
      out = line
    } else {
      ()
    }
    i = i + 1
  }
  out
}

/// The report's `EVIDENCE ...` line, or "" .
fn evidence_line_of(report: String) -> String {
  let lines = String::split(report, "\n")
  let mut out = ""
  let mut i = 0
  while i < Array::length(lines) {
    let line = Array::get(lines, i)
    if String::starts_with(line, "EVIDENCE ") {
      out = line
    } else {
      ()
    }
    i = i + 1
  }
  out
}

fn oracle_lines(report: String) -> Array[String] {
  let lines = String::split(report, "\n")
  let out: Array[String] = []
  let mut i = 0
  while i < Array::length(lines) {
    let line = Array::get(lines, i)
    if String::starts_with(line, "PASS ") {
      Array::push(out, line)
    } else {
      ()
    }
    i = i + 1
  }
  out
}

fn status_of(line: String) -> String {
  let at = String::index_of(line, " status=")
  if at < 0 {
    "?"
  } else {
    String::substring(line, at + 8, String::length(line))
  }
}

test "every pre-codegen pass agrees between whole-program and per-file runs on a two-file program" {
  let helper_path = "/tmp/vibe_prelude_oracle_helper.vibe"
  let main_path = "/tmp/vibe_prelude_oracle_main.vibe"
  Fs::write_file(helper_path, "export fn twice(x: Int) -> Int {\n  x + x\n}\n")
  Fs::write_file(main_path, "import ./vibe_prelude_oracle_helper.vibe { twice }\n\nfn run() -> Int {\n  twice(21)\n}\n\ntest \"twice\" {\n  inspect(run(), content = \"42\")\n}\n")
  let report = prelude_module_oracle_report_fs(main_path, "__no_entry__", 16)
  let lines = oracle_lines(report)
  inspect(Array::length(lines), content = "17")
  let statuses: Array[String] = []
  let mut i = 0
  while i < Array::length(lines) {
    Array::push(statuses, status_of(Array::get(lines, i)))
    i = i + 1
  }
  inspect(String::join(statuses, ","), content = "same,same,same,same,same,same,same,same,same,same,same,same,same,same,same,same,same")
  // The first line names the first pass and carries the statement counts of
  // both sides; a run that skipped either side could not report them equal.
  inspect(String::starts_with(Array::get(lines, 0), "PASS elaborate_heap_params stmts="), content = "true")
}

/// The `keyed ...` line the oracle prints under one pass: the verdict for a
/// pass whose per-module run synthesizes program-level statements, which land
/// at each module's position and repeat per module, so position and count are
/// not the comparison.
fn keyed_line_of(report: String, pass: String) -> String {
  let lines = String::split(report, "\n")
  let mut out = "<none>"
  let mut seen = false
  let mut i = 0
  while i < Array::length(lines) {
    let line = Array::get(lines, i)
    if String::starts_with(line, String::concat("PASS ", pass)) {
      seen = true
    } else if seen && String::contains(line, "keyed ") {
      if out == "<none>" {
        out = String::trim(line)
      } else {
        ()
      }
    } else if String::starts_with(line, "PASS ") {
      seen = false
    } else {
      ()
    }
    i = i + 1
  }
  out
}

// #2388: two files that each hoist a non-capturing effectful local lambda, and
// both call it `f`. A hoisted lambda becomes a TOP-LEVEL definition, so a name
// minted from a program-wide counter makes what a module mints depend on the
// files compiled before it. Measured on this program before the name carried
// the declaration it came out of:
//
//   keyed missing=1 extra=0 copies=2 content=2 first_missing=let:__hoisted_lam_1_f
//     whole<let __hoisted_lam_0_f = (a: Int) -> Int with HLog { ... "helper" ... }>
//     split<let __hoisted_lam_0_f = (a: Int) -> Int with MLog { ... "main" ... }>
//
// -- one name, two different bodies, which a link that concatenates the modules
// resolves by silently keeping one of them.
test "two files that each hoist a local lambda mint top-level names the other module cannot collide with" {
  let helper_path = "/tmp/vibe_prelude_oracle_hoist_helper.vibe"
  let main_path = "/tmp/vibe_prelude_oracle_hoist_main.vibe"
  Fs::write_file(helper_path, "effect HLog {\n  Emit(String) -> Unit\n}\n\nexport fn helper_use() -> Int {\n  let f = (a: Int) -> Int with HLog {\n    perform HLog::Emit(\"helper\")\n    a\n  }\n  handle {\n    f(1)\n  } with {\n    HLog::Emit(_m) => resume(0)\n  }\n}\n")
  Fs::write_file(main_path, "import ./vibe_prelude_oracle_hoist_helper.vibe {\n  helper_use\n}\n\neffect MLog {\n  Emit(String) -> Unit\n}\n\nfn main_use() -> Int {\n  let f = (a: Int) -> Int with MLog {\n    perform MLog::Emit(\"main\")\n    a + 1\n  }\n  handle {\n    f(2)\n  } with {\n    MLog::Emit(_m) => resume(0)\n  }\n}\n\ntest \"hoisted\" {\n  inspect(helper_use() + main_use(), content = \"4\")\n}\n")
  let report = prelude_module_oracle_report_fs(main_path, "__no_entry__", 16)
  // `missing=0 content=0` is the property under test: every declaration the
  // whole-program run produced is produced by the module that owns it, under
  // the same name and with the same body.
  //
  // `copies=1` is NOT, as this comment used to say, "the one program-level
  // helper this pass synthesizes per module, which a link-time dedup by name
  // folds". `first_copy` names it: `reexport_boundary`, an
  // `SReExportSourceBoundary` marker that every module carries one of and no
  // link should merge. Measured by running the link
  // (`link_fold_duplicate_definitions`) over this program's per-module result:
  // it folds nothing, because there is no duplicated definition here.
  inspect(keyed_line_of(report, "desugar_trait_dicts_with_typed_eq"), content = "keyed missing=0 extra=0 copies=1 content=0 renames=0 dup_keys=2 dup_defs=0 dup_def_keys= first_copy=reexport_boundary missing_keys= content_keys= first_content=")
  // `evidence_dict_pass` synthesizes a dict struct per module the same way, so
  // its verdict is its keyed line too. It used to differ in CONTENT here: the
  // hoisted function was appended at the end of the merged program, the
  // provenance re-alignment attributed it to the entry file, and the module
  // that owned it then called a function it did not contain, so no dictionary
  // was threaded (`stmts=11 split=10`). With the hoist placing its output next
  // to its owner, the declarations agree and only the position of the one
  // synthesized struct is left.
  inspect(keyed_line_of(report, "evidence_dict_pass"), content = "keyed missing=0 extra=0 copies=1 content=0 renames=0 dup_keys=2 dup_defs=0 dup_def_keys= first_copy=reexport_boundary missing_keys= content_keys= first_content=")
  // What the rest of the report says on this program, as measured.
  let statuses: Array[String] = []
  let lines = oracle_lines(report)
  let mut i = 0
  while i < Array::length(lines) {
    Array::push(statuses, status_of(Array::get(lines, i)))
    i = i + 1
  }
  inspect(String::join(statuses, ","), content = "same,same,same,same,same,same,same,same,same,same,same,same,same,same,same,differs,same")
}

// #2388: the same program through the WHOLE prelude per module, which is the
// property a real per-module driver needs -- each module alone through every
// pass, then linked. The pass-by-pass oracle above cannot answer it: it
// advances the split side through the earlier passes as ONE program, so a pass
// there never reads another pass's per-module output.
test "the whole prelude per module reproduces the whole-program prelude" {
  let helper_path = "/tmp/vibe_full_oracle_helper.vibe"
  let main_path = "/tmp/vibe_full_oracle_main.vibe"
  Fs::write_file(helper_path, "effect HLog {\n  Emit(String) -> Unit\n}\n\nexport fn helper_use() -> Int {\n  let f = (a: Int) -> Int with HLog {\n    perform HLog::Emit(\"helper\")\n    a\n  }\n  handle {\n    f(1)\n  } with {\n    HLog::Emit(_m) => resume(0)\n  }\n}\n")
  Fs::write_file(main_path, "import ./vibe_full_oracle_helper.vibe {\n  helper_use\n}\n\neffect MLog {\n  Emit(String) -> Unit\n}\n\nfn main_use() -> Int {\n  let f = (a: Int) -> Int with MLog {\n    perform MLog::Emit(\"main\")\n    a + 1\n  }\n  handle {\n    f(2)\n  } with {\n    MLog::Emit(_m) => resume(0)\n  }\n}\n\ntest \"hoisted\" {\n  inspect(helper_use() + main_use(), content = \"4\")\n}\n")
  let report = prelude_module_full_oracle_report_fs(main_path, "__no_entry__")
  let lines = String::split(report, "\n")
  // `split` is the modules concatenated, `linked` is after the link folds the
  // program-level helpers each module synthesized for itself, and `folded` is
  // how many that was. The comparison below is against `linked`, so it answers
  // the question a per-module driver actually has: does the LINKED program
  // equal the whole-program one.
  //
  // `folded=0` on this program, and that is a correction to what this test
  // used to say. Its `copies=1` was read as "the one program-level helper
  // synthesized per module, which a link-time dedup by name folds" -- but the
  // link folds nothing here, because `first_copy=reexport_boundary`: the
  // repeat is an `SReExportSourceBoundary` MARKER, which every module carries
  // one of and no link should merge. This program duplicates no helper at all.
  // On the COMPILER'S OWN closure (too slow for the suite -- measured
  // 2026-09-10 on `lib/@vibe/cli/entry.vibe`, 365 modules, and recorded on
  // #2388):
  //
  //   CLOSURE files=365 edges=1415 unresolved=0
  //   FULL stmts=9863 split=10006 linked=9857 folded=149 modules=365
  //        collisions=0 invisible_whole=0 invisible_split=17 linked_dups=5
  //     invisible MutMap[]   invisible MutSet[]   (generic heads, #2634)
  //   SYNTH requests=75/70:-A1_N6_OptionN3_Int A1_N6_OptionN6_String
  //                         spec:A2_N6_MutMapN6_StringN3_Int
  //                         spec:A1_N6_MutSetN6_String
  //                         spec:A2_N6_MutMapN6_StringN6_String+
  //   keyed missing=6 extra=0 copies=444 content=9 renames=0 dup_keys=451
  //         dup_defs=5 dup_def_keys=effect:Source,effect:Env,effect:ParseRecur,
  //                                 effect:Profiler,effect:Profiler
  //         first_missing=let:MutMap::equals__N6_String__N3_Int
  //   EVIDENCE declared=6 handled=4 performed=3
  //   edges_unresolved=0
  //
  // `linked_dups` equals `dup_defs`: the link removed NONE of the definitions
  // the whole program legitimately carries twice, and left nothing duplicated
  // that it should have folded. Both count extra OCCURRENCES -- as distinct
  // keys they read 4 against 5 and looked like a discrepancy, because
  // `effect:Profiler` is declared three times.
  //
  // Those numbers are the THIRD recorded here, and the two corrections are
  // worth keeping because both were the same mistake: a context rule wider
  // than a real compile, producing a green that meant less than it looked.
  //
  //   every other file      missing=1 content=4   (191-module entry: 0/0)
  //   transitive closure    missing=1 content=4   invisible_split=2
  //   one hop               missing=6 content=9   invisible_split=15
  //
  // The first gave each module every other file's surface. The second followed
  // dependency edges transitively, which hands A the declarations of a module
  // C that A's dependency B imports PRIVATELY -- 32017 reachable pairs against
  // 1415 one-hop ones, 22x wider. Each narrowing uncovered differences the
  // previous one was hiding, and the counters only mean what they say under
  // the rule that matches a real compile.
  //
  // (The first also claimed 191 modules for "the compiler's own closure"; that
  // is neither CLI entry in the current tree -- `entry.vibe` is 365,
  // `main.vibex` 370.)
  //
  // `invisible_whole=0` throughout: a program that type-checks whole can see
  // every nominal it compares. `invisible_split` is what each narrowing takes
  // away, and #2631 made a comparator's body independent of it, which is why
  // `collisions=0` survived the narrowing that took `invisible_split` from 2
  // to 15.
  //
  // 15 to 17 is a third thing: the recorder covered `eq_for_typed`'s `TyName`
  // fallthrough and not its `TyApp` twin, so a GENERIC head declining silently
  // was not counted. `MutMap` and `MutSet` are `type MutMap[K, V]` (opaque) in
  // `@vibe/core/index.vpkg` and `export struct MutMap[K, V]` in `hashmap.vibe`
  // -- the same shape as `PerceusActionKind`. Without the `TyApp` recorder the
  // two looked like different mechanisms, which is a measurement covering one
  // arm of a dispatch reporting the other arm as absence (#2634).
  // docs/incremental-build.md, "What a module must see".
  inspect(String::trim(Array::get(lines, 0)), content = "FULL stmts=11 split=11 linked=11 folded=0 modules=2 collisions=0 invisible_whole=0 invisible_split=0 linked_dups=0")
  // #2633: the facts `evidence_dict_pass` derives its migration set from,
  // sampled on both lanes immediately before that pass runs. A bare count means
  // the whole-program set and the union of the per-module sets are EQUAL; a
  // difference prints `<whole>/<union>:-<missing>+<extra>`. Equal here and on
  // the compiler's own closure (`declared=6 handled=4 performed=3`) is what
  // says the pass's INPUTS decompose per module even though its decision does
  // not -- the decision is a union that runs backwards along the import graph.
  inspect(String::trim(evidence_line_of(report)), content = "EVIDENCE declared=2 handled=2 performed=2")
  // #2634: whether the per-module run ASKS for the same synthesized helpers.
  // A `missing` row says the split emitted nothing; this says whether it never
  // recorded the need or recorded it and did not emit -- different causes with
  // different fixes. On the compiler's own CLI closure the split asks for five
  // fewer helpers, which is exactly the five missing comparator rows, so the
  // need is never recorded.
  //
  // `typed_refused` is the channel one step before that: the checker HAD a type
  // for an `==` site and the pass refused it, because
  // `eq_ty_field_is_content_comparable` is an allow-list consulting declared
  // registries. Whole program 0, split 3 -- `BinderAuthorityNodeKind`,
  // `BinderSemanticRole` and `Stmt`, all already in the invisible list. A
  // refused row means the site never learns its type, so it never reaches
  // `eq_for_typed`'s `Array` arm and never records the helper it needs.
  inspect(String::trim(synth_line_of(report)), content = "SYNTH requests=0 typed_refused=0")
  // `missing=0 extra=0 content=0` is the property: every declaration the
  // whole-program prelude produced is produced by the module that owns it,
  // with the same body. `copies` is what remains after the link, and
  // `first_copy` says what it is -- a number nobody could act on before,
  // because a helper the link folds and a marker that simply repeats both
  // landed in it and mean opposite things.
  inspect(String::trim(Array::get(lines, 1)), content = "keyed missing=0 extra=0 copies=1 content=0 renames=0 dup_keys=2 dup_defs=0 dup_def_keys= first_copy=reexport_boundary missing_keys= content_keys= first_content=")
}

// #2388: the context the full oracle runs each module under is that module's
// own resolved import closure, and this is the shape of it on its own.
//
// Reported separately from the oracle line because a per-module run that
// THROWS takes the count with it, and because a closure narrowed by DROPPED
// EDGES reads exactly like one narrowed by the real import graph. `unresolved`
// is the difference between those two, and a green with it unprinted is not
// the same claim as a green with it at zero.
test "the import closure the oracle runs under is the module's own, and places every edge" {
  let helper_path = "/tmp/vibe_closure_shape_helper.vibe"
  let mid_path = "/tmp/vibe_closure_shape_mid.vibe"
  let main_path = "/tmp/vibe_closure_shape_main.vibe"
  Fs::write_file(helper_path, "export fn leaf() -> Int {\n  1\n}\n")
  Fs::write_file(mid_path, "import ./vibe_closure_shape_helper.vibe {\n  leaf\n}\n\nexport fn mid() -> Int {\n  leaf() + 1\n}\n")
  Fs::write_file(main_path, "import ./vibe_closure_shape_mid.vibe {\n  mid\n}\n\ntest \"chain\" {\n  inspect(mid(), content = \"2\")\n}\n")
  // Three files in a chain main -> mid -> leaf. The closure is ONE HOP, so the
  // edge count is 2 (main sees mid; mid sees leaf; leaf sees nothing) and not
  // the 3 a transitive closure would give.
  //
  // This expectation is a CORRECTION. It read 3 and called transitivity the
  // point, on the reasoning that a module sees what its dependencies
  // re-export. But this chain uses plain imports: `mid` does not re-export
  // `leaf`, so a real compile of `main` cannot see `leaf`'s declarations, and
  // handing them to the split prelude is context no module has. An oracle that
  // reports agreement because it was given unavailable context is the one
  // failure mode that makes its green meaningless (Codex round on #2623).
  inspect(String::trim(prelude_module_import_closure_report_fs(main_path)), content = "CLOSURE files=3 edges=2 unresolved=0")
  // The control, and the reason this test can fail: a program with no imports
  // at all has no edges. If the closure were quietly falling back to "every
  // other file" -- the rule this replaced -- a two-file program would report
  // edges=2 here rather than 0.
  let lone_a = "/tmp/vibe_closure_shape_lone_a.vibe"
  let lone_b = "/tmp/vibe_closure_shape_lone_b.vibe"
  Fs::write_file(lone_a, "export fn a_only() -> Int {\n  1\n}\n")
  Fs::write_file(lone_b, "test \"lone\" {\n  inspect(1, content = \"1\")\n}\n")
  let _ = lone_a
  inspect(String::trim(prelude_module_import_closure_report_fs(lone_b)), content = "CLOSURE files=1 edges=0 unresolved=0")
}
