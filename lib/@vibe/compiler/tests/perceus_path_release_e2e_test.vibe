//# Imports

// #2389 per-path release, end to end. Each program compiles through BOTH the
// bump lane and the RC lane of THIS checkout's codegen and runs under
// wasmtime; the entry's return value is the oracle (codegen_heap_e2e_test's
// convention). The shapes are the ones the planner admits (a `let` consumed
// on some branch and not on others) and the neighbouring ones it declines,
// so an over-release would show up as a wrong answer or a trap on the
// consuming path, and the leak direction is pinned separately by
// fixtures/rc_reclaim_leak_test.vibe's heap bound.

import ./codegen_test_support.vibe {
  compile_wasi, compile_wasi_rc
}

//# Functions

fn run_value(bytes: Bytes, label: String) -> String with Fs + Process {
  let path = String::concat("/tmp/_path_release_e2e_", String::concat(label, ".wasm"))
  Fs::write_bytes(path, bytes)
  let out = sh_lines(String::concat("wasmtime run -W exceptions=y --invoke main ", String::concat(path, " 0 2>/dev/null")))
  if Array::length(out) > 0 {
    Array::get(out, 0)
  } else {
    "<no output>"
  }
}

fn assert_bump_rc_agree(src: String, label: String, expected: String) -> Int with Exception + Fs + Process + Stdout {
  let bump = run_value(compile_wasi(src, "main"), String::concat(label, "_bump"))
  let rc = run_value(compile_wasi_rc(src, "main"), String::concat(label, "_rc"))
  inspect(bump, content = expected)
  inspect(rc, content = expected)
  0
}

let prelude = "enum Node {\n  Leaf(Int);\n  Pair(Node, Node)\n}\nlet rec total: (Node) -> Int = (n) -> {\n  match n {\n    Pair(a, b) => total(a) + total(b),\n    Leaf(v) => v\n  }\n}\n"

//# Tests

test "the non-consuming path answers the same as before" {
  // `t` is consumed by the `then` branch only. Both branches are exercised,
  // so a release the consuming path should not have made would free a value
  // still in use, and one the other path should have made would leak.
  let src = String::concat(prelude, "let pick: (Bool) -> Node = (c) -> {\n  let t = Pair(Leaf(3), Leaf(4))\n  if c {\n    t\n  } else {\n    Leaf(9)\n  }\n}\nlet main: () -> Int = () -> {\n  total(pick(true)) * 100 + total(pick(false))\n}")
  let _ = assert_bump_rc_agree(src, "if_branch", "709")
  ()
}

test "the same split through a match arm" {
  let src = String::concat(prelude, "let pick: (Int) -> Node = (k) -> {\n  let t = Pair(Leaf(3), Leaf(4))\n  match k {\n    0 => t,\n    _ => Leaf(9)\n  }\n}\nlet main: () -> Int = () -> {\n  total(pick(0)) * 100 + total(pick(1))\n}")
  let _ = assert_bump_rc_agree(src, "match_arm", "709")
  ()
}

test "three arms, one of them consuming" {
  let src = String::concat(prelude, "let pick: (Int) -> Node = (k) -> {\n  let t = Pair(Leaf(3), Leaf(4))\n  match k {\n    0 => Leaf(1),\n    1 => t,\n    _ => Leaf(2)\n  }\n}\nlet main: () -> Int = () -> {\n  total(pick(0)) * 10000 + total(pick(1)) * 100 + total(pick(2))\n}")
  let _ = assert_bump_rc_agree(src, "three_arms", "10702")
  ()
}

test "a nested split inside the consuming branch" {
  // The inner `if` splits `t` again; the flag is per binding, so whichever
  // path reaches an occurrence that spends the initial reference stands the
  // scope-end drop down and no other path does.
  let src = String::concat(prelude, "let pick: (Bool, Bool) -> Node = (c, d) -> {\n  let t = Pair(Leaf(3), Leaf(4))\n  if c {\n    if d {\n      t\n    } else {\n      Leaf(5)\n    }\n  } else {\n    Leaf(9)\n  }\n}\nlet main: () -> Int = () -> {\n  total(pick(true, true)) * 10000 + total(pick(true, false)) * 100 + total(pick(false, false))\n}")
  let _ = assert_bump_rc_agree(src, "nested", "70509")
  ()
}

test "a shared source stays intact on the path that keeps it" {
  // `t` is read after the branch on both paths, so no merge zeroes its
  // count and the binding keeps its ordinary scope-end drop -- the value
  // read afterwards must still be the one built.
  let src = String::concat(prelude, "let keep: (Bool) -> Int = (c) -> {\n  let t = Pair(Leaf(3), Leaf(4))\n  let k = if c {\n    total(t)\n  } else {\n    0\n  }\n  k * 100 + total(t)\n}\nlet main: () -> Int = () -> {\n  keep(true) * 10000 + keep(false)\n}")
  let _ = assert_bump_rc_agree(src, "shared", "7070007")
  ()
}

test "an arm that transfers through an alias keeps its value" {
  // One arm returns `t` directly (an occurrence `pe_use` records); the other
  // transfers it through `let u = t`, which the planner decrements outside
  // `pe_use`. With that transfer unrecorded the guarded drop fired on the
  // alias path and freed the block `u` had just moved out -- measured as a
  // silent wrong answer, no trap. `filler` and `g` allocate after the value
  // is held, so a released block is reused under it.
  let src = String::concat(prelude, "let run: (Int) -> Node = (k) -> {\n  let t = Pair(Leaf(3), Leaf(4))\n  match k {\n    0 => t,\n    1 => {\n      let u = t\n      u\n    },\n    _ => Leaf(9)\n  }\n}\nlet main: () -> Int = () -> {\n  let mut i = 0\n  let mut acc = 0\n  while i < 50 {\n    let a = run(1)\n    let filler = run(2)\n    let g = Pair(Leaf(1), Leaf(1))\n    acc = acc + total(a) * 10000 + total(filler) * 100 + total(g)\n    i = i + 1\n  }\n  acc\n}")
  let _ = assert_bump_rc_agree(src, "alias_transfer", "3545100")
  ()
}

test "a let mut split is declined and still answers" {
  let src = String::concat(prelude, "let pick: (Bool) -> Node = (c) -> {\n  let mut t = Pair(Leaf(3), Leaf(4))\n  if c {\n    t\n  } else {\n    Leaf(9)\n  }\n}\nlet main: () -> Int = () -> {\n  total(pick(true)) * 100 + total(pick(false))\n}")
  let _ = assert_bump_rc_agree(src, "let_mut", "709")
  ()
}

test "a consuming occurrence inside a lambda is declined and still answers" {
  // The occurrence is a capture, which the planner walks with no source
  // offset -- codegen would have no site to set the flag at, so the binding
  // keeps today's behavior rather than getting a drop nothing suppresses.
  let src = String::concat(prelude, "let pick: (Bool) -> Node = (c) -> {\n  let t = Pair(Leaf(3), Leaf(4))\n  if c {\n    let f: () -> Node = () -> t\n    f()\n  } else {\n    Leaf(9)\n  }\n}\nlet main: () -> Int = () -> {\n  total(pick(true)) * 100 + total(pick(false))\n}")
  let _ = assert_bump_rc_agree(src, "capture", "709")
  ()
}

test "a call result whose callee declares a heap return is admitted" {
  // `mk` is a named function whose DECLARED return type is heap and which
  // neither borrow set claims, so its result is a reference the binding owns
  // and the guarded drop is correct. The leak it removes is pinned by
  // `via_call` in `fixtures/rc_reclaim_leak_test.vibe` (80 B per iteration,
  // 1,600,024 B at N=20000 before the rule read that contract); this case is
  // the answer oracle for the same shape.
  let src = String::concat(prelude, "let mk: (Int) -> Node = (i) -> Pair(Leaf(i), Leaf(i + 1))\nlet pick: (Bool) -> Node = (c) -> {\n  let t = mk(3)\n  if c {\n    t\n  } else {\n    Leaf(9)\n  }\n}\nlet main: () -> Int = () -> {\n  total(pick(true)) * 100 + total(pick(false))\n}")
  let _ = assert_bump_rc_agree(src, "call_heap_ret", "709")
  ()
}

test "a call that may return a view is declined and still answers" {
  // `maybe` is not provably borrow-returning (#707's fixpoint rejects it --
  // one arm hands back a fresh allocation) but may return an interior view,
  // and it reaches the binding through an `if` VALUE position, which
  // `linked_compile.vibe` records as a gap in the planner's own `view_call_let`
  // marking. The leaf reads `borrow_view_ret` so the predicate answers on its
  // own rather than relying on a guard computed elsewhere for another reason.
  // A regression guard, not a red test: with the check removed this shape
  // still answers, so what it buys is that the rule does not depend on that.
  let src = String::concat(prelude, "let maybe: (Array[Node], Bool) -> Node = (xs, b) -> {\n  if b {\n    Array::get(xs, 0)\n  } else {\n    Pair(Leaf(1), Leaf(1))\n  }\n}\nlet pick: (Bool, Bool) -> Int = (c, d) -> {\n  let xs = [Pair(Leaf(3), Leaf(4))]\n  let r = {\n    let t = if d {\n      maybe(xs, true)\n    } else {\n      Pair(Leaf(0), Leaf(0))\n    }\n    if c {\n      t\n    } else {\n      Leaf(9)\n    }\n  }\n  let filler = Pair(Leaf(7), Leaf(8))\n  total(r) * 10000 + total(Array::get(xs, 0)) * 100 + total(filler)\n}\nlet main: () -> Int = () -> {\n  pick(false, true)\n}")
  let _ = assert_bump_rc_agree(src, "view_ret_leaf", "90715")
  ()
}

test "a block whose tail allocates is admitted through the result spine" {
  // The value node is an `ELet`, not an allocation, so only reading the
  // result spine reaches it.
  let src = String::concat(prelude, "let pick: (Bool) -> Node = (c) -> {\n  let t = {\n    let k = 4\n    Pair(Leaf(3), Leaf(k))\n  }\n  if c {\n    t\n  } else {\n    Leaf(9)\n  }\n}\nlet main: () -> Int = () -> {\n  total(pick(true)) * 100 + total(pick(false))\n}")
  let _ = assert_bump_rc_agree(src, "spine_block", "709")
  ()
}

test "a conditional value is admitted when every branch allocates" {
  let src = String::concat(prelude, "let pick: (Bool, Bool) -> Node = (c, d) -> {\n  let t = if d {\n    Pair(Leaf(3), Leaf(4))\n  } else {\n    Pair(Leaf(1), Leaf(1))\n  }\n  if c {\n    t\n  } else {\n    Leaf(9)\n  }\n}\nlet main: () -> Int = () -> {\n  total(pick(true, true)) * 10000 + total(pick(true, false)) * 100 + total(pick(false, true))\n}")
  let _ = assert_bump_rc_agree(src, "spine_if", "70209")
  ()
}

test "one branch of a conditional value declining declines the binding" {
  // Every leaf has to answer yes. The `else` leaf calls a local closure, whose
  // name is not a top-level signature the heap-return scan can read, so the
  // binding fails closed even though the `then` leaf allocates at the site.
  let src = String::concat(prelude, "let pick: (Bool, Bool) -> Node = (c, d) -> {\n  let f: (Int) -> Node = (i) -> Pair(Leaf(i), Leaf(i))\n  let t = if d {\n    Pair(Leaf(1), Leaf(1))\n  } else {\n    f(2)\n  }\n  if c {\n    t\n  } else {\n    Leaf(9)\n  }\n}\nlet main: () -> Int = () -> {\n  total(pick(true, true)) * 10000 + total(pick(true, false)) * 100 + total(pick(false, false))\n}")
  let _ = assert_bump_rc_agree(src, "spine_mixed", "20409")
  ()
}

test "a callee with no top-level signature is declined and still answers" {
  // `f` is a local binding, not a top-level function, so #791's declared
  // return-type scan has nothing to say about it and the contract cannot be
  // read. The binding fails closed rather than being admitted on the "any
  // call is heap" default.
  let src = String::concat(prelude, "let pick: (Bool) -> Node = (c) -> {\n  let f: (Int) -> Node = (i) -> Pair(Leaf(i), Leaf(i + 1))\n  let t = f(3)\n  if c {\n    t\n  } else {\n    Leaf(9)\n  }\n}\nlet main: () -> Int = () -> {\n  total(pick(true)) * 100 + total(pick(false))\n}")
  let _ = assert_bump_rc_agree(src, "indirect", "709")
  ()
}
