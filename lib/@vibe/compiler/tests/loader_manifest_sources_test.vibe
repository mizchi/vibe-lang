//# Imports

import @vibe/compiler/loader {
  build_grouped_sources_from_manifest_row_source_index,
  build_grouped_sources_from_manifest_rows,
  build_manifest_path_index,
  build_manifest_source_index,
  filter_manifest_sources_by_path_index,
  filter_manifest_sources_by_paths,
  filter_manifest_sources_by_paths_linear,
  filter_manifest_sources_by_source_index,
  try_collect_manifest_source_groups_fs,
  try_collect_manifest_sources_fs
}

import @vibe/core {
  array_empty
}

//# Functions

fn string_to_bytes(s: String) -> Bytes {
  let out = array_empty()
  let len = String::length(s)
  let mut i = 0
  while i < len {
    Array::push(out, String::char_code_at(s, i))
    i = i + 1
  }
  Bytes::from_array(out)
}

fn has_source_path(sources: Array[(String, String)], target: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(sources) {
    let (path, _) = Array::get(sources, i)
    if path == target {
      found = true
      i = Array::length(sources)
    } else {
      i = i + 1
    }
  }
  found
}

fn find_group_sources(groups: Array[(String, Array[(String, String)])], target: String) -> Option[Array[(String, String)]] {
  let mut i = 0
  let mut found = None
  while i < Array::length(groups) {
    let (name, sources) = Array::get(groups, i)
    if name == target {
      found = Some(sources)
      i = Array::length(groups)
    } else {
      i = i + 1
    }
  }
  found
}

fn source_path_at(sources: Array[(String, String)], index: Int) -> String {
  let (path, _) = Array::get(sources, index)
  path
}

//# Misc

test "try_collect_manifest_sources_fs: skips manifest rows outside the dependency closure" {
  let base_dir = "/tmp/vibe_compiler_manifest_sources_closure"
  let manifest_path = String::concat(base_dir, "/compiler_sources_manifest.tsv")
  let helper_path = String::concat(base_dir, "/helper.vibe")
  let orphan_path = String::concat(base_dir, "/orphan.vibe")
  let main_path = String::concat(base_dir, "/main.vibe")
  Fs::mkdir_p(base_dir)
  Fs::write_bytes(manifest_path, string_to_bytes("# group\tpath\ncore\thelper.vibe\nmisc\torphan.vibe\nentry\tmain.vibe\n"))
  Fs::write_bytes(helper_path, string_to_bytes("export let add: () -> Int = () -> { 1 }"))
  Fs::write_bytes(orphan_path, string_to_bytes("export let dead: () -> Int = () -> { 0 }"))
  Fs::write_bytes(main_path, string_to_bytes("import ./helper.vibe { add }\nlet run: () -> Int = () -> { add() }"))
  match try_collect_manifest_sources_fs(main_path) {
    Some((_, sources)) => {
      assert(eq(Array::length(sources), 2))
      assert(has_source_path(sources, helper_path))
      assert(has_source_path(sources, main_path))
      assert(has_source_path(sources, orphan_path) == false)
    },
    None => assert(false)
  }
}

test "try_collect_manifest_sources_fs: does not read closure-external manifest rows" {
  let base_dir = "/tmp/vibe_compiler_manifest_sources_sparse"
  let manifest_path = String::concat(base_dir, "/compiler_sources_manifest.tsv")
  let helper_path = String::concat(base_dir, "/helper.vibe")
  let main_path = String::concat(base_dir, "/main.vibe")
  Fs::mkdir_p(base_dir)
  Fs::write_bytes(manifest_path, string_to_bytes("# group\tpath\ncore\thelper.vibe\nmisc\tmissing_orphan.vibe\nentry\tmain.vibe\n"))
  Fs::write_bytes(helper_path, string_to_bytes("export let add: () -> Int = () -> { 1 }"))
  Fs::write_bytes(main_path, string_to_bytes("import ./helper.vibe { add }\nlet run: () -> Int = () -> { add() }"))
  match try_collect_manifest_sources_fs(main_path) {
    Some((_, sources)) => {
      assert(eq(Array::length(sources), 2))
      assert(has_source_path(sources, helper_path))
      assert(has_source_path(sources, main_path))
    },
    None => assert(false)
  }
}

