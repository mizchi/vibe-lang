//# Functions

// #2441 (Codex round 1 on #2443): this module's `Point` is PRIVATE, so the
// FS merge renames it (`Point_dep_...`). The `==` below compares lambda
// call results of that type -- the typed-eq row for it must follow the
// rename, or a same-named type in the ENTRY file is dispatched instead.

struct Point {
  x: Int;
  y: Int
} derive (Eq)

export fn dep_eq_probe(a: Int, b: Int) -> Bool {
  let mk = (n: Int) -> Point::{ x: 1, y: n }
  mk(a) == mk(b)
}
