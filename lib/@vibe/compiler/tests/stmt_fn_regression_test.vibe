//# Imports

import @vibe/compiler/syntax {
  lex
}

import ../parser.vibe {
  parse_program
}

import ./stmt_test_support.vibe {
  ps
}

//# Misc

test "stmt_let_fn_typed" {
  let result = ps("let f: (Int) -> String = 1")
  assert(result == "let f: (Int) -> String = 1")
}

test "stmt_let_fn_value" {
  let result = ps("let f: (Int) -> Int = (x) -> { x }")
  assert(result == "let f: (Int) -> Int = (x) -> { x }")
}

test "stmt_let_fn_arrow_untyped" {
  let result = ps("let f = (x) -> x")
  assert(result == "let f = (x) -> { x }")
}

test "stmt_let_fn_block_typed" {
  let result = ps("let f = (x: Int) -> Int { x }")
  assert(result == "let f = (x: Int) -> Int { x }")
}
