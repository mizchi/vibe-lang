//# #1915 regression: compute_borrow_returning_names vs bare-ident branch
//# tails. The #707 fallback accepted ANY bare ident inside an if/match branch
//# tail as "safe to never drop" (designed for nullary-ctor sentinels like
//# TEof), but the same shape is also the most common owned-return in the
//# codebase (`let out: Array[Int] = []; ... if c { out } else { out }`), and
//# a borrow-returning classification makes every caller skip the scope-end
//# drop of an owned result -- one leaked object per call. The ident is now
//# resolved through the wrapper-spine `let` bindings; only provably-owned
//# bindings reject the function, everything ambiguous keeps the fallback.

import @vibe/parser {
  lex, parse_program
}

import @vibe/compiler/perceus {
  compute_borrow_returning_names
}

import @vibe/compiler/core {
  borrow_ret_builtin_names, is_borrow_ret_builtin
}

fn borrow_set_of(_ src: String) -> Array[String] with Exception {
  compute_borrow_returning_names(parse_program(lex(src)))
}

fn contains(names: Array[String], name: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(names) {
    if Array::get(names, at = i) == name {
      found = true
    } else {
      ()
    }
    i = i + 1
  }
  found
}

test "builder returned through if branches is not borrow-returning" {
  let src = "fn make(n: Int) -> Array[Int] {\n  let out: Array[Int] = []\n  let mut i = 0\n  while i < n {\n    Array::push(out, i)\n    i = i + 1\n  }\n  if n >= 0 {\n    out\n  } else {\n    out\n  }\n}\n"
  inspect(contains(names = borrow_set_of(src), name = "make"), "false")
}

test "owned-call binding returned through if branches is not borrow-returning" {
  let src = "fn helper(n: Int) -> Array[Int] {\n  [1, 2, 3]\n}\n\nfn make(n: Int) -> Array[Int] {\n  let out = helper(n)\n  if n >= 0 {\n    out\n  } else {\n    out\n  }\n}\n"
  inspect(contains(names = borrow_set_of(src), name = "make"), "false")
}

test "sentinel fallback around a borrowed access stays borrow-returning" {
  // The #707 peek shape: a bounds-check guard around Array::get with a bare
  // nullary-ctor identifier as the out-of-range fallback. The ident does not
  // resolve to a spine binding, so the safe fallback must survive.
  let src = "enum Tok {\n  TEof;\n  TInt(Int)\n}\n\nfn peek(tokens: Array[Tok], pos: Int) -> Tok {\n  if pos < Array::length(tokens) {\n    Array::get(tokens, pos)\n  } else {\n    TEof\n  }\n}\n"
  inspect(contains(names = borrow_set_of(src), name = "peek"), "true")
}

test "mut binding reassigned to a view stays borrow-returning" {
  // A `let mut` target is never resolved (its final value is flow-dependent);
  // rejecting it here would make callers drop a genuinely borrowed result.
  let src = "fn pick(a: Array[Array[Int]], i: Int) -> Array[Int] {\n  let mut out = Array::get(a, 0)\n  if i > 0 {\n    out = Array::get(a, i)\n  } else {\n    ()\n  }\n  if i >= 0 {\n    out\n  } else {\n    out\n  }\n}\n"
  inspect(contains(names = borrow_set_of(src), name = "pick"), "true")
}

test "borrowed-call binding returned through if branches stays borrow-returning" {
  let src = "fn head(a: Array[Array[Int]], i: Int) -> Array[Int] {\n  let v = Array::get(a, i)\n  if i >= 0 {\n    v\n  } else {\n    v\n  }\n}\n"
  inspect(contains(names = borrow_set_of(src), name = "head"), "true")
}

test "MutList::get binding returned through if branches stays borrow-returning" {
  // #1932 review: the `known` seed must carry the same builtins
  // is_borrow_ret_fname hardcodes -- MutList::get was missing, which would
  // classify this binding owned and make RC callers drop an interior view.
  let src = "fn head(l: Array[Array[Int]], i: Int) -> Array[Int] {\n  let v = MutList::get(l, i)\n  if i >= 0 {\n    v\n  } else {\n    v\n  }\n}\n"
  inspect(contains(names = borrow_set_of(src), name = "head"), "true")
}

test "Map iterator key views and their wrappers stay borrow-returning" {
  // The checked iterator primitive returns a String view into the Map's key
  // storage. Its codegen-only unchecked tail must carry the same ownership.
  // Treating either view as owned lets RC drop the same allocation once
  // through the wrapper result and again through the Map.
  inspect(is_borrow_ret_builtin("Map::iter_get"), "true")
  inspect(is_borrow_ret_builtin("Map::__iter_get_unchecked"), "true")
  let src = "fn key_at(m: Map[String, Int], i: Int) -> String {\n  Map::iter_get(m, i)\n}\n"
  inspect(contains(names = borrow_set_of(src), name = "key_at"), "true")
}

test "source-owned Map iterator accessors derive ownership from their bodies" {
  let owned = "fn Map::iter_get(_m: Int, _i: Int) -> String {\n  String::concat(\"owned\", \" result\")\n}\nfn Map::__iter_get_unchecked(_m: Int, _i: Int) -> String {\n  String::concat(\"owned\", \" result\")\n}\nfn checked_wrapper(m: Int, i: Int) -> String { Map::iter_get(m, i) }\nfn unchecked_wrapper(m: Int, i: Int) -> String { Map::__iter_get_unchecked(m, i) }\n"
  let owned_names = borrow_set_of(owned)
  inspect(contains(names = owned_names, name = "Map::iter_get"), "false")
  inspect(contains(names = owned_names, name = "Map::__iter_get_unchecked"), "false")
  inspect(contains(names = owned_names, name = "checked_wrapper"), "false")
  inspect(contains(names = owned_names, name = "unchecked_wrapper"), "false")
  let borrowed = "fn Map::iter_get(xs: Array[String], i: Int) -> String { Array::get(xs, i) }\nfn key_at(xs: Array[String], i: Int) -> String { Map::iter_get(xs, i) }\n"
  let borrowed_names = borrow_set_of(borrowed)
  inspect(contains(names = borrowed_names, name = "Map::iter_get"), "true")
  inspect(contains(names = borrowed_names, name = "key_at"), "true")
}

//# #4153: a borrow-returning tail is judged by what it reads into, not by its
//# callee alone. A read into a binding the function owns cannot be handed back
//# as a view -- the binding is released when the function returns -- so the
//# function is not borrow-returning. Classified as one, its branch tails were
//# freed by the binding's scope-end drop (a wrong answer on the RC lane), and
//# a direct projection tail leaked once per call. A read into a parameter is
//# still a view the caller keeps alive.
test "a branch tail that reads into a local let is not borrow-returning" {
  let src = "fn pick(i: Int) -> Array[Int] {\n  let v = [[i], [i + 1]]\n  if i > 0 {\n    Array::get(v, 0)\n  } else {\n    Array::get(v, 1)\n  }\n}\n"
  inspect(contains(names = borrow_set_of(src), name = "pick"), "false")
}

test "a projection tail into a local let is not borrow-returning" {
  let src = "fn pick(i: Int) -> Array[Int] {\n  let v = [[i], [i + 1]]\n  Array::get(v, 1)\n}\n"
  inspect(contains(names = borrow_set_of(src), name = "pick"), "false")
}

test "a view of a local, or a match binder of one, is not borrow-returning" {
  let alias = "fn pick(i: Int) -> Array[Int] {\n  let v = [[i], [i + 1]]\n  if i > 0 {\n    let w = Array::get(v, 0)\n    w\n  } else {\n    Array::get(v, 1)\n  }\n}\n"
  inspect(contains(names = borrow_set_of(alias), name = "pick"), "false")
  let binder = "enum S {\n  Full(Array[Array[Int]]);\n  Empty\n}\n\nfn pick(i: Int, d: Array[Array[Int]]) -> Array[Int] {\n  let s = Full([[i]])\n  match s {\n    Full(xss) => Array::get(xss, 0),\n    Empty => Array::get(d, 0)\n  }\n}\n"
  inspect(contains(names = borrow_set_of(binder), name = "pick"), "false")
}

test "a borrow-returning helper applied to a local is not borrow-returning" {
  let src = "fn first(xs: Array[Array[Int]]) -> Array[Int] {\n  Array::get(xs, 0)\n}\n\nfn pick(i: Int) -> Array[Int] {\n  let v = [[i], [i + 1]]\n  if i > 0 {\n    first(v)\n  } else {\n    Array::get(v, 1)\n  }\n}\n"
  let names = borrow_set_of(src)
  inspect(contains(names = names, name = "first"), "true")
  inspect(contains(names = names, name = "pick"), "false")
}

test "a bare name keeps the verdict: the owning-return marker may not retain it" {
  let src = "enum S {\n  Full(Array[Int]);\n  Empty\n}\n\nfn pick(i: Int, d: Array[Int]) -> Array[Int] {\n  match Some(Full([i])) {\n    Some(Full(xs)) => xs,\n    _ => d\n  }\n}\n"
  inspect(contains(names = borrow_set_of(src), name = "pick"), "true")
}

test "a long chain of views through a two-argument helper resolves once per name" {
  // Each binding passes the previous one twice; following every argument
  // occurrence separately doubled the work per binding, so 30 of them did
  // not finish. Every name is resolved once now.
  let mut src = "fn choose(a: Array[Array[Int]], b: Array[Array[Int]], c: Bool) -> Array[Array[Int]] {\n  if c {\n    a\n  } else {\n    b\n  }\n}\n\nfn pick(xs: Array[Array[Array[Int]]], c: Bool) -> Array[Array[Int]] {\n  let x0 = Array::get(xs, 0)\n"
  let mut i = 1
  while i <= 30 {
    src = src + "  let x" + Int::to_string(i) + " = choose(x" + Int::to_string(i - 1) + ", x" + Int::to_string(i - 1) + ", c)\n"
    i = i + 1
  }
  src = src + "  if c {\n    choose(x30, x30, c)\n  } else {\n    Array::get(xs, 1)\n  }\n}\n"
  let names = borrow_set_of(src)
  inspect(contains(names = names, name = "choose"), "true")
  inspect(contains(names = names, name = "pick"), "true")
}

test "a read into a parameter, through a view or a binder, stays borrow-returning" {
  let through_let = "fn pick(xs: Array[Array[Array[Int]]], i: Int) -> Array[Int] {\n  let w = Array::get(xs, 0)\n  if i > 0 {\n    Array::get(w, 0)\n  } else {\n    Array::get(w, 1)\n  }\n}\n"
  inspect(contains(names = borrow_set_of(through_let), name = "pick"), "true")
  let through_match = "enum S {\n  Full(Array[Array[Int]]);\n  Empty\n}\n\nfn pick(s: S, d: Array[Array[Int]]) -> Array[Int] {\n  match s {\n    Full(xss) => Array::get(xss, 0),\n    Empty => Array::get(d, 0)\n  }\n}\n"
  inspect(contains(names = borrow_set_of(through_match), name = "pick"), "true")
}

//# #1979 review: the two exported APIs must not be two spellings of the set.
//#
//# `is_borrow_ret_builtin` identifies intrinsic members;
//# `borrow_ret_builtin_names` seeds the wrapper fixed point. When they were an independent `||` chain and
//# an independent array literal, a builtin added to one and not the other
//# silently reintroduced the drift the consolidation removed -- and the two
//# partial updates fail in OPPOSITE directions, so neither is the safe one to
//# forget. The predicate now scans the list, and this pins that: an entry the
//# classifiers cannot see is the shape whose failure mode is an RC double-free
//# of an interior view.
test "every borrow-returning builtin name is recognized by the predicate" {
  let names = borrow_ret_builtin_names()
  let mut i = 0
  let mut all = true
  while i < Array::length(names) {
    if !is_borrow_ret_builtin(Array::get(names, at = i)) {
      all = false
    } else {
      ()
    }
    i = i + 1
  }
  inspect(all, "true")
  // A non-member must not be recognized -- otherwise `all` above would hold
  // for a predicate that simply returns true.
  inspect(is_borrow_ret_builtin("Array::push"), "false")
  inspect(Array::length(names) > 0, "true")
}
