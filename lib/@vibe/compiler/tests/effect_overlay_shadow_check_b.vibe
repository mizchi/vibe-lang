import ../core {
  Expr
}

import ../checker_effects.vibe {
  check_perform_effects_expr_tx
}

test "B: unshadowed callback param call is still flagged" {
  let call_f = ECall(EIdent("f", -1), [EIdent("x", -1)], -1)
  let errors = check_perform_effects_expr_tx(call_f, Array::slice([""], 0, 0), false, Array::slice([""], 0, 0), Array::slice([Array::slice([""], 0, 0)], 0, 0), ["f"], [["Fs"]])
  assert(Array::length(errors) == 1)
}
