//# Imports

import ./codegen_test_support.vibe {
  assert_wasm, compile_wasi_with_imports
}

//# Misc

test "wasi: enum import (separate module)" {
  let enum_source = "export enum Token { TInt(Int); TString(String); TPlus; TMinus; TEof }"
  let main_source = "let main: () -> Int = () -> {\n  let tok = TInt(42)\n  match tok {\n    TInt(n) => n,\n    TString(_) => -1,\n    TPlus => -2,\n    TMinus => -3,\n    TEof => -4\n  }\n}"
  let bytes = compile_wasi_with_imports([enum_source], main_source, "main")
  assert_wasm(bytes)
}

test "wasi: enum import 0-arg match" {
  let enum_source = "export enum Token { TInt(Int); TPlus; TMinus; TEof }"
  let main_source = "let main: () -> Int = () -> {\n  let tok = TPlus\n  match tok {\n    TInt(n) => n,\n    TPlus => 10,\n    TMinus => 20,\n    TEof => 30\n  }\n}"
  let bytes = compile_wasi_with_imports([enum_source], main_source, "main")
  assert_wasm(bytes)
}

test "wasi: real syntax/token.vibe enum import" {
  // #770 (#753 Phase B): lib/@vibe/compiler/syntax/token.vibe is now a thin
  // re-export shim over the @vibe/parser contract package (no `enum Token`
  // body of its own) — read the real definition from lib/@vibe/parser/token.vibe.
  let token_source = Fs::read_file("lib/@vibe/parser/token.vibe")
  let main_source = "let main: () -> Int = () -> {\n  let tok = TInt(99)\n  match tok {\n    TInt(n) => n,\n    TPlus => -1,\n    _ => -2\n  }\n}"
  let bytes = compile_wasi_with_imports([token_source], main_source, "main")
  assert_wasm(bytes)
}
