// #1967: pin that the old local `let` forward-ref fixtures still reject.
// Value claims live in fixtures/forward_reference_test.vibe via current `fn`.

//# Imports

import ./checker_parity_test_support.vibe {
  check_source_err_contains
}

//# Misc

test "local let function forward-ref is rejected" {
  assert(check_source_err_contains("fn main() -> Int {\n  let double_then_add = (x: Int) -> Int {\n    add_one(x * 2)\n  }\n  let add_one = (x: Int) -> Int {\n    x + 1\n  }\n  double_then_add(5)\n}", "unknown name: add_one"))
}

test "local let annotated value forward-ref is rejected" {
  assert(check_source_err_contains("fn main() -> Int {\n  let result: Int = base + offset\n  let base: Int = 40\n  let offset: Int = 2\n  result\n}", "unknown name: base"))
}

test "local let mutual recursion is rejected" {
  assert(check_source_err_contains("fn main() -> Bool {\n  let is_even = (n: Int) -> Bool {\n    if n == 0 { true } else { is_odd(n - 1) }\n  }\n  let is_odd = (n: Int) -> Bool {\n    if n == 0 { false } else { is_even(n - 1) }\n  }\n  is_even(10)\n}", "unknown name: is_odd"))
}

test "local let function forward-ref without return annotation is rejected" {
  assert(check_source_err_contains("fn main() -> Int {\n  let double_then_add = (x: Int) -> {\n    add_one(x * 2)\n  }\n  let add_one = (x: Int) -> Int {\n    x + 1\n  }\n  double_then_add(5)\n}", "unknown name: add_one"))
}
