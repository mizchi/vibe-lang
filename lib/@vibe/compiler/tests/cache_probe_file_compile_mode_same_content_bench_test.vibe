//# Imports

import ../file_compile_hotspot_probe.vibe {
  probe_file_compile_mode_same_content_counts
}

//# Misc

test "bench: file compile mode same-content counts" {
  let encoded = probe_file_compile_mode_same_content_counts()
  let parse_count = encoded / 1000
  let codegen_count = encoded % 1000
  assert(eq(parse_count, 0))
  assert(eq(codegen_count, 0))
}
