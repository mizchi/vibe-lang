import @vibe/compiler/codegen/common_base {
  CovState, LineMapState, cov_emit_branch, linemap_flush_fn_into
}
import @vibe/compiler/codegen/wasi {
  lc_commit_function_cov, lc_function_cov_new, lc_function_linemap_begin, lc_function_linemap_new
}

fn cov_error(src: CovState, dst: CovState, start: Int, owner: Int) -> String {
  handle {
    lc_commit_function_cov(src = src, dst = dst, start = start, owner = owner)
    "accepted"
  } with { Exception::Throw(msg) => msg }
}

fn add_row(lm: LineMapState, offset: Int, line: Int) -> Unit {
  Array::push(lm.funcs, value = Array::get(lm.cur_fn, at = 0))
  Array::push(lm.offsets, value = offset)
  Array::push(lm.file_ids, value = 1)
  Array::push(lm.lines, value = line)
}

fn byte_codes(_ b: Bytes) -> Array[Int] {
  let values: Array[Int] = []
  let mut i = 0
  while i < Bytes::length(b) {
    Array::push(values, value = Bytes::get(b, at = i))
    i = i + 1
  }
  values
}

test "coverage output is private until canonical publication" {
  let dst = lc_function_cov_new(base = 1024, cap = 4, start = 0, owner = 0)
  let first = lc_function_cov_new(base = 1024, cap = 4, start = 0, owner = 3)
  let code = Bytes::new()
  cov_emit_branch(buf = code, cov = first)
  cov_emit_branch(buf = code, cov = first)
  assert_eq(Array::get(dst.next, at = 0), 0)
  assert_eq(Array::length(dst.owners), 0)
  lc_commit_function_cov(src = first, dst = dst, start = 0, owner = 3)
  assert_eq(Array::get(dst.next, at = 0), 2)
  let owners: Array[Int] = dst.owners
  inspect(owners, "[3, 3]")
  // Direct emission and publication assign exactly the same addresses.
  let direct = lc_function_cov_new(base = 1024, cap = 4, start = 0, owner = 3)
  let expected = Bytes::new()
  cov_emit_branch(buf = expected, cov = direct)
  cov_emit_branch(buf = expected, cov = direct)
  assert(byte_codes(code) == byte_codes(expected))
}

test "coverage cap saturates across function boundaries" {
  let dst = lc_function_cov_new(base = 1024, cap = 2, start = 0, owner = 0)
  let first = lc_function_cov_new(base = 1024, cap = 2, start = 0, owner = 1)
  cov_emit_branch(buf = Bytes::new(), cov = first)
  lc_commit_function_cov(src = first, dst = dst, start = 0, owner = 1)
  let second = lc_function_cov_new(base = 1024, cap = 2, start = 1, owner = 2)
  let b = Bytes::new()
  cov_emit_branch(buf = b, cov = second)
  let before = Bytes::length(b)
  cov_emit_branch(buf = b, cov = second)
  assert_eq(Bytes::length(b), before)
  lc_commit_function_cov(src = second, dst = dst, start = 1, owner = 2)
  let full = lc_function_cov_new(base = 1024, cap = 2, start = 2, owner = 3)
  cov_emit_branch(buf = b, cov = full)
  lc_commit_function_cov(src = full, dst = dst, start = 2, owner = 3)
  assert_eq(Array::get(dst.next, at = 0), 2)
  let owners: Array[Int] = dst.owners
  inspect(owners, "[1, 2]")
}

test "coverage rejects a stale range and incomplete log without publication" {
  let dst = lc_function_cov_new(base = 1024, cap = 4, start = 0, owner = 0)
  let stale = lc_function_cov_new(base = 1024, cap = 4, start = 1, owner = 2)
  cov_emit_branch(buf = Bytes::new(), cov = stale)
  inspect(cov_error(src = stale, dst = dst, start = 1, owner = 2), "function coverage: range or owner log does not match publication order")
  let broken = lc_function_cov_new(base = 1024, cap = 4, start = 0, owner = 1)
  cov_emit_branch(buf = Bytes::new(), cov = broken)
  Array::truncate(broken.owners, length = 0)
  inspect(cov_error(src = broken, dst = dst, start = 0, owner = 1), "function coverage: range or owner log does not match publication order")
  assert_eq(Array::get(dst.next, at = 0), 0)
  assert_eq(Array::length(dst.owners), 0)
}

test "coverage validates all owners before publishing a valid prefix" {
  let dst = lc_function_cov_new(base = 1024, cap = 4, start = 0, owner = 0)
  let src = lc_function_cov_new(base = 1024, cap = 4, start = 0, owner = 3)
  cov_emit_branch(buf = Bytes::new(), cov = src)
  cov_emit_branch(buf = Bytes::new(), cov = src)
  Array::set(src.owners, at = 1, value = 7)
  inspect(cov_error(src = src, dst = dst, start = 0, owner = 3), "function coverage: branch belongs to a different function")
  assert_eq(Array::get(dst.next, at = 0), 0)
  assert_eq(Array::length(dst.owners), 0)
}

test "line maps completed in reverse order publish canonical encoded groups" {
  let dst = lc_function_linemap_new(true)
  let second = lc_function_linemap_new(true)
  lc_function_linemap_begin(lm = second, owner = 9)
  add_row(lm = second, offset = 3, line = 21)
  let first = lc_function_linemap_new(true)
  lc_function_linemap_begin(lm = first, owner = 2)
  add_row(lm = first, offset = 4, line = 9)
  add_row(lm = first, offset = 12, line = 11)
  assert_eq(Array::length(dst.grp_fn), 0)
  linemap_flush_fn_into(lm = first, dst = dst)
  linemap_flush_fn_into(lm = second, dst = dst)
  let grp_fn: Array[Int] = dst.grp_fn
  inspect(grp_fn, "[2, 9]")
  let grp_first_off: Array[Int] = dst.grp_first_off
  inspect(grp_first_off, "[4, 3]")
  let grp_start: Array[Int] = dst.grp_start
  inspect(grp_start, "[0, 6]")
  inspect(byte_codes(dst.stream), "[1, 9, 0, 8, 1, 11, 1, 21]")
  assert_eq(Array::length(dst.offsets), 0)
  assert_eq(Array::length(first.offsets), 0)
  assert_eq(Bytes::length(first.stream), 0)
}

test "reusing line scratch resets its owner and enclosing source site" {
  let dst = lc_function_linemap_new(true)
  let scratch = lc_function_linemap_new(true)
  lc_function_linemap_begin(lm = scratch, owner = 2)
  Array::set(scratch.site, at = 0, value = 999)
  add_row(lm = scratch, offset = 1, line = 10)
  let error = handle {
    lc_function_linemap_begin(lm = scratch, owner = 3)
    "accepted"
  } with { Exception::Throw(msg) => msg }
  inspect(error, "function linemap: previous rows have not been published")
  linemap_flush_fn_into(lm = scratch, dst = dst)
  lc_function_linemap_begin(lm = scratch, owner = 3)
  assert_eq(Array::get(scratch.site, at = 0), 0)
  add_row(lm = scratch, offset = 7, line = 20)
  linemap_flush_fn_into(lm = scratch, dst = dst)
  let grp_fn: Array[Int] = dst.grp_fn
  inspect(grp_fn, "[2, 3]")
  inspect(byte_codes(dst.stream), "[1, 10, 1, 20]")
}
