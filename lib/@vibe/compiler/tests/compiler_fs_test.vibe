test "compile_file_wasi_only: no profiler use reserves no profiler import" {
  let base_dir = "/tmp/vibe_compiler_profiler_no_import"
  let main_path = String::concat(base_dir, "/main.vibe")
  Fs::mkdir_p(base_dir)
  Fs::write_bytes(main_path, string_to_bytes("export let answer: () -> Int = () -> { 40 + 2 }\n"))
  let bytes = compile_file_wasi_only(main_path, "answer")
  assert_wasm_magic(bytes)
  assert(!bytes_contains_ascii(bytes, "profile-heap-bytes"))
  assert(!bytes_contains_ascii(bytes, "profile-now-us"))
}
