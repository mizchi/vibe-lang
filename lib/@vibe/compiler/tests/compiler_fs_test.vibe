//# Imports

import @vibe/core {
  array_empty
}

// #897: package-form import (wasi_only/ is now an index.vpkg boundary) --
// collect_linked_compile_inputs used to arrive via a separate leaf import of
// linked_artifacts.vibe, now merged into this one package-form import.
import @vibe/compiler/entry/source_compile/wasi_only {
  collect_linked_compile_inputs,
  compile_file_wasi_library,
  compile_file_wasi_linked_artifacts,
  compile_file_wasi_only,
  compile_source_wasi_only,
  merged_program_source_fs
}

//# Functions

fn string_to_bytes(s: String) -> Bytes {
  let out = array_empty()
  let len = String::length(s)
  let mut i = 0
  while i < len {
    Array::push(out, String::char_code_at(s, i))
    i = i + 1
  }
  Bytes::from_array(out)
}

fn assert_wasm_magic(bytes: Bytes) -> Unit {
  assert(Bytes::get(bytes, 0) == 0)
  assert(Bytes::get(bytes, 1) == 97)
  assert(Bytes::get(bytes, 2) == 115)
  assert(Bytes::get(bytes, 3) == 109)
}

fn bytes_contains_ascii(bytes: Bytes, needle: String) -> Bool {
  let blen = Bytes::length(bytes)
  let nlen = String::length(needle)
  let mut found = false
  let mut i = 0
  while i + nlen <= blen && !found {
    let mut j = 0
    let mut same = true
    while j < nlen && same {
      same = Bytes::get(bytes, i + j) == String::char_code_at(needle, j)
      j = j + 1
    }
    if same {
      found = true
    } else {
      i = i + 1
    }
  }
  found
}

//# Misc

test "compile_file_wasi_linked_artifacts: returns direct linked deps for library build" {
  let base_dir = "/tmp/vibe_compiler_linked_artifacts"
  let helper_path = String::concat(base_dir, "/lib.vibe")
  let main_path = String::concat(base_dir, "/main.vibe")
  Fs::mkdir_p(base_dir)
  Fs::write_bytes(helper_path, string_to_bytes("export let add: (Int, Int) -> Int = (a, b) -> { a + b }\n"))
  Fs::write_bytes(main_path, string_to_bytes("import ./lib.vibe { add }\nlet _start: () -> Int = () -> { add(1, 2) }\n"))
  let (entry_bytes, linked_imports, linked_dep_specs) = compile_file_wasi_linked_artifacts(main_path, "_start")
  assert_wasm_magic(entry_bytes)
  assert(Array::length(linked_imports) == 1)
  let (module_name, func_name, param_count, return_count) = Array::get(linked_imports, 0)
  assert(module_name == "lib")
  assert(func_name == "add")
  assert(param_count == 2)
  assert(return_count == 1)
  assert(Array::length(linked_dep_specs) == 1)
  let (dep_module_name, dep_path) = Array::get(linked_dep_specs, 0)
  assert(dep_module_name == "lib")
  assert(dep_path == helper_path)
  let lib_bytes = compile_file_wasi_library(dep_path)
  assert_wasm_magic(lib_bytes)
}

test "collect_linked_compile_inputs: captures linked dep metadata for debug/release flow" {
  let base_dir = "/tmp/vibe_compiler_linked_inputs"
  let helper_path = String::concat(base_dir, "/lib.vibe")
  let main_path = String::concat(base_dir, "/main.vibe")
  Fs::mkdir_p(base_dir)
  Fs::write_bytes(helper_path, string_to_bytes("export let add: (Int, Int) -> Int = (a, b) -> { a + b }\n"))
  Fs::write_bytes(main_path, string_to_bytes("import ./lib.vibe { add }\nlet _start: () -> Int = () -> { add(1, 2) }\n"))
  let (entry_stmts, resolved_type_stmts, linked_imports, linked_dep_specs) = collect_linked_compile_inputs(main_path)
  assert(Array::length(entry_stmts) == 2)
  assert(Array::length(resolved_type_stmts) == 0)
  assert(Array::length(linked_imports) == 1)
  let (module_name, func_name, param_count, return_count) = Array::get(linked_imports, 0)
  assert(module_name == "lib")
  assert(func_name == "add")
  assert(param_count == 2)
  assert(return_count == 1)
  assert(Array::length(linked_dep_specs) == 1)
  let (dep_module_name, dep_path) = Array::get(linked_dep_specs, 0)
  assert(dep_module_name == "lib")
  assert(dep_path == helper_path)
}

/// #711: `lib.vibe` exports an `eq` the entry file never imports/references.
/// Before the fix, `collect_linked_dep_artifacts` registered EVERY exported
/// top-level function of a directly-imported file into `linked_imports` --
/// not just the ones actually imported -- so this unrelated `eq` would land in
/// `linked_imports` (and from there `ctx.func_table.names`) and make
/// `prefer_bound_call` (compile_call.vibe) misfire for any unrelated bare
/// `eq(...)` call in this entry file, even though it neither defines nor
/// imports `eq`. Only the actually-imported `add` should be linked.
test "collect_linked_compile_inputs: does not register a dep's unimported export" {
  let base_dir = "/tmp/vibe_compiler_linked_inputs_unimported"
  let helper_path = String::concat(base_dir, "/lib.vibe")
  let main_path = String::concat(base_dir, "/main.vibe")
  Fs::mkdir_p(base_dir)
  Fs::write_bytes(helper_path, string_to_bytes("export let add: (Int, Int) -> Int = (a, b) -> { a + b }\nexport let eq: (Int, Int) -> Bool = (a, b) -> { a == b }\n"))
  Fs::write_bytes(main_path, string_to_bytes("import ./lib.vibe { add }\nlet _start: () -> Int = () -> { add(1, 2) }\n"))
  let (_, _, linked_imports, _) = collect_linked_compile_inputs(main_path)
  assert(Array::length(linked_imports) == 1)
  let (_, func_name, _, _) = Array::get(linked_imports, 0)
  assert(func_name == "add")
}

/// #718 review (Codex): `lib.vibe` re-exports `inner.vibe`'s `foo` under the
/// public alias `bar`. The entry imports `bar` (the public name), so `wanted`
/// contains "bar" while the re-export's own declared name is "foo" -- the
/// filter must match the PUBLIC alias, not the pre-rename declared name, or
/// this dep gets silently dropped from `linked_imports`.
test "collect_linked_compile_inputs: resolves an aliased re-export the entry imports by its public name" {
  let base_dir = "/tmp/vibe_compiler_linked_inputs_reexport_alias"
  let inner_path = String::concat(base_dir, "/inner.vibe")
  let lib_path = String::concat(base_dir, "/lib.vibe")
  let main_path = String::concat(base_dir, "/main.vibe")
  Fs::mkdir_p(base_dir)
  Fs::write_bytes(inner_path, string_to_bytes("export let foo: (Int, Int) -> Int = (a, b) -> { a + b }\n"))
  Fs::write_bytes(lib_path, string_to_bytes("export ./inner.vibe { foo as bar }\n"))
  Fs::write_bytes(main_path, string_to_bytes("import ./lib.vibe { bar }\nlet _start: () -> Int = () -> { bar(1, 2) }\n"))
  let (_, _, linked_imports, _) = collect_linked_compile_inputs(main_path)
  assert(Array::length(linked_imports) == 1)
  let (module_name, func_name, _, _) = Array::get(linked_imports, 0)
  assert(module_name == "lib")
  assert(func_name == "bar")
}

test "re-export aliases in a dependency do not suppress entry builtins" {
  let base_dir = "/tmp/vibe_compiler_reexport_alias_builtin_scope"
  let inner_path = String::concat(base_dir, "/inner.vibe")
  let facade_path = String::concat(base_dir, "/facade.vibe")
  let main_path = String::concat(base_dir, "/main.vibe")
  Fs::mkdir_p(base_dir)
  Fs::write_bytes(inner_path, string_to_bytes("export fn cmp(a: Int, b: Int) -> Int { a + b }\nexport fn view(a: Int, b: Int) -> Int { a + b }\n"))
  Fs::write_bytes(facade_path, string_to_bytes("export ./inner.vibe { cmp as assert_eq, view as inspect }\n"))
  Fs::write_bytes(main_path, string_to_bytes("import ./facade.vibe { assert_eq as forwarded_assert, inspect as forwarded_inspect }\nexport let answer: () -> Int with Stdout = () -> {\n  let _ = forwarded_assert(1, 2)\n  let _ = forwarded_inspect(1, 2)\n  inspect(1, \"1\")\n  assert_eq(1, 2)\n  0\n}\n"))
  let bytes = compile_file_wasi_only(main_path, "answer")
  assert_wasm_magic(bytes)
  assert(bytes_contains_ascii(bytes, "assert_eq failed"))
}

test "same-source imported assert_eq is not lowered as the builtin through FS merge" {
  let base_dir = "/tmp/vibe_compiler_imported_assert_eq_blocker"
  let dep_path = String::concat(base_dir, "/dep.vibe")
  let main_path = String::concat(base_dir, "/main.vibe")
  Fs::mkdir_p(base_dir)
  Fs::write_bytes(dep_path, string_to_bytes("export fn assert_eq(a: Int, b: Int) -> Int { a + b }\n"))
  Fs::write_bytes(main_path, string_to_bytes("import ./dep.vibe { assert_eq }\nexport fn answer() -> Int { assert_eq(1, 2) }\n"))
  let bytes = compile_file_wasi_only(main_path, "answer")
  assert_wasm_magic(bytes)
  inspect(bytes_contains_ascii(bytes, "assert_eq failed"), content = "false")
  let merged_bytes = compile_source_wasi_only(merged_program_source_fs(main_path), "answer")
  assert_wasm_magic(merged_bytes)
  inspect(bytes_contains_ascii(merged_bytes, "assert_eq failed"), content = "false")
}

