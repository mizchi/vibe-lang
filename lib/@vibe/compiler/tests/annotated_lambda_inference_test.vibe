import @vibe/compiler/core {
  Expr, Stmt, TypeExpr
}
import @vibe/compiler/perceus {
  elaborate_heap_params, type_expr_is_heap
}

fn elaborate_bytes(_ stmts: Array[Stmt]) -> Int with Profiler {
  let start = Profiler::heap_bytes()
  let result = elaborate_heap_params(stmts)
  let bytes = Profiler::heap_bytes() - start
  assert(Array::length(result) == 1)
  bytes
}

fn annotated_call_scan_extra(params: Array[(String, Option[TypeExpr])], recursive: Bool) -> Int with Profiler {
  let calls: Array[Expr] = []
  let mut i = 0
  while i < 128 {
    let args = if Array::length(params) == 0 {
      []
    } else {
      [EArray([EInt(i)])]
    }
    Array::push(calls, value = ECall(EIdent("local", -1), args, -1, []))
    i = i + 1
  }
  let body = ETuple(calls)
  let lambda = EFn([], [], params, None, None, EUnit)
  let local = if recursive {
    ELetRec("local", lambda, body)
  } else {
    ELet("local", lambda, body, -1)
  }
  let control = if recursive {
    ELetRec("local", EUnit, body)
  } else {
    ELet("local", EUnit, body, -1)
  }
  let local_stmts = [SExpr(local)]
  let control_stmts = [SExpr(control)]
  // Prepare both variants before measuring per-invocation inference overhead.
  // The first traversal can grow shared AST scratch, independently of whether
  // the lambda needs a call-site table. Both variants must see that capacity.
  let _ = elaborate_bytes(control_stmts)
  let _ = elaborate_bytes(local_stmts)
  let local_bytes = elaborate_bytes(local_stmts)
  let control_bytes = elaborate_bytes(control_stmts)
  local_bytes - control_bytes
}

test "annotated local lambdas allocate no call-site inference table" {
  // Allow fixed lambda overhead and RC free-list reuse, but not a
  // classification table for its 128 calls. No annotation can change.
  assert(annotated_call_scan_extra(params = [("p", Some(TyName("Int")))], recursive = false) <= 512)
  assert(annotated_call_scan_extra(params = [("p", Some(TyApp("Array", [TyName("Int")])))], recursive = true) <= 512)
  assert(annotated_call_scan_extra(params = [], recursive = false) <= 512)
  assert(annotated_call_scan_extra(params = [], recursive = true) <= 512)
  // Positive controls still allocate a table: preparing shared scratch must
  // not conceal the per-invocation work this regression test guards.
  assert(annotated_call_scan_extra(params = [("p", None)], recursive = false) > 512)
  assert(annotated_call_scan_extra(params = [("p", None)], recursive = true) > 512)
}

fn local_parameter_types(params: Array[(String, Option[TypeExpr])], args: Array[Expr], recursive: Bool) -> Array[Bool] {
  let lambda = EFn([], [], params, None, None, EUnit)
  let call = ECall(EIdent("local", -1), args, -1, [])
  let body = if recursive {
    ELetRec("local", lambda, call)
  } else {
    ELet("local", lambda, call, -1)
  }
  let out = elaborate_heap_params([SExpr(body)])
  let filled = match Array::get(out, at = 0) {
    SExpr(ELet(_, EFn(_, _, ps, _, _, _), _, _)) => ps,
    SExpr(ELetRec(_, EFn(_, _, ps, _, _, _), _)) => ps,
    _ => {
      assert(false)
      []
    }
  }
  let heaps: Array[Bool] = []
  let mut i = 0
  while i < Array::length(filled) {
    let (name, ty) = Array::get(filled, at = i)
    let (old_name, old_ty) = Array::get(params, at = i)
    assert(name == old_name)
    match old_ty {
      Some(_) => assert(ty == old_ty),
      None => ()
    }
    Array::push(heaps, value = type_expr_is_heap(ty))
    i = i + 1
  }
  heaps
}

test "annotated parameters stay exact while mixed lambdas still infer heap arguments" {
  let params = [("scalar", Some(TyName("Int"))), ("heap", None)]
  let args = [EInt(7), EArray([EInt(1)])]
  inspect(local_parameter_types(params = params, args = args, recursive = false), content = "[false, true]")
  inspect(local_parameter_types(params = params, args = args, recursive = true), content = "[false, true]")
  inspect(local_parameter_types(params = [("p", Some(TyName("Int")))], args = [EArray([])], recursive = false), content = "[false]")
  inspect(local_parameter_types(params = [("p", Some(TyApp("Array", [TyName("Int")])))], args = [
    EInt(0)
  ], recursive = true), content = "[true]")
  inspect(local_parameter_types(params = [], args = [], recursive = false), content = "[]")
}

test "annotated outer lambdas still elaborate unannotated inner lambdas" {
  let inner = ELet("inner", EFn([], [], [("p", None)], None, None, EUnit), ECall(EIdent("inner", -1), [
    EArray([EInt(1)])
  ], -1, []), -1)
  let outer = EFn([], [], [("n", Some(TyName("Int")))], None, None, inner)
  let out = elaborate_heap_params([SExpr(ELet("outer", outer, EUnit, -1))])
  match Array::get(out, at = 0) {
    SExpr(ELet(_, EFn(_, _, _, _, _, ELet(_, EFn(_, _, ps, _, _, _), _, _)), _, _)) => {
      let (_, ty) = Array::get(ps, at = 0)
      inspect(type_expr_is_heap(ty), content = "true")
    },
    _ => assert(false)
  }
}
