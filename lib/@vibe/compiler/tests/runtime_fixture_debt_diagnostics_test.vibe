test "effect_cps_accumulate: two-binder continuation arm is rejected" {
  inspect(check_source_error_message(effect_cps_accumulate_src()), "handler arm Yield::Yield expects 1 payload binding(s), got 2 — either drop the extra binder, or if it was meant as a non-tail continuation (k-convention): that is not supported by the build path; use resume(v) (#814, evidence-passing handlers #817)")
}

