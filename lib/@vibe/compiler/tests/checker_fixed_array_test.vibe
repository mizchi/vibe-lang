//# Imports

// #1140: FixedArray[T] gained real checker-level element-type tracking
// (checker.vibe's FixedArray::* ECall branches, mirroring FrozenArray's
// existing #906 phantom-type technique). Previously every FixedArray value
// degraded to CtArray(CtUnknown)/CtUnknown, so a `FixedArray::set` writing
// the wrong element type compiled clean and only failed (or silently
// corrupted) at runtime. This file exercises the runtime behavior, which
// codegen already implemented correctly (codegen/gc/backend_call.vibe,
// codegen/expr/compile_call.vibe) -- the gap closed here was purely the
// static element-type contract. A companion `err_type_*` fixture for the
// now-located compile error is not yet wired into scripts/compiler_gate.sh
// (follow-up).

//# Misc

test "fixed_array_basic" {
  let fa = FixedArray::make(3, 0)
  FixedArray::set(fa, 0, 10)
  FixedArray::set(fa, 1, 20)
  FixedArray::set(fa, 2, 30)
  assert(eq(FixedArray::get(fa, 0), 10))
  assert(eq(FixedArray::get(fa, 1), 20))
  assert(eq(FixedArray::get(fa, 2), 30))
  assert(eq(FixedArray::length(fa), 3))
}

test "fixed_array_unsafe_set" {
  let fa = FixedArray::make(2, "x")
  FixedArray::unsafe_set(fa, 0, "a")
  FixedArray::unsafe_set(fa, 1, "b")
  assert(FixedArray::get(fa, 0) == "a")
  assert(FixedArray::get(fa, 1) == "b")
}

test "fixed_array_blit" {
  let src = FixedArray::make(3, 1)
  FixedArray::set(src, 1, 2)
  FixedArray::set(src, 2, 3)
  let dst = FixedArray::make(3, 0)
  FixedArray::blit(dst, 0, src, 0, 3)
  assert(eq(FixedArray::get(dst, 0), 1))
  assert(eq(FixedArray::get(dst, 1), 2))
  assert(eq(FixedArray::get(dst, 2), 3))
}
