//# Imports

import ./parser_test_support.vibe {
  parse_print
}

//# Misc

test "parse if" {
  let result = handle {
    parse_print("if true { 1 } else { 2 }")
  } with Exception {
    Throw(e) => String::concat("ERROR: ", e)
  }
  assert(result == "if true { 1 } else { 2 }")
}

test "parse while" {
  let result = handle {
    parse_print("while x < 10 { x = x + 1; x }")
  } with Exception {
    Throw(e) => String::concat("ERROR: ", e)
  }
  assert(result == "while (x < 10) { { x = (x + 1); x } }")
}

test "parse for in" {
  let result = handle {
    parse_print("for item in items { item }")
  } with Exception {
    Throw(e) => String::concat("ERROR: ", e)
  }
  assert(result == "for item in items { item }")
}

test "parse handle" {
  let result = handle {
    parse_print("handle { f() } with Exception { Throw(msg) => msg }")
  } with Exception {
    Throw(e) => String::concat("ERROR: ", e)
  }
  assert(result == "handle { f() } with Exception { Throw(msg) => msg }")
}

test "parse block let" {
  let result = handle {
    parse_print("{ let x = 1; x }")
  } with Exception {
    Throw(e) => String::concat("ERROR: ", e)
  }
  assert(result == "{ let x = 1; x }")
}

test "parse match" {
  let result = handle {
    parse_print("match x { 1 => true, _ => false }")
  } with Exception {
    Throw(e) => String::concat("ERROR: ", e)
  }
  assert(result == "match x { 1 => true, _ => false }")
}
