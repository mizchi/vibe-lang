// #4042: a record of what the prelude's two passes did replays onto the same
// statements at other positions, and onto nothing else.
//
// Each program is parsed from its own text, so a comment in front shifts every
// offset as an edit earlier in the merged closure does. The "passes" here are
// stand-ins built from the input: a rewrite that drops a type annotation, and
// an appended copy of a statement under another name -- the two shapes the
// record has to carry.
import @vibe/compiler/codegen/wasi {
  prelude_reuse_arm,
  prelude_reuse_key_digest,
  prelude_reuse_outcome,
  prelude_reuse_passes,
  prelude_reuse_record_of,
  prelude_reuse_record_parts,
  prelude_reuse_replay,
  prelude_reuse_take,
  prelude_reuse_take_verified
}

import @vibe/compiler/entry/compiler/file_compile {
  prelude_reuse_decode, prelude_reuse_encode
}

import @vibe/compiler/normalize/desugar {
  prelude_statement_keys
}

import @vibe/compiler/core {
  Expr, Stmt
}

import @vibe/compiler/syntax {
  lex_with_offsets, parse_program_located
}

import @vibe/parser {
  stmt_located_offsets
}

fn parsed(_ src: String) -> Array[Stmt] with Exception {
  let (toks, starts, _) = lex_with_offsets(src)
  parse_program_located(tokens = toks, starts = starts, source = src)
}

let base_src = "fn f(x: Int) -> Int {\n  x + 1\n}\n\nfn g() -> Int {\n  f(2)\n}\n"

let moved_src = "// a comment that moves every offset below\n\nfn f(x: Int) -> Int {\n  x + 1\n}\n\nfn g() -> Int {\n  f(2)\n}\n"

/// `stmt`'s function without its declared result: a rewrite that keeps the
/// statement's own offsets.
fn unannotated(_ stmt: Stmt) -> Stmt {
  match stmt {
    SLet(e, r, name, ty, EFn(tps, tbs, params, _, eff, body)) => SLet(e, r, name, ty, EFn(tps, tbs, params, None, eff, body)),
    other => other
  }
}

/// `stmt` bound under `name`: an appended copy.
fn renamed(stmt: Stmt, name: String) -> Stmt {
  match stmt {
    SLet(e, r, _, ty, expr) => SLet(e, r, name, ty, expr),
    other => other
  }
}

/// The stand-in passes' output for `stmts`.
fn passes(_ stmts: Array[Stmt]) -> Array[Stmt] {
  [
    Array::get(stmts, at = 0),
    unannotated(Array::get(stmts, at = 1)),
    renamed(stmt = Array::get(stmts, at = 0), name = "f_copy")
  ]
}

fn no_ints() -> Array[Int] {
  []
}

fn no_keys() -> Array[String] {
  []
}

fn lowest(_ stmt: Stmt) -> Int {
  let mut low = -1
  for off in stmt_located_offsets(stmt) {
    if off >= 0 && (low < 0 || off < low) {
      low = off
    }
  }
  low
}

test "a record replays onto the same statements at other positions" {
  let base = parsed(base_src)
  let record = match prelude_reuse_record_of(header = "h", inputs = base, keys = prelude_statement_keys(stmts = base, row_offsets = no_ints(), row_keys = no_keys()), outputs = passes(base)) {
    Some(r) => r,
    None => {
      assert(false)
      return ()
    }
  }
  let (_, _, _, _, _, _, _, kinds, refs, _) = prelude_reuse_record_parts(record)
  inspect(kinds, content = "[0, 1, 2]")
  inspect(refs, content = "[0, 1, 0]")
  let moved = parsed(moved_src)
  // The comment moved both statements.
  assert(lowest(Array::get(moved, at = 0)) > lowest(Array::get(base, at = 0)))
  match prelude_reuse_replay(record = record, inputs = moved, keys = prelude_statement_keys(stmts = moved, row_offsets = no_ints(), row_keys = no_keys())) {
    Some(outs) => {
      // Exactly what the passes give for the moved program.
      assert(outs == passes(moved))
    },
    None => assert(false)
  }
}

test "an edited statement or a changed header does not replay" {
  let base = parsed(base_src)
  let record = match prelude_reuse_record_of(header = "h", inputs = base, keys = prelude_statement_keys(stmts = base, row_offsets = no_ints(), row_keys = no_keys()), outputs = passes(base)) {
    Some(r) => r,
    None => {
      assert(false)
      return ()
    }
  }
  let edited = parsed("fn f(x: Int) -> Int {\n  x + 1\n}\n\nfn g() -> Int {\n  f(3)\n}\n")
  inspect(prelude_reuse_replay(record = record, inputs = edited, keys = prelude_statement_keys(stmts = edited, row_offsets = no_ints(), row_keys = no_keys())) is None, content = "true")
  // A row the passes read for a statement is part of its key.
  let anchor = lowest(Array::get(base, at = 1))
  inspect(prelude_reuse_replay(record = record, inputs = base, keys = prelude_statement_keys(stmts = base, row_offsets = [
    anchor
  ], row_keys = ["Int"])) is None, content = "true")
  let fewer = [Array::get(base, at = 0)]
  inspect(prelude_reuse_replay(record = record, inputs = fewer, keys = prelude_statement_keys(stmts = fewer, row_offsets = no_ints(), row_keys = no_keys())) is None, content = "true")
}

test "a rewrite that brings in another statement's offsets is not recorded" {
  let base = parsed(base_src)
  // `g` rewritten to `f`'s body: its offsets are not `g`'s own, so moving it
  // with `g` would be wrong once the two statements move apart.
  let borrowed = match (Array::get(base, at = 0), Array::get(base, at = 1)) {
    (SLet(_, _, _, _, f_expr), SLet(e, r, name, ty, _)) => SLet(e, r, name, ty, f_expr),
    (_, other) => other
  }
  let outs = [Array::get(base, at = 0), borrowed]
  inspect(prelude_reuse_record_of(header = "h", inputs = base, keys = prelude_statement_keys(stmts = base, row_offsets = no_ints(), row_keys = no_keys()), outputs = outs) is None, content = "true")
}

test "a record survives being stored" {
  let base = parsed(base_src)
  let record = match prelude_reuse_record_of(header = "h", inputs = base, keys = prelude_statement_keys(stmts = base, row_offsets = no_ints(), row_keys = no_keys()), outputs = passes(base)) {
    Some(r) => r,
    None => {
      assert(false)
      return ()
    }
  }
  let bytes = prelude_reuse_encode(record)
  match prelude_reuse_decode(bytes) {
    Some(back) => {
      let moved = parsed(moved_src)
      match prelude_reuse_replay(record = back, inputs = moved, keys = prelude_statement_keys(stmts = moved, row_offsets = no_ints(), row_keys = no_keys())) {
        Some(outs) => assert(outs == passes(moved)),
        None => assert(false)
      }
    },
    None => assert(false)
  }
  // A truncated slot is no record.
  let short = Bytes::new()
  let mut i = 0
  while i + 1 < Bytes::length(bytes) {
    Bytes::push(short, value = Bytes::get(bytes, at = i))
    i = i + 1
  }
  inspect(prelude_reuse_decode(short) is None, content = "true")
}

test "a statement's digest tells apart integers that agree modulo a hash prime" {
  // 3147483647 - 1000000000 is 2147483647, the first hash's prime. Both are
  // ten digits, so nothing else in the statement moves either.
  let a = parsed("fn f() -> Int {\n  1000000000\n}\n")
  let b = parsed("fn f() -> Int {\n  3147483647\n}\n")
  let ka = Array::get(prelude_statement_keys(stmts = a, row_offsets = no_ints(), row_keys = no_keys()), at = 0)
  let kb = Array::get(prelude_statement_keys(stmts = b, row_offsets = no_ints(), row_keys = no_keys()), at = 0)
  inspect(prelude_reuse_key_digest(ka) == prelude_reuse_key_digest(kb), content = "false")
  // A negative value is told apart from its magnitude.
  let c = parsed("fn f() -> Int {\n  0 - 5\n}\n")
  let d = parsed("fn f() -> Int {\n  0 - 6\n}\n")
  inspect(prelude_reuse_key_digest(Array::get(prelude_statement_keys(stmts = c, row_offsets = no_ints(), row_keys = no_keys()), at = 0)) == prelude_reuse_key_digest(Array::get(prelude_statement_keys(stmts = d, row_offsets = no_ints(), row_keys = no_keys()), at = 0)), content = "false")
}

// #4042 stage 2: an edit the passes cannot see past the edited statement.
// The stand-in passes rewrite `f` and append a copy of it, so `f` is relevant
// and so is `g`, which reaches it; `h` is neither.
let edit_base = "fn f(x: Int) -> Int {\n  x + 1\n}\n\nfn g() -> Int {\n  f(2)\n}\n\nfn h(n: Int) -> Int {\n  n * 2\n}\n"

fn edit_passes(_ stmts: Array[Stmt]) -> Array[Stmt] {
  let out: Array[Stmt] = []
  let mut f_at = -1
  let mut i = 0
  for stmt in stmts {
    match stmt {
      SLet(_, _, name, _, _) => if name == "f" {
        f_at = i
        Array::push(out, value = unannotated(stmt))
      } else {
        Array::push(out, value = stmt)
      },
      _ => Array::push(out, value = stmt)
    }
    i = i + 1
  }
  if f_at >= 0 {
    Array::push(out, value = renamed(stmt = Array::get(stmts, at = f_at), name = "f_copy"))
  } else ()
  out
}

/// "replayed" for a replay that produced what the passes would, "wrong"
/// for one that did not.
fn replay_verdict(_ same: Bool) -> String {
  if same {
    "replayed"
  } else {
    "wrong"
  }
}

/// "replayed" when the record of `edit_base` replays onto `src` exactly as
/// the stand-in passes would produce it, "refused" when it does not replay,
/// "wrong" when it replays something else.
fn replays_onto(_ src: String) -> String with Exception {
  let base = parsed(edit_base)
  match prelude_reuse_record_of(header = "h", inputs = base, keys = prelude_statement_keys(stmts = base, row_offsets = no_ints(), row_keys = no_keys()), outputs = edit_passes(base)) {
    Some(record) => {
      let edited = parsed(src)
      match prelude_reuse_replay(record = record, inputs = edited, keys = prelude_statement_keys(stmts = edited, row_offsets = no_ints(), row_keys = no_keys())) {
        Some(outs) => replay_verdict(outs == edit_passes(edited)),
        None => "refused"
      }
    },
    None => "unrecordable"
  }
}

test "an edit of a statement nothing relevant reaches replays" {
  inspect(replays_onto("fn f(x: Int) -> Int {\n  x + 1\n}\n\nfn g() -> Int {\n  f(2)\n}\n\nfn h(n: Int) -> Int {\n  let m = n + 1\n  m * 3\n}\n"), content = "replayed")
  // A function added beside it.
  inspect(replays_onto("fn f(x: Int) -> Int {\n  x + 1\n}\n\nfn g() -> Int {\n  f(2)\n}\n\nfn h(n: Int) -> Int {\n  k(n) * 2\n}\n\nfn k(n: Int) -> Int {\n  n - 1\n}\n"), content = "replayed")
}

test "an edit the passes could see past the edited statement does not replay" {
  // `g` reaches `f`, which the passes rewrite.
  inspect(replays_onto("fn f(x: Int) -> Int {\n  x + 1\n}\n\nfn g() -> Int {\n  f(3)\n}\n\nfn h(n: Int) -> Int {\n  n * 2\n}\n"), content = "refused")
  // `h` starts calling `g`, and so reaches `f`.
  inspect(replays_onto("fn f(x: Int) -> Int {\n  x + 1\n}\n\nfn g() -> Int {\n  f(2)\n}\n\nfn h(n: Int) -> Int {\n  n * g()\n}\n"), content = "refused")
  // A local spelled like a top-level name moves the binder census.
  inspect(replays_onto("fn f(x: Int) -> Int {\n  x + 1\n}\n\nfn g() -> Int {\n  f(2)\n}\n\nfn h(n: Int) -> Int {\n  let g = n\n  g * 2\n}\n"), content = "refused")
  // A signature a caller reads.
  inspect(replays_onto("fn f(x: Int) -> Int {\n  x + 1\n}\n\nfn g() -> Int {\n  f(2)\n}\n\nfn h(n: Int, k: Int) -> Int {\n  n * k\n}\n"), content = "refused")
}

// #4123: a lowered `throw` (`perform <Exception>::Throw(..)`, the form the
// desugar gives it before the passes run) is not effect syntax; a perform of
// a user effect still is. `e` throws and `a` asks; `f` is rewritten by the
// stand-in passes as above.
fn row_src(e_head: String, e_body: String, a_body: String) -> String {
  "effect Ask {\n  Get() -> Int\n}\n\nfn f(x: Int) -> Int {\n  x + 1\n}\n\n" + e_head + " {\n  " + e_body + "\n}\n\nfn a(n: Int) -> Int with Ask {\n  " + a_body + "\n}\n\nfn h(n: Int) -> Int {\n  n * 2\n}\n"
}

let row_e = "fn e(n: Int) -> Int with Exception"

/// A body that throws `msg` the way the desugar lowers `throw(msg)`.
fn throws(_ msg: String) -> String {
  "if n < 0 {\n    let __exn_payload0 = \"" + msg + "\"\n    perform Exception::Throw(__exn_payload0)\n  } else {\n    n + 1\n  }"
}

/// `replays_onto`, from `row_src`'s unedited program instead of `edit_base`.
fn row_replays_onto(_ src: String) -> String with Exception {
  let base = parsed(row_src(e_head = row_e, e_body = throws("neg"), a_body = "perform Ask::Get() + n"))
  match prelude_reuse_record_of(header = "h", inputs = base, keys = prelude_statement_keys(stmts = base, row_offsets = no_ints(), row_keys = no_keys()), outputs = edit_passes(base)) {
    Some(record) => {
      let edited = parsed(src)
      match prelude_reuse_replay(record = record, inputs = edited, keys = prelude_statement_keys(stmts = edited, row_offsets = no_ints(), row_keys = no_keys())) {
        Some(outs) => replay_verdict(outs == edit_passes(edited)),
        None => "refused"
      }
    },
    None => "unrecordable"
  }
}

test "an edit inside a function that throws replays" {
  inspect(row_replays_onto(row_src(e_head = row_e, e_body = throws("negative"), a_body = "perform Ask::Get() + n")), content = "replayed")
  // It stops throwing: the declared row, which the passes read, is the same.
  inspect(row_replays_onto(row_src(e_head = row_e, e_body = "n + 1", a_body = "perform Ask::Get() + n")), content = "replayed")
}

test "an edit a user perform or a changed Exception row can see does not replay" {
  // An edit inside a function that performs a user effect.
  inspect(row_replays_onto(row_src(e_head = row_e, e_body = throws("neg"), a_body = "perform Ask::Get() + n + 1")), content = "refused")
  // Dropping `Exception` from the row changes the signature callers read.
  inspect(row_replays_onto(row_src(e_head = "fn e(n: Int) -> Int", e_body = throws("neg"), a_body = "perform Ask::Get() + n")), content = "refused")
  // A throw whose payload performs a user effect.
  inspect(row_replays_onto(row_src(e_head = row_e, e_body = "perform Exception::Throw(perform Ask::Get())", a_body = "perform Ask::Get() + n")), content = "refused")
  // Another generated binder is still refused.
  inspect(row_replays_onto(row_src(e_head = row_e, e_body = "let __show_v0 = n\n  __show_v0 + 1", a_body = "perform Ask::Get() + n")), content = "refused")
}

// #4130: the binders the desugar introduces with a fixed spelling do not keep
// an edit from replaying; any other generated (`__`) binder still does.
fn binder_src(_ e_body: String) -> String {
  row_src(e_head = "fn e(n: Int) -> Int", e_body = e_body, a_body = "perform Ask::Get() + n")
}

fn binder_replays_onto(_ e_body: String) -> String with Exception {
  let base = parsed(binder_src("n + 1"))
  match prelude_reuse_record_of(header = "h", inputs = base, keys = prelude_statement_keys(stmts = base, row_offsets = no_ints(), row_keys = no_keys()), outputs = edit_passes(base)) {
    Some(record) => {
      let edited = parsed(binder_src(e_body))
      match prelude_reuse_replay(record = record, inputs = edited, keys = prelude_statement_keys(stmts = edited, row_offsets = no_ints(), row_keys = no_keys())) {
        Some(outs) => replay_verdict(outs == edit_passes(edited)),
        None => "refused"
      }
    },
    None => "unrecordable"
  }
}

test "an edit binding a fixed desugar binder replays" {
  // A type ascription's identity closure.
  inspect(binder_replays_onto("((__asc: Int) -> __asc)(n) + 1"), content = "replayed")
  // A generated comparison's loop state and operands.
  inspect(binder_replays_onto("let __ae_i = n\n  let __oeq_l = __ae_i\n  __oeq_l + 1"), content = "replayed")
  // A derived comparison's field binders.
  inspect(binder_replays_onto("let __a0 = n\n  let __b12 = __a0\n  __b12 + 1"), content = "replayed")
}

test "an edit binding another generated name does not replay" {
  inspect(binder_replays_onto("let __teq_l0_ = n\n  __teq_l0_ + 1"), content = "refused")
  // `__a` followed by anything but digits is not a derived field binder.
  inspect(binder_replays_onto("let __ax = n\n  __ax + 1"), content = "refused")
  inspect(binder_replays_onto("let __a = n\n  __a + 1"), content = "refused")
}

test "an unedited statement between two edits is produced as the record has it" {
  // `f`, which the passes rewrite, sits between `a` and `h`, both edited.
  let base = parsed("fn a(n: Int) -> Int {\n  n\n}\n\nfn f(x: Int) -> Int {\n  x + 1\n}\n\nfn h(n: Int) -> Int {\n  n * 2\n}\n")
  let record = match prelude_reuse_record_of(header = "h", inputs = base, keys = prelude_statement_keys(stmts = base, row_offsets = no_ints(), row_keys = no_keys()), outputs = edit_passes(base)) {
    Some(r) => r,
    None => {
      assert(false)
      return ()
    }
  }
  let edited = parsed("fn a(n: Int) -> Int {\n  n + 7\n}\n\nfn f(x: Int) -> Int {\n  x + 1\n}\n\nfn h(n: Int) -> Int {\n  n * 3\n}\n")
  match prelude_reuse_replay(record = record, inputs = edited, keys = prelude_statement_keys(stmts = edited, row_offsets = no_ints(), row_keys = no_keys())) {
    Some(outs) => assert(outs == edit_passes(edited)),
    None => assert(false)
  }
}

/// Run the armed passes over `src`, with `run_passes` standing in for them,
/// and return what they left in the statements.
fn armed_run(src: String, run_passes: (Array[Stmt]) -> Array[Stmt]) -> Array[Stmt] with Exception {
  let stmts = parsed(src)
  let errs = prelude_reuse_passes(stmts = stmts, row_offsets = no_ints(), row_keys = no_keys(), header = "h", run = () -> {
    let outs = run_passes(Array::slice(stmts, start = 0, end = Array::length(stmts)))
    Array::truncate(stmts, length = 0)
    for o in outs {
      Array::push(stmts, value = o)
    }
    []
  })
  assert(Array::length(errs) == 0)
  stmts
}

test "verify replays, runs the passes as well, and leaves both" {
  prelude_reuse_arm(previous = None, verify = true)
  let _ = armed_run(src = base_src, run_passes = (xs) -> passes(xs))
  let record = prelude_reuse_take()
  inspect(prelude_reuse_take_verified() is None, content = "true")
  prelude_reuse_arm(previous = record, verify = true)
  let produced = armed_run(src = moved_src, run_passes = (xs) -> passes(xs))
  assert(String::starts_with(prelude_reuse_outcome(), prefix = "replayed"))
  match prelude_reuse_take_verified() {
    Some((replayed, fresh)) => {
      assert(replayed == fresh)
      assert(produced == fresh)
    },
    None => assert(false)
  }
  inspect(prelude_reuse_take() is Some(_), content = "true")
}

test "verify leaves a replay that differs from the passes beside their output" {
  prelude_reuse_arm(previous = None, verify = true)
  let _ = armed_run(src = base_src, run_passes = (xs) -> passes(xs))
  let record = prelude_reuse_take()
  // The passes now keep the annotation the record drops: the replay is stale.
  prelude_reuse_arm(previous = record, verify = true)
  let produced = armed_run(src = moved_src, run_passes = (xs) -> [
    Array::get(xs, at = 0),
    Array::get(xs, at = 1),
    renamed(stmt = Array::get(xs, at = 0), name = "f_copy")
  ])
  match prelude_reuse_take_verified() {
    Some((replayed, fresh)) => {
      assert(replayed != fresh)
      // The build is given the passes' output, not the replay.
      assert(produced == fresh)
    },
    None => assert(false)
  }
  let _ = prelude_reuse_take()
}
