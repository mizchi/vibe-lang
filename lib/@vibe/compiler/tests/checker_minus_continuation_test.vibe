//# Imports

import ./checker_parity_test_support.vibe {
  check_source_err_contains, check_source_error_message, check_source_ok
}

//# Misc

// #2206, #3041: a line-leading `- 1` (minus, then a space) is a binary minus
// that continues the previous expression, so the checker sees `f() - 1` with
// a Unit LHS. The diagnostic must name the continuation rule and the edits
// (drop the space, or `(-1)`); the base text stays a prefix so existing
// substring pins keep matching. A line-leading `-1` with no space is a
// prefix minus that starts a new expression (#3041), so it type-checks.

test "unit lhs minus names the line continuation" {
  let src = "fn f() -> Unit { () }\nfn main() -> Int {\n  let v = {\n    f()\n    - 1\n  }\n  v\n}"
  assert(check_source_err_contains(source = src, needle = "type mismatch in '-': operands must be Int or Float64"))
  assert(check_source_err_contains(source = src, needle = "the left operand is Unit"))
  assert(check_source_err_contains(source = src, needle = "continues the previous line's expression"))
  assert(check_source_err_contains(source = src, needle = "remove the space"))
  assert(check_source_err_contains(source = src, needle = "parenthesize the negated value"))
}

test "non-unit lhs minus keeps the plain message" {
  // String - String misses every candidate but the LHS is not Unit, so
  // the continuation clause must NOT appear.
  let src = "fn main() -> Int {\n  let s = \"a\" - \"b\"\n  0\n}"
  assert(check_source_err_contains(source = src, needle = "type mismatch in '-': operands must be Int or Float64"))
  let msg = check_source_error_message(src)
  assert(!String::contains(msg, needle = "the left operand is Unit"))
}

test "line-leading tight negative literal starts a new expression" {
  let src = "fn f() -> Unit { () }\nfn main() -> Int {\n  let v = {\n    f()\n    -1\n  }\n  v\n}"
  assert(check_source_ok(src))
}

test "parenthesized negative literal repairs the glue" {
  let src = "fn f() -> Unit { () }\nfn main() -> Int {\n  let v = {\n    f()\n    (-1)\n  }\n  v\n}"
  assert(check_source_ok(src))
}
