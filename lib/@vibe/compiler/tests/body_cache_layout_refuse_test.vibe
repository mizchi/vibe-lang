//# `lc_layout_refuse` (#3771): which harvested bodies a changed struct
//# withholds from the replay. A body is withheld when it read a changed
//# layout, and when it carries no layout record at all -- "the log was not
//# on" is an unknown, not an empty read set.

import @vibe/compiler/codegen/common_base {
  CodegenBodyCache, codegen_body_cache_new, layout_read_sym
}

import @vibe/compiler/codegen/reloc {
  blind_kind_layout_read, blind_kind_str_ref
}

import @vibe/compiler/codegen/wasi {
  lc_layout_refuse
}

fn blr_record(c: CodegenBodyCache, f: Int, kind: Int, sym: Int) -> Unit {
  Array::push(c.blind_fn, f)
  Array::push(c.blind_body, f)
  Array::push(c.blind_offsets, 0)
  Array::push(c.blind_kinds, kind)
  Array::push(c.blind_syms, sym)
}

fn blr_flags(layout: Array[String]) -> String {
  let c = codegen_body_cache_new()
  let mut f = 0
  while f < 4 {
    Array::push(c.fn_indices, f)
    f = f + 1
  }
  // 0 read `.y`; 1 read only `Other`; 2 has no layout record (a string
  // reference alone); 3 read `BcsPt`.
  blr_record(c, 0, blind_kind_layout_read, 0)
  blr_record(c, 0, blind_kind_layout_read, layout_read_sym(".y"))
  blr_record(c, 1, blind_kind_layout_read, 0)
  blr_record(c, 1, blind_kind_layout_read, layout_read_sym("Other"))
  blr_record(c, 2, blind_kind_str_ref, 5)
  blr_record(c, 3, blind_kind_layout_read, 0)
  blr_record(c, 3, blind_kind_layout_read, layout_read_sym("BcsPt"))
  let flags = [1, 1, 1, 1]
  lc_layout_refuse(flags, c, layout)
  String::join(for v in flags {
    __to_string(v)
  }, "")
}

test "a body that read a changed layout, or carries no record, is withheld" {
  inspect(blr_flags(["BcsPt", ".y"]), content = "0100")
}

test "nothing changed withholds nothing, the unrecorded body included" {
  inspect(blr_flags([]), content = "1111")
}
