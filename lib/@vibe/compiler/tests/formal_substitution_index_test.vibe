import @vibe/compiler/core {
  Subst, Type
}

import @vibe/compiler/checker {
  callee_formal_bindings,
  callee_formal_marked_bindings,
  callee_formal_query_subst,
  callee_inst_types_cell,
  record_eq_formal_var,
  reset_eq_formal_vars
}

fn fill_calls(_ count: Int) -> Unit {
  Array::truncate(callee_inst_types_cell, length = 0)
  let scheme = CtForAll([0], [], CtFn([CtVar(0)], CtInt, Some("State[S$0]")))
  let inst = CtFn([CtVar(7)], CtInt, Some("State[S$0]"))
  let mut i = 0
  while i < count {
    Array::push(callee_inst_types_cell, value = (i, scheme, inst, "get"))
    i = i + 1
  }
}

test "small formal tables keep the original substitution" {
  fill_calls(255)
  let s = SubstBind(7, CtString, SubstEmpty)
  assert(callee_formal_query_subst(s) is SubstBind(_, _, _))
  Array::truncate(callee_inst_types_cell, length = 0)
}

test "large formal tables preserve display and marked publication rows" {
  fill_calls(256)
  let s = SubstBind(7, CtString, SubstEmpty)
  let before = callee_formal_bindings(defs = [], s = s)
  let marked_before = callee_formal_marked_bindings(defs = [], s = s)
  let snapshot = callee_formal_query_subst(s)
  assert(snapshot is SubstCached(_, _, _))
  assert(before == callee_formal_bindings(defs = [], s = snapshot))
  assert(marked_before == callee_formal_marked_bindings(defs = [], s = snapshot))
  assert_eq(Array::length(before), 256)
  let (_, first) = Array::get(before, at = 0)
  assert_true(Array::length(first) > 0)
  Array::truncate(callee_inst_types_cell, length = 0)
}

// Representative reuse belongs to one publication, not the next completed
// check: variable ids and binder records can both change between calls.
test "formal publication recomputes representatives for each invocation" {
  reset_eq_formal_vars()
  fill_calls(3)
  record_eq_formal_var(vid = 7, name = "Outer", arity = 0, gid = 0, rigid = false)
  let first = callee_formal_bindings(defs = [], s = SubstEmpty)
  assert(first == [
    ("0:get", [("S$0", "Outer")]),
    ("1:get", [("S$0", "Outer")]),
    ("2:get", [("S$0", "Outer")])
  ])
  let concrete = callee_formal_bindings(defs = [], s = SubstBind(7, CtString, SubstEmpty))
  assert(concrete == [
    ("0:get", [("S$0", "String")]),
    ("1:get", [("S$0", "String")]),
    ("2:get", [("S$0", "String")])
  ])
  reset_eq_formal_vars()
  record_eq_formal_var(vid = 7, name = "Inner", arity = 0, gid = 0, rigid = false)
  let renamed = callee_formal_bindings(defs = [], s = SubstEmpty)
  let (_, renamed_first) = Array::get(renamed, at = 0)
  assert(renamed_first == [("S$0", "Inner")])
  let (_, retained_first) = Array::get(first, at = 0)
  assert(retained_first == [("S$0", "Outer")])
  record_eq_formal_var(vid = 8, name = "Other", arity = 0, gid = 0, rigid = false)
  let clashed = callee_formal_bindings(defs = [], s = SubstBind(8, CtVar(7), SubstEmpty))
  for entry in clashed {
    let (_, texts) = entry
    assert_eq(Array::length(texts), 0)
  }
  Array::truncate(callee_inst_types_cell, length = 0)
  assert_eq(Array::length(callee_formal_bindings(defs = [], s = SubstEmpty)), 0)
  reset_eq_formal_vars()
}

// Display substitution drops a partly unresolved tuple. Its fallback must
// still distinguish a binder's formal from the ordinary inference variable.
test "partial callee arguments preserve formal spelling across publications" {
  reset_eq_formal_vars()
  fill_calls(1)
  let scheme = CtForAll([0], [], CtFn([CtVar(0)], CtInt, Some("State[S$0]")))
  let inst = CtFn([CtTuple([CtVar(7), CtVar(9)])], CtInt, Some("State[S$0]"))
  Array::set(callee_inst_types_cell, at = 0, value = (0, scheme, inst, "get"))
  record_eq_formal_var(vid = 7, name = "Outer", arity = 0, gid = 0, rigid = false)
  assert(callee_formal_bindings(defs = [], s = SubstEmpty) == [
    ("0:get", [("S$0", "(Outer, _)")])
  ])
  reset_eq_formal_vars()
  record_eq_formal_var(vid = 7, name = "Inner", arity = 0, gid = 0, rigid = false)
  assert(callee_formal_bindings(defs = [], s = SubstEmpty) == [
    ("0:get", [("S$0", "(Inner, _)")])
  ])
  record_eq_formal_var(vid = 8, name = "Other", arity = 0, gid = 0, rigid = false)
  let s = SubstBind(8, CtVar(7), SubstEmpty)
  assert(callee_formal_bindings(defs = [], s = s) == [
    ("0:get", [("S$0", "(_, _)")])
  ])
  Array::truncate(callee_inst_types_cell, length = 0)
  reset_eq_formal_vars()
}
