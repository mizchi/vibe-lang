//# Strict checked expression-structure artifact v1

import @vibe/compiler/checker {
  CheckedProgram
}

import @vibe/compiler/checker/artifacts {
  canonical_checked_expression_structure_artifact_snapshot,
  canonical_checked_expression_structure_snapshot,
  checked_expression_structure_artifact_expression_path_at,
  checked_expression_structure_artifact_from_observation,
  checked_expression_structure_artifact_kind_at,
  checked_expression_structure_artifact_row_count,
  checked_expression_structure_artifact_statement_path_at,
  checked_expression_structure_observation,
  decode_checked_expression_structure_artifact_v1,
  encode_checked_expression_structure_artifact_v1
}

import @vibe/compiler/core {
  EnvEmpty, Expr, Stmt, SubstEmpty
}

fn artifact_checked_with(_ stmts: Array[Stmt]) -> CheckedProgram {
  CheckedProgram::{
    checked_stmts: stmts,
    final_env: EnvEmpty,
    type_defs: [],
    final_subst: SubstEmpty,
    typed_occurrences: []
  }
}

fn artifact_push_piece(out: StringBuilder, text: String) -> Unit {
  StringBuilder::push(out, value = __to_string(String::length(text)))
  StringBuilder::push(out, value = ":")
  StringBuilder::push(out, value = text)
}

fn artifact_push_path(out: StringBuilder, path: Array[Int]) -> Unit {
  StringBuilder::push(out, value = __to_string(Array::length(path)))
  StringBuilder::push(out, value = "[")
  let mut i = 0
  while i < Array::length(path) {
    StringBuilder::push(out, value = __to_string(Array::get(path, at = i)))
    StringBuilder::push(out, value = ":")
    i = i + 1
  }
  StringBuilder::push(out, value = "]")
}

fn artifact_entry(statement_path: Array[Int], expression_path: Array[Int], kind: String) -> String {
  let out = StringBuilder::new()
  artifact_push_path(out = out, path = statement_path)
  artifact_push_path(out = out, path = expression_path)
  artifact_push_piece(out = out, text = kind)
  StringBuilder::freeze(out)
}

fn artifact_payload(_ entries: Array[String]) -> String {
  let out = StringBuilder::new()
  StringBuilder::push(out, value = "vibe-checked-expression-structure-artifact:v1\n")
  StringBuilder::push(out, value = __to_string(Array::length(entries)))
  StringBuilder::push(out, value = "[")
  let mut i = 0
  while i < Array::length(entries) {
    artifact_push_piece(out = out, text = Array::get(entries, at = i))
    i = i + 1
  }
  StringBuilder::push(out, value = "]")
  StringBuilder::freeze(out)
}

fn assert_decode_none(_ text: String) -> Unit {
  match decode_checked_expression_structure_artifact_v1(text) {
    None => (),
    Some(_) => assert(false)
  }
}

fn assert_path(actual: Option[Array[Int]], expected: Array[Int]) -> Unit {
  match actual {
    Some(path) => {
      assert(Array::length(path) == Array::length(expected))
      let mut i = 0
      while i < Array::length(path) {
        assert(Array::get(path, at = i) == Array::get(expected, at = i))
        i = i + 1
      }
    },
    None => assert(false)
  }
}

fn one_root_artifact(_ expr: Expr) -> String {
  match checked_expression_structure_observation(artifact_checked_with([
    SExpr(expr)
  ])) {
    Some(observation) => match checked_expression_structure_artifact_from_observation(observation) {
      Some(artifact) => encode_checked_expression_structure_artifact_v1(artifact),
      None => ""
    },
    None => ""
  }
}

test "observation becomes an exact canonical structure artifact" {
  let checked = artifact_checked_with([
    SModule(false, "M", [
      SExpr(EIf(EIdent("c", 1), ECall(EIdent("f", 2), [EInt(1)], 3, []), EUnit))
    ])
  ])
  match checked_expression_structure_observation(checked) {
    Some(observation) => match checked_expression_structure_artifact_from_observation(observation) {
      Some(artifact) => {
        assert(checked_expression_structure_artifact_row_count(artifact) == 6)
        assert(canonical_checked_expression_structure_artifact_snapshot(artifact) == canonical_checked_expression_structure_snapshot(observation))
        let encoded = encode_checked_expression_structure_artifact_v1(artifact)
        match decode_checked_expression_structure_artifact_v1(encoded) {
          Some(decoded) => {
            assert(encode_checked_expression_structure_artifact_v1(decoded) == encoded)
            assert(canonical_checked_expression_structure_artifact_snapshot(decoded) == canonical_checked_expression_structure_snapshot(observation))
          },
          None => assert(false)
        }
      },
      None => assert(false)
    },
    None => assert(false)
  }
}

test "opaque accessors preserve nested and empty paths and return copies" {
  let text = artifact_payload([
    artifact_entry(statement_path = [0, 2], expression_path = [], kind = "EStringInterp")
  ])
  match decode_checked_expression_structure_artifact_v1(text) {
    Some(artifact) => {
      assert_path(actual = checked_expression_structure_artifact_statement_path_at(artifact = artifact, row_index = 0), expected = [
        0,
        2
      ])
      assert_path(actual = checked_expression_structure_artifact_expression_path_at(artifact = artifact, row_index = 0), expected = [
      ])
      match checked_expression_structure_artifact_statement_path_at(artifact = artifact, row_index = 0) {
        Some(path) => Array::set(path, at = 0, value = 99),
        None => assert(false)
      }
      assert_path(actual = checked_expression_structure_artifact_statement_path_at(artifact = artifact, row_index = 0), expected = [
        0,
        2
      ])
      match checked_expression_structure_artifact_kind_at(artifact = artifact, row_index = 0) {
        Some(kind) => assert(kind == "EStringInterp"),
        None => assert(false)
      }
      match checked_expression_structure_artifact_statement_path_at(artifact = artifact, row_index = -1) {
        None => (),
        Some(_) => assert(false)
      }
      match checked_expression_structure_artifact_kind_at(artifact = artifact, row_index = 1) {
        None => (),
        Some(_) => assert(false)
      }
    },
    None => assert(false)
  }
}

test "all closed expression constructor tags decode" {
  let kinds = [
    "EInt",
    "EFloat",
    "EString",
    "EBool",
    "EIdent",
    "ETuple",
    "EArray",
    "ERecord",
    "EIf",
    "ELet",
    "ELetRec",
    "ELetMut",
    "EAssign",
    "EAssignOp",
    "ESeq",
    "EMatch",
    "EHandle",
    "EWhile",
    "ELoop",
    "EForIn",
    "ECall",
    "EBinOp",
    "EUnaryOp",
    "EFn",
    "EDot",
    "ELabeledArg",
    "EReturn",
    "EBreak",
    "EContinue",
    "EMap",
    "ESpread",
    "EStringInterp",
    "EUnit"
  ]
  let entries = []
  let mut i = 0
  while i < Array::length(kinds) {
    Array::push(entries, value = artifact_entry(statement_path = [i], expression_path = [
      0
    ], kind = Array::get(kinds, at = i)))
    i = i + 1
  }
  let text = artifact_payload(entries)
  match decode_checked_expression_structure_artifact_v1(text) {
    Some(artifact) => assert(encode_checked_expression_structure_artifact_v1(artifact) == text),
    None => assert(false)
  }
  assert(String::length(one_root_artifact(EUnit)) > 0)
}

test "unknown tags and negative paths fail closed" {
  assert_decode_none(artifact_payload([
    artifact_entry(statement_path = [], expression_path = [], kind = "EUnknown")
  ]))
  assert_decode_none(artifact_payload(["1[-1:]0[]4:EInt"]))
}

test "path Int maximum is canonical and overflow fails closed" {
  let maximum = artifact_payload([
    artifact_entry(statement_path = [2305843009213693951], expression_path = [], kind = "EInt")
  ])
  match decode_checked_expression_structure_artifact_v1(maximum) {
    Some(artifact) => assert(encode_checked_expression_structure_artifact_v1(artifact) == maximum),
    None => assert(false)
  }
  assert_decode_none(artifact_payload(["1[4611686018427387904:]0[]4:EInt"]))
}

test "wrong version truncation trailing bytes and noncanonical numbers fail closed" {
  assert_decode_none("vibe-checked-expression-structure-artifact:v2\n0[]")
  assert_decode_none("vibe-checked-expression-structure-artifact:v1\n1[")
  assert_decode_none(String::concat(artifact_payload([]), "x"))
  assert_decode_none("vibe-checked-expression-structure-artifact:v1\n00[]")
  assert_decode_none(artifact_payload(["01[0:]0[]4:EInt"]))
  assert_decode_none(artifact_payload(["0[]0[]04:EInt"]))
}

test "hostile outer path and piece lengths stop at unavailable input" {
  assert_decode_none("vibe-checked-expression-structure-artifact:v1\n2305843009213693951[")
  assert_decode_none(artifact_payload(["2305843009213693951["]))
  assert_decode_none("vibe-checked-expression-structure-artifact:v1\n1[2305843009213693951:")
}
