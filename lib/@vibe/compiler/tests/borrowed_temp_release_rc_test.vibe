//# Imports

// #2682: an OWNED temporary handed straight to a BORROWED argument position
// (`Array::length(build_arr(3))`) was dropped by nobody: the borrowed
// position takes no ownership and no binding holds the value. The
// resolved-call path now parks such a temporary in a local and releases it
// after the call -- unless the callee may return a view of its argument
// (Array::get, a user fn in the borrow_ret / view_ret sets), where the
// leak stays the safe side. These programs pin that the release never
// frees something still in use: bump, RC and RC-shadow must agree. The
// heap side is pinned by fixtures/rc_reclaim_leak_test.vibe.

import ./codegen_test_support.vibe {
  compile_wasi, compile_wasi_rc, compile_wasi_rc_shadow
}

//# Functions

fn run_value(bytes: Bytes, label: String) -> String with Fs + Process {
  let path = String::concat("/tmp/_borrowed_temp_rc_", String::concat(label, ".wasm"))
  Fs::write_bytes(path, bytes)
  let out = sh_lines(String::concat("wasmtime run -W exceptions=y --invoke main ", String::concat(path, " 0 2>/dev/null")))
  if Array::length(out) > 0 {
    Array::get(out, 0)
  } else {
    "<no output>"
  }
}

fn assert_lanes_agree(src: String, label: String, expected: String) -> Int with Exception + Fs + Process + Stdout {
  let bump = run_value(compile_wasi(src, "main"), String::concat(label, "_bump"))
  let rc = run_value(compile_wasi_rc(src, "main"), String::concat(label, "_rc"))
  let shadow = run_value(compile_wasi_rc_shadow(src, "main"), String::concat(label, "_shadow"))
  inspect(bump, content = expected)
  inspect(rc, content = expected)
  inspect(shadow, content = expected)
  0
}

fn prelude() -> String {
  "enum Tree {\n  Leaf(Int);\n  Node(Tree, Tree)\n}\nfn incr(t: Tree) -> Tree {\n  match t {\n    Leaf(v) => Leaf(v + 1),\n    Node(l, r) => Node(incr(l), incr(r))\n  }\n}\nfn sumt(t: Tree) -> Int {\n  match t {\n    Leaf(v) => v,\n    Node(l, r) => sumt(l) + sumt(r)\n  }\n}\nfn build_arr(n: Int) -> Array[Int] {\n  let out: Array[Int] = []\n  let mut j = 0\n  while j < n {\n    Array::push(out, j)\n    j = j + 1\n  }\n  out\n}\nfn first(xs: Array[Int]) -> Int {\n  Array::get(xs, 0)\n}\nfn head_tree(xs: Array[Tree]) -> Tree {\n  Array::get(xs, 0)\n}\n"
}

test "a fresh array handed to Array::length (#2682)" {
  let src = String::concat(prelude(), "let main = () -> Int {\n  let mut total = 0\n  let mut i = 0\n  while i < 2000 {\n    total = total + Array::length(build_arr(3))\n    i = i + 1\n  }\n  total\n}\n")
  assert_lanes_agree(src, "length_of_temp", "6000")
}

test "a map result handed to Array::length while the source stays live (#2682)" {
  let src = String::concat(prelude(), "let main = () -> Int {\n  let mut total = 0\n  let mut i = 0\n  while i < 2000 {\n    let ta: Array[Tree] = [Leaf(i), Node(Leaf(i), Leaf(i + 1))]\n    total = total + Array::length(Array::map(ta, incr)) + sumt(Array::get(ta, 1))\n    i = i + 1\n  }\n  total\n}\n")
  assert_lanes_agree(src, "length_of_map_temp", "4004000")
}

test "a view of a temporary is not released under it (#2682)" {
  let src = String::concat(prelude(), "let main = () -> Int {\n  let mut total = 0\n  let mut i = 0\n  while i < 2000 {\n    total = total + Array::get(build_arr(3), 2) + first(build_arr(3))\n    i = i + 1\n  }\n  total\n}\n")
  assert_lanes_agree(src, "view_of_temp_not_released", "4000")
}

test "a view-returning user fn over a map result (#2682)" {
  let src = String::concat(prelude(), "let main = () -> Int {\n  let mut total = 0\n  let mut i = 0\n  while i < 2000 {\n    let ta: Array[Tree] = [Leaf(i), Node(Leaf(i), Leaf(i + 1))]\n    total = (total + sumt(head_tree(Array::map(ta, incr)))) % 1000000007\n    i = i + 1\n  }\n  total\n}\n")
  assert_lanes_agree(src, "view_fn_of_map_temp", "2001000")
}

test "an array literal handed to String::join (#2682)" {
  let src = String::concat(prelude(), "let main = () -> Int {\n  let mut total = 0\n  let mut i = 0\n  while i < 2000 {\n    total = total + String::length(String::join([\"a\", \"bc\"], \",\"))\n    i = i + 1\n  }\n  total\n}\n")
  assert_lanes_agree(src, "joined_temp_array", "8000")
}
