//# Imports

import @vibe/compiler/syntax {
  lex
}

import ../parser.vibe {
  parse_ok
}

import ./parser_test_support.vibe {
  parse_print
}

//# Misc

test "parse complex" {
  let ok = parse_ok(lex("if x > 0 { f(x - 1) } else { 0 }"))
  assert(ok)
}

test "parse else expr without braces" {
  let result = handle {
    parse_print("if true { 1 } else 2")
  } with Exception {
    Throw(e) => String::concat("ERROR: ", e)
  }
  assert(result == "if true { 1 } else { 2 }")
}

test "parse else if else expr without braces" {
  let result = handle {
    parse_print("if x { 1 } else if y { 2 } else 3")
  } with Exception {
    Throw(e) => String::concat("ERROR: ", e)
  }
  assert(result == "if x { 1 } else { if y { 2 } else { 3 } }")
}

test "parse else call expr without braces" {
  let result = handle {
    parse_print("if cond { x } else f(y)")
  } with Exception {
    Throw(e) => String::concat("ERROR: ", e)
  }
  assert(result == "if cond { x } else { f(y) }")
}
