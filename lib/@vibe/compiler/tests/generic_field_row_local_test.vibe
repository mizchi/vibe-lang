test "an unused callback parameter does not require adapting its argument" {
  local_field_run_source(label = "unused-row-slot-param", source = "effect Ask{Get()->Int} fn slot(f:()->Int with Ask)->Int with Ask{1} fn wrap(g:()->Int)->Int with Ask{slot(f = g)} fn main()->Unit allows Console{println(\"\\{handle{perform Ask::Get();wrap(g = ()->1)}with{Ask::Get()=>resume(2)}}\")}", expected = "1\n")
}

test "callback alias convention: row-free-projection-alias" {
  for lane in ["rc", "gc"] {
    let message = handle {
      local_field_compile(source = "effect Box[T]{Put(T)->Unit} struct Holder[T]{f:()->Int with Box[T]} struct Raw{f:()->Int} fn drive(f:()->Int with Box[String])->Int{handle{perform Box::Put(\"x\");f()}with{Box::Put(_)=>resume(())}} fn main()->Unit allows Console{let a=Raw::{f:()->1};let cb=a.f;let b=Holder[String]::{f:cb};println(\"\\{drive(f = b.f)}\")}", lane = lane)
      "compiled without the original callback convention"
    } with { Exception::Throw(message) => message }
    assert(String::contains(message, needle = "original definition"))
  }
  ()
}

