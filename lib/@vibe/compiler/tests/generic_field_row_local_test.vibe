test "projected callback convention: written-row-free-source" {
  for lane in ["rc", "gc"] {
    let message = handle {
      local_field_compile("effect Box[T]{Put(T)->Unit} struct Holder[T]{f:()->Int with Box[T]} struct Raw{f:()->Int} fn drive(f:()->Int with Box[String])->Int{handle{perform Box::Put(\"x\");f()}with{Box::Put(_)=>resume(())}} fn main()->Unit allows Console{let a=Raw::{f:()->1};let b=Holder[String]::{f:a.f};println(\"\\{drive(b.f)}\")}", lane)
      "compiled without a projected row proof"
    } with { Exception::Throw(message) => message }
    assert(String::contains(message, "declare the source field `f`"))
  }
  ()
}

