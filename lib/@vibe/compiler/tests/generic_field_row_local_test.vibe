}

test "instantiated callback field convention: cell-row-factory" {
  local_field_run_source("cell-row-factory", "effect Box[T]{Put(T)->Unit} struct Holder[T]{f:()->Int with Box[T]} struct Raw{f:()->Int} fn drive(f:()->Int with Box[String])->Int{handle{perform Box::Put(\"x\");f()}with{Box::Put(_)=>resume(())}} struct Cell[T]{f:T} type Thunk=()->Int with Box[String] fn make()->Cell[Thunk]{let g=()->Int with Box[String]{1};Cell[Thunk]::{f:g}} fn main()->Unit allows Console{let b=Holder::{f:make().f};println(\"\\{drive(b.f)}\")}", "1\n")
}

test "instantiated callback field convention: cell-pure-unread-target" {
  for lane in ["rc", "gc"] {
    let message = handle {
      local_field_compile("effect Box[T]{Put(T)->Unit} struct Holder[T]{f:()->Int with Box[T]} struct Raw{f:()->Int} fn drive(f:()->Int with Box[String])->Int{handle{perform Box::Put(\"x\");f()}with{Box::Put(_)=>resume(())}} struct Cell[T]{f:T} fn main()->Unit allows Console{let a=Cell[()->Int]::{f:()->1};let b=Holder::{f:a.f};println(\"\\{drive(b.f)}\")}", lane)
      "compiled without the instantiated callback convention"
    } with { Exception::Throw(message) => message }
    assert(String::contains(message, "write the type arguments of `Holder`"))
  }
  ()
}

test "instantiated callback field convention: cell-pure-written-target" {
  for lane in ["rc", "gc"] {
    let message = handle {
      local_field_compile("effect Box[T]{Put(T)->Unit} struct Holder[T]{f:()->Int with Box[T]} struct Raw{f:()->Int} fn drive(f:()->Int with Box[String])->Int{handle{perform Box::Put(\"x\");f()}with{Box::Put(_)=>resume(())}} struct Cell[T]{f:T} fn main()->Unit allows Console{let a=Cell[()->Int]::{f:()->1};let b=Holder[String]::{f:a.f};println(\"\\{drive(b.f)}\")}", lane)
      "compiled without the instantiated callback convention"
    } with { Exception::Throw(message) => message }
    assert(String::contains(message, "declare the source field `f`"))
  }
  ()
}
