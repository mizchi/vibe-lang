test "an unused callback parameter does not require adapting its argument" {
  local_field_run_source("unused-row-slot-param", "effect Ask{Get()->Int} fn slot(f:()->Int with Ask)->Int with Ask{1} fn wrap(g:()->Int)->Int with Ask{slot(g)} fn main()->Unit allows Console{println(\"\\{handle{perform Ask::Get();wrap(()->1)}with{Ask::Get()=>resume(2)}}\")}", "1\n")
}

test "callback alias convention: row-free-projection-alias" {
  for lane in ["rc", "gc"] {
    let message = handle {
      local_field_compile("effect Box[T]{Put(T)->Unit} struct Holder[T]{f:()->Int with Box[T]} struct Raw{f:()->Int} fn drive(f:()->Int with Box[String])->Int{handle{perform Box::Put(\"x\");f()}with{Box::Put(_)=>resume(())}} fn main()->Unit allows Console{let a=Raw::{f:()->1};let cb=a.f;let b=Holder[String]::{f:cb};println(\"\\{drive(b.f)}\")}", lane)
      "compiled without the original callback convention"
    } with { Exception::Throw(message) => message }
    assert(String::contains(message, "original definition"))
  }
  ()
}

