//# Imports

import @vibe/core {
  array_empty
}

import @vibe/compiler/codegen {
  compile_module, compile_wasi_module, compile_wasi_module_rc, compile_wasi_module_rc_shadow
}

import @vibe/compiler/codegen/gc {
  compile_wasi_module_gc,
  gc_direct_abi_pre_erasure_generic_names,
  gc_float_returning_names_pre_erasure,
  gc_to_string_resolves_to_show_wrapper
}

import @vibe/compiler/syntax {
  lex_with_offsets, parse_program_located
}

//# Functions

/// #2389: every helper below parses with `lex_with_offsets` +
/// `parse_program_located`, the way the compile lane does. The offset-less
/// `parse_program` leaves every `EIdent` at -1, and a plan action keyed by a
/// use offset (#2257) is then unmatchable -- measured, the per-path release
/// fails closed on such a lane, so an e2e case written against it compiled
/// byte-identically whether or not the feature was there, and asserted
/// nothing about it.
export fn assert_wasm(bytes: Bytes) -> Int {
  assert(Bytes::length(bytes) > 8)
  assert(Bytes::get(bytes, 0) == 0)
  assert(Bytes::get(bytes, 1) == 97)
  assert(Bytes::get(bytes, 2) == 115)
  assert(Bytes::get(bytes, 3) == 109)
  0
}

export fn compile_wasi(source: String, entry: String) -> Bytes with Exception {
  let (tokens, starts, _ends) = lex_with_offsets(source)
  let stmts = parse_program_located(tokens, starts, source)
  compile_wasi_module(stmts, entry)
}

/// RC-mode compile (uniform object header). Same as compile_wasi but on the
/// Perceus RC path; used by the heap e2e / leak tests to exercise the headered
/// layout (docs/spec/selfhost-rc-port.md).
export fn compile_wasi_rc(source: String, entry: String) -> Bytes with Exception {
  let (tokens, starts, _ends) = lex_with_offsets(source)
  let stmts = parse_program_located(tokens, starts, source)
  compile_wasi_module_rc(stmts, entry)
}

/// RC-mode compile with the shadow-liveness instrumentation (VIBE_RC=shadow,
/// #715): the program traps at the FIRST dup-of-freed or drop-of-freed
/// instead of running on a corrupted free list. An e2e test runs the same
/// source through this lane and asserts the normal lane's value comes out,
/// so an RC accounting regression fails at the faulting operation.
export fn compile_wasi_rc_shadow(source: String, entry: String) -> Bytes with Exception {
  let (tokens, starts, _ends) = lex_with_offsets(source)
  let stmts = parse_program_located(tokens, starts, source)
  compile_wasi_module_rc_shadow(stmts, entry)
}

export fn compile_source(source: String) -> Bytes with Exception {
  let (tokens, starts, _ends) = lex_with_offsets(source)
  let stmts = parse_program_located(tokens, starts, source)
  compile_module(stmts)
}

export fn compile_wasi_gc(source: String, entry: String) -> Bytes with Exception {
  let (tokens, starts, _ends) = lex_with_offsets(source)
  let stmts = parse_program_located(tokens, starts, source)
  // #1015: no strip pass runs in this test-support helper, so `stmts` here
  // is already the pre-strip shape gc_to_string_resolves_to_show_wrapper
  // needs.
  let gc_to_string_is_wrapper = gc_to_string_resolves_to_show_wrapper(stmts)
  let direct_abi_generic_names = gc_direct_abi_pre_erasure_generic_names(stmts)
  let gc_float_ret_fn_names = gc_float_returning_names_pre_erasure(stmts)
  compile_wasi_module_gc(stmts, entry, false, gc_to_string_is_wrapper, direct_abi_generic_names, gc_float_ret_fn_names, array_empty(), array_empty(), array_empty())
}

export fn compile_wasi_with_imports(import_sources: Array[String], source: String, entry: String) -> Bytes with Exception {
  let all_stmts = ArrayBuilder::new()
  let mut ii = 0
  while ii < Array::length(import_sources) {
    let isrc = Array::get(import_sources, ii)
    let (itokens, istarts, _iends) = lex_with_offsets(isrc)
    let istmts = parse_program_located(itokens, istarts, isrc)
    let mut si = 0
    while si < Array::length(istmts) {
      let s = Array::get(istmts, si)
      match s {
        SEnum(_, _, _, _, _) => {
          ArrayBuilder::push(all_stmts, s)
          0
        },
        _ => 0
      }
      si = si + 1
    }
    ii = ii + 1
  }
  let (main_tokens, main_starts, _main_ends) = lex_with_offsets(source)
  let main_stmts = parse_program_located(main_tokens, main_starts, source)
  let mut mi = 0
  while mi < Array::length(main_stmts) {
    ArrayBuilder::push(all_stmts, Array::get(main_stmts, mi))
    mi = mi + 1
  }
  compile_wasi_module(ArrayBuilder::freeze(all_stmts), entry)
}
