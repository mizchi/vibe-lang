//# Imports

import ./checker_parity_test_support.vibe {
  check_source_err, check_source_error_message, check_source_ok
}

//# Misc

test "parity builtin: String::ends_with" {
  assert(check_source_ok("let _adr69 = () -> { String::ends_with(\"hello\", \"lo\") }"))
}

test "parity builtin: zero arg perform op" {
  assert(check_source_ok("effect Profiler { NowUs -> Int }\nlet now: () -> Int with Profiler = () -> { perform Profiler::NowUs }\nlet _adr69 = () -> { now }"))
}

test "parity builtin: Profiler::HeapBytes perform op" {
  assert(check_source_ok("effect Profiler { HeapBytes -> Int }\nlet hb: () -> Int with Profiler = () -> { perform Profiler::HeapBytes }\nlet _adr69 = () -> { hb }"))
}

test "parity builtin: String::char_code_at" {
  assert(check_source_ok("let _adr69 = () -> { String::char_code_at(\"abc\", 0) }"))
}

test "parity builtin: String::from_char_code" {
  assert(check_source_ok("let _adr69 = () -> { String::from_char_code(65) }"))
}

test "parity builtin: String::last_index_of" {
  assert(check_source_ok("let _adr69 = () -> { String::last_index_of(\"abab\", \"ab\") }"))
}

test "parity builtin: String::split" {
  assert(check_source_ok("let _adr69 = () -> { String::split(\"a,b,c\", \",\") }"))
}

test "parity builtin: string slice to end syntax" {
  assert(check_source_ok("let s = \"hello\"\nlet _adr69 = () -> { s[2:] }"))
}

test "1682: slice syntax preserves String Bytes and Array receiver types" {
  assert(check_source_ok("fn main() -> Unit {\n  let s0: String = \"hello\"[:]\n  let s1: String = \"hello\"[:2]\n  let s2: String = \"hello\"[1:]\n  let s3: String = \"hello\"[1:3]\n  let b = Bytes::from_array([65, 66, 67])\n  let b0: Bytes = b[:]\n  let b1: Bytes = b[:2]\n  let b2: Bytes = b[1:]\n  let b3: Bytes = b[1:3]\n  let a = [1, 2, 3]\n  let a0: Array[Int] = a[:]\n  let a1: Array[Int] = a[:2]\n  let a2: Array[Int] = a[1:]\n  let a3: Array[Int] = a[1:3]\n}"))
}

test "1682: slice result cannot be annotated as Int" {
  assert(check_source_err("fn main() -> Unit { let n: Int = \"hello\"[0:2] }"))
  assert(check_source_err("fn main() -> Unit { let n: Int = Bytes::from_array([1, 2])[0:1] }"))
  assert(check_source_err("fn main() -> Unit { let n: Int = [1, 2][0:1] }"))
}

test "1682: slice and open-end length reject non-sliceable receivers" {
  assert(check_source_err("fn main() -> Unit { let x = 42[0:1] }"))
  assert(check_source_err("fn main() -> Unit { let x = true[:] }"))
}

test "1682: internal slice intrinsics cannot be aliased around receiver checks" {
  assert(check_source_err("fn main() -> Unit { let slicer = __slice\nlet n: Int = slicer(\"hello\", 0, 2) }"))
  assert(check_source_err("fn main() -> Unit { let length = __len\nlet n: Int = length(42) }"))
}

test "1682: generic and non-sliceable function results are rejected actionably" {
  let generic_closed = check_source_error_message("fn bad[T](x: T) -> T { x[0:1] }")
  let generic_open = check_source_error_message("fn bad[T](x: T) -> T { x[:] }")
  let int_result = check_source_error_message("fn answer() -> Int { 42 }\nfn main() -> Unit { let x = answer()[:] }")
  assert(String::contains(generic_closed, "slice receiver must be String, Bytes, or Array"))
  assert(String::contains(generic_open, "slice receiver must be String, Bytes, or Array"))
  assert(String::contains(int_result, "slice receiver must be String, Bytes, or Array"))
}

test "1682: a generic function result resolved to String remains sliceable" {
  assert(check_source_ok("fn identity[T](x: T) -> T { x }\nfn main() -> Unit { let s: String = identity(\"hello\")[:] }"))
}

test "1682 review: unknown receiver is rejected unless its expression already failed" {
  let unknown_receiver = check_source_error_message("fn main() -> Unit { let x = iter_get([1], 0)[:] }")
  let already_failed = check_source_error_message("fn main() -> Unit { let x = missing()[:] }")
  assert(String::contains(unknown_receiver, "slice receiver must be String, Bytes, or Array"))
  assert(String::contains(already_failed, "unknown name: missing"))
  assert(!String::contains(already_failed, "slice receiver must be String, Bytes, or Array"))
}

test "parity builtin: Array::get" {
  assert(check_source_ok("let _adr69 = () -> { Array::get([10, 20, 30], 1) }"))
}

test "parity builtin: Array::set" {
  assert(check_source_ok("let arr = [1, 2, 3]\nlet _adr69 = () -> { Array::set(arr, 0, 99)\nArray::get(arr, 0) }"))
}

test "parity builtin: Array::push" {
  assert(check_source_ok("let arr = [1]\nlet _adr69 = () -> { Array::push(arr, 2)\nArray::length(arr) }"))
}

test "parity builtin: Array::slice" {
  assert(check_source_ok("let arr = [1, 2, 3, 4]\nlet s = Array::slice(arr, 1, 3)\nlet _adr69 = () -> { Array::length(s) }"))
}

test "parity builtin: iter_length" {
  assert(check_source_ok("let xs = [1, 2, 3]\nlet _adr69 = () -> { iter_length(xs) }"))
}

test "parity builtin: iter_get" {
  assert(check_source_ok("let xs = [1, 2, 3]\nlet _adr69 = () -> { iter_get(xs, 1) }"))
}

test "parity builtin: Array::concat" {
  assert(check_source_ok("let a = [1, 2]\nlet b = [3, 4]\nlet c = Array::concat(a, b)\nlet _adr69 = () -> { Array::length(c) }"))
}

test "parity builtin: Array::reverse" {
  assert(check_source_ok("let r = Array::reverse([1, 2, 3])\nlet _adr69 = () -> { Array::get(r, 0) }"))
}

test "parity builtin: Array::any/all" {
  assert(check_source_ok("let _adr69 = () -> { Array::any([1, 2, 4], x -> x > 3)\nArray::all([1, 2, 3], x -> x > 0) }"))
}

test "parity builtin: Array::find" {
  assert(check_source_ok("let found = Array::find([1, 2, 3, 4], x -> x > 2)\nlet _adr69 = () -> { match found { Some(v) => v, None => 0 } }"))
}

test "parity builtin: Array::push_all" {
  assert(check_source_ok("let a = [1, 2]\nlet b = [3, 4]\nlet _adr69 = () -> { Array::push_all(a, b)\nArray::length(a) }"))
}

test "parity builtin: ArrayBuilder::new+push+freeze" {
  assert(check_source_ok("let b = ArrayBuilder::new()\nlet _adr69 = () -> { ArrayBuilder::push(b, 42)\nlet arr = ArrayBuilder::freeze(b)\nArray::get(arr, 0) }"))
}

test "parity builtin: MapBuilder::new+set+freeze" {
  assert(check_source_ok("let b = MapBuilder::new()\nlet _adr69 = () -> { MapBuilder::set(b, \"key\", 99)\nlet m = MapBuilder::freeze(b)\nMap::get(m, \"key\") }"))
}

test "parity builtin: Map::get" {
  assert(check_source_ok("let m = Map::from_pairs([(\"x\", 42)])\nlet _adr69 = () -> { Map::get(m, \"x\") }"))
}

test "parity builtin: Map::keys" {
  assert(check_source_ok("let m = Map::from_pairs([(\"a\", 1), (\"b\", 2)])\nlet keys = Map::keys(m)\nlet _adr69 = () -> { Array::length(keys) }"))
}

test "parity builtin: Bytes::new+push+length" {
  assert(check_source_ok("let b = Bytes::new()\nlet _adr69 = () -> { Bytes::push(b, 65)\nArray::length(Bytes::to_array(b)) }"))
}

test "parity builtin: Bytes::from_array+to_array" {
  assert(check_source_ok("let b = Bytes::from_array([1, 2, 3])\nlet a = Bytes::to_array(b)\nlet _adr69 = () -> { Array::length(a) }"))
}

test "parity builtin: Bytes::concat" {
  assert(check_source_ok("let a = Bytes::from_array([1])\nlet b = Bytes::from_array([2])\nlet c = Bytes::concat(a, b)\nlet _adr69 = () -> { Array::length(Bytes::to_array(c)) }"))
}

test "parity builtin: Bytes::slice" {
  assert(check_source_ok("let b = Bytes::from_array([1, 2, 3, 4])\nlet s = Bytes::slice(b, 1, 3)\nlet _adr69 = () -> { Array::length(Bytes::to_array(s)) }"))
}

test "parity builtin: Int::to_double" {
  assert(check_source_ok("let _adr69 = () -> { Int::to_double(42) }"))
}

test "parity builtin: __to_string" {
  assert(check_source_ok("let _adr69 = () -> { __to_string(42) }"))
}

test "parity builtin: __neg double" {
  assert(check_source_ok("let _adr69 = () -> { __neg(3.5f) }"))
}

test "parity: compound assign" {
  assert(check_source_ok("let _adr69 = () -> { let mut x = 10\nx += 5\nx -= 2\nx *= 3\nx }"))
}

test "parity: option unwrap" {
  assert(check_source_ok("let x = Some(42)\nlet _adr69 = () -> { match x { Some(v) => v, None => 0 } }"))
}

test "parity: option chain" {
  assert(check_source_ok("let _adr69 = () -> { let mut result: Option[Int] = None\nlet arr = [10, 20, 30]\nlet mut i = 0\nwhile i < Array::length(arr) {\n  if Array::get(arr, i) == 20 {\n    result = Some(i)\n    break\n  }\n  i = i + 1\n}\nmatch result { Some(i) => i, None => -1 } }"))
}

test "parity: while mutable" {
  assert(check_source_ok("let _adr69 = () -> { let mut total = 0\nlet mut i = 0\nwhile i < 5 { total = total + i * i\ni = i + 1 }\ntotal }"))
}

test "parity: nested option" {
  assert(check_source_ok("let _adr69 = () -> { match Some(Some(42)) { Some(Some(n)) => n, _ => 0 } }"))
}

test "parity: for-in squares" {
  assert(check_source_ok("let squares = for x in [1, 2, 3] { x * x }\nlet _adr69 = () -> { Array::get(squares, 2) }"))
}

test "parity: handle multiple" {
  assert(check_source_ok("let risky: (Int) -> Int with Exception = (n) -> { if n < 0 { throw(\"neg\") }\nn * 2 }\nlet a = handle { risky(5) } with Exception { Throw(_) => -1 }\nlet b = handle { risky(-1) } with Exception { Throw(_) => -1 }\nlet _adr69 = () -> { a + b }"))
}

test "parity: suberror propagate" {
  assert(check_source_ok("suberror AppError { NotFound; BadInput(String) }\nlet inner: () -> Int with Exception = () -> { throw(BadInput(\"x\"))\n0 }\nlet _adr69 = () -> { handle { inner() } with Exception { Throw(_) => 99 } }"))
}

test "parity: enum with functions" {
  assert(check_source_ok("enum Shape { Circle(Int); Rect(Int, Int) }\nlet area: (Shape) -> Int = (s) -> { match s { Circle(r) => r * r, Rect(w, h) => w * h } }\nlet _adr69 = () -> { area(Circle(5)) }"))
}

test "parity: generic option map" {
  assert(check_source_ok("let opt_map: [A, B](Option[A], (A) -> B) -> Option[B] = (opt, f) -> { match opt { Some(v) => Some(f(v)), None => None } }\nlet _adr69 = () -> { match opt_map(Some(5), (x: Int) -> Int { x * 10 }) { Some(n) => n, None => 0 } }"))
}

test "parity: generic option tuple return" {
  assert(check_source_ok("let zip: [A, B](Option[A], Option[B]) -> Option[(A, B)] = (a, b) -> { match (a, b) { (Some(x), Some(y)) => Some((x, y)), _ => None } }\nlet _adr69 = () -> { match zip(Some(1), Some(2)) { Some((x, y)) => x + y, _ => 0 } }"))
}

test "parity: generic map return specialized by caller" {
  assert(check_source_ok("type HashSet = Map[String, Bool]\nlet map_set_by: [K, V](Map[String, V], K, V) -> Map[String, V] = (m, key, value) -> { Map::set(m, __to_string(key), value) }\nlet add: [K](HashSet, K) -> HashSet = (s, key) -> { map_set_by(s, key, true) }\nlet _adr69 = () -> { add(Map::new(), 1) }"))
}

test "parity: string builder" {
  assert(check_source_ok("let b = StringBuilder::new()\nlet _adr69 = () -> { StringBuilder::push(b, \"hi\")\nStringBuilder::freeze(b) }"))
}

test "parity: nested loop" {
  assert(check_source_ok("let _adr69 = () -> { let mut sum = 0\nlet mut i = 0\nwhile i < 3 { let mut j = 0\nwhile j < 4 { sum = sum + 1\nj = j + 1 }\ni = i + 1 }\nsum }"))
}

test "parity: array filter collect" {
  assert(check_source_ok("let b = ArrayBuilder::new()\nlet _adr69 = () -> { for x in [1, 2, 3, 4, 5] { if x % 2 == 0 { ArrayBuilder::push(b, x) } }\nArray::length(ArrayBuilder::freeze(b)) }"))
}

test "parity: recursive list" {
  assert(check_source_ok("enum IntList { Nil; Cons(Int, IntList) }\nlet rec sum_list: (IntList) -> Int = (l) -> { match l { Nil => 0, Cons(h, t) => h + sum_list(t) } }\nlet _adr69 = () -> { sum_list(Cons(1, Cons(2, Cons(3, Nil)))) }"))
}

test "parity: map literal" {
  assert(check_source_ok("let m = Map::from_pairs([(\"x\", 1), (\"y\", 2)])\nlet _adr69 = () -> { Map::get(m, \"x\") }"))
}

test "parity: empty map" {
  assert(check_source_ok("let m: Map[String, Int] = Map::new()\nlet _adr69 = () -> { m }"))
}

test "parity: tuple index" {
  assert(check_source_ok("let t = (10, 20, 30)\nlet _adr69 = () -> { t.0 + t.1 + t.2 }"))
}

test "parity: nested tuple" {
  // #859: tuple-pattern let is only supported in a function/block body, not
  // at top level -- the destructure moved inside the lambda accordingly.
  assert(check_source_ok("let t = ((1, 2), (3, 4))\nlet _adr69 = () -> { let (a, b) = t\na.0 + b.1 }"))
}

test "parity: string interpolation" {
  assert(check_source_ok("let x = 42\nlet s = \"value is \\{__to_string(x)}\"\nlet _adr69 = () -> { String::length(s) }"))
}

test "parity: loop with break" {
  assert(check_source_ok("let result = loop (i = 0) { if i >= 5 { break(i) } else { continue(i + 1) } }\nlet _adr69 = () -> { result }"))
}

test "parity: loop multi param" {
  assert(check_source_ok("let result = loop (i = 0, sum = 0) { if i >= 3 { break(sum) } else { continue(i + 1, sum + i) } }\nlet _adr69 = () -> { result }"))
}

test "parity: while break" {
  assert(check_source_ok("let _adr69 = () -> { let mut i = 0\nwhile true { if i >= 10 { break }\ni = i + 1 }\ni }"))
}
