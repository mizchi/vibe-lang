//# Functions

// Support module for float_width_row_formal_test.vibe (ADR-0122, #3728): an
// exported function whose callback row is spelled with `Float64`. A row's
// type arguments are collected as text, outside `parse_type`, so this pins
// that the importer reads `Box[Float64]` as `Box[Double]`.

export effect Box[T] {
  Get() -> T
}

export fn run(_ f: () -> Int with Box[Float64]) -> Int {
  let _ = f
  0
}
