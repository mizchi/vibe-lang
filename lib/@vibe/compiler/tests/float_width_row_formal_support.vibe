//# Functions

// Support module for float_width_row_formal_test.vibe (ADR-0122, #3728): an
// exported function whose callback row names its own type parameter, spelled
// `Float64`. The importer must read that row argument as the formal, not as
// the builtin float.

export effect Box[T] {
  Get() -> T
}

export fn run[Float64](x: Float64, f: () -> Int with Box[Float64]) -> Int {
  let _ = x
  let _ = f
  0
}
