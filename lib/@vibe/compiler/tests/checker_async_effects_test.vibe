//# Imports

import @vibe/compiler/core {
  BindingOrigin,
  Expr,
  Pat,
  Stmt,
  Type,
  TypeDef,
  TypeEnv,
  TypeExpr,
  env_bind,
  env_preserve_type_definition_origins,
  env_value_binding_with_origin
}

import @vibe/core {
  array_empty
}

import @vibe/compiler/checker {
  EffectError, check_async_effects_expr, check_async_effects_stmt, check_async_effects_stmts
}

//# Functions

fn is_call_err(e: EffectError) -> Bool {
  match e {
    EEEffectfulCallOutsideEffect(_) => true,
    _ => false
  }
}

fn async_fn(effect: Option[String], body: Expr) -> Expr {
  EFn(array_empty(), array_empty(), array_empty(), None, effect, body)
}

fn await_call(arg: Expr) -> Expr {
  ECall(EIdent("await", -1), [arg], -1)
}

//# Misc

// The `Async`-scoped enforcement wired into `check_program`: async PRIMITIVES
// (`await`/`sleep`/...) must appear inside an `{Async}` context; composing async
// helpers does not.

test "await outside Async context reports error" {
  let errors = check_async_effects_expr(await_call(EIdent("f", -1)), EnvEmpty, false)
  assert(Array::length(errors) > 0)
  assert(is_call_err(Array::get(errors, 0)))
}

test "await inside Async context is OK" {
  let errors = check_async_effects_expr(await_call(EIdent("f", -1)), EnvEmpty, true)
  assert(eq(Array::length(errors), 0))
}

test "sleep outside Async context reports error" {
  let call = ECall(EIdent("sleep", -1), [EInt(10)], -1)
  let errors = check_async_effects_expr(call, EnvEmpty, false)
  assert(Array::length(errors) > 0)
}

test "await inside EFn with Async annotation is OK" {
  let fn_expr = async_fn(Some("Async"), await_call(EIdent("f", -1)))
  let errors = check_async_effects_expr(fn_expr, EnvEmpty, false)
  assert(eq(Array::length(errors), 0))
}

test "Async-like effect labels do not authorize await" {
  let not_async = async_fn(Some("NotAsync"), await_call(EIdent("f", -1)))
  let async_like = async_fn(Some("AsyncLike"), await_call(EIdent("f", -1)))
  assert(Array::length(check_async_effects_expr(not_async, EnvEmpty, false)) > 0)
  assert(Array::length(check_async_effects_expr(async_like, EnvEmpty, false)) > 0)
}

test "Async row labels trim and dedupe before exact membership" {
  let fn_expr = async_fn(Some(" Async, Async "), await_call(EIdent("f", -1)))
  let errors = check_async_effects_expr(fn_expr, EnvEmpty, false)
  assert(eq(Array::length(errors), 0))
}

test "Async checking visits map, labeled, spread, break, and continue children" {
  let map_expr = EMap([("value", await_call(EIdent("f", -1)))])
  let labeled_expr = ELabeledArg("value", "v", await_call(EIdent("f", -1)))
  let spread_expr = ESpread(await_call(EIdent("f", -1)))
  let break_expr = EBreak(Some(await_call(EIdent("f", -1))))
  let continue_expr = EContinue([await_call(EIdent("f", -1))])
  assert(Array::length(check_async_effects_expr(map_expr, EnvEmpty, false)) > 0)
  assert(Array::length(check_async_effects_expr(labeled_expr, EnvEmpty, false)) > 0)
  assert(Array::length(check_async_effects_expr(spread_expr, EnvEmpty, false)) > 0)
  assert(Array::length(check_async_effects_expr(break_expr, EnvEmpty, false)) > 0)
  assert(Array::length(check_async_effects_expr(continue_expr, EnvEmpty, false)) > 0)
}

test "await inside EFn without Async annotation reports error" {
  let fn_expr = async_fn(None, await_call(EIdent("f", -1)))
  let errors = check_async_effects_expr(fn_expr, EnvEmpty, false)
  assert(Array::length(errors) > 0)
}

test "await inside EFn with non-Async effect still reports error" {
  let fn_expr = async_fn(Some("Error"), await_call(EIdent("f", -1)))
  let errors = check_async_effects_expr(fn_expr, EnvEmpty, false)
  assert(Array::length(errors) > 0)
}

test "calling an Async user function from sync context is allowed" {
  // Composition: a `with Async` helper bound in env is NOT a primitive, so
  // calling it outside an Async context is fine (its own await is checked in
  // its body). Only builtin async primitives require an Async context.
  let env = env_bind(EnvEmpty, "my_async", CtFn([CtInt], CtInt, Some("Async")))
  let call = ECall(EIdent("my_async", -1), [EInt(1)], -1)
  let errors = check_async_effects_expr(call, env, false)
  assert(eq(Array::length(errors), 0))
}

test "SLet with Async signature makes body an Async context" {
  // `let f: (Int) -> Int with Async = (x) -> { await(x) }`
  let fn_body = async_fn(None, await_call(EIdent("x", -1)))
  let sig = TyFn([TyName("Int")], TyName("Int"), Some("Async"))
  let stmt = SLet(false, false, "f", Some(sig), fn_body)
  let errors = check_async_effects_stmt(stmt, EnvEmpty)
  assert(eq(Array::length(errors), 0))
}

test "SLet without Async signature flags await in body" {
  let fn_body = async_fn(None, await_call(EIdent("x", -1)))
  let sig = TyFn([TyName("Int")], TyName("Int"), None)
  let stmt = SLet(false, false, "f", Some(sig), fn_body)
  let errors = check_async_effects_stmt(stmt, EnvEmpty)
  assert(Array::length(errors) > 0)
}

test "pure non-async call outside Async context is OK" {
  let call = ECall(EIdent("println", -1), [EString("hi")], -1)
  let errors = check_async_effects_expr(call, EnvEmpty, false)
  assert(eq(Array::length(errors), 0))
}

// ADR-0089 Decision 1 increment 2 (#1218): a `handle ... with Async`
// discharges the builtin row -- primitives inside its body need no
// enclosing `with Async` context, because the handler is where their
// perform lowering delivers them (linked_compile keys the sleep->perform
// retarget on this same shape).

test "handle with Async provides the async context for its body" {
  let sleep_call = ECall(EIdent("sleep", -1), [EInt(10)], -1)
  let handled = EHandle(sleep_call, [
    (PCtor("Async::Suspend", [PBind("req")]), ECall(EIdent("resume", -1), [
      EInt(0)
    ], -1))
  ])
  let errors = check_async_effects_expr(handled, EnvEmpty, false)
  assert(eq(Array::length(errors), 0))
}

test "handle of a different effect does NOT provide the async context" {
  let sleep_call = ECall(EIdent("sleep", -1), [EInt(10)], -1)
  let handled = EHandle(sleep_call, [
    (PCtor("Log::Emit", [PBind("m")]), ECall(EIdent("resume", -1), [EInt(0)], -1))
  ])
  let errors = check_async_effects_expr(handled, EnvEmpty, false)
  assert(Array::length(errors) > 0)
}

test "an Async handler arm's own body is NOT an async context" {
  // the arm runs OUTSIDE the handled computation; a primitive there still
  // needs its own context
  let handled = EHandle(EInt(1), [
    (PCtor("Async::Suspend", [PBind("req")]), ECall(EIdent("sleep", -1), [
      EInt(5)
    ], -1))
  ])
  let errors = check_async_effects_expr(handled, EnvEmpty, false)
  assert(Array::length(errors) > 0)
}

// #1358: driving an ASYNC iterator with `for` awaits every step, but the
// `await(..)` is injected after the checker (desugar_trait_dict's
// build_await_iter_for), so the loop has to be recognised from the iterand's
// TYPE. The two envs below differ only in the trait's `next` return head --
// `Future[..]` (async, requires the row) vs `Option[..]` (sync, requires
// nothing) -- which is exactly the bit the desugar switches on.

fn iter_env(next_ret: TypeExpr, target: String) -> TypeEnv {
  let methods = [("next", [TyName("Self")], next_ret)]
  EnvTraitImpl("It", CtStruct(target), EnvTraitDef("It", array_empty(), false, methods, EnvEmpty, array_empty(), array_empty()))
}

fn async_iter_env() -> TypeEnv {
  iter_env(TyApp("Future", [TyApp("Option", [TyName("Int")])]), "Chan")
}

fn sync_iter_env() -> TypeEnv {
  iter_env(TyApp("Option", [TyName("Int")]), "Chan")
}

fn chan_literal() -> Expr {
  ERecord("Chan", array_empty(), array_empty())
}

fn for_over(iterand: Expr) -> Expr {
  EForIn("x", None, iterand, EIdent("x", -1))
}

test "for over an async iterator outside an Async context reports error" {
  let errors = check_async_effects_expr(for_over(chan_literal()), async_iter_env(), false)
  assert(Array::length(errors) > 0)
  assert(is_call_err(Array::get(errors, 0)))
}

test "for over an async iterator inside an Async context is OK" {
  let errors = check_async_effects_expr(for_over(chan_literal()), async_iter_env(), true)
  assert(eq(Array::length(errors), 0))
}

test "for over a SYNC iterator requires nothing" {
  let errors = check_async_effects_expr(for_over(chan_literal()), sync_iter_env(), false)
  assert(eq(Array::length(errors), 0))
}

test "an Async-annotated lambda authorizes its async for loop" {
  let fn_expr = async_fn(Some("Async"), for_over(chan_literal()))
  let errors = check_async_effects_expr(fn_expr, async_iter_env(), false)
  assert(eq(Array::length(errors), 0))
}

test "handle with Async discharges an async for loop" {
  let handled = EHandle(for_over(chan_literal()), [
    (PCtor("Async::Suspend", [PBind("req")]), ECall(EIdent("resume", -1), [
      EInt(0)
    ], -1))
  ])
  let errors = check_async_effects_expr(handled, async_iter_env(), false)
  assert(eq(Array::length(errors), 0))
}

test "an async iterand reached through a local let is recognised" {
  // `let it = Chan::{}; for x in it { .. }` -- the binding is local, so it is
  // absent from the type env and only the walk's own locals table resolves it.
  let body = ELet("it", chan_literal(), for_over(EIdent("it", -1)), -1)
  let errors = check_async_effects_expr(body, async_iter_env(), false)
  assert(Array::length(errors) > 0)
}

test "an async iterand reached through a call's return type is recognised" {
  let mk = env_bind(async_iter_env(), "open_chan", CtFn(array_empty(), CtStruct("Chan"), None))
  let call = ECall(EIdent("open_chan", -1), array_empty(), -1)
  let errors = check_async_effects_expr(for_over(call), mk, false)
  assert(Array::length(errors) > 0)
}

test "an async iterand returned by a constructor-polymorphic map requires Async" {
  let map_type = CtForAll([0, 1, 2], [(0, ["Mappable"])], CtFn([
    CtApplied(CtVar(0), [CtVar(1)]),
    CtFn([CtVar(1)], CtVar(2), None)
  ], CtApplied(CtVar(0), [CtVar(2)]), None))
  let env = env_bind(async_iter_env(), "map", map_type)
  let mapper = EFn(array_empty(), array_empty(), [("x", None)], None, None, EIdent("x", -1))
  let mapped = ECall(EIdent("map", -1), [chan_literal(), mapper], -1)
  let errors = check_async_effects_expr(for_over(mapped), env, false)
  assert(Array::length(errors) > 0)
}

test "an async iterand reached through a typed parameter is recognised" {
  let params = [("s", Some(TyName("Chan")))]
  let fn_expr = EFn(array_empty(), array_empty(), params, None, None, for_over(EIdent("s", -1)))
  let errors = check_async_effects_expr(fn_expr, async_iter_env(), false)
  assert(Array::length(errors) > 0)
}

test "a local binding shadows an outer async iterator" {
  // `let it = Chan::{}` then, inside, `let it = 0; for x in it` -- the inner
  // `it` is an Int, so requiring Async here would reject a valid program.
  let inner = ELet("it", EInt(0), for_over(EIdent("it", -1)), -1)
  let outer = ELet("it", chan_literal(), inner, -1)
  let errors = check_async_effects_expr(outer, async_iter_env(), false)
  assert(eq(Array::length(errors), 0))
}

test "an unresolvable iterand requires nothing" {
  let errors = check_async_effects_expr(for_over(EIdent("mystery", -1)), async_iter_env(), false)
  assert(eq(Array::length(errors), 0))
}

// #1364 Codex review (P1 x2): two shapes that reached the await lowering but
// slipped past the row requirement. Both were verified against repros that
// actually RAN the await loop (a sync EForIn over the value would have
// trapped), so each was a real hole, not a hypothetical one.

fn generic_async_iter_env() -> TypeEnv {
  // `impl [T] AIter for Iter[T]` is recorded as EnvTraitImplGen, which the
  // scan used to skip unconditionally.
  let methods = [
    ("next", [TyName("Self")], TyApp("Future", [TyApp("Option", [TyName("Int")])]))
  ]
  EnvTraitImplGen("It", ["T"], array_empty(), CtStruct("Iter"), EnvTraitDef("It", array_empty(), false, methods, EnvEmpty, array_empty(), array_empty()))
}

test "for over a GENERICALLY implemented async iterator requires Async" {
  let iterand = ERecord("Iter", array_empty(), array_empty())
  let errors = check_async_effects_expr(for_over(iterand), generic_async_iter_env(), false)
  assert(Array::length(errors) > 0)
}

test "a generic async iterator inside an Async context is OK" {
  let iterand = ERecord("Iter", array_empty(), array_empty())
  let errors = check_async_effects_expr(for_over(iterand), generic_async_iter_env(), true)
  assert(eq(Array::length(errors), 0))
}

test "an ENUM async iterand keeps its head name" {
  // `enum Chan { Chan(Int) }` + `for x in Chan(3)`: the constructor's return
  // type is CtEnum, which the head-name helper used to discard.
  let env = env_bind(iter_env(TyApp("Future", [TyApp("Option", [TyName("Int")])]), "Chan"), "Chan", CtFn([
    CtInt
  ], CtEnum("Chan"), None))
  let call = ECall(EIdent("Chan", -1), [EInt(3)], -1)
  let errors = check_async_effects_expr(for_over(call), env, false)
  assert(Array::length(errors) > 0)
}

test "a SYNC enum iterator still requires nothing" {
  let env = env_bind(iter_env(TyApp("Option", [TyName("Int")]), "Chan"), "Chan", CtFn([
    CtInt
  ], CtEnum("Chan"), None))
  let call = ECall(EIdent("Chan", -1), [EInt(3)], -1)
  let errors = check_async_effects_expr(for_over(call), env, false)
  assert(eq(Array::length(errors), 0))
}

test "a projected builtin AsyncIter struct field requires Async" {
  let origin = BindingOriginModuleExport("/workspace/lib/@vibe/builtin/index.vpkg", "AsyncIter")
  let source = EnvBind("AsyncIter", env_value_binding_with_origin(CtUnknown, origin), EnvEmpty)
  let env = env_preserve_type_definition_origins(EnvTypeDefs([
    TDStruct("Holder", [("stream", CtNamed("AsyncIter", [CtInt]))], [], []),
    TDStruct("AsyncIter", [], [], ["T"])
  ], ["Holder"], EnvEmpty), source)
  let body = EFn(array_empty(), array_empty(), [
    ("holder", Some(TyName("Holder")))
  ], None, None, for_over(EDot(EIdent("holder", -1), "stream", -1, -1)))
  let errors = check_async_effects_stmts([
    STest("projected builtin field", body)
  ], env)
  assert(Array::length(errors) > 0)
}

test "a projected user AsyncIter struct field stays synchronous" {
  let env = EnvTypeDefs([
    TDStruct("Holder", [("stream", CtNamed("AsyncIter", [CtInt]))], [], []),
    TDStruct("AsyncIter", [], [], ["T"])
  ], ["Holder"], EnvEmpty)
  let body = EFn(array_empty(), array_empty(), [
    ("holder", Some(TyName("Holder")))
  ], None, None, for_over(EDot(EIdent("holder", -1), "stream", -1, -1)))
  let errors = check_async_effects_stmts([STest("projected user field", body)], env)
  assert(eq(Array::length(errors), 0))
}

// #2355 review: constructor-polymorphic map must recover AsyncIter through
// the same expression shapes the trait desugar already classifies.

fn poly_map_type() -> Type {
  CtForAll([0, 1, 2], [(0, ["Mappable"])], CtFn([
    CtApplied(CtVar(0), [CtVar(1)]),
    CtFn([CtVar(1)], CtVar(2), None)
  ], CtApplied(CtVar(0), [CtVar(2)]), None))
}

fn poly_map_env() -> TypeEnv {
  env_bind(async_iter_env(), "map", poly_map_type())
}

fn identity_mapper() -> Expr {
  EFn(array_empty(), array_empty(), [("x", None)], None, None, EIdent("x", -1))
}

fn mapped_over(arg: Expr) -> Expr {
  ECall(EIdent("map", -1), [arg, identity_mapper()], -1)
}

fn assert_mapped_requires_async(arg: Expr) -> Unit {
  let errors = check_async_effects_expr(for_over(mapped_over(arg)), poly_map_env(), false)
  assert(Array::length(errors) > 0)
  let ok = check_async_effects_expr(for_over(mapped_over(arg)), poly_map_env(), true)
  assert(eq(Array::length(ok), 0))
}

test "mapped handle AsyncIter receivers require Async" {
  let handled = EHandle(chan_literal(), [
    (PCtor("Log::Emit", [PBind("m")]), ECall(EIdent("resume", -1), [EInt(0)], -1))
  ])
  assert_mapped_requires_async(handled)
}

test "mapped constructor-alias results require Async" {
  let alias_env = EnvTypeDefs([
    TDAlias("Apply", ["F", "A"], CtApplied(CtNamed("F", array_empty()), [
      CtNamed("A", array_empty())
    ]))
  ], ["Apply"], poly_map_env())
  let mapped_type = CtForAll([0, 1, 2], [(0, ["Mappable"])], CtFn([
    CtApplied(CtVar(0), [CtVar(1)]),
    CtFn([CtVar(1)], CtVar(2), None)
  ], CtNamed("Apply", [CtVar(0), CtVar(2)]), None))
  let env = env_bind(alias_env, "mapped", mapped_type)
  let call = ECall(EIdent("mapped", -1), [chan_literal(), identity_mapper()], -1)
  let errors = check_async_effects_expr(for_over(call), env, false)
  assert(Array::length(errors) > 0)
  let ok = check_async_effects_expr(for_over(call), env, true)
  assert(eq(Array::length(ok), 0))
}

test "method-style AsyncIter map results require Async" {
  let env = env_bind(async_iter_env(), "Chan::map", poly_map_type())
  let call = ECall(EDot(chan_literal(), "map", -1, -1), [identity_mapper()], -1)
  let errors = check_async_effects_expr(for_over(call), env, false)
  assert(Array::length(errors) > 0)
  let ok = check_async_effects_expr(for_over(call), env, true)
  assert(eq(Array::length(ok), 0))
}

test "mapped IIFE AsyncIter inputs require Async" {
  let iife = ECall(EFn(array_empty(), array_empty(), [("xs", None)], None, None, EIdent("xs", -1)), [
    chan_literal()
  ], -1)
  assert_mapped_requires_async(iife)
}

test "mapped parameterized loop AsyncIter results require Async" {
  let loop_expr = ELetMut("__loop_result", EInt(0), ESeq(EWhile(EBool(true), EAssign("__loop_result", chan_literal(), EInt(0))), EIdent("__loop_result", -1)), -1)
  assert_mapped_requires_async(loop_expr)
}

test "mapped match-pattern AsyncIter binders require Async" {
  let matched = EMatch(chan_literal(), [(PBind("it"), EIdent("it", -1))])
  assert_mapped_requires_async(matched)
}

test "mapped constructor-pattern AsyncIter payloads require Async" {
  let matched = EMatch(ECall(EIdent("Some", -1), [chan_literal()], -1), [
    (PCtor("Some", [PBind("it")]), EIdent("it", -1)),
    (PCtor("None", array_empty()), chan_literal())
  ])
  assert_mapped_requires_async(matched)
}

test "a local AsyncIter::map is not treated as builtin" {
  let env = env_bind(EnvEmpty, "AsyncIter::map", CtFn([CtInt], CtInt, None))
  let call = ECall(EIdent("AsyncIter::map", -1), [EInt(1)], -1)
  let errors = check_async_effects_expr(for_over(call), env, false)
  assert(eq(Array::length(errors), 0))
}

test "mapped tuple-projection AsyncIter receivers require Async" {
  let projected = ELet("p", ETuple([chan_literal(), EInt(0)]), mapped_over(EDot(EIdent("p", -1), "0", -1, -1)), -1)
  let errors = check_async_effects_expr(for_over(projected), poly_map_env(), false)
  assert(Array::length(errors) > 0)
  let ok = check_async_effects_expr(for_over(projected), poly_map_env(), true)
  assert(eq(Array::length(ok), 0))
}

test "mapped array-element AsyncIter values require Async" {
  let extracted = ELet("streams", EArray([chan_literal()]), mapped_over(ECall(EIdent("Array::get", -1), [
    EIdent("streams", -1),
    EInt(0)
  ], -1)), -1)
  let errors = check_async_effects_expr(for_over(extracted), poly_map_env(), false)
  assert(Array::length(errors) > 0)
  let ok = check_async_effects_expr(for_over(extracted), poly_map_env(), true)
  assert(eq(Array::length(ok), 0))
}

test "mapped __index AsyncIter values require Async" {
  let extracted = ELet("streams", EArray([chan_literal()]), mapped_over(ECall(EIdent("__index", -1), [
    EIdent("streams", -1),
    EInt(0)
  ], -1)), -1)
  let errors = check_async_effects_expr(for_over(extracted), poly_map_env(), false)
  assert(Array::length(errors) > 0)
  let ok = check_async_effects_expr(for_over(extracted), poly_map_env(), true)
  assert(eq(Array::length(ok), 0))
}

test "mapped IIFE AsyncIter results with explicit return require Async" {
  let iife = ECall(EFn(array_empty(), array_empty(), array_empty(), Some(TyName("Chan")), None, EReturn(chan_literal())), array_empty(), -1)
  assert_mapped_requires_async(iife)
}

test "mapped recursive local AsyncIter results require Async" {
  let rec_fn = EFn(array_empty(), array_empty(), [("n", Some(TyName("Int")))], Some(TyName("Chan")), None, chan_literal())
  let rec_block = ELetRec("make", rec_fn, ECall(EIdent("make", -1), [EInt(0)], -1))
  assert_mapped_requires_async(rec_block)
}

test "mapped handler-payload AsyncIter results require Async" {
  let performed = ECall(EIdent("perform", -1), [
    ECall(EIdent("Exception::Throw", -1), [chan_literal()], -1)
  ], -1)
  let handled = EHandle(ESeq(performed, chan_literal()), [
    (PCtor("Exception::Throw", [PBind("it")]), EIdent("it", -1))
  ])
  assert_mapped_requires_async(handled)
}

test "mapped multi-payload handler results require Async" {
  let performed = ECall(EIdent("perform", -1), [
    ECall(EIdent("Carry::Yield", -1), [EInt(0), chan_literal()], -1)
  ], -1)
  let handled = EHandle(ESeq(performed, chan_literal()), [
    (PCtor("Carry::Yield", [PWild, PBind("it")]), EIdent("it", -1))
  ])
  assert_mapped_requires_async(handled)
}

test "mapped IIFE-performed handler payloads require Async" {
  let performed = ECall(EIdent("perform", -1), [
    ECall(EIdent("Carry::Yield", -1), [chan_literal()], -1)
  ], -1)
  let iife = ECall(EFn(array_empty(), array_empty(), array_empty(), Some(TyName("Unit")), None, performed), array_empty(), -1)
  let handled = EHandle(ESeq(iife, chan_literal()), [
    (PCtor("Carry::Yield", [PBind("it")]), EIdent("it", -1))
  ])
  assert_mapped_requires_async(handled)
}

test "mapped payloads cross nested non-consuming handler bodies" {
  let performed = ECall(EIdent("perform", -1), [
    ECall(EIdent("Carry::Yield", -1), [chan_literal()], -1)
  ], -1)
  let nested = EHandle(ESeq(performed, EUnit), [
    (PCtor("Dummy::Ping", array_empty()), EUnit)
  ])
  let handled = EHandle(ESeq(nested, chan_literal()), [
    (PCtor("Carry::Yield", [PBind("it")]), EIdent("it", -1))
  ])
  assert_mapped_requires_async(handled)
}

test "mapped payloads cross nested non-consuming handler arms" {
  let performed = ECall(EIdent("perform", -1), [
    ECall(EIdent("Carry::Yield", -1), [chan_literal()], -1)
  ], -1)
  let nested = EHandle(EUnit, [(PCtor("Dummy::Ping", array_empty()), performed)])
  let handled = EHandle(ESeq(nested, chan_literal()), [
    (PCtor("Carry::Yield", [PBind("it")]), EIdent("it", -1))
  ])
  assert_mapped_requires_async(handled)
}

test "mapped handler-arm payloads require Async inside the arm" {
  let performed = ECall(EIdent("perform", -1), [
    ECall(EIdent("Carry::Yield", -1), [chan_literal()], -1)
  ], -1)
  let handled = EHandle(ESeq(performed, EUnit), [
    (PCtor("Carry::Yield", [PBind("it")]), for_over(mapped_over(EIdent("it", -1))))
  ])
  let errors = check_async_effects_expr(handled, poly_map_env(), false)
  assert(Array::length(errors) > 0)
  let ok = check_async_effects_expr(handled, poly_map_env(), true)
  assert(eq(Array::length(ok), 0))
}
