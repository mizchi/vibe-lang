//# Imports

import @vibe/compiler/core {
  call_placement_install, call_placement_is_identity, call_placement_payload_valid
}

//# Misc

// A slot code is `(source + 1) * 2`, plus 1 when the value is wrapped in
// `Some`; 0 leaves an optional slot empty. Validation scans for a repeated
// source instead of building a set, so these pin what it still refuses.
test "a placement that fills each slot from a distinct source is valid" {
  inspect(call_placement_payload_valid(3, 0, [2, 4, 6]), "true")
  inspect(call_placement_payload_valid(3, 0, [6, 2, 4]), "true")
  inspect(call_placement_payload_valid(2, 0, [4, 0, 3]), "true")
}

test "a repeated, missing or out-of-range source is refused" {
  inspect(call_placement_payload_valid(3, 0, [2, 2, 6]), "false")
  inspect(call_placement_payload_valid(3, 0, [2, 3, 6]), "false")
  inspect(call_placement_payload_valid(3, 0, [2, 4]), "false")
  inspect(call_placement_payload_valid(2, 0, [2, 6]), "false")
  inspect(call_placement_payload_valid(2, 0, [1, 2]), "false")
}

test "identity is read from the cell: written order, every slot, no wrapping" {
  let cell: Array[Int] = []
  call_placement_install(cell, 3, 0, [2, 4, 6])
  inspect(call_placement_is_identity(cell, 3), "true")
  inspect(call_placement_is_identity(cell, 2), "false")
  let swapped: Array[Int] = []
  call_placement_install(swapped, 2, 0, [4, 2])
  inspect(call_placement_is_identity(swapped, 2), "false")
  let wrapped: Array[Int] = []
  call_placement_install(wrapped, 2, 0, [2, 5])
  inspect(call_placement_is_identity(wrapped, 2), "false")
  let omitted: Array[Int] = []
  call_placement_install(omitted, 1, 0, [2, 0])
  inspect(call_placement_is_identity(omitted, 1), "false")
}
