//# Imports

import @vibe/compiler/core {
  call_placement_install, call_placement_is_identity, call_placement_payload_valid
}

//# Misc

// A slot code is `(source + 1) * 2`, plus 1 when the value is wrapped in
// `Some`; 0 leaves an optional slot empty. Validation scans for a repeated
// source instead of building a set, so these pin what it still refuses.
test "a placement that fills each slot from a distinct source is valid" {
  inspect(call_placement_payload_valid(written = 3, mode = 0, slots = [2, 4, 6]), "true")
  inspect(call_placement_payload_valid(written = 3, mode = 0, slots = [6, 2, 4]), "true")
  inspect(call_placement_payload_valid(written = 2, mode = 0, slots = [4, 0, 3]), "true")
}

test "a repeated, missing or out-of-range source is refused" {
  inspect(call_placement_payload_valid(written = 3, mode = 0, slots = [2, 2, 6]), "false")
  inspect(call_placement_payload_valid(written = 3, mode = 0, slots = [2, 3, 6]), "false")
  inspect(call_placement_payload_valid(written = 3, mode = 0, slots = [2, 4]), "false")
  inspect(call_placement_payload_valid(written = 2, mode = 0, slots = [2, 6]), "false")
  inspect(call_placement_payload_valid(written = 2, mode = 0, slots = [1, 2]), "false")
}

test "identity is read from the cell: written order, every slot, no wrapping" {
  let cell: Array[Int] = []
  call_placement_install(cell = cell, written = 3, mode = 0, slots = [2, 4, 6])
  inspect(call_placement_is_identity(cell = cell, written = 3), "true")
  inspect(call_placement_is_identity(cell = cell, written = 2), "false")
  let swapped: Array[Int] = []
  call_placement_install(cell = swapped, written = 2, mode = 0, slots = [4, 2])
  inspect(call_placement_is_identity(cell = swapped, written = 2), "false")
  let wrapped: Array[Int] = []
  call_placement_install(cell = wrapped, written = 2, mode = 0, slots = [2, 5])
  inspect(call_placement_is_identity(cell = wrapped, written = 2), "false")
  let omitted: Array[Int] = []
  call_placement_install(cell = omitted, written = 1, mode = 0, slots = [2, 0])
  inspect(call_placement_is_identity(cell = omitted, written = 1), "false")
}
