//# Imports

import ./stmt_test_support.vibe {
  pp, ps
}

//# Misc

test "stmt_struct" {
  assert(ps("struct Point { x: Int; y: Int }") == "struct Point { x: Int; y: Int }")
}

test "stmt_struct_exported" {
  assert(ps("export struct Point { x: Int }") == "export struct Point { x: Int }")
}

test "stmt_type_alias" {
  assert(ps("type Name = String") == "type Name = String")
}

test "stmt_type_alias_exported" {
  assert(ps("export type Pair = (Int, String)") == "export type Pair = (Int, String)")
}

test "stmt_trait" {
  assert(ps("trait Show") == "trait Show")
}

test "stmt_impl" {
  assert(pp("impl Show for Int") == "impl Show for Int")
}

test "stmt_impl_type_params_accepted" {
  // Generic impl headers retain their parser-stored bounds. Target type
  // arguments are still erased by the SImpl AST representation.
  let result = pp("impl [A: Show] Show for Int")
  assert(result == "impl [A: Show] Show for Int")
}
