test "component: simple wrap has component header" {
  let core = build_test_core()
  let comp = comp_emit_component_wasm(core)
  assert(Bytes::get(comp, 0) == 0)
  assert(Bytes::get(comp, 1) == 97)
  assert(Bytes::get(comp, 2) == 115)
  assert(Bytes::get(comp, 3) == 109)
  assert(Bytes::get(comp, 4) == 13)
  assert(Bytes::length(comp) > Bytes::length(core))
}

test "component: lift no imports produces valid component" {
  let core = build_test_core()
  let comp = comp_emit_component_wasm_with_lift(core, "run")
  assert(Bytes::get(comp, 0) == 0)
  assert(Bytes::get(comp, 4) == 13)
  assert(Bytes::length(comp) > Bytes::length(core))
}

test "component: string trampoline has wasm header" {
  let tramp = comp_generate_string_trampoline(2, 0)
  assert(Bytes::get(tramp, 0) == 0)
  assert(Bytes::get(tramp, 1) == 97)
  assert(Bytes::get(tramp, 2) == 115)
  assert(Bytes::get(tramp, 3) == 109)
