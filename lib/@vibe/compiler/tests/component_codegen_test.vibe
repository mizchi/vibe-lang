// #1230 M1b-3c-1b: blocking await with the wait loop in its own function.
// The byte shapes asserted below were recovered empirically via
// `wasm-tools dump` against tools/wasip3_component_probe/spawned_future/
// component.wat's compiled output (see that probe's README.md and
// canon-imports-exports.wit-abi.txt), not hand-derived from the spec --
// this test pins the SAME shapes this composer's doc comments describe.
// A stronger, execution-based check (this exact composer's output run
// through the probe's Rust host driver against a genuinely-blocking host
// import, confirming a real ~300ms suspend and a correct result of 42)
// lives in scripts/test_spawned_future_component_gate.sh; `vibe test`
// itself has no Fs/subprocess access to drive that host binary.
//
// Note this emitter models "spawn" only in the degenerate case (nothing
// observable between spawn and join) -- see the composer's doc comment.
test "component async spawned-future: blocking await via a callee wait loop, no future.* canon" {
  let comp = comp_emit_component_wasm_async_spawned_future(export_name = "run", comp_result_valtype = 121)
  assert(Bytes::get(comp, at = 0) == 0)
  assert(Bytes::get(comp, at = 4) == 13)
  // task.return canon (u32=121): 08 05 01 09 00 79 00
  assert(bytes_contains_seq(hay = comp, needle = [8, 5, 1, 9, 0, 121, 0]) == 1)
  // async functype () -> u32: 07 05 01 43 00 00 79
  assert(bytes_contains_seq(hay = comp, needle = [7, 5, 1, 67, 0, 0, 121]) == 1)
  // canon lower(get-async) async (memory 0): 08 08 01 01 00 00 02 06 03 00
  assert(bytes_contains_seq(hay = comp, needle = [8, 8, 1, 1, 0, 0, 2, 6, 3, 0]) == 1)
  // canon waitable-set.new: 08 02 01 1f
  assert(bytes_contains_seq(hay = comp, needle = [8, 2, 1, 31]) == 1)
  // canon waitable.join: 08 02 01 23
  assert(bytes_contains_seq(hay = comp, needle = [8, 2, 1, 35]) == 1)
  // canon waitable-set.wait (memory 0): 08 04 01 20 00 00
  assert(bytes_contains_seq(hay = comp, needle = [8, 4, 1, 32, 0, 0]) == 1)
  // canon waitable-set.drop: 08 02 01 22
  assert(bytes_contains_seq(hay = comp, needle = [8, 2, 1, 34]) == 1)
  // canon subtask.drop: 08 02 01 0d
  assert(bytes_contains_seq(hay = comp, needle = [8, 2, 1, 13]) == 1)
  assert(component_bytes_contains(hay = comp, needle = "get-async") == 1)
  assert(component_bytes_contains(hay = comp, needle = "[async-lower]get-async") == 1)
  assert(component_bytes_contains(hay = comp, needle = "[waitable-set-new]") == 1)
  assert(component_bytes_contains(hay = comp, needle = "[waitable-join]") == 1)
  assert(component_bytes_contains(hay = comp, needle = "[waitable-set-wait]") == 1)
  assert(component_bytes_contains(hay = comp, needle = "[waitable-set-drop]") == 1)
  assert(component_bytes_contains(hay = comp, needle = "[subtask-drop]") == 1)
  assert(component_bytes_contains(hay = comp, needle = "[task-return]run") == 1)
  // No future.* canon anywhere: the emitted shape needs no canonical-ABI
  // future value (see composer's doc comment). "future" would only ever
  // appear inside a "[async-lower]"/"[async-lift]" wire name here, never
  // as its own bracketed canon name.
  assert(component_bytes_contains(hay = comp, needle = "[future") == 0)
  assert(component_bytes_contains(hay = comp, needle = "context-get") == 0)
  assert(component_bytes_contains(hay = comp, needle = "context-set") == 0)
  assert(component_bytes_contains(hay = comp, needle = "waitable-set-poll") == 0)
}

// #1240 review: the guest core module is hard-coded to an i32-shaped result,
// so any other requested lowering (notably the project's ordinary s64 `Int`)
// would emit a task.return canon disagreeing with the guest's own
// [task-return] import type and fail component validation. The emitter must
// reject it up front rather than produce an invalid component.
test "component async spawned-future: rejects a non-u32 result valtype" {
  let rejected = handle {
    let _ = comp_emit_component_wasm_async_spawned_future(export_name = "run", comp_result_valtype = 120)
    false
  } with { Exception::Throw(_) => true }
  assert(rejected)
}

// #1230 M1b-3c-3: the concurrent-awaits component -- two host operations
// genuinely in flight at once. It shares the composer (and therefore every
// canon section, import and export) with the spawned-future component; the
// entire difference is inside the guest core module, where both
// async-lowered calls are issued BEFORE either is waited on.
//
// So the interesting properties to pin here are (a) the shared composer
// still wires the same canon set through the new entry point, and (b) the
// two emitters do NOT produce identical bytes -- if the guest-module
// argument were ever mixed up, every canon assertion below would still
// pass while the component silently reverted to the serial shape. The
// runtime proof (84 in ~300ms rather than ~600ms for two 300ms host calls)
// lives in scripts/test_concurrent_awaits_component_gate.sh; `vibe test`
// cannot drive a component.
test "component async concurrent-awaits: same canon set as spawned-future, different guest" {
  let comp = comp_emit_component_wasm_async_concurrent_awaits(export_name = "run", comp_result_valtype = 121)
  assert(Bytes::get(comp, at = 0) == 0)
  assert(Bytes::get(comp, at = 4) == 13)
  // task.return canon (u32=121)
  assert(bytes_contains_seq(hay = comp, needle = [8, 5, 1, 9, 0, 121, 0]) == 1)
  // canon lower(get-async) async (memory 0)
  assert(bytes_contains_seq(hay = comp, needle = [8, 8, 1, 1, 0, 0, 2, 6, 3, 0]) == 1)
  assert(component_bytes_contains(hay = comp, needle = "get-async") == 1)
  assert(component_bytes_contains(hay = comp, needle = "[async-lower]get-async") == 1)
  assert(component_bytes_contains(hay = comp, needle = "[waitable-set-new]") == 1)
  assert(component_bytes_contains(hay = comp, needle = "[waitable-join]") == 1)
  assert(component_bytes_contains(hay = comp, needle = "[waitable-set-wait]") == 1)
  assert(component_bytes_contains(hay = comp, needle = "[waitable-set-drop]") == 1)
  assert(component_bytes_contains(hay = comp, needle = "[subtask-drop]") == 1)
  assert(component_bytes_contains(hay = comp, needle = "[task-return]run") == 1)
  // Still no future.*/context.*/poll -- concurrency needs none of them.
  assert(component_bytes_contains(hay = comp, needle = "[future") == 0)
  assert(component_bytes_contains(hay = comp, needle = "context-get") == 0)
  assert(component_bytes_contains(hay = comp, needle = "context-set") == 0)
  assert(component_bytes_contains(hay = comp, needle = "waitable-set-poll") == 0)
  // ...but it is NOT the spawned-future component.
  let serial = comp_emit_component_wasm_async_spawned_future(export_name = "run", comp_result_valtype = 121)
  assert(Bytes::length(comp) != Bytes::length(serial))
}

// Same u32-only guard as the spawned-future emitter: both share the
// composer, so the rejection must fire through the new entry point too.
test "component async concurrent-awaits: rejects a non-u32 result valtype" {
  let rejected = handle {
    let _ = comp_emit_component_wasm_async_concurrent_awaits(export_name = "run", comp_result_valtype = 120)
    false
  } with { Exception::Throw(_) => true }
  assert(rejected)
}

// ADR-0089 step 2 (#1218): the future-value component -- the first emitted
// shape that uses the literal `future.*` canonical built-ins. Byte shapes
// below were recovered via `wasm-tools dump` against
// tools/wasip3_component_probe/future_value/component.wat's compiled
// output (which returns 42 on wasmtime 47 with
// -W component-model-more-async-builtins=y), not hand-derived from the
// spec. Runtime proof (BLOCKED read -> eager write -> FUTURE_READ event ->
// 42) lives in scripts/test_future_value_component_gate.sh; `vibe test`
// cannot drive a component.
test "component future-value: future.* canon set, no host import, no subtask" {
  let comp = comp_emit_component_wasm_future_value(export_name = "run", comp_result_valtype = 121)
  assert(Bytes::get(comp, at = 0) == 0)
  assert(Bytes::get(comp, at = 4) == 13)
  // component type (future u32): 07 04 01 65 01 79
  assert(bytes_contains_seq(hay = comp, needle = [7, 4, 1, 101, 1, 121]) == 1)
  // canon future.new ty=0: 08 03 01 15 00
  assert(bytes_contains_seq(hay = comp, needle = [8, 3, 1, 21, 0]) == 1)
  // canon future.read ty=0 async (memory 0): 08 07 01 16 00 02 06 03 00
  assert(bytes_contains_seq(hay = comp, needle = [8, 7, 1, 22, 0, 2, 6, 3, 0]) == 1)
  // canon future.write ty=0 async (memory 0): 08 07 01 17 00 02 06 03 00
  assert(bytes_contains_seq(hay = comp, needle = [8, 7, 1, 23, 0, 2, 6, 3, 0]) == 1)
  // canon future.drop-readable ty=0: 08 03 01 1a 00
  assert(bytes_contains_seq(hay = comp, needle = [8, 3, 1, 26, 0]) == 1)
  // canon future.drop-writable ty=0: 08 03 01 1b 00
  assert(bytes_contains_seq(hay = comp, needle = [8, 3, 1, 27, 0]) == 1)
  // task.return canon (u32=121) and the waitable-set machinery ride along
  assert(bytes_contains_seq(hay = comp, needle = [8, 5, 1, 9, 0, 121, 0]) == 1)
  assert(component_bytes_contains(hay = comp, needle = "[future-new-0]make") == 1)
  assert(component_bytes_contains(hay = comp, needle = "[async-lower][future-read-0]make") == 1)
  assert(component_bytes_contains(hay = comp, needle = "[async-lower][future-write-0]make") == 1)
  assert(component_bytes_contains(hay = comp, needle = "[future-drop-readable-0]make") == 1)
  assert(component_bytes_contains(hay = comp, needle = "[future-drop-writable-0]make") == 1)
  assert(component_bytes_contains(hay = comp, needle = "[waitable-set-new]") == 1)
  assert(component_bytes_contains(hay = comp, needle = "[waitable-join]") == 1)
  assert(component_bytes_contains(hay = comp, needle = "[waitable-set-wait]") == 1)
  assert(component_bytes_contains(hay = comp, needle = "[waitable-set-drop]") == 1)
  assert(component_bytes_contains(hay = comp, needle = "[task-return]run") == 1)
  // Self-contained: no host async import, hence no canon lower and no
  // subtask anywhere in the shape.
  assert(component_bytes_contains(hay = comp, needle = "get-async") == 0)
  assert(component_bytes_contains(hay = comp, needle = "[subtask-drop]") == 0)
  assert(component_bytes_contains(hay = comp, needle = "context-get") == 0)
  assert(component_bytes_contains(hay = comp, needle = "waitable-set-poll") == 0)
}

// ADR-0089 Decision 2 / step 4 (#1218): the HOST-future-value component --
// imports `get-future` and parks the read on waitable-set.wait until the
// host's producer resolves. Byte shapes recovered via `wasm-tools dump`
// against tools/wasip3_component_probe/host_future_value/component.wat's
// compiled output (42 in ~300ms under runtime/viberun's FutureReader
// import -- the wall clock proving a genuine suspend). Runtime proof lives
// in scripts/test_host_future_value_component_gate.sh.
test "component host-future-value: get-future import + waitable park, no write end" {
  let comp = comp_emit_component_wasm_host_future_value(export_name = "run", comp_result_valtype = 121)
  assert(Bytes::get(comp, at = 0) == 0)
  assert(Bytes::get(comp, at = 4) == 13)
  // component type (future u32): 07 04 01 65 01 79
  assert(bytes_contains_seq(hay = comp, needle = [7, 4, 1, 101, 1, 121]) == 1)
  // import functype `async () -> (type 0)`: 07 05 01 43 00 00 00
  assert(bytes_contains_seq(hay = comp, needle = [7, 5, 1, 67, 0, 0, 0]) == 1)
  // component import of get-future with functype index 1:
  // 0a 0f 01 00 0a "get-future" 01 01
  assert(bytes_contains_seq(hay = comp, needle = [10, 15, 1, 0, 10]) == 1)
  assert(component_bytes_contains(hay = comp, needle = "get-future") == 1)
  // canon lower async (memory 0) of the import: 08 08 01 01 00 00 02 06 03 00
  assert(bytes_contains_seq(hay = comp, needle = [8, 8, 1, 1, 0, 0, 2, 6, 3, 0]) == 1)
  // canon future.read ty=0 async (memory 0): 08 07 01 16 00 02 06 03 00
  assert(bytes_contains_seq(hay = comp, needle = [8, 7, 1, 22, 0, 2, 6, 3, 0]) == 1)
  // canon future.drop-readable ty=0: 08 03 01 1a 00
  assert(bytes_contains_seq(hay = comp, needle = [8, 3, 1, 26, 0]) == 1)
  assert(component_bytes_contains(hay = comp, needle = "[async-lower]get-future") == 1)
  assert(component_bytes_contains(hay = comp, needle = "[async-lower][future-read-0]get-future") == 1)
  assert(component_bytes_contains(hay = comp, needle = "[future-drop-readable-0]get-future") == 1)
  assert(component_bytes_contains(hay = comp, needle = "[waitable-set-new]") == 1)
  assert(component_bytes_contains(hay = comp, needle = "[waitable-join]") == 1)
  assert(component_bytes_contains(hay = comp, needle = "[waitable-set-wait]") == 1)
  assert(component_bytes_contains(hay = comp, needle = "[waitable-set-drop]") == 1)
  assert(component_bytes_contains(hay = comp, needle = "[task-return]run") == 1)
  // The host owns the write end: no future.new, no write, no
  // drop-writable anywhere in the shape -- and no subtask machinery
  // (the get-future call itself must complete eagerly).
  assert(component_bytes_contains(hay = comp, needle = "future-new") == 0)
  assert(component_bytes_contains(hay = comp, needle = "future-write") == 0)
  assert(component_bytes_contains(hay = comp, needle = "future-drop-writable") == 0)
  assert(component_bytes_contains(hay = comp, needle = "[subtask-drop]") == 0)
}

test "component host-future-value: rejects a non-u32 result valtype" {
  let rejected = handle {
    let _ = comp_emit_component_wasm_host_future_value(export_name = "run", comp_result_valtype = 120)
    false
  } with { Exception::Throw(_) => true }
  assert(rejected)
}

// ADR-0089 step 4 (#1218): a stand-in for a REAL compiled core whose
// program calls `host_future_get` -- exports `run : (i64) -> i64` and
// imports fd_write + the vibe host-future pair, exactly the import set
// linked_compile emits for such a program. `with_run` false drops the run
// export (the composer must reject); `extra_import` adds a vibe.sh import
// (outside the composition's allowlist, must also reject).
fn build_main_i64_core_hostfuture(with_run: Bool, extra_import: Bool) -> Bytes {
  let out = bytebuf_new()
  emit_header(out)
  let tc = bytebuf_new()
  bytebuf_push_vec_header(buf = tc, count = 3)
  emit_func_type_raw(buf = tc, param_types = [127, 127, 127, 127], result_types = [127])
  emit_func_type_raw(buf = tc, param_types = [126], result_types = [126])
  emit_func_type_raw(buf = tc, param_types = array_empty(), result_types = [126])
  bytebuf_push_section(out = out, section_id = 1, content = tc)
  let ic = bytebuf_new()
  bytebuf_push_vec_header(buf = ic, count = if extra_import {
    4
  } else {
    3
  })
  emit_name(buf = ic, name = "wasi_snapshot_preview1")
  emit_name(buf = ic, name = "fd_write")
  bytebuf_push(buf = ic, byte = 0)
  bytebuf_push(buf = ic, byte = 0)
  emit_name(buf = ic, name = "vibe")
  emit_name(buf = ic, name = "host_future_get")
  bytebuf_push(buf = ic, byte = 0)
  bytebuf_push(buf = ic, byte = 2)
  emit_name(buf = ic, name = "vibe")
  emit_name(buf = ic, name = "host_future_wait")
  bytebuf_push(buf = ic, byte = 0)
  bytebuf_push(buf = ic, byte = 1)
  if extra_import {
    emit_name(buf = ic, name = "vibe")
    emit_name(buf = ic, name = "sh")
    bytebuf_push(buf = ic, byte = 0)
    bytebuf_push(buf = ic, byte = 1)
  } else {
    ()
  }
  bytebuf_push_section(out = out, section_id = 2, content = ic)
  emit_function_section(out = out, type_indices = [1])
  let local_func_idx = if extra_import {
    4
  } else {
    3
  }
  if with_run {
    emit_export_section(out = out, name = "run", func_idx = local_func_idx)
  } else {
    emit_export_section(out = out, name = "main", func_idx = local_func_idx)
  }
  let body = bytebuf_new()
  emit_i64_const(buf = body, value = 42)
  emit_code_section(out = out, bodies = [body])
  bytebuf_to_bytes(out)
}

// The step-4 composition: a host-future-importing core is wrapped with the
// adapter module (canon built-ins over the memhost memory), the fd_write
// stub, and the u32 trampoline, importing `get-future` from the host.
// Runtime proof (42 in ~wall >= 0.8 x delay through a real compiled
// program) lives in scripts/test_hostfuture_source_component_gate.sh.
test "component async hostfuture: adapter-backed composition of a real-shaped core" {
  let core = build_main_i64_core_hostfuture(with_run = true, extra_import = false)
  assert(comp_core_imports_host_future(core) == true)
  // The p1 test core (fd_write only) must NOT sniff as host-future.
  assert(comp_core_imports_host_future(build_main_i64_core_p1()) == false)
  let comp = comp_emit_component_wasm_async_hostfuture(main_core_wasm = core_with_tag_mode(core = core, mode = 1), export_name = "run")
  assert(Bytes::get(comp, at = 0) == 0)
  assert(Bytes::get(comp, at = 4) == 13)
  // component type (future u32): 07 04 01 65 01 79
  assert(bytes_contains_seq(hay = comp, needle = [7, 4, 1, 101, 1, 121]) == 1)
  // import functype `async () -> (type 0)`: 07 05 01 43 00 00 00
  assert(bytes_contains_seq(hay = comp, needle = [7, 5, 1, 67, 0, 0, 0]) == 1)
  assert(component_bytes_contains(hay = comp, needle = "get-future") == 1)
  // canon lower async (memory 0) of the import: 08 08 01 01 00 00 02 06 03 00
  assert(bytes_contains_seq(hay = comp, needle = [8, 8, 1, 1, 0, 0, 2, 6, 3, 0]) == 1)
  // the adapter's canon set + the pair it exports to the main module
  assert(component_bytes_contains(hay = comp, needle = "[async-lower]get-future") == 1)
  assert(component_bytes_contains(hay = comp, needle = "[async-lower][future-read-0]get-future") == 1)
  assert(component_bytes_contains(hay = comp, needle = "[future-drop-readable-0]get-future") == 1)
  assert(component_bytes_contains(hay = comp, needle = "[waitable-set-new]") == 1)
  assert(component_bytes_contains(hay = comp, needle = "[waitable-join]") == 1)
  assert(component_bytes_contains(hay = comp, needle = "[waitable-set-wait]") == 1)
  assert(component_bytes_contains(hay = comp, needle = "[waitable-set-drop]") == 1)
  assert(component_bytes_contains(hay = comp, needle = "host_future_get") == 1)
  assert(component_bytes_contains(hay = comp, needle = "host_future_wait") == 1)
  // u32-lifted run through the trampoline's task-return
  assert(component_bytes_contains(hay = comp, needle = "task-return") == 1)
  // The host owns the write end; the import call must complete eagerly --
  // no write-side or subtask machinery anywhere in the shape.
  assert(component_bytes_contains(hay = comp, needle = "future-new") == 0)
  assert(component_bytes_contains(hay = comp, needle = "future-write") == 0)
  assert(component_bytes_contains(hay = comp, needle = "future-drop-writable") == 0)
  assert(component_bytes_contains(hay = comp, needle = "[subtask-drop]") == 0)
}

// ADR-0089 (c) (#1218): a stand-in for a compiled core whose program calls
// `host_future_named("price")` and `host_future_named("qty")` and nothing
// anonymous -- so the import set is fd_write + the shared wait half + one
// `vibe.host_future_get$<name>` per name, in linked_compile's sorted order.
fn build_main_i64_core_hostfuture_named() -> Bytes {
  let out = bytebuf_new()
  emit_header(out)
  let tc = bytebuf_new()
  bytebuf_push_vec_header(buf = tc, count = 3)
  emit_func_type_raw(buf = tc, param_types = [127, 127, 127, 127], result_types = [127])
  emit_func_type_raw(buf = tc, param_types = [126], result_types = [126])
  emit_func_type_raw(buf = tc, param_types = array_empty(), result_types = [126])
  bytebuf_push_section(out = out, section_id = 1, content = tc)
  let ic = bytebuf_new()
  bytebuf_push_vec_header(buf = ic, count = 4)
  emit_name(buf = ic, name = "wasi_snapshot_preview1")
  emit_name(buf = ic, name = "fd_write")
  bytebuf_push(buf = ic, byte = 0)
  bytebuf_push(buf = ic, byte = 0)
  emit_name(buf = ic, name = "vibe")
  emit_name(buf = ic, name = "host_future_wait")
  bytebuf_push(buf = ic, byte = 0)
  bytebuf_push(buf = ic, byte = 1)
  emit_name(buf = ic, name = "vibe")
  emit_name(buf = ic, name = "host_future_get$price")
  bytebuf_push(buf = ic, byte = 0)
  bytebuf_push(buf = ic, byte = 2)
  emit_name(buf = ic, name = "vibe")
  emit_name(buf = ic, name = "host_future_get$qty")
  bytebuf_push(buf = ic, byte = 0)
  bytebuf_push(buf = ic, byte = 2)
  bytebuf_push_section(out = out, section_id = 2, content = ic)
  emit_function_section(out = out, type_indices = [1])
  emit_export_section(out = out, name = "run", func_idx = 4)
  let body = bytebuf_new()
  emit_i64_const(buf = body, value = 42)
  emit_code_section(out = out, bodies = [body])
  bytebuf_to_bytes(out)
}

test "component async WIT future: core metadata selects a real interface import (#2064)" {
  let comp = comp_emit_component_wasm_async_wit_future_fixture()
  assert(component_bytes_contains(hay = comp, needle = "example:prices/api@1.0.0") == 1)
  assert(component_bytes_contains(hay = comp, needle = "get-price") == 1)
  assert(component_bytes_contains(hay = comp, needle = "get-tax") == 1)
  assert(component_bytes_contains(hay = comp, needle = "example:inventory/api@2.1.0") == 1)
  assert(component_bytes_contains(hay = comp, needle = "get-stock") == 1)
  assert(component_bytes_contains(hay = comp, needle = "wit_future_get$example:prices/api@1.0.0#get-price") == 1)
}

test "component async WIT future: mixed root payload ABI fails closed (#2064)" {
  let rejected = handle {
    let _ = comp_emit_component_wasm_async_wit_future_mixed_fixture()
    false
  } with { Exception::Throw(msg) => String::contains(msg, needle = "cannot mix runner-private future<u32> root imports with WIT-derived future<s64>") }
  assert(rejected)
}

// ADR-0089 (c) (#1218): two NAMED host futures compose into two component
// imports and two adapter getters, sharing one wait half and one pair of
// future.read / future.drop-readable canon defs (every host future here is
// the same `future<u32>` type). Runtime proof -- both in flight at once,
// total wall = max(delay) not sum(delay) -- lives in
// scripts/test_named_hostfutures_component_gate.sh.
test "component async hostfuture: two named host futures become two component imports (#1218 (c))" {
  let core = build_main_i64_core_hostfuture_named()
  assert(comp_core_imports_host_future(core) == true)
  let names = comp_core_host_future_names(core)
  assert(Array::length(names) == 2)
  assert(Array::get(names, at = 0) == "host_future_get$price")
  assert(Array::get(names, at = 1) == "host_future_get$qty")
  let comp = comp_emit_component_wasm_async_hostfuture(main_core_wasm = core_with_tag_mode(core = core, mode = 1), export_name = "run")
  assert(Bytes::get(comp, at = 0) == 0)
  assert(Bytes::get(comp, at = 4) == 13)
  // No anonymous `get-future`: this program never asked for one, and an
  // unused import is still an import the host must satisfy.
  assert(component_bytes_contains(hay = comp, needle = "get-future") == 0)
  // one lowered import per name...
  assert(component_bytes_contains(hay = comp, needle = "[async-lower]price") == 1)
  assert(component_bytes_contains(hay = comp, needle = "[async-lower]qty") == 1)
  // ...but ONE shared read/drop pair, spelled after the first name
  assert(component_bytes_contains(hay = comp, needle = "[async-lower][future-read-0]price") == 1)
  assert(component_bytes_contains(hay = comp, needle = "[future-drop-readable-0]price") == 1)
  assert(component_bytes_contains(hay = comp, needle = "[async-lower][future-read-0]qty") == 0)
  assert(component_bytes_contains(hay = comp, needle = "[future-drop-readable-0]qty") == 0)
  // the adapter exports one getter per name under the CORE import spelling
  // the guest calls, plus the single shared wait
  assert(component_bytes_contains(hay = comp, needle = "host_future_get$price") == 1)
  assert(component_bytes_contains(hay = comp, needle = "host_future_get$qty") == 1)
  assert(component_bytes_contains(hay = comp, needle = "host_future_wait") == 1)
  assert(component_bytes_contains(hay = comp, needle = "[waitable-set-wait]") == 1)
  // still the host-owned-writer shape: no write side anywhere
  assert(component_bytes_contains(hay = comp, needle = "future-new") == 0)
  assert(component_bytes_contains(hay = comp, needle = "future-write") == 0)
  assert(component_bytes_contains(hay = comp, needle = "future-drop-writable") == 0)
}

// #1342: a stand-in for a compiled core whose `() -> Int with Async` entry
// calls `sleep(ms)` -- the boundary settles the suspend through the row-free
// `sleep_blocking`, which is a `vibe.sleep (i64) -> ()` host import. With
// `with_future`, the same core also awaits a named host future, which is the
// shape that proves the sleep half rides the SAME composition rather than
// forcing a second one.
fn build_main_i64_core_sleep(_ with_future: Bool) -> Bytes {
  let out = bytebuf_new()
  emit_header(out)
  let tc = bytebuf_new()
  bytebuf_push_vec_header(buf = tc, count = 4)
  emit_func_type_raw(buf = tc, param_types = [127, 127, 127, 127], result_types = [127])
  emit_func_type_raw(buf = tc, param_types = [126], result_types = [126])
  emit_func_type_raw(buf = tc, param_types = [126], result_types = array_empty())
  emit_func_type_raw(buf = tc, param_types = array_empty(), result_types = [126])
  bytebuf_push_section(out = out, section_id = 1, content = tc)
  let ic = bytebuf_new()
  bytebuf_push_vec_header(buf = ic, count = if with_future {
    4
  } else {
    2
  })
  emit_name(buf = ic, name = "wasi_snapshot_preview1")
  emit_name(buf = ic, name = "fd_write")
  bytebuf_push(buf = ic, byte = 0)
  bytebuf_push(buf = ic, byte = 0)
  emit_name(buf = ic, name = "vibe")
  emit_name(buf = ic, name = "sleep")
  bytebuf_push(buf = ic, byte = 0)
  bytebuf_push(buf = ic, byte = 2)
  if with_future {
    emit_name(buf = ic, name = "vibe")
    emit_name(buf = ic, name = "host_future_get$price")
    bytebuf_push(buf = ic, byte = 0)
    bytebuf_push(buf = ic, byte = 3)
    emit_name(buf = ic, name = "vibe")
    emit_name(buf = ic, name = "host_future_wait")
    bytebuf_push(buf = ic, byte = 0)
    bytebuf_push(buf = ic, byte = 1)
  } else {
    ()
  }
  bytebuf_push_section(out = out, section_id = 2, content = ic)
  emit_function_section(out = out, type_indices = [1])
  emit_export_section(out = out, name = "run", func_idx = if with_future {
    4
  } else {
    2
  })
  let body = bytebuf_new()
  emit_i64_const(buf = body, value = 42)
  emit_code_section(out = out, bodies = [body])
  bytebuf_to_bytes(out)
}

// #1342: `sleep` inside an async component. The host side is an `async
// func(ms: u32) -> u32`, so unlike the future/stream halves the adapter gets a
// SUBTASK back and parks on that -- hence `[subtask-drop]`, which no other
// shape on this composition carries. Runtime proof (42 after a real host
// timer, and a host future that keeps making progress DURING the sleep) lives
// in scripts/test_async_sleep_component_gate.sh.
test "component async sleep: vibe.sleep composes through the adapter (#1342)" {
  let core = build_main_i64_core_sleep(false)
  assert(comp_core_imports_sleep(core) == true)
  assert(comp_core_imports_sleep(build_main_i64_core_p1()) == false)
  // A sleep-only core has no future/stream imports at all, so this is also
  // the case that used to fall into the self-contained wrap.
  assert(comp_core_imports_host_future(core) == false)
  assert(comp_core_imports_host_stream(core) == false)
  let comp = comp_emit_component_wasm_async_hostfuture(main_core_wasm = core_with_tag_mode(core = core, mode = 1), export_name = "run")
  assert(Bytes::get(comp, at = 0) == 0)
  assert(Bytes::get(comp, at = 4) == 13)
  // `sleep-for: async func(ms: u32) -> u32` -- one functype with a NAMED
  // param, and no defined value type of its own:
  // 07 09 01 43 01 02 6d 73 79 00 79
  assert(bytes_contains_seq(hay = comp, needle = [7, 9, 1, 67, 1, 2, 109, 115, 121, 0, 121]) == 1)
  assert(component_bytes_contains(hay = comp, needle = "sleep-for") == 1)
  assert(component_bytes_contains(hay = comp, needle = "[async-lower]sleep-for") == 1)
  assert(component_bytes_contains(hay = comp, needle = "[subtask-drop]") == 1)
  assert(component_bytes_contains(hay = comp, needle = "[waitable-set-wait]") == 1)
  // No future or stream machinery: the program asked for neither, and an
  // unused import is still an import the host has to satisfy.
  assert(component_bytes_contains(hay = comp, needle = "get-future") == 0)
  assert(component_bytes_contains(hay = comp, needle = "future-read") == 0)
  assert(component_bytes_contains(hay = comp, needle = "stream-read") == 0)
}

// #1342: sleep and a named host future on ONE composition. The two halves are
// independent -- adding sleep must not disturb the future's imports, canon
// defs or adapter exports.
test "component async sleep: rides the same composition as a host future (#1342)" {
  let core = build_main_i64_core_sleep(true)
  assert(comp_core_imports_sleep(core) == true)
  assert(comp_core_imports_host_future(core) == true)
  let comp = comp_emit_component_wasm_async_hostfuture(main_core_wasm = core_with_tag_mode(core = core, mode = 1), export_name = "run")
  assert(component_bytes_contains(hay = comp, needle = "sleep-for") == 1)
  assert(component_bytes_contains(hay = comp, needle = "[subtask-drop]") == 1)
  assert(component_bytes_contains(hay = comp, needle = "[async-lower]price") == 1)
  assert(component_bytes_contains(hay = comp, needle = "[async-lower][future-read-0]price") == 1)
  assert(component_bytes_contains(hay = comp, needle = "host_future_get$price") == 1)
  assert(component_bytes_contains(hay = comp, needle = "host_future_wait") == 1)
}

// #1342: the self-contained wrap provides a preview1 fd_write stub and
// nothing else. It used to emit a component for a core importing more than
// that -- an artifact `wasm-tools validate` rejects with "missing module
// instantiation argument named `vibe`" -- while the compiler exited 0.
test "component async: an unprovided host import is rejected, not emitted (#1342)" {
  let rejected = handle {
    comp_reject_unsatisfiable_selfcontained_imports(build_main_i64_core_sleep(false))
    false
  } with { Exception::Throw(_) => true }
  assert(rejected)
  // The two the composition really does provide stay accepted, so the guard
  // cannot start rejecting the shapes it is meant to let through.
  let accepted = handle {
    comp_reject_unsatisfiable_selfcontained_imports(build_main_i64_core_p1())
    true
  } with { Exception::Throw(_) => false }
  assert(accepted)
}

// The anonymous surface still sniffs as exactly one name, so the step-4
// composition is unchanged by the generalization.
test "component async hostfuture: the anonymous host future is a one-name list (#1218 (c))" {
  let names = comp_core_host_future_names(build_main_i64_core_hostfuture(with_run = true, extra_import = false))
  assert(Array::length(names) == 1)
  assert(Array::get(names, at = 0) == "host_future_get")
  assert(Array::length(comp_core_host_future_names(build_main_i64_core_p1())) == 0)
}

fn build_main_i64_core_stdin_provider(module_name: String, include_acquire: Bool, duplicate_acquire: Bool, malformed_acquire: Bool, include_read: Bool, include_close: Bool, include_named_stream: Bool) -> Bytes {
  let out = bytebuf_new()
  emit_header(out)
  // 0 fd_write; 1 ()->i64; 2 (i64)->i64; 3 (i64)->i64 malformed
  // acquire; 4 (i64)->i64 run.
  let tc = bytebuf_new()
  bytebuf_push_vec_header(buf = tc, count = 5)
  emit_func_type_raw(buf = tc, param_types = [127, 127, 127, 127], result_types = [127])
  emit_func_type_raw(buf = tc, param_types = array_empty(), result_types = [126])
  emit_func_type_raw(buf = tc, param_types = [126], result_types = [126])
  emit_func_type_raw(buf = tc, param_types = [126], result_types = [126])
  emit_func_type_raw(buf = tc, param_types = [126], result_types = [126])
  bytebuf_push_section(out = out, section_id = 1, content = tc)
  let import_count = 1 + if include_acquire {
    1
  } else {
    0
  } + if duplicate_acquire {
    1
  } else {
    0
  } + if include_read {
    1
  } else {
    0
  } + if include_close {
    1
  } else {
    0
  } + if include_named_stream {
    1
  } else {
    0
  }
  let ic = bytebuf_new()
  bytebuf_push_vec_header(buf = ic, count = import_count)
  emit_name(buf = ic, name = "wasi_snapshot_preview1")
  emit_name(buf = ic, name = "fd_write")
  bytebuf_push(buf = ic, byte = 0)
  bytebuf_push(buf = ic, byte = 0)
  if include_acquire {
    emit_name(buf = ic, name = module_name)
    emit_name(buf = ic, name = "stdin_provider_acquire")
    bytebuf_push(buf = ic, byte = 0)
    bytebuf_push(buf = ic, byte = if malformed_acquire {
      3
    } else {
      1
    })
  } else {
    ()
  }
  if duplicate_acquire {
    emit_name(buf = ic, name = module_name)
    emit_name(buf = ic, name = "stdin_provider_acquire")
    bytebuf_push(buf = ic, byte = 0)
    bytebuf_push(buf = ic, byte = 1)
  } else {
    ()
  }
  if include_read {
    emit_name(buf = ic, name = module_name)
    emit_name(buf = ic, name = "stdin_provider_read")
    bytebuf_push(buf = ic, byte = 0)
    bytebuf_push(buf = ic, byte = 2)
  } else {
    ()
  }
  if include_close {
    emit_name(buf = ic, name = module_name)
    emit_name(buf = ic, name = "stdin_provider_close")
    bytebuf_push(buf = ic, byte = 0)
    bytebuf_push(buf = ic, byte = 2)
  } else {
    ()
  }
  if include_named_stream {
    emit_name(buf = ic, name = "vibe")
    emit_name(buf = ic, name = "host_stream_get$body")
    bytebuf_push(buf = ic, byte = 0)
    bytebuf_push(buf = ic, byte = 1)
  } else {
    ()
  }
  bytebuf_push_section(out = out, section_id = 2, content = ic)
  emit_function_section(out = out, type_indices = [4])
  emit_export_section(out = out, name = "run", func_idx = import_count)
  let body = bytebuf_new()
  emit_i64_const(buf = body, value = 42)
  emit_code_section(out = out, bodies = [body])
  bytebuf_to_bytes(out)
}

fn build_main_i64_core_hoststream_named(_ with_future: Bool) -> Bytes {
  let out = bytebuf_new()
  emit_header(out)
  let tc = bytebuf_new()
  bytebuf_push_vec_header(buf = tc, count = 3)
  emit_func_type_raw(buf = tc, param_types = [127, 127, 127, 127], result_types = [127])
  emit_func_type_raw(buf = tc, param_types = [126], result_types = [126])
  emit_func_type_raw(buf = tc, param_types = array_empty(), result_types = [126])
  bytebuf_push_section(out = out, section_id = 1, content = tc)
  let ic = bytebuf_new()
  bytebuf_push_vec_header(buf = ic, count = if with_future {
    5
  } else {
    3
  })
  emit_name(buf = ic, name = "wasi_snapshot_preview1")
  emit_name(buf = ic, name = "fd_write")
  bytebuf_push(buf = ic, byte = 0)
  bytebuf_push(buf = ic, byte = 0)
  if with_future {
    emit_name(buf = ic, name = "vibe")
    emit_name(buf = ic, name = "host_future_wait")
    bytebuf_push(buf = ic, byte = 0)
    bytebuf_push(buf = ic, byte = 1)
    emit_name(buf = ic, name = "vibe")
    emit_name(buf = ic, name = "host_future_get$price")
    bytebuf_push(buf = ic, byte = 0)
    bytebuf_push(buf = ic, byte = 2)
  } else {
    ()
  }
  emit_name(buf = ic, name = "vibe")
  emit_name(buf = ic, name = "host_stream_read")
  bytebuf_push(buf = ic, byte = 0)
  bytebuf_push(buf = ic, byte = 1)
  emit_name(buf = ic, name = "vibe")
  emit_name(buf = ic, name = "host_stream_get$body")
  bytebuf_push(buf = ic, byte = 0)
  bytebuf_push(buf = ic, byte = 2)
  bytebuf_push_section(out = out, section_id = 2, content = ic)
  emit_function_section(out = out, type_indices = [1])
  emit_export_section(out = out, name = "run", func_idx = if with_future {
    5
  } else {
    3
  })
  let body = bytebuf_new()
  emit_i64_const(buf = body, value = 42)
  emit_code_section(out = out, bodies = [body])
  bytebuf_to_bytes(out)
}

// #1539 is intentionally a separate, production-unused component: exact
// stdin imports plus an opaque provider-table adapter and private scenarios.
test "component stdin provider shadow: distinct lifecycle adapter remains unrouted (#1539)" {
  let comp = comp_emit_component_wasm_stdin_provider_shadow()
  assert(component_bytes_contains(hay = comp, needle = "wasi:cli/types@0.3.0") == 1)
  assert(component_bytes_contains(hay = comp, needle = "wasi:cli/stdin@0.3.0") == 1)
  assert(component_bytes_contains(hay = comp, needle = "read-via-stream") == 1)
  assert(component_bytes_contains(hay = comp, needle = "stdin-provider-shadow-acquire") == 1)
  assert(component_bytes_contains(hay = comp, needle = "stdin-provider-shadow-read") == 1)
  assert(component_bytes_contains(hay = comp, needle = "stdin-provider-shadow-settle") == 1)
  assert(component_bytes_contains(hay = comp, needle = "drain") == 1)
  assert(component_bytes_contains(hay = comp, needle = "early-close") == 1)
  assert(component_bytes_contains(hay = comp, needle = "forced-completion-tag-control") == 1)
  assert(component_bytes_contains(hay = comp, needle = "foreign-provider-control") == 1)
  assert(component_bytes_contains(hay = comp, needle = "wrong-byte-cleanup-control") == 1)
  assert(component_bytes_contains(hay = comp, needle = "extra-byte-cleanup-control") == 1)
  assert(component_bytes_contains(hay = comp, needle = "[async-lower][stream-read-0]read-via-stream") == 1)
  assert(component_bytes_contains(hay = comp, needle = "[async-lower][future-read-1]read-via-stream") == 1)
  assert(component_bytes_contains(hay = comp, needle = "[waitable-set-wait]") == 1)
  assert(component_bytes_contains(hay = comp, needle = "host_stream_get$stdin") == 0)
  assert(component_bytes_contains(hay = comp, needle = "host_stream_close") == 0)
}

// #1539 bounded production route: parsed exact imports key the nominal stdin
// composer, while the main guest receives only the tagged bridge instance.
test "component stdin provider: exact core imports compose through tagged bridge (#1539)" {
  let core = build_main_i64_core_stdin_provider(module_name = "vibe", include_acquire = true, duplicate_acquire = false, malformed_acquire = false, include_read = true, include_close = true, include_named_stream = false)
  assert(comp_core_imports_stdin_provider(core))
  let comp = comp_emit_component_wasm_async_stdin_provider(main_core_wasm = core, export_name = "run")
  assert(component_bytes_contains(hay = comp, needle = "wasi:cli/types@0.3.0") == 1)
  assert(component_bytes_contains(hay = comp, needle = "wasi:cli/stdin@0.3.0") == 1)
  assert(component_bytes_contains(hay = comp, needle = "stdin_provider_acquire") == 1)
  assert(component_bytes_contains(hay = comp, needle = "stdin_provider_read") == 1)
  assert(component_bytes_contains(hay = comp, needle = "stdin_provider_close") == 1)
  assert(component_bytes_contains(hay = comp, needle = "[async-lower][stream-read-0]read-via-stream") == 1)
  assert(component_bytes_contains(hay = comp, needle = "[async-lower][future-read-1]read-via-stream") == 1)
  assert(component_bytes_contains(hay = comp, needle = "host_stream_get$stdin") == 0)
  assert(component_bytes_contains(hay = comp, needle = "host_stream_read") == 0)
  assert(component_bytes_contains(hay = comp, needle = "host_stream_close") == 0)
  let drain = comp_emit_component_wasm_async_stdin_provider_fixture(0)
  let early = comp_emit_component_wasm_async_stdin_provider_fixture(1)
  assert(Bytes::length(drain) > 208)
  assert(Bytes::length(early) > 208)
  assert(Bytes::length(drain) != Bytes::length(early))
}

fn stdin_provider_compose_rejection(_ core: Bytes) -> String {
  handle {
    let _ = comp_emit_component_wasm_async_stdin_provider(main_core_wasm = core, export_name = "run")
    ""
  } with { Exception::Throw(message) => message }
}

fn stdin_provider_compose_rejected(_ core: Bytes) -> Bool {
  stdin_provider_compose_rejection(core) != ""
}

test "component stdin provider: malformed signature is rejected (#1539)" {
  let core = build_main_i64_core_stdin_provider(module_name = "vibe", include_acquire = true, duplicate_acquire = false, malformed_acquire = true, include_read = true, include_close = false, include_named_stream = false)
  assert(comp_core_imports_stdin_provider(core))
  assert(stdin_provider_compose_rejected(core))
}

test "component stdin provider: wrong module is rejected (#1539)" {
  let core = build_main_i64_core_stdin_provider(module_name = "wrong", include_acquire = true, duplicate_acquire = false, malformed_acquire = false, include_read = true, include_close = false, include_named_stream = false)
  assert(comp_core_imports_stdin_provider(core) == false)
  assert(stdin_provider_compose_rejected(core))
}

test "component stdin provider: read without acquire is rejected (#1539)" {
  let core = build_main_i64_core_stdin_provider(module_name = "vibe", include_acquire = false, duplicate_acquire = false, malformed_acquire = false, include_read = true, include_close = false, include_named_stream = false)
  assert(comp_core_imports_stdin_provider(core))
  assert(stdin_provider_compose_rejected(core))
}

test "component stdin provider: duplicate provider import is rejected (#1539)" {
  let core = build_main_i64_core_stdin_provider(module_name = "vibe", include_acquire = true, duplicate_acquire = true, malformed_acquire = false, include_read = true, include_close = false, include_named_stream = false)
  assert(comp_core_imports_stdin_provider(core))
  assert(stdin_provider_compose_rejection(core) == "component(async-stdin-provider): duplicate stdin-provider core import")
}

test "component stdin provider: acquire without consumer is rejected (#1539)" {
  let core = build_main_i64_core_stdin_provider(module_name = "vibe", include_acquire = true, duplicate_acquire = false, malformed_acquire = false, include_read = false, include_close = false, include_named_stream = false)
  assert(comp_core_imports_stdin_provider(core))
  assert(stdin_provider_compose_rejection(core) == "component(async-stdin-provider): stdin_provider_acquire requires at least one consuming read or close import")
}

test "component stdin provider: named stream mixing is rejected (#1539)" {
  let core = build_main_i64_core_stdin_provider(module_name = "vibe", include_acquire = true, duplicate_acquire = false, malformed_acquire = false, include_read = true, include_close = true, include_named_stream = true)
  assert(comp_core_imports_stdin_provider(core))
  assert(comp_core_imports_host_stream(core))
  assert(stdin_provider_compose_rejected(core))
}

// ADR-0089 Decision 3 (#1218): a named host STREAM composes into a
// `stream<u8>` component import, a per-name adapter getter and the shared
// `host_stream_read` half (stream.read + waitable-set.wait per READ, EOS =
// the measured amount-0/code-1 status -> -1). Runtime proof (42 = summed
// bytes to end of stream through a real compiled program) lives in
// scripts/test_named_hoststreams_component_gate.sh.
fn core_with_tag_mode(core: Bytes, mode: Int) -> Bytes {
  let out = bytebuf_new()
  let mut i = 0
  while i < Bytes::length(core) {
    bytebuf_push(buf = out, byte = Bytes::get(core, at = i))
    i = i + 1
  }
  let content = bytebuf_new()
  emit_name(buf = content, name = "vibe.tagmode")
  bytebuf_push(buf = content, byte = mode&255)
  bytebuf_push(buf = content, byte = (mode>>8)&255)
  bytebuf_push(buf = content, byte = (mode>>16)&255)
  bytebuf_push(buf = content, byte = (mode>>24)&255)
  bytebuf_push_section(out = out, section_id = 0, content = content)
  bytebuf_to_bytes(out)
}

fn core_with_short_tag_mode(_ core: Bytes) -> Bytes {
  let out = bytebuf_new()
  let mut i = 0
  while i < Bytes::length(core) {
    bytebuf_push(buf = out, byte = Bytes::get(core, at = i))
    i = i + 1
  }
  let content = bytebuf_new()
  emit_name(buf = content, name = "vibe.tagmode")
  bytebuf_push(buf = content, byte = 0)
  bytebuf_push_section(out = out, section_id = 0, content = content)
  bytebuf_to_bytes(out)
}

fn core_with_truncated_tag_mode(_ core: Bytes) -> Bytes {
  let out = bytebuf_new()
  let mut i = 0
  while i < Bytes::length(core) {
    bytebuf_push(buf = out, byte = Bytes::get(core, at = i))
    i = i + 1
  }
  // Custom section id + declared payload length, with the payload absent.
  bytebuf_push(buf = out, byte = 0)
  leb128_encode_u32(buf = out, value = 20)
  bytebuf_to_bytes(out)
}

fn hostfuture_compose_rejected(_ core: Bytes) -> Bool {
  handle {
    let _ = comp_emit_component_wasm_async_hostfuture(main_core_wasm = core, export_name = "run")
    false
  } with { Exception::Throw(_) => true }
}

fn hostfuture_compose_error(_ core: Bytes) -> String {
  handle {
    let _ = comp_emit_component_wasm_async_hostfuture(main_core_wasm = core, export_name = "run")
    ""
  } with { Exception::Throw(msg) => msg }
}

test "component async hoststream: adapter follows the core value ABI (#1930)" {
  let core = build_main_i64_core_hoststream_named(false)
  // Both published modes compose. Their runtime value parity is pinned by
  // test_named_hoststreams_component_gate.sh; this unit test keeps metadata
  // parsing and validation in the ordinary compiler test battery.
  let tagged = comp_emit_component_wasm_async_hostfuture(main_core_wasm = core_with_tag_mode(core = core, mode = 1), export_name = "run")
  let plain = comp_emit_component_wasm_async_hostfuture(main_core_wasm = core_with_tag_mode(core = core, mode = 0), export_name = "run")
  assert(Bytes::get(tagged, at = 4) == 13)
  assert(Bytes::get(plain, at = 4) == 13)
  assert(hostfuture_compose_rejected(core))
  assert(hostfuture_compose_rejected(core_with_short_tag_mode(core)))
  assert(hostfuture_compose_rejected(core_with_truncated_tag_mode(core)))
  assert(hostfuture_compose_rejected(core_with_tag_mode(core = core, mode = 2)))
  assert(hostfuture_compose_rejected(core_with_tag_mode(core = core_with_tag_mode(core = core, mode = 0), mode = 0)))
  assert(hostfuture_compose_rejected(core_with_tag_mode(core = core_with_tag_mode(core = core, mode = 0), mode = 1)))
}

/// The rejections above are asserted by OUTCOME, so a message that reads
/// `unsupported vibe.tagmode {mode}` -- the literal placeholder, because vibe
/// interpolation is `\{...}` and a bare `{...}` is just text -- passed them
/// while telling the reader nothing about which value was rejected. Only the
/// value-carrying message is pinned here; the rest are fixed strings that
/// their own outcome assertions already cover.
test "component #1930: the unsupported-tagmode diagnostic names the value" {
  let core = build_main_i64_core_hoststream_named(false)
  let msg = hostfuture_compose_error(core_with_tag_mode(core = core, mode = 2))
  assert(String::contains(msg, needle = "unsupported vibe.tagmode 2"))
  assert(!String::contains(msg, needle = "{mode}"))
}

test "component async hoststream: named host stream becomes a stream<u8> component import (#1218 D3)" {
  let core = build_main_i64_core_hoststream_named(false)
  assert(comp_core_imports_host_stream(core) == true)
  assert(comp_core_imports_host_future(core) == false)
  assert(comp_core_imports_host_stream(build_main_i64_core_p1()) == false)
  let names = comp_core_host_stream_names(core)
  assert(Array::length(names) == 1)
  assert(Array::get(names, at = 0) == "host_stream_get$body")
  let comp = comp_emit_component_wasm_async_hostfuture(main_core_wasm = core_with_tag_mode(core = core, mode = 1), export_name = "run")
  assert(Bytes::get(comp, at = 0) == 0)
  assert(Bytes::get(comp, at = 4) == 13)
  // component type (stream u8): 07 04 01 66 01 7d
  assert(bytes_contains_seq(hay = comp, needle = [7, 4, 1, 102, 1, 125]) == 1)
  // the stream canon set, spelled after the (only) name
  assert(component_bytes_contains(hay = comp, needle = "[async-lower]body") == 1)
  assert(component_bytes_contains(hay = comp, needle = "[async-lower][stream-read-0]body") == 1)
  assert(component_bytes_contains(hay = comp, needle = "[stream-drop-readable-0]body") == 1)
  assert(component_bytes_contains(hay = comp, needle = "[waitable-set-wait]") == 1)
  // the adapter exports the getter under the CORE import spelling plus the
  // shared read half
  assert(component_bytes_contains(hay = comp, needle = "host_stream_get$body") == 1)
  assert(component_bytes_contains(hay = comp, needle = "host_stream_read") == 1)
  // a stream-only program drags in NO future machinery and no anonymous
  // get-future
  assert(component_bytes_contains(hay = comp, needle = "get-future") == 0)
  assert(component_bytes_contains(hay = comp, needle = "future-read") == 0)
  assert(component_bytes_contains(hay = comp, needle = "host_future_wait") == 0)
  // reader-only shape: no write side anywhere
  assert(component_bytes_contains(hay = comp, needle = "stream-new") == 0)
  assert(component_bytes_contains(hay = comp, needle = "stream-write") == 0)
  assert(component_bytes_contains(hay = comp, needle = "stream-drop-writable") == 0)
}

// Mixed program: one named future + one named stream share the adapter,
// the waitable quartet, and the composition -- and keep their own canon
// families (future<u32> for `price`, stream<u8> for `body`).
test "component async hoststream: future + stream share one composition (#1218 D3)" {
  let core = build_main_i64_core_hoststream_named(true)
  assert(comp_core_imports_host_future(core) == true)
  assert(comp_core_imports_host_stream(core) == true)
  let comp = comp_emit_component_wasm_async_hostfuture(main_core_wasm = core_with_tag_mode(core = core, mode = 1), export_name = "run")
  assert(Bytes::get(comp, at = 0) == 0)
  assert(Bytes::get(comp, at = 4) == 13)
  // both value types: (future u32) 07 04 01 65 01 79 and (stream u8)
  // 07 04 01 66 01 7d
  assert(bytes_contains_seq(hay = comp, needle = [7, 4, 1, 101, 1, 121]) == 1)
  assert(bytes_contains_seq(hay = comp, needle = [7, 4, 1, 102, 1, 125]) == 1)
  assert(component_bytes_contains(hay = comp, needle = "[async-lower]price") == 1)
  assert(component_bytes_contains(hay = comp, needle = "[async-lower]body") == 1)
  assert(component_bytes_contains(hay = comp, needle = "[async-lower][future-read-0]price") == 1)
  assert(component_bytes_contains(hay = comp, needle = "[async-lower][stream-read-0]body") == 1)
  assert(component_bytes_contains(hay = comp, needle = "host_future_get$price") == 1)
  assert(component_bytes_contains(hay = comp, needle = "host_future_wait") == 1)
  assert(component_bytes_contains(hay = comp, needle = "host_stream_get$body") == 1)
  assert(component_bytes_contains(hay = comp, needle = "host_stream_read") == 1)
}

test "component async hostfuture: rejects a core without a run export" {
  let rejected = handle {
    let _ = comp_emit_component_wasm_async_hostfuture(main_core_wasm = core_with_tag_mode(core = build_main_i64_core_hostfuture(with_run = false, extra_import = false), mode = 1), export_name = "run")
    false
  } with { Exception::Throw(_) => true }
  assert(rejected)
}

test "component async hostfuture: rejects a core with an unsatisfiable host import" {
  let rejected = handle {
    let _ = comp_emit_component_wasm_async_hostfuture(main_core_wasm = core_with_tag_mode(core = build_main_i64_core_hostfuture(with_run = true, extra_import = true), mode = 1), export_name = "run")
    false
  } with { Exception::Throw(_) => true }
  assert(rejected)
}

// The future payload valtype and the task.return result valtype are the
// same hard-coded u32 in the guest module; any other request must throw,
// same rationale as the other fixed-shape emitters.
test "component future-value: rejects a non-u32 result valtype" {
  let rejected = handle {
    let _ = comp_emit_component_wasm_future_value(export_name = "run", comp_result_valtype = 120)
    false
  } with { Exception::Throw(_) => true }
  assert(rejected)
}

// ADR-0089 step 2 (#1218): the stream-value component -- same rendezvous
// composition as future-value with the stream.* canon family (opcodes one
// block apart) and a u8 element type. Byte shapes recovered via
// `wasm-tools dump` against tools/wasip3_component_probe/stream_value/
// component.wat; runtime proof lives in
// scripts/test_stream_value_component_gate.sh.
test "component stream-value: stream.* canon set with a u8 element type" {
  let comp = comp_emit_component_wasm_stream_value(export_name = "run", comp_result_valtype = 121)
  assert(Bytes::get(comp, at = 0) == 0)
  assert(Bytes::get(comp, at = 4) == 13)
  // component type (stream u8): 07 04 01 66 01 7d
  assert(bytes_contains_seq(hay = comp, needle = [7, 4, 1, 102, 1, 125]) == 1)
  // canon stream.new ty=0: 08 03 01 0e 00
  assert(bytes_contains_seq(hay = comp, needle = [8, 3, 1, 14, 0]) == 1)
  // canon stream.read ty=0 async (memory 0): 08 07 01 0f 00 02 06 03 00
  assert(bytes_contains_seq(hay = comp, needle = [8, 7, 1, 15, 0, 2, 6, 3, 0]) == 1)
  // canon stream.write ty=0 async (memory 0): 08 07 01 10 00 02 06 03 00
  assert(bytes_contains_seq(hay = comp, needle = [8, 7, 1, 16, 0, 2, 6, 3, 0]) == 1)
  // canon stream.drop-readable ty=0: 08 03 01 13 00
  assert(bytes_contains_seq(hay = comp, needle = [8, 3, 1, 19, 0]) == 1)
  // canon stream.drop-writable ty=0: 08 03 01 14 00
  assert(bytes_contains_seq(hay = comp, needle = [8, 3, 1, 20, 0]) == 1)
  // task.return stays u32 (the element type is u8, the RESULT is not)
  assert(bytes_contains_seq(hay = comp, needle = [8, 5, 1, 9, 0, 121, 0]) == 1)
  assert(component_bytes_contains(hay = comp, needle = "[stream-new-0]pipe") == 1)
  assert(component_bytes_contains(hay = comp, needle = "[async-lower][stream-read-0]pipe") == 1)
  assert(component_bytes_contains(hay = comp, needle = "[async-lower][stream-write-0]pipe") == 1)
  assert(component_bytes_contains(hay = comp, needle = "[stream-drop-readable-0]pipe") == 1)
  assert(component_bytes_contains(hay = comp, needle = "[stream-drop-writable-0]pipe") == 1)
  assert(component_bytes_contains(hay = comp, needle = "[waitable-set-new]") == 1)
  assert(component_bytes_contains(hay = comp, needle = "[waitable-set-wait]") == 1)
  assert(component_bytes_contains(hay = comp, needle = "[task-return]run") == 1)
  // Self-contained, and streams only: no host import, no subtask, no
  // future.* canon anywhere.
  assert(component_bytes_contains(hay = comp, needle = "get-async") == 0)
  assert(component_bytes_contains(hay = comp, needle = "[subtask-drop]") == 0)
  assert(component_bytes_contains(hay = comp, needle = "[future") == 0)
}

// Same u32-result guard as every fixed-shape async emitter.
test "component stream-value: rejects a non-u32 result valtype" {
  let rejected = handle {
    let _ = comp_emit_component_wasm_stream_value(export_name = "run", comp_result_valtype = 120)
    false
  } with { Exception::Throw(_) => true }
  assert(rejected)
}
