  let import_content = bytebuf_new()
  bytebuf_push_vec_header(import_content, 2)
  emit_name(import_content, "vibe")
  emit_name(import_content, "env-get")
  bytebuf_push(import_content, 0)
  leb128_encode_u32(import_content, 1)
  emit_name(import_content, "vibe")
  emit_name(import_content, "fs_read_file")
  bytebuf_push(import_content, 0)
  leb128_encode_u32(import_content, 1)
  bytebuf_push_section(out, 2, import_content)
  emit_function_section(out, [
    0
  ])
  emit_memory_section(out, 1)
  let global_content = bytebuf_new()
  leb128_encode_u32(global_content, 1)
  bytebuf_push(global_content, 127)
  bytebuf_push(global_content, 1)
  bytebuf_push(global_content, 65)
  bytebuf_push(global_content, 8)
  bytebuf_push(global_content, 11)
  bytebuf_push_section(out, 6, global_content)
  let export_content = bytebuf_new()
  bytebuf_push_vec_header(export_content, 3)
  emit_name(export_content, "handler")
  bytebuf_push(export_content, 0)
  leb128_encode_u32(export_content, 2)
  emit_name(export_content, "memory")
  bytebuf_push(export_content, 2)
  leb128_encode_u32(export_content, 0)
  emit_name(export_content, "__heap_ptr")
  bytebuf_push(export_content, 3)
  leb128_encode_u32(export_content, 0)
  bytebuf_push_section(out, 7, export_content)
  let h_body = bytebuf_new()
  emit_local_get(h_body, 0)
  emit_code_section(out, [
    h_body
  ])
  bytebuf_to_bytes(out)
}

/// #1540 scope 4: the serve component for a `body: HostStream` handler --
/// the shape `vibe serve` now emits when the handler's last parameter is a
/// stream, and the join of every earlier slice in the issue.
///
/// What is asserted is the WIRING, because that is what silently misbehaves.
/// The stream canons live in a memhost page while `task.return` and the lift
/// keep the MAIN memory (a canon writing fixed addresses into the vibe heap
/// would corrupt whatever the program had there), and the adapter that turns
/// `vibe.host_stream_read` into those canons is a fourth core module the main
/// instance is given. An emitter that dropped the adapter would still produce
/// a component that VALIDATES -- `wac plug` promotes the unsatisfied edge to a
/// root import (#1796) -- and only fail when a request arrives.
test "component #1540: the stream serve lane wires main to the stream canons" {
  let core = core_with_tag_mode(build_test_core_stream_handler(), 0)
  let comp = comp_emit_component_wasm_stream_handler(core, "handler", "handler", [
    "method",
    "url",
    "headers",
    "body"
  ])
  assert(Bytes::get(comp, 0) == 0)
  assert(Bytes::get(comp, 4) == 13)
  // the adapter satisfies the guest's read half under its own name
  assert(component_bytes_contains(comp, "host_stream_read") == 1)
  // and it does so through the real canons, not a stub
  assert(component_bytes_contains(comp, "[async-lower][stream-read-0]body") == 1)
  assert(component_bytes_contains(comp, "[stream-drop-readable-0]body") == 1)
  assert(component_bytes_contains(comp, "[waitable-set-wait]") == 1)
  // the result still leaves through task.return: the lift is async, so the
  // core function has no return path to carry it
  assert(component_bytes_contains(comp, "[task-return]handler") == 1)
}

/// The arity guard, and the thing it CANNOT do.
///
/// A stream handler's core function takes 3 strings + the handle + the closure
/// env; a String handler's takes 4 strings + the closure env. Both are five
/// i64. Measured, not assumed -- the `build_test_core_packed_handler_with_vibe_imports`
/// core passes the stream lane's check unchanged. So the core carries NO
/// evidence of which lane it belongs to, and the guard can only catch a core
/// of the wrong SIZE.
///
/// That is why the lane is chosen from the handler's source signature
/// (`serve_handler_takes_body_stream`) and never sniffed from the compiled
/// core: there is nothing there to sniff.
test "component #1540: the stream lane's guard catches a wrong-arity core" {
  let core = core_with_tag_mode(build_test_core(), 0)
  let rejected = handle {
    let _ = comp_emit_component_wasm_stream_handler(core, "run", "handler", [
      "method",
      "url",
      "headers",
      "body"
    ])
    false
  } with Exception {
    Throw(_) => true
  }
  assert(rejected)
  // and the arity a String handler's core has is INDISTINGUISHABLE from the
  // stream one's -- both five i64 -- so this guard accepts it. Pinning that
  // here keeps the fact from being rediscovered as a silent mis-lane.
  let string_core = core_with_tag_mode(build_test_core_packed_handler_with_vibe_imports(), 0)
  let accepted = handle {
    let _ = comp_emit_component_wasm_stream_handler(string_core, "handler", "handler", [
      "method",
      "url",
      "headers",
      "body"
    ])
    true
  } with Exception {
    Throw(_) => false
  }
  assert(accepted)
}

test "component #1930: the serve stream lane requires explicit plain-i64 metadata" {
  let core = build_test_core_stream_handler()
  let missing_rejected = handle {
    let _ = comp_emit_component_wasm_stream_handler(core, "handler", "handler", [
      "method",
      "url",
      "headers",
      "body"
    ])
    false
  } with Exception {
    Throw(_) => true
  }
  assert(missing_rejected)
  let tagged_rejected = handle {
    let _ = comp_emit_component_wasm_stream_handler(core_with_tag_mode(core, 1), "handler", "handler", [
      "method",
      "url",
      "headers",
      "body"
    ])
    false
  } with Exception {
    Throw(_) => true
  }
  assert(tagged_rejected)
  let plain_accepted = handle {
    let _ = comp_emit_component_wasm_stream_handler(core_with_tag_mode(core, 0), "handler", "handler", [
      "method",
      "url",
      "headers",
      "body"
    ])
    true
  } with Exception {
    Throw(_) => false
  }
  assert(plain_accepted)
}

test "component #1107: strict string handler rejects vibe.* imports" {
  let core = build_test_core_packed_handler_with_vibe_imports()
  let rejected = handle {
    let _ = comp_emit_component_wasm_string_handler(core, "handler", "handler", [
      "method",
      "url",
      "headers",
      "body"
    ])
    false
  } with Exception {
    Throw(_) => true
  }
  assert(rejected)
}

test "component #1107: stubbed string handler hosts vibe.* imports" {
  let core = build_test_core_packed_handler_with_vibe_imports()
  let comp = comp_emit_component_wasm_string_handler_stubbed(core, "handler", "handler", [
    "method",
    "url",
    "headers",
    "body"
  ])
  assert(Bytes::get(comp, 0) == 0)
  assert(Bytes::get(comp, 4) == 13)
  // the stub module must export a same-name stub for every vibe.* import
  // (plus the usual fd_write), and the component must still lift the handler.
  assert(component_bytes_contains(comp, "env-get") == 1)
  assert(component_bytes_contains(comp, "fs_read_file") == 1)
  assert(component_bytes_contains(comp, "fd_write") == 1)
  assert(component_bytes_contains(comp, "handler") == 1)
}

// #1230 M1b-3c-1b: blocking await with the wait loop in its own function.
// The byte shapes asserted below were recovered empirically via
// `wasm-tools dump` against tools/wasip3_component_probe/spawned_future/
// component.wat's compiled output (see that probe's README.md and
// canon-imports-exports.wit-abi.txt), not hand-derived from the spec --
// this test pins the SAME shapes this composer's doc comments describe.
// A stronger, execution-based check (this exact composer's output run
// through the probe's Rust host driver against a genuinely-blocking host
// import, confirming a real ~300ms suspend and a correct result of 42)
// lives in scripts/test_spawned_future_component_gate.sh; `vibe test`
// itself has no Fs/subprocess access to drive that host binary.
//
// Note this emitter models "spawn" only in the degenerate case (nothing
// observable between spawn and join) -- see the composer's doc comment.
test "component async spawned-future: blocking await via a callee wait loop, no future.* canon" {
  let comp = comp_emit_component_wasm_async_spawned_future("run", 121)
  assert(Bytes::get(comp, 0) == 0)
  assert(Bytes::get(comp, 4) == 13)
  // task.return canon (u32=121): 08 05 01 09 00 79 00
  assert(bytes_contains_seq(comp, [
    8,
    5,
    1,
    9,
    0,
    121,
    0
  ]) == 1)
  // async functype () -> u32: 07 05 01 43 00 00 79
  assert(bytes_contains_seq(comp, [
    7,
    5,
    1,
    67,
    0,
    0,
    121
  ]) == 1)
  // canon lower(get-async) async (memory 0): 08 08 01 01 00 00 02 06 03 00
  assert(bytes_contains_seq(comp, [
    8,
    8,
    1,
    1,
    0,
    0,
    2,
    6,
    3,
    0
  ]) == 1)
  // canon waitable-set.new: 08 02 01 1f
  assert(bytes_contains_seq(comp, [
    8,
    2,
    1,
    31
  ]) == 1)
  // canon waitable.join: 08 02 01 23
  assert(bytes_contains_seq(comp, [
    8,
    2,
    1,
    35
  ]) == 1)
  // canon waitable-set.wait (memory 0): 08 04 01 20 00 00
  assert(bytes_contains_seq(comp, [
    8,
    4,
    1,
    32,
    0,
    0
  ]) == 1)
  // canon waitable-set.drop: 08 02 01 22
  assert(bytes_contains_seq(comp, [
    8,
    2,
    1,
    34
  ]) == 1)
  // canon subtask.drop: 08 02 01 0d
  assert(bytes_contains_seq(comp, [
    8,
    2,
    1,
    13
  ]) == 1)
  assert(component_bytes_contains(comp, "get-async") == 1)
  assert(component_bytes_contains(comp, "[async-lower]get-async") == 1)
  assert(component_bytes_contains(comp, "[waitable-set-new]") == 1)
  assert(component_bytes_contains(comp, "[waitable-join]") == 1)
  assert(component_bytes_contains(comp, "[waitable-set-wait]") == 1)
  assert(component_bytes_contains(comp, "[waitable-set-drop]") == 1)
  assert(component_bytes_contains(comp, "[subtask-drop]") == 1)
  assert(component_bytes_contains(comp, "[task-return]run") == 1)
  // No future.* canon anywhere: the emitted shape needs no canonical-ABI
  // future value (see composer's doc comment). "future" would only ever
  // appear inside a "[async-lower]"/"[async-lift]" wire name here, never
  // as its own bracketed canon name.
  assert(component_bytes_contains(comp, "[future") == 0)
  assert(component_bytes_contains(comp, "context-get") == 0)
  assert(component_bytes_contains(comp, "context-set") == 0)
  assert(component_bytes_contains(comp, "waitable-set-poll") == 0)
}

// #1240 review: the guest core module is hard-coded to an i32-shaped result,
// so any other requested lowering (notably the project's ordinary s64 `Int`)
// would emit a task.return canon disagreeing with the guest's own
// [task-return] import type and fail component validation. The emitter must
// reject it up front rather than produce an invalid component.
test "component async spawned-future: rejects a non-u32 result valtype" {
  let rejected = handle {
    let _ = comp_emit_component_wasm_async_spawned_future("run", 120)
    false
  } with Exception {
    Throw(_) => true
  }
  assert(rejected)
}

// #1230 M1b-3c-3: the concurrent-awaits component -- two host operations
// genuinely in flight at once. It shares the composer (and therefore every
// canon section, import and export) with the spawned-future component; the
// entire difference is inside the guest core module, where both
// async-lowered calls are issued BEFORE either is waited on.
//
// So the interesting properties to pin here are (a) the shared composer
// still wires the same canon set through the new entry point, and (b) the
// two emitters do NOT produce identical bytes -- if the guest-module
// argument were ever mixed up, every canon assertion below would still
// pass while the component silently reverted to the serial shape. The
// runtime proof (84 in ~300ms rather than ~600ms for two 300ms host calls)
// lives in scripts/test_concurrent_awaits_component_gate.sh; `vibe test`
// cannot drive a component.
test "component async concurrent-awaits: same canon set as spawned-future, different guest" {
  let comp = comp_emit_component_wasm_async_concurrent_awaits("run", 121)
  assert(Bytes::get(comp, 0) == 0)
  assert(Bytes::get(comp, 4) == 13)
  // task.return canon (u32=121)
  assert(bytes_contains_seq(comp, [
    8,
    5,
    1,
    9,
    0,
    121,
    0
  ]) == 1)
  // canon lower(get-async) async (memory 0)
  assert(bytes_contains_seq(comp, [
    8,
    8,
    1,
    1,
    0,
    0,
    2,
    6,
    3,
    0
  ]) == 1)
  assert(component_bytes_contains(comp, "get-async") == 1)
  assert(component_bytes_contains(comp, "[async-lower]get-async") == 1)
  assert(component_bytes_contains(comp, "[waitable-set-new]") == 1)
  assert(component_bytes_contains(comp, "[waitable-join]") == 1)
  assert(component_bytes_contains(comp, "[waitable-set-wait]") == 1)
  assert(component_bytes_contains(comp, "[waitable-set-drop]") == 1)
  assert(component_bytes_contains(comp, "[subtask-drop]") == 1)
  assert(component_bytes_contains(comp, "[task-return]run") == 1)
  // Still no future.*/context.*/poll -- concurrency needs none of them.
  assert(component_bytes_contains(comp, "[future") == 0)
  assert(component_bytes_contains(comp, "context-get") == 0)
  assert(component_bytes_contains(comp, "context-set") == 0)
  assert(component_bytes_contains(comp, "waitable-set-poll") == 0)
  // ...but it is NOT the spawned-future component.
  let serial = comp_emit_component_wasm_async_spawned_future("run", 121)
  assert(Bytes::length(comp) != Bytes::length(serial))
}

// Same u32-only guard as the spawned-future emitter: both share the
// composer, so the rejection must fire through the new entry point too.
test "component async concurrent-awaits: rejects a non-u32 result valtype" {
  let rejected = handle {
    let _ = comp_emit_component_wasm_async_concurrent_awaits("run", 120)
    false
  } with Exception {
    Throw(_) => true
  }
  assert(rejected)
}

// ADR-0089 step 2 (#1218): the future-value component -- the first emitted
// shape that uses the literal `future.*` canonical built-ins. Byte shapes
// below were recovered via `wasm-tools dump` against
// tools/wasip3_component_probe/future_value/component.wat's compiled
// output (which returns 42 on wasmtime 47 with
// -W component-model-more-async-builtins=y), not hand-derived from the
// spec. Runtime proof (BLOCKED read -> eager write -> FUTURE_READ event ->
// 42) lives in scripts/test_future_value_component_gate.sh; `vibe test`
// cannot drive a component.
test "component future-value: future.* canon set, no host import, no subtask" {
  let comp = comp_emit_component_wasm_future_value("run", 121)
  assert(Bytes::get(comp, 0) == 0)
  assert(Bytes::get(comp, 4) == 13)
  // component type (future u32): 07 04 01 65 01 79
  assert(bytes_contains_seq(comp, [
    7,
    4,
    1,
    101,
    1,
    121
  ]) == 1)
  // canon future.new ty=0: 08 03 01 15 00
  assert(bytes_contains_seq(comp, [
    8,
    3,
    1,
    21,
    0
  ]) == 1)
  // canon future.read ty=0 async (memory 0): 08 07 01 16 00 02 06 03 00
  assert(bytes_contains_seq(comp, [
    8,
    7,
    1,
    22,
    0,
    2,
    6,
    3,
    0
  ]) == 1)
  // canon future.write ty=0 async (memory 0): 08 07 01 17 00 02 06 03 00
  assert(bytes_contains_seq(comp, [
    8,
    7,
    1,
    23,
    0,
    2,
    6,
    3,
    0
  ]) == 1)
  // canon future.drop-readable ty=0: 08 03 01 1a 00
  assert(bytes_contains_seq(comp, [
    8,
    3,
    1,
    26,
    0
  ]) == 1)
  // canon future.drop-writable ty=0: 08 03 01 1b 00
  assert(bytes_contains_seq(comp, [
    8,
    3,
    1,
    27,
    0
  ]) == 1)
  // task.return canon (u32=121) and the waitable-set machinery ride along
  assert(bytes_contains_seq(comp, [
    8,
    5,
    1,
    9,
    0,
    121,
    0
  ]) == 1)
  assert(component_bytes_contains(comp, "[future-new-0]make") == 1)
  assert(component_bytes_contains(comp, "[async-lower][future-read-0]make") == 1)
  assert(component_bytes_contains(comp, "[async-lower][future-write-0]make") == 1)
  assert(component_bytes_contains(comp, "[future-drop-readable-0]make") == 1)
  assert(component_bytes_contains(comp, "[future-drop-writable-0]make") == 1)
  assert(component_bytes_contains(comp, "[waitable-set-new]") == 1)
  assert(component_bytes_contains(comp, "[waitable-join]") == 1)
  assert(component_bytes_contains(comp, "[waitable-set-wait]") == 1)
  assert(component_bytes_contains(comp, "[waitable-set-drop]") == 1)
  assert(component_bytes_contains(comp, "[task-return]run") == 1)
  // Self-contained: no host async import, hence no canon lower and no
  // subtask anywhere in the shape.
  assert(component_bytes_contains(comp, "get-async") == 0)
  assert(component_bytes_contains(comp, "[subtask-drop]") == 0)
  assert(component_bytes_contains(comp, "context-get") == 0)
  assert(component_bytes_contains(comp, "waitable-set-poll") == 0)
}

// ADR-0089 Decision 2 / step 4 (#1218): the HOST-future-value component --
// imports `get-future` and parks the read on waitable-set.wait until the
// host's producer resolves. Byte shapes recovered via `wasm-tools dump`
// against tools/wasip3_component_probe/host_future_value/component.wat's
// compiled output (42 in ~300ms under runtime/viberun's FutureReader
// import -- the wall clock proving a genuine suspend). Runtime proof lives
// in scripts/test_host_future_value_component_gate.sh.
test "component host-future-value: get-future import + waitable park, no write end" {
  let comp = comp_emit_component_wasm_host_future_value("run", 121)
  assert(Bytes::get(comp, 0) == 0)
  assert(Bytes::get(comp, 4) == 13)
  // component type (future u32): 07 04 01 65 01 79
  assert(bytes_contains_seq(comp, [
    7,
    4,
    1,
    101,
    1,
    121
  ]) == 1)
  // import functype `async () -> (type 0)`: 07 05 01 43 00 00 00
  assert(bytes_contains_seq(comp, [
    7,
    5,
    1,
    67,
    0,
    0,
    0
  ]) == 1)
  // component import of get-future with functype index 1:
  // 0a 0f 01 00 0a "get-future" 01 01
  assert(bytes_contains_seq(comp, [
    10,
    15,
    1,
    0,
    10
  ]) == 1)
  assert(component_bytes_contains(comp, "get-future") == 1)
  // canon lower async (memory 0) of the import: 08 08 01 01 00 00 02 06 03 00
  assert(bytes_contains_seq(comp, [
    8,
    8,
    1,
    1,
    0,
    0,
    2,
    6,
    3,
    0
  ]) == 1)
  // canon future.read ty=0 async (memory 0): 08 07 01 16 00 02 06 03 00
  assert(bytes_contains_seq(comp, [
    8,
    7,
    1,
    22,
    0,
    2,
    6,
    3,
    0
  ]) == 1)
  // canon future.drop-readable ty=0: 08 03 01 1a 00
  assert(bytes_contains_seq(comp, [
    8,
    3,
    1,
    26,
    0
  ]) == 1)
  assert(component_bytes_contains(comp, "[async-lower]get-future") == 1)
  assert(component_bytes_contains(comp, "[async-lower][future-read-0]get-future") == 1)
  assert(component_bytes_contains(comp, "[future-drop-readable-0]get-future") == 1)
  assert(component_bytes_contains(comp, "[waitable-set-new]") == 1)
  assert(component_bytes_contains(comp, "[waitable-join]") == 1)
  assert(component_bytes_contains(comp, "[waitable-set-wait]") == 1)
  assert(component_bytes_contains(comp, "[waitable-set-drop]") == 1)
  assert(component_bytes_contains(comp, "[task-return]run") == 1)
  // The host owns the write end: no future.new, no write, no
  // drop-writable anywhere in the shape -- and no subtask machinery
  // (the get-future call itself must complete eagerly).
  assert(component_bytes_contains(comp, "future-new") == 0)
  assert(component_bytes_contains(comp, "future-write") == 0)
  assert(component_bytes_contains(comp, "future-drop-writable") == 0)
  assert(component_bytes_contains(comp, "[subtask-drop]") == 0)
}

test "component host-future-value: rejects a non-u32 result valtype" {
  let rejected = handle {
    let _ = comp_emit_component_wasm_host_future_value("run", 120)
    false
  } with Exception {
    Throw(_) => true
  }
  assert(rejected)
}

// ADR-0089 step 4 (#1218): a stand-in for a REAL compiled core whose
// program calls `host_future_get` -- exports `run : (i64) -> i64` and
// imports fd_write + the vibe host-future pair, exactly the import set
// linked_compile emits for such a program. `with_run` false drops the run
// export (the composer must reject); `extra_import` adds a vibe.sh import
// (outside the composition's allowlist, must also reject).
fn build_main_i64_core_hostfuture(with_run: Bool, extra_import: Bool) -> Bytes {
  let out = bytebuf_new()
  emit_header(out)
  let tc = bytebuf_new()
  bytebuf_push_vec_header(tc, 3)
  emit_func_type_raw(tc, [
    127,
    127,
    127,
    127
  ], [
    127
  ])
  emit_func_type_raw(tc, [
    126
  ], [
    126
  ])
  emit_func_type_raw(tc, array_empty(), [
    126
  ])
  bytebuf_push_section(out, 1, tc)
  let ic = bytebuf_new()
  bytebuf_push_vec_header(ic, if extra_import {
    4
  } else {
    3
  })
  emit_name(ic, "wasi_snapshot_preview1")
  emit_name(ic, "fd_write")
  bytebuf_push(ic, 0)
  bytebuf_push(ic, 0)
  emit_name(ic, "vibe")
  emit_name(ic, "host_future_get")
  bytebuf_push(ic, 0)
  bytebuf_push(ic, 2)
  emit_name(ic, "vibe")
  emit_name(ic, "host_future_wait")
  bytebuf_push(ic, 0)
  bytebuf_push(ic, 1)
  if extra_import {
    emit_name(ic, "vibe")
    emit_name(ic, "sh")
    bytebuf_push(ic, 0)
    bytebuf_push(ic, 1)
  } else {
    ()
  }
  bytebuf_push_section(out, 2, ic)
  emit_function_section(out, [
    1
  ])
  let local_func_idx = if extra_import {
    4
  } else {
    3
  }
  if with_run {
    emit_export_section(out, "run", local_func_idx)
  } else {
    emit_export_section(out, "main", local_func_idx)
  }
  let body = bytebuf_new()
  emit_i64_const(body, 42)
  emit_code_section(out, [
    body
  ])
  bytebuf_to_bytes(out)
}

// The step-4 composition: a host-future-importing core is wrapped with the
// adapter module (canon built-ins over the memhost memory), the fd_write
// stub, and the u32 trampoline, importing `get-future` from the host.
// Runtime proof (42 in ~wall >= 0.8 x delay through a real compiled
// program) lives in scripts/test_hostfuture_source_component_gate.sh.
test "component async hostfuture: adapter-backed composition of a real-shaped core" {
  let core = build_main_i64_core_hostfuture(true, false)
  assert(comp_core_imports_host_future(core) == true)
  // The p1 test core (fd_write only) must NOT sniff as host-future.
  assert(comp_core_imports_host_future(build_main_i64_core_p1()) == false)
  let comp = comp_emit_component_wasm_async_hostfuture(core_with_tag_mode(core, 1), "run")
  assert(Bytes::get(comp, 0) == 0)
  assert(Bytes::get(comp, 4) == 13)
  // component type (future u32): 07 04 01 65 01 79
  assert(bytes_contains_seq(comp, [
    7,
    4,
    1,
    101,
    1,
    121
  ]) == 1)
  // import functype `async () -> (type 0)`: 07 05 01 43 00 00 00
  assert(bytes_contains_seq(comp, [
    7,
    5,
    1,
    67,
    0,
    0,
    0
  ]) == 1)
  assert(component_bytes_contains(comp, "get-future") == 1)
  // canon lower async (memory 0) of the import: 08 08 01 01 00 00 02 06 03 00
  assert(bytes_contains_seq(comp, [
    8,
    8,
    1,
    1,
    0,
    0,
    2,
    6,
    3,
    0
  ]) == 1)
  // the adapter's canon set + the pair it exports to the main module
  assert(component_bytes_contains(comp, "[async-lower]get-future") == 1)
  assert(component_bytes_contains(comp, "[async-lower][future-read-0]get-future") == 1)
  assert(component_bytes_contains(comp, "[future-drop-readable-0]get-future") == 1)
  assert(component_bytes_contains(comp, "[waitable-set-new]") == 1)
  assert(component_bytes_contains(comp, "[waitable-join]") == 1)
  assert(component_bytes_contains(comp, "[waitable-set-wait]") == 1)
  assert(component_bytes_contains(comp, "[waitable-set-drop]") == 1)
  assert(component_bytes_contains(comp, "host_future_get") == 1)
  assert(component_bytes_contains(comp, "host_future_wait") == 1)
  // u32-lifted run through the trampoline's task-return
  assert(component_bytes_contains(comp, "task-return") == 1)
  // The host owns the write end; the import call must complete eagerly --
  // no write-side or subtask machinery anywhere in the shape.
  assert(component_bytes_contains(comp, "future-new") == 0)
  assert(component_bytes_contains(comp, "future-write") == 0)
  assert(component_bytes_contains(comp, "future-drop-writable") == 0)
  assert(component_bytes_contains(comp, "[subtask-drop]") == 0)
}

// ADR-0089 (c) (#1218): a stand-in for a compiled core whose program calls
// `host_future_named("price")` and `host_future_named("qty")` and nothing
// anonymous -- so the import set is fd_write + the shared wait half + one
// `vibe.host_future_get$<name>` per name, in linked_compile's sorted order.
fn build_main_i64_core_hostfuture_named() -> Bytes {
  let out = bytebuf_new()
  emit_header(out)
  let tc = bytebuf_new()
  bytebuf_push_vec_header(tc, 3)
  emit_func_type_raw(tc, [
    127,
    127,
    127,
    127
  ], [
    127
  ])
  emit_func_type_raw(tc, [
    126
  ], [
    126
  ])
  emit_func_type_raw(tc, array_empty(), [
    126
  ])
  bytebuf_push_section(out, 1, tc)
  let ic = bytebuf_new()
  bytebuf_push_vec_header(ic, 4)
  emit_name(ic, "wasi_snapshot_preview1")
  emit_name(ic, "fd_write")
  bytebuf_push(ic, 0)
  bytebuf_push(ic, 0)
  emit_name(ic, "vibe")
  emit_name(ic, "host_future_wait")
  bytebuf_push(ic, 0)
  bytebuf_push(ic, 1)
  emit_name(ic, "vibe")
  emit_name(ic, "host_future_get$price")
  bytebuf_push(ic, 0)
  bytebuf_push(ic, 2)
  emit_name(ic, "vibe")
  emit_name(ic, "host_future_get$qty")
  bytebuf_push(ic, 0)
  bytebuf_push(ic, 2)
  bytebuf_push_section(out, 2, ic)
  emit_function_section(out, [
    1
  ])
  emit_export_section(out, "run", 4)
  let body = bytebuf_new()
  emit_i64_const(body, 42)
  emit_code_section(out, [
    body
  ])
  bytebuf_to_bytes(out)
}

// ADR-0089 (c) (#1218): two NAMED host futures compose into two component
// imports and two adapter getters, sharing one wait half and one pair of
// future.read / future.drop-readable canon defs (every host future here is
// the same `future<u32>` type). Runtime proof -- both in flight at once,
// total wall = max(delay) not sum(delay) -- lives in
// scripts/test_named_hostfutures_component_gate.sh.
test "component async hostfuture: two named host futures become two component imports (#1218 (c))" {
  let core = build_main_i64_core_hostfuture_named()
  assert(comp_core_imports_host_future(core) == true)
  let names = comp_core_host_future_names(core)
  assert(Array::length(names) == 2)
  assert(Array::get(names, 0) == "host_future_get$price")
  assert(Array::get(names, 1) == "host_future_get$qty")
  let comp = comp_emit_component_wasm_async_hostfuture(core_with_tag_mode(core, 1), "run")
  assert(Bytes::get(comp, 0) == 0)
  assert(Bytes::get(comp, 4) == 13)
  // No anonymous `get-future`: this program never asked for one, and an
  // unused import is still an import the host must satisfy.
  assert(component_bytes_contains(comp, "get-future") == 0)
  // one lowered import per name...
  assert(component_bytes_contains(comp, "[async-lower]price") == 1)
  assert(component_bytes_contains(comp, "[async-lower]qty") == 1)
  // ...but ONE shared read/drop pair, spelled after the first name
  assert(component_bytes_contains(comp, "[async-lower][future-read-0]price") == 1)
  assert(component_bytes_contains(comp, "[future-drop-readable-0]price") == 1)
  assert(component_bytes_contains(comp, "[async-lower][future-read-0]qty") == 0)
  assert(component_bytes_contains(comp, "[future-drop-readable-0]qty") == 0)
  // the adapter exports one getter per name under the CORE import spelling
  // the guest calls, plus the single shared wait
  assert(component_bytes_contains(comp, "host_future_get$price") == 1)
  assert(component_bytes_contains(comp, "host_future_get$qty") == 1)
  assert(component_bytes_contains(comp, "host_future_wait") == 1)
  assert(component_bytes_contains(comp, "[waitable-set-wait]") == 1)
  // still the host-owned-writer shape: no write side anywhere
  assert(component_bytes_contains(comp, "future-new") == 0)
  assert(component_bytes_contains(comp, "future-write") == 0)
  assert(component_bytes_contains(comp, "future-drop-writable") == 0)
}

// The anonymous surface still sniffs as exactly one name, so the step-4
// composition is unchanged by the generalization.
test "component async hostfuture: the anonymous host future is a one-name list (#1218 (c))" {
  let names = comp_core_host_future_names(build_main_i64_core_hostfuture(true, false))
  assert(Array::length(names) == 1)
  assert(Array::get(names, 0) == "host_future_get")
  assert(Array::length(comp_core_host_future_names(build_main_i64_core_p1())) == 0)
}

fn build_main_i64_core_stdin_provider(module_name: String, include_acquire: Bool, duplicate_acquire: Bool, malformed_acquire: Bool, include_read: Bool, include_close: Bool, include_named_stream: Bool) -> Bytes {
  let out = bytebuf_new()
  emit_header(out)
  // 0 fd_write; 1 ()->i64; 2 (i64)->i64; 3 (i64)->i64 malformed
  // acquire; 4 (i64)->i64 run.
  let tc = bytebuf_new()
  bytebuf_push_vec_header(tc, 5)
  emit_func_type_raw(tc, [
    127,
    127,
    127,
    127
  ], [
    127
  ])
  emit_func_type_raw(tc, array_empty(), [
    126
  ])
  emit_func_type_raw(tc, [
    126
  ], [
    126
  ])
  emit_func_type_raw(tc, [
    126
  ], [
    126
  ])
  emit_func_type_raw(tc, [
    126
  ], [
    126
  ])
  bytebuf_push_section(out, 1, tc)
  let import_count = 1 + if include_acquire {
    1
  } else {
    0
  } + if duplicate_acquire {
    1
  } else {
    0
  } + if include_read {
    1
  } else {
    0
  } + if include_close {
    1
  } else {
    0
  } + if include_named_stream {
    1
  } else {
    0
  }
  let ic = bytebuf_new()
  bytebuf_push_vec_header(ic, import_count)
  emit_name(ic, "wasi_snapshot_preview1")
  emit_name(ic, "fd_write")
  bytebuf_push(ic, 0)
  bytebuf_push(ic, 0)
  if include_acquire {
    emit_name(ic, module_name)
    emit_name(ic, "stdin_provider_acquire")
    bytebuf_push(ic, 0)
    bytebuf_push(ic, if malformed_acquire {
      3
    } else {
      1
    })
  } else {
    ()
  }
  if duplicate_acquire {
    emit_name(ic, module_name)
    emit_name(ic, "stdin_provider_acquire")
    bytebuf_push(ic, 0)
    bytebuf_push(ic, 1)
  } else {
    ()
  }
  if include_read {
    emit_name(ic, module_name)
    emit_name(ic, "stdin_provider_read")
    bytebuf_push(ic, 0)
    bytebuf_push(ic, 2)
  } else {
    ()
  }
  if include_close {
    emit_name(ic, module_name)
    emit_name(ic, "stdin_provider_close")
    bytebuf_push(ic, 0)
    bytebuf_push(ic, 2)
  } else {
    ()
  }
  if include_named_stream {
    emit_name(ic, "vibe")
    emit_name(ic, "host_stream_get$body")
    bytebuf_push(ic, 0)
    bytebuf_push(ic, 1)
  } else {
    ()
  }
  bytebuf_push_section(out, 2, ic)
  emit_function_section(out, [
    4
  ])
  emit_export_section(out, "run", import_count)
  let body = bytebuf_new()
  emit_i64_const(body, 42)
  emit_code_section(out, [
    body
  ])
  bytebuf_to_bytes(out)
}

