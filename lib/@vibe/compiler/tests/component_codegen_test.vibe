    ])
    false
  } with { Exception::Throw(_) => true }
  assert(rejected)
}

/// #1107 Phase 5 (vibec): a library core whose SIBLING exports reference host
/// functions carries `vibe.*` imports even though the lifted entry never
/// reaches them. Same shape as build_test_core_packed_handler, plus an import
/// section with vibe.env-get / vibe.fs_read_file ((i64) -> i64). The handler
/// becomes core func index 2 (after the two imports).
fn build_test_core_stream_handler() -> Bytes {
  let out = bytebuf_new()
  emit_header(out)
  let type_content = bytebuf_new()
  bytebuf_push_vec_header(buf = type_content, count = 2)
  // handler: 3 strings + the stream handle + the closure env, all i64
  emit_func_type_raw(buf = type_content, param_types = [126, 126, 126, 126, 126], result_types = [126])
  emit_func_type_raw(buf = type_content, param_types = [126], result_types = [126])
  bytebuf_push_section(out = out, section_id = 1, content = type_content)
  let import_content = bytebuf_new()
  bytebuf_push_vec_header(buf = import_content, count = 1)
  emit_name(buf = import_content, name = "vibe")
  emit_name(buf = import_content, name = "host_stream_read")
  bytebuf_push(buf = import_content, byte = 0)
  leb128_encode_u32(buf = import_content, value = 1)
  bytebuf_push_section(out = out, section_id = 2, content = import_content)
  emit_function_section(out = out, type_indices = [0])
  emit_memory_section(out = out, min_pages = 1)
  let global_content = bytebuf_new()
  leb128_encode_u32(buf = global_content, value = 1)
  bytebuf_push(buf = global_content, byte = 127)
  bytebuf_push(buf = global_content, byte = 1)
  bytebuf_push(buf = global_content, byte = 65)
  bytebuf_push(buf = global_content, byte = 8)
  bytebuf_push(buf = global_content, byte = 11)
  bytebuf_push_section(out = out, section_id = 6, content = global_content)
  let export_content = bytebuf_new()
  bytebuf_push_vec_header(buf = export_content, count = 3)
  emit_name(buf = export_content, name = "handler")
  bytebuf_push(buf = export_content, byte = 0)
  leb128_encode_u32(buf = export_content, value = 1)
  emit_name(buf = export_content, name = "memory")
  bytebuf_push(buf = export_content, byte = 2)
  leb128_encode_u32(buf = export_content, value = 0)
  emit_name(buf = export_content, name = "__heap_ptr")
  bytebuf_push(buf = export_content, byte = 3)
  leb128_encode_u32(buf = export_content, value = 0)
  bytebuf_push_section(out = out, section_id = 7, content = export_content)
  let h_body = bytebuf_new()
  emit_local_get(buf = h_body, idx = 0)
  emit_code_section(out = out, bodies = [h_body])
  bytebuf_to_bytes(out)
}

fn build_test_core_packed_handler_with_vibe_imports() -> Bytes {
  let out = bytebuf_new()
  emit_header(out)
  let type_content = bytebuf_new()
  bytebuf_push_vec_header(buf = type_content, count = 2)
  emit_func_type_raw(buf = type_content, param_types = [126, 126, 126, 126, 126], result_types = [126])
  emit_func_type_raw(buf = type_content, param_types = [126], result_types = [126])
  bytebuf_push_section(out = out, section_id = 1, content = type_content)
  let import_content = bytebuf_new()
  bytebuf_push_vec_header(buf = import_content, count = 2)
  emit_name(buf = import_content, name = "vibe")
  emit_name(buf = import_content, name = "env-get")
  bytebuf_push(buf = import_content, byte = 0)
  leb128_encode_u32(buf = import_content, value = 1)
  emit_name(buf = import_content, name = "vibe")
  emit_name(buf = import_content, name = "fs_read_file")
  bytebuf_push(buf = import_content, byte = 0)
  leb128_encode_u32(buf = import_content, value = 1)
  bytebuf_push_section(out = out, section_id = 2, content = import_content)
  emit_function_section(out = out, type_indices = [0])
  emit_memory_section(out = out, min_pages = 1)
  let global_content = bytebuf_new()
  leb128_encode_u32(buf = global_content, value = 1)
  bytebuf_push(buf = global_content, byte = 127)
  bytebuf_push(buf = global_content, byte = 1)
  bytebuf_push(buf = global_content, byte = 65)
  bytebuf_push(buf = global_content, byte = 8)
  bytebuf_push(buf = global_content, byte = 11)
  bytebuf_push_section(out = out, section_id = 6, content = global_content)
  let export_content = bytebuf_new()
  bytebuf_push_vec_header(buf = export_content, count = 3)
  emit_name(buf = export_content, name = "handler")
  bytebuf_push(buf = export_content, byte = 0)
  leb128_encode_u32(buf = export_content, value = 2)
  emit_name(buf = export_content, name = "memory")
  bytebuf_push(buf = export_content, byte = 2)
  leb128_encode_u32(buf = export_content, value = 0)
  emit_name(buf = export_content, name = "__heap_ptr")
  bytebuf_push(buf = export_content, byte = 3)
  leb128_encode_u32(buf = export_content, value = 0)
  bytebuf_push_section(out = out, section_id = 7, content = export_content)
  let h_body = bytebuf_new()
  emit_local_get(buf = h_body, idx = 0)
  emit_code_section(out = out, bodies = [h_body])
  bytebuf_to_bytes(out)
}

/// #1540 scope 4: the serve component for a `body: HostStream` handler --
/// the shape `vibe serve` now emits when the handler's last parameter is a
/// stream, and the join of every earlier slice in the issue.
///
/// What is asserted is the WIRING, because that is what silently misbehaves.
/// The stream canons live in a memhost page while `task.return` and the lift
/// keep the MAIN memory (a canon writing fixed addresses into the vibe heap
/// would corrupt whatever the program had there), and the adapter that turns
/// `vibe.host_stream_read` into those canons is a fourth core module the main
/// instance is given. An emitter that dropped the adapter would still produce
/// a component that VALIDATES -- `wac plug` promotes the unsatisfied edge to a
/// root import (#1796) -- and only fail when a request arrives.
test "component #1540: the stream serve lane wires main to the stream canons" {
  let core = core_with_tag_mode(core = build_test_core_stream_handler(), mode = 0)
  let comp = comp_emit_component_wasm_stream_handler(core_wasm = core, target_func_name = "handler", export_name = "handler", param_names = [
    "method",
    "url",
    "headers",
    "body"
  ])
  assert(Bytes::get(comp, at = 0) == 0)
  assert(Bytes::get(comp, at = 4) == 13)
  // the adapter satisfies the guest's read half under its own name
  assert(component_bytes_contains(hay = comp, needle = "host_stream_read") == 1)
  // and it does so through the real canons, not a stub
  assert(component_bytes_contains(hay = comp, needle = "[async-lower][stream-read-0]body") == 1)
  assert(component_bytes_contains(hay = comp, needle = "[stream-drop-readable-0]body") == 1)
  assert(component_bytes_contains(hay = comp, needle = "[waitable-set-wait]") == 1)
  // the result still leaves through task.return: the lift is async, so the
  // core function has no return path to carry it
  assert(component_bytes_contains(hay = comp, needle = "[task-return]handler") == 1)
}

/// The arity guard, and the thing it CANNOT do.
///
/// A stream handler's core function takes 3 strings + the handle + the closure
/// env; a String handler's takes 4 strings + the closure env. Both are five
/// i64. Measured, not assumed -- the `build_test_core_packed_handler_with_vibe_imports`
/// core passes the stream lane's check unchanged. So the core carries NO
/// evidence of which lane it belongs to, and the guard can only catch a core
/// of the wrong SIZE.
///
/// That is why the lane is chosen from the handler's source signature
/// (`serve_handler_takes_body_stream`) and never sniffed from the compiled
/// core: there is nothing there to sniff.
test "component #1540: the stream lane's guard catches a wrong-arity core" {
  let core = core_with_tag_mode(core = build_test_core(), mode = 0)
  let rejected = handle {
    let _ = comp_emit_component_wasm_stream_handler(core_wasm = core, target_func_name = "run", export_name = "handler", param_names = [
      "method",
      "url",
      "headers",
      "body"
    ])
    false
  } with { Exception::Throw(_) => true }
  assert(rejected)
  // and the arity a String handler's core has is INDISTINGUISHABLE from the
  // stream one's -- both five i64 -- so this guard accepts it. Pinning that
  // here keeps the fact from being rediscovered as a silent mis-lane.
  let string_core = core_with_tag_mode(core = build_test_core_packed_handler(), mode = 0)
  let accepted = handle {
    let _ = comp_emit_component_wasm_stream_handler(core_wasm = string_core, target_func_name = "handler", export_name = "handler", param_names = [
      "method",
      "url",
      "headers",
      "body"
    ])
    true
  } with { Exception::Throw(_) => false }
  assert(accepted)
  // #2066: the same arity with `vibe` imports the stream lane has no
  // provider for (`env-get`, `fs_read_file`) is refused by name. It used to
  // compose into a component that failed validation.
  let imports_core = core_with_tag_mode(core = build_test_core_packed_handler_with_vibe_imports(), mode = 0)
  let refused = handle {
    let _ = comp_emit_component_wasm_stream_handler(core_wasm = imports_core, target_func_name = "handler", export_name = "handler", param_names = [
      "method",
      "url",
      "headers",
      "body"
    ])
    ""
  } with { Exception::Throw(m) => "\{m}" }
  assert(String::contains(refused, needle = "host import 'vibe.env-get'"))
}

test "component #1930: the serve stream lane requires explicit plain-i64 metadata" {
  let core = build_test_core_stream_handler()
  let missing_rejected = handle {
    let _ = comp_emit_component_wasm_stream_handler(core_wasm = core, target_func_name = "handler", export_name = "handler", param_names = [
      "method",
      "url",
      "headers",
      "body"
    ])
    false
  } with { Exception::Throw(_) => true }
  assert(missing_rejected)
  let tagged_rejected = handle {
    let _ = comp_emit_component_wasm_stream_handler(core_wasm = core_with_tag_mode(core = core, mode = 1), target_func_name = "handler", export_name = "handler", param_names = [
      "method",
      "url",
      "headers",
      "body"
    ])
    false
  } with { Exception::Throw(_) => true }
  assert(tagged_rejected)
  let plain_accepted = handle {
    let _ = comp_emit_component_wasm_stream_handler(core_wasm = core_with_tag_mode(core = core, mode = 0), target_func_name = "handler", export_name = "handler", param_names = [
      "method",
      "url",
      "headers",
      "body"
    ])
    true
  } with { Exception::Throw(_) => false }
  assert(plain_accepted)
}

test "component #1107: strict string handler rejects vibe.* imports" {
  let core = build_test_core_packed_handler_with_vibe_imports()
  let rejected = handle {
    let _ = comp_emit_component_wasm_string_handler(core_wasm = core, target_func_name = "handler", export_name = "handler", param_names = [
      "method",
      "url",
      "headers",
      "body"
    ])
    false
  } with { Exception::Throw(_) => true }
  assert(rejected)
}

test "component #1107: stubbed string handler hosts vibe.* imports" {
  let core = build_test_core_packed_handler_with_vibe_imports()
  let comp = comp_emit_component_wasm_string_handler_stubbed(core_wasm = core, target_func_name = "handler", export_name = "handler", param_names = [
    "method",
    "url",
    "headers",
    "body"
