  assert(component_bytes_contains(hay = comp, needle = "internal-error") == 1)
  assert(component_bytes_contains(hay = comp, needle = "error-code") == 1)
}

test "ratified HTTP client send owns request and response resources (#2066)" {
  let comp = comp_emit_wit_http_client_send_surface()
  assert(component_bytes_contains(hay = comp, needle = "wasi:http/types@0.3.0") == 1)
  assert(component_bytes_contains(hay = comp, needle = "wasi:http/client@0.3.0") == 1)
