// #1539 is intentionally a separate, production-unused component: exact
// stdin imports plus an opaque provider-table adapter and private scenarios.
test "component stdin provider shadow: distinct lifecycle adapter remains unrouted (#1539)" {
  let comp = comp_emit_component_wasm_stdin_provider_shadow()
  assert(component_bytes_contains(comp, "wasi:cli/types@0.3.0") == 1)
  assert(component_bytes_contains(comp, "wasi:cli/stdin@0.3.0") == 1)
  assert(component_bytes_contains(comp, "read-via-stream") == 1)
  assert(component_bytes_contains(comp, "stdin-provider-shadow-acquire") == 1)
  assert(component_bytes_contains(comp, "stdin-provider-shadow-read") == 1)
  assert(component_bytes_contains(comp, "stdin-provider-shadow-settle") == 1)
  assert(component_bytes_contains(comp, "drain") == 1)
  assert(component_bytes_contains(comp, "early-close") == 1)
  assert(component_bytes_contains(comp, "forced-completion-tag-control") == 1)
  assert(component_bytes_contains(comp, "foreign-provider-control") == 1)
  assert(component_bytes_contains(comp, "wrong-byte-cleanup-control") == 1)
  assert(component_bytes_contains(comp, "extra-byte-cleanup-control") == 1)
  assert(component_bytes_contains(comp, "[async-lower][stream-read-0]read-via-stream") == 1)
  assert(component_bytes_contains(comp, "[async-lower][future-read-1]read-via-stream") == 1)
  assert(component_bytes_contains(comp, "[waitable-set-wait]") == 1)
  assert(component_bytes_contains(comp, "host_stream_get$stdin") == 0)
  assert(component_bytes_contains(comp, "host_stream_close") == 0)
}

// #1539 bounded production route: parsed exact imports key the nominal stdin
// composer, while the main guest receives only the tagged bridge instance.
test "component stdin provider: exact core imports compose through tagged bridge (#1539)" {
  let core = build_main_i64_core_stdin_provider("vibe", true, false, false, true, true, false)
  assert(comp_core_imports_stdin_provider(core))
  let comp = comp_emit_component_wasm_async_stdin_provider(core, "run")
  assert(component_bytes_contains(comp, "wasi:cli/types@0.3.0") == 1)
  assert(component_bytes_contains(comp, "wasi:cli/stdin@0.3.0") == 1)
  assert(component_bytes_contains(comp, "stdin_provider_acquire") == 1)
  assert(component_bytes_contains(comp, "stdin_provider_read") == 1)
  assert(component_bytes_contains(comp, "stdin_provider_close") == 1)
  assert(component_bytes_contains(comp, "[async-lower][stream-read-0]read-via-stream") == 1)
  assert(component_bytes_contains(comp, "[async-lower][future-read-1]read-via-stream") == 1)
  assert(component_bytes_contains(comp, "host_stream_get$stdin") == 0)
  assert(component_bytes_contains(comp, "host_stream_read") == 0)
  assert(component_bytes_contains(comp, "host_stream_close") == 0)
  let drain = comp_emit_component_wasm_async_stdin_provider_fixture(0)
  let early = comp_emit_component_wasm_async_stdin_provider_fixture(1)
  assert(Bytes::length(drain) > 208)
  assert(Bytes::length(early) > 208)
  assert(Bytes::length(drain) != Bytes::length(early))
}

fn stdin_provider_compose_rejection(core: Bytes) -> String {
  handle {
    let _ = comp_emit_component_wasm_async_stdin_provider(core, "run")
    ""
  } with Exception {
    Throw(message) => message
  }
}

fn stdin_provider_compose_rejected(core: Bytes) -> Bool {
  stdin_provider_compose_rejection(core) != ""
}

test "component stdin provider: malformed signature is rejected (#1539)" {
  let core = build_main_i64_core_stdin_provider("vibe", true, false, true, true, false, false)
  assert(comp_core_imports_stdin_provider(core))
  assert(stdin_provider_compose_rejected(core))
}

test "component stdin provider: wrong module is rejected (#1539)" {
  let core = build_main_i64_core_stdin_provider("wrong", true, false, false, true, false, false)
  assert(comp_core_imports_stdin_provider(core) == false)
  assert(stdin_provider_compose_rejected(core))
}

test "component stdin provider: read without acquire is rejected (#1539)" {
  let core = build_main_i64_core_stdin_provider("vibe", false, false, false, true, false, false)
  assert(comp_core_imports_stdin_provider(core))
  assert(stdin_provider_compose_rejected(core))
}

test "component stdin provider: duplicate provider import is rejected (#1539)" {
  let core = build_main_i64_core_stdin_provider("vibe", true, true, false, true, false, false)
  assert(comp_core_imports_stdin_provider(core))
  assert(stdin_provider_compose_rejection(core) == "component(async-stdin-provider): duplicate stdin-provider core import")
}

test "component stdin provider: acquire without consumer is rejected (#1539)" {
  let core = build_main_i64_core_stdin_provider("vibe", true, false, false, false, false, false)
  assert(comp_core_imports_stdin_provider(core))
  assert(stdin_provider_compose_rejection(core) == "component(async-stdin-provider): stdin_provider_acquire requires at least one consuming read or close import")
}

test "component stdin provider: named stream mixing is rejected (#1539)" {
  let core = build_main_i64_core_stdin_provider("vibe", true, false, false, true, true, true)
  assert(comp_core_imports_stdin_provider(core))
  assert(comp_core_imports_host_stream(core))
  assert(stdin_provider_compose_rejected(core))
}

// ADR-0089 Decision 3 (#1218): a named host STREAM composes into a
// `stream<u8>` component import, a per-name adapter getter and the shared
// `host_stream_read` half (stream.read + waitable-set.wait per READ, EOS =
// the measured amount-0/code-1 status -> -1). Runtime proof (42 = summed
// bytes to end of stream through a real compiled program) lives in
// scripts/test_named_hoststreams_component_gate.sh.
fn core_with_tag_mode(core: Bytes, mode: Int) -> Bytes {
  let out = bytebuf_new()
  let mut i = 0
  while i < Bytes::length(core) {
    bytebuf_push(out, Bytes::get(core, i))
    i = i + 1
  }
  let content = bytebuf_new()
  emit_name(content, "vibe.tagmode")
  bytebuf_push(content, mode&255)
  bytebuf_push(content, (mode>>8)&255)
  bytebuf_push(content, (mode>>16)&255)
  bytebuf_push(content, (mode>>24)&255)
  bytebuf_push_section(out, 0, content)
  bytebuf_to_bytes(out)
}

fn core_with_short_tag_mode(core: Bytes) -> Bytes {
  let out = bytebuf_new()
  let mut i = 0
  while i < Bytes::length(core) {
    bytebuf_push(out, Bytes::get(core, i))
    i = i + 1
  }
  let content = bytebuf_new()
  emit_name(content, "vibe.tagmode")
  bytebuf_push(content, 0)
  bytebuf_push_section(out, 0, content)
  bytebuf_to_bytes(out)
}

fn core_with_truncated_tag_mode(core: Bytes) -> Bytes {
  let out = bytebuf_new()
  let mut i = 0
  while i < Bytes::length(core) {
    bytebuf_push(out, Bytes::get(core, i))
    i = i + 1
  }
  // Custom section id + declared payload length, with the payload absent.
  bytebuf_push(out, 0)
  leb128_encode_u32(out, 20)
  bytebuf_to_bytes(out)
}

fn hostfuture_compose_rejected(core: Bytes) -> Bool {
  handle {
    let _ = comp_emit_component_wasm_async_hostfuture(core, "run")
    false
  } with Exception {
    Throw(_) => true
  }
}

fn hostfuture_compose_error(core: Bytes) -> String {
  handle {
    let _ = comp_emit_component_wasm_async_hostfuture(core, "run")
    ""
  } with Exception {
    Throw(msg) => msg
  }
}

test "component async hoststream: adapter follows the core value ABI (#1930)" {
  let core = build_main_i64_core_hoststream_named(false)
  // Both published modes compose. Their runtime value parity is pinned by
  // test_named_hoststreams_component_gate.sh; this unit test keeps metadata
  // parsing and validation in the ordinary compiler test battery.
  let tagged = comp_emit_component_wasm_async_hostfuture(core_with_tag_mode(core, 1), "run")
  let plain = comp_emit_component_wasm_async_hostfuture(core_with_tag_mode(core, 0), "run")
  assert(Bytes::get(tagged, 4) == 13)
  assert(Bytes::get(plain, 4) == 13)
  assert(hostfuture_compose_rejected(core))
  assert(hostfuture_compose_rejected(core_with_short_tag_mode(core)))
  assert(hostfuture_compose_rejected(core_with_truncated_tag_mode(core)))
  assert(hostfuture_compose_rejected(core_with_tag_mode(core, 2)))
  assert(hostfuture_compose_rejected(core_with_tag_mode(core_with_tag_mode(core, 0), 0)))
  assert(hostfuture_compose_rejected(core_with_tag_mode(core_with_tag_mode(core, 0), 1)))
}

/// The rejections above are asserted by OUTCOME, so a message that reads
/// `unsupported vibe.tagmode {mode}` -- the literal placeholder, because vibe
/// interpolation is `\{...}` and a bare `{...}` is just text -- passed them
/// while telling the reader nothing about which value was rejected. Only the
/// value-carrying message is pinned here; the rest are fixed strings that
/// their own outcome assertions already cover.
test "component #1930: the unsupported-tagmode diagnostic names the value" {
  let core = build_main_i64_core_hoststream_named(false)
  let msg = hostfuture_compose_error(core_with_tag_mode(core, 2))
  assert(String::contains(msg, "unsupported vibe.tagmode 2"))
  assert(!String::contains(msg, "{mode}"))
}

test "component async hoststream: named host stream becomes a stream<u8> component import (#1218 D3)" {
  let core = build_main_i64_core_hoststream_named(false)
  assert(comp_core_imports_host_stream(core) == true)
  assert(comp_core_imports_host_future(core) == false)
  assert(comp_core_imports_host_stream(build_main_i64_core_p1()) == false)
  let names = comp_core_host_stream_names(core)
  assert(Array::length(names) == 1)
  assert(Array::get(names, 0) == "host_stream_get$body")
  let comp = comp_emit_component_wasm_async_hostfuture(core_with_tag_mode(core, 1), "run")
  assert(Bytes::get(comp, 0) == 0)
  assert(Bytes::get(comp, 4) == 13)
  // component type (stream u8): 07 04 01 66 01 7d
  assert(bytes_contains_seq(comp, [
    7,
    4,
    1,
    102,
    1,
    125
  ]) == 1)
  // the stream canon set, spelled after the (only) name
  assert(component_bytes_contains(comp, "[async-lower]body") == 1)
  assert(component_bytes_contains(comp, "[async-lower][stream-read-0]body") == 1)
  assert(component_bytes_contains(comp, "[stream-drop-readable-0]body") == 1)
  assert(component_bytes_contains(comp, "[waitable-set-wait]") == 1)
  // the adapter exports the getter under the CORE import spelling plus the
  // shared read half
  assert(component_bytes_contains(comp, "host_stream_get$body") == 1)
  assert(component_bytes_contains(comp, "host_stream_read") == 1)
  // a stream-only program drags in NO future machinery and no anonymous
  // get-future
  assert(component_bytes_contains(comp, "get-future") == 0)
  assert(component_bytes_contains(comp, "future-read") == 0)
  assert(component_bytes_contains(comp, "host_future_wait") == 0)
  // reader-only shape: no write side anywhere
  assert(component_bytes_contains(comp, "stream-new") == 0)
  assert(component_bytes_contains(comp, "stream-write") == 0)
  assert(component_bytes_contains(comp, "stream-drop-writable") == 0)
}

// Mixed program: one named future + one named stream share the adapter,
// the waitable quartet, and the composition -- and keep their own canon
// families (future<u32> for `price`, stream<u8> for `body`).
test "component async hoststream: future + stream share one composition (#1218 D3)" {
  let core = build_main_i64_core_hoststream_named(true)
  assert(comp_core_imports_host_future(core) == true)
  assert(comp_core_imports_host_stream(core) == true)
  let comp = comp_emit_component_wasm_async_hostfuture(core_with_tag_mode(core, 1), "run")
  assert(Bytes::get(comp, 0) == 0)
  assert(Bytes::get(comp, 4) == 13)
  // both value types: (future u32) 07 04 01 65 01 79 and (stream u8)
  // 07 04 01 66 01 7d
  assert(bytes_contains_seq(comp, [
    7,
    4,
    1,
    101,
    1,
    121
  ]) == 1)
  assert(bytes_contains_seq(comp, [
    7,
    4,
    1,
    102,
    1,
    125
  ]) == 1)
  assert(component_bytes_contains(comp, "[async-lower]price") == 1)
  assert(component_bytes_contains(comp, "[async-lower]body") == 1)
  assert(component_bytes_contains(comp, "[async-lower][future-read-0]price") == 1)
  assert(component_bytes_contains(comp, "[async-lower][stream-read-0]body") == 1)
  assert(component_bytes_contains(comp, "host_future_get$price") == 1)
  assert(component_bytes_contains(comp, "host_future_wait") == 1)
  assert(component_bytes_contains(comp, "host_stream_get$body") == 1)
  assert(component_bytes_contains(comp, "host_stream_read") == 1)
}

test "component async hostfuture: rejects a core without a run export" {
  let rejected = handle {
    let _ = comp_emit_component_wasm_async_hostfuture(core_with_tag_mode(build_main_i64_core_hostfuture(false, false), 1), "run")
    false
  } with Exception {
    Throw(_) => true
  }
  assert(rejected)
}

test "component async hostfuture: rejects a core with an unsatisfiable host import" {
  let rejected = handle {
    let _ = comp_emit_component_wasm_async_hostfuture(core_with_tag_mode(build_main_i64_core_hostfuture(true, true), 1), "run")
    false
  } with Exception {
    Throw(_) => true
  }
  assert(rejected)
}

// The future payload valtype and the task.return result valtype are the
// same hard-coded u32 in the guest module; any other request must throw,
// same rationale as the other fixed-shape emitters.
test "component future-value: rejects a non-u32 result valtype" {
  let rejected = handle {
    let _ = comp_emit_component_wasm_future_value("run", 120)
    false
  } with Exception {
    Throw(_) => true
  }
  assert(rejected)
}

// ADR-0089 step 2 (#1218): the stream-value component -- same rendezvous
// composition as future-value with the stream.* canon family (opcodes one
// block apart) and a u8 element type. Byte shapes recovered via
// `wasm-tools dump` against tools/wasip3_component_probe/stream_value/
// component.wat; runtime proof lives in
// scripts/test_stream_value_component_gate.sh.
test "component stream-value: stream.* canon set with a u8 element type" {
  let comp = comp_emit_component_wasm_stream_value("run", 121)
  assert(Bytes::get(comp, 0) == 0)
  assert(Bytes::get(comp, 4) == 13)
  // component type (stream u8): 07 04 01 66 01 7d
  assert(bytes_contains_seq(comp, [
    7,
    4,
    1,
    102,
    1,
    125
  ]) == 1)
  // canon stream.new ty=0: 08 03 01 0e 00
  assert(bytes_contains_seq(comp, [
    8,
    3,
    1,
    14,
    0
  ]) == 1)
  // canon stream.read ty=0 async (memory 0): 08 07 01 0f 00 02 06 03 00
  assert(bytes_contains_seq(comp, [
    8,
    7,
    1,
    15,
    0,
    2,
    6,
    3,
    0
  ]) == 1)
  // canon stream.write ty=0 async (memory 0): 08 07 01 10 00 02 06 03 00
  assert(bytes_contains_seq(comp, [
    8,
    7,
    1,
    16,
    0,
    2,
    6,
    3,
    0
  ]) == 1)
  // canon stream.drop-readable ty=0: 08 03 01 13 00
  assert(bytes_contains_seq(comp, [
    8,
    3,
    1,
    19,
    0
  ]) == 1)
  // canon stream.drop-writable ty=0: 08 03 01 14 00
  assert(bytes_contains_seq(comp, [
    8,
    3,
    1,
    20,
    0
  ]) == 1)
  // task.return stays u32 (the element type is u8, the RESULT is not)
  assert(bytes_contains_seq(comp, [
    8,
    5,
    1,
    9,
    0,
    121,
    0
  ]) == 1)
  assert(component_bytes_contains(comp, "[stream-new-0]pipe") == 1)
  assert(component_bytes_contains(comp, "[async-lower][stream-read-0]pipe") == 1)
  assert(component_bytes_contains(comp, "[async-lower][stream-write-0]pipe") == 1)
  assert(component_bytes_contains(comp, "[stream-drop-readable-0]pipe") == 1)
  assert(component_bytes_contains(comp, "[stream-drop-writable-0]pipe") == 1)
  assert(component_bytes_contains(comp, "[waitable-set-new]") == 1)
  assert(component_bytes_contains(comp, "[waitable-set-wait]") == 1)
  assert(component_bytes_contains(comp, "[task-return]run") == 1)
  // Self-contained, and streams only: no host import, no subtask, no
  // future.* canon anywhere.
  assert(component_bytes_contains(comp, "get-async") == 0)
  assert(component_bytes_contains(comp, "[subtask-drop]") == 0)
  assert(component_bytes_contains(comp, "[future") == 0)
}

// Same u32-result guard as every fixed-shape async emitter.
test "component stream-value: rejects a non-u32 result valtype" {
  let rejected = handle {
    let _ = comp_emit_component_wasm_stream_value("run", 120)
    false
  } with Exception {
    Throw(_) => true
  }
  assert(rejected)
}
