//# #537 packed-string handler emitter

/// A core module shaped like a linear-backend compile: exports
/// `handler` with the (i64 x N+1) -> i64 packed-string ABI (trailing closure
/// env), plus `memory` and `__heap_ptr` (mut i32 global).
fn build_test_core_packed_handler() -> Bytes {
  let out = bytebuf_new()
  emit_header(out)
  let type_content = bytebuf_new()
  bytebuf_push_vec_header(buf = type_content, count = 1)
  emit_func_type_raw(buf = type_content, param_types = [126, 126, 126, 126, 126], result_types = [126])
  bytebuf_push_section(out = out, section_id = 1, content = type_content)
  emit_function_section(out = out, type_indices = [0])
  emit_memory_section(out = out, min_pages = 1)
  // global section: one mut i32 = 8 (the bump frontier)
  let global_content = bytebuf_new()
  leb128_encode_u32(buf = global_content, value = 1)
  bytebuf_push(buf = global_content, byte = 127)
  bytebuf_push(buf = global_content, byte = 1)
  bytebuf_push(buf = global_content, byte = 65)
  bytebuf_push(buf = global_content, byte = 8)
  bytebuf_push(buf = global_content, byte = 11)
  bytebuf_push_section(out = out, section_id = 6, content = global_content)
  // exports: handler (func 0), memory, __heap_ptr (global 0)
  let export_content = bytebuf_new()
  bytebuf_push_vec_header(buf = export_content, count = 3)
  emit_name(buf = export_content, name = "handler")
  bytebuf_push(buf = export_content, byte = 0)
  leb128_encode_u32(buf = export_content, value = 0)
  emit_name(buf = export_content, name = "memory")
  bytebuf_push(buf = export_content, byte = 2)
  leb128_encode_u32(buf = export_content, value = 0)
  emit_name(buf = export_content, name = "__heap_ptr")
  bytebuf_push(buf = export_content, byte = 3)
  leb128_encode_u32(buf = export_content, value = 0)
  bytebuf_push_section(out = out, section_id = 7, content = export_content)
  let h_body = bytebuf_new()
  emit_local_get(buf = h_body, idx = 0)
  emit_code_section(out = out, bodies = [h_body])
  bytebuf_to_bytes(out)
}

test "component #537: packed trampoline exports canon_func and cabi_realloc" {
  let tramp = comp_generate_string_trampoline_packed(4)
  assert(Bytes::get(tramp, at = 0) == 0)
  assert(Bytes::get(tramp, at = 4) == 1)
  assert(component_bytes_contains(hay = tramp, needle = "canon_func") == 1)
  assert(component_bytes_contains(hay = tramp, needle = "cabi_realloc") == 1)
  assert(component_bytes_contains(hay = tramp, needle = "__heap_ptr") == 1)
  assert(component_bytes_contains(hay = tramp, needle = "target_func") == 1)
}

test "component #537: string handler wraps a packed-ABI core" {
  let core = build_test_core_packed_handler()
  let comp = comp_emit_component_wasm_string_handler(core_wasm = core, target_func_name = "handler", export_name = "handler", param_names = [
    "method",
    "url",
    "headers",
    "body"
  ])
  assert(Bytes::get(comp, at = 0) == 0)
  assert(Bytes::get(comp, at = 4) == 13)
  assert(component_bytes_contains(hay = comp, needle = "handler") == 1)
  assert(component_bytes_contains(hay = comp, needle = "cabi_realloc") == 1)
  // component functype params are kebab-cased names
  assert(component_bytes_contains(hay = comp, needle = "headers") == 1)
}

