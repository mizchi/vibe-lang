  assert(component_bytes_contains(hay = comp, needle = "error-code") == 1)
  assert(component_bytes_contains(hay = comp, needle = "send") == 1)
}

//# Functions

fn component_bytes_contains(hay: Bytes, needle: String) -> Int {
  let hay_len = Bytes::length(hay)
  let needle_len = String::length(needle)
  if needle_len == 0 {
    1
  }
  else {
    let limit = hay_len - needle_len
    let mut found = 0
    let mut i = 0
    while (i <= limit) && (found == 0) {
      let mut ok = 1
      let mut j = 0
      while (j < needle_len) && (ok == 1) {
        if Bytes::get(hay, at = i + j) != String::char_code_at(needle, at = j) {
          ok = 0
        }
        j = j + 1
      }
      if ok == 1 {
        found = 1
      }
      i = i + 1
    }
    found
  }
}

fn repeated_string(piece: String, count: Int) -> String {
  let out = StringBuilder::new()
  let mut i = 0
  while i < count {
    StringBuilder::push(out, value = piece)
    i = i + 1
  }
  StringBuilder::freeze(out)
}

fn build_test_core() -> Bytes {
  let out = bytebuf_new()
  emit_header(out)
  emit_type_section(out = out, param_count = 2, result_count = 1)
  emit_function_section(out = out, type_indices = [0])
  emit_export_section(out = out, name = "run", func_idx = 0)
  let body = bytebuf_new()
  emit_local_get(buf = body, idx = 0)
  emit_local_get(buf = body, idx = 1)
  emit_i64_add(body)
  emit_code_section(out = out, bodies = [body])
  bytebuf_to_bytes(out)
}

fn build_test_core_with_memory() -> Bytes {
  let out = bytebuf_new()
  emit_header(out)
  let type_content = bytebuf_new()
  bytebuf_push_vec_header(buf = type_content, count = 2)
  emit_func_type_raw(buf = type_content, param_types = [126, 126, 127], result_types = [126])
  emit_func_type_raw(buf = type_content, param_types = [127, 127, 127, 127], result_types = [127])
  bytebuf_push_section(out = out, section_id = 1, content = type_content)
  emit_function_section(out = out, type_indices = [0, 1])
  emit_memory_section(out = out, min_pages = 1)
  emit_exports_with_memory(out = out, fn_names = ["handler", "cabi_realloc"], fn_indices = [0, 1], mem_name = "memory", mem_idx = 0)
  let h_body = bytebuf_new()
  emit_local_get(buf = h_body, idx = 0)
  let r_body = bytebuf_new()
  emit_i32_const(buf = r_body, value = 0)
  emit_code_section(out = out, bodies = [h_body, r_body])
  bytebuf_to_bytes(out)
}

fn build_test_core_with_memory_and_run() -> Bytes {
  let out = bytebuf_new()
  emit_header(out)
  let type_content = bytebuf_new()
  bytebuf_push_vec_header(buf = type_content, count = 3)
  emit_func_type_raw(buf = type_content, param_types = [126, 126, 127], result_types = [126])
  emit_func_type_raw(buf = type_content, param_types = [127, 127, 127, 127], result_types = [127])
  emit_func_type_raw(buf = type_content, param_types = array_empty(), result_types = [126])
  bytebuf_push_section(out = out, section_id = 1, content = type_content)
  emit_function_section(out = out, type_indices = [0, 1, 2])
  emit_memory_section(out = out, min_pages = 1)
  emit_exports_with_memory(out = out, fn_names = ["handler", "cabi_realloc", "_start"], fn_indices = [0, 1, 2], mem_name = "memory", mem_idx = 0)
  let h_body = bytebuf_new()
  emit_local_get(buf = h_body, idx = 0)
  let r_body = bytebuf_new()
  emit_i32_const(buf = r_body, value = 0)
  let run_body = bytebuf_new()
  emit_i64_const(buf = run_body, value = 0)
  emit_code_section(out = out, bodies = [h_body, r_body, run_body])
  bytebuf_to_bytes(out)
}

fn bytes_contains_seq(hay: Bytes, needle: Array[Int]) -> Int {
  let hay_len = Bytes::length(hay)
  let needle_len = Array::length(needle)
  if needle_len == 0 {
    1
  }
  else {
    let limit = hay_len - needle_len
    let mut found = 0
    let mut i = 0
    while (i <= limit) && (found == 0) {
      let mut ok = 1
      let mut j = 0
      while (j < needle_len) && (ok == 1) {
        if Bytes::get(hay, at = i + j) != Array::get(needle, at = j) {
          ok = 0
        }
        j = j + 1
      }
      if ok == 1 {
        found = 1
      }
      i = i + 1
    }
    found
  }
}

/// Core module that imports ("cm","task-return") and exports a void `run` which
/// hands a constant to task.return — the shape comp_emit_component_wasm_async wraps.
fn build_async_test_core() -> Bytes {
  let out = bytebuf_new()
  emit_header(out)
  let tc = bytebuf_new()
  bytebuf_push_vec_header(buf = tc, count = 2)
  emit_func_type_raw(buf = tc, param_types = [127], result_types = array_empty())
  emit_func_type_raw(buf = tc, param_types = array_empty(), result_types = array_empty())
  bytebuf_push_section(out = out, section_id = 1, content = tc)
  emit_import_section_func(out = out, module_name = "cm", field_name = "task-return", type_idx = 0)
  emit_function_section(out = out, type_indices = [1])
  emit_export_section(out = out, name = "run", func_idx = 1)
  let body = bytebuf_new()
  emit_i32_const(buf = body, value = 42)
  bytebuf_push(buf = body, byte = 16)
  leb128_encode_u32(buf = body, value = 0)
  emit_code_section(out = out, bodies = [body])
  bytebuf_to_bytes(out)
}

/// Normally-compiled main entry: a nullary vibe fn lowers to (param i64)->i64.
fn build_main_i64_core() -> Bytes {
  let out = bytebuf_new()
  emit_header(out)
  let tc = bytebuf_new()
  bytebuf_push_vec_header(buf = tc, count = 1)
  emit_func_type_raw(buf = tc, param_types = [126], result_types = [126])
  bytebuf_push_section(out = out, section_id = 1, content = tc)
  emit_function_section(out = out, type_indices = [0])
  emit_export_section(out = out, name = "run", func_idx = 0)
  let body = bytebuf_new()
  emit_i64_const(buf = body, value = 42)
  emit_code_section(out = out, bodies = [body])
  bytebuf_to_bytes(out)
}

/// Main entry that imports wasi_snapshot_preview1.fd_write (as every compiled
/// core does) and exports run : () -> i64 = 42.
fn build_main_i64_core_p1() -> Bytes {
  let out = bytebuf_new()
  emit_header(out)
  let tc = bytebuf_new()
  bytebuf_push_vec_header(buf = tc, count = 2)
  emit_func_type_raw(buf = tc, param_types = [127, 127, 127, 127], result_types = [127])
  emit_func_type_raw(buf = tc, param_types = [126], result_types = [126])
  bytebuf_push_section(out = out, section_id = 1, content = tc)
  let ic = bytebuf_new()
  bytebuf_push_vec_header(buf = ic, count = 1)
  emit_name(buf = ic, name = "wasi_snapshot_preview1")
  emit_name(buf = ic, name = "fd_write")
  bytebuf_push(buf = ic, byte = 0)
  bytebuf_push(buf = ic, byte = 0)
  bytebuf_push_section(out = out, section_id = 2, content = ic)
  emit_function_section(out = out, type_indices = [1])
  emit_export_section(out = out, name = "run", func_idx = 1)
  let body = bytebuf_new()
  emit_i64_const(buf = body, value = 42)
  emit_code_section(out = out, bodies = [body])
  bytebuf_to_bytes(out)
}

//# Misc

test "component async p1: wraps wasi-importing core with fd_write stub" {
  let main_core = build_main_i64_core_p1()
  let comp = comp_emit_component_wasm_async_trampolined_p1(main_core_wasm = main_core, export_name = "run", comp_result_valtype = 120)
  assert(Bytes::get(comp, at = 0) == 0)
  assert(Bytes::get(comp, at = 4) == 13)
  assert(bytes_contains_seq(hay = comp, needle = [8, 5, 1, 9, 0, 120, 0]) == 1)
  assert(bytes_contains_seq(hay = comp, needle = [7, 5, 1, 67, 0, 0, 120]) == 1)
  assert(bytes_contains_seq(hay = comp, needle = [8, 7, 1, 0, 0, 2, 1, 6, 0]) == 1)
  assert(component_bytes_contains(hay = comp, needle = "fd_write") == 1)
  assert(component_bytes_contains(hay = comp, needle = "wasi_snapshot_preview1") == 1)
}

test "component async trampolined: two-module compose with async lift" {
  let main_core = build_main_i64_core()
  let comp = comp_emit_component_wasm_async_trampolined(main_core_wasm = main_core, export_name = "run", comp_result_valtype = 120)
  assert(Bytes::get(comp, at = 0) == 0)
  assert(Bytes::get(comp, at = 4) == 13)
  // task.return canon (s64=120): 08 05 01 09 00 78 00
  assert(bytes_contains_seq(hay = comp, needle = [8, 5, 1, 9, 0, 120, 0]) == 1)
  // async functype () -> s64: 07 05 01 43 00 00 78
  assert(bytes_contains_seq(hay = comp, needle = [7, 5, 1, 67, 0, 0, 120]) == 1)
  // async lift of core func 2 (trampoline run), type 0: 08 07 01 00 00 02 01 06 00
  assert(bytes_contains_seq(hay = comp, needle = [8, 7, 1, 0, 0, 2, 1, 6, 0]) == 1)
  // trampoline imports task-return from "cm"
  assert(component_bytes_contains(hay = comp, needle = "task-return") == 1)
  assert(component_bytes_contains(hay = comp, needle = "run") == 1)
}

test "component async: emits task.return canon, async functype, async lift" {
  let core = build_async_test_core()
  let comp = comp_emit_component_wasm_async(core_wasm = core, export_name = "run", result_valtype = 120)
  assert(Bytes::get(comp, at = 0) == 0)
  assert(Bytes::get(comp, at = 4) == 13)
  assert(bytes_contains_seq(hay = comp, needle = [8, 5, 1, 9, 0, 120, 0]) == 1)
  assert(bytes_contains_seq(hay = comp, needle = [7, 5, 1, 67, 0, 0, 120]) == 1)
  assert(bytes_contains_seq(hay = comp, needle = [8, 7, 1, 0, 0, 1, 1, 6, 0]) == 1)
  assert(component_bytes_contains(hay = comp, needle = "run") == 1)
}

/// #1540: the widened emitters must produce the encoding the probe measured
/// against wasmtime, byte for byte.
///
/// The sequences below are the ones
/// `tools/wasip3_component_probe/async_string_lift/component.wat` documents and
/// `scripts/test_async_string_lift_probe_gate.sh` asserts against a real
/// wasmtime run. This test is the other half: the probe proves wasmtime accepts
/// them, this proves the emitter produces them.
test "component async: widened canon emitters match the measured string encoding (#1540)" {
  let bytes = comp_emit_async_string_canon_fixture()
  // async functype, one string param named "name", string result:
  // 43 01 04 'n' 'a' 'm' 'e' 73 00 73
  assert(bytes_contains_seq(hay = bytes, needle = [67, 1, 4, 110, 97, 109, 101, 115, 0, 115]) == 1)
  // task.return with Memory(0) + UTF8 -- and NO realloc, which wasmtime rejects
  // on this built-in: 09 00 73 02 03 00 00
  assert(bytes_contains_seq(hay = bytes, needle = [9, 0, 115, 2, 3, 0, 0]) == 1)
  // async lift with Async + Memory(0) + Realloc(0) + UTF8:
  // 00 00 02 04 06 03 00 04 00 00 00
  assert(bytes_contains_seq(hay = bytes, needle = [0, 0, 2, 4, 6, 3, 0, 4, 0, 0, 0]) == 1)
}

/// The zero-option spellings must stay byte-identical -- every existing caller
/// goes through them, and this slice is meant to add a capability, not move any
/// bytes.
test "component async: the narrow spellings are unchanged by the widening (#1540)" {
  let core = build_async_test_core()
  let comp = comp_emit_component_wasm_async(core_wasm = core, export_name = "run", result_valtype = 120)
  // task.return with an EMPTY option list
  assert(bytes_contains_seq(hay = comp, needle = [8, 5, 1, 9, 0, 120, 0]) == 1)
  // async functype with ZERO params
  assert(bytes_contains_seq(hay = comp, needle = [7, 5, 1, 67, 0, 0, 120]) == 1)
  // async lift with exactly one option (async)
  assert(bytes_contains_seq(hay = comp, needle = [8, 7, 1, 0, 0, 1, 1, 6, 0]) == 1)
}

/// #1540: the memhost has to grow a `cabi_realloc` for the string shape --
/// both canons are declared before the guest instance exists, so neither can
/// point at a guest-owned memory or realloc without an instantiation cycle.
test "component async: memhost-with-realloc exports memory and cabi_realloc (#1540)" {
  let m = comp_emit_memhost_realloc_fixture()
  // core wasm header
  assert(Bytes::get(m, at = 0) == 0)
  assert(Bytes::get(m, at = 1) == 97)
  assert(Bytes::get(m, at = 2) == 115)
  assert(Bytes::get(m, at = 3) == 109)
  assert(component_bytes_contains(hay = m, needle = "memory") == 1)
  assert(component_bytes_contains(hay = m, needle = "cabi_realloc") == 1)
  // the realloc's type is (i32,i32,i32,i32) -> i32: 60 04 7f 7f 7f 7f 01 7f
  assert(bytes_contains_seq(hay = m, needle = [96, 4, 127, 127, 127, 127, 1, 127]) == 1)
}

/// #1540: the assembled component -- the emitter twin of the async_string_lift
/// probe, and the milestone the canon widening was for.
///
/// The three canon sequences are the same ones the fixture test above pins, so
/// this test is not about them: it is about the INDICES around them, which the
/// fixture cannot exercise because it emits the canons into an empty component.
/// Aliases and canon built-ins share one core-func index space in emission
/// order, so the realloc alias (which must precede both canons) pushes
/// task.return to core func 1 and the guest's own export to core func 2. Get
/// that wrong and every byte here still looks right while the component either
/// fails to validate or lifts the wrong function.
///
/// `scripts/compiler_gate.sh` runs the emitted component under wasmtime; this
/// test is the always-on half that needs no external tool.
test "component async: the emitted string component wires the canon indices (#1540)" {
  let comp = comp_emit_async_string_component(export_name = "greet", param_name = "name", reply = "hi")
  // async functype: one string param named "name", string result
  assert(bytes_contains_seq(hay = comp, needle = [67, 1, 4, 110, 97, 109, 101, 115, 0, 115]) == 1)
  // task.return: Memory(0) + UTF8, no realloc
  assert(bytes_contains_seq(hay = comp, needle = [9, 0, 115, 2, 3, 0, 0]) == 1)
  // the async lift, lifting CORE FUNC 2 -- the guest alias, not the realloc
  // alias (0) and not task.return (1)
  assert(bytes_contains_seq(hay = comp, needle = [0, 0, 2, 4, 6, 3, 0, 4, 0, 0, 0]) == 1)
  // the guest imports the task-return under the name the export is called
  assert(component_bytes_contains(hay = comp, needle = "[task-return]greet") == 1)
  assert(component_bytes_contains(hay = comp, needle = "[export]$root") == 1)
  // and the reply is a data segment, so it is observable to the lift
  assert(component_bytes_contains(hay = comp, needle = "hi") == 1)
}

test "component async: reply data stays below the caller allocation region (#1540)" {
  let reply = repeated_string(piece = "x", count = 1100)
  let comp = comp_emit_async_string_component(export_name = "greet", param_name = "name", reply = reply)
  // reply occupies [16, 1116), so the next 64-byte boundary is 1152. The
  // memhost global initializer must therefore be i32.const 1152 (80 09), not
  // the old fixed 1024 (80 08), or canonical lowering overwrites the reply.
  assert(bytes_contains_seq(hay = comp, needle = [6, 7, 1, 127, 1, 65, 128, 9, 11]) == 1)
}

/// #1540: the body-read component -- the emitter twin of the http_body_read
/// probe, and the first emitted shape whose handler takes a STREAM.
///
/// The stream param is the part a reader is most likely to misread, so it is
/// the part this pins: in the component model's valtype encoding a primitive
/// is a single byte in 0x73..0x7f and anything smaller is a TYPE INDEX, so the
/// `body` param's `0` is the stream type declared above it, not some empty or
/// defaulted valtype. Get it wrong and the handler silently takes a different
/// type.
///
/// `scripts/test_http_body_read_probe_gate.sh` runs the emitted component
/// under `wasmtime serve` against the same POST assertions as the hand-written
/// probe; this is the always-on half that needs no external tool.
test "component async: the emitted body-read component takes a stream param (#1540)" {
  let comp = comp_emit_body_read_component(export_name = "handler", string_param_names = [
    "method",
    "url",
    "headers"
  ], stream_param_name = "body")
  // stream<u8> component type: 66 01 7d
  assert(bytes_contains_seq(hay = comp, needle = [102, 1, 125]) == 1)
  // stream.read with Async + Memory(0): 0f 00 02 06 03 00
  assert(bytes_contains_seq(hay = comp, needle = [15, 0, 2, 6, 3, 0]) == 1)
  // async functype, 4 params
  assert(bytes_contains_seq(hay = comp, needle = [67, 4]) == 1)
  // ... whose last param is "body" typed as TYPE INDEX 0, result string:
  // 04 'b' 'o' 'd' 'y' 00 | 00 73
  assert(bytes_contains_seq(hay = comp, needle = [4, 98, 111, 100, 121, 0, 0, 115]) == 1)
  // the async lift, lifting CORE FUNC 8 -- the guest alias, which lands there
  // only because the realloc alias and all seven canons precede it in the one
  // shared core-func index space
  assert(bytes_contains_seq(hay = comp, needle = [0, 0, 8, 4, 6, 3, 0, 4, 0, 0, 1]) == 1)
  // the guest reaches the stream through the canons under these names
  assert(component_bytes_contains(hay = comp, needle = "[async-lower][stream-read-0]body") == 1)
  assert(component_bytes_contains(hay = comp, needle = "[task-return]handler") == 1)
  // and its diagnostics are strings, so a failure can name what broke
  assert(component_bytes_contains(hay = comp, needle = "ERR-OVERRUN") == 1)
}

/// #1540 scope 3/4: the async trampoline's STREAM parameter.
///
/// Two things are pinned, and the second is the one that cannot fail loudly.
///
/// The canonical ABI flattens `stream<u8>` to ONE i32 handle after the
/// strings' (ptr, len) pairs, so `canon_func` takes 2N+1 i32 -- shape, easy to
/// see. The handle then reaches the handler's core function as a vibe Int, and
/// an Int's REPRESENTATION is the compile mode's: `enable_rc` on means
/// `value << 1`, off means a plain i64 (linked_compile's tag_mode). This lane's
/// core comes from `vibe serve`'s `compile_wasi_module_no_dce_impl`, which
/// passes enable_rc = false -- so the handle crosses UNTAGGED, zero-extended
/// and nothing else, matching what comp_generate_serve_stream_adapter_module
/// reads back. Getting this wrong does not trap: a tag the guest does not
/// expect just doubles the handle, and a doubled handle reads a different
/// stream or silently reads none.
test "component async: the stream trampoline flattens the handle UNTAGGED (#1540)" {
  let m = comp_emit_stream_trampoline_fixture(3)
  // core wasm header
  assert(Bytes::get(m, at = 0) == 0)
  assert(Bytes::get(m, at = 1) == 97)
  // target_func takes 3 strings + the stream + the closure env = 5 i64,
  // returning i64: 60 05 7e 7e 7e 7e 7e 01 7e
  assert(bytes_contains_seq(hay = m, needle = [96, 5, 126, 126, 126, 126, 126, 1, 126]) == 1)
  // canon_func takes 2*3 + 1 = 7 i32 and returns NOTHING (async lift):
  // 60 07 7f x7 00
  assert(bytes_contains_seq(hay = m, needle = [96, 7, 127, 127, 127, 127, 127, 127, 127, 0]) == 1)
  // local.get 6 (the handle slot) ; i64.extend_i32_u (ad) ; then straight to
  // the closure-env argument (i64.const 0 = 42 00) and the call (10 00).
  assert(bytes_contains_seq(hay = m, needle = [32, 6, 173, 66, 0, 16, 0]) == 1)
  // the tag that must NOT be there: i64.extend_i32_u ; i64.const 1 ; i64.shl
  assert(bytes_contains_seq(hay = m, needle = [32, 6, 173, 66, 1, 134]) == 0)
  // and it still hands the result back through task.return, not a retptr
  assert(component_bytes_contains(hay = m, needle = "[task-return]handler") == 1)
}

