test "component: export contains name" {
  let core = build_test_core()
  let comp = comp_emit_component_wasm_with_lift(core, "my_run")
  assert(component_bytes_contains(comp, "my-run") == 1)
  assert(component_bytes_contains(comp, "my_run") == 0)
}

test "component: string lift kebab-cases parameter names" {
  let core = build_test_core_with_memory()
  let comp = comp_emit_component_wasm_with_string_lift(core, "handler", "run_cli_request", 2, [
    "input_path",
    "output_path"
  ], 0)
  assert(component_bytes_contains(comp, "input-path") == 1)
  assert(component_bytes_contains(comp, "output-path") == 1)
  assert(component_bytes_contains(comp, "input_path") == 0)
  assert(component_bytes_contains(comp, "output_path") == 0)
}

test "component: simple wrap overhead is small" {
  let core = build_test_core()
  let comp = comp_emit_component_wasm(core)
  let overhead = Bytes::length(comp) - Bytes::length(core)
  assert(overhead > 0)
  assert(overhead < 100)
}

//# #537 packed-string handler emitter

/// A core module shaped like a linear-backend compile: exports
/// `handler` with the (i64 x N+1) -> i64 packed-string ABI (trailing closure
/// env), plus `memory` and `__heap_ptr` (mut i32 global).
fn build_test_core_packed_handler() -> Bytes {
  let out = bytebuf_new()
  emit_header(out)
  let type_content = bytebuf_new()
  bytebuf_push_vec_header(type_content, 1)
  emit_func_type_raw(type_content, [
    126,
    126,
    126,
    126,
    126
  ], [
    126
  ])
  bytebuf_push_section(out, 1, type_content)
  emit_function_section(out, [
    0
  ])
  emit_memory_section(out, 1)
  // global section: one mut i32 = 8 (the bump frontier)
  let global_content = bytebuf_new()
  leb128_encode_u32(global_content, 1)
  bytebuf_push(global_content, 127)
  bytebuf_push(global_content, 1)
  bytebuf_push(global_content, 65)
  bytebuf_push(global_content, 8)
  bytebuf_push(global_content, 11)
  bytebuf_push_section(out, 6, global_content)
  // exports: handler (func 0), memory, __heap_ptr (global 0)
  let export_content = bytebuf_new()
  bytebuf_push_vec_header(export_content, 3)
  emit_name(export_content, "handler")
  bytebuf_push(export_content, 0)
  leb128_encode_u32(export_content, 0)
  emit_name(export_content, "memory")
  bytebuf_push(export_content, 2)
  leb128_encode_u32(export_content, 0)
  emit_name(export_content, "__heap_ptr")
  bytebuf_push(export_content, 3)
  leb128_encode_u32(export_content, 0)
  bytebuf_push_section(out, 7, export_content)
  let h_body = bytebuf_new()
  emit_local_get(h_body, 0)
  emit_code_section(out, [
    h_body
  ])
  bytebuf_to_bytes(out)
}

test "component #537: packed trampoline exports canon_func and cabi_realloc" {
  let tramp = comp_generate_string_trampoline_packed(4)
  assert(Bytes::get(tramp, 0) == 0)
  assert(Bytes::get(tramp, 4) == 1)
  assert(component_bytes_contains(tramp, "canon_func") == 1)
  assert(component_bytes_contains(tramp, "cabi_realloc") == 1)
  assert(component_bytes_contains(tramp, "__heap_ptr") == 1)
  assert(component_bytes_contains(tramp, "target_func") == 1)
}

test "component #537: string handler wraps a packed-ABI core" {
  let core = build_test_core_packed_handler()
  let comp = comp_emit_component_wasm_string_handler(core, "handler", "handler", [
    "method",
    "url",
    "headers",
    "body"
  ])
  assert(Bytes::get(comp, 0) == 0)
  assert(Bytes::get(comp, 4) == 13)
  assert(component_bytes_contains(comp, "handler") == 1)
  assert(component_bytes_contains(comp, "cabi_realloc") == 1)
  // component functype params are kebab-cased names
  assert(component_bytes_contains(comp, "headers") == 1)
}

test "component #537: string handler rejects a missing export" {
  let core = build_test_core_packed_handler()
  let rejected = handle {
    let _ = comp_emit_component_wasm_string_handler(core, "nope", "handler", [
      "method"
    ])
    false
  } with Error {
    Throw(_) => true
  }
  assert(rejected)
}

test "component #537: string handler rejects a wrong signature" {
  let core = build_test_core_packed_handler()
  // core handler takes 4 strings (5 i64s); asking for 2 must throw
  let rejected = handle {
    let _ = comp_emit_component_wasm_string_handler(core, "handler", "handler", [
      "method",
      "url"
    ])
    false
  } with Error {
    Throw(_) => true
  }
  assert(rejected)
}

/// #1107 Phase 5 (vibec): a library core whose SIBLING exports reference host
/// functions carries `vibe.*` imports even though the lifted entry never
/// reaches them. Same shape as build_test_core_packed_handler, plus an import
/// section with vibe.env-get / vibe.fs_read_file ((i64) -> i64). The handler
/// becomes core func index 2 (after the two imports).
fn build_test_core_packed_handler_with_vibe_imports() -> Bytes {
  let out = bytebuf_new()
  emit_header(out)
  let type_content = bytebuf_new()
  bytebuf_push_vec_header(type_content, 2)
  emit_func_type_raw(type_content, [
    126,
    126,
    126,
    126,
    126
  ], [
    126
  ])
  emit_func_type_raw(type_content, [
    126
  ], [
    126
  ])
  bytebuf_push_section(out, 1, type_content)
  let import_content = bytebuf_new()
  bytebuf_push_vec_header(import_content, 2)
  emit_name(import_content, "vibe")
  emit_name(import_content, "env-get")
  bytebuf_push(import_content, 0)
  leb128_encode_u32(import_content, 1)
  emit_name(import_content, "vibe")
  emit_name(import_content, "fs_read_file")
  bytebuf_push(import_content, 0)
  leb128_encode_u32(import_content, 1)
  bytebuf_push_section(out, 2, import_content)
  emit_function_section(out, [
    0
  ])
  emit_memory_section(out, 1)
  let global_content = bytebuf_new()
  leb128_encode_u32(global_content, 1)
  bytebuf_push(global_content, 127)
  bytebuf_push(global_content, 1)
  bytebuf_push(global_content, 65)
  bytebuf_push(global_content, 8)
  bytebuf_push(global_content, 11)
  bytebuf_push_section(out, 6, global_content)
  let export_content = bytebuf_new()
  bytebuf_push_vec_header(export_content, 3)
  emit_name(export_content, "handler")
  bytebuf_push(export_content, 0)
  leb128_encode_u32(export_content, 2)
  emit_name(export_content, "memory")
  bytebuf_push(export_content, 2)
  leb128_encode_u32(export_content, 0)
  emit_name(export_content, "__heap_ptr")
  bytebuf_push(export_content, 3)
  leb128_encode_u32(export_content, 0)
  bytebuf_push_section(out, 7, export_content)
  let h_body = bytebuf_new()
  emit_local_get(h_body, 0)
  emit_code_section(out, [
    h_body
  ])
  bytebuf_to_bytes(out)
}

test "component #1107: strict string handler rejects vibe.* imports" {
  let core = build_test_core_packed_handler_with_vibe_imports()
  let rejected = handle {
    let _ = comp_emit_component_wasm_string_handler(core, "handler", "handler", [
      "method",
      "url",
      "headers",
      "body"
    ])
    false
  } with Error {
    Throw(_) => true
  }
  assert(rejected)
}

test "component #1107: stubbed string handler hosts vibe.* imports" {
  let core = build_test_core_packed_handler_with_vibe_imports()
  let comp = comp_emit_component_wasm_string_handler_stubbed(core, "handler", "handler", [
    "method",
    "url",
    "headers",
    "body"
  ])
  assert(Bytes::get(comp, 0) == 0)
  assert(Bytes::get(comp, 4) == 13)
  // the stub module must export a same-name stub for every vibe.* import
  // (plus the usual fd_write), and the component must still lift the handler.
  assert(component_bytes_contains(comp, "env-get") == 1)
  assert(component_bytes_contains(comp, "fs_read_file") == 1)
  assert(component_bytes_contains(comp, "fd_write") == 1)
  assert(component_bytes_contains(comp, "handler") == 1)
}

// #1230 M1b-3c-1b: blocking await with the wait loop in its own function.
// The byte shapes asserted below were recovered empirically via
// `wasm-tools dump` against tools/wasip3_component_probe/spawned_future/
// component.wat's compiled output (see that probe's README.md and
// canon-imports-exports.wit-abi.txt), not hand-derived from the spec --
// this test pins the SAME shapes this composer's doc comments describe.
// A stronger, execution-based check (this exact composer's output run
// through the probe's Rust host driver against a genuinely-blocking host
// import, confirming a real ~300ms suspend and a correct result of 42)
// lives in scripts/test_spawned_future_component_gate.sh; `vibe test`
// itself has no Fs/subprocess access to drive that host binary.
//
// Note this emitter models "spawn" only in the degenerate case (nothing
// observable between spawn and join) -- see the composer's doc comment.
test "component async spawned-future: blocking await via a callee wait loop, no future.* canon" {
  let comp = comp_emit_component_wasm_async_spawned_future("run", 121)
  assert(Bytes::get(comp, 0) == 0)
  assert(Bytes::get(comp, 4) == 13)
  // task.return canon (u32=121): 08 05 01 09 00 79 00
  assert(bytes_contains_seq(comp, [
    8,
    5,
    1,
    9,
    0,
    121,
    0
  ]) == 1)
  // async functype () -> u32: 07 05 01 43 00 00 79
  assert(bytes_contains_seq(comp, [
    7,
    5,
    1,
    67,
    0,
    0,
    121
  ]) == 1)
  // canon lower(get-async) async (memory 0): 08 08 01 01 00 00 02 06 03 00
  assert(bytes_contains_seq(comp, [
    8,
    8,
    1,
    1,
    0,
    0,
    2,
    6,
    3,
    0
  ]) == 1)
  // canon waitable-set.new: 08 02 01 1f
  assert(bytes_contains_seq(comp, [
    8,
    2,
    1,
    31
  ]) == 1)
  // canon waitable.join: 08 02 01 23
  assert(bytes_contains_seq(comp, [
    8,
    2,
    1,
    35
  ]) == 1)
  // canon waitable-set.wait (memory 0): 08 04 01 20 00 00
  assert(bytes_contains_seq(comp, [
    8,
    4,
    1,
    32,
    0,
    0
  ]) == 1)
  // canon waitable-set.drop: 08 02 01 22
  assert(bytes_contains_seq(comp, [
    8,
    2,
    1,
    34
  ]) == 1)
  // canon subtask.drop: 08 02 01 0d
  assert(bytes_contains_seq(comp, [
    8,
    2,
    1,
    13
  ]) == 1)
  assert(component_bytes_contains(comp, "get-async") == 1)
  assert(component_bytes_contains(comp, "[async-lower]get-async") == 1)
  assert(component_bytes_contains(comp, "[waitable-set-new]") == 1)
  assert(component_bytes_contains(comp, "[waitable-join]") == 1)
  assert(component_bytes_contains(comp, "[waitable-set-wait]") == 1)
  assert(component_bytes_contains(comp, "[waitable-set-drop]") == 1)
  assert(component_bytes_contains(comp, "[subtask-drop]") == 1)
  assert(component_bytes_contains(comp, "[task-return]run") == 1)
  // No future.* canon anywhere: the emitted shape needs no canonical-ABI
  // future value (see composer's doc comment). "future" would only ever
  // appear inside a "[async-lower]"/"[async-lift]" wire name here, never
  // as its own bracketed canon name.
  assert(component_bytes_contains(comp, "[future") == 0)
  assert(component_bytes_contains(comp, "context-get") == 0)
  assert(component_bytes_contains(comp, "context-set") == 0)
  assert(component_bytes_contains(comp, "waitable-set-poll") == 0)
}

// #1240 review: the guest core module is hard-coded to an i32-shaped result,
// so any other requested lowering (notably the project's ordinary s64 `Int`)
// would emit a task.return canon disagreeing with the guest's own
// [task-return] import type and fail component validation. The emitter must
// reject it up front rather than produce an invalid component.
test "component async spawned-future: rejects a non-u32 result valtype" {
  let rejected = handle {
    let _ = comp_emit_component_wasm_async_spawned_future("run", 120)
    false
  } with Error {
    Throw(_) => true
  }
  assert(rejected)
}

// #1230 M1b-3c-3: the concurrent-awaits component -- two host operations
// genuinely in flight at once. It shares the composer (and therefore every
// canon section, import and export) with the spawned-future component; the
// entire difference is inside the guest core module, where both
// async-lowered calls are issued BEFORE either is waited on.
//
// So the interesting properties to pin here are (a) the shared composer
// still wires the same canon set through the new entry point, and (b) the
// two emitters do NOT produce identical bytes -- if the guest-module
// argument were ever mixed up, every canon assertion below would still
// pass while the component silently reverted to the serial shape. The
// runtime proof (84 in ~300ms rather than ~600ms for two 300ms host calls)
// lives in scripts/test_concurrent_awaits_component_gate.sh; `vibe test`
// cannot drive a component.
test "component async concurrent-awaits: same canon set as spawned-future, different guest" {
  let comp = comp_emit_component_wasm_async_concurrent_awaits("run", 121)
  assert(Bytes::get(comp, 0) == 0)
  assert(Bytes::get(comp, 4) == 13)
  // task.return canon (u32=121)
  assert(bytes_contains_seq(comp, [
    8,
    5,
    1,
    9,
    0,
    121,
    0
  ]) == 1)
  // canon lower(get-async) async (memory 0)
  assert(bytes_contains_seq(comp, [
    8,
    8,
    1,
    1,
    0,
    0,
    2,
    6,
    3,
    0
  ]) == 1)
  assert(component_bytes_contains(comp, "get-async") == 1)
  assert(component_bytes_contains(comp, "[async-lower]get-async") == 1)
  assert(component_bytes_contains(comp, "[waitable-set-new]") == 1)
  assert(component_bytes_contains(comp, "[waitable-join]") == 1)
  assert(component_bytes_contains(comp, "[waitable-set-wait]") == 1)
  assert(component_bytes_contains(comp, "[waitable-set-drop]") == 1)
  assert(component_bytes_contains(comp, "[subtask-drop]") == 1)
  assert(component_bytes_contains(comp, "[task-return]run") == 1)
  // Still no future.*/context.*/poll -- concurrency needs none of them.
  assert(component_bytes_contains(comp, "[future") == 0)
  assert(component_bytes_contains(comp, "context-get") == 0)
  assert(component_bytes_contains(comp, "context-set") == 0)
  assert(component_bytes_contains(comp, "waitable-set-poll") == 0)
  // ...but it is NOT the spawned-future component.
  let serial = comp_emit_component_wasm_async_spawned_future("run", 121)
  assert(Bytes::length(comp) != Bytes::length(serial))
}

// Same u32-only guard as the spawned-future emitter: both share the
// composer, so the rejection must fire through the new entry point too.
test "component async concurrent-awaits: rejects a non-u32 result valtype" {
  let rejected = handle {
    let _ = comp_emit_component_wasm_async_concurrent_awaits("run", 120)
    false
  } with Error {
    Throw(_) => true
  }
  assert(rejected)
}

// ADR-0089 step 2 (#1218): the future-value component -- the first emitted
// shape that uses the literal `future.*` canonical built-ins. Byte shapes
// below were recovered via `wasm-tools dump` against
// tools/wasip3_component_probe/future_value/component.wat's compiled
// output (which returns 42 on wasmtime 47 with
// -W component-model-more-async-builtins=y), not hand-derived from the
// spec. Runtime proof (BLOCKED read -> eager write -> FUTURE_READ event ->
// 42) lives in scripts/test_future_value_component_gate.sh; `vibe test`
// cannot drive a component.
test "component future-value: future.* canon set, no host import, no subtask" {
  let comp = comp_emit_component_wasm_future_value("run", 121)
  assert(Bytes::get(comp, 0) == 0)
  assert(Bytes::get(comp, 4) == 13)
  // component type (future u32): 07 04 01 65 01 79
  assert(bytes_contains_seq(comp, [
    7,
    4,
    1,
    101,
    1,
    121
  ]) == 1)
  // canon future.new ty=0: 08 03 01 15 00
  assert(bytes_contains_seq(comp, [
    8,
    3,
    1,
    21,
    0
  ]) == 1)
  // canon future.read ty=0 async (memory 0): 08 07 01 16 00 02 06 03 00
  assert(bytes_contains_seq(comp, [
    8,
    7,
    1,
    22,
    0,
    2,
    6,
    3,
    0
  ]) == 1)
  // canon future.write ty=0 async (memory 0): 08 07 01 17 00 02 06 03 00
  assert(bytes_contains_seq(comp, [
    8,
    7,
    1,
    23,
    0,
    2,
    6,
    3,
    0
  ]) == 1)
  // canon future.drop-readable ty=0: 08 03 01 1a 00
  assert(bytes_contains_seq(comp, [
    8,
    3,
    1,
    26,
    0
  ]) == 1)
  // canon future.drop-writable ty=0: 08 03 01 1b 00
  assert(bytes_contains_seq(comp, [
    8,
    3,
    1,
    27,
    0
  ]) == 1)
  // task.return canon (u32=121) and the waitable-set machinery ride along
  assert(bytes_contains_seq(comp, [
    8,
    5,
    1,
    9,
    0,
    121,
    0
  ]) == 1)
  assert(component_bytes_contains(comp, "[future-new-0]make") == 1)
  assert(component_bytes_contains(comp, "[async-lower][future-read-0]make") == 1)
  assert(component_bytes_contains(comp, "[async-lower][future-write-0]make") == 1)
  assert(component_bytes_contains(comp, "[future-drop-readable-0]make") == 1)
  assert(component_bytes_contains(comp, "[future-drop-writable-0]make") == 1)
  assert(component_bytes_contains(comp, "[waitable-set-new]") == 1)
  assert(component_bytes_contains(comp, "[waitable-join]") == 1)
  assert(component_bytes_contains(comp, "[waitable-set-wait]") == 1)
  assert(component_bytes_contains(comp, "[waitable-set-drop]") == 1)
  assert(component_bytes_contains(comp, "[task-return]run") == 1)
  // Self-contained: no host async import, hence no canon lower and no
  // subtask anywhere in the shape.
  assert(component_bytes_contains(comp, "get-async") == 0)
  assert(component_bytes_contains(comp, "[subtask-drop]") == 0)
  assert(component_bytes_contains(comp, "context-get") == 0)
  assert(component_bytes_contains(comp, "waitable-set-poll") == 0)
}

// ADR-0089 Decision 2 / step 4 (#1218): the HOST-future-value component --
// imports `get-future` and parks the read on waitable-set.wait until the
// host's producer resolves. Byte shapes recovered via `wasm-tools dump`
// against tools/wasip3_component_probe/host_future_value/component.wat's
// compiled output (42 in ~300ms under runtime/viberun's FutureReader
// import -- the wall clock proving a genuine suspend). Runtime proof lives
// in scripts/test_host_future_value_component_gate.sh.
test "component host-future-value: get-future import + waitable park, no write end" {
  let comp = comp_emit_component_wasm_host_future_value("run", 121)
  assert(Bytes::get(comp, 0) == 0)
  assert(Bytes::get(comp, 4) == 13)
  // component type (future u32): 07 04 01 65 01 79
  assert(bytes_contains_seq(comp, [
    7,
    4,
    1,
    101,
    1,
    121
  ]) == 1)
  // import functype `async () -> (type 0)`: 07 05 01 43 00 00 00
  assert(bytes_contains_seq(comp, [
    7,
    5,
    1,
    67,
    0,
    0,
    0
  ]) == 1)
  // component import of get-future with functype index 1:
  // 0a 0f 01 00 0a "get-future" 01 01
  assert(bytes_contains_seq(comp, [
    10,
    15,
    1,
    0,
    10
  ]) == 1)
  assert(component_bytes_contains(comp, "get-future") == 1)
  // canon lower async (memory 0) of the import: 08 08 01 01 00 00 02 06 03 00
  assert(bytes_contains_seq(comp, [
    8,
    8,
    1,
    1,
    0,
    0,
    2,
    6,
    3,
    0
  ]) == 1)
  // canon future.read ty=0 async (memory 0): 08 07 01 16 00 02 06 03 00
  assert(bytes_contains_seq(comp, [
    8,
    7,
    1,
    22,
    0,
    2,
    6,
    3,
    0
  ]) == 1)
  // canon future.drop-readable ty=0: 08 03 01 1a 00
  assert(bytes_contains_seq(comp, [
    8,
    3,
    1,
    26,
    0
  ]) == 1)
  assert(component_bytes_contains(comp, "[async-lower]get-future") == 1)
  assert(component_bytes_contains(comp, "[async-lower][future-read-0]get-future") == 1)
  assert(component_bytes_contains(comp, "[future-drop-readable-0]get-future") == 1)
  assert(component_bytes_contains(comp, "[waitable-set-new]") == 1)
  assert(component_bytes_contains(comp, "[waitable-join]") == 1)
  assert(component_bytes_contains(comp, "[waitable-set-wait]") == 1)
  assert(component_bytes_contains(comp, "[waitable-set-drop]") == 1)
  assert(component_bytes_contains(comp, "[task-return]run") == 1)
  // The host owns the write end: no future.new, no write, no
  // drop-writable anywhere in the shape -- and no subtask machinery
  // (the get-future call itself must complete eagerly).
  assert(component_bytes_contains(comp, "future-new") == 0)
  assert(component_bytes_contains(comp, "future-write") == 0)
  assert(component_bytes_contains(comp, "future-drop-writable") == 0)
  assert(component_bytes_contains(comp, "[subtask-drop]") == 0)
}

test "component host-future-value: rejects a non-u32 result valtype" {
  let rejected = handle {
    let _ = comp_emit_component_wasm_host_future_value("run", 120)
    false
  } with Error {
    Throw(_) => true
  }
  assert(rejected)
}

// The future payload valtype and the task.return result valtype are the
// same hard-coded u32 in the guest module; any other request must throw,
// same rationale as the other fixed-shape emitters.
test "component future-value: rejects a non-u32 result valtype" {
  let rejected = handle {
    let _ = comp_emit_component_wasm_future_value("run", 120)
    false
  } with Error {
    Throw(_) => true
  }
  assert(rejected)
}

// ADR-0089 step 2 (#1218): the stream-value component -- same rendezvous
// composition as future-value with the stream.* canon family (opcodes one
// block apart) and a u8 element type. Byte shapes recovered via
// `wasm-tools dump` against tools/wasip3_component_probe/stream_value/
// component.wat; runtime proof lives in
// scripts/test_stream_value_component_gate.sh.
test "component stream-value: stream.* canon set with a u8 element type" {
  let comp = comp_emit_component_wasm_stream_value("run", 121)
  assert(Bytes::get(comp, 0) == 0)
  assert(Bytes::get(comp, 4) == 13)
  // component type (stream u8): 07 04 01 66 01 7d
  assert(bytes_contains_seq(comp, [
    7,
    4,
    1,
    102,
    1,
    125
  ]) == 1)
  // canon stream.new ty=0: 08 03 01 0e 00
  assert(bytes_contains_seq(comp, [
    8,
    3,
    1,
    14,
    0
  ]) == 1)
  // canon stream.read ty=0 async (memory 0): 08 07 01 0f 00 02 06 03 00
  assert(bytes_contains_seq(comp, [
    8,
    7,
    1,
    15,
    0,
    2,
    6,
    3,
    0
  ]) == 1)
  // canon stream.write ty=0 async (memory 0): 08 07 01 10 00 02 06 03 00
  assert(bytes_contains_seq(comp, [
    8,
    7,
    1,
    16,
    0,
    2,
    6,
    3,
    0
  ]) == 1)
  // canon stream.drop-readable ty=0: 08 03 01 13 00
  assert(bytes_contains_seq(comp, [
    8,
    3,
    1,
    19,
    0
  ]) == 1)
  // canon stream.drop-writable ty=0: 08 03 01 14 00
  assert(bytes_contains_seq(comp, [
    8,
    3,
    1,
    20,
    0
  ]) == 1)
  // task.return stays u32 (the element type is u8, the RESULT is not)
  assert(bytes_contains_seq(comp, [
    8,
    5,
    1,
    9,
    0,
    121,
    0
  ]) == 1)
  assert(component_bytes_contains(comp, "[stream-new-0]pipe") == 1)
  assert(component_bytes_contains(comp, "[async-lower][stream-read-0]pipe") == 1)
  assert(component_bytes_contains(comp, "[async-lower][stream-write-0]pipe") == 1)
  assert(component_bytes_contains(comp, "[stream-drop-readable-0]pipe") == 1)
  assert(component_bytes_contains(comp, "[stream-drop-writable-0]pipe") == 1)
  assert(component_bytes_contains(comp, "[waitable-set-new]") == 1)
  assert(component_bytes_contains(comp, "[waitable-set-wait]") == 1)
  assert(component_bytes_contains(comp, "[task-return]run") == 1)
  // Self-contained, and streams only: no host import, no subtask, no
  // future.* canon anywhere.
  assert(component_bytes_contains(comp, "get-async") == 0)
  assert(component_bytes_contains(comp, "[subtask-drop]") == 0)
  assert(component_bytes_contains(comp, "[future") == 0)
}

// Same u32-result guard as every fixed-shape async emitter.
test "component stream-value: rejects a non-u32 result valtype" {
  let rejected = handle {
    let _ = comp_emit_component_wasm_stream_value("run", 120)
    false
  } with Error {
    Throw(_) => true
  }
  assert(rejected)
}
