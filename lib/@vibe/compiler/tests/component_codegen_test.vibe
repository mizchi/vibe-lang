test "component WIT async import: versioned interface owns future<Int> function (#2064)" {
  let comp = comp_emit_wit_async_future_import_surface(interface_id = "example:prices/api@1.0.0", func_name = "get-price", wit_result_type = "future<s64>")
  assert(component_bytes_contains(hay = comp, needle = "example:prices/api@1.0.0") == 1)
  assert(component_bytes_contains(hay = comp, needle = "get-price") == 1)
  assert(component_bytes_contains(hay = comp, needle = "[async-lower]get-price") == 0)
}

test "component WIT async import: unversioned or unmapped contracts fail closed (#2064)" {
  let unversioned = handle {
    let _ = comp_emit_wit_async_future_import_surface(interface_id = "example:prices/api", func_name = "get-price", wit_result_type = "future<s64>")
    false
  } with { Exception::Throw(_) => true }
  let unmapped = handle {
    let _ = comp_emit_wit_async_future_import_surface(interface_id = "example:prices/api@1.0.0", func_name = "get-price", wit_result_type = "future<price-record>")
    false
  } with { Exception::Throw(_) => true }
  assert(unversioned && unmapped)
}

test "component WIT async import: record payload has a canonical landing layout (#2064)" {
  let descriptor = "future<record{amount:s64,currency:string}>"
  let comp = comp_emit_wit_async_future_import_surface(interface_id = "example:prices/api@1.0.0", func_name = "get-price", wit_result_type = descriptor)
  assert(component_bytes_contains(hay = comp, needle = "amount") == 1)
  assert(component_bytes_contains(hay = comp, needle = "currency") == 1)
  assert(comp_wit_async_payload_landing_layout(descriptor) == "size=16,align=8;amount@0:s64;currency@8:string")
}

test "component WIT async import: enum payload uses one discriminant lane (#2064)" {
  let descriptor = "future<enum{cheap,expensive}>"
  let comp = comp_emit_wit_async_future_import_surface(interface_id = "example:prices/api@1.0.0", func_name = "get-band", wit_result_type = descriptor)
  assert(component_bytes_contains(hay = comp, needle = "cheap") == 1)
  assert(component_bytes_contains(hay = comp, needle = "expensive") == 1)
  assert(comp_wit_async_payload_landing_layout(descriptor) == "size=1,align=1;discriminant@0:u8")
}

test "component WIT async import: malformed aggregate payloads fail closed (#2064)" {
  let malformed_record = handle {
    let _ = comp_emit_wit_async_future_import_surface(interface_id = "example:prices/api@1.0.0", func_name = "get-price", wit_result_type = "future<record{amount:bytes}>")
    false
  } with { Exception::Throw(message) => String::contains(message, needle = "unsupported record field type") }
  let malformed_enum = handle {
    let _ = comp_emit_wit_async_future_import_surface(interface_id = "example:prices/api@1.0.0", func_name = "get-band", wit_result_type = "future<enum{cheap,}>")
    false
  } with { Exception::Throw(message) => String::contains(message, needle = "enum case must not be empty") }
  assert(malformed_record && malformed_enum)
}

test "outbound HTTP Future<Response> keeps the streaming body nominal (#2066)" {
  let request = comp_wit_outbound_http_request_descriptor()
  let response = comp_wit_outbound_http_response_descriptor()
  assert(request == "record{method:string,url:string,headers:string,body:stream<u8>}")
  assert(response == "future<record{status:s32,headers:string,body:stream<u8>}>")
  assert(comp_wit_outbound_http_response_body_contract() == "stream<u8> -> HostStream (host-owned readable; close is idempotent)")
  assert(comp_wit_async_payload_landing_layout(response) == "size=16,align=4;status@0:s32;headers@4:string;body@12:stream<u8>")
}

test "outbound HTTP Future<Response> emits a versioned nominal import (#2066)" {
  let comp = comp_emit_wit_async_future_import_surface(interface_id = "wasi:http/outgoing-handler@0.3.0", func_name = "handle", wit_result_type = comp_wit_outbound_http_response_descriptor())
  assert(component_bytes_contains(hay = comp, needle = "wasi:http/types@0.3.0") == 1)
  assert(component_bytes_contains(hay = comp, needle = "wasi:http/outgoing-handler@0.3.0") == 1)
  assert(component_bytes_contains(hay = comp, needle = "status") == 1)
  assert(component_bytes_contains(hay = comp, needle = "body") == 1)
}

test "outbound HTTP dual fetch surface owns two async request paths (#2066)" {
  let comp = comp_emit_wit_outbound_http_dual_fetch_surface()
  assert(component_bytes_contains(hay = comp, needle = "wasi:http/types@0.3.0") == 1)
