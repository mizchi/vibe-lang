    1,
    6,
    0
  ]) == 0)
}

test "component: simple wrap has component header" {
  let core = build_test_core()
  let comp = comp_emit_component_wasm(core)
  assert(Bytes::get(comp, 0) == 0)
  assert(Bytes::get(comp, 1) == 97)
  assert(Bytes::get(comp, 2) == 115)
  assert(Bytes::get(comp, 3) == 109)
  assert(Bytes::get(comp, 4) == 13)
  assert(Bytes::length(comp) > Bytes::length(core))
}

test "component: lift no imports produces valid component" {
  let core = build_test_core()
  let comp = comp_emit_component_wasm_with_lift(core, "run")
  assert(Bytes::get(comp, 0) == 0)
  assert(Bytes::get(comp, 4) == 13)
  assert(Bytes::length(comp) > Bytes::length(core))
}

test "component: string trampoline has wasm header" {
  let tramp = comp_generate_string_trampoline(2, 0)
  assert(Bytes::get(tramp, 0) == 0)
  assert(Bytes::get(tramp, 1) == 97)
  assert(Bytes::get(tramp, 2) == 115)
  assert(Bytes::get(tramp, 3) == 109)
  assert(Bytes::get(tramp, 4) == 1)
  assert(Bytes::length(tramp) > 20)
}

test "component: string lift injects run_init when core exports _start" {
  let core = build_test_core_with_memory_and_run()
  let comp = comp_emit_component_wasm_with_string_lift(core, "handler", "handler", 2, [
    "method",
    "url"
  ], 0)
  assert(component_bytes_contains(comp, "run_init") == 1)
}

test "component: string lift omits run_init without _start export" {
  let core = build_test_core_with_memory()
  let comp = comp_emit_component_wasm_with_string_lift(core, "handler", "handler", 2, [
    "method",
    "url"
  ], 0)
  assert(component_bytes_contains(comp, "run_init") == 0)
}

test "component: export contains name" {
  let core = build_test_core()
  let comp = comp_emit_component_wasm_with_lift(core, "my_run")
  assert(component_bytes_contains(comp, "my-run") == 1)
  assert(component_bytes_contains(comp, "my_run") == 0)
}

test "component: string lift kebab-cases parameter names" {
  let core = build_test_core_with_memory()
  let comp = comp_emit_component_wasm_with_string_lift(core, "handler", "run_cli_request", 2, [
    "input_path",
    "output_path"
  ], 0)
  assert(component_bytes_contains(comp, "input-path") == 1)
  assert(component_bytes_contains(comp, "output-path") == 1)
  assert(component_bytes_contains(comp, "input_path") == 0)
  assert(component_bytes_contains(comp, "output_path") == 0)
}

test "component: simple wrap overhead is small" {
  let core = build_test_core()
  let comp = comp_emit_component_wasm(core)
  let overhead = Bytes::length(comp) - Bytes::length(core)
  assert(overhead > 0)
  assert(overhead < 100)
}

//# #537 packed-string handler emitter

/// A core module shaped like a linear-backend compile: exports
/// `handler` with the (i64 x N+1) -> i64 packed-string ABI (trailing closure
/// env), plus `memory` and `__heap_ptr` (mut i32 global).
fn build_test_core_packed_handler() -> Bytes {
  let out = bytebuf_new()
  emit_header(out)
  let type_content = bytebuf_new()
  bytebuf_push_vec_header(type_content, 1)
  emit_func_type_raw(type_content, [
    126,
    126,
    126,
    126,
    126
  ], [
    126
  ])
  bytebuf_push_section(out, 1, type_content)
  emit_function_section(out, [
    0
  ])
  emit_memory_section(out, 1)
  // global section: one mut i32 = 8 (the bump frontier)
  let global_content = bytebuf_new()
  leb128_encode_u32(global_content, 1)
  bytebuf_push(global_content, 127)
  bytebuf_push(global_content, 1)
  bytebuf_push(global_content, 65)
  bytebuf_push(global_content, 8)
  bytebuf_push(global_content, 11)
  bytebuf_push_section(out, 6, global_content)
  // exports: handler (func 0), memory, __heap_ptr (global 0)
  let export_content = bytebuf_new()
  bytebuf_push_vec_header(export_content, 3)
  emit_name(export_content, "handler")
  bytebuf_push(export_content, 0)
  leb128_encode_u32(export_content, 0)
  emit_name(export_content, "memory")
  bytebuf_push(export_content, 2)
  leb128_encode_u32(export_content, 0)
  emit_name(export_content, "__heap_ptr")
  bytebuf_push(export_content, 3)
  leb128_encode_u32(export_content, 0)
  bytebuf_push_section(out, 7, export_content)
  let h_body = bytebuf_new()
  emit_local_get(h_body, 0)
  emit_code_section(out, [
    h_body
  ])
  bytebuf_to_bytes(out)
}

test "component #537: packed trampoline exports canon_func and cabi_realloc" {
  let tramp = comp_generate_string_trampoline_packed(4)
  assert(Bytes::get(tramp, 0) == 0)
  assert(Bytes::get(tramp, 4) == 1)
  assert(component_bytes_contains(tramp, "canon_func") == 1)
  assert(component_bytes_contains(tramp, "cabi_realloc") == 1)
  assert(component_bytes_contains(tramp, "__heap_ptr") == 1)
  assert(component_bytes_contains(tramp, "target_func") == 1)
}

test "component #537: string handler wraps a packed-ABI core" {
  let core = build_test_core_packed_handler()
  let comp = comp_emit_component_wasm_string_handler(core, "handler", "handler", [
    "method",
    "url",
    "headers",
    "body"
  ])
  assert(Bytes::get(comp, 0) == 0)
  assert(Bytes::get(comp, 4) == 13)
  assert(component_bytes_contains(comp, "handler") == 1)
  assert(component_bytes_contains(comp, "cabi_realloc") == 1)
  // component functype params are kebab-cased names
  assert(component_bytes_contains(comp, "headers") == 1)
}

test "component #537: string handler rejects a missing export" {
  let core = build_test_core_packed_handler()
  let rejected = handle {
    let _ = comp_emit_component_wasm_string_handler(core, "nope", "handler", [
      "method"
    ])
    false
  } with Exception {
    Throw(_) => true
  }
  assert(rejected)
}

test "component #537: string handler rejects a wrong signature" {
  let core = build_test_core_packed_handler()
  // core handler takes 4 strings (5 i64s); asking for 2 must throw
  let rejected = handle {
    let _ = comp_emit_component_wasm_string_handler(core, "handler", "handler", [
      "method",
      "url"
    ])
    false
  } with Exception {
    Throw(_) => true
  }
  assert(rejected)
}

/// #1107 Phase 5 (vibec): a library core whose SIBLING exports reference host
/// functions carries `vibe.*` imports even though the lifted entry never
/// reaches them. Same shape as build_test_core_packed_handler, plus an import
/// section with vibe.env-get / vibe.fs_read_file ((i64) -> i64). The handler
/// becomes core func index 2 (after the two imports).
fn build_test_core_stream_handler() -> Bytes {
  let out = bytebuf_new()
  emit_header(out)
  let type_content = bytebuf_new()
  bytebuf_push_vec_header(type_content, 2)
  // handler: 3 strings + the stream handle + the closure env, all i64
  emit_func_type_raw(type_content, [
    126,
    126,
    126,
    126,
    126
  ], [
    126
  ])
  emit_func_type_raw(type_content, [
    126
  ], [
    126
  ])
  bytebuf_push_section(out, 1, type_content)
  let import_content = bytebuf_new()
  bytebuf_push_vec_header(import_content, 1)
  emit_name(import_content, "vibe")
  emit_name(import_content, "host_stream_read")
  bytebuf_push(import_content, 0)
  leb128_encode_u32(import_content, 1)
  bytebuf_push_section(out, 2, import_content)
  emit_function_section(out, [
    0
  ])
  emit_memory_section(out, 1)
  let global_content = bytebuf_new()
  leb128_encode_u32(global_content, 1)
  bytebuf_push(global_content, 127)
  bytebuf_push(global_content, 1)
  bytebuf_push(global_content, 65)
  bytebuf_push(global_content, 8)
  bytebuf_push(global_content, 11)
  bytebuf_push_section(out, 6, global_content)
  let export_content = bytebuf_new()
  bytebuf_push_vec_header(export_content, 3)
  emit_name(export_content, "handler")
  bytebuf_push(export_content, 0)
  leb128_encode_u32(export_content, 1)
  emit_name(export_content, "memory")
  bytebuf_push(export_content, 2)
  leb128_encode_u32(export_content, 0)
  emit_name(export_content, "__heap_ptr")
  bytebuf_push(export_content, 3)
  leb128_encode_u32(export_content, 0)
  bytebuf_push_section(out, 7, export_content)
  let h_body = bytebuf_new()
  emit_local_get(h_body, 0)
  emit_code_section(out, [
    h_body
  ])
  bytebuf_to_bytes(out)
}

