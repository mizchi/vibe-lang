  let core = build_test_core_packed_handler()
  // core handler takes 4 strings (5 i64s); asking for 2 must throw
  let rejected = handle {
    let _ = comp_emit_component_wasm_string_handler(core_wasm = core, target_func_name = "handler", export_name = "handler", param_names = [
      "method",
