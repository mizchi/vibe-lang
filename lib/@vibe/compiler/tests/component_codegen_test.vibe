}

test "HTTP service and middleware worlds keep client and handler directions explicit (#2066)" {
  assert(comp_wit_http_world_contract("service") == "import types; import client; export handler")
  assert(comp_wit_http_world_contract("middleware") == "import types; import handler; import client; export handler")
}

test "HTTP body ownership rejects collected and reused stream boundaries (#2066)" {
  assert(comp_wit_http_body_boundary_contract(direction = "request", guest_type = "HostStream") == "request: own stream<u8> -> HostStream; consume once; close idempotent")
  assert(comp_wit_http_body_boundary_contract(direction = "response", guest_type = "HostStream") == "response: own stream<u8> -> HostStream; consume once; close idempotent")
  let collected = handle {
    let _ = comp_wit_http_body_boundary_contract(direction = "response", guest_type = "String")
    false
  } with { Exception::Throw(message) => String::contains(message, needle = "must remain streaming") }
  let reused = handle {
    let _ = comp_wit_http_body_boundary_contract(direction = "request-reused", guest_type = "HostStream")
    false
  } with { Exception::Throw(message) => String::contains(message, needle = "already-consumed") }
  assert(collected && reused)
}

test "ratified HTTP error-code surface includes every payload closure (#2066)" {
  let comp = comp_emit_wit_http_error_code_type_surface()
