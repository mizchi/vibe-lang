//# Functions

fn component_bytes_contains(hay: Bytes, needle: String) -> Int {
  let hay_len = Bytes::length(hay)
  let needle_len = String::length(needle)
  if needle_len == 0 {
    1
  }
  else {
    let limit = hay_len - needle_len
    let mut found = 0
    let mut i = 0
    while (i <= limit) && (found == 0) {
      let mut ok = 1
      let mut j = 0
      while (j < needle_len) && (ok == 1) {
        if Bytes::get(hay, i + j) != String::char_code_at(needle, j) {
          ok = 0
        }
        j = j + 1
      }
      if ok == 1 {
        found = 1
      }
      i = i + 1
    }
    found
  }
}

fn build_test_core() -> Bytes {
  let out = bytebuf_new()
  emit_header(out)
  emit_type_section(out, 2, 1)
  emit_function_section(out, [
    0
  ])
  emit_export_section(out, "run", 0)
  let body = bytebuf_new()
  emit_local_get(body, 0)
  emit_local_get(body, 1)
  emit_i64_add(body)
  emit_code_section(out, [
    body
  ])
  bytebuf_to_bytes(out)
}

fn build_test_core_with_memory() -> Bytes {
  let out = bytebuf_new()
  emit_header(out)
  let type_content = bytebuf_new()
  bytebuf_push_vec_header(type_content, 2)
  emit_func_type_raw(type_content, [
    126,
    126,
    127
  ], [
    126
  ])
  emit_func_type_raw(type_content, [
    127,
    127,
    127,
    127
  ], [
    127
  ])
  bytebuf_push_section(out, 1, type_content)
  emit_function_section(out, [
    0,
    1
  ])
  emit_memory_section(out, 1)
  emit_exports_with_memory(out, [
    "handler",
    "cabi_realloc"
  ], [
    0,
    1
  ], "memory", 0)
  let h_body = bytebuf_new()
  emit_local_get(h_body, 0)
  let r_body = bytebuf_new()
  emit_i32_const(r_body, 0)
  emit_code_section(out, [
    h_body,
    r_body
  ])
  bytebuf_to_bytes(out)
}

fn build_test_core_with_memory_and_run() -> Bytes {
  let out = bytebuf_new()
  emit_header(out)
  let type_content = bytebuf_new()
  bytebuf_push_vec_header(type_content, 3)
  emit_func_type_raw(type_content, [
    126,
    126,
    127
  ], [
    126
  ])
  emit_func_type_raw(type_content, [
    127,
    127,
    127,
    127
  ], [
    127
  ])
  emit_func_type_raw(type_content, array_empty(), [
    126
  ])
  bytebuf_push_section(out, 1, type_content)
  emit_function_section(out, [
    0,
    1,
    2
  ])
  emit_memory_section(out, 1)
  emit_exports_with_memory(out, [
    "handler",
    "cabi_realloc",
    "_start"
  ], [
    0,
    1,
    2
  ], "memory", 0)
  let h_body = bytebuf_new()
  emit_local_get(h_body, 0)
  let r_body = bytebuf_new()
  emit_i32_const(r_body, 0)
  let run_body = bytebuf_new()
  emit_i64_const(run_body, 0)
  emit_code_section(out, [
    h_body,
    r_body,
    run_body
  ])
  bytebuf_to_bytes(out)
}

fn bytes_contains_seq(hay: Bytes, needle: Array[Int]) -> Int {
  let hay_len = Bytes::length(hay)
  let needle_len = Array::length(needle)
  if needle_len == 0 {
    1
  }
  else {
    let limit = hay_len - needle_len
    let mut found = 0
    let mut i = 0
    while (i <= limit) && (found == 0) {
      let mut ok = 1
      let mut j = 0
      while (j < needle_len) && (ok == 1) {
        if Bytes::get(hay, i + j) != Array::get(needle, j) {
          ok = 0
        }
        j = j + 1
      }
      if ok == 1 {
        found = 1
      }
      i = i + 1
    }
    found
  }
}

/// Core module that imports ("cm","task-return") and exports a void `run` which
/// hands a constant to task.return — the shape comp_emit_component_wasm_async wraps.
fn build_async_test_core() -> Bytes {
  let out = bytebuf_new()
  emit_header(out)
  let tc = bytebuf_new()
  bytebuf_push_vec_header(tc, 2)
  emit_func_type_raw(tc, [
    127
  ], array_empty())
  emit_func_type_raw(tc, array_empty(), array_empty())
  bytebuf_push_section(out, 1, tc)
  emit_import_section_func(out, "cm", "task-return", 0)
  emit_function_section(out, [
    1
  ])
  emit_export_section(out, "run", 1)
  let body = bytebuf_new()
  emit_i32_const(body, 42)
  bytebuf_push(body, 16)
  leb128_encode_u32(body, 0)
  emit_code_section(out, [
    body
  ])
  bytebuf_to_bytes(out)
}

/// Normally-compiled main entry: a nullary vibe fn lowers to (param i64)->i64.
fn build_main_i64_core() -> Bytes {
  let out = bytebuf_new()
  emit_header(out)
  let tc = bytebuf_new()
  bytebuf_push_vec_header(tc, 1)
  emit_func_type_raw(tc, [
    126
  ], [
    126
  ])
  bytebuf_push_section(out, 1, tc)
  emit_function_section(out, [
    0
  ])
  emit_export_section(out, "run", 0)
  let body = bytebuf_new()
  emit_i64_const(body, 42)
  emit_code_section(out, [
    body
  ])
  bytebuf_to_bytes(out)
}

/// Main entry that imports wasi_snapshot_preview1.fd_write (as every compiled
/// core does) and exports run : () -> i64 = 42.
fn build_main_i64_core_p1() -> Bytes {
  let out = bytebuf_new()
  emit_header(out)
  let tc = bytebuf_new()
  bytebuf_push_vec_header(tc, 2)
  emit_func_type_raw(tc, [
    127,
    127,
    127,
    127
  ], [
    127
  ])
  emit_func_type_raw(tc, [
    126
  ], [
    126
  ])
  bytebuf_push_section(out, 1, tc)
  let ic = bytebuf_new()
  bytebuf_push_vec_header(ic, 1)
  emit_name(ic, "wasi_snapshot_preview1")
  emit_name(ic, "fd_write")
  bytebuf_push(ic, 0)
  bytebuf_push(ic, 0)
  bytebuf_push_section(out, 2, ic)
  emit_function_section(out, [
    1
  ])
  emit_export_section(out, "run", 1)
  let body = bytebuf_new()
  emit_i64_const(body, 42)
  emit_code_section(out, [
    body
  ])
  bytebuf_to_bytes(out)
}

//# Misc

test "component async p1: wraps wasi-importing core with fd_write stub" {
  let main_core = build_main_i64_core_p1()
  let comp = comp_emit_component_wasm_async_trampolined_p1(main_core, "run", 120)
  assert(Bytes::get(comp, 0) == 0)
  assert(Bytes::get(comp, 4) == 13)
  assert(bytes_contains_seq(comp, [
    8,
    5,
    1,
    9,
    0,
    120,
    0
  ]) == 1)
  assert(bytes_contains_seq(comp, [
    7,
    5,
    1,
    67,
    0,
    0,
    120
  ]) == 1)
  assert(bytes_contains_seq(comp, [
    8,
    7,
    1,
    0,
    0,
    2,
    1,
    6,
    0
  ]) == 1)
  assert(component_bytes_contains(comp, "fd_write") == 1)
  assert(component_bytes_contains(comp, "wasi_snapshot_preview1") == 1)
}

test "component async trampolined: two-module compose with async lift" {
  let main_core = build_main_i64_core()
  let comp = comp_emit_component_wasm_async_trampolined(main_core, "run", 120)
  assert(Bytes::get(comp, 0) == 0)
  assert(Bytes::get(comp, 4) == 13)
  // task.return canon (s64=120): 08 05 01 09 00 78 00
  assert(bytes_contains_seq(comp, [
    8,
    5,
    1,
    9,
    0,
    120,
    0
  ]) == 1)
  // async functype () -> s64: 07 05 01 43 00 00 78
  assert(bytes_contains_seq(comp, [
    7,
    5,
    1,
    67,
    0,
    0,
    120
  ]) == 1)
  // async lift of core func 2 (trampoline run), type 0: 08 07 01 00 00 02 01 06 00
  assert(bytes_contains_seq(comp, [
    8,
    7,
    1,
    0,
    0,
    2,
    1,
    6,
    0
  ]) == 1)
  // trampoline imports task-return from "cm"
  assert(component_bytes_contains(comp, "task-return") == 1)
  assert(component_bytes_contains(comp, "run") == 1)
}

