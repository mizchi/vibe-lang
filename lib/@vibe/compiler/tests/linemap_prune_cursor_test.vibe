import @vibe/compiler/codegen/wasi {
  lc_pf_prune_module
}

fn linemap_test_leb(dst: Bytes, value: Int) -> Unit {
  let mut n = value
  while n >= 128 {
    Bytes::push(dst, (n&127)|128)
    n = n>>7
  }
  Bytes::push(dst, n)
}

fn linemap_test_bytes(values: Array[Int]) -> Bytes {
  let dst = Bytes::new()
  let mut i = 0
  while i < Array::length(values) {
    Bytes::push(dst, Array::get(values, i))
    i = i + 1
  }
  dst
}

fn linemap_test_section(dst: Bytes, id: Int, payload: Bytes) -> Unit {
  Bytes::push(dst, id)
  linemap_test_leb(dst, Bytes::length(payload))
  Bytes::blit(dst, payload, 0, Bytes::length(payload))
}

fn linemap_test_name(dst: Bytes, name: String) -> Unit {
  linemap_test_leb(dst, String::length(name))
  let mut i = 0
  while i < String::length(name) {
    Bytes::push(dst, String::char_code_at(name, i))
    i = i + 1
  }
}

fn linemap_test_row(dst: Bytes, fd: Int, od: Int, line: Int) -> Unit {
  linemap_test_leb(dst, fd)
  linemap_test_leb(dst, od)
  linemap_test_leb(dst, 0)
  linemap_test_leb(dst, line)
}

// A valid module with 128 unreachable bodies before the callee and entry.
// The three two-byte call indices shrink; rows touch each immediate boundary.
fn linemap_test_module(pruned: Bool, imported: Bool) -> Bytes {
  let dst = linemap_test_bytes([0, 97, 115, 109, 1, 0, 0, 0])
  linemap_test_section(dst, 1, linemap_test_bytes([1, 96, 0, 1, 127]))
  let base = if imported {
    1
  } else {
    0
  }
  if imported {
    let imports = Bytes::new()
    linemap_test_leb(imports, 1)
    linemap_test_name(imports, "env")
    linemap_test_name(imports, "value")
    Bytes::push(imports, 0)
    linemap_test_leb(imports, 0)
    linemap_test_section(dst, 2, imports)
  } else {
    ()
  }
  let count = if pruned {
    2
  } else {
    130
  }
  let functions = Bytes::new()
  linemap_test_leb(functions, count)
  let mut i = 0
  while i < count {
    linemap_test_leb(functions, 0)
    i = i + 1
  }
  linemap_test_section(dst, 3, functions)
  let exports = Bytes::new()
  linemap_test_leb(exports, 1)
  linemap_test_name(exports, "main")
  Bytes::push(exports, 0)
  linemap_test_leb(exports, base + count - 1)
  linemap_test_section(dst, 7, exports)
  let code = Bytes::new()
  linemap_test_leb(code, count)
  i = 0
  while i < count - 1 {
    let body = linemap_test_bytes([0, 65, 7, 11])
    linemap_test_leb(code, Bytes::length(body))
    Bytes::blit(code, body, 0, Bytes::length(body))
    i = i + 1
  }
  let entry = if pruned {
    linemap_test_bytes([0, 16, base, 26, 16, base, 26, 16, base, 11])
  } else {
    linemap_test_bytes([
      0,
      16,
      128 + base,
      1,
      26,
      16,
      128 + base,
      1,
      26,
      16,
      128 + base,
      1,
      11
    ])
  }
  linemap_test_leb(code, Bytes::length(entry))
  Bytes::blit(code, entry, 0, Bytes::length(entry))
  linemap_test_section(dst, 10, code)
  let rows = Bytes::new()
  linemap_test_name(rows, "vibe.linemap")
  Bytes::blit(rows, linemap_test_bytes([86, 76, 77, 49]), 0, 4)
  if imported {
    linemap_test_row(rows, 0, 0, 10)
    linemap_test_row(rows, 0, 3, 11)
  } else {
    ()
  }
  if pruned {
    linemap_test_row(rows, base, 0, 100)
  } else {
    // Dead function and out-of-range rows must not disturb the live cursor.
    linemap_test_row(rows, base + 127, 0, 90)
    linemap_test_row(rows, 1, 0, 100)
  }
  linemap_test_row(rows, 0, 1, 101)
  linemap_test_row(rows, 0, 2, 103)
  linemap_test_row(rows, 1, 0, 200)
  if pruned {
    let lines = [201, 202, 204, 205, 206, 208, 209, 210, 212]
    i = 0
    while i < Array::length(lines) {
      linemap_test_row(rows, 0, 1, Array::get(lines, i))
      i = i + 1
    }
  } else {
    i = 1
    while i <= 12 {
      linemap_test_row(rows, 0, 1, 200 + i)
      i = i + 1
    }
    linemap_test_row(rows, 11, 0, 999)
  }
  linemap_test_section(dst, 0, rows)
  dst
}

fn linemap_test_equal(a: Bytes, b: Bytes) -> Bool {
  let mut same = Bytes::length(a) == Bytes::length(b)
  let mut i = 0
  while same && i < Bytes::length(a) {
    same = Bytes::get(a, i) == Bytes::get(b, i)
    i = i + 1
  }
  same
}

test "prune preserves linemap boundaries and duplicate-row selection" {
  let input = linemap_test_module(false, false)
  let expected = linemap_test_module(true, false)
  let output = lc_pf_prune_module(input, "main", false)
  assert(Bytes::length(output) < Bytes::length(input))
  inspect(linemap_test_equal(output, expected), content = "true")
}

test "prune resets linemap offsets across imported and defined functions" {
  let input = linemap_test_module(false, true)
  let expected = linemap_test_module(true, true)
  let output = lc_pf_prune_module(input, "main", false)
  assert(Bytes::length(output) < Bytes::length(input))
  inspect(linemap_test_equal(output, expected), content = "true")
}
