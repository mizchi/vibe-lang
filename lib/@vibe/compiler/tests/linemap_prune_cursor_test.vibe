import @vibe/compiler/codegen/wasi {
  lc_pf_prune_module
}

fn linemap_test_leb(dst: Bytes, value: Int) -> Unit {
  let mut n = value
  while n >= 128 {
    Bytes::push(dst, value = (n&127)|128)
    n = n>>7
  }
  Bytes::push(dst, value = n)
}

fn linemap_test_bytes(_ values: Array[Int]) -> Bytes {
  let dst = Bytes::new()
  let mut i = 0
  while i < Array::length(values) {
    Bytes::push(dst, value = Array::get(values, at = i))
    i = i + 1
  }
  dst
}

fn linemap_test_section(dst: Bytes, id: Int, payload: Bytes) -> Unit {
  Bytes::push(dst, value = id)
  linemap_test_leb(dst = dst, value = Bytes::length(payload))
  Bytes::blit(dst, src = payload, start = 0, end = Bytes::length(payload))
}

fn linemap_test_name(dst: Bytes, name: String) -> Unit {
  linemap_test_leb(dst = dst, value = String::length(name))
  let mut i = 0
  while i < String::length(name) {
    Bytes::push(dst, value = String::char_code_at(name, at = i))
    i = i + 1
  }
}

fn linemap_test_row(dst: Bytes, fd: Int, od: Int, line: Int) -> Unit {
  linemap_test_leb(dst = dst, value = fd)
  linemap_test_leb(dst = dst, value = od)
  linemap_test_leb(dst = dst, value = 0)
  linemap_test_leb(dst = dst, value = line)
}

// A valid module with 128 unreachable bodies before the callee and entry.
// The three two-byte call indices shrink; rows touch each immediate boundary.
fn linemap_test_module(pruned: Bool, imported: Bool) -> Bytes {
  let dst = linemap_test_bytes([0, 97, 115, 109, 1, 0, 0, 0])
  linemap_test_section(dst = dst, id = 1, payload = linemap_test_bytes([1, 96, 0, 1, 127]))
  let base = if imported {
    1
  } else {
    0
  }
  if imported {
    let imports = Bytes::new()
    linemap_test_leb(dst = imports, value = 1)
    linemap_test_name(dst = imports, name = "env")
    linemap_test_name(dst = imports, name = "value")
    Bytes::push(imports, value = 0)
    linemap_test_leb(dst = imports, value = 0)
    linemap_test_section(dst = dst, id = 2, payload = imports)
  } else {
    ()
  }
  let count = if pruned {
    2
  } else {
    130
  }
  let functions = Bytes::new()
  linemap_test_leb(dst = functions, value = count)
  let mut i = 0
  while i < count {
    linemap_test_leb(dst = functions, value = 0)
    i = i + 1
  }
  linemap_test_section(dst = dst, id = 3, payload = functions)
  let exports = Bytes::new()
  linemap_test_leb(dst = exports, value = 1)
  linemap_test_name(dst = exports, name = "main")
  Bytes::push(exports, value = 0)
  linemap_test_leb(dst = exports, value = base + count - 1)
  linemap_test_section(dst = dst, id = 7, payload = exports)
  let code = Bytes::new()
  linemap_test_leb(dst = code, value = count)
  i = 0
  while i < count - 1 {
    let body = linemap_test_bytes([0, 65, 7, 11])
    linemap_test_leb(dst = code, value = Bytes::length(body))
    Bytes::blit(code, src = body, start = 0, end = Bytes::length(body))
    i = i + 1
  }
  let entry = if pruned {
    linemap_test_bytes([0, 16, base, 26, 16, base, 26, 16, base, 11])
  } else {
    linemap_test_bytes([
      0,
      16,
      128 + base,
      1,
      26,
      16,
      128 + base,
      1,
      26,
      16,
      128 + base,
      1,
      11
    ])
  }
  linemap_test_leb(dst = code, value = Bytes::length(entry))
  Bytes::blit(code, src = entry, start = 0, end = Bytes::length(entry))
  linemap_test_section(dst = dst, id = 10, payload = code)
  let rows = Bytes::new()
  linemap_test_name(dst = rows, name = "vibe.linemap")
  Bytes::blit(rows, src = linemap_test_bytes([86, 76, 77, 49]), start = 0, end = 4)
  if imported {
    linemap_test_row(dst = rows, fd = 0, od = 0, line = 10)
    linemap_test_row(dst = rows, fd = 0, od = 3, line = 11)
  } else {
    ()
  }
  if pruned {
    linemap_test_row(dst = rows, fd = base, od = 0, line = 100)
  } else {
    // Dead function and out-of-range rows must not disturb the live cursor.
    linemap_test_row(dst = rows, fd = base + 127, od = 0, line = 90)
    linemap_test_row(dst = rows, fd = 1, od = 0, line = 100)
  }
  linemap_test_row(dst = rows, fd = 0, od = 1, line = 101)
  linemap_test_row(dst = rows, fd = 0, od = 2, line = 103)
  linemap_test_row(dst = rows, fd = 1, od = 0, line = 200)
  if pruned {
    let lines = [201, 202, 204, 205, 206, 208, 209, 210, 212]
    i = 0
    while i < Array::length(lines) {
      linemap_test_row(dst = rows, fd = 0, od = 1, line = Array::get(lines, at = i))
      i = i + 1
    }
  } else {
    i = 1
    while i <= 12 {
      linemap_test_row(dst = rows, fd = 0, od = 1, line = 200 + i)
      i = i + 1
    }
    linemap_test_row(dst = rows, fd = 11, od = 0, line = 999)
  }
  linemap_test_section(dst = dst, id = 0, payload = rows)
  dst
}

fn linemap_test_equal(a: Bytes, b: Bytes) -> Bool {
  let mut same = Bytes::length(a) == Bytes::length(b)
  let mut i = 0
  while same && i < Bytes::length(a) {
    same = Bytes::get(a, at = i) == Bytes::get(b, at = i)
    i = i + 1
  }
  same
}

test "prune preserves linemap boundaries and duplicate-row selection" {
  let input = linemap_test_module(pruned = false, imported = false)
  let expected = linemap_test_module(pruned = true, imported = false)
  let output = lc_pf_prune_module(mod_bytes = input, entry_name = "main", exports_stripped = false)
  assert(Bytes::length(output) < Bytes::length(input))
  inspect(linemap_test_equal(a = output, b = expected), content = "true")
}

test "prune resets linemap offsets across imported and defined functions" {
  let input = linemap_test_module(pruned = false, imported = true)
  let expected = linemap_test_module(pruned = true, imported = true)
  let output = lc_pf_prune_module(mod_bytes = input, entry_name = "main", exports_stripped = false)
  assert(Bytes::length(output) < Bytes::length(input))
  inspect(linemap_test_equal(a = output, b = expected), content = "true")
}
