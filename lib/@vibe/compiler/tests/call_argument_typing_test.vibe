import @vibe/compiler/core {
  BindingOrigin,
  Expr,
  Subst,
  Type,
  TypeEnv,
  TypeExpr,
  call_placement_capture_begin,
  call_placement_capture_end,
  env_bind,
  env_bind_with_origin
}
import @vibe/compiler/checker {
  check_expr,
  checker_call_header_probe_begin,
  checker_call_header_probe_end,
  checker_capture_resolved_call_placement,
  checker_record_call_placement
}

fn labeled_call(_ value: Expr) -> Expr {
  ECall(EIdent("f", 7), [
    ELabeledArg("y", "", value),
    ELabeledArg("x", "", EInt(10))
  ], 7, [])
}

fn argument_errors(expr: Expr, env: TypeEnv) -> Array[String] {
  let errors: Array[String] = []
  let _ = check_expr(expr = expr, env = env, defs = [], s = SubstEmpty, c = 0, errors = errors, tytab = [
  ])
  errors
}

/// Auxiliary type probes cannot replace a published source placement with a
/// raw snapshot, either through a named call or resolved receiver dispatch.
test "type probes preserve a call's published placement" {
  let env = env_bind_with_origin(env = EnvEmpty, name = "f", ty = CtFn([CtInt], CtInt, None), origin = BindingOriginFunctionHeader([
    "x"
  ]))
  for resolved in [false, true] {
    let cell: Array[Int] = []
    let args = [ELabeledArg("x", "", EInt(3))]
    let callee = EIdent("f", 7)
    let call = ECall(callee, args, 7, cell)
    let errors: Array[String] = []
    call_placement_capture_begin()
    checker_record_call_placement(expr = call, env = env, errors = errors)
    let before = for item in cell {
      item
    }
    let saved = checker_call_header_probe_begin()
    if resolved {
      checker_capture_resolved_call_placement(callee = callee, args = args, offset = 7, cell = cell, env = env, name = "f")
    } else {
      checker_record_call_placement(expr = call, env = env, errors = errors)
    }
    checker_call_header_probe_end(saved)
    call_placement_capture_end()
    assert(Array::length(errors) == 0)
    assert(cell == before)
  }
}

/// Standalone call typing resolves source labels without preinstalled rows or
/// a precheck pass, using the declaration attached to the selected binding.
test "raw known labels check the type of their declared slot" {
  let env = env_bind_with_origin(env = EnvEmpty, name = "f", ty = CtFn([
    CtInt,
    CtString
  ], CtInt, None), origin = BindingOriginFunctionHeader(["x", "y"]))
  assert(Array::length(argument_errors(expr = labeled_call(EString("ok", 14)), env = env)) == 0)
  let errors = argument_errors(expr = labeled_call(EInt(3)), env = env)
  assert(Array::length(errors) > 0)
  assert(String::contains(String::join(errors, sep = "\n"), needle = "String"))
  assert(String::contains(String::join(errors, sep = "\n"), needle = "@0/2/4/0"))
}

/// A known outer label must not lend its typing policy to an opaque inner
/// call: the inner call is through a value, so its label is refused on its
/// own (ADR-0120 Phase 4b), not checked against the outer declaration.
test "a known outer label does not change an opaque nested call" {
  let env = env_bind(env = env_bind_with_origin(env = EnvEmpty, name = "f", ty = CtFn([
    CtInt
  ], CtInt, None), origin = BindingOriginFunctionHeader(["x"])), name = "g", ty = CtFn([
    CtInt
  ], CtInt, None))
  let inner = ECall(EIdent("g", 9), [
    ELabeledArg("whatever", "", EString("legacy", 15))
  ], 9, [])
  let outer = ECall(EIdent("f", 7), [ELabeledArg("x", "", inner)], 7, [])
  let errors = argument_errors(expr = outer, env = env)
  assert(Array::length(errors) == 1)
  assert(String::contains(String::join(errors, sep = "\n"), needle = "a call through the function value `g` passes its arguments by position: remove `whatever = `"))
}

/// Optional payloads are checked even when this expression has no prior rows.
test "optional labeled values retain their payload types" {
  let env = env_bind_with_origin(env = EnvEmpty, name = "f", ty = CtFn([
    CtOption(CtInt)
  ], CtInt, None), origin = BindingOriginFunctionHeader(["x?"]))
  assert(Array::length(argument_errors(expr = ECall(EIdent("f", 7), [
    ELabeledArg("x", "", EInt(3))
  ], 7, []), env = env)) == 0)
  assert(Array::length(argument_errors(expr = ECall(EIdent("f", 7), [
    ELabeledArg("x", "", EString("bad", 14))
  ], 7, []), env = env)) > 0)
}

/// The callback seed reaches the value below its label before its body types.
test "a labeled callback receives its expected parameter types" {
  let env = env_bind_with_origin(env = EnvEmpty, name = "f", ty = CtFn([
    CtFn([CtString], CtInt, None)
  ], CtInt, None), origin = BindingOriginFunctionHeader(["body"]))
  let callback = EFn([], [], [("p", None)], Some(TyName("Int")), None, EDot(EIdent("p", 20), "n", 20, 22))
  assert(Array::length(argument_errors(expr = ECall(EIdent("f", 7), [
    ELabeledArg("body", "", callback)
  ], 7, []), env = env)) > 0)
}

fn unresolved_source_call(name: String, args: Array[Expr]) -> Expr {
  ECall(EIdent(name, 7), args, 7, [])
}

/// Direct expression checking has no earlier name walk to reject an unknown
/// label. The selected binding's declaration must be authoritative here.
test "call typing rejects an unknown declared label without a precheck walk" {
  let env = env_bind_with_origin(env = EnvEmpty, name = "f", ty = CtFn([CtInt], CtInt, None), origin = BindingOriginFunctionHeader([
    "x"
  ]))
  let errors = argument_errors(expr = unresolved_source_call(name = "f", args = [
    ELabeledArg("typo", "", EInt(3))
  ]), env = env)
  assert(String::contains(String::join(errors, sep = "\n"), needle = "unknown labeled argument `typo`"))
}

/// A builtin's fixed labels are checked where binding resolution says that
/// this is the builtin, without a second syntactic claimed-name census.
test "call typing rejects a reordered builtin label without a precheck walk" {
  let expr = unresolved_source_call(name = "Fs::copy", args = [
    ELabeledArg("to", "", EString("left", 14)),
    EString("right", 30)
  ])
  let errors = argument_errors(expr = expr, env = EnvEmpty)
  assert(String::contains(String::join(errors, sep = "\n"), needle = "out of parameter order"))
}

/// A call through a value is positional (ADR-0120 Phase 4b), so a mixed call
/// is refused for its label.
test "call typing rejects mixed argument modes on an opaque value" {
  let env = env_bind(env = EnvEmpty, name = "f", ty = CtFn([CtInt, CtInt], CtInt, None))
  let errors = argument_errors(expr = unresolved_source_call(name = "f", args = [
    EInt(1),
    ELabeledArg("whatever", "", EInt(2))
  ]), env = env)
  assert(String::contains(String::join(errors, sep = "\n"), needle = "a call through the function value `f` passes its arguments by position: remove `whatever = `"))
}

/// A written None must not acquire omission semantics at a declaration that
/// carries a default; only that resolved binding supplies the default fact.
test "call typing rejects a written None for the resolved defaulted slot" {
  let env = env_bind_with_origin(env = EnvEmpty, name = "f", ty = CtFn([
    CtOption(CtInt)
  ], CtInt, None), origin = BindingOriginDefaultedFunctionHeader(["x?"], [true]))
  let errors = argument_errors(expr = unresolved_source_call(name = "f", args = [
    ELabeledArg("x", "", EIdent("None", 14))
  ]), env = env)
  assert(String::contains(String::join(errors, sep = "\n"), needle = "is a written `None` / `Some(..)`"))
}

/// Declaration-only defaults cannot silently escape behind an ordinary
/// function type through a value reference, even in the expression API.
test "value typing refuses escaping a resolved defaulted declaration" {
  let env = env_bind_with_origin(env = EnvEmpty, name = "f", ty = CtFn([
    CtOption(CtInt)
  ], CtInt, None), origin = BindingOriginDefaultedFunctionHeader(["x?"], [true]))
  let errors = argument_errors(expr = EIdent("f", 7), env = env)
  assert(String::contains(String::join(errors, sep = "\n"), needle = "has parameter defaults"))
}

/// An uncertain mutable binding is a value: accepting an identity placement
/// for its labels would swap values, so they are refused (ADR-0120 Phase 4b).
test "call typing refuses labels on an uncertain mutable declaration" {
  let env = env_bind_with_origin(env = EnvEmpty, name = "f", ty = CtFn([
    CtInt,
    CtInt
  ], CtInt, None), origin = BindingOriginUncertainFunctionHeader)
  let errors = argument_errors(expr = unresolved_source_call(name = "f", args = [
    ELabeledArg("x", "", EInt(1)),
    ELabeledArg("y", "", EInt(2))
  ]), env = env)
  assert(String::contains(String::join(errors, sep = "\n"), needle = "a call through the function value `f` passes its arguments by position: remove `x = `, `y = `"))
}

/// Reusing source in a new check cannot reuse the old binding's slot mapping.
test "standalone checks recapture reused source against the current binding" {
  let expr = labeled_call(EString("ok", 14))
  let original = env_bind_with_origin(env = EnvEmpty, name = "f", ty = CtFn([
    CtInt,
    CtString
  ], CtInt, None), origin = BindingOriginFunctionHeader(["x", "y"]))
  let different = env_bind_with_origin(env = EnvEmpty, name = "f", ty = CtFn([
    CtInt,
    CtString
  ], CtInt, None), origin = BindingOriginFunctionHeader(["y", "x"]))
  let opaque = env_bind(env = EnvEmpty, name = "f", ty = CtFn([CtInt, CtString], CtInt, None))
  assert(Array::length(argument_errors(expr = expr, env = original)) == 0)
  assert(Array::length(argument_errors(expr = expr, env = different)) > 0)
  assert(Array::length(argument_errors(expr = expr, env = opaque)) > 0)
  assert(Array::length(argument_errors(expr = expr, env = original)) == 0)
}

/// Earlier diagnostics must not turn a later valid optional call into a false
/// arity error or suppress a later call's own unknown-label diagnostic.
test "placement validation uses each call's own error boundary" {
  let env = env_bind_with_origin(env = EnvEmpty, name = "f", ty = CtFn([
    CtOption(CtInt)
  ], CtInt, None), origin = BindingOriginFunctionHeader(["x?"]))
  let errors = ["previous diagnostic"]
  let _ = check_expr(expr = ECall(EIdent("f", 7), [], 7, []), env = env, defs = [
  ], s = SubstEmpty, c = 0, errors = errors, tytab = [])
  assert(Array::length(errors) == 1)
  let _ = check_expr(expr = ECall(EIdent("f", 7), [
    ELabeledArg("typo", "", EInt(1))
  ], 7, []), env = env, defs = [], s = SubstEmpty, c = 0, errors = errors, tytab = [
  ])
  assert(String::contains(String::join(errors, sep = "\n"), needle = "unknown labeled argument `typo`"))
}
