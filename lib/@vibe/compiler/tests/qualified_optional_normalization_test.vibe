import @vibe/compiler/core {
  Expr, Stmt, Type, TypeEnv, env_bind, restore_call_placements
}
import @vibe/compiler/checker {
  check_program_with_projected_import_env_lowering_placements
}
import @vibe/compiler/normalize {
  lower_checked_call_placements
}
import @vibe/compiler/syntax {
  print_program
}
import @vibe/parser {
  lex_with_offsets, parse_program_located
}

fn parsed(source: String) -> Array[Stmt] with Exception {
  let (tokens, starts, _) = lex_with_offsets(source)
  parse_program_located(tokens, starts, source)
}

fn imported_env() -> TypeEnv {
  let pick = env_bind(env_bind(EnvEmpty, "helper.pick", CtFn([
    CtInt,
    CtOption(CtInt)
  ], CtInt, None)), "#params:helper.pick", CtRecord([
    ("x", CtUnknown),
    ("ignored?", CtUnknown)
  ]))
  env_bind(env_bind(pick, "helper.digits", CtFn([
    CtOption(CtInt),
    CtOption(CtInt),
    CtOption(CtInt)
  ], CtInt, None)), "#params:helper.digits", CtRecord([
    ("a?", CtUnknown),
    ("b?", CtUnknown),
    ("c?", CtUnknown)
  ]))
}

fn expect_normalized(source: String, expected: String) -> Unit with Exception {
  let (_, _, _, _, placements) = check_program_with_projected_import_env_lowering_placements(parsed(source), imported_env())
  let stmts = parsed(source)
  restore_call_placements(stmts, placements)
  lower_checked_call_placements(stmts, true)
  assert(print_program(stmts) == print_program(parsed(expected)))
}

fn label_error(source: String) -> String with Exception {
  handle {
    let _ = check_program_with_projected_import_env_lowering_placements(parsed(source), imported_env())
    ""
  } with { Exception::Throw(message) => message }
}

/// Namespace calls have no implicit receiver, even after optional filling.
test "qualified optional calls without labels use checker placements" {
  expect_normalized("fn main() -> Int { helper.pick(10) }", "fn main() -> Int { helper.pick(10, None) }")
  expect_normalized("fn main() -> Int { helper.digits() }", "fn main() -> Int { helper.digits(None, None, None) }")
  expect_normalized("fn main() -> Int { helper.pick(10, 3) }", "fn main() -> Int { helper.pick(10, Some(3)) }")
}

/// Source labels select declared slots; explicit Options are not wrapped twice.
test "qualified labels and explicit Options survive placement transport" {
  expect_normalized("fn main() -> Int { helper.digits(b = 4, a = 5) }", "fn main() -> Int { helper.digits(Some(5), Some(4), None) }")
  expect_normalized("fn main() -> Int { helper.pick(ignored = 3, x = 10) }", "fn main() -> Int { helper.pick(10, Some(3)) }")
  expect_normalized("fn main() -> Int { helper.pick(10, None) }", "fn main() -> Int { helper.pick(10, None) }")
  expect_normalized("fn main() -> Int { helper.pick(10, Some(3)) }", "fn main() -> Int { helper.pick(10, Some(3)) }")
}

/// These diagnostics come from the resolved namespace binding's call typing.
test "qualified unknown repeated and mixed labels are diagnosed" {
  assert(String::contains(label_error("fn main() -> Int { helper.pick(typo = 10) }"), "unknown labeled argument `typo`"))
  assert(String::contains(label_error("fn main() -> Int { helper.pick(x = 10, x = 3) }"), "out of declared parameter order"))
  assert(String::contains(label_error("fn main() -> Int { helper.pick(10, ignored = 3) }"), "mixes positional and labeled arguments"))
}

/// A local receiver shadows the namespace and does not inherit its labels.
test "a shadowed namespace cannot supply a field call's labels" {
  let message = label_error("fn main(helper: Int) -> Int { helper.pick(typo = 10) }")
  assert(String::contains(message, "no method `pick`"))
  assert(!String::contains(message, "unknown labeled argument `typo`"))
}
