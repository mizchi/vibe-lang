import @vibe/compiler/core {
  Expr, Stmt, Type, TypeEnv, env_bind, restore_call_placements
}
import @vibe/compiler/checker {
  check_program_with_projected_import_env_lowering_placements
}
import @vibe/compiler/normalize {
  lower_checked_call_placements
}
import @vibe/compiler/syntax {
  print_program
}
import @vibe/parser {
  lex_with_offsets, parse_program_located
}

fn parsed(_ source: String) -> Array[Stmt] with Exception {
  let (tokens, starts, _) = lex_with_offsets(source)
  parse_program_located(tokens = tokens, starts = starts, source = source)
}

fn imported_env() -> TypeEnv {
  let pick = env_bind(env = env_bind(env = EnvEmpty, name = "helper.pick", ty = CtFn([
    CtInt,
    CtOption(CtInt)
  ], CtInt, None)), name = "#params:helper.pick", ty = CtRecord([
    ("x", CtUnknown),
    ("ignored?", CtUnknown)
  ]))
  env_bind(env = env_bind(env = pick, name = "helper.digits", ty = CtFn([
    CtOption(CtInt),
    CtOption(CtInt),
    CtOption(CtInt)
  ], CtInt, None)), name = "#params:helper.digits", ty = CtRecord([
    ("a?", CtUnknown),
    ("b?", CtUnknown),
    ("c?", CtUnknown)
  ]))
}

fn expect_normalized(source: String, expected: String) -> Unit with Exception {
  let (_, _, _, _, placements) = check_program_with_projected_import_env_lowering_placements(stmts = parsed(source), initial_env = imported_env(), checked_error_row = false)
  let stmts = parsed(source)
  restore_call_placements(stmts = stmts, rows = placements)
  lower_checked_call_placements(stmts = stmts, require_checked = true)
  assert(print_program(stmts) == print_program(parsed(expected)))
}

fn label_error(_ source: String) -> String with Exception {
  handle {
    let _ = check_program_with_projected_import_env_lowering_placements(stmts = parsed(source), initial_env = imported_env(), checked_error_row = false)
    ""
  } with { Exception::Throw(message) => message }
}

/// Namespace calls have no implicit receiver, even after optional filling.
test "qualified optional calls use checker placements" {
  expect_normalized(source = "fn main() -> Int { helper.pick(x = 10) }", expected = "fn main() -> Int { helper.pick(10, None) }")
  expect_normalized(source = "fn main() -> Int { helper.digits() }", expected = "fn main() -> Int { helper.digits(None, None, None) }")
  expect_normalized(source = "fn main() -> Int { helper.pick(x = 10, ignored = 3) }", expected = "fn main() -> Int { helper.pick(10, Some(3)) }")
}

/// A seeded `#params:` header is a declaration, so its calls label their
/// arguments exactly as a filesystem import's would (ADR-0120 Phase 4).
test "an unlabeled call to a seeded import header is refused" {
  assert(String::contains(label_error("fn main() -> Int { helper.pick(10) }"), needle = "label the arguments of helper.pick: write `x = ` before argument 1"))
}

/// Source labels select declared slots; explicit Options are not wrapped twice.
test "qualified labels and explicit Options survive placement transport" {
  expect_normalized(source = "fn main() -> Int { helper.digits(a = 5, b = 4) }", expected = "fn main() -> Int { helper.digits(Some(5), Some(4), None) }")
  expect_normalized(source = "fn main() -> Int { helper.pick(x = 10, ignored = 3) }", expected = "fn main() -> Int { helper.pick(10, Some(3)) }")
  expect_normalized(source = "fn main() -> Int { helper.pick(x = 10, ignored = None) }", expected = "fn main() -> Int { helper.pick(10, None) }")
  expect_normalized(source = "fn main() -> Int { helper.pick(x = 10, ignored = Some(3)) }", expected = "fn main() -> Int { helper.pick(10, Some(3)) }")
}

/// These diagnostics come from the resolved namespace binding's call typing.
test "qualified unknown repeated and mixed labels are diagnosed" {
  assert(String::contains(label_error("fn main() -> Int { helper.pick(typo = 10) }"), needle = "unknown labeled argument `typo`"))
  assert(String::contains(label_error("fn main() -> Int { helper.pick(x = 10, x = 3) }"), needle = "out of declared parameter order"))
  assert(String::contains(label_error("fn main() -> Int { helper.pick(10, ignored = 3) }"), needle = "label the arguments of helper.pick: write `x = ` before argument 1"))
}

/// A local receiver shadows the namespace and does not inherit its labels.
test "a shadowed namespace cannot supply a field call's labels" {
  let message = label_error("fn main(helper: Int) -> Int { helper.pick(typo = 10) }")
  assert(String::contains(message, needle = "no method `pick`"))
  assert(!String::contains(message, needle = "unknown labeled argument `typo`"))
}
