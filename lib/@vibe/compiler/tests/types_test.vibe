//# Imports

import @vibe/core {
  array_empty
}

import @vibe/compiler/core {
  Type,
  TypeDef,
  TypeEnv,
  TypeExpr,
  collect_tvars,
  env_bind,
  env_bind_all,
  env_cache,
  env_flat_bindings,
  env_lookup,
  env_lookup_flat,
  type_to_string,
  types_compatible,
  types_equal
}

let _types_test_no_methods: Array[(String, Array[TypeExpr], TypeExpr)] = ArrayBuilder::freeze(ArrayBuilder::new())

//# Functions

fn empty_defs() -> Array[TypeDef] {
  array_empty()
}

//# Misc

test "env_lookup found" {
  let env = env_bind(EnvEmpty, "x", CtInt)
  let result = env_lookup(env, "x")
  match result {
    Some(t) => assert(types_equal(t, CtInt)),
    None => assert(false)
  }
}

test "env_lookup not found" {
  let result = env_lookup(EnvEmpty, "x")
  match result {
    Some(_) => assert(false),
    None => assert(true)
  }
}

test "env_lookup shadows outer" {
  let env = env_bind(EnvEmpty, "x", CtInt)
  let env2 = env_bind(env, "x", CtString)
  let result = env_lookup(env2, "x")
  match result {
    Some(t) => assert(types_equal(t, CtString)),
    None => assert(false)
  }
}

test "env_lookup handles flat env" {
  let env = EnvFlat([
    ("x", CtString),
    ("x", CtInt)
  ])
  match env_lookup(env, "x") {
    Some(t) => assert(types_equal(t, CtString)),
    None => assert(false)
  }
}

test "env_bind shadows flat env" {
  let flat = EnvFlat([
    ("x", CtInt)
  ])
  let env = env_bind(flat, "x", CtString)
  match env_lookup(env, "x") {
    Some(t) => assert(types_equal(t, CtString)),
    None => assert(false)
  }
}

test "env_bind_all" {
  let env = env_bind_all(EnvEmpty, [
    ("a", CtInt),
    ("b", CtString)
  ])
  match env_lookup(env, "a") {
    Some(t) => assert(types_equal(t, CtInt)),
    None => assert(false)
  }
  match env_lookup(env, "b") {
    Some(t) => assert(types_equal(t, CtString)),
    None => assert(false)
  }
}

test "env_lookup_flat shadows like env_lookup" {
  let env = env_bind(env_bind(EnvEmpty, "x", CtInt), "x", CtString)
  let no_supers = array_empty()
  let env_with_trait = EnvTraitDef("Show", no_supers, false, _types_test_no_methods, env, array_empty())
  let flat = env_flat_bindings(env_with_trait)
  match env_lookup_flat(flat, "x") {
    Some(t) => assert(types_equal(t, CtString)),
    None => assert(false)
  }
}

test "env_lookup_flat not found" {
  let flat = env_flat_bindings(EnvEmpty)
  match env_lookup_flat(flat, "missing") {
    Some(_) => assert(false),
    None => assert(true)
  }
}

test "env_cache handles empty env" {
  match env_cache(EnvEmpty) {
    EnvEmpty => assert(true),
    _ => assert(false)
  }
}

test "env_bind keeps cached env lookup path" {
  let base = env_cache(env_bind(EnvEmpty, "base", CtInt))
  let env = env_bind(base, "x", CtString)
  match env {
    EnvCached(_, _, _) => assert(true),
    _ => assert(false)
  }
  match env_lookup(env, "x") {
    Some(t) => assert(types_equal(t, CtString)),
    None => assert(false)
  }
}

test "env_bind over cached env remains visible to flat lookup" {
  let base = env_cache(env_bind(EnvEmpty, "x", CtInt))
  let env = env_bind(base, "x", CtString)
  let flat = env_flat_bindings(env)
  match env_lookup_flat(flat, "x") {
    Some(t) => assert(types_equal(t, CtString)),
    None => assert(false)
  }
}

test "types_compatible with CtUnknown" {
  assert(types_compatible(CtUnknown, CtInt))
  assert(types_compatible(CtInt, CtUnknown))
  assert(types_compatible(CtUnknown, CtUnknown))
}

test "types_compatible same types" {
  assert(types_compatible(CtInt, CtInt))
  assert(types_compatible(CtString, CtString))
}

test "types_compatible different types" {
  assert(not(types_compatible(CtInt, CtString)))
  assert(not(types_compatible(CtBool, CtDouble)))
}

test "types_equal arrays" {
  assert(types_equal(CtArray(CtInt), CtArray(CtInt)))
  assert(not(types_equal(CtArray(CtInt), CtArray(CtString))))
}

test "types_equal fn types" {
  assert(types_equal(CtFn([
    CtInt
  ], CtString, None), CtFn([
    CtInt
  ], CtString, None)))
  assert(not(types_equal(CtFn([
    CtInt
  ], CtString, None), CtFn([
    CtInt
  ], CtString, Some("Error")))))
  assert(not(types_equal(CtFn([
    CtInt
  ], CtString, None), CtFn([
    CtBool
  ], CtString, None))))
}

test "types_equal tuples" {
  assert(types_equal(CtTuple([
    CtInt,
    CtBool
  ]), CtTuple([
    CtInt,
    CtBool
  ])))
  assert(not(types_equal(CtTuple([
    CtInt,
    CtBool
  ]), CtTuple([
    CtInt,
    CtString
  ]))))
  assert(not(types_equal(CtTuple([
    CtInt
  ]), CtTuple([
    CtInt,
    CtBool
  ]))))
}

test "type_to_string primitives" {
  assert(type_to_string(CtInt) == "Int")
  assert(type_to_string(CtString) == "String")
  assert(type_to_string(CtBool) == "Bool")
  assert(type_to_string(CtUnit) == "()")
  assert(type_to_string(CtUnknown) == "?")
}

test "type_to_string composite" {
  assert(type_to_string(CtArray(CtInt)) == "Array[Int]")
  assert(type_to_string(CtOption(CtString)) == "Option[String]")
  assert(type_to_string(CtNamed("Result", [
    CtInt,
    CtString
  ])) == "Result[Int, String]")
  assert(type_to_string(CtTuple([
    CtInt,
    CtBool
  ])) == "(Int, Bool)")
  assert(type_to_string(CtFn([
    CtInt
  ], CtString, None)) == "(Int) -> String")
  assert(type_to_string(CtFn([
    CtInt
  ], CtString, Some("Error"))) == "(Int) -> String with {Error}")
  assert(type_to_string(CtForAll([
    0
  ], array_empty(), CtVar(0))) == "forall ?t0. ?t0")
}

test "collect_tvars deduplicates in first-seen order" {
  let ty = CtTuple([
    CtVar(2),
    CtArray(CtVar(1)),
    CtVar(2),
    CtFn([
      CtVar(3),
      CtVar(1)
    ], CtVar(4), None)
  ])
  let vars = collect_tvars(ty)
  assert(eq(Array::length(vars), 4))
  assert(eq(Array::get(vars, 0), 2))
  assert(eq(Array::get(vars, 1), 1))
  assert(eq(Array::get(vars, 2), 3))
  assert(eq(Array::get(vars, 3), 4))
}
