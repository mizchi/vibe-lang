let _types_test_no_methods: Array[(String, Array[TypeExpr], TypeExpr)] = ArrayBuilder::freeze(ArrayBuilder::new())

//# Functions

fn empty_defs() -> Array[TypeDef] {
  array_empty()
}

test "declared StringMap shadows the builtin structural spelling" {
  let defs = [
    TDStruct("StringMap", [("value", CtNamed("T", array_empty()))], ["value"], [
      "T"
    ])
  ]
  let resolved = resolve_type_expr_core_shadowed(TyApp("StringMap", [
    TyName("Int")
  ]), defs, array_empty())
  assert(types_equal(resolved, CtNamed("StringMap", [CtInt])))
}

test "#2276 round 18: a TDEffect named StringMap also shadows the builtin" {
  // `seed_imported_type_defs` puts an IMPORTED effect into `defs` as a
  // `TDEffect`, and `resolve_type_expr_core_shadowed` consults `defs` before
  // taking the builtin branch. So `import ./dep.vibe { effect Box as
  // StringMap }` makes the annotation nominal in the checker, which the WIT
  // scan has to agree with or it publishes the builtin ABI for another type.
  let defs = [TDEffect("StringMap", array_empty(), array_empty())]
  let resolved = resolve_type_expr_core_shadowed(TyApp("StringMap", [
    TyName("Int")
  ]), defs, array_empty())
  assert(types_equal(resolved, CtNamed("StringMap", [CtInt])))
}

test "#2276 round 19: a TDEffectSet named StringMap also shadows the builtin" {
  // True for an IMPORTED effectset, which `seed_imported_type_defs` puts into
  // `defs`. A LOCAL `effectset` declaration does NOT reach `defs` -- nothing
  // pushes a `TDEffectSet` for one -- so it resolves to the builtin instead;
  // that asymmetry is why `wit_stmts_declare_type` has no `SEffectSet` arm.
  let defs = [TDEffectSet("StringMap", array_empty())]
  let resolved = resolve_type_expr_core_shadowed(TyApp("StringMap", [
    TyName("Int")
  ]), defs, array_empty())
  assert(types_equal(resolved, CtNamed("StringMap", [CtInt])))
}

test "#2276 round 20: a TDEnum named StringMap also shadows the builtin" {
  // What a `suberror StringMap(..)` declaration claims. `resolve_type_expr`
  // gives `CtEnum` for a declared enum, which is nominal either way -- the
  // point is that it is NOT the builtin map.
  let defs = [TDEnum("StringMap", array_empty(), array_empty())]
  let resolved = resolve_type_expr_core_shadowed(TyApp("StringMap", [
    TyName("Int")
  ]), defs, array_empty())
  assert(!types_equal(resolved, CtNamed("Map", [CtString, CtInt])))
}

test "#2276 round 18: with no typedef the builtin spelling still resolves" {
  // The control for the row above: nothing in `defs` owns the name, so
  // `StringMap[Int]` is the builtin `Map[String, Int]`.
  let resolved = resolve_type_expr_core_shadowed(TyApp("StringMap", [
    TyName("Int")
  ]), empty_defs(), array_empty())
  assert(types_equal(resolved, CtNamed("Map", [CtString, CtInt])))
}

fn mut_escape_text(env: TypeEnv, name: String) -> String {
  match env_mut_escape(env, name) {
    Some(true) => "true",
    Some(false) => "false",
    None => "none"
  }
}

//# Misc

test "env_lookup found" {
  let env = env_bind(EnvEmpty, "x", CtInt)
  let result = env_lookup(env, "x")
  match result {
    Some(t) => assert(types_equal(t, CtInt)),
    None => assert(false)
  }
}

test "env_lookup not found" {
  let result = env_lookup(EnvEmpty, "x")
  match result {
    Some(_) => assert(false),
    None => assert(true)
  }
}

test "single-binding cache preserves lookup and shadowing" {
  let env = env_bind(EnvEmpty, "outer", CtInt)
  let cached = env_cache_binding(env, "sentinel", CtChar)
  inspect(match env_lookup(cached, "sentinel") {
    Some(ty) => type_to_string(ty),
    None => "None"
  }, "Char")
  inspect(match env_lookup(cached, "outer") {
    Some(ty) => type_to_string(ty),
    None => "None"
  }, "Int")
  let shadowed = env_bind(cached, "sentinel", CtBool)
  inspect(match env_lookup(shadowed, "sentinel") {
    Some(ty) => type_to_string(ty),
    None => "None"
  }, "Bool")
}

test "env_lookup shadows outer" {
  let env = env_bind(EnvEmpty, "x", CtInt)
  let env2 = env_bind(env, "x", CtString)
  let result = env_lookup(env2, "x")
  match result {
    Some(t) => assert(types_equal(t, CtString)),
    None => assert(false)
  }
}

test "env_lookup handles flat env" {
  let env = EnvFlat([
    ("x", env_value_binding(CtString)),
    ("x", env_value_binding(CtInt))
  ])
  match env_lookup(env, "x") {
    Some(t) => assert(types_equal(t, CtString)),
    None => assert(false)
  }
}

test "env_bind shadows flat env" {
  let flat = EnvFlat([("x", env_value_binding(CtInt))])
  let env = env_bind(flat, "x", CtString)
  match env_lookup(env, "x") {
    Some(t) => assert(types_equal(t, CtString)),
    None => assert(false)
  }
}

test "env_bind_all" {
  let env = env_bind_all(EnvEmpty, [("a", CtInt), ("b", CtString)])
  match env_lookup(env, "a") {
    Some(t) => assert(types_equal(t, CtInt)),
    None => assert(false)
  }
  match env_lookup(env, "b") {
    Some(t) => assert(types_equal(t, CtString)),
    None => assert(false)
  }
}

test "env_lookup_flat shadows like env_lookup" {
  let env = env_bind(env_bind(EnvEmpty, "x", CtInt), "x", CtString)
  let no_supers = array_empty()
  let env_with_trait = EnvTraitDef("Show", no_supers, false, _types_test_no_methods, env, array_empty(), array_empty())
  let flat = env_flat_bindings(env_with_trait)
  match env_lookup_flat(flat, "x") {
    Some(t) => assert(types_equal(t, CtString)),
    None => assert(false)
  }
}

test "env_lookup_flat not found" {
  let flat = env_flat_bindings(EnvEmpty)
  match env_lookup_flat(flat, "missing") {
    Some(_) => assert(false),
    None => assert(true)
  }
}

test "env_cache handles empty env" {
  match env_cache(EnvEmpty) {
    EnvEmpty => assert(true),
    _ => assert(false)
  }
}

test "env_bind keeps cached env lookup path" {
  // Non-shadowing binds tuck BEHIND a head cache so hot lookups of cached
  // (imported) names keep hitting the index first. #2390 measured the
  // always-in-front alternative and it regressed ~+20% on
  // env_lookup_binding; head adjacency is a deliberate property.
  let base = env_cache(env_bind(EnvEmpty, "base", CtInt))
  let env = env_bind(base, "x", CtString)
  match env {
    EnvCached(_, _, _) => assert(true),
    _ => assert(false)
  }
  inspect(match env_lookup(env, "x") {
    Some(t) => type_to_string(t),
    None => "absent"
  }, "String")
  inspect(match env_lookup(env, "base") {
    Some(t) => type_to_string(t),
    None => "absent"
  }, "Int")
}

test "a region accelerator recaches through env_cache (real entry shape)" {
  // The checker's region entry chain-binds the real `#active_region`
  // skolem and puts env_cache_binding's accelerator OVER it -- the arrays
  // are a mirror, never the only copy. That is what lets env_cache skip
  // inner cache arrays (the chain is the truth; a stale array must never
  // out-shadow a refreshed chain entry -- #2390 review). Pin the contract:
  // an outer env_cache over the real shape keeps answering the real
  // skolem, not the negative CtUnit marker it seeds for cache-less envs.
  let region_ty = CtNamed("#region_r", array_empty())
  let chain = env_bind(env_bind(EnvEmpty, "v", CtInt), "#active_region", region_ty)
  let inner = env_cache_binding(chain, "#active_region", region_ty)
  let outer = env_cache(inner)
  inspect(match env_lookup(outer, "#active_region") {
    Some(t) => type_to_string(t),
    None => "absent"
  }, "#region_r")
  inspect(match env_lookup(outer, "v") {
    Some(t) => type_to_string(t),
    None => "absent"
  }, "Int")
}

test "env_bind shadowing a cached name wins env_lookup (#1583)" {
  // The cached index holds "x" -> CtInt; a NEWER inner binding of the same
  // name (a parameter, a let) must shadow it. Before #1583 env_bind tucked
  // the new binding under the cache head and env_lookup answered from the
  // index first, so the older cached entry won silently.
  let base = env_cache(env_bind(EnvEmpty, "x", CtInt))
  let env = env_bind(base, "x", CtString)
  match env_lookup(env, "x") {
    Some(t) => assert(types_equal(t, CtString)),
    None => assert(false)
  }
  // The cached fallback still answers for non-shadowed names.
  match env_lookup(env_bind(base, "y", CtBool), "x") {
    Some(t) => assert(types_equal(t, CtInt)),
    None => assert(false)
  }
}

test "env_bind over cached env remains visible to flat lookup" {
  let base = env_cache(env_bind(EnvEmpty, "x", CtInt))
  let env = env_bind(base, "x", CtString)
  let flat = env_flat_bindings(env)
  match env_lookup_flat(flat, "x") {
    Some(t) => assert(types_equal(t, CtString)),
    None => assert(false)
  }
}

test "env_cache preserves visible true and false mutable escape facts" {
  let true_env = env_cache(env_bind_mut(EnvEmpty, "x", CtInt, true))
  let false_env = env_cache(env_bind_mut(EnvEmpty, "x", CtInt, false))
  inspect(mut_escape_text(true_env, "x"), "true")
  inspect(mut_escape_text(false_env, "x"), "false")
  inspect(mut_escape_text(true_env, "missing"), "none")
}

test "env_cache preserves mutable and immutable shadow order" {
  let outer_mut = env_bind_mut(EnvEmpty, "x", CtInt, true)
  let immutable_over_mutable = env_cache(env_bind(outer_mut, "x", CtString))
  inspect(mut_escape_text(immutable_over_mutable, "x"), "none")
  let outer_immutable = env_bind(EnvEmpty, "x", CtInt)
  let mutable_over_immutable = env_cache(env_bind_mut(outer_immutable, "x", CtString, false))
  inspect(mut_escape_text(mutable_over_immutable, "x"), "false")
  let duplicate_mutable = env_cache(env_bind_mut(env_bind_mut(EnvEmpty, "x", CtInt, false), "x", CtString, true))
  inspect(mut_escape_text(duplicate_mutable, "x"), "true")
}

test "env_bind before and after cache preserves mutable shadowing" {
  let cached_mutable = env_cache(env_bind_mut(EnvEmpty, "x", CtInt, true))
  let immutable_after_cache = env_bind(cached_mutable, "x", CtString)
  inspect(mut_escape_text(immutable_after_cache, "x"), "none")
  let cached_immutable = env_cache(env_bind(EnvEmpty, "x", CtInt))
  let mutable_after_cache = env_bind_mut(cached_immutable, "x", CtString, false)
  inspect(mut_escape_text(mutable_after_cache, "x"), "false")
  inspect(mut_escape_text(env_cache(mutable_after_cache), "x"), "false")
}

test "recache retains mutable facts" {
  let originated = env_bind_with_origin(EnvEmpty, "imported", CtChar, BindingOriginModuleExport("/dep.vibe", "source_imported"))
  let twice_cached = env_cache(env_cache(env_bind_mut(originated, "cell", CtInt, true)))
  inspect(mut_escape_text(twice_cached, "cell"), "true")
}

test "origin type survives repeated env_cache" {
  let originated = env_bind_with_origin(EnvEmpty, "imported", CtChar, BindingOriginModuleExport("/dep.vibe", "source_imported"))
  let twice_cached = env_cache(env_cache(env_bind_mut(originated, "cell", CtInt, true)))
  match env_lookup_binding(twice_cached, "imported") {
    Some(binding) => inspect(type_to_string(binding.ty), "Char"),
    None => assert(false)
  }
}

test "provenance survives repeated env_cache" {
  let originated = env_bind_with_origin(EnvEmpty, "imported", CtChar, BindingOriginModuleExport("/dep.vibe", "source_imported"))
  let twice_cached = env_cache(env_cache(env_bind_mut(originated, "cell", CtInt, true)))
  match env_lookup_binding(twice_cached, "imported") {
    Some(binding) => match binding.origin {
      BindingOriginModuleExport(path, source) => {
        inspect(path, "/dep.vibe")
        inspect(source, "source_imported")
      },
      _ => assert(false)
    },
    None => assert(false)
  }
}

test "re-export surface bindings block older locals and survive caches" {
  let local = env_bind(EnvEmpty, "forwarded", CtInt)
  let surface = env_bind_with_origin(local, "forwarded", CtString, BindingOriginReExportSurface("/dep.vibe", "source_value"))
  inspect(match env_lookup(surface, "forwarded") {
    None => "blocked",
    Some(_) => "visible"
  }, "blocked")
  let cached = env_cache(surface)
  inspect(match env_lookup(cached, "forwarded") {
    None => "blocked",
    Some(_) => "visible"
  }, "blocked")
  let surface_only = env_bind_with_origin(EnvEmpty, "forwarded", CtString, BindingOriginReExportSurface("/dep.vibe", "source_value"))
  inspect(match env_lookup(surface_only, "forwarded") {
    None => "absent",
    Some(_) => "visible"
  }, "absent")
  inspect(match env_lookup(env_cache(surface_only), "forwarded") {
    None => "absent",
    Some(_) => "visible"
  }, "absent")
  let newer_local = env_bind(surface_only, "forwarded", CtInt)
  match env_lookup(env_cache(newer_local), "forwarded") {
    Some(ty) => inspect(type_to_string(ty), "Int"),
    None => assert(false)
  }
  let flat_surface = EnvFlat([
    ("forwarded", EnvValueBinding::{
      ty: CtString,
      origin: BindingOriginReExportSurface("/dep.vibe", "source_value")
    }),
    ("local", env_value_binding(CtInt))
  ])
  match env_cache(flat_surface) {
    EnvCached(names, _, _) => {
      // Two flattened bindings plus the negative #active_region marker that
      // env_cache seeds into every index (perf: the no-active-region query
      // answers from the name index instead of a full-chain miss walk). The
      // marker's name starts with '#', which no parsed identifier can spell,
      // so it is unreachable from ordinary source-level lookups.
      inspect(env_name_index_length(names), "3")
      let mut has_marker = "absent"
      let mut i = 0
      while i < env_name_index_length(names) {
        if env_name_index_at(names, i) == "#active_region" {
          has_marker = "present"
        }
        i = i + 1
      }
      inspect(has_marker, "present")
    },
    _ => assert(false)
  }
}

test "FS re-export blockers hide earlier sources but allow a newer local binding" {
  let earlier = env_bind(EnvEmpty, "forwarded", CtInt)
  let blocked = env_bind_with_origin(earlier, "forwarded", CtUnknown, BindingOriginReExportSurface("", "forwarded"))
  inspect(match env_lookup(blocked, "forwarded") {
    None => "blocked",
    Some(_) => "visible"
  }, "blocked")
  inspect(match env_lookup(env_cache(blocked), "forwarded") {
    None => "blocked",
    Some(_) => "visible"
  }, "blocked")
  match env_lookup(env_bind(blocked, "forwarded", CtBool), "forwarded") {
    Some(ty) => inspect(type_to_string(ty), "Bool"),
    None => assert(false)
  }
}

test "cache-only indexes remain fail-closed for mutable facts" {
  let cache_only = env_cached(["x"], [env_value_binding(CtInt)], EnvEmpty)
  inspect(mut_escape_text(cache_only, "x"), "none")
  let stale_index = env_cached(["x"], [env_value_binding(CtInt)], env_bind(EnvEmpty, "other", CtBool))
  inspect(mut_escape_text(stale_index, "x"), "none")
}

test "types_compatible with CtUnknown" {
  assert(types_compatible(CtUnknown, CtInt))
  assert(types_compatible(CtInt, CtUnknown))
  assert(types_compatible(CtUnknown, CtUnknown))
}

test "types_compatible same types" {
  assert(types_compatible(CtInt, CtInt))
  assert(types_compatible(CtString, CtString))
}

test "types_compatible different types" {
  assert(not(types_compatible(CtInt, CtString)))
  assert(not(types_compatible(CtBool, CtDouble)))
}

test "types_equal arrays" {
  assert(types_equal(CtArray(CtInt), CtArray(CtInt)))
  assert(not(types_equal(CtArray(CtInt), CtArray(CtString))))
}

test "types_equal fn types" {
  assert(types_equal(CtFn([CtInt], CtString, None), CtFn([CtInt], CtString, None)))
  assert(not(types_equal(CtFn([CtInt], CtString, None), CtFn([CtInt], CtString, Some("Error")))))
  assert(not(types_equal(CtFn([CtInt], CtString, None), CtFn([CtBool], CtString, None))))
}

test "types_equal tuples" {
  assert(types_equal(CtTuple([CtInt, CtBool]), CtTuple([CtInt, CtBool])))
  assert(not(types_equal(CtTuple([CtInt, CtBool]), CtTuple([CtInt, CtString]))))
  assert(not(types_equal(CtTuple([CtInt]), CtTuple([CtInt, CtBool]))))
}

test "type_to_string primitives" {
  assert(type_to_string(CtInt) == "Int")
  assert(type_to_string(CtString) == "String")
  assert(type_to_string(CtBool) == "Bool")
  assert(type_to_string(CtUnit) == "()")
  assert(type_to_string(CtUnknown) == "?")
}

test "type_to_string composite" {
  assert(type_to_string(CtArray(CtInt)) == "Array[Int]")
  assert(type_to_string(CtOption(CtString)) == "Option[String]")
  assert(type_to_string(CtNamed("Result", [CtInt, CtString])) == "Result[Int, String]")
  assert(type_to_string(CtTuple([CtInt, CtBool])) == "(Int, Bool)")
  assert(type_to_string(CtFn([CtInt], CtString, None)) == "(Int) -> String")
  assert(type_to_string(CtFn([CtInt], CtString, Some("Exception"))) == "(Int) -> String with Exception")
  assert(type_to_string(CtFn([CtInt], CtString, Some("Exception, #region_7, #capture[3]"))) == "(Int) -> String with Exception")
  assert(type_to_string(CtFn([CtInt], CtString, Some("#region_7"))) == "(Int) -> String")
  assert(type_to_string(CtForAll([0], array_empty(), CtVar(0))) == "forall ?t0. ?t0")
}

test "value binding provenance follows first-match lookup through bind flat and cache" {
  let imported = env_bind_with_origin(EnvEmpty, "x", CtInt, BindingOriginModuleExport("/dep.vibe", "source_x"))
  let shadowed = env_bind(imported, "x", CtString)
  match env_lookup_binding(shadowed, "x") {
    Some(binding) => {
      assert(types_equal(binding.ty, CtString))
      match binding.origin {
        BindingOriginUnavailable => assert(true),
        _ => assert(false)
      }
    },
    None => assert(false)
  }
  let flat = EnvFlat([
    ("x", env_value_binding(CtBool)),
    ("x", env_value_binding(CtDouble))
  ])
  match env_lookup_binding(flat, "x") {
    Some(binding) => assert(types_equal(binding.ty, CtBool)),
    None => assert(false)
  }
  let cached = env_cache(env_bind_with_origin(env_bind(EnvEmpty, "x", CtInt), "x", CtChar, BindingOriginModuleExport("/dep.vibe", "x")))
  match env_lookup_binding(cached, "x") {
    Some(binding) => {
      assert(types_equal(binding.ty, CtChar))
      match binding.origin {
        BindingOriginModuleExport(path, source) => {
          assert(path == "/dep.vibe")
          assert(source == "x")
        },
        _ => assert(false)
      }
    },
    None => assert(false)
  }
}

test "collect_tvars deduplicates in first-seen order" {
  let ty = CtTuple([
    CtVar(2),
    CtArray(CtVar(1)),
    CtVar(2),
    CtFn([CtVar(3), CtVar(1)], CtVar(4), None)
  ])
  let vars = collect_tvars(ty)
  assert(eq(Array::length(vars), 4))
  assert(eq(Array::get(vars, 0), 2))
  assert(eq(Array::get(vars, 1), 1))
  assert(eq(Array::get(vars, 2), 3))
  assert(eq(Array::get(vars, 3), 4))
}

test "subst_apply_except resolves effect rows while preserving type ids" {
  let source = CtFn([CtVar(0)], CtVar(0), Some("e"))
  let resolved = subst_apply_except(SubstEffBind("e", "Log", SubstBind(0, CtInt, SubstEmpty)), source, [
    0
  ])
  assert(types_equal(resolved, CtFn([CtVar(0)], CtVar(0), Some("Log"))))
}

test "subst_apply_except preserves a generic effect binder while its result stays open" {
  let source = CtFn([CtVar(0)], CtVar(0), Some("e"))
  let resolved = subst_apply_except(SubstEffBind("e", "$82", SubstEmpty), source, [
    0
  ])
  assert(types_equal(resolved, CtFn([CtVar(0)], CtVar(0), Some("e"))))
}

fn cached_lookup_text(env: TypeEnv, name: String) -> String {
  match env_lookup(env, name) {
    Some(ty) => type_to_string(ty),
    None => "None"
  }
}

test "cached row IDs keep colliding names and duplicate shadowing distinct" {
  let cached = env_cached(["Aa", "Aa", "BB"], [
    env_value_binding(CtBool),
    env_value_binding(CtString),
    env_value_binding(CtInt)
  ], env_bind(EnvEmpty, "tail", CtChar))
  inspect(cached_lookup_text(cached, "Aa"), "Bool")
  inspect(cached_lookup_text(cached, "BB"), "Int")
  inspect(cached_lookup_text(cached, "tail"), "Char")
  inspect(cached_lookup_text(env_bind(cached, "Aa", CtDouble), "Aa"), "Double")
  let other = env_cached(["BB", "Zz"], [
    env_value_binding(CtString),
    env_value_binding(CtUnit)
  ], EnvEmpty)
  inspect(cached_lookup_text(other, "BB"), "String")
  inspect(cached_lookup_text(other, "Aa"), "None")
  inspect(cached_lookup_text(cached, "BB"), "Int")
}

test "cached names are snapshots so mutating the caller array cannot redirect bindings" {
  let names = ["Aa", "BB"]
  let cached = env_cached(names, [
    env_value_binding(CtInt),
    env_value_binding(CtBool)
  ], EnvEmpty)
  Array::set(names, 0, "BB")
  inspect(cached_lookup_text(cached, "Aa"), "Int")
  inspect(cached_lookup_text(cached, "BB"), "Bool")
}

test "complete snapshots retain tuck-behind binds across shared branches" {
  let base = env_cache_complete(env_bind(EnvEmpty, "base", CtInt))
  let left = env_bind(base, "added", CtString)
  let right = env_bind(base, "added", CtBool)
  match left {
    EnvCached(_, _, _) => (),
    _ => assert(false)
  }
  assert(env_lookup(base, "added") is None)
  assert(env_lookup(left, "added") is Some(CtString))
  assert(env_lookup(right, "added") is Some(CtBool))
  assert(env_lookup(env_bind(left, "base", CtChar), "base") is Some(CtChar))
  assert(env_lookup(base, "base") is Some(CtInt))
  assert(env_lookup(left, "missing") is None)
}

test "partial accelerators continue into their canonical tail on a miss" {
  let env = env_cached(["cached"], [env_value_binding(CtInt)], env_bind(EnvEmpty, "tail", CtString))
  assert(env_lookup(env, "tail") is Some(CtString))
  assert(env_lookup_binding_including_surface(env, "tail") is Some(_))
}

test "complete snapshots preserve surface barriers and local shadowing" {
  let old = env_bind(EnvEmpty, "x", CtInt)
  let barrier = env_bind_with_origin(old, "x", CtUnknown, BindingOriginReExportSurface("facade", "x"))
  let env = env_cache_complete(barrier)
  assert(env_lookup(env, "x") is None)
  match env_lookup_binding_including_surface(env, "x") {
    Some(binding) => assert(binding.origin is BindingOriginReExportSurface("facade", "x")),
    None => assert(false)
  }
  assert(env_lookup(env_bind(env, "x", CtBool), "x") is Some(CtBool))
  assert(env_lookup(env_cache_complete(env_bind(env, "x", CtBool)), "x") is Some(CtBool))
}

test "complete snapshots preserve mutable facts and nearest binding order" {
  let outer = env_cache_complete(env_bind_mut(EnvEmpty, "cell", CtInt, true))
  assert(env_mut_escape(outer, "cell") is Some(true))
  let inner = env_cache_complete(env_bind(outer, "cell", CtString))
  assert(env_mut_escape(inner, "cell") is None)
  assert(env_lookup(inner, "cell") is Some(CtString))
  let local = env_cache_complete(env_bind_mut(inner, "local", CtBool, false))
  assert(env_mut_escape(local, "local") is Some(false))
  assert(env_mut_escape(local, "cell") is None)
}

test "refreshing provenance drops miss authority before adding marker bindings" {
  let defs = [TDEnum("Private", [], [("Only", [])])]
  let env = env_cache_complete(EnvTypeDefs(defs, [], EnvEmpty))
  let source = env_bind_with_origin(EnvEmpty, "Private", CtEnum("Private"), BindingOriginModuleExport("origin", "Private"))
  let refreshed = env_preserve_type_definition_origins(env, source)
  match env_lookup_binding(refreshed, "#typedef-origin:Private") {
    Some(binding) => assert(binding.origin is BindingOriginModuleExport("origin", "Private")),
    None => assert(false)
  }
}

test "repeated complete snapshots replace older indexes without retaining their history" {
  let mut env = env_cache_complete(env_bind(EnvEmpty, "root", CtInt))
  let mut i = 0
  while i < 40 {
    let extended = env_bind(env, "row_" + Int::to_string(i), CtBool)
    // Invalidation removes miss authority but must still let the next
    // rebuild replace this canonical snapshot instead of retaining it.
    env = env_cache_complete(env_preserve_type_definition_origins(extended, EnvEmpty))
    i = i + 1
  }
  let mut cur = env
  let mut caches = 0
  let mut done = false
  while !done {
    match cur {
      EnvCached(_, _, rest) => {
        caches = caches + 1; cur = rest
      },
      EnvBind(_, _, rest) => {
        cur = rest
      },
      _ => {
        done = true
      }
    }
  }
  assert(caches == 1)
  assert(env_lookup(env, "root") is Some(CtInt))
  assert(env_lookup(env, "row_0") is Some(CtBool))
  assert(env_lookup(env, "row_39") is Some(CtBool))
  assert(env_lookup(env, "not_bound") is None)
}

test "canonical snapshot invalidation also discards stale positive value rows" {
  let snapshot = env_cache_complete(env_bind(EnvEmpty, "x", CtInt))
  match snapshot {
    EnvCached(names, bindings, _) => {
      let changed_tail = env_bind(EnvEmpty, "x", CtString)
      let changed = env_cached_after_tail_change(names, bindings, changed_tail)
      assert(env_lookup(changed, "x") is Some(CtString))
      assert(env_lookup(env_cache_complete(changed), "x") is Some(CtString))
    },
    _ => assert(false)
  }
}

fn preallocated_temporary_env() -> TypeEnv {
  let ty = CtNamed(String::concat("owned", "Type"), [CtArray(CtString)])
  let path = String::concat("/dep", ".vibe")
  let name = String::concat("source", "_name")
  env_cache(env_bind_with_origin(EnvEmpty, "payload", ty, BindingOriginModuleExport(path, name)))
}

test "preallocated cache rows retain payload and provenance after temporaries expire" {
  let result = env_lookup_binding(preallocated_temporary_env(), "payload")
  let pressure: Array[String] = []
  let mut i = 0
  while i < 200 {
    Array::push(pressure, String::concat("replacement", __to_string(i)))
    i = i + 1
  }
  assert(Array::length(pressure) == 200)
  match result {
    None => assert(false),
    Some(binding) => {
      assert(types_equal(binding.ty, CtNamed("ownedType", [CtArray(CtString)])))
      match binding.origin {
        BindingOriginModuleExport(path, name) => {
          assert(path == "/dep.vibe")
          assert(name == "source_name")
        },
        _ => assert(false)
      }
    }
  }
}

test "preallocated cache rows preserve empty and singleton lookups" {
  let empty = env_cache(EnvEmpty)
  assert(env_lookup(empty, "missing") is None)
  let single = env_cache(env_bind(EnvEmpty, "only", CtInt))
  assert(env_lookup(single, "only") is Some(CtInt))
  assert(env_lookup(single, "missing") is None)
  assert(env_lookup(env_cache(single), "only") is Some(CtInt))
}

fn assert_surface_binding(env: TypeEnv, name: String, expected: Bool) -> Unit {
  let actual = env_has_reexport_surface_binding(env, name)
  assert(actual == expected)
}
fn bind_surface_binding(env: TypeEnv, name: String) -> TypeEnv {
  env_bind_with_origin(env, name, CtString, BindingOriginReExportSurface("facade", name))
}
test "surface binding handles empty and plain environments" {
  assert_surface_binding(EnvEmpty, "x", false)
  assert_surface_binding(env_bind(EnvEmpty, "x", CtInt), "x", false)
  assert_surface_binding(env_cache_complete(env_bind(EnvEmpty, "x", CtInt)), "missing", false)
}
test "surface binding keeps raw and complete surface positives" {
  let env = bind_surface_binding(EnvEmpty, "x")
  assert_surface_binding(env, "x", true)
  assert_surface_binding(env_cache(env), "x", true)
  assert_surface_binding(env_cache_complete(env), "x", true)
  assert_surface_binding(env_cache_complete(env), "missing", false)
}
test "surface binding does not stop at a newer ordinary binding" {
  let hidden = env_bind(bind_surface_binding(EnvEmpty, "x"), "x", CtInt)
  assert_surface_binding(hidden, "x", true)
  assert_surface_binding(env_cache(hidden), "x", true)
  assert_surface_binding(env_cache_complete(hidden), "x", true)
  assert_surface_binding(env_cache_complete(env_bind(hidden, "x", CtBool)), "x", true)
}
test "surface binding retains positives in front of an absent complete index" {
  let base = env_cache_complete(env_bind(EnvEmpty, "base", CtInt))
  let direct = EnvBind("x", env_value_binding_with_origin(CtString, BindingOriginReExportSurface("facade", "x")), base)
  assert_surface_binding(direct, "x", true)
  assert_surface_binding(direct, "missing", false)
}
test "surface binding tracks shared branch additions conservatively" {
  let base = env_cache_complete(env_bind(EnvEmpty, "base", CtInt))
  let left = bind_surface_binding(base, "added")
  let right = env_bind(base, "added", CtBool)
  assert_surface_binding(left, "added", true)
  assert_surface_binding(right, "added", false)
  assert_surface_binding(base, "added", false)
  assert_surface_binding(env_bind(left, "added", CtInt), "added", true)
  assert_surface_binding(env_cache_complete(left), "added", true)
}
test "surface binding falls through a partial cache miss" {
  let partial = env_cached(["other"], [env_value_binding(CtInt)], bind_surface_binding(EnvEmpty, "x"))
  assert_surface_binding(partial, "x", true)
  assert_surface_binding(partial, "missing", false)
  assert_surface_binding(env_cache_complete(partial), "x", true)
}
test "surface binding does not grant cached positive rows surface authority" {
  let partial = env_cached(["x"], [env_value_binding(CtInt)], bind_surface_binding(EnvEmpty, "x"))
  assert_surface_binding(partial, "x", true)
  let stale = env_cached(["x"], [
    env_value_binding_with_origin(CtString, BindingOriginReExportSurface("facade", "x"))
  ], EnvEmpty)
  assert_surface_binding(stale, "x", false)
  assert_surface_binding(env_cache_complete(stale), "x", false)
}
test "surface binding checks historical flat rows" {
  let flat = EnvFlat([
    ("x", env_value_binding(CtInt)),
    ("x", env_value_binding_with_origin(CtString, BindingOriginReExportSurface("facade", "x"))),
    ("y", env_value_binding(CtBool))
  ])
  assert_surface_binding(flat, "x", true)
  assert_surface_binding(env_cache_complete(flat), "x", true)
  assert_surface_binding(env_cache_complete(flat), "y", false)
  assert_surface_binding(env_cache_complete(flat), "missing", false)
}
test "surface binding traverses all metadata variants" {
  let env = EnvTraitDef("Marker", [], true, [], EnvTraitImpl("Marker", CtInt, EnvTraitImplGen("Marker", [
  ], [], CtBool, EnvTypeDefs([], [], EnvMutCell("cell", false, bind_surface_binding(EnvEmpty, "x"))))), [
  ], [])
  assert_surface_binding(env, "x", true)
  assert_surface_binding(env_cache_complete(env), "x", true)
  assert_surface_binding(env_cache_complete(env), "missing", false)
}
test "surface binding drops invalidated complete miss authority" {
  let base = env_cache_complete(env_bind(EnvEmpty, "base", CtInt))
  match base {
    EnvCached(names, bindings, _) => {
      let changed = env_cached_after_tail_change(names, bindings, bind_surface_binding(EnvEmpty, "new"))
      assert_surface_binding(changed, "new", true)
      assert_surface_binding(env_cache_complete(changed), "new", true)
    },
    _ => assert(false)
  }
}
test "surface binding falls through partial cached tail transformations" {
  let base = env_cached(["base"], [env_value_binding(CtInt)], EnvEmpty)
  match base {
    EnvCached(names, bindings, _) => {
      let changed = env_cached_after_tail_change(names, bindings, bind_surface_binding(EnvEmpty, "new"))
      assert_surface_binding(changed, "new", true)
    },
    _ => assert(false)
  }
}
test "surface binding can pass a partial cache into an older complete miss" {
  let base = env_cache_complete(bind_surface_binding(EnvEmpty, "x"))
  let outer = env_cached(["extra"], [env_value_binding(CtInt)], base)
  assert_surface_binding(outer, "x", true)
  assert_surface_binding(outer, "missing", false)
  assert_surface_binding(bind_surface_binding(outer, "new"), "new", true)
}

test "surface binding retains historical answers behind read snapshots" {
  let hidden = env_bind(bind_surface_binding(EnvEmpty, "x"), "x", CtInt)
  let snapshot = env_cache_read_snapshot(hidden)
  assert_surface_binding(snapshot, "x", true)
  assert_surface_binding(snapshot, "missing", false)
  assert_surface_binding(env_cache_read_snapshot(snapshot), "x", true)
  let base = env_cache_read_snapshot(env_bind(EnvEmpty, "base", CtInt))
  let left = bind_surface_binding(base, "added")
  let right = env_bind(base, "added", CtBool)
  assert_surface_binding(env_cache_read_snapshot(left), "added", true)
  assert_surface_binding(env_cache_read_snapshot(right), "added", false)
  assert_surface_binding(env_cache_read_snapshot(base), "added", false)
  let partial = env_cached(["x"], [
    env_value_binding_with_origin(CtString, BindingOriginReExportSurface("facade", "x"))
  ], EnvEmpty)
  assert_surface_binding(env_cache_read_snapshot(partial), "x", false)
}

test "surface binding falls through malformed partial ordering" {
  let partial = env_cached(["z", "a"], [
    env_value_binding(CtInt),
    env_value_binding(CtBool)
  ], bind_surface_binding(EnvEmpty, "x"))
  assert_surface_binding(partial, "x", true)
  assert_surface_binding(partial, "missing", false)
}
