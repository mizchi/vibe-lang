let _types_test_no_methods: Array[(String, Array[TypeExpr], TypeExpr)] = ArrayBuilder::freeze(ArrayBuilder::new())

//# Functions

fn empty_defs() -> Array[TypeDef] {
  array_empty()
}

test "declared StringMap shadows the builtin structural spelling" {
  let defs = [
    TDStruct("StringMap", [("value", CtNamed("T", array_empty()))], ["value"], [
      "T"
    ])
  ]
  let resolved = resolve_type_expr_core_shadowed(te = TyApp("StringMap", [
    TyName("Int")
  ]), defs = defs, shadow = array_empty())
  assert(types_equal(a = resolved, b = CtNamed("StringMap", [CtInt])))
}

test "#2276 round 18: a TDEffect named StringMap also shadows the builtin" {
  // `seed_imported_type_defs` puts an IMPORTED effect into `defs` as a
  // `TDEffect`, and `resolve_type_expr_core_shadowed` consults `defs` before
  // taking the builtin branch. So `import ./dep.vibe { effect Box as
  // StringMap }` makes the annotation nominal in the checker, which the WIT
  // scan has to agree with or it publishes the builtin ABI for another type.
  let defs = [TDEffect("StringMap", array_empty(), array_empty())]
  let resolved = resolve_type_expr_core_shadowed(te = TyApp("StringMap", [
    TyName("Int")
  ]), defs = defs, shadow = array_empty())
  assert(types_equal(a = resolved, b = CtNamed("StringMap", [CtInt])))
}

test "#2276 round 19: a TDEffectSet named StringMap also shadows the builtin" {
  // True for an IMPORTED effectset, which `seed_imported_type_defs` puts into
  // `defs`. A LOCAL `effectset` declaration does NOT reach `defs` -- nothing
  // pushes a `TDEffectSet` for one -- so it resolves to the builtin instead;
  // that asymmetry is why `wit_stmts_declare_type` has no `SEffectSet` arm.
  let defs = [TDEffectSet("StringMap", array_empty())]
  let resolved = resolve_type_expr_core_shadowed(te = TyApp("StringMap", [
    TyName("Int")
  ]), defs = defs, shadow = array_empty())
  assert(types_equal(a = resolved, b = CtNamed("StringMap", [CtInt])))
}

test "#2276 round 20: a TDEnum named StringMap also shadows the builtin" {
  // What a `suberror StringMap(..)` declaration claims. `resolve_type_expr`
  // gives `CtEnum` for a declared enum, which is nominal either way -- the
  // point is that it is NOT the builtin map.
  let defs = [TDEnum("StringMap", array_empty(), array_empty())]
  let resolved = resolve_type_expr_core_shadowed(te = TyApp("StringMap", [
    TyName("Int")
  ]), defs = defs, shadow = array_empty())
  assert(!types_equal(a = resolved, b = CtNamed("Map", [CtString, CtInt])))
}

test "#2276 round 18: with no typedef the builtin spelling still resolves" {
  // The control for the row above: nothing in `defs` owns the name, so
  // `StringMap[Int]` is the builtin `Map[String, Int]`.
  let resolved = resolve_type_expr_core_shadowed(te = TyApp("StringMap", [
    TyName("Int")
  ]), defs = empty_defs(), shadow = array_empty())
  assert(types_equal(a = resolved, b = CtNamed("Map", [CtString, CtInt])))
}

fn mut_escape_text(env: TypeEnv, name: String) -> String {
  match env_mut_escape(env = env, name = name) {
    Some(true) => "true",
    Some(false) => "false",
    None => "none"
  }
}

//# Misc

test "env_lookup found" {
  let env = env_bind(env = EnvEmpty, name = "x", ty = CtInt)
  let result = env_lookup(env = env, name = "x")
  match result {
    Some(t) => assert(types_equal(a = t, b = CtInt)),
    None => assert(false)
  }
}

test "env_lookup not found" {
  let result = env_lookup(env = EnvEmpty, name = "x")
  match result {
    Some(_) => assert(false),
    None => assert(true)
  }
}

test "single-binding cache preserves lookup and shadowing" {
  let env = env_bind(env = EnvEmpty, name = "outer", ty = CtInt)
  let cached = env_cache_binding(env = env, name = "sentinel", ty = CtChar)
  inspect(match env_lookup(env = cached, name = "sentinel") {
    Some(ty) => type_to_string(ty),
    None => "None"
  }, "Char")
  inspect(match env_lookup(env = cached, name = "outer") {
    Some(ty) => type_to_string(ty),
    None => "None"
  }, "Int")
  let shadowed = env_bind(env = cached, name = "sentinel", ty = CtBool)
  inspect(match env_lookup(env = shadowed, name = "sentinel") {
    Some(ty) => type_to_string(ty),
    None => "None"
  }, "Bool")
}

test "env_lookup shadows outer" {
  let env = env_bind(env = EnvEmpty, name = "x", ty = CtInt)
  let env2 = env_bind(env = env, name = "x", ty = CtString)
  let result = env_lookup(env = env2, name = "x")
  match result {
    Some(t) => assert(types_equal(a = t, b = CtString)),
    None => assert(false)
  }
}

test "env_lookup handles flat env" {
  let env = EnvFlat([
    ("x", env_value_binding(CtString)),
    ("x", env_value_binding(CtInt))
  ])
  match env_lookup(env = env, name = "x") {
    Some(t) => assert(types_equal(a = t, b = CtString)),
    None => assert(false)
  }
}

test "env_bind shadows flat env" {
  let flat = EnvFlat([("x", env_value_binding(CtInt))])
  let env = env_bind(env = flat, name = "x", ty = CtString)
  match env_lookup(env = env, name = "x") {
    Some(t) => assert(types_equal(a = t, b = CtString)),
    None => assert(false)
  }
}

test "env_bind_all" {
  let env = env_bind_all(env = EnvEmpty, bindings = [("a", CtInt), ("b", CtString)])
  match env_lookup(env = env, name = "a") {
    Some(t) => assert(types_equal(a = t, b = CtInt)),
    None => assert(false)
  }
  match env_lookup(env = env, name = "b") {
    Some(t) => assert(types_equal(a = t, b = CtString)),
    None => assert(false)
  }
}

test "env_lookup_flat shadows like env_lookup" {
  let env = env_bind(env = env_bind(env = EnvEmpty, name = "x", ty = CtInt), name = "x", ty = CtString)
  let no_supers = array_empty()
  let env_with_trait = EnvTraitDef("Show", no_supers, false, _types_test_no_methods, env, array_empty(), array_empty())
  let flat = env_flat_bindings(env_with_trait)
  match env_lookup_flat(bindings = flat, name = "x") {
    Some(t) => assert(types_equal(a = t, b = CtString)),
    None => assert(false)
  }
}

test "env_lookup_flat not found" {
  let flat = env_flat_bindings(EnvEmpty)
  match env_lookup_flat(bindings = flat, name = "missing") {
    Some(_) => assert(false),
    None => assert(true)
  }
}

test "env_cache handles empty env" {
  match env_cache(EnvEmpty) {
    EnvEmpty => assert(true),
    _ => assert(false)
  }
}

test "env_bind keeps cached env lookup path" {
  // Non-shadowing binds tuck BEHIND a head cache so hot lookups of cached
  // (imported) names keep hitting the index first. #2390 measured the
  // always-in-front alternative and it regressed ~+20% on
  // env_lookup_binding; head adjacency is a deliberate property.
  let base = env_cache(env_bind(env = EnvEmpty, name = "base", ty = CtInt))
  let env = env_bind(env = base, name = "x", ty = CtString)
  match env {
    EnvCached(_, _, _) => assert(true),
    _ => assert(false)
  }
  inspect(match env_lookup(env = env, name = "x") {
    Some(t) => type_to_string(t),
    None => "absent"
  }, "String")
  inspect(match env_lookup(env = env, name = "base") {
    Some(t) => type_to_string(t),
    None => "absent"
  }, "Int")
}

test "a region accelerator recaches through env_cache (real entry shape)" {
  // The checker's region entry chain-binds the real `#active_region`
  // skolem and puts env_cache_binding's accelerator OVER it -- the arrays
  // are a mirror, never the only copy. That is what lets env_cache skip
  // inner cache arrays (the chain is the truth; a stale array must never
  // out-shadow a refreshed chain entry -- #2390 review). Pin the contract:
  // an outer env_cache over the real shape keeps answering the real
  // skolem, not the negative CtUnit marker it seeds for cache-less envs.
  let region_ty = CtNamed("#region_r", array_empty())
  let chain = env_bind(env = env_bind(env = EnvEmpty, name = "v", ty = CtInt), name = "#active_region", ty = region_ty)
  let inner = env_cache_binding(env = chain, name = "#active_region", ty = region_ty)
  let outer = env_cache(inner)
  inspect(match env_lookup(env = outer, name = "#active_region") {
    Some(t) => type_to_string(t),
    None => "absent"
  }, "#region_r")
  inspect(match env_lookup(env = outer, name = "v") {
    Some(t) => type_to_string(t),
    None => "absent"
  }, "Int")
}

test "env_bind shadowing a cached name wins env_lookup (#1583)" {
  // The cached index holds "x" -> CtInt; a NEWER inner binding of the same
  // name (a parameter, a let) must shadow it. Before #1583 env_bind tucked
  // the new binding under the cache head and env_lookup answered from the
  // index first, so the older cached entry won silently.
  let base = env_cache(env_bind(env = EnvEmpty, name = "x", ty = CtInt))
  let env = env_bind(env = base, name = "x", ty = CtString)
  match env_lookup(env = env, name = "x") {
    Some(t) => assert(types_equal(a = t, b = CtString)),
    None => assert(false)
  }
  // The cached fallback still answers for non-shadowed names.
  match env_lookup(env = env_bind(env = base, name = "y", ty = CtBool), name = "x") {
    Some(t) => assert(types_equal(a = t, b = CtInt)),
    None => assert(false)
  }
}

test "env_bind over cached env remains visible to flat lookup" {
  let base = env_cache(env_bind(env = EnvEmpty, name = "x", ty = CtInt))
  let env = env_bind(env = base, name = "x", ty = CtString)
  let flat = env_flat_bindings(env)
  match env_lookup_flat(bindings = flat, name = "x") {
    Some(t) => assert(types_equal(a = t, b = CtString)),
    None => assert(false)
  }
}

test "env_cache preserves visible true and false mutable escape facts" {
  let true_env = env_cache(env_bind_mut(env = EnvEmpty, name = "x", ty = CtInt, escapes = true))
  let false_env = env_cache(env_bind_mut(env = EnvEmpty, name = "x", ty = CtInt, escapes = false))
  inspect(mut_escape_text(env = true_env, name = "x"), "true")
  inspect(mut_escape_text(env = false_env, name = "x"), "false")
  inspect(mut_escape_text(env = true_env, name = "missing"), "none")
}

test "env_cache preserves mutable and immutable shadow order" {
  let outer_mut = env_bind_mut(env = EnvEmpty, name = "x", ty = CtInt, escapes = true)
  let immutable_over_mutable = env_cache(env_bind(env = outer_mut, name = "x", ty = CtString))
  inspect(mut_escape_text(env = immutable_over_mutable, name = "x"), "none")
  let outer_immutable = env_bind(env = EnvEmpty, name = "x", ty = CtInt)
  let mutable_over_immutable = env_cache(env_bind_mut(env = outer_immutable, name = "x", ty = CtString, escapes = false))
  inspect(mut_escape_text(env = mutable_over_immutable, name = "x"), "false")
  let duplicate_mutable = env_cache(env_bind_mut(env = env_bind_mut(env = EnvEmpty, name = "x", ty = CtInt, escapes = false), name = "x", ty = CtString, escapes = true))
  inspect(mut_escape_text(env = duplicate_mutable, name = "x"), "true")
}

test "env_bind before and after cache preserves mutable shadowing" {
  let cached_mutable = env_cache(env_bind_mut(env = EnvEmpty, name = "x", ty = CtInt, escapes = true))
  let immutable_after_cache = env_bind(env = cached_mutable, name = "x", ty = CtString)
  inspect(mut_escape_text(env = immutable_after_cache, name = "x"), "none")
  let cached_immutable = env_cache(env_bind(env = EnvEmpty, name = "x", ty = CtInt))
  let mutable_after_cache = env_bind_mut(env = cached_immutable, name = "x", ty = CtString, escapes = false)
  inspect(mut_escape_text(env = mutable_after_cache, name = "x"), "false")
  inspect(mut_escape_text(env = env_cache(mutable_after_cache), name = "x"), "false")
}

test "recache retains mutable facts" {
  let originated = env_bind_with_origin(env = EnvEmpty, name = "imported", ty = CtChar, origin = BindingOriginModuleExport("/dep.vibe", "source_imported"))
  let twice_cached = env_cache(env_cache(env_bind_mut(env = originated, name = "cell", ty = CtInt, escapes = true)))
  inspect(mut_escape_text(env = twice_cached, name = "cell"), "true")
}

test "origin type survives repeated env_cache" {
  let originated = env_bind_with_origin(env = EnvEmpty, name = "imported", ty = CtChar, origin = BindingOriginModuleExport("/dep.vibe", "source_imported"))
  let twice_cached = env_cache(env_cache(env_bind_mut(env = originated, name = "cell", ty = CtInt, escapes = true)))
  match env_lookup_binding(env = twice_cached, name = "imported") {
    Some(binding) => inspect(type_to_string(binding.ty), "Char"),
    None => assert(false)
  }
}

test "provenance survives repeated env_cache" {
  let originated = env_bind_with_origin(env = EnvEmpty, name = "imported", ty = CtChar, origin = BindingOriginModuleExport("/dep.vibe", "source_imported"))
  let twice_cached = env_cache(env_cache(env_bind_mut(env = originated, name = "cell", ty = CtInt, escapes = true)))
  match env_lookup_binding(env = twice_cached, name = "imported") {
    Some(binding) => match binding.origin {
      BindingOriginModuleExport(path, source) => {
        inspect(path, "/dep.vibe")
        inspect(source, "source_imported")
      },
      _ => assert(false)
    },
    None => assert(false)
  }
}

test "re-export surface bindings block older locals and survive caches" {
  let local = env_bind(env = EnvEmpty, name = "forwarded", ty = CtInt)
  let surface = env_bind_with_origin(env = local, name = "forwarded", ty = CtString, origin = BindingOriginReExportSurface("/dep.vibe", "source_value"))
  inspect(match env_lookup(env = surface, name = "forwarded") {
    None => "blocked",
    Some(_) => "visible"
  }, "blocked")
  let cached = env_cache(surface)
  inspect(match env_lookup(env = cached, name = "forwarded") {
    None => "blocked",
    Some(_) => "visible"
  }, "blocked")
  let surface_only = env_bind_with_origin(env = EnvEmpty, name = "forwarded", ty = CtString, origin = BindingOriginReExportSurface("/dep.vibe", "source_value"))
  inspect(match env_lookup(env = surface_only, name = "forwarded") {
    None => "absent",
    Some(_) => "visible"
  }, "absent")
  inspect(match env_lookup(env = env_cache(surface_only), name = "forwarded") {
    None => "absent",
    Some(_) => "visible"
  }, "absent")
  let newer_local = env_bind(env = surface_only, name = "forwarded", ty = CtInt)
  match env_lookup(env = env_cache(newer_local), name = "forwarded") {
    Some(ty) => inspect(type_to_string(ty), "Int"),
    None => assert(false)
  }
  let flat_surface = EnvFlat([
    ("forwarded", EnvValueBinding::{
      ty: CtString,
      origin: BindingOriginReExportSurface("/dep.vibe", "source_value")
    }),
    ("local", env_value_binding(CtInt))
  ])
  match env_cache(flat_surface) {
    EnvCached(names, _, _) => {
      // Two flattened bindings plus the negative #active_region marker that
      // env_cache seeds into every index (perf: the no-active-region query
      // answers from the name index instead of a full-chain miss walk). The
      // marker's name starts with '#', which no parsed identifier can spell,
      // so it is unreachable from ordinary source-level lookups.
      inspect(env_name_index_length(names), "3")
      let mut has_marker = "absent"
      let mut i = 0
      while i < env_name_index_length(names) {
        if env_name_index_at(index = names, row = i) == "#active_region" {
          has_marker = "present"
        }
        i = i + 1
      }
      inspect(has_marker, "present")
    },
    _ => assert(false)
  }
}

test "FS re-export blockers hide earlier sources but allow a newer local binding" {
  let earlier = env_bind(env = EnvEmpty, name = "forwarded", ty = CtInt)
  let blocked = env_bind_with_origin(env = earlier, name = "forwarded", ty = CtUnknown, origin = BindingOriginReExportSurface("", "forwarded"))
  inspect(match env_lookup(env = blocked, name = "forwarded") {
    None => "blocked",
    Some(_) => "visible"
  }, "blocked")
  inspect(match env_lookup(env = env_cache(blocked), name = "forwarded") {
    None => "blocked",
    Some(_) => "visible"
  }, "blocked")
  match env_lookup(env = env_bind(env = blocked, name = "forwarded", ty = CtBool), name = "forwarded") {
    Some(ty) => inspect(type_to_string(ty), "Bool"),
    None => assert(false)
  }
}

test "cache-only indexes remain fail-closed for mutable facts" {
  let cache_only = env_cached(names = ["x"], bindings = [env_value_binding(CtInt)], rest = EnvEmpty)
  inspect(mut_escape_text(env = cache_only, name = "x"), "none")
  let stale_index = env_cached(names = ["x"], bindings = [env_value_binding(CtInt)], rest = env_bind(env = EnvEmpty, name = "other", ty = CtBool))
  inspect(mut_escape_text(env = stale_index, name = "x"), "none")
}

test "types_compatible with CtUnknown" {
  assert(types_compatible(expected = CtUnknown, actual = CtInt))
  assert(types_compatible(expected = CtInt, actual = CtUnknown))
  assert(types_compatible(expected = CtUnknown, actual = CtUnknown))
}

test "types_compatible same types" {
  assert(types_compatible(expected = CtInt, actual = CtInt))
  assert(types_compatible(expected = CtString, actual = CtString))
}

test "types_compatible different types" {
  assert(not(types_compatible(expected = CtInt, actual = CtString)))
  assert(not(types_compatible(expected = CtBool, actual = CtDouble)))
}

test "types_equal arrays" {
  assert(types_equal(a = CtArray(CtInt), b = CtArray(CtInt)))
  assert(not(types_equal(a = CtArray(CtInt), b = CtArray(CtString))))
}

test "types_equal fn types" {
  assert(types_equal(a = CtFn([CtInt], CtString, None), b = CtFn([CtInt], CtString, None)))
  assert(not(types_equal(a = CtFn([CtInt], CtString, None), b = CtFn([CtInt], CtString, Some("Error")))))
  assert(not(types_equal(a = CtFn([CtInt], CtString, None), b = CtFn([CtBool], CtString, None))))
}

test "types_equal tuples" {
  assert(types_equal(a = CtTuple([CtInt, CtBool]), b = CtTuple([CtInt, CtBool])))
  assert(not(types_equal(a = CtTuple([CtInt, CtBool]), b = CtTuple([CtInt, CtString]))))
  assert(not(types_equal(a = CtTuple([CtInt]), b = CtTuple([CtInt, CtBool]))))
}

test "type_to_string primitives" {
  assert(type_to_string(CtInt) == "Int")
  assert(type_to_string(CtString) == "String")
  assert(type_to_string(CtBool) == "Bool")
  assert(type_to_string(CtUnit) == "()")
  assert(type_to_string(CtUnknown) == "?")
}

test "type_to_string composite" {
  assert(type_to_string(CtArray(CtInt)) == "Array[Int]")
  assert(type_to_string(CtOption(CtString)) == "Option[String]")
  assert(type_to_string(CtNamed("Result", [CtInt, CtString])) == "Result[Int, String]")
  assert(type_to_string(CtTuple([CtInt, CtBool])) == "(Int, Bool)")
  assert(type_to_string(CtFn([CtInt], CtString, None)) == "(Int) -> String")
  assert(type_to_string(CtFn([CtInt], CtString, Some("Exception"))) == "(Int) -> String with Exception")
  assert(type_to_string(CtFn([CtInt], CtString, Some("Exception, #region_7, #capture[3]"))) == "(Int) -> String with Exception")
  assert(type_to_string(CtFn([CtInt], CtString, Some("#region_7"))) == "(Int) -> String")
  assert(type_to_string(CtForAll([0], array_empty(), CtVar(0))) == "forall ?t0. ?t0")
}

test "value binding provenance follows first-match lookup through bind flat and cache" {
  let imported = env_bind_with_origin(env = EnvEmpty, name = "x", ty = CtInt, origin = BindingOriginModuleExport("/dep.vibe", "source_x"))
  let shadowed = env_bind(env = imported, name = "x", ty = CtString)
  match env_lookup_binding(env = shadowed, name = "x") {
    Some(binding) => {
      assert(types_equal(a = binding.ty, b = CtString))
      match binding.origin {
        BindingOriginUnavailable => assert(true),
        _ => assert(false)
      }
    },
    None => assert(false)
  }
  let flat = EnvFlat([
    ("x", env_value_binding(CtBool)),
    ("x", env_value_binding(CtDouble))
  ])
  match env_lookup_binding(env = flat, name = "x") {
    Some(binding) => assert(types_equal(a = binding.ty, b = CtBool)),
    None => assert(false)
  }
  let cached = env_cache(env_bind_with_origin(env = env_bind(env = EnvEmpty, name = "x", ty = CtInt), name = "x", ty = CtChar, origin = BindingOriginModuleExport("/dep.vibe", "x")))
  match env_lookup_binding(env = cached, name = "x") {
    Some(binding) => {
      assert(types_equal(a = binding.ty, b = CtChar))
      match binding.origin {
        BindingOriginModuleExport(path, source) => {
          assert(path == "/dep.vibe")
          assert(source == "x")
        },
        _ => assert(false)
      }
    },
    None => assert(false)
  }
}

test "collect_tvars deduplicates in first-seen order" {
  let ty = CtTuple([
    CtVar(2),
    CtArray(CtVar(1)),
    CtVar(2),
    CtFn([CtVar(3), CtVar(1)], CtVar(4), None)
  ])
  let vars = collect_tvars(ty)
  assert(eq(Array::length(vars), 4))
  assert(eq(Array::get(vars, at = 0), 2))
  assert(eq(Array::get(vars, at = 1), 1))
  assert(eq(Array::get(vars, at = 2), 3))
  assert(eq(Array::get(vars, at = 3), 4))
}

test "subst_apply_except resolves effect rows while preserving type ids" {
  let source = CtFn([CtVar(0)], CtVar(0), Some("e"))
  let resolved = subst_apply_except(s = SubstEffBind("e", "Log", SubstBind(0, CtInt, SubstEmpty)), ty = source, keep = [
    0
  ])
  assert(types_equal(a = resolved, b = CtFn([CtVar(0)], CtVar(0), Some("Log"))))
}

test "subst_apply_except preserves a generic effect binder while its result stays open" {
  let source = CtFn([CtVar(0)], CtVar(0), Some("e"))
  let resolved = subst_apply_except(s = SubstEffBind("e", "$82", SubstEmpty), ty = source, keep = [
    0
  ])
  assert(types_equal(a = resolved, b = CtFn([CtVar(0)], CtVar(0), Some("e"))))
}

fn cached_lookup_text(env: TypeEnv, name: String) -> String {
  match env_lookup(env = env, name = name) {
    Some(ty) => type_to_string(ty),
    None => "None"
  }
}

test "cached row IDs keep colliding names and duplicate shadowing distinct" {
  let cached = env_cached(names = ["Aa", "Aa", "BB"], bindings = [
    env_value_binding(CtBool),
    env_value_binding(CtString),
    env_value_binding(CtInt)
  ], rest = env_bind(env = EnvEmpty, name = "tail", ty = CtChar))
  inspect(cached_lookup_text(env = cached, name = "Aa"), "Bool")
  inspect(cached_lookup_text(env = cached, name = "BB"), "Int")
  inspect(cached_lookup_text(env = cached, name = "tail"), "Char")
  inspect(cached_lookup_text(env = env_bind(env = cached, name = "Aa", ty = CtDouble), name = "Aa"), "Double")
  let other = env_cached(names = ["BB", "Zz"], bindings = [
    env_value_binding(CtString),
    env_value_binding(CtUnit)
  ], rest = EnvEmpty)
  inspect(cached_lookup_text(env = other, name = "BB"), "String")
  inspect(cached_lookup_text(env = other, name = "Aa"), "None")
  inspect(cached_lookup_text(env = cached, name = "BB"), "Int")
}

test "cached names are snapshots so mutating the caller array cannot redirect bindings" {
  let names = ["Aa", "BB"]
  let cached = env_cached(names = names, bindings = [
    env_value_binding(CtInt),
    env_value_binding(CtBool)
  ], rest = EnvEmpty)
  Array::set(names, at = 0, value = "BB")
  inspect(cached_lookup_text(env = cached, name = "Aa"), "Int")
  inspect(cached_lookup_text(env = cached, name = "BB"), "Bool")
}

test "complete snapshots retain tuck-behind binds across shared branches" {
  let base = env_cache_complete(env_bind(env = EnvEmpty, name = "base", ty = CtInt))
  let left = env_bind(env = base, name = "added", ty = CtString)
  let right = env_bind(env = base, name = "added", ty = CtBool)
  match left {
    EnvCached(_, _, _) => (),
    _ => assert(false)
  }
  assert(env_lookup(env = base, name = "added") is None)
  assert(env_lookup(env = left, name = "added") is Some(CtString))
  assert(env_lookup(env = right, name = "added") is Some(CtBool))
  assert(env_lookup(env = env_bind(env = left, name = "base", ty = CtChar), name = "base") is Some(CtChar))
  assert(env_lookup(env = base, name = "base") is Some(CtInt))
  assert(env_lookup(env = left, name = "missing") is None)
}

test "partial accelerators continue into their canonical tail on a miss" {
  let env = env_cached(names = ["cached"], bindings = [env_value_binding(CtInt)], rest = env_bind(env = EnvEmpty, name = "tail", ty = CtString))
  assert(env_lookup(env = env, name = "tail") is Some(CtString))
  assert(env_lookup_binding_including_surface(env = env, name = "tail") is Some(_))
}

test "complete snapshots preserve surface barriers and local shadowing" {
  let old = env_bind(env = EnvEmpty, name = "x", ty = CtInt)
  let barrier = env_bind_with_origin(env = old, name = "x", ty = CtUnknown, origin = BindingOriginReExportSurface("facade", "x"))
  let env = env_cache_complete(barrier)
  assert(env_lookup(env = env, name = "x") is None)
  match env_lookup_binding_including_surface(env = env, name = "x") {
    Some(binding) => assert(binding.origin is BindingOriginReExportSurface("facade", "x")),
    None => assert(false)
  }
  assert(env_lookup(env = env_bind(env = env, name = "x", ty = CtBool), name = "x") is Some(CtBool))
  assert(env_lookup(env = env_cache_complete(env_bind(env = env, name = "x", ty = CtBool)), name = "x") is Some(CtBool))
}

test "complete snapshots preserve mutable facts and nearest binding order" {
  let outer = env_cache_complete(env_bind_mut(env = EnvEmpty, name = "cell", ty = CtInt, escapes = true))
  assert(env_mut_escape(env = outer, name = "cell") is Some(true))
  let inner = env_cache_complete(env_bind(env = outer, name = "cell", ty = CtString))
  assert(env_mut_escape(env = inner, name = "cell") is None)
  assert(env_lookup(env = inner, name = "cell") is Some(CtString))
  let local = env_cache_complete(env_bind_mut(env = inner, name = "local", ty = CtBool, escapes = false))
  assert(env_mut_escape(env = local, name = "local") is Some(false))
  assert(env_mut_escape(env = local, name = "cell") is None)
}

test "refreshing provenance drops miss authority before adding marker bindings" {
  let defs = [TDEnum("Private", [], [("Only", [])])]
  let env = env_cache_complete(EnvTypeDefs(defs, [], EnvEmpty))
  let source = env_bind_with_origin(env = EnvEmpty, name = "Private", ty = CtEnum("Private"), origin = BindingOriginModuleExport("origin", "Private"))
  let refreshed = env_preserve_type_definition_origins(env = env, source = source)
  match env_lookup_binding(env = refreshed, name = "#typedef-origin:Private") {
    Some(binding) => assert(binding.origin is BindingOriginModuleExport("origin", "Private")),
    None => assert(false)
  }
}

test "repeated complete snapshots replace older indexes without retaining their history" {
  let mut env = env_cache_complete(env_bind(env = EnvEmpty, name = "root", ty = CtInt))
  let mut i = 0
  while i < 40 {
    let extended = env_bind(env = env, name = "row_" + Int::to_string(i), ty = CtBool)
    // Invalidation removes miss authority but must still let the next
    // rebuild replace this canonical snapshot instead of retaining it.
    env = env_cache_complete(env_preserve_type_definition_origins(env = extended, source = EnvEmpty))
    i = i + 1
  }
  let mut cur = env
  let mut caches = 0
  let mut done = false
  while !done {
    match cur {
      EnvCached(_, _, rest) => {
        caches = caches + 1; cur = rest
      },
      EnvBind(_, _, rest) => {
        cur = rest
      },
      _ => {
        done = true
      }
    }
  }
  assert(caches == 1)
  assert(env_lookup(env = env, name = "root") is Some(CtInt))
  assert(env_lookup(env = env, name = "row_0") is Some(CtBool))
  assert(env_lookup(env = env, name = "row_39") is Some(CtBool))
  assert(env_lookup(env = env, name = "not_bound") is None)
}

test "canonical snapshot invalidation also discards stale positive value rows" {
  let snapshot = env_cache_complete(env_bind(env = EnvEmpty, name = "x", ty = CtInt))
  match snapshot {
    EnvCached(names, bindings, _) => {
      let changed_tail = env_bind(env = EnvEmpty, name = "x", ty = CtString)
      let changed = env_cached_after_tail_change(names = names, bindings = bindings, rest = changed_tail)
      assert(env_lookup(env = changed, name = "x") is Some(CtString))
      assert(env_lookup(env = env_cache_complete(changed), name = "x") is Some(CtString))
    },
    _ => assert(false)
  }
}

fn preallocated_temporary_env() -> TypeEnv {
  let ty = CtNamed(String::concat("owned", "Type"), [CtArray(CtString)])
  let path = String::concat("/dep", ".vibe")
  let name = String::concat("source", "_name")
  env_cache(env_bind_with_origin(env = EnvEmpty, name = "payload", ty = ty, origin = BindingOriginModuleExport(path, name)))
}

test "preallocated cache rows retain payload and provenance after temporaries expire" {
  let result = env_lookup_binding(env = preallocated_temporary_env(), name = "payload")
  let pressure: Array[String] = []
  let mut i = 0
  while i < 200 {
    Array::push(pressure, value = String::concat("replacement", __to_string(i)))
    i = i + 1
  }
  assert(Array::length(pressure) == 200)
  match result {
    None => assert(false),
    Some(binding) => {
      assert(types_equal(a = binding.ty, b = CtNamed("ownedType", [CtArray(CtString)])))
      match binding.origin {
        BindingOriginModuleExport(path, name) => {
          assert(path == "/dep.vibe")
          assert(name == "source_name")
        },
        _ => assert(false)
      }
    }
  }
}

test "preallocated cache rows preserve empty and singleton lookups" {
  let empty = env_cache(EnvEmpty)
  assert(env_lookup(env = empty, name = "missing") is None)
  let single = env_cache(env_bind(env = EnvEmpty, name = "only", ty = CtInt))
  assert(env_lookup(env = single, name = "only") is Some(CtInt))
  assert(env_lookup(env = single, name = "missing") is None)
  assert(env_lookup(env = env_cache(single), name = "only") is Some(CtInt))
}

fn assert_surface_binding(env: TypeEnv, name: String, expected: Bool) -> Unit {
  let actual = env_has_reexport_surface_binding(env = env, name = name)
  assert(actual == expected)
}
fn bind_surface_binding(env: TypeEnv, name: String) -> TypeEnv {
  env_bind_with_origin(env = env, name = name, ty = CtString, origin = BindingOriginReExportSurface("facade", name))
}
test "surface binding handles empty and plain environments" {
  assert_surface_binding(env = EnvEmpty, name = "x", expected = false)
  assert_surface_binding(env = env_bind(env = EnvEmpty, name = "x", ty = CtInt), name = "x", expected = false)
  assert_surface_binding(env = env_cache_complete(env_bind(env = EnvEmpty, name = "x", ty = CtInt)), name = "missing", expected = false)
}
test "surface binding keeps raw and complete surface positives" {
  let env = bind_surface_binding(env = EnvEmpty, name = "x")
  assert_surface_binding(env = env, name = "x", expected = true)
  assert_surface_binding(env = env_cache(env), name = "x", expected = true)
  assert_surface_binding(env = env_cache_complete(env), name = "x", expected = true)
  assert_surface_binding(env = env_cache_complete(env), name = "missing", expected = false)
}
test "surface binding does not stop at a newer ordinary binding" {
  let hidden = env_bind(env = bind_surface_binding(env = EnvEmpty, name = "x"), name = "x", ty = CtInt)
  assert_surface_binding(env = hidden, name = "x", expected = true)
  assert_surface_binding(env = env_cache(hidden), name = "x", expected = true)
  assert_surface_binding(env = env_cache_complete(hidden), name = "x", expected = true)
  assert_surface_binding(env = env_cache_complete(env_bind(env = hidden, name = "x", ty = CtBool)), name = "x", expected = true)
}
test "surface binding retains positives in front of an absent complete index" {
  let base = env_cache_complete(env_bind(env = EnvEmpty, name = "base", ty = CtInt))
  let direct = EnvBind("x", env_value_binding_with_origin(ty = CtString, origin = BindingOriginReExportSurface("facade", "x")), base)
  assert_surface_binding(env = direct, name = "x", expected = true)
  assert_surface_binding(env = direct, name = "missing", expected = false)
}
test "surface binding tracks shared branch additions conservatively" {
  let base = env_cache_complete(env_bind(env = EnvEmpty, name = "base", ty = CtInt))
  let left = bind_surface_binding(env = base, name = "added")
  let right = env_bind(env = base, name = "added", ty = CtBool)
  assert_surface_binding(env = left, name = "added", expected = true)
  assert_surface_binding(env = right, name = "added", expected = false)
  assert_surface_binding(env = base, name = "added", expected = false)
  assert_surface_binding(env = env_bind(env = left, name = "added", ty = CtInt), name = "added", expected = true)
  assert_surface_binding(env = env_cache_complete(left), name = "added", expected = true)
}
test "surface binding falls through a partial cache miss" {
  let partial = env_cached(names = ["other"], bindings = [env_value_binding(CtInt)], rest = bind_surface_binding(env = EnvEmpty, name = "x"))
  assert_surface_binding(env = partial, name = "x", expected = true)
  assert_surface_binding(env = partial, name = "missing", expected = false)
  assert_surface_binding(env = env_cache_complete(partial), name = "x", expected = true)
}
test "surface binding does not grant cached positive rows surface authority" {
  let partial = env_cached(names = ["x"], bindings = [env_value_binding(CtInt)], rest = bind_surface_binding(env = EnvEmpty, name = "x"))
  assert_surface_binding(env = partial, name = "x", expected = true)
  let stale = env_cached(names = ["x"], bindings = [
    env_value_binding_with_origin(ty = CtString, origin = BindingOriginReExportSurface("facade", "x"))
  ], rest = EnvEmpty)
  assert_surface_binding(env = stale, name = "x", expected = false)
  assert_surface_binding(env = env_cache_complete(stale), name = "x", expected = false)
}
test "surface binding checks historical flat rows" {
  let flat = EnvFlat([
    ("x", env_value_binding(CtInt)),
    ("x", env_value_binding_with_origin(ty = CtString, origin = BindingOriginReExportSurface("facade", "x"))),
    ("y", env_value_binding(CtBool))
  ])
  assert_surface_binding(env = flat, name = "x", expected = true)
  assert_surface_binding(env = env_cache_complete(flat), name = "x", expected = true)
  assert_surface_binding(env = env_cache_complete(flat), name = "y", expected = false)
  assert_surface_binding(env = env_cache_complete(flat), name = "missing", expected = false)
}
test "surface binding traverses all metadata variants" {
  let env = EnvTraitDef("Marker", [], true, [], EnvTraitImpl("Marker", CtInt, EnvTraitImplGen("Marker", [
  ], [], CtBool, EnvTypeDefs([], [], EnvMutCell("cell", false, bind_surface_binding(env = EnvEmpty, name = "x"))))), [
  ], [])
  assert_surface_binding(env = env, name = "x", expected = true)
  assert_surface_binding(env = env_cache_complete(env), name = "x", expected = true)
  assert_surface_binding(env = env_cache_complete(env), name = "missing", expected = false)
}
test "surface binding drops invalidated complete miss authority" {
  let base = env_cache_complete(env_bind(env = EnvEmpty, name = "base", ty = CtInt))
  match base {
    EnvCached(names, bindings, _) => {
      let changed = env_cached_after_tail_change(names = names, bindings = bindings, rest = bind_surface_binding(env = EnvEmpty, name = "new"))
      assert_surface_binding(env = changed, name = "new", expected = true)
      assert_surface_binding(env = env_cache_complete(changed), name = "new", expected = true)
    },
    _ => assert(false)
  }
}
test "surface binding falls through partial cached tail transformations" {
  let base = env_cached(names = ["base"], bindings = [env_value_binding(CtInt)], rest = EnvEmpty)
  match base {
    EnvCached(names, bindings, _) => {
      let changed = env_cached_after_tail_change(names = names, bindings = bindings, rest = bind_surface_binding(env = EnvEmpty, name = "new"))
      assert_surface_binding(env = changed, name = "new", expected = true)
    },
    _ => assert(false)
  }
}
test "surface binding can pass a partial cache into an older complete miss" {
  let base = env_cache_complete(bind_surface_binding(env = EnvEmpty, name = "x"))
  let outer = env_cached(names = ["extra"], bindings = [env_value_binding(CtInt)], rest = base)
  assert_surface_binding(env = outer, name = "x", expected = true)
  assert_surface_binding(env = outer, name = "missing", expected = false)
  assert_surface_binding(env = bind_surface_binding(env = outer, name = "new"), name = "new", expected = true)
}

test "surface binding retains historical answers behind read snapshots" {
  let hidden = env_bind(env = bind_surface_binding(env = EnvEmpty, name = "x"), name = "x", ty = CtInt)
  let snapshot = env_cache_read_snapshot(hidden)
  assert_surface_binding(env = snapshot, name = "x", expected = true)
  assert_surface_binding(env = snapshot, name = "missing", expected = false)
  assert_surface_binding(env = env_cache_read_snapshot(snapshot), name = "x", expected = true)
  let base = env_cache_read_snapshot(env_bind(env = EnvEmpty, name = "base", ty = CtInt))
  let left = bind_surface_binding(env = base, name = "added")
  let right = env_bind(env = base, name = "added", ty = CtBool)
  assert_surface_binding(env = env_cache_read_snapshot(left), name = "added", expected = true)
  assert_surface_binding(env = env_cache_read_snapshot(right), name = "added", expected = false)
  assert_surface_binding(env = env_cache_read_snapshot(base), name = "added", expected = false)
  let partial = env_cached(names = ["x"], bindings = [
    env_value_binding_with_origin(ty = CtString, origin = BindingOriginReExportSurface("facade", "x"))
  ], rest = EnvEmpty)
  assert_surface_binding(env = env_cache_read_snapshot(partial), name = "x", expected = false)
}

test "surface binding falls through malformed partial ordering" {
  let partial = env_cached(names = ["z", "a"], bindings = [
    env_value_binding(CtInt),
    env_value_binding(CtBool)
  ], rest = bind_surface_binding(env = EnvEmpty, name = "x"))
  assert_surface_binding(env = partial, name = "x", expected = true)
  assert_surface_binding(env = partial, name = "missing", expected = false)
}
