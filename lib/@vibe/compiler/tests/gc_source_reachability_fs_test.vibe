import @vibe/compiler/entry/compiler/file_compile {
  compile_file_fs_mode_gc
}
import @vibe/process {
  process_sh_capture
}

fn gc_reachability_fs_run(label: String, source: String, expected: String) -> Unit with Exception + Fs + Env + Process + Console {
  gc_reachability_fs_run_entry(label = label, source = source, entry = "main", expected = expected)
}

fn gc_reachability_fs_run_entry(label: String, source: String, entry: String, expected: String) -> Unit with Exception + Fs + Env + Process + Console {
  Fs::mkdir_p("_build/vibe_test/gc_source_reachability_fs")
  let extension = if entry == "__no_entry__" {
    ".vibe"
  } else {
    ".vibex"
  }
  let input = "_build/vibe_test/gc_source_reachability_fs/" + label + extension
  Fs::write_file(input, contents = source)
  // GC is an instrumented CLI lane: neither regular nor test builds strip
  // executable exports. Retain entry-source publications in both.
  let wasm = compile_file_fs_mode_gc(entry_path = input, entry_name = entry)
  let output = "_build/vibe_test/gc_source_reachability_fs/" + label + ".wasm"
  Fs::write_bytes(output, bytes = wasm)
  let result = process_sh_capture("bash scripts/run_wasm_vibe_host_runner.sh " + output)
  inspect(result.exit_code, content = "0")
  assert(result.stdout == expected)
}

test "GC unused builtin import does not require Future" {
  gc_reachability_fs_run(label = "unused", source = "import @vibe/builtin { trait Iterator } fn main() -> Unit allows Console { println(\"ok:unused-import\") }", expected = "ok:unused-import\n")
}

test "GC retains a used builtin function while dropping unused AsyncIter methods" {
  gc_reachability_fs_run(label = "used-replace", source = "import @vibe/builtin { String::replace_all } fn main() -> Unit allows Console { println(String::replace_all(\"aba\", pattern = \"a\", replacement = \"x\")) }", expected = "xbx\n")
}

test "GC keeps the builtin Iterator implementation used by a for loop" {
  gc_reachability_fs_run(label = "used-iterator", source = "import @vibe/builtin { trait Iterator } fn main() -> Unit allows Console { for x in [1, 2] { println(\"\\{x}\") }; () }", expected = "1\n2\n")
}

test "GC test artifacts ignore unused dependency exports without an export strip" {
  gc_reachability_fs_run_entry(label = "test-mode", source = "import @vibe/builtin { trait Iterator } test \"only\" { println(\"ok:gc-test\") }", entry = "__no_entry__", expected = "ok:gc-test\n0\n")
}

test "GC test artifacts retain the Iterator implementation their loop calls" {
  gc_reachability_fs_run_entry(label = "test-iterator", source = "import @vibe/builtin { trait Iterator } test \"loop\" { for x in [1, 2] { println(\"\\{x}\") }; () }", entry = "__no_entry__", expected = "1\n2\n0\n")
}

test "GC test artifacts follow used dependency functions without rooting all exports" {
  Fs::mkdir_p("_build/vibe_test/gc_source_reachability_fs")
  Fs::write_file("_build/vibe_test/gc_source_reachability_fs/test-provider.vibe", contents = "export fn greeting() -> String { \"ok:dependency\" } export fn unused() -> Future[Int] { Future::ready(7) }")
  gc_reachability_fs_run_entry(label = "test-dependency", source = "import ./test-provider.vibe { greeting } test \"call\" { println(greeting()) }", entry = "__no_entry__", expected = "ok:dependency\n0\n")
}

fn gc_reachability_fs_future_refused(label: String, source: String) -> Unit with Exception + Fs + Env {
  Fs::mkdir_p("_build/vibe_test/gc_source_reachability_fs")
  let input = "_build/vibe_test/gc_source_reachability_fs/" + label + ".vibe"
  Fs::write_file(input, contents = source)
  let msg = handle {
    let _ = compile_file_fs_mode_gc(entry_path = input, entry_name = "__no_entry__")
    ""
  } with { Exception::Throw(m) => m }
  assert(String::contains(msg, needle = "does not support the builtin `Future::ready`"))
}

test "GC test artifacts retain their entry source exports across FS boundaries" {
  gc_reachability_fs_future_refused(label = "test-public", source = "export fn published() -> Future[Int] { Future::ready(7) } test \"only\" { () }")
}

test "GC test artifacts retain the entry source reexported dependency" {
  Fs::mkdir_p("_build/vibe_test/gc_source_reachability_fs")
  Fs::write_file("_build/vibe_test/gc_source_reachability_fs/reexport-provider.vibe", contents = "export fn published() -> Future[Int] { Future::ready(7) }")
  gc_reachability_fs_future_refused(label = "test-reexport", source = "export ./reexport-provider.vibe { published } test \"only\" { () }")
}
