//# Imports

import ./checker_parity_test_support.vibe {
  check_source_err_contains, check_source_ok
}

//# Misc

// #3727: `i32` used to resolve to the 63-bit `Int`. It is no type now, and
// no declaration or type parameter may take the name, so the parser refuses
// it in every type position -- including those the checker's unknown-type
// check never visits (an alias body, an effect operation, a trait method, a
// row argument). #3793: `i64`, `i16` and `u8` .. `u64` resolved to builtin
// types whose arithmetic was the 63-bit `Int`'s (`u8` 255 + 255 was 510), so
// they are refused the same way. The refusal must not reach names that still
// resolve -- `v128` is its own builtin type -- and a program may declare a type
// called `usize`.

fn i32_edit() -> String {
  "unknown type `i32` -- write `Int`"
}

test "i32 is refused in every type position" {
  assert(check_source_err_contains(source = "fn f(x: i32) -> Int { 1 }", needle = i32_edit()))
  assert(check_source_err_contains(source = "type Word = i32\nfn main() -> Int { 0 }", needle = i32_edit()))
  assert(check_source_err_contains(source = "effect E {\n  Op() -> i32\n}\nfn main() -> Int { 0 }", needle = i32_edit()))
  // A trait method's signature: the checker relaxes an unresolved name there
  // to `CtUnknown`, which would let a wrong return type check.
  assert(check_source_err_contains(source = "trait Produce {\n  produce(Self) -> i32\n}\nfn main() -> Int { 0 }", needle = i32_edit()))
  assert(check_source_err_contains(source = "type Word = i32[Int]\nfn main() -> Int { 0 }", needle = i32_edit()))
  assert(check_source_err_contains(source = "struct Box[T] { value: T }\ntype Word = Box[i32]\nfn main() -> Int { 0 }", needle = i32_edit()))
  assert(check_source_err_contains(source = "effect Ask[T] {\n  Get() -> T\n}\nfn f(g: () -> Int with Ask[i32]) -> Int { 0 }\nfn main() -> Int { 0 }", needle = i32_edit()))
}

test "i32 is reserved as a declaration and a type-parameter name" {
  assert(check_source_err_contains(source = "struct i32 { v: Int }\nfn main() -> Int { 0 }", needle = "`i32` is reserved"))
  assert(check_source_err_contains(source = "struct i32[T] { value: T }\nfn main() -> Int { 0 }", needle = "`i32` is reserved"))
  assert(check_source_err_contains(source = "type Alias[i32] = Int\nfn main() -> Int { 0 }", needle = "rename this type parameter: `i32` is reserved"))
}

test "the other fixed-width integer spellings are refused the same way (#3793)" {
  assert(check_source_err_contains(source = "fn bump(_ x: u32) -> u32 { x + x }\nfn main() -> Int { 0 }", needle = "unknown type `u32` -- write `Int`"))
  assert(check_source_err_contains(source = "type Word = i64\nfn main() -> Int { 0 }", needle = "unknown type `i64` -- write `Int`"))
  assert(check_source_err_contains(source = "type Byte = u8\nfn main() -> Int { 0 }", needle = "unknown type `u8` -- write `Int`"))
  assert(check_source_err_contains(source = "effect E {\n  Op(i16) -> Int\n}\nfn main() -> Int { 0 }", needle = "unknown type `i16` -- write `Int`"))
  assert(check_source_err_contains(source = "fn f(x: Array[u16]) -> Int { 0 }", needle = "unknown type `u16` -- write `Int`"))
  assert(check_source_err_contains(source = "let g = () -> u64 { 1 }", needle = "unknown type `u64` -- write `Int`"))
  assert(check_source_err_contains(source = "struct u8 { v: Int }\nfn main() -> Int { 0 }", needle = "`u8` is reserved"))
  assert(check_source_err_contains(source = "type Alias[u32] = Int\nfn main() -> Int { 0 }", needle = "rename this type parameter: `u32` is reserved"))
}

test "v128 still resolves in aliases and effects" {
  assert(check_source_ok("type Lane = v128\nfn main() -> Int { 0 }"))
  assert(check_source_ok("effect E {\n  Op(v128) -> v128\n}\nfn main() -> Int { 0 }"))
}

test "a program's own type spelled like a fixed-width integer is untouched" {
  assert(check_source_ok("struct usize { value: Int }\ntype Size = usize\nfn main() -> Int { 0 }"))
  assert(check_source_ok("struct usize { value: Int }\neffect E {\n  Op() -> usize\n}\nfn main() -> Int { 0 }"))
}

test "an unresolved fixed-width spelling names the edit" {
  assert(check_source_err_contains(source = "fn f(x: usize) -> Int { 1 }", needle = "write `Int`"))
}
