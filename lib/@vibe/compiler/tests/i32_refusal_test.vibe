//# Imports

import ./checker_parity_test_support.vibe {
  check_source_err_contains, check_source_ok
}

//# Misc

// #3727: `i32` used to resolve to the 63-bit `Int`. It is no type now, and
// no declaration or type parameter may take the name, so the parser refuses
// it in every type position -- including those the checker's unknown-type
// check never visits (an alias body, an effect operation, a trait method, a
// row argument). The refusal must not reach names that DO resolve: `i64` /
// `u8` .. `u64` / `i16` / `v128` are their own builtin types, and a program
// may declare a type called `usize`.

fn i32_edit() -> String {
  "unknown type `i32` -- write `Int`"
}

test "i32 is refused in every type position" {
  assert(check_source_err_contains("fn f(x: i32) -> Int { 1 }", i32_edit()))
  assert(check_source_err_contains("type Word = i32\nfn main() -> Int { 0 }", i32_edit()))
  assert(check_source_err_contains("effect E {\n  Op() -> i32\n}\nfn main() -> Int { 0 }", i32_edit()))
  // A trait method's signature: the checker relaxes an unresolved name there
  // to `CtUnknown`, which would let a wrong return type check.
  assert(check_source_err_contains("trait Produce {\n  produce(Self) -> i32\n}\nfn main() -> Int { 0 }", i32_edit()))
  assert(check_source_err_contains("type Word = i32[Int]\nfn main() -> Int { 0 }", i32_edit()))
  assert(check_source_err_contains("struct Box[T] { value: T }\ntype Word = Box[i32]\nfn main() -> Int { 0 }", i32_edit()))
  assert(check_source_err_contains("effect Ask[T] {\n  Get() -> T\n}\nfn f(g: () -> Int with Ask[i32]) -> Int { 0 }\nfn main() -> Int { 0 }", i32_edit()))
}

test "i32 is reserved as a declaration and a type-parameter name" {
  assert(check_source_err_contains("struct i32 { v: Int }\nfn main() -> Int { 0 }", "`i32` is reserved"))
  assert(check_source_err_contains("struct i32[T] { value: T }\nfn main() -> Int { 0 }", "`i32` is reserved"))
  assert(check_source_err_contains("type Alias[i32] = Int\nfn main() -> Int { 0 }", "rename this type parameter: `i32` is reserved"))
}

test "the other builtin fixed-width types still resolve in aliases and effects" {
  assert(check_source_ok("type Word = i64\nfn main() -> Int { 0 }"))
  assert(check_source_ok("type Byte = u8\ntype Lane = v128\nfn main() -> Int { 0 }"))
  assert(check_source_ok("effect E {\n  Op(i64) -> u32\n}\nfn main() -> Int { 0 }"))
}

test "a program's own type spelled like a fixed-width integer is untouched" {
  assert(check_source_ok("struct usize { value: Int }\ntype Size = usize\nfn main() -> Int { 0 }"))
  assert(check_source_ok("struct usize { value: Int }\neffect E {\n  Op() -> usize\n}\nfn main() -> Int { 0 }"))
}

test "an unresolved fixed-width spelling names the edit" {
  assert(check_source_err_contains("fn f(x: usize) -> Int { 1 }", "write `Int`"))
}
