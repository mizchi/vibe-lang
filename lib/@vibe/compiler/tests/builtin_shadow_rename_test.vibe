import @vibe/ast {
  Expr, Stmt, builtin_ref
}
import @vibe/compiler/core {
  builtin_shadow_rename_of, rename_builtin_shadow_defs
}

// #3132: a program's own definition of a builtin the compiler calls by name
// moves to a spelling of its own, and so does every reference to it -- located
// or not. Only a reference the compiler MARKED as the builtin (`builtin_ref`)
// keeps the builtin's name. Provenance is the mark, never the offset: an
// interpolated expression is re-parsed without offsets, and the library lanes
// parse whole programs that way (#3132 review).

fn one_param_fn(name: String, param: String, body: Expr) -> Stmt {
  SLet(false, false, name, None, EFn([], [], [(param, None)], None, None, body))
}

fn let_name(s: Stmt) -> String {
  match s {
    SLet(_, _, n, _, _) => n,
    _ => ""
  }
}

fn callee_of_body(s: Stmt) -> String {
  match s {
    SLet(_, _, _, _, EFn(_, _, _, _, _, ECall(EIdent(n, _), _, _))) => n,
    _ => ""
  }
}

test "#3132: the definition and the program's own calls are renamed" {
  let def = one_param_fn("Array::length", "xs", EInt(77))
  let user_call = one_param_fn("caller", "xs", ECall(EIdent("Array::length", 40), [
    EIdent("xs", 55)
  ], 40))
  // What an interpolation's re-parse or an unlocated lane hands the pass: the
  // program's own call with no source offset.
  let unlocated_user_call = one_param_fn("interp", "xs", ECall(EIdent("Array::length", -1), [
    EIdent("xs", -1)
  ], -1))
  let synthesized = one_param_fn("lowered", "xs", ECall(builtin_ref("Array::length"), [
    EIdent("xs", -1)
  ], -1))
  let stmts = [def, user_call, unlocated_user_call, synthesized]
  rename_builtin_shadow_defs(stmts)
  assert_eq(let_name(Array::get(stmts, 0)), builtin_shadow_rename_of("Array::length"))
  assert_eq(callee_of_body(Array::get(stmts, 1)), "Array::length$user")
  assert_eq(callee_of_body(Array::get(stmts, 2)), "Array::length$user")
  assert_eq(callee_of_body(Array::get(stmts, 3)), "Array::length")
}

test "#3132: nothing is renamed without a definition, or for an unlisted name" {
  let user_call = one_param_fn("caller", "xs", ECall(EIdent("Array::length", 40), [
    EIdent("xs", 55)
  ], 40))
  let own = one_param_fn("Array::iter_get_helper", "xs", EInt(1))
  let stmts = [user_call, own]
  rename_builtin_shadow_defs(stmts)
  assert_eq(callee_of_body(Array::get(stmts, 0)), "Array::length")
  assert_eq(let_name(Array::get(stmts, 1)), "Array::iter_get_helper")
}

test "#3132: Map::iter_get keeps its source definition's name (#2379)" {
  let def = one_param_fn("Map::iter_get", "m", EIdent("m", 20))
  let stmts = [def]
  rename_builtin_shadow_defs(stmts)
  assert_eq(let_name(Array::get(stmts, 0)), "Map::iter_get")
}

fn export_items(s: Stmt) -> String {
  match s {
    SExport(items) => String::join(items, ","),
    _ => ""
  }
}

test "#3144: an export block names the renamed definition" {
  let def = one_param_fn("Array::length", "xs", EInt(77))
  let other = one_param_fn("helper", "xs", EInt(1))
  let stmts = [def, other, SExport(["Array::length", "helper"])]
  rename_builtin_shadow_defs(stmts)
  assert_eq(export_items(Array::get(stmts, 2)), "Array::length$user,helper")
}

test "#3144: a second run renames a reference written after the first" {
  let def = one_param_fn("String::length", "s", EInt(42))
  let stmts = [def]
  rename_builtin_shadow_defs(stmts)
  // What a later pass writes by COMPUTING the name (a trait witness field),
  // beside one it spells as the builtin.
  Array::push(stmts, one_param_fn("witness", "s", ECall(EIdent("String::length", -1), [
    EIdent("s", -1)
  ], -1)))
  Array::push(stmts, one_param_fn("lowered", "s", ECall(builtin_ref("String::length"), [
    EIdent("s", -1)
  ], -1)))
  rename_builtin_shadow_defs(stmts)
  assert_eq(let_name(Array::get(stmts, 0)), "String::length$user")
  assert_eq(callee_of_body(Array::get(stmts, 1)), "String::length$user")
  assert_eq(callee_of_body(Array::get(stmts, 2)), "String::length")
}
