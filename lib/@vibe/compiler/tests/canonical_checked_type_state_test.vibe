import @vibe/compiler/checker {
  CheckedProgram,
  CheckedProgramTypeDefsObservation,
  canonical_checked_type_defs_snapshot,
  canonical_checked_value_env_snapshot,
  canonical_effective_value_env_snapshot,
  canonical_retained_trait_impl_entries_snapshot,
  check_program_result
}

import @vibe/compiler/core {
  Expr, Stmt, Subst, Type, TypeDef, TypeEnv
}

import @vibe/core {
  array_empty
}

fn snapshot(env: TypeEnv, subst: Subst) -> String {
  canonical_effective_value_env_snapshot(env, subst)
}

fn typedef_observation(defs: Array[TypeDef], binders: Array[Array[Int]], subst: Subst) -> CheckedProgramTypeDefsObservation {
  CheckedProgramTypeDefsObservation::{
    // This original-shape literal is intentionally source-compatible.
    checked_program: CheckedProgram::{
      checked_stmts: array_empty(),
      final_env: EnvEmpty,
      type_defs: defs,
      final_subst: subst,
      typed_occurrences: array_empty()
    },
    type_def_binders: binders
  }
}

fn typedef_snapshot(defs: Array[TypeDef], binders: Array[Array[Int]], subst: Subst) -> String {
  canonical_checked_type_defs_snapshot(typedef_observation(defs, binders, subst))
}

fn trait_impl_snapshot(env: TypeEnv, subst: Subst) -> String {
  canonical_retained_trait_impl_entries_snapshot(env, subst)
}

test "canonical checked state preserves EnvBind EnvFlat and EnvCached first-match shadows" {
  let bind_flat = EnvBind("__fn_ret__:bind", CtUnit, EnvBind("value", CtInt, EnvFlat([
    ("value", CtBool),
    ("outer", CtString),
    ("__fn_ret__:flat", CtDouble)
  ])))
  let expected = EnvFlat([
    ("outer", CtString),
    ("value", CtInt)
  ])
  assert(snapshot(bind_flat, SubstEmpty) == snapshot(expected, SubstEmpty))
  let cached = EnvCached([
    "alpha",
    "alpha",
    "__fn_ret__:cached",
    "z"
  ], [
    CtBool,
    CtInt,
    CtDouble,
    CtString
  ], EnvBind("z", CtUnit, EnvEmpty))
  let cached_expected = EnvBind("alpha", CtBool, EnvBind("z", CtString, EnvEmpty))
  assert(snapshot(cached, SubstEmpty) == snapshot(cached_expected, SubstEmpty))
}

test "canonical checked state shares free alpha variables across sorted values" {
  let left = EnvFlat([
    ("z", CtVar(91)),
    ("a", CtVar(91))
  ])
  let alpha_equivalent = EnvFlat([
    ("a", CtVar(4)),
    ("z", CtVar(4))
  ])
  let changed_relation = EnvFlat([
    ("a", CtVar(4)),
    ("z", CtVar(5))
  ])
  assert(snapshot(left, SubstEmpty) == snapshot(alpha_equivalent, SubstEmpty))
  assert(snapshot(left, SubstEmpty) != snapshot(changed_relation, SubstEmpty))
}

test "canonical checked state alpha-normalizes forall bounds without moving them" {
  let left = CtForAll([
    31,
    44
  ], [
    (44, [
      "Ord",
      "Eq",
      "Eq"
    ]),
    (31, [
      "Show"
    ])
  ], CtTuple([
    CtVar(31),
    CtVar(44)
  ]))
  let reordered = CtForAll([
    8,
    9
  ], [
    (8, [
      "Show"
    ]),
    (9, [
      "Eq",
      "Ord"
    ])
  ], CtTuple([
    CtVar(8),
    CtVar(9)
  ]))
  let moved = CtForAll([
    8,
    9
  ], [
    (8, [
      "Eq",
      "Ord"
    ]),
    (9, [
      "Show"
    ])
  ], CtTuple([
    CtVar(8),
    CtVar(9)
  ]))
  assert(snapshot(EnvFlat([
    ("f", left)
  ]), SubstEmpty) == snapshot(EnvFlat([
    ("f", reordered)
  ]), SubstEmpty))
  assert(snapshot(EnvFlat([
    ("f", left)
  ]), SubstEmpty) != snapshot(EnvFlat([
    ("f", moved)
  ]), SubstEmpty))
}

test "canonical checked state keeps quantified ids out of substitution" {
  let source = CtForAll([
    7
  ], [
    (7, [
      "Eq"
    ])
  ], CtTuple([
    CtVar(7),
    CtVar(8)
  ]))
  let subst = SubstBind(7, CtString, SubstBind(8, CtInt, SubstEmpty))
  let expected = CtForAll([
    99
  ], [
    (99, [
      "Eq"
    ])
  ], CtTuple([
    CtVar(99),
    CtInt
  ]))
  assert(snapshot(EnvFlat([
    ("f", source)
  ]), subst) == snapshot(EnvFlat([
    ("f", expected)
  ]), SubstEmpty))
}

test "canonical checked state sorts effect rows and resolves effect substitutions" {
  let permuted = CtFn([
    CtInt
  ], CtUnit, Some("Fs, Exception, State[Int], State[String], Fs"))
  let normalized = CtFn([
    CtInt
  ], CtUnit, Some("State[String], Error, State[Int], Fs"))
  let via_var = CtFn([
    CtInt
  ], CtUnit, Some("e"))
  let effect_subst = SubstEffBind("e", "State[String], Fs, State[Int], Fs", SubstEmpty)
  assert(snapshot(EnvFlat([
    ("f", permuted)
  ]), SubstEmpty) == snapshot(EnvFlat([
    ("f", normalized)
  ]), SubstEmpty))
  assert(snapshot(EnvFlat([
    ("f", via_var)
  ]), effect_subst) == snapshot(EnvFlat([
    ("f", CtFn([
      CtInt
    ], CtUnit, Some("Fs, State[Int], State[String]")))
  ]), SubstEmpty))
  assert(snapshot(EnvFlat([
    ("f", CtFn([
    ], CtUnit, Some("State[Int]")))
  ]), SubstEmpty) != snapshot(EnvFlat([
    ("f", CtFn([
    ], CtUnit, Some("State[String]")))
  ]), SubstEmpty))
}

test "canonical enum provenance uses declared binder positions" {
  let second_only = typedef_snapshot([
    TDEnum("Choice", [
      "A",
      "B"
    ], [
      ("Only", [
        CtVar(91)
      ])
    ])
  ], [
    [
      12,
      91
    ]
  ], SubstBind(91, CtString, SubstEmpty))
  let alpha_equivalent = typedef_snapshot([
    TDEnum("Choice", [
      "X",
      "Y"
    ], [
      ("Only", [
        CtVar(4)
      ])
    ])
  ], [
    [
      3,
      4
    ]
  ], SubstBind(4, CtBool, SubstEmpty))
  let first_only = typedef_snapshot([
    TDEnum("Choice", [
      "X",
      "Y"
    ], [
      ("Only", [
        CtVar(3)
      ])
    ])
  ], [
    [
      3,
      4
    ]
  ], SubstEmpty)
  assert(second_only == alpha_equivalent)
  // If enum variables were normalized by first occurrence, these would collide.
  assert(second_only != first_only)
}

test "canonical retained typedefs alpha-normalize rigid params and effect rows" {
  let left = typedef_snapshot([
    TDStruct("Box", [
      ("value", CtNamed("T", array_empty()))
    ], [
      "value"
    ], [
      "T"
    ]),
    TDAlias("Wrapped", [
      "T"
    ], CtNamed("T", array_empty())),
    TDEffect("Reader", [
      ("ask", array_empty(), CtFn(array_empty(), CtNamed("T", array_empty()), Some("Exception, State[T], State[T]")))
    ], [
      "T"
    ])
  ], [
    array_empty(),
    array_empty(),
    array_empty()
  ], SubstEmpty)
  let alpha = typedef_snapshot([
    TDStruct("Box", [
      ("value", CtNamed("X", array_empty()))
    ], [
      "value"
    ], [
      "X"
    ]),
    TDAlias("Wrapped", [
      "X"
    ], CtNamed("X", array_empty())),
    TDEffect("Reader", [
      ("ask", array_empty(), CtFn(array_empty(), CtNamed("X", array_empty()), Some("State[X], Error")))
    ], [
      "X"
    ])
  ], [
    array_empty(),
    array_empty(),
    array_empty()
  ], SubstEmpty)
  assert(left == alpha)
}

test "canonical retained typedefs preserve definition and member order" {
  let ordered = typedef_snapshot([
    TDEnum("First", array_empty(), [
      ("A", array_empty()),
      ("B", array_empty())
    ]),
    TDStruct("Second", [
      ("x", CtInt),
      ("y", CtString)
    ], array_empty(), array_empty())
  ], [
    array_empty(),
    array_empty()
  ], SubstEmpty)
  let changed_members = typedef_snapshot([
    TDEnum("First", array_empty(), [
      ("B", array_empty()),
      ("A", array_empty())
    ]),
    TDStruct("Second", [
      ("x", CtInt),
      ("y", CtString)
    ], array_empty(), array_empty())
  ], [
    array_empty(),
    array_empty()
  ], SubstEmpty)
  let changed_defs = typedef_snapshot([
    TDStruct("Second", [
      ("x", CtInt),
      ("y", CtString)
    ], array_empty(), array_empty()),
    TDEnum("First", array_empty(), [
      ("A", array_empty()),
      ("B", array_empty())
    ])
  ], [
    array_empty(),
    array_empty()
  ], SubstEmpty)
  let changed_mutability = typedef_snapshot([
    TDEnum("First", array_empty(), [
      ("A", array_empty()),
      ("B", array_empty())
    ]),
    TDStruct("Second", [
      ("x", CtInt),
      ("y", CtString)
    ], [
      "y"
    ], array_empty())
  ], [
    array_empty(),
    array_empty()
  ], SubstEmpty)
  assert(ordered != changed_members)
  assert(ordered != changed_defs)
  assert(ordered != changed_mutability)
}

test "canonical checked wrappers isolate value and typedef observations" {
  // String ordering must be lexical, not the runtime's length-first ordering.
  let ordered = snapshot(EnvFlat([
    ("aa", CtInt),
    ("a", CtBool)
  ]), SubstEmpty)
  let expected = snapshot(EnvFlat([
    ("a", CtBool),
    ("aa", CtInt)
  ]), SubstEmpty)
  assert(ordered == expected)
  let type_defs = [
    TDEnum("Kept", array_empty(), [
      ("K", [
        CtInt
      ])
    ])
  ]
  // Old CheckedProgram literals remain source-compatible without provenance.
  let first = CheckedProgram::{
    checked_stmts: array_empty(),
    final_env: EnvFlat([
      ("value", CtInt)
    ]),
    type_defs: type_defs,
    final_subst: SubstEmpty,
    typed_occurrences: array_empty()
  }
  let second = CheckedProgram::{
    checked_stmts: [
      SLet(false, false, "ignored", None, EInt(1))
    ],
    final_env: EnvBind("other", CtString, EnvTraitImpl("Eq", CtInt, EnvEmpty)),
    type_defs: type_defs,
    final_subst: SubstEmpty,
    typed_occurrences: [
      (99, CtString)
    ]
  }
  let value_only = CheckedProgram::{
    checked_stmts: array_empty(),
    final_env: EnvFlat([
      ("value", CtInt)
    ]),
    type_defs: array_empty(),
    final_subst: SubstEmpty,
    typed_occurrences: array_empty()
  }
  let binders = [
    array_empty()
  ]
  let first_observation = CheckedProgramTypeDefsObservation::{
    checked_program: first,
    type_def_binders: binders
  }
  let second_observation = CheckedProgramTypeDefsObservation::{
    checked_program: second,
    type_def_binders: binders
  }
  assert(canonical_checked_type_defs_snapshot(first_observation) == canonical_checked_type_defs_snapshot(second_observation))
  assert(canonical_checked_value_env_snapshot(first) == canonical_checked_value_env_snapshot(value_only))
}

test "canonical trait impl snapshot retains entries in final-env traversal order" {
  let retained = EnvBind("value", CtInt, EnvTraitImpl("Later", CtString, EnvTraitDef("Ignored", array_empty(), false, array_empty(), EnvCached([
    "cached"
  ], [
    CtBool
  ], EnvTraitImpl("Earlier", CtInt, EnvEmpty)))))
  let expected = EnvTraitImpl("Later", CtString, EnvTraitImpl("Earlier", CtInt, EnvEmpty))
  assert(trait_impl_snapshot(retained, SubstEmpty) == trait_impl_snapshot(expected, SubstEmpty))
  assert(trait_impl_snapshot(EnvFlat([
    ("not_traversed", CtInt)
  ]), SubstEmpty) == trait_impl_snapshot(EnvEmpty, SubstEmpty))
}

test "canonical trait impl snapshot alpha-normalizes generic bounds by declared position" {
  let left = EnvTraitImplGen("Map", [
    "T",
    "U"
  ], [
    ("U", [
      "Ord",
      "Eq"
    ]),
    ("T", [
      "Show"
    ])
  ], CtNamed("Box", array_empty()), EnvEmpty)
  let alpha = EnvTraitImplGen("Map", [
    "X",
    "Y"
  ], [
    ("Y", [
      "Ord",
      "Eq"
    ]),
    ("X", [
      "Show"
    ])
  ], CtNamed("Box", array_empty()), EnvEmpty)
  let moved_association = EnvTraitImplGen("Map", [
    "X",
    "Y"
  ], [
    ("X", [
      "Ord",
      "Eq"
    ]),
    ("Y", [
      "Show"
    ])
  ], CtNamed("Box", array_empty()), EnvEmpty)
  let reordered_rows_and_labels = EnvTraitImplGen("Map", [
    "X",
    "Y"
  ], [
    ("X", [
      "Show"
    ]),
    ("Y", [
      "Eq"
    ]),
    ("Y", [
      "Ord",
      "Eq"
    ])
  ], CtNamed("Box", array_empty()), EnvEmpty)
  assert(trait_impl_snapshot(left, SubstEmpty) == trait_impl_snapshot(alpha, SubstEmpty))
  assert(trait_impl_snapshot(left, SubstEmpty) == trait_impl_snapshot(reordered_rows_and_labels, SubstEmpty))
  assert(trait_impl_snapshot(left, SubstEmpty) != trait_impl_snapshot(moved_association, SubstEmpty))
}

test "canonical trait impl snapshot keeps erased generic targets nominal" {
  let colliding_name = EnvTraitImplGen("Tr", [
    "Box"
  ], array_empty(), CtNamed("Box", array_empty()), EnvEmpty)
  let alpha_renamed = EnvTraitImplGen("Tr", [
    "T"
  ], array_empty(), CtNamed("Box", array_empty()), EnvEmpty)
  let other_constructor = EnvTraitImplGen("Tr", [
    "Other"
  ], array_empty(), CtNamed("Other", array_empty()), EnvEmpty)
  assert(trait_impl_snapshot(colliding_name, SubstEmpty) == trait_impl_snapshot(alpha_renamed, SubstEmpty))
  assert(trait_impl_snapshot(colliding_name, SubstEmpty) != trait_impl_snapshot(other_constructor, SubstEmpty))
}

test "canonical trait impl snapshot applies final substitution and fails closed for malformed bounds" {
  let substituted = EnvTraitImpl("Eq", CtVar(81), EnvEmpty)
  let resolved = EnvTraitImpl("Eq", CtString, EnvEmpty)
  assert(trait_impl_snapshot(substituted, SubstBind(81, CtString, SubstEmpty)) == trait_impl_snapshot(resolved, SubstEmpty))
  let unbound = trait_impl_snapshot(EnvTraitImplGen("Map", [
    "T"
  ], [
    ("Missing", [
      "Eq"
    ])
  ], CtNamed("Box", array_empty()), EnvEmpty), SubstEmpty)
  let ambiguous = trait_impl_snapshot(EnvTraitImplGen("Map", [
    "T",
    "T"
  ], [
    ("T", [
      "Eq"
    ])
  ], CtNamed("Box", array_empty()), EnvEmpty), SubstEmpty)
  assert(String::contains(unbound, "unbound_bound_parameter"))
  assert(String::contains(unbound, "Missing"))
  assert(String::contains(ambiguous, "ambiguous_bound_parameter"))
  assert(unbound != ambiguous)
}

test "canonical trait impl snapshot observes real checker registrations" {
  let checked = check_program_result([
    STrait(false, "Observed", array_empty(), array_empty(), array_empty()),
    SImpl([
      "T"
    ], [
      ("T", [
        "Eq",
        "Show"
      ])
    ], "Observed", "Box"),
    SImpl(array_empty(), array_empty(), "Observed", "Int")
  ])
  let snapshot = canonical_retained_trait_impl_entries_snapshot(checked.final_env, checked.final_subst)
  assert(String::contains(snapshot, "Observed"))
  assert(String::contains(snapshot, "Box"))
  assert(String::contains(snapshot, "Eq"))
  assert(String::contains(snapshot, "Show"))
}

test "canonical typedef snapshot marks missing provenance" {
  let snapshot = typedef_snapshot([
    TDEnum("Missing", [
      "T"
    ], array_empty())
  ], array_empty(), SubstEmpty)
  assert(String::contains(snapshot, "array_count_mismatch"))
  assert(String::contains(snapshot, "missing_metadata"))
  assert(String::contains(snapshot, "position"))
  assert(String::contains(snapshot, "enum"))
}

test "canonical typedef snapshot marks surplus provenance" {
  let snapshot = typedef_snapshot(array_empty(), [
    array_empty()
  ], SubstEmpty)
  assert(String::contains(snapshot, "array_count_mismatch"))
  assert(String::contains(snapshot, "surplus_metadata"))
  assert(String::contains(snapshot, "position"))
  assert(String::contains(snapshot, "none"))
}

test "canonical typedef snapshot marks wrong enum binder length" {
  let snapshot = typedef_snapshot([
    TDEnum("Wrong", [
      "A",
      "B"
    ], array_empty())
  ], [
    [
      7
    ]
  ], SubstEmpty)
  assert(String::contains(snapshot, "enum_binder_count_mismatch"))
  assert(String::contains(snapshot, "expected_binders"))
  assert(String::contains(snapshot, "actual_binders"))
  assert(String::contains(snapshot, "enum"))
}

test "canonical typedef snapshot marks non-enum binders" {
  let snapshot = typedef_snapshot([
    TDStruct("Wrong", array_empty(), array_empty(), array_empty())
  ], [
    [
      7
    ]
  ], SubstEmpty)
  assert(String::contains(snapshot, "non_enum_binders"))
  assert(String::contains(snapshot, "position"))
  assert(String::contains(snapshot, "struct"))
  assert(String::contains(snapshot, "actual_binders"))
}
