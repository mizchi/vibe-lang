import @vibe/compiler/checker {
  CheckedProgram,
  CheckedProgramTypeDefsObservation,
  canonical_checked_type_defs_snapshot,
  canonical_checked_value_env_snapshot,
  canonical_effective_value_env_snapshot,
  canonical_retained_trait_impl_entries_snapshot,
  canonical_retained_trait_method_gens_snapshot,
  check_program_result
}

import @vibe/compiler/core {
  Expr, Stmt, Subst, Type, TypeDef, TypeEnv, TypeExpr, env_cached, env_value_binding, sort_perm_by_names, str_lt
}

import @vibe/core {
  array_empty
}

fn snapshot(env: TypeEnv, subst: Subst) -> String {
  canonical_effective_value_env_snapshot(env = env, s = subst)
}

test "typed String ordering is lexical for prefixes and Array values" {
  assert(str_lt(a = "a", b = "aa"))
  assert(str_lt(a = "ab", b = "b"))
  assert(!str_lt(a = "b", b = "ab"))
  assert(!str_lt(a = "same", b = "same"))
  let names = ["b", "aa", "a", "ab"]
  let perm = sort_perm_by_names(names)
  assert(Array::get(perm, at = 0) == 2)
  assert(Array::get(perm, at = 1) == 1)
  assert(Array::get(perm, at = 2) == 3)
  assert(Array::get(perm, at = 3) == 0)
}

fn typedef_observation(defs: Array[TypeDef], binders: Array[Array[Int]], subst: Subst) -> CheckedProgramTypeDefsObservation {
  CheckedProgramTypeDefsObservation::{
    // This original-shape literal is intentionally source-compatible.
    checked_program: CheckedProgram::{
      checked_stmts: array_empty(),
      final_env: EnvEmpty,
      type_defs: defs,
      final_subst: subst,
      typed_occurrences: array_empty()
    },
    type_def_binders: binders
  }
}

fn typedef_snapshot(defs: Array[TypeDef], binders: Array[Array[Int]], subst: Subst) -> String {
  canonical_checked_type_defs_snapshot(typedef_observation(defs = defs, binders = binders, subst = subst))
}

fn trait_impl_snapshot(env: TypeEnv, subst: Subst) -> String {
  canonical_retained_trait_impl_entries_snapshot(env = env, s = subst)
}

fn trait_method_gens_snapshot(_ env: TypeEnv) -> String {
  canonical_retained_trait_method_gens_snapshot(env)
}

test "canonical checked state preserves EnvBind EnvFlat and EnvCached first-match shadows" {
  let bind_flat = EnvBind("__fn_ret__:bind", env_value_binding(CtUnit), EnvBind("value", env_value_binding(CtInt), EnvFlat([
    ("value", env_value_binding(CtBool)),
    ("outer", env_value_binding(CtString)),
    ("__fn_ret__:flat", env_value_binding(CtDouble))
  ])))
  let expected = EnvFlat([
    ("outer", env_value_binding(CtString)),
    ("value", env_value_binding(CtInt))
  ])
  assert(snapshot(env = bind_flat, subst = SubstEmpty) == snapshot(env = expected, subst = SubstEmpty))
  let cached = env_cached(names = ["alpha", "alpha", "__fn_ret__:cached", "z"], bindings = [
    env_value_binding(CtBool),
    env_value_binding(CtInt),
    env_value_binding(CtDouble),
    env_value_binding(CtString)
  ], rest = EnvBind("z", env_value_binding(CtUnit), EnvEmpty))
  let cached_expected = EnvBind("alpha", env_value_binding(CtBool), EnvBind("z", env_value_binding(CtString), EnvEmpty))
  assert(snapshot(env = cached, subst = SubstEmpty) == snapshot(env = cached_expected, subst = SubstEmpty))
}

test "canonical checked state shares free alpha variables across sorted values" {
  let left = EnvFlat([
    ("z", env_value_binding(CtVar(91))),
    ("a", env_value_binding(CtVar(91)))
  ])
  let alpha_equivalent = EnvFlat([
    ("a", env_value_binding(CtVar(4))),
    ("z", env_value_binding(CtVar(4)))
  ])
  let changed_relation = EnvFlat([
    ("a", env_value_binding(CtVar(4))),
    ("z", env_value_binding(CtVar(5)))
  ])
  assert(snapshot(env = left, subst = SubstEmpty) == snapshot(env = alpha_equivalent, subst = SubstEmpty))
  assert(snapshot(env = left, subst = SubstEmpty) != snapshot(env = changed_relation, subst = SubstEmpty))
}

test "canonical checked state alpha-normalizes forall bounds without moving them" {
  let left = CtForAll([31, 44], [(44, ["Ord", "Eq", "Eq"]), (31, ["Show"])], CtTuple([
    CtVar(31),
    CtVar(44)
  ]))
  let reordered = CtForAll([8, 9], [(8, ["Show"]), (9, ["Eq", "Ord"])], CtTuple([
    CtVar(8),
    CtVar(9)
  ]))
  let moved = CtForAll([8, 9], [(8, ["Eq", "Ord"]), (9, ["Show"])], CtTuple([
    CtVar(8),
    CtVar(9)
  ]))
  assert(snapshot(env = EnvFlat([("f", env_value_binding(left))]), subst = SubstEmpty) == snapshot(env = EnvFlat([
    ("f", env_value_binding(reordered))
  ]), subst = SubstEmpty))
  assert(snapshot(env = EnvFlat([("f", env_value_binding(left))]), subst = SubstEmpty) != snapshot(env = EnvFlat([
    ("f", env_value_binding(moved))
  ]), subst = SubstEmpty))
}

test "canonical checked state keeps quantified ids out of substitution" {
  let source = CtForAll([7], [(7, ["Eq"])], CtTuple([CtVar(7), CtVar(8)]))
  let subst = SubstBind(7, CtString, SubstBind(8, CtInt, SubstEmpty))
  let expected = CtForAll([99], [(99, ["Eq"])], CtTuple([CtVar(99), CtInt]))
  assert(snapshot(env = EnvFlat([("f", env_value_binding(source))]), subst = subst) == snapshot(env = EnvFlat([
    ("f", env_value_binding(expected))
  ]), subst = SubstEmpty))
}

test "canonical checked state sorts effect rows and resolves effect substitutions" {
  let permuted = CtFn([CtInt], CtUnit, Some("Fs, Exception, State[Int], State[String], Fs"))
  let normalized = CtFn([CtInt], CtUnit, Some("State[String], Error, State[Int], Fs"))
  let via_var = CtFn([CtInt], CtUnit, Some("e"))
  let effect_subst = SubstEffBind("e", "State[String], Fs, State[Int], Fs", SubstEmpty)
  assert(snapshot(env = EnvFlat([("f", env_value_binding(permuted))]), subst = SubstEmpty) == snapshot(env = EnvFlat([
    ("f", env_value_binding(normalized))
  ]), subst = SubstEmpty))
  assert(snapshot(env = EnvFlat([("f", env_value_binding(via_var))]), subst = effect_subst) == snapshot(env = EnvFlat([
    ("f", env_value_binding(CtFn([CtInt], CtUnit, Some("Fs, State[Int], State[String]"))))
  ]), subst = SubstEmpty))
  assert(snapshot(env = EnvFlat([
    ("f", env_value_binding(CtFn([], CtUnit, Some("State[Int]"))))
  ]), subst = SubstEmpty) != snapshot(env = EnvFlat([
    ("f", env_value_binding(CtFn([], CtUnit, Some("State[String]"))))
  ]), subst = SubstEmpty))
}

test "canonical enum provenance uses declared binder positions" {
  let second_only = typedef_snapshot(defs = [
    TDEnum("Choice", ["A", "B"], [("Only", [CtVar(91)])])
  ], binders = [[12, 91]], subst = SubstBind(91, CtString, SubstEmpty))
  let alpha_equivalent = typedef_snapshot(defs = [
    TDEnum("Choice", ["X", "Y"], [("Only", [CtVar(4)])])
  ], binders = [[3, 4]], subst = SubstBind(4, CtBool, SubstEmpty))
  let first_only = typedef_snapshot(defs = [
    TDEnum("Choice", ["X", "Y"], [("Only", [CtVar(3)])])
  ], binders = [[3, 4]], subst = SubstEmpty)
  assert(second_only == alpha_equivalent)
  // If enum variables were normalized by first occurrence, these would collide.
  assert(second_only != first_only)
}

test "canonical retained typedefs alpha-normalize rigid params and effect rows" {
  let left = typedef_snapshot(defs = [
    TDStruct("Box", [("value", CtNamed("T", array_empty()))], ["value"], ["T"]),
    TDAlias("Wrapped", ["T"], CtNamed("T", array_empty())),
    TDEffect("Reader", [
      ("ask", array_empty(), CtFn(array_empty(), CtNamed("T", array_empty()), Some("Exception, State[T], State[T]")))
    ], ["T"], [""])
  ], binders = [array_empty(), array_empty(), array_empty()], subst = SubstEmpty)
  let alpha = typedef_snapshot(defs = [
    TDStruct("Box", [("value", CtNamed("X", array_empty()))], ["value"], ["X"]),
    TDAlias("Wrapped", ["X"], CtNamed("X", array_empty())),
    TDEffect("Reader", [
      ("ask", array_empty(), CtFn(array_empty(), CtNamed("X", array_empty()), Some("State[X], Error")))
    ], ["X"], [""])
  ], binders = [array_empty(), array_empty(), array_empty()], subst = SubstEmpty)
  assert(left == alpha)
}

test "canonical retained typedefs preserve definition and member order" {
  let ordered = typedef_snapshot(defs = [
    TDEnum("First", array_empty(), [("A", array_empty()), ("B", array_empty())]),
    TDStruct("Second", [("x", CtInt), ("y", CtString)], array_empty(), array_empty())
  ], binders = [array_empty(), array_empty()], subst = SubstEmpty)
  let changed_members = typedef_snapshot(defs = [
    TDEnum("First", array_empty(), [("B", array_empty()), ("A", array_empty())]),
    TDStruct("Second", [("x", CtInt), ("y", CtString)], array_empty(), array_empty())
  ], binders = [array_empty(), array_empty()], subst = SubstEmpty)
  let changed_defs = typedef_snapshot(defs = [
    TDStruct("Second", [("x", CtInt), ("y", CtString)], array_empty(), array_empty()),
    TDEnum("First", array_empty(), [("A", array_empty()), ("B", array_empty())])
  ], binders = [array_empty(), array_empty()], subst = SubstEmpty)
  let changed_mutability = typedef_snapshot(defs = [
    TDEnum("First", array_empty(), [("A", array_empty()), ("B", array_empty())]),
    TDStruct("Second", [("x", CtInt), ("y", CtString)], ["y"], array_empty())
  ], binders = [array_empty(), array_empty()], subst = SubstEmpty)
  assert(ordered != changed_members)
  assert(ordered != changed_defs)
  assert(ordered != changed_mutability)
}

test "canonical checked wrappers isolate value and typedef observations" {
  // String ordering must be lexical, not the runtime's length-first ordering.
  let ordered = snapshot(env = EnvFlat([
    ("aa", env_value_binding(CtInt)),
    ("a", env_value_binding(CtBool))
  ]), subst = SubstEmpty)
  let expected = snapshot(env = EnvFlat([
    ("a", env_value_binding(CtBool)),
    ("aa", env_value_binding(CtInt))
  ]), subst = SubstEmpty)
  assert(ordered == expected)
  let type_defs = [TDEnum("Kept", array_empty(), [("K", [CtInt])])]
  // Old CheckedProgram literals remain source-compatible without provenance.
  let first = CheckedProgram::{
    checked_stmts: array_empty(),
    final_env: EnvFlat([("value", env_value_binding(CtInt))]),
    type_defs: type_defs,
    final_subst: SubstEmpty,
    typed_occurrences: array_empty()
  }
  let second = CheckedProgram::{
    checked_stmts: [SLet(false, false, "ignored", None, EInt(1))],
    final_env: EnvBind("other", env_value_binding(CtString), EnvTraitImpl("Eq", CtInt, EnvEmpty)),
    type_defs: type_defs,
    final_subst: SubstEmpty,
    typed_occurrences: [(99, CtString)]
  }
  let value_only = CheckedProgram::{
    checked_stmts: array_empty(),
    final_env: EnvFlat([("value", env_value_binding(CtInt))]),
    type_defs: array_empty(),
    final_subst: SubstEmpty,
    typed_occurrences: array_empty()
  }
  let binders = [array_empty()]
  let first_observation = CheckedProgramTypeDefsObservation::{
    checked_program: first,
    type_def_binders: binders
  }
  let second_observation = CheckedProgramTypeDefsObservation::{
    checked_program: second,
    type_def_binders: binders
  }
  assert(canonical_checked_type_defs_snapshot(first_observation) == canonical_checked_type_defs_snapshot(second_observation))
  assert(canonical_checked_value_env_snapshot(first) == canonical_checked_value_env_snapshot(value_only))
}

test "canonical trait impl snapshot retains entries in final-env traversal order" {
  let retained = EnvBind("value", env_value_binding(CtInt), EnvTraitImpl("Later", CtString, EnvTraitDef("Ignored", array_empty(), false, array_empty(), env_cached(names = [
    "cached"
  ], bindings = [env_value_binding(CtBool)], rest = EnvTraitImpl("Earlier", CtInt, EnvEmpty)), [
    "T",
    "U"
  ], array_empty())))
  let expected = EnvTraitImpl("Later", CtString, EnvTraitImpl("Earlier", CtInt, EnvEmpty))
  assert(trait_impl_snapshot(env = retained, subst = SubstEmpty) == trait_impl_snapshot(env = expected, subst = SubstEmpty))
  assert(trait_impl_snapshot(env = EnvFlat([
    ("not_traversed", env_value_binding(CtInt))
  ]), subst = SubstEmpty) == trait_impl_snapshot(env = EnvEmpty, subst = SubstEmpty))
}

test "canonical trait impl snapshot alpha-normalizes generic bounds by declared position" {
  let left = EnvTraitImplGen("Map", ["T", "U"], [
    ("U", ["Ord", "Eq"]),
    ("T", ["Show"])
  ], CtNamed("Pair", [CtNamed("U", array_empty()), CtNamed("T", array_empty())]), EnvEmpty)
  let alpha = EnvTraitImplGen("Map", ["X", "Y"], [
    ("Y", ["Ord", "Eq"]),
    ("X", ["Show"])
  ], CtNamed("Pair", [CtNamed("Y", array_empty()), CtNamed("X", array_empty())]), EnvEmpty)
  let moved_association = EnvTraitImplGen("Map", ["X", "Y"], [
    ("X", ["Ord", "Eq"]),
    ("Y", ["Show"])
  ], CtNamed("Pair", [CtNamed("Y", array_empty()), CtNamed("X", array_empty())]), EnvEmpty)
  let reordered_rows_and_labels = EnvTraitImplGen("Map", ["X", "Y"], [
    ("X", ["Show"]),
    ("Y", ["Eq"]),
    ("Y", ["Ord", "Eq"])
  ], CtNamed("Pair", [CtNamed("Y", array_empty()), CtNamed("X", array_empty())]), EnvEmpty)
  let reordered_target = EnvTraitImplGen("Map", ["X", "Y"], [
    ("X", ["Show"]),
    ("Y", ["Ord", "Eq"])
  ], CtNamed("Pair", [CtNamed("X", array_empty()), CtNamed("Y", array_empty())]), EnvEmpty)
  assert(trait_impl_snapshot(env = left, subst = SubstEmpty) == trait_impl_snapshot(env = alpha, subst = SubstEmpty))
  assert(trait_impl_snapshot(env = left, subst = SubstEmpty) == trait_impl_snapshot(env = reordered_rows_and_labels, subst = SubstEmpty))
  assert(trait_impl_snapshot(env = left, subst = SubstEmpty) != trait_impl_snapshot(env = moved_association, subst = SubstEmpty))
  assert(trait_impl_snapshot(env = left, subst = SubstEmpty) != trait_impl_snapshot(env = reordered_target, subst = SubstEmpty))
}

test "canonical trait impl snapshot retains and alpha-normalizes generic targets" {
  let target = EnvTraitImplGen("Tr", ["T"], array_empty(), CtNamed("Box", [
    CtNamed("T", array_empty())
  ]), EnvEmpty)
  let alpha_renamed = EnvTraitImplGen("Tr", ["X"], array_empty(), CtNamed("Box", [
    CtNamed("X", array_empty())
  ]), EnvEmpty)
  let concrete = EnvTraitImplGen("Tr", ["X"], array_empty(), CtNamed("Box", [
    CtString
  ]), EnvEmpty)
  assert(trait_impl_snapshot(env = target, subst = SubstEmpty) == trait_impl_snapshot(env = alpha_renamed, subst = SubstEmpty))
  assert(trait_impl_snapshot(env = target, subst = SubstEmpty) != trait_impl_snapshot(env = concrete, subst = SubstEmpty))
}

test "canonical trait impl snapshot applies final substitution and fails closed for malformed bounds" {
  let substituted = EnvTraitImpl("Eq", CtVar(81), EnvEmpty)
  let resolved = EnvTraitImpl("Eq", CtString, EnvEmpty)
  assert(trait_impl_snapshot(env = substituted, subst = SubstBind(81, CtString, SubstEmpty)) == trait_impl_snapshot(env = resolved, subst = SubstEmpty))
  let unbound = trait_impl_snapshot(env = EnvTraitImplGen("Map", ["T"], [
    ("Missing", ["Eq"])
  ], CtNamed("Box", array_empty()), EnvEmpty), subst = SubstEmpty)
  let ambiguous = trait_impl_snapshot(env = EnvTraitImplGen("Map", ["T", "T"], [
    ("T", ["Eq"])
  ], CtNamed("Box", array_empty()), EnvEmpty), subst = SubstEmpty)
  assert(String::contains(unbound, needle = "unbound_bound_parameter"))
  assert(String::contains(unbound, needle = "Missing"))
  assert(String::contains(ambiguous, needle = "ambiguous_bound_parameter"))
  assert(unbound != ambiguous)
}

test "canonical trait impl snapshot observes real checker registrations" {
  let checked = check_program_result([
    STrait(false, "Observed", array_empty(), array_empty(), array_empty(), array_empty()),
    SImpl(["T"], [("T", ["Eq", "Show"])], "Observed", TyApp("Box", [TyName("T")])),
    SImpl(array_empty(), array_empty(), "Observed", TyName("Int"))
  ])
  let snapshot = canonical_retained_trait_impl_entries_snapshot(env = checked.final_env, s = checked.final_subst)
  assert(String::contains(snapshot, needle = "Observed"))
  assert(String::contains(snapshot, needle = "Box"))
  assert(String::contains(snapshot, needle = "Eq"))
  assert(String::contains(snapshot, needle = "Show"))
}

test "canonical retained trait method generics are alpha-normalized by position" {
  let methods = [("map", [TyName("Self")], TyName("Result"))]
  let left = EnvTraitDef("Mapper", array_empty(), false, methods, EnvEmpty, array_empty(), [
    ("map", ["T", "U"], [("U", ["Ord"]), ("T", ["Eq"])])
  ])
  let alpha = EnvTraitDef("Mapper", array_empty(), false, methods, EnvEmpty, array_empty(), [
    ("map", ["A", "B"], [("B", ["Ord"]), ("A", ["Eq"])])
  ])
  let changed = EnvTraitDef("Mapper", array_empty(), false, methods, EnvEmpty, array_empty(), [
    ("map", ["A", "B"], [("A", ["Ord"]), ("B", ["Eq"])])
  ])
  assert(trait_method_gens_snapshot(left) == trait_method_gens_snapshot(alpha))
  assert(trait_method_gens_snapshot(left) != trait_method_gens_snapshot(changed))
}

test "canonical retained trait method generics fail closed for malformed provenance" {
  let methods = [("map", array_empty(), TyName("Int"))]
  let missing = EnvTraitDef("Malformed", array_empty(), false, methods, EnvEmpty, array_empty(), array_empty())
  let surplus = EnvTraitDef("Malformed", array_empty(), false, array_empty(), EnvEmpty, array_empty(), [
    ("map", ["T"], array_empty())
  ])
  let ambiguous = EnvTraitDef("Malformed", array_empty(), false, methods, EnvEmpty, array_empty(), [
    ("map", ["T", "T"], [("T", ["Eq"]), ("Missing", ["Show"])])
  ])
  let mismatched = EnvTraitDef("Malformed", array_empty(), false, methods, EnvEmpty, array_empty(), [
    ("other", array_empty(), array_empty())
  ])
  assert(String::contains(trait_method_gens_snapshot(missing), needle = "missing_method_generic_provenance"))
  assert(String::contains(trait_method_gens_snapshot(surplus), needle = "surplus_method_generic_provenance"))
  assert(String::contains(trait_method_gens_snapshot(ambiguous), needle = "ambiguous_method_parameter"))
  assert(String::contains(trait_method_gens_snapshot(ambiguous), needle = "unbound_bound_parameter"))
  assert(String::contains(trait_method_gens_snapshot(mismatched), needle = "method_name_mismatch"))
}

test "canonical retained trait method generics observe checker registrations" {
  let checked = check_program_result([
    STrait(false, "Observed", array_empty(), [
      ("map", [TyName("T")], TyName("T"))
    ], [("map", ["T"], [("T", ["Eq"])])], array_empty())
  ])
  let snapshot = trait_method_gens_snapshot(checked.final_env)
  assert(String::contains(snapshot, needle = "Observed"))
  assert(String::contains(snapshot, needle = "Eq"))
}

test "canonical typedef snapshot marks missing provenance" {
  let snapshot = typedef_snapshot(defs = [
    TDEnum("Missing", ["T"], array_empty())
  ], binders = array_empty(), subst = SubstEmpty)
  assert(String::contains(snapshot, needle = "array_count_mismatch"))
  assert(String::contains(snapshot, needle = "missing_metadata"))
  assert(String::contains(snapshot, needle = "position"))
  assert(String::contains(snapshot, needle = "enum"))
}

test "canonical typedef snapshot marks surplus provenance" {
  let snapshot = typedef_snapshot(defs = array_empty(), binders = [
    array_empty()
  ], subst = SubstEmpty)
  assert(String::contains(snapshot, needle = "array_count_mismatch"))
  assert(String::contains(snapshot, needle = "surplus_metadata"))
  assert(String::contains(snapshot, needle = "position"))
  assert(String::contains(snapshot, needle = "none"))
}

test "canonical typedef snapshot marks wrong enum binder length" {
  let snapshot = typedef_snapshot(defs = [
    TDEnum("Wrong", ["A", "B"], array_empty())
  ], binders = [[7]], subst = SubstEmpty)
  assert(String::contains(snapshot, needle = "enum_binder_count_mismatch"))
  assert(String::contains(snapshot, needle = "expected_binders"))
  assert(String::contains(snapshot, needle = "actual_binders"))
  assert(String::contains(snapshot, needle = "enum"))
}

test "canonical typedef snapshot marks non-enum binders" {
  let snapshot = typedef_snapshot(defs = [
    TDStruct("Wrong", array_empty(), array_empty(), array_empty())
  ], binders = [[7]], subst = SubstEmpty)
  assert(String::contains(snapshot, needle = "non_enum_binders"))
  assert(String::contains(snapshot, needle = "position"))
  assert(String::contains(snapshot, needle = "struct"))
  assert(String::contains(snapshot, needle = "actual_binders"))
}
