//# Imports

import ./printer_test_support.vibe {
  roundtrip, roundtrip_eq
}

//# Misc

test "roundtrip break" {
  let ok = handle {
    roundtrip_eq(src = "{ while true { break } }", expected = "while true { break }")
  } with { Exception::Throw(_) => false }
  assert(ok)
}

test "roundtrip break value" {
  let ok = handle {
    roundtrip_eq(src = "{ while true { break 42 } }", expected = "while true { break 42 }")
  } with { Exception::Throw(_) => false }
  assert(ok)
}

test "roundtrip continue" {
  let ok = handle {
    roundtrip_eq(src = "{ while true { continue } }", expected = "while true { continue }")
  } with { Exception::Throw(_) => false }
  assert(ok)
}

test "roundtrip continue args" {
  let ok = handle {
    roundtrip_eq(src = "{ while true { continue(1, 2) } }", expected = "while true { continue(1, 2) }")
  } with { Exception::Throw(_) => false }
  assert(ok)
}

test "roundtrip for in expression" {
  let ok = handle {
    roundtrip("for x in [1, 2, 3] { x * 2 }")
  } with { Exception::Throw(_) => false }
  assert(ok)
}

test "roundtrip handle expression" {
  let ok = handle {
    roundtrip("handle { throw(\"oops\") } with { Exception::Throw(msg) => msg }")
  } with { Exception::Throw(_) => false }
  assert(ok)
}
