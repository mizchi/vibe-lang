//# Imports

import ../parser_hotspot_probe.vibe {
  probe_parse_expr_tokens_repeat_count,
  probe_parse_stmt_tokens_repeat_count,
  probe_parse_tokens_count,
  probe_parse_tokens_repeat_count,
  probe_parse_type_tokens_repeat_count
}

import ../syntax/lexer.vibe {
  lex
}

//# Tests

test "parser hotspot probes parse pre-tokenized programs" {
  let tokens = lex("let answer = 42\n")
  assert(probe_parse_tokens_count(tokens) == 1)
  assert(probe_parse_tokens_repeat_count(tokens, 3) == 3)
}

test "parser hotspot probes split statement type and expression parsing" {
  assert(probe_parse_stmt_tokens_repeat_count(lex("let x = if 1 < 2 { 3 } else { 4 }\n"), 2) > 0)
  assert(probe_parse_stmt_tokens_repeat_count(lex("let x = 1\n"), 2) > 0)
  assert(probe_parse_type_tokens_repeat_count(lex("(Int, String) -> Option[Int]"), 2) > 0)
  assert(probe_parse_expr_tokens_repeat_count(lex("foo(1, arr[0], obj.field)"), 2) > 0)
  assert(probe_parse_expr_tokens_repeat_count(lex("{ 1 }"), 2) > 0)
  assert(probe_parse_expr_tokens_repeat_count(lex("{ let x = 1; x }"), 2) > 0)
  assert(probe_parse_expr_tokens_repeat_count(lex("{ let mut x = 1; x = 2; x }"), 2) > 0)
  assert(probe_parse_expr_tokens_repeat_count(lex("{ let mut x = 1; x += 2; x }"), 2) > 0)
  assert(probe_parse_expr_tokens_repeat_count(lex("if 1 < 2 { 3 } else { 4 }"), 2) > 0)
}
