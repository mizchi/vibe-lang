//# Imports

import @vibe/compiler/core {
  builtin_registry, verify_lane_builtins
}

//# Misc

test "registry has no duplicate names" {
  let reg = builtin_registry()
  let mut i = 0
  while i < Array::length(reg) {
    let (n, _, _, _, _) = Array::get(reg, at = i)
    let mut j = i + 1
    while j < Array::length(reg) {
      let (m, _, _, _, _) = Array::get(reg, at = j)
      assert(not(n == m))
      j = j + 1
    }
    i = i + 1
  }
  assert(Array::length(reg) > 90)
}

test "verify rejects a lane-registered name missing from the registry" {
  // #415 B-0 direction 1: a builtin registered by a lane without a registry
  // row must fail the build by name.
  let outcome = handle {
    verify_lane_builtins(lane = "linear", names = ["__not_a_real_builtin__"], param_counts = [
      1
    ], returns = [1])
    "no-throw"
  } with { Exception::Throw(msg) => if String::contains(msg, needle = "__not_a_real_builtin__") {
    "threw-with-name"
  } else {
    "threw-wrong"
  } }
  assert(outcome == "threw-with-name")
}

test "verify rejects a signature mismatch" {
  // Fs::read_file is (1 param, returns 1) in the registry; claim 2 params.
  let outcome = handle {
    verify_lane_builtins(lane = "linear", names = ["Fs::read_file"], param_counts = [
      2
    ], returns = [1])
    "no-throw"
  } with { Exception::Throw(msg) => if String::contains(msg, needle = "signature mismatch") {
    "threw-mismatch"
  } else {
    "threw-wrong"
  } }
  assert(outcome == "threw-mismatch")
}
