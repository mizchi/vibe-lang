//# Imports

import ../loader {
  collect_all_sources_fs, collect_source_groups_fs
}

//# Functions

fn has_source_path(sources: Array[(String, String)], target: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(sources) {
    let (path, _) = Array::get(sources, i)
    if path == target {
      found = true
      i = Array::length(sources)
    }
    else {
      i = i + 1
    }
  }
  found
}

fn find_group_sources(groups: Array[(String, Array[(String, String)])], target: String) -> Option[Array[(String, String)]] {
  let mut i = 0
  let mut found = None
  while i < Array::length(groups) {
    let (name, sources) = Array::get(groups, i)
    if name == target {
      found = Some(sources)
      i = Array::length(groups)
    }
    else {
      i = i + 1
    }
  }
  found
}

//# Misc

// #769: rewritten against structural invariants -- the old version pinned a
// fossil layout (161 sources, lib/@vibe/compiler/ast.vibe, syntax/
// float_format.vibe, ...) that predated the @vibe/parser + @vibe/ast package
// split; the loader itself was correct the whole time. What this test OWNS:
// manifest preference (first source = the manifest's first row) and
// entry-last ordering; exact counts belong to the manifest, not this test.
test "collect_all_sources_fs: compiler index prefers manifest list" {
  let sources = collect_all_sources_fs("lib/@vibe/compiler/index.vibe")
  let (first_path, _) = Array::get(sources, 0)
  let (last_path, _) = Array::get(sources, Array::length(sources) - 1)
  assert(first_path == "lib/@vibe/ast/index.vibei")
  assert(last_path == "lib/@vibe/compiler/index.vibe")
  assert(Array::length(sources) > 100)
  assert(has_source_path(sources, "lib/@vibe/compiler/core/polyfill.vibe"))
  assert(has_source_path(sources, "lib/@vibe/compiler/core/bytebuf.vibe"))
  assert(has_source_path(sources, "lib/@vibe/compiler/core/ast.vibe"))
  // The parser/ast packages arrive as their CONTRACTS (impl files ride the
  // facade desugar, not separate source rows).
  assert(has_source_path(sources, "lib/@vibe/parser/index.vibei"))
  assert(has_source_path(sources, "lib/@vibe/ast/index.vibei"))
  assert(has_source_path(sources, "lib/@vibe/compiler/checker/checker.vibe"))
  assert(has_source_path(sources, "lib/@vibe/compiler/codegen/wasi/linked_compile.vibe"))
  assert(has_source_path(sources, "lib/@vibe/compiler/loader/manifest_sources.vibe"))
  assert(has_source_path(sources, "lib/@vibe/compiler/loader/index.vibe"))
  assert(has_source_path(sources, "lib/@vibe/cache/cache.vibe"))
  assert(has_source_path(sources, "lib/@vibe/compiler/cache/persistent_cache.vibe"))
  assert(has_source_path(sources, "lib/@vibe/compiler/sources_bundle.vibe") == false)
}

test "collect_all_sources_fs: non-manifest compiler entry keeps recursive collection" {
  let sources = collect_all_sources_fs("lib/@vibe/compiler/module_loader_non_manifest_fixture.vibe")
  assert(has_source_path(sources, "lib/@vibe/compiler/module_loader_non_manifest_fixture.vibe"))
}

test "collect_all_sources_fs: fs_compile entry follows source imports without hardcoded deps" {
  let sources = collect_all_sources_fs("lib/@vibe/compiler/entry/compiler/fs_compile/index.vibe")
  assert(has_source_path(sources, "lib/@vibe/compiler/entry/compiler/fs_compile/index.vibe"))
  assert(has_source_path(sources, "lib/@vibe/compiler/entry/compiler/fs_compile/closure_order.vibe"))
  assert(has_source_path(sources, "lib/@vibe/compiler/cache/persistent_cache.vibe"))
  assert(has_source_path(sources, "lib/@vibe/compiler/runtime/index.vibe"))
  assert(has_source_path(sources, "lib/@vibe/compiler/codegen/index.vibe"))
}

// #769: rewritten (see the collect_all_sources_fs note above). Owns: manifest
// group ORDER (first manifest group first, entry group last) and spot
// membership; group counts and exact per-group sizes belong to the manifest.
test "collect_source_groups_fs: compiler index keeps manifest groups" {
  let groups = collect_source_groups_fs("lib/@vibe/compiler/index.vibe")
  assert(Array::length(groups) > 5)
  let (first_name, first_sources) = Array::get(groups, 0)
  let (last_name, last_sources) = Array::get(groups, Array::length(groups) - 1)
  assert(first_name == "vibe_ast")
  assert(last_name == "entry")
  assert(has_source_path(first_sources, "lib/@vibe/ast/index.vibei"))
  match find_group_sources(groups, "core") {
    Some(core_sources) => {
      assert(has_source_path(core_sources, "lib/@vibe/compiler/core/polyfill.vibe"))
      assert(has_source_path(core_sources, "lib/@vibe/compiler/core/bytebuf.vibe"))
    },
    None => assert(false)
  }
  match find_group_sources(groups, "checker") {
    Some(checker_sources) => {
      assert(has_source_path(checker_sources, "lib/@vibe/compiler/checker/checker.vibe"))
      assert(has_source_path(checker_sources, "lib/@vibe/compiler/checker/checker_stmt.vibe"))
    },
    None => assert(false)
  }
  match find_group_sources(groups, "loader") {
    Some(loader_sources) => {
      assert(has_source_path(loader_sources, "lib/@vibe/compiler/loader/manifest_sources.vibe"))
      assert(has_source_path(loader_sources, "lib/@vibe/compiler/loader/index.vibe"))
    },
    None => assert(false)
  }
  assert(has_source_path(last_sources, "lib/@vibe/compiler/index.vibe"))
}

test "collect_source_groups_fs: manifest applies to selfhost cli adapter entry" {
  let groups = collect_source_groups_fs("lib/@vibe/compiler/cli_adapter.vibe")
  assert(Array::length(groups) > 5)
  let (first_name, _) = Array::get(groups, 0)
  let (last_name, last_sources) = Array::get(groups, Array::length(groups) - 1)
  assert(first_name == "vibe_ast")
  assert(last_name == "entry")
  assert(has_source_path(last_sources, "lib/@vibe/compiler/cli_adapter.vibe"))
}

test "collect_source_groups_fs: non-manifest compiler entry uses recursive fallback group" {
  let groups = collect_source_groups_fs("lib/@vibe/compiler/module_loader_non_manifest_fixture.vibe")
  assert(Array::length(groups) == 1)
  let (name, sources) = Array::get(groups, 0)
  assert(name == "recursive")
  assert(has_source_path(sources, "lib/@vibe/compiler/module_loader_non_manifest_fixture.vibe"))
}
