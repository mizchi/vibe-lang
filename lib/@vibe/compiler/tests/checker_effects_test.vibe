//# Imports

import @vibe/compiler/core {
  Expr, Pat, Stmt, TypeExpr
}

import @vibe/compiler/checker {
  EffectError, effect_error_to_string, effect_row_contains_label
}

//# Misc

// #944 follow-up: the legacy `check_effects_expr` walk this file used to
// harness (the pre-#933 `in_effect: Bool` discipline) was retired from
// checker_effects.vibe -- it had no live-pipeline caller. The live
// disciplines are pinned elsewhere: the row-based checked-Error rules by
// compiler_gate.sh gates 44b/44c and the effect fixture corpus, the
// Async-scoped pass by checker_async_effects_test.vibe. What remains here
// is the rendering contract of the live EffectError variants, which
// diagnostics output and several gate greps depend on verbatim.

test "effect row membership is exact (#1289)" {
  assert(effect_row_contains_label(Some("Async"), "Async"))
  assert(effect_row_contains_label(Some("Fs, Async"), "Async"))
  assert(!effect_row_contains_label(Some("NotAsync"), "Async"))
  assert(!effect_row_contains_label(Some("AsyncLike"), "Async"))
  assert(!effect_row_contains_label(None, "Async"))
}

test "effectful-call error formatting" {
  let e = EEEffectfulCallOutsideEffect("await")
  let s = effect_error_to_string(e)
  assert(String::contains(s, "effectful call outside effectful context"))
  assert(String::contains(s, "await"))
}

test "undeclared-effect error formatting includes op, effect and fix hint" {
  let e = EEPerformUndeclaredEffect("Fs::read_file", "Fs")
  let s = effect_error_to_string(e)
  assert(String::contains(s, "undeclared effect"))
  assert(String::contains(s, "Fs"))
  assert(String::contains(s, "`with` row"))
}

test "effect row mismatch hint: a function kind is pasted through an alias (#3052)" {
  // A row item's type arguments are type names, so `Exception[(Int, Int) ->
  // Int]` cannot be pasted; the kind's own comma must not split it either.
  let e = EEEffectRowMismatch("boom", "Exception[(Int, Int) -> Int]", "Exception[IoErr]", "Exception[(Int, Int) -> Int], Exception[IoErr]", 0 - 1)
  let s = effect_error_to_string(e)
  assert(String::contains(s, "missing { Exception[(Int, Int) -> Int] }"))
  assert(String::contains(s, "hint: a row names an exception kind by a type name, so declare `type Kind = (Int, Int) -> Int` (any name this module does not already declare -- use it in the row too), then add 'with Exception[Kind] + Exception[IoErr]' to 'boom'"))
  assert(!String::contains(s, "(Int + Int)"))
  assert(!String::contains(s, "with Exception[("))
}

test "effect row mismatch hint: two unspellable kinds get two aliases (#3052)" {
  let e = EEEffectRowMismatch("f", "Exception[(Int) -> Int], Exception[() -> String]", "", "Exception[(Int) -> Int], Exception[() -> String]", 0 - 1)
  let s = effect_error_to_string(e)
  assert(String::contains(s, "declare `type Kind = (Int) -> Int` and `type Kind2 = () -> String`"))
  assert(String::contains(s, "with Exception[Kind] + Exception[Kind2]'"))
}

test "effect row mismatch hint: spellable kinds keep the plain hint (#3052)" {
  let e = EEEffectRowMismatch("f", "Exception[Array[IoErr]]", "Fs", "Exception[Array[IoErr]], Fs", 0 - 1)
  let s = effect_error_to_string(e)
  assert(String::contains(s, "hint: add 'with Exception[Array[IoErr]] + Fs' to 'f'"))
  assert(!String::contains(s, "type Kind"))
}

test "effect row mismatch formatting: declared row present" {
  let e = EEEffectRowMismatch("f", "Fs", "Error", "Error, Fs", 0 - 1)
  let s = effect_error_to_string(e)
  assert(String::contains(s, "effect row mismatch for 'f'"))
  assert(String::contains(s, "missing { Fs }"))
  assert(String::contains(s, "declared { Error }"))
  assert(String::contains(s, "requires { Error, Fs }"))
  // #1461: `Error` throughout, INPUT and output alike. This is a rendering
  // contract test -- effect_error_to_string emits the row it was handed,
  // verbatim. Canonicalization happens upstream, in the checker that builds
  // the requirement, which is why the end-to-end gate assertion for the same
  // diagnostic reads `with Exception + Fs` while this one does not.
  assert(String::contains(s, "hint: add 'with Error + Fs' to 'f'"))
}

test "effect row mismatch formatting: no declared row" {
  let e = EEEffectRowMismatch("g", "Error", "", "Error", 0 - 1)
  let s = effect_error_to_string(e)
  assert(String::contains(s, "effect row mismatch for 'g'"))
  assert(String::contains(s, "no 'with' clause"))
  // Same rendering contract: the required row given above is `Error`.
  assert(String::contains(s, "hint: declare 'fn g(...) -> T with Error'"))
}

test "assign-immutable error formatting" {
  let e = EEAssignImmutable("x")
  let s = effect_error_to_string(e)
  assert(String::contains(s, "cannot assign to immutable binding"))
  assert(String::contains(s, "let mut"))
}
