test "colliding published kinds validate the requested qualifier" {
  let env = EnvTypeDefs([TDStruct("X", [], [], [])], ["X"], EnvTraitDef("X", [], false, [
  ], EnvEmpty, [], []))
  let invalid = handle {
    let _ = check_program_with_env_result(parse_program_with_path("workspace/main.vibe", "import ./dep.vibe { enum X }"), env)
    ""
  } with { Exception::Throw(error) => error }
  assert(String::contains(invalid, "import kind mismatch"))
  assert(projected_import_kind_error("import ./provider.vibe { struct Record }") == "")
  let trait_message = handle {
    let _ = check_program_with_env_result(parse_program_with_path("workspace/main.vibe", "import ./dep.vibe { trait X }"), env)
    ""
  } with { Exception::Throw(error) => error }
  assert(trait_message == "")
}

test "private declarations report exportability instead of an ineffective kind edit" {
  let message = typedef_surface_pair_error("/tmp/vibe_private_kind_followup", "struct Hidden { value: Int }\nexport fn public() -> Int { 1 }", "import ./dep.vibe { type Hidden }\nexport let value = 1\n")
  assert(String::contains(message, "is not exported by"))
  assert(!String::contains(message, "import kind mismatch"))
}

fn imported_forall_bound_label(env: TypeEnv, name: String) -> String {
  match env_lookup(env, name) {
    Some(CtForAll(_, bounds, _)) => if Array::length(bounds) == 1 {
      let (_, labels) = Array::get(bounds, 0)
      if Array::length(labels) == 1 {
        Array::get(labels, 0)
      } else {
        ""
      }
    } else {
      ""
    },
    _ => ""
  }
}

fn typecheck_fs_pair_error(dep_path: String, dep_src: String, main_path: String, main_src: String) -> String with Fs {
  handle {
    let db = db_set_source(db_set_source(db_new(), dep_path, dep_src), main_path, main_src)
    let _ = db_typecheck_fs(db, main_path)
    ""
  } with { Exception::Throw(msg) => msg }
}

fn typecheck_db_pair_error(dep_src: String, main_src: String) -> String with Exception {
  handle {
    let db = db_set_source(db_set_source(db_new(), "mem/dep.vibe", dep_src), "mem/main.vibe", main_src)
    let _ = db_typecheck(db, "mem/main.vibe")
    ""
  } with { Exception::Throw(msg) => msg }
}

test "forward alias bodies stay resolved across module projection" {
  let dep_source = "export type Pair = StringMap[Int, String]\ntype StringMap[A, B] = (A, B)"
  let pair_binding_is_resolved = match env_lookup(checked_test_env(dep_source), "Pair") {
    Some(CtTuple(items)) => Array::length(items) == 2,
    _ => false
  }
  assert(pair_binding_is_resolved)
  let main_source = "import ./dep.vibe { type Pair }\nlet bad: Pair = 1"
  let message = typecheck_db_pair_error(dep_source, main_source)
  assert(String::contains(message, "binding type mismatch for bad"))
}

test "alias snapshots in exported struct fields stay resolved across module projection" {
  let dep_source = "type Pair = StringMap[Int, String]\nexport struct Box { value: Pair }\ntype StringMap[A, B] = (A, B)"
  let main_source = "import ./dep.vibe { struct Box }\nlet bad = Box::{ value: 1 }"
  let message = typecheck_db_pair_error(dep_source, main_source)
  assert(String::contains(message, "field type mismatch for value"))
}

fn tuple_type_depth(ty: Type) -> Int {
  match ty {
    CtTuple(items) => {
      let mut depth = 0
      let mut i = 0
      while i < Array::length(items) {
        let item_depth = tuple_type_depth(Array::get(items, i))
        if item_depth > depth {
          depth = item_depth
        } else {
          ()
        }
        i = i + 1
      }
      depth + 1
    },
    _ => 0
  }
}

test "recursive alias refresh does not grow with unrelated statements" {
  let source = "export type A = (B, B)\ntype B = A\nlet pad0 = 0\nlet pad1 = 1\nlet pad2 = 2\nlet pad3 = 3\nlet pad4 = 4\nlet pad5 = 5"
  match env_lookup(checked_test_env(source), "A") {
    Some(body) => assert(tuple_type_depth(body) <= 3),
    None => assert(false)
  }
}

test "recursive aliases do not freeze same-name acyclic declarations" {
  let message = handle {
    let _ = check_program_with_env_result([
      STypeAlias(false, "A", array_empty(), TyName("B")),
      SModule(false, "Nested", [
        STypeAlias(false, "A", array_empty(), TyName("A")),
        STypeAlias(false, "B", array_empty(), TyName("Int"))
      ]),
      SLet(false, false, "bad", Some(TyName("A")), EString("x"))
    ], EnvEmpty)
    ""
  } with { Exception::Throw(error) => error }
  assert(String::contains(message, "binding type mismatch for bad"))
}

test "acyclic aliases resolve when dependencies zig-zag across source order" {
  let source = "type C = D\ntype A = B\ntype B = C\ntype D = Int\nlet bad: A = \"x\""
  let message = handle {
    let _ = checked_test_env(source)
    ""
  } with { Exception::Throw(error) => error }
  assert(String::contains(message, "binding type mismatch for bad"))
}

test "outer aliases are revalidated after nested module type declarations" {
  let message = handle {
    let _ = check_program_with_env_result([
      STypeAlias(false, "M", array_empty(), TyApp("Map", [
        TyName("Key"),
        TyName("Int")
      ])),
      SModule(false, "Nested", [
        STypeAlias(false, "Key", array_empty(), TyName("Int"))
      ])
    ], EnvEmpty)
    ""
  } with { Exception::Throw(error) => error }
  assert(String::contains(message, "the builtin map is String-keyed"))
}

test "alias dependencies resolve across nested scope boundaries" {
  let checked = check_program_with_env_result([
    STypeAlias(false, "A", array_empty(), TyName("B")),
    STypeAlias(false, "C", array_empty(), TyName("D")),
    SModule(false, "Nested", [
      STypeAlias(false, "B", array_empty(), TyName("C")),
      STypeAlias(false, "D", array_empty(), TyName("Int"))
    ])
  ], EnvEmpty)
  match env_lookup(checked.final_env, "A") {
    Some(CtInt) => (),
    _ => assert(false)
  }
}

test "nested type heads are known before outer alias validation" {
  let checked = check_program_with_env_result([
    STypeAlias(false, "Pair", array_empty(), TyApp("StringMap", [
      TyName("Int"),
      TyName("String")
    ])),
    SModule(false, "Nested", [
      STypeAlias(false, "StringMap", ["A", "B"], TyTuple([
        TyName("A"),
        TyName("B")
      ]))
    ])
  ], EnvEmpty)
  match env_lookup(checked.final_env, "Pair") {
    Some(CtTuple(items)) => assert(Array::length(items) == 2),
    _ => assert(false)
  }
}

test "nested type heads are known before outer payload validation" {
  let _ = check_program_with_env_result([
    SStruct(false, "Box", [
      ("value", TyApp("StringMap", [TyName("Int"), TyName("String")]))
    ], array_empty(), array_empty(), array_empty()),
    SSuberror(false, "Problem", [
      ("Problem", [TyApp("StringMap", [TyName("Int"), TyName("String")])])
    ]),
    SEnum(false, "Choice", array_empty(), [
      ("Pick", [TyApp("StringMap", [TyName("Int"), TyName("String")])])
    ], array_empty()),
    SEffectDef(false, "Ask", array_empty(), [
      ("Get", [TyApp("StringMap", [TyName("Int"), TyName("String")])], TyName("Int"))
    ]),
    SModule(false, "Nested", [
      STypeAlias(false, "StringMap", ["A", "B"], TyTuple([
        TyName("A"),
        TyName("B")
      ]))
    ])
  ], EnvEmpty)
}

test "nested type heads replace stale outer unknown-name diagnostics" {
  let checked = check_program_with_env_result([
    SStruct(false, "Box", [("value", TyName("Pair"))], array_empty(), array_empty(), array_empty()),
    SEnum(false, "Choice", array_empty(), [("Pick", [TyName("Pair")])], array_empty()),
    SModule(false, "Nested", [
      STypeAlias(false, "Pair", array_empty(), TyName("Int"))
    ])
  ], EnvEmpty)
  let mut saw_box = false
  let mut i = 0
  while i < Array::length(checked.type_defs) {
    match Array::get(checked.type_defs, i) {
      TDStruct("Box", fields, _, _) => if Array::length(fields) == 1 {
        let (field_name, field_type) = Array::get(fields, 0)
        saw_box = field_name == "value" && field_type == CtInt
      } else {
        ()
      },
      _ => ()
    }
    i = i + 1
  }
  assert(saw_box)
}

test "completed root recheck replaces stale module diagnostics" {
  let _ = check_program_with_env_result([
    SModule(false, "First", [
      SLet(false, false, "good", Some(TyApp("StringMap", [
        TyName("Int"),
        TyName("String")
      ])), ETuple([EInt(1), EString("x")]))
    ]),
    SModule(false, "Second", [
      STypeAlias(false, "StringMap", ["A", "B"], TyTuple([
        TyName("A"),
        TyName("B")
      ]))
    ])
  ], EnvEmpty)
}

test "suberror refresh locates its marker across same-name types" {
  match check_program_typed_occurrence_statement_observation([
    SSuberror(false, "X", [("X", [TyName("Pair")])]),
    SStruct(false, "X", [("value", TyName("String"))], array_empty(), array_empty(), array_empty()),
    SModule(false, "Nested", [
      STypeAlias(false, "Pair", array_empty(), TyName("Int"))
    ]),
    SLet(false, false, "probe", None, EInt(0))
  ]) {
    Some(observation) => match env_lookup(observation.checked_program.final_env, "X") {
      Some(CtFn(params, CtStruct("X"), _)) => if Array::length(params) == 1 {
        assert(Array::get(params, 0) == CtString)
      } else {
        assert(false)
      },
      _ => assert(false)
    },
    None => assert(false)
  }
}

