test "nested sibling aliases refresh earlier struct payloads" {
  let checked = check_program_with_env_result([
    SModule(false, "First", [
      STypeAlias(false, "Alias", array_empty(), TyName("Pair")),
      SStruct(false, "Box", [("value", TyName("Alias"))], array_empty(), array_empty(), array_empty())
    ]),
    SModule(false, "Second", [
      STypeAlias(false, "Pair", array_empty(), TyName("Int"))
    ])
  ], EnvEmpty)
  let mut found = false
  let mut i = 0
  while i < Array::length(checked.type_defs) {
    match Array::get(checked.type_defs, i) {
      TDStruct("Box", fields, _, _) => if Array::length(fields) == 1 {
        let (field_name, field_type) = Array::get(fields, 0)
        found = field_name == "value" && field_type == CtInt
      } else {
        ()
      },
      _ => ()
    }
    i = i + 1
  }
  assert(found)
}

test "nested sibling aliases recheck earlier constructor uses" {
  let message = handle {
    let _ = check_program_with_env_result([
      SModule(false, "First", [
        STypeAlias(false, "Alias", array_empty(), TyName("Pair")),
        SStruct(false, "Box", [("value", TyName("Alias"))], array_empty(), array_empty(), array_empty()),
        SLet(false, false, "bad", None, ECall(EIdent("Box", -1), [EString("x")], -1))
      ]),
      SModule(false, "Second", [
        STypeAlias(false, "Pair", array_empty(), TyName("Int"))
      ])
    ], EnvEmpty)
    ""
  } with { Exception::Throw(error) => error }
  assert(String::contains(message, "expected Int, got String"))
}

