//# Functions

fn remove_file_if_exists(path: String) -> Unit with Fs {
  if Fs::exists(path) {
    Fs::remove(path)
  } else {
    ()
  }
}

fn string_to_bytes(s: String) -> Bytes {
  let out = Bytes::new()
  let len = String::length(s)
  let mut i = 0
  while i < len {
    Bytes::push(out, String::char_code_at(s, i))
    i = i + 1
  }
  out
}

fn build_test_fingerprint(source: String, dep_fps: Array[(String, String)]) -> String {
  let mut acc = compact_string_fingerprint(String::concat("typing-semantics:unchecked|source:", source))
  let mut i = 0
  while i < Array::length(dep_fps) {
    let (dep_path, dep_fp) = Array::get(dep_fps, i)
    acc = compact_string_fingerprint(String::concat(acc, String::concat("|", String::concat(dep_path, String::concat("=", dep_fp)))))
    i = i + 1
  }
  acc
}

fn checked_test_env(source: String) -> TypeEnv with Exception {
  let path = "projection_fixture.vibe"
  let checked = db_typecheck(db_set_source(db_new(), path, source), path)
  match db_check_env(checked, path) {
    Some(env) => env,
    None => throw("projection fixture produced no checked environment")
  }
}

fn remove_typecheck_fs_cache(path: String, source: String, fingerprint: String) -> Unit with Fs {
  let source_fp = compact_string_fingerprint(source)
  remove_file_if_exists(persistent_dep_list_cache_path(path, source_fp))
  remove_file_if_exists(persistent_module_header_cache_path(path, source_fp))
  remove_file_if_exists(persistent_leaf_fingerprint_cache_path(path, source_fp))
  remove_file_if_exists(persistent_type_env_cache_path(fingerprint))
}

fn retained_trait_node_tags(env: TypeEnv) -> String {
  match env {
    EnvEmpty => "",
    EnvBind(_, _, rest) => retained_trait_node_tags(rest),
    EnvMutCell(_, _, rest) => retained_trait_node_tags(rest),
    EnvTraitDef(name, _, _, _, rest, _, _) => String::concat(String::concat("def:", name), String::concat(";", retained_trait_node_tags(rest))),
    EnvTraitImpl(name, _, rest) => String::concat(String::concat("impl:", name), String::concat(";", retained_trait_node_tags(rest))),
    EnvTraitImplGen(name, _, _, _, rest) => String::concat(String::concat("gen:", name), String::concat(";", retained_trait_node_tags(rest))),
    EnvTypeDefs(_, _, rest) => retained_trait_node_tags(rest),
    EnvFlat(_) => "",
    EnvCached(_, _, rest) => retained_trait_node_tags(rest)
  }
}

fn import_kind_provider_env() -> TypeEnv {
  EnvTypeDefs([
    TDAlias("Alias", [], CtInt),
    TDStruct("Record", [("value", CtInt)], [], []),
    TDEnum("Choice", [], [("First", []), ("Second", [])]),
    TDEffect("Audit", [("Emit", [CtString], CtUnit)], []),
    TDEffectSet("Audits", ["Audit"])
  ], ["Alias", "Record", "Choice", "Audit", "Audits"], EnvTraitDef("Marker", [], false, [
  ], EnvBind("make", env_value_binding(CtFn([], CtInt, None)), EnvEmpty), [], []))
}

fn projected_import_kind_error(source: String) -> String {
  handle {
    let _ = check_program_with_env_result(parse_program_with_path("workspace/main.vibe", source), import_kind_provider_env())
    ""
  } with { Exception::Throw(message) => message }
}

test "kind-qualified imports match projected declaration authority" {
  assert(projected_import_kind_error("import ./provider.vibe { type Alias }") == "")
  assert(projected_import_kind_error("import ./provider.vibe { struct Record }") == "")
  assert(projected_import_kind_error("import ./provider.vibe { enum Choice }") == "")
  assert(projected_import_kind_error("import ./provider.vibe { effect Audit }") == "")
  assert(projected_import_kind_error("import ./provider.vibe { trait Marker }") == "")
  assert(projected_import_kind_error("import ./provider.vibe { Alias }") == "")
  assert(projected_import_kind_error("export ./provider.vibe { enum Choice as PublicChoice }") == "")
}

test "type alias imports reject structs and enums" {
  assert(String::contains(projected_import_kind_error("import ./provider.vibe { type Record }"), "import kind mismatch: `Record` is a struct, not a type alias"))
  assert(String::contains(projected_import_kind_error("import ./provider.vibe { type Choice }"), "import kind mismatch: `Choice` is an enum, not a type alias"))
}

test "projected import kinds use each source module instead of merged name order" {
  let alias_path = "workspace/alias.vibe"
  let struct_path = "workspace/record.vibe"
  let alias_env = checked_test_env("export type X = Int")
  let struct_env = checked_test_env("export struct X { value: Int }")
  let alias_first = "import ./alias.vibe { type X as AliasX }\nimport ./record.vibe { struct X as RecordX }"
  let struct_first = "import ./record.vibe { struct X as RecordX }\nimport ./alias.vibe { type X as AliasX }"
  let first_checked = projected_checked_env(alias_first, "workspace/main.vibe", [
    alias_path,
    struct_path
  ], [(alias_path, alias_env), (struct_path, struct_env)])
  let second_checked = projected_checked_env(struct_first, "workspace/main.vibe", [
    struct_path,
    alias_path
  ], [(struct_path, struct_env), (alias_path, alias_env)])
  match (env_lookup(first_checked, "AliasX"), env_lookup(first_checked, "RecordX"), env_lookup(second_checked, "AliasX"), env_lookup(second_checked, "RecordX")) {
    (Some(_), Some(_), Some(_), Some(_)) => (),
    _ => assert(false)
  }
  let mismatch = handle {
    let _ = projected_import_env_for_test("import ./alias.vibe { struct X as Wrong }\nimport ./record.vibe { struct X as RecordX }", "workspace/main.vibe", [
      alias_path,
      struct_path
    ], [(alias_path, alias_env), (struct_path, struct_env)])
    ""
  } with { Exception::Throw(message) => message }
  assert(String::contains(mismatch, "import kind mismatch: `X` is a type alias, not a struct"))
}

test "import kind classification ignores an unrelated trait matching the alias" {
  let message = projected_import_kind_error("import ./provider.vibe { enum Record as Marker }")
  assert(String::contains(message, "import kind mismatch: `Record` is a struct, not an enum"))
}

test "ordinary value exports do not inherit builtin type authority by name" {
  let dep_path = "workspace/value.vibe"
  let dep_env = checked_test_env("export let i32 = 1")
  let message = handle {
    let _ = projected_import_env_for_test("import ./value.vibe { type i32 }", "workspace/main.vibe", [
      dep_path
    ], [(dep_path, dep_env)])
    ""
  } with { Exception::Throw(error) => error }
  assert(String::contains(message, "import kind mismatch: `i32` is a value, not a type alias"))
}

test "builtin type authority survives a re-exporting module" {
  // A re-exported opaque builtin is transported as a selectable type name
  // without a forgeable TypeDef payload.
  let env = EnvTypeDefs(array_empty(), ["Int"], EnvEmpty)
  let message = handle {
    let _ = check_program_with_env_result(parse_program_with_path("workspace/main.vibe", "import ./builtin_wrapper.vibe { type Int }"), env)
    ""
  } with { Exception::Throw(error) => error }
  assert(message == "")
}

test "import kind classification uses the published declaration on name collision" {
  let env = EnvTypeDefs([
    TDAlias("Hidden", [], CtInt),
    TDAlias("Public", [], CtNamed("Hidden", []))
  ], ["Public"], EnvBind("Hidden", env_value_binding(CtInt), EnvEmpty))
  let message = handle {
    let _ = check_program_with_env_result(parse_program_with_path("workspace/main.vibe", "import ./collision.vibe { type Hidden }"), env)
    ""
  } with { Exception::Throw(error) => error }
  assert(String::contains(message, "import kind mismatch: `Hidden` is a value, not a type alias"))
}

