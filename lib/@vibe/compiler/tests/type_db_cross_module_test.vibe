test "projected checker root preserves direct alias re-export and companion origins" {
  let dep_path = "workspace/dep.vibe"
  let dep_env = checked_test_env("export let direct = 1\nexport let renamed = \"ok\"\nexport enum Choice { Pick(Int) }")
  let source = "import ./dep.vibe { direct, renamed as alias, Choice, Pick as ExplicitPick }\nexport ./dep.vibe { direct, renamed as forwarded }\nlet use_alias: String = alias\nlet use_direct: Int = direct"
  let checked = projected_checked_env(source, "workspace/main.vibe", [dep_path], [
    (dep_path, dep_env)
  ])
  assert_module_origin(checked, "direct", dep_path, "direct")
  assert_module_origin(checked, "alias", dep_path, "renamed")
  assert_module_origin(checked, "forwarded", dep_path, "renamed")
  assert_module_origin(checked, "Choice", dep_path, "Choice")
  assert_module_origin(checked, "ExplicitPick", dep_path, "Pick")
  // Importing the enum attaches its automatic companion using the
  // dependency's actual candidate name.
  assert_module_origin(checked, "Pick", dep_path, "Pick")
  match (env_lookup(checked, "use_alias"), env_lookup(checked, "use_direct")) {
    (Some(CtString), Some(CtInt)) => (),
    _ => assert(false)
  }
}

test "projected checker root keeps path and source-order winners with cached payloads" {
  let first_path = "workspace/first.vibe"
  let second_path = "workspace/second.vibe"
  let shared_source = "export let value = 1\nexport let other = 2"
  let first_env = env_cache(checked_test_env(shared_source))
  let second_env = env_cache(checked_test_env(shared_source))
  let source = "import ./first.vibe { value as firstCopy, value as chosen, other as clash }\nimport ./second.vibe { value as secondCopy, value as chosen }\nimport ./first.vibe { value as clash }"
  let checked = projected_checked_env(source, "workspace/main.vibe", [
    first_path,
    second_path,
    first_path
  ], [(first_path, first_env), (second_path, second_env)])
  match (env_lookup(checked, "chosen"), env_lookup(checked, "clash")) {
    (Some(CtInt), Some(CtInt)) => (),
    _ => assert(false)
  }
  assert_module_origin(checked, "firstCopy", first_path, "value")
  assert_module_origin(checked, "secondCopy", second_path, "value")
  assert_module_origin(checked, "chosen", second_path, "value")
  assert_module_origin(checked, "clash", first_path, "value")
}

test "projected checker root local hoist shadows imports while generic replay stays legacy" {
  let dep_path = "workspace/dep.vibe"
  let dep_env = checked_test_env("export let value = 1\nexport let source = \"text\"")
  let source = "import ./dep.vibe { value, source as alias }\nlet value: String = \"local\""
  let stmts = parse_program_with_path("workspace/main.vibe", source)
  let import_env = projected_import_env_for_test(source, "workspace/main.vibe", [
    dep_path
  ], [(dep_path, dep_env)])
  let projected = check_program_with_projected_import_env_result(stmts, import_env).final_env
  match env_lookup(projected, "value") {
    Some(CtString) => (),
    _ => assert(false)
  }
  assert_unavailable_origin(projected, "value")
  // The generic checker API intentionally retains its historical replay.
  let legacy = check_program_with_env_result(parse_program_with_path("workspace/main.vibe", source), import_env).final_env
  match env_lookup(legacy, "alias") {
    Some(CtUnknown) => (),
    _ => assert(false)
  }
  assert_unavailable_origin(legacy, "alias")
}

test "projected checker nested modules retain legacy import replay" {
  let dep_path = "workspace/dep.vibe"
  let dep_env = checked_test_env("export let source = \"text\"")
  let source = "import ./dep.vibe { source as alias }"
  let import_env = projected_import_env_for_test(source, "workspace/main.vibe", [
    dep_path
  ], [(dep_path, dep_env)])
  let checked = check_program_with_projected_import_env_result([
    SModule(false, "Nested", [
      SImport("./dep.vibe", [
        ImportItem::{ kind: None, name: "source", alias: Some("alias") }
      ]),
      // Legacy nested replay shadows the projected String with CtUnknown, so
      // this remains accepted exactly as before. Inheriting root projected
      // mode would retain String and reject the annotation.
      SLet(false, false, "nested", Some(TyName("Int")), EIdent("alias", -1))
    ])
  ], import_env).final_env
  assert_module_origin(checked, "alias", dep_path, "source")
}

test "projected import origins are stripped by public and persistent surfaces" {
  let dep_path = "workspace/dep.vibe"
  let dep_env = checked_test_env("export let value = 1")
  let source = "export ./dep.vibe { value }"
  let stmts = parse_program_with_path("workspace/main.vibe", source)
  let checked = projected_checked_env(source, "workspace/main.vibe", [dep_path], [
    (dep_path, dep_env)
  ])
  assert_module_origin(checked, "value", dep_path, "value")
  let published = checked_module_public_env(stmts, checked)
  assert_unavailable_origin(published, "value")
  let encoded = persistent_type_env_cache_text(published)
  match parse_persistent_type_env(encoded) {
    Some(decoded) => {
      assert_unavailable_origin(decoded, "value")
      assert(persistent_type_env_cache_text(decoded) == encoded)
    },
    None => assert(false)
  }
}

