//# Imports

import ../type_db.vibe {
  db_check_env, db_new, db_set_source, db_typecheck, db_typecheck_count,
  db_typecheck_fs
}

import @vibe/core {
  array_empty
}

import @vibe/compiler/core {
  env_lookup
}

import @vibe/compiler/runtime {
  set_collect_module_diagnostics, set_dep_order_seed
}

import @vibe/compiler/cache {
  compact_string_fingerprint,
  persistent_dep_list_cache_path,
  persistent_leaf_fingerprint_cache_path,
  persistent_module_header_cache_path,
  persistent_type_env_cache_path
}

//# Functions

fn remove_file_if_exists(path: String) -> Unit with { Fs } {
  if Fs::exists(path) {
    Fs::remove(path)
  } else {
    ()
  }
}

fn string_to_bytes(s: String) -> Bytes {
  let out = Bytes::new()
  let len = String::length(s)
  let mut i = 0
  while i < len {
    Bytes::push(out, String::char_code_at(s, i))
    i = i + 1
  }
  out
}

fn build_test_fingerprint(source: String, dep_fps: Array[(String, String)]) -> String {
  let mut acc = compact_string_fingerprint(source)
  let mut i = 0
  while i < Array::length(dep_fps) {
    let (dep_path, dep_fp) = Array::get(dep_fps, i)
    acc = compact_string_fingerprint(String::concat(acc, String::concat("|", String::concat(dep_path, String::concat("=", dep_fp)))))
    i = i + 1
  }
  acc
}

fn remove_typecheck_fs_cache(path: String, source: String, fingerprint: String) -> Unit with { Fs } {
  let source_fp = compact_string_fingerprint(source)
  remove_file_if_exists(persistent_dep_list_cache_path(path, source_fp))
  remove_file_if_exists(persistent_module_header_cache_path(path, source_fp))
  remove_file_if_exists(persistent_leaf_fingerprint_cache_path(path, source_fp))
  remove_file_if_exists(persistent_type_env_cache_path(fingerprint))
}

//# Misc

test "cross-module type propagation" {
  let db0 = db_new()
  let db1 = db_set_source(db_set_source(db0, "a.vibe", "import ./b.vibe { y }\nlet x = y"), "b.vibe", "export let y = 42")
  let db2 = db_typecheck(db1, "a.vibe")
  let b_y_is_int = match db_check_env(db2, "b.vibe") {
    Some(e) => match env_lookup(e, "y") {
      Some(CtInt) => true,
      _ => false
    },
    None => false
  }
  assert(b_y_is_int)
  let a_y_is_int = match db_check_env(db2, "a.vibe") {
    Some(e) => match env_lookup(e, "y") {
      Some(CtInt) => true,
      _ => false
    },
    None => false
  }
  assert(a_y_is_int)
  let a_x_is_int = match db_check_env(db2, "a.vibe") {
    Some(e) => match env_lookup(e, "x") {
      Some(CtInt) => true,
      _ => false
    },
    None => false
  }
  assert(a_x_is_int)
}

test "cross-module re-export propagates enum constructors" {
  let db0 = db_new()
  let ast_src = "export enum TypeExpr { TyName(String); TyTuple(Array[TypeExpr]) }"
  let index_src = "export ./ast.vibe { TypeExpr }"
  let main_src = "import ./index.vibe { TypeExpr }\nlet ann: TypeExpr = TyTuple([TyName(\"Int\")])"
  let db1 = db_set_source(db_set_source(db_set_source(db0, "main.vibe", main_src), "index.vibe", index_src), "ast.vibe", ast_src)
  let db2 = db_typecheck(db1, "main.vibe")
  let has_ann = match db_check_env(db2, "main.vibe") {
    Some(e) => match env_lookup(e, "ann") {
      Some(CtUnknown) => false,
      Some(_) => true,
      _ => false
    },
    None => false
  }
  assert(has_ann)
  let has_ctor = match db_check_env(db2, "main.vibe") {
    Some(e) => match env_lookup(e, "TyTuple") {
      Some(CtUnknown) => false,
      Some(_) => true,
      _ => false
    },
    None => false
  }
  assert(has_ctor)
}

test "db_typecheck_fs: re-exported enum type imports constructors" {
  let ast_path = "/tmp/vibe_compiler_reexport_enum_ctor_fs_ast.vibe"
  let index_path = "/tmp/vibe_compiler_reexport_enum_ctor_fs_index.vibe"
  let main_path = "/tmp/vibe_compiler_reexport_enum_ctor_fs_main.vibe"
  let ast_src = "export enum TypeExpr { TyName(String); TyTuple(Array[TypeExpr]) }"
  let index_src = "export ./vibe_compiler_reexport_enum_ctor_fs_ast.vibe { TypeExpr }"
  let main_src = "import ./vibe_compiler_reexport_enum_ctor_fs_index.vibe { TypeExpr }\nlet ann: TypeExpr = TyTuple([TyName(\"Int\")])"
  Fs::write_bytes(ast_path, string_to_bytes(ast_src))
  Fs::write_bytes(index_path, string_to_bytes(index_src))
  Fs::write_bytes(main_path, string_to_bytes(main_src))
  let ast_fp = build_test_fingerprint(ast_src, array_empty())
  let index_fp = build_test_fingerprint(index_src, [
    (ast_path, ast_fp)
  ])
  let main_fp = build_test_fingerprint(main_src, [
    (index_path, index_fp)
  ])
  remove_typecheck_fs_cache(ast_path, ast_src, ast_fp)
  remove_typecheck_fs_cache(index_path, index_src, index_fp)
  remove_typecheck_fs_cache(main_path, main_src, main_fp)
  let db1 = db_set_source(db_set_source(db_set_source(db_new(), ast_path, ast_src), index_path, index_src), main_path, main_src)
  let db2 = db_typecheck_fs(db1, main_path)
  let has_ctor = match db_check_env(db2, main_path) {
    Some(e) => match env_lookup(e, "TyTuple") {
      Some(CtUnknown) => false,
      Some(_) => true,
      _ => false
    },
    None => false
  }
  assert(has_ctor)
}

test "db_typecheck_fs: extensionless directory re-export imports enum constructors" {
  let base_dir = "/tmp/vibe_compiler_dir_reexport_enum_ctor_fs"
  let core_dir = String::concat(base_dir, "/core")
  let ast_path = String::concat(core_dir, "/ast.vibe")
  let index_path = String::concat(core_dir, "/index.vibe")
  let main_path = String::concat(base_dir, "/main.vibe")
  let ast_src = "export enum TypeExpr { TyName(String); TyTuple(Array[TypeExpr]) }"
  let index_src = "export ./ast.vibe { TypeExpr }"
  let main_src = "import ./core { TypeExpr }\nlet ann: TypeExpr = TyTuple([TyName(\"Int\")])"
  Fs::mkdir_p(core_dir)
  Fs::write_bytes(ast_path, string_to_bytes(ast_src))
  Fs::write_bytes(index_path, string_to_bytes(index_src))
  Fs::write_bytes(main_path, string_to_bytes(main_src))
  let ast_fp = build_test_fingerprint(ast_src, array_empty())
  let index_fp = build_test_fingerprint(index_src, [
    (ast_path, ast_fp)
  ])
  let main_fp = build_test_fingerprint(main_src, [
    (index_path, index_fp)
  ])
  remove_typecheck_fs_cache(ast_path, ast_src, ast_fp)
  remove_typecheck_fs_cache(index_path, index_src, index_fp)
  remove_typecheck_fs_cache(main_path, main_src, main_fp)
  let db1 = db_set_source(db_set_source(db_set_source(db_new(), ast_path, ast_src), index_path, index_src), main_path, main_src)
  let db2 = db_typecheck_fs(db1, main_path)
  let has_ctor = match db_check_env(db2, main_path) {
    Some(e) => match env_lookup(e, "TyTuple") {
      Some(CtUnknown) => false,
      Some(_) => true,
      _ => false
    },
    None => false
  }
  assert(has_ctor)
}

test "db_typecheck_fs: source update bypasses current-run cache" {
  let path = "/tmp/vibe_compiler_type_db_fs_source_update.vibe"
  let source1 = "export let value = 1"
  let source2 = "export let value = \"updated\""
  let fp1 = build_test_fingerprint(source1, array_empty())
  let fp2 = build_test_fingerprint(source2, array_empty())
  remove_typecheck_fs_cache(path, source1, fp1)
  remove_typecheck_fs_cache(path, source2, fp2)
  Fs::write_bytes(path, string_to_bytes(source1))
  let db1 = db_typecheck_fs(db_set_source(db_new(), path, source1), path)
  let is_int = match db_check_env(db1, path) {
    Some(e) => match env_lookup(e, "value") {
      Some(CtInt) => true,
      _ => false
    },
    None => false
  }
  assert(is_int)
  Fs::write_bytes(path, string_to_bytes(source2))
  let db2 = db_typecheck_fs(db_set_source(db1, path, source2), path)
  let is_string = match db_check_env(db2, path) {
    Some(e) => match env_lookup(e, "value") {
      Some(CtString) => true,
      _ => false
    },
    None => false
  }
  assert(is_string)
}

test "cross-module cold/warm consistency" {
  let db0 = db_new()
  let db1 = db_set_source(db_set_source(db0, "a.vibe", "import ./b.vibe { y }\nlet x = y"), "b.vibe", "export let y = 42")
  let db2 = db_typecheck(db1, "a.vibe")
  let count1 = db_typecheck_count(db2)
  let db3 = db_typecheck(db2, "a.vibe")
  let count2 = db_typecheck_count(db3)
  assert(eq(count1, count2))
}

/// #1259: the three-module shape both diagnostic tests below run on.
///
/// `alpha` and `beta` are INDEPENDENT bad leaves -- neither imports the other,
/// so they land in the same wave and a failure in one says nothing about the
/// other's inputs. `main` imports both, so it is blocked by them and must
/// contribute no cascade diagnostic of its own.
///
/// The three sources are written fresh and their caches cleared, so the walk
/// really checks all three rather than reusing a persistent type env.
fn write_two_bad_leaves(tag: String) -> String with { Error, Fs } {
  let dir = String::concat("/tmp/vibe_compiler_diag_collect_", tag)
  let alpha_path = String::concat(dir, "/alpha.vibe")
  let beta_path = String::concat(dir, "/beta.vibe")
  let main_path = String::concat(dir, "/main.vibe")
  let alpha_src = "export let a: Int = \"alpha is not an Int\""
  let beta_src = "export let b: Int = \"beta is not an Int\""
  let main_src = "import ./alpha.vibe { a }\nimport ./beta.vibe { b }\nexport let m = a + b"
  Fs::mkdir_p(dir)
  Fs::write_bytes(alpha_path, string_to_bytes(alpha_src))
  Fs::write_bytes(beta_path, string_to_bytes(beta_src))
  Fs::write_bytes(main_path, string_to_bytes(main_src))
  let alpha_fp = build_test_fingerprint(alpha_src, array_empty())
  let beta_fp = build_test_fingerprint(beta_src, array_empty())
  remove_typecheck_fs_cache(alpha_path, alpha_src, alpha_fp)
  remove_typecheck_fs_cache(beta_path, beta_src, beta_fp)
  remove_typecheck_fs_cache(main_path, main_src, build_test_fingerprint(main_src, [
    (alpha_path, alpha_fp),
    (beta_path, beta_fp)
  ]))
  dir
}

/// The error `db_typecheck_fs` raises for `<dir>/main.vibe`, or "" if it
/// somehow succeeded.
///
/// All three sources go into the db, not just the root's: the walk skips any
/// module `ripple_get_source` does not know (plan_import_graph_fs's `None`
/// arm), so seeding only main would leave alpha and beta unchecked and the
/// single diagnostic would be main's own unresolved import -- the opposite of
/// what these tests are about.
fn typecheck_fs_error(dir: String) -> String with { Fs } {
  let alpha_path = String::concat(dir, "/alpha.vibe")
  let beta_path = String::concat(dir, "/beta.vibe")
  let main_path = String::concat(dir, "/main.vibe")
  handle {
    let db0 = db_set_source(db_set_source(db_set_source(db_new(), alpha_path, Fs::read_file(alpha_path)), beta_path, Fs::read_file(beta_path)), main_path, Fs::read_file(main_path))
    let _db = db_typecheck_fs(db0, main_path)
    ""
  } with Error {
    Throw(msg) => msg
  }
}

fn count_lines(s: String) -> Int {
  Array::length(String::split(s, "\n"))
}

test "db_typecheck_fs: fail-fast is still the default (#1259)" {
  let dir = write_two_bad_leaves("failfast")
  let err = typecheck_fs_error(dir)
  // ONE diagnostic, for one of the two bad leaves -- unchanged from before
  // collection existed. The walk stops there; `main` is never reached.
  assert(eq(count_lines(err), 1))
  assert(String::contains(err, "/alpha.vibe: ") || String::contains(err, "/beta.vibe: "))
}

test "db_typecheck_fs: collected diagnostics are canonically ordered (#1259)" {
  let dir = write_two_bad_leaves("collect")
  let alpha_path = String::concat(dir, "/alpha.vibe")
  let beta_path = String::concat(dir, "/beta.vibe")
  // dep_visit_order permutes the order WITHIN a wave, which is exactly the
  // choice a parallel coordinator makes differently from run to run. The
  // collected set must not depend on it: same diagnostics, same order, same
  // bytes. Seeds 0 (identity) and 7 (a real permutation of the two-module
  // wave) are checked against each other, so this fails if the sort is
  // dropped and collection order leaks through.
  set_collect_module_diagnostics(true)
  set_dep_order_seed(0)
  let err_identity = typecheck_fs_error(dir)
  set_dep_order_seed(7)
  let err_permuted = typecheck_fs_error(dir)
  // Restored BEFORE the assertions: both cells are process-global, so an
  // assertion failure here must not leave collection (or a shuffled visit
  // order) switched on for every test that runs after this one.
  set_dep_order_seed(0)
  set_collect_module_diagnostics(false)
  assert(err_identity == err_permuted)
  // Both leaves reported, one per line, alpha before beta (canonical order is
  // module path first, and "alpha" < "beta").
  assert(eq(count_lines(err_identity), 2))
  let lines = String::split(err_identity, "\n")
  assert(String::starts_with(Array::get(lines, 0), String::concat(alpha_path, ": ")))
  assert(String::starts_with(Array::get(lines, 1), String::concat(beta_path, ": ")))
  // `main` is BLOCKED by both, not broken: it must not add a cascade
  // diagnostic of its own about `a` or `b` being unknown.
  assert(!String::contains(err_identity, "/main.vibe"))
}

/// #1259 (Codex review of PR #1264): a SYNTAX error is raised while the plan
/// resolves a module's imports -- parsing its header -- which happens before
/// the walk's per-step handler exists. Left alone that made parse errors
/// fail-fast even while collecting: two malformed leaves reported one
/// diagnostic, because planning aborted on the first.
///
/// Scope: this is the walk's own layer. `vibe build`/`check` still report one
/// parse error, because collect_source_groups_fs parses every reachable file
/// before db_typecheck_fs is ever called -- a separate, earlier fail-fast
/// point in the loader that this does not change.
test "db_typecheck_fs: syntax errors in independent leaves are both collected (#1259)" {
  let dir = "/tmp/vibe_compiler_diag_collect_parse"
  let alpha_path = String::concat(dir, "/alpha.vibe")
  let beta_path = String::concat(dir, "/beta.vibe")
  let main_path = String::concat(dir, "/main.vibe")
  let alpha_src = "export let a: Int = ((("
  let beta_src = "export let b: Int = )))"
  let main_src = "import ./alpha.vibe { a }\nimport ./beta.vibe { b }\nexport let m = a + b"
  Fs::mkdir_p(dir)
  Fs::write_bytes(alpha_path, string_to_bytes(alpha_src))
  Fs::write_bytes(beta_path, string_to_bytes(beta_src))
  Fs::write_bytes(main_path, string_to_bytes(main_src))
  remove_typecheck_fs_cache(alpha_path, alpha_src, build_test_fingerprint(alpha_src, array_empty()))
  remove_typecheck_fs_cache(beta_path, beta_src, build_test_fingerprint(beta_src, array_empty()))
  set_collect_module_diagnostics(true)
  let err = typecheck_fs_error(dir)
  set_collect_module_diagnostics(false)
  assert(eq(count_lines(err), 2))
  let lines = String::split(err, "\n")
  assert(String::starts_with(Array::get(lines, 0), String::concat(alpha_path, ": ")))
  assert(String::starts_with(Array::get(lines, 1), String::concat(beta_path, ": ")))
  // Blocked, not broken: main imports both, so it adds no cascade of its own.
  assert(!String::contains(err, "/main.vibe"))
}

test "cross-module delta recomputation" {
  let db0 = db_new()
  let db1 = db_set_source(db_set_source(db_set_source(db0, "a.vibe", "import ./b.vibe { y }\nlet x = y"), "b.vibe", "export let y = 1"), "c.vibe", "let z = 99")
  let db2 = db_typecheck(db_typecheck(db1, "a.vibe"), "c.vibe")
  assert(eq(db_typecheck_count(db2), 3))
  let db3 = db_set_source(db2, "b.vibe", "export let y = 2")
  let db4 = db_typecheck(db3, "a.vibe")
  assert(eq(db_typecheck_count(db4), 5))
}
