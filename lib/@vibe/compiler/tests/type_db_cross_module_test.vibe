test "nested aliases rebuild earlier outer binding types" {
  let message = handle {
    let _ = check_program_with_env_result([
      STypeAlias(false, "Alias", array_empty(), TyName("Pair")),
      SLet(false, false, "value", Some(TyName("Alias")), EInt(1)),
      SModule(false, "Second", [
        STypeAlias(false, "Pair", array_empty(), TyName("Int"))
      ]),
      SLet(false, false, "bad", Some(TyName("String")), EIdent("value", -1))
    ], EnvEmpty)
    ""
  } with { Exception::Throw(error) => error }
  assert(String::contains(message, "binding type mismatch for bad"))
}

test "completed aliases rebuild retained root type observations" {
  match check_program_statement_root_type_observation([
    STypeAlias(false, "Alias", array_empty(), TyName("Pair")),
    SLet(false, false, "make", None, EFn(array_empty(), array_empty(), array_empty(), Some(TyName("Alias")), None, EInt(1))),
    SModule(false, "Nested", [
      STypeAlias(false, "Pair", array_empty(), TyName("Int"))
    ])
  ]) {
    Some(observation) => {
      assert(Array::length(observation.entries) == 1)
      let (_, _, root_type) = Array::get(observation.entries, 0)
      match root_type {
        CtFn(_, CtInt, _) => (),
        _ => assert(false)
      }
      match env_lookup(observation.checked_program.final_env, "make") {
        Some(CtFn(_, CtInt, _)) => (),
        _ => assert(false)
      }
    },
    None => assert(false)
  }
}

test "nested sibling aliases revalidate earlier suberror map keys" {
  let message = handle {
    let _ = check_program_with_env_result([
      SModule(false, "First", [
        SSuberror(false, "Bad", [
          ("Bad", [TyApp("Map", [TyName("Key"), TyName("Int")])])
        ])
      ]),
      SModule(false, "Second", [
        STypeAlias(false, "Key", array_empty(), TyName("Int"))
      ])
    ], EnvEmpty)
    ""
  } with { Exception::Throw(error) => error }
  assert(String::contains(message, "the builtin map is String-keyed"))
}

test "recursive-alias reachability memoizes shared diamond suffixes" {
  let stmts = array_empty()
  let mut i = 0
  while i < 16 {
    let suffix = __to_string(i)
    let next_suffix = __to_string(i + 1)
    let body = TyTuple([
      TyName(String::concat("A", next_suffix)),
      TyName(String::concat("B", next_suffix))
    ])
    Array::push(stmts, STypeAlias(false, String::concat("A", suffix), array_empty(), body))
    Array::push(stmts, STypeAlias(false, String::concat("B", suffix), array_empty(), body))
    i = i + 1
  }
  Array::push(stmts, STypeAlias(false, "A16", array_empty(), TyName("Int")))
  Array::push(stmts, STypeAlias(false, "B16", array_empty(), TyName("Int")))
  let checked = check_program_with_env_result(stmts, EnvEmpty)
  match env_lookup(checked.final_env, "A0") {
    Some(_) => (),
    None => assert(false)
  }
}

fn projected_checked_env(source: String, path: String, deps: Array[String], full_cache: Array[(String, TypeEnv)]) -> TypeEnv with Exception {
  let import_env = projected_import_env_for_test(source, path, deps, full_cache)
  check_program_with_projected_import_env_result(parse_program_with_path(path, source), import_env).final_env
}

test "imported helpers retain region dependency contracts" {
  let dep_source = "export struct Slot { callback: () -> Array[Int] }\nexport fn unwrap(slot: Slot) -> () -> Array[Int] {\n  let callback = slot.callback\n  callback\n}"
  let main_source = "import ./dep.vibe { Slot, unwrap }\nlet escaped = region r {\n  let values = MutList::empty(r)\n  unwrap(Slot::{ callback: () -> Array[Int] { MutList::to_array(values) } })\n}\nlet _ = escaped()"
  let message = typecheck_db_pair_error(dep_source, main_source)
  assert(String::contains(message, "region escapes its scope"))
}

fn assert_module_origin(env: TypeEnv, bound_name: String, expected_path: String, expected_source_name: String) -> Unit {
  match env_lookup_binding(env, bound_name) {
    Some(binding) => match binding.origin {
      BindingOriginModuleExport(path, source_name) => {
        assert(path == expected_path)
        assert(source_name == expected_source_name)
      },
      _ => assert(false)
    },
    None => assert(false)
  }
}

fn assert_unavailable_origin(env: TypeEnv, name: String) -> Unit {
  match env_lookup_binding(env, name) {
    Some(binding) => match binding.origin {
      BindingOriginUnavailable => (),
      _ => assert(false)
    },
    None => assert(false)
  }
}

