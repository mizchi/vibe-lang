// #1967: pin that derive(LocalEq) / derive(LocalOrd) still reject.
// Value claims live in fixtures/derive_struct_eq_marker_impl_test.vibe and
// fixtures/derive_struct_ord_implies_eq_test.vibe via current derive(Eq)/Ord.

//# Imports

import ./checker_parity_test_support.vibe {
  check_source_error_message
}

//# Misc

test "derive LocalEq is an unknown trait" {
  inspect(check_source_error_message("struct Point { x: Int; y: Int } derive(LocalEq)"), "unknown trait: LocalEq")
}

test "declared LocalEq plus derive LocalEq is still unknown" {
  inspect(check_source_error_message("trait LocalEq\nstruct Point { x: Int; y: Int } derive(LocalEq)\nlet same = [T: LocalEq](a: T, b: T) -> Bool { true }"), "unknown trait: LocalEq")
}

test "derive LocalOrd is an unknown trait" {
  inspect(check_source_error_message("struct Token { value: Int } derive(LocalOrd)"), "unknown trait: LocalOrd")
}

test "declared LocalOrd plus derive LocalOrd is still unknown" {
  inspect(check_source_error_message("trait LocalEq\ntrait LocalOrd: LocalEq\nstruct Token { value: Int } derive(LocalOrd)\nlet same = [T: LocalOrd](a: T, b: T) -> Bool { true }\nlet accepts_eq = [T: LocalEq](value: T) -> Bool { true }"), "unknown trait: LocalOrd")
}
