//# Complete direct checker-return expression observation regression coverage

import @vibe/compiler/core {
  Expr, Pat, Stmt, Type, TypeEnv, TypeExpr, env_bind
}

import @vibe/compiler/checker {
  CheckedDirectExpressionReturnObservation,
  check_program_direct_expression_return_observation,
  check_program_with_env_direct_expression_return_observation
}

import @vibe/compiler/checker/artifacts {
  canonical_checked_direct_expression_return_snapshot,
  checked_direct_expression_return_observation_expression_path_at,
  checked_direct_expression_return_observation_row_count,
  checked_direct_expression_return_observation_statement_path_at,
  checked_direct_expression_return_observation_type_at
}

import @vibe/core {
  array_empty
}

fn direct_paths_equal(left: Array[Int], right: Array[Int]) -> Bool {
  if Array::length(left) != Array::length(right) {
    false
  } else {
    let mut i = 0
    let mut same = true
    while i < Array::length(left) {
      if Array::get(left, i) != Array::get(right, i) {
        same = false
      } else {
        ()
      }
      i = i + 1
    }
    same
  }
}

fn direct_assert_statement_path(observation: CheckedDirectExpressionReturnObservation, row: Int, expected: Array[Int]) -> Unit {
  match checked_direct_expression_return_observation_statement_path_at(observation, row) {
    Some(path) => assert(direct_paths_equal(path, expected)),
    None => assert(false)
  }
}

fn direct_assert_expression_path(observation: CheckedDirectExpressionReturnObservation, row: Int, expected: Array[Int]) -> Unit {
  match checked_direct_expression_return_observation_expression_path_at(observation, row) {
    Some(path) => assert(direct_paths_equal(path, expected)),
    None => assert(false)
  }
}

fn direct_fixture() -> Array[Stmt] {
  [
    SLet(false, false, "value", None, EIf(EBool(true), ETuple([
      EInt(1),
      EInt(2)
    ]), ETuple([
      EInt(3),
      EInt(4)
    ]))),
    SLet(false, false, "spine", None, ELet("a", EInt(5), ESeq(EInt(6), EInt(7)), -1))
  ]
}

test "direct return observation reconciles every retained preorder coordinate" {
  match check_program_direct_expression_return_observation(direct_fixture()) {
    Some(observation) => {
      assert(checked_direct_expression_return_observation_row_count(observation) == 13)
      match checked_direct_expression_return_observation_statement_path_at(observation, 0) {
        Some(path) => assert(direct_paths_equal(path, [
          0
        ])),
        None => assert(false)
      }
      direct_assert_expression_path(observation, 0, array_empty())
      direct_assert_expression_path(observation, 1, [
        0
      ])
      direct_assert_expression_path(observation, 4, [
        1,
        1
      ])
      direct_assert_expression_path(observation, 8, array_empty())
      direct_assert_expression_path(observation, 9, [
        0
      ])
      direct_assert_expression_path(observation, 10, [
        1
      ])
      direct_assert_expression_path(observation, 12, [
        1,
        1
      ])
      match checked_direct_expression_return_observation_type_at(observation, 0) {
        Some(_) => (),
        None => assert(false)
      }
    },
    None => assert(false)
  }
}

test "direct return observation retains nested source paths despite type-first checking" {
  let stmts = [
    SModule(false, "Outer", [
      // The nested enum is checked before this retained source slot.
      SLet(false, false, "before", None, EIdent("Pick", 70)),
      SEnum(false, "Choice", array_empty(), [
        ("Pick", array_empty())
      ], array_empty()),
      SLet(false, false, "tuple", None, ETuple([
        EInt(1),
        EInt(2)
      ]))
    ])
  ]
  match check_program_direct_expression_return_observation(stmts) {
    Some(observation) => {
      assert(checked_direct_expression_return_observation_row_count(observation) == 4)
      direct_assert_statement_path(observation, 0, [
        0,
        0
      ])
      direct_assert_expression_path(observation, 0, array_empty())
      direct_assert_statement_path(observation, 1, [
        0,
        2
      ])
      direct_assert_expression_path(observation, 1, array_empty())
      direct_assert_expression_path(observation, 2, [
        0
      ])
      direct_assert_expression_path(observation, 3, [
        1
      ])
    },
    None => assert(false)
  }
}

test "direct return observation preserves effectset-expanded topology and canonical types" {
  let stmts = [
    SEffectSet(false, "Caps", [
      "Fs",
      "Error"
    ]),
    SLet(false, false, "f", None, EFn(array_empty(), array_empty(), array_empty(), None, Some("Caps"), EIf(EBool(true), EInt(1), EInt(2))))
  ]
  match check_program_direct_expression_return_observation(stmts) {
    Some(observation) => {
      assert(checked_direct_expression_return_observation_row_count(observation) == 5)
      let mut row = 0
      while row < 5 {
        direct_assert_statement_path(observation, row, [
          1
        ])
        row = row + 1
      }
      direct_assert_expression_path(observation, 0, array_empty())
      direct_assert_expression_path(observation, 1, [
        0
      ])
      direct_assert_expression_path(observation, 2, [
        0,
        0
      ])
      direct_assert_expression_path(observation, 3, [
        0,
        1
      ])
      direct_assert_expression_path(observation, 4, [
        0,
        2
      ])
      match checked_direct_expression_return_observation_type_at(observation, 0) {
        Some(ty) => assert(ty == "F22:I014:ER25:Error2:Fs"),
        None => assert(false)
      }
    },
    None => assert(false)
  }
}

test "direct return observation canonicalizes final substitutions exactly" {
  let stmts = [
    SLet(false, false, "identity", None, EFn(array_empty(), array_empty(), [
      ("value", None)
    ], Some(TyName("Int")), None, EIdent("value", 90)))
  ]
  match check_program_direct_expression_return_observation(stmts) {
    Some(observation) => match checked_direct_expression_return_observation_type_at(observation, 1) {
      // The raw parameter variable was unified with the annotated return.
      Some(ty) => assert(ty == "I0"),
      None => assert(false)
    },
    None => assert(false)
  }
}

test "direct return observation has with-env parity and deterministic snapshots" {
  match check_program_direct_expression_return_observation(direct_fixture()) {
    Some(ordinary) => match check_program_with_env_direct_expression_return_observation(direct_fixture(), env_bind(EnvEmpty, "seed", CtInt)) {
      Some(with_env) => assert(canonical_checked_direct_expression_return_snapshot(ordinary) == canonical_checked_direct_expression_return_snapshot(with_env)),
      None => assert(false)
    },
    None => assert(false)
  }
}

test "direct return observation preserves ordinary checker errors" {
  let invalid = [
    SLet(false, false, "value", Some(TyName("Int")), EString("wrong"))
  ]
  handle {
    match check_program_direct_expression_return_observation(invalid) {
      None => assert(false),
      Some(_) => assert(false)
    }
  } with Error {
    Throw(_) => ()
  }
}

test "direct return observation refuses skipped, synthetic, and auxiliary routes" {
  let recognized = [
    SLet(false, false, "value", None, ECall(EIdent("Some", 10), [
      EInt(1)
    ], 11))
  ]
  match check_program_direct_expression_return_observation(recognized) {
    None => (),
    Some(_) => assert(false)
  }
  let spread = [
    SLet(false, false, "value", None, ESpread(EInt(2)))
  ]
  match check_program_direct_expression_return_observation(spread) {
    None => (),
    Some(_) => assert(false)
  }
  let synthetic = [
    SLet(false, false, "value", None, EDot(EIdent("mod", 40), "value", 41, 42))
  ]
  match check_program_with_env_direct_expression_return_observation(synthetic, env_bind(EnvEmpty, "mod.value", CtInt)) {
    None => (),
    Some(_) => assert(false)
  }
  let auxiliary = [
    SEffectDef(false, "Ask", array_empty(), [
      ("Get", array_empty(), TyName("Int"))
    ]),
    SLet(false, false, "handled", None, EHandle(EInt(1), [
      (PCtor("Ask::Get", array_empty()), ECall(EIdent("resume", -1), [
        EIdent("outer", 50)
      ], -1))
    ]))
  ]
  match check_program_with_env_direct_expression_return_observation(auxiliary, env_bind(EnvEmpty, "outer", CtInt)) {
    None => (),
    Some(_) => assert(false)
  }
}

test "direct return observation remains available for a large retained row set" {
  let elements = array_empty()
  let mut i = 0
  while i < 16384 {
    Array::push(elements, EInt(i))
    i = i + 1
  }
  match check_program_direct_expression_return_observation([
    SLet(false, false, "many", None, EArray(elements))
  ]) {
    Some(observation) => {
      assert(checked_direct_expression_return_observation_row_count(observation) == 16385)
      direct_assert_expression_path(observation, 0, array_empty())
      direct_assert_expression_path(observation, 16384, [
        16383
      ])
    },
    None => assert(false)
  }
}
