//# Imports

// #1340 (ADR-0071): generic effect declarations register their operation
// signatures (instantiated per perform/handle site with fresh inference
// vars), `with State[Int]` row items parse, and the interim #1302
// declaration-site warning is retired. These are end-to-end locks through
// collect_all_diagnostics.
import @vibe/compiler/runtime {
  collect_all_diagnostics
}

//# Misc

test "a clean generic effect declaration produces no diagnostics (warning retired)" {
  let src = "effect State[S] {\n  Get() -> S\n}\n\nlet main = () -> Int {\n  42\n}\n"
  let diags = collect_all_diagnostics(src)
  assert(eq(Array::length(diags), 0))
}

test "perform arity against a generic effect op is checked" {
  // The #1218 hole: `perform State::Get(1, 2, 3)` against `Get() -> S`
  // passed silently because generic effects never entered the registry.
  let src = "effect State[S] {\n  Get() -> S;\n  Put(S) -> Unit\n}\n\nlet main = () -> Int with State {\n  perform State::Get(1, 2, 3)\n}\n"
  let diags = collect_all_diagnostics(src)
  assert(eq(Array::length(diags), 1))
  let d = Array::get(diags, 0)
  assert(String::contains(d, "perform State::Get expects 0 argument(s), got 3"))
}

test "a bare perform of a parameterful generic op is an arity error" {
  let src = "effect Box[T] {\n  Put(T) -> Unit\n}\n\nlet main = () -> Int with Box {\n  perform Box::Put\n  42\n}\n"
  let diags = collect_all_diagnostics(src)
  assert(eq(Array::length(diags), 1))
  assert(String::contains(Array::get(diags, 0), "perform Box::Put expects 1 argument(s), got 0"))
}

test "with State[Int] row items parse and check" {
  let src = "effect State[S] {\n  Get() -> S;\n  Put(S) -> Unit\n}\n\nlet read_it = () -> Int with State[Int] {\n  perform State::Get()\n}\n\nlet main = () -> Int {\n  handle {\n    read_it()\n  } with {\n    State::Get => resume(7);\n    State::Put(_v) => resume(())\n  }\n}\n"
  let diags = collect_all_diagnostics(src)
  assert(eq(Array::length(diags), 0))
}

test "a row instantiation of a non-generic effect is rejected" {
  let src = "effect Log {\n  Emit(Int) -> Unit\n}\n\nlet f = () -> Int with Log[Int] {\n  42\n}\n\nlet main = () -> Int {\n  f()\n}\n"
  let diags = collect_all_diagnostics(src)
  assert(eq(Array::length(diags), 1))
  assert(String::contains(Array::get(diags, 0), "effect Log declares no type parameters"))
}

test "a multi-argument row instantiation is rejected at parse" {
  let src = "effect Pair[A, B] {\n  Mk(A, B) -> Unit\n}\n\nlet f = () -> Int with Pair[Int, String] {\n  42\n}\n\nlet main = () -> Int {\n  f()\n}\n"
  let diags = collect_all_diagnostics(src)
  assert(eq(Array::length(diags), 1))
  assert(String::contains(Array::get(diags, 0), "exactly one type argument"))
}

test "handler arm payload arity for a generic effect is checked" {
  let src = "effect Box[T] {\n  Put(T) -> Unit\n}\n\nlet main = () -> Int {\n  handle {\n    perform Box::Put(1)\n    42\n  } with {\n    Box::Put(a, b) => resume(())\n  }\n}\n"
  let diags = collect_all_diagnostics(src)
  assert(eq(Array::length(diags), 1))
  assert(String::contains(Array::get(diags, 0), "payload binding"))
}

test "handler arms share one instantiation per handle" {
  // `Get => resume(0)` pins S = Int; the `Put(v)` payload binder must see
  // the SAME S, so annotating it String is a type error.
  let src = "effect State[S] {\n  Get() -> S;\n  Put(S) -> Unit\n}\n\nlet main = () -> Int {\n  handle {\n    let n = perform State::Get()\n    perform State::Put(n)\n    n\n  } with {\n    State::Get => resume(0);\n    State::Put(v) => {\n      let s: String = v\n      resume(())\n    }\n  }\n}\n"
  let diags = collect_all_diagnostics(src)
  assert(eq(Array::length(diags), 1))
}

// Codex P1 on #1352: the handled BODY must share the handle's instantiation
// with the arms. The two findings in that review turned out to be COUPLED --
// on the merged compiler these cases were caught only because the row-label
// set comparison was too loose (it accepted rows it should have rejected, and
// that spurious acceptance is what linked the body's type variable to the
// arm's). Tightening effect_label_sets_equal alone made the diagnostic below
// vanish, i.e. it turned the reviewer's scenario into a live hole; the fix is
// the explicit per-handle instantiation published through the type env
// (effect_instantiate). These three tests pin both halves.

test "the handled body shares the handle's instantiation with the arms" {
  // The body pins T = String (`let s: String`); `resume(123)` therefore
  // resumes a String-expecting continuation with an Int and must be rejected.
  let src = "effect Box[T] {\n  Get() -> T\n}\n\nlet main = () -> Int {\n  handle {\n    let s: String = perform Box::Get()\n    String::length(s)\n  } with {\n    Box::Get => resume(123)\n  }\n}\n"
  let diags = collect_all_diagnostics(src)
  assert(eq(Array::length(diags), 1))
  assert(String::contains(Array::get(diags, 0), "resume value type mismatch"))
}

test "a body and arm agreeing on the instantiation still type-check" {
  let src = "effect Box[T] {\n  Get() -> T\n}\n\nlet main = () -> Int {\n  handle {\n    let s: String = perform Box::Get()\n    String::length(s)\n  } with {\n    Box::Get => resume(\"abcd\")\n  }\n}\n"
  let diags = collect_all_diagnostics(src)
  assert(eq(Array::length(diags), 0))
}

// Codex P1 on #1354: an arm body runs OUTSIDE the handled computation ("an
// Async handler arm's own body is NOT an async context",
// checker_async_effects_test), so an operation RE-performed inside an arm is
// handled by the ENCLOSING handler, not by the handle that owns the arm. The
// arm env therefore must NOT carry this handle's instantiation.
//
// Below, the inner handle instantiates Box at Int, and its arm re-performs
// Box::Get() at String -- legal precisely because that re-perform belongs to
// the OUTER handle (which resumes with a String). Reusing the inner
// instantiation for arm bodies would make this a conflicting second pin of the
// inner T, i.e. a false rejection of a valid program.
test "a re-perform inside an arm belongs to the OUTER handler" {
  let src = "effect Box[T] {\n  Get() -> T\n}\n\nlet main = () -> Int {\n  handle {\n    handle {\n      let n: Int = perform Box::Get()\n      n\n    } with {\n      Box::Get => {\n        let m: String = perform Box::Get()\n        resume(String::length(m))\n      }\n    }\n  } with {\n    Box::Get => resume(\"s\")\n  }\n}\n"
  let diags = collect_all_diagnostics(src)
  assert(eq(Array::length(diags), 0))
}

test "two performs of one generic effect at conflicting types are rejected" {
  // One handler cannot return both a String and an Int, so the two performs
  // must resolve to the SAME instantiation and collide.
  let src = "effect Box[T] {\n  Get() -> T\n}\n\nlet main = () -> Int {\n  handle {\n    let s: String = perform Box::Get()\n    let n: Int = perform Box::Get()\n    String::length(s) + n\n  } with {\n    Box::Get => resume(\"abcd\")\n  }\n}\n"
  let diags = collect_all_diagnostics(src)
  assert(eq(Array::length(diags), 1))
}

// Codex P1 on #1352: effect_label_list dedupes by EXACT label, which is what
// made "equal length + one-way membership" a sound set-equality test. Base-name
// comparison alone breaks it: `{ State[Int], State[String] }` is two exact
// labels but one base, so it would match `{ State, Fs }` on both counts and
// accept a fn value whose row drops `Fs` entirely.

test "a row instantiated twice does not match a row carrying an extra effect" {
  let src = "effect State[S] {\n  Get() -> S\n}\n\nfn needs_two(f: () -> Int with State[Int] + State[String]) -> Int {\n  f()\n}\n\nfn both() -> Int with State + Fs {\n  42\n}\n\nlet main = () -> Int {\n  needs_two(both)\n}\n"
  let diags = collect_all_diagnostics(src)
  assert(Array::length(diags) > 0)
}
