//# Imports

// #1340 (ADR-0071): generic effect declarations register their operation
// signatures (instantiated per perform/handle site with fresh inference
// vars), `with State[Int]` row items parse, and the interim #1302
// declaration-site warning is retired. These are end-to-end locks through
// collect_all_diagnostics.
import @vibe/compiler/runtime {
  collect_all_diagnostics
}

//# Misc

test "a clean generic effect declaration produces no diagnostics (warning retired)" {
  let src = "effect State[S] {\n  Get() -> S\n}\n\nlet main = () -> Int {\n  42\n}\n"
  let diags = collect_all_diagnostics(src)
  assert(eq(Array::length(diags), 0))
}

test "perform arity against a generic effect op is checked" {
  // The #1218 hole: `perform State::Get(1, 2, 3)` against `Get() -> S`
  // passed silently because generic effects never entered the registry.
  let src = "effect State[S] {\n  Get() -> S;\n  Put(S) -> Unit\n}\n\nlet main = () -> Int with State {\n  perform State::Get(1, 2, 3)\n}\n"
  let diags = collect_all_diagnostics(src)
  assert(eq(Array::length(diags), 1))
  let d = Array::get(diags, 0)
  assert(String::contains(d, "perform State::Get expects 0 argument(s), got 3"))
}

test "a bare perform of a parameterful generic op is an arity error" {
  let src = "effect Box[T] {\n  Put(T) -> Unit\n}\n\nlet main = () -> Int with Box {\n  perform Box::Put\n  42\n}\n"
  let diags = collect_all_diagnostics(src)
  assert(eq(Array::length(diags), 1))
  assert(String::contains(Array::get(diags, 0), "perform Box::Put expects 1 argument(s), got 0"))
}

test "with State[Int] row items parse and check" {
  let src = "effect State[S] {\n  Get() -> S;\n  Put(S) -> Unit\n}\n\nlet read_it = () -> Int with State[Int] {\n  perform State::Get()\n}\n\nlet main = () -> Int {\n  handle {\n    read_it()\n  } with {\n    State::Get => resume(7);\n    State::Put(_v) => resume(())\n  }\n}\n"
  let diags = collect_all_diagnostics(src)
  assert(eq(Array::length(diags), 0))
}

test "a row instantiation of a non-generic effect is rejected" {
  let src = "effect Log {\n  Emit(Int) -> Unit\n}\n\nlet f = () -> Int with Log[Int] {\n  42\n}\n\nlet main = () -> Int {\n  f()\n}\n"
  let diags = collect_all_diagnostics(src)
  assert(eq(Array::length(diags), 1))
  assert(String::contains(Array::get(diags, 0), "effect Log declares no type parameters"))
}

test "a multi-argument row instantiation is rejected at parse" {
  let src = "effect Pair[A, B] {\n  Mk(A, B) -> Unit\n}\n\nlet f = () -> Int with Pair[Int, String] {\n  42\n}\n\nlet main = () -> Int {\n  f()\n}\n"
  let diags = collect_all_diagnostics(src)
  assert(eq(Array::length(diags), 1))
  assert(String::contains(Array::get(diags, 0), "exactly one type argument"))
}

test "handler arm payload arity for a generic effect is checked" {
  let src = "effect Box[T] {\n  Put(T) -> Unit\n}\n\nlet main = () -> Int {\n  handle {\n    perform Box::Put(1)\n    42\n  } with {\n    Box::Put(a, b) => resume(())\n  }\n}\n"
  let diags = collect_all_diagnostics(src)
  assert(eq(Array::length(diags), 1))
  assert(String::contains(Array::get(diags, 0), "payload binding"))
}

test "handler arms share one instantiation per handle" {
  // `Get => resume(0)` pins S = Int; the `Put(v)` payload binder must see
  // the SAME S, so annotating it String is a type error.
  let src = "effect State[S] {\n  Get() -> S;\n  Put(S) -> Unit\n}\n\nlet main = () -> Int {\n  handle {\n    let n = perform State::Get()\n    perform State::Put(n)\n    n\n  } with {\n    State::Get => resume(0);\n    State::Put(v) => {\n      let s: String = v\n      resume(())\n    }\n  }\n}\n"
  let diags = collect_all_diagnostics(src)
  assert(eq(Array::length(diags), 1))
}

// Codex P1 on #1352: the handled BODY must share the handle's instantiation
// with the arms. The two findings in that review turned out to be COUPLED --
// on the merged compiler these cases were caught only because the row-label
// set comparison was too loose (it accepted rows it should have rejected, and
// that spurious acceptance is what linked the body's type variable to the
// arm's). Tightening effect_label_sets_equal alone made the diagnostic below
// vanish, i.e. it turned the reviewer's scenario into a live hole; the fix is
// the explicit per-handle instantiation published through the type env
// (effect_instantiate). These three tests pin both halves.

test "the handled body shares the handle's instantiation with the arms" {
  // The body pins T = String (`let s: String`); `resume(123)` therefore
  // resumes a String-expecting continuation with an Int and must be rejected.
  let src = "effect Box[T] {\n  Get() -> T\n}\n\nlet main = () -> Int {\n  handle {\n    let s: String = perform Box::Get()\n    String::length(s)\n  } with {\n    Box::Get => resume(123)\n  }\n}\n"
  let diags = collect_all_diagnostics(src)
  assert(eq(Array::length(diags), 1))
  assert(String::contains(Array::get(diags, 0), "resume value type mismatch"))
}

test "a body and arm agreeing on the instantiation still type-check" {
  let src = "effect Box[T] {\n  Get() -> T\n}\n\nlet main = () -> Int {\n  handle {\n    let s: String = perform Box::Get()\n    String::length(s)\n  } with {\n    Box::Get => resume(\"abcd\")\n  }\n}\n"
  let diags = collect_all_diagnostics(src)
  assert(eq(Array::length(diags), 0))
}

// Codex P1 on #1354: an arm body runs OUTSIDE the handled computation ("an
// Async handler arm's own body is NOT an async context",
// checker_async_effects_test), so an operation RE-performed inside an arm is
// handled by the ENCLOSING handler, not by the handle that owns the arm. The
// arm env therefore must NOT carry this handle's instantiation.
//
// Below, the inner handle instantiates Box at Int, and its arm re-performs
// Box::Get() at String -- legal precisely because that re-perform belongs to
// the OUTER handle (which resumes with a String). Reusing the inner
// instantiation for arm bodies would make this a conflicting second pin of the
// inner T, i.e. a false rejection of a valid program.
test "a re-perform inside an arm belongs to the OUTER handler" {
  let src = "effect Box[T] {\n  Get() -> T\n}\n\nlet main = () -> Int {\n  handle {\n    handle {\n      let n: Int = perform Box::Get()\n      n\n    } with {\n      Box::Get => {\n        let m: String = perform Box::Get()\n        resume(String::length(m))\n      }\n    }\n  } with {\n    Box::Get => resume(\"s\")\n  }\n}\n"
  let diags = collect_all_diagnostics(src)
  assert(eq(Array::length(diags), 0))
}

test "two performs of one generic effect at conflicting types are rejected" {
  // One handler cannot return both a String and an Int, so the two performs
  // must resolve to the SAME instantiation and collide.
  let src = "effect Box[T] {\n  Get() -> T\n}\n\nlet main = () -> Int {\n  handle {\n    let s: String = perform Box::Get()\n    let n: Int = perform Box::Get()\n    String::length(s) + n\n  } with {\n    Box::Get => resume(\"abcd\")\n  }\n}\n"
  let diags = collect_all_diagnostics(src)
  assert(eq(Array::length(diags), 1))
}

// Codex P1 on #1352: effect_label_list dedupes by EXACT label, which is what
// made "equal length + one-way membership" a sound set-equality test. Base-name
// comparison alone breaks it: `{ State[Int], State[String] }` is two exact
// labels but one base, so it would match `{ State, Fs }` on both counts and
// accept a fn value whose row drops `Fs` entirely.

test "a row instantiated twice does not match a row carrying an extra effect" {
  let src = "effect State[S] {\n  Get() -> S\n}\n\nfn needs_two(f: () -> Int with State[Int] + State[String]) -> Int {\n  f()\n}\n\nfn both() -> Int with State + Fs {\n  42\n}\n\nlet main = () -> Int {\n  needs_two(both)\n}\n"
  let diags = collect_all_diagnostics(src)
  assert(Array::length(diags) > 0)
}

// #3275: a function's own `with Box[Int]` row instantiates the effect for the
// performs in its body. Before, the perform got a fresh `T`, so a `String`
// payload under `with Box[Int]` was accepted and an arm read the pointer as
// an `Int`.

test "a perform payload is checked against the row's type argument" {
  let src = "effect Box[T] {\n  Put(T) -> Int\n}\n\nfn producer() -> Int with Box[Int] {\n  perform Box::Put(\"x\")\n}\n\nlet main = () -> Int {\n  handle {\n    producer()\n  } with {\n    Box::Put(v) => resume(v + 1)\n  }\n}\n"
  let diags = collect_all_diagnostics(src)
  assert(eq(Array::length(diags), 1))
  assert(String::contains(Array::get(diags, 0), "perform argument type mismatch for Box::Put"))
}

test "a perform's value is typed by the row's type argument" {
  let src = "effect St[S] {\n  Get() -> S\n}\n\nfn reader() -> String with St[Int] {\n  perform St::Get()\n}\n\nlet main = () -> Int {\n  42\n}\n"
  let diags = collect_all_diagnostics(src)
  assert(eq(Array::length(diags), 1))
  assert(String::contains(Array::get(diags, 0), "return type mismatch"))
}

test "a payload that agrees with the row's type argument still checks" {
  let src = "effect Box[T] {\n  Put(T) -> Int\n}\n\nfn producer() -> Int with Box[Int] {\n  perform Box::Put(41)\n}\n\nlet main = () -> Int {\n  handle {\n    producer()\n  } with {\n    Box::Put(v) => resume(v + 1)\n  }\n}\n"
  let diags = collect_all_diagnostics(src)
  assert(eq(Array::length(diags), 0))
}

test "a bare generic row label leaves the instantiation open" {
  let src = "effect Box[T] {\n  Put(T) -> Int\n}\n\nfn producer() -> Int with Box {\n  perform Box::Put(\"x\")\n}\n\nlet main = () -> Int {\n  42\n}\n"
  let diags = collect_all_diagnostics(src)
  assert(eq(Array::length(diags), 0))
}

test "a handle inside the function chooses its own instantiation" {
  let src = "effect Box[T] {\n  Put(T) -> Int\n}\n\nfn producer() -> Int with Box[Int] {\n  let n = handle {\n    perform Box::Put(\"x\")\n  } with {\n    Box::Put(s) => resume(String::length(s))\n  }\n  perform Box::Put(n)\n}\n\nlet main = () -> Int {\n  42\n}\n"
  let diags = collect_all_diagnostics(src)
  assert(eq(Array::length(diags), 0))
}

test "a nested lambda with its own bare row is not pinned by the outer row" {
  let src = "effect Box[T] {\n  Put(T) -> Int\n}\n\nfn producer() -> Int with Box[Int] {\n  let f = () -> Int with Box {\n    perform Box::Put(\"x\")\n  }\n  perform Box::Put(1)\n}\n\nlet main = () -> Int {\n  42\n}\n"
  let diags = collect_all_diagnostics(src)
  assert(eq(Array::length(diags), 0))
}

test "a repeated identical row label keeps the instantiation" {
  let src = "effect Box[T] {\n  Put(T) -> Int\n}\n\nfn producer() -> Int with Box[Int] + Box[Int] {\n  perform Box::Put(\"x\")\n}\n\nlet main = () -> Int {\n  42\n}\n"
  let diags = collect_all_diagnostics(src)
  assert(eq(Array::length(diags), 1))
  assert(String::contains(Array::get(diags, 0), "perform argument type mismatch for Box::Put"))
}

test "an unannotated callback lambda is not pinned by the enclosing row" {
  // Codex on #3304: the lambda's performs belong to the callback parameter's
  // `Box[String]` row, which `run_cb` handles, not to `producer`'s `Box[Int]`.
  let src = "effect Box[T] {\n  Put(T) -> Int\n}\n\nfn run_cb(f: () -> Int with Box[String]) -> Int {\n  handle {\n    f()\n  } with {\n    Box::Put(s) => resume(String::length(s))\n  }\n}\n\nfn producer() -> Int with Box[Int] {\n  run_cb(() -> {\n    perform Box::Put(\"x\")\n  }) + perform Box::Put(1)\n}\n\nlet main = () -> Int {\n  42\n}\n"
  let diags = collect_all_diagnostics(src)
  assert(eq(Array::length(diags), 0))
}

// #3275 follow-up (Codex on #3315): a kinded effect parameter (`F` of
// `Read[F[_]]`) takes a bare constructor in the row. It was resolved as a
// complete type, so `F[Int]` matched no payload: a correct `Array[Int]` under
// `with Read[Array]` was refused (`expected Array[Int], got Array[Int]`), and a
// `Cell[String]` under `with Read[Cell]` was accepted.

test "a kinded row's constructor fixes the payload" {
  let src = "effect Read[F[_]] {\n  Put(F[Int]) -> Int\n}\n\nfn producer() -> Int with Read[Array] {\n  perform Read::Put(Some(1))\n}\n"
  let diags = collect_all_diagnostics(src)
  assert(eq(Array::length(diags), 1))
  assert(String::contains(Array::get(diags, 0), "perform argument type mismatch for Read::Put: expected Array[Int], got Option[Int]"))
}

test "a kinded row accepts a payload and a value of its constructor" {
  let put_src = "effect Read[F[_]] {\n  Put(F[Int]) -> Int\n}\n\nfn producer() -> Int with Read[Array] {\n  perform Read::Put([1, 2])\n}\n"
  assert(eq(Array::length(collect_all_diagnostics(put_src)), 0))
  let option_src = "effect Read[F[_]] {\n  Put(F[Int]) -> Int\n}\n\nfn producer() -> Int with Read[Option] {\n  perform Read::Put(Some(1))\n}\n"
  assert(eq(Array::length(collect_all_diagnostics(option_src)), 0))
  let get_src = "effect Src[F[_]] {\n  Get() -> F[Int]\n}\n\nfn reader() -> Int with Src[Array] {\n  let xs: Array[Int] = perform Src::Get()\n  Array::length(xs)\n}\n"
  assert(eq(Array::length(collect_all_diagnostics(get_src)), 0))
}

test "a kinded row passes a declared generic type as its constructor" {
  let src = "effect Read[F[_]] {\n  Put(F[Int]) -> Int\n}\n\nstruct Cell[T] {\n  value: T\n}\n\nfn producer() -> Int with Read[Cell] {\n  perform Read::Put(Cell::{ value: \"s\" })\n}\n"
  let diags = collect_all_diagnostics(src)
  assert(eq(Array::length(diags), 1))
  assert(String::contains(Array::get(diags, 0), "perform argument type mismatch for Read::Put: expected Cell[Int], got Cell[String]"))
  let ok_src = "effect Read[F[_]] {\n  Put(F[Int]) -> Int\n}\n\nstruct Cell[T] {\n  value: T\n}\n\nfn producer() -> Int with Read[Cell] {\n  perform Read::Put(Cell::{ value: 1 })\n}\n"
  assert(eq(Array::length(collect_all_diagnostics(ok_src)), 0))
}

test "a kinded row passes a parameterized alias as its constructor" {
  let src = "effect Read[F[_]] {\n  Put(F[Int]) -> Int\n}\n\ntype List[T] = Array[T]\n\nfn producer() -> Int with Read[List] {\n  perform Read::Put(Some(1))\n}\n"
  let diags = collect_all_diagnostics(src)
  assert(eq(Array::length(diags), 1))
  assert(String::contains(Array::get(diags, 0), "expected Array[Int], got Option[Int]"))
  let ok_src = "effect Read[F[_]] {\n  Put(F[Int]) -> Int\n}\n\ntype List[T] = Array[T]\n\nfn producer() -> Int with Read[List] {\n  perform Read::Put([1])\n}\n"
  assert(eq(Array::length(collect_all_diagnostics(ok_src)), 0))
}

// A wrong-kinded row argument is reported once, with the edit, wherever the
// row is written: the checker reports it while binding the row, because the
// later row-item check does not run once type checking has found an error and
// does not walk a lambda nested in a body. The parameter is then left fresh,
// so the perform adds no second, derived mismatch.
test "a wrong-kinded row argument is reported once" {
  let int_src = "effect Read[F[_]] {\n  Put(F[Int]) -> Int\n}\n\nfn producer() -> Int with Read[Int] {\n  perform Read::Put([1])\n}\n"
  let int_diags = collect_all_diagnostics(int_src)
  assert(eq(Array::length(int_diags), 1))
  assert(String::contains(Array::get(int_diags, 0), "effect Read expects a constructor with 1 argument(s), but `Int` has 0"))
  let map_src = "effect Read[F[_]] {\n  Put(F[Int]) -> Int\n}\n\nfn producer() -> Int with Read[Map] {\n  perform Read::Put([1])\n}\n"
  let map_diags = collect_all_diagnostics(map_src)
  assert(eq(Array::length(map_diags), 1))
  assert(String::contains(Array::get(map_diags, 0), "but `Map` has 2"))
}

// Codex on #3315: `struct Higher[G[_]]` has the arity `Read[F[_]]` asks for,
// but its parameter is a constructor, so it cannot stand for `F` (applied to
// `Int` in `F[Int]`). Comparing arities alone reported nothing, and the first
// cut of the kinded arm left `F` fresh, so `Some(1)` checked clean.
test "a constructor whose parameter is a constructor is not a kinded row argument" {
  let src = "effect Read[F[_]] {\n  Put(F[Int]) -> Int\n}\n\nstruct Higher[G[_]] {\n  v: G[Int]\n}\n\nfn producer() -> Int with Read[Higher] {\n  perform Read::Put(Some(1))\n}\n"
  let diags = collect_all_diagnostics(src)
  assert(eq(Array::length(diags), 1))
  assert(String::contains(Array::get(diags, 0), "effect Read applies its parameter to types, but a parameter of `Higher` takes a constructor"))
  let bare_src = "effect Read[F[_]] {\n  Put(F[Int]) -> Int\n}\n\nstruct Higher[G[_]] {\n  v: G[Int]\n}\n\nfn producer() -> Int with Read[Higher] {\n  0\n}\n"
  let bare_diags = collect_all_diagnostics(bare_src)
  assert(eq(Array::length(bare_diags), 1))
  assert(String::contains(Array::get(bare_diags, 0), "a parameter of `Higher` takes a constructor"))
}

// The row-item check walks a function's own row, not a lambda nested in its
// body; the row binder reports a wrong-kinded row there too.
test "a wrong-kinded row on a nested lambda is reported" {
  let nested = (row: String) -> Array[String] {
    collect_all_diagnostics(String::concat("effect Read[F[_]] {\n  Put(F[Int]) -> Int\n}\n\nstruct Higher[G[_]] {\n  v: G[Int]\n}\n\nfn outer() -> Int {\n  let inner = () -> Int with ", String::concat(row, " {\n    perform Read::Put(Some(1))\n  }\n  0\n}\n")))
  }
  let int_diags = nested("Read[Int]")
  assert(eq(Array::length(int_diags), 1))
  assert(String::contains(Array::get(int_diags, 0), "but `Int` has 0"))
  let nope_diags = nested("Read[Nope]")
  assert(eq(Array::length(nope_diags), 1))
  assert(String::contains(Array::get(nope_diags, 0), "but `Nope` has 0"))
  let higher_diags = nested("Read[Higher]")
  assert(eq(Array::length(higher_diags), 1))
  assert(String::contains(Array::get(higher_diags, 0), "a parameter of `Higher` takes a constructor"))
  assert(eq(Array::length(nested("Read[Option]")), 0))
}

// Codex on #3315: a formal in scope is bound as itself only when its declared
// arity is the parameter's; otherwise it is reported like any other
// wrong-kinded argument, including on a nested lambda the row-item check
// never walks.
test "a formal of the wrong kind in a kinded row is reported" {
  let decl = "effect Read[F[_]] {\n  Put(F[Int]) -> Int\n}\n\n"
  let plain_nested = collect_all_diagnostics(String::concat(decl, "fn outer[T](x: T) -> Int {\n  let f = () -> Int with Read[T] {\n    0\n  }\n  0\n}\n"))
  assert(eq(Array::length(plain_nested), 1))
  assert(String::contains(Array::get(plain_nested, 0), "effect Read expects a constructor with 1 argument(s), but `T` has 0"))
  let binary_nested = collect_all_diagnostics(String::concat(decl, "fn outer[H[_, _]](x: H[Int, Int]) -> Int {\n  let f = () -> Int with Read[H] {\n    0\n  }\n  0\n}\n"))
  assert(eq(Array::length(binary_nested), 1))
  assert(String::contains(Array::get(binary_nested, 0), "but `H` has 2"))
  let own_plain = collect_all_diagnostics(String::concat(decl, "fn producer[A](x: A) -> Int with Read[A] {\n  0\n}\n"))
  assert(eq(Array::length(own_plain), 1))
  assert(String::contains(Array::get(own_plain, 0), "but `A` has 0"))
}

// Codex on #3315: a constructor formal in the row binds to the formal, so the
// payload is the parameter's own `G[Int]`. Left fresh, `Some(1)` checked clean
// and a caller passing an `Array[Int]` handed the option to a `Read[Array]` arm.
test "a kinded formal in the row fixes the payload at the formal" {
  let src = "effect Read[F[_]] {\n  Put(F[Int]) -> Int\n}\n\nfn producer[G[_]](xs: G[Int]) -> Int with Read[G] {\n  perform Read::Put(xs)\n}\n"
  assert(eq(Array::length(collect_all_diagnostics(src)), 0))
  let bad_src = "effect Read[F[_]] {\n  Put(F[Int]) -> Int\n}\n\nfn producer[G[_]](xs: G[Int]) -> Int with Read[G] {\n  perform Read::Put(Some(1))\n}\n"
  let diags = collect_all_diagnostics(bad_src)
  assert(eq(Array::length(diags), 1))
  assert(String::contains(Array::get(diags, 0), "perform argument type mismatch for Read::Put: expected G[Int], got Option[Int]"))
  let lambda_src = "effect Read[F[_]] {\n  Put(F[Int]) -> Int\n}\n\nfn outer[G[_]](xs: G[Int]) -> Int {\n  let inner = () -> Int with Read[G] {\n    perform Read::Put(Some(1))\n  }\n  0\n}\n"
  let lambda_diags = collect_all_diagnostics(lambda_src)
  assert(eq(Array::length(lambda_diags), 1))
  assert(String::contains(Array::get(lambda_diags, 0), "expected G[Int], got Option[Int]"))
}

// #3311: a lambda passed to a parameter whose function type has a row
// (`f: () -> Int with Box[String]`) performs at that row's instantiation.
// Before, it was checked with no expectation, its perform got a fresh `T`, and
// `run_cb`'s arm read the `Int` payload as a `String`.
let callback_decls = "effect Box[T] {\n  Put(T) -> Int\n}\n\nfn run_cb(f: () -> Int with Box[String]) -> Int {\n  handle {\n    f()\n  } with {\n    Box::Put(s) => resume(String::length(s))\n  }\n}\n\nfn run2[T: Eq](x: T, f: () -> Int with Box[T]) -> Int {\n  handle {\n    f()\n  } with {\n    Box::Put(v) => resume(if v == x {\n      1\n    } else {\n      0\n    })\n  }\n}\n\nfn run3[T](f: () -> Int with Box[T]) -> Int {\n  handle {\n    f()\n  } with {\n    Box::Put(_) => resume(0)\n  }\n}\n\n"

test "a callback lambda performs at its parameter row's instantiation" {
  let diags = collect_all_diagnostics(String::concat(callback_decls, "fn producer() -> Int with Box {\n  run_cb(() -> {\n    perform Box::Put(1)\n  })\n}\n"))
  assert(eq(Array::length(diags), 1))
  assert(String::contains(Array::get(diags, 0), "perform argument type mismatch for Box::Put: expected String, got Int"))
  let ok = collect_all_diagnostics(String::concat(callback_decls, "fn producer() -> Int with Box {\n  run_cb(() -> {\n    perform Box::Put(\"x\")\n  })\n}\n"))
  assert(eq(Array::length(ok), 0))
}

// The row is the callee's: a formal it names is the type this call gives it,
// never a formal of the caller spelled the same, and the arguments to the
// lambda's left fix it before the lambda is checked.
test "a callback row naming the callee's formal takes this call's type" {
  let bad = collect_all_diagnostics(String::concat(callback_decls, "fn producer[T](y: T) -> Int with Box {\n  run2(\"s\", () -> {\n    perform Box::Put(1)\n  })\n}\n"))
  assert(eq(Array::length(bad), 1))
  assert(String::contains(Array::get(bad, 0), "perform argument type mismatch for Box::Put: expected String, got Int"))
  let ok = collect_all_diagnostics(String::concat(callback_decls, "fn producer[T](y: T) -> Int with Box {\n  run2(\"s\", () -> {\n    perform Box::Put(\"t\")\n  }) + run2(5, () -> {\n    perform Box::Put(6)\n  })\n}\n"))
  assert(eq(Array::length(ok), 0))
}

// A formal only the callback row names is not fixed by the call, so the
// lambda's perform is left open, as before.
test "a callback row formal the call does not fix leaves the perform open" {
  let src = String::concat(callback_decls, "fn producer() -> Int with Box {\n  run3(() -> {\n    perform Box::Put(1)\n  }) + run3(() -> {\n    perform Box::Put(\"x\")\n  })\n}\n")
  assert(eq(Array::length(collect_all_diagnostics(src)), 0))
}

// A bare callback row (`with Box`) hands the lambda nothing: it keeps the
// enclosing handle's instantiation, which a forwarding callee passes the
// perform to. A fresh instantiation would have accepted the `String`.
test "a bare callback row keeps the enclosing handle's instantiation" {
  let src = "effect Box[T] {\n  Put(T) -> Int\n}\n\nfn pass(f: () -> Int with Box) -> Int with Box {\n  f()\n}\n\nfn main_like() -> Int {\n  handle {\n    pass(() -> {\n      perform Box::Put(\"x\")\n    })\n  } with {\n    Box::Put(n) => resume(n + 1)\n  }\n}\n"
  assert(Array::length(collect_all_diagnostics(src)) > 0)
}

// #3319: a generic effect's type argument in a row is a type name, checked
// like one in an annotation, wherever the row is written.
test "an unknown type in a generic effect's row argument is reported" {
  let decl = "effect Box[T] {\n  Put(T) -> Int\n}\n\n"
  let own = collect_all_diagnostics(String::concat(decl, "fn f() -> Int with Box[Nope] {\n  perform Box::Put(1)\n}\n"))
  assert(eq(Array::length(own), 1))
  assert(String::contains(Array::get(own, 0), "unknown type `Nope` in the effect row item `Box[Nope]`"))
  let nested = collect_all_diagnostics(String::concat(decl, "fn f() -> Int {\n  let g = () -> Int with Box[Array[Nope]] {\n    0\n  }\n  0\n}\n"))
  assert(eq(Array::length(nested), 1))
  assert(String::contains(Array::get(nested, 0), "unknown type `Nope`"))
  let annotated = collect_all_diagnostics(String::concat(decl, "fn run(f: () -> Int with Box[Nope]) -> Int {\n  0\n}\n"))
  assert(eq(Array::length(annotated), 1))
  assert(String::contains(Array::get(annotated, 0), "unknown type `Nope`"))
  let known = collect_all_diagnostics(String::concat(decl, "struct P {\n  x: Int\n}\n\nfn f[T](x: T) -> Int with Box[T] {\n  let g = () -> Int with Box[T] {\n    0\n  }\n  perform Box::Put(x)\n}\n\nfn h(f: () -> Int with Box[Option[P]]) -> Int with Box[Array[Int]] {\n  0\n}\n"))
  assert(eq(Array::length(known), 0))
}

test "a row formal the body fixes is refused at the declaration" {
  // #3318: `perform Box::Put(1)` fixed `T := Int` while the row kept
  // `Box[T]`, so a caller's handler chose `T` and read the `Int` as its own.
  let src = "effect Box[T] {\n  Put(T) -> Int\n}\n\nfn f[T]() -> Int with Box[T] {\n  perform Box::Put(1)\n}\n"
  let diags = collect_all_diagnostics(src)
  assert(eq(Array::length(diags), 1))
  assert(String::contains(Array::get(diags, 0), "write `Int` in place of the type parameter `T`"))
}

test "a row formal fixed to another formal is refused" {
  let src = "effect Box[T] {\n  Put(T) -> Int\n}\n\nfn f[A, B](b: B) -> Int with Box[A] {\n  perform Box::Put(b)\n}\n"
  let diags = collect_all_diagnostics(src)
  assert(eq(Array::length(diags), 1))
  assert(String::contains(Array::get(diags, 0), "write `B` in place of the type parameter `A`"))
}

test "a row formal the body keeps generic is accepted" {
  let src = "effect Box[T] {\n  Put(T) -> Int\n}\n\nfn put_any[T](x: T) -> Int with Box[T] {\n  perform Box::Put(x)\n}\n\nfn silent[T]() -> Int with Box[T] {\n  0\n}\n"
  let diags = collect_all_diagnostics(src)
  assert(eq(Array::length(diags), 0))
}
