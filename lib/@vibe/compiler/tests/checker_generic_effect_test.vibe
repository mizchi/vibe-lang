//# Imports

// #1340 (ADR-0071): generic effect declarations register their operation
// signatures (instantiated per perform/handle site with fresh inference
// vars), `with { State[Int] }` row items parse, and the interim #1302
// declaration-site warning is retired. These are end-to-end locks through
// collect_all_diagnostics.
import @vibe/compiler/runtime {
  collect_all_diagnostics
}

//# Misc

test "a clean generic effect declaration produces no diagnostics (warning retired)" {
  let src = "effect State[S] {\n  Get() -> S\n}\n\nlet main = () -> Int {\n  42\n}\n"
  let diags = collect_all_diagnostics(src)
  assert(eq(Array::length(diags), 0))
}

test "perform arity against a generic effect op is checked" {
  // The #1218 hole: `perform State::Get(1, 2, 3)` against `Get() -> S`
  // passed silently because generic effects never entered the registry.
  let src = "effect State[S] {\n  Get() -> S;\n  Put(S) -> Unit\n}\n\nlet main = () -> Int with { State } {\n  perform State::Get(1, 2, 3)\n}\n"
  let diags = collect_all_diagnostics(src)
  assert(eq(Array::length(diags), 1))
  let d = Array::get(diags, 0)
  assert(String::contains(d, "perform State::Get expects 0 argument(s), got 3"))
}

test "a bare perform of a parameterful generic op is an arity error" {
  let src = "effect Box[T] {\n  Put(T) -> Unit\n}\n\nlet main = () -> Int with { Box } {\n  perform Box::Put\n  42\n}\n"
  let diags = collect_all_diagnostics(src)
  assert(eq(Array::length(diags), 1))
  assert(String::contains(Array::get(diags, 0), "perform Box::Put expects 1 argument(s), got 0"))
}

test "with { State[Int] } row items parse and check" {
  let src = "effect State[S] {\n  Get() -> S;\n  Put(S) -> Unit\n}\n\nlet read_it = () -> Int with { State[Int] } {\n  perform State::Get()\n}\n\nlet main = () -> Int {\n  handle {\n    read_it()\n  } with State {\n    Get => resume(7);\n    Put(_v) => resume(())\n  }\n}\n"
  let diags = collect_all_diagnostics(src)
  assert(eq(Array::length(diags), 0))
}

test "a row instantiation of a non-generic effect is rejected" {
  let src = "effect Log {\n  Emit(Int) -> Unit\n}\n\nlet f = () -> Int with { Log[Int] } {\n  42\n}\n\nlet main = () -> Int {\n  f()\n}\n"
  let diags = collect_all_diagnostics(src)
  assert(eq(Array::length(diags), 1))
  assert(String::contains(Array::get(diags, 0), "effect Log declares no type parameters"))
}

test "a multi-argument row instantiation is rejected at parse" {
  let src = "effect Pair[A, B] {\n  Mk(A, B) -> Unit\n}\n\nlet f = () -> Int with { Pair[Int, String] } {\n  42\n}\n\nlet main = () -> Int {\n  f()\n}\n"
  let diags = collect_all_diagnostics(src)
  assert(eq(Array::length(diags), 1))
  assert(String::contains(Array::get(diags, 0), "exactly one type argument"))
}

test "handler arm payload arity for a generic effect is checked" {
  let src = "effect Box[T] {\n  Put(T) -> Unit\n}\n\nlet main = () -> Int {\n  handle {\n    perform Box::Put(1)\n    42\n  } with Box {\n    Put(a, b) => resume(())\n  }\n}\n"
  let diags = collect_all_diagnostics(src)
  assert(eq(Array::length(diags), 1))
  assert(String::contains(Array::get(diags, 0), "payload binding"))
}

test "handler arms share one instantiation per handle" {
  // `Get => resume(0)` pins S = Int; the `Put(v)` payload binder must see
  // the SAME S, so annotating it String is a type error.
  let src = "effect State[S] {\n  Get() -> S;\n  Put(S) -> Unit\n}\n\nlet main = () -> Int {\n  handle {\n    let n = perform State::Get()\n    perform State::Put(n)\n    n\n  } with State {\n    Get => resume(0);\n    Put(v) => {\n      let s: String = v\n      resume(())\n    }\n  }\n}\n"
  let diags = collect_all_diagnostics(src)
  assert(eq(Array::length(diags), 1))
}
