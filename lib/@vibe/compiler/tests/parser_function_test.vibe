//# Imports

import ./parser_test_support.vibe {
  parse_print
}

//# Misc

test "parse fn" {
  let result = handle {
    parse_print("(x) -> x")
  } with { Exception::Throw(e) => String::concat("ERROR: ", e) }
  assert(result == "(x) -> { x }")
}

test "parse fn with type" {
  let result = handle {
    parse_print("(x: Int) -> x")
  } with { Exception::Throw(e) => String::concat("ERROR: ", e) }
  assert(result == "(x: Int) -> { x }")
}
