// #1967: pin that stale symbol@fixture / version@fixture import syntax
// is rejected. Value claims from the old fixtures live below via a
// current path import of fixtures/modules/ref_lib_export.vibe.

//# Imports

import ./checker_parity_test_support.vibe {
  check_source_error_message
}

import ../../../../fixtures/modules/ref_lib_export.vibe {
  add, value
}

//# Misc

test "stale symbol@fixture import is rejected" {
  let source = "import symbol@fixture/std/math {  value, add  }\nadd(value, 2)"
  let msg = check_source_error_message(source)
  assert(String::contains(msg, "not a valid import spec"))
  assert(String::contains(msg, "import @scope/pkg"))
}

test "stale version@fixture import is rejected" {
  let source = "import version@fixture/main {  value, add  }\nadd(value, 1)"
  let msg = check_source_error_message(source)
  assert(String::contains(msg, "not a valid import spec"))
}

test "#2127 leftover: two imports binding the same name still last-win" {
  let source = "import @vibe/builtin { abs }\nimport @vibe/builtin { clamp as abs }\nabs(-1)\n"
  assert(!String::contains(check_source_error_message(source), "duplicate declaration: abs"))
}

test "#2127 leftover: an import and a local fn of the same name are not a duplicate" {
  let source = "import @vibe/core { array_empty }\nfn array_empty() -> Int { 0 }\n"
  assert(!String::contains(check_source_error_message(source), "duplicate declaration: array_empty"))
}

test "current import of ref_lib_export keeps add(value, 2) as 9" {
  inspect(add(value, 2), "9")
}

test "current import of ref_lib_export keeps add(value, 1) as 8" {
  inspect(add(value, 1), "8")
}
