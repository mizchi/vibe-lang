//# Imports

import ./printer_test_support.vibe {
  roundtrip
}

//# Misc

test "roundtrip int" {
  let ok = handle {
    roundtrip("42")
  } with { Exception::Throw(_) => false }
  assert(ok)
}

test "roundtrip string" {
  let ok = handle {
    roundtrip("\"hello\"")
  } with { Exception::Throw(_) => false }
  assert(ok)
}

test "roundtrip bool" {
  let ok = handle {
    roundtrip("true")
  } with { Exception::Throw(_) => false }
  assert(ok)
}

test "roundtrip ident" {
  let ok = handle {
    roundtrip("foo")
  } with { Exception::Throw(_) => false }
  assert(ok)
}

test "roundtrip unary" {
  let ok = handle {
    roundtrip("-1")
  } with { Exception::Throw(_) => false }
  assert(ok)
}
