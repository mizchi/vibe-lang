//# Imports

// #986: labeled-argument call checking. Labeled args (`f(x=1)`) used to fall
// through check_expr's `_` wildcard arm and type as CtUnknown, so a labeled
// call bypassed argument type checking entirely AND accepted nonexistent
// label names. Positional binding is codegen's rule (after the
// desugar_labeled_args reorder of fully-labeled calls), so the checker now
// (a) types each labeled arg as its value and unifies positionally, and
// (b) rejects unknown / out-of-declared-order label names for calls to
// top-level let-bound functions.

import ./checker_parity_test_support.vibe {
  check_source_err, check_source_err_contains, check_source_ok
}

//# Misc

/// ADR-0120 D2: a callback written ahead of the value it is declared after is
/// out of declared order, and refused with the move.
test "a callback written ahead of its declared preceding value is refused" {
  assert(check_source_err_contains(source = "fn apply[T](value: T, body: (T) -> T) -> T { body(value) }\nfn main() -> String { apply(body = (s) -> s + s, value = \"a\") }", needle = "labeled argument `value` for apply is out of declared parameter order: move `value = ..` before `body = ..`"))
}

/// A callback written in declared order is still checked after the value
/// arguments that follow it, which can fix the type it shares with them: the
/// push makes `T` a String, so `s + s` concatenates. Checking the callback
/// first left `T` free and `+` defaulted it to Int, rejecting the call.
test "a declared-order callback is checked after the value arguments after it" {
  assert(check_source_ok("fn apply[T](xs: Array[T], body: (T) -> T, done: Unit) -> Unit { () }\nfn main() -> Unit {\n  let xs = []\n  apply(xs = xs, body = (s) -> s + s, done = Array::push(xs, value = \"a\"))\n}"))
}

/// Issue #986 repro: both argument types reversed — must be rejected.
test "labeled args: fully reversed types rejected" {
  assert(check_source_err("fn f(x: Int, y: String) -> Int {\n  x\n}\n\nfn main() -> Int {\n  f(x=\"hello\", y=5)\n}"))
}

/// Only one of the labeled args has the wrong type — must be rejected.
test "labeled args: single wrong type rejected" {
  assert(check_source_err("fn f(x: Int, y: String) -> Int {\n  x\n}\n\nfn main() -> Int {\n  f(x=1, y=5)\n}"))
}

/// Correct labeled call (declared labeled params, declared order) — accepted.
test "labeled args: correct labeled call accepted" {
  assert(check_source_ok("let add: (Int, Int) -> Int = (x, y) -> { x + y }\nfn main() -> Int {\n  add(x=1, y=2)\n}"))
}

/// Correct labeled call against a plain `fn` declaration — accepted.
test "labeled args: labeled call on plain fn accepted" {
  assert(check_source_ok("fn f(x: Int, y: String) -> Int {\n  x\n}\n\nfn main() -> Int {\n  f(x=1, y=\"ok\")\n}"))
}

/// Positional calls are unaffected: correct one accepted...
test "labeled args: positional call unaffected ok" {
  assert(check_source_ok("fn f(x: Int, y: String) -> Int {\n  x\n}\n\nfn main() -> Int {\n  f(1, \"ok\")\n}"))
}

/// ...and a positional type mismatch still rejected.
test "labeled args: positional mismatch still rejected" {
  assert(check_source_err("fn f(x: Int, y: String) -> Int {\n  x\n}\n\nfn main() -> Int {\n  f(\"hello\", 5)\n}"))
}

/// Nonexistent label names — rejected even when the value types line up.
test "labeled args: unknown label names rejected" {
  assert(check_source_err("fn f(x: Int, y: Int) -> Int {\n  x\n}\n\nfn main() -> Int {\n  f(nosuch=1, alsono=2)\n}"))
}

/// ADR-0120 D2: a fully-labeled call out of declared order is refused with the
/// move; it used to be placed by name.
test "labeled args: reordered labeled call refused" {
  assert(check_source_err_contains(source = "let add: (Int, Int) -> Int = (x, y) -> { x + y }\nfn main() -> Int {\n  add(y=2, x=1)\n}", needle = "labeled argument `x` for add is out of declared parameter order: move `x = ..` before `y = ..` (add declares x, y)"))
}

/// The reorder is name-based, so a type error must follow the LABEL, not the
/// call position: y=\"s\" against y: Int is rejected even written first.
test "labeled args: reordered labeled call type mismatch rejected" {
  assert(check_source_err("let add: (Int, String) -> Int = (x, y) -> { x }\nfn main() -> Int {\n  add(y=1, x=2)\n}"))
}

/// ...on a plain `fn` as well (#986 follow-up).
test "labeled args: reordered labels on plain fn refused" {
  assert(check_source_err_contains(source = "fn f(x: Int, y: Int) -> Int {\n  x\n}\n\nfn main() -> Int {\n  f(y=1, x=2)\n}", needle = "out of declared parameter order"))
}

/// Types follow the LABEL: `f(x=1, y=\"s\")` against (x: Int, y: String) is
/// fine...
test "labeled args: labels on plain fn follow label types" {
  assert(check_source_ok("fn f(x: Int, y: String) -> Int {\n  x\n}\n\nfn main() -> Int {\n  f(x=1, y=\"s\")\n}"))
}

/// ...and f(y=5, x=\"hello\") is rejected (both labels name the wrong type).
test "labeled args: reordered labels on plain fn type mismatch rejected" {
  assert(check_source_err("fn f(x: Int, y: String) -> Int {\n  x\n}\n\nfn main() -> Int {\n  f(y=5, x=\"hello\")\n}"))
}

/// A PARTIALLY labeled call is never reordered (positional binding), so an
/// out-of-position label would silently swap — rejected.
test "labeled args: partial out-of-order label rejected" {
  assert(check_source_err("fn f(x: Int, y: Int) -> Int {\n  x\n}\n\nfn main() -> Int {\n  f(y=1, 2)\n}"))
}

/// Codex P2-2 on #993: a LOCAL binding shadowing a top-level fn name must
/// suppress the top-level label table: `f(1)` here calls the local closure,
/// a value, so the top-level `f(x: Int)` labels don't apply. A label on it is
/// refused, as on any call through a value (ADR-0120 Phase 4b).
test "labeled args: local shadow of top-level fn is called positionally" {
  assert(check_source_ok("fn f(x: Int) -> Int {\n  x\n}\n\nfn main() -> Int {\n  let f = (y: Int) -> Int { y + 41 }\n  f(1)\n}"))
  assert(check_source_err_contains(source = "fn f(x: Int) -> Int {\n  x\n}\n\nfn main() -> Int {\n  let f = (y: Int) -> Int { y + 41 }\n  f(y=1)\n}", needle = "a call through the function value `f` passes its arguments by position: remove `y = `"))
}

/// Codex P2-1 on #993: a call through a fn-typed parameter has no parameter
/// NAMES to place labels by -- a function type carries none (ADR-0120 D1).
/// Tolerating the labels used to bind the arguments in written order, which
/// is wrong whenever they were reordered; the call is refused instead
/// (ADR-0120 Phase 4b).
test "labeled args: a call through a fn-typed parameter refuses its labels" {
  assert(check_source_err_contains(source = "fn call_it(g: (Int, String) -> Int) -> Int {\n  g(y=\"ok\", x=1)\n}\n\nfn main() -> Int {\n  call_it(g = (x: Int, y: String) -> Int { x })\n}", needle = "a call through the function value `g` passes its arguments by position: remove `y = `, `x = `"))
  assert(check_source_ok("fn call_it(g: (Int, String) -> Int) -> Int {\n  g(1, \"ok\")\n}\n\nfn main() -> Int {\n  call_it(g = (x: Int, y: String) -> Int { x })\n}"))
}

/// #1001 repro: mixing a labeled and a positional argument in the SAME call is
/// rejected UNCONDITIONALLY (the Oracle's `resolveArguments` rule), even
/// though the label (`x=1`) happens to already sit at its own declared
/// position — `desugar_labeled_args`'s `strip_in_position_labels` used to
/// silently unwrap exactly that label (treating it as a harmless "decorative"
/// label on an otherwise-positional call), turning this into the ordinary
/// positional `f(1, "ok")` before the checker or any post-desugar validation
/// pass ever saw the mix. `check_mixed_argument_modes` (checker_stmt.vibe) now
/// runs BEFORE that stripping, on the call's original argument list.
test "1001 repro: mixed positional/labeled arguments rejected even when the label is in position" {
  assert(check_source_err("let f: (Int, String) -> Int = (x, y) -> { x }\nfn main() -> Int { f(x=1, \"ok\") }"))
}

/// Same shape, but the SECOND argument carries the label instead — still a
/// mix, still rejected regardless of which position the label sits at.
test "1001: mixed positional/labeled arguments rejected (label on the second argument)" {
  assert(check_source_err("let f: (Int, String) -> Int = (x, y) -> { x }\nfn main() -> Int { f(1, y=\"ok\") }"))
}

/// A fully-labeled call in a DIFFERENT declared order is not a mix (regression
/// guard for the #1001 fix): it is refused for its order, not for mixing.
test "1001: fully-labeled out-of-order call is not a mix" {
  assert(check_source_err_contains(source = "let f: (Int, String) -> Int = (x, y) -> { x }\nfn main() -> Int { f(y=\"ok\", x=1) }", needle = "out of declared parameter order"))
  assert(!check_source_err_contains(source = "let f: (Int, String) -> Int = (x, y) -> { x }\nfn main() -> Int { f(y=\"ok\", x=1) }", needle = "mixes"))
}

/// A fully-positional call is not a mix either — stays accepted.
test "1001: fully-positional call is not a mix, stays accepted" {
  assert(check_source_ok("let f: (Int, String) -> Int = (x, y) -> { x }\nfn main() -> Int { f(1, \"ok\") }"))
}

/// #1001 Codex review (PR #1008): a call to a LOCAL closure (never a
/// top-level `let`-bound fn, so it was never in `collect_labeled_check_fns`'s
/// table) must be checked for mixed argument modes too — gating the check on
/// tbl-membership + not-shadowed (the same lookup the position/unknown-label
/// checks need) let this bypass entirely, since `labeled_walk_shadowed`
/// returns true for ANY local binding, table-colliding or not.
test "1001: mixed positional/labeled arguments on a LOCAL closure rejected" {
  assert(check_source_err("fn main() -> Int {\n  let f = (x: Int, y: String) -> Int { x }\n  f(x=1, \"ok\")\n}"))
}

/// An omitted defaulted slot between written ones is filled, and each written
/// label lands in its own slot: `f(a = 5, c = 6)` binds `a = 5, c = 6`.
test "labeled args: an omitted default between written labels accepted" {
  assert(check_source_ok("fn f(a: Int = 1, b: Int = 2, c: Int = 3) -> Int {\n  a + b + c\n}\n\nfn main() -> Int {\n  f(a = 5, c = 6)\n}"))
  assert(check_source_err_contains(source = "fn f(a: Int = 1, b: Int = 2, c: Int = 3) -> Int {\n  a + b + c\n}\n\nfn main() -> Int {\n  f(b = 4, a = 5)\n}", needle = "out of declared parameter order"))
}

/// A label may skip an omitted optional in the middle.
test "labeled args: a label skipping an omitted optional accepted" {
  assert(check_source_ok("fn g(a?: Int, b?: Int, c?: Int) -> Int {\n  0\n}\n\nfn main() -> Int {\n  g(a = 5, c = 6)\n}"))
}

/// An omitted parameter that is NOT optional cannot be filled: the label
/// survives and the order check refuses the call rather than binding it to
/// the first slot.
test "labeled args: a label past an omitted required parameter rejected" {
  assert(check_source_err("fn h(a: Int, b?: Int) -> Int {\n  a\n}\n\nfn main() -> Int {\n  h(b = 4)\n}"))
}

/// In declared order, an omitted trailing default is still fine.
test "labeled args: in-order labels with an omitted default accepted" {
  assert(check_source_ok("fn f(a: Int = 1, b: Int = 2, c: Int = 3) -> Int {\n  a + b + c\n}\n\nfn main() -> Int {\n  f(a = 5, b = 4)\n}"))
}

/// Fully labeled and complete, in declared order.
test "labeled args: labels with every default supplied accepted" {
  assert(check_source_ok("fn f(a: Int = 1, b: Int = 2, c: Int = 3) -> Int {\n  a + b + c\n}\n\nfn main() -> Int {\n  f(a = 5, b = 4, c = 6)\n}"))
}

/// #3651: a builtin has no parameter names, so a labeled builtin call bound
/// its arguments in written order and `b = "a", a = "b"` answered "ab". The
/// label is refused, and the message names the edit.
test "3651: swapped labels on a builtin rejected" {
  assert(check_source_err_contains(source = "fn main() -> String {\n  String::concat(b = \"a\", a = \"b\")\n}", needle = "argument 1 of builtin `String::concat` is positional: remove `b = `"))
}

/// A label that names no parameter at all used to be accepted and ignored.
test "3651: unknown labels on a builtin rejected" {
  assert(check_source_err_contains(source = "fn main() -> String {\n  String::concat(zzz = \"a\", qqq = \"b\")\n}", needle = "remove `zzz = `"))
}

/// A label that names no parameter of the builtin is refused, and the
/// message lists the labels it has.
test "3651: one labeled builtin argument rejected" {
  assert(check_source_err_contains(source = "fn main() -> Int {\n  let xs: Array[Int] = []\n  Array::push(xs, val = 1)\n  Array::length(xs)\n}", needle = "builtin `Array::push` has no parameter `val`: remove `val = ` (its labels are `value`)"))
}

/// The walk used to stand down when the module declared no function, so a
/// labeled builtin call in a bare test block was never checked.
test "3651: labeled builtin call in a module with no function rejected" {
  assert(check_source_err_contains(source = "test \"t\" {\n  let s = String::concat(b = \"a\", a = \"b\")\n  assert(String::length(s) == 2)\n}", needle = "builtin `String::concat`"))
}

/// `sh_lines`'s labels after the command are flags (#777), so they stay.
test "3651: sh_lines flag labels accepted" {
  assert(check_source_ok("fn listing() -> Array[String] with Process {\n  sh_lines(\"ls\", a = true, l = false)\n}"))
}

/// ...but its command is positional.
test "3651: a label on the sh_lines command rejected" {
  assert(check_source_err_contains(source = "fn listing() -> Array[String] with Process {\n  sh_lines(cmd = \"ls\")\n}", needle = "the command of `sh_lines` is positional: remove `cmd = `"))
}

/// Positional builtin calls are unaffected.
test "3651: positional builtin call accepted" {
  assert(check_source_ok("fn main() -> String {\n  String::concat(\"a\", \"b\")\n}"))
}

/// A local binding that shadows a builtin's name is the program's value, not
/// the builtin: `println(1)` is a type error against the builtin.
test "3651: a local shadowing a builtin name is not judged as the builtin" {
  assert(check_source_ok("fn main() -> Int {\n  let println = (x: Int) -> Int { x }\n  println(1)\n}"))
}

/// Codex on #3657: a TOP-LEVEL binding that takes a builtin's spelling is the
/// program's value too, though it is not a lambda the table records.
test "3651: a top-level alias with a builtin name is not judged as the builtin" {
  assert(check_source_ok("fn identity(x: Int) -> Int {\n  x\n}\n\nlet println = identity\n\nfn main() -> Int {\n  println(1)\n}"))
}

/// ...and a destructuring `let` claims its names the same way.
test "3651: a destructured top-level name with a builtin spelling is not judged as the builtin" {
  assert(check_source_ok("fn identity(x: Int) -> Int {\n  x\n}\n\nlet (println, n) = (identity, 0)\n\nfn main() -> Int {\n  println(n)\n}"))
}

/// Codex on #3657: a constructor that takes a builtin's spelling is a program
/// binding as well.
test "3651: an enum constructor with a builtin name is not judged as the builtin" {
  assert(check_source_ok("enum Message {\n  println(Int)\n}\n\nfn main() -> Unit allows Console {\n  let _ = println(1)\n  ()\n}"))
}

/// #3659: a builtin label that names its own slot is accepted.
test "3659: an in-order builtin label accepted" {
  assert(check_source_ok("fn main() -> Int {\n  let xs: Array[Int] = [1, 2]\n  Array::push(xs, value = 3)\n  Array::get(xs, at = 2)\n}"))
}

/// ...and every labeled slot of one call can be written.
test "3659: several in-order builtin labels accepted" {
  assert(check_source_ok("fn main() -> String {\n  String::substring(\"abcd\", start = 1, end = 3)\n}"))
}

/// The labeled argument is still type-checked: the label is gone before the
/// checker sees the call.
test "3659: a labeled builtin argument is type-checked" {
  assert(check_source_err("fn main() -> Int {\n  let xs: Array[Int] = [1, 2]\n  Array::get(xs, at = \"x\")\n}"))
}

/// Labels never reorder a builtin's arguments.
test "3659: an out-of-order builtin label rejected" {
  assert(check_source_err_contains(source = "fn main() -> String {\n  String::substring(\"abcd\", end = 3, start = 1)\n}", needle = "labeled argument `end` for builtin `String::substring` is out of parameter order: `end` is argument 3"))
}

/// A label on a positional slot is refused with the edit.
test "3659: a label on a positional builtin slot rejected" {
  assert(check_source_err_contains(source = "fn main() -> Int {\n  Array::length(xs = [1])\n}", needle = "argument 1 of builtin `Array::length` is positional: remove `xs = `"))
}

/// `_` describes a positional slot in the table; it is not a callable label.
test "3659: the positional marker is not a builtin argument label" {
  assert(check_source_err_contains(source = "fn main() -> Int {\n  Array::length(_ = [1])\n}", needle = "argument 1 of builtin `Array::length` is positional: remove `_ = `"))
  assert(check_source_err_contains(source = "fn main() -> Int {\n  Array::get([1], _ = 0)\n}", needle = "builtin `Array::get` has no parameter `_`: remove `_ = `"))
}

/// A labeled callback keeps the same inference and refusal policy as its
/// positional spelling: String is seeded; Double requires an annotation.
test "labeled fold callbacks preserve accumulator inference and edits" {
  assert(check_source_ok("fn main() -> String { Array::fold([\"a\"], init = \"\", f = (acc, x) -> acc + x) }"))
  assert(check_source_err_contains(source = "fn main() -> Float64 { Array::fold([1.0], init = 0.0, f = (acc, x) -> acc + x) }", needle = "annotate the callback's accumulator"))
}

/// The precheck macro retains its historical decorative labels; checker-owned
/// placements certify its fixed layout without applying ordinary builtin rules.
test "inspect content labels survive call placement checking" {
  assert(check_source_ok("fn main() -> Unit allows Console { inspect(1, content = \"1\") }"))
  assert(check_source_ok("fn main() -> Unit allows Console { inspect(value = 1, content = \"1\") }"))
}
