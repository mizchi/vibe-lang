import @vibe/compiler/lowering/effects/evidence {
  evidence_dict_pass
}
import @vibe/compiler/syntax {
  lex, parse_program, print_stmt
}

// The printed `mid` after the evidence pass over `decls`.
fn mid_after(decls: String) -> String with Exception {
  let head = "effect Box[T] {\n  Put(T) -> Int\n}\nfn mk() -> Int with Box[Int] {\n  perform Box::Put(12345)\n}\nfn drive(f: () -> Int with Box[Int]) -> Int {\n  handle {\n    f()\n  } with { Box::Put(n) => resume(n + 1) }\n}\nfn main() -> Int {\n  drive(mid())\n}\n"
  let stmts = parse_program(lex(String::concat(head, decls)))
  let _ = evidence_dict_pass(stmts, "main")
  let mut out = ""
  for s in stmts {
    match s {
      SLet(_, _, n, _, _) => if n == "mid" {
        out = print_stmt(s)
      } else {
        ()
      },
      _ => ()
    }
  }
  out
}

// #3435: the closure a function returns at a declared row takes the dict its
// caller passes. It was left at arity 0, so `drive(mid())` failed to
// instantiate. The runtime answers are in
// `fixtures/returned_row_closure_test.vibe`.
test "a returned closure takes the declared row's dict" {
  inspect(mid_after("fn mid() -> (() -> Int with Box[Int]) {\n  () -> mk()\n}\n"), "let rec mid = () -> () -> Int with Box[Int] { (__ev_Box: __EvDict_Box) -> { mk(__ev_Box) } }")
  inspect(mid_after("fn mid() -> (() -> Int with Box[Int]) {\n  if true {\n    () -> mk()\n  } else {\n    () -> 3\n  }\n}\n"), "let rec mid = () -> () -> Int with Box[Int] { if true { (__ev_Box: __EvDict_Box) -> { mk(__ev_Box) } } else { (__ev_Box: __EvDict_Box) -> { 3 } } }")
}

// Three more shapes the result reaches the caller in (Codex on #3447): a
// closure bound and returned by its name, an explicit `return`, and a result
// type spelled through an alias.
test "a closure returned by name, by return, or at an aliased row takes the dict" {
  inspect(mid_after("fn mid() -> (() -> Int with Box[Int]) {\n  let f = () -> mk()\n  f\n}\n"), "let rec mid = () -> () -> Int with Box[Int] { { let __edpc0_f = (__ev_Box: __EvDict_Box) -> { mk(__ev_Box) }; __edpc0_f } }")
  inspect(mid_after("fn mid() -> (() -> Int with Box[Int]) {\n  return () -> mk()\n}\n"), "let rec mid = () -> () -> Int with Box[Int] { return (__ev_Box: __EvDict_Box) -> { mk(__ev_Box) } }")
  inspect(mid_after("type Thunk = () -> Int with Box[Int]\nfn mid() -> Thunk {\n  () -> mk()\n}\n"), "let rec mid = () -> Thunk { (__ev_Box: __EvDict_Box) -> { mk(__ev_Box) } }")
}
