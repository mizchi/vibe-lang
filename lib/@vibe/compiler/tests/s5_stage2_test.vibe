//# Imports

import ..{
  selfbuild_compile_stage2
}

//# Misc

test "S5: write stage2.wasm via selfbuild" {
  let bytes = selfbuild_compile_stage2()
  Fs::write_bytes("_build/bench/wasi_selfbuild/index_stage2.wasm", bytes = bytes)
  assert(Bytes::get(bytes, at = 0) == 0)
  assert(Bytes::get(bytes, at = 1) == 97)
  assert(Bytes::get(bytes, at = 2) == 115)
  assert(Bytes::get(bytes, at = 3) == 109)
  assert(Bytes::length(bytes) > 64)
}
