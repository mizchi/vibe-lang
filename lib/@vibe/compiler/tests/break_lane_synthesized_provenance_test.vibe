import @vibe/compiler/entry/compiler/file_compile {
  compile_file_fs_mode_break
}

// #2388: the break lane (interior-line breakpoints, `vibe run --break`) maps
// each compiled function to its own source file through `DbgProv`, whose
// `stmt_file_id` is indexed by MERGED PRE-PRELUDE statement positions. The
// codegen loop runs over the POST-prelude program, and the prelude appends a
// top-level function for every derive, hoisted lambda, trait-operation
// dispatcher, monoify specialization and `__exn_kind_cell` -- so reading that
// array at a synthesized function's index ran off the end and ABORTED the
// build:
//
//   Array::get: index 4 out of bounds for length 3
//     at __rt_oob_abort / __rt_arr_get
//     at compile_wasi_module_linked_impl_with_typed_offsets
//
// measured on `single_derive` below, whose only synthesis is one
// `derive (Eq)`. The existing shell gate (scripts/test_vibe_break_interior.sh)
// never caught it because its program synthesizes nothing -- which is also the
// only shape that compiled.
//
// A function is now placed by NAME (`lc_dbg_file_of_fn`): the merge makes every
// top-level name unique, so a source function answers from the pre-prelude
// index, and a synthesized one answers from the module recorded in its own
// name where it records one (a hoisted lambda, #2618).

fn break_compiles(path: String) -> String with Fs {
  handle {
    let bytes = compile_file_fs_mode_break(path, "main")
    if Bytes::length(bytes) > 0 {
      "ok"
    } else {
      "empty"
    }
  } with { Exception::Throw(m) => String::concat("throw: ", m) }
}

// The control: a program the prelude adds nothing to. This compiled before the
// fix as well, so a suite where only this passes proves nothing -- it is here
// to say the harness itself works.
test "break lane: a program whose prelude synthesizes nothing" {
  let p = "/tmp/vibe_break_prov_plain.vibe"
  Fs::write_file(p, "fn main() -> Unit with Stdout {\n  println(\"hi\")\n}\n")
  inspect(break_compiles(p), content = "ok")
}

test "break lane: a derived comparator is a synthesized top-level function" {
  let p = "/tmp/vibe_break_prov_derive.vibe"
  Fs::write_file(p, "struct Pt {\n  x: Int;\n  y: Int\n} derive (Eq)\n\nfn main() -> Unit with Stdout {\n  let a = Pt::{ x: 1, y: 2 }\n  let b = Pt::{ x: 1, y: 2 }\n  println(if a == b {\n    \"eq\"\n  } else {\n    \"ne\"\n  })\n}\n")
  inspect(break_compiles(p), content = "ok")
}

test "break lane: a throw synthesizes the exception-kind cell" {
  let p = "/tmp/vibe_break_prov_throw.vibe"
  Fs::write_file(p, "fn risky(n: Int) -> Int with Exception {\n  if n < 0 {\n    throw(\"negative\")\n  } else {\n    n\n  }\n}\n\nfn main() -> Unit with Stdout {\n  let v = handle {\n    risky(0 - 1)\n  } with {\n    Exception::Throw(_m) => 0\n  }\n  println(Int::to_string(v))\n}\n")
  inspect(break_compiles(p), content = "ok")
}

// The multi-file case, and the reason the placement has to be by owner rather
// than by position: `desugar_hoist_local_lambdas` appends its definitions at
// the END of the merged program, so the DEPENDENCY's hoisted function sits
// past every statement the provenance covers.
test "break lane: a dependency's hoisted lambda is a top-level function of that dependency" {
  let helper = "/tmp/vibe_break_prov_helper.vibe"
  let main_path = "/tmp/vibe_break_prov_main.vibe"
  Fs::write_file(helper, "effect HLog {\n  Emit(String) -> Unit\n}\n\nexport fn helper_use() -> Int {\n  let f = (a: Int) -> Int with HLog {\n    perform HLog::Emit(\"helper\")\n    a\n  }\n  handle {\n    f(1)\n  } with {\n    HLog::Emit(_m) => resume(0)\n  }\n}\n")
  Fs::write_file(main_path, "import ./vibe_break_prov_helper.vibe {\n  helper_use\n}\n\nfn main() -> Unit with Stdout {\n  println(Int::to_string(helper_use()))\n}\n")
  inspect(break_compiles(main_path), content = "ok")
}
