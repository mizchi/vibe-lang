//# Imports

import @vibe/compiler/entry/compiler {
  compile_source, compile_source_wasi
}

//# Misc

test "compile_source: arithmetic produces valid WASM" {
  let bytes = compile_source("let x = 1 + 2")
  assert(Bytes::get(bytes, 0) == 0)
  assert(Bytes::get(bytes, 1) == 97)
  assert(Bytes::length(bytes) > 8)
}

test "compile_source_wasi: entry function exports correctly" {
  let bytes = compile_source_wasi("let _start: () -> Int = () -> { 0 }", "_start")
  assert(Bytes::get(bytes, 0) == 0)
  assert(Bytes::get(bytes, 1) == 97)
  assert(Bytes::length(bytes) > 8)
}

test "compile_source: let-star Option railway compiles" {
  let src = "fn find(x: Int) -> Option[Int] { if x < 0 { None } else { Some(x) } }\nfn g(x: Int) -> Option[Int] {\n  let* v = find(x)\n  Some(v + 1)\n}\nfn main() -> Int { match g(1) { Some(v) => v, None => -1 } }\n"
  let bytes = compile_source(src)
  assert(Bytes::get(bytes, 0) == 0)
  assert(Bytes::length(bytes) > 8)
}

test "compile_source: match expression compiles" {
  let src = "enum Op { Add; Sub }\nlet eval: (Op) -> Int = (op) -> { match op { Add => 1, Sub => 2, _ => 0 } }"
  let bytes = compile_source(src)
  assert(Bytes::get(bytes, 0) == 0)
  assert(Bytes::length(bytes) > 8)
}

test "compile_source: let rec compiles" {
  let src = "let rec fact: (Int) -> Int = (n) -> { if n <= 1 { 1 } else { n * fact(n - 1) } }"
  let bytes = compile_source(src)
  assert(Bytes::get(bytes, 0) == 0)
  assert(Bytes::length(bytes) > 8)
}

test "compile_source: struct definition compiles" {
  let src = "struct Point { x: Int; y: Int }\nlet p = Point(1, 2)"
  let bytes = compile_source(src)
  assert(Bytes::get(bytes, 0) == 0)
  assert(Bytes::length(bytes) > 8)
}

test "compile_source: closure compiles" {
  let src = "let make_adder: (Int) -> (Int) -> Int = (n) -> { (x: Int) -> Int { x + n } }"
  let bytes = compile_source(src)
  assert(Bytes::get(bytes, 0) == 0)
  assert(Bytes::length(bytes) > 8)
}
