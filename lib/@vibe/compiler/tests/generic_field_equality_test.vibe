import @vibe/compiler/entry/source_compile/wasi_only {
  compile_source_wasi_only_rc
}
import @vibe/compiler/entry/source_compile/gc_only {
  compile_source_gc_only
}
import @vibe/process {
  process_sh_capture
}

fn projected_field_run(label: String, source: String, expected: String) -> Unit with Exception + Fs + Process + Console {
  Fs::mkdir_p("_build/vibe_test/projected_field_eq")
  for lane in ["rc", "gc"] {
    let bytes = if lane == "gc" {
      compile_source_gc_only(source = source, entry_name = "main")
    } else {
      compile_source_wasi_only_rc(source = source, entry_name = "main")
    }
    let path = "_build/vibe_test/projected_field_eq/" + label + "-" + lane + ".wasm"
    Fs::write_bytes(path, bytes = bytes)
    let result = process_sh_capture("bash scripts/run_wasm_vibe_host_runner.sh --invoke _start " + path)
    if result.exit_code != 0 || result.stdout != expected {
      throw(label + ":" + lane + ": expected " + expected + ", got " + result.stdout + result.stderr)
    }
  }
  ()
}

test "generic field equality: inner-formal" {
  projected_field_run(label = "inner-formal", source = "struct Pair[T]{a:T;b:T} fn f[U:Eq](p:Pair[U])->Bool{let inner=[V:Eq](q:Pair[V])->Bool{q.a==q.b};inner(Pair::{a:1.5,b:1.5})} fn main()->Unit allows Console{println(\"\\{f(p = Pair::{a:1.5,b:1.5})}\")}", expected = "true\n")
}

test "generic field equality: explicit record literal receiver" {
  projected_field_run(label = "literal-receiver", source = "struct Pair[T]{a:T;b:T} fn eq[U:Eq](x:U,y:U)->Bool{Pair[U]::{a:x,b:y}.a == Pair[U]::{a:x,b:y}.b} fn main()->Unit allows Console{println(\"\\{eq(x = 1.5,y = 1.5)}\\{eq(x = 1.5,y = 2.5)}\")}", expected = "truefalse\n")
}

test "generic field equality: record literal receiver uses custom equality" {
  projected_field_run(label = "literal-custom-eq", source = "struct Parity{n:Int} impl Eq for Parity{equals(a:Parity,b:Parity)->Bool{a.n%2==b.n%2}} struct Pair[T]{a:T;b:T} fn eq[U:Eq](x:U,y:U)->Bool{Pair[U]::{a:x,b:y}.a == Pair[U]::{a:x,b:y}.b} fn main()->Unit allows Console{println(\"\\{eq(x = Parity::{n:1},y = Parity::{n:3})}\\{eq(x = Parity::{n:1},y = Parity::{n:2})}\")}", expected = "truefalse\n")
}

test "generic field equality: renamed-double" {
  projected_field_run(label = "renamed-double", source = "struct Pair[T] { a:T; b:T } fn f[U:Eq](p:Pair[U])->Bool {p.a==p.b} fn main()->Unit allows Console {println(\"\\{f(p = Pair::{a:1.5,b:1.5})}\")}", expected = "true\n")
}

