test "generic field equality: field-bindings" {
  projected_field_run("field-bindings", "struct Pair[T]{a:T;b:T} fn f[U:Eq](p:Pair[U])->Bool {let a=p.a;let b=p.b;a==b} fn main()->Unit allows Console {println(\"\\{f(Pair::{a:1.5,b:1.5})}\")}", "true\n")
}

test "generic field equality: swapped-formals" {
  projected_field_run("swapped-formals", "struct Quad[A,B]{a:A;b:A;c:B;d:B} fn f[U:Eq,V:Eq](p:Quad[V,U])->Bool{p.a==p.b && p.c!=p.d} fn main()->Unit allows Console{println(\"\\{f(Quad::{a:1.5,b:1.5,c:\"x\",d:\"y\"})}\")}", "true\n")
}

test "generic field equality: custom-equality" {
  projected_field_run("custom-equality", "struct Parity{n:Int} impl Eq for Parity{equals(a:Parity,b:Parity)->Bool{a.n%2==b.n%2}} struct Pair[T]{a:T;b:T} fn f[U:Eq](p:Pair[U])->Bool{p.a==p.b} fn main()->Unit allows Console{println(\"\\{f(Pair::{a:Parity::{n:1},b:Parity::{n:3}})}\\{f(Pair::{a:Parity::{n:1},b:Parity::{n:4}})}\")}", "truefalse\n")
}

test "generic field equality: shadowed-value" {
  projected_field_run("shadowed-value", "struct Pair[T]{a:T;b:T} fn f[U:Eq](p:Pair[U])->Bool{let p=Pair::{a:1,b:2};p.a==p.b} fn main()->Unit allows Console{println(\"\\{f(Pair::{a:1.5,b:1.5})}\")}", "false\n")
}

test "generic field equality: array-field-unequal" {
  projected_field_run("array-field-unequal", "struct Pair[T]{a:Array[T];b:Array[T]} fn f[U:Eq](p:Pair[U])->Bool{p.a!=p.b} fn probe()->Bool{let p:Pair[Double]=Pair::{a:[1.5],b:[2.5]};f(p)} fn main()->Unit allows Console{println(\"\\{probe()}\")}", "true\n")
}

test "generic field equality: array-binding" {
  projected_field_run("array-binding", "struct Pair[T]{a:Array[T];b:Array[T]} fn f[U:Eq](p:Pair[U])->Bool{let a=p.a;let b=p.b;a==b} fn probe()->Bool{let p:Pair[Double]=Pair::{a:[1.5],b:[1.5]};f(p)} fn main()->Unit allows Console{println(\"\\{probe()}\")}", "true\n")
}

test "generic field equality: tuple-field" {
  projected_field_run("tuple-field", "struct Pair[T]{a:(T,Int);b:(T,Int)} fn f[U:Eq](p:Pair[U])->Bool{p.a==p.b} fn probe()->Bool{let p:Pair[Double]=Pair::{a:(1.5,1),b:(1.5,1)};f(p)} fn main()->Unit allows Console{println(\"\\{probe()}\")}", "true\n")
}

test "generic field equality: option-field" {
  projected_field_run("option-field", "struct Pair[T]{a:Option[T];b:Option[T]} fn f[U:Eq](p:Pair[U])->Bool{p.a==p.b} fn probe()->Bool{let p:Pair[Double]=Pair::{a:Some(1.5),b:Some(1.5)};f(p)} fn main()->Unit allows Console{println(\"\\{probe()}\")}", "true\n")
}

fn projected_field_refusal(source: String, message: String) -> Unit with Exception {
  for lane in ["rc", "gc"] {
    let diagnostic = handle {
      if lane == "gc" {
        compile_source_gc_only(source, "main")
      } else {
        compile_source_wasi_only_rc(source, "main")
      }
      "accepted"
    } with { Exception::Throw(m) => m }
    assert(String::contains(diagnostic, message))
  }
  ()
}

test "generic field equality refuses: concrete-name-collision" {
  projected_field_refusal("struct U{n:Int} derive(Eq) struct Pair[T]{a:(T,U);b:(T,U)} fn f[U:Eq](p:Pair[U])->Bool{p.a==p.b} fn probe()->Bool{let p:Pair[Double]=Pair::{a:(1.5,U::{n:1}),b:(1.5,U::{n:1})};f(p)} fn main()->Unit allows Console{println(\"\\{probe()}\")}", "shadows the declared type")
}

test "generic field equality refuses: shadowed-formal" {
  projected_field_refusal("struct Pair[T]{a:T;b:T} fn f[U:Eq](p:Pair[U])->Bool{let inner=[U:Eq](q:Pair[U])->Bool{q.a==q.b};inner(p)} fn main()->Unit allows Console{println(\"\\{f(Pair::{a:1.5,b:1.5})}\")}", "rename the nested type parameter")
}

