import @vibe/compiler/entry/source_compile/wasi_only {
  compile_source_wasi_only_rc
}
import @vibe/compiler/entry/source_compile/gc_only {
  compile_source_gc_only
}
import @vibe/process {
  process_sh_capture
}

fn projected_field_run(label: String, source: String, expected: String) -> Unit with Exception + Fs + Process + Console {
  Fs::mkdir_p("_build/vibe_test/projected_field_eq")
  for lane in ["rc", "gc"] {
    let bytes = if lane == "gc" {
      compile_source_gc_only(source, "main")
    } else {
      compile_source_wasi_only_rc(source, "main")
    }
    let path = "_build/vibe_test/projected_field_eq/" + label + "-" + lane + ".wasm"
    Fs::write_bytes(path, bytes)
    let result = process_sh_capture("bash scripts/run_wasm_vibe_host_runner.sh --invoke _start " + path)
    if result.exit_code != 0 || result.stdout != expected {
      throw(label + ":" + lane + ": expected " + expected + ", got " + result.stdout + result.stderr)
    }
  }
  ()
}

test "generic field equality: inner-formal" {
  projected_field_run("inner-formal", "struct Pair[T]{a:T;b:T} fn f[U:Eq](p:Pair[U])->Bool{let inner=[V:Eq](q:Pair[V])->Bool{q.a==q.b};inner(Pair::{a:1.5,b:1.5})} fn main()->Unit allows Console{println(\"\\{f(Pair::{a:1.5,b:1.5})}\")}", "true\n")
}

test "generic field equality: renamed-double" {
  projected_field_run("renamed-double", "struct Pair[T] { a:T; b:T } fn f[U:Eq](p:Pair[U])->Bool {p.a==p.b} fn main()->Unit allows Console {println(\"\\{f(Pair::{a:1.5,b:1.5})}\")}", "true\n")
}

test "generic field equality: same-spelling" {
  projected_field_run("same-spelling", "struct Pair[T] { a:T; b:T } fn f[T:Eq](p:Pair[T])->Bool {p.a==p.b} fn main()->Unit allows Console {println(\"\\{f(Pair::{a:1.5,b:1.5})}\")}", "true\n")
}

test "generic field equality: annotated-binding" {
  projected_field_run("annotated-binding", "struct Pair[T] { a:T; b:T } fn f[U:Eq](p:Pair[U])->Bool {let a:U=p.a;let b:U=p.b;a==b} fn main()->Unit allows Console {println(\"\\{f(Pair::{a:1.5,b:1.5})}\")}", "true\n")
}

test "generic field equality: unequal-double" {
  projected_field_run("unequal-double", "struct Pair[T] { a:T; b:T } fn f[U:Eq](p:Pair[U])->Bool {p.a==p.b} fn main()->Unit allows Console {println(\"\\{f(Pair::{a:1.5,b:2.5})}\")}", "false\n")
}

test "generic field equality: signed-zero" {
  projected_field_run("signed-zero", "struct Pair[T] { a:T; b:T } fn f[U:Eq](p:Pair[U])->Bool {p.a==p.b} fn main()->Unit allows Console {println(\"\\{f(Pair::{a:0.0,b: -0.0})}\")}", "true\n")
}

test "generic field equality: shared-nan" {
  projected_field_run("shared-nan", "struct Pair[T] { a:T; b:T } fn f[U:Eq](p:Pair[U])->Bool {p.a==p.b} fn probe()->Bool {let n=0.0/0.0;f(Pair::{a:n,b:n})} fn main()->Unit allows Console {println(\"\\{probe()}\")}", "false\n")
}

test "generic field equality: array-field" {
  projected_field_run("array-field", "struct Pair[T]{a:Array[T];b:Array[T]} fn f[U:Eq](p:Pair[U])->Bool {p.a==p.b} fn probe()->Bool {let p:Pair[Double]=Pair::{a:[1.5],b:[1.5]};f(p)} fn main()->Unit allows Console {println(\"\\{probe()}\")}", "true\n")
}

test "generic field equality: nested-field" {
  projected_field_run("nested-field", "struct Pair[T] { a:T; b:T } struct Box[T]{value:T} fn f[U:Eq](p:Box[Pair[U]])->Bool {p.value.a==p.value.b} fn main()->Unit allows Console {println(\"\\{f(Box::{value:Pair::{a:1.5,b:1.5}})}\")}", "true\n")
}

test "generic field equality: alias" {
  projected_field_run("alias", "struct Pair[T] { a:T; b:T } type Alias[V]=Pair[V] fn f[U:Eq](p:Alias[U])->Bool {p.a==p.b} fn main()->Unit allows Console {println(\"\\{f(Pair::{a:1.5,b:1.5})}\")}", "true\n")
}

test "generic field equality: parameter-alias" {
  projected_field_run("parameter-alias", "struct Pair[T]{a:T;b:T} fn f[U:Eq](p:Pair[U])->Bool {let q=p;q.a==q.b} fn main()->Unit allows Console {println(\"\\{f(Pair::{a:1.5,b:1.5})}\")}", "true\n")
