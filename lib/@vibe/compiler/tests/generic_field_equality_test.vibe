}

test "generic field equality: field-bindings" {
  projected_field_run(label = "field-bindings", source = "struct Pair[T]{a:T;b:T} fn f[U:Eq](p:Pair[U])->Bool {let a=p.a;let b=p.b;a==b} fn main()->Unit allows Console {println(\"\\{f(p = Pair::{a:1.5,b:1.5})}\")}", expected = "true\n")
