test "generic field equality: shared-nan" {
  projected_field_run(label = "shared-nan", source = "struct Pair[T] { a:T; b:T } fn f[U:Eq](p:Pair[U])->Bool {p.a==p.b} fn probe()->Bool {let n=0.0/0.0;f(p = Pair::{a:n,b:n})} fn main()->Unit allows Console {println(\"\\{probe()}\")}", expected = "false\n")
}

test "generic field equality: array-field" {
  projected_field_run(label = "array-field", source = "struct Pair[T]{a:Array[T];b:Array[T]} fn f[U:Eq](p:Pair[U])->Bool {p.a==p.b} fn probe()->Bool {let p:Pair[Float64]=Pair::{a:[1.5],b:[1.5]};f(p = p)} fn main()->Unit allows Console {println(\"\\{probe()}\")}", expected = "true\n")
}

test "generic field equality: nested-field" {
  projected_field_run(label = "nested-field", source = "struct Pair[T] { a:T; b:T } struct Box[T]{value:T} fn f[U:Eq](p:Box[Pair[U]])->Bool {p.value.a==p.value.b} fn main()->Unit allows Console {println(\"\\{f(p = Box::{value:Pair::{a:1.5,b:1.5}})}\")}", expected = "true\n")
}

