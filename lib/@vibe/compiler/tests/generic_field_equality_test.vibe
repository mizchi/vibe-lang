test "generic field equality: swapped-formals" {
  projected_field_run(label = "swapped-formals", source = "struct Quad[A,B]{a:A;b:A;c:B;d:B} fn f[U:Eq,V:Eq](p:Quad[V,U])->Bool{p.a==p.b && p.c!=p.d} fn main()->Unit allows Console{println(\"\\{f(p = Quad::{a:1.5,b:1.5,c:\"x\",d:\"y\"})}\")}", expected = "true\n")
}

test "generic field equality: custom-equality" {
  projected_field_run(label = "custom-equality", source = "struct Parity{n:Int} impl Eq for Parity{equals(a:Parity,b:Parity)->Bool{a.n%2==b.n%2}} struct Pair[T]{a:T;b:T} fn f[U:Eq](p:Pair[U])->Bool{p.a==p.b} fn main()->Unit allows Console{println(\"\\{f(p = Pair::{a:Parity::{n:1},b:Parity::{n:3}})}\\{f(p = Pair::{a:Parity::{n:1},b:Parity::{n:4}})}\")}", expected = "truefalse\n")
}

test "generic field equality: shadowed-value" {
  projected_field_run(label = "shadowed-value", source = "struct Pair[T]{a:T;b:T} fn f[U:Eq](p:Pair[U])->Bool{let p=Pair::{a:1,b:2};p.a==p.b} fn main()->Unit allows Console{println(\"\\{f(p = Pair::{a:1.5,b:1.5})}\")}", expected = "false\n")
}

test "generic field equality: array-field-unequal" {
  projected_field_run(label = "array-field-unequal", source = "struct Pair[T]{a:Array[T];b:Array[T]} fn f[U:Eq](p:Pair[U])->Bool{p.a!=p.b} fn probe()->Bool{let p:Pair[Float64]=Pair::{a:[1.5],b:[2.5]};f(p = p)} fn main()->Unit allows Console{println(\"\\{probe()}\")}", expected = "true\n")
}

test "generic field equality: array-binding" {
  projected_field_run(label = "array-binding", source = "struct Pair[T]{a:Array[T];b:Array[T]} fn f[U:Eq](p:Pair[U])->Bool{let a=p.a;let b=p.b;a==b} fn probe()->Bool{let p:Pair[Float64]=Pair::{a:[1.5],b:[1.5]};f(p = p)} fn main()->Unit allows Console{println(\"\\{probe()}\")}", expected = "true\n")
}

