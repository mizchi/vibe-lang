  projected_field_run(label = "option-field", source = "struct Pair[T]{a:Option[T];b:Option[T]} fn f[U:Eq](p:Pair[U])->Bool{p.a==p.b} fn probe()->Bool{let p:Pair[Float64]=Pair::{a:Some(1.5),b:Some(1.5)};f(p = p)} fn main()->Unit allows Console{println(\"\\{probe()}\")}", expected = "true\n")
}

fn projected_field_refusal(source: String, message: String) -> Unit with Exception {
  for lane in ["rc", "gc"] {
    let diagnostic = handle {
      if lane == "gc" {
        compile_source_gc_only(source = source, entry_name = "main")
      } else {
        compile_source_wasi_only_rc(source = source, entry_name = "main")
      }
      "accepted"
    } with { Exception::Throw(m) => m }
    assert(String::contains(diagnostic, needle = message))
  }
  ()
}

test "generic field equality refuses: concrete-name-collision" {
  projected_field_refusal(source = "struct U{n:Int} derive(Eq) struct Pair[T]{a:(T,U);b:(T,U)} fn f[U:Eq](p:Pair[U])->Bool{p.a==p.b} fn probe()->Bool{let p:Pair[Float64]=Pair::{a:(1.5,U::{n:1}),b:(1.5,U::{n:1})};f(p = p)} fn main()->Unit allows Console{println(\"\\{probe()}\")}", message = "shadows the declared type")
}

test "generic field equality refuses: shadowed-formal" {
  projected_field_refusal(source = "struct Pair[T]{a:T;b:T} fn f[U:Eq](p:Pair[U])->Bool{let inner=[U:Eq](q:Pair[U])->Bool{q.a==q.b};inner(p)} fn main()->Unit allows Console{println(\"\\{f(p = Pair::{a:1.5,b:1.5})}\")}", message = "rename the nested type parameter")
}

