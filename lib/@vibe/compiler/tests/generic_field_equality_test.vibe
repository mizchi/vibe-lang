  projected_field_run(label = "alias", source = "struct Pair[T] { a:T; b:T } type Alias[V]=Pair[V] fn f[U:Eq](p:Alias[U])->Bool {p.a==p.b} fn main()->Unit allows Console {println(\"\\{f(p = Pair::{a:1.5,b:1.5})}\")}", expected = "true\n")
}

