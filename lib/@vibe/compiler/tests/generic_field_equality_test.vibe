test "generic field equality: signed-zero" {
  projected_field_run(label = "signed-zero", source = "struct Pair[T] { a:T; b:T } fn f[U:Eq](p:Pair[U])->Bool {p.a==p.b} fn main()->Unit allows Console {println(\"\\{f(p = Pair::{a:0.0,b: -0.0})}\")}", expected = "true\n")
