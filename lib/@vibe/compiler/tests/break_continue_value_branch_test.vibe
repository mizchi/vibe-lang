//# Imports

import ./checker_parity_test_support.vibe {
  check_source_err, check_source_ok
}

//# Tests

/// `break` and `continue` leave the loop, so a branch made of one fits a
/// value-position `if` / `match` the way `return` does. Typed `()`, they were
/// refused there as a branch mismatch.
test "break and continue in a value-position branch are accepted" {
  assert(check_source_ok("fn f(xs: Array[Int]) -> Int {\n  let mut s = 0\n  for x in xs {\n    let v = if x == 2 { continue } else { x }\n    s = s + v\n  }\n  s\n}\nfn main() -> Int { f([1, 2, 3]) }"))
  assert(check_source_ok("fn f(xs: Array[Int]) -> Int {\n  let mut s = 0\n  for x in xs {\n    let v = match x { 0 => break, n => n * 2 }\n    s = s + v\n  }\n  s\n}\nfn main() -> Int { f([1, 0, 3]) }"))
  assert(check_source_ok("fn f() -> Int {\n  let mut n = 0\n  while true {\n    match n { 3 => break, _ => n = n + 1 }\n  }\n  n\n}\nfn main() -> Int { f() }"))
}

test "break outside a loop is still refused" {
  assert(check_source_err("fn f() -> Int { let v = if true { break } else { 1 }\n v }\nfn main() -> Int { f() }"))
}
