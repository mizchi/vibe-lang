//# Imports

import ./checker_parity_test_support.vibe {
  check_source_err, check_source_err_contains, check_source_ok
}

//# Misc

// #3547: an unannotated lambda passed to a call starts with the parameter
// types the call expects of it, where the operator lowering can act on a type
// only the checker knows (`Int`, `String`, `Bool`, `Char`). Before, `+` on two
// fresh parameters settled on `Int` while the body was checked, so a fold
// over strings was refused as "expected (String, String) -> String, got
// (Int, Int) -> Int". `Double` is not seeded -- its arithmetic is chosen from
// the operand's syntax, and seeding it compiled `1.5 + 2.0` to `0` -- so it
// stays refused, now naming the annotation to write instead of the backwards
// "accumulator type mismatch: expected Int, got Double".

/// The builtin `Array::fold` seeds `(acc, x)` from the initial value and the
/// element type.
test "3547: Array::fold callback parameters take the accumulator and element types" {
  assert(check_source_ok("fn main() -> String { Array::fold([\"a\", \"b\"], \"\", (acc, s) -> acc + s) }"))
  assert(check_source_ok("fn main() -> Int { Array::fold([1, 2], 0, (acc, s) -> acc + s) }"))
  assert(check_source_ok("fn main() -> String { Array::fold([\"b\", \"a\"], \"z\", (acc, s) -> if s < acc { s } else { acc }) }"))
}

/// A generic callee seeds the lambda from the arguments to its left.
test "3547: a generic callee's function parameter seeds the lambda" {
  let decl = "fn my_fold[A, B](xs: Array[A], init: B, f: (B, A) -> B) -> B { init }\n"
  assert(check_source_ok(decl + "fn main() -> String { my_fold([\"a\", \"b\"], \"\", (acc, s) -> acc + s) }"))
  assert(check_source_ok(decl + "fn main() -> String { my_fold([1, 2], \"\", (acc, n) -> acc + Int::to_string(n)) }"))
}

/// A `Double` accumulator is not seeded; the refusal names the annotation.
test "3547: an unannotated Double accumulator is refused with the edit" {
  assert(check_source_err_contains("fn main() -> Double { Array::fold([1.5, 2.0], 0.0, (acc, s) -> acc + s) }", "annotate the callback's accumulator with the initial value's type (`(acc: Double, x) -> ..`)"))
  assert(check_source_ok("fn main() -> Double { Array::fold([1.5, 2.0], 0.0, (acc: Double, s) -> acc + s) }"))
}

/// A seed is an expectation, not a cast: a real mismatch is still refused,
/// and a lambda bound by `let` is untouched.
test "3547: seeding does not hide a mismatch" {
  assert(check_source_err("fn main() -> Int { Array::fold([\"a\"], 0, (acc, s) -> acc + s) }"))
  assert(check_source_err("fn main() -> String { let add = (a, b) -> a + b\n add(\"x\", \"y\") }"))
  assert(check_source_err("fn main() -> Int { Array::fold([1.5], 0, (acc: Int, s) -> acc + s) }"))
}
