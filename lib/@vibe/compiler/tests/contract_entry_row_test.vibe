//# ADR-0088: a `.vpkg` contract declaration is a requirement, never an entry

import @vibe/compiler/contract {
  parse_contract_program
}

import @vibe/compiler/syntax {
  lex
}

fn contract_error(source: String) -> String {
  handle {
    let _ = parse_contract_program(lex(source))
    ""
  } with { Exception::Throw(msg) => msg }
}

test "ADR-0088 (Codex on #2653): `allows` is refused on a bodyless contract declaration, even one named main" {
  // A package publishes requirements; a callable API function that happens to
  // be named `main` is not an entry point, so the entry-only keyword is
  // refused by name with the `with` edit.
  let msg = contract_error("fn main() -> Unit allows Fs\n")
  assert(String::contains(msg, "written on an entry point only"))
  assert(String::contains(msg, "the contract declaration `main` requires its effects from the caller"))
  assert(String::contains(msg, "write `with` here"))
  assert_eq(contract_error("fn main() -> Unit with Fs\n"), "")
  assert_eq(contract_error("fn helper() -> Unit with Fs\n"), "")
}

test "ADR-0088 (Codex on #2653): only the clause position is read as `allows`" {
  // `allows` is contextual, not reserved: a function or a parameter named
  // `allows`, a row label or a return type spelled that way, are ordinary.
  assert_eq(contract_error("fn allows() -> Int\n"), "")
  assert_eq(contract_error("fn f(allows: Int) -> Int with Fs\n"), "")
  assert_eq(contract_error("fn f[allows]() -> allows\n"), "")
  assert_eq(contract_error("fn f() -> Int with allows + Fs\n"), "")
  // The clause after the return type is still refused, on any name (a
  // non-entry name is refused by the signature parser itself, an entry
  // name by the contract scan; both name the `with` edit).
  assert(String::contains(contract_error("fn allows() -> Int allows Fs\n"), "write `with` here"))
  assert(String::contains(contract_error("fn main[T](x: T) -> (Int, Int) allows Fs\n"), "write `with` here"))
}
