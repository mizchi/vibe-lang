//# Imports

import ./parser_test_support.vibe {
  parse_print
}

//# Misc

test "parse throw" {
  let result = handle {
    parse_print("throw(\"error\")")
  } with { Exception::Throw(e) => String::concat("ERROR: ", e) }
  assert(result == "throw(\"error\")")
}

test "parse break" {
  let result = handle {
    parse_print("{ while true { break } }")
  } with { Exception::Throw(e) => String::concat("ERROR: ", e) }
  assert(result == "while true { break }")
}

test "parse break with value" {
  let result = handle {
    parse_print("{ while true { break 42 } }")
  } with { Exception::Throw(e) => String::concat("ERROR: ", e) }
  assert(result == "while true { break 42 }")
}

test "parse continue" {
  let result = handle {
    parse_print("{ while true { continue } }")
  } with { Exception::Throw(e) => String::concat("ERROR: ", e) }
  assert(result == "while true { continue }")
}

test "parse continue with args" {
  let result = handle {
    parse_print("{ while true { continue(1, 2) } }")
  } with { Exception::Throw(e) => String::concat("ERROR: ", e) }
  assert(result == "while true { continue(1, 2) }")
}

test "parse loop sugar" {
  let result = handle {
    parse_print("{ loop { break } }")
  } with { Exception::Throw(e) => String::concat("ERROR: ", e) }
  assert(result == "while true { break }")
}

test "parameterized loop desugars continue nested in a call" {
  let result = handle {
    parse_print("loop (i = 0) { consume(continue(i + 1)) }")
  } with { Exception::Throw(e) => String::concat("ERROR: ", e) }
  assert(String::contains(result, "__lt0"))
  assert(String::contains(result, "i = __lt0"))
}

test "parse parameterized loop" {
  // Parser desugars `loop (params) { body }` into nested `let mut` + `while true { ... }`;
  // `break val` becomes `{ __loop_result = val; break }` and `continue(args)` becomes
  // `{ let __lt0 = <a0>; ...; p0 = __lt0; ...; continue }`.
  let result = handle {
    parse_print("loop (i = 10, acc = 0) { if i <= 0 { break acc } else { continue(i - 1, acc + i) } }")
  } with { Exception::Throw(e) => String::concat("ERROR: ", e) }
  assert(result == "{ let mut i = 10; { let mut acc = 0; { let mut __loop_result = 0; { while true { if (i <= 0) { { __loop_result = acc; break } } else { { let __lt0 = (i - 1); { let __lt1 = (acc + i); { i = __lt0; { acc = __lt1; continue } } } } } }; __loop_result } } } }")
}
