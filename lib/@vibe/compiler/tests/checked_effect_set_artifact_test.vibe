//# #1379 strict checked effect-set declaration artifact v1 codec tests.

import @vibe/compiler/checker {
  CheckedProgram, check_program_result
}

import @vibe/compiler/checker/artifacts {
  canonical_checked_effect_set_declarations_artifact_snapshot,
  canonical_checked_effect_set_declarations_snapshot,
  checked_effect_set_declarations_artifact_from_observation,
  checked_effect_set_declarations_observation,
  decode_checked_effect_set_declarations_artifact_v1,
  encode_checked_effect_set_declarations_artifact_v1
}

import @vibe/compiler/core {
  ImportItem, Stmt, Subst, TypeEnv
}

import @vibe/core {
  array_empty
}

fn checked_with(stmts: Array[Stmt]) -> CheckedProgram {
  CheckedProgram::{
    checked_stmts: stmts,
    final_env: EnvEmpty,
    type_defs: array_empty(),
    final_subst: SubstEmpty,
    typed_occurrences: array_empty()
  }
}

fn artifact_text(stmts: Array[Stmt]) -> String {
  let observation = checked_effect_set_declarations_observation(checked_with(stmts))
  encode_checked_effect_set_declarations_artifact_v1(checked_effect_set_declarations_artifact_from_observation(observation))
}

fn repeated_text(text: String, count: Int) -> String {
  let out = StringBuilder::new()
  let mut i = 0
  while i < count {
    StringBuilder::push(out, text)
    i = i + 1
  }
  StringBuilder::freeze(out)
}

fn assert_round_trip(stmts: Array[Stmt]) -> Unit {
  let observation = checked_effect_set_declarations_observation(checked_with(stmts))
  let artifact = checked_effect_set_declarations_artifact_from_observation(observation)
  let text = encode_checked_effect_set_declarations_artifact_v1(artifact)
  match decode_checked_effect_set_declarations_artifact_v1(text) {
    Some(decoded) => {
      assert(encode_checked_effect_set_declarations_artifact_v1(decoded) == text)
      assert(canonical_checked_effect_set_declarations_artifact_snapshot(decoded) == canonical_checked_effect_set_declarations_snapshot(observation))
    },
    None => assert(false)
  }
}

test "effect-set artifact v1 round-trips successful checked declarations exactly" {
  let checked = check_program_result([
    SEffectSet(true, "Top", ["A", "A", "Env::Read"]),
    SModule(false, "Outer", [
      SEffectSet(false, "Inner", ["B", "B"]),
      SModule(true, "Deep", [SEffectSet(true, "Leaf", ["State[Int]"])])
    ]),
    SModule(false, "Outer", [SEffectSet(false, "Again", array_empty())])
  ])
  let observation = checked_effect_set_declarations_observation(checked)
  let artifact = checked_effect_set_declarations_artifact_from_observation(observation)
  let text = encode_checked_effect_set_declarations_artifact_v1(artifact)
  match decode_checked_effect_set_declarations_artifact_v1(text) {
    Some(decoded) => {
      assert(encode_checked_effect_set_declarations_artifact_v1(decoded) == text)
      assert(canonical_checked_effect_set_declarations_artifact_snapshot(decoded) == canonical_checked_effect_set_declarations_snapshot(observation))
    },
    None => assert(false)
  }
}

test "effect-set artifact v1 preserves empty declarations and depth-first order" {
  assert_round_trip(array_empty())
  let ordered = artifact_text([
    SEffectSet(false, "First", array_empty()),
    SModule(false, "Outer", [
      SModule(false, "Inner", [SEffectSet(true, "Leaf", array_empty())])
    ]),
    SEffectSet(false, "Last", array_empty())
  ])
  let reordered = artifact_text([
    SEffectSet(false, "Last", array_empty()),
    SModule(false, "Outer", [
      SModule(false, "Inner", [SEffectSet(true, "Leaf", array_empty())])
    ]),
    SEffectSet(false, "First", array_empty())
  ])
  assert(ordered != reordered)
}

test "effect-set artifact v1 excludes import rows from its declaration scope" {
  let local = [SEffectSet(false, "Local", ["A"])]
  let with_import = [
    SImport("./dependency.vibe", [
      ImportItem::{ kind: None, name: "ImportedValue", alias: None }
    ]),
    SEffectSet(false, "Local", ["A"])
  ]
  assert(artifact_text(with_import) == artifact_text(local))
}

test "effect-set artifact v1 is sensitive to every retained declaration field" {
  let base = artifact_text([
    SModule(false, "M", [SEffectSet(false, "Set", ["A", "B"])])
  ])
  assert(base != artifact_text([
    SModule(false, "N", [SEffectSet(false, "Set", ["A", "B"])])
  ]))
  assert(base != artifact_text([
    SModule(false, "M", [SEffectSet(true, "Set", ["A", "B"])])
  ]))
  assert(base != artifact_text([
    SModule(false, "M", [SEffectSet(false, "Other", ["A", "B"])])
  ]))
  assert(base != artifact_text([
    SModule(false, "M", [SEffectSet(false, "Set", ["B", "A"])])
  ]))
  assert(base != artifact_text([
    SModule(false, "M", [SEffectSet(false, "Set", ["A", "B", "B"])])
  ]))
}

test "effect-set artifact v1 rejects malformed noncanonical and trailing inputs" {
  let prefix = "vibe-checked-effectsets-artifact:v1\n"
  match decode_checked_effect_set_declarations_artifact_v1("vibe-checked-effectsets-artifact:v2\n0[]") {
    Some(_) => assert(false),
    None => assert(true)
  }
  match decode_checked_effect_set_declarations_artifact_v1("vibe-checked-effectsets-artifact:v10\n0[]") {
    Some(_) => assert(false),
    None => assert(true)
  }
  match decode_checked_effect_set_declarations_artifact_v1(prefix) {
    Some(_) => assert(false),
    None => assert(true)
  }
  match decode_checked_effect_set_declarations_artifact_v1(String::concat(prefix, "01[]")) {
    Some(_) => assert(false),
    None => assert(true)
  }
  match decode_checked_effect_set_declarations_artifact_v1(String::concat(prefix, "1[21:1[1:M]13:Set2[1:A1:A]")) {
    Some(_) => assert(false),
    None => assert(true)
  }
  // Only 0 and 1 are assigned export-tag meanings in v1.
  match decode_checked_effect_set_declarations_artifact_v1(String::concat(prefix, "1[21:1[1:M]23:Set2[1:A1:A]]")) {
    Some(_) => assert(false),
    None => assert(true)
  }
  match decode_checked_effect_set_declarations_artifact_v1(String::concat(prefix, "1[21:1[1:M]13:Set2[1:A1:A]]!")) {
    Some(_) => assert(false),
    None => assert(true)
  }
  // The count fits within the payload bound, but the first item is malformed.
  // Rejection must stop at that first failure rather than rescanning the same
  // colon-free suffix once per hostile declared item.
  let hostile = String::concat(prefix, String::concat("4096[", repeated_text("x", 4096)))
  match decode_checked_effect_set_declarations_artifact_v1(hostile) {
    Some(_) => assert(false),
    None => assert(true)
  }
}
