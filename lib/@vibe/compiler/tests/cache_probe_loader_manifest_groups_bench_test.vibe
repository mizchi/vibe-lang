//# Imports

import ../loader_hotspot_probe.vibe {
  load_loader_hotspot_fixture,
  load_loader_hotspot_indexed_fixture,
  probe_loader_manifest_groups_encoded,
  probe_loader_manifest_groups_indexed_encoded,
  probe_loader_manifest_groups_indexed_encoded_with_source_index,
  probe_loader_manifest_groups_linear_encoded
}

//# Misc

test "bench: loader manifest groups encoded" {
  let encoded = probe_loader_manifest_groups_encoded()
  let (base_dir, rows, _, needed_sources, _) = load_loader_hotspot_fixture()
  let linear_encoded = probe_loader_manifest_groups_linear_encoded(base_dir, rows, needed_sources)
  let indexed_encoded = probe_loader_manifest_groups_indexed_encoded(base_dir, rows, needed_sources)
  let (indexed_base_dir, indexed_rows, _indexed_preloaded_sources, _indexed_needed_sources, _indexed_needed_paths, _indexed_preloaded_source_index, _needed_path_index, needed_source_index) = load_loader_hotspot_indexed_fixture()
  let prebuilt_indexed_encoded = probe_loader_manifest_groups_indexed_encoded_with_source_index(indexed_base_dir, indexed_rows, needed_source_index)
  let group_count = encoded / 1000
  let source_count = encoded % 1000
  // #769: the three RAW builders must agree exactly.
  assert(eq(linear_encoded, indexed_encoded))
  assert(eq(indexed_encoded, prebuilt_indexed_encoded))
  // #769: `encoded` (collect_source_groups_fs) additionally applies
  // move_entry_last_grouped -- the entry file is split out of its manifest
  // group into its own trailing group, so it carries ONE MORE group than
  // the raw builders. The old `encoded == indexed_encoded` pin predates
  // that regrouping.
  // #1921: collect_source_groups_fs also re-injects materialized vpkg
  // types stubs into the contract's existing group. Raw builders do not,
  // so source_count can be larger; group_count stays +1.
  assert(source_count >= indexed_encoded % 1000)
  assert(eq(group_count, indexed_encoded / 1000 + 1))
  assert(group_count > 0)
  assert(source_count > 30)
}
