import @vibe/compiler/core {
  Source, Stmt
}
import @vibe/compiler/loader {
  ContractIngest,
  ModuleParse,
  SourceIngest,
  apply_vpkg_directory_shared_imports_fs,
  collect_all_sources_fs,
  collect_sources_source,
  contract_package_hashes_fs,
  contract_package_hashes_source,
  desugar_contract_source,
  exported_type_params_source,
  module_header_source,
  parse_program_located_shared,
  share_imports_source
}

// #1872: the source-collection core runs over a provider. These tests give it
// an in-memory tree and no filesystem authority at all (no `Fs` in any row
// below), then check that the filesystem adapter answers the same tree the
// same way.

// A provider's files: (path, text), plus the paths whose stat token reports a
// symbolic link. Directory listings are derived from the paths, byte-sorted
// because the paths are written sorted.
struct MemTree {
  files: Array[(String, String)];
  symlinks: Array[String]
}

fn mem_lookup(tree: MemTree, path: String) -> Option[String] {
  let mut found = None
  for entry in tree.files {
    let (p, text) = entry
    if p == path {
      found = Some(text)
    } else {
      ()
    }
  }
  found
}

fn mem_has(tree: MemTree, path: String) -> Bool {
  match mem_lookup(tree = tree, path = path) {
    Some(_) => true,
    None => false
  }
}

// The core probes existence before it reads, so a read of a missing path
// answers "" rather than throwing: a provider's arms do not throw (see
// `ModuleParse`).
fn mem_read(tree: MemTree, path: String) -> String {
  match mem_lookup(tree = tree, path = path) {
    Some(text) => text,
    None => ""
  }
}

// Direct children of `dir` that are files ("." lists the root).
fn mem_list(tree: MemTree, dir: String) -> Array[String] {
  let prefix = if dir == "." || dir == "" {
    ""
  } else {
    String::concat(dir, "/")
  }
  let out: Array[String] = []
  for entry in tree.files {
    let (p, _) = entry
    if String::starts_with(p, prefix = prefix) {
      let rest = p[String::length(prefix): String::length(p)]
      if String::index_of(rest, needle = "/") < 0 {
        Array::push(out, value = rest)
      } else {
        ()
      }
    } else {
      ()
    }
  }
  out
}

fn mem_token(tree: MemTree, path: String) -> Int {
  let mut link = false
  for p in tree.symlinks {
    if p == path {
      link = true
    } else {
      ()
    }
  }
  if link {
    -1
  } else {
    7
  }
}

fn mem_parse(path: String, source: String) -> (Array[Stmt], Option[String]) {
  handle {
    (parse_program_located_shared(path = path, source = source), None)
  } with { Exception::Throw(message) => ([], Some(message)) }
}

fn mem_header(tree: MemTree, path: String, source: String) -> (Array[String], Option[String]) with Env {
  handle {
    let (deps, _, _) = handle {
      module_header_source(path = path, source = source, parse_count = 0)
    } with { ModuleParse::Parse(p, text) => resume(mem_parse(path = p, source = text)); Source::Read(p) => resume(mem_read(tree = tree, path = p)); Source::Exists(p) => resume(mem_has(tree = tree, path = p)); Source::List(p) => resume(mem_list(tree = tree, dir = p)); Source::StatToken(p) => resume(mem_token(tree = tree, path = p)) }
    (deps, None)
  } with { Exception::Throw(message) => ([], Some(message)) }
}

// The real exported-type-parameters core over the tree, recursing through
// its own `TypeParams` requests (no memo).
fn mem_type_params(tree: MemTree, path: String) -> ((Array[(String, Array[String])], Array[String], Array[String]), Option[String]) with Env {
  handle {
    let answer = handle {
      exported_type_params_source(path)
    } with { ContractIngest::IngestMember(_, raw) => resume((raw, None)); ContractIngest::TypeParams(p) => resume(mem_type_params(tree = tree, path = p)); ModuleParse::Parse(p, t) => resume(mem_parse(path = p, source = t)); Source::Read(p) => resume(mem_read(tree = tree, path = p)); Source::Exists(p) => resume(mem_has(tree = tree, path = p)); Source::List(p) => resume(mem_list(tree = tree, dir = p)); Source::StatToken(p) => resume(mem_token(tree = tree, path = p)) }
    (answer, None)
  } with { Exception::Throw(message) => (([], [], []), Some(message)) }
}

// The real desugaring core over the tree: members ingest unchanged, and a
// re-export's type parameters come from the real core too.
fn mem_desugar(tree: MemTree, path: String, text: String) -> (String, Option[String]) with Env {
  handle {
    let (facade, _, _) = handle {
      desugar_contract_source(path = path, source = text)
    } with { ContractIngest::IngestMember(_, raw) => resume((raw, None)); ContractIngest::TypeParams(p) => resume(mem_type_params(tree = tree, path = p)); ModuleParse::Parse(p, t) => resume(mem_parse(path = p, source = t)); Source::Read(p) => resume(mem_read(tree = tree, path = p)); Source::Exists(p) => resume(mem_has(tree = tree, path = p)); Source::List(p) => resume(mem_list(tree = tree, dir = p)); Source::StatToken(p) => resume(mem_token(tree = tree, path = p)) }
    (facade, None)
  } with { Exception::Throw(message) => ("", Some(message)) }
}

// A contract listed in `facades` desugars to that stub; any other contract
// goes through the real desugaring core.
fn mem_facade(tree: MemTree, facades: Array[(String, String)], path: String, text: String) -> (String, Option[String]) with Env {
  let mut facade = None
  for f in facades {
    let (fp, t) = f
    if fp == path {
      facade = Some(t)
    } else {
      ()
    }
  }
  match facade {
    Some(t) => (t, None),
    None => mem_desugar(tree = tree, path = path, text = text)
  }
}

// The real shared-import core over the tree; a types module it computes is
// added to the tree, as the filesystem lane publishes it.
fn mem_share(tree: MemTree, path: String, text: String) -> (String, Option[String]) {
  handle {
    let (shared, types_path, types_text) = handle {
      share_imports_source(path = path, pin_blanked = text)
    } with { Source::Read(p) => resume(mem_read(tree = tree, path = p)); Source::Exists(p) => resume(mem_has(tree = tree, path = p)); Source::List(p) => resume(mem_list(tree = tree, dir = p)); Source::StatToken(p) => resume(mem_token(tree = tree, path = p)) }
    if types_path != "" && !mem_has(tree = tree, path = types_path) {
      Array::push(tree.files, value = (types_path, types_text))
    } else {
      ()
    }
    (shared, None)
  } with { Exception::Throw(message) => ("", Some(message)) }
}

// Collect from `entry` over the tree. Contracts desugar to `facades` (path,
// facade text) or, when not listed, through the real desugaring core;
// ordinary modules ingest unchanged.
fn mem_collect(tree: MemTree, facades: Array[(String, String)], entry: String) -> Array[(String, String)] with Env + Exception {
  handle {
    collect_sources_source(entry)
  } with { SourceIngest::Header(p, text) => resume(mem_header(tree = tree, path = p, source = text)); SourceIngest::DesugarContract(p, text) => resume(mem_facade(tree = tree, facades = facades, path = p, text = text)); SourceIngest::ShareImports(p, text) => resume(mem_share(tree = tree, path = p, text = text)); Source::Read(p) => resume(mem_read(tree = tree, path = p)); Source::Exists(p) => resume(mem_has(tree = tree, path = p)); Source::List(p) => resume(mem_list(tree = tree, dir = p)); Source::StatToken(p) => resume(mem_token(tree = tree, path = p)) }
}

fn collected_paths(_ sources: Array[(String, String)]) -> Array[String] {
  let out: Array[String] = []
  for entry in sources {
    let (p, _) = entry
    Array::push(out, value = p)
  }
  out
}

fn mem_collect_error(tree: MemTree, entry: String) -> String with Env {
  handle {
    let _ = mem_collect(tree = tree, facades = [], entry = entry)
    "accepted"
  } with { Exception::Throw(message) => message }
}

fn diamond() -> MemTree {
  MemTree::{
    files: [
      ("app/a.vibe", "import ./b.vibe { b }\nexport fn a() -> Int { b() + 1 }\n"),
      ("app/b.vibe", "export fn b() -> Int { 1 }\n"),
      ("app/main.vibe", "import ./a.vibe { a }\nimport ./b.vibe { b }\nfn main() -> Int { a() + b() }\n")
    ],
    symlinks: []
  }
}

test "the collection core orders dependencies first and visits each module once" {
  let sources = mem_collect(tree = diamond(), facades = [], entry = "app/main.vibe")
  inspect(collected_paths(sources), "[app/b.vibe, app/a.vibe, app/main.vibe]")
}

test "the collection core reports a missing import at its import site" {
  let tree = MemTree::{
    files: [
      ("app/main.vibe", "import ./gone.vibe { g }\nfn main() -> Int { g() }\n")
    ],
    symlinks: []
  }
  inspect(mem_collect_error(tree = tree, entry = "app/main.vibe"), "line 1:8: cannot resolve import './gone.vibe' (resolved to app/gone.vibe)")
}

test "the collection core refuses a missing entry" {
  inspect(mem_collect_error(tree = diamond(), entry = "app/none.vibe"), "cannot resolve module: app/none.vibe does not exist")
}

test "the collection core refuses a symlinked module before reading it" {
  let tree = diamond()
  let linked = MemTree::{ files: tree.files, symlinks: ["app/b.vibe"] }
  inspect(mem_collect_error(tree = linked, entry = "app/main.vibe"), "symlink module source is not allowed: app/b.vibe")
}

test "the collection core refuses a directory with two indexes" {
  let tree = MemTree::{
    files: [
      ("app/index.vibe", "export fn x() -> Int { 1 }\n"),
      ("app/index.vpkg", "fn x() -> Int\n"),
      ("app/main.vibe", "fn main() -> Int { 1 }\n")
    ],
    symlinks: []
  }
  inspect(mem_collect_error(tree = tree, entry = "app/main.vibe"), "index.vibe and index.vpkg exist in app (#729/#897): a boundary has exactly one index")
}

test "the collection core refuses an import into another package's internals" {
  let tree = MemTree::{
    files: [
      ("main.vibe", "import ./pkg/inner.vibe { inner }\nfn main() -> Int { inner() }\n"),
      ("pkg/index.vpkg", "fn inner() -> Int\n"),
      ("pkg/inner.vibe", "export fn inner() -> Int { 1 }\n")
    ],
    symlinks: []
  }
  inspect(mem_collect_error(tree = tree, entry = "main.vibe"), "cannot import pkg/inner.vibe across a package boundary; target owner is pkg/index.vpkg (#729); import the owner contract instead")
}

fn package_tree(_ head: String) -> MemTree {
  MemTree::{
    files: [
      ("app/main.vibe", "\{head}import @acme/base { greet }\nfn main() -> Int { greet() }\n"),
      ("lib/@acme/base/base.vibe", "export fn greet() -> Int { 1 }\n"),
      ("lib/@acme/base/index.vpkg", "fn greet() -> Int\n")
    ],
    symlinks: []
  }
}

let package_facades: Array[(String, String)] = [
  ("lib/@acme/base/index.vpkg", "export ./base.vibe { greet }\n")
]

test "the collection core ingests a package contract through its facade" {
  let sources = mem_collect(tree = package_tree(""), facades = package_facades, entry = "app/main.vibe")
  inspect(collected_paths(sources), "[lib/@acme/base/base.vibe, lib/@acme/base/index.vpkg, app/main.vibe]")
}

// The package hash of the tree's `@acme/base`, computed by the same core the
// walk verifies a pin with.
fn mem_package_hash(tree: MemTree, contract: String) -> String with Env + Exception {
  let (pkg_hash, _) = handle {
    contract_package_hashes_source(path = contract, algo = "b3")
  } with { SourceIngest::Header(p, text) => resume(mem_header(tree = tree, path = p, source = text)); SourceIngest::DesugarContract(p, text) => resume(mem_facade(tree = tree, facades = [
  ], path = p, text = text)); SourceIngest::ShareImports(p, text) => resume(mem_share(tree = tree, path = p, text = text)); Source::Read(p) => resume(mem_read(tree = tree, path = p)); Source::Exists(p) => resume(mem_has(tree = tree, path = p)); Source::List(p) => resume(mem_list(tree = tree, dir = p)); Source::StatToken(p) => resume(mem_token(tree = tree, path = p)) }
  pkg_hash
}

test "the collection core refuses a package whose content does not match the pin" {
  let tree = package_tree("require @acme/base 0.1.0 = #pkg:b3:0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f\n")
  let actual = mem_package_hash(tree = tree, contract = "lib/@acme/base/index.vpkg")
  assert_eq(mem_collect_error(tree = tree, entry = "app/main.vibe"), "pin mismatch for @acme/base: app/main.vibe requires #pkg:b3:0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f but the lib/ copy is #\{actual}")
}

test "the collection core accepts a package whose content matches the pin" {
  let pin = mem_package_hash(tree = package_tree(""), contract = "lib/@acme/base/index.vpkg")
  let tree = package_tree("require @acme/base 0.1.0 = #\{pin}\n")
  inspect(collected_paths(mem_collect(tree = tree, facades = package_facades, entry = "app/main.vibe")), "[lib/@acme/base/base.vibe, lib/@acme/base/index.vpkg, app/main.vibe]")
}

fn source_of(sources: Array[(String, String)], path: String) -> String {
  let mut found = ""
  for entry in sources {
    let (p, text) = entry
    if p == path {
      found = text
    } else {
      ()
    }
  }
  found
}

test "the collection core desugars a package contract with the shared core" {
  let sources = mem_collect(tree = package_tree(""), facades = [], entry = "app/main.vibe")
  inspect(collected_paths(sources), "[lib/@acme/base/base.vibe, lib/@acme/base/index.vpkg, app/main.vibe]")
  inspect(source_of(sources = sources, path = "lib/@acme/base/index.vpkg"), "// vibe: contract facade (desugared from .vibei)\nexport ./base.vibe { greet }\n")
}

test "the desugaring core refuses a declaration no member implements" {
  let tree = MemTree::{
    files: [
      ("app/main.vibe", "import @acme/base { greet }\nfn main() -> Int { greet() }\n"),
      ("lib/@acme/base/base.vibe", "export fn greet() -> Int { 1 }\n"),
      ("lib/@acme/base/index.vpkg", "fn greet() -> Int\nfn missing() -> Int\n")
    ],
    symlinks: []
  }
  inspect(mem_collect_error(tree = tree, entry = "app/main.vibe"), "lib/@acme/base/index.vpkg: contract violation: contract declaration 'missing' has no implementation")
}

fn relative_package_tree() -> MemTree {
  MemTree::{
    files: [
      ("app/main.vibe", "import ../pkg { greet }\nfn main() -> Int { greet() }\n"),
      ("pkg/base.vibe", "export fn greet() -> Int { 1 }\n"),
      ("pkg/index.vpkg", "fn greet() -> Int\n")
    ],
    symlinks: []
  }
}

// The same contract on disk desugars, through the filesystem adapter and its
// facade cache, to the facade the in-memory provider builds.
test "the filesystem adapter desugars a contract to the in-memory facade" {
  let root = "/tmp/vibe_source_1872_contract"
  Fs::mkdir_p(String::concat(root, "/app"))
  Fs::mkdir_p(String::concat(root, "/pkg"))
  for entry in relative_package_tree().files {
    let (p, text) = entry
    Fs::write_file(String::concat(root, String::concat("/", p)), contents = text)
  }
  let on_disk = collect_all_sources_fs(String::concat(root, "/app/main.vibe"))
  let in_memory = mem_collect(tree = relative_package_tree(), facades = [], entry = "app/main.vibe")
  assert_eq(source_of(sources = on_disk, path = String::concat(root, "/pkg/index.vpkg")), source_of(sources = in_memory, path = "pkg/index.vpkg"))
}

// The package hash is location-independent: the same package on disk hashes,
// through the filesystem adapter, to what the in-memory provider computes.
test "the filesystem adapter hashes a package to the in-memory hash" {
  let root = "/tmp/vibe_source_1872_hash"
  Fs::mkdir_p(String::concat(root, "/app"))
  Fs::mkdir_p(String::concat(root, "/pkg"))
  for entry in relative_package_tree().files {
    let (p, text) = entry
    Fs::write_file(String::concat(root, String::concat("/", p)), contents = text)
  }
  let (on_disk, _) = contract_package_hashes_fs(String::concat(root, "/pkg/index.vpkg"))
  assert_eq(on_disk, mem_package_hash(tree = relative_package_tree(), contract = "pkg/index.vpkg"))
}

// A parent contract whose member re-exports `Container` from another
// package: the conformance check compares the kind the parent declares with
// the kind the re-export's source exports (`TypeParams`).
fn reexport_tree(_ source_kind: String) -> MemTree {
  MemTree::{
    files: [
      ("parent/index.vpkg", "opaque type Container[F[_]]\n"),
      ("parent/mid.vibe", "export ../source { Container }\n"),
      ("source/impl.vibe", "export type Container[F[_]] = F[Int]\n"),
      ("source/index.vpkg", "opaque type \{source_kind}\n")
    ],
    symlinks: []
  }
}

test "the desugaring core reads a re-exported type's kind from its source" {
  let tree = reexport_tree("Container[F[_]]")
  let (_, failure) = mem_desugar(tree = tree, path = "parent/index.vpkg", text = mem_read(tree = tree, path = "parent/index.vpkg"))
  inspect(failure, "None")
  let ((params, read, _), _) = mem_type_params(tree = tree, path = "parent/mid.vibe")
  let rows: Array[String] = []
  for entry in params {
    let (name, ps) = entry
    Array::push(rows, value = "\{name}[\{String::join(ps, sep = ", ")}]")
  }
  let read_paths: Array[String] = read
  inspect(rows, "[Container[$type_param$1$F]]")
  inspect(read_paths, "[parent/mid.vibe, source/index.vpkg]")
}

test "the desugaring core refuses a re-export whose source exports another kind" {
  let tree = reexport_tree("Container[F]")
  let (_, failure) = mem_desugar(tree = tree, path = "parent/index.vpkg", text = mem_read(tree = tree, path = "parent/index.vpkg"))
  inspect(failure, "Some(parent/index.vpkg: contract violation: type 'Container' kind mismatch: contract declares [F[_]], re-exported implementation defines [F])")
}

fn share_tree(_ root: String) -> MemTree {
  MemTree::{
    files: [
      (String::concat(root, "/loose.vibe"), "export fn loose() -> Int { 3 }\n"),
      (String::concat(root, "/pkg/base.vibe"), "export fn greet() -> Int { 1 }\n"),
      (String::concat(root, "/pkg/base_test.vibe"), "test { assert_eq(1, 1) }\n"),
      (String::concat(root, "/pkg/index.vpkg"), "import @vibe/core { array_empty }\nfn greet() -> Int\n")
    ],
    symlinks: []
  }
}

fn mem_shared_text(tree: MemTree, path: String) -> String {
  let (text, _) = mem_share(tree = tree, path = path, text = mem_read(tree = tree, path = path))
  text
}

// The owner rule, over the provider: a direct sibling and a test companion
// inherit the contract's `@scope` imports, a file outside any package does
// not, and the result is the same text the filesystem lane writes.
test "the shared-import core matches the filesystem lane" {
  let root = "/tmp/vibe_source_1872_share"
  let tree = share_tree(root)
  Fs::mkdir_p(String::concat(root, "/pkg"))
  for entry in tree.files {
    let (p, text) = entry
    Fs::write_file(p, contents = text)
  }
  for name in ["/pkg/base.vibe", "/pkg/base_test.vibe", "/loose.vibe"] {
    let path = String::concat(root, name)
    assert_eq(mem_shared_text(tree = tree, path = path), apply_vpkg_directory_shared_imports_fs(path = path, pin_blanked = mem_read(tree = tree, path = path)))
  }
  assert_true(String::contains(mem_shared_text(tree = tree, path = String::concat(root, "/pkg/base.vibe")), needle = "import @vibe/core { array_empty }"))
  assert_true(String::contains(mem_shared_text(tree = tree, path = String::concat(root, "/pkg/base_test.vibe")), needle = "import @vibe/core { array_empty }"))
  assert_eq(mem_shared_text(tree = tree, path = String::concat(root, "/loose.vibe")), "export fn loose() -> Int { 3 }\n")
}

// The filesystem adapter is the same core over `Fs`: the same tree written to
// disk collects in the same order.
test "the filesystem adapter collects the in-memory tree in the same order" {
  let root = "/tmp/vibe_source_1872_collection"
  Fs::mkdir_p(String::concat(root, "/app"))
  for entry in diamond().files {
    let (p, text) = entry
    Fs::write_file(String::concat(root, String::concat("/", p)), contents = text)
  }
  let on_disk: Array[String] = []
  for p in collected_paths(collect_all_sources_fs(String::concat(root, "/app/main.vibe"))) {
    Array::push(on_disk, value = p[String::length(root) + 1: String::length(p)])
  }
  assert_eq(on_disk, collected_paths(mem_collect(tree = diamond(), facades = [], entry = "app/main.vibe")))
}
