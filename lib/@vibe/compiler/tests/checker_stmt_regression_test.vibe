//# Imports

import @vibe/compiler/core {
  Expr, ImportItem, Pat, Stmt, Subst, Type, TypeDef, TypeEnv, TypeExpr, env_bind, env_lookup, types_equal
}

import @vibe/core {
  array_empty
}

import @vibe/compiler/checker {
  check_stmts
}

//# Functions

let _no_tp = array_empty()

fn import_item(name: String, alias: Option[String]) -> ImportItem {
  ImportItem::{ kind: None, name, alias }
}

let _no_tb = array_empty()

fn empty_defs() -> Array[TypeDef] {
  array_empty()
}

fn check_stmts_compat(stmts: Array[Stmt]) -> TypeEnv {
  let errors = array_empty()
  let (env, _, _) = check_stmts(stmts, 0, EnvEmpty, empty_defs(), SubstEmpty, 0, errors, array_empty())
  env
}

//# Misc

test "SLet with type annotation uses annotation" {
  let stmts = [SLet(false, false, "x", Some(TyName("Int")), EInt(42))]
  let env = check_stmts_compat(stmts)
  match env_lookup(env, "x") {
    Some(t) => assert(types_equal(t, CtInt)),
    None => assert(false)
  }
}

test "SLetMut with type annotation uses annotation" {
  let stmts = [SLetMut("count", Some(TyName("Int")), EInt(0))]
  let env = check_stmts_compat(stmts)
  match env_lookup(env, "count") {
    Some(t) => assert(types_equal(t, CtInt)),
    None => assert(false)
  }
}

test "SExternLet resolves simple type" {
  let stmts = [SExternLet("get_name", TyName("String"))]
  let env = check_stmts_compat(stmts)
  match env_lookup(env, "get_name") {
    Some(t) => assert(types_equal(t, CtString)),
    None => assert(false)
  }
}

test "STypeAlias resolves builtin type" {
  let stmts = [STypeAlias(false, "MyInt", array_empty(), TyName("Int"))]
  let env = check_stmts_compat(stmts)
  match env_lookup(env, "MyInt") {
    Some(t) => assert(types_equal(t, CtInt)),
    None => assert(false)
  }
}

test "SImport binds imported names" {
  let stmts = [SImport("./foo.vibe", [import_item("bar", None)])]
  let env = check_stmts_compat(stmts)
  match env_lookup(env, "bar") {
    Some(_) => assert(true),
    None => assert(false)
  }
}

test "SImport binds aliased name" {
  let stmts = [SImport("./foo.vibe", [import_item("bar", Some("baz"))])]
  let env = check_stmts_compat(stmts)
  match env_lookup(env, "baz") {
    Some(_) => assert(true),
    None => assert(false)
  }
}

test "SImport alias keeps source type" {
  let stmts = [SImport("./foo.vibe", [import_item("bar", Some("baz"))])]
  let seed = env_bind(EnvEmpty, "bar", CtInt)
  let _errors = array_empty()
  let (env, _, _) = check_stmts(stmts, 0, seed, empty_defs(), SubstEmpty, 0, _errors, array_empty())
  match env_lookup(env, "baz") {
    Some(t) => assert(types_equal(t, CtInt)),
    None => assert(false)
  }
}

test "SImport uses nearest binding from env" {
  let stmts = [SImport("./foo.vibe", [import_item("x", None)])]
  let seed = env_bind(env_bind(EnvEmpty, "x", CtInt), "x", CtString)
  let _errors = array_empty()
  let (env, _, _) = check_stmts(stmts, 0, seed, empty_defs(), SubstEmpty, 0, _errors, array_empty())
  match env_lookup(env, "x") {
    Some(t) => assert(types_equal(t, CtString)),
    None => assert(false)
  }
}

test "SImport binds multiple names" {
  let stmts = [
    SImport("./mod.vibe", [import_item("a", None), import_item("b", Some("c"))])
  ]
  let env = check_stmts_compat(stmts)
  match env_lookup(env, "a") {
    Some(_) => match env_lookup(env, "c") {
      Some(_) => assert(true),
      None => assert(false)
    },
    None => assert(false)
  }
}

test "let uses previous binding" {
  let stmts = [
    SLet(false, false, "x", None, EInt(1)),
    SLet(false, false, "y", None, EIdent("x", -1))
  ]
  let env = check_stmts_compat(stmts)
  match env_lookup(env, "y") {
    Some(t) => assert(types_equal(t, CtInt)),
    None => assert(false)
  }
}
