//# Imports

import @vibe/compiler/core {
  Expr, ImportItem, Pat, Stmt, Subst, Type, TypeDef, TypeEnv, TypeExpr, env_bind, env_lookup, types_equal
}

import @vibe/core {
  array_empty
}

import @vibe/compiler/checker {
  check_stmts
}

//# Functions

let _no_tp = array_empty()

fn import_item(name: String, alias: Option[String]) -> ImportItem {
  ImportItem::{ kind: None, name, alias }
}

let _no_tb = array_empty()

fn empty_defs() -> Array[TypeDef] {
  array_empty()
}

fn check_stmts_compat(_ stmts: Array[Stmt]) -> TypeEnv {
  let errors = array_empty()
  let (env, _, _) = check_stmts(raw_stmts = stmts, i = 0, env = EnvEmpty, defs = empty_defs(), s = SubstEmpty, c = 0, errors = errors, tytab = array_empty())
  env
}

//# Misc

test "SLet with type annotation uses annotation" {
  let stmts = [SLet(false, false, "x", Some(TyName("Int")), EInt(42))]
  let env = check_stmts_compat(stmts)
  match env_lookup(env = env, name = "x") {
    Some(t) => assert(types_equal(a = t, b = CtInt)),
    None => assert(false)
  }
}

test "SLetMut with type annotation uses annotation" {
  let stmts = [SLetMut("count", Some(TyName("Int")), EInt(0))]
  let env = check_stmts_compat(stmts)
  match env_lookup(env = env, name = "count") {
    Some(t) => assert(types_equal(a = t, b = CtInt)),
    None => assert(false)
  }
}

test "SExternLet resolves simple type" {
  let stmts = [SExternLet("get_name", TyName("String"))]
  let env = check_stmts_compat(stmts)
  match env_lookup(env = env, name = "get_name") {
    Some(t) => assert(types_equal(a = t, b = CtString)),
    None => assert(false)
  }
}

test "STypeAlias resolves builtin type" {
  let stmts = [STypeAlias(false, "MyInt", array_empty(), TyName("Int"))]
  let env = check_stmts_compat(stmts)
  match env_lookup(env = env, name = "MyInt") {
    Some(t) => assert(types_equal(a = t, b = CtInt)),
    None => assert(false)
  }
}

test "SImport binds imported names" {
  let stmts = [SImport("./foo.vibe", [import_item(name = "bar", alias = None)])]
  let env = check_stmts_compat(stmts)
  match env_lookup(env = env, name = "bar") {
    Some(_) => assert(true),
    None => assert(false)
  }
}

test "SImport binds aliased name" {
  let stmts = [
    SImport("./foo.vibe", [import_item(name = "bar", alias = Some("baz"))])
  ]
  let env = check_stmts_compat(stmts)
  match env_lookup(env = env, name = "baz") {
    Some(_) => assert(true),
    None => assert(false)
  }
}

test "SImport alias keeps source type" {
  let stmts = [
    SImport("./foo.vibe", [import_item(name = "bar", alias = Some("baz"))])
  ]
  let seed = env_bind(env = EnvEmpty, name = "bar", ty = CtInt)
  let _errors = array_empty()
  let (env, _, _) = check_stmts(raw_stmts = stmts, i = 0, env = seed, defs = empty_defs(), s = SubstEmpty, c = 0, errors = _errors, tytab = array_empty())
  match env_lookup(env = env, name = "baz") {
    Some(t) => assert(types_equal(a = t, b = CtInt)),
    None => assert(false)
  }
}

test "SImport uses nearest binding from env" {
  let stmts = [SImport("./foo.vibe", [import_item(name = "x", alias = None)])]
  let seed = env_bind(env = env_bind(env = EnvEmpty, name = "x", ty = CtInt), name = "x", ty = CtString)
  let _errors = array_empty()
  let (env, _, _) = check_stmts(raw_stmts = stmts, i = 0, env = seed, defs = empty_defs(), s = SubstEmpty, c = 0, errors = _errors, tytab = array_empty())
  match env_lookup(env = env, name = "x") {
    Some(t) => assert(types_equal(a = t, b = CtString)),
    None => assert(false)
  }
}

test "SImport binds multiple names" {
  let stmts = [
    SImport("./mod.vibe", [
      import_item(name = "a", alias = None),
      import_item(name = "b", alias = Some("c"))
    ])
  ]
  let env = check_stmts_compat(stmts)
  match env_lookup(env = env, name = "a") {
    Some(_) => match env_lookup(env = env, name = "c") {
      Some(_) => assert(true),
      None => assert(false)
    },
    None => assert(false)
  }
}

test "let uses previous binding" {
  let stmts = [
    SLet(false, false, "x", None, EInt(1)),
    SLet(false, false, "y", None, EIdent("x", -1))
  ]
  let env = check_stmts_compat(stmts)
  match env_lookup(env = env, name = "y") {
    Some(t) => assert(types_equal(a = t, b = CtInt)),
    None => assert(false)
  }
}
