//# Imports

import ./checker_parity_test_support.vibe {
  check_source_err, check_source_ok
}

//# Misc

test "parity: multiple let bindings" {
  assert(check_source_ok("let a = 1\nlet b = 2\nlet c = 3\nlet _adr69 = () -> { a + b + c }"))
}

test "parity: nested match" {
  assert(check_source_ok("enum Op { Add; Sub }\nlet calc: (Op, Int, Int) -> Int = (op, a, b) -> { match op { Add => a + b, Sub => a - b } }\nlet _adr69 = () -> { calc(Add, 10, 3) }"))
}

test "parity: bitwise ops" {
  assert(check_source_ok("let a = 0xFF & 0x0F\nlet b = a | 0x10\nlet _adr69 = () -> { b }"))
}

test "parity: handle propagation" {
  assert(check_source_ok("let inner: () -> Int with Exception = () -> { throw(\"err\")\n0 }\nlet outer: () -> Int with Exception = () -> { inner() + 1 }\nlet r = handle { outer() } with { Exception::Throw(_) => -1 }\nlet _adr69 = () -> { r }"))
}

test "parity: suberror definition" {
  assert(check_source_ok("suberror AppError { NotFound; InvalidInput(String) }\nlet f: () -> Int with Exception = () -> { throw(NotFound)\n0 }\nlet _adr69 = () -> { handle { f() } with { Exception::Throw(_) => 42 } }"))
}

test "parity: type alias" {
  assert(check_source_ok("type Pair = (Int, Int)\nlet sum: (Pair) -> Int = (p) -> { let (a, b) = p\na + b }\nlet _adr69 = () -> { sum((3, 7)) }"))
}

test "parity: struct field access" {
  assert(check_source_ok("struct Point { x: Int; y: Int }\nlet p = Point::{ x: 3, y: 4 }\nlet _adr69 = () -> { p.x + p.y }"))
}

test "parity: labeled function" {
  assert(check_source_ok("let add: (x~: Int, y~: Int) -> Int = (x~, y~) -> { x + y }\nlet _adr69 = () -> { add(x=1, y=2) }"))
}

test "parity err: return type mismatch" {
  assert(check_source_err("let f: () -> Int = () -> { \"hello\" }"))
}

test "parity err: function arity" {
  assert(check_source_err("let f: (Int) -> Int = (x) -> { x }\nf(1, 2)"))
}

test "parity err: while condition not bool" {
  assert(check_source_err("while 42 { 0 }"))
}

test "parity err: logic op non-bool" {
  assert(check_source_err("1 && 2"))
}

test "parity err: subtract string" {
  assert(check_source_err("\"a\" - \"b\""))
}

test "parity: loop with params" {
  assert(check_source_ok("let _adr69 = () -> { loop (i = 0, acc = 0) { if i >= 5 { break(acc) } else { continue(i + 1, acc + i) } } }"))
}

test "parity: for-in with index" {
  assert(check_source_ok("let arr = [10, 20, 30]\nlet _adr69 = () -> { let mut total = 0\nfor x, i in arr { total = total + x + i }\ntotal }"))
}

test "parity: nested while" {
  assert(check_source_ok("let _adr69 = () -> { let mut sum = 0\nlet mut i = 0\nwhile i < 3 { let mut j = 0\nwhile j < 3 { sum = sum + 1\nj = j + 1 }\ni = i + 1 }\nsum }"))
}

test "parity: enum with payload" {
  assert(check_source_ok("enum Shape { Circle(Int); Rect(Int, Int); Point }\nlet area: (Shape) -> Int = (s) -> { match s { Circle(r) => r * r, Rect(w, h) => w * h, Point => 0 } }\nlet _adr69 = () -> { area(Circle(5)) }"))
}

test "parity: nested enum match" {
  assert(check_source_ok("enum Tree { Leaf(Int); Node(Tree, Tree) }\nlet rec sum: (Tree) -> Int = (t) -> { match t { Leaf(n) => n, Node(l, r) => sum(l) + sum(r) } }\nlet _adr69 = () -> { sum(Node(Leaf(1), Leaf(2))) }"))
}

test "parity: record literal" {
  assert(check_source_ok("let p = record { x: 3, y: 4 }\nlet _adr69 = () -> { p.x + p.y }"))
}

test "parity: array builder" {
  assert(check_source_ok("let b = ArrayBuilder::new()\nlet _adr69 = () -> { ArrayBuilder::push(b, 1)\nArrayBuilder::push(b, 2)\nlet arr = ArrayBuilder::freeze(b)\nArray::length(arr) }"))
}

test "parity: map builder" {
  assert(check_source_ok("let b = MapBuilder::new()\nlet _adr69 = () -> { MapBuilder::set(b, \"k\", 1)\nlet m = MapBuilder::freeze(b)\nMap::get(m, \"k\") }"))
}

test "parity: let rec" {
  assert(check_source_ok("let rec fact: (Int) -> Int = (n) -> { if n <= 1 { 1 } else { n * fact(n - 1) } }\nlet _adr69 = () -> { fact(5) }"))
}

test "parity: function returning function" {
  assert(check_source_ok("let make_adder: (Int) -> (Int) -> Int = (n) -> { (x: Int) -> Int { x + n } }\nlet add5 = make_adder(5)\nlet _adr69 = () -> { add5(10) }"))
}

test "parity: generic pair" {
  assert(check_source_ok("let fst: [A, B]((A, B)) -> A = (p) -> { let (a, _) = p\na }\nlet _adr69 = () -> { fst((42, \"hi\")) }"))
}

test "parity: pipe operator" {
  assert(check_source_ok("let double: (Int) -> Int = (x) -> { x * 2 }\nlet _adr69 = () -> { 5 |> double }"))
}

test "parity: string interpolation" {
  assert(check_source_ok("let name = \"world\"\nlet s = \"hello \\{name}\"\nlet _adr69 = () -> { String::length(s) }"))
}

test "parity: spread array" {
  assert(check_source_ok("let a = [1, 2]\nlet b = [...a, 3]\nlet _adr69 = () -> { Array::length(b) }"))
}

test "parity: String::length" {
  assert(check_source_ok("let _adr69 = () -> { String::length(\"hello\") }"))
}

test "parity: String::contains" {
  assert(check_source_ok("let _adr69 = () -> { String::contains(\"hello world\", \"world\") }"))
}

test "parity: Array::length" {
  assert(check_source_ok("let _adr69 = () -> { Array::length([1, 2, 3]) }"))
}

test "parity: Map::has_key" {
  assert(check_source_ok("let m = Map::from_pairs([(\"a\", 1)])\nlet _adr69 = () -> { Map::has_key(m, \"a\") }"))
}

test "parity: not operator" {
  assert(check_source_ok("let x = !true\nlet _adr69 = () -> { if x { 0 } else { 1 } }"))
}

test "parity: unary minus" {
  assert(check_source_ok("let x = -5\nlet _adr69 = () -> { 0 - x }"))
}

test "parity err: unknown builtin" {
  assert(check_source_err("NonExistent::method(42)"))
}

test "parity err: division type mismatch" {
  assert(check_source_err("\"hello\" / 2"))
}

test "parity err: modulo type mismatch" {
  assert(check_source_err("\"hello\" % 2"))
}

test "parity err: comparison type mismatch" {
  assert(check_source_err("1 < \"hello\""))
}

test "parity err: equality type mismatch" {
  assert(check_source_err("1 == \"hello\""))
}

test "parity builtin: String::concat" {
  assert(check_source_ok("let _adr69 = () -> { String::concat(\"a\", \"b\") }"))
}

test "parity builtin: String::equals" {
  assert(check_source_ok("let _adr69 = () -> { String::equals(\"a\", \"a\") }"))
}

test "parity builtin: String::substring" {
  assert(check_source_ok("let _adr69 = () -> { String::substring(\"hello\", 1, 3) }"))
}

test "parity builtin: String::index_of" {
  assert(check_source_ok("let _adr69 = () -> { String::index_of(\"hello\", \"ll\") }"))
}

test "parity builtin: String::starts_with" {
  assert(check_source_ok("let _adr69 = () -> { String::starts_with(\"hello\", \"he\") }"))
}

