//# #1550 bounded shadow-only checked module typing artifact tests.

import @vibe/compiler/checker {
  CheckedProgram, check_program_result
}

import @vibe/compiler/checker/artifacts {
  canonical_checked_module_typing_artifact_snapshot,
  checked_exported_interface_artifact_fingerprint_v1,
  checked_exported_interface_artifact_from_checked_program,
  checked_module_typing_artifact_fingerprint_v1,
  checked_module_typing_artifact_v2_matches_exact_inputs,
  decode_checked_module_typing_artifact_v1,
  decode_checked_module_typing_artifact_v2,
  encode_checked_exported_interface_artifact_v1,
  encode_checked_module_typing_artifact_v1,
  encode_checked_module_typing_artifact_v2,
  shadow_unattested_checked_module_typing_artifact_from_checked_program,
  shadow_unattested_checked_module_typing_artifact_v2_from_checked_program
}

import @vibe/compiler/core {
  Expr, Stmt, TypeExpr
}

import @vibe/compiler/runtime {
  ModuleJob,
  check_module,
  check_module_with_typing_artifact_observation,
  checked_module_typing_artifact_construction_attempt_count,
  checked_module_typing_artifact_freshness_attestation_for_job,
  checked_module_typing_artifact_freshness_attestation_snapshot,
  checked_module_typing_artifact_observation,
  checked_module_typing_artifact_observation_is_fresh_for_job,
  checked_module_typing_artifact_validation_attempt_count,
  reset_checked_module_typing_artifact_construction_attempt_count,
  reset_checked_module_typing_artifact_validation_attempt_count
}

import @vibe/compiler/syntax {
  lex
}

import @vibe/core {
  array_empty
}

import ../parser.vibe {
  parse_program
}

fn mt_piece(_ text: String) -> String {
  String::concat(__to_string(String::length(text)), String::concat(":", text))
}

fn mt_dependencies(_ rows: Array[(String, String)]) -> String {
  let out = StringBuilder::new()
  StringBuilder::push(out, value = __to_string(Array::length(rows)))
  StringBuilder::push(out, value = "[")
  let mut i = 0
  while i < Array::length(rows) {
    let (locator, fingerprint) = Array::get(rows, at = i)
    StringBuilder::push(out, value = mt_piece(locator))
    StringBuilder::push(out, value = mt_piece(fingerprint))
    i = i + 1
  }
  StringBuilder::push(out, value = "]")
  StringBuilder::freeze(out)
}

fn mt_closure(_ rows: Array[(String, String, String)]) -> String {
  let out = StringBuilder::new()
  StringBuilder::push(out, value = __to_string(Array::length(rows)))
  StringBuilder::push(out, value = "[")
  let mut i = 0
  while i < Array::length(rows) {
    let (locator, kind, identity) = Array::get(rows, at = i)
    StringBuilder::push(out, value = mt_piece(locator))
    StringBuilder::push(out, value = mt_piece(kind))
    StringBuilder::push(out, value = mt_piece(identity))
    i = i + 1
  }
  StringBuilder::push(out, value = "]")
  StringBuilder::freeze(out)
}

fn mt_outer(_ fields: Array[String]) -> String {
  let out = StringBuilder::new()
  StringBuilder::push(out, value = "vibe-checked-module-typing-artifact:v1\n")
  StringBuilder::push(out, value = __to_string(Array::length(fields)))
  StringBuilder::push(out, value = "[")
  let mut i = 0
  while i < Array::length(fields) {
    StringBuilder::push(out, value = mt_piece(Array::get(fields, at = i)))
    i = i + 1
  }
  StringBuilder::push(out, value = "]")
  StringBuilder::freeze(out)
}

fn mt_valid_fields(_ nested: String) -> Array[String] {
  [
    "singleton_semantic_module",
    "owner",
    "1",
    "owner",
    "provisional_token_stream_v1",
    "1:2:3",
    mt_dependencies([("dep", "1:2:3"), ("dep", "1:2:3")]),
    mt_closure([("owner", "provisional_token_stream_v1", "1:2:3")]),
    nested,
    "typing_errors_only:path,start,end,code,message",
    "vibe-checked-module-typing-artifact:caller-attested-empty-typing-errors:v1",
    "ineligible:lossless_checked_body_unavailable_v1"
  ]
}

// Pre-v2 canonical fixture for the exact owner/identity/empty-dependency input
// used by the compatibility regression. This deliberately spells every field
// instead of sharing mt_valid_fields or the production encoder.
fn mt_v1_empty_dependencies_fields(_ nested: String) -> Array[String] {
  [
    "singleton_semantic_module",
    "owner",
    "1",
    "owner",
    "provisional_token_stream_v1",
    "1:2:3",
    "0[]",
    "1[5:owner27:provisional_token_stream_v15:1:2:3]",
    nested,
    "typing_errors_only:path,start,end,code,message",
    "vibe-checked-module-typing-artifact:caller-attested-empty-typing-errors:v1",
    "ineligible:lossless_checked_body_unavailable_v1"
  ]
}

fn mt_nested_interface(_ stmts: Array[Stmt]) -> String with Exception {
  let checked = check_program_result(stmts)
  match checked_exported_interface_artifact_from_checked_program(checked) {
    Some(artifact) => encode_checked_exported_interface_artifact_v1(artifact),
    None => "<none>"
  }
}

fn mt_build_text(stmts: Array[Stmt], owner: String, kind: String, identity: String, dependencies: Array[(String, String)], closure: Array[(String, String, String)]) -> Option[String] with Exception {
  let checked = check_program_result(stmts)
  match checked_exported_interface_artifact_from_checked_program(checked) {
    Some(interface) => match shadow_unattested_checked_module_typing_artifact_from_checked_program(checked = checked, module_locator = owner, implementation_kind = kind, implementation_identity = identity, dependency_interface_assumptions = dependencies, recorded_implementation_closure = closure, exported_interface = interface) {
      Some(artifact) => Some(encode_checked_module_typing_artifact_v1(artifact)),
      None => None
    },
    None => None
  }
}

fn mt_assert_decode_none(_ text: String) -> Unit {
  match decode_checked_module_typing_artifact_v1(text) {
    Some(_) => assert(false),
    None => assert(true)
  }
}

fn mt_module_job(path: String, source: String) -> ModuleJob {
  ModuleJob::{
    path: path,
    source: source,
    deps: array_empty(),
    dep_fps: array_empty(),
    dep_envs: array_empty(),
    ships_owned_heads: false
  }
}

fn mt_set(fields: Array[String], at: Int, value: String) -> Array[String] {
  let out = array_empty()
  let mut i = 0
  while i < Array::length(fields) {
    if i == at {
      Array::push(out, value = value)
    } else {
      Array::push(out, value = Array::get(fields, at = i))
    }
    i = i + 1
  }
  out
}

test "checked module typing artifact round-trips caller-supplied singleton metadata" {
  let stmts = [SLet(true, false, "api", Some(TyName("Int")), EInt(1))]
  let checked = check_program_result(stmts)
  match checked_exported_interface_artifact_from_checked_program(checked) {
    Some(interface) => match shadow_unattested_checked_module_typing_artifact_from_checked_program(checked = checked, module_locator = "pkg::owner", implementation_kind = "provisional_token_stream_v1", implementation_identity = "1:2:3", dependency_interface_assumptions = [
      ("pkg::dep", checked_exported_interface_artifact_fingerprint_v1(interface))
    ], recorded_implementation_closure = [
      ("pkg::owner", "provisional_token_stream_v1", "1:2:3")
    ], exported_interface = interface) {
      Some(artifact) => {
        let text = encode_checked_module_typing_artifact_v1(artifact)
        match decode_checked_module_typing_artifact_v1(text) {
          Some(decoded) => {
            assert(encode_checked_module_typing_artifact_v1(decoded) == text)
            assert(canonical_checked_module_typing_artifact_snapshot(decoded) == text)
            assert(checked_module_typing_artifact_fingerprint_v1(decoded) == checked_module_typing_artifact_fingerprint_v1(artifact))
            assert(String::contains(text, needle = "singleton_semantic_module"))
            assert(String::contains(text, needle = "typing_errors_only:path,start,end,code,message"))
            assert(String::contains(text, needle = "caller-attested-empty-typing-errors:v1"))
            assert(String::contains(text, needle = "ineligible:lossless_checked_body_unavailable_v1"))
            assert(!String::contains(text, needle = "TypeEnv"))
            assert(!String::contains(text, needle = "typed_ir"))
            assert(!String::contains(text, needle = "source_text"))
            assert(!String::contains(text, needle = "CST"))
            assert(!String::contains(text, needle = "span"))
            assert(!String::contains(text, needle = "mtime"))
            assert(!String::contains(text, needle = "stat_token"))
            assert(!String::contains(text, needle = "cache_fingerprint"))
          },
          None => assert(false)
        }
      },
      None => assert(false)
    },
    None => assert(false)
  }
}

test "manually constructed CheckedProgram can produce an unattested shadow artifact" {
  let checked = check_program_result([
    SLet(true, false, "api", Some(TyName("Int")), EInt(1))
  ])
  let manual = CheckedProgram::{
    checked_stmts: [
      SLet(true, false, "api", Some(TyName("Int")), EString("not checked against copied type state", -1))
    ],
    final_env: checked.final_env,
    type_defs: checked.type_defs,
    final_subst: checked.final_subst,
    typed_occurrences: checked.typed_occurrences
  }
  match checked_exported_interface_artifact_from_checked_program(checked) {
    Some(interface) => match shadow_unattested_checked_module_typing_artifact_from_checked_program(checked = manual, module_locator = "owner", implementation_kind = "validated_metadata_v1", implementation_identity = "1:2:3", dependency_interface_assumptions = array_empty(), recorded_implementation_closure = [
      ("owner", "validated_metadata_v1", "1:2:3")
    ], exported_interface = interface) {
      Some(artifact) => assert(String::length(encode_checked_module_typing_artifact_v1(artifact)) > 0),
      None => assert(false)
    },
    None => assert(false)
  }
}

test "unattested shadow builder requires matching #1548 bytes and propagates missing provenance" {
  let first = check_program_result([SLet(true, false, "api", None, EInt(1))])
  let second = check_program_result([
    SLet(true, false, "api", None, EString("different", -1))
  ])
  match checked_exported_interface_artifact_from_checked_program(second) {
    Some(wrong_interface) => match shadow_unattested_checked_module_typing_artifact_from_checked_program(checked = first, module_locator = "owner", implementation_kind = "validated_metadata_v1", implementation_identity = "1:2:3", dependency_interface_assumptions = array_empty(), recorded_implementation_closure = [
      ("owner", "validated_metadata_v1", "1:2:3")
    ], exported_interface = wrong_interface) {
      Some(_) => assert(false),
      None => assert(true)
    },
    None => assert(false)
  }
  let nested = check_program_result([
    SModule(true, "Public", [SLet(true, false, "value", None, EInt(1))])
  ])
  match checked_exported_interface_artifact_from_checked_program(nested) {
    Some(_) => assert(false),
    None => assert(true)
  }
}

test "own identity and recorded implementation closure change aggregate identity" {
  let stmts = [SLet(true, false, "api", None, EInt(1))]
  let deps = [("dep", "1:2:3")]
  let first = mt_build_text(stmts = stmts, owner = "owner", kind = "validated_metadata_v1", identity = "1:2:3", dependencies = deps, closure = [
    ("owner", "validated_metadata_v1", "1:2:3")
  ])
  let second = mt_build_text(stmts = stmts, owner = "owner", kind = "validated_metadata_v1", identity = "1:2:4", dependencies = deps, closure = [
    ("owner", "validated_metadata_v1", "1:2:4")
  ])
  let closure_changed = mt_build_text(stmts = stmts, owner = "owner", kind = "validated_metadata_v1", identity = "1:2:3", dependencies = deps, closure = [
    ("dep", "validated_metadata_v1", "1:2:5"),
    ("owner", "validated_metadata_v1", "1:2:3")
  ])
  match (first, second, closure_changed) {
    (Some(a), Some(b), Some(c)) => {
      assert(a != b)
      assert(a != c)
      assert(String::contains(a, needle = mt_piece(mt_dependencies(deps))))
      assert(String::contains(c, needle = mt_piece(mt_dependencies(deps))))
    },
    _ => assert(false)
  }
}

test "dependency typing assumptions preserve order and duplicate occurrences" {
  let deps = [("z", "1:2:3"), ("aa", "4:5:6"), ("z", "1:2:3")]
  match mt_build_text(stmts = [SLet(true, false, "api", None, EInt(1))], owner = "owner", kind = "validated_metadata_v1", identity = "1:2:3", dependencies = deps, closure = [
    ("owner", "validated_metadata_v1", "1:2:3")
  ]) {
    Some(text) => {
      assert(String::contains(text, needle = mt_piece(mt_dependencies(deps))))
      match decode_checked_module_typing_artifact_v1(text) {
        Some(decoded) => assert(encode_checked_module_typing_artifact_v1(decoded) == text),
        None => assert(false)
      }
    },
    None => assert(false)
  }
}

test "unattested shadow builder snapshots caller-owned row arrays" {
  let checked = check_program_result([SLet(true, false, "api", None, EInt(1))])
  let dependencies = [("dep", "1:2:3")]
  let closure = [("owner", "validated_metadata_v1", "1:2:3")]
  match checked_exported_interface_artifact_from_checked_program(checked) {
    Some(interface) => match shadow_unattested_checked_module_typing_artifact_from_checked_program(checked = checked, module_locator = "owner", implementation_kind = "validated_metadata_v1", implementation_identity = "1:2:3", dependency_interface_assumptions = dependencies, recorded_implementation_closure = closure, exported_interface = interface) {
      Some(artifact) => {
        let before = encode_checked_module_typing_artifact_v1(artifact)
        Array::set(dependencies, at = 0, value = ("mutated", "9:9:9"))
        Array::set(closure, at = 0, value = ("mutated", "validated_metadata_v1", "mutated"))
        assert(encode_checked_module_typing_artifact_v1(artifact) == before)
      },
      None => assert(false)
    },
    None => assert(false)
  }
}

test "recorded implementation closure sorts lexically and rejects duplicate or inconsistent owners" {
  let stmts = [SLet(true, false, "api", None, EInt(1))]
  let lexical = [
    ("aa", "validated_metadata_v1", "1:2:4"),
    ("b", "validated_metadata_v1", "1:2:3")
  ]
  match mt_build_text(stmts = stmts, owner = "b", kind = "validated_metadata_v1", identity = "1:2:3", dependencies = array_empty(), closure = [
    ("b", "validated_metadata_v1", "1:2:3"),
    ("aa", "validated_metadata_v1", "1:2:4")
  ]) {
    Some(text) => assert(String::contains(text, needle = mt_piece(mt_closure(lexical)))),
    None => assert(false)
  }
  match mt_build_text(stmts = stmts, owner = "owner", kind = "validated_metadata_v1", identity = "1:2:3", dependencies = array_empty(), closure = [
    ("owner", "validated_metadata_v1", "1:2:3"),
    ("owner", "validated_metadata_v1", "1:2:3")
  ]) {
    Some(_) => assert(false),
    None => assert(true)
  }
  match mt_build_text(stmts = stmts, owner = "owner", kind = "validated_metadata_v1", identity = "1:2:3", dependencies = array_empty(), closure = [
    ("other", "validated_metadata_v1", "1:2:3")
  ]) {
    Some(_) => assert(false),
    None => assert(true)
  }
  match mt_build_text(stmts = stmts, owner = "owner", kind = "validated_metadata_v1", identity = "1:2:3", dependencies = array_empty(), closure = [
    ("owner", "validated_metadata_v1", "1:2:4")
  ]) {
    Some(_) => assert(false),
    None => assert(true)
  }
}

test "unattested shadow builder rejects invalid tags locators and compact fingerprints" {
  let stmts = [SLet(true, false, "api", None, EInt(1))]
  match mt_build_text(stmts = stmts, owner = "owner", kind = "typed_ir", identity = "1:2:3", dependencies = array_empty(), closure = [
    ("owner", "typed_ir", "1:2:3")
  ]) {
    Some(_) => assert(false),
    None => assert(true)
  }
  match mt_build_text(stmts = stmts, owner = "owner\nother", kind = "validated_metadata_v1", identity = "1:2:3", dependencies = array_empty(), closure = [
    ("owner\nother", "validated_metadata_v1", "1:2:3")
  ]) {
    Some(_) => assert(false),
    None => assert(true)
  }
  match mt_build_text(stmts = stmts, owner = "owner", kind = "validated_metadata_v1", identity = "1:2:3", dependencies = [
    ("dep", "01:2:3")
  ], closure = [("owner", "validated_metadata_v1", "1:2:3")]) {
    Some(_) => assert(false),
    None => assert(true)
  }
}

test "compact fingerprints enforce positive count and exact hash maxima for own dependency and closure identities" {
  let nested = mt_nested_interface([SLet(true, false, "api", None, EInt(1))])
  let maximum = "1:2147483646:2147483628"
  let first_maximum_plus_one = "1:2147483647:2147483628"
  let second_maximum_plus_one = "1:2147483646:2147483629"
  let fields = mt_set(fields = mt_valid_fields(nested), at = 5, value = maximum)
  let valid = mt_set(fields = mt_set(fields = fields, at = 6, value = mt_dependencies([
    ("dep", maximum)
  ])), at = 7, value = mt_closure([
    ("dep", "validated_metadata_v1", maximum),
    ("owner", "provisional_token_stream_v1", maximum)
  ]))
  match decode_checked_module_typing_artifact_v1(mt_outer(valid)) {
    Some(_) => assert(true),
    None => assert(false)
  }
  mt_assert_decode_none(mt_outer(mt_set(fields = mt_set(fields = valid, at = 5, value = first_maximum_plus_one), at = 7, value = mt_closure([
    ("dep", "validated_metadata_v1", maximum),
    ("owner", "provisional_token_stream_v1", first_maximum_plus_one)
  ]))))
  mt_assert_decode_none(mt_outer(mt_set(fields = mt_set(fields = valid, at = 5, value = second_maximum_plus_one), at = 7, value = mt_closure([
    ("dep", "validated_metadata_v1", maximum),
    ("owner", "provisional_token_stream_v1", second_maximum_plus_one)
  ]))))
  mt_assert_decode_none(mt_outer(mt_set(fields = valid, at = 6, value = mt_dependencies([
    ("dep", first_maximum_plus_one)
  ]))))
  mt_assert_decode_none(mt_outer(mt_set(fields = valid, at = 6, value = mt_dependencies([
    ("dep", second_maximum_plus_one)
  ]))))
  mt_assert_decode_none(mt_outer(mt_set(fields = valid, at = 7, value = mt_closure([
    ("dep", "validated_metadata_v1", first_maximum_plus_one),
    ("owner", "provisional_token_stream_v1", maximum)
  ]))))
  mt_assert_decode_none(mt_outer(mt_set(fields = valid, at = 7, value = mt_closure([
    ("dep", "validated_metadata_v1", second_maximum_plus_one),
    ("owner", "provisional_token_stream_v1", maximum)
  ]))))
  mt_assert_decode_none(mt_outer(mt_set(fields = mt_set(fields = valid, at = 5, value = "0:17:29"), at = 7, value = mt_closure([
    ("dep", "validated_metadata_v1", maximum),
    ("owner", "provisional_token_stream_v1", "0:17:29")
  ]))))
}

test "strict decoder rejects wrong version decimals hostile counts truncation and trailing bytes" {
  let nested = mt_nested_interface([SLet(true, false, "api", None, EInt(1))])
  let canonical = mt_outer(mt_valid_fields(nested))
  match decode_checked_module_typing_artifact_v1(canonical) {
    Some(decoded) => assert(encode_checked_module_typing_artifact_v1(decoded) == canonical),
    None => assert(false)
  }
  let header = "vibe-checked-module-typing-artifact:v1\n"
  let suffix = canonical[String::length(header): String::length(canonical)]
  mt_assert_decode_none(String::concat("vibe-checked-module-typing-artifact:v2\n", suffix))
  mt_assert_decode_none(String::concat(String::concat(header, "012"), canonical[String::length(header) + 2: String::length(canonical)]))
  mt_assert_decode_none("vibe-checked-module-typing-artifact:v1\n12[999999999999999999999999999:")
  mt_assert_decode_none(canonical[0: String::length(canonical) - 1])
  mt_assert_decode_none(String::concat(canonical, "trailing"))
}

test "strict decoder rejects noncanonical structure nested interface and closure order" {
  let nested = mt_nested_interface([SLet(true, false, "api", None, EInt(1))])
  let fields = mt_valid_fields(nested)
  mt_assert_decode_none(mt_outer(mt_set(fields = fields, at = 0, value = "multi_member_scc")))
  mt_assert_decode_none(mt_outer(mt_set(fields = fields, at = 2, value = "2")))
  mt_assert_decode_none(mt_outer(mt_set(fields = fields, at = 3, value = "other")))
  mt_assert_decode_none(mt_outer(mt_set(fields = fields, at = 4, value = "typed_ir")))
  mt_assert_decode_none(mt_outer(mt_set(fields = fields, at = 6, value = "02[]")))
  mt_assert_decode_none(mt_outer(mt_set(fields = fields, at = 6, value = "999999999999999999999999[")))
  mt_assert_decode_none(mt_outer(mt_set(fields = fields, at = 7, value = mt_closure([
    ("owner", "provisional_token_stream_v1", "1:2:3"),
    ("aa", "validated_metadata_v1", "1:2:4")
  ]))))
  mt_assert_decode_none(mt_outer(mt_set(fields = fields, at = 7, value = mt_closure([
    ("owner", "provisional_token_stream_v1", "1:2:3"),
    ("owner", "provisional_token_stream_v1", "1:2:3")
  ]))))
  mt_assert_decode_none(mt_outer(mt_set(fields = fields, at = 8, value = "vibe-checked-exported-interface-artifact:v1\n0[]trailing")))
  mt_assert_decode_none(mt_outer(mt_set(fields = fields, at = 8, value = "vibe-checked-exported-interface-artifact:v2\n0[]")))
}

test "strict decoder accepts only caller-attested empty typing errors and fixed body ineligibility" {
  let nested = mt_nested_interface([SLet(true, false, "api", None, EInt(1))])
  let fields = mt_valid_fields(nested)
  mt_assert_decode_none(mt_outer(mt_set(fields = fields, at = 9, value = "message,path")))
  mt_assert_decode_none(mt_outer(mt_set(fields = fields, at = 10, value = "non-empty:error")))
  mt_assert_decode_none(mt_outer(mt_set(fields = fields, at = 11, value = "TypeEnv-v5:target")))
  mt_assert_decode_none(mt_outer(mt_set(fields = fields, at = 11, value = "typed_ir:fragment")))
}

test "wrapper around genuine checker failure returns no module artifact bytes" {
  let produced = handle {
    let stmts = parse_program(lex("export let bad: Int = \"not an int\"\n"))
    match mt_build_text(stmts = stmts, owner = "owner", kind = "validated_metadata_v1", identity = "1:2:3", dependencies = array_empty(), closure = [
      ("owner", "validated_metadata_v1", "1:2:3")
    ]) {
      Some(bytes) => Some(bytes),
      None => None
    }
  } with { Exception::Throw(_) => None }
  match produced {
    Some(_) => assert(false),
    None => assert(true)
  }
}

test "production module check leaves shadow observation disabled and makes zero construction and validation attempts" {
  reset_checked_module_typing_artifact_construction_attempt_count()
  reset_checked_module_typing_artifact_validation_attempt_count()
  let outcome = check_module(mt_module_job(path = "default.vibe", source = "export let api: Int = 1\n"))
  assert(checked_module_typing_artifact_observation(outcome) == None)
  assert(checked_module_typing_artifact_construction_attempt_count() == 0)
  assert(checked_module_typing_artifact_validation_attempt_count() == 0)
}

test "opaque successful ModuleOutcome carries one canonical v2 artifact after one construction attempt" {
  reset_checked_module_typing_artifact_construction_attempt_count()
  let outcome = check_module_with_typing_artifact_observation(mt_module_job(path = "owner.vibe", source = "export let api: Int = 1\n"))
  assert(checked_module_typing_artifact_construction_attempt_count() == 1)
  match checked_module_typing_artifact_observation(outcome) {
    Some(bytes) => match decode_checked_module_typing_artifact_v2(bytes) {
      Some(artifact) => {
        assert(encode_checked_module_typing_artifact_v2(artifact) == bytes)
        assert(String::contains(bytes, needle = "owner.vibe"))
        assert(String::contains(bytes, needle = "compact_string_fingerprint(ingested_source)"))
        assert(String::contains(bytes, needle = "provisional_token_stream_v1"))
        assert(String::contains(bytes, needle = "ineligible:lossless_checked_body_unavailable_v1"))
      },
      None => assert(false)
    },
    None => assert(false)
  }
}

test "opaque ModuleOutcome publishes nothing and constructs nothing for ordinary type or effect failures" {
  reset_checked_module_typing_artifact_construction_attempt_count()
  let type_failure = check_module_with_typing_artifact_observation(mt_module_job(path = "type_bad.vibe", source = "export let bad: Int = \"not an int\"\n"))
  assert(checked_module_typing_artifact_observation(type_failure) == None)
  assert(checked_module_typing_artifact_construction_attempt_count() == 0)
  let effect_failure = check_module_with_typing_artifact_observation(mt_module_job(path = "effect_bad.vibe", source = "effect Logger { Log(String) -> Unit }\nexport fn bad() -> Int {\n  perform Logger::Log(\"hi\")\n  1\n}\n"))
  assert(checked_module_typing_artifact_observation(effect_failure) == None)
  assert(checked_module_typing_artifact_construction_attempt_count() == 0)
}

test "v2 unattested builder rejects mismatched source implementation and owner closure claims" {
  let checked = check_program_result([SLet(true, false, "api", None, EInt(1))])
  match checked_exported_interface_artifact_from_checked_program(checked) {
    Some(interface) => {
      match shadow_unattested_checked_module_typing_artifact_v2_from_checked_program(checked = checked, module_locator = "owner", observed_source_identity = "1:2:3", recorded_source_identity = "1:2:4", observed_implementation_identity = "1:2:5", recorded_implementation_identity = "1:2:5", dependency_interface_assumptions = array_empty(), recorded_implementation_closure = [
        ("owner", "provisional_token_stream_v1", "1:2:5")
      ], exported_interface = interface) {
        Some(_) => assert(false),
        None => assert(true)
      }
      match shadow_unattested_checked_module_typing_artifact_v2_from_checked_program(checked = checked, module_locator = "owner", observed_source_identity = "1:2:3", recorded_source_identity = "1:2:3", observed_implementation_identity = "1:2:5", recorded_implementation_identity = "1:2:6", dependency_interface_assumptions = array_empty(), recorded_implementation_closure = [
        ("owner", "provisional_token_stream_v1", "1:2:6")
      ], exported_interface = interface) {
        Some(_) => assert(false),
        None => assert(true)
      }
      match shadow_unattested_checked_module_typing_artifact_v2_from_checked_program(checked = checked, module_locator = "owner", observed_source_identity = "1:2:3", recorded_source_identity = "1:2:3", observed_implementation_identity = "1:2:5", recorded_implementation_identity = "1:2:5", dependency_interface_assumptions = array_empty(), recorded_implementation_closure = [
        ("owner", "provisional_token_stream_v1", "1:2:6")
      ], exported_interface = interface) {
        Some(_) => assert(false),
        None => assert(true)
      }
    },
    None => assert(false)
  }
}

test "v1 canonical bytes remain unchanged after v2 introduction" {
  let stmts = [SLet(true, false, "api", None, EInt(1))]
  // mt_outer is a test-owned length-delimited writer; neither it nor the
  // explicit field fixture calls the production v1 encoder under test.
  let expected = mt_outer(mt_v1_empty_dependencies_fields(mt_nested_interface(stmts)))
  match mt_build_text(stmts = stmts, owner = "owner", kind = "provisional_token_stream_v1", identity = "1:2:3", dependencies = array_empty(), closure = [
    ("owner", "provisional_token_stream_v1", "1:2:3")
  ]) {
    Some(bytes) => {
      assert(bytes == expected)
      match decode_checked_module_typing_artifact_v1(bytes) {
        Some(decoded) => assert(encode_checked_module_typing_artifact_v1(decoded) == bytes),
        None => assert(false)
      }
    },
    None => assert(false)
  }
}

test "opaque freshness attestation binds current exact singleton inputs and retained bytes" {
  reset_checked_module_typing_artifact_validation_attempt_count()
  let source = "export let api: Int = 1\n"
  let job = mt_module_job(path = "fresh.vibe", source = source)
  let outcome = check_module_with_typing_artifact_observation(job)
  match (checked_module_typing_artifact_observation(outcome), checked_module_typing_artifact_freshness_attestation_for_job(job = job, outcome = outcome)) {
    (Some(bytes), Some(attestation)) => assert(checked_module_typing_artifact_freshness_attestation_snapshot(attestation) == bytes),
    _ => assert(false)
  }
  assert(checked_module_typing_artifact_validation_attempt_count() == 1)
  // The Bool compatibility API validates through the same opaque path.
  assert(checked_module_typing_artifact_observation_is_fresh_for_job(job = job, outcome = outcome))
}

test "opaque freshness attestation fails closed for stale missing and diagnosed outcomes" {
  let source = "export let api: Int = 1\n"
  let job = mt_module_job(path = "fresh.vibe", source = source)
  let outcome = check_module_with_typing_artifact_observation(job)
  // Exact source identity rejects trivia-only and parser-visible edits.
  assert(checked_module_typing_artifact_freshness_attestation_for_job(job = mt_module_job(path = "fresh.vibe", source = "// changed trivia\nexport let api: Int = 1\n"), outcome = outcome) == None)
  assert(checked_module_typing_artifact_freshness_attestation_for_job(job = mt_module_job(path = "fresh.vibe", source = "export let api: Int = 2\n"), outcome = outcome) == None)
  assert(checked_module_typing_artifact_freshness_attestation_for_job(job = mt_module_job(path = "other.vibe", source = source), outcome = outcome) == None)
  // Ordinary checks retain no bytes, and diagnosed outcomes cannot attest.
  assert(checked_module_typing_artifact_freshness_attestation_for_job(job = job, outcome = check_module(job)) == None)
  let bad_job = mt_module_job(path = "bad.vibe", source = "export let bad: Int = \"no\"\n")
  let diagnosed = check_module_with_typing_artifact_observation(bad_job)
  assert(checked_module_typing_artifact_freshness_attestation_for_job(job = bad_job, outcome = diagnosed) == None)
}

test "strict v2 exact-input matcher rejects stale closure dependencies and non-v2 bytes" {
  inspect(checked_module_typing_artifact_v2_matches_exact_inputs(text = "malformed", module_locator = "owner", source_identity = "1:2:3", implementation_identity = "1:2:5", dependency_interface_assumptions = array_empty()), "false")
  let checked = check_program_result([SLet(true, false, "api", None, EInt(1))])
  match checked_exported_interface_artifact_from_checked_program(checked) {
    Some(interface) => {
      let source_identity = "1:2:3"
      let implementation_identity = "1:2:5"
      match shadow_unattested_checked_module_typing_artifact_v2_from_checked_program(checked = checked, module_locator = "owner", observed_source_identity = source_identity, recorded_source_identity = source_identity, observed_implementation_identity = implementation_identity, recorded_implementation_identity = implementation_identity, dependency_interface_assumptions = [
        ("dep-a", "1:2:7"),
        ("dep-b", "1:2:8")
      ], recorded_implementation_closure = [
        ("owner", "provisional_token_stream_v1", implementation_identity)
      ], exported_interface = interface) {
        Some(artifact) => {
          let bytes = encode_checked_module_typing_artifact_v2(artifact)
          inspect(checked_module_typing_artifact_v2_matches_exact_inputs(text = bytes, module_locator = "owner", source_identity = source_identity, implementation_identity = implementation_identity, dependency_interface_assumptions = [
            ("dep-a", "1:2:7"),
            ("dep-b", "1:2:8")
          ]), "true")
          inspect(checked_module_typing_artifact_v2_matches_exact_inputs(text = bytes, module_locator = "owner", source_identity = source_identity, implementation_identity = implementation_identity, dependency_interface_assumptions = [
            ("dep-b", "1:2:8"),
            ("dep-a", "1:2:7")
          ]), "false")
          inspect(checked_module_typing_artifact_v2_matches_exact_inputs(text = String::concat(bytes, "trailing"), module_locator = "owner", source_identity = source_identity, implementation_identity = implementation_identity, dependency_interface_assumptions = [
            ("dep-a", "1:2:7"),
            ("dep-b", "1:2:8")
          ]), "false")
        },
        None => assert(false)
      }
      match mt_build_text(stmts = [SLet(true, false, "api", None, EInt(1))], owner = "owner", kind = "provisional_token_stream_v1", identity = implementation_identity, dependencies = array_empty(), closure = [
        ("owner", "provisional_token_stream_v1", implementation_identity)
      ]) {
        Some(v1) => assert(!checked_module_typing_artifact_v2_matches_exact_inputs(text = v1, module_locator = "owner", source_identity = source_identity, implementation_identity = implementation_identity, dependency_interface_assumptions = array_empty())),
        None => assert(false)
      }
      match shadow_unattested_checked_module_typing_artifact_v2_from_checked_program(checked = checked, module_locator = "owner", observed_source_identity = source_identity, recorded_source_identity = source_identity, observed_implementation_identity = implementation_identity, recorded_implementation_identity = implementation_identity, dependency_interface_assumptions = array_empty(), recorded_implementation_closure = [
        ("extra", "validated_metadata_v1", "1:2:9"),
        ("owner", "provisional_token_stream_v1", implementation_identity)
      ], exported_interface = interface) {
        Some(artifact) => assert(!checked_module_typing_artifact_v2_matches_exact_inputs(text = encode_checked_module_typing_artifact_v2(artifact), module_locator = "owner", source_identity = source_identity, implementation_identity = implementation_identity, dependency_interface_assumptions = array_empty())),
        None => assert(false)
      }
    },
    None => assert(false)
  }
}

test "later diagnosed outcome cannot reuse a stale successful observation" {
  let successful = check_module_with_typing_artifact_observation(mt_module_job(path = "same.vibe", source = "export let api: Int = 1\n"))
  match checked_module_typing_artifact_observation(successful) {
    Some(_) => assert(true),
    None => assert(false)
  }
  let diagnosed = check_module_with_typing_artifact_observation(mt_module_job(path = "same.vibe", source = "export let api: Int = \"stale\"\n"))
  assert(checked_module_typing_artifact_observation(diagnosed) == None)
}
