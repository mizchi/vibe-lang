//# The pin capacity. Source functions sit in `[0, src_n)` padded to a
//# multiple of 1024, the synthesized region after that, and the lambda slots
//# and every function past the user ones after THAT. An edit that takes the
//# source region across a multiple of 1024 moves all three by a known delta,
//# which the relocation follows.

let bic_b_path: String = "/tmp/vibe_body_cache_bic_b.vibe"

let bic_main_path: String = "/tmp/vibe_body_cache_bic_main.vibe"

/// `n` chained functions, every one reachable from the last.
fn bic_b(_ n: Int) -> String {
  let lines: Array[String] = [
    "import ./vibe_body_cache_bim_a.vibe { bim_eq, bim_one }",
    "export let bic_0: (Int) -> Int = (x) -> { x + bim_one() }"
  ]
  let mut k = 1
  while k < n {
    Array::push(lines, value = "let bic_\{k}: (Int) -> Int = (x) -> { bic_\{k - 1}(x = x) + 1 }")
    k = k + 1
  }
  Array::push(lines, value = "export let bic_top: (Int) -> Int = (x) -> { bic_\{n - 1}(x = x) + (if bim_eq() { 1 } else { 0 }) }")
  String::join(lines, sep = "\n")
}

fn bic_main() -> String {
  String::join([
    "import ./vibe_body_cache_bic_b.vibe { bic_top }",
    "enum BicShape { BicDot; BicLine(Int) }",
    "let apply: ((Int) -> Int, Int) -> Int = (f, x) -> { f(x) }",
    "let run: () -> Int = () -> {",
    "  let k = 2",
    "  let add_k = (x) -> x + k",
    "  apply(f = bic_top, x = 1) + apply(f = add_k, x = 3) + (match BicLine(4) { BicDot => 0, BicLine(n) => n }) + (if [1, 2] == [1, 2] { 1 } else { 0 })",
    "}"
  ], sep = "\n")
}

fn bic_probe(before: Int, after: Int) -> String with Env + Exception + Fs {
  let artifact_path = persistent_artifact_cache_path(kind = "codegen-body-cache", entry_name = "run", fingerprint = codegen_body_cache_artifact_key(bic_main_path))
  if Fs::exists(artifact_path) {
    Fs::remove(artifact_path)
  } else {
    ()
  }
  Fs::write_bytes(bim_a_path, bytes = bif_bytes(bim_a()))
  Fs::write_bytes(bic_b_path, bytes = bif_bytes(bic_b(before)))
  Fs::write_bytes(bic_main_path, bytes = bif_bytes(bic_main()))
  let cold_counts: Array[Int] = []
  let _cold = compile_file_fs_mode_rc_body_cached_counted(entry_path = bic_main_path, entry_name = "run", cache_mode = "on", counts_out = cold_counts)
  Fs::write_bytes(bic_b_path, bytes = bif_bytes(bic_b(after)))
  let warm_counts: Array[Int] = []
  let warm = compile_file_fs_mode_rc_body_cached_counted(entry_path = bic_main_path, entry_name = "run", cache_mode = "on", counts_out = warm_counts)
  let fresh = compile_file_fs_mode_rc(entry_path = bic_main_path, entry_name = "run")
  "cold=\{Array::get(cold_counts, at = 1)} warm=\{Array::get(warm_counts, at = 1)} equal=\{bif_bytes_eq(a = warm, b = fresh)}"
}

/// The row behind the test "a source region that crosses a pin-capacity boundary is relocated"; run at slot widths 0 and 3.
fn bif_row_14() -> Unit with Console + Env + Exception + Fs {
  // 1010 source functions pad to a capacity of 1024; 1030 pad to 2048. The
  // cold build compiles the 1024-slot region plus the synthesized one (1025);
  // after the edit a full recompile would be 2049, and the two unchanged
  // files' four bodies (`bim_eq`, `bim_one`, `apply`, `run`) are relocated
  // instead -- `run` builds a closure, so its lambda slot moved with the
  // base.
  inspect(bic_probe(before = 1010, after = 1030), content = "cold=1025 warm=2045 equal=true")
}

test "a source region that crosses a pin-capacity boundary is relocated" {
  bif_row_14()
}

test "a source region that crosses a pin-capacity boundary is relocated, at slot width 3 (#3941)" {
  bif_at_slot_width(width = 3, row = bif_row_14)
}
