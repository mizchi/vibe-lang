//# Strict checked expression-kind direct-return artifact v1

import @vibe/compiler/checker {
  canonical_checked_expression_kind_direct_return_artifact_snapshot,
  check_program_direct_expression_return_observation,
  check_program_with_env_direct_expression_return_observation,
  checked_expression_kind_direct_return_artifact_expression_path_at,
  checked_expression_kind_direct_return_artifact_from_observation,
  checked_expression_kind_direct_return_artifact_kind_at,
  checked_expression_kind_direct_return_artifact_row_count,
  checked_expression_kind_direct_return_artifact_statement_path_at,
  checked_expression_kind_direct_return_artifact_type_at,
  decode_checked_expression_kind_direct_return_artifact_v1,
  encode_checked_expression_kind_direct_return_artifact_v1
}

import @vibe/compiler/core {
  CtInt, EnvEmpty, Expr, Pat, Stmt, TypeExpr, env_bind
}

import @vibe/core {
  array_empty
}

fn kind_direct_assert_path(actual: Option[Array[Int]], expected: Array[Int]) -> Unit {
  match actual {
    Some(path) => {
      assert(Array::length(path) == Array::length(expected))
      let mut i = 0
      while i < Array::length(path) {
        assert(Array::get(path, i) == Array::get(expected, i))
        i = i + 1
      }
    },
    None => assert(false)
  }
}

fn kind_direct_push_piece(out: StringBuilder, text: String) -> Unit {
  StringBuilder::push(out, __to_string(String::length(text)))
  StringBuilder::push(out, ":")
  StringBuilder::push(out, text)
}

fn kind_direct_push_path(out: StringBuilder, path: Array[Int]) -> Unit {
  StringBuilder::push(out, __to_string(Array::length(path)))
  StringBuilder::push(out, "[")
  let mut i = 0
  while i < Array::length(path) {
    StringBuilder::push(out, __to_string(Array::get(path, i)))
    StringBuilder::push(out, ":")
    i = i + 1
  }
  StringBuilder::push(out, "]")
}

fn kind_direct_entry(statement_path: Array[Int], expression_path: Array[Int], kind: String, ty: String) -> String {
  let out = StringBuilder::new()
  kind_direct_push_path(out, statement_path)
  kind_direct_push_path(out, expression_path)
  kind_direct_push_piece(out, kind)
  kind_direct_push_piece(out, ty)
  StringBuilder::freeze(out)
}

fn kind_direct_payload(entries: Array[String]) -> String {
  let out = StringBuilder::new()
  StringBuilder::push(out, "vibe-checked-expression-kind-direct-return-artifact:v1\n")
  StringBuilder::push(out, __to_string(Array::length(entries)))
  StringBuilder::push(out, "[")
  let mut i = 0
  while i < Array::length(entries) {
    kind_direct_push_piece(out, Array::get(entries, i))
    i = i + 1
  }
  StringBuilder::push(out, "]")
  StringBuilder::freeze(out)
}

fn kind_direct_assert_decode_none(text: String) -> Unit {
  match decode_checked_expression_kind_direct_return_artifact_v1(text) {
    None => (),
    Some(_) => assert(false)
  }
}

fn kind_direct_fixture() -> Array[Stmt] {
  [
    SLet(false, false, "value", None, EIf(EBool(true), ETuple([
      EInt(1),
      EInt(2)
    ]), ETuple([
      EInt(3),
      EInt(4)
    ]))),
    SModule(false, "Nested", [
      SLet(false, false, "identity", None, EFn(array_empty(), array_empty(), [
        ("x", None)
      ], Some(TyName("Int")), None, EIdent("x", 1)))
    ])
  ]
}

test "kind direct-return artifact atomically joins complete mixed preorder" {
  match check_program_direct_expression_return_observation(kind_direct_fixture()) {
    Some(observation) => match checked_expression_kind_direct_return_artifact_from_observation(observation) {
      Some(artifact) => {
        assert(checked_expression_kind_direct_return_artifact_row_count(artifact) == 10)
        assert(String::starts_with(canonical_checked_expression_kind_direct_return_artifact_snapshot(artifact), "vibe-checked-expression-kind-direct-return-artifact:v1\n"))
        kind_direct_assert_path(checked_expression_kind_direct_return_artifact_statement_path_at(artifact, 0), [
          0
        ])
        kind_direct_assert_path(checked_expression_kind_direct_return_artifact_expression_path_at(artifact, 0), array_empty())
        match checked_expression_kind_direct_return_artifact_kind_at(artifact, 0) {
          Some(kind) => assert(kind == "EIf"),
          None => assert(false)
        }
        match checked_expression_kind_direct_return_artifact_kind_at(artifact, 1) {
          Some(kind) => assert(kind == "EBool"),
          None => assert(false)
        }
        kind_direct_assert_path(checked_expression_kind_direct_return_artifact_expression_path_at(artifact, 4), [
          1,
          1
        ])
        match checked_expression_kind_direct_return_artifact_kind_at(artifact, 4) {
          Some(kind) => assert(kind == "EInt"),
          None => assert(false)
        }
        match checked_expression_kind_direct_return_artifact_kind_at(artifact, 9) {
          Some(kind) => assert(kind == "EIdent"),
          None => assert(false)
        }
        match checked_expression_kind_direct_return_artifact_type_at(artifact, 9) {
          Some(ty) => assert(ty == "I0"),
          None => assert(false)
        }
        kind_direct_assert_path(checked_expression_kind_direct_return_artifact_statement_path_at(artifact, 8), [
          1,
          0
        ])
        let encoded = encode_checked_expression_kind_direct_return_artifact_v1(artifact)
        match decode_checked_expression_kind_direct_return_artifact_v1(encoded) {
          Some(decoded) => {
            assert(encode_checked_expression_kind_direct_return_artifact_v1(decoded) == encoded)
            assert(canonical_checked_expression_kind_direct_return_artifact_snapshot(decoded) == canonical_checked_expression_kind_direct_return_artifact_snapshot(artifact))
          },
          None => assert(false)
        }
      },
      None => assert(false)
    },
    None => assert(false)
  }
}

test "kind direct-return artifact preserves nested type-first and effectset topology" {
  let type_first = [
    SModule(false, "Outer", [
      SLet(false, false, "before", None, EIdent("Pick", 70)),
      SEnum(false, "Choice", array_empty(), [
        ("Pick", array_empty())
      ], array_empty()),
      SLet(false, false, "tuple", None, ETuple([
        EInt(1),
        EInt(2)
      ]))
    ])
  ]
  match check_program_direct_expression_return_observation(type_first) {
    Some(observation) => match checked_expression_kind_direct_return_artifact_from_observation(observation) {
      Some(artifact) => {
        assert(checked_expression_kind_direct_return_artifact_row_count(artifact) == 4)
        kind_direct_assert_path(checked_expression_kind_direct_return_artifact_statement_path_at(artifact, 0), [
          0,
          0
        ])
        kind_direct_assert_path(checked_expression_kind_direct_return_artifact_statement_path_at(artifact, 1), [
          0,
          2
        ])
        match checked_expression_kind_direct_return_artifact_kind_at(artifact, 1) {
          Some(kind) => assert(kind == "ETuple"),
          None => assert(false)
        }
      },
      None => assert(false)
    },
    None => assert(false)
  }
  let effectset = [
    SEffectSet(false, "Caps", [
      "Fs",
      "Error"
    ]),
    SLet(false, false, "f", None, EFn(array_empty(), array_empty(), array_empty(), None, Some("Caps"), EIf(EBool(true), EInt(1), EInt(2))))
  ]
  match check_program_direct_expression_return_observation(effectset) {
    Some(observation) => match checked_expression_kind_direct_return_artifact_from_observation(observation) {
      Some(artifact) => {
        assert(checked_expression_kind_direct_return_artifact_row_count(artifact) == 5)
        match checked_expression_kind_direct_return_artifact_kind_at(artifact, 0) {
          Some(kind) => assert(kind == "EFn"),
          None => assert(false)
        }
        match checked_expression_kind_direct_return_artifact_type_at(artifact, 0) {
          Some(ty) => assert(ty == "F22:I014:ER25:Error2:Fs"),
          None => assert(false)
        }
      },
      None => assert(false)
    },
    None => assert(false)
  }
}

test "kind direct-return artifact final substitution zero rows and copy isolation" {
  let identity = [
    SLet(false, false, "identity", None, EFn(array_empty(), array_empty(), [
      ("value", None)
    ], Some(TyName("Int")), None, EIdent("value", 90)))
  ]
  match check_program_direct_expression_return_observation(identity) {
    Some(observation) => match checked_expression_kind_direct_return_artifact_from_observation(observation) {
      Some(artifact) => match checked_expression_kind_direct_return_artifact_type_at(artifact, 1) {
        Some(ty) => assert(ty == "I0"),
        None => assert(false)
      },
      None => assert(false)
    },
    None => assert(false)
  }
  match check_program_direct_expression_return_observation([
    SEnum(false, "OnlyType", array_empty(), [
      ("Only", array_empty())
    ], array_empty())
  ]) {
    Some(observation) => match checked_expression_kind_direct_return_artifact_from_observation(observation) {
      Some(artifact) => assert(encode_checked_expression_kind_direct_return_artifact_v1(artifact) == "vibe-checked-expression-kind-direct-return-artifact:v1\n0[]"),
      None => assert(false)
    },
    None => assert(false)
  }
  let arbitrary = kind_direct_payload([
    kind_direct_entry([
      0,
      2
    ], [
      1
    ], "EStringInterp", "type:[]\n雪")
  ])
  match decode_checked_expression_kind_direct_return_artifact_v1(arbitrary) {
    Some(artifact) => {
      match checked_expression_kind_direct_return_artifact_statement_path_at(artifact, 0) {
        Some(path) => Array::set(path, 0, 99),
        None => assert(false)
      }
      kind_direct_assert_path(checked_expression_kind_direct_return_artifact_statement_path_at(artifact, 0), [
        0,
        2
      ])
      match checked_expression_kind_direct_return_artifact_expression_path_at(artifact, 0) {
        Some(path) => Array::set(path, 0, 88),
        None => assert(false)
      }
      kind_direct_assert_path(checked_expression_kind_direct_return_artifact_expression_path_at(artifact, 0), [
        1
      ])
      match checked_expression_kind_direct_return_artifact_type_at(artifact, 0) {
        Some(ty) => assert(ty == "type:[]\n雪"),
        None => assert(false)
      }
    },
    None => assert(false)
  }
}

test "kind direct-return decoder accepts all tags and rejects noncanonical hostile input" {
  let kinds = [
    "EInt",
    "EFloat",
    "EString",
    "EBool",
    "EIdent",
    "ETuple",
    "EArray",
    "ERecord",
    "EIf",
    "ELet",
    "ELetRec",
    "ELetMut",
    "EAssign",
    "EAssignOp",
    "ESeq",
    "EMatch",
    "EHandle",
    "EWhile",
    "ELoop",
    "EForIn",
    "ECall",
    "EBinOp",
    "EUnaryOp",
    "EFn",
    "EDot",
    "ELabeledArg",
    "EReturn",
    "EBreak",
    "EContinue",
    "EMap",
    "ESpread",
    "EStringInterp",
    "EUnit"
  ]
  let entries = array_empty()
  let mut i = 0
  while i < Array::length(kinds) {
    Array::push(entries, kind_direct_entry([
      i
    ], array_empty(), Array::get(kinds, i), "opaque"))
    i = i + 1
  }
  let all_tags = kind_direct_payload(entries)
  match decode_checked_expression_kind_direct_return_artifact_v1(all_tags) {
    Some(artifact) => assert(encode_checked_expression_kind_direct_return_artifact_v1(artifact) == all_tags),
    None => assert(false)
  }
  let maximum = kind_direct_payload([
    kind_direct_entry([
      2305843009213693951
    ], array_empty(), "EInt", "I0")
  ])
  match decode_checked_expression_kind_direct_return_artifact_v1(maximum) {
    Some(artifact) => assert(encode_checked_expression_kind_direct_return_artifact_v1(artifact) == maximum),
    None => assert(false)
  }
  kind_direct_assert_decode_none("vibe-checked-expression-kind-direct-return-artifact:v2\n0[]")
  kind_direct_assert_decode_none("vibe-checked-expression-kind-direct-return-artifact:v1\n1[")
  kind_direct_assert_decode_none(String::concat("vibe-checked-expression-kind-direct-return-artifact:v1\n0[]", "x"))
  kind_direct_assert_decode_none("vibe-checked-expression-kind-direct-return-artifact:v1\n00[]")
  kind_direct_assert_decode_none(kind_direct_payload([
    "01[0:]0[]4:EInt2:I0"
  ]))
  kind_direct_assert_decode_none(kind_direct_payload([
    "0[]0[]04:EInt2:I0"
  ]))
  kind_direct_assert_decode_none(kind_direct_payload([
    "0[]0[]4:EInt02:I0"
  ]))
  kind_direct_assert_decode_none(kind_direct_payload([
    "0[]0[]4:EInt2305843009213693951:"
  ]))
  kind_direct_assert_decode_none(kind_direct_payload([
    "1[-1:]0[]4:EInt2:I0"
  ]))
  kind_direct_assert_decode_none(kind_direct_payload([
    "1[2305843009213693952:]0[]4:EInt2:I0"
  ]))
  kind_direct_assert_decode_none(kind_direct_payload([
    kind_direct_entry(array_empty(), array_empty(), "EUnknown", "I0")
  ]))
  kind_direct_assert_decode_none("vibe-checked-expression-kind-direct-return-artifact:v1\n2305843009213693951[")
  kind_direct_assert_decode_none(kind_direct_payload([
    "2305843009213693951["
  ]))
  kind_direct_assert_decode_none("vibe-checked-expression-kind-direct-return-artifact:v1\n1[2305843009213693951:")
}

test "kind direct-return artifact has no route for refused upstream observations" {
  let recognized = [
    SLet(false, false, "value", None, ECall(EIdent("Some", 10), [
      EInt(1)
    ], 11))
  ]
  match check_program_direct_expression_return_observation(recognized) {
    None => (),
    Some(_) => assert(false)
  }
  match check_program_direct_expression_return_observation([
    SLet(false, false, "value", None, ESpread(EInt(2)))
  ]) {
    None => (),
    Some(_) => assert(false)
  }
  let synthetic = [
    SLet(false, false, "value", None, EDot(EIdent("mod", 40), "value", 41, 42))
  ]
  match check_program_with_env_direct_expression_return_observation(synthetic, env_bind(EnvEmpty, "mod.value", CtInt)) {
    None => (),
    Some(_) => assert(false)
  }
  let auxiliary = [
    SEffectDef(false, "Ask", array_empty(), [
      ("Get", array_empty(), TyName("Int"))
    ]),
    SLet(false, false, "handled", None, EHandle(EInt(1), [
      (PCtor("Ask::Get", array_empty()), ECall(EIdent("resume", -1), [
        EIdent("outer", 50)
      ], -1))
    ]))
  ]
  match check_program_with_env_direct_expression_return_observation(auxiliary, env_bind(EnvEmpty, "outer", CtInt)) {
    None => (),
    Some(_) => assert(false)
  }
}
