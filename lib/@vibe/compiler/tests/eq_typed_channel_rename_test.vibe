//# Imports

import ./eq_typed_channel_rename_dep.vibe {
  dep_eq_probe
}

//# Functions

// #2441 (Codex round 1 on #2443): the entry declares a DIFFERENT type under
// the dependency's private type's source name. Before the union's
// rename-aware key rebase, the dependency's eq row still said `Point`, and
// the residual rung dispatched THIS Point's `equals` (comparing only `x`,
// equal by construction) on the dependency's values -- measured: `true`
// for the content-unequal pair below.

struct Point {
  x: Int
} derive (Eq)

fn use_local(p: Point) -> Int {
  p.x
}

//# Tests

test "#2443: dep-private type row must not dispatch the entry's same-named equals" {
  inspect(dep_eq_probe(2, 3), content = "false")
}

test "#2443: dep-private type compares its own content" {
  inspect(dep_eq_probe(2, 2), content = "true")
}

test "#2443: the entry's own Point stays usable" {
  inspect(use_local(Point::{ x: 7 }), content = "7")
}
