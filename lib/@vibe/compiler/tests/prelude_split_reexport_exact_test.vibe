import @vibe/compiler/entry/compiler/file_compile {
  ordinary_lane_closure_admits, ordinary_lane_closure_edges, ordinary_lane_split_shape
}

// #2658. The regression the issue asks for: all three shapes in ONE program.
//
//   priv    declares `secret_add`, reached ONLY through a PRIVATE import
//   mid     `import ./priv` -- private, so `priv` must NOT reach `main`
//   leaf    a trait, an impl, and a bounded generic over that trait
//   facade  `export ./leaf` -- a RE-EXPORT, so `leaf` MUST reach `main`
//   main    imports `mid` and `facade` only; never names `priv` or `leaf`
//
// `prelude_split_fs_lane_test.vibe` already pins the re-export half on a
// three-file chain. What it cannot see is the other direction: closing over
// EVERY edge instead of re-export edges only admits `priv` too, and that is
// wrong in the way #2623 reverted -- it hands a module its dependency's
// private imports, which no real compile of it exposes, and it hands every
// module the whole program, which is the live set #2494 exists to bound.
//
// The bounded generic in `leaf` is here as a SHAPE the closure has to carry,
// not as a byte assertion. Measured on this program: the split lane emits a
// module that does not instantiate ("not enough arguments on the stack for
// call (need 3, got 2)") because the caller omits the witness dictionary --
// and it does so for a DIRECT import of `leaf` as well, with a one-edge
// closure. That failure is therefore not about the closure and is tracked on
// its own; asserting bytes here would pin an unrelated defect to this file.
//
// Both errors fail OPEN to the same working program, so bytes cannot tell
// them apart. The observable that can is the closure's SHAPE -- and it has to
// be MEMBERSHIP, not the edge total.
//
// The total does not decide this, which is the whole reason the assertions
// below name modules. Dropping `leaf` from `main`'s row and admitting `priv`
// to it are opposite errors of the same size, so they cancel:
//
//   rule                          main's row              total
//   exact (re-export only)        mid, facade, leaf         5
//   direct edges only             mid, facade               4
//   every edge, transitive        mid, priv, facade, leaf   6
//   BOTH errors at once           mid, facade, priv         5   <- indistinguishable
//
// The last row is a closure that violates both of this issue's requirements
// and sums to exactly what the correct one sums to (Codex on #2814). So the
// total is kept only as a coarse cross-check, and the contract is the four
// membership assertions.
//
// Every name asserted `false` is also asserted `true` somewhere, on purpose:
// `ordinary_lane_closure_admits` answers `false` for a path it cannot resolve
// uniquely, so a typo would otherwise read as "correctly excluded".

fn rx_paths(tag: String) -> (String, String, String, String, String) {
  let priv_p = String::concat("/tmp/vibe_rxx_priv_", String::concat(tag, ".vibe"))
  let mid_p = String::concat("/tmp/vibe_rxx_mid_", String::concat(tag, ".vibe"))
  let leaf_p = String::concat("/tmp/vibe_rxx_leaf_", String::concat(tag, ".vibe"))
  let facade_p = String::concat("/tmp/vibe_rxx_facade_", String::concat(tag, ".vibe"))
  let main_p = String::concat("/tmp/vibe_rxx_main_", String::concat(tag, ".vibe"))
  (priv_p, mid_p, leaf_p, facade_p, main_p)
}

/// Writes the five-module program and returns the entry path.
fn write_three_shape_program(tag: String) -> String with Exception + Fs {
  let (priv_p, mid_p, leaf_p, facade_p, main_p) = rx_paths(tag)
  Fs::write_file(priv_p, "export fn secret_add(a: Int, b: Int) -> Int {\n  a + b\n}\n")
  Fs::write_file(mid_p, String::concat("import ./vibe_rxx_priv_", String::concat(tag, ".vibe {\n  secret_add\n}\n\nexport fn via_mid(n: Int) -> Int {\n  secret_add(n, 1)\n}\n")))
  // The bounded generic is the third shape the issue asks for: `apply_dbl` is
  // rewritten to take a witness dictionary, and the CALLER adds that argument
  // only when the trait is in scope. `main` reaches `Doubler` ONLY across the
  // re-export edge, so this is what makes the edge load-bearing rather than
  // decorative -- a closure that drops it leaves `main` lowering a call into a
  // trait it cannot see. See the header for why that is asserted on the
  // closure's shape here and not on bytes.
  Fs::write_file(leaf_p, "export trait Doubler {\n  dbl(Self) -> Int\n}\n\nexport struct Box {\n  v: Int\n}\n\nimpl Doubler for Box {\n  dbl(b: Box) -> Int {\n    b.v * 2\n  }\n}\n\nexport fn apply_dbl[T: Doubler](x: T) -> Int {\n  T::dbl(x)\n}\n")
  Fs::write_file(facade_p, String::concat("export ./vibe_rxx_leaf_", String::concat(tag, ".vibe {\n  Doubler, Box, apply_dbl\n}\n")))
  let main_tail = String::concat(tag, ".vibe {\n  Doubler, Box, apply_dbl\n}\n\nfn main() -> Int {\n  apply_dbl(Box::{ v: via_mid(20) })\n}\n")
  let main_mid = String::concat(".vibe {\n  via_mid\n}\n\nimport ./vibe_rxx_facade_", main_tail)
  Fs::write_file(main_p, String::concat("import ./vibe_rxx_mid_", String::concat(tag, main_mid)))
  main_p
}

//# Misc — #2658 exact re-export closure

test "2658: the closure admits a re-exported module and excludes a private one" {
  let entry = write_three_shape_program("edges")
  // Non-vacuity first: the lane really does build a five-module split here.
  // Without this a `module_split_none()` fallback would leave every assertion
  // below describing a split that was never taken.
  let (modules, mapped) = ordinary_lane_split_shape(entry)
  inspect(modules, content = "5")
  inspect(mapped > 0, content = "true")
  // The contract, stated as membership so the two errors cannot cancel.
  // ADMITTED: `leaf` reaches `main` only across `facade`'s re-export edge.
  inspect(ordinary_lane_closure_admits(entry, "main_edges.vibe", "leaf_edges.vibe"), content = "true")
  // EXCLUDED: `priv` reaches `mid` by a PRIVATE import, so it must not reach
  // `main`. The row below pins that both names resolve, so this `false` is a
  // real exclusion and not an unresolved lookup.
  inspect(ordinary_lane_closure_admits(entry, "main_edges.vibe", "priv_edges.vibe"), content = "false")
  inspect(ordinary_lane_closure_admits(entry, "mid_edges.vibe", "priv_edges.vibe"), content = "true")
  inspect(ordinary_lane_closure_admits(entry, "main_edges.vibe", "facade_edges.vibe"), content = "true")
  // Coarse cross-check only -- see the header for why this cannot stand alone.
  inspect(ordinary_lane_closure_edges(entry), content = "5")
}
