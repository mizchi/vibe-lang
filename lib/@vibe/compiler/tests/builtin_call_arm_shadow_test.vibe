//# Every by-name call arm yields to the program's own function (#3179)

// The checker types some calls through arms it selects by the callee's
// SPELLING (`Array::get` with two arguments, `Map::get`, `FixedArray::get`,
// ...). Those arms used to take the program's OWN direct calls too, so with
// `fn Array::get(xs: Array[Int], i: Int) -> String` the call
// `Array::get([1, 2], 0) + 1` was typed `Int` and checked clean, while codegen
// called the program's function and added 1 to a string.
//
// The arms are listed in one table (`builtin_call_arms`), and an arm cannot
// fire for a spelling the table does not list. These tests walk the table, so
// every arm is held to it: a program-declared call is typed from the
// declaration, and a compiler-synthesized one (`builtin_ref`) as the builtin.
//
// #3185: eighteen rows used to keep the builtin's typing for every call,
// because a lowering intercepted the spelling ahead of the program's function
// and codegen ran the builtin. Every builtin spelling is now moved aside when
// the program defines it (`rename_builtin_shadow_defs`), so every row yields;
// the test below that ties each row's spelling to that rename is what keeps a
// yielding row honest about the function that actually runs.

//# Imports

import @vibe/compiler/core {
  Expr, Subst, Type, TypeEnv, builtin_shadow_renames_name, env_bind, subst_apply, type_to_string
}

import @vibe/ast {
  builtin_ref_offset
}

import @vibe/core {
  array_empty
}

import @vibe/compiler/checker {
  check_expr
}

import @vibe/compiler/checker/builtin_sigs {
  builtin_call_arms
}

import @vibe/compiler/entry/compiler/fs_compile {
  prepare_modules_cached
}

import ../type_db.vibe {
  db_new
}

//# Functions

fn int_params(_ n: Int) -> Array[Type] {
  let out: Array[Type] = []
  let mut i = 0
  while i < n {
    Array::push(out, value = CtInt)
    i = i + 1
  }
  out
}

fn int_args(_ n: Int) -> Array[Expr] {
  let out: Array[Expr] = []
  let mut i = 0
  while i < n {
    Array::push(out, value = EInt(i))
    i = i + 1
  }
  out
}

/// An environment in which the program declares `name` as
/// `(Int, ..) -> String`: a result no builtin arm gives Int arguments.
fn program_declares(name: String, argc: Int) -> TypeEnv {
  env_bind(env = EnvEmpty, name = name, ty = CtFn(int_params(argc), CtString, None))
}

/// What the checker answers for `name(0, 1, ..)` whose callee carries
/// `callee_off`: the call's type, or the first diagnostic when there is one.
fn call_answer(env: TypeEnv, name: String, argc: Int, callee_off: Int) -> String {
  call_answer_args(env = env, name = name, args = int_args(argc), callee_off = callee_off)
}

/// `call_answer` with the arguments spelled out, for a call that must label
/// its arguments the way the builtin declares them.
fn call_answer_args(env: TypeEnv, name: String, args: Array[Expr], callee_off: Int) -> String {
  let errors: Array[String] = []
  let (ty, s, _) = check_expr(expr = ECall(EIdent(name, callee_off), args, 0, []), env = env, defs = array_empty(), s = SubstEmpty, c = 0, errors = errors, tytab = array_empty())
  if Array::length(errors) > 0 {
    String::concat("error: ", Array::get(errors, at = 0))
  } else {
    type_to_string(subst_apply(s = s, ty = ty))
  }
}

/// The rows of `builtin_call_arms()` whose answer for a call at `callee_off`
/// under the program's declaration disagrees with `expect_declared` (true: the
/// answer must be the declaration's `String`; false: it must not be).
fn rows_answering_wrong(callee_off: Int, expect_declared: Bool, skip: Array[String]) -> String {
  let wrong: Array[String] = []
  for row in builtin_call_arms() {
    let (name, argc) = row
    let skipped = Array::any(skip, f = (s) -> s == name)
    if !skipped {
      let answer = call_answer(env = program_declares(name = name, argc = argc), name = name, argc = argc, callee_off = callee_off)
      if (answer == "String") != expect_declared {
        Array::push(wrong, value = String::concat(name, String::concat(" => ", answer)))
      } else {
        ()
      }
    } else {
      ()
    }
  }
  String::join(wrong, sep = "; ")
}

/// The diagnostic the per-module lane gives `main.vibe`, or "" when it checks
/// clean.
fn diag_of(_ src: String) -> String with Env {
  handle {
    let _ = prepare_modules_cached(db = db_new(), main_path = "main.vibe", main_source = src, sources = [
    ])
    ""
  } with { Exception::Throw(msg) => msg }
}

fn own_array_get() -> String {
  "fn Array::get(xs: Array[Int], i: Int) -> String {\n  let _ = xs\n  let _ = i\n  \"own\"\n}\n\n"
}

//# Tests

test "#3179 the table is not empty" {
  // A table that lost its rows would make the walks below vacuous.
  // MutBytes and MutList dispatch through operation IDs and have separate
  // coverage; the remaining spelling-based families have 45 rows (#3626
  // added `__let_refuted`, the refutable-`let` mismatch arm; #2334 added
  // `Map::has_key`, `Map::has` and `map_has`, whose key the map arms type).
  inspect(Array::length(builtin_call_arms()), content = "45")
}

test "#3185 every arm types the program's own direct call from its declaration" {
  // Before #3185 eighteen rows kept the builtin's typing (`Array::map`,
  // `Map::set`, `FixedArray::make`, `__slice`, `MutList::empty`, ...); red
  // on that checker: this answered their builtin types.
  inspect(rows_answering_wrong(callee_off = 5, expect_declared = true, skip = []), content = "")
}

test "#3185 every arm's spelling is moved aside when the program defines it" {
  // A yielding arm is sound only if codegen calls the program's function for
  // the calls it yields: `rename_builtin_shadow_defs` must list the spelling.
  // `TaskGroup::run` / `spawn` / `spawn_suspend` are library functions no
  // lowering intercepts, so the function table already resolves them to the
  // program's definition.
  let unlisted: Array[String] = []
  for row in builtin_call_arms() {
    let (name, _) = row
    if !builtin_shadow_renames_name(name) && !String::starts_with(name, prefix = "TaskGroup::") {
      Array::push(unlisted, value = name)
    } else {
      ()
    }
  }
  inspect(String::join(unlisted, sep = "; "), content = "")
}

test "#3179 a compiler-synthesized call still takes the builtin arm" {
  // #3146: a `builtin_ref` reference means the builtin whatever the program
  // declares. `TaskGroup::spawn` / `spawn_suspend` are library functions the
  // arm types from the callee's own scheme (#3125), so a synthesized call has
  // no builtin to mean and answers the declaration either way.
  inspect(rows_answering_wrong(callee_off = builtin_ref_offset(), expect_declared = false, skip = [
    "TaskGroup::spawn",
    "TaskGroup::spawn_suspend"
  ]), content = "")
}

test "#3179 an unshadowed spelling still takes its builtin arm" {
  // With no binding of the program, `Array::get(0, 1)` is the builtin's call
  // and its receiver is refused, as before. The index carries its `at` label,
  // so the refusal is about the receiver and not about a missing label.
  assert(String::starts_with(call_answer_args(env = EnvEmpty, name = "Array::get", args = [
    EInt(0),
    ELabeledArg("at", "~", EInt(1))
  ], callee_off = 5), prefix = "error: argument type mismatch for Array::get"))
}

test "#3179 the issue's program: the program's Array::get is typed String on the per-module lane" {
  let bad = String::concat(own_array_get(), "fn f() -> Int {\n  let v = Array::get(xs = [1, 2], i = 0)\n  v + 1\n}\n")
  assert(String::contains(diag_of(bad), needle = "type mismatch in '+'"))
  let ok = String::concat(own_array_get(), "fn f() -> String {\n  Array::get(xs = [1, 2], i = 0)\n}\n")
  inspect(diag_of(ok), content = "")
}

test "#3179 the program's own Array::get charges its own row, not the builtin's" {
  // The effect pass already reads a program definition's row (#2107); the
  // call it charges is the same one the checker now types from that definition.
  let src = "fn Array::get(xs: Array[Int], i: Int) -> String with Console {\n  println(\"own\")\n  let _ = xs\n  let _ = i\n  \"own\"\n}\n\nfn f() -> String {\n  Array::get(xs = [1, 2], i = 0)\n}\n"
  assert(String::contains(diag_of(src), needle = "missing { Console }"))
}

test "#3179 index sugar still reads the builtin under the program's Array::get and __index" {
  let src = String::concat(own_array_get(), "fn __index(a: Int, b: Int) -> String {\n  let _ = a\n  let _ = b\n  \"own\"\n}\n\nfn f() -> Int {\n  let xs = [1, 2]\n  xs[1] + 1\n}\n")
  inspect(diag_of(src), content = "")
}

test "#3185 the slice sugar keeps the builtin under the program's own __slice and __len" {
  // `xs[a:b]` / `xs[a:]` parse to `__slice` / `__len` spelled `builtin_ref`,
  // so a program's own functions of those names answer only its direct calls.
  let src = "fn __slice(a: Int, b: Int, c: Int) -> String {\n  let _ = a\n  let _ = b\n  let _ = c\n  \"own\"\n}\n\nfn __len(a: Int) -> String {\n  let _ = a\n  \"own\"\n}\n\nfn f() -> Int {\n  let xs = [1, 2, 3]\n  let ys = xs[1:]\n  let zs = xs[0:2]\n  Array::length(ys) + Array::length(zs)\n}\n\nfn g() -> String {\n  __slice(a = 1, b = 2, c = 3)\n}\n"
  inspect(diag_of(src), content = "")
}

test "#3185 the field-write sugar keeps the builtin under the program's own __set_field" {
  // `c.v = 5` parses to `__set_field` spelled `builtin_ref`: the write is typed
  // (and `mut`-checked) as the builtin, and the program's function answers
  // only its direct call.
  let src = "struct C {\n  mut v: Int\n}\n\nfn __set_field(a: Int, b: Int, c: Int) -> String {\n  let _ = a\n  let _ = b\n  let _ = c\n  \"own\"\n}\n\nfn f() -> Int {\n  let c = C::{ v: 1 }\n  c.v = 5\n  c.v\n}\n\nfn g() -> String {\n  __set_field(a = 1, b = 2, c = 3)\n}\n"
  inspect(diag_of(src), content = "")
  let immutable = "struct D {\n  v: Int\n}\n\nfn __set_field(a: Int, b: Int, c: Int) -> String {\n  let _ = a\n  let _ = b\n  let _ = c\n  \"own\"\n}\n\nfn f() -> Int {\n  let d = D::{ v: 1 }\n  d.v = 5\n  d.v\n}\n"
  assert(String::contains(diag_of(immutable), needle = "mut"))
}

test "#3185 the region sugar keeps the builtin under the program's own __region_run" {
  let src = "fn __region_run(a: Int) -> String {\n  let _ = a\n  \"own\"\n}\n\nfn f() -> Int {\n  region r {\n    let m = MutList::empty(r)\n    MutList::push(m, 3)\n    MutList::length(m)\n  }\n}\n\nfn g() -> String {\n  __region_run(a = 4)\n}\n"
  inspect(diag_of(src), content = "")
}
