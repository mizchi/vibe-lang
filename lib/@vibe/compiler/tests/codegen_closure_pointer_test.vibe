import ../bytebuf.vibe {
  bytebuf_new, bytebuf_push, bytebuf_push_buf, bytebuf_push_section, bytebuf_push_vec_header, leb128_encode_u32
}

import @vibe/compiler/codegen/builtin_bodies {
  gen_rc_alloc_body
}

import @vibe/compiler/codegen/common_analysis {
  emit_closure_resolve
}

import @vibe/compiler/codegen/wasm_emit {
  emit_code_section_with_locals,
  emit_export_section,
  emit_func_type_raw,
  emit_function_section,
  emit_header,
  emit_i32_const,
  emit_i32_store,
  emit_i64_add,
  emit_i64_const,
  emit_i64_mul,
  emit_local_get,
  emit_local_set,
  emit_memory_section
}

// A heap reference carries one tag bit. An even address need not be divisible
// by four. Decoding must preserve all address bits beyond that tag.
fn closure_pointer_probe(address: Int, tagged: Int) -> Bytes {
  let out = bytebuf_new()
  emit_header(out)
  let types = bytebuf_new()
  bytebuf_push_vec_header(types, 1)
  emit_func_type_raw(types, [], [126])
  bytebuf_push_section(out, 1, types)
  emit_function_section(out, [0])
  emit_memory_section(out, 1)
  emit_export_section(out, "probe", 0)
  let body = bytebuf_new()
  emit_i32_const(body, address)
  emit_i32_const(body, 17)
  emit_i32_store(body, 0, 0)
  emit_i64_const(body, tagged)
  emit_local_set(body, 0)
  emit_closure_resolve(body, 0, 1, 2)
  emit_local_get(body, 1)
  emit_i64_const(body, 10000)
  emit_i64_mul(body)
  emit_local_get(body, 2)
  emit_i64_add(body)
  emit_code_section_with_locals(out, [body], [3])
  out
}

fn check_closure_pointer(address: Int, tagged: Int, expected: String) -> Unit with Fs + Process {
  let path = "/tmp/_closure_pointer_\{tagged}.wasm"
  Fs::write_bytes(path, closure_pointer_probe(address, tagged))
  let output = sh_lines("wasmtime run --invoke probe \{path} 2>/dev/null")
  assert(Array::length(output) == 1)
  assert(String::equals(Array::get(output, 0), expected))
}

test "closure resolution preserves every even heap address" {
  check_closure_pointer(1024, 1025, "171024")
  check_closure_pointer(1026, 1027, "171026")
  check_closure_pointer(1028, 1029, "171028")
  check_closure_pointer(1030, 1031, "171030")
}

test "bare function values still resolve without a closure environment" {
  check_closure_pointer(1024, 2, "0")
  check_closure_pointer(1024, 70, "170000")
}

fn rc_allocator_probe(frontier: Int) -> Bytes {
  let out = bytebuf_new()
  emit_header(out)
  let types = bytebuf_new()
  bytebuf_push_vec_header(types, 1)
  emit_func_type_raw(types, [126], [126])
  bytebuf_push_section(out, 1, types)
  emit_function_section(out, [0])
  emit_memory_section(out, 1)
  let globals = bytebuf_new()
  bytebuf_push_vec_header(globals, 3)
  for initial in [frontier, 0, 0] {
    bytebuf_push(globals, 127)
    bytebuf_push(globals, 1)
    emit_i32_const(globals, initial)
    bytebuf_push(globals, 11)
  }
  bytebuf_push_section(out, 6, globals)
  emit_export_section(out, "allocate", 0)
  let body = bytebuf_new()
  bytebuf_push_vec_header(body, 1)
  leb128_encode_u32(body, 5)
  bytebuf_push(body, 127)
  bytebuf_push_buf(body, gen_rc_alloc_body(false, 1024))
  bytebuf_push(body, 11)
  let code = bytebuf_new()
  bytebuf_push_vec_header(code, 1)
  leb128_encode_u32(code, Bytes::length(body))
  bytebuf_push_buf(code, body)
  bytebuf_push_section(out, 10, code)
  out
}

test "RC allocation aligns a frontier left at any byte offset" {
  let mut offset = 0
  while offset < 8 {
    let path = "/tmp/_rc_allocator_alignment_\{offset}.wasm"
    Fs::write_bytes(path, rc_allocator_probe(4096 + offset))
    let output = sh_lines("wasmtime run --invoke allocate \{path} 24 2>/dev/null")
    assert(Array::length(output) == 1)
    assert(String::equals(Array::get(output, 0), if offset == 0 {
      "4096"
    } else {
      "4104"
    }))
    offset = offset + 1
  }
}

test "RC allocation refuses alignment and end-address overflow" {
  // Constructing the module validates it before the invocation trap is caught.
  // Unit-test workers already have Node; wasm-tools is not installed there.
  let check = "const fs=require('node:fs'); const module=new WebAssembly.Module(fs.readFileSync(process.argv[1])); const instance=new WebAssembly.Instance(module); let trapped=false; try { instance.exports.allocate(24n); } catch (e) { if (!(e instanceof WebAssembly.RuntimeError) || !e.message.includes('unreachable')) throw e; trapped=true; } if (!trapped) throw new Error('allocation did not trap'); console.log('trapped');"
  for frontier in [-1, -8] {
    let path = "/tmp/_rc_allocator_overflow_\{frontier}.wasm"
    Fs::write_bytes(path, rc_allocator_probe(frontier))
    let output = sh_lines("node -e \"\{check}\" \{path}")
    assert(Array::length(output) == 1)
    assert(String::equals(Array::get(output, 0), "trapped"))
  }
}
