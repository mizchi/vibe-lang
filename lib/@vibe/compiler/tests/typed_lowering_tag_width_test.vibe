import @vibe/compiler/checker {
  typed_lowering_enc, typed_lowering_enc_offset, typed_lowering_enc_tag
}

import @vibe/compiler/core {
  resolved_callee_row_rebase
}

/// Phase 1b needs labels beyond the eight existing scalar/callee channels.
test "typed lowering preserves all four tag bits" {
  let mut tag = 0
  while tag < 16 {
    let row = typed_lowering_enc(91, tag)
    assert(typed_lowering_enc_offset(row) == 91)
    assert(typed_lowering_enc_tag(row) == tag)
    tag = tag + 1
  }
}

/// A placement packet's source coordinates move; its argument indices do not.
test "typed lowering rebases placement coordinates but preserves payloads" {
  for tag in [8, 12] {
    assert(resolved_callee_row_rebase(typed_lowering_enc(7, tag), 91) == typed_lowering_enc(98, tag))
  }
  for tag in [9, 10, 11, 13, 14] {
    let row = typed_lowering_enc(7, tag)
    assert(resolved_callee_row_rebase(row, 91) == row)
  }
}
