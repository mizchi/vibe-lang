//# Imports

import @vibe/compiler/syntax {
  Token, lex
}
//# Functions

fn lex_ok(source: String) -> Bool {
  handle {
    let _ = lex(source); true
  } with { Exception::Throw(_) => false }
}

fn lex_len(source: String) -> Int {
  handle {
    Array::length(lex(source))
  } with { Exception::Throw(_) => -1 }
}

//# Misc

test "empty" {
  assert(lex_len("") == 1)
}

test "int" {
  assert(lex_len("42") == 2)
}

test "float" {
  assert(lex_len("3.14") == 2)
}

test "string" {
  assert(lex_len("\"hello\"") == 2)
}

test "bool true" {
  assert(lex_len("true") == 2)
}

test "bool false" {
  assert(lex_len("false") == 2)
}

test "ident" {
  assert(lex_len("foo") == 2)
}

test "hex lower" {
  assert(lex_ok("0xff"))
}

test "hex upper" {
  assert(lex_ok("0xFF"))
}

test "hex prefix upper" {
  assert(lex_ok("0XFF"))
}

test "char a" {
  assert(lex_ok("'a'"))
}

test "char newline" {
  assert(lex_ok("'\\n'"))
}

test "char tab" {
  assert(lex_ok("'\\t'"))
}

test "char backslash" {
  assert(lex_ok("'\\\\'"))
}

test "char quote" {
  assert(lex_ok("'\\''"))
}

test "string escape newline" {
  assert(lex_ok("\"hello\\nworld\""))
}

test "string escape tab" {
  assert(lex_ok("\"hello\\tworld\""))
}

test "string escape quote" {
  assert(lex_ok("\"hello\\\"world\""))
}

test "string escape backslash" {
  assert(lex_ok("\"hello\\\\world\""))
}

test "plus" {
  assert(lex_len("1 + 2") == 4)
}

test "minus" {
  assert(lex_len("1 - 2") == 4)
}

test "star" {
  assert(lex_len("1 * 2") == 4)
}

test "slash" {
  assert(lex_len("1 / 2") == 4)
}

test "percent" {
  assert(lex_len("1 % 2") == 4)
}

test "eqeq" {
  assert(lex_ok("1 == 2"))
}

test "neq" {
  assert(lex_ok("1 != 2"))
}

test "lt" {
  assert(lex_ok("1 < 2"))
}

test "lte" {
  assert(lex_ok("1 <= 2"))
}

test "gt" {
  assert(lex_ok("1 > 2"))
}

test "gte" {
  assert(lex_ok("1 >= 2"))
}

test "and" {
  assert(lex_ok("true && false"))
}

test "or" {
  assert(lex_ok("true || false"))
}

test "not" {
  assert(lex_ok("!true"))
}

test "bit_and" {
  assert(lex_ok("1 & 2"))
}

test "bit_or" {
  assert(lex_ok("1 | 2"))
}

test "bit_xor" {
  assert(lex_ok("1 ^ 2"))
}

test "lshift" {
  assert(lex_ok("1 << 2"))
}

test "rshift" {
  assert(lex_ok("1 >> 2"))
}

test "plus_eq" {
  assert(lex_ok("x += 1"))
}

test "minus_eq" {
  assert(lex_ok("x -= 1"))
}

test "star_eq" {
  assert(lex_ok("x *= 1"))
}

test "slash_eq" {
  assert(lex_ok("x /= 1"))
}

test "percent_eq" {
  assert(lex_ok("x %= 1"))
}

test "parens" {
  assert(lex_ok("(1)"))
}

test "brackets" {
  assert(lex_ok("[1]"))
}

test "braces" {
  assert(lex_ok("{ 1 }"))
}

test "comma" {
  assert(lex_ok("1, 2"))
}

test "semicolon" {
  assert(lex_ok("1; 2"))
}

test "colon" {
  assert(lex_ok("x: Int"))
}

test "double_colon" {
  assert(lex_ok("Foo::bar"))
}

test "dot" {
  assert(lex_ok("x.y"))
}

test "dotdot" {
  assert(lex_ok("0..10"))
}

test "arrow" {
  assert(lex_ok("x => y"))
}

test "thin_arrow" {
  assert(lex_ok("x -> y"))
}

test "pipe" {
  assert(lex_ok("x |> f"))
}

test "let" {
  assert(lex_ok("let x = 1"))
}

test "import" {
  assert(lex_ok("import ./foo { bar }"))
}

test "fn" {
  assert(lex_ok("fn (x) { x }"))
}

test "if" {
  assert(lex_ok("if true { 1 }"))
}

test "else" {
  assert(lex_ok("if true { 1 } else { 0 }"))
}

test "match" {
  assert(lex_ok("match x { _ => 0 }"))
}

test "while" {
  assert(lex_ok("while true { 0 }"))
}

test "for" {
  assert(lex_ok("for x in arr { x }"))
}

test "break" {
  assert(lex_ok("break"))
}

test "continue" {
  assert(lex_ok("continue"))
}

test "enum" {
  assert(lex_ok("enum Foo { A }"))
}

test "struct" {
  assert(lex_ok("struct Foo { x: Int }"))
}

test "type" {
  assert(lex_ok("type Foo = Int"))
}

test "trait" {
  assert(lex_ok("trait Eq"))
}

test "export" {
  assert(lex_ok("export { foo }"))
}

test "test" {
  assert(lex_ok("test \"name\" { assert(true) }"))
}

test "alias ref" {
  assert(lex_ok("@foo"))
}

test "alias import" {
  assert(lex_ok("import @foo { bar }"))
}
