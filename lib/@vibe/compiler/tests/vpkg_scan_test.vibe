//# Imports

// #897 (ADR-0070 Phase 1): `find_missing_vpkg_dirs`/`check_missing_vpkg_dirs`
// (loader/index.vibe) power `vibe check --missing-vpkg <root>`
// (VIBE_MISSING_VPKG_SCAN=1 in cli_adapter.vibe's cli_main) --
// recursively report every directory under a root that still has
// index.vibei or bare index.vibe but not yet index.vpkg.

import @vibe/compiler/loader {
  check_missing_vpkg_dirs, find_missing_vpkg_dirs
}

//# Functions

fn string_to_bytes(s: String) -> Bytes {
  let out = Array::slice([
    0
  ], 0, 0)
  let len = String::length(s)
  let mut i = 0
  while i < len {
    Array::push(out, String::char_code_at(s, i))
    i = i + 1
  }
  Bytes::from_array(out)
}

fn string_array_contains(items: Array[String], target: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(items) && !found {
    if Array::get(items, i) == target {
      found = true
    } else {
      i = i + 1
    }
    i
  }
  found
}

//# Misc

test "find_missing_vpkg_dirs flags an index.vibei-only directory (#897)" {
  let base_dir = "/tmp/vibe_compiler_vpkg_scan_897_vibei"
  Fs::mkdir_p(base_dir)
  Fs::write_bytes(String::concat(base_dir, "/index.vibei"), string_to_bytes("import ./impl.vibe {}\n\nfn add(x: Int, y: Int) -> Int\n"))
  Fs::write_bytes(String::concat(base_dir, "/impl.vibe"), string_to_bytes("export fn add(x: Int, y: Int) -> Int { x + y }\n"))
  let missing = find_missing_vpkg_dirs(base_dir)
  assert(string_array_contains(missing, base_dir))
}

test "find_missing_vpkg_dirs is clean for a directory that already has index.vpkg (#897)" {
  let base_dir = "/tmp/vibe_compiler_vpkg_scan_897_clean"
  Fs::mkdir_p(base_dir)
  Fs::write_bytes(String::concat(base_dir, "/index.vpkg"), string_to_bytes("import ./impl.vibe {}\n\nfn add(x: Int, y: Int) -> Int\n"))
  Fs::write_bytes(String::concat(base_dir, "/impl.vibe"), string_to_bytes("export fn add(x: Int, y: Int) -> Int { x + y }\n"))
  let missing = find_missing_vpkg_dirs(base_dir)
  assert(!string_array_contains(missing, base_dir))
}

test "find_missing_vpkg_dirs recurses into nested boundaries and skips vendored/build dirs (#897)" {
  let base_dir = "/tmp/vibe_compiler_vpkg_scan_897_nested"
  let nested_dir = String::concat(base_dir, "/nested")
  let build_dir = String::concat(base_dir, "/_build")
  let deps_dir = String::concat(base_dir, "/deps")
  Fs::mkdir_p(nested_dir)
  Fs::mkdir_p(build_dir)
  Fs::mkdir_p(deps_dir)
  // Root has a clean .vpkg boundary.
  Fs::write_bytes(String::concat(base_dir, "/index.vpkg"), string_to_bytes("import ./nested {}\n"))
  // A nested sub-boundary still on the bare index.vibe spelling -- must
  // still be found even though the ROOT is already migrated.
  Fs::write_bytes(String::concat(nested_dir, "/index.vibe"), string_to_bytes("export fn helper(x: Int) -> Int { x }\n"))
  // A _build/ sibling with its OWN index.vibei -- must be skipped entirely
  // (vendored/build output is never part of this repo's migration surface).
  Fs::write_bytes(String::concat(build_dir, "/index.vibei"), string_to_bytes("import ./impl.vibe {}\n\nfn add(x: Int, y: Int) -> Int\n"))
  Fs::write_bytes(String::concat(build_dir, "/impl.vibe"), string_to_bytes("export fn add(x: Int, y: Int) -> Int { x + y }\n"))
  // A deps/ sibling (vibe fetch's vendored-dependency dir) with its OWN
  // index.vibei -- must also be skipped (Codex review, PR #910): third-party
  // vendored packages are never part of this repo's own migration surface.
  Fs::write_bytes(String::concat(deps_dir, "/index.vibei"), string_to_bytes("import ./impl.vibe {}\n\nfn add(x: Int, y: Int) -> Int\n"))
  Fs::write_bytes(String::concat(deps_dir, "/impl.vibe"), string_to_bytes("export fn add(x: Int, y: Int) -> Int { x + y }\n"))
  let missing = find_missing_vpkg_dirs(base_dir)
  assert(!string_array_contains(missing, base_dir))
  assert(string_array_contains(missing, nested_dir))
  assert(!string_array_contains(missing, build_dir))
  assert(!string_array_contains(missing, deps_dir))
}

test "check_missing_vpkg_dirs throws listing the offending directory, returns 0 when clean (#897)" {
  let clean_dir = "/tmp/vibe_compiler_vpkg_scan_897_check_clean"
  Fs::mkdir_p(clean_dir)
  Fs::write_bytes(String::concat(clean_dir, "/index.vpkg"), string_to_bytes("fn add(x: Int, y: Int) -> Int\n"))
  assert_eq(check_missing_vpkg_dirs(clean_dir), 0)
  let dirty_dir = "/tmp/vibe_compiler_vpkg_scan_897_check_dirty"
  Fs::mkdir_p(dirty_dir)
  Fs::write_bytes(String::concat(dirty_dir, "/index.vibei"), string_to_bytes("import ./impl.vibe {}\n\nfn add(x: Int, y: Int) -> Int\n"))
  Fs::write_bytes(String::concat(dirty_dir, "/impl.vibe"), string_to_bytes("export fn add(x: Int, y: Int) -> Int { x + y }\n"))
  let failed = handle {
    let _ = check_missing_vpkg_dirs(dirty_dir)
    false
  } with Exception {
    Throw(msg) => String::contains(msg, "missing index.vpkg") && String::contains(msg, dirty_dir)
  }
  assert(failed)
}
