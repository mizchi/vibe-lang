//# ADR-0088: `vibe normalize` keeps the row a test / bench / example block grants

import @vibe/compiler/normalize {
  normalize_source
}

test "ADR-0088 (Codex on #2653): normalize keeps a block's allows row" {
  // The rows live in the parse's trailing marker, and the renderer prints
  // statement by statement; before register_block_rows it dropped every one,
  // so a normalized `example "x" allows Http` had silently lost its grant.
  let src = "example \"x\" allows Http {\n  assert(true)\n}\n\ntest \"y\" allows Fs::read_file + Exception {\n  assert(true)\n}\n\nbench \"z\" allows () {\n  ()\n}\n"
  let out = normalize_source(src)
  assert(String::contains(out, "example \"x\" allows Http {"))
  assert(String::contains(out, "test \"y\" allows Fs::read_file + Exception {"))
  assert(String::contains(out, "bench \"z\" allows () {"))
  assert_eq(normalize_source(out), out)
}
