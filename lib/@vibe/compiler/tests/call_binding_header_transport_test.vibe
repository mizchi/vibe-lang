import @vibe/parser {
  lex_with_offsets, parse_program_located
}

import @vibe/compiler/core {
  BindingOrigin,
  EnvValueBinding,
  Expr,
  Stmt,
  Subst,
  Type,
  TypeDef,
  TypeEnv,
  env_bind,
  env_bind_with_origin,
  env_cache,
  env_cached,
  env_lookup_binding,
  env_lookup_binding_including_surface,
  env_type_definition_origin
}

import @vibe/compiler/checker {
  CheckedProgram,
  check_program_with_env_typed_lowering_located_observation,
  checker_call_header_defaults,
  checker_call_header_has_optional,
  checker_call_header_names
}

import @vibe/compiler/checker/artifacts/program {
  decode_checked_program, encode_checked_program
}

import @vibe/compiler/runtime {
  parse_persistent_type_env, persistent_type_env_cache_text
}

import @vibe/compiler/checker/builtin_sigs {
  builtin_resolves_at
}

fn header_type() -> Type {
  CtFn([CtInt, CtOption(CtInt)], CtInt, None)
}

fn assert_header(_ env: TypeEnv) -> Unit {
  match env_lookup_binding(env = env, name = "f") {
    Some(binding) => assert(binding.origin == BindingOriginFunctionHeader([
      "second",
      "first?"
    ])),
    None => assert(false)
  }
}

/// The actual binding owns its header, including when a cache answers lookup.
test "a same-typed value shadow does not inherit a declaration header" {
  let env = env_cache(env_bind_with_origin(env = EnvEmpty, name = "f", ty = header_type(), origin = BindingOriginFunctionHeader([
    "second",
    "first?"
  ])))
  assert_header(env)
  let shadow = env_bind(env = env, name = "f", ty = header_type())
  match env_lookup_binding(env = shadow, name = "f") {
    Some(binding) => assert(binding.origin == BindingOriginUnavailable),
    None => assert(false)
  }
  assert_header(env)
}

/// Persistent environments retain declaration names independently of the type.
test "persistent environment carries the resolved function header" {
  let env = env_cache(env_bind_with_origin(env = EnvEmpty, name = "f", ty = header_type(), origin = BindingOriginFunctionHeader([
    "second",
    "first?"
  ])))
  let encoded = persistent_type_env_cache_text(env)
  match parse_persistent_type_env(encoded) {
    Some(decoded) => {
      assert_header(decoded)
      assert(persistent_type_env_cache_text(decoded) == encoded)
    },
    None => assert(false)
  }
}

/// A checked artifact owns header bytes, rather than a mutable caller array.
test "checked program seals local function headers with its environment" {
  let names = ["second", "first?"]
  let original = CheckedProgram::{
    checked_stmts: [SExpr(EInt(0))],
    final_env: env_bind_with_origin(env = EnvEmpty, name = "f", ty = header_type(), origin = BindingOriginFunctionHeader(names)),
    type_defs: [],
    final_subst: SubstEmpty,
    typed_occurrences: []
  }
  let encoded = encode_checked_program(original)
  Array::set(names, at = 0, value = "changed")
  assert(encode_checked_program(original) != encoded)
  match decode_checked_program(encoded) {
    Some(decoded) => {
      assert_header(decoded.final_env)
      assert(encode_checked_program(decoded) == encoded)
    },
    None => assert(false)
  }
}

/// Default bits follow the actual binding through persistent contexts and
/// checked-program transport, instead of being recovered from its spelling.
test "defaulted declaration headers survive both environment transports" {
  let env = env_cache(env_bind_with_origin(env = EnvEmpty, name = "f", ty = header_type(), origin = BindingOriginDefaultedFunctionHeader([
    "x",
    "y?"
  ], [false, true])))
  assert(checker_call_header_defaults(env = env, name = "f") == Some([
    false,
    true
  ]))
  match parse_persistent_type_env(persistent_type_env_cache_text(env)) {
    Some(decoded) => assert(checker_call_header_defaults(env = decoded, name = "f") == Some([
      false,
      true
    ])),
    None => assert(false)
  }
  let checked = CheckedProgram::{
    checked_stmts: [],
    final_env: env,
    type_defs: [],
    final_subst: SubstEmpty,
    typed_occurrences: []
  }
  match decode_checked_program(encode_checked_program(checked)) {
    Some(decoded) => assert(checker_call_header_defaults(env = decoded.final_env, name = "f") == Some([
      false,
      true
    ])),
    None => assert(false)
  }
  assert(checker_call_header_defaults(env = env_bind(env = env, name = "f", ty = header_type()), name = "f") == None)
}

/// A cache cannot invent a default bit for an absent parameter or carry an
/// empty fact as a different spelling of an ordinary declaration header.
test "defaulted header transports refuse malformed flag vectors" {
  for flags in [[true], [false, false]] {
    let env = env_bind_with_origin(env = EnvEmpty, name = "f", ty = header_type(), origin = BindingOriginDefaultedFunctionHeader([
      "x",
      "y?"
    ], flags))
    let checked = CheckedProgram::{
      checked_stmts: [],
      final_env: env,
      type_defs: [],
      final_subst: SubstEmpty,
      typed_occurrences: []
    }
    assert(decode_checked_program(encode_checked_program(checked)) == None)
    let parsed = handle {
      parse_persistent_type_env(persistent_type_env_cache_text(env))
    } with { Exception::Throw(_) => None }
    assert(parsed == None)
  }
}

/// A real declaration publishes default facts while rebinding its inferred
/// type, so later calls and cached environments observe the same owner.
test "checking a declaration retains its parser-owned default bits" {
  let source = "fn f(x: Int, y: Int = 3) -> Int { x }"
  let (tokens, starts, _) = lex_with_offsets(source)
  let stmts = parse_program_located(tokens = tokens, starts = starts, source = source)
  let (checked, _, _, _) = check_program_with_env_typed_lowering_located_observation(stmts = stmts, initial_env = EnvEmpty, checked_error_row = false)
  assert(checker_call_header_defaults(env = checked.final_env, name = "f") == Some([
    false,
    true
  ]))
}

/// Optional demand follows the actual value binding and the nearest imported marker.
test "optional header demand cannot inherit a shadowed declaration" {
  let local = env_cache(env_bind_with_origin(env = EnvEmpty, name = "f", ty = header_type(), origin = BindingOriginFunctionHeader([
    "value",
    "extra?"
  ])))
  assert(checker_call_header_has_optional(env = local, name = "f"))
  assert(!checker_call_header_has_optional(env = env_bind(env = local, name = "f", ty = header_type()), name = "f"))
  let imported = env_bind(env = env_bind_with_origin(env = EnvEmpty, name = "f", ty = header_type(), origin = BindingOriginModuleExport("dep.vibe", "f")), name = "#params:f", ty = CtRecord([
    ("value", CtUnit),
    ("extra?", CtUnit)
  ]))
  assert(checker_call_header_has_optional(env = imported, name = "f"))
  assert(!checker_call_header_has_optional(env = env_bind(env = imported, name = "#params:f", ty = CtUnit), name = "f"))
  let positional = env_bind(env = env_bind_with_origin(env = EnvEmpty, name = "f", ty = header_type(), origin = BindingOriginModuleExport("dep.vibe", "f")), name = "#params:f", ty = CtRecord([
    ("value", CtUnit),
    ("extra", CtUnit)
  ]))
  assert(!checker_call_header_has_optional(env = positional, name = "f"))
}

fn assert_imported_header(env: TypeEnv, expected: BindingOrigin, surface: Bool) -> Unit {
  match env_lookup_binding_including_surface(env = env, name = "f") {
    Some(binding) => assert(binding.origin == expected),
    None => assert(false)
  }
  if surface {
    assert(env_lookup_binding(env = env, name = "f") is None)
    assert(checker_call_header_names(env = env, name = "f") is None)
    assert(!checker_call_header_has_optional(env = env, name = "f"))
  } else {
    assert(checker_call_header_names(env = env, name = "f") == Some([
      "second",
      "first?"
    ]))
    assert(checker_call_header_has_optional(env = env, name = "f"))
    assert(checker_call_header_names(env = env_bind(env = env, name = "f", ty = header_type()), name = "f") is None)
  }
}

/// Module identity and declaration names survive both transports without marker bindings.
test "imported headers retain module identity and surface barriers in caches" {
  let origins = [
    BindingOriginModuleFunctionHeader("dep.vibe", "original", [
      "second",
      "first?"
    ], []),
    BindingOriginReExportFunctionHeader("dep.vibe", "original", [
      "second",
      "first?"
    ], [])
  ]
  let mut i = 0
  while i < Array::length(origins) {
    let origin = Array::get(origins, at = i)
    let env = env_cache(env_bind_with_origin(env = EnvEmpty, name = "f", ty = header_type(), origin = origin))
    assert_imported_header(env = env, expected = origin, surface = i == 1)
    match parse_persistent_type_env(persistent_type_env_cache_text(env)) {
      Some(decoded) => assert_imported_header(env = decoded, expected = origin, surface = i == 1),
      None => assert(false)
    }
    let checked = CheckedProgram::{
      checked_stmts: [],
      final_env: env,
      type_defs: [],
      final_subst: SubstEmpty,
      typed_occurrences: []
    }
    match decode_checked_program(encode_checked_program(checked)) {
      Some(decoded) => assert_imported_header(env = decoded.final_env, expected = origin, surface = i == 1),
      None => assert(false)
    }
    i = i + 1
  }
}

/// #3440: an imported declaration's parameter-default bits ride on its
/// header through both transports, so an importer refuses a written `None`
/// for a defaulted parameter. A re-export is a surface, not a binder, so its
/// bits are checked on the binding itself; a header without defaults answers
/// `None`.
fn assert_default_bits(env: TypeEnv, origin: BindingOrigin, surface: Bool) -> Unit {
  match env_lookup_binding_including_surface(env = env, name = "f") {
    Some(binding) => assert(binding.origin == origin),
    None => assert(false)
  }
  if surface {
    ()
  } else {
    assert(checker_call_header_defaults(env = env, name = "f") == Some([
      false,
      true
    ]))
  }
}

test "imported headers retain their parameter-default bits in caches" {
  let origins = [
    BindingOriginModuleFunctionHeader("dep.vibe", "original", ["x", "y?"], [
      false,
      true
    ]),
    BindingOriginReExportFunctionHeader("dep.vibe", "original", ["x", "y?"], [
      false,
      true
    ])
  ]
  let mut i = 0
  while i < Array::length(origins) {
    let origin = Array::get(origins, at = i)
    let env = env_cache(env_bind_with_origin(env = EnvEmpty, name = "f", ty = header_type(), origin = origin))
    assert_default_bits(env = env, origin = origin, surface = i == 1)
    match parse_persistent_type_env(persistent_type_env_cache_text(env)) {
      Some(decoded) => assert_default_bits(env = decoded, origin = origin, surface = i == 1),
      None => assert(false)
    }
    let checked = CheckedProgram::{
      checked_stmts: [],
      final_env: env,
      type_defs: [],
      final_subst: SubstEmpty,
      typed_occurrences: []
    }
    match decode_checked_program(encode_checked_program(checked)) {
      Some(decoded) => assert_default_bits(env = decoded.final_env, origin = origin, surface = i == 1),
      None => assert(false)
    }
    i = i + 1
  }
  let plain = env_bind_with_origin(env = EnvEmpty, name = "f", ty = header_type(), origin = BindingOriginModuleFunctionHeader("dep.vibe", "original", [
    "x",
    "y?"
  ], []))
  assert(checker_call_header_defaults(env = plain, name = "f") == None)
}

/// A cache cannot invent a default bit for an imported header's absent
/// parameter, or carry an all-false vector as a second spelling of none.
test "imported header transports refuse malformed default bits" {
  for flags in [[true], [false, false]] {
    let env = env_bind_with_origin(env = EnvEmpty, name = "f", ty = header_type(), origin = BindingOriginModuleFunctionHeader("dep.vibe", "original", [
      "x",
      "y?"
    ], flags))
    let checked = CheckedProgram::{
      checked_stmts: [],
      final_env: env,
      type_defs: [],
      final_subst: SubstEmpty,
      typed_occurrences: []
    }
    assert(decode_checked_program(encode_checked_program(checked)) == None)
    let parsed = handle {
      parse_persistent_type_env(persistent_type_env_cache_text(env))
    } with { Exception::Throw(_) => None }
    assert(parsed == None)
  }; ()
}

/// A callable constructor's parameter names are not part of nominal type identity.
test "imported callable headers preserve the type declaration's module origin" {
  let definitions = EnvTypeDefs([TDStruct("Box", [("value", CtInt)], [], [])], [
    "Box"
  ], EnvEmpty)
  let env = env_bind_with_origin(env = definitions, name = "Box", ty = CtFn([
    CtInt
  ], CtStruct("Box"), None), origin = BindingOriginModuleFunctionHeader("dep.vibe", "Box", [
    "value"
  ], []))
  assert(env_type_definition_origin(env = env, name = "Box") == Some(BindingOriginModuleExport("dep.vibe", "Box")))
}

/// A derived cache index cannot turn a published callable surface into a binder.
test "imported callable surfaces preserve builtin resolution authority" {
  let name = "String::length"
  let origin = BindingOriginReExportFunctionHeader("dep.vibe", "length", [
    "value"
  ], [])
  let binding = EnvValueBinding::{ ty: CtUnknown, origin: origin }
  let actual = env_bind_with_origin(env = EnvEmpty, name = name, ty = CtUnknown, origin = origin)
  assert(!builtin_resolves_at(env = actual, name = name, ident_off = 10))
  assert(!builtin_resolves_at(env = env_cache(actual), name = name, ident_off = 10))
  let accelerator_only = env_cached(names = [name], bindings = [binding], rest = EnvEmpty)
  assert(builtin_resolves_at(env = accelerator_only, name = name, ident_off = 10))
  let imported = env_bind_with_origin(env = EnvEmpty, name = name, ty = header_type(), origin = BindingOriginModuleFunctionHeader("dep.vibe", "length", [
    "value"
  ], []))
  assert(!builtin_resolves_at(env = imported, name = name, ident_off = 10))
}
