//# Imports

import @vibe/compiler/core {
  BindingOrigin,
  Expr,
  Stmt,
  Subst,
  Type,
  TypeDef,
  TypeEnv,
  TypeExpr,
  env_bind,
  env_bind_with_origin,
  env_cache,
  env_cached,
  env_lookup,
  env_value_binding,
  subst_add_bound,
  subst_apply,
  type_to_string,
  types_equal
}

import @vibe/compiler/checker {
  check_expr,
  check_program,
  check_program_result,
  check_program_type_defs_observation,
  check_program_with_env,
  check_program_with_env_result,
  check_program_with_env_type_defs_observation
}

import @vibe/core {
  array_empty
}

//# Helpers

fn occurrences_apply_final_subst(occurrences: Array[(Int, Type)], subst: Subst) -> Bool {
  let mut i = 0
  while i < Array::length(occurrences) {
    let (_, ty) = Array::get(occurrences, at = i)
    let _ = subst_apply(s = subst, ty = ty)
    i = i + 1
  }
  true
}

fn assert_int_binding(env: TypeEnv, name: String) -> Unit {
  match env_lookup(env = env, name = name) {
    Some(ty) => assert(types_equal(a = ty, b = CtInt)),
    None => assert(false)
  }
}

fn assert_typed_occurrences(actual: Array[(Int, Type)], expected: Array[(Int, Type)]) -> Unit {
  assert(Array::length(actual) == Array::length(expected))
  let mut i = 0
  while i < Array::length(expected) {
    let (actual_offset, actual_type) = Array::get(actual, at = i)
    let (expected_offset, expected_type) = Array::get(expected, at = i)
    assert(actual_offset == expected_offset)
    assert(types_equal(a = actual_type, b = expected_type))
    i = i + 1
  }
}

fn check_expr_occurrences(expr: Expr, env: TypeEnv, defs: Array[TypeDef]) -> Array[(Int, Type)] {
  let errors = array_empty()
  let tytab = array_empty()
  let _ = check_expr(expr = expr, env = env, defs = defs, s = SubstEmpty, c = 0, errors = errors, tytab = tytab)
  assert(Array::length(errors) == 0)
  tytab
}

fn array_length_expr() -> Expr {
  ECall(EIdent("Array::length", 1), [EArray([EInt(1)])], 10, [])
}

fn trait_header_params(env: TypeEnv, wanted: String) -> Array[String] {
  match env {
    EnvEmpty => array_empty(),
    EnvBind(_, _, rest) => trait_header_params(env = rest, wanted = wanted),
    EnvTraitDef(name, _, _, _, rest, params, _) => if name == wanted {
      params
    } else {
      trait_header_params(env = rest, wanted = wanted)
    },
    EnvTraitImpl(_, _, rest) => trait_header_params(env = rest, wanted = wanted),
    EnvShowWrappers(_, _, rest) => trait_header_params(env = rest, wanted = wanted),
    EnvMutCell(_, _, rest) => trait_header_params(env = rest, wanted = wanted),
    EnvTraitImplGen(_, _, _, _, rest) => trait_header_params(env = rest, wanted = wanted),
    EnvTypeDefs(_, _, rest) => trait_header_params(env = rest, wanted = wanted),
    EnvFlat(_) => array_empty(),
    EnvCached(_, _, rest) => trait_header_params(env = rest, wanted = wanted)
  }
}

//# Successful production-check boundary

test "check_program_result retains production outputs" {
  let stmts = [
    SStruct(false, "Point", [("x", TyName("Int"))], array_empty(), array_empty(), array_empty()),
    SLet(false, false, "value", None, array_length_expr())
  ]
  let checked = check_program_result(stmts)
  // The retained statements are the production checker's post-desugar input.
  assert(Array::length(checked.checked_stmts) == 2)
  match Array::get(checked.checked_stmts, at = 0) {
    SStruct(_, "Point", _, _, _, _) => assert(true),
    _ => assert(false)
  }
  assert_int_binding(env = checked.final_env, name = "value")
  match Array::get(checked.type_defs, at = 0) {
    TDStruct("Point", fields, _, _) => assert(Array::length(fields) == 1),
    _ => assert(false)
  }
  match checked.final_subst {
    SubstEmpty => assert(true),
    _ => assert(false)
  }
  assert(Array::length(checked.typed_occurrences) > 0)
  assert(occurrences_apply_final_subst(occurrences = checked.typed_occurrences, subst = checked.final_subst))
}

test "checker final env retains ordered trait header params" {
  let checked = check_program_result([
    STrait(false, "Iterator", array_empty(), array_empty(), array_empty(), [
      "T",
      "U"
    ])
  ])
  let params = trait_header_params(env = checked.final_env, wanted = "Iterator")
  assert(Array::length(params) == 2)
  assert(Array::get(params, at = 0) == "T")
  assert(Array::get(params, at = 1) == "U")
}

test "production result retains every typedef form and enum binder provenance" {
  let observation = check_program_type_defs_observation([
    SEnum(false, "Choice", ["A", "B"], [("Only", [TyName("B")])], array_empty()),
    SStruct(false, "Box", [("value", TyName("T"))], array_empty(), ["value"], [
      "T"
    ]),
    STypeAlias(false, "Wrapped", ["T"], TyName("T")),
    SEffectDef(false, "Reader", ["T"], [("ask", array_empty(), TyName("T"))])
  ])
  let checked = observation.checked_program
  let type_def_binders = observation.type_def_binders
  assert(Array::length(checked.type_defs) == 4)
  assert(Array::length(checked.type_defs) == Array::length(type_def_binders))
  match Array::get(checked.type_defs, at = 0) {
    TDEnum("Choice", params, _) => assert(Array::length(params) == 2),
    _ => assert(false)
  }
  // Captured at declaration time, in declared order, even though A is unused.
  let binders = Array::get(type_def_binders, at = 0)
  assert(Array::length(binders) == 2)
  match Array::get(checked.type_defs, at = 1) {
    TDStruct("Box", _, _, params) => assert(Array::length(params) == 1),
    _ => assert(false)
  }
  match Array::get(checked.type_defs, at = 2) {
    TDAlias("Wrapped", params, _) => assert(Array::length(params) == 1),
    _ => assert(false)
  }
  match Array::get(checked.type_defs, at = 3) {
    TDEffect("Reader", _, params) => assert(Array::length(params) == 1),
    _ => assert(false)
  }
}

test "check_program_with_env_result retains production outputs" {
  let initial_env = env_bind(env = EnvEmpty, name = "seed", ty = CtInt)
  let stmts = [
    SEnum(false, "Local", ["T"], [("Wrap", [TyName("T")])], array_empty()),
    SStruct(false, "Record", [("value", TyName("Int"))], array_empty(), array_empty(), array_empty()),
    SLet(false, false, "copied", None, array_length_expr())
  ]
  let observation = check_program_with_env_type_defs_observation(stmts = stmts, initial_env = initial_env)
  let checked = observation.checked_program
  let type_def_binders = observation.type_def_binders
  assert(Array::length(checked.checked_stmts) == 3)
  assert_int_binding(env = checked.final_env, name = "seed")
  assert_int_binding(env = checked.final_env, name = "copied")
  assert(Array::length(checked.type_defs) == Array::length(type_def_binders))
  match Array::get(checked.type_defs, at = 0) {
    TDEnum("Local", _, _) => assert(Array::length(Array::get(type_def_binders, at = 0)) == 1),
    _ => assert(false)
  }
  match checked.final_subst {
    SubstEmpty => assert(true),
    _ => assert(false)
  }
  assert(Array::length(checked.typed_occurrences) > 0)
  assert(occurrences_apply_final_subst(occurrences = checked.typed_occurrences, subst = checked.final_subst))
}

//# Compatibility wrappers

test "check_program remains compatible with check_program_result" {
  let result_env = check_program_result([
    SLet(false, false, "value", None, EInt(1))
  ]).final_env
  let legacy_env = check_program([SLet(false, false, "value", None, EInt(1))])
  assert_int_binding(env = result_env, name = "value")
  assert_int_binding(env = legacy_env, name = "value")
}

test "check_program_with_env remains compatible with its result variant" {
  let initial_env = env_bind(env = EnvEmpty, name = "seed", ty = CtInt)
  let result_env = check_program_with_env_result(stmts = [
    SLet(false, false, "copied", None, EIdent("seed", -1))
  ], initial_env = initial_env).final_env
  let legacy_env = check_program_with_env(stmts = [
    SLet(false, false, "copied", None, EIdent("seed", -1))
  ], initial_env = initial_env)
  assert_int_binding(env = result_env, name = "copied")
  assert_int_binding(env = legacy_env, name = "copied")
}

//# Legacy typed-occurrence funnel parity

// These cases pin the pre-funnel ordered `(offset, Type)` table. The funnels
// are structural only: they deliberately do not add role/provenance to this
// legacy artifact.
test "typed occurrences preserve identifier rows across env builtin and qualified ctor branches" {
  assert_typed_occurrences(actual = check_expr_occurrences(expr = EIdent("x", 10), env = env_bind(env = EnvEmpty, name = "x", ty = CtInt), defs = array_empty()), expected = [
    (10, CtInt)
  ])
  // The env-builtin branch has BOTH answers, and which one a name gets is the
  // subject of #2433 and #2442, so both are asserted here.
  //
  // #2433: a builtin with no value form REPORTS instead of recording an
  // occurrence, because no program could use it as a value -- measured on
  // stage2, `let f = String::concat; f("a", "b")` compiled and then trapped
  // with `table index is out of bounds`, since a builtin's function index is
  // below `func_offset` and the indirect table holds user functions and
  // lambdas only. An EFFECTFUL builtin is the permanent member of that set.
  let berrors = array_empty()
  let btytab = array_empty()
  let _ = check_expr(expr = EIdent("Fs::read_file", 20), env = EnvEmpty, defs = array_empty(), s = SubstEmpty, c = 0, errors = berrors, tytab = btytab)
  assert(Array::length(berrors) == 1)
  assert(String::contains(Array::get(berrors, at = 0), needle = "Fs::read_file"))
  assert(String::contains(Array::get(berrors, at = 0), needle = "not a value"))
  assert(Array::length(btytab) == 0)
  // #2442: a QUALIFIED pure builtin does have a value form -- both lanes
  // eta-expand it -- so the same branch records the registry signature as an
  // occurrence. `String::concat` was this case's rejection subject until then.
  let verrors = array_empty()
  let vtytab = array_empty()
  let _ = check_expr(expr = EIdent("String::concat", 22), env = EnvEmpty, defs = array_empty(), s = SubstEmpty, c = 0, errors = verrors, tytab = vtytab)
  assert(Array::length(verrors) == 0)
  assert_typed_occurrences(actual = vtytab, expected = [
    (22, CtFn([CtString, CtString], CtString, None))
  ])
  let checked = check_program_result([
    SEnum(false, "Choice", array_empty(), [("Pick", array_empty())], array_empty()),
    SLet(false, false, "picked", None, EIdent("Choice::Pick", 30))
  ])
  assert_typed_occurrences(actual = checked.typed_occurrences, expected = [
    (30, CtEnum("Choice"))
  ])
  let methods = [("show", [TyName("Self")], TyName("String"))]
  let trait_env = EnvTraitDef("Show", array_empty(), false, methods, env_bind(env = EnvEmpty, name = "T", ty = CtVar(0)), array_empty(), array_empty())
  let trait_errors = array_empty()
  let trait_rows = array_empty()
  let _ = check_expr(expr = EIdent("T::show", 35), env = trait_env, defs = array_empty(), s = subst_add_bound(s = SubstEmpty, id = 0, bounds = [
    "Show"
  ]), c = 1, errors = trait_errors, tytab = trait_rows)
  assert(Array::length(trait_errors) == 0)
  assert_typed_occurrences(actual = trait_rows, expected = [
    (35, CtFn([CtVar(0)], CtString, None))
  ])
}

test "typed occurrences preserve nested call order and duplicate offsets" {
  let fn_type = CtFn([CtInt], CtInt, None)
  let env = env_bind(env = env_bind(env = EnvEmpty, name = "f", ty = fn_type), name = "g", ty = fn_type)
  assert_typed_occurrences(actual = check_expr_occurrences(expr = ECall(EIdent("f", 40), [
    ECall(EIdent("g", 41), [EInt(1)], 42, [])
  ], 43, []), env = env, defs = array_empty()), expected = [
    // ECall's generic callee check deliberately uses a synthetic EIdent;
    // only the nested and outer call-result rows are legacy occurrences.
    (42, CtInt),
    (43, CtInt)
  ])
  assert_typed_occurrences(actual = check_expr_occurrences(expr = ESeq(EIdent("f", 44), EIdent("f", 44)), env = env, defs = array_empty()), expected = [
    (44, fn_type),
    (44, fn_type)
  ])
}

test "typed occurrences preserve distinct and shared dot offsets" {
  let defs = [TDStruct("Box", [("value", CtInt)], array_empty(), array_empty())]
  let env = env_bind(env = EnvEmpty, name = "box", ty = CtStruct("Box"))
  assert_typed_occurrences(actual = check_expr_occurrences(expr = EDot(EIdent("box", 50), "value", 51, 52), env = env, defs = defs), expected = [
    (50, CtStruct("Box")),
    (51, CtInt),
    (52, CtInt)
  ])
  assert_typed_occurrences(actual = check_expr_occurrences(expr = EDot(EIdent("box", 60), "value", 61, 61), env = env, defs = defs), expected = [
    (60, CtStruct("Box")),
    (61, CtInt)
  ])
}

test "typed occurrences preserve synthetic negative-offset omission" {
  let fn_type = CtFn([CtInt], CtInt, None)
  let env = env_bind(env = env_bind(env = EnvEmpty, name = "f", ty = fn_type), name = "x", ty = CtInt)
  assert_typed_occurrences(actual = check_expr_occurrences(expr = ECall(EIdent("f", -1), [
    EIdent("x", -2)
  ], -3, []), env = env, defs = array_empty()), expected = array_empty())
  let defs = [TDStruct("Box", [("value", CtInt)], array_empty(), array_empty())]
  let box_env = env_bind(env = EnvEmpty, name = "box", ty = CtStruct("Box"))
  assert_typed_occurrences(actual = check_expr_occurrences(expr = EDot(EIdent("box", -4), "value", -5, -6), env = box_env, defs = defs), expected = array_empty())
}

fn builtin_call_observation(_ env: TypeEnv) -> String {
  let errors = array_empty()
  let (ty, subst, _) = check_expr(expr = ECall(EIdent("String::length", 10), [
    EString("abc", -1)
  ], 30, []), env = env, defs = array_empty(), s = SubstEmpty, c = 0, errors = errors, tytab = array_empty())
  if Array::length(errors) > 0 {
    assert(String::contains(Array::get(errors, at = 0), needle = "unknown name: String::length"))
    "blocked"
  } else {
    type_to_string(subst_apply(s = subst, ty = ty))
  }
}

test "direct builtins preserve local and re-export shadowing across environment layouts" {
  let name = "String::length"
  let local = env_bind(env = EnvEmpty, name = name, ty = CtFn([CtString], CtBool, None))
  let surface = env_bind_with_origin(env = EnvEmpty, name = name, ty = CtUnknown, origin = BindingOriginReExportSurface("dep", "length"))
  inspect(builtin_call_observation(EnvEmpty), "Int")
  inspect(builtin_call_observation(local), "Bool")
  inspect(builtin_call_observation(env_cache(local)), "Bool")
  inspect(builtin_call_observation(surface), "blocked")
  inspect(builtin_call_observation(env_cache(surface)), "blocked")
  inspect(builtin_call_observation(env_bind_with_origin(env = local, name = name, ty = CtUnknown, origin = BindingOriginReExportSurface("dep", "length"))), "blocked")
  inspect(builtin_call_observation(env_cache(env_bind(env = surface, name = name, ty = CtFn([
    CtString
  ], CtBool, None)))), "Bool")
  let flat = EnvFlat([
    (name, EnvValueBinding::{
      ty: CtUnknown,
      origin: BindingOriginReExportSurface("dep", "length")
    })
  ])
  inspect(builtin_call_observation(flat), "blocked")
  inspect(builtin_call_observation(env_cache(flat)), "blocked")
  // Cache misses still search bindings introduced after indexing.
  inspect(builtin_call_observation(env_bind(env = env_cache(EnvEmpty), name = name, ty = CtFn([
    CtString
  ], CtBool, None))), "Bool")
  inspect(builtin_call_observation(env_bind_with_origin(env = env_cache(EnvEmpty), name = name, ty = CtUnknown, origin = BindingOriginReExportSurface("dep", "length"))), "blocked")
  // A cache-only surface is hidden by value lookup, but does not claim a
  // source spelling in the authoritative chain. Preserve that distinction.
  let cache_only = env_cached(names = [name], bindings = [
    EnvValueBinding::{
      ty: CtUnknown,
      origin: BindingOriginReExportSurface("dep", "length")
    }
  ], rest = EnvEmpty)
  inspect(builtin_call_observation(cache_only), "Int")
  let cached_local = env_cached(names = [name], bindings = [
    env_value_binding(CtFn([CtString], CtBool, None))
  ], rest = surface)
  inspect(builtin_call_observation(cached_local), "Bool")
}
