//# Imports

import @vibe/compiler/core {
  Expr, Pat, Stmt, TypeExpr
}

import @vibe/core {
  array_empty
}

import ../desugar.vibe {
  desugar_expr, desugar_stmts
}

//# Functions

fn is_edot(e: Expr) -> Bool {
  match e {
    EDot(_, _, _, _) => true,
    _ => false
  }
}

fn is_eint(e: Expr) -> Bool {
  match e {
    EInt(_) => true,
    _ => false
  }
}

fn is_elet(e: Expr) -> Bool {
  match e {
    ELet(_, _, _, _) => true,
    _ => false
  }
}

fn is_slet(s: Stmt) -> Bool {
  match s {
    SLet(_, _, _, _, _) => true,
    _ => false
  }
}

fn edot_obj(e: Expr) -> Expr {
  match e {
    EDot(o, _, _, _) => o,
    _ => EUnit
  }
}

fn eint_val(e: Expr) -> Int {
  match e {
    EInt(n) => n,
    _ => -1
  }
}

fn is_ecall(e: Expr) -> Bool {
  match e {
    ECall(_, _, _) => true,
    _ => false
  }
}

fn is_eloop(e: Expr) -> Bool {
  match e {
    ELoop(_, _) => true,
    _ => false
  }
}

fn ebinop_op(e: Expr) -> String {
  match e {
    EBinOp(op, _, _, _) => op,
    _ => ""
  }
}

fn ebinop_off(e: Expr) -> Int {
  match e {
    EBinOp(_, _, _, boff) => boff,
    _ => 0 - 2
  }
}

fn elet_body(e: Expr) -> Expr {
  match e {
    ELet(_, _, b, _) => b,
    _ => EUnit
  }
}

fn is_earray(e: Expr) -> Bool {
  match e {
    EArray(_) => true,
    _ => false
  }
}

fn is_ebinop(e: Expr) -> Bool {
  match e {
    EBinOp(_, _, _, _) => true,
    _ => false
  }
}

fn is_eident(e: Expr) -> Bool {
  match e {
    EIdent(_, _) => true,
    _ => false
  }
}

fn slet_body(s: Stmt) -> Expr {
  match s {
    SLet(_, _, _, _, b) => b,
    _ => EUnit
  }
}

fn ecall_args(e: Expr) -> Array[Expr] {
  match e {
    ECall(_, a, _) => a,
    _ => array_empty()
  }
}

fn edot_field(e: Expr) -> String {
  match e {
    EDot(_, f, _, _) => f,
    _ => ""
  }
}

fn eident_name(e: Expr) -> String {
  match e {
    EIdent(n, _) => n,
    _ => ""
  }
}

fn earray_elems(e: Expr) -> Array[Expr] {
  match e {
    EArray(elems) => elems,
    _ => array_empty()
  }
}

fn ecall_callee(e: Expr) -> Expr {
  match e {
    ECall(c, _, _) => c,
    _ => EUnit
  }
}

fn eloop_params(e: Expr) -> Array[(String, Expr)] {
  match e {
    ELoop(params, _) => params,
    _ => array_empty()
  }
}

fn is_eassignop(e: Expr) -> Bool {
  match e {
    EAssignOp(_, _, _, _) => true,
    _ => false
  }
}

fn eassignop_val(e: Expr) -> Expr {
  match e {
    EAssignOp(_, _, v, _) => v,
    _ => EUnit
  }
}

//# Misc

test "pipe simple: x |> f => f(x)" {
  let result = desugar_expr(EBinOp("|>", EInt(1), EIdent("f", -1), -1))
  assert(is_ecall(result))
  assert(is_eident(ecall_callee(result)))
  assert(eident_name(ecall_callee(result)) == "f")
  assert(eq(Array::length(ecall_args(result)), 1))
  assert(eq(eint_val(Array::get(ecall_args(result), 0)), 1))
}

test "pipe with args: x |> f(y) => f(x, y)" {
  let result = desugar_expr(EBinOp("|>", EInt(1), ECall(EIdent("f", -1), [
    EInt(2)
  ], -1), -1))
  assert(is_ecall(result))
  assert(eident_name(ecall_callee(result)) == "f")
  assert(eq(Array::length(ecall_args(result)), 2))
  assert(eq(eint_val(Array::get(ecall_args(result), 0)), 1))
  assert(eq(eint_val(Array::get(ecall_args(result), 1)), 2))
}

test "method call: obj.method() preserved as ECall(EDot(...))" {
  let result = desugar_expr(ECall(EDot(EIdent("x", -1), "len", -1, -1), array_empty(), -1))
  assert(is_ecall(result))
  let callee = ecall_callee(result)
  assert(is_edot(callee))
  assert(edot_field(callee) == "len")
  assert(eident_name(edot_obj(callee)) == "x")
}

test "method call with args: obj.push(1) preserved" {
  let result = desugar_expr(ECall(EDot(EIdent("x", -1), "push", -1, -1), [
    EInt(1)
  ], -1))
  assert(is_ecall(result))
  let callee = ecall_callee(result)
  assert(is_edot(callee))
  assert(edot_field(callee) == "push")
  assert(eq(Array::length(ecall_args(result)), 1))
  assert(eq(eint_val(Array::get(ecall_args(result), 0)), 1))
}

test "non-pipe binop passes through" {
  let result = desugar_expr(EBinOp("+", EInt(1), EInt(2), -1))
  assert(is_ebinop(result))
  assert(ebinop_op(result) == "+")
}

test "non-pipe binop keeps its operator offset" {
  // #2435: desugar_expr rebuilds the binop, and a rebuild threads the
  // matched offset through -- only newly synthesized nodes get -1. The
  // typed String-binop channel keys on this offset, so a desugar that
  // dropped it would silence the channel for every binop it touched.
  let result = desugar_expr(EBinOp("+", EInt(1), EInt(2), 42))
  assert(is_ebinop(result))
  assert(ebinop_off(result) == 42)
}

test "EDot without call passes through" {
  let result = desugar_expr(EDot(EIdent("x", -1), "y", -1, -1))
  assert(is_edot(result))
  assert(edot_field(result) == "y")
  assert(eident_name(edot_obj(result)) == "x")
}

test "nested: pipe inside let body" {
  let result = desugar_expr(ELet("x", EInt(1), EBinOp("|>", EIdent("x", -1), EIdent("f", -1), -1), -1))
  assert(is_elet(result))
  let body = elet_body(result)
  assert(is_ecall(body))
  assert(eident_name(ecall_callee(body)) == "f")
}

test "SLet body gets desugared" {
  let stmts = [
    SLet(false, false, "x", None, EBinOp("|>", EInt(1), EIdent("f", -1), -1))
  ]
  let result = desugar_stmts(stmts)
  assert(eq(Array::length(result), 1))
  match Array::get(result, 0) {
    SLet(_, _, name, _, body) => {
      assert(name == "x")
      assert(is_ecall(body))
      assert(eident_name(ecall_callee(body)) == "f")
    },
    _ => assert(false)
  }
}

test "chained pipe: x |> f |> g => g(f(x))" {
  let result = desugar_expr(EBinOp("|>", EBinOp("|>", EInt(1), EIdent("f", -1), -1), EIdent("g", -1), -1))
  assert(is_ecall(result))
  assert(is_eident(ecall_callee(result)))
  assert(eident_name(ecall_callee(result)) == "g")
  assert(eq(Array::length(ecall_args(result)), 1))
  let inner = Array::get(ecall_args(result), 0)
  assert(is_ecall(inner))
  assert(eident_name(ecall_callee(inner)) == "f")
  assert(eq(Array::length(ecall_args(inner)), 1))
  assert(eq(eint_val(Array::get(ecall_args(inner), 0)), 1))
}

test "pipe into method call: 1 |> obj.method() preserved EDot" {
  let result = desugar_expr(EBinOp("|>", EInt(1), ECall(EDot(EIdent("obj", -1), "method", -1, -1), array_empty(), -1), -1))
  // pipe prepends 1 to args of ECall(EDot(obj, method), [])
  assert(is_ecall(result))
  let callee = ecall_callee(result)
  assert(is_edot(callee))
  assert(edot_field(callee) == "method")
  assert(eq(Array::length(ecall_args(result)), 1))
  assert(eq(eint_val(Array::get(ecall_args(result), 0)), 1))
}

test "chained method: x.a().b() preserved as nested EDot" {
  let result = desugar_expr(ECall(EDot(ECall(EDot(EIdent("x", -1), "a", -1, -1), array_empty(), -1), "b", -1, -1), array_empty(), -1))
  assert(is_ecall(result))
  let callee = ecall_callee(result)
  assert(is_edot(callee))
  assert(edot_field(callee) == "b")
  // inner is ECall(EDot(x, a), [])
  let inner = edot_obj(callee)
  assert(is_ecall(inner))
  let inner_callee = ecall_callee(inner)
  assert(is_edot(inner_callee))
  assert(edot_field(inner_callee) == "a")
}

test "pipe into obj.push(): 1 |> obj.push() preserved EDot" {
  let result = desugar_expr(EBinOp("|>", EInt(1), ECall(EDot(EIdent("obj", -1), "push", -1, -1), array_empty(), -1), -1))
  assert(is_ecall(result))
  let callee = ecall_callee(result)
  assert(is_edot(callee))
  assert(edot_field(callee) == "push")
  assert(eq(Array::length(ecall_args(result)), 1))
  assert(eq(eint_val(Array::get(ecall_args(result), 0)), 1))
}

test "EAssignOp desugars val: x += (1 |> f) => x += f(1)" {
  let result = desugar_expr(EAssignOp("x", "+", EBinOp("|>", EInt(1), EIdent("f", -1), -1), EUnit))
  assert(is_eassignop(result))
  let val = eassignop_val(result)
  assert(is_ecall(val))
  assert(eident_name(ecall_callee(val)) == "f")
  assert(eq(Array::length(ecall_args(val)), 1))
  assert(eq(eint_val(Array::get(ecall_args(val), 0)), 1))
}

test "desugar_stmts handles multiple SLet with pipes" {
  let stmts = [
    SLet(false, false, "a", None, EBinOp("|>", EInt(1), EIdent("f", -1), -1)),
    SLet(false, false, "b", None, EBinOp("|>", EInt(2), EIdent("g", -1), -1))
  ]
  let result = desugar_stmts(stmts)
  assert(eq(Array::length(result), 2))
  let body0 = slet_body(Array::get(result, 0))
  assert(is_ecall(body0))
  assert(eident_name(ecall_callee(body0)) == "f")
  assert(eq(eint_val(Array::get(ecall_args(body0), 0)), 1))
  let body1 = slet_body(Array::get(result, 1))
  assert(is_ecall(body1))
  assert(eident_name(ecall_callee(body1)) == "g")
  assert(eq(eint_val(Array::get(ecall_args(body1), 0)), 2))
}

test "array spread flushes buffered elems without Array::pop" {
  let result = desugar_expr(EArray([
    EInt(1),
    ESpread(EIdent("xs", -1)),
    EInt(2)
  ]))
  assert(is_ecall(result))
  assert(eident_name(ecall_callee(result)) == "Array::concat")
  let outer_left = Array::get(ecall_args(result), 0)
  let outer_right = Array::get(ecall_args(result), 1)
  assert(is_ecall(outer_left))
  assert(is_earray(outer_right))
  assert(eq(Array::length(earray_elems(outer_right)), 1))
  assert(eq(eint_val(Array::get(earray_elems(outer_right), 0)), 2))
  assert(eident_name(ecall_callee(outer_left)) == "Array::concat")
  let inner_left = Array::get(ecall_args(outer_left), 0)
  let inner_right = Array::get(ecall_args(outer_left), 1)
  assert(is_earray(inner_left))
  assert(eq(Array::length(earray_elems(inner_left)), 1))
  assert(eq(eint_val(Array::get(earray_elems(inner_left), 0)), 1))
  assert(is_eident(inner_right))
  assert(eident_name(inner_right) == "xs")
}

test "parameterized loop desugars init exprs" {
  let result = desugar_expr(ELoop([
    ("i", EBinOp("|>", EInt(1), EIdent("f", -1), -1))
  ], EIdent("body", -1)))
  assert(is_eloop(result))
  let params = eloop_params(result)
  assert(eq(Array::length(params), 1))
  let (name, init) = Array::get(params, 0)
  assert(name == "i")
  assert(is_ecall(init))
  assert(eident_name(ecall_callee(init)) == "f")
}
