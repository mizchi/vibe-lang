//# Imports

// #3053: a caller's declared generic effect row compares a callee's row
// arguments when both sides spell closed builtin types. `with State[Int]`
// used to authorize a callee's `State[String]`, because generic effect labels
// matched by base name alone (#1340 v1).
import @vibe/compiler/runtime {
  collect_all_diagnostics
}

//# Misc

fn diags_of_raw(src: String) -> Array[String] with Exception {
  collect_all_diagnostics(src)
}

fn diags_of(body: String) -> Array[String] with Exception {
  let head = "effect State[S] {\n  Get() -> S\n}\n\n"
  collect_all_diagnostics(String::concat(head, body))
}

test "a different closed argument is refused" {
  let d = diags_of("fn g(x: String) -> Int with State[String] {\n  1\n}\n\nfn caller() -> Int with State[Int] {\n  g(\"abc\")\n}\n")
  assert(eq(Array::length(d), 1))
  assert(String::contains(Array::get(d, 0), "missing { State[String] }"))
}

test "a nested closed argument is compared too" {
  let d = diags_of("fn g() -> Int with State[Array[String]] {\n  1\n}\n\nfn caller() -> Int with State[Array[Int]] {\n  g()\n}\n")
  assert(eq(Array::length(d), 1))
  assert(String::contains(Array::get(d, 0), "missing { State[Array[String]] }"))
}

test "the same closed argument is authorized, spacing aside" {
  let d = diags_of("fn g() -> Int with State[Array[Int]] {\n  1\n}\n\nfn caller() -> Int with State[Array[ Int ]] {\n  g()\n}\n")
  assert(eq(Array::length(d), 0))
}

test "a callee's formal is instantiated at the call" {
  let getter = "fn get[S](x: S) -> Int with State[S] {\n  1\n}\n\n"
  // The call instantiates `S` at `String`, which `State[Int]` does not cover.
  let wrong = diags_of(String::concat(getter, "fn caller() -> Int with State[Int] {\n  get(\"abc\")\n}\n"))
  assert(eq(Array::length(wrong), 1))
  assert(String::contains(Array::get(wrong, 0), "missing { State[String] }"))
  // ... and the requirement names the instantiation, not the callee's formal.
  let bare = diags_of(String::concat(getter, "fn caller() -> Int {\n  get(\"abc\")\n}\n"))
  assert(eq(Array::length(bare), 1))
  assert(String::contains(Array::get(bare, 0), "missing { State[String] }"))
  // The matching instantiation is authorized.
  let right = diags_of(String::concat(getter, "fn caller() -> Int with State[Int] {\n  get(1)\n}\n"))
  assert(eq(Array::length(right), 0))
}

test "a local generic lambda and an alias are instantiated at the call" {
  // Codex on #3055: a local binding is a lexical callee, checked by its own
  // branch, which used to read the row as written.
  let local = diags_of("fn caller() -> Int with State[Int] {\n  let get = [S](x: S) -> Int with State[S] {\n    1\n  }\n  get(\"abc\")\n}\n")
  assert(eq(Array::length(local), 1))
  assert(String::contains(Array::get(local, 0), "missing { State[String] }"))
  let alias = diags_of("fn caller() -> Int with State[Int] {\n  let get0 = [S](x: S) -> Int with State[S] {\n    1\n  }\n  let get = get0\n  get(\"abc\")\n}\n")
  assert(eq(Array::length(alias), 1))
  assert(String::contains(Array::get(alias, 0), "missing { State[String] }"))
  let right = diags_of("fn caller() -> Int with State[Int] {\n  let get = [S](x: S) -> Int with State[S] {\n    1\n  }\n  get(1)\n}\n")
  assert(eq(Array::length(right), 0))
}

test "a higher-kinded formal is instantiated with its constructor" {
  // Codex on #3055: `F[_]` applied as `F[Int]` resolves to the argument's
  // constructor, so `use([1])` requires `Read[Array]`, not an open `Read[F]`.
  let src = "effect Read[F[_]] {\n  Size() -> Int\n}\n\nfn use[F[_]](xs: F[Int]) -> Int with Read[F] {\n  1\n}\n\n"
  let wrong = diags_of_raw(String::concat(src, "fn caller() -> Int with Read[Option] {\n  use([1])\n}\n"))
  assert(eq(Array::length(wrong), 1))
  assert(String::contains(Array::get(wrong, 0), "missing { Read[Array] }"))
  let right = diags_of_raw(String::concat(src, "fn caller() -> Int with Read[Array] {\n  use([1])\n}\n"))
  assert(eq(Array::length(right), 0))
}

test "an open or declared spelling keeps the base-name answer" {
  // A formal, an alias and a declared type are not builtin names, so this
  // syntactic test does not judge them (#3053 tracks the formal half).
  let formal = diags_of("fn g[T](x: T) -> Int with State[T] {\n  1\n}\n\nfn caller() -> Int with State[Int] {\n  g(1)\n}\n")
  assert(eq(Array::length(formal), 0))
  let alias = diags_of("type N = Int\n\nfn g() -> Int with State[N] {\n  1\n}\n\nfn caller() -> Int with State[Int] {\n  g()\n}\n")
  assert(eq(Array::length(alias), 0))
}

test "a formal that shadows a builtin name is not judged as that builtin" {
  // Codex on #3054: `[Int]` makes `Int` a formal here, so `State[Int]` is open.
  let d = diags_of("fn g(x: String) -> Int with State[String] {\n  1\n}\n\nfn caller[Int](x: Int) -> Int with State[Int] {\n  g(\"abc\")\n}\n")
  assert(eq(Array::length(d), 0))
}

test "a shadowing formal elsewhere does not switch the check off here" {
  // Codex on #3054: the shadow set is per declaration. `id` shadows `Int`,
  // but `caller`'s `State[Int]` is the builtin and is still judged.
  let d = diags_of("fn id[Int](x: Int) -> Int {\n  x\n}\n\nfn g(x: String) -> Int with State[String] {\n  1\n}\n\nfn caller() -> Int with State[Int] {\n  g(\"abc\")\n}\n")
  assert(eq(Array::length(d), 1))
  assert(String::contains(Array::get(d, 0), "missing { State[String] }"))
}
