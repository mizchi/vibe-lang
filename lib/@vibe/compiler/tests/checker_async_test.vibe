//# Imports

import @vibe/compiler/core {
  Expr, Type, TypeEnv
}

import @vibe/core {
  array_empty
}

import @vibe/compiler/checker {
  EffectError, check_async_effects_expr, lookup_builtin
}

//# Functions

fn is_call_err(e: EffectError) -> Bool {
  match e {
    EEEffectfulCallOutsideEffect(_) => true,
    _ => false
  }
}

/// `Future::ready(1)` — a pure future constructor used to feed `await`.
fn future_ready_one() -> Expr {
  ECall(EIdent("Future::ready", -1), [
    EInt(1)
  ], -1)
}

fn await_call() -> Expr {
  ECall(EIdent("await", -1), [
    future_ready_one()
  ], -1)
}

//# Misc

// #944 follow-up: this file used to drive these builtins through the legacy
// `check_effects_expr` walk (retired -- no live-pipeline caller). The same
// primitives are now asserted through the LIVE Async-scoped pass
// (`check_async_effects_expr`, the one `check_program` wires), plus the
// `lookup_builtin` effect-classification checks that pass depends on.

test "await is a registered effectful builtin" {
  match lookup_builtin("await") {
    Some(ty) => match ty {
      CtFn(_, _, Some(_)) => assert(true),
      _ => assert(false)
    },
    None => assert(false)
  }
}

test "Future::ready is a registered pure builtin" {
  match lookup_builtin("Future::ready") {
    Some(ty) => match ty {
      CtFn(_, _, None) => assert(true),
      _ => assert(false)
    },
    None => assert(false)
  }
}

test "await outside async context reports effectful-call error" {
  let errors = check_async_effects_expr(await_call(), EnvEmpty, false)
  assert(Array::length(errors) > 0)
  assert(is_call_err(Array::get(errors, 0)))
}

test "await inside async context is OK" {
  let errors = check_async_effects_expr(await_call(), EnvEmpty, true)
  assert(eq(Array::length(errors), 0))
}

test "await inside EFn with Async annotation is OK" {
  let fn_expr = EFn(array_empty(), array_empty(), array_empty(), None, Some("Async"), await_call())
  let errors = check_async_effects_expr(fn_expr, EnvEmpty, false)
  assert(eq(Array::length(errors), 0))
}

test "await inside EFn without effect annotation reports error" {
  let fn_expr = EFn(array_empty(), array_empty(), array_empty(), None, None, await_call())
  let errors = check_async_effects_expr(fn_expr, EnvEmpty, false)
  assert(Array::length(errors) > 0)
}

// --- Stream[T] (async iterator) ---

/// `Stream::next(String::to_bytes(""))`
///
/// #1538 retired the eager producers (`Stream::empty` / `once`), so the one
/// remaining way to spell a `Stream[Int]` is the ByteStream half.
fn stream_next_call() -> Expr {
  ECall(EIdent("Stream::next", -1), [
    ECall(EIdent("String::to_bytes", -1), [
      EString("")
    ], -1)
  ], -1)
}

test "Stream::next is a registered effectful builtin (Async)" {
  match lookup_builtin("Stream::next") {
    Some(ty) => match ty {
      CtFn(_, _, Some(_)) => assert(true),
      _ => assert(false)
    },
    None => assert(false)
  }
}

/// #1538: the eager combinators are RETIRED. They must not resolve at all --
/// a lingering registration would keep the eager Array-backed model reachable
/// and let `Stream[T]` grow a second meaning next to AsyncIter.
test "the eager Stream combinators no longer resolve (#1538)" {
  match lookup_builtin("Stream::empty") {
    Some(_) => assert(false),
    None => assert(true)
  }
  match lookup_builtin("Stream::once") {
    Some(_) => assert(false),
    None => assert(true)
  }
  match lookup_builtin("Stream::map") {
    Some(_) => assert(false),
    None => assert(true)
  }
  match lookup_builtin("Stream::filter") {
    Some(_) => assert(false),
    None => assert(true)
  }
  match lookup_builtin("Stream::fold") {
    Some(_) => assert(false),
    None => assert(true)
  }
}

/// The ByteStream pair survives and stays pure -- it is the only producer of a
/// `Stream[Int]` left, so `Stream::next` above depends on it.
test "the ByteStream pair is still registered (#1538)" {
  match lookup_builtin("String::to_bytes") {
    Some(ty) => match ty {
      CtFn(_, _, None) => assert(true),
      _ => assert(false)
    },
    None => assert(false)
  }
  match lookup_builtin("Stream::to_string") {
    Some(ty) => match ty {
      CtFn(_, _, None) => assert(true),
      _ => assert(false)
    },
    None => assert(false)
  }
}

test "Stream::next outside async context reports effectful-call error" {
  let errors = check_async_effects_expr(stream_next_call(), EnvEmpty, false)
  assert(Array::length(errors) > 0)
  assert(is_call_err(Array::get(errors, 0)))
}

test "Stream::next inside async context is OK" {
  let errors = check_async_effects_expr(stream_next_call(), EnvEmpty, true)
  assert(eq(Array::length(errors), 0))
}

// --- Task[T] retirement (#1227) ---
//
// The eager M-conc-1 prototype (`Task::spawn`/`join`/`cancel`/`race`/
// `timeout`) is GONE. It compiled `spawn` to an immediate `call_indirect` of
// the thunk, so `spawn(f); spawn(g)` always ran `f` to completion first --
// concurrency that silently serialized. These tests used to assert the
// builtins were registered; they now pin that they are NOT, so the surface
// cannot come back without this failing.
//
// The working surface is `@vibe/concurrent`: `TaskGroup::spawn_suspend`,
// `TaskHandle::join`, and `sleep_wait` (#1253).

test "the eager Task::* prototype is retired -- no longer registered builtins" {
  match lookup_builtin("Task::spawn") {
    Some(_) => assert(false),
    None => assert(true)
  }
  match lookup_builtin("Task::join") {
    Some(_) => assert(false),
    None => assert(true)
  }
  match lookup_builtin("Task::cancel") {
    Some(_) => assert(false),
    None => assert(true)
  }
  match lookup_builtin("Task::race") {
    Some(_) => assert(false),
    None => assert(true)
  }
  match lookup_builtin("Task::timeout") {
    Some(_) => assert(false),
    None => assert(true)
  }
}

