//# Imports

import @vibe/compiler/core {
  Expr, Type, TypeEnv
}

import @vibe/core {
  array_empty
}

import @vibe/compiler/checker {
  EffectError, check_async_effects_expr, lookup_builtin
}

//# Functions

fn is_call_err(e: EffectError) -> Bool {
  match e {
    EEEffectfulCallOutsideEffect(_) => true,
    _ => false
  }
}

/// `Future::ready(1)` — a pure future constructor used to feed `await`.
fn future_ready_one() -> Expr {
  ECall(EIdent("Future::ready", -1), [
    EInt(1)
  ], -1)
}

fn await_call() -> Expr {
  ECall(EIdent("await", -1), [
    future_ready_one()
  ], -1)
}

//# Misc

// #944 follow-up: this file used to drive these builtins through the legacy
// `check_effects_expr` walk (retired -- no live-pipeline caller). The same
// primitives are now asserted through the LIVE Async-scoped pass
// (`check_async_effects_expr`, the one `check_program` wires), plus the
// `lookup_builtin` effect-classification checks that pass depends on.

test "await is a registered effectful builtin" {
  match lookup_builtin("await") {
    Some(ty) => match ty {
      CtFn(_, _, Some(_)) => assert(true),
      _ => assert(false)
    },
    None => assert(false)
  }
}

test "Future::ready is a registered pure builtin" {
  match lookup_builtin("Future::ready") {
    Some(ty) => match ty {
      CtFn(_, _, None) => assert(true),
      _ => assert(false)
    },
    None => assert(false)
  }
}

test "await outside async context reports effectful-call error" {
  let errors = check_async_effects_expr(await_call(), EnvEmpty, false)
  assert(Array::length(errors) > 0)
  assert(is_call_err(Array::get(errors, 0)))
}

test "await inside async context is OK" {
  let errors = check_async_effects_expr(await_call(), EnvEmpty, true)
  assert(eq(Array::length(errors), 0))
}

test "await inside EFn with Async annotation is OK" {
  let fn_expr = EFn(array_empty(), array_empty(), array_empty(), None, Some("Async"), await_call())
  let errors = check_async_effects_expr(fn_expr, EnvEmpty, false)
  assert(eq(Array::length(errors), 0))
}

test "await inside EFn without effect annotation reports error" {
  let fn_expr = EFn(array_empty(), array_empty(), array_empty(), None, None, await_call())
  let errors = check_async_effects_expr(fn_expr, EnvEmpty, false)
  assert(Array::length(errors) > 0)
}

// --- Stream[T] (async iterator) ---

/// `Stream::next(Stream::empty())`
fn stream_next_call() -> Expr {
  ECall(EIdent("Stream::next", -1), [
    ECall(EIdent("Stream::empty", -1), array_empty(), -1)
  ], -1)
}

test "Stream::next is a registered effectful builtin (Async)" {
  match lookup_builtin("Stream::next") {
    Some(ty) => match ty {
      CtFn(_, _, Some(_)) => assert(true),
      _ => assert(false)
    },
    None => assert(false)
  }
}

test "Stream::empty and Stream::map are registered pure builtins" {
  match lookup_builtin("Stream::empty") {
    Some(ty) => match ty {
      CtFn(_, _, None) => assert(true),
      _ => assert(false)
    },
    None => assert(false)
  }
  match lookup_builtin("Stream::map") {
    Some(ty) => match ty {
      CtFn(_, _, None) => assert(true),
      _ => assert(false)
    },
    None => assert(false)
  }
}

test "Stream::next outside async context reports effectful-call error" {
  let errors = check_async_effects_expr(stream_next_call(), EnvEmpty, false)
  assert(Array::length(errors) > 0)
  assert(is_call_err(Array::get(errors, 0)))
}

test "Stream::next inside async context is OK" {
  let errors = check_async_effects_expr(stream_next_call(), EnvEmpty, true)
  assert(eq(Array::length(errors), 0))
}

// --- Task[T] (structured concurrency + cancellation) ---

test "Task::spawn / join / cancel are registered effectful builtins (Async)" {
  match lookup_builtin("Task::spawn") {
    Some(ty) => match ty {
      CtFn(_, _, Some(_)) => assert(true),
      _ => assert(false)
    },
    None => assert(false)
  }
  match lookup_builtin("Task::join") {
    Some(ty) => match ty {
      CtFn(_, _, Some(_)) => assert(true),
      _ => assert(false)
    },
    None => assert(false)
  }
  match lookup_builtin("Task::cancel") {
    Some(ty) => match ty {
      CtFn(_, _, Some(_)) => assert(true),
      _ => assert(false)
    },
    None => assert(false)
  }
}

test "Task::spawn outside async context reports effectful-call error" {
  let call_expr = ECall(EIdent("Task::spawn", -1), [
    EInt(0)
  ], -1)
  let errors = check_async_effects_expr(call_expr, EnvEmpty, false)
  assert(Array::length(errors) > 0)
  assert(is_call_err(Array::get(errors, 0)))
}

test "Task::join inside async context is OK" {
  let call_expr = ECall(EIdent("Task::join", -1), [
    EInt(0)
  ], -1)
  let errors = check_async_effects_expr(call_expr, EnvEmpty, true)
  assert(eq(Array::length(errors), 0))
}
