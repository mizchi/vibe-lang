import ../core {
  Expr
}

import ../checker_effects.vibe {
  check_perform_effects_expr_tx
}

test "A: shadowed ELet callback param is not treated as effectful" {
  let inner_lambda = EFn(Array::slice([""], 0, 0), Array::slice([("", Array::slice([""], 0, 0))], 0, 0), Array::slice([("y", None)], 0, 0), None, None, EIdent("y", -1))
  let call_f = ECall(EIdent("f", -1), [EIdent("x", -1)], -1)
  let body = ELet("f", inner_lambda, call_f, -1)
  let errors = check_perform_effects_expr_tx(body, Array::slice([""], 0, 0), false, Array::slice([""], 0, 0), Array::slice([Array::slice([""], 0, 0)], 0, 0), ["f"], [["Fs"]])
  assert(Array::length(errors) == 0)
}
