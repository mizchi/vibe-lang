//# #3418: a kinded effect row, or a constructor formal only the rows name

// The effect-row hand-off skipped every effect whose parameter is a
// constructor (`effect Kb[F[_]]`) and every formal `F[_]` only a callee's
// rows name, so a bare `with Kb` or a forwarded `Box[F[Int]]` let a payload at
// one constructor reach a handler expecting another. With `Kb[Cell]` in scope,
// `mk([7, 8, 9])` handed an array to an arm reading `v.value`, which answered
// `30064771342`.
import @vibe/compiler/runtime {
  collect_all_diagnostics
}

test "a bare kinded row is read with the constructor its body fixes" {
  let src = "effect Kb[F[_]] {\n  Put(F[Int]) -> Int\n}\n\nstruct Cell[T] {\n  value: T\n}\n\nfn mk(x: Array[Int]) -> Int with Kb {\n  perform Kb::Put(x)\n}\n\nfn caller() -> Int with Kb[Cell] {\n  mk([7, 8, 9])\n}\n"
  inspect(collect_all_diagnostics(src), "[line 14:3: effect row mismatch for 'caller': missing { Kb[Array] } (declared { Kb[Cell] }, requires { Kb[Array], Kb[Cell] })\nhint: add 'with Kb[Array] + Kb[Cell]' to 'caller']")
}

test "a bare kinded row at the caller's constructor is accepted" {
  let src = "effect Kb[F[_]] {\n  Put(F[Int]) -> Int\n}\n\nfn mk(x: Array[Int]) -> Int with Kb {\n  perform Kb::Put(x)\n}\n\nfn caller() -> Int with Kb[Array] {\n  mk([7, 8, 9])\n}\n"
  inspect(collect_all_diagnostics(src), "[]")
}

test "a generic function's bare kinded row names the constructor its body fixes" {
  let src = "effect Kb[F[_]] {\n  Put(F[Int]) -> Int\n}\n\nfn mk[F[_]](x: F[Int]) -> Int with Kb {\n  perform Kb::Put(x)\n}\n"
  inspect(collect_all_diagnostics(src), "[write `with Kb[F]`: this generic function performs `Kb` at `F`, and a bare `with Kb` lets a caller's `Kb[..]` of another type cover it]")
}

test "a generic function's written kinded row is accepted" {
  let src = "effect Kb[F[_]] {\n  Put(F[Int]) -> Int\n}\n\nfn mk[F[_]](x: F[Int]) -> Int with Kb[F] {\n  perform Kb::Put(x)\n}\n\nfn caller() -> Int with Kb[Option] {\n  mk(Some(1))\n}\n"
  inspect(collect_all_diagnostics(src), "[]")
}

test "a row-only constructor formal is fixed from the caller's row" {
  let src = "effect Box[T] {\n  Put(T) -> Int\n}\n\nfn run[F[_]](f: () -> Int with Box[F[Int]]) -> Int with Box[F[Int]] {\n  f()\n}\n\nfn caller() -> Int with Box[Option[Int]] {\n  run(() -> { perform Box::Put([1]) })\n}\n"
  inspect(collect_all_diagnostics(src), "[line 10:23: perform argument type mismatch for Box::Put: expected Option[Int], got Array[Int]]")
}

test "a row-only constructor formal at the caller's row is accepted" {
  let src = "effect Box[T] {\n  Put(T) -> Int\n}\n\nfn run[F[_]](f: () -> Int with Box[F[Int]]) -> Int with Box[F[Int]] {\n  f()\n}\n\nfn caller() -> Int with Box[Option[Int]] {\n  run(() -> { perform Box::Put(Some(1)) })\n}\n"
  inspect(collect_all_diagnostics(src), "[]")
}

test "a row-only constructor formal of a kinded effect is fixed from the caller's row" {
  let src = "effect Kb[F[_]] {\n  Put(F[Int]) -> Int\n}\n\nfn run[G[_]](f: () -> Int with Kb[G]) -> Int with Kb[G] {\n  f()\n}\n\nfn caller() -> Int with Kb[Option] {\n  run(() -> { perform Kb::Put([1]) })\n}\n"
  inspect(collect_all_diagnostics(src), "[line 10:23: perform argument type mismatch for Kb::Put: expected Option[Int], got Array[Int]]")
}

test "a row-only constructor formal of a kinded effect at the caller's row is accepted" {
  let src = "effect Kb[F[_]] {\n  Put(F[Int]) -> Int\n}\n\nfn run[G[_]](f: () -> Int with Kb[G]) -> Int with Kb[G] {\n  f()\n}\n\nfn caller() -> Int with Kb[Option] {\n  run(() -> { perform Kb::Put(Some(1)) })\n}\n"
  inspect(collect_all_diagnostics(src), "[]")
}

test "a generic function's bare kinded row at a concrete constructor names it as a row writes it" {
  let src = "effect Kb[F[_]] {\n  Put(F[Int]) -> Int\n}\n\nfn mk[T](x: T, xs: Array[Int]) -> Int with Kb {\n  perform Kb::Put(xs)\n}\n"
  inspect(collect_all_diagnostics(src), "[write `with Kb[Array]`: this generic function performs `Kb` at `Array`, and a bare `with Kb` lets a caller's `Kb[..]` of another type cover it]")
}
