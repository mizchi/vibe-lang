// #2848: a field read whose receiver is typed by a TYPE PARAMETER is refused,
// with a message that leads with the edit. Before the fix the read typed as
// `CtUnknown` and codegen resolved the field by SPELLING against any struct
// declaring it: `fn read[T](m: T) -> Int { m.payload }` applied to `7` answered
// `0` -- slot 0 of a tagged integer read through an unrelated struct's offset
// -- and with no struct declaring the name the same program was clean in
// `vibe check` and died in the build with `unknown struct field`.
//
// The refusals are asserted here through `check_program` on a source string,
// so the MESSAGE is pinned and not merely the verdict, and so the nested /
// captured / rigid spellings are each named. The executable fixtures in
// `fixtures/typecheck/err_type_formal_field_access*.vibe` pin the same
// refusals on both compile lanes; the controls below pin the ANSWERS of the
// adjacent shapes a refusal written one arm too wide would take with it.

import @vibe/compiler/checker {
  check_program
}

import @vibe/compiler/syntax {
  lex, parse_program
}

//# Helpers

fn first_check_error(source: String) -> String {
  handle {
    let _ = check_program(parse_program(lex(source)))
    ""
  } with { Exception::Throw(msg) => msg }
}

fn formal_message(tparam: String, field: String) -> String {
  String::concat("write the struct that declares `", String::concat(field, String::concat("` in place of the type parameter `", String::concat(tparam, String::concat("`; field access `.", String::concat(field, String::concat("` needs a struct, and a bound on `", String::concat(tparam, "` cannot promise one"))))))))
}

//# Controls (runtime answers)

struct Crate {
  payload: Int
}

struct Gbox[T] {
  payload: T
}

fn get_payload[T](b: Gbox[T]) -> T {
  b.payload
}

fn apply_crate(c: Crate, f: (Crate) -> Int) -> Int {
  f(c)
}

fn through_lambda(c: Crate) -> Int {
  apply_crate(c, (p) -> {
    p.payload
  })
}

//# Refusals

test "2848: a field read on a plain formal is refused, naming the binder" {
  let src = "struct Crate {\n  payload: Int\n}\nfn read[T](m: T) -> Int {\n  m.payload\n}\nfn main { () }\n"
  let msg = first_check_error(src)
  assert(String::contains(msg, formal_message("T", "payload")))
}

test "2848: refused whether or not some struct spells the field" {
  // The first half was silently wrong (read through `Crate`'s offset); the
  // second half was check-clean and failed only in the build. Same message.
  let src = "fn read[T](m: T) -> Int {\n  m.v\n}\nfn main { () }\n"
  let msg = first_check_error(src)
  assert(String::contains(msg, formal_message("T", "v")))
}

test "2848: a trait bound does not rescue the read" {
  let src = "struct Crate {\n  payload: Int\n}\nfn read[T: Eq](m: T) -> Int {\n  m.payload\n}\nfn main { () }\n"
  let msg = first_check_error(src)
  assert(String::contains(msg, formal_message("T", "payload")))
}

test "2848: a rigid HKT-related formal is refused by its source spelling" {
  // `A` of `F[A]` is bound as `CtNamed("#hktformal.A", [])`, which lands in
  // the `CtNamed` arm rather than the `CtVar` one. The message must say `A`.
  let src = "struct Crate {\n  payload: Int\n}\nfn read[F, A](xs: F[A], a: A) -> Int {\n  a.payload\n}\nfn main { () }\n"
  let msg = first_check_error(src)
  assert(String::contains(msg, formal_message("A", "payload")))
  assert(!String::contains(msg, "#hktformal"))
}

test "2848: a nested generic lambda's own formal is refused" {
  let src = "struct Crate {\n  payload: Int\n}\nfn outer() -> Int {\n  let inner = [U](m: U) -> Int {\n    m.payload\n  }\n  inner(7)\n}\nfn main { () }\n"
  let msg = first_check_error(src)
  assert(String::contains(msg, formal_message("U", "payload")))
}

test "2848: a formal captured by a plain closure is still the enclosing binder's" {
  let src = "struct Crate {\n  payload: Int\n}\nfn read[T](m: T) -> Int {\n  let f = () -> {\n    m.payload\n  }\n  f()\n}\nfn main { () }\n"
  let msg = first_check_error(src)
  assert(String::contains(msg, formal_message("T", "payload")))
}

test "2848: a local rebinding of the formal is refused too" {
  // `let y = m` gives `y` the same variable, or one unified with it in either
  // direction; the lookup follows the representative both ways.
  let src = "struct Crate {\n  payload: Int\n}\nfn read[T](m: T) -> Int {\n  let y = m\n  y.payload\n}\nfn main { () }\n"
  let msg = first_check_error(src)
  assert(String::contains(msg, formal_message("T", "payload")))
}

fn open_message(recv: String, field: String) -> String {
  String::concat("annotate `", String::concat(recv, String::concat("` with the struct that declares `", String::concat(field, String::concat("`; field access `.", String::concat(field, String::concat("` needs a struct, and this `let`-bound function leaves `", String::concat(recv, "`'s type open for every caller"))))))))
}

test "2848: a formal reached through a let-bound lambda's parameter is refused" {
  // Codex on #2864. At the read `p` is a fresh variable, and `let f = ...`
  // GENERALIZES it, so `f(m)` instantiates a copy and the recorded variable
  // never resolves. The `let` refuses the read as it quantifies, naming `p`.
  let src = "struct Crate {\n  payload: Int\n}\nfn read[T](m: T) -> Int {\n  let f = (p) -> {\n    p.payload\n  }\n  f(m)\n}\nfn main { () }\n"
  let msg = first_check_error(src)
  assert(String::contains(msg, open_message("p", "payload")))
}

test "2848: a let-bound lambda reading a field on its parameter is refused without any formal in scope" {
  let src = "struct Crate {\n  payload: Int\n}\nfn read(m: Option[Int]) -> Int {\n  let f = (p) -> {\n    p.payload\n  }\n  f(m)\n}\nfn main { () }\n"
  let msg = first_check_error(src)
  assert(String::contains(msg, open_message("p", "payload")))
}

test "2848: a top-level let-bound lambda is refused the same way" {
  let src = "struct Crate {\n  payload: Int\n}\nlet f = (p) -> {\n  p.payload\n}\nfn main { () }\n"
  let msg = first_check_error(src)
  assert(String::contains(msg, open_message("p", "payload")))
}

test "2848: a lambda parameter solved late by a call gets the concrete verdict" {
  // Argument position: `p` is not quantified, and `apply(m, ...)` unifies it
  // with `Option[Int]` inside the body. The read is recorded while `p` is
  // unsolved and judged again at the end of the body with the same arms.
  let src = "struct Crate {\n  payload: Int\n}\nfn apply(m: Option[Int], f: (Option[Int]) -> Int) -> Int {\n  f(m)\n}\nfn read(m: Option[Int]) -> Int {\n  apply(m, (p) -> {\n    p.payload\n  })\n}\nfn main { () }\n"
  let msg = first_check_error(src)
  assert(msg != "")
  assert(String::contains(msg, "`.payload`"))
}

test "2848: an impl method's `self` is judged against the impl target, not refused as open" {
  // `impl Tr for Crate { m(self) { self.payload } }` is lowered to
  // `let Crate::m = (self) -> ..` with `self` unannotated, so `self` is
  // quantified like any parameter. The binding's name says what it is, and
  // the read is judged against `Crate`: found, so accepted.
  let src = "struct Crate {\n  payload: Int\n}\ntrait Weigh {\n  weigh(Self) -> Int\n}\nimpl Weigh for Crate {\n  weigh(self) -> Int {\n    self.payload\n  }\n}\nfn main { () }\n"
  assert(first_check_error(src) == "")
}

test "2848: an impl method's `self` reading a field the target lacks is refused naming the target" {
  let src = "struct Crate {\n  payload: Int\n}\nstruct Other {\n  weight: Int\n}\ntrait Weigh {\n  weigh(Self) -> Int\n}\nimpl Weigh for Crate {\n  weigh(self) -> Int {\n    self.weight\n  }\n}\nfn main { () }\n"
  let msg = first_check_error(src)
  assert(String::contains(msg, "unknown field 'weight' on struct Crate"))
}

//# Controls (the refusal must not widen)

test "2848: a generic struct's field read in a generic body is accepted" {
  let src = "struct Gbox[T] {\n  payload: T\n}\nfn get[T](b: Gbox[T]) -> T {\n  b.payload\n}\nfn main { () }\n"
  assert(first_check_error(src) == "")
}

test "2848: an unannotated lambda parameter in argument position is not a formal" {
  // Its type is a fresh inference variable no `[T]` header recorded, so the
  // identity-keyed lookup answers nothing; the call unifies it with `Crate`
  // inside the body and the deferred judgement finds the field.
  let src = "struct Crate {\n  payload: Int\n}\nfn apply(c: Crate, f: (Crate) -> Int) -> Int {\n  f(c)\n}\nfn go(c: Crate) -> Int {\n  apply(c, (p) -> {\n    p.payload\n  })\n}\nfn main { () }\n"
  assert(first_check_error(src) == "")
}

test "2848: a formal passed through without a field read is accepted" {
  let src = "fn same[T](m: T) -> T {\n  m\n}\nfn main { () }\n"
  assert(first_check_error(src) == "")
}

test "2848: the accepted shapes still answer" {
  inspect(get_payload(Gbox::{ payload: 5 }), content = "5")
  inspect(String::length(get_payload(Gbox::{ payload: "abc" })), content = "3")
  inspect(through_lambda(Crate::{ payload: 8 }), content = "8")
}
