//# Imports

import @vibe/compiler/syntax {
  lex, print_expr
}

import ../parser.vibe {
  parse
}

//# Functions

export fn roundtrip(src: String) -> Bool with Error {
  let printed1 = print_expr(parse(lex(src)))
  let printed2 = print_expr(parse(lex(printed1)))
  printed1 == printed2
}

export fn roundtrip_eq(src: String, expected: String) -> Bool with Error {
  let printed = print_expr(parse(lex(src)))
  printed == expected
}
