//# Imports

import ./fixture_test_support.vibe {
  parse_fixture_spec
}

//# Functions

let fixture_root = "lib/@vibe/compiler/fixtures"

let contains_path: (Array[String], String) -> Bool = (paths, target) -> {
  let rec go: (Int) -> Bool = (i) -> {
    if i >= Array::length(paths) {
      false
    } else if Array::get(paths, i) == target {
      true
    } else {
      go(i + 1)
    }
  }
  go(0)
}

let is_http_p3_fixture: (String) -> Bool = (path) -> {
  String::contains(path, "/http_p3_")
}

let root_fixture_paths_from_entries: (String, Array[(String, Bool)]) -> Array[String] = (fixture_root, entries) -> {
  let files = ArrayBuilder::new()
  let mut i = 0
  while i < Array::length(entries) {
    let (name, is_file) = Array::get(entries, i)
    let path = String::concat(String::concat(fixture_root, "/"), name)
    if is_file && String::ends_with(path, ".vibe") {
      ArrayBuilder::push(files, path)
    }
    i = i + 1
  }
  ArrayBuilder::freeze(files)
}

//# Misc

test "real fixture spec accepts compile_error alias" {
  let spec = parse_fixture_spec("{\"compile_error\":\"Mismatch\"}", "fixture")
  match spec.error_contains {
    Some(msg) => assert(msg == "Mismatch"),
    None => assert(false)
  }
}

test "real fixture spec parses runtime fields" {
  let spec = parse_fixture_spec("{\"last\":\"15\",\"effects\":[\"ShellExec(\\\"echo hi\\\")\"],\"error_contains\":\"Mismatch\",\"todo\":true,\"skip\":true}", "fixture")
  match spec.last {
    Some(msg) => assert(msg == "15"),
    None => assert(false)
  }
  match spec.effects {
    Some(items) => {
      assert(Array::length(items) == 1)
      assert(Array::get(items, 0) == "ShellExec(\"echo hi\")")
    },
    None => assert(false)
  }
  match spec.error_contains {
    Some(msg) => assert(msg == "Mismatch"),
    None => assert(false)
  }
  assert(spec.todo)
  assert(spec.skip)
}

test "real fixture discovery lists root fixtures" {
  let files = root_fixture_paths_from_entries(fixture_root, [
    ("http_p3_skip.vibe", true),
    ("closure_capture.vibe", true),
    ("notes.txt", true),
    ("nested", false)
  ])
  assert(Array::length(files) > 0)
  assert(contains_path(files, "lib/@vibe/compiler/fixtures/closure_capture.vibe"))
}

test "real fixture discovery can exclude http p3" {
  let files = root_fixture_paths_from_entries(fixture_root, [
    ("http_p3_skip.vibe", true),
    ("closure_capture.vibe", true),
    ("math_ops.vibe", true),
    ("nested", false)
  ])
  let mut count = 0
  for path in files {
    if not(is_http_p3_fixture(path)) {
      count = count + 1
    }
  }
  assert(count > 0)
}

test "real fixture discovery has no stale todo files" {
  let files = root_fixture_paths_from_entries(fixture_root, [
    ("closure_capture.vibe", true),
    ("math_ops.vibe", true),
    ("todo_notes.txt", true),
    ("todo_nested", false)
  ])
  let mut stale = 0
  for path in files {
    let base = String::substring(path, String::length(String::concat(fixture_root, "/")), String::length(path))
    if String::length(base) >= 5 && base[0: 5] == "todo_" {
      stale = stale + 1
    }
  }
  assert(stale == 0)
}
