//# Imports

import @vibe/compiler/cache {
  build_fs_compile_wasi_artifact_fingerprint_for_entry_path, persistent_artifact_cache_path
}

import @vibe/compiler/entry/compiler/fs_compile {
  compile_file_fs_cached
}

import @vibe/compiler/loader {
  collect_source_groups_fs
}

import ../type_db.vibe {
  db_codegen_count, db_new
}

//# Functions

fn string_to_bytes(_ s: String) -> Bytes {
  let out = Bytes::new()
  let len = String::length(s)
  let mut i = 0
  while i < len {
    Bytes::push(out, value = String::char_code_at(s, at = i))
    i = i + 1
  }
  out
}

fn remove_file_if_exists(_ path: String) -> Unit with Fs {
  if Fs::exists(path) {
    Fs::remove(path)
  } else {
    ()
  }
}

//# Misc

test "compile_file_fs_cached: fresh db reuses persistent fs artifact cache" {
  let main_path = "/tmp/vibe_compiler_persistent_fs_compile_main.vibe"
  let source = "let _start: () -> Int = () -> { 40 + 2 }"
  Fs::write_bytes(main_path, bytes = string_to_bytes(source))
  let source_groups = collect_source_groups_fs(main_path)
  let cache_path = persistent_artifact_cache_path(kind = "fs-compile-wasi", entry_name = "_start", fingerprint = build_fs_compile_wasi_artifact_fingerprint_for_entry_path(source_groups = source_groups, entry_path = main_path, entry_name = "_start"))
  remove_file_if_exists(cache_path)
  let (_, db1) = compile_file_fs_cached(db = db_new(), entry_path = main_path, entry_name = "_start")
  assert(db_codegen_count(db1) > 0)
  let (_, db2) = compile_file_fs_cached(db = db_new(), entry_path = main_path, entry_name = "_start")
  assert(eq(db_codegen_count(db2), 0))
}
