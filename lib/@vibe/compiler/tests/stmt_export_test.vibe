//# Imports

import ./stmt_test_support.vibe {
  ps
}

//# Misc

test "stmt_let_mut" {
  assert(ps("let mut x = 0") == "let mut x = 0")
}

test "stmt_let_mut_typed" {
  assert(ps("let mut x: Int = 0") == "let mut x: Int = 0")
}

test "stmt_export_let" {
  assert(ps("export let x = 1") == "export let x = 1")
}

test "stmt_export_let_rec" {
  assert(ps("export let rec f = 1") == "export let rec f = 1")
}
