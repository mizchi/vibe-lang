//# Imports

import ./checker_parity_test_support.vibe {
  check_source_ok
}

//# Tests

/// A bare `break` as a match arm body is followed by the arm separator. It was
/// parsed as `break <payload>` and the `,` was reported as
/// `unexpected token: ,`, so `3 => break, _ => ..` -- the shape a loop that
/// exits on one case is written in -- did not compile.
test "a bare break before an arm comma parses" {
  assert(check_source_ok("fn f() -> Int {\n  let mut n = 0\n  while true {\n    match n { 3 => break, _ => n = n + 1 }\n  }\n  n\n}\nfn main() -> Int { f() }"))
  assert(check_source_ok("fn f(xs: Array[Int]) -> Int {\n  let mut s = 0\n  for x in xs {\n    match x { 0 => break, v => s = s + v }\n  }\n  s\n}\nfn main() -> Int { f([1, 0, 2]) }"))
}
