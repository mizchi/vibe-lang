import @vibe/parser {
  lex, parse_program
}
import @vibe/compiler/perceus {
  compute_heap_returning
}
import @vibe/compiler/codegen/expr {
  cl_own_return_stmts
}

fn contains(names: Array[String], target: String) -> Bool {
  let mut found = false
  for name in names {
    if name == target {
      found = true
    }
  }
  found
}

test "fresh inferred return spines enter the heap call index" {
  let stmts = parse_program(lex("let fresh = (n: Int) -> { [n] }\nlet block = (n: Int) -> { let next = n + 1; [next] }\nlet branch = (n: Int) -> { if n > 0 { [n] } else { [0] } }\nlet mixed = (xss: Array[Array[Int]], n: Int) -> { if n > 0 { [n] } else { Array::get(xss, 0) } }\nlet borrowed = (xss: Array[Array[Int]]) -> { Array::get(xss, 0) }"))
  let names = compute_heap_returning(stmts)
  inspect(contains(names, "fresh"), "true")
  inspect(contains(names, "block"), "true")
  inspect(contains(names, "branch"), "true")
  inspect(contains(names, "mixed"), "false")
  inspect(contains(names, "borrowed"), "false")
}

test "inferred enum and Double results enter the heap call index" {
  let stmts = parse_program(lex("enum Parcel { Packed(Array[Int]) }\nlet make = (n: Int) -> { Packed([n]) }\nlet calc = (x: Double) -> { x + 1.0 }\nlet shadow = (x: Double) -> { let x = 1; x + 1 }"))
  let names = compute_heap_returning(stmts)
  inspect(contains(names, "make"), "true")
  inspect(contains(names, "calc"), "true")
  inspect(contains(names, "shadow"), "false")
}

test "a normalized borrowed tail enters the owned-result index" {
  let stmts = parse_program(lex("let get = (xss: Array[Array[Int]]) -> { Array::get(xss, 0) }\nlet held = get"))
  cl_own_return_stmts(stmts)
  inspect(contains(compute_heap_returning(stmts), "get"), "true")
}

test "inferred forwarding reaches a fixed point without classifying borrowed calls" {
  let stmts = parse_program(lex("let third = (n: Int) -> { second(n) }\nlet second = (n: Int) -> { first(n) }\nlet first = (n: Int) -> { [n] }\nlet borrowed = (xss: Array[Array[Int]]) -> { Array::get(xss, 0) }\nlet forwarded_borrow = (xss: Array[Array[Int]]) -> { borrowed(xss) }"))
  let names = compute_heap_returning(stmts)
  inspect(contains(names, "first"), "true")
  inspect(contains(names, "second"), "true")
  inspect(contains(names, "third"), "true")
  inspect(contains(names, "borrowed"), "false")
  inspect(contains(names, "forwarded_borrow"), "false")
}

test "an owned local result enters the index while a borrowed local stays out" {
  let stmts = parse_program(lex("let make = (n: Int) -> { let xs = [n]; xs }\nlet borrowed = (xss: Array[Array[Int]]) -> { let xs = Array::get(xss, 0); xs }"))
  let names = compute_heap_returning(stmts)
  inspect(contains(names, "make"), "true")
  inspect(contains(names, "borrowed"), "false")
}

test "early returns participate in inferred ownership" {
  let stmts = parse_program(lex("let fresh = (n: Int) -> { if n < 0 { return [0] } else { [n] } }\nlet borrowed = (xss: Array[Array[Int]], n: Int) -> { if n < 0 { return Array::get(xss, 0) } else { [n] } }"))
  let names = compute_heap_returning(stmts)
  inspect(contains(names, "fresh"), "true")
  inspect(contains(names, "borrowed"), "false")
}

test "forwarding retains fixed-point discovery order" {
  let stmts = parse_program(lex("let third = () -> second()\nlet second = () -> first()\nlet first = () -> [1]"))
  let names = compute_heap_returning(stmts)
  inspect(Array::length(names), "3")
  inspect(Array::get(names, 0), "first")
  inspect(Array::get(names, 1), "second")
  inspect(Array::get(names, 2), "third")
}

test "parameters and local bindings shadow heap callees and constructors" {
  let stmts = parse_program(lex("enum Parcel { Packed(Array[Int]) }\nlet make = () -> [1]\nlet shadow_fn = (make: (Int) -> Int) -> make(0)\nlet shadow_ctor = (Packed: (Int) -> Int) -> Packed(0)\nlet local = () -> { let make = (n: Int) -> n; make(0) }\nlet fresh = () -> Packed([1])"))
  let names = compute_heap_returning(stmts)
  assert(contains(names, "make"))
  assert(contains(names, "fresh"))
  assert(!contains(names, "shadow_fn"))
  assert(!contains(names, "shadow_ctor"))
  assert(!contains(names, "local"))
}

test "declared return types take precedence over the inferred result spine" {
  // This helper classifies AST metadata; the checker separately rejects a
  // mismatched body. Neither of these deliberately mismatched bodies is run.
  let stmts = parse_program(lex("let scalar = (n: Int) -> Int { [n] }\nlet heap = (n: Int) -> Array[Int] { n }"))
  let names = compute_heap_returning(stmts)
  assert(!contains(names, "scalar"))
  assert(contains(names, "heap"))
}

test "heap-name membership belongs to one inference invocation" {
  let first = parse_program(lex("let make = () -> [1]"))
  let second = parse_program(lex("let make = () -> 1"))
  let saved = compute_heap_returning(first)
  inspect(Array::length(compute_heap_returning(second)), "0")
  inspect(Array::length(saved), "1")
  inspect(Array::get(saved, 0), "make")
  inspect(Array::length(compute_heap_returning(first)), "1")
}

test "duplicate definitions keep the union and append a forwarded result once" {
  let stmts = parse_program(lex("let caller = () -> same()\nlet same = () -> 0\nlet same = () -> [1]"))
  let names = compute_heap_returning(stmts)
  inspect(Array::length(names), "2")
  inspect(Array::get(names, 0), "same")
  inspect(Array::get(names, 1), "caller")
}
