import @vibe/parser {
  lex, parse_program
}
import @vibe/compiler/perceus {
  compute_heap_returning
}

fn contains(names: Array[String], target: String) -> Bool {
  let mut found = false
  for name in names {
    if name == target {
      found = true
    }
  }
  found
}

test "only direct fresh inferred returns enter the heap call index" {
  let stmts = parse_program(lex("let fresh = (n: Int) -> { [n] }\nlet borrowed = (xss: Array[Array[Int]]) -> { Array::get(xss, 0) }"))
  let names = compute_heap_returning(stmts)
  inspect(contains(names, "fresh"), "true")
  inspect(contains(names, "borrowed"), "false")
}
