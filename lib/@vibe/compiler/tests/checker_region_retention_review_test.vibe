import @vibe/compiler/checker {
  content_outer_param_indices,
  region_callee_returns_own_storage,
  region_content_outer_regions,
  retention_arg_predates,
  retention_begin_module,
  retention_end_module,
  retention_note_module_env,
  retention_summary_refuses,
  retention_type_hides_region,
  retention_value_regions
}
import @vibe/compiler/core {
  Expr, Pat, Subst, Type, TypeDef, TypeEnv, env_bind
}
import ./checker_parity_test_support.vibe {
  check_source_err_contains, check_source_ok
}

/// Retention overrides follow formal slots even while source arguments keep
/// their written labels and optional values have not been wrapped yet.
test "region retention checks the declared slots of labeled calls" {
  let head = "fn stash(dst: Array[() -> Array[Int]], value: () -> Array[Int]) -> Unit { Array::push(dst, value) }\n"
  let body = "fn main() -> Int { let outer: Array[() -> Array[Int]] = []; let _ = region r { let values = MutList::empty(r); "
  let capture = "() -> Array[Int] { MutList::to_array(values) }"
  assert(check_source_err_contains(source = head + body + "stash(dst = outer, value = " + capture + "); 0 }; 42 }", needle = "region escapes its scope"))
  assert(check_source_ok(head + body + "stash(dst = outer, value = () -> Array[Int] { [1, 2] }); 0 }; 42 }"))
}

/// Optional closure provenance belongs to the logical Some slot, and an
/// omitted optional value contributes None without a source child.
test "region retention checks optional logical arguments" {
  let head = "fn stash(dst: Array[() -> Array[Int]], value?: () -> Array[Int]) -> Unit { match value { Some(f) => Array::push(dst, f), None => () } }\n"
  let body = "fn main() -> Int { let outer: Array[() -> Array[Int]] = []; let _ = region r { let values = MutList::empty(r); "
  assert(check_source_err_contains(source = head + body + "stash(value = () -> Array[Int] { MutList::to_array(values) }, dst = outer); 0 }; 42 }", needle = "region escapes its scope"))
  assert(check_source_ok(head + body + "stash(dst = outer); 0 }; 42 }"))
}

/// Receiver dispatch prepends the receiver once, then aligns only the
/// explicit arguments with the method's declared parameters.
test "region retention aligns labeled method arguments after the receiver" {
  let head = "struct Sink { items: Array[() -> Array[Int]] }\nfn Sink::stash(self: Sink, tag: Int, value: () -> Array[Int]) -> Unit { Array::push(self.items, value) }\n"
  let body = "fn main() -> Int { let outside: Sink = Sink::{ items: [] }; let _ = region r { let values = MutList::empty(r); "
  assert(check_source_err_contains(source = head + body + "outside.stash(tag = 0, value = () -> Array[Int] { MutList::to_array(values) }); 0 }; 42 }", needle = "region escapes its scope"))
  assert(check_source_ok(head + body + "outside.stash(tag = 0, value = () -> Array[Int] { [1, 2] }); 0 }; 42 }"))
}

fn review_region_env() -> TypeEnv {
  let outside = env_bind(env = EnvEmpty, name = "f", ty = CtFn([], CtInt, None))
  let active = env_bind(env = outside, name = "#active_region", ty = CtNamed("#region_review", [
  ]))
  env_bind(env = active, name = "h", ty = CtNamed("TaskHandle", [
    CtNamed("#region_review", []),
    CtInt
  ]))
}

test "a declared alias is classified by its body before a builtin spelling" {
  let defs = [
    TDStruct("Box", [("v", CtNamed("T", []))], [], ["T"]),
    TDAlias("Sender", ["T"], CtNamed("Box", [CtNamed("T", [])]))
  ]
  assert(!retention_type_hides_region(t = CtNamed("Sender", [CtInt]), defs = defs))
  let retaining = [
    TDAlias("Sender", ["T"], CtNamed("TaskHandle", [CtNamed("T", [])]))
  ]
  assert(retention_type_hides_region(t = CtNamed("Sender", [CtInt]), defs = retaining))
}

test "tuple pattern provenance belongs to the selected component" {
  let env = review_region_env()
  let pair = ETuple([EIdent("h", 1), EIdent("f", 2)])
  let independent = EMatch(pair, [
    (PTuple([PWild, PBind("selected")]), EIdent("selected", 3))
  ])
  let selected_handle = EMatch(pair, [
    (PTuple([PBind("selected"), PWild]), EIdent("selected", 3))
  ])
  assert_eq(retention_value_regions(expr = independent, env = env, defs = [], s = SubstEmpty), [
  ])
  assert_eq(retention_value_regions(expr = selected_handle, env = env, defs = [], s = SubstEmpty), [
    "#region_review"
  ])
}

test "a write into a shadowing local does not taint the outer location" {
  let box = ERecord("Box", [("v", EInt(0))], [])
  let write = ECall(EIdent("store", 1), [EIdent("box", 2), EIdent("h", 3)], 1, [
  ])
  let inner = ELet("box", box, ESeq(write, EUnit), 10)
  let safe = ELet("box", box, ESeq(inner, EIdent("box", 4)), 11)
  let retaining = ELet("box", box, ESeq(write, EIdent("box", 4)), 11)
  assert_eq(retention_value_regions(expr = safe, env = review_region_env(), defs = [
  ], s = SubstEmpty), [])
  assert_eq(retention_value_regions(expr = retaining, env = review_region_env(), defs = [
  ], s = SubstEmpty), ["#region_review"])
}

test "a loop result carries early break values without tainting a consumed result" {
  let early = EIf(EBool(true), EBreak(Some(EIdent("h", 1))), EUnit)
  let loop_value = ELoop([], ESeq(early, EInt(0)))
  assert_eq(retention_value_regions(expr = loop_value, env = review_region_env(), defs = [
  ], s = SubstEmpty), ["#region_review"])
  let consumed = ESeq(loop_value, EInt(42))
  assert_eq(retention_value_regions(expr = consumed, env = review_region_env(), defs = [
  ], s = SubstEmpty), [])
}

test "a closure parameter shadows an outer location in the write scan" {
  let box = ERecord("Box", [("v", EInt(0))], [])
  let write = ECall(EIdent("store", 1), [EIdent("box", 2), EIdent("h", 3)], 1, [
  ])
  let inner = EFn([], [], [("box", None)], None, None, write)
  let safe = ELet("box", box, ESeq(inner, EIdent("box", 4)), 11)
  assert_eq(retention_value_regions(expr = safe, env = review_region_env(), defs = [
  ], s = SubstEmpty), [])
}

test "match and for binders own their locations, including genuine aliases" {
  let box = ERecord("Box", [("v", EInt(0))], [])
  let write = ECall(EIdent("store", 1), [EIdent("box", 2), EIdent("h", 3)], 1, [
  ])
  let inner_match = EMatch(box, [(PBind("box"), ESeq(write, EUnit))])
  let inner_for = EForIn("box", None, EArray([box]), ESeq(write, EUnit), -1)
  for inner in [inner_match, inner_for] {
    let safe = ELet("box", box, ESeq(inner, EIdent("box", 4)), 11)
    assert_eq(retention_value_regions(expr = safe, env = review_region_env(), defs = [
    ], s = SubstEmpty), [])
  }
  let same_location = EMatch(EIdent("box", 5), [
    (PBind("box"), ESeq(write, EUnit))
  ])
  let retaining = ELet("box", box, ESeq(same_location, EIdent("box", 4)), 11)
  assert_eq(retention_value_regions(expr = retaining, env = review_region_env(), defs = [
  ], s = SubstEmpty), ["#region_review"])
}

test "a recursive binding shadows the outer location before its initializer" {
  let box = ERecord("Box", [("v", EInt(0))], [])
  let inner = ELetRec("box", EFn([], [], [], None, None, EIdent("h", 1)), EUnit)
  let safe = ELet("box", box, ESeq(inner, EIdent("box", 4)), 11)
  assert_eq(retention_value_regions(expr = safe, env = review_region_env(), defs = [
  ], s = SubstEmpty), [])
}

test "a handler payload binder owns a different location from its outer namesake" {
  let box = ERecord("Box", [("v", EInt(0))], [])
  let write = ECall(EIdent("store", 1), [EIdent("box", 2), EIdent("h", 3)], 1, [
  ])
  let inner = EHandle(box, [(PCtor("E::P", [PBind("box")]), ESeq(write, EUnit))])
  let safe = ELet("box", box, ESeq(inner, EIdent("box", 4)), 11)
  assert_eq(retention_value_regions(expr = safe, env = review_region_env(), defs = [
  ], s = SubstEmpty), [])
}

test "recursive type arguments retain changed hidden regions with bounded expansion" {
  let defs = [
    TDEnum("Nest", ["T"], [
      ("Here", [CtNamed("T", [])]),
      ("Next", [CtNamed("Nest", [CtNamed("TaskHandle", [CtInt])])])
    ])
  ]
  assert(retention_type_hides_region(t = CtNamed("Nest", [CtInt]), defs = defs))
  let growing = [
    TDEnum("Grow", ["T"], [
      ("Here", [CtNamed("T", [])]),
      ("Next", [CtNamed("Grow", [CtArray(CtNamed("T", []))])])
    ])
  ]
  assert(!retention_type_hides_region(t = CtNamed("Grow", [CtInt]), defs = growing))
  assert(retention_type_hides_region(t = CtNamed("Grow", [
    CtNamed("TaskHandle", [CtInt])
  ]), defs = growing))
  let mutual = [
    TDAlias("Left", ["T"], CtNamed("Right", [CtNamed("T", [])])),
    TDEnum("Right", ["T"], [("Next", [CtNamed("Left", [CtFn([], CtInt, None)])])])
  ]
  assert(retention_type_hides_region(t = CtNamed("Left", [CtInt]), defs = mutual))
}

test "recursive self references add no region but external captures do" {
  let pure = ELetRec("self", EFn([], [], [], None, None, EIdent("self", 1)), EIdent("self", 2))
  let capturing = ELetRec("self", EFn([], [], [], None, None, ESeq(EIdent("self", 1), EIdent("h", 3))), EIdent("self", 2))
  assert_eq(retention_value_regions(expr = pure, env = review_region_env(), defs = [
  ], s = SubstEmpty), [])
  assert_eq(retention_value_regions(expr = capturing, env = review_region_env(), defs = [
  ], s = SubstEmpty), ["#region_review"])
}

test "a container stored in a holder inherits mutations through that holder" {
  let head = "fn main() -> Int { let sink: Array[() -> Int] = []; let _ = region r { let values = MutList::empty(r); let inner: Array[Array[() -> Int]] = []; let holder: Array[Array[Array[() -> Int]]] = []; "
  let tail = "Array::push(Array::get(inner, at = 0), value = () -> Int { MutList::length(values) }); 0 }; 42 }"
  assert(check_source_err_contains(source = head + "Array::push(holder, value = inner); Array::push(Array::get(holder, at = 0), value = sink); " + tail, needle = "region escapes its scope"))
}

test "a labeled callback receives the provenance of its accompanying container" {
  let head = "fn each(xs: Array[Array[Array[() -> Int]]], f: (Array[Array[() -> Int]]) -> Unit) -> Unit { f(Array::get(xs, at = 0)) }\nfn main() -> Int { let sink: Array[() -> Int] = []; let _ = region r { let values = MutList::empty(r); let holder: Array[Array[Array[() -> Int]]] = []; "
  assert(check_source_err_contains(source = head + "each(xs = holder, f = (x) -> { Array::push(x, value = sink) }); Array::push(Array::get(Array::get(holder, at = 0), at = 0), value = () -> Int { MutList::length(values) }); 0 }; 42 }", needle = "region escapes its scope"))
}

test "block result provenance resolves its lexical binder" {
  assert(check_source_ok("fn main() -> Int { let sink: Array[() -> Int] = []; let _ = region r { let values = MutList::empty(r); let holder: Array[Array[() -> Int]] = []; Array::push(holder, value = { let sink: Array[() -> Int] = []; sink }); Array::push(Array::get(holder, at = 0), value = () -> Int { MutList::length(values) }); 0 }; 42 }"))
}

test "an invoked lambda returning outer storage taints its holder" {
  assert(check_source_err_contains(source = "fn main() -> Int { let sink: Array[() -> Int] = []; let _ = region r { let values = MutList::empty(r); let holder: Array[Array[() -> Int]] = []; Array::push(holder, value = (() -> sink)()); Array::push(Array::get(holder, at = 0), value = () -> Int { MutList::length(values) }); 0 }; 42 }", needle = "region escapes its scope"))
}

test "a helper may append a region value to a fresh holder containing outer storage" {
  let head = "fn append(dst: Array[Array[() -> Int]], value: Array[() -> Int]) -> Unit { Array::push(dst, value) }\n"
  assert(check_source_ok(head + "fn main() -> Int { let sink: Array[() -> Int] = []; let _ = region r { let values = MutList::empty(r); let holder: Array[Array[() -> Int]] = []; Array::push(holder, value = sink); append(holder, [() -> Int { MutList::length(values) }]); 0 }; 42 }"))
}

test "a local callee shadows a module_env summary even without an import marker" {
  let saved = retention_begin_module([])
  let module_env = env_bind(env = EnvEmpty, name = "getter", ty = CtFn([], CtArray(CtInt), None))
  let module_env = env_bind(env = module_env, name = "#retains:getter", ty = CtNamed("", [
  ]))
  retention_note_module_env(module_env)
  assert(!region_callee_returns_own_storage(callee = "getter", env = module_env))
  let local = env_bind(env = module_env, name = "__capture_boundary__", ty = CtBool)
  let local = env_bind(env = local, name = "getter", ty = CtFn([], CtArray(CtInt), None))
  assert(region_callee_returns_own_storage(callee = "getter", env = local))
  retention_end_module(saved)
}

test "imported helper content rows taint only their receiving arguments" {
  let saved = retention_begin_module([])
  let module_env = env_bind(env = EnvEmpty, name = "fill", ty = CtFn([
    CtArray(CtArray(CtInt))
  ], CtUnit, None))
  let module_env = env_bind(env = module_env, name = "#retains:fill", ty = CtNamed("g>0", [
  ]))
  retention_note_module_env(module_env)
  let active = env_bind(env = module_env, name = "#active_region", ty = CtNamed("#region_review", [
  ]))
  let local = env_bind(env = active, name = "holder", ty = CtArray(CtArray(CtInt)))
  let scope = ECall(EIdent("fill", 1), [EIdent("holder", 2)], 1, [])
  let (same, held) = region_content_outer_regions(name = "holder", scope = scope, env = local, s = SubstEmpty)
  assert_eq(same, [])
  assert_eq(held, ["#region_review"])
  let marked = env_bind(env = local, name = "__region_outer_content__holder", ty = CtTuple([
    CtNamed("#region_review", [])
  ]))
  assert_eq(retention_arg_predates(arg = EIdent("holder", 2), env = marked), [])
  assert_eq(retention_arg_predates(arg = EDot(EIdent("holder", 2), "part", 3, 4), env = marked), [
    "#region_review"
  ])
  retention_end_module(saved)
}

test "helper outer stores follow the receiving parameter and respect local shadowing" {
  let module_env = env_bind(env = EnvEmpty, name = "sink", ty = CtArray(CtInt))
  let write = ECall(EIdent("Array::push", 1), [
    EIdent("dst", 2),
    EIdent("sink", 3)
  ], 1, [])
  let ps = [("dst", None)]
  assert_eq(content_outer_param_indices(params = ps, body = write, env = module_env), [
    0
  ])
  let local_write = ELet("dst", EArray([]), write, 4)
  assert_eq(content_outer_param_indices(params = ps, body = local_write, env = module_env), [
  ])
}

test "an unresolved method receiver preserves returned module storage" {
  let head = "let sink: Array[() -> Int] = []; struct Holder { n: Int } fn Holder::sink(self: Holder) -> Array[() -> Int] { sink }\n"
  assert(check_source_err_contains(source = head + "fn main() -> Int { let get = (h) -> h.sink(); let box = Holder::{ n: 0 }; let _ = region r { let values = MutList::empty(r); Array::push(get(box), value = () -> Int { MutList::length(values) }); 0 }; 42 }", needle = "region escapes its scope"))
}

test "import summaries distinguish an append from a write through existing contents" {
  let carried = [[], ["#region_review"]]
  let direct: Array[Array[String]] = [[], []]
  let contents = [["#region_review"], []]
  assert_eq(retention_summary_refuses(summary = "1>0", carried = carried, predates = direct, contents = contents), 0)
  assert_eq(retention_summary_refuses(summary = "1>0,1>c0", carried = carried, predates = direct, contents = contents), 1)
}
