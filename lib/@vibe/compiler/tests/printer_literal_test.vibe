//# Imports

import ./printer_test_support.vibe {
  roundtrip
}

//# Misc

test "roundtrip array" {
  let ok = handle {
    roundtrip("[1, 2, 3]")
  } with Exception {
    Throw(_) => false
  }
  assert(ok)
}

test "roundtrip tuple" {
  let ok = handle {
    roundtrip("(1, 2)")
  } with Exception {
    Throw(_) => false
  }
  assert(ok)
}

test "roundtrip unit" {
  let ok = handle {
    roundtrip("()")
  } with Exception {
    Throw(_) => false
  }
  assert(ok)
}
