fn expect_async_for_message(path: String, source: String) -> String with Fs {
  Fs::write_bytes(path, string_to_bytes(source))
  handle {
    let _ = check_linked_file(path)
    ""
  } with { Exception::Throw(m) => m }
}

test "mapped handle AsyncIter receivers require Async after package projection" {
  let path = "/tmp/vibe_async_iter_package_projection_cache_handle_v1.vibe"
  let source = "import @vibe/builtin { Array::iter, trait Mappable }\neffect Dummy {\n  Ping() -> Unit\n}\nfn main() -> Unit {\n  let ys = Mappable::map(handle { Array::iter([1]) } with { Dummy::Ping() => resume(()) }, (x: Int) -> Int { x + 1 })\n  for y in ys {\n    let _ = y\n  }\n  ()\n}\n"
  let msg = expect_async_for_message(path, source)
  assert(String::contains(msg, "async iterator awaits every step"))
}

test "mapped handle AsyncIter receivers are accepted with Async" {
  let path = "/tmp/vibe_async_iter_package_projection_cache_handle_ok_v1.vibe"
  let source = "import @vibe/builtin { Array::iter, trait Mappable }\neffect Dummy {\n  Ping() -> Unit\n}\nfn main() -> Unit with Async {\n  let ys = Mappable::map(handle { Array::iter([1]) } with { Dummy::Ping() => resume(()) }, (x: Int) -> Int { x + 1 })\n  for y in ys {\n    let _ = y\n  }\n  ()\n}\n"
  let msg = expect_async_for_message(path, source)
  assert(!String::contains(msg, "async iterator awaits every step"))
}

