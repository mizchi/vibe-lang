test "mapped conditional AsyncIter inputs require Async" {
  let path = "/tmp/vibe_async_iter_package_projection_cache_conditional_v1.vibe"
  let source = "import @vibe/builtin { Array::iter, map, trait Mappable }\nfn main(flag: Bool) -> Unit {\n  let ys = map(if flag { Array::iter([1]) } else { Array::iter([2]) }, (x: Int) -> Int { x + 1 })\n  for y in ys {\n    let _ = y\n  }\n  ()\n}\n"
  Fs::write_bytes(path, string_to_bytes(source))
  let msg = handle {
    let _ = check_linked_file(path)
    ""
  } with { Exception::Throw(m) => m }
  assert(String::contains(msg, "async iterator awaits every step"))
}

