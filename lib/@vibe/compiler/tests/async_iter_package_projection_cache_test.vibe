  let path = "/tmp/vibe_async_iter_package_projection_cache_alias_v1.vibe"
  let source = "import @vibe/builtin { Array::iter as to_iter, map, trait Mappable }\nfn main() -> Unit {\n  let ys = map(to_iter([1, 2]), (x: Int) -> Int { x + 1 })\n  for y in ys {\n    let _ = y\n  }\n  ()\n}\n"
