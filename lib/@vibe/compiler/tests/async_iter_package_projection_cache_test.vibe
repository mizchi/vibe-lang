test "user-defined imported AsyncIter fields stay synchronous" {
  let base_dir = "/tmp/vibe_async_iter_package_projection_cache_user_field_v1"
  Fs::mkdir_p(base_dir)
  let provider_path = String::concat(base_dir, "/provider.vibe")
  let main_path = String::concat(base_dir, "/main.vibe")
  let provider = "export struct AsyncIter[T] {\n  value: T\n}\nexport struct Holder {\n  stream: AsyncIter[Int]\n}\n"
  let source = "import ./provider.vibe { struct Holder }\nfn drain(holder: Holder) -> Unit {\n  for y in holder.stream {\n    let _ = y\n  }\n  ()\n}\n"
  Fs::write_bytes(provider_path, string_to_bytes(provider))
  let msg = expect_async_for_message(main_path, source)
  assert(!String::contains(msg, "async iterator awaits every step"))
}
