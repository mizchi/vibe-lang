test "importing Array::iter does not make an unrelated AsyncIter require Async" {
  let path = "/tmp/vibe_async_iter_package_projection_cache_provenance_v1.vibe"
  let source = "import @vibe/builtin { Array::iter }\nstruct AsyncIter {\n  n: Int\n}\nfn drain(xs: AsyncIter) -> Unit {\n  for y in xs {\n    let _ = y\n  }\n  ()\n}\nfn keep_iter() -> Unit {\n  let _ = Array::iter([1])\n  ()\n}\nfn main() -> Unit {\n  ()\n}\n"
  let msg = expect_async_for_message(path, source)
  assert(!String::contains(msg, "async iterator awaits every step"))
}

test "deprecated async_iter aliases still resolve" {
  let path = "/tmp/vibe_async_iter_package_projection_cache_deprecated_v1.vibe"
  let source = "import @vibe/builtin { async_iter_arr, async_iter_once, async_iter_map }\nfn main() -> Unit with Async {\n  let xs = async_iter_arr([1, 2])\n  let ys = async_iter_map(xs, (x: Int) -> Int { x + 1 })\n  let zs = async_iter_once(3)\n  for y in ys {\n    let _ = y\n  }\n  for z in zs {\n    let _ = z\n  }\n  ()\n}\n"
  let msg = expect_async_for_message(path, source)
  assert_eq(msg, "")
}

test "AsyncIter provenance survives a facade re-export" {
  let base_dir = "/tmp/vibe_async_iter_package_projection_cache_reexport_v2"
  let builtin_dir = String::concat(base_dir, "/@vibe/builtin")
  Fs::mkdir_p(builtin_dir)
  let provider_path = String::concat(builtin_dir, "/async_iter.vibe")
  let facade_path = String::concat(base_dir, "/facade.vibe")
  let main_path = String::concat(base_dir, "/main.vibe")
  let provider = "export trait AsyncIterator[T] {\n  next(Self) -> Future[Option[(T, Self)]]\n}\nexport struct AsyncIter[T] {\n  pull: (Int) -> Option[(T, Int)];\n  state: Int\n}\nimpl AsyncIterator for AsyncIter {\n  next(self) -> Future[Option[(T, AsyncIter)]] {\n    Future::ready(None)\n  }\n}\nexport fn Array::iter[T](xs: Array[T]) -> AsyncIter[T] {\n  AsyncIter::{ pull: (_i) -> Option[(T, Int)] { None }, state: Array::length(xs) }\n}\n"
  Fs::write_bytes(provider_path, string_to_bytes(provider))
  Fs::write_bytes(facade_path, string_to_bytes("export ./@vibe/builtin/async_iter.vibe { Array::iter }\n"))
  let source = "import ./facade.vibe { Array::iter }\nfn main() -> Unit {\n  for y in Array::iter([1, 2]) {\n    let _ = y\n  }\n  ()\n}\n"
  Fs::write_bytes(main_path, string_to_bytes(source))
  let msg = handle {
    let _ = check_linked_file(main_path)
    ""
  } with { Exception::Throw(m) => m }
  assert(String::contains(msg, "async iterator awaits every step"))
}

test "imported struct fields preserve AsyncIter provenance" {
  let base_dir = "/tmp/vibe_async_iter_package_projection_cache_direct_field_v4"
  Fs::mkdir_p(base_dir)
  let provider_path = String::concat(base_dir, "/provider.vibe")
  let main_path = String::concat(base_dir, "/main.vibe")
  let provider = "// direct field provenance v4\nimport @vibe/builtin { struct AsyncIter }\nexport struct Holder {\n  stream: AsyncIter[Int]\n}\n"
  let source = "import ./provider.vibe { struct Holder }\nfn drain(holder: Holder) -> Unit {\n  for y in holder.stream {\n    let _ = y\n  }\n  ()\n}\n"
  Fs::write_bytes(provider_path, string_to_bytes(provider))
  let msg = expect_async_for_message(main_path, source)
  assert(String::contains(msg, "async iterator awaits every step"))
}

