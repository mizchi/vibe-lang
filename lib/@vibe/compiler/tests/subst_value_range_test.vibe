// Conservative key bounds accelerate misses without replacing binding authority.
import @vibe/compiler/core {
  Subst, Type, collect_subst_bounds_pairs, subst_apply, subst_bind_value, subst_bounds_for, subst_lookup, types_equal
}

fn authoritative(_ s: Subst) -> Subst {
  match s {
    SubstEmpty => SubstEmpty,
    SubstBind(id, ty, rest) => SubstBind(id, ty, authoritative(rest)),
    SubstBound(id, bounds, rest) => SubstBound(id, bounds, authoritative(rest)),
    SubstCached(values, bounds, rest) => SubstCached(values, bounds, authoritative(rest)),
    SubstEffBind(name, value, rest) => SubstEffBind(name, value, authoritative(rest)),
    SubstValueRange(_, rest) => authoritative(rest)
  }
}

fn assert_result(actual: Option[Type], expected: Option[Type]) -> Unit {
  match actual {
    None => assert(expected is None),
    Some(a) => match expected {
      Some(b) => assert(types_equal(a = a, b = b)),
      None => assert(false)
    }
  }
}

fn agrees(s: Subst, ids: Array[Int]) -> Unit {
  let original = authoritative(s)
  for id in ids {
    assert_result(actual = subst_lookup(s = s, id = id), expected = subst_lookup(s = original, id = id))
  }
  ()
}

fn cache(key: String, value: Type, rest: Subst) -> Subst {
  let values: Map[String, Type] = Map::new()
  let bounds: Map[String, Array[String]] = Map::new()
  SubstCached(Map::set(values, key = key, value = value), bounds, rest)
}

test "negative first keys do not borrow a zero upper bound" {
  let s = subst_bind_value(id = -20, ty = CtInt, s = SubstEmpty)
  assert(s is SubstValueRange(-20, _))
  assert_result(actual = subst_lookup(s = s, id = -20), expected = Some(CtInt))
  agrees(s = s, ids = [-21, -20, -19, 0, 1])
}

test "duplicate keys retain the newest binding and earlier snapshots" {
  let old = subst_bind_value(id = 7, ty = CtInt, s = SubstEmpty)
  let newer = subst_bind_value(id = 7, ty = CtString, s = old)
  assert_result(actual = subst_lookup(s = old, id = 7), expected = Some(CtInt))
  assert_result(actual = subst_lookup(s = newer, id = 7), expected = Some(CtString))
  agrees(s = old, ids = [6, 7, 8])
  agrees(s = newer, ids = [6, 7, 8])
}

test "forks with reused ids keep their own values and maxima" {
  let common = subst_bind_value(id = 3, ty = CtBool, s = SubstEmpty)
  let left = subst_bind_value(id = 100, ty = CtInt, s = common)
  let right = subst_bind_value(id = 100, ty = CtString, s = common)
  let separate = subst_bind_value(id = -2, ty = CtUnit, s = SubstEmpty)
  agrees(s = common, ids = [-2, 3, 100, 101])
  agrees(s = left, ids = [3, 99, 100, 101])
  agrees(s = right, ids = [3, 99, 100, 101])
  agrees(s = separate, ids = [-3, -2, 3, 100])
  assert_result(actual = subst_lookup(s = common, id = 100), expected = None)
}

test "raw prefixes are included before a range is published" {
  let indexed = subst_bind_value(id = 5, ty = CtInt, s = SubstEmpty)
  let raw = SubstBind(900, CtString, SubstBound(2000, ["Eq"], SubstEffBind("e", "Fs", indexed)))
  let s = subst_bind_value(id = 6, ty = CtBool, s = raw)
  assert(s is SubstValueRange(900, _))
  agrees(s = s, ids = [4, 5, 6, 899, 900, 901, 2000])
}

test "an uncached raw chain is admitted from its actual keys" {
  let raw = SubstBind(-1, CtString, SubstBind(-100, CtInt, SubstEmpty))
  let s = subst_bind_value(id = -10, ty = CtBool, s = raw)
  assert(s is SubstValueRange(-1, _))
  agrees(s = s, ids = [-101, -100, -10, -1, 0])
}

test "arbitrary cached keys disable enclosing upper-bound coverage" {
  let indexed = subst_bind_value(id = 2, ty = CtInt, s = SubstEmpty)
  let cached = cache(key = "1000000", value = CtString, rest = indexed)
  let s = subst_bind_value(id = 3, ty = CtBool, s = cached)
  assert(s is SubstBind(_, _, _))
  assert_result(actual = subst_lookup(s = s, id = 1000000), expected = Some(CtString))
  agrees(s = s, ids = [1, 2, 3, 4, 1000000, 1000001])
}

test "cached head precedence and partial-cache misses remain exact" {
  let old = subst_bind_value(id = 7, ty = CtInt, s = subst_bind_value(id = 8, ty = CtBool, s = SubstEmpty))
  let head = cache(key = "7", value = CtString, rest = old)
  let s = subst_bind_value(id = 6, ty = CtUnit, s = head)
  assert_result(actual = subst_lookup(s = s, id = 7), expected = Some(CtString))
  assert_result(actual = subst_lookup(s = s, id = 8), expected = Some(CtBool))
  agrees(s = s, ids = [5, 6, 7, 8, 9])
}

test "cached key spelling is not normalized or used as a bound" {
  let s = subst_bind_value(id = 1, ty = CtUnit, s = cache(key = "07", value = CtString, rest = cache(key = "-3", value = CtBool, rest = SubstEmpty)))
  agrees(s = s, ids = [-4, -3, -2, 1, 7, 8])
  assert_result(actual = subst_lookup(s = s, id = 7), expected = None)
  assert_result(actual = subst_lookup(s = s, id = -3), expected = Some(CtBool))
}

test "signed large ids use full integer comparisons" {
  let big = 1<<40
  let s = subst_bind_value(id = big, ty = CtInt, s = subst_bind_value(id = 0 - big, ty = CtString, s = SubstEmpty))
  agrees(s = s, ids = [0 - big - 1, 0 - big, 0, big - 1, big, big + 1])
}

test "bounds and effects do not become value-binding keys" {
  let s = subst_bind_value(id = -9, ty = CtInt, s = SubstBound(1000, ["Show"], SubstEffBind("e", "Log", SubstEmpty)))
  assert(s is SubstValueRange(-9, _))
  agrees(s = s, ids = [-10, -9, -8, 0, 1000])
}

test "growing indexed chains preserve all hits and misses" {
  let mut s = SubstEmpty
  let mut i = 0
  while i < 512 {
    s = subst_bind_value(id = i * 2, ty = CtVar(i), s = s)
    i = i + 1
  }
  agrees(s = s, ids = [-1, 0, 1, 100, 101, 1022, 1023, 100000])
}

fn temporary_payload() -> Subst {
  subst_bind_value(id = 7, ty = CtNamed(String::concat("owned", "Type"), [
    CtArray(CtString)
  ]), s = SubstEmpty)
}

test "returned payloads survive temporary ranges and allocation pressure" {
  let result = subst_lookup(s = temporary_payload(), id = 7)
  let pressure: Array[String] = []
  let mut i = 0
  while i < 200 {
    Array::push(pressure, value = String::concat("replacement", __to_string(i)))
    i = i + 1
  }
  assert(Array::length(pressure) == 200)
  assert_result(actual = result, expected = Some(CtNamed("ownedType", [CtArray(CtString)])))
}

test "range frames preserve bound order duplicates and pair observations" {
  let old = subst_bind_value(id = 1, ty = CtBool, s = SubstBound(7, ["Old"], SubstEmpty))
  let s = subst_bind_value(id = 2, ty = CtString, s = SubstBound(7, ["New", "New"], old))
  let bounds = subst_bounds_for(s = s, id = 7)
  assert(bounds == ["New", "New", "Old"])
  let rows = collect_subst_bounds_pairs(s)
  assert(Array::length(rows) == 1)
  let (id, first) = Array::get(rows, at = 0)
  assert(id == 7)
  assert(first == ["New", "New"])
}

test "range frames remain transparent to effect and nested type resolution" {
  let s = subst_bind_value(id = 1, ty = CtInt, s = SubstEffBind("e", "f", SubstEffBind("f", "Fs", SubstEmpty)))
  let actual = subst_apply(s = s, ty = CtFn([CtVar(1), CtVar(99)], CtArray(CtVar(1)), Some("e")))
  assert(types_equal(a = actual, b = CtFn([CtInt, CtVar(99)], CtArray(CtInt), Some("Fs"))))
}
