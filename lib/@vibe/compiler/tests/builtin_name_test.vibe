//# Imports

import @vibe/compiler/core {
  canonical_builtin_name
}

//# Canonical builtin names

test "canonical_builtin_name normalizes every legacy alias" {
  let aliases = [
    ("Fs::ReadFile", "Fs::read_file"),
    ("Fs::WriteFile", "Fs::write_file"),
    ("Fs::ReadBytes", "Fs::read_bytes"),
    ("Fs::WriteBytes", "Fs::write_bytes"),
    ("Fs::Exists", "Fs::exists"),
    ("Fs::StatToken", "Fs::stat_token"),
    ("Fs::ReadDir", "Fs::readdir"),
    ("Fs::IsDir", "Fs::is_dir"),
    ("Fs::IsFile", "Fs::is_file"),
    ("Fs::Mkdir", "Fs::mkdir"),
    ("Fs::MkdirP", "Fs::mkdir_p"),
    ("Fs::Getcwd", "Fs::getcwd"),
    ("Fs::Chdir", "Fs::chdir"),
    ("Fs::Remove", "Fs::remove"),
    ("Fs::Copy", "Fs::copy"),
    ("Fs::Append", "Fs::append"),
    ("Fs::Rename", "Fs::rename"),
    ("Env::Get", "Env::get"),
    ("Env::ArgsLen", "Env::args_len"),
    ("Env::ArgsGet", "Env::args_get"),
    ("Profiler::NowUs", "Profiler::now_us"),
    ("Profiler::HeapBytes", "Profiler::heap_bytes"),
    ("String::byte_at", "String::char_code_at"),
    ("String::from_byte", "String::from_char_code"),
    ("StringBuilder::build", "StringBuilder::freeze")
  ]
  let mut i = 0
  while i < Array::length(aliases) {
    let (alias, canonical) = Array::get(aliases, i)
    assert(canonical_builtin_name(alias) == canonical)
    i = i + 1
  }
  assert(canonical_builtin_name("User::custom") == "User::custom")
}

// ADR-0101 (3) / #1262: `build` is the Builder family's terminal verb, so the
// type name and the verb correspond (`StringBuilder::build() -> String`).
// `freeze` stays the internal spelling (the registry row, every codegen
// dispatch) and keeps working from source; only the SOURCE-level canonical
// name moved. This pins the direction -- an accidental swap would make
// `freeze` the alias of a name codegen has never heard of.
test "StringBuilder::build resolves to the freeze registry row, not vice versa" {
  assert(canonical_builtin_name("StringBuilder::build") == "StringBuilder::freeze")
  assert(canonical_builtin_name("StringBuilder::freeze") == "StringBuilder::freeze")
}
