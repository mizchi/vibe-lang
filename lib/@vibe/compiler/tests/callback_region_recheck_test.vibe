import ./checker_parity_test_support.vibe {
  check_source_ok, check_source_report
}

// #3255: a closure handed to a call is checked again once the call has typed
// its parameter (`lambda_arg_elem_write_check` / `lambda_arg_param_write_check`).
// That re-check used to be a syntactic scan of the closure, which judged a
// call inside it by the callee's SPELLING and never read a program callee's
// body. Measured on main d764ee4f6:
//
// - a program helper that stores its argument was accepted inside an
//   `Array::map` callback (the same call in `for c in cells` is refused), so
//   a region value outlived its region;
// - a program `fn Array::push` that keeps nothing was refused there as if it
//   were the builtin (the same call in `for c in cells` is fine);
// - a program `fn Array::push` that keeps its value, called with a labeled
//   receiver, was accepted, because the scan matched only the builtin's
//   positional shape.
//
// The callback is now checked again by the checker itself, so it answers as
// the loop does.

let keep_helper = "fn keep(xs: Array[MutList[Int]], v: MutList[Int]) -> Unit {\n  Array::push(xs, value = v)\n}\n"

test "a program helper that stores the callback's element is refused by its body" {
  let src = String::concat(keep_helper, "fn build() -> Int {\n  let sink: Array[MutList[Int]] = []\n  region r {\n    let cells = [MutList::empty(r)]\n    let _ = Array::map(cells, f = (c) -> {\n      keep(xs = sink, v = c)\n      0\n    })\n    0\n  }\n}\n")
  inspect(check_source_report(src), content = "region escapes its scope: this call to `keep` stores a value that captures this region into an outer binding")
}

test "the helper reached through a named callback, a filter and a fold is refused too" {
  let src = String::concat(keep_helper, "fn build() -> Int {\n  let sink: Array[MutList[Int]] = []\n  region r {\n    let cells = [MutList::empty(r)]\n    let stash = (c) -> {\n      keep(xs = sink, v = c)\n      true\n    }\n    let _ = Array::filter(cells, f = stash)\n    Array::fold(cells, init = 0, f = (acc, c) -> {\n      keep(xs = sink, v = c)\n      acc\n    })\n  }\n}\n")
  assert(String::contains(check_source_report(src), needle = "this call to `keep` stores a value that captures this region"))
}

test "a helper that keeps the element inside the region is fine" {
  let src = String::concat(keep_helper, "fn build() -> Int {\n  region r {\n    let local: Array[MutList[Int]] = []\n    let cells = [MutList::empty(r)]\n    let _ = Array::map(cells, f = (c) -> {\n      keep(xs = local, v = c)\n      0\n    })\n    Array::length(local)\n  }\n}\n")
  assert(check_source_ok(src))
}

test "a program Array::push that keeps nothing is not judged as the builtin inside a callback" {
  let src = "fn Array::push(_ xs: Array[MutList[Int]], value: MutList[Int]) -> Int {\n  let _ = xs\n  MutList::length(value)\n}\nfn build() -> Int {\n  let sink: Array[MutList[Int]] = []\n  region r {\n    let cells = [MutList::empty(r)]\n    let got = Array::map(cells, f = (c) -> Array::push(sink, value = c))\n    Array::length(got)\n  }\n}\n"
  assert(check_source_ok(src))
}

test "a program Array::push that keeps its value is refused by its body inside a callback" {
  let src = "fn Array::push(xs: Array[Array[MutList[Int]]], value: MutList[Int]) -> Unit {\n  let inner = xs[0]\n  inner[0] = value\n}\nfn build() -> Int {\n  let sink: Array[Array[MutList[Int]]] = []\n  region r {\n    let cells = [MutList::empty(r)]\n    let _ = Array::map(cells, f = (c) -> {\n      Array::push(xs = sink, value = c)\n      0\n    })\n    0\n  }\n}\n"
  inspect(check_source_report(src), content = "region escapes its scope: this call to `Array::push` stores a value that captures this region into an outer binding")
}

test "the builtin Array::push inside a callback is still refused as a container write" {
  let src = "fn build() -> Int {\n  let sink: Array[MutList[Int]] = []\n  region r {\n    let cells = [MutList::empty(r)]\n    let _ = Array::map(cells, f = (c) -> {\n      Array::push(sink, value = c)\n      0\n    })\n    0\n  }\n}\n"
  inspect(check_source_report(src), content = "region escapes its scope: a container write stores a value that captures this region into an outer binding")
}

// Codex on #4047: a re-check of a callback is keyed by the closure and the
// shape it is checked at, so a recursive callback re-checked inside its own
// re-check ends there instead of running into the depth guard, whose answer
// is a refusal.
let walk_through_literal = "    let rec walk = (c) -> {\n      let _ = Array::map([c], f = (d) -> walk(d))\n      MutList::length(c)\n    }\n"

test "a recursive callback that stores nothing is accepted, reachable or not" {
  let reached = String::concat("fn build() -> Int {\n  region r {\n    let cells = [MutList::empty(r)]\n", String::concat(walk_through_literal, "    let got = Array::map(cells, f = walk)\n    Array::length(got)\n  }\n}\n"))
  assert(check_source_ok(reached))
  let unreached = "fn build() -> Int {\n  region r {\n    let cells = [MutList::empty(r)]\n    let rec walk = (c) -> {\n      if false {\n        let _ = Array::map([c], f = (d) -> walk(d))\n        0\n      } else {\n        MutList::length(c)\n      }\n    }\n    let got = Array::map(cells, f = walk)\n    Array::length(got)\n  }\n}\n"
  assert(check_source_ok(unreached))
}

test "a recursive callback that stores its element outside is refused" {
  let src = "fn build() -> Int {\n  let sink: Array[MutList[Int]] = []\n  region r {\n    let cells = [MutList::empty(r)]\n    let rec walk = (c) -> {\n      Array::push(sink, value = c)\n      let _ = Array::map([c], f = (d) -> walk(d))\n      0\n    }\n    let got = Array::map(cells, f = walk)\n    Array::length(got)\n  }\n}\n"
  assert(String::contains(check_source_report(src), needle = "region escapes its scope: a container write stores a value that captures this region"))
}

// #4049: a callback that is not a closure literal was not checked again at
// all, and `Array::fold`'s accumulator was checked as a local. Measured on
// the #4047 branch, each of these checked clean and the region value outlived
// its region; the same call in a loop body was refused.

let stash_helper = "let kept: Array[MutList[Int]] = []\nfn stash(c: MutList[Int]) -> Int {\n  Array::push(kept, value = c)\n  0\n}\n"

test "a top-level function handed by name is refused by its body" {
  let src = String::concat(stash_helper, "fn build() -> Int {\n  region r {\n    let cells = [MutList::empty(r)]\n    let _ = Array::map(cells, f = stash)\n    0\n  }\n}\n")
  inspect(check_source_report(src), content = "region escapes its scope: this call to `stash` stores a value that captures this region into an outer binding")
}

test "a let alias of a top-level function and a filter by name are refused too" {
  let src = String::concat(stash_helper, "fn keeps(c: MutList[Int]) -> Bool {\n  Array::push(kept, value = c)\n  true\n}\nfn build() -> Int {\n  region r {\n    let cells = [MutList::empty(r)]\n    let s = stash\n    let _ = Array::map(cells, f = s)\n    let _ = Array::filter(cells, f = keeps)\n    0\n  }\n}\n")
  let report = check_source_report(src)
  assert(String::contains(report, needle = "this call to `s` stores a value that captures this region"))
  assert(String::contains(report, needle = "this call to `keeps` stores a value that captures this region"))
}

test "a function parameter handed to a callback builtin inside the region is refused" {
  let src = "fn build(cb: (MutList[Int]) -> Int) -> Int {\n  region r {\n    let cells = [MutList::empty(r)]\n    let _ = Array::map(cells, f = cb)\n    0\n  }\n}\n"
  inspect(check_source_report(src), content = "region escapes its scope: this call passes a value that captures this region to `cb`, a function whose body the checker cannot see, so it may keep the value after the region ends")
}

test "a push into the fold accumulator is a write of the binding it started as" {
  let src = "fn build() -> Int {\n  let sink: Array[MutList[Int]] = []\n  region r {\n    let cells = [MutList::empty(r)]\n    let _ = Array::fold(cells, init = sink, f = (acc, c) -> {\n      Array::push(acc, value = c)\n      acc\n    })\n    0\n  }\n}\n"
  inspect(check_source_report(src), content = "region escapes its scope: a container write stores a value that captures this region into an outer binding")
}

test "a captured region value pushed into the fold accumulator is refused even over plain elements" {
  let src = "fn build() -> Int {\n  let sink: Array[MutList[Int]] = []\n  region r {\n    let cell = MutList::empty(r)\n    let _ = Array::fold([1, 2], init = sink, f = (acc, x) -> {\n      Array::push(acc, value = cell)\n      acc\n    })\n    0\n  }\n}\n"
  inspect(check_source_report(src), content = "region escapes its scope: a container write stores a value that captures this region into an outer binding")
}

test "a named callback that keeps nothing and a fold over plain values are fine" {
  let src = "fn size(c: MutList[Int]) -> Int {\n  MutList::length(c)\n}\nfn build() -> Int {\n  region r {\n    let cells = [MutList::empty(r)]\n    let got = Array::map(cells, f = size)\n    Array::fold([1, 2], init = Array::get(got, at = 0), f = (acc, x) -> acc + x)\n  }\n}\n"
  assert(check_source_ok(src))
}

test "a recursive top-level function handed by name is re-checked once per shape" {
  let walk = "fn walk(c: MutList[Int]) -> Int {\n  let _ = Array::map([c], f = walk)\n  MutList::length(c)\n}\n"
  let src = String::concat(walk, "fn build() -> Int {\n  region r {\n    let cells = [MutList::empty(r)]\n    let got = Array::map(cells, f = walk)\n    Array::length(got)\n  }\n}\n")
  assert(check_source_ok(src))
  let keeps = "let kept: Array[MutList[Int]] = []\nfn walk(c: MutList[Int]) -> Int {\n  Array::push(kept, value = c)\n  let _ = Array::map([c], f = walk)\n  0\n}\n"
  let refused = String::concat(keeps, "fn build() -> Int {\n  region r {\n    let cells = [MutList::empty(r)]\n    let got = Array::map(cells, f = walk)\n    Array::length(got)\n  }\n}\n")
  assert(String::contains(check_source_report(refused), needle = "this call to `walk` stores a value that captures this region"))
}

// #4050: an element callback's parameter is an element of the receiver, so
// over a container declared outside the region it is an alias of that
// container, as `Array::get(boxes, at = 0)` is.
let outer_boxes = "  let outer: Array[MutList[Int]] = []\n  let boxes = [outer]\n"

test "a region value written into an element of an outer container by a callback is refused" {
  let map_src = String::concat("fn build() -> Int {\n", String::concat(outer_boxes, "  region r {\n    let cell = MutList::empty(r)\n    let _ = Array::map(boxes, f = (a) -> {\n      Array::push(a, value = cell)\n      0\n    })\n    0\n  }\n}\n"))
  inspect(check_source_report(map_src), content = "region escapes its scope: a container write stores a value that captures this region into an outer binding")
  let fold_src = String::concat("fn build() -> Int {\n", String::concat(outer_boxes, "  region r {\n    let cell = MutList::empty(r)\n    Array::fold(boxes, init = 0, f = (acc, a) -> {\n      Array::push(a, value = cell)\n      acc\n    })\n  }\n}\n"))
  inspect(check_source_report(fold_src), content = "region escapes its scope: a container write stores a value that captures this region into an outer binding")
}

test "a callback that only reads an outer container's elements, or fills an inner one, is fine" {
  let src = "fn build() -> Int {\n  let outer: Array[Int] = []\n  let boxes = [outer]\n  region r {\n    let cell = MutList::empty(r)\n    let sizes = Array::map(boxes, f = (a) -> {\n      Array::push(a, value = MutList::length(cell))\n      Array::length(a)\n    })\n    let inner: Array[MutList[Int]] = []\n    let _ = Array::map([inner], f = (b) -> {\n      Array::push(b, value = cell)\n      0\n    })\n    Array::get(sizes, at = 0)\n  }\n}\n"
  assert(check_source_ok(src))
}

// Codex on #4057: a fold accumulator, or an element of an outer container,
// counts as an alias of an outer binding only where its type can hold a
// region value. A `let mut` callback over scalars is not refused as
// untraceable: nothing of the region can cross it.
test "a mutable callback over scalars is not refused for its accumulator or outer elements" {
  let fold_src = "fn build() -> Int {\n  region r {\n    let cell = MutList::empty(r)\n    let mut add = (a: Int, b: Int) -> a + b\n    add = (a: Int, b: Int) -> a + b + 0\n    Array::fold([1, 2], init = MutList::length(cell), f = add)\n  }\n}\n"
  assert(check_source_ok(fold_src))
  let map_src = "fn build() -> Int {\n  let pre: Array[Int] = [1, 2]\n  region r {\n    let cell = MutList::empty(r)\n    let mut inc = (x: Int) -> x + 1\n    inc = (x: Int) -> x + 2\n    let got = Array::map(pre, f = inc)\n    Array::get(got, at = 1) + MutList::length(cell)\n  }\n}\n"
  assert(check_source_ok(map_src))
}

test "a mutable callback over an accumulator that can hold region values is still refused" {
  let src = "fn build() -> Int {\n  let sink: Array[MutList[Int]] = []\n  region r {\n    let cells = [MutList::empty(r)]\n    let mut keep = (acc: Array[MutList[Int]], c: MutList[Int]) -> acc\n    keep = (acc: Array[MutList[Int]], c: MutList[Int]) -> acc\n    let _ = Array::fold(cells, init = sink, f = keep)\n    0\n  }\n}\n"
  assert(String::contains(check_source_report(src), needle = "bind `keep` to the closure with `let`"))
}

// Codex on #4057: a receiver or accumulator is an alias of the regions its
// location predates, not of every active region. Declared inside `region r`
// and used inside a nested `region s`, it may hold `r`'s values but not `s`'s;
// declared outside both, neither.
test "a container declared inside an outer region may take that region's values in a nested one" {
  assert(check_source_ok("fn build() -> Int {\n  let v = region r {\n    let cell = MutList::empty(r)\n    MutList::push(cell, 3)\n    let outer: Array[MutList[Int]] = []\n    let boxes = [outer]\n    let got = region s {\n      let _ = Array::map(boxes, f = (a) -> {\n        Array::push(a, value = cell)\n        0\n      })\n      1\n    }\n    got + Array::length(outer)\n  }\n  v\n}\n"))
  assert(check_source_ok("fn build() -> Int {\n  let v = region r {\n    let cell = MutList::empty(r)\n    MutList::push(cell, 3)\n    let mine: Array[MutList[Int]] = []\n    let got = region s {\n      let kept = Array::fold([1, 2], init = mine, f = (acc, x) -> {\n        Array::push(acc, value = cell)\n        acc\n      })\n      Array::length(kept)\n    }\n    got + Array::length(mine)\n  }\n  v\n}\n"))
}

test "a container may not take a value of a region it predates, nested or not" {
  assert(String::contains(check_source_report("fn build() -> Int {\n  let v = region r {\n    let outer: Array[MutList[Int]] = []\n    let boxes = [outer]\n    let got = region s {\n      let cell = MutList::empty(s)\n      MutList::push(cell, 3)\n      let _ = Array::map(boxes, f = (a) -> {\n        Array::push(a, value = cell)\n        0\n      })\n      1\n    }\n    got + Array::length(outer)\n  }\n  v\n}\n"), needle = "region escapes its scope"))
  assert(String::contains(check_source_report("fn build() -> Int {\n  let outer: Array[MutList[Int]] = []\n  let boxes = [outer]\n  let v = region r {\n    let cell = MutList::empty(r)\n    MutList::push(cell, 3)\n    region s {\n      let _ = Array::map(boxes, f = (a) -> {\n        Array::push(a, value = cell)\n        0\n      })\n      1\n    }\n  }\n  v\n}\n"), needle = "region escapes its scope"))
  assert(String::contains(check_source_report("fn build() -> Int {\n  let outer: Array[MutList[Int]] = []\n  let boxes = [outer]\n  let v = region r {\n    region s {\n      let cell = MutList::empty(s)\n      MutList::push(cell, 3)\n      let _ = Array::map(boxes, f = (a) -> {\n        Array::push(a, value = cell)\n        0\n      })\n      1\n    }\n  }\n  v\n}\n"), needle = "region escapes its scope"))
  assert(String::contains(check_source_report("fn build() -> Int {\n  let v = region r {\n    let mine: Array[MutList[Int]] = []\n    let got = region s {\n      let cell = MutList::empty(s)\n      MutList::push(cell, 3)\n      let _ = Array::fold([1, 2], init = mine, f = (acc, x) -> {\n        Array::push(acc, value = cell)\n        acc\n      })\n      1\n    }\n    got + Array::length(mine)\n  }\n  v\n}\n"), needle = "region escapes its scope"))
  assert(String::contains(check_source_report("fn build() -> Int {\n  let sink: Array[MutList[Int]] = []\n  let v = region r {\n    let cell = MutList::empty(r)\n    MutList::push(cell, 3)\n    region s {\n      let _ = Array::fold([1, 2], init = sink, f = (acc, x) -> {\n        Array::push(acc, value = cell)\n        acc\n      })\n      1\n    }\n  }\n  v\n}\n"), needle = "region escapes its scope"))
  assert(String::contains(check_source_report("fn build() -> Int {\n  let sink: Array[MutList[Int]] = []\n  let v = region r {\n    let cell = MutList::empty(r)\n    MutList::push(cell, 3)\n    let mine: Array[MutList[Int]] = []\n    region s {\n      let _ = Array::fold([1, 2], init = mine, f = (acc, x) -> {\n        Array::push(acc, value = cell)\n        sink\n      })\n      1\n    }\n  }\n  v\n}\n"), needle = "region escapes its scope"))
}

// Codex on #4078: a fold's accumulator is whatever the callback returned, so
// its location is read from the callback's result. Only a parameter the body
// neither shadows nor assigns, or a fresh literal of such values, narrows it;
// a call, a captured binding the body reassigns, or a name the body declares
// predates every active region. Each of these compiled on 55e4d06d6 and put a
// region list into a binding declared before the region.
test "a fold callback that returns a location the text does not establish predates every region" {
  let getter = "let kept: Array[MutList[Int]] = []\nfn get_sink() -> Array[MutList[Int]] {\n  kept\n}\n"
  let head = "  region r {\n    let cell = MutList::empty(r)\n    MutList::push(cell, 3)\n    let mine: Array[MutList[Int]] = []\n"
  let push = "      Array::push(acc, value = cell)\n"
  assert(String::contains(check_source_report(String::concat(getter, String::concat("fn build() -> Int {\n", String::concat(head, String::concat("    let _ = Array::fold([1, 2], init = mine, f = (acc, x) -> {\n", String::concat(push, "      get_sink()\n    })\n    1\n  }\n}\n")))))), needle = "region escapes its scope"))
  assert(String::contains(check_source_report(String::concat("fn build() -> Int {\n  let sink: Array[MutList[Int]] = []\n  let get = () -> sink\n", String::concat(head, String::concat("    let _ = Array::fold([1, 2], init = mine, f = (acc, x) -> {\n", String::concat(push, "      get()\n    })\n    1\n  }\n}\n"))))), needle = "region escapes its scope"))
  assert(String::contains(check_source_report(String::concat(getter, String::concat("fn build() -> Int {\n", String::concat(head, String::concat("    let _ = Array::fold([1, 2], init = mine, f = (acc, x) -> {\n", String::concat(push, "      let acc = get_sink()\n      acc\n    })\n    1\n  }\n}\n")))))), needle = "region escapes its scope"))
  assert(String::contains(check_source_report(String::concat(getter, String::concat("fn build() -> Int {\n", String::concat(head, String::concat("    let spare: Array[MutList[Int]] = []\n    let mut last = spare\n    let _ = Array::fold([1, 2], init = mine, f = (acc, x) -> {\n", String::concat(push, "      last = get_sink()\n      last\n    })\n    1\n  }\n}\n")))))), needle = "region escapes its scope"))
  // A literal's item is not judged by its type: in the definition scope `h`
  // and `f` are the outer scalar-holding bindings, not the ones the body binds.
  let holder = "struct Nums {\n  items: Int\n}\nstruct Holder {\n  items: Array[MutList[Int]]\n}\n"
  let fold_head = "  region r {\n    let cell = MutList::empty(r)\n    MutList::push(cell, 3)\n    let mine = Holder::{ items: [] }\n    let _ = Array::fold([1, 2], init = mine, f = (acc, x) -> {\n      Array::push(acc.items, value = cell)\n"
  assert(String::contains(check_source_report(String::concat(holder, String::concat("fn build() -> Int {\n  let sink: Array[MutList[Int]] = []\n  let h = Nums::{ items: 0 }\n", String::concat(fold_head, "      let h = Holder::{ items: sink }\n      Holder::{ items: h.items }\n    })\n    h.items\n  }\n}\n")))), needle = "region escapes its scope"))
  assert(String::contains(check_source_report(String::concat(holder, String::concat("fn build() -> Int {\n  let sink: Array[MutList[Int]] = []\n  let f = () -> 0\n", String::concat(fold_head, "      let f = () -> sink\n      Holder::{ items: f() }\n    })\n    f()\n  }\n}\n")))), needle = "region escapes its scope"))
}
