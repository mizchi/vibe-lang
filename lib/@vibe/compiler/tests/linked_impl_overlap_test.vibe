//# Imports

import @vibe/compiler/contract {
  contract_facade_marker, vpkg_shared_import_marker, vpkg_types_module_marker
}

import @vibe/compiler/core {
  Stmt, linked_impl_overlap_error, linked_unit
}

import @vibe/compiler/loader {
  vpkg_types_module_path_prefix
}

import @vibe/compiler/runtime {
  db_grouped_merged_source, db_new
}

import @vibe/compiler/syntax {
  lex, parse_program
}

//# Helpers

/// Lay `modules` (path, source) out as one linked program, unit by unit, and
/// answer the overlap refusal (or `ok`).
fn link_verdict(modules: Array[(String, String)]) -> String with Exception {
  let merged: Array[Stmt] = []
  let units = []
  for entry in modules {
    let (path, source) = entry
    let start = Array::length(merged)
    for stmt in parse_program(lex(source)) {
      Array::push(merged, stmt)
    }
    Array::push(units, linked_unit(path, source, start, Array::length(merged)))
  }
  match linked_impl_overlap_error(merged, units) {
    Some(msg) => msg,
    None => "ok"
  }
}

/// Merge `groups` through the grouped runtime merge (the lane the compiler's
/// self-compile takes) and answer its refusal, or `ok`.
fn grouped_verdict(groups: Array[(String, Array[(String, String)])]) -> String with Env {
  handle {
    let _ = db_grouped_merged_source(db_new(), groups)
    "ok"
  } with { Exception::Throw(msg) => msg }
}

let trait_src = "export trait Name {\n  name(Self) -> String\n}\n"

let impl_a = "impl Name for Int {\n  name(x: Int) -> String { \"from-a\" }\n}\n"

let impl_b = "fn helper() -> Int { 1 }\n\nimpl Name for Int {\n  name(x: Int) -> String { \"from-b\" }\n}\n"

//# Tests

/// #3544: two modules each implementing one trait for one type put two
/// `Int::name` definitions into the linked program; the refusal names both
/// positions and leads with the edit.
test "two modules implementing one trait for one type are refused" {
  inspect(link_verdict([
    ("tr.vibe", trait_src),
    ("ta.vibe", impl_a),
    ("tb.vibe", impl_b)
  ]), content = "tb.vibe: line 3:1: remove one of these: `impl Name for Int` here and `impl Name for Int` in ta.vibe: line 1:1 both define `Int::name` -- a linked program keeps only one of them, chosen by import order, so every caller, in either module, would silently run that one")
}

/// One module's impls are the checker's business, and a module reached twice
/// is merged once: neither is a cross-module overlap.
test "impls within one unit and distinct targets are accepted" {
  inspect(link_verdict([("tr.vibe", trait_src), ("ta.vibe", impl_a)]), content = "ok")
  let impl_bool = "impl Name for Bool {\n  name(x: Bool) -> String { \"bool\" }\n}\n"
  inspect(link_verdict([
    ("tr.vibe", trait_src),
    ("ta.vibe", impl_a),
    ("tc.vibe", impl_bool)
  ]), content = "ok")
}

/// Two different traits whose methods share a name collapse the same way.
test "different traits binding one method name are refused" {
  let label = "export trait Label {\n  name(Self) -> String\n}\n\nimpl Label for Int {\n  name(x: Int) -> String { \"label\" }\n}\n"
  inspect(link_verdict([
    ("tr.vibe", trait_src),
    ("ta.vibe", impl_a),
    ("tl.vibe", label)
  ]), content = "tl.vibe: line 5:1: remove one of these: `impl Label for Int` here and `impl Name for Int` in ta.vibe: line 1:1 both define `Int::name` -- a linked program keeps only one of them, chosen by import order, so every caller, in either module, would silently run that one")
}

/// A derive is the impl it registers: with an impl of the same trait it is the
/// overlap one module may not hold either.
test "a derive and an impl in another module are refused" {
  let decl = "export struct P {\n  x: Int\n} derive(Show)\n"
  let other = "impl Show for P {\n  to_string(p: P) -> String { \"p\" }\n}\n"
  inspect(link_verdict([("p.vibe", decl), ("q.vibe", other)]), content = "q.vibe: line 1:1: remove one of these: `impl Show for P` here and `derive (Show) on P` in p.vibe: line 1:8 both define `P::to_string` -- the derive gives way to the impl, so the deriving module, and every caller of the method, would silently run the impl; one module may not hold both either")
}

/// #3551: a plain definition of a derived method is the override one module
/// accepts -- the derive generates nothing when the program defines the
/// method, so one definition remains whatever the import order.
test "a plain definition overriding a derive in another module is accepted" {
  let decl = "export struct P {\n  x: Int\n} derive(Show, Hash)\n"
  let other = "export fn P::to_string(p: P) -> String {\n  \"custom\"\n}\n"
  inspect(link_verdict([("p.vibe", decl), ("q.vibe", other)]), content = "ok")
  inspect(link_verdict([("q.vibe", other), ("p.vibe", decl)]), content = "ok")
  // The derive still binds what is not overridden: `P::hash_key`.
  let impl_hash = "impl Hash for P {\n  hash_key(p: P) -> String { \"k\" }\n}\n"
  inspect(link_verdict([
    ("p.vibe", decl),
    ("q.vibe", other),
    ("r.vibe", impl_hash)
  ]), content = "r.vibe: line 1:1: remove one of these: `impl Hash for P` here and `derive (Hash) on P` in p.vibe: line 1:8 both define `P::hash_key` -- the derive gives way to the impl, so the deriving module, and every caller of the method, would silently run the impl; one module may not hold both either")
}

/// #3551: a unit holding an impl for `Int` does not make every `Int::..`
/// definition in it an impl method. A plain `fn Int::name` after an
/// intervening statement collides with another unit's `impl Name for Int`.
test "a plain definition in a unit that also holds an impl for the owner is refused" {
  let mixed = "export trait Bar {\n  n(Self) -> Int\n}\n\nimpl Bar for Int {\n  n(x: Int) -> Int { 1 }\n}\n\nlet gap = 1\n\nfn Int::name(x: Int) -> String {\n  \"plain\"\n}\n"
  inspect(link_verdict([
    ("tr.vibe", trait_src),
    ("ta.vibe", impl_a),
    ("tm.vibe", mixed)
  ]), content = "tm.vibe: line 11:1: remove one of these: `a definition` here and `impl Name for Int` in ta.vibe: line 1:1 both define `Int::name` -- a linked program keeps only one of them, chosen by import order, so every caller, in either module, would silently run that one")
  // Its own impl's method stays the impl's: no overlap with itself.
  inspect(link_verdict([("tr.vibe", trait_src), ("tm.vibe", mixed)]), content = "ok")
}

/// A plain definition reusing an impl method's name collapses too.
test "a plain definition of an impl method name in another module is refused" {
  let plain = "export fn Int::name(x: Int) -> String {\n  \"plain\"\n}\n"
  inspect(link_verdict([
    ("tr.vibe", trait_src),
    ("ta.vibe", impl_a),
    ("tp.vibe", plain)
  ]), content = "tp.vibe: line 1:8: remove one of these: `a definition` here and `impl Name for Int` in ta.vibe: line 1:1 both define `Int::name` -- a linked program keeps only one of them, chosen by import order, so every caller, in either module, would silently run that one")
}

/// A package contract restates its implementation's impls without binding
/// anything of its own.
test "a contract restating an impl is not an overlap" {
  inspect(link_verdict([
    ("tr.vibe", trait_src),
    ("pkg/index.vpkg", impl_a),
    ("pkg/impl.vibe", impl_a)
  ]), content = "ok")
}

/// #3551 review: which units only restate is the loader's provenance -- the
/// path it gave the unit -- not the text. Every marker line the loader writes
/// is an ordinary comment a module may open with, and the shared-import one
/// heads every real sibling of a package whose contract shares an import
/// (#897). Matched on the text, each of these linked silently (measured:
/// `from-a from-a`, and `from-b from-b` with the imports swapped). Such a unit
/// is named without a line: the loader's prepended lines would shift it.
test "a module opening with a loader marker line is still checked" {
  let refusal = "tb.vibe: line 3:1: remove one of these: `impl Name for Int` here and `impl Name for Int` in ta.vibe both define `Int::name` -- a linked program keeps only one of them, chosen by import order, so every caller, in either module, would silently run that one"
  for marker in [
    contract_facade_marker,
    vpkg_shared_import_marker,
    vpkg_types_module_marker
  ] {
    inspect(link_verdict([
      ("tr.vibe", trait_src),
      ("ta.vibe", String::concat(marker, impl_a)),
      ("tb.vibe", impl_b)
    ]), content = refusal)
  }
}

/// The loader's own restating units stay exempt: a contract path, and the
/// exact path it materializes a types module at. A lookalike under that
/// directory is an ordinary module.
test "a generated types module path is exempt and a lookalike is not" {
  let decl = String::concat(vpkg_types_module_marker, "export struct P {\n  x: Int\n} derive(Show)\n")
  let other = "impl Show for P {\n  to_string(p: P) -> String { \"p\" }\n}\n"
  let generated = String::concat(vpkg_types_module_path_prefix, "k1_Ab9.vibe")
  inspect(link_verdict([(generated, decl), ("q.vibe", other)]), content = "ok")
  inspect(link_verdict([("pkg/index.vibei", decl), ("q.vibe", other)]), content = "ok")
  let nested = String::concat(vpkg_types_module_path_prefix, "fake/p.vibe")
  inspect(link_verdict([(nested, decl), ("q.vibe", other)]), content = "q.vibe: line 1:1: remove one of these: `impl Show for P` here and `derive (Show) on P` in .vibe/build/vpkg_types/types_fake/p.vibe both define `P::to_string` -- the derive gives way to the impl, so the deriving module, and every caller of the method, would silently run the impl; one module may not hold both either")
}

let child_src = "export trait Base {\n  get(Self) -> String\n}\n\nexport trait Child: Base {}\n"

/// #3551 review: a binding in another trait's namespace inside an impl's run
/// -- the supertrait operation `Base::get` the checker synthesizes after
/// `impl Child for Int` -- used to end the run, so the `Int::get` after it was
/// read as a plain definition rather than the impl's method. With the method
/// on both sides after such a binding, neither was checked at all (two plain
/// definitions; measured end to end: `from-a from-a`, and `from-b from-b` with
/// the imports swapped).
test "a supertrait binding inside an impl's run does not end it" {
  let fallback_a = "impl Child for Int\n\nfn Base::tag(x: Int) -> Int {\n  7\n}\n\nfn Int::get(x: Int) -> String {\n  \"from-a\"\n}\n"
  let fallback_b = "impl Child for Int\n\nfn Base::tag(x: Int) -> Int {\n  8\n}\n\nfn Int::get(x: Int) -> String {\n  \"from-b\"\n}\n"
  inspect(link_verdict([
    ("tr.vibe", child_src),
    ("ta.vibe", fallback_a),
    ("tb.vibe", fallback_b)
  ]), content = "tb.vibe: line 1:1: remove one of these: `impl Child for Int` here and `impl Child for Int` in ta.vibe: line 1:1 both define `Int::get` -- a linked program keeps only one of them, chosen by import order, so every caller, in either module, would silently run that one")
  // The synthesized operation's shape: it is the impl's method, not a plain
  // definition, so the refusal names both impls.
  let synthesized = "impl Child for Int\nlet rec Base::get = (x: Int) -> String { \"op\" }\nlet rec Int::get = (x: Int) -> String { \"from-a\" }\n"
  let written = "impl Child for Int {\n  get(x: Int) -> String { \"from-b\" }\n}\n"
  inspect(link_verdict([
    ("tr.vibe", child_src),
    ("ta.vibe", synthesized),
    ("tb.vibe", written)
  ]), content = "tb.vibe: line 1:1: remove one of these: `impl Child for Int` here and `impl Child for Int` in ta.vibe: line 1:1 both define `Int::get` -- a linked program keeps only one of them, chosen by import order, so every caller, in either module, would silently run that one")
  // One such impl in the program is no overlap.
  inspect(link_verdict([("tr.vibe", child_src), ("ta.vibe", fallback_a)]), content = "ok")
}

/// #3551 review: the grouped merge links each source group on its own and
/// joins the texts afterwards, so a check per group never saw two impls in
/// different groups together, and the joined program kept whichever came
/// first. The check runs over the whole program: every group's units.
test "the grouped merge refuses impls overlapping across source groups" {
  let main_src = "import ./tr.vibe { trait Name }\n\nfn main() -> String {\n  Name::name(1)\n}\n"
  let refusal = "tb.vibe: line 3:1: remove one of these: `impl Name for Int` here and `impl Name for Int` in ta.vibe: line 1:1 both define `Int::name` -- a linked program keeps only one of them, chosen by import order, so every caller, in either module, would silently run that one"
  inspect(grouped_verdict([
    ("tr", [("tr.vibe", trait_src)]),
    ("a", [("ta.vibe", impl_a)]),
    ("b", [("tb.vibe", impl_b)]),
    ("main", [("main.vibe", main_src)])
  ]), content = refusal)
  // One group holding both is refused as before; distinct targets are not.
  inspect(grouped_verdict([
    ("tr", [("tr.vibe", trait_src)]),
    ("ab", [("ta.vibe", impl_a), ("tb.vibe", impl_b)]),
    ("main", [("main.vibe", main_src)])
  ]), content = refusal)
  let impl_bool = "impl Name for Bool {\n  name(x: Bool) -> String { \"bool\" }\n}\n"
  inspect(grouped_verdict([
    ("tr", [("tr.vibe", trait_src)]),
    ("a", [("ta.vibe", impl_a)]),
    ("c", [("tc.vibe", impl_bool)]),
    ("main", [("main.vibe", main_src)])
  ]), content = "ok")
  // A group listed twice is merged twice but is one module: not an overlap.
  inspect(grouped_verdict([
    ("tr", [("tr.vibe", trait_src)]),
    ("a", [("ta.vibe", impl_a)]),
    ("a", [("ta.vibe", impl_a)]),
    ("main", [("main.vibe", main_src)])
  ]), content = "ok")
}

/// The same through a warm cache: each group's text was merged, and cached,
/// by an earlier call that never held the other impl. Serving both texts from
/// the cache must not skip the check on the program they are joined into.
test "the grouped merge refuses an overlap between groups cached by separate calls" {
  let main_src = "import ./tr.vibe { trait Name }\n\nfn main() -> String {\n  Name::name(1)\n}\n"
  let tr = ("tr", [("tr.vibe", trait_src)])
  let ga = ("a", [("ta.vibe", impl_a)])
  let gb = ("b", [("tb.vibe", impl_b)])
  let gm = ("main", [("main.vibe", main_src)])
  let verdict = handle {
    let (_, _, db1) = db_grouped_merged_source(db_new(), [tr, ga, gm])
    let (_, _, db2) = db_grouped_merged_source(db1, [tr, gb, gm])
    let _ = db_grouped_merged_source(db2, [tr, ga, gb, gm])
    "ok"
  } with { Exception::Throw(msg) => msg }
  inspect(verdict, content = "tb.vibe: line 3:1: remove one of these: `impl Name for Int` here and `impl Name for Int` in ta.vibe: line 1:1 both define `Int::name` -- a linked program keeps only one of them, chosen by import order, so every caller, in either module, would silently run that one")
}
