//# `perform?` lowering (#2236)

import @vibe/compiler/codegen/common_base {
  append_hidden_attempt_constructors, lower_optional_performs, optional_perform_artifact_resolution
}

import @vibe/compiler/core {
  Expr, Stmt, set_program_extern_effects
}

import @vibe/compiler/normalize {
  bind_extern_effects_owned
}

import @vibe/compiler/syntax {
  lex, parse_program
}

import @vibe/compiler/entry/source_compile {
  compile_source_wasi
}

import @vibe/compiler/entry/source_compile/gc_only {
  compile_source_gc_only
}

fn optional_program() -> String {
  "fn main() -> Int allows Fs::read_file? {\n  match perform? Fs::read_file(\"missing\") {\n    NotGranted => 0,\n    Errored(_) => 1,\n    Granted(_) => 2\n  }\n}\n"
}

fn lowered_binding(_ resolution: Array[(String, String)]) -> Expr with Exception {
  let stmts = parse_program(lex("fn main() -> Int allows Fs::read_file? {\n  let result = perform? Fs::read_file(\"x\")\n  0\n}\n"))
  lower_optional_performs(stmts = stmts, resolution = resolution)
  match Array::get(stmts, at = 0) {
    SLet(_, _, "main", _, EFn(_, _, _, _, _, ELet("result", value, _, _))) => value,
    _ => throw("expected the parsed main binding")
  }
}

test "#2236: unresolved optional operation lowers to NotGranted" allows Exception {
  match lowered_binding([]) {
    EIdent("$vibe_attempt_not_granted", _) => (),
    _ => assert(false)
  }
}

test "#2236: a granted operation converts host failure to Errored" allows Exception {
  match lowered_binding([("Fs::read_file", "Granted")]) {
    EHandle(ECall(EIdent("$vibe_attempt_granted", _), granted_args, _, _), arms) => {
      assert_eq(Array::length(granted_args), 1)
      assert_eq(Array::length(arms), 1)
      match Array::get(granted_args, at = 0) {
        ECall(EIdent("Fs::read_file", _), operation_args, _, _) => {
          assert_eq(Array::length(operation_args), 1)
          match Array::get(operation_args, at = 0) {
            EString("x", _) => (),
            _ => assert(false)
          }
        },
        _ => assert(false)
      }
      match Array::get(arms, at = 0) {
        (PCtor("Exception::Throw", handler_pats), ECall(EIdent("$vibe_attempt_errored", _), errored_args, _, _)) => {
          assert_eq(Array::length(handler_pats), 1)
          assert_eq(Array::length(errored_args), 1)
        },
        _ => assert(false)
      }
    },
    _ => assert(false)
  }
}

test "#2236: a provider-level denial covers its operations" allows Exception {
  match lowered_binding([("Fs", "NotGranted")]) {
    EIdent("$vibe_attempt_not_granted", _) => (),
    _ => assert(false)
  }
}

fn optional_call() -> Expr {
  ECall(EIdent("perform?", 0), [
    ECall(EIdent("Fs::read_file", 0), [EString("x", -1)], 0, [])
  ], 0, [])
}

fn assert_ambient_granted(_ stmt: Stmt) -> Unit with Exception {
  let stmts = [stmt]
  let resolution = optional_perform_artifact_resolution(stmts = stmts, entry_name = "__no_entry__", generated_test_artifact = false, resolution = [
  ])
  lower_optional_performs(stmts = stmts, resolution = resolution)
  let body = match Array::get(stmts, at = 0) {
    STest(_, value) => value,
    SBench(_, value) => value,
    SExample(_, value) => value,
    _ => throw("expected a test-like block")
  }
  match body {
    EHandle(ECall(EIdent("$vibe_attempt_granted", _), args, _, _), _) => assert_eq(Array::length(args), 1),
    _ => assert(false)
  }
}

test "#2236 review: test, bench, and example optionals use ambient grants" allows Exception {
  assert_ambient_granted(STest("test", optional_call()))
  assert_ambient_granted(SBench("bench", optional_call()))
  assert_ambient_granted(SExample("example", optional_call()))
}

test "#2236 review: a test artifact grants optionals in reachable helpers" allows Exception {
  let stmts = [
    SLet(false, false, "read_optional", None, EFn([], [], [], None, None, optional_call())),
    STest("uses helper", ECall(EIdent("read_optional", 0), [], 0, []))
  ]
  let resolution = optional_perform_artifact_resolution(stmts = stmts, entry_name = "__no_entry__", generated_test_artifact = false, resolution = [
  ])
  lower_optional_performs(stmts = stmts, resolution = resolution)
  match Array::get(stmts, at = 0) {
    SLet(_, _, "read_optional", _, EFn(_, _, _, _, _, EHandle(ECall(EIdent("$vibe_attempt_granted", _), args, _, _), _))) => assert_eq(Array::length(args), 1),
    _ => assert(false)
  }
}

test "#2236 review: non-test artifacts keep the non-interactive default" allows Exception {
  let main_stmts = [
    SLet(false, false, "main", None, EFn([], [], [], None, None, optional_call())),
    STest("not part of this entry", ECall(EIdent("main", 0), [], 0, []))
  ]
  let library_stmts = [
    SLet(false, false, "helper", None, EFn([], [], [], None, None, optional_call()))
  ]
  assert_eq(Array::length(optional_perform_artifact_resolution(stmts = main_stmts, entry_name = "main", generated_test_artifact = false, resolution = [
  ])), 0)
  assert_eq(Array::length(optional_perform_artifact_resolution(stmts = library_stmts, entry_name = "__no_entry__", generated_test_artifact = false, resolution = [
  ])), 0)
}

test "#2236 review: GC-lowered test artifacts retain ambient authority" {
  let stmts = [
    SLet(false, false, "read_optional", None, EFn([], [], [], None, None, optional_call())),
    SLet(false, false, "__test_uses helper", None, EFn([], [], [], None, None, ECall(EIdent("read_optional", 0), [
    ], 0, []))),
    SLet(true, false, "_start", None, EFn([], [], [], None, None, ECall(EIdent("__test_uses helper", 0), [
    ], 0, [])))
  ]
  assert_eq(Array::length(optional_perform_artifact_resolution(stmts = stmts, entry_name = "_start", generated_test_artifact = true, resolution = [
  ])), 1)
}

test "#2236 review: user __test_ names do not grant GC artifact authority" {
  let stmts = [
    SLet(false, false, "helper", None, EFn([], [], [], None, None, optional_call())),
    SLet(false, false, "__test_marker", None, EFn([], [], [], None, None, EInt(0))),
    SLet(true, false, "_start", None, EFn([], [], [], None, None, ECall(EIdent("helper", 0), [
    ], 0, [])))
  ]
  assert_eq(Array::length(optional_perform_artifact_resolution(stmts = stmts, entry_name = "_start", generated_test_artifact = false, resolution = [
  ])), 0)
}

test "#2236 review: source shadow of a registry operation is not lowered" {
  let stmts = parse_program(lex("fn Fs::read_file(path: String) -> String { path }\nfn main() -> Int allows Fs::read_file? { let _ = perform? Fs::read_file(\"x\"); 0 }\n"))
  let message = handle {
    lower_optional_performs(stmts = stmts, resolution = [])
    ""
  } with { Exception::Throw(error) => error }
  assert(String::contains(message, needle = "source function"))
  assert(String::contains(message, needle = "not a capability operation"))
}

test "#2236 review: checker-only Fs::readdir is valid capability provenance" {
  let stmts = parse_program(lex("fn main() -> Int allows Fs::readdir? { let _ = perform? Fs::readdir(\"x\"); 0 }\n"))
  let message = handle {
    lower_optional_performs(stmts = stmts, resolution = [
      ("Fs::readdir", "Granted")
    ])
    ""
  } with { Exception::Throw(error) => error }
  assert_eq(message, "")
}

test "#2236 review: hidden constructors reuse the linked Attempt representation" {
  let names = ["Granted", "NotGranted", "Errored", "Granted"]
  let tags = [7, 101, 102, 103]
  let fields = [2, 0, 1, 1]
  let types = ["Local", "Attempt", "Attempt", "Attempt"]
  append_hidden_attempt_constructors(names = names, tags = tags, field_counts = fields, type_names = types)
  assert_eq(Array::get(names, at = 4), "$vibe_attempt_not_granted")
  assert_eq(Array::get(tags, at = 4), 101)
  assert_eq(Array::get(names, at = 5), "$vibe_attempt_errored")
  assert_eq(Array::get(tags, at = 5), 102)
  assert_eq(Array::get(names, at = 6), "$vibe_attempt_granted")
  assert_eq(Array::get(tags, at = 6), 103)
}

test "#2236: the linear backend compiles a well-graded perform?" allows Exception {
  let msg = handle {
    let bytes = compile_source_wasi(source = optional_program(), entry_name = "main", checked_error_row = false)
    if Bytes::length(bytes) > 8 {
      ""
    } else {
      "wasm artifact is too short"
    }
  } with { Exception::Throw(error) => error }
  assert_eq(msg, "")
}

test "#2236: the wasm-gc backend compiles a well-graded perform?" allows Exception {
  let msg = handle {
    let bytes = compile_source_gc_only(source = optional_program(), entry_name = "main", exports_stripped = false, checked_error_row = false)
    if Bytes::length(bytes) > 8 {
      ""
    } else {
      "wasm artifact is too short"
    }
  } with { Exception::Throw(error) => error }
  assert_eq(msg, "")
}

fn extern_optional_program() -> String {
  "extern effect Greeter {\n  greet(String) -> String\n}\n\nfn main() -> Int allows Greeter? {\n  let result = perform? Greeter::greet(\"x\")\n  0\n}\n"
}

/// The `main` binding's `result` value after the optional lowering, with
/// the program's `extern effect` bound first when `bound` says so (the
/// split route binds before it lowers `perform?`; the whole-program route
/// lowers first).
fn extern_lowered_binding(resolution: Array[(String, String)], bound: Bool) -> Expr with Exception {
  let stmts = parse_program(lex(extern_optional_program()))
  if bound {
    bind_extern_effects_owned(stmts = stmts, owners = [])
  } else {
    // Nothing recorded from an earlier compile: the declaration alone must
    // carry the answer.
    set_program_extern_effects([])
  }
  lower_optional_performs(stmts = stmts, resolution = resolution)
  let mut found: Option[Expr] = None
  for stmt in stmts {
    match stmt {
      SLet(_, _, "main", _, EFn(_, _, _, _, _, ELet("result", value, _, _))) => found = Some(value),
      _ => ()
    }
  }
  match found {
    Some(value) => value,
    None => throw("expected the parsed main binding")
  }
}

fn extern_granted(_ e: Expr) -> Bool {
  match e {
    EHandle(ECall(EIdent("$vibe_attempt_granted", _), args, _, _), _) => Array::length(args) == 1 && match Array::get(args, at = 0) {
      ECall(EIdent("Greeter::greet", _), _, _, _) => true,
      _ => false
    },
    _ => false
  }
}

fn extern_not_granted(_ e: Expr) -> Bool {
  match e {
    EIdent("$vibe_attempt_not_granted", _) => true,
    _ => false
  }
}

test "#4082: an extern effect's optional operation is NotGranted without a provider" allows Exception {
  assert(extern_not_granted(extern_lowered_binding(resolution = [], bound = false)))
  assert(extern_not_granted(extern_lowered_binding(resolution = [], bound = true)))
}

test "#4082: a bound provider grants an extern effect's optional operation" allows Exception {
  assert(extern_granted(extern_lowered_binding(resolution = [
    ("Greeter", "Granted")
  ], bound = false)))
  assert(extern_granted(extern_lowered_binding(resolution = [
    ("Greeter", "Granted")
  ], bound = true)))
}
