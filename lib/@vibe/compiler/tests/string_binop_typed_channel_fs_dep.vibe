//# Functions

// Support module for string_binop_typed_channel_fs_lane_test.vibe: a
// String-returning function whose DECLARATION lives in another module, so a
// call through a local alias of the import exercises the shape where only
// the checker's import environment knows the result type.
export fn sb_dep_tag(s: String) -> String {
  String::concat(s, "x")
}
