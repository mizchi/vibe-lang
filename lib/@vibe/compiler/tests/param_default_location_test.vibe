//# Imports

// #3120 (Codex on #3438): a parameter default is parsed with the lexer's
// token-start table, so a diagnostic raised inside the default points at the
// default expression. Parsed with an empty table, the default's nodes carried
// no offset: an unknown name fell back to a point, and a type mismatch had no
// location at all.

import ./checker_parity_test_support.vibe {
  check_source_located_err_contains
}

//# Misc

test "an unknown name in a default is located at the default" {
  assert(check_source_located_err_contains("fn f(x: Int = bad) -> Int {\n  x\n}\n\nfn main() -> Int {\n  f()\n}", "line 1:15-18: unknown name: bad"))
}

test "a default of the wrong type is located at the default" {
  assert(check_source_located_err_contains("fn f(x: Int = \"s\") -> Int {\n  x\n}\n\nfn main() -> Int {\n  f()\n}", "line 1:15-18: binding type mismatch"))
}
