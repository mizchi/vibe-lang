//# Imports

import @vibe/compiler/runtime {
  incremental_interface_effect_set_for_test, incremental_trait_generic_provenance_markers_for_test
}

import @vibe/core {
  array_empty
}

//# Trait interface provenance

test "interface effect fingerprints ignore checker provenance ids" {
  let first = incremental_interface_effect_set_for_test(Some("Log, #capture[37], #param[2], #fieldparam[0], #region_4"), [
    37
  ], [
    "q0"
  ])
  let shifted = incremental_interface_effect_set_for_test(Some("#capture[91], #param[2], #fieldparam[0], #region_12, Log"), [
    91
  ], [
    "q0"
  ])
  inspect(first, "[#capture[q0],#fieldparam[0],#param[2],Log]")
  inspect(shifted, "[#capture[q0],#fieldparam[0],#param[2],Log]")
  assert(first == shifted)
}

test "trait interface marks malformed method generic provenance" {
  let valid = incremental_trait_generic_provenance_markers_for_test(array_empty(), [
    "T"
  ], [
    ("T", [
      "Eq"
    ])
  ], 1, [
    ("map", [
      "T"
    ], [
      ("T", [
        "Eq"
      ])
    ])
  ])
  let surplus = incremental_trait_generic_provenance_markers_for_test(array_empty(), [
    "T"
  ], [
    ("T", [
      "Eq"
    ])
  ], 1, [
    ("map", [
      "T"
    ], array_empty()),
    ("extra", [
      "U"
    ], [
      ("U", [
        "Show"
      ])
    ])
  ])
  let unbound = incremental_trait_generic_provenance_markers_for_test(array_empty(), [
    "T"
  ], [
    ("Missing", [
      "Eq"
    ])
  ], 1, [
    ("map", [
      "T"
    ], array_empty())
  ])
  let ambiguous = incremental_trait_generic_provenance_markers_for_test(array_empty(), [
    "T",
    "T"
  ], [
    ("T", [
      "Eq"
    ])
  ], 1, [
    ("map", [
      "T",
      "T"
    ], array_empty())
  ])
  assert(not(String::contains(valid, "surplus-method-generic")))
  assert(not(String::contains(valid, "unbound-bound")))
  assert(not(String::contains(valid, "ambiguous-bound")))
  assert(String::contains(surplus, "surplus-method-generic"))
  assert(String::contains(unbound, "unbound-bound"))
  assert(String::contains(ambiguous, "ambiguous-method-param"))
  assert(String::contains(ambiguous, "ambiguous-bound"))
}

test "trait interface marks duplicate header binders" {
  let ambiguous_header = incremental_trait_generic_provenance_markers_for_test([
    "T",
    "T"
  ], array_empty(), array_empty(), 0, array_empty())
  assert(String::contains(ambiguous_header, "ambiguous-header-param:0"))
  assert(String::contains(ambiguous_header, "ambiguous-header-param:1"))
}
