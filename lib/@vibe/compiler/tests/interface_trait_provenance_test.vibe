//# Imports

import @vibe/compiler/runtime {
  incremental_interface_effect_set_for_test, incremental_trait_generic_provenance_markers_for_test
}

import @vibe/core {
  array_empty
}

//# Trait interface provenance

test "interface effect fingerprints ignore checker provenance ids" {
  let first = incremental_interface_effect_set_for_test(effect_name = Some("Log, #capture[37], #param[2], #aliasparam[8], #fieldparam[0], #region_4"), ids = [
    37
  ], names = ["q0"])
  let shifted = incremental_interface_effect_set_for_test(effect_name = Some("#capture[91], #param[97], #aliasparam[103], #fieldparam[41], #region_12, Log"), ids = [
    91
  ], names = ["q0"])
  inspect(first, "[#capture[q0],Log]")
  inspect(shifted, "[#capture[q0],Log]")
  assert(first == shifted)
}

test "trait interface marks malformed method generic provenance" {
  let valid = incremental_trait_generic_provenance_markers_for_test(header_params = array_empty(), method_params = [
    "T"
  ], generic_bounds = [("T", ["Eq"])], method_count = 1, method_gens = [
    ("map", ["T"], [("T", ["Eq"])])
  ])
  let surplus = incremental_trait_generic_provenance_markers_for_test(header_params = array_empty(), method_params = [
    "T"
  ], generic_bounds = [("T", ["Eq"])], method_count = 1, method_gens = [
    ("map", ["T"], array_empty()),
    ("extra", ["U"], [("U", ["Show"])])
  ])
  let unbound = incremental_trait_generic_provenance_markers_for_test(header_params = array_empty(), method_params = [
    "T"
  ], generic_bounds = [("Missing", ["Eq"])], method_count = 1, method_gens = [
    ("map", ["T"], array_empty())
  ])
  let ambiguous = incremental_trait_generic_provenance_markers_for_test(header_params = array_empty(), method_params = [
    "T",
    "T"
  ], generic_bounds = [("T", ["Eq"])], method_count = 1, method_gens = [
    ("map", ["T", "T"], array_empty())
  ])
  assert(not(String::contains(valid, needle = "surplus-method-generic")))
  assert(not(String::contains(valid, needle = "unbound-bound")))
  assert(not(String::contains(valid, needle = "ambiguous-bound")))
  assert(String::contains(surplus, needle = "surplus-method-generic"))
  assert(String::contains(unbound, needle = "unbound-bound"))
  assert(String::contains(ambiguous, needle = "ambiguous-method-param"))
  assert(String::contains(ambiguous, needle = "ambiguous-bound"))
}

test "trait interface marks duplicate header binders" {
  let ambiguous_header = incremental_trait_generic_provenance_markers_for_test(header_params = [
    "T",
    "T"
  ], method_params = array_empty(), generic_bounds = array_empty(), method_count = 0, method_gens = array_empty())
  assert(String::contains(ambiguous_header, needle = "ambiguous-header-param:0"))
  assert(String::contains(ambiguous_header, needle = "ambiguous-header-param:1"))
}
