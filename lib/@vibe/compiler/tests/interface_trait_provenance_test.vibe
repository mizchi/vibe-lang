//# Imports

import @vibe/compiler/runtime {
  incremental_trait_generic_provenance_markers_for_test
}

import @vibe/core {
  array_empty
}

//# Trait interface provenance

test "trait interface marks malformed method generic provenance" {
  let valid = incremental_trait_generic_provenance_markers_for_test([
    "T"
  ], [
    ("T", [
      "Eq"
    ])
  ], 1, [
    ("map", [
      "T"
    ], [
      ("T", [
        "Eq"
      ])
    ])
  ])
  let surplus = incremental_trait_generic_provenance_markers_for_test([
    "T"
  ], [
    ("T", [
      "Eq"
    ])
  ], 1, [
    ("map", [
      "T"
    ], array_empty()),
    ("extra", [
      "U"
    ], [
      ("U", [
        "Show"
      ])
    ])
  ])
  let unbound = incremental_trait_generic_provenance_markers_for_test([
    "T"
  ], [
    ("Missing", [
      "Eq"
    ])
  ], 1, [
    ("map", [
      "T"
    ], array_empty())
  ])
  let ambiguous = incremental_trait_generic_provenance_markers_for_test([
    "T",
    "T"
  ], [
    ("T", [
      "Eq"
    ])
  ], 1, [
    ("map", [
      "T",
      "T"
    ], array_empty())
  ])
  assert(not(String::contains(valid, "surplus-method-generic")))
  assert(not(String::contains(valid, "unbound-bound")))
  assert(not(String::contains(valid, "ambiguous-bound")))
  assert(String::contains(surplus, "surplus-method-generic"))
  assert(String::contains(unbound, "unbound-bound"))
  assert(String::contains(ambiguous, "ambiguous-method-param"))
  assert(String::contains(ambiguous, "ambiguous-bound"))
}
