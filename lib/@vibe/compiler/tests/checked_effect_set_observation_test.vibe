//# #1379 checked effect-set declaration provenance observation tests.

import @vibe/compiler/checker {
  CheckedProgram, check_program_result
}

import @vibe/compiler/checker/artifacts {
  canonical_checked_effect_set_declarations_snapshot, checked_effect_set_declarations_observation
}

import @vibe/compiler/core {
  Expr, Stmt, Subst, TypeEnv
}

import @vibe/core {
  array_empty
}

fn checked_with(stmts: Array[Stmt]) -> CheckedProgram {
  CheckedProgram::{
    checked_stmts: stmts,
    final_env: EnvEmpty,
    type_defs: array_empty(),
    final_subst: SubstEmpty,
    typed_occurrences: array_empty()
  }
}

fn snapshot(stmts: Array[Stmt]) -> String {
  canonical_checked_effect_set_declarations_snapshot(checked_effect_set_declarations_observation(checked_with(stmts)))
}

test "effect-set observation preserves nesting export order duplicates and exact text" {
  let actual = snapshot([
    SLet(false, false, "ignored", None, EInt(1)),
    SEffectSet(true, "Top", ["A", "A", "Env::Read"]),
    SModule(false, "Outer", [
      SExpr(EUnit),
      SEffectSet(false, "Inner", ["B", "B"]),
      SModule(true, "Deep", [SEffectSet(true, "Leaf", ["State[Int]"])])
    ]),
    // A repeated module name is preserved as a second declaration occurrence,
    // never collapsed into the earlier path.
    SModule(false, "Outer", [SEffectSet(false, "Again", array_empty())])
  ])
  assert(String::starts_with(actual, "vibe-checked-effectsets-observation:v1\n4:"))
  assert(String::contains(actual, "9:Env::Read"))
  assert(String::contains(actual, "10:State[Int]"))
}

test "effect-set observation snapshot is sensitive to every retained field" {
  let base = snapshot([
    SModule(false, "M", [SEffectSet(false, "Set", ["A", "B"])])
  ])
  let changed_path = snapshot([
    SModule(false, "N", [SEffectSet(false, "Set", ["A", "B"])])
  ])
  let changed_export = snapshot([
    SModule(false, "M", [SEffectSet(true, "Set", ["A", "B"])])
  ])
  let changed_name = snapshot([
    SModule(false, "M", [SEffectSet(false, "Other", ["A", "B"])])
  ])
  let changed_member_order = snapshot([
    SModule(false, "M", [SEffectSet(false, "Set", ["B", "A"])])
  ])
  let changed_duplicate = snapshot([
    SModule(false, "M", [SEffectSet(false, "Set", ["A", "B", "B"])])
  ])
  assert(base != changed_path)
  assert(base != changed_export)
  assert(base != changed_name)
  assert(base != changed_member_order)
  assert(base != changed_duplicate)
  assert(snapshot([SLet(false, false, "ignored", None, EInt(1))]) == snapshot(array_empty()))
}

test "effect-set observation preserves depth-first order and complete recursive paths" {
  let ordered = snapshot([
    SEffectSet(false, "First", array_empty()),
    SEffectSet(false, "Second", array_empty())
  ])
  let reversed = snapshot([
    SEffectSet(false, "Second", array_empty()),
    SEffectSet(false, "First", array_empty())
  ])
  assert(ordered != reversed)
  let nested = snapshot([
    SModule(false, "Outer", [
      SModule(false, "Inner", [SEffectSet(false, "Leaf", array_empty())])
    ])
  ])
  let changed_outer = snapshot([
    SModule(false, "Other", [
      SModule(false, "Inner", [SEffectSet(false, "Leaf", array_empty())])
    ])
  ])
  let changed_inner = snapshot([
    SModule(false, "Outer", [
      SModule(false, "Other", [SEffectSet(false, "Leaf", array_empty())])
    ])
  ])
  let shallow = snapshot([
    SModule(false, "Inner", [SEffectSet(false, "Leaf", array_empty())])
  ])
  assert(nested != changed_outer)
  assert(nested != changed_inner)
  assert(nested != shallow)
}

test "effect-set observation accepts the successful production checker result" {
  let checked = check_program_result([SEffectSet(true, "Capabilities", ["Fs"])])
  let actual = canonical_checked_effect_set_declarations_snapshot(checked_effect_set_declarations_observation(checked))
  assert(String::starts_with(actual, "vibe-checked-effectsets-observation:v1\n1:"))
  assert(String::contains(actual, "12:Capabilities"))
}
