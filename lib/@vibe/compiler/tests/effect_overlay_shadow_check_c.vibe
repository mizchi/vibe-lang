import @vibe/compiler/core {
  Expr
}

import @vibe/core {
  array_empty
}

import @vibe/compiler/checker {
  check_perform_effects_expr_tx
}

test "C: EFn param reusing outer callback name shadows it" {
  let inner_body = ECall(EIdent("f", -1), [
    EIdent("x", -1)
  ], -1)
  let inner_fn = EFn(array_empty(), array_empty(), [
    ("f", None)
  ], None, None, inner_body)
  let call_inner = ECall(inner_fn, [
    EIdent("x", -1)
  ], -1)
  let errors = check_perform_effects_expr_tx(call_inner, array_empty(), false, array_empty(), array_empty(), [
    "f"
  ], [
    [
      "Fs"
    ]
  ])
  assert(Array::length(errors) == 0)
}
