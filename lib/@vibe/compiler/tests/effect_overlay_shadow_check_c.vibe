import ../core {
  Expr
}

import ../checker_effects.vibe {
  check_perform_effects_expr_tx
}

test "C: EFn param reusing outer callback name shadows it" {
  let inner_body = ECall(EIdent("f", -1), [EIdent("x", -1)], -1)
  let inner_fn = EFn(Array::slice([""], 0, 0), Array::slice([("", Array::slice([""], 0, 0))], 0, 0), [("f", None)], None, None, inner_body)
  let call_inner = ECall(inner_fn, [EIdent("x", -1)], -1)
  let errors = check_perform_effects_expr_tx(call_inner, Array::slice([""], 0, 0), false, Array::slice([""], 0, 0), Array::slice([Array::slice([""], 0, 0)], 0, 0), ["f"], [["Fs"]])
  assert(Array::length(errors) == 0)
}
