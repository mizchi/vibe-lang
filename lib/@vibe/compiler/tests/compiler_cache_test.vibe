}

//# Functions

fn empty_sources() -> Array[(String, String)] {
  array_empty()
}

fn repeat_string(fragment: String, count: Int) -> String {
  let mut out = ""
  let mut i = 0
  while i < count {
    out = String::concat(out, fragment)
    i = i + 1
  }
  out
}

fn string_to_bytes(s: String) -> Bytes {
  let out = array_empty()
  let len = String::length(s)
  let mut i = 0
  while i < len {
    Array::push(out, String::char_code_at(s, i))
    i = i + 1
  }
  Bytes::from_array(out)
}

fn assert_wasm_magic(bytes: Bytes) -> Unit {
  assert(Bytes::get(bytes, 0) == 0)
  assert(Bytes::get(bytes, 1) == 97)
  assert(Bytes::get(bytes, 2) == 115)
  assert(Bytes::get(bytes, 3) == 109)
}

//# Misc

test "compile_with_modules_cached: warm compile reuses compiled artifact cache" {
  let main_source = "let main: () -> Int = () -> { 1 + 2 }"
  let sources = empty_sources()
  let (_, db1) = compile_with_modules_cached(db_new(), main_source, "main.vibe", sources)
  let codegen_count1 = db_codegen_count(db1)
  let (_, db2) = compile_with_modules_cached(db1, main_source, "main.vibe", sources)
  assert(eq(db_codegen_count(db2), codegen_count1))
}

test "compile_with_modules_wasi_cached: multi-module imports compile to valid WASM and reuse codegen cache" {
  let helper_source = "export let add: (Int, Int) -> Int = (a, b) -> { a + b }"
  let main_source = "import ./helpers.vibe { add }\nlet _start: () -> Int = () -> { add(1, 2) }"
  let sources = [("helpers.vibe", helper_source)]
  let (bytes1, db1) = compile_with_modules_wasi_cached(db_new(), main_source, "main.vibe", sources, "_start")
  assert_wasm_magic(bytes1)
  let codegen_count1 = db_codegen_count(db1)
  let (bytes2, db2) = compile_with_modules_wasi_cached(db1, main_source, "main.vibe", sources, "_start")
  assert_wasm_magic(bytes2)
  assert(eq(db_codegen_count(db2), codegen_count1))
}

test "compile_with_source_groups_wasi_cached: grouped sources reuse grouped merge cache" {
  let helper_source = "export let add: (Int, Int) -> Int = (a, b) -> { a + b }"
  let main_source = "import ./helpers.vibe { add }\nlet _start: () -> Int = () -> { add(1, 2) }"
  let source_groups = [
    ("core", [("helpers.vibe", helper_source)]),
    ("entry", [("main.vibe", main_source)])
  ]
  let (bytes1, db1) = compile_with_source_groups_wasi_cached(db_new(), main_source, "main.vibe", source_groups, "_start")
  assert_wasm_magic(bytes1)
  let merge_count1 = db_merge_count(db1)
  let (bytes2, db2) = compile_with_source_groups_wasi_cached(db1, main_source, "main.vibe", source_groups, "_start")
  assert_wasm_magic(bytes2)
  assert(eq(db_merge_count(db2), merge_count1))
}

test "compile_with_source_groups_wasi_unchecked_cached: grouped sources reuse artifact cache" {
  let helper_source = "export let add: (Int, Int) -> Int = (a, b) -> { a + b }"
  let main_source = "import ./helpers.vibe { add }\nlet _start: () -> Int = () -> { add(1, 2) }"
  let source_groups = [
    ("core", [("helpers.vibe", helper_source)]),
    ("entry", [("main.vibe", main_source)])
  ]
  let (bytes1, db1) = compile_with_source_groups_wasi_unchecked_cached(db_new(), main_source, "main.vibe", source_groups, "_start")
  assert_wasm_magic(bytes1)
  let codegen_count1 = db_codegen_count(db1)
  let (bytes2, db2) = compile_with_source_groups_wasi_unchecked_cached(db1, main_source, "main.vibe", source_groups, "_start")
  assert_wasm_magic(bytes2)
  assert(eq(db_codegen_count(db2), codegen_count1))
}
