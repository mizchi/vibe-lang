//# Imports

import @vibe/compiler/core {
  Expr, Pat, Stmt, TypeExpr
}

import @vibe/core {
  array_empty
}

import ../checker_purity.vibe {
  analyze_purity, analyze_stmt_purity, builtin_purity, is_local, is_pure, merge_purity
}

//# Functions

fn no_params() -> Array[(String, Option[TypeExpr])] {
  array_empty()
}

fn no_strings() -> Array[String] {
  array_empty()
}

fn no_tyexprs() -> Array[TypeExpr] {
  array_empty()
}

fn no_constraints() -> Array[(String, Array[String])] {
  array_empty()
}

//# Misc

test "pure literals return 0" {
  assert(eq(analyze_purity(EInt(42)), 0))
  assert(eq(analyze_purity(EFloat(3.14)), 0))
  assert(eq(analyze_purity(EString("hello")), 0))
  assert(eq(analyze_purity(EBool(true)), 0))
  assert(eq(analyze_purity(EUnit), 0))
}

test "EIdent is pure" {
  assert(eq(analyze_purity(EIdent("x", -1)), 0))
}

test "EArray of pure elements is pure" {
  assert(eq(analyze_purity(EArray([EInt(1), EInt(2)])), 0))
}

test "ELetMut is StateLocal" {
  let expr = ELetMut("x", EInt(0), EIdent("x", -1), -1)
  assert(analyze_purity(expr) >= 1)
}

test "EAssign is StateLocal" {
  let expr = EAssign("x", EInt(1), EIdent("x", -1))
  assert(analyze_purity(expr) >= 1)
}

test "EWhile is StateLocal" {
  let expr = EWhile(EBool(false), EUnit)
  assert(analyze_purity(expr) >= 1)
}

test "ECall print is Impure" {
  let expr = ECall(EIdent("print", -1), [EString("hello")], -1)
  assert(eq(analyze_purity(expr), 2))
}

test "ECall eq is Pure" {
  let expr = ECall(EIdent("eq", -1), [EInt(1), EInt(2)], -1)
  assert(eq(analyze_purity(expr), 0))
}

test "ECall Array::push is StateLocal" {
  let expr = ECall(EIdent("Array::push", -1), [EArray([EInt(1)]), EInt(2)], -1)
  assert(eq(analyze_purity(expr), 1))
}

test "ECall Fs::read_file is Impure" {
  let expr = ECall(EIdent("Fs::read_file", -1), [EString("test.txt")], -1)
  assert(eq(analyze_purity(expr), 2))
}

test "throw desugar (perform Exception::Throw) is Impure" {
  // #640 Stage 3: `throw(x)` parses to `perform Exception::Throw(x)` (Stage 2),
  // so the throw-is-impure guarantee now rides on builtin_purity("perform").
  let expr = ECall(EIdent("perform", -1), [
    ECall(EIdent("Exception::Throw", -1), [EString("error")], -1)
  ], -1)
  assert(eq(analyze_purity(expr), 2))
}

test "EFn lambda creation is Pure" {
  let expr = EFn(no_strings(), no_constraints(), no_params(), None, None, ECall(EIdent("print", -1), [
    EString("hi")
  ], -1))
  assert(eq(analyze_purity(expr), 0))
}

test "is_pure returns true for pure expr" {
  assert(is_pure(EInt(42)))
}

test "is_pure returns false for impure expr" {
  assert(!is_pure(ECall(EIdent("print", -1), [EString("hi")], -1)))
}

test "is_local returns true for StateLocal expr" {
  let expr = ELetMut("x", EInt(0), EIdent("x", -1), -1)
  assert(is_local(expr))
}

test "merge_purity takes maximum" {
  assert(eq(merge_purity(0, 0), 0))
  assert(eq(merge_purity(0, 1), 1))
  assert(eq(merge_purity(1, 0), 1))
  assert(eq(merge_purity(0, 2), 2))
  assert(eq(merge_purity(2, 0), 2))
  assert(eq(merge_purity(1, 2), 2))
  assert(eq(merge_purity(2, 1), 2))
}

test "ELet with impure body is Impure" {
  let expr = ELet("x", EInt(1), ECall(EIdent("println", -1), [EString("hi")], -1), -1)
  assert(eq(analyze_purity(expr), 2))
}

test "EIf with mixed purity takes max" {
  let expr = EIf(EBool(true), EInt(1), ECall(EIdent("print", -1), [
    EString("hi")
  ], -1))
  assert(eq(analyze_purity(expr), 2))
}

test "pure let passes" {
  let stmt = SLet(false, false, "x", None, EInt(1))
  assert(eq(analyze_stmt_purity(stmt), 0))
}

test "pure fn passes" {
  let fn_expr = EFn(no_strings(), no_constraints(), [("x", None)], None, None, EBinOp("+", EIdent("x", -1), EInt(1)))
  let stmt = SLet(false, false, "f", None, fn_expr)
  assert(eq(analyze_stmt_purity(stmt), 0))
}

test "let mut is state_local" {
  let stmt = SLetMut("x", None, EInt(0))
  assert(analyze_stmt_purity(stmt) >= 1)
}

test "test block allowed" {
  let test_body = ELetMut("x", EInt(0), EAssign("x", EBinOp("+", EIdent("x", -1), EInt(1)), EIdent("x", -1)), -1)
  let stmt = STest("t", test_body)
  let p = analyze_stmt_purity(stmt)
  assert(p >= 1)
}

test "enum def passes" {
  let stmt = SEnum(false, "Color", array_empty(), [
    ("Red", no_tyexprs()),
    ("Green", no_tyexprs()),
    ("Blue", no_tyexprs())
  ], array_empty())
  assert(eq(analyze_stmt_purity(stmt), 0))
}

test "for-in is state_local" {
  let expr = EForIn("x", None, EArray([EInt(1), EInt(2)]), EIdent("x", -1))
  assert(analyze_purity(expr) >= 1)
}

test "chained pure calls stay pure" {
  let call = ECall(EIdent("eq", -1), [EInt(1), EInt(2)], -1)
  assert(eq(analyze_purity(call), 0))
}

test "impure call propagates" {
  let call = ECall(EIdent("print", -1), [EString("hello")], -1)
  assert(eq(analyze_purity(call), 2))
}

test "nested let with impure body" {
  let expr = ELet("x", EInt(1), ECall(EIdent("Fs::read_file", -1), [
    EString("test.txt")
  ], -1), -1)
  assert(eq(analyze_purity(expr), 2))
}

test "while loop is at least state_local" {
  let expr = EWhile(EBool(true), EUnit)
  assert(analyze_purity(expr) >= 1)
}
