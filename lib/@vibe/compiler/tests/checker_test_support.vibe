//# Imports

import @vibe/compiler/core {
  Expr, Subst, Type, TypeDef, TypeEnv, subst_apply
}

import @vibe/core {
  array_empty
}

import @vibe/compiler/checker {
  check_expr
}

//# Functions

export let no_tp = array_empty()

export let no_tb = array_empty()

fn empty_defs() -> Array[TypeDef] {
  array_empty()
}

export fn check(expr: Expr, env: TypeEnv) -> Type with Error {
  let errors = array_empty()
  match check_expr(expr, env, empty_defs(), SubstEmpty, 0, errors, array_empty()) {
    (ty, s, _) => if Array::length(errors) > 0 {
      throw(Array::get(errors, 0))
    } else {
      subst_apply(s, ty)
    }
    ,
    _ => CtUnknown
  }
}
