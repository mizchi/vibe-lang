//# Imports

import @vibe/compiler/core {
  Expr, Subst, Type, TypeDef, TypeEnv, subst_apply
}

import @vibe/core {
  array_empty
}

import @vibe/compiler/checker {
  check_expr
}

//# Functions

export let no_tp = array_empty()

export let no_tb = array_empty()

fn empty_defs() -> Array[TypeDef] {
  array_empty()
}

export fn check(expr: Expr, env: TypeEnv) -> Type with Exception {
  let errors = array_empty()
  match check_expr(expr = expr, env = env, defs = empty_defs(), s = SubstEmpty, c = 0, errors = errors, tytab = array_empty()) {
    (ty, s, _) => if Array::length(errors) > 0 {
      throw(Array::get(errors, at = 0))
    } else {
      subst_apply(s = s, ty = ty)
    }
  }
}
