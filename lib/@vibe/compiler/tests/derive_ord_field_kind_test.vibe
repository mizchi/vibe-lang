//# Imports

import ./checker_parity_test_support.vibe {
  check_source_err_contains, check_source_ok
}

//# Tests

/// `derive (Ord)` compared a field it has no typed comparison for with a raw
/// `<` on references: equal arrays, options, tuples and type-parameter values
/// answered `Less`, and unequal ones came out in allocation order. Such a
/// derive is refused now, naming the edit.
test "derive (Ord) over a container, tuple or type parameter is refused" {
  assert(check_source_err_contains("struct I { w: Array[Int] } derive(Ord)\nfn main() -> Int { 0 }", "write `I::compare` yourself"))
  assert(check_source_err_contains("struct O { w: Option[Int] } derive(Ord)\nfn main() -> Int { 0 }", "write `O::compare` yourself"))
  assert(check_source_err_contains("struct T { w: (Int, Int) } derive(Ord)\nfn main() -> Int { 0 }", "write `T::compare` yourself"))
  assert(check_source_err_contains("struct G[A] { w: A } derive(Ord)\nfn main() -> Int { 0 }", "type parameter `A`"))
  assert(check_source_err_contains("enum E { K(Array[String]) } derive(Ord)\nfn main() -> Int { 0 }", "write `E::compare` yourself"))
}

test "derive (Ord) over scalars, strings, doubles and declared types is accepted" {
  assert(check_source_ok("struct P { name: String; w: Double; n: Int; c: Char; b: Bool; f: Float } derive(Ord)\nfn main() -> Int { 0 }"))
  assert(check_source_ok("struct In { n: Int } derive(Ord)\nenum E { K(String); L(In) } derive(Ord)\nstruct Rec { next: Rec } derive(Ord)\nfn main() -> Int { 0 }"))
}
