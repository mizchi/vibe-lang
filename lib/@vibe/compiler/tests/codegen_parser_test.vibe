//# Imports

import @vibe/compiler/codegen {
  compile_wasi_module
}

import @vibe/compiler/syntax {
  lex
}

import ../parser.vibe {
  parse_program
}

import @vibe/compiler/loader {
  ingest_source_text_fs
}

//# Misc

/// #769: paths modernized -- the parser stack moved from the flat compiler
/// layout (lib/@vibe/compiler/{token,ast}.vibe + syntax/*) to the
/// lib/@vibe/parser package, and the AST enums now live as transparent type
/// definitions in the @vibe/ast CONTRACT (index.vpkg, #897), so they are read
/// via the same ingest/desugar step the loader applies (raw contract grammar
/// does not parse with parse_program).
test "wasi: parser.vibe import - compile and run" {
  let token_source = Fs::read_file("lib/@vibe/parser/token.vibe")
  let ast_path = "lib/@vibe/ast/index.vpkg"
  let ast_source = ingest_source_text_fs(ast_path, Fs::read_file(ast_path))
  let syntax_paths = [
    // #956: the lexer's float-literal construction moved to
    // float_format.vibe (parse_decimal_float), which in turn uses the
    // parser-private __to_string polyfill — include both.
    "lib/@vibe/parser/polyfill.vibe",
    "lib/@vibe/parser/float_format.vibe",
    "lib/@vibe/parser/lexer.vibe",
    "lib/@vibe/parser/parser_base.vibe",
    "lib/@vibe/parser/parser_binder_context.vibe",
    "lib/@vibe/parser/parser_binder_authority.vibe",
    "lib/@vibe/parser/parser_expr_primary.vibe",
    "lib/@vibe/parser/parser_expr_core.vibe",
    "lib/@vibe/parser/parser_expr_dispatch.vibe",
    "lib/@vibe/parser/parser_expr.vibe",
    "lib/@vibe/parser/parser.vibe",
  ]
  let main_source = "let main: () -> Int = () -> {\n  let tokens = lex(\"1 + 2\")\n  let stmts = parse_program(tokens)\n  Array::length(stmts)\n}"
  let all_stmts = ArrayBuilder::new()
  // Token enum
  let tk_tokens = lex(token_source)
  let tk_stmts = parse_program(tk_tokens)
  let mut ti = 0
  while ti < Array::length(tk_stmts) {
    match Array::get(tk_stmts, ti) {
      SEnum(_, _, _, _, _) => {
        ArrayBuilder::push(all_stmts, Array::get(tk_stmts, ti)); 0
      },
      _ => 0
    };
    ti = ti + 1
  }
  // AST enums
  let ast_tokens = lex(ast_source)
  let ast_stmts = parse_program(ast_tokens)
  let mut ai = 0
  while ai < Array::length(ast_stmts) {
    match Array::get(ast_stmts, ai) {
      SEnum(_, _, _, _, _) => {
        ArrayBuilder::push(all_stmts, Array::get(ast_stmts, ai)); 0
      },
      _ => 0
    };
    ai = ai + 1
  }
  // Syntax sources (skip imports and *_ok helpers)
  let mut si = 0
  while si < Array::length(syntax_paths) {
    let source = Fs::read_file(Array::get(syntax_paths, si))
    let source_tokens = lex(source)
    let source_stmts = parse_program(source_tokens)
    let mut sj = 0
    while sj < Array::length(source_stmts) {
      match Array::get(source_stmts, sj) {
        SImport(_, _) => 0,
        SLet(_, _, name, _, _) => if name == "lex_ok" || name == "parse_ok" {
          0
        }
        else {
          ArrayBuilder::push(all_stmts, Array::get(source_stmts, sj)); 0
        }
        ,
        _ => {
          ArrayBuilder::push(all_stmts, Array::get(source_stmts, sj)); 0
        }
      };
      sj = sj + 1
    };
    si = si + 1
  }
  // Main function
  let mn_tokens = lex(main_source)
  let mn_stmts = parse_program(mn_tokens)
  let mut mi = 0
  while mi < Array::length(mn_stmts) {
    ArrayBuilder::push(all_stmts, Array::get(mn_stmts, mi));
    mi = mi + 1
  }
  let bytes = compile_wasi_module(ArrayBuilder::freeze(all_stmts), "main")
  Fs::write_bytes("/tmp/test_cg_parser_import.wasm", bytes)
  0
}
