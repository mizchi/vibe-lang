//# Imports

import @vibe/compiler/checker {
  check_program
}

import @vibe/compiler/syntax {
  lex, parse_program
}
//# Functions

fn check_ok(source: String) -> Bool {
  handle {
    let _ = check_program(parse_program(lex(source)))
    true
  } with Error {
    Throw(_) => false
  }
}

fn check_err(source: String) -> Bool {
  not(check_ok(source))
}

fn assert_all_ok(sources: Array[String]) -> Unit with Error {
  let mut i = 0
  while i < Array::length(sources) {
    let source = Array::get(sources, i)
    if not(check_ok(source)) {
      throw(String::concat("expected ok: ", source))
    }
    i = i + 1
  }
}

fn assert_all_err(sources: Array[String]) -> Unit with Error {
  let mut i = 0
  while i < Array::length(sources) {
    let source = Array::get(sources, i)
    if not(check_err(source)) {
      throw(String::concat("expected error: ", source))
    }
    i = i + 1
  }
}

//# Misc

test "Builtin happy-path typechecks" {
  assert_all_ok([
    "let _adr69 = () -> { String::length(\"hi\") }",
    "let _adr69 = () -> { String::concat(\"a\", \"b\") }",
    "let _adr69 = () -> { String::equals(\"a\", \"b\") }",
    "let _adr69 = () -> { String::contains(\"abc\", \"b\") }",
    "let _adr69 = () -> { String::starts_with(\"abc\", \"a\") }",
    "let _adr69 = () -> { String::ends_with(\"abc\", \"c\") }",
    "let _adr69 = () -> { String::index_of(\"abc\", \"b\") }",
    "let _adr69 = () -> { String::last_index_of(\"abab\", \"ab\") }",
    "let _adr69 = () -> { String::char_code_at(\"a\", 0) }",
    "let _adr69 = () -> { String::from_char_code(65) }",
    "let _adr69 = () -> { String::substring(\"hello\", 1, 3) }",
    "let _adr69 = () -> { String::split(\"a,b\", \",\") }",
    "let _adr69 = () -> { String::trim(\" hi \") }",
  ])
  assert_all_ok([
    "let _adr69 = () -> { Array::length([1, 2]) }",
    "let _adr69 = () -> { Array::get([1, 2], 0) }",
    "let _adr69 = () -> { Array::set([1, 2], 0, 9) }",
    "let a = [1]\nlet _adr69 = () -> { Array::push(a, 2) }",
    "let _adr69 = () -> { Array::slice([1, 2, 3], 0, 2) }",
    "let _adr69 = () -> { Array::concat([1], [2]) }",
    "let a = [1]\nlet _adr69 = () -> { Array::push_all(a, [2, 3]) }",
  ])
  assert_all_ok([
    "let _adr69 = () -> { ArrayBuilder::new() }",
    "let b = ArrayBuilder::new()\nlet _adr69 = () -> { ArrayBuilder::push(b, 1) }",
    "let b = ArrayBuilder::new()\nlet _adr69 = () -> { ArrayBuilder::freeze(b) }",
  ])
  assert_all_ok([
    "let _adr69 = () -> { Map::get(Map::from_pairs([(\"a\", 1)]), \"a\") }",
    "let _adr69 = () -> { Map::keys(Map::from_pairs([(\"a\", 1)])) }",
    "let _adr69 = () -> { Map::has_key(Map::from_pairs([(\"a\", 1)]), \"a\") }",
    "let m = Map::from_pairs([(\"a\", 1)])\nlet _adr69 = () -> { Map::set(m, \"b\", 2) }",
  ])
  assert_all_ok([
    "let _adr69 = () -> { MapBuilder::new() }",
    "let b = MapBuilder::new()\nlet _adr69 = () -> { MapBuilder::set(b, \"k\", 1) }",
    "let b = MapBuilder::new()\nlet _adr69 = () -> { MapBuilder::freeze(b) }",
  ])
  assert_all_ok([
    "let _adr69 = () -> { Bytes::new() }",
    "let b = Bytes::new()\nlet _adr69 = () -> { Bytes::push(b, 65) }",
    "let _adr69 = () -> { Bytes::from_array([1, 2]) }",
    "let _adr69 = () -> { Bytes::to_array(Bytes::from_array([1])) }",
    "let _adr69 = () -> { Bytes::concat(Bytes::from_array([1]), Bytes::from_array([2])) }",
    "let _adr69 = () -> { Bytes::slice(Bytes::from_array([1, 2, 3]), 0, 2) }",
  ])
  assert_all_ok([
    "let _adr69 = () -> { StringBuilder::new() }",
    "let b = StringBuilder::new()\nlet _adr69 = () -> { StringBuilder::push(b, \"hi\") }",
    "let b = StringBuilder::new()\nlet _adr69 = () -> { StringBuilder::freeze(b) }",
  ])
  assert_all_ok([
    "let _adr69 = () -> { Int::to_double(42) }",
    "let _adr69 = () -> { Double::to_int(3.14) }",
    "let _adr69 = () -> { Char::to_int('A') }",
    "let _adr69 = () -> { Char::from_int(65) }",
    "let _adr69 = () -> { __to_string(42) }",
  ])
  assert_all_ok([
    "let _adr69 = () -> { not(true) }",
    "let _adr69 = () -> { eq(1, 1) }",
    "let _adr69 = () -> { assert(true) }",
    "let f: () -> Int with Error = () -> { throw(\"x\")\n0 }\nlet _adr69 = () -> { handle { f() } with Error { Throw(_) => 1 } }",
  ])
  assert_all_ok([
    "let _adr69 = () -> { Some(42) }",
    "let x: Option[Int] = None\nlet _adr69 = () -> { x }",
  ])
  assert_all_ok([
    "let sub_u32: (u32, u32) -> u32 = (a, b) -> { a - b }",
    "let mul_u8: (u8, u8) -> u8 = (a, b) -> { a * b }",
    "let lt_i16: (i16, i16) -> Bool = (a, b) -> { a < b }",
  ])
}

test "Builtin error-paths stay rejected" {
  assert_all_err([
    "let f: (i64, u32) -> i64 = (a, b) -> { a + b }",
  ])
}
