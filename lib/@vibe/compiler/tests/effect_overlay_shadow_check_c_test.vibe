import @vibe/compiler/core {
  Expr
}

import @vibe/core {
  array_empty
}

import @vibe/compiler/checker {
  check_perform_effects_expr_tx
}

test "C: EFn param reusing outer callback name shadows it" {
  let inner_body = ECall(EIdent("f", -1), [EIdent("x", -1)], -1, [])
  let inner_fn = EFn(array_empty(), array_empty(), [("f", None)], None, None, inner_body)
  let call_inner = ECall(inner_fn, [EIdent("x", -1)], -1, [])
  let errors = check_perform_effects_expr_tx(root = call_inner, root_declared = array_empty(), root_in_handle = false, fn_names = array_empty(), fn_effs = array_empty(), root_ov_names = [
    "f"
  ], root_ov_effs = [["Fs"]], checked_error_row = false)
  assert(Array::length(errors) == 0)
}
