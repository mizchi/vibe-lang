}

test "#1958: structured function decoder rejects hostile bytes" {
  match normalized_function("fn id(x: Int) -> Int { x }\n") {
    Some(bytes) => {
      assert(decode_normalized_checked_function_artifact_v1(String::concat(bytes, "x")) == None)
      assert(decode_normalized_checked_function_artifact_v1("vibe-normalized-checked-function:v0\n") == None)
    },
    None => assert(false)
  }
}

test "#1958: function join retains env subst and typed occurrence authority" {
  let source = "fn apply(f: (Int) -> Int, x: Int) -> Int { f(x) }\n"
  match normalized_join(source) {
    Some(bytes) => {
      assert(String::starts_with(bytes, "vibe-normalized-checked-function-join:v1\n"))
      match decode_normalized_checked_function_join_artifact_v1(bytes) {
        Some(decoded) => assert_eq(encode_normalized_checked_function_join_artifact_v1(decoded), bytes),
        None => assert(false)
      }
    },
    None => assert(false)
  }
}

test "#1958: function join rejects torn stale and cross-source authority" {
  let old_source = "fn value(x: Int) -> Int { x }\n"
  let new_source = "fn value(x: Int) -> Int { x + 1 }\n"
  match (normalized_join(old_source), parse_source_located_with_binder_authority(old_source), parse_source_located_with_binder_authority(new_source)) {
    (Some(bytes), Some(old_authority), Some(new_authority)) => {
      assert(normalized_checked_function_join_artifact_matches_authority(bytes, old_authority))
      assert(!normalized_checked_function_join_artifact_matches_authority(bytes, new_authority))
      assert(decode_normalized_checked_function_join_artifact_v1(String::substring(bytes, 0, String::length(bytes) - 1)) == None)
      assert(decode_normalized_checked_function_join_artifact_v1(String::concat(bytes, "x")) == None)
    },
    _ => assert(false)
  }
}

fn value_env_bytes(env: TypeEnv) -> Option[String] {
  match normalized_value_type_env_artifact_from_env(env) {
    Some(artifact) => Some(encode_normalized_value_type_env_artifact_v1(artifact)),
    None => None
  }
}

test "#1958: value TypeEnv preserves order duplicates and binding origin" {
  let local = EnvValueBinding::{ ty: CtInt, origin: BindingOriginUnavailable }
  let imported = EnvValueBinding::{
    ty: CtInt,
    origin: BindingOriginModuleExport("dep", "value")
  }
  let ordered = EnvFlat([("value", local), ("value", imported)])
  let reversed = EnvFlat([("value", imported), ("value", local)])
  match (value_env_bytes(ordered), value_env_bytes(reversed)) {
    (Some(a), Some(b)) => {
      assert(a != b)
      assert(decode_normalized_value_type_env_artifact_v1(a) != None)
      assert(decode_normalized_value_type_env_artifact_v1(b) != None)
    },
    _ => assert(false)
  }
}

test "#1958: cached value TypeEnv preserves exact index and rejects mismatch" {
  let local = EnvValueBinding::{
    ty: CtString,
    origin: BindingOriginUnavailable
  }
  let cached = EnvCached(["a", "a"], [local, local], EnvBind("tail", local, EnvEmpty))
  match value_env_bytes(cached) {
    Some(bytes) => {
      assert(decode_normalized_value_type_env_artifact_v1(bytes) != None)
      assert(decode_normalized_value_type_env_artifact_v1(String::concat(bytes, "x")) == None)
    },
    None => assert(false)
  }
  assert(normalized_value_type_env_artifact_from_env(EnvCached(["a"], [], EnvEmpty)) == None)
}

test "#1958: complete seeded final TypeEnv round-trips" {
  let source = "fn id[T](x: T) -> T { x }\n"
  match parse_source_located_with_binder_authority(source) {
    Some(authority) => match normalized_value_type_env_artifact_from_authority(authority) {
      Some(artifact) => {
        let bytes = encode_normalized_value_type_env_artifact_v1(artifact)
        assert(decode_normalized_value_type_env_artifact_v1(bytes) != None)
      },
      None => assert(false)
    },
    None => assert(false)
  }
}

test "#1958: declaration and mutation TypeEnv nodes round-trip" {
  let defs: Array[TypeDef] = [
    TDEnum("Choice", ["T"], [("Choice", [CtNamed("T", [])])]),
    TDStruct("Point", [("x", CtInt)], ["x"], []),
    TDAlias("Count", [], CtInt),
    TDEffect("Log", [("Emit", [CtString], CtUnit)], []),
    TDEffectSet("Console", ["Log"])
  ]
  let env = EnvTraitDef("Show", [], false, [
    ("show", [TyName("Self")], TyName("String"))
  ], EnvTraitImpl("Show", CtInt, EnvTraitImplGen("Eq", ["T"], [("T", ["Eq"])], CtNamed("Box", [
    CtNamed("T", [])
  ]), EnvTypeDefs(defs, ["Choice", "Point"], EnvMutCell("value", true, EnvEmpty)))), [
    "Self"
  ], [("show", ["T"], [("T", ["Show"])])])
  match value_env_bytes(env) {
    Some(bytes) => assert(decode_normalized_value_type_env_artifact_v1(bytes) != None),
    None => assert(false)
  }
}

test "#1958: comments and whitespace have explicit lossless identity" {
  let compact = build("fn f() -> Int { 1 }\n")
  let documented = build("/// docs\nfn f() -> Int {\n  1\n}\n")
  assert(compact != "")
  assert(documented != "")
  assert(compact != documented)
}

test "#1958: private body changes alter implementation identity" {
  let one = build("fn private_value() -> Int { 1 }\n")
  let two = build("fn private_value() -> Int { 2 }\n")
  assert(one != "")
  assert(two != "")
  assert(one != two)
}

test "#1958: private body changes preserve exported-interface identity" {
  let one = interface_bytes("fn private_value() -> Int { 1 }\nexport fn public_value() -> Int { private_value() }\n")
  let two = interface_bytes("fn private_value() -> Int { 2 }\nexport fn public_value() -> Int { private_value() }\n")
  assert(one != "")
  assert_eq(one, two)
}

test "#1958: public signature changes alter exported-interface identity" {
  let int_interface = interface_bytes("export fn public_value() -> Int { 1 }\n")
  let bool_interface = interface_bytes("export fn public_value() -> Bool { true }\n")
  assert(int_interface != "")
  assert(bool_interface != "")
  assert(int_interface != bool_interface)
}

test "#1958: shadow parity accepts exact current authority and rejects stale body" {
  let old_source = "export fn public_value() -> Int { 1 }\n"
  let new_source = "export fn public_value() -> Int { 2 }\n"
  let retained = build(old_source)
  match (parse_source_located_with_binder_authority(old_source), parse_source_located_with_binder_authority(new_source)) {
    (Some(old_authority), Some(new_authority)) => {
      assert(checked_implementation_body_artifact_matches_authority(retained, old_authority))
      assert(!checked_implementation_body_artifact_matches_authority(retained, new_authority))
    },
    _ => assert(false)
  }
}

test "#1958: malformed stale-version and torn bytes fail closed" {
  let bytes = build("fn f() -> Int { 1 }\n")
  assert(decode_checked_implementation_body_artifact_v1("vibe-checked-implementation-body:v0\n") == None)
  assert(decode_checked_implementation_body_artifact_v1(String::substring(bytes, 0, String::length(bytes) - 1)) == None)
  assert(decode_checked_implementation_body_artifact_v1(String::concat(bytes, "x")) == None)
  let nested = "vibe-checked-exported-interface-artifact:v1\n"
  let at = first_offset(bytes, nested)
  assert(at >= 0)
  let corrupted_nested = String::concat(String::substring(bytes, 0, at), String::concat("vibe-checked-exported-interface-artifact:v0\n", String::substring(bytes, at + String::length(nested), String::length(bytes))))
  assert(decode_checked_implementation_body_artifact_v1(corrupted_nested) == None)
  let diagnostic = "vibe-checked-implementation-body:empty-typing-diagnostics:path,start,end,code,message:v1"
  let diagnostic_at = first_offset(bytes, diagnostic)
  assert(diagnostic_at >= 0)
  let corrupted_diagnostic = String::concat(String::substring(bytes, 0, diagnostic_at), String::concat("vibe-checked-implementation-body:empty-typing-diagnostics:path,start,end,code,message:v0", String::substring(bytes, diagnostic_at + String::length(diagnostic), String::length(bytes))))
  assert(decode_checked_implementation_body_artifact_v1(corrupted_diagnostic) == None)
}
