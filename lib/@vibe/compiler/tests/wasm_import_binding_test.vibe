//# Imports

import @vibe/compiler/core {
  wasm_import_binding_source, wasm_import_callee, wasm_import_decode_callee, wasm_import_vibe_name
}

//# Misc

test "export names map to vibe identifiers" {
  inspect(wasm_import_vibe_name("Z3_mk_config"), content = "z3_mk_config")
  inspect(wasm_import_vibe_name("fn"), content = "fn_")
  inspect(wasm_import_vibe_name("9lives"), content = "_9lives")
  inspect(wasm_import_vibe_name("a.b-c"), content = "a_b_c")
  inspect(wasm_import_vibe_name("_"), content = "")
}

test "a callee round-trips through its encoding" {
  let callee = wasm_import_callee("vibe:wasm:x y.wasm", "f(o)o", [0x7F, 0x7E], [
    0x7F
  ])
  match wasm_import_decode_callee(callee) {
    Some((m, f, ps, rs)) => {
      inspect(m, content = "vibe:wasm:x y.wasm")
      inspect(f, content = "f(o)o")
      inspect(Array::length(ps), content = "2")
      inspect(Array::get(ps, 1) == 0x7E, content = "true")
      inspect(Array::length(rs), content = "1")
    },
    None => assert(false)
  }
}

test "a callee asking for a float type is not decoded" {
  let decoded = match wasm_import_decode_callee("__wasm_import.61.62.F_i") {
    Some(_) => "decoded",
    None => "refused"
  }
  inspect(decoded, content = "refused")
}

test "the counter fixture's binding" {
  let src = wasm_import_binding_source("fixtures/wasm_import/counter.wasm", Fs::read_bytes("fixtures/wasm_import/counter.wasm"))
  inspect(String::index_of(src, "export fn add_i32(a0: Int, a1: Int) -> Int {") >= 0, content = "true")
  inspect(String::index_of(src, "export fn bump(a0: Int) -> Unit {") >= 0, content = "true")
  inspect(String::index_of(src, "export fn wasm_memory_load_u8(a0: Int) -> Int {") >= 0, content = "true")
  inspect(String::index_of(src, "`half` (f64) -> (f64): only i32 / i64 params") >= 0, content = "true")
  inspect(String::index_of(src, "`Same`: its vibe name `same` is shared with another export") >= 0, content = "true")
  inspect(String::index_of(src, "export fn same(") < 0, content = "true")
}

test "an empty component offers nothing" {
  let src = wasm_import_binding_source("c.wasm", Bytes::from_array([
    0,
    97,
    115,
    109,
    13,
    0,
    1,
    0
  ]))
  inspect(String::index_of(src, "export fn") < 0, content = "true")
}

test "the greeter component's binding" {
  let src = wasm_import_binding_source("fixtures/wasm_import/greeter.component.wasm", Fs::read_bytes("fixtures/wasm_import/greeter.component.wasm"))
  inspect(String::index_of(src, "export fn add(a0: Int, a1: Int) -> Int {") >= 0, content = "true")
  inspect(String::index_of(src, "export fn greet(a0: String) -> String {") >= 0, content = "true")
  inspect(String::index_of(src, "wasm_raw_greet(wasm_raw__string_bytes(a0))") >= 0, content = "true")
  inspect(String::index_of(src, "export fn counter() -> Int {") >= 0, content = "true")
  inspect(String::index_of(src, "`greet: func(name: string) -> string` from the component") >= 0, content = "true")
}

test "memory accessors only for a memory a runner can reach" {
  // A defined memory that is not exported: no runner can serve the accessors.
  let hidden = wasm_import_binding_source("m.wasm", Bytes::from_array([
    0,
    97,
    115,
    109,
    1,
    0,
    0,
    0,
    5,
    3,
    1,
    0,
    1
  ]))
  inspect(String::index_of(hidden, "wasm_memory_load_u8") < 0, content = "true")
  // The same memory, exported as "m".
  let shown = wasm_import_binding_source("m.wasm", Bytes::from_array([
    0,
    97,
    115,
    109,
    1,
    0,
    0,
    0,
    5,
    3,
    1,
    0,
    1,
    7,
    5,
    1,
    1,
    109,
    2,
    0
  ]))
  inspect(String::index_of(shown, "export fn wasm_memory_load_u8(a0: Int) -> Int {") >= 0, content = "true")
}

test "a shared memory is offered accessors too" {
  // Memory 0 is shared (limits flags 3: max + shared) and exported as "m":
  // both runners serve the accessors for it (viberun through wasmtime's
  // `SharedMemory`, node through the `SharedArrayBuffer` view).
  let src = wasm_import_binding_source("m.wasm", Bytes::from_array([
    0,
    97,
    115,
    109,
    1,
    0,
    0,
    0,
    5,
    4,
    1,
    3,
    1,
    1,
    7,
    5,
    1,
    1,
    109,
    2,
    0
  ]))
  inspect(String::index_of(src, "export fn wasm_memory_load_u8(a0: Int) -> Int {") >= 0, content = "true")
}

test "a private stub never shares a name with an export" {
  // Two `() -> ()` functions exported as "foo" and "wasm_raw_foo".
  let src = wasm_import_binding_source("s.wasm", Bytes::from_array([
    0,
    97,
    115,
    109,
    1,
    0,
    0,
    0,
    1,
    4,
    1,
    0x60,
    0,
    0,
    3,
    3,
    2,
    0,
    0,
    7,
    22,
    2,
    3,
    102,
    111,
    111,
    0,
    0,
    12,
    119,
    97,
    115,
    109,
    95,
    114,
    97,
    119,
    95,
    102,
    111,
    111,
    0,
    1,
    10,
    7,
    2,
    2,
    0,
    11,
    2,
    0,
    11
  ]))
  inspect(String::index_of(src, "export fn foo() -> Unit {") >= 0, content = "true")
  inspect(String::index_of(src, "export fn wasm_raw_foo() -> Unit {") >= 0, content = "true")
  inspect(String::index_of(src, "\nfn wasm_raw__foo() -> Int = wasm") >= 0, content = "true")
  inspect(String::index_of(src, "\nfn wasm_raw__wasm_raw_foo() -> Int = wasm") >= 0, content = "true")
  inspect(String::index_of(src, "\nfn wasm_raw_foo(") < 0, content = "true")
}
