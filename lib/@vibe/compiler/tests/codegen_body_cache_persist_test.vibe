//# Imports

// #2388 step 3: the cross-compile codegen body cache -- codec round-trip,
// the prefix/guard filter, and the end-to-end persisted lanes ("verify"
// double-compiles and byte-compares; "on" replays persisted bodies).

import @vibe/compiler/codegen/common_base {
  CodegenBodyCache,
  bcc_guard_user_name,
  bcc_int_lists_equal,
  bcc_string_lists_equal,
  bcc_strpool_guard,
  codegen_body_cache_filter_src_below,
  codegen_body_cache_filter_src_keep,
  codegen_body_cache_find,
  codegen_body_cache_find_at,
  codegen_body_cache_find_named,
  codegen_body_cache_find_named_at,
  codegen_body_cache_from_bytes,
  codegen_body_cache_name_index,
  codegen_body_cache_new,
  codegen_body_cache_slot_index,
  codegen_body_cache_to_bytes,
  unique_name_flags
}

import @vibe/compiler/entry/compiler/file_compile {
  compile_file_fs_mode_rc, compile_file_fs_mode_rc_body_cached, compile_file_fs_mode_rc_body_cached_counted
}

import @vibe/compiler/cache {
  compact_string_fingerprint, persistent_artifact_cache_path
}

import @vibe/compiler/codegen {
  compile_wasi_module_rc_body_cached
}

import @vibe/compiler/syntax {
  lex, parse_program
}

//# Functions

fn string_to_bytes(s: String) -> Bytes {
  let out = Bytes::new()
  let len = String::length(s)
  let mut i = 0
  while i < len {
    Bytes::push(out, String::char_code_at(s, i))
    i = i + 1
  }
  out
}

fn bytes_eq(a: Bytes, b: Bytes) -> Bool {
  let n = Bytes::length(a)
  if n != Bytes::length(b) {
    false
  } else {
    let mut i = 0
    let mut same = true
    while same && i < n {
      if Bytes::get(a, i) != Bytes::get(b, i) {
        same = false
      } else {
        i = i + 1
      }
    }
    same
  }
}

fn remove_file_if_exists(path: String) -> Unit with Fs {
  if Fs::exists(path) {
    Fs::remove(path)
  } else {
    ()
  }
}

/// A populated cache exercising every field group: one function entry in the
/// source region (fn_index 0), one outside it (fn_index 3, which the filter
/// must drop), a lambda with captures, a slot-log entry, and recorded
/// guards.
fn sample_cache() -> CodegenBodyCache {
  let c = codegen_body_cache_new()
  Array::push(c.fn_indices, 0)
  Array::push(c.fn_names, "alpha")
  Array::push(c.fn_src_stmts, 2)
  Array::push(c.fn_bodies, string_to_bytes("ab"))
  Array::push(c.fn_meta_i32, 1)
  Array::push(c.fn_meta_i64, 2)
  Array::push(c.fn_meta_v128, 0)
  Array::push(c.fn_indices, 3)
  Array::push(c.fn_names, "beta")
  Array::push(c.fn_src_stmts, 7)
  Array::push(c.fn_bodies, string_to_bytes("cde"))
  Array::push(c.fn_meta_i32, 4)
  Array::push(c.fn_meta_i64, 5)
  Array::push(c.fn_meta_v128, 1)
  Array::push(c.lam_owner, 0)
  Array::push(c.lam_indices, 5)
  Array::push(c.lam_bodies, string_to_bytes("xyz"))
  Array::push(c.lam_param_counts, 2)
  Array::push(c.lam_captures, ["a", "bb"])
  Array::push(c.lam_meta_i32, 9)
  Array::push(c.lam_meta_i64, 0 - 1)
  Array::push(c.slot_owner, 0)
  Array::push(c.slot_values, 1029)
  // #2669 slice 3: blind references, one owned by the FUNCTION and one owned
  // by a LAMBDA. The lambda's owner is `blind_owner_of_lambda(5)` = -7, which
  // is what makes this case load-bearing: the plain int codec encodes `v + 1`
  // unsigned and throws below -1, so before the zigzag column this aborted
  // the whole serialization. The sample had no blind rows at all, so the
  // round-trip proved nothing about them.
  Array::push(c.blind_fn, 0)
  Array::push(c.blind_body, 0)
  Array::push(c.blind_offsets, 17)
  Array::push(c.blind_kinds, 101)
  Array::push(c.blind_syms, 42)
  Array::push(c.blind_fn, 0)
  Array::push(c.blind_body, 0 - 7)
  Array::push(c.blind_offsets, 3)
  Array::push(c.blind_kinds, 102)
  Array::push(c.blind_syms, 1030)
  Array::push(c.guard_meta, 1)
  Array::push(c.guard_meta, 1024)
  Array::push(c.guard_meta, 2048)
  Array::push(c.guard_meta, 7)
  Array::push(c.guard_meta, 40)
  Array::push(c.guard_synth_names, "Pt::equals")
  Array::push(c.guard_synth_stmts, 42)
  Array::push(c.guard_import_names, "vibe_env_get")
  Array::push(c.guard_import_names, "vibe_http_request_raw")
  Array::push(c.guard_borrow_names, "peek")
  Array::push(c.guard_borrow_masks, 5)
  Array::push(c.guard_unmangled_names, "run")
  // #2669 step 2b: the three layout guards. `guard_user_names` is a VECTOR in
  // index order, so "#t" (a test block's placeholder) occupies position 1 --
  // asserting it round-trips is what keeps the placeholder from being quietly
  // dropped on the way through the codec.
  Array::push(c.guard_user_names, "alpha")
  Array::push(c.guard_user_names, "#t")
  Array::push(c.guard_lambda_counts, 1)
  Array::push(c.guard_lambda_counts, 0)
  Array::push(c.guard_strpool, 3)
  Array::push(c.guard_strpool, 12)
  Array::push(c.guard_strpool, 99)
  Array::push(c.guard_strpool, 77)
  c
}

/// #2669 step 2b: two source-region entries, at merged statements 1 and 9.
///
/// The gap is the point. A PREFIX limit cannot keep the entry at 9 without
/// also keeping the one at 1, so a filter that can is doing something the old
/// one could not express -- which is the whole of this step at the decode
/// layer.
fn cache_two_files() -> CodegenBodyCache {
  let c = codegen_body_cache_new()
  Array::push(c.fn_indices, 0)
  Array::push(c.fn_names, "early")
  Array::push(c.fn_src_stmts, 1)
  Array::push(c.fn_bodies, string_to_bytes("e"))
  Array::push(c.fn_meta_i32, 0)
  Array::push(c.fn_meta_i64, 0)
  Array::push(c.fn_meta_v128, 0)
  Array::push(c.fn_indices, 1)
  Array::push(c.fn_names, "late")
  Array::push(c.fn_src_stmts, 9)
  Array::push(c.fn_bodies, string_to_bytes("l"))
  Array::push(c.fn_meta_i32, 0)
  Array::push(c.fn_meta_i64, 0)
  Array::push(c.fn_meta_v128, 0)
  Array::push(c.slot_owner, 1)
  Array::push(c.slot_values, 2048)
  // pin_src_n = 2, so BOTH entries are in the source region and the region
  // test cannot be what decides either case below.
  Array::push(c.guard_meta, 2)
  Array::push(c.guard_meta, 1024)
  Array::push(c.guard_meta, 2048)
  Array::push(c.guard_meta, 7)
  Array::push(c.guard_meta, 40)
  c
}

/// A keep-map of `n` statements with 1 at exactly the listed positions.
fn keep_map(n: Int, ones: Array[Int]) -> Array[Int] {
  let out: Array[Int] = []
  let mut i = 0
  while i < n {
    let mut hit = 0
    let mut k = 0
    while k < Array::length(ones) {
      if Array::get(ones, k) == i {
        hit = 1
      } else {
        ()
      }
      k = k + 1
    }
    Array::push(out, hit)
    i = i + 1
  }
  out
}

test "codegen body cache codec round-trips every field group" {
  let c = sample_cache()
  let b = codegen_body_cache_to_bytes(c)
  match codegen_body_cache_from_bytes(b) {
    Some(d) => {
      inspect(Array::length(d.fn_indices), content = "2")
      inspect(Array::get(d.fn_indices, 1), content = "3")
      inspect(Array::get(d.fn_src_stmts, 0), content = "2")
      // #2669 step 2a. Asserted rather than merely carried: the previous
      // column this struct gained (blind_body) round-tripped untested because
      // the fixture enumerated rows by hand and did not grow with the struct,
      // and the codec threw on it in production.
      inspect(Array::get(d.fn_names, 0), content = "alpha")
      inspect(Array::get(d.fn_names, 1), content = "beta")
      assert(bytes_eq(Array::get(d.fn_bodies, 1), string_to_bytes("cde")))
      inspect(Array::get(d.fn_meta_v128, 1), content = "1")
      inspect(Array::length(d.lam_owner), content = "1")
      assert(bytes_eq(Array::get(d.lam_bodies, 0), string_to_bytes("xyz")))
      inspect(Array::get(d.lam_param_counts, 0), content = "2")
      inspect(Array::get(Array::get(d.lam_captures, 0), 1), content = "bb")
      inspect(Array::get(d.lam_meta_i64, 0), content = "-1")
      inspect(Array::get(d.slot_values, 0), content = "1029")
      // #2669 slice 3. The second row is the one that matters: its body owner
      // is a LAMBDA, so the value is negative and the plain column's encoder
      // refuses it. Round-tripping it exactly is the whole point of giving
      // this column a zigzag encoding.
      inspect(Array::length(d.blind_fn), content = "2")
      inspect(Array::get(d.blind_body, 0), content = "0")
      inspect(Array::get(d.blind_body, 1), content = "-7")
      inspect(Array::get(d.blind_offsets, 1), content = "3")
      inspect(Array::get(d.blind_kinds, 1), content = "102")
      inspect(Array::get(d.blind_syms, 1), content = "1030")
      inspect(Array::get(d.guard_meta, 2), content = "2048")
      inspect(Array::get(d.guard_meta, 4), content = "40")
      inspect(Array::get(d.guard_synth_names, 0), content = "Pt::equals")
      inspect(Array::get(d.guard_synth_stmts, 0), content = "42")
      inspect(Array::get(d.guard_import_names, 1), content = "vibe_http_request_raw")
      inspect(Array::get(d.guard_borrow_names, 0), content = "peek")
      inspect(Array::get(d.guard_borrow_masks, 0), content = "5")
      inspect(Array::get(d.guard_unmangled_names, 0), content = "run")
      inspect(Array::get(d.guard_user_names, 0), content = "alpha")
      inspect(Array::get(d.guard_user_names, 1), content = "#t")
      inspect(Array::get(d.guard_lambda_counts, 0), content = "1")
      inspect(Array::length(d.guard_strpool), content = "4")
      inspect(Array::get(d.guard_strpool, 3), content = "77")
      // The decode-time annotation is NOT in the stream: it describes the
      // build that read the artifact, not the harvest that wrote it.
      inspect(Array::length(d.consumer_src_limit), content = "0")
    },
    None => assert(false)
  }
}

test "codegen body cache codec fails safe on damage" {
  let c = sample_cache()
  let b = codegen_body_cache_to_bytes(c)
  // Wrong magic.
  let wrong_magic = Bytes::concat(string_to_bytes("XBC1"), Bytes::slice(b, 4, Bytes::length(b)))
  match codegen_body_cache_from_bytes(wrong_magic) {
    Some(_) => assert(false),
    None => assert(true)
  }
  // Truncation anywhere in the stream degrades to None, never to a partial
  // cache.
  match codegen_body_cache_from_bytes(Bytes::slice(b, 0, Bytes::length(b) - 3)) {
    Some(_) => assert(false),
    None => assert(true)
  }
  match codegen_body_cache_from_bytes(Bytes::slice(b, 0, 6)) {
    Some(_) => assert(false),
    None => assert(true)
  }
}

test "filter_src_below keeps only guarded source-region entries below the limit" {
  let c = sample_cache()
  // limit 7: entry (fn 0, src 2) survives; (fn 3, src 7) is out by limit AND
  // out of the source region (guard_meta[0] == 1). The kept function's
  // lambda and slot entries ride along; guards are copied verbatim.
  let f = codegen_body_cache_filter_src_below(c, 7)
  inspect(Array::length(f.fn_indices), content = "1")
  inspect(Array::get(f.fn_indices, 0), content = "0")
  inspect(Array::length(f.lam_owner), content = "1")
  inspect(Array::length(f.slot_owner), content = "1")
  inspect(Array::length(f.guard_meta), content = "5")
  inspect(Array::get(f.guard_synth_names, 0), content = "Pt::equals")
  inspect(Array::length(f.guard_import_names), content = "2")
  // A guard-less cache never crosses compiles: it filters to empty.
  let unguarded = sample_cache()
  Array::truncate(unguarded.guard_meta, 0)
  let g = codegen_body_cache_filter_src_below(unguarded, 100)
  inspect(Array::length(g.fn_indices), content = "0")
}

test "#2669: filter_src_keep keeps a LATE unchanged file the prefix rule cannot reach" {
  let c = cache_two_files()
  // The case that does not exist under a prefix limit: the file at statement 9
  // is unchanged, the one at statement 1 is not.
  let late_only = codegen_body_cache_filter_src_keep(c, keep_map(10, [9]))
  inspect(Array::length(late_only.fn_indices), content = "1")
  inspect(Array::get(late_only.fn_names, 0), content = "late")
  // Its funcref slot rides along, exactly as the prefix filter carries one.
  inspect(Array::length(late_only.slot_owner), content = "1")
  // Control: the same filter asked the other way answers the other entry, so
  // the result above is the keep-map talking and not a constant.
  let early_only = codegen_body_cache_filter_src_keep(c, keep_map(10, [1]))
  inspect(Array::length(early_only.fn_indices), content = "1")
  inspect(Array::get(early_only.fn_names, 0), content = "early")
  // And the prefix filter genuinely cannot express the first answer: any limit
  // that reaches statement 9 also takes statement 1.
  inspect(Array::length(codegen_body_cache_filter_src_below(c, 10).fn_indices), content = "2")
  inspect(Array::length(codegen_body_cache_filter_src_below(c, 2).fn_indices), content = "1")
  // A statement outside the map is not kept -- a torn or short map costs a
  // recompile, never a body addressed by a position nobody described.
  inspect(Array::length(codegen_body_cache_filter_src_keep(c, keep_map(3, [1, 9])).fn_indices), content = "1")
  // Guard-less caches never cross compiles, here as in the prefix filter.
  let unguarded = cache_two_files()
  Array::truncate(unguarded.guard_meta, 0)
  let both = keep_map(10, [1, 9])
  inspect(Array::length(codegen_body_cache_filter_src_keep(unguarded, both).fn_indices), content = "0")
}

test "#2669: the string-pool guard separates the pools that move a body's offsets" {
  // A body embeds `(offset << 32) | length`, so two pools are interchangeable
  // for replay exactly when every string sits at the same offset with the same
  // bytes. These are the three ways that fails.
  //
  // Same bytes, different split: "c" is at offset 2 in the first and at 1 in
  // the second. Without the separator these hash alike.
  let ab_c = bcc_strpool_guard(["ab", "c"], 2)
  let a_bc = bcc_strpool_guard(["a", "bc"], 2)
  assert(!bcc_int_lists_equal(ab_c, a_bc))
  // Same strings, different order: "b" moves.
  let a_b = bcc_strpool_guard(["a", "b"], 2)
  let b_a = bcc_strpool_guard(["b", "a"], 2)
  assert(!bcc_int_lists_equal(a_b, b_a))
  // Same lengths, different content: every offset agrees and no body may
  // replay anyway, because the string AT each offset changed.
  let ab = bcc_strpool_guard(["ab"], 1)
  let cd = bcc_strpool_guard(["cd"], 1)
  assert(!bcc_int_lists_equal(ab, cd))
  // `upto` is respected: what lies past it is the source path/content region,
  // which no user body can reference.
  let past_long = bcc_strpool_guard(["a", "b", "zzz"], 2)
  let past_short = bcc_strpool_guard(["a", "b", "q"], 2)
  assert(bcc_int_lists_equal(past_long, past_short))
  // Shape, and the two cheap fields spelled out.
  inspect(Array::length(ab_c), content = "4")
  inspect(Array::get(ab_c, 0), content = "2")
  inspect(Array::get(ab_c, 1), content = "3")
  // An `upto` past the end is clamped rather than trapping.
  inspect(Array::get(bcc_strpool_guard(["ab"], 99), 0), content = "1")
  let empty_pool: Array[String] = []
  inspect(Array::get(bcc_strpool_guard(empty_pool, 3), 0), content = "0")
}

test "#2669: only test and bench names collapse to the position placeholder" {
  inspect(bcc_guard_user_name("__test_adds_two_numbers"), content = "#t")
  inspect(bcc_guard_user_name("__bench_lex"), content = "#t")
  inspect(bcc_guard_user_name("run"), content = "run")
  // Not a prefix match: `__testish` is an ordinary name and must keep its
  // spelling, or an edit renaming it would replay bodies that call it.
  inspect(bcc_guard_user_name("__testish"), content = "__testish")
  inspect(bcc_guard_user_name("__test"), content = "__test")
}

test "guard validation can fail: a poisoned body replays, a poisoned guard drops the cache" {
  // Red/green pair for the #2388 guard validation, per the repo's gate
  // doctrine: a check is only trusted once it has been shown to fail.
  let src = "let helper: () -> Bool = () -> { [1, 2] == [1, 2] }\nlet run: () -> Int = () -> { if helper() { 42 } else { 0 } }"
  let out1 = codegen_body_cache_new()
  let fresh = compile_wasi_module_rc_body_cached(parse_program(lex(src)), "run", codegen_body_cache_new(), out1)
  // RED (proves replay is live and this test can detect it): copy the
  // harvest, poison ONE cached body, keep the guards valid. A fresh parse
  // of the same source revalidates the guards, accepts the cache, and
  // replays the poisoned bytes -- the output MUST differ.
  match codegen_body_cache_from_bytes(codegen_body_cache_to_bytes(out1)) {
    Some(poisoned_body) => {
      let victim = Array::get(poisoned_body.fn_bodies, 0)
      Bytes::set(victim, Bytes::length(victim) - 1, (Bytes::get(victim, Bytes::length(victim) - 1) + 1)&255)
      let replayed = compile_wasi_module_rc_body_cached(parse_program(lex(src)), "run", poisoned_body, codegen_body_cache_new())
      assert(!bytes_eq(fresh, replayed))
    },
    None => assert(false)
  }
  // GREEN: the same poisoned body PLUS a poisoned import-name guard. The
  // validation must now drop the cache wholesale, so the poisoned body
  // never reaches the output and the compile answers fresh bytes.
  match codegen_body_cache_from_bytes(codegen_body_cache_to_bytes(out1)) {
    Some(poisoned_guard) => {
      let victim2 = Array::get(poisoned_guard.fn_bodies, 0)
      Bytes::set(victim2, Bytes::length(victim2) - 1, (Bytes::get(victim2, Bytes::length(victim2) - 1) + 1)&255)
      Array::push(poisoned_guard.guard_import_names, "#never_a_builtin")
      let dropped = compile_wasi_module_rc_body_cached(parse_program(lex(src)), "run", poisoned_guard, codegen_body_cache_new())
      assert(bytes_eq(fresh, dropped))
    },
    None => assert(false)
  }
}

test "a call-shape edit that flips the borrow ABI drops the cache" {
  // The ADR-0092 borrow-parameter inference is call-site sensitive: passing
  // a non-ident argument (`use_it(make())`) disqualifies the position that
  // `use_it(x)` qualifies, flipping the callee's parameter between borrowed
  // and owned -- a different body under an unchanged name and layout. The
  // borrow guard must drop the cache, so the replayed compile answers the
  // same bytes as a fresh one.
  let shared = "let seed_eq: () -> Bool = () -> { [1] == [1] }\nlet make: () -> Array[Int] = () -> { [1, 2] }\nlet use_it: (Array[Int]) -> Int = (xs) -> { Array::length(xs) }\n"
  let src_a = String::concat(shared, "let run: () -> Int = () -> { let x = make()\n  use_it(x) }")
  let src_b = String::concat(shared, "let run: () -> Int = () -> { use_it(make()) }")
  let out_a = codegen_body_cache_new()
  let _ = compile_wasi_module_rc_body_cached(parse_program(lex(src_a)), "run", codegen_body_cache_new(), out_a)
  let out_b = codegen_body_cache_new()
  let fresh_b = compile_wasi_module_rc_body_cached(parse_program(lex(src_b)), "run", codegen_body_cache_new(), out_b)
  // Non-vacuity: the two programs must actually record different borrow
  // guards -- otherwise this test would pass without exercising the drop.
  assert(!bcc_string_lists_equal(out_a.guard_borrow_names, out_b.guard_borrow_names) || !bcc_int_lists_equal(out_a.guard_borrow_masks, out_b.guard_borrow_masks))
  let replayed_b = compile_wasi_module_rc_body_cached(parse_program(lex(src_b)), "run", out_a, codegen_body_cache_new())
  assert(bytes_eq(fresh_b, replayed_b))
}

test "persisted body cache: verify survives an entry edit; on matches a fresh compile" {
  let helper_path = "/tmp/vibe_codegen_body_cache_helper.vibe"
  let main_path = "/tmp/vibe_codegen_body_cache_main.vibe"
  // The helper compares arrays so the closure is guaranteed to synthesize a
  // derived comparator -- which makes the compile run the #2388 pin reorder
  // and record guards into the artifact.
  let helper_source = "export let helper_flag: () -> Bool = () -> { [1, 2] == [1, 2] }"
  let main_source1 = "import ./vibe_codegen_body_cache_helper.vibe { helper_flag }\nlet run: () -> Int = () -> { if helper_flag() { 40 + 2 } else { 0 } }"
  let main_source2 = "import ./vibe_codegen_body_cache_helper.vibe { helper_flag }\nlet run: () -> Int = () -> { if helper_flag() { 50 + 3 } else { 1 } }"
  Fs::write_bytes(helper_path, string_to_bytes(helper_source))
  Fs::write_bytes(main_path, string_to_bytes(main_source1))
  // Mirrors the lane's own key derivation: content-independent, but scoped
  // to the entry path so unrelated roots sharing an entry name (`run`)
  // cannot race on one artifact slot.
  let artifact_path = persistent_artifact_cache_path("codegen-body-cache", "run", String::concat("self-describing-", compact_string_fingerprint(main_path)))
  remove_file_if_exists(artifact_path)
  // Run 1: no artifact yet -- verify has nothing to replay, compiles fresh
  // and stores the harvest.
  let bytes1 = compile_file_fs_mode_rc_body_cached(main_path, "run", "verify")
  assert(Fs::exists(artifact_path))
  // Run 2, nothing edited: every file matches the stored table, so the
  // whole harvest replays -- and verify throws if any replayed byte
  // differs from the fresh compile.
  let bytes2 = compile_file_fs_mode_rc_body_cached(main_path, "run", "verify")
  assert(bytes_eq(bytes1, bytes2))
  // Run 3, entry edited: only the helper prefix may replay; verify again
  // proves the replayed prefix bytes are what a fresh compile produces.
  Fs::write_bytes(main_path, string_to_bytes(main_source2))
  let bytes3 = compile_file_fs_mode_rc_body_cached(main_path, "run", "verify")
  assert(!bytes_eq(bytes2, bytes3))
  // "on" mode replays without the double compile; its output must be
  // byte-identical to the plain production lane's.
  let on_bytes = compile_file_fs_mode_rc_body_cached(main_path, "run", "on")
  let fresh_bytes = compile_file_fs_mode_rc(main_path, "run")
  assert(bytes_eq(on_bytes, fresh_bytes))
  // On-disk corruption: flip one byte inside the stored artifact's body
  // region (same length, valid framing). The payload checksum must reject
  // the whole artifact, so "on" still answers the fresh compile's bytes.
  let stored = Fs::read_bytes(artifact_path)
  let flip_at = Bytes::length(stored) / 2
  Bytes::set(stored, flip_at, (Bytes::get(stored, flip_at) + 1)&255)
  Fs::write_bytes(artifact_path, stored)
  let after_corruption = compile_file_fs_mode_rc_body_cached(main_path, "run", "on")
  assert(bytes_eq(after_corruption, fresh_bytes))
  // A guard-flipping edit (a new unmangled entry helper changes the global
  // name-membership guard) under VERIFY: the drift is an expected cache
  // miss checked against the fresh harvest's guards, never a thrown verify
  // mismatch -- the second compile re-feeds already-lowered stmts, where
  // linked_compile's own validation stands down.
  let main_source3 = String::concat(main_source2, "\nlet spare_helper: () -> Int = () -> { 7 }\nlet run2: () -> Int = () -> { spare_helper() }")
  Fs::write_bytes(main_path, string_to_bytes(main_source3))
  let bytes5 = compile_file_fs_mode_rc_body_cached(main_path, "run", "verify")
  assert(Bytes::length(bytes5) > 0)
}

// #2388 step 3 follow-up: the body loop asked `codegen_body_cache_find` once
// per function, and that function scans the whole cache -- quadratic in the
// function count, on the lane whose purpose is a cheap warm compile.
// `codegen_body_cache_slot_index` + `codegen_body_cache_find_at` answer in one
// read. The scan is the ORACLE here, not a second implementation to eyeball:
// the two must agree on every key, including the ones no entry holds.

/// A cache carrying only the lookup keys: `fn_indices`, and since #2669 step
/// 2a the parallel `fn_names` the name lookup reads.
fn cache_with_indices(indices: Array[Int]) -> CodegenBodyCache {
  let c = codegen_body_cache_new()
  let mut i = 0
  while i < Array::length(indices) {
    Array::push(c.fn_indices, Array::get(indices, i))
    Array::push(c.fn_names, String::concat("f", __to_string(Array::get(indices, i))))
    i = i + 1
  }
  c
}

/// Every key in [0, key_count) on which the indexed lookup disagrees with the
/// scan, as `key:scan/indexed`. Empty means they agree over the whole key
/// space the table is built for.
fn lookup_disagreements(c: CodegenBodyCache, key_count: Int) -> String {
  let idx = codegen_body_cache_slot_index(c, key_count)
  let out: Array[String] = []
  let mut k = 0
  while k < key_count {
    let a = codegen_body_cache_find(c, k)
    let b = codegen_body_cache_find_at(idx, k)
    if a == b {
      ()
    } else {
      Array::push(out, "\{k}:\{a}/\{b}")
    }
    k = k + 1
  }
  String::join(out, ", ")
}

test "a duplicated function name is a miss on both name lookups" {
  // Duplicate function names are REAL, not hypothetical: two `test "..."`
  // blocks with the same title lower to the same `__test_` function, and
  // `lib/@vibe/compiler/tests/builtins_extended_test.vibe` has such a pair.
  // Both lookups must answer -2 so a consumer declines replay; resolving
  // first-wins would hand one function another's body, which is the mistake
  // #2705 found in the cross-build tool.
  let c = codegen_body_cache_new()
  Array::push(c.fn_indices, 0)
  Array::push(c.fn_names, "solo")
  Array::push(c.fn_indices, 1)
  Array::push(c.fn_names, "twin")
  Array::push(c.fn_indices, 2)
  Array::push(c.fn_names, "twin")
  let (sorted, positions) = codegen_body_cache_name_index(c)
  inspect(codegen_body_cache_find_named(c, "solo"), content = "0")
  inspect(codegen_body_cache_find_named_at(sorted, positions, "solo"), content = "0")
  inspect(codegen_body_cache_find_named(c, "twin"), content = "-2")
  inspect(codegen_body_cache_find_named_at(sorted, positions, "twin"), content = "-2")
  inspect(codegen_body_cache_find_named(c, "absent"), content = "-1")
  inspect(codegen_body_cache_find_named_at(sorted, positions, "absent"), content = "-1")
}

test "unique_name_flags marks every member of a duplicated run, not just the extras" {
  // The CURRENT build's side of the ambiguity question. A name identifies a
  // function only while it is unique here, whatever the cache holds: the
  // prefix filter can drop one of a same-named pair and keep the other, at
  // which point the cached name looks unique and the build still has two.
  //
  // Both members of a run must be flagged, not only the second -- flagging
  // one would let the other be looked up by a name that does not identify it.
  let flags = unique_name_flags([
    "solo",
    "twin",
    "other",
    "twin",
    "trip",
    "trip",
    "trip"
  ])
  inspect(Array::get(flags, 0), content = "1")
  inspect(Array::get(flags, 1), content = "0")
  inspect(Array::get(flags, 2), content = "1")
  inspect(Array::get(flags, 3), content = "0")
  inspect(Array::get(flags, 4), content = "0")
  inspect(Array::get(flags, 5), content = "0")
  inspect(Array::get(flags, 6), content = "0")
  // Degenerate inputs answer rather than trap.
  inspect(Array::length(unique_name_flags([])), content = "0")
  inspect(Array::get(unique_name_flags(["only"]), 0), content = "1")
}

test "the indexed body-cache lookup answers exactly what the scan answers" {
  // Out of order, with a gap at 3 and 7, so a table that merely counted up
  // would disagree.
  let c = cache_with_indices([5, 0, 9, 2, 6, 1, 8, 4])
  inspect(lookup_disagreements(c, 12), content = "")
  // Spot-checks, so a `lookup_disagreements` that silently compared nothing
  // would not pass this test: the slot is the POSITION in the cache.
  let idx = codegen_body_cache_slot_index(c, 12)
  inspect(codegen_body_cache_find_at(idx, 5), content = "0")
  inspect(codegen_body_cache_find_at(idx, 4), content = "7")
  inspect(codegen_body_cache_find_at(idx, 3), content = "-1")
}

// The table is sized by the CALLER's key space, so an entry outside it is
// unreachable rather than dropped -- the scan cannot return it either without
// being asked with a key the caller never uses. Sizing the table from the
// cache instead would let one absurd index in a torn artifact turn a lookup
// into an allocation the scan never made.
test "the table covers the caller's key space and answers -1 beyond it" {
  let c = cache_with_indices([5, 0, 9, 2])
  let idx = codegen_body_cache_slot_index(c, 6)
  inspect(Array::length(idx), content = "6")
  inspect(lookup_disagreements(c, 6), content = "")
  // 9 is in the cache and outside the key space: the table says -1, and the
  // body loop never asks (its keys are function indices below num_user_funcs).
  inspect(codegen_body_cache_find(c, 9), content = "2")
  inspect(codegen_body_cache_find_at(idx, 9), content = "-1")
  // A cache whose only index is absurd costs one Int per KEY, not per index.
  let absurd = cache_with_indices([1099511627776])
  inspect(Array::length(codegen_body_cache_slot_index(absurd, 4)), content = "4")
}

test "a duplicate function index resolves to the first entry, as the scan does" {
  // Two entries for function 4; the scan returns the first, so the table must
  // not let the later one overwrite it.
  let c = cache_with_indices([4, 1, 4, 0])
  inspect(lookup_disagreements(c, 8), content = "")
  let idx = codegen_body_cache_slot_index(c, 8)
  inspect(codegen_body_cache_find_at(idx, 4), content = "0")
}

test "an empty cache answers -1 through both lookups" {
  let empty = codegen_body_cache_new()
  inspect(lookup_disagreements(empty, 5), content = "")
  inspect(codegen_body_cache_find_at(codegen_body_cache_slot_index(empty, 5), 0), content = "-1")
}

// The one shape on which the two lookups CANNOT agree: a cache carrying a
// negative function index. The scan finds it (a plain equality test); a
// direct-address table has no slot for it. Measured -- this test read
// `-1:0/-1` before the decoder refused such a cache.
//
// A function index is a position in the program's function list, so a negative
// one is not a function and the entry is not a body any compile could replay.
// Refusing the whole cache is this artifact's established rule (#2388: a stale
// entry may cause a miss, never a wrong body), and it is what makes the
// equivalence above hold for every cache the system can load rather than for
// every cache someone might hand-build.
test "a persisted cache carrying a negative function index is refused" {
  let bad = cache_with_indices([0 - 1, 2])
  // The other arrays must be the right length or the decoder refuses for that
  // reason instead, which would prove nothing about the index check.
  let mut i = 0
  while i < 2 {
    Array::push(bad.fn_src_stmts, 0 - 1)
    Array::push(bad.fn_bodies, Bytes::from_array([]))
    Array::push(bad.fn_meta_i32, 0)
    Array::push(bad.fn_meta_i64, 0)
    Array::push(bad.fn_meta_v128, 0)
    i = i + 1
  }
  let refused = match codegen_body_cache_from_bytes(codegen_body_cache_to_bytes(bad)) {
    Some(_) => "accepted",
    None => "refused"
  }
  inspect(refused, content = "refused")
  // The control: the same cache with the index made non-negative decodes, so
  // the refusal above is the index check and not the round trip failing.
  let ok = cache_with_indices([1, 2])
  i = 0
  while i < 2 {
    Array::push(ok.fn_src_stmts, 0 - 1)
    Array::push(ok.fn_bodies, Bytes::from_array([]))
    Array::push(ok.fn_meta_i32, 0)
    Array::push(ok.fn_meta_i64, 0)
    Array::push(ok.fn_meta_v128, 0)
    i = i + 1
  }
  let accepted = match codegen_body_cache_from_bytes(codegen_body_cache_to_bytes(ok)) {
    Some(_) => "accepted",
    None => "refused"
  }
  inspect(accepted, content = "accepted")
}

test "#2669: index-keyed replay reuses everything while the assignment agrees" {
  // THE BASELINE step 2 has to improve, pinned before the work rather than
  // claimed after it. `body_cache_out` records exactly the functions a build
  // COMPILED -- `codegen_body_cache_record` runs only on the non-replay
  // branch -- so its length is the recompile count directly, with no
  // instrumentation and no proxy.
  let src = "let alpha: () -> Int = () -> { 1 }\nlet beta: () -> Int = () -> { alpha() + 1 }\nlet run: () -> Int = () -> { beta() + alpha() }"
  let out_a = codegen_body_cache_new()
  let cold = compile_wasi_module_rc_body_cached(parse_program(lex(src)), "run", codegen_body_cache_new(), out_a)
  inspect(Array::length(out_a.fn_indices), content = "3")
  // Handed that harvest, the same program recompiles NOTHING and answers the
  // same bytes. Full reuse is available -- when the index assignment agrees.
  let out_b = codegen_body_cache_new()
  let warm = compile_wasi_module_rc_body_cached(parse_program(lex(src)), "run", out_a, out_b)
  inspect(Array::length(out_b.fn_indices), content = "0")
  assert(bytes_eq(cold, warm))
}

test "#2669: a failed layout guard narrows to the prefix instead of dropping the cache" {
  // The half of step 2b that lives in the body loop. Widening WHICH entries
  // survive the file table is only safe while the index spaces a body refers
  // to are unchanged; when they are not, the lane must fall back to what the
  // prefix rule would have replayed -- not to nothing. Without this, every
  // edit the new guards reject (a new closure, a new literal, a renamed
  // function) would lose the prefix it replays today: a REGRESSION dressed as
  // an improvement.
  //
  // The array comparison forces a derived comparator, which is what makes the
  // compile run the #2388 pin reorder and record guards at all.
  let src = "let seed_eq: () -> Bool = () -> { [1, 2] == [1, 2] }\nlet alpha: () -> Int = () -> { 1 }\nlet beta: () -> Int = () -> { alpha() + 1 }\nlet run: () -> Int = () -> { if seed_eq() { beta() + alpha() } else { 0 } }"
  let cold_out = codegen_body_cache_new()
  let cold = compile_wasi_module_rc_body_cached(parse_program(lex(src)), "run", codegen_body_cache_new(), cold_out)
  let cold_n = Array::length(cold_out.fn_indices)
  assert(cold_n > 1)
  // Non-vacuity: the harvest must actually carry the guards this test poisons.
  assert(Array::length(cold_out.guard_strpool) == 4)
  assert(Array::length(cold_out.guard_user_names) > 0)
  // GREEN: guards intact, no narrowing annotation -- full reuse, as before.
  let warm_out = codegen_body_cache_new()
  let warm = compile_wasi_module_rc_body_cached(parse_program(lex(src)), "run", cold_out, warm_out)
  inspect(Array::length(warm_out.fn_indices), content = "0")
  assert(bytes_eq(cold, warm))
  // RED, once per guard. Each of the three has to be able to decline on its
  // own: a comparison nobody can make fail is a comparison that can be deleted
  // without a test noticing, which is how #2248's five green runs happened.
  let mut which = 0
  while which < 3 {
    match codegen_body_cache_from_bytes(codegen_body_cache_to_bytes(cold_out)) {
      Some(narrowed_in) => {
        if which == 0 {
          // The pooled strings moved: every `(offset << 32) | length` a later
          // body embeds now names a different string.
          Array::set(narrowed_in.guard_strpool, 2, Array::get(narrowed_in.guard_strpool, 2) + 1)
        } else if which == 1 {
          // The function vector changed: call immediates and function-value
          // slots name different functions.
          Array::push(narrowed_in.guard_user_names, "#poison")
        } else {
          // The lambda plan changed: funcref slots move.
          Array::push(narrowed_in.guard_lambda_counts, 1)
        }
        Array::push(narrowed_in.consumer_src_limit, 2)
        let narrowed_out = codegen_body_cache_new()
        let narrowed = compile_wasi_module_rc_body_cached(parse_program(lex(src)), "run", narrowed_in, narrowed_out)
        let narrowed_n = Array::length(narrowed_out.fn_indices)
        // Neither zero (the guard would not be doing anything) nor everything
        // (the prefix would have been thrown away with it).
        assert(narrowed_n > 0)
        assert(narrowed_n < cold_n)
        assert(bytes_eq(cold, narrowed))
      },
      None => assert(false)
    }
    which = which + 1
  }
  // Control: the same poisoned guard with NO annotation cannot narrow, which
  // is the in-process lane's shape -- it replays everything, exactly as the
  // green case does. This is what says the previous block was the annotation
  // talking and not the poison alone.
  match codegen_body_cache_from_bytes(codegen_body_cache_to_bytes(cold_out)) {
    Some(unannotated) => {
      Array::set(unannotated.guard_strpool, 2, Array::get(unannotated.guard_strpool, 2) + 1)
      let unannotated_out = codegen_body_cache_new()
      let bytes = compile_wasi_module_rc_body_cached(parse_program(lex(src)), "run", unannotated, unannotated_out)
      inspect(Array::length(unannotated_out.fn_indices), content = "0")
      assert(bytes_eq(cold, bytes))
    },
    None => assert(false)
  }
}

test "#2669: an edit to the FIRST file replays the files after it" {
  // The KPI claim, end to end on the FS lane and stated in the only terms it
  // is visible in: how many bodies the compile rebuilt.
  //
  // Three files in a chain, so merge order is a -> b -> main and an edit to
  // `a` is upstream of everything. Under the prefix rule that leaves NOTHING
  // replayable: the first file mismatched, so the unchanged leading run is
  // empty and the compile is a cold one.
  let a_path = "/tmp/vibe_body_cache_wide_a.vibe"
  let b_path = "/tmp/vibe_body_cache_wide_b.vibe"
  let main_path = "/tmp/vibe_body_cache_wide_main.vibe"
  // The array comparison in `a` forces a derived comparator, so the compile
  // runs the pin reorder and records the guards this lane needs.
  // Every file carries a string literal, so the pooled offsets a later body
  // embeds are real and the last block below has something to move.
  let a_source = "export let a_eq: () -> Bool = () -> { [1, 2] == [1, 2] }\nexport let a_one: () -> String = () -> { \"alpha one\" }\nexport let a_two: () -> String = () -> { \"alpha two\" }"
  let b_source = "import ./vibe_body_cache_wide_a.vibe { a_one, a_two }\nexport let b_one: () -> String = () -> { String::concat(a_one(), a_two()) }\nexport let b_two: () -> String = () -> { String::concat(b_one(), \"beta\") }"
  let main_source = "import ./vibe_body_cache_wide_b.vibe { b_one, b_two }\nlet run: () -> Int = () -> { String::length(String::concat(b_one(), b_two())) }"
  Fs::write_bytes(a_path, string_to_bytes(a_source))
  Fs::write_bytes(b_path, string_to_bytes(b_source))
  Fs::write_bytes(main_path, string_to_bytes(main_source))
  let artifact_path = persistent_artifact_cache_path("codegen-body-cache", "run", String::concat("self-describing-", compact_string_fingerprint(main_path)))
  remove_file_if_exists(artifact_path)
  let cold_counts: Array[Int] = []
  let cold = compile_file_fs_mode_rc_body_cached_counted(main_path, "run", "on", cold_counts)
  // Nothing offered on a cold run; everything rebuilt.
  inspect(Array::get(cold_counts, 0), content = "0")
  let cold_n = Array::get(cold_counts, 1)
  assert(cold_n > 3)
  // A comment-only edit to the FIRST file. Its fingerprint changes; its
  // statements, functions, closures and literals do not, so every layout
  // guard still holds for the files after it.
  Fs::write_bytes(a_path, string_to_bytes(String::concat(a_source, "\n// touched")))
  let warm_counts: Array[Int] = []
  let warm = compile_file_fs_mode_rc_body_cached_counted(main_path, "run", "on", warm_counts)
  // Sharper than "fewer": everything the file table offered was REPLAYED, so
  // the compile rebuilt exactly the rest. Under the prefix rule the offer
  // itself is zero -- the first file mismatched -- which is what the mutation
  // test for this behaviour turns off.
  assert(Array::get(warm_counts, 0) > 0)
  inspect(Array::get(warm_counts, 1) + Array::get(warm_counts, 0) == cold_n, content = "true")
  // Reuse is not an excuse to answer differently.
  assert(bytes_eq(warm, compile_file_fs_mode_rc(main_path, "run")))
  // And the same edit under verify, which compiles twice and throws on the
  // first differing byte -- the replayed bodies are what the compiler itself
  // emits for this build, not merely bytes that link.
  Fs::write_bytes(a_path, string_to_bytes(String::concat(a_source, "\n// touched twice")))
  let verify_counts: Array[Int] = []
  let verified = compile_file_fs_mode_rc_body_cached_counted(main_path, "run", "verify", verify_counts)
  assert(Array::get(verify_counts, 0) > 0)
  assert(Bytes::length(verified) > 0)
  // The conservative half, stated rather than left implied. LENGTHENING an
  // existing literal in `a` keeps the statement count, the function vector and
  // the lambda plan identical -- so the file table still offers the later
  // files -- while every pooled offset after it moves. The pool guard is what
  // turns that into a narrow to the prefix, which for a first-file edit is
  // empty: the build is cold again.
  //
  // The byte comparison is the load-bearing one. Measured with the pool guard
  // dropped from `lc_wide_ok`: `offered=3 recompiled=1022` and the module is
  // NOT what a fresh compile emits -- `b_two`'s cached body still points at
  // where "beta" used to sit. A count is a cost; this is correctness.
  //
  // Adding a DECLARATION instead would prove nothing about the pool: the file's
  // statement count changes and the table refuses the layout before any guard
  // is consulted. Measured, that variant reports `offered=0` either way.
  let a_moved = "export let a_eq: () -> Bool = () -> { [1, 2] == [1, 2] }\nexport let a_one: () -> String = () -> { \"alpha one is now a good deal longer\" }\nexport let a_two: () -> String = () -> { \"alpha two\" }"
  Fs::write_bytes(a_path, string_to_bytes(a_moved))
  let moved_counts: Array[Int] = []
  let moved = compile_file_fs_mode_rc_body_cached_counted(main_path, "run", "on", moved_counts)
  // Still offered by the file table -- the layout is intact -- and still not
  // replayed, because the guard says the offsets moved.
  assert(Array::get(moved_counts, 0) > 0)
  inspect(Array::get(moved_counts, 1) == cold_n, content = "true")
  assert(bytes_eq(moved, compile_file_fs_mode_rc(main_path, "run")))
}

//# `codegen_body_cache_find` keys on the FUNCTION INDEX, so an entry is only
//# meaningful in a build that assigns that index to the same function. The FS
//# layer supplies exactly that: `decode_body_cache_payload_for` keeps the
//# unchanged PREFIX of files and `codegen_body_cache_filter_src_below` trims
//# to it, and over an identical prefix index i names the same function in both
//# builds. The prefix rule is not timidity -- it IS the precondition.
//#
//# Measured (#2669, not asserted here because it describes a misuse rather
//# than a behaviour worth freezing): hand this entry point a harvest whose
//# assignment does NOT agree -- insert a function ahead of the others -- and
//# it replays 3 of 4 bodies into the wrong slots and answers a module that
//# differs from a fresh compile. Production cannot reach that, because the
//# prefix filter is upstream of it.
//#
//# That is what makes the prefix rule expensive: an edit early in merge order
//# invalidates everything after it, whether or not those bodies changed. Step
//# 2 removes the cost by removing the dependence -- key the lookup on function
//# IDENTITY and relocate the references -- at which point the precondition is
//# no longer needed and the filter can keep every unchanged file.
