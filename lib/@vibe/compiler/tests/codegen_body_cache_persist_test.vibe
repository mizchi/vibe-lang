//# Functions

fn string_to_bytes(_ s: String) -> Bytes {
  let out = Bytes::new()
  let len = String::length(s)
  let mut i = 0
  while i < len {
    Bytes::push(out, value = String::char_code_at(s, at = i))
    i = i + 1
  }
  out
}

fn bytes_eq(a: Bytes, b: Bytes) -> Bool {
  let n = Bytes::length(a)
  if n != Bytes::length(b) {
    false
  } else {
    let mut i = 0
    let mut same = true
    while same && i < n {
      if Bytes::get(a, at = i) != Bytes::get(b, at = i) {
        same = false
      } else {
        i = i + 1
      }
    }
    same
  }
}

fn remove_file_if_exists(_ path: String) -> Unit with Fs {
  if Fs::exists(path) {
    Fs::remove(path)
  } else {
    ()
  }
}

/// A populated cache exercising every field group: one function entry in the
/// source region (fn_index 0), one outside it (fn_index 3, which the filter
/// must drop), a lambda with captures, a slot-log entry, and recorded
/// guards.
fn sample_cache() -> CodegenBodyCache {
  let c = codegen_body_cache_new()
  Array::push(c.fn_indices, value = 0)
  Array::push(c.fn_names, value = "alpha")
  Array::push(c.fn_files, value = 0)
  Array::push(c.fn_src_stmts, value = 2)
  Array::push(c.fn_bodies, value = string_to_bytes("ab"))
  Array::push(c.fn_meta_i32, value = 1)
  Array::push(c.fn_meta_i64, value = 2)
  Array::push(c.fn_meta_v128, value = 0)
  Array::push(c.fn_fold_sigs, value = "")
  Array::push(c.fn_indices, value = 3)
  Array::push(c.fn_names, value = "beta")
  Array::push(c.fn_files, value = 1)
  Array::push(c.fn_src_stmts, value = 7)
  Array::push(c.fn_bodies, value = string_to_bytes("cde"))
  Array::push(c.fn_meta_i32, value = 4)
  Array::push(c.fn_meta_i64, value = 5)
  Array::push(c.fn_meta_v128, value = 1)
  Array::push(c.fn_fold_sigs, value = "")
  Array::push(c.lam_owner, value = 0)
  Array::push(c.lam_indices, value = 5)
  Array::push(c.lam_bodies, value = string_to_bytes("xyz"))
  Array::push(c.lam_param_counts, value = 2)
  Array::push(c.lam_captures, value = ["a", "bb"])
  Array::push(c.lam_meta_i32, value = 9)
  Array::push(c.lam_meta_i64, value = 0 - 1)
  Array::push(c.slot_owner, value = 0)
  Array::push(c.slot_values, value = 1029)
  // #2669 slice 3: blind references, one owned by the FUNCTION and one owned
  // by a LAMBDA. The lambda's owner is `blind_owner_of_lambda(5)` = -7, which
  // is what makes this case load-bearing: the plain int codec encodes `v + 1`
  // unsigned and throws below -1, so before the zigzag column this aborted
  // the whole serialization. The sample had no blind rows at all, so the
  // round-trip proved nothing about them.
  Array::push(c.blind_fn, value = 0)
  Array::push(c.blind_body, value = 0)
  Array::push(c.blind_offsets, value = 17)
  Array::push(c.blind_kinds, value = 101)
  Array::push(c.blind_syms, value = 42)
  Array::push(c.blind_fn, value = 0)
  Array::push(c.blind_body, value = 0 - 7)
  Array::push(c.blind_offsets, value = 3)
  Array::push(c.blind_kinds, value = 102)
  Array::push(c.blind_syms, value = 1030)
  // #2199: per-function linemap rows. Replay skips `compile_expr`, so these
  // have to round-trip or `verify` sees a shorter `vibe.linemap` than fresh.
  Array::push(c.lm_owner, value = 0)
  Array::push(c.lm_offsets, value = 12)
  Array::push(c.lm_file_ids, value = 0)
  Array::push(c.lm_lines, value = 4)
  Array::push(c.lm_owner, value = 3)
  Array::push(c.lm_offsets, value = 8)
  Array::push(c.lm_file_ids, value = 1)
  Array::push(c.lm_lines, value = 9)
  Array::push(c.guard_meta, value = 1)
  Array::push(c.guard_meta, value = 1024)
  Array::push(c.guard_meta, value = 2048)
  Array::push(c.guard_meta, value = 7)
  Array::push(c.guard_meta, value = 40)
  Array::push(c.guard_synth_names, value = "Pt::equals")
  Array::push(c.guard_synth_stmts, value = 42)
  Array::push(c.guard_import_names, value = "vibe_env_get")
  Array::push(c.guard_import_names, value = "vibe_http_request_raw")
  Array::push(c.guard_borrow_names, value = "peek")
  Array::push(c.guard_borrow_masks, value = 5)
  Array::push(c.guard_unmangled_names, value = "run")
  // #2669 step 2b: two layout slots, and one typed-lowering slot.
  Array::push(c.guard_layout, value = 3)
  Array::push(c.guard_layout, value = 12)
  Array::push(c.guard_layout, value = 99)
  Array::push(c.guard_layout, value = 77)
  Array::push(c.guard_typed_lowering, value = 5)
  Array::push(c.guard_typed_lowering, value = 8)
  c
}

/// #2669 step 2b: two source-region entries, at merged statements 1 and 9.
///
/// The gap is the point. A PREFIX limit cannot keep the entry at 9 without
/// also keeping the one at 1, so a filter that can is doing something the old
/// one could not express -- which is the whole of this step at the decode
/// layer.
fn cache_two_files() -> CodegenBodyCache {
  let c = codegen_body_cache_new()
  Array::push(c.fn_indices, value = 0)
  Array::push(c.fn_names, value = "early")
  Array::push(c.fn_files, value = 0)
  Array::push(c.fn_src_stmts, value = 1)
  Array::push(c.fn_bodies, value = string_to_bytes("e"))
  Array::push(c.fn_meta_i32, value = 0)
  Array::push(c.fn_meta_i64, value = 0)
  Array::push(c.fn_meta_v128, value = 0)
  Array::push(c.fn_fold_sigs, value = "")
  Array::push(c.fn_indices, value = 1)
  Array::push(c.fn_names, value = "late")
  Array::push(c.fn_files, value = 2)
  Array::push(c.fn_src_stmts, value = 9)
  Array::push(c.fn_bodies, value = string_to_bytes("l"))
  Array::push(c.fn_meta_i32, value = 0)
  Array::push(c.fn_meta_i64, value = 0)
  Array::push(c.fn_meta_v128, value = 0)
  Array::push(c.fn_fold_sigs, value = "")
  Array::push(c.slot_owner, value = 1)
  Array::push(c.slot_values, value = 2048)
  // pin_src_n = 2, so BOTH entries are in the source region and the region
  // test cannot be what decides either case below.
  Array::push(c.guard_meta, value = 2)
  Array::push(c.guard_meta, value = 1024)
  Array::push(c.guard_meta, value = 2048)
  Array::push(c.guard_meta, value = 7)
  Array::push(c.guard_meta, value = 40)
  c
}

test "codegen body cache codec round-trips every field group" {
  let c = sample_cache()
  let b = codegen_body_cache_to_bytes(c)
  match codegen_body_cache_from_bytes(b) {
    Some(d) => {
      inspect(Array::length(d.fn_indices), content = "2")
      inspect(Array::get(d.fn_indices, at = 1), content = "3")
      inspect(Array::get(d.fn_src_stmts, at = 0), content = "2")
      // #2669 step 2a. Asserted rather than merely carried: the previous
      // column this struct gained (blind_body) round-tripped untested because
      // the fixture enumerated rows by hand and did not grow with the struct,
      // and the codec threw on it in production.
      inspect(Array::get(d.fn_names, at = 0), content = "alpha")
      inspect(Array::get(d.fn_names, at = 1), content = "beta")
      inspect(Array::get(d.fn_files, at = 1), content = "1")
      assert(bytes_eq(a = Array::get(d.fn_bodies, at = 1), b = string_to_bytes("cde")))
      inspect(Array::get(d.fn_meta_v128, at = 1), content = "1")
      inspect(Array::length(d.lam_owner), content = "1")
      assert(bytes_eq(a = Array::get(d.lam_bodies, at = 0), b = string_to_bytes("xyz")))
      inspect(Array::get(d.lam_param_counts, at = 0), content = "2")
      inspect(Array::get(Array::get(d.lam_captures, at = 0), at = 1), content = "bb")
      inspect(Array::get(d.lam_meta_i64, at = 0), content = "-1")
      inspect(Array::get(d.slot_values, at = 0), content = "1029")
      // #2669 slice 3. The second row is the one that matters: its body owner
      // is a LAMBDA, so the value is negative and the plain column's encoder
      // refuses it. Round-tripping it exactly is the whole point of giving
      // this column a zigzag encoding.
      inspect(Array::length(d.blind_fn), content = "2")
      inspect(Array::get(d.blind_body, at = 0), content = "0")
      inspect(Array::get(d.blind_body, at = 1), content = "-7")
      inspect(Array::get(d.blind_offsets, at = 1), content = "3")
      inspect(Array::get(d.blind_kinds, at = 1), content = "102")
      inspect(Array::get(d.blind_syms, at = 1), content = "1030")
      inspect(Array::length(d.lm_owner), content = "2")
      inspect(Array::get(d.lm_owner, at = 1), content = "3")
      inspect(Array::get(d.lm_offsets, at = 0), content = "12")
      inspect(Array::get(d.lm_file_ids, at = 1), content = "1")
      inspect(Array::get(d.lm_lines, at = 0), content = "4")
      inspect(Array::get(d.guard_meta, at = 2), content = "2048")
      inspect(Array::get(d.guard_meta, at = 4), content = "40")
      inspect(Array::get(d.guard_synth_names, at = 0), content = "Pt::equals")
      inspect(Array::get(d.guard_synth_stmts, at = 0), content = "42")
      inspect(Array::get(d.guard_import_names, at = 1), content = "vibe_http_request_raw")
      inspect(Array::get(d.guard_borrow_names, at = 0), content = "peek")
      inspect(Array::get(d.guard_borrow_masks, at = 0), content = "5")
      inspect(Array::get(d.guard_unmangled_names, at = 0), content = "run")
      inspect(Array::length(d.guard_layout), content = "4")
      inspect(Array::get(d.guard_layout, at = 3), content = "77")
      inspect(Array::length(d.guard_typed_lowering), content = "2")
      inspect(Array::get(d.guard_typed_lowering, at = 1), content = "8")
      // The decode-time annotation is NOT in the stream: it describes the
      // build that read the artifact, not the harvest that wrote it.
      inspect(Array::length(d.consumer_src_limit), content = "0")
    },
    None => assert(false)
  }
}

test "codegen body cache codec fails safe on damage" {
  let c = sample_cache()
  let b = codegen_body_cache_to_bytes(c)
  // Wrong magic.
  let wrong_magic = Bytes::concat(string_to_bytes("XBC1"), Bytes::slice(b, start = 4, end = Bytes::length(b)))
  match codegen_body_cache_from_bytes(wrong_magic) {
    Some(_) => assert(false),
    None => assert(true)
  }
  // Truncation anywhere in the stream degrades to None, never to a partial
  // cache.
  match codegen_body_cache_from_bytes(Bytes::slice(b, start = 0, end = Bytes::length(b) - 3)) {
    Some(_) => assert(false),
    None => assert(true)
  }
  match codegen_body_cache_from_bytes(Bytes::slice(b, start = 0, end = 6)) {
    Some(_) => assert(false),
    None => assert(true)
  }
}

/// A replay's sinks, so the two cases below differ only in the LineMapState.
fn replay_into(_ lm: LineMapState) -> Int {
  let c = sample_cache()
  let lt = LambdaTable::{
    base: 0,
    bodies: [],
    param_counts: [],
    captures: [],
    meta_i32: [],
    meta_i64: []
  }
  let bodies: Array[Bytes] = []
  codegen_body_cache_replay(cache = c, at = 0, bodies = bodies, meta_i32 = [], meta_i64 = [
  ], meta_v128 = [], lt = lt, slots = [], blind_bodies = [], blind_offsets = [], blind_kinds = [
  ], blind_syms = [], lm = lm, replay_bi = 7)
  Array::length(lm.offsets)
}

test "#2199: a replay into a disabled linemap contributes no rows" {
  // The compile hands `codegen_body_cache_replay` a DISABLED state for a
  // function whose source file it declines to place (`lc_dbg_file_placed`
  // answering -1: a prelude-synthesized definition, or a `test` label two
  // modules share). A fresh compile of that function records nothing, so a
  // replay of it must not re-push the rows a compile under a different module
  // set once cached -- `verify` would compare a populated table against an
  // empty one, and `on` would print a file the body may not be in.
  inspect(replay_into(linemap_disabled()), content = "0")
  // The control: the same entry through an ENABLED state does replay its row,
  // so the 0 above is the guard and not a cache that carries nothing.
  let on = linemap_scratch_on()
  inspect(replay_into(on), content = "1")
  inspect(Array::get(on.funcs, at = 0), content = "7")
  inspect(Array::get(on.lines, at = 0), content = "4")
}

/// #2874: an enabled state with empty tables, for the cases below.
fn linemap_scratch_on() -> LineMapState {
  LineMapState::{
    enabled: true,
    cur_fn: [0],
    funcs: [],
    offsets: [],
    file_ids: [],
    lines: [],
    stream: Bytes::new(),
    grp_fn: [],
    grp_first_off: [],
    grp_start: [],
    site: [0]
  }
}

/// #2874: the scratch tables hold ONE function's rows and
/// `linemap_flush_fn` moves them into `stream` as a group, so what the
/// emitter reads is the group list and not four module-wide tables.
///
/// The group's payload is the section's own encoding minus the two fields the
/// emitter supplies: the first row keeps only its file id and line (its
/// offset is `grp_first_off`, held out because the locals-header rebase moves
/// it, and its function delta is not known until the emitter knows which
/// group came before). Every row AFTER the first is a whole LEB quadruple,
/// the zero function delta included -- omitting it produced a section that
/// still validated and that the late-DCE prune re-parsed into garbage.
test "#2874: a flush encodes one function's rows and empties the scratch" {
  let lm = linemap_scratch_on()
  // Two rows for function 7: (offset 4, file 1, line 9) and (12, 1, 11).
  Array::push(lm.funcs, value = 7)
  Array::push(lm.offsets, value = 4)
  Array::push(lm.file_ids, value = 1)
  Array::push(lm.lines, value = 9)
  Array::push(lm.funcs, value = 7)
  Array::push(lm.offsets, value = 12)
  Array::push(lm.file_ids, value = 1)
  Array::push(lm.lines, value = 11)
  linemap_flush_fn(lm)
  inspect(Array::length(lm.offsets), content = "0")
  inspect(Array::length(lm.grp_fn), content = "1")
  inspect(Array::get(lm.grp_fn, at = 0), content = "7")
  inspect(Array::get(lm.grp_first_off, at = 0), content = "4")
  inspect(Array::get(lm.grp_start, at = 0), content = "0")
  // file 1, line 9, then the second row as (fd=0, od=8, file=1, line=11).
  inspect(bytes_codes(lm.stream), content = "[1, 9, 0, 8, 1, 11]")
}

test "#2874: a second flush appends a group and leaves the first alone" {
  let lm = linemap_scratch_on()
  Array::push(lm.funcs, value = 2)
  Array::push(lm.offsets, value = 3)
  Array::push(lm.file_ids, value = 0)
  Array::push(lm.lines, value = 5)
  linemap_flush_fn(lm)
  Array::push(lm.funcs, value = 9)
  Array::push(lm.offsets, value = 1)
  Array::push(lm.file_ids, value = 4)
  Array::push(lm.lines, value = 6)
  linemap_flush_fn(lm)
  inspect(Array::length(lm.grp_fn), content = "2")
  inspect(Array::get(lm.grp_fn, at = 1), content = "9")
  inspect(Array::get(lm.grp_first_off, at = 1), content = "1")
  // The second group starts where the first one's payload ended.
  inspect(Array::get(lm.grp_start, at = 1), content = "2")
  inspect(bytes_codes(lm.stream), content = "[0, 5, 4, 6]")
}

test "#2874: flushing an empty scratch is a no-op, not an empty group" {
  let lm = linemap_scratch_on()
  linemap_flush_fn(lm)
  linemap_flush_fn(lm)
  inspect(Array::length(lm.grp_fn), content = "0")
  inspect(Bytes::length(lm.stream), content = "0")
}

/// The stream's bytes, so a snapshot can name them rather than a length.
fn bytes_codes(_ b: Bytes) -> Array[Int] {
  let out: Array[Int] = []
  let mut i = 0
  while i < Bytes::length(b) {
    Array::push(out, value = Bytes::get(b, at = i))
    i = i + 1
  }
  out
}

test "filter_src_below keeps only guarded source-region entries below the limit" {
  let c = sample_cache()
  // limit 7: entry (fn 0, src 2) survives; (fn 3, src 7) is out by limit AND
  // out of the source region (guard_meta[0] == 1). The kept function's
  // lambda and slot entries ride along; guards are copied verbatim.
  let f = codegen_body_cache_filter_src_below(cache = c, limit = 7)
  inspect(Array::length(f.fn_indices), content = "1")
  inspect(Array::get(f.fn_indices, at = 0), content = "0")
  inspect(Array::length(f.lam_owner), content = "1")
  inspect(Array::length(f.slot_owner), content = "1")
  inspect(Array::length(f.lm_owner), content = "1")
  inspect(Array::get(f.lm_owner, at = 0), content = "0")
  inspect(Array::length(f.guard_meta), content = "5")
  inspect(Array::get(f.guard_synth_names, at = 0), content = "Pt::equals")
  inspect(Array::length(f.guard_import_names), content = "2")
  // A guard-less cache never crosses compiles: it filters to empty.
  let unguarded = sample_cache()
  Array::truncate(unguarded.guard_meta, length = 0)
  let g = codegen_body_cache_filter_src_below(cache = unguarded, limit = 100)
  inspect(Array::length(g.fn_indices), content = "0")
}

test "#2669: filter_src_keep keeps a LATE unchanged file the prefix rule cannot reach" {
  let c = cache_two_files()
  // The case that does not exist under a prefix limit: file 2 is unchanged,
  // file 0 is not.
  let late_only = codegen_body_cache_filter_src_keep(cache = c, keep_file = [
    0,
    0,
    1
  ])
  inspect(Array::length(late_only.fn_indices), content = "1")
  inspect(Array::get(late_only.fn_names, at = 0), content = "late")
  // Its funcref slot rides along, exactly as the prefix filter carries one.
  inspect(Array::length(late_only.slot_owner), content = "1")
  // Control: the same filter asked the other way answers the other entry, so
  // the result above is the keep-map talking and not a constant.
  let early_only = codegen_body_cache_filter_src_keep(cache = c, keep_file = [
    1,
    0,
    0
  ])
  inspect(Array::length(early_only.fn_indices), content = "1")
  inspect(Array::get(early_only.fn_names, at = 0), content = "early")
  // And the prefix filter genuinely cannot express the first answer: any limit
  // that reaches the late entry's statement also takes the early one.
  inspect(Array::length(codegen_body_cache_filter_src_below(cache = c, limit = 10).fn_indices), content = "2")
  inspect(Array::length(codegen_body_cache_filter_src_below(cache = c, limit = 2).fn_indices), content = "1")
  // A file index outside the map is not kept -- a torn or short map costs a
  // recompile, never a body attributed to a file nobody described.
  inspect(Array::length(codegen_body_cache_filter_src_keep(cache = c, keep_file = [
    1
  ]).fn_indices), content = "1")
  // An entry whose file could not be determined (-1: a name two files declare,
  // or a lane with no provenance) is never kept, whatever the map says.
  let unattributed = cache_two_files()
  Array::set(unattributed.fn_files, at = 1, value = 0 - 1)
  inspect(Array::length(codegen_body_cache_filter_src_keep(cache = unattributed, keep_file = [
    1,
    1,
    1
  ]).fn_indices), content = "1")
  // Guard-less caches never cross compiles, here as in the prefix filter.
  let unguarded = cache_two_files()
  Array::truncate(unguarded.guard_meta, length = 0)
  inspect(Array::length(codegen_body_cache_filter_src_keep(cache = unguarded, keep_file = [
    1,
    1,
    1
  ]).fn_indices), content = "0")
}

test "the entry filter is sized by entry count, not by a stored index" {
  // Codex P2 on #3695: membership was a table addressed by the function
  // index, so a malformed artifact carrying `1 << 40` would allocate that
  // many slots and abort the compile instead of costing a miss. The index
  // itself is only compared now.
  let c = cache_two_files()
  Array::set(c.fn_indices, at = 1, value = 1<<40)
  Array::set(c.slot_owner, at = 0, value = 1<<40)
  let kept = codegen_body_cache_filter_src_keep(cache = c, keep_file = [1, 1, 1])
  // `1 << 40` is past the recorded source region, so the filter drops it --
  // and its slot row goes with it, which is the owner lookup working.
  inspect(Array::length(kept.fn_indices), content = "1")
  inspect(Array::length(kept.slot_owner), content = "0")
}

test "the entry filter keeps owner rows whatever order the entries arrive in" {
  // A merged cache concatenates two harvests, so kept indices are not sorted.
  let c = cache_two_files()
  Array::set(c.guard_meta, at = 0, value = 8)
  Array::set(c.fn_indices, at = 0, value = 5)
  Array::set(c.fn_indices, at = 1, value = 2)
  Array::set(c.slot_owner, at = 0, value = 2)
  Array::push(c.slot_owner, value = 5)
  Array::push(c.slot_values, value = 4096)
  Array::push(c.slot_owner, value = 3)
  Array::push(c.slot_values, value = 8192)
  let kept = codegen_body_cache_filter_src_keep(cache = c, keep_file = [1, 1, 1])
  inspect(Array::length(kept.fn_indices), content = "2")
  // Index 3 owns no kept entry, so only the rows of 2 and 5 remain.
  let owners: Array[Int] = kept.slot_owner
  inspect(owners, content = "[2, 5]")
}

test "#2818: src_keep_drops_any answers exactly whether filter_src_keep drops" {
  // The warm build refilters an already-filtered cache by the typed-lowering
  // guard and skips the copy when this says nothing would go.
  let c = cache_two_files()
  inspect(codegen_body_cache_src_keep_drops_any(cache = c, keep_file = [1, 1, 1]), content = "false")
  inspect(Array::length(codegen_body_cache_filter_src_keep(cache = c, keep_file = [
    1,
    1,
    1
  ]).fn_indices), content = "2")
  inspect(codegen_body_cache_src_keep_drops_any(cache = c, keep_file = [1, 1, 0]), content = "true")
  inspect(Array::length(codegen_body_cache_filter_src_keep(cache = c, keep_file = [
    1,
    1,
    0
  ]).fn_indices), content = "1")
  // An entry with no file id is dropped by the filter, so it counts.
  let unplaced = cache_two_files()
  Array::set(unplaced.fn_files, at = 0, value = 0 - 1)
  inspect(codegen_body_cache_src_keep_drops_any(cache = unplaced, keep_file = [
    1,
    1,
    1
  ]), content = "true")
}

test "#2669: the layout fingerprint separates the values that move a body's bytes" {
  // A body embeds `(offset << 32) | length`, so two string pools are
  // interchangeable for replay exactly when every string sits at the same
  // offset with the same bytes. These are the three ways that fails, and they
  // are why every element gets a separator byte.
  //
  // Same bytes, different split: "c" is at offset 2 in the first and at 1 in
  // the second.
  let ab_c: Array[Int] = []
  bcc_layout_fp_strings(out = ab_c, xs = ["ab", "c"])
  let a_bc: Array[Int] = []
  bcc_layout_fp_strings(out = a_bc, xs = ["a", "bc"])
  assert(!bcc_int_lists_equal(a = ab_c, b = a_bc))
  // Same strings, different order: "b" moves.
  let a_b: Array[Int] = []
  bcc_layout_fp_strings(out = a_b, xs = ["a", "b"])
  let b_a: Array[Int] = []
  bcc_layout_fp_strings(out = b_a, xs = ["b", "a"])
  assert(!bcc_int_lists_equal(a = a_b, b = b_a))
  // Same lengths, different content: every offset agrees and no body may
  // replay anyway, because the string AT each offset changed.
  let ab: Array[Int] = []
  bcc_layout_fp_strings(out = ab, xs = ["ab"])
  let cd: Array[Int] = []
  bcc_layout_fp_strings(out = cd, xs = ["cd"])
  assert(!bcc_int_lists_equal(a = ab, b = cd))
  // `upto` is respected: what lies past it is the source path/content region,
  // which no user body can reference.
  let past_long: Array[Int] = []
  bcc_layout_fp_strings_upto(out = past_long, xs = ["a", "b", "zzz"], upto = 2)
  let past_short: Array[Int] = []
  bcc_layout_fp_strings_upto(out = past_short, xs = ["a", "b", "q"], upto = 2)
  assert(bcc_int_lists_equal(a = past_long, b = past_short))
  // One call is one SLOT, so the order is positional and a caller cannot
  // append half of one.
  inspect(Array::length(ab_c), content = "2")
  // Int vectors separate the same three ways, which matters because the
  // constructor tags and the lambda plan are pinned as Int vectors.
  let ints_a: Array[Int] = []
  bcc_layout_fp_ints(out = ints_a, xs = [1, 2])
  let ints_b: Array[Int] = []
  bcc_layout_fp_ints(out = ints_b, xs = [2, 1])
  assert(!bcc_int_lists_equal(a = ints_a, b = ints_b))
  let ints_c: Array[Int] = []
  bcc_layout_fp_ints(out = ints_c, xs = [1, 2, 0])
  assert(!bcc_int_lists_equal(a = ints_a, b = ints_c))
  // A negative value (a -1 "absent" index) folds rather than trapping, and
  // does not collide with its magnitude.
  let neg: Array[Int] = []
  bcc_layout_fp_ints(out = neg, xs = [0 - 1])
  let pos: Array[Int] = []
  bcc_layout_fp_ints(out = pos, xs = [1])
  assert(!bcc_int_lists_equal(a = neg, b = pos))
  // The WHOLE 63-bit width, not the low 56. `1 << 56` against `0` is the pair
  // the first version collided (Codex P1): harmless for an index, not harmless
  // for `const_int_values`, where the pinned thing is a literal a body embeds.
  //
  // Red side measured, not assumed: reimplementing the seven-byte encoding
  // against the same accumulator collides on all THREE of the pairs below
  // (`0`/`1<<56`, `0`/`1<<61`, `1<<56`/`1<<61`) and the nine-byte one collides
  // on none. The extremes pair after them is NOT red -- seven bytes already
  // separated it -- and is here for a different property, that the sign split
  // handles the ends of the range without trapping on the way in.
  let zero: Array[Int] = []
  bcc_layout_fp_ints(out = zero, xs = [0])
  let high: Array[Int] = []
  bcc_layout_fp_ints(out = high, xs = [1<<56])
  assert(!bcc_int_lists_equal(a = zero, b = high))
  let higher: Array[Int] = []
  bcc_layout_fp_ints(out = higher, xs = [1<<61])
  assert(!bcc_int_lists_equal(a = zero, b = higher))
  assert(!bcc_int_lists_equal(a = high, b = higher))
  // The extremes round-trip through the sign split rather than trapping. The
  // most negative Int is not spellable as a literal (the bound is symmetric
  // about the positive side), so it is built by negating the largest one and
  // subtracting.
  let most_negative: Array[Int] = []
  bcc_layout_fp_ints(out = most_negative, xs = [0 - 4611686018427387903 - 1])
  let most_positive: Array[Int] = []
  bcc_layout_fp_ints(out = most_positive, xs = [4611686018427387903])
  assert(!bcc_int_lists_equal(a = most_negative, b = most_positive))
  // Accumulation appends: two slots are four ints.
  let two: Array[Int] = []
  bcc_layout_fp_strings(out = two, xs = ["a"])
  bcc_layout_fp_ints(out = two, xs = [1])
  inspect(Array::length(two), content = "4")
}

test "guard validation can fail: a poisoned body replays, a poisoned guard drops the cache" {
  // Red/green pair for the #2388 guard validation, per the repo's gate
  // doctrine: a check is only trusted once it has been shown to fail.
  let src = "let helper: () -> Bool = () -> { [1, 2] == [1, 2] }\nlet run: () -> Int = () -> { if helper() { 42 } else { 0 } }"
  let out1 = codegen_body_cache_new()
  let fresh = compile_wasi_module_rc_body_cached(stmts = parse_program(lex(src)), entry_name = "run", body_cache_in = codegen_body_cache_new(), body_cache_out = out1)
  // RED (proves replay is live and this test can detect it): copy the
  // harvest, poison ONE cached body, keep the guards valid. A fresh parse
  // of the same source revalidates the guards, accepts the cache, and
  // replays the poisoned bytes -- the output MUST differ.
  match codegen_body_cache_from_bytes(codegen_body_cache_to_bytes(out1)) {
    Some(poisoned_body) => {
      let victim = Array::get(poisoned_body.fn_bodies, at = 0)
      Bytes::set(victim, at = Bytes::length(victim) - 1, value = (Bytes::get(victim, at = Bytes::length(victim) - 1) + 1)&255)
      let replayed = compile_wasi_module_rc_body_cached(stmts = parse_program(lex(src)), entry_name = "run", body_cache_in = poisoned_body, body_cache_out = codegen_body_cache_new())
      assert(!bytes_eq(a = fresh, b = replayed))
    },
    None => assert(false)
  }
  // GREEN: the same poisoned body PLUS a poisoned import-name guard. The
  // validation must now drop the cache wholesale, so the poisoned body
  // never reaches the output and the compile answers fresh bytes.
  match codegen_body_cache_from_bytes(codegen_body_cache_to_bytes(out1)) {
    Some(poisoned_guard) => {
      let victim2 = Array::get(poisoned_guard.fn_bodies, at = 0)
      Bytes::set(victim2, at = Bytes::length(victim2) - 1, value = (Bytes::get(victim2, at = Bytes::length(victim2) - 1) + 1)&255)
      Array::push(poisoned_guard.guard_import_names, value = "#never_a_builtin")
      let dropped = compile_wasi_module_rc_body_cached(stmts = parse_program(lex(src)), entry_name = "run", body_cache_in = poisoned_guard, body_cache_out = codegen_body_cache_new())
      assert(bytes_eq(a = fresh, b = dropped))
    },
    None => assert(false)
  }
}

test "a call-shape edit that flips the borrow ABI drops the cache" {
  // The ADR-0092 borrow-parameter inference is call-site sensitive: passing
  // a non-ident argument (`use_it(make())`) disqualifies the position that
  // `use_it(x)` qualifies, flipping the callee's parameter between borrowed
  // and owned -- a different body under an unchanged name and layout. The
  // borrow guard must drop the cache, so the replayed compile answers the
  // same bytes as a fresh one.
  let shared = "let seed_eq: () -> Bool = () -> { [1] == [1] }\nlet make: () -> Array[Int] = () -> { [1, 2] }\nlet use_it: (Array[Int]) -> Int = (xs) -> { Array::length(xs) }\n"
  let src_a = String::concat(shared, "let run: () -> Int = () -> { let x = make()\n  if seed_eq() { use_it(x) } else { 0 } }")
  let src_b = String::concat(shared, "let run: () -> Int = () -> { if seed_eq() { use_it(make()) } else { 0 } }")
  let out_a = codegen_body_cache_new()
  let _ = compile_wasi_module_rc_body_cached(stmts = parse_program(lex(src_a)), entry_name = "run", body_cache_in = codegen_body_cache_new(), body_cache_out = out_a)
  let out_b = codegen_body_cache_new()
  let fresh_b = compile_wasi_module_rc_body_cached(stmts = parse_program(lex(src_b)), entry_name = "run", body_cache_in = codegen_body_cache_new(), body_cache_out = out_b)
  // Non-vacuity: the two programs must actually record different borrow
  // guards -- otherwise this test would pass without exercising the drop.
  assert(!bcc_string_lists_equal(a = out_a.guard_borrow_names, b = out_b.guard_borrow_names) || !bcc_int_lists_equal(a = out_a.guard_borrow_masks, b = out_b.guard_borrow_masks))
  let replayed_b = compile_wasi_module_rc_body_cached(stmts = parse_program(lex(src_b)), entry_name = "run", body_cache_in = out_a, body_cache_out = codegen_body_cache_new())
  assert(bytes_eq(a = fresh_b, b = replayed_b))
}

test "persisted body cache: verify survives an entry edit; on matches a fresh compile" {
  let helper_path = "/tmp/vibe_codegen_body_cache_helper.vibe"
  let main_path = "/tmp/vibe_codegen_body_cache_main.vibe"
  // The helper compares arrays so the closure is guaranteed to synthesize a
  // derived comparator -- which makes the compile run the #2388 pin reorder
  // and record guards into the artifact.
  let helper_source = "export let helper_flag: () -> Bool = () -> { [1, 2] == [1, 2] }"
  let main_source1 = "import ./vibe_codegen_body_cache_helper.vibe { helper_flag }\nlet run: () -> Int = () -> { if helper_flag() { 40 + 2 } else { 0 } }"
  let main_source2 = "import ./vibe_codegen_body_cache_helper.vibe { helper_flag }\nlet run: () -> Int = () -> { if helper_flag() { 50 + 3 } else { 1 } }"
  Fs::write_bytes(helper_path, bytes = string_to_bytes(helper_source))
  Fs::write_bytes(main_path, bytes = string_to_bytes(main_source1))
  // Mirrors the lane's own key derivation: content-independent, but scoped
  // to the entry path so unrelated roots sharing an entry name (`run`)
  // cannot race on one artifact slot.
  let artifact_path = persistent_artifact_cache_path(kind = "codegen-body-cache", entry_name = "run", fingerprint = String::concat("self-describing-", compact_string_fingerprint(main_path)))
  remove_file_if_exists(artifact_path)
  // Run 1: no artifact yet -- verify has nothing to replay, compiles fresh
  // and stores the harvest.
  let bytes1 = compile_file_fs_mode_rc_body_cached(entry_path = main_path, entry_name = "run", cache_mode = "verify")
  assert(Fs::exists(artifact_path))
  // Run 2, nothing edited: every file matches the stored table, so the
  // whole harvest replays -- and verify throws if any replayed byte
  // differs from the fresh compile.
  let bytes2 = compile_file_fs_mode_rc_body_cached(entry_path = main_path, entry_name = "run", cache_mode = "verify")
  assert(bytes_eq(a = bytes1, b = bytes2))
  // Run 3, entry edited: only the helper prefix may replay; verify again
  // proves the replayed prefix bytes are what a fresh compile produces.
  Fs::write_bytes(main_path, bytes = string_to_bytes(main_source2))
  let bytes3 = compile_file_fs_mode_rc_body_cached(entry_path = main_path, entry_name = "run", cache_mode = "verify")
  assert(!bytes_eq(a = bytes2, b = bytes3))
  // "on" mode replays without the double compile; its output must be
  // byte-identical to the plain production lane's.
  let on_bytes = compile_file_fs_mode_rc_body_cached(entry_path = main_path, entry_name = "run", cache_mode = "on")
  let fresh_bytes = compile_file_fs_mode_rc(entry_path = main_path, entry_name = "run")
  assert(bytes_eq(a = on_bytes, b = fresh_bytes))
  // On-disk corruption: flip one byte inside the stored artifact's body
  // region (same length, valid framing). The payload checksum must reject
  // the whole artifact, so "on" still answers the fresh compile's bytes.
  let stored = Fs::read_bytes(artifact_path)
  let flip_at = Bytes::length(stored) / 2
  Bytes::set(stored, at = flip_at, value = (Bytes::get(stored, at = flip_at) + 1)&255)
  Fs::write_bytes(artifact_path, bytes = stored)
  let after_corruption = compile_file_fs_mode_rc_body_cached(entry_path = main_path, entry_name = "run", cache_mode = "on")
  assert(bytes_eq(a = after_corruption, b = fresh_bytes))
  // A guard-flipping edit (a new unmangled entry helper changes the global
  // name-membership guard) under VERIFY: the drift is an expected cache
  // miss checked against the fresh harvest's guards, never a thrown verify
  // mismatch -- the second compile re-feeds already-lowered stmts, where
  // linked_compile's own validation stands down.
  let main_source3 = String::concat(main_source2, "\nlet spare_helper: () -> Int = () -> { 7 }\nlet run2: () -> Int = () -> { spare_helper() }")
  Fs::write_bytes(main_path, bytes = string_to_bytes(main_source3))
  let bytes5 = compile_file_fs_mode_rc_body_cached(entry_path = main_path, entry_name = "run", cache_mode = "verify")
  assert(Bytes::length(bytes5) > 0)
}

// #2388 step 3 follow-up: the body loop asked `codegen_body_cache_find` once
// per function, and that function scans the whole cache -- quadratic in the
// function count, on the lane whose purpose is a cheap warm compile.
// `codegen_body_cache_slot_index` + `codegen_body_cache_find_at` answer in one
// read. The scan is the ORACLE here, not a second implementation to eyeball:
// the two must agree on every key, including the ones no entry holds.

/// A cache carrying only the lookup keys: `fn_indices`, and since #2669 step
/// 2a the parallel `fn_names` the name lookup reads.
fn cache_with_indices(_ indices: Array[Int]) -> CodegenBodyCache {
  let c = codegen_body_cache_new()
  let mut i = 0
  while i < Array::length(indices) {
    Array::push(c.fn_indices, value = Array::get(indices, at = i))
    Array::push(c.fn_names, value = String::concat("f", __to_string(Array::get(indices, at = i))))
    Array::push(c.fn_files, value = 0)
    i = i + 1
  }
  c
}

/// Every key in [0, key_count) on which the indexed lookup disagrees with the
/// scan, as `key:scan/indexed`. Empty means they agree over the whole key
/// space the table is built for.
fn lookup_disagreements(c: CodegenBodyCache, key_count: Int) -> String {
  let idx = codegen_body_cache_slot_index(cache = c, key_count = key_count)
  let out: Array[String] = []
  let mut k = 0
  while k < key_count {
    let a = codegen_body_cache_find(cache = c, fn_index = k)
    let b = codegen_body_cache_find_at(slot_index = idx, fn_index = k)
    if a == b {
      ()
    } else {
      Array::push(out, value = "\{k}:\{a}/\{b}")
    }
    k = k + 1
  }
  String::join(out, sep = ", ")
}

test "a duplicated function name is a miss on both name lookups" {
  // Duplicate function names are REAL, not hypothetical: two `test "..."`
  // blocks with the same title lower to the same `__test_` function (the
  // deleted `builtins_extended_test.vibe` carried such a pair until #3335).
  // Both lookups must answer -2 so a consumer declines replay; resolving
  // first-wins would hand one function another's body, which is the mistake
  // #2705 found in the cross-build tool.
  let c = codegen_body_cache_new()
  Array::push(c.fn_indices, value = 0)
  Array::push(c.fn_names, value = "solo")
  Array::push(c.fn_indices, value = 1)
  Array::push(c.fn_names, value = "twin")
  Array::push(c.fn_indices, value = 2)
  Array::push(c.fn_names, value = "twin")
  let (sorted, positions) = codegen_body_cache_name_index(c)
  inspect(codegen_body_cache_find_named(cache = c, name = "solo"), content = "0")
  inspect(codegen_body_cache_find_named_at(sorted = sorted, positions = positions, name = "solo"), content = "0")
  inspect(codegen_body_cache_find_named(cache = c, name = "twin"), content = "-2")
  inspect(codegen_body_cache_find_named_at(sorted = sorted, positions = positions, name = "twin"), content = "-2")
  inspect(codegen_body_cache_find_named(cache = c, name = "absent"), content = "-1")
  inspect(codegen_body_cache_find_named_at(sorted = sorted, positions = positions, name = "absent"), content = "-1")
}

test "unique_name_flags marks every member of a duplicated run, not just the extras" {
  // The CURRENT build's side of the ambiguity question. A name identifies a
  // function only while it is unique here, whatever the cache holds: the
  // prefix filter can drop one of a same-named pair and keep the other, at
  // which point the cached name looks unique and the build still has two.
  //
  // Both members of a run must be flagged, not only the second -- flagging
  // one would let the other be looked up by a name that does not identify it.
  let flags = unique_name_flags([
    "solo",
    "twin",
    "other",
    "twin",
    "trip",
    "trip",
    "trip"
  ])
  inspect(Array::get(flags, at = 0), content = "1")
  inspect(Array::get(flags, at = 1), content = "0")
  inspect(Array::get(flags, at = 2), content = "1")
  inspect(Array::get(flags, at = 3), content = "0")
  inspect(Array::get(flags, at = 4), content = "0")
  inspect(Array::get(flags, at = 5), content = "0")
  inspect(Array::get(flags, at = 6), content = "0")
  // Degenerate inputs answer rather than trap.
  inspect(Array::length(unique_name_flags([])), content = "0")
  inspect(Array::get(unique_name_flags(["only"]), at = 0), content = "1")
}

test "the indexed body-cache lookup answers exactly what the scan answers" {
  // Out of order, with a gap at 3 and 7, so a table that merely counted up
  // would disagree.
  let c = cache_with_indices([5, 0, 9, 2, 6, 1, 8, 4])
  inspect(lookup_disagreements(c = c, key_count = 12), content = "")
  // Spot-checks, so a `lookup_disagreements` that silently compared nothing
  // would not pass this test: the slot is the POSITION in the cache.
  let idx = codegen_body_cache_slot_index(cache = c, key_count = 12)
  inspect(codegen_body_cache_find_at(slot_index = idx, fn_index = 5), content = "0")
  inspect(codegen_body_cache_find_at(slot_index = idx, fn_index = 4), content = "7")
  inspect(codegen_body_cache_find_at(slot_index = idx, fn_index = 3), content = "-1")
}

// The table is sized by the CALLER's key space, so an entry outside it is
// unreachable rather than dropped -- the scan cannot return it either without
// being asked with a key the caller never uses. Sizing the table from the
// cache instead would let one absurd index in a torn artifact turn a lookup
// into an allocation the scan never made.
test "the table covers the caller's key space and answers -1 beyond it" {
  let c = cache_with_indices([5, 0, 9, 2])
  let idx = codegen_body_cache_slot_index(cache = c, key_count = 6)
  inspect(Array::length(idx), content = "6")
  inspect(lookup_disagreements(c = c, key_count = 6), content = "")
  // 9 is in the cache and outside the key space: the table says -1, and the
  // body loop never asks (its keys are function indices below num_user_funcs).
  inspect(codegen_body_cache_find(cache = c, fn_index = 9), content = "2")
  inspect(codegen_body_cache_find_at(slot_index = idx, fn_index = 9), content = "-1")
  // A cache whose only index is absurd costs one Int per KEY, not per index.
  let absurd = cache_with_indices([1099511627776])
  inspect(Array::length(codegen_body_cache_slot_index(cache = absurd, key_count = 4)), content = "4")
}

test "a duplicate function index resolves to the first entry, as the scan does" {
  // Two entries for function 4; the scan returns the first, so the table must
  // not let the later one overwrite it.
  let c = cache_with_indices([4, 1, 4, 0])
  inspect(lookup_disagreements(c = c, key_count = 8), content = "")
  let idx = codegen_body_cache_slot_index(cache = c, key_count = 8)
  inspect(codegen_body_cache_find_at(slot_index = idx, fn_index = 4), content = "0")
}

test "an empty cache answers -1 through both lookups" {
  let empty = codegen_body_cache_new()
  inspect(lookup_disagreements(c = empty, key_count = 5), content = "")
  inspect(codegen_body_cache_find_at(slot_index = codegen_body_cache_slot_index(cache = empty, key_count = 5), fn_index = 0), content = "-1")
}

// The one shape on which the two lookups CANNOT agree: a cache carrying a
// negative function index. The scan finds it (a plain equality test); a
// direct-address table has no slot for it. Measured -- this test read
// `-1:0/-1` before the decoder refused such a cache.
//
// A function index is a position in the program's function list, so a negative
// one is not a function and the entry is not a body any compile could replay.
// Refusing the whole cache is this artifact's established rule (#2388: a stale
// entry may cause a miss, never a wrong body), and it is what makes the
// equivalence above hold for every cache the system can load rather than for
// every cache someone might hand-build.
test "a persisted cache carrying a negative function index is refused" {
  let bad = cache_with_indices([0 - 1, 2])
  // The other arrays must be the right length or the decoder refuses for that
  // reason instead, which would prove nothing about the index check.
  let mut i = 0
  while i < 2 {
    Array::push(bad.fn_src_stmts, value = 0 - 1)
    Array::push(bad.fn_bodies, value = Bytes::from_array([]))
    Array::push(bad.fn_meta_i32, value = 0)
    Array::push(bad.fn_meta_i64, value = 0)
    Array::push(bad.fn_meta_v128, value = 0)
    Array::push(bad.fn_fold_sigs, value = "")
    i = i + 1
  }
  let refused = match codegen_body_cache_from_bytes(codegen_body_cache_to_bytes(bad)) {
    Some(_) => "accepted",
    None => "refused"
  }
  inspect(refused, content = "refused")
  // The control: the same cache with the index made non-negative decodes, so
  // the refusal above is the index check and not the round trip failing.
  let ok = cache_with_indices([1, 2])
  i = 0
  while i < 2 {
    Array::push(ok.fn_src_stmts, value = 0 - 1)
    Array::push(ok.fn_bodies, value = Bytes::from_array([]))
    Array::push(ok.fn_meta_i32, value = 0)
    Array::push(ok.fn_meta_i64, value = 0)
    Array::push(ok.fn_meta_v128, value = 0)
    Array::push(ok.fn_fold_sigs, value = "")
    i = i + 1
  }
  let accepted = match codegen_body_cache_from_bytes(codegen_body_cache_to_bytes(ok)) {
    Some(_) => "accepted",
    None => "refused"
  }
  inspect(accepted, content = "accepted")
}

test "#2669: index-keyed replay reuses everything while the assignment agrees" {
  // THE BASELINE step 2 has to improve, pinned before the work rather than
  // claimed after it. `body_cache_out` records exactly the functions a build
  // COMPILED -- `codegen_body_cache_record` runs only on the non-replay
  // branch -- so its length is the recompile count directly, with no
  // instrumentation and no proxy.
  let src = "let alpha: () -> Int = () -> { 1 }\nlet beta: () -> Int = () -> { alpha() + 1 }\nlet run: () -> Int = () -> { beta() + alpha() }"
  let out_a = codegen_body_cache_new()
  let cold = compile_wasi_module_rc_body_cached(stmts = parse_program(lex(src)), entry_name = "run", body_cache_in = codegen_body_cache_new(), body_cache_out = out_a)
  inspect(Array::length(out_a.fn_indices), content = "3")
  // Handed that harvest, the same program recompiles NOTHING and answers the
  // same bytes. Full reuse is available -- when the index assignment agrees.
  let out_b = codegen_body_cache_new()
  let warm = compile_wasi_module_rc_body_cached(stmts = parse_program(lex(src)), entry_name = "run", body_cache_in = out_a, body_cache_out = out_b)
  inspect(Array::length(out_b.fn_indices), content = "0")
  assert(bytes_eq(a = cold, b = warm))
}

test "#2669: a failed layout guard replays nothing, the prefix included" {
  // The half of step 2b that lives in the body loop. Widening WHICH entries
  // survive the file table is only safe while the index and address spaces a
  // body refers to are unchanged. When the layout guard says they moved, the
  // lane replays NOTHING -- not even the unchanged leading files. Their bodies
  // embed addresses in the program-wide string pool, which puts every plain
  // literal before the interpolation parts, map keys and runtime messages, so
  // a literal added anywhere moves addresses a prefix body holds. This used to
  // narrow to the prefix (`consumer_src_limit`), and that lane answered a
  // module 15 stale addresses wrong on the compiler's own CLI closure;
  // `body_cache_downstream_edit_test.vibe` pins that shape on the FS lane.
  //
  // The array comparison forces a derived comparator, which is what makes the
  // compile run the #2388 pin reorder and record guards at all.
  let src = "let seed_eq: () -> Bool = () -> { [1, 2] == [1, 2] }\nlet alpha: () -> Int = () -> { 1 }\nlet beta: () -> Int = () -> { alpha() + 1 }\nlet run: () -> Int = () -> { if seed_eq() { beta() + alpha() } else { 0 } }"
  let cold_out = codegen_body_cache_new()
  let cold = compile_wasi_module_rc_body_cached(stmts = parse_program(lex(src)), entry_name = "run", body_cache_in = codegen_body_cache_new(), body_cache_out = cold_out)
  let cold_n = Array::length(cold_out.fn_indices)
  assert(cold_n > 1)
  // Non-vacuity: the harvest must actually carry the guard this test poisons.
  assert(Array::length(cold_out.guard_layout) > 0)
  // GREEN: guards intact -- full reuse.
  let warm_out = codegen_body_cache_new()
  let warm = compile_wasi_module_rc_body_cached(stmts = parse_program(lex(src)), entry_name = "run", body_cache_in = cold_out, body_cache_out = warm_out)
  inspect(Array::length(warm_out.fn_indices), content = "0")
  assert(bytes_eq(a = cold, b = warm))
  // RED: poison the layout guard and annotate a prefix limit of 2 merged
  // statements, the shape the FS decoder hands a build whose later file
  // changed. The annotation no longer buys a replay: everything recompiles.
  //
  // ONE poison is enough because the comparison is over the whole vector at
  // once. What needs covering is that each pinned value REACHES the vector,
  // and that is an edit-shape question rather than a poison one:
  // `body_cache_edit_classes_test.vibe` moves each of them for real and
  // requires the compile to stay byte-exact.
  match codegen_body_cache_from_bytes(codegen_body_cache_to_bytes(cold_out)) {
    Some(narrowed_in) => {
      Array::set(narrowed_in.guard_layout, at = 1, value = Array::get(narrowed_in.guard_layout, at = 1) + 1)
      Array::push(narrowed_in.consumer_src_limit, value = 2)
      let narrowed_out = codegen_body_cache_new()
      let narrowed = compile_wasi_module_rc_body_cached(stmts = parse_program(lex(src)), entry_name = "run", body_cache_in = narrowed_in, body_cache_out = narrowed_out)
      inspect(Array::length(narrowed_out.fn_indices) == cold_n, content = "true")
      assert(bytes_eq(a = cold, b = narrowed))
    },
    None => assert(false)
  }
  // Control: the same poisoned guard with NO annotation is the in-process
  // lane's shape (`pin_region_capacity < 0` is not this one), and it declines
  // the same way. This is what says the block above was the guard talking.
  match codegen_body_cache_from_bytes(codegen_body_cache_to_bytes(cold_out)) {
    Some(unannotated) => {
      Array::set(unannotated.guard_layout, at = 1, value = Array::get(unannotated.guard_layout, at = 1) + 1)
      let unannotated_out = codegen_body_cache_new()
      let bytes = compile_wasi_module_rc_body_cached(stmts = parse_program(lex(src)), entry_name = "run", body_cache_in = unannotated, body_cache_out = unannotated_out)
      inspect(Array::length(unannotated_out.fn_indices) == cold_n, content = "true")
      assert(bytes_eq(a = cold, b = bytes))
    },
    None => assert(false)
  }
}

test "#2669: an edit to the FIRST file replays the files after it" {
  // The KPI claim, end to end on the FS lane and stated in the only terms it
  // is visible in: how many bodies the compile rebuilt.
  //
  // Three files in a chain, so merge order is a -> b -> main and an edit to
  // `a` is upstream of everything. Under the prefix rule that leaves NOTHING
  // replayable: the first file mismatched, so the unchanged leading run is
  // empty and the compile is a cold one.
  let a_path = "/tmp/vibe_body_cache_wide_a.vibe"
  let b_path = "/tmp/vibe_body_cache_wide_b.vibe"
  let main_path = "/tmp/vibe_body_cache_wide_main.vibe"
  // The array comparison in `a` forces a derived comparator, so the compile
  // runs the pin reorder and records the guards this lane needs.
  // Every file carries a string literal, so the pooled offsets a later body
  // embeds are real and the last block below has something to move.
  let a_source = "export let a_eq: () -> Bool = () -> { [1, 2] == [1, 2] }\nexport let a_one: () -> String = () -> { \"alpha one\" }\nexport let a_two: () -> String = () -> { \"alpha two\" }"
  let b_source = "import ./vibe_body_cache_wide_a.vibe { a_one, a_two }\nexport let b_one: () -> String = () -> { String::concat(a_one(), a_two()) }\nexport let b_two: () -> String = () -> { String::concat(b_one(), \"beta\") }"
  let main_source = "import ./vibe_body_cache_wide_b.vibe { b_one, b_two }\nlet run: () -> Int = () -> { String::length(String::concat(b_one(), b_two())) }"
  Fs::write_bytes(a_path, bytes = string_to_bytes(a_source))
  Fs::write_bytes(b_path, bytes = string_to_bytes(b_source))
  Fs::write_bytes(main_path, bytes = string_to_bytes(main_source))
  let artifact_path = persistent_artifact_cache_path(kind = "codegen-body-cache", entry_name = "run", fingerprint = String::concat("self-describing-", compact_string_fingerprint(main_path)))
  remove_file_if_exists(artifact_path)
  let cold_counts: Array[Int] = []
  let cold = compile_file_fs_mode_rc_body_cached_counted(entry_path = main_path, entry_name = "run", cache_mode = "on", counts_out = cold_counts)
  // Nothing offered on a cold run; everything rebuilt.
  inspect(Array::get(cold_counts, at = 0), content = "0")
  let cold_n = Array::get(cold_counts, at = 1)
  assert(cold_n > 3)
  // A comment-only edit to the FIRST file. Its fingerprint changes; its
  // statements, functions, closures and literals do not, so every layout
  // guard still holds for the files after it.
  Fs::write_bytes(a_path, bytes = string_to_bytes(String::concat(a_source, "\n// touched")))
  let warm_counts: Array[Int] = []
  let warm = compile_file_fs_mode_rc_body_cached_counted(entry_path = main_path, entry_name = "run", cache_mode = "on", counts_out = warm_counts)
  // Sharper than "fewer": everything the file table offered was REPLAYED, so
  // the compile rebuilt exactly the rest. Under the prefix rule the offer
  // itself is zero -- the first file mismatched -- which is what the mutation
  // test for this behaviour turns off.
  assert(Array::get(warm_counts, at = 0) > 0)
  inspect(Array::get(warm_counts, at = 1) + Array::get(warm_counts, at = 0) == cold_n, content = "true")
  // Reuse is not an excuse to answer differently.
  assert(bytes_eq(a = warm, b = compile_file_fs_mode_rc(entry_path = main_path, entry_name = "run")))
  // And the same edit under verify, which compiles twice and throws on the
  // first differing byte -- the replayed bodies are what the compiler itself
  // emits for this build, not merely bytes that link.
  Fs::write_bytes(a_path, bytes = string_to_bytes(String::concat(a_source, "\n// touched twice")))
  let verify_counts: Array[Int] = []
  let verified = compile_file_fs_mode_rc_body_cached_counted(entry_path = main_path, entry_name = "run", cache_mode = "verify", counts_out = verify_counts)
  assert(Array::get(verify_counts, at = 0) > 0)
  assert(Bytes::length(verified) > 0)
  // LENGTHENING an existing literal in `a` keeps the statement count, the
  // function vector and the lambda plan identical -- so the file table still
  // offers the later files -- while every pooled offset after it moves. That
  // used to be the guard's string-pool slot declining to a cold build; the
  // pool is relocated now (#2669), so the later files' bodies are REPLAYED
  // with their string references moved onto the new pool.
  //
  // The byte comparison is the load-bearing one. Measured before the pool was
  // pinned at all: `offered=3 recompiled=1022` and the module was NOT what a
  // fresh compile emits -- `b_two`'s cached body still pointed at where
  // "beta" used to sit. A count is a cost; this is correctness.
  //
  // Adding a DECLARATION instead would prove nothing about the pool: the file's
  // statement count changes and the table refuses the layout before any guard
  // is consulted. Measured, that variant reports `offered=0` either way.
  let a_moved = "export let a_eq: () -> Bool = () -> { [1, 2] == [1, 2] }\nexport let a_one: () -> String = () -> { \"alpha one is now a good deal longer\" }\nexport let a_two: () -> String = () -> { \"alpha two\" }"
  Fs::write_bytes(a_path, bytes = string_to_bytes(a_moved))
  let moved_counts: Array[Int] = []
  let moved = compile_file_fs_mode_rc_body_cached_counted(entry_path = main_path, entry_name = "run", cache_mode = "on", counts_out = moved_counts)
  // Offered by the file table, and replayed: fewer bodies rebuilt than cold.
  assert(Array::get(moved_counts, at = 0) > 0)
  inspect(Array::get(moved_counts, at = 1) < cold_n, content = "true")
  assert(bytes_eq(a = moved, b = compile_file_fs_mode_rc(entry_path = main_path, entry_name = "run")))
}

test "#2669: a layout-drifting edit recompiles fully, then the next build replays it all" {
  // Three files, and the edit lands on the MIDDLE one so there is an
  // unchanged prefix: `p_a` stays put, `p_b` swaps the order of its two
  // structs, `p_main` is downstream. A field access dispatches over the
  // structs holding the field in table order, so structs both builds hold
  // must keep their relative order, and this is a drift the body loop
  // declines on. A string literal, an added function, an added type and a
  // struct sharing a field used to be the example; each is relocated or
  // tolerated now (#2669, #3771 -- `body_cache_insert_function_test.vibe`,
  // `body_cache_changed_struct_test.vibe`).
  //
  // This used to be the test for carrying a REPLAYED prefix back into the
  // artifact. A drifted layout no longer replays a prefix (its bodies embed
  // indices the edit moved), so there is no hole to carry: the build
  // recompiles every body and its harvest is the whole program, which the
  // next unchanged build replays in full.
  let a_path = "/tmp/vibe_body_cache_pfx_a.vibe"
  let b_path = "/tmp/vibe_body_cache_pfx_b.vibe"
  let main_path = "/tmp/vibe_body_cache_pfx_main.vibe"
  let a_source = "export struct PaPt { v: Int }\nexport let p_eq: () -> Bool = () -> { [1, 2] == [1, 2] }\nexport let p_one: () -> String = () -> { \"one\" }\nexport let p_two: () -> Int = () -> { 22 + PaPt::{ v: 0 }.v }"
  let b_body = "export let p_b_one: () -> String = () -> { String::concat(p_one(), \"b\") }\nexport let p_b_two: () -> Int = () -> { String::length(p_b_one()) + p_two() + PbA::{ pa: 3 }.pa + PbB::{ pb: 4 }.pb }"
  let b_base = String::concat("import ./vibe_body_cache_pfx_a.vibe { p_one, p_two }\nstruct PbA { pa: Int }\nstruct PbB { pb: Int }\n", b_body)
  let b_longer = String::concat("import ./vibe_body_cache_pfx_a.vibe { p_one, p_two }\nstruct PbB { pb: Int }\nstruct PbA { pa: Int }\n", b_body)
  let main_source = "import ./vibe_body_cache_pfx_b.vibe { p_b_one, p_b_two }\nlet run: () -> Int = () -> { String::length(p_b_one()) + p_b_two() }"
  let artifact_path = persistent_artifact_cache_path(kind = "codegen-body-cache", entry_name = "run", fingerprint = String::concat("self-describing-", compact_string_fingerprint(main_path)))
  remove_file_if_exists(artifact_path)
  Fs::write_bytes(a_path, bytes = string_to_bytes(a_source))
  Fs::write_bytes(b_path, bytes = string_to_bytes(b_base))
  Fs::write_bytes(main_path, bytes = string_to_bytes(main_source))
  let cold_counts: Array[Int] = []
  let _cold = compile_file_fs_mode_rc_body_cached_counted(entry_path = main_path, entry_name = "run", cache_mode = "on", counts_out = cold_counts)
  let cold_n = Array::get(cold_counts, at = 1)
  Fs::write_bytes(b_path, bytes = string_to_bytes(b_longer))
  let edited_counts: Array[Int] = []
  let edited = compile_file_fs_mode_rc_body_cached_counted(entry_path = main_path, entry_name = "run", cache_mode = "on", counts_out = edited_counts)
  assert(bytes_eq(a = edited, b = compile_file_fs_mode_rc(entry_path = main_path, entry_name = "run")))
  // Non-vacuity: the file table DID offer the prefix's entries, so it is the
  // body loop that declined them, not the decoder.
  inspect(Array::get(edited_counts, at = 0) > 0, content = "true")
  // Everything recompiled.
  inspect(Array::get(edited_counts, at = 1) >= cold_n, content = "true")
  // Nothing changed since: the artifact is the edited build's whole harvest,
  // so the next build replays it all.
  let warm_counts: Array[Int] = []
  let warm = compile_file_fs_mode_rc_body_cached_counted(entry_path = main_path, entry_name = "run", cache_mode = "on", counts_out = warm_counts)
  assert(bytes_eq(a = warm, b = compile_file_fs_mode_rc(entry_path = main_path, entry_name = "run")))
  inspect(Array::get(warm_counts, at = 1) < cold_n, content = "true")
}

//# `codegen_body_cache_find` keys on the FUNCTION INDEX, so an entry is only
//# meaningful in a build that assigns that index to the same function. The FS
//# layer supplies exactly that: `decode_body_cache_payload_for` keeps the
//# unchanged files, and the body loop replays them only while the layout
//# guard says every index and address space is the harvest's.
//#
//# Measured (#2669, not asserted here because it describes a misuse rather
//# than a behaviour worth freezing): hand this entry point a harvest whose
//# assignment does NOT agree -- insert a function ahead of the others -- and
//# it replays 3 of 4 bodies into the wrong slots and answers a module that
//# differs from a fresh compile. Production cannot reach that, because the
//# prefix filter is upstream of it.
//#
//# That is what makes the prefix rule expensive: an edit early in merge order
//# invalidates everything after it, whether or not those bodies changed. Step
//# 2 removes the cost by removing the dependence -- key the lookup on function
//# IDENTITY and relocate the references -- at which point the precondition is
//# no longer needed and the filter can keep every unchanged file.

//# #2818: a build the constant-Bool fold rewrote

/// `fold_const_bool_params` rewrites a body whose Bool parameter is a literal
/// at every call site, so a folded body no longer matches its source text and
/// its bytes depend on call sites the file table cannot see. linked_compile
/// used to answer that by withholding every guard from any compile that
/// folded, and the fold runs whenever there is an entry point -- so no
/// `vibe build` / `run` / `test` ever replayed a body. Every published
/// measurement of this cache used `__no_entry__`, where the fold cannot fire.
///
/// Now each entry carries the fold signature it was compiled under, and only
/// an entry whose function the consuming compile folds differently is dropped.
///
/// Both single-file programs below synthesize a derived comparator, which is
/// what makes the compile run the #2388 pin reorder and record guards at all.
/// They differ only in whether a Bool parameter is foldable.
fn body_cache_reuse_counts(path: String, source: String) -> (Int, Int) with Env + Exception + Fs {
  Fs::write_bytes(path, bytes = string_to_bytes(source))
  let artifact_path = persistent_artifact_cache_path(kind = "codegen-body-cache", entry_name = "run", fingerprint = String::concat("self-describing-", compact_string_fingerprint(path)))
  remove_file_if_exists(artifact_path)
  let cold: Array[Int] = []
  let _ = compile_file_fs_mode_rc_body_cached_counted(entry_path = path, entry_name = "run", cache_mode = "on", counts_out = cold)
  let warm: Array[Int] = []
  let _ = compile_file_fs_mode_rc_body_cached_counted(entry_path = path, entry_name = "run", cache_mode = "on", counts_out = warm)
  (Array::get(warm, at = 0), Array::length(cold))
}

let unfolded_body_source: String = "let cmp: () -> Bool = () -> { [1, 2] == [1, 2] }\nlet run: () -> Int = () -> { if cmp() { 40 + 2 } else { 0 } }"

let folded_body_source: String = "let cmp: () -> Bool = () -> { [1, 2] == [1, 2] }\nfn gate(on: Bool) -> Int {\n  if on {\n    1\n  } else {\n    0\n  }\n}\nlet run: () -> Int = () -> { if cmp() { gate(on = true) + gate(on = true) } else { 0 } }"

test "#2818: a warm entry build replays its bodies when nothing was folded" {
  let (offered, _) = body_cache_reuse_counts(path = "/tmp/vibe_bc_2818_unfolded.vibe", source = unfolded_body_source)
  inspect(offered > 0, content = "true")
}

test "#2818: a folded entry build replays, and persists a harvest that can" {
  let path = "/tmp/vibe_bc_2818_folded.vibe"
  let (offered, _) = body_cache_reuse_counts(path = path, source = folded_body_source)
  inspect(offered > 0, content = "true")
  let artifact_path = persistent_artifact_cache_path(kind = "codegen-body-cache", entry_name = "run", fingerprint = String::concat("self-describing-", compact_string_fingerprint(path)))
  inspect(Fs::exists(artifact_path), content = "true")
  // And the compile itself is unchanged by any of this.
  assert(bytes_eq(a = compile_file_fs_mode_rc_body_cached(entry_path = path, entry_name = "run", cache_mode = "on"), b = compile_file_fs_mode_rc(entry_path = path, entry_name = "run")))
}

test "#2818: flipping a caller's literal in ANOTHER file recompiles the folded body" {
  // The dependence the file table cannot see. `gate`'s file never changes;
  // the only call to it is in the entry file, and editing that call from
  // `gate(true)` to `gate(false)` must change `gate`'s compiled body from the
  // `11` arm to the `22` arm. Nothing program-wide moves -- the same
  // functions survive DCE, the string pool and the lambda plan are
  // identical -- so every layout guard holds and the file table offers
  // `gate`'s cached `true` body. Only the fold signature (`0t` vs `0f`) can
  // refuse it; without it, the warm build below returns 11 where a fresh
  // compile returns 22.
  //
  // `gate` is an export, which keeps it external (unfoldable) unless the
  // build strips executable exports -- the CLI's own setting for `vibe run`
  // and `vibe build`, made explicit here.
  set_executable_exports_stripped(true)
  let gate_path = "/tmp/vibe_bc_2818_gate.vibe"
  let main_path = "/tmp/vibe_bc_2818_gate_main.vibe"
  let gate_source = "export let g_eq: () -> Bool = () -> { [1, 2] == [1, 2] }\nexport fn gate(on: Bool) -> Int {\n  if on {\n    11\n  } else {\n    22\n  }\n}\nexport let g_other: () -> Int = () -> { 5 }"
  let main_true = "import ./vibe_bc_2818_gate.vibe { g_eq, g_other, gate }\nlet run: () -> Int = () -> { if g_eq() { gate(on = true) + g_other() } else { 0 } }"
  let main_false = "import ./vibe_bc_2818_gate.vibe { g_eq, g_other, gate }\nlet run: () -> Int = () -> { if g_eq() { gate(on = false) + g_other() } else { 0 } }"
  Fs::write_bytes(gate_path, bytes = string_to_bytes(gate_source))
  Fs::write_bytes(main_path, bytes = string_to_bytes(main_true))
  let artifact_path = persistent_artifact_cache_path(kind = "codegen-body-cache", entry_name = "run", fingerprint = String::concat("self-describing-", compact_string_fingerprint(main_path)))
  remove_file_if_exists(artifact_path)
  let cold: Array[Int] = []
  let _ = compile_file_fs_mode_rc_body_cached_counted(entry_path = main_path, entry_name = "run", cache_mode = "on", counts_out = cold)
  let cold_n = Array::get(cold, at = 1)
  // Unchanged: the folded `gate` replays like everything else.
  let warm: Array[Int] = []
  let warm_bytes = compile_file_fs_mode_rc_body_cached_counted(entry_path = main_path, entry_name = "run", cache_mode = "on", counts_out = warm)
  assert(Array::get(warm, at = 0) > 0)
  assert(Array::get(warm, at = 1) < cold_n)
  assert(bytes_eq(a = warm_bytes, b = compile_file_fs_mode_rc(entry_path = main_path, entry_name = "run")))
  // The flip. The gate file is still offered -- it did not change -- and the
  // answer must still be a fresh compile's, byte for byte.
  Fs::write_bytes(main_path, bytes = string_to_bytes(main_false))
  let flipped: Array[Int] = []
  let flipped_bytes = compile_file_fs_mode_rc_body_cached_counted(entry_path = main_path, entry_name = "run", cache_mode = "on", counts_out = flipped)
  assert(Array::get(flipped, at = 0) > 0)
  assert(bytes_eq(a = flipped_bytes, b = compile_file_fs_mode_rc(entry_path = main_path, entry_name = "run")))
  // The artifact that build refreshed holds `gate` under its NEW signature
  // only: flipping back must not find the `false` body under `0t`, nor the
  // stale `true` body carried over by the merge under `0f`.
  Fs::write_bytes(main_path, bytes = string_to_bytes(main_true))
  let back: Array[Int] = []
  let back_bytes = compile_file_fs_mode_rc_body_cached_counted(entry_path = main_path, entry_name = "run", cache_mode = "on", counts_out = back)
  assert(bytes_eq(a = back_bytes, b = compile_file_fs_mode_rc(entry_path = main_path, entry_name = "run")))
  // And verify, which compiles twice and throws on the first differing byte,
  // agrees across another flip.
  Fs::write_bytes(main_path, bytes = string_to_bytes(main_false))
  let verify: Array[Int] = []
  let verified = compile_file_fs_mode_rc_body_cached_counted(entry_path = main_path, entry_name = "run", cache_mode = "verify", counts_out = verify)
  assert(bytes_eq(a = verified, b = compile_file_fs_mode_rc(entry_path = main_path, entry_name = "run")))
  set_executable_exports_stripped(false)
}
