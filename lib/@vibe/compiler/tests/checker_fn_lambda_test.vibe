//# Imports

import @vibe/compiler/core {
  Expr, Pat, Stmt, Type, TypeEnv, TypeExpr, env_bind, types_equal
}

import ./checker_test_support.vibe {
  check, no_tb, no_tp
}

//# Misc

test "fn typed param binds in body" {
  let expr = EFn(no_tp, no_tb, [("x", Some(TyName("Int")))], None, None, EIdent("x", -1))
  let ty = check(expr, EnvEmpty)
  match ty {
    CtFn(_, ret, he) => {
      assert(types_equal(ret, CtInt))
      match he {
        Some(_) => assert(false),
        None => assert(true)
      }
    },
    _ => assert(false)
  }
}

test "fn untyped param with usage" {
  let body = EBinOp("+", EIdent("x", -1), EInt(1))
  let expr = EFn(no_tp, no_tb, [("x", None)], None, None, body)
  let ty = check(expr, EnvEmpty)
  match ty {
    CtFn(_, ret, _) => assert(types_equal(ret, CtInt)),
    _ => assert(false)
  }
}

test "fn multiple params typed" {
  let body = EBinOp("+", EIdent("x", -1), EInt(1))
  let expr = EFn(no_tp, no_tb, [
    ("x", Some(TyName("Int"))),
    ("y", Some(TyName("String")))
  ], None, None, body)
  let ty = check(expr, EnvEmpty)
  match ty {
    CtFn(params, ret, _) => {
      assert(types_equal(ret, CtInt))
      assert(eq(Array::length(params), 2))
      assert(types_equal(Array::get(params, 0), CtInt))
      assert(types_equal(Array::get(params, 1), CtString))
    },
    _ => assert(false)
  }
}

test "fn with effect flag" {
  let expr = EFn(no_tp, no_tb, [("x", None)], None, Some("Error"), EInt(1))
  let ty = check(expr, EnvEmpty)
  match ty {
    CtFn(_, ret, he) => {
      assert(types_equal(ret, CtInt))
      match he {
        Some(name) => assert(name == "Error"),
        None => assert(false)
      }
    },
    _ => assert(false)
  }
}

test "fn without effect flag" {
  let expr = EFn(no_tp, no_tb, [("x", None)], None, None, EInt(1))
  let ty = check(expr, EnvEmpty)
  match ty {
    CtFn(_, ret, he) => {
      assert(types_equal(ret, CtInt))
      match he {
        Some(_) => assert(false),
        None => assert(true)
      }
    },
    _ => assert(false)
  }
}

test "fn unary minus defaults untyped param to int" {
  let expr = EFn(no_tp, no_tb, [("x", None)], None, None, EUnaryOp("-", EIdent("x", -1)))
  let ty = check(expr, EnvEmpty)
  match ty {
    CtFn(params, ret, _) => {
      assert(eq(Array::length(params), 1))
      assert(types_equal(Array::get(params, 0), CtInt))
      assert(types_equal(ret, CtInt))
    },
    _ => assert(false)
  }
}

test "fn unary minus keeps annotated double param" {
  let expr = EFn(no_tp, no_tb, [("x", Some(TyName("Double")))], None, None, EUnaryOp("-", EIdent("x", -1)))
  let ty = check(expr, EnvEmpty)
  match ty {
    CtFn(params, ret, _) => {
      assert(eq(Array::length(params), 1))
      assert(types_equal(Array::get(params, 0), CtDouble))
      assert(types_equal(ret, CtDouble))
    },
    _ => assert(false)
  }
}
