// The canonical plan must distinguish builtin values from resolved user
// names, and allocate lambda ranges across both function and thunk bodies.
import @vibe/compiler/codegen/wasi {
  lc_prepare_function_plan
}
import @vibe/compiler/codegen/common_base {
  get_slet_type, is_efn
}
import @vibe/compiler/syntax {
  lex, parse_program
}

test "function plan: builtin rows outside the user prefix reserve a value slot" {
  let stmts = parse_program(lex("fn f() -> String { let sub = String::substring; sub(\"abc\", 0, 1) }"))
  for rc in [false, true] {
    let plan = lc_prepare_function_plan(stmts, [0], ["f", "String::substring"], 1, [
    ], [], rc)
    assert_eq(plan.lambda_count, 1)
    assert_eq(Array::get(plan.lambda_bases, 0), 0)
  }
}

test "function plan: a user function shadows the builtin value slot" {
  let stmts = parse_program(lex("fn f() -> String { let sub = String::substring; sub(\"abc\", 0, 1) }"))
  for rc in [false, true] {
    let plan = lc_prepare_function_plan(stmts, [0], ["String::substring"], 1, [], [
    ], rc)
    assert_eq(plan.lambda_count, 0)
  }
}

test "function plan: bind function parameters before counting builtin values" {
  let stmts = parse_program(lex("fn f(eq: (Int, Int) -> Bool) -> Bool { let g = eq; g(1, 2) }"))
  for rc in [false, true] {
    let plan = lc_prepare_function_plan(stmts, [0], ["f"], 1, [], [], rc)
    assert_eq(plan.lambda_count, 0)
  }
}

test "function plan: constants and constructors shadow bare builtin values" {
  let stmts = parse_program(lex("fn f() -> Int { let g = eq; g }"))
  for rc in [false, true] {
    let constant = lc_prepare_function_plan(stmts, [0], ["f"], 1, ["eq"], [], rc)
    let ctor = lc_prepare_function_plan(stmts, [0], ["f"], 1, [], ["eq"], rc)
    assert_eq(constant.lambda_count, 0)
    assert_eq(ctor.lambda_count, 0)
  }
}

test "function plan: nested lambdas and a typed thunk share canonical ranges" {
  let stmts = parse_program(lex("fn f(n: Int) -> (Int) -> Int { (x) -> { let g = (y) -> y - n; g(x) } }\nlet table: Array[(Int) -> Int] = [(v) -> v - 3]\nfn main() -> Int { 0 }"))
  for rc in [false, true] {
    let plan = lc_prepare_function_plan(stmts, [0, 1, 2], ["f", "table", "main"], 3, [
    ], [], rc)
    assert_eq(plan.lambda_count, 3)
    assert_eq(Array::get(plan.lambda_bases, 0), 0)
    assert_eq(Array::get(plan.lambda_bases, 1), 2)
    assert_eq(Array::get(plan.lambda_bases, 2), 3)
    assert(!is_efn(Array::get(plan.bodies, 1)))
    assert(Array::get(plan.source_types, 1) == get_slet_type(Array::get(stmts, 1)))
  }
}
