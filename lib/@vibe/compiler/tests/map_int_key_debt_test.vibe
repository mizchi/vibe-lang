// #1967: pin that the old MapBuilder::set Int-key call still rejects.
// Value claims live in fixtures/map_int_key_test.vibe via set_by / get_by / has_by.

//# Imports

import ./checker_parity_test_support.vibe {
  check_source_err_contains, check_source_error_message
}

//# Misc

test "stale MapBuilder::set Int key is rejected" {
  let source = "fn main() -> Unit {\n  let b = MapBuilder::new()\n  MapBuilder::set(b, 1, 100)\n}"
  inspect(check_source_error_message(source), "argument type mismatch for MapBuilder::set (arg 1): Int")
  assert(check_source_err_contains(source, "argument type mismatch for MapBuilder::set (arg 1): Int"))
}
