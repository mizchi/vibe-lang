// #1967 pinned that `MapBuilder::set` refused an `Int` key. #2334 lifted that:
// the builder takes the builtin map's scalar keys. A key the map has no
// implementation for is still refused, at the whole-program check
// (fixtures/typecheck/err_mapbuilder_inferred_double_key.vibe).

//# Imports

import ./checker_parity_test_support.vibe {
  check_source_error_message
}

//# Misc

test "MapBuilder::set takes an Int key" {
  let source = "fn main() -> Unit {\n  let b = MapBuilder::new()\n  MapBuilder::set(b, 1, 100)\n}"
  inspect(check_source_error_message(source), content = "")
}
