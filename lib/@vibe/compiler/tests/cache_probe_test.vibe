//# Imports

import ../cache_probe_support.vibe {
  selfbuild_probe_incremental_typecheck_telemetry, selfbuild_probe_type_db_cache_counts, selfbuild_probe_type_db_codegen_counts, selfbuild_probe_type_db_fs_multi_dep_parse_counts, selfbuild_probe_type_db_fs_parse_counts, selfbuild_probe_type_db_group_merge_counts, selfbuild_probe_type_db_merge_counts, selfbuild_probe_type_db_module_source_counts, selfbuild_probe_type_db_parse_counts
}

import @vibe/compiler/entry/cli_cache {
  selfbuild_probe_cli_prepare_batch_parse_counts
}

//# Misc

test "cache probe: TypeDb reuses warm typecheck state" {
  let encoded = selfbuild_probe_type_db_cache_counts()
  let count1 = encoded / 1000
  let count2 = encoded % 1000
  assert(count1 > 0)
  assert(eq(count2, count1))
}

test "cache probe: TypeDb reuses warm parse state" {
  let encoded = selfbuild_probe_type_db_parse_counts()
  let count1 = encoded / 1000
  let count2 = encoded % 1000
  assert(count1 > 0)
  assert(eq(count2, count1))
}

test "cache probe: TypeDb fs parse state reuses persistent env cache" {
  let encoded = selfbuild_probe_type_db_fs_parse_counts()
  let count1 = encoded / 1000
  let count2 = encoded % 1000
  assert(eq(count1, 4))
  assert(eq(count2, 0))
}

test "cache probe: TypeDb fs multi-dep parse state reuses persistent dep cache" {
  let encoded = selfbuild_probe_type_db_fs_multi_dep_parse_counts()
  let count1 = encoded / 1000
  let count2 = encoded % 1000
  assert(eq(count1, 6))
  assert(eq(count2, 0))
}

test "cache probe: fs TypeDb telemetry distinguishes cold and warm work" {
  let expected_cold = "{\"schema\":1,\"modules_planned\":2,\"modules_rechecked\":2,\"modules_reused\":0,\"parse_operations\":4,\"modules_failed_or_blocked\":0}"
  let expected_warm = "{\"schema\":1,\"modules_planned\":2,\"modules_rechecked\":0,\"modules_reused\":2,\"parse_operations\":0,\"modules_failed_or_blocked\":0}"
  assert(selfbuild_probe_incremental_typecheck_telemetry() == String::concat(expected_cold, String::concat("\n", expected_warm)))
}

test "cache probe: CLI prepare batch shares TypeDb across sibling entries" {
  let encoded = selfbuild_probe_cli_prepare_batch_parse_counts()
  let fresh_total = encoded / 1000
  let shared_total = encoded % 1000
  assert(fresh_total > 0)
  assert(shared_total > 0)
  assert(shared_total < fresh_total)
}

