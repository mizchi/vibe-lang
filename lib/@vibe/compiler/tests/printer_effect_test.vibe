//# Imports

import @vibe/compiler/core {
  Expr, Pat
}

import @vibe/compiler/syntax {
  print_expr
}

import ./printer_test_support.vibe {
  roundtrip
}

//# Misc

test "roundtrip throw" {
  let ok = handle {
    roundtrip("throw(\"error\")")
  } with Exception {
    Throw(_) => false
  }
  assert(ok)
}

test "roundtrip if without else" {
  let ok = handle {
    roundtrip("if true { 1 }")
  } with Exception {
    Throw(_) => false
  }
  assert(ok)
}

test "roundtrip handle expression" {
  let ok = handle {
    roundtrip("handle { throw(\"oops\") } with Exception { Throw(msg) => msg }")
  } with Exception {
    Throw(_) => false
  }
  assert(ok)
}

test "empty EHandle prints as its parseable equivalent body" {
  let no_arms: Array[(Pat, Expr)] = [
  ]
  let printed = print_expr(EHandle(EInt(42), no_arms))
  assert(printed == "42")
  let ok = handle {
    roundtrip(printed)
  } with Exception {
    Throw(_) => false
  }
  assert(ok)
}

test "roundtrip escaped string variants" {
  let ok = handle {
    roundtrip("\"a\\r\\\\\\\"\"")
  } with Exception {
    Throw(_) => false
  }
  assert(ok)
}
