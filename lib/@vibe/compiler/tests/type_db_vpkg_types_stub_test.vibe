//# Imports

import @vibe/compiler/checker {
  typing_semantics_seed
}

import ../type_db.vibe {
  db_check_env, db_new, db_set_source, db_typecheck_fs
}

import @vibe/compiler/cache {
  compact_string_fingerprint,
  persistent_dep_list_cache_path,
  persistent_leaf_fingerprint_cache_path,
  persistent_module_header_cache_path,
  persistent_type_env_cache_path,
  typing_module_fingerprint
}

import @vibe/compiler/core {
  env_lookup
}

import @vibe/compiler/loader {
  collect_source_groups_fs, ingest_source_text_fs
}

import @vibe/core {
  array_empty
}

//# Functions

fn string_to_bytes(_ s: String) -> Bytes {
  let out = Bytes::new()
  let len = String::length(s)
  let mut i = 0
  while i < len {
    Bytes::push(out, value = String::char_code_at(s, at = i))
    i = i + 1
  }
  out
}

fn remove_file_if_exists(_ path: String) -> Unit with Fs {
  if Fs::exists(path) {
    Fs::remove(path)
  } else {
    ()
  }
}

/// The typing walk's key for a module with these dependencies
/// (typing_module_fingerprint, the one spelling of the formula) under the
/// default typing-semantics seed.
fn build_test_fingerprint(source: String, dep_fps: Array[(String, String)]) -> String {
  typing_module_fingerprint(source_fingerprint = compact_string_fingerprint(source), dep_fps = dep_fps, typing_semantics_seed = typing_semantics_seed(checked_error_row = false))
}

fn remove_typecheck_fs_cache(path: String, source: String, fingerprint: String) -> Unit with Env + Fs {
  let source_fp = compact_string_fingerprint(source)
  remove_file_if_exists(persistent_dep_list_cache_path(path = path, source_fingerprint = source_fp))
  remove_file_if_exists(persistent_module_header_cache_path(path = path, source_fingerprint = source_fp))
  remove_file_if_exists(persistent_leaf_fingerprint_cache_path(path = path, source_fingerprint = source_fp))
  remove_file_if_exists(persistent_type_env_cache_path(fingerprint))
}

fn vpkg_types_stub_path_from_text(_ text: String) -> String {
  let marker = ".vibe/build/vpkg_types/"
  let idx = String::index_of(text, needle = marker)
  if idx < 0 {
    ""
  } else {
    // The extension is searched AFTER the marker: the marker itself begins
    // with `.vibe/` (the project-local build directory, #2675), and a search
    // from the marker's start would answer `.vibe` -- a directory.
    let after = text[idx + String::length(marker): String::length(text)]
    let end = String::index_of(after, needle = ".vibe")
    if end < 0 {
      ""
    } else {
      String::concat(marker, after[0: end + 5])
    }
  }
}

fn grouped_source_paths_joined(_ groups: Array[(String, Array[(String, String)])]) -> String {
  let out = array_empty()
  let mut gi = 0
  while gi < Array::length(groups) {
    let (_, sources) = Array::get(groups, at = gi)
    let mut si = 0
    while si < Array::length(sources) {
      let (path, _) = Array::get(sources, at = si)
      Array::push(out, value = path)
      si = si + 1
    }
    gi = gi + 1
  }
  String::join(out, sep = "\n")
}

fn write_probe_package(dir: String, extra_export: Bool) -> (String, String, String, String, String) with Fs {
  let pkg_dir = String::concat(dir, "/pkg")
  let vpkg_path = String::concat(pkg_dir, "/index.vpkg")
  let impl_path = String::concat(pkg_dir, "/impl.vibe")
  let main_path = String::concat(dir, "/main.vibe")
  let extra_decl = if extra_export {
    "\nfn probe_one_more_fn() -> Int\n"
  } else {
    ""
  }
  let extra_impl = if extra_export {
    "\nexport fn probe_one_more_fn() -> Int {\n  2\n}\n"
  } else {
    ""
  }
  let vpkg_src = String::concat("enum Hue {\n  Crimson;\n  Teal(Int)\n}\n\nfn paint() -> Int\n", extra_decl)
  let impl_src = String::concat("export fn paint() -> Int {\n  1\n}\n", extra_impl)
  let main_src = "import ./pkg { enum Hue, paint }\nexport let n = paint()\n"
  Fs::mkdir_p(pkg_dir)
  Fs::write_bytes(vpkg_path, bytes = string_to_bytes(vpkg_src))
  Fs::write_bytes(impl_path, bytes = string_to_bytes(impl_src))
  Fs::write_bytes(main_path, bytes = string_to_bytes(main_src))
  (vpkg_path, impl_path, main_path, vpkg_src, impl_src)
}

fn seed_package_without_types_stub(vpkg_path: String, impl_path: String, main_path: String) -> (String, String) with Env + Exception + Fs {
  let vpkg_ingested = ingest_source_text_fs(path = vpkg_path, raw = Fs::read_file(vpkg_path), checked_error_row = false)
  let impl_ingested = ingest_source_text_fs(path = impl_path, raw = Fs::read_file(impl_path), checked_error_row = false)
  let main_ingested = ingest_source_text_fs(path = main_path, raw = Fs::read_file(main_path), checked_error_row = false)
  let stub_path = vpkg_types_stub_path_from_text(vpkg_ingested)
  assert(stub_path != "")
  assert(Fs::exists(stub_path))
  remove_typecheck_fs_cache(path = vpkg_path, source = vpkg_ingested, fingerprint = build_test_fingerprint(source = vpkg_ingested, dep_fps = array_empty()))
  remove_typecheck_fs_cache(path = impl_path, source = impl_ingested, fingerprint = build_test_fingerprint(source = impl_ingested, dep_fps = array_empty()))
  remove_typecheck_fs_cache(path = main_path, source = main_ingested, fingerprint = build_test_fingerprint(source = main_ingested, dep_fps = array_empty()))
  remove_typecheck_fs_cache(path = stub_path, source = Fs::read_file(stub_path), fingerprint = build_test_fingerprint(source = Fs::read_file(stub_path), dep_fps = array_empty()))
  (vpkg_ingested, stub_path)
}

fn typecheck_seeded_without_stub(vpkg_path: String, vpkg_ingested: String, impl_path: String, main_path: String) -> String with Env + Fs {
  handle {
    let impl_ingested = ingest_source_text_fs(path = impl_path, raw = Fs::read_file(impl_path), checked_error_row = false)
    let main_ingested = ingest_source_text_fs(path = main_path, raw = Fs::read_file(main_path), checked_error_row = false)
    let db = db_set_source(db = db_set_source(db = db_set_source(db = db_new(checked_error_row = false), path = vpkg_path, source = vpkg_ingested), path = impl_path, source = impl_ingested), path = main_path, source = main_ingested)
    let checked = db_typecheck_fs(db = db, path = main_path)
    match db_check_env(db = checked, path = main_path) {
      Some(env) =>
      match env_lookup(env = env, name = "n") {
        Some(_) => "",
        None => "missing binding: n"
      },
      None => "missing checked environment"
    }
  } with { Exception::Throw(msg) => msg }
}

//# Tests

/// #1921: the coordinator plans a materialized vpkg types stub as a resolved
/// dep, but a source set that only contains the contract/impl/importer never
/// inserts that stub into the env cache. Adding any export to a sibling
/// package (common_base in the wild) is just the trigger that forces a cold
/// recheck through this hole.
test "db_typecheck_fs: types stub missing from the seeded set is still inserted (#1921)" {
  let dir = "_build/vibe_1921_typedb_stub_seed"
  let (vpkg_path, impl_path, main_path, _, _) = write_probe_package(dir = dir, extra_export = false)
  let (vpkg_ingested, stub_path) = seed_package_without_types_stub(vpkg_path = vpkg_path, impl_path = impl_path, main_path = main_path)
  let err = typecheck_seeded_without_stub(vpkg_path = vpkg_path, vpkg_ingested = vpkg_ingested, impl_path = impl_path, main_path = main_path)
  assert(!String::contains(err, needle = "type_db: missing resolved dependency environment"))
  assert(err == "")
  assert(String::starts_with(stub_path, prefix = ".vibe/build/vpkg_types/"))
}

test "db_typecheck_fs: adding an extra vpkg export still inserts the types stub (#1921)" {
  let dir = "_build/vibe_1921_typedb_stub_export"
  let (vpkg_path, impl_path, main_path, _, _) = write_probe_package(dir = dir, extra_export = false)
  let (vpkg_ingested, _) = seed_package_without_types_stub(vpkg_path = vpkg_path, impl_path = impl_path, main_path = main_path)
  assert(typecheck_seeded_without_stub(vpkg_path = vpkg_path, vpkg_ingested = vpkg_ingested, impl_path = impl_path, main_path = main_path) == "")
  let (vpkg_path2, impl_path2, main_path2, _, _) = write_probe_package(dir = dir, extra_export = true)
  let (vpkg_ingested2, stub_path2) = seed_package_without_types_stub(vpkg_path = vpkg_path2, impl_path = impl_path2, main_path = main_path2)
  let err = typecheck_seeded_without_stub(vpkg_path = vpkg_path2, vpkg_ingested = vpkg_ingested2, impl_path = impl_path2, main_path = main_path2)
  assert(!String::contains(err, needle = "type_db: missing resolved dependency environment"))
  assert(err == "")
  assert(Fs::exists(stub_path2))
}

/// compiler_sources_manifest.tsv is a fixed source set: it lists the
/// contract and its impls, never the generated `.vibe/build/vpkg_types/`
/// stub. That is the vibe-check hole for any compiler file whose closure
/// reaches `@vibe/compiler/core`.
test "collect_source_groups_fs: manifest collection injects the types stub (#1921)" {
  let dir = "_build/vibe_1921_typedb_stub_manifest"
  let (vpkg_path, impl_path, main_path, _, _) = write_probe_package(dir = dir, extra_export = true)
  let manifest_path = String::concat(dir, "/compiler_sources_manifest.tsv")
  Fs::write_bytes(manifest_path, bytes = string_to_bytes("# group\tpath\npkg\tpkg/index.vpkg\npkg\tpkg/impl.vibe\nentry\tmain.vibe\n"))
  let _ = ingest_source_text_fs(path = vpkg_path, raw = Fs::read_file(vpkg_path), checked_error_row = false)
  let groups = collect_source_groups_fs(main_path, checked_error_row = false)
  let paths = grouped_source_paths_joined(groups)
  assert(String::contains(paths, needle = vpkg_path))
  assert(String::contains(paths, needle = impl_path))
  assert(String::contains(paths, needle = main_path))
  assert(String::contains(paths, needle = ".vibe/build/vpkg_types/"))
  handle {
    let mut db = db_new(checked_error_row = false)
    let mut gi = 0
    while gi < Array::length(groups) {
      let (_, sources) = Array::get(groups, at = gi)
      let mut si = 0
      while si < Array::length(sources) {
        let (path, source) = Array::get(sources, at = si)
        db = db_set_source(db = db, path = path, source = source)
        si = si + 1
      }
      gi = gi + 1
    }
    let checked = db_typecheck_fs(db = db, path = main_path)
    match db_check_env(db = checked, path = main_path) {
      Some(_) => (),
      None => assert(false)
    }
  } with { Exception::Throw(msg) => {
    assert(!String::contains(msg, needle = "type_db: missing resolved dependency environment"))
    assert(false)
  } }
}
