//# Imports

import @vibe/compiler/core {
  Expr
}

import ../cst.vibe {
  CstChild, NodeKind
}

import ../lower.vibe {
  lower_expr
}

import @vibe/compiler/syntax {
  Token
}

//# Misc

test "lower ELet" {
  let node = CNode(NLetExpr, [
    CToken(TLet),
    CToken(TIdent("x")),
    CToken(TEq),
    CNode(NIntExpr, [CToken(TInt(42))]),
    CNode(NIdentExpr, [CToken(TIdent("x"))])
  ])
  match lower_expr(node) {
    ELet(name, _, _, _) => assert(name == "x"),
    _ => assert(false)
  }
}

test "lower ELetMut" {
  let node = CNode(NLetMutExpr, [
    CToken(TLet),
    CToken(TMut),
    CToken(TIdent("x")),
    CToken(TEq),
    CNode(NIntExpr, [CToken(TInt(0))]),
    CNode(NIdentExpr, [CToken(TIdent("x"))])
  ])
  match lower_expr(node) {
    ELetMut(name, _, _, _) => assert(name == "x"),
    _ => assert(false)
  }
}

test "lower ELetRec" {
  let node = CNode(NLetRecExpr, [
    CToken(TLet),
    CToken(TRec),
    CToken(TIdent("f")),
    CToken(TEq),
    CNode(NIdentExpr, [CToken(TIdent("f"))]),
    CNode(NIntExpr, [CToken(TInt(0))])
  ])
  match lower_expr(node) {
    ELetRec(name, _, _) => assert(name == "f"),
    _ => assert(false)
  }
}

test "lower EAssign" {
  let node = CNode(NAssignExpr, [
    CToken(TIdent("x")),
    CToken(TEq),
    CNode(NIntExpr, [CToken(TInt(10))]),
    CNode(NUnitExpr, [CToken(TLParen), CToken(TRParen)])
  ])
  match lower_expr(node) {
    EAssign(name, _, _) => assert(name == "x"),
    _ => assert(false)
  }
}

test "lower ESeq" {
  let node = CNode(NSeqExpr, [
    CNode(NIntExpr, [CToken(TInt(1))]),
    CToken(TSemicolon),
    CNode(NIntExpr, [CToken(TInt(2))])
  ])
  match lower_expr(node) {
    ESeq(_, _) => assert(true),
    _ => assert(false)
  }
}

test "lower EBinOp plus" {
  let node = CNode(NBinOpExpr, [
    CNode(NIntExpr, [CToken(TInt(1))]),
    CToken(TPlus),
    CNode(NIntExpr, [CToken(TInt(2))])
  ])
  match lower_expr(node) {
    EBinOp(op, _, _, _) => assert(op == "+"),
    _ => assert(false)
  }
}

test "lower EBinOp eq" {
  let node = CNode(NBinOpExpr, [
    CNode(NIntExpr, [CToken(TInt(1))]),
    CToken(TEqEq),
    CNode(NIntExpr, [CToken(TInt(2))])
  ])
  match lower_expr(node) {
    EBinOp(op, _, _, _) => assert(op == "=="),
    _ => assert(false)
  }
}

test "lower EUnaryOp neg" {
  let node = CNode(NUnaryOpExpr, [
    CToken(TMinus),
    CNode(NIntExpr, [CToken(TInt(1))])
  ])
  match lower_expr(node) {
    EUnaryOp(op, _) => assert(op == "-"),
    _ => assert(false)
  }
}

test "lower EUnaryOp not" {
  let node = CNode(NUnaryOpExpr, [
    CToken(TNot),
    CNode(NBoolExpr, [CToken(TIdent("true"))])
  ])
  match lower_expr(node) {
    EUnaryOp(op, _) => assert(op == "!"),
    _ => assert(false)
  }
}

test "#2344 lower EUnaryOp bit-not" {
  // The `~` arm of `find_unaryop_at`. Without it this lowered to the "?"
  // sentinel and reached codegen as an unsupported unary operator.
  let node = CNode(NUnaryOpExpr, [
    CToken(TTilde),
    CNode(NIntExpr, [CToken(TInt(5))])
  ])
  match lower_expr(node) {
    EUnaryOp(op, _) => assert(op == "~"),
    _ => assert(false)
  }
}

test "lower ECall" {
  let node = CNode(NCallExpr, [
    CNode(NIdentExpr, [CToken(TIdent("f"))]),
    CToken(TLParen),
    CNode(NIntExpr, [CToken(TInt(1))]),
    CToken(TRParen)
  ])
  match lower_expr(node) {
    ECall(callee, args, _) => {
      match callee {
        EIdent(n, _) => assert(n == "f"),
        _ => assert(false)
      }
      assert(Array::length(args) == 1)
    },
    _ => assert(false)
  }
}

test "lower EDot" {
  let node = CNode(NDotExpr, [
    CNode(NIdentExpr, [CToken(TIdent("obj"))]),
    CToken(TDot),
    CToken(TIdent("field"))
  ])
  match lower_expr(node) {
    EDot(_, name, _, _) => assert(name == "field"),
    _ => assert(false)
  }
}
