import @vibe/compiler/core {
  BindingOrigin, Type, TypeDef, TypeEnv, TypeExpr, env_cached, env_value_binding, env_value_binding_with_origin
}
import @vibe/compiler/runtime {
  persistent_module_cache_text, persistent_type_env_cache_text
}

fn every_variant() -> TypeEnv {
  let types = [
    CtInt,
    CtDouble,
    CtBool,
    CtString,
    CtChar,
    CtUnit,
    CtBytes,
    CtUnknown,
    CtVar(12),
    CtConstructor("F", 2),
    CtApplied(CtConstructor("F", 1), [CtInt]),
    CtEnum("E"),
    CtStruct("S"),
    CtArray(CtOption(CtInt)),
    CtTuple([CtInt, CtString]),
    CtFn([CtInt, CtString], CtUnit, None),
    CtFn([], CtBool, Some("Console")),
    CtNamed("Box", [CtBytes]),
    CtForAll([7, 12], [(7, ["Eq", "Show"])], CtFn([CtVar(7)], CtVar(12), None)),
    CtRecord([("x", CtInt), ("y", CtArray(CtString))])
  ]
  let defs = [
    TDEnum("E", ["T"], [("A", []), ("B", [CtVar(7), CtInt])]),
    TDStruct("S", [("x", CtInt), ("y", CtNamed("Box", [CtString]))], ["x"], [
      "T"
    ]),
    TDAlias("Alias", ["T"], CtArray(CtVar(7))),
    TDEffect("Fx", [("Do", [CtString], CtOption(CtInt))], ["T"]),
    TDEffectSet("Both", ["Console", "Fs"])
  ]
  let methods = [
    ("render", [
      TyName("Self"),
      TyApp("Box", [TyName("T")]),
      TyFn([TyName("T")], TyUnit, Some("Fx")),
      TyFn([], TyTuple([TyName("T"), TyUnit]), None)
    ], TyName("String"))
  ]
  let tail = EnvFlat([
    ("unavailable", env_value_binding(CtTuple(types))),
    ("direct", env_value_binding_with_origin(CtInt, BindingOriginModuleExport("/dep.vibe", "source"))),
    ("surface", env_value_binding_with_origin(CtString, BindingOriginReExportSurface("/facade.vibe", "shown")))
  ])
  EnvTypeDefs(defs, ["E", "Alias"], EnvTraitDef("Render", ["Show"], true, methods, EnvTraitImpl("Render", CtInt, EnvTraitImplGen("Render", [
    "T"
  ], [("T", ["Eq", "Show"])], CtNamed("Box", [CtVar(7)]), EnvMutCell("escaping", true, EnvMutCell("local", false, env_cached([
    "stale"
  ], [env_value_binding(CtUnknown)], tail))))), ["T"], [
    ("render", ["U"], [("U", ["Show"])])
  ]))
}

test "all recursive codec variants retain the canonical v9 wire bytes" {
  inspect(persistent_type_env_cache_text(every_variant()), "version\t9\nenv\t972:P5[34:E1:E1[1:T]2[1:A0[]1:B2[4:V1:71:I]]38:S1:S2[1:xI1:yN3:Box1[1:G]]1[1:x]1[1:T]19:A5:Alias1[1:T]AV1:726:K2:Fx1[1:T]1[2:Do1[1:G]OI]23:Z4:Both2[7:Console2:Fs]]2[1:E5:Alias]D6:Render1[4:Show]11[6:render4[7:n4:Self15:a3:Box1[4:n1:T]16:f12:Fx1[4:n1:T]u18:f00[]t2[4:n1:T1:u]]n6:String]I6:RenderIG6:Render1[1:T]1[1:T2[2:Eq4:Show]]N3:Box1[4:V1:7]M8:escaping1M5:local0C4[14:#active_region6:direct7:surface11:unavailable]4[1:U1:I1:G212:T20[1:I1:D1:B1:G1:H1:U1:Y1:X5:V2:127:J1:F1:216:P7:J1:F1:11[1:I]4:E1:E4:R1:S3:AOI10:T2[1:I1:G]13:F0:2[1:I1:G]U14:F7:Console0[]B12:N3:Box1[1:Y]47:Q2[1:72:12]1[1:72[2:Eq4:Show]]F0:1[4:V1:7]V2:1217:K2[1:x1:I1:y2:AG]]]L3[11:unavailableT20[1:I1:D1:B1:G1:H1:U1:Y1:X5:V2:127:J1:F1:216:P7:J1:F1:11[1:I]4:E1:E4:R1:S3:AOI10:T2[1:I1:G]13:F0:2[1:I1:G]U14:F7:Console0[]B12:N3:Box1[1:Y]47:Q2[1:72:12]1[1:72[2:Eq4:Show]]F0:1[4:V1:7]V2:1217:K2[1:x1:I1:y2:AG]]U6:directIM9:/dep.vibe6:source7:surfaceGR12:/facade.vibe5:shown]1[1:T]1[6:render1[1:U]1[1:U1[4:Show]]]\n")
}

fn deep_signature() -> TypeEnv {
  let buf = StringBuilder::new()
  let mut i = 0
  while i < 512 {
    StringBuilder::push(buf, "abcdefgh")
    i = i + 1
  }
  let mut ty = CtNamed(StringBuilder::freeze(buf), [CtInt])
  i = 0
  while i < 24 {
    ty = CtTuple([CtFn([ty], CtUnit, Some("Console"))])
    i = i + 1
  }
  EnvBind("deep", env_value_binding(ty), EnvEmpty)
}

test "deep signatures allocate one final payload plus bounded piece metadata" {
  let env = deep_signature()
  let start = Profiler::heap_bytes()
  let text = persistent_module_cache_text(env, None)
  let allocated = Profiler::heap_bytes() - start
  println("nested wire=\{String::length(text)} allocated=\{allocated}")
  inspect(allocated <= String::length(text) * 8, "true")
}
