//# Imports

import @vibe/compiler/checker {
  check_program
}

import @vibe/compiler/core {
  Type, env_lookup
}

import @vibe/compiler/syntax {
  lex, parse_program
}

//# Functions

fn first_check_error(source: String) -> String {
  handle {
    let _ = check_program(parse_program(lex(source)))
    ""
  } with { Exception::Throw(msg) => msg }
}

fn checks(src: String) -> Bool {
  handle {
    let _ = check_program(parse_program(lex(src)))
    true
  } with { Exception::Throw(_) => false }
}

test "identity F[A] as F[B] is rejected" {
  let src = "fn fake_map[F, A, B](x: F[A], f: (A) -> B) -> F[B] {\n  x\n}\nfn main { () }\n"
  let msg = first_check_error(src)
  assert(String::contains(msg, "return type mismatch"))
}

test "kinded identity F[A] as F[B] is rejected" {
  let src = "fn cast[F[_], A, B](x: F[A]) -> F[B] {\n  x\n}\nfn main { () }\n"
  let msg = first_check_error(src)
  assert(String::contains(msg, "return type mismatch"))
}

test "F[A] to F[A] identity is accepted" {
  let src = "fn keep[F, A](xs: F[A]) -> F[A] {\n  xs\n}\nfn main { () }\n"
  let msg = first_check_error(src)
  assert(msg == "")
}

test "ascribing F[A] to Array[Int] is rejected" {
  let src = "fn smash[F, A](xs: F[A]) -> Int {\n  let ys: Array[Int] = xs\n  1\n}\nfn main { () }\n"
  let msg = first_check_error(src)
  assert(String::contains(msg, "binding type mismatch for a local let"))
}

test "ascribing F[A] to Option[Int] is rejected" {
  let src = "fn smash[F, A](xs: F[A]) -> Int {\n  let ys: Option[Int] = xs\n  1\n}\nfn main { () }\n"
  let msg = first_check_error(src)
  assert(String::contains(msg, "binding type mismatch for a local let"))
}

test "returning F[A] as Array[Int] is rejected" {
  let src = "fn smash[F, A](xs: F[A]) -> Array[Int] {\n  xs\n}\nfn main { () }\n"
  let msg = first_check_error(src)
  assert(String::contains(msg, "return type mismatch"))
}

test "mixed-kind local let is rejected" {
  let src = "fn g[F](x: F) -> Int {\n  let y: F[Int] = x\n  1\n}\nfn main { () }\n"
  let msg = first_check_error(src)
  assert(String::contains(msg, "used both as a type and as a type constructor"))
}

test "local let F[A] ascription is accepted" {
  let src = "fn keep[F, A](xs: F[A]) -> F[A] {\n  let ys: F[A] = xs\n  ys\n}\nfn main { () }\n"
  let msg = first_check_error(src)
  assert(msg == "")
}

test "ascribing F[A] to Box[Int] is rejected" {
  let src = "struct Box[T] {\n  value: T\n}\nfn smash[F, A](xs: F[A]) -> Int {\n  let ys: Box[Int] = xs\n  1\n}\nfn main { () }\n"
  let msg = first_check_error(src)
  assert(String::contains(msg, "binding type mismatch for a local let"))
}

test "returning F[A] as Box[Int] is rejected" {
  let src = "struct Box[T] {\n  value: T\n}\nfn smash[F, A](xs: F[A]) -> Box[Int] {\n  xs\n}\nfn main { () }\n"
  let msg = first_check_error(src)
  assert(String::contains(msg, "return type mismatch"))
}

test "F[A] as F[Int] is rejected" {
  let src = "fn smash[F, A](xs: F[A]) -> F[Int] {\n  xs\n}\nfn main { () }\n"
  let msg = first_check_error(src)
  assert(String::contains(msg, "return type mismatch"))
}

test "F[A] vs F[A, B] is rejected" {
  let src = "fn smash[F, A, B](xs: F[A]) -> F[A, B] {\n  xs\n}\nfn main { () }\n"
  let msg = first_check_error(src)
  assert(String::contains(msg, "applied to 2 type arguments"))
}

test "mixed-kind across struct fields is rejected" {
  let src = "struct Holder[F] {\n  raw: F; inner: F[Int]\n}\nfn main { () }\n"
  let msg = first_check_error(src)
  assert(String::contains(msg, "used both as a type and as a type constructor"))
}

test "mixed-kind across a trait method is rejected" {
  let src = "trait Holder[F] {\n  wrap(F) -> F[Int]\n}\nfn main { () }\n"
  let msg = first_check_error(src)
  assert(String::contains(msg, "used both as a type and as a type constructor"))
}

test "mixed-kind across an effect operation is rejected" {
  let src = "effect Box[F] {\n  Put(F) -> F[Int]\n}\nfn main { () }\n"
  let msg = first_check_error(src)
  assert(String::contains(msg, "used both as a type and as a type constructor"))
}

test "arity-2 constructor formal is rejected" {
  let src = "fn bad[F, A, B](xs: F[A, B]) -> Int {\n  1\n}\nfn main { () }\n"
  let msg = first_check_error(src)
  assert(String::contains(msg, "applied to 2 type arguments"))
}

test "identity F[A] as F[B] inside a tuple is rejected" {
  let src = "fn fake[F, A, B](x: (F[A], Int)) -> (F[B], Int) {\n  x\n}\nfn main { () }\n"
  let msg = first_check_error(src)
  assert(String::contains(msg, "return type mismatch"))
}

test "identity Array[F[A]] as Array[F[B]] is rejected" {
  let src = "fn fake[F, A, B](x: Array[F[A]]) -> Array[F[B]] {\n  x\n}\nfn main { () }\n"
  let msg = first_check_error(src)
  assert(String::contains(msg, "return type mismatch"))
}

test "identity F[Array[A]] as F[Array[B]] is rejected" {
  let src = "fn fake[F, A, B](x: F[Array[A]]) -> F[Array[B]] {\n  x\n}\nfn main { () }\n"
  let msg = first_check_error(src)
  assert(String::contains(msg, "return type mismatch"))
}

test "mixed-kind across effect operations is rejected" {
  let src = "effect Box[F] {\n  Put(F) -> Unit\n  Get() -> F[Int]\n}\nfn main { () }\n"
  let msg = first_check_error(src)
  assert(String::contains(msg, "used both as a type and as a type constructor"))
}

test "mixed-kind across trait methods is rejected" {
  let src = "trait Box[F] {\n  put(F) -> Unit\n  get() -> F[Int]\n}\nfn main { () }\n"
  let msg = first_check_error(src)
  assert(String::contains(msg, "used both as a type and as a type constructor"))
}

test "mixed-kind across enum variants is rejected" {
  let src = "enum Box[F] {\n  Raw(F);\n  Inner(F[Int])\n}\nfn main { () }\n"
  let msg = first_check_error(src)
  assert(String::contains(msg, "used both as a type and as a type constructor"))
}

test "Self cannot be used as a type constructor" {
  let src = "trait Box {\n  take(Self[Int]) -> Int\n}\nfn main { () }\n"
  let msg = first_check_error(src)
  assert(String::contains(msg, "`Self` is a complete type"))
}

test "nested generic formals shadow outer kind markers" {
  let src = "fn outer[F, A](x: F[A]) -> Int {\n  let inner = [F](y: F) -> Int {\n    let z: F = y\n    0\n  }\n  inner(1)\n}\nfn main { () }\n"
  assert(checks(src))
}

test "an applied formal declared as a complete type is rejected, and named" {
  let src = "trait Functor[F] {\n  fmap[A, B](Self, F[A], (A) -> B) -> F[B]\n}\nfn main { () }\n"
  let msg = first_check_error(src)
  // Names the parameter and the edit, not an issue number: no impl can supply
  // a constructor for a complete-type parameter, so the declaration is wrong.
  assert(String::contains(msg, "constructor parameter `F` is applied"))
  assert(String::contains(msg, "declare it as a type constructor"))
  assert(String::contains(msg, "`F[_]`"))
}

test "alias-expanded HKT indices stay rigid" {
  let src = "type Apply[F, A] = F[A]\nfn bad[F, A, B](x: Apply[F, A]) -> Apply[F, B] {\n  x\n}\nfn main { () }\n"
  let msg = first_check_error(src)
  assert(String::contains(msg, "return type mismatch"))
}

/// The same program with the parameter declared KINDED. Alias expansion puts
/// the head in a `CtApplied`, not the `CtNamed` the unkinded spelling above
/// produces, and the traversals fell past it into `_ => ()` -- so nothing was
/// marked rigid and this compiled, returning an `F[A]` where `F[B]` is
/// declared. The unkinded case passing is exactly what hid it, so the two are
/// pinned together (Codex review).
test "alias-expanded KINDED HKT indices stay rigid too" {
  let src = "type Apply[F[_], A] = F[A]\nfn bad[F[_], A, B](x: Apply[F, A]) -> Apply[F, B] {\n  x\n}\nfn main { () }\n"
  assert(!checks(src))
  assert(String::contains(first_check_error(src), "return type mismatch"))
}

/// A method generic shadowing a same-named trait parameter is a DIFFERENT
/// binder, with its own kind. Reading the applied `A` as the header's
/// complete-type `A` rejected this and told the author to spell it `A[_]`,
/// which is what the declaration already says (Codex review).
test "a method generic shadows a same-named trait parameter" {
  assert(checks("trait Scoped[A] {\n  project[A[_], B](A[B]) -> A[B]\n}\nfn main { () }\n"))
  // The control: with no method generic to shadow it, the header `A` is a
  // complete type and applying it is still reported.
  let unshadowed = first_check_error("trait Scoped[A] {\n  project[B](A[B]) -> A[B]\n}\nfn main { () }\n")
  assert(String::contains(unshadowed, "constructor parameter `A` is applied"))
}

/// A bare parameterized alias in a higher-kinded slot is encoded as
/// `CtApplied(CtNamed("#alias_ctor", []), [body, <binder>...])`, and those
/// binders belong to the ALIAS declaration. Walking them marked an unrelated
/// formal of the same name rigid: the only difference between these two
/// programs is whether the alias spells its own binder `A` (Codex review).
test "an alias constructor's own binders are not this signature's formals" {
  let collide = "type Pair[A, B] = (A, B)\nstruct Holder[H[_, _]] {\n  value: Int\n}\nfn coerce[G[_], A](x: G[Holder[Pair]], y: A) -> Int {\n  let z: Int = y\n  z\n}\nfn main { () }\n"
  let renamed = "type Pair[P, Q] = (P, Q)\nstruct Holder[H[_, _]] {\n  value: Int\n}\nfn coerce[G[_], A](x: G[Holder[Pair]], y: A) -> Int {\n  let z: Int = y\n  z\n}\nfn main { () }\n"
  assert(checks(renamed))
  assert(checks(collide))
}

/// A header parameter's kind is aggregated across the whole trait, so it has to
/// be aggregated over the methods that MENTION it. Pooling a method generic of
/// the same name -- a different binder, with its own kind -- reported a valid
/// declaration as mixed-kind (Codex review).
test "a shadowing method generic is not pooled into the trait-wide kind" {
  assert(checks("trait Scoped[A] {\n  raw(A) -> A;\n  project[A[_], B](A[B]) -> A[B]\n}\nfn main { () }\n"))
  // The control: with nothing shadowing `A`, the genuine mixed-kind use of the
  // one header binder is still reported.
  let mixed = first_check_error("trait Mixed[A] {\n  raw(A) -> A;\n  project[B](A[B]) -> A[B]\n}\nfn main { () }\n")
  assert(String::contains(mixed, "used both as a type and as a type constructor"))
}

/// Two SOURCE row binders unified by the body must stay unified in the
/// published scheme. Restoring each one's original spelling made them
/// independent again, so a caller could bind the callback to one concrete
/// effect and the function it returns to another -- the callback's authority,
/// misreported, with no diagnostic (Codex review).
test "a source-to-source effect unification survives generalization" {
  let src = "fn cast[T, e, f](g: (T) -> T with e) -> (T) -> T with f {\n  g\n}\nfn main { () }\n"
  let env = check_program(parse_program(lex(src)))
  match env_lookup(env, "cast") {
    Some(CtForAll(_, _, CtFn(params, CtFn(_, _, Some(ret_effect)), _))) => match Array::get(params, 0) {
      CtFn(_, _, Some(param_effect)) => assert(param_effect == ret_effect),
      _ => assert(false)
    },
    _ => assert(false)
  }
}

test "generic scheme applies a closed effect constraint" {
  let src = "effect Log { Emit() -> Unit }\nfn narrow[T, e](f: (T) -> T with e) -> (T) -> T with Log {\n  f\n}\nfn main { () }\n"
  let env = check_program(parse_program(lex(src)))
  match env_lookup(env, "narrow") {
    Some(CtForAll(_, _, CtFn(params, CtFn(_, _, Some(ret_effect)), _))) => match Array::get(params, 0) {
      CtFn(_, _, Some(param_effect)) => {
        assert(String::contains(param_effect, "Log"))
        assert(String::contains(ret_effect, "Log"))
      },
      _ => assert(false)
    },
    _ => assert(false)
  }
}

test "ascribing T to Box[Int] does not publish forall T" {
  let src = "struct Box[T] {\n  value: T\n}\nfn f[T](x: T) -> T {\n  let y: Box[Int] = x\n  x\n}\nfn g() -> Unit {\n  let _ = f(1)\n}\n"
  let msg = first_check_error(src)
  assert(String::contains(msg, "argument type mismatch"))
}
