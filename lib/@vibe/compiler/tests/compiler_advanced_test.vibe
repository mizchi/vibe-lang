//# Imports

import @vibe/compiler/entry/source_compile {
  compile_source
}

//# Functions

fn assert_wasm_magic(bytes: Bytes) -> Unit {
  assert(Bytes::get(bytes, 0) == 0)
  assert(Bytes::get(bytes, 1) == 97)
  assert(Bytes::get(bytes, 2) == 115)
  assert(Bytes::get(bytes, 3) == 109)
}

//# Misc

test "compile_source: enum definition produces valid WASM" {
  let bytes = compile_source("enum Color { Red; Green; Blue }\nlet c = Red")
  assert_wasm_magic(bytes)
}

test "compile_source: while loop produces valid WASM" {
  let bytes = compile_source("let f: () -> Int = () -> { let mut i = 0\nwhile i < 10 { i = i + 1 }\ni }")
  assert_wasm_magic(bytes)
}

test "compile_source: nested tuple destructuring across recursive calls" {
  let source = "let rec f: (Int, Int, Int, Int, Int) -> (Int, Int, Int) = (expr, env, defs, s, c) -> {\n  let cond = expr\n  let then_e = env\n  let else_e = defs\n  let (_, s1, c1) = f(cond, env, defs, s, c)\n  let (tt, s2, c2) = f(then_e, env, defs, s1, c1)\n  let (_, s3, c3) = f(else_e, env, defs, s2, c2)\n  (tt, s3, c3)\n}"
  let bytes = compile_source(source)
  assert_wasm_magic(bytes)
}
