import @vibe/compiler/core {
  Expr, Pat, TypeEnv, TypeExpr
}
import @vibe/compiler/checker/effects {
  afe_bind_params, afe_bind_value, afe_binds_local, afe_expr_head_name, afe_mask_pat_binders, afe_match_arm_locals, afe_no_locals
}

test "payload shadowing keeps the outer branch and hides old annotations" {
  let outer = afe_bind_params(locals = afe_no_locals(), params = [
    ("it", Some(TyApp("Option", [TyName("Outer")])))
  ], env = EnvEmpty)
  let pattern = PCtor("Some", [PBind("child")])
  let original = afe_match_arm_locals(scrut = EIdent("it", -1), pat = pattern, env = EnvEmpty, locals = outer)
  assert(afe_expr_head_name(e = EIdent("child", -1), env = EnvEmpty, locals = original) == Some("Outer"))
  let masked = afe_mask_pat_binders(locals = outer, pat = PBind("it"))
  assert(afe_binds_local(locals = masked, name = "it"))
  let inner = afe_match_arm_locals(scrut = EIdent("it", -1), pat = pattern, env = EnvEmpty, locals = masked)
  assert(afe_expr_head_name(e = EIdent("child", -1), env = EnvEmpty, locals = inner) == None)
  let other = afe_mask_pat_binders(locals = outer, pat = PBind("it_more"))
  let preserved = afe_match_arm_locals(scrut = EIdent("it", -1), pat = pattern, env = EnvEmpty, locals = other)
  assert(afe_expr_head_name(e = EIdent("child", -1), env = EnvEmpty, locals = preserved) == Some("Outer"))
  let masked_again = afe_mask_pat_binders(locals = masked, pat = PBind("it"))
  let still_hidden = afe_match_arm_locals(scrut = EIdent("it", -1), pat = pattern, env = EnvEmpty, locals = masked_again)
  assert(afe_expr_head_name(e = EIdent("child", -1), env = EnvEmpty, locals = still_hidden) == None)
}

test "rebinding removes tuple array and callback-return metadata only for that name" {
  let value = ERecord("Outer", [], [])
  let tuple = afe_bind_value(locals = afe_no_locals(), name = "it", val = ETuple([
    value
  ]), env = EnvEmpty)
  let field = EDot(EIdent("it", -1), "0", -1, -1)
  assert(afe_expr_head_name(e = field, env = EnvEmpty, locals = tuple) == Some("Outer"))
  let tuple_masked = afe_mask_pat_binders(locals = tuple, pat = PBind("it"))
  assert(afe_expr_head_name(e = field, env = EnvEmpty, locals = tuple_masked) == None)
  let array = afe_bind_value(locals = afe_no_locals(), name = "it", val = EArray([
    value
  ]), env = EnvEmpty)
  let read = ECall(EIdent("Array::get", -1), [EIdent("it", -1), EInt(0)], -1, [])
  assert(afe_expr_head_name(e = read, env = EnvEmpty, locals = array) == Some("Outer"))
  let array_masked = afe_bind_value(locals = array, name = "it", val = EInt(0), env = EnvEmpty)
  assert(afe_expr_head_name(e = read, env = EnvEmpty, locals = array_masked) == None)
  let callback = EFn([], [], [], Some(TyName("Outer")), None, value)
  let callable = afe_bind_value(locals = afe_no_locals(), name = "it", val = callback, env = EnvEmpty)
  let call = ECall(EIdent("it", -1), [], -1, [])
  assert(afe_expr_head_name(e = call, env = EnvEmpty, locals = callable) == Some("Outer"))
  let unknown = EFn([], [], [], None, None, EInt(0))
  let callback_masked = afe_bind_value(locals = callable, name = "it", val = unknown, env = EnvEmpty)
  assert(afe_expr_head_name(e = call, env = EnvEmpty, locals = callback_masked) == None)
  assert(afe_expr_head_name(e = call, env = EnvEmpty, locals = callable) == Some("Outer"))
}
