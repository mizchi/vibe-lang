import @vibe/compiler/cache {
  ast_binary_read_expr, ast_binary_reader_new, ast_binary_write_expr
}

import @vibe/compiler/core {
  Expr,
  Stmt,
  Type,
  TypeEnv,
  call_placement_capture_begin,
  call_placement_capture_end,
  call_placement_checked_rows,
  call_placement_copy,
  call_placement_get,
  call_placement_is_placed,
  call_placement_is_refused,
  call_placement_is_written,
  call_placement_lowering_refusal,
  call_placement_note_positional,
  call_placement_record,
  env_bind,
  lowering_row_encode,
  resolved_callee_operation,
  restore_call_placements,
  return_call_resolve
}

import @vibe/compiler/checker/builtin_sigs {
  resolve_builtin_callee
}

/// Offset -1 must not collapse distinct calls into one placement, and an
/// unlocated call has no row to travel in.
test "unlocated placements use independent cells and publish no row" {
  call_placement_capture_begin()
  let first: Array[Int] = []
  let second: Array[Int] = []
  call_placement_record(first, -1, 1, 0, [2])
  call_placement_record(second, -1, 2, 0, [4, 2])
  call_placement_capture_end()
  assert(call_placement_get(first) == Some((1, 0, [2])))
  assert(call_placement_get(second) == Some((2, 0, [4, 2])))
  assert(call_placement_checked_rows() == [13])
}

/// Resolving a non-migrated builtin must retain the call's placement.
test "callee resolution preserves label metadata for ordinary and migrated calls" {
  call_placement_capture_begin()
  let cell: Array[Int] = []
  call_placement_record(cell, 7, 2, 0, [2, 4])
  call_placement_capture_end()
  assert(resolve_builtin_callee(EnvEmpty, "Array::get", 7, cell) == 0)
  assert(call_placement_get(cell) == Some((2, 0, [2, 4])))
  assert(resolved_callee_operation(cell) == 0)
  assert(resolve_builtin_callee(EnvEmpty, "MutBytes::push", 7, cell) == 2)
  assert(call_placement_get(cell) == Some((2, 0, [2, 4])))
  assert(resolved_callee_operation(cell) == 2)
  assert(resolved_callee_operation(return_call_resolve(cell, 17)) == 2)
  let own = env_bind(EnvEmpty, "MutBytes::push", CtFn([CtInt, CtInt], CtInt, None))
  assert(resolve_builtin_callee(own, "MutBytes::push", 7, cell) == -1)
  assert(resolved_callee_operation(cell) == -1)
  assert(call_placement_get(cell) == Some((2, 0, [2, 4])))
}

/// A memoized parse shares its cells with every later compile, so the placed
/// call owns a copy and the written call keeps a written placement.
test "placing a call copies its cell and keeps the written one" {
  call_placement_capture_begin()
  let cell: Array[Int] = [3]
  call_placement_record(cell, 9, 2, 0, [4, 2])
  let placed = call_placement_copy(cell, 5)
  assert(call_placement_is_written(cell))
  assert(call_placement_is_placed(placed))
  assert(call_placement_get(placed) == Some((2, 0, [4, 2])))
  assert(resolved_callee_operation(placed) == 3)
  // Re-typing the placed call records nothing over its written payload.
  call_placement_record(placed, 9, 2, 0, [2, 4])
  assert(call_placement_get(placed) == Some((2, 0, [4, 2])))
  call_placement_capture_end()
}

/// A precheck macro that consumes a call positionally cannot keep a placement
/// that moves an argument: it refuses the cell, which the macro's replacement
/// keeps, by the call's name. One that moves nothing is kept.
test "a positional macro refuses a moving placement" {
  let callee = EIdent("subtract", 9)
  let moving: Array[Int] = []
  call_placement_record(moving, 9, 2, 0, [4, 2])
  call_placement_note_positional(callee, [EInt(1), EInt(1)], 9, moving)
  assert(call_placement_is_refused(moving))
  assert(String::contains(call_placement_lowering_refusal(moving, EIdent("__to_string", -1), -1), "`subtract` at byte 9"))
  let still: Array[Int] = []
  call_placement_record(still, 9, 2, 0, [2, 4])
  call_placement_note_positional(callee, [EInt(1), EInt(1)], 9, still)
  assert(!call_placement_is_refused(still))
}

/// Packet entries carry indices directly, including an omitted optional slot.
test "checked placement emits a variable length tagged packet" {
  call_placement_capture_begin()
  let cell: Array[Int] = []
  call_placement_record(cell, 7, 2, 0, [5, 2, 0])
  call_placement_capture_end()
  assert(call_placement_checked_rows() == [13, 120, 41, 10, 91, 43, 11, 124])
}

fn restore_packet(rows: Array[Int]) -> Array[Int] {
  let cell: Array[Int] = []
  restore_call_placements([
    SExpr(ECall(EIdent("f", 7), [
      ELabeledArg("y", "~", EInt(1)),
      ELabeledArg("x", "~", EInt(1))
    ], 7, cell))
  ], rows)
  cell
}

/// Duplicate source observations agree, while conflicting order cannot be used.
test "restoration accepts equal duplicate packets and refuses conflicting ones" {
  let packet = [120, 41, 10, 75, 43, 124]
  let rows = [13]
  for row in packet {
    Array::push(rows, row)
  }
  for row in packet {
    Array::push(rows, row)
  }
  assert(call_placement_get(restore_packet(rows)) == Some((2, 0, [4, 2])))
  Array::set(rows, 10, 43)
  Array::set(rows, 11, 75)
  assert(call_placement_is_refused(restore_packet(rows)))
}

/// The transport cannot silently ignore malformed or incomplete proof bytes.
test "malformed placement packets fail closed at the labeled call" {
  let invalid = [
    [13, 120, 41, 10, 75, 75, 124],
    [13, 120, 41, 10, 75, 124],
    [13, 120, 41, 10, 75, 43],
    [13, 120, 41, 10, 75, 43, 140],
    [13, 120, 41, 26, 75, 43, 124],
    [13, 120, 41, 58, 75, 43, 124],
    [13, 14],
    [14, 120, 41, 10, 75, 43, 124]
  ]
  for rows in invalid {
    assert(call_placement_is_refused(restore_packet(rows)))
  }
  // A complete channel without this call's packet, or a declined one, leaves
  // the call unplaced: lowering refuses it if it gets that far.
  for rows in [[13], [14]] {
    let cell = restore_packet(rows)
    assert(!call_placement_is_refused(cell))
    assert(call_placement_get(cell) == None)
  }
}

/// Indices are variable-length rows; arities above a byte are not truncated.
test "placement transport retains more than 255 written arguments" {
  let rows = [13, 120, lowering_row_encode(300, 9), 10]
  let args: Array[Expr] = []
  let mut i = 0
  while i < 300 {
    Array::push(rows, lowering_row_encode((300 - i) * 2, 11))
    Array::push(args, ELabeledArg("x", "~", EInt(i)))
    i = i + 1
  }
  Array::push(rows, 124)
  let cell: Array[Int] = []
  restore_call_placements([SExpr(ECall(EIdent("f", 7), args, 7, cell))], rows)
  match call_placement_get(cell) {
    Some((written, mode, slots)) => {
      assert(written == 300 && mode == 0)
      assert(Array::length(slots) == 300)
      assert(Array::get(slots, 0) == 600 && Array::get(slots, 299) == 2)
    },
    None => assert(false)
  }
}

fn binary_cell(cell: Array[Int]) -> Option[Array[Int]] {
  let bytes = Bytes::new()
  ast_binary_write_expr(bytes, ECall(EIdent("f", 7), [EInt(3), EInt(10)], 7, cell))
  handle {
    match ast_binary_read_expr(ast_binary_reader_new(bytes)) {
      ECall(_, _, _, restored) => Some(restored),
      _ => None
    }
  } with { Exception::Throw(_) => None }
}

/// AST caches retain checked placements, refusal diagnostics and return-site
/// wrappers, in addition to the original single-operation cells.
test "binary AST transport retains validated placement cells" {
  for cell in [
    [],
    [-1],
    [2],
    [0, -3660, 1, 2, 0, 4, 2, 0],
    [2, -3660, 4, 2, 0, 2, 4],
    [0, -3660, 5, 2, 0, 4, 2],
    [0, -3660, 2],
    [0, -3660, 3, -1, 1, 102]
  ] {
    assert(binary_cell(cell) == Some(cell))
    let wrapped = return_call_resolve(cell, 17)
    assert(binary_cell(wrapped) == Some(wrapped))
  }
}

/// Process-local snapshot IDs and invalid index/operation payloads are refused;
/// merely lifting the old one-word limit would accept untrusted garbage.
test "binary AST transport refuses transient and malformed placement cells" {
  for cell in [
    [0],
    [9999],
    [0, -3660, 0, 1, 0],
    [0, -3660, 1],
    [0, -3660, 1, 2, 0, 2, 2],
    [0, -3660, 1, 2, 0, 2],
    [0, -3660, 1, 2, 1, 4, 2],
    [0, -3660, 1, 2, 3, 2, 4],
    [9999, -3660, 1, 2, 0, 2, 4],
    [0, -3660, 3, -2, 0],
    [0, -3660, 3, 7, 0, 256]
  ] {
    assert(binary_cell(cell) == None)
    assert(binary_cell(return_call_resolve(cell, 17)) == None)
  }
}
