// ADR-0120 D3 (#3681): `_` before a parameter's name makes that slot
// positional. The parameter keeps its plain name; the declaration's slots
// travel in a trailing `SPositionalParams` statement, and the checker spells
// them into the call header.

import @vibe/compiler/checker {
  check_program, checker_required_labels_suspend, label_sites_begin, label_sites_end
}

import @vibe/compiler/refactor {
  add_labels, add_labels_positional_none
}

import @vibe/compiler/contract {
  collect_impl_fn_defs, contract_hash, parse_contract_program
}

import @vibe/compiler/core {
  Stmt
}

import @vibe/parser {
  lex_with_offsets, parse_program_located, print_program, print_stmt
}

fn parsed(_ source: String) -> Array[Stmt] with Exception {
  let (tokens, starts, _) = lex_with_offsets(source)
  parse_program_located(tokens = tokens, starts = starts, source = source)
}

/// The `SPositionalParams` rows of `source`, as `name:slot,slot` lines.
fn slots(_ source: String) -> String with Exception {
  let rows: Array[String] = []
  for stmt in parsed(source) {
    match stmt {
      SPositionalParams(found) => for row in found {
        let (name, at) = row
        Array::push(rows, value = name + ":" + String::join(for i in at {
          __to_string(i)
        }, sep = ","))
      },
      _ => ()
    }
  }
  String::join(rows, sep = "\n")
}

/// The checker's first error, "" when the program checks.
fn first_error(_ source: String) -> String with Exception {
  handle {
    let _ = check_program(parsed(source))
    ""
  } with { Exception::Throw(message) => message }
}

/// The parse error, "" when the source parses.
fn parse_error(_ source: String) -> String {
  handle {
    let _ = parsed(source)
    ""
  } with { Exception::Throw(message) => message }
}

fn get_decl() -> String {
  "fn get(_ xs: Array[Int], at: Int) -> Int {\n  Array::get(xs, at = at)\n}\n"
}

test "each declaration form records its `_` slots" {
  inspect(slots(get_decl()), content = "get:0")
  inspect(slots("struct P {\n  v: Int\n}\nfn P::plus(_ p: P, n: Int, _ m: Int) -> Int {\n  p.v + n + m\n}\n"), content = "P::plus:0,2")
  inspect(slots("let twice = (_ x: Int) -> Int { x * 2 }\n"), content = "twice:0")
  inspect(slots("fn plain(a: Int, b: Int) -> Int {\n  a - b\n}\n"), content = "")
  // A lone `_` is still the wildcard parameter, not a marker.
  inspect(slots("fn ignore(_: Int, b: Int) -> Int {\n  b\n}\n"), content = "")
}

test "the parameter keeps its plain name" {
  let source = get_decl() + "fn main() -> Int {\n  get([1, 2], at = 1)\n}\n"
  inspect(first_error(source), content = "")
}

test "`_` on a lambda that is not a declaration is refused" {
  inspect(String::contains(parse_error("fn main() -> Int {\n  let f = (_ x: Int) -> Int { x }\n  f(1)\n}\n"), needle = "remove `_ `"), content = "true")
  inspect(String::contains(parse_error("let g = apply((_ x: Int) -> Int { x })\n"), needle = "remove `_ `"), content = "true")
}

test "a `_` slot is filled by position, beside labels" {
  let ok = get_decl() + "fn main() -> Int {\n  get([1, 2], at = 1) + get([3], at = 0)\n}\n"
  inspect(first_error(ok), content = "")
}

test "a label on a `_` slot names the edit" {
  let bad = get_decl() + "fn main() -> Int {\n  get(xs = [1, 2], at = 1)\n}\n"
  inspect(String::contains(first_error(bad), needle = "argument 1 of get is positional (the declaration writes `_` before it): remove `xs = `"), content = "true")
}

test "a call that mixes forms off the `_` slots is still refused" {
  // ADR-0120 Phase 4: the refusal names the label the call is missing.
  let source = "fn sub(x: Int, y: Int) -> Int {\n  x - y\n}\nfn main() -> Int {\n  sub(10, y = 3)\n}\n"
  inspect(String::contains(first_error(source), needle = "label the arguments of sub: write `x = ` before argument 1"), content = "true")
}

test "the printer writes `_` back" {
  let printed = print_program(parsed(get_decl() + "let twice = (_ x: Int) -> Int { x * 2 }\n"))
  inspect(String::contains(printed, needle = "(_ xs: Array[Int], at: Int)"), content = "true")
  inspect(String::contains(printed, needle = "(_ x: Int)"), content = "true")
  inspect(slots(printed), content = "get:0\ntwice:0")
}

test "the codemod leaves a declared `_` positional under every policy" {
  let source = get_decl() + "fn main() -> Int {\n  get([1, 2], 1)\n}\n"
  // The codemod types the program it labels with the required-label check
  // suspended (ADR-0120 Phase 4); so does this test.
  checker_required_labels_suspend(true)
  label_sites_begin()
  let _ = check_program(parsed(source))
  let sites = label_sites_end()
  checker_required_labels_suspend(false)
  let result = add_labels(path = "t.vibe", source = source, offset_delta = 0, sites = sites, policy = add_labels_positional_none)
  inspect(String::contains(result.source, needle = "get([1, 2], at = 1)"), content = "true")
  inspect(result.deferred_calls, content = "0")
}

test "an inactive `#cfg` declaration leaves no `_` slots behind" {
  // Codex review of #3691: the guarded statement is parsed and dropped, so
  // its slots must go with it, or the active `f` below would read `x` as
  // positional and refuse `f(x = 1)`.
  let source = "#cfg(never_set_flag)\nfn f(_ x: Int) -> Int {\n  x\n}\n\nfn f(x: Int) -> Int {\n  x + 1\n}\n\nfn main() -> Int {\n  f(x = 1)\n}\n"
  inspect(slots(source), content = "")
  inspect(first_error(source), content = "")
}

fn contract_sig(_ source: String) -> (String, String) with Exception {
  let (tokens, _, _) = lex_with_offsets(source)
  let (decls, opaque, stmts) = parse_contract_program(tokens)
  let (_, sig) = Array::get(decls, at = 0)
  (sig, contract_hash(fn_decls = decls, opaque_names = opaque, type_defs = stmts))
}

test "a `_` slot is part of a contract's signature and hash" {
  // Codex review of #3691: adding `_` rejects calls that labeled the slot, so
  // a contract that adds one has changed, and its hash must say so.
  let (plain_sig, plain_hash) = contract_sig("fn get(xs: Array[Int], at: Int) -> Int\n")
  let (marked_sig, marked_hash) = contract_sig("fn get(_ xs: Array[Int], at: Int) -> Int\n")
  inspect(marked_sig, content = "(_ Array[Int], Int) -> Int")
  inspect(plain_sig == marked_sig, content = "false")
  inspect(plain_hash == marked_hash, content = "false")
}

/// The conformance signatures of the units concatenated the way the package
/// loader concatenates them: each unit followed by an empty marker.
fn union_sigs(_ units: Array[String]) -> String with Exception {
  let union: Array[Stmt] = []
  for unit in units {
    for stmt in parsed(unit) {
      Array::push(union, value = stmt)
    }
    Array::push(union, value = SPositionalParams([]))
  }
  let out: Array[String] = []
  for def in collect_impl_fn_defs(union) {
    let (name, sig, exported) = def
    let shown = match sig {
      Some(text) => text,
      None => "?"
    }
    Array::push(out, value = name + (if exported {
      " export "
    } else {
      " private "
    }) + shown)
  }
  String::join(out, sep = "\n")
}

test "a unit's `_` slots never mark another unit's same-named function" {
  // Codex review of #3691: conformance reads one concatenation of every
  // implementation file, where a private helper may share an exported name.
  let exported = "export fn f(x: Int) -> Int {\n  x\n}\n"
  let private = "fn f(_ x: Int) -> Int {\n  x\n}\n"
  inspect(union_sigs([exported, private]), content = "f export (Int) -> Int\nf private (_ Int) -> Int")
  inspect(union_sigs([private, exported]), content = "f private (_ Int) -> Int\nf export (Int) -> Int")
}

test "a `_` slot's internal name is not part of the signature" {
  // Codex review of #3691: neither declaration accepts a label there.
  let (a, _) = contract_sig("fn f(_ x?: Int) -> Int\n")
  let (b, _) = contract_sig("fn f(_ y?: Int) -> Int\n")
  inspect(a, content = "(_ ?: Option[Int]) -> Int")
  inspect(a == b, content = "true")
  let (c, _) = contract_sig("fn f(x?: Int) -> Int\n")
  inspect(a == c, content = "false")
}

test "a printed program's `_` slots do not outlive it" {
  // Codex review of #3691: `print_program` registers the slots; a later
  // `print_stmt` of another program's same-named `f` must not print them.
  let _ = print_program(parsed("fn f(_ x: Int) -> Int {\n  x\n}\n"))
  let other = parsed("fn f(x: Int) -> Int {\n  x\n}\n")
  let shown = print_stmt(Array::get(other, at = 0))
  inspect(String::contains(shown, needle = "_ x"), content = "false")
}

test "a method call's missing-label span is the written method name" {
  // Codex on #3881: the span was sized by the resolved `P::bump`, so it ran
  // past `bump` into the arguments.
  let source = "struct P {\n  v: Int\n}\nfn P::bump(self: P, n: Int) -> Int {\n  self.v + n\n}\nfn main() -> Int {\n  let p = P::{ v: 1 }\n  p.bump(1)\n}\n"
  let start = String::index_of(source, needle = "p.bump(1)") + 2
  let message = first_error(source)
  inspect(String::contains(message, needle = "label the arguments of P::bump: write `n = ` before argument 1"), content = "true")
  inspect(String::contains(message, needle = "[@off=\{start}:\{start + 4}]"), content = "true")
}
