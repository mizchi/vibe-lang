//# Imports

import ../codegen {
  compile_wasi_module
}

import ./s5_test_support.vibe {
  load_selfhost_merged
}

//# Misc

// #769: bounds refreshed -- the "~385KB" envelope predates years of compiler
// growth (observed 9,083,086 bytes on 2026-07-10; the old `len < 500000`
// assert was the test's actual failure once the bundle-ingest lane worked
// again). Keep a wide sanity envelope: big enough to be a real compiler,
// small enough to catch a runaway size blowup.
test "S5: check WASM output size (sanity envelope)" {
  let bytes = compile_wasi_module(load_selfhost_merged(), "_start")
  let len = Bytes::length(bytes)
  assert(len > 2000000)
  assert(len < 32000000)
}
