//# Imports

import @vibe/compiler/checker {
  check_program
}

import @vibe/compiler/syntax {
  lex, parse_program
}
//# Functions

export fn check_source_ok(source: String) -> Bool {
  handle {
    let tokens = lex(source)
    let stmts = parse_program(tokens)
    let _env = check_program(stmts)
    true
  } with Exception {
    Throw(_) => false
  }
}

export fn check_source_err(source: String) -> Bool {
  handle {
    let tokens = lex(source)
    let stmts = parse_program(tokens)
    let _env = check_program(stmts)
    false
  } with Exception {
    Throw(_) => true
  }
}
