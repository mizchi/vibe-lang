//# Imports

import @vibe/compiler/checker {
  check_program
}

import @vibe/compiler/syntax {
  lex, lex_with_offsets, parse_program, parse_program_located
}

import @vibe/compiler/runtime {
  locate_type_error
}
//# Functions

export fn check_source_ok(_ source: String) -> Bool {
  handle {
    let tokens = lex(source)
    let stmts = parse_program(tokens)
    let _env = check_program(stmts, checked_error_row = false)
    true
  } with { Exception::Throw(_) => false }
}

export fn check_source_err(_ source: String) -> Bool {
  handle {
    let tokens = lex(source)
    let stmts = parse_program(tokens)
    let _env = check_program(stmts, checked_error_row = false)
    false
  } with { Exception::Throw(_) => true }
}

export fn check_source_err_contains(source: String, needle: String) -> Bool {
  handle {
    let tokens = lex(source)
    let stmts = parse_program(tokens)
    let _env = check_program(stmts, checked_error_row = false)
    false
  } with { Exception::Throw(msg) => String::contains(msg, needle = needle) }
}

export fn check_source_located_err_contains(source: String, needle: String) -> Bool {
  handle {
    let (tokens, starts, _) = lex_with_offsets(source)
    let stmts = parse_program_located(tokens = tokens, starts = starts, source = source)
    let _env = check_program(stmts, checked_error_row = false)
    false
  } with { Exception::Throw(msg) => String::contains(locate_type_error(source = source, msg = msg), needle = needle) }
}

/// #2831: the FIRST diagnostic of a report that may now carry several.
///
/// `check_program` reports every diagnostic it collected, `\n`-joined, so a
/// helper named for one message has to take one. Continuation lines (`hint: `,
/// or anything indented) belong to the diagnostic above them and stay with it
/// -- the same rule `format_check_report` frames by.
fn first_reported_diagnostic(_ msg: String) -> String {
  let lines = String::split(msg, sep = "\n")
  let out: Array[String] = []
  let mut i = 0
  let mut done = false
  while !done && i < Array::length(lines) {
    let line = Array::get(lines, at = i)
    let is_cont = if String::starts_with(line, prefix = "hint: ") {
      true
    } else if String::length(line) == 0 {
      false
    } else {
      let c = String::byte_at(line, at = 0)
      c == 32 || c == 9
    }
    if i == 0 || is_cont {
      if String::length(line) > 0 || i == 0 {
        Array::push(out, value = line)
      } else {
        ()
      }
    } else {
      done = true
    }
    i = i + 1
  }
  String::join(out, sep = "\n")
}

export fn check_source_error_message(_ source: String) -> String {
  handle {
    let tokens = lex(source)
    let stmts = parse_program(tokens)
    let _env = check_program(stmts, checked_error_row = false)
    ""
  } with { Exception::Throw(message) => first_reported_diagnostic(message) }
}

/// The whole report, every diagnostic `check_program` collected (`""` when
/// the source checks clean) -- for a test that pins what is NOT reported too.
export fn check_source_report(_ source: String) -> String {
  handle {
    let tokens = lex(source)
    let stmts = parse_program(tokens)
    let _env = check_program(stmts, checked_error_row = false)
    ""
  } with { Exception::Throw(message) => message }
}
