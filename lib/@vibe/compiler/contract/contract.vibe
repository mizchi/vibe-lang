//# Imports

import @vibe/compiler/core {
  Expr, ImportItem, Stmt, TypeExpr, is_builtin_type_name, lookup_registry_builtin, resolve_builtin
}

import @vibe/compiler/syntax {
  Token, parse_fn_signature, parse_stmt, parse_type, peek, print_stmt, print_type_expr, tk_name
}

// #741: consumed through the @vibe/core contract boundary (directory import
// resolving via index.vibei), replacing the vendored cache/sha1.vibe twin.
import @vibe/core {
  array_empty, sha1
}

//# Functions

/// #740/#753: facades are marked so every re-ingestion point (the grouped
/// chokepoint, the persistent-header lane, type_db re-reads of collected
/// sources) can tell an already-desugared facade from raw contract grammar.
/// Re-parsing a facade AS a contract mis-attributes its imports (a facade
/// with only `import ./impl.vibe {}` lines yields zero DECLS, and one with
/// only type defs yields zero impl imports → sibling auto-discovery), so the
/// marker check must happen wherever `.vibei`-suffixed sources are parsed.
export let contract_facade_marker: String = "// vibe: contract facade (desugared from .vibei)\n"

/// #897 (ADR-0070 Phase 1): mirrors `contract_facade_marker`'s idempotency
/// role, for a DIFFERENT ingestion transform -- a sibling `.vibe` impl file
/// under a `.vpkg` directory gets that vpkg's directory-shared imports
/// PREPENDED to its own source text (see `contract_directory_shared_import_prefix_text`
/// below and `ingest_source_text_fs`/`collect_sources_rec` in loader/index.vibe,
/// the two call sites). Ingestion is applied more than once to the same
/// logical file in ordinary operation (`collect_source_groups_fs` re-ingests
/// every already-collected source; #740's comment documents the same
/// re-ingestion for the contract-facade case) -- without a marker, a second
/// pass would prepend the imports AGAIN, producing duplicate `import`
/// statements. The loader checks for this marker before prepending and skips
/// if already present, exactly like the facade marker check.
export let vpkg_shared_import_marker: String = "// vibe: vpkg directory-shared imports (#897)\n"

// ADR-0063 Phase C (#729): contract conformance engine for `.vibei` files.
//
// A contract file's top level declares the package's public API. This module
// parses bodyless `fn` declarations (the contract grammar) and checks that a
// package's implementation statements provide exactly the declared surface:
// every declared fn exists with a matching signature (param types + labels,
// generics, return type, effect row), and no exported def is undeclared.
//
// This increment is the pure engine + its grammar; wiring into import
// resolution / the merge layer (directory imports resolving through
// index.vibei, boundary rules) is the next #729 stage.

/// Canonical signature fingerprint: `[T: Eq](Int, x~: Int) -> Ret with E`.
/// Labeled params keep their name (the label is ABI); positional params are
/// types only. Built from the same shapes both the contract declaration and
/// the implementation's EFn carry, so string equality is signature equality.
fn fn_sig_text(tps: Array[String], tbs: Array[(String, Array[String])], params: Array[(String, Option[TypeExpr])], ret_ty: TypeExpr, eff_opt: Option[String]) -> Option[String] {
  let mut missing = false
  let parts = array_empty()
  let mut i = 0
  while i < Array::length(params) {
    let (pname, pty_opt) = Array::get(params, i)
    match pty_opt {
      Some(pty) => {
        let tystr = print_type_expr(pty)
        let entry = if String::ends_with(pname, "~") {
          "\{pname}: \{tystr}"
        } else tystr
        Array::push(parts, entry)
      },
      None => {
        missing = true
      }
    }
    i = i + 1
  }
  if missing {
    None
  } else {
    let gen = if Array::length(tps) == 0 {
      ""
    } else {
      let entries = array_empty()
      let mut gi = 0
      while gi < Array::length(tps) {
        let tp = Array::get(tps, gi)
        let mut bound = ""
        let mut bi = 0
        while bi < Array::length(tbs) {
          let (bname, bnds) = Array::get(tbs, bi)
          if bname == tp && Array::length(bnds) > 0 {
            bound = String::join(bnds, " + ")
          } else ()
          bi = bi + 1
        }
        let entry = if String::length(bound) == 0 {
          tp
        } else "\{tp}: \{bound}"
        Array::push(entries, entry)
        gi = gi + 1
      }
      "[\{String::join(entries, ", ")}]"
    }
    let eff = match eff_opt {
      Some(e) => " with { \{e} }",
      None => ""
    }
    Some("\{gen}(\{String::join(parts, ", ")}) -> \{print_type_expr(ret_ty)}\{eff}")
  }
}

/// Parse a contract source's top level. Bare `fn` heads become declarations
/// (name, canonical signature); a declaration followed by `{` is an error —
/// contract files carry no bodies. `opaque type Name` declares a public type
/// whose definition lives in an implementation file (#729 C-4). Everything
/// else (implementation imports, transparent type definitions) parses as
/// ordinary statements and is returned alongside.
/// #739: opaque/bodyless type declarations carry (name, arity) so conformance
/// can reject an impl whose type-parameter count differs and the semver
/// surface can see `Box` -> `Box[T]` as a breaking change.
/// #2317: record a contract statement together with the token index it
/// started at.
///
/// The two arrays are read positionally by `contract_classify_diagnostic`, so
/// a push that lands in only one of them does not fail -- it shifts every
/// later statement's anchor onto its neighbour, which is a diagnostic pointing
/// confidently at the wrong line. One call site each keeps them paired, and
/// the length check at the end of the parse catches a site that bypasses this.
fn push_contract_stmt(stmts: Array[Stmt], stmt_at: Array[Int], stmt: Stmt, at: Int) -> Unit {
  Array::push(stmts, stmt)
  Array::push(stmt_at, at)
}

/// #2317: record a bodyless declaration together with the token index it
/// started at, for the same reason as `push_contract_stmt` -- the two arrays
/// are read positionally, so a push landing in only one of them would shift
/// every later declaration's anchor onto its neighbour.
fn push_contract_decl(decls: Array[(String, String)], decl_at: Array[Int], name: String, sig: String, at: Int) -> Unit {
  Array::push(decls, (name, sig))
  Array::push(decl_at, at)
}

export fn parse_contract_program(tokens: Array[Token]) -> (Array[(String, String)], Array[(String, Int)], Array[Stmt]) with Exception {
  let (decls, opaques, stmts, _at, _dat) = parse_contract_program_spans(tokens)
  (decls, opaques, stmts)
}

/// #2317: `parse_contract_program`, plus the TOKEN INDEX each statement
/// started at (one entry per `Stmt`, same order).
///
/// `classify_contract_stmts` rejects a statement a contract may not contain,
/// and its message carries no position -- so the buffer lane rendered it at
/// the synthetic 0:0 and told the reader a contract is broken without saying
/// where. The parser is the only place that knows where each statement began;
/// it used to discard that. Recovering it by SEARCH was tried three times in
/// the #2315 review and each attempt produced a predicate that could anchor on
/// valid code, so the offset is carried instead.
export fn parse_contract_program_spans(tokens: Array[Token]) -> (Array[(String, String)], Array[(String, Int)], Array[Stmt], Array[Int], Array[Int]) with Exception {
  let decls = array_empty()
  let decl_at = array_empty()
  let opaques = array_empty()
  let stmts = array_empty()
  let stmt_at = array_empty()
  let mut pos = 0
  let mut done = false
  while !done {
    match peek(tokens, pos) {
      TEof => {
        done = true
      },
      TType => {
        // Bodyless `type Name` / `type Name[T]` — a TRANSPARENT public type
        // whose definition lives in an implementation file (the facade
        // re-exports it; same conformance rules as opaque, opacity is the
        // only — currently documentation-level — difference). `type X = ..`
        // (with '=') is the contract-defined alias and parses as a stmt.
        let mut la = pos + 1
        let tname = match peek(tokens, la) {
          TIdent(tn) => tn,
          _ => ""
        }
        let mut is_bodyless = false
        let mut arity = 0
        if tname == "" {
          ()
        } else {
          la = la + 1
          let mut scan = la
          match peek(tokens, scan) {
            TLBracket => {
              let mut depth = 1
              // `[T, U]` — parameters at depth 1 are comma-separated (#739).
              arity = 1
              scan = scan + 1
              while depth > 0 {
                match peek(tokens, scan) {
                  TLBracket => {
                    depth = depth + 1
                  },
                  TRBracket => {
                    depth = depth - 1
                  },
                  TComma => if depth == 1 {
                    arity = arity + 1
                  } else {
                    ()
                  },
                  TEof => {
                    depth = 0
                  },
                  _ => ()
                }
                scan = scan + 1
              }
            },
            _ => ()
          }
          match peek(tokens, scan) {
            TEq => {
              arity = 0
            },
            _ => {
              is_bodyless = true
              la = scan
            }
          }
        }
        if is_bodyless {
          Array::push(opaques, (tname, arity))
          pos = la
        } else {
          let (stmt, next) = parse_stmt(tokens, [], pos)
          push_contract_stmt(stmts, stmt_at, stmt, pos)
          pos = next
        }
      },
      TLet => {
        // #752 (ADR-0065): bodyless `let name: Type` — a public VALUE
        // declaration (constants like `pi: Double`). The definition lives in
        // an implementation file and is fingerprinted as "val <type>";
        // conformance and the facade treat it exactly like a fn decl (both
        // are name + signature-string). A body (`= ...`) is rejected like fn
        // bodies; `let mut` cannot be contract surface.
        match peek(tokens, pos + 1) {
          TMut => throw("contract let declaration cannot be `mut` (#752)"),
          _ => ()
        }
        let vname = match peek(tokens, pos + 1) {
          TIdent(vn) => vn,
          _ => throw("expected value name after 'let' in a contract")
        }
        match peek(tokens, pos + 2) {
          TColon => (),
          _ => throw("contract value declaration '\{vname}' requires a type annotation (#752)")
        }
        let (vty, vnext) = parse_type(tokens, pos + 3)
        match peek(tokens, vnext) {
          TEq => throw("contract value declaration '\{vname}' must not have a definition (#752)"),
          _ => ()
        }
        push_contract_decl(decls, decl_at, vname, String::concat("val ", print_type_expr(vty)), pos)
        pos = vnext
      },
      TIdent(head) => if head == "opaque" {
        match peek(tokens, pos + 1) {
          TType => match peek(tokens, pos + 2) {
            TIdent(oname) => {
              match peek(tokens, pos + 3) {
                TLBracket => throw("opaque type '\{oname}': type parameters are not yet supported (#729)"),
                _ => ()
              }
              Array::push(opaques, (oname, 0))
              pos = pos + 3
            },
            _ => throw("expected type name after 'opaque type'")
          },
          _ => throw("expected 'type' after 'opaque'")
        }
      } else {
        let (stmt, next) = parse_stmt(tokens, [], pos)
        push_contract_stmt(stmts, stmt_at, stmt, pos)
        pos = next
      },
      // `#deprecated` is a token-level marker (`vibe check` scans the
      // on-disk vpkg). The contract grammar has to skip it so type aliases
      // that exist only here can carry the directive. Other `#` forms
      // (`#cfg`, `#zero_alloc`) stay rejected — they have no contract
      // meaning yet.
      THash => {
        match peek(tokens, pos + 1) {
          TIdent(dname) => {
            if dname == "deprecated" {
              match peek(tokens, pos + 2) {
                TLParen => match peek(tokens, pos + 3) {
                  TString(_) => match peek(tokens, pos + 4) {
                    TRParen => {
                      pos = pos + 5
                    },
                    _ => throw("expected ')' after #deprecated message")
                  },
                  _ => throw("expected string message in #deprecated(...)")
                },
                _ => {
                  pos = pos + 2
                }
              }
            } else {
              throw("unsupported # directive in a contract file: \{dname} (only #deprecated is allowed)")
            }
          },
          _ => throw("expected directive name after '#' in a contract file")
        }
      },
      // #1280: `fn` lexes as TFn (reserved word), no longer TIdent("fn").
      TFn => {
        // where clauses on declarations parse but are not yet part of the
        // contract fingerprint (conformance/hash coverage comes with the
        // SMT stage of #731).
        let (dhead, dsig, _, next) = parse_fn_signature(tokens, pos + 1)
        let (name, tps, tbs) = dhead
        let (params, ret_ty, eff_opt) = dsig
        match peek(tokens, next) {
          TLBrace => throw("contract fn declaration '\{name}' must not have a body (#729)"),
          _ => ()
        }
        match fn_sig_text(tps, tbs, params, ret_ty, eff_opt) {
          Some(sig) => push_contract_decl(decls, decl_at, name, sig, pos),
          None => throw("contract fn declaration '\{name}' requires full annotations")
        }
        pos = next
      },
      _ => {
        let (stmt, next) = parse_stmt(tokens, [], pos)
        push_contract_stmt(stmts, stmt_at, stmt, pos)
        pos = next
      }
    }
  }
  if Array::length(stmts) != Array::length(stmt_at) || Array::length(decls) != Array::length(decl_at) {
    throw("internal: contract offsets desynced (#2317) -- a statement or declaration was recorded without its position")
  } else {
    ()
  }
  (decls, opaques, stmts, stmt_at, decl_at)
}

/// Collect (name, Some(sig) | None, exported) for every top-level let whose
/// value is a function. A None signature means the def lacks the full
/// annotations needed to compare against a contract (e.g. an unannotated
/// lambda) — reported as a conformance error if the name is declared.
export fn collect_impl_fn_defs(stmts: Array[Stmt]) -> Array[(String, Option[String], Bool)] {
  let out = array_empty()
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SLet(exported, _, name, ty_opt, val) => match val {
        EFn(tps, tbs, params, ret_opt, eff_opt, _) => {
          let sig = match ret_opt {
            Some(ret_ty) => fn_sig_text(tps, tbs, params, ret_ty, eff_opt),
            None => None
          }
          Array::push(out, (name, sig, exported))
        },
        // #752: a non-fn top-level let is a VALUE def — contract surface when
        // exported, fingerprinted as "val <type>" (matching the contract's
        // bodyless `let name: Type` declarations). An unannotated value maps
        // to None, so a declared name reports the standard
        // "lacks the full annotations" conformance error.
        _ => match ty_opt {
          Some(vty) => Array::push(out, (name, Some(String::concat("val ", print_type_expr(vty))), exported)),
          None => Array::push(out, (name, None, exported))
        }
      },
      _ => ()
    }
    i = i + 1
  }
  out
}

/// Collect (name, exported) for every top-level type definition (struct /
/// enum / type alias / suberror) — the shapes an `opaque type` declaration
/// can be implemented by.
/// #739: the third element is the implementation's type-parameter count, so
/// conformance can compare it against the contract's declared arity.
/// Suberrors carry no type parameters in the AST — arity 0. Structs DO
/// (#829 gave SStruct a trailing tparams field, `struct S[T] { ... }`) —
/// this used to be hardcoded to 0 for every struct, which forced every
/// generic-struct package's contract to under-declare its arity as 0 (see
/// e.g. the #841 packages' now-stale "arity 0" workaround NOTEs).
export fn collect_impl_type_defs(stmts: Array[Stmt]) -> Array[(String, Bool, Int)] {
  let out = array_empty()
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SStruct(exported, name, _, _, _, tparams) => Array::push(out, (name, exported, Array::length(tparams))),
      SEnum(exported, name, tparams, _, _) => Array::push(out, (name, exported, Array::length(tparams))),
      STypeAlias(exported, name, tparams, _) => Array::push(out, (name, exported, Array::length(tparams))),
      SSuberror(exported, name, _) => Array::push(out, (name, exported, 0)),
      _ => ()
    }
    i = i + 1
  }
  out
}

/// #847: names an impl file brings into the package's export surface via
/// `export ./other.vibe { name, other as alias }` rather than a direct
/// SLet/SStruct/... definition — invisible to `collect_impl_fn_defs`/
/// `collect_impl_type_defs`, which only match direct top-level defs. Resolved
/// to the alias when present (the alias, not the source name, is what the
/// contract surface actually sees).
fn collect_reexported_names(impl_stmts: Array[Stmt]) -> Array[String] {
  let out = array_empty()
  let mut i = 0
  while i < Array::length(impl_stmts) {
    match Array::get(impl_stmts, i) {
      SReExport(_, items) => {
        let mut ii = 0
        while ii < Array::length(items) {
          let item = Array::get(items, ii)
          let rname = item.name
          let alias_opt = item.alias
          let exported_name = match alias_opt {
            Some(a) => a,
            None => rname
          }
          Array::push(out, exported_name)
          ii = ii + 1
        }
      },
      _ => ()
    }
    i = i + 1
  }
  out
}

fn array_contains_string(xs: Array[String], target: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(xs) {
    if Array::get(xs, i) == target {
      found = true
    } else ()
    i = i + 1
  }
  found
}

/// ADR-0071 (#755) step 5: signature-matching effectset awareness. decls'
/// and defs' signature strings (fn_sig_text, above) render a fn's effect
/// row VERBATIM as parsed -- a contract spelled with an effectset alias
/// (`with AskAll`) and an implementation spelled with the literal
/// operations it expands to (`with Ask::Get`) are semantically
/// identical but compare unequal as raw strings, producing a false
/// "signature mismatch". Local to this file (no new cross-file reference --
/// see docs/effectset.md's bootstrap gotcha) since it needs its own
/// ES table built from the CONTRACT's own type_defs (the sole source of
/// truth for effect/effectset definitions; implementation files use but
/// never redefine them, same discipline as SEffectDef).
fn ctr_es_index_of(names: Array[String], name: String) -> Int {
  let mut i = 0
  let mut found = -1
  while i < Array::length(names) {
    if Array::get(names, i) == name {
      found = i
    } else {
      ()
    }
    i = i + 1
  }
  found
}

fn ctr_es_contains(arr: Array[String], v: String) -> Bool {
  ctr_es_index_of(arr, v) >= 0
}

fn ctr_es_collect_tables(stmts: Array[Stmt]) -> (Array[String], Array[Array[String]]) {
  let es_names = array_empty()
  let es_members_list = array_empty()
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SEffectSet(_, esname, esmembers) => {
        Array::push(es_names, esname)
        Array::push(es_members_list, esmembers)
      },
      _ => ()
    }
    i = i + 1
  }
  (es_names, es_members_list)
}

/// Same cycle-safe DFS technique as checker_stmt.vibe's es_detect_cycle /
/// es_expand_into -- a cyclic effectset is rejected by the checker
/// separately (checker_stmt.vibe), but this pass runs independently at
/// load/conformance time and must not hang even on a source that hasn't
/// been through that check yet.
fn ctr_es_expand_into(es_names: Array[String], es_members_list: Array[Array[String]], name: String, path: Array[String], out: Array[String]) -> Unit {
  if ctr_es_contains(path, name) {
    ()
  } else {
    let idx = ctr_es_index_of(es_names, name)
    if idx < 0 {
      if ctr_es_contains(out, name) {
        ()
      } else {
        Array::push(out, name)
      }
    } else {
      Array::push(path, name)
      let members = Array::get(es_members_list, idx)
      let mut mi = 0
      while mi < Array::length(members) {
        ctr_es_expand_into(es_names, es_members_list, Array::get(members, mi), path, out)
        mi = mi + 1
      }
      Array::truncate(path, Array::length(path) - 1)
    }
  }
}

fn ctr_es_join_comma(names: Array[String]) -> String {
  let mut result = ""
  let mut i = 0
  while i < Array::length(names) {
    if i == 0 {
      result = Array::get(names, i)
    } else {
      result = String::concat(result, String::concat(", ", Array::get(names, i)))
    }
    i = i + 1
  }
  result
}

fn ctr_es_expand_row_string(row: String, es_names: Array[String], es_members_list: Array[Array[String]]) -> String {
  let raw = String::split(row, ", ")
  let out = array_empty()
  let mut i = 0
  while i < Array::length(raw) {
    let expanded = array_empty()
    ctr_es_expand_into(es_names, es_members_list, Array::get(raw, i), array_empty(), expanded)
    let mut j = 0
    while j < Array::length(expanded) {
      let e = Array::get(expanded, j)
      if ctr_es_contains(out, e) {
        ()
      } else {
        Array::push(out, e)
      }
      j = j + 1
    }
    i = i + 1
  }
  ctr_es_join_comma(out)
}

/// `sig` is fn_sig_text's output; when a row is present it ALWAYS ends in
/// the exact suffix " with ROW" (see fn_sig_text above). Finds that
/// suffix, expands ROW's effectset-name tokens, and rebuilds the string. A
/// signature with no row, or one that doesn't match the expected suffix
/// shape, passes through completely unchanged (never corrupt a string this
/// pass doesn't recognize).
///
/// #1429: fn_sig_text's own row deliberately KEEPS the braced spelling even
/// though the language moved to `with A + B`. This string is an internal
/// comparison key -- declaration signature vs implementation signature --
/// that is never parsed back and never handed to a reader to copy, and the
/// braces now do real work: print_type_expr renders a PARAMETER's row
/// braceless, so `" with { "` matches the function's OWN row and nothing
/// else. Before the printer moved, a higher-order parameter carrying a row
/// rendered `" with E"` too and this index_of found the parameter's row
/// first -- a latent bug the braceless printer closed by accident. Spelling
/// this one braceless would reopen it.
fn ctr_expand_sig_row(sig: String, es_names: Array[String], es_members_list: Array[Array[String]]) -> String {
  if Array::length(es_names) == 0 {
    sig
  } else {
    let marker = " with { "
    let idx = String::index_of(sig, marker)
    if idx < 0 {
      sig
    } else {
      let slen = String::length(sig)
      let mlen = String::length(marker)
      if slen < idx + mlen + 2 {
        sig
      } else {
        let last_two = String::substring(sig, slen - 2, slen)
        if last_two != " }" {
          sig
        } else {
          let head = String::substring(sig, 0, idx)
          let row = String::substring(sig, idx + mlen, slen - 2)
          let expanded = ctr_es_expand_row_string(row, es_names, es_members_list)
          String::concat(head, String::concat(marker, String::concat(expanded, " }")))
        }
      }
    }
  }
}

/// Check that `impl_stmts` provide exactly the contract surface. Returns a
/// list of human-readable conformance errors; empty = conformant.
/// `contract_type_defs` (ADR-0071/#755): the CONTRACT's own classified type
/// definitions (classify_contract_stmts' second return value at the call
/// site) -- used only to build the effectset expansion table above, so a
/// contract signature spelled with an effectset alias and an
/// implementation spelled with its literal expansion compare as equal
/// instead of a false "signature mismatch".
export fn check_contract(decls: Array[(String, String)], opaque_names: Array[(String, Int)], impl_stmts: Array[Stmt], contract_type_defs: Array[Stmt]) -> Array[String] {
  let errors = array_empty()
  let (ctr_es_names, ctr_es_members_list) = ctr_es_collect_tables(contract_type_defs)
  let defs = collect_impl_fn_defs(impl_stmts)
  // #847: a re-exported name has no signature to compare (SReExport carries
  // no type info) — it is accepted at face value as satisfying a declared
  // fn or opaque type, same trust boundary the loader already gives a plain
  // `export ./impl.vibe { name }` line (the re-exported definition's OWN
  // package/contract is responsible for that definition's correctness).
  let reexported = collect_reexported_names(impl_stmts)
  let mut di = 0
  while di < Array::length(decls) {
    let (dname, dsig) = Array::get(decls, di)
    // ADR-0071 (#755): compare EXPANDED forms so a contract signature
    // spelled with an effectset alias matches an implementation spelled
    // with the literal operations it expands to (or vice versa) -- `dsig`
    // itself (used in error messages / satisfied tracking below) stays the
    // original, as-written text so a mismatch still quotes what the user
    // actually typed, not an internal normalized form.
    let dsig_expanded = ctr_expand_sig_row(dsig, ctr_es_names, ctr_es_members_list)
    // A declaration is satisfied by ANY exported def with a matching
    // signature. Same-name defs in OTHER package files (private aliases,
    // domain-local helpers) are legal and never violations by themselves —
    // only when NO def satisfies the decl do the candidates drive the
    // error message (best mismatch first, then export status).
    // Compiler-provided values may be explicitly exposed by a contract even
    // though no sibling implementation file owns their bodies.
    let mut satisfied = match lookup_registry_builtin(dname) {
      Some(_) => true,
      None => dname == "Int::to_string"
    }
    let mut seen_any = false
    let mut best_msg = ""
    let mut fi = 0
    while fi < Array::length(defs) {
      let (fname, fsig_opt, fexported) = Array::get(defs, fi)
      if fname == dname {
        seen_any = true
        match fsig_opt {
          Some(fsig) => if ctr_expand_sig_row(fsig, ctr_es_names, ctr_es_members_list) == dsig_expanded {
            if fexported {
              satisfied = true
            } else {
              best_msg = "contract declaration '\{dname}' is implemented but not exported by its implementation file"
            }
          } else {
            if best_msg == "" {
              best_msg = "signature mismatch for '\{dname}': contract \{dsig} but implementation \{fsig}"
            } else ()
          },
          None => if best_msg == "" {
            best_msg = "implementation of '\{dname}' lacks the full annotations required by the contract"
          } else ()
        }
      } else ()
      fi = fi + 1
    }
    if satisfied {
      ()
    } else if array_contains_string(reexported, dname) {
      ()
    } else if seen_any {
      Array::push(errors, best_msg)
    } else {
      Array::push(errors, "contract declaration '\{dname}' has no implementation")
    }
    di = di + 1
  }
  let mut ei = 0
  while ei < Array::length(defs) {
    let (fname, _fsig_opt, fexported) = Array::get(defs, ei)
    if fexported {
      let mut declared = false
      let mut ci = 0
      while ci < Array::length(decls) {
        let (dname, _dsig) = Array::get(decls, ci)
        if dname == fname {
          declared = true
        } else ()
        ci = ci + 1
      }
      if declared {
        ()
      } else {
        Array::push(errors, "exported '\{fname}' is not declared in the contract")
      }
    } else ()
    ei = ei + 1
  }
  let type_defs = collect_impl_type_defs(impl_stmts)
  let mut oi = 0
  while oi < Array::length(opaque_names) {
    let (oname, oarity) = Array::get(opaque_names, oi)
    // #847: same trust-at-face-value treatment as the fn-decl loop above —
    // a re-exported name has no arity to compare, so it satisfies an opaque
    // type declaration without an arity check (there is nothing to check).
    // Compiler-provided types likewise have no implementation sibling. The
    // contract declaration itself is the explicit package authority.
    let builtin_arity = if oname == "Option" {
      1
    } else {
      0
    }
    let mut ofound = array_contains_string(reexported, oname) || (match resolve_builtin(oname) {
      Some(_) => builtin_arity == oarity,
      None => oname == "Option" && oarity == 1
    })
    let mut ti = 0
    while ti < Array::length(type_defs) {
      let (tname, texported, tarity) = Array::get(type_defs, ti)
      if tname == oname {
        ofound = true
        if texported {
          ()
        } else {
          Array::push(errors, "opaque type '\{oname}' is implemented but not exported by its implementation file")
        }
        // #739: the contract's declared type-parameter count is part of the
        // surface — `type Box[T]` is not satisfied by a nullary `enum Box`.
        if tarity == oarity {
          ()
        } else {
          Array::push(errors, "type '\{oname}' arity mismatch: contract declares \{oarity} type parameter(s), implementation defines \{tarity}")
        }
      } else ()
      ti = ti + 1
    }
    if ofound {
      ()
    } else {
      Array::push(errors, "opaque type '\{oname}' has no implementation")
    }
    oi = oi + 1
  }
  let mut xi = 0
  while xi < Array::length(type_defs) {
    let (tname, texported, _) = Array::get(type_defs, xi)
    if texported {
      let mut tdeclared = false
      let mut oj = 0
      while oj < Array::length(opaque_names) {
        let (ojname, _) = Array::get(opaque_names, oj)
        if ojname == tname {
          tdeclared = true
        } else ()
        oj = oj + 1
      }
      if tdeclared {
        ()
      } else {
        Array::push(errors, "exported type '\{tname}' is not declared in the contract (declare it as `opaque type \{tname}` or define it transparently in the contract)")
      }
    } else ()
    xi = xi + 1
  }
  // #847: `collect_impl_fn_defs`/`collect_impl_type_defs` only see SLet/
  // SStruct/... top-level defs — an impl file that RE-exports a symbol
  // (`export ./other.vibe { extra }`) is neither, so its name was invisible
  // to every check above and could leak an undeclared symbol into the
  // package's real export surface. Require every re-exported name to match
  // either a declared fn or a declared opaque type.
  let mut rxi = 0
  while rxi < Array::length(reexported) {
    let exported_name = Array::get(reexported, rxi)
    let mut rdeclared = false
    let mut rdi = 0
    while rdi < Array::length(decls) {
      let (dname, _) = Array::get(decls, rdi)
      if dname == exported_name {
        rdeclared = true
      } else ()
      rdi = rdi + 1
    }
    if rdeclared {
      ()
    } else {
      let mut roi = 0
      while roi < Array::length(opaque_names) {
        let (oname, _) = Array::get(opaque_names, roi)
        if oname == exported_name {
          rdeclared = true
        } else ()
        roi = roi + 1
      }
    }
    if rdeclared {
      ()
    } else {
      Array::push(errors, "re-exported '\{exported_name}' is not declared in the contract")
    }
    rxi = rxi + 1
  }
  // #1879: a TRANSPARENT contract type (struct / enum / type alias) must not
  // be re-defined by an implementation file. The contract definition is the
  // single definition site (#1840's materialized types module); a sibling
  // re-definition compiles into a SECOND type identity whose enum ctor tags
  // disagree with the contract's, so matches fall through to a runtime trap
  // -- or silently take the wrong arm when tags happen to coincide -- with
  // no diagnostic anywhere. Reject it here, where both surfaces are in hand.
  // (An OPAQUE contract type is the inverse contract -- declared here,
  // defined by a sibling -- and stays untouched: contract_type_defs carries
  // only the transparent definitions.)
  let impl_type_defs = collect_impl_type_defs(impl_stmts)
  let tf_defs = contract_type_family_defs(contract_type_defs)
  let mut tfi = 0
  while tfi < Array::length(tf_defs) {
    let tf_name = match Array::get(tf_defs, tfi) {
      SStruct(_, sname, _, _, _, _) => sname,
      SEnum(_, ename, _, _, _) => ename,
      STypeAlias(_, aname, _, _) => aname,
      _ => ""
    }
    if tf_name == "" {
      ()
    } else {
      let mut iti = 0
      while iti < Array::length(impl_type_defs) {
        let (itname, _, _) = Array::get(impl_type_defs, iti)
        if itname == tf_name {
          Array::push(errors, "transparent contract type '\{tf_name}' is re-defined by an implementation file -- the contract definition is the single definition site; remove the local definition (a re-definition is a second runtime type identity, #1879)")
          iti = Array::length(impl_type_defs)
        } else {
          iti = iti + 1
        }
      }
    }
    tfi = tfi + 1
  }
  errors
}

/// Classify a contract's non-declaration statements: implementation-file
/// imports (`import ./impl.vibe {}`) and transparent type definitions
/// (struct / enum / type alias — the definition IS the contract, so it lives
/// here and passes into the facade verbatim, exported). Anything else is
/// rejected (subpath re-exports arrive with @scope resolution, #730).
export fn classify_contract_stmts(stmts: Array[Stmt]) -> (Array[String], Array[Stmt]) with Exception {
  let raws = array_empty()
  let type_defs = array_empty()
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SImport(raw_path, _) => Array::push(raws, raw_path),
      SStruct(_, name, fields, derives, mut_names, tparams) => Array::push(type_defs, SStruct(true, name, fields, derives, mut_names, tparams)),
      SEnum(_, name, tparams, ctors, derives) => Array::push(type_defs, SEnum(true, name, tparams, ctors, derives)),
      STypeAlias(_, name, tparams, ty) => Array::push(type_defs, STypeAlias(true, name, tparams, ty)),
      // #752: a transparent EFFECT definition — like transparent types, the
      // definition IS the contract (effect rows are core contract surface,
      // ADR-0063). It passes into the facade verbatim, exported; the
      // implementation files use the effect but must not re-define it.
      SEffectDef(_, ename, etparams, eops) => Array::push(type_defs, SEffectDef(true, ename, etparams, eops)),
      // ADR-0071 (#755) step 5: an `effectset` is likewise a transparent,
      // compile-time-only alias (no runtime identity of its own, same as
      // SEffectDef) -- the ADR's Decision section explicitly calls out
      // that it "は `index.vpkg` の contract symbol として import/export
      // できる". Passes into the facade verbatim, exported, same as
      // SEffectDef immediately above. The checker (checker_stmt.vibe)
      // still independently validates cycle/collision on every effectset
      // it type-checks, including ones that arrive via this contract path.
      SEffectSet(_, esname, esmembers) => Array::push(type_defs, SEffectSet(true, esname, esmembers)),
      // #729's original message said "a .vibei contract" -- this classifier
      // is shared plumbing for BOTH `index.vpkg` (ADR-0070's boundary file,
      // docs/module-system-oracle.md) and the legacy `index.vibei` spelling
      // (not itself a boundary; kept only during migration), invoked from
      // loader.vibe/header_cache.vibe regardless of which extension the
      // directory actually has. "contract file" avoids implying vpkg
      // callers hit vibei-specific rules.
      _ => throw("unsupported statement in a contract file (index.vpkg / index.vibei): only fn declarations, opaque type declarations, transparent type/effect/effectset definitions, and implementation-file imports are allowed (#729)")
    }
    i = i + 1
  }
  (raws, type_defs)
}

/// #2317: the declarations a contract EFFECTIVELY has, after the one filter
/// the loader applies before counting them.
///
/// A legacy bodyless `let version: String` is dropped when the header carries
/// a real `version` directive (#1054): the facade synthesizes that binding, so
/// demanding an implementation for it would be wrong. Without the directive it
/// is an ordinary declaration with a hand-written implementation and must stay.
///
/// This lived inline in `desugar_contract_source_fs`, which is why the buffer
/// lane could not reproduce it: any check counting raw declarations disagrees
/// with the build on exactly this shape. One function, both callers -- so a
/// filter added later cannot land in only one lane (#2317's whole point).
export fn contract_effective_decls(decls_raw: Array[(String, String)], pkg_version: String) -> Array[(String, String)] {
  let out = array_empty()
  let mut i = 0
  while i < Array::length(decls_raw) {
    let (dname, dsig) = Array::get(decls_raw, i)
    if dname == "version" && dsig == "val String" && pkg_version != "" {
      ()
    } else {
      Array::push(out, (dname, dsig))
    }
    i = i + 1
  }
  out
}

/// #2317: index of the first EFFECTIVE declaration whose name was already
/// declared, or -1.
///
/// Measured: the build refuses a duplicate today, but through
/// `contract_facade_source`, whose `allocated` list is set-like while `decls`
/// counts multiplicity -- so the count check trips and reports "some
/// declarations have no implementation file" about a name that is implemented.
/// The reader is handed an edit that does nothing. Deciding it here instead
/// lets both lanes say what is actually wrong.
///
/// Names only. Two declarations of one name are a duplicate whatever their
/// signatures: the facade allocates by name, so the second can never bind.
export fn contract_duplicate_decl_index(decls: Array[(String, String)]) -> Int {
  let mut i = 0
  let mut found = 0 - 1
  while i < Array::length(decls) && found < 0 {
    let (iname, _) = Array::get(decls, i)
    let mut j = 0
    while j < i && found < 0 {
      let (jname, _) = Array::get(decls, j)
      if jname == iname {
        found = i
      } else {
        j = j + 1
      }
    }
    i = i + 1
  }
  found
}

/// #2317: index of the first statement `classify_contract_stmts` rejects, or
/// -1 when it accepts them all.
///
/// It ASKS the classifier, one statement at a time, rather than mirroring its
/// match arms -- a second copy of the rule would drift the first time a
/// statement kind is added, and the classifier's own loop is per-statement
/// with no cross-statement state, so `classify_contract_stmts([s])` throws
/// exactly when `s` is the kind it refuses. Walking in order therefore finds
/// the same statement the full call stopped on.
///
/// Deliberately not a prefix search: three attempts in the #2315 review to
/// locate a diagnostic by probing growing prefixes each produced a predicate
/// that was not monotone, and binary search over one can anchor on valid code.
/// This asks about each statement on its own, so there is no predicate shape
/// to get wrong.
export fn contract_unsupported_stmt_index(stmts: Array[Stmt]) -> Int {
  let mut i = 0
  let mut found = 0 - 1
  while i < Array::length(stmts) && found < 0 {
    let one = array_empty()
    Array::push(one, Array::get(stmts, i))
    let bad = handle {
      let (_raws, _defs) = classify_contract_stmts(one)
      false
    } with { Exception::Throw(_) => true }
    if bad {
      found = i
    } else {
      i = i + 1
    }
  }
  found
}

/// Compat shim for the strict v1 shape (implementation imports only).
export fn contract_impl_import_raw_paths(stmts: Array[Stmt]) -> Array[String] with Exception {
  let (raws, _) = classify_contract_stmts(stmts)
  raws
}

/// #1840: the TYPE-FAMILY subset of a contract's transparent definitions
/// (struct / enum / type alias). These move out of the facade into a
/// materialized "types module" the loader writes under the build cache, so
/// sibling impl units can IMPORT them — which is what gives enum
/// constructors real value bindings in every lane (an enum living only in
/// the facade left siblings failing with `unknown name: <Ctor>`, and
/// re-defining it locally compiled into a second identity that trapped at
/// runtime, #1879). Effects / effectsets stay in the facade: their use
/// sites resolve through the row machinery, not through value names.
export fn contract_type_family_defs(type_defs: Array[Stmt]) -> Array[Stmt] {
  let out = array_empty()
  let mut i = 0
  while i < Array::length(type_defs) {
    let td = Array::get(type_defs, i)
    match td {
      SStruct(_, _, _, _, _, _) => Array::push(out, td),
      SEnum(_, _, _, _, _) => Array::push(out, td),
      STypeAlias(_, _, _, _) => Array::push(out, td),
      _ => ()
    }
    i = i + 1
  }
  out
}

/// #1840: idempotency marker for the materialized types module (mirrors
/// `contract_facade_marker` / `vpkg_shared_import_marker`).
export let vpkg_types_module_marker: String = "// vibe: vpkg contract types module (#1840)\n"

/// #2317: header prefix naming the contract a types module was generated from.
///
/// Carried IN-BAND, for the same reason the deferred-name sentinel is (#2125):
/// the value has to travel with the TEXT through every lane. A materialized
/// types module is checked in-process by the serial walk, but also by an
/// isolated worker under `VIBE_MODULE_JOB_DIR`, which is handed `source.vibe`
/// and its dependencies' environments and never runs the loader -- so any
/// process-local registry is empty there, and a diagnostic would name the
/// contract in one lane and the generated file in the other. Lanes disagreeing
/// about the same file is the bug #2317 is about; the fix must not add a new
/// instance of it (Codex review on #2324).
export let vpkg_types_contract_marker: String = "// vibe: generated from "

/// #2324: escape a contract path for the single-line `//` provenance marker.
///
/// A POSIX path may legally contain a newline. Concatenated raw, it would end
/// the comment and turn the remainder of the path into generated vibe source
/// -- the types module could then fail to parse, or take crafted path text as
/// declarations, and the reader would recover only the truncated prefix.
///
/// Backslash is escaped first so the decode is unambiguous.
///
/// Also the DISPLAY form for a path in a diagnostic (#2324): the CLI's contract
/// is one record per line, and a decoded newline rendered verbatim would split
/// one diagnostic across lines -- crafted path components could even resemble
/// further diagnostics. Round-tripping stays exact internally; only what is
/// printed is escaped.
export fn vpkg_path_escape_one_line(path: String) -> String {
  let sb = StringBuilder::new()
  let n = String::length(path)
  let mut i = 0
  while i < n {
    let c = String::char_code_at(path, i)
    if c == 92 {
      StringBuilder::push(sb, "\\\\")
    } else if c == 10 {
      StringBuilder::push(sb, "\\n")
    } else if c == 13 {
      StringBuilder::push(sb, "\\r")
    } else {
      StringBuilder::push(sb, String::substring(path, i, i + 1))
    }
    i = i + 1
  }
  StringBuilder::freeze(sb)
}

/// Inverse of `vpkg_path_escape_one_line`. An unrecognized escape is passed through
/// verbatim rather than dropped: a stub written by some other producer should
/// degrade to a wrong-looking path, never to a silently shortened one.
fn vpkg_marker_decode(text: String) -> String {
  let sb = StringBuilder::new()
  let n = String::length(text)
  let mut i = 0
  while i < n {
    let c = String::char_code_at(text, i)
    if c == 92 && i + 1 < n {
      let d = String::char_code_at(text, i + 1)
      if d == 110 {
        StringBuilder::push(sb, "\n")
        i = i + 2
      } else if d == 114 {
        StringBuilder::push(sb, "\r")
        i = i + 2
      } else if d == 92 {
        StringBuilder::push(sb, "\\")
        i = i + 2
      } else {
        StringBuilder::push(sb, String::substring(text, i, i + 1))
        i = i + 1
      }
    } else {
      StringBuilder::push(sb, String::substring(text, i, i + 1))
      i = i + 1
    }
  }
  StringBuilder::freeze(sb)
}

/// #2125: the type-name heads `tds` reference minus the names `tds` declare
/// -- the names this module can neither declare nor import: a
/// contract-`opaque` name whose definition lives in a sibling impl
/// (types -> impl would be an import cycle), or a name from another package.
/// Those resolve to the intentional bare `CtNamed` contract artifact.
///
/// This is textual, not provenance-checked, BY NECESSITY (Codex on #2162
/// asked for opaque/import provenance): contract conformance is textual and
/// a cross-package name has no declaration channel in the contract at all --
/// measured, `TypeEnv` in incremental's `ModuleJob` is spelled with no
/// `opaque` and no import anywhere in that index.vpkg. Compiler-owned type
/// heads (`Map`, `MutMap`, `Array`, ...) are not deferred: they go through
/// `is_builtin_type_name` (#2164). The residual is that a typo INSIDE a
/// contract's transparent type, or a genuine cross-package name, keeps its
/// pre-enforcement wildcard behavior; the sentinel enumerates that residual
/// greppably, and closing it needs a contract-level provenance declaration.
/// Returns (declared type names, deferred names). A declaration's own
/// generic binders shadow its references LOCALLY only (Codex round 3 on
/// #2162: a module-wide `declared` let `struct Box[Counter]`'s binder hide
/// `struct Holder`'s reference to the contract-`opaque` `Counter`, dropping
/// it from the sentinel and rejecting a valid contract).
fn ctm_deferred_type_names(tds: Array[Stmt]) -> (Array[String], Array[String]) {
  let declared = array_empty()
  let referenced = array_empty()
  let mut i = 0
  while i < Array::length(tds) {
    let scratch = array_empty()
    let binders = array_empty()
    match Array::get(tds, i) {
      SStruct(_, sname, fields, _, _, stp) => {
        Array::push(declared, sname)
        let mut ti = 0
        while ti < Array::length(stp) {
          Array::push(binders, Array::get(stp, ti))
          ti = ti + 1
        }
        let mut fi = 0
        while fi < Array::length(fields) {
          let (_, fte) = Array::get(fields, fi)
          ctm_collect_type_expr_heads(fte, scratch)
          fi = fi + 1
        }
      },
      SEnum(_, ename, eparams, variants, _) => {
        Array::push(declared, ename)
        let mut pi = 0
        while pi < Array::length(eparams) {
          Array::push(binders, Array::get(eparams, pi))
          pi = pi + 1
        }
        let mut vi = 0
        while vi < Array::length(variants) {
          let (_, vtypes) = Array::get(variants, vi)
          let mut vti = 0
          while vti < Array::length(vtypes) {
            ctm_collect_type_expr_heads(Array::get(vtypes, vti), scratch)
            vti = vti + 1
          }
          vi = vi + 1
        }
      },
      STypeAlias(_, aname, aparams, body) => {
        Array::push(declared, aname)
        let mut api = 0
        while api < Array::length(aparams) {
          Array::push(binders, Array::get(aparams, api))
          api = api + 1
        }
        ctm_collect_type_expr_heads(body, scratch)
      },
      _ => ()
    }
    let mut si = 0
    while si < Array::length(scratch) {
      let sn = Array::get(scratch, si)
      if ctm_str_list_has(binders, sn) {
        ()
      } else {
        Array::push(referenced, sn)
      }
      si = si + 1
    }
    i = i + 1
  }
  let out = array_empty()
  let mut ri = 0
  while ri < Array::length(referenced) {
    let n = Array::get(referenced, ri)
    if is_builtin_type_name(n) || ctm_str_list_has(declared, n) || ctm_str_list_has(out, n) {
      ()
    } else {
      Array::push(out, n)
    }
    ri = ri + 1
  }
  (declared, out)
}

fn ctm_collect_type_expr_heads(te: TypeExpr, out: Array[String]) -> Unit {
  match te {
    TyUnit => (),
    TyName(n) => Array::push(out, n),
    TyApp(n, args) => {
      Array::push(out, n)
      let mut i = 0
      while i < Array::length(args) {
        ctm_collect_type_expr_heads(Array::get(args, i), out)
        i = i + 1
      }
    },
    TyTuple(elems) => {
      let mut i = 0
      while i < Array::length(elems) {
        ctm_collect_type_expr_heads(Array::get(elems, i), out)
        i = i + 1
      }
    },
    TyFn(params, ret, _) => {
      let mut i = 0
      while i < Array::length(params) {
        ctm_collect_type_expr_heads(Array::get(params, i), out)
        i = i + 1
      }
      ctm_collect_type_expr_heads(ret, out)
    }
  }
}

fn ctm_str_list_has(items: Array[String], wanted: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(items) && !found {
    if Array::get(items, i) == wanted {
      found = true
    } else {
      i = i + 1
    }
  }
  found
}

/// #2125: the sentinel binding name prefix the checker's field/payload
/// unknown-type enforcement recognises (see checker_stmt's
/// `collect_deferred_type_name_sentinels`). Spelled here once; the checker
/// mirrors the spelling.
export let vpkg_deferred_type_names_prefix: String = "__vpkg_deferred_type_names_"

/// #1840: the materialized types module's source text — the contract's
/// type-family definitions verbatim (they are already exported by
/// `classify_contract_stmts`), behind the idempotency marker.
///
/// #2125: when the definitions reference names the module can neither declare
/// nor import, a sentinel `let <prefix><uniq>__: String = "N1 N2"` binding
/// carries them IN-BAND, so every lane that checks this text — per-module,
/// cached, or injected into a whole-program merge — exempts exactly those
/// names at field/payload positions without any process-lifetime registry.
/// `uniq` keeps the binding name collision-free when several contracts'
/// modules meet in one merge.
export fn contract_types_module_text(tds: Array[Stmt], uniq: String, contract_path: String) -> String {
  let lines = array_empty()
  Array::push(lines, vpkg_types_module_marker)
  // Provenance, so a process holding only this text can still name the
  // contract. Emitted even when empty so the header shape is uniform.
  Array::push(lines, String::concat(vpkg_types_contract_marker, vpkg_path_escape_one_line(contract_path)))
  let (decl_names, deferred) = ctm_deferred_type_names(tds)
  if Array::length(deferred) == 0 {
    ()
  } else {
    // `<declared> : <deferred>` -- the checker scopes the exemption to the
    // declarations named BEFORE the `:` (Codex round 3 on #2162: in a
    // whole-program merge an unscoped sentinel would excuse an unrelated
    // declaration that misspelled or forgot to import one of these names).
    Array::push(lines, "let \{vpkg_deferred_type_names_prefix}\{uniq}__: String = \"\{String::join(decl_names, " ")} : \{String::join(deferred, " ")}\"\n")
  }
  let mut i = 0
  while i < Array::length(tds) {
    Array::push(lines, print_stmt(Array::get(tds, i)))
    i = i + 1
  }
  String::concat(String::join(lines, "\n"), "\n")
}

/// #2317: the contract a materialized types module was generated from, read
/// from the module's OWN text, or "" when the marker is absent.
///
/// Text, not a registry: this has to answer the same way in the isolated
/// worker lane, which never runs the loader. "" when absent, so a stub
/// generated before this marker existed keeps the caller's fallback rather
/// than producing a guess.
export fn vpkg_types_contract_of_source(source: String) -> String {
  let lines = String::split(source, "\n")
  let n = Array::length(lines)
  let mut i = 0
  let mut found = ""
  while i < n && found == "" {
    let line = Array::get(lines, i)
    if String::starts_with(line, vpkg_types_contract_marker) {
      let raw = String::substring(line, String::length(vpkg_types_contract_marker), String::length(line))
      // Verbatim, except a trailing CR. The marker is written with no padding,
      // so trimming can only corrupt: a directory name may legally begin with
      // a space, and the diagnostic would then name a file that does not exist
      // (Codex review on #2324). The CR is the one exception -- splitting on
      // "\n" leaves it on a CRLF file, and a CR inside the path is just as
      // wrong as a lost space.
      let raw_len = String::length(raw)
      // Strip a trailing CR before decoding: the writer ESCAPES a real CR, so
      // a literal one here can only have come from a CRLF line ending.
      let line_body = if raw_len > 0 && String::char_code_at(raw, raw_len - 1) == 13 {
        String::substring(raw, 0, raw_len - 1)
      } else {
        raw
      }
      found = vpkg_marker_decode(line_body)
    } else {
      ()
    }
    i = i + 1
  }
  found
}

/// #1840: the `type <Name>` item list for importing / re-exporting the
/// materialized types module (a `type` import binds the typedef AND, for an
/// enum, its constructors — both bare and `Enum::Ctor`-qualified).
export fn contract_types_item_names(tds: Array[Stmt]) -> Array[String] {
  let out = array_empty()
  let mut i = 0
  while i < Array::length(tds) {
    match Array::get(tds, i) {
      // This line is a compiler-owned carrier for already-checked transparent
      // declarations, not a user's kind-qualified import claim. Keep it bare
      // so parsing records ImportItem.kind=None; `type` would falsely assert
      // that structs/enums are aliases under import-kind Phase 1.
      SStruct(_, name, _, _, _, _) => Array::push(out, name),
      SEnum(_, name, _, _, _) => Array::push(out, name),
      STypeAlias(_, name, _, _) => Array::push(out, name),
      _ => ()
    }
    i = i + 1
  }
  out
}

/// #1840: one source line importing (keyword `import`) or re-exporting
/// (keyword `export`) the materialized types module.
export fn contract_types_module_line(keyword: String, types_path: String, tds: Array[Stmt]) -> String {
  let items = contract_types_item_names(tds)
  String::concat(keyword, String::concat(" ", String::concat(types_path, String::concat(" { ", String::concat(String::join(items, ", "), " }\n")))))
}

/// #897 (ADR-0070 Phase 1): does every item of a qualified `import <path> as
/// <mod> only { x, y }` import get its dot-joined "mod.x" alias (parser.vibe's
/// `qualify_import_items`)? Real identifiers can never contain '.', so a "."
/// inside an item's alias is conclusive proof the import was written in the
/// namespaced `as ... only` form, not the unqualified `import <path> { x, y }`
/// form this module's directory-shared-scope feature applies to. Only the
/// unqualified form is shared with sibling impl files -- the namespaced form's
/// whole point is to keep `mod.x` the ONLY way in, so propagating it verbatim
/// would defeat that.
fn import_items_are_dot_qualified(items: Array[ImportItem]) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(items) && !found {
    let alias = Array::get(items, i).alias
    match alias {
      Some(a) => if String::index_of(a, ".") >= 0 {
        found = true
      } else {
        ()
      },
      None => ()
    }
    i = i + 1
  }
  found
}

/// #897 (ADR-0070 Phase 1): a `.vpkg` contract's own UNQUALIFIED external
/// dependency imports (`import @user/mod { x, y }`) -- the ones ADR-0070
/// says register `x`/`y` into the package directory's SHARED scope, so any
/// sibling `.vibe` implementation file can use them without its own import
/// line. Scans the same non-declaration statement list `classify_contract_stmts`
/// does (a contract's `extra`, pre-classification), but keeps the full
/// `SImport` node (raw path + item names/aliases) instead of collapsing to a
/// bare path string, and keeps only `@`-prefixed imports whose items are NOT
/// namespace-qualified (see `import_items_are_dot_qualified`). Relative
/// impl-file imports (`import ./impl.vibe {}`) and the namespaced `as mod
/// only` form are excluded -- neither participates in directory-shared scope.
export fn contract_directory_shared_imports(stmts: Array[Stmt]) -> Array[Stmt] {
  let out = array_empty()
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SImport(raw_path, items) =>
      if String::starts_with(raw_path, "@") && !import_items_are_dot_qualified(items) {
        Array::push(out, SImport(raw_path, items))
      } else {
        ()
      },
      _ => ()
    }
    i = i + 1
  }
  out
}

/// #897: render a `.vpkg` contract's directory-shared imports (see
/// `contract_directory_shared_imports`) as literal `import ...` source lines,
/// one per statement, each newline-terminated -- ready to PREPEND verbatim to
/// a qualifying sibling `.vibe` file's own source text so every existing
/// import-processing code path (checker env-binding, whole-program merge
/// rename/alias-rewrite, header/dep extraction) sees the inherited import
/// exactly as if the sibling had written it itself. `print_stmt` round-trips
/// `SImport` back to valid `import <path> { name [as alias], ... }` syntax
/// (parser.vibe/printer.vibe), so this needs no bespoke formatting. Empty
/// input -> "" (nothing to prepend).
export fn contract_directory_shared_import_prefix_text(stmts: Array[Stmt]) -> String {
  let shared = contract_directory_shared_imports(stmts)
  if Array::length(shared) == 0 {
    ""
  } else {
    let lines = array_empty()
    let mut i = 0
    while i < Array::length(shared) {
      Array::push(lines, print_stmt(Array::get(shared, i)))
      i = i + 1
    }
    String::concat(String::join(lines, "\n"), "\n")
  }
}

/// Desugar a conformance-checked contract to facade source text: one
/// `export <raw> { names }` re-export line per implementation file, each
/// declared name allocated to its first definer. The facade is plain vibe
/// source, so everything downstream of the loader (type db, merge plan,
/// codegen) needs no .vibei awareness — it rides the #716 re-export
/// machinery unchanged.
export fn contract_facade_source(decls: Array[(String, String)], opaque_names: Array[(String, Int)], type_defs: Array[Stmt], impl_units: Array[(String, Array[Stmt])], types_path: String) -> String with Exception {
  let lines = array_empty()
  // #1840: when the loader materialized a types module, the facade
  // RE-EXPORTS the type family from it instead of defining it verbatim —
  // the definitions must have exactly ONE site (a second identity for the
  // same enum traps at runtime, #1879), and that site must be importable by
  // sibling impl units (the facade is not: facade → impl would become a
  // cycle). Effects / effectsets / anything non-type-family stay verbatim.
  if types_path != "" {
    Array::push(lines, contract_types_module_line("export", types_path, type_defs))
  } else {
    ()
  }
  let mut tdi = 0
  while tdi < Array::length(type_defs) {
    let td = Array::get(type_defs, tdi)
    let in_types_module = if types_path == "" {
      false
    } else {
      match td {
        SStruct(_, _, _, _, _, _) => true,
        SEnum(_, _, _, _, _) => true,
        STypeAlias(_, _, _, _) => true,
        _ => false
      }
    }
    if in_types_module {
      ()
    } else {
      Array::push(lines, print_stmt(td))
    }
    tdi = tdi + 1
  }
  let allocated = array_empty()
  // Contract-declared compiler builtins have no implementation sibling. Keep
  // their authority explicit in the generated plain-vibe facade.
  let builtin_exports = array_empty()
  let mut boi = 0
  while boi < Array::length(opaque_names) {
    let (oname, oarity) = Array::get(opaque_names, boi)
    let expected_arity = if oname == "Option" {
      1
    } else {
      0
    }
    let is_builtin_type = match resolve_builtin(oname) {
      Some(_) => expected_arity == oarity,
      None => oname == "Option" && oarity == 1
    }
    if is_builtin_type {
      Array::push(builtin_exports, oname)
      Array::push(allocated, "type \{oname}")
    } else ()
    boi = boi + 1
  }
  let mut bdi = 0
  while bdi < Array::length(decls) {
    let (dname, _) = Array::get(decls, bdi)
    match lookup_registry_builtin(dname) {
      Some(_) => {
        Array::push(builtin_exports, dname)
        Array::push(allocated, dname)
      },
      None => if dname == "Int::to_string" {
        Array::push(builtin_exports, dname)
        Array::push(allocated, dname)
      } else ()
    }
    bdi = bdi + 1
  }
  if Array::length(builtin_exports) > 0 {
    Array::push(lines, "export { \{String::join(builtin_exports, ", ")} }")
  } else ()
  let mut ui = 0
  while ui < Array::length(impl_units) {
    let (raw, unit_stmts) = Array::get(impl_units, ui)
    let defs = collect_impl_fn_defs(unit_stmts)
    let unit_types = collect_impl_type_defs(unit_stmts)
    // #847: a unit may satisfy a declaration purely via `export ./other.vibe
    // { name }` (no direct SLet/SStruct/... def of its own) — `check_contract`
    // already accepts this (a re-export is trusted at face value, same as any
    // other impl declaration), so the facade must allocate it here too, or a
    // contract that relies on re-export throws "some declarations have no
    // implementation file" despite passing conformance.
    let unit_reexported = collect_reexported_names(unit_stmts)
    let names = array_empty()
    let mut oi = 0
    while oi < Array::length(opaque_names) {
      let (oname, _) = Array::get(opaque_names, oi)
      let mut otaken = false
      let mut oai = 0
      while oai < Array::length(allocated) {
        if Array::get(allocated, oai) == "type \{oname}" {
          otaken = true
        } else ()
        oai = oai + 1
      }
      if otaken {
        ()
      } else {
        let mut here = array_contains_string(unit_reexported, oname)
        let mut uti = 0
        while uti < Array::length(unit_types) {
          let (tname, _, _) = Array::get(unit_types, uti)
          if tname == oname {
            here = true
          } else ()
          uti = uti + 1
        }
        if here {
          // Generated facade carrier: this does not assert that the opaque
          // implementation is a type alias (it may be a struct or enum).
          // Keep the import item bare so Phase 1 records kind=None.
          Array::push(names, oname)
          Array::push(allocated, "type \{oname}")
        } else ()
      }
      oi = oi + 1
    }
    let mut di = 0
    while di < Array::length(decls) {
      let (dname, _) = Array::get(decls, di)
      let mut taken = false
      let mut ai = 0
      while ai < Array::length(allocated) {
        if Array::get(allocated, ai) == dname {
          taken = true
        } else ()
        ai = ai + 1
      }
      if taken {
        ()
      } else {
        let mut defined_here = array_contains_string(unit_reexported, dname)
        let mut fi = 0
        while fi < Array::length(defs) {
          let (fname, _, fexp) = Array::get(defs, fi)
          if fname == dname && fexp {
            defined_here = true
          } else ()
          fi = fi + 1
        }
        if defined_here {
          Array::push(names, dname)
          Array::push(allocated, dname)
        } else ()
      }
      di = di + 1
    }
    if Array::length(names) > 0 {
      Array::push(lines, "export \{raw} { \{String::join(names, ", ")} }")
    } else {
      // #753: an impl unit with no allocated names must STILL appear in the
      // facade. A facade with no import/export lines re-header-parses (the
      // type_db lane re-reads collected sources under the .vibei path) to
      // ZERO impl imports, which triggers sibling auto-discovery and pulls
      // test files beside the package into its dep set — an `import .` test
      // then manufactures "type_db: import cycle detected". Zero-name impl
      // units are real for all-transparent-type packages (@vibe/ast).
      Array::push(lines, "import \{raw} {}")
    }
    ui = ui + 1
  }
  if Array::length(allocated) != Array::length(decls) + Array::length(opaque_names) {
    throw("contract facade: some declarations have no implementation file (run check_contract first)")
  } else ()
  String::concat(String::join(lines, "\n"), "\n")
}

// ADR-0063 §5 (#730): content addressing. Two hashes identify a package:
//
// - contract_hash — the API surface only (fn signatures, opaque names,
//   transparent type definitions), independent of implementation text.
//   The API-compatibility signal and the dependents' recheck cache key.
// - package_hash — the merkle over the package's normalized (path, source)
//   pairs. Paths must be PACKAGE-RELATIVE (the contract as "index.vibei",
//   impls by their raw import spelling) so the hash is location-independent.
//   Since require/import lines are part of the hashed file contents, pinning
//   a package hash transitively fixes its dependency choices.
//
// Format: `ct:sha1:<40hex>` / `pkg:sha1:<40hex>` (SHA1 per ADR-0004; the
// scheme prefix leaves room for a stronger digest without ambiguity).

/// Normalized lexical comparison behind typed String parameters. The helper
/// boundary is required for Array::get-sourced operands (#1184).
fn contract_str_compare(a: String, b: String) -> Int {
  if a < b {
    -1
  } else if a > b {
    1
  } else {
    0
  }
}

fn sorted_strings(items: Array[String]) -> Array[String] {
  let out = array_empty()
  let mut i = 0
  while i < Array::length(items) {
    Array::push(out, Array::get(items, i))
    i = i + 1
  }
  let n = Array::length(out)
  let mut a = 0
  while a < n {
    let mut b = a + 1
    let mut min_i = a
    while b < n {
      let x = Array::get(out, b)
      let y = Array::get(out, min_i)
      if contract_str_compare(x, y) < 0 {
        min_i = b
      } else ()
      b = b + 1
    }
    if min_i != a {
      let tmp = Array::get(out, a)
      Array::set(out, a, Array::get(out, min_i))
      Array::set(out, min_i, tmp)
    } else ()
    a = a + 1
  }
  out
}

export fn contract_hash(fn_decls: Array[(String, String)], opaque_names: Array[(String, Int)], type_defs: Array[Stmt]) -> String {
  let canon = String::join(sorted_strings(contract_surface_lines(fn_decls, opaque_names, type_defs)), "\n")
  "ct:sha1:\{sha1(String::concat("vibei:v1\n", canon))}"
}

export fn package_hash_from_sources(sources: Array[(String, String)]) -> String {
  let keys = array_empty()
  let mut i = 0
  while i < Array::length(sources) {
    let (path, _) = Array::get(sources, i)
    Array::push(keys, path)
    i = i + 1
  }
  let ordered = sorted_strings(keys)
  let sb = StringBuilder::new()
  StringBuilder::push(sb, "vibe-pkg:v1\n")
  let mut ki = 0
  while ki < Array::length(ordered) {
    let key = Array::get(ordered, ki)
    let mut si = 0
    while si < Array::length(sources) {
      let (path, text) = Array::get(sources, si)
      if path == key {
        StringBuilder::push(sb, "file \{path} \{String::length(text)}\n")
        StringBuilder::push(sb, text)
        StringBuilder::push(sb, "\n")
        si = Array::length(sources)
      } else {
        si = si + 1
      }
    }
    ki = ki + 1
  }
  "pkg:sha1:\{sha1(StringBuilder::freeze(sb))}"
}

// ADR-0063 §6 (#730 D-2): `require` pin lines. A directive, not statement
// grammar: `require @scope/name 1.2.3 = #pkg:sha1:<40hex>` lines sit at the
// top of a file (blank lines / line comments may precede). The loader
// extracts them BEFORE parsing and blanks them to spaces, so byte offsets —
// and therefore diagnostics — are preserved (same philosophy as #cfg's
// tail-append). semver is strict: bare x.y.z or ^x.y.z, full triple only.
// The constraint is edit-time tooling metadata; the build consumes only the
// hash. The unpinned 3-field form is accepted at parse so `vibe fmt` can
// complete it offline from the workspace store (D-3, fill_require_pins_lenient
// in loader/loader.vibe); the BUILD still refuses to resolve an unpinned
// package (hash-only, resolver-free).
//
// #1128: the leading directive region additionally carries the package
// HEADER itself (`index.vpkg` only, though nothing here special-cases the
// file extension -- any file's leading region may carry these same
// directives, exactly as `version` always could):
//
//   name = @scope/pkg
//   version = x.y.z
//   main = true            (optional; parsed only, no compiler behavior
//                            yet -- reserved, #1128)
//   description =
//     #|line one
//     #|line two
//   deps = {
//     @scope/pkg2 : x.y.z
//   }
//   generated_hash = <#pkg:sha1:<40hex> or empty until computed>
//
// `version = x.y.z` (with `=`) is the PREFERRED spelling going forward, but
// the old bare `version x.y.z` (ADR-0065/#754) is still accepted, NOT an
// error -- see the `version` branch below for why (short version: the
// bootstrap seed that builds the compiler itself only understands the old
// spelling, and `lib/@vibe/compiler/**` plus its direct dependency closure
// stay on it until a dedicated bootstrap-bump migrates them). Every OTHER
// package in the repo has been migrated to the new header (name/version=/
// description/deps/generated_hash). None of the header fields (including
// `name`/`version`/`description`, "required" per the #1128 convention) are
// hard-enforced by this scanner or by the loader -- doing so would also
// reject the handful of `fixtures/contract_*` test packages that
// deliberately carry a minimal or absent header to exercise the
// conformance engine in isolation. This scanner accepts a header with any
// subset of fields present (including none at all), since it also runs
// over plain consumer files that carry only `require` lines.
// `description`'s `#|` continuation lines reuse the language's own `#|`
// multi-line string alignment rule (#854): every continuation line's `#|`
// must sit at the same column as the block's first, or it's a located
// error. `deps` declares this package's OWN external version constraints
// -- `import @scope/pkg { names }` elsewhere remains pure name resolution
// (never carries a version); `deps` is the single authoritative place a
// package states what it needs and at what version, deliberately separate
// from name resolution so the two can't silently drift into two competing
// sources of truth. Cross-checking `deps` against a package's actual
// `import` statements (catching an undeclared external dependency) is
// deliberately NOT wired into the live loader here -- see
// `deps_missing_for_imports` below, a standalone checker a future gate can
// call once the shape has been exercised in practice. `generated_hash` is
// the package's own content hash (same `#pkg:sha1:<40hex>` shape a
// `require` pin already uses) -- left empty until a publish step computes
// and writes it back; this pass only parses it.

/// `@scope/name` or a nested `@scope/name/sub/...` (e.g. `@vibe/wasi/p3`,
/// `@vibe/compiler/runtime`) -- at least two `/`-separated segments, not
/// exactly two, and every segment (including the `@scope` head) non-empty:
/// rejects `@/pkg`, `@scope/`, `@scope//pkg`.
fn is_package_name(n: String) -> Bool {
  if !String::starts_with(n, "@") {
    false
  } else {
    let segs = String::split(n, "/")
    if Array::length(segs) < 2 || String::length(Array::get(segs, 0)) <= 1 {
      false
    } else {
      let mut i = 1
      let mut ok = true
      while i < Array::length(segs) {
        if String::length(Array::get(segs, i)) == 0 {
          ok = false
        }
        i = i + 1
      }
      ok
    }
  }
}

/// N spaces, same length as `s` -- used to blank a directive line to spaces
/// while preserving byte length (so downstream offsets never shift).
fn blank_of(s: String) -> String {
  let sb = StringBuilder::new()
  let mut i = 0
  while i < String::length(s) {
    StringBuilder::push(sb, " ")
    i = i + 1
  }
  StringBuilder::freeze(sb)
}

/// Parses one `@scope/pkg : x.y.z` deps entry (already trimmed).
fn parse_deps_entry(trimmed: String) -> (String, String) with Exception {
  let parts = String::split(trimmed, ":")
  if Array::length(parts) != 2 {
    throw("malformed deps entry (expected: @scope/pkg : x.y.z): \{trimmed}")
  } else ()
  let dname = String::trim(Array::get(parts, 0))
  let dver = String::trim(Array::get(parts, 1))
  if !is_package_name(dname) {
    throw("deps package name must be @scope/name: \{trimmed}")
  } else ()
  if !is_strict_semver(dver) {
    throw("deps version must be a strict semver triple (x.y.z): \{trimmed}")
  } else ()
  (dname, dver)
}

/// Consume `description =`'s `#|` continuation lines starting at `start`
/// (just past the `description =` line's own newline). Returns (joined
/// description text, position just past the last consumed line, the
/// blanked+newline-preserving text for those consumed lines). Stops at the
/// first line that is not a `#|` line at the established column -- that
/// line is NOT consumed here (the outer scanner sees it fresh).
fn consume_description_block(source: String, len: Int, start: Int) -> (String, Int, String) with Exception {
  let parts = array_empty()
  let sb = StringBuilder::new()
  let mut pos = start
  let mut col = -1
  let mut cont = true
  while cont && pos < len {
    let mut nl = pos
    while nl < len && String::char_code_at(source, nl) != 10 {
      nl = nl + 1
    }
    let dline = String::substring(source, pos, nl)
    let mut j = 0
    while j < String::length(dline) && (String::char_code_at(dline, j) == ' ' || String::char_code_at(dline, j) == '\t') {
      j = j + 1
    }
    let is_bar = j + 1 < String::length(dline) && String::char_code_at(dline, j) == '#' && String::char_code_at(dline, j + 1) == '|'
    if is_bar {
      if col < 0 {
        col = j
      } else if j != col {
        throw("description #| continuation must be indented to column \{__to_string(col + 1)}: \{dline}")
      } else ()
      Array::push(parts, String::substring(dline, j + 2, String::length(dline)))
      StringBuilder::push(sb, blank_of(dline))
      if nl < len {
        StringBuilder::push(sb, "\n")
      } else ()
      pos = nl + 1
    } else {
      cont = false
    }
  }
  (String::join(parts, "\n"), pos, StringBuilder::freeze(sb))
}

/// Consume a `deps = {` block starting at `start` (just past that line's own
/// newline), through and including the line that is exactly `}`. Returns
/// (entries, position just past the closing `}` line, blanked text).
fn consume_deps_block(source: String, len: Int, start: Int) -> (Array[(String, String)], Int, String) with Exception {
  let entries = array_empty()
  let sb = StringBuilder::new()
  let mut pos = start
  let mut closed = false
  while !closed && pos < len {
    let mut nl = pos
    while nl < len && String::char_code_at(source, nl) != 10 {
      nl = nl + 1
    }
    let dline = String::substring(source, pos, nl)
    let dtrimmed = String::trim(dline)
    if dtrimmed == "}" {
      StringBuilder::push(sb, blank_of(dline))
      closed = true
    } else if String::length(dtrimmed) == 0 {
      StringBuilder::push(sb, dline)
    } else {
      let (dname, dver) = parse_deps_entry(dtrimmed)
      Array::push(entries, (dname, dver))
      StringBuilder::push(sb, blank_of(dline))
    }
    if nl < len {
      StringBuilder::push(sb, "\n")
    } else ()
    pos = nl + 1
  }
  if !closed {
    throw("unterminated deps block (missing closing '}')")
  } else ()
  (entries, pos, StringBuilder::freeze(sb))
}

fn is_digit_run(s: String, from: Int, to: Int) -> Bool {
  if to <= from {
    false
  } else {
    let mut i = from
    let mut ok = true
    while i < to {
      let c = String::char_code_at(s, i)
      if c < '0' || c > '9' {
        ok = false
        i = to
      } else {
        i = i + 1
      }
    }
    ok
  }
}

export fn is_strict_semver(v: String) -> Bool {
  let start = if String::starts_with(v, "^") {
    1
  } else 0
  let body = String::substring(v, start, String::length(v))
  let parts = String::split(body, ".")
  if Array::length(parts) != 3 {
    false
  } else {
    let a = Array::get(parts, 0)
    let b = Array::get(parts, 1)
    let c = Array::get(parts, 2)
    is_digit_run(a, 0, String::length(a)) && is_digit_run(b, 0, String::length(b)) && is_digit_run(c, 0, String::length(c))
  }
}

export fn is_package_pin(h: String) -> Bool {
  if !String::starts_with(h, "#pkg:sha1:") {
    false
  } else if String::length(h) != 50 {
    false
  } else {
    let mut i = 10
    let mut ok = true
    while i < 50 {
      let c = String::char_code_at(h, i)
      let is_hex = (c >= '0' && c <= '9') || (c >= 'a' && c <= 'f')
      if is_hex {
        i = i + 1
      } else {
        ok = false
        i = 50
      }
    }
    ok
  }
}

fn split_fields(line: String) -> Array[String] {
  let raw = String::split(String::trim(line), " ")
  let out = array_empty()
  let mut i = 0
  while i < Array::length(raw) {
    let f = Array::get(raw, i)
    if String::length(f) > 0 {
      Array::push(out, f)
    } else ()
    i = i + 1
  }
  out
}

/// Returns ((name, constraint, pin) triples, source with require lines
/// blanked to spaces). Only the leading directive region is scanned; a
/// `require` line after the first ordinary statement is a parse error
/// downstream (it never parses as a statement), which is intended.
/// #754 (ADR-0065): the leading region may also carry ONE `version x.y.z`
/// directive — the PACKAGE-side version declaration. It is validated and
/// blanked here (so every parse lane tolerates it) and read back with
/// extract_package_version below. The raw line stays in the file text, so it
/// is part of the package hash by construction: a version change is a new
/// artifact, and version->hash immutability is checkable.
fn scan_package_header(source: String) -> (Array[(String, String, String)], String, String, Bool, String, Array[(String, String)], String, String) with Exception {
  let pins = array_empty()
  let deps = array_empty()
  let sb = StringBuilder::new()
  let len = String::length(source)
  let mut pos = 0
  let mut scanning = true
  let mut name = ""
  let mut version = ""
  let mut main = false
  let mut description = ""
  let mut generated_hash = ""
  let mut seen_name = false
  let mut seen_version = false
  let mut seen_main = false
  let mut seen_description = false
  let mut seen_deps = false
  let mut seen_hash = false
  while pos < len {
    let mut nl = pos
    while nl < len && String::char_code_at(source, nl) != 10 {
      nl = nl + 1
    }
    let line = String::substring(source, pos, nl)
    let trimmed = String::trim(line)
    let mut next_pos = nl + 1
    if !scanning {
      StringBuilder::push(sb, line)
    } else if String::starts_with(trimmed, "version =") {
      if seen_version {
        throw("duplicate version directive: \{trimmed}")
      } else ()
      let v = String::trim(String::substring(trimmed, 9, String::length(trimmed)))
      if String::starts_with(v, "^") || !is_strict_semver(v) {
        throw("version directive must be an exact semver triple (x.y.z): \{trimmed}")
      } else ()
      version = v
      seen_version = true
      StringBuilder::push(sb, blank_of(line))
    } else if String::starts_with(trimmed, "version ") {
      // Legacy bare `version x.y.z` (ADR-0065/#754), pre-#1128. Still
      // accepted, NOT an error: the compiler's own `lib/@vibe/compiler/**`
      // packages (plus their direct dependency closure -- @vibe/ast,
      // @vibe/cache, @vibe/core, @vibe/json, @vibe/module,
      // @vibe/parser, @vibe/builtin) are read by the bootstrap seed while
      // building the compiler itself (scripts/generate_bundle.sh's
      // merge-flatten step); the frozen seed predates #1128 and understands
      // only this spelling. Migrating those packages to `version = x.y.z`
      // (or any other new #1128 directive) requires a dedicated
      // bootstrap-bump cycle first (docs/bootstrap.md) -- out of scope here.
      // New/non-bootstrap packages should prefer `version = x.y.z`.
      let vfields = split_fields(trimmed)
      if Array::length(vfields) != 2 {
        throw("malformed version directive (expected: version x.y.z): \{trimmed}")
      } else ()
      let v = Array::get(vfields, 1)
      if String::starts_with(v, "^") || !is_strict_semver(v) {
        throw("version directive must be an exact semver triple (x.y.z): \{trimmed}")
      } else ()
      if seen_version {
        throw("duplicate version directive: \{trimmed}")
      } else ()
      version = v
      seen_version = true
      StringBuilder::push(sb, blank_of(line))
    } else if String::starts_with(trimmed, "name =") {
      if seen_name {
        throw("duplicate name directive: \{trimmed}")
      } else ()
      let n = String::trim(String::substring(trimmed, 6, String::length(trimmed)))
      if !is_package_name(n) {
        throw("name directive must be @scope/name: \{trimmed}")
      } else ()
      name = n
      seen_name = true
      StringBuilder::push(sb, blank_of(line))
    } else if String::starts_with(trimmed, "main =") {
      if seen_main {
        throw("duplicate main directive: \{trimmed}")
      } else ()
      let m = String::trim(String::substring(trimmed, 6, String::length(trimmed)))
      if m == "true" {
        main = true
      } else if m == "false" {
        main = false
      } else {
        throw("main directive must be true or false: \{trimmed}")
      }
      seen_main = true
      StringBuilder::push(sb, blank_of(line))
    } else if String::starts_with(trimmed, "generated_hash =") {
      if seen_hash {
        throw("duplicate generated_hash directive: \{trimmed}")
      } else ()
      let gh = String::trim(String::substring(trimmed, 17, String::length(trimmed)))
      if (String::length(gh) > 0) && !is_package_pin(gh) {
        throw("generated_hash must be empty or #pkg:sha1:<40hex>: \{trimmed}")
      } else ()
      generated_hash = gh
      seen_hash = true
      StringBuilder::push(sb, blank_of(line))
    } else if trimmed == "description =" {
      if seen_description {
        throw("duplicate description directive: \{trimmed}")
      } else ()
      StringBuilder::push(sb, blank_of(line))
      let (dtext, dpos, dblanked) = consume_description_block(source, len, nl + 1)
      description = dtext
      seen_description = true
      StringBuilder::push(sb, dblanked)
      next_pos = dpos
    } else if trimmed == "deps = {}" {
      if seen_deps {
        throw("duplicate deps directive: \{trimmed}")
      } else ()
      seen_deps = true
      StringBuilder::push(sb, blank_of(line))
    } else if trimmed == "deps = {" {
      if seen_deps {
        throw("duplicate deps directive: \{trimmed}")
      } else ()
      StringBuilder::push(sb, blank_of(line))
      let (dentries, dpos, dblanked) = consume_deps_block(source, len, nl + 1)
      deps_extend(deps, dentries)
      seen_deps = true
      StringBuilder::push(sb, dblanked)
      next_pos = dpos
    } else if String::starts_with(trimmed, "require ") {
      let fields = split_fields(trimmed)
      let nfields = Array::length(fields)
      if nfields != 5 && nfields != 3 {
        throw("malformed require line (expected: require @scope/name x.y.z [= #pkg:sha1:<40hex>]): \{trimmed}")
      } else ()
      let rname = Array::get(fields, 1)
      let rver = Array::get(fields, 2)
      if !String::starts_with(rname, "@") {
        throw("require package name must start with '@': \{rname}")
      } else ()
      if !is_strict_semver(rver) {
        throw("require version must be a strict semver triple (x.y.z or ^x.y.z): \{rver}")
      } else ()
      // Unpinned (3-field) form: accepted at parse so `vibe fmt` can fill
      // the pin offline from the store (D-3); the BUILD still refuses to
      // resolve an unpinned package (hash-only, resolver-free).
      let pin_hash = if nfields == 5 {
        let eq = Array::get(fields, 3)
        let pin = Array::get(fields, 4)
        if eq == "=" {
          ()
        } else {
          throw("malformed require line (missing '='): \{trimmed}")
        }
        if !is_package_pin(pin) {
          throw("require pin must be #pkg:sha1:<40hex> (compute with `vibe hash`): \{pin}")
        } else ()
        String::substring(pin, 1, String::length(pin))
      } else {
        ""
      }
      Array::push(pins, (rname, rver, pin_hash))
      StringBuilder::push(sb, blank_of(line))
    } else if String::length(trimmed) == 0 || String::starts_with(trimmed, "//") {
      StringBuilder::push(sb, line)
    } else {
      scanning = false
      StringBuilder::push(sb, line)
    }
    if nl < len {
      StringBuilder::push(sb, "\n")
    } else ()
    pos = next_pos
  }
  (pins, name, version, main, description, deps, generated_hash, StringBuilder::freeze(sb))
}

fn deps_extend(deps: Array[(String, String)], more: Array[(String, String)]) -> Unit {
  let mut i = 0
  while i < Array::length(more) {
    Array::push(deps, Array::get(more, i))
    i = i + 1
  }
}

/// ADR-0063 §6 (#730 D-2) / #1128: (name, constraint, pin) triples for every
/// `require` line, plus the source with EVERY recognized leading directive
/// (require, version, name, main, description, deps, generated_hash) blanked
/// to spaces (byte length preserved, so downstream offsets never shift).
export fn extract_require_pins(source: String) -> (Array[(String, String, String)], String) with Exception {
  let (pins, _name, _version, _main, _description, _deps, _hash, blanked) = scan_package_header(source)
  (pins, blanked)
}

/// #754/#1128: read the `version = x.y.z` directive ("" when absent).
export fn extract_package_version(source: String) -> String with Exception {
  let (_pins, _name, version, _main, _description, _deps, _hash, _blanked) = scan_package_header(source)
  version
}

/// #1128: read the `name = @scope/pkg` directive ("" when absent).
export fn extract_package_name(source: String) -> String with Exception {
  let (_pins, name, _version, _main, _description, _deps, _hash, _blanked) = scan_package_header(source)
  name
}

/// #1128: read the `main = true|false` directive (false when absent —
/// parsed only, no compiler behavior attached yet; see the header-scanner
/// doc comment above).
export fn extract_package_main(source: String) -> Bool with Exception {
  let (_pins, _name, _version, main, _description, _deps, _hash, _blanked) = scan_package_header(source)
  main
}

/// #1128: read the `description = \n  #|...` block, joined with "\n"
/// ("" when absent).
export fn extract_package_description(source: String) -> String with Exception {
  let (_pins, _name, _version, _main, description, _deps, _hash, _blanked) = scan_package_header(source)
  description
}

/// #1128: read the `deps = { @scope/pkg : x.y.z ... }` block (empty array
/// when absent).
export fn extract_package_deps(source: String) -> Array[(String, String)] with Exception {
  let (_pins, _name, _version, _main, _description, deps, _hash, _blanked) = scan_package_header(source)
  deps
}

/// #1128: read the `generated_hash = ...` directive ("" when absent or not
/// yet computed).
export fn extract_package_generated_hash(source: String) -> String with Exception {
  let (_pins, _name, _version, _main, _description, _deps, hash, _blanked) = scan_package_header(source)
  hash
}

/// #1145 follow-up 3: true when `source`'s leading directive region has a
/// `generated_hash = ` line at all (only #1128-migrated files do). Plain
/// existence check, never throws -- lets a caller decide whether to touch
/// the directive without first committing to `replace_generated_hash_directive`'s
/// throw-if-absent contract.
fn has_generated_hash_directive(source: String) -> Bool {
  let lines = String::split(source, "\n")
  let mut i = 0
  let mut found = false
  while i < Array::length(lines) && !found {
    if String::starts_with(String::trim(Array::get(lines, i)), "generated_hash =") {
      found = true
    } else {
      i = i + 1
    }
  }
  found
}

/// #1145 follow-up 3: blanks `source`'s `generated_hash = ` directive to
/// empty when present, unchanged otherwise. `generated_hash` stores this
/// package's own content hash -- feeding a stale value into the very
/// content being hashed would make the hash depend on hash-writing history
/// instead of on the file, so `contract_package_hashes_fs` runs every
/// `.vpkg` file through this before hashing (a no-op for the common case
/// where the directive is already empty, so `vibe hash`'s output for every
/// package migrated to #1128 with an unwritten hash is unaffected).
export fn canonicalize_for_hash(source: String) -> String with Exception {
  if has_generated_hash_directive(source) {
    replace_generated_hash_directive(source, "")
  } else {
    source
  }
}

/// #1145 follow-up 3: rewrites the `generated_hash = ` directive line to
/// `new_value` verbatim (no `#pkg:sha1:` validation here -- callers pass
/// either "" to canonicalize before hashing, or an already-computed pin).
/// Requires exactly one such line; `scan_package_header` already rejects a
/// file with more than one, and a file that predates the #1128 migration
/// (no `generated_hash = ` line at all) is rejected rather than silently
/// inserting one -- deciding WHERE to insert a missing directive is a
/// migration decision, not this tool's job.
export fn replace_generated_hash_directive(source: String, new_value: String) -> String with Exception {
  let lines = String::split(source, "\n")
  let out = array_empty()
  let mut i = 0
  let mut found = false
  while i < Array::length(lines) {
    let line = Array::get(lines, i)
    if (!found) && String::starts_with(String::trim(line), "generated_hash =") {
      found = true
      let replacement = if String::length(new_value) == 0 {
        "generated_hash ="
      } else {
        "generated_hash = \{new_value}"
      }
      Array::push(out, replacement)
    } else {
      Array::push(out, line)
    }
    i = i + 1
  }
  if !found {
    throw("no generated_hash directive found (this tool only rewrites #1128-migrated index.vpkg files)")
  } else ()
  String::join(out, "\n")
}

/// #1128: every external (`@scope/pkg`) name referenced by a NON-relative
/// `import` statement across `impl_sources`, that has no matching entry in
/// `deps`. A standalone checker, deliberately NOT wired into the live
/// loader path yet (see the header-scanner doc comment above) — exercise it
/// against the real package graph first, then decide where it gates.
/// `impl_sources` should be the package's own sibling implementation files
/// (not `deps`' OWN transitive dependencies — only this package's direct,
/// textually-visible imports matter here).
export fn deps_missing_for_imports(deps: Array[(String, String)], impl_sources: Array[String]) -> Array[String] {
  let missing = array_empty()
  let mut si = 0
  while si < Array::length(impl_sources) {
    let src = Array::get(impl_sources, si)
    let len = String::length(src)
    let mut pos = 0
    while pos < len {
      let mut nl = pos
      while nl < len && String::char_code_at(src, nl) != 10 {
        nl = nl + 1
      }
      let trimmed = String::trim(String::substring(src, pos, nl))
      if String::starts_with(trimmed, "import @") {
        let after = String::substring(trimmed, 7, String::length(trimmed))
        let mut ei = 0
        while ei < String::length(after) && String::char_code_at(after, ei) != ' ' {
          ei = ei + 1
        }
        let pkg = String::substring(after, 0, ei)
        let mut found = false
        let mut di = 0
        while di < Array::length(deps) {
          let (dname, _dver) = Array::get(deps, di)
          if dname == pkg {
            found = true
          } else ()
          di = di + 1
        }
        if !found && !str_in(missing, pkg) {
          Array::push(missing, pkg)
        } else ()
      } else ()
      pos = nl + 1
    }
    si = si + 1
  }
  missing
}

// ADR-0063 §8 (#732 Phase F): Elm-style machine-verified semver. The
// version bump a release CLAIMS must match what its contract diff REQUIRES:
//   patch — the API surface is unchanged (same fn decls, opaques, types)
//   minor — additions only (every old declaration survives verbatim)
//   major — anything else
// "semver is trusted" becomes a checkable property instead of a hope.

fn str_in(arr: Array[String], target: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(arr) && !found {
    if Array::get(arr, i) == target {
      found = true
    } else {
      i = i + 1
    }
  }
  found
}

/// Canonical per-declaration lines for a contract surface (shared by
/// contract_hash and the change classifier, so they can never disagree).
export fn contract_surface_lines(fn_decls: Array[(String, String)], opaque_names: Array[(String, Int)], type_defs: Array[Stmt]) -> Array[String] {
  let lines = array_empty()
  let mut i = 0
  while i < Array::length(fn_decls) {
    let (dname, dsig) = Array::get(fn_decls, i)
    Array::push(lines, "fn \{dname} \{dsig}")
    i = i + 1
  }
  let mut oi = 0
  while oi < Array::length(opaque_names) {
    let (oname, oarity) = Array::get(opaque_names, oi)
    // #739: arity is part of the surface — `Box` -> `Box[T]` must classify
    // as a MAJOR change. Zero-arity keeps the historical `opaque X` line so
    // existing contract hashes only move for parameterized types.
    let oline = if oarity == 0 {
      "opaque \{oname}"
    } else {
      "opaque \{oname}[\{oarity}]"
    }
    Array::push(lines, oline)
    oi = oi + 1
  }
  let mut ti = 0
  while ti < Array::length(type_defs) {
    Array::push(lines, "type \{print_stmt(Array::get(type_defs, ti))}")
    ti = ti + 1
  }
  lines
}

/// "patch" | "minor" | "major" for old -> new surface lines.
export fn classify_contract_change(old_lines: Array[String], new_lines: Array[String]) -> String {
  let mut all_old_kept = true
  let mut i = 0
  while i < Array::length(old_lines) {
    if str_in(new_lines, Array::get(old_lines, i)) {
      ()
    } else {
      all_old_kept = false
    }
    i = i + 1
  }
  if !all_old_kept {
    "major"
  } else {
    let mut any_new = false
    let mut j = 0
    while j < Array::length(new_lines) {
      if str_in(old_lines, Array::get(new_lines, j)) {
        ()
      } else {
        any_new = true
      }
      j = j + 1
    }
    if any_new {
      "minor"
    } else {
      "patch"
    }
  }
}

fn digits_to_int(raw: String) -> Int {
  let len = String::length(raw)
  let mut result = 0
  let mut i = 0
  while i < len {
    result = result * 10 + (String::char_code_at(raw, i) - 48)
    i = i + 1
  }
  result
}

export fn semver_parts(v: String) -> Option[(Int, Int, Int)] {
  if is_strict_semver(v) && !String::starts_with(v, "^") {
    let parts = String::split(v, ".")
    Some((digits_to_int(Array::get(parts, 0)), digits_to_int(Array::get(parts, 1)), digits_to_int(Array::get(parts, 2))))
  } else {
    None
  }
}

/// The bump kind a version transition claims: Some("patch"/"minor"/"major"),
/// None when the transition is not a single well-formed forward bump.
export fn semver_bump_kind(prev: String, next: String) -> Option[String] {
  match semver_parts(prev) {
    None => None,
    Some(pp) => match semver_parts(next) {
      None => None,
      Some(np) => {
        let (pa, pb, pc) = pp
        let (na, nb, nc) = np
        if na == pa + 1 && nb == 0 && nc == 0 {
          Some("major")
        } else if na == pa && nb == pb + 1 && nc == 0 {
          Some("minor")
        } else if na == pa && nb == pb && nc == pc + 1 {
          Some("patch")
        } else {
          None
        }
      }
    }
  }
}

/// The publish gate: claimed bump must be exactly what the diff requires.
export fn verify_publish_bump(prev_version: String, next_version: String, old_lines: Array[String], new_lines: Array[String]) -> Array[String] {
  let errors = array_empty()
  let required = classify_contract_change(old_lines, new_lines)
  match semver_bump_kind(prev_version, next_version) {
    None => Array::push(errors, "\{prev_version} -> \{next_version} is not a single forward semver bump"),
    Some(claimed) => if claimed == required {
      ()
    } else {
      Array::push(errors, "version \{prev_version} -> \{next_version} claims a \{claimed} bump but the contract change requires \{required}")
    }
  }
  errors
}

export {
  check_contract, collect_impl_fn_defs, parse_contract_program
}
