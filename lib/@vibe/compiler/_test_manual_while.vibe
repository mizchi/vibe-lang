//# Imports

import ./core {
  Expr,
  Pat,
  TypeExpr
}

//# Functions

fn test_fn(arms: Array[(Pat, Expr)]) -> Array[String] {
  let arr = arms
  let len = Array::length(arr)
  let b = ArrayBuilder::new()
  let mut i = 0
  while i < len {
    let arm = Array::get(arr, i)
    i = i + 1
    let (pat, expr) = arm
    ArrayBuilder::push(b, "item")
  }
  ArrayBuilder::freeze(b)
}
