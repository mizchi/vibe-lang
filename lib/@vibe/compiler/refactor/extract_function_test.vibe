import ./extract_function.vibe {
  extract_function
}

fn extract_named(source: String, selection: String, name: String) -> String with Exception {
  let start = String::index_of(source, needle = selection)
  handle {
    extract_function(source = source, start = start, end = start + String::length(selection), name = name)
  } with { Exception::Throw(message) => throw(String::concat(selection, String::concat(": ", message))) }
}

fn extraction_error(source: String, selection: String, name: String) -> String {
  handle {
    let _ = extract_named(source = source, selection = selection, name = name)
    ""
  } with { Exception::Throw(message) => message }
}

test "extract a complete expression with typed parameters" {
  let source = "fn score(x: Int, y: Int) -> Int { x * 2 + y }\n"
  let result = extract_named(source = source, selection = "x * 2 + y", name = "weighted")
  inspect(result, "fn score(x: Int, y: Int) -> Int { weighted(x = x, y = y) }\n\nlet weighted = (x: Int, y: Int) -> {\nx * 2 + y\n}\n")
}

test "captures resolve to the inner binding and appear only once" {
  let source = "let x = \"outer\"\nfn score(x: Int) -> Int { x + x }\n"
  let result = extract_named(source = source, selection = "x + x", name = "twice")
  assert(String::contains(result, needle = "let twice = (x: Int)"))
  assert(String::contains(result, needle = "twice(x = x)"))
}

test "a selected block keeps its internal bindings" {
  let source = "fn score(x: Int) -> Int { if true { let y = x + 1; y * 2 } else { 0 } }\n"
  let result = extract_named(source = source, selection = "{ let y = x + 1; y * 2 }", name = "calculate")
  assert(String::contains(result, needle = "let calculate = (x: Int)"))
  assert(!String::contains(result, needle = "y: Int"))
}

test "source slices preserve comments and UTF-8 bytes" {
  let source = "// 日本語\r\nfn score(x: Int) -> Int { x + // keep\r\n  1 }\r\n"
  let result = extract_named(source = source, selection = "x + // keep\r\n  1", name = "increment")
  assert(String::contains(result, needle = "// 日本語\r\n"))
  assert(String::contains(result, needle = "x + // keep\r\n  1"))
}

test "a valid expression fragment that is not an AST subtree is refused" {
  let source = "fn score(x: Int, y: Int) -> Int { y * x + 1 }\n"
  assert(String::contains(extraction_error(source = source, selection = "x + 1", name = "increment"), needle = "complete expression"))
}

test "mutable captures and escaping control flow are refused" {
  let mutable = "fn score() -> Int { let mut x = 1; x + 2 }\n"
  assert(String::contains(extraction_error(source = mutable, selection = "x + 2", name = "increment"), needle = "mutable"))
  let returning = "fn score(x: Int) -> Int { if x > 0 { return x }; 0 }\n"
  assert(String::contains(extraction_error(source = returning, selection = "if x > 0 { return x }", name = "positive"), needle = "control flow"))
}

test "name collisions, invalid names, and invalid byte ranges are refused" {
  let source = "fn score(x: Int) -> Int { x + 1 }\n"
  assert(String::contains(extraction_error(source = source, selection = "x + 1", name = "score"), needle = "already"))
  assert(String::contains(extraction_error(source = source, selection = "x + 1", name = "if"), needle = "identifier"))
  let error = handle {
    let _ = extract_function(source = source, start = -1, end = 2, name = "increment")
    ""
  } with { Exception::Throw(message) => message }
  assert(String::contains(error, needle = "range"))
}
