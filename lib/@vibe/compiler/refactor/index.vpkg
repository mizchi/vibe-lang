name = @vibe/compiler/refactor
version = 0.0.1
description =
  #|Validated source refactorings for compiler and editor clients.
deps = {
  @vibe/compiler/checker : 0.0.1
  @vibe/compiler/contract : 0.0.1
  @vibe/compiler/core : 0.0.1
  @vibe/compiler/query : 0.0.1
  @vibe/core : 0.2.0
  @vibe/parser : 0.1.0
}

generated_hash =

// Half-open UTF-8 byte range. Returns the complete edited source, or refuses
// the selection with an actionable diagnostic. The input is never mutated.
fn extract_function(source: String, start: Int, end: Int, name: String) -> String with Exception

// ADR-0120 Phase 2a (#3679): insert argument labels at the calls the checker
// resolved to a declaration (`vibe refactor add-labels`). `lines` holds one
// `path:line:col: callee +N` row per edited call.
import @vibe/compiler/checker {
  LabelSite
}
struct AddLabelsResult {
  source: String;
  calls: Int;
  labels: Int;
  already_labeled: Int;
  partly_labeled: Int;
  through_local: Int;
  other_shape: Int;
  deferred_calls: Int;
  deferred_labels: Int;
  lines: Array[String];
  // One row per inserted label: the argument's byte span in `source`, the
  // label, and the argument as the edit writes it.
  missing: Array[(Int, Int, String, String)]
}
let add_labels_positional_none: Int
let add_labels_positional_receiver: Int
let add_labels_positional_receiver_single: Int
fn add_labels_policy_named(name: String) -> Option[Int]
fn add_labels(path: String, source: String, offset_delta: Int, sites: Array[LabelSite], policy: Int) -> AddLabelsResult with Exception
