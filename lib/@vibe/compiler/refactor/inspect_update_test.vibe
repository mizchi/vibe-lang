import @vibe/compiler/refactor {
  compute_updated_source
}

test "snapshot patches affect the diagnosed call and preserve unrelated literals" {
  let source = "let untouched = \"old\"\ninspect(3, content = \"old\")\n"
  let captured = "inspect mismatch:\n  actual:   new\n  expected: old\n"
  match compute_updated_source(source, captured) {
    Some(patched) => assert_eq(patched, "let untouched = \"old\"\ninspect(3, content = \"new\")\n"),
    None => assert(false)
  }
  assert(compute_updated_source(source, "unrelated stdout") is None)
  assert(compute_updated_source(source, "inspect mismatch:\n  actual:   new\n  expected: missing\n") is None)
}

test "a snapshot value's final newline is distinct from the diagnostic terminator" {
  let source = "inspect(3, content = \"one\\n\")\n"
  let captured = "inspect mismatch:\n  actual:   two\n\n  expected: one\n\n"
  match compute_updated_source(source, captured) {
    Some(patched) => assert_eq(patched, "inspect(3, content = \"two\\n\")\n"),
    None => assert(false)
  }
}
