// ADR-0120 Phase 2a (#3679): insert argument labels at the calls the checker
// resolved to a declaration.
//
// Input is one file's source and the sites the checker recorded while typing
// it (query_label_sites_fs). For each site whose written arguments are all
// unlabeled, the parameter name of each slot is inserted before that
// argument's first token, as `name = `, unless the slot policy keeps the slot
// positional. Nothing is reordered and nothing else in the file changes, so a
// second run makes no edits.
//
// A site is skipped, and counted, when:
// - some argument is already labeled (the call is done, or it mixes, which
//   the checker reports on its own);
// - its argument list as written does not hold one argument per site
//   argument (a pipe `x |> f(y)` fills one outside the parentheses, and a
//   call inside an interpolation has no token of its own);
// - the callee is a local `let` lambda rather than a declaration, which
//   ADR-0120 keeps positional;
// - labeling it would leave a declared function's call mixing positional and
//   labeled arguments, which the checker refuses until the declaration can
//   mark its positional slots `_` (#3681). Such a call is reported with the
//   labels it will take, so a policy can be measured before `_` exists.

import @vibe/compiler/checker {
  LabelSite, label_site_builtin, label_site_declared
}

import @vibe/compiler/core {
  Stmt, __to_string
}

import @vibe/core {
  struct MutMap
}

import @vibe/parser {
  Token, lex_with_offsets, offset_to_line_col, parse_program
}

//# Policy

/// Label every parameter of a declared function.
export let add_labels_positional_none: Int = 0

/// Keep the receiver of a `T::f` positional (ADR-0120 D3's first guideline).
export let add_labels_positional_receiver: Int = 1

/// The receiver, and the only parameter of a one-parameter function (D3's
/// conversions and predicates).
export let add_labels_positional_receiver_single: Int = 2

/// `none` / `receiver` / `receiver+single`, the spellings the CLI accepts.
export fn add_labels_policy_named(name: String) -> Option[Int] {
  if name == "none" {
    Some(add_labels_positional_none)
  } else if name == "receiver" {
    Some(add_labels_positional_receiver)
  } else if name == "receiver+single" {
    Some(add_labels_positional_receiver_single)
  } else {
    None
  }
}

fn add_labels_base_name(raw: String) -> String {
  let size = String::length(raw)
  if size > 0 && (String::ends_with(raw, "~") || String::ends_with(raw, "?")) {
    raw[0: size - 1]
  } else {
    raw
  }
}

/// Is written argument `i` of `site` left positional?
fn add_labels_positional(site: LabelSite, i: Int, policy: Int) -> Bool {
  let raw = Array::get(site.names, i)
  if site.kind == label_site_builtin {
    raw == "_"
  } else {
    let receiver_slot = if site.method_call {
      i + 1
    } else {
      i
    }
    let total = Array::length(site.names) + if site.method_call {
      1
    } else {
      0
    }
    let receiver = receiver_slot == 0 && String::contains(site.callee, "::")
    if policy == add_labels_positional_none {
      false
    } else if policy == add_labels_positional_receiver {
      receiver
    } else {
      receiver || total == 1
    }
  }
}

//# Declarations

/// The raw parameter names of each top-level function declaration.
fn add_labels_declared(source: String) -> MutMap[String, Array[String]] with Exception {
  let out: MutMap[String, Array[String]] = MutMap::new_string()
  let (tokens, _, _) = lex_with_offsets(source)
  for stmt in parse_program(tokens) {
    let found = match stmt {
      SLet(_, _, name, _, EFn(_, _, params, _, _, _)) => Some((name, params)),
      SFnDecl(_, name, EFn(_, _, params, _, _, _), _, _) => Some((name, params)),
      _ => None
    }
    match found {
      Some((name, params)) => MutMap::set(out, name, for param in params {
        let (raw, _) = param
        raw
      }),
      None => ()
    }
  }
  out
}

/// A `declared` site is a call to a top-level declaration of this file only
/// when the header it resolved to is that declaration's; otherwise a local
/// `let` of the same shape answered, which stays positional.
fn add_labels_is_declaration(site: LabelSite, declared: MutMap[String, Array[String]]) -> Bool {
  if site.kind != label_site_declared {
    true
  } else {
    match MutMap::get(declared, site.callee) {
      Some(params) => {
        let skip = if site.method_call {
          1
        } else {
          0
        }
        let mut same = Array::length(params) == Array::length(site.names) + skip
        let mut i = 0
        while i < Array::length(site.names) && same {
          same = Array::get(params, i + skip) == Array::get(site.names, i)
          i = i + 1
        }
        same
      },
      None => false
    }
  }
}

//# Argument tokens

fn add_labels_token_at(starts: Array[Int], offset: Int) -> Int {
  let mut lo = 0
  let mut hi = Array::length(starts)
  while lo < hi {
    let mid = (lo + hi) / 2
    if Array::get(starts, mid) < offset {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  if lo < Array::length(starts) && Array::get(starts, lo) == offset {
    lo
  } else {
    -1
  }
}

fn add_labels_opens(t: Token) -> Bool {
  match t {
    TLParen => true,
    TLBracket => true,
    TLBrace => true,
    _ => false
  }
}

fn add_labels_closes(t: Token) -> Bool {
  match t {
    TRParen => true,
    TRBracket => true,
    TRBrace => true,
    _ => false
  }
}

/// The token index of the `(` that opens the call starting at token `k`: the
/// token itself for a method call, else the first `(` after the callee, past
/// an explicit type-argument list. -1 when the callee is not followed by one.
fn add_labels_open_paren(tokens: Array[Token], k: Int) -> Int {
  match Array::get(tokens, k) {
    TLParen => k,
    _ => {
      let mut j = k + 1
      let mut depth = 0
      let mut found = -1
      let mut done = false
      while j < Array::length(tokens) && !done {
        let t = Array::get(tokens, j)
        match t {
          TLParen => if depth == 0 {
            found = j
            done = true
          } else {
            ()
          },
          TLBracket => depth = depth + 1,
          TRBracket => depth = depth - 1,
          TIdent(_) => (),
          TDoubleColon => (),
          TDot => (),
          TComma => if depth == 0 {
            done = true
          } else {
            ()
          },
          _ => if depth == 0 {
            done = true
          } else {
            ()
          }
        }
        j = j + 1
      }
      found
    }
  }
}

/// The first token of each argument between the `(` at `paren` and its `)`.
fn add_labels_argument_starts(tokens: Array[Token], paren: Int) -> Array[Int] {
  let out: Array[Int] = []
  let mut j = paren + 1
  let mut depth = 0
  let mut expecting = true
  let mut done = false
  while j < Array::length(tokens) && !done {
    let t = Array::get(tokens, j)
    match t {
      TSemicolon => (),
      TEof => done = true,
      TComma => if depth == 0 {
        expecting = true
      } else {
        ()
      },
      _ => if depth == 0 && add_labels_closes(t) {
        done = true
      } else {
        if expecting {
          Array::push(out, j)
          expecting = false
        } else {
          ()
        }
        if add_labels_opens(t) {
          depth = depth + 1
        } else if add_labels_closes(t) {
          depth = depth - 1
        } else {
          ()
        }
      }
    }
    j = j + 1
  }
  out
}

//# Driver

/// The edited `source` and what was done. `sites` are the checker's records
/// for this file; `offset_delta` maps their offsets (into the ingested
/// source) back to `source`.
export fn add_labels(path: String, source: String, offset_delta: Int, sites: Array[LabelSite], policy: Int) -> AddLabelsResult with Exception {
  let declared = add_labels_declared(source)
  let (tokens, starts, _) = lex_with_offsets(source)
  let edits: MutMap[Int, String] = MutMap::new_int()
  let lines: Array[String] = []
  let mut calls = 0
  let mut labels = 0
  let mut done = 0
  let mut shape = 0
  let mut partial = 0
  let mut local = 0
  let mut deferred = 0
  let mut deferred_labels = 0
  for site in sites {
    let mut labeled = 0
    for flag in site.labeled {
      if flag {
        labeled = labeled + 1
      } else {
        ()
      }
    }
    let n = Array::length(site.labeled)
    if n == 0 || n > Array::length(site.names) {
      ()
    } else if labeled == n {
      done = done + 1
    } else if labeled > 0 {
      partial = partial + 1
    } else if !add_labels_is_declaration(site, declared) {
      local = local + 1
    } else {
      let wanted: Array[String] = []
      let mut i = 0
      while i < n {
        if add_labels_positional(site, i, policy) {
          Array::push(wanted, "")
        } else {
          Array::push(wanted, add_labels_base_name(Array::get(site.names, i)))
        }
        i = i + 1
      }
      let mut any = false
      let mut kept = false
      for w in wanted {
        any = any || String::length(w) > 0
        kept = kept || String::length(w) == 0
      }
      // A declared function's call may not mix positional and labeled
      // arguments until its declaration can mark the positional slot `_`
      // (#3681), so such a call is deferred and only counted. A builtin
      // already accepts a label at its named slots beside positional ones.
      if any && kept && site.kind != label_site_builtin {
        let mut wanted_labels = 0
        for w in wanted {
          if String::length(w) > 0 {
            wanted_labels = wanted_labels + 1
          } else {
            ()
          }
        }
        deferred = deferred + 1
        deferred_labels = deferred_labels + wanted_labels
        let (line, col) = offset_to_line_col(source, site.offset - offset_delta)
        Array::push(lines, path + ":" + __to_string(line) + ":" + __to_string(col) + ": " + site.callee + " +" + __to_string(wanted_labels) + " after `_` (#3681)")
      } else if any {
        let k = add_labels_token_at(starts, site.offset - offset_delta)
        let paren = if k >= 0 {
          add_labels_open_paren(tokens, k)
        } else {
          -1
        }
        let arg_tokens = if paren >= 0 {
          add_labels_argument_starts(tokens, paren)
        } else {
          []
        }
        if Array::length(arg_tokens) != n {
          shape = shape + 1
        } else {
          calls = calls + 1
          let mut inserted = 0
          let mut ai = 0
          while ai < n {
            let w = Array::get(wanted, ai)
            if String::length(w) > 0 {
              MutMap::set(edits, Array::get(starts, Array::get(arg_tokens, ai)), w + " = ")
              inserted = inserted + 1
            } else {
              ()
            }
            ai = ai + 1
          }
          labels = labels + inserted
          let (line, col) = offset_to_line_col(source, site.offset - offset_delta)
          Array::push(lines, path + ":" + __to_string(line) + ":" + __to_string(col) + ": " + site.callee + " +" + __to_string(inserted))
        }
      } else {
        ()
      }
    }
  }
  // Token starts ascend, so one pass copies the source with each insertion
  // in place. An offset is used once: a synthesized `;` can share a start
  // with the token after it.
  let out = StringBuilder::new()
  let mut prev = 0
  for at in starts {
    match MutMap::get(edits, at) {
      Some(insert) => {
        StringBuilder::push(out, source[prev: at])
        StringBuilder::push(out, insert)
        let _ = MutMap::delete(edits, at)
        prev = at
      },
      None => ()
    }
  }
  StringBuilder::push(out, source[prev: String::length(source)])
  let text = StringBuilder::freeze(out)
  AddLabelsResult::{
    source: text,
    calls: calls,
    labels: labels,
    already_labeled: done,
    partly_labeled: partial,
    through_local: local,
    other_shape: shape,
    deferred_calls: deferred,
    deferred_labels: deferred_labels,
    lines: lines
  }
}
