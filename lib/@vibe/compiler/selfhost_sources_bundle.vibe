      let (lfn, _) = Array::get(fields, lni)\n        Array::push(lit_names, lfn)\n        lni = lni + 1\n      }\n      let rec_si = struct_index_by_field_set(ctx.gc_ctor_table, lit_names)\n      let rec_tag = if rec_si >= 0 {\n        struct_tag_by_index(ctx.gc_ctor_table, rec_si)\n      } else {\n        0\n      }\n      let rec_fields = if rec_si >= 0 {\n        let def_fnames = Array::get(ctx.gc_ctor_table.struct_field_names, rec_si)\n        let ordered = Array::slice([\n          (\"\", EUnit)\n        ], 0, 0)\n        let mut oi = 0\n        while oi < Array::length(def_fnames) {\n          let target_name = Array::get(def_fnames, oi)\n          let mut ri2 = 0\n          while ri2 < flen {\n            let (rfn, rfv) = Array::get(fields, ri2)\n            if rfn == target_name {\n              Array::push(ordered, (rfn, rfv))\n              ri2 = flen\n            } else {\n              ri2 = ri2 + 1\n            }\n          }\n          oi = oi + 1\n        }\n        ordered\n      } else {\n        fields\n      }\n      let obj_size = 8 + flen * 8\n      let ptr_local = next_local\n      Array::push(local_names, \"__rec_ptr\")\n      emit_global_get(buf, 0)\n      emit_i64_extend_i32_u(buf)\n      emit_local_set(buf, ptr_local)\n      emit_global_get(buf, 0)\n      emit_i32_const(buf, obj_size)\n      emit_i32_add(buf)\n      emit_global_set(buf, 0)\n      emit_heap_memory_grow_check(buf)\n      emit_local_get(buf, ptr_local)\n      emit_i32_wrap_i64(buf)\n      emit_i32_const(buf, rec_tag)\n      emit_i32_store(buf, 2, 0)\n      emit_local_get(buf, ptr_local)\n      emit_i32_wrap_i64(buf)\n      emit_i32_const(buf, flen)\n      emit_i32_store(buf, 2, 4)\n      let mut nl_r = next_local + 1\n      let mut ri = 0\n      while ri < flen {\n        let (_, fexpr) = Array::get(rec_fields, ri)\n        nl_r = ce(buf, fexpr, local_names, nl_r, ld)\n        let val_local = nl_r\n        Array::push(local_names, \"__rec_val\")\n        emit_local_set(buf, val_local)\n        nl_r = nl_r + 1\n        emit_local_get(buf, ptr_local)\n        emit_i32_wrap_i64(buf)\n        emit_local_get(buf, val_local)\n        emit_i64_store(buf, 3, 8 + ri * 8)\n        ri = ri + 1\n      }\n      emit_local_get(buf, ptr_local)\n      emit_i64_const(buf, 1)\n      emit_i64_or(buf)\n      nl_r\n    },\n    EHandle(body, harms) => {\n      if Array::length(harms) == 0 {\n        ce(buf, body, local_names, next_local, ld)\n      } else {\n        let (hpat, hexpr) = Array::get(harms, 0)\n        let mut hpat_ok = false\n        match hpat {\n          PCtor(hname, _) => {\n            if hname == \"Error::Throw\" || hname == \"Throw\" {\n              hpat_ok = true\n            }\n          },\n          _ => ()\n        }\n        if !hpat_ok {\n          throw(\"GC codegen: only `with Error { Throw(..) => .. }` handlers are supported (algebraic effect handlers need the linear backend)\")\n        }\n        emit_block_i64(buf)\n        emit_block_i64(buf)\n        bytebuf_push(buf, 31)\n        bytebuf_push(buf, 126)\n        leb128_encode_u32(buf, 1)\n        bytebuf_push(buf, 0)\n        leb128_encode_u32(buf, 0)\n        leb128_encode_u32(buf, 0)\n        let body_ld = if ld >= 0 {\n          ld + 3\n        } else {\n          -1\n        }\n        let nl_b = ce(buf, body, local_names, next_local, body_ld)\n        emit_end(buf)\n        emit_br(buf, 1)\n        emit_end(buf)\n        let names_before_h = Array::length(local_names)\n        let mut nl_h = nl_b\n        match hpat {\n          PCtor(_, hargs) => {\n            if Array::length(hargs) > 0 {\n              match Array::get(hargs, 0) {\n                PBind(hbname) => {\n                  let hb_l = Array::length(local_names)\n                  emit_local_set(buf, hb_l)\n                  Array::push(local_names, hbname)\n                  if hb_l + 1 > nl_h {\n                    nl_h = hb_l + 1\n                  }\n                },\n                _ => emit_drop(buf)\n              }\n            } else {\n              emit_drop(buf)\n            }\n          },\n          _ => emit_drop(buf)\n        }\n        let harm_ld = if ld >= 0 {\n          ld + 1\n        } else {\n          -1\n        }\n        let nl_h2 = ce(buf, hexpr, local_names, Array::length(local_names), harm_ld)\n        emit_end(buf)\n        Array::truncate(local_names, names_before_h)\n        agg_log_reset_above(ctx.gc_agg_local_slots, names_before_h)\n        if nl_h2 > nl_h {\n          nl_h = nl_h2\n        }\n        nl_h\n      }\n    },\n    ELabeledArg(_, _, lval) => ce(buf, lval, local_names, next_local, ld),\n    EMap(mfields) => {\n      let mflen = Array::length(mfields)\n      let mcap = if mflen > 32 {\n        mflen\n      } else {\n        32\n      }\n      let malloc_size = 8 + mcap * 16\n      let mptr = next_local\n      Array::push(local_names, \"__maplit_ptr\")\n      emit_global_get(buf, 0)\n      emit_i64_extend_i32_u(buf)\n      emit_local_set(buf, mptr)\n      emit_global_get(buf, 0)\n      emit_i32_const(buf, malloc_size)\n      emit_i32_add(buf)\n      emit_global_set(buf, 0)\n      emit_heap_memory_grow_check(buf)\n      emit_local_get(buf, mptr)\n      emit_i32_wrap_i64(buf)\n      emit_i32_const(buf, mflen)\n      emit_i32_store(buf, 2, 0)\n      emit_local_get(buf, mptr)\n      emit_i32_wrap_i64(buf)\n      emit_i32_const(buf, mcap)\n      emit_i32_store(buf, 2, 4)\n      let mut mnl = next_local + 1\n      let mut mi = 0\n      while mi < mflen {\n        let (mkey, mval) = Array::get(mfields, mi)\n        let mk_idx = str_table_lookup(ctx.str_table.strs, mkey)\n        emit_local_get(buf, mptr)\n        emit_i32_wrap_i64(buf)\n        emit_str_ref(buf, Array::get(ctx.str_table.offsets, mk_idx), Array::get(ctx.str_table.lengths, mk_idx))\n        emit_i64_store(buf, 3, 8 + mi * 16)\n        emit_local_get(buf, mptr)\n        emit_i32_wrap_i64(buf)\n        mnl = ce(buf, mval, local_names, mnl, ld)\n        emit_i64_store(buf, 3, 16 + mi * 16)\n        mi = mi + 1\n      }\n      emit_local_get(buf, mptr)\n      mnl\n    },\n    EStringInterp(_) => throw(\"GC codegen: EStringInterp must be resolved before codegen (call resolve_interp_stmts first)\"),\n    _ => throw(String::concat(\"unsupported expression in gc codegen: tag \", __to_string(expr_tag(expr))))\n  }\n}\n\n\nexport {\n  compile_expr_gc\n}\n")
}

let selfhost_source_119 = () -> (String, String) {
  ("lib/@vibe/compiler/codegen/gc/backend_call.vibe",
"\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\nlet emit_call_resolved: (Bytes, CompileCtxGc, Int) -> Unit = (buf, ctx, fidx) -> {\n  if ctx.func_offset > 0 && fidx >= ctx.func_offset {\n    emit_i64_const(buf, 0)\n  } else {\n    ()\n  }\n  emit_call(buf, fidx)\n}\n\nlet gc_resolve_builtin_last: (FuncTable, String) -> Int = (ft, name) -> {\n  let mut i = Array::length(ft.names) - 1\n  let mut found = -1\n  while i >= 0 {\n    if found < 0 && Array::get(ft.names, i) == name {\n      found = Array::get(ft.indices, i)\n      i = -1\n    } else {\n      i = i - 1\n    }\n  }\n  found\n}\n\nlet rec bc_expr_is_floatish: (Expr, CompileCtxGc) -> Bool = (e, ctx) -> {\n  match e {\n    EFloat(_) => true,\n    EIdent(fname, _) => array_contains_str(ctx.gc_float_locals, fname),\n    EBinOp(op, l, r) => (op == \"+\" || op == \"-\" || op == \"*\" || op == \"/\") && (bc_expr_is_floatish(l, ctx) || bc_expr_is_floatish(r, ctx)),\n    EUnaryOp(op, x) => op == \"-\" && bc_expr_is_floatish(x, ctx),\n    ECall(fcallee, _, _) => match fcallee {\n      EIdent(cn, _) => cn == \"Int::to_double\" || cn == \"Double::from_i64_bits\" || cn == \"Float::to_double\" || cn == \"Double::to_float\" || cn == \"Int::to_float\",\n      _ => false\n    },\n    _ => false\n  }\n}\n\nlet compile_call_gc: (Bytes, Expr, Array[Expr], Array[String], Int, CompileCtxGc, Int, (Bytes, Expr, Array[String], Int, Int) -> Int with { Error }) -> Int with { Error } = (buf, callee, args, local_names, next_local, ctx, ld, ce) -> {\n  match callee {\n    EIdent(fname, _) => {\n      let ctor_lookup_idx = ctor_table_index_of(ctx.gc_ctor_table, fname)\n      if ctor_lookup_idx >= 0 {\n        let tag = Array::get(ctx.gc_ctor_table.tags, ctor_lookup_idx)\n        let fc = Array::get(ctx.gc_ctor_table.field_counts, ctor_lookup_idx)\n        let obj_size = 8 + fc * 8\n        let ptr_local = next_local\n        Array::push(local_names, \"__ctor_ptr\")\n        emit_global_get(buf, 0)\n        emit_i64_extend_i32_u(buf)\n        emit_local_set(buf, ptr_local)\n        emit_global_get(buf, 0)\n        emit_i32_const(buf, obj_size)\n        emit_i32_add(buf)\n        emit_global_set(buf, 0)\n        emit_heap_memory_grow_check(buf)\n        emit_local_get(buf, ptr_local)\n        emit_i32_wrap_i64(buf)\n        emit_i32_const(buf, tag)\n        emit_i32_store(buf, 2, 0)\n        emit_local_get(buf, ptr_local)\n        emit_i32_wrap_i64(buf)\n        emit_i32_const(buf, fc)\n        emit_i32_store(buf, 2, 4)\n        let actual_args = if Array::length(args) == 1 {\n          match Array::get(args, 0) {\n            ERecord(_, rec_fields) => {\n              let rec find_sn: (Int) -> Int = (sni) -> {\n                if sni >= Array::length(ctx.gc_ctor_table.struct_names) {\n                  -1\n                }\n                else if Array::get(ctx.gc_ctor_table.struct_names, sni) == fname {\n                  sni\n                }\n                else find_sn(sni + 1)\n              }\n              let sn_idx = find_sn(0)\n              if sn_idx >= 0 {\n                let def_fnames = Array::get(ctx.gc_ctor_table.struct_field_names, sn_idx)\n                let ordered = Array::slice([\n                  EUnit\n                ], 0, 0)\n                let mut oi = 0\n                while oi < Array::length(def_fnames) {\n                  let target_name = Array::get(def_fnames, oi)\n                  let rec find_rf: (Int) -> Expr = (ri) -> {\n                    if ri >= Array::length(rec_fields) {\n                      EUnit\n                    }\n                    else {\n                      let (rfn, rfv) = Array::get(rec_fields, ri)\n                      if rfn == target_name {\n                        rfv\n                      }\n                      else find_rf(ri + 1)\n                    }\n                  }\n                  Array::push(ordered, find_rf(0))\n                  oi = oi + 1\n                }\n                ordered\n              } else {\n                args\n              }\n            },\n            _ => args\n          }\n        } else {\n          args\n        }\n        let mut nl_c = next_local + 1\n        let mut fi_c = 0\n        while fi_c < Array::length(actual_args) {\n          nl_c = ce(buf, Array::get(actual_args, fi_c), local_names, nl_c, ld)\n          let val_local = nl_c\n          Array::push(local_names, \"__ctor_val\")\n          emit_local_set(buf, val_local)\n          nl_c = nl_c + 1\n          emit_local_get(buf, ptr_local)\n          emit_i32_wrap_i64(buf)\n          emit_local_get(buf, val_local)\n          emit_i64_store(buf, 3, 8 + fi_c * 8)\n          fi_c = fi_c + 1\n        }\n        emit_local_get(buf, ptr_local)\n        emit_i64_const(buf, 1)\n        emit_i64_or(buf)\n        nl_c\n      }\n      else if fname == \"__slice\" {\n        let (ss_idx, _, _) = resolve_func(ctx.func_table, \"String::substring\")\n        let (bs_idx, _, _) = resolve_func(ctx.func_table, \"Bytes::slice\")\n        let (as_idx, _, _) = resolve_func(ctx.func_table, \"Array::slice\")\n        let obj_local = next_local\n        let start_local = next_local + 1\n        let end_local = next_local + 2\n        let ptr_local = next_local + 3\n        let cap_local = next_local + 4\n        Array::push(local_names, \"__slice_obj\")\n        Array::push(local_names, \"__slice_start\")\n        Array::push(local_names, \"__slice_end\")\n        Array::push(local_names, \"__slice_ptr\")\n        Array::push(local_names, \"__slice_cap\")\n        let mut nl = next_local + 5\n        nl = ce(buf, Array::get(args, 0), local_names, nl, ld)\n        emit_local_set(buf, obj_local)\n        nl = ce(buf, Array::get(args, 1), local_names, nl, ld)\n        emit_local_set(buf, start_local)\n        nl = ce(buf, Array::get(args, 2), local_names, nl, ld)\n        emit_local_set(buf, end_local)\n        emit_local_get(buf, obj_local)\n        emit_i64_const(buf, 32)\n        emit_i64_shr_s(buf)\n        emit_i64_eqz(buf)\n        emit_if_i64(buf)\n        emit_local_get(buf, obj_local)\n        emit_local_set(buf, ptr_local)\n        emit_local_get(buf, ptr_local)\n        emit_i32_wrap_i64(buf)\n        emit_i32_load(buf, 2, 0)\n        emit_i64_extend_i32_u(buf)\n        emit_local_set(buf, cap_local)\n        emit_local_get(buf, cap_local)\n        emit_i32_wrap_i64(buf)\n        emit_i32_const(buf, 2147483647)\n        emit_i32_gt_u(buf)\n        emit_if_i64(buf)\n        emit_local_get(buf, obj_local)\n        emit_local_get(buf, start_local)\n        emit_local_get(buf, end_local)\n        emit_call_resolved(buf, ctx, bs_idx)\n        emit_else(buf)\n        emit_local_get(buf, obj_local)\n        emit_local_get(buf, start_local)\n        emit_local_get(buf, end_local)\n        emit_call_resolved(buf, ctx, as_idx)\n        emit_end(buf)\n        emit_else(buf)\n        emit_local_get(buf, obj_local)\n        emit_local_get(buf, start_local)\n        emit_local_get(buf, end_local)\n        emit_call_resolved(buf, ctx, ss_idx)\n        emit_end(buf)\n        nl\n      }\n      else if fname == \"__index\" {\n        let (sg_idx, _, _) = resolve_func(ctx.func_table, \"String::char_code_at\")\n        let (bg_idx, _, _) = resolve_func(ctx.func_table, \"Bytes::get\")\n        let (ag_idx, _, _) = resolve_func(ctx.func_table, \"Array::get\")\n        let obj_local = next_local\n        let idx_local = next_local + 1\n        let ptr_local = next_local + 2\n        let cap_local = next_local + 3\n        Array::push(local_names, \"__index_obj\")\n        Array::push(local_names, \"__index_idx\")\n        Array::push(local_names, \"__index_ptr\")\n        Array::push(local_names, \"__index_cap\")\n        let mut nl = next_local + 4\n        nl = ce(buf, Array::get(args, 0), local_names, nl, ld)\n        emit_local_set(buf, obj_local)\n        nl = ce(buf, Array::get(args, 1), local_names, nl, ld)\n        emit_local_set(buf, idx_local)\n        emit_local_get(buf, obj_local)\n        emit_i64_const(buf, 32)\n        emit_i64_shr_s(buf)\n        emit_i64_eqz(buf)\n        emit_if_i64(buf)\n        emit_local_get(buf, obj_local)\n        emit_local_set(buf, ptr_local)\n        emit_local_get(buf, ptr_local)\n        emit_i32_wrap_i64(buf)\n        emit_i32_load(buf, 2, 0)\n        emit_i64_extend_i32_u(buf)\n        emit_local_set(buf, cap_local)\n        emit_local_get(buf, cap_local)\n        emit_i32_wrap_i64(buf)\n        emit_i32_const(buf, 2147483647)\n        emit_i32_gt_u(buf)\n        emit_if_i64(buf)\n        emit_local_get(buf, obj_local)\n        emit_local_get(buf, idx_local)\n        emit_call_resolved(buf, ctx, bg_idx)\n        emit_else(buf)\n        emit_local_get(buf, obj_local)\n        emit_local_get(buf, idx_local)\n        emit_call_resolved(buf, ctx, ag_idx)\n        emit_end(buf)\n        emit_else(buf)\n        emit_local_get(buf, obj_local)\n        emit_local_get(buf, idx_local)\n        emit_call_resolved(buf, ctx, sg_idx)\n        emit_end(buf)\n        nl\n      }\n      else if fname == \"__set_field\" {\n        let field = get_estring_value(Array::get(args, 1))\n        let fc = String::char_code_at(field, 0)\n        let is_numeric = fc >= 48 && fc <= 57\n        if is_numeric {\n          let mut vi = 0\n          let mut vp = 0\n          while vp < String::length(field) {\n            vi = vi * 10 + (String::char_code_at(field, vp) - 48)\n            vp = vp + 1\n          }\n          let mut nl = next_local\n          nl = ce(buf, Array::get(args, 0), local_names, nl, ld)\n          emit_i64_const(buf, -2)\n          emit_i64_and(buf)\n          emit_i32_wrap_i64(buf)\n          nl = ce(buf, Array::get(args, 2), local_names, nl, ld)\n          emit_i64_store(buf, 3, vi * 8)\n          emit_i64_const(buf, 1)\n          nl\n        } else {\n          let cands = struct_field_candidates(ctx.gc_ctor_table, field)\n          if Array::length(cands) == 0 {\n            throw(String::concat(\"unknown struct field: \", field))\n          }\n          let (_, idx0) = Array::get(cands, 0)\n          let dispatch = struct_field_dispatch_cases(cands)\n          if Array::length(dispatch) == 0 {\n            let mut nl = next_local\n            nl = ce(buf, Array::get(args, 0), local_names, nl, ld)\n            emit_i64_const(buf, -2)\n            emit_i64_and(buf)\n            emit_i32_wrap_i64(buf)\n            nl = ce(buf, Array::get(args, 2), local_names, nl, ld)\n            emit_i64_store(buf, 3, 8 + idx0 * 8)\n            emit_i64_const(buf, 1)\n            nl\n          } else {\n            let mut nl = next_local\n            nl = ce(buf, Array::get(args, 0), local_names, nl, ld)\n            emit_i64_const(buf, -2)\n            emit_i64_and(buf)\n            let obj_l = nl\n            Array::push(local_names, \"__setf_obj\")\n            emit_local_set(buf, obj_l)\n            nl = ce(buf, Array::get(args, 2), local_names, nl + 1, ld)\n            let val_l = nl\n            Array::push(local_names, \"__setf_val\")\n            emit_local_set(buf, val_l)\n            let mut di = 0\n            while di < Array::length(dispatch) {\n              let (dtag, didx) = Array::get(dispatch, di)\n              emit_local_get(buf, obj_l)\n              emit_i32_wrap_i64(buf)\n              emit_i32_load(buf, 2, 0)\n              emit_i32_const(buf, dtag)\n              emit_i32_eq(buf)\n              emit_if_void(buf)\n              emit_local_get(buf, obj_l)\n              emit_i32_wrap_i64(buf)\n              emit_local_get(buf, val_l)\n              emit_i64_store(buf, 3, 8 + didx * 8)\n              emit_else(buf)\n              di = di + 1\n            }\n            emit_local_get(buf, obj_l)\n            emit_i32_wrap_i64(buf)\n            emit_local_get(buf, val_l)\n            emit_i64_store(buf, 3, 8 + idx0 * 8)\n            let mut de = 0\n            while de < Array::length(dispatch) {\n              emit_end(buf)\n              de = de + 1\n            }\n  