let selfhost_source_57 = () -> (String, String) {
  ("lib/@vibe/compiler/codegen/wasm_emit/metadata.vibe",
"\n\n\nexport let emit_function_name_section: (Bytes, Array[String], Int) -> Unit = (out, names, base_index) -> {\n  let count = Array::length(names)\n  if count == 0 {\n    ()\n  } else {\n    let content = bytebuf_new()\n    bytebuf_push_string(content, \"name\")\n    let namemap = bytebuf_new()\n    leb128_encode_u32(namemap, count)\n    let mut i = 0\n    while i < count {\n      leb128_encode_u32(namemap, base_index + i)\n      bytebuf_push_string(namemap, Array::get(names, i))\n      i = i + 1\n    }\n    bytebuf_push_section(content, 1, namemap)\n    bytebuf_push_section(out, 0, content)\n  }\n}\n\nlet emit_ascii_payload: (Bytes, String) -> Unit = (buf, text) -> {\n  let len = String::length(text)\n  let mut i = 0\n  while i < len {\n    bytebuf_push(buf, String::char_code_at(text, i))\n    i = i + 1\n  }\n}\n\nexport let emit_vibe_abi_custom_section: (Bytes, String) -> Unit = (out, host_import_abi) -> {\n  let content = bytebuf_new()\n  bytebuf_push_string(content, \"vibe.abi\")\n  emit_ascii_payload(content, \"version=1\\n\")\n  emit_ascii_payload(content, String::concat(\"host_import_abi=\", host_import_abi))\n  emit_ascii_payload(content, \"\\n\")\n  bytebuf_push_section(out, 0, content)\n}\n")
}

