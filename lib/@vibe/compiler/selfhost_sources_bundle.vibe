let selfhost_source_5 = () -> (String, String) {
  ("lib/@vibe/parser/float_format.vibe",
"\n\n\nlet zero_pad_6: (Int) -> String = (n) -> {\n  let s = __to_string(n)\n  let len = String::length(s)\n  if len >= 6 {\n    s\n  } else {\n    let mut out = \"\"\n    let mut i = len\n    while i < 6 {\n      out = String::concat(out, \"0\")\n      i = i + 1\n    }\n    String::concat(out, s)\n  }\n}\n\nlet trim_trailing_zeros: (String) -> String = (s) -> {\n  let mut end = String::length(s)\n  while end > 0 && String::char_code_at(s, end - 1) == 48 {\n    end = end - 1\n  }\n  if end <= 0 {\n    \"\"\n  } else {\n    s[0: end]\n  }\n}\n\nexport let double_to_string_compiler: (Double) -> String = (d) -> {\n  if d != d {\n    \"nan\"\n  } else {\n    let neg = d < 0.0\n    let abs_d = if neg {\n      0.0 - d\n    } else {\n      d\n    }\n    let int_part = Double::to_int(abs_d)\n    let frac = abs_d - Int::to_double(int_part)\n    let scaled_raw = Double::to_int(frac * 1000000.0 + 0.5)\n    let int_norm = if scaled_raw == 1000000 {\n      int_part + 1\n    } else {\n      int_part\n    }\n    let frac_norm = if scaled_raw == 1000000 {\n      0\n    } else {\n      scaled_raw\n    }\n    let int_s = __to_string(int_norm)\n    let frac_s = if frac_norm == 0 {\n      \"\"\n    } else {\n      trim_trailing_zeros(zero_pad_6(frac_norm))\n    }\n    let body = if String::length(frac_s) == 0 {\n      int_s\n    } else {\n      String::concat(int_s, String::concat(\".\", frac_s))\n    }\n    if neg {\n      String::concat(\"-\", body)\n    } else {\n      body\n    }\n  }\n}\n")
}

let selfhost_source_6 = () -> (String, String) {
  ("lib/@vibe/parser/lexer.vibe",
"\n\n\nlet is_ws: (Int) -> Bool = (c) -> {\n  c == ' ' || c == '\\n' || c == '\\t' || c == '\\r'\n}\n\nlet is_alpha: (Int) -> Bool = (c) -> {\n  (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == '_'\n}\n\nlet is_digit: (Int) -> Bool = (c) -> {\n  c >= '0' && c <= '9'\n}\n\nlet is_alnum: (Int) -> Bool = (c) -> {\n  is_alpha(c) || is_digit(c)\n}\n\nlet lex_char: (String, Int, Int) -> (Token, Int) with { Error } = (s, len, i) -> {\n  let start = i + 1\n  if start >= len {\n    throw(\"unterminated char literal\")\n  }\n  let c = String::char_code_at(s, start)\n  if c == '\\\\' {\n    let esc_pos = start + 1\n    if esc_pos >= len {\n      throw(\"unterminated char escape\")\n    }\n    let esc = String::char_code_at(s, esc_pos)\n    let val = if esc == 'n' {\n      10\n    }\n    else if esc == 't' {\n      9\n    }\n    else if esc == 'r' {\n      13\n    }\n    else if esc == '\\\\' {\n      92\n    }\n    else if esc == '\\'' {\n      39\n    }\n    else if esc == '0' {\n      0\n    }\n    else throw(\"invalid char escape\")\n    let close = esc_pos + 1\n    if close >= len || String::char_code_at(s, close) != '\\'' {\n      throw(\"expected closing quote for char literal\")\n    };\n    (TInt(val), close + 1)\n  } else {\n    let close = start + 1\n    if close >= len || String::char_code_at(s, close) != '\\'' {\n      throw(\"expected closing quote for char literal\")\n    };\n    (TInt(c), close + 1)\n  }\n}\n\nlet slice_eq: (String, Int, Int, String) -> Bool = (source, start, end, text) -> {\n  let len = end - start\n  let text_len = String::length(text)\n  if len != text_len {\n    false\n  } else {\n    let mut i = 0\n    let mut ok = true\n    while ok && i < text_len {\n      ok = String::char_code_at(source, start + i) == String::char_code_at(text, i)\n      i = i + 1\n    }\n    ok\n  }\n}\n\nlet is_hex_digit: (Int) -> Bool = (c) -> {\n  (c >= '0' && c <= '9') || (c >= 'a' && c <= 'f') || (c >= 'A' && c <= 'F')\n}\n\nlet keyword_lookup: (String, Int, Int) -> Option[Token] = (source, start, end) -> {\n  let len = end - start\n  if len == 2 {\n    let c0 = String::char_code_at(source, start)\n    if c0 == 'f' {\n      if slice_eq(source, start, end, \"fn\") {\n        Some(TIdent(\"fn\"))\n      } else None\n    } else if c0 == 'i' {\n      if slice_eq(source, start, end, \"if\") {\n        Some(TIf)\n      } else if slice_eq(source, start, end, \"in\") {\n        Some(TIn)\n      } else if slice_eq(source, start, end, \"is\") {\n        Some(TIs)\n      } else None\n    } else if c0 == 'd' {\n      if slice_eq(source, start, end, \"do\") {\n        Some(TDo)\n      } else None\n    } else if c0 == 'a' {\n      if slice_eq(source, start, end, \"as\") {\n        Some(TAs)\n      } else None\n    } else None\n  } else if len == 3 {\n    let c0 = String::char_code_at(source, start)\n    if c0 == 'l' {\n      if slice_eq(source, start, end, \"let\") {\n        Some(TLet)\n      } else None\n    } else if c0 == 'r' {\n      if slice_eq(source, start, end, \"rec\") {\n        Some(TRec)\n      } else None\n    } else if c0 == 'm' {\n      if slice_eq(source, start, end, \"mut\") {\n        Some(TMut)\n      } else None\n    } else if c0 == 'f' {\n      if slice_eq(source, start, end, \"for\") {\n        Some(TFor)\n      } else None\n    } else None\n  } else if len == 4 {\n    let c0 = String::char_code_at(source, start)\n    if c0 == 'e' {\n      if slice_eq(source, start, end, \"else\") {\n        Some(TElse)\n      } else if slice_eq(source, start, end, \"enum\") {\n        Some(TEnum)\n      } else None\n    } else if c0 == 't' {\n      if slice_eq(source, start, end, \"true\") {\n        Some(TIdent(\"true\"))\n      } else if slice_eq(source, start, end, \"type\") {\n        Some(TType)\n      } else if slice_eq(source, start, end, \"test\") {\n        Some(TTest)\n      } else None\n    } else if c0 == 'w' {\n      if slice_eq(source, start, end, \"with\") {\n        Some(TWith)\n      } else None\n    } else if c0 == 'l' {\n      if slice_eq(source, start, end, \"loop\") {\n        Some(TLoop)\n      } else None\n    } else if c0 == 'o' {\n      if slice_eq(source, start, end, \"open\") {\n        Some(TOpen)\n      } else None\n    } else if c0 == 'i' {\n      if slice_eq(source, start, end, \"impl\") {\n        Some(TImpl)\n      } else None\n    } else None\n  } else if len == 5 {\n    let c0 = String::char_code_at(source, start)\n    if c0 == 'f' {\n      if slice_eq(source, start, end, \"false\") {\n        Some(TIdent(\"false\"))\n      } else None\n    } else if c0 == 'm' {\n      if slice_eq(source, start, end, \"match\") {\n        Some(TMatch)\n      } else None\n    } else if c0 == 't' {\n      if slice_eq(source, start, end, \"trait\") {\n        Some(TTrait)\n      } else if slice_eq(source, start, end, \"throw\") {\n        Some(TThrow)\n      } else None\n    } else if c0 == 'w' {\n      if slice_eq(source, start, end, \"while\") {\n        Some(TWhile)\n      } else None\n    } else if c0 == 'b' {\n      if slice_eq(source, start, end, \"break\") {\n        Some(TBreak)\n      } else if slice_eq(source, start, end, \"bench\") {\n        Some(TBench)\n      } else None\n    } else if c0 == 'r' {\n      if slice_eq(source, start, end, \"raise\") {\n        Some(TRaise)\n      } else None\n    } else if c0 == 'y' {\n      if slice_eq(source, start, end, \"yield\") {\n        Some(TYield)\n      } else None\n    } else None\n  } else if len == 6 {\n    let c0 = String::char_code_at(source, start)\n    if c0 == 's' {\n      if slice_eq(source, start, end, \"struct\") {\n        Some(TStruct)\n      } else None\n    } else if c0 == 'e' {\n      if slice_eq(source, start, end, \"export\") {\n        Some(TExport)\n      } else None\n    } else if c0 == 'r' {\n      if slice_eq(source, start, end, \"return\") {\n        Some(TReturn)\n      } else None\n    } else if c0 == 'h' {\n      if slice_eq(source, start, end, \"handle\") {\n        Some(THandle)\n      } else None\n    } else if c0 == 'm' {\n      if slice_eq(source, start, end, \"module\") {\n        Some(TModule)\n      } else None\n    } else if c0 == 'd' {\n      if slice_eq(source, start, end, \"derive\") {\n        Some(TDerive)\n      } else None\n    } else if c0 == 'i' {\n      if slice_eq(source, start, end, \"import\") {\n        Some(TImport)\n      } else None\n    } else None\n  } else if len == 7 {\n    if slice_eq(source, start, end, \"declare\") {\n      Some(TDeclare)\n    } else None\n  } else if len == 8 {\n    let c0 = String::char_code_at(source, start)\n    if c0 == 'c' {\n      if slice_eq(source, start, end, \"continue\") {\n        Some(TContinue)\n      } else None\n    } else if c0 == 's' {\n      if slice_eq(source, start, end, \"suberror\") {\n        Some(TSuberror)\n      } else None\n    } else None\n  } else None\n}\n\nlet scan_ident_end: (String, Int, Int) -> Int = (s, len, i) -> {\n  let mut out = i\n  while out < len && is_alnum(String::char_code_at(s, out)) {\n    out = out + 1\n  }\n  out\n}\n\nlet lex_ident: (String, Int, Int) -> (Token, Int) = (s, len, i) -> {\n  let end = scan_ident_end(s, len, i)\n  if end == i + 1 && String::char_code_at(s, i) == 'r' && end < len && String::char_code_at(s, end) == '#' {\n    let ri_start = end + 1\n    let ri_end = scan_ident_end(s, len, ri_start)\n    (TIdent(s[ri_start: ri_end]), ri_end)\n  }\n  else if end == i + 1 && String::char_code_at(s, i) == 'r' && end < len && String::char_code_at(s, end) == '\"' {\n    let mut ri = end + 1\n    while ri < len && String::char_code_at(s, ri) != '\"' {\n      ri = ri + 1\n    }\n    (TString(s[end + 1: ri]), if ri >= len {\n      ri\n    } else {\n      ri + 1\n    })\n  } else {\n    match keyword_lookup(s, i, end) {\n      Some(tok) => (tok, end),\n      None => (TIdent(s[i: end]), end)\n    }\n  }\n}\n\nlet scan_digits_end: (String, Int, Int) -> Int = (s, len, i) -> {\n  let mut out = i\n  while out < len && is_digit(String::char_code_at(s, out)) {\n    out = out + 1\n  }\n  out\n}\n\nlet scan_interp_end: (String, Int, Int, Int) -> Int with { Error } = (s, len, idx, depth) -> {\n  let mut out = idx\n  let mut current_depth = depth\n  let mut found = -1\n  while out < len && found < 0 {\n    let c = String::char_code_at(s, out)\n    if c == '{' {\n      current_depth = current_depth + 1\n    } else if c == '}' {\n      if current_depth == 1 {\n        found = out\n      } else {\n        current_depth = current_depth - 1\n      }\n    }\n    if found < 0 {\n      out = out + 1\n    }\n  }\n  if found >= 0 {\n    found\n  } else {\n    throw(\"unterminated string interpolation\")\n  }\n}\n\nlet parse_frac_digits: (String, Int, Int, Double, Double) -> (Double, Int) = (s, len, i, acc, scale) -> {\n  let mut out_i = i\n  let mut out_acc = acc\n  let mut out_scale = scale\n  let mut done = false\n  while out_i < len && !done {\n    let c = String::char_code_at(s, out_i)\n    if is_digit(c) {\n      out_acc = out_acc + Int::to_double(c - 48) / out_scale\n      out_scale = out_scale * 10.0\n      out_i = out_i + 1\n    } else {\n      done = true\n    }\n  }\n  (out_acc, out_i)\n}\n\nlet empty_string_array: () -> Array[String] = () -> {\n  Array::slice([\n    \"\"\n  ], 0, 0)\n}\n\nlet skip_until_newline: (String, Int, Int) -> Int = (s, len, i) -> {\n  let mut out = i\n  let mut done = false\n  while out < len && !done {\n    if String::char_code_at(s, out) == '\\n' {\n      out = out + 1\n      done = true\n    } else {\n      out = out + 1\n    }\n  }\n  out\n}\n\nlet skip_ws_with_newline: (String, Int, Int) -> (Int, Bool) = (s, len, i) -> {\n  let mut out = i\n  let mut saw_newline = false\n  let mut skipping = true\n  while skipping && out < len {\n    let c = String::char_code_at(s, out)\n    if is_ws(c) {\n      if c == '\\n' {\n        saw_newline = true\n      } else {\n        ()\n      }\n      out = out + 1\n    } else if c == '/' && out + 1 < len && String::char_code_at(s, out + 1) == '/' {\n      let next = skip_until_newline(s, len, out + 2)\n      if next > out + 2 && String::char_code_at(s, next - 1) == '\\n' {\n        saw_newline = true\n      } else {\n        ()\n      }\n      out = next\n    } else {\n      skipping = false\n    }\n  }\n  (out, saw_newline)\n}\n\nlet concat_string_parts: (Array[String], String) -> String = (parts, tail) -> {\n  let out = StringBuilder::new()\n  let mut i = 0\n  while i < Array::length(parts) {\n    StringBuilder::push(out, Array::get(parts, i))\n    i = i + 1\n  }\n  StringBuilder::push(out, tail)\n  StringBuilder::freeze(out)\n}\n\nlet lex_string_go: (String, Int, Int, Int, Array[String], Bool, ArrayBuilder[String]) -> (Token, Int) with { Error } = (s, len, idx, start, parts_acc, has_interp, parts) -> {\n  let mut current_idx = idx\n  let mut current_start = start\n  let mut current_parts_acc = parts_acc\n  let mut current_has_interp = has_interp\n  let mut out_tok = TEof\n  let mut out_next = -1\n  let mut done = false\n  while !done {\n    if current_idx >= len {\n      throw(\"unterminated string\")\n    }\n    let c = String::char_code_at(s, current_idx)\n    if c == '\"' {\n      let value = concat_string_parts(current_parts_acc, s[current_start: current_idx])\n      if current_has_interp {\n        ArrayBuilder::push(parts, value)\n        out_tok = TStringInterp(ArrayBuilder::freeze(parts))\n        out_next = current_idx + 1\n      } else {\n        out_tok = TString(value)\n        out_next = current_idx + 1\n      }\n      done = true\n    } else if c == '\\\\' {\n      let chunk = s[current_start: current_idx]\n      let next = current_idx + 1\n      if next >= len {\n        throw(\"unterminated string escape\")\n      }\n      let esc = String::char_code_at(s, next)\n      if esc == '{' || esc == '(' {\n        ArrayBuilder::push(parts, concat_string_parts(current_parts_acc, chunk))\n        let interp_end = if esc == '{' {\n          scan_interp_end(s, len, next + 1, 1)\n        } else {\n          let mut ie = next + 1\n          let mut depth = 1\n          while ie < len && depth > 0 {\n            let ic = String::char_code_at(s, ie)\n            if ic == '(' {\n              depth = depth + 1\n            }\n            else if ic == ')' {\n              depth = depth - 1\n            }\n            ie = ie + 1\n          }\n          ie - 1\n        }\n        let expr_src = s[next + 1: interp_end]\n        ArrayBuilder::push(parts, expr_src)\n        current_idx = interp_end + 1\n        current_start = interp_end + 1\n        current_parts_acc = empty_string_array()\n        current_has_interp = true\n      } else {\n        let escaped = if esc == '\"' {\n          \"\\\"\"\n        }\n        else if esc == '\\\\' {\n          \"\\\\\"\n        }\n        else if esc == 'n' {\n          \"\\n\"\n        }\n        else if esc == 't' {\n          \"\\t\"\n        }\n        else if esc == 'r' {\n          String::from_char_code(13)\n        }\n        else if esc == '0' {\n          String::from_char_code(0)\n        }\n        else throw(\"invalid escape sequence\")\n        Array::push(current_parts_acc, chunk)\n        Array::push(current_parts_acc, escaped)\n        current_idx = next + 1\n        current_start = next + 1\n      }\n    } else {\n      current_idx = current_idx + 1\n    }\n  }\n  (out_tok, out_next)\n}\n\nlet lex_string: (String, Int, Int) -> (Token, Int) with { Error } = (s, len, i) -> {\n  lex_string_go(s, len, i + 1, i + 1, empty_string_array(), false, ArrayBuilder::new())\n}\n\nlet scan_hex_digits_end: (String, Int, Int) -> Int = (s, len, i) -> {\n  let mut out = i\n  while out < len && is_hex_digit(String::char_code_at(s, out)) {\n    out = out + 1\n  }\n  out\n}\n\nlet parse_hex_from_string: (String) -> Int = (s) -> {\n  let len = String::length(s)\n  let mut i = 0\n  let mut acc = 0\n  while i < len {\n    let c = String::char_code_at(s, i)\n    let digit = if c >= '0' && c <= '9' {\n      c - 48\n    } else if c >= 'a' && c <= 'f' {\n      c - 87\n    } else c - 55\n    acc = acc * 16 + digit\n    i = i + 1\n  }\n  acc\n}\n\nlet parse_int_from_string: (String) -> Int = (s) -> {\n  let len = String::length(s)\n  let mut i = 0\n  let mut acc = 0\n  while i < len {\n    let c = String::char_code_at(s, i)\n    acc = acc * 10 + (c - 48)\n    i = i + 1\n  }\n  acc\n}\n\nlet lex_decimal: (String, Int, Int) -> (Token, Int) with { Error } = (s, len, i) -> {\n  let int_end = scan_digits_end(s, len, i)\n  if int_end == i {\n    throw(\"expected digit\")\n  }\n  let after_field_dot = i >= 1 && String::char_code_at(s, i - 1) == '.' && (i < 2 || String::char_code_at(s, i - 2) != '.')\n  if !after_field_dot && int_end < len && String::char_code_at(s, int_end) == '.' {\n    if int_end + 1 < len && is_digit(String::char_code_at(s, int_end + 1)) {\n      let int_str = s[i: int_end]\n      let int_val = Int::to_double(parse_int_from_string(int_str))\n      let (frac_val, frac_end) = parse_frac_digits(s, len, int_end + 1, 0.0, 10.0);\n      if frac_end < len && String::char_code_at(s, frac_end) == 'f' {\n        (TFloat(int_val + frac_val), frac_end + 1)\n      } else {\n        (TFloat(int_val + frac_val), frac_end)\n      }\n    } else {\n      let int_str = s[i: int_end];\n      (TInt(parse_int_from_string(int_str)), int_end)\n    }\n  } else if int_end < len && String::char_code_at(s, int_end) == 'f' {\n    let int_str = s[i: int_end]\n    let int_val = Int::to_double(parse_int_from_string(int_str))\n    (TFloat(int_val), int_end + 1)\n  } else {\n    let int_str = s[i: int_end];\n    (TInt(parse_int_from_string(int_str)), int_end)\n  }\n}\n\nlet lex_number: (String, Int, Int) -> (Token, Int) with { Error } = (s, len, i) -> {\n  if i + 1 < len && String::char_code_at(s, i) == '0' {\n    let next_c = String::char_code_at(s, i + 1)\n    if next_c == 'x' || next_c == 'X' {\n      let hex_start = i + 2\n      let hex_end = scan_hex_digits_end(s, len, hex_start)\n      if hex_end == hex_start {\n        throw(\"expected hex digit after 0x\")\n      }\n      let hex_str = s[hex_start: hex_end];\n      (TInt(parse_hex_from_string(hex_str)), hex_end)\n    } else lex_decimal(s, len, i)\n  } else lex_decimal(s, len, i)\n}\n\nlet is_expr_ending_tok: (Token) -> Bool = (t) -> {\n  match t {\n    TRParen => true,\n    TRBracket => true,\n    TRBrace => true,\n    TIdent(_) => true,\n    TInt(_) => true,\n    TFloat(_) => true,\n    TString(_) => true,\n    _ => false\n  }\n}\n\nlet lex_one_token: (String, Int, Int) -> (Token, Int) with { Error } = (source, len, pos) -> {\n  let c = String::char_code_at(source, pos)\n  if is_alpha(c) {\n    lex_ident(source, len, pos)\n  } else if is_digit(c) {\n    lex_number(source, len, pos)\n  } else if c == '\"' {\n    lex_string(source, len, pos)\n  } else if c == '+' {\n    if pos + 1 < len && String::char_code_at(source, pos + 1) == '=' {\n      (TPlusEq, pos + 2)\n    } else (TPlus, pos + 1)\n  } else if c == '-' {\n    if pos + 1 < len && String::char_code_at(source, pos + 1) == '>' {\n      (TThinArrow, pos + 2)\n    } else if pos + 1 < len && String::char_code_at(source, pos + 1) == '=' {\n      (TMinusEq, pos + 2)\n    } else (TMinus, pos + 1)\n  } else if c == '*' {\n    if pos + 1 < len && String::char_code_at(source, pos + 1) == '=' {\n      (TStarEq, pos + 2)\n    } else (TStar, pos + 1)\n  } else if c == '/' {\n    if pos + 1 < len && String::char_code_at(source, pos + 1) == '=' {\n      (TSlashEq, pos + 2)\n    } else (TSlash, pos + 1)\n  } else if c == '%' {\n    if pos + 1 < len && String::char_code_at(source, pos + 1) == '=' {\n      (TPercentEq, pos + 2)\n    } else (TPercent, pos + 1)\n  } else if c == '=' {\n    if pos + 1 < len && String::char_code_at(source, pos + 1) == '=' {\n      (TEqEq, pos + 2)\n    } else if pos + 1 < len && String::char_code_at(source, pos + 1) == '>' {\n      (TArrow, pos + 2)\n    } else (TEq, pos + 1)\n  } else if c == '!' {\n    if pos + 1 < len && String::char_code_at(source, pos + 1) == '=' {\n      (TNeq, pos + 2)\n    } else (TNot, pos + 1)\n  } else if c == '<' {\n    if pos + 1 < len && String::char_code_at(source, pos + 1) == '=' {\n      (TLte, pos + 2)\n    } else if pos + 1 < len && String::char_code_at(source, pos + 1) == '<' {\n      (TLShift, pos + 2)\n    } else (TLt, pos + 1)\n  } else if c == '>' {\n    if pos + 1 < len && String::char_code_at(source, pos + 1) == '=' {\n      (TGte, pos + 2)\n    } else if pos + 1 < len && String::char_code_at(source, pos + 1) == '>' {\n      (TRShift, pos + 2)\n    } else (TGt, pos + 1)\n  } else if c == '&' {\n    if pos + 1 < len && String::char_code_at(source, pos + 1) == '&' {\n      (TAnd, pos + 2)\n    } else (TBitAnd, pos + 1)\n  } else if c == '|' {\n    if pos + 1 < len && String::char_code_at(source, pos + 1) == '|' {\n      (TOr, pos + 2)\n    } else if pos + 1 < len && String::char_code_at(source, pos + 1) == '>' {\n      (TPipeGt, pos + 2)\n    } else (TBitOr, pos + 1)\n  } else if c == '^' {\n    (TBitXor, pos + 1)\n  } else if c == '(' {\n    (TLParen, pos + 1)\n  } else if c == ')' {\n    (TRParen, pos + 1)\n  } else if c == '{' {\n    (TLBrace, pos + 1)\n  } else if c == '}' {\n    (TRBrace, pos + 1)\n  } else if c == '[' {\n    (TLBracket, pos + 1)\n  } else if c == ']' {\n    (TRBracket, pos + 1)\n  } else if c == ',' {\n    (TComma, pos + 1)\n  } else if c == ';' {\n    (TSemicolon, pos + 1)\n  } else if c == '.' {\n    if pos + 2 < len && String::char_code_at(source, pos + 1) == '.' && String::char_code_at(source, pos + 2) == '.' {\n      (TDotDotDot, pos + 3)\n    } else if pos + 1 < len && String::char_code_at(source, pos + 1) == '.' {\n      (TDotDot, pos + 2)\n    } else (TDot, pos + 1)\n  } else if c == ':' {\n    if pos + 1 < len && String::char_code_at(source, pos + 1) == ':' {\n      (TDoubleColon, pos + 2)\n    } else (TColon, pos + 1)\n  } else if c == '#' {\n    (THash, pos + 1)\n  } else if c == '~' {\n    (TTilde, pos + 1)\n  } else if c == '?' {\n    (TQuestion, pos + 1)\n  } else if c == '@' {\n    let mut end = pos + 1\n    while end < len {\n      let ec = String::char_code_at(source, end)\n      if is_alnum(ec) || ec == '_' || ec == '-' {\n        end = end + 1\n      } else if ec == '/' && end + 1 < len && is_alnum(String::char_code_at(source, end + 1)) {\n        end = end + 1\n      } else {\n        break\n      }\n    }\n    if end > pos + 1 {\n      (TIdent(String::substring(source, pos, end)), end)\n    } else {\n      throw(\"unexpected '@' without identifier\")\n    }\n  } else if c == '\\'' {\n    lex_char(source, len, pos)\n  } else throw(String::concat(\"unexpected character: \", String::from_char_code(c)))\n}\n\nexport let lex_with_offsets: (String) -> (Array[Token], Array[Int], Array[Int]) with { Error } = (source) -> {\n  let len = String::length(source)\n  {\n    let b = ArrayBuilder::new()\n    let starts = ArrayBuilder::new()\n    let ends = ArrayBuilder::new()\n    let mut prev_tok = TEof\n    let first_skip = skip_ws_with_newline(source, len, 0)\n    let mut pos = first_skip.0\n    let mut nl_before = first_skip.1\n    while pos < len {\n      let c = String::char_code_at(source, pos)\n      let (tok, next) = lex_one_token(source, len, pos)\n      if (c == '[' || c == '(') && nl_before && is_expr_ending_tok(prev_tok) {\n        ArrayBuilder::push(b, TSemicolon)\n        ArrayBuilder::push(starts, pos)\n        ArrayBuilder::push(ends, pos)\n      } else {\n        ()\n      }\n      ArrayBuilder::push(b, tok)\n      ArrayBuilder::push(starts, pos)\n      ArrayBuilder::push(ends, next)\n      prev_tok = tok\n      let skipped = skip_ws_with_newline(source, len, next)\n      pos = skipped.0\n      nl_before = skipped.1\n    }\n    ArrayBuilder::push(b, TEof)\n    ArrayBuilder::push(starts, len)\n    ArrayBuilder::push(ends, len)\n    (ArrayBuilder::freeze(b), ArrayBuilder::freeze(starts), ArrayBuilder::freeze(ends))\n  }\n}\n\nexport let offset_to_line_col: (String, Int) -> (Int, Int) = (source, offset) -> {\n  let len = String::length(source)\n  let bound = if offset < len { offset } else { len }\n  let mut i = 0\n  let mut line = 1\n  let mut col = 1\n  while i < bound {\n    if String::char_code_at(source, i) == 10 {\n      line = line + 1\n      col = 1\n    } else {\n      col = col + 1\n    }\n    i = i + 1\n  }\n  (line, col)\n}\n\nexport let lex: (String) -> Array[Token] with { Error } = (source) -> {\n  let len = String::length(source)\n  {\n    let b = ArrayBuilder::new()\n    let mut prev_tok = TEof\n    let first_skip = skip_ws_with_newline(source, len, 0)\n    let mut pos = first_skip.0\n    let mut nl_before = first_skip.1\n    while pos < len {\n      let c = String::char_code_at(source, pos)\n      let (tok, next) = lex_one_token(source, len, pos)\n      if (c == '[' || c == '(') && nl_before && is_expr_ending_tok(prev_tok) {\n        ArrayBuilder::push(b, TSemicolon)\n      } else {\n        ()\n      }\n      ArrayBuilder::push(b, tok)\n      prev_tok = tok\n      let skipped = skip_ws_with_newline(source, len, next)\n      pos = skipped.0\n      nl_before = skipped.1\n    }\n    ArrayBuilder::push(b, TEof)\n    ArrayBuilder::freeze(b)\n  }\n}\n\nexport let lex_ok: (String) -> Bool = (source) -> {\n  handle {\n    let _ = lex(source)\n    true\n  } with Error {\n    Throw(_) => false\n  }\n}\n")
}

let selfhost_source_7 = () -> (String, String) {
  ("lib/@vibe/parser/parser_base.vibe",
"\n\n\n\nexport let peek: (Array[Token], Int) -> Token = (tokens, pos) -> {\n  if pos < Array::length(tokens) {\n    Array::get(tokens, pos)\n  } else TEof\n}\n\nlet _no_tp: () -> Array[String] = () -> {\n  Array::slice([\n    \"\"\n  ], 0, 0)\n}\n\nlet _no_tb: () -> Array[(String, Array[String])] = () -> {\n  Array::slice([\n    (\"\", _no_tp())\n  ], 0, 0)\n}\n\nlet mode_if = 21\n\nexport let tk_name: (Token) -> String = (tok) -> {\n  match tok {\n    TInt(_) => \"int\",\n    TFloat(_) => \"float\",\n    TString(_) => \"string\",\n    TStringInterp(_) => \"string\",\n    TIdent(_) => \"ident\",\n    TLet => \"let\",\n    TRec => \"rec\",\n    TMut => \"mut\",\n    TFn => \"fn\",\n    TIf => \"if\",\n    TElse => \"else\",\n    TMatch => \"match\",\n    TIs => \"is\",\n    TDo => \"do\",\n    TEnum => \"enum\",\n    TStruct => \"struct\",\n    TType => \"type\",\n    TTrait => \"trait\",\n    TImpl => \"impl\",\n    TExport => \"export\",\n    TTest => \"test\",\n    TWhile => \"while\",\n    TFor => \"for\",\n    TIn => \"in\",\n    TLoop => \"loop\",\n    TBreak => \"break\",\n    TContinue => \"continue\",\n    TReturn => \"return\",\n    TWith => \"with\",\n    THandle => \"handle\",\n    TThrow => \"throw\",\n    TRaise => \"raise\",\n    TYield => \"yield\",\n    TBench => \"bench\",\n    TDeclare => \"declare\",\n    TAs => \"as\",\n    TModule => \"module\",\n    TSuberror => \"suberror\",\n    TDerive => \"derive\",\n    TOpen => \"open\",\n    TImport => \"import\",\n    TPlus => \"+\",\n    TMinus => \"-\",\n    TStar => \"*\",\n    TSlash => \"/\",\n    TPercent => \"%\",\n    TEqEq => \"==\",\n    TNeq => \"!=\",\n    TLt => \"<\",\n    TLte => \"<=\",\n    TGt => \">\",\n    TGte => \">=\",\n    TAnd => \"&&\",\n    TOr => \"||\",\n    TNot => \"!\",\n    TBitAnd => \"&\",\n    TBitOr => \"|\",\n    TBitXor => \"^\",\n    TLShift => \"<<\",\n    TRShift => \">>\",\n    TPipeGt => \"|>\",\n    TArrow => \"=>\",\n    TThinArrow => \"->\",\n    TEq => \"=\",\n    TDot => \".\",\n    TColon => \":\",\n    TDoubleColon => \"::\",\n    TComma => \",\",\n    TSemicolon => \";\",\n    THash => \"#\",\n    TTilde => \"~\",\n    TQuestion => \"?\",\n    TPlusEq => \"+=\",\n    TMinusEq => \"-=\",\n    TStarEq => \"*=\",\n    TSlashEq => \"/=\",\n    TPercentEq => \"%=\",\n    TLParen => \"(\",\n    TRParen => \")\",\n    TLBrace => \"{\",\n    TRBrace => \"}\",\n    TLBracket => \"[\",\n    TRBracket => \"]\",\n    TDotDot => \"..\",\n    TDotDotDot => \"...\",\n    TStringInterp(_) => \"string\",\n    TEof => \"eof\"\n  }\n}\n\nlet is_tk: (Token, String) -> Bool = (tok, name) -> {\n  tk_name(tok) == name\n}\n\nlet expect_tk: (Array[Token], Int, String) -> Int with { Error } = (tokens, pos, expected) -> {\n  if is_tk(peek(tokens, pos), expected) {\n    pos + 1\n  } else {\n    let actual = tk_name(peek(tokens, pos))\n    throw(\"expected \\{expected} but got \\{actual}\")\n  }\n}\n\nexport let skip_semi: (Array[Token], Int) -> Int = (tokens, pos) -> {\n  match peek(tokens, pos) {\n    TSemicolon => pos + 1,\n    _ => pos\n  }\n}\n\nlet empty_arms: () -> Array[(Pat, Expr)] = () -> {\n  Array::slice([\n    (PWild, EUnit)\n  ], 0, 0)\n}\n\nlet empty_pats: () -> Array[Pat] = () -> {\n  Array::slice([\n    PWild\n  ], 0, 0)\n}\n\nlet mode_block = 20\n\nlet mode_match = 22\n\nlet mode_while = 23\n\nlet empty_ctors: () -> Array[(String, Array[TypeExpr])] = () -> {\n  Array::slice([\n    (\"_\", Array::slice([\n      TyUnit\n    ], 0, 0))\n  ], 0, 0)\n}\n\nlet empty_exprs: () -> Array[Expr] = () -> {\n  Array::slice([\n    EUnit\n  ], 0, 0)\n}\n\nlet mode_for_in = 25\n\nlet mode_handle = 24\n\nexport let parse_derive_names: (Array[Token], Int) -> (Array[String], Int) with { Error } = (tokens, pos) -> {\n  let names = Array::slice([\n    \"\"\n  ], 0, 0)\n  match peek(tokens, pos) {\n    TDerive => match peek(tokens, pos + 1) {\n      TLParen => {\n        let mut dp = pos + 2\n        let mut dd = true\n        while dd {\n          match peek(tokens, dp) {\n            TRParen => {\n              dd = false\n              dp = dp + 1\n            },\n            TComma => {\n              dp = dp + 1\n            },\n            TIdent(name) => {\n              Array::push(names, name)\n              dp = dp + 1\n            },\n            _ => throw(\"expected derive identifier\")\n          }\n        }\n        (names, dp)\n      },\n      _ => (names, pos)\n    },\n    _ => (names, pos)\n  }\n}\n\nexport let skip_derive: (Array[Token], Int) -> Int with { Error } = (tokens, pos) -> {\n  let (_, next) = parse_derive_names(tokens, pos)\n  next\n}\n\nlet empty_fields: () -> Array[(String, TypeExpr)] = () -> {\n  Array::slice([\n    (\"_\", TyUnit)\n  ], 0, 0)\n}\n\nlet empty_params: () -> Array[(String, Option[TypeExpr])] = () -> {\n  Array::slice([\n    (\"\", None)\n  ], 0, 0)\n}\n\nlet rec parse_pattern: (Array[Token], Int) -> (Pat, Int) with { Error } = (tokens, pos) -> {\n  let rec parse_pat_cont: (Array[Token], Int, ArrayBuilder[Pat]) -> (Array[Pat], Int) with { Error } = (tokens, pos, b) -> {\n    match peek(tokens, pos) {\n      TComma => {\n        let (p, pn) = parse_pattern(tokens, pos + 1)\n        ArrayBuilder::push(b, p)\n        parse_pat_cont(tokens, pn, b)\n      },\n      TRParen => (ArrayBuilder::freeze(b), pos + 1),\n      _ => throw(\"expected ',' or ')' in pattern list\")\n    }\n  }\n  let parse_pats_until_rparen: (Array[Token], Int) -> (Array[Pat], Int) with { Error } = (tokens, pos) -> {\n    match peek(tokens, pos) {\n      TRParen => (empty_pats(), pos + 1),\n      _ => {\n        let (f, fn1) = parse_pattern(tokens, pos)\n        let b = ArrayBuilder::new()\n        ArrayBuilder::push(b, f)\n        parse_pat_cont(tokens, fn1, b)\n      }\n    }\n  }\n  let (pat, next) = match peek(tokens, pos) {\n    TInt(n) => (PInt(n), pos + 1),\n    TMinus => match peek(tokens, pos + 1) {\n      TInt(n) => (PInt(0 - n), pos + 2),\n      TFloat(n) => (PFloat(0.0 - n), pos + 2),\n      _ => throw(\"expected number literal after '-' in pattern\")\n    },\n    TFloat(n) => (PFloat(n), pos + 1),\n    TString(s) => (PString(s), pos + 1),\n    TIdent(name) => {\n      let next_is_lbrace = match peek(tokens, pos + 1) {\n        TLBrace => true,\n        _ => false\n      }\n      if name == \"true\" {\n        (PBool(true), pos + 1)\n      }\n      else if name == \"false\" {\n        (PBool(false), pos + 1)\n      }\n      else if name == \"_\" {\n        (PWild, pos + 1)\n      }\n      else if name == \"record\" && next_is_lbrace {\n        let mut rp = pos + 2\n        let field_pats_b = ArrayBuilder::new()\n        let mut rd = true\n        while rd {\n          match peek(tokens, rp) {\n            TRBrace => {\n              rd = false\n            },\n            TIdent(fname) => {\n              match peek(tokens, rp + 1) {\n                TColon => {\n                  let (fp, fnext) = parse_pattern(tokens, rp + 2)\n                  ArrayBuilder::push(field_pats_b, fp)\n                  rp = fnext\n                },\n                TComma => {\n                  ArrayBuilder::push(field_pats_b, PBind(fname)); rp = rp + 1\n                },\n                TRBrace => {\n                  ArrayBuilder::push(field_pats_b, PBind(fname)); rp = rp + 1\n                },\n                _ => {\n                  ArrayBuilder::push(field_pats_b, PBind(fname)); rp = rp + 1\n                }\n              }\n              match peek(tokens, rp) {\n                TComma => {\n                  rp = rp + 1\n                },\n                _ => ()\n              }\n            },\n            _ => {\n              rp = rp + 1\n            }\n          }\n        }\n        let rp2 = rp + 1\n        (PTuple(ArrayBuilder::freeze(field_pats_b)), rp2)\n      }\n      else {\n        let fc = String::char_code_at(name, 0)\n        if fc >= 65 && fc <= 90 {\n          match peek(tokens, pos + 1) {\n            TLParen => {\n              let (args, end) = parse_pats_until_rparen(tokens, pos + 2);\n              (PCtor(name, args), end)\n            },\n            TDoubleColon => match peek(tokens, pos + 2) {\n              TLBrace => {\n                let mut sp = pos + 3\n                let field_pats = ArrayBuilder::new()\n                let mut sd = true\n                while sd {\n                  match peek(tokens, sp) {\n                    TRBrace => {\n                      sd = false\n                    },\n                    TIdent(fname) => {\n                      ArrayBuilder::push(field_pats, (fname, PBind(fname)))\n                      sp = sp + 1\n                      match peek(tokens, sp) {\n                        TComma => {\n                          sp = sp + 1\n                        },\n                        _ => ()\n                      }\n                    },\n                    _ => {\n                      sd = false\n                    }\n                  }\n                }\n                (PStruct(name, ArrayBuilder::freeze(field_pats)), sp + 1)\n              },\n              TIdent(vname) => {\n                let vc = String::char_code_at(vname, 0)\n                if vc >= 65 && vc <= 90 {\n                  match peek(tokens, pos + 3) {\n                    TLParen => {\n                      let (args, end) = parse_pats_until_rparen(tokens, pos + 4);\n                      (PCtor(vname, args), end)\n                    },\n                    _ => (PCtor(vname, empty_pats()), pos + 3)\n                  }\n                } else {\n                  (PCtor(name, empty_pats()), pos + 1)\n                }\n              },\n              _ => (PCtor(name, empty_pats()), pos + 1)\n            },\n            _ => (PCtor(name, empty_pats()), pos + 1)\n          }\n        } else (PBind(name), pos + 1)\n      }\n    },\n    TLParen => match peek(tokens, pos + 1) {\n      TRParen => (PTuple(empty_pats()), pos + 2),\n      _ => {\n        let (f, n1) = parse_pattern(tokens, pos + 1)\n        match peek(tokens, n1) {\n          TRParen => (f, n1 + 1),\n          TComma => {\n            let b = ArrayBuilder::new()\n            ArrayBuilder::push(b, f)\n            let (rest, end) = parse_pat_cont(tokens, n1, b);\n            (PTuple(rest), end)\n          },\n          _ => throw(\"expected ')' or ',' in pattern\")\n        }\n      }\n    },\n    _ => {\n      let actual = tk_name(peek(tokens, pos))\n      throw(\"unexpected in pattern: \\{actual}\")\n    }\n  }\n  match peek(tokens, next) {\n    TBitOr => {\n      let (right, end) = parse_pattern(tokens, next + 1);\n      (POr(pat, right), end)\n    },\n    _ => (pat, next)\n  }\n}\n\nlet empty_type_exprs: () -> Array[TypeExpr] = () -> {\n  Array::slice([\n    TyUnit\n  ], 0, 0)\n}\n\nexport let skip_braced_body: (Array[Token], Int) -> Int = (tokens, pos) -> {\n  match peek(tokens, pos) {\n    TLBrace => {\n      let mut bp = pos + 1\n      let mut depth = 1\n      while depth > 0 {\n        match peek(tokens, bp) {\n          TLBrace => {\n            depth = depth + 1\n            bp = bp + 1\n          },\n          TRBrace => {\n            depth = depth - 1\n            bp = bp + 1\n          },\n          _ => {\n            bp = bp + 1\n          }\n        }\n      }\n      bp\n    },\n    _ => pos\n  }\n}\n\nlet parse_method_tp_bound_names: (Array[Token], Int) -> (Array[String], Int) with { Error } = (tokens, pos) -> {\n  let b = ArrayBuilder::new()\n  let mut p = pos\n  let mut done = false\n  while !done {\n    match peek(tokens, p) {\n      TIdent(name) => {\n        ArrayBuilder::push(b, name)\n        p = p + 1\n        match peek(tokens, p) {\n          TPlus => {\n            p = p + 1\n          },\n          _ => {\n            done = true\n          }\n        }\n      },\n      _ => throw(\"expected trait bound name\")\n    }\n  }\n  (ArrayBuilder::freeze(b), p)\n}\n\nlet parse_method_type_params: (Array[Token], Int) -> (Array[String], Array[(String, Array[String])], Int) with { Error } = (tokens, pos) -> {\n  let names = ArrayBuilder::new()\n  let bounds = ArrayBuilder::new()\n  let mut p = pos\n  while true {\n    match peek(tokens, p) {\n      TRBracket => {\n        p = p + 1\n        break\n      },\n      TIdent(name) => {\n        ArrayBuilder::push(names, name)\n        p = p + 1\n        match peek(tokens, p) {\n          TColon => {\n            let (bound_names, next) = parse_method_tp_bound_names(tokens, p + 1)\n            ArrayBuilder::push(bounds, (name, bound_names))\n            p = next\n          },\n          _ => ()\n        }\n        match peek(tokens, p) {\n          TComma => {\n            p = p + 1\n          },\n          TRBracket => {\n            p = p + 1\n            break\n          },\n          _ => throw(\"expected ',' or ']' in method type params\")\n        }\n      },\n      _ => throw(\"expected type parameter name or ']'\")\n    }\n  }\n  (ArrayBuilder::freeze(names), ArrayBuilder::freeze(bounds), p)\n}\n\nlet parse_trait_methods: (Array[Token], Int) -> (Array[(String, Array[TypeExpr], TypeExpr)], Array[(String, Array[String], Array[(String, Array[String])])], Int) with { Error } = (tokens, pos) -> {\n  match peek(tokens, pos) {\n    TLBrace => {\n      let sigs_b = ArrayBuilder::new()\n      let gens_b = ArrayBuilder::new()\n      let mut p = pos + 1\n      while true {\n        match peek(tokens, p) {\n          TRBrace => {\n            p = p + 1\n            break\n          },\n          TIdent(method_name) => {\n            let after_colon = match peek(tokens, p + 1) {\n              TColon => p + 2,\n              _ => p + 1\n            }\n            let (mtparams, mtbounds, after_binder) = match peek(tokens, after_colon) {\n              TLBracket => parse_method_type_params(tokens, after_colon + 1),\n              _ => (_no_tp(), _no_tb(), after_colon)\n            }\n            let (params, after_method_params) = match peek(tokens, after_binder) {\n              TLParen => {\n                let (params_ty, after_paren) = parse_type_impl(tokens, after_binder, 1)\n                let params = match params_ty {\n                  TyUnit => empty_type_exprs(),\n                  TyTuple(elems) => elems,\n                  _ => [\n                    params_ty\n                  ]\n                }\n                (params, after_paren)\n              },\n              _ => (empty_type_exprs(), after_binder)\n            }\n            let arrow_pos = expect_tk(tokens, after_method_params, \"->\")\n            let (ret_type, after_ret) = parse_type_impl(tokens, arrow_pos, 0)\n            ArrayBuilder::push(sigs_b, (method_name, params, ret_type))\n            ArrayBuilder::push(gens_b, (method_name, mtparams, mtbounds))\n            p = match peek(tokens, after_ret) {\n              TSemicolon => after_ret + 1,\n              _ => after_ret\n            }\n          },\n          _ => throw(\"expected trait method signature or '}'\")\n        }\n      }\n      (ArrayBuilder::freeze(sigs_b), ArrayBuilder::freeze(gens_b), p)\n    },\n    _ => (ArrayBuilder::freeze(ArrayBuilder::new()), ArrayBuilder::freeze(ArrayBuilder::new()), pos)\n  }\n}\n\nlet parse_trait_stmt: (Array[Token], Int, Bool) -> (Stmt, Int) with { Error } = (tokens, pos, exported) -> {\n  let empty_strings = Array::slice([\n    \"_\"\n  ], 0, 0)\n  match peek(tokens, pos) {\n    TIdent(name) => {\n      let after_name = skip_bracketed_args(tokens, pos + 1)\n      match peek(tokens, after_name) {\n        TColon => {\n          let supers = empty_strings\n          let mut p = after_name + 1\n          let mut done = false\n          while !done {\n            match peek(tokens, p) {\n              TIdent(sname) => match peek(tokens, p + 1) {\n                TPlus => {\n                  Array::push(supers, sname)\n                  p = p + 2\n                },\n                _ => {\n                  Array::push(supers, sname)\n                  p = p + 1\n                  done = true\n                }\n              },\n              _ => {\n                done = true\n              }\n            }\n          }\n          let np = p\n          let (methods, method_gens, body_end) = parse_trait_methods(tokens, np)\n          (STrait(exported, name, supers, methods, method_gens), body_end)\n        },\n        _ => {\n          let (methods, method_gens, body_end) = parse_trait_methods(tokens, after_name)\n          (STrait(exported, name, empty_strings, methods, method_gens), body_end)\n        }\n      }\n    },\n    _ => throw(\"expected trait name\")\n  }\n}\n\nlet is_expr_end_token: (Token) -> Bool = (tok) -> {\n  match tok {\n    TInt(_) => true,\n    TFloat(_) => true,\n    TString(_) => true,\n    TStringInterp(_) => true,\n    TIdent(_) => true,\n    TRParen => true,\n    TRBracket => true,\n    TRBrace => true,\n    _ => false\n  }\n}\n\nlet is_non_pipe_infix: (Token) -> Bool = (tok) -> {\n  match tok {\n    TOr => true,\n    TAnd => true,\n    TEqEq => true,\n    TNeq => true,\n    TLt => true,\n    TLte => true,\n    TGt => true,\n    TGte => true,\n    TBitOr => true,\n    TBitXor => true,\n    TBitAnd => true,\n    TLShift => true,\n    TRShift => true,\n    TPlus => true,\n    TMinus => true,\n    TStar => true,\n    TSlash => true,\n    TPercent => true,\n    _ => false\n  }\n}\n\nlet parse_import_item: (Array[Token], Int) -> ((String, Option[String]), Int) with { Error } = (tokens, pos) -> {\n  let parse_import_name: (Int) -> ((String, Option[String]), Int) with { Error } = (name_pos) -> {\n    match peek(tokens, name_pos) {\n      TIdent(name) => {\n        let (base, after) = match peek(tokens, name_pos + 1) {\n          TDoubleColon => match peek(tokens, name_pos + 2) {\n            TIdent(member) =>\n            (String::concat(name, String::concat(\"::\", member)), name_pos + 3),\n            _ => throw(\"expected qualified member name after '::'\")\n          },\n          _ => (name, name_pos + 1)\n        }\n        match peek(tokens, after) {\n          TAs => match peek(tokens, after + 1) {\n            TIdent(alias) => ((base, Some(alias)), after + 2),\n            _ => throw(\"expected alias name after 'as'\")\n          },\n          _ => ((base, None), after)\n        }\n      },\n      _ => throw(\"expected import item name\")\n    }\n  }\n  match peek(tokens, pos) {\n    TIdent(_) => parse_import_name(pos),\n    TType => parse_import_name(pos + 1),\n    TTrait => parse_import_name(pos + 1),\n    _ => throw(\"expected import item name\")\n  }\n}\n\nlet empty_import_items: () -> Array[(String, Option[String])] = () -> {\n  Array::slice([\n    (\"_\", None)\n  ], 0, 0)\n}\n\nlet parse_binding_name: (Array[Token], Int) -> (String, Int) with { Error } = (tokens, pos) -> {\n  match peek(tokens, pos) {\n    TIdent(name) => match peek(tokens, pos + 1) {\n      TDoubleColon => match peek(tokens, pos + 2) {\n        TIdent(member) => (String::concat(name, String::concat(\"::\", member)), pos + 3),\n        _ => throw(\"expected qualified member name after '::'\")\n      },\n      _ => (name, pos + 1)\n    },\n    _ => throw(\"expected name after 'let'\")\n  }\n}\n\nexport let rec collect_import_path: (Array[Token], Int, String) -> (String, Int) with { Error } = (tokens, pos, acc) -> {\n  match peek(tokens, pos) {\n    TLBrace => (acc, pos),\n    TDot => collect_import_path(tokens, pos + 1, String::concat(acc, \".\")),\n    TDotDot => collect_import_path(tokens, pos + 1, String::concat(acc, \"..\")),\n    TSlash => collect_import_path(tokens, pos + 1, String::concat(acc, \"/\")),\n    TIdent(name) => if String::length(name) > 0 && String::char_code_at(name, 0) == '@' && !String::ends_with(acc, \"/\") {\n      (acc, pos)\n    } else {\n      collect_import_path(tokens, pos + 1, String::concat(acc, name))\n    },\n    TMinus => collect_import_path(tokens, pos + 1, String::concat(acc, \"-\")),\n    TModule => collect_import_path(tokens, pos + 1, String::concat(acc, \"module\")),\n    TImpl => collect_import_path(tokens, pos + 1, String::concat(acc, \"impl\")),\n    TType => collect_import_path(tokens, pos + 1, String::concat(acc, \"type\")),\n    TMatch => collect_import_path(tokens, pos + 1, String::concat(acc, \"match\")),\n    TTest => collect_import_path(tokens, pos + 1, String::concat(acc, \"test\")),\n    _ => {\n      let actual = tk_name(peek(tokens, pos))\n      throw(String::concat(\"unexpected token in import path: \", actual))\n    }\n  }\n}\n\nlet skip_bracketed_args: (Array[Token], Int) -> Int = (tokens, pos) -> {\n  match peek(tokens, pos) {\n    TLBracket => {\n      let mut bp = pos + 1\n      let mut depth = 1\n      while depth > 0 {\n        match peek(tokens, bp) {\n          TLBracket => {\n            depth = depth + 1\n            bp = bp + 1\n          },\n          TRBracket => {\n            depth = depth - 1\n            bp = bp + 1\n          },\n          TEof => {\n            depth = 0\n          },\n          _ => {\n            bp = bp + 1\n          }\n        }\n      }\n      bp\n    },\n    _ => pos\n  }\n}\n\nlet rec collect_effect_names: (Array[Token], Int, String) -> (String, Int) with { Error } = (tokens, pos, acc) -> {\n  match peek(tokens, pos) {\n    TRBrace => (acc, pos + 1),\n    TIdent(name) => {\n      let new_acc = if String::length(acc) == 0 {\n        name\n      } else \"\\{acc}, \\{name}\"\n      match peek(tokens, pos + 1) {\n        TComma => collect_effect_names(tokens, pos + 2, new_acc),\n        TRBrace => (new_acc, pos + 2),\n        _ => throw(\"expected ',' or '}' in effect list\")\n      }\n    },\n    _ => throw(\"expected effect name or '}'\")\n  }\n}\n\nlet rec parse_type_impl: (Array[Token], Int, Int) -> (TypeExpr, Int) with { Error } = (tokens, pos, mode) -> {\n  let rec type_list_rest: (Array[Token], Int, ArrayBuilder[TypeExpr]) -> (Array[TypeExpr], Int) with { Error } = (tokens, pos, b) -> {\n    match peek(tokens, pos) {\n      TComma => match peek(tokens, pos + 1) {\n        TRParen|TRBracket => (ArrayBuilder::freeze(b), pos + 1),\n        _ => {\n          let ts = match peek(tokens, pos + 1) {\n            TIdent(_) => match peek(tokens, pos + 2) {\n              TColon => pos + 3,\n              TTilde => match peek(tokens, pos + 3) {\n                TColon => pos + 4,\n                _ => pos + 1\n              },\n              TQuestion => match peek(tokens, pos + 3) {\n                TColon => pos + 4,\n                _ => pos + 1\n              },\n              _ => pos + 1\n            },\n            _ => pos + 1\n          }\n          let (ty, next) = parse_type_impl(tokens, ts, 0)\n          ArrayBuilder::push(b, ty)\n          type_list_rest(tokens, next, b)\n        }\n      }\n      ,\n      _ => (ArrayBuilder::freeze(b), pos)\n    }\n  }\n  let parse_effect_suffix: (Array[Token], Int) -> (Option[String], Int) with { Error } = (tokens, rn) -> {\n    match peek(tokens, rn) {\n      TWith => {\n        let with_pos = expect_tk(tokens, rn + 1, \"{\")\n        let effect_name_pair = collect_effect_names(tokens, with_pos, \"\")\n        (Some(effect_name_pair.0), effect_name_pair.1)\n      },\n      _ => (None, rn)\n    }\n  }\n  if mode == 0 {\n    match peek(tokens, pos) {\n      TLParen => match peek(tokens, pos + 1) {\n        TRParen => {\n          let after = pos + 2\n          match peek(tokens, after) {\n            TThinArrow => {\n              let (ret, rn) = parse_type_impl(tokens, after + 1, 0)\n              let eff = parse_effect_suffix(tokens, rn)\n              (TyFn(empty_type_exprs(), ret, eff.0), eff.1)\n            },\n            _ => (TyUnit, after)\n          }\n        },\n        _ => {\n          let ty_start = match peek(tokens, pos + 1) {\n            TIdent(_) => match peek(tokens, pos + 2) {\n              TColon => pos + 3,\n              TTilde => match peek(tokens, pos + 3) {\n                TColon => pos + 4,\n                _ => pos + 1\n              },\n              TQuestion => match peek(tokens, pos + 3) {\n                TColon => pos + 4,\n                _ => pos + 1\n              },\n              _ => pos + 1\n            },\n            _ => pos + 1\n          }\n          let (first, n1) = parse_type_impl(tokens, ty_start, 0)\n          let (elems, after) = match peek(tokens, n1) {\n            TRParen => ([\n              first\n            ], n1 + 1),\n            TComma => {\n              let b = ArrayBuilder::new()\n              ArrayBuilder::push(b, first)\n              let (rest, end) = type_list_rest(tokens, n1, b)\n              let en = expect_tk(tokens, end, \")\");\n              (rest, en)\n            },\n            _ => throw(\"expected ')' or ',' in type\")\n          }\n          match peek(tokens, after) {\n            TThinArrow => {\n              let (ret, rn) = parse_type_impl(tokens, after + 1, 0)\n              let eff = parse_effect_suffix(tokens, rn)\n              (TyFn(elems, ret, eff.0), eff.1)\n            },\n            _ => {\n              let atom = if Array::length(elems) == 1 {\n                Array::get(elems, 0)\n              } else {\n                TyTuple(elems)\n              }\n              match peek(tokens, after) {\n                TQuestion => (TyApp(\"Option\", [\n                  atom\n                ]), after + 1),\n                _ => (atom, after)\n              }\n            }\n          }\n        }\n      },\n      _ => {\n        let (atom_ty, atom_next) = parse_type_impl(tokens, pos, 1)\n        match peek(tokens, atom_next) {\n          TThinArrow => {\n            let (ret, rn) = parse_type_impl(tokens, atom_next + 1, 0)\n            let eff = parse_effect_suffix(tokens, rn)\n            (TyFn([\n              atom_ty\n            ], ret, eff.0), eff.1)\n          },\n          _ => (atom_ty, atom_next)\n        }\n      }\n    }\n  } else {\n    let (base_ty, base_next) = match peek(tokens, pos) {\n      TLParen => match peek(tokens, pos + 1) {\n        TRParen => (TyUnit, pos + 2),\n        _ => {\n          let ty_start = match peek(tokens, pos + 1) {\n            TIdent(_) => match peek(tokens, pos + 2) {\n              TColon => pos + 3,\n              TTilde => match peek(tokens, pos + 3) {\n                TColon => pos + 4,\n                _ => pos + 1\n              },\n              TQuestion => match peek(tokens, pos + 3) {\n                TColon => pos + 4,\n                _ => pos + 1\n              },\n              _ => pos + 1\n            },\n            _ => pos + 1\n          }\n          let (first, n1) = parse_type_impl(tokens, ty_start, 0)\n          match peek(tokens, n1) {\n            TRParen => (first, n1 + 1),\n            TComma => {\n              let b = ArrayBuilder::new()\n              ArrayBuilder::push(b, first)\n              let (rest, end) = type_list_rest(tokens, n1, b)\n              let en = expect_tk(tokens, end, \")\");\n              (TyTuple(rest), en)\n            },\n            _ => throw(\"expected ')' or ',' in type\")\n          }\n        }\n      },\n      TIdent(name) => match peek(tokens, pos + 1) {\n        TLBracket => {\n          let (first, n1) = parse_type_impl(tokens, pos + 2, 0)\n          match peek(tokens, n1) {\n            TRBracket => (TyApp(name, [\n              first\n            ]), n1 + 1),\n            TComma => {\n              let b = ArrayBuilder::new()\n              ArrayBuilder::push(b, first)\n              let (rest, end) = type_list_rest(tokens, n1, b)\n              let en = expect_tk(tokens, end, \"]\");\n              (TyApp(name, rest), en)\n            },\n            _ => throw(\"expected ']' or ',' in type application\")\n          }\n        },\n        _ => (TyName(name), pos + 1)\n      },\n      _ => {\n        let actual = tk_name(peek(tokens, pos))\n        throw(\"expected type but got \\{actual}\")\n      }\n    }\n    match peek(tokens, base_next) {\n      TQuestion => (TyApp(\"Option\", [\n        base_ty\n      ]), base_next + 1),\n      _ => (base_ty, base_next)\n    }\n  }\n}\n\nexport let parse_type: (Array[Token], Int) -> (TypeExpr, Int) with { Error } = (tokens, pos) -> {\n  parse_type_impl(tokens, pos, 0)\n}\n\nlet parse_one_param: (Array[Token], Int) -> ((String, Option[TypeExpr]), Int) with { Error } = (tokens, pos) -> {\n  match peek(tokens, pos) {\n    TIdent(name) => match peek(tokens, pos + 1) {\n      TTilde => {\n        let labeled_name = \"\\{name}~\"\n        match peek(tokens, pos + 2) {\n          TColon => {\n            let (ty, tp) = parse_type_impl(tokens, pos + 3, 0);\n            ((labeled_name, Some(ty)), tp)\n          },\n          _ => ((labeled_name, None), pos + 2)\n        }\n      },\n      TQuestion => {\n        let opt_name = \"\\{name}?\"\n        match peek(tokens, pos + 2) {\n          TColon => {\n            let (ty, tp) = parse_type_impl(tokens, pos + 3, 0);\n            ((opt_name, Some(ty)), tp)\n          },\n          _ => ((opt_name, None), pos + 2)\n        }\n      },\n      TColon => {\n        let (ty, tp) = parse_type_impl(tokens, pos + 2, 0);\n        let tp2 = match peek(tokens, tp) {\n          TColon => {\n            let mut bp = tp + 1\n            let mut bd = true\n            while bd {\n              match peek(tokens, bp) {\n                TIdent(_) => {\n                  bp = bp + 1; match peek(tokens, bp) {\n                    TPlus => {\n                      bp = bp + 1\n                    },\n                    _ => {\n                      bd = false\n                    }\n                  }\n                },\n                _ => {\n                  bd = false\n                }\n              }\n            }\n            bp\n          },\n          _ => tp\n        }\n        ((name, Some(ty)), tp2)\n      },\n      _ => ((name, None), pos + 1)\n    },\n    _ => {\n      let actual = tk_name(peek(tokens, pos))\n      throw(\"expected parameter name at #\\{pos} token=\\{actual}\")\n    }\n  }\n}\n\nlet rec parse_param_cont: (Array[Token], Int, ArrayBuilder[(String, Option[TypeExpr])]) -> (Array[(String, Option[TypeExpr])], Int) with { Error } = (tokens, pos, b) -> {\n  match peek(tokens, pos) {\n    TComma => match peek(tokens, pos + 1) {\n      TRParen => (ArrayBuilder::freeze(b), pos + 2),\n      _ => {\n        let (p, pn) = parse_one_param(tokens, pos + 1)\n        ArrayBuilder::push(b, p)\n        parse_param_cont(tokens, pn, b)\n      }\n    },\n    TRParen => (ArrayBuilder::freeze(b), pos + 1),\n    _ => {\n      let actual = tk_name(peek(tokens, pos))\n      throw(\"expected ',' or ')' in param list at #\\{pos} token=\\{actual}\")\n    }\n  }\n}\n\nlet parse_param_list: (Array[Token], Int) -> (Array[(String, Option[TypeExpr])], Int) with { Error } = (tokens, pos) -> {\n  match peek(tokens, pos) {\n    TRParen => (empty_params(), pos + 1),\n    _ => {\n      let (f, fn1) = parse_one_param(tokens, pos)\n      let b = ArrayBuilder::new()\n      ArrayBuilder::push(b, f)\n      parse_param_cont(tokens, fn1, b)\n    }\n  }\n}\n\nlet parse_struct_field: (Array[Token], Int) -> ((String, TypeExpr), Bool, Int) with { Error } = (tokens, pos) -> {\n  let (is_mut, p) = match peek(tokens, pos) {\n    TMut => (true, pos + 1),\n    _ => (false, pos)\n  }\n  match peek(tokens, p) {\n    TIdent(name) => {\n      let cn = expect_tk(tokens, p + 1, \":\")\n      let (ty, next) = parse_type_impl(tokens, cn, 0);\n      ((name, ty), is_mut, next)\n    },\n    _ => throw(\"expected field name\")\n  }\n}\n\nlet rec is_lambda_start_impl: (Array[Token], Int, Int, Int, Bool) -> Bool = (tokens, pos, depth, bdepth, has_colon) -> {\n  match peek(tokens, pos) {\n    TColon => if depth == 0 && bdepth == 0 {\n      is_lambda_start_impl(tokens, pos + 1, depth, bdepth, true)\n    } else is_lambda_start_impl(tokens, pos + 1, depth, bdepth, has_colon),\n    TRParen => if depth == 0 {\n      match peek(tokens, pos + 1) {\n        TThinArrow => true,\n        TLBrace => has_colon,\n        _ => false\n      }\n    } else is_lambda_start_impl(tokens, pos + 1, depth - 1, bdepth, has_colon),\n    TLParen => is_lambda_start_impl(tokens, pos + 1, depth + 1, bdepth, has_colon),\n    TLBracket => is_lambda_start_impl(tokens, pos + 1, depth, bdepth + 1, has_colon),\n    TRBracket => is_lambda_start_impl(tokens, pos + 1, depth, bdepth - 1, has_colon),\n    TEof => false,\n    _ => is_lambda_start_impl(tokens, pos + 1, depth, bdepth, has_colon)\n  }\n}\n\nlet is_lambda_start: (Array[Token], Int) -> Bool = (tokens, pos) -> {\n  is_lambda_start_impl(tokens, pos, 0, 0, false)\n}\n\nlet rec parse_ctor_types_rest: (Array[Token], Int, ArrayBuilder[TypeExpr]) -> (Array[TypeExpr], Int) with { Error } = (tokens, pos, b) -> {\n  match peek(tokens, pos) {\n    TComma => {\n      let (ty, next) = parse_type_impl(tokens, pos + 1, 0)\n      ArrayBuilder::push(b, ty)\n      parse_ctor_types_rest(tokens, next, b)\n    },\n    TRParen => (ArrayBuilder::freeze(b), pos + 1),\n    _ => throw(\"expected ',' or ')' in constructor types\")\n  }\n}\n\nlet parse_enum_ctor: (Array[Token], Int) -> ((String, Array[TypeExpr]), Int) with { Error } = (tokens, pos) -> {\n  match peek(tokens, pos) {\n    TIdent(name) => match peek(tokens, pos + 1) {\n      TLParen => match peek(tokens, pos + 2) {\n        TRParen => ((name, empty_type_exprs()), pos + 3),\n        _ => {\n          let (first, n1) = parse_type_impl(tokens, pos + 2, 0)\n          let b = ArrayBuilder::new()\n          ArrayBuilder::push(b, first)\n          let (types, end) = parse_ctor_types_rest(tokens, n1, b);\n          ((name, types), end)\n        }\n      },\n      _ => ((name, empty_type_exprs()), pos + 1)\n    },\n    _ => throw(\"expected constructor name\")\n  }\n}\n\nlet rec parse_enum_ctors_rest: (Array[Token], Int, ArrayBuilder[(String, Array[TypeExpr])]) -> (Array[(String, Array[TypeExpr])], Int) with { Error } = (tokens, pos, b) -> {\n  match peek(tokens, pos) {\n    TSemicolon => match peek(tokens, pos + 1) {\n      TRBrace => (ArrayBuilder::freeze(b), pos + 2),\n      _ => {\n        let (ctor, next) = parse_enum_ctor(tokens, pos + 1)\n        ArrayBuilder::push(b, ctor)\n        parse_enum_ctors_rest(tokens, next, b)\n      }\n    },\n    TComma => match peek(tokens, pos + 1) {\n      TRBrace => (ArrayBuilder::freeze(b), pos + 2),\n      _ => {\n        let (ctor, next) = parse_enum_ctor(tokens, pos + 1)\n        ArrayBuilder::push(b, ctor)\n        parse_enum_ctors_rest(tokens, next, b)\n      }\n    },\n    TRBrace => (ArrayBuilder::freeze(b), pos + 1),\n    _ => throw(\"expected ';', ',' or '}' in enum\")\n  }\n}\n\nlet parse_enum_ctors: (Array[Token], Int) -> (Array[(String, Array[TypeExpr])], Int) with { Error } = (tokens, pos) -> {\n  match peek(tokens, pos) {\n    TRBrace => (empty_ctors(), pos + 1),\n    _ => {\n      let (first, next) = parse_enum_ctor(tokens, pos)\n      let b = ArrayBuilder::new()\n      ArrayBuilder::push(b, first)\n      parse_enum_ctors_rest(tokens, next, b)\n    }\n  }\n}\n\nlet parse_enum_stmt: (Array[Token], Int, Bool) -> (Stmt, Int) with { Error } = (tokens, pos, exported) -> {\n  match peek(tokens, pos) {\n    TIdent(name) => {\n      let (params, after_name) = match peek(tokens, pos + 1) {\n        TLBracket => {\n          let b = ArrayBuilder::new()\n          let mut skip = pos + 2\n          let mut depth = 1\n          let mut expect_name = true\n          while depth > 0 {\n            match peek(tokens, skip) {\n              TLBracket => {\n                depth = depth + 1; skip = skip + 1\n              },\n              TRBracket => {\n                depth = depth - 1; skip = skip + 1\n              },\n              TComma => {\n                if depth == 1 {\n                  expect_name = true\n                }\n                skip = skip + 1\n              },\n              TIdent(nm) => {\n                if depth == 1 && expect_name {\n                  ArrayBuilder::push(b, nm)\n                  expect_name = false\n                }\n                skip = skip + 1\n              },\n              _ => {\n                skip = skip + 1\n              }\n            }\n          }\n          (ArrayBuilder::freeze(b), skip)\n        },\n        _ => (Array::slice([\n          \"\"\n        ], 0, 0), pos + 1)\n      }\n      let br = expect_tk(tokens, after_name, \"{\")\n      let (ctors, end) = parse_enum_ctors(tokens, br);\n      let (derives, final_pos) = parse_derive_names(tokens, end)\n      (SEnum(exported, name, params, ctors, derives), final_pos)\n    },\n    _ => throw(\"expected enum name\")\n  }\n}\n\nlet parse_suberror_stmt: (Array[Token], Int, Bool) -> (Stmt, Int) with { Error } = (tokens, pos, exported) -> {\n  match peek(tokens, pos) {\n    TIdent(name) => match peek(tokens, pos + 1) {\n      TLParen => match peek(tokens, pos + 2) {\n        TRParen => {\n          let b = ArrayBuilder::new()\n          ArrayBuilder::push(b, (name, empty_type_exprs()))\n          (SSuberror(exported, name, ArrayBuilder::freeze(b)), pos + 3)\n        },\n        _ => {\n          let (first, n1) = parse_type_impl(tokens, pos + 2, 0)\n          let args_b = ArrayBuilder::new()\n          ArrayBuilder::push(args_b, first)\n          let (args, end) = parse_ctor_types_rest(tokens, n1, args_b)\n          let ctors_b = ArrayBuilder::new()\n          ArrayBuilder::push(ctors_b, (name, args))\n          (SSuberror(exported, name, ArrayBuilder::freeze(ctors_b)), end)\n        }\n      },\n      TLBrace => {\n        let (ctors, end) = parse_enum_ctors(tokens, pos + 2);\n        (SSuberror(exported, name, ctors), end)\n      },\n      _ => throw(\"expected '(' or '{' after suberror name\")\n    },\n    _ => throw(\"expected suberror name\")\n  }\n}\n\nlet parse_impl_bound_names: (Array[Token], Int) -> (Array[String], Int) with { Error } = (tokens, pos) -> {\n  let b = ArrayBuilder::new()\n  let mut p = pos\n  let mut done = false\n  while !done {\n    match peek(tokens, p) {\n      TIdent(name) => {\n        ArrayBuilder::push(b, name)\n        p = p + 1\n        match peek(tokens, p) {\n          TPlus => {\n            p = p + 1\n          },\n          _ => {\n            done = true\n          }\n        }\n      },\n      _ => throw(\"expected trait bound name\")\n    }\n  }\n  (ArrayBuilder::freeze(b), p)\n}\n\nlet parse_impl_type_params: (Array[Token], Int) -> (Array[String], Array[(String, Array[String])], Int) with { Error } = (tokens, pos) -> {\n  let names = ArrayBuilder::new()\n  let bounds = ArrayBuilder::new()\n  let mut p = pos\n  while true {\n    match peek(tokens, p) {\n      TRBracket => {\n        p = p + 1\n        break\n      },\n      TIdent(name) => {\n        ArrayBuilder::push(names, name)\n        p = p + 1\n        match peek(tokens, p) {\n          TColon => {\n            let (bound_names, next) = parse_impl_bound_names(tokens, p + 1)\n            ArrayBuilder::push(bounds, (name, bound_names))\n            p = next\n          },\n          _ => ()\n        }\n        match peek(tokens, p) {\n          TComma => {\n            p = p + 1\n          },\n          TRBracket => {\n            p = p + 1\n            break\n          },\n          _ => throw(\"expected ',' or ']' in impl type params\")\n        }\n      },\n      _ => throw(\"expected type parameter name or ']'\")\n    }\n  }\n  (ArrayBuilder::freeze(names), ArrayBuilder::freeze(bounds), p)\n}\n\nlet parse_impl_stmt: (Array[Token], Int) -> (Stmt, Int) with { Error } = (tokens, pos) -> {\n  let (type_params, type_bounds, after_tp) = match peek(tokens, pos) {\n    TLBracket => parse_impl_type_params(tokens, pos + 1),\n    _ => (_no_tp(), _no_tb(), pos)\n  }\n  match peek(tokens, after_tp) {\n    TIdent(trait_name) => {\n      let fp = expect_tk(tokens, after_tp + 1, \"for\")\n      match peek(tokens, fp) {\n        TIdent(type_name) => {\n          let after_targs = skip_bracketed_args(tokens, fp + 1)\n          (SImpl(type_params, type_bounds, trait_name, type_name), after_targs)\n        },\n        _ => throw(\"expected type name after 'for'\")\n      }\n    },\n    _ => throw(\"expected trait name after 'impl'\")\n  }\n}\n\nlet parse_type_params_list: (Array[Token], Int) -> (Array[String], Int) with { Error } = (tokens, pos) -> {\n  let b = ArrayBuilder::new()\n  let mut p = pos\n  while true {\n    match peek(tokens, p) {\n      TRBracket => {\n        p = p + 1\n        break\n      },\n      TIdent(name) => {\n        ArrayBuilder::push(b, name)\n        p = p + 1\n        match peek(tokens, p) {\n          TComma => {\n            p = p + 1\n          },\n          TRBracket => {\n            p = p + 1\n            break\n          },\n          _ => throw(\"expected ',' or ']' in type params\")\n        }\n      },\n      _ => throw(\"expected type parameter name or ']'\")\n    }\n  }\n  (ArrayBuilder::freeze(b), p)\n}\n\nlet parse_effect_stmt: (Array[Token], Int, Bool) -> (Stmt, Int) with { Error } = (tokens, pos, exported) -> {\n  match peek(tokens, pos) {\n    TIdent(name) => {\n      let (type_params, after_params) = match peek(tokens, pos + 1) {\n        TLBracket => parse_type_params_list(tokens, pos + 2),\n        _ => (ArrayBuilder::freeze(ArrayBuilder::new()), pos + 1)\n      }\n      let br = expect_tk(tokens, after_params, \"{\")\n      let ops_b = ArrayBuilder::new()\n      let mut p = br\n      while true {\n        match peek(tokens, p) {\n          TRBrace => {\n            p = p + 1\n            break\n          },\n          TIdent(op_name) => {\n            let (params, after_op_params) = match peek(tokens, p + 1) {\n              TLParen => {\n                let (params_ty, after_paren) = parse_type_impl(tokens, p + 1, 1)\n                let params = match params_ty {\n                  TyUnit => empty_type_exprs(),\n                  TyTuple(elems) => elems,\n                  _ => [\n                    params_ty\n                  ]\n                }\n                (params, after_paren)\n              },\n              _ => (empty_type_exprs(), p + 1)\n            }\n            let arrow_pos = expect_tk(tokens, after_op_params, \"->\")\n            let (ret_type, after_ret) = parse_type_impl(tokens, arrow_pos, 0)\n            ArrayBuilder::push(ops_b, (op_name, params, ret_type))\n            p = match peek(tokens, after_ret) {\n              TSemicolon => after_ret + 1,\n              _ => after_ret\n            }\n          },\n          _ => throw(\"expected effect operation name or '}'\")\n        }\n      }\n      (SEffectDef(exported, name, type_params, ArrayBuilder::freeze(ops_b)), p)\n    },\n    _ => throw(\"expected effect name\")\n  }\n}\n\nlet parse_type_alias_stmt: (Array[Token], Int, Bool) -> (Stmt, Int) with { Error } = (tokens, pos, exported) -> {\n  match peek(tokens, pos) {\n    TIdent(name) => {\n      let (params, after_name) = match peek(tokens, pos + 1) {\n        TLBracket => parse_type_params_list(tokens, pos + 2),\n        _ => (Array::slice([\n          \"\"\n        ], 0, 0), pos + 1)\n      }\n      let ep = expect_tk(tokens, after_name, \"=\")\n      let (ty, next) = parse_type_impl(tokens, ep, 0);\n      (STypeAlias(exported, name, params, ty), next)\n    },\n    _ => throw(\"expected type alias name\")\n  }\n}\n\nlet parse_impl_stmt_dispatch: (Array[Token], Int) -> (Stmt, Int) with { Error } = (tokens, pos) -> {\n  parse_impl_stmt(tokens, pos)\n}\n\nlet push_mut_name: (ArrayBuilder[String], (String, TypeExpr), Bool) -> Unit = (mb, field, is_mut) -> {\n  if is_mut {\n    let (fname, _) = field\n    ArrayBuilder::push(mb, fname)\n  } else {\n    ()\n  }\n}\n\nlet rec parse_struct_fields_rest: (Array[Token], Int, ArrayBuilder[(String, TypeExpr)], ArrayBuilder[String]) -> (Array[(String, TypeExpr)], Array[String], Int) with { Error } = (tokens, pos, b, mb) -> {\n  match peek(tokens, pos) {\n    TSemicolon => match peek(tokens, pos + 1) {\n      TRBrace => (ArrayBuilder::freeze(b), ArrayBuilder::freeze(mb), pos + 2),\n      _ => {\n        let (field, is_mut, next) = parse_struct_field(tokens, pos + 1)\n        ArrayBuilder::push(b, field)\n        push_mut_name(mb, field, is_mut)\n        parse_struct_fields_rest(tokens, next, b, mb)\n      }\n    },\n    TComma => match peek(tokens, pos + 1) {\n      TRBrace => (ArrayBuilder::freeze(b), ArrayBuilder::freeze(mb), pos + 2),\n      _ => {\n        let (field, is_mut, next) = parse_struct_field(tokens, pos + 1)\n        ArrayBuilder::push(b, field)\n        push_mut_name(mb, field, is_mut)\n        parse_struct_fields_rest(tokens, next, b, mb)\n      }\n    },\n    TRBrace => (ArrayBuilder::freeze(b), ArrayBuilder::freeze(mb), pos + 1),\n    _ => throw(\"expected ';', ',' or '}' in struct\")\n  }\n}\n\nlet parse_struct_fields: (Array[Token], Int) -> (Array[(String, TypeExpr)], Array[String], Int) with { Error } = (tokens, pos) -> {\n  match peek(tokens, pos) {\n    TRBrace => (empty_fields(), Array::slice([\n      \"\"\n    ], 0, 0), pos + 1),\n    _ => {\n      let (first, is_mut, next) = parse_struct_field(tokens, pos)\n      let b = ArrayBuilder::new()\n      let mb = ArrayBuilder::new()\n      ArrayBuilder::push(b, first)\n      push_mut_name(mb, first, is_mut)\n      parse_struct_fields_rest(tokens, next, b, mb)\n    }\n  }\n}\n\nlet parse_struct_stmt: (Array[Token], Int, Bool) -> (Stmt, Int) with { Error } = (tokens, pos, exported) -> {\n  match peek(tokens, pos) {\n    TIdent(name) => {\n      let after_name = skip_bracketed_args(tokens, pos + 1)\n      let br = expect_tk(tokens, after_name, \"{\")\n      let (fields, mut_names, end) = parse_struct_fields(tokens, br);\n      let (derives, final_pos) = parse_derive_names(tokens, end)\n      (SStruct(exported, name, fields, derives, mut_names), final_pos)\n    },\n    _ => throw(\"expected struct name\")\n  }\n}\n\n\nexport {\n  _no_tb, _no_tp, collect_effect_names, collect_import_path, empty_arms, empty_exprs, empty_fields, empty_import_items, empty_params, empty_pats, empty_type_exprs, expect_tk, is_expr_end_token, is_lambda_start, is_non_pipe_infix, is_tk, mode_block, mode_for_in, mode_handle, mode_if, mode_match, mode_while, parse_binding_name, parse_effect_stmt, parse_enum_stmt, parse_impl_stmt_dispatch, parse_import_item, parse_param_list, parse_pattern, parse_struct_field, parse_struct_stmt, parse_suberror_stmt, parse_trait_stmt, parse_type, parse_type_alias_stmt, parse_type_impl, parse_derive_names, peek, skip_derive, skip_semi, tk_name\n}\n\nexport {\n  peek, is_tk, _no_tb, _no_tp, mode_if, tk_name, expect_tk, skip_semi, skip_derive, parse_derive_names, empty_arms, empty_pats, mode_block, mode_match, mode_while, parse_type, empty_exprs, mode_for_in, mode_handle, empty_fields, empty_params, parse_pattern, is_lambda_start, parse_enum_stmt, parse_type_impl, empty_type_exprs, parse_param_list, parse_trait_stmt, is_expr_end_token, is_non_pipe_infix, parse_effect_stmt, parse_import_item, parse_struct_stmt, empty_import_items, parse_binding_name, parse_struct_field, collect_import_path, parse_suberror_stmt, collect_effect_names, parse_type_alias_stmt, parse_impl_stmt_dispatch\n}\n\nexport {\n  peek, is_tk, _no_tb, _no_tp, mode_if, tk_name, expect_tk, skip_semi, empty_arms, empty_pats, mode_block, mode_match, mode_while, parse_type, empty_exprs, mode_for_in, mode_handle, skip_derive, parse_derive_names, empty_fields, empty_params, parse_pattern, is_lambda_start, parse_enum_stmt, parse_type_impl, empty_type_exprs, parse_param_list, parse_trait_stmt, is_expr_end_token, is_non_pipe_infix, parse_effect_stmt, parse_import_item, parse_struct_stmt, empty_import_items, parse_binding_name, parse_struct_field, collect_import_path, parse_suberror_stmt, collect_effect_names, parse_type_alias_stmt, parse_impl_stmt_dispatch\n}\n")
}

let selfhost_source_8 = () -> (String, String) {
  ("lib/@vibe/parser/parser_expr_primary.vibe",
"\n\n\n\n\n\nlet build_interp_expr: (Array[String], (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> Expr with { Error } = (parts, parse_recur) -> {\n  let concat_expr: (Expr, Expr) -> Expr = (a, b) -> {\n    ECall(EIdent(\"String::concat\", -1), [\n      a,\n      b\n    ], -1)\n  }\n  let plen = Array::length(parts)\n  let mut result = EString(\"\")\n  let mut has_val = false\n  let mut i = 0\n  while i < plen {\n    let part = Array::get(parts, i)\n    if i % 2 == 0 {\n      if String::length(part) > 0 {\n        let piece = EString(part)\n        result = if has_val {\n          concat_expr(result, piece)\n        } else {\n          piece\n        }\n        has_val = true\n      } else {\n        ()\n      }\n    } else {\n      let (pe, _) = parse_recur(lex(part), 0, 0)\n      let piece = ECall(EIdent(\"__to_string\", -1), [\n        pe\n      ], -1)\n      result = if has_val {\n        concat_expr(result, piece)\n      } else {\n        piece\n      }\n      has_val = true\n    }\n    i = i + 1\n  }\n  result\n}\n\nlet rec desugar_loop_body: (Expr, Array[String]) -> Expr = (expr, param_names) -> {\n  match expr {\n    EBreak(opt) => match opt {\n      Some(val) => EAssign(\"__loop_result\", desugar_loop_body(val, param_names), EBreak(None)),\n      None => EBreak(None)\n    },\n    EContinue(args) => {\n      if Array::length(args) == 0 {\n        EContinue(args)\n      } else {\n        let nargs = Array::length(args)\n        let nparams = Array::length(param_names)\n        if nargs > nparams {\n          EContinue(args)\n        } else {\n        let mut result = EContinue(Array::slice([EUnit], 0, 0))\n        let mut ci = nargs - 1\n        while ci >= 0 {\n          result = EAssign(Array::get(param_names, ci), EIdent(String::concat(\"__lt\", __to_string(ci)), -1), result)\n          ci = ci - 1\n        }\n        let mut ci2 = nargs - 1\n        while ci2 >= 0 {\n          result = ELet(String::concat(\"__lt\", __to_string(ci2)), desugar_loop_body(Array::get(args, ci2), param_names), result, -1)\n          ci2 = ci2 - 1\n        }\n        result\n        }\n      }\n    },\n    EWhile(_, _) => expr,\n    ELoop(_, _) => expr,\n    EFn(_, _, _, _, _, _) => expr,\n    EIf(c, t, e) => EIf(desugar_loop_body(c, param_names), desugar_loop_body(t, param_names), desugar_loop_body(e, param_names)),\n    ELet(n, v, b, soff) => ELet(n, desugar_loop_body(v, param_names), desugar_loop_body(b, param_names), soff),\n    ELetMut(n, v, b, soff) => ELetMut(n, desugar_loop_body(v, param_names), desugar_loop_body(b, param_names), soff),\n    ESeq(a, b) => ESeq(desugar_loop_body(a, param_names), desugar_loop_body(b, param_names)),\n    EAssign(n, v, c) => EAssign(n, desugar_loop_body(v, param_names), desugar_loop_body(c, param_names)),\n    EMatch(s, arms) => EMatch(desugar_loop_body(s, param_names), for a in arms {\n      let (p, ex) = a\n      (p, desugar_loop_body(ex, param_names))\n    }),\n    EHandle(body, arms) => EHandle(desugar_loop_body(body, param_names), for a in arms {\n      let (p, ex) = a\n      (p, desugar_loop_body(ex, param_names))\n    }),\n    EBinOp(op, l, r) => EBinOp(op, desugar_loop_body(l, param_names), desugar_loop_body(r, param_names)),\n    ECall(_, _, _) => expr,\n    ELetRec(n, v, b) => ELetRec(n, desugar_loop_body(v, param_names), desugar_loop_body(b, param_names)),\n    EThrow(e) => EThrow(desugar_loop_body(e, param_names)),\n    EUnaryOp(op, e) => EUnaryOp(op, desugar_loop_body(e, param_names)),\n    EDot(obj, field, off, fdoff) => EDot(desugar_loop_body(obj, param_names), field, off, fdoff),\n    EAssignOp(n, op, v, c) => EAssignOp(n, op, desugar_loop_body(v, param_names), desugar_loop_body(c, param_names)),\n    _ => expr\n  }\n}\n\n\nlet parse_loop_primary: (Array[Token], Array[Int], Int, (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } = (tokens, starts, pos, parse_recur) -> {\n  match peek(tokens, pos + 1) {\n    TLParen => {\n      let param_names_b = ArrayBuilder::new()\n      let param_inits_b = ArrayBuilder::new()\n      let mut cur = pos + 2\n      let mut done = false\n      while !done {\n        match peek(tokens, cur) {\n          TRParen => {\n            cur = cur + 1\n            done = true\n          },\n          TIdent(name) => {\n            let eq_pos = expect_tk(tokens, cur + 1, \"=\")\n            let (init, next_pos) = parse_recur(tokens, eq_pos, 0)\n            ArrayBuilder::push(param_names_b, name)\n            ArrayBuilder::push(param_inits_b, init)\n            match peek(tokens, next_pos) {\n              TComma => {\n                cur = next_pos + 1\n              },\n              TRParen => {\n                cur = next_pos + 1\n                done = true\n              },\n              _ => throw(\"expected ',' or ')' in loop params\")\n            }\n          },\n          _ => throw(\"expected loop parameter name or ')'\")\n        }\n      }\n      let body_pos = expect_tk(tokens, cur, \"{\")\n      let (body, end_pos) = parse_recur(tokens, body_pos, 20)\n      let pnames = ArrayBuilder::freeze(param_names_b)\n      let pinits = ArrayBuilder::freeze(param_inits_b)\n      let transformed_body = desugar_loop_body(body, pnames)\n      let while_expr = EWhile(EBool(true), transformed_body)\n      let result = ELetMut(\"__loop_result\", EInt(0),\n        ESeq(while_expr, EIdent(\"__loop_result\", -1)), -1)\n      let mut wrapped = result\n      let mut wi = Array::length(pnames) - 1\n      while wi >= 0 {\n        wrapped = ELetMut(Array::get(pnames, wi), Array::get(pinits, wi), wrapped, -1)\n        wi = wi - 1\n      }\n      (wrapped, end_pos)\n    },\n    _ => {\n      let body_pos = expect_tk(tokens, pos + 1, \"{\")\n      let (body, end_pos) = parse_recur(tokens, body_pos, 20)\n      (EWhile(EBool(true), body), end_pos)\n    }\n  }\n}\n\nlet parse_break_primary: (Array[Token], Array[Int], Int, (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } = (tokens, starts, pos, parse_recur) -> {\n  match peek(tokens, pos + 1) {\n    TRBrace => (EBreak(None), pos + 1),\n    TSemicolon => (EBreak(None), pos + 1),\n    TEof => (EBreak(None), pos + 1),\n    _ => {\n      let (expr, next_pos) = parse_recur(tokens, pos + 1, 0)\n      (EBreak(Some(expr)), next_pos)\n    }\n  }\n}\n\nlet parse_throw_primary: (Array[Token], Array[Int], Int, (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } = (tokens, starts, pos, parse_recur) -> {\n  let open_pos = expect_tk(tokens, pos + 1, \"(\")\n  let (expr, next_pos) = parse_recur(tokens, open_pos, 0)\n  let close_pos = expect_tk(tokens, next_pos, \")\")\n  (EThrow(expr), close_pos)\n}\n\nlet parse_return_primary: (Array[Token], Array[Int], Int, (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } = (tokens, starts, pos, parse_recur) -> {\n  match peek(tokens, pos + 1) {\n    TRBrace => (EReturn(EUnit), pos + 1),\n    TSemicolon => (EReturn(EUnit), pos + 1),\n    TEof => (EReturn(EUnit), pos + 1),\n    _ => {\n      let (expr, next_pos) = parse_recur(tokens, pos + 1, 0)\n      (EReturn(expr), next_pos)\n    }\n  }\n}\n\nlet parse_perform_primary: (Array[Token], Array[Int], Int, (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } = (tokens, starts, pos, parse_recur) -> {\n  match peek(tokens, pos + 1) {\n    TRParen => (EIdent(\"perform\", -1), pos + 1),\n    TRBracket => (EIdent(\"perform\", -1), pos + 1),\n    TRBrace => (EIdent(\"perform\", -1), pos + 1),\n    TComma => (EIdent(\"perform\", -1), pos + 1),\n    TSemicolon => (EIdent(\"perform\", -1), pos + 1),\n    TEof => (EIdent(\"perform\", -1), pos + 1),\n    _ => {\n      let (arg, next_pos) = parse_recur(tokens, pos + 1, 10)\n      (ECall(EIdent(\"perform\", -1), [\n        arg\n      ], offset_at(starts, pos)), next_pos)\n    }\n  }\n}\n\nlet rec parse_array_elems_rest: (Array[Token], Array[Int], Int, ArrayBuilder[Expr], (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Array[Expr], Int) with { Error } = (tokens, starts, pos, b, parse_recur) -> {\n  match peek(tokens, pos) {\n    TComma => {\n      let next_pos = pos + 1\n      match peek(tokens, next_pos) {\n        TRBracket => (ArrayBuilder::freeze(b), next_pos),\n        TDotDotDot => {\n          let (expr, end_pos) = parse_recur(tokens, next_pos + 1, 0)\n          ArrayBuilder::push(b, ESpread(expr))\n          parse_array_elems_rest(tokens, starts, end_pos, b, parse_recur)\n        },\n        _ => {\n          let (expr, end_pos) = parse_recur(tokens, next_pos, 0)\n          ArrayBuilder::push(b, expr)\n          parse_array_elems_rest(tokens, starts, end_pos, b, parse_recur)\n        }\n      }\n    },\n    _ => (ArrayBuilder::freeze(b), pos)\n  }\n}\n\nlet parse_array_primary: (Array[Token], Array[Int], Int, (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } = (tokens, starts, pos, parse_recur) -> {\n  match peek(tokens, pos + 1) {\n    TRBracket => (EArray(empty_exprs()), pos + 2),\n    TDotDotDot => {\n      let b = ArrayBuilder::new()\n      let (first, next_pos) = parse_recur(tokens, pos + 2, 0)\n      ArrayBuilder::push(b, ESpread(first))\n      let (items, end_pos) = parse_array_elems_rest(tokens, starts, next_pos, b, parse_recur)\n      let close_pos = expect_tk(tokens, end_pos, \"]\")\n      (EArray(items), close_pos)\n    },\n    _ => {\n      let b = ArrayBuilder::new()\n      let (first, next_pos) = parse_recur(tokens, pos + 1, 0)\n      ArrayBuilder::push(b, first)\n      let (items, end_pos) = parse_array_elems_rest(tokens, starts, next_pos, b, parse_recur)\n      let close_pos = expect_tk(tokens, end_pos, \"]\")\n      (EArray(items), close_pos)\n    }\n  }\n}\n\nlet rec parse_comma_exprs_rest: (Array[Token], Array[Int], Int, ArrayBuilder[Expr], (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Array[Expr], Int) with { Error } = (tokens, starts, pos, b, parse_recur) -> {\n  match peek(tokens, pos) {\n    TComma => {\n      match peek(tokens, pos + 1) {\n        TRParen => (ArrayBuilder::freeze(b), pos + 1),\n        _ => {\n          let (e, next) = parse_recur(tokens, pos + 1, 0)\n          ArrayBuilder::push(b, e)\n          parse_comma_exprs_rest(tokens, starts, next, b, parse_recur)\n        }\n      }\n    },\n    _ => (ArrayBuilder::freeze(b), pos)\n  }\n}\n\nlet parse_continue_primary: (Array[Token], Array[Int], Int, (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } = (tokens, starts, pos, parse_recur) -> {\n  match peek(tokens, pos + 1) {\n    TLParen => {\n      let b = ArrayBuilder::new()\n      match peek(tokens, pos + 2) {\n        TRParen => (EContinue(empty_exprs()), pos + 3),\n        _ => {\n          let (first, next_pos) = parse_recur(tokens, pos + 2, 0)\n          ArrayBuilder::push(b, first)\n          let (args, end_pos) = parse_comma_exprs_rest(tokens, starts, next_pos, b, parse_recur)\n          let close_pos = expect_tk(tokens, end_pos, \")\")\n          (EContinue(args), close_pos)\n        }\n      }\n    },\n    _ => (EContinue(empty_exprs()), pos + 1)\n  }\n}\n\nlet parse_control_primary: (Array[Token], Array[Int], Int, (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } = (tokens, starts, pos, parse_recur) -> {\n  match peek(tokens, pos) {\n    TLBrace => parse_recur(tokens, pos + 1, 20),\n    TIf => parse_recur(tokens, pos + 1, 21),\n    TMatch => parse_recur(tokens, pos + 1, 22),\n    THandle => parse_recur(tokens, pos + 1, 24),\n    TWhile => parse_recur(tokens, pos + 1, 23),\n    TFor => parse_recur(tokens, pos + 1, 25),\n    TThrow => parse_throw_primary(tokens, starts, pos, parse_recur),\n    TBreak => parse_break_primary(tokens, starts, pos, parse_recur),\n    TContinue => parse_continue_primary(tokens, starts, pos, parse_recur),\n    TRaise => throw(\"'raise' is deprecated, use 'throw(expr)' instead\"),\n    TReturn => parse_return_primary(tokens, starts, pos, parse_recur),\n    TDo => throw(\"'do' is reserved; use 'while' or 'for' instead\"),\n    TLoop => parse_loop_primary(tokens, starts, pos, parse_recur),\n    TYield => throw(\"'yield' is not supported\"),\n    TDeclare => throw(\"'declare' is not supported\"),\n    _ => {\n      let prev_name = if pos > 0 {\n        tk_name(peek(tokens, pos - 1))\n      } else {\n        \"start\"\n      }\n      let actual = tk_name(peek(tokens, pos))\n      let next_name = tk_name(peek(tokens, pos + 1))\n      throw(\"unexpected token at #\\{pos}: \\{actual} (prev=\\{prev_name}, next=\\{next_name})\")\n    }\n  }\n}\n\nlet rec parse_ctor_record_fields: (Array[Token], Array[Int], Int, ArrayBuilder[(String, Expr)], (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Array[(String, Expr)], Int) with { Error } = (tokens, starts, pos, b, parse_recur) -> {\n  match peek(tokens, pos) {\n    TRBrace => (ArrayBuilder::freeze(b), pos + 1),\n    TIdent(fname) => {\n      let colon_pos = expect_tk(tokens, pos + 1, \":\")\n      let (val, next_pos) = parse_recur(tokens, colon_pos, 0)\n      ArrayBuilder::push(b, (fname, val))\n      match peek(tokens, next_pos) {\n        TComma => parse_ctor_record_fields(tokens, starts, next_pos + 1, b, parse_recur),\n        TRBrace => (ArrayBuilder::freeze(b), next_pos + 1),\n        _ => throw(\"expected ',' or '}' in record literal\")\n      }\n    },\n    _ => throw(\"expected field name or '}' in record literal\")\n  }\n}\n\nlet parse_generic_fn_primary: (Array[Token], Array[Int], Int, (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } = (tokens, starts, pos, parse_recur) -> {\n  let mut skip_pos = pos + 1\n  let mut depth = 1\n  while depth > 0 {\n    match peek(tokens, skip_pos) {\n      TLBracket => {\n        depth = depth + 1\n      },\n      TRBracket => {\n        depth = depth - 1\n      },\n      _ => ()\n    }\n    skip_pos = skip_pos + 1\n  }\n  let (params, after_params) = parse_param_list(tokens, skip_pos)\n  match peek(tokens, after_params) {\n    TThinArrow => {\n      let (ret_ty, ret_pos) = parse_type_impl(tokens, after_params + 1, 0)\n      let effect_pair = match peek(tokens, ret_pos) {\n        TWith => {\n          let with_pos = expect_tk(tokens, ret_pos + 1, \"{\")\n          let effect_name_pair = collect_effect_names(tokens, with_pos, \"\")\n          let effect_name = effect_name_pair.0\n          let end_pos = effect_name_pair.1\n          (Some(effect_name), end_pos)\n        },\n        _ => (None, ret_pos)\n      }\n      let effect = effect_pair.0\n      let effect_next = effect_pair.1\n      let body_pos = expect_tk(tokens, effect_next, \"{\")\n      let (body, end_pos) = parse_recur(tokens, body_pos, 20)\n      (EFn(_no_tp(), _no_tb(), params, Some(ret_ty), effect, body), end_pos)\n    },\n    TLBrace => {\n      let (body, end_pos) = parse_recur(tokens, after_params + 1, 20)\n      (EFn(_no_tp(), _no_tb(), params, None, None, body), end_pos)\n    },\n    _ => throw(\"expected '->' or '{' after generic function params\")\n  }\n}\n\nlet is_generic_fn_start: (Array[Token], Int) -> Bool = (tokens, pos) -> {\n  match peek(tokens, pos + 1) {\n    TIdent(_) => {\n      let mut p = pos + 2\n      let mut depth = 1\n      while depth > 0 {\n        match peek(tokens, p) {\n          TLBracket => {\n            depth = depth + 1\n          },\n          TRBracket => {\n            depth = depth - 1\n          },\n          TEof => {\n            depth = 0\n          },\n          _ => ()\n        }\n        p = p + 1\n      }\n      match peek(tokens, p) {\n        TLParen => true,\n        _ => false\n      }\n    },\n    _ => false\n  }\n}\n\nlet parse_bracket_primary: (Array[Token], Array[Int], Int, (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } = (tokens, starts, pos, parse_recur) -> {\n  if is_generic_fn_start(tokens, pos) {\n    parse_generic_fn_primary(tokens, starts, pos, parse_recur)\n  } else {\n    parse_array_primary(tokens, starts, pos, parse_recur)\n  }\n}\n\nlet rec parse_map_literal_fields: (Array[Token], Array[Int], Int, ArrayBuilder[(String, Expr)], (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Array[(String, Expr)], Int) with { Error } = (tokens, starts, pos, b, parse_recur) -> {\n  match peek(tokens, pos) {\n    TRBrace => (ArrayBuilder::freeze(b), pos + 1),\n    TIdent(fname) => {\n      let colon_pos = expect_tk(tokens, pos + 1, \":\")\n      let (val, next_pos) = parse_recur(tokens, colon_pos, 0)\n      ArrayBuilder::push(b, (fname, val))\n      match peek(tokens, next_pos) {\n        TComma => parse_map_literal_fields(tokens, starts, next_pos + 1, b, parse_recur),\n        TRBrace => (ArrayBuilder::freeze(b), next_pos + 1),\n        _ => throw(\"expected ',' or '}' in map literal\")\n      }\n    },\n    TString(skey) => {\n      let colon_pos = expect_tk(tokens, pos + 1, \":\")\n      let (val, next_pos) = parse_recur(tokens, colon_pos, 0)\n      ArrayBuilder::push(b, (skey, val))\n      match peek(tokens, next_pos) {\n        TComma => parse_map_literal_fields(tokens, starts, next_pos + 1, b, parse_recur),\n        TRBrace => (ArrayBuilder::freeze(b), next_pos + 1),\n        _ => throw(\"expected ',' or '}' in map literal\")\n      }\n    },\n    _ => throw(\"expected field name or '}' in map literal\")\n  }\n}\n\nlet parse_paren_tuple_primary: (Array[Token], Array[Int], Int, (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } = (tokens, starts, pos, parse_recur) -> {\n  match peek(tokens, pos + 1) {\n    TRParen => (EUnit, pos + 2),\n    _ => {\n      let (first, next_pos) = parse_recur(tokens, pos + 1, 0)\n      match peek(tokens, next_pos) {\n        TRParen => (first, next_pos + 1),\n        TComma => {\n          let b = ArrayBuilder::new()\n          ArrayBuilder::push(b, first)\n          let (items, end_pos) = parse_comma_exprs_rest(tokens, starts, next_pos, b, parse_recur)\n          let close_pos = expect_tk(tokens, end_pos, \")\")\n          (ETuple(items), close_pos)\n        },\n        _ => throw(\"expected ')' or ','\")\n      }\n    }\n  }\n}\n\n\nlet parse_paren_lambda_primary: (Array[Token], Array[Int], Int, (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } = (tokens, starts, pos, parse_recur) -> {\n  let (params, after_params) = parse_param_list(tokens, pos + 1)\n  match peek(tokens, after_params) {\n    TThinArrow => {\n      let after_arrow = after_params + 1\n      match peek(tokens, after_arrow) {\n        TIdent(_) => {\n          let (ty, ty_pos) = parse_type_impl(tokens, after_arrow, 0)\n          match peek(tokens, ty_pos) {\n            TLBrace => {\n              let (body, end) = parse_recur(tokens, ty_pos + 1, 20)\n              (EFn(_no_tp(), _no_tb(), params, Some(ty), None, body), end)\n            },\n            TWith => {\n              let with_pos = expect_tk(tokens, ty_pos + 1, \"{\")\n              let effect_pair = collect_effect_names(tokens, with_pos, \"\")\n              let effect_name = effect_pair.0\n              let effect_next = effect_pair.1\n              let body_pos = expect_tk(tokens, effect_next, \"{\")\n              let (body, end) = parse_recur(tokens, body_pos, 20)\n              (EFn(_no_tp(), _no_tb(), params, Some(ty), Some(effect_name), body), end)\n            },\n            _ => {\n              let (body, end) = parse_recur(tokens, after_arrow, 0)\n              (EFn(_no_tp(), _no_tb(), params, None, None, body), end)\n            }\n          }\n        },\n        TLParen => {\n          let ty_opt = handle {\n            let (ty, ty_pos) = parse_type_impl(tokens, after_arrow, 0)\n            Some((ty, ty_pos))\n          } with Error {\n            Throw(_) => None\n          }\n          match ty_opt {\n            Some(pair) => {\n              let (ty, ty_pos) = pair\n              match peek(tokens, ty_pos) {\n                TLBrace => {\n                  let (body, end) = parse_recur(tokens, ty_pos + 1, 20)\n                  (EFn(_no_tp(), _no_tb(), params, Some(ty), None, body), end)\n                },\n                TWith => {\n                  let with_pos = expect_tk(tokens, ty_pos + 1, \"{\")\n                  let effect_pair = collect_effect_names(tokens, with_pos, \"\")\n                  let effect_name = effect_pair.0\n                  let effect_next = effect_pair.1\n                  let body_pos = expect_tk(tokens, effect_next, \"{\")\n                  let (body, end) = parse_recur(tokens, body_pos, 20)\n                  (EFn(_no_tp(), _no_tb(), params, Some(ty), Some(effect_name), body), end)\n                },\n                _ => {\n                  let (body, end) = parse_recur(tokens, after_arrow, 0)\n                  (EFn(_no_tp(), _no_tb(), params, None, None, body), end)\n                }\n              }\n            },\n            None => {\n              let (body, end) = parse_recur(tokens, after_arrow, 0)\n              (EFn(_no_tp(), _no_tb(), params, None, None, body), end)\n            }\n          }\n        },\n        _ => {\n          let (body, end) = parse_recur(tokens, after_arrow, 0)\n          (EFn(_no_tp(), _no_tb(), params, None, None, body), end)\n        }\n      }\n    },\n    TLBrace => {\n      let (body, end) = parse_recur(tokens, after_params + 1, 20)\n      (EFn(_no_tp(), _no_tb(), params, None, None, body), end)\n    },\n    _ => throw(\"expected '->' or '{' after fn params\")\n  }\n}\n\nlet parse_paren_primary: (Array[Token], Array[Int], Int, (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } = (tokens, starts, pos, parse_recur) -> {\n  if is_lambda_start(tokens, pos + 1) {\n    parse_paren_lambda_primary(tokens, starts, pos, parse_recur)\n  } else {\n    parse_paren_tuple_primary(tokens, starts, pos, parse_recur)\n  }\n}\n\nlet rec parse_record_literal_fields: (Array[Token], Array[Int], Int, ArrayBuilder[(String, Expr)], (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Array[(String, Expr)], Int) with { Error } = (tokens, starts, pos, b, parse_recur) -> {\n  match peek(tokens, pos) {\n    TRBrace => (ArrayBuilder::freeze(b), pos + 1),\n    TIdent(fname) => {\n      let (val, next_pos) = match peek(tokens, pos + 1) {\n        TComma => (EIdent(fname, -1), pos + 1),\n        TRBrace => (EIdent(fname, -1), pos + 1),\n        _ => {\n          let colon_pos = expect_tk(tokens, pos + 1, \":\")\n          parse_recur(tokens, colon_pos, 0)\n        }\n      }\n      ArrayBuilder::push(b, (fname, val))\n      match peek(tokens, next_pos) {\n        TComma => parse_record_literal_fields(tokens, starts, next_pos + 1, b, parse_recur),\n        TRBrace => (ArrayBuilder::freeze(b), next_pos + 1),\n        _ => throw(\"expected ',' or '}' in record literal\")\n      }\n    },\n    _ => throw(\"expected field name or '}' in record literal\")\n  }\n}\n\nlet offset_at: (Array[Int], Int) -> Int = (starts, p) -> {\n  if p >= 0 && p < Array::length(starts) {\n    Array::get(starts, p)\n  } else {\n    -1\n  }\n}\n\nlet parse_ident_primary: (Array[Token], Array[Int], Int, String, (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } = (tokens, starts, pos, name, parse_recur) -> {\n  if name == \"true\" {\n    (EBool(true), pos + 1)\n  } else if name == \"false\" {\n    (EBool(false), pos + 1)\n  } else if name == \"perform\" {\n    parse_perform_primary(tokens, starts, pos, parse_recur)\n  } else if name == \"record\" {\n    match peek(tokens, pos + 1) {\n      TLBrace => {\n        let b = ArrayBuilder::new()\n        let (fields, end_pos) = parse_record_literal_fields(tokens, starts, pos + 2, b, parse_recur)\n        (ERecord(\"\", fields), end_pos)\n      },\n      _ => (EIdent(name, offset_at(starts, pos)), pos + 1)\n    }\n  } else if name == \"map\" {\n    match peek(tokens, pos + 1) {\n      TLBrace => {\n        let b = ArrayBuilder::new()\n        let (fields, end_pos) = parse_map_literal_fields(tokens, starts, pos + 2, b, parse_recur)\n        (EMap(fields), end_pos)\n      },\n      _ => (EIdent(name, offset_at(starts, pos)), pos + 1)\n    }\n  } else {\n    match peek(tokens, pos + 1) {\n      TDoubleColon => match peek(tokens, pos + 2) {\n        TIdent(member) => (EIdent(String::concat(name, String::concat(\"::\", member)), offset_at(starts, pos)), pos + 3),\n        TLBrace => {\n          let b = ArrayBuilder::new()\n          let (fields, end_pos) = parse_ctor_record_fields(tokens, starts, pos + 3, b, parse_recur)\n          (ERecord(name, fields), end_pos)\n        },\n        _ => (EIdent(name, offset_at(starts, pos)), pos + 1)\n      },\n      _ => (EIdent(name, offset_at(starts, pos)), pos + 1)\n    }\n  }\n}\n\nexport let parse_primary: (Array[Token], Array[Int], Int, (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } = (tokens, starts, pos, parse_recur) -> {\n  match peek(tokens, pos) {\n    TInt(n) => (EInt(n), pos + 1),\n    TFloat(n) => (EFloat(n), pos + 1),\n    TString(s) => (EString(s), pos + 1),\n    TStringInterp(parts) => (build_interp_expr(parts, parse_recur), pos + 1),\n    TIdent(name) => parse_ident_primary(tokens, starts, pos, name, parse_recur),\n    TLParen => parse_paren_primary(tokens, starts, pos, parse_recur),\n    TLBracket => parse_bracket_primary(tokens, starts, pos, parse_recur),\n    _ => parse_control_primary(tokens, starts, pos, parse_recur)\n  }\n}\n")
}

let selfhost_source_9 = () -> (String, String) {
  ("lib/@vibe/parser/parser_expr_core.vibe",
"\n\n\n\n\n\nlet binop_op: (Token) -> String with { Error } = (tok) -> {\n  match tok {\n    TOr => \"||\",\n    TAnd => \"&&\",\n    TPipeGt => \"|>\",\n    TEqEq => \"==\",\n    TNeq => \"!=\",\n    TLt => \"<\",\n    TLte => \"<=\",\n    TGt => \">\",\n    TGte => \">=\",\n    TBitOr => \"|\",\n    TBitXor => \"^\",\n    TBitAnd => \"&\",\n    TLShift => \"<<\",\n    TRShift => \">>\",\n    TPlus => \"+\",\n    TMinus => \"-\",\n    TStar => \"*\",\n    TSlash => \"/\",\n    TPercent => \"%\",\n    _ => throw(\"internal parser error: not a binary operator\")\n  }\n}\n\nlet binop_prec: (Token) -> Int = (tok) -> {\n  match tok {\n    TOr => 0,\n    TAnd => 1,\n    TPipeGt => 2,\n    TEqEq => 3,\n    TNeq => 3,\n    TLt => 3,\n    TLte => 3,\n    TGt => 3,\n    TGte => 3,\n    TBitOr => 4,\n    TBitXor => 5,\n    TBitAnd => 6,\n    TLShift => 7,\n    TRShift => 7,\n    TPlus => 8,\n    TMinus => 8,\n    TStar => 9,\n    TSlash => 9,\n    TPercent => 9,\n    _ => -1\n  }\n}\n\nlet callee_offset: (Expr) -> Int = (callee) -> {\n  match callee {\n    EIdent(_, off) => off,\n    EDot(inner, _, off, _) => if off >= 0 { off } else { callee_offset(inner) },\n    ECall(inner, _, off) => if off >= 0 { off } else { callee_offset(inner) },\n    _ => -1\n  }\n}\n\nlet field_offset_at: (Array[Int], Int) -> Int = (starts, p) -> {\n  if p >= 0 && p < Array::length(starts) {\n    Array::get(starts, p)\n  } else {\n    -1\n  }\n}\n\nlet index_expr: (Expr, Expr) -> Expr = (cur_expr, idx) -> {\n  let args = empty_exprs()\n  Array::push(args, cur_expr)\n  Array::push(args, idx)\n  ECall(EIdent(\"__index\", -1), args, -1)\n}\n\nlet pipe_arg_is_hole: (Expr) -> Bool = (arg) -> {\n  match arg {\n    EIdent(n, _) => n == \"_\",\n    _ => false\n  }\n}\n\nlet pipe_desugar: (Expr, Expr) -> Expr = (lhs, rhs) -> {\n  match rhs {\n    ECall(callee, args, off) => {\n      let mut has_hole = false\n      let mut i = 0\n      while i < Array::length(args) {\n        if pipe_arg_is_hole(Array::get(args, i)) {\n          has_hole = true\n          i = Array::length(args)\n        } else {\n          i = i + 1\n        }\n      }\n      if has_hole {\n        let out = empty_exprs()\n        let mut j = 0\n        while j < Array::length(args) {\n          let a = Array::get(args, j)\n          if pipe_arg_is_hole(a) {\n            Array::push(out, lhs)\n          } else {\n            Array::push(out, a)\n          }\n          j = j + 1\n        }\n        ECall(callee, out, off)\n      } else {\n        ECall(callee, Array::concat([\n          lhs\n        ], args), off)\n      }\n    },\n    _ => {\n      let off = callee_offset(rhs)\n      ECall(rhs, Array::concat([\n        lhs\n      ], empty_exprs()), off)\n    }\n  }\n}\n\nlet parse_call_arg: (Array[Token], Array[Int], Int, (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } = (tokens, starts, pos, parse_recur) -> {\n  match peek(tokens, pos) {\n    TIdent(name) => match peek(tokens, pos + 1) {\n      TThinArrow => {\n        let (body, end) = parse_recur(tokens, pos + 2, 0)\n        (EFn(_no_tp(), _no_tb(), [\n          (name, None)\n        ], None, None, body), end)\n      },\n      TTilde => match peek(tokens, pos + 2) {\n        TEq => {\n          let (val, end) = parse_recur(tokens, pos + 3, 0)\n          (ELabeledArg(name, \"~\", val), end)\n        },\n        _ => parse_recur(tokens, pos, 0)\n      },\n      TQuestion => match peek(tokens, pos + 2) {\n        TEq => {\n          let (val, end) = parse_recur(tokens, pos + 3, 0)\n          (ELabeledArg(name, \"?\", val), end)\n        },\n        _ => parse_recur(tokens, pos, 0)\n      },\n      TEq => {\n        let (val, end) = parse_recur(tokens, pos + 2, 0)\n        (ELabeledArg(name, \"~\", val), end)\n      },\n      _ => parse_recur(tokens, pos, 0)\n    },\n    _ => parse_recur(tokens, pos, 0)\n  }\n}\n\nlet has_placeholder_arg: (Expr) -> Bool = (arg) -> {\n  match arg {\n    EIdent(n, _) => n == \"_\",\n    EBinOp(_, l, r) => has_placeholder_arg(l) || has_placeholder_arg(r),\n    _ => false\n  }\n}\n\nlet slice_from_idx_expr: (Expr, Expr, Expr) -> Expr = (cur_expr, idx, end_expr) -> {\n  let args = empty_exprs()\n  Array::push(args, cur_expr)\n  Array::push(args, idx)\n  Array::push(args, end_expr)\n  ECall(EIdent(\"__slice\", -1), args, -1)\n}\n\nlet has_placeholder_args: (Array[Expr]) -> Bool = (args) -> {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(args) {\n    if has_placeholder_arg(Array::get(args, i)) {\n      found = true\n      i = Array::length(args)\n    } else {\n      i = i + 1\n    }\n  }\n  found\n}\n\nlet parse_call_args_rest: (Array[Token], Array[Int], Int, ArrayBuilder[Expr], (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Array[Expr], Int) with { Error } = (tokens, starts, pos, b, parse_recur) -> {\n  let mut p = pos\n  let mut done = false\n  while !done {\n    match peek(tokens, p) {\n      TComma => match peek(tokens, p + 1) {\n        TRParen => {\n          p = p + 1\n          done = true\n        },\n        _ => {\n          let (e, next) = parse_call_arg(tokens, starts, p + 1, parse_recur)\n          ArrayBuilder::push(b, e)\n          p = next\n        }\n      }\n      ,\n      _ => {\n        done = true\n      }\n    }\n  }\n  (ArrayBuilder::freeze(b), p)\n}\n\nlet slice_from_zero_expr: (Expr, Expr) -> Expr = (cur_expr, end_expr) -> {\n  let args = empty_exprs()\n  Array::push(args, cur_expr)\n  Array::push(args, EInt(0))\n  Array::push(args, end_expr)\n  ECall(EIdent(\"__slice\", -1), args, -1)\n}\n\nlet wrap_placeholder_arg: (Expr) -> Expr = (arg) -> {\n  let mut pc = 0\n  let params = Array::slice([\n    (\"\", None)\n  ], 0, 0)\n  let rec replace_placeholders: (Expr) -> Expr = (e) -> {\n    match e {\n      EIdent(n, _) => if n == \"_\" {\n        let pn = String::concat(\"__ph\", __to_string(pc))\n        Array::push(params, (pn, None))\n        pc = pc + 1\n        EIdent(pn, -1)\n      } else {\n        e\n      }\n      ,\n      EBinOp(op, l, r) => {\n        let nl = replace_placeholders(l)\n        let nr = replace_placeholders(r)\n        EBinOp(op, nl, nr)\n      },\n      _ => e\n    }\n  }\n  let replaced = replace_placeholders(arg)\n  EFn(_no_tp(), _no_tb(), params, None, None, replaced)\n}\n\nlet has_non_pipe_infix_top: (Array[Token], Int, Int) -> Bool = (tokens, start, end) -> {\n  let rec go: (Int, Int, Bool) -> Bool = (i, depth, prev_top_end) -> {\n    if i >= end {\n      false\n    } else {\n      let tok = peek(tokens, i)\n      if depth == 0 {\n        if is_non_pipe_infix(tok) {\n          if prev_top_end {\n            true\n          } else {\n            go(i + 1, 0, false)\n          }\n        } else {\n          match tok {\n            TLParen => go(i + 1, 1, false),\n            TLBracket => go(i + 1, 1, false),\n            TLBrace => go(i + 1, 1, false),\n            _ => go(i + 1, 0, is_expr_end_token(tok))\n          }\n        }\n      } else {\n        match tok {\n          TLParen => go(i + 1, depth + 1, prev_top_end),\n          TLBracket => go(i + 1, depth + 1, prev_top_end),\n          TLBrace => go(i + 1, depth + 1, prev_top_end),\n          TRParen => if depth == 1 {\n            go(i + 1, 0, true)\n          } else {\n            go(i + 1, depth - 1, prev_top_end)\n          },\n          TRBracket => if depth == 1 {\n            go(i + 1, 0, true)\n          } else {\n            go(i + 1, depth - 1, prev_top_end)\n          },\n          TRBrace => if depth == 1 {\n            go(i + 1, 0, true)\n          } else {\n            go(i + 1, depth - 1, prev_top_end)\n          },\n          _ => go(i + 1, depth, prev_top_end)\n        }\n      }\n    }\n  }\n  go(start, 0, false)\n}\n\nlet desugar_placeholder_args: (Array[Expr]) -> Array[Expr] = (args) -> {\n  let out = Array::slice([\n    EUnit\n  ], 0, 0)\n  let mut i = 0\n  while i < Array::length(args) {\n    let arg = Array::get(args, i)\n    if pipe_arg_is_hole(arg) {\n      Array::push(out, arg)\n    } else if has_placeholder_arg(arg) {\n      Array::push(out, wrap_placeholder_arg(arg))\n    } else {\n      Array::push(out, arg)\n    }\n    i = i + 1\n  }\n  out\n}\n\nlet rec parse_postfix: (Array[Token], Array[Int], Int, Expr, (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } = (tokens, starts, pos, expr, parse_recur) -> {\n  match peek(tokens, pos) {\n    TLParen => match expr {\n      EArray(_) => (expr, pos),\n      ETuple(_) => (expr, pos),\n      ERecord(_, _) => (expr, pos),\n      EMap(_) => (expr, pos),\n      EInt(_) => (expr, pos),\n      EFloat(_) => (expr, pos),\n      EString(_) => (expr, pos),\n      EStringInterp(_) => (expr, pos),\n      EBool(_) => (expr, pos),\n      EUnit => (expr, pos),\n      EWhile(_, _) => (expr, pos),\n      EIf(_, _, _) => (expr, pos),\n      EMatch(_, _) => (expr, pos),\n      ELoop(_, _) => (expr, pos),\n      EForIn(_, _, _, _) => (expr, pos),\n      EHandle(_, _) => (expr, pos),\n      _ => match peek(tokens, pos + 1) {\n        TRParen => parse_postfix(tokens, starts, pos + 2, ECall(expr, empty_exprs(), callee_offset(expr)), parse_recur),\n        _ => {\n          let b = ArrayBuilder::new()\n          let (first_arg, next_pos) = parse_call_arg(tokens, starts, pos + 1, parse_recur)\n          ArrayBuilder::push(b, first_arg)\n          let (args, end_pos) = parse_call_args_rest(tokens, starts, next_pos, b, parse_recur)\n          let close_pos = expect_tk(tokens, end_pos, \")\")\n          let call_args = if has_placeholder_args(args) {\n            desugar_placeholder_args(args)\n          } else {\n            args\n          }\n          parse_postfix(tokens, starts, close_pos, ECall(expr, call_args, callee_offset(expr)), parse_recur)\n        }\n      },\n    },\n    TLBracket => match peek(tokens, pos + 1) {\n      TColon => match peek(tokens, pos + 2) {\n        TRBracket => {\n          let end_expr = ECall(EIdent(\"__len\", -1), [\n            expr\n          ], -1)\n          parse_postfix(tokens, starts, pos + 3, slice_from_zero_expr(expr, end_expr), parse_recur)\n        },\n        _ => {\n          let (end_expr, end_next) = parse_recur(tokens, pos + 2, 0)\n          let close_pos = match peek(tokens, end_next) {\n            TRBracket => end_next + 1,\n            _ => throw(\"expected ']'\")\n          }\n          parse_postfix(tokens, starts, close_pos, slice_from_zero_expr(expr, end_expr), parse_recur)\n        }\n      },\n      _ => {\n        let (idx, idx_next) = parse_recur(tokens, pos + 1, 0)\n        match peek(tokens, idx_next) {\n          TColon => match peek(tokens, idx_next + 1) {\n            TRBracket => {\n              let end_expr = ECall(EIdent(\"__len\", -1), [\n                expr\n              ], -1)\n              parse_postfix(tokens, starts, idx_next + 2, slice_from_idx_expr(expr, idx, end_expr), parse_recur)\n            },\n            _ => {\n              let (end_expr, end_next) = parse_recur(tokens, idx_next + 1, 0)\n              let close_pos = match peek(tokens, end_next) {\n                TRBracket => end_next + 1,\n                _ => throw(\"expected ']'\")\n              }\n              parse_postfix(tokens, starts, close_pos, slice_from_idx_expr(expr, idx, end_expr), parse_recur)\n            }\n          },\n          _ => {\n            let close_pos = match peek(tokens, idx_next) {\n              TRBracket => idx_next + 1,\n              _ => throw(\"expected ']'\")\n            }\n            parse_postfix(tokens, starts, close_pos, index_expr(expr, idx), parse_recur)\n          }\n        }\n      }\n    },\n    TDot => match peek(tokens, pos + 1) {\n      TIdent(field) => parse_postfix(tokens, starts, pos + 2, EDot(expr, field, callee_offset(expr), field_offset_at(starts, pos + 1)), parse_recur),\n      TInt(idx) => parse_postfix(tokens, starts, pos + 2, EDot(expr, __to_string(idx), callee_offset(expr), field_offset_at(starts, pos + 1)), parse_recur),\n      _ => (expr, pos)\n    },\n    TQuestion => parse_postfix(tokens, starts, pos + 1, ECall(EIdent(\"__try_op\", -1), [\n      expr\n    ], -1), parse_recur),\n    _ => (expr, pos)\n  }\n}\n\nlet rec parse_prefix: (Array[Token], Array[Int], Int, (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } = (tokens, starts, pos, parse_recur) -> {\n  match peek(tokens, pos) {\n    TMinus => {\n      let (e, next) = parse_prefix(tokens, starts, pos + 1, parse_recur)\n      (EUnaryOp(\"-\", e), next)\n    },\n    TNot => {\n      let (e, next) = parse_prefix(tokens, starts, pos + 1, parse_recur)\n      (EUnaryOp(\"!\", e), next)\n    },\n    _ => {\n      let (e, next) = parse_primary(tokens, starts, pos, parse_recur)\n      parse_postfix(tokens, starts, next, e, parse_recur)\n    }\n  }\n}\n\nlet left_is_stmt_form: (Expr) -> Bool = (e) -> {\n  match e {\n    EWhile(_, _) => true,\n    ELoop(_, _) => true,\n    EForIn(_, _, _, _) => true,\n    _ => false\n  }\n}\n\nlet rec parse_infix_loop: (Array[Token], Array[Int], Expr, Int, Int, Int, Bool, (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } = (tokens, starts, left, next, min_prec, expr_start, cmp_locked, parse_recur) -> {\n  let tok = peek(tokens, next)\n  let prec = binop_prec(tok)\n  let should_stop = if prec < min_prec {\n    true\n  } else if cmp_locked {\n    prec == 3\n  } else if left_is_stmt_form(left) {\n    match tok {\n      TPlus => true,\n      TMinus => true,\n      _ => false\n    }\n  } else {\n    false\n  }\n  if should_stop {\n    (left, next)\n  } else {\n    let is_pipe = match tok {\n      TPipeGt => true,\n      _ => false\n    }\n    let op = binop_op(tok)\n    if is_pipe {\n      if has_non_pipe_infix_top(tokens, expr_start, next) {\n        throw(\"cannot mix '|>' with other infix operators without explicit parentheses\")\n      }\n    }\n    let (right0, right_next0) = parse_prefix(tokens, starts, next + 1, parse_recur)\n    let (right, rn) = parse_infix_loop(tokens, starts, right0, right_next0, prec + 1, next + 1, false, parse_recur)\n    if is_pipe {\n      if has_non_pipe_infix_top(tokens, next + 1, rn) {\n        throw(\"cannot mix '|>' with other infix operators without explicit parentheses\")\n      }\n    }\n    let combined = if is_pipe {\n      pipe_desugar(left, right)\n    } else {\n      EBinOp(op, left, right)\n    }\n    let next_cmp_locked = if prec == 3 {\n      true\n    } else {\n      cmp_locked\n    }\n    parse_infix_loop(tokens, starts, combined, rn, min_prec, expr_start, next_cmp_locked, parse_recur)\n  }\n}\n\nexport let parse_infix_no_is: (Array[Token], Array[Int], Int, Int, Int, (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } = (tokens, starts, pos, min_prec, expr_start, parse_recur) -> {\n  let (left0, next0) = parse_prefix(tokens, starts, pos, parse_recur)\n  parse_infix_loop(tokens, starts, left0, next0, min_prec, expr_start, false, parse_recur)\n}\n\nexport let parse_infix: (Array[Token], Array[Int], Int, Int, Int, (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } = (tokens, starts, pos, min_prec, expr_start, parse_recur) -> {\n  let (expr, en) = parse_infix_no_is(tokens, starts, pos, min_prec, expr_start, parse_recur)\n  match peek(tokens, en) {\n    TIs => {\n      let (pat, pn) = parse_pattern(tokens, en + 1)\n      (EMatch(expr, [\n        (pat, EBool(true)),\n        (PWild, EBool(false))\n      ]), pn)\n    },\n    TIdent(kw) => if kw == \"is\" {\n      let (pat, pn) = parse_pattern(tokens, en + 1)\n      (EMatch(expr, [\n        (pat, EBool(true)),\n        (PWild, EBool(false))\n      ]), pn)\n    } else {\n      (expr, en)\n    },\n    _ => (expr, en)\n  }\n}\n")
}

let selfhost_source_10 = () -> (String, String) {
  ("lib/@vibe/parser/parser_expr_dispatch.vibe",
"\n\n\n\n\n\nlet ascribe_wrap: (Expr, TypeExpr) -> Expr = (val, ty) -> {\n  let tparams = Array::slice([\n    \"\"\n  ], 0, 0)\n  let tbounds = Array::slice([\n    (\"\", Array::slice([\n      \"\"\n    ], 0, 0))\n  ], 0, 0)\n  let params = [\n    (\"__asc\", Some(ty))\n  ]\n  let lam = EFn(tparams, tbounds, params, None, None, EIdent(\"__asc\", 0 - 1))\n  ECall(lam, [\n    val\n  ], 0 - 1)\n}\n\nlet distribute_local_fn_ann: (TypeExpr, Expr) -> Option[Expr] = (ann_ty, val) -> {\n  match ann_ty {\n    TyFn(param_types, ret_ty, effect_name) => match val {\n      EFn(tp, tb, params, ret_opt, effect_opt, body) => {\n        if Array::length(params) != Array::length(param_types) {\n          None\n        } else {\n          let out = ArrayBuilder::new()\n          let mut i = 0\n          while i < Array::length(params) {\n            let (pname, pann) = Array::get(params, i)\n            let next_ann = match pann {\n              Some(_) => pann,\n              None => Some(Array::get(param_types, i))\n            }\n            ArrayBuilder::push(out, (pname, next_ann))\n            i = i + 1\n          }\n          let next_ret = match ret_opt {\n            Some(_) => ret_opt,\n            None => Some(ret_ty)\n          }\n          let next_eff = match effect_opt {\n            Some(_) => effect_opt,\n            None => effect_name\n          }\n          Some(EFn(tp, tb, ArrayBuilder::freeze(out), next_ret, next_eff, body))\n        }\n      },\n      _ => None\n    },\n    _ => None\n  }\n}\n\nlet dispatch_tp_bound_names: (Array[Token], Int) -> (Array[String], Int) with { Error } = (tokens, pos) -> {\n  let b = ArrayBuilder::new()\n  let mut p = pos\n  let mut done = false\n  while !done {\n    match peek(tokens, p) {\n      TIdent(bname) => {\n        ArrayBuilder::push(b, bname)\n        p = p + 1\n        match peek(tokens, p) {\n          TPlus => {\n            p = p + 1\n          },\n          _ => {\n            done = true\n          }\n        }\n      },\n      _ => throw(\"expected trait bound name\")\n    }\n  }\n  (ArrayBuilder::freeze(b), p)\n}\n\nlet dispatch_type_params: (Array[Token], Int) -> (Array[String], Array[(String, Array[String])], Int) with { Error } = (tokens, pos) -> {\n  let names = ArrayBuilder::new()\n  let bounds = ArrayBuilder::new()\n  let mut p = pos\n  let mut done = false\n  while !done {\n    match peek(tokens, p) {\n      TRBracket => {\n        p = p + 1\n        done = true\n      },\n      TIdent(name) => {\n        ArrayBuilder::push(names, name)\n        p = p + 1\n        match peek(tokens, p) {\n          TColon => {\n            let (bound_names, next) = dispatch_tp_bound_names(tokens, p + 1)\n            ArrayBuilder::push(bounds, (name, bound_names))\n            p = next\n          },\n          _ => ()\n        }\n        match peek(tokens, p) {\n          TComma => {\n            p = p + 1\n          },\n          TRBracket => {\n            p = p + 1\n            done = true\n          },\n          _ => throw(\"expected ',' or ']' in type params\")\n        }\n      },\n      _ => throw(\"expected type parameter name or ']'\")\n    }\n  }\n  (ArrayBuilder::freeze(names), ArrayBuilder::freeze(bounds), p)\n}\n\nlet parse_local_let_annotation: (Array[Token], Int) -> (Array[String], Array[(String, Array[String])], TypeExpr, Int) with { Error } = (tokens, pos) -> {\n  match peek(tokens, pos) {\n    TLBracket => {\n      let (tps, tbs, after_binder) = dispatch_type_params(tokens, pos + 1)\n      let (ty, next) = parse_type_impl(tokens, after_binder, 0)\n      (tps, tbs, ty, next)\n    },\n    _ => {\n      let (ty, next) = parse_type_impl(tokens, pos, 0)\n      let no_tp = Array::slice([\n        \"\"\n      ], 0, 0)\n      let no_tb = Array::slice([\n        (\"\", Array::slice([\n          \"\"\n        ], 0, 0))\n      ], 0, 0)\n      (no_tp, no_tb, ty, next)\n    }\n  }\n}\n\nlet apply_local_let_tp: (Array[String], Array[(String, Array[String])], Expr) -> Expr = (tps, tbs, val) -> {\n  if Array::length(tps) > 0 {\n    match val {\n      EFn(_, _, params, ret, eff, body) => EFn(tps, tbs, params, ret, eff, body),\n      _ => val\n    }\n  } else {\n    val\n  }\n}\n\nlet blk_offset_at: (Array[Int], Int) -> Int = (starts, p) -> {\n  if p >= 0 && p < Array::length(starts) {\n    Array::get(starts, p)\n  } else {\n    -1\n  }\n}\n\nenum BlockStep {\n  StepSeq(Expr);\n  StepValue(Expr);\n  StepLet(String, Expr, Int);\n  StepLetMut(String, Expr, Int);\n  StepLetRec(String, Expr);\n  StepAssign(String, Expr);\n  StepAssignOp(String, String, Expr);\n  StepPattern(Pat, Expr);\n  StepPatternElse(Pat, Expr, Expr);\n  StepStructDestr(Pat, Expr);\n  StepRecordDestr(Pat, Expr);\n  StepBind(String, Expr)\n}\n\nlet rec desugar_guarded: (Array[(Pat, Expr, Expr)], Int, Expr) -> Array[(Pat, Expr)] = (arms, i, scrut) -> {\n  if i >= Array::length(arms) {\n    empty_arms()\n  } else {\n    let (pat, guard, body) = Array::get(arms, i)\n    let rest = desugar_guarded(arms, i + 1, scrut)\n    let no_guard = match guard {\n      EBool(bv) => bv,\n      _ => false\n    }\n    let arm_body = if no_guard {\n      body\n    } else {\n      EIf(guard, body, EMatch(scrut, rest))\n    }\n    let out = ArrayBuilder::new()\n    ArrayBuilder::push(out, (pat, arm_body))\n    let mut j = 0\n    while j < Array::length(rest) {\n      ArrayBuilder::push(out, Array::get(rest, j))\n      j = j + 1\n    }\n    ArrayBuilder::freeze(out)\n  }\n}\n\nlet rec collect_match_arms: (Array[Token], Array[Int], Int, ArrayBuilder[(Pat, Expr, Expr)], Array[Bool], (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> Int with { Error } = (tokens, starts, pos, b, hg, parse_recur) -> {\n  let (pat, pa) = parse_pattern(tokens, pos)\n  let (guard, after_g) = match peek(tokens, pa) {\n    TIf => {\n      Array::set(hg, 0, true)\n      parse_recur(tokens, pa + 1, 0)\n    },\n    _ => (EBool(true), pa)\n  }\n  let arrow = expect_tk(tokens, after_g, \"=>\")\n  let (body, bn) = parse_recur(tokens, arrow, 0)\n  ArrayBuilder::push(b, (pat, guard, body))\n  match peek(tokens, bn) {\n    TComma => match peek(tokens, bn + 1) {\n      TRBrace => bn + 2,\n      _ => collect_match_arms(tokens, starts, bn + 1, b, hg, parse_recur)\n    },\n    TRBrace => bn + 1,\n    _ => collect_match_arms(tokens, starts, bn, b, hg, parse_recur)\n  }\n}\n\nlet rec qualify_handle_arm_pattern: (String, Pat) -> Pat = (effect_name, pat) -> {\n  match pat {\n    PCtor(name, args) => if String::contains(name, \"::\") {\n      PCtor(name, args)\n    } else {\n      PCtor(String::concat(effect_name, String::concat(\"::\", name)), args)\n    },\n    POr(left, right) => POr(qualify_handle_arm_pattern(effect_name, left), qualify_handle_arm_pattern(effect_name, right)),\n    _ => pat\n  }\n}\n\nlet parse_handle_arm: (Array[Token], Array[Int], Int, String, (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> ((Pat, Expr), Int) with { Error } = (tokens, starts, pos, effect_name, parse_recur) -> {\n  let (pat, pat_next) = parse_pattern(tokens, pos)\n  let qualified_pat = qualify_handle_arm_pattern(effect_name, pat)\n  let arrow_pos = expect_tk(tokens, pat_next, \"=>\")\n  let (expr, next) = parse_recur(tokens, arrow_pos, 0)\n  ((qualified_pat, expr), next)\n}\n\nlet rec parse_handle_rest: (Array[Token], Array[Int], Int, Expr, String, ArrayBuilder[(Pat, Expr)], (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } = (tokens, starts, pos, body, effect_name, b, parse_recur) -> {\n  match peek(tokens, pos) {\n    TSemicolon => match peek(tokens, pos + 1) {\n      TRBrace => (EHandle(body, ArrayBuilder::freeze(b)), pos + 2),\n      _ => {\n        let (arm, next) = parse_handle_arm(tokens, starts, pos + 1, effect_name, parse_recur)\n        ArrayBuilder::push(b, arm)\n        parse_handle_rest(tokens, starts, next, body, effect_name, b, parse_recur)\n      }\n    },\n    TRBrace => (EHandle(body, ArrayBuilder::freeze(b)), pos + 1),\n    _ => throw(\"expected ';' or '}' in handle arm list\")\n  }\n}\n\nlet parse_block_after_expr: (Array[Token], Int, Expr, (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } = (tokens, pos, e, parse_recur) -> {\n  match peek(tokens, pos) {\n    TRBrace => (e, pos + 1),\n    TSemicolon => {\n      let (rest, end) = parse_recur(tokens, pos + 1, 20)\n      (ESeq(e, rest), end)\n    },\n    TEq => match e {\n      EIdent(name, _) => {\n        let val_pair = parse_recur(tokens, pos + 1, 0)\n        let val = val_pair.0\n        let val_next = val_pair.1\n        let a = skip_semi(tokens, val_next)\n        let (rest, end) = parse_recur(tokens, a, 20)\n        (EAssign(name, val, rest), end)\n      },\n      EDot(obj, field, _, _) => {\n        let val_pair = parse_recur(tokens, pos + 1, 0)\n        let val = val_pair.0\n        let val_next = val_pair.1\n        let a = skip_semi(tokens, val_next)\n        let (rest, end) = parse_recur(tokens, a, 20)\n        let set_args = empty_exprs()\n        Array::push(set_args, obj)\n        Array::push(set_args, EString(field))\n        Array::push(set_args, val)\n        (ESeq(ECall(EIdent(\"__set_field\", -1), set_args, -1), rest), end)\n      },\n      ECall(idx_callee, idx_args, _) => {\n        let is_index = match idx_callee {\n          EIdent(icn, _) => icn == \"__index\",\n          _ => false\n        }\n        if is_index && Array::length(idx_args) == 2 {\n          let val_pair = parse_recur(tokens, pos + 1, 0)\n          let val = val_pair.0\n          let val_next = val_pair.1\n          let a = skip_semi(tokens, val_next)\n          let (rest, end) = parse_recur(tokens, a, 20)\n          let set_args = empty_exprs()\n          Array::push(set_args, Array::get(idx_args, 0))\n          Array::push(set_args, Array::get(idx_args, 1))\n          Array::push(set_args, val)\n          (ESeq(ECall(EIdent(\"Array::set\", -1), set_args, -1), rest), end)\n        } else {\n          throw(\"invalid assignment target\")\n        }\n      },\n      _ => throw(\"invalid assignment target\")\n    },\n    TPlusEq => match e {\n      EIdent(name, _) => {\n        let val_pair = parse_recur(tokens, pos + 1, 0)\n        let val = val_pair.0\n        let val_next = val_pair.1\n        let a = skip_semi(tokens, val_next)\n        let (rest, end) = parse_recur(tokens, a, 20)\n        (EAssignOp(name, \"+\", val, rest), end)\n      },\n      _ => throw(\"invalid assignment target\")\n    },\n    TMinusEq => match e {\n      EIdent(name, _) => {\n        let val_pair = parse_recur(tokens, pos + 1, 0)\n        let val = val_pair.0\n        let val_next = val_pair.1\n        let a = skip_semi(tokens, val_next)\n        let (rest, end) = parse_recur(tokens, a, 20)\n        (EAssignOp(name, \"-\", val, rest), end)\n      },\n      _ => throw(\"invalid assignment target\")\n    },\n    TStarEq => match e {\n      EIdent(name, _) => {\n        let val_pair = parse_recur(tokens, pos + 1, 0)\n        let val = val_pair.0\n        let val_next = val_pair.1\n        let a = skip_semi(tokens, val_next)\n        let (rest, end) = parse_recur(tokens, a, 20)\n        (EAssignOp(name, \"*\", val, rest), end)\n      },\n      _ => throw(\"invalid assignment target\")\n    },\n    TSlashEq => match e {\n      EIdent(name, _) => {\n        let val_pair = parse_recur(tokens, pos + 1, 0)\n        let val = val_pair.0\n        let val_next = val_pair.1\n        let a = skip_semi(tokens, val_next)\n        let (rest, end) = parse_recur(tokens, a, 20)\n        (EAssignOp(name, \"/\", val, rest), end)\n      },\n      _ => throw(\"invalid assignment target\")\n    },\n    TPercentEq => match e {\n      EIdent(name, _) => {\n        let val_pair = parse_recur(tokens, pos + 1, 0)\n        let val = val_pair.0\n        let val_next = val_pair.1\n        let a = skip_semi(tokens, val_next)\n        let (rest, end) = parse_recur(tokens, a, 20)\n        (EAssignOp(name, \"%\", val, rest), end)\n      },\n      _ => throw(\"invalid assignment target\")\n    },\n    _ => {\n      let (rest, end) = parse_recur(tokens, pos, 20)\n      if end <= pos {\n        throw(\"internal parser error: block continuation did not advance\")\n      } else {\n        (ESeq(e, rest), end)\n      }\n    }\n  }\n}\n\nlet parse_block_value_body: (Array[Token], Int, (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Expr, Int, Int) with { Error } = (tokens, eq, parse_recur) -> {\n  let val_pair = parse_recur(tokens, eq, 0)\n  let val = val_pair.0\n  let val_next = val_pair.1\n  let a = skip_semi(tokens, val_next)\n  let (body, end) = parse_recur(tokens, a, 20)\n  (val, body, end, a)\n}\n\nlet parse_block_value_only: (Array[Token], Int, (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } = (tokens, value_pos, parse_recur) -> {\n  let val_pair = parse_recur(tokens, value_pos, 0)\n  (val_pair.0, skip_semi(tokens, val_pair.1))\n}\n\nlet apply_struct_destr: (Pat, Expr, Expr) -> Expr = (pat, val, rest) -> {\n  let val_name = \"__struct_destr\"\n  let mut desugar = rest\n  match pat {\n    PStruct(_, fields) => {\n      let mut di = Array::length(fields) - 1\n      while di >= 0 {\n        let (fname, fpat) = Array::get(fields, di)\n        match fpat {\n          PBind(bname) => {\n            desugar = ELet(bname, EDot(EIdent(val_name, -1), fname, -1, -1), desugar, -1)\n          },\n          _ => ()\n        }\n        di = di - 1\n      }\n    },\n    _ => ()\n  }\n  ELet(val_name, val, desugar, -1)\n}\n\nlet apply_record_destr: (Pat, Expr, Expr) -> Expr = (pat, val, rest) -> {\n  let val_name = \"__rec_destr\"\n  let mut desugar = rest\n  match pat {\n    PTuple(field_pats) => {\n      let mut di = Array::length(field_pats) - 1\n      while di >= 0 {\n        let fp = Array::get(field_pats, di)\n        match fp {\n          PBind(bname) => {\n            desugar = ELet(bname, ECall(EIdent(\"__rec_field\", -1), [\n              EIdent(val_name, -1),\n              EInt(di)\n            ], -1), desugar, -1)\n          },\n          PTuple(sub_pats) => {\n            let sub_name = String::concat(\"__rec_sub_\", __to_string(di))\n            let mut si = Array::length(sub_pats) - 1\n            while si >= 0 {\n              match Array::get(sub_pats, si) {\n                PBind(sname) => {\n                  desugar = ELet(sname, EDot(EIdent(sub_name, -1), __to_string(si), -1, -1), desugar, -1)\n                },\n                _ => ()\n              }\n              si = si - 1\n            }\n            desugar = ELet(sub_name, ECall(EIdent(\"__rec_field\", -1), [\n              EIdent(val_name, -1),\n              EInt(di)\n            ], -1), desugar, -1)\n          },\n          _ => ()\n        }\n        di = di - 1\n      }\n    },\n    _ => ()\n  }\n  ELet(val_name, val, desugar, -1)\n}\n\nlet apply_block_step: (BlockStep, Expr) -> Expr = (step, rest) -> {\n  match step {\n    StepSeq(expr) => ESeq(expr, rest),\n    StepValue(expr) => expr,\n    StepLet(name, val, soff) => ELet(name, val, rest, soff),\n    StepLetMut(name, val, soff) => ELetMut(name, val, rest, soff),\n    StepLetRec(name, val) => ELetRec(name, val, rest),\n    StepAssign(name, val) => EAssign(name, val, rest),\n    StepAssignOp(name, op, val) => EAssignOp(name, op, val, rest),\n    StepPattern(pat, val) => EMatch(val, [\n      (pat, rest)\n    ]),\n    StepPatternElse(pat, val, alt) => EMatch(val, [\n      (pat, rest),\n      (PWild, alt)\n    ]),\n    StepStructDestr(pat, val) => apply_struct_destr(pat, val, rest),\n    StepRecordDestr(pat, val) => apply_record_destr(pat, val, rest),\n    StepBind(name, val) => ECall(EIdent(\"__try_bind\", -1), [\n      val,\n      EFn(Array::slice([\n        \"\"\n      ], 0, 0), Array::slice([\n        (\"\", Array::slice([\n          \"\"\n        ], 0, 0))\n      ], 0, 0), [\n        (name, None)\n      ], None, None, rest)\n    ], -1)\n  }\n}\n\nlet fold_block_steps: (Array[BlockStep]) -> Expr = (steps) -> {\n  let mut result = EUnit\n  let mut i = Array::length(steps) - 1\n  while i >= 0 {\n    result = apply_block_step(Array::get(steps, i), result)\n    i = i - 1\n  }\n  result\n}\n\nlet parse_optional_let_else: (Array[Token], Int, (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Option[Expr], Int) with { Error } = (tokens, pos, parse_recur) -> {\n  match peek(tokens, pos) {\n    TElse => {\n      let br = expect_tk(tokens, pos + 1, \"{\")\n      let (body, end) = parse_recur(tokens, br, 20)\n      (Some(body), end)\n    },\n    _ => (None, pos)\n  }\n}\n\nlet push_pattern_let_step: (Array[Token], ArrayBuilder[BlockStep], Pat, Expr, Int, (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> Int with { Error } = (tokens, steps, pat, val, next_pos, parse_recur) -> {\n  let (else_body, after) = parse_optional_let_else(tokens, next_pos, parse_recur)\n  match else_body {\n    Some(alt) => ArrayBuilder::push(steps, StepPatternElse(pat, val, alt)),\n    None => ArrayBuilder::push(steps, StepPattern(pat, val))\n  }\n  after\n}\n\nlet parse_impl_block: (Array[Token], Array[Int], Int, (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } = (tokens, starts, pos, parse_recur) -> {\n  let steps = ArrayBuilder::new()\n  let mut p = pos\n  let mut end_pos = pos\n  let mut done = false\n  while !done {\n    match peek(tokens, p) {\n      TRBrace => {\n        end_pos = p + 1\n        done = true\n      },\n      TEof => throw(\"unexpected eof in block\"),\n      TEnum => {\n        let (enum_stmt, enum_end) = parse_enum_stmt(tokens, p + 1, false)\n        match enum_stmt {\n          SEnum(_, _, _, variants, _) => {\n            let mut vi = 0\n            while vi < Array::length(variants) {\n              let (vname, vfields) = Array::get(variants, vi)\n              if Array::length(vfields) == 0 {\n                ArrayBuilder::push(steps, StepLet(vname, EInt(vi), -1))\n              }\n              vi = vi + 1\n            }\n          },\n          _ => ()\n        }\n        p = enum_end\n      },\n      TStruct => {\n        let (_, struct_end) = parse_struct_stmt(tokens, p + 1, false)\n        p = struct_end\n      },\n      TLet => {\n        let next = p + 1\n        match peek(tokens, next) {\n          TRec => match peek(tokens, next + 1) {\n            TIdent(name) => {\n              let (rtps, rtbs, rec_ann, eq_pos_r) = match peek(tokens, next + 2) {\n                TColon => {\n                  let (tps, tbs, rty, tp) = parse_local_let_annotation(tokens, next + 3)\n                  (tps, tbs, Some(rty), tp)\n                },\n                _ => {\n                  let no_tp = Array::slice([\n                    \"\"\n                  ], 0, 0)\n                  let no_tb = Array::slice([\n                    (\"\", Array::slice([\n                      \"\"\n                    ], 0, 0))\n                  ], 0, 0)\n                  (no_tp, no_tb, None, next + 2)\n                }\n              }\n              let eq = expect_tk(tokens, eq_pos_r, \"=\")\n              let (val, next_pos) = parse_block_value_only(tokens, eq, parse_recur)\n              if next_pos <= eq {\n                throw(\"internal parser error: block let-rec parser did not advance\")\n              } else {\n                let val2 = match rec_ann {\n                  Some(the_type) => match distribute_local_fn_ann(the_type, val) {\n                    Some(distributed) => apply_local_let_tp(rtps, rtbs, distributed),\n                    None => val\n                  },\n                  None => val\n                }\n                ArrayBuilder::push(steps, StepLetRec(name, val2))\n                p = next_pos\n              }\n            },\n            _ => throw(\"expected identifier after 'let rec'\")\n          },\n          TMut => match peek(tokens, next + 1) {\n            TIdent(name) => {\n              let eq_pos_m = match peek(tokens, next + 2) {\n                TColon => {\n                  let (_, tp) = parse_type_impl(tokens, next + 3, 0)\n                  tp\n                },\n                _ => next + 2\n              }\n              let eq = expect_tk(tokens, eq_pos_m, \"=\")\n              let (val, next_pos) = parse_block_value_only(tokens, eq, parse_recur)\n              if next_pos <= eq {\n                throw(\"internal parser error: block let-mut parser did not advance\")\n              } else {\n                ArrayBuilder::push(steps, StepLetMut(name, val, blk_offset_at(starts, next - 1)))\n                p = next_pos\n              }\n            },\n            _ => throw(\"expected identifier after 'let mut'\")\n          },\n          TStar => match peek(tokens, next + 1) {\n            TIdent(name) => {\n              let eq = expect_tk(tokens, next + 2, \"=\")\n              let (val, next_pos) = parse_block_value_only(tokens, eq, parse_recur)\n              if next_pos <= eq {\n                throw(\"internal parser error: block let* parser did not advance\")\n              } else {\n                ArrayBuilder::push(steps, StepBind(name, val))\n                p = next_pos\n              }\n            },\n            _ => throw(\"expected identifier after 'let*'\")\n          },\n          TIdent(name) => {\n            let after_name = peek(tokens, next + 1)\n            let next_is_struct_destr = match after_name {\n              TDoubleColon => {\n                let fc = String::char_code_at(name, 0)\n                if fc >= 65 && fc <= 90 {\n                  match peek(tokens, next + 2) {\n                    TLBrace => true,\n                    _ => false\n                  }\n                } else {\n                  false\n                }\n              },\n              _ => false\n            }\n            let next_is_record_destr = match after_name {\n              TLBrace => name == \"record\",\n              _ => false\n            }\n            if next_is_struct_destr {\n              let (pat, pn) = parse_pattern(tokens, next)\n              let eq = expect_tk(tokens, pn, \"=\")\n              let (val, next_pos) = parse_block_value_only(tokens, eq, parse_recur)\n              ArrayBuilder::push(steps, StepStructDestr(pat, val))\n              p = next_pos\n            } else if next_is_record_destr {\n              let (pat, pn) = parse_pattern(tokens, next)\n              let eq = expect_tk(tokens, pn, \"=\")\n              let (val, next_pos) = parse_block_value_only(tokens, eq, parse_recur)\n              ArrayBuilder::push(steps, StepRecordDestr(pat, val))\n              p = next_pos\n            } else {\n              match after_name {\n                TLParen => {\n                  let (pat, pn) = parse_pattern(tokens, next)\n                  let eq = expect_tk(tokens, pn, \"=\")\n                  let (val, next_pos) = parse_block_value_only(tokens, eq, parse_recur)\n                  if next_pos <= eq {\n                    throw(\"internal parser error: block let-ctor-pat parser did not advance\")\n                  } else {\n                    p = push_pattern_let_step(tokens, steps, pat, val, next_pos, parse_recur)\n                  }\n                },\n                _ => {\n                  let (ltps, ltbs, ann_type, eq_pos) = match after_name {\n                    TColon => {\n                      let (tps, tbs, the_type, tp) = parse_local_let_annotation(tokens, next + 2)\n                      (tps, tbs, Some(the_type), tp)\n                    },\n                    _ => {\n                      let no_tp = Array::slice([\n                        \"\"\n                      ], 0, 0)\n                      let no_tb = Array::slice([\n                        (\"\", Array::slice([\n                          \"\"\n                        ], 0, 0))\n                      ], 0, 0)\n                      (no_tp, no_tb, None, next + 1)\n                    }\n                  }\n                  let eq = expect_tk(tokens, eq_pos, \"=\")\n                  let (val, next_pos) = parse_block_value_only(tokens, eq, parse_recur)\n                  if next_pos <= eq {\n                    throw(\"internal parser error: block let parser did not advance\")\n                  } else {\n                    let val2 = match ann_type {\n                      Some(the_type) => match distribute_local_fn_ann(the_type, val) {\n                        Some(distributed) => apply_local_let_tp(ltps, ltbs, distributed),\n                        None => ascribe_wrap(val, the_type)\n                      },\n                      None => val\n                    }\n                    ArrayBuilder::push(steps, StepLet(name, val2, blk_offset_at(starts, next - 1)))\n                    p = next_pos\n                  }\n                }\n              }\n            }\n          },\n          TLParen => {\n            let (pat, pn) = parse_pattern(tokens, next)\n            let eq = expect_tk(tokens, pn, \"=\")\n            let (val, next_pos) = parse_block_value_only(tokens, eq, parse_recur)\n            if next_pos <= eq {\n              throw(\"internal parser error: block let-pat parser did not advance\")\n            } else {\n              p = push_pattern_let_step(tokens, steps, pat, val, next_pos, parse_recur)\n            }\n          },\n          _ => throw(\"expected identifier after 'let'\")\n        }\n      },\n      _ => {\n        let (e, next) = parse_recur(tokens, p, 0)\n        if next <= p {\n          throw(\"internal parser error: block expr parser did not advance\")\n        } else {\n          match peek(tokens, next) {\n            TRBrace => {\n              ArrayBuilder::push(steps, StepValue(e))\n              end_pos = next + 1\n              done = true\n            },\n            TSemicolon => {\n              ArrayBuilder::push(steps, StepSeq(e))\n              p = next + 1\n            },\n            TEq => match e {\n              EIdent(name, _) => {\n                let (val, next_pos) = parse_block_value_only(tokens, next + 1, parse_recur)\n                ArrayBuilder::push(steps, StepAssign(name, val))\n                p = next_pos\n              },\n              EDot(obj, field, _, _) => {\n                let (val, next_pos) = parse_block_value_only(tokens, next + 1, parse_recur)\n                let set_args = empty_exprs()\n                Array::push(set_args, obj)\n                Array::push(set_args, EString(field))\n                Array::push(set_args, val)\n                ArrayBuilder::push(steps, StepSeq(ECall(EIdent(\"__set_field\", -1), set_args, -1)))\n                p = next_pos\n              },\n              ECall(sidx_callee, sidx_args, _) => {\n                let s_is_index = match sidx_callee {\n                  EIdent(sicn, _) => sicn == \"__index\",\n                  _ => false\n                }\n                if s_is_index && Array::length(sidx_args) == 2 {\n                  let (val, next_pos) = parse_block_value_only(tokens, next + 1, parse_recur)\n                  let set_args = empty_exprs()\n                  Array::push(set_args, Array::get(sidx_args, 0))\n                  Array::push(set_args, Array::get(sidx_args, 1))\n                  Array::push(set_args, val)\n                  ArrayBuilder::push(steps, StepSeq(ECall(EIdent(\"Array::set\", -1), set_args, -1)))\n                  p = next_pos\n                } else {\n                  throw(\"invalid assignment target\")\n                }\n              },\n              _ => throw(\"invalid assignment target\")\n            },\n            TPlusEq => match e {\n              EIdent(name, _) => {\n                let (val, next_pos) = parse_block_value_only(tokens, next + 1, parse_recur)\n                ArrayBuilder::push(steps, StepAssignOp(name, \"+\", val))\n                p = next_pos\n              },\n              _ => throw(\"invalid assignment target\")\n            },\n            TMinusEq => match e {\n              EIdent(name, _) => {\n                let (val, next_pos) = parse_block_value_only(tokens, next + 1, parse_recur)\n                ArrayBuilder::push(steps, StepAssignOp(name, \"-\", val))\n                p = next_pos\n              },\n              _ => throw(\"invalid assignment target\")\n            },\n            TStarEq => match e {\n              EIdent(name, _) => {\n                let (val, next_pos) = parse_block_value_only(tokens, next + 1, parse_recur)\n                ArrayBuilder::push(steps, StepAssignOp(name, \"*\", val))\n                p = next_pos\n              },\n              _ => throw(\"invalid assignment target\")\n            },\n            TSlashEq => match e {\n              EIdent(name, _) => {\n                let (val, next_pos) = parse_block_value_only(tokens, next + 1, parse_recur)\n                ArrayBuilder::push(steps, StepAssignOp(name, \"/\", val))\n                p = next_pos\n              },\n              _ => throw(\"invalid assignment target\")\n            },\n            TPercentEq => match e {\n              EIdent(name, _) => {\n                let (val, next_pos) = parse_block_value_only(tokens, next + 1, parse_recur)\n                ArrayBuilder::push(steps, StepAssignOp(name, \"%\", val))\n                p = next_pos\n              },\n              _ => throw(\"invalid assignment target\")\n            },\n            _ => {\n              ArrayBuilder::push(steps, StepSeq(e))\n              p = next\n            }\n          }\n        }\n      }\n    }\n  }\n  (fold_block_steps(ArrayBuilder::freeze(steps)), end_pos)\n}\n\n\nexport let parse_impl_dispatch: (Array[Token], Array[Int], Int, Int, (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } = (tokens, starts, pos, mode, parse_recur) -> {\n  if mode == 20 {\n    parse_impl_block(tokens, starts, pos, parse_recur)\n  } else if mode == 21 {\n    let (cond, cn) = parse_infix_no_is(tokens, starts, pos, 0, pos, parse_recur)\n    let mut is_mode = false\n    let mut is_pat_val = PWild\n    let mut brace_pos = cn\n    match peek(tokens, cn) {\n      TIs => {\n        let (pat, pn) = parse_pattern(tokens, cn + 1)\n        is_mode = true\n        is_pat_val = pat\n        brace_pos = pn\n      },\n      TIdent(kw) => if kw == \"is\" {\n        let (pat, pn) = parse_pattern(tokens, cn + 1)\n        is_mode = true\n        is_pat_val = pat\n        brace_pos = pn\n      },\n      _ => ()\n    }\n    let br = expect_tk(tokens, brace_pos, \"{\")\n    let (then_e, tn) = parse_recur(tokens, br, 20)\n    let (else_e, end_pos) = match peek(tokens, tn) {\n      TElse => match peek(tokens, tn + 1) {\n        TIf => parse_recur(tokens, tn + 2, 21),\n        TLBrace => parse_recur(tokens, tn + 2, 20),\n        _ => parse_recur(tokens, tn + 1, 0)\n      },\n      _ => (EUnit, tn)\n    }\n    if is_mode {\n      (EMatch(cond, [\n        (is_pat_val, then_e),\n        (PWild, else_e)\n      ]), end_pos)\n    } else {\n      (EIf(cond, then_e, else_e), end_pos)\n    }\n  } else if mode == 22 {\n    let (scrutinee, sn) = parse_recur(tokens, pos, 0)\n    let br = expect_tk(tokens, sn, \"{\")\n    match peek(tokens, br) {\n      TRBrace => (EMatch(scrutinee, empty_arms()), br + 1),\n      _ => {\n        let ab = ArrayBuilder::new()\n        let hg = [false]\n        let endpos = collect_match_arms(tokens, starts, br, ab, hg, parse_recur)\n        let arms3 = ArrayBuilder::freeze(ab)\n        if Array::get(hg, 0) {\n          let final_arms = desugar_guarded(arms3, 0, EIdent(\"__mg\", 0 - 1))\n          (ELet(\"__mg\", scrutinee, EMatch(EIdent(\"__mg\", 0 - 1), final_arms), -1), endpos)\n        } else {\n          let plain = ArrayBuilder::new()\n          let mut k = 0\n          while k < Array::length(arms3) {\n            let (p, _, bd) = Array::get(arms3, k)\n            ArrayBuilder::push(plain, (p, bd))\n            k = k + 1\n          }\n          (EMatch(scrutinee, ArrayBuilder::freeze(plain)), endpos)\n        }\n      }\n    }\n  } else if mode == 23 {\n    let (cond, cn) = parse_recur(tokens, pos, 0)\n    let br = expect_tk(tokens, cn, \"{\")\n    let (body, end) = parse_recur(tokens, br, 20)\n    (EWhile(cond, body), end)\n  } else if mode == 24 {\n    let br = expect_tk(tokens, pos, \"{\")\n    let (body, bn) = parse_recur(tokens, br, 20)\n    let wp = expect_tk(tokens, bn, \"with\")\n    let (effect_name, effect_next) = match peek(tokens, wp) {\n      TIdent(name) => (name, wp + 1),\n      _ => throw(\"expected effect name after 'with'\")\n    }\n    let hb = expect_tk(tokens, effect_next, \"{\")\n    match peek(tokens, hb) {\n      TRBrace => (EHandle(body, empty_arms()), hb + 1),\n      _ => {\n        let b = ArrayBuilder::new()\n        let (arm, next) = parse_handle_arm(tokens, starts, hb, effect_name, parse_recur)\n        ArrayBuilder::push(b, arm)\n        parse_handle_rest(tokens, starts, next, body, effect_name, b, parse_recur)\n      }\n    }\n  } else if mode == 25 {\n    let mut start = pos\n    let mut is_await = false\n    match peek(tokens, pos) {\n      TIdent(marker) => if marker == \"await\" {\n        match peek(tokens, pos + 1) {\n          TIdent(_) => { start = pos + 1; is_await = true },\n          _ => ()\n        }\n      } else (),\n      _ => ()\n    }\n    match peek(tokens, start) {\n      TIdent(first_name) => match peek(tokens, start + 1) {\n        TComma => match peek(tokens, start + 2) {\n          TIdent(second_name) => {\n            let ip = expect_tk(tokens, start + 3, \"in\")\n            match parse_recur(tokens, ip, 0) {\n              (iterable, after_iter) => {\n                let bb = expect_tk(tokens, after_iter, \"{\")\n                let (body, end) = parse_recur(tokens, bb, 20)\n                let loop_expr = if is_await {\n                  EForIn(second_name, Some(first_name), ECall(EIdent(\"__await_iter\", -1), [\n                    iterable\n                  ], -1), body)\n                } else {\n                  EForIn(second_name, Some(first_name), iterable, body)\n                }\n                (loop_expr, end)\n              },\n              _ => throw(\"unreachable: parse_recur for for-in\")\n            }\n          },\n          _ => throw(\"expected value binding name after ','\")\n        },\n        _ => {\n          let ip = expect_tk(tokens, start + 1, \"in\")\n          match parse_recur(tokens, ip, 0) {\n            (iterable, after_iter) => {\n              let bb = expect_tk(tokens, after_iter, \"{\")\n              let (body, end) = parse_recur(tokens, bb, 20)\n              let loop_expr = if is_await {\n                EForIn(first_name, None, ECall(EIdent(\"__await_iter\", -1), [\n                  iterable\n                ], -1), body)\n              } else {\n                EForIn(first_name, None, iterable, body)\n              }\n              (loop_expr, end)\n            },\n            _ => throw(\"unreachable: parse_recur for for-in\")\n          }\n        }\n      }\n      ,\n      _ => throw(\"expected identifier after 'for'\")\n    }\n  } else {\n    let actual = tk_name(peek(tokens, pos))\n    throw(\"internal parser error: unknown parse mode \\{mode} at #\\{pos} token=\\{actual}\")\n  }\n}\n")
}

let selfhost_source_11 = () -> (String, String) {
  ("lib/@vibe/parser/parser_expr.vibe",
"\n\n\n\n\n\n\nexport let parse_impl: (Array[Token], Array[Int], Int, Int) -> (Expr, Int) with { Error } = (tokens, starts, pos, mode) -> {\n  let rec parse_recur: (Array[Token], Int, Int) -> (Expr, Int) with { Error } = (rtoks, rpos, rmode) -> {\n    if rmode >= 0 && rmode <= 10 {\n      parse_infix(rtoks, starts, rpos, rmode, rpos, parse_recur)\n    } else {\n      parse_impl_dispatch(rtoks, starts, rpos, rmode, parse_recur)\n    }\n  }\n  parse_recur(tokens, pos, mode)\n}\n\nexport let parse: (Array[Token]) -> Expr with { Error } = (tokens) -> {\n  let (e, next) = parse_impl(tokens, [], 0, 0)\n  match peek(tokens, next) {\n    TEof => e,\n    _ => {\n      let actual = tk_name(peek(tokens, next))\n      throw(\"unexpected after expression: \\{actual}\")\n    }\n  }\n}\n\nexport let parse_ok: (Array[Token]) -> Bool = (tokens) -> {\n  handle {\n    let _ = parse(tokens)\n    true\n  } with Error {\n    Throw(_) => false\n  }\n}\n\nexport let parse_expr: (Array[Token], Int) -> (Expr, Int) with { Error } = (tokens, pos) -> {\n  parse_impl(tokens, [], pos, 0)\n}\n\nlet parse_type_param_bound_names: (Array[Token], Int) -> (Array[String], Int) with { Error } = (tokens, pos) -> {\n  let b = ArrayBuilder::new()\n  let mut p = pos\n  let mut done = false\n  while !done {\n    match peek(tokens, p) {\n      TIdent(name) => {\n        ArrayBuilder::push(b, name)\n        p = p + 1\n        match peek(tokens, p) {\n          TPlus => {\n            p = p + 1\n          },\n          _ => {\n            done = true\n          }\n        }\n      },\n      _ => throw(\"expected trait bound name\")\n    }\n  }\n  (ArrayBuilder::freeze(b), p)\n}\n\nlet parse_let_type_params: (Array[Token], Int) -> (Array[String], Array[(String, Array[String])], Int) with { Error } = (tokens, pos) -> {\n  let names = ArrayBuilder::new()\n  let bounds = ArrayBuilder::new()\n  let mut p = pos\n  while true {\n    match peek(tokens, p) {\n      TRBracket => {\n        p = p + 1\n        break\n      },\n      TIdent(name) => {\n        ArrayBuilder::push(names, name)\n        p = p + 1\n        match peek(tokens, p) {\n          TColon => {\n            let (bound_names, next) = parse_type_param_bound_names(tokens, p + 1)\n            ArrayBuilder::push(bounds, (name, bound_names))\n            p = next\n          },\n          _ => ()\n        }\n        match peek(tokens, p) {\n          TComma => {\n            p = p + 1\n          },\n          TRBracket => {\n            p = p + 1\n            break\n          },\n          _ => throw(\"expected ',' or ']' in type params\")\n        }\n      },\n      _ => throw(\"expected type parameter name or ']'\")\n    }\n  }\n  (ArrayBuilder::freeze(names), ArrayBuilder::freeze(bounds), p)\n}\n\nlet parse_let_annotation: (Array[Token], Int) -> (Array[String], Array[(String, Array[String])], TypeExpr, Int) with { Error } = (tokens, pos) -> {\n  match peek(tokens, pos) {\n    TLBracket => {\n      let (type_params, type_bounds, after_params) = parse_let_type_params(tokens, pos + 1)\n      let (ty, next) = parse_type_impl(tokens, after_params, 0)\n      (type_params, type_bounds, ty, next)\n    },\n    _ => {\n      let (ty, next) = parse_type_impl(tokens, pos, 0)\n      (_no_tp(), _no_tb(), ty, next)\n    }\n  }\n}\n\nlet apply_fn_annotation_params: (Array[(String, Option[TypeExpr])], Array[TypeExpr]) -> Array[(String, Option[TypeExpr])] = (params, param_types) -> {\n  if Array::length(params) != Array::length(param_types) {\n    params\n  } else {\n    let out = ArrayBuilder::new()\n    let mut i = 0\n    while i < Array::length(params) {\n      let (name, ann) = Array::get(params, i)\n      let next_ann = match ann {\n        Some(_) => ann,\n        None => Some(Array::get(param_types, i))\n      }\n      ArrayBuilder::push(out, (name, next_ann))\n      i = i + 1\n    }\n    ArrayBuilder::freeze(out)\n  }\n}\n\nlet apply_generic_fn_annotation: (Array[String], Array[(String, Array[String])], Option[TypeExpr], Expr, Array[TypeExpr], TypeExpr, Option[String]) -> (Option[TypeExpr], Expr) = (type_params, type_bounds, ann, val, param_types, ret_ty, effect_name) -> {\n  match val {\n    EFn(existing_type_params, existing_type_bounds, params, ret_opt, effect_opt, body) => {\n      let next_params = apply_fn_annotation_params(params, param_types)\n      let next_ret = match ret_opt {\n        Some(_) => ret_opt,\n        None => Some(ret_ty)\n      }\n      let next_effect = match effect_opt {\n        Some(_) => effect_opt,\n        None => effect_name\n      }\n      let next_type_params = if Array::length(type_params) > 0 {\n        type_params\n      } else existing_type_params\n      let next_type_bounds = if Array::length(type_params) > 0 {\n        type_bounds\n      } else existing_type_bounds\n      let next_ann = if Array::length(type_params) > 0 {\n        None\n      } else ann\n      (next_ann, EFn(next_type_params, next_type_bounds, next_params, next_ret, next_effect, body))\n    },\n    _ => (ann, val)\n  }\n}\n\nlet apply_generic_let_annotation: (Array[String], Array[(String, Array[String])], Option[TypeExpr], Expr) -> (Option[TypeExpr], Expr) = (type_params, type_bounds, ann, val) -> {\n  match ann {\n    Some(ann_ty) => match ann_ty {\n      TyFn(param_types, ret_ty, effect_name) => apply_generic_fn_annotation(type_params, type_bounds, ann, val, param_types, ret_ty, effect_name),\n      _ => (ann, val)\n    },\n    _ => (ann, val)\n  }\n}\n\nlet apply_value_bracket_type_params: (Array[String], Array[(String, Array[String])], Expr) -> Expr = (tps, tbs, val) -> {\n  if Array::length(tps) == 0 {\n    val\n  } else {\n    match val {\n      EFn(existing_tp, existing_tb, params, ret, eff, body) => {\n        let next_tp = if Array::length(existing_tp) > 0 {\n          existing_tp\n        } else tps\n        let next_tb = if Array::length(existing_tp) > 0 {\n          existing_tb\n        } else tbs\n        EFn(next_tp, next_tb, params, ret, eff, body)\n      },\n      _ => val\n    }\n  }\n}\n\nlet skip_generic_value_start: (Array[Token], Int) -> Int = (tokens, pos) -> {\n  match peek(tokens, pos) {\n    TLBracket => match peek(tokens, pos + 1) {\n      TIdent(_) => {\n        let maybe_generic = match peek(tokens, pos + 2) {\n          TRBracket => match peek(tokens, pos + 3) {\n            TLParen => true,\n            _ => false\n          },\n          TColon => true,\n          TComma => true,\n          _ => false\n        }\n        if maybe_generic {\n          let mut scan_pos = pos + 1\n          let mut depth = 1\n          while depth > 0 {\n            match peek(tokens, scan_pos) {\n              TLBracket => {\n                depth = depth + 1\n              },\n              TRBracket => {\n                depth = depth - 1\n              },\n              _ => ()\n            }\n            scan_pos = scan_pos + 1\n          }\n          scan_pos\n        } else {\n          pos\n        }\n      },\n      _ => pos\n    },\n    _ => pos\n  }\n}\n\nlet parse_value_bracket_header: (Array[Token], Int) -> (Array[String], Array[(String, Array[String])], Int) with { Error } = (tokens, pos) -> {\n  let skipped = skip_generic_value_start(tokens, pos)\n  if skipped == pos {\n    (_no_tp(), _no_tb(), pos)\n  } else {\n    match peek(tokens, pos) {\n      TLBracket => {\n        let (tps, tbs, _after) = parse_let_type_params(tokens, pos + 1)\n        (tps, tbs, skipped)\n      },\n      _ => (_no_tp(), _no_tb(), skipped)\n    }\n  }\n}\n\nlet parse_let_stmt: (Array[Token], Array[Int], Int, Bool) -> (Stmt, Int) with { Error } = (tokens, starts, pos, exported) -> {\n  match peek(tokens, pos) {\n    TRec => {\n      let (name, name_next) = parse_binding_name(tokens, pos + 1)\n      let (type_params, type_bounds, ty_opt, eq_pos) = match peek(tokens, name_next) {\n        TColon => {\n          let (tparams, tbounds, ty, tp) = parse_let_annotation(tokens, name_next + 1)\n          (tparams, tbounds, Some(ty), tp)\n        },\n        _ => (_no_tp(), _no_tb(), None, name_next)\n      }\n      let ep = expect_tk(tokens, eq_pos, \"=\")\n      let (bracket_tps, bracket_tbs, val_start_r) = parse_value_bracket_header(tokens, ep)\n      let val_pair = parse_impl(tokens, starts, val_start_r, 0)\n      let val_with_tp = apply_value_bracket_type_params(bracket_tps, bracket_tbs, val_pair.0)\n      let (final_ty_opt, val) = apply_generic_let_annotation(type_params, type_bounds, ty_opt, val_with_tp)\n      let val_next = val_pair.1\n      (SLet(exported, true, name, final_ty_opt, val), val_next)\n    },\n    TMut => match peek(tokens, pos + 1) {\n      TIdent(name) => {\n        let (ty_opt, eq_pos) = match peek(tokens, pos + 2) {\n          TColon => {\n            let (ty, tp) = parse_type_impl(tokens, pos + 3, 0)\n            (Some(ty), tp)\n          },\n          _ => (None, pos + 2)\n        }\n        let ep = expect_tk(tokens, eq_pos, \"=\")\n        let val_pair = parse_impl(tokens, starts, ep, 0)\n        let val = val_pair.0\n        let val_next = val_pair.1\n        (SLetMut(name, ty_opt, val), val_next)\n      },\n      _ => throw(\"expected name after 'let mut'\")\n    },\n    TLParen => {\n      let (pat, pat_next) = parse_pattern(tokens, pos)\n      let ep = expect_tk(tokens, pat_next, \"=\")\n      let val_pair = parse_impl(tokens, starts, ep, 0)\n      let val = val_pair.0\n      let val_next = val_pair.1\n      (SLetPat(pat, val), val_next)\n    },\n    TIdent(_name0) => {\n      let is_struct_destructure = match peek(tokens, pos + 1) {\n        TDoubleColon => match peek(tokens, pos + 2) {\n          TLBrace => true,\n          _ => false\n        },\n        _ => false\n      }\n      if is_struct_destructure {\n        let (pat, pat_next) = parse_pattern(tokens, pos)\n        let ep = expect_tk(tokens, pat_next, \"=\")\n        let val_pair = parse_impl(tokens, starts, ep, 0)\n        let val = val_pair.0\n        let val_next = val_pair.1\n        (SLetPat(pat, val), val_next)\n      } else {\n        let (name, name_next) = parse_binding_name(tokens, pos)\n        let (type_params, type_bounds, ty_opt, eq_pos) = match peek(tokens, name_next) {\n          TColon => {\n            let (tparams, tbounds, ty, tp) = parse_let_annotation(tokens, name_next + 1)\n            (tparams, tbounds, Some(ty), tp)\n          },\n          _ => (_no_tp(), _no_tb(), None, name_next)\n        }\n        let ep = expect_tk(tokens, eq_pos, \"=\")\n        let (bracket_tps, bracket_tbs, val_start) = parse_value_bracket_header(tokens, ep)\n        let val_pair = parse_impl(tokens, starts, val_start, 0)\n        let val_with_tp = apply_value_bracket_type_params(bracket_tps, bracket_tbs, val_pair.0)\n        let (final_ty_opt, val) = apply_generic_let_annotation(type_params, type_bounds, ty_opt, val_with_tp)\n        let val_next = val_pair.1\n        (SLet(exported, false, name, final_ty_opt, val), val_next)\n      }\n    },\n    _ => throw(\"expected name after 'let'\")\n  }\n}\n\nexport let parse_fn_signature: (Array[Token], Int) -> ((String, Array[String], Array[(String, Array[String])]), (Array[(String, Option[TypeExpr])], TypeExpr, Option[String]), (Array[Expr], Array[Expr]), Int) with { Error } = (tokens, pos) -> {\n  let (name, name_next) = parse_binding_name(tokens, pos)\n  let (tps, tbs, after_gen) = parse_value_bracket_header(tokens, name_next)\n  let lp = expect_tk(tokens, after_gen, \"(\")\n  let (params, after_params) = parse_param_list(tokens, lp)\n  let mut pi = 0\n  while pi < Array::length(params) {\n    let param = Array::get(params, pi)\n    let pty = param.1\n    match pty {\n      Some(_) => (),\n      None => throw(\"fn parameter '\\{param.0}' requires a type annotation\")\n    }\n    pi = pi + 1\n  }\n  let arrow = expect_tk(tokens, after_params, \"->\")\n  let (ret_ty, ret_next) = parse_type_impl(tokens, arrow, 0)\n  let (eff_opt, eff_next) = match peek(tokens, ret_next) {\n    TWith => {\n      let wb = expect_tk(tokens, ret_next + 1, \"{\")\n      let (eff_names, en) = collect_effect_names(tokens, wb, \"\")\n      (Some(eff_names), en)\n    },\n    _ => (None, ret_next)\n  }\n  let reqs = Array::slice([\n    EIdent(\"\", 0 - 1)\n  ], 0, 0)\n  let enss = Array::slice([\n    EIdent(\"\", 0 - 1)\n  ], 0, 0)\n  let where_next = match peek(tokens, eff_next) {\n    TIdent(w) => if w == \"where\" {\n      let mut wp = expect_tk(tokens, eff_next + 1, \"{\")\n      let mut wdone = false\n      while !wdone {\n        match peek(tokens, wp) {\n          TRBrace => {\n            wp = wp + 1\n            wdone = true\n          },\n          TIdent(kind) => {\n            let cp = expect_tk(tokens, wp + 1, \":\")\n            let (cond, cnext) = parse_impl(tokens, [], cp, 0)\n            if kind == \"requires\" {\n              Array::push(reqs, cond)\n            } else if kind == \"ensures\" {\n              Array::push(enss, cond)\n            } else {\n              throw(\"expected 'requires' or 'ensures' in where clause, got '\\{kind}'\")\n            }\n            wp = match peek(tokens, cnext) {\n              TComma => cnext + 1,\n              _ => cnext\n            }\n          },\n          _ => throw(\"expected 'requires', 'ensures', or '}' in where clause\")\n        }\n      }\n      wp\n    } else eff_next,\n    _ => eff_next\n  }\n  ((name, tps, tbs), (params, ret_ty, eff_opt), (reqs, enss), where_next)\n}\n\nlet parse_fn_stmt: (Array[Token], Array[Int], Int, Bool) -> (Stmt, Int) with { Error } = (tokens, starts, pos, exported) -> {\n  let (head, sig, contracts, where_next) = parse_fn_signature(tokens, pos)\n  let (name, tps, tbs) = head\n  let (params, ret_ty, eff_opt) = sig\n  let (reqs, enss) = contracts\n  let br = expect_tk(tokens, where_next, \"{\")\n  let (body, end) = parse_impl(tokens, starts, br, mode_block)\n  let body_with_ensures = if Array::length(enss) == 0 {\n    body\n  } else {\n    let mut exit_expr = EIdent(\"result\", 0 - 1)\n    let mut ei = Array::length(enss)\n    while ei > 0 {\n      ei = ei - 1\n      exit_expr = ESeq(ECall(EIdent(\"assert\", 0 - 1), [\n        Array::get(enss, ei)\n      ], 0 - 1), exit_expr)\n    }\n    ELet(\"result\", body, exit_expr, -1)\n  }\n  let mut guarded = body_with_ensures\n  let mut qi = Array::length(reqs)\n  while qi > 0 {\n    qi = qi - 1\n    guarded = ESeq(ECall(EIdent(\"assert\", 0 - 1), [\n      Array::get(reqs, qi)\n    ], 0 - 1), guarded)\n  }\n  (SLet(exported, true, name, None, EFn(tps, tbs, params, Some(ret_ty), eff_opt, guarded)), end)\n}\n\n\nexport {\n  collect_import_path, empty_fields, empty_import_items, expect_tk, is_tk, parse, parse_effect_stmt, parse_enum_stmt, parse_expr, parse_fn_stmt, parse_impl, parse_impl_stmt_dispatch, parse_import_item, parse_let_stmt, parse_ok, parse_struct_field, parse_suberror_stmt, parse_trait_stmt, parse_type, parse_type_alias_stmt, peek, tk_name\n}\n\nexport {\n  peek, is_tk, parse, tk_name, parse_ok, expect_tk, parse_expr, parse_impl, parse_type, empty_fields, parse_let_stmt, parse_fn_stmt, parse_enum_stmt, parse_trait_stmt, parse_effect_stmt, parse_import_item, empty_import_items, parse_struct_field, collect_import_path, parse_suberror_stmt, parse_type_alias_stmt, parse_impl_stmt_dispatch\n}\n")
}

let selfhost_source_12 = () -> (String, String) {
  ("lib/@vibe/parser/parser.vibe",
"\n\n\n\n\n\n\nlet parser_mode_block = 20\n\nlet empty_names: () -> Array[String] = () -> {\n  Array::slice([\n    \"_\"\n  ], 0, 0)\n}\n\nlet parse_test_stmt: (Array[Token], Array[Int], Int) -> (Stmt, Int) with { Error } = (tokens, starts, pos) -> {\n  match peek(tokens, pos) {\n    TString(name) => {\n      let br = expect_tk(tokens, pos + 1, \"{\")\n      let (body, end) = parse_impl(tokens, starts, br, parser_mode_block);\n      (STest(name, body), end)\n    },\n    _ => throw(\"expected test name string\")\n  }\n}\n\nlet parse_bench_stmt: (Array[Token], Array[Int], Int) -> (Stmt, Int) with { Error } = (tokens, starts, pos) -> {\n  match peek(tokens, pos) {\n    TString(name) => {\n      let br = expect_tk(tokens, pos + 1, \"{\")\n      let (body, end) = parse_impl(tokens, starts, br, parser_mode_block);\n      (SBench(name, body), end)\n    },\n    _ => throw(\"expected bench name string\")\n  }\n}\n\nlet parse_export_name: (Array[Token], Int) -> (String, Int) with { Error } = (tokens, pos) -> {\n  match peek(tokens, pos) {\n    TIdent(name) => match peek(tokens, pos + 1) {\n      TDoubleColon => match peek(tokens, pos + 2) {\n        TIdent(member) =>\n          (String::concat(name, String::concat(\"::\", member)), pos + 3),\n        _ => throw(\"expected qualified member name after '::'\")\n      },\n      _ => (name, pos + 1)\n    },\n    _ => throw(\"expected name in export list\")\n  }\n}\n\nlet rec parse_export_names_rest: (Array[Token], Int, ArrayBuilder[String]) -> (Array[String], Int) with { Error } = (tokens, pos, b) -> {\n  match peek(tokens, pos) {\n    TComma => match peek(tokens, pos + 1) {\n      TRBrace => (ArrayBuilder::freeze(b), pos + 2),\n      TIdent(_) => {\n        let (nm, after) = parse_export_name(tokens, pos + 1)\n        ArrayBuilder::push(b, nm)\n        parse_export_names_rest(tokens, after, b)\n      },\n      _ => throw(\"expected name in export list\")\n    },\n    TRBrace => (ArrayBuilder::freeze(b), pos + 1),\n    _ => throw(\"expected ',' or '}' in export list\")\n  }\n}\n\nlet rec parse_import_items_rest: (Array[Token], Int, ArrayBuilder[(String, Option[String])]) -> (Array[(String, Option[String])], Int) with { Error } = (tokens, pos, b) -> {\n  match peek(tokens, pos) {\n    TComma => match peek(tokens, pos + 1) {\n      TRBrace => (ArrayBuilder::freeze(b), pos + 2),\n      _ => {\n        let (item, next) = parse_import_item(tokens, pos + 1)\n        ArrayBuilder::push(b, item)\n        parse_import_items_rest(tokens, next, b)\n      }\n    },\n    TRBrace => (ArrayBuilder::freeze(b), pos + 1),\n    _ => throw(\"expected ',' or '}' in import list\")\n  }\n}\n\nlet parse_import_items: (Array[Token], Int) -> (Array[(String, Option[String])], Int) with { Error } = (tokens, pos) -> {\n  match peek(tokens, pos) {\n    TRBrace => (empty_import_items(), pos + 1),\n    _ => {\n      let (first, next) = parse_import_item(tokens, pos)\n      let b = ArrayBuilder::new()\n      ArrayBuilder::push(b, first)\n      parse_import_items_rest(tokens, next, b)\n    }\n  }\n}\n\nlet parse_import_path_tail: (Array[Token], Int, String) -> (Stmt, Int) with { Error } = (tokens, bp, path) -> {\n  match peek(tokens, bp) {\n    TIdent(alias_name) => if String::length(alias_name) > 1 && String::char_code_at(alias_name, 0) == '@' {\n      let alias_str = String::substring(alias_name, 1, String::length(alias_name))\n      (SAliasDecl(alias_str, path), bp + 1)\n    } else {\n      let br = expect_tk(tokens, bp, \"{\")\n      let (items, end) = parse_import_items(tokens, br);\n      (SImport(path, items), end)\n    },\n    _ => {\n      let br = expect_tk(tokens, bp, \"{\")\n      let (items, end) = parse_import_items(tokens, br);\n      (SImport(path, items), end)\n    }\n  }\n}\n\nlet parse_import_stmt: (Array[Token], Int) -> (Stmt, Int) with { Error } = (tokens, pos) -> {\n  match peek(tokens, pos) {\n    TIdent(name) => if String::length(name) > 1 && String::char_code_at(name, 0) == '@' {\n      let br = expect_tk(tokens, pos + 1, \"{\")\n      let (items, end) = parse_import_items(tokens, br);\n      (SImport(name, items), end)\n    } else {\n      let (path, bp) = collect_import_path(tokens, pos, \"\")\n      parse_import_path_tail(tokens, bp, path)\n    },\n    _ => {\n      let (path, bp) = collect_import_path(tokens, pos, \"\")\n      parse_import_path_tail(tokens, bp, path)\n    }\n  }\n}\n\nlet tl_push_mut_name: (ArrayBuilder[String], (String, TypeExpr), Bool) -> Unit = (mb, field, is_mut) -> {\n  if is_mut {\n    let (fname, _) = field\n    ArrayBuilder::push(mb, fname)\n  } else {\n    ()\n  }\n}\n\nlet rec parse_toplevel_struct_fields_rest: (Array[Token], Int, ArrayBuilder[(String, TypeExpr)], ArrayBuilder[String]) -> (Array[(String, TypeExpr)], Array[String], Int) with { Error } = (tokens, pos, b, mb) -> {\n  match peek(tokens, pos) {\n    TSemicolon => match peek(tokens, pos + 1) {\n      TRBrace => (ArrayBuilder::freeze(b), ArrayBuilder::freeze(mb), pos + 2),\n      _ => {\n        let (field, is_mut, next) = parse_struct_field(tokens, pos + 1)\n        ArrayBuilder::push(b, field)\n        tl_push_mut_name(mb, field, is_mut)\n        parse_toplevel_struct_fields_rest(tokens, next, b, mb)\n      }\n    },\n    TComma => match peek(tokens, pos + 1) {\n      TRBrace => (ArrayBuilder::freeze(b), ArrayBuilder::freeze(mb), pos + 2),\n      _ => {\n        let (field, is_mut, next) = parse_struct_field(tokens, pos + 1)\n        ArrayBuilder::push(b, field)\n        tl_push_mut_name(mb, field, is_mut)\n        parse_toplevel_struct_fields_rest(tokens, next, b, mb)\n      }\n    },\n    TRBrace => (ArrayBuilder::freeze(b), ArrayBuilder::freeze(mb), pos + 1),\n    _ => throw(\"expected ';', ',' or '}' in struct\")\n  }\n}\n\nlet parse_toplevel_struct_fields: (Array[Token], Int) -> (Array[(String, TypeExpr)], Array[String], Int) with { Error } = (tokens, pos) -> {\n  match peek(tokens, pos) {\n    TRBrace => (empty_fields(), Array::slice([\n      \"\"\n    ], 0, 0), pos + 1),\n    _ => {\n      let (first, is_mut, next) = parse_struct_field(tokens, pos)\n      let b = ArrayBuilder::new()\n      let mb = ArrayBuilder::new()\n      ArrayBuilder::push(b, first)\n      tl_push_mut_name(mb, first, is_mut)\n      parse_toplevel_struct_fields_rest(tokens, next, b, mb)\n    }\n  }\n}\n\nlet parse_toplevel_struct_stmt: (Array[Token], Int, Bool) -> (Stmt, Int) with { Error } = (tokens, pos, exported) -> {\n  match peek(tokens, pos) {\n    TIdent(name) => {\n      let after_name = match peek(tokens, pos + 1) {\n        TLBracket => {\n          let mut skip = pos + 2\n          let mut depth = 1\n          while depth > 0 {\n            match peek(tokens, skip) {\n              TLBracket => {\n                depth = depth + 1; skip = skip + 1\n              },\n              TRBracket => {\n                depth = depth - 1; skip = skip + 1\n              },\n              TEof => {\n                depth = 0\n              },\n              _ => {\n                skip = skip + 1\n              }\n            }\n          }\n          skip\n        },\n        _ => pos + 1\n      }\n      let br = expect_tk(tokens, after_name, \"{\")\n      let (fields, mut_names, end) = parse_toplevel_struct_fields(tokens, br);\n      let (derives, final_pos) = parse_derive_names(tokens, end)\n      (SStruct(exported, name, fields, derives, mut_names), final_pos)\n    },\n    _ => throw(\"expected struct name\")\n  }\n}\n\nlet parse_export_stmt: (Array[Token], Array[Int], Int) -> (Stmt, Int) with { Error } = (tokens, starts, pos) -> {\n  match peek(tokens, pos) {\n    TLet => parse_let_stmt(tokens, starts, pos + 1, true),\n    TEnum => parse_enum_stmt(tokens, pos + 1, true),\n    TSuberror => parse_suberror_stmt(tokens, pos + 1, true),\n    TStruct => parse_toplevel_struct_stmt(tokens, pos + 1, true),\n    TIdent(ident_name) => if ident_name == \"effect\" {\n      parse_effect_stmt(tokens, pos + 1, true)\n    } else if ident_name == \"fn\" {\n      parse_fn_stmt(tokens, starts, pos + 1, true)\n    } else {\n      throw(String::concat(\"unexpected token in export: \", ident_name))\n    },\n    TType => parse_type_alias_stmt(tokens, pos + 1, true),\n    TTrait => parse_trait_stmt(tokens, pos + 1, true),\n    TOpen => match peek(tokens, pos + 1) {\n      TTrait => parse_trait_stmt(tokens, pos + 2, true),\n      _ => throw(\"expected 'trait' after 'open'\")\n    },\n    TLBrace => match peek(tokens, pos + 1) {\n      TRBrace => (SExport(empty_names()), pos + 2),\n      TIdent(_) => {\n        let (first, after) = parse_export_name(tokens, pos + 1)\n        let b = ArrayBuilder::new()\n        ArrayBuilder::push(b, first)\n        let (names, end) = parse_export_names_rest(tokens, after, b);\n        (SExport(names), end)\n      },\n      _ => throw(\"expected name in export list\")\n    },\n    TDot => {\n      let (path, bp) = collect_import_path(tokens, pos, \"\")\n      let br = expect_tk(tokens, bp, \"{\")\n      let (items, end) = parse_import_items(tokens, br);\n      (SReExport(path, items), end)\n    },\n    TDotDot => {\n      let (path, bp) = collect_import_path(tokens, pos, \"\")\n      let br = expect_tk(tokens, bp, \"{\")\n      let (items, end) = parse_import_items(tokens, br);\n      (SReExport(path, items), end)\n    },\n    _ => {\n      let actual = tk_name(peek(tokens, pos))\n      throw(\"unexpected after 'export': \\{actual}\")\n    }\n  }\n}\n\nlet parse_percent_symbol_name: (Array[Token], Int, String) -> (String, Int) with { Error } = (tokens, pos, label) -> {\n  let pp = expect_tk(tokens, pos, \"%\")\n  match peek(tokens, pp) {\n    TIdent(name) => (\"%\\{name}\", pp + 1),\n    _ => throw(\"expected \\{label} after '%'\")\n  }\n}\n\nlet parse_extern_let_stmt: (Array[Token], Int) -> (Stmt, Int) with { Error } = (tokens, pos) -> {\n  let lp = expect_tk(tokens, pos, \"let\")\n  let (name, np) = parse_percent_symbol_name(tokens, lp, \"extern symbol name\")\n  let cp = expect_tk(tokens, np, \":\")\n  let (ty, end) = parse_type(tokens, cp);\n  (SExternLet(name, ty), end)\n}\n\nexport let rec parse_stmt: (Array[Token], Array[Int], Int) -> (Stmt, Int) with { Error } = (tokens, starts, pos) -> {\n  let head = peek(tokens, pos)\n  match head {\n    TLet => parse_let_stmt(tokens, starts, pos + 1, false),\n    TExport => match peek(tokens, pos + 1) {\n      TModule => throw(\"'module' blocks are removed (#728); use file boundaries + import/export\"),\n      _ => parse_export_stmt(tokens, starts, pos + 1)\n    },\n    TModule => throw(\"'module' blocks are removed (#728); use file boundaries + import/export\"),\n    TEnum => parse_enum_stmt(tokens, pos + 1, false),\n    TSuberror => parse_suberror_stmt(tokens, pos + 1, false),\n    TStruct => parse_toplevel_struct_stmt(tokens, pos + 1, false),\n    TType => parse_type_alias_stmt(tokens, pos + 1, false),\n    TTrait => parse_trait_stmt(tokens, pos + 1, false),\n    TTest => parse_test_stmt(tokens, starts, pos + 1),\n    TBench => parse_bench_stmt(tokens, starts, pos + 1),\n    TImport => parse_import_stmt(tokens, pos + 1),\n    TIdent(name) => match name {\n      \"effect\" => parse_effect_stmt(tokens, pos + 1, false),\n      \"extern\" => parse_extern_let_stmt(tokens, pos + 1),\n      \"fn\" => parse_fn_stmt(tokens, starts, pos + 1, false),\n      \"use\" => throw(\"'use' syntax is removed; use 'import <module-ref> { ... }'\"),\n      _ => {\n      let (e, next) = parse_impl(tokens, starts, pos, 0)\n      match peek(tokens, next) {\n        TEq => match e {\n          EIdent(name, _) => {\n            let (val, vn) = parse_impl(tokens, starts, next + 1, 0)\n            (SExpr(EAssign(name, val, EUnit)), vn)\n          },\n          ECall(idx_callee, idx_args, _) => {\n            let is_index = match idx_callee {\n              EIdent(icn, _) => icn == \"__index\",\n              _ => false\n            }\n            if is_index && Array::length(idx_args) == 2 {\n              let (val, vn) = parse_impl(tokens, starts, next + 1, 0)\n              let set_args = Array::slice([\n                EUnit\n              ], 0, 0)\n              Array::push(set_args, Array::get(idx_args, 0))\n              Array::push(set_args, Array::get(idx_args, 1))\n              Array::push(set_args, val)\n              (SExpr(ECall(EIdent(\"Array::set\", -1), set_args, -1)), vn)\n            } else {\n              (SExpr(e), next)\n            }\n          },\n          _ => (SExpr(e), next)\n        },\n        TPlusEq => match e {\n          EIdent(name, _) => {\n            let (val, vn) = parse_impl(tokens, starts, next + 1, 0)\n            (SExpr(EAssignOp(name, \"+\", val, EUnit)), vn)\n          },\n          _ => (SExpr(e), next)\n        },\n        TMinusEq => match e {\n          EIdent(name, _) => {\n            let (val, vn) = parse_impl(tokens, starts, next + 1, 0)\n            (SExpr(EAssignOp(name, \"-\", val, EUnit)), vn)\n          },\n          _ => (SExpr(e), next)\n        },\n        TStarEq => match e {\n          EIdent(name, _) => {\n            let (val, vn) = parse_impl(tokens, starts, next + 1, 0)\n            (SExpr(EAssignOp(name, \"*\", val, EUnit)), vn)\n          },\n          _ => (SExpr(e), next)\n        },\n        TSlashEq => match e {\n          EIdent(name, _) => {\n            let (val, vn) = parse_impl(tokens, starts, next + 1, 0)\n            (SExpr(EAssignOp(name, \"/\", val, EUnit)), vn)\n          },\n          _ => (SExpr(e), next)\n        },\n        _ => (SExpr(e), next)\n      }\n      }\n    },\n    _ => {\n      let (e, next) = parse_impl(tokens, starts, pos, 0);\n      (SExpr(e), next)\n    }\n  }\n}\n\nlet parse_impl_methods: (Array[Token], Int, Stmt) -> (Array[Stmt], Int) with { Error } = (tokens, pos, simpl) -> {\n  let out = ArrayBuilder::new()\n  ArrayBuilder::push(out, simpl)\n  match peek(tokens, pos) {\n    TLBrace => {\n      let type_name = match simpl {\n        SImpl(_, _, _, tn) => tn,\n        _ => \"\"\n      }\n      let impl_tparams = match simpl {\n        SImpl(tp, _, _, _) => tp,\n        _ => Array::slice([\n          \"\"\n        ], 0, 0)\n      }\n      let impl_tbounds = match simpl {\n        SImpl(_, tb, _, _) => tb,\n        _ => Array::slice([\n          (\"\", Array::slice([\n            \"\"\n          ], 0, 0))\n        ], 0, 0)\n      }\n      let mut p = pos + 1\n      let mut done = false\n      while !done {\n        match peek(tokens, p) {\n          TRBrace => {\n            p = p + 1\n            done = true\n          },\n          TIdent(mname) => {\n            let (efn, p2) = parse_expr(tokens, p + 1)\n            let efn2 = if Array::length(impl_tparams) > 0 {\n              match efn {\n                EFn(mtp, mtb, mparams, mret, meff, mbody) => EFn(Array::concat(impl_tparams, mtp), Array::concat(impl_tbounds, mtb), mparams, mret, meff, mbody),\n                _ => efn\n              }\n            } else {\n              efn\n            }\n            let qname = String::concat(type_name, String::concat(\"::\", mname))\n            ArrayBuilder::push(out, SLet(false, true, qname, None, efn2))\n            p = match peek(tokens, p2) {\n              TSemicolon => p2 + 1,\n              _ => p2\n            }\n          },\n          _ => throw(\"expected impl method name or '}'\")\n        }\n      }\n      (ArrayBuilder::freeze(out), p)\n    },\n    _ => (ArrayBuilder::freeze(out), pos)\n  }\n}\n\n\nlet parse_cfg_directive: (Array[Token], Int) -> (String, String, Int) with { Error } = (tokens, pos) -> {\n  match peek(tokens, pos) {\n    TIdent(dname) => {\n      if dname == \"cfg\" || dname == \"cfg_enable\" {\n        match peek(tokens, pos + 1) {\n          TLParen => match peek(tokens, pos + 2) {\n            TIdent(flag) => match peek(tokens, pos + 3) {\n              TRParen => (dname, flag, pos + 4),\n              _ => throw(\"expected ')' after #cfg flag name\")\n            },\n            _ => throw(\"expected flag name in #cfg(...)\")\n          },\n          _ => throw(\"expected '(' after #cfg\")\n        }\n      } else {\n        throw(String::concat(\"unknown # directive: \", dname))\n      }\n    },\n    _ => throw(\"expected directive name after '#'\")\n  }\n}\n\nlet cfg_scan_enabled: (Array[Token]) -> Array[String] with { Error } = (tokens) -> {\n  let out = Array::slice([\n    \"\"\n  ], 0, 0)\n  let mut i = 0\n  let n = Array::length(tokens)\n  while i < n {\n    match Array::get(tokens, i) {\n      THash => {\n        let (dname, flag, next) = parse_cfg_directive(tokens, i + 1)\n        if dname == \"cfg_enable\" {\n          Array::push(out, flag)\n        } else {\n          ()\n        }\n        i = next\n      },\n      _ => {\n        i = i + 1\n      }\n    }\n  }\n  out\n}\n\nlet cfg_flag_active: (Array[String], String) -> Bool = (active, flag) -> {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(active) {\n    if Array::get(active, i) == flag {\n      found = true\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  found\n}\n\nexport let parse_program: (Array[Token]) -> Array[Stmt] with { Error } = (tokens) -> {\n  let cfg_active = cfg_scan_enabled(tokens)\n  let b = ArrayBuilder::new()\n  let mut pos = 0\n  let mut done = false\n  while !done {\n    match peek(tokens, pos) {\n      TEof => {\n        done = true\n      },\n      TSemicolon => {\n        pos = pos + 1\n      },\n      THash => {\n        let (dname, flag, dnext) = parse_cfg_directive(tokens, pos + 1)\n        if dname == \"cfg_enable\" || cfg_flag_active(cfg_active, flag) {\n          pos = dnext\n        } else {\n          match peek(tokens, dnext) {\n            TImpl => {\n              let (simpl_d, hp_d) = parse_impl_stmt_dispatch(tokens, dnext + 1)\n              let (_dropped, dn) = parse_impl_methods(tokens, hp_d, simpl_d)\n              pos = dn\n            },\n            _ => {\n              let (_dropped, dn) = parse_stmt(tokens, [], dnext)\n              pos = dn\n            }\n          }\n        }\n      },\n      TImpl => {\n        let (simpl, hp) = parse_impl_stmt_dispatch(tokens, pos + 1)\n        let (impl_stmts, next) = parse_impl_methods(tokens, hp, simpl)\n        let mut ii = 0\n        while ii < Array::length(impl_stmts) {\n          ArrayBuilder::push(b, Array::get(impl_stmts, ii))\n          ii = ii + 1\n        }\n        pos = next\n      },\n      _ => {\n        let (stmt, next) = parse_stmt(tokens, [], pos)\n        ArrayBuilder::push(b, stmt)\n        pos = next\n      }\n    }\n  }\n  ArrayBuilder::freeze(b)\n}\n\nexport let parse_program_located: (Array[Token], Array[Int], String) -> Array[Stmt] with { Error } = (tokens, starts, source) -> {\n  let cfg_active = cfg_scan_enabled(tokens)\n  let b = ArrayBuilder::new()\n  let mut pos = 0\n  let mut done = false\n  while !done {\n    match peek(tokens, pos) {\n      TEof => {\n        done = true\n      },\n      TSemicolon => {\n        pos = pos + 1\n      },\n      THash => {\n        let (dname, flag, dnext) = parse_cfg_directive(tokens, pos + 1)\n        if dname == \"cfg_enable\" || cfg_flag_active(cfg_active, flag) {\n          pos = dnext\n        } else {\n          match peek(tokens, dnext) {\n            TImpl => {\n              let (simpl_d, hp_d) = parse_impl_stmt_dispatch(tokens, dnext + 1)\n              let (_dropped, dn) = parse_impl_methods(tokens, hp_d, simpl_d)\n              pos = dn\n            },\n            _ => {\n              let (_dropped, dn) = parse_stmt(tokens, starts, dnext)\n              pos = dn\n            }\n          }\n        }\n      },\n      _ => {\n        let start_pos = pos\n        let (stmts, next) = handle {\n          match peek(tokens, pos) {\n            TImpl => {\n              let (simpl, hp) = parse_impl_stmt_dispatch(tokens, pos + 1)\n              parse_impl_methods(tokens, hp, simpl)\n            },\n            _ => {\n              let (stmt, n) = parse_stmt(tokens, starts, pos)\n              ([\n                stmt\n              ], n)\n            }\n          }\n        } with Error {\n          Throw(msg) => {\n            let off = if start_pos < Array::length(starts) {\n              Array::get(starts, start_pos)\n            } else {\n              0\n            }\n            let (line, col) = offset_to_line_col(source, off)\n            let loc = String::concat(\"line \", String::concat(__to_string(line), String::concat(\":\", String::concat(__to_string(col), \": \"))))\n            throw(String::concat(loc, msg))\n          }\n        }\n        let mut ii = 0\n        while ii < Array::length(stmts) {\n          ArrayBuilder::push(b, Array::get(stmts, ii))\n          ii = ii + 1\n        }\n        pos = next\n      }\n    }\n  }\n  ArrayBuilder::freeze(b)\n}\n\nlet is_recovery_point: (Token) -> Bool = (t) -> {\n  match t {\n    TLet => true,\n    TExport => true,\n    TModule => true,\n    TEnum => true,\n    TSuberror => true,\n    TStruct => true,\n    TType => true,\n    TTrait => true,\n    TTest => true,\n    TBench => true,\n    TImport => true,\n    TImpl => true,\n    TDeclare => true,\n    TOpen => true,\n    TSemicolon => true,\n    TEof => true,\n    _ => false\n  }\n}\n\nexport let parse_program_recovering: (Array[Token], Array[Int], String) -> (Array[Stmt], Array[String]) with { Error } = (tokens, starts, source) -> {\n  let cfg_active = handle {\n    cfg_scan_enabled(tokens)\n  } with Error {\n    Throw(_) => Array::slice([\n      \"\"\n    ], 0, 0)\n  }\n  let b = ArrayBuilder::new()\n  let diags = ArrayBuilder::new()\n  let n = Array::length(tokens)\n  let mut pos = 0\n  let mut done = false\n  while !done {\n    match peek(tokens, pos) {\n      TEof => {\n        done = true\n      },\n      TSemicolon => {\n        pos = pos + 1\n      },\n      THash => {\n        let cfg_res = handle {\n          let (dname, flag, dnext) = parse_cfg_directive(tokens, pos + 1)\n          if dname == \"cfg_enable\" || cfg_flag_active(cfg_active, flag) {\n            dnext\n          } else {\n            match peek(tokens, dnext) {\n              TImpl => {\n                let (simpl_d, hp_d) = parse_impl_stmt_dispatch(tokens, dnext + 1)\n                let (_dropped, dn) = parse_impl_methods(tokens, hp_d, simpl_d)\n                dn\n              },\n              _ => {\n                let (_dropped, dn) = parse_stmt(tokens, starts, dnext)\n                dn\n              }\n            }\n          }\n        } with Error {\n          Throw(_) => 0 - 1\n        }\n        if cfg_res >= 0 {\n          pos = cfg_res\n        } else {\n          let mut rp = pos + 1\n          while rp < n && !is_recovery_point(Array::get(tokens, rp)) {\n            rp = rp + 1\n          }\n          pos = rp\n        }\n      },\n      _ => {\n        let start_pos = pos\n        let res = handle {\n          let (stmts, next) = match peek(tokens, pos) {\n            TImpl => {\n              let (simpl, hp) = parse_impl_stmt_dispatch(tokens, pos + 1)\n              parse_impl_methods(tokens, hp, simpl)\n            },\n            _ => {\n              let (stmt, n) = parse_stmt(tokens, starts, pos)\n              ([\n                stmt\n              ], n)\n            }\n          }\n          Some((stmts, next))\n        } with Error {\n          Throw(msg) => {\n            let off = if start_pos < Array::length(starts) {\n              Array::get(starts, start_pos)\n            } else {\n              0\n            }\n            let (line, col) = offset_to_line_col(source, off)\n            let loc = String::concat(\"line \", String::concat(__to_string(line), String::concat(\":\", String::concat(__to_string(col), \": \"))))\n            ArrayBuilder::push(diags, String::concat(loc, msg))\n            None\n          }\n        }\n        match res {\n          Some((stmts, next)) => {\n            let mut ii = 0\n            while ii < Array::length(stmts) {\n              ArrayBuilder::push(b, Array::get(stmts, ii))\n              ii = ii + 1\n            }\n            pos = next\n          },\n          None => {\n            let mut rp = start_pos + 1\n            let mut sync = false\n            while !sync {\n              if rp >= n {\n                sync = true\n              } else {\n                let t = peek(tokens, rp)\n                if is_recovery_point(t) {\n                  sync = true\n                } else {\n                  rp = rp + 1\n                }\n              }\n            }\n            pos = rp\n          }\n        }\n      }\n    }\n  }\n  (ArrayBuilder::freeze(b), ArrayBuilder::freeze(diags))\n}\n\nexport let parse_program_spans: (Array[Token], Array[Int], Array[Int]) -> (Array[Stmt], Array[Int], Array[Int]) with { Error } = (tokens, starts, ends) -> {\n  let b = ArrayBuilder::new()\n  let span_start = ArrayBuilder::new()\n  let span_end = ArrayBuilder::new()\n  let mut pos = 0\n  let mut done = false\n  while !done {\n    match peek(tokens, pos) {\n      TEof => {\n        done = true\n      },\n      TSemicolon => {\n        pos = pos + 1\n      },\n      THash => {\n        throw(\"#cfg directives are not supported in module-source emission\")\n      },\n      TImpl => {\n        let st = Array::get(starts, pos)\n        let (simpl, hp) = parse_impl_stmt_dispatch(tokens, pos + 1)\n        let next = skip_braced_body(tokens, hp)\n        ArrayBuilder::push(b, simpl)\n        ArrayBuilder::push(span_start, st)\n        ArrayBuilder::push(span_end, Array::get(ends, next - 1))\n        pos = next\n      },\n      _ => {\n        let st = Array::get(starts, pos)\n        let (stmt, next) = parse_stmt(tokens, starts, pos)\n        ArrayBuilder::push(b, stmt)\n        ArrayBuilder::push(span_start, st)\n        ArrayBuilder::push(span_end, Array::get(ends, next - 1))\n        pos = next\n      }\n    }\n  }\n  (ArrayBuilder::freeze(b), ArrayBuilder::freeze(span_start), ArrayBuilder::freeze(span_end))\n}\n\n\nexport {\n  Pat, Expr, Stmt, TypeExpr, parse, parse_ok, parse_expr, parse_stmt, parse_type, parse_program\n}\n\nexport {\n  Pat, Expr, Stmt, parse, TypeExpr, parse_ok, parse_expr, parse_stmt, parse_type, parse_program\n}\n")
}

let selfhost_source_13 = () -> (String, String) {
  ("lib/@vibe/parser/expand_interp.vibe",
"\n\n\n\n\n\nlet rec resolve_expr: (Expr) -> Expr with { Error } = (e) -> {\n  let desugar_parts: (Array[String]) -> Expr with { Error } = (parts) -> {\n    let plen = Array::length(parts)\n    let exprs = ArrayBuilder::new()\n    let mut i = 0\n    while i < plen {\n      let lit = Array::get(parts, i)\n      if String::length(lit) > 0 {\n        ArrayBuilder::push(exprs, EString(lit))\n      }\n      if i + 1 < plen {\n        let expr_src = Array::get(parts, i + 1)\n        let expr_tokens = lex(expr_src)\n        let parsed = parse(expr_tokens)\n        let resolved = resolve_expr(parsed)\n        ArrayBuilder::push(exprs, ECall(EIdent(\"__to_string\", -1), [\n          resolved\n        ], -1))\n      }\n      i = i + 2\n    }\n    let result_arr = ArrayBuilder::freeze(exprs)\n    let result_len = Array::length(result_arr)\n    if result_len == 0 {\n      EString(\"\")\n    } else {\n      let mut result = Array::get(result_arr, 0)\n      let mut j = 1\n      while j < result_len {\n        result = ECall(EIdent(\"String::concat\", -1), [\n          result,\n          Array::get(result_arr, j)\n        ], -1)\n        j = j + 1\n      }\n      result\n    }\n  }\n  let resolve_arr: (Array[Expr]) -> Array[Expr] with { Error } = (exprs) -> {\n    for ex in exprs {\n      resolve_expr(ex)\n    }\n  }\n  match e {\n    EStringInterp(parts) => desugar_parts(parts),\n    EInt(_) => e,\n    EFloat(_) => e,\n    EString(_) => e,\n    EBool(_) => e,\n    EUnit => e,\n    EIdent(_, _) => e,\n    ETuple(elems) => ETuple(resolve_arr(elems)),\n    EArray(elems) => EArray(resolve_arr(elems)),\n    ERecord(rn, fields) => ERecord(rn, for f in fields {\n      let (n, v) = f; (n, resolve_expr(v))\n    }),\n    EMap(fields) => EMap(for f in fields {\n      let (n, v) = f; (n, resolve_expr(v))\n    }),\n    EIf(c, t, el) => EIf(resolve_expr(c), resolve_expr(t), resolve_expr(el)),\n    ELet(n, v, b, soff) => ELet(n, resolve_expr(v), resolve_expr(b), soff),\n    ELetRec(n, v, b) => ELetRec(n, resolve_expr(v), resolve_expr(b)),\n    ELetMut(n, v, b, soff) => ELetMut(n, resolve_expr(v), resolve_expr(b), soff),\n    EAssign(n, v, b) => EAssign(n, resolve_expr(v), resolve_expr(b)),\n    EAssignOp(n, op, v, b) => EAssignOp(n, op, resolve_expr(v), resolve_expr(b)),\n    ESeq(a, b) => ESeq(resolve_expr(a), resolve_expr(b)),\n    EMatch(s, arms) => EMatch(resolve_expr(s), for a in arms {\n      let (p, ex) = a; (p, resolve_expr(ex))\n    }),\n    EHandle(body, arms) => EHandle(resolve_expr(body), for a in arms {\n      let (p, ex) = a; (p, resolve_expr(ex))\n    }),\n    EWhile(c, b) => EWhile(resolve_expr(c), resolve_expr(b)),\n    ELoop(params, body) => ELoop(for param in params {\n      let (name, init) = param; (name, resolve_expr(init))\n    }, resolve_expr(body)),\n    EForIn(vn, idx, it, b) => EForIn(vn, idx, resolve_expr(it), resolve_expr(b)),\n    ECall(callee, args, off) => ECall(resolve_expr(callee), resolve_arr(args), off),\n    EBinOp(op, l, r) => EBinOp(op, resolve_expr(l), resolve_expr(r)),\n    EUnaryOp(op, inner) => EUnaryOp(op, resolve_expr(inner)),\n    EFn(a, b, params, ret, eff, body) => EFn(a, b, params, ret, eff, resolve_expr(body)),\n    EDot(inner, field, off, fdoff) => EDot(resolve_expr(inner), field, off, fdoff),\n    EThrow(inner) => EThrow(resolve_expr(inner)),\n    EReturn(inner) => EReturn(resolve_expr(inner)),\n    EBreak(opt) => match opt {\n      None => e,\n      Some(v) => EBreak(Some(resolve_expr(v)))\n    },\n    EContinue(args) => EContinue(resolve_arr(args)),\n    ELabeledArg(n, m, v) => ELabeledArg(n, m, resolve_expr(v)),\n    ESpread(inner) => ESpread(resolve_expr(inner))\n  }\n}\n\nlet resolve_stmt: (Stmt) -> Stmt with { Error } = (s) -> {\n  match s {\n    SLet(exp, is_rec, name, ty, val) => SLet(exp, is_rec, name, ty, resolve_expr(val)),\n    SLetMut(name, ty, val) => SLetMut(name, ty, resolve_expr(val)),\n    STest(name, body) => STest(name, resolve_expr(body)),\n    SBench(name, body) => SBench(name, resolve_expr(body)),\n    SExpr(e) => SExpr(resolve_expr(e)),\n    _ => s\n  }\n}\n\nexport let resolve_interp_expr: (Expr) -> Expr with { Error } = (e) -> {\n  resolve_expr(e)\n}\n\nexport let resolve_interp_stmts: (Array[Stmt]) -> Array[Stmt] with { Error } = (stmts) -> {\n  for s in stmts {\n    resolve_stmt(s)\n  }\n}\n")
}

let selfhost_source_14 = () -> (String, String) {
  ("lib/@vibe/parser/printer.vibe",
"\n\n\n\n\nlet join: (Array[String], String) -> String = (arr, sep) -> {\n  let len = Array::length(arr)\n  if len == 0 {\n    \"\"\n  } else {\n    let b = ArrayBuilder::new()\n    let mut i = 0\n    while i < len {\n      if i > 0 {\n        ArrayBuilder::push(b, sep)\n      }\n      ArrayBuilder::push(b, Array::get(arr, i))\n      i = i + 1\n    }\n    String::join(ArrayBuilder::freeze(b), \"\")\n  }\n}\n\nlet is_keyword_name: (String) -> Bool = (name) -> {\n  name == \"fn\" || name == \"if\" || name == \"in\" || name == \"is\" || name == \"do\" ||\n  name == \"as\" || name == \"let\" || name == \"rec\" || name == \"mut\" || name == \"for\" ||\n  name == \"else\" || name == \"enum\" || name == \"true\" || name == \"type\" || name == \"test\" ||\n  name == \"with\" || name == \"loop\" || name == \"open\" || name == \"impl\" || name == \"false\" ||\n  name == \"match\" || name == \"trait\" || name == \"throw\" || name == \"while\" || name == \"break\" ||\n  name == \"bench\" || name == \"raise\" || name == \"yield\" || name == \"struct\" || name == \"export\" ||\n  name == \"return\" || name == \"handle\" || name == \"module\" || name == \"derive\" || name == \"import\" ||\n  name == \"declare\" || name == \"continue\" || name == \"suberror\"\n}\n\nlet print_name: (String) -> String = (name) -> {\n  if is_keyword_name(name) {\n    String::concat(\"r#\", name)\n  } else name\n}\n\nlet escape_string: (String) -> String = (s) -> {\n  let len = String::length(s)\n  let b = ArrayBuilder::new()\n  let push_chunk: (Int, Int) -> Unit = (start, end) -> {\n    if end > start {\n      ArrayBuilder::push(b, s[start: end])\n    }\n  }\n  let mut i = 0\n  let mut start = 0\n  while i < len {\n    let c = String::char_code_at(s, i)\n    if c == '\"' {\n      push_chunk(start, i)\n      ArrayBuilder::push(b, \"\\\\\\\"\")\n      i = i + 1\n      start = i\n    } else if c == '\\\\' {\n      push_chunk(start, i)\n      ArrayBuilder::push(b, \"\\\\\\\\\")\n      i = i + 1\n      start = i\n    } else if c == '\\n' {\n      push_chunk(start, i)\n      ArrayBuilder::push(b, \"\\\\n\")\n      i = i + 1\n      start = i\n    } else if c == '\\t' {\n      push_chunk(start, i)\n      ArrayBuilder::push(b, \"\\\\t\")\n      i = i + 1\n      start = i\n    } else if c == 13 {\n      push_chunk(start, i)\n      ArrayBuilder::push(b, \"\\\\r\")\n      i = i + 1\n      start = i\n    } else if c == 0 {\n      push_chunk(start, i)\n      ArrayBuilder::push(b, \"\\\\0\")\n      i = i + 1\n      start = i\n    } else {\n      i = i + 1\n    }\n  }\n  push_chunk(start, len)\n  String::join(ArrayBuilder::freeze(b), \"\")\n}\n\nexport let rec print_pat: (Pat) -> String = (p) -> {\n  match p {\n    PWild => \"_\",\n    PBind(name) => print_name(name),\n    PInt(n) => __to_string(n),\n    PFloat(v) => {\n      let fs = double_to_string_compiler(v)\n      if String::contains(fs, \".\") || fs == \"nan\" {\n        fs\n      } else {\n        String::concat(fs, \".0\")\n      }\n    },\n    PString(s) => String::concat(\"\\\"\", String::concat(escape_string(s), \"\\\"\")),\n    PBool(b) => if b {\n      \"true\"\n    } else \"false\",\n    PCtor(name, args) => if Array::length(args) == 0 {\n      name\n    } else {\n      let parts = for arg in args {\n        print_pat(arg)\n      }\n      String::concat(name, String::concat(\"(\", String::concat(join(parts, \", \"), \")\")))\n    },\n    PTuple(elems) => {\n      let parts = for elem in elems {\n        print_pat(elem)\n      }\n      String::concat(\"(\", String::concat(join(parts, \", \"), \")\"))\n    },\n    POr(left, right) => String::concat(print_pat(left), String::concat(\" | \", print_pat(right))),\n    PStruct(name, _) => String::concat(name, \"::{...}\")\n  }\n}\n\nlet handle_effect_name_from_ctor: (String) -> Option[String] = (name) -> {\n  let idx = String::last_index_of(name, \"::\")\n  if idx < 0 {\n    None\n  } else {\n    Some(name[0: idx])\n  }\n}\n\nlet rec infer_handle_effect_name_from_pat: (Pat) -> Option[String] = (pat) -> {\n  match pat {\n    PCtor(name, _) => handle_effect_name_from_ctor(name),\n    POr(left, right) => match infer_handle_effect_name_from_pat(left) {\n      Some(name) => Some(name),\n      None => infer_handle_effect_name_from_pat(right)\n    },\n    _ => None\n  }\n}\n\nlet infer_handle_effect_name: (Array[(Pat, Expr)]) -> String = (arms) -> {\n  let mut i = 0\n  let mut effect_name = \"Error\"\n  let mut found = false\n  while i < Array::length(arms) && !found {\n    let (pat, _) = Array::get(arms, i)\n    match infer_handle_effect_name_from_pat(pat) {\n      Some(name) => {\n        effect_name = name\n        found = true\n      },\n      None => {\n        i = i + 1\n      }\n    }\n  }\n  effect_name\n}\n\nlet strip_handle_effect_ctor: (String, String) -> String = (effect_name, ctor_name) -> {\n  let prefix = String::concat(effect_name, \"::\")\n  if String::starts_with(ctor_name, prefix) {\n    let prefix_len = String::length(prefix)\n    let ctor_len = String::length(ctor_name)\n    ctor_name[prefix_len: ctor_len]\n  } else {\n    ctor_name\n  }\n}\n\nlet rec print_handle_pat: (String, Pat) -> String = (effect_name, pat) -> {\n  match pat {\n    PCtor(name, args) => {\n      let short_name = strip_handle_effect_ctor(effect_name, name)\n      if Array::length(args) == 0 {\n        short_name\n      } else {\n        let parts = for arg in args {\n          print_pat(arg)\n        }\n        String::concat(short_name, String::concat(\"(\", String::concat(join(parts, \", \"), \")\")))\n      }\n    },\n    POr(left, right) => String::concat(print_handle_pat(effect_name, left), String::concat(\" | \", print_handle_pat(effect_name, right))),\n    _ => print_pat(pat)\n  }\n}\n\nlet map_to_strings: (Array[Expr], (Expr) -> String) -> Array[String] = (exprs, f) -> {\n  for expr in exprs {\n    f(expr)\n  }\n}\n\nexport let rec print_type_expr: (TypeExpr) -> String = (ty) -> {\n  match ty {\n    TyName(name) => name,\n    TyUnit => \"()\",\n    TyApp(name, args) => {\n      let parts = for arg in args {\n        print_type_expr(arg)\n      }\n      String::concat(name, String::concat(\"[\", String::concat(join(parts, \", \"), \"]\")))\n    },\n    TyFn(params, ret, effect_name) => {\n      let parts = for param in params {\n        print_type_expr(param)\n      }\n      let base = String::concat(\"(\", String::concat(join(parts, \", \"), String::concat(\") -> \", print_type_expr(ret))))\n      match effect_name {\n        Some(name) => String::concat(base, String::concat(\" with { \", String::concat(name, \" }\"))),\n        None => base\n      }\n    },\n    TyTuple(elems) => {\n      let parts = for elem in elems {\n        print_type_expr(elem)\n      }\n      String::concat(\"(\", String::concat(join(parts, \", \"), \")\"))\n    }\n  }\n}\n\nlet print_ctor: (String, Array[TypeExpr]) -> String = (name, args) -> {\n  if Array::length(args) == 0 {\n    name\n  }\n  else {\n    let parts = for arg in args {\n      print_type_expr(arg)\n    }\n    String::concat(name, String::concat(\"(\", String::concat(join(parts, \", \"), \")\")))\n  }\n}\n\nlet print_fn_type_params: (Array[String], Array[(String, Array[String])]) -> String = (type_params, bounds) -> {\n  if Array::length(type_params) == 0 {\n    \"\"\n  } else {\n    let parts = for tp in type_params {\n      let mut found = Array::slice([\n        \"\"\n      ], 0, 0)\n      let mut bi = 0\n      while bi < Array::length(bounds) {\n        let (bname, blist) = Array::get(bounds, bi)\n        if bname == tp {\n          found = blist\n        }\n        bi = bi + 1\n      }\n      if Array::length(found) == 0 {\n        tp\n      } else {\n        String::concat(tp, String::concat(\": \", join(found, \" + \")))\n      }\n    }\n    String::concat(\"[\", String::concat(join(parts, \", \"), \"]\"))\n  }\n}\n\nexport let rec print_expr: (Expr) -> String = (e) -> {\n  match e {\n    EInt(n) => __to_string(n),\n    EFloat(n) => {\n      let s = double_to_string_compiler(n)\n      if String::contains(s, \".\") || s == \"nan\" {\n        s\n      } else {\n        String::concat(s, \".0\")\n      }\n    },\n    EString(s) => String::concat(\"\\\"\", String::concat(escape_string(s), \"\\\"\")),\n    EBool(b) => if b {\n      \"true\"\n    } else \"false\",\n    EIdent(name, _) => print_name(name),\n    EUnit => \"()\",\n    ETuple(elems) => String::concat(\"(\", String::concat(join(map_to_strings(elems, print_expr), \", \"), \")\")),\n    EArray(elems) => String::concat(\"[\", String::concat(join(map_to_strings(elems, print_expr), \", \"), \"]\")),\n    ERecord(rn, fields) => {\n      let parts = for field in fields {\n        let (name, val) = field\n        String::concat(name, String::concat(\": \", print_expr(val)))\n      }\n      let prefix = if rn == \"\" {\n        \"record { \"\n      } else String::concat(rn, \"::{ \")\n      String::concat(prefix, String::concat(join(parts, \", \"), \" }\"))\n    },\n    EIf(cond, then_e, else_e) => match else_e {\n      EUnit => String::concat(\"if \", String::concat(print_expr(cond), String::concat(\" { \", String::concat(print_expr(then_e), \" }\")))),\n      _ => String::concat(\"if \", String::concat(print_expr(cond), String::concat(\" { \", String::concat(print_expr(then_e), String::concat(\" } else { \", String::concat(print_expr(else_e), \" }\"))))))\n    },\n    ELet(name, val, body, _) => String::concat(\"{ let \", String::concat(print_name(name), String::concat(\" = \", String::concat(print_expr(val), String::concat(\"; \", String::concat(print_expr(body), \" }\")))))),\n    ELetRec(name, val, body) => String::concat(\"{ let rec \", String::concat(print_name(name), String::concat(\" = \", String::concat(print_expr(val), String::concat(\"; \", String::concat(print_expr(body), \" }\")))))),\n    ELetMut(name, val, body, _) => String::concat(\"{ let mut \", String::concat(print_name(name), String::concat(\" = \", String::concat(print_expr(val), String::concat(\"; \", String::concat(print_expr(body), \" }\")))))),\n    EAssign(name, val, body) => String::concat(\"{ \", String::concat(print_name(name), String::concat(\" = \", String::concat(print_expr(val), String::concat(\"; \", String::concat(print_expr(body), \" }\")))))),\n    EAssignOp(name, op, val, body) => String::concat(\"{ \", String::concat(print_name(name), String::concat(\" \", String::concat(op, String::concat(\"= \", String::concat(print_expr(val), String::concat(\"; \", String::concat(print_expr(body), \" }\")))))))),\n    ESeq(a, b) => String::concat(\"{ \", String::concat(print_expr(a), String::concat(\"; \", String::concat(print_expr(b), \" }\")))),\n    EMatch(scrutinee, arms) => {\n      let parts = for arm in arms {\n        let (pat, expr) = arm\n        String::concat(print_pat(pat), String::concat(\" => \", print_expr(expr)))\n      }\n      String::concat(\"match \", String::concat(print_expr(scrutinee), String::concat(\" { \", String::concat(join(parts, \", \"), \" }\"))))\n    },\n    EHandle(body, arms) => {\n      let effect_name = infer_handle_effect_name(arms)\n      let parts = for arm in arms {\n        let (pat, expr) = arm\n        String::concat(print_handle_pat(effect_name, pat), String::concat(\" => \", print_expr(expr)))\n      }\n      String::concat(\"handle { \", String::concat(print_expr(body), String::concat(\" } with \", String::concat(effect_name, String::concat(\" { \", String::concat(join(parts, \"; \"), \" }\"))))))\n    },\n    EWhile(cond, body) => String::concat(\"while \", String::concat(print_expr(cond), String::concat(\" { \", String::concat(print_expr(body), \" }\")))),\n    ELoop(params, body) => {\n      let parts = for param in params {\n        let (name, init) = param\n        String::concat(print_name(name), String::concat(\" = \", print_expr(init)))\n      }\n      String::concat(\"loop (\", String::concat(join(parts, \", \"), String::concat(\") { \", String::concat(print_expr(body), \" }\"))))\n    },\n    EForIn(value_name, index_name, iterable, body) => {\n      let binding = match index_name {\n        Some(index_name) => String::concat(print_name(index_name), String::concat(\", \", print_name(value_name))),\n        None => print_name(value_name)\n      }\n      String::concat(\"for \", String::concat(binding, String::concat(\" in \", String::concat(print_expr(iterable), String::concat(\" { \", String::concat(print_expr(body), \" }\"))))))\n    },\n    ECall(callee, args, _) => match callee {\n      EIdent(\"perform\", _) => if Array::length(args) == 1 {\n        String::concat(\"perform \", print_expr(Array::get(args, 0)))\n      } else {\n        String::concat(print_expr(callee), String::concat(\"(\", String::concat(join(map_to_strings(args, print_expr), \", \"), \")\")))\n      },\n      EFn(_, _, _, _, _, _) => String::concat(\"(\", String::concat(print_expr(callee), String::concat(\")(\", String::concat(join(map_to_strings(args, print_expr), \", \"), \")\")))),\n      _ => String::concat(print_expr(callee), String::concat(\"(\", String::concat(join(map_to_strings(args, print_expr), \", \"), \")\")))\n    },\n    EBinOp(op, left, right) => String::concat(\"(\", String::concat(print_expr(left), String::concat(\" \", String::concat(op, String::concat(\" \", String::concat(print_expr(right), \")\")))))),\n    EUnaryOp(op, expr) => String::concat(\"(\", String::concat(op, String::concat(print_expr(expr), \")\"))),\n    EFn(type_params, bounds, params, ret_ty, effect, body) => {\n      let tp_str = print_fn_type_params(type_params, bounds)\n      let parts = for param in params {\n        let (name, ty_opt) = param\n        match ty_opt {\n          Some(ty) => String::concat(print_name(name), String::concat(\": \", print_type_expr(ty))),\n          None => print_name(name)\n        }\n      }\n      let ret_str = match ret_ty {\n        Some(rt) => {\n          let eff_str = match effect {\n            Some(e) => String::concat(\" with { \", String::concat(e, \" }\")),\n            None => \"\"\n          }\n          String::concat(\") -> \", String::concat(print_type_expr(rt), String::concat(eff_str, String::concat(\" { \", String::concat(print_expr(body), \" }\")))))\n        },\n        None => String::concat(\") -> { \", String::concat(print_expr(body), \" }\"))\n      }\n      String::concat(tp_str, String::concat(\"(\", String::concat(join(parts, \", \"), ret_str)))\n    },\n    EDot(expr, field, _, _) => String::concat(print_expr(expr), String::concat(\".\", field)),\n    EThrow(e) => String::concat(\"throw(\", String::concat(print_expr(e), \")\")),\n    EReturn(e) => String::concat(\"return \", print_expr(e)),\n    EBreak(opt) => match opt {\n      None => \"break\",\n      Some(v) => String::concat(\"break \", print_expr(v))\n    },\n    EContinue(args) => if Array::length(args) == 0 {\n      \"continue\"\n    } else String::concat(\"continue(\", String::concat(join(map_to_strings(args, print_expr), \", \"), \")\")),\n    ELabeledArg(name, _modifier, val) => String::concat(name, String::concat(\"=\", print_expr(val))),\n    EMap(fields) => if Array::length(fields) == 0 {\n      \"map {}\"\n    } else {\n      let parts = for field in fields {\n        let (k, v) = field\n        String::concat(k, String::concat(\": \", print_expr(v)))\n      }\n      String::concat(\"map { \", String::concat(join(parts, \", \"), \" }\"))\n    },\n    ESpread(inner) => String::concat(\"...\", print_expr(inner)),\n    EStringInterp(parts) => String::concat(\"\\\"\", String::concat(join(parts, \"\"), \"\\\"\"))\n  }\n}\n\nlet print_annotated_let_value: (Option[TypeExpr], Expr) -> String = (ty_opt, val) -> {\n  match ty_opt {\n    Some(TyFn(_, _, _)) => match val {\n      EFn(type_params, bounds, params, _, _, body) => {\n        let tp_str = print_fn_type_params(type_params, bounds)\n        let parts = for param in params {\n          let (name, _) = param\n          print_name(name)\n        }\n        String::concat(\n          tp_str,\n          String::concat(\n            \"(\",\n            String::concat(\n              join(parts, \", \"),\n              String::concat(\") -> { \", String::concat(print_expr(body), \" }\"))\n            )\n          )\n        )\n      },\n      _ => print_expr(val)\n    },\n    _ => print_expr(val)\n  }\n}\n\nlet print_ctor_list: (Array[(String, Array[TypeExpr])]) -> String = (ctors) -> {\n  let parts = for ctor in ctors {\n    let (name, args) = ctor\n    print_ctor(name, args)\n  }\n  join(parts, \"; \")\n}\n\nexport let rec print_stmt: (Stmt) -> String = (s) -> {\n  let prefix: (Bool) -> String = (exported) -> {\n    if exported {\n      \"export \"\n    } else \"\"\n  }\n  match s {\n    SLet(exported, is_rec, name, ty_opt, val) => {\n      let p = prefix(exported)\n      let r = if is_rec {\n        \"let rec \"\n      } else \"let \"\n      let t = match ty_opt {\n        Some(ty) => String::concat(\": \", print_type_expr(ty)),\n        None => \"\"\n      }\n      String::concat(p, String::concat(r, String::concat(print_name(name), String::concat(t, String::concat(\" = \", print_annotated_let_value(ty_opt, val))))))\n    },\n    SLetMut(name, ty_opt, val) => {\n      let t = match ty_opt {\n        Some(ty) => String::concat(\": \", print_type_expr(ty)),\n        None => \"\"\n      }\n      String::concat(\"let mut \", String::concat(print_name(name), String::concat(t, String::concat(\" = \", print_expr(val)))))\n    },\n    SEnum(exported, name, params, ctors, derives) => {\n      let tp = if Array::length(params) == 0 {\n        \"\"\n      } else {\n        String::concat(\"[\", String::concat(join(params, \", \"), \"]\"))\n      }\n      let base = String::concat(prefix(exported), String::concat(\"enum \", String::concat(name, String::concat(tp, String::concat(\" { \", String::concat(print_ctor_list(ctors), \" }\"))))))\n      if Array::length(derives) == 0 {\n        base\n      } else {\n        String::concat(base, String::concat(\" derive(\", String::concat(join(derives, \", \"), \")\")))\n      }\n    },\n    SSuberror(exported, name, ctors) => {\n      let p = prefix(exported)\n      if Array::length(ctors) == 1 {\n        let (ctor_name, ctor_args) = Array::get(ctors, 0)\n        if ctor_name == name {\n          let parts = for arg in ctor_args {\n            print_type_expr(arg)\n          }\n          String::concat(p, String::concat(\"suberror \", String::concat(name, String::concat(\"(\", String::concat(join(parts, \", \"), \")\")))))\n        }\n        else String::concat(p, String::concat(\"suberror \", String::concat(name, String::concat(\" { \", String::concat(print_ctor_list(ctors), \" }\")))))\n      } else String::concat(p, String::concat(\"suberror \", String::concat(name, String::concat(\" { \", String::concat(print_ctor_list(ctors), \" }\")))))\n    },\n    SStruct(exported, name, fields, derives, mut_names) => {\n      let parts = for field in fields {\n        let (fn1, ty) = field\n        let mut is_mut = false\n        let mut mi = 0\n        while mi < Array::length(mut_names) {\n          if Array::get(mut_names, mi) == fn1 {\n            is_mut = true\n          }\n          mi = mi + 1\n        }\n        let mp = if is_mut {\n          \"mut \"\n        } else {\n          \"\"\n        }\n        String::concat(mp, String::concat(fn1, String::concat(\": \", print_type_expr(ty))))\n      }\n      let base = String::concat(prefix(exported), String::concat(\"struct \", String::concat(name, String::concat(\" { \", String::concat(join(parts, \"; \"), \" }\")))))\n      if Array::length(derives) == 0 {\n        base\n      } else {\n        String::concat(base, String::concat(\" derive(\", String::concat(join(derives, \", \"), \")\")))\n      }\n    },\n    STypeAlias(exported, name, params, ty) => {\n      let tp = if Array::length(params) == 0 {\n        \"\"\n      } else {\n        String::concat(\"[\", String::concat(join(params, \", \"), \"]\"))\n      }\n      String::concat(prefix(exported), String::concat(\"type \", String::concat(name, String::concat(tp, String::concat(\" = \", print_type_expr(ty))))))\n    },\n    STrait(exported, name, supers, methods, _) => {\n      let base = String::concat(prefix(exported), String::concat(\"trait \", name))\n      let head = if Array::length(supers) == 0 {\n        base\n      }\n      else String::concat(base, String::concat(\": \", join(supers, \" + \")))\n      if Array::length(methods) == 0 {\n        head\n      } else {\n        let method_parts = for m in methods {\n          let (method_name, params, ret) = m\n          let params_str = if Array::length(params) > 0 {\n            String::concat(\"(\", String::concat(join(for pt in params {\n              print_type_expr(pt)\n            }, \", \"), \")\"))\n          } else \"\"\n          String::concat(\"  \", String::concat(method_name, String::concat(params_str, String::concat(\" -> \", print_type_expr(ret)))))\n        }\n        String::concat(head, String::concat(\" {\\n\", String::concat(join(method_parts, \";\\n\"), \"\\n}\")))\n      }\n    },\n    SImpl(tparams, _, trait_name, type_name) => {\n      let head = if Array::length(tparams) == 0 {\n        \"impl \"\n      } else {\n        String::concat(\"impl [\", String::concat(join(tparams, \", \"), \"] \"))\n      }\n      String::concat(head, String::concat(trait_name, String::concat(\" for \", type_name)))\n    },\n    SExternLet(name, ty) => String::concat(\"extern let \", String::concat(name, String::concat(\": \", print_type_expr(ty)))),\n    SImport(path, items) => {\n      let parts = for item in items {\n        let (name, alias) = item\n        match alias {\n          Some(a) => String::concat(name, String::concat(\" as \", a)),\n          None => name\n        }\n      }\n      String::concat(\"import \", String::concat(path, String::concat(\" { \", String::concat(join(parts, \", \"), \" }\"))))\n    },\n    STest(name, body) => String::concat(\"test \\\"\", String::concat(name, String::concat(\"\\\" { \", String::concat(print_expr(body), \" }\")))),\n    SBench(name, body) => String::concat(\"bench \\\"\", String::concat(name, String::concat(\"\\\" { \", String::concat(print_expr(body), \" }\")))),\n    SExpr(e) => print_expr(e),\n    SExport(names) => String::concat(\"export { \", String::concat(join(names, \", \"), \" }\")),\n    SReExport(path, items) => {\n      let parts = for item in items {\n        let (name, alias) = item\n        match alias {\n          Some(a) => String::concat(name, String::concat(\" as \", a)),\n          None => name\n        }\n      }\n      String::concat(\"export \", String::concat(path, String::concat(\" { \", String::concat(join(parts, \", \"), \" }\"))))\n    },\n    SAliasDecl(alias_name, source_path) => String::concat(\"import \", String::concat(source_path, String::concat(\" @\", alias_name))),\n    SLetPat(pat, expr) => String::concat(\"let \", String::concat(print_pat(pat), String::concat(\" = \", print_expr(expr)))),\n    SModule(exported, name, stmts) => {\n      let parts = for s in stmts {\n        print_stmt(s)\n      }\n      let p = if exported {\n        \"export \"\n      } else \"\"\n      String::concat(p, String::concat(\"module \", String::concat(name, String::concat(\" { \", String::concat(join(parts, \"\\n\"), \" }\")))))\n    },\n    SEffectDef(exported, name, type_params, ops) => {\n      let p = if exported {\n        \"export \"\n      } else \"\"\n      let tp = if Array::length(type_params) > 0 {\n        String::concat(\"[\", String::concat(join(type_params, \", \"), \"]\"))\n      } else \"\"\n      let op_parts = for op in ops {\n        let (op_name, params, ret) = op\n        let params_str = if Array::length(params) > 0 {\n          String::concat(\"(\", String::concat(join(for pt in params {\n            print_type_expr(pt)\n          }, \", \"), \")\"))\n        } else \"\"\n        String::concat(\"  \", String::concat(op_name, String::concat(params_str, String::concat(\" -> \", print_type_expr(ret)))))\n      }\n      String::concat(p, String::concat(\"effect \", String::concat(name, String::concat(tp, String::concat(\" {\\n\", String::concat(join(op_parts, \";\\n\"), \"\\n}\"))))))\n    }\n  }\n}\n\nlet needs_program_separator: (String) -> Bool = (stmt_text) -> {\n  if String::length(stmt_text) == 0 {\n    false\n  } else {\n    let c = String::char_code_at(stmt_text, 0)\n    c == '(' || c == '['\n  }\n}\n\nexport let print_program: (Array[Stmt]) -> String = (stmts) -> {\n  let len = Array::length(stmts)\n  let b = ArrayBuilder::new()\n  let mut i = 0\n  while i < len {\n    let stmt_text = print_stmt(Array::get(stmts, i))\n    if i > 0 {\n      let sep = if needs_program_separator(stmt_text) {\n        \";\\n\"\n      } else \"\\n\"\n      ArrayBuilder::push(b, sep)\n    }\n    ArrayBuilder::push(b, stmt_text)\n    i = i + 1\n  }\n  String::join(ArrayBuilder::freeze(b), \"\")\n}\n")
}

let selfhost_source_15 = () -> (String, String) {
  ("lib/@vibe/compiler/core/polyfill.vibe",
"\nexport let __to_string: (Int) -> String = (n) -> {\n  if n == 0 {\n    \"0\"\n  } else {\n    let mut val = n\n    let mut neg = false\n    if val < 0 {\n      neg = true\n      val = 0 - val\n    }\n    let digits = Array::slice([\n      \"\"\n    ], 0, 0)\n    while val > 0 {\n      let d = val - (val / 10) * 10\n      let ch = if d == 0 {\n        \"0\"\n      }\n      else if d == 1 {\n        \"1\"\n      }\n      else if d == 2 {\n        \"2\"\n      }\n      else if d == 3 {\n        \"3\"\n      }\n      else if d == 4 {\n        \"4\"\n      }\n      else if d == 5 {\n        \"5\"\n      }\n      else if d == 6 {\n        \"6\"\n      }\n      else if d == 7 {\n        \"7\"\n      }\n      else if d == 8 {\n        \"8\"\n      }\n      else {\n        \"9\"\n      }\n      Array::push(digits, ch)\n      val = val / 10\n    }\n    let mut result = if neg {\n      \"-\"\n    } else {\n      \"\"\n    }\n    let mut i = Array::length(digits) - 1\n    while i >= 0 {\n      result = String::concat(result, Array::get(digits, i))\n      i = i - 1\n    }\n    result\n  }\n}\n")
}

let selfhost_source_16 = () -> (String, String) {
  ("lib/@vibe/compiler/core/bytebuf.vibe",
"\nexport let bytebuf_new: () -> Bytes = () -> {\n  Bytes::new()\n}\n\nexport let bytebuf_push: (Bytes, Int) -> Unit = (buf, byte) -> {\n  Bytes::push(buf, byte)\n}\n\nexport let bytebuf_push2: (Bytes, Int, Int) -> Unit = (buf, b1, b2) -> {\n  bytebuf_push(buf, b1)\n  bytebuf_push(buf, b2)\n}\n\nexport let bytebuf_push3: (Bytes, Int, Int, Int) -> Unit = (buf, b1, b2, b3) -> {\n  bytebuf_push(buf, b1)\n  bytebuf_push(buf, b2)\n  bytebuf_push(buf, b3)\n}\n\nexport let bytebuf_push9: (Bytes, Int, Int, Int, Int, Int, Int, Int, Int, Int) -> Unit = (buf, b1, b2, b3, b4, b5, b6, b7, b8, b9) -> {\n  bytebuf_push(buf, b1)\n  bytebuf_push(buf, b2)\n  bytebuf_push(buf, b3)\n  bytebuf_push(buf, b4)\n  bytebuf_push(buf, b5)\n  bytebuf_push(buf, b6)\n  bytebuf_push(buf, b7)\n  bytebuf_push(buf, b8)\n  bytebuf_push(buf, b9)\n}\n\nexport let bytebuf_length: (Bytes) -> Int = (buf) -> {\n  Bytes::length(buf)\n}\n\nexport let bytebuf_push_buf: (Bytes, Bytes) -> Unit = (dst, src) -> {\n  Bytes::append(dst, src)\n}\n\nexport let bytebuf_to_bytes: (Bytes) -> Bytes = (buf) -> {\n  buf\n}\n\nexport let leb128_encode_s32: (Bytes, Int) -> Unit = (buf, value) -> {\n  if value >= (0 - 64) && value < 64 {\n    Bytes::push(buf, value&127)\n  } else {\n    if value >= (0 - 8192) && value < 8192 {\n      Bytes::push(buf, (value&127)|128)\n      Bytes::push(buf, (value>>7)&127)\n    } else {\n      let mut v = value\n      let mut more = true\n      while more {\n        let byte = v&127\n        v = v>>7\n        if (v == 0) && (byte&64) == 0 {\n          Bytes::push(buf, byte)\n          more = false\n        } else {\n          if (v == 0 - 1) && (byte&64) != 0 {\n            Bytes::push(buf, byte)\n            more = false\n          } else {\n            Bytes::push(buf, byte|128)\n          }\n        }\n      }\n    }\n  }\n}\n\nexport let leb128_encode_s64: (Bytes, Int) -> Unit = (buf, value) -> {\n  leb128_encode_s32(buf, value)\n}\n\nexport let leb128_encode_u32: (Bytes, Int) -> Unit = (buf, value) -> {\n  if value >= 0 && value < 128 {\n    Bytes::push(buf, value)\n  } else {\n    if value >= 128 && value < 16384 {\n      Bytes::push(buf, (value&127)|128)\n      Bytes::push(buf, (value>>7)&127)\n    } else {\n      let mut v = value\n      let mut more = true\n      while more {\n        let byte = v&127\n        v = (v>>7)&((1<<25) - 1)\n        if v == 0 {\n          Bytes::push(buf, byte)\n          more = false\n        } else {\n          Bytes::push(buf, byte|128)\n        }\n      }\n    }\n  }\n}\n\nexport let bytebuf_push_string: (Bytes, String) -> Unit = (buf, s) -> {\n  let slen = String::length(s)\n  leb128_encode_u32(buf, slen)\n  let mut i = 0\n  while i < slen {\n    bytebuf_push(buf, String::char_code_at(s, i))\n    i = i + 1\n  }\n}\n\nexport let bytebuf_push_section: (Bytes, Int, Bytes) -> Unit = (out, section_id, content) -> {\n  bytebuf_push(out, section_id)\n  leb128_encode_u32(out, bytebuf_length(content))\n  bytebuf_push_buf(out, content)\n}\n\nexport let bytebuf_push_opcode_s64: (Bytes, Int, Int) -> Unit = (buf, opcode, value) -> {\n  bytebuf_push(buf, opcode)\n  leb128_encode_s32(buf, value)\n}\n\nexport let bytebuf_push_opcode_u32: (Bytes, Int, Int) -> Unit = (buf, opcode, value) -> {\n  if value >= 0 && value < 128 {\n    Bytes::push(buf, opcode)\n    Bytes::push(buf, value)\n  } else {\n    if value >= 128 && value < 16384 {\n      Bytes::push(buf, opcode)\n      Bytes::push(buf, (value&127)|128)\n      Bytes::push(buf, (value>>7)&127)\n    } else {\n      Bytes::push(buf, opcode)\n      leb128_encode_u32(buf, value)\n    }\n  }\n}\n\nexport let bytebuf_push_vec_header: (Bytes, Int) -> Unit = (buf, count) -> {\n  leb128_encode_u32(buf, count)\n}\n\nexport let bytebuf_push_opcode_u32_u32: (Bytes, Int, Int, Int) -> Unit = (buf, opcode, a, b) -> {\n  bytebuf_push(buf, opcode)\n  leb128_encode_u32(buf, a)\n  leb128_encode_u32(buf, b)\n}\n")
}

let selfhost_source_17 = () -> (String, String) {
  ("lib/@vibe/compiler/core/ast.vibe",
"\n\n\nexport {\n  Pat, Expr, Stmt, TypeExpr\n}\n")
}

let selfhost_source_18 = () -> (String, String) {
  ("lib/@vibe/compiler/core/types.vibe",
"\n\n\nexport enum Type {\n  CtInt;\n  CtDouble;\n  CtBool;\n  CtString;\n  CtChar;\n  CtUnit;\n  CtTuple(Array[Type]);\n  CtArray(Type);\n  CtOption(Type);\n  CtFn(Array[Type], Type, Option[String]);\n  CtEnum(String);\n  CtStruct(String);\n  CtBytes;\n  CtNamed(String, Array[Type]);\n  CtVar(Int);\n  CtForAll(Array[Int], Array[(Int, Array[String])], Type);\n  CtUnknown\n}\n\nexport enum TypeDef {\n  TDEnum(String, Array[String], Array[(String, Array[Type])]);\n  TDStruct(String, Array[(String, Type)], Array[String]);\n  TDAlias(String, Array[String], Type);\n  TDEffect(String, Array[(String, Array[Type], Type)])\n}\n\nexport enum TypeEnv {\n  EnvEmpty;\n  EnvBind(String, Type, TypeEnv);\n  EnvTraitDef(String, Array[String], Bool, Array[(String, Array[TypeExpr], TypeExpr)], TypeEnv);\n  EnvTraitImpl(String, Type, TypeEnv);\n  EnvTraitImplGen(String, Array[String], Array[(String, Array[String])], Type, TypeEnv);\n  EnvFlat(Array[(String, Type)]);\n  EnvCached(Map[String, Type], TypeEnv)\n}\n\nexport enum Subst {\n  SubstEmpty;\n  SubstBind(Int, Type, Subst);\n  SubstBound(Int, Array[String], Subst);\n  SubstCached(Map[String, Type], Map[String, Array[String]], Subst);\n  SubstEffBind(String, String, Subst)\n}\n\n\nexport let env_bind: (TypeEnv, String, Type) -> TypeEnv = (env, name, ty) -> {\n  match env {\n    EnvCached(cache, rest) => EnvCached(cache, EnvBind(name, ty, rest)),\n    _ => EnvBind(name, ty, env)\n  }\n}\n\nexport let env_cache: (TypeEnv) -> TypeEnv = (env) -> {\n  let is_empty = match env {\n    EnvEmpty => true,\n    _ => false\n  }\n  if is_empty {\n    EnvEmpty\n  } else {\n    let names = ArrayBuilder::new()\n    let types = ArrayBuilder::new()\n    let mut cur = env\n    let mut done = false\n    while !done {\n      match cur {\n        EnvEmpty => {\n          done = true\n        },\n        EnvBind(n, ty, rest) => {\n          ArrayBuilder::push(names, n)\n          ArrayBuilder::push(types, ty)\n          cur = rest\n        },\n        EnvTraitDef(_, _, _, _, rest) => {\n          cur = rest\n        },\n        EnvTraitImpl(_, _, rest) => {\n          cur = rest\n        },\n        EnvTraitImplGen(_, _, _, _, rest) => {\n          cur = rest\n        },\n        EnvFlat(bindings) => {\n          let mut j = 0\n          while j < Array::length(bindings) {\n            let (n, ty) = Array::get(bindings, j)\n            ArrayBuilder::push(names, n)\n            ArrayBuilder::push(types, ty)\n            j = j + 1\n          }\n          done = true\n        },\n        EnvCached(_, rest) => {\n          cur = rest\n        }\n      }\n    }\n    let na = ArrayBuilder::freeze(names)\n    let ta = ArrayBuilder::freeze(types)\n    let cache = MapBuilder::new()\n    let len = Array::length(na)\n    let mut i = 0\n    while i < len {\n      let idx = len - i - 1\n      MapBuilder::set(cache, Array::get(na, idx), Array::get(ta, idx))\n      i = i + 1\n    }\n    EnvCached(MapBuilder::freeze(cache), env)\n  }\n}\n\nexport let fresh_var: (Int) -> (Type, Int) = (c) -> {\n  (CtVar(c), c + 1)\n}\n\nexport let rec occurs_in: (Int, Type) -> Bool = (id, ty) -> {\n  match ty {\n    CtVar(vid) => (id == vid),\n    CtFn(params, ret, _) => {\n      let mut i = 0\n      let mut found = false\n      while i < Array::length(params) {\n        if occurs_in(id, Array::get(params, i)) {\n          found = true\n          i = Array::length(params)\n        } else {\n          i = i + 1\n        }\n      }\n      found || occurs_in(id, ret)\n    },\n    CtArray(elem) => occurs_in(id, elem),\n    CtOption(elem) => occurs_in(id, elem),\n    CtTuple(elems) => {\n      let mut i = 0\n      let mut found = false\n      while i < Array::length(elems) {\n        if occurs_in(id, Array::get(elems, i)) {\n          found = true\n          i = Array::length(elems)\n        } else {\n          i = i + 1\n        }\n      }\n      found\n    },\n    CtForAll(_, _, body) => occurs_in(id, body),\n    _ => false\n  }\n}\n\nexport let env_lookup: (TypeEnv, String) -> Option[Type] = (env, name) -> {\n  let mut cur = env\n  let mut result = None\n  let mut done = false\n  while !done {\n    match cur {\n      EnvEmpty => {\n        done = true\n      },\n      EnvBind(n, ty, rest) => if n == name {\n        result = Some(ty)\n        done = true\n      } else {\n        cur = rest\n      },\n      EnvTraitDef(_, _, _, _, rest) => {\n        cur = rest\n      },\n      EnvTraitImpl(_, _, rest) => {\n        cur = rest\n      },\n      EnvTraitImplGen(_, _, _, _, rest) => {\n        cur = rest\n      },\n      EnvFlat(bindings) => {\n        let mut j = 0\n        while j < Array::length(bindings) && !done {\n          let (n, ty) = Array::get(bindings, j)\n          if n == name {\n            result = Some(ty)\n            done = true\n          } else {\n            j = j + 1\n          }\n        }\n        if !done {\n          done = true\n        }\n      },\n      EnvCached(cache, rest) => if Map::has_key(cache, name) {\n        result = Some(Map::get(cache, name))\n        done = true\n      } else {\n        cur = rest\n      }\n    }\n  }\n  result\n}\n\nexport let env_bind_all: (TypeEnv, Array[(String, Type)]) -> TypeEnv = (env, bindings) -> {\n  let len = Array::length(bindings)\n  let mut i = 0\n  let mut acc = env\n  while i < len {\n    let (name, ty) = Array::get(bindings, i)\n    acc = env_bind(acc, name, ty)\n    i = i + 1\n  }\n  acc\n}\n\nexport let find_typedef: (Array[TypeDef], String) -> Option[TypeDef] = (defs, name) -> {\n  let len = Array::length(defs)\n  let mut i = 0\n  let mut result = None\n  let mut done = false\n  while !done {\n    if i >= len {\n      done = true\n    } else {\n      let d = Array::get(defs, i)\n      let dname = match d {\n        TDEnum(n, _, _) => n,\n        TDStruct(n, _, _) => n,\n        TDAlias(n, _, _) => n,\n        TDEffect(n, _) => n\n      }\n      if dname == name {\n        result = Some(d)\n        done = true\n      } else {\n        i = i + 1\n      }\n    }\n  }\n  result\n}\n\nexport let subst_lookup: (Subst, Int) -> Option[Type] = (s, id) -> {\n  let mut cur = s\n  let mut out = None\n  let mut done = false\n  let key = __to_string(id)\n  while !done {\n    match cur {\n      SubstEmpty => {\n        done = true\n      },\n      SubstBind(i, ty, rest) => if i == id {\n        out = Some(ty)\n        done = true\n      } else {\n        cur = rest\n      }\n      ,\n      SubstBound(_, _, rest) => {\n        cur = rest\n      },\n      SubstCached(cache, _, rest) => if Map::has_key(cache, key) {\n        out = Some(Map::get(cache, key))\n        done = true\n      } else {\n        cur = rest\n      }\n      ,\n      SubstEffBind(_, _, rest) => {\n        cur = rest\n      }\n    }\n  }\n  out\n}\n\nexport let rec trait_supers: (TypeEnv, String) -> Array[String] = (env, name) -> {\n  let empty = Array::slice([\n    \"\"\n  ], 0, 0)\n  match env {\n    EnvEmpty => empty,\n    EnvBind(_, _, rest) => trait_supers(rest, name),\n    EnvTraitDef(tname, supers, _, _, rest) => if tname == name {\n      supers\n    } else trait_supers(rest, name),\n    EnvTraitImpl(_, _, rest) => trait_supers(rest, name),\n    EnvTraitImplGen(_, _, _, _, rest) => trait_supers(rest, name),\n    EnvFlat(_) => empty,\n    EnvCached(_, rest) => trait_supers(rest, name)\n  }\n}\n\nexport let rec trait_method_sig: (TypeEnv, String, String) -> Option[(Array[TypeExpr], TypeExpr)] = (env, trait_name, method_name) -> {\n  match env {\n    EnvEmpty => None,\n    EnvBind(_, _, rest) => trait_method_sig(rest, trait_name, method_name),\n    EnvTraitDef(tname, _, _, methods, rest) => if tname == trait_name {\n      let mlen = Array::length(methods)\n      let mut i = 0\n      let mut found = None\n      while i < mlen {\n        let (mname, params, ret) = Array::get(methods, i)\n        if mname == method_name {\n          found = Some((params, ret))\n          i = mlen\n        } else {\n          i = i + 1\n        }\n      }\n      match found {\n        Some(sig) => Some(sig),\n        None => trait_method_sig(rest, trait_name, method_name)\n      }\n    } else trait_method_sig(rest, trait_name, method_name),\n    EnvTraitImpl(_, _, rest) => trait_method_sig(rest, trait_name, method_name),\n    EnvTraitImplGen(_, _, _, _, rest) => trait_method_sig(rest, trait_name, method_name),\n    EnvFlat(_) => None,\n    EnvCached(_, rest) => trait_method_sig(rest, trait_name, method_name)\n  }\n}\n\nlet trait_target_head_name: (Type) -> String = (ty) -> {\n  match ty {\n    CtNamed(n, _) => n,\n    CtStruct(n) => n,\n    CtEnum(n) => n,\n    _ => \"\"\n  }\n}\n\nlet rec type_name_iterator_impl_scan: (TypeEnv, TypeEnv, String) -> Bool = (scan, full, type_name) -> {\n  match scan {\n    EnvEmpty => false,\n    EnvBind(_, _, rest) => type_name_iterator_impl_scan(rest, full, type_name),\n    EnvTraitDef(_, _, _, _, rest) => type_name_iterator_impl_scan(rest, full, type_name),\n    EnvTraitImpl(tname, target, rest) => {\n      let hit = trait_target_head_name(target) == type_name && (match trait_method_sig(full, tname, \"next\") {\n        Some(_) => true,\n        None => false\n      })\n      if hit {\n        true\n      } else type_name_iterator_impl_scan(rest, full, type_name)\n    },\n    EnvTraitImplGen(_, _, _, _, rest) => type_name_iterator_impl_scan(rest, full, type_name),\n    EnvFlat(_) => false,\n    EnvCached(_, rest) => type_name_iterator_impl_scan(rest, full, type_name)\n  }\n}\n\nexport let type_name_has_iterator_impl: (TypeEnv, String) -> Bool = (env, type_name) -> {\n  type_name_iterator_impl_scan(env, env, type_name)\n}\n\nexport let rec trait_method_sig_deep: (TypeEnv, String, String) -> Option[(Array[TypeExpr], TypeExpr)] = (env, trait_name, method_name) -> {\n  match trait_method_sig(env, trait_name, method_name) {\n    Some(sig) => Some(sig),\n    None => {\n      let supers = trait_supers(env, trait_name)\n      let mut i = 0\n      let mut result = None\n      while i < Array::length(supers) {\n        let pending = match result {\n          None => true,\n          _ => false\n        }\n        if pending {\n          match trait_method_sig_deep(env, Array::get(supers, i), method_name) {\n            Some(sig) => {\n              result = Some(sig)\n            },\n            None => ()\n          }\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      result\n    }\n  }\n}\n\nexport let subst_bounds_for: (Subst, Int) -> Array[String] = (s, id) -> {\n  let out = ArrayBuilder::new()\n  let mut cur = s\n  let mut done = false\n  while !done {\n    match cur {\n      SubstEmpty => {\n        done = true\n      },\n      SubstBind(_, _, rest) => {\n        cur = rest\n      },\n      SubstBound(bid, bounds, rest) => {\n        if bid == id {\n          let mut i = 0\n          while i < Array::length(bounds) {\n            ArrayBuilder::push(out, Array::get(bounds, i))\n            i = i + 1\n          }\n        } else {\n          ()\n        }\n        cur = rest\n      },\n      SubstCached(_, bounds_cache, rest) => {\n        let key = __to_string(id)\n        if Map::has_key(bounds_cache, key) {\n          let bounds = Map::get(bounds_cache, key)\n          let mut i = 0\n          while i < Array::length(bounds) {\n            ArrayBuilder::push(out, Array::get(bounds, i))\n            i = i + 1\n          }\n        } else {\n          ()\n        }\n        cur = rest\n      },\n      SubstEffBind(_, _, rest) => {\n        cur = rest\n      }\n    }\n  }\n  ArrayBuilder::freeze(out)\n}\n\nlet rec array_has_int: (Array[Int], Int, Int) -> Bool = (arr, val, i) -> {\n  if i >= Array::length(arr) {\n    false\n  }\n  else if Array::get(arr, i) == val {\n    true\n  }\n  else array_has_int(arr, val, i + 1)\n}\n\nlet int_array_has: (Array[Int], Int) -> Bool = (arr, v) -> {\n  let slen = Array::length(arr)\n  let mut si = 0\n  let mut sfound = false\n  let mut sdone = false\n  while !sdone {\n    if si >= slen {\n      sdone = true\n    } else if Array::get(arr, si) == v {\n      sfound = true\n      sdone = true\n    } else {\n      si = si + 1\n    }\n  }\n  sfound\n}\n\nlet is_effect_var_name: (String) -> Bool = (name) -> {\n  let len = String::length(name)\n  if len == 1 {\n    String::char_code_at(name, 0) >= 97 && String::char_code_at(name, 0) <= 122\n  } else if len >= 2 {\n    String::char_code_at(name, 0) == 36\n  } else {\n    false\n  }\n}\n\nlet rec subst_eff_lookup: (Subst, String) -> Option[String] = (s, name) -> {\n  let mut cur = s\n  let mut out = None\n  let mut done = false\n  while !done {\n    match cur {\n      SubstEmpty => {\n        done = true\n      },\n      SubstBind(_, _, rest) => {\n        cur = rest\n      },\n      SubstBound(_, _, rest) => {\n        cur = rest\n      },\n      SubstCached(_, _, rest) => {\n        cur = rest\n      },\n      SubstEffBind(v, val, rest) => if v == name {\n        out = Some(val)\n        done = true\n      } else {\n        cur = rest\n      }\n    }\n  }\n  match out {\n    Some(val) => if is_effect_var_name(val) {\n      match subst_eff_lookup(s, val) {\n        Some(v2) => Some(v2),\n        None => Some(val)\n      }\n    } else {\n      Some(val)\n    },\n    None => None\n  }\n}\n\nlet resolve_effect_opt: (Subst, Option[String]) -> Option[String] = (s, eff) -> {\n  match eff {\n    None => None,\n    Some(name) => if is_effect_var_name(name) {\n      match subst_eff_lookup(s, name) {\n        Some(val) => if String::length(val) == 0 {\n          None\n        } else {\n          Some(val)\n        },\n        None => eff\n      }\n    } else {\n      eff\n    }\n  }\n}\n\nexport let rec subst_apply: (Subst, Type) -> Type = (s, ty) -> {\n  match ty {\n    CtInt => ty,\n    CtBool => ty,\n    CtString => ty,\n    CtUnit => ty,\n    CtDouble => ty,\n    CtChar => ty,\n    CtBytes => ty,\n    CtUnknown => ty,\n    CtVar(_) => {\n      let mut cur = ty\n      let mut out = ty\n      let mut done = false\n      let mut seen = Array::slice([\n        0\n      ], 0, 0)\n      while !done {\n        match cur {\n          CtVar(vid) => if int_array_has(seen, vid) {\n            out = cur\n            done = true\n          } else {\n            Array::push(seen, vid)\n            match subst_lookup(s, vid) {\n              Some(next) => {\n                cur = next\n                out = next\n              },\n              None => {\n                out = cur\n                done = true\n              }\n            }\n          },\n          _ => {\n            out = subst_apply(s, cur)\n            done = true\n          }\n        }\n      }\n      out\n    },\n    CtFn(params, ret, effect_name) => {\n      let apply_params: (Array[Type]) -> Array[Type] = (items) -> {\n        let out = Array::slice([\n          CtUnknown\n        ], 0, 0)\n        let mut i = 0\n        while i < Array::length(items) {\n          Array::push(out, subst_apply(s, Array::get(items, i)))\n          i = i + 1\n        }\n        out\n      }\n      CtFn(apply_params(params), subst_apply(s, ret), resolve_effect_opt(s, effect_name))\n    },\n    CtArray(elem) => CtArray(subst_apply(s, elem)),\n    CtOption(elem) => CtOption(subst_apply(s, elem)),\n    CtTuple(elems) => CtTuple(for e in elems {\n      subst_apply(s, e)\n    }),\n    CtNamed(name, args) => CtNamed(name, for arg in args {\n      subst_apply(s, arg)\n    }),\n    CtForAll(_, _, _) => ty,\n    _ => ty\n  }\n}\n\nexport let rec trait_defined: (TypeEnv, String) -> Bool = (env, name) -> {\n  match env {\n    EnvEmpty => false,\n    EnvBind(_, _, rest) => trait_defined(rest, name),\n    EnvTraitDef(tname, _, _, _, rest) => if tname == name {\n      true\n    } else trait_defined(rest, name),\n    EnvTraitImpl(_, _, rest) => trait_defined(rest, name),\n    EnvTraitImplGen(_, _, _, _, rest) => trait_defined(rest, name),\n    EnvFlat(_) => false,\n    EnvCached(_, rest) => trait_defined(rest, name)\n  }\n}\n\nexport let rec type_to_string: (Type) -> String = (ty) -> {\n  match ty {\n    CtInt => \"Int\",\n    CtDouble => \"Double\",\n    CtBool => \"Bool\",\n    CtString => \"String\",\n    CtChar => \"Char\",\n    CtUnit => \"()\",\n    CtBytes => \"Bytes\",\n    CtVar(id) => \"?t\\{id}\",\n    CtForAll(vars, _, body) => {\n      let vlen = Array::length(vars)\n      let mut vi = 0\n      let mut vacc = \"\"\n      while vi < vlen {\n        let v = String::concat(\"?t\", __to_string(Array::get(vars, vi)))\n        let next = if vi > 0 {\n          String::concat(vacc, String::concat(\" \", v))\n        } else v\n        vacc = next\n        vi = vi + 1\n      }\n      String::concat(\"forall \", String::concat(vacc, String::concat(\". \", type_to_string(body))))\n    },\n    CtUnknown => \"?\",\n    CtArray(elem) => String::concat(\"Array[\", String::concat(type_to_string(elem), \"]\")),\n    CtOption(elem) => String::concat(\"Option[\", String::concat(type_to_string(elem), \"]\")),\n    CtEnum(name) => name,\n    CtStruct(name) => name,\n    CtNamed(name, args) => if Array::length(args) == 0 {\n      name\n    } else {\n      let parts = for arg in args {\n        type_to_string(arg)\n      }\n      let mut i = 0\n      let mut joined = \"\"\n      while i < Array::length(parts) {\n        joined = if i > 0 {\n          String::concat(joined, String::concat(\", \", Array::get(parts, i)))\n        } else Array::get(parts, i)\n        i = i + 1\n      }\n      String::concat(name, String::concat(\"[\", String::concat(joined, \"]\")))\n    },\n    CtTuple(elems) => {\n      let parts = for e in elems {\n        type_to_string(e)\n      }\n      let mut i = 0\n      let mut joined = \"\"\n      while i < Array::length(parts) {\n        joined = if i > 0 {\n          String::concat(joined, String::concat(\", \", Array::get(parts, i)))\n        } else Array::get(parts, i)\n        i = i + 1\n      }\n      String::concat(\"(\", String::concat(joined, \")\"))\n    },\n    CtFn(params, ret, effect_name) => {\n      let parts = for p in params {\n        type_to_string(p)\n      }\n      let mut i = 0\n      let mut joined = \"\"\n      while i < Array::length(parts) {\n        joined = if i > 0 {\n          String::concat(joined, String::concat(\", \", Array::get(parts, i)))\n        } else Array::get(parts, i)\n        i = i + 1\n      }\n      let ret_text = type_to_string(ret)\n      let base = String::concat(\"(\", String::concat(joined, String::concat(\") -> \", ret_text)))\n      match effect_name {\n        Some(name) => String::concat(base, String::concat(\" with {\", String::concat(name, \"}\"))),\n        None => base\n      }\n    }\n  }\n}\n\nlet empty_type_args: () -> Array[Type] = () -> {\n  Array::slice([\n    CtUnknown\n  ], 0, 0)\n}\n\nexport let env_lookup_flat: (Array[(String, Type)], String) -> Option[Type] = (bindings, name) -> {\n  let len = Array::length(bindings)\n  let mut i = 0\n  let mut result = None\n  let mut done = false\n  while !done {\n    if i >= len {\n      done = true\n    } else {\n      let (n, ty) = Array::get(bindings, i)\n      if n == name {\n        result = Some(ty)\n        done = true\n      } else {\n        i = i + 1\n      }\n    }\n  }\n  result\n}\n\nexport let resolve_builtin: (String) -> Option[Type] = (name) -> {\n  if name == \"Int\" || name == \"i32\" {\n    Some(CtInt)\n  }\n  else if name == \"Double\" || name == \"f64\" || name == \"Float\" || name == \"f32\" {\n    Some(CtDouble)\n  }\n  else if name == \"Bool\" {\n    Some(CtBool)\n  }\n  else if name == \"String\" {\n    Some(CtString)\n  }\n  else if name == \"Char\" {\n    Some(CtChar)\n  }\n  else if name == \"Unit\" {\n    Some(CtUnit)\n  }\n  else if name == \"Bytes\" {\n    Some(CtBytes)\n  }\n  else if name == \"V128\" {\n    Some(CtNamed(\"V128\", empty_type_args()))\n  }\n  else if name == \"i64\"\n  || name == \"u8\"\n  || name == \"u16\"\n  || name == \"u32\"\n  || name == \"u64\"\n  || name == \"i16\"\n  || name == \"v128\" {\n    Some(CtNamed(name, empty_type_args()))\n  }\n  else None\n}\n\nexport let subst_add_bound: (Subst, Int, Array[String]) -> Subst = (s, id, bounds) -> {\n  SubstBound(id, bounds, s)\n}\n\nlet empty_var_bounds: () -> Array[(Int, Array[String])] = () -> {\n  Array::slice([\n    (0, Array::slice([\n      \"\"\n    ], 0, 0))\n  ], 0, 0)\n}\n\nlet rec int_bounds_has_id: (Array[(Int, Array[String])], Int, Int) -> Bool = (pairs, id, i) -> {\n  if i >= Array::length(pairs) {\n    false\n  } else {\n    let (pid, _) = Array::get(pairs, i)\n    if pid == id {\n      true\n    } else {\n      int_bounds_has_id(pairs, id, i + 1)\n    }\n  }\n}\n\nlet rec int_bounds_lookup: (Array[(Int, Array[String])], Int, Int) -> Array[String] = (pairs, id, i) -> {\n  if i >= Array::length(pairs) {\n    Array::slice([\n      \"\"\n    ], 0, 0)\n  } else {\n    let (pid, bounds) = Array::get(pairs, i)\n    if pid == id {\n      bounds\n    } else {\n      int_bounds_lookup(pairs, id, i + 1)\n    }\n  }\n}\n\nlet rec int_int_lookup_or: (Array[(Int, Int)], Int, Int, Int) -> Int = (pairs, key, fallback, i) -> {\n  if i >= Array::length(pairs) {\n    fallback\n  } else {\n    let (k, v) = Array::get(pairs, i)\n    if k == key {\n      v\n    } else {\n      int_int_lookup_or(pairs, key, fallback, i + 1)\n    }\n  }\n}\n\nlet rec collect_effect_vars_walk: (Type, Array[String]) -> Int = (t, out) -> {\n  match t {\n    CtFn(params, ret, eff) => {\n      match eff {\n        Some(name) => if is_effect_var_name(name) {\n          let mut seen = false\n          let mut k = 0\n          while k < Array::length(out) {\n            if Array::get(out, k) == name {\n              seen = true\n            }\n            k = k + 1\n          }\n          if !seen {\n            Array::push(out, name)\n          }\n        },\n        None => ()\n      }\n      for p in params {\n        let _ = collect_effect_vars_walk(p, out)\n      }\n      collect_effect_vars_walk(ret, out)\n    },\n    CtArray(elem) => collect_effect_vars_walk(elem, out),\n    CtOption(elem) => collect_effect_vars_walk(elem, out),\n    CtTuple(elems) => {\n      for e in elems {\n        let _ = collect_effect_vars_walk(e, out)\n      }\n      0\n    },\n    CtNamed(_, args) => {\n      for a in args {\n        let _ = collect_effect_vars_walk(a, out)\n      }\n      0\n    },\n    CtForAll(_, _, body) => collect_effect_vars_walk(body, out),\n    _ => 0\n  }\n}\n\nlet rename_eff_name: (String, Array[(String, String)]) -> String = (name, pairs) -> {\n  let mut i = 0\n  let mut out = name\n  while i < Array::length(pairs) {\n    let (k, v) = Array::get(pairs, i)\n    if k == name {\n      out = v\n    }\n    i = i + 1\n  }\n  out\n}\n\nlet rec rename_effect_vars: (Type, Array[(String, String)]) -> Type = (t, pairs) -> {\n  match t {\n    CtFn(params, ret, eff) => {\n      let new_params = Array::slice([\n        CtUnknown\n      ], 0, 0)\n      let mut i = 0\n      while i < Array::length(params) {\n        Array::push(new_params, rename_effect_vars(Array::get(params, i), pairs))\n        i = i + 1\n      }\n      let new_eff = match eff {\n        Some(name) => Some(rename_eff_name(name, pairs)),\n        None => None\n      }\n      CtFn(new_params, rename_effect_vars(ret, pairs), new_eff)\n    },\n    CtArray(elem) => CtArray(rename_effect_vars(elem, pairs)),\n    CtOption(elem) => CtOption(rename_effect_vars(elem, pairs)),\n    CtTuple(elems) => {\n      let out = Array::slice([\n        CtUnknown\n      ], 0, 0)\n      let mut i = 0\n      while i < Array::length(elems) {\n        Array::push(out, rename_effect_vars(Array::get(elems, i), pairs))\n        i = i + 1\n      }\n      CtTuple(out)\n    },\n    CtNamed(name, args) => {\n      let out = Array::slice([\n        CtUnknown\n      ], 0, 0)\n      let mut i = 0\n      while i < Array::length(args) {\n        Array::push(out, rename_effect_vars(Array::get(args, i), pairs))\n        i = i + 1\n      }\n      CtNamed(name, out)\n    },\n    _ => t\n  }\n}\n\nexport let instantiate: (Type, Int) -> (Type, Int, Array[(Int, Array[String])]) = (ty, c) -> {\n  match ty {\n    CtForAll(bound_vars, var_bounds, body) => {\n      let blen = Array::length(bound_vars)\n      let id_map = Array::slice([\n        (0, 0)\n      ], 0, 0)\n      let mut bi = 0\n      let mut bacc = SubstEmpty\n      let mut bnc = c\n      let mut bmax_i = 0\n      while bmax_i < blen {\n        let bold = Array::get(bound_vars, bmax_i)\n        if bold >= bnc {\n          bnc = bold + 1\n        } else {\n          ()\n        }\n        bmax_i = bmax_i + 1\n      }\n      while bi < blen {\n        let old_id = Array::get(bound_vars, bi)\n        Array::push(id_map, (old_id, bnc))\n        bacc = SubstBind(old_id, CtVar(bnc), bacc)\n        bnc = bnc + 1\n        bi = bi + 1\n      }\n      let inst_s = bacc\n      let id_map2 = id_map\n      let c1 = bnc\n      let new_bounds = Array::slice([\n        (0, Array::slice([\n          \"\"\n        ], 0, 0))\n      ], 0, 0)\n      for var_bound in var_bounds {\n        let (old_id, bounds) = var_bound\n        let new_id = int_int_lookup_or(id_map2, old_id, old_id, 0)\n        Array::push(new_bounds, (new_id, bounds))\n      };\n      let inst_body = subst_apply(inst_s, body)\n      let eff_vars = Array::slice([\n        \"\"\n      ], 0, 0)\n      let _ = collect_effect_vars_walk(inst_body, eff_vars)\n      let eff_pairs = Array::slice([\n        (\"\", \"\")\n      ], 0, 0)\n      let mut ev_i = 0\n      let mut ev_c = c1\n      while ev_i < Array::length(eff_vars) {\n        let ev = Array::get(eff_vars, ev_i)\n        Array::push(eff_pairs, (ev, String::concat(\"$\", __to_string(ev_c))))\n        ev_c = ev_c + 1\n        ev_i = ev_i + 1\n      }\n      let final_body = if Array::length(eff_pairs) == 0 {\n        inst_body\n      } else {\n        rename_effect_vars(inst_body, eff_pairs)\n      }\n      (final_body, ev_c, new_bounds)\n    },\n    _ => (ty, c, empty_var_bounds())\n  }\n}\n\nexport let rec trait_is_subtrait: (TypeEnv, String, String) -> Bool = (env, sub, super_name) -> {\n  if sub == super_name {\n    true\n  }\n  else {\n    let supers = trait_supers(env, sub)\n    let slen = Array::length(supers)\n    let mut si = 0\n    let mut sresult = false\n    let mut sdone = false\n    while !sdone {\n      if si >= slen {\n        sdone = true\n      } else {\n        let s = Array::get(supers, si)\n        if s == super_name {\n          sresult = true\n          sdone = true\n        } else if trait_is_subtrait(env, s, super_name) {\n          sresult = true\n          sdone = true\n        } else {\n          si = si + 1\n        }\n      }\n    }\n    sresult\n  }\n}\n\nlet rec collect_tvars_walk: (Type, Array[Int]) -> Int = (t, out) -> {\n  match t {\n    CtVar(id) => {\n      if !array_has_int(out, id, 0) {\n        Array::push(out, id)\n      }\n      0\n    },\n    CtFn(params, ret, _) => {\n      for p in params {\n        let _ = collect_tvars_walk(p, out)\n      }\n      collect_tvars_walk(ret, out)\n    },\n    CtArray(elem) => collect_tvars_walk(elem, out),\n    CtOption(elem) => collect_tvars_walk(elem, out),\n    CtTuple(elems) => {\n      for e in elems {\n        let _ = collect_tvars_walk(e, out)\n      }\n      0\n    },\n    CtForAll(_, _, body) => collect_tvars_walk(body, out),\n    _ => 0\n  }\n}\n\nexport let collect_tvars: (Type) -> Array[Int] = (ty) -> {\n  let out = Array::slice([\n    0\n  ], 0, 0)\n  let _ = collect_tvars_walk(ty, out)\n  out\n}\n\nlet empty_env_bindings: () -> Array[(String, Type)] = () -> {\n  Array::slice([\n    (\"\", CtUnknown)\n  ], 0, 0)\n}\n\nexport let env_flat_bindings: (TypeEnv) -> Array[(String, Type)] = (env) -> {\n  match env {\n    EnvFlat(bindings) => bindings,\n    _ => {\n      let out = empty_env_bindings()\n      let mut cur = env\n      let mut done = false\n      while !done {\n        match cur {\n          EnvEmpty => {\n            done = true\n          },\n          EnvBind(name, ty, rest) => {\n            Array::push(out, (name, ty))\n            cur = rest\n          },\n          EnvTraitDef(_, _, _, _, rest) => {\n            cur = rest\n          },\n          EnvTraitImpl(_, _, rest) => {\n            cur = rest\n          },\n          EnvTraitImplGen(_, _, _, _, rest) => {\n            cur = rest\n          },\n          EnvFlat(bindings) => {\n            let mut j = 0\n            while j < Array::length(bindings) {\n              Array::push(out, Array::get(bindings, j))\n              j = j + 1\n            }\n            done = true\n          },\n          EnvCached(_, rest) => {\n            cur = rest\n          }\n        }\n      }\n      out\n    }\n  }\n}\n\nlet string_array_equal: (Array[String], Array[String]) -> Bool = (left, right) -> {\n  let len = Array::length(left)\n  let mut i = 0\n  let mut result = true\n  let mut done = false\n  while !done {\n    if i >= len {\n      done = true\n    } else if Array::get(left, i) != Array::get(right, i) {\n      result = false\n      done = true\n    } else {\n      i = i + 1\n    }\n  }\n  result\n}\n\nlet option_string_equal: (Option[String], Option[String]) -> Bool = (left, right) -> {\n  match left {\n    Some(left_name) => match right {\n      Some(right_name) => left_name == right_name,\n      None => false\n    },\n    None => match right {\n      Some(_) => false,\n      None => true\n    }\n  }\n}\n\nlet effect_label_list: (Option[String]) -> Array[String] = (eff) -> {\n  let out = Array::slice([\n    \"\"\n  ], 0, 0)\n  match eff {\n    None => out,\n    Some(s) => {\n      let raw = String::split(s, \",\")\n      let mut i = 0\n      while i < Array::length(raw) {\n        let label = String::trim(Array::get(raw, i))\n        if String::length(label) > 0 {\n          let mut seen = false\n          let mut j = 0\n          while j < Array::length(out) {\n            if Array::get(out, j) == label {\n              seen = true\n            }\n            j = j + 1\n          }\n          if !seen {\n            Array::push(out, label)\n          }\n        }\n        i = i + 1\n      }\n      out\n    }\n  }\n}\n\nlet effect_label_sets_equal: (Option[String], Option[String]) -> Bool = (left, right) -> {\n  let ls = effect_label_list(left)\n  let rs = effect_label_list(right)\n  if Array::length(ls) != Array::length(rs) {\n    false\n  } else {\n    let mut i = 0\n    let mut ok = true\n    while i < Array::length(ls) {\n      let label = Array::get(ls, i)\n      let mut found = false\n      let mut j = 0\n      while j < Array::length(rs) {\n        if Array::get(rs, j) == label {\n          found = true\n        }\n        j = j + 1\n      }\n      if !found {\n        ok = false\n      }\n      i = i + 1\n    }\n    ok\n  }\n}\n\nlet effect_opt_is_var: (Option[String]) -> Bool = (eff) -> {\n  match eff {\n    Some(name) => is_effect_var_name(name),\n    None => false\n  }\n}\n\nlet effect_names_compatible: (Option[String], Option[String]) -> Bool = (left, right) -> {\n  if option_string_equal(left, right) {\n    true\n  } else if effect_opt_is_var(left) {\n    false\n  } else if effect_opt_is_var(right) {\n    false\n  } else {\n    effect_label_sets_equal(left, right)\n  }\n}\n\nlet unify_effects: (Option[String], Option[String], Subst) -> Option[Subst] = (ea, eb, s) -> {\n  let ra = resolve_effect_opt(s, ea)\n  let rb = resolve_effect_opt(s, eb)\n  let a_is_var = match ra {\n    Some(n) => is_effect_var_name(n),\n    None => false\n  }\n  let b_is_var = match rb {\n    Some(n) => is_effect_var_name(n),\n    None => false\n  }\n  if a_is_var {\n    match ra {\n      Some(av) => if Some(av) == rb {\n        Some(s)\n      } else {\n        let bval = match rb {\n          Some(bv) => bv,\n          None => \"\"\n        }\n        Some(SubstEffBind(av, bval, s))\n      },\n      None => Some(s)\n    }\n  } else if b_is_var {\n    match rb {\n      Some(bv) => {\n        let aval = match ra {\n          Some(av) => av,\n          None => \"\"\n        }\n        Some(SubstEffBind(bv, aval, s))\n      },\n      None => Some(s)\n    }\n  } else if effect_names_compatible(ra, rb) {\n    Some(s)\n  } else {\n    None\n  }\n}\n\nexport let rec types_equal: (Type, Type) -> Bool = (a, b) -> {\n  match a {\n    CtInt => match b {\n      CtInt => true,\n      _ => false\n    },\n    CtDouble => match b {\n      CtDouble => true,\n      _ => false\n    },\n    CtBool => match b {\n      CtBool => true,\n      _ => false\n    },\n    CtString => match b {\n      CtString => true,\n      _ => false\n    },\n    CtChar => match b {\n      CtChar => true,\n      _ => false\n    },\n    CtUnit => match b {\n      CtUnit => true,\n      _ => false\n    },\n    CtBytes => match b {\n      CtBytes => true,\n      _ => false\n    },\n    CtUnknown => match b {\n      CtUnknown => true,\n      _ => false\n    },\n    CtVar(aid) => match b {\n      CtVar(bid) => (aid == bid),\n      _ => false\n    },\n    CtArray(aelem) => match b {\n      CtArray(belem) => types_equal(aelem, belem),\n      _ => false\n    },\n    CtOption(aelem) => match b {\n      CtOption(belem) => types_equal(aelem, belem),\n      _ => false\n    },\n    CtEnum(aname) => match b {\n      CtEnum(bname) => aname == bname,\n      CtNamed(bname, bargs) => aname == bname && Array::length(bargs) == 0,\n      _ => false\n    },\n    CtStruct(aname) => match b {\n      CtStruct(bname) => aname == bname,\n      CtNamed(bname, bargs) => aname == bname && Array::length(bargs) == 0,\n      _ => false\n    },\n    CtNamed(aname, aargs) => match b {\n      CtEnum(bname) => aname == bname && Array::length(aargs) == 0,\n      CtStruct(bname) => aname == bname && Array::length(aargs) == 0,\n      CtNamed(bname, bargs) =>\n      if aname != bname {\n        false\n      } else if Array::length(aargs) != Array::length(bargs) {\n        false\n      } else {\n        let tae_len = Array::length(aargs)\n        let mut tae_i = 0\n        let mut tae_result = true\n        let mut tae_done = false\n        while !tae_done {\n          if tae_i >= tae_len {\n            tae_done = true\n          } else {\n            if types_equal(Array::get(aargs, tae_i), Array::get(bargs, tae_i)) {\n              tae_i = tae_i + 1\n            } else {\n              tae_result = false\n              tae_done = true\n            }\n          }\n        }\n        tae_result\n      },\n      _ => false\n    },\n    CtTuple(aelems) => match b {\n      CtTuple(belems) =>\n      if Array::length(aelems) != Array::length(belems) {\n        false\n      } else {\n        let tae_len2 = Array::length(aelems)\n        let mut tae_i2 = 0\n        let mut tae_result2 = true\n        let mut tae_done2 = false\n        while !tae_done2 {\n          if tae_i2 >= tae_len2 {\n            tae_done2 = true\n          } else {\n            if types_equal(Array::get(aelems, tae_i2), Array::get(belems, tae_i2)) {\n              tae_i2 = tae_i2 + 1\n            } else {\n              tae_result2 = false\n              tae_done2 = true\n            }\n          }\n        }\n        tae_result2\n      },\n      _ => false\n    },\n    CtFn(aparams, aret, aeffect) => match b {\n      CtFn(bparams, bret, beffect) =>\n      if Array::length(aparams) != Array::length(bparams) {\n        false\n      } else if effect_names_compatible(aeffect, beffect) {\n        let tae_len3 = Array::length(aparams)\n        let mut tae_i3 = 0\n        let mut tae_result3 = true\n        let mut tae_done3 = false\n        while !tae_done3 {\n          if tae_i3 >= tae_len3 {\n            tae_done3 = true\n          } else {\n            if types_equal(Array::get(aparams, tae_i3), Array::get(bparams, tae_i3)) {\n              tae_i3 = tae_i3 + 1\n            } else {\n              tae_result3 = false\n              tae_done3 = true\n            }\n          }\n        }\n        if tae_result3 {\n          types_equal(aret, bret)\n        } else {\n          false\n        }\n      } else {\n        false\n      },\n      _ => false\n    },\n    CtForAll(avars, abounds, abody) => match b {\n      CtForAll(bvars, bbounds, bbody) => if Array::length(avars) != Array::length(bvars) {\n        false\n      } else if Array::length(abounds) != Array::length(bbounds) {\n        false\n      } else {\n        let vlen = Array::length(avars)\n        let mut vi = 0\n        let mut vresult = true\n        let mut vdone = false\n        while !vdone {\n          if vi >= vlen {\n            vdone = true\n          } else if Array::get(avars, vi) != Array::get(bvars, vi) {\n            vresult = false\n            vdone = true\n          } else {\n            vi = vi + 1\n          }\n        }\n        if vresult {\n          let fbe_len = Array::length(abounds)\n          let mut fbe_i = 0\n          let mut fbe_result = true\n          let mut fbe_done = false\n          while !fbe_done {\n            if fbe_i >= fbe_len {\n              fbe_done = true\n            } else {\n              let (lvar, lbounds) = Array::get(abounds, fbe_i)\n              let (rvar, rbounds) = Array::get(bbounds, fbe_i)\n              if lvar != rvar {\n                fbe_result = false\n                fbe_done = true\n              } else if Array::length(lbounds) != Array::length(rbounds) {\n                fbe_result = false\n                fbe_done = true\n              } else {\n                if string_array_equal(lbounds, rbounds) {\n                  fbe_i = fbe_i + 1\n                } else {\n                  fbe_result = false\n                  fbe_done = true\n                }\n              }\n            }\n          }\n          if fbe_result {\n            types_equal(abody, bbody)\n          } else {\n            false\n          }\n        } else {\n          false\n        }\n      }\n      ,\n      _ => false\n    }\n  }\n}\n\nlet char_int_compatible: (Type, Type) -> Bool = (ta, tb) -> {\n  match ta {\n    CtChar => match tb {\n      CtInt => true,\n      _ => false\n    },\n    CtInt => match tb {\n      CtChar => true,\n      _ => false\n    },\n    _ => false\n  }\n}\n\nexport let rec unify: (Type, Type, Subst) -> Option[Subst] = (a, b, s) -> {\n  let ta = subst_apply(s, a)\n  let tb = subst_apply(s, b)\n  if types_equal(ta, tb) {\n    Some(s)\n  }\n  else if char_int_compatible(ta, tb) {\n    Some(s)\n  }\n  else match ta {\n    CtVar(id) => if occurs_in(id, tb) {\n      None\n    } else Some(SubstBind(id, tb, s)),\n    _ => match tb {\n      CtVar(id) => if occurs_in(id, ta) {\n        None\n      } else Some(SubstBind(id, ta, s)),\n      _ => match ta {\n        CtUnknown => Some(s),\n        _ => match tb {\n          CtUnknown => Some(s),\n          _ => match ta {\n            CtForAll(_, _, body_a) => match tb {\n              CtForAll(_, _, body_b) => unify(body_a, body_b, s),\n              _ => unify(body_a, tb, s)\n            },\n            _ => match tb {\n              CtForAll(_, _, body_b) => unify(ta, body_b, s),\n              _ => match ta {\n                CtArray(ea) => match tb {\n                  CtArray(eb) => unify(ea, eb, s),\n                  _ => None\n                },\n                CtOption(ea) => match tb {\n                  CtOption(eb) => unify(ea, eb, s),\n                  _ => None\n                },\n                CtFn(pa, ra, aeffect) => match tb {\n                  CtFn(pb, rb, beffect) => if Array::length(pa) != Array::length(pb) {\n                    None\n                  }\n                  else {\n                    let ul_len = Array::length(pa)\n                    let mut ul_i = 0\n                    let mut ul_acc = s\n                    let mut ul_result = Some(s)\n                    let mut ul_done = false\n                    while !ul_done {\n                      if ul_i >= ul_len {\n                        ul_result = Some(ul_acc)\n                        ul_done = true\n                      } else {\n                        match unify(Array::get(pa, ul_i), Array::get(pb, ul_i), ul_acc) {\n                          Some(s2) => {\n                            ul_acc = s2\n                            ul_i = ul_i + 1\n                          },\n                          None => {\n                            ul_result = None\n                            ul_done = true\n                          }\n                        }\n                      }\n                    }\n                    match ul_result {\n                      Some(s2) => match unify(ra, rb, s2) {\n                        Some(s3) => unify_effects(aeffect, beffect, s3),\n                        None => None\n                      },\n                      None => None\n                    }\n                  },\n                  _ => None\n                },\n                CtTuple(ea) => match tb {\n                  CtTuple(eb) => if Array::length(ea) != Array::length(eb) {\n                    None\n                  }\n                  else {\n                    let ul_len2 = Array::length(ea)\n                    let mut ul_i2 = 0\n                    let mut ul_acc2 = s\n                    let mut ul_result2 = Some(s)\n                    let mut ul_done2 = false\n                    while !ul_done2 {\n                      if ul_i2 >= ul_len2 {\n                        ul_result2 = Some(ul_acc2)\n                        ul_done2 = true\n                      } else {\n                        match unify(Array::get(ea, ul_i2), Array::get(eb, ul_i2), ul_acc2) {\n                          Some(s2) => {\n                            ul_acc2 = s2\n                            ul_i2 = ul_i2 + 1\n                          },\n                          None => {\n                            ul_result2 = None\n                            ul_done2 = true\n                          }\n                        }\n                      }\n                    }\n                    ul_result2\n                  },\n                  _ => None\n                },\n                CtEnum(a_name) => match tb {\n                  CtEnum(b_name) => if a_name == b_name {\n                    Some(s)\n                  } else None,\n                  CtNamed(b_name, _) => if a_name == b_name {\n                    Some(s)\n                  } else None,\n                  _ => None\n                },\n                CtStruct(a_name) => match tb {\n                  CtStruct(b_name) => if a_name == b_name {\n                    Some(s)\n                  } else None,\n                  CtNamed(b_name, b_args) => if a_name == b_name && Array::length(b_args) == 0 {\n                    Some(s)\n                  } else None,\n                  _ => None\n                },\n                CtNamed(a_name, a_args) => match tb {\n                  CtEnum(b_name) => if a_name == b_name {\n                    Some(s)\n                  } else None,\n                  CtStruct(b_name) => if a_name == b_name && Array::length(a_args) == 0 {\n                    Some(s)\n                  } else None,\n                  CtNamed(b_name, b_args) => if a_name != b_name {\n                    None\n                  }\n                  else if Array::length(a_args) != Array::length(b_args) {\n                    None\n                  }\n                  else {\n                    let ul_len3 = Array::length(a_args)\n                    let mut ul_i3 = 0\n                    let mut ul_acc3 = s\n                    let mut ul_result3 = Some(s)\n                    let mut ul_done3 = false\n                    while !ul_done3 {\n                      if ul_i3 >= ul_len3 {\n                        ul_result3 = Some(ul_acc3)\n                        ul_done3 = true\n                      } else {\n                        match unify(Array::get(a_args, ul_i3), Array::get(b_args, ul_i3), ul_acc3) {\n                          Some(s2) => {\n                            ul_acc3 = s2\n                            ul_i3 = ul_i3 + 1\n                          },\n                          None => {\n                            ul_result3 = None\n                            ul_done3 = true\n                          }\n                        }\n                      }\n                    }\n                    ul_result3\n                  },\n                  _ => None\n                },\n                _ => None\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}\n\nexport let types_compatible: (Type, Type) -> Bool = (expected, actual) -> {\n  match expected {\n    CtUnknown => true,\n    _ => match actual {\n      CtUnknown => true,\n      _ => types_equal(expected, actual)\n    }\n  }\n}\n\nexport let rec impls_overlap_for: (TypeEnv, String, Type) -> Bool = (env, trait_name, new_target) -> {\n  match env {\n    EnvEmpty => false,\n    EnvBind(_, _, rest) => impls_overlap_for(rest, trait_name, new_target),\n    EnvTraitDef(_, _, _, _, rest) => impls_overlap_for(rest, trait_name, new_target),\n    EnvTraitImpl(tname, target, rest) => if tname == trait_name {\n      if types_equal(target, new_target) {\n        true\n      }\n      else impls_overlap_for(rest, trait_name, new_target)\n    } else impls_overlap_for(rest, trait_name, new_target),\n    EnvTraitImplGen(_, _, _, _, rest) => impls_overlap_for(rest, trait_name, new_target),\n    EnvFlat(_) => false,\n    EnvCached(_, rest) => impls_overlap_for(rest, trait_name, new_target)\n  }\n}\n\nlet rec type_implements_check_env: (TypeEnv, String, Type) -> Bool = (e, trait_name, resolved) -> {\n  match e {\n    EnvEmpty => false,\n    EnvBind(_, _, rest) => type_implements_check_env(rest, trait_name, resolved),\n    EnvTraitDef(_, _, _, _, rest) => type_implements_check_env(rest, trait_name, resolved),\n    EnvTraitImpl(tname, target, rest) => if tname == trait_name {\n      if types_equal(target, resolved) {\n        true\n      }\n      else type_implements_check_env(rest, trait_name, resolved)\n    } else type_implements_check_env(rest, trait_name, resolved),\n    EnvTraitImplGen(_, _, _, _, rest) => type_implements_check_env(rest, trait_name, resolved),\n    EnvFlat(_) => false,\n    EnvCached(_, rest) => type_implements_check_env(rest, trait_name, resolved)\n  }\n}\n\nexport let collect_subst_bounds_pairs: (Subst) -> Array[(Int, Array[String])] = (s) -> {\n  let out = Array::slice([\n    (0, Array::slice([\n      \"\"\n    ], 0, 0))\n  ], 0, 0)\n  let mut cur = s\n  let mut done = false\n  while !done {\n    match cur {\n      SubstEmpty => {\n        done = true\n      },\n      SubstBind(_, _, rest) => {\n        cur = rest\n      },\n      SubstBound(id, bounds, rest) => {\n        if !int_bounds_has_id(out, id, 0) {\n          Array::push(out, (id, bounds))\n        }\n        cur = rest\n      },\n      SubstCached(_, _, rest) => {\n        cur = rest\n      },\n      SubstEffBind(_, _, rest) => {\n        cur = rest\n      }\n    }\n  }\n  out\n}\n\nexport let generalize: (Subst, Type) -> Type = (s, ty) -> {\n  let resolved = subst_apply(s, ty)\n  let tvars = collect_tvars(resolved)\n  if Array::length(tvars) == 0 {\n    resolved\n  }\n  else {\n    let bounds_pairs = collect_subst_bounds_pairs(s)\n    let var_bounds = Array::slice([\n      (0, Array::slice([\n        \"\"\n      ], 0, 0))\n    ], 0, 0)\n    for vid in tvars {\n      let bounds = int_bounds_lookup(bounds_pairs, vid, 0)\n      if Array::length(bounds) != 0 {\n        Array::push(var_bounds, (vid, bounds))\n      }\n    }\n    CtForAll(tvars, var_bounds, resolved)\n  }\n}\n\nlet rec type_implements_check_super: (TypeEnv, TypeEnv, String, Type) -> Bool = (e2, full_env, trait_name, resolved) -> {\n  match e2 {\n    EnvEmpty => false,\n    EnvBind(_, _, rest) => type_implements_check_super(rest, full_env, trait_name, resolved),\n    EnvTraitDef(_, _, _, _, rest) => type_implements_check_super(rest, full_env, trait_name, resolved),\n    EnvTraitImpl(tname, target, rest) => if types_equal(target, resolved) {\n      if trait_is_subtrait(full_env, tname, trait_name) {\n        true\n      }\n      else type_implements_check_super(rest, full_env, trait_name, resolved)\n    } else type_implements_check_super(rest, full_env, trait_name, resolved),\n    EnvTraitImplGen(_, _, _, _, rest) => type_implements_check_super(rest, full_env, trait_name, resolved),\n    EnvFlat(_) => false,\n    EnvCached(_, rest) => type_implements_check_super(rest, full_env, trait_name, resolved)\n  }\n}\n\nlet type_constructor_name: (Type) -> String = (ty) -> {\n  match ty {\n    CtArray(_) => \"Array\",\n    CtOption(_) => \"Option\",\n    CtNamed(n, _) => n,\n    CtStruct(n) => n,\n    CtEnum(n) => n,\n    _ => \"\"\n  }\n}\n\nlet rec trait_is_method_bearing: (TypeEnv, String) -> Bool = (env, trait_name) -> {\n  match env {\n    EnvEmpty => false,\n    EnvBind(_, _, rest) => trait_is_method_bearing(rest, trait_name),\n    EnvTraitDef(tname, _, _, methods, rest) => if tname == trait_name {\n      Array::length(methods) > 0\n    } else trait_is_method_bearing(rest, trait_name),\n    EnvTraitImpl(_, _, rest) => trait_is_method_bearing(rest, trait_name),\n    EnvTraitImplGen(_, _, _, _, rest) => trait_is_method_bearing(rest, trait_name),\n    EnvFlat(_) => false,\n    EnvCached(_, rest) => trait_is_method_bearing(rest, trait_name)\n  }\n}\n\n\nlet type_args_of: (Type) -> Array[Type] = (ty) -> {\n  match ty {\n    CtArray(e) => Array::slice([\n      e\n    ], 0, 1),\n    CtOption(e) => Array::slice([\n      e\n    ], 0, 1),\n    CtNamed(_, args) => args,\n    _ => Array::slice([\n      CtUnit\n    ], 0, 0)\n  }\n}\n\nlet rec generic_impl_satisfies: (TypeEnv, TypeEnv, Subst, String, Type) -> Bool = (scan, full, s, trait_name, resolved) -> {\n  match scan {\n    EnvEmpty => false,\n    EnvBind(_, _, rest) => generic_impl_satisfies(rest, full, s, trait_name, resolved),\n    EnvTraitDef(_, _, _, _, rest) => generic_impl_satisfies(rest, full, s, trait_name, resolved),\n    EnvTraitImpl(_, _, rest) => generic_impl_satisfies(rest, full, s, trait_name, resolved),\n    EnvTraitImplGen(itrait, _tparams, bounds, target, rest) => {\n      let head = type_constructor_name(resolved)\n      let shape_ok = itrait == trait_name && head != \"\" && type_constructor_name(target) == head && trait_is_method_bearing(full, trait_name)\n      if shape_ok && generic_bounds_hold(full, s, bounds, type_args_of(resolved)) {\n        true\n      } else generic_impl_satisfies(rest, full, s, trait_name, resolved)\n    },\n    EnvFlat(_) => false,\n    EnvCached(_, rest) => generic_impl_satisfies(rest, full, s, trait_name, resolved)\n  }\n}\n\nlet rec generic_bounds_hold: (TypeEnv, Subst, Array[(String, Array[String])], Array[Type]) -> Bool = (full, s, bounds, args) -> {\n  let mut bi = 0\n  let mut ok = true\n  while bi < Array::length(bounds) {\n    let (_, btraits) = Array::get(bounds, bi)\n    let mut ti = 0\n    while ti < Array::length(btraits) {\n      let bt = Array::get(btraits, ti)\n      if bt != \"\" {\n        let mut ai = 0\n        while ai < Array::length(args) {\n          match subst_apply(s, Array::get(args, ai)) {\n            CtUnknown => (),\n            _ => if not(type_implements_trait(full, s, Array::get(args, ai), bt)) {\n              ok = false\n            } else {\n              ()\n            }\n          }\n          ai = ai + 1\n        }\n      } else {\n        ()\n      }\n      ti = ti + 1\n    }\n    bi = bi + 1\n  }\n  ok\n}\n\nexport let rec type_implements_trait: (TypeEnv, Subst, Type, String) -> Bool = (env, s, ty, trait_name) -> {\n  let resolved = subst_apply(s, ty)\n  if type_implements_check_env(env, trait_name, resolved) {\n    true\n  }\n  else if generic_impl_satisfies(env, env, s, trait_name, resolved) {\n    true\n  }\n  else {\n    let supers = trait_supers(env, trait_name)\n    let slen = Array::length(supers)\n    if slen == 0 {\n      false\n    }\n    else {\n      type_implements_check_super(env, env, trait_name, resolved)\n    }\n  }\n}\n")
}

let selfhost_source_19 = () -> (String, String) {
  ("lib/@vibe/compiler/core/dce.vibe",
"\n\n\nlet clone_arr: (Array[String]) -> Array[String] = (arr) -> {\n  Array::slice(arr, 0, Array::length(arr))\n}\n\nlet stmt_name: (Stmt) -> Option[String] = (stmt) -> {\n  match stmt {\n    SLet(_, _, name, _, _) => Some(name),\n    SLetMut(name, _, _) => Some(name),\n    _ => None\n  }\n}\n\nlet dce_array_contains_str: (Array[String], String) -> Bool = (arr, s) -> {\n  let len = Array::length(arr)\n  let rec search: (Int) -> Bool = (i) -> {\n    if i >= len {\n      false\n    }\n    else if Array::get(arr, i) == s {\n      true\n    }\n    else search(i + 1)\n  }\n  search(0)\n}\n\nlet add_ref: (Array[String], Array[String], String) -> Int = (out, bound, name) -> {\n  if not(dce_array_contains_str(bound, name)) {\n    if not(dce_array_contains_str(out, name)) {\n      Array::push(out, name)\n    }\n  }\n  0\n}\n\nlet rec collect_pat_bindings: (Pat, Array[String]) -> Int = (pat, bound) -> {\n  match pat {\n    PWild => 0,\n    PBind(name) => {\n      Array::push(bound, name)\n      0\n    },\n    PInt(_) => 0,\n    PFloat(_) => 0,\n    PString(_) => 0,\n    PBool(_) => 0,\n    PCtor(_, pats) => {\n      let mut i = 0\n      while i < Array::length(pats) {\n        collect_pat_bindings(Array::get(pats, i), bound)\n        i = i + 1\n      }\n      0\n    },\n    PTuple(pats) => {\n      let mut i = 0\n      while i < Array::length(pats) {\n        collect_pat_bindings(Array::get(pats, i), bound)\n        i = i + 1\n      }\n      0\n    },\n    POr(p1, p2) => {\n      collect_pat_bindings(p1, bound)\n      collect_pat_bindings(p2, bound)\n      0\n    },\n    PStruct(_, _) => 0\n  }\n}\n\nlet rec collect_refs_into: (Expr, Array[String], Array[String]) -> Int = (expr, bound, out) -> {\n  match expr {\n    EIdent(name, _) => add_ref(out, bound, name),\n    EInt(_) => 0,\n    EFloat(_) => 0,\n    EString(_) => 0,\n    EBool(_) => 0,\n    EUnit => 0,\n    EBreak(_) => 0,\n    EContinue(_) => 0,\n    EThrow(e) => collect_refs_into(e, bound, out),\n    EReturn(e) => collect_refs_into(e, bound, out),\n    EUnaryOp(_, e) => collect_refs_into(e, bound, out),\n    ETuple(items) => {\n      let mut i = 0\n      while i < Array::length(items) {\n        collect_refs_into(Array::get(items, i), bound, out)\n        i = i + 1\n      }\n      0\n    },\n    EArray(items) => {\n      let mut i = 0\n      while i < Array::length(items) {\n        collect_refs_into(Array::get(items, i), bound, out)\n        i = i + 1\n      }\n      0\n    },\n    ERecord(_, fields) => {\n      let mut i = 0\n      while i < Array::length(fields) {\n        let (_, val) = Array::get(fields, i)\n        collect_refs_into(val, bound, out)\n        i = i + 1\n      }\n      0\n    },\n    EBinOp(_, l, r) => {\n      collect_refs_into(l, bound, out)\n      collect_refs_into(r, bound, out)\n      0\n    },\n    ECall(callee, args, _) => {\n      collect_refs_into(callee, bound, out)\n      let mut i = 0\n      while i < Array::length(args) {\n        collect_refs_into(Array::get(args, i), bound, out)\n        i = i + 1\n      }\n      0\n    },\n    EIf(cond, then_e, else_e) => {\n      collect_refs_into(cond, bound, out)\n      collect_refs_into(then_e, bound, out)\n      collect_refs_into(else_e, bound, out)\n      0\n    },\n    ELet(name, val, body, _) => {\n      collect_refs_into(val, bound, out)\n      let bound2 = clone_arr(bound)\n      Array::push(bound2, name)\n      collect_refs_into(body, bound2, out)\n      0\n    },\n    ELetRec(name, val, body) => {\n      let bound2 = clone_arr(bound)\n      Array::push(bound2, name)\n      collect_refs_into(val, bound2, out)\n      collect_refs_into(body, bound2, out)\n      0\n    },\n    ELetMut(name, val, body, _) => {\n      collect_refs_into(val, bound, out)\n      let bound2 = clone_arr(bound)\n      Array::push(bound2, name)\n      collect_refs_into(body, bound2, out)\n      0\n    },\n    EAssign(_, val, body) => {\n      collect_refs_into(val, bound, out)\n      collect_refs_into(body, bound, out)\n      0\n    },\n    EAssignOp(_, _, val, body) => {\n      collect_refs_into(val, bound, out)\n      collect_refs_into(body, bound, out)\n      0\n    },\n    ESeq(l, r) => {\n      collect_refs_into(l, bound, out)\n      collect_refs_into(r, bound, out)\n      0\n    },\n    EMatch(scr, arms) => {\n      collect_refs_into(scr, bound, out)\n      let mut i = 0\n      while i < Array::length(arms) {\n        let (pat, body) = Array::get(arms, i)\n        let bound2 = clone_arr(bound)\n        collect_pat_bindings(pat, bound2)\n        collect_refs_into(body, bound2, out)\n        i = i + 1\n      }\n      0\n    },\n    EHandle(body_expr, arms) => {\n      collect_refs_into(body_expr, bound, out)\n      let mut i = 0\n      while i < Array::length(arms) {\n        let (pat, arm_body) = Array::get(arms, i)\n        let bound2 = clone_arr(bound)\n        collect_pat_bindings(pat, bound2)\n        collect_refs_into(arm_body, bound2, out)\n        i = i + 1\n      }\n      0\n    },\n    EWhile(cond, body) => {\n      collect_refs_into(cond, bound, out)\n      collect_refs_into(body, bound, out)\n      0\n    },\n    ELoop(params, body) => {\n      let bound2 = clone_arr(bound)\n      let mut i = 0\n      while i < Array::length(params) {\n        let (name, init) = Array::get(params, i)\n        collect_refs_into(init, bound2, out)\n        Array::push(bound2, name)\n        i = i + 1\n      }\n      collect_refs_into(body, bound2, out)\n      0\n    },\n    EForIn(name, index_name, iter, body) => {\n      collect_refs_into(iter, bound, out)\n      let bound2 = clone_arr(bound)\n      Array::push(bound2, name)\n      match index_name {\n        Some(index_name) => Array::push(bound2, index_name),\n        None => ()\n      }\n      collect_refs_into(body, bound2, out)\n      0\n    },\n    EFn(_, _, params, _, _, body) => {\n      let bound2 = clone_arr(bound)\n      let mut i = 0\n      while i < Array::length(params) {\n        let (pname, _) = Array::get(params, i)\n        Array::push(bound2, pname)\n        i = i + 1\n      }\n      collect_refs_into(body, bound2, out)\n      0\n    },\n    EDot(obj, _, _, _) => {\n      collect_refs_into(obj, bound, out)\n      0\n    },\n    ELabeledArg(_, _, e) => {\n      collect_refs_into(e, bound, out)\n      0\n    },\n    EMap(fields) => {\n      let mut i = 0\n      while i < Array::length(fields) {\n        let (_, val) = Array::get(fields, i)\n        collect_refs_into(val, bound, out)\n        i = i + 1\n      }\n      0\n    },\n    ESpread(e) => {\n      collect_refs_into(e, bound, out)\n      0\n    },\n    EStringInterp(_) => 0\n  }\n}\n\nlet collect_refs: (Expr, Array[String]) -> Array[String] = (expr, bound) -> {\n  let out = Array::slice([\n    \"\"\n  ], 0, 0)\n  collect_refs_into(expr, bound, out)\n  out\n}\n\nlet enqueue_reachable: (Array[String], Array[String], String) -> Unit = (reachable, queue, name) -> {\n  if not(dce_array_contains_str(reachable, name)) {\n    Array::push(reachable, name)\n    Array::push(queue, name)\n  }\n}\n\nlet collect_structural_refs_into_queue: (Stmt, Array[String], Array[String], Array[String]) -> Unit = (stmt, bound, reachable, queue) -> {\n  let refs = match stmt {\n    STest(_, expr) => collect_refs(expr, bound),\n    SBench(_, expr) => collect_refs(expr, bound),\n    SExpr(expr) => collect_refs(expr, bound),\n    _ => Array::slice([\n      \"\"\n    ], 0, 0)\n  }\n  let mut i = 0\n  while i < Array::length(refs) {\n    enqueue_reachable(reachable, queue, Array::get(refs, i))\n    i = i + 1\n  }\n}\n\nlet is_type_or_structural: (Stmt) -> Bool = (stmt) -> {\n  match stmt {\n    SEnum(_, _, _, _, _) => true,\n    SSuberror(_, _, _) => true,\n    SEffectDef(_, _, _, _) => true,\n    SStruct(_, _, _, _, _) => true,\n    STypeAlias(_, _, _, _) => true,\n    STrait(_, _, _, _, _) => true,\n    SImpl(_, _, _, _) => true,\n    SExternLet(_, _) => true,\n    SImport(_, _) => true,\n    SAliasDecl(_, _) => true,\n    STest(_, _) => true,\n    SBench(_, _) => true,\n    SExpr(_) => true,\n    SExport(_) => true,\n    SReExport(_, _) => true,\n    SModule(_, _, _) => true,\n    _ => false\n  }\n}\n\nexport let dce_stmts: (Array[Stmt], Array[String]) -> Array[Stmt] = (stmts, entry_names) -> {\n  if Array::length(stmts) == 0 {\n    Array::slice(stmts, 0, 0)\n  } else {\n  let empty_bound = Array::slice([\n    \"\"\n  ], 0, 0)\n  let def_names = Array::slice([\n    \"\"\n  ], 0, 0)\n  let def_refs = Array::slice([\n    Array::slice([\n      \"\"\n    ], 0, 0)\n  ], 0, 0)\n  let mut i = 0\n  while i < Array::length(stmts) {\n    let stmt = Array::get(stmts, i)\n    match stmt_name(stmt) {\n      Some(name) => {\n        Array::push(def_names, name)\n        let refs = match stmt {\n          SLet(_, _, _, _, expr) => collect_refs(expr, empty_bound),\n          SLetMut(_, _, expr) => collect_refs(expr, empty_bound),\n          _ => Array::slice([\n            \"\"\n          ], 0, 0)\n        }\n        Array::push(def_refs, refs)\n        0\n      },\n      None => 0\n    }\n    i = i + 1\n  }\n  let reachable = Array::slice([\n    \"\"\n  ], 0, 0)\n  let queue = Array::slice([\n    \"\"\n  ], 0, 0)\n  let mut j = 0\n  while j < Array::length(entry_names) {\n    let name = Array::get(entry_names, j)\n    enqueue_reachable(reachable, queue, name)\n    j = j + 1\n  }\n  let mut sj = 0\n  while sj < Array::length(stmts) {\n    collect_structural_refs_into_queue(Array::get(stmts, sj), empty_bound, reachable, queue)\n    sj = sj + 1\n  }\n  let mut qi = 0\n  while qi < Array::length(queue) {\n    let current = Array::get(queue, qi)\n    qi = qi + 1\n    let mut k = 0\n    while k < Array::length(def_names) {\n      if Array::get(def_names, k) == current {\n        let refs = Array::get(def_refs, k)\n        let mut r = 0\n        while r < Array::length(refs) {\n          let dep = Array::get(refs, r)\n          if not(dce_array_contains_str(reachable, dep)) {\n            Array::push(reachable, dep)\n            Array::push(queue, dep)\n          }\n          r = r + 1\n        }\n      }\n      k = k + 1\n    }\n  }\n  let result = Array::slice([\n    Array::get(stmts, 0)\n  ], 0, 0)\n  let mut m = 0\n  while m < Array::length(stmts) {\n    let stmt = Array::get(stmts, m)\n    if is_type_or_structural(stmt) {\n      Array::push(result, stmt)\n    } else {\n      match stmt_name(stmt) {\n        Some(name) => if dce_array_contains_str(reachable, name) {\n          Array::push(result, stmt)\n        },\n        None => Array::push(result, stmt)\n      }\n    }\n    m = m + 1\n  }\n  result\n  }\n}\n\nlet dce_reachable_names: (Array[Stmt], Array[String]) -> Array[String] = (stmts, entry_names) -> {\n  let empty_bound = Array::slice([\n    \"\"\n  ], 0, 0)\n  let def_names = Array::slice([\n    \"\"\n  ], 0, 0)\n  let def_refs = Array::slice([\n    Array::slice([\n      \"\"\n    ], 0, 0)\n  ], 0, 0)\n  let mut i = 0\n  while i < Array::length(stmts) {\n    let stmt = Array::get(stmts, i)\n    match stmt_name(stmt) {\n      Some(name) => {\n        Array::push(def_names, name)\n        let refs = match stmt {\n          SLet(_, _, _, _, expr) => collect_refs(expr, empty_bound),\n          SLetMut(_, _, expr) => collect_refs(expr, empty_bound),\n          _ => Array::slice([\n            \"\"\n          ], 0, 0)\n        }\n        Array::push(def_refs, refs)\n        0\n      },\n      None => 0\n    }\n    i = i + 1\n  }\n  let reachable = Array::slice([\n    \"\"\n  ], 0, 0)\n  let queue = Array::slice([\n    \"\"\n  ], 0, 0)\n  let mut j = 0\n  while j < Array::length(entry_names) {\n    let name = Array::get(entry_names, j)\n    enqueue_reachable(reachable, queue, name)\n    j = j + 1\n  }\n  let mut sj = 0\n  while sj < Array::length(stmts) {\n    collect_structural_refs_into_queue(Array::get(stmts, sj), empty_bound, reachable, queue)\n    sj = sj + 1\n  }\n  let mut qi = 0\n  while qi < Array::length(queue) {\n    let current = Array::get(queue, qi)\n    qi = qi + 1\n    let mut k = 0\n    while k < Array::length(def_names) {\n      if Array::get(def_names, k) == current {\n        let refs = Array::get(def_refs, k)\n        let mut r = 0\n        while r < Array::length(refs) {\n          let dep = Array::get(refs, r)\n          if not(dce_array_contains_str(reachable, dep)) {\n            Array::push(reachable, dep)\n            Array::push(queue, dep)\n          }\n          r = r + 1\n        }\n      }\n      k = k + 1\n    }\n  }\n  reachable\n}\n\nlet dce_keep_stmt: (Stmt, Array[String]) -> Bool = (stmt, reachable) -> {\n  if is_type_or_structural(stmt) {\n    true\n  } else {\n    match stmt_name(stmt) {\n      Some(name) => dce_array_contains_str(reachable, name),\n      None => true\n    }\n  }\n}\n\nexport let dce_keep_flags: (Array[Stmt], Array[String]) -> Array[Bool] = (stmts, entry_names) -> {\n  let flags = Array::slice([\n    true\n  ], 0, 0)\n  if Array::length(stmts) == 0 {\n    flags\n  } else {\n    let reachable = dce_reachable_names(stmts, entry_names)\n    let mut m = 0\n    while m < Array::length(stmts) {\n      Array::push(flags, dce_keep_stmt(Array::get(stmts, m), reachable))\n      m = m + 1\n    }\n    flags\n  }\n}\n")
}

let selfhost_source_20 = () -> (String, String) {
  ("lib/@vibe/compiler/core/sorted_index.vibe",
"\n\nexport let str_lt: (String, String) -> Bool = (a, b) -> {\n  let la = String::length(a)\n  let lb = String::length(b)\n  let lim = if la < lb {\n    la\n  } else {\n    lb\n  }\n  let mut i = 0\n  let mut res = la < lb\n  let mut done = false\n  while i < lim && !done {\n    let ca = String::char_code_at(a, i)\n    let cb = String::char_code_at(b, i)\n    if ca < cb {\n      res = true\n      done = true\n    } else if ca > cb {\n      res = false\n      done = true\n    } else {\n      i = i + 1\n    }\n  }\n  res\n}\n\nexport let sort_perm_by_names: (Array[String]) -> Array[Int] = (names) -> {\n  let n = Array::length(names)\n  let mut src = Array::slice([\n    0\n  ], 0, 0)\n  let mut i = 0\n  while i < n {\n    Array::push(src, i)\n    i = i + 1\n  }\n  let mut buf = Array::slice(src, 0, n)\n  let mut width = 1\n  while width < n {\n    let mut lo = 0\n    while lo < n {\n      let mid = if lo + width < n {\n        lo + width\n      } else {\n        n\n      }\n      let hi = if lo + width + width < n {\n        lo + width + width\n      } else {\n        n\n      }\n      let mut a = lo\n      let mut b = mid\n      let mut k = lo\n      while k < hi {\n        let take_left = if a >= mid {\n          false\n        } else if b >= hi {\n          true\n        } else {\n          !str_lt(Array::get(names, Array::get(src, b)), Array::get(names, Array::get(src, a)))\n        }\n        if take_left {\n          Array::set(buf, k, Array::get(src, a))\n          a = a + 1\n        } else {\n          Array::set(buf, k, Array::get(src, b))\n          b = b + 1\n        }\n        k = k + 1\n      }\n      lo = hi\n    }\n    let tmp = src\n    src = buf\n    buf = tmp\n    width = width + width\n  }\n  src\n}\n\nexport let apply_perm_strings: (Array[String], Array[Int]) -> Array[String] = (names, perm) -> {\n  let out = Array::slice([\n    \"\"\n  ], 0, 0)\n  let mut i = 0\n  while i < Array::length(perm) {\n    Array::push(out, Array::get(names, Array::get(perm, i)))\n    i = i + 1\n  }\n  out\n}\n\nexport let sorted_names_of: (Array[String]) -> Array[String] = (names) -> {\n  apply_perm_strings(names, sort_perm_by_names(names))\n}\n\nexport let bsearch_leftmost: (Array[String], String) -> Int = (sorted, name) -> {\n  let mut lo = 0\n  let mut hi = Array::length(sorted)\n  while lo < hi {\n    let mid = (lo + hi) / 2\n    if str_lt(Array::get(sorted, mid), name) {\n      lo = mid + 1\n    } else {\n      hi = mid\n    }\n  }\n  if lo < Array::length(sorted) && Array::get(sorted, lo) == name {\n    lo\n  } else {\n    -1\n  }\n}\n")
}

