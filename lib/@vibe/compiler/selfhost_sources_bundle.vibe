6 + agg_entry)\n    Array::push(ctx.agg_local_exprs, agg_shape_expr)\n    let (rc_kind, is_borrow_ret_ext) = classify_let_value_heap(buf, value, name, local_idx, local_names, ctx)\n    if ctx.enable_rc && rc_kind > 0 {\n      let mut dbi = 0\n      while dbi < Array::length(ctx.rc_dup_names) {\n        if Array::get(ctx.rc_dup_names, dbi) == name {\n          emit_rc_dup_guarded(buf, local_idx, ctx.rc_shadow)\n        } else {\n          ()\n        }\n        dbi = dbi + 1\n      }\n    } else {\n      ()\n    }\n    let mut lb_shadow_removed = 0\n    if ctx.enable_rc {\n      let lb_arr = ctx.loop_borrowed_names\n      let lb_n = Array::length(lb_arr)\n      let mut lb_w = 0\n      let mut lb_i = 0\n      while lb_i < lb_n {\n        let e = Array::get(lb_arr, lb_i)\n        if e == name {\n          lb_shadow_removed = lb_shadow_removed + 1\n        } else {\n          Array::set(lb_arr, lb_w, e)\n          lb_w = lb_w + 1\n        }\n        lb_i = lb_i + 1\n      }\n      Array::truncate(lb_arr, lb_w)\n    } else {\n      ()\n    }\n    let lb_mark = Array::length(ctx.loop_borrowed_names)\n    let value_borrow_like = ctx.enable_rc && (expr_tag(value) == 7 || expr_tag(value) == 16) && value_has_borrowed_branch_tail(value, ctx)\n    if ctx.enable_rc && (is_borrow_ret_ext || value_borrow_like) {\n      Array::push(ctx.loop_borrowed_names, name)\n    } else {\n      ()\n    }\n    let nl2 = compile_expr(buf, body, local_names, nl, ctx, ld)\n    if ctx.enable_rc && (is_borrow_ret_ext || value_borrow_like) {\n      Array::truncate(ctx.loop_borrowed_names, lb_mark)\n    } else {\n      ()\n    }\n    let mut lb_restore_i = 0\n    while lb_restore_i < lb_shadow_removed {\n      Array::push(ctx.loop_borrowed_names, name)\n      lb_restore_i = lb_restore_i + 1\n    }\n    if ctx.enable_rc && rc_kind > 0 && array_contains_str(ctx.rc_drop_names, name) {\n      if ctx.rc_drop_func_idx >= 0 && scope_tail_proj_root(body) == name {\n        emit_local_set(buf, nl2)\n        em