"\n\n\n\n\n\n\nlet emit_mem_size_bytes: (Bytes) -> Unit = (b) -> {\n  bytebuf_push(b, 63)\n  bytebuf_push(b, 0)\n  emit_i64_extend_i32_u(b)\n  emit_i64_const(b, 65536)\n  emit_i64_mul(b)\n}\n\nlet emit_looks_like_string: (Bytes, Int) -> Unit = (b, slot) -> {\n  emit_local_get(b, slot)\n  emit_i64_const(b, 32)\n  bytebuf_push(b, 136)\n  emit_local_get(b, slot)\n  emit_i64_const(b, 4294967295)\n  emit_i64_and(b)\n  emit_i64_add(b)\n  emit_mem_size_bytes(b)\n  emit_i64_le_s(b)\n}\n\nexport let gen_eq_body: (Int) -> Bytes = (str_eq_idx) -> {\n  let b = bytebuf_new()\n  emit_local_get(b, 0)\n  emit_local_get(b, 1)\n  emit_i64_eq(b)\n  emit_if_i64(b)\n  emit_i64_const(b, 1)\n  emit_else(b)\n  emit_looks_like_string(b, 0)\n  emit_looks_like_string(b, 1)\n  bytebuf_push(b, 113)\n  emit_if_i64(b)\n  emit_local_get(b, 0)\n  emit_local_get(b, 1)\n  emit_call(b, str_eq_idx)\n  emit_else(b)\n  emit_i64_const(b, 0)\n  emit_end(b)\n  emit_end(b)\n  b\n}\n")
