let selfhost_source_75 = () -> (String, String) {
  ("lib/@vibe/compiler/codegen/expr/compile_match.vibe",
"\n\n\n\n\n\n\n\nlet emit_rc_dup_guarded_n: (Bytes, Int, Int, Bool) -> Unit = (buf, local_idx, n, rc_shadow) -> {\n  let mut k = 0\n  while k < n {\n    emit_rc_dup_guarded(buf, local_idx, rc_shadow)\n    k = k + 1\n  }\n}\n\nlet rec bind_match_pat: (Bytes, Int, Pat, Bool, Array[String], CompileCtx, Expr) -> Unit = (buf, base_local, container_pat, is_ctor_layout, local_names, ctx, body) -> {\n  let elems = if is_ctor_layout {\n    get_pctor_args(container_pat)\n  } else {\n    get_ptuple_pats(container_pat)\n  }\n  let mut i = 0\n  while i < Array::length(elems) {\n    let ep = Array::get(elems, i)\n    let off = if is_ctor_layout {\n      8 + i * 8\n    } else if ctx.enable_rc {\n      8 + i * 8\n    } else {\n      i * 8\n    }\n    let clear_tag = is_ctor_layout || ctx.enable_rc\n    if is_pbind(ep) {\n      let nm = get_pbind_name(ep)\n      let fl = Array::length(local_names)\n      emit_local_get(buf, base_local)\n      if clear_tag {\n        emit_i64_const(buf, -2)\n        emit_i64_and(buf)\n      } else {\n        ()\n      }\n      emit_i32_wrap_i64(buf)\n      emit_i64_load(buf, 3, off)\n      emit_local_set(buf, fl)\n      if ctx.enable_rc {\n        emit_rc_dup_guarded_n(buf, fl, md_consume_count(body, nm), ctx.rc_shadow)\n      } else {\n        ()\n      }\n      Array::push(local_names, nm)\n    } else if is_ptuple(ep) {\n      let sl = Array::length(local_names)\n      emit_local_get(buf, base_local)\n      if clear_tag {\n        emit_i64_const(buf, -2)\n        emit_i64_and(buf)\n      } else {\n        ()\n      }\n      emit_i32_wrap_i64(buf)\n      emit_i64_load(buf, 3, off)\n      emit_local_set(buf, sl)\n      Array::push(local_names, \"__bind_sub\")\n      bind_match_pat(buf, sl, ep, false, local_names, ctx, body)\n    } else if is_pctor(ep) {\n      let sl = Array::length(local_names)\n      emit_local_get(buf, base_local)\n      if clear_tag {\n        emit_i64_const(buf, -2)\n        emit_i64_and(buf)\n      } else {\n        ()\n      }\n      emit_i32_wrap_i64(buf)\n      emit_i64_load(buf, 3, off)\n      emit_local_set(buf, sl)\n      Array::push(local_names, \"__bind_sub\")\n      bind_match_pat(buf, sl, ep, true, local_names, ctx, body)\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n}\n\nlet find_struct_index: (CompileCtx, String) -> Int = (ctx, sname) -> {\n  let names = ctx.ctor_table.struct_names\n  let mut si = 0\n  let mut sidx = -1\n  while si < Array::length(names) {\n    if Array::get(names, si) == sname {\n      sidx = si\n      si = Array::length(names)\n    } else {\n      si = si + 1\n    }\n  }\n  sidx\n}\n\nlet field_index_in: (Array[String], String) -> Int = (fnames, field) -> {\n  let mut fi = 0\n  let mut found = -1\n  while fi < Array::length(fnames) {\n    if Array::get(fnames, fi) == field {\n      found = fi\n      fi = Array::length(fnames)\n    } else {\n      fi = fi + 1\n    }\n  }\n  found\n}\n\nlet struct_field_index: (CompileCtx, String, String) -> Int with { Error } = (ctx, sname, field) -> {\n  let sidx = find_struct_index(ctx, sname)\n  if sidx >= 0 {\n    let found = field_index_in(Array::get(ctx.ctor_table.struct_field_names, sidx), field)\n    if found < 0 {\n      throw(String::concat(String::concat(String::concat(\"unknown field `\", field), \"` in struct \"), sname))\n    } else {\n      found\n    }\n  } else {\n    let names = ctx.ctor_table.struct_names\n    let mut gsi = 0\n    let mut gfound = -1\n    while gsi < Array::length(names) {\n      let f = field_index_in(Array::get(ctx.ctor_table.struct_field_names, gsi), field)\n      if f >= 0 {\n        gfound = f\n        gsi = Array::length(names)\n      } else {\n        gsi = gsi + 1\n      }\n    }\n    if gfound < 0 {\n      throw(String::concat(\"unknown struct field in pattern: \", field))\n    } else {\n      gfound\n    }\n  }\n}\n\nlet rec bind_struct_pat: (Bytes, Int, String, Array[(String, Pat)], Array[String], CompileCtx, Expr) -> Unit with { Error } = (buf, base_local, sname, fields, local_names, ctx, body) -> {\n  let mut i = 0\n  while i < Array::length(fields) {\n    let (fname, subpat) = Array::get(fields, i)\n    let off = 8 + struct_field_index(ctx, sname, fname) * 8\n    if is_pbind(subpat) {\n      let nm = get_pbind_name(subpat)\n      let fl = Array::length(local_names)\n      emit_local_get(buf, base_local)\n      emit_i64_const(buf, -2)\n      emit_i64_and(buf)\n      emit_i32_wrap_i64(buf)\n      emit_i64_load(buf, 3, off)\n      emit_local_set(buf, fl)\n      if ctx.enable_rc {\n        emit_rc_dup_guarded_n(buf, fl, md_consume_count(body, nm), ctx.rc_shadow)\n      } else {\n        ()\n      }\n      Array::push(local_names, nm)\n    } else if is_ptuple(subpat) {\n      let sl = Array::length(local_names)\n      emit_local_get(buf, base_local)\n      emit_i64_const(buf, -2)\n      emit_i64_and(buf)\n      emit_i32_wrap_i64(buf)\n      emit_i64_load(buf, 3, off)\n      emit_local_set(buf, sl)\n      Array::push(local_names, \"__bind_sub\")\n      bind_match_pat(buf, sl, subpat, false, local_names, ctx, body)\n    } else if is_pctor(subpat) {\n      let sl = Array::length(local_names)\n      emit_local_get(buf, base_local)\n      emit_i64_const(buf, -2)\n      emit_i64_and(buf)\n      emit_i32_wrap_i64(buf)\n      emit_i64_load(buf, 3, off)\n      emit_local_set(buf, sl)\n      Array::push(local_names, \"__bind_sub\")\n      bind_match_pat(buf, sl, subpat, true, local_names, ctx, body)\n    } else {\n      match subpat {\n        PStruct(__sname, sfields) => {\n          let sl = Array::length(local_names)\n          emit_local_get(buf, base_local)\n          emit_i64_const(buf, -2)\n          emit_i64_and(buf)\n          emit_i32_wrap_i64(buf)\n          emit_i64_load(buf, 3, off)\n          emit_local_set(buf, sl)\n          Array::push(local_names, \"__bind_sub\")\n          bind_struct_pat(buf, sl, __sname, sfields, local_names, ctx, body)\n        },\n        _ => ()\n      }\n    }\n    i = i + 1\n  }\n}\n\nexport let compile_match: (Bytes, Expr, Array[String], Int, CompileCtx, Int, (Bytes, Expr, Array[String], Int, CompileCtx, Int) -> Int with { Error }) -> Int with { Error } = (buf, expr, local_names, next_local, ctx, ld, ce) -> {\n  let __match_scrutinee = get_match_scrutinee(expr)\n  let __match_arms = get_match_arms(expr)\n  let scrut_local = next_local\n  Array::push(local_names, \"__match_scrut\")\n  let nl1 = ce(buf, __match_scrutinee, local_names, next_local + 1, ctx, ld)\n  emit_local_set(buf, scrut_local)\n  let num_arms = Array::length(__match_arms)\n  let catchall_idx = find_catchall_idx(__match_arms)\n  let num_cond_arms = catchall_idx\n  let mut ai = 0\n  let mut max_nl = nl1\n  let names_len_at_match = Array::length(local_names)\n  let rec emit_pat_test: (Pat, () -> Unit) -> Unit = (sp, load_field) -> {\n    match sp {\n      POr(__l, __r) => {\n        emit_pat_test(__l, load_field)\n        emit_pat_test(__r, load_field)\n        bytebuf_push(buf, 114)\n      },\n      _ => {\n        if is_pfloat(sp) {\n          load_field()\n          if ctx.enable_rc {\n            emit_unbox_float(buf)\n          } else {\n            ()\n          }\n          emit_f64_reinterpret_i64(buf)\n          let __pfv = get_pfloat_value(sp)\n          emit_f64_const_lohi(buf, Double::to_i64_bits_lo(__pfv), Double::to_i64_bits_hi(__pfv))\n          emit_f64_eq(buf)\n        } else if is_pint(sp) {\n          load_field()\n          emit_i64_const(buf, get_pint_value(sp))\n          if ctx.enable_rc {\n            emit_i64_const(buf, 1)\n            emit_i64_shl(buf)\n          }\n          emit_i64_eq(buf)\n        } else if is_pbool(sp) {\n          load_field()\n          emit_i64_const(buf, if get_pbool_value(sp) {\n            1\n          } else {\n            0\n          })\n          if ctx.enable_rc {\n            emit_i64_const(buf, 1)\n            emit_i64_shl(buf)\n          }\n          emit_i64_eq(buf)\n        } else if is_pstring(sp) {\n          let __sv = get_pstring_value(sp)\n          let __si = str_table_lookup(ctx.str_table.strs, __sv)\n          if __si >= 0 {\n            let (__seq_fi, _, _) = resolve_func(ctx.func_table, \"eq\")\n            load_field()\n            emit_str_ref(buf, Array::get(ctx.str_table.offsets, __si), Array::get(ctx.str_table.lengths, __si))\n            emit_call(buf, __seq_fi)\n            emit_i32_wrap_i64(buf)\n          } else {\n            emit_i32_const(buf, 1)\n          }\n        } else if is_pctor(sp) {\n          let __ncname = get_pctor_name(sp)\n          let __nci = ctor_table_index_of(ctx.ctor_table, __ncname)\n          let __ntag = if __nci >= 0 {\n            Array::get(ctx.ctor_table.tags, __nci)\n          } else {\n            -1\n          }\n          load_field()\n          emit_i64_const(buf, -2)\n          emit_i64_and(buf)\n          emit_i32_wrap_i64(buf)\n          emit_i32_load(buf, 2, 0)\n          emit_i32_const(buf, __ntag)\n          emit_i32_eq(buf)\n          let __nargs = get_pctor_args(sp)\n          let mut __nany = false\n          let mut __nj = 0\n          while __nj < Array::length(__nargs) {\n            let __np = Array::get(__nargs, __nj)\n            if is_pbind(__np) || is_pwild(__np) {\n              ()\n            } else {\n              __nany = true\n            }\n            __nj = __nj + 1\n          }\n          if __nany {\n            bytebuf_push(buf, 4)\n            bytebuf_push(buf, 127)\n            emit_i32_const(buf, 1)\n            let mut __nk = 0\n            while __nk < Array::length(__nargs) {\n              let __nkk = __nk\n              let __np2 = Array::get(__nargs, __nkk)\n              if is_pbind(__np2) || is_pwild(__np2) {\n                ()\n              } else {\n                let __nload: () -> Unit = () -> {\n                  load_field()\n                  emit_i64_const(buf, -2)\n                  emit_i64_and(buf)\n                  emit_i32_wrap_i64(buf)\n                  emit_i64_load(buf, 3, 8 + __nkk * 8)\n                }\n                emit_pat_test(__np2, __nload)\n                bytebuf_push(buf, 113)\n              }\n              __nk = __nk + 1\n            }\n            emit_else(buf)\n            emit_i32_const(buf, 0)\n            emit_end(buf)\n          } else {\n            ()\n          }\n        } else if is_ptuple(sp) {\n          emit_i32_const(buf, 1)\n          let __tpats = get_ptuple_pats(sp)\n          let mut __tk = 0\n          while __tk < Array::length(__tpats) {\n            let __tkk = __tk\n            let __tload: () -> Unit = () -> {\n              load_field()\n              if ctx.enable_rc {\n                emit_i64_const(buf, -2)\n                emit_i64_and(buf)\n              }\n              emit_i32_wrap_i64(buf)\n              emit_i64_load(buf, 3, if ctx.enable_rc {\n                8 + __tkk * 8\n              } else {\n                __tkk * 8\n              })\n            }\n            emit_pat_test(Array::get(__tpats, __tkk), __tload)\n            bytebuf_push(buf, 113)\n            __tk = __tk + 1\n          }\n        } else {\n          emit_i32_const(buf, 1)\n        }\n      }\n    }\n  }\n  let emit_sub_tests: (Pat, () -> Unit) -> Unit = (sp, load_field) -> {\n    if is_pbind(sp) || is_pwild(sp) {\n      ()\n    } else {\n      emit_pat_test(sp, load_field)\n      bytebuf_push(buf, 113)\n    }\n  }\n  while ai < num_cond_arms {\n    Array::truncate(local_names, names_len_at_match)\n    int_log_reset_above(ctx, names_len_at_match)\n    agg_log_reset_above2(ctx.agg_local_slots, ctx.agg_local_exprs, names_len_at_match)\n    let (__cond_p, __arm_body) = Array::get(__match_arms, ai)\n    let __cond_done = if is_pfloat(__cond_p) {\n      emit_local_get(buf, scrut_local)\n      if ctx.enable_rc {\n        emit_unbox_float(buf)\n      } else {\n        ()\n      }\n      emit_f64_reinterpret_i64(buf)\n      let __apfv = get_pfloat_value(__cond_p)\n      emit_f64_const_lohi(buf, Double::to_i64_bits_lo(__apfv),