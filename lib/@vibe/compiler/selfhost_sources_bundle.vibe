  ("lib/@vibe/compiler/codegen/expr/compile_expr_tail.vibe",
"\n\n\n\n\n\n\n\n\n\n\nlet emit_assignop_rc_tag_fix: (Bytes, Bool, String) -> Unit = (buf, enable_rc, op) -> {\n  if enable_rc && op == \"*\" {\n    emit_i64_const(buf, 1)\n    emit_i64_shr_s(buf)\n  } else if enable_rc && op == \"/\" {\n    emit_i64_const(buf, 1)\n    emit_i64_shl(buf)\n  } else {\n    ()\n  }\n}\n\n\nlet emit_dbg_line_for: (Bytes, Expr, CompileCtx) -> Unit = (buf, value, ctx) -> {\n  emit_dbg_line_stmt(buf, value, -1, ctx)\n}\n\nlet emit_dbg_line_stmt: (Bytes, Expr, Int, CompileCtx) -> Unit = (buf, value, stmt_off, ctx) -> {\n  if ctx.dbg_line_idx >= 0 {\n    let voff = first_offset(value)\n    let off = if voff >= 0 { voff } else { stmt_off }\n    if off >= 0 {\n      let line = offset_to_line(ctx.dbg_line_nl, off)\n      emit_i32_const(buf, ctx.dbg_line_file_id)\n      emit_i32_const(buf, line)\n      emit_call(buf, ctx.dbg_line_idx)\n    } else {\n      ()\n    }\n  } else {\n    ()\n  }\n}\n\nlet is_edot: (Expr) -> Bool = (e) -> {\n  match e {\n    EDot(_, _, _, _) => true,\n    _ => false\n  }\n}\n\nlet efn_is_capturing: (Expr, CompileCtx) -> Bool with { Error } = (value, ctx) -> {\n  let params = get_efn_params(value)\n  let pnames = Array::slice([\n    \"\"\n  ], 0, 0)\n  let mut pi = 0\n  while pi < Array::length(params) {\n    let (pn, _) = Array::get(params, pi)\n    Array::push(pnames, pn)\n    pi = pi + 1\n  }\n  let caps = collect_free_vars_indexed(get_efn_body(value), pnames, ctx.capture_name_index)\n  Array::length(caps) > 0\n}\n\nlet slot_is_floatish: (CompileCtx, Int) -> Bool = (ctx, slot) -> {\n  let arr = ctx.float_local_slots\n  let mut j = Array::length(arr) - 1\n  let mut result = false\n  while j >= 0 {\n    let entry = Array::get(arr, j)\n    if entry / 2 == slot {\n      result = (entry % 2) == 1\n      j = -1\n    } else {\n      j = j - 1\n    }\n  }\n  result\n}\n\nlet slot_is_intish: (CompileCtx, Int) -> Bool = (ctx, slot) -> {\n  let arr = ctx.int_local_slots\n  let mut j = Array::length(arr) - 1\n  let mut result = false\n  while j >= 0 {\n    let entry = Array::get(arr, j)\n    if entry / 4 == slot {\n      result = (entry % 2) == 1\n      j = -1\n    } else {\n      j = j - 1\n    }\n  }\n  result\n}\n\nlet slot_is_boolish: (CompileCtx, Int) -> Bool = (ctx, slot) -> {\n  let arr = ctx.int_local_slots\n  let mut j = Array::length(arr) - 1\n  let mut result = false\n  while j >= 0 {\n    let entry = Array::get(arr, j)\n    if entry / 4 == slot {\n      result = (entry % 4) == 3\n      j = -1\n    } else {\n      j = j - 1\n    }\n  }\n  result\n}\n\nexport let rec expr_is_boolish: (Expr, Array[String], CompileCtx) -> Bool with { Error } = (e, local_names, ctx) -> {\n  let tag = expr_tag(e)\n  if tag == 1 {\n    true\n  } else if tag == 4 {\n    let nm = get_eident_name(e)\n    let mut i = Array::length(local_names) - 1\n    let mut slot = -1\n    while i >= 0 {\n      if Array::get(local_names, i) == nm {\n        slot = i\n        i = -1\n      } else {\n        i = i - 1\n      }\n    }\n    if slot >= 0 {\n      slot_is_boolish(ctx, slot)\n    } else {\n      false\n    }\n  } else if tag == 5 {\n    let op = get_ebinop_op(e)\n    op == \"==\" || op == \"!=\" || op == \"<\" || op == \">\" || op == \"<=\" || op == \">=\" || op == \"&&\" || op == \"||\"\n  } else if tag == 6 {\n    get_eunaryop_op(e) == \"!\"\n  } else if tag == 16 {\n    let arms = get_match_arms(e)\n    let alen2 = Array::length(arms)\n    if alen2 == 0 {\n      false\n    } else {\n      let mut all_bool = true\n      let mut bi2 = 0\n      while bi2 < alen2 {\n        if expr_tag(get_arm_body(Array::get(arms, bi2))) != 1 {\n          all_bool = false\n        } else {\n          ()\n        }\n        bi2 = bi2 + 1\n      }\n      all_bool\n    }\n  } else if tag == 8 {\n    let bcallee = get_ecall_callee(e)\n    if is_eident(bcallee) {\n      let bcn = get_eident_name(bcallee)\n      String::starts_with(bcn, \"__arr_equals__\") || (String::ends_with(bcn, \"::equals\") && Array::length(get_ecall_args(e)) == 2)\n    } else {\n      false\n    }\n  } else {\n    false\n  }\n}\n\nexport let rec expr_is_floatish: (Expr, Array[String], CompileCtx) -> Bool with { Error } = (e, local_names, ctx) -> {\n  let dot_float = match e {\n    EDot(dobj, dfield, _, _) => {\n      let fc = String::char_code_at(dfield, 0)\n      if fc >= 48 && fc <= 57 && is_eident(dobj) {\n        let slot = find_local_slot(local_names, get_eident_name(dobj))\n        if slot >= 0 {\n          let info = agg_slot_lookup(ctx.agg_local_slots, slot)\n          if info >= 0 && info / 64 == 1 {\n            let backing = agg_expr_lookup(ctx.agg_local_slots, ctx.agg_local_exprs, slot)\n            if is_etuple(backing) {\n              let elems = get_etuple_elems(backing)\n              let mut k = 0\n              let mut fp = 0\n              while fp < String::length(dfield) {\n                k = k * 10 + (String::char_code_at(dfield, fp) - 48)\n                fp = fp + 1\n              }\n              if k >= 0 && k < Array::length(elems) {\n                expr_is_floatish(Array::get(elems, k), local_names, ctx)\n              } else {\n                false\n              }\n            } else {\n              false\n            }\n          } else {\n            false\n          }\n        } else {\n          false\n        }\n      } else {\n        false\n      }\n    },\n    _ => false\n  }\n  let tag = expr_tag(e)\n  if dot_float {\n    true\n  } else if tag == 2 {\n    true\n  } else if tag == 4 {\n    let nm = get_eident_name(e)\n    let len = Array::length(local_names)\n    let mut i = len - 1\n    let mut slot = -1\n    while i >= 0 {\n      if Array::get(local_names, i) == nm {\n        slot = i\n        i = -1\n      } else {\n        i = i - 1\n      }\n    }\n    if slot >= 0 {\n      slot_is_floatish(ctx, slot)\n    } else {\n      false\n    }\n  } else if tag == 5 {\n    let op = get_ebinop_op(e)\n    if op == \"+\" || op == \"-\" || op == \"*\" || op == \"/\" {\n      expr_is_floatish(get_ebinop_lhs(e), local_names, ctx) || expr_is_floatish(get_ebinop_rhs(e), local_names, ctx)\n    } else {\n      false\n    }\n  } else if tag == 6 {\n    let op = get_eunaryop_op(e)\n    if op == \"-\" {\n      expr_is_floatish(get_eunaryop_expr(e), local_names, ctx)\n    } else {\n      false\n    }\n  } else if tag == 8 {\n    let callee = get_ecall_callee(e)\n    if is_eident(callee) {\n      let fname = get_eident_name(callee)\n      if fname == \"Int::to_double\" || fname == \"Int::to_float\" || fname == \"Float::to_double\" || fname == \"Double::to_float\" || fname == \"Double::from_i64_bits\" {\n        true\n      } else if fname == \"__rec_field\" {\n        let args = get_ecall_args(e)\n        if Array::length(args) == 2 && is_eident(Array::get(args, 0)) && expr_tag(Array::get(args, 1)) == 0 {\n          let slot = find_local_slot(local_names, get_eident_name(Array::get(args, 0)))\n          if slot >= 0 {\n            let info = agg_slot_lookup(ctx.agg_local_slots, slot)\n            if info >= 0 && info / 64 == 1 {\n              let backing = agg_expr_lookup(ctx.agg_local_slots, ctx.agg_local_exprs, slot)\n              if is_etuple(backing) {\n                let elems = get_etuple_elems(backing)\n                let k = get_eint_value(Array::get(args, 1))\n                if k >= 0 && k < Array::length(elems) {\n                  expr_is_floatish(Array::get(elems, k), local_names, ctx)\n                } else {\n                  false\n                }\n              } else {\n                false\n              }\n            } else {\n              false\n            }\n          } else {\n            false\n          }\n        } else {\n          false\n        }\n      } else {\n        false\n      }\n    } else {\n      false\n    }\n  } else {\n    false\n  }\n}\n\nexport let expr_is_intish: (Expr, Array[String], CompileCtx) -> Bool with { Error } = (e, local_names, ctx) -> {\n  let tag = expr_tag(e)\n  if tag == 0 {\n    true\n  } else if tag == 1 {\n    true\n  } else if tag == 4 {\n    let nm = get_eident_name(e)\n    let len = Array::length(local_names)\n    let mut i = len - 1\n    let mut slot = -1\n    while i >= 0 {\n      if Array::get(local_names, i) == nm {\n        slot = i\n        i = -1\n      } else {\n        i = i - 1\n      }\n    }\n    if slot >= 0 {\n      slot_is_intish(ctx, slot)\n    } else {\n      false\n    }\n  } else if tag == 5 {\n    let op = get_ebinop_op(e)\n    if op == \"&\" || op == \"|\" || op == \"^\" || op == \"<<\" || op == \">>\" || op == \"%\" || op == \"<\" || op == \">\" || op == \"<=\" || op == \">=\" || op == \"==\" || op == \"!=\" || op == \"&&\" || op == \"||\" {\n      true\n    } else if op == \"+\" || op == \"-\" || op == \"*\" || op == \"/\" {\n      !expr_is_floatish(e, local_names, ctx)\n    } else {\n      false\n    }\n  } else if tag == 6 {\n    let op = get_eunaryop_op(e)\n    op == \"!\"\n  } else {\n    false\n  }\n}\n\n\nlet assign_value_mentions: (Expr, String) -> Bool = (value, name) -> {\n  let empty1 = Array::slice([\n    \"\"\n  ], 0, 0)\n  let empty2 = Array::slice([\n    \"\"\n  ], 0, 0)\n  array_contains_str(collect_free_vars(value, empty1, empty2), name)\n}\n\nlet rec reassign_carry_safe: (Expr, String) -> Bool = (e, name) -> {\n  if !assign_value_mentions(e, name) {\n    true\n  } else {\n    match e {\n      EIdent(_, _) => true,\n      EDot(_, _, _, _) => proj_root_ident(e) == name,\n      EBinOp(_, l, r) => reassign_carry_safe(l, name) && reassign_carry_safe(r, name),\n      EUnaryOp(_, x) => reassign_carry_safe(x, name),\n      _ => false\n    }\n  }\n}\n\nlet emit_rc_value_ptr_i32: (Bytes, Int, Bool) -> Unit = (buf, local_idx, tagged) -> {\n  emit_local_get(buf, local_idx)\n  if tagged {\n    emit_i64_const(buf, -2)\n    emit_i64_and(buf)\n  } else {\n    ()\n  }\n  emit_i32_wrap_i64(buf)\n}\n\nlet emit_rc_drop_local: (Bytes, Int, Bool) -> Unit = (buf, local_idx, tagged) -> {\n  emit_rc_value_ptr_i32(buf, local_idx, tagged)\n  emit_i32_const(buf, 4)\n  emit_i32_sub(buf)\n  emit_i32_load(buf, 2, 0)\n  emit_i32_const(buf, 16777215)\n  bytebuf_push(buf, 113)\n  emit_i32_const(buf, 16777215)\n  emit_i32_ne(buf)\n  emit_if_void(buf)\n  emit_rc_value_ptr_i32(buf, local_idx, tagged)\n  emit_i32_const(buf, 4)\n  emit_i32_sub(buf)\n  emit_rc_value_ptr_i32(buf, local_idx, tagged)\n  emit_i32_const(buf, 4)\n  emit_i32_sub(buf)\n  emit_i32_load(buf, 2, 0)\n  emit_i32_const(buf, 1)\n  emit_i32_sub(buf)\n  emit_i32_store(buf, 2, 0)\n  emit_rc_value_ptr_i32(buf, local_idx, tagged)\n  emit_i32_const(buf, 4)\n  emit_i32_sub(buf)\n  emit_i32_load(buf, 2, 0)\n  emit_i32_const(buf, 256)\n  emit_i32_mul(buf)\n  emit_i32_eqz(buf)\n  emit_if_void(buf)\n  emit_rc_value_ptr_i32(buf, local_idx, tagged)\n  emit_i32_const(buf, 4)\n  emit_i32_sub(buf)\n  emit_global_get(buf, 2)\n  emit_i32_store(buf, 2, 0)\n  emit_rc_value_ptr_i32(buf, local_idx, tagged)\n  emit_global_set(buf, 2)\n  emit_end(buf)\n  emit_end(buf)\n}\n\nlet reassign_self_reusable: (Expr, String) -> Bool with { Error } = (value, name) -> {\n  if is_etuple(value) {\n    let elems = get_etuple_elems(value)\n    let mut i = 0\n    let mut ok = true\n    while i < Array::length(elems) {\n      if !reassign_carry_safe(Array::get(elems, i), name) {\n        ok = false\n      } else {\n        ()\n      }\n      i = i + 1\n    }\n    ok\n  } else {\n    false\n  }\n}\n\nlet classify_let_value_heap: (Bytes, Expr, String, Int, Array[String], CompileCtx) -> (Int, Bool) with { Error } = (buf, value, name, local_idx, local_names, ctx) -> {\n  let mut rc_kind = 0\n  let mut is_borrow_ret_ext = false\n  if ctx.enable_rc {\n    if expr_is_floatish(value, local_names, ctx) {\n      rc_kind = 2\n      Array::push(ctx.heap_binding_names, name)\n    } else if is_etuple(value) {\n      rc_kind = 2\n      Array::push(ctx.heap_binding_names, name)\n    } else if is_earray(value) {\n      rc_kind = 2\n      Array::push(ctx.heap_binding_names, name)\n    } else if is_erecord(value) {\n      rc_kind = 2\n      Array::push(ctx.heap_binding_names, name)\n    } else if is_ctor_call(value, ctx.ctor_table) {\n      rc_kind = 2\n      Array::push(ctx.heap_binding_names, name)\n    } else if is_nullary_ctor_ident(value, ctx.ctor_table) {\n      rc_kind = 2\n      Array::push(ctx.heap_binding_names, name)\n    } else if is_eident(value) {\n      let src = get_eident_name(value)\n      if array_contains_str(ctx.heap_binding_names, src) {\n        rc_kind = 2\n        Array::push(ctx.heap_binding_names, name)\n        if array_contains_str(ctx.rc_alias_dup_names, name) {\n          emit_rc_dup_guarded(buf, local_idx, ctx.rc_shadow)\n        } else {\n          ()\n        }\n      } else {\n        ()\n      }\n    } else if expr_tag(value) == 8 {\n      let callee = get_ecall_callee(value)\n      let is_borrow_ret = if is_eident(callee) {\n        let cn = get_eident_name(callee)\n        cn == \"Array::get\" || cn == \"__index\" || cn == \"Map::get\" || cn == \"__rec_field\" || array_contains_str(ctx.borrow_ret_names, cn)\n      } else {\n        false\n      }\n      let is_declared_heap_ret = if is_eident(callee) {\n        array_contains_str(ctx.heap_ret_names, get_eident_name(callee))\n      } else {\n        false\n      }\n      let is_builtin_scalar_ret = if is_eident(callee) {\n        let cn = get_eident_name(callee)\n        let is_always_registered = cn == \"Array::length\" || cn == \"Bytes::length\" || cn == \"String::length\" || cn == \"eq\"\n        let is_user_shadowed = !is_always_registered && array_contains_str(ctx.func_table.names, cn)\n        !is_user_shadowed && (cn == \"Array::length\" || cn == \"Bytes::length\" || cn == \"String::length\" || cn == \"Map::has_key\" || cn == \"Array::contains\" || cn == \"eq\" || cn == \"not\" || cn == \"add\" || cn == \"sub\" || cn == \"mul\" || cn == \"lt\")\n      } else {\n        false\n      }\n      let is_scalar_ret = if is_eident(callee) {\n        array_contains_str(ctx.scalar_ret_names, get_eident_name(callee)) || is_builtin_scalar_ret\n      } else {\n        false\n      }\n      if is_borrow_ret || is_scalar_ret {\n        ()\n      } else if is_declared_heap_ret {\n        rc_kind = 2\n        Array::push(ctx.heap_binding_names, name)\n      } else {\n        rc_kind = 2\n        Array::push(ctx.heap_binding_names, name)\n      }\n      is_borrow_ret_ext = is_borrow_ret\n    } else if is_edot(value) {\n      rc_kind = 2\n      Array::push(ctx.heap_binding_names, name)\n      emit_rc_dup_guarded(buf, local_idx, ctx.rc_shadow)\n    } else if is_efn(value) {\n      if efn_is_capturing(value, ctx) {\n        rc_kind = 2\n        Array::push(ctx.heap_binding_names, name)\n      } else {\n        ()\n      }\n    } else if expr_tag(value) == 7 {\n      rc_kind = 2\n      Array::push(ctx.heap_binding_names, name)\n    } else if expr_tag(value) == 16 {\n      rc_kind = 2\n      Array::push(ctx.heap_binding_names, name)\n    } else if expr_tag(value) == 9 || expr_tag(value) == 14 {\n      rc_kind = 2\n      Array::push(ctx.heap_binding_names, name)\n    } else {\n      let __sf_tag = expr_tag(value)\n      if is_eident(value) || __sf_tag == 0 || __sf_tag == 1 || __sf_tag == 2 || __sf_tag == 3 || __sf_tag == 22 {\n        ()\n      } else {\n        rc_kind = 2\n        Array::push(ctx.heap_binding_names, name)\n      }\n    }\n  } else {\n    ()\n  }\n  (rc_kind, is_borrow_ret_ext)\n}\n\nlet rec retain_wrap_branch_tails: (Expr, CompileCtx) -> Expr with { Error } = (e, ctx) -> {\n  match e {\n    EIdent(x, p) => if array_contains_str(ctx.loop_borrowed_names, x) && !array_contains_str(ctx.ref_cell_names, x) {\n      ECall(EIdent(\"__loop_tail_retain\", -1), [\n        EIdent(x, p)\n      ], -1)\n    } else {\n      e\n    },\n    EDot(_, _, _, _) => {\n      let root = proj_root_ident(e)\n      if String::length(root) > 0 && array_contains_str(ctx.loop_borrowed_names, root) && !array_contains_str(ctx.ref_cell_names, root) {\n        ECall(EIdent(\"__loop_tail_retain\", -1), [\n          e\n        ], -1)\n      } else {\n        e\n      }\n    },\n    EIf(c, t, el) => EIf(c, retain_wrap_branch_tails(t, ctx), retain_wrap_branch_tails(el, ctx)),\n    EMatch(scrut, arms) => {\n      if Array::length(arms) == 0 {\n        e\n      } else {\n        let out = Array::slice([\n          Array::get(arms, 0)\n        ], 0, 0)\n        let mut ai = 0\n        while ai < Array::length(arms) {\n          let (apat, abody) = Array::get(arms, ai)\n          Array::push(out, (apat, retain_wrap_branch_tails(abody, ctx)))\n          ai = ai + 1\n        }\n        EMatch(scrut, out)\n      }\n    },\n    ELet(n, v, b, soff) => ELet(n, v, retain_wrap_branch_tails(b, ctx), soff),\n    ELetMut(n, v, b, soff) => ELetMut(n, v, retain_wrap_branch_tails(b, ctx), soff),\n    ESeq(a, b) => ESeq(a, retain_wrap_branch_tails(b, ctx)),\n    EAssign(n, v, b) => EAssign(n, v, retain_wrap_branch_tails(b, ctx)),\n    EAssignOp(o, n, v, b) => EAssignOp(o, n, v, retain_wrap_branch_tails(b, ctx)),\n    _ => e\n  }\n}\n\nlet rec value_has_borrowed_branch_tail: (Expr, CompileCtx) -> Bool = (e, ctx) -> {\n  match e {\n    EIdent(x, _) => array_contains_str(ctx.loop_borrowed_names, x) && !array_contains_str(ctx.ref_cell_names, x),\n    EDot(_, _, _, _) => true,\n    ECall(callee, _, _) => match callee {\n      EIdent(cn, _) => cn == \"Array::get\" || cn == \"__index\" || cn == \"Map::get\" || cn == \"__rec_field\" || array_contains_str(ctx.borrow_ret_names, cn),\n      _ => false\n    },\n    EIf(_, t, el) => value_has_borrowed_branch_tail(t, ctx) || value_has_borrowed_branch_tail(el, ctx),\n    EMatch(_, arms) => {\n      let mut found = false\n      let mut ai = 0\n      while ai < Array::length(arms) {\n        let (_, abody) = Array::get(arms, ai)\n        if value_has_borrowed_branch_tail(abody, ctx) {\n          found = true\n          ai = Array::length(arms)\n        } else {\n          ai = ai + 1\n        }\n      }\n      found\n    },\n    ELet(_, _, b, _) => value_has_borrowed_branch_tail(b, ctx),\n    ELetMut(_, _, b, _) => value_has_borrowed_branch_tail(b, ctx),\n    ESeq(_, b) => value_has_borrowed_branch_tail(b, ctx),\n    EAssign(_, _, b) => value_has_borrowed_branch_tail(b, ctx),\n    EAssignOp(_, _, _, b) => value_has_borrowed_branch_tail(b, ctx),\n    _ => false\n  }\n}\n\nlet retain_wrap_let_value: (Expr, String, CompileCtx) -> Expr with { Error } = (value, name, ctx) -> {\n  if ctx.enable_rc && (expr_tag(value) == 7 || expr_tag(value) == 16) && Array::length(ctx.loop_borrowed_names) > 0 && array_contains_str(ctx.rc_drop_names, name) {\n    retain_wrap_branch_tails(value, ctx)\n  } else {\n    value\n  }\n}\n\nexport let compile_expr_tail: (Bytes, Expr, Array[String], Int, CompileCtx, Int, (Bytes, Expr, Array[String], Int, CompileCtx, Int) -> Int with { Error }) -> Int with { Error } = (buf, expr, local_names, next_local, ctx, ld, compile_expr) -> {\n  let __tag = expr_tag(expr)\n  if __tag == 9 {\n    let name = get_elet_name(expr)\n    let value = get_elet_val(expr)\n    let body = get_elet_body(expr)\n    let local_idx = next_local\n    emit_dbg_line_stmt(buf, value, get_elet_off(expr), ctx)\n    Array::push(local_names, name)\n    let nl = compile_expr(buf, retain_wrap_let_value(value, name, ctx), local_names, next_local + 1, ctx, ld)\n    emit_local_set(buf, local_idx)\n    let val_is_float = expr_is_floatish(value, local_names, ctx)\n    if val_is_float {\n      Array::push(ctx.float_local_slots, local_idx * 2 + 1)\n    } else if slot_is_floatish(ctx, local_idx) {\n      Array::push(ctx.float_local_slots, local_idx * 2)\n    }\n    if expr_is_boolish(value, local_names, ctx) {\n      Array::push(ctx.int_local_slots, local_idx * 4 + 3)\n    } else if expr_is_intish(value, local_names, ctx) {\n      Array::push(ctx.int_local_slots, local_idx * 4 + 1)\n    } else if slot_is_intish(ctx, local_idx) {\n      Array::push(ctx.int_local_slots, local_idx * 4)\n    }\n    let agg