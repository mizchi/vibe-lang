"\n\n\n\nlet async_no_params: () -> Array[Type] = () -> {\n  Array::slice([\n    CtUnknown\n  ], 0, 0)\n}\n\nlet lookup_future: (String) -> Option[Type] = (name) -> {\n  if name == \"await\" {\n    Some(CtFn([\n      CtNamed(\"Future\", [\n        CtUnknown\n      ])\n    ], CtUnknown, Some(\"Async\")))\n  } else if name == \"Future::ready\" {\n    Some(CtFn([\n      CtUnknown\n    ], CtNamed(\"Future\", [\n      CtUnknown\n    ]), None))\n  } else {\n    None\n  }\n}\n\nlet lookup_stream: (String) -> Option[Type] = (name) -> {\n  if name == \"Stream::empty\" {\n    Some(CtFn(async_no_params(), CtNamed(\"Stream\", [\n      CtUnknown\n    ]), None))\n  } else if name == \"Stream::once\" {\n    Some(CtFn([\n      CtUnknown\n    ], CtNamed(\"Stream\", [\n      CtUnknown\n    ]), None))\n  } else if name == \"Stream::next\" {\n    Some(CtFn([\n      CtNamed(\"Stream\", [\n        CtUnknown\n      ])\n    ], CtNamed(\"Future\", [\n      CtOption(CtUnknown)\n    ]), Some(\"Async\")))\n  } else if name == \"Stream::map\" {\n    Some(CtFn([\n      CtNamed(\"Stream\", [\n        CtUnknown\n      ]),\n      CtUnknown\n    ], CtNamed(\"Stream\", [\n      CtUnknown\n    ]), None))\n  } else if name == \"Stream::filter\" {\n    Some(CtFn([\n      CtNamed(\"Stream\", [\n        CtUnknown\n      ]),\n      CtUnknown\n    ], CtNamed(\"Stream\", [\n      CtUnknown\n    ]), None))\n  } else if name == \"Stream::fold\" {\n    Some(CtFn([\n      CtNamed(\"Stream\", [\n        CtUnknown\n      ]),\n      CtUnknown,\n      CtUnknown\n    ], CtNamed(\"Future\", [\n      CtUnknown\n    ]), Some(\"Async\")))\n  } else {\n    None\n  }\n}\n\nlet lookup_concurrency: (String) -> Option[Type] = (name) -> {\n  if name == \"Task::spawn\" {\n    Some(CtFn([\n      CtUnknown\n    ], CtNamed(\"Task\", [\n      CtUnknown\n    ]), Some(\"Async\")))\n  } else if name == \"Task::join\" {\n    Some(CtFn([\n      CtNamed(\"Task\", [\n        CtUnknown\n      ])\n    ], CtUnknown, Some(\"Async\")))\n  } else if name == \"Task::cancel\" {\n    Some(CtFn([\n      CtNamed(\"Task\", [\n        CtUnknown\n      ])\n    ], CtUnit, Some(\"Async\")))\n  } else if name == \"Task::race\" {\n    Some(CtFn([\n      CtNamed(\"Task\", [\n        CtUnknown\n      ]),\n      CtNamed(\"Task\", [\n        CtUnknown\n      ])\n    ], CtUnknown, Some(\"Async\")))\n  } else if name == \"Task::timeout\" {\n    Some(CtFn([\n      CtInt,\n      CtUnknown\n    ], CtOption(CtUnknown), Some(\"Async\")))\n  } else {\n    None\n  }\n}\n\nlet lookup_bytestream: (String) -> Option[Type] = (name) -> {\n  if name == \"String::to_bytes\" {\n    Some(CtFn([\n      CtString\n    ], CtNamed(\"Stream\", [\n      CtInt\n    ]), None))\n  } else if name == \"Stream::to_string\" {\n    Some(CtFn([\n      CtNamed(\"Stream\", [\n        CtInt\n      ])\n    ], CtString, None))\n  } else {\n    None\n  }\n}\n\nexport let lookup_async: (String) -> Option[Type] = (name) -> {\n  match lookup_future(name) {\n    Some(t) => Some(t),\n    None => match lookup_stream(name) {\n      Some(t) => Some(t),\n      None => match lookup_concurrency(name) {\n        Some(t) => Some(t),\n        None => lookup_bytestream(name)\n      }\n    }\n  }\n}\n")
}

let selfhost_source_48 = () -> (String, String) {
  ("lib/@vibe/compiler/checker/checker_resolve.vibe",
"\n\n\n\nexport let rec subst_type_params: (Type, Array[String], Array[Type]) -> Type = (ty, params, args) -> {\n  match ty {\n    CtNamed(name, targs) => {\n      let mut idx = 0 - 1\n      let mut i = 0\n      while i < Array::length(params) {\n        if Array::get(params, i) == name {\n          idx = i\n        }\n        i = i + 1\n      }\n      if idx >= 0 && idx < Array::length(args) {\n        Array::get(args, idx)\n      } else {\n        CtNamed(name, for a in targs {\n          subst_type_params(a, params, args)\n        })\n      }\n    },\n    CtArray(e) => CtArray(subst_type_params(e, params, args)),\n    CtOption(e) => CtOption(subst_type_params(e, params, args)),\n    CtTuple(es) => CtTuple(for e in es {\n      subst_type_params(e, params, args)\n    }),\n    CtFn(ps, ret, eff) => {\n      let subst_params: (Array[Type]) -> Array[Type] = (types) -> {\n        let out = Array::slice([\n          CtUnknown\n        ], 0, 0)\n        let mut i = 0\n        while i < Array::length(types) {\n          Array::push(out, subst_type_params(Array::get(types, i), params, args))\n          i = i + 1\n        }\n        out\n      }\n      CtFn(subst_params(ps), subst_type_params(ret, params, args), eff)\n    },\n    _ => ty\n  }\n}\n\nexport let rec resolve_type_expr: (TypeExpr, Array[TypeDef]) -> Type = (te, defs) -> {\n  match te {\n    TyUnit => CtUnit,\n    TyName(name) => match resolve_builtin(name) {\n      Some(t) => t,\n      None => match find_typedef(defs, name) {\n        Some(td) => match td {\n          TDEnum(n, _, _) => CtEnum(n),\n          TDStruct(n, _, _) => CtStruct(n),\n          TDAlias(_, _, t) => t,\n          TDEffect(_, _) => CtNamed(name, Array::slice([\n            CtUnknown\n          ], 0, 0))\n        },\n        None => CtNamed(name, Array::slice([\n          CtUnknown\n        ], 0, 0))\n      }\n    },\n    TyApp(name, args) => {\n      let ra = for a in args {\n        resolve_type_expr(a, defs)\n      }\n      if name == \"Array\" {\n        if Array::length(ra) == 1 {\n          CtArray(Array::get(ra, 0))\n        }\n        else CtNamed(name, ra)\n      } else if name == \"Option\" {\n        if Array::length(ra) == 1 {\n          CtOption(Array::get(ra, 0))\n        }\n        else CtNamed(name, ra)\n      } else {\n        match find_typedef(defs, name) {\n          Some(td) => match td {\n            TDAlias(_, params, body) => subst_type_params(body, params, ra),\n            _ => CtNamed(name, ra)\n          },\n          None => CtNamed(name, ra)\n        }\n      }\n    },\n    TyTuple(elems) => {\n      let r = for e in elems {\n        resolve_type_expr(e, defs)\n      }\n      CtTuple(r)\n    },\n    TyFn(params, ret, effect_name) => {\n      let ret_box = Array::slice([\n        ret\n      ], 0, 1)\n      let rp = for p in params {\n        resolve_type_expr(p, defs)\n      }\n      CtFn(rp, resolve_type_expr(Array::get(ret_box, 0), defs), effect_name)\n    }\n  }\n}\n")
}

let selfhost_source_49 = () -> (String, String) {
  ("lib/@vibe/compiler/checker/checker_pattern.vibe",
"\n\n\n\nlet find_ctor_in_defs: (Array[TypeDef], String) -> Option[(String, Array[Type])] = (defs, ctor_name) -> {\n  let dlen = Array::length(defs)\n  let rec go_defs: (Int) -> Option[(String, Array[Type])] = (di) -> {\n    if di >= dlen {\n      None\n    } else {\n      let d = Array::get(defs, di)\n      match d {\n        TDEnum(enum_name, _, variants) => {\n          let vlen = Array::length(variants)\n          let rec go_variants: (Int) -> Option[(String, Array[Type])] = (vi) -> {\n            if vi >= vlen {\n              go_defs(di + 1)\n            } else {\n              let (vname, vtypes) = Array::get(variants, vi)\n              if vname == ctor_name {\n                Some((enum_name, vtypes))\n              } else {\n                go_variants(vi + 1)\n              }\n            }\n          }\n          go_variants(0)\n        },\n        _ => go_defs(di + 1)\n      }\n    }\n  }\n  go_defs(0)\n}\n\nexport let rec check_pattern: (Pat, Type, TypeEnv, Array[TypeDef], Array[String]) -> TypeEnv = (pat: Pat, scrutinee_ty: Type, env: TypeEnv, defs: Array[TypeDef], errors: Array[String]) -> TypeEnv {\n  match pat {\n    PWild => env,\n    PBind(name) => env_bind(env, name, scrutinee_ty),\n    PInt(_) => {\n      match scrutinee_ty {\n        CtInt => (),\n        CtChar => (),\n        CtVar(_) => (),\n        CtUnknown => (),\n        CtNamed(_, _) => (),\n        _ => Array::push(errors, \"integer literal pattern cannot match a non-Int scrutinee\")\n      }\n      env\n    },\n    PFloat(_) => {\n      match scrutinee_ty {\n        CtDouble => (),\n        CtVar(_) => (),\n        CtUnknown => (),\n        CtNamed(_, _) => (),\n        _ => Array::push(errors, \"float literal pattern cannot match a non-Double scrutinee\")\n      }\n      env\n    },\n    PString(_) => {\n      match scrutinee_ty {\n        CtString => (),\n        CtVar(_) => (),\n        CtUnknown => (),\n        CtNamed(_, _) => (),\n        _ => Array::push(errors, \"string literal pattern cannot match a non-String scrutinee\")\n      }\n      env\n    },\n    PBool(_) => {\n      match scrutinee_ty {\n        CtBool => (),\n        CtVar(_) => (),\n        CtUnknown => (),\n        CtNamed(_, _) => (),\n        _ => Array::push(errors, \"boolean literal pattern cannot match a non-Bool scrutinee\")\n      }\n      env\n    },\n    PCtor(name, sub_pats) => {\n      let builtin_payload = match scrutinee_ty {\n        CtOption(elem) => if name == \"Some\" {\n          Some([\n            elem\n          ])\n        } else if name == \"None\" {\n          Some(Array::slice([\n            CtUnknown\n          ], 0, 0))\n        } else {\n          None\n        },\n        _ => None\n      }\n      let ctor_payload = match builtin_payload {\n        Some(types) => Some((\"Option\", types)),\n        None => find_ctor_in_defs(defs, name)\n      }\n      match ctor_payload {\n        Some(info) => {\n          let (enum_name, raw_payload) = info\n          let payload_types = match scrutinee_ty {\n            CtNamed(_, sargs) => match find_typedef(defs, enum_name) {\n              Some(td) => match td {\n                TDEnum(_, eparams, _) => if Array::length(eparams) > 0 && Array::length(sargs) > 0 {\n                  for pt in raw_payload {\n                    subst_type_params(pt, eparams, sargs)\n                  }\n                } else {\n                  raw_payload\n                },\n                _ => raw_payload\n              },\n              None => raw_payload\n            },\n            _ => raw_payload\n          }\n          let splen = Array::length(sub_pats)\n          let ptlen = Array::length(payload_types)\n          let non_enum_scrutinee = match scrutinee_ty {\n            CtInt => true,\n            CtDouble => true,\n            CtBool => true,\n            CtString => true,\n            CtChar => true,\n            CtUnit => true,\n            CtBytes => true,\n            CtFn(_, _, _) => true,\n            CtArray(_) => true,\n            CtTuple(_) => true,\n            _ => false\n          }\n          if non_enum_scrutinee {\n            Array::push(errors, String::concat(\"constructor pattern `\", String::concat(name, String::concat(\"` (of \", String::concat(enum_name, \") cannot match this scrutinee type\")))))\n          } else {\n            ()\n          }\n          if enum_name != \"Option\" && splen != ptlen {\n            Array::push(errors, String::concat(\"constructor pattern `\", String::concat(name, String::concat(\"` expects \", String::concat(__to_string(ptlen), String::concat(\" field(s) but binds \", __to_string(splen)))))))\n          } else {\n            ()\n          }\n          let rec bind_subs: (Int, TypeEnv) -> TypeEnv = (i, acc_env) -> {\n            if i >= splen {\n              acc_env\n            } else {\n              let sub_ty = if i < ptlen {\n                Array::get(payload_types, i)\n              } else {\n                CtUnknown\n              }\n              let next_env = check_pattern(Array::get(sub_pats, i), sub_ty, acc_env, defs, errors)\n              bind_subs(i + 1, next_env)\n            }\n          }\n          bind_subs(0, env)\n        },\n        None => {\n          let splen = Array::length(sub_pats)\n          let rec bind_unknown: (Int, TypeEnv) -> TypeEnv = (i, acc_env) -> {\n            if i >= splen {\n              acc_env\n            } else {\n              let next_env = check_pattern(Array::get(sub_pats, i), CtUnknown, acc_env, defs, errors)\n              bind_unknown(i + 1, next_env)\n            }\n          }\n          bind_unknown(0, env)\n        }\n      }\n    },\n    PTuple(pats) => {\n      let plen = Array::length(pats)\n      match scrutinee_ty {\n        CtTuple(elem_tys) => {\n          let elen = Array::length(elem_tys)\n          if plen != elen {\n            Array::push(errors, String::concat(\"tuple pattern binds \", String::concat(__to_string(plen), String::concat(\" elements but the value is a \", String::concat(__to_string(elen), \"-tuple\")))))\n          } else {\n            ()\n          }\n          let rec bind_tuple: (Int, TypeEnv) -> TypeEnv = (i, acc_env) -> {\n            if i >= plen {\n              acc_env\n            } else {\n              let et = if i < elen {\n                Array::get(elem_tys, i)\n              } else {\n                CtUnknown\n              }\n              let next_env = check_pattern(Array::get(pats, i), et, acc_env, defs, errors)\n              bind_tuple(i + 1, next_env)\n            }\n          }\n          bind_tuple(0, env)\n        },\n        _ => {\n          let concrete_non_tuple = match scrutinee_ty {\n            CtInt => true,\n            CtDouble => true,\n            CtBool => true,\n            CtString => true,\n            CtChar => true,\n            CtUnit => true,\n            CtBytes => true,\n            CtArray(_) => true,\n            CtOption(_) => true,\n            CtFn(_, _, _) => true,\n            CtStruct(_) => true,\n            CtEnum(_) => true,\n            _ => false\n          }\n          if concrete_non_tuple {\n            Array::push(errors, String::concat(\"tuple pattern binds \", String::concat(__to_string(plen), \" elements but the value is not a tuple\")))\n          } else {\n            ()\n          }\n          let rec bind_unk: (Int, TypeEnv) -> TypeEnv = (i, acc_env) -> {\n            if i >= plen {\n              acc_env\n            } else {\n              let next_env = check_pattern(Array::get(pats, i), CtUnknown, acc_env, defs, errors)\n              bind_unk(i + 1, next_env)\n            }\n          }\n          bind_unk(0, env)\n        }\n      }\n    },\n    POr(left, _right) => check_pattern(left, scrutinee_ty, env, defs, errors),\n    PStruct(_, fields) => {\n      let flen = Array::length(fields)\n      let rec bind_fields: (Int, TypeEnv) -> TypeEnv = (i, acc_env) -> {\n        if i >= flen {\n          acc_env\n        } else {\n          let (_, fpat) = Array::get(fields, i)\n          let next_env = check_pattern(fpat, CtUnknown, acc_env, defs, errors)\n          bind_fields(i + 1, next_env)\n        }\n      }\n      bind_fields(0, env)\n    }\n  }\n}\n")
}

let selfhost_source_50 = () -> (String, String) {
  ("lib/@vibe/compiler/checker_trait.vibe",
"\n\n\n\nlet one_super: (String) -> Array[String] = (name) -> {\n  [\n    name\n  ]\n}\n\nlet no_trait_methods: () -> Array[(String, Array[TypeExpr], TypeExpr)] = () -> {\n  ArrayBuilder::freeze(ArrayBuilder::new())\n}\n\nlet no_type_args: () -> Array[Type] = () -> {\n  Array::slice([\n    CtUnknown\n  ], 0, 0)\n}\n\nlet empty_strings: () -> Array[String] = () -> {\n  Array::slice([\n    \"\"\n  ], 0, 0)\n}\n\nexport let satisfies_bound: (TypeEnv, Subst, Type, String) -> Bool = (env, s, ty, bound) -> {\n  type_implements_trait(env, s, ty, bound)\n}\n\nexport let check_bounds_satisfied: (TypeEnv, Subst, Type, Array[String]) -> Array[String] = (env, s, ty, bounds) -> {\n  let result = empty_strings()\n  let len = Array::length(bounds)\n  let rec go: (Int) -> Int = (i) -> {\n    if i >= len {\n      0\n    } else {\n      let bound = Array::get(bounds, i)\n      if not(satisfies_bound(env, s, ty, bound)) {\n        Array::push(result, bound)\n      }\n      go(i + 1)\n    }\n  }\n  let _ = go(0)\n  result\n}\n\nexport let register_builtin_traits: (TypeEnv) -> TypeEnv = (env) -> {\n  let no_supers = empty_strings()\n  let eq_supers = one_super(\"Eq\")\n  let i64_type = CtNamed(\"i64\", no_type_args())\n  let u8_type = CtNamed(\"u8\", no_type_args())\n  let u16_type = CtNamed(\"u16\", no_type_args())\n  let u32_type = CtNamed(\"u32\", no_type_args())\n  let u64_type = CtNamed(\"u64\", no_type_args())\n  let i16_type = CtNamed(\"i16\", no_type_args())\n  let nm = no_trait_methods()\n  let e1 = EnvTraitDef(\"Eq\", no_supers, false, nm, env)\n  let e2 = EnvTraitDef(\"Ord\", eq_supers, false, nm, e1)\n  let e3 = EnvTraitDef(\"Add\", no_supers, false, nm, e2)\n  let e4 = EnvTraitDef(\"Sub\", no_supers, false, nm, e3)\n  let e5 = EnvTraitDef(\"Mul\", no_supers, false, nm, e4)\n  let e6 = EnvTraitDef(\"Div\", no_supers, false, nm, e5)\n  let e7 = EnvTraitImpl(\"Eq\", CtInt, e6)\n  let e8 = EnvTraitImpl(\"Eq\", CtDouble, e7)\n  let e9 = EnvTraitImpl(\"Eq\", CtString, e8)\n  let e10 = EnvTraitImpl(\"Eq\", CtBool, e9)\n  let e11 = EnvTraitImpl(\"Ord\", CtInt, e10)\n  let e12 = EnvTraitImpl(\"Ord\", CtDouble, e11)\n  let e13 = EnvTraitImpl(\"Ord\", CtString, e12)\n  let e14 = EnvTraitImpl(\"Add\", CtInt, e13)\n  let e15 = EnvTraitImpl(\"Add\", CtDouble, e14)\n  let e16 = EnvTraitImpl(\"Sub\", CtInt, e15)\n  let e17 = EnvTraitImpl(\"Sub\", CtDouble, e16)\n  let e18 = EnvTraitImpl(\"Mul\", CtInt, e17)\n  let e19 = EnvTraitImpl(\"Mul\", CtDouble, e18)\n  let e20 = EnvTraitImpl(\"Div\", CtInt, e19)\n  let e21 = EnvTraitImpl(\"Div\", CtDouble, e20)\n  let e22 = EnvTraitImpl(\"Eq\", i64_type, e21)\n  let e23 = EnvTraitImpl(\"Eq\", u8_type, e22)\n  let e24 = EnvTraitImpl(\"Eq\", u16_type, e23)\n  let e25 = EnvTraitImpl(\"Eq\", u32_type, e24)\n  let e26 = EnvTraitImpl(\"Eq\", u64_type, e25)\n  let e27 = EnvTraitImpl(\"Eq\", i16_type, e26)\n  let e28 = EnvTraitImpl(\"Ord\", i64_type, e27)\n  let e29 = EnvTraitImpl(\"Ord\", u8_type, e28)\n  let e30 = EnvTraitImpl(\"Ord\", u16_type, e29)\n  let e31 = EnvTraitImpl(\"Ord\", u32_type, e30)\n  let e32 = EnvTraitImpl(\"Ord\", u64_type, e31)\n  let e33 = EnvTraitImpl(\"Ord\", i16_type, e32)\n  let e34 = EnvTraitImpl(\"Add\", i64_type, e33)\n  let e35 = EnvTraitImpl(\"Add\", u8_type, e34)\n  let e36 = EnvTraitImpl(\"Add\", u16_type, e35)\n  let e37 = EnvTraitImpl(\"Add\", u32_type, e36)\n  let e38 = EnvTraitImpl(\"Add\", u64_type, e37)\n  let e39 = EnvTraitImpl(\"Add\", i16_type, e38)\n  let e40 = EnvTraitImpl(\"Sub\", i64_type, e39)\n  let e41 = EnvTraitImpl(\"Sub\", u8_type, e40)\n  let e42 = EnvTraitImpl(\"Sub\", u16_type, e41)\n  let e43 = EnvTraitImpl(\"Sub\", u32_type, e42)\n  let e44 = EnvTraitImpl(\"Sub\", u64_type, e43)\n  let e45 = EnvTraitImpl(\"Sub\", i16_type, e44)\n  let e46 = EnvTraitImpl(\"Mul\", i64_type, e45)\n  let e47 = EnvTraitImpl(\"Mul\", u8_type, e46)\n  let e48 = EnvTraitImpl(\"Mul\", u16_type, e47)\n  let e49 = EnvTraitImpl(\"Mul\", u32_type, e48)\n  let e50 = EnvTraitImpl(\"Mul\", u64_type, e49)\n  let e51 = EnvTraitImpl(\"Mul\", i16_type, e50)\n  let e52 = EnvTraitImpl(\"Div\", i64_type, e51)\n  let e53 = EnvTraitImpl(\"Div\", u8_type, e52)\n  let e54 = EnvTraitImpl(\"Div\", u16_type, e53)\n  let e55 = EnvTraitImpl(\"Div\", u32_type, e54)\n  let e56 = EnvTraitImpl(\"Div\", u64_type, e55)\n  let e57 = EnvTraitImpl(\"Div\", i16_type, e56)\n  e57\n}\n\nexport let validate_supers_defined: (TypeEnv, Array[String]) -> Array[String] = (env, supers) -> {\n  let result = empty_strings()\n  let len = Array::length(supers)\n  let rec go: (Int) -> Int = (i) -> {\n    if i >= len {\n      0\n    } else {\n      let name = Array::get(supers, i)\n      if not(trait_defined(env, name)) {\n        Array::push(result, name)\n      }\n      go(i + 1)\n    }\n  }\n  let _ = go(0)\n  result\n}\n\nexport let validate_impl_no_overlap: (TypeEnv, String, Type) -> Bool = (env, trait_name, target) -> {\n  not(impls_overlap_for(env, trait_name, target))\n}\n")
}

let selfhost_source_51 = () -> (String, String) {
  ("lib/@vibe/compiler/checker_effects.vibe",
"\n\n\n\n\n\nexport enum EffectError {\n  EEThrowOutsideEffect(String);\n  EEEffectfulCallOutsideEffect(String);\n  EEPerformUndeclaredEffect(String, String);\n  EEAssignImmutable(String)\n}\n\n\nlet is_effectful_type: (Type) -> Bool = (ty) -> {\n  match ty {\n    CtFn(_, _, Some(_)) => true,\n    _ => false\n  }\n}\n\nlet is_effectful_name: (String, TypeEnv) -> Bool = (name, env) -> {\n  match env_lookup(env, name) {\n    Some(ty) => is_effectful_type(ty),\n    None => {\n      let normalized = canonical_builtin_name(name)\n      match lookup_builtin(normalized) {\n        Some(ty) => is_effectful_type(ty),\n        None => false\n      }\n    }\n  }\n}\n\nexport let rec check_effects_expr: (Expr, TypeEnv, Bool) -> Array[EffectError] = (expr, env, in_effect) -> {\n  let errors = Array::slice([\n    EEThrowOutsideEffect(\"\")\n  ], 0, 0)\n  match expr {\n    EThrow(_) => {\n      if !in_effect {\n        Array::push(errors, EEThrowOutsideEffect(\"throw\"))\n      }\n      errors\n    },\n    EHandle(body, arms) => {\n      let body_errs = check_effects_expr(body, env, true)\n      let mut i = 0\n      while i < Array::length(body_errs) {\n        Array::push(errors, Array::get(body_errs, i))\n        i = i + 1\n      }\n      let mut ai = 0\n      while ai < Array::length(arms) {\n        let (_, arm_body) = Array::get(arms, ai)\n        let arm_errs = check_effects_expr(arm_body, env, in_effect)\n        let mut j = 0\n        while j < Array::length(arm_errs) {\n          Array::push(errors, Array::get(arm_errs, j))\n          j = j + 1\n        }\n        ai = ai + 1\n      }\n      errors\n    },\n    ECall(callee, args, _) => {\n      match callee {\n        EIdent(name, _) => if !in_effect && is_effectful_name(name, env) {\n          Array::push(errors, EEEffectfulCallOutsideEffect(name))\n        }\n        ,\n        _ => ()\n      }\n      let ce = check_effects_expr(callee, env, in_effect)\n      let mut i = 0\n      while i < Array::length(ce) {\n        Array::push(errors, Array::get(ce, i))\n        i = i + 1\n      }\n      let mut ai = 0\n      while ai < Array::length(args) {\n        let ae = check_effects_expr(Array::get(args, ai), env, in_effect)\n        let mut j = 0\n        while j < Array::length(ae) {\n          Array::push(errors, Array::get(ae, j))\n          j = j + 1\n        }\n        ai = ai + 1\n      }\n      errors\n    },\n    EFn(_, _, _, _, effect, body) => {\n      let fn_in_effect = match effect {\n        Some(_) => true,\n        None => false\n      }\n      let body_errs = check_effects_expr(body, env, fn_in_effect)\n      let mut i = 0\n      while i < Array::length(body_errs) {\n        Array::push(errors, Array::get(body_errs, i))\n        i = i + 1\n      }\n      errors\n    },\n    ELet(_, val, body, _) => {\n      let ve = check_effects_expr(val, env, in_effect)\n      let be = check_effects_expr(body, env, in_effect)\n      let mut i = 0\n      while i < Array::length(ve) {\n        Array::push(errors, Array::get(ve, i))\n        i = i + 1\n      }\n      i = 0\n      while i < Array::length(be) {\n        Array::push(errors, Array::get(be, i))\n        i = i + 1\n      }\n      errors\n    },\n    ELetRec(_, val, body) => {\n      let ve = check_effects_expr(val, env, in_effect)\n      let be = check_effects_expr(body, env, in_effect)\n      let mut i = 0\n      while i < Array::length(ve) {\n        Array::push(errors, Array::get(ve, i))\n        i = i + 1\n      }\n      i = 0\n      while i < Array::length(be) {\n        Array::push(errors, Array::get(be, i))\n        i = i + 1\n      }\n      errors\n    },\n    ELetMut(_, val, body, _) => {\n      let ve = check_effects_expr(val, env, in_effect)\n      let be = check_effects_expr(body, env, in_effect)\n      let mut i = 0\n      while i < Array::length(ve) {\n        Array::push(errors, Array::get(ve, i))\n        i = i + 1\n      }\n      i = 0\n      while i < Array::length(be) {\n        Array::push(errors, Array::get(be, i))\n        i = i + 1\n      }\n      errors\n    },\n    ESeq(a, b) => {\n      let ae = check_effects_expr(a, env, in_effect)\n      let be = check_effects_expr(b, env, in_effect)\n      let mut i = 0\n      while i < Array::length(ae) {\n        Array::push(errors, Array::get(ae, i))\n        i = i + 1\n      }\n      i = 0\n      while i < Array::length(be) {\n        Array::push(errors, Array::get(be, i))\n        i = i + 1\n      }\n      errors\n    },\n    EIf(cond, then_e, else_e) => {\n      let ce = check_effects_expr(cond, env, in_effect)\n      let te = check_effects_expr(then_e, env, in_effect)\n      let ee = check_effects_expr(else_e, env, in_effect)\n      let mut i = 0\n      while i < Array::length(ce) {\n        Array::push(errors, Array::get(ce, i))\n        i = i + 1\n      }\n      i = 0\n      while i < Array::length(te) {\n        Array::push(errors, Array::get(te, i))\n        i = i + 1\n      }\n      i = 0\n      while i < Array::length(ee) {\n        Array::push(errors, Array::get(ee, i))\n        i = i + 1\n      }\n      errors\n    },\n    EMatch(scrutinee, arms) => {\n      let se = check_effects_expr(scrutinee, env, in_effect)\n      let mut i = 0\n      while i < Array::length(se) {\n        Array::push(errors, Array::get(se, i))\n        i = i + 1\n      }\n      let mut ai = 0\n      while ai < Array::length(arms) {\n        let (_, arm_body) = Array::get(arms, ai)\n        let ae = check_effects_expr(arm_body, env, in_effect)\n        let mut j = 0\n        while j < Array::length(ae) {\n          Array::push(errors, Array::get(ae, j))\n          j = j + 1\n        }\n        ai = ai + 1\n      }\n      errors\n    },\n    EWhile(cond, body) => {\n      let ce = check_effects_expr(cond, env, in_effect)\n      let be = check_effects_expr(body, env, in_effect)\n      let mut i = 0\n      while i < Array::length(ce) {\n        Array::push(errors, Array::get(ce, i))\n        i = i + 1\n      }\n      i = 0\n      while i < Array::length(be) {\n        Array::push(errors, Array::get(be, i))\n        i = i + 1\n      }\n      errors\n    },\n    ELoop(params, body) => {\n      let mut i = 0\n      while i < Array::length(params) {\n        let (_, init) = Array::get(params, i)\n        let pe = check_effects_expr(init, env, in_effect)\n        let mut j = 0\n        while j < Array::length(pe) {\n          Array::push(errors, Array::get(pe, j))\n          j = j + 1\n        }\n        i = i + 1\n      }\n      let be = check_effects_expr(body, env, in_effect)\n      i = 0\n      while i < Array::length(be) {\n        Array::push(errors, Array::get(be, i))\n        i = i + 1\n      }\n      errors\n    },\n    EForIn(_, _, iter, body) => {\n      let ie = check_effects_expr(iter, env, in_effect)\n      let be = check_effects_expr(body, env, in_effect)\n      let mut i = 0\n      while i < Array::length(ie) {\n        Array::push(errors, Array::get(ie, i))\n        i = i + 1\n      }\n      i = 0\n      while i < Array::length(be) {\n        Array::push(errors, Array::get(be, i))\n        i = i + 1\n      }\n      errors\n    },\n    EBinOp(_, left, right) => {\n      let le = check_effects_expr(left, env, in_effect)\n      let re = check_effects_expr(right, env, in_effect)\n      let mut i = 0\n      while i < Array::length(le) {\n        Array::push(errors, Array::get(le, i))\n        i = i + 1\n      }\n      i = 0\n      while i < Array::length(re) {\n        Array::push(errors, Array::get(re, i))\n        i = i + 1\n      }\n      errors\n    },\n    EReturn(e) => check_effects_expr(e, env, in_effect),\n    EUnaryOp(_, operand) => check_effects_expr(operand, env, in_effect),\n    EAssign(_, val, cont) => {\n      let ve = check_effects_expr(val, env, in_effect)\n      let ce = check_effects_expr(cont, env, in_effect)\n      let mut i = 0\n      while i < Array::length(ve) {\n        Array::push(errors, Array::get(ve, i))\n        i = i + 1\n      }\n      i = 0\n      while i < Array::length(ce) {\n        Array::push(errors, Array::get(ce, i))\n        i = i + 1\n      }\n      errors\n    },\n    EAssignOp(_, _, val, cont) => {\n      let ve = check_effects_expr(val, env, in_effect)\n      let ce = check_effects_expr(cont, env, in_effect)\n      let mut i = 0\n      while i < Array::length(ve) {\n        Array::push(errors, Array::get(ve, i))\n        i = i + 1\n      }\n      i = 0\n      while i < Array::length(ce) {\n        Array::push(errors, Array::get(ce, i))\n        i = i + 1\n      }\n      errors\n    },\n    EDot(obj, _, _, _) => check_effects_expr(obj, env, in_effect),\n    ETuple(elems) => {\n      let mut ei = 0\n      while ei < Array::length(elems) {\n        let ee = check_effects_expr(Array::get(elems, ei), env, in_effect)\n        let mut j = 0\n        while j < Array::length(ee) {\n          Array::push(errors, Array::get(ee, j))\n          j = j + 1\n        }\n        ei = ei + 1\n      }\n      errors\n    },\n    EArray(elems) => {\n      let mut ei = 0\n      while ei < Array::length(elems) {\n        let ee = check_effects_expr(Array::get(elems, ei), env, in_effect)\n        let mut j = 0\n        while j < Array::length(ee) {\n          Array::push(errors, Array::get(ee, j))\n          j = j + 1\n        }\n        ei = ei + 1\n      }\n      errors\n    },\n    ERecord(_, fields) => {\n      let mut fi = 0\n      while fi < Array::length(fields) {\n        let (_, fval) = Array::get(fields, fi)\n        let fe = check_effects_expr(fval, env, in_effect)\n        let mut j = 0\n        while j < Array::length(fe) {\n          Array::push(errors, Array::get(fe, j))\n          j = j + 1\n        }\n        fi = fi + 1\n      }\n      errors\n    },\n    _ => errors\n  }\n}\n\nexport let check_effects_stmt: (Stmt, TypeEnv) -> Array[EffectError] = (stmt, env) -> {\n  match stmt {\n    SLet(_, _, _, _, body) => check_effects_expr(body, env, false),\n    SLetMut(_, _, body) => check_effects_expr(body, env, false),\n    STest(_, body) => check_effects_expr(body, env, false),\n    SBench(_, body) => check_effects_expr(body, env, false),\n    SExpr(e) => check_effects_expr(e, env, false),\n    _ => Array::slice([\n      EEThrowOutsideEffect(\"\")\n    ], 0, 0)\n  }\n}\n\nexport let check_effects_stmts: (Array[Stmt], TypeEnv) -> Array[EffectError] = (stmts, env) -> {\n  let errors = Array::slice([\n    EEThrowOutsideEffect(\"\")\n  ], 0, 0)\n  let mut i = 0\n  while i < Array::length(stmts) {\n    let se = check_effects_stmt(Array::get(stmts, i), env)\n    let mut j = 0\n    while j < Array::length(se) {\n      Array::push(errors, Array::get(se, j))\n      j = j + 1\n    }\n    i = i + 1\n  }\n  errors\n}\n\nexport let effect_error_to_string: (EffectError) -> String = (err) -> {\n  match err {\n    EEThrowOutsideEffect(msg) => String::concat(\"throw outside effectful context: \", msg),\n    EEEffectfulCallOutsideEffect(name) => String::concat(\"effectful call outside effectful context: \", name),\n    EEPerformUndeclaredEffect(op, eff) => String::concat(\"use of undeclared effect `\", String::concat(eff, String::concat(\"` (\", String::concat(op, \"); add it to the function's `with { ... }` or wrap in a `handle`\")))),\n    EEAssignImmutable(name) => String::concat(\"cannot assign to immutable binding `\", String::concat(name, \"` (declare it with `let mut`)\"))\n  }\n}\n\n\nlet effect_opt_is_async: (Option[String]) -> Bool = (eff) -> {\n  match eff {\n    Some(s) => String::contains(s, \"Async\"),\n    None => false\n  }\n}\n\nlet is_async_primitive: (String, TypeEnv) -> Bool = (name, env) -> {\n  match env_lookup(env, name) {\n    Some(_) => false,\n    None => {\n      let normalized = canonical_builtin_name(name)\n      match lookup_builtin(normalized) {\n        Some(ty) => match ty {\n          CtFn(_, _, eff) => effect_opt_is_async(eff),\n          _ => false\n        },\n        None => false\n      }\n    }\n  }\n}\n\nlet append_eff_errs: (Array[EffectError], Array[EffectError]) -> Unit = (dst, src) -> {\n  let mut i = 0\n  while i < Array::length(src) {\n    Array::push(dst, Array::get(src, i))\n    i = i + 1\n  }\n}\n\nexport let rec check_async_effects_expr: (Expr, TypeEnv, Bool) -> Array[EffectError] = (expr, env, in_async) -> {\n  let errors = Array::slice([\n    EEThrowOutsideEffect(\"\")\n  ], 0, 0)\n  match expr {\n    ECall(callee, args, _) => {\n      match callee {\n        EIdent(name, _) => if !in_async && is_async_primitive(name, env) {\n          Array::push(errors, EEEffectfulCallOutsideEffect(name))\n        }\n        ,\n        _ => ()\n      }\n      append_eff_errs(errors, check_async_effects_expr(callee, env, in_async))\n      let mut ai = 0\n      while ai < Array::length(args) {\n        append_eff_errs(errors, check_async_effects_expr(Array::get(args, ai), env, in_async))\n        ai = ai + 1\n      }\n      errors\n    },\n    EFn(_, _, _, _, effect, body) => {\n      append_eff_errs(errors, check_async_effects_expr(body, env, effect_opt_is_async(effect)))\n      errors\n    },\n    EHandle(body, arms) => {\n      append_eff_errs(errors, check_async_effects_expr(body, env, in_async))\n      let mut ai = 0\n      while ai < Array::length(arms) {\n        let (_, arm_body) = Array::get(arms, ai)\n        append_eff_errs(errors, check_async_effects_expr(arm_body, env, in_async))\n        ai = ai + 1\n      }\n      errors\n    },\n    ELet(_, val, body, _) => {\n      append_eff_errs(errors, check_async_effects_expr(val, env, in_async))\n      append_eff_errs(errors, check_async_effects_expr(body, env, in_async))\n      errors\n    },\n    ELetRec(_, val, body) => {\n      append_eff_errs(errors, check_async_effects_expr(val, env, in_async))\n      append_eff_errs(errors, check_async_effects_expr(body, env, in_async))\n      errors\n    },\n    ELetMut(_, val, body, _) => {\n      append_eff_errs(errors, check_async_effects_expr(val, env, in_async))\n      append_eff_errs(errors, check_async_effects_expr(body, env, in_async))\n      errors\n    },\n    ESeq(a, b) => {\n      append_eff_errs(errors, check_async_effects_expr(a, env, in_async))\n      append_eff_errs(errors, check_async_effects_expr(b, env, in_async))\n      errors\n    },\n    EIf(cond, then_e, else_e) => {\n      append_eff_errs(errors, check_async_effects_expr(cond, env, in_async))\n      append_eff_errs(errors, check_async_effects_expr(then_e, env, in_async))\n      append_eff_errs(errors, check_async_effects_expr(else_e, env, in_async))\n      errors\n    },\n    EMatch(scrutinee, arms) => {\n      append_eff_errs(errors, check_async_effects_expr(scrutinee, env, in_async))\n      let mut ai = 0\n      while ai < Array::length(arms) {\n        let (_, arm_body) = Array::get(arms, ai)\n        append_eff_errs(errors, check_async_effects_expr(arm_body, env, in_async))\n        ai = ai + 1\n      }\n      errors\n    },\n    EWhile(cond, body) => {\n      append_eff_errs(errors, check_async_effects_expr(cond, env, in_async))\n      append_eff_errs(errors, check_async_effects_expr(body, env, in_async))\n      errors\n    },\n    ELoop(params, body) => {\n      let mut i = 0\n      while i < Array::length(params) {\n        let (_, init) = Array::get(params, i)\n        append_eff_errs(errors, check_async_effects_expr(init, env, in_async))\n        i = i + 1\n      }\n      append_eff_errs(errors, check_async_effects_expr(body, env, in_async))\n      errors\n    },\n    EForIn(_, _, iter, body) => {\n      append_eff_errs(errors, check_async_effects_expr(iter, env, in_async))\n      append_eff_errs(errors, check_async_effects_expr(body, env, in_async))\n      errors\n    },\n    EBinOp(_, left, right) => {\n      append_eff_errs(errors, check_async_effects_expr(left, env, in_async))\n      append_eff_errs(errors, check_async_effects_expr(right, env, in_async))\n      errors\n    },\n    EReturn(e) => check_async_effects_expr(e, env, in_async),\n    EUnaryOp(_, operand) => check_async_effects_expr(operand, env, in_async),\n    EThrow(e) => check_async_effects_expr(e, env, in_async),\n    EAssign(_, val, cont) => {\n      append_eff_errs(errors, check_async_effects_expr(val, env, in_async))\n      append_eff_errs(errors, check_async_effects_expr(cont, env, in_async))\n      errors\n    },\n    EAssignOp(_, _, val, cont) => {\n      append_eff_errs(errors, check_async_effects_expr(val, env, in_async))\n      append_eff_errs(errors, check_async_effects_expr(cont, env, in_async))\n      errors\n    },\n    EDot(obj, _, _, _) => check_async_effects_expr(obj, env, in_async),\n    ETuple(elems) => {\n      let mut ei = 0\n      while ei < Array::length(elems) {\n        append_eff_errs(errors, check_async_effects_expr(Array::get(elems, ei), env, in_async))\n        ei = ei + 1\n      }\n      errors\n    },\n    EArray(elems) => {\n      let mut ei = 0\n      while ei < Array::length(elems) {\n        append_eff_errs(errors, check_async_effects_expr(Array::get(elems, ei), env, in_async))\n        ei = ei + 1\n      }\n      errors\n    },\n    ERecord(_, fields) => {\n      let mut fi = 0\n      while fi < Array::length(fields) {\n        let (_, fval) = Array::get(fields, fi)\n        append_eff_errs(errors, check_async_effects_expr(fval, env, in_async))\n        fi = fi + 1\n      }\n      errors\n    },\n    _ => errors\n  }\n}\n\nlet sig_type_is_async: (Option[TypeExpr]) -> Bool = (topt) -> {\n  match topt {\n    Some(TyFn(_, _, eff)) => effect_opt_is_async(eff),\n    _ => false\n  }\n}\n\nlet check_async_effects_binding: (Option[TypeExpr], Expr, TypeEnv) -> Array[EffectError] = (ty, body, env) -> {\n  let sig_async = sig_type_is_async(ty)\n  match body {\n    EFn(_, _, _, _, eff, fbody) => check_async_effects_expr(fbody, env, sig_async || effect_opt_is_async(eff)),\n    _ => check_async_effects_expr(body, env, sig_async)\n  }\n}\n\nexport let check_async_effects_stmt: (Stmt, TypeEnv) -> Array[EffectError] = (stmt, env) -> {\n  match stmt {\n    SLet(_, _, _, ty, body) => check_async_effects_binding(ty, body, env),\n    SLetMut(_, ty, body) => check_async_effects_binding(ty, body, env),\n    STest(_, body) => check_async_effects_expr(body, env, false),\n    SBench(_, body) => check_async_effects_expr(body, env, false),\n    SExpr(e) => check_async_effects_expr(e, env, false),\n    _ => Array::slice([\n      EEThrowOutsideEffect(\"\")\n    ], 0, 0)\n  }\n}\n\nexport let check_async_effects_stmts: (Array[Stmt], TypeEnv) -> Array[EffectError] = (stmts, env) -> {\n  let errors = Array::slice([\n    EEThrowOutsideEffect(\"\")\n  ], 0, 0)\n  let mut i = 0\n  while i < Array::length(stmts) {\n    append_eff_errs(errors, check_async_effects_stmt(Array::get(stmts, i), env))\n    i = i + 1\n  }\n  errors\n}\n\n\nlet effect_decl_labels: (Option[String]) -> Array[String] = (eff) -> {\n  let out = Array::slice([\n    \"\"\n  ], 0, 0)\n  match eff {\n    None => out,\n    Some(s) => {\n      let raw = String::split(s, \",\")\n      let mut i = 0\n      while i < Array::length(raw) {\n        let label = String::trim(Array::get(raw, i))\n        if String::length(label) > 0 {\n          let mut seen = false\n          let mut j = 0\n          while j < Array::length(out) {\n            if Array::get(out, j) == label {\n              seen = true\n            }\n            j = j + 1\n          }\n          if !seen {\n            Array::push(out, label)\n          }\n        }\n        i = i + 1\n      }\n      out\n    }\n  }\n}\n\nlet label_is_effect_var: (String) -> Bool = (name) -> {\n  String::length(name) == 1 && String::char_code_at(name, 0) >= 97 && String::char_code_at(name, 0) <= 122\n}\n\nlet decl_authorizes_effect: (Array[String], String) -> Bool = (labels, eff_name) -> {\n  let mut i = 0\n  let mut ok = false\n  while i < Array::length(labels) {\n    let l = Array::get(labels, i)\n    if l == eff_name {\n      ok = true\n    } else if label_is_effect_var(l) {\n      ok = true\n    }\n    i = i + 1\n  }\n  ok\n}\n\nlet effect_name_of_op: (String) -> String = (op_name) -> {\n  let idx = String::index_of(op_name, \"::\")\n  if idx > 0 {\n    op_name[0:idx]\n  } else {\n    op_name\n  }\n}\n\nlet builtin_call_effect: (String) -> Option[String] = (name) -> {\n  if name == \"sh\" || name == \"sh_lines\" {\n    Some(\"Process\")\n  } else if String::index_of(name, \"::\") < 0 {\n    None\n  } else {\n    let normalized = canonical_builtin_name(name)\n    match lookup_builtin(normalized) {\n      Some(ty) => match ty {\n        CtFn(_, _, Some(eff)) => if eff == \"Error\" {\n          None\n        } else if eff == \"Async\" {\n          None\n        } else {\n          Some(eff)\n        },\n        _ => None\n      },\n      None => None\n    }\n  }\n}\n\nlet labels_union: (Array[String], Array[String]) -> Array[String] = (a, b) -> {\n  let out = Array::slice([\n    \"\"\n  ], 0, 0)\n  let mut i = 0\n  while i < Array::length(a) {\n    Array::push(out, Array::get(a, i))\n    i = i + 1\n  }\n  let mut j = 0\n  while j < Array::length(b) {\n    let l = Array::get(b, j)\n    let mut seen = false\n    let mut k = 0\n    while k < Array::length(out) {\n      if Array::get(out, k) == l {\n        seen = true\n      }\n      k = k + 1\n    }\n    if !seen {\n      Array::push(out, l)\n    }\n    j = j + 1\n  }\n  out\n}\n\nlet collect_handle_effects: (Array[(Pat, Expr)]) -> Array[String] = (arms) -> {\n  let out = Array::slice([\n    \"\"\n  ], 0, 0)\n  let mut i = 0\n  while i < Array::length(arms) {\n    let (pat, _) = Array::get(arms, i)\n    match pat {\n      PCtor(name, _) => {\n        let idx = String::index_of(name, \"::\")\n        if idx > 0 {\n          let eff = name[0:idx]\n          let mut seen = false\n          let mut j = 0\n          while j < Array::length(out) {\n            if Array::get(out, j) == eff {\n              seen = true\n            }\n            j = j + 1\n          }\n          if !seen {\n            Array::push(out, eff)\n          }\n        }\n      },\n      _ => ()\n    }\n    i = i + 1\n  }\n  out\n}\n\nlet fn_binding_effects: (Option[TypeExpr], Expr) -> Array[String] = (ty, body) -> {\n  let sig = sig_type_effect_labels(ty)\n  match body {\n    EFn(_, _, _, _, eff, _) => labels_union(sig, effect_decl_labels(eff)),\n    _ => sig\n  }\n}\n\nlet lookup_fn_effs: (Array[String], Array[Array[String]], String) -> Option[Array[String]] = (names, effs, name) -> {\n  let mut i = 0\n  let mut found = None\n  while i < Array::length(names) {\n    match found {\n      None => if Array::get(names, i) == name {\n        found = Some(Array::get(effs, i))\n      } else {\n        ()\n      },\n      Some(_) => ()\n    }\n    i = i + 1\n  }\n  found\n}\n\nexport let check_perform_effects_expr_tx: (Expr, Array[String], Bool, Array[String], Array[Array[String]]) -> Array[EffectError] = (root, root_declared, root_in_handle, fn_names, fn_effs) -> {\n  let errors = Array::slice([\n    EEThrowOutsideEffect(\"\")\n  ], 0, 0)\n  let stack = Array::slice([\n    (root, root_declared, root_in_handle)\n  ], 0, 1)\n  while Array::length(stack) > 0 {\n    let n = Array::length(stack)\n    let (expr, declared, in_handle) = Array::get(stack, n - 1)\n    Array::truncate(stack, n - 1)\n    match expr {\n      ECall(callee, args, _) => {\n        match callee {\n          EIdent(name, _) => {\n            if name == \"perform\" && Array::length(args) == 1 {\n              match Array::get(args, 0) {\n                ECall(op_callee, _, _) => match op_callee {\n                  EIdent(op_name, _) => {\n                    let eff = effect_name_of_op(op_name)\n                    if !in_handle && !decl_authorizes_effect(declared, eff) {\n                      Array::push(errors, EEPerformUndeclaredEffect(op_name, eff))\n                    } else {\n                      ()\n                    }\n                  },\n                  _ => ()\n                },\n                _ => ()\n              }\n            } else {\n              match builtin_call_effect(name) {\n                Some(eff) => if !in_handle && !decl_authorizes_effect(declared, eff) {\n                  Array::push(errors, EEPerformUndeclaredEffect(name, eff))\n                } else {\n                  ()\n                },\n                None => ()\n              }\n            }\n            match lookup_fn_effs(fn_names, fn_effs, name) {\n              Some(callee_effs) => {\n                let mut ti = 0\n                while ti < Array::length(callee_effs) {\n                  let teff = Array::get(callee_effs, ti)\n                  if String::length(teff) > 0 && teff != \"Error\" && teff != \"Async\" && !label_is_effect_var(teff) && !in_handle && !decl_authorizes_effect(declared, teff) {\n                    Array::push(errors, EEPerformUndeclaredEffect(name, teff))\n                  } else {\n                    ()\n                  }\n                  ti = ti + 1\n                }\n              },\n              None => ()\n            }\n          },\n          _ => ()\n        }\n        Array::push(stack, (callee, declared, in_handle))\n        let mut ai = 0\n        while ai < Array::length(args) {\n          Array::push(stack, (Array::get(args, ai), declared, in_handle))\n          ai = ai + 1\n        }\n      },\n      EFn(_, _, _, _, effect, body) => {\n        let lam_labels = effect_decl_labels(effect)\n        let body_declared = if Array::length(lam_labels) == 0 {\n          declared\n        } else {\n          lam_labels\n        }\n        Array::push(stack, (body, body_declared, in_handle))\n      },\n      EHandle(body, arms) => {\n        let discharged = collect_handle_effects(arms)\n        let body_declared = labels_union(declared, discharged)\n        let body_in_handle = if Array::length(discharged) == 0 {\n          true\n        } else {\n          in_handle\n        }\n        Array::push(stack, (body, body_declared, body_in_handle))\n        let mut ai = 0\n        while ai < Array::length(arms) {\n          let (_, arm_body) = Array::get(arms, ai)\n          Array::push(stack, (arm_body, declared, in_handle))\n          ai = ai + 1\n        }\n      },\n      ELet(_, val, body, _) => {\n        Array::push(stack, (val, declared, in_handle))\n        Array::push(stack, (body, declared, in_handle))\n      },\n      ELetRec(_, val, body) => {\n        Array::push(stack, (val, declared, in_handle))\n        Array::push(stack, (body, declared, in_handle))\n      },\n      ELetMut(_, val, body, _) => {\n        Array::push(stack, (val, declared, in_handle))\n        Array::push(stack, (body, declared, in_handle))\n      },\n      ESeq(a, b) => {\n        Array::push(stack, (a, declared, in_handle))\n        Array::push(stack, (b, declared, in_handle))\n      },\n      EIf(cond, then_e, else_e) => {\n        Array::push(stack, (cond, declared, in_handle))\n        Array::push(stack, (then_e, declared, in_handle))\n        Array::push(stack, (else_e, declared, in_handle))\n      },\n      EMatch(scrutinee, arms) => {\n        Array::push(stack, (scrutinee, declared, in_handle))\n        let mut ai = 0\n        while ai < Array::length(arms) {\n          let (_, arm_body) = Array::get(arms, ai)\n          Array::push(stack, (arm_body, declared, in_handle))\n          ai = ai + 1\n        }\n      },\n      EWhile(cond, body) => {\n        Array::push(stack, (cond, declared, in_handle))\n        Array::push(stack, (body, declared, in_handle))\n      },\n      ELoop(params, body) => {\n        let mut i = 0\n        while i < Array::length(params) {\n          let (_, init) = Array::get(params, i)\n          Array::push(stack, (init, declared, in_handle))\n          i = i + 1\n        }\n        Array::push(stack, (body, declared, in_handle))\n      },\n      EForIn(_, _, iter, body) => {\n        Array::push(stack, (iter, declared, in_handle))\n        Array::push(stack, (body, declared, in_handle))\n      },\n      EBinOp(_, left, right) => {\n        Array::push(stack, (left, declared, in_handle))\n        Array::push(stack, (right, declared, in_handle))\n      },\n      EReturn(e) => Array::push(stack, (e, declared, in_handle)),\n      EUnaryOp(_, operand) => Array::push(stack, (operand, declared, in_handle)),\n      EThrow(e) => Array::push(stack, (e, declared, in_handle)),\n      EAssign(_, val, cont) => {\n        Array::push(stack, (val, declared, in_handle))\n        Array::push(stack, (cont, declared, in_handle))\n      },\n      EAssignOp(_, _, val, cont) => {\n        Array::push(stack, (val, declared, in_handle))\n        Array::push(stack, (cont, declared, in_handle))\n      },\n      EDot(obj, _, _, _) => Array::push(stack, (obj, declared, in_handle)),\n      ETuple(elems) => {\n        let mut ei = 0\n        while ei < Array::length(elems) {\n          Array::push(stack, (Array::get(elems, ei), declared, in_handle))\n          ei = ei + 1\n        }\n      },\n      EArray(elems) => {\n        let mut ei = 0\n        while ei < Array::length(elems) {\n          Array::push(stack, (Array::get(elems, ei), declared, in_handle))\n          ei = ei + 1\n        }\n      },\n      ERecord(_, fields) => {\n        let mut fi = 0\n        while fi < Array::length(fields) {\n          let (_, fval) = Array::get(fields, fi)\n          Array::push(stack, (fval, declared, in_handle))\n          fi = fi + 1\n        }\n      },\n      _ => ()\n    }\n  }\n  errors\n}\n\nlet sig_type_effect_labels: (Option[TypeExpr]) -> Array[String] = (topt) -> {\n  match topt {\n    Some(TyFn(_, _, eff)) => effect_decl_labels(eff),\n    _ => effect_decl_labels(None)\n  }\n}\n\nexport let check_perform_effects_expr: (Expr, Array[String], Bool) -> Array[EffectError] = (root, root_declared, root_in_handle) -> {\n  check_perform_effects_expr_tx(root, root_declared, root_in_handle, Array::slice([\n    \"\"\n  ], 0, 0), Array::slice([\n    Array::slice([\n      \"\"\n    ], 0, 0)\n  ], 0, 0))\n}\n\nlet check_perform_effects_binding_tx: (Option[TypeExpr], Expr, Array[String], Array[Array[String]]) -> Array[EffectError] = (ty, body, fn_names, fn_effs) -> {\n  let sig_labels = sig_type_effect_labels(ty)\n  match body {\n    EFn(_, _, _, _, eff, fbody) => check_perform_effects_expr_tx(fbody, labels_union(sig_labels, effect_decl_labels(eff)), false, fn_names, fn_effs),\n    _ => check_perform_effects_expr_tx(body, sig_labels, false, fn_names, fn_effs)\n  }\n}\n\nlet test_bench_ambient_effects: () -> Array[String] = () -> {\n  [\n    \"Fs\", \"Env\", \"Stdin\", \"Stdout\", \"Process\", \"Profiler\"\n  ]\n}\n\nlet check_perform_effects_stmt_tx: (Stmt, Array[String], Array[Array[String]]) -> Array[EffectError] = (stmt, fn_names, fn_effs) -> {\n  match stmt {\n    SLet(_, _, _, ty, body) => check_perform_effects_binding_tx(ty, body, fn_names, fn_effs),\n    SLetMut(_, ty, body) => check_perform_effects_binding_tx(ty, body, fn_names, fn_effs),\n    STest(_, body) => check_perform_effects_expr_tx(body, test_bench_ambient_effects(), false, fn_names, fn_effs),\n    SBench(_, body) => check_perform_effects_expr_tx(body, test_bench_ambient_effects(), false, fn_names, fn_effs),\n    SExpr(e) => check_perform_effects_expr_tx(e, effect_decl_labels(None), false, fn_names, fn_effs),\n    _ => Array::slice([\n      EEThrowOutsideEffect(\"\")\n    ], 0, 0)\n  }\n}\n\nexport let check_perform_effects_stmt: (Stmt) -> Array[EffectError] = (stmt) -> {\n  check_perform_effects_stmt_tx(stmt, Array::slice([\n    \"\"\n  ], 0, 0), Array::slice([\n    Array::slice([\n      \"\"\n    ], 0, 0)\n  ], 0, 0))\n}\n\nlet push_env_fn_eff: (String, Type, Array[String], Array[Array[String]]) -> Unit = (name, ty, fn_names, fn_effs) -> {\n  let fnty = match ty {\n    CtForAll(_, _, body) => body,\n    _ => ty\n  }\n  match fnty {\n    CtFn(_, _, eff) => {\n      let labels = effect_decl_labels(eff)\n      if Array::length(labels) > 0 {\n        Array::push(fn_names, name)\n        Array::push(fn_effs, labels)\n      } else {\n        ()\n      }\n    },\n    _ => ()\n  }\n}\n\nlet seed_env_fn_effs: (TypeEnv, Array[String], Array[Array[String]]) -> Unit = (env, fn_names, fn_effs) -> {\n  let mut cur = env\n  let mut looping = true\n  while looping {\n    match cur {\n      EnvBind(name, ty, rest) => {\n        push_env_fn_eff(name, ty, fn_names, fn_effs)\n        cur = rest\n      },\n      EnvTraitDef(_, _, _, _, rest) => {\n        cur = rest\n      },\n      EnvTraitImpl(_, _, rest) => {\n        cur = rest\n      },\n      EnvTraitImplGen(_, _, _, _, rest) => {\n        cur = rest\n      },\n      EnvCached(_, rest) => {\n        cur = rest\n      },\n      EnvFlat(entries) => {\n        let mut ei = 0\n        while ei < Array::length(entries) {\n          let (ename, ety) = Array::get(entries, ei)\n          push_env_fn_eff(ename, ety, fn_names, fn_effs)\n          ei = ei + 1\n        }\n        looping = false\n      },\n      EnvEmpty => {\n        looping = false\n      }\n    }\n  }\n}\n\nlet build_perform_fn_effs: (Array[Stmt], Array[String], Array[Array[String]]) -> Unit = (stmts, fn_names, fn_effs) -> {\n  let mut m = 0\n  while m < Array::length(stmts) {\n    match Array::get(stmts, m) {\n      SLet(_, _, name, ty, body) => {\n        Array::push(fn_names, name)\n        Array::push(fn_effs, fn_binding_effects(ty, body))\n      },\n      SLetMut(name, ty, body) => {\n        Array::push(fn_names, name)\n        Array::push(fn_effs, fn_binding_effects(ty, body))\n      },\n      _ => ()\n    }\n    m = m + 1\n  }\n}\n\nexport let check_perform_effects_stmts: (Array[Stmt]) -> Array[EffectError] = (stmts) -> {\n  check_perform_effects_stmts_env(stmts, EnvEmpty)\n}\n\nexport let check_perform_effects_stmts_env: (Array[Stmt], TypeEnv) -> Array[EffectError] = (stmts, env) -> {\n  let fn_names = Array::slice([\n    \"\"\n  ], 0, 0)\n  let fn_effs = Array::slice([\n    Array::slice([\n      \"\"\n    ], 0, 0)\n  ], 0, 0)\n  build_perform_fn_effs(stmts, fn_names, fn_effs)\n  seed_env_fn_effs(env, fn_names, fn_effs)\n  let errors = Array::slice([\n    EEThrowOutsideEffect(\"\")\n  ], 0, 0)\n  let mut i = 0\n  while i < Array::length(stmts) {\n    append_eff_errs(errors, check_perform_effects_stmt_tx(Array::get(stmts, i), fn_names, fn_effs))\n    i = i + 1\n  }\n  errors\n}\n\nexport let file_tests_cacheable: (Array[Stmt]) -> Bool = (stmts) -> {\n  let fn_names = Array::slice([\n    \"\"\n  ], 0, 0)\n  let fn_effs = Array::slice([\n    Array::slice([\n      \"\"\n    ], 0, 0)\n  ], 0, 0)\n  let mut m = 0\n  while m < Array::length(stmts) {\n    match Array::get(stmts, m) {\n      SLet(_, _, name, ty, body) => {\n        Array::push(fn_names, name)\n        Array::push(fn_effs, fn_binding_effects(ty, body))\n      },\n      SLetMut(name, ty, body) => {\n        Array::push(fn_names, name)\n        Array::push(fn_effs, fn_binding_effects(ty, body))\n      },\n      _ => ()\n    }\n    m = m + 1\n  }\n  let empty_decl = Array::slice([\n    \"\"\n  ], 0, 0)\n  let mut any_test = false\n  let mut all_ok = true\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      STest(_, body) => {\n        any_test = true\n        let errs = check_perform_effects_expr_tx(body, empty_decl, false, fn_names, fn_effs)\n        if Array::length(errs) != 0 {\n          all_ok = false\n        } else {\n          ()\n        }\n      },\n      _ => ()\n    }\n    i = i + 1\n  }\n  any_test && all_ok\n}\n\n\nlet mut_has: (Array[String], String) -> Bool = (xs, n) -> {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(xs) {\n    if Array::get(xs, i) == n {\n      found = true\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  found\n}\n\nlet mut_with: (Array[String], String) -> Array[String] = (base, name) -> {\n  let out = Array::slice(base, 0, Array::length(base))\n  Array::push(out, name)\n  out\n}\n\nlet rec collect_pat_binds_into: (Pat, Array[String]) -> Unit = (pat, acc) -> {\n  match pat {\n    PBind(name) => Array::push(acc, name),\n    PCtor(_, subs) => {\n      let mut i = 0\n      while i < Array::length(subs) {\n        collect_pat_binds_into(Array::get(subs, i), acc)\n        i = i + 1\n      }\n    },\n    PTuple(subs) => {\n      let mut i = 0\n      while i < Array::length(subs) {\n        collect_pat_binds_into(Array::get(subs, i), acc)\n        i = i + 1\n      }\n    },\n    POr(l, r) => {\n      collect_pat_binds_into(l, acc)\n      collect_pat_binds_into(r, acc)\n    },\n    PStruct(_, fields) => {\n      let mut i = 0\n      while i < Array::length(fields) {\n        let (_, fp) = Array::get(fields, i)\n        collect_pat_binds_into(fp, acc)\n        i = i + 1\n      }\n    },\n    _ => ()\n  }\n}\n\nlet mut_with_pat: (Array[String], Pat) -> Array[String] = (base, pat) -> {\n  let out = Array::slice(base, 0, Array::length(base))\n  collect_pat_binds_into(pat, out)\n  out\n}\n\nlet mut_with_params: (Array[String], Array[(String, Option[TypeExpr])]) -> Array[String] = (base, params) -> {\n  let out = Array::slice(base, 0, Array::length(base))\n  let mut i = 0\n  while i < Array::length(params) {\n    let (pname, _) = Array::get(params, i)\n    Array::push(out, pname)\n    i = i + 1\n  }\n  out\n}\n\nexport let rec check_mutability_expr: (Expr, Array[String]) -> Array[EffectError] = (expr, mutable) -> {\n  let errors = Array::slice([\n    EEThrowOutsideEffect(\"\")\n  ], 0, 0)\n  match expr {\n    ECall(callee, args, _) => {\n      append_eff_errs(errors, check_mutability_expr(callee, mutable))\n      let mut ai = 0\n      while ai < Array::length(args) {\n        append_eff_errs(errors, check_mutability_expr(Array::get(args, ai), mutable))\n        ai = ai + 1\n      }\n      errors\n    },\n    EFn(_, _, params, _, _, body) => {\n      append_eff_errs(errors, check_mutability_expr(body, mut_with_params(mutable, params)))\n      errors\n    },\n    EHandle(body, arms) => {\n      append_eff_errs(errors, check_mutability_expr(body, mutable))\n      let mut ai = 0\n      while ai < Array::length(arms) {\n        let (pat, arm_body) = Array::get(arms, ai)\n        append_eff_errs(errors, check_mutability_expr(arm_body, mut_with_pat(mutable, pat)))\n        ai = ai + 1\n      }\n      errors\n    },\n    ELet(_, val, body, _) => {\n      append_eff_errs(errors, check_mutability_expr(val, mutable))\n      append_eff_errs(errors, check_mutability_expr(body, mutable))\n      errors\n    },\n    ELetRec(_, val, body) => {\n      append_eff_errs(errors, check_mutability_expr(val, mutable))\n      append_eff_errs(errors, check_mutability_expr(body, mutable))\n      errors\n    },\n    ELetMut(name, val, body, _) => {\n      append_eff_errs(errors, check_mutability_expr(val, mutable))\n      append_eff_errs(errors, check_mutability_expr(body, mut_with(mutable, name)))\n      errors\n    },\n    ESeq(a, b) => {\n      append_eff_errs(errors, check_mutability_expr(a, mutable))\n      append_eff_errs(errors, check_mutability_expr(b, mutable))\n      errors\n    },\n    EIf(cond, then_e, else_e) => {\n      append_eff_errs(errors, check_mutability_expr(cond, mutable))\n      append_eff_errs(errors, check_mutability_expr(then_e, mutable))\n      append_eff_errs(errors, check_mutability_expr(else_e, mutable))\n      errors\n    },\n    EMatch(scrutinee, arms) => {\n      append_eff_errs(errors, check_mutability_expr(scrutinee, mutable))\n      let mut ai = 0\n      while ai < Array::length(arms) {\n        let (pat, arm_body) = Array::get(arms, ai)\n        append_eff_errs(errors, check_mutability_expr(arm_body, mut_with_pat(mutable, pat)))\n        ai = ai + 1\n      }\n      errors\n    },\n    EWhile(cond, body) => {\n      append_eff_errs(errors, check_mutability_expr(cond, mutable))\n      append_eff_errs(errors, check_mutability_expr(body, mutable))\n      errors\n    },\n    ELoop(params, body) => {\n      let loopmut = Array::slice(mutable, 0, Array::length(mutable))\n      let mut i = 0\n      while i < Array::length(params) {\n        let (pname, init) = Array::get(params, i)\n        append_eff_errs(errors, check_mutability_expr(init, mutable))\n        Array::push(loopmut, pname)\n        i = i + 1\n      }\n      append_eff_errs(errors, check_mutability_expr(body, loopmut))\n      errors\n    },\n    EForIn(name, index_name, iter, body) => {\n      append_eff_errs(errors, check_mutability_expr(iter, mutable))\n      let base = mut_with(mutable, name)\n      let formut = match index_name {\n        Some(idx) => mut_with(base, idx),\n        None => base\n      }\n      append_eff_errs(errors, check_mutability_expr(body, formut))\n      errors\n    },\n    EBinOp(_, left, right) => {\n      append_eff_errs(errors, check_mutability_expr(left, mutable))\n      append_eff_errs(errors, check_mutability_expr(right, mutable))\n      errors\n    },\n    EReturn(e) => check_mutability_expr(e, mutable),\n    EUnaryOp(_, operand) => check_mutability_expr(operand, mutable),\n    EThrow(e) => check_mutability_expr(e, mutable),\n    EAssign(name, val, cont) => {\n      if !mut_has(mutable, name) {\n        Array::push(errors, EEAssignImmutable(name))\n      } else {\n        ()\n      }\n      append_eff_errs(errors, check_mutability_expr(val, mutable))\n      append_eff_errs(errors, check_mutability_expr(cont, mutable))\n      errors\n    },\n    EAssignOp(name, _, val, cont) => {\n      if !mut_has(mutable, name) {\n        Array::push(errors, EEAssignImmutable(name))\n      } else {\n        ()\n      }\n      append_eff_errs(errors, check_mutability_expr(val, mutable))\n      append_eff_errs(errors, check_mutability_expr(cont, mutable))\n      errors\n    },\n    EDot(obj, _, _, _) => check_mutability_expr(obj, mutable),\n    ETuple(elems) => {\n      let mut ei = 0\n      while ei < Array::length(elems) {\n        append_eff_errs(errors, check_mutability_expr(Array::get(elems, ei), mutable))\n        ei = ei + 1\n      }\n      errors\n    },\n    EArray(elems) => {\n      let mut ei = 0\n      while ei < Array::length(elems) {\n        append_eff_errs(errors, check_mutability_expr(Array::get(elems, ei), mutable))\n        ei = ei + 1\n      }\n      errors\n    },\n    ERecord(_, fields) => {\n      let mut fi = 0\n      while fi < Array::length(fields) {\n        let (_, fval) = Array::get(fields, fi)\n        append_eff_errs(errors, check_mutability_expr(fval, mutable))\n        fi = fi + 1\n      }\n      errors\n    },\n    EMap(entries) => {\n      let mut mi = 0\n      while mi < Array::length(entries) {\n        let (_, mval) = Array::get(entries, mi)\n        append_eff_errs(errors, check_mutability_expr(mval, mutable))\n        mi = mi + 1\n      }\n      errors\n    },\n    ELabeledArg(_, _, inner) => check_mutability_expr(inner, mutable),\n    ESpread(inner) => check_mutability_expr(inner, mutable),\n    EBreak(opt) => match opt {\n      Some(e) => check_mutability_expr(e, mutable),\n      None => errors\n    },\n    EContinue(cargs) => {\n      let mut ci = 0\n      while ci < Array::length(cargs) {\n        append_eff_errs(errors, check_mutability_expr(Array::get(cargs, ci), mutable))\n        ci = ci + 1\n      }\n      errors\n    },\n    _ => errors\n  }\n}\n\nlet check_mutability_binding: (Expr, Array[String]) -> Array[EffectError] = (body, outer) -> {\n  match body {\n    EFn(_, _, params, _, _, fbody) => check_mutability_expr(fbody, mut_with_params(outer, params)),\n    _ => check_mutability_expr(body, outer)\n  }\n}\n\nexport let check_mutability_stmts: (Array[Stmt]) -> Array[EffectError] = (stmts) -> {\n  let errors = Array::slice([\n    EEThrowOutsideEffect(\"\")\n  ], 0, 0)\n  let mut mutable = Array::slice([\n    \"\"\n  ], 0, 0)\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SLet(_, _, _, _, body) => append_eff_errs(errors, check_mutability_binding(body, mutable)),\n      SLetMut(name, _, body) => {\n        append_eff_errs(errors, check_mutability_binding(body, mutable))\n        mutable = mut_with(mutable, name)\n      },\n      STest(_, body) => append_eff_errs(errors, check_mutability_expr(body, Array::slice([\n        \"\"\n      ], 0, 0))),\n      SBench(_, body) => append_eff_errs(errors, check_mutability_expr(body, Array::slice([\n        \"\"\n      ], 0, 0))),\n      SExpr(e) => append_eff_errs(errors, check_mutability_expr(e, mutable)),\n      _ => ()\n    }\n    i = i + 1\n  }\n  errors\n}\n")
}

let selfhost_source_52 = () -> (String, String) {
  ("lib/@vibe/compiler/checker/checker.vibe",
"\n\n\n\n\n\n\nlet min_int: (Int, Int) -> Int = (a, b) -> {\n  if a < b {\n    a\n  } else {\n    b\n  }\n}\n\nlet off_marker: (Int) -> String = (off) -> {\n  if off >= 0 {\n    String::concat(\" [@off=\", String::concat(__to_string(off), \"]\"))\n  } else {\n    \"\"\n  }\n}\n\nlet off_marker_len: (Int, Int) -> String = (off, len) -> {\n  if off >= 0 && len > 0 {\n    String::concat(\" [@off=\", String::concat(__to_string(off), String::concat(\":\", String::concat(__to_string(off + len), \"]\"))))\n  } else {\n    off_marker(off)\n  }\n}\n\nlet prepend_expr: (Expr, Array[Expr]) -> Array[Expr] = (first, rest) -> {\n  let out = Array::slice([\n    EUnit\n  ], 0, 0)\n  Array::push(out, first)\n  let mut i = 0\n  while i < Array::length(rest) {\n    Array::push(out, Array::get(rest, i))\n    i = i + 1\n  }\n  out\n}\n\nlet rec subst_self_in_type: (Type, Type) -> Type = (ty, self_ty) -> {\n  match ty {\n    CtNamed(n, args) => if n == \"Self\" {\n      self_ty\n    } else {\n      let ra = for a in args {\n        subst_self_in_type(a, self_ty)\n      }\n      CtNamed(n, ra)\n    },\n    CtArray(e) => CtArray(subst_self_in_type(e, self_ty)),\n    CtOption(e) => CtOption(subst_self_in_type(e, self_ty)),\n    CtTuple(elems) => CtTuple(for e in elems {\n      subst_self_in_type(e, self_ty)\n    }),\n    CtFn(ps, ret, eff) => CtFn(for p in ps {\n      subst_self_in_type(p, self_ty)\n    }, subst_self_in_type(ret, self_ty), eff),\n    _ => ty\n  }\n}\n\nlet rec relax_unknown_named: (Type, Array[TypeDef]) -> Type = (ty, defs) -> {\n  match ty {\n    CtNamed(n, args) => {\n      let known = match find_typedef(defs, n) {\n        Some(_) => true,\n        None => match resolve_builtin(n) {\n          Some(_) => true,\n          None => false\n        }\n      }\n      if known {\n        CtNamed(n, for a in args {\n          relax_unknown_named(a, defs)\n        })\n      } else {\n        CtUnknown\n      }\n    },\n    CtArray(e) => CtArray(relax_unknown_named(e, defs)),\n    CtOption(e) => CtOption(relax_unknown_named(e, defs)),\n    CtTuple(es) => CtTuple(for e in es {\n      relax_unknown_named(e, defs)\n    }),\n    CtFn(ps, r, eff) => CtFn(for p in ps {\n      relax_unknown_named(p, defs)\n    }, relax_unknown_named(r, defs), eff),\n    _ => ty\n  }\n}\n\nlet resolve_trait_method_ident: (String, TypeEnv, Array[TypeDef], Subst) -> Option[Type] = (name, env, defs, s) -> {\n  let idx = String::index_of(name, \"::\")\n  if idx < 0 {\n    None\n  } else {\n    let head = String::substring(name, 0, idx)\n    let method = String::substring(name, idx + 2, String::length(name))\n    match env_lookup(env, head) {\n      Some(head_ty) => match head_ty {\n        CtVar(vid) => {\n          let bounds = subst_bounds_for(s, vid)\n          let self_ty = CtVar(vid)\n          let mut result = None\n          let mut bi = 0\n          while bi < Array::length(bounds) {\n            let pending = match result {\n              None => true,\n              _ => false\n            }\n            if pending {\n              let trait_name = Array::get(bounds, bi)\n              match trait_method_sig_deep(env, trait_name, method) {\n                Some(sig) => {\n                  let (params_te, ret_te) = sig\n                  let resolved_params = for pte in params_te {\n                    relax_unknown_named(subst_self_in_type(resolve_type_expr(pte, defs), self_ty), defs)\n                  }\n                  let resolved_ret = relax_unknown_named(subst_self_in_type(resolve_type_expr(ret_te, defs), self_ty), defs)\n                  result = Some(CtFn(resolved_params, resolved_ret, None))\n                },\n                None => ()\n              }\n            } else {\n              ()\n            }\n            bi = bi + 1\n          }\n          result\n        },\n        _ => None\n      },\n      None => None\n    }\n  }\n}\n\nlet resolve_qualified_ctor_ident: (String, TypeEnv, Array[TypeDef]) -> Option[Type] = (name, env, defs) -> {\n  let idx = String::index_of(name, \"::\")\n  if idx < 0 {\n    None\n  } else {\n    let head = String::substring(name, 0, idx)\n    let member = String::substring(name, idx + 2, String::length(name))\n    match find_typedef(defs, head) {\n      Some(TDEnum(_, _, variants)) => {\n        let mut found = false\n        let mut vi = 0\n        while vi < Array::length(variants) {\n          let (vname, _) = Array::get(variants, vi)\n          if vname == member {\n            found = true\n          } else {\n            ()\n          }\n          vi = vi + 1\n        }\n        if found {\n          env_lookup(env, member)\n        } else {\n          None\n        }\n      },\n      _ => None\n    }\n  }\n}\n\nlet expr_ident_name_or_empty: (Expr) -> String = (expr) -> {\n  match expr {\n    EIdent(name, _) => name,\n    _ => \"\"\n  }\n}\n\nlet rec strip_effects: (Type) -> Type = (ty) -> {\n  match ty {\n    CtFn(params, ret, _) => {\n      let out = Array::slice([\n        CtUnknown\n      ], 0, 0)\n      let mut i = 0\n      while i < Array::length(params) {\n        Array::push(out, strip_effects(Array::get(params, i)))\n        i = i + 1\n      }\n      CtFn(out, strip_effects(ret), None)\n    },\n    CtArray(elem) => CtArray(strip_effects(elem)),\n    CtOption(elem) => CtOption(strip_effects(elem)),\n    CtTuple(elems) => {\n      let out = Array::slice([\n        CtUnknown\n      ], 0, 0)\n      let mut i = 0\n      while i < Array::length(elems) {\n        Array::push(out, strip_effects(Array::get(elems, i)))\n        i = i + 1\n      }\n      CtTuple(out)\n    },\n    CtNamed(name, args) => {\n      let out = Array::slice([\n        CtUnknown\n      ], 0, 0)\n      let mut i = 0\n      while i < Array::length(args) {\n        Array::push(out, strip_effects(Array::get(args, i)))\n        i = i + 1\n      }\n      CtNamed(name, out)\n    },\n    _ => ty\n  }\n}\n\nlet rec arm_body_diverges: (Expr) -> Bool = (body) -> {\n  match body {\n    EReturn(_) => true,\n    ESeq(_, rest) => arm_body_diverges(rest),\n    _ => false\n  }\n}\n\nlet rec type_is_ground: (Type) -> Bool = (t) -> {\n  match t {\n    CtNamed(_, _) => false,\n    CtVar(_) => false,\n    CtForAll(_, _, _) => false,\n    CtTuple(items) => {\n      let mut ok = true\n      let mut i = 0\n      while i < Array::length(items) {\n        if !type_is_ground(Array::get(items, i)) {\n          ok = false\n        }\n        i = i + 1\n      }\n      ok\n    },\n    CtArray(e) => type_is_ground(e),\n    CtOption(e) => type_is_ground(e),\n    CtFn(ps, r, _) => {\n      let mut ok = type_is_ground(r)\n      let mut i = 0\n      while i < Array::length(ps) {\n        if !type_is_ground(Array::get(ps, i)) {\n          ok = false\n        }\n        i = i + 1\n      }\n      ok\n    },\n    _ => true\n  }\n}\n\nlet rec type_no_named: (Type) -> Bool = (t) -> {\n  match t {\n    CtNamed(_, _) => false,\n    CtForAll(_, _, _) => false,\n    CtTuple(items) => {\n      let mut ok = true\n      let mut i = 0\n      while i < Array::length(items) {\n        if !type_no_named(Array::get(items, i)) {\n          ok = false\n        }\n        i = i + 1\n      }\n      ok\n    },\n    CtArray(e) => type_no_named(e),\n    CtOption(e) => type_no_named(e),\n    CtFn(ps, r, _) => {\n      let mut ok = type_no_named(r)\n      let mut i = 0\n      while i < Array::length(ps) {\n        if !type_no_named(Array::get(ps, i)) {\n          ok = false\n        }\n        i = i + 1\n      }\n      ok\n    },\n    _ => true\n  }\n}\n\nlet head_kind: (Type) -> Int = (t) -> {\n  match t {\n    CtInt => 1,\n    CtDouble => 2,\n    CtBool => 3,\n    CtString => 4,\n    CtChar => 5,\n    CtUnit => 6,\n    CtBytes => 7,\n    CtTuple(_) => 8,\n    CtArray(_) => 9,\n    CtOption(_) => 10,\n    CtStruct(_) => 11,\n    CtEnum(_) => 12,\n    CtFn(_, _, _) => 13,\n    _ => 0\n  }\n}\n\nlet struct_fields_ground: (Array[(String, Type)]) -> Bool = (dfields) -> {\n  let mut ok = true\n  let mut i = 0\n  while i < Array::length(dfields) {\n    let (_, ft) = Array::get(dfields, i)\n    if !type_is_ground(ft) {\n      ok = false\n    }\n    i = i + 1\n  }\n  ok\n}\n\nexport let check_assignable: (Type, Type, Subst, Array[String], String, Int) -> Subst = (expected, actual, s, errors, what, off) -> {\n  match unify(expected, actual, s) {\n    Some(su) => su,\n    None => {\n      let structural = match unify(strip_effects(expected), strip_effects(actual), s) {\n        Some(_) => true,\n        None => false\n      }\n      let reportable = type_is_ground(subst_apply(s, expected)) && type_no_named(subst_apply(s, actual))\n      let eh = head_kind(subst_apply(s, expected))\n      let ah = head_kind(subst_apply(s, actual))\n      let head_differ = eh != 0 && ah != 0 && eh != ah\n      if structural || !(reportable || head_differ) {\n        s\n      } else {\n        Array::push(errors, String::concat(what, String::concat(\": expected \", String::concat(type_to_string(subst_apply(s, expected)), String::concat(\", got \", String::concat(type_to_string(subst_apply(s, actual)), off_marker(off)))))))\n        s\n      }\n    }\n  }\n}\n\nlet struct_field_names_match: (Array[(String, Type)], Array[(String, Type)]) -> Bool = (declared, actual) -> {\n  if Array::length(declared) != Array::length(actual) {\n    false\n  } else {\n    let mut i = 0\n    let mut ok = true\n    while i < Array::length(declared) {\n      let (dn, _) = Array::get(declared, i)\n      let mut found = false\n      let mut j = 0\n      while j < Array::length(actual) {\n        let (an, _) = Array::get(actual, j)\n        if an == dn {\n          found = true\n        }\n        j = j + 1\n      }\n      if !found {\n        ok = false\n      }\n      i = i + 1\n    }\n    ok\n  }\n}\n\nlet effect_op_sig: (Array[TypeDef], String) -> Option[(Array[Type], Type)] = (defs, qname) -> {\n  let ci = String::index_of(qname, \"::\")\n  if ci < 0 {\n    None\n  } else {\n    let eff = String::substring(qname, 0, ci)\n    let op = String::substring(qname, ci + 2, String::length(qname))\n    match find_typedef(defs, eff) {\n      Some(td) => match td {\n        TDEffect(_, ops) => {\n          let mut oi = 0\n          let mut found = None\n          while oi < Array::length(ops) {\n            let (oname, oparams, oret) = Array::get(ops, oi)\n            if oname == op {\n              found = Some((oparams, oret))\n            } else {\n              ()\n            }\n            oi = oi + 1\n          }\n          found\n        },\n        _ => None\n      },\n      None => None\n    }\n  }\n}\n\nlet effect_is_declared: (Array[TypeDef], String) -> Bool = (defs, eff) -> {\n  match find_typedef(defs, eff) {\n    Some(td) => match td {\n      TDEffect(_, _) => true,\n      _ => false\n    },\n    None => false\n  }\n}\n\nlet lookup_actual_field_ty: (Array[(String, Type)], String) -> Option[Type] = (actual, name) -> {\n  let mut i = 0\n  let mut out = None\n  while i < Array::length(actual) {\n    let (an, at) = Array::get(actual, i)\n    if an == name {\n      out = Some(at)\n    }\n    i = i + 1\n  }\n  out\n}\n\nlet struct_is_strict_superset: (Array[(String, Type)], Array[(String, Type)]) -> Bool = (dfields, actual) -> {\n  if Array::length(dfields) <= Array::length(actual) {\n    false\n  } else {\n    let mut i = 0\n    let mut all_in = true\n    while i < Array::length(actual) {\n      let (an, _) = Array::get(actual, i)\n      let mut found = false\n      let mut j = 0\n      while j < Array::length(dfields) {\n        let (dn, _) = Array::get(dfields, j)\n        if dn == an {\n          found = true\n        } else {\n          ()\n        }\n        j = j + 1\n      }\n      if !found {\n        all_in = false\n      } else {\n        ()\n      }\n      i = i + 1\n    }\n    all_in\n  }\n}\n\nlet check_record_fields: (Array[TypeDef], Array[(String, Type)], Subst, Array[String]) -> Subst = (defs, actual, s, errors) -> {\n  let mut matchct = 0\n  let mut matched_fields = Array::slice([\n    (\"\", CtUnknown)\n  ], 0, 0)\n  let mut di = 0\n  while di < Array::length(defs) {\n    match Array::get(defs, di) {\n      TDStruct(_, dfields, _) => if struct_field_names_match(dfields, actual) {\n        matchct = matchct + 1\n        matched_fields = dfields\n      },\n      _ => ()\n    }\n    di = di + 1\n  }\n  if matchct == 1 {\n    let mut out = s\n    let mut i = 0\n    while i < Array::length(matched_fields) {\n      let (fname, declared_ty) = Array::get(matched_fields, i)\n      match lookup_actual_field_ty(actual, fname) {\n        Some(actual_ty) => {\n          out = check_assignable(declared_ty, subst_apply(out, actual_ty), out, errors, String::concat(\"struct field type mismatch for \", fname), 0 - 1)\n        },\n        None => ()\n      }\n      i = i + 1\n    }\n    out\n  } else if matchct > 1 {\n    s\n  } else {\n    let mut supct = 0\n    let mut sup_name = \"\"\n    let mut sup_fields = Array::slice([\n      (\"\", CtUnknown)\n    ], 0, 0)\n    let mut dj = 0\n    while dj < Array::length(defs) {\n      match Array::get(defs, dj) {\n        TDStruct(sname, dfields, _) => if struct_is_strict_superset(dfields, actual) {\n          supct = supct + 1\n          sup_name = sname\n          sup_fields = dfields\n        },\n        _ => ()\n      }\n      dj = dj + 1\n    }\n    if supct == 1 {\n      let mut fi = 0\n      while fi < Array::length(sup_fields) {\n        let (dn, _) = Array::get(sup_fields, fi)\n        match lookup_actual_field_ty(actual, dn) {\n          Some(_) => (),\n          None => Array::push(errors, String::concat(\"missing field `\", String::concat(dn, String::concat(\"` in construction of struct \", sup_name))))\n        }\n        fi = fi + 1\n      }\n      s\n    } else {\n      s\n    }\n  }\n}\n\nlet resolve_record_struct_name: (Array[TypeDef], Array[(String, Type)]) -> Option[String] = (defs, actual) -> {\n  let mut matchct = 0\n  let mut out = None\n  let mut ground = false\n  let mut di = 0\n  while di < Array::length(defs) {\n    match Array::get(defs, di) {\n      TDStruct(sname, dfields, _) => if struct_field_names_match(dfields, actual) {\n        matchct = matchct + 1\n        out = Some(sname)\n        ground = struct_fields_ground(dfields)\n      },\n      _ => ()\n    }\n    di = di + 1\n  }\n  if matchct == 1 && ground {\n    out\n  } else {\n    None\n  }\n}\n\nlet unify_call_args: (Array[Type], Array[Type], Subst, Array[String], String, Int) -> Subst = (param_tys, arg_tys, s, errors, label, off) -> {\n  let mut out = s\n  let mut ui = 0\n  let ul = min_int(Array::length(arg_tys), Array::length(param_tys))\n  while ui < ul {\n    let pty = Array::get(param_tys, ui)\n    let aty = Array::get(arg_tys, ui)\n    out = if label == \"__to_string\" {\n      match unify(pty, aty, out) {\n        Some(su) => su,\n        None => out\n      }\n    } else {\n      check_assignable(pty, aty, out, errors, String::concat(\"argument type mismatch for \", label), off)\n    }\n    ui = ui + 1\n  }\n  out\n}\n\nexport let fn_return_env_name: (String) -> String = (name) -> {\n  String::concat(\"__fn_ret__:\", name)\n}\n\nlet direct_builtin_return: (String) -> Option[Type] = (name) -> {\n  if name == \"Bytes::length\" {\n    Some(CtInt)\n  }\n  else if name == \"iter_length\" || name == \"String::iter_length\" || name == \"Map::iter_length\" {\n    Some(CtInt)\n  }\n  else if name == \"Array::length\" {\n    Some(CtInt)\n  }\n  else if name == \"FixedArray::length\" {\n    Some(CtInt)\n  }\n  else if name == \"String::length\" {\n    Some(CtInt)\n  }\n  else if name == \"Bytes::get\" || name == \"String::index_of\" || name == \"String::char_code_at\" || name == \"String::last_index_of\" || name == \"Char::to_int\" || name == \"Double::to_int\" || name == \"Double::to_i64_bits\" || name == \"Double::to_i64_bits_lo\" || name == \"Double::to_i64_bits_hi\" || name == \"Env::args_len\" || name == \"Stdin::read_char\" {\n    Some(CtInt)\n  }\n  else if name == \"String::equals\" || name == \"String::contains\" || name == \"String::starts_with\" || name == \"String::ends_with\" || name == \"Array::any\" || name == \"Array::all\" || name == \"Array::contains\" || name == \"Map::has_key\" || name == \"map_has\" || name == \"Path::is_absolute\" || name == \"Fs::exists\" || name == \"Fs::is_dir\" || name == \"Fs::is_file\" || name == \"eq\" || name == \"not\" {\n    Some(CtBool)\n  }\n  else if name == \"String::concat\" || name == \"String::substring\" || name == \"String::trim\" || name == \"String::to_lower\" || name == \"String::to_upper\" || name == \"String::from_char_code\" || name == \"String::join\" || name == \"Array::join\" || name == \"Path::to_string\" || name == \"Path::resolve\" || name == \"PromptText::new\" || name == \"Stdin::read_stream\" || name == \"Env::get\" || name == \"Env::args_get\" || name == \"Fs::read_file\" || name == \"Fs::getcwd\" || name == \"sh\" || name == \"Lines::stringify\" || name == \"Llm::complete\" || name == \"Rlm::run\" || name == \"Rlm::finalize\" || name == \"__to_string\" {\n    Some(CtString)\n  }\n  else if name == \"__len\" {\n    Some(CtInt)\n  }\n  else if name == \"String::iter_get\" {\n    Some(CtInt)\n  }\n  else if name == \"iter_get\" || name == \"Map::iter_get\" || name == \"iter_require\" || name == \"__neg\" {\n    Some(CtUnknown)\n  }\n  else if name == \"Bytes::new\" || name == \"Bytes::concat\" || name == \"Bytes::slice\" || name == \"Bytes::from_array\" || name == \"Fs::read_bytes\" {\n    Some(CtBytes)\n  }\n  else if name == \"Array::set\" || name == \"Array::push\" || name == \"Array::push_all\" || name == \"Array::truncate\" || name == \"Array::foreach\" || name == \"FixedArray::set\" || name == \"FixedArray::blit\" || name == \"FixedArray::unsafe_set\" || name == \"Bytes::set\" || name == \"Bytes::push\" || name == \"Bytes::append\" || name == \"Bytes::blit\" || name == \"Bytes::fill\" || name == \"MapBuilder::set\" || name == \"Stdout::write_char\" || name == \"Stdout::write_stream\" || name == \"sleep\" || name == \"Fs::copy\" || name == \"Fs::chdir\" || name == \"Fs::mkdir\" || name == \"Fs::mkdir_p\" || name == \"Fs::append\" || name == \"Fs::remove\" || name == \"Fs::rename\" || name == \"Fs::write_file\" || name == \"Fs::write_bytes\" || name == \"print\" || name == \"println\" || name == \"assert\" || name == \"assert_true\" || name == \"assert_eq\" || name == \"__set_field\" {\n    Some(CtUnit)\n  }\n  else if name == \"Double::from_i64_bits\" || name == \"Int::to_double\" || name == \"Double::to_float\" || name == \"Float::to_double\" {\n    Some(CtDouble)\n  }\n  else if name == \"Char::from_int\" {\n    Some(CtChar)\n  }\n  else if name == \"Bytes::to_array\" {\n    Some(CtArray(CtInt))\n  }\n  else if name == \"Map::keys\" || name == \"sh_lines\" || name == \"Lines::parse\" {\n    Some(CtArray(CtString))\n  }\n  else if name == \"Array::slice\" || name == \"Array::concat\" || name == \"Array::filter\" || name == \"Array::reverse\" || name == \"Array::sort\" || name == \"FixedArray::make\" {\n    Some(CtArray(CtUnknown))\n  }\n  else if name == \"Some\" || name == \"Array::find\" {\n    Some(CtOption(CtUnknown))\n  }\n  else {\n    None\n  }\n}\n\nlet direct_call_return: (TypeEnv, String) -> Option[Type] = (env, name) -> {\n  match env_lookup(env, name) {\n    Some(_) => None,\n    None => direct_builtin_return(name)\n  }\n}\n\nlet builtin_first_arg_head: (String) -> Int = (name) -> {\n  if name == \"Array::length\" || name == \"Array::get\" || name == \"Array::set\" || name == \"Array::push\" || name == \"Array::push_all\" || name == \"Array::slice\" || name == \"Array::concat\" || name == \"Array::reverse\" || name == \"Array::truncate\" || name == \"Array::foreach\" || name == \"Array::contains\" || name == \"Array::any\" || name == \"Array::all\" || name == \"Array::find\" || name == \"Array::filter\" {\n    9\n  } else if name == \"String::length\" || name == \"String::substring\" || name == \"String::trim\" || name == \"String::to_lower\" || name == \"String::to_upper\" || name == \"String::index_of\" || name == \"String::last_index_of\" || name == \"String::char_code_at\" || name == \"String::contains\" || name == \"String::starts_with\" || name == \"String::ends_with\" || name == \"String::split\" || name == \"String::concat\" {\n    4\n  } else if name == \"Bytes::length\" || name == \"Bytes::get\" || name == \"Bytes::set\" || name == \"Bytes::slice\" || name == \"Bytes::to_array\" || name == \"Bytes::push\" || name == \"Bytes::append\" || name == \"Bytes::blit\" || name == \"Bytes::fill\" {\n    7\n  } else {\n    0\n  }\n}\n\nlet builtin_arg_head_rest: (String, Int) -> Int = (name, i) -> {\n  if name == \"String::concat\" {\n    if i == 1 { 4 } else { 0 }\n  } else if name == \"String::index_of\" || name == \"String::last_index_of\" || name == \"String::contains\" || name == \"String::starts_with\" || name == \"String::ends_with\" || name == \"String::split\" {\n    if i == 1 { 4 } else { 0 }\n  } else if name == \"String::substring\" {\n    if i == 1 || i == 2 { 1 } else { 0 }\n  } else if name == \"String::char_code_at\" {\n    if i == 1 { 1 } else { 0 }\n  } else if name == \"Bytes::get\" {\n    if i == 1 { 1 } else { 0 }\n  } else if name == \"Bytes::set\" || name == \"Bytes::slice\" {\n    if i == 1 || i == 2 { 1 } else { 0 }\n  } else {\n    0\n  }\n}\n\nlet check_hof_param_vs_elem: (Type, Type, Int, Subst, Array[String], String) -> Subst = (recv_ty, fn_ty, pidx, s, errors, msg) -> {\n  match recv_ty {\n    CtArray(elem) => match fn_ty {\n      CtFn(ptys, _, _) => if Array::length(ptys) > pidx {\n        check_assignable(subst_apply(s, Array::get(ptys, pidx)), subst_apply(s, elem), s, errors, msg, 0 - 1)\n      } else {\n        s\n      },\n      _ => s\n    },\n    _ => s\n  }\n}\n\nlet check_two_array_elems: (Type, Type, Subst, Array[String], String) -> Subst = (a_app, b_app, s, errors, msg) -> {\n  match a_app {\n    CtArray(ea) => match b_app {\n      CtArray(eb) => check_assignable(subst_apply(s, ea), subst_apply(s, eb), s, errors, msg, 0 - 1),\n      _ => s\n    },\n    _ => s\n  }\n}\n\nlet struct_field_type: (Array[TypeDef], String, String) -> Option[Type] = (defs, sname, field) -> {\n  match find_typedef(defs, sname) {\n    Some(td) => match td {\n      TDStruct(_, fields, _) => {\n        let rec go: (Int) -> Option[Type] = (i) -> {\n          if i >= Array::length(fields) {\n            None\n          } else {\n            let (fname, ftype) = Array::get(fields, i)\n            if fname == field { Some(ftype) } else { go(i + 1) }\n          }\n        }\n        go(0)\n      },\n      _ => None\n    },\n    None => None\n  }\n}\n\nlet is_logic_binop: (String) -> Bool = (op) -> {\n  op == \"&&\"\n  || op == \"||\"\n}\n\nlet is_order_binop: (String) -> Bool = (op) -> {\n  op == \"<\"\n  || op == \">\"\n  || op == \"<=\"\n  || op == \">=\"\n}\n\nlet type_name_prefix: (Type) -> String = (ty) -> {\n  match ty {\n    CtInt => \"Int\",\n    CtDouble => \"Double\",\n    CtBool => \"Bool\",\n    CtString => \"String\",\n    CtChar => \"Char\",\n    CtUnit => \"Unit\",\n    CtBytes => \"Bytes\",\n    CtArray(_) => \"Array\",\n    CtOption(_) => \"Option\",\n    CtEnum(name) => name,\n    CtStruct(name) => name,\n    CtNamed(name, _) => name,\n    _ => \"\"\n  }\n}\n\nlet is_equality_binop: (String) -> Bool = (op) -> {\n  op == \"==\"\n  || op == \"!=\"\n}\n\nlet unify_binop_candidate: (Type, Type, Type, Subst) -> Option[Subst] = (left_ty, right_ty, target_ty, s) -> {\n  match unify(left_ty, target_ty, s) {\n    Some(s1) => unify(right_ty, target_ty, s1),\n    None => None\n  }\n}\n\nlet unify_same_binop_operands: (Type, Type, Subst) -> Option[(Type, Subst)] = (left_ty, right_ty, s) -> {\n  match unify(left_ty, right_ty, s) {\n    Some(s1) => Some((subst_apply(s1, left_ty), s1)),\n    None => None\n  }\n}\n\nlet infer_named_trait_binop: (TypeEnv, Type, Type, String, Subst) -> Option[(Type, Subst)] = (env, left_ty, right_ty, trait_name, s) -> {\n  match unify_same_binop_operands(left_ty, right_ty, s) {\n    Some((resolved, s1)) => if type_implements_trait(env, s1, resolved, trait_name) {\n      Some((resolved, s1))\n    } else {\n      None\n    },\n    None => None\n  }\n}\n\nlet infer_binop_type: (String, Type, Type, TypeEnv, Subst, Array[String], Array[(Int, Type)]) -> (Type, Subst) = (op, left_ty, right_ty, env, s, errors, tytab) -> {\n  if is_logic_binop(op) {\n    match unify_binop_candidate(left_ty, right_ty, CtBool, s) {\n      Some(s1) => (CtBool, s1),\n      None => {\n        Array::push(errors, String::concat(\"type mismatch in '\", String::concat(op, \"': operands must be Bool\")))\n        (CtUnknown, s)\n      }\n    }\n  }\n  else if is_equality_binop(op) {\n    match unify(left_ty, right_ty, s) {\n      Some(s1) => (CtBool, s1),\n      None => {\n        Array::push(errors, String::concat(\"type mismatch in '\", String::concat(op, \"': operands must have same type\")))\n        (CtUnknown, s)\n      }\n    }\n  }\n  else if is_order_binop(op) {\n    match unify_binop_candidate(left_ty, right_ty, CtInt, s) {\n      Some(s1) => (CtBool, s1),\n      None => match unify_binop_candidate(left_ty, right_ty, CtDouble, s) {\n        Some(s1) => (CtBool, s1),\n        None => match infer_named_trait_binop(env, left_ty, right_ty, \"Ord\", s) {\n          Some((_, s1)) => (CtBool, s1),\n          None => {\n            Array::push(errors, String::concat(\"type mismatch in '\", String::concat(op, \"': operands must be Int or Double\")))\n            (CtUnknown, s)\n          }\n        }\n      }\n    }\n  }\n  else if op == \"+\" {\n    match unify_binop_candidate(left_ty, right_ty, CtInt, s) {\n      Some(s1) => (CtInt, s1),\n      None => match unify_binop_candidate(left_ty, right_ty, CtDouble, s) {\n        Some(s1) => (CtDouble, s1),\n        None => match unify_binop_candidate(left_ty, right_ty, CtString, s) {\n          Some(s1) => (CtString, s1),\n          None => match infer_named_trait_binop(env, left_ty, right_ty, \"Add\", s) {\n            Some((resolved, s1)) => (resolved, s1),\n            None => {\n              Array::push(errors, \"type mismatch in '+': operands must be Int, Double, or String\")\n              (CtUnknown, s)\n            }\n          }\n        }\n      }\n    }\n  }\n  else if op == \"-\"\n  || op == \"*\"\n  || op == \"/\" {\n    let trait_name = if op == \"-\" {\n      \"Sub\"\n    } else if op == \"*\" {\n      \"Mul\"\n    } else {\n      \"Div\"\n    }\n    match unify_binop_candidate(left_ty, right_ty, CtInt, s) {\n      Some(s1) => (CtInt, s1),\n      None => match unify_binop_candidate(left_ty, right_ty, CtDouble, s) {\n        Some(s1) => (CtDouble, s1),\n        None => match infer_named_trait_binop(env, left_ty, right_ty, trait_name, s) {\n          Some((resolved, s1)) => (resolved, s1),\n          None => {\n            Array::push(errors, String::concat(\"type mismatch in '\", String::concat(op, \"': operands must be Int or Double\")))\n            (CtUnknown, s)\n          }\n        }\n      }\n    }\n  }\n  else if op == \"%\" {\n    match unify_binop_candidate(left_ty, right_ty, CtInt, s) {\n      Some(s1) => (CtInt, s1),\n      None => {\n        Array::push(errors, \"type mismatch in '%': operands must be Int\")\n        (CtUnknown, s)\n      }\n    }\n  }\n  else if op == \"&\" || op == \"|\" || op == \"^\" || op == \"<<\" || op == \">>\" {\n    match unify_binop_candidate(left_ty, right_ty, CtInt, s) {\n      Some(s1) => (CtInt, s1),\n      None => {\n        Array::push(errors, String::concat(\"type mismatch in '\", String::concat(op, \"': operands must be Int\")))\n        (CtUnknown, s)\n      }\n    }\n  }\n  else {\n    Array::push(errors, String::concat(\"unknown operator: \", op))\n    (CtUnknown, s)\n  }\n}\n\nlet rec resolve_tparams_in: (Type, TypeEnv) -> Type = (ty, env) -> {\n  match ty {\n    CtNamed(name, args) => {\n      let ra = for a in args {\n        resolve_tparams_in(a, env)\n      }\n      match env_lookup(env, name) {\n        Some(t) => match t {\n          CtVar(_) => t,\n          _ => CtNamed(name, ra)\n        },\n        None => CtNamed(name, ra)\n      }\n    },\n    CtArray(e) => CtArray(resolve_tparams_in(e, env)),\n    CtOption(e) => CtOption(resolve_tparams_in(e, env)),\n    CtTuple(es) => CtTuple(for e in es {\n      resolve_tparams_in(e, env)\n    }),\n    CtFn(ps, ret, eff) => {\n      let resolve_params: (Array[Type]) -> Array[Type] = (types) -> {\n        let out = Array::slice([\n          CtUnknown\n        ], 0, 0)\n        let mut i = 0\n        while i < Array::length(types) {\n          Array::push(out, resolve_tparams_in(Array::get(types, i), env))\n          i = i + 1\n        }\n        out\n      }\n      CtFn(resolve_params(ps), resolve_tparams_in(ret, env), eff)\n    },\n    _ => ty\n  }\n}\n\nlet tab_call_ty: (Array[(Int, Type)], Int, Type) -> Type = (tytab, call_off, ty) -> {\n  if call_off >= 0 {\n    Array::push(tytab, (call_off, ty))\n  } else {\n    ()\n  }\n  ty\n}\n\nlet check_seq_spine: (Expr, TypeEnv, Array[TypeDef], Subst, Int, Array[String], Array[(Int, Type)], (Expr, TypeEnv, Array[TypeDef], Subst, Int, Array[String], Array[(Int, Type)]) -> (Type, Subst, Int)) -> (Type, Subst, Int) = (expr, env, defs, s, c, errors, tytab, ce) -> {\n  let mut cur = expr\n  let mut cenv = env\n  let mut s1 = s\n  let mut c1 = c\n  let mut done = false\n  let mut result = (CtUnit, s, c)\n  while !done {\n    match cur {\n      ESeq(left, right) => {\n        let (_, ns, nc) = ce(left, cenv, defs, s1, c1, errors, tytab)\n        s1 = ns\n        c1 = nc\n        cur = right\n      },\n      ELet(name, val, body, _) => {\n        let (vt, ns, nc) = ce(val, cenv, defs, s1, c1, errors, tytab)\n        let gen = generalize(ns, vt)\n        cenv = env_bind(cenv, name, gen)\n        s1 = ns\n        c1 = nc\n        cur = body\n      },\n      ELetMut(name, val, body, _) => {\n        let (vt, ns, nc) = ce(val, cenv, defs, s1, c1, errors, tytab)\n        if name == \"__loop_result\" {\n          let (lr_tv, nc2) = fresh_var(nc)\n          cenv = env_bind(cenv, name, lr_tv)\n          c1 = nc2\n        } else {\n          cenv = env_bind(cenv, name, vt)\n          c1 = nc\n        }\n        s1 = ns\n        cur = body\n      },\n      ELetRec(name, val, body) => {\n        let (tv, c1b) = fresh_var(c1)\n        let (vt, ns, nc) = ce(val, env_bind(cenv, name, tv), defs, s1, c1b, errors, tytab)\n        let s2 = match unify(tv, vt, ns) {\n          Some(su) => su,\n          None => ns\n        }\n        let gen = generalize(s2, tv)\n        cenv = env_bind(cenv, name, gen)\n        s1 = s2\n        c1 = nc\n        cur = body\n      },\n      _ => {\n        result = ce(cur, cenv, defs, s1, c1, errors, tytab)\n        done = true\n      }\n    }\n  }\n  result\n}\n\nlet field_write_mut_check: (String, Array[Expr], TypeEnv, Array[TypeDef], Subst, Int, Array[String], Array[(Int, Type)], (Expr, TypeEnv, Array[TypeDef], Subst, Int, Array[String], Array[(Int, Type)]) -> (Type, Subst, Int)) -> Unit = (name, args, env, defs, s, c, errors, tytab, ce) -> {\n  if name == \"__set_field\" && Array::length(args) == 3 {\n    match Array::get(args, 1) {\n      EString(field) => {\n        let throwaway = Array::slice([\"\"], 0, 0)\n        let throwtab = Array::slice([(0, CtUnit)], 0, 0)\n        let (obj_ty, _, _) = ce(Array::get(args, 0), env, defs, s, c, throwaway, throwtab)\n        match subst_apply(s, obj_ty) {\n          CtStruct(sname) => match find_typedef(defs, sname) {\n            Some(TDStruct(_, dfields, mut_names)) => {\n              let mut found = false\n              let mut i = 0\n              while i < Array::length(mut_names) {\n                if Array::get(mut_names, i) == field {\n                  found = true\n                } else {\n                  ()\n                }\n                i = i + 1\n              }\n              if found {\n                ()\n              } else {\n                Array::push(errors, String::concat(\"cannot assign to non-`mut` field `\", String::concat(field, String::concat(\"` of struct \", sname))))\n              }\n              let mut fty = CtUnknown\n              let mut has_field = false\n              let mut fi = 0\n              while fi < Array::length(dfields) {\n                let (fn2, ft) = Array::get(dfields, fi)\n                if fn2 == field {\n                  fty = ft\n                  has_field = true\n                } else {\n                  ()\n                }\n                fi = fi + 1\n              }\n              if has_field {\n                let (val_ty, _, _) = ce(Array::get(args, 2), env, defs, s, c, throwaway, throwtab)\n                let _ = check_assignable(subst_apply(s, fty), subst_apply(s, val_ty), s, errors, String::concat(\"type mismatch writing field `\", String::concat(field, \"`\")), 0 - 1)\n                ()\n              } else {\n                ()\n              }\n            },\n            _ => ()\n          },\n          _ => ()\n        }\n      },\n      _ => ()\n    }\n  } else {\n    ()\n  }\n}\n\nlet index_target_check: (String, Array[Expr], TypeEnv, Array[TypeDef], Subst, Int, Array[String], (Expr, TypeEnv, Array[TypeDef], Subst, Int, Array[String], Array[(Int, Type)]) -> (Type, Subst, Int)) -> Unit = (name, args, env, defs, s, c, errors, ce) -> {\n  if name == \"__index\" && Array::length(args) == 2 {\n    let throwaway = Array::slice([\"\"], 0, 0)\n    let throwtab = Array::slice([(0, CtUnit)], 0, 0)\n    let (obj_ty, _, _) = ce(Array::get(args, 0), env, defs, s, c, throwaway, throwtab)\n    let resolved_obj = subst_apply(s, obj_ty)\n    let not_indexable = match resolved_obj {\n      CtInt => true,\n      CtDouble => true,\n      CtBool => true,\n      CtChar => true,\n      CtUnit => true,\n      _ => false\n    }\n    if not_indexable {\n      Array::push(errors, \"cannot index a non-indexable value (expected Array, String, or Bytes)\")\n    } else {\n      let indexable = match resolved_obj {\n        CtArray(_) => true,\n        CtString => true,\n        CtBytes => true,\n        _ => false\n      }\n      if indexable {\n        let throwaway2 = Array::slice([\"\"], 0, 0)\n        let throwtab2 = Array::slice([(0, CtUnit)], 0, 0)\n        let (idx_ty, _, _) = ce(Array::get(args, 1), env, defs, s, c, throwaway2, throwtab2)\n        let bad_index = match subst_apply(s, idx_ty) {\n          CtInt => false,\n          _ => type_is_ground(subst_apply(s, idx_ty))\n        }\n        if bad_index {\n          Array::push(errors, \"index must be an Int\")\n        } else {\n          ()\n        }\n      } else {\n        ()\n      }\n    }\n  } else {\n    ()\n  }\n}\n\nlet rec pat_is_catchall: (Pat) -> Bool = (pat) -> {\n  match pat {\n    PWild => true,\n    PBind(_) => true,\n    POr(l, r) => pat_is_catchall(l) || pat_is_catchall(r),\n    _ => false\n  }\n}\n\nlet rec collect_ctor_names_into: (Pat, Array[String]) -> Unit = (pat, acc) -> {\n  match pat {\n    PCtor(name, _) => Array::push(acc, name),\n    POr(l, r) => {\n      collect_ctor_names_into(l, acc)\n      collect_ctor_names_into(r, acc)\n    },\n    _ => ()\n  }\n}\n\nlet parse_tuple_index: (String) -> Option[Int] = (s) -> {\n  let len = String::length(s)\n  if len == 0 {\n    None\n  } else {\n    let mut i = 0\n    let mut val = 0\n    let mut ok = true\n    while i < len {\n      let cc = String::char_code_at(s, i)\n      if cc >= 48 && cc <= 57 {\n        val = val * 10 + (cc - 48)\n      } else {\n        ok = false\n      }\n      i = i + 1\n    }\n    if ok {\n      Some(val)\n    } else {\n      None\n    }\n  }\n}\n\nlet rec check_resume_values: (Expr, Type, TypeEnv, Array[TypeDef], Subst, Int, Array[String], Array[(Int, Type)]) -> Subst = (e, ret_ty, env, defs, s, c, errors, tytab) -> {\n  match e {\n    ECall(callee, args, _) => {\n      let mut s1 = s\n      match callee {\n        EIdent(nm, _) => {\n          if nm == \"resume\" && Array::length(args) == 1 && !(ret_ty is CtUnit) {\n            let (aty, ns, _) = check_expr(Array::get(args, 0), env, defs, s1, c, errors, tytab)\n            s1 = check_assignable(ret_ty, subst_apply(ns, aty), ns, errors, \"resume value type mismatch\", 0 - 1)\n          } else {\n            ()\n          }\n        },\n        _ => {\n          s1 = check_resume_values(callee, ret_ty, env, defs, s1, c, errors, tytab)\n        }\n      }\n      let mut ri = 0\n      while ri < Array::length(args) {\n        s1 = check_resume_values(Array::get(args, ri), ret_ty, env, defs, s1, c, errors, tytab)\n        ri = ri + 1\n      }\n      s1\n    },\n    EHandle(_, _) => s,\n    ELet(_, v, b, _) => check_resume_values(b, ret_ty, env, defs, check_resume_values(v, ret_ty, env, defs, s, c, errors, tytab), c, errors, tytab),\n    ELetMut(_, v, b, _) => check_resume_values(b, ret_ty, env, defs, check_resume_values(v, ret_ty, env, defs, s, c, errors, tytab), c, errors, tytab),\n    ELetRec(_, v, b) => check_resume_values(b, ret_ty, env, defs, check_resume_values(v, ret_ty, env, defs, s, c, errors, tytab), c, errors, tytab),\n    ESeq(a, b) => check_resume_values(b, ret_ty, env, defs, check_resume_values(a, ret_ty, env, defs, s, c, errors, tytab), c, errors, tytab),\n    EIf(cnd, t, el) => check_resume_values(el, ret_ty, env, defs, check_resume_values(t, ret_ty, env, defs, check_resume_values(cnd, ret_ty, env, defs, s, c, errors, tytab), c, errors, tytab), c, errors, tytab),\n    EMatch(scr, marms) => {\n      let mut s1 = check_resume_values(scr, ret_ty, env, defs, s, c, errors, tytab)\n      let mut mi = 0\n      while mi < Array::length(marms) {\n        let (_, mb) = Array::get(marms, mi)\n        s1 = check_resume_values(mb, ret_ty, env, defs, s1, c, errors, tytab)\n        mi = mi + 1\n      }\n      s1\n    },\n    EWhile(cnd, b) => check_resume_values(b, ret_ty, env, defs, check_resume_values(cnd, ret_ty, env, defs, s, c, errors, tytab), c, errors, tytab),\n    EForIn(_, _, it, b) => check_resume_values(b, ret_ty, env, defs, check_resume_values(it, ret_ty, env, defs, s, c, errors, tytab), c, errors, tytab),\n    EBinOp(_, l, r) => check_resume_values(r, ret_ty, env, defs, check_resume_values(l, ret_ty, env, defs, s, c, errors, tytab), c, errors, tytab),\n    EUnaryOp(_, inner) => check_resume_values(inner, ret_ty, env, defs, s, c, errors, tytab),\n    EAssign(_, v, b) => check_resume_values(b, ret_ty, env, defs, check_resume_values(v, ret_ty, env, defs, s, c, errors, tytab), c, errors, tytab),\n    EAssignOp(_, _, v, b) => check_resume_values(b, ret_ty, env, defs, check_resume_values(v, ret_ty, env, defs, s, c, errors, tytab), c, errors, tytab),\n    EFn(_, _, _, _, _, fb) => check_resume_values(fb, ret_ty, env, defs, s, c, errors, tytab),\n    EThrow(inner) => check_resume_values(inner, ret_ty, env, defs, s, c, errors, tytab),\n    EReturn(inner) => check_resume_values(inner, ret_ty, env, defs, s, c, errors, tytab),\n    EDot(obj, _, _, _) => check_resume_values(obj, ret_ty, env, defs, s, c, errors, tytab),\n    ETuple(items) => {\n      let mut s1 = s\n      let mut ti = 0\n      while ti < Array::length(items) {\n        s1 = check_resume_values(Array::get(items, ti), ret_ty, env, defs, s1, c, errors, tytab)\n        ti = ti + 1\n      }\n      s1\n    },\n    EArray(items) => {\n      let mut s1 = s\n      let mut ti = 0\n      while ti < Array::length(items) {\n        s1 = check_resume_values(Array::get(items, ti), ret_ty, env, defs, s1, c, errors, tytab)\n        ti = ti + 1\n      }\n      s1\n    },\n    _ => s\n  }\n}\n\nexport let rec check_expr: (Expr, TypeEnv, Array[TypeDef], Subst, Int, Array[String], Array[(Int, Type)]) -> (Type, Subst, Int) = (expr, env, defs, s, c, errors, tytab) -> {\n  match expr {\n    EInt(_) => (CtInt, s, c),\n    EFloat(_) => (CtDouble, s, c),\n    EString(_) => (CtString, s, c),\n    EBool(_) => (CtBool, s, c),\n    EUnit => (CtUnit, s, c),\n    EIdent(name, ident_off) => match env_lookup(env, name) {\n      Some(t) => {\n        let (ti, c1, new_bounds) = instantiate(t, c)\n        let nblen = Array::length(new_bounds)\n        let mut s1 = s\n        let mut bi = 0\n        while bi < nblen {\n          let (vid, bounds) = Array::get(new_bounds, bi)\n          if Array::length(bounds) != 0 {\n            s1 = subst_add_bound(s1, vid, bounds)\n          }\n          bi = bi + 1\n        }\n        if ident_off >= 0 {\n          Array::push(tytab, (ident_off, ti))\n        } else {\n          ()\n        }\n        (ti, s1, c1)\n      },\n      None => match lookup_builtin(name) {\n        Some(t) => {\n          if ident_off >= 0 {\n            Array::push(tytab, (ident_off, t))\n          } else {\n            ()\n          }\n          (t, s, c)\n        },\n        None => match resolve_trait_method_ident(name, env, defs, s) {\n          Some(mty) => {\n            if ident_off >= 0 {\n              Array::push(tytab, (ident_off, mty))\n            } else {\n              ()\n            }\n            (mty, s, c)\n          },\n          None => match resolve_qualified_ctor_ident(name, env, defs) {\n            Some(ct) => {\n              let (ti, c1, new_bounds) = instantiate(ct, c)\n              let nblen = Array::length(new_bounds)\n              let mut s1 = s\n              let mut bi = 0\n              while bi < nblen {\n                let (vid, bounds) = Array::get(new_bounds, bi)\n                if Array::length(bounds) != 0 {\n                  s1 = subst_add_bound(s1, vid, bounds)\n                } else {\n                  ()\n                }\n                bi = bi + 1\n              }\n              if ident_off >= 0 {\n                Array::push(tytab, (ident_off, ti))\n              } else {\n                ()\n              }\n              (ti, s1, c1)\n            },\n            None => {\n              Array::push(errors, String::concat(String::concat(\"unknown name: \", name), off_marker_len(ident_off, String::length(name))))\n              (CtUnknown, s, c)\n            }\n          }\n        }\n      }\n    },\n    ESeq(_, _) => check_seq_spine(expr, env, defs, s, c, errors, tytab, check_expr),\n    ELet(_, _, _, _) => check_seq_spine(expr, env, defs, s, c, errors, tytab, check_expr),\n    ELetRec(_, _, _) => check_seq_spine(expr, env, defs, s, c, errors, tytab, check_expr),\n    ELetMut(_, _, _, _) => check_seq_spine(expr, env, defs, s, c, errors, tytab, check_expr),\n    EIf(cond, then_e, else_e) => {\n      let (ct, s1, c1) = check_expr(cond, env, defs, s, c, errors, tytab)\n      let resolved_ct = subst_apply(s1, ct)\n      match resolved_ct {\n        CtBool => (),\n        CtUnknown => (),\n        CtVar(_) => (),\n        _ => Array::push(errors, \"if condition must be Bool\")\n      }\n      let (tt, s2, c2) = check_expr(then_e, env, defs, s1, c1, errors, tytab)\n      let (et, s3, c3) = check_expr(else_e, env, defs, s2, c2, errors, tytab)\n      let rtt = subst_apply(s3, tt)\n      let ret = subst_apply(s3, et)\n      let (s3b, if_ty) = match rtt {\n        CtUnit => (s3, CtUnit),\n        _ => match ret {\n          CtUnit => (s3, CtUnit),\n          _ => (check_assignable(rtt, ret, s3, errors, \"if branches have incompatible types\", 0 - 1), tt)\n        }\n      }\n      (if_ty, s3b, c3)\n    },\n    ECall(callee, args, call_off) => match callee {\n      EIdent(name, callee_off) => {\n        field_write_mut_check(name, args, env, defs, s, c, errors, tytab, check_expr)\n        index_target_check(name, args, env, defs, s, c, errors, check_expr)\n        if name == \"perform\" {\n        if Array::length(args) == 1 {\n          match Array::get(args, 0) {\n            ECall(op_callee, opargs, _) => {\n              let oalen = Array::length(opargs)\n              let mut s1 = s\n              let mut c1 = c\n              let oparg_tys = Array::slice([\n                CtUnknown\n              ], 0, 0)\n              let mut ai = 0\n              while ai < oalen {\n                let (oat, ns, nc) = check_expr(Array::get(opargs, ai), env, defs, s1, c1, errors, tytab)\n                Array::push(oparg_tys, oat)\n                s1 = ns\n                c1 = nc\n                ai = ai + 1\n              }\n              match op_callee {\n                EIdent(op_qname, op_off) => match effect_op_sig(defs, op_qname) {\n                  Some(sig) => {\n                    let (sig_params, sig_ret) = sig\n                    if Array::length(sig_params) != oalen {\n                      Array::push(errors, String::concat(\"perform \", String::concat(op_qname, String::concat(\" expects \", String::concat(__to_string(Array::length(sig_params)), String::concat(\" argument(s), got \", String::concat(__to_string(oalen), off_marker(op_off))))))))\n                    } else {\n                      let mut vi = 0\n                      while vi < oalen {\n                        s1 = check_assignable(Array::get(sig_params, vi), subst_apply(s1, Array::get(oparg_tys, vi)), s1, errors, String::concat(\"perform argument type mismatch for \", op_qname), op_off)\n                        vi = vi + 1\n                      }\n                    }\n                    if type_is_ground(sig_ret) {\n                      (sig_ret, s1, c1)\n                    } else {\n                      let (tv, c2) = fresh_var(c1)\n                      (tv, s1, c2)\n                    }\n                  },\n                  None => {\n                    let ci2 = String::index_of(op_qname, \"::\")\n                    if ci2 > 0 && effect_is_declared(defs, String::substring(op_qname, 0, ci2)) {\n                      Array::push(errors, String::concat(\"unknown operation `\", String::concat(String::substring(op_qname, ci2 + 2, String::length(op_qname)), String::concat(\"` of effect \", String::concat(String::substring(op_qname, 0, ci2), off_marker(op_off))))))\n                    } else {\n                      ()\n                    }\n                    let (tv, c2) = fresh_var(c1)\n                    (tv, s1, c2)\n                  }\n                },\n                _ => {\n                  let (tv, c2) = fresh_var(c1)\n                  (tv, s1, c2)\n                }\n              }\n            },\n            EIdent(_, _) => {\n              let (tv, c2) = fresh_var(c)\n              (tv, s, c2)\n            },\n            other => check_expr(other, env, defs, s, c, errors, tytab)\n          }\n        } else {\n          (CtUnknown, s, c)\n        }\n      } else if name == \"resume\" {\n        let alen = Array::length(args)\n        let mut s1 = s\n        let mut c1 = c\n        let mut ai = 0\n        while ai < alen {\n          let (_, ns, nc) = check_expr(Array::get(args, ai), env, defs, s1, c1, errors, tytab)\n          s1 = ns\n          c1 = nc\n          ai = ai + 1\n        }\n        let (tv, c2) = fresh_var(c1)\n        (tv, s1, c2)\n      } else if name == \"Some\" {\n        if Array::length(args) == 1 {\n          let (at, s1, c1) = check_expr(Array::get(args, 0), env, defs, s, c, errors, tytab)\n          (tab_call_ty(tytab, call_off, CtOption(subst_apply(s1, at))), s1, c1)\n        } else {\n          Array::push(errors, String::concat(String::concat(\"Some expects 1 argument, got \", __to_string(Array::length(args))), off_marker_len(callee_off, 4)))\n          (tab_call_ty(tytab, call_off, CtOption(CtUnknown)), s, c)\n        }\n      } else if name == \"__index\" && Array::length(args) == 2 {\n        let (obj_ty, s1, c1) = check_expr(Array::get(args, 0), env, defs, s, c, errors, tytab)\n        let (_, s2, c2) = check_expr(Array::get(args, 1), env, defs, s1, c1, errors, tytab)\n        let result = match subst_apply(s2, obj_ty) {\n          CtArray(elem) => elem,\n          CtString => CtInt,\n          CtBytes => CtInt,\n          _ => CtUnknown\n        }\n        (tab_call_ty(tytab, call_off, result), s2, c2)\n      } else if name == \"Array::push\" && Array::length(args) == 2 {\n        let (obj_ty, s1, c1) = check_expr(Array::get(args, 0), env, defs, s, c, errors, tytab)\n        let (val_ty, s2, c2) = check_expr(Array::get(args, 1), env, defs, s1, c1, errors, tytab)\n        let s3 = match subst_apply(s2, obj_ty) {\n          CtArray(elem) => check_assignable(subst_apply(s2, elem), subst_apply(s2, val_ty), s2, errors, \"Array::push value type mismatch\", 0 - 1),\n          _ => s2\n        }\n        (tab_call_ty(tytab, call_off, CtUnit), s3, c2)\n      } else if name == \"Array::set\" && Array::length(args) == 3 {\n        let (obj_ty, s1, c1) = check_expr(Array::get(args, 0), env, defs, s, c, errors, tytab)\n        let (_, s2, c2) = check_expr(Array::get(args, 1), env, defs, s1, c1, errors, tytab)\n        let (val_ty, s3, c3) = check_expr(Array::get(args, 2), env, defs, s2, c2, errors, tytab)\n        let s4 = match subst_apply(s3, obj_ty) {\n          CtArray(elem) => check_assignable(subst_apply(s3, elem), subst_apply(s3, val_ty), s3, errors, \"Array::set value type mismatch\", 0 - 1),\n          _ => s3\n        }\n        (tab_call_ty(tytab, call_off, CtUnit), s4, c3)\n      } else if name == \"Array::push_all\" && Array::length(args) == 2 {\n        let (a_ty, s1, c1) = check_expr(Array::get(args, 0), env, defs, s, c, errors, tytab)\n        let (b_ty, s2, c2) = check_expr(Array::get(args, 1), env, defs, s1, c1, errors, tytab)\n        let s3 = check_two_array_elems(subst_apply(s2, a_ty), subst_apply(s2, b_ty), s2, errors, \"Array::push_all element type mismatch\")\n        (tab_call_ty(tytab, call_off, CtUnit), s3, c2)\n      } else if name == \"Array::get\" && Array::length(args) == 2 {\n        let (obj_ty, s1, c1) = check_expr(Array::get(args, 0), env, defs, s, c, errors, tytab)\n        let (_, s2, c2) = check_expr(Array::get(args, 1), env, defs, s1, c1, errors, tytab)\n        let result = match subst_apply(s2, obj_ty) {\n          CtArray(elem) => elem,\n          _ => CtUnknown\n        }\n        (tab_call_ty(tytab, call_off, result), s2, c2)\n      } else if name == \"Array::reverse\" && Array::length(args) == 1 {\n        let (obj_ty, s1, c1) = check_expr(Array::get(args, 0), env, defs, s, c, errors, tytab)\n        let result = match subst_apply(s1, obj_ty) {\n          CtArray(elem) => CtArray(elem),\n          _ => CtUnknown\n        }\n        (tab_call_ty(tytab, call_off, result), s1, c1)\n      } else if name == \"Array::concat\" && Array::length(args) == 2 {\n        let (a_ty, s1, c1) = check_expr(Array::get(args, 0), env, defs, s, c, errors, tytab)\n        let (b_ty, s2, c2) = check_expr(Array::get(args, 1), env, defs, s1, c1, errors, tytab)\n        let a_app = subst_apply(s2, a_ty)\n        let b_app = subst_apply(s2, b_ty)\n        let s3 = check_two_array_elems(a_app, b_app, s2, errors, \"Array::concat element type mismatch\")\n        let result = match a_app {\n          CtArray(elem) => CtArray(elem),\n          _ => match b_app {\n            CtArray(elem) => CtArray(elem),\n            _ => CtUnknown\n          }\n        }\n        (tab_call_ty(tytab, call_off, result), s3, c2)\n      } else if name == \"Array::slice\" && Array::length(args) == 3 {\n        let (obj_ty, s1, c1) = check_expr(Array::get(args, 0), env, defs, s, c, errors, tytab)\n        let (_, s2, c2) = check_expr(Array::get(args, 1), env, defs, s1, c1, errors, tytab)\n        let (_, s3, c3) = check_expr(Array::get(args, 2), env, defs, s2, c2, errors, tytab)\n        let result = match subst_apply(s3, obj_ty) {\n          CtArray(elem) => CtArray(elem),\n          _ => CtUnknown\n        }\n        (tab_call_ty(tytab, call_off, result), s3, c3)\n      } else if name == \"Array::fold\" && Array::length(args) == 3 {\n        let (recv_ty, s1, c1) = check_expr(Array::get(args, 0), env, defs, s, c, errors, tytab)\n        let (init_ty, s2, c2) = check_expr(Array::get(args, 1), env, defs, s1, c1, errors, tytab)\n        let (fn_ty, s3, c3) = check_expr(Array::get(args, 2), env, defs, s2, c2, errors, tytab)\n        let s4 = match subst_apply(s3, fn_ty) {\n          CtFn(ptys, _, _) => if Array::length(ptys) >= 1 {\n            check_assignable(subst_apply(s3, Array::get(ptys, 0)), subst_apply(s3, init_ty), s3, errors, \"Array::fold accumulator type mismatch\", 0 - 1)\n          } else {\n            s3\n          },\n          _ => s3\n        }\n        let s5 = check_hof_param_vs_elem(subst_apply(s4, recv_ty), subst_apply(s4, fn_ty), 1, s4, errors, \"Array::fold element parameter type mismatch\")\n        (tab_call_ty(tytab, call_off, subst_apply(s5, init_ty)), s5, c3)\n      } else if name == \"Array::map\" && Array::length(args) == 2 {\n        let (recv_ty, s1, c1) = check_expr(Array::get(args, 0), env, defs, s, c, errors, tytab)\n        let (fn_ty, s2, c2) = check_expr(Array::get(args, 1), env, defs, s1, c1, errors, tytab)\n        let s3 = check_hof_param_vs_elem(subst_apply(s2, recv_ty), subst_apply(s2, fn_ty), 0, s2, errors, \"Array::map function parameter type mismatch\")\n        let result = match subst_apply(s3, fn_ty) {\n          CtFn(_, ret, _) => CtArray(ret),\n          _ => CtUnknown\n        }\n        (tab_call_ty(tytab, call_off, result), s3, c2)\n      } else {\n        match direct_call_return(env, name) {\n          Some(ret_ty) => {\n            let alen = Array::length(args)\n            let want_head = builtin_first_arg_head(name)\n            let mut ai = 0\n            let mut s2 = s\n            let mut c2 = c\n            while ai < alen {\n              let (at, ns, nc) = check_expr(Array::get(args, ai), env, defs, s2, c2, errors, tytab)\n              if ai == 0 && want_head != 0 {\n                let got_head = head_kind(subst_apply(s2, at))\n                if got_head != 0 && got_head != want_head {\n                  Array::push(errors, String::concat(String::concat(\"argument type mismatch for \", String::concat(name, \": receiver type \")), String::concat(type_to_string(subst_apply(s2, at)), off_marker_len(callee_off, String::length(name)))))\n                } else {\n                  ()\n                }\n              } else if ai >= 1 {\n                let want_rest = builtin_arg_head_rest(name, ai)\n                if want_rest != 0 {\n                  let got_head = head_kind(subst_apply(s2, at))\n                  if got_head != 0 && got_head != want_rest {\n                    Array::push(errors, String::concat(String::concat(\"argument type mismatch for \", String::concat(name, String::concat(\" (arg \", String::concat(__to_string(ai), \"): \")))), String::concat(type_to_string(subst_apply(s2, at)), off_marker_len(callee_off, String::length(name)))))\n                  } else {\n                    ()\n                  }\n                } else {\n                  ()\n                }\n              } else {\n                ()\n              }\n              s2 = ns\n              c2 = nc\n              ai = ai + 1\n            }\n            (tab_call_ty(tytab, call_off, subst_apply(s2, ret_ty)), s2, c2)\n          },\n          None => {\n            let method_form = if String::index_of(name, \"::\") < 0 && Array::length(args) >= 1 {\n              match env_lookup(env, name) {\n                Some(_) => false,\n                None => match lookup_builtin(name) {\n                  Some(_) => false,\n                  None => true\n                }\n              }\n            } else {\n              false\n            }\n            let recv_method = if method_form {\n              let (a0_ty, sa, ca) = check_expr(Array::get(args, 0), env, defs, s, c, errors, tytab)\n              let recv_ty = subst_apply(sa, a0_ty)\n              let qual = String::concat(type_name_prefix(recv_ty), String::concat(\"::\", name))\n              let has_qual = match env_lookup(env, qual) {\n                Some(_) => true,\n                None => match lookup_builtin(qual) {\n                  Some(_) => true,\n                  None => false\n                }\n              }\n              let user_recv = match recv_ty {\n                CtEnum(_) => true,\n                CtStruct(_) => true,\n                CtNamed(_, _) => true,\n                _ => false\n              }\n              if has_qual || user_recv {\n                Some(check_expr(ECall(EDot(Array::get(args, 0), name, callee_off, callee_off), Array::slice(args, 1, Array::length(args)), call_off), env, defs, sa, ca, errors, tytab))\n              } else {\n                None\n              }\n            } else {\n              None\n            }\n            match recv_method {\n            Some(rm) => rm,\n            None => {\n            let (ct, s1, c1) = check_expr(EIdent(name, -1), env, defs, s, c, errors, tytab)\n            let alen = Array::length(args)\n            let arg_tys = Array::slice([\n              CtUnknown\n            ], 0, 0)\n            let mut ai = 0\n            let mut s2 = s1\n            let mut c2 = c1\n            while ai < alen {\n              let (at, ns, nc) = check_expr(Array::get(args, ai), env, defs, s2, c2, errors, tytab)\n              Array::push(arg_tys, at)\n              s2 = ns\n              c2 = nc\n              ai = ai + 1\n            }\n            let applied_callee_ty = match ct {\n              CtFn(_, _, _) => ct,\n              _ => subst_apply(s2, ct)\n            }\n            match applied_callee_ty {\n              CtFn(param_tys, ret, _) => {\n                let ret_box = Array::slice([\n                  ret\n                ], 0, 1)\n                let call_param_tys = param_tys\n                let plen2 = Array::length(param_tys)\n                let alen3 = Array::length(arg_tys)\n                if alen3 != plen2 {\n                  Array::push(errors, String::concat(String::concat(\"function arity mismatch for \", String::concat(name, String::concat(\": expected \", String::concat(__to_string(plen2), String::concat(\" args, got \", __to_string(alen3)))))), off_marker_len(callee_off, String::length(name))))\n                }\n                let s3 = unify_call_args(call_param_tys, arg_tys, s2, errors, name, callee_off)\n                let call_ret = Array::get(ret_box, 0)\n                (tab_call_ty(tytab, call_off, subst_apply(s3, call_ret)), s3, c2)\n              },\n              CtStruct(sname) => (tab_call_ty(tytab, call_off, CtStruct(sname)), s2, c2),\n              other => {\n                let not_callable = match other {\n                  CtInt => true,\n                  CtDouble => true,\n                  CtBool => true,\n                  CtString => true,\n                  CtChar => true,\n                  CtUnit => true,\n                  CtBytes => true,\n                  CtTuple(_) => true,\n                  CtArray(_) => true,\n                  CtOption(_) => true,\n                  CtEnum(_) => true,\n                  _ => false\n                }\n                if not_callable {\n                  Array::push(errors, String::concat(String::concat(\"calling a non-function value: \", name), off_marker_len(callee_off, String::length(name))))\n                } else {\n                  ()\n                }\n                (tab_call_ty(tytab, call_off, CtUnknown), s2, c2)\n              }\n            }\n            }\n            }\n          }\n        }\n        }\n      },\n      EDot(obj, method, _, _) => {\n        let (obj_ty, s1, c1) = check_expr(obj, env, defs, s, c, errors, tytab)\n        let resolved = subst_apply(s1, obj_ty)\n        let type_prefix = type_name_prefix(resolved)\n        let qualified = String::concat(type_prefix, String::concat(\"::\", method))\n        let direct_ret = direct_call_return(env, qualified)\n        let method_ty = match env_lookup(env, qualified) {\n          Some(t) => {\n            let (ti, c2, _) = instantiate(t, c1)\n            (ti, s1, c2)\n          },\n          None => match lookup_builtin(qualified) {\n            Some(t) => (t, s1, c1),\n            None => (CtUnknown, s1, c1)\n          }\n        }\n        let (mt, s2, c2) = method_ty\n        let all_args = prepend_expr(obj, args)\n        let alen = Array::length(all_args)\n        let arg_tys = Array::slice([\n          CtUnknown\n        ], 0, 0)\n        Array::push(arg_tys, obj_ty)\n        let mut ai = 1\n        let mut s3 = s2\n        let mut c3 = c2\n        while ai < alen {\n          let (at, ns, nc) = check_expr(Array::get(all_args, ai), env, defs, s3, c3, errors, tytab)\n          Array::push(arg_tys, at)\n          s3 = ns\n          c3 = nc\n          ai = ai + 1\n        }\n        let applied_method_ty = match mt {\n          CtFn(_, _, _) => mt,\n          _ => subst_apply(s3, mt)\n        }\n        match applied_method_ty {\n          CtFn(param_tys, ret, _) => {\n            let ret_box = Array::slice([\n              ret\n            ], 0, 1)\n            let call_param_tys = param_tys\n            let plen = Array::length(param_tys)\n            let alen2 = Array::length(arg_tys)\n            if alen2 != plen {\n              Array::push(errors, String::concat(String::concat(\"function arity mismatch for \", String::concat(qualified, String::concat(\": expected \", String::concat(__to_string(plen), String::concat(\" args, got \", __to_string(alen2)))))), off_marker_len(call_off, String::length(qualified))))\n            }\n            let s4 = unify_call_args(call_param_tys, arg_tys, s3, errors, qualified, call_off)\n            let call_ret = Array::get(ret_box, 0)\n            let selected_ret = match direct_ret {\n              Some(t) => t,\n              None => call_ret\n            }\n            (tab_call_ty(tytab, call_off, subst_apply(s4, selected_ret)), s4, c3)\n          },\n          _ => {\n            let field_fn = match subst_apply(s3, obj_ty) {\n              CtStruct(sname) => struct_field_type(defs, sname, method),\n              _ => None\n            }\n            match field_fn {\n              Some(CtFn(fpts, fret, _)) => {\n                let explicit = Array::slice(arg_tys, 1, Array::length(arg_tys))\n                if Array::length(fpts) != Array::length(explicit) {\n                  Array::push(errors, String::concat(String::concat(\"function arity mismatch for \", String::concat(qualified, String::concat(\": expected \", String::concat(__to_string(Array::length(fpts)), String::concat(\" args, got \", __to_string(Array::length(explicit))))))), off_marker_len(call_off, String::length(qualified))))\n                }\n                let s4 = unify_call_args(fpts, explicit, s3, errors, qualified, call_off)\n                (tab_call_ty(tytab, call_off, subst_apply(s4, fret)), s4, c3)\n              },\n              _ => match direct_ret {\n                Some(t) => (tab_call_ty(tytab, call_off, t), s3, c3),\n                None => (tab_call_ty(tytab, call_off, CtUnknown), s3, c3)\n              }\n            }\n          }\n        }\n      },\n      _ => {\n        let callee_name0 = expr_ident_name_or_empty(callee)\n        if callee_name0 != \"\" {\n          match direct_call_return(env, callee_name0) {\n            Some(ret_ty) => {\n              let alen = Array::length(args)\n              let mut ai = 0\n              let mut s2 = s\n              let mut c2 = c\n              while ai < alen {\n                let (_, ns, nc) = check_expr(Array::get(args, ai), env, defs, s2, c2, errors, tytab)\n                s2 = ns\n                c2 = nc\n                ai = ai + 1\n              }\n              (tab_call_ty(tytab, call_off, subst_apply(s2, ret_ty)), s2, c2)\n            },\n            None => {\n              let (ct, s1, c1) = check_expr(callee, env, defs, s, c, errors, tytab)\n              let alen = Array::length(args)\n              let arg_tys = Array::slice([\n                CtUnknown\n              ], 0, 0)\n              let mut ai = 0\n              let mut s2 = s1\n              let mut c2 = c1\n              while ai < alen {\n                let (at, ns, nc) = check_expr(Array::get(args, ai), env, defs, s2, c2, errors, tytab)\n                Array::push(arg_tys, at)\n                s2 = ns\n                c2 = nc\n                ai = ai + 1\n              }\n            let applied_callee_ty = match ct {\n              CtFn(_, _, _) => ct,\n              _ => subst_apply(s2, ct)\n            }\n            match applied_callee_ty {\n              CtFn(param_tys, ret, _) => {\n                let ret_box = Array::slice([\n                  ret\n                ], 0, 1)\n                let call_param_tys = param_tys\n                let plen2 = Array::length(param_tys)\n                let alen3 = Array::length(arg_tys)\n                if alen3 != plen2 {\n                  Array::push(errors, String::concat(String::concat(\"function arity mismatch for \", String::concat(callee_name0, String::concat(\": expected \", String::concat(__to_string(plen2), String::concat(\" args, got \", __to_string(alen3)))))), off_marker_len(call_off, String::length(callee_name0))))\n                }\n                let s3 = unify_call_args(call_param_tys, arg_tys, s2, errors, callee_name0, call_off)\n                let call_ret = Array::get(ret_box, 0)\n                (tab_call_ty(tytab, call_off, subst_apply(s3, call_ret)), s3, c2)\n              },\n              CtStruct(sname) => (tab_call_ty(tytab, call_off, CtStruct(sname)), s2, c2),\n              _ => (tab_call_ty(tytab, call_off, CtUnknown), s2, c2)\n            }\n            }\n          }\n        } else {\n            let (ct, s1, c1) = check_expr(callee, env, defs, s, c, errors, tytab)\n            let alen = Array::length(args)\n            let arg_tys = Array::slice([\n              CtUnknown\n            ], 0, 0)\n            let mut ai = 0\n            let mut s2 = s1\n            let mut c2 = c1\n            while ai < alen {\n              let (at, ns, nc) = check_expr(Array::get(args, ai), env, defs, s2, c2, errors, tytab)\n              Array::push(arg_tys, at)\n              s2 = ns\n              c2 = nc\n              ai = ai + 1\n            }\n            let applied_callee_ty = match ct {\n              CtFn(_, _, _) => ct,\n              _ => subst_apply(s2, ct)\n            }\n            match applied_callee_ty {\n              CtFn(param_tys, ret, _) => {\n                let ret_box = Array::slice([\n                  ret\n                ], 0, 1)\n                let call_param_tys = param_tys\n                let plen2 = Array::length(param_tys)\n                let alen3 = Array::length(arg_tys)\n                if alen3 != plen2 {\n                  Array::push(errors, String::concat(String::concat(\"function arity mismatch for <expr>: expected \", String::concat(__to_string(plen2), String::concat(\" args, got \", __to_string(alen3)))), off_marker(call_off)))\n                }\n                let s3 = unify_call_args(call_param_tys, arg_tys, s2, errors, \"<expr>\", call_off)\n                let call_ret = Array::get(ret_box, 0)\n                (tab_call_ty(tytab, call_off, subst_apply(s3, call_ret)), s3, c2)\n              },\n              CtStruct(sname) => (tab_call_ty(tytab, call_off, CtStruct(sname)), s2, c2),\n              _ => (tab_call_ty(tytab, call_off, CtUnknown), s2, c2)\n            }\n        }\n      }\n    },\n    EBinOp(op, left, right) => {\n      let (left_ty, s1, c1) = check_expr(left, env, defs, s, c, errors, tytab)\n      let (right_ty, s2, c2) = check_expr(right, env, defs, s1, c1, errors, tytab)\n      let (result_ty, s3) = infer_binop_type(op, subst_apply(s2, left_ty), subst_apply(s2, right_ty), env, s2, errors, tytab)\n      (subst_apply(s3, result_ty), s3, c2)\n    },\n    EUnaryOp(op, operand) => {\n      let (operand_ty, s1, c1) = check_expr(operand, env, defs, s, c, errors, tytab)\n      if op == \"!\" {\n        match subst_apply(s1, operand_ty) {\n          CtBool => (CtBool, s1, c1),\n          CtVar(_) => match unify(operand_ty, CtBool, s1) {\n            Some(s2) => (CtBool, s2, c1),\n            None => (CtUnknown, s1, c1)\n          },\n          other => {\n            let flag = match other {\n              CtUnknown => false,\n              _ => type_is_ground(other)\n            }\n            if flag {\n              Array::push(errors, \"operand of `!` must be Bool\")\n            } else {\n              ()\n            }\n            (CtUnknown, s1, c1)\n          }\n        }\n      } else if op == \"-\" {\n        match subst_apply(s1, operand_ty) {\n          CtDouble => (CtDouble, s1, c1),\n          CtInt => (CtInt, s1, c1),\n          CtVar(_) => match unify(operand_ty, CtInt, s1) {\n            Some(s2) => (CtInt, s2, c1),\n            None => (CtUnknown, s1, c1)\n          },\n          other => {\n            let flag = match other {\n              CtUnknown => false,\n              _ => type_is_ground(other)\n            }\n            if flag {\n              Array::push(errors, \"operand of unary `-` must be Int or Double\")\n            } else {\n              ()\n            }\n            (CtUnknown, s1, c1)\n          }\n        }\n      } else (CtUnknown, s1, c1)\n    },\n    EAssign(name, val, body) => {\n      let (vt, s1, c1) = check_expr(val, env, defs, s, c, errors, tytab)\n      let s1b = match env_lookup(env, name) {\n        Some(var_ty) => check_assignable(var_ty, subst_apply(s1, vt), s1, errors, String::concat(\"assignment type mismatch for \", name), 0 - 1),\n        None => s1\n      }\n      check_expr(body, env, defs, s1b, c1, errors, tytab)\n    },\n    EAssignOp(_, _, val, body) => {\n      let (_, s1, c1) = check_expr(val, env, defs, s, c, errors, tytab)\n      check_expr(body, env, defs, s1, c1, errors, tytab)\n    },\n    EMatch(scrutinee, arms) => {\n      let (scr_ty, s1, c1) = check_expr(scrutinee, env, defs, s, c, errors, tytab)\n      let alen = Array::length(arms)\n      if alen == 0 {\n        Array::push(errors, \"non-exhaustive match: no unguarded arm covers the scrutinee (all guards may fail — add an unguarded arm or `_`)\")\n        (CtUnknown, s1, c1)\n      }\n      else {\n        let mut result_ty = CtUnknown\n        let mut check_arms = false\n        let mut si = s1\n        let mut ci = c1\n        let mut ai = 0\n        while ai < alen {\n          let (pat, body) = Array::get(arms, ai)\n          let arm_env = check_pattern(pat, scr_ty, env, defs, errors)\n          let (arm_ty, ns, nc) = check_expr(body, arm_env, defs, si, ci, errors, tytab)\n          si = ns\n          ci = nc\n          if ai == 0 {\n            result_ty = arm_ty\n            check_arms = match subst_apply(si, arm_ty) {\n              CtInt => true,\n              CtDouble => true,\n              CtBool => true,\n              CtString => true,\n              CtChar => true,\n              _ => false\n            }\n          } else {\n            if check_arms {\n              let r2 = subst_apply(si, arm_ty)\n              si = if arm_body_diverges(body) {\n                si\n              } else {\n                match r2 {\n                  CtUnit => si,\n                  _ => check_assignable(result_ty, r2, si, errors, \"match arms have incompatible types\", 0 - 1)\n                }\n              }\n            } else {\n              ()\n            }\n          }\n          ai = ai + 1\n        }\n        let enum_name_opt = match subst_apply(si, scr_ty) {\n          CtEnum(en) => Some(en),\n          CtNamed(en, _) => Some(en),\n          _ => None\n        }\n        match enum_name_opt {\n          Some(en) => match find_typedef(defs, en) {\n            Some(TDEnum(_, _, variants)) => {\n              let mut has_catchall = false\n              let covered = Array::slice([\n                \"\"\n              ], 0, 0)\n              let mut ax = 0\n              while ax < Array::length(arms) {\n                let (apat, _) = Array::get(arms, ax)\n                if pat_is_catchall(apat) {\n                  has_catchall = true\n                } else {\n                  ()\n                }\n                collect_ctor_names_into(apat, covered)\n                ax = ax + 1\n              }\n              if has_catchall {\n                ()\n              } else {\n                let mut vi = 0\n                while vi < Array::length(variants) {\n                  let (vname, _) = Array::get(variants, vi)\n                  let mut found = false\n                  let mut ci2 = 0\n                  while ci2 < Array::length(covered) {\n                    if Array::get(covered, ci2) == vname {\n                      found = true\n                    } else {\n                      ()\n                    }\n                    ci2 = ci2 + 1\n                  }\n                  if found {\n                    ()\n                  } else {\n                    Array::push(errors, String::concat(\"non-exhaustive match: variant `\", String::concat(vname, String::concat(\"` of enum \", String::concat(en, \" is not handled (add it or a `_` arm)\")))))\n                  }\n                  vi = vi + 1\n                }\n              }\n            },\n            _ => ()\n          },\n          None => ()\n        }\n        (result_ty, si, ci)\n      }\n    },\n    EHandle(body, harms) => {\n      let (hty, hs, hc) = check_expr(body, env, defs, s, c, errors, tytab)\n      let mut hs1 = hs\n      let mut hc1 = hc\n      let mut hai = 0\n      while hai < Array::length(harms) {\n        let (hpat, hbody) = Array::get(harms, hai)\n        match hpat {\n          PCtor(hqname, hbinds) => {\n            let hci = String::index_of(hqname, \"::\")\n            if hci > 0 && effect_is_declared(defs, String::substring(hqname, 0, hci)) {\n              match effect_op_sig(defs, hqname) {\n                Some(hsig) => {\n                  let (hparams, hret) = hsig\n                  let hplen = Array::length(hparams)\n                  let hblen = Array::length(hbinds)\n                  if hblen != hplen && hblen != hplen + 1 {\n                    Array::push(errors, String::concat(\"handler arm \", String::concat(hqname, String::concat(\" expects \", String::concat(__to_string(hplen), \" payload binding(s)\")))))\n                  } else {\n                    ()\n                  }\n                  let mut henv = env\n                  let mut hbi = 0\n                  while hbi < hblen {\n                    match Array::get(hbinds, hbi) {\n                      PBind(hbname) => {\n                        henv = env_bind(henv, hbname, if hbi < hplen {\n                          Array::get(hparams, hbi)\n                        } else {\n                          CtUnknown\n                        })\n                      },\n                      _ => ()\n                    }\n                    hbi = hbi + 1\n                  }\n                  let (_, hns, hnc) = check_expr(hbody, henv, defs, hs1, hc1, errors, tytab)\n                  hs1 = hns\n                  hc1 = hnc\n                  hs1 = check_resume_values(hbody, hret, henv, defs, hs1, hc1, errors, tytab)\n                },\n                None => Array::push(errors, String::concat(\"handler arm `\", String::concat(String::substring(hqname, hci + 2, String::length(hqname)), String::concat(\"` is not an operation of effect \", String::substring(hqname, 0, hci)))))\n              }\n            } else {\n              ()\n            }\n          },\n          _ => ()\n        }\n        hai = hai + 1\n      }\n      (hty, hs1, hc1)\n    },\n    EWhile(cond, body) => {\n      let (ct, s1, c1) = check_expr(cond, env, defs, s, c, errors, tytab)\n      let resolved_ct = subst_apply(s1, ct)\n      match resolved_ct {\n        CtBool => (),\n        CtUnknown => (),\n        CtVar(_) => (),\n        _ => Array::push(errors, \"while condition must be Bool\")\n      }\n      let (_, s2, c2) = check_expr(body, env_bind(env, \"__in_loop__\", CtUnit), defs, s1, c1, errors, tytab)\n      (CtUnit, s2, c2)\n    },\n    ELoop(params, body) => {\n      let mut env1 = env\n      let mut s1 = s\n      let mut c1 = c\n      let mut i = 0\n      while i < Array::length(params) {\n        let (name, init) = Array::get(params, i)\n        let (pt, ns, nc) = check_expr(init, env1, defs, s1, c1, errors, tytab)\n        env1 = env_bind(env1, name, pt)\n        s1 = ns\n        c1 = nc\n        i = i + 1\n      }\n      let (_, s2, c2) = check_expr(body, env_bind(env1, \"__in_loop__\", CtUnit), defs, s1, c1, errors, tytab)\n      (CtUnit, s2, c2)\n    },\n    EForIn(name, index_name, iterable, body) => {\n      let real_iterable = match iterable {\n        ECall(callee, args, _) => match callee {\n          EIdent(nm, _) => if nm == \"__await_iter\" && Array::length(args) == 1 {\n            Array::get(args, 0)\n          } else iterable,\n          _ => iterable\n        },\n        _ => iterable\n      }\n      let (it, s1, c1) = check_expr(real_iterable, env, defs, s, c, errors, tytab)\n      let it_resolved = subst_apply(s1, it)\n      let (et, c1b) = match it_resolved {\n        CtArray(elem) => (elem, c1),\n        CtNamed(nm, args) => if Array::length(args) > 0 {\n          (Array::get(args, 0), c1)\n        } else if nm == \"Stream\" || type_name_has_iterator_impl(env, nm) {\n          fresh_var(c1)\n        } else (CtUnknown, c1),\n        CtStruct(nm) => if type_name_has_iterator_impl(env, nm) {\n          fresh_var(c1)\n        } else (CtUnknown, c1),\n        other => {\n          let flag = match other {\n            CtInt => true,\n            CtDouble => true,\n            CtBool => true,\n            CtUnit => true,\n            CtChar => true,\n            _ => false\n          }\n          if flag {\n            Array::push(errors, \"for loop requires an iterable (Array or iterator)\")\n          } else {\n            ()\n          }\n          (CtUnknown, c1)\n        }\n      }\n      let env2 = env_bind(env, name, et)\n      let env3 = match index_name {\n        Some(index_name) => env_bind(env2, index_name, CtInt),\n        None => env2\n      }\n      let (bt, s2, c2) = check_expr(body, env_bind(env3, \"__in_loop__\", CtUnit), defs, s1, c1b, errors, tytab)\n      (CtArray(bt), s2, c2)\n    },\n    EDot(obj, field, dot_off, field_off) => {\n      let (obj_ty, s1, c1) = check_expr(obj, env, defs, s, c, errors, tytab)\n      let resolved = subst_apply(s1, obj_ty)\n      let field_ty = match resolved {\n        CtStruct(sname) => match find_typedef(defs, sname) {\n          Some(td) => match td {\n            TDStruct(_, fields, _) => {\n              let rec find_field: (Int) -> Option[Type] = (i) -> {\n                if i >= Array::length(fields) {\n                  None\n                } else {\n                  let (fname, ftype) = Array::get(fields, i)\n                  if fname == field {\n                    Some(ftype)\n                  } else find_field(i + 1)\n                }\n              }\n              match find_field(0) {\n                Some(ft) => ft,\n                None => {\n                  Array::push(errors, String::concat(String::concat(\"unknown field '\", String::concat(field, String::concat(\"' on struct \", sname))), if field_off >= 0 { off_marker_len(field_off, String::length(field)) } else { off_marker(dot_off) }))\n                  CtUnknown\n                }\n              }\n            },\n            _ => CtUnknown\n          },\n          None => CtUnknown\n        },\n        CtTuple(elems) => match parse_tuple_index(field) {\n          Some(idx) => if idx >= 0 && idx < Array::length(elems) {\n            Array::get(elems, idx)\n          } else {\n            Array::push(errors, String::concat(String::concat(\"tuple index \", String::concat(field, String::concat(\" out of range for a \", String::concat(__to_string(Array::length(elems)), \"-tuple\")))), if field_off >= 0 { off_marker_len(field_off, String::length(field)) } else { off_marker(dot_off) }))\n            CtUnknown\n          },\n          None => CtUnknown\n        },\n        other => {\n          let not_struct = match other {\n            CtInt => true,\n            CtDouble => true,\n            CtBool => true,\n            CtChar => true,\n            CtUnit => true,\n            CtOption(_) => true,\n            CtFn(_, _, _) => true,\n            _ => false\n          }\n          if not_struct {\n            Array::push(errors, String::concat(String::concat(\"field access `.\", String::concat(field, \"` on a non-struct value\")), if field_off >= 0 { off_marker_len(field_off, String::length(field)) } else { off_marker(dot_off) }))\n          } else {\n            ()\n          }\n          CtUnknown\n        }\n      }\n      if dot_off >= 0 {\n        Array::push(tytab, (dot_off, field_ty))\n      } else {\n        ()\n      }\n      if field_off >= 0 && field_off != dot_off {\n        Array::push(tytab, (field_off, field_ty))\n      } else {\n        ()\n      }\n      (field_ty, s1, c1)\n    },\n    EFn(tparams, tbounds, params, ret_ty, effect, body) => {\n      let tplen = Array::length(tparams)\n      let mut tp_env = env\n      let mut s0 = s\n      let mut c0 = c\n      let mut tpi = 0\n      while tpi < tplen {\n        let tpname = Array::get(tparams, tpi)\n        match fresh_var(c0) {\n          (tv, nc) => {\n            let vid = nc - 1\n            let tblen = Array::length(tbounds)\n            let mut bounds = Array::slice([\n              \"\"\n            ], 0, 0)\n            let mut tbi = 0\n            let mut found_bounds = false\n            while tbi < tblen {\n              let (bname, blist) = Array::get(tbounds, tbi)\n              if !found_bounds && bname == tpname {\n                bounds = blist\n                found_bounds = true\n              }\n              tbi = tbi + 1\n            }\n            s0 = if Array::length(bounds) == 0 {\n              s0\n            } else subst_add_bound(s0, vid, bounds)\n            tp_env = env_bind(tp_env, tpname, tv)\n            c0 = nc\n          },\n          _ => ()\n        }\n        tpi = tpi + 1\n      }\n      let plen = Array::length(params)\n      let mut fn_env = tp_env\n      let mut s1 = s0\n      let mut c1 = c0\n      let param_types = Array::slice([\n        CtUnknown\n      ], 0, 0)\n      let mut pi = 0\n      while pi < plen {\n        let (raw_name, ann) = Array::get(params, pi)\n        let nlen = String::length(raw_name)\n        let name = if nlen > 0 {\n          let lc = String::char_code_at(raw_name, nlen - 1)\n          if lc == '~' || lc == '?' {\n            raw_name[0: nlen - 1]\n          } else raw_name\n        } else raw_name\n        let (pt, ns, nc) = match ann {\n          Some(te) => {\n            let resolved = resolve_type_expr(te, defs)\n            let pt2 = resolve_tparams_in(resolved, fn_env)\n            (pt2, s1, c1)\n          },\n          None => {\n            let (tv, nc2) = fresh_var(c1)\n            (tv, s1, nc2)\n          }\n        }\n        fn_env = env_bind(fn_env, name, pt)\n        Array::push(param_types, pt)\n        s1 = ns\n        c1 = nc\n        pi = pi + 1\n      }\n      let body_env = match ret_ty {\n        Some(rte) => env_bind(fn_env, \"__return__\", resolve_tparams_in(resolve_type_expr(rte, defs), fn_env)),\n        None => fn_env\n      }\n      let (bt, s2, c2) = check_expr(body, body_env, defs, s1, c1, errors, tytab)\n      let (final_ret, s3) = match ret_ty {\n        Some(te) => {\n          let resolved = resolve_type_expr(te, defs)\n          let resolved_ret = resolve_tparams_in(resolved, fn_env)\n          match unify(bt, resolved_ret, s2) {\n            Some(ns) => (subst_apply(ns, resolved_ret), ns),\n            None => {\n              Array::push(errors, String::concat(\"return type mismatch: expected \", String::concat(type_to_string(resolved_ret), String::concat(\", got \", type_to_string(bt)))))\n              (CtUnknown, s2)\n            }\n          }\n        },\n        None => (subst_apply(s2, bt), s2)\n      }\n      (CtFn(param_types, final_ret, effect), s3, c2)\n    },\n    EBreak(opt) => {\n      match env_lookup(env, \"__in_loop__\") {\n        Some(_) => (),\n        None => Array::push(errors, \"`break` outside a loop\")\n      }\n      match opt {\n        Some(e) => {\n          let (_, s1, c1) = check_expr(e, env, defs, s, c, errors, tytab)\n          (CtUnit, s1, c1)\n        },\n        None => (CtUnit, s, c)\n      }\n    },\n    EContinue(args) => {\n      match env_lookup(env, \"__in_loop__\") {\n        Some(_) => (),\n        None => Array::push(errors, \"`continue` outside a loop\")\n      }\n      let alen = Array::length(args)\n      let mut s1 = s\n      let mut c1 = c\n      let mut ai = 0\n      while ai < alen {\n        let (_, ns, nc) = check_expr(Array::get(args, ai), env, defs, s1, c1, errors, tytab)\n        s1 = ns\n        c1 = nc\n        ai = ai + 1\n      }\n      (CtUnit, s1, c1)\n    },\n    ERecord(rn, fields) => {\n      let flen = Array::length(fields)\n      let mut s1 = s\n      let mut c1 = c\n      let field_tys = Array::slice([\n        (\"\", CtUnknown)\n      ], 0, 0)\n      let mut fi = 0\n      while fi < flen {\n        let (fname, fval) = Array::get(fields, fi)\n        let mut dj = 0\n        let mut dup = false\n        while dj < Array::length(field_tys) {\n          let (pn, _) = Array::get(field_tys, dj)\n          if pn == fname {\n            dup = true\n          } else {\n            ()\n          }\n          dj = dj + 1\n        }\n        if dup {\n          Array::push(errors, String::concat(\"duplicate field `\", String::concat(fname, \"` in record literal\")))\n        } else {\n          ()\n        }\n        let (ft, ns, nc) = check_expr(fval, env, defs, s1, c1, errors, tytab)\n        Array::push(field_tys, (fname, ft))\n        s1 = ns\n        c1 = nc\n        fi = fi + 1\n      }\n      if rn != \"\" {\n        match find_typedef(defs, rn) {\n          Some(td) => match td {\n            TDStruct(_, dfields, _) => {\n              let mut ui = 0\n              while ui < Array::length(field_tys) {\n                let (an, _) = Array::get(field_tys, ui)\n                let mut known = false\n                let mut uj = 0\n                while uj < Array::length(dfields) {\n                  let (dn, _) = Array::get(dfields, uj)\n                  if dn == an {\n                    known = true\n                  } else {\n                    ()\n                  }\n                  uj = uj + 1\n                }\n                if !known {\n                  Array::push(errors, String::concat(\"unknown field `\", String::concat(an, String::concat(\"` for struct \", rn))))\n                } else {\n                  ()\n                }\n                ui = ui + 1\n              }\n              let mut mi = 0\n              while mi < Array::length(dfields) {\n                let (dn, dty) = Array::get(dfields, mi)\n                match lookup_actual_field_ty(field_tys, dn) {\n                  Some(aty) => {\n                    s1 = check_assignable(dty, subst_apply(s1, aty), s1, errors, String::concat(\"struct field type mismatch for \", dn), 0 - 1)\n                  },\n                  None => Array::push(errors, String::concat(\"missing field `\", String::concat(dn, String::concat(\"` in construction of struct \", rn))))\n                }\n                mi = mi + 1\n              }\n              if struct_fields_ground(dfields) {\n                (CtStruct(rn), s1, c1)\n              } else {\n                (CtUnknown, s1, c1)\n              }\n            },\n            _ => {\n              Array::push(errors, String::concat(\"`\", String::concat(rn, \"` is not a struct (struct literal)\")))\n              (CtUnknown, s1, c1)\n            }\n          },\n          None => {\n            let s2f = check_record_fields(defs, field_tys, s1, errors)\n            let rec_tyf = match resolve_record_struct_name(defs, field_tys) {\n              Some(sname) => CtStruct(sname),\n              None => CtUnknown\n            }\n            (rec_tyf, s2f, c1)\n          }\n        }\n      } else {\n        let s2 = check_record_fields(defs, field_tys, s1, errors)\n        let rec_ty = match resolve_record_struct_name(defs, field_tys) {\n          Some(sname) => CtStruct(sname),\n          None => CtUnknown\n        }\n        (rec_ty, s2, c1)\n      }\n    },\n    ETuple(items) => {\n      let ilen = Array::length(items)\n      let mut s1 = s\n      let mut c1 = c\n      let tys = Array::slice([\n        CtUnknown\n      ], 0, 0)\n      let mut ti = 0\n      while ti < ilen {\n        let (it, ns, nc) = check_expr(Array::get(items, ti), env, defs, s1, c1, errors, tytab)\n        Array::push(tys, it)\n        s1 = ns\n        c1 = nc\n        ti = ti + 1\n      }\n      (CtTuple(tys), s1, c1)\n    },\n    EArray(items) => {\n      let ilen = Array::length(items)\n      let mut s1 = s\n      let mut c1 = c\n      let mut elem_ty = CtUnknown\n      let mut check_elems = false\n      let mut ai = 0\n      while ai < ilen {\n        let (it, ns, nc) = check_expr(Array::get(items, ai), env, defs, s1, c1, errors, tytab)\n        s1 = ns\n        c1 = nc\n        if ai == 0 {\n          elem_ty = it\n          check_elems = match subst_apply(s1, it) {\n            CtInt => true,\n            CtDouble => true,\n            CtBool => true,\n            CtString => true,\n            CtChar => true,\n            CtArray(inner) => match inner {\n              CtInt => true,\n              CtDouble => true,\n              CtBool => true,\n              CtString => true,\n              CtChar => true,\n              _ => false\n            },\n            _ => false\n          }\n        } else {\n          if check_elems {\n            s1 = check_assignable(elem_ty, subst_apply(s1, it), s1, errors, \"array elements have incompatible types\", 0 - 1)\n          } else {\n            ()\n          }\n        }\n        ai = ai + 1\n      }\n      (CtArray(elem_ty), s1, c1)\n    },\n    EReturn(e) => {\n      let (et, s1, c1) = check_expr(e, env, defs, s, c, errors, tytab)\n      match env_lookup(env, \"__return__\") {\n        Some(rt) => {\n          let _ = check_assignable(subst_apply(s1, rt), subst_apply(s1, et), s1, errors, \"return type mismatch\", 0 - 1)\n          ()\n        },\n        None => ()\n      }\n      (et, s1, c1)\n    },\n    _ => (CtUnknown, s, c)\n  }\n}\n")
}

let selfhost_source_53 = () -> (String, String) {
  ("lib/@vibe/compiler/checker/checker_stmt.vibe",
"\n\n\n\n\n\n\n\n\nlet rec import_cache_lookup: (Array[(String, Type)], String, Int) -> Option[Type] = (cache, name, i) -> {\n  if i >= Array::length(cache) {\n    None\n  }\n  else {\n    let (cached_name, cached_ty) = Array::get(cache, i)\n    if cached_name == name {\n      Some(cached_ty)\n    }\n    else import_cache_lookup(cache, name, i + 1)\n  }\n}\n\nlet bind_stmt_imports: (TypeEnv, Array[(String, Option[String])]) -> TypeEnv = (env, names) -> {\n  let env_bindings = env_flat_bindings(env)\n  let import_cache = Array::slice([\n    (\"\", CtUnknown)\n  ], 0, 0)\n  let nlen = Array::length(names)\n  let mut i = 0\n  let mut acc = env\n  while i < nlen {\n    let (name, alias) = Array::get(names, i)\n    let bound_name = match alias {\n      Some(a) => a,\n      None => name\n    }\n    let ty = match import_cache_lookup(import_cache, name, 0) {\n      Some(t) => t,\n      None => {\n        let resolved = match env_lookup_flat(env_bindings, name) {\n          Some(t) => t,\n          None => CtUnknown\n        }\n        Array::push(import_cache, (name, resolved))\n        resolved\n      }\n    }\n    let acc_with_name = env_bind(acc, bound_name, ty)\n    acc = match env_lookup_flat(env_bindings, fn_return_env_name(name)) {\n      Some(ret_ty) => env_bind(acc_with_name, fn_return_env_name(bound_name), ret_ty),\n      None => acc_with_name\n    }\n    i = i + 1\n  }\n  acc\n}\n\nlet annotation_return_type: (Option[TypeExpr], Array[TypeDef]) -> Option[Type] = (ann, defs) -> {\n  match ann {\n    Some(te) => match te {\n      TyFn(params, ret, _) => {\n        let ret_box = Array::slice([\n          ret\n        ], 0, 1)\n        let _ = Array::length(params)\n        Some(resolve_type_expr(Array::get(ret_box, 0), defs))\n      },\n      _ => None\n    },\n    None => None\n  }\n}\n\nlet fn_expr_return_type: (Expr, Array[TypeDef]) -> Option[Type] = (expr, defs) -> {\n  match expr {\n    EFn(_, _, _, ret_ty, _, _) => match ret_ty {\n      Some(te) => Some(resolve_type_expr(te, defs)),\n      None => None\n    },\n    _ => None\n  }\n}\n\nlet bind_fn_return: (TypeEnv, String, Type) -> TypeEnv = (env, name, ret_ty) -> {\n  env_bind(env, fn_return_env_name(name), ret_ty)\n}\n\nlet bind_annotation_return: (TypeEnv, String, Option[TypeExpr], Array[TypeDef]) -> TypeEnv = (env, name, ann, defs) -> {\n  match annotation_return_type(ann, defs) {\n    Some(ret_ty) => bind_fn_return(env, name, ret_ty),\n    None => env\n  }\n}\n\nlet bind_value_or_annotation_return: (TypeEnv, String, Expr, Option[TypeExpr], Array[TypeDef]) -> TypeEnv = (env, name, val, ann, defs) -> {\n  match fn_expr_return_type(val, defs) {\n    Some(ret_ty) => bind_fn_return(env, name, ret_ty),\n    None => bind_annotation_return(env, name, ann, defs)\n  }\n}\n\nlet struct_derives_has: (Array[String], String) -> Bool = (derives, name) -> {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(derives) {\n    if Array::get(derives, i) == name {\n      found = true\n      i = Array::length(derives)\n    } else {\n      i = i + 1\n    }\n  }\n  found\n}\n\nlet derive_name_is_known: (String) -> Bool = (name) -> {\n  name == \"Eq\" || name == \"Ord\" || name == \"Show\" || name == \"Hash\" || name == \"Default\"\n}\n\nlet validate_derives: (Array[String], Array[String]) -> Unit = (derives, errors) -> {\n  let mut i = 0\n  while i < Array::length(derives) {\n    let name = Array::get(derives, i)\n    if name != \"\" && !derive_name_is_known(name) {\n      Array::push(errors, String::concat(\"unknown trait: \", name))\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n}\n\nlet stmt_is_type_decl: (Stmt) -> Bool = (stmt) -> {\n  match stmt {\n    SEnum(_, _, _, _, _) => true,\n    SSuberror(_, _, _) => true,\n    SStruct(_, _, _, _, _) => true,\n    STypeAlias(_, _, _, _) => true,\n    _ => false\n  }\n}\n\nlet reorder_type_decls_first: (Array[Stmt], Int) -> Array[Stmt] = (stmts, start) -> {\n  let out = Array::slice(stmts, 0, start)\n  let n = Array::length(stmts)\n  let mut i = start\n  while i < n {\n    let st = Array::get(stmts, i)\n    if stmt_is_type_decl(st) {\n      Array::push(out, st)\n    }\n    i = i + 1\n  }\n  let mut j = start\n  while j < n {\n    let st = Array::get(stmts, j)\n    if !stmt_is_type_decl(st) {\n      Array::push(out, st)\n    }\n    j = j + 1\n  }\n  out\n}\n\nexport let rec check_stmts: (Array[Stmt], Int, TypeEnv, Array[TypeDef], Subst, Int, Array[String], Array[(Int, Type)]) -> (TypeEnv, Subst, Int) = (raw_stmts, i, env, defs, s, c, errors, tytab) -> {\n  let stmts = reorder_type_decls_first(raw_stmts, i)\n  let mut idx = i\n  let mut cur_env = env\n  let mut cur_s = s\n  let mut cur_c = c\n  let mut hoist_i = idx\n  while hoist_i < Array::length(stmts) {\n    match Array::get(stmts, hoist_i) {\n      SLet(_, _, hname, hann, _) => {\n        let ht = match hann {\n          Some(hte) => resolve_type_expr(hte, defs),\n          None => CtUnknown\n        }\n        cur_env = env_bind(cur_env, hname, ht)\n      },\n      _ => ()\n    }\n    hoist_i = hoist_i + 1\n  }\n  while idx < Array::length(stmts) {\n    let env = cur_env\n    let s = cur_s\n    let c = cur_c\n    let stmt = Array::get(stmts, idx)\n    let (new_env, s1, c1) = match stmt {\n      SLet(_, is_rec, name, ann, val) => {\n        let (vt, ns0, nc) = if is_rec {\n          check_expr(val, env_bind(env, name, CtUnknown), defs, s, c, errors, tytab)\n        } else {\n          check_expr(val, env, defs, s, c, errors, tytab)\n        }\n        let ns = match ann {\n          Some(te) => check_assignable(resolve_type_expr(te, defs), subst_apply(ns0, vt), ns0, errors, String::concat(\"binding type mismatch for \", name), 0 - 1),\n          None => ns0\n        }\n        let t = match ann {\n          Some(te) => resolve_type_expr(te, defs),\n          None => generalize(ns, vt)\n        }\n        let env1 = env_bind(env, name, t)\n        (bind_value_or_annotation_return(env1, name, val, ann, defs), ns, nc)\n      },\n      SLetMut(name, ann, val) => {\n        let (vt, ns0, nc) = check_expr(val, env, defs, s, c, errors, tytab)\n        let ns = match ann {\n          Some(te) => check_assignable(resolve_type_expr(te, defs), subst_apply(ns0, vt), ns0, errors, String::concat(\"binding type mismatch for \", name), 0 - 1),\n          None => ns0\n        }\n        let t = match ann {\n          Some(te) => resolve_type_expr(te, defs),\n          None => vt\n        }\n        let env1 = env_bind(env, name, t)\n        (bind_value_or_annotation_return(env1, name, val, ann, defs), ns, nc)\n      },\n      SLetPat(pat, val) => {\n        let (vt, ns, nc) = check_expr(val, env, defs, s, c, errors, tytab)\n        let new_env = match pat {\n          PTuple(pats) => match vt {\n            CtTuple(types) => {\n              let mut e = env\n              let mut pi = 0\n              while pi < Array::length(pats) {\n                match Array::get(pats, pi) {\n                  PBind(name) => if pi < Array::length(types) {\n                    e = env_bind(e, name, Array::get(types, pi))\n                  } else {\n                    e = env_bind(e, name, CtUnknown)\n                  },\n                  _ => ()\n                }\n                pi = pi + 1\n              }\n              e\n            },\n            _ => {\n              let concrete_non_tuple = match subst_apply(ns, vt) {\n                CtInt => true,\n                CtDouble => true,\n                CtBool => true,\n                CtString => true,\n                CtChar => true,\n                CtUnit => true,\n                CtBytes => true,\n                CtArray(_) => true,\n                CtOption(_) => true,\n                CtFn(_, _, _) => true,\n                CtStruct(_) => true,\n                CtEnum(_) => true,\n                _ => false\n              }\n              if concrete_non_tuple {\n                Array::push(errors, \"tuple pattern cannot destructure a non-tuple value\")\n              } else {\n                ()\n              }\n              let mut e = env\n              let mut pi = 0\n              while pi < Array::length(pats) {\n                match Array::get(pats, pi) {\n                  PBind(name) => {\n                    e = env_bind(e, name, CtUnknown)\n                  },\n                  _ => ()\n                }\n                pi = pi + 1\n              }\n              e\n            }\n          },\n          PBind(name) => env_bind(env, name, vt),\n          PStruct(_, fields) => {\n            let mut e = env\n            let mut fi = 0\n            while fi < Array::length(fields) {\n              let (_, fpat) = Array::get(fields, fi)\n              match fpat {\n                PBind(name) => {\n                  e = env_bind(e, name, CtUnknown)\n                },\n                _ => ()\n              }\n              fi = fi + 1\n            }\n            e\n          },\n          _ => env\n        }\n        (new_env, ns, nc)\n      },\n      SEnum(_, name, params, variants, enum_derives) => {\n        validate_derives(enum_derives, errors)\n        let param_len = Array::length(params)\n        let param_var_ids = Array::slice([\n          0\n        ], 0, 0)\n        let param_var_types = Array::slice([\n          CtUnknown\n        ], 0, 0)\n        let mut pi = 0\n        while pi < param_len {\n          let vid = c + pi\n          Array::push(param_var_ids, vid)\n          Array::push(param_var_types, CtVar(vid))\n          pi = pi + 1\n        }\n        let ctor_result_type = if param_len == 0 {\n          CtEnum(name)\n        } else {\n          CtNamed(name, param_var_types)\n        }\n        let ctor_bounds = Array::slice([\n          (0, Array::slice([\n            \"\"\n          ], 0, 0))\n        ], 0, 0)\n        let resolved_variants = Array::slice([\n          (\"\", Array::slice([\n            CtUnknown\n          ], 0, 0))\n        ], 0, 0)\n        let mut vi = 0\n        while vi < Array::length(variants) {\n          let (vname, vtypes) = Array::get(variants, vi)\n          let resolved_vtypes = Array::slice([\n            CtUnknown\n          ], 0, 0)\n          let mut ti = 0\n          while ti < Array::length(vtypes) {\n            let vt = subst_type_params(resolve_type_expr(Array::get(vtypes, ti), defs), params, param_var_types)\n            Array::push(resolved_vtypes, vt)\n            ti = ti + 1\n          }\n          Array::push(resolved_variants, (vname, resolved_vtypes))\n          vi = vi + 1\n        }\n        Array::push(defs, TDEnum(name, params, resolved_variants))\n        let mut env1 = env_bind(env, name, CtEnum(name))\n        let mut ci2 = 0\n        while ci2 < Array::length(variants) {\n          let (vname, vtypes) = Array::get(variants, ci2)\n          let ctor_ty = if Array::length(vtypes) == 0 {\n            ctor_result_type\n          } else {\n            let resolved_args = Array::slice([\n              CtUnknown\n            ], 0, 0)\n            let mut ai = 0\n            while ai < Array::length(vtypes) {\n              let arg_ty = subst_type_params(resolve_type_expr(Array::get(vtypes, ai), defs), params, param_var_types)\n              Array::push(resolved_args, arg_ty)\n              ai = ai + 1\n            }\n            CtFn(resolved_args, ctor_result_type, None)\n          }\n          let exported_ctor_ty = if param_len == 0 {\n            ctor_ty\n          } else {\n            CtForAll(param_var_ids, ctor_bounds, ctor_ty)\n          }\n          env1 = env_bind(env1, vname, exported_ctor_ty)\n          match ctor_ty {\n            CtFn(_, ret, _) => {\n              let exported_ret_ty = if param_len == 0 {\n                ret\n              } else {\n                CtForAll(param_var_ids, ctor_bounds, ret)\n              }\n              env1 = bind_fn_return(env1, vname, exported_ret_ty)\n            },\n            _ => ()\n          }\n          ci2 = ci2 + 1\n        }\n        let env_eq = env_bind(env1, String::concat(name, \"::equals\"), CtFn([\n          ctor_result_type,\n          ctor_result_type\n        ], CtBool, None))\n        let env_ord = if struct_derives_has(enum_derives, \"Ord\") {\n          env_bind(env_eq, String::concat(name, \"::compare\"), CtFn([\n            ctor_result_type,\n            ctor_result_type\n          ], CtInt, None))\n        } else {\n          env_eq\n        }\n        let env_show = if struct_derives_has(enum_derives, \"Show\") || struct_derives_has(enum_derives, \"Hash\") {\n          env_bind(env_ord, String::concat(name, \"::to_string\"), CtFn([\n            ctor_result_type\n          ], CtString, None))\n        } else {\n          env_ord\n        }\n        let env_hash = if struct_derives_has(enum_derives, \"Hash\") {\n          let env_h = EnvTraitImpl(\"Hash\", ctor_result_type, env_show)\n          env_bind(env_h, String::concat(name, \"::hash_key\"), CtFn([\n            ctor_result_type\n          ], CtString, None))\n        } else {\n          env_show\n        }\n        let env_default = if struct_derives_has(enum_derives, \"Default\") {\n          env_bind(env_hash, String::concat(name, \"::default\"), CtFn(Array::slice([\n            CtUnit\n          ], 0, 0), ctor_result_type, None))\n        } else {\n          env_hash\n        }\n        (env_default, s, c + param_len)\n      },\n      SSuberror(_, name, variants) => {\n        let ctor_result_type = CtEnum(name)\n        let resolved_variants = Array::slice([\n          (\"\", Array::slice([\n            CtUnknown\n          ], 0, 0))\n        ], 0, 0)\n        let mut vi = 0\n        while vi < Array::length(variants) {\n          let (vname, vtypes) = Array::get(variants, vi)\n          let resolved_vtypes = Array::slice([\n            CtUnknown\n          ], 0, 0)\n          let mut ti = 0\n          while ti < Array::length(vtypes) {\n            Array::push(resolved_vtypes, resolve_type_expr(Array::get(vtypes, ti), defs))\n            ti = ti + 1\n          }\n          Array::push(resolved_variants, (vname, resolved_vtypes))\n          vi = vi + 1\n        }\n        Array::push(defs, TDEnum(name, Array::slice([\n          \"\"\n        ], 0, 0), resolved_variants))\n        let mut env1 = env_bind(env, name, CtEnum(name))\n        let mut ci2 = 0\n        while ci2 < Array::length(variants) {\n          let (vname, vtypes) = Array::get(variants, ci2)\n          let ctor_ty = if Array::length(vtypes) == 0 {\n            ctor_result_type\n          } else {\n            let resolved_args = Array::slice([\n              CtUnknown\n            ], 0, 0)\n            let mut ai = 0\n            while ai < Array::length(vtypes) {\n              Array::push(resolved_args, resolve_type_expr(Array::get(vtypes, ai), defs))\n              ai = ai + 1\n            }\n            CtFn(resolved_args, ctor_result_type, None)\n          }\n          env1 = env_bind(env1, vname, ctor_ty)\n          match ctor_ty {\n            CtFn(_, ret, _) => {\n              env1 = bind_fn_return(env1, vname, ret)\n            },\n            _ => ()\n          }\n          ci2 = ci2 + 1\n        }\n        let env_eq = env_bind(env1, String::concat(name, \"::equals\"), CtFn([\n          ctor_result_type,\n          ctor_result_type\n        ], CtBool, None))\n        (env_eq, s, c)\n      },\n      SStruct(_, name, field_defs, derives, mut_fields) => {\n        validate_derives(derives, errors)\n        let resolved_fields = Array::slice([\n          (\"\", CtUnit)\n        ], 0, 0)\n        let mut fi = 0\n        while fi < Array::length(field_defs) {\n          let (fname, ftype_expr) = Array::get(field_defs, fi)\n          let ftype = resolve_type_expr(ftype_expr, defs)\n          Array::push(resolved_fields, (fname, ftype))\n          fi = fi + 1\n        }\n        Array::push(defs, TDStruct(name, resolved_fields, mut_fields))\n        let field_types = Array::slice([\n          CtUnknown\n        ], 0, 0)\n        let mut fj = 0\n        while fj < Array::length(resolved_fields) {\n          let (_, fty) = Array::get(resolved_fields, fj)\n          Array::push(field_types, fty)\n          fj = fj + 1\n        }\n        let env1 = env_bind(env, name, CtFn(field_types, CtStruct(name), None))\n        let env2 = if struct_derives_has(derives, \"Ord\") {\n          env_bind(env1, String::concat(name, \"::compare\"), CtFn([\n            CtStruct(name),\n            CtStruct(name)\n          ], CtInt, None))\n        } else {\n          env1\n        }\n        let env3 = if struct_derives_has(derives, \"Show\") || struct_derives_has(derives, \"Hash\") {\n          env_bind(env2, String::concat(name, \"::to_string\"), CtFn([\n            CtStruct(name)\n          ], CtString, None))\n        } else {\n          env2\n        }\n        let env4 = env_bind(env3, String::concat(name, \"::equals\"), CtFn([\n          CtStruct(name),\n          CtStruct(name)\n        ], CtBool, None))\n        let env_hash = if struct_derives_has(derives, \"Hash\") {\n          let env_h = EnvTraitImpl(\"Hash\", CtStruct(name), env4)\n          env_bind(env_h, String::concat(name, \"::hash_key\"), CtFn([\n            CtStruct(name)\n          ], CtString, None))\n        } else {\n          env4\n        }\n        let env5 = if struct_derives_has(derives, \"Default\") {\n          env_bind(env_hash, String::concat(name, \"::default\"), CtFn(Array::slice([\n            CtUnit\n          ], 0, 0), CtStruct(name), None))\n        } else {\n          env_hash\n        }\n        (bind_fn_return(env5, name, CtStruct(name)), s, c)\n      },\n      STypeAlias(_, name, params, te) => {\n        let t = resolve_type_expr(te, defs)\n        Array::push(defs, TDAlias(name, params, t))\n        (env_bind(env, name, t), s, c)\n      },\n      SExternLet(name, te) => {\n        let t = resolve_type_expr(te, defs)\n        let env1 = env_bind(env, name, t)\n        (bind_annotation_return(env1, name, Some(te), defs), s, c)\n      },\n      STest(_, body) => {\n        let (_, ns, nc) = check_expr(body, env, defs, s, c, errors, tytab)\n        (env, ns, nc)\n      },\n      SBench(_, body) => {\n        let (_, ns, nc) = check_expr(body, env, defs, s, c, errors, tytab)\n        (env, ns, nc)\n      },\n      SExpr(expr) => {\n        let (_, ns, nc) = check_expr(expr, env, defs, s, c, errors, tytab)\n        (env, ns, nc)\n      },\n      SModule(_, _, body) => {\n        let _ = check_stmts(body, 0, env, defs, s, c, errors, tytab)\n        (env, s, c)\n      },\n      SImport(_, names) => (bind_stmt_imports(env, names), s, c)\n      ,\n      SReExport(_, names) => (bind_stmt_imports(env, names), s, c)\n      ,\n      SAliasDecl(_, _) => (env, s, c)\n      ,\n      STrait(_, name, supers, methods, _) => {\n        let is_open = false\n        (EnvTraitDef(name, supers, is_open, methods, env), s, c)\n      },\n      SImpl(tparams, tbounds, trait_name, type_name) => {\n        let target = match resolve_builtin(type_name) {\n          Some(t) => t,\n          None => CtNamed(type_name, Array::slice([\n            CtUnknown\n          ], 0, 0))\n        }\n        let new_env = if Array::length(tparams) > 0 {\n          EnvTraitImplGen(trait_name, tparams, tbounds, target, env)\n        } else {\n          EnvTraitImpl(trait_name, target, env)\n        }\n        (new_env, s, c)\n      },\n      SEffectDef(_, ename, eparams, ops) => {\n        if Array::length(eparams) == 0 {\n          let resolved_ops = Array::slice([\n            (\"\", Array::slice([\n              CtUnknown\n            ], 0, 0), CtUnknown)\n          ], 0, 0)\n          let mut oi = 0\n          while oi < Array::length(ops) {\n            let (opname, opparams, opret) = Array::get(ops, oi)\n            let rp = Array::slice([\n              CtUnknown\n            ], 0, 0)\n            let mut pi = 0\n            while pi < Array::length(opparams) {\n              Array::push(rp, resolve_type_expr(Array::get(opparams, pi), defs))\n              pi = pi + 1\n            }\n            Array::push(resolved_ops, (opname, rp, resolve_type_expr(opret, defs)))\n            oi = oi + 1\n          }\n          Array::push(defs, TDEffect(ename, resolved_ops))\n        } else {\n          ()\n        }\n        (env, s, c)\n      },\n      _ => (env, s, c)\n    }\n    cur_env = new_env\n    cur_s = s1\n    cur_c = c1\n    idx = idx + 1\n  }\n  (cur_env, cur_s, cur_c)\n}\n\nlet check_program_bounds: (TypeEnv, Subst, Array[String]) -> Unit = (env, s, errors) -> {\n  let pairs = collect_subst_bounds_pairs(s)\n  let n = Array::length(pairs)\n  let mut i = 0\n  while i < n {\n    let (vid, bounds) = Array::get(pairs, i)\n    let resolved = subst_apply(s, CtVar(vid))\n    match resolved {\n      CtVar(_) => (),\n      CtUnknown => (),\n      _ => {\n        let bn = Array::length(bounds)\n        let mut bi = 0\n        while bi < bn {\n          let b = Array::get(bounds, bi)\n          if b != \"\" && not(type_implements_trait(env, s, resolved, b)) {\n            Array::push(errors, String::concat(\"no impl `\", String::concat(b, String::concat(\"` for `\", String::concat(type_to_string(resolved), \"`\")))))\n          }\n          bi = bi + 1\n        }\n      }\n    }\n    i = i + 1\n  }\n}\n\nlet collect_async_effect_errors: (Array[Stmt], TypeEnv, Array[String]) -> Unit = (stmts, env, frozen_errors) -> {\n  if Array::length(frozen_errors) == 0 {\n    let eff_errs = check_async_effects_stmts(stmts, env)\n    let mut i = 0\n    while i < Array::length(eff_errs) {\n      Array::push(frozen_errors, effect_error_to_string(Array::get(eff_errs, i)))\n      i = i + 1\n    }\n    if Array::length(frozen_errors) == 0 {\n      let perform_errs = check_perform_effects_stmts_env(stmts, env)\n      let mut j = 0\n      while j < Array::length(perform_errs) {\n        Array::push(frozen_errors, effect_error_to_string(Array::get(perform_errs, j)))\n        j = j + 1\n      }\n    }\n    if Array::length(frozen_errors) == 0 {\n      let mut_errs = check_mutability_stmts(stmts)\n      let mut k = 0\n      while k < Array::length(mut_errs) {\n        Array::push(frozen_errors, effect_error_to_string(Array::get(mut_errs, k)))\n        k = k + 1\n      }\n    }\n  }\n}\n\nexport let check_program: (Array[Stmt]) -> TypeEnv with { Error } = (stmts) -> {\n  inject_prelude_result(stmts)\n  inject_trait_method_generics(stmts)\n  desugar_railway_binds(stmts)\n  let empty_defs = Array::slice([\n    TDAlias(\"_dummy\", Array::slice([\n      \"\"\n    ], 0, 0), CtUnit)\n  ], 0, 0)\n  let seeded_raw_env = if trait_defined(EnvEmpty, \"Eq\") {\n    EnvEmpty\n  } else {\n    register_builtin_traits(EnvEmpty)\n  }\n  let seeded_env = env_cache(seeded_raw_env)\n  let errors = ArrayBuilder::new()\n  let frozen_errors = ArrayBuilder::freeze(errors)\n  let tytab = Array::slice([\n    (0, CtUnit)\n  ], 0, 0)\n  let (env, final_s, _) = check_stmts(stmts, 0, seeded_env, empty_defs, SubstEmpty, 0, frozen_errors, tytab)\n  check_program_bounds(env, final_s, frozen_errors)\n  collect_async_effect_errors(stmts, env, frozen_errors)\n  if Array::length(frozen_errors) > 0 {\n    throw(Array::get(frozen_errors, 0))\n  }\n  env\n}\n\nexport let check_program_type_table: (Array[Stmt]) -> (Array[(Int, Type)], Subst) with { Error } = (stmts) -> {\n  let empty_defs = Array::slice([\n    TDAlias(\"_dummy\", Array::slice([\n      \"\"\n    ], 0, 0), CtUnit)\n  ], 0, 0)\n  let seeded_raw_env = if trait_defined(EnvEmpty, \"Eq\") {\n    EnvEmpty\n  } else {\n    register_builtin_traits(EnvEmpty)\n  }\n  let seeded_env = env_cache(seeded_raw_env)\n  let errors = ArrayBuilder::new()\n  let frozen_errors = ArrayBuilder::freeze(errors)\n  let tytab = Array::slice([\n    (0, CtUnit)\n  ], 0, 0)\n  handle {\n    let (_, final_s, _) = check_stmts(stmts, 0, seeded_env, empty_defs, SubstEmpty, 0, frozen_errors, tytab)\n    (tytab, final_s)\n  } with Error {\n    Throw(_) => (tytab, SubstEmpty)\n  }\n}\n\nexport let check_program_with_env: (Array[Stmt], TypeEnv) -> TypeEnv with { Error } = (stmts, initial_env) -> {\n  match initial_env {\n    EnvEmpty => check_program(stmts),\n    _ => {\n      inject_prelude_result(stmts)\n      inject_trait_method_generics(stmts)\n      desugar_railway_binds(stmts)\n      let empty_defs = Array::slice([\n        TDAlias(\"_dummy\", Array::slice([\n      \"\"\n    ], 0, 0), CtUnit)\n      ], 0, 0)\n      let cached_env = env_cache(initial_env)\n      let seeded_raw_env = if trait_defined(cached_env, \"Eq\") {\n        cached_env\n      } else {\n        register_builtin_traits(cached_env)\n      }\n      let seeded_env = env_cache(seeded_raw_env)\n      let errors = ArrayBuilder::new()\n      let frozen_errors = ArrayBuilder::freeze(errors)\n      let tytab = Array::slice([\n        (0, CtUnit)\n      ], 0, 0)\n      let (env, _, _) = check_stmts(stmts, 0, seeded_env, empty_defs, SubstEmpty, 0, frozen_errors, tytab)\n      collect_async_effect_errors(stmts, env, frozen_errors)\n      if Array::length(frozen_errors) > 0 {\n        throw(Array::get(frozen_errors, 0))\n      }\n      env\n    }\n  }\n}\n")
}

let selfhost_source_54 = () -> (String, String) {
  ("lib/@vibe/compiler/builtin_name.vibe",
"\nexport let canonical_builtin_name: (String) -> String = (name) -> {\n  match name {\n    \"Fs::ReadFile\" => \"Fs::read_file\",\n    \"Fs::WriteFile\" => \"Fs::write_file\",\n    \"Fs::ReadBytes\" => \"Fs::read_bytes\",\n    \"Fs::WriteBytes\" => \"Fs::write_bytes\",\n    \"Fs::Exists\" => \"Fs::exists\",\n    \"Fs::StatToken\" => \"Fs::stat_token\",\n    \"Fs::ReadDir\" => \"Fs::readdir\",\n    \"Fs::IsDir\" => \"Fs::is_dir\",\n    \"Fs::IsFile\" => \"Fs::is_file\",\n    \"Fs::Mkdir\" => \"Fs::mkdir\",\n    \"Fs::MkdirP\" => \"Fs::mkdir_p\",\n    \"Fs::Getcwd\" => \"Fs::getcwd\",\n    \"Fs::Chdir\" => \"Fs::chdir\",\n    \"Fs::Remove\" => \"Fs::remove\",\n    \"Fs::Copy\" => \"Fs::copy\",\n    \"Fs::Append\" => \"Fs::append\",\n    \"Fs::Rename\" => \"Fs::rename\",\n    \"Env::Get\" => \"Env::get\",\n    \"Env::ArgsLen\" => \"Env::args_len\",\n    \"Env::ArgsGet\" => \"Env::args_get\",\n    \"Profiler::NowUs\" => \"Profiler::now_us\",\n    \"Profiler::HeapBytes\" => \"Profiler::heap_bytes\",\n    _ => name\n  }\n}\n")
}

