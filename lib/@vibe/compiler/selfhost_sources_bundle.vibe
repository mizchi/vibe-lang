"\n\n\nlet misc_no_params: () -> Array[Type] = () -> {\n  Array::slice([\n    CtUnknown\n  ], 0, 0)\n}\n\nlet misc_one_param: (Type) -> Array[Type] = (a) -> {\n  let arr = misc_no_params()\n  Array::push(arr, a)\n  arr\n}\n\nlet lookup_not: (String) -> Option[Type] = (name) -> {\n  if name == \"not\" {\n    Some(CtFn(misc_one_param(CtBool), CtBool, None))\n  }\n  else None\n}\n\nlet lookup_neg: (String) -> Option[Type] = (name) -> {\n  if name == \"__neg\" {\n    Some(CtFn(misc_one_param(CtUnknown), CtUnknown, None))\n  }\n  else None\n}\n\nlet misc_two_params: (Type, Type) -> Array[Type] = (a, b) -> {\n  let arr = misc_no_params()\n  Array::push(arr, a)\n  Array::push(arr, b)\n  arr\n}\n\nlet lookup_eq: (String) -> Option[Type] = (name) -> {\n  if name == \"eq\" {\n    Some(CtFn(misc_two_params(CtInt, CtInt), CtBool, None))\n  }\n  else None\n}\n\nlet lookup_arithmetic_helper: (String) -> Option[Type] = (name) -> {\n  if name == \"add\" || name == \"sub\" || name == \"mul\" {\n    Some(CtFn(misc_two_params(CtInt, CtInt), CtInt, None))\n  } else if name == \"lt\" {\n    Some(CtFn(misc_two_params(CtInt, CtInt), CtBool, None))\n  } else {\n    None\n  }\n}\n\nlet lookup_none: (String) -> Option[Type] = (name) -> {\n  if name == \"None\" {\n    Some(CtOption(CtUnknown))\n  }\n  else None\n}\n\nlet lookup_some: (String) -> Option[Type] = (name) -> {\n  if name == \"Some\" {\n    Some(CtFn(misc_one_param(CtUnknown), CtOption(CtUnknown), None))\n  }\n  else None\n}\n\nlet lookup_index: (String) -> Option[Type] = (name) -> {\n  if name == \"__index\" {\n    Some(CtFn(misc_two_params(CtUnknown, CtUnknown), CtUnknown, None))\n  }\n  else if name == \"__set_field\" {\n    let set_field_params = misc_no_params()\n    Array::push(set_field_params, CtUnknown)\n    Array::push(set_field_params, CtString)\n    Array::push(set_field_params, CtUnknown)\n    Some(CtFn(set_field_params, CtUnit, None))\n  }\n  else None\n}\n\nlet lookup_print: (String) -> Option[Type] = (name) -> {\n  if name == \"print\" {\n    Some(CtFn(misc_one_param(CtString), CtUnit, None))\n  }\n  else None\n}\n\nlet lookup_throw: (String) -> Option[Type] = (name) -> {\n  if name == \"throw\" {\n    Some(CtFn(misc_one_param(CtUnknown), CtUnknown, Some(\"Error\")))\n  }\n  else None\n}\n\nlet misc_three_params: (Type, Type, Type) -> Array[Type] = (a, b, c) -> {\n  let arr = misc_no_params()\n  Array::push(arr, a)\n  Array::push(arr, b)\n  Array::push(arr, c)\n  arr\n}\n\nlet lookup_slice: (String) -> Option[Type] = (name) -> {\n  if name == \"__slice\" {\n    Some(CtFn(misc_three_params(CtUnknown, CtInt, CtInt), CtUnknown, None))\n  }\n  else None\n}\n\nlet lookup_assert: (String) -> Option[Type] = (name) -> {\n  if name == \"assert\" {\n    Some(CtFn(misc_one_param(CtBool), CtUnit, None))\n  }\n  else if name == \"assert_true\" {\n    Some(CtFn(misc_one_param(CtBool), CtUnit, None))\n  }\n  else if name == \"assert_eq\" {\n    Some(CtFn([\n      CtUnknown,\n      CtUnknown\n    ], CtUnit, None))\n  }\n  else None\n}\n\nlet lookup_println: (String) -> Option[Type] = (name) -> {\n  if name == \"println\" {\n    Some(CtFn(misc_one_param(CtString), CtUnit, None))\n  }\n  else None\n}\n\nlet lookup_to_string: (String) -> Option[Type] = (name) -> {\n  if name == \"__to_string\" {\n    Some(CtFn(misc_one_param(CtUnknown), CtString, None))\n  }\n  else None\n}\n\nlet lookup_len: (String) -> Option[Type] = (name) -> {\n  if name == \"__len\" {\n    Some(CtFn(misc_one_param(CtUnknown), CtInt, None))\n  }\n  else None\n}\n\nlet lookup_iter_intrinsic: (String) -> Option[Type] = (name) -> {\n  if name == \"iter_require\" {\n    Some(CtFn(misc_one_param(CtUnknown), CtUnknown, None))\n  } else if name == \"iter_length\" {\n    Some(CtFn(misc_one_param(CtUnknown), CtInt, None))\n  } else if name == \"iter_get\" {\n    Some(CtFn(misc_two_params(CtUnknown, CtInt), CtUnknown, None))\n  } else if name == \"String::iter_length\" {\n    Some(CtFn(misc_one_param(CtString), CtInt, None))\n  } else if name == \"String::iter_get\" {\n    Some(CtFn(misc_two_params(CtString, CtInt), CtInt, None))\n  } else if name == \"Map::iter_length\" {\n    Some(CtFn(misc_one_param(CtUnknown), CtInt, None))\n  } else if name == \"Map::iter_get\" {\n    Some(CtFn(misc_two_params(CtUnknown, CtInt), CtUnknown, None))\n  } else {\n    None\n  }\n}\n\nlet lookup_char_to_int: (String) -> Option[Type] = (name) -> {\n  if name == \"Char::to_int\" {\n    Some(CtFn(misc_one_param(CtChar), CtInt, None))\n  }\n  else None\n}\n\nlet lookup_misc_group_a: (String) -> Option[Type] = (name) -> {\n  match lookup_arithmetic_helper(name) {\n    Some(t) => Some(t),\n    None => match lookup_eq(name) {\n      Some(t) => Some(t),\n      None => match lookup_not(name) {\n        Some(t) => Some(t),\n        None => match lookup_neg(name) {\n          Some(t) => Some(t),\n          None => match lookup_to_string(name) {\n            Some(t) => Some(t),\n            None => match lookup_len(name) {\n              Some(t) => Some(t),\n              None => lookup_index(name)\n            }\n          }\n        }\n      }\n    }\n  }\n}\n\nlet lookup_misc_group_b: (String) -> Option[Type] = (name) -> {\n  match lookup_slice(name) {\n    Some(t) => Some(t),\n    None => match lookup_print(name) {\n      Some(t) => Some(t),\n      None => match lookup_println(name) {\n        Some(t) => Some(t),\n        None => lookup_assert(name)\n      }\n    }\n  }\n}\n\nlet lookup_misc_group_e: (String) -> Option[Type] = (name) -> {\n  if name == \"String::join\" {\n    Some(CtFn(misc_two_params(CtArray(CtString), CtString), CtString, None))\n  } else if name == \"__rec_field\" {\n    Some(CtFn(misc_two_params(CtUnknown, CtInt), CtUnknown, None))\n  } else {\n    match lookup_iter_intrinsic(name) {\n      Some(t) => Some(t),\n      None => lookup_none(name)\n    }\n  }\n}\n\nlet lookup_char_from_int: (String) -> Option[Type] = (name) -> {\n  if name == \"Char::from_int\" {\n    Some(CtFn(misc_one_param(CtInt), CtChar, None))\n  }\n  else None\n}\n\nlet lookup_double_to_int: (String) -> Option[Type] = (name) -> {\n  if name == \"Double::to_int\" || name == \"Float::to_int\" {\n    Some(CtFn(misc_one_param(CtDouble), CtInt, None))\n  }\n  else None\n}\n\nlet lookup_int_to_double: (String) -> Option[Type] = (name) -> {\n  if name == \"Int::to_double\" || name == \"Int::to_float\" {\n    Some(CtFn(misc_one_param(CtInt), CtDouble, None))\n  }\n  else if name == \"Int::to_string\" {\n    Some(CtFn(misc_one_param(CtInt), CtString, None))\n  }\n  else None\n}\n\nlet lookup_double_to_i64_bits: (String) -> Option[Type] = (name) -> {\n  if name == \"Double::to_i64_bits\" || name == \"Double::to_i64_bits_lo\" || name == \"Double::to_i64_bits_hi\" {\n    Some(CtFn(misc_one_param(CtDouble), CtInt, None))\n  }\n  else None\n}\n\nlet lookup_misc_group_c: (String) -> Option[Type] = (name) -> {\n  match lookup_throw(name) {\n    Some(t) => Some(t),\n    None => match lookup_int_to_double(name) {\n      Some(t) => Some(t),\n      None => match lookup_double_to_int(name) {\n        Some(t) => Some(t),\n        None => lookup_double_to_i64_bits(name)\n      }\n    }\n  }\n}\n\nlet lookup_double_from_i64_bits: (String) -> Option[Type] = (name) -> {\n  if name == \"Double::from_i64_bits\" {\n    Some(CtFn(misc_one_param(CtInt), CtDouble, None))\n  }\n  else None\n}\n\nlet lookup_misc_group_d: (String) -> Option[Type] = (name) -> {\n  match lookup_double_from_i64_bits(name) {\n    Some(t) => Some(t),\n    None => match lookup_char_to_int(name) {\n      Some(t) => Some(t),\n      None => match lookup_char_from_int(name) {\n        Some(t) => Some(t),\n        None => lookup_some(name)\n      }\n    }\n  }\n}\n\nlet lookup_double_to_string: (String) -> Option[Type] = (name) -> {\n  if name == \"Double::to_string\" || name == \"Float::to_string\" {\n    Some(CtFn(misc_one_param(CtDouble), CtString, None))\n  }\n  else None\n}\n\nlet lookup_double_unary_op: (String) -> Option[Type] = (name) -> {\n  if name == \"Double::abs\" || name == \"Double::floor\" || name == \"Double::ceil\" {\n    Some(CtFn(misc_one_param(CtDouble), CtDouble, None))\n  }\n  else None\n}\n\nlet lookup_double_binary_op: (String) -> Option[Type] = (name) -> {\n  if name == \"Double::max\" || name == \"Double::min\" {\n    Some(CtFn(misc_two_params(CtDouble, CtDouble), CtDouble, None))\n  }\n  else None\n}\n\nlet lookup_int_parse: (String) -> Option[Type] = (name) -> {\n  if name == \"Int::parse\" {\n    Some(CtFn(misc_one_param(CtString), CtOption(CtInt), None))\n  }\n  else None\n}\n\nlet lookup_misc_group_f: (String) -> Option[Type] = (name) -> {\n  match lookup_double_to_string(name) {\n    Some(t) => Some(t),\n    None => match lookup_double_unary_op(name) {\n      Some(t) => Some(t),\n      None => match lookup_double_binary_op(name) {\n        Some(t) => Some(t),\n        None => lookup_int_parse(name)\n      }\n    }\n  }\n}\n\nexport let lookup_misc: (String) -> Option[Type] = (name) -> {\n  match lookup_misc_group_a(name) {\n    Some(t) => Some(t),\n    None => match lookup_misc_group_b(name) {\n      Some(t) => Some(t),\n      None => match lookup_misc_group_c(name) {\n        Some(t) => Some(t),\n        None => match lookup_misc_group_d(name) {\n          Some(t) => Some(t),\n          None => match lookup_misc_group_e(name) {\n            Some(t) => Some(t),\n            None => lookup_misc_group_f(name)\n          }\n        }\n      }\n    }\n  }\n}\n")
