let selfhost_source_122 = () -> (String, String) {
  ("lib/@vibe/compiler/codegen/gc/backend_lambda_emit.vibe",
"\n\n\n\n\n\nlet emit_lambda_closure_gc: (Bytes, Array[String], Int, Array[String], Int, Int) -> Int with { Error } = (buf, captures, num_captures, local_names, next_local, table_slot) -> {\n  if num_captures == 0 {\n    emit_i64_const(buf, (table_slot<<2)|2)\n    next_local\n  } else {\n    let alloc_size = 8 + num_captures * 8\n    let ptr_local = next_local\n    let nl2 = next_local + 1\n    Array::push(local_names, \"__closure_ptr\")\n    emit_global_get(buf, 0)\n    emit_i64_extend_i32_u(buf)\n    emit_local_tee(buf, ptr_local)\n    emit_i32_wrap_i64(buf)\n    emit_i32_const(buf, alloc_size)\n    emit_i32_add(buf)\n    emit_global_set(buf, 0)\n    emit_heap_memory_grow_check(buf)\n    emit_local_get(buf, ptr_local)\n    emit_i32_wrap_i64(buf)\n    emit_i32_const(buf, table_slot)\n    emit_i32_store(buf, 2, 0)\n    emit_local_get(buf, ptr_local)\n    emit_i32_wrap_i64(buf)\n    emit_i32_const(buf, num_captures)\n    emit_i32_store(buf, 2, 4)\n    let mut csi = 0\n    while csi < num_captures {\n      let cap_name = Array::get(captures, csi)\n      let cap_idx = resolve_local(local_names, cap_name, \"gc_cap\")\n      emit_local_get(buf, ptr_local)\n      emit_i32_wrap_i64(buf)\n      emit_local_get(buf, cap_idx)\n      emit_i64_store(buf, 3, 8 + csi * 8)\n      csi = csi + 1\n    }\n    emit_local_get(buf, ptr_local)\n    emit_i64_const(buf, 1)\n    emit_i64_or(buf)\n    nl2\n  }\n}\n\n\nexport {\n  emit_lambda_closure_gc\n}\n")
}

