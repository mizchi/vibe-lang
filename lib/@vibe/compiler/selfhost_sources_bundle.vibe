  \"Bytes::set\" => 20,\n        \"Bytes::push\" => 21,\n        \"Bytes::append\" => 22,\n        \"Bytes::concat\" => 23,\n        \"Bytes::slice\" => 24,\n        \"Bytes::from_array\" => 25,\n        \"Bytes::to_array\" => 26,\n        \"Bytes::blit\" => 27,\n        \"Bytes::fill\" => 28,\n        \"Double::to_i64_bits\" => 16,\n        \"Double::from_i64_bits\" => 16,\n        \"Double::to_float\" => 16,\n        \"Float::to_double\" => 16,\n        \"Char::to_int\" => 16,\n        \"Char::from_int\" => 16,\n        \"Int::to_float\" => 12,\n        \"FixedArray::make\" => 6,\n        \"FixedArray::length\" => 6,\n        \"FixedArray::get\" => 6,\n        \"FixedArray::set\" => 6,\n        \"FixedArray::unsafe_set\" => 6,\n        \"FixedArray::blit\" => 6,\n        \"StringBuilder::new\" => 6,\n        \"StringBuilder::push\" => 6,\n        \"StringBuilder::freeze\" => 6,\n        \"Map::get\" => 6,\n        \"Map::keys\" => 6,\n        \"MapBuilder::new\" => 6,\n        \"MapBuilder::set\" => 6,\n        \"MapBuilder::freeze\" => 6,\n        \"__to_string\" => 17,\n        \"assert\" => 6,\n        \"assert_true\" => 6,\n        \"assert_eq\" => 6,\n        \"println\" => 6,\n        \"print\" => 6,\n        \"map_has\" => 6,\n        _ => 0 - 1\n      }\n      if gc_body_idx < 0 {\n        throw(\"builtin registry drift: no gc body-index mapping for builtin '\\{gc_name}' (add a match arm in backend_body.vibe, #415)\")\n      } else {\n        ()\n      }\n      Array::push(builtin_defs, (gc_name, gc_params, gc_body_idx, gc_returns))\n    } else {\n      ()\n    }\n    gc_reg_i = gc_reg_i + 1\n  }\n  let __reg_names = Array::slice([\n    \"\"\n  ], 0, 0)\n  let __reg_params = Array::slice([\n    0\n  ], 0, 0)\n  let __reg_returns = Array::slice([\n    0\n  ], 0, 0)\n  let mut __ri = 0\n  while __ri < Array::length(builtin_defs) {\n    let (rbname, rbparams, _, rbreturns) = Array::get(builtin_defs, __ri)\n    Array::push(__reg_names, rbname)\n    Array::push