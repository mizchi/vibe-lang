leb128_encode_u32(buf, simd_v128_any_true)\n}\n\nexport let emit_i8x16_all_true: (Bytes) -> Unit = (buf) -> {\n  bytebuf_push(buf, simd_prefix)\n  leb128_encode_u32(buf, simd_i8x16_all_true)\n}\n\nexport let emit_i8x16_bitmask: (Bytes) -> Unit = (buf) -> {\n  bytebuf_push(buf, simd_prefix)\n  leb128_encode_u32(buf, simd_i8x16_bitmask)\n}\n\n\nexport let emit_v128_and: (Bytes) -> Unit = (buf) -> {\n  bytebuf_push(buf, simd_prefix)\n  leb128_encode_u32(buf, simd_v128_and)\n}\n\nexport let emit_v128_or: (Bytes) -> Unit = (buf) -> {\n  bytebuf_push(buf, simd_prefix)\n  leb128_encode_u32(buf, 80)\n}\n\nexport let emit_v128_not: (Bytes) -> Unit = (buf) -> {\n  bytebuf_push(buf, simd_prefix)\n  leb128_encode_u32(buf, simd_v128_not)\n}\n\n\nexport let emit_v128_const: (Bytes, Array[Int]) -> Unit = (buf, lanes) -> {\n  bytebuf_push(buf, simd_prefix)\n  leb128_encode_u32(buf, simd_v128_const)\n  let n = Array::length(lanes)\n  let mut i = 0\n  while i < 16 {\n    let b = if i < n {\n      Array::get(lanes, i)\n    } else {\n      0\n    }\n    bytebuf_push(buf, b & 255)\n    i = i + 1\n  }\n}\n\nexport let emit_v128_const_zero: (Bytes) -> Unit = (buf) -> {\n  bytebuf_push(buf, simd_prefix)\n  leb128_encode_u32(buf, simd_v128_const)\n  let mut i = 0\n  while i < 16 {\n    bytebuf_push(buf, 0)\n    i = i + 1\n  }\n}\n\nexport let emit_v128_const_splat_byte: (Bytes, Int) -> Unit = (buf, byte_val) -> {\n  bytebuf_push(buf, simd_prefix)\n  leb128_encode_u32(buf, simd_v128_const)\n  let mut i = 0\n  while i < 16 {\n    bytebuf_push(buf, byte_val & 255)\n    i = i + 1\n  }\n}\n")
