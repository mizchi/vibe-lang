alue = get_eletmut_val(expr)\n    let body = get_eletmut_body(expr)\n    let local_idx = next_local\n    emit_dbg_line_stmt(buf, value, get_eletmut_off(expr), ctx)\n    Array::push(local_names, name)\n    if expr_is_floatish(value, local_names, ctx) {\n      Array::push(ctx.float_local_slots, local_idx * 2 + 1)\n    } else if slot_is_floatish(ctx, local_idx) {\n      Array::push(ctx.float_local_slots, local_idx * 2)\n    }\n    if expr_is_boolish(value, local_names, ctx) {\n      Array::push(ctx.int_local_slots, local_idx * 4 + 3)\n    } else if expr_is_intish(value, local_names, ctx) {\n      Array::push(ctx.int_local_slots, local_idx * 4 + 1)\n    } else if slot_is_intish(ctx, local_idx) {\n      Array::push(ctx.int_local_slots, local_idx * 4)\n    }\n    if mut_needs_ref_cell(body, name) {\n      Array::push(ctx.ref_cell_names, name)\n      if ctx.enable_rc && ctx.rc_alloc_func_idx >= 0 && ctx.rc_drop_func_idx >= 0 && expr_is_intish(value, local_names, ctx) {\n        emit_i64_const(buf, 16)\n        emit_call(buf, ctx.rc_alloc_func_idx)\n        emit_local_set(buf, local_idx)\n        emit_local_get(buf, local_idx)\n        emit_i32_wrap_i64(buf)\n        emit_i32_const(buf, 16)\n        emit_i32_store(buf, 2, 0)\n        emit_local_get(buf, local_idx)\n        emit_i32_wrap_i64(buf)\n        emit_i32_const(buf, 1)\n        emit_i32_store(buf, 2, 4)\n        emit_local_get(buf, local_idx)\n        emit_i32_wrap_i64(buf)\n        emit_i32_const(buf, 8)\n        emit_i32_store8(buf, 0, 7)\n        emit_local_get(buf, local_idx)\n        emit_i64_const(buf, 8)\n        emit_i64_add(buf)\n        emit_local_set(buf, local_idx)\n        emit_local_get(buf, local_idx)\n        emit_i32_wrap_i64(buf)\n        let nl = compile_expr(buf, value, local_names, next_local + 1, ctx, ld)\n        emit_i64_store(buf, 3, 0)\n        let nl2 = compile_expr(buf, body, local_names, nl, ctx, ld)\n        emit_local_get(buf, local_idx)\n        emit_i64_const(buf, 1)\n        emit_i64_or(buf)\n        emit_call(buf, ctx.rc_drop_func_idx)\n        nl2\n      } else {\n      emit_global_get(buf, 0)\n      emit_i64_extend_i32_u(buf)\n      emit_local_tee(buf, local_idx)\n      emit_i32_wrap_i64(buf)\n      emit_i32_const(buf, 8)\n      emit_i32_add(buf)\n      emit_global_set(buf, 0)\n      emit_heap_grow_after_heap_set(buf, ctx)\n      emit_local_get(buf, local_idx)\n      emit_i32_wrap_i64(buf)\n      let nl = compile_expr(buf, value, local_names, next_local + 1, ctx, ld)\n      emit_i64_store(buf, 3, 0)\n      let nl2 = compile_expr(buf, body, local_names, nl, ctx, ld)\n      nl2\n      }\n    } else {\n      let nl = compile_expr(buf, retain_wrap_let_value(value, name, ctx), local_names, next_local + 1, ctx, ld)\n      emit_local_set(buf, local_idx)\n      let (_mut_rc_kind, _mut_is_borrow_ret_ext) = classify_let_value_heap(buf, value, name, local_idx, local_names, ctx)\n      if ctx.enable_rc {\n        let mut mdbi = 0\n        while mdbi < Array::length(ctx.rc_dup_names) {\n          if Array::get(ctx.rc_dup_names, mdbi) == name {\n            emit_rc_dup_guarded(buf, local_idx, ctx.rc_shadow)\n          } else {\n            ()\n          }\n          mdbi = mdbi + 1\n        }\n      } else {\n        ()\n      }\n      let nl2 = compile_expr(buf, body, local_names, nl, ctx, ld)\n      if ctx.enable_rc && array_contains_str(ctx.heap_binding_names, name) && array_contains_str(ctx.rc_drop_names, name) && ctx.rc_drop_func_idx >= 0 {\n        if scope_tail_proj_root(body) == name {\n          emit_local_set(buf, nl2)\n          emit_rc_dup_guarded(buf, nl2, ctx.rc_shadow)\n          emit_local_get(buf, local_idx)\n          emit_call(buf, ctx.rc_drop_func_idx)\n          emit_local_get(buf, nl2)\n          nl2 + 1\n        } else {\n          emit_local_get(buf, local_idx)\n          emit_call(buf, ctx.rc_drop_func_idx)\n          nl2\n        }\n      } else {\n        nl2\n      }\n    }\n  } else if __tag == 12 {\n    let name = get_eassign_name(expr)\n    let value = get_eassign_val(expr)\n    let body = get_eassign_body(expr)\n    let idx = resolve_local(local_names, name, \"assign\")\n    if array_contains_str(ctx.ref_cell_names, name) {\n      emit_local_get(buf, idx)\n      emit_i32_wrap_i64(buf)\n      let nl = compile_expr(buf, value, local_names, next_local, ctx, ld)\n      emit_i64_store(buf, 3, 0)\n      compile_expr(buf, body, local_names, nl, ctx, ld)\n    } else {\n      let is_heap_mut = ctx.enable_rc && ctx.rc_drop_func_idx >= 0 && array_contains_str(ctx.heap_binding_names, name)\n      let is_self = assign_value_mentions(value, name)\n      if is_heap_mut && is_self && reassign_self_reusable(value, name) {\n        let old_temp = next_local\n        let scratch = next_local + 1\n        let base = next_local + 2\n        emit_local_get(buf, idx)\n        emit_local_set(buf, old_temp)\n        let elems = get_etuple_elems(value)\n        let mut ei = 0\n        while ei < Array::length(elems) {\n          let elem = Array::get(elems, ei)\n          if (is_eident(elem) && get_eident_name(elem) == name) || (is_edot(elem) && proj_root_ident(elem) == name) {\n            let _ = compile_expr(buf, elem, local_names, base, ctx, ld)\n            emit_local_set(buf, scratch)\n            emit_rc_dup_guarded(buf, scratch, ctx.rc_shadow)\n          } else {\n            ()\n          }\n          ei = ei + 1\n        }\n        let nl = compile_expr(buf, value, local_names, base, ctx, ld)\n        emit_local_set(buf, idx)\n        emit_local_get(buf, old_temp)\n        emit_call(buf, ctx.rc_drop_func_idx)\n        compile_expr(buf, body, local_names, nl, ctx, ld)\n      } else {\n        if is_heap_mut && !is_self {\n          emit_local_get(buf, idx)\n          emit_call(buf, ctx.rc_drop_func_idx)\n        } else {\n          ()\n        }\n        let nl = compile_expr(buf, value, local_names, next_local, ctx, ld)\n        emit_local_set(buf, idx)\n        if is_heap_mut && !is_self && is_edot(value) {\n          emit_rc_dup_guarded(buf, idx, ctx.rc_shadow)\n        } else {\n          ()\n        }\n        if ctx.enable_rc && is_heap_mut {\n          let mut adbi = 0\n          while adbi < Array::length(ctx.rc_dup_names) {\n            if Array::get(ctx.rc_dup_names, adbi) == name {\n              emit_rc_dup_guarded(buf, idx, ctx.rc_shadow)\n            } else {\n              ()\n            }\n            adbi = adbi + 1\n          }\n        } else {\n          ()\n        }\n        compile_expr(buf, body, local_names, nl, ctx, ld)\n      }\n    }\n  } else if __tag == 13 {\n    let name = get_eassignop_name(expr)\n    let op = get_eassignop_op(expr)\n    let value = get_eassignop_val(expr)\n    let body = get_eassignop_body(expr)\n    let idx = resolve_local(local_names, name, \"assignop\")\n    if array_contains_str(ctx.ref_cell_names, name) {\n      emit_local_get(buf, idx)\n      emit_i32_wrap_i64(buf)\n      emit_local_get(buf, idx)\n      emit_i32_wrap_i64(buf)\n      emit_i64_load(buf, 3, 0)\n      let nl = compile_expr(buf, value, local_names, next_local, ctx, ld)\n      emit_assignop_op(buf, op)\n      emit_assignop_rc_tag_fix(buf, ctx.enable_rc, op)\n      emit_i64_store(buf, 3, 0)\n      compile_expr(buf, body, local_names, nl, ctx, ld)\n    } else {\n      emit_local_get(buf, idx)\n      let nl = compile_expr(buf, value, local_names, next_local, ctx, ld)\n      emit_assignop_op(buf, op)\n      emit_assignop_rc_tag_fix(buf, ctx.enable_rc, op)\n      emit_local_set(buf, idx)\n      compile_expr(buf, body, local_names, nl, ctx, ld)\n    }\n  } else if __tag == 14 {\n    let first = get_eseq_first(expr)\n    let second = get_eseq_second(expr)\n    emit_dbg_line_for(buf, first, ctx)\n    let nl = compile_expr(buf, first, local_names, next_local, ctx, ld)\n    emit_drop(buf)\n    compile_expr(buf, second, local_names, nl, ctx, ld)\n  } else {\n    compile_expr_tail2(buf, expr, local_names, next_local, ctx, ld, compile_expr)\n  }\n}\n")
