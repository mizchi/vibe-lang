let selfhost_source_2 = () -> (String, String) {
  ("lib/@vibe/parser/index.vibei",
"version 0.1.0\n\n// @vibe/parser — the vibe lexer / parser / printer (ADR-0065 Phase 3, #753).\n// Depends on @vibe/ast (the impl files import ../ast for the node types;\n// Expr/Pat/Stmt/TypeExpr in the signatures below are those types). Token is\n// a bodyless type declaration: the enum definition lives in token.vibe (the\n// lexer/parser construct and match it, so a transparent contract definition\n// would hit the impl-before-facade check order, #752 rule), and the facade\n// re-exports it with ctors intact.\n//\n// The surface deliberately includes the parser-combinator primitives\n// (peek/tk_name/parse_type/parse_fn_signature/...) — the compiler's contract\n// engine, cst lowering, and editor tooling build on them, and conformance\n// requires every `export let` of the impl files to be declared here.\n\nimport ./polyfill.vibe {}\nimport ./token.vibe {}\nimport ./float_format.vibe {}\nimport ./lexer.vibe {}\nimport ./parser_base.vibe {}\nimport ./parser_expr_primary.vibe {}\nimport ./parser_expr_core.vibe {}\nimport ./parser_expr_dispatch.vibe {}\nimport ./parser_expr.vibe {}\nimport ./parser.vibe {}\nimport ./expand_interp.vibe {}\nimport ./printer.vibe {}\n\ntype Token\n\n// --- polyfill\nlet version: String\n\n// --- token\nfn token_to_string(t: Token) -> String\n\n// --- float_format\nfn double_to_string_compiler(d: Double) -> String\n\n// --- lexer\nfn lex(src: String) -> Array[Token] with { Error }\nfn lex_ok(src: String) -> Bool\nfn lex_with_offsets(src: String) -> (Array[Token], Array[Int], Array[Int]) with { Error }\nfn offset_to_line_col(src: String, offset: Int) -> (Int, Int)\n\n// --- parser_base\nfn peek(tokens: Array[Token], pos: Int) -> Token\nfn tk_name(t: Token) -> String\nfn skip_semi(tokens: Array[Token], pos: Int) -> Int\nfn parse_derive_names(tokens: Array[Token], pos: Int) -> (Array[String], Int) with { Error }\nfn skip_derive(tokens: Array[Token], pos: Int) -> Int with { Error }\nfn skip_braced_body(tokens: Array[Token], pos: Int) -> Int\nfn collect_import_path(tokens: Array[Token], pos: Int, acc: String) -> (String, Int) with { Error }\nfn parse_type(tokens: Array[Token], pos: Int) -> (TypeExpr, Int) with { Error }\n\n// --- parser_expr (+ primary/core/dispatch stages)\nfn parse(tokens: Array[Token]) -> Expr with { Error }\nfn parse_ok(tokens: Array[Token]) -> Bool\nfn parse_expr(tokens: Array[Token], pos: Int) -> (Expr, Int) with { Error }\nfn parse_impl(tokens: Array[Token], starts: Array[Int], pos: Int, min_prec: Int) -> (Expr, Int) with { Error }\nfn parse_fn_signature(tokens: Array[Token], pos: Int) -> ((String, Array[String], Array[(String, Array[String])]), (Array[(String, Option[TypeExpr])], TypeExpr, Option[String]), (Array[Expr], Array[Expr]), Int) with { Error }\nfn parse_primary(tokens: Array[Token], starts: Array[Int], pos: Int, k: (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error }\nfn parse_infix(tokens: Array[Token], starts: Array[Int], pos: Int, min_prec: Int, depth: Int, k: (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error }\nfn parse_infix_no_is(tokens: Array[Token], starts: Array[Int], pos: Int, min_prec: Int, depth: Int, k: (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error }\nfn parse_impl_dispatch(tokens: Array[Token], starts: Array[Int], pos: Int, depth: Int, k: (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error }\n\n// --- parser\nfn parse_stmt(tokens: Array[Token], starts: Array[Int], pos: Int) -> (Stmt, Int) with { Error }\nfn parse_program(tokens: Array[Token]) -> Array[Stmt] with { Error }\nfn parse_program_located(tokens: Array[Token], starts: Array[Int], src: String) -> Array[Stmt] with { Error }\nfn parse_program_recovering(tokens: Array[Token], starts: Array[Int], src: String) -> (Array[Stmt], Array[String]) with { Error }\nfn parse_program_spans(tokens: Array[Token], starts: Array[Int], ends: Array[Int]) -> (Array[Stmt], Array[Int], Array[Int]) with { Error }\n\n// --- expand_interp\nfn resolve_interp_expr(e: Expr) -> Expr with { Error }\nfn resolve_interp_stmts(stmts: Array[Stmt]) -> Array[Stmt] with { Error }\n\n// --- printer\nfn print_pat(p: Pat) -> String\nfn print_type_expr(t: TypeExpr) -> String\nfn print_expr(e: Expr) -> String\nfn print_stmt(s: Stmt) -> String\nfn print_program(stmts: Array[Stmt]) -> String\n")
}

let selfhost_source_3 = () -> (String, String) {
  ("lib/@vibe/parser/polyfill.vibe",
"\nlet __to_string: (Int) -> String = (n) -> {\n  if n == 0 {\n    \"0\"\n  } else {\n    let mut val = n\n    let mut neg = false\n    if val < 0 {\n      neg = true\n      val = 0 - val\n    }\n    let digits = Array::slice([\n      \"\"\n    ], 0, 0)\n    while val > 0 {\n      let d = val - (val / 10) * 10\n      let ch = if d == 0 {\n        \"0\"\n      }\n      else if d == 1 {\n        \"1\"\n      }\n      else if d == 2 {\n        \"2\"\n      }\n      else if d == 3 {\n        \"3\"\n      }\n      else if d == 4 {\n        \"4\"\n      }\n      else if d == 5 {\n        \"5\"\n      }\n      else if d == 6 {\n        \"6\"\n      }\n      else if d == 7 {\n        \"7\"\n      }\n      else if d == 8 {\n        \"8\"\n      }\n      else {\n        \"9\"\n      }\n      Array::push(digits, ch)\n      val = val / 10\n    }\n    let mut result = if neg {\n      \"-\"\n    } else {\n      \"\"\n    }\n    let mut i = Array::length(digits) - 1\n    while i >= 0 {\n      result = String::concat(result, Array::get(digits, i))\n      i = i - 1\n    }\n    result\n  }\n}\n\nexport let version: String = \"0.1.0\"\n\nexport {\n  __to_string\n}\n")
}

let selfhost_source_4 = () -> (String, String) {
  ("lib/@vibe/parser/token.vibe",
"\n\n\n\nexport enum Token {\n  TInt(Int);\n  TFloat(Double);\n  TString(String);\n  TIdent(String);\n  TLet;\n  TRec;\n  TMut;\n  TFn;\n  TIf;\n  TElse;\n  TMatch;\n  TIs;\n  TDo;\n  TEnum;\n  TStruct;\n  TType;\n  TTrait;\n  TImpl;\n  TExport;\n  TTest;\n  TWhile;\n  TFor;\n  TIn;\n  TLoop;\n  TBreak;\n  TContinue;\n  TReturn;\n  TWith;\n  THandle;\n  TThrow;\n  TRaise;\n  TYield;\n  TBench;\n  TDeclare;\n  TAs;\n  TModule;\n  TSuberror;\n  TDerive;\n  TOpen;\n  TImport;\n  TPlus;\n  TMinus;\n  TStar;\n  TSlash;\n  TPercent;\n  TEqEq;\n  TNeq;\n  TLt;\n  TLte;\n  TGt;\n  TGte;\n  TAnd;\n  TOr;\n  TNot;\n  TBitAnd;\n  TBitOr;\n  TBitXor;\n  TLShift;\n  TRShift;\n  TPipeGt;\n  TArrow;\n  TThinArrow;\n  TEq;\n  TDot;\n  TColon;\n  TDoubleColon;\n  TComma;\n  TSemicolon;\n  THash;\n  TTilde;\n  TQuestion;\n  TPlusEq;\n  TMinusEq;\n  TStarEq;\n  TSlashEq;\n  TPercentEq;\n  TLParen;\n  TRParen;\n  TLBrace;\n  TRBrace;\n  TLBracket;\n  TRBracket;\n  TDotDot;\n  TDotDotDot;\n  TStringInterp(Array[String]);\n  TEof\n}\n\n\nexport let token_to_string: (Token) -> String = (t) -> {\n  match t {\n    TInt(n) => String::concat(\"TInt(\", String::concat(__to_string(n), \")\")),\n    TFloat(n) =>\n    String::concat(\"TFloat(\", String::concat(double_to_string_compiler(n), \")\")),\n    TString(s) => String::concat(\"TString(\\\"\", String::concat(s, \"\\\")\")),\n    TIdent(s) => String::concat(\"TIdent(\", String::concat(s, \")\")),\n    TLet => \"TLet\",\n    TRec => \"TRec\",\n    TMut => \"TMut\",\n    TFn => \"TFn\",\n    TIf => \"TIf\",\n    TElse => \"TElse\",\n    TMatch => \"TMatch\",\n    TIs => \"TIs\",\n    TDo => \"TDo\",\n    TEnum => \"TEnum\",\n    TStruct => \"TStruct\",\n    TType => \"TType\",\n    TTrait => \"TTrait\",\n    TImpl => \"TImpl\",\n    TExport => \"TExport\",\n    TTest => \"TTest\",\n    TWhile => \"TWhile\",\n    TFor => \"TFor\",\n    TIn => \"TIn\",\n    TLoop => \"TLoop\",\n    TBreak => \"TBreak\",\n    TContinue => \"TContinue\",\n    TReturn => \"TReturn\",\n    TWith => \"TWith\",\n    THandle => \"THandle\",\n    TThrow => \"TThrow\",\n    TRaise => \"TRaise\",\n    TYield => \"TYield\",\n    TBench => \"TBench\",\n    TDeclare => \"TDeclare\",\n    TAs => \"TAs\",\n    TModule => \"TModule\",\n    TSuberror => \"TSuberror\",\n    TDerive => \"TDerive\",\n    TOpen => \"TOpen\",\n    TImport => \"TImport\",\n    TPlus => \"TPlus\",\n    TMinus => \"TMinus\",\n    TStar => \"TStar\",\n    TSlash => \"TSlash\",\n    TPercent => \"TPercent\",\n    TEqEq => \"TEqEq\",\n    TNeq => \"TNeq\",\n    TLt => \"TLt\",\n    TLte => \"TLte\",\n    TGt => \"TGt\",\n    TGte => \"TGte\",\n    TAnd => \"TAnd\",\n    TOr => \"TOr\",\n    TNot => \"TNot\",\n    TBitAnd => \"TBitAnd\",\n    TBitOr => \"TBitOr\",\n    TBitXor => \"TBitXor\",\n    TLShift => \"TLShift\",\n    TRShift => \"TRShift\",\n    TPipeGt => \"TPipeGt\",\n    TArrow => \"TArrow\",\n    TThinArrow => \"TThinArrow\",\n    TEq => \"TEq\",\n    TDot => \"TDot\",\n    TColon => \"TColon\",\n    TDoubleColon => \"TDoubleColon\",\n    TComma => \"TComma\",\n    TSemicolon => \"TSemicolon\",\n    THash => \"THash\",\n    TTilde => \"TTilde\",\n    TQuestion => \"TQuestion\",\n    TPlusEq => \"TPlusEq\",\n    TMinusEq => \"TMinusEq\",\n    TStarEq => \"TStarEq\",\n    TSlashEq => \"TSlashEq\",\n    TPercentEq => \"TPercentEq\",\n    TLParen => \"TLParen\",\n    TRParen => \"TRParen\",\n    TLBrace => \"TLBrace\",\n    TRBrace => \"TRBrace\",\n    TLBracket => \"TLBracket\",\n    TRBracket => \"TRBracket\",\n    TDotDot => \"TDotDot\",\n    TDotDotDot => \"TDotDotDot\",\n    TStringInterp(_) => \"TStringInterp\",\n    TEof => \"TEof\"\n  }\n}\n")
