let selfhost_source_67 = () -> (String, String) {
  ("lib/@vibe/compiler/codegen/wasm_emit/builders.vibe",
"\n\n\n\n\nlet builders_vt_i32 = 127\n\nlet builders_sec_data = 11\n\nlet sec_type = 1\n\nexport let string_to_data: (String) -> Bytes = (s) -> {\n  let buf = bytebuf_new()\n  let len = String::length(s)\n  let mut i = 0\n  while i < len {\n    bytebuf_push(buf, String::char_code_at(s, i))\n    i = i + 1\n  }\n  buf\n}\n\nlet empty_int_array: () -> Array[Int] = () -> {\n  Array::slice([\n    0\n  ], 0, 0)\n}\n\nlet pair_int_array: (Int, Int) -> Array[Int] = (v0, v1) -> {\n  let values = empty_int_array()\n  Array::push(values, v0)\n  Array::push(values, v1)\n  values\n}\n\nlet quad_int_array: (Int, Int, Int, Int) -> Array[Int] = (v0, v1, v2, v3) -> {\n  let values = empty_int_array()\n  Array::push(values, v0)\n  Array::push(values, v1)\n  Array::push(values, v2)\n  Array::push(values, v3)\n  values\n}\n\nlet triple_int_array: (Int, Int, Int) -> Array[Int] = (v0, v1, v2) -> {\n  let values = empty_int_array()\n  Array::push(values, v0)\n  Array::push(values, v1)\n  Array::push(values, v2)\n  values\n}\n\nlet empty_bytes_array: () -> Array[Bytes] = () -> {\n  Array::slice([\n    bytebuf_new()\n  ], 0, 0)\n}\n\nlet pair_bytes_array: (Bytes, Bytes) -> Array[Bytes] = (v0, v1) -> {\n  let values = empty_bytes_array()\n  Array::push(values, v0)\n  Array::push(values, v1)\n  values\n}\n\nlet builders_empty_string_array: () -> Array[String] = () -> {\n  Array::slice([\n    \"\"\n  ], 0, 0)\n}\n\nlet pair_string_array: (String, String) -> Array[String] = (v0, v1) -> {\n  let values = builders_empty_string_array()\n  Array::push(values, v0)\n  Array::push(values, v1)\n  values\n}\n\nexport let build_call_module: () -> Bytes = () -> {\n  let out = bytebuf_new()\n  emit_header(out)\n  emit_type_section_multi(out, quad_int_array(1, 1, 2, 1))\n  emit_function_section(out, pair_int_array(0, 1))\n  emit_export_section_multi(out, pair_string_array(\"square\", \"sum_sq\"), pair_int_array(0, 1))\n  let sq_body = bytebuf_new()\n  emit_local_get(sq_body, 0)\n  emit_local_get(sq_body, 0)\n  emit_i64_mul(sq_body)\n  let ss_body = bytebuf_new()\n  emit_local_get(ss_body, 0)\n  emit_call(ss_body, 0)\n  emit_local_get(ss_body, 1)\n  emit_call(ss_body, 0)\n  emit_i64_add(ss_body)\n  emit_code_section(out, pair_bytes_array(sq_body, ss_body))\n  bytebuf_to_bytes(out)\n}\n\nlet triple_bytes_array: (Bytes, Bytes, Bytes) -> Array[Bytes] = (v0, v1, v2) -> {\n  let values = empty_bytes_array()\n  Array::push(values, v0)\n  Array::push(values, v1)\n  Array::push(values, v2)\n  values\n}\n\nlet singleton_int_array: (Int) -> Array[Int] = (v0) -> {\n  let values = empty_int_array()\n  Array::push(values, v0)\n  values\n}\n\nlet triple_string_array: (String, String, String) -> Array[String] = (v0, v1, v2) -> {\n  let values = builders_empty_string_array()\n  Array::push(values, v0)\n  Array::push(values, v1)\n  Array::push(values, v2)\n  values\n}\n\nlet singleton_bytes_array: (Bytes) -> Array[Bytes] = (v0) -> {\n  let values = empty_bytes_array()\n  Array::push(values, v0)\n  values\n}\n\nexport let build_add_module: () -> Bytes = () -> {\n  let out = bytebuf_new()\n  emit_header(out)\n  emit_type_section(out, 2, 1)\n  emit_function_section(out, singleton_int_array(0))\n  emit_export_section(out, \"add\", 0)\n  let body = bytebuf_new()\n  emit_local_get(body, 0)\n  emit_local_get(body, 1)\n  emit_i64_add(body)\n  emit_code_section(out, singleton_bytes_array(body))\n  bytebuf_to_bytes(out)\n}\n\nexport let build_factorial_module: () -> Bytes = () -> {\n  let out = bytebuf_new()\n  emit_header(out)\n  emit_type_section(out, 1, 1)\n  emit_function_section(out, singleton_int_array(0))\n  emit_export_section(out, \"fact\", 0)\n  let b = bytebuf_new()\n  emit_i64_const(b, 1)\n  emit_local_set(b, 1)\n  emit_block_void(b)\n  emit_loop_void(b)\n  emit_local_get(b, 0)\n  emit_i64_const(b, 1)\n  emit_i64_le_s(b)\n  emit_br_if(b, 1)\n  emit_local_get(b, 1)\n  emit_local_get(b, 0)\n  emit_i64_mul(b)\n  emit_local_set(b, 1)\n  emit_local_get(b, 0)\n  emit_i64_const(b, 1)\n  emit_i64_sub(b)\n  emit_local_set(b, 0)\n  emit_br(b, 0)\n  emit_end(b)\n  emit_end(b)\n  emit_local_get(b, 1)\n  emit_code_section_with_locals(out, singleton_bytes_array(b), singleton_int_array(1))\n  bytebuf_to_bytes(out)\n}\n\nexport let build_fibonacci_module: () -> Bytes = () -> {\n  let out = bytebuf_new()\n  emit_header(out)\n  emit_type_section(out, 1, 1)\n  emit_function_section(out, singleton_int_array(0))\n  emit_export_section(out, \"fib\", 0)\n  let b = bytebuf_new()\n  emit_i64_const(b, 0)\n  emit_local_set(b, 1)\n  emit_i64_const(b, 1)\n  emit_local_set(b, 2)\n  emit_block_void(b)\n  emit_loop_void(b)\n  emit_local_get(b, 0)\n  emit_i64_const(b, 0)\n  emit_i64_le_s(b)\n  emit_br_if(b, 1)\n  emit_local_get(b, 1)\n  emit_local_get(b, 2)\n  emit_i64_add(b)\n  emit_local_set(b, 3)\n  emit_local_get(b, 2)\n  emit_local_set(b, 1)\n  emit_local_get(b, 3)\n  emit_local_set(b, 2)\n  emit_local_get(b, 0)\n  emit_i64_const(b, 1)\n  emit_i64_sub(b)\n  emit_local_set(b, 0)\n  emit_br(b, 0)\n  emit_end(b)\n  emit_end(b)\n  emit_local_get(b, 1)\n  emit_code_section_with_locals(out, singleton_bytes_array(b), singleton_int_array(3))\n  bytebuf_to_bytes(out)\n}\n\nlet singleton_string_array: (String) -> Array[String] = (v0) -> {\n  let values = builders_empty_string_array()\n  Array::push(values, v0)\n  values\n}\n\nexport let build_hello_module: () -> Bytes = () -> {\n  let out = bytebuf_new()\n  emit_header(out)\n  let type_content = bytebuf_new()\n  bytebuf_push_vec_header(type_content, 2)\n  emit_func_type_raw(type_content, quad_int_array(builders_vt_i32, builders_vt_i32, builders_vt_i32, builders_vt_i32), singleton_int_array(builders_vt_i32))\n  emit_func_type_raw(type_content, Array::slice([\n    0\n  ], 0, 0), Array::slice([\n    0\n  ], 0, 0))\n  bytebuf_push_section(out, sec_type, type_content)\n  emit_import_section_func(out, \"wasi_snapshot_preview1\", \"fd_write\", 0)\n  emit_function_section(out, singleton_int_array(1))\n  emit_memory_section(out, 1)\n  emit_exports_with_memory(out, singleton_string_array(\"_start\"), singleton_int_array(1), \"memory\", 0)\n  let b = bytebuf_new()\n  emit_i32_const(b, 0)\n  emit_i32_const(b, 8)\n  emit_i32_store(b, 2, 0)\n  emit_i32_const(b, 4)\n  emit_i32_const(b, 12)\n  emit_i32_store(b, 2, 0)\n  emit_i32_const(b, 1)\n  emit_i32_const(b, 0)\n  emit_i32_const(b, 1)\n  emit_i32_const(b, 100)\n  emit_call(b, 0)\n  emit_drop(b)\n  emit_code_section(out, singleton_bytes_array(b))\n  let hello_data = bytebuf_new()\n  bytebuf_push(hello_data, 104)\n  bytebuf_push(hello_data, 101)\n  bytebuf_push(hello_data, 108)\n  bytebuf_push(hello_data, 108)\n  bytebuf_push(hello_data, 111)\n  bytebuf_push(hello_data, 32)\n  bytebuf_push(hello_data, 119)\n  bytebuf_push(hello_data, 111)\n  bytebuf_push(hello_data, 114)\n  bytebuf_push(hello_data, 108)\n  bytebuf_push(hello_data, 100)\n  bytebuf_push(hello_data, 10)\n  emit_data_section(out, 8, hello_data)\n  bytebuf_to_bytes(out)\n}\n\nexport let build_arithmetic_module: () -> Bytes = () -> {\n  let out = bytebuf_new()\n  emit_header(out)\n  emit_type_section(out, 2, 1)\n  emit_function_section(out, triple_int_array(0, 0, 0))\n  emit_export_section_multi(out, triple_string_array(\"add\", \"sub\", \"mul\"), triple_int_array(0, 1, 2))\n  let add_body = bytebuf_new()\n  emit_local_get(add_body, 0)\n  emit_local_get(add_body, 1)\n  emit_i64_add(add_body)\n  let sub_body = bytebuf_new()\n  emit_local_get(sub_body, 0)\n  emit_local_get(sub_body, 1)\n  emit_i64_sub(sub_body)\n  let mul_body = bytebuf_new()\n  emit_local_get(mul_body, 0)\n  emit_local_get(mul_body, 1)\n  emit_i64_mul(mul_body)\n  emit_code_section(out, triple_bytes_array(add_body, sub_body, mul_body))\n  bytebuf_to_bytes(out)\n}\n\nexport let emit_data_section_multi: (Bytes, Array[Int], Array[Bytes]) -> Unit = (out, offsets, datas) -> {\n  let count = Array::length(offsets)\n  let content = bytebuf_new()\n  bytebuf_push_vec_header(content, count)\n  let mut i = 0\n  while i < count {\n    bytebuf_push(content, 0)\n    emit_i32_const(content, Array::get(offsets, i))\n    emit_end(content)\n    let data = Array::get(datas, i)\n    leb128_encode_u32(content, Bytes::length(data))\n    bytebuf_push_buf(content, data)\n    i = i + 1\n  }\n  bytebuf_push_section(out, builders_sec_data, content)\n}\n\nexport let build_print_string_module: (String) -> Bytes = (msg) -> {\n  let out = bytebuf_new()\n  emit_header(out)\n  let type_content = bytebuf_new()\n  bytebuf_push_vec_header(type_content, 2)\n  emit_func_type_raw(type_content, quad_int_array(builders_vt_i32, builders_vt_i32, builders_vt_i32, builders_vt_i32), singleton_int_array(builders_vt_i32))\n  emit_func_type_raw(type_content, Array::slice([\n    0\n  ], 0, 0), Array::slice([\n    0\n  ], 0, 0))\n  bytebuf_push_section(out, sec_type, type_content)\n  emit_import_section_func(out, \"wasi_snapshot_preview1\", \"fd_write\", 0)\n  emit_function_section(out, singleton_int_array(1))\n  emit_memory_section(out, 1)\n  emit_exports_with_memory(out, singleton_string_array(\"_start\"), singleton_int_array(1), \"memory\", 0)\n  let str_data = string_to_data(msg)\n  let str_len = Bytes::length(str_data)\n  let b = bytebuf_new()\n  emit_i32_const(b, 0)\n  emit_i32_const(b, 16)\n  emit_i32_store(b, 2, 0)\n  emit_i32_const(b, 4)\n  emit_i32_const(b, str_len)\n  emit_i32_store(b, 2, 0)\n  emit_i32_const(b, 1)\n  emit_i32_const(b, 0)\n  emit_i32_const(b, 1)\n  emit_i32_const(b, 8)\n  emit_call(b, 0)\n  emit_drop(b)\n  emit_code_section(out, singleton_bytes_array(b))\n  emit_data_section(out, 16, str_data)\n  bytebuf_to_bytes(out)\n}\n")
