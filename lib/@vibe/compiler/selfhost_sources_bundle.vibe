ffset\n  } else {\n    -1\n  }\n  if entry_user_idx >= 0 {\n    let entry_params = Array::get(fn_param_counts, entry_user_idx)\n    if entry_params != 0 {\n      throw(\"WASI entry function must take 0 parameters\")\n    }\n    emit_i64_const(start_body, 0)\n    emit_call(start_body, entry_func_idx)\n    emit_call(start_body, print_int_idx)\n  } else {\n    let mut sti = 0\n    while sti < Array::length(test_fn_names) {\n      let stname = Array::get(test_fn_names, sti)\n      let mut __stj = 0\n      let mut __stf = -1\n      while __stj < Array::length(fn_names_list) {\n        if Array::get(fn_names_list, __stj) == stname {\n          __stf = __stj\n        }\n        __stj = __stj + 1\n      }\n      if __stf >= 0 {\n        emit_i64_const(start_body, 0)\n        emit_call(start_body, func_offset + __stf)\n        emit_drop(start_body)\n      }\n      sti = sti + 1\n    }\n  }\n  Array::push(bodies, start_body)\n  Array::push(meta_i32, 0)\n  Array::push(meta_i64, 0)\n  let run_body = bytebuf_new()\n  if entry_func_idx >= 0 {\n    emit_i64_const(run_body, 0)\n    emit_call(run_body, entry_func_idx)\n  } else {\n    let mut rti = 0\n    while rti < Array::length(test_fn_names) {\n      let tname = Array::get(test_fn_names, rti)\n      let mut __rtj = 0\n      let mut __rtf = -1\n      while __rtj < Array::length(fn_names_list) {\n        if Array::get(fn_names_list, __rtj) == tname {\n          __rtf = __rtj\n        }\n        __rtj = __rtj + 1\n      }\n      if __rtf >= 0 {\n        emit_i64_const(run_body, 0)\n        emit_call(run_body, func_offset + __rtf)\n        emit_drop(run_body)\n      }\n      rti = rti + 1\n    }\n    emit_i64_const(run_body, 0)\n  }\n  Array::push(bodies, run_body)\n  Array::push(meta_i32, 0)\n  Array::push(meta_i64, 0)\n  let mut li = 0\n  while li < num_lambdas {\n    Array::push(bodies, Array::get(lt_w.bodies, li))\n    Array::push(meta_i32, Array::get(lt_w.meta_i32, li))\n    Array::push(meta_i64, Array::get(lt_w.meta_i64, li))\