"\n\n\n\n\n\n\n\n\n\n\nexport let compile_expr_tail2: (Bytes, Expr, Array[String], Int, CompileCtx, Int, (Bytes, Expr, Array[String], Int, CompileCtx, Int) -> Int with { Error }) -> Int with { Error } = (buf, expr, local_names, next_local, ctx, ld, compile_expr) -> {\n  let __tag = expr_tag(expr)\n  if __tag == 15 {\n    let __tuple_elems = get_etuple_elems(expr)\n    let num_elems = Array::length(__tuple_elems)\n    let ptr_local = next_local\n    Array::push(local_names, \"__tuple_ptr\")\n    let mut nl = next_local + 1\n    if ctx.enable_rc {\n      let total = 16 + num_elems * 8\n      emit_i64_const(buf, total)\n      emit_call(buf, ctx.rc_alloc_func_idx)\n      emit_local_set(buf, ptr_local)\n      emit_local_get(buf, ptr_local)\n      emit_i32_wrap_i64(buf)\n      emit_i32_const(buf, total)\n      emit_i32_store(buf, 2, 0)\n      emit_local_get(buf, ptr_local)\n      emit_i32_wrap_i64(buf)\n      emit_i32_const(buf, 1)\n      emit_i32_store(buf, 2, 4)\n      emit_local_get(buf, ptr_local)\n      emit_i32_wrap_i64(buf)\n      emit_i32_const(buf, 1)\n      emit_i32_store8(buf, 0, 7)\n      emit_local_get(buf, ptr_local)\n      emit_i32_wrap_i64(buf)\n      emit_i32_const(buf, 3)\n      emit_i32_store(buf, 2, 8)\n      emit_local_get(buf, ptr_local)\n      emit_i32_wrap_i64(buf)\n      emit_i32_const(buf, num_elems)\n      emit_i32_store(buf, 2, 12)\n      let mut tri = 0\n      while tri < num_elems {\n        let __tup_elem = Array::get(__tuple_elems, tri)\n        nl = compile_expr(buf, __tup_elem, local_names, nl, ctx, ld)\n        let __tup_val_local = nl\n        Array::push(local_names, \"__tup_val\")\n        emit_local_set(buf, __tup_val_local)\n        nl = nl + 1\n        let __tup_is_proj = match __tup_elem {\n          EDot(_, _, _, _) => true,\n          _ => false\n        }\n        if ctx.enable_rc && (__tup_is_proj || cc_is_borrow_ret_call(__tup_elem, ctx) || cc_is_loop_borrowed_ident(__tup_elem, ctx)) {\n          emit_rc_dup_guarded(buf, __tu