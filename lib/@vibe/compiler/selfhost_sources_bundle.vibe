"\n\n\n\n\nexport let expand_interp_stmts: (Array[Stmt]) -> Unit with { Error } = (stmts) -> {\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SLet(exp, is_rec, name, ann, expr) => Array::set(stmts, i, SLet(exp, is_rec, name, ann, rewrite_interp(expr)))\n      ,\n      STest(name, expr) => Array::set(stmts, i, STest(name, rewrite_interp(expr)))\n      ,\n      SBench(name, expr) => Array::set(stmts, i, SBench(name, rewrite_interp(expr)))\n      ,\n      _ => ()\n    }\n    i = i + 1\n  }\n  desugar_trait_dicts(stmts)\n}\n")
}

let selfhost_source_171 = () -> (String, String) {
  ("lib/@vibe/compiler/entry/source_compile/wasi_only/preprocess_interp_parse.vibe",
"\n\n\n\n\nexport let parse_interp_expr: (Array[Token]) -> Expr with { Error } = (tokens) -> {\n  let (stmt, _) = parse_stmt(tokens, [], 0)\n  match stmt {\n    SExpr(expr) => expr,\n    _ => throw(\"expected interpolation expression\")\n  }\n}\n")
}

