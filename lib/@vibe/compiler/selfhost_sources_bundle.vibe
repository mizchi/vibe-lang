anifest_header_cache_path(version_tag, entry_path)\n}\n\nexport let cache_persistent_leaf_fingerprint_cache_path: (String, String, String) -> String = (version_tag, path, source_fingerprint) -> {\n  persistent_leaf_fingerprint_cache_path(version_tag, path, source_fingerprint)\n}\n")
}

let selfhost_source_142 = () -> (String, String) {
  ("lib/@vibe/compiler/cache/persistent_cache.vibe",
"\n\n\n\n\n\nexport {\n  compact_string_fingerprint,\n  build_source_groups_fingerprint,\n  normalize_persistent_cache_text,\n  build_source_groups_fingerprint_from_compact_fingerprints,\n  build_fs_compile_wasi_artifact_fingerprint_from_group_fingerprint,\n  build_fs_compile_wasi_artifact_fingerprint,\n  build_file_compile_wasi_artifact_fingerprint_from_group_fingerprint,\n  build_file_compile_wasi_artifact_fingerprint,\n  build_fs_compile_module_artifact_fingerprint_from_group_fingerprint,\n  build_fs_compile_module_artifact_fingerprint,\n  build_file_compile_module_artifact_fingerprint_from_group_fingerprint,\n  build_file_compile_module_artifact_fingerprint\n}\n\n\nlet persistent_cache_version_tag: () -> String = () -> {\n  String::concat(\"v12|cg-\", selfhost_codegen_fingerprint())\n}\n\nexport let persistent_artifact_cache_path: (String, String, String) -> String = (kind, entry_name, fingerprint) -> {\n  cache_persistent_artifact_cache_path(persistent_cache_version_tag(), kind, entry_name, fingerprint)\n}\n\nexport let store_persistent_artifact: (String, String, String, Bytes) -> Unit with { Error, Fs } = (kind, entry_name, fingerprint, bytes) -> {\n  cache_store_persistent_artifact(persistent_cache_version_tag(), kind, entry_name, fingerprint, bytes)\n}\n\nexport let load_persistent_artifact: (String, String, String) -> Option[Bytes] with { Error, Fs } = (kind, entry_name, fingerprint) -> {\n  cache_load_persistent_artifact(persistent_cache_version_tag(), kind, entry_name, fingerprint)\n}\n\nexport let persistent_dep_list_cache_path: (String, String) -> String = (path, source_fingerprint) -> {\n  cache_persistent_dep_list_cache_path(persistent_cache_version_tag(), path, source_fingerprint, resolution_env_seed())\n}\n\nexport let persistent_type_env_cache_path: (String) -> String = (fingerprint) -> {\n  cache_persistent_type_env_cache_path(persistent_cache_version_tag(), fingerprint)\n}\n\nexport let persistent_source_list_cache_path: (String) -> String = (entry_path) -> {\n  cache_persistent_source_list_cache_path(persistent_cache_version_tag(), entry_path, resolution_env_seed())\n}\n\nexport let persistent_source_group_cache_path: (String) -> String = (entry_path) -> {\n  cache_persistent_source_group_cache_path(persistent_cache_version_tag(), entry_path, resolution_env_seed())\n}\n\nexport let persistent_module_header_cache_path: (String, String) -> String = (path, source_fingerprint) -> {\n  cache_persistent_module_header_cache_path(persistent_cache_version_tag(), path, source_fingerprint, resolution_env_seed())\n}\n\nexport let persistent_manifest_header_cache_path: (String) -> String = (entry_path) -> {\n  cache_persistent_manifest_header_cache_path(persistent_cache_version_tag(), entry_path)\n}\n\nexport let persistent_leaf_fingerprint_cache_path: (String, String) -> String = (path, source_fingerprint) -> {\n  cache_persistent_leaf_fingerprint_cache_path(persistent_cache_version_tag(), path, source_fingerprint)\n}\n\nlet package_ref_of_index_dep: (String) -> Option[String] = (dep) -> {\n  if String::ends_with(dep, \"/index.vibei\") {\n    let parts = String::split(dep, \"/\")\n    let n = Array::length(parts)\n    if n >= 3 && String::starts_with(Array::get(parts, n - 3), \"@\") {\n      Some(String::concat(Array::get(parts, n - 3), String::concat(\"/\", Array::get(parts, n - 2))))\n    } else {\n      None\n    }\n  } else {\n    None\n  }\n}\n\nexport let package_index_dep_is_current: (String) -> Bool with { Fs } = (dep) -> {\n  match package_ref_of_index_dep(dep) {\n    None => true,\n    Some(pkg_ref) => {\n      let candidates = resolve_import_path_candidates(\"\", pkg_ref)\n      let mut i = 0\n      let mut winner = \"\"\n      while i < Array::length(candidates) {\n        if winner == \"\" {\n          let candidate = Array::get(candidates, i)\n          if Fs::exists(candidate) {\n            winner = candidate\n          } else {\n            ()\n          }\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      if winner == \"\" {\n        Array::get(candidates, 0) == dep\n      } else {\n        winner == dep\n      }\n    }\n  }\n}\n\nexport let package_index_deps_are_current: (Array[String]) -> Bool with { Fs } = (deps) -> {\n  let mut i = 0\n  let mut ok = true\n  while i < Array::length(deps) {\n    if ok && !(package_index_dep_is_current(Array::get(deps, i))) {\n      ok = false\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  ok\n}\n")
}

let selfhost_source_143 = () -> (String, String) {
  ("lib/@vibe/compiler/module_graph_path.vibe",
"\nexport let dir_of_path: (String) -> String = (file_path) -> {\n  let idx = String::last_index_of(file_path, \"/\")\n  if idx < 0 {\n    \"\"\n  } else if idx == 0 {\n    \"/\"\n  } else {\n    file_path[0: idx]\n  }\n}\n\nexport let contains_name: (Array[String], String) -> Bool = (items, name) -> {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(items) && !found {\n    if Array::get(items, i) == name {\n      found = true\n    } else {\n      i = i + 1\n    }\n  }\n  found\n}\n\nexport let contains_path: (Array[String], String) -> Bool = (visited, path) -> {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(visited) && !found {\n    if Array::get(visited, i) == path {\n      found = true\n    } else {\n      i = i + 1\n    }\n  }\n  found\n}\n\nlet path_set_bucket_count = 64\n\nlet path_set_hash: (String) -> Int = (s) -> {\n  let len = String::length(s)\n  let mut h = 5381\n  let mut i = 0\n  while i < len {\n    h = ((h * 33) ^ String::char_code_at(s, i)) & 0x3FFFFFFF\n    i = i + 1\n  }\n  h\n}\n\nexport let path_set_new: () -> Array[Array[String]] = () -> {\n  let buckets = Array::slice([\n    Array::slice([\n      \"\"\n    ], 0, 0)\n  ], 0, 0)\n  let mut i = 0\n  while i < path_set_bucket_count {\n    Array::push(buckets, Array::slice([\n      \"\"\n    ], 0, 0))\n    i = i + 1\n  }\n  buckets\n}\n\nexport let path_set_contains: (Array[Array[String]], String) -> Bool = (set, path) -> {\n  let bucket = Array::get(set, path_set_hash(path) & (path_set_bucket_count - 1))\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(bucket) && !found {\n    if Array::get(bucket, i) == path {\n      found = true\n    } else {\n      i = i + 1\n    }\n  }\n  found\n}\n\nexport let path_set_add: (Array[Array[String]], String) -> Unit = (set, path) -> {\n  Array::push(Array::get(set, path_set_hash(path) & (path_set_bucket_count - 1)), path)\n}\n\nexport let normalize_path: (String) -> String = (path) -> {\n  let is_absolute = String::length(path) > 0 && String::char_code_at(path, 0) == 47\n  let mut parts = Array::slice([\n    \"\"\n  ], 0, 0)\n  let len = String::length(path)\n  let mut start = 0\n  let mut i = 0\n  while i <= len {\n    let at_sep = if i == len {\n      true\n    } else {\n      String::char_code_at(path, i) == 47\n    }\n    if at_sep {\n      let part = path[start: i]\n      let skip_part = if String::length(part) == 0 {\n        true\n      } else {\n        part == \".\"\n      }\n      if skip_part {\n        ()\n      } else if part == \"..\" {\n        if Array::length(parts) > 0 {\n          Array::truncate(parts, Array::length(parts) - 1)\n        }\n      } else {\n        Array::push(parts, part)\n      }\n      start = i + 1\n    }\n    i = i + 1\n  }\n  let buf = StringBuilder::new()\n  if is_absolute {\n    StringBuilder::push(buf, \"/\")\n  }\n  let mut pi = 0\n  while pi < Array::length(parts) {\n    if pi > 0 {\n      StringBuilder::push(buf, \"/\")\n    }\n    StringBuilder::push(buf, Array::get(parts, pi))\n    pi = pi + 1\n  }\n  StringBuilder::freeze(buf)\n}\n\nexport let get_export_name: (Array[(String, Option[String])], String) -> String = (items, name) -> {\n  let mut result = name\n  let mut i = 0\n  while i < Array::length(items) {\n    let (iname, irename) = Array::get(items, i)\n    if iname == name {\n      match irename {\n        Some(alias) => {\n          result = alias\n        },\n        None => ()\n      }\n    }\n    i = i + 1\n  }\n  result\n}\n\nlet join_relative_path: (String, String) -> String = (base_dir, raw_path) -> {\n  if base_dir == \"\" || base_dir == \"/\" {\n    String::concat(base_dir, raw_path)\n  } else {\n    String::concat(base_dir, String::concat(\"/\", raw_path))\n  }\n}\n\nexport let path_to_module_name: (String) -> String = (path) -> {\n  let len = String::length(path)\n  let mut last_slash = -1\n  let mut i = 0\n  while i < len {\n    if String::char_code_at(path, i) == 47 {\n      last_slash = i\n    }\n    i = i + 1\n  }\n  let base = if last_slash >= 0 {\n    path[last_slash + 1: len]\n  } else {\n    path\n  }\n  let base_len = String::length(base)\n  if String::ends_with(base, \".vibe\") {\n    base[0: base_len - 5]\n  } else {\n    base\n  }\n}\n\nexport let path_has_relative_prefix: (String, Int) -> Bool = (raw_path, len) -> {\n  if raw_path == \".\" || raw_path == \"..\" {\n    true\n  } else if len >= 2 {\n    if raw_path[0: 2] == \"./\" {\n      true\n    } else if len >= 3 {\n      raw_path[0: 3] == \"../\"\n    } else {\n      false\n    }\n  } else {\n    false\n  }\n}\n\nexport let resolve_import_path: (String, String) -> String = (base_dir, raw_path) -> {\n  let len = String::length(raw_path)\n  let joined = if path_has_relative_prefix(raw_path, len) {\n    join_relative_path(base_dir, raw_path)\n  } else {\n    raw_path\n  }\n  let normalized = normalize_path(joined)\n  if String::ends_with(normalized, \".vibe\") {\n    normalized\n  } else {\n    String::concat(normalized, \".vibe\")\n  }\n}\n\neffect Env {\n  Get(String) -> String\n}\n\nlet env_get_raw: (String) -> String with { Env } = (name) -> {\n  Env::get(name)\n}\n\nlet read_env_discharged: (String) -> String = (name) -> {\n  handle {\n    env_get_raw(name)\n  } with Env {\n    Get(_n) => resume(\"\")\n  }\n}\n\nlet strip_trailing_slash: (String) -> String = (p) -> {\n  let len = String::length(p)\n  if len > 1 && String::ends_with(p, \"/\") {\n    p[0: len - 1]\n  } else {\n    p\n  }\n}\n\nexport let parse_vibe_lib_roots: (String, String, String) -> Array[String] = (vibe_lib, vibe_home, home) -> {\n  let roots = Array::slice([\n    \"\"\n  ], 0, 0)\n  if String::length(vibe_lib) > 0 {\n    let parts = String::split(vibe_lib, \":\")\n    let mut i = 0\n    while i < Array::length(parts) {\n      let part = Array::get(parts, i)\n      if String::length(part) > 0 {\n        Array::push(roots, strip_trailing_slash(part))\n      } else {\n        ()\n      }\n      i = i + 1\n    }\n  } else if String::length(vibe_home) > 0 {\n    Array::push(roots, String::concat(strip_trailing_slash(vibe_home), \"/lib\"))\n  } else if String::length(home) > 0 {\n    Array::push(roots, String::concat(strip_trailing_slash(home), \"/.vibe/lib\"))\n  } else {\n    ()\n  }\n  roots\n}\n\nexport let external_lib_roots: () -> Array[String] = () -> {\n  parse_vibe_lib_roots(read_env_discharged(\"VIBE_LIB\"), read_env_discharged(\"VIBE_HOME\"), read_env_discharged(\"HOME\"))\n}\n\nexport let vibe_env_flag: (String) -> Bool = (name) -> {\n  read_env_discharged(name) == \"1\"\n}\n\nexport let resolution_env_seed: () -> String = () -> {\n  let roots = external_lib_roots()\n  let pins = if vibe_env_flag(\"VIBE_REQUIRE_PINS\") {\n    \"1\"\n  } else {\n    \"0\"\n  }\n  String::concat(\"|roots=\", String::concat(String::join(roots, \":\"), String::concat(\"|pins=\", pins)))\n}\n\nexport let resolve_import_path_candidates: (String, String) -> Array[String] = (base_dir, raw_path) -> {\n  if String::starts_with(raw_path, \"@\") {\n    let candidates = Array::slice([\n      \"\"\n    ], 0, 0)\n    Array::push(candidates, String::concat(\".vibe/store/\", String::concat(raw_path, \"/index.vibei\")))\n    Array::push(candidates, String::concat(\"lib/\", String::concat(raw_path, \"/index.vibei\")))\n    let roots = external_lib_roots()\n    let mut ri = 0\n    while ri < Array::length(roots) {\n      Array::push(candidates, String::concat(Array::get(roots, ri), String::concat(\"/\", String::concat(raw_path, \"/index.vibei\"))))\n      ri = ri + 1\n    }\n    return candidates\n  } else ()\n  let len = String::length(raw_path)\n  let joined = if path_has_relative_prefix(raw_path, len) {\n    join_relative_path(base_dir, raw_path)\n  } else {\n    raw_path\n  }\n  let normalized = normalize_path(joined)\n  if String::ends_with(normalized, \".vibe\") {\n    [\n      normalized\n    ]\n  } else {\n    [\n      String::concat(normalized, \".vibe\"),\n      String::concat(normalized, \"/index.vibei\"),\n      String::concat(normalized, \"/index.vibe\")\n    ]\n  }\n}\n")
}

let selfhost_source_144 = () -> (String, String) {
  ("lib/@vibe/compiler/loader/header_cache.vibe",
"\n\n\n\n\n\n\n\n\n\nlet resolve_path_fs: (String, String, String) -> String with { Fs } = (base_dir, raw_path, self_path) -> {\n  let candidates = resolve_import_path_candidates(base_dir, raw_path)\n  let mut i = 0\n  let mut found = \"\"\n  let mut fallback = \"\"\n  while i < Array::length(candidates) {\n    let candidate = Array::get(candidates, i)\n    if candidate == self_path {\n      ()\n    } else {\n      if fallback == \"\" {\n        fallback = candidate\n      } else {\n        ()\n      }\n      if found == \"\" && Fs::exists(candidate) {\n        found = candidate\n      } else {\n        ()\n      }\n    }\n    i = i + 1\n  }\n  if found == \"\" {\n    if fallback == \"\" {\n      Array::get(candidates, 0)\n    } else {\n      fallback\n    }\n  } else {\n    found\n  }\n}\n\nlet is_special_bundle_path: (String) -> Bool = (path) -> {\n  String::ends_with(path, \"selfhost_sources_bundle.vibe\") || String::ends_with(path, \"selfhost_cli_adapter_bundle.vibe\") || String::ends_with(path, \"selfbuild_runtime_entry_bundle.vibe\")\n}\n\nlet special_bundle_header: (String) -> Option[(Array[String], Array[String])] = (path) -> {\n  if String::ends_with(path, \"selfhost_sources_bundle.vibe\") {\n    Some((Array::slice([\n      \"\"\n    ], 0, 0), [\n      \"selfhost_sources\",\n      \"selfhost_source_groups\"\n    ]))\n  } else if String::ends_with(path, \"selfhost_cli_adapter_bundle.vibe\") {\n    Some((Array::slice([\n      \"\"\n    ], 0, 0), [\n      \"selfhost_cli_adapter_sources\",\n      \"selfhost_cli_adapter_source_groups\",\n      \"selfhost_cli_adapter_ordered_sources\",\n      \"selfhost_cli_adapter_merged_source\",\n      \"selfhost_cli_adapter_module_source\"\n    ]))\n  } else if String::ends_with(path, \"selfbuild_runtime_entry_bundle.vibe\") {\n    Some((Array::slice([\n      \"\"\n    ], 0, 0), [\n      \"selfbuild_runtime_entry_source\"\n    ]))\n  } else {\n    None\n  }\n}\n\nlet collect_import_deps_from_stmts: (Array[Stmt], String, String) -> Array[String] with { Fs } = (stmts, base_dir, self_path) -> {\n  let deps = Array::slice([\n    \"\"\n  ], 0, 0)\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SImport(raw_path, _) => Array::push(deps, resolve_path_fs(base_dir, raw_path, self_path)),\n      SReExport(raw_path, _) => Array::push(deps, resolve_path_fs(base_dir, raw_path, self_path)),\n      _ => ()\n    }\n    i = i + 1\n  }\n  deps\n}\n\nexport let contract_sibling_impl_raws: (String) -> Array[String] with { Error, Fs } = (dir) -> {\n  let out = Array::slice([\n    \"\"\n  ], 0, 0)\n  let names = Fs::readdir(dir)\n  let mut i = 0\n  while i < Array::length(names) {\n    let name = Array::get(names, i)\n    if String::ends_with(name, \".vibe\") {\n      Array::push(out, String::concat(\"./\", name))\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  out\n}\n\nexport let load_or_parse_module_header_fs_impl: (String, String, Int) -> (Array[String], Array[String], Int) with { Error, Fs } = (path, source, parse_count) -> {\n  let cache_path = persistent_module_header_cache_path(path, compact_string_fingerprint(source))\n  let mut warm_deps = Array::slice([\n    \"\"\n  ], 0, 0)\n  let mut warm_exports = Array::slice([\n    \"\"\n  ], 0, 0)\n  let mut warm_ok = false\n  if Fs::exists(cache_path) {\n    let parsed = parse_persistent_module_header_text(normalize_persistent_cache_text(Fs::read_file(cache_path)))\n    if package_index_deps_are_current(parsed.0) {\n      warm_deps = parsed.0\n      warm_exports = parsed.1\n      warm_ok = true\n    } else {\n      ()\n    }\n  } else {\n    ()\n  }\n  if warm_ok {\n    (warm_deps, warm_exports, parse_count)\n  } else {\n    let is_contract_source = String::ends_with(path, \".vibei\") && !String::starts_with(source, contract_facade_marker)\n    let header_result = if is_contract_source {\n      let (_, pin_blanked) = extract_require_pins(source)\n      let (cdecls, copaques, cextra) = parse_contract_program(lex(pin_blanked))\n      let cexports = collect_exports(cextra)\n      let mut cdi = 0\n      while cdi < Array::length(cdecls) {\n        let (cdname, _) = Array::get(cdecls, cdi)\n        Array::push(cexports, cdname)\n        cdi = cdi + 1\n      }\n      let mut coi = 0\n      while coi < Array::length(copaques) {\n        let (coname, _) = Array::get(copaques, coi)\n        Array::push(cexports, coname)\n        coi = coi + 1\n      }\n      let cdeps = collect_import_deps_from_stmts(cextra, dir_of_path(path), path)\n      let cdeps2 = if Array::length(cdeps) == 0 {\n        let craws = contract_sibling_impl_raws(dir_of_path(path))\n        let resolved = Array::slice([\n          \"\"\n        ], 0, 0)\n        let mut cri = 0\n        while cri < Array::length(craws) {\n          Array::push(resolved, resolve_path_fs(dir_of_path(path), Array::get(craws, cri), path))\n          cri = cri + 1\n        }\n        resolved\n      } else {\n        cdeps\n      }\n      (cdeps2, cexports, parse_count + 1)\n    } else if is_special_bundle_path(path) {\n      match special_bundle_header(path) {\n        Some(pair) => {\n          let deps = pair.0\n          let exports = pair.1\n          (deps, exports, parse_count)\n        },\n        None => (Array::slice([\n          \"\"\n        ], 0, 0), Array::slice([\n          \"\"\n        ], 0, 0), parse_count)\n      }\n    } else {\n      let (tokens, starts, _ends) = lex_with_offsets(source)\n      let stmts = handle {\n        parse_program_located(tokens, starts, source)\n      } with Error {\n        Throw(msg) => throw(String::concat(path, String::concat(\": \", msg)))\n      }\n      (collect_import_deps_from_stmts(stmts, dir_of_path(path), path), collect_exports(stmts), parse_count + 1)\n    }\n    let deps = header_result.0\n    let exports = header_result.1\n    let next_parse_count = header_result.2\n    Fs::write_file(cache_path, persistent_module_header_text(deps, exports))\n    (deps, exports, next_parse_count)\n  }\n}\n")
}

let selfhost_source_145 = () -> (String, String) {
  ("lib/@vibe/compiler/loader/manifest_sources.vibe",
"\n\n\n\n\n\n\n\nexport let join_path: (String, String) -> String = (base_dir, rel_path) -> {\n  if base_dir == \"\" {\n    normalize_path(rel_path)\n  } else {\n    normalize_path(String::concat(base_dir, String::concat(\"/\", rel_path)))\n  }\n}\n\nlet resolve_manifest_dep_path: (String, String, Map[String, Bool]) -> String with { Error, Fs } = (base_dir, raw_path, manifest_path_index) -> {\n  if String::length(raw_path) > 0 && String::char_code_at(raw_path, 0) == 64 {\n    raw_path\n  } else {\n    let candidates = resolve_import_path_candidates(base_dir, raw_path)\n    let mut i = 0\n    let mut found = \"\"\n    while i < Array::length(candidates) {\n      if found == \"\" {\n        let candidate = Array::get(candidates, i)\n        if Map::has_key(manifest_path_index, candidate) || Fs::exists(candidate) {\n          found = candidate\n        }\n      }\n      i = i + 1\n    }\n    if found == \"\" {\n      Array::get(candidates, 0)\n    } else {\n      found\n    }\n  }\n}\n\nlet starts_with_reexport_path_token: (Token) -> Bool = (tok) -> {\n  match tok {\n    TDot => true,\n    _ => false\n  }\n}\n\nlet is_ident_char: (Int) -> Bool = (c) -> {\n  (c >= 'a' && c <= 'z') ||\n    (c >= 'A' && c <= 'Z') ||\n    (c >= '0' && c <= '9') ||\n    c == '_'\n}\n\nlet slice_eq_text: (String, Int, String) -> Bool = (s, start, text) -> {\n  let text_len = String::length(text)\n  if start + text_len > String::length(s) {\n    false\n  } else {\n    let mut i = 0\n    let mut ok = true\n    while ok && i < text_len {\n      ok = String::char_code_at(s, start + i) == String::char_code_at(text, i)\n      i = i + 1\n    }\n    ok\n  }\n}\n\nlet starts_with_keyword_at: (String, Int, String) -> Bool = (s, pos, keyword) -> {\n  let keyword_len = String::length(keyword)\n  if !(slice_eq_text(s, pos, keyword)) {\n    false\n  } else {\n    let before_ok = if pos == 0 {\n      true\n    } else {\n      !(is_ident_char(String::char_code_at(s, pos - 1)))\n    }\n    let after_pos = pos + keyword_len\n    let after_ok = if after_pos >= String::length(s) {\n      true\n    } else {\n      !(is_ident_char(String::char_code_at(s, after_pos)))\n    }\n    before_ok && after_ok\n  }\n}\n\nlet skip_header_ws_and_comments: (String, Int, Int) -> Int = (s, len, start) -> {\n  let mut pos = start\n  let mut done = false\n  while !done && pos < len {\n    let c = String::char_code_at(s, pos)\n    if c == ' ' || c == '\\n' || c == '\\t' || c == '\\r' || c == ';' {\n      pos = pos + 1\n    } else if c == '/' && pos + 1 < len && String::char_code_at(s, pos + 1) == '/' {\n      pos = pos + 2\n      while pos < len && String::char_code_at(s, pos) != '\\n' {\n        pos = pos + 1\n      }\n    } else {\n      done = true\n    }\n  }\n  pos\n}\n\nlet scan_header_stmt_end: (String, Int, Int) -> Int with { Error } = (s, len, start) -> {\n  let mut pos = start\n  let mut brace_depth = 0\n  let mut in_string = false\n  let mut string_quote = 0\n  let mut escape = false\n  let mut done = false\n  while pos < len && !done {\n    let c = String::char_code_at(s, pos)\n    if in_string {\n      if escape {\n        escape = false\n      } else if c == '\\\\' {\n        escape = true\n      } else if c == string_quote {\n        in_string = false\n      }\n      pos = pos + 1\n    } else if c == '\"' || c == '\\'' {\n      in_string = true\n      string_quote = c\n      pos = pos + 1\n    } else if c == '/' && pos + 1 < len && String::char_code_at(s, pos + 1) == '/' {\n      while pos < len && String::char_code_at(s, pos) != '\\n' {\n        pos = pos + 1\n      }\n    } else if c == '{' {\n      brace_depth = brace_depth + 1\n      pos = pos + 1\n    } else if c == '}' {\n      if brace_depth > 0 {\n        brace_depth = brace_depth - 1\n      }\n      pos = pos + 1\n    } else if brace_depth == 0 && (c == '\\n' || c == ';') {\n      done = true\n    } else {\n      pos = pos + 1\n    }\n  }\n  pos\n}\n\nlet skip_brace_list: (Array[Token], Int) -> Int with { Error } = (tokens, pos) -> {\n  match peek(tokens, pos) {\n    TLBrace => {\n      let mut depth = 1\n      let mut i = pos + 1\n      while depth > 0 {\n        match peek(tokens, i) {\n          TLBrace => {\n            depth = depth + 1\n          },\n          TRBrace => {\n            depth = depth - 1\n          },\n          TEof => throw(\"unterminated brace list in manifest import scanner\"),\n          _ => ()\n        }\n        i = i + 1\n      }\n      i\n    }\n    _ => throw(\"expected '{' in manifest import scanner\")\n  }\n}\n\nlet scan_header_import_dep: (Array[Token], Int, String, Map[String, Bool]) -> (String, Int) with { Error, Fs } = (tokens, pos, base_dir, manifest_path_index) -> {\n  let (raw_path, next_pos) = match peek(tokens, pos) {\n    TIdent(name) =>\n      if String::length(name) > 1 && String::char_code_at(name, 0) == 64 {\n        (name, pos + 1)\n      } else {\n        collect_import_path(tokens, pos, \"\")\n      },\n    _ => collect_import_path(tokens, pos, \"\")\n  }\n  let after_path = match peek(tokens, next_pos) {\n    TIdent(alias_name) =>\n      if String::length(alias_name) > 1 && String::char_code_at(alias_name, 0) == 64 {\n        next_pos + 1\n      } else {\n        next_pos\n      },\n    _ => next_pos\n  }\n  let end_pos = match peek(tokens, after_path) {\n    TLBrace => skip_brace_list(tokens, after_path),\n    _ => after_path\n  }\n  (resolve_manifest_dep_path(base_dir, raw_path, manifest_path_index), end_pos)\n}\n\nlet collect_manifest_header_deps_from_source: (String, String, Map[String, Bool]) -> Array[String] with { Error, Fs } = (path, source, manifest_path_index) -> {\n  let deps = Array::slice([\"\"], 0, 0)\n  let base_dir = dir_of_path(path)\n  let len = String::length(source)\n  let mut pos = 0\n  let mut done = false\n  while !done {\n    pos = skip_header_ws_and_comments(source, len, pos)\n    if pos >= len {\n      done = true\n    } else {\n      let is_import = starts_with_keyword_at(source, pos, \"import\")\n      let is_export = starts_with_keyword_at(source, pos, \"export\")\n      if !(is_import || is_export) {\n        done = true\n      } else {\n        let stmt_end = scan_header_stmt_end(source, len, pos)\n        let stmt_source = source[pos:stmt_end]\n        let tokens = lex(stmt_source)\n        let stmt_pos = skip_semi(tokens, 0)\n        match peek(tokens, stmt_pos) {\n          TImport => {\n            let (dep_path, _) = scan_header_import_dep(\n              tokens,\n              stmt_pos + 1,\n              base_dir,\n              manifest_path_index\n            )\n            Array::push(deps, dep_path)\n          },\n          TExport => {\n            if starts_with_reexport_path_token(peek(tokens, stmt_pos + 1)) {\n              let (dep_path, _) = scan_header_import_dep(\n                tokens,\n                stmt_pos + 1,\n                base_dir,\n                manifest_path_index\n              )\n              Array::push(deps, dep_path)\n            }\n          },\n          _ => {\n            done = true\n          }\n        }\n        pos = stmt_end\n      }\n    }\n  }\n  deps\n}\n\nlet collect_manifest_header_deps_from_source_with_context: (String, String, Map[String, Bool]) -> Array[String] with { Error, Fs } = (path, source, manifest_path_index) -> {\n  handle {\n    collect_manifest_header_deps_from_source(path, source, manifest_path_index)\n  } with Error {\n    Throw(err) => throw(\"manifest header scan failed for \" + path + \": \" + err)\n  }\n}\n\nlet is_manifest_external_terminal_dep: (String) -> Bool = (path) -> {\n  String::ends_with(path, \"selfhost_sources_bundle.vibe\")\n}\n\nlet should_schedule_manifest_dep: (String, Map[String, Bool]) -> Bool = (dep_path, manifest_path_index) -> {\n  if Map::has_key(manifest_path_index, dep_path) {\n    true\n  } else {\n    !(is_manifest_external_terminal_dep(dep_path))\n  }\n}\n\nlet load_or_parse_module_header_deps_with_context: (String, String) -> Array[String] with { Error, Fs } = (path, source) -> {\n  handle {\n    let (deps, _, _) = load_or_parse_module_header_fs_impl(path, source, 0)\n    deps\n  } with Error {\n    Throw(err) => throw(\"module header parse failed for \" + path + \": \" + err)\n  }\n}\n\nexport let build_manifest_source_index: (Array[(String, String)]) -> Map[String, String] = (sources) -> {\n  let builder = MapBuilder::new()\n  let mut i = 0\n  while i < Array::length(sources) {\n    let (path, source) = Array::get(sources, i)\n    MapBuilder::set(builder, path, source)\n    i = i + 1\n  }\n  MapBuilder::freeze(builder)\n}\n\nlet source_lookup_in_index: (Map[String, String], String) -> Option[String] = (source_index, path_key) -> {\n  if Map::has_key(source_index, path_key) {\n    Some(Map::get(source_index, path_key))\n  } else {\n    None\n  }\n}\n\nexport let build_manifest_path_index: (Array[String]) -> Map[String, Bool] = (paths) -> {\n  let builder = MapBuilder::new()\n  let mut i = 0\n  while i < Array::length(paths) {\n    MapBuilder::set(builder, Array::get(paths, i), true)\n    i = i + 1\n  }\n  MapBuilder::freeze(builder)\n}\n\nlet empty_path_index: () -> Map[String, Bool] = () -> {\n  let builder = MapBuilder::new()\n  MapBuilder::freeze(builder)\n}\n\nlet build_manifest_path_index_from_rows: (String, Array[(String, String)]) -> Map[String, Bool] = (base_dir, rows) -> {\n  let builder = MapBuilder::new()\n  let mut i = 0\n  while i < Array::length(rows) {\n    let (_, rel_path) = Array::get(rows, i)\n    MapBuilder::set(builder, join_path(base_dir, rel_path), true)\n    i = i + 1\n  }\n  MapBuilder::freeze(builder)\n}\n\nlet find_manifest_base_dir: (String) -> Option[String] with { Fs } = (entry_path) -> {\n  let mut base_dir = dir_of_path(entry_path)\n  let mut found = None\n  let mut done = false\n  loop {\n    if done {\n      break\n    }\n    let manifest_path = join_path(base_dir, \"selfhost_sources_manifest.tsv\")\n    if Fs::exists(manifest_path) {\n      found = Some(base_dir)\n      done = true\n    } else if base_dir == \"\" {\n      done = true\n    } else {\n      let parent = dir_of_path(base_dir)\n      if parent == base_dir {\n        done = true\n      } else {\n        base_dir = parent\n      }\n    }\n  }\n  found\n}\n\nlet strip_trailing_cr: (String) -> String = (line) -> {\n  let len = String::length(line)\n  if len > 0 {\n    if String::char_code_at(line, len - 1) == 13 {\n      line[0:len - 1]\n    } else {\n      line\n    }\n  } else {\n    line\n  }\n}\n\nlet find_char: (String, Int) -> Int = (s, target) -> {\n  let len = String::length(s)\n  let mut i = 0\n  let mut result = -1\n  while i < len {\n    if String::char_code_at(s, i) == target {\n      result = i\n      i = len\n    } else {\n      i = i + 1\n    }\n  }\n  result\n}\n\nlet split_tsv_fields: (String) -> Array[String] = (line) -> {\n  let fields = Array::slice([\"\"], 0, 0)\n  let len = String::length(line)\n  let mut start = 0\n  let mut i = 0\n  while i <= len {\n    let at_field_end = if i == len {\n      true\n    } else {\n      String::char_code_at(line, i) == 9\n    }\n    if at_field_end {\n      Array::push(fields, line[start:i])\n      start = i + 1\n    }\n    i = i + 1\n  }\n  fields\n}\n\nlet header_value_separator = String::from_char_code(31)\n\nlet join_header_values: (Array[String]) -> String = (values) -> {\n  let out = StringBuilder::new()\n  let mut i = 0\n  while i < Array::length(values) {\n    if i > 0 {\n      StringBuilder::push(out, header_value_separator)\n    }\n    StringBuilder::push(out, Array::get(values, i))\n    i = i + 1\n  }\n  StringBuilder::freeze(out)\n}\n\nlet split_header_values: (String) -> Array[String] = (text) -> {\n  let values = Array::slice([\"\"], 0, 0)\n  if String::length(text) == 0 {\n    values\n  } else {\n    let sep = String::char_code_at(header_value_separator, 0)\n    let len = String::length(text)\n    let mut start = 0\n    let mut i = 0\n    while i <= len {\n      let at_value_end = if i == len {\n        true\n      } else {\n        String::char_code_at(text, i) == sep\n      }\n      if at_value_end {\n        Array::push(values, text[start:i])\n        start = i + 1\n      }\n      i = i + 1\n    }\n    values\n  }\n}\n\nlet empty_manifest_header_cache_rows: () -> Array[(String, String, String, String)] = () -> {\n  Array::slice([(\"\", \"\", \"\", \"\")], 0, 0)\n}\n\nlet empty_grouped_sources: () -> Array[(String, Array[(String, String)])] = () -> {\n  Array::slice([(\"\", Array::slice([(\"\", \"\")], 0, 0))], 0, 0)\n}\n\nlet ensure_grouped_source_bucket: (Array[(String, Array[(String, String)])], String) -> Array[(String, String)] = (groups, group_name) -> {\n  let mut i = 0\n  let mut found = None\n  while i < Array::length(groups) {\n    let (name, sources) = Array::get(groups, i)\n    if name == group_name {\n      found = Some(sources)\n      i = Array::length(groups)\n    } else {\n      i = i + 1\n    }\n  }\n  match found {\n    Some(sources) => sources,\n    None => {\n      let sources = Array::slice([(\"\", \"\")], 0, 0)\n      Array::push(groups, (group_name, sources))\n      sources\n    }\n  }\n}\n\nlet build_grouped_sources_from_manifest_rows_with_lookup: (String, Array[(String, String)], (String) -> Option[String]) -> Array[(String, Array[(String, String)])] = (base_dir, rows, on_path) -> {\n  let groups = empty_grouped_sources()\n  let mut last_group_name = \"\"\n  let mut last_group_sources = Array::slice([(\"\", \"\")], 0, 0)\n  let mut has_last_group = false\n  let mut i = 0\n  while i < Array::length(rows) {\n    let (group_name, rel_path) = Array::get(rows, i)\n    let path = join_path(base_dir, rel_path)\n    match on_path(path) {\n      Some(source) => {\n        let bucket = if has_last_group && last_group_name == group_name {\n          last_group_sources\n        } else {\n          let ensured = ensure_grouped_source_bucket(groups, group_name)\n          last_group_name = group_name\n          last_group_sources = ensured\n          has_last_group = true\n          ensured\n        }\n        Array::push(bucket, (path, source))\n      },\n      None => ()\n    }\n    i = i + 1\n  }\n  groups\n}\n\n\nlet parse_source_manifest_rows: (String) -> Array[(String, String)] with { Error } = (manifest_source) -> {\n  let rows = Array::slice([(\"\", \"\")], 0, 0)\n  let len = String::length(manifest_source)\n  let mut line_start = 0\n  let mut i = 0\n  while i <= len {\n    let at_line_end = if i == len {\n      true\n    } else {\n      String::char_code_at(manifest_source, i) == 10\n    }\n    if at_line_end {\n      let raw_line = strip_trailing_cr(manifest_source[line_start:i])\n      let line_len = String::length(raw_line)\n      let has_content = line_len > 0\n      let is_comment = if has_content {\n        String::char_code_at(raw_line, 0) == 35\n      } else {\n        false\n      }\n      if has_content {\n        if is_comment {\n          ()\n        } else {\n          let tab_idx = find_char(raw_line, 9)\n          let invalid_row = if tab_idx < 0 {\n            true\n          } else {\n            tab_idx + 1 >= line_len\n          }\n          if invalid_row {\n            throw(String::concat(\"invalid source manifest row: \", raw_line))\n          }\n          let group = raw_line[0:tab_idx]\n          let path = raw_line[tab_idx + 1:line_len]\n          Array::push(rows, (group, path))\n        }\n      }\n      line_start = i + 1\n    }\n    i = i + 1\n  }\n  rows\n}\n\nexport let try_load_manifest_rows: (String) -> Option[(String, Array[(String, String)])] with { Error, Fs } = (entry_path) -> {\n  match find_manifest_base_dir(entry_path) {\n    Some(base_dir) => {\n      let manifest_path = join_path(base_dir, \"selfhost_sources_manifest.tsv\")\n      let rows = parse_source_manifest_rows(Fs::read_file(manifest_path))\n      let mut has_entry = false\n      let mut i = 0\n      while i < Array::length(rows) {\n        let (_, rel_path) = Array::get(rows, i)\n        let path = join_path(base_dir, rel_path)\n        if path == entry_path {\n          has_entry = true\n        }\n        i = i + 1\n      }\n      if has_entry {\n        Some((base_dir, rows))\n      } else {\n        None\n      }\n    },\n    None => None\n  }\n}\n\nexport let load_manifest_full_sources: (String, Array[(String, String)]) -> Array[(String, String)] with { Error, Fs } = (base_dir, rows) -> {\n  let full_sources = Array::slice([(\"\", \"\")], 0, 0)\n  let mut i = 0\n  while i < Array::length(rows) {\n    let (_, rel_path) = Array::get(rows, i)\n    let path = join_path(base_dir, rel_path)\n    Array::push(full_sources, (path, Fs::read_file(path)))\n    i = i + 1\n  }\n  full_sources\n}\n\nlet load_manifest_sources_by_path_index: (String, Array[(String, String)], Map[String, Bool]) -> Array[(String, String)] with { Error, Fs } = (base_dir, rows, needed_path_index) -> {\n  let sources = Array::slice([(\"\", \"\")], 0, 0)\n  let mut i = 0\n  while i < Array::length(rows) {\n    let (_, rel_path) = Array::get(rows, i)\n    let path = join_path(base_dir, rel_path)\n    if Map::has_key(needed_path_index, path) {\n      Array::push(sources, (path, Fs::read_file(path)))\n    }\n    i = i + 1\n  }\n  sources\n}\n\nlet load_manifest_source_groups_by_path_index: (String, Array[(String, String)], Map[String, Bool]) -> Array[(String, Array[(String, String)])] with { Error, Fs } = (base_dir, rows, needed_path_index) -> {\n  let groups = empty_grouped_sources()\n  let mut last_group_name = \"\"\n  let mut last_group_sources = Array::slice([(\"\", \"\")], 0, 0)\n  let mut has_last_group = false\n  let mut i = 0\n  while i < Array::length(rows) {\n    let (group_name, rel_path) = Array::get(rows, i)\n    let path = join_path(base_dir, rel_path)\n    if Map::has_key(needed_path_index, path) {\n      let bucket = if has_last_group && last_group_name == group_name {\n        last_group_sources\n      } else {\n        let ensured = ensure_grouped_source_bucket(groups, group_name)\n        last_group_name = group_name\n        last_group_sources = ensured\n        has_last_group = true\n        ensured\n      }\n      Array::push(bucket, (path, Fs::read_file(path)))\n    }\n    i = i + 1\n  }\n  groups\n}\n\nexport let build_grouped_sources_from_manifest_row_source_index: (String, Array[(String, String)], Map[String, String]) -> Array[(String, Array[(String, String)])] = (base_dir, rows, source_index) -> {\n  build_grouped_sources_from_manifest_rows_with_lookup(\n    base_dir,\n    rows,\n    (path: String) -> Option[String] {\n      source_lookup_in_index(source_index, path)\n    }\n  )\n}\n\nexport let build_grouped_sources_from_manifest_rows: (String, Array[(String, String)], Array[(String, String)]) -> Array[(String, Array[(String, String)])] = (base_dir, rows, sources) -> {\n  let source_index = build_manifest_source_index(sources)\n  build_grouped_sources_from_manifest_row_source_index(base_dir, rows, source_index)\n}\n\nexport let filter_manifest_sources_by_path_index: (Array[(String, String)], Map[String, Bool]) -> Array[(String, String)] = (preloaded_sources, needed_path_index) -> {\n  let filtered_sources = Array::slice([(\"\", \"\")], 0, 0)\n  let mut i = 0\n  while i < Array::length(preloaded_sources) {\n    let (path, source) = Array::get(preloaded_sources, i)\n    if Map::has_key(needed_path_index, path) {\n      Array::push(filtered_sources, (path, source))\n    }\n    i = i + 1\n  }\n  filtered_sources\n}\n\nexport let filter_manifest_sources_by_paths: (Array[(String, String)], Array[String]) -> Array[(String, String)] = (preloaded_sources, needed_paths) -> {\n  let needed_path_index = build_manifest_path_index(needed_paths)\n  filter_manifest_sources_by_path_index(preloaded_sources, needed_path_index)\n}\n\nexport let filter_manifest_sources_by_paths_linear: (Array[(String, String)], Array[String]) -> Array[(String, String)] = (preloaded_sources, needed_paths) -> {\n  let filtered_sources = Array::slice([(\"\", \"\")], 0, 0)\n  let mut i = 0\n  while i < Array::length(preloaded_sources) {\n    let (path, source) = Array::get(preloaded_sources, i)\n    if contains_path(needed_paths, path) {\n      Array::push(filtered_sources, (path, source))\n    }\n    i = i + 1\n  }\n  filtered_sources\n}\n\nexport let filter_manifest_sources_by_source_index: (Array[String], Map[String, String]) -> Array[(String, String)] = (needed_paths, preloaded_source_index) -> {\n  let filtered_sources = Array::slice([(\"\", \"\")], 0, 0)\n  let mut i = 0\n  while i < Array::length(needed_paths) {\n    let path = Array::get(needed_paths, i)\n    match source_lookup_in_index(preloaded_source_index, path) {\n      Some(source) => Array::push(filtered_sources, (path, source)),\n      None => ()\n    }\n    i = i + 1\n  }\n  filtered_sources\n}\n\n\nlet parse_persistent_manifest_header_cache: (String) -> (Int, Option[(String, String, String)], Array[(String, String, String, String)]) with { Error } = (raw) -> {\n  let len = String::length(raw)\n  let mut line_start = 0\n  let mut i = 0\n  let mut version = 0\n  let mut manifest = None\n  let rows = empty_manifest_header_cache_rows()\n  while i <= len {\n    let at_line_end = if i == len {\n      true\n    } else {\n      String::char_code_at(raw, i) == 10\n    }\n    if at_line_end {\n      let line = strip_trailing_cr(raw[line_start:i])\n      if String::length(line) > 0 {\n        let fields = split_tsv_fields(line)\n        let tag = Array::get(fields, 0)\n        if tag == \"version\" {\n          if Array::length(fields) != 2 {\n            throw(\"invalid persistent manifest header cache version\")\n          }\n          let version_text = Array::get(fields, 1)\n          if version_text == \"1\" {\n            version = 1\n          } else if version_text == \"2\" {\n            version = 2\n          } else {\n            throw(\"invalid persistent manifest header cache version\")\n          }\n        } else if tag == \"manifest\" {\n          if Array::length(fields) != 4 {\n            throw(\"invalid persistent manifest header cache manifest row\")\n          }\n          manifest = Some((Array::get(fields, 1), Array::get(fields, 2), Array::get(fields, 3)))\n        } else if tag == \"header\" {\n          if version == 1 {\n            if Array::length(fields) != 6 {\n              throw(\"invalid persistent manifest header cache header row\")\n            }\n            Array::push(\n              rows,\n              (\n                Array::get(fields, 1),\n                Array::get(fields, 2),\n                Array::get(fields, 3),\n                Array::get(fields, 4)\n              )\n            )\n          } else {\n            if Array::length(fields) != 5 {\n              throw(\"invalid persistent manifest header cache header row\")\n            }\n            Array::push(\n              rows,\n              (\n                Array::get(fields, 1),\n                Array::get(fields, 2),\n                Array::get(fields, 3),\n                Array::get(fields, 4)\n              )\n            )\n          }\n        } else {\n          throw(String::concat(\"invalid persistent manifest header cache row: \", line))\n        }\n      }\n      line_start = i + 1\n    }\n    i = i + 1\n  }\n  (version, manifest, rows)\n}\n\nlet matches_cached_file_spec: (String, String, String) -> Bool with { Error, Fs } = (path, stat_token_text, source_fingerprint) -> {\n  if !(Fs::exists(path)) {\n    false\n  } else {\n    let has_stat_token = String::length(stat_token_text) > 0\n    if has_stat_token {\n      if __to_string(Fs::stat_token(path)) == stat_token_text {\n        true\n      } else if String::length(source_fingerprint) > 0 {\n        compact_string_fingerprint(Fs::read_file(path)) == source_fingerprint\n      } else {\n        false\n      }\n    } else if String::length(source_fingerprint) > 0 {\n      compact_string_fingerprint(Fs::read_file(path)) == source_fingerprint\n    } else {\n      false\n    }\n  }\n}\n\nlet load_persistent_manifest_header_cache_if_valid: (String, String, Map[String, Bool]) -> Option[Array[(String, String, String, String)]] with { Error, Fs } = (entry_path, manifest_path, manifest_path_index) -> {\n  let cache_path = persistent_manifest_header_cache_path(entry_path)\n  if !(Fs::exists(cache_path)) {\n    None\n  } else {\n    let (_, manifest, rows) = parse_persistent_manifest_header_cache(\n      normalize_persistent_cache_text(Fs::read_file(cache_path))\n    )\n    let manifest_ok = match manifest {\n      Some((cached_path, stat_token_text, source_fingerprint)) =>\n        cached_path == manifest_path &&\n          matches_cached_file_spec(manifest_path, stat_token_text, source_fingerprint),\n      None => false\n    }\n    if !manifest_ok {\n      None\n    } else {\n      let mut valid = true\n      let mut i = 0\n      while i < Array::length(rows) {\n        if valid {\n          let (path, stat_token_text, source_fingerprint, _) = Array::get(rows, i)\n          if !(Map::has_key(manifest_path_index, path)) {\n            valid = false\n          } else if !(matches_cached_file_spec(path, stat_token_text, source_fingerprint)) {\n            valid = false\n          }\n        }\n        i = i + 1\n      }\n      if valid {\n        Some(rows)\n      } else {\n        None\n      }\n    }\n  }\n}\n\nlet build_persistent_manifest_header_cache_text: (String, Array[(String, String, String, String)]) -> String with { Error, Fs } = (manifest_path, rows) -> {\n  let mut out = \"version\\t2\\n\"\n  out = String::concat(\n    out,\n    String::concat(\n      \"manifest\\t\",\n      String::concat(\n        manifest_path,\n        String::concat(\n          \"\\t\",\n          String::concat(\n            __to_string(Fs::stat_token(manifest_path)),\n            String::concat(\"\\t\", String::concat(compact_string_fingerprint(Fs::read_file(manifest_path)), \"\\n\"))\n          )\n        )\n      )\n    )\n  )\n  let mut i = 0\n  while i < Array::length(rows) {\n    let (path, stat_token_text, source_fingerprint, deps_text) = Array::get(rows, i)\n    out = String::concat(\n      out,\n      String::concat(\n        \"header\\t\",\n        String::concat(\n          path,\n          String::concat(\n            \"\\t\",\n            String::concat(\n              stat_token_text,\n              String::concat(\n                \"\\t\",\n                String::concat(\n                  source_fingerprint,\n                  String::concat(\"\\t\", String::concat(deps_text, \"\\n\"))\n                )\n              )\n            )\n          )\n        )\n      )\n    )\n    i = i + 1\n  }\n  out\n}\n\nlet store_persistent_manifest_header_cache: (String, String, Array[(String, String, String, String)]) -> Unit with { Error, Fs } = (entry_path, manifest_path, rows) -> {\n  Fs::write_file(\n    persistent_manifest_header_cache_path(entry_path),\n    build_persistent_manifest_header_cache_text(manifest_path, rows)\n  )\n}\n\nlet manifest_header_deps_lookup: (Array[(String, String, String, String)], String) -> Option[Array[String]] = (rows, path) -> {\n  let mut i = 0\n  let mut found = None\n  while i < Array::length(rows) {\n    let (row_path, _, _, deps_text) = Array::get(rows, i)\n    if row_path == path {\n      found = Some(split_header_values(deps_text))\n      i = Array::length(rows)\n    } else {\n      i = i + 1\n    }\n  }\n  found\n}\n\nlet collect_needed_paths_from_manifest_headers: (String, Map[String, Bool], Array[(String, String, String, String)]) -> Array[String] with { Error, Fs } = (path, manifest_path_index, rows) -> {\n  let visited = Array::slice([\"\"], 0, 0)\n  let worklist = Array::slice([\"\"], 0, 0)\n  let scheduled = path_set_new()\n  Array::push(worklist, path)\n  path_set_add(scheduled, path)\n  let mut work_len = 1\n  let mut work_i = 0\n  loop {\n    if work_i >= work_len {\n      break\n    }\n    let current = Array::get(worklist, work_i)\n    Array::push(visited, current)\n    let deps = match manifest_header_deps_lookup(rows, current) {\n      Some(found) => found,\n      None => {\n        let source = Fs::read_file(current)\n        if Map::has_key(manifest_path_index, current) {\n          collect_manifest_header_deps_from_source_with_context(\n            current,\n            source,\n            manifest_path_index\n          )\n        } else {\n          load_or_parse_module_header_deps_with_context(current, source)\n        }\n      }\n    }\n    let mut dep_i = 0\n    while dep_i < Array::length(deps) {\n      let dep_path = Array::get(deps, dep_i)\n      if should_schedule_manifest_dep(dep_path, manifest_path_index) &&\n        !(path_set_contains(scheduled, dep_path)) {\n        Array::push(worklist, dep_path)\n        path_set_add(scheduled, dep_path)\n        work_len = work_len + 1\n      }\n      dep_i = dep_i + 1\n    }\n    work_i = work_i + 1\n  }\n  visited\n}\n\nlet collect_needed_paths_and_manifest_headers: (String, Map[String, Bool]) -> (Array[(String, String, String, String)], Array[String]) with { Error, Fs } = (path, manifest_path_index) -> {\n  let rows = empty_manifest_header_cache_rows()\n  let visited = Array::slice([\"\"], 0, 0)\n  let worklist = Array::slice([\"\"], 0, 0)\n  let scheduled = path_set_new()\n  Array::push(worklist, path)\n  path_set_add(scheduled, path)\n  let mut work_len = 1\n  let mut work_i = 0\n  loop {\n    if work_i >= work_len {\n      break\n    }\n    let current = Array::get(worklist, work_i)\n    Array::push(visited, current)\n    let source = Fs::read_file(current)\n    let deps = match manifest_header_deps_lookup(rows, current) {\n      Some(found) => found,\n      None => {\n        let parsed_deps = if Map::has_key(manifest_path_index, current) {\n          collect_manifest_header_deps_from_source_with_context(\n            current,\n            source,\n            manifest_path_index\n          )\n        } else {\n          load_or_parse_module_header_deps_with_context(current, source)\n        }\n        Array::push(\n          rows,\n          (\n            current,\n            __to_string(Fs::stat_token(current)),\n            compact_string_fingerprint(source),\n            join_header_values(parsed_deps)\n          )\n        )\n        parsed_deps\n      }\n    }\n    let mut dep_i = 0\n    while dep_i < Array::length(deps) {\n      let dep_path = Array::get(deps, dep_i)\n      if should_schedule_manifest_dep(dep_path, manifest_path_index) &&\n        !(path_set_contains(scheduled, dep_path)) {\n        Array::push(worklist, dep_path)\n        path_set_add(scheduled, dep_path)\n        work_len = work_len + 1\n      }\n      dep_i = dep_i + 1\n    }\n    work_i = work_i + 1\n  }\n  (rows, visited)\n}\n\nlet collect_needed_paths_from_manifest_scan: (String, Map[String, Bool]) -> Array[String] with { Error, Fs } = (path, manifest_path_index) -> {\n  let visited = Array::slice([\"\"], 0, 0)\n  let worklist = Array::slice([\"\"], 0, 0)\n  let scheduled = path_set_new()\n  Array::push(worklist, path)\n  path_set_add(scheduled, path)\n  let mut work_len = 1\n  let mut work_i = 0\n  loop {\n    if work_i >= work_len {\n      break\n    }\n    let current = Array::get(worklist, work_i)\n    Array::push(visited, current)\n    let source = Fs::read_file(current)\n    let deps = if Map::has_key(manifest_path_index, current) {\n      collect_manifest_header_deps_from_source_with_context(\n        current,\n        source,\n        manifest_path_index\n      )\n    } else {\n      load_or_parse_module_header_deps_with_context(current, source)\n    }\n    let mut dep_i = 0\n    while dep_i < Array::length(deps) {\n      let dep_path = Array::get(deps, dep_i)\n      if should_schedule_manifest_dep(dep_path, manifest_path_index) &&\n        !(path_set_contains(scheduled, dep_path)) {\n        Array::push(worklist, dep_path)\n        path_set_add(scheduled, dep_path)\n        work_len = work_len + 1\n      }\n      dep_i = dep_i + 1\n    }\n    work_i = work_i + 1\n  }\n  visited\n}\n\nlet load_or_collect_manifest_header_rows: (String, String, Map[String, Bool]) -> Array[(String, String, String, String)] with { Error, Fs } = (entry_path, manifest_path, manifest_path_index) -> {\n  match load_persistent_manifest_header_cache_if_valid(\n    entry_path,\n    manifest_path,\n    manifest_path_index\n  ) {\n    Some(cached_rows) => cached_rows,\n    None => {\n      let (built_rows, _) = collect_needed_paths_and_manifest_headers(\n        entry_path,\n        manifest_path_index\n      )\n      store_persistent_manifest_header_cache(entry_path, manifest_path, built_rows)\n      built_rows\n    }\n  }\n}\n\nexport let probe_manifest_header_rows_count: (String) -> Int with { Error, Fs } = (entry_path) -> {\n  match try_load_manifest_rows(entry_path) {\n    Some((base_dir, rows)) => {\n      let manifest_path = join_path(base_dir, \"selfhost_sources_manifest.tsv\")\n      let manifest_path_index = build_manifest_path_index_from_rows(base_dir, rows)\n      let header_rows = load_or_collect_manifest_header_rows(\n        entry_path,\n        manifest_path,\n        manifest_path_index\n      )\n      Array::length(header_rows)\n    },\n    None => throw(\"manifest rows unavailable\")\n  }\n}\n\nexport let probe_manifest_header_rows_uncached_count: (String) -> Int with { Error, Fs } = (entry_path) -> {\n  match try_load_manifest_rows(entry_path) {\n    Some((base_dir, rows)) => {\n      let manifest_path_index = build_manifest_path_index_from_rows(base_dir, rows)\n      let (header_rows, _) = collect_needed_paths_and_manifest_headers(\n        entry_path,\n        manifest_path_index\n      )\n      Array::length(header_rows)\n    },\n    None => throw(\"manifest rows unavailable\")\n  }\n}\n\nexport let probe_manifest_needed_paths_count: (String) -> Int with { Error, Fs } = (entry_path) -> {\n  match try_load_manifest_rows(entry_path) {\n    Some((base_dir, rows)) => {\n      let manifest_path = join_path(base_dir, \"selfhost_sources_manifest.tsv\")\n      let manifest_path_index = build_manifest_path_index_from_rows(base_dir, rows)\n      let header_rows = load_or_collect_manifest_header_rows(\n        entry_path,\n        manifest_path,\n        manifest_path_index\n      )\n      let needed_paths = collect_needed_paths_from_manifest_headers(\n        entry_path,\n        manifest_path_index,\n        header_rows\n      )\n      Array::length(needed_paths)\n    },\n    None => throw(\"manifest rows unavailable\")\n  }\n}\n\nexport let probe_manifest_scan_paths_count: (String) -> Int with { Error, Fs } = (entry_path) -> {\n  match try_load_manifest_rows(entry_path) {\n    Some((base_dir, rows)) => {\n      let manifest_path_index = build_manifest_path_index_from_rows(base_dir, rows)\n      let needed_paths = collect_needed_paths_from_manifest_scan(\n        entry_path,\n        manifest_path_index\n      )\n      Array::length(needed_paths)\n    },\n    None => throw(\"manifest rows unavailable\")\n  }\n}\n\n\nexport let try_collect_manifest_sources_fs: (String) -> Option[(String, Array[(String, String)])] with { Error, Fs } = (entry_path) -> {\n  match try_load_manifest_rows(entry_path) {\n    Some((base_dir, rows)) => {\n      let manifest_path = join_path(base_dir, \"selfhost_sources_manifest.tsv\")\n      let manifest_path_index = build_manifest_path_index_from_rows(base_dir, rows)\n      let header_rows = load_or_collect_manifest_header_rows(\n        entry_path,\n        manifest_path,\n        manifest_path_index\n      )\n      let needed_paths = collect_needed_paths_from_manifest_headers(\n        entry_path,\n        manifest_path_index,\n        header_rows\n      )\n      let needed_path_index = build_manifest_path_index(needed_paths)\n      let sources = load_manifest_sources_by_path_index(base_dir, rows, needed_path_index)\n      Some((manifest_path, sources))\n    },\n    None => None\n  }\n}\n\nexport let try_collect_manifest_source_groups_fs: (String) -> Option[(String, Array[(String, Array[(String, String)])])] with { Error, Fs } = (entry_path) -> {\n  match try_load_manifest_rows(entry_path) {\n    Some((base_dir, rows)) => {\n      let manifest_path = join_path(base_dir, \"selfhost_sources_manifest.tsv\")\n      let manifest_path_index = build_manifest_path_index_from_rows(base_dir, rows)\n      let header_rows = load_or_collect_manifest_header_rows(\n        entry_path,\n        manifest_path,\n        manifest_path_index\n      )\n      let needed_paths = collect_needed_paths_from_manifest_headers(\n        entry_path,\n        manifest_path_index,\n        header_rows\n      )\n      let needed_path_index = build_manifest_path_index(needed_paths)\n      let groups = load_manifest_source_groups_by_path_index(base_dir, rows, needed_path_index)\n      Some((manifest_path, groups))\n    },\n    None => None\n  }\n}\n")
}

