  ("lib/@vibe/compiler/codegen/int_parse_expr.vibe",
"\n\n\nexport let int_parse_expr: (Expr) -> Expr = (arg) -> {\n  let c1: (String, Expr) -> Expr = (f, a0) -> {\n    ECall(EIdent(f, -1), [\n      a0\n    ], -1)\n  }\n  let c2: (String, Expr, Expr) -> Expr = (f, a0, a1) -> {\n    ECall(EIdent(f, -1), [\n      a0,\n      a1\n    ], -1)\n  }\n  let s = EIdent(\"__ip_s\", -1)\n  let len = EIdent(\"__ip_len\", -1)\n  let start = EIdent(\"__ip_start\", -1)\n  let neg = EIdent(\"__ip_neg\", -1)\n  let i = EIdent(\"__ip_i\", -1)\n  let acc = EIdent(\"__ip_acc\", -1)\n  let valid = EIdent(\"__ip_valid\", -1)\n  let ch = EIdent(\"__ip_ch\", -1)\n  let loop_body = ELet(\"__ip_ch\", c2(\"String::char_code_at\", s, i), ESeq(\n    EIf(EBinOp(\"||\", EBinOp(\"<\", ch, EInt(48)), EBinOp(\">\", ch, EInt(57))), EAssign(\"__ip_valid\", EBool(false), EUnit), EAssign(\"__ip_acc\", EBinOp(\"+\", EBinOp(\"*\", acc, EInt(10)), EBinOp(\"-\", ch, EInt(48))), EUnit)),\n    EAssign(\"__ip_i\", EBinOp(\"+\", i, EInt(1)), EUnit)\n  ), -1)\n  let while_loop = EWhile(EBinOp(\"<\", i, len), loop_body)\n  let result_val = EIf(neg, EBinOp(\"-\", EInt(0), acc), acc)\n  let final_check = EIf(EBinOp(\"&&\", valid, EBinOp(\"<\", start, len)), c1(\"Some\", result_val), EIdent(\"None\", -1))\n  ELet(\"__ip_s\", arg, ELet(\"__ip_len\", c1(\"String::length\", s), EIf(EBinOp(\"==\", len, EInt(0)), EIdent(\"None\", -1), ELet(\"__ip_neg\", EBinOp(\"==\", c2(\"String::char_code_at\", s, EInt(0)), EInt(45)), ELet(\"__ip_start\", EIf(neg, EInt(1), EInt(0)), ELetMut(\"__ip_i\", start, ELetMut(\"__ip_acc\", EInt(0), ELetMut(\"__ip_valid\", EBool(true), ESeq(while_loop, final_check), -1), -1), -1), -1), -1)), -1), -1)\n}\n")
}

let selfhost_source_80 = () -> (String, String) {
  ("lib/@vibe/compiler/codegen/expr/compile_call.vibe",
"\n\n\n\n\n\n\n\n\n\n\n\nlet cc_is_projection: (Expr) -> Bool = (e) -> {\n  match e {\n    EDot(_, _, _, _) => true,\n    _ => false\n  }\n}\n\nexport let cc_is_borrow_ret_call: (Expr, CompileCtx) -> Bool = (e, ctx) -> {\n  match e {\n    ECall(callee, _, _) =>\n    match callee {\n      EIdent(f, _) => f == \"Array::get\" || f == \"Map::get\" || f == \"__index\" || f == \"__rec_field\" || array_contains_str(ctx.borrow_ret_names, f),\n      _ => false\n    },\n    _ => false\n  }\n}\n\nlet rec cc_arg_is_scalarish: (Expr) -> Bool with { Error } = (e) -> {\n  let t = expr_tag(e)\n  if t == 0 || t == 1 {\n    true\n  } else if t == 5 {\n    let op = get_ebinop_op(e)\n    op == \"&\" || op == \"|\" || op == \"^\" || op == \"<<\" || op == \">>\" || op == \"%\" || op == \"<\" || op == \">\" || op == \"<=\" || op == \">=\" || op == \"==\" || op == \"!=\" || op == \"&&\" || op == \"||\"\n  } else if t == 6 {\n    let uop = get_eunaryop_op(e)\n    uop == \"!\" || (uop == \"-\" && cc_arg_is_scalarish(get_eunaryop_expr(e)))\n  } else {\n    false\n  }\n}\n\nlet cc_slot_is_floatish: (CompileCtx, Int) -> Bool = (ctx, slot) -> {\n  let arr = ctx.float_local_slots\n  let mut j = Array::length(arr) - 1\n  let mut result = false\n  while j >= 0 {\n    let entry = Array::get(arr, j)\n    if entry / 2 == slot {\n      result = (entry % 2) == 1\n      j = -1\n    } else {\n      j = j - 1\n    }\n  }\n  result\n}\n\nlet rec cc_expr_is_floatish: (Expr, Array[String], CompileCtx) -> Bool with { Error } = (e, local_names, ctx) -> {\n  let dot_float = match e {\n    EDot(dobj, dfield, _, _) => {\n      let fc = String::char_code_at(dfield, 0)\n      if fc >= 48 && fc <= 57 && is_eident(dobj) {\n        let slot = find_local_slot(local_names, get_eident_name(dobj))\n        if slot >= 0 {\n          let info = agg_slot_lookup(ctx.agg_local_slots, slot)\n          if info >= 0 && info / 64 == 1 {\n            let backing = agg_expr_lookup(ctx.agg_local_slots, ctx.agg_local_exprs, slot)\n            if is_etuple(backing) {\n              let elems = get_etuple_elems(backing)\n              let mut k = 0\n              let mut fp = 0\n              while fp < String::length(dfield) {\n                k = k * 10 + (String::char_code_at(dfield, fp) - 48)\n                fp = fp + 1\n              }\n              if k >= 0 && k < Array::length(elems) {\n                cc_expr_is_floatish(Array::get(elems, k), local_names, ctx)\n              } else {\n                false\n              }\n            } else {\n              false\n            }\n          } else {\n            false\n          }\n        } else {\n          false\n        }\n      } else {\n        false\n      }\n    },\n    _ => false\n  }\n  let tag = expr_tag(e)\n  if dot_float {\n    true\n  } else if tag == 2 {\n    true\n  } else if tag == 4 {\n    let nm = get_eident_name(e)\n    let len = Array::length(local_names)\n    let mut i = len - 1\n    let mut slot = -1\n    while i >= 0 {\n      if Array::get(local_names, i) == nm {\n        slot = i\n        i = -1\n      } else {\n        i = i - 1\n      }\n    }\n    if slot >= 0 {\n      cc_slot_is_floatish(ctx, slot)\n    } else {\n      false\n    }\n  } else if tag == 5 {\n    let op = get_ebinop_op(e)\n    if op == \"+\" || op == \"-\" || op == \"*\" || op == \"/\" {\n      cc_expr_is_floatish(get_ebinop_lhs(e), local_names, ctx) || cc_expr_is_floatish(get_ebinop_rhs(e), local_names, ctx)\n    } else {\n      false\n    }\n  } else if tag == 6 {\n    let op = get_eunaryop_op(e)\n    if op == \"-\" {\n      cc_expr_is_floatish(get_eunaryop_expr(e), local_names, ctx)\n    } else {\n      false\n    }\n  } else if tag == 8 {\n    let callee = get_ecall_callee(e)\n    if is_eident(callee) {\n      let fname = get_eident_name(callee)\n      if fname == \"Int::to_double\" || fname == \"Int::to_float\" || fname == \"Float::to_double\" || fname == \"Double::to_float\" || fname == \"Double::from_i64_bits\" {\n        true\n      } else if fname == \"__rec_field\" {\n        let args = get_ecall_args(e)\n        if Array::length(args) == 2 && is_eident(Array::get(args, 0)) && expr_tag(Array::get(args, 1)) == 0 {\n          let slot = find_local_slot(local_names, get_eident_name(Array::get(args, 0)))\n          if slot >= 0 {\n            let info = agg_slot_lookup(ctx.agg_local_slots, slot)\n            if info >= 0 && info / 64 == 1 {\n              let backing = agg_expr_lookup(ctx.agg_local_slots, ctx.agg_local_exprs, slot)\n              if is_etuple(backing) {\n                let elems = get_etuple_elems(backing)\n                let k = get_eint_value(Array::get(args, 1))\n                if k >= 0 && k < Array::length(elems) {\n                  cc_expr_is_floatish(Array::get(elems, k), local_names, ctx)\n                } else {\n                  false\n                }\n              } else {\n                false\n              }\n            } else {\n              false\n            }\n          } else {\n            false\n          }\n        } else {\n          false\n        }\n      } else {\n        false\n      }\n    } else {\n      false\n    }\n  } else {\n    false\n  }\n}\n\nlet cc_expr_is_boolish: (Expr, Array[String], CompileCtx) -> Bool with { Error } = (e, local_names, ctx) -> {\n  let tag = expr_tag(e)\n  if tag == 1 {\n    true\n  } else if tag == 4 {\n    let nm = get_eident_name(e)\n    let mut i = Array::length(local_names) - 1\n    let mut slot = -1\n    while i >= 0 {\n      if Array::get(local_names, i) == nm {\n        slot = i\n        i = -1\n      } else {\n        i = i - 1\n      }\n    }\n    if slot >= 0 {\n      let arr = ctx.int_local_slots\n      let mut j = Array::length(arr) - 1\n      let mut result = false\n      while j >= 0 {\n        let entry = Array::get(arr, j)\n        if entry / 4 == slot {\n          result = (entry % 4) == 3\n          j = -1\n        } else {\n          j = j - 1\n        }\n      }\n      result\n    } else {\n      false\n    }\n  } else if tag == 5 {\n    let op = get_ebinop_op(e)\n    op == \"==\" || op == \"!=\" || op == \"<\" || op == \">\" || op == \"<=\" || op == \">=\" || op == \"&&\" || op == \"||\"\n  } else if tag == 6 {\n    get_eunaryop_op(e) == \"!\"\n  } else if tag == 16 {\n    let arms = get_match_arms(e)\n    let alen2 = Array::length(arms)\n    if alen2 == 0 {\n      false\n    } else {\n      let mut all_bool = true\n      let mut bi2 = 0\n      while bi2 < alen2 {\n        if expr_tag(get_arm_body(Array::get(arms, bi2))) != 1 {\n          all_bool = false\n        } else {\n          ()\n        }\n        bi2 = bi2 + 1\n      }\n      all_bool\n    }\n  } else if tag == 8 {\n    let bcallee = get_ecall_callee(e)\n    if is_eident(bcallee) {\n      let bcn = get_eident_name(bcallee)\n      String::starts_with(bcn, \"__arr_equals__\") || (String::ends_with(bcn, \"::equals\") && Array::length(get_ecall_args(e)) == 2)\n    } else {\n      false\n    }\n  } else {\n    false\n  }\n}\n\nexport let cc_is_loop_borrowed_ident: (Expr, CompileCtx) -> Bool = (e, ctx) -> {\n  match e {\n    EIdent(name, _) =>\n    array_contains_str(ctx.loop_borrowed_names, name) && !array_contains_str(ctx.ref_cell_names, name),\n    _ => false\n  }\n}\n\nlet cc_is_borrow_arg0_call: (String) -> Bool = (f) -> {\n  f == \"__index\" || f == \"Array::get\" || f == \"Array::length\" || f == \"Array::set\" || f == \"Array::push\" || f == \"ArrayBuilder::push\" || f == \"StringBuilder::push\" || f == \"MapBuilder::set\" || f == \"Map::get\" || f == \"Map::keys\" || f == \"Map::has_key\" || f == \"Map::has\" || f == \"Map::set\" || f == \"Map::size\" || f == \"Map::values\" || f == \"Map::delete\" || f == \"Bytes::push\" || f == \"Bytes::set\" || f == \"Bytes::get\" || f == \"Bytes::length\" || f == \"__rec_field\"\n}\n\nlet cc_retain_stored_arg: (Bytes, Expr, Array[String], Int, CompileCtx) -> Int with { Error } = (buf, carg, local_names, nl, ctx) -> {\n  let is_loop_borrow = ctx.enable_r