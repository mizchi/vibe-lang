  } else {\n    None\n  }\n}\n\nlet lookup_io_c: (String) -> Option[Type] = (name) -> {\n  if name == \"Lines::parse\" {\n    Some(CtFn([\n      CtString\n    ], CtArray(CtString), None))\n  } else if name == \"Lines::stringify\" {\n    Some(CtFn([\n      CtArray(CtString)\n    ], CtString, None))\n  } else if name == \"Llm::complete\" {\n    Some(CtFn([\n      CtString,\n      CtString\n    ], CtString, Some(\"Llm\")))\n  } else if name == \"Rlm::run\" {\n    Some(CtFn([\n      CtString,\n      CtString\n    ], CtString, Some(\"Llm\")))\n  } else if name == \"Rlm::finalize\" {\n    Some(CtFn([\n      CtString\n    ], CtString, None))\n  } else {\n    None\n  }\n}\n\nexport let lookup_io: (String) -> Option[Type] = (name) -> {\n  match lookup_io_a(name) {\n    Some(t) => Some(t),\n    None => match lookup_io_b(name) {\n      Some(t) => Some(t),\n      None => lookup_io_c(name)\n    }\n  }\n}\n")
