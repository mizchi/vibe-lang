"\n\n\n\n\n\n\n\n\n\nlet t6_bind_from_raw: (Bytes, Pat, Int, CompileCtx, Array[String]) -> Unit with { Error } = (buf, arm_pat, raw_l, ctx, local_names) -> {\n  if is_pctor(arm_pat) {\n    let cargs = get_pctor_args(arm_pat)\n    let decl_arity = effect_op_declared_arity(ctx.effect_op_keys, ctx.effect_op_arities, get_pctor_name(arm_pat))\n    if decl_arity > 1 {\n      let ncargs = Array::length(cargs)\n      let mut ci = 0\n      while ci < decl_arity {\n        if ci < ncargs {\n          let cp = Array::get(cargs, ci)\n          if is_pbind(cp) {\n            let pname = get_pbind_name(cp)\n            let fl = Array::length(local_names)\n            emit_local_get(buf, raw_l)\n            if ctx.enable_rc {\n              emit_i64_const(buf, -2)\n              emit_i64_and(buf)\n            } else {\n              ()\n            }\n            emit_i32_wrap_i64(buf)\n            emit_i64_load(buf, 3, if ctx.enable_rc {\n              8 + ci * 8\n            } else {\n              ci * 8\n            })\n            emit_local_set(buf, fl)\n            Array::push(local_names, pname)\n            if ctx.enable_rc {\n              emit_rc_dup_guarded(buf, fl, ctx.rc_shadow)\n            } else {\n              ()\n            }\n          } else if is_pwild(cp) {\n            ()\n          } else {\n            throw(\"handle: only simple bindings or '_' are supported in multi-argument effect op patterns (see #548)\")\n          }\n        } else {\n          ()\n        }\n        ci = ci + 1\n      }\n      if ctx.enable_rc && ctx.rc_drop_func_idx >= 0 {\n        emit_local_get(buf, raw_l)\n        emit_call(buf, ctx.rc_drop_func_idx)\n      } else {\n        ()\n      }\n    } else if Array::length(cargs) > 0 && is_pbind(Array::get(cargs, 0)) {\n      let pname = get_pbind_name(Array::get(cargs, 0))\n      let bl = Array::length(local_names)\n      emit_local_get(buf, raw_l)\n      emit_local_set(buf, bl)\n      Array::push(local_names, pname)\n    } else {\n      ()\n    }\n  } else {\n    ()\n  }\n}\n\nlet t6_effect_op_count: (Array[String], String) -> Int = (op_keys, eff_name) -> {\n  let mut c = 0\n  let mut i = 0\n  while i < Array::length(op_keys) {\n    let k = Array::get(op_keys, i)\n    let sep = String::index_of(k, \"::\")\n    if sep > 0 && k[0:sep] == eff_name {\n      c = c + 1\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  c\n}\n\n\nexport let compile_expr_tail6: (Bytes, Expr, Array[(Pat, Expr)], Array[String], Int, CompileCtx, Int, (Bytes, Expr, Array[String], Int, CompileCtx, Int) -> Int with { Error }) -> Int with { Error } = (buf, body, arms, local_names, next_local, ctx, ld, compile_expr) -> {\n  if Array::length(arms) > 0 {\n    let (catch_pat, fallback_expr) = Array::get(arms, 0)\n    let is_error = is_pctor(catch_pat) && get_pctor_name(catch_pat) == \"Error::Throw\"\n    let handled_eff = if is_pctor(catch_pat) {\n      let op_full = get_pctor_name(catch_pat)\n      let sep = String::index_of(op_full, \"::\")\n      if sep > 0 {\n        op_full[0:sep]\n      } else {\n        \"\"\n      }\n    } else {\n      \"\"\n    }\n    let needs_op_dispatch = !is_error && String::length(handled_eff) > 0 && t6_effect_op_count(ctx.effect_op_keys, handled_eff) > 1\n    let g_op_idx_global = if ctx.enable_rc {\n      6\n    } else {\n      5\n    }\n    let catch_tag = if is_error {\n      2\n    } else if is_pctor(catch_pat) {\n      effect_name_to_tag(ctx.effect_names, get_pctor_name(catch_pat))\n    } else {\n      3 + Array::length(ctx.effect_names)\n    }\n    let uses_frontier = !is_error\n    let eff_off = (catch_tag - 3) * 131072\n    let g_rbuf = if ctx.enable_rc {\n      5\n    } else {\n      4\n    }\n    let g_cur = if ctx.enable_rc {\n      3\n    } else {\n      2\n    }\n    if uses_frontier {\n      emit_global_get(buf, g_rbuf)\n      emit_i32_const(buf, eff_off)\n      emit_i32_add(buf)\n      emit_i64_const(buf, 0)\n      emit_i64_store(buf, 3, 8)\n    } else {\n      ()\n    }\n    emit_block_i64(buf)\n    emit_loop_void(buf)\n    if uses_frontier {\n      emit_global_get(buf, g_rbuf)\n      emit_i32_const(buf, eff_off)\n      emit_i32_add(buf)\n      emit_i64_const(buf, 0)\n      emit_i64_store(buf, 3, 0)\n    } else {\n      ()\n    }\n    emit_block_i64(buf)\n    bytebuf_push(buf, 31)\n    bytebuf_push(buf, 126)\n    bytebuf_push(buf, 1)\n    bytebuf_push(buf, 0)\n    bytebuf_push(buf, catch_tag)\n    bytebuf_push(buf, 0)\n    let _nl1 = compile_expr(buf, body, local_names, next_local, ctx, ld)\n    emit_end(buf)\n    emit_br(buf, 2)\n    emit_end(buf)\n    let raw_l = Array::length(local_names)\n    if needs_op_dispatch {\n      emit_local_set(buf, raw_l)\n      Array::push(local_names, \"__eff_raw\")\n    } else if is_pctor(catch_pat) {\n      let cargs = get_pctor_args(catch_pat)\n      let decl_arity = effect_op_declared_arity(ctx.effect_op_keys, ctx.effect_op_arities, get_pctor_name(catch_pat))\n      if decl_arity > 1 {\n        let ptr_l = Array::length(local_names)\n        emit_local_set(buf, ptr_l)\n        Array::push(local_names, \"__eff_payload\")\n        let ncargs = Array::length(cargs)\n        let mut ci = 0\n        while ci < decl_arity {\n          if ci < ncargs {\n            let cp = Array::get(cargs, ci)\n            if is_pbind(cp) {\n              let pname = get_pbind_name(cp)\n              let fl = Array::length(local_names)\n              emit_local_get(buf, ptr_l)\n              if ctx.enable_rc {\n                emit_i64_const(buf, -2)\n                emit_i64_and(buf)\n              } else {\n                ()\n              }\n              emit_i32_wrap_i64(buf)\n              emit_i64_load(buf, 3, if ctx.enable_rc {\n                8 + ci * 8\n              } else {\n                ci * 8\n              })\n              emit_local_set(buf, fl)\n              Array::push(local_names, pname)\n              if ctx.enable_rc {\n                emit_rc_dup_guarded(buf, fl, ctx.rc_shadow)\n              } else {\n                ()\n              }\n            } else if is_pwild(cp) {\n              ()\n            } else {\n              throw(\"handle: only simple bindings or '_' are supported in multi-argument effect op patterns (see #548)\")\n            }\n          } else {\n            ()\n          }\n          ci = ci + 1\n        }\n        if ctx.enable_rc && ctx.rc_drop_func_idx >= 0 {\n          emit_local_get(buf, ptr_l)\n          emit_call(buf, ctx.rc_drop_func_idx)\n        } else {\n          ()\n        }\n      } else if Array::length(cargs) > 0 && is_pbind(Array::get(cargs, 0)) {\n        let pname = get_pbind_name(Array::get(cargs, 0))\n        let bl = Array::length(local_names)\n        emit_local_set(buf, bl)\n        Array::push(local_names, pname)\n      } else {\n        emit_drop(buf)\n      }\n    } else if is_pbind(catch_pat) {\n      let pname = get_pbind_name(catch_pat)\n      let bl = Array::length(local_names)\n      emit_local_set(buf, bl)\n      Array::push(local_names, pname)\n    } else {\n      emit_drop(buf)\n    }\n    if uses_frontier {\n      emit_global_get(buf, g_rbuf)\n      emit_i32_const(buf, eff_off)\n      emit_i32_add(buf)\n      emit_i64_extend_i32_u(buf)\n      emit_global_set(buf, g_cur)\n    } else {\n      ()\n    }\n    emit_block_i64(buf)\n    bytebuf_push(buf, 31)\n    bytebuf_push(buf, 126)\n    bytebuf_push(buf, 1)\n    bytebuf_push(buf, 0)\n    bytebuf_push(buf, 1)\n    bytebuf_push(buf, 0)\n    let nl2 = if needs_op_dispatch {\n      let mut max_nl = Array::length(local_names)\n      let mut di = 0\n      while di < Array::length(arms) {\n        let (apat, abody) = Array::get(arms, di)\n        let aop = if is_pctor(apat) {\n          effect_op_index(ctx.effect_op_keys, get_pctor_name(apat))\n        } else {\n          0 - 1\n        }\n        emit_global_get(buf, g_op_idx_global)\n        emit_i64_const(buf, aop)\n        emit_i64_eq(buf)\n        emit_if_i64(buf)\n        t6_bind_from_raw(buf, apat, raw_l, ctx, local_names)\n        let anl = compile_expr(buf, abody, local_names, Array::length(local_names), ctx, ld)\n        if anl > max_nl {\n          max_nl = anl\n        } else {\n          ()\n        }\n        emit_else(buf)\n        di = di + 1\n      }\n      bytebuf_push(buf, 0)\n      let mut ce = 0\n      while ce < Array::length(arms) {\n        emit_end(buf)\n        ce = ce + 1\n      }\n      max_nl\n    } else {\n      compile_expr(buf, fallback_expr, local_names, Array::length(local_names), ctx, ld)\n    }\n    emit_end(buf)\n    emit_br(buf, 2)\n    emit_end(buf)\n    emit_drop(buf)\n    emit_br(buf, 0)\n    emit_end(buf)\n    bytebuf_push(buf, 0)\n    emit_end(buf)\n    nl2\n  } else {\n    compile_expr(buf, body, local_names, next_local, ctx, ld)\n  }\n}\n")
}

let selfhost_source_83 = () -> (String, String) {
  ("lib/@vibe/compiler/codegen/expr/compile_expr_tail5.vibe",
"\n\n\n\n\n\n\n\n\n\n\n\nexport let compile_expr_tail5: (Bytes, Expr, Array[String], Int, CompileCtx, Int, (Bytes, Expr, Array[String], Int, CompileCtx, Int) -> Int with { Error }) -> Int with { Error } = (buf, expr, local_names, next_local, ctx, ld, compile_expr) -> {\n  match expr {\n    EForIn(_, _, _, _) => throw(\"unsupported expression in codegen: EForIn\"),\n    EHandle(body, arms) => compile_expr_tail6(buf, body, arms, local_names, next_local, ctx, ld, compile_expr)\n    ,\n    EStringInterp(parts) => compile_expr_tail7(buf, parts, local_names, next_local, ctx, ld, compile_expr)\n    ,\n    ELabeledArg(_, _, val) => compile_expr(buf, val, local_names, next_local, ctx, ld)\n    ,\n    _ => throw(\"unsupported expression in codegen: unknown\")\n  }\n}\n")
}

let selfhost_source_84 = () -> (String, String) {
  ("lib/@vibe/compiler/codegen/expr/compile_expr_tail4.vibe",
"\n\n\n\n\n\n\n\n\n\n\nlet expr_is_projection: (Expr) -> Bool = (e) -> {\n  match e {\n    EDot(_, _, _, _) => true,\n    _ => false\n  }\n}\n\nexport let compile_expr_tail4: (Bytes, Expr, Array[String], Int, CompileCtx, Int, (Bytes, Expr, Array[String], Int, CompileCtx, Int) -> Int with { Error }) -> Int with { Error } = (buf, expr, local_names, next_local, ctx, ld, compile_expr) -> {\n  match expr {\n    EDot(obj, field, _, _) => {\n      let fc = String::char_code_at(field, 0)\n      if fc >= 48 && fc <= 57 {\n        let mut vi = 0\n        let mut vp = 0\n        while vp < String::length(field) {\n          vi = vi * 10 + (String::char_code_at(field, vp) - 48)\n          vp = vp + 1\n        }\n        let nl1 = compile_expr(buf, obj, local_names, next_local, ctx, ld)\n        if ctx.enable_rc {\n          emit_i64_const(buf, -2)\n          emit_i64_and(buf)\n        }\n        emit_i32_wrap_i64(buf)\n        let toff = if ctx.enable_rc {\n          8 + vi * 8\n        } else {\n          vi * 8\n        }\n        emit_i64_load(buf, 3, toff)\n        nl1\n      } else {\n        let cands = struct_field_candidates(ctx.ctor_table, field)\n        if Array::length(cands) == 0 {\n          throw(String::concat(\"unknown struct field: \", field))\n        }\n        let (_, idx0) = Array::get(cands, 0)\n        let dispatch = struct_field_dispatch_cases(cands)\n        let nl1 = compile_expr(buf, obj, local_names, next_local, ctx, ld)\n        emit_i64_const(buf, -2)\n        emit_i64_and(buf)\n        if Array::length(dispatch) == 0 {\n          emit_i32_wrap_i64(buf)\n          emit_i64_load(buf, 3, 8 + idx0 * 8)\n          nl1\n        } else {\n          let obj_l = nl1\n          Array::push(local_names, \"__dot_obj\")\n          emit_local_set(buf, obj_l)\n          let mut di = 0\n          while di < Array::length(dispatch) {\n            let (dtag, didx) = Array::get(dispatch, di)\n            emit_local_get(buf, obj_l)\n            emit_i32_wrap_i64(buf)\n            emit_i32_load(buf, 2, 0)\n            emit_i32_const(buf, dtag)\n            emit_i32_eq(buf)\n            emit_if_i64(buf)\n            emit_local_get(buf, obj_l)\n            emit_i32_wrap_i64(buf)\n            emit_i64_load(buf, 3, 8 + didx * 8)\n            emit_else(buf)\n            di = di + 1\n          }\n          emit_local_get(buf, obj_l)\n          emit_i32_wrap_i64(buf)\n          emit_i64_load(buf, 3, 8 + idx0 * 8)\n          let mut de = 0\n          while de < Array::length(dispatch) {\n            emit_end(buf)\n            de = de + 1\n          }\n          nl1 + 1\n        }\n      }\n    },\n    ERecord(_, fields) => {\n      let flen = Array::length(fields)\n      let lit_names = Array::slice([\n        \"\"\n      ], 0, 0)\n      let mut lni = 0\n      while lni < flen {\n        let (lfn, _) = Array::get(fields, lni)\n        Array::push(lit_names, lfn)\n        lni = lni + 1\n      }\n      let rec_si = struct_index_by_field_set(ctx.ctor_table, lit_names)\n      let rec_tag = if rec_si >= 0 {\n        struct_tag_by_index(ctx.ctor_table, rec_si)\n      } else {\n        0\n      }\n      let rec_fields = if rec_si >= 0 {\n        let def_fnames = Array::get(ctx.ctor_table.struct_field_names, rec_si)\n        let ordered = Array::slice([\n          (\"\", EUnit)\n        ], 0, 0)\n        let mut oi = 0\n        while oi < Array::length(def_fnames) {\n          let target_name = Array::get(def_fnames, oi)\n          let mut ri2 = 0\n          while ri2 < flen {\n            let (rfn, rfv) = Array::get(fields, ri2)\n            if rfn == target_name {\n              Array::push(ordered, (rfn, rfv))\n              ri2 = flen\n            } else {\n              ri2 = ri2 + 1\n            }\n          }\n          oi = oi + 1\n        }\n        ordered\n      } else {\n        fields\n      }\n      let ptr_local = next_local\n      Array::push(local_names, \"__rec_ptr\")\n      if ctx.enable_rc {\n        let total = 16 + flen * 8\n        emit_i64_const(buf, total)\n        emit_call(buf, ctx.rc_alloc_func_idx)\n        emit_local_set(buf, ptr_local)\n        emit_local_get(buf, ptr_local)\n        emit_i32_wrap_i64(buf)\n        emit_i32_const(buf, total)\n        emit_i32_store(buf, 2, 0)\n        emit_local_get(buf, ptr_local)\n        emit_i32_wrap_i64(buf)\n        emit_i32_const(buf, 1)\n        emit_i32_store(buf, 2, 4)\n        emit_local_get(buf, ptr_local)\n        emit_i32_wrap_i64(buf)\n        emit_i32_const(buf, 1)\n        emit_i32_store8(buf, 0, 7)\n        emit_local_get(buf, ptr_local)\n        emit_i32_wrap_i64(buf)\n        emit_i32_const(buf, rec_tag)\n        emit_i32_store(buf, 2, 8)\n        emit_local_get(buf, ptr_local)\n        emit_i32_wrap_i64(buf)\n        emit_i32_const(buf, flen)\n        emit_i32_store(buf, 2, 12)\n        let mut nl_r = next_local + 1\n        let mut ri = 0\n        while ri < flen {\n          let (_, fexpr) = Array::get(rec_fields, ri)\n          nl_r = compile_expr(buf, fexpr, local_names, nl_r, ctx, ld)\n          let val_local = nl_r\n          Array::push(local_names, \"__rec_val\")\n          emit_local_set(buf, val_local)\n          nl_r = nl_r + 1\n          if ctx.enable_rc && (expr_is_projection(fexpr) || cc_is_borrow_ret_call(fexpr, ctx) || cc_is_loop_borrowed_ident(fexpr, ctx)) {\n            emit_rc_dup_guarded(buf, val_local, ctx.rc_shadow)\n          } else {\n            ()\n          }\n          emit_local_get(buf, ptr_local)\n          emit_i32_wrap_i64(buf)\n          emit_local_get(buf, val_local)\n          emit_i64_store(buf, 3, 16 + ri * 8)\n          ri = ri + 1\n        }\n        emit_local_get(buf, ptr_local)\n        emit_i64_const(buf, 8)\n        emit_i64_add(buf)\n        emit_i64_const(buf, 1)\n        emit_i64_or(buf)\n        nl_r\n      } else {\n        let obj_size = 8 + flen * 8\n        emit_global_get(buf, 0)\n        emit_i64_extend_i32_u(buf)\n        emit_local_set(buf, ptr_local)\n        emit_global_get(buf, 0)\n        emit_i32_const(buf, obj_size)\n        emit_i32_add(buf)\n        emit_global_set(buf, 0)\n        emit_heap_grow_after_heap_set(buf, ctx)\n        emit_local_get(buf, ptr_local)\n        emit_i32_wrap_i64(buf)\n        emit_i32_const(buf, rec_tag)\n        emit_i32_store(buf, 2, 0)\n        emit_local_get(buf, ptr_local)\n        emit_i32_wrap_i64(buf)\n        emit_i32_const(buf, flen)\n        emit_i32_store(buf, 2, 4)\n        let mut nl_r = next_local + 1\n        let mut ri = 0\n        while ri < flen {\n          let (_, fexpr) = Array::get(rec_fields, ri)\n          nl_r = compile_expr(buf, fexpr, local_names, nl_r, ctx, ld)\n          let val_local = nl_r\n          Array::push(local_names, \"__rec_val\")\n          emit_local_set(buf, val_local)\n          nl_r = nl_r + 1\n          emit_local_get(buf, ptr_local)\n          emit_i32_wrap_i64(buf)\n          emit_local_get(buf, val_local)\n          emit_i64_store(buf, 3, 8 + ri * 8)\n          ri = ri + 1\n        }\n        emit_local_get(buf, ptr_local)\n        emit_i64_const(buf, 1)\n        emit_i64_or(buf)\n        nl_r\n      }\n    },\n    EMap(fields) => {\n      let flen = Array::length(fields)\n      let obj_size = 8 + flen * 2 * 8\n      let ptr_local = next_local\n      Array::push(local_names, \"__map_ptr\")\n      emit_global_get(buf, 0)\n      emit_i64_extend_i32_u(buf)\n      emit_local_set(buf, ptr_local)\n      emit_global_get(buf, 0)\n      emit_i32_const(buf, obj_size)\n      emit_i32_add(buf)\n      emit_global_set(buf, 0)\n      emit_heap_grow_after_heap_set(buf, ctx)\n      emit_local_get(buf, ptr_local)\n      emit_i32_wrap_i64(buf)\n      emit_i32_const(buf, flen)\n      emit_i32_store(buf, 2, 0)\n      let mut nl_m = next_local + 1\n      let mut mi = 0\n      while mi < flen {\n        let (key, val_expr) = Array::get(fields, mi)\n        emit_local_get(buf, ptr_local)\n        emit_i32_wrap_i64(buf)\n        let key_idx = str_table_lookup(ctx.str_table.strs, key)\n        if key_idx >= 0 {\n          emit_str_ref(buf, Array::get(ctx.str_table.offsets, key_idx), Array::get(ctx.str_table.lengths, key_idx))\n        } else {\n          emit_i64_const(buf, 0)\n        }\n        emit_i64_store(buf, 3, 8 + mi * 16)\n        emit_local_get(buf, ptr_local)\n        emit_i32_wrap_i64(buf)\n        nl_m = compile_expr(buf, val_expr, local_names, nl_m, ctx, ld)\n        let val_local = nl_m\n        Array::push(local_names, \"__map_val\")\n        emit_local_set(buf, val_local)\n        nl_m = nl_m + 1\n        emit_local_get(buf, val_local)\n        emit_i64_store(buf, 3, 8 + mi * 16 + 8)\n        mi = mi + 1\n      }\n      emit_local_get(buf, ptr_local)\n      nl_m\n    },\n    _ => compile_expr_tail5(buf, expr, local_names, next_local, ctx, ld, compile_expr)\n  }\n}\n")
}

let selfhost_source_85 = () -> (String, String) {
  ("lib/@vibe/compiler/codegen/expr/compile_expr_tail3.vibe",
"\n\n\n\n\n\n\n\n\n\n\nexport let compile_expr_tail3: (Bytes, Expr, Array[String], Int, CompileCtx, Int, (Bytes, Expr, Array[String], Int, CompileCtx, Int) -> Int with { Error }) -> Int with { Error } = (buf, expr, local_names, next_local, ctx, ld, compile_expr) -> {\n  let __tag = expr_tag(expr)\n  if __tag == 19 {\n    let cond = get_ewhile_cond(expr)\n    let body = get_ewhile_body(expr)\n    let lb_base = Array::length(ctx.loop_borrowed_names)\n    if ctx.enable_rc {\n      let mut lbi = 0\n      while lbi < Array::length(local_names) {\n        Array::push(ctx.loop_borrowed_names, Array::get(local_names, lbi))\n        lbi = lbi + 1\n      }\n    } else {\n      ()\n    }\n    emit_block_void(buf)\n    emit_loop_void(buf)\n    let w_ld_in = 0\n    let w_cond_tag = expr_tag(cond)\n    let nl1 = if w_cond_tag == 5 {\n      let wcop = get_ebinop_op(cond)\n      if wcop == \"<\" || wcop == \">\" || wcop == \"<=\" || wcop == \">=\" {\n        let wlhs = get_ebinop_lhs(cond)\n        let wrhs = get_ebinop_rhs(cond)\n        let wnl1 = compile_expr(buf, wlhs, local_names, next_local, ctx, w_ld_in)\n        let wnl2 = compile_expr(buf, wrhs, local_names, wnl1, ctx, w_ld_in)\n        if wcop == \"<\" {\n          emit_i64_lt_s(buf); emit_i32_eqz(buf)\n        }\n        else if wcop == \">\" {\n          emit_i64_gt_s(buf); emit_i32_eqz(buf)\n        }\n        else if wcop == \"<=\" {\n          emit_i64_le_s(buf); emit_i32_eqz(buf)\n        }\n        else {\n          emit_i64_ge_s(buf); emit_i32_eqz(buf)\n        }\n        wnl2\n      } else {\n        let wnl = compile_expr(buf, cond, local_names, next_local, ctx, w_ld_in)\n        emit_i64_eqz(buf)\n        wnl\n      }\n    } else {\n      let wnl = compile_expr(buf, cond, local_names, next_local, ctx, w_ld_in)\n      emit_i64_eqz(buf)\n      wnl\n    }\n    emit_br_if(buf, 1)\n    let nl2 = compile_expr(buf, body, local_names, nl1, ctx, w_ld_in)\n    emit_drop(buf)\n    emit_br(buf, 0)\n    emit_end(buf)\n    emit_end(buf)\n    Array::truncate(ctx.loop_borrowed_names, lb_base)\n    emit_i64_const(buf, 0)\n    nl2\n  } else if __tag == 20 {\n    emit_br(buf, ld + 1)\n    emit_i64_const(buf, 0)\n    next_local\n  } else if __tag == 21 {\n    emit_br(buf, ld)\n    emit_i64_const(buf, 0)\n    next_local\n  } else if __tag == 22 {\n    emit_i64_const(buf, 0)\n    next_local\n  } else if __tag == 23 {\n    let msg_expr = get_ethrow_expr(expr)\n    let nl = compile_expr(buf, msg_expr, local_names, next_local, ctx, ld)\n    bytebuf_push(buf, 8)\n    bytebuf_push(buf, 2)\n    nl\n  } else if __tag == 24 {\n    compile_lambda(buf, get_efn_params(expr), get_efn_body(expr), local_names, next_local, ctx, ld, compile_expr)\n  } else if __tag == 26 {\n    let ret_expr = get_ereturn_expr(expr)\n    let nl = compile_expr(buf, ret_expr, local_names, next_local, ctx, ld)\n    emit_return(buf)\n    nl\n  } else {\n    compile_expr_tail4(buf, expr, local_names, next_local, ctx, ld, compile_expr)\n  }\n}\n")
}

