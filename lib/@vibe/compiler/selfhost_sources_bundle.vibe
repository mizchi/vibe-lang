  ("lib/@vibe/compiler/codegen/double_to_string_expr.vibe",
"\n\n\nexport let double_to_string_expr: (Expr) -> Expr = (arg) -> {\n  let c1: (String, Expr) -> Expr = (f, a0) -> {\n    ECall(EIdent(f, -1), [\n      a0\n    ], -1)\n  }\n  let c2: (String, Expr, Expr) -> Expr = (f, a0, a1) -> {\n    ECall(EIdent(f, -1), [\n      a0,\n      a1\n    ], -1)\n  }\n  let c3: (String, Expr, Expr, Expr) -> Expr = (f, a0, a1, a2) -> {\n    ECall(EIdent(f, -1), [\n      a0,\n      a1,\n      a2\n    ], -1)\n  }\n  let n = EIdent(\"__dts_n\", -1)\n  let neg = EIdent(\"__dts_neg\", -1)\n  let a = EIdent(\"__dts_a\", -1)\n  let ip = EIdent(\"__dts_ip\", -1)\n  let frac = EIdent(\"__dts_frac\", -1)\n  let s0 = EIdent(\"__dts_s0\", -1)\n  let ip2 = EIdent(\"__dts_ip2\", -1)\n  let sc = EIdent(\"__dts_sc\", -1)\n  let istr = EIdent(\"__dts_istr\", -1)\n  let signed = EIdent(\"__dts_signed\", -1)\n  let ds = EIdent(\"__dts_ds\", -1)\n  let endv = EIdent(\"__dts_end\", -1)\n  let big = EIdent(\"__dts_big\", -1)\n  let ch_minus = c1(\"String::from_char_code\", EInt(45))\n  let ch_dot = c1(\"String::from_char_code\", EInt(46))\n  let ch_zero = c1(\"String::from_char_code\", EInt(48))\n  let scale_int = EInt(1000000000000000)\n  let frac_tail = ELetMut(\"__dts_ds\", c1(\"__to_string\", sc), ELetMut(\"__dts_end\", EInt(15), ESeq(EWhile(EBinOp(\"<\", c1(\"String::length\", ds), EInt(15)), EAssign(\"__dts_ds\", c2(\"String::concat\", ch_zero, ds), EUnit)), ESeq(EWhile(EBinOp(\"==\", c2(\"String::char_code_at\", ds, EBinOp(\"-\", endv, EInt(1))), EInt(48)), EAssign(\"__dts_end\", EBinOp(\"-\", endv, EInt(1)), EUnit)), c2(\"String::concat\", signed, c2(\"String::concat\", ch_dot, c3(\"String::substring\", ds, EInt(0), endv))))), -1), -1)\n  let signed_val = EIf(neg, EIf(EBinOp(\">\", ip2, EInt(0)), c2(\"String::concat\", ch_minus, istr), EIf(EBinOp(\">\", sc, EInt(0)), c2(\"String::concat\", ch_minus, istr), istr)), istr)\n  let small = ELet(\"__dts_ip\", c1(\"Double::to_int\", a), ELet(\"__dts_frac\", EBinOp(\"-\", a, c1(\"Int::to_double\", ip)), ELet(\"__dts_s0\", c1(\"Double::to_int\", EBinOp(\"+\", EBinOp(\"*\", frac, EFloat(1000000000000000.0)), EFloat(0.5))), ELet(\"__dts_ip2\", EIf(EBinOp(\">=\", s0, scale_int), EBinOp(\"+\", ip, EInt(1)), ip), ELet(\"__dts_sc\", EIf(EBinOp(\">=\", s0, scale_int), EInt(0), s0), ELet(\"__dts_istr\", c1(\"__to_string\", ip2), ELet(\"__dts_signed\", signed_val, EIf(EBinOp(\"==\", sc, EInt(0)), signed, frac_tail), -1), -1), -1), -1), -1), -1), -1)\n  let big_case = ELet(\"__dts_big\", c1(\"__to_string\", c1(\"Double::to_int\", a)), EIf(neg, c2(\"String::concat\", ch_minus, big), big), -1)\n  ELet(\"__dts_n\", arg, ELet(\"__dts_neg\", EBinOp(\"<\", n, EFloat(0.0)), ELet(\"__dts_a\", EIf(neg, EBinOp(\"-\", EFloat(0.0), n), n), EIf(EBinOp(\">=\", a, EFloat(900000000000000.0)), big_case, small), -1), -1), -1)\n}\n")
}

