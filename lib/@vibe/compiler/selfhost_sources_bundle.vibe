"\n\n\n\n\n\nexport let emit_simd_memcmp_16: (Bytes) -> Unit = (buf) -> {\n  emit_local_get(buf, 0)\n  emit_i32_wrap_i64(buf)\n  emit_v128_load(buf, 0, 0)\n\n  emit_local_get(buf, 1)\n  emit_i32_wrap_i64(buf)\n  emit_v128_load(buf, 0, 0)\n\n  emit_i8x16_eq(buf)\n  emit_i8x16_all_true(buf)\n  emit_i64_extend_i32_s(buf)\n}\n\n\nexport let emit_simd_find_byte_16: (Bytes) -> Unit = (buf) -> {\n  emit_local_get(buf, 0)\n  emit_i32_wrap_i64(buf)\n  emit_v128_load(buf, 0, 0)\n\n  emit_local_get(buf, 1)\n  emit_i32_wrap_i64(buf)\n  emit_i8x16_splat(buf)\n\n  emit_i8x16_eq(buf)\n  emit_i8x16_bitmask(buf)\n  emit_i64_extend_i32_s(buf)\n}\n\n\nexport let emit_simd_skip_whitespace_16: (Bytes) -> Unit = (buf) -> {\n  emit_local_get(buf, 0)\n  emit_i32_wrap_i64(buf)\n  emit_v128_load(buf, 0, 0)\n  emit_local_set(buf, 2)  // local2 = chunk\n\n  emit_local_get(buf, 2)\n  emit_i64_const(buf, 0x20)\n  emit_i32_wrap_i64(buf)\n  emit_i8x16_splat(buf)\n  emit_i8x16_eq(buf)\n\n  emit_local_get(buf, 2)\n  emit_i64_const(buf, 0x09)\n  emit_i32_wrap_i64(buf)\n  emit_i8x16_splat(buf)\n  emit_i8x16_eq(buf)\n\n  emit_v128_or(buf)\n\n  emit_local_get(buf, 2)\n  emit_i64_const(buf, 0x0A)\n  emit_i32_wrap_i64(buf)\n  emit_i8x16_splat(buf)\n  emit_i8x16_eq(buf)\n\n  emit_v128_or(buf)\n\n  emit_local_get(buf, 2)\n  emit_i64_const(buf, 0x0D)\n  emit_i32_wrap_i64(buf)\n  emit_i8x16_splat(buf)\n  emit_i8x16_eq(buf)\n\n  emit_v128_or(buf)\n\n  emit_v128_not(buf)\n  emit_i8x16_bitmask(buf)\n  emit_i64_extend_i32_s(buf)\n}\n\n\nexport let emit_simd_is_identifier_char_16: (Bytes) -> Unit = (buf) -> {\n  emit_local_get(buf, 0)\n  emit_i32_wrap_i64(buf)\n  emit_v128_load(buf, 0, 0)\n  emit_local_set(buf, 1)  // local1 = chunk\n\n  emit_local_get(buf, 1)\n  emit_i64_const(buf, 0x5F)\n  emit_i32_wrap_i64(buf)\n  emit_i8x16_splat(buf)\n  emit_i8x16_eq(buf)\n\n\n  emit_i8x16_bitmask(buf)\n  emit_i64_extend_i32_s(buf)\n}\n\n\nlet emit_i64_load: (Bytes, Int, Int) -> Unit = (buf, align, offset) -> {\n  bytebuf_push(buf, 41)\n  leb128_encode_u32(buf, align)\n  leb128_encode_u32(buf, offset)\n}\n\n\nexport let emit_scalar_memcmp_16_unrolled: (Bytes) -> Unit = (buf) -> {\n  emit_local_get(buf, 0)\n  emit_i32_wrap_i64(buf)\n  emit_i64_load(buf, 0, 0)\n\n  emit_local_get(buf, 1)\n  emit_i32_wrap_i64(buf)\n  emit_i64_load(buf, 0, 0)\n\n  emit_i64_eq(buf)\n  emit_if_i64(buf)\n    emit_local_get(buf, 0)\n    emit_i32_wrap_i64(buf)\n    emit_i64_load(buf, 0, 8)\n\n    emit_local_get(buf, 1)\n    emit_i32_wrap_i64(buf)\n    emit_i64_load(buf, 0, 8)\n\n    emit_i64_eq(buf)\n    emit_i64_extend_i32_s(buf)\n  emit_else(buf)\n    emit_i64_const(buf, 0)\n  emit_end(buf)\n}\n\n\nexport let emit_scalar_find_byte_16_unrolled: (Bytes) -> Unit = (buf) -> {\n  emit_local_get(buf, 0)\n  emit_i32_wrap_i64(buf)\n  emit_i32_load8_u(buf, 0, 0)\n  emit_i64_extend_i32_s(buf)\n  emit_local_get(buf, 1)\n  emit_i64_eq(buf)\n  emit_if_i64(buf)\n    emit_i64_const(buf, 1)\n    emit_return(buf)\n  emit_else(buf)\n    emit_local_get(buf, 0)\n    emit_i32_wrap_i64(buf)\n    emit_i32_load8_u(buf, 0, 1)\n    emit_i64_extend_i32_s(buf)\n    emit_local_get(buf, 1)\n    emit_i64_eq(buf)\n    emit_if_i64(buf)\n      emit_i64_const(buf, 2)\n      emit_return(buf)\n    emit_else(buf)\n      emit_local_get(buf, 0)\n      emit_i32_wrap_i64(buf)\n      emit_i32_load8_u(buf, 0, 2)\n      emit_i64_extend_i32_s(buf)\n      emit_local_get(buf, 1)\n      emit_i64_eq(buf)\n      emit_if_i64(buf)\n        emit_i64_const(buf, 4)\n        emit_return(buf)\n      emit_else(buf)\n        emit_local_get(buf, 0)\n        emit_i32_wrap_i64(buf)\n        emit_i32_load8_u(buf, 0, 3)\n        emit_i64_extend_i32_s(buf)\n        emit_local_get(buf, 1)\n        emit_i64_eq(buf)\n        emit_if_i64(buf)\n          emit_i64_const(buf, 8)\n          emit_return(buf)\n        emit_else(buf)\n          emit_i64_const(buf, 0)\n        emit_end(buf)\n      emit_end(buf)\n    emit_end(buf)\n  emit_end(buf)\n}\n")
