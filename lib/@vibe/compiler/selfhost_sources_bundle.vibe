Unknown),\n      None\n    ))\n  }\n  else None\n}\n\nlet lookup_array_fold: (String) -> Option[Type] = (name) -> {\n  if name == \"Array::fold\" {\n    Some(CtFn(\n      array_three_params(\n        CtArray(CtUnknown),\n        CtUnknown,\n        CtFn(array_two_params(CtUnknown, CtUnknown), CtUnknown, None)\n      ),\n      CtUnknown,\n      None\n    ))\n  }\n  else None\n}\n\nlet lookup_array_filter: (String) -> Option[Type] = (name) -> {\n  if name == \"Array::filter\" {\n    Some(CtFn(\n      array_two_params(CtArray(CtUnknown), CtFn(array_one_param(CtUnknown), CtBool, None)),\n      CtArray(CtUnknown),\n      None\n    ))\n  }\n  else None\n}\n\nlet lookup_array_foreach: (String) -> Option[Type] = (name) -> {\n  if name == \"Array::foreach\" {\n    Some(CtFn(\n      array_two_params(CtArray(CtUnknown), CtFn(array_one_param(CtUnknown), CtUnit, None)),\n      CtUnit,\n      None\n    ))\n  }\n  else None\n}\n\nlet lookup_array_reverse: (String) -> Option[Type] = (name) -> {\n  if name == \"Array::reverse\" {\n    Some(CtFn(array_one_param(CtArray(CtUnknown)), CtArray(CtUnknown), None))\n  }\n  else None\n}\n\nlet lookup_array_any: (String) -> Option[Type] = (name) -> {\n  if name == \"Array::any\" || name == \"Array::all\" {\n    Some(CtFn(\n      array_two_params(CtArray(CtUnknown), CtFn(array_one_param(CtUnknown), CtBool, None)),\n      CtBool,\n      None\n    ))\n  }\n  else None\n}\n\nlet lookup_array_find: (String) -> Option[Type] = (name) -> {\n  if name == \"Array::find\" {\n    Some(CtFn(\n      array_two_params(CtArray(CtUnknown), CtFn(array_one_param(CtUnknown), CtBool, None)),\n      CtOption(CtUnknown),\n      None\n    ))\n  }\n  else None\n}\n\nlet lookup_array_sort: (String) -> Option[Type] = (name) -> {\n  if name == \"Array::sort\" {\n    Some(CtFn(array_one_param(CtArray(CtUnknown)), CtArray(CtUnknown), None))\n  }\n  else None\n}\n\nlet lookup_array_contains: (String) -> Option[Type] = (name) -> {\n  if name == \"Array::contains\" {\n    Some(CtFn(array_two_params(CtArray(CtUnknown), CtUnknown), CtBool, None))\n  }\n  else None\n}\n\nlet lookup_array_join: (String) -> Option[Type] = (name) -> {\n  if name == \"Array::join\" {\n    Some(CtFn(array_two_params(CtArray(CtUnknown), CtString), CtString, None))\n  }\n  else None\n}\n\nlet lookup_array_length: (String) -> Option[Type] = (name) -> {\n  if name == \"Array::length\" {\n    Some(CtFn(array_one_param(CtArray(CtUnknown)), CtInt, None))\n  }\n  else None\n}\n\nlet lookup_array_group_a: (String) -> Option[Type] = (name) -> {\n  match lookup_array_new(name) {\n    Some(t) => Some(t),\n    None => match lookup_array_length(name) {\n      Some(t) => Some(t),\n      None => match lookup_array_get(name) {\n        Some(t) => Some(t),\n        None => lookup_array_set(name)\n      }\n    }\n  }\n}\n\nlet lookup_array_push_all: (String) -> Option[Type] = (name) -> {\n  if name == \"Array::push_all\" {\n    Some(CtFn(array_two_params(CtArray(CtUnknown), CtArray(CtUnknown)), CtUnit, None))\n  }\n  else None\n}\n\nlet lookup_array_truncate: (String) -> Option[Type] = (name) -> {\n  if name == \"Array::truncate\" {\n    Some(CtFn(array_two_params(CtArray(CtUnknown), CtInt), CtUnit, None))\n  }\n  else None\n}\n\nlet lookup_array_group_b: (String) -> Option[Type] = (name) -> {\n  match lookup_array_push(name) {\n    Some(t) => Some(t),\n    None => match lookup_array_slice(name) {\n      Some(t) => Some(t),\n      None => match lookup_array_push_all(name) {\n        Some(t) => Some(t),\n        None => match lookup_array_truncate(name) {\n          Some(t) => Some(t),\n          None => match lookup_array_concat(name) {\n            Some(t) => Some(t),\n            None => match lookup_array_map(name) {\n              Some(t) => Some(t),\n              None => match lookup_array_fold(name) {\n                Some(t) => Some(t),\n                None => match lookup_array_filter(name) {\n                  Some(t) => Some(t),\n                  None => match lookup_array_foreach(name) {\n                    Some(t) => Some(t),\n                    None => match lookup_array_reverse(name) {\n                      Some(t) => Some(t),\n                      None => match lookup_array_any(name) {\n                        Some(t) => Some(t),\n                        None => match lookup_array_find(name) {\n                          Some(t) => Some(t),\n                          None => match lookup_array_sort(name) {\n                            Some(t) => Some(t),\n                            None => match lookup_array_contains(name) {\n                              Some(t) => Some(t),\n                              None => lookup_array_join(name)\n                            }\n                          }\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}\n\nexport let lookup_array: (String) -> Option[Type] = (name) -> {\n  match lookup_array_group_a(name) {\n    Some(t) => Some(t),\n    None => lookup_array_group_b(name)\n  }\n}\n")
