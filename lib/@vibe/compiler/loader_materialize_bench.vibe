//# Imports

import ./loader_hotspot_probe.vibe {
  load_loader_hotspot_fixture,
  load_loader_hotspot_indexed_fixture,
  probe_loader_manifest_groups_indexed_encoded_with_source_index,
  probe_loader_manifest_groups_linear_encoded,
  probe_loader_manifest_list_filter_linear_count,
  probe_loader_manifest_list_filter_source_indexed_count
}

import @vibe/core {
  array_empty
}

import @vibe/compiler/loader {
  build_manifest_path_index, build_manifest_source_index
}

//# Misc

let empty_source_pairs: Array[(String, String)] = array_empty()
let empty_paths: Array[String] = array_empty()
let empty_source_index = build_manifest_source_index(empty_source_pairs)
let empty_path_index = build_manifest_path_index(empty_paths)

let cache_base_dir: Array[String] = [
  ""
]
let cache_manifest_rows: Array[Array[(String, String)]] = [
  empty_source_pairs
]
let cache_preloaded_sources: Array[Array[(String, String)]] = [
  empty_source_pairs
]
let cache_needed_sources: Array[Array[(String, String)]] = [
  empty_source_pairs
]
let cache_needed_paths: Array[Array[String]] = [
  empty_paths
]

let cache_indexed_needed_paths: Array[Array[String]] = [
  empty_paths
]
let cache_preloaded_source_index: Array[Map[String, String]] = [
  empty_source_index
]
let cache_needed_source_index: Array[Map[String, String]] = [
  empty_source_index
]
let _cache_needed_path_index: Array[Map[String, Bool]] = [
  empty_path_index
]

fn bench_setup() -> Int with Error + Fs {
  let (base_dir, manifest_rows, preloaded_sources, needed_sources, needed_paths) = load_loader_hotspot_fixture()
  cache_base_dir[0] = base_dir
  cache_manifest_rows[0] = manifest_rows
  cache_preloaded_sources[0] = preloaded_sources
  cache_needed_sources[0] = needed_sources
  cache_needed_paths[0] = needed_paths
  let (_indexed_base_dir, _indexed_manifest_rows, _indexed_preloaded_sources, _indexed_needed_sources, indexed_needed_paths, preloaded_source_index, needed_path_index, needed_source_index) = load_loader_hotspot_indexed_fixture()
  cache_indexed_needed_paths[0] = indexed_needed_paths
  cache_preloaded_source_index[0] = preloaded_source_index
  _cache_needed_path_index[0] = needed_path_index
  cache_needed_source_index[0] = needed_source_index
  0
}

bench "loader_manifest_list_filter_linear" {
  let _ = probe_loader_manifest_list_filter_linear_count(cache_preloaded_sources[0], cache_needed_paths[0])
}

bench "loader_manifest_list_filter_indexed" {
  let _ = probe_loader_manifest_list_filter_source_indexed_count(cache_indexed_needed_paths[0], cache_preloaded_source_index[0])
}

bench "loader_manifest_groups_linear" {
  let _ = probe_loader_manifest_groups_linear_encoded(cache_base_dir[0], cache_manifest_rows[0], cache_needed_sources[0])
}

bench "loader_manifest_groups_indexed" {
  let _ = probe_loader_manifest_groups_indexed_encoded_with_source_index(cache_base_dir[0], cache_manifest_rows[0], cache_needed_source_index[0])
}
