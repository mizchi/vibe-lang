//# Imports

import ./coverage_suite_lib.vibe {
  CoverageCaseInput, build_suite_report_from_json_texts, build_summary_text, evaluate_kpi, parse_line_list, write_suite_report_json_stream
}

//# Functions

export let parse_line_list_export: (String) -> Array[String] = parse_line_list

/// #776 (fixed by #841): `Double::parse` is now a real checker/codegen
/// builtin (codegen/common_base/double_parse_expr.vibe), but it doesn't
/// support scientific notation and this file predates the fix -- kept as a
/// local parser rather than switched over, since this test's rate thresholds
/// (VIBE_SUITE_MIN_*_RATE) are always plain non-negative decimals ("20",
/// "97", "7.5", ...) and a scientific-notation-capable parser
/// (lib/@vibex/wasm/wat_encoder/wat_encoder.vibe's `parse_decimal_double`)
/// isn't needed here either way.
fn cov_run_is_digit(c: Int) -> Bool {
  c >= 48 && c <= 57
}

fn parse_rate_double(s: String) -> Option[Double] {
  let len = String::length(s)
  if len == 0 {
    None
  } else {
    let mut i = 0
    let mut neg = false
    let c0 = String::char_code_at(s, 0)
    if c0 == 45 {
      neg = true
      i = 1
    } else if c0 == 43 {
      i = 1
    }
    let mut mantissa = 0
    let mut frac_digits = 0
    let mut seen_dot = false
    let mut seen_digit = false
    let mut ok = true
    let mut j = i
    while j < len {
      let c = String::char_code_at(s, j)
      if cov_run_is_digit(c) {
        mantissa = mantissa * 10 + (c - 48)
        if seen_dot {
          frac_digits = frac_digits + 1
        }
        seen_digit = true
      } else if c == 46 && !seen_dot {
        seen_dot = true
      } else {
        ok = false
      }
      j = j + 1
    }
    if ok && seen_digit {
      let mut divisor = 1.0
      let mut k = 0
      while k < frac_digits {
        divisor = divisor * 10.0
        k = k + 1
      }
      let value = Int::to_double(mantissa) / divisor
      Some(if neg {
        0.0 - value
      } else {
        value
      })
    } else {
      None
    }
  }
}

//# Misc

test "coverage suite run" {
  let list_env = Env::get("VIBE_SUITE_REPORT_LIST")
  let list_path = String::trim(if String::length(list_env) == 0 {
    ""
  } else {
    list_env
  })
  if String::length(list_path) == 0 {
    assert(false)
  }
  let rjp_env = Env::get("VIBE_SUITE_REPORT_JSON")
  let report_json_path = String::trim(if String::length(rjp_env) == 0 {
    ""
  } else {
    rjp_env
  })
  let sp_env = Env::get("VIBE_SUITE_SUMMARY")
  let summary_path = String::trim(if String::length(sp_env) == 0 {
    ""
  } else {
    sp_env
  })
  let report_paths = parse_line_list(Fs::read_file(list_path))
  if Array::length(report_paths) == 0 {
    assert(false)
  }
  let min_point_rate = parse_rate_double(String::trim(Env::get("VIBE_SUITE_MIN_POINT_RATE")))
  let min_line_rate = parse_rate_double(String::trim(Env::get("VIBE_SUITE_MIN_LINE_RATE")))
  let min_branch_rate = parse_rate_double(String::trim(Env::get("VIBE_SUITE_MIN_BRANCH_RATE")))
  let b = ArrayBuilder::new()
  let mut idx = 0
  while idx < Array::length(report_paths) {
    let report_path = Array::get(report_paths, idx)
    ArrayBuilder::push(b, CoverageCaseInput::{
      report_path: report_path,
      report_json: Fs::read_file(report_path)
    })
    idx = idx + 1
  }
  let inputs = ArrayBuilder::freeze(b)
  let report = build_suite_report_from_json_texts(inputs)
  let kpi = evaluate_kpi(report, min_point_rate, min_line_rate, min_branch_rate)
  let summary = build_summary_text(report, kpi)
  if String::length(report_json_path) > 0 {
    // #769: Fs::open_write/close_write were never real builtins (this call
    // site never actually ran) — write_suite_report_json_stream now builds
    // the JSON via StringBuilder and returns it as a String.
    Fs::write_file(report_json_path, write_suite_report_json_stream(report, kpi))
  }
  if String::length(summary_path) > 0 {
    Fs::write_file(summary_path, summary)
  }
  Fs::write_file("/tmp/vibe_coverage_summary.txt", summary)
  assert(kpi.ok)
}
