//# Types

export enum CheckError {
  CEUnboundVar(String);
  CETypeMismatch(String, String);
  CEArityMismatch(String, Int, Int);
  CENotCallable(String);
  CEUnknownField(String, String);
  CEUnknownCtor(String);
  CEDuplicateDecl(String)
}

//# Functions

export fn add_error(errors: Array[CheckError], err: CheckError) -> Unit {
  Array::push(errors, err)
}

export fn has_errors(errors: Array[CheckError]) -> Bool {
  Array::length(errors) > 0
}

export fn new_errors() -> Array[CheckError] {
  Array::slice([
    CEUnboundVar("")
  ], 0, 0)
}

export fn check_error_to_string(err: CheckError) -> String {
  match err {
    CEUnboundVar(name) => String::concat("unbound variable: ", name),
    CETypeMismatch(expected, got) => String::concat(
      "type mismatch: expected ",
      String::concat(expected, String::concat(", got ", got))
    ),
    CEArityMismatch(name, expected, got) => String::concat(
      "arity mismatch: ",
      String::concat(
        name,
        String::concat(
          " expects ",
          String::concat(
            __to_string(expected),
            String::concat(" args, got ", __to_string(got))
          )
        )
      )
    ),
    CENotCallable(expr) => String::concat("not callable: ", expr),
    CEUnknownField(ty, field) => String::concat(
      "unknown field ",
      String::concat(field, String::concat(" on ", ty))
    ),
    CEUnknownCtor(name) => String::concat("unknown constructor: ", name),
    CEDuplicateDecl(name) => String::concat("duplicate declaration: ", name)
  }
}

export fn format_errors(errors: Array[CheckError]) -> String {
  let len = Array::length(errors)
  if len == 0 {
    ""
  } else {
    // O(N) via StringBuilder; previously `msg = concat(msg, ...)` over
    // N errors was O(N²).
    let buf = StringBuilder::new()
    let mut i = 0
    while i < len {
      if i > 0 {
        StringBuilder::push(buf, "\n")
      }
      StringBuilder::push(buf, check_error_to_string(Array::get(errors, i)))
      i = i + 1
    }
    let msg = StringBuilder::freeze(buf)
    msg
  }
}
