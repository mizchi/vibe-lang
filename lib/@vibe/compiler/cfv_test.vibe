//# Imports

import @vibe/compiler/core {
  Expr, Pat
}

import @vibe/core {
  array_empty
}

import @vibe/compiler/codegen/common_analysis {
  collect_free_vars
}

//# Misc

test "collect_free_vars with tuple pattern" {
  let body = EMatch(ECall(EIdent("foo", -1), array_empty(), -1), [
    (PTuple([PBind("a"), PBind("b")]), EBinOp("+", EIdent("a", -1), EIdent("b", -1)))
  ])
  let fv = collect_free_vars(body, array_empty(), ["foo"])
  if Array::length(fv) != 0 {
    throw("expected 0 free vars")
  }
  0
}
