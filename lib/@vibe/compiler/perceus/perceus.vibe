//# Imports

import @vibe/compiler/codegen/common_analysis {
  collect_free_vars
}

import @vibe/core {
  array_empty
}

import @vibe/compiler/core {
  Expr, Pat, Stmt, TypeExpr, bsearch_leftmost, is_exception_throw_operation
}

//# Types

export enum PerceusActionKind {
  PaDup;
  PaDrop;
  // A `dup` attributed to an *alias* binding `let a = t`: the source `t` is
  // used in more than one owning position, so this alias takes a duplicated
  // reference. Keyed by the ALIAS name `a` (not the source), which makes it
  // occurrence-precise without tree-order bookkeeping: the codegen dups the
  // source exactly at `let a = …`. (docs/spec/selfhost-rc-port.md)
  PaAliasDup
}

// PerceusAction is defined transparently in this package's contract
// (index.vpkg): its field layout (.kind/.name) is real public API surface
// read directly by tests/perceus_rc_test.vibe. Struct record literals and
// field access resolve fine from impl units against the facade definition
// (@vibe/process ShResult precedent, PR #920), so no local def is kept.

struct PCtx {
  mut next_id: Int;
  mut seq_id: Int;
  pctx_names: Array[String];
  // ADR-0092 borrow-inference: whole-program set of user fns with at least
  // one borrowed parameter (compute_borrow_param_user_fns,
  // common_analysis.vibe), sorted. Same COPY discipline as pctx_names -- see
  // pctx_new's doc comment.
  borrow_param_user: Array[String];
  // Aligned to borrow_param_user: bit i of entry k says parameter i of
  // borrow_param_user[k] is borrowed. One bsearch on the names indexes
  // straight into this. Same COPY discipline.
  borrow_param_mask: Array[Int];
  // User fns whose RETURN may be an unowned interior view
  // (compute_may_return_view_fns; NOT intersected with borrow_param_user --
  // see the linked_compile gate comment for why that intersection was a
  // latent over-release). Only
  // calls to THESE mark view_call_let: suppressing the scope-end drop for a
  // fresh-returning callee's binding leaks its result (compiler-gate RC
  // reclamation guard), while a view-returning callee's binding must not
  // release a reference it never acquired. Same COPY discipline.
  view_ret_user: Array[String];
  uses: Array[Int];
  borrows: Array[Int];
  scalar: Array[Bool];
  remaining: Array[Int];
  // True for a let-binding whose VALUE is a call to a borrow-arg0 fn (user
  // set or builtin list) -- the class whose result may be an unowned
  // interior view. With the borrow set empty this is never set, so the fix
  // is inert while lc_borrow_arg0_enabled is off.
  view_call_let: Array[Bool];
  actions: Array[PerceusAction]
}

struct HeapInferCtx {
  ctors: Array[String];
  heap_fns: Array[String]
}

//# Functions

fn zeros(n: Int) -> Array[Int] {
  let out: Array[Int] = [
  ]
  let mut i = 0
  while i < n {
    Array::push(out, 0)
    i = i + 1
  }
  out
}

fn int_max(a: Int, b: Int) -> Int {
  if a > b {
    a
  } else {
    b
  }
}

fn name_in(arr: Array[String], s: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(arr) {
    if Array::get(arr, i) == s {
      found = true
    } else {
      ()
    }
    i = i + 1
  }
  found
}

fn pe_push(ctx: PCtx, kind: PerceusActionKind, name: String) -> Int {
  Array::push(ctx.actions, PerceusAction::{
    kind: kind, name: name
  })
  0
}

fn pe_use(ctx: PCtx, scope: Map[String, Int], name: String) -> Int {
  if Map::has_key(scope, name) {
    let id = Map::get(scope, name)
    let rem = Array::get(ctx.remaining, id)
    // ADR-0092 per-use pairing: a view-call binding holds NO initial owned
    // reference (its value may be an unowned interior view), so its LAST
    // owned use must also dup -- the standard rem == 1 "spend the initial
    // ref" transfer would consume a reference the binding never acquired.
    let last_view_use = rem == 1 && Array::get(ctx.view_call_let, id)
    if (rem > 1 || last_view_use) && !Array::get(ctx.scalar, id) {
      pe_push(ctx, PaDup, name)
    } else {
      0
    }
    if rem > 0 {
      Array::set(ctx.remaining, id, rem - 1)
    }
  }
  0
}

/// `borrow_ret_names` is the whole-program borrow-returning-function-name set
/// (see is_borrow_ret_fname), computed ONCE per compile and identical across
/// every function's plan build. COPIED (not aliased) so PCtx solely owns
/// `pctx_names`: the caller's array reaches here through a borrowed struct
/// field read (CompileCtx.borrow_ret_names, see compile_lambda.vibe), so
/// storing it directly would let PCtx's structural drop decrement a refcount
/// this plan never owned -- the #707/#715 double-free shape. One
/// Array::slice is a single allocation + memory.copy of the name pointers.
fn pctx_new(borrow_ret_names: Array[String], borrow_param_fns: Array[String], borrow_param_masks: Array[Int], view_ret_fns: Array[String]) -> PCtx {
  PCtx::{
    next_id: 0,
    seq_id: 0,
    pctx_names: Array::slice(borrow_ret_names, 0, Array::length(borrow_ret_names)),
    borrow_param_user: Array::slice(borrow_param_fns, 0, Array::length(borrow_param_fns)),
    borrow_param_mask: Array::slice(borrow_param_masks, 0, Array::length(borrow_param_masks)),
    view_ret_user: Array::slice(view_ret_fns, 0, Array::length(view_ret_fns)),
    uses: [
    ],
    borrows: [
    ],
    scalar: [
    ],
    remaining: [
    ],
    view_call_let: [
    ],
    actions: [
    ],
  }
}

/// Perf: this snapshot runs in every branch/match arm of the perceus plan --
/// the push-per-element version was the single largest __rt_arr_push caller in
/// a full-closure compile profile (253ms of 439ms). Array::slice is one
/// allocation + one memory.copy and yields an equally independent buffer.
fn copy_ints(src: Array[Int]) -> Array[Int] {
  Array::slice(src, 0, Array::length(src))
}

export fn pa_is_dup(a: PerceusAction) -> Bool {
  match a.kind {
    PaDup => true,
    PaDrop => false,
    PaAliasDup => false
  }
}

fn pat_names(pat: Pat, out: Array[String]) -> Int {
  match pat {
    PBind(name) => {
      Array::push(out, name)
      0
    },
    PCtor(_n, args) => {
      let mut i = 0
      while i < Array::length(args) {
        pat_names(Array::get(args, i), out)
        i = i + 1
      }
      0
    },
    PTuple(pats) => {
      let mut i = 0
      while i < Array::length(pats) {
        pat_names(Array::get(pats, i), out)
        i = i + 1
      }
      0
    },
    POr(l, _r) => pat_names(l, out),
    PStruct(_n, fields) => {
      let mut i = 0
      while i < Array::length(fields) {
        pat_names((Array::get(fields, i)).1, out)
        i = i + 1
      }
      0
    },
    _ => 0
  }
}

export fn pa_is_drop(a: PerceusAction) -> Bool {
  match a.kind {
    PaDrop => true,
    PaDup => false,
    PaAliasDup => false
  }
}

fn pc_declare(ctx: PCtx, _name: String, scalar: Bool) -> Int {
  let id = ctx.next_id
  Array::push(ctx.uses, 0)
  Array::push(ctx.borrows, 0)
  Array::push(ctx.scalar, scalar)
  Array::push(ctx.view_call_let, false)
  ctx.next_id = id + 1
  id
}

/// ADR-0092 per-use pairing: mark `id` as a view-call let-binding when its
/// value is a call to a borrow-arg0 fn that may RETURN an unowned view
/// (see PCtx.view_ret_user -- fresh-returning borrow-arg0 callees must
/// keep their binding's scope-end drop or the result leaks). A local that
/// shadows a view-ret name is an ordinary owned closure call (#875).
fn pctx_mark_view_call(ctx: PCtx, scope: Map[String, Int], id: Int, value: Expr) -> Int {
  match value {
    ECall(vc, _, _) => match vc {
      EIdent(vf, _) => if !Map::has_key(scope, vf) && bsearch_leftmost(ctx.view_ret_user, vf) >= 0 {
        Array::set(ctx.view_call_let, id, true)
      } else {
        ()
      },
      _ => ()
    },
    _ => ()
  }
  0
}

fn pe_declare(ctx: PCtx, _name: String) -> Int {
  let id = ctx.next_id
  let owning = Array::get(ctx.uses, id)
  let init = if owning == 0 {
    1
  } else {
    owning
  }
  Array::push(ctx.remaining, init)
  ctx.next_id = id + 1
  id
}

fn pc_count_use(ctx: PCtx, scope: Map[String, Int], name: String) -> Int {
  if Map::has_key(scope, name) {
    let id = Map::get(scope, name)
    Array::set(ctx.uses, id, Array::get(ctx.uses, id) + 1)
  }
  0
}

fn pe_scope_end(ctx: PCtx, id: Int, name: String) -> Int {
  if Array::get(ctx.remaining, id) > 0 && !Array::get(ctx.scalar, id) {
    // ADR-0092 per-use pairing: the scope-end drop releases the binding's
    // INITIAL owned reference. A view-call binding never held one (its
    // value may be an unowned interior view), so the drop over-releases
    // REGARDLESS of how the binding was used -- with owned uses the last
    // use spends the phantom initial ref, with none the retention-driven
    // remaining spends it here (both trapped codegen_heap_e2e_test under
    // the borrowed-arg0 ABI). Suppress unconditionally for the class; a
    // fresh-owned value from a may-return-view callee then leaks (bounded,
    // safe direction). pe_use pairs with this by dup-ing a view binding's
    // last owned use. Params are never in the class (view_call_let is set
    // only from let/seq values).
    if Array::get(ctx.view_call_let, id) {
      ()
    } else {
      pe_push(ctx, PaDrop, name)
    }
    Array::set(ctx.remaining, id, 0)
  }
  0
}

fn next_seq_name(ctx: PCtx) -> String {
  let nm = "__seq" + __to_string(ctx.seq_id)
  ctx.seq_id = ctx.seq_id + 1
  nm
}

fn fn_param_names(params: Array[(String, Option[TypeExpr])]) -> Array[String] {
  let out: Array[String] = [
  ]
  let mut i = 0
  while i < Array::length(params) {
    Array::push(out, (Array::get(params, i)).0)
    i = i + 1
  }
  out
}

fn is_v128_box_call(fname: String) -> Bool {
  fname == "v128_load" || fname == "v128_splat_i8x16" || fname == "v128_eq_i8x16" || fname == "v128_le_u_i8x16" || fname == "v128_ge_u_i8x16" || fname == "v128_and" || fname == "v128_or" || fname == "v128_not"
}

fn array_contains_str_pctx(arr: Array[String], s: String) -> Bool {
  // #1100: early-exit — this membership scan is one of the plan's hottest
  // loops and used to keep scanning the whole array after a hit.
  let n = Array::length(arr)
  let mut i = 0
  let mut found = false
  while !found && i < n {
    if Array::get(arr, i) == s {
      found = true
    } else {
      i = i + 1
    }
  }
  found
}

/// #707: is `fname` a call whose return value is a BORROWED VIEW sharing a
/// call argument's refcount, rather than a fresh owned reference -- either one
/// of the 3 builtins that read an element in place, or a user function whose
/// own body is (transitively) nothing but a tail-call to one of those (see
/// compute_borrow_returning_names). Bindings holding such a value must never
/// be dup/drop'd themselves: the compiler-self-hosted-under-RC crash (#707)
/// was exactly this -- `let peek = (toks, pos) -> Array::get(toks, pos)` was
/// NOT recognized as borrow-returning (only a literal `Array::get` callee
/// was), so `let __m_scrut = peek(toks, pos) in match __m_scrut { ... }`
/// (the match-scrutinee-lift's desugaring, see normalize/index.vibe
/// lift_match_scrutinees) planned a drop for `__m_scrut` as if it independently
/// owned a reference -- double-freeing the array element peek merely borrowed.
///
/// #1237 perf: `ctx.pctx_names` holds exactly the whole-program
/// borrow-returning-name set (see pctx_new). A genuine dedicated PCtx field
/// for that set was tried once and hit an unexplained "memory access out of
/// bounds" reading it back specifically when the whole compiler self-compiles
/// under RC (see #707), so pctx_names remains the known-safe field to read it
/// from. What changed is that pc_declare used to ALSO append every declared
/// binding name to this same array, so the set had to be stored with a
/// control-char prefix to stay distinguishable -- making each lookup here pay
/// a String::concat and, on a miss (the common case), rescan every binding
/// declared so far in the current function. pc_declare no longer touches
/// pctx_names, so the names sit here unprefixed and a miss costs only the
/// fixed set.
fn is_borrow_ret_fname(ctx: PCtx, fname: String) -> Bool {
  fname == "Array::get" || fname == "Map::get" || fname == "__index" || fname == "__rec_field" || bsearch_leftmost(ctx.pctx_names, fname) >= 0
}

/// #707: fixed-point closure over top-level function definitions, starting
/// from the 3 borrow-returning builtins: a function whose entire body is
/// (after stripping let/seq/assign wrappers) a single tail-call to an
/// already-known borrow-returning name is itself borrow-returning. Handles
/// arbitrarily deep wrapper chains (`peek` -> `Array::get`,
/// `peek2` -> `peek` -> `Array::get`, ...). Computed once over the whole
/// merged program (see linked_compile.vibe) and threaded into every
/// function's Perceus plan via build_perceus_plan_with_params.
/// #707: does every value `e` can tail-produce come from a known
/// borrow-returning name, or a "safe to never drop" fallback? Recurses through
/// let/seq/assign wrappers and BOTH sides of if/match (a bare tail call alone
/// missed `peek`'s actual shape: `if pos < len { Array::get(tokens, pos) }
/// else TEof` -- a bounds-check guard around the real access, with a bare
/// nullary-ctor-ish identifier as the out-of-range fallback). A bare EIdent
/// tail (e.g. a sentinel like TEof) is accepted as safe even though it isn't
/// proven borrow-returning: marking its binding "never dup/drop" can at worst
/// leak that one value (the existing runtime dup/drop guards already no-op on
/// non-heap-tagged values), never corrupt -- the failure mode this whole fix
/// targets is a double-free from treating a genuinely-borrowed value as owned,
/// not a leak from treating a small/rare owned value as borrowed.
/// Iterative (NOT self-recursive) worklist walk over child expressions, rather
/// than a `let rec` recursive-descent function. Also: the `ECall` case matches
/// its callee via a NESTED constructor pattern one step at a time (`ECall(e,
/// _, _)` then a separate `match e { EIdent(callee, _) => ... }`), never
/// `ECall(EIdent(callee, _), _, _)` in one pattern. Both of these are
/// load-bearing workarounds, not style: a `let rec` self-recursive version of
/// this walk, AND a single-arm version using the nested `ECall(EIdent(...),
/// _, _)` pattern, each independently reproduce a "memory access out of
/// bounds" trap (reproducible under bump too -- not RC-specific) that is only
/// exposed when this function runs over a derive(Ord)-generated `T::compare`
/// body (a chain of `EIf(cmp, EInt(-1/1), ...)` with no further wrapper/call
/// -- e.g. `struct P { x: Int; y: Int } derive(Ord)`). An equivalent shape
/// recursing into an `Array::get` call / `EIdent` sentinel branch (`peek`'s
/// actual body) does not crash either broken variant, and the crash persists
/// even when the offending match arm is never reached at runtime for the
/// crashing input -- so this is a codegen bug in this compiler triggered by
/// those two source *shapes*, not a logic bug in this function's checks.
/// True root cause not isolated; swap either workaround for the "more natural"
/// form only after confirming compute_borrow_returning_names_test.vibe (or an
/// equivalent derive(Ord) regression) still passes.
fn tail_is_borrow_ret_safe(known: Array[String], e0: Expr) -> Bool {
  let worklist = [
    e0
  ]
  let mut all_safe = true
  let mut i = 0
  while i < Array::length(worklist) {
    match Array::get(worklist, i) {
      ELet(_, _, b, _) => Array::push(worklist, b),
      ELetMut(_, _, b, _) => Array::push(worklist, b),
      ELetRec(_, _, b) => Array::push(worklist, b),
      ESeq(_, b) => Array::push(worklist, b),
      EAssign(_, _, b) => Array::push(worklist, b),
      EAssignOp(_, _, _, b) => Array::push(worklist, b),
      EIf(_, t, el) => {
        Array::push(worklist, t)
        Array::push(worklist, el)
      },
      EMatch(_, arms) => {
        let mut ai = 0
        while ai < Array::length(arms) {
          let (_p, ae) = Array::get(arms, ai)
          Array::push(worklist, ae)
          ai = ai + 1
        }
      },
      ECall(callee_e, cargs, _) =>
      match callee_e {
        EIdent(callee, _) =>
        if callee == "perform" && Array::length(cargs) == 1 {
          // #640 Stage 2: `throw(x)` now parses to `perform Exception::Throw(x)`,
          // so the #715 throwing-tail exemption below (EThrow) must also
          // recognize this shape — a throwing tail never produces a value, so
          // it cannot violate the borrow-returning invariant. Without this,
          // every `match x { Ctor(..) => field, _ => throw(..) }` accessor is
          // again rejected as borrow-returning and the #715 same-address
          // double-free returns. Matched step-by-step (NOT one nested
          // ECall(EIdent(..)) pattern) per the workaround note above.
          let mut op_is_throw = false
          match Array::get(cargs, 0) {
            ECall(op_e, _, _) =>
            match op_e {
              EIdent(op_n, _) => if is_exception_throw_operation(op_n) {
                op_is_throw = true
              } else {
                ()
              },
              _ => ()
            },
            _ => ()
          }
          if op_is_throw {
            ()
          } else if !array_contains_str_pctx(known, callee) {
            all_safe = false
          } else {
            ()
          }
        } else if !array_contains_str_pctx(known, callee) {
          all_safe = false
        } else {
          ()
        },
        _ => {
          all_safe = false
        }
      },
      EIdent(_, _) => (),
      // #715: a throwing tail (the ubiquitous `match x { Ctor(..) => field, _
      // => throw("not X") }` shape used by every common_extractors.vibe
      // accessor) never actually produces a value along that path, so it
      // cannot violate the borrow-returning invariant -- there is nothing to
      // mismanage. Without this, EVERY such accessor (get_efn_params,
      // get_efn_body, get_ecall_args, ...) fell through to the catch-all
      // below and was rejected solely because of its own error arm, even
      // though its real (non-throwing) arm is a plain borrowed field
      // projection. That misclassification made the caller treat the
      // extracted field as an independently owned value while the
      // scrutinee's own later structural drop also reclaims it -- a
      // same-address double-free (the #715 self-hosting free-list
      // corruption).
      _ => {
        all_safe = false
      }
    }
    i = i + 1
  }
  all_safe
}

/// Strip let/seq/assign wrappers, same as tail_is_borrow_ret_safe, to find the
/// expression whose SHAPE decides eligibility at the top level.
fn strip_wrappers_for_borrow_ret(e: Expr) -> Expr {
  match e {
    ELet(_, _, b, _) => strip_wrappers_for_borrow_ret(b),
    ELetMut(_, _, b, _) => strip_wrappers_for_borrow_ret(b),
    ELetRec(_, _, b) => strip_wrappers_for_borrow_ret(b),
    ESeq(_, b) => strip_wrappers_for_borrow_ret(b),
    EAssign(_, _, b) => strip_wrappers_for_borrow_ret(b),
    EAssignOp(_, _, _, b) => strip_wrappers_for_borrow_ret(b),
    _ => e
  }
}

export fn compute_borrow_returning_names(stmts: Array[Stmt]) -> Array[String] {
  let known: Array[String] = [
    "Array::get",
    "Map::get",
    "__index",
    "__rec_field"
  ]
  let mut changed = true
  while changed {
    changed = false
    let mut i = 0
    while i < Array::length(stmts) {
      match Array::get(stmts, i) {
        SLet(_, _, name, _, value) =>
        if !array_contains_str_pctx(known, name) {
          match value {
            EFn(_, _, _, _, _, body) => {
              // A function is borrow-returning only if its (wrapper-stripped)
              // top-level shape is itself a call/if/match reaching a known
              // borrow-return name on every branch -- a BARE identifier tail
              // at the *top level* (an identity-like function) is NOT eligible
              // here even though tail_is_borrow_ret_safe accepts a bare ident
              // as a safe fallback *inside* an if/match branch (e.g. peek's
              // `else TEof`). This keeps `let f = (x) -> T { x }` (a genuine
              // passthrough of a normally-owned argument) from being
              // misclassified as a Array::get-style borrowed view.
              let top = strip_wrappers_for_borrow_ret(body)
              let eligible_shape = match top {
                ECall(_, _, _) => true,
                EIf(_, _, _) => true,
                EMatch(_, _) => true,
                _ => false
              }
              if eligible_shape && tail_is_borrow_ret_safe(known, top) {
                Array::push(known, name)
                changed = true
              } else {
                ()
              }
            },
            _ => ()
          }
        } else {
          ()
        },
        _ => ()
      }
      i = i + 1
    }
  }
  known
}

/// A top-level function's declared return type, from its `let f: (T1,...) ->
/// R = ...` signature -- `None` when untyped (no signature to consult).
fn fn_sig_return_type(ty: Option[TypeExpr]) -> Option[TypeExpr] {
  match ty {
    Some(t) =>
    match t {
      TyFn(_, ret, _) => Some(ret),
      _ => None
    },
    None => None
  }
}

/// #710 out-param crash: `let n = f(...)` for a user function `f` whose body
/// is not one of the 3 hardcoded borrow-returning builtins falls through to
/// `heap_binding_names`'s default -- "any non-borrow-ret call result is heap"
/// (compile_expr_tail.vibe's ELet ECall branch; see that struct field's own
/// doc comment, which already promises "we never touch a non-heap (e.g.
/// Int-returning call) binding"). When `f` actually returns a scalar (Int/
/// Bool/Unit) -- e.g. `build_import_plan(...) -> Int` -- the binding is a
/// plain integer, not a tagged heap pointer. If that binding is later
/// ALIASED more than once (`let a = n; let b = n`), the Perceus plan schedules
/// a PaAliasDup for the 2nd+ alias, and compile_expr_tail.vibe's `is_eident`
/// branch used to call the unguarded `emit_rc_dup_local` on it: untag (AND -2)
/// then read/write 4 bytes before the "pointer". For a small scalar like 0
/// that computes a near-null address -- `RuntimeError: memory access out of
/// bounds`, not a leak (component_codegen_test.vibe's "component async: sync
/// lift" hit this via `import_func_count` aliased into run_core_func_idx/
/// run_type_idx/run_func_idx). That call site now uses the runtime-tag-checked
/// `emit_rc_dup_guarded` instead (a misclassified scalar is a silent no-op
/// there rather than a wild write) -- this was the one remaining unguarded RC
/// increment anywhere in codegen, so it is now fixed on general principle even
/// though it was empirically NOT the cause of the *other* still-open #709
/// self-hosting crash (a free-list node with corrupted size/next fields,
/// surfacing later inside `fn_type_param_types`'s `vibe_rc_alloc`; confirmed via a
/// differential rebuild that the crash persists byte-for-byte unchanged with
/// this fix in place). Names collected here still matter for perf/precision
/// (avoiding unnecessary heap_binding_names churn) and let the ELet ECall
/// branch skip `heap_binding_names` for a call whose declared return type is
/// provably scalar, matching the exemption the field's own doc comment already
/// describes. Untyped functions are conservatively left out (stay in the
/// existing heap over-approximation) since there is no signature to consult --
/// no longer a correctness cliff-edge now that the alias-dup site is guarded,
/// only a missed optimization.
export fn compute_scalar_returning_names(stmts: Array[Stmt]) -> Array[String] {
  let out: Array[String] = [
  ]
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SLet(_, _, name, ty, value) =>
      match value {
        EFn(_, _, _, _, _, _) =>
        match fn_sig_return_type(ty) {
          Some(ret) =>
          if !type_expr_is_heap(Some(ret)) {
            Array::push(out, name)
          } else {
            ()
          },
          None => ()
        },
        _ => ()
      },
      _ => ()
    }
    i = i + 1
  }
  out
}

fn is_scalar_expr(ctx: PCtx, e: Expr) -> Bool {
  match e {
    EInt(_) => true,
    EBool(_) => true,
    EFloat(_) => true,
    EUnit => true,
    // #705: v128_load/splat/binary-op/not return a tagged pointer to a 16-byte
    // box with NO rc header (type_id/refcount) -- see compile_call.vibe. The
    // tag makes it look like a heap pointer to the runtime dup/drop guards
    // (odd low bit), so planning a PaDup/PaDrop for a binding holding one would
    // make those guards misread the v128 payload bytes as a refcount and
    // corrupt it (or an adjacent allocation). Treat the binding as scalar
    // (never dup/drop'd), matching the box's actual bump-only, never-freed
    // lifetime under both backends.
    ECall(EIdent(fname, _), _, _) => is_v128_box_call(fname) || is_borrow_ret_fname(ctx, fname),
    _ => false
  }
}

fn pat_shadow_env(pat: Pat, env: Map[String, Bool]) -> Map[String, Bool] {
  let names: Array[String] = [
  ]
  pat_names(pat, names)
  let mut env2 = env
  let mut j = 0
  while j < Array::length(names) {
    env2 = Map::set(env2, Array::get(names, j), false)
    j = j + 1
  }
  env2
}

fn restore_prefix(dst: Array[Int], src: Array[Int]) -> Int {
  let mut i = 0
  while i < Array::length(src) {
    Array::set(dst, i, Array::get(src, i))
    i = i + 1
  }
  0
}

fn is_heap_literal(e: Expr) -> Bool {
  match e {
    ETuple(_) => true,
    EArray(_) => true,
    ERecord(_, _, _) => true,
    _ => false
  }
}

fn is_heap_value(e: Expr, env: Map[String, Bool], hctx: HeapInferCtx) -> Bool {
  if is_heap_literal(e) {
    true
  } else {
    match e {
      ECall(callee, args, _) =>
      match callee {
        EIdent(c, _) =>
        if Map::has_key(env, c) {
          false
        } else {
          (Array::length(args) > 0 && name_in(hctx.ctors, c)) ||
          name_in(hctx.heap_fns, c)
        },
        _ => false
      },
      _ => false
    }
  }
}

fn arg_class(arg: Expr, env: Map[String, Bool], hctx: HeapInferCtx) -> Bool {
  if is_heap_value(arg, env, hctx) {
    true
  } else {
    match arg {
      EIdent(n, _) => if Map::has_key(env, n) {
        Map::get(env, n)
      } else {
        false
      },
      _ => false
    }
  }
}

fn analyze_calls(name: String, e_in: Expr, env_in: Map[String, Bool], calls: Array[Array[Bool]], esc: Array[Bool], hctx: HeapInferCtx) -> Int {
  // #556: iterate the let / seq / assign "spine" instead of recursing on its
  // tail, so a deeply-nested (flattened) expression — e.g. the whole compiler
  // compiled as a single unit under RC — no longer exhausts the wasm stack in
  // this pass. The shallow side of each spine node is still analyzed
  // recursively; the visit order and env threading are identical to the former
  // pure recursion (fixpoint-verified), so the RC analysis result is unchanged.
  let mut e = e_in
  let mut env = env_in
  let mut looping = true
  while looping {
    looping = false
    match e {
      EIdent(n, _) => {
        if n == name {
          Array::set(esc, 0, true)
        } else {
          ()
        }
        0
      },
      ECall(callee, args, _) => {
        let is_self = match callee {
          EIdent(cn, _) => cn == name,
          _ => false
        }
        if is_self {
          let cls: Array[Bool] = [
          ]
          let mut k = 0
          while k < Array::length(args) {
            Array::push(cls, arg_class(Array::get(args, k), env, hctx))
            k = k + 1
          }
          Array::push(calls, cls)
        } else {
          let _ = analyze_calls(name, callee, env, calls, esc, hctx)
          ()
        }
        let mut i = 0
        while i < Array::length(args) {
          analyze_calls(name, Array::get(args, i), env, calls, esc, hctx)
          i = i + 1
        }
        0
      },
      EDot(obj, _, _, _) => analyze_calls(name, obj, env, calls, esc, hctx),
      ELet(n, v, b, _) => {
        analyze_calls(name, v, env, calls, esc, hctx)
        env = Map::set(env, n, is_heap_value(v, env, hctx))
        e = b
        looping = true
      },
      ELetRec(n, v, b) => {
        env = Map::set(env, n, false)
        analyze_calls(name, v, env, calls, esc, hctx)
        e = b
        looping = true
      },
      ELetMut(n, v, b, _) => {
        analyze_calls(name, v, env, calls, esc, hctx)
        env = Map::set(env, n, false)
        e = b
        looping = true
      },
      EAssign(_, v, c) => {
        analyze_calls(name, v, env, calls, esc, hctx)
        e = c
        looping = true
      },
      EAssignOp(_, _, v, c) => {
        analyze_calls(name, v, env, calls, esc, hctx)
        e = c
        looping = true
      },
      ESeq(a, b) => {
        analyze_calls(name, a, env, calls, esc, hctx)
        e = b
        looping = true
      },
      EIf(c, t, el) => {
        analyze_calls(name, c, env, calls, esc, hctx)
        analyze_calls(name, t, env, calls, esc, hctx)
        analyze_calls(name, el, env, calls, esc, hctx)
        0
      },
      EWhile(c, b) => {
        analyze_calls(name, c, env, calls, esc, hctx)
        analyze_calls(name, b, env, calls, esc, hctx)
        0
      },
      EForIn(v0, ix, it, b) => {
        analyze_calls(name, it, env, calls, esc, hctx)
        let env1 = Map::set(env, v0, false)
        let env2 = match ix {
          Some(ixn) => Map::set(env1, ixn, false),
          None => env1
        }
        analyze_calls(name, b, env2, calls, esc, hctx)
        0
      },
      EBinOp(_, l, r) => {
        analyze_calls(name, l, env, calls, esc, hctx)
        analyze_calls(name, r, env, calls, esc, hctx)
        0
      },
      EUnaryOp(_, o) => analyze_calls(name, o, env, calls, esc, hctx),
      EFn(_, _, params, _, _, b) => {
        let mut env2 = env
        let mut pi = 0
        while pi < Array::length(params) {
          let (pn, _) = Array::get(params, pi)
          env2 = Map::set(env2, pn, false)
          pi = pi + 1
        }
        analyze_calls(name, b, env2, calls, esc, hctx)
        0
      },
      ETuple(xs) => {
        let mut i = 0
        while i < Array::length(xs) {
          analyze_calls(name, Array::get(xs, i), env, calls, esc, hctx)
          i = i + 1
        }
        0
      },
      EArray(xs) => {
        let mut i = 0
        while i < Array::length(xs) {
          analyze_calls(name, Array::get(xs, i), env, calls, esc, hctx)
          i = i + 1
        }
        0
      },
      EMatch(s, arms) => {
        analyze_calls(name, s, env, calls, esc, hctx)
        let mut i = 0
        while i < Array::length(arms) {
          let (pat, ab) = Array::get(arms, i)
          analyze_calls(name, ab, pat_shadow_env(pat, env), calls, esc, hctx)
          i = i + 1
        }
        0
      },
      EHandle(b, arms) => {
        analyze_calls(name, b, env, calls, esc, hctx)
        let mut i = 0
        while i < Array::length(arms) {
          let (pat, ab) = Array::get(arms, i)
          analyze_calls(name, ab, pat_shadow_env(pat, env), calls, esc, hctx)
          i = i + 1
        }
        0
      },
      ELoop(ps, b) => {
        let mut env2 = env
        let mut i = 0
        while i < Array::length(ps) {
          let (pn, iv) = Array::get(ps, i)
          analyze_calls(name, iv, env2, calls, esc, hctx)
          env2 = Map::set(env2, pn, false)
          i = i + 1
        }
        analyze_calls(name, b, env2, calls, esc, hctx)
        0
      },
      ERecord(_, fs, _) => {
        let mut i = 0
        while i < Array::length(fs) {
          let (_, fv) = Array::get(fs, i)
          analyze_calls(name, fv, env, calls, esc, hctx)
          i = i + 1
        }
        0
      },
      EMap(fs) => {
        let mut i = 0
        while i < Array::length(fs) {
          let (_, fv) = Array::get(fs, i)
          analyze_calls(name, fv, env, calls, esc, hctx)
          i = i + 1
        }
        0
      },
      ELabeledArg(_, _, x) => analyze_calls(name, x, env, calls, esc, hctx),
      EReturn(x) => analyze_calls(name, x, env, calls, esc, hctx),
      ESpread(x) => analyze_calls(name, x, env, calls, esc, hctx),
      EBreak(o) =>
      match o {
        Some(x) => analyze_calls(name, x, env, calls, esc, hctx),
        None => 0
      },
      EContinue(xs) => {
        let mut i = 0
        while i < Array::length(xs) {
          analyze_calls(name, Array::get(xs, i), env, calls, esc, hctx)
          i = i + 1
        }
        0
      },
      EInt(_) => 0,
      EFloat(_) => 0,
      EString(_) => 0,
      EBool(_) => 0,
      EStringInterp(_) => 0,
      EUnit => 0
    }
  }
  0
}

/// An alias-attributed dup: `let a = t` where `t` is multiply-used and owned.
/// Keyed by the alias name.
export fn pa_is_alias_dup(a: PerceusAction) -> Bool {
  match a.kind {
    PaAliasDup => true,
    PaDup => false,
    PaDrop => false
  }
}

fn pc_count_borrow(ctx: PCtx, scope: Map[String, Int], name: String) -> Int {
  if Map::has_key(scope, name) {
    let id = Map::get(scope, name)
    Array::set(ctx.borrows, id, Array::get(ctx.borrows, id) + 1)
  }
  0
}

fn type_contains_fn(t: TypeExpr) -> Bool {
  match t {
    TyFn(_, _, _) => true,
    TyTuple(elems) => {
      let mut i = 0
      let mut found = false
      while i < Array::length(elems) {
        if type_contains_fn(Array::get(elems, i)) {
          found = true
        } else {
          ()
        }
        i = i + 1
      }
      found
    },
    TyApp(_, args) => {
      let mut i = 0
      let mut found = false
      while i < Array::length(args) {
        if type_contains_fn(Array::get(args, i)) {
          found = true
        } else {
          ()
        }
        i = i + 1
      }
      found
    },
    TyName(_) => false,
    TyUnit => false
  }
}

fn all_calls_heap_at(idx: Int, calls: Array[Array[Bool]]) -> Bool {
  let mut ci = 0
  let mut all_heap = true
  while ci < Array::length(calls) {
    let cls = Array::get(calls, ci)
    if idx >= Array::length(cls) {
      all_heap = false
    } else if !Array::get(cls, idx) {
      all_heap = false
    } else {
      ()
    }
    ci = ci + 1
  }
  all_heap
}

fn type_name_is_heap(n: String) -> Bool {
  if String::length(n) == 0 {
    false
  } else {
    let c0 = String::char_code_at(n, 0)
    if c0 < 'A' || c0 > 'Z' {
      false
    } else if n == "Int" || n == "Bool" || n == "Double" || n == "Float" || n == "String" || n == "Bytes" || n == "Char" || n == "Unit" || n == "V128" {
      // #705: V128 is a tagged pointer to a 16-byte box (see compile_call.vibe
      // v128_load/v128_splat_i8x16/etc), but the box has NO rc header
      // (type_id/refcount) -- it's a bare payload written directly by
      // v128.store. Treating it as heap would make Perceus emit __rc_dup /
      // vibe_rc_drop calls that misread the v128 payload bytes as a type_id and
      // refcount, corrupting the box (or freeing arbitrary memory at the
      // implied "next"/size fields). Excluding it here keeps V128 boxes exactly
      // as they behave under the bump backend: forward-only bump allocations
      // that are simply never reclaimed, not memory-unsafe ones.
      false
    } else {
      true
    }
  }
}

export fn type_expr_is_heap(ot: Option[TypeExpr]) -> Bool {
  match ot {
    None => false,
    Some(t) =>
    match t {
      // #702: a bare function-typed binding/param is a closure — heap when it
      // captures (an odd RC block), a scalar constant when it doesn't. Treating
      // it as heap lets the owning function drop it (vibe_rc_drop's odd-check makes
      // the non-capturing constant a no-op), reclaiming capturing closures passed
      // as arguments to higher-order fns instead of leaking them.
      TyFn(_, _, _) => true,
      _ =>
      if type_contains_fn(t) {
        false
      } else {
        match t {
          TyTuple(_) => true,
          TyApp(_, _) => true,
          TyName(n) => type_name_is_heap(n),
          TyFn(_, _, _) => false,
          TyUnit => false
        }
      }
    }
  }
}

/// #791: program-wide (name of every top-level function whose DECLARED return
/// type is heap), mirroring compute_agg_returning's scan but reading
/// type_expr_is_heap instead of agg_info_of_type_expr. This is the "read the
/// declared signature" alternative to threading checker-inferred types
/// through codegen: `let mut s = Set::new()` can be classified correctly by
/// looking up `Set::new`'s OWN `-> Set[T]` annotation (already sitting on the
/// AST, no unification/inference needed) instead of guessing from the RHS
/// expression's shape. Only covers named, annotated top-level functions --
/// classify_let_value_heap (compile_expr_tail.vibe) falls back to its
/// existing "any ECall is heap by default" over-approximation when a callee
/// isn't found here (unannotated function, local closure, shadowed name),
/// so this is a precision refinement, not a completeness requirement.
export fn compute_heap_returning(stmts: Array[Stmt]) -> Array[String] {
  let out: Array[String] = [
  ]
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SLet(_, _, name, ann, value) => match value {
        EFn(_, _, _, fn_ret, _, _) => {
          let ret = match ann {
            Some(at) => match at {
              TyFn(_, r, _) => Some(r),
              _ => fn_ret
            },
            None => fn_ret
          }
          if type_expr_is_heap(ret) {
            Array::push(out, name)
          } else {
            ()
          }
        },
        _ => ()
      },
      _ => ()
    }
    i = i + 1
  }
  out
}

fn collect_ctor_names(stmts: Array[Stmt]) -> Array[String] {
  let out: Array[String] = [
  ]
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SEnum(_, _, _, variants, _) => {
        let mut j = 0
        while j < Array::length(variants) {
          let (vn, _) = Array::get(variants, j)
          Array::push(out, vn)
          j = j + 1
        }
      },
      SSuberror(_, _, variants) => {
        let mut j = 0
        while j < Array::length(variants) {
          let (vn, _) = Array::get(variants, j)
          Array::push(out, vn)
          j = j + 1
        }
      },
      _ => ()
    }
    i = i + 1
  }
  out
}

fn inferred_heap_type() -> TypeExpr {
  TyTuple(array_empty())
}

fn fill_lambda_params(name: String, efn: Expr, body: Expr, hctx: HeapInferCtx) -> Expr {
  match efn {
    EFn(tps, bounds, params, ret, eff, fnbody) => {
      let calls: Array[Array[Bool]] = [
      ]
      let esc = [
        false
      ]
      let env0: Map[String, Bool] = Map::new()
      analyze_calls(name, body, env0, calls, esc, hctx)
      if Array::get(esc, 0) || Array::length(calls) == 0 {
        efn
      } else {
        let new_params = Array::slice(params, 0, 0)
        let mut pi = 0
        while pi < Array::length(params) {
          let (pname, pty) = Array::get(params, pi)
          let filled = match pty {
            Some(_) => (pname, pty),
            None =>
            if all_calls_heap_at(pi, calls) {
              (pname, Some(inferred_heap_type()))
            } else {
              (pname, pty)
            }
          }
          Array::push(new_params, filled)
          pi = pi + 1
        }
        EFn(tps, bounds, new_params, ret, eff, fnbody)
      }
    },
    _ => efn
  }
}

fn elaborate_rw(e: Expr, hctx: HeapInferCtx) -> Expr {
  match e {
    ELet(n, v, b, soff) => {
      let v2 = elaborate_rw(v, hctx)
      let v3 = fill_lambda_params(n, v2, b, hctx)
      ELet(n, v3, elaborate_rw(b, hctx), soff)
    },
    ELetRec(n, v, b) => {
      let v2 = elaborate_rw(v, hctx)
      let v3 = fill_lambda_params(n, v2, b, hctx)
      ELetRec(n, v3, elaborate_rw(b, hctx))
    },
    ELetMut(n, v, b, soff) => ELetMut(n, elaborate_rw(v, hctx), elaborate_rw(b, hctx), soff),
    EAssign(n, v, c) => EAssign(n, elaborate_rw(v, hctx), elaborate_rw(c, hctx)),
    EAssignOp(n, op, v, c) => EAssignOp(n, op, elaborate_rw(v, hctx), elaborate_rw(c, hctx)),
    ESeq(a, b) => ESeq(elaborate_rw(a, hctx), elaborate_rw(b, hctx)),
    EIf(c, t, el) => EIf(elaborate_rw(c, hctx), elaborate_rw(t, hctx), elaborate_rw(el, hctx)),
    EWhile(c, b) => EWhile(elaborate_rw(c, hctx), elaborate_rw(b, hctx)),
    EForIn(n, ix, it, b) => EForIn(n, ix, elaborate_rw(it, hctx), elaborate_rw(b, hctx)),
    EFn(tps, bounds, params, ret, eff, fb) =>
    EFn(tps, bounds, params, ret, eff, elaborate_rw(fb, hctx)),
    ECall(callee, args, off) => {
      let new_args = Array::slice(args, 0, 0)
      let mut i = 0
      while i < Array::length(args) {
        Array::push(new_args, elaborate_rw(Array::get(args, i), hctx))
        i = i + 1
      }
      ECall(elaborate_rw(callee, hctx), new_args, off)
    },
    EBinOp(op, l, r) => EBinOp(op, elaborate_rw(l, hctx), elaborate_rw(r, hctx)),
    EUnaryOp(op, o) => EUnaryOp(op, elaborate_rw(o, hctx)),
    EDot(o, f, off, fdoff) => EDot(elaborate_rw(o, hctx), f, off, fdoff),
    ETuple(xs) => {
      let ys = Array::slice(xs, 0, 0)
      let mut i = 0
      while i < Array::length(xs) {
        Array::push(ys, elaborate_rw(Array::get(xs, i), hctx))
        i = i + 1
      }
      ETuple(ys)
    },
    EArray(xs) => {
      let ys = Array::slice(xs, 0, 0)
      let mut i = 0
      while i < Array::length(xs) {
        Array::push(ys, elaborate_rw(Array::get(xs, i), hctx))
        i = i + 1
      }
      EArray(ys)
    },
    EMatch(s, arms) => {
      let new_arms = Array::slice(arms, 0, 0)
      let mut i = 0
      while i < Array::length(arms) {
        let (p, ab) = Array::get(arms, i)
        Array::push(new_arms, (p, elaborate_rw(ab, hctx)))
        i = i + 1
      }
      EMatch(elaborate_rw(s, hctx), new_arms)
    },
    EHandle(b, arms) => {
      let new_arms = Array::slice(arms, 0, 0)
      let mut i = 0
      while i < Array::length(arms) {
        let (p, ab) = Array::get(arms, i)
        Array::push(new_arms, (p, elaborate_rw(ab, hctx)))
        i = i + 1
      }
      EHandle(elaborate_rw(b, hctx), new_arms)
    },
    ELoop(ps, b) => {
      let new_ps = Array::slice(ps, 0, 0)
      let mut i = 0
      while i < Array::length(ps) {
        let (pn, iv) = Array::get(ps, i)
        Array::push(new_ps, (pn, elaborate_rw(iv, hctx)))
        i = i + 1
      }
      ELoop(new_ps, elaborate_rw(b, hctx))
    },
    ERecord(rn, fs, targs) => {
      let new_fs = Array::slice(fs, 0, 0)
      let mut i = 0
      while i < Array::length(fs) {
        let (fn0, fv) = Array::get(fs, i)
        Array::push(new_fs, (fn0, elaborate_rw(fv, hctx)))
        i = i + 1
      }
      ERecord(rn, new_fs, targs)
    },
    EMap(fs) => {
      let new_fs = Array::slice(fs, 0, 0)
      let mut i = 0
      while i < Array::length(fs) {
        let (fn0, fv) = Array::get(fs, i)
        Array::push(new_fs, (fn0, elaborate_rw(fv, hctx)))
        i = i + 1
      }
      EMap(new_fs)
    },
    ELabeledArg(l, k, x) => ELabeledArg(l, k, elaborate_rw(x, hctx)),
    EReturn(x) => EReturn(elaborate_rw(x, hctx)),
    ESpread(x) => ESpread(elaborate_rw(x, hctx)),
    EBreak(o) =>
    match o {
      Some(x) => EBreak(Some(elaborate_rw(x, hctx))),
      None => EBreak(None)
    },
    EContinue(xs) => {
      let ys = Array::slice(xs, 0, 0)
      let mut i = 0
      while i < Array::length(xs) {
        Array::push(ys, elaborate_rw(Array::get(xs, i), hctx))
        i = i + 1
      }
      EContinue(ys)
    },
    EInt(_) => e,
    EFloat(_) => e,
    EString(_) => e,
    EBool(_) => e,
    EIdent(_, _) => e,
    EStringInterp(_) => e,
    EUnit => e
  }
}

fn is_borrow_arg0_call(f: String) -> Bool {
  f == "__index" || f == "Array::get" || f == "Array::length" || f == "Array::set" || f == "Array::push" || f == "Array::push_all" || f == "ArrayBuilder::push" || f == "MutList::push" || f == "StringBuilder::push" || f == "MapBuilder::set" || f == "MapBuilder::has_key" || f == "MapBuilder::get" || f == "Map::get" || f == "Map::keys" || f == "Map::has_key" || f == "Map::has" || f == "Map::set" || f == "Map::size" || f == "Map::values" || f == "Map::delete" || f == "Bytes::push" || f == "Bytes::set" || f == "Bytes::get" || f == "Bytes::length" || f == "FrozenArray::get" || f == "FrozenArray::length" || f == "FixedArray::get" || f == "FixedArray::set" || f == "FixedArray::length" || f == "String::join" || f == "eq" || f == "__rec_field"
}

/// Bit i means parameter i of this callee is borrowed. Mirrors
/// bmask_has/md_borrow_mask_of in codegen/common_analysis (the same
/// keep-in-sync convention as is_borrow_arg0_call above).
fn pe_bmask_has(mask: Int, i: Int) -> Bool {
  i >= 0 && i < 32 && ((mask>>i)&1) == 1
}

/// The borrowed-parameter mask for callee `f`, honoring lexical scope: a
/// LOCAL binding that shadows a borrow-set name is an ordinary owned
/// closure call (mirrors compile_call's #875 local_idx_hint guard).
fn pe_borrow_mask(ctx: PCtx, scope: Map[String, Int], callee: Expr) -> Int {
  match callee {
    EIdent(f, _) => if Map::has_key(scope, f) {
      0
    } else {
      let bi = bsearch_leftmost(ctx.borrow_param_user, f)
      let user = if bi >= 0 && bi < Array::length(ctx.borrow_param_mask) {
        Array::get(ctx.borrow_param_mask, bi)
      } else {
        0
      }
      if is_borrow_arg0_call(f) {
        user|1
      } else {
        user
      }
    },
    _ => 0
  }
}

export fn pc_emit(ctx: PCtx, scope: Map[String, Int], expr: Expr) -> Int {
  match expr {
    EInt(_) => 0,
    EFloat(_) => 0,
    EString(_) => 0,
    EBool(_) => 0,
    EUnit => 0,
    EStringInterp(_) => 0,
    EIdent(x, _) => pe_use(ctx, scope, x),
    ECall(callee, args, _) => {
      // Same lexical-shadow guard as pc_count (and compile_call #875).
      let bmask = pe_borrow_mask(ctx, scope, callee)
      match callee {
        EIdent(_, _) => 0,
        _ => pc_emit(ctx, scope, callee)
      }
      let mut i = 0
      while i < Array::length(args) {
        let arg = Array::get(args, i)
        if pe_bmask_has(bmask, i) {
          match arg {
            EIdent(_, _) => 0,
            _ => pc_emit(ctx, scope, arg)
          }
        } else {
          pc_emit(ctx, scope, arg)
        }
        i = i + 1
      }
      0
    },
    EDot(obj, _field, _, _) => match obj {
      EIdent(_, _) => 0,
      _ => pc_emit(ctx, scope, obj)
    }
    ,
    ELet(name, value, body, _) => {
      let mut elide_dead_alias = false
      match value {
        EIdent(src, _) => {
          if Map::has_key(scope, src) {
            let sid = Map::get(scope, src)
            let rem = Array::get(ctx.remaining, sid)
            // ADR-0092 per-use pairing: mirror pe_use -- an alias of a
            // view-call binding must also dup at the source's LAST use
            // (there is no initial owned reference to transfer), so the
            // alias always ACQUIRES ownership and needs no view marking
            // of its own.
            let src_last_view = rem == 1 && Array::get(ctx.view_call_let, sid)
            if (rem > 1 || src_last_view) && !Array::get(ctx.scalar, sid) {
              // #1056 (almide `alias_safety.rs` comparison, rc check
              // elision): this occurrence of `let name = src` would dup
              // src's reference into `name`'s own slot. `ctx.next_id` is
              // about to become `name`'s id (pe_declare below); `ctx.uses`
              // at that id already holds `name`'s FINAL use count from the
              // pc_count pass (borrow occurrences folded in by
              // pctx_apply_borrow_retention, which runs before pc_emit
              // starts) -- ids are assigned in identical tree order across
              // both passes (see build_perceus_plan), so this id is exactly
              // the one pc_count computed uses for. If that count is zero,
              // `name` has NO occurrence anywhere in `body` (no owning use,
              // no borrow): the dup this occurrence would emit and the
              // unconditional scope-end drop `name` would otherwise get
              // (pe_scope_end -- an unused non-scalar binding always keeps
              // its one owned reference) are a pure no-op pair on the SAME
              // memory with no intervening read -- increment then
              // decrement, nothing observes the difference. Skipping both
              // (no PaAliasDup here; `name`'s own `remaining` is zeroed
              // right after pe_declare below so pe_scope_end's `remaining >
              // 0` check does not fire) removes one dup + one drop of
              // runtime rc traffic with no change in observable behavior.
              // `src`'s own remaining-use bookkeeping is untouched (still
              // decremented below exactly as without this elision) -- this
              // occurrence still "spends" one of src's owning uses,
              // precisely as if the dup had fired, so src's later
              // occurrences / scope-end drop are unaffected.
              if Array::get(ctx.uses, ctx.next_id) == 0 {
                elide_dead_alias = true
                0
              } else {
                pe_push(ctx, PaAliasDup, name)
              }
            } else {
              0
            }
            if rem > 0 {
              Array::set(ctx.remaining, sid, rem - 1)
            }
          } else {
            ()
          }
          0
        },
        _ => pc_emit(ctx, scope, value)
      }
      let id = pe_declare(ctx, name)
      if elide_dead_alias {
        Array::set(ctx.remaining, id, 0)
      }
      pc_emit(ctx, Map::set(scope, name, id), body)
      pe_scope_end(ctx, id, name)
    },
    ELetMut(name, value, body, _) => {
      pc_emit(ctx, scope, value)
      let id = pe_declare(ctx, name)
      pc_emit(ctx, Map::set(scope, name, id), body)
      pe_scope_end(ctx, id, name)
    },
    ELetRec(name, value, body) => {
      let id = pe_declare(ctx, name)
      let s2 = Map::set(scope, name, id)
      pc_emit(ctx, s2, value)
      pc_emit(ctx, s2, body)
      pe_scope_end(ctx, id, name)
    },
    EAssign(_name, value, body) => {
      pc_emit(ctx, scope, value)
      pc_emit(ctx, scope, body)
    },
    EAssignOp(_op, _name, value, body) => {
      pc_emit(ctx, scope, value)
      pc_emit(ctx, scope, body)
    },
    ESeq(a, b) => {
      pc_emit(ctx, scope, a)
      let nm = next_seq_name(ctx)
      let id = pe_declare(ctx, nm)
      pc_emit(ctx, scope, b)
      pe_scope_end(ctx, id, nm)
    },
    EBinOp(_op, l, r) => {
      pc_emit(ctx, scope, l)
      pc_emit(ctx, scope, r)
    },
    EUnaryOp(_op, e) => pc_emit(ctx, scope, e),
    ETuple(items) => {
      let mut i = 0
      while i < Array::length(items) {
        pc_emit(ctx, scope, Array::get(items, i))
        i = i + 1
      }
      0
    },
    EArray(items) => {
      let mut i = 0
      while i < Array::length(items) {
        pc_emit(ctx, scope, Array::get(items, i))
        i = i + 1
      }
      0
    },
    ERecord(_, fields, _) => {
      let mut i = 0
      while i < Array::length(fields) {
        pc_emit(ctx, scope, (Array::get(fields, i)).1)
        i = i + 1
      }
      0
    },
    EMap(fields) => {
      let mut i = 0
      while i < Array::length(fields) {
        pc_emit(ctx, scope, (Array::get(fields, i)).1)
        i = i + 1
      }
      0
    },
    EIf(cond, then_e, else_e) => {
      pc_emit(ctx, scope, cond)
      let snap = copy_ints(ctx.remaining)
      pc_emit(ctx, scope, then_e)
      // #1100 alloc cut: swap the prefix instead of taking a SECOND copy —
      // one pass both restores `remaining` to the pre-branch values (what
      // restore_prefix did) and captures the then-branch's values into
      // `snap`'s buffer (what the `then_rem` copy was for). Same values in
      // the same places, one allocation instead of two per `if`; the
      // branch-snapshot copies were the plan's largest allocation source
      // on a full-closure compile.
      let mut sw = 0
      while sw < Array::length(snap) {
        let then_v = Array::get(ctx.remaining, sw)
        Array::set(ctx.remaining, sw, Array::get(snap, sw))
        Array::set(snap, sw, then_v)
        sw = sw + 1
      }
      pc_emit(ctx, scope, else_e)
      // #705: leave the MIN remaining over both branches. A binding consumed in
      // one branch (e.g. a param threaded into a ctor in the `then`) but not the
      // other was previously left at the `else` branch's (higher) remaining, so
      // the scope-end drop fired on a value the taken branch already moved out —
      // a double free. Min means a binding consumed on ANY path is not
      // re-dropped (the non-consuming path leaks one ref, which is safe) instead
      // of the consuming path double-freeing (crash). Prefix-only (outer ids).
      // (`snap` holds the THEN branch's values after the swap above.)
      let mut i = 0
      while i < Array::length(snap) {
        if Array::get(snap, i) < Array::get(ctx.remaining, i) {
          Array::set(ctx.remaining, i, Array::get(snap, i))
        } else {
          ()
        }
        i = i + 1
      }
      0
    },
    EWhile(cond, body) => {
      pc_emit(ctx, scope, cond)
      pc_emit(ctx, scope, body)
    },
    EReturn(e) => pc_emit(ctx, scope, e),
    ESpread(e) => pc_emit(ctx, scope, e),
    ELabeledArg(_l, _n, e) => pc_emit(ctx, scope, e),
    EBreak(opt) => match opt {
      Some(e) => pc_emit(ctx, scope, e),
      None => 0
    }
    ,
    EFn(_tp, _tb, params, _ret, _eff, fbody) => {
      let caps = collect_free_vars(fbody, fn_param_names(params), [
      ])
      let mut i = 0
      while i < Array::length(caps) {
        pe_use(ctx, scope, Array::get(caps, i))
        i = i + 1
      }
      0
    },
    EForIn(value_name, index_opt, iterable, fbody) => {
      pc_emit(ctx, scope, iterable)
      let idv = pe_declare(ctx, value_name)
      let s2 = Map::set(scope, value_name, idv)
      let s3 = match index_opt {
        Some(idx) => {
          let idi = pe_declare(ctx, idx)
          Map::set(s2, idx, idi)
        },
        None => s2
      }
      pc_emit(ctx, s3, fbody)
      pe_scope_end(ctx, idv, value_name)
    },
    ELoop(params, lbody) => {
      let mut s = scope
      let pids: Array[Int] = [
      ]
      let pnames: Array[String] = [
      ]
      let mut i = 0
      while i < Array::length(params) {
        let p = Array::get(params, i)
        pc_emit(ctx, scope, p.1)
        let pid = pe_declare(ctx, p.0)
        s = Map::set(s, p.0, pid)
        Array::push(pids, pid)
        Array::push(pnames, p.0)
        i = i + 1
      }
      pc_emit(ctx, s, lbody)
      let mut j = 0
      while j < Array::length(pids) {
        pe_scope_end(ctx, Array::get(pids, j), Array::get(pnames, j))
        j = j + 1
      }
      0
    },
    EMatch(scrut, arms) => {
      match scrut {
        EIdent(_, _) => 0,
        _ => pc_emit(ctx, scope, scrut)
      }
      let snap = copy_ints(ctx.remaining)
      // #705: track the MIN remaining over all arms (see EIf). An arm that
      // consumes an outer binding (e.g. a param re-stored into a ctor) leaves it
      // at a lower remaining; leaving the LAST arm's (higher) value made the
      // scope-end drop double-free that binding on the arm that consumed it.
      let minrem = copy_ints(snap)
      let mut a = 0
      while a < Array::length(arms) {
        let arm = Array::get(arms, a)
        restore_prefix(ctx.remaining, snap)
        let pnames: Array[String] = [
        ]
        pat_names(arm.0, pnames)
        let mut s = scope
        let pids: Array[Int] = [
        ]
        let mut k = 0
        while k < Array::length(pnames) {
          let nm = Array::get(pnames, k)
          let pid = pe_declare(ctx, nm)
          s = Map::set(s, nm, pid)
          Array::push(pids, pid)
          k = k + 1
        }
        pc_emit(ctx, s, arm.1)
        let mut j = 0
        while j < Array::length(pids) {
          pe_scope_end(ctx, Array::get(pids, j), Array::get(pnames, j))
          j = j + 1
        }
        let mut mi = 0
        while mi < Array::length(snap) {
          if Array::get(ctx.remaining, mi) < Array::get(minrem, mi) {
            Array::set(minrem, mi, Array::get(ctx.remaining, mi))
          } else {
            ()
          }
          mi = mi + 1
        }
        a = a + 1
      }
      restore_prefix(ctx.remaining, minrem)
      0
    },
    EHandle(hbody, arms) => {
      let snap = copy_ints(ctx.remaining)
      pc_emit(ctx, scope, hbody)
      let minrem = copy_ints(ctx.remaining)
      let mut a = 0
      while a < Array::length(arms) {
        let arm = Array::get(arms, a)
        restore_prefix(ctx.remaining, snap)
        let pnames: Array[String] = [
        ]
        pat_names(arm.0, pnames)
        let mut s = scope
        let pids: Array[Int] = [
        ]
        let mut k = 0
        while k < Array::length(pnames) {
          let nm = Array::get(pnames, k)
          let pid = pe_declare(ctx, nm)
          s = Map::set(s, nm, pid)
          Array::push(pids, pid)
          k = k + 1
        }
        pc_emit(ctx, s, arm.1)
        let mut j = 0
        while j < Array::length(pids) {
          pe_scope_end(ctx, Array::get(pids, j), Array::get(pnames, j))
          j = j + 1
        }
        let mut mi = 0
        while mi < Array::length(snap) {
          if Array::get(ctx.remaining, mi) < Array::get(minrem, mi) {
            Array::set(minrem, mi, Array::get(ctx.remaining, mi))
          } else {
            ()
          }
          mi = mi + 1
        }
        a = a + 1
      }
      restore_prefix(ctx.remaining, minrem)
      0
    },
    _ => 0
  }
}

export fn pc_count(ctx: PCtx, scope: Map[String, Int], expr: Expr) -> Int {
  match expr {
    EInt(_) => 0,
    EFloat(_) => 0,
    EString(_) => 0,
    EBool(_) => 0,
    EUnit => 0,
    EStringInterp(_) => 0,
    EIdent(x, _) => pc_count_use(ctx, scope, x),
    ECall(callee, args, _) => {
      match callee {
        // Always borrow-count an ident callee: for a true top-level fn the
        // name is not in scope and this is a no-op, while for a LOCAL that
        // shadows a borrow-set name skipping it undercounted the local's
        // borrows (ADR-0092 per-use pairing, shadow hole).
        EIdent(f, _) => pc_count_borrow(ctx, scope, f),
        _ => pc_count(ctx, scope, callee)
      }
      // Lexical scoping wins over the borrow sets: see pe_borrow_mask.
      let bmask = pe_borrow_mask(ctx, scope, callee)
      let mut i = 0
      while i < Array::length(args) {
        let arg = Array::get(args, i)
        if pe_bmask_has(bmask, i) {
          match arg {
            EIdent(obj, _) => pc_count_borrow(ctx, scope, obj),
            _ => pc_count(ctx, scope, arg)
          }
        } else {
          pc_count(ctx, scope, arg)
        }
        i = i + 1
      }
      0
    },
    EDot(obj, _field, _, _) => match obj {
      EIdent(x, _) => pc_count_borrow(ctx, scope, x),
      _ => pc_count(ctx, scope, obj)
    }
    ,
    ELet(name, value, body, _) => {
      pc_count(ctx, scope, value)
      let id = pc_declare(ctx, name, is_scalar_expr(ctx, value))
      let _ = pctx_mark_view_call(ctx, scope, id, value)
      pc_count(ctx, Map::set(scope, name, id), body)
    },
    ELetMut(name, value, body, _) => {
      pc_count(ctx, scope, value)
      let id = pc_declare(ctx, name, is_scalar_expr(ctx, value))
      let _ = pctx_mark_view_call(ctx, scope, id, value)
      pc_count(ctx, Map::set(scope, name, id), body)
    },
    ELetRec(name, value, body) => {
      let id = pc_declare(ctx, name, false)
      let s2 = Map::set(scope, name, id)
      pc_count(ctx, s2, value)
      pc_count(ctx, s2, body)
    },
    EAssign(_name, value, body) => {
      pc_count(ctx, scope, value)
      pc_count(ctx, scope, body)
    },
    EAssignOp(_op, _name, value, body) => {
      pc_count(ctx, scope, value)
      pc_count(ctx, scope, body)
    },
    ESeq(a, b) => {
      pc_count(ctx, scope, a)
      let nm = next_seq_name(ctx)
      let sq_id = pc_declare(ctx, nm, is_scalar_expr(ctx, a))
      // ADR-0092 per-use pairing: a DISCARDED view-call result gets a seq-temp
      // drop it never owned -- same class as a view-call let-binding.
      let _ = pctx_mark_view_call(ctx, scope, sq_id, a)
      pc_count(ctx, scope, b)
    },
    EBinOp(_op, l, r) => {
      pc_count(ctx, scope, l)
      pc_count(ctx, scope, r)
    },
    EUnaryOp(_op, e) => pc_count(ctx, scope, e),
    ETuple(items) => {
      let mut i = 0
      while i < Array::length(items) {
        pc_count(ctx, scope, Array::get(items, i))
        i = i + 1
      }
      0
    },
    EArray(items) => {
      let mut i = 0
      while i < Array::length(items) {
        pc_count(ctx, scope, Array::get(items, i))
        i = i + 1
      }
      0
    },
    ERecord(_, fields, _) => {
      let mut i = 0
      while i < Array::length(fields) {
        pc_count(ctx, scope, (Array::get(fields, i)).1)
        i = i + 1
      }
      0
    },
    EMap(fields) => {
      let mut i = 0
      while i < Array::length(fields) {
        pc_count(ctx, scope, (Array::get(fields, i)).1)
        i = i + 1
      }
      0
    },
    EIf(cond, then_e, else_e) => {
      pc_count(ctx, scope, cond)
      let snap_u = copy_ints(ctx.uses)
      let snap_b = copy_ints(ctx.borrows)
      pc_count(ctx, scope, then_e)
      // #1100 alloc cut: swap the prefixes instead of taking SECOND copies
      // (`then_u`/`then_b`) — one pass restores uses/borrows to the
      // pre-branch values and captures the then-branch's values into the
      // snap buffers. 2 allocations per `if` instead of 4.
      let mut sw = 0
      while sw < Array::length(snap_u) {
        let tu = Array::get(ctx.uses, sw)
        Array::set(ctx.uses, sw, Array::get(snap_u, sw))
        Array::set(snap_u, sw, tu)
        let tb = Array::get(ctx.borrows, sw)
        Array::set(ctx.borrows, sw, Array::get(snap_b, sw))
        Array::set(snap_b, sw, tb)
        sw = sw + 1
      }
      pc_count(ctx, scope, else_e)
      // Merge = per-id MAX over the two branches. The previous delta form
      // (`base + max(then - base, else - base)`) is algebraically the same
      // number — the base cancels — so dropping it changes no plan. After
      // the swap above, snap_u/snap_b hold the THEN branch's values and
      // ctx.uses/ctx.borrows hold the ELSE branch's.
      let mut id = 0
      while id < Array::length(snap_u) {
        Array::set(ctx.uses, id, int_max(Array::get(snap_u, id), Array::get(ctx.uses, id)))
        Array::set(ctx.borrows, id, int_max(Array::get(snap_b, id), Array::get(ctx.borrows, id)))
        id = id + 1
      }
      0
    },
    EWhile(cond, body) => {
      pc_count(ctx, scope, cond)
      pc_count(ctx, scope, body)
    },
    EReturn(e) => pc_count(ctx, scope, e),
    ESpread(e) => pc_count(ctx, scope, e),
    ELabeledArg(_l, _n, e) => pc_count(ctx, scope, e),
    EBreak(opt) => match opt {
      Some(e) => pc_count(ctx, scope, e),
      None => 0
    }
    ,
    EFn(_tp, _tb, params, _ret, _eff, fbody) => {
      let caps = collect_free_vars(fbody, fn_param_names(params), [
      ])
      let mut i = 0
      while i < Array::length(caps) {
        pc_count_use(ctx, scope, Array::get(caps, i))
        i = i + 1
      }
      0
    },
    EForIn(value_name, index_opt, iterable, fbody) => {
      pc_count(ctx, scope, iterable)
      let idv = pc_declare(ctx, value_name, false)
      let s2 = Map::set(scope, value_name, idv)
      let s3 = match index_opt {
        Some(idx) => {
          let idi = pc_declare(ctx, idx, true)
          Map::set(s2, idx, idi)
        },
        None => s2
      }
      pc_count(ctx, s3, fbody)
    },
    ELoop(params, lbody) => {
      let mut s = scope
      let mut i = 0
      while i < Array::length(params) {
        let p = Array::get(params, i)
        pc_count(ctx, scope, p.1)
        let pid = pc_declare(ctx, p.0, is_scalar_expr(ctx, p.1))
        s = Map::set(s, p.0, pid)
        i = i + 1
      }
      pc_count(ctx, s, lbody)
    },
    EMatch(scrut, arms) => {
      match scrut {
        EIdent(sx, _) => pc_count_borrow(ctx, scope, sx),
        _ => pc_count(ctx, scope, scrut)
      }
      let snap_u = copy_ints(ctx.uses)
      let snap_b = copy_ints(ctx.borrows)
      let max_u = zeros(Array::length(snap_u))
      let max_b = zeros(Array::length(snap_b))
      let mut a = 0
      while a < Array::length(arms) {
        let arm = Array::get(arms, a)
        restore_prefix(ctx.uses, snap_u)
        restore_prefix(ctx.borrows, snap_b)
        let pnames: Array[String] = [
        ]
        pat_names(arm.0, pnames)
        let mut s = scope
        let mut k = 0
        while k < Array::length(pnames) {
          let nm = Array::get(pnames, k)
          let pid = pc_declare(ctx, nm, false)
          s = Map::set(s, nm, pid)
          k = k + 1
        }
        pc_count(ctx, s, arm.1)
        let mut id = 0
        while id < Array::length(snap_u) {
          let du = Array::get(ctx.uses, id) - Array::get(snap_u, id)
          if du > Array::get(max_u, id) {
            Array::set(max_u, id, du)
          }
          let db = Array::get(ctx.borrows, id) - Array::get(snap_b, id)
          if db > Array::get(max_b, id) {
            Array::set(max_b, id, db)
          }
          id = id + 1
        }
        a = a + 1
      }
      restore_prefix(ctx.uses, snap_u)
      restore_prefix(ctx.borrows, snap_b)
      let mut id2 = 0
      while id2 < Array::length(snap_u) {
        Array::set(ctx.uses, id2, Array::get(snap_u, id2) + Array::get(max_u, id2))
        Array::set(ctx.borrows, id2, Array::get(snap_b, id2) + Array::get(max_b, id2))
        id2 = id2 + 1
      }
      0
    },
    EHandle(hbody, arms) => {
      let snap_u = copy_ints(ctx.uses)
      let snap_b = copy_ints(ctx.borrows)
      let max_u = zeros(Array::length(snap_u))
      let max_b = zeros(Array::length(snap_b))
      pc_count(ctx, scope, hbody)
      let mut id0 = 0
      while id0 < Array::length(snap_u) {
        let du = Array::get(ctx.uses, id0) - Array::get(snap_u, id0)
        if du > Array::get(max_u, id0) {
          Array::set(max_u, id0, du)
        }
        let db = Array::get(ctx.borrows, id0) - Array::get(snap_b, id0)
        if db > Array::get(max_b, id0) {
          Array::set(max_b, id0, db)
        }
        id0 = id0 + 1
      }
      let mut a = 0
      while a < Array::length(arms) {
        let arm = Array::get(arms, a)
        restore_prefix(ctx.uses, snap_u)
        restore_prefix(ctx.borrows, snap_b)
        let pnames: Array[String] = [
        ]
        pat_names(arm.0, pnames)
        let mut s = scope
        let mut k = 0
        while k < Array::length(pnames) {
          let nm = Array::get(pnames, k)
          let pid = pc_declare(ctx, nm, false)
          s = Map::set(s, nm, pid)
          k = k + 1
        }
        pc_count(ctx, s, arm.1)
        let mut id = 0
        while id < Array::length(snap_u) {
          let du = Array::get(ctx.uses, id) - Array::get(snap_u, id)
          if du > Array::get(max_u, id) {
            Array::set(max_u, id, du)
          }
          let db = Array::get(ctx.borrows, id) - Array::get(snap_b, id)
          if db > Array::get(max_b, id) {
            Array::set(max_b, id, db)
          }
          id = id + 1
        }
        a = a + 1
      }
      restore_prefix(ctx.uses, snap_u)
      restore_prefix(ctx.borrows, snap_b)
      let mut id2 = 0
      while id2 < Array::length(snap_u) {
        Array::set(ctx.uses, id2, Array::get(snap_u, id2) + Array::get(max_u, id2))
        Array::set(ctx.borrows, id2, Array::get(snap_b, id2) + Array::get(max_b, id2))
        id2 = id2 + 1
      }
      0
    },
    _ => 0
  }
}

/// #706 follow-up (borrow-after-move): a binding with any BORROW occurrence
/// (ctx.borrows[id] > 0 — computed branch-aware, max-across-if/match-arms,
/// alongside ctx.uses above) must stay alive through that borrow, regardless of
/// whether the borrow comes BEFORE or AFTER the binding's owning (consuming)
/// occurrences. `pc_emit`/`pe_use` only track OWNING occurrences (ctx.uses) when
/// deciding dup vs. free-transfer — borrows are invisible to that decision. If a
/// binding's textually LAST owning occurrence is treated as "the final, free
/// consume" (no dup; ownership transfers to the callee) and a borrow occurs
/// AFTER that point, the borrow reads through a reference the callee may already
/// have dropped — a silent use-after-free. This was masked in practice by other
/// RC leaks (loop-consume before #706's core fix; the loop-consume LEAK before
/// its own follow-up fix) that happened to keep the value alive by accident; see
/// #706 for the wat_exports/parse_module_sections repro that exposed it once
/// those leaks were tightened.
///
/// Fix: bump the binding's counted `uses` by exactly one whenever it has ANY
/// borrow occurrence. This is a pure post-processing step over the FINAL,
/// branch-merge-complete `uses`/`borrows` arrays (called after `pc_count`
/// finishes, before the emission pass begins), so it does not interact with the
/// max-across-branches counting logic itself — it only adjusts the total input
/// the REST of the system (pe_declare's `remaining` init, pc_emit's sequential
/// dup decisions, pe_scope_end's drop decision) already handles correctly for "K
/// owning occurrences": with K bumped to K+1, the occurrence that used to be a
/// free-transfer gets a dup like any other, and the binding's normal scope-end
/// drop (already emitted whenever `remaining` ends > 0 — e.g. the existing
/// borrow-only / K=0 baseline) picks up the now-nonzero leftover. No new
/// PerceusAction kind, no change to pc_emit or the codegen dup/drop realization.
/// For a binding with ZERO owning occurrences (pure borrow — the already-correct
/// baseline), this is a no-op: pe_declare already treats uses==0 like uses==1.
fn pctx_apply_borrow_retention(ctx: PCtx) -> Int {
  let mut bid = 0
  while bid < ctx.next_id {
    if Array::get(ctx.borrows, bid) > 0 {
      Array::set(ctx.uses, bid, Array::get(ctx.uses, bid) + 1)
    } else {
      ()
    }
    bid = bid + 1
  }
  0
}

/// Build the dup/drop plan for a function body expression.
export fn build_perceus_plan(body: Expr) -> Array[PerceusAction] {
  let no_masks: Array[Int] = [
  ]
  let ctx = pctx_new([
  ], [
  ], no_masks, [
  ])
  let empty: Map[String, Int] = Map::new()
  pc_count(ctx, empty, body)
  pctx_apply_borrow_retention(ctx)
  ctx.next_id = 0
  ctx.seq_id = 0
  pc_emit(ctx, empty, body)
  ctx.actions
}

fn collect_heap_ret_fns(stmts: Array[Stmt]) -> Array[String] {
  let out: Array[String] = [
  ]
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SLet(_, _, fname, oty, _) =>
      match oty {
        Some(ty) =>
        match ty {
          TyFn(_, ret, _) =>
          if type_expr_is_heap(Some(ret)) {
            Array::push(out, fname)
          } else {
            ()
          },
          _ => ()
        },
        None => ()
      },
      _ => ()
    }
    i = i + 1
  }
  out
}

export fn elaborate_heap_params(stmts: Array[Stmt]) -> Array[Stmt] {
  let hctx = HeapInferCtx::{
    ctors: collect_ctor_names(stmts),
    heap_fns: collect_heap_ret_fns(stmts),
  }
  let out = Array::slice(stmts, 0, 0)
  let mut i = 0
  while i < Array::length(stmts) {
    let s = Array::get(stmts, i)
    let s2 = match s {
      SLet(a, b, n, t, e) => SLet(a, b, n, t, elaborate_rw(e, hctx)),
      SExpr(e) => SExpr(elaborate_rw(e, hctx)),
      _ => s
    }
    Array::push(out, s2)
    i = i + 1
  }
  out
}

fn expr_projects_or_matches(name: String, e: Expr) -> Bool {
  match e {
    EDot(obj, _, _, _) =>
    match obj {
      EIdent(n, _) => n == name,
      _ => expr_projects_or_matches(name, obj)
    },
    EMatch(scrut, arms) => {
      let hit = match scrut {
        EIdent(n, _) => n == name,
        _ => expr_projects_or_matches(name, scrut)
      }
      if hit {
        true
      } else {
        let mut i = 0
        let mut found = false
        while i < Array::length(arms) {
          let (_, arm_body) = Array::get(arms, i)
          if expr_projects_or_matches(name, arm_body) {
            found = true
          } else {
            ()
          }
          i = i + 1
        }
        found
      }
    },
    EHandle(body, arms) => {
      let mut i = 0
      let mut found = expr_projects_or_matches(name, body)
      while i < Array::length(arms) {
        let (_, arm_body) = Array::get(arms, i)
        if expr_projects_or_matches(name, arm_body) {
          found = true
        } else {
          ()
        }
        i = i + 1
      }
      found
    },
    ELet(_, val, body, _) =>
    expr_projects_or_matches(name, val) || expr_projects_or_matches(name, body),
    ELetRec(_, val, body) =>
    expr_projects_or_matches(name, val) || expr_projects_or_matches(name, body),
    ELetMut(_, val, body, _) =>
    expr_projects_or_matches(name, val) || expr_projects_or_matches(name, body),
    EAssign(_, val, cont) =>
    expr_projects_or_matches(name, val) || expr_projects_or_matches(name, cont),
    EAssignOp(_, _, val, cont) =>
    expr_projects_or_matches(name, val) || expr_projects_or_matches(name, cont),
    ESeq(a, b) =>
    expr_projects_or_matches(name, a) || expr_projects_or_matches(name, b),
    EIf(c, t, el) =>
    expr_projects_or_matches(name, c) ||
    expr_projects_or_matches(name, t) ||
    expr_projects_or_matches(name, el),
    EWhile(c, b) =>
    expr_projects_or_matches(name, c) || expr_projects_or_matches(name, b),
    EForIn(_, _, iter, body) =>
    expr_projects_or_matches(name, iter) || expr_projects_or_matches(name, body),
    ECall(callee, args, _) => {
      let mut i = 0
      let mut found = expr_projects_or_matches(name, callee)
      while i < Array::length(args) {
        if expr_projects_or_matches(name, Array::get(args, i)) {
          found = true
        } else {
          ()
        }
        i = i + 1
      }
      found
    },
    EBinOp(_, l, r) =>
    expr_projects_or_matches(name, l) || expr_projects_or_matches(name, r),
    EUnaryOp(_, o) => expr_projects_or_matches(name, o),
    EFn(_, _, _, _, _, body) => expr_projects_or_matches(name, body),
    ETuple(elems) => {
      let mut i = 0
      let mut found = false
      while i < Array::length(elems) {
        if expr_projects_or_matches(name, Array::get(elems, i)) {
          found = true
        } else {
          ()
        }
        i = i + 1
      }
      found
    },
    EArray(elems) => {
      let mut i = 0
      let mut found = false
      while i < Array::length(elems) {
        if expr_projects_or_matches(name, Array::get(elems, i)) {
          found = true
        } else {
          ()
        }
        i = i + 1
      }
      found
    },
    ELoop(params, body) => {
      let mut i = 0
      let mut found = expr_projects_or_matches(name, body)
      while i < Array::length(params) {
        let (_, init) = Array::get(params, i)
        if expr_projects_or_matches(name, init) {
          found = true
        } else {
          ()
        }
        i = i + 1
      }
      found
    },
    ERecord(_, fields, _) => {
      let mut i = 0
      let mut found = false
      while i < Array::length(fields) {
        let (_, fval) = Array::get(fields, i)
        if expr_projects_or_matches(name, fval) {
          found = true
        } else {
          ()
        }
        i = i + 1
      }
      found
    },
    EMap(fields) => {
      let mut i = 0
      let mut found = false
      while i < Array::length(fields) {
        let (_, fval) = Array::get(fields, i)
        if expr_projects_or_matches(name, fval) {
          found = true
        } else {
          ()
        }
        i = i + 1
      }
      found
    },
    ELabeledArg(_, _, inner) => expr_projects_or_matches(name, inner),
    EReturn(inner) => expr_projects_or_matches(name, inner),
    ESpread(inner) => expr_projects_or_matches(name, inner),
    EBreak(opt) =>
    match opt {
      Some(inner) => expr_projects_or_matches(name, inner),
      None => false
    },
    EContinue(args) => {
      let mut i = 0
      let mut found = false
      while i < Array::length(args) {
        if expr_projects_or_matches(name, Array::get(args, i)) {
          found = true
        } else {
          ()
        }
        i = i + 1
      }
      found
    },
    EInt(_) => false,
    EFloat(_) => false,
    EString(_) => false,
    EBool(_) => false,
    EIdent(_, _) => false,
    EStringInterp(_) => false,
    EUnit => false
  }
}

/// Heap-ness decision for an owned parameter: the type annotation says heap, or
/// (when unannotated) the body proves it via projection/match. Used by the
/// Perceus plan and codegen so an unannotated nested-closure param that is
/// projected no longer leaks its owned argument (ADR-0055 Stage 4).
export fn param_is_heap_in_body(name: String, otype: Option[TypeExpr], body: Expr) -> Bool {
  if type_expr_is_heap(otype) {
    true
  } else {
    match otype {
      None => expr_projects_or_matches(name, body),
      Some(_) => false
    }
  }
}

/// Build the plan for a function whose parameters are owned heap values. Params
/// are declared as bindings (in count + emit lockstep, same ids) so the existing
/// machinery emits a PaDrop for a borrowed-only/unused heap param and a PaDup for
/// one used in multiple owning positions. Heap-ness comes from the param's type
/// annotation (scalar params get scalar=true so they are never dropped).
export fn build_perceus_plan_with_params(params: Array[(String, Option[TypeExpr])], body: Expr, borrow_ret_names: Array[String], borrow_param_fns: Array[String], borrow_param_masks: Array[Int], view_ret_fns: Array[String]) -> Array[PerceusAction] {
  let ctx = pctx_new(borrow_ret_names, borrow_param_fns, borrow_param_masks, view_ret_fns)
  let mut scope: Map[String, Int] = Map::new()
  let mut pi = 0
  while pi < Array::length(params) {
    let (pname, ptype) = Array::get(params, pi)
    let id = pc_declare(ctx, pname, !param_is_heap_in_body(pname, ptype, body))
    scope = Map::set(scope, pname, id)
    pi = pi + 1
  }
  pc_count(ctx, scope, body)
  pctx_apply_borrow_retention(ctx)
  ctx.next_id = 0
  ctx.seq_id = 0
  let mut scope2: Map[String, Int] = Map::new()
  let param_ids = array_empty()
  let mut pj = 0
  while pj < Array::length(params) {
    let (pname, _) = Array::get(params, pj)
    let id = pe_declare(ctx, pname)
    scope2 = Map::set(scope2, pname, id)
    Array::push(param_ids, id)
    pj = pj + 1
  }
  pc_emit(ctx, scope2, body)
  let mut pk = 0
  while pk < Array::length(params) {
    let (pname, _) = Array::get(params, pk)
    pe_scope_end(ctx, Array::get(param_ids, pk), pname)
    pk = pk + 1
  }
  ctx.actions
}
