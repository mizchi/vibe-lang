//# Imports

import @vibe/compiler/codegen/common_analysis {
  collect_free_vars, md_borrow_mask_of, md_consume_count_pre, md_shadow_zeroed_bmasks
}

import @vibe/core {
  array_empty, struct MutSet
}

import @vibe/compiler/core {
  Expr,
  Pat,
  Stmt,
  TypeExpr,
  borrow_ret_builtin_names,
  bsearch_leftmost,
  expr_child_at,
  expr_children,
  expr_children_pop,
  expr_children_push,
  expr_children_top,
  is_exception_throw_operation,
  sorted_names_of
}

//# Types

export enum PerceusActionKind {
  PaDup;
  PaDrop;
  // A `dup` attributed to an *alias* binding `let a = t`: the source `t` is
  // used in more than one owning position, so this alias takes a duplicated
  // reference. Keyed by the ALIAS name `a` (not the source), which makes it
  // occurrence-precise without tree-order bookkeeping: the codegen dups the
  // source exactly at `let a = …`. (docs/spec/selfhost-rc-port.md)
  PaAliasDup;
  // ADR-0092 / #2389 reuse pairing. `PaReuseToken(name)` marks a binding
  // whose planned drop is a candidate to become a reuse token when it is
  // consumed by a match arm that decomposes it (all-PBind/PWild pattern,
  // each PBind consumed exactly once, scrutinee otherwise unused);
  // `PaReuseAlloc(name)` marks that the same arm's spine-tail constructor
  // call has the SAME arity and may allocate from the token. Both carry the
  // arity in `extra`. The pairing is a PLAN-side candidate: the RC codegen
  // re-validates against the ctor table (constructor-ness, float fields)
  // and stages the runtime rc==1 test; the bump and wasm-gc lanes ignore
  // both kinds entirely, so a pair degrades to today's drop + fresh alloc.
  PaReuseToken;
  PaReuseAlloc
}

// PerceusAction is defined transparently in this package's contract
// (index.vpkg): its field layout (.kind/.name) is real public API surface
// read directly by tests/perceus_rc_test.vibe. `binding_id` is the lexical
// binding identity assigned by the count/emit passes; unlike `name`, it keeps
// shadowed bindings distinct and is the contract needed for per-use RC
// realization. Struct record literals and
// field access resolve fine from impl units against the facade definition
// (@vibe/process ShResult precedent, PR #920), so no local def is kept.

struct PCtx {
  mut next_id: Int;
  mut seq_id: Int;
  // #2386: the token `perceus_pin_tables` handed out when it installed the
  // four tables below, 0 when the cache holds tables nobody pinned. A caller
  // presenting this token skips the four whole-table compares
  // (`pctx_cache_matches`) that otherwise ran once per function.
  mut pinned: Int;
  // The four table fields are `mut` for one reason only: on a pctx_cache
  // mismatch the cached PCtx is refilled in place by field assignment, which
  // drops the previous tables -- replacing the whole PCtx through Array::set
  // would leak it (the linear lane's arr_set stores without releasing the old
  // element).
  mut pctx_names: Array[String];
  // ADR-0092 borrow-inference: sorted whole-program names with aligned borrow
  // masks (compute_borrow_param_user_fns, common_analysis.vibe). A
  // source-owned shadowable builtin is retained even with mask zero so its
  // source ABI overrides the builtin contract. Same COPY discipline as
  // pctx_names -- see pctx_new's doc comment.
  mut borrow_param_user: Array[String];
  // Aligned to borrow_param_user: bit i of entry k says parameter i of
  // borrow_param_user[k] is borrowed. One bsearch on the names indexes
  // straight into this. Same COPY discipline.
  mut borrow_param_mask: Array[Int];
  // User fns whose RETURN may be an unowned interior view
  // (compute_may_return_view_fns; NOT intersected with borrow_param_user --
  // see the linked_compile gate comment for why that intersection was a
  // latent over-release). Only
  // calls to THESE mark view_call_let: suppressing the scope-end drop for a
  // fresh-returning callee's binding leaks its result (compiler-gate RC
  // reclamation guard), while a view-returning callee's binding must not
  // release a reference it never acquired. Same COPY discipline.
  mut view_ret_user: Array[String];
  // The per-plan working state below is `mut` so a cached PCtx (see
  // pctx_cache) can be reset between plan builds by assigning fresh empty
  // arrays -- assignment drops the previous plan's arrays instead of leaking
  // their elements the way an in-place truncate would.
  mut uses: Array[Int];
  mut borrows: Array[Int];
  mut scalar: Array[Bool];
  mut remaining: Array[Int];
  // True for a let-binding whose VALUE is a call to a borrow-arg0 fn (user
  // set or builtin list) -- the class whose result may be an unowned
  // interior view. With the borrow set empty this is never set, so the fix
  // is inert while lc_borrow_arg0_enabled is off.
  mut view_call_let: Array[Bool];
  mut actions: Array[PerceusAction]
}

struct HeapInferCtx {
  ctors: Array[String];
  heap_fns: Array[String]
}

//# Functions

fn zeros(n: Int) -> Array[Int] {
  let out: Array[Int] = []
  let mut i = 0
  while i < n {
    Array::push(out, 0)
    i = i + 1
  }
  out
}

fn int_max(a: Int, b: Int) -> Int {
  if a > b {
    a
  } else {
    b
  }
}

fn name_in(arr: Array[String], s: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(arr) {
    if Array::get(arr, i) == s {
      found = true
    } else {
      ()
    }
    i = i + 1
  }
  found
}

fn pe_push_for(ctx: PCtx, kind: PerceusActionKind, name: String, binding_id: Int, use_offset: Int) -> Int {
  Array::push(ctx.actions, PerceusAction::{
    kind: kind,
    name: name,
    binding_id: binding_id,
    use_offset: use_offset,
    extra: 0
  })
  0
}

fn pr_push_reuse(actions: Array[PerceusAction], kind: PerceusActionKind, name: String, arity: Int) -> Unit {
  Array::push(actions, PerceusAction::{
    kind: kind,
    name: name,
    binding_id: 0 - 1,
    use_offset: 0,
    extra: arity
  })
}

fn pe_use(ctx: PCtx, scope: Map[String, Int], name: String, use_offset: Int) -> Int {
  if Map::has_key(scope, name) {
    let id = Map::get(scope, name)
    let rem = Array::get(ctx.remaining, id)
    // ADR-0092 per-use pairing: a view-call binding holds NO initial owned
    // reference (its value may be an unowned interior view), so its LAST
    // owned use must also dup -- the standard rem == 1 "spend the initial
    // ref" transfer would consume a reference the binding never acquired.
    let last_view_use = rem == 1 && Array::get(ctx.view_call_let, id)
    if (rem > 1 || last_view_use) && !Array::get(ctx.scalar, id) {
      pe_push_for(ctx, PaDup, name, id, use_offset)
    } else {
      0
    }
    if rem > 0 {
      Array::set(ctx.remaining, id, rem - 1)
    }
  }
  0
}

/// `borrow_ret_names` is the whole-program borrow-returning-function-name set
/// (see is_borrow_ret_fname), computed ONCE per compile and identical across
/// every function's plan build. COPIED (not aliased) so PCtx solely owns
/// `pctx_names`: the caller's array reaches here through a borrowed struct
/// field read (CompileCtx.borrow_ret_names, see compile_lambda.vibe), so
/// storing it directly would let PCtx's structural drop decrement a refcount
/// this plan never owned -- the #707/#715 double-free shape. One
/// Array::slice is a single allocation + memory.copy of the name pointers.
fn pctx_new(borrow_ret_names: Array[String], borrow_param_fns: Array[String], borrow_param_masks: Array[Int], view_ret_fns: Array[String]) -> PCtx {
  PCtx::{
    next_id: 0,
    seq_id: 0,
    pinned: 0,
    pctx_names: Array::slice(borrow_ret_names, 0, Array::length(borrow_ret_names)),
    borrow_param_user: Array::slice(borrow_param_fns, 0, Array::length(borrow_param_fns)),
    borrow_param_mask: Array::slice(borrow_param_masks, 0, Array::length(borrow_param_masks)),
    view_ret_user: Array::slice(view_ret_fns, 0, Array::length(view_ret_fns)),
    uses: [],
    borrows: [],
    scalar: [],
    remaining: [],
    view_call_let: [],
    actions: [],
  }
}

/// The PCtx built for the most recent whole-program table set, reused across
/// plan builds. pctx_new's four Array::slice copies were the single largest
/// __rt_arr_slice caller in a full-closure compile profile (~7% of total CPU):
/// one plan is built per top-level function AND per lambda, and each paid a
/// fresh copy of the same four program-wide tables. The cache is keyed by
/// CONTENT: build_perceus_plan_with_params_split verifies all four incoming
/// tables element-by-element against the cached copies (cheap -- the elements
/// are the same string objects, so __rt_str_eq answers on its identity fast
/// path) and falls back to a fresh PCtx on any mismatch. Correctness therefore
/// never depends on a set/reset discipline; a stale or half-built cache entry
/// can only cause a miss, never a wrong table.
let pctx_cache: Array[PCtx] = []

/// #2386: the last token `perceus_pin_tables` issued (see PCtx.pinned).
let pctx_pin_counter: Array[Int] = [0]

fn same_str_table(a: Array[String], b: Array[String]) -> Bool {
  let la = Array::length(a)
  if la != Array::length(b) {
    false
  } else {
    let mut i = 0
    let mut same = true
    while same && i < la {
      if Array::get(a, i) == Array::get(b, i) {
        i = i + 1
      } else {
        same = false
      }
    }
    same
  }
}

fn same_int_table(a: Array[Int], b: Array[Int]) -> Bool {
  let la = Array::length(a)
  if la != Array::length(b) {
    false
  } else {
    let mut i = 0
    let mut same = true
    while same && i < la {
      if Array::get(a, i) == Array::get(b, i) {
        i = i + 1
      } else {
        same = false
      }
    }
    same
  }
}

fn pctx_cache_matches(ctx: PCtx, borrow_ret_names: Array[String], borrow_param_fns: Array[String], borrow_param_masks: Array[Int], view_ret_fns: Array[String]) -> Bool {
  same_str_table(ctx.pctx_names, borrow_ret_names) && same_str_table(ctx.borrow_param_user, borrow_param_fns) && same_int_table(ctx.borrow_param_mask, borrow_param_masks) && same_str_table(ctx.view_ret_user, view_ret_fns)
}

/// Clear the per-plan working state of a cached PCtx. Fresh empty arrays (not
/// truncates): assignment drops the previous plan's arrays and their elements.
fn pctx_reset(ctx: PCtx) -> Int {
  ctx.next_id = 0
  ctx.seq_id = 0
  let uses0: Array[Int] = []
  ctx.uses = uses0
  let borrows0: Array[Int] = []
  ctx.borrows = borrows0
  let scalar0: Array[Bool] = []
  ctx.scalar = scalar0
  let remaining0: Array[Int] = []
  ctx.remaining = remaining0
  let view0: Array[Bool] = []
  ctx.view_call_let = view0
  let actions0: Array[PerceusAction] = []
  ctx.actions = actions0
  0
}

/// Perf: this snapshot runs in every branch/match arm of the perceus plan --
/// the push-per-element version was the single largest __rt_arr_push caller in
/// a full-closure compile profile (253ms of 439ms). Array::slice is one
/// allocation + one memory.copy and yields an equally independent buffer.
fn copy_ints(src: Array[Int]) -> Array[Int] {
  Array::slice(src, 0, Array::length(src))
}

/// #2386: the branch snapshots `pc_count` / `pc_emit` take of the per-binding
/// tables (`uses`, `borrows`, `remaining`) live on ONE scratch stack instead
/// of a fresh array per `if` / `match` / `handle`. A snapshot is the offset
/// of its first slot; the construct that took it truncates the stack back to
/// its own first snapshot when it is done, so nested constructs stack and
/// every slot a construct reads is below anything its children push.
/// Measured: the per-construct copies were 49 ms of `__rt_arr_slice` (plus
/// the `zeros` tables) in a cold self-compile, on both lanes.
let pc_scratch: Array[Int] = []

/// Push a copy of `src`; answer its first slot.
fn pc_snap(src: Array[Int]) -> Int {
  let mark = Array::length(pc_scratch)
  let mut i = 0
  while i < Array::length(src) {
    Array::push(pc_scratch, Array::get(src, i))
    i = i + 1
  }
  mark
}

/// Push a copy of the `n` scratch slots starting at `at`; answer the first.
fn pc_snap_slots(at: Int, n: Int) -> Int {
  let mark = Array::length(pc_scratch)
  let mut i = 0
  while i < n {
    Array::push(pc_scratch, Array::get(pc_scratch, at + i))
    i = i + 1
  }
  mark
}

/// Push `n` zero slots; answer the first.
fn pc_snap_zeros(n: Int) -> Int {
  let mark = Array::length(pc_scratch)
  let mut i = 0
  while i < n {
    Array::push(pc_scratch, 0)
    i = i + 1
  }
  mark
}

/// Copy the `n` slots at `at` back over the prefix of `dst`.
fn pc_snap_restore(dst: Array[Int], at: Int, n: Int) -> Unit {
  let mut i = 0
  while i < n {
    Array::set(dst, i, Array::get(pc_scratch, at + i))
    i = i + 1
  }
}

export fn pa_is_dup(a: PerceusAction) -> Bool {
  match a.kind {
    PaDup => true,
    _ => false
  }
}

export fn pa_is_reuse_token(a: PerceusAction) -> Bool {
  match a.kind {
    PaReuseToken => true,
    _ => false
  }
}

export fn pa_is_reuse_alloc(a: PerceusAction) -> Bool {
  match a.kind {
    PaReuseAlloc => true,
    _ => false
  }
}

fn pat_names(pat: Pat, out: Array[String]) -> Int {
  match pat {
    PBind(name) => {
      Array::push(out, name)
      0
    },
    PCtor(_n, args) => {
      let mut i = 0
      while i < Array::length(args) {
        pat_names(Array::get(args, i), out)
        i = i + 1
      }
      0
    },
    PTuple(pats) => {
      let mut i = 0
      while i < Array::length(pats) {
        pat_names(Array::get(pats, i), out)
        i = i + 1
      }
      0
    },
    POr(l, _r) => pat_names(l, out),
    PStruct(_n, fields) => {
      let mut i = 0
      while i < Array::length(fields) {
        pat_names((Array::get(fields, i)).1, out)
        i = i + 1
      }
      0
    },
    _ => 0
  }
}

export fn pa_is_drop(a: PerceusAction) -> Bool {
  match a.kind {
    PaDrop => true,
    _ => false
  }
}

fn pc_declare(ctx: PCtx, _name: String, scalar: Bool) -> Int {
  let id = ctx.next_id
  Array::push(ctx.uses, 0)
  Array::push(ctx.borrows, 0)
  Array::push(ctx.scalar, scalar)
  Array::push(ctx.view_call_let, false)
  ctx.next_id = id + 1
  id
}

/// ADR-0092 per-use pairing: mark `id` as a view-call let-binding when its
/// value is a call to a borrow-arg0 fn that may RETURN an unowned view
/// (see PCtx.view_ret_user -- fresh-returning borrow-arg0 callees must
/// keep their binding's scope-end drop or the result leaks). A local that
/// shadows a view-ret name is an ordinary owned closure call (#875).
fn pctx_mark_view_call(ctx: PCtx, scope: Map[String, Int], id: Int, value: Expr) -> Int {
  match value {
    ECall(vc, _, _) => match vc {
      EIdent(vf, _) => if !Map::has_key(scope, vf) && bsearch_leftmost(ctx.view_ret_user, vf) >= 0 {
        Array::set(ctx.view_call_let, id, true)
      } else {
        ()
      },
      _ => ()
    },
    _ => ()
  }
  0
}

fn pe_declare(ctx: PCtx, _name: String) -> Int {
  let id = ctx.next_id
  let owning = Array::get(ctx.uses, id)
  let init = if owning == 0 {
    1
  } else {
    owning
  }
  Array::push(ctx.remaining, init)
  ctx.next_id = id + 1
  id
}

fn pc_count_use(ctx: PCtx, scope: Map[String, Int], name: String) -> Int {
  if Map::has_key(scope, name) {
    let id = Map::get(scope, name)
    Array::set(ctx.uses, id, Array::get(ctx.uses, id) + 1)
  }
  0
}

fn pe_scope_end(ctx: PCtx, id: Int, name: String) -> Int {
  if Array::get(ctx.remaining, id) > 0 && !Array::get(ctx.scalar, id) {
    // ADR-0092 per-use pairing: the scope-end drop releases the binding's
    // INITIAL owned reference. A view-call binding never held one (its
    // value may be an unowned interior view), so the drop over-releases
    // REGARDLESS of how the binding was used -- with owned uses the last
    // use spends the phantom initial ref, with none the retention-driven
    // remaining spends it here (both trapped codegen_heap_e2e_test under
    // the borrowed-arg0 ABI). Suppress unconditionally for the class; a
    // fresh-owned value from a may-return-view callee then leaks (bounded,
    // safe direction). pe_use pairs with this by dup-ing a view binding's
    // last owned use. Params are never in the class (view_call_let is set
    // only from let/seq values).
    if Array::get(ctx.view_call_let, id) {
      ()
    } else {
      pe_push_for(ctx, PaDrop, name, id, -1)
    }
    Array::set(ctx.remaining, id, 0)
  }
  0
}

/// #1915 mechanism 3 (see the EIf arm of pc_emit): both branches are the
/// SAME bare identifier, so whichever branch executes performs the same
/// single owned use — the emission pass walks it once instead of budgeting
/// one dup per branch.
fn eif_same_ident_branches(then_e: Expr, else_e: Expr) -> Bool {
  match then_e {
    EIdent(tn, _) =>
    match else_e {
      EIdent(en, _) => tn == en,
      _ => false
    },
    _ => false
  }
}

/// #1915 mechanism 3, match form: every arm body is the SAME bare identifier
/// and no arm pattern rebinds that name (a rebinding arm would resolve the
/// mention to its own payload, so the arms would not share one use). Such a
/// match performs exactly one owned use of that ident at runtime.
fn ematch_same_ident_arms(arms: Array[(Pat, Expr)]) -> Bool {
  let mut nm = ""
  let mut ok = Array::length(arms) > 1
  let mut i = 0
  while ok && i < Array::length(arms) {
    let (p, body) = Array::get(arms, i)
    match body {
      EIdent(bn, _) => {
        if nm == "" {
          nm = bn
        } else {
          ()
        }
        if bn != nm {
          ok = false
        } else {
          let pnames: Array[String] = []
          pat_names(p, pnames)
          if array_contains_str_pctx(pnames, nm) {
            ok = false
          } else {
            ()
          }
        }
      },
      _ => {
        ok = false
      }
    }
    i = i + 1
  }
  ok && nm != ""
}

fn next_seq_name(ctx: PCtx) -> String {
  let nm = "__seq" + __to_string(ctx.seq_id)
  ctx.seq_id = ctx.seq_id + 1
  nm
}

fn fn_param_names(params: Array[(String, Option[TypeExpr])]) -> Array[String] {
  let out: Array[String] = []
  let mut i = 0
  while i < Array::length(params) {
    Array::push(out, (Array::get(params, i)).0)
    i = i + 1
  }
  out
}

fn array_contains_str_pctx(arr: Array[String], s: String) -> Bool {
  // #1100: early-exit — this membership scan is one of the plan's hottest
  // loops and used to keep scanning the whole array after a hit.
  let n = Array::length(arr)
  let mut i = 0
  let mut found = false
  while !found && i < n {
    if Array::get(arr, i) == s {
      found = true
    } else {
      i = i + 1
    }
  }
  found
}

/// #707: is `fname` a call whose return value is a BORROWED VIEW sharing a
/// call argument's refcount, rather than a fresh owned reference -- either one
/// of the 3 builtins that read an element in place, or a user function whose
/// own body is (transitively) nothing but a tail-call to one of those (see
/// compute_borrow_returning_names). Bindings holding such a value must never
/// be dup/drop'd themselves: the compiler-self-hosted-under-RC crash (#707)
/// was exactly this -- `let peek = (toks, pos) -> Array::get(toks, pos)` was
/// NOT recognized as borrow-returning (only a literal `Array::get` callee
/// was), so `let __m_scrut = peek(toks, pos) in match __m_scrut { ... }`
/// (the match-scrutinee-lift's desugaring, see normalize/index.vibe
/// lift_match_scrutinees) planned a drop for `__m_scrut` as if it independently
/// owned a reference -- double-freeing the array element peek merely borrowed.
///
/// #1237 perf: `ctx.pctx_names` holds exactly the whole-program
/// borrow-returning-name set (see pctx_new). A genuine dedicated PCtx field
/// for that set was tried once and hit an unexplained "memory access out of
/// bounds" reading it back specifically when the whole compiler self-compiles
/// under RC (see #707), so pctx_names remains the known-safe field to read it
/// from. What changed is that pc_declare used to ALSO append every declared
/// binding name to this same array, so the set had to be stored with a
/// control-char prefix to stay distinguishable -- making each lookup here pay
/// a String::concat and, on a miss (the common case), rescan every binding
/// declared so far in the current function. pc_declare no longer touches
/// pctx_names, so the names sit here unprefixed and a miss costs only the
/// fixed set.
fn is_borrow_ret_fname(ctx: PCtx, fname: String) -> Bool {
  // The computed set includes compiler-owned builtins and transitive wrappers,
  // but excludes a builtin spelling when source owns that exact binding.
  bsearch_leftmost(ctx.pctx_names, fname) >= 0
}

/// #707: fixed-point closure over top-level function definitions, starting
/// from the 3 borrow-returning builtins: a function whose entire body is
/// (after stripping let/seq/assign wrappers) a single tail-call to an
/// already-known borrow-returning name is itself borrow-returning. Handles
/// arbitrarily deep wrapper chains (`peek` -> `Array::get`,
/// `peek2` -> `peek` -> `Array::get`, ...). Computed once over the whole
/// merged program (see linked_compile.vibe) and threaded into every
/// function's Perceus plan via build_perceus_plan_with_params.
/// #707: does every value `e` can tail-produce come from a known
/// borrow-returning name, or a "safe to never drop" fallback? Recurses through
/// let/seq/assign wrappers and BOTH sides of if/match (a bare tail call alone
/// missed `peek`'s actual shape: `if pos < len { Array::get(tokens, pos) }
/// else TEof` -- a bounds-check guard around the real access, with a bare
/// nullary-ctor-ish identifier as the out-of-range fallback). A bare EIdent
/// tail (e.g. a sentinel like TEof) is accepted as safe even though it isn't
/// proven borrow-returning: marking its binding "never dup/drop" can at worst
/// leak that one value (the existing runtime dup/drop guards already no-op on
/// non-heap-tagged values), never corrupt -- the failure mode this whole fix
/// targets is a double-free from treating a genuinely-borrowed value as owned,
/// not a leak from treating a small/rare owned value as borrowed.
/// #1915 refinement: that fallback's reach was wrong. A bare ident branch tail
/// is also the most common OWNED-return shape (`let out: Array[T] = []; ...
/// if c { out } else { out }` builders), and "leak one small sentinel" became
/// "leak one builder array per call, in every caller". So an ident tail is now
/// RESOLVED through the wrapper-spine `let` bindings (spine_names/spine_vals,
/// collected by collect_spine_let_vals): a binding provably holding an owned
/// heap value (container literal, or a call to a non-borrow-returning name --
/// the same verdicts an INLINE branch tail of that shape already gets from
/// this walk) rejects the function, while a view binding, a parameter, a
/// `let mut`, a shadowed name, or anything unresolvable keeps today's safe
/// fallback. Resolution can only flip leak -> reclaim, never view -> owned:
/// the owned verdicts mirror what the value expression would classify as if
/// written inline in tail position.
/// Iterative (NOT self-recursive) worklist walk over child expressions, rather
/// than a `let rec` recursive-descent function. Also: the `ECall` case matches
/// its callee via a NESTED constructor pattern one step at a time (`ECall(e,
/// _, _)` then a separate `match e { EIdent(callee, _) => ... }`), never
/// `ECall(EIdent(callee, _), _, _)` in one pattern. Both of these are
/// load-bearing workarounds, not style: a `let rec` self-recursive version of
/// this walk, AND a single-arm version using the nested `ECall(EIdent(...),
/// _, _)` pattern, each independently reproduce a "memory access out of
/// bounds" trap (reproducible under bump too -- not RC-specific) that is only
/// exposed when this function runs over a derive(Ord)-generated `T::compare`
/// body (a chain of `EIf(cmp, EInt(-1/1), ...)` with no further wrapper/call
/// -- e.g. `struct P { x: Int; y: Int } derive(Ord)`). An equivalent shape
/// recursing into an `Array::get` call / `EIdent` sentinel branch (`peek`'s
/// actual body) does not crash either broken variant, and the crash persists
/// even when the offending match arm is never reached at runtime for the
/// crashing input -- so this is a codegen bug in this compiler triggered by
/// those two source *shapes*, not a logic bug in this function's checks.
/// True root cause not isolated; swap either workaround for the "more natural"
/// form only after confirming compute_borrow_returning_names_test.vibe (or an
/// equivalent derive(Ord) regression) still passes.
/// #1915: collect the wrapper-spine `let` bindings (name -> value) of a
/// function body so tail_is_borrow_ret_safe can resolve a bare ident branch
/// tail to the value it names. Only immutable, once-bound spine lets are
/// trusted; `let mut` / `let rec` targets, assignment targets, and re-bound
/// (shadowed) names go to `excluded` -- resolution must never flip a genuine
/// view to owned (the double-free direction), so anything ambiguous stays
/// unresolvable. Iterative spine walk, mirroring strip_wrappers_for_borrow_ret.
fn collect_spine_let_vals(e0: Expr, names: Array[String], vals: Array[Expr], excluded: Array[String]) -> Int {
  let mut e = e0
  let mut looping = true
  while looping {
    looping = false
    match e {
      ELet(n, v, b, _) => {
        if array_contains_str_pctx(names, n) || array_contains_str_pctx(excluded, n) {
          Array::push(excluded, n)
        } else {
          Array::push(names, n)
          Array::push(vals, v)
        }
        e = b
        looping = true
      },
      ELetMut(n, _, b, _) => {
        Array::push(excluded, n)
        e = b
        looping = true
      },
      ELetRec(n, _, b) => {
        Array::push(excluded, n)
        e = b
        looping = true
      },
      ESeq(_, b) => {
        e = b
        looping = true
      },
      EAssign(n, _, b) => {
        Array::push(excluded, n)
        e = b
        looping = true
      },
      EAssignOp(n, _, _, b) => {
        Array::push(excluded, n)
        e = b
        looping = true
      },
      _ => ()
    }
  }
  0
}

/// #1915: does the spine binding named `nm0` provably hold an OWNED heap
/// value? Owned verdicts mirror what the same value expression would get as
/// an INLINE branch tail in tail_is_borrow_ret_safe (container literal, call
/// to a non-borrow-returning name); anything else -- excluded/absent names,
/// view calls, `perform`, ident chains that leave the spine -- resolves to
/// false, keeping the pre-#1915 safe fallback. The local-let ascription
/// wrapper `((__asc: T) -> __asc)(v)` (ascribe_wrap, parser_expr_dispatch)
/// is peeled first so an annotated binding classifies as its value. Callee
/// matching is one step at a time, and both loops are iterative -- see the
/// shape workarounds documented on tail_is_borrow_ret_safe.
fn spine_ident_returns_owned(known: MutSet[String], names: Array[String], vals: Array[Expr], excluded: Array[String], nm0: String) -> Bool {
  let mut nm = nm0
  let mut hops = 0
  let mut owned = false
  let mut done = false
  // The ident chain visits a fresh spine binding per hop (a repeated name
  // would have landed in `excluded` at collection), so the binding count
  // bounds the walk -- no fixed cap that could silently truncate a long
  // alias chain back into the safe (leaking) fallback.
  while !done && hops <= Array::length(names) {
    hops = hops + 1
    if array_contains_str_pctx(excluded, nm) {
      done = true
    } else {
      let mut idx = 0 - 1
      let mut i = 0
      while i < Array::length(names) {
        if Array::get(names, i) == nm {
          idx = i
        } else {
          ()
        }
        i = i + 1
      }
      if idx < 0 {
        done = true
      } else {
        let mut v = Array::get(vals, idx)
        let mut unwrapping = true
        while unwrapping {
          unwrapping = false
          match v {
            ECall(wc, wargs, _) =>
            match wc {
              EFn(_, _, wfps, _, _, wbody) => if Array::length(wfps) == 1 && Array::length(wargs) == 1 {
                let (wpn, _) = Array::get(wfps, 0)
                match wbody {
                  EIdent(bn, _) => if bn == wpn {
                    v = Array::get(wargs, 0)
                    unwrapping = true
                  } else {
                    ()
                  },
                  _ => ()
                }
              } else {
                ()
              },
              _ => ()
            },
            _ => ()
          }
        }
        match v {
          EArray(_) => {
            owned = true
            done = true
          },
          ETuple(_) => {
            owned = true
            done = true
          },
          ERecord(_, _, _) => {
            owned = true
            done = true
          },
          EMap(_) => {
            owned = true
            done = true
          },
          ECall(c2, _, _) =>
          match c2 {
            EIdent(f, _) => if f == "perform" || MutSet::has(known, f) {
              done = true
            } else {
              owned = true
              done = true
            },
            _ => {
              done = true
            }
          },
          EIdent(next_nm, _) => {
            nm = next_nm
          },
          _ => {
            done = true
          }
        }
      }
    }
  }
  owned
}

fn tail_is_borrow_ret_safe(known: MutSet[String], e0: Expr, spine_names: Array[String], spine_vals: Array[Expr], spine_excluded: Array[String]) -> Bool {
  // ADR-0090 / #1770: the worklist grows while being consumed in-place and
  // only the Bool verdict escapes, so its growth garbage goes to the region
  // arena (MutList) instead of the main heap. Bump lane only; under RC the
  // list degrades to a plain main-heap array with the same semantics.
  region r {
    let worklist = MutList::empty(r)
    MutList::push(worklist, e0)
    let mut all_safe = true
    let mut i = 0
    while i < MutList::length(worklist) {
      match MutList::get(worklist, i) {
        // #1915: an inner binding that reuses a spine name shadows it for any
        // ident tail walked after this point -- resolution through the spine
        // map would read the WRONG value, so retire the name (over-excluding
        // across sibling branches only ever restores the safe fallback).
        ELet(n, _, b, _) => {
          if array_contains_str_pctx(spine_names, n) {
            Array::push(spine_excluded, n)
          } else {
            ()
          }
          MutList::push(worklist, b)
        },
        ELetMut(n, _, b, _) => {
          if array_contains_str_pctx(spine_names, n) {
            Array::push(spine_excluded, n)
          } else {
            ()
          }
          MutList::push(worklist, b)
        },
        ELetRec(n, _, b) => {
          if array_contains_str_pctx(spine_names, n) {
            Array::push(spine_excluded, n)
          } else {
            ()
          }
          MutList::push(worklist, b)
        },
        ESeq(_, b) => MutList::push(worklist, b),
        EAssign(_, _, b) => MutList::push(worklist, b),
        EAssignOp(_, _, _, b) => MutList::push(worklist, b),
        EIf(_, t, el) => {
          MutList::push(worklist, t)
          MutList::push(worklist, el)
        },
        EMatch(_, arms) => {
          let mut ai = 0
          while ai < Array::length(arms) {
            let (p, ae) = Array::get(arms, ai)
            // #1915: pattern bindings shadow spine names the same way inner
            // lets do (see the ELet case above).
            let pnames: Array[String] = []
            pat_names(p, pnames)
            let mut pi = 0
            while pi < Array::length(pnames) {
              if array_contains_str_pctx(spine_names, Array::get(pnames, pi)) {
                Array::push(spine_excluded, Array::get(pnames, pi))
              } else {
                ()
              }
              pi = pi + 1
            }
            MutList::push(worklist, ae)
            ai = ai + 1
          }
        },
        ECall(callee_e, cargs, _) =>
        match callee_e {
          EIdent(callee, _) =>
          if callee == "perform" && Array::length(cargs) == 1 {
            // #640 Stage 2: `throw(x)` now parses to `perform Exception::Throw(x)`,
            // so the #715 throwing-tail exemption below (EThrow) must also
            // recognize this shape — a throwing tail never produces a value, so
            // it cannot violate the borrow-returning invariant. Without this,
            // every `match x { Ctor(..) => field, _ => throw(..) }` accessor is
            // again rejected as borrow-returning and the #715 same-address
            // double-free returns. Matched step-by-step (NOT one nested
            // ECall(EIdent(..)) pattern) per the workaround note above.
            let mut op_is_throw = false
            match Array::get(cargs, 0) {
              ECall(op_e, _, _) =>
              match op_e {
                EIdent(op_n, _) => if is_exception_throw_operation(op_n) {
                  op_is_throw = true
                } else {
                  ()
                },
                _ => ()
              },
              _ => ()
            }
            if op_is_throw {
              ()
            } else if !MutSet::has(known, callee) {
              all_safe = false
            } else {
              ()
            }
          } else if !MutSet::has(known, callee) {
            all_safe = false
          } else {
            ()
          },
          _ => {
            all_safe = false
          }
        },
        // #1915: a bare ident tail resolving to a spine binding that provably
        // holds an owned heap value (builder/literal/owned call) rejects the
        // function -- callers must keep their scope-end drop. Sentinels,
        // params, views, and unresolvable names keep the safe fallback.
        EIdent(nm, _) => if spine_ident_returns_owned(known, spine_names, spine_vals, spine_excluded, nm) {
          all_safe = false
        } else {
          ()
        },
        // #715: a throwing tail (the ubiquitous `match x { Ctor(..) => field, _
        // => throw("not X") }` shape used by every common_extractors.vibe
        // accessor) never actually produces a value along that path, so it
        // cannot violate the borrow-returning invariant -- there is nothing to
        // mismanage. Without this, EVERY such accessor (get_efn_params,
        // get_efn_body, get_ecall_args, ...) fell through to the catch-all
        // below and was rejected solely because of its own error arm, even
        // though its real (non-throwing) arm is a plain borrowed field
        // projection. That misclassification made the caller treat the
        // extracted field as an independently owned value while the
        // scrutinee's own later structural drop also reclaims it -- a
        // same-address double-free (the #715 self-hosting free-list
        // corruption).
        _ => {
          all_safe = false
        }
      }
      i = i + 1
    }
    all_safe
  }
}

/// Strip let/seq/assign wrappers, same as tail_is_borrow_ret_safe, to find the
/// expression whose SHAPE decides eligibility at the top level.
fn strip_wrappers_for_borrow_ret(e: Expr) -> Expr {
  match e {
    ELet(_, _, b, _) => strip_wrappers_for_borrow_ret(b),
    ELetMut(_, _, b, _) => strip_wrappers_for_borrow_ret(b),
    ELetRec(_, _, b) => strip_wrappers_for_borrow_ret(b),
    ESeq(_, b) => strip_wrappers_for_borrow_ret(b),
    EAssign(_, _, b) => strip_wrappers_for_borrow_ret(b),
    EAssignOp(_, _, _, b) => strip_wrappers_for_borrow_ret(b),
    _ => e
  }
}

/// The two Map iterator accessors have source-ownership guards in both linear
/// and GC codegen. If source binds either exact name, its body -- not the
/// compiler intrinsic -- determines whether the result is borrowed.
/// Return a two-bit mask in one statement scan: bit 0 is the checked accessor,
/// bit 1 is the unchecked accessor. This runs on every linked compile, so do
/// not scan the compiler-sized statement array once per builtin seed.
fn source_owned_shadowable_borrow_mask(stmts: Array[Stmt]) -> Int {
  let mut mask = 0
  let mut i = 0
  while i < Array::length(stmts) && mask != 3 {
    let bound = match Array::get(stmts, i) {
      SLet(_, _, name, _, _) => name,
      SFnDecl(_, name, _, _, _) => name,
      _ => ""
    }
    if bound == "Map::iter_get" {
      mask = mask|1
    } else if bound == "Map::__iter_get_unchecked" {
      mask = mask|2
    } else {
      ()
    }
    i = i + 1
  }
  mask
}

fn source_owns_shadowable_borrow_builtin(mask: Int, name: String) -> Bool {
  if name == "Map::iter_get" {
    (mask&1) != 0
  } else if name == "Map::__iter_get_unchecked" {
    (mask&2) != 0
  } else {
    false
  }
}

export fn compute_borrow_returning_names(stmts: Array[Stmt]) -> Array[String] {
  // Seeded from the shared single-source-of-truth list (#1979) -- a seed that
  // drifts from is_borrow_ret_builtin (MutList::get was missing until #1932
  // review) makes both the inline branch-tail check and the #1915
  // spine-binding resolution classify that builtin's result as owned, and RC
  // callers then drop an interior view. Source-owned shadowable names are
  // removed before the fixed point and may re-enter only when their bodies
  // actually return a borrowed view.
  let builtin_names = borrow_ret_builtin_names()
  let known: Array[String] = []
  // #2386: `known` is queried per statement per round and per callee inside
  // `tail_is_borrow_ret_safe`; the set answers those, the array keeps the
  // insertion order the result is read in.
  let known_set = MutSet::new_string()
  let source_owned_mask = source_owned_shadowable_borrow_mask(stmts)
  let mut seed_i = 0
  while seed_i < Array::length(builtin_names) {
    let builtin_name = Array::get(builtin_names, seed_i)
    if !source_owns_shadowable_borrow_builtin(source_owned_mask, builtin_name) {
      Array::push(known, builtin_name)
      MutSet::add(known_set, builtin_name)
    } else {
      ()
    }
    seed_i = seed_i + 1
  }
  let mut changed = true
  while changed {
    changed = false
    let mut i = 0
    while i < Array::length(stmts) {
      match Array::get(stmts, i) {
        SLet(_, _, name, _, value) =>
        if !MutSet::has(known_set, name) {
          match value {
            EFn(_, _, _, _, _, body) => {
              // A function is borrow-returning only if its (wrapper-stripped)
              // top-level shape is itself a call/if/match reaching a known
              // borrow-return name on every branch -- a BARE identifier tail
              // at the *top level* (an identity-like function) is NOT eligible
              // here even though tail_is_borrow_ret_safe accepts a bare ident
              // as a safe fallback *inside* an if/match branch (e.g. peek's
              // `else TEof`). This keeps `let f = (x) -> T { x }` (a genuine
              // passthrough of a normally-owned argument) from being
              // misclassified as a Array::get-style borrowed view.
              let top = strip_wrappers_for_borrow_ret(body)
              let eligible_shape = match top {
                ECall(_, _, _) => true,
                EIf(_, _, _) => true,
                EMatch(_, _) => true,
                _ => false
              }
              if eligible_shape {
                // #1915: the spine bindings resolve bare ident branch tails
                // to the values they name (see tail_is_borrow_ret_safe).
                let sp_names: Array[String] = []
                let sp_vals: Array[Expr] = []
                let sp_excluded: Array[String] = []
                let _ = collect_spine_let_vals(body, sp_names, sp_vals, sp_excluded)
                if tail_is_borrow_ret_safe(known_set, top, sp_names, sp_vals, sp_excluded) {
                  Array::push(known, name)
                  MutSet::add(known_set, name)
                  changed = true
                } else {
                  ()
                }
              } else {
                ()
              }
            },
            _ => ()
          }
        } else {
          ()
        },
        _ => ()
      }
      i = i + 1
    }
  }
  known
}

/// A top-level function's declared return type, from its `let f: (T1,...) ->
/// R = ...` signature -- `None` when untyped (no signature to consult).
fn fn_sig_return_type(ty: Option[TypeExpr]) -> Option[TypeExpr] {
  match ty {
    Some(t) =>
    match t {
      TyFn(_, ret, _) => Some(ret),
      _ => None
    },
    None => None
  }
}

/// #710 out-param crash: `let n = f(...)` for a user function `f` whose body
/// is not one of the 3 hardcoded borrow-returning builtins falls through to
/// `heap_binding_names`'s default -- "any non-borrow-ret call result is heap"
/// (compile_expr_tail.vibe's ELet ECall branch; see that struct field's own
/// doc comment, which already promises "we never touch a non-heap (e.g.
/// Int-returning call) binding"). When `f` actually returns a scalar (Int/
/// Bool/Unit) -- e.g. `build_import_plan(...) -> Int` -- the binding is a
/// plain integer, not a tagged heap pointer. If that binding is later
/// ALIASED more than once (`let a = n; let b = n`), the Perceus plan schedules
/// a PaAliasDup for the 2nd+ alias, and compile_expr_tail.vibe's `is_eident`
/// branch used to call the unguarded `emit_rc_dup_local` on it: untag (AND -2)
/// then read/write 4 bytes before the "pointer". For a small scalar like 0
/// that computes a near-null address -- `RuntimeError: memory access out of
/// bounds`, not a leak (component_codegen_test.vibe's "component async: sync
/// lift" hit this via `import_func_count` aliased into run_core_func_idx/
/// run_type_idx/run_func_idx). That call site now uses the runtime-tag-checked
/// `emit_rc_dup_guarded` instead (a misclassified scalar is a silent no-op
/// there rather than a wild write) -- this was the one remaining unguarded RC
/// increment anywhere in codegen, so it is now fixed on general principle even
/// though it was empirically NOT the cause of the *other* still-open #709
/// self-hosting crash (a free-list node with corrupted size/next fields,
/// surfacing later inside `fn_type_param_types`'s `vibe_rc_alloc`; confirmed via a
/// differential rebuild that the crash persists byte-for-byte unchanged with
/// this fix in place). Names collected here still matter for perf/precision
/// (avoiding unnecessary heap_binding_names churn) and let the ELet ECall
/// branch skip `heap_binding_names` for a call whose declared return type is
/// provably scalar, matching the exemption the field's own doc comment already
/// describes. Untyped functions are conservatively left out (stay in the
/// existing heap over-approximation) since there is no signature to consult --
/// no longer a correctness cliff-edge now that the alias-dup site is guarded,
/// only a missed optimization.
export fn compute_scalar_returning_names(stmts: Array[Stmt]) -> Array[String] {
  let out: Array[String] = []
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SLet(_, _, name, ty, value) =>
      match value {
        EFn(_, _, _, _, _, _) =>
        match fn_sig_return_type(ty) {
          Some(ret) =>
          if !type_expr_is_heap(Some(ret)) {
            Array::push(out, name)
          } else {
            ()
          },
          None => ()
        },
        _ => ()
      },
      _ => ()
    }
    i = i + 1
  }
  out
}

fn is_scalar_expr(ctx: PCtx, e: Expr) -> Bool {
  match e {
    EInt(_) => true,
    EBool(_) => true,
    EFloat(_) => true,
    EUnit => true,
    ECall(EIdent(fname, _), _, _) => fname == "Stdin::read_via_stream" || is_borrow_ret_fname(ctx, fname),
    _ => false
  }
}

fn pat_shadow_env(pat: Pat, env: Map[String, Bool]) -> Map[String, Bool] {
  let names: Array[String] = []
  pat_names(pat, names)
  let mut env2 = env
  let mut j = 0
  while j < Array::length(names) {
    env2 = Map::set(env2, Array::get(names, j), false)
    j = j + 1
  }
  env2
}

fn restore_prefix(dst: Array[Int], src: Array[Int]) -> Int {
  let mut i = 0
  while i < Array::length(src) {
    Array::set(dst, i, Array::get(src, i))
    i = i + 1
  }
  0
}

fn is_heap_literal(e: Expr) -> Bool {
  match e {
    ETuple(_) => true,
    EArray(_) => true,
    ERecord(_, _, _) => true,
    _ => false
  }
}

fn is_heap_value(e: Expr, env: Map[String, Bool], hctx: HeapInferCtx) -> Bool {
  if is_heap_literal(e) {
    true
  } else {
    match e {
      ECall(callee, args, _) =>
      match callee {
        EIdent(c, _) =>
        if Map::has_key(env, c) {
          false
        } else {
          (Array::length(args) > 0 && name_in(hctx.ctors, c)) ||
          name_in(hctx.heap_fns, c)
        },
        _ => false
      },
      _ => false
    }
  }
}

fn arg_class(arg: Expr, env: Map[String, Bool], hctx: HeapInferCtx) -> Bool {
  if is_heap_value(arg, env, hctx) {
    true
  } else {
    match arg {
      EIdent(n, _) => if Map::has_key(env, n) {
        Map::get(env, n)
      } else {
        false
      },
      _ => false
    }
  }
}

fn analyze_calls(name: String, e_in: Expr, env_in: Map[String, Bool], calls: Array[Array[Bool]], esc: Array[Bool], hctx: HeapInferCtx) -> Int {
  // #556: iterate the let / seq / assign "spine" instead of recursing on its
  // tail, so a deeply-nested (flattened) expression — e.g. the whole compiler
  // compiled as a single unit under RC — no longer exhausts the wasm stack in
  // this pass. The shallow side of each spine node is still analyzed
  // recursively; the visit order and env threading are identical to the former
  // pure recursion (fixpoint-verified), so the RC analysis result is unchanged.
  let mut e = e_in
  let mut env = env_in
  let mut looping = true
  while looping {
    looping = false
    match e {
      EIdent(n, _) => {
        if n == name {
          Array::set(esc, 0, true)
        } else {
          ()
        }
        0
      },
      ECall(callee, args, _) => {
        let is_self = match callee {
          EIdent(cn, _) => cn == name,
          _ => false
        }
        if is_self {
          let cls: Array[Bool] = []
          let mut k = 0
          while k < Array::length(args) {
            Array::push(cls, arg_class(Array::get(args, k), env, hctx))
            k = k + 1
          }
          Array::push(calls, cls)
        } else {
          let _ = analyze_calls(name, callee, env, calls, esc, hctx)
          ()
        }
        let mut i = 0
        while i < Array::length(args) {
          analyze_calls(name, Array::get(args, i), env, calls, esc, hctx)
          i = i + 1
        }
        0
      },
      EDot(obj, _, _, _) => analyze_calls(name, obj, env, calls, esc, hctx),
      ELet(n, v, b, _) => {
        analyze_calls(name, v, env, calls, esc, hctx)
        env = Map::set(env, n, is_heap_value(v, env, hctx))
        e = b
        looping = true
      },
      ELetRec(n, v, b) => {
        env = Map::set(env, n, false)
        analyze_calls(name, v, env, calls, esc, hctx)
        e = b
        looping = true
      },
      ELetMut(n, v, b, _) => {
        analyze_calls(name, v, env, calls, esc, hctx)
        env = Map::set(env, n, false)
        e = b
        looping = true
      },
      EAssign(_, v, c) => {
        analyze_calls(name, v, env, calls, esc, hctx)
        e = c
        looping = true
      },
      EAssignOp(_, _, v, c) => {
        analyze_calls(name, v, env, calls, esc, hctx)
        e = c
        looping = true
      },
      ESeq(a, b) => {
        analyze_calls(name, a, env, calls, esc, hctx)
        e = b
        looping = true
      },
      EIf(c, t, el) => {
        analyze_calls(name, c, env, calls, esc, hctx)
        analyze_calls(name, t, env, calls, esc, hctx)
        analyze_calls(name, el, env, calls, esc, hctx)
        0
      },
      EWhile(c, b) => {
        analyze_calls(name, c, env, calls, esc, hctx)
        analyze_calls(name, b, env, calls, esc, hctx)
        0
      },
      EForIn(v0, ix, it, b) => {
        analyze_calls(name, it, env, calls, esc, hctx)
        let env1 = Map::set(env, v0, false)
        let env2 = match ix {
          Some(ixn) => Map::set(env1, ixn, false),
          None => env1
        }
        analyze_calls(name, b, env2, calls, esc, hctx)
        0
      },
      EBinOp(_, l, r, _) => {
        analyze_calls(name, l, env, calls, esc, hctx)
        analyze_calls(name, r, env, calls, esc, hctx)
        0
      },
      EUnaryOp(_, o) => analyze_calls(name, o, env, calls, esc, hctx),
      EFn(_, _, params, _, _, b) => {
        let mut env2 = env
        let mut pi = 0
        while pi < Array::length(params) {
          let (pn, _) = Array::get(params, pi)
          env2 = Map::set(env2, pn, false)
          pi = pi + 1
        }
        analyze_calls(name, b, env2, calls, esc, hctx)
        0
      },
      ETuple(xs) => {
        let mut i = 0
        while i < Array::length(xs) {
          analyze_calls(name, Array::get(xs, i), env, calls, esc, hctx)
          i = i + 1
        }
        0
      },
      EArray(xs) => {
        let mut i = 0
        while i < Array::length(xs) {
          analyze_calls(name, Array::get(xs, i), env, calls, esc, hctx)
          i = i + 1
        }
        0
      },
      EMatch(s, arms) => {
        analyze_calls(name, s, env, calls, esc, hctx)
        let mut i = 0
        while i < Array::length(arms) {
          let (pat, ab) = Array::get(arms, i)
          analyze_calls(name, ab, pat_shadow_env(pat, env), calls, esc, hctx)
          i = i + 1
        }
        0
      },
      EHandle(b, arms) => {
        analyze_calls(name, b, env, calls, esc, hctx)
        let mut i = 0
        while i < Array::length(arms) {
          let (pat, ab) = Array::get(arms, i)
          analyze_calls(name, ab, pat_shadow_env(pat, env), calls, esc, hctx)
          i = i + 1
        }
        0
      },
      ELoop(ps, b) => {
        let mut env2 = env
        let mut i = 0
        while i < Array::length(ps) {
          let (pn, iv) = Array::get(ps, i)
          analyze_calls(name, iv, env2, calls, esc, hctx)
          env2 = Map::set(env2, pn, false)
          i = i + 1
        }
        analyze_calls(name, b, env2, calls, esc, hctx)
        0
      },
      ERecord(_, fs, _) => {
        let mut i = 0
        while i < Array::length(fs) {
          let (_, fv) = Array::get(fs, i)
          analyze_calls(name, fv, env, calls, esc, hctx)
          i = i + 1
        }
        0
      },
      EMap(fs) => {
        let mut i = 0
        while i < Array::length(fs) {
          let (_, fv) = Array::get(fs, i)
          analyze_calls(name, fv, env, calls, esc, hctx)
          i = i + 1
        }
        0
      },
      ELabeledArg(_, _, x) => analyze_calls(name, x, env, calls, esc, hctx),
      EReturn(x) => analyze_calls(name, x, env, calls, esc, hctx),
      ESpread(x) => analyze_calls(name, x, env, calls, esc, hctx),
      EBreak(o) =>
      match o {
        Some(x) => analyze_calls(name, x, env, calls, esc, hctx),
        None => 0
      },
      EContinue(xs) => {
        let mut i = 0
        while i < Array::length(xs) {
          analyze_calls(name, Array::get(xs, i), env, calls, esc, hctx)
          i = i + 1
        }
        0
      },
      EInt(_) => 0,
      EFloat(_) => 0,
      EString(_) => 0,
      EBool(_) => 0,
      EStringInterp(_) => 0,
      EUnit => 0
    }
  }
  0
}

/// An alias-attributed dup: `let a = t` where `t` is multiply-used and owned.
/// Keyed by the alias name.
export fn pa_is_alias_dup(a: PerceusAction) -> Bool {
  match a.kind {
    PaAliasDup => true,
    _ => false
  }
}

fn pc_count_borrow(ctx: PCtx, scope: Map[String, Int], name: String) -> Int {
  if Map::has_key(scope, name) {
    let id = Map::get(scope, name)
    Array::set(ctx.borrows, id, Array::get(ctx.borrows, id) + 1)
  }
  0
}

fn type_contains_fn(t: TypeExpr) -> Bool {
  match t {
    TyFn(_, _, _) => true,
    TyTuple(elems) => {
      let mut i = 0
      let mut found = false
      while i < Array::length(elems) {
        if type_contains_fn(Array::get(elems, i)) {
          found = true
        } else {
          ()
        }
        i = i + 1
      }
      found
    },
    TyApp(_, args) => {
      let mut i = 0
      let mut found = false
      while i < Array::length(args) {
        if type_contains_fn(Array::get(args, i)) {
          found = true
        } else {
          ()
        }
        i = i + 1
      }
      found
    },
    TyName(_) => false,
    TyUnit => false
  }
}

fn all_calls_heap_at(idx: Int, calls: Array[Array[Bool]]) -> Bool {
  let mut ci = 0
  let mut all_heap = true
  while ci < Array::length(calls) {
    let cls = Array::get(calls, ci)
    if idx >= Array::length(cls) {
      all_heap = false
    } else if !Array::get(cls, idx) {
      all_heap = false
    } else {
      ()
    }
    ci = ci + 1
  }
  all_heap
}

fn type_name_is_heap(n: String) -> Bool {
  if String::length(n) == 0 {
    false
  } else {
    let c0 = String::char_code_at(n, 0)
    if c0 < 'A' || c0 > 'Z' {
      false
    } else if n == "Int" || n == "Bool" || n == "Double" || n == "Float" || n == "String" || n == "Bytes" || n == "Char" || n == "Unit" || n == "StdinStream" {
      false
    } else {
      true
    }
  }
}

export fn type_expr_is_heap(ot: Option[TypeExpr]) -> Bool {
  match ot {
    None => false,
    Some(t) =>
    match t {
      // #702: a bare function-typed binding/param is a closure — heap when it
      // captures (an odd RC block), a scalar constant when it doesn't. Treating
      // it as heap lets the owning function drop it (vibe_rc_drop's odd-check makes
      // the non-capturing constant a no-op), reclaiming capturing closures passed
      // as arguments to higher-order fns instead of leaking them.
      TyFn(_, _, _) => true,
      _ =>
      if type_contains_fn(t) {
        false
      } else {
        match t {
          TyTuple(_) => true,
          TyApp(_, _) => true,
          TyName(n) => type_name_is_heap(n),
          TyFn(_, _, _) => false,
          TyUnit => false
        }
      }
    }
  }
}

/// #791: program-wide (name of every top-level function whose DECLARED return
/// type is heap), mirroring compute_agg_returning's scan but reading
/// type_expr_is_heap instead of agg_info_of_type_expr. This is the "read the
/// declared signature" alternative to threading checker-inferred types
/// through codegen: `let mut s = Set::new()` can be classified correctly by
/// looking up `Set::new`'s OWN `-> Set[T]` annotation (already sitting on the
/// AST, no unification/inference needed) instead of guessing from the RHS
/// expression's shape. Only covers named, annotated top-level functions --
/// classify_let_value_heap (compile_expr_tail.vibe) falls back to its
/// existing "any ECall is heap by default" over-approximation when a callee
/// isn't found here (unannotated function, local closure, shadowed name),
/// so this is a precision refinement, not a completeness requirement.
export fn compute_heap_returning(stmts: Array[Stmt]) -> Array[String] {
  let out: Array[String] = []
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SLet(_, _, name, ann, value) => match value {
        EFn(_, _, _, fn_ret, _, _) => {
          let ret = match ann {
            Some(at) => match at {
              TyFn(_, r, _) => Some(r),
              _ => fn_ret
            },
            None => fn_ret
          }
          if type_expr_is_heap(ret) {
            Array::push(out, name)
          } else {
            ()
          }
        },
        _ => ()
      },
      _ => ()
    }
    i = i + 1
  }
  out
}

fn collect_ctor_names(stmts: Array[Stmt]) -> Array[String] {
  let out: Array[String] = []
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SEnum(_, _, _, variants, _) => {
        let mut j = 0
        while j < Array::length(variants) {
          let (vn, _) = Array::get(variants, j)
          Array::push(out, vn)
          j = j + 1
        }
      },
      SSuberror(_, _, variants) => {
        let mut j = 0
        while j < Array::length(variants) {
          let (vn, _) = Array::get(variants, j)
          Array::push(out, vn)
          j = j + 1
        }
      },
      _ => ()
    }
    i = i + 1
  }
  out
}

fn inferred_heap_type() -> TypeExpr {
  TyTuple(array_empty())
}

fn fill_lambda_params(name: String, efn: Expr, body: Expr, hctx: HeapInferCtx) -> Expr {
  match efn {
    EFn(tps, bounds, params, ret, eff, fnbody) => {
      let calls: Array[Array[Bool]] = []
      let esc = [false]
      let env0: Map[String, Bool] = Map::new()
      analyze_calls(name, body, env0, calls, esc, hctx)
      if Array::get(esc, 0) || Array::length(calls) == 0 {
        efn
      } else {
        let new_params = Array::slice(params, 0, 0)
        let mut pi = 0
        while pi < Array::length(params) {
          let (pname, pty) = Array::get(params, pi)
          let filled = match pty {
            Some(_) => (pname, pty),
            None =>
            if all_calls_heap_at(pi, calls) {
              (pname, Some(inferred_heap_type()))
            } else {
              (pname, pty)
            }
          }
          Array::push(new_params, filled)
          pi = pi + 1
        }
        EFn(tps, bounds, new_params, ret, eff, fnbody)
      }
    },
    _ => efn
  }
}

fn elaborate_rw(e: Expr, hctx: HeapInferCtx) -> Expr {
  match e {
    ELet(n, v, b, soff) => {
      let v2 = elaborate_rw(v, hctx)
      let v3 = fill_lambda_params(n, v2, b, hctx)
      ELet(n, v3, elaborate_rw(b, hctx), soff)
    },
    ELetRec(n, v, b) => {
      let v2 = elaborate_rw(v, hctx)
      let v3 = fill_lambda_params(n, v2, b, hctx)
      ELetRec(n, v3, elaborate_rw(b, hctx))
    },
    ELetMut(n, v, b, soff) => ELetMut(n, elaborate_rw(v, hctx), elaborate_rw(b, hctx), soff),
    EAssign(n, v, c) => EAssign(n, elaborate_rw(v, hctx), elaborate_rw(c, hctx)),
    EAssignOp(n, op, v, c) => EAssignOp(n, op, elaborate_rw(v, hctx), elaborate_rw(c, hctx)),
    ESeq(a, b) => ESeq(elaborate_rw(a, hctx), elaborate_rw(b, hctx)),
    EIf(c, t, el) => EIf(elaborate_rw(c, hctx), elaborate_rw(t, hctx), elaborate_rw(el, hctx)),
    EWhile(c, b) => EWhile(elaborate_rw(c, hctx), elaborate_rw(b, hctx)),
    EForIn(n, ix, it, b) => EForIn(n, ix, elaborate_rw(it, hctx), elaborate_rw(b, hctx)),
    EFn(tps, bounds, params, ret, eff, fb) =>
    EFn(tps, bounds, params, ret, eff, elaborate_rw(fb, hctx)),
    ECall(callee, args, off) => {
      let new_args = Array::slice(args, 0, 0)
      let mut i = 0
      while i < Array::length(args) {
        Array::push(new_args, elaborate_rw(Array::get(args, i), hctx))
        i = i + 1
      }
      ECall(elaborate_rw(callee, hctx), new_args, off)
    },
    EBinOp(op, l, r, boff) => EBinOp(op, elaborate_rw(l, hctx), elaborate_rw(r, hctx), boff),
    EUnaryOp(op, o) => EUnaryOp(op, elaborate_rw(o, hctx)),
    EDot(o, f, off, fdoff) => EDot(elaborate_rw(o, hctx), f, off, fdoff),
    ETuple(xs) => {
      let ys = Array::slice(xs, 0, 0)
      let mut i = 0
      while i < Array::length(xs) {
        Array::push(ys, elaborate_rw(Array::get(xs, i), hctx))
        i = i + 1
      }
      ETuple(ys)
    },
    EArray(xs) => {
      let ys = Array::slice(xs, 0, 0)
      let mut i = 0
      while i < Array::length(xs) {
        Array::push(ys, elaborate_rw(Array::get(xs, i), hctx))
        i = i + 1
      }
      EArray(ys)
    },
    EMatch(s, arms) => {
      let new_arms = Array::slice(arms, 0, 0)
      let mut i = 0
      while i < Array::length(arms) {
        let (p, ab) = Array::get(arms, i)
        Array::push(new_arms, (p, elaborate_rw(ab, hctx)))
        i = i + 1
      }
      EMatch(elaborate_rw(s, hctx), new_arms)
    },
    EHandle(b, arms) => {
      let new_arms = Array::slice(arms, 0, 0)
      let mut i = 0
      while i < Array::length(arms) {
        let (p, ab) = Array::get(arms, i)
        Array::push(new_arms, (p, elaborate_rw(ab, hctx)))
        i = i + 1
      }
      EHandle(elaborate_rw(b, hctx), new_arms)
    },
    ELoop(ps, b) => {
      let new_ps = Array::slice(ps, 0, 0)
      let mut i = 0
      while i < Array::length(ps) {
        let (pn, iv) = Array::get(ps, i)
        Array::push(new_ps, (pn, elaborate_rw(iv, hctx)))
        i = i + 1
      }
      ELoop(new_ps, elaborate_rw(b, hctx))
    },
    ERecord(rn, fs, targs) => {
      let new_fs = Array::slice(fs, 0, 0)
      let mut i = 0
      while i < Array::length(fs) {
        let (fn0, fv) = Array::get(fs, i)
        Array::push(new_fs, (fn0, elaborate_rw(fv, hctx)))
        i = i + 1
      }
      ERecord(rn, new_fs, targs)
    },
    EMap(fs) => {
      let new_fs = Array::slice(fs, 0, 0)
      let mut i = 0
      while i < Array::length(fs) {
        let (fn0, fv) = Array::get(fs, i)
        Array::push(new_fs, (fn0, elaborate_rw(fv, hctx)))
        i = i + 1
      }
      EMap(new_fs)
    },
    ELabeledArg(l, k, x) => ELabeledArg(l, k, elaborate_rw(x, hctx)),
    EReturn(x) => EReturn(elaborate_rw(x, hctx)),
    ESpread(x) => ESpread(elaborate_rw(x, hctx)),
    EBreak(o) =>
    match o {
      Some(x) => EBreak(Some(elaborate_rw(x, hctx))),
      None => EBreak(None)
    },
    EContinue(xs) => {
      let ys = Array::slice(xs, 0, 0)
      let mut i = 0
      while i < Array::length(xs) {
        Array::push(ys, elaborate_rw(Array::get(xs, i), hctx))
        i = i + 1
      }
      EContinue(ys)
    },
    EInt(_) => e,
    EFloat(_) => e,
    EString(_) => e,
    EBool(_) => e,
    EIdent(_, _) => e,
    EStringInterp(_) => e,
    EUnit => e
  }
}

/// Bit i means parameter i of this callee is borrowed. Mirrors
/// bmask_has/md_borrow_mask_of in codegen/common_analysis.
fn pe_bmask_has(mask: Int, i: Int) -> Bool {
  i >= 0 && i < 32 && ((mask>>i)&1) == 1
}

/// The borrowed-parameter mask for callee `f`, honoring lexical scope: a
/// LOCAL binding that shadows a borrow-set name is an ordinary owned
/// closure call (mirrors compile_call's #875 local_idx_hint guard).
fn pe_borrow_mask(ctx: PCtx, scope: Map[String, Int], callee: Expr) -> Int {
  match callee {
    EIdent(f, _) => if Map::has_key(scope, f) {
      0
    } else {
      md_borrow_mask_of(f, ctx.borrow_param_user, ctx.borrow_param_mask)
    },
    _ => 0
  }
}

export fn pc_emit(ctx: PCtx, scope: Map[String, Int], expr: Expr) -> Int {
  match expr {
    EInt(_) => 0,
    EFloat(_) => 0,
    EString(_) => 0,
    EBool(_) => 0,
    EUnit => 0,
    EStringInterp(_) => 0,
    EIdent(x, off) => pe_use(ctx, scope, x, off),
    ECall(callee, args, _) => {
      // Same lexical-shadow guard as pc_count (and compile_call #875).
      let bmask = pe_borrow_mask(ctx, scope, callee)
      match callee {
        EIdent(_, _) => 0,
        _ => pc_emit(ctx, scope, callee)
      }
      let mut i = 0
      while i < Array::length(args) {
        let arg = Array::get(args, i)
        if pe_bmask_has(bmask, i) {
          match arg {
            EIdent(_, _) => 0,
            _ => pc_emit(ctx, scope, arg)
          }
        } else {
          pc_emit(ctx, scope, arg)
        }
        i = i + 1
      }
      0
    },
    EDot(obj, _field, _, _) => match obj {
      EIdent(_, _) => 0,
      _ => pc_emit(ctx, scope, obj)
    }
    ,
    ELet(name, value, body, _) => {
      let mut elide_dead_alias = false
      match value {
        EIdent(src, src_off) => {
          if Map::has_key(scope, src) {
            let sid = Map::get(scope, src)
            let rem = Array::get(ctx.remaining, sid)
            // ADR-0092 per-use pairing: mirror pe_use -- an alias of a
            // view-call binding must also dup at the source's LAST use
            // (there is no initial owned reference to transfer), so the
            // alias always ACQUIRES ownership and needs no view marking
            // of its own.
            let src_last_view = rem == 1 && Array::get(ctx.view_call_let, sid)
            if (rem > 1 || src_last_view) && !Array::get(ctx.scalar, sid) {
              // #1056 (almide `alias_safety.rs` comparison, rc check
              // elision): this occurrence of `let name = src` would dup
              // src's reference into `name`'s own slot. `ctx.next_id` is
              // about to become `name`'s id (pe_declare below); `ctx.uses`
              // at that id already holds `name`'s FINAL use count from the
              // pc_count pass (borrow occurrences folded in by
              // pctx_apply_borrow_retention, which runs before pc_emit
              // starts) -- ids are assigned in identical tree order across
              // both passes (see build_perceus_plan), so this id is exactly
              // the one pc_count computed uses for. If that count is zero,
              // `name` has NO occurrence anywhere in `body` (no owning use,
              // no borrow): the dup this occurrence would emit and the
              // unconditional scope-end drop `name` would otherwise get
              // (pe_scope_end -- an unused non-scalar binding always keeps
              // its one owned reference) are a pure no-op pair on the SAME
              // memory with no intervening read -- increment then
              // decrement, nothing observes the difference. Skipping both
              // (no PaAliasDup here; `name`'s own `remaining` is zeroed
              // right after pe_declare below so pe_scope_end's `remaining >
              // 0` check does not fire) removes one dup + one drop of
              // runtime rc traffic with no change in observable behavior.
              // `src`'s own remaining-use bookkeeping is untouched (still
              // decremented below exactly as without this elision) -- this
              // occurrence still "spends" one of src's owning uses,
              // precisely as if the dup had fired, so src's later
              // occurrences / scope-end drop are unaffected.
              if Array::get(ctx.uses, ctx.next_id) == 0 {
                elide_dead_alias = true
                0
              } else {
                pe_push_for(ctx, PaAliasDup, name, ctx.next_id, src_off)
              }
            } else {
              0
            }
            if rem > 0 {
              Array::set(ctx.remaining, sid, rem - 1)
            }
          } else {
            ()
          }
          0
        },
        _ => pc_emit(ctx, scope, value)
      }
      let id = pe_declare(ctx, name)
      if elide_dead_alias {
        Array::set(ctx.remaining, id, 0)
      }
      pc_emit(ctx, Map::set(scope, name, id), body)
      pe_scope_end(ctx, id, name)
    },
    ELetMut(name, value, body, _) => {
      pc_emit(ctx, scope, value)
      let id = pe_declare(ctx, name)
      pc_emit(ctx, Map::set(scope, name, id), body)
      pe_scope_end(ctx, id, name)
    },
    ELetRec(name, value, body) => {
      let id = pe_declare(ctx, name)
      let s2 = Map::set(scope, name, id)
      pc_emit(ctx, s2, value)
      pc_emit(ctx, s2, body)
      pe_scope_end(ctx, id, name)
    },
    EAssign(_name, value, body) => {
      pc_emit(ctx, scope, value)
      pc_emit(ctx, scope, body)
    },
    EAssignOp(_name, _op, value, body) => {
      pc_emit(ctx, scope, value)
      pc_emit(ctx, scope, body)
    },
    ESeq(a, b) => {
      pc_emit(ctx, scope, a)
      let nm = next_seq_name(ctx)
      let id = pe_declare(ctx, nm)
      pc_emit(ctx, scope, b)
      pe_scope_end(ctx, id, nm)
    },
    EBinOp(_op, l, r, _) => {
      pc_emit(ctx, scope, l)
      pc_emit(ctx, scope, r)
    },
    EUnaryOp(_op, e) => pc_emit(ctx, scope, e),
    ETuple(items) => {
      let mut i = 0
      while i < Array::length(items) {
        pc_emit(ctx, scope, Array::get(items, i))
        i = i + 1
      }
      0
    },
    EArray(items) => {
      let mut i = 0
      while i < Array::length(items) {
        pc_emit(ctx, scope, Array::get(items, i))
        i = i + 1
      }
      0
    },
    ERecord(_, fields, _) => {
      let mut i = 0
      while i < Array::length(fields) {
        pc_emit(ctx, scope, (Array::get(fields, i)).1)
        i = i + 1
      }
      0
    },
    EMap(fields) => {
      let mut i = 0
      while i < Array::length(fields) {
        pc_emit(ctx, scope, (Array::get(fields, i)).1)
        i = i + 1
      }
      0
    },
    EIf(cond, then_e, else_e) => {
      pc_emit(ctx, scope, cond)
      // #1915 mechanism 3: `if c { out } else { out }` — every branch the
      // SAME bare ident — is ONE owned use at runtime, whichever branch
      // executes. Walking both branches pushed one PaDup per branch whenever
      // remaining > 1 at branch entry (exactly what the #706 borrow-retention
      // bump produces for a loop borrow-use), and codegen realizes every
      // planned dup unconditionally at the binding's declaration site
      // (rc_dup_names occurrence count) — the summed budget leaked one owned
      // object per call for the standard `builder loop + if/else tail`
      // shape. Walk the use once instead: the final `remaining` is identical
      // to the old snap/min dance (each branch decremented by exactly one),
      // only the duplicate sibling dup disappears. Anything but this exact
      // shape keeps the general per-branch walk below unchanged.
      if eif_same_ident_branches(then_e, else_e) {
        // This action represents either branch, not the first branch's
        // concrete syntax node. Keep it on the declaration-site fallback
        // until codegen can represent a set of alternative use sites.
        match then_e {
          EIdent(name, _) => pe_use(ctx, scope, name, -1),
          _ => 0
        }
      } else {
        let n = Array::length(ctx.remaining)
        let snap = pc_snap(ctx.remaining)
        pc_emit(ctx, scope, then_e)
        // #1100 alloc cut: swap the prefix instead of taking a SECOND copy —
        // one pass both restores `remaining` to the pre-branch values (what
        // restore_prefix did) and captures the then-branch's values into
        // `snap`'s buffer (what the `then_rem` copy was for). Same values in
        // the same places, one allocation instead of two per `if`; the
        // branch-snapshot copies were the plan's largest allocation source
        // on a full-closure compile.
        let mut sw = 0
        while sw < n {
          let then_v = Array::get(ctx.remaining, sw)
          Array::set(ctx.remaining, sw, Array::get(pc_scratch, snap + sw))
          Array::set(pc_scratch, snap + sw, then_v)
          sw = sw + 1
        }
        pc_emit(ctx, scope, else_e)
        // #705: leave the MIN remaining over both branches. A binding consumed in
        // one branch (e.g. a param threaded into a ctor in the `then`) but not the
        // other was previously left at the `else` branch's (higher) remaining, so
        // the scope-end drop fired on a value the taken branch already moved out —
        // a double free. Min means a binding consumed on ANY path is not
        // re-dropped (the non-consuming path leaks one ref, which is safe) instead
        // of the consuming path double-freeing (crash). Prefix-only (outer ids).
        // (`snap` holds the THEN branch's values after the swap above.)
        let mut i = 0
        while i < n {
          if Array::get(pc_scratch, snap + i) < Array::get(ctx.remaining, i) {
            Array::set(ctx.remaining, i, Array::get(pc_scratch, snap + i))
          } else {
            ()
          }
          i = i + 1
        }
        Array::truncate(pc_scratch, snap)
        0
      }
    },
    EWhile(cond, body) => {
      pc_emit(ctx, scope, cond)
      pc_emit(ctx, scope, body)
    },
    EReturn(e) => pc_emit(ctx, scope, e),
    ESpread(e) => pc_emit(ctx, scope, e),
    ELabeledArg(_l, _n, e) => pc_emit(ctx, scope, e),
    EBreak(opt) => match opt {
      Some(e) => pc_emit(ctx, scope, e),
      None => 0
    }
    ,
    EFn(_tp, _tb, params, _ret, _eff, fbody) => {
      let caps = collect_free_vars(fbody, fn_param_names(params), [])
      let mut i = 0
      while i < Array::length(caps) {
        pe_use(ctx, scope, Array::get(caps, i), -1)
        i = i + 1
      }
      0
    },
    EForIn(value_name, index_opt, iterable, fbody) => {
      pc_emit(ctx, scope, iterable)
      let idv = pe_declare(ctx, value_name)
      let s2 = Map::set(scope, value_name, idv)
      let s3 = match index_opt {
        Some(idx) => {
          let idi = pe_declare(ctx, idx)
          Map::set(s2, idx, idi)
        },
        None => s2
      }
      pc_emit(ctx, s3, fbody)
      pe_scope_end(ctx, idv, value_name)
    },
    ELoop(params, lbody) => {
      let mut s = scope
      let pids: Array[Int] = []
      let pnames: Array[String] = []
      let mut i = 0
      while i < Array::length(params) {
        let p = Array::get(params, i)
        pc_emit(ctx, scope, p.1)
        let pid = pe_declare(ctx, p.0)
        s = Map::set(s, p.0, pid)
        Array::push(pids, pid)
        Array::push(pnames, p.0)
        i = i + 1
      }
      pc_emit(ctx, s, lbody)
      let mut j = 0
      while j < Array::length(pids) {
        pe_scope_end(ctx, Array::get(pids, j), Array::get(pnames, j))
        j = j + 1
      }
      0
    },
    EMatch(scrut, arms) => {
      match scrut {
        EIdent(_, _) => 0,
        _ => pc_emit(ctx, scope, scrut)
      }
      // A single arm has no alternative control-flow state to merge. Count and
      // emit it directly so the overwhelmingly common lowered residual match
      // avoids the branch snapshot arrays. Empty and multi-arm matches retain
      // the general path below.
      if Array::length(arms) == 1 {
        let arm = Array::get(arms, 0)
        let pnames: Array[String] = []
        pat_names(arm.0, pnames)
        let mut s = scope
        let pids: Array[Int] = []
        let mut k = 0
        while k < Array::length(pnames) {
          let nm = Array::get(pnames, k)
          let pid = pe_declare(ctx, nm)
          s = Map::set(s, nm, pid)
          Array::push(pids, pid)
          k = k + 1
        }
        pc_emit(ctx, s, arm.1)
        let mut j = 0
        while j < Array::length(pids) {
          pe_scope_end(ctx, Array::get(pids, j), Array::get(pnames, j))
          j = j + 1
        }
        0
      } else if ematch_same_ident_arms(arms) {
        // #1915 mechanism 3 (see the EIf arm above): every arm body is the
        // same bare ident, so the match performs exactly one owned use at
        // runtime — walk the use once (first arm) instead of budgeting one
        // dup per arm. Pattern bindings are still declared per arm in the
        // same order as the counting pass (id alignment is load-bearing) and
        // still get their scope-end handling.
        let mut a = 0
        while a < Array::length(arms) {
          let arm = Array::get(arms, a)
          let pnames: Array[String] = []
          pat_names(arm.0, pnames)
          let mut s = scope
          let pids: Array[Int] = []
          let mut k = 0
          while k < Array::length(pnames) {
            let nm = Array::get(pnames, k)
            let pid = pe_declare(ctx, nm)
            s = Map::set(s, nm, pid)
            Array::push(pids, pid)
            k = k + 1
          }
          if a == 0 {
            // The one merged action represents every arm. It must not inherit
            // only the first arm's source position (see the EIf case above).
            match arm.1 {
              EIdent(name, _) => pe_use(ctx, s, name, -1),
              _ => 0
            }
          } else {
            ()
          }
          let mut j = 0
          while j < Array::length(pids) {
            pe_scope_end(ctx, Array::get(pids, j), Array::get(pnames, j))
            j = j + 1
          }
          a = a + 1
        }
        0
      } else {
        let n = Array::length(ctx.remaining)
        let snap = pc_snap(ctx.remaining)
        // #705: track the MIN remaining over all arms (see EIf). An arm that
        // consumes an outer binding (e.g. a param re-stored into a ctor) leaves it
        // at a lower remaining; leaving the LAST arm's (higher) value made the
        // scope-end drop double-free that binding on the arm that consumed it.
        let minrem = pc_snap_slots(snap, n)
        let mut a = 0
        while a < Array::length(arms) {
          let arm = Array::get(arms, a)
          pc_snap_restore(ctx.remaining, snap, n)
          let pnames: Array[String] = []
          pat_names(arm.0, pnames)
          let mut s = scope
          let pids: Array[Int] = []
          let mut k = 0
          while k < Array::length(pnames) {
            let nm = Array::get(pnames, k)
            let pid = pe_declare(ctx, nm)
            s = Map::set(s, nm, pid)
            Array::push(pids, pid)
            k = k + 1
          }
          pc_emit(ctx, s, arm.1)
          let mut j = 0
          while j < Array::length(pids) {
            pe_scope_end(ctx, Array::get(pids, j), Array::get(pnames, j))
            j = j + 1
          }
          let mut mi = 0
          while mi < n {
            if Array::get(ctx.remaining, mi) < Array::get(pc_scratch, minrem + mi) {
              Array::set(pc_scratch, minrem + mi, Array::get(ctx.remaining, mi))
            } else {
              ()
            }
            mi = mi + 1
          }
          a = a + 1
        }
        pc_snap_restore(ctx.remaining, minrem, n)
        Array::truncate(pc_scratch, snap)
        0
      }
    },
    EHandle(hbody, arms) => {
      let n = Array::length(ctx.remaining)
      let snap = pc_snap(ctx.remaining)
      pc_emit(ctx, scope, hbody)
      let minrem = pc_snap(ctx.remaining)
      let mut a = 0
      while a < Array::length(arms) {
        let arm = Array::get(arms, a)
        pc_snap_restore(ctx.remaining, snap, n)
        let pnames: Array[String] = []
        pat_names(arm.0, pnames)
        let mut s = scope
        let pids: Array[Int] = []
        let mut k = 0
        while k < Array::length(pnames) {
          let nm = Array::get(pnames, k)
          let pid = pe_declare(ctx, nm)
          s = Map::set(s, nm, pid)
          Array::push(pids, pid)
          k = k + 1
        }
        pc_emit(ctx, s, arm.1)
        let mut j = 0
        while j < Array::length(pids) {
          pe_scope_end(ctx, Array::get(pids, j), Array::get(pnames, j))
          j = j + 1
        }
        let mut mi = 0
        while mi < n {
          if Array::get(ctx.remaining, mi) < Array::get(pc_scratch, minrem + mi) {
            Array::set(pc_scratch, minrem + mi, Array::get(ctx.remaining, mi))
          } else {
            ()
          }
          mi = mi + 1
        }
        a = a + 1
      }
      pc_snap_restore(ctx.remaining, minrem, n)
      Array::truncate(pc_scratch, snap)
      0
    },
    _ => 0
  }
}

export fn pc_count(ctx: PCtx, scope: Map[String, Int], expr: Expr) -> Int {
  match expr {
    EInt(_) => 0,
    EFloat(_) => 0,
    EString(_) => 0,
    EBool(_) => 0,
    EUnit => 0,
    EStringInterp(_) => 0,
    EIdent(x, _) => pc_count_use(ctx, scope, x),
    ECall(callee, args, _) => {
      match callee {
        // Always borrow-count an ident callee: for a true top-level fn the
        // name is not in scope and this is a no-op, while for a LOCAL that
        // shadows a borrow-set name skipping it undercounted the local's
        // borrows (ADR-0092 per-use pairing, shadow hole).
        EIdent(f, _) => pc_count_borrow(ctx, scope, f),
        _ => pc_count(ctx, scope, callee)
      }
      // Lexical scoping wins over the borrow sets: see pe_borrow_mask.
      let bmask = pe_borrow_mask(ctx, scope, callee)
      let mut i = 0
      while i < Array::length(args) {
        let arg = Array::get(args, i)
        if pe_bmask_has(bmask, i) {
          match arg {
            EIdent(obj, _) => pc_count_borrow(ctx, scope, obj),
            _ => pc_count(ctx, scope, arg)
          }
        } else {
          pc_count(ctx, scope, arg)
        }
        i = i + 1
      }
      0
    },
    EDot(obj, _field, _, _) => match obj {
      EIdent(x, _) => pc_count_borrow(ctx, scope, x),
      _ => pc_count(ctx, scope, obj)
    }
    ,
    ELet(name, value, body, _) => {
      pc_count(ctx, scope, value)
      let id = pc_declare(ctx, name, is_scalar_expr(ctx, value))
      let _ = pctx_mark_view_call(ctx, scope, id, value)
      pc_count(ctx, Map::set(scope, name, id), body)
    },
    ELetMut(name, value, body, _) => {
      pc_count(ctx, scope, value)
      let id = pc_declare(ctx, name, is_scalar_expr(ctx, value))
      let _ = pctx_mark_view_call(ctx, scope, id, value)
      pc_count(ctx, Map::set(scope, name, id), body)
    },
    ELetRec(name, value, body) => {
      let id = pc_declare(ctx, name, false)
      let s2 = Map::set(scope, name, id)
      pc_count(ctx, s2, value)
      pc_count(ctx, s2, body)
    },
    EAssign(_name, value, body) => {
      pc_count(ctx, scope, value)
      pc_count(ctx, scope, body)
    },
    EAssignOp(_name, _op, value, body) => {
      pc_count(ctx, scope, value)
      pc_count(ctx, scope, body)
    },
    ESeq(a, b) => {
      pc_count(ctx, scope, a)
      let nm = next_seq_name(ctx)
      let sq_id = pc_declare(ctx, nm, is_scalar_expr(ctx, a))
      // ADR-0092 per-use pairing: a DISCARDED view-call result gets a seq-temp
      // drop it never owned -- same class as a view-call let-binding.
      let _ = pctx_mark_view_call(ctx, scope, sq_id, a)
      pc_count(ctx, scope, b)
    },
    EBinOp(_op, l, r, _) => {
      pc_count(ctx, scope, l)
      pc_count(ctx, scope, r)
    },
    EUnaryOp(_op, e) => pc_count(ctx, scope, e),
    ETuple(items) => {
      let mut i = 0
      while i < Array::length(items) {
        pc_count(ctx, scope, Array::get(items, i))
        i = i + 1
      }
      0
    },
    EArray(items) => {
      let mut i = 0
      while i < Array::length(items) {
        pc_count(ctx, scope, Array::get(items, i))
        i = i + 1
      }
      0
    },
    ERecord(_, fields, _) => {
      let mut i = 0
      while i < Array::length(fields) {
        pc_count(ctx, scope, (Array::get(fields, i)).1)
        i = i + 1
      }
      0
    },
    EMap(fields) => {
      let mut i = 0
      while i < Array::length(fields) {
        pc_count(ctx, scope, (Array::get(fields, i)).1)
        i = i + 1
      }
      0
    },
    EIf(cond, then_e, else_e) => {
      pc_count(ctx, scope, cond)
      let n = Array::length(ctx.uses)
      let snap_u = pc_snap(ctx.uses)
      let snap_b = pc_snap(ctx.borrows)
      pc_count(ctx, scope, then_e)
      // #1100 alloc cut: swap the prefixes instead of taking SECOND copies
      // (`then_u`/`then_b`) — one pass restores uses/borrows to the
      // pre-branch values and captures the then-branch's values into the
      // snap buffers. 2 allocations per `if` instead of 4.
      let mut sw = 0
      while sw < n {
        let tu = Array::get(ctx.uses, sw)
        Array::set(ctx.uses, sw, Array::get(pc_scratch, snap_u + sw))
        Array::set(pc_scratch, snap_u + sw, tu)
        let tb = Array::get(ctx.borrows, sw)
        Array::set(ctx.borrows, sw, Array::get(pc_scratch, snap_b + sw))
        Array::set(pc_scratch, snap_b + sw, tb)
        sw = sw + 1
      }
      pc_count(ctx, scope, else_e)
      // Merge = per-id MAX over the two branches. The previous delta form
      // (`base + max(then - base, else - base)`) is algebraically the same
      // number — the base cancels — so dropping it changes no plan. After
      // the swap above, snap_u/snap_b hold the THEN branch's values and
      // ctx.uses/ctx.borrows hold the ELSE branch's.
      let mut id = 0
      while id < n {
        Array::set(ctx.uses, id, int_max(Array::get(pc_scratch, snap_u + id), Array::get(ctx.uses, id)))
        Array::set(ctx.borrows, id, int_max(Array::get(pc_scratch, snap_b + id), Array::get(ctx.borrows, id)))
        id = id + 1
      }
      Array::truncate(pc_scratch, snap_u)
      0
    },
    EWhile(cond, body) => {
      pc_count(ctx, scope, cond)
      pc_count(ctx, scope, body)
    },
    EReturn(e) => pc_count(ctx, scope, e),
    ESpread(e) => pc_count(ctx, scope, e),
    ELabeledArg(_l, _n, e) => pc_count(ctx, scope, e),
    EBreak(opt) => match opt {
      Some(e) => pc_count(ctx, scope, e),
      None => 0
    }
    ,
    EFn(_tp, _tb, params, _ret, _eff, fbody) => {
      let caps = collect_free_vars(fbody, fn_param_names(params), [])
      let mut i = 0
      while i < Array::length(caps) {
        pc_count_use(ctx, scope, Array::get(caps, i))
        i = i + 1
      }
      0
    },
    EForIn(value_name, index_opt, iterable, fbody) => {
      pc_count(ctx, scope, iterable)
      let idv = pc_declare(ctx, value_name, false)
      let s2 = Map::set(scope, value_name, idv)
      let s3 = match index_opt {
        Some(idx) => {
          let idi = pc_declare(ctx, idx, true)
          Map::set(s2, idx, idi)
        },
        None => s2
      }
      pc_count(ctx, s3, fbody)
    },
    ELoop(params, lbody) => {
      let mut s = scope
      let mut i = 0
      while i < Array::length(params) {
        let p = Array::get(params, i)
        pc_count(ctx, scope, p.1)
        let pid = pc_declare(ctx, p.0, is_scalar_expr(ctx, p.1))
        s = Map::set(s, p.0, pid)
        i = i + 1
      }
      pc_count(ctx, s, lbody)
    },
    EMatch(scrut, arms) => {
      match scrut {
        EIdent(sx, _) => pc_count_borrow(ctx, scope, sx),
        _ => pc_count(ctx, scope, scrut)
      }
      // A single arm has no alternative counts to merge. Avoid the four
      // branch snapshot arrays while preserving the general empty/multi-arm
      // merge path below.
      if Array::length(arms) == 1 {
        let arm = Array::get(arms, 0)
        let pnames: Array[String] = []
        pat_names(arm.0, pnames)
        let mut s = scope
        let mut k = 0
        while k < Array::length(pnames) {
          let nm = Array::get(pnames, k)
          let pid = pc_declare(ctx, nm, false)
          s = Map::set(s, nm, pid)
          k = k + 1
        }
        pc_count(ctx, s, arm.1)
        0
      } else {
        let n = Array::length(ctx.uses)
        let snap_u = pc_snap(ctx.uses)
        let snap_b = pc_snap(ctx.borrows)
        let max_u = pc_snap_zeros(n)
        let max_b = pc_snap_zeros(n)
        let mut a = 0
        while a < Array::length(arms) {
          let arm = Array::get(arms, a)
          pc_snap_restore(ctx.uses, snap_u, n)
          pc_snap_restore(ctx.borrows, snap_b, n)
          let pnames: Array[String] = []
          pat_names(arm.0, pnames)
          let mut s = scope
          let mut k = 0
          while k < Array::length(pnames) {
            let nm = Array::get(pnames, k)
            let pid = pc_declare(ctx, nm, false)
            s = Map::set(s, nm, pid)
            k = k + 1
          }
          pc_count(ctx, s, arm.1)
          let mut id = 0
          while id < n {
            let du = Array::get(ctx.uses, id) - Array::get(pc_scratch, snap_u + id)
            if du > Array::get(pc_scratch, max_u + id) {
              Array::set(pc_scratch, max_u + id, du)
            }
            let db = Array::get(ctx.borrows, id) - Array::get(pc_scratch, snap_b + id)
            if db > Array::get(pc_scratch, max_b + id) {
              Array::set(pc_scratch, max_b + id, db)
            }
            id = id + 1
          }
          a = a + 1
        }
        pc_snap_restore(ctx.uses, snap_u, n)
        pc_snap_restore(ctx.borrows, snap_b, n)
        let mut id2 = 0
        while id2 < n {
          Array::set(ctx.uses, id2, Array::get(pc_scratch, snap_u + id2) + Array::get(pc_scratch, max_u + id2))
          Array::set(ctx.borrows, id2, Array::get(pc_scratch, snap_b + id2) + Array::get(pc_scratch, max_b + id2))
          id2 = id2 + 1
        }
        Array::truncate(pc_scratch, snap_u)
        0
      }
    },
    EHandle(hbody, arms) => {
      let n = Array::length(ctx.uses)
      let snap_u = pc_snap(ctx.uses)
      let snap_b = pc_snap(ctx.borrows)
      let max_u = pc_snap_zeros(n)
      let max_b = pc_snap_zeros(n)
      pc_count(ctx, scope, hbody)
      let mut id0 = 0
      while id0 < n {
        let du = Array::get(ctx.uses, id0) - Array::get(pc_scratch, snap_u + id0)
        if du > Array::get(pc_scratch, max_u + id0) {
          Array::set(pc_scratch, max_u + id0, du)
        }
        let db = Array::get(ctx.borrows, id0) - Array::get(pc_scratch, snap_b + id0)
        if db > Array::get(pc_scratch, max_b + id0) {
          Array::set(pc_scratch, max_b + id0, db)
        }
        id0 = id0 + 1
      }
      let mut a = 0
      while a < Array::length(arms) {
        let arm = Array::get(arms, a)
        pc_snap_restore(ctx.uses, snap_u, n)
        pc_snap_restore(ctx.borrows, snap_b, n)
        let pnames: Array[String] = []
        pat_names(arm.0, pnames)
        let mut s = scope
        let mut k = 0
        while k < Array::length(pnames) {
          let nm = Array::get(pnames, k)
          let pid = pc_declare(ctx, nm, false)
          s = Map::set(s, nm, pid)
          k = k + 1
        }
        pc_count(ctx, s, arm.1)
        let mut id = 0
        while id < n {
          let du = Array::get(ctx.uses, id) - Array::get(pc_scratch, snap_u + id)
          if du > Array::get(pc_scratch, max_u + id) {
            Array::set(pc_scratch, max_u + id, du)
          }
          let db = Array::get(ctx.borrows, id) - Array::get(pc_scratch, snap_b + id)
          if db > Array::get(pc_scratch, max_b + id) {
            Array::set(pc_scratch, max_b + id, db)
          }
          id = id + 1
        }
        a = a + 1
      }
      pc_snap_restore(ctx.uses, snap_u, n)
      pc_snap_restore(ctx.borrows, snap_b, n)
      let mut id2 = 0
      while id2 < n {
        Array::set(ctx.uses, id2, Array::get(pc_scratch, snap_u + id2) + Array::get(pc_scratch, max_u + id2))
        Array::set(ctx.borrows, id2, Array::get(pc_scratch, snap_b + id2) + Array::get(pc_scratch, max_b + id2))
        id2 = id2 + 1
      }
      Array::truncate(pc_scratch, snap_u)
      0
    },
    _ => 0
  }
}

/// #706 follow-up (borrow-after-move): a binding with any BORROW occurrence
/// (ctx.borrows[id] > 0 — computed branch-aware, max-across-if/match-arms,
/// alongside ctx.uses above) must stay alive through that borrow, regardless of
/// whether the borrow comes BEFORE or AFTER the binding's owning (consuming)
/// occurrences. `pc_emit`/`pe_use` only track OWNING occurrences (ctx.uses) when
/// deciding dup vs. free-transfer — borrows are invisible to that decision. If a
/// binding's textually LAST owning occurrence is treated as "the final, free
/// consume" (no dup; ownership transfers to the callee) and a borrow occurs
/// AFTER that point, the borrow reads through a reference the callee may already
/// have dropped — a silent use-after-free. This was masked in practice by other
/// RC leaks (loop-consume before #706's core fix; the loop-consume LEAK before
/// its own follow-up fix) that happened to keep the value alive by accident; see
/// #706 for the wat_exports/parse_module_sections repro that exposed it once
/// those leaks were tightened.
///
/// Fix: bump the binding's counted `uses` by exactly one whenever it has ANY
/// borrow occurrence. This is a pure post-processing step over the FINAL,
/// branch-merge-complete `uses`/`borrows` arrays (called after `pc_count`
/// finishes, before the emission pass begins), so it does not interact with the
/// max-across-branches counting logic itself — it only adjusts the total input
/// the REST of the system (pe_declare's `remaining` init, pc_emit's sequential
/// dup decisions, pe_scope_end's drop decision) already handles correctly for "K
/// owning occurrences": with K bumped to K+1, the occurrence that used to be a
/// free-transfer gets a dup like any other, and the binding's normal scope-end
/// drop (already emitted whenever `remaining` ends > 0 — e.g. the existing
/// borrow-only / K=0 baseline) picks up the now-nonzero leftover. No new
/// PerceusAction kind, no change to pc_emit or the codegen dup/drop realization.
/// For a binding with ZERO owning occurrences (pure borrow — the already-correct
/// baseline), this is a no-op: pe_declare already treats uses==0 like uses==1.
fn pctx_apply_borrow_retention(ctx: PCtx) -> Int {
  let mut bid = 0
  while bid < ctx.next_id {
    if Array::get(ctx.borrows, bid) > 0 {
      Array::set(ctx.uses, bid, Array::get(ctx.uses, bid) + 1)
    } else {
      ()
    }
    bid = bid + 1
  }
  0
}

/// Build the dup/drop plan for a function body expression.
export fn build_perceus_plan(body: Expr) -> Array[PerceusAction] {
  let no_masks: Array[Int] = []
  let ctx = pctx_new(sorted_names_of(borrow_ret_builtin_names()), [], no_masks, [
  ])
  let empty: Map[String, Int] = Map::new()
  pc_count(ctx, empty, body)
  pctx_apply_borrow_retention(ctx)
  ctx.next_id = 0
  ctx.seq_id = 0
  pc_emit(ctx, empty, body)
  ctx.actions
}

fn collect_heap_ret_fns(stmts: Array[Stmt]) -> Array[String] {
  let out: Array[String] = []
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SLet(_, _, fname, oty, _) =>
      match oty {
        Some(ty) =>
        match ty {
          TyFn(_, ret, _) =>
          if type_expr_is_heap(Some(ret)) {
            Array::push(out, fname)
          } else {
            ()
          },
          _ => ()
        },
        None => ()
      },
      _ => ()
    }
    i = i + 1
  }
  out
}

export fn elaborate_heap_params(stmts: Array[Stmt]) -> Array[Stmt] {
  let hctx = HeapInferCtx::{
    ctors: collect_ctor_names(stmts),
    heap_fns: collect_heap_ret_fns(stmts),
  }
  let out = Array::slice(stmts, 0, 0)
  let mut i = 0
  while i < Array::length(stmts) {
    let s = Array::get(stmts, i)
    let s2 = match s {
      SLet(a, b, n, t, e) => SLet(a, b, n, t, elaborate_rw(e, hctx)),
      SExpr(e) => SExpr(elaborate_rw(e, hctx)),
      _ => s
    }
    Array::push(out, s2)
    i = i + 1
  }
  out
}

fn expr_projects_or_matches(name: String, e: Expr) -> Bool {
  match e {
    EDot(obj, _, _, _) =>
    match obj {
      EIdent(n, _) => n == name,
      _ => expr_projects_or_matches(name, obj)
    },
    EMatch(scrut, arms) => {
      let hit = match scrut {
        EIdent(n, _) => n == name,
        _ => expr_projects_or_matches(name, scrut)
      }
      if hit {
        true
      } else {
        let mut i = 0
        let mut found = false
        while i < Array::length(arms) {
          let (_, arm_body) = Array::get(arms, i)
          if expr_projects_or_matches(name, arm_body) {
            found = true
          } else {
            ()
          }
          i = i + 1
        }
        found
      }
    },
    EHandle(body, arms) => {
      let mut i = 0
      let mut found = expr_projects_or_matches(name, body)
      while i < Array::length(arms) {
        let (_, arm_body) = Array::get(arms, i)
        if expr_projects_or_matches(name, arm_body) {
          found = true
        } else {
          ()
        }
        i = i + 1
      }
      found
    },
    ELet(_, val, body, _) =>
    expr_projects_or_matches(name, val) || expr_projects_or_matches(name, body),
    ELetRec(_, val, body) =>
    expr_projects_or_matches(name, val) || expr_projects_or_matches(name, body),
    ELetMut(_, val, body, _) =>
    expr_projects_or_matches(name, val) || expr_projects_or_matches(name, body),
    EAssign(_, val, cont) =>
    expr_projects_or_matches(name, val) || expr_projects_or_matches(name, cont),
    EAssignOp(_, _, val, cont) =>
    expr_projects_or_matches(name, val) || expr_projects_or_matches(name, cont),
    ESeq(a, b) =>
    expr_projects_or_matches(name, a) || expr_projects_or_matches(name, b),
    EIf(c, t, el) =>
    expr_projects_or_matches(name, c) ||
    expr_projects_or_matches(name, t) ||
    expr_projects_or_matches(name, el),
    EWhile(c, b) =>
    expr_projects_or_matches(name, c) || expr_projects_or_matches(name, b),
    EForIn(_, _, iter, body) =>
    expr_projects_or_matches(name, iter) || expr_projects_or_matches(name, body),
    ECall(callee, args, _) => {
      let mut i = 0
      let mut found = expr_projects_or_matches(name, callee)
      while i < Array::length(args) {
        if expr_projects_or_matches(name, Array::get(args, i)) {
          found = true
        } else {
          ()
        }
        i = i + 1
      }
      found
    },
    EBinOp(_, l, r, _) =>
    expr_projects_or_matches(name, l) || expr_projects_or_matches(name, r),
    EUnaryOp(_, o) => expr_projects_or_matches(name, o),
    EFn(_, _, _, _, _, body) => expr_projects_or_matches(name, body),
    ETuple(elems) => {
      let mut i = 0
      let mut found = false
      while i < Array::length(elems) {
        if expr_projects_or_matches(name, Array::get(elems, i)) {
          found = true
        } else {
          ()
        }
        i = i + 1
      }
      found
    },
    EArray(elems) => {
      let mut i = 0
      let mut found = false
      while i < Array::length(elems) {
        if expr_projects_or_matches(name, Array::get(elems, i)) {
          found = true
        } else {
          ()
        }
        i = i + 1
      }
      found
    },
    ELoop(params, body) => {
      let mut i = 0
      let mut found = expr_projects_or_matches(name, body)
      while i < Array::length(params) {
        let (_, init) = Array::get(params, i)
        if expr_projects_or_matches(name, init) {
          found = true
        } else {
          ()
        }
        i = i + 1
      }
      found
    },
    ERecord(_, fields, _) => {
      let mut i = 0
      let mut found = false
      while i < Array::length(fields) {
        let (_, fval) = Array::get(fields, i)
        if expr_projects_or_matches(name, fval) {
          found = true
        } else {
          ()
        }
        i = i + 1
      }
      found
    },
    EMap(fields) => {
      let mut i = 0
      let mut found = false
      while i < Array::length(fields) {
        let (_, fval) = Array::get(fields, i)
        if expr_projects_or_matches(name, fval) {
          found = true
        } else {
          ()
        }
        i = i + 1
      }
      found
    },
    ELabeledArg(_, _, inner) => expr_projects_or_matches(name, inner),
    EReturn(inner) => expr_projects_or_matches(name, inner),
    ESpread(inner) => expr_projects_or_matches(name, inner),
    EBreak(opt) =>
    match opt {
      Some(inner) => expr_projects_or_matches(name, inner),
      None => false
    },
    EContinue(args) => {
      let mut i = 0
      let mut found = false
      while i < Array::length(args) {
        if expr_projects_or_matches(name, Array::get(args, i)) {
          found = true
        } else {
          ()
        }
        i = i + 1
      }
      found
    },
    EInt(_) => false,
    EFloat(_) => false,
    EString(_) => false,
    EBool(_) => false,
    EIdent(_, _) => false,
    EStringInterp(_) => false,
    EUnit => false
  }
}

/// Heap-ness decision for an owned parameter: the type annotation says heap, or
/// (when unannotated) the body proves it via projection/match. Used by the
/// Perceus plan and codegen so an unannotated nested-closure param that is
/// projected no longer leaks its owned argument (ADR-0055 Stage 4).
export fn param_is_heap_in_body(name: String, otype: Option[TypeExpr], body: Expr) -> Bool {
  if type_expr_is_heap(otype) {
    true
  } else {
    match otype {
      None => expr_projects_or_matches(name, body),
      Some(_) => false
    }
  }
}

//# ADR-0092 / #2389: plan-level reuse pairing.
//
// Post-pass over the function body: every `match <ident>` whose scrutinee
// has a planned drop is scanned for arms that (a) decompose the value with
// an all-PBind/PWild `PCtor` pattern whose every PBind is consumed at most
// once (consume 1 transfers raw; consume 0 -- a bind only borrow-read by
// its uses, e.g. every callee borrow-classified -- is compensated by the
// codegen and aliased binds decline), (b) never mention the scrutinee
// again, (c) contain no control
// transfer that could skip the arm's tail (return/break/continue/perform
// -- a lambda's interior is exempt: its body runs in its own frame), and
// (d) end (through any let spine) in a call of the SAME arity as the
// pattern -- the same-size constructor rebuild FBIP targets. Such an arm
// gets a PaReuseToken/PaReuseAlloc pair (arity in `extra`). Constructor-
// ness and float-field layout are NOT known here (no ctor table in the
// planner); the RC codegen re-validates both and quietly declines, so a
// false candidate costs nothing and a printed pair in `vibe rc-plan` reads
// as "candidate", never as a promise.

fn reuse_spine_tail(e: Expr) -> Expr {
  match e {
    ELet(_, _, lbody, _) => reuse_spine_tail(lbody),
    _ => e
  }
}

/// Any node that can transfer control past the arm's spine tail. EFn does
/// not recurse: a return/perform inside a lambda leaves the LAMBDA, not
/// this arm, and the lambda body compiles in its own frame with its own
/// (empty) token state. Exported: the RC codegen re-runs this same
/// predicate on the arm it is about to fuse, so a plan row produced by one
/// arm can never authorize a same-scrutinee same-arity SIBLING arm that
/// carries a control transfer (the pairing key is (name, arity), not an
/// arm identity). Scope is DIRECT perform/throw only: a spine call whose
/// callee unwinds internally is not blocked -- every call can throw on
/// this lane (Array::get, arithmetic traps), so transitive blocking would
/// reject every arm, and an unwind between the claim and the tail leaks
/// the block without ever corrupting it, the same window the narrow
/// fusion's spine calls (#1265) have always had and the same "safe leak,
/// never use-after-free" class ADR-0055 accepts on unwind paths.
export fn reuse_arm_has_blocker(e: Expr) -> Bool {
  match e {
    EReturn(_) => true,
    EBreak(_) => true,
    EContinue(_) => true,
    EFn(_, _, _, _, _, _) => false,
    ECall(callee, args, _) => {
      let callee_blocks = match callee {
        EIdent(f, _) => f == "perform" || is_exception_throw_operation(f) || f == "throw",
        _ => reuse_arm_has_blocker(callee)
      }
      if callee_blocks {
        true
      } else {
        let mut i = 0
        let mut found = false
        while !found && i < Array::length(args) {
          if reuse_arm_has_blocker(Array::get(args, i)) {
            found = true
          } else {
            ()
          }
          i = i + 1
        }
        found
      }
    },
    _ => {
      let kids = expr_children(e)
      let mut i = 0
      let mut found = false
      while !found && i < Array::length(kids) {
        if reuse_arm_has_blocker(Array::get(kids, i)) {
          found = true
        } else {
          ()
        }
        i = i + 1
      }
      found
    }
  }
}

/// Every occurrence of `name` as an identifier in `e`, lambdas and
/// shadowed regions INCLUDED -- deliberately an overcount. The admission
/// below compares it against the consume count, and an overcount can only
/// DECLINE an arm, never admit one whose reads it missed.
fn reuse_ident_occurrences(e: Expr, name: String) -> Int {
  match e {
    EIdent(n, _) => if n == name {
      1
    } else {
      0
    },
    _ => {
      let mark = expr_children_push(e)
      let end = expr_children_top()
      let mut acc = 0
      let mut i = mark
      while i < end {
        acc = acc + reuse_ident_occurrences(expr_child_at(i), name)
        i = i + 1
      }
      expr_children_pop(mark)
      acc
    }
  }
}

/// The admission mode of one payload bind for the reuse fusion: 1 = pure
/// consume (consumed exactly once and that consume is its ONLY occurrence),
/// 0 = pure borrow (never consumed; every read precedes the arm-end
/// release), -1 = inadmissible. A bind with one consume PLUS borrow reads
/// is refused (PR #2416 review): the raw-transferred child dies at the
/// consume, so a read sequenced after it -- later spine let, conditional --
/// would be use-after-free on the unique path. The normal path never has
/// this hazard (the container outlives the arm), so declining just takes
/// the normal path. Exported: the narrow and wide codegen tiers re-run the
/// same predicate on the arm they fuse.
export fn reuse_bind_mode(arm_body: Expr, bn: String, borrow_param_fns: Array[String], bmasks: Array[Int]) -> Int {
  let cc = md_consume_count_pre(arm_body, bn, borrow_param_fns, bmasks)
  if cc == 0 {
    0
  } else if cc == 1 && reuse_ident_occurrences(arm_body, bn) == 1 {
    1
  } else {
    0 - 1
  }
}

fn reuse_arm_candidate_arity(sname: String, pat: Pat, arm_body: Expr, borrow_param_fns: Array[String], borrow_param_masks: Array[Int], alias_names: Array[String]) -> Int {
  match pat {
    PCtor(_, pargs) => {
      let arity = Array::length(pargs)
      let tail = reuse_spine_tail(arm_body)
      let tail_ok = match tail {
        ECall(callee, targs, _) => match callee {
          EIdent(_, _) => Array::length(targs) == arity,
          _ => false
        },
        _ => false
      }
      if arity >= 1 && tail_ok && !reuse_arm_has_blocker(arm_body) {
        let bmasks = md_shadow_zeroed_bmasks(arm_body, borrow_param_fns, borrow_param_masks)
        let mut ok = true
        let mut i = 0
        while ok && i < arity {
          match Array::get(pargs, i) {
            // A payload bind is admitted at consume count 1 (ownership
            // transfers raw and the single consume releases it) or 0 (pure
            // borrow reads; the codegen compensates -- on the unique path
            // the arm-end conditional drop releases the raw-transferred
            // child, on the shared path the bind stays a borrowed view of
            // the still-live block). 2+ declines: the normal path's
            // dup-per-consume has no raw-transfer equivalent. An
            // alias-bound name (PaAliasDup row anywhere in the fn) also
            // declines -- aliasing can hide an extra owner the consume
            // count does not see; name-keyed, so a same-named alias
            // elsewhere declines conservatively.
            PBind(bn) => if reuse_bind_mode(arm_body, bn, borrow_param_fns, bmasks) < 0 || name_in(alias_names, bn) {
              ok = false
            } else {
              ()
            },
            PWild => (),
            _ => ok = false
          }
          i = i + 1
        }
        let no_params: Array[String] = []
        let no_fns: Array[String] = []
        if ok && !name_in(collect_free_vars(arm_body, no_params, no_fns), sname) {
          arity
        } else {
          0 - 1
        }
      } else {
        0 - 1
      }
    },
    _ => 0 - 1
  }
}

fn plan_reuse_pairs_walk(e: Expr, drop_names: Array[String], alias_names: Array[String], actions: Array[PerceusAction], borrow_param_fns: Array[String], borrow_param_masks: Array[Int]) -> Unit {
  match e {
    // A nested lambda's body plans in its OWN frame (compile_lambda builds
    // a separate plan whose post-pass pairs its matches there), exactly as
    // pc_count/pc_emit treat an EFn as capture uses only and
    // reuse_arm_has_blocker exempts the lambda interior. Recursing past
    // this boundary would attribute the lambda's rows to the enclosing
    // function -- wrong FN in `vibe rc-plan`, unrealizable candidates on
    // the enclosing ctx (#2411 review).
    EFn(_, _, _, _, _, _) => (),
    EMatch(scrut, arms) => {
      match scrut {
        EIdent(sname, _) => if name_in(drop_names, sname) {
          let mut ai = 0
          while ai < Array::length(arms) {
            let (apat, abody) = Array::get(arms, ai)
            let arity = reuse_arm_candidate_arity(sname, apat, abody, borrow_param_fns, borrow_param_masks, alias_names)
            if arity >= 1 {
              pr_push_reuse(actions, PaReuseToken, sname, arity)
              pr_push_reuse(actions, PaReuseAlloc, sname, arity)
            } else {
              ()
            }
            ai = ai + 1
          }
        } else {
          ()
        },
        _ => ()
      }
      let mark = expr_children_push(e)
      let end = expr_children_top()
      let mut i = mark
      while i < end {
        plan_reuse_pairs_walk(expr_child_at(i), drop_names, alias_names, actions, borrow_param_fns, borrow_param_masks)
        i = i + 1
      }
      expr_children_pop(mark)
    },
    _ => {
      let mark = expr_children_push(e)
      let end = expr_children_top()
      let mut i = mark
      while i < end {
        plan_reuse_pairs_walk(expr_child_at(i), drop_names, alias_names, actions, borrow_param_fns, borrow_param_masks)
        i = i + 1
      }
      expr_children_pop(mark)
    }
  }
}

// #2386: the drop / alias name lists of a function are deduped through the
// action's binding id -- dense per function, 0-based (`ctx.next_id`) -- so
// a check is one read of a stamp table indexed by id instead of a scan of
// every name collected so far (the compiler's larger bodies carry hundreds
// of drop rows; `name_in` was 60 ms of a warm compile). The tables are two
// process-wide `Array[Int]` cells stamped with a generation per plan: a
// function allocates nothing for its dedup and the tables never grow past
// the largest function's binding count. The generation is what keeps plans
// apart: the previous plan's stamps have to count as absent for this one,
// or the second function that drops `n` (the same id 0) would find it
// "already listed", push nothing and silently lose its reuse rows. Two
// bindings that share a name (shadowing) list the name twice; both lists
// are read by membership only. A reuse row carries id -1 and is neither
// kind, but an id below 0 takes the linear membership test anyway.
let pr_drop_stamp: Array[Int] = []

let pr_alias_stamp: Array[Int] = []

let pr_seen_gen: Array[Int] = [0]

fn pr_seen_begin() -> Unit {
  Array::set(pr_seen_gen, 0, Array::get(pr_seen_gen, 0) + 1)
}

/// Push `name` onto `names` unless this plan already listed binding `id`:
/// true iff pushed.
fn pr_push_once(stamps: Array[Int], names: Array[String], id: Int, name: String) -> Bool {
  if id < 0 {
    if name_in(names, name) {
      false
    } else {
      Array::push(names, name)
      true
    }
  } else {
    let gen = Array::get(pr_seen_gen, 0)
    while Array::length(stamps) <= id {
      Array::push(stamps, 0)
    }
    if Array::get(stamps, id) == gen {
      false
    } else {
      Array::set(stamps, id, gen)
      Array::push(names, name)
      true
    }
  }
}

fn plan_reuse_pairs(body: Expr, actions: Array[PerceusAction], borrow_param_fns: Array[String], borrow_param_masks: Array[Int]) -> Unit {
  let drop_names: Array[String] = []
  let alias_names: Array[String] = []
  pr_seen_begin()
  let mut i = 0
  while i < Array::length(actions) {
    let a = Array::get(actions, i)
    if pa_is_drop(a) {
      let _ = pr_push_once(pr_drop_stamp, drop_names, a.binding_id, a.name)
    } else {
      ()
    }
    if pa_is_alias_dup(a) {
      let _ = pr_push_once(pr_alias_stamp, alias_names, a.binding_id, a.name)
    } else {
      ()
    }
    i = i + 1
  }
  if Array::length(drop_names) > 0 {
    plan_reuse_pairs_walk(body, drop_names, alias_names, actions, borrow_param_fns, borrow_param_masks)
  } else {
    ()
  }
}

/// Build the plan for a function whose parameters are owned heap values. Params
/// are declared as bindings (in count + emit lockstep, same ids) so the existing
/// machinery emits a PaDrop for a borrowed-only/unused heap param and a PaDup for
/// one used in multiple owning positions. Heap-ness comes from the param's type
/// annotation (scalar params get scalar=true so they are never dropped).
/// The cached `PCtx` holding exactly these four tables, reset for a new
/// function: installed fresh, kept when the tables compare equal, replaced
/// (and unpinned) otherwise.
fn pctx_cache_select(borrow_ret_names: Array[String], borrow_param_fns: Array[String], borrow_param_masks: Array[Int], view_ret_fns: Array[String]) -> PCtx {
  // Reuse the cached PCtx when the caller's four whole-program tables are
  // content-identical to the cached copies (the per-program common case: one
  // plan per function/lambda, all against the same tables); otherwise build a
  // fresh one and make it the cache. Either way `ctx` is read back out of the
  // cache cell so it is uniformly a borrowed view of the cache-owned PCtx.
  if Array::length(pctx_cache) == 0 {
    Array::push(pctx_cache, pctx_new(borrow_ret_names, borrow_param_fns, borrow_param_masks, view_ret_fns))
  } else if pctx_cache_matches(Array::get(pctx_cache, 0), borrow_ret_names, borrow_param_fns, borrow_param_masks, view_ret_fns) {
    pctx_reset(Array::get(pctx_cache, 0))
  } else {
    // Refill the cached PCtx IN PLACE: field assignment drops the previous
    // tables and working state. Replacing the element via Array::set would
    // leak the whole old context -- the linear lane's arr_set stores without
    // releasing the replaced element.
    let stale = Array::get(pctx_cache, 0)
    pctx_reset(stale)
    stale.pinned = 0
    stale.pctx_names = Array::slice(borrow_ret_names, 0, Array::length(borrow_ret_names))
    stale.borrow_param_user = Array::slice(borrow_param_fns, 0, Array::length(borrow_param_fns))
    stale.borrow_param_mask = Array::slice(borrow_param_masks, 0, Array::length(borrow_param_masks))
    stale.view_ret_user = Array::slice(view_ret_fns, 0, Array::length(view_ret_fns))
  }
  Array::get(pctx_cache, 0)
}

/// #2386: install the four tables once per compile and hand back a token the
/// per-function calls present (`build_perceus_plan_pinned*`). A token is
/// valid exactly while the cache still holds the tables it was issued for:
/// an unpinned call that replaces them clears it, and a pinned call whose
/// token no longer matches falls back to the table compare, so the token can
/// only skip work, never change an answer. Tokens are never reused.
export fn perceus_pin_tables(borrow_ret_names: Array[String], borrow_param_fns: Array[String], borrow_param_masks: Array[Int], view_ret_fns: Array[String]) -> Int {
  let ctx = pctx_cache_select(borrow_ret_names, borrow_param_fns, borrow_param_masks, view_ret_fns)
  let tok = Array::get(pctx_pin_counter, 0) + 1
  Array::set(pctx_pin_counter, 0, tok)
  ctx.pinned = tok
  tok
}

export fn build_perceus_plan_with_params_split(params: Array[(String, Option[TypeExpr])], body: Expr, borrow_ret_names: Array[String], borrow_param_fns: Array[String], borrow_param_masks: Array[Int], view_ret_fns: Array[String], out_param_drop_start: Array[Int]) -> Array[PerceusAction] {
  let ctx = pctx_cache_select(borrow_ret_names, borrow_param_fns, borrow_param_masks, view_ret_fns)
  build_perceus_plan_in_ctx(ctx, params, body, out_param_drop_start)
}

/// `build_perceus_plan_with_params_split` for a caller holding a
/// `perceus_pin_tables` token: the same tables, the compare skipped while the
/// token is current.
export fn build_perceus_plan_pinned_split(token: Int, params: Array[(String, Option[TypeExpr])], body: Expr, borrow_ret_names: Array[String], borrow_param_fns: Array[String], borrow_param_masks: Array[Int], view_ret_fns: Array[String], out_param_drop_start: Array[Int]) -> Array[PerceusAction] {
  let ctx = if token > 0 && Array::length(pctx_cache) > 0 && Array::get(pctx_cache, 0).pinned == token {
    let c = Array::get(pctx_cache, 0)
    pctx_reset(c)
    c
  } else {
    pctx_cache_select(borrow_ret_names, borrow_param_fns, borrow_param_masks, view_ret_fns)
  }
  build_perceus_plan_in_ctx(ctx, params, body, out_param_drop_start)
}

export fn build_perceus_plan_pinned(token: Int, params: Array[(String, Option[TypeExpr])], body: Expr, borrow_ret_names: Array[String], borrow_param_fns: Array[String], borrow_param_masks: Array[Int], view_ret_fns: Array[String]) -> Array[PerceusAction] {
  let ignored = array_empty()
  build_perceus_plan_pinned_split(token, params, body, borrow_ret_names, borrow_param_fns, borrow_param_masks, view_ret_fns, ignored)
}

fn build_perceus_plan_in_ctx(ctx: PCtx, params: Array[(String, Option[TypeExpr])], body: Expr, out_param_drop_start: Array[Int]) -> Array[PerceusAction] {
  let mut scope: Map[String, Int] = Map::new()
  let mut pi = 0
  while pi < Array::length(params) {
    let (pname, ptype) = Array::get(params, pi)
    let id = pc_declare(ctx, pname, !param_is_heap_in_body(pname, ptype, body))
    scope = Map::set(scope, pname, id)
    pi = pi + 1
  }
  pc_count(ctx, scope, body)
  pctx_apply_borrow_retention(ctx)
  ctx.next_id = 0
  ctx.seq_id = 0
  let mut scope2: Map[String, Int] = Map::new()
  let param_ids = array_empty()
  let mut pj = 0
  while pj < Array::length(params) {
    let (pname, _) = Array::get(params, pj)
    let id = pe_declare(ctx, pname)
    scope2 = Map::set(scope2, pname, id)
    Array::push(param_ids, id)
    pj = pj + 1
  }
  pc_emit(ctx, scope2, body)
  // The parameters' own scope-end drops are pushed AFTER the whole body, so
  // they are a suffix of the plan. `out_param_drop_start` records where that
  // suffix begins, which is what lets the borrowed-param drop filter in
  // wasi/linked_compile.vibe target the params THEMSELVES instead of matching
  // by name across the entire plan (a body-local binding that shadows a
  // borrowed parameter's name would otherwise lose its own drop -- a leak the
  // filter's comment acknowledges).
  Array::push(out_param_drop_start, Array::length(ctx.actions))
  let mut pk = 0
  while pk < Array::length(params) {
    let (pname, _) = Array::get(params, pk)
    pe_scope_end(ctx, Array::get(param_ids, pk), pname)
    pk = pk + 1
  }
  // ADR-0092 / #2389: append the reuse-pairing candidates AFTER the
  // param-drop suffix -- out_param_drop_start's "drops from here on are the
  // params' own" contract only speaks about drops, and reuse rows are
  // neither drops nor dups, so every existing consumer skips them.
  plan_reuse_pairs(body, ctx.actions, ctx.borrow_param_user, ctx.borrow_param_mask)
  // An owned copy, NOT ctx.actions itself: the cached PCtx keeps (and later
  // resets) its own actions array, while callers hold the returned plan
  // across subsequent plan builds.
  Array::slice(ctx.actions, 0, Array::length(ctx.actions))
}

/// The plan without the param-drop split index, for callers that do not
/// filter borrowed-parameter drops (lambdas: a lambda has no top-level name,
/// so it is never in the borrow-param set).
export fn build_perceus_plan_with_params(params: Array[(String, Option[TypeExpr])], body: Expr, borrow_ret_names: Array[String], borrow_param_fns: Array[String], borrow_param_masks: Array[Int], view_ret_fns: Array[String]) -> Array[PerceusAction] {
  let ignored = array_empty()
  build_perceus_plan_with_params_split(params, body, borrow_ret_names, borrow_param_fns, borrow_param_masks, view_ret_fns, ignored)
}
