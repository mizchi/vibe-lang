/// #706 follow-up (borrow-after-move): a binding with any BORROW occurrence
/// (ctx.borrows[id] > 0 — computed branch-aware, max-across-if/match-arms,
/// alongside ctx.uses above) must stay alive through that borrow, regardless of
/// whether the borrow comes BEFORE or AFTER the binding's owning (consuming)
/// occurrences. `pc_emit`/`pe_use` only track OWNING occurrences (ctx.uses) when
/// deciding dup vs. free-transfer — borrows are invisible to that decision. If a
/// binding's textually LAST owning occurrence is treated as "the final, free
/// consume" (no dup; ownership transfers to the callee) and a borrow occurs
/// AFTER that point, the borrow reads through a reference the callee may already
/// have dropped — a silent use-after-free. This was masked in practice by other
/// RC leaks (loop-consume before #706's core fix; the loop-consume LEAK before
/// its own follow-up fix) that happened to keep the value alive by accident; see
/// #706 for the wat_exports/parse_module_sections repro that exposed it once
/// those leaks were tightened.
///
/// Fix: bump the binding's counted `uses` by exactly one whenever it has ANY
/// borrow occurrence. This is a pure post-processing step over the FINAL,
/// branch-merge-complete `uses`/`borrows` arrays (called after `pc_count`
/// finishes, before the emission pass begins), so it does not interact with the
/// max-across-branches counting logic itself — it only adjusts the total input
/// the REST of the system (pe_declare's `remaining` init, pc_emit's sequential
/// dup decisions, pe_scope_end's drop decision) already handles correctly for "K
/// owning occurrences": with K bumped to K+1, the occurrence that used to be a
/// free-transfer gets a dup like any other, and the binding's normal scope-end
/// drop (already emitted whenever `remaining` ends > 0 — e.g. the existing
/// borrow-only / K=0 baseline) picks up the now-nonzero leftover. No new
/// PerceusAction kind, no change to pc_emit or the codegen dup/drop realization.
/// For a binding with ZERO owning occurrences (pure borrow — the already-correct
/// baseline), this is a no-op: pe_declare already treats uses==0 like uses==1.
fn pctx_apply_borrow_retention(ctx: PCtx) -> Int {
  let mut bid = 0
  while bid < ctx.next_id {
    if Array::get(ctx.borrows, bid) > 0 {
      Array::set(ctx.uses, bid, Array::get(ctx.uses, bid) + 1)
    } else {
      ()
    }
    bid = bid + 1
  }
  0
}

/// Build the dup/drop plan for a function body expression.
export fn build_perceus_plan(body: Expr) -> Array[PerceusAction] {
  let no_masks: Array[Int] = []
  let ctx = pctx_new(sorted_names_of(borrow_ret_builtin_names()), [], no_masks, [
  ])
  let empty: PScope = PsNil
  pc_count(ctx, empty, body)
  pctx_apply_borrow_retention(ctx)
  ctx.next_id = 0
  ctx.seq_id = 0
  pc_emit(ctx, empty, body)
  pe_emit_exit_rows(ctx)
  ctx.actions
}

fn collect_heap_ret_fns(stmts: Array[Stmt]) -> Array[String] {
  let out: Array[String] = []
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SLet(_, _, fname, oty, _) =>
      match oty {
        Some(ty) =>
        match ty {
          TyFn(_, ret, _) =>
          if type_expr_is_heap(Some(ret)) {
            Array::push(out, fname)
          } else {
            ()
          },
          _ => ()
        },
        None => ()
      },
      _ => ()
    }
    i = i + 1
  }
  out
}

export fn elaborate_heap_params(stmts: Array[Stmt]) -> Array[Stmt] {
  let ctors = collect_ctor_names(stmts)
  let heap_fns = collect_heap_ret_fns(stmts)
  let hctx0 = HeapInferCtx::{
    ctors: ctors,
    heap_fns: heap_fns,
    top_names: [],
    top_heaps: []
  }
  // Only a top-level lambda with an unannotated parameter reads the call
  // scope index. Local inference still needs the top-level heap table below.
  let scope: Array[Expr] = []
  let scope_refs = if has_top_heap_param_candidate(stmts) {
    top_level_call_scope(stmts, scope)
    top_level_scope_refs(scope)
  } else {
    []
  }
  let (top_names, top_heaps) = top_level_heap_env(stmts, hctx0)
  let hctx = HeapInferCtx::{
    ctors: ctors,
    heap_fns: heap_fns,
    top_names: top_names,
    top_heaps: top_heaps
  }
  let out = Array::slice(stmts, 0, 0)
  let mut i = 0
  while i < Array::length(stmts) {
    let s = Array::get(stmts, i)
    let s2 = match s {
      SLet(a, b, n, t, e) => SLet(a, b, n, t, elaborate_rw(fill_top_lambda_params(n, e, scope, scope_refs, hctx), hctx)),
      SExpr(e) => SExpr(elaborate_rw(e, hctx)),
      _ => s
    }
    Array::push(out, s2)
    i = i + 1
  }
  out
}

/// #2837: append the truncate-release rows for `body` (see the section
/// comment above). Most bodies truncate nothing, and pay one walk.
fn plan_truncate_release(body: Expr, actions: Array[PerceusAction]) -> Unit {
  let receivers: Array[String] = []
  tr_collect_receivers(body, receivers)
  let mut ri = 0
  while ri < Array::length(receivers) {
    let x = Array::get(receivers, ri)
    if tr_receiver_only(body, x, false) {
      let d: Array[String] = [x]
      if tr_derive(body, d) {
        let w = TrWalk::{
          x: x,
          d: d,
          bn: [],
          bk: [],
          bf: [],
          bb: [],
          bt: [],
          pins: [],
          pin_bodies: [],
          pin_tail: [],
          ok: true
        }
        tr_walk(w, body, true, true)
        // Rule 7: the plan itself must not count any derived binding. A view
        // holds no reference, so a planned drop or dup on one is an
        // accounting this analysis cannot vouch for -- measured: `let w = v`
        // over a view `v` plans a scope-end drop for `w` that it never
        // acquired, which the unreleased element used to absorb.
        let mut ai = 0
        while w.ok && ai < Array::length(actions) {
          let a = Array::get(actions, ai)
          if a.name != x && array_contains_str_pctx(d, a.name) {
            w.ok = false
          } else {
            ()
          }
          ai = ai + 1
        }
        let mut needs_root = false
        let mut pi = 0
        while w.ok && pi < Array::length(w.pins) {
          if tr_result_safe(Array::get(w.pin_bodies, pi), d) {
            ()
          } else if Array::get(w.pin_tail, pi) {
            needs_root = true
          } else {
            w.ok = false
          }
          pi = pi + 1
        }
        if w.ok {
          let extra = if needs_root {
            1
          } else {
            0
          }
          pr_push_reuse(actions, PaTruncRelease, x, extra)
          let mut pj = 0
          while pj < Array::length(w.pins) {
            pr_push_reuse(actions, PaViewPin, Array::get(w.pins, pj), extra)
            pj = pj + 1
          }
        } else {
          ()
        }
      } else {
        ()
      }
    } else {
      ()
    }
    ri = ri + 1
  }
}

/// #2837: split a plan's truncate-release rows into what codegen consults.
/// `accept_root` says whether the function being compiled returns an
/// Int/Bool/Unit; a row whose `extra` asks for that is dropped otherwise,
/// together with its pins. `pin_arrays[i]` is the array `pin_names[i]` was
/// pinned for.
export fn perceus_truncate_rows(plan: Array[PerceusAction], accept_root: Bool, release: Array[String], pin_arrays: Array[String], pin_names: Array[String]) -> Unit {
  let mut cur = ""
  let mut i = 0
  while i < Array::length(plan) {
    let a = Array::get(plan, i)
    if pa_is_trunc_release(a) {
      if a.extra == 0 || accept_root {
        cur = a.name
        Array::push(release, a.name)
      } else {
        cur = ""
      }
    } else if pa_is_view_pin(a) {
      if cur != "" {
        Array::push(pin_arrays, cur)
        Array::push(pin_names, a.name)
      } else {
        ()
      }
    } else {
      ()
    }
    i = i + 1
  }
}

//# #3140: releasing what a field assignment overwrites

// `x.f = v` lowers to `__set_field(x, "f", v)`, which stores `v` over the
// field and, on its own, releases nothing: the value the field held stays
// counted by nobody, so a loop that reassigns a field leaks every value it
// replaces. Releasing it in every store is wrong by itself, for the reason
// #2837 gives for truncate: reading into the field's value -- an element
// `Array::get(x.f, i)`, a `for` over `x.f`, a match on it -- hands out
// UNCOUNTED views whose only owner is the struct, so a view read before the
// store and used after it would be freed under its reader (measured: with the
// checks below disabled, such an element read the next allocation's value) --
// and a caller can hold such a view of the very struct it passed in.
//
// So release is decided per STRUCT, here, and only where it is proven safe:
//
//   1. the struct is a local `let x = <struct literal>`, so no caller or
//      global can hold a view into it;
//   2. every mention of `x` is the object of a projection `x.f`, the receiver
//      of a field assignment, or the function's own result, outside any
//      lambda -- `x` escapes only by being returned, and every view of its
//      fields is produced in this body;
//   3. every field assignment of `x` sits in STATEMENT position (reached only
//      through let bodies, sequences, if branches, match arms and while or
//      for bodies), so no temporary is live across it -- only bindings are;
//   4. no binding that may hold a view derived from `x` (transitively)
//      encloses a field assignment of `x`, and no assignment, `return`,
//      `break`, `continue` or lambda carries such a view;
//   5. the assigned value is not itself an unowned view of `x`: a bare
//      projection or a borrow-returning call is retained by the store
//      (codegen's `cc_retain_stored_arg`), and anything else must provably
//      not be a view of `x`.
//
// Anything else keeps today's non-releasing store: a bounded leak, never a
// use-after-free. A parameter receiver is exactly such a case (rule 1).
//
// Rows: one `PaFieldRelease(x)` per approved struct. Codegen releases the old
// field value at every field assignment whose receiver is an approved name.

/// The receiver name of a `__set_field(x, "f", v)` call, or "" when `e` is not
/// one on a plain name.
fn sf_receiver(e: Expr) -> String {
  match e {
    ECall(callee, args, _, _) => match callee {
      EIdent(f, _) => if f == "__set_field" && Array::length(args) == 3 {
        match Array::get(args, 0) {
          EIdent(x, _) => x,
          _ => ""
        }
      } else {
        ""
      },
      _ => ""
    },
    _ => ""
  }
}

fn sf_collect_receivers(e: Expr, out: Array[String]) -> Unit {
  let r = sf_receiver(e)
  if r != "" && !array_contains_str_pctx(out, r) {
    Array::push(out, r)
  } else {
    ()
  }
  let mark = expr_children_push(e)
  let end = expr_children_top()
  let mut i = mark
  while i < end {
    sf_collect_receivers(expr_child_at(i), out)
    i = i + 1
  }
  expr_children_pop(mark)
}

/// Rule 1: a struct literal, possibly behind the parser's ascription wrapper
/// (see tr_fresh_array_value).
fn sf_fresh_struct_value(e: Expr) -> Bool {
  match e {
    ERecord(_, _, _) => true,
    ECall(callee, args, _, _) => match callee {
      EFn(_, _, params, _, _, body) => Array::length(params) == 1 && Array::length(args) == 1 && (Array::get(params, 0)).0 == "__asc" && tr_is_ident(body, "__asc") && sf_fresh_struct_value(Array::get(args, 0)),
      _ => false
    },
    _ => false
  }
}

/// Every name bound anywhere in `e`. A call through one of them calls a local
/// value, whose result this analysis cannot classify.
fn sf_collect_binders(e: Expr, out: Array[String]) -> Unit {
  match e {
    ELet(n, _, _, _) => Array::push(out, n),
    ELetMut(n, _, _, _) => Array::push(out, n),
    ELetRec(n, _, _) => Array::push(out, n),
    EForIn(n, ix, _, _) => {
      Array::push(out, n)
      match ix {
        Some(i) => Array::push(out, i),
        None => ()
      }
    },
    EMatch(_, arms) => {
      let mut i = 0
      while i < Array::length(arms) {
        let _ = pat_names((Array::get(arms, i)).0, out)
        i = i + 1
      }
    },
    EHandle(_, arms) => {
      let mut i = 0
      while i < Array::length(arms) {
        let _ = pat_names((Array::get(arms, i)).0, out)
        i = i + 1
      }
    },
    ELoop(params, _) => {
      let mut i = 0
      while i < Array::length(params) {
        Array::push(out, (Array::get(params, i)).0)
        i = i + 1
      }
    },
    EFn(_, _, params, _, _, _) => {
      let mut i = 0
      while i < Array::length(params) {
        Array::push(out, (Array::get(params, i)).0)
        i = i + 1
      }
    },
    _ => ()
  }
  let mark = expr_children_push(e)
  let end = expr_children_top()
  let mut i = mark
  while i < end {
    sf_collect_binders(expr_child_at(i), out)
    i = i + 1
  }
  expr_children_pop(mark)
}

/// Rule 2: every mention of `x` is a projection object, a field-assignment
/// receiver, or (`tail`) the function's result.
fn sf_mentions_ok(e: Expr, x: String, tail: Bool) -> Bool {
  match e {
    EIdent(n, _) => n != x || tail,
    EDot(obj, _, _, _) => match obj {
      EIdent(_, _) => true,
      _ => sf_mentions_ok(obj, x, false)
    },
    ECall(callee, args, _, _) => if sf_receiver(e) == x {
      sf_mentions_ok(Array::get(args, 2), x, false)
    } else {
      // A method-call spelling `x.m(..)` hands `x` itself to the method.
      let callee_ok = match callee {
        EDot(obj, _, _, _) => !tr_is_ident(obj, x) && sf_mentions_ok(obj, x, false),
        _ => sf_mentions_ok(callee, x, false)
      }
      let mut ok = callee_ok
      let mut i = 0
      while ok && i < Array::length(args) {
        ok = sf_mentions_ok(Array::get(args, i), x, false)
        i = i + 1
      }
      ok
    },
    EFn(_, _, _, _, _, body) => !tr_mentions(body, [x]),
    ELet(_, v, b, _) => sf_mentions_ok(v, x, false) && sf_mentions_ok(b, x, tail),
    ELetMut(_, v, b, _) => sf_mentions_ok(v, x, false) && sf_mentions_ok(b, x, tail),
    ELetRec(_, v, b) => sf_mentions_ok(v, x, false) && sf_mentions_ok(b, x, tail),
    ESeq(a, b) => sf_mentions_ok(a, x, false) && sf_mentions_ok(b, x, tail),
    EAssign(n, v, b) => n != x && sf_mentions_ok(v, x, false) && sf_mentions_ok(b, x, tail),
    EAssignOp(n, _, v, b) => n != x && sf_mentions_ok(v, x, false) && sf_mentions_ok(b, x, tail),
    EIf(c, t, f) => sf_mentions_ok(c, x, false) && sf_mentions_ok(t, x, tail) && sf_mentions_ok(f, x, tail),
    EMatch(sc, arms) => {
      let mut ok = sf_mentions_ok(sc, x, false)
      let mut i = 0
      while ok && i < Array::length(arms) {
        ok = sf_mentions_ok((Array::get(arms, i)).1, x, tail)
        i = i + 1
      }
      ok
    },
    _ => {
      let mark = expr_children_push(e)
      let end = expr_children_top()
      let mut ok = true
      let mut i = mark
      while ok && i < end {
        ok = sf_mentions_ok(expr_child_at(i), x, false)
        i = i + 1
      }
      expr_children_pop(mark)
      ok
    }
  }
}

/// An operator whose result is a fresh Int / Bool / Double / String, never a
/// pointer into an operand.
fn sf_op_fresh(op: String) -> Bool {
  op == "+" || op == "-" || op == "*" || op == "/" || op == "%" || op == "==" || op == "!=" || op == "<" || op == ">" || op == "<=" || op == ">=" || op == "&&" || op == "||" || op == "&" || op == "|" || op == "^" || op == "<<" || op == ">>"
}

/// May the value `e` hold an UNCOUNTED view into `x` or into a binding derived
/// from it (`d`)? Only shapes whose result is known to be owned or scalar
/// answer no; anything else that mentions `d` answers yes.
fn sf_may_view(ctx: PCtx, binders: Array[String], e: Expr, d: Array[String]) -> Bool {
  if !tr_mentions(e, d) {
    false
  } else {
    match e {
      ECall(callee, args, _, _) => match callee {
        EIdent(f, _) => if f == "__set_field" {
          false
        } else if array_contains_str_pctx(binders, f) || is_borrow_ret_fname(ctx, f) || bsearch_leftmost(ctx.view_ret_user, f) >= 0 {
          true
        } else {
          // An owned result. An argument it may keep (a constructor field, a
          // pushed element) is retained by the call when it is a bare name or
          // projection; any other shape that views `d` is refused.
          let mut v = false
          let mut i = 0
          while !v && i < Array::length(args) {
            let a = Array::get(args, i)
            v = match a {
              EIdent(_, _) => false,
              EDot(obj, _, _, _) => match obj {
                EIdent(_, _) => false,
                _ => sf_may_view(ctx, binders, a, d)
              },
              _ => sf_may_view(ctx, binders, a, d)
            }
            i = i + 1
          }
          v
        },
        _ => true
      },
      EBinOp(op, _, _, _) => !sf_op_fresh(op),
      EUnaryOp(op, _) => !(op == "!" || op == "~" || op == "-"),
      _ => true
    }
  }
}

/// Rule 5: the value a field assignment of `x` stores.
fn sf_value_ok(ctx: PCtx, binders: Array[String], v: Expr, d: Array[String]) -> Bool {
  match v {
    EDot(obj, _, _, _) => match obj {
      EIdent(_, _) => true,
      _ => !sf_may_view(ctx, binders, v, d)
    },
    ECall(callee, _, _, _) => match callee {
      EIdent(f, _) => if !array_contains_str_pctx(binders, f) && is_borrow_ret_fname(ctx, f) {
        true
      } else {
        !sf_may_view(ctx, binders, v, d)
      },
      _ => !sf_may_view(ctx, binders, v, d)
    },
    _ => !sf_may_view(ctx, binders, v, d)
  }
}

/// Rule 4, the derivation half: grow `d` (seeded with the struct) by every
/// binder whose value may view a derived name, in one preorder pass. Returns
/// false on a carrier rule 4 forbids.
fn sf_derive(ctx: PCtx, binders: Array[String], e: Expr, d: Array[String]) -> Bool {
  match e {
    ELet(n, v, b, _) => {
      if sf_may_view(ctx, binders, v, d) {
        tr_add(d, n)
      } else {
        ()
      }
      sf_derive(ctx, binders, v, d) && sf_derive(ctx, binders, b, d)
    },
    ELetMut(n, v, b, _) => {
      if sf_may_view(ctx, binders, v, d) {
        tr_add(d, n)
      } else {
        ()
      }
      sf_derive(ctx, binders, v, d) && sf_derive(ctx, binders, b, d)
    },
    ELetRec(n, v, b) => {
      if sf_may_view(ctx, binders, v, d) {
        tr_add(d, n)
      } else {
        ()
      }
      sf_derive(ctx, binders, v, d) && sf_derive(ctx, binders, b, d)
    },
    EForIn(n, ix, it, body) => {
      if sf_may_view(ctx, binders, it, d) {
        tr_add(d, n)
        match ix {
          Some(i) => tr_add(d, i),
          None => ()
        }
      } else {
        ()
      }
      sf_derive(ctx, binders, it, d) && sf_derive(ctx, binders, body, d)
    },
    EMatch(sc, arms) => {
      let from_d = sf_may_view(ctx, binders, sc, d)
      let mut ok = sf_derive(ctx, binders, sc, d)
      let mut i = 0
      while ok && i < Array::length(arms) {
        let (p, body) = Array::get(arms, i)
        if from_d {
          tr_add_pat(d, p)
        } else {
          ()
        }
        ok = sf_derive(ctx, binders, body, d)
        i = i + 1
      }
      ok
    },
    EHandle(hb, arms) => {
      let from_d = sf_may_view(ctx, binders, hb, d)
      let mut ok = sf_derive(ctx, binders, hb, d)
      let mut i = 0
      while ok && i < Array::length(arms) {
        let (p, body) = Array::get(arms, i)
        if from_d {
          tr_add_pat(d, p)
        } else {
          ()
        }
        ok = sf_derive(ctx, binders, body, d)
        i = i + 1
      }
      ok
    },
    ELoop(params, body) => {
      let mut ok = true
      let mut i = 0
      while ok && i < Array::length(params) {
        let (pn, pv) = Array::get(params, i)
        if sf_may_view(ctx, binders, pv, d) {
          tr_add(d, pn)
        } else {
          ()
        }
        ok = sf_derive(ctx, binders, pv, d)
        i = i + 1
      }
      ok && sf_derive(ctx, binders, body, d)
    },
    EAssign(_, v, b) => !sf_may_view(ctx, binders, v, d) && sf_derive(ctx, binders, v, d) && sf_derive(ctx, binders, b, d),
    EAssignOp(_, _, v, b) => !sf_may_view(ctx, binders, v, d) && sf_derive(ctx, binders, v, d) && sf_derive(ctx, binders, b, d),
    EReturn(v) => !sf_may_view(ctx, binders, v, d),
    EBreak(ov) => match ov {
      Some(v) => !sf_may_view(ctx, binders, v, d),
      None => true
    },
    EContinue(vs) => {
      let mut ok = true
      let mut i = 0
      while ok && i < Array::length(vs) {
        ok = !sf_may_view(ctx, binders, Array::get(vs, i), d)
        i = i + 1
      }
      ok
    },
    EFn(_, _, _, _, _, body) => !tr_mentions(body, d),
    _ => {
      let mark = expr_children_push(e)
      let end = expr_children_top()
      let mut ok = true
      let mut i = mark
      while ok && i < end {
        ok = sf_derive(ctx, binders, expr_child_at(i), d)
        i = i + 1
      }
      expr_children_pop(mark)
      ok
    }
  }
}

struct SfWalk {
  x: String;
  d: Array[String];
  binders: Array[String];
  // The binders enclosing the walk's position, innermost last: name, kind
  // (1 let, 2 let mut, 3 let rec, 4 a for / match arm binder) and whether the
  // value is a struct literal.
  bn: Array[String];
  bk: Array[Int];
  bf: Array[Bool];
  mut ok: Bool
}

fn sf_push(w: SfWalk, n: String, k: Int, fresh: Bool) -> Unit {
  Array::push(w.bn, n)
  Array::push(w.bk, k)
  Array::push(w.bf, fresh)
}

fn sf_pop(w: SfWalk, mark: Int) -> Unit {
  Array::truncate(w.bn, mark)
  Array::truncate(w.bk, mark)
  Array::truncate(w.bf, mark)
}

fn sf_push_pat(w: SfWalk, p: Pat) -> Unit {
  let names: Array[String] = []
  let _ = pat_names(p, names)
  let mut i = 0
  while i < Array::length(names) {
    sf_push(w, Array::get(names, i), 4, false)
    i = i + 1
  }
}

/// Rules 1, 3, 4 and 5 at one field assignment of the walk's struct.
fn sf_site(ctx: PCtx, w: SfWalk, value: Expr, stmt: Bool) -> Unit {
  if !stmt || !sf_value_ok(ctx, w.binders, value, w.d) {
    w.ok = false
  } else {
    let mut found = false
    let mut i = Array::length(w.bn) - 1
    while w.ok && i >= 0 {
      let n = Array::get(w.bn, i)
      if n == w.x {
        if !found {
          found = true
          if Array::get(w.bk, i) != 1 || !Array::get(w.bf, i) {
            w.ok = false
          } else {
            ()
          }
        } else {
          ()
        }
      } else if array_contains_str_pctx(w.d, n) {
        w.ok = false
      } else {
        ()
      }
      i = i - 1
    }
    if !found {
      w.ok = false
    } else {
      ()
    }
  }
}

/// `stmt`: every node from the root to here is a let body, a sequence
/// element, an if branch, a match arm or a loop body.
fn sf_walk(ctx: PCtx, w: SfWalk, e: Expr, stmt: Bool) -> Unit {
  if !w.ok {
    ()
  } else {
    match e {
      ELet(n, v, b, _) => {
        sf_walk(ctx, w, v, false)
        let mark = Array::length(w.bn)
        sf_push(w, n, 1, sf_fresh_struct_value(v))
        sf_walk(ctx, w, b, stmt)
        sf_pop(w, mark)
      },
      ELetMut(n, v, b, _) => {
        sf_walk(ctx, w, v, false)
        let mark = Array::length(w.bn)
        sf_push(w, n, 2, false)
        sf_walk(ctx, w, b, stmt)
        sf_pop(w, mark)
      },
      ELetRec(n, v, b) => {
        let mark = Array::length(w.bn)
        sf_push(w, n, 3, false)
        sf_walk(ctx, w, v, false)
        sf_walk(ctx, w, b, stmt)
        sf_pop(w, mark)
      },
      ESeq(a, b) => {
        sf_walk(ctx, w, a, stmt)
        sf_walk(ctx, w, b, stmt)
      },
      EIf(c, t, f) => {
        sf_walk(ctx, w, c, false)
        sf_walk(ctx, w, t, stmt)
        sf_walk(ctx, w, f, stmt)
      },
      EMatch(sc, arms) => {
        // A scrutinee that may view `x` is a temporary live across its arms.
        let arm_stmt = stmt && !sf_may_view(ctx, w.binders, sc, w.d)
        sf_walk(ctx, w, sc, false)
        let mut i = 0
        while i < Array::length(arms) {
          let (p, body) = Array::get(arms, i)
          let mark = Array::length(w.bn)
          sf_push_pat(w, p)
          sf_walk(ctx, w, body, arm_stmt)
          sf_pop(w, mark)
          i = i + 1
        }
      },
      EWhile(c, body) => {
        sf_walk(ctx, w, c, false)
        sf_walk(ctx, w, body, stmt)
      },
      EForIn(n, ix, it, body) => {
        sf_walk(ctx, w, it, false)
        let mark = Array::length(w.bn)
        sf_push(w, n, 4, false)
        match ix {
          Some(i) => sf_push(w, i, 4, false),
          None => ()
        }
        // The iterated array is a temporary live across the body.
        sf_walk(ctx, w, body, stmt && !sf_may_view(ctx, w.binders, it, w.d))
        sf_pop(w, mark)
      },
      EAssign(_, v, b) => {
        sf_walk(ctx, w, v, false)
        sf_walk(ctx, w, b, stmt)
      },
      EAssignOp(_, _, v, b) => {
        sf_walk(ctx, w, v, false)
        sf_walk(ctx, w, b, stmt)
      },
      ECall(callee, args, _, _) => {
        if sf_receiver(e) == w.x {
          sf_site(ctx, w, Array::get(args, 2), stmt)
        } else {
          ()
        }
        sf_walk(ctx, w, callee, false)
        let mut i = 0
        while i < Array::length(args) {
          sf_walk(ctx, w, Array::get(args, i), false)
          i = i + 1
        }
      },
      _ => {
        let mark = expr_children_push(e)
        let end = expr_children_top()
        let mut i = mark
        while i < end {
          sf_walk(ctx, w, expr_child_at(i), false)
          i = i + 1
        }
        expr_children_pop(mark)
      }
    }
  }
}

/// #3140: append the field-release rows for `body` (see the section comment
/// above). Most bodies assign no field, and pay one walk.
fn plan_setfield_release(ctx: PCtx, params: Array[(String, Option[TypeExpr])], body: Expr, actions: Array[PerceusAction]) -> Unit {
  let receivers: Array[String] = []
  sf_collect_receivers(body, receivers)
  if Array::length(receivers) > 0 {
    let binders: Array[String] = []
    let mut pi = 0
    while pi < Array::length(params) {
      Array::push(binders, (Array::get(params, pi)).0)
      pi = pi + 1
    }
    sf_collect_binders(body, binders)
    let mut ri = 0
    while ri < Array::length(receivers) {
      let x = Array::get(receivers, ri)
      if sf_mentions_ok(body, x, true) {
        let d: Array[String] = [x]
        if sf_derive(ctx, binders, body, d) {
          let w = SfWalk::{
            x: x,
            d: d,
            binders: binders,
            bn: [],
            bk: [],
            bf: [],
            ok: true
          }
          sf_walk(ctx, w, body, true)
          if w.ok {
            pr_push_reuse(actions, PaFieldRelease, x, 0)
          } else {
            ()
          }
        } else {
          ()
        }
      } else {
        ()
      }
      ri = ri + 1
    }
  } else {
    ()
  }
}

/// #3184: the stores a slot retains at (`PaStoreDup`), as the source name
/// and source offset of each occurrence, aligned.
export fn perceus_store_dup_rows(plan: Array[PerceusAction], names: Array[String], offs: Array[Int]) -> Unit {
  let mut i = 0
  while i < Array::length(plan) {
    let a = Array::get(plan, i)
    if pa_is_store_dup(a) {
      Array::push(names, a.name)
      Array::push(offs, a.use_offset)
    } else {
      ()
    }
    i = i + 1
  }
}

/// #3140: the structs whose field assignments may release the old value.
export fn perceus_field_release_rows(plan: Array[PerceusAction], out: Array[String]) -> Unit {
  let mut i = 0
  while i < Array::length(plan) {
    let a = Array::get(plan, i)
    if pa_is_field_release(a) {
      Array::push(out, a.name)
    } else {
      ()
    }
    i = i + 1
  }
}

fn tr_type_is_immediate(t: TypeExpr) -> Bool {
  match t {
    TyName(n) => n == "Int" || n == "Bool" || n == "Unit",
    TyUnit => true,
    _ => false
  }
}

/// #2837: is the declared result of this top-level function an Int, a Bool or
/// Unit -- a value that holds no pointer at all? Read from the signature the
/// statement carries, else from the lambda's own return annotation.
export fn fn_result_is_immediate(sig: Option[TypeExpr], value: Expr) -> Bool {
  match fn_sig_return_type(sig) {
    Some(t) => tr_type_is_immediate(t),
    None => match value {
      EFn(_, _, _, ret, _, _) => match ret {
        Some(t) => tr_type_is_immediate(t),
        None => false
      },
      _ => false
    }
  }
}

/// Build the plan for a function whose parameters are owned heap values. Params
/// are declared as bindings (in count + emit lockstep, same ids) so the existing
/// machinery emits a PaDrop for a borrowed-only/unused heap param and a PaDup for
/// one used in multiple owning positions. Heap-ness comes from the param's type
/// annotation (scalar params get scalar=true so they are never dropped).
/// The cached `PCtx` holding exactly these four tables, reset for a new
/// function: installed fresh, kept when the tables compare equal, replaced
/// (and unpinned) otherwise.
fn pctx_cache_select(borrow_ret_names: Array[String], borrow_param_fns: Array[String], borrow_param_masks: Array[Int], view_ret_fns: Array[String]) -> PCtx {
  // Reuse the cached PCtx when the caller's four whole-program tables are
  // content-identical to the cached copies (the per-program common case: one
  // plan per function/lambda, all against the same tables); otherwise build a
  // fresh one and make it the cache. Either way `ctx` is read back out of the
  // cache cell so it is uniformly a borrowed view of the cache-owned PCtx.
  if Array::length(pctx_cache) == 0 {
    Array::push(pctx_cache, pctx_new(borrow_ret_names, borrow_param_fns, borrow_param_masks, view_ret_fns))
  } else if pctx_cache_matches(Array::get(pctx_cache, 0), borrow_ret_names, borrow_param_fns, borrow_param_masks, view_ret_fns) {
    pctx_reset(Array::get(pctx_cache, 0))
  } else {
    // Refill the cached PCtx IN PLACE: field assignment drops the previous
    // tables and working state. Replacing the element via Array::set would
    // leak the whole old context -- the linear lane's arr_set stores without
    // releasing the replaced element.
    let stale = Array::get(pctx_cache, 0)
    pctx_reset(stale)
    stale.pinned = 0
    stale.pctx_names = Array::slice(borrow_ret_names, 0, Array::length(borrow_ret_names))
    stale.borrow_param_user = Array::slice(borrow_param_fns, 0, Array::length(borrow_param_fns))
    stale.borrow_param_mask = Array::slice(borrow_param_masks, 0, Array::length(borrow_param_masks))
    stale.view_ret_user = Array::slice(view_ret_fns, 0, Array::length(view_ret_fns))
  }
  Array::get(pctx_cache, 0)
}

/// #2386: install the four tables once per compile and hand back a token the
/// per-function calls present (`build_perceus_plan_pinned*`). A token is
/// valid exactly while the cache still holds the tables it was issued for:
/// an unpinned call that replaces them clears it, and a pinned call whose
/// token no longer matches falls back to the table compare, so the token can
/// only skip work, never change an answer. Tokens are never reused.
export fn perceus_pin_tables(borrow_ret_names: Array[String], borrow_param_fns: Array[String], borrow_param_masks: Array[Int], view_ret_fns: Array[String]) -> Int {
  let ctx = pctx_cache_select(borrow_ret_names, borrow_param_fns, borrow_param_masks, view_ret_fns)
  let tok = Array::get(pctx_pin_counter, 0) + 1
  Array::set(pctx_pin_counter, 0, tok)
  ctx.pinned = tok
  tok
}

export fn build_perceus_plan_with_params_split(params: Array[(String, Option[TypeExpr])], body: Expr, borrow_ret_names: Array[String], borrow_param_fns: Array[String], borrow_param_masks: Array[Int], view_ret_fns: Array[String], out_param_drop_start: Array[Int]) -> Array[PerceusAction] {
  let ctx = pctx_cache_select(borrow_ret_names, borrow_param_fns, borrow_param_masks, view_ret_fns)
  build_perceus_plan_in_ctx(ctx, params, body, out_param_drop_start)
}

/// `build_perceus_plan_with_params_split` for a caller holding a
/// `perceus_pin_tables` token: the same tables, the compare skipped while the
/// token is current.
export fn build_perceus_plan_pinned_split(token: Int, params: Array[(String, Option[TypeExpr])], body: Expr, borrow_ret_names: Array[String], borrow_param_fns: Array[String], borrow_param_masks: Array[Int], view_ret_fns: Array[String], out_param_drop_start: Array[Int]) -> Array[PerceusAction] {
  let ctx = if token > 0 && Array::length(pctx_cache) > 0 && Array::get(pctx_cache, 0).pinned == token {
    let c = Array::get(pctx_cache, 0)
    pctx_reset(c)
    c
  } else {
    pctx_cache_select(borrow_ret_names, borrow_param_fns, borrow_param_masks, view_ret_fns)
  }
  build_perceus_plan_in_ctx(ctx, params, body, out_param_drop_start)
}

export fn build_perceus_plan_pinned(token: Int, params: Array[(String, Option[TypeExpr])], body: Expr, borrow_ret_names: Array[String], borrow_param_fns: Array[String], borrow_param_masks: Array[Int], view_ret_fns: Array[String]) -> Array[PerceusAction] {
  let ignored = array_empty()
  build_perceus_plan_pinned_split(token, params, body, borrow_ret_names, borrow_param_fns, borrow_param_masks, view_ret_fns, ignored)
}

/// #2389 per-path release: turn the recorded initial-reference occurrences of
/// every binding that a branch merge left split into `PaConsumeMark` rows plus
/// one `PaPathDrop`. A binding qualifies only when it is a plain `let`, a
/// merge actually zeroed its count against a sibling branch that kept it, no
/// occurrence spending its initial reference lacked a source offset, and
/// nothing used it after the split -- every one of those is a shape codegen
/// could not mark, and an unmarked consuming path would turn today's leak
/// into a release of a value already moved out.
///
/// The name a row carries is enough for codegen even though its bookkeeping is
/// name-keyed: every body this plan is built for has been through
/// `uniquify_shadowed_bindings_fresh` (linked_compile's planned-bodies loop,
/// and `rc_plan_source`), so no two bindings of one function share a name --
/// measured, two `let t`s in sibling branches come out as `t` and
/// `__shadow_0_t`. `perceus_path_release_plan_test` pins that. A check here
/// instead would need a name table per binding, which measured as a
/// meaningful share of the planner's allocation on a full-closure compile.
fn pe_emit_path_release(ctx: PCtx) -> Unit {
  let done: Array[Int] = []
  let done_names: Array[String] = []
  let mut mi = 0
  while mi < Array::length(ctx.mark_ids) {
    let id = Array::get(ctx.mark_ids, mi)
    if pe_flag_has(ctx, id, pf_split) && !pe_flag_has(ctx, id, pf_mark_bad) && !pe_flag_has(ctx, id, pf_used_after) {
      let nm = Array::get(ctx.mark_names, mi)
      let _ = pe_push_for(ctx, PaConsumeMark, nm, id, Array::get(ctx.mark_offs, mi))
      if pe_int_array_has(done, id) {
        ()
      } else {
        Array::push(done, id)
        Array::push(done_names, nm)
      }
    } else {
      ()
    }
    mi = mi + 1
  }
  let mut di = 0
  while di < Array::length(done) {
    let _ = pe_push_for(ctx, PaPathDrop, Array::get(done_names, di), Array::get(done, di), 0 - 1)
    di = di + 1
  }
}

fn build_perceus_plan_in_ctx(ctx: PCtx, params: Array[(String, Option[TypeExpr])], body: Expr, out_param_drop_start: Array[Int]) -> Array[PerceusAction] {
  let mut scope: PScope = PsNil
  let mut pi = 0
  while pi < Array::length(params) {
    let (pname, ptype) = Array::get(params, pi)
    let id = pc_declare(ctx, pname, !param_is_heap_in_body(pname, ptype, body))
    scope = PsBind(pname, id, scope)
    pi = pi + 1
  }
  pc_count(ctx, scope, body)
  pctx_apply_borrow_retention(ctx)
  ctx.next_id = 0
  ctx.seq_id = 0
  let mut scope2: PScope = PsNil
  let param_ids = array_empty()
  let mut pj = 0
  while pj < Array::length(params) {
    let (pname, _) = Array::get(params, pj)
    let id = pe_declare(ctx, pname)
    pe_flag_or(ctx, id, pf_exit_owner)
    scope2 = PsBind(pname, id, scope2)
    Array::push(param_ids, id)
    pj = pj + 1
  }
  pc_emit(ctx, scope2, body)
  // The parameters' own scope-end drops are pushed AFTER the whole body, so
  // they are a suffix of the plan. `out_param_drop_start` records where that
  // suffix begins, which is what lets the borrowed-param drop filter in
  // wasi/linked_compile.vibe target the params THEMSELVES instead of matching
  // by name across the entire plan (a body-local binding that shadows a
  // borrowed parameter's name would otherwise lose its own drop -- a leak the
  // filter's comment acknowledges).
  Array::push(out_param_drop_start, Array::length(ctx.actions))
  let mut pk = 0
  while pk < Array::length(params) {
    let (pname, _) = Array::get(params, pk)
    pe_scope_end(ctx, Array::get(param_ids, pk), pname)
    pk = pk + 1
  }
  // ADR-0092 / #2389: append the reuse-pairing candidates AFTER the
  // param-drop suffix -- out_param_drop_start's "drops from here on are the
  // params' own" contract only speaks about drops, and reuse rows are
  // neither drops nor dups, so every existing consumer skips them.
  plan_reuse_pairs(body, ctx.actions)
  // #2389: and the per-path release rows, after the same suffix and for the
  // same reason -- they are neither drops nor dups, so every consumer that
  // reads `out_param_drop_start` skips them.
  pe_emit_path_release(ctx)
  // #3141: the early-exit release rows, after the same suffix for the same
  // reason. The dup budget they read is the whole plan's, so they come after
  // every dup row.
  pe_emit_exit_rows(ctx)
  // #2837: the truncate-release rows, after the same suffix -- neither drops
  // nor dups, so every consumer reading `out_param_drop_start` skips them.
  plan_truncate_release(body, ctx.actions)
  // #3140: the field-release rows, after the same suffix for the same reason.
  plan_setfield_release(ctx, params, body, ctx.actions)
  // An owned copy, NOT ctx.actions itself: the cached PCtx keeps (and later
  // resets) its own actions array, while callers hold the returned plan
  // across subsequent plan builds.
  Array::slice(ctx.actions, 0, Array::length(ctx.actions))
}

/// The plan without the param-drop split index, for callers that do not
/// filter borrowed-parameter drops (lambdas: a lambda has no top-level name,
/// so it is never in the borrow-param set).
export fn build_perceus_plan_with_params(params: Array[(String, Option[TypeExpr])], body: Expr, borrow_ret_names: Array[String], borrow_param_fns: Array[String], borrow_param_masks: Array[Int], view_ret_fns: Array[String]) -> Array[PerceusAction] {
  let ignored = array_empty()
  build_perceus_plan_with_params_split(params, body, borrow_ret_names, borrow_param_fns, borrow_param_masks, view_ret_fns, ignored)
}
