fn pe_use(ctx: PCtx, scope: PScope, name: String, use_offset: Int) -> Int {
  if pe_store_tail_marked(name = name, off = use_offset) && pe_store_dup_at(ctx = ctx, scope = scope, src = name, off = use_offset) {
    ()
  } else if ps_has(s = scope, name = name) {
    let id = ps_get(s = scope, name = name)
    let rem = Array::get(ctx.remaining, at = id)
    // ADR-0092 per-use pairing: a view-call binding holds NO initial owned
    // reference (its value may be an unowned interior view), so its LAST
    // owned use must also dup -- the standard rem == 1 "spend the initial
    // ref" transfer would consume a reference the binding never acquired.
    let last_view_use = rem == 1 && Array::get(ctx.view_call_let, at = id)
    // ADR-0092 for maps: the single owning occurrence of `x` in `x = f(..,
    // x, ..)` moves (see pe_self_reassign_moves) unless the binding is a
    // scalar, itself a view, or a view of it is still live.
    let move_here = ctx.move_use_id == id && !Array::get(ctx.scalar, at = id) && !Array::get(ctx.view_call_let, at = id) && !pe_has_live_view_of(ctx = ctx, id = id)
    // #3141: an owning occurrence consumes one reference the binding holds.
    pe_cons_bump(ctx = ctx, id = id)
    // A parameter consumed inside a loop is accounted by codegen's own rules
    // (a retain at each call site, an epilogue drop for the loop sites, #725
    // and #1085) that a branch merge's budget does not model, so its merges
    // keep today's rows: a leak, where an unmodelled release would free.
    if id < ctx.loop_floor && pe_flag_has(ctx = ctx, id = id, bit = pf_param) {
      pe_flag_or(ctx = ctx, id = id, bit = pf_dsplit_bad)
    } else {
      ()
    }
    if move_here {
      ctx.move_hit = true
      ctx.move_use_id = 0 - 1
    } else if (rem > 1 || last_view_use) && !Array::get(ctx.scalar, at = id) {
      let _ = pe_push_for(ctx = ctx, kind = PaDup, name = name, binding_id = id, use_offset = use_offset)
      pe_note_dup_occurrence(ctx = ctx, id = id, name = name, use_offset = use_offset)
    } else {
      ()
    }
    // #2389: this occurrence spends the binding's INITIAL reference when it
    // moves, or when it is the last owning use and takes the transfer.
    let spends_initial = if move_here {
      true
    } else {
      rem == 1 && !last_view_use && !Array::get(ctx.scalar, at = id)
    }
    pe_note_initial_ref_spent(ctx = ctx, sid = id, name = name, use_offset = use_offset, spends = spends_initial)
    if rem > 0 {
      Array::set(ctx.remaining, at = id, value = rem - 1)
    }
  }
  0
}

/// #3184: `target = src` (an assignment, or a `let mut` initializer) inside
/// a loop body, `src` an owned binding declared OUTSIDE that body. The store
/// runs once per iteration, so it cannot be the transfer of `src`'s one
/// initial reference that a straight-line last use would be: the first
/// iteration handed that reference to the slot, the second released it
/// through the slot's old value and stored the freed block again (VIBE_RC=1
/// answered with whatever reused it, and VIBE_RC=shadow trapped on the next
/// drop). The slot takes a reference of its own at every store instead, and
/// `src` keeps its initial one for its own scope end -- the rule the #3134
/// `let` alias follows. Unlike an alias, one slot is stored from many
/// places, so the row is keyed by the OCCURRENCE: `PaStoreDup(src)` with the
/// occurrence's source offset, which codegen retains at (compile_expr_tail's
/// EAssign and ELetMut arms, and -- for a branch or block tail of a `let` /
/// `let mut` initializer, #3190 -- `let_retain_store_dup_tails`). An
/// occurrence with no source offset cannot be told apart from another of the
/// same name, so it keeps today's transfer.
///
/// Only a slot the plan treats as OWNING takes part (`target_owning`: not
/// scalar -- a `let mut` initialized from a name always is). A scalar slot,
/// the loop-result one above all (`break v` is `__loop_result = v`, stored
/// once before the loop is left), keeps today's transfer: codegen gives it no
/// release to balance a retain with.
///
/// Answers whether it took the value; the caller walks the value otherwise.
fn pe_store_dup(ctx: PCtx, scope: PScope, target: String, target_owning: Bool, value: Expr) -> Bool {
  match value {
    EIdent(src, off) => target_owning && off >= 0 && src != target && pe_store_dup_at(ctx = ctx, scope = scope, src = src, off = off),
    _ => false
  }
}

/// The occurrence `src` at source offset `off` is a value a slot stores:
/// take it as a `PaStoreDup` when `src` is an owned binding from outside the
/// enclosing loop (see `pe_store_dup`), and answer whether it did.
fn pe_store_dup_at(ctx: PCtx, scope: PScope, src: String, off: Int) -> Bool {
  if off >= 0 && ps_has(s = scope, name = src) {
    let sid = ps_get(s = scope, name = src)
    if sid < ctx.loop_floor && !Array::get(ctx.scalar, at = sid) {
      let _ = pe_push_for(ctx = ctx, kind = PaStoreDup, name = src, binding_id = sid, use_offset = off)
      // A use of `src`'s budget like any other owning occurrence, except
      // that the last one is not a transfer: `src` keeps its reference.
      let rem = Array::get(ctx.remaining, at = sid)
      if rem > 1 {
        Array::set(ctx.remaining, at = sid, value = rem - 1)
      } else {
        ()
      }
      pe_note_initial_ref_spent(ctx = ctx, sid = sid, name = src, use_offset = off, spends = false)
      true
    } else {
      false
    }
  } else {
    false
  }
}

/// #3184: the names a stored value hands back from a BRANCH or a BLOCK tail
/// -- `cur = if c { p } else { q }`, `cur = { f(); p }` -- are stores of
/// their own, one per path: `pe_use` takes a marked occurrence through
/// `pe_store_dup_at`. Marked by (name, source offset) on a stack, pushed
/// before the value is walked and truncated after, so a store nested inside
/// the value marks and unmarks its own. The tails are exactly the ones
/// codegen's `assign_retain_store_dup_tails` visits (compile_expr_tail): the
/// branches of an `if`, the arms of a `match` or `handle` and a `handle`'s
/// body, and the body of a `let` / `let mut` / `let rec`, a sequence or an
/// assignment. A name bound inside the value is a local of it, not the
/// outer binding of that spelling, and is left alone; so is the slot itself.
let pe_store_tail_names: Array[String] = []

let pe_store_tail_offs: Array[Int] = []

fn pe_store_tail_marked(name: String, off: Int) -> Bool {
  let mut found = false
  if off >= 0 {
    let mut i = Array::length(pe_store_tail_offs) - 1
    while !found && i >= 0 {
      if Array::get(pe_store_tail_offs, at = i) == off && Array::get(pe_store_tail_names, at = i) == name {
        found = true
      } else {
        ()
      }
      i = i - 1
    }
  } else {
    ()
  }
  found
}

fn pe_mark_store_tails(e: Expr, target: String, inner: Array[String]) -> Unit {
  match e {
    EIdent(x, off) => if off >= 0 && x != target && !array_contains_str_pctx(arr = inner, s = x) {
      Array::push(pe_store_tail_names, value = x)
      Array::push(pe_store_tail_offs, value = off)
    } else {
      ()
    },
    EIf(_, t, el) => {
      pe_mark_store_tails(e = t, target = target, inner = inner)
      pe_mark_store_tails(e = el, target = target, inner = inner)
    },
    EMatch(_, arms) => pe_mark_store_arm_tails(arms = arms, target = target, inner = inner),
    EHandle(hb, arms) => {
      pe_mark_store_tails(e = hb, target = target, inner = inner)
      pe_mark_store_arm_tails(arms = arms, target = target, inner = inner)
    },
    ELet(n, _, b, _) => pe_mark_store_tails_under(b = b, target = target, inner = inner, n = n),
    ELetMut(n, _, b, _) => pe_mark_store_tails_under(b = b, target = target, inner = inner, n = n),
    ELetRec(n, _, b) => pe_mark_store_tails_under(b = b, target = target, inner = inner, n = n),
    ESeq(_, b) => pe_mark_store_tails(e = b, target = target, inner = inner),
    EAssign(_, _, b, _) => pe_mark_store_tails(e = b, target = target, inner = inner),
    EAssignOp(_, _, _, b, _) => pe_mark_store_tails(e = b, target = target, inner = inner),
    _ => ()
  }
}

// `inner` is a stack: a binder is pushed for the walk of the body it scopes
// and truncated after, so marking every `let` initializer in a loop (#3190)
// copies nothing.
fn pe_mark_store_arm_tails(arms: Array[(Pat, Expr)], target: String, inner: Array[String]) -> Unit {
  let mut i = 0
  while i < Array::length(arms) {
    let (ap, ab) = Array::get(arms, at = i)
    let mark = Array::length(inner)
    let _ = pat_names(pat = ap, out = inner)
    pe_mark_store_tails(e = ab, target = target, inner = inner)
    Array::truncate(inner, length = mark)
    i = i + 1
  }
}

fn pe_mark_store_tails_under(b: Expr, target: String, inner: Array[String], n: String) -> Unit {
  let mark = Array::length(inner)
  Array::push(inner, value = n)
  pe_mark_store_tails(e = b, target = target, inner = inner)
  Array::truncate(inner, length = mark)
}

/// #3184 / #3190: walk the value a slot stores -- an assignment's, or a
/// `let` / `let mut` initializer's -- taking each store of an owned binding
/// from outside the enclosing loop as a `PaStoreDup`: the bare name
/// (`pe_store_dup`), or a branch or block tail naming it
/// (`pe_mark_store_tails`, the tails codegen's
/// `assign_retain_store_dup_tails` retains). `owning` is whether the slot
/// holds a reference of its own (not `scalar`); a slot that does not keeps
/// today's plan. `target` is a name the value cannot store into its own slot
/// by naming -- the assigned name -- or "" for a `let` initializer, where
/// the binder is not yet in scope and a same-spelled name is the outer one.
fn pe_emit_store_value(ctx: PCtx, scope: PScope, target: String, owning: Bool, value: Expr) -> Unit {
  if !pe_store_dup(ctx = ctx, scope = scope, target = target, target_owning = owning, value = value) {
    let tail_mark = Array::length(pe_store_tail_offs)
    // Only a binding declared before the loop floor takes a row
    // (`pe_store_dup_at`), and outside every loop there is none.
    if owning && ctx.loop_floor > 0 {
      pe_mark_store_tails(e = value, target = target, inner = array_empty())
    } else {
      ()
    }
    pc_emit(ctx = ctx, scope = scope, expr = value)
    Array::truncate(pe_store_tail_names, length = tail_mark)
    Array::truncate(pe_store_tail_offs, length = tail_mark)
  } else {
    ()
  }
}

/// #3190: `if c { p } else { p }`, or a match whose every arm hands back the
/// same bare `p` (#1915 mechanism 3), is ONE runtime use of `p`, which the
/// EIf / EMatch arms walk once with no source offset. When every one of
/// those occurrences is a marked store tail (`pe_mark_store_tails`), the use
/// is a store of `p` from outside the loop like any other: it takes the one
/// use as a `PaStoreDup` at the first occurrence and adds a row for each
/// other one, so codegen retains on whichever path runs. Answers whether it
/// took the use; the caller walks it the old way otherwise.
fn pe_store_dup_alts(ctx: PCtx, scope: PScope, name: String, offs: Array[Int]) -> Bool {
  let mut all_marked = Array::length(offs) > 0
  let mut i = 0
  while all_marked && i < Array::length(offs) {
    all_marked = pe_store_tail_marked(name = name, off = Array::get(offs, at = i))
    i = i + 1
  }
  if all_marked && pe_store_dup_at(ctx = ctx, scope = scope, src = name, off = Array::get(offs, at = 0)) {
    let sid = ps_get(s = scope, name = name)
    let mut j = 1
    while j < Array::length(offs) {
      let _ = pe_push_for(ctx = ctx, kind = PaStoreDup, name = name, binding_id = sid, use_offset = Array::get(offs, at = j))
      j = j + 1
    }
    true
  } else {
    false
  }
}

/// `borrow_ret_names` is the whole-program borrow-returning-function-name set
/// (see is_borrow_ret_fname), computed ONCE per compile and identical across
/// every function's plan build. COPIED (not aliased) so PCtx solely owns
/// `pctx_names`: the caller's array reaches here through a borrowed struct
/// field read (CompileCtx.borrow_ret_names, see compile_lambda.vibe), so
/// storing it directly would let PCtx's structural drop decrement a refcount
/// this plan never owned -- the #707/#715 double-free shape. One
/// Array::slice is a single allocation + memory.copy of the name pointers.
export fn pctx_new(borrow_ret_names: Array[String], borrow_param_fns: Array[String], borrow_param_masks: Array[Int], view_ret_fns: Array[String]) -> PCtx {
  PCtx::{
    next_id: 0,
    seq_id: 0,
    pinned: 0,
    pctx_names: Array::slice(borrow_ret_names, start = 0, end = Array::length(borrow_ret_names)),
    borrow_param_user: Array::slice(borrow_param_fns, start = 0, end = Array::length(borrow_param_fns)),
    borrow_param_mask: Array::slice(borrow_param_masks, start = 0, end = Array::length(borrow_param_masks)),
    view_ret_user: Array::slice(view_ret_fns, start = 0, end = Array::length(view_ret_fns)),
    uses: [],
    borrows: [],
    scalar: [],
    remaining: [],
    view_call_let: [],
    view_src: [],
    move_use_id: 0 - 1,
    move_hit: false,
    borrowed_view: [],
    branch_value: [],
    loop_floor: 0,
    decl_flags: [],
    mark_ids: [],
    mark_offs: [],
    mark_names: [],
    decl_names: [],
    decl_bodies: [],
    dmark_ids: [],
    dmark_offs: [],
    dmark_names: [],
    dmark_dead: [],
    dmark_marked: [],
    drm_ids: [],
    drm_offs: [],
    dsplit_ids: [],
    dsplit_offs: [],
    dsplit_names: [],
    cons: [],
    exit_ord: 0,
    handle_floor: 0,
    return_floor: 0,
    let_stack: [],
    exit_ids: [],
    exit_ords: [],
    exit_rems: [],
    exit_cons: [],
    exit_names: [],
    actions: [],
  }
}

/// The PCtx built for the most recent whole-program table set, reused across
/// plan builds. pctx_new's four Array::slice copies were the single largest
/// __rt_arr_slice caller in a full-closure compile profile (~7% of total CPU):
/// one plan is built per top-level function AND per lambda, and each paid a
/// fresh copy of the same four program-wide tables. The cache is keyed by
/// CONTENT: build_perceus_plan_with_params_split verifies all four incoming
/// tables element-by-element against the cached copies (cheap -- the elements
/// are the same string objects, so __rt_str_eq answers on its identity fast
/// path) and falls back to a fresh PCtx on any mismatch. Correctness therefore
/// never depends on a set/reset discipline; a stale or half-built cache entry
/// can only cause a miss, never a wrong table.
export let pctx_cache: Array[PCtx] = []

/// #2386: the last token `perceus_pin_tables` issued (see PCtx.pinned).
export let pctx_pin_counter: Array[Int] = [0]

fn same_str_table(a: Array[String], b: Array[String]) -> Bool {
  let la = Array::length(a)
  if la != Array::length(b) {
    false
  } else {
    let mut i = 0
    let mut same = true
    while same && i < la {
      if Array::get(a, at = i) == Array::get(b, at = i) {
        i = i + 1
      } else {
        same = false
      }
    }
    same
  }
}

fn same_int_table(a: Array[Int], b: Array[Int]) -> Bool {
  let la = Array::length(a)
  if la != Array::length(b) {
    false
  } else {
    let mut i = 0
    let mut same = true
    while same && i < la {
      if Array::get(a, at = i) == Array::get(b, at = i) {
        i = i + 1
      } else {
        same = false
      }
    }
    same
  }
}

export fn pctx_cache_matches(ctx: PCtx, borrow_ret_names: Array[String], borrow_param_fns: Array[String], borrow_param_masks: Array[Int], view_ret_fns: Array[String]) -> Bool {
  same_str_table(a = ctx.pctx_names, b = borrow_ret_names) && same_str_table(a = ctx.borrow_param_user, b = borrow_param_fns) && same_int_table(a = ctx.borrow_param_mask, b = borrow_param_masks) && same_str_table(a = ctx.view_ret_user, b = view_ret_fns)
}

/// Clear the per-plan working state of a cached PCtx. The Int / Bool tables
/// are truncated so their buffers are reused: they hold no pointers, and one
/// plan is built per function and per lambda, so re-growing them from empty
/// each time cost ~9 MB of the self-compile heap on the bump lane, which never
/// frees an outgrown buffer. The two tables holding pointers (`mark_names`,
/// `actions`) get fresh empty arrays instead: assignment drops the previous
/// plan's array and its elements, and `actions` is handed out as the plan.
export fn pctx_reset(_ ctx: PCtx) -> Int {
  ctx.next_id = 0
  ctx.seq_id = 0
  Array::truncate(ctx.uses, length = 0)
  Array::truncate(ctx.borrows, length = 0)
  Array::truncate(ctx.scalar, length = 0)
  Array::truncate(ctx.remaining, length = 0)
  Array::truncate(ctx.view_call_let, length = 0)
  Array::truncate(ctx.view_src, length = 0)
  ctx.move_use_id = 0 - 1
  ctx.move_hit = false
  Array::truncate(ctx.borrowed_view, length = 0)
  Array::truncate(ctx.branch_value, length = 0)
  ctx.loop_floor = 0
  Array::truncate(ctx.decl_flags, length = 0)
  Array::truncate(ctx.mark_ids, length = 0)
  Array::truncate(ctx.mark_offs, length = 0)
  let mnames0: Array[String] = []
  ctx.mark_names = mnames0
  let declnames0: Array[String] = []
  ctx.decl_names = declnames0
  let declbodies0: Array[Expr] = []
  ctx.decl_bodies = declbodies0
  Array::truncate(ctx.dmark_ids, length = 0)
  Array::truncate(ctx.dmark_offs, length = 0)
  let dnames0: Array[String] = []
  ctx.dmark_names = dnames0
  let ddead0: Array[Bool] = []
  ctx.dmark_dead = ddead0
  let dmarked0: Array[Bool] = []
  ctx.dmark_marked = dmarked0
  Array::truncate(ctx.drm_ids, length = 0)
  Array::truncate(ctx.drm_offs, length = 0)
  Array::truncate(ctx.dsplit_ids, length = 0)
  Array::truncate(ctx.dsplit_offs, length = 0)
  let snames0: Array[String] = []
  ctx.dsplit_names = snames0
  Array::truncate(ctx.cons, length = 0)
  ctx.exit_ord = 0
  ctx.handle_floor = 0
  ctx.return_floor = 0
  let lets0: Array[String] = []
  ctx.let_stack = lets0
  Array::truncate(ctx.exit_ids, length = 0)
  Array::truncate(ctx.exit_ords, length = 0)
  Array::truncate(ctx.exit_rems, length = 0)
  Array::truncate(ctx.exit_cons, length = 0)
  let enames0: Array[String] = []
  ctx.exit_names = enames0
  let actions0: Array[PerceusAction] = []
  ctx.actions = actions0
  0
}

export fn pc_declare(ctx: PCtx, _name: String, scalar: Bool) -> Int {
  let id = ctx.next_id
  Array::push(ctx.uses, value = 0)
  Array::push(ctx.borrows, value = 0)
  Array::push(ctx.scalar, value = scalar)
  Array::push(ctx.view_call_let, value = false)
  Array::push(ctx.view_src, value = 0 - 1)
  Array::push(ctx.borrowed_view, value = false)
  Array::push(ctx.branch_value, value = false)
  ctx.next_id = id + 1
  id
}

/// The leaf of a STRAIGHT-LINE spine, collecting the names it binds on the
/// way. Branching stops the walk: `view_src` below records ONE source
/// binding, so an if/match spine has no single answer to record.
fn pmvc_spine_leaf(e: Expr, binders: Array[String]) -> Expr {
  match e {
    ELet(n, _, b, _) => {
      Array::push(binders, value = n)
      pmvc_spine_leaf(e = b, binders = binders)
    },
    ELetMut(n, _, b, _) => {
      Array::push(binders, value = n)
      pmvc_spine_leaf(e = b, binders = binders)
    },
    ELetRec(n, _, b) => {
      Array::push(binders, value = n)
      pmvc_spine_leaf(e = b, binders = binders)
    },
    ESeq(_, b) => pmvc_spine_leaf(e = b, binders = binders),
    EAssign(_, _, b, _) => pmvc_spine_leaf(e = b, binders = binders),
    EAssignOp(_, _, _, b, _) => pmvc_spine_leaf(e = b, binders = binders),
    _ => e
  }
}

/// #3114 review: does the result spine of a WRAPPER value end in a borrowed
/// view? The plan-side mirror of codegen's `value_spine_borrowed`
/// (compile_expr_tail), which is what decides that such a binding holds no
/// reference of its own: a leaf is a view when it calls a borrow-returning
/// callee, projects a field, or names an enclosing binding already known to
/// be a view; a branch is a view when ANY tail is, exactly as codegen reads
/// it. Names the spine binds on the way (`binders`, and a match arm's
/// pattern names) are locals, not the enclosing binding of the same
/// spelling, so a leaf naming one is not resolved through `scope` -- the
/// same scoping `pmvc_spine_leaf` gives `pctx_mark_view_call`. Erring toward
/// "view" is the safe side: it can leak an alias's reference, never release
/// one twice.
fn pv_spine_is_view(ctx: PCtx, scope: PScope, e: Expr, binders: Array[String]) -> Bool {
  match e {
    ECall(EIdent(fname, _), _, _, _) => !array_contains_str_pctx(arr = binders, s = fname) && !ps_has(s = scope, name = fname) && is_borrow_ret_fname(ctx = ctx, fname = fname),
    EIdent(x, _) => !array_contains_str_pctx(arr = binders, s = x) && ps_has(s = scope, name = x) && Array::get(ctx.borrowed_view, at = ps_get(s = scope, name = x)),
    EDot(_, _, _, _) => true,
    EIf(_, t, el) => pv_spine_is_view(ctx = ctx, scope = scope, e = t, binders = binders) || pv_spine_is_view(ctx = ctx, scope = scope, e = el, binders = binders),
    EMatch(_, arms) => {
      let mut found = false
      let mut i = 0
      while i < Array::length(arms) && !found {
        let (ap, ab) = Array::get(arms, at = i)
        let mark = Array::length(binders)
        pat_names(pat = ap, out = binders)
        if pv_spine_is_view(ctx = ctx, scope = scope, e = ab, binders = binders) {
          found = true
        } else {
          ()
        }
        Array::truncate(binders, length = mark)
        i = i + 1
      }
      found
    },
    ELet(n, _, b, _) => pv_spine_under_binder(ctx = ctx, scope = scope, n = n, b = b, binders = binders),
    ELetMut(n, _, b, _) => pv_spine_under_binder(ctx = ctx, scope = scope, n = n, b = b, binders = binders),
    ELetRec(n, _, b) => pv_spine_under_binder(ctx = ctx, scope = scope, n = n, b = b, binders = binders),
    ESeq(_, b) => pv_spine_is_view(ctx = ctx, scope = scope, e = b, binders = binders),
    EAssign(_, _, b, _) => pv_spine_is_view(ctx = ctx, scope = scope, e = b, binders = binders),
    EAssignOp(_, _, _, b, _) => pv_spine_is_view(ctx = ctx, scope = scope, e = b, binders = binders),
    _ => false
  }
}

fn pv_spine_under_binder(ctx: PCtx, scope: PScope, n: String, b: Expr, binders: Array[String]) -> Bool {
  let mark = Array::length(binders)
  Array::push(binders, value = n)
  let r = pv_spine_is_view(ctx = ctx, scope = scope, e = b, binders = binders)
  Array::truncate(binders, length = mark)
  r
}

/// #3114: does a plain `let`'s value hand its binder a BORROWED VIEW -- a
/// borrow-returning call, an alias of a view, or a wrapper whose result spine
/// ends in one? pc_count records the answer (`borrowed_view`, and `scalar`
/// with it); pc_emit asks the same question of the same value (#3190), where
/// the binder's id is not yet known.
fn pe_let_value_is_view(ctx: PCtx, scope: PScope, value: Expr) -> Bool {
  match value {
    ECall(EIdent(fname, _), _, _, _) => !ps_has(s = scope, name = fname) && is_borrow_ret_fname(ctx = ctx, fname = fname),
    EIdent(src, _) => ps_has(s = scope, name = src) && Array::get(ctx.borrowed_view, at = ps_get(s = scope, name = src)),
    ELet(_, _, _, _) => pv_spine_is_view(ctx = ctx, scope = scope, e = value, binders = array_empty()),
    ELetMut(_, _, _, _) => pv_spine_is_view(ctx = ctx, scope = scope, e = value, binders = array_empty()),
    ELetRec(_, _, _) => pv_spine_is_view(ctx = ctx, scope = scope, e = value, binders = array_empty()),
    ESeq(_, _) => pv_spine_is_view(ctx = ctx, scope = scope, e = value, binders = array_empty()),
    EAssign(_, _, _, _) => pv_spine_is_view(ctx = ctx, scope = scope, e = value, binders = array_empty()),
    EAssignOp(_, _, _, _, _) => pv_spine_is_view(ctx = ctx, scope = scope, e = value, binders = array_empty()),
    _ => false
  }
}

/// #2750: does a `let mut`'s value reach a borrow-returning call along its
/// straight-line spine? Such a slot acquires a reference of its own, so
/// pc_count never calls it scalar.
fn pe_let_mut_borrowed_call(ctx: PCtx, value: Expr) -> Bool {
  let bc_binders = array_empty()
  match pmvc_spine_leaf(e = value, binders = bc_binders) {
    ECall(EIdent(fname, _), _, _, _) => !array_contains_str_pctx(arr = bc_binders, s = fname) && is_borrow_ret_fname(ctx = ctx, fname = fname),
    _ => false
  }
}

/// #3190: does the `let` (or `let mut`, `is_mut`) binder about to be declared
/// own what its value hands it -- is it NOT `scalar`? The same answer
/// pc_count recorded at the binder's id, recomputed from the value: pc_emit
/// needs it BEFORE walking the value, and the value may declare bindings of
/// its own, so the binder's id is not `ctx.next_id` yet.
fn pe_let_binder_owning(ctx: PCtx, scope: PScope, value: Expr, is_mut: Bool) -> Bool {
  if is_mut {
    pe_let_mut_borrowed_call(ctx = ctx, value = value) || !is_scalar_expr(ctx = ctx, scope = scope, e = value)
  } else {
    !pe_let_value_is_view(ctx = ctx, scope = scope, value = value) && !is_scalar_expr(ctx = ctx, scope = scope, e = value)
  }
}

/// ADR-0092 per-use pairing: mark `id` as a view-call let-binding when its
/// value is a call to a borrow-arg0 fn that may RETURN an unowned view
/// (see PCtx.view_ret_user -- fresh-returning borrow-arg0 callees must
/// keep their binding's scope-end drop or the result leaks). A local that
/// shadows a view-ret name is an ordinary owned closure call (#875).
fn pctx_mark_view_call(ctx: PCtx, scope: PScope, id: Int, value: Expr) -> Int {
  // #2733: a straight-line WRAPPER -- a block, i.e. an `ELet` / `ESeq` chain
  // -- hands back whatever its spine ends in, but this matched the value's
  // TOP node only. A view call behind a block therefore set neither
  // `view_call_let` nor `view_src`, and the planner emitted an ordinary
  // scope-end drop for a binding that holds a view.
  //
  // Only a STRAIGHT-LINE spine is unwrapped: `view_src` records ONE source
  // binding, so a branching spine has no single answer and keeps today's.
  // Names bound along the way are collected -- a leaf mentioning one of them
  // reads that local, not the outer binding of the same spelling, so it must
  // not be resolved through `scope`.
  let binders = array_empty()
  let leaf = pmvc_spine_leaf(e = value, binders = binders)
  match leaf {
    ECall(vc, args, _, _) => match vc {
      EIdent(vf, _) => {
        if !array_contains_str_pctx(arr = binders, s = vf) && !ps_has(s = scope, name = vf) && bsearch_leftmost(sorted = ctx.view_ret_user, name = vf) >= 0 {
          Array::set(ctx.view_call_let, at = id, value = true)
        } else {
          ()
        }
        // ADR-0092 for maps: a value read out of a container by a
        // borrow-returning callee (Map::get, Array::get, a user fn in either
        // view set) views its first argument -- remember which binding, so
        // a self-reassignment of that binding does not move a value this
        // one still reads (pe_has_live_view_of).
        if !array_contains_str_pctx(arr = binders, s = vf) && !ps_has(s = scope, name = vf) && Array::length(args) > 0 && (is_borrow_ret_fname(ctx = ctx, fname = vf) || bsearch_leftmost(sorted = ctx.view_ret_user, name = vf) >= 0) {
          match Array::get(args, at = 0) {
            EIdent(src, _) => if !array_contains_str_pctx(arr = binders, s = src) && ps_has(s = scope, name = src) {
              Array::set(ctx.view_src, at = id, value = ps_get(s = scope, name = src))
            } else {
              ()
            },
            _ => ()
          }
        } else {
          ()
        }
      },
      _ => ()
    },
    EDot(obj, _, _, _) => match obj {
      EIdent(src, _) => if !array_contains_str_pctx(arr = binders, s = src) && ps_has(s = scope, name = src) {
        Array::set(ctx.view_src, at = id, value = ps_get(s = scope, name = src))
      } else {
        ()
      },
      _ => ()
    },
    _ => ()
  }
  0
}

/// Does a binding that views `id` (see pctx_mark_view_call) still have
/// uses ahead of the current emission point? A view used only at borrowed
/// positions keeps its initial count until its scope ends, so it blocks a
/// move for its whole scope -- the safe side.
fn pe_has_live_view_of(ctx: PCtx, id: Int) -> Bool {
  let n = Array::length(ctx.remaining)
  let mut j = 0
  let mut live = false
  while j < n && !live {
    if Array::get(ctx.view_src, at = j) == id && Array::get(ctx.remaining, at = j) > 0 {
      live = true
    } else {
      ()
    }
    j = j + 1
  }
  live
}

/// ADR-0092 for maps: is `value`, the right-hand side of `name = value`, a
/// call that takes `name` exactly once, as a direct argument at an owning
/// position, and nowhere else? Then that occurrence moves the binding's
/// current value into the call (pe_use): the old value is consumed and the
/// binding takes the result, so nothing is left for anyone to release --
/// the assignment lowering already drops nothing for a self-referential
/// right-hand side -- and a unique map reaches Map::set's in-place path.
/// Mirrored by md_self_reassign_move_arg (codegen/common_analysis), which
/// keeps the codegen's loop-carried dup off the same occurrence.
fn pe_self_reassign_moves(ctx: PCtx, scope: PScope, name: String, value: Expr) -> Bool {
  match value {
    ECall(callee, args, _, _) => {
      let callee_is_name = match callee {
        EIdent(c, _) => c == name,
        _ => false
      }
      let bmask = pe_borrow_mask(ctx = ctx, scope = scope, callee = callee)
      let mut direct = 0
      let mut i = 0
      while i < Array::length(args) {
        match Array::get(args, at = i) {
          EIdent(x, _) => if x == name && !pe_bmask_has(mask = bmask, i = i) {
            direct = direct + 1
          } else {
            ()
          },
          _ => ()
        }
        i = i + 1
      }
      !callee_is_name && direct == 1 && reuse_ident_occurrences(e = value, name = name) == 1
    },
    _ => false
  }
}

export fn pe_declare(ctx: PCtx, name: String) -> Int {
  let id = ctx.next_id
  Array::push(ctx.decl_names, value = name)
  Array::push(ctx.decl_bodies, value = EUnit)
  let owning = Array::get(ctx.uses, at = id)
  let init = if owning == 0 {
    1
  } else {
    owning
  }
  Array::push(ctx.remaining, value = init)
  Array::push(ctx.decl_flags, value = 0)
  Array::push(ctx.cons, value = 0)
  ctx.next_id = id + 1
  id
}

fn pc_count_use(ctx: PCtx, scope: PScope, name: String) -> Int {
  if ps_has(s = scope, name = name) {
    let id = ps_get(s = scope, name = name)
    Array::set(ctx.uses, at = id, value = Array::get(ctx.uses, at = id) + 1)
  }
  0
}

export fn pe_scope_end(ctx: PCtx, id: Int, name: String) -> Int {
  if Array::get(ctx.remaining, at = id) > 0 && !Array::get(ctx.scalar, at = id) {
    // ADR-0092 per-use pairing: the scope-end drop releases the binding's
    // INITIAL owned reference. A view-call binding never held one (its
    // value may be an unowned interior view), so the drop over-releases
    // REGARDLESS of how the binding was used -- with owned uses the last
    // use spends the phantom initial ref, with none the retention-driven
    // remaining spends it here (both trapped codegen_heap_e2e_test under
    // the borrowed-arg0 ABI). Suppress unconditionally for the class; a
    // fresh-owned value from a may-return-view callee then leaks (bounded,
    // safe direction). pe_use pairs with this by dup-ing a view binding's
    // last owned use. Params are never in the class (view_call_let is set
    // only from let/seq values).
    if Array::get(ctx.view_call_let, at = id) {
      ()
    } else {
      pe_push_for(ctx = ctx, kind = PaDrop, name = name, binding_id = id, use_offset = -1)
    }
    Array::set(ctx.remaining, at = id, value = 0)
  }
  0
}

// #3141 early-exit release: the exit kinds a `PaExitSite` row carries in
// `binding_id`. Codegen passes the same numbers for the exit it compiles.
let pe_exit_return: Int = 0

let pe_exit_break: Int = 1

let pe_exit_continue: Int = 2

let pe_exit_throw: Int = 3

fn pe_cons_bump(ctx: PCtx, id: Int) -> Unit {
  if id >= 0 && id < Array::length(ctx.cons) {
    Array::set(ctx.cons, at = id, value = Array::get(ctx.cons, at = id) + 1)
  } else {
    ()
  }
}

/// #3141: the branch bookkeeping for `cons`, on a stack of its own so it
/// cannot interleave with `pc_scratch`'s. A frame at `mark` is `[n, the
/// snapshot (n slots), the running max (n slots)]`; only the prefix of ids
/// declared before the branch matters, as for `remaining`.
let pe_cons_scratch: Array[Int] = []

fn pe_cons_begin(_ ctx: PCtx) -> Int {
  let mark = Array::length(pe_cons_scratch)
  let n = Array::length(ctx.cons)
  Array::push(pe_cons_scratch, value = n)
  let mut i = 0
  while i < n {
    Array::push(pe_cons_scratch, value = Array::get(ctx.cons, at = i))
    i = i + 1
  }
  let mut j = 0
  while j < n {
    Array::push(pe_cons_scratch, value = Array::get(ctx.cons, at = j))
    j = j + 1
  }
  mark
}

/// One branch is walked: fold its counts into the running max and restore
/// the snapshot for the next branch.
fn pe_cons_arm(ctx: PCtx, mark: Int) -> Unit {
  let n = Array::get(pe_cons_scratch, at = mark)
  let mut i = 0
  while i < n {
    let at = mark + 1 + n + i
    let c = Array::get(ctx.cons, at = i)
    if c > Array::get(pe_cons_scratch, at = at) {
      Array::set(pe_cons_scratch, at = at, value = c)
    } else {
      ()
    }
    Array::set(ctx.cons, at = i, value = Array::get(pe_cons_scratch, at = mark + 1 + i))
    i = i + 1
  }
}

/// Every branch is walked: leave the max, pop the frame.
fn pe_cons_end(ctx: PCtx, mark: Int) -> Unit {
  let n = Array::get(pe_cons_scratch, at = mark)
  let mut i = 0
  while i < n {
    Array::set(ctx.cons, at = i, value = Array::get(pe_cons_scratch, at = mark + 1 + n + i))
    i = i + 1
  }
  Array::truncate(pe_cons_scratch, length = mark)
}

/// #3168: is `let mut name = value; body` the result slot of a parameterized
/// `loop`? The parser lowers `loop (i = a) { .. break v .. }` to `let mut
/// __loop_result = 0; while true { .. __loop_result = v; break .. };
/// __loop_result`, and the RC lane's uniquify pass may rename the slot, so the
/// SHAPE identifies it: an `Int` placeholder, a `while true` whose value is
/// discarded, and the slot itself as the result. The placeholder is not the
/// slot's type -- every `break v` stores a value of the loop's type -- so the
/// slot is classified from what it stores (`pe_loop_result_stores_heap`), and
/// codegen gives it an owning slot's stores and scope end (compile_expr_tail's
/// ELetMut arm). A user `let mut x = 0` of this shape is an `Int` slot, whose
/// stores are scalars, and a scalar is never released.
export fn perceus_loop_result_slot(name: String, value: Expr, body: Expr) -> Bool {
  let zero = match value {
    EInt(k) => k == 0,
    _ => false
  }
  if zero {
    match body {
      ESeq(EWhile(EBool(true), _), EIdent(n, _)) => n == name,
      // A loop whose value is discarded reaches the plan with its result
      // read in place (`pe_discarded_spine`).
      ESeq(EWhile(EBool(true), _), EDot(EIdent(n, _), f, _, _)) => n == name && f == "",
      _ => false
    }
  } else {
    false
  }
}

/// #3168: does `e` store into the loop-result slot `name` anything but a
/// scalar literal? A nested slot of the same name stores into itself, so the
/// walk does not enter its body, and a closure cannot store into the slot.
fn pe_loop_result_stores_heap(e: Expr, name: String) -> Bool {
  match e {
    EAssign(n, v, b, _) => {
      let scalar = match v {
        EInt(_) => true,
        EBool(_) => true,
        EUnit => true,
        _ => false
      }
      (n == name && !scalar) || pe_loop_result_stores_heap(e = v, name = name) || pe_loop_result_stores_heap(e = b, name = name)
    },
    ELetMut(n, v, b, _) => pe_loop_result_stores_heap(e = v, name = name) || (n != name && pe_loop_result_stores_heap(e = b, name = name)),
    EFn(_, _, _, _, _, _) => false,
    _ => {
      let mark = expr_children_push(e)
      let end = expr_children_top()
      let mut i = mark
      let mut found = false
      while i < end && !found {
        found = pe_loop_result_stores_heap(e = expr_child_at(i), name = name)
        i = i + 1
      }
      expr_children_pop(mark)
      found
    }
  }
}

export fn pc_emit(ctx: PCtx, scope: PScope, expr: Expr) -> Int {
  match expr {
    EInt(_) => 0,
    EFloat(_) => 0,
    EString(_, _) => 0,
    EBool(_) => 0,
    EUnit => 0,
    EStringInterp(_) => 0,
    EIdent(x, off) => pe_use(ctx = ctx, scope = scope, name = x, use_offset = off),
    ECall(callee, args, _, resolution) => {
      let operation = resolved_callee_operation(resolution)
      // Same lexical-shadow guard as pc_count (and compile_call #875).
      let bmask = pe_borrow_mask(ctx = ctx, scope = scope, callee = callee)
      match callee {
        EIdent(_, _) => 0,
        _ => pc_emit(ctx = ctx, scope = scope, expr = callee)
      }
      let mut i = 0
      while i < Array::length(args) {
        let arg = Array::get(args, at = i)
        let saved_return_floor = ctx.return_floor
        if operation == builtin_frame_scope && i == 1 {
          ctx.return_floor = ctx.next_id
        }
        if pe_bmask_has(mask = bmask, i = i) || pc_loop_call_arg_borrow(ctx = ctx, scope = scope, e = arg) {
          match arg {
            EIdent(_, _) => 0,
            _ => pc_emit(ctx = ctx, scope = scope, expr = arg)
          }
        } else {
          pc_emit(ctx = ctx, scope = scope, expr = arg)
        }
        ctx.return_floor = saved_return_floor
        i = i + 1
      }
      if operation == builtin_frame_jump {
        pe_exit(ctx = ctx, scope = scope, kind = 4, floor = ctx.return_floor, operand = EUnit)
      }
      let call_site = return_call_site(resolution)
      if call_site >= 0 {
        pe_exit(ctx = ctx, scope = scope, kind = 5, floor = ctx.return_floor, operand = EInt(call_site))
      }
      // #3141: `throw(x)` is `perform Exception::Throw(x)`, which codegen
      // lowers to a wasm `throw` right after its payload.
      let thrown = pe_throw_payload(scope = scope, callee = callee, args = args)
      match thrown {
        Some(payload) => pe_exit(ctx = ctx, scope = scope, kind = pe_exit_throw, floor = ctx.handle_floor, operand = payload),
        None => ()
      }
      0
    },
    EDot(obj, _field, _, _) => match obj {
      EIdent(_, _) => 0,
      _ => pc_emit(ctx = ctx, scope = scope, expr = obj)
    }
    ,
    ELet(name, value, body, _) => {
      let mut elide_dead_alias = false
      match value {
        EIdent(src, src_off) => {
          if ps_has(s = scope, name = src) {
            let sid = ps_get(s = scope, name = src)
            let rem = Array::get(ctx.remaining, at = sid)
            // ADR-0092 per-use pairing: mirror pe_use -- an alias of a
            // view-call binding must also dup at the source's LAST use
            // (there is no initial owned reference to transfer), so the
            // alias always ACQUIRES ownership and needs no view marking
            // of its own.
            let src_last_view = rem == 1 && Array::get(ctx.view_call_let, at = sid)
            // #3114 review: an `if` / `match` source keeps its own reference
            // (and so its scope-end drop): codegen's retain of a borrowed
            // branch tail is keyed on that drop, so transferring it to the
            // alias would leave the alias releasing an unretained view. The
            // alias acquires its own reference instead, as for a source with
            // later uses.
            // #3134: a source declared OUTSIDE the enclosing loop body is
            // loop-carried. `let w = p` inside the body runs every
            // iteration, so it cannot be the transfer of `p`'s one initial
            // reference that a straight-line last use would be: the first
            // iteration's consumer (`keep(w)`) freed `p` and the next
            // iteration read freed memory. The alias always ACQUIRES its
            // own reference instead, and `p` keeps its initial one for its
            // own scope-end drop (the `remaining` floor below). The direct
            // spelling `keep(p)` is protected by codegen's #706 retain;
            // an alias never reached that, because the consuming call names
            // `w`, which is declared inside the body.
            let src_loop_carried = sid < ctx.loop_floor
            let src_keeps = Array::get(ctx.branch_value, at = sid) || src_loop_carried
            if (rem > 1 || src_last_view || src_keeps) && !Array::get(ctx.scalar, at = sid) {
              // #1056 (almide `alias_safety.rs` comparison, rc check
              // elision): this occurrence of `let name = src` would dup
              // src's reference into `name`'s own slot. `ctx.next_id` is
              // about to become `name`'s id (pe_declare below); `ctx.uses`
              // at that id already holds `name`'s FINAL use count from the
              // pc_count pass (borrow occurrences folded in by
              // pctx_apply_borrow_retention, which runs before pc_emit
              // starts) -- ids are assigned in identical tree order across
              // both passes (see build_perceus_plan), so this id is exactly
              // the one pc_count computed uses for. If that count is zero,
              // `name` has NO occurrence anywhere in `body` (no owning use,
              // no borrow): the dup this occurrence would emit and the
              // unconditional scope-end drop `name` would otherwise get
              // (pe_scope_end -- an unused non-scalar binding always keeps
              // its one owned reference) are a pure no-op pair on the SAME
              // memory with no intervening read -- increment then
              // decrement, nothing observes the difference. Skipping both
              // (no PaAliasDup here; `name`'s own `remaining` is zeroed
              // right after pe_declare below so pe_scope_end's `remaining >
              // 0` check does not fire) removes one dup + one drop of
              // runtime rc traffic with no change in observable behavior.
              // `src`'s own remaining-use bookkeeping is untouched (still
              // decremented below exactly as without this elision) -- this
              // occurrence still "spends" one of src's owning uses,
              // precisely as if the dup had fired, so src's later
              // occurrences / scope-end drop are unaffected.
              if Array::get(ctx.uses, at = ctx.next_id) == 0 {
                elide_dead_alias = true
                0
              } else {
                pe_push_for(ctx = ctx, kind = PaAliasDup, name = name, binding_id = ctx.next_id, use_offset = src_off)
              }
            } else {
              0
            }
            // #2389: with no dup emitted above this occurrence TRANSFERS the
            // source's initial reference, exactly as pe_use's last owning use
            // does -- same condition, negated.
            let alias_transfers = rem == 1 && !src_last_view && !src_keeps && !Array::get(ctx.scalar, at = sid)
            pe_note_initial_ref_spent(ctx = ctx, sid = sid, name = src, use_offset = src_off, spends = alias_transfers)
            // #3141: a transfer hands the alias the source's reference; a
            // dup'd alias takes a reference of its own and leaves the
            // source's untouched.
            if alias_transfers {
              pe_cons_bump(ctx = ctx, id = sid)
            } else {
              ()
            }
            if rem > 1 || (rem == 1 && !(src_keeps && !Array::get(ctx.scalar, at = sid))) {
              Array::set(ctx.remaining, at = sid, value = rem - 1)
            } else {
              ()
            }
          } else {
            ()
          }
          0
        },
        // #3190: a branch or block tail of the value naming an owned binding
        // from outside the enclosing loop is a store into this binder that
        // runs once per iteration, exactly as the tail of an assignment is
        // (`pe_emit_store_value`). A bare name is the alias above, which
        // takes a reference of its own by the same rule (#3134).
        _ => {
          pe_emit_store_value(ctx = ctx, scope = scope, target = "", owning = pe_let_binder_owning(ctx = ctx, scope = scope, value = value, is_mut = false), value = value)
          0
        }
      }
      let id = pe_declare(ctx = ctx, name = name)
      pe_flag_or(ctx = ctx, id = id, bit = pf_exit_owner)
      // #2389: a plain `let` is the one declaration form whose local still
      // holds the same value at scope end that a consume moved out of.
      if !Array::get(ctx.scalar, at = id) && !Array::get(ctx.view_call_let, at = id) {
        pe_flag_or(ctx = ctx, id = id, bit = pf_let)
        Array::set(ctx.decl_bodies, at = id, value = body)
      } else {
        ()
      }
      if elide_dead_alias {
        Array::set(ctx.remaining, at = id, value = 0)
      }
      Array::push(ctx.let_stack, value = name)
      pc_emit(ctx = ctx, scope = PsBind(name, id, scope), expr = body)
      Array::truncate(ctx.let_stack, length = Array::length(ctx.let_stack) - 1)
      pe_scope_end(ctx = ctx, id = id, name = name)
    },
    ELetMut(name, value, body, _) => {
      // #3184: an initializer naming an owned binding from outside the
      // enclosing loop runs once per iteration, like a store -- and so does
      // one handing such a binding back from a branch or a block tail
      // (#3190: `let mut c = if k { p } else { A(..) }`, which transferred
      // `p` into the slot on every iteration). The binder is not in scope
      // in its own initializer, so no name in it is excluded as the slot.
      pe_emit_store_value(ctx = ctx, scope = scope, target = "", owning = pe_let_binder_owning(ctx = ctx, scope = scope, value = value, is_mut = true), value = value)
      let id = pe_declare(ctx = ctx, name = name)
      pe_flag_or(ctx = ctx, id = id, bit = pf_exit_owner)
      if pe_stores_tuple(e = body, name = name) {
        pe_flag_or(ctx = ctx, id = id, bit = pf_mut_assigned)
      } else {
        ()
      }
      pc_emit(ctx = ctx, scope = PsBind(name, id, scope), expr = body)
      pe_scope_end(ctx = ctx, id = id, name = name)
    },
    ELetRec(name, value, body) => {
      let id = pe_declare(ctx = ctx, name = name)
      let owns_closure = match value {
        EFn(_, _, _, _, _, _) => true,
        _ => false
      }
      if owns_closure {
        pe_flag_or(ctx = ctx, id = id, bit = pf_exit_owner)
      } else {
        ()
      }
      let s2 = PsBind(name, id, scope)
      pc_emit(ctx = ctx, scope = s2, expr = value)
      if owns_closure {
        Array::push(ctx.let_stack, value = name)
      } else {
        ()
      }
      pc_emit(ctx = ctx, scope = s2, expr = body)
      if owns_closure {
        Array::truncate(ctx.let_stack, length = Array::length(ctx.let_stack) - 1)
      } else {
        ()
      }
      pe_scope_end(ctx = ctx, id = id, name = name)
    },
    EAssign(name, value, body, _) => {
      // ADR-0092 for maps: `x = f(.., x, ..)` moves x's current value into
      // the call (pe_self_reassign_moves / pe_use). The binding then holds
      // the call's result with its own initial reference, so its remaining
      // count is topped back up by the one the move spent: the scope end
      // still releases whatever it holds last. A self-reassignment whose
      // occurrence dupped instead (a live view) leaks the old value, as it
      // did before -- the lowering drops nothing for a self-referential
      // right-hand side.
      let mid = if ps_has(s = scope, name = name) && pe_self_reassign_moves(ctx = ctx, scope = scope, name = name, value = value) {
        ps_get(s = scope, name = name)
      } else {
        0 - 1
      }
      ctx.move_use_id = mid
      ctx.move_hit = false
      let owning = ps_has(s = scope, name = name) && !Array::get(ctx.scalar, at = ps_get(s = scope, name = name))
      pe_emit_store_value(ctx = ctx, scope = scope, target = name, owning = owning, value = value)
      ctx.move_use_id = 0 - 1
      if ctx.move_hit {
        Array::set(ctx.remaining, at = mid, value = Array::get(ctx.remaining, at = mid) + 1)
        // #3141: and the reference the move spent is replaced by the one the
        // binding now holds for the result, so it no longer counts as
        // consumed at a later exit. The occurrence bumped it in `pe_use`, so
        // this never takes it below what the value walk found.
        if Array::get(ctx.cons, at = mid) > 0 {
          Array::set(ctx.cons, at = mid, value = Array::get(ctx.cons, at = mid) - 1)
        } else {
          ()
        }
      } else {
        ()
      }
      ctx.move_hit = false
      pc_emit(ctx = ctx, scope = scope, expr = body)
    },
    EAssignOp(_name, _op, value, body, _) => {
      pc_emit(ctx = ctx, scope = scope, expr = value)
      pc_emit(ctx = ctx, scope = scope, expr = body)
    },
    ESeq(a, b) => {
      pc_emit(ctx = ctx, scope = scope, expr = pe_discarded_head(a))
      let nm = next_seq_name(ctx)
      let id = pe_declare(ctx = ctx, name = nm)
      pc_emit(ctx = ctx, scope = scope, expr = b)
      pe_scope_end(ctx = ctx, id = id, name = nm)
    },
    // #3135: an operator reads its operands and never releases them (see
    // pc_operand_count), so a bare name there is a borrow, as at a borrowed
    // call position.
    EBinOp(_op, l, r, _) => {
      pc_operand_emit(ctx = ctx, scope = scope, e_in = l)
      pc_operand_emit(ctx = ctx, scope = scope, e_in = r)
    },
    EUnaryOp(_op, e) => pc_operand_emit(ctx = ctx, scope = scope, e_in = e),
    ETuple(items) => {
      let mut i = 0
      while i < Array::length(items) {
        pc_emit(ctx = ctx, scope = scope, expr = Array::get(items, at = i))
        i = i + 1
      }
      0
    },
    EArray(items) => {
      let mut i = 0
      while i < Array::length(items) {
        pc_emit(ctx = ctx, scope = scope, expr = Array::get(items, at = i))
        i = i + 1
      }
      0
    },
    ERecord(_, fields, _) => {
      let mut i = 0
      while i < Array::length(fields) {
        pc_emit(ctx = ctx, scope = scope, expr = (Array::get(fields, at = i)).1)
        i = i + 1
      }
      0
    },
    EMap(fields) => {
      let mut i = 0
      while i < Array::length(fields) {
        pc_emit(ctx = ctx, scope = scope, expr = (Array::get(fields, at = i)).1)
        i = i + 1
      }
      0
    },
    EIf(cond, then_e, else_e) => {
      pc_emit(ctx = ctx, scope = scope, expr = cond)
      // #1915 mechanism 3: `if c { out } else { out }` — every branch the
      // SAME bare ident — is ONE owned use at runtime, whichever branch
      // executes. Walking both branches pushed one PaDup per branch whenever
      // remaining > 1 at branch entry (exactly what the #706 borrow-retention
      // bump produces for a loop borrow-use), and codegen realizes every
      // planned dup unconditionally at the binding's declaration site
      // (rc_dup_names occurrence count) — the summed budget leaked one owned
      // object per call for the standard `builder loop + if/else tail`
      // shape. Walk the use once instead: the final `remaining` is identical
      // to the old snap/min dance (each branch decremented by exactly one),
      // only the duplicate sibling dup disappears. Anything but this exact
      // shape keeps the general per-branch walk below unchanged.
      if eif_same_ident_branches(then_e = then_e, else_e = else_e) {
        // This action represents either branch, not the first branch's
        // concrete syntax node. Keep it on the declaration-site fallback
        // until codegen can represent a set of alternative use sites --
        // except for a store (#3190), whose row names each occurrence.
        match then_e {
          EIdent(name, toff) => {
            let eoff = match else_e {
              EIdent(_, o) => o,
              _ => 0 - 1
            }
            if pe_store_dup_alts(ctx = ctx, scope = scope, name = name, offs = [
              toff,
              eoff
            ]) {
              0
            } else {
              pe_use(ctx = ctx, scope = scope, name = name, use_offset = -1)
            }
          },
          _ => 0
        }
      } else {
        let n = Array::length(ctx.remaining)
        let snap = pc_snap(ctx.remaining)
        let cmark = pe_cons_begin(ctx)
        let dm0 = Array::length(ctx.dmark_ids)
        pc_emit(ctx = ctx, scope = scope, expr = then_e)
        let dm1 = Array::length(ctx.dmark_ids)
        pe_cons_arm(ctx = ctx, mark = cmark)
        // #1100 alloc cut: swap the prefix instead of taking a SECOND copy —
        // one pass both restores `remaining` to the pre-branch values (what
        // restore_prefix did) and captures the then-branch's values into
        // `snap`'s buffer (what the `then_rem` copy was for). Same values in
        // the same places, one allocation instead of two per `if`; the
        // branch-snapshot copies were the plan's largest allocation source
        // on a full-closure compile.
        let mut sw = 0
        while sw < n {
          let then_v = Array::get(ctx.remaining, at = sw)
          Array::set(ctx.remaining, at = sw, value = Array::get(pc_scratch, at = snap + sw))
          Array::set(pc_scratch, at = snap + sw, value = then_v)
          sw = sw + 1
        }
        pc_emit(ctx = ctx, scope = scope, expr = else_e)
        let dm2 = Array::length(ctx.dmark_ids)
        pe_cons_arm(ctx = ctx, mark = cmark)
        pe_cons_end(ctx = ctx, mark = cmark)
        // Before the min below overwrites the else arm's counts.
        if dm2 > dm0 {
          let rem = ctx.remaining
          pe_dup_merge_arms(ctx = ctx, n = n, bounds = [dm0, dm1, dm2], owed = (id: Int) -> Bool {
            Array::get(pc_scratch, at = snap + id) > 0 && Array::get(rem, at = id) > 0
          })
        } else {
          ()
        }
        // #705: leave the MIN remaining over both branches. A binding consumed in
        // one branch (e.g. a param threaded into a ctor in the `then`) but not the
        // other was previously left at the `else` branch's (higher) remaining, so
        // the scope-end drop fired on a value the taken branch already moved out —
        // a double free. Min means a binding consumed on ANY path is not
        // re-dropped (the non-consuming path leaks one ref, which is safe) instead
        // of the consuming path double-freeing (crash). Prefix-only (outer ids).
        // (`snap` holds the THEN branch's values after the swap above.)
        let mut i = 0
        while i < n {
          let tv = Array::get(pc_scratch, at = snap + i)
          let ev = Array::get(ctx.remaining, at = i)
          // #2389: one branch spent the initial reference and the other did
          // not, so the min below plans the scope-end drop away and the
          // non-consuming path never releases it. Record the split; the
          // guarded drop is emitted once the whole body is walked.
          if pe_flag_has(ctx = ctx, id = i, bit = pf_let) {
            if (tv == 0 && ev > 0) || (ev == 0 && tv > 0) {
              pe_flag_or(ctx = ctx, id = i, bit = pf_split)
            } else {
              ()
            }
          } else {
            ()
          }
          if tv < ev {
            Array::set(ctx.remaining, at = i, value = tv)
          } else {
            ()
          }
          i = i + 1
        }
        Array::truncate(pc_scratch, length = snap)
        0
      }
    },
    EWhile(cond, body) => {
      // #3134: bindings declared from here on belong to the loop body.
      let saved_floor = ctx.loop_floor
      ctx.loop_floor = ctx.next_id
      pc_emit(ctx = ctx, scope = scope, expr = cond)
      // #3162: each iteration's body value is dropped unreleased.
      pc_emit(ctx = ctx, scope = scope, expr = pe_discarded_spine(body))
      ctx.loop_floor = saved_floor
      0
    },
    EReturn(e) => {
      pc_emit(ctx = ctx, scope = scope, expr = e)
      pe_exit(ctx = ctx, scope = scope, kind = pe_exit_return, floor = 0, operand = e)
      0
    },
    ESpread(e) => pc_emit(ctx = ctx, scope = scope, expr = e),
    ELabeledArg(_l, _n, e) => pc_emit(ctx = ctx, scope = scope, expr = e),
    EBreak(opt) => {
      match opt {
        Some(e) => {
          pc_emit(ctx = ctx, scope = scope, expr = e)
          pe_exit(ctx = ctx, scope = scope, kind = pe_exit_break, floor = ctx.loop_floor, operand = e)
        },
        None => pe_exit(ctx = ctx, scope = scope, kind = pe_exit_break, floor = ctx.loop_floor, operand = EUnit)
      }
      0
    },
    // #3141: codegen compiles no `continue` payload (the parameterized loop
    // is lowered before this plan), so neither does the plan.
    EContinue(_) => {
      pe_exit(ctx = ctx, scope = scope, kind = pe_exit_continue, floor = ctx.loop_floor, operand = EUnit)
      0
    },
    // compile_lambda gives the closure environment its own reference to
    // every heap capture. Creating the closure therefore borrows the
    // defining binding; its initial reference still needs a scope drop.
    EFn(_, _, _, _, _, _) => 0,
    EForIn(value_name, index_opt, iterable, fbody) => {
      // The loop reads a named iterable without taking its reference.
      // A temporary expression still follows its normal ownership path.
      pc_operand_emit(ctx = ctx, scope = scope, e_in = iterable)
      // #3134: the iterable runs once; the element binding and the body
      // run per element (see the EWhile arm).
      let saved_floor = ctx.loop_floor
      ctx.loop_floor = ctx.next_id
      let idv = pe_declare(ctx = ctx, name = value_name)
      let s2 = PsBind(value_name, idv, scope)
      let s3 = match index_opt {
        Some(idx) => {
          let idi = pe_declare(ctx = ctx, name = idx)
          PsBind(idx, idi, s2)
        },
        None => s2
      }
      pc_emit(ctx = ctx, scope = s3, expr = fbody)
      pe_scope_end(ctx = ctx, id = idv, name = value_name)
      ctx.loop_floor = saved_floor
      0
    },
    ELoop(params, lbody) => {
      // #3134: `continue` re-enters the body, so it is a loop body like
      // EWhile's. The parameters count as inside: each iteration rebinds
      // them to the values `continue` passes.
      let saved_floor = ctx.loop_floor
      ctx.loop_floor = ctx.next_id
      let mut s = scope
      let pids: Array[Int] = []
      let pnames: Array[String] = []
      let mut i = 0
      while i < Array::length(params) {
        let p = Array::get(params, at = i)
        pc_emit(ctx = ctx, scope = scope, expr = p.1)
        let pid = pe_declare(ctx = ctx, name = p.0)
        s = PsBind(p.0, pid, s)
        Array::push(pids, value = pid)
        Array::push(pnames, value = p.0)
        i = i + 1
      }
      pc_emit(ctx = ctx, scope = s, expr = lbody)
      let mut j = 0
      while j < Array::length(pids) {
        pe_scope_end(ctx = ctx, id = Array::get(pids, at = j), name = Array::get(pnames, at = j))
        j = j + 1
      }
      ctx.loop_floor = saved_floor
      0
    },
    EMatch(scrut, arms) => {
      match scrut {
        EIdent(_, _) => 0,
        _ => pc_emit(ctx = ctx, scope = scope, expr = scrut)
      }
      // A single arm has no alternative control-flow state to merge. Count and
      // emit it directly so the overwhelmingly common lowered residual match
      // avoids the branch snapshot arrays. Empty and multi-arm matches retain
      // the general path below.
      if Array::length(arms) == 1 {
        let arm = Array::get(arms, at = 0)
        let pnames: Array[String] = []
        pat_names(pat = arm.0, out = pnames)
        let mut s = scope
        let pids: Array[Int] = []
        let mut k = 0
        while k < Array::length(pnames) {
          let nm = Array::get(pnames, at = k)
          let pid = pe_declare(ctx = ctx, name = nm)
          s = PsBind(nm, pid, s)
          Array::push(pids, value = pid)
          k = k + 1
        }
        pc_emit(ctx = ctx, scope = s, expr = arm.1)
        let mut j = 0
        while j < Array::length(pids) {
          pe_scope_end(ctx = ctx, id = Array::get(pids, at = j), name = Array::get(pnames, at = j))
          j = j + 1
        }
        0
      } else if ematch_same_ident_arms(arms) {
        // #1915 mechanism 3 (see the EIf arm above): every arm body is the
        // same bare ident, so the match performs exactly one owned use at
        // runtime — walk the use once (first arm) instead of budgeting one
        // dup per arm. Pattern bindings are still declared per arm in the
        // same order as the counting pass (id alignment is load-bearing) and
        // still get their scope-end handling.
        let mut a = 0
        while a < Array::length(arms) {
          let arm = Array::get(arms, at = a)
          let pnames: Array[String] = []
          pat_names(pat = arm.0, out = pnames)
          let mut s = scope
          let pids: Array[Int] = []
          let mut k = 0
          while k < Array::length(pnames) {
            let nm = Array::get(pnames, at = k)
            let pid = pe_declare(ctx = ctx, name = nm)
            s = PsBind(nm, pid, s)
            Array::push(pids, value = pid)
            k = k + 1
          }
          if a == 0 {
            // The one merged action represents every arm. It must not inherit
            // only the first arm's source position (see the EIf case above)
            // -- except for a store (#3190), whose rows name every arm's.
            match arm.1 {
              EIdent(name, _) => if pe_store_dup_alts(ctx = ctx, scope = s, name = name, offs = ematch_arm_ident_offs(arms)) {
                0
              } else {
                pe_use(ctx = ctx, scope = s, name = name, use_offset = -1)
              },
              _ => 0
            }
          } else {
            ()
          }
          let mut j = 0
          while j < Array::length(pids) {
            pe_scope_end(ctx = ctx, id = Array::get(pids, at = j), name = Array::get(pnames, at = j))
            j = j + 1
          }
          a = a + 1
        }
        0
      } else {
        let n = Array::length(ctx.remaining)
        let snap = pc_snap(ctx.remaining)
        // #705: track the MIN remaining over all arms (see EIf). An arm that
        // consumes an outer binding (e.g. a param re-stored into a ctor) leaves it
        // at a lower remaining; leaving the LAST arm's (higher) value made the
        // scope-end drop double-free that binding on the arm that consumed it.
        let minrem = pc_snap_slots(at = snap, n = n)
        // #2389: the ids whose scope-end drop a min-merge could plan away --
        // plain `let` bindings still holding their initial reference. Almost
        // always none or a handful, so the per-arm bookkeeping below is over
        // the candidates and not over every binding, and nothing at all is
        // pushed when there are none.
        let cmark = Array::length(pc_scratch)
        let mut cs = 0
        while cs < n {
          if pe_flag_has(ctx = ctx, id = cs, bit = pf_let) && Array::get(ctx.remaining, at = cs) > 0 {
            Array::push(pc_scratch, value = cs)
          } else {
            ()
          }
          cs = cs + 1
        }
        let ccount = Array::length(pc_scratch) - cmark
        let cmax = pc_snap_zeros(ccount)
        let consmark = pe_cons_begin(ctx)
        // `pe_dup_merge`'s arm boundaries in `dmark_*`, one slot per arm plus
        // the start, on the scratch stack (a nested construct in an arm
        // truncates back to its own mark, above these).
        let dbmark = Array::length(pc_scratch)
        Array::push(pc_scratch, value = Array::length(ctx.dmark_ids))
        let mut a = 0
        while a < Array::length(arms) {
          let arm = Array::get(arms, at = a)
          pc_snap_restore(dst = ctx.remaining, at = snap, n = n)
          let pnames: Array[String] = []
          pat_names(pat = arm.0, out = pnames)
          let mut s = scope
          let pids: Array[Int] = []
          let mut k = 0
          while k < Array::length(pnames) {
            let nm = Array::get(pnames, at = k)
            let pid = pe_declare(ctx = ctx, name = nm)
            s = PsBind(nm, pid, s)
            Array::push(pids, value = pid)
            k = k + 1
          }
          pc_emit(ctx = ctx, scope = s, expr = arm.1)
          let mut j = 0
          while j < Array::length(pids) {
            pe_scope_end(ctx = ctx, id = Array::get(pids, at = j), name = Array::get(pnames, at = j))
            j = j + 1
          }
          let mut mi = 0
          while mi < n {
            if Array::get(ctx.remaining, at = mi) < Array::get(pc_scratch, at = minrem + mi) {
              Array::set(pc_scratch, at = minrem + mi, value = Array::get(ctx.remaining, at = mi))
            } else {
              ()
            }
            mi = mi + 1
          }
          let mut cj = 0
          while cj < ccount {
            let cid = Array::get(pc_scratch, at = cmark + cj)
            if Array::get(ctx.remaining, at = cid) > Array::get(pc_scratch, at = cmax + cj) {
              Array::set(pc_scratch, at = cmax + cj, value = Array::get(ctx.remaining, at = cid))
            } else {
              ()
            }
            cj = cj + 1
          }
          pe_cons_arm(ctx = ctx, mark = consmark)
          Array::push(pc_scratch, value = Array::length(ctx.dmark_ids))
          a = a + 1
        }
        pe_cons_end(ctx = ctx, mark = consmark)
        let nb = Array::length(arms) + 1
        if Array::get(pc_scratch, at = dbmark + nb - 1) > Array::get(pc_scratch, at = dbmark) {
          let bounds = Array::slice(pc_scratch, start = dbmark, end = dbmark + nb)
          pe_dup_merge_arms(ctx = ctx, n = n, bounds = bounds, owed = (id: Int) -> Bool {
            Array::get(pc_scratch, at = minrem + id) > 0
          })
        } else {
          ()
        }
        let mut ck = 0
        while ck < ccount {
          let cid = Array::get(pc_scratch, at = cmark + ck)
          if Array::get(pc_scratch, at = minrem + cid) == 0 && Array::get(pc_scratch, at = cmax + ck) > 0 {
            pe_flag_or(ctx = ctx, id = cid, bit = pf_split)
          } else {
            ()
          }
          ck = ck + 1
        }
        pc_snap_restore(dst = ctx.remaining, at = minrem, n = n)
        Array::truncate(pc_scratch, length = snap)
        0
      }
    },
    EHandle(hbody, arms) => {
      let n = Array::length(ctx.remaining)
      let snap = pc_snap(ctx.remaining)
      // #3141: a `throw` in the body leaves exactly the bindings the body
      // declares; the handler arms run outside it.
      let saved_handle_floor = ctx.handle_floor
      ctx.handle_floor = ctx.next_id
      pc_emit(ctx = ctx, scope = scope, expr = hbody)
      ctx.handle_floor = saved_handle_floor
      // An arm runs after SOME prefix of the body, so it starts from what the
      // whole body consumed: `cons` must bound every path, and `remaining`
      // (restored to the pre-body counts below) does not.
      let consmark = pe_cons_begin(ctx)
      let minrem = pc_snap(ctx.remaining)
      let mut a = 0
      while a < Array::length(arms) {
        let arm = Array::get(arms, at = a)
        pc_snap_restore(dst = ctx.remaining, at = snap, n = n)
        let pnames: Array[String] = []
        pat_names(pat = arm.0, out = pnames)
        let mut s = scope
        let pids: Array[Int] = []
        let mut k = 0
        while k < Array::length(pnames) {
          let nm = Array::get(pnames, at = k)
          let pid = pe_declare(ctx = ctx, name = nm)
          s = PsBind(nm, pid, s)
          Array::push(pids, value = pid)
          k = k + 1
        }
        pc_emit(ctx = ctx, scope = s, expr = arm.1)
        let mut j = 0
        while j < Array::length(pids) {
          pe_scope_end(ctx = ctx, id = Array::get(pids, at = j), name = Array::get(pnames, at = j))
          j = j + 1
        }
        let mut mi = 0
        while mi < n {
          if Array::get(ctx.remaining, at = mi) < Array::get(pc_scratch, at = minrem + mi) {
            Array::set(pc_scratch, at = minrem + mi, value = Array::get(ctx.remaining, at = mi))
          } else {
            ()
          }
          mi = mi + 1
        }
        pe_cons_arm(ctx = ctx, mark = consmark)
        a = a + 1
      }
      pe_cons_end(ctx = ctx, mark = consmark)
      pc_snap_restore(dst = ctx.remaining, at = minrem, n = n)
      Array::truncate(pc_scratch, length = snap)
      0
    },
    _ => 0
  }
}

/// #3135: an operand of a binary or unary operator. Codegen reads an
/// operand and never releases it: a `Double` is unboxed into an f64 op (see
/// `emit_float_operand_bits`), and `==` / `!=` on anything else compares in
/// place (`emit_eq_value`). Counting a bare name there as an owning use handed
/// the binding's reference to a consumer that drops nothing -- at the last use
/// the binding lost its scope-end drop, at an earlier one it took a dup nobody
/// released -- so every `Double` compared or computed with leaked its box. A
/// bare name is therefore a borrow here, like a borrowed call argument
/// (`pc_count_borrow` keeps the binding alive through it, and its scope-end
/// drop releases it). Any other operand is walked as before.
///
/// #3629: an operand the desugar marked as a float (`float_operand_unmarked`)
/// is read through the mark, which codegen compiles to its argument; counted
/// as a call argument, a marked name took a dup nobody released.
fn pc_operand_count(ctx: PCtx, scope: PScope, e_in: Expr) -> Int {
  let e = float_operand_unmarked(e_in)
  match e {
    EIdent(x, _) => pc_count_borrow(ctx = ctx, scope = scope, name = x),
    _ => pc_count(ctx = ctx, scope = scope, expr = e)
  }
}

/// The emission twin of `pc_operand_count`: a bare-name operand is a borrow,
/// so it plans no dup and spends no reference.
fn pc_operand_emit(ctx: PCtx, scope: PScope, e_in: Expr) -> Int {
  let e = float_operand_unmarked(e_in)
  match e {
    EIdent(_, _) => 0,
    _ => pc_emit(ctx = ctx, scope = scope, expr = e)
  }
}

// Codegen retains an owning argument read from before a loop on every
// iteration (#706). The plan must count that occurrence as a borrow: a PaDup
// at the binding site would be left over after those per-iteration retains
// and the callee's drops cancel out.
fn pc_loop_call_arg_borrow(ctx: PCtx, scope: PScope, e: Expr) -> Bool {
  match e {
    EIdent(name, _) => ctx.loop_floor > 0 && ps_has(s = scope, name = name) && ps_get(s = scope, name = name) < ctx.loop_floor && ps_get(s = scope, name = name) != ctx.move_use_id,
    _ => false
  }
}

export fn pc_count(ctx: PCtx, scope: PScope, expr: Expr) -> Int {
  match expr {
    EInt(_) => 0,
    EFloat(_) => 0,
    EString(_, _) => 0,
    EBool(_) => 0,
    EUnit => 0,
    EStringInterp(_) => 0,
    EIdent(x, _) => pc_count_use(ctx = ctx, scope = scope, name = x),
    ECall(callee, args, _, _) => {
      match callee {
        // Always borrow-count an ident callee: for a true top-level fn the
        // name is not in scope and this is a no-op, while for a LOCAL that
        // shadows a borrow-set name skipping it undercounted the local's
        // borrows (ADR-0092 per-use pairing, shadow hole).
        EIdent(f, _) => pc_count_borrow(ctx = ctx, scope = scope, name = f),
        _ => pc_count(ctx = ctx, scope = scope, expr = callee)
      }
      // Lexical scoping wins over the borrow sets: see pe_borrow_mask.
      let bmask = pe_borrow_mask(ctx = ctx, scope = scope, callee = callee)
      let mut i = 0
      while i < Array::length(args) {
        let arg = Array::get(args, at = i)
        if pe_bmask_has(mask = bmask, i = i) || pc_loop_call_arg_borrow(ctx = ctx, scope = scope, e = arg) {
          match arg {
            EIdent(obj, _) => pc_count_borrow(ctx = ctx, scope = scope, name = obj),
            _ => pc_count(ctx = ctx, scope = scope, expr = arg)
          }
        } else {
          pc_count(ctx = ctx, scope = scope, expr = arg)
        }
        i = i + 1
      }
      0
    },
    EDot(obj, _field, _, _) => match obj {
      EIdent(x, _) => pc_count_borrow(ctx = ctx, scope = scope, name = x),
      _ => pc_count(ctx = ctx, scope = scope, expr = obj)
    }
    ,
    ELet(name, value, body, _) => {
      pc_count(ctx = ctx, scope = scope, expr = value)
      // #3114: `let w = v` where `v` is a borrowed view (`Array::get` and
      // the other borrow-returning callees, which is_scalar_expr classifies
      // scalar) hands `w` nothing to own either. Planning `w` as an owned
      // binding gave it a scope-end drop (or a last-use transfer into a
      // consuming call / a return) for a reference it never took, releasing
      // the element the container still owns. The alias inherits the view's
      // classification; codegen marks it borrow-bound alongside (see the
      // `let` lowering in compile_expr_tail), so an owning use still retains
      // it the way it retains `v`.
      //
      // Only a VIEW is inherited, not `scalar` at large: a `Double` literal
      // is `scalar` here yet boxed by codegen, so an alias of one that
      // inherited the flag lost the scope-end drop that released the box
      // (16 B per round, fixtures/rc_float_alias_release_test.vibe).
      //
      // #3114 review: a WRAPPER value -- a block, a binder chain -- hands
      // back whatever its result spine ends in, and codegen classifies it
      // that way (value_spine_borrowed: a view there declines the scope-end
      // drop and marks the binding borrow-bound). Reading only the top node
      // here called `{ let i = 0; Array::get(xs, i) }` owned, so its alias
      // took a reference by transfer that codegen never gave the source.
      let borrowed_view = pe_let_value_is_view(ctx = ctx, scope = scope, value = value)
      let id = pc_declare(ctx = ctx, _name = name, scalar = borrowed_view || is_scalar_expr(ctx = ctx, scope = scope, e = value))
      if borrowed_view {
        Array::set(ctx.borrowed_view, at = id, value = true)
      } else {
        ()
      }
      if is_branching_value(value) {
        Array::set(ctx.branch_value, at = id, value = true)
      } else {
        ()
      }
      let _ = pctx_mark_view_call(ctx = ctx, scope = scope, id = id, value = value)
      pc_count(ctx = ctx, scope = PsBind(name, id, scope), expr = body)
    },
    ELetMut(name, value, body, _) => {
      pc_count(ctx = ctx, scope = scope, expr = value)
      // A mutable call binding acquires its own reference even when the
      // initializer borrows. Assignments replace that value, so neither the
      // scalar exemption nor the view-only lifetime can describe the slot.
      // compile_expr_tail retains the borrowed initializer to match this
      // ordinary owning plan, including its assignment dup/drop budget.
      // #2750 review: the initializer may WRAP the call -- `let mut x = { let
      // k = 0; Array::get(xs, k) }` produces the same borrowed value through
      // a block. Reading the top node only left the slot view-classified and
      // out of `heap_binding_names`, so a later assignment of a fresh
      // allocation saw `is_heap_mut == false` and nothing dropped it (80 B
      // per iteration, measured). Straight-line only, and a callee the spine
      // itself bound is a local with no contract -- both matching the retain
      // in compile_expr_tail's ELetMut arm, which must fire on exactly the
      // same values as this plan or the two sides desync.
      let borrowed_call = pe_let_mut_borrowed_call(ctx = ctx, value = value)
      // #3168: a loop-result slot's `0` is a placeholder; the slot holds what
      // its `break v` stores.
      let scalar = if perceus_loop_result_slot(name = name, value = value, body = body) {
        !pe_loop_result_stores_heap(e = body, name = name)
      } else {
        !borrowed_call && is_scalar_expr(ctx = ctx, scope = scope, e = value)
      }
      let id = pc_declare(ctx = ctx, _name = name, scalar = scalar)
      if !borrowed_call {
        let _ = pctx_mark_view_call(ctx = ctx, scope = scope, id = id, value = value)
        ()
      } else {
        ()
      }
      pc_count(ctx = ctx, scope = PsBind(name, id, scope), expr = body)
    },
    ELetRec(name, value, body) => {
      let id = pc_declare(ctx = ctx, _name = name, scalar = false)
      let s2 = PsBind(name, id, scope)
      pc_count(ctx = ctx, scope = s2, expr = value)
      pc_count(ctx = ctx, scope = s2, expr = body)
    },
    EAssign(name, value, body, _) => {
      let move_id = if ps_has(s = scope, name = name) && pe_self_reassign_moves(ctx = ctx, scope = scope, name = name, value = value) {
        ps_get(s = scope, name = name)
      } else {
        0 - 1
      }
      ctx.move_use_id = move_id
      pc_count(ctx = ctx, scope = scope, expr = value)
      ctx.move_use_id = 0 - 1
      pc_count(ctx = ctx, scope = scope, expr = body)
    },
    EAssignOp(_name, _op, value, body, _) => {
      pc_count(ctx = ctx, scope = scope, expr = value)
      pc_count(ctx = ctx, scope = scope, expr = body)
    },
    ESeq(a, b) => {
      pc_count(ctx = ctx, scope = scope, expr = pe_discarded_head(a))
      let nm = next_seq_name(ctx)
      let sq_id = pc_declare(ctx = ctx, _name = nm, scalar = is_scalar_expr(ctx = ctx, scope = scope, e = a))
      // ADR-0092 per-use pairing: a DISCARDED view-call result gets a seq-temp
      // drop it never owned -- same class as a view-call let-binding.
      let _ = pctx_mark_view_call(ctx = ctx, scope = scope, id = sq_id, value = a)
      pc_count(ctx = ctx, scope = scope, expr = b)
    },
    EBinOp(_op, l, r, _) => {
      pc_operand_count(ctx = ctx, scope = scope, e_in = l)
      pc_operand_count(ctx = ctx, scope = scope, e_in = r)
    },
    EUnaryOp(_op, e) => pc_operand_count(ctx = ctx, scope = scope, e_in = e),
    ETuple(items) => {
      let mut i = 0
      while i < Array::length(items) {
        pc_count(ctx = ctx, scope = scope, expr = Array::get(items, at = i))
        i = i + 1
      }
      0
    },
    EArray(items) => {
      let mut i = 0
      while i < Array::length(items) {
        pc_count(ctx = ctx, scope = scope, expr = Array::get(items, at = i))
        i = i + 1
      }
      0
    },
    ERecord(_, fields, _) => {
      let mut i = 0
      while i < Array::length(fields) {
        pc_count(ctx = ctx, scope = scope, expr = (Array::get(fields, at = i)).1)
        i = i + 1
      }
      0
    },
    EMap(fields) => {
      let mut i = 0
      while i < Array::length(fields) {
        pc_count(ctx = ctx, scope = scope, expr = (Array::get(fields, at = i)).1)
        i = i + 1
      }
      0
    },
    EIf(cond, then_e, else_e) => {
      pc_count(ctx = ctx, scope = scope, expr = cond)
      let n = Array::length(ctx.uses)
      let snap_u = pc_snap(ctx.uses)
      let snap_b = pc_snap(ctx.borrows)
      pc_count(ctx = ctx, scope = scope, expr = then_e)
      // #1100 alloc cut: swap the prefixes instead of taking SECOND copies
      // (`then_u`/`then_b`) — one pass restores uses/borrows to the
      // pre-branch values and captures the then-branch's values into the
      // snap buffers. 2 allocations per `if` instead of 4.
      let mut sw = 0
      while sw < n {
        let tu = Array::get(ctx.uses, at = sw)
        Array::set(ctx.uses, at = sw, value = Array::get(pc_scratch, at = snap_u + sw))
        Array::set(pc_scratch, at = snap_u + sw, value = tu)
        let tb = Array::get(ctx.borrows, at = sw)
        Array::set(ctx.borrows, at = sw, value = Array::get(pc_scratch, at = snap_b + sw))
        Array::set(pc_scratch, at = snap_b + sw, value = tb)
        sw = sw + 1
      }
      pc_count(ctx = ctx, scope = scope, expr = else_e)
      // Merge = per-id MAX over the two branches. The previous delta form
      // (`base + max(then - base, else - base)`) is algebraically the same
      // number — the base cancels — so dropping it changes no plan. After
      // the swap above, snap_u/snap_b hold the THEN branch's values and
      // ctx.uses/ctx.borrows hold the ELSE branch's.
      let mut id = 0
      while id < n {
        Array::set(ctx.uses, at = id, value = int_max(a = Array::get(pc_scratch, at = snap_u + id), b = Array::get(ctx.uses, at = id)))
        Array::set(ctx.borrows, at = id, value = int_max(a = Array::get(pc_scratch, at = snap_b + id), b = Array::get(ctx.borrows, at = id)))
        id = id + 1
      }
      Array::truncate(pc_scratch, length = snap_u)
      0
    },
    EWhile(cond, body) => {
      let saved_floor = ctx.loop_floor
      ctx.loop_floor = ctx.next_id
      pc_count(ctx = ctx, scope = scope, expr = cond)
      pc_count(ctx = ctx, scope = scope, expr = pe_discarded_spine(body))
      ctx.loop_floor = saved_floor
      0
    },
    EReturn(e) => pc_count(ctx = ctx, scope = scope, expr = e),
    ESpread(e) => pc_count(ctx = ctx, scope = scope, expr = e),
    ELabeledArg(_l, _n, e) => pc_count(ctx = ctx, scope = scope, expr = e),
    EBreak(opt) => match opt {
      Some(e) => pc_count(ctx = ctx, scope = scope, expr = e),
      None => 0
    }
    ,
    EFn(_tp, _tb, params, _ret, _eff, fbody) => {
      let caps = collect_free_vars(body = fbody, param_names = fn_param_names(params), fn_names = [
      ])
      let mut i = 0
      while i < Array::length(caps) {
        pc_count_borrow(ctx = ctx, scope = scope, name = Array::get(caps, at = i))
        i = i + 1
      }
      0
    },
    EForIn(value_name, index_opt, iterable, fbody) => {
      pc_operand_count(ctx = ctx, scope = scope, e_in = iterable)
      let saved_floor = ctx.loop_floor
      ctx.loop_floor = ctx.next_id
      let idv = pc_declare(ctx = ctx, _name = value_name, scalar = false)
      let s2 = PsBind(value_name, idv, scope)
      let s3 = match index_opt {
        Some(idx) => {
          let idi = pc_declare(ctx = ctx, _name = idx, scalar = true)
          PsBind(idx, idi, s2)
        },
        None => s2
      }
      pc_count(ctx = ctx, scope = s3, expr = fbody)
      ctx.loop_floor = saved_floor
      0
    },
    ELoop(params, lbody) => {
      let saved_floor = ctx.loop_floor
      ctx.loop_floor = ctx.next_id
      let mut s = scope
      let mut i = 0
      while i < Array::length(params) {
        let p = Array::get(params, at = i)
        pc_count(ctx = ctx, scope = scope, expr = p.1)
        let pid = pc_declare(ctx = ctx, _name = p.0, scalar = is_scalar_expr(ctx = ctx, scope = scope, e = p.1))
        s = PsBind(p.0, pid, s)
        i = i + 1
      }
      pc_count(ctx = ctx, scope = s, expr = lbody)
      ctx.loop_floor = saved_floor
      0
    },
    EMatch(scrut, arms) => {
      match scrut {
        EIdent(sx, _) => pc_count_borrow(ctx = ctx, scope = scope, name = sx),
        _ => pc_count(ctx = ctx, scope = scope, expr = scrut)
      }
      // A single arm has no alternative counts to merge. Avoid the four
      // branch snapshot arrays while preserving the general empty/multi-arm
      // merge path below.
      if Array::length(arms) == 1 {
        let arm = Array::get(arms, at = 0)
        let pnames: Array[String] = []
        pat_names(pat = arm.0, out = pnames)
        let mut s = scope
        let mut k = 0
        while k < Array::length(pnames) {
          let nm = Array::get(pnames, at = k)
          let pid = pc_declare(ctx = ctx, _name = nm, scalar = false)
          s = PsBind(nm, pid, s)
          k = k + 1
        }
        pc_count(ctx = ctx, scope = s, expr = arm.1)
        0
      } else {
        let n = Array::length(ctx.uses)
        let snap_u = pc_snap(ctx.uses)
        let snap_b = pc_snap(ctx.borrows)
        let max_u = pc_snap_zeros(n)
        let max_b = pc_snap_zeros(n)
        let mut a = 0
        while a < Array::length(arms) {
          let arm = Array::get(arms, at = a)
          pc_snap_restore(dst = ctx.uses, at = snap_u, n = n)
          pc_snap_restore(dst = ctx.borrows, at = snap_b, n = n)
          let pnames: Array[String] = []
          pat_names(pat = arm.0, out = pnames)
          let mut s = scope
          let mut k = 0
          while k < Array::length(pnames) {
            let nm = Array::get(pnames, at = k)
            let pid = pc_declare(ctx = ctx, _name = nm, scalar = false)
            s = PsBind(nm, pid, s)
            k = k + 1
          }
          pc_count(ctx = ctx, scope = s, expr = arm.1)
          let mut id = 0
          while id < n {
            let du = Array::get(ctx.uses, at = id) - Array::get(pc_scratch, at = snap_u + id)
            if du > Array::get(pc_scratch, at = max_u + id) {
              Array::set(pc_scratch, at = max_u + id, value = du)
            }
            let db = Array::get(ctx.borrows, at = id) - Array::get(pc_scratch, at = snap_b + id)
            if db > Array::get(pc_scratch, at = max_b + id) {
              Array::set(pc_scratch, at = max_b + id, value = db)
            }
            id = id + 1
          }
          a = a + 1
        }
        pc_snap_restore(dst = ctx.uses, at = snap_u, n = n)
        pc_snap_restore(dst = ctx.borrows, at = snap_b, n = n)
        let mut id2 = 0
        while id2 < n {
          Array::set(ctx.uses, at = id2, value = Array::get(pc_scratch, at = snap_u + id2) + Array::get(pc_scratch, at = max_u + id2))
          Array::set(ctx.borrows, at = id2, value = Array::get(pc_scratch, at = snap_b + id2) + Array::get(pc_scratch, at = max_b + id2))
          id2 = id2 + 1
        }
        Array::truncate(pc_scratch, length = snap_u)
        0
      }
    },
    EHandle(hbody, arms) => {
      let n = Array::length(ctx.uses)
      let snap_u = pc_snap(ctx.uses)
      let snap_b = pc_snap(ctx.borrows)
      let max_u = pc_snap_zeros(n)
      let max_b = pc_snap_zeros(n)
      pc_count(ctx = ctx, scope = scope, expr = hbody)
      let mut id0 = 0
      while id0 < n {
        let du = Array::get(ctx.uses, at = id0) - Array::get(pc_scratch, at = snap_u + id0)
        if du > Array::get(pc_scratch, at = max_u + id0) {
          Array::set(pc_scratch, at = max_u + id0, value = du)
        }
        let db = Array::get(ctx.borrows, at = id0) - Array::get(pc_scratch, at = snap_b + id0)
        if db > Array::get(pc_scratch, at = max_b + id0) {
          Array::set(pc_scratch, at = max_b + id0, value = db)
        }
        id0 = id0 + 1
      }
      let mut a = 0
      while a < Array::length(arms) {
        let arm = Array::get(arms, at = a)
        pc_snap_restore(dst = ctx.uses, at = snap_u, n = n)
        pc_snap_restore(dst = ctx.borrows, at = snap_b, n = n)
        let pnames: Array[String] = []
        pat_names(pat = arm.0, out = pnames)
        let mut s = scope
        let mut k = 0
        while k < Array::length(pnames) {
          let nm = Array::get(pnames, at = k)
          let pid = pc_declare(ctx = ctx, _name = nm, scalar = false)
          s = PsBind(nm, pid, s)
          k = k + 1
        }
        pc_count(ctx = ctx, scope = s, expr = arm.1)
        let mut id = 0
        while id < n {
          let du = Array::get(ctx.uses, at = id) - Array::get(pc_scratch, at = snap_u + id)
          if du > Array::get(pc_scratch, at = max_u + id) {
            Array::set(pc_scratch, at = max_u + id, value = du)
          }
          let db = Array::get(ctx.borrows, at = id) - Array::get(pc_scratch, at = snap_b + id)
          if db > Array::get(pc_scratch, at = max_b + id) {
            Array::set(pc_scratch, at = max_b + id, value = db)
          }
          id = id + 1
        }
        a = a + 1
      }
      pc_snap_restore(dst = ctx.uses, at = snap_u, n = n)
      pc_snap_restore(dst = ctx.borrows, at = snap_b, n = n)
      let mut id2 = 0
      while id2 < n {
        Array::set(ctx.uses, at = id2, value = Array::get(pc_scratch, at = snap_u + id2) + Array::get(pc_scratch, at = max_u + id2))
        Array::set(ctx.borrows, at = id2, value = Array::get(pc_scratch, at = snap_b + id2) + Array::get(pc_scratch, at = max_b + id2))
        id2 = id2 + 1
      }
      Array::truncate(pc_scratch, length = snap_u)
      0
    },
    _ => 0
  }
}
