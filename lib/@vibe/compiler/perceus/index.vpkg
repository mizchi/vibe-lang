name = @vibe/compiler/perceus
version = 0.0.1
description =
  #|@vibe/compiler/perceus — the RC backend's Perceus dup/drop planner
deps = {
  @vibe/compiler/codegen/common_analysis : 0.0.1
  @vibe/compiler/core : 0.0.1
  @vibe/core : 0.2.0
}

generated_hash =

// @vibe/compiler/perceus — the RC backend's Perceus dup/drop planner
// (count + emit passes over a function body), the program-wide
// borrow-return / scalar-return / heap-return name scans, and the
// heap-param elaboration rewrite (ADR-0055/#702..#715 lineage). First
// COMPILER-INTERNAL contract batch (ADR-0070 Phase 3, #897) — compiled
// into the compiler itself via compiler_sources_manifest.tsv (group
// `codegen`, dual-row: this contract + perceus.vibe).
//
// The old index.vibe was not a facade but the whole implementation (the
// package is single-file), so it moved verbatim to perceus.vibe.
//
// `PerceusAction` is declared TRANSPARENT (defined verbatim here, deleted
// from the impl): tests/perceus_rc_test.vibe reads `.kind`/`.name`
// directly, so the field layout is real public API surface (@vibe/process
// ShResult precedent, PR #920). `PerceusActionKind` stays `opaque` with
// its `export enum` kept in perceus.vibe: the impl file itself constructs
// and pattern-matches PaDup/PaDrop/PaAliasDup, and enum VARIANTS do not
// resolve across units from a facade-only definition (@vibe/json
// precedent — "unknown name: JNull"). Consumers keep full variant
// visibility through the same #716 re-export machinery as before.
//
// `PCtx` (the planner's mutable count/emit state) is intentionally NOT
// declared: it was never exported by the old index.vibe either. The two
// walks that take it, pc_count / pc_emit, are package-private (nothing
// outside perceus.vibe called them).
// No `version` binding existed (compiler-internal package).

opaque type PerceusActionKind

struct PerceusAction {
  kind: PerceusActionKind;
  name: String;
  binding_id: Int;
  use_offset: Int;
  // ADR-0092 / #2389: the pattern/constructor arity for the reuse-pairing
  // kinds (PaReuseToken/PaReuseAlloc); 0 for every other kind.
  extra: Int
}

// --- plan-action predicates
fn pa_is_dup(a: PerceusAction) -> Bool
fn pa_is_drop(a: PerceusAction) -> Bool
fn pa_is_alias_dup(a: PerceusAction) -> Bool
fn pa_is_path_drop(a: PerceusAction) -> Bool
fn pa_is_consume_mark(a: PerceusAction) -> Bool
fn pa_is_reuse_token(a: PerceusAction) -> Bool
fn pa_is_reuse_alloc(a: PerceusAction) -> Bool
fn pa_is_trunc_release(a: PerceusAction) -> Bool
fn pa_is_view_pin(a: PerceusAction) -> Bool
fn pa_is_field_release(a: PerceusAction) -> Bool
fn pa_is_exit_site(a: PerceusAction) -> Bool
fn pa_is_exit_drop(a: PerceusAction) -> Bool
fn pa_is_store_dup(a: PerceusAction) -> Bool

// #3141: the early-exit rows in the form codegen reads (see
// `perceus_exit_rows`), and the operand fingerprint both sides compute.
fn perceus_exit_rows(plan: Array[PerceusAction], names: Array[String], info: Array[Int]) -> Unit
fn perceus_exit_fingerprint(e: Expr) -> Int

// #3168: the result slot of a parameterized `loop`, which both sides classify
// from the values its `break`s store rather than from its `0` placeholder.
fn perceus_loop_result_slot(name: String, value: Expr, body: Expr) -> Bool

// #2837: the truncate-release rows split into what codegen consults, and the
// function-result test a row's `extra` asks for.
fn perceus_truncate_rows(plan: Array[PerceusAction], accept_root: Bool, release: Array[String], pin_arrays: Array[String], pin_names: Array[String]) -> Unit
fn fn_result_is_immediate(sig: Option[TypeExpr], value: Expr) -> Bool

// #3140: the structs whose field assignments may release the value they
// overwrite.
fn perceus_field_release_rows(plan: Array[PerceusAction], out: Array[String]) -> Unit

// #3184: the stores that retain what they store -- an assignment or a
// `let mut` initializer of an owned binding from outside the enclosing loop,
// or (#3190) a branch or block tail of one or of a `let` initializer -- as
// (source name, source offset) pairs.
fn perceus_store_dup_rows(plan: Array[PerceusAction], names: Array[String], offs: Array[Int]) -> Unit

// ADR-0092 / #2389: the reuse-pairing blocker predicate, shared with the RC
// codegen so the arm it fuses is re-proven free of control transfers (the
// plan row's (name, arity) key cannot distinguish sibling arms).
fn reuse_arm_has_blocker(e: Expr) -> Bool

// ADR-0092 / #2389: one payload bind's admission mode for the reuse fusion
// (1 raw transfer, 0 borrow-only, -1 held: consumed with further reads or
// more than once, kept alive for the whole arm by the wide tier). Shared
// with both codegen tiers.
fn reuse_bind_mode(arm_body: Expr, bn: String, borrow_param_fns: Array[String], bmasks: Array[Int]) -> Int

// ADR-0092 / #2389: does the arm contain (outside lambda interiors) a call
// of a constructor-like name with exactly `arity` arguments -- the site the
// wide tier's armed token can feed.
fn reuse_arm_has_ctor_site(e: Expr, arity: Int) -> Bool

// --- program-wide name scans (threaded into every function's plan)
fn compute_borrow_returning_names(stmts: Array[Stmt]) -> Array[String]
fn compute_passthrough_returning(stmts: Array[Stmt]) -> Array[(String, Int)]
fn borrow_ret_shadow_mask(stmts: Array[Stmt]) -> Int
fn borrow_ret_link_parts(parts: Array[Array[Stmt]], shadow_mask: Int) -> Array[String]
fn compute_scalar_returning_names(stmts: Array[Stmt]) -> Array[String]
fn compute_heap_returning(stmts: Array[Stmt]) -> Array[String]

// --- heap-ness classification
fn type_expr_is_heap(ot: Option[TypeExpr]) -> Bool
fn param_is_heap_in_body(name: String, otype: Option[TypeExpr], body: Expr) -> Bool

// --- planner passes and entry points
fn build_perceus_plan(body: Expr) -> Array[PerceusAction]
fn build_perceus_plan_with_params(params: Array[(String, Option[TypeExpr])], body: Expr, borrow_ret_names: Array[String], borrow_param_fns: Array[String], borrow_param_masks: Array[Int], view_ret_fns: Array[String]) -> Array[PerceusAction]
fn build_perceus_plan_with_params_split(params: Array[(String, Option[TypeExpr])], body: Expr, borrow_ret_names: Array[String], borrow_param_fns: Array[String], borrow_param_masks: Array[Int], view_ret_fns: Array[String], out_param_drop_start: Array[Int]) -> Array[PerceusAction]
fn perceus_pin_tables(borrow_ret_names: Array[String], borrow_param_fns: Array[String], borrow_param_masks: Array[Int], view_ret_fns: Array[String]) -> Int
fn build_perceus_plan_pinned(token: Int, params: Array[(String, Option[TypeExpr])], body: Expr, borrow_ret_names: Array[String], borrow_param_fns: Array[String], borrow_param_masks: Array[Int], view_ret_fns: Array[String]) -> Array[PerceusAction]
fn build_perceus_plan_pinned_split(token: Int, params: Array[(String, Option[TypeExpr])], body: Expr, borrow_ret_names: Array[String], borrow_param_fns: Array[String], borrow_param_masks: Array[Int], view_ret_fns: Array[String], out_param_drop_start: Array[Int]) -> Array[PerceusAction]

// --- heap-param elaboration (run at the head of the RC pipeline)
fn elaborate_heap_params(stmts: Array[Stmt]) -> Array[Stmt]

