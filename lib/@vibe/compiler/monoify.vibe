//# Imports

import @vibe/compiler/core {
  Expr, Pat, Stmt, TypeExpr
}

import @vibe/core {
  array_empty
}

//# Functions

export fn mono_name(base: String, suffix: String) -> String {
  String::concat(String::concat(base, "$"), suffix)
}

fn empty_exprs() -> Array[Expr] {
  array_empty()
}

export fn is_generic_fn(expr: Expr) -> Bool {
  match expr {
    EFn(type_params, _bounds, _params, _ret_ty, _effect, _body) =>
    if Array::length(type_params) == 0 {
      false
    }
    else {
      true
    },
    _ => false
  }
}

fn empty_expr_arrays() -> Array[Array[Expr]] {
  array_empty()
}

fn empty_string_int_pairs() -> Array[(String, Int)] {
  array_empty()
}

export fn collect_generic_fns(stmts: Array[Stmt]) -> Array[(String, Int)] {
  let result = empty_string_int_pairs()
  let mut i = 0
  while i < Array::length(stmts) {
    let stmt = Array::get(stmts, i)
    match stmt {
      SLet(_exported, _is_rec, name, _ty, body) =>
      match body {
        EFn(type_params, _bounds, _params, _ret, _eff, _fn_body) =>
        if Array::length(type_params) > 0 {
          Array::push(result, (name, Array::length(type_params)))
          result
        }
        else {
          result
        },
        _ => result
      },
      _ => result
    }
    i = i + 1
  }
  result
}

/// Out-param recursive walker: pushes each discovered call site (an
/// `Array[Expr]` of args) directly into `out`. Replaces the previous
/// `result = Array::concat(result, sub)` accumulator pattern, which
/// was O(N^2) per recursion level — for an AST with N nodes the
/// accumulator copied the entire prefix at every push, yielding
/// quadratic total work. Out-param push is O(1) per element, so the
/// whole walk is O(total call sites).
fn collect_call_sites_into(expr: Expr, fn_name: String, out: Array[Array[Expr]]) -> Unit {
  match expr {
    ECall(callee, args, _) => {
      match callee {
        EIdent(name, _) =>
        if name == fn_name {
          Array::push(out, args)
        },
        _ => ()
      }
      collect_call_sites_into(callee, fn_name, out)
      let mut ai = 0
      while ai < Array::length(args) {
        collect_call_sites_into(Array::get(args, ai), fn_name, out)
        ai = ai + 1
      }
    },
    EInt(_) => (),
    EFloat(_) => (),
    EString(_) => (),
    EBool(_) => (),
    EIdent(_, _) => (),
    EUnit => (),
    EBreak(_) => (),
    EContinue(_) => (),
    ETuple(elems) => {
      let mut ti = 0
      while ti < Array::length(elems) {
        collect_call_sites_into(Array::get(elems, ti), fn_name, out)
        ti = ti + 1
      }
    },
    EArray(elems) => {
      let mut ari = 0
      while ari < Array::length(elems) {
        collect_call_sites_into(Array::get(elems, ari), fn_name, out)
        ari = ari + 1
      }
    },
    ERecord(_, fields, _) => {
      let mut i = 0
      while i < Array::length(fields) {
        let (_key, val) = Array::get(fields, i)
        collect_call_sites_into(val, fn_name, out)
        i = i + 1
      }
    },
    EIf(cond, then_br, else_br) => {
      collect_call_sites_into(cond, fn_name, out)
      collect_call_sites_into(then_br, fn_name, out)
      collect_call_sites_into(else_br, fn_name, out)
    },
    ELet(_name, val, body, _) => {
      collect_call_sites_into(val, fn_name, out)
      collect_call_sites_into(body, fn_name, out)
    },
    ELetRec(_name, val, body) => {
      collect_call_sites_into(val, fn_name, out)
      collect_call_sites_into(body, fn_name, out)
    },
    ELetMut(_name, val, body, _) => {
      collect_call_sites_into(val, fn_name, out)
      collect_call_sites_into(body, fn_name, out)
    },
    EAssign(_name, val, body) => {
      collect_call_sites_into(val, fn_name, out)
      collect_call_sites_into(body, fn_name, out)
    },
    EAssignOp(_name, _op, val, body) => {
      collect_call_sites_into(val, fn_name, out)
      collect_call_sites_into(body, fn_name, out)
    },
    ESeq(a, b) => {
      collect_call_sites_into(a, fn_name, out)
      collect_call_sites_into(b, fn_name, out)
    },
    EMatch(scrutinee, arms) => {
      collect_call_sites_into(scrutinee, fn_name, out)
      let mut i = 0
      while i < Array::length(arms) {
        let (_arm_pat, arm_body) = Array::get(arms, i)
        collect_call_sites_into(arm_body, fn_name, out)
        i = i + 1
      }
    },
    EHandle(body, arms) => {
      collect_call_sites_into(body, fn_name, out)
      let mut i = 0
      while i < Array::length(arms) {
        let (_arm_pat, arm_body) = Array::get(arms, i)
        collect_call_sites_into(arm_body, fn_name, out)
        i = i + 1
      }
    },
    EWhile(cond, body) => {
      collect_call_sites_into(cond, fn_name, out)
      collect_call_sites_into(body, fn_name, out)
    },
    ELoop(params, body) => {
      let mut i = 0
      while i < Array::length(params) {
        let (_, init) = Array::get(params, i)
        collect_call_sites_into(init, fn_name, out)
        i = i + 1
      }
      collect_call_sites_into(body, fn_name, out)
    },
    EForIn(_name, _index_name, iter, body) => {
      collect_call_sites_into(iter, fn_name, out)
      collect_call_sites_into(body, fn_name, out)
    },
    EBinOp(_op, lhs, rhs) => {
      collect_call_sites_into(lhs, fn_name, out)
      collect_call_sites_into(rhs, fn_name, out)
    },
    EUnaryOp(_op, operand) => collect_call_sites_into(operand, fn_name, out),
    EFn(_tp, _bounds, _params, _ret, _eff, body) =>
    collect_call_sites_into(body, fn_name, out),
    EDot(e, _field, _, _) => collect_call_sites_into(e, fn_name, out),
    ELabeledArg(_label, _name, e) => collect_call_sites_into(e, fn_name, out),
    EReturn(e) => collect_call_sites_into(e, fn_name, out),
    EMap(fields) => {
      let mut i = 0
      while i < Array::length(fields) {
        let (_key, val) = Array::get(fields, i)
        collect_call_sites_into(val, fn_name, out)
        i = i + 1
      }
    },
    ESpread(e) => collect_call_sites_into(e, fn_name, out),
    EStringInterp(_) => ()
  }
}

fn collect_call_sites_expr(expr: Expr, fn_name: String) -> Array[Array[Expr]] {
  let out = empty_expr_arrays()
  collect_call_sites_into(expr, fn_name, out)
  out
}

export fn collect_call_sites(expr: Expr, fn_name: String) -> Array[Array[Expr]] {
  collect_call_sites_expr(expr, fn_name)
}

export fn collect_call_sites_stmts(stmts: Array[Stmt], fn_name: String) -> Array[Array[Expr]] {
  let out = empty_expr_arrays()
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SLet(_exported, _is_rec, _name, _ty, body) =>
      collect_call_sites_into(body, fn_name, out),
      SLetMut(_name, _ty, body) =>
      collect_call_sites_into(body, fn_name, out),
      STest(_name, body) =>
      collect_call_sites_into(body, fn_name, out),
      SExpr(body) =>
      collect_call_sites_into(body, fn_name, out),
      _ => ()
    }
    i = i + 1
  }
  out
}

export fn count_instantiations(stmts: Array[Stmt], fn_name: String) -> Int {
  let sites = collect_call_sites_stmts(stmts, fn_name)
  Array::length(sites)
}
