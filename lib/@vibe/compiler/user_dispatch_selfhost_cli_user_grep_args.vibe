/// Every positional argument of `vibe check` is a file to check; the flags
/// that take a value are skipped with it. `parse_user_check_args` validates
/// the flags and names the first file, this names them all.
fn user_check_paths(args: Array[String]) -> Array[String] {
  let paths: Array[String] = []
  let mut i = 1
  while i < Array::length(args) {
    let arg = Array::get(args, i)
    if arg == "--jobs" || arg == "--profile" || arg == "--profile-tsv" || arg == "--profile-callstack" {
      i = i + 2
    } else if String::length(arg) > 0 && String::byte_at(arg, 0) == 45 {
      i = i + 1
    } else {
      Array::push(paths, arg)
      i = i + 1
    }
  }
  paths
}

fn has_control_char(value: String) -> Bool {
  let mut found = false
  let mut i = 0
  while i < String::length(value) {
    let c = String::byte_at(value, i)
    if c < 32 || c == 127 {
      found = true
    } else {
      ()
    }
    i = i + 1
  }
  found
}

fn remove_stale_sidecar(path: String) -> Unit with Fs {
  if path != "" && Fs::exists(path) {
    Fs::remove(path)
  } else {
    ()
  }
}

fn write_warning_rows(rows: Array[String]) -> Unit with Stderr {
  if Array::length(rows) > 0 {
    Stderr::write_stream(line_terminated(String::join(rows, "\n")))
  } else {
    ()
  }
}

/// The import-resolving check, with the policy and observation the adapter's
/// former check-only branch carried (Codex review of #2858):
///
/// - typing-dependency-env reuse is the production default for this lane
///   (`VIBE_DISABLE_TYPING_DEPENDENCY_ENV_REUSE=1` opts out; an invalidation
///   trace forces it off so the trace stays observation-only);
/// - the opt-in sidecars -- `VIBE_INCREMENTAL_TELEMETRY_OUT`,
///   `VIBE_INCREMENTAL_INVALIDATION_TRACE_OUT` (+ nonce),
///   `VIBE_INGESTION_TELEMETRY_OUT` (+ nonce) and
///   `VIBE_INGESTION_PIPELINE_TELEMETRY_OUT` (+ nonce) -- are removed before
///   the check and published only after it succeeds, so a stale file never
///   reads as this check's result (`scripts/edit_cycle_kpi.mjs` reads them);
/// - the deprecated-use, redundant-import and builtin-shadowing warnings are
///   collected from the checked source groups and written to stderr, leaving
///   stdout and the exit code to the errors.
///
/// ADR-0068 applies as on every artifact path: the closure gate is asked after
/// the walk, so a program the build refuses for an unstable import is reported
/// by `vibe check` too rather than answered clean.
fn user_check_linked(src: String) -> Int with Exception + Fs + Env + Stderr {
  if !Fs::exists(src) {
    throw(String::concat("not found: ", src))
  } else {
    let disable_reuse = Env::get("VIBE_DISABLE_TYPING_DEPENDENCY_ENV_REUSE")
    let telemetry_out = Env::get("VIBE_INCREMENTAL_TELEMETRY_OUT")
    let trace_out = Env::get("VIBE_INCREMENTAL_INVALIDATION_TRACE_OUT")
    let trace_nonce = Env::get("VIBE_INCREMENTAL_INVALIDATION_TRACE_NONCE")
    let ingestion_out = Env::get("VIBE_INGESTION_TELEMETRY_OUT")
    let ingestion_nonce = Env::get("VIBE_INGESTION_TELEMETRY_NONCE")
    let pipeline_out = Env::get("VIBE_INGESTION_PIPELINE_TELEMETRY_OUT")
    let pipeline_nonce = Env::get("VIBE_INGESTION_PIPELINE_TELEMETRY_NONCE")
    if disable_reuse != "" && disable_reuse != "1" {
      throw("VIBE_DISABLE_TYPING_DEPENDENCY_ENV_REUSE must be exactly 1 when set")
    } else {
      ()
    }
    set_experimental_typing_dependency_env_reuse_enabled(disable_reuse != "1" && trace_out == "")
    remove_stale_sidecar(telemetry_out)
    remove_stale_sidecar(trace_out)
    remove_stale_sidecar(ingestion_out)
    remove_stale_sidecar(pipeline_out)
    if trace_out != "" && trace_nonce == "" {
      throw("VIBE_INCREMENTAL_INVALIDATION_TRACE_OUT requires VIBE_INCREMENTAL_INVALIDATION_TRACE_NONCE")
    } else if ingestion_out != "" && (ingestion_nonce == "" || has_control_char(ingestion_nonce)) {
      throw("VIBE_INGESTION_TELEMETRY_OUT requires a non-empty control-free VIBE_INGESTION_TELEMETRY_NONCE")
    } else if pipeline_out != "" && (pipeline_nonce == "" || has_control_char(pipeline_nonce)) {
      throw("VIBE_INGESTION_PIPELINE_TELEMETRY_OUT requires a non-empty control-free VIBE_INGESTION_PIPELINE_TELEMETRY_NONCE")
    } else {
      ()
    }
    set_incremental_typecheck_telemetry_enabled(telemetry_out != "" || trace_out != "")
    set_ingestion_fingerprint_telemetry_enabled(ingestion_out != "")
    set_ingestion_pipeline_telemetry_enabled(pipeline_out != "")
    set_incremental_interface_trace_enabled(trace_out != "")
    reject_unstable_entry_surface(src)
    unstable_closure_reset()
    let groups = check_linked_file_source_groups(src)
    let _ = Env::get("VIBE_PROFILE_MEMORY_MARK:check_groups_done")
    if telemetry_out != "" {
      Fs::write_file(telemetry_out, incremental_typecheck_telemetry_json())
    } else {
      ()
    }
    if trace_out != "" {
      Fs::write_file(trace_out, incremental_invalidation_trace_json(src, trace_nonce))
    } else {
      ()
    }
    if ingestion_out != "" {
      Fs::write_file(ingestion_out, ingestion_fingerprint_telemetry_json(ingestion_nonce))
    } else {
      ()
    }
    reject_unstable_closure_surface()
    let _ = Env::get("VIBE_PROFILE_MEMORY_MARK:check_unstable_done")
    write_warning_rows(check_deprecated_warnings_from_source_groups(src, groups))
    let _ = Env::get("VIBE_PROFILE_MEMORY_MARK:check_warn_deprecated")
    write_warning_rows(check_redundant_import_warnings_from_source_groups(src, groups))
    let _ = Env::get("VIBE_PROFILE_MEMORY_MARK:check_warn_redundant")
    write_warning_rows(check_let_star_warnings_from_source_groups(src, groups))
    let _ = Env::get("VIBE_PROFILE_MEMORY_MARK:check_warn_letstar")
    write_warning_rows(check_builtin_shadowing_warnings_from_source_groups(src, groups))
    let _ = Env::get("VIBE_PROFILE_MEMORY_MARK:check_warn_shadow")
    // Published strictly after the check has been answered: a failure above
    // leaves no pipeline sidecar looking like a successful observation.
    if pipeline_out != "" {
      Fs::write_file(pipeline_out, ingestion_pipeline_telemetry_json(pipeline_nonce))
    } else {
      ()
    }
    0
  }
}

/// `user_check_linked` answered as a JSON array of LSP Diagnostic objects
/// (#2831). The FS lane reports diagnostics by RAISING them, so the whole
/// check runs under a handler here and the raised text becomes the array's
/// one entry; a clean file yields `[]` and exit 0. `not found` stays an
/// exception -- a usage error is not a diagnostic about the file's contents.
fn user_check_linked_json(src: String) -> Int with Exception + Fs + Env + Console + Stderr {
  if !Fs::exists(src) {
    throw(String::concat("not found: ", src))
  } else {
    let text = Fs::read_file(src)
    let diags = handle {
      let _ = user_check_linked(src)
      let empty: Array[String] = []
      empty
    } with { Exception::Throw(message) => {
      // #2831 criterion 4: the raised text is now every diagnostic the check
      // collected, `\n`-joined and each one located and path-prefixed on its
      // own. One ARRAY ENTRY per line, or the JSON lane would emit a single
      // Diagnostic whose `message` carries embedded newlines -- which is not
      // a thing an LSP client can place.
      // Per DIAGNOSTIC, not per line: `is_check_report_continuation` above
      // decides which lines belong to the one before them.
      let lines = String::split(message, "\n")
      let out: Array[String] = []
      let mut li = 0
      while li < Array::length(lines) {
        let line = Array::get(lines, li)
        if String::length(line) == 0 {
          ()
        } else if is_check_report_continuation(line) && Array::length(out) > 0 {
          let last = Array::length(out) - 1
          Array::set(out, last, String::concat(Array::get(out, last), String::concat("\n", line)))
        } else {
          Array::push(out, line)
        }
        li = li + 1
      }
      out
    } }
    // Told WHICH file `text` is: this lane reports a DEPENDENCY's error as
    // `<dep>: line L:C: body`, located against the dep. Rendered without the
    // path, that column was converted against the entry's text and the origin
    // was dropped from the message (Codex P2 on #2868).
    print(line_terminated(lsp_diagnostics_json_of_messages_for(src, text, diags)))
    if Array::length(diags) == 0 {
      0
    } else {
      1
    }
  }
}

/// The two profiling sidecars `vibe check` can be asked for: `--profile-tsv P`
/// and `--profile-callstack P`. Parsed apart from `parse_user_check_args` so
/// that tuple keeps the shape `dispatch_test.vibe` pins; a flag without a
/// value is refused there, so this scan only reads what it validated.
fn user_check_profile_paths(args: Array[String]) -> (String, String) {
  let mut tsv = ""
  let mut callstack = ""
  let mut i = 1
  while i < Array::length(args) {
    let arg = Array::get(args, i)
    if (arg == "--profile-tsv" || arg == "--profile-callstack") && i + 1 < Array::length(args) {
      if arg == "--profile-tsv" {
        tsv = Array::get(args, i + 1)
      } else {
        callstack = Array::get(args, i + 1)
      }
      i = i + 2
    } else {
      i = i + 1
    }
  }
  (tsv, callstack)
}

fn profile_stage_row(stage: String, elapsed_us: Int) -> String {
  let us = if elapsed_us < 0 {
    0
  } else {
    elapsed_us
  }
  String::concat(stage, String::concat("\t", String::concat(__to_string(us / 1000), String::concat("\t", String::concat(__to_string(us), "\n")))))
}

/// Writes the check's profiling sidecars (`stage / elapsed_ms / elapsed_us`
/// TSV, the shape `scripts/test_cli_core.sh` reads). One measured stage: the
/// import-resolving check is a single call from here, so `check` and `total`
/// carry the same wall time rather than a load/type split nobody measured.
fn write_check_profiles(tsv_path: String, callstack_path: String, elapsed_us: Int) -> Unit with Fs {
  if tsv_path != "" {
    Fs::write_file(tsv_path, String::concat("stage\telapsed_ms\telapsed_us\n", String::concat(profile_stage_row("check", elapsed_us), profile_stage_row("total", elapsed_us))))
  } else {
    ()
  }
  if callstack_path != "" {
    Fs::write_file(callstack_path, String::concat("stage\telapsed_ms\telapsed_us\n", profile_stage_row("check", elapsed_us)))
  } else {
    ()
  }
}

fn selfhost_cli_user_check_args(args: Array[String]) -> Int with Exception + Fs + Env + Console + Stderr + Profiler {
  let mut missing_vpkg = false
  let mut deps_missing = false
  let mut i = 1
  while i < Array::length(args) {
    let arg = Array::get(args, i)
    if arg == "--missing-vpkg" {
      missing_vpkg = true
    } else if arg == "--deps-missing" {
      deps_missing = true
    } else {
      ()
    }
    i = i + 1
  }
  if missing_vpkg || deps_missing {
    let (root, _, _) = parse_user_check_args(args)
    user_check_scan(root, missing_vpkg)
  } else {
    let (_, single, json) = parse_user_check_args(args)
    let paths = user_check_paths(args)
    let (profile_tsv, profile_callstack) = user_check_profile_paths(args)
    // Every file must exist before any is checked: a report for the files
    // that exist would read as a complete answer to a different question.
    let mut pi = 0
    while pi < Array::length(paths) {
      if !Fs::exists(Array::get(paths, pi)) {
        throw(String::concat("not found: ", Array::get(paths, pi)))
      } else {
        ()
      }
      pi = pi + 1
    }
    // `vibe check`'s contract (AGENTS.md, #1567/#1888): the diagnostics are
    // the REPORT -- one per line on STDOUT, `error: ` framing, exit 1 -- and
    // empty stdout means clean. The lanes below raise them as an exception
    // (that is how the checker hands them back); a usage error such as a
    // missing file stays an exception and reaches stderr through the
    // dispatcher's handler, which is where the launcher printed it before.
    // Several files are checked in turn (`vibe check a.vibe b.vibe`), and
    // one failing file fails the command.
    let started_us = Profiler::now_us()
    let mut code = 0
    let mut ci = 0
    while ci < Array::length(paths) {
      let src = Array::get(paths, ci)
      let file_code = handle {
        if single {
          user_check_single(src, json)
        } else if json {
          user_check_linked_json(src)
        } else {
          user_check_linked(src)
        }
      } with { Exception::Throw(e) => {
        print(line_terminated(format_check_report(e)))
        1
      } }
      if file_code != 0 {
        code = file_code
      } else {
        ()
      }
      ci = ci + 1
    }
    // `--profile-tsv` / `--profile-callstack` (Codex review of #2858): the
    // sidecars are written for a failed check too -- a profile of a check
    // that found errors is still a profile of that check.
    write_check_profiles(profile_tsv, profile_callstack, Profiler::now_us() - started_us)
    code
  }
}

//# compile / build

/// `(input, output, entry, wit, minify, component)`.
///
/// `component` is its own field rather than a mode: `--component` selects a
/// DIFFERENT COMPILE LANE (`command_component_compile_mode()`) and a different
/// artifact (a Component Model binary wrapping the core), so folding it into
/// the wit/minify booleans would lose the refusals below.
export fn parse_user_compile_args(args: Array[String]) -> (String, String, String, Bool, Bool, Bool) with Exception {
  if Array::length(args) == 0 {
    throw("compile: expected command")
  } else {
    let cmd = Array::get(args, 0)
    if cmd != "compile" && cmd != "build" {
      throw("compile: expected command")
    } else {
      let mut src = ""
      let mut out = ""
      let mut entry = "main"
      let mut entry_override = false
      let mut wit = false
      let mut component = false
      let mut minify = false
      let mut i = 1
      while i < Array::length(args) {
        let arg = Array::get(args, i)
        if arg == "-o" || arg == "--output" || arg == "--out" {
          i = i + 1
          out = need_value(args, i, cmd, arg)
          ()
        } else if arg == "--entry" {
          i = i + 1
          entry = need_value(args, i, cmd, arg)
          entry_override = true
          ()
        } else if arg == "--wit" {
          wit = true
          ()
        } else if arg == "--component" {
          component = true
          ()
        } else if arg == "--minify" {
          minify = true
          ()
        } else if arg == "--jobs" {
          i = i + 1
          let _ = parse_jobs_value(need_value(args, i, cmd, arg))
          ()
        } else if arg == "--wasm" || arg == "--wasm-linear" || arg == "--release" {
          ()
        } else if arg == "--debug" {
          ()
        } else if String::length(arg) > 0 && String::byte_at(arg, 0) == 45 {
          throw(String::concat(cmd, String::concat(": unknown option: ", arg)))
        } else if src == "" {
          src = arg
          ()
        } else {
          throw(String::concat(cmd, ": too many input files"))
        }
        i = i + 1
      }
      if src == "" {
        throw(String::concat("usage: vibe ", String::concat(cmd, " <file.vibe|file.vibex> [-o <out.wasm>] [--entry <name>] [--wit] [--component] [--minify] [--jobs N]")))
      } else if is_vibex_path(src) && entry_override {
        throw(".vibex entry is always main; --entry is not allowed")
      } else if wit && is_vibex_path(src) {
        throw("--wit for .vibex requires semantic contract emission")
      } else if component && wit {
        throw("--component and --wit produce different artifacts from the same file; run them separately")
      } else if component && entry_override {
        throw("--component has no command entry; its surface is the lifted `run` export, so --entry is not allowed")
      } else if component && minify {
        // vibe-opt optimizes CORE modules; running it over a component binary
        // is a different operation and is not wired.
        throw("--component and --minify cannot be combined: the minifier takes a core module, not a component")
      } else if component && is_vibex_path(src) {
        // A `.vibex` is an executable root with NO export surface (ADR-0075,
        // #2229), so it can never carry the `export fn vibe_command` a command
        // component is made of. Refused here rather than deep in compilation,
        // where the message would be about exports and never mention
        // `--component`.
        throw("--component needs a .vibe module: a .vibex is an executable root with no export surface, and a command component is built from `export fn vibe_command(args: String) -> String`")
      } else {
        let resolved_entry = if component {
          // Shared with the `.vibex` CLI door, so the same flag cannot mean two
          // different entries depending on which front door was used (#2863).
          command_component_entry()
        } else if is_vibex_path(src) {
          "main"
        } else {
          entry
        }
        let resolved_out = if out == "" {
          if wit {
            String::concat(".vibe/build/out/", String::concat(basename_of(strip_vibe_suffix(src)), ".wit"))
          } else if component {
            String::concat(".vibe/build/out/", String::concat(basename_of(strip_vibe_suffix(src)), ".component.wasm"))
          } else {
            String::concat(".vibe/build/out/", String::concat(basename_of(strip_vibe_suffix(src)), ".wasm"))
          }
        } else {
          out
        }
        (src, resolved_out, resolved_entry, wit, minify, component)
      }
    }
  }
}

/// The export name a command component lifts. `runtime/viberun`'s command
/// loader looks it up by name; the vibe function BEHIND it is
/// `command_component_entry()`.
fn user_command_component_export() -> String {
  "run"
}

/// The wrap's own message names what it found in the core; this adds the edit,
/// which is what the reader is missing when the core has no command entry.
fn user_command_component_edit(input_path: String, entry: String, message: String) -> String {
  "build --component \{input_path}: \{message}; a command module exports exactly `export fn \{entry}(args: String) -> String` and returns the `vibe-command-result-v1` frame (`command_ok` / `command_result` in @vibe/command)"
}

fn emit_user_command_component(core: Bytes, input_path: String) -> Bytes with Exception {
  let entry = command_component_entry()
  handle {
    comp_emit_component_wasm_command(core, entry, user_command_component_export())
  } with { Exception::Throw(message) => throw(user_command_component_edit(input_path, entry, message)) }
}

fn args_has_flag(args: Array[String], flag: String) -> Bool {
  let mut i = 1
  let mut found = false
  while i < Array::length(args) {
    if Array::get(args, i) == flag {
      found = true
    } else {
      ()
    }
    i = i + 1
  }
  found
}

fn selfhost_cli_user_compile_args(args: Array[String]) -> Int with Exception + Fs + Env + Console {
  let (src, out, entry, wit, minify, component) = parse_user_compile_args(args)
  // `--debug` is the linked debug lane docs/user/reference/cli-commands.md
  // documents for `vibe build`: library modules cached as linked wasm files,
  // only the entry recompiled. The parser accepted the flag and this function
  // then built the release artifact regardless (Codex review of #2858) -- a
  // release binary reported as a debug build is the silent kind of wrong.
  let debug = args_has_flag(args, "--debug")
  let out_given = args_has_flag(args, "-o") || args_has_flag(args, "--output") || args_has_flag(args, "--out")
  if !Fs::exists(src) {
    throw(String::concat("not found: ", src))
  } else if debug && (component || wit || minify) {
    throw("--debug selects the linked debug lane and cannot be combined with --component, --wit or --minify")
  } else if debug {
    let resolved = resolve_user_build_output(out, out_given)
    ensure_parent_dir(resolved)
    // The GATED builder checks the closure its own compile ingested, so the
    // verdict covers exactly the bytes it writes (#2305, Codex review).
    reject_unstable_entry_surface(src)
    write_linked_debug_build_checked(src, resolved, entry, unstable_opt_in())
    println(String::concat("compiled (debug) ", String::concat(src, String::concat(" -> ", display_under_root(resolved, default_build_dir())))))
    0
  } else if component {
    let resolved = resolve_user_build_output(out, out_given)
    // The `dce-root` lane prunes from the command entry, so a module with no
    // `vibe_command` export compiles to nothing and the compiler says so in
    // its own words. The reader needs the EDIT -- the signature and the
    // result frame -- which is what `user_command_component_edit` adds
    // (scripts/test_component_lazy_dispatch_gate.sh asserts both). Other
    // refusals (an unstable import, a type error) keep their own message.
    let core = handle {
      compile_user_artifact(src, entry, "component", no_grants())
    } with { Exception::Throw(message) => {
      if String::contains(message, "no functions found to compile") {
        throw(user_command_component_edit(src, entry, "the module has no `\{entry}` export (\{message})"))
      } else {
        throw(message)
      }
    } }
    write_wasm(resolved, emit_user_command_component(core, src))
    println(String::concat("component ", String::concat(src, String::concat(" -> ", display_under_root(resolved, default_build_dir())))))
    0
  } else if wit {
    let resolved = resolve_user_build_output(out, out_given)
    let stmts = parse_user_entry_file(src)
    ensure_parent_dir(resolved)
    Fs::write_file(resolved, wit_from_program(stmts, stmts, basename_of(strip_vibe_suffix(src))))
    println(String::concat("wit ", String::concat(src, String::concat(" -> ", display_under_root(resolved, default_build_dir())))))
    0
  } else {
    let resolved = resolve_user_build_output(out, out_given)
    let bytes = compile_user_artifact(src, entry, "mvp", no_grants())
    write_user_executable(resolved, bytes, entry, "mvp")
    println(String::concat("compiled ", String::concat(src, String::concat(" -> ", display_under_root(resolved, default_build_dir())))))
    if minify {
      let action = Env::get("VIBE_HOST_ACTION_OUT")
      write_host_action(action, String::concat("vibe-host-action-v1\nminify\n", String::concat(resolved, "\n")))
    } else {
      0
    }
  }
}

//# fmt / normalize

export fn parse_user_fmt_args(args: Array[String]) -> (String, String) with Exception {
  if Array::length(args) == 0 || Array::get(args, 0) != "fmt" {
    throw("vibe fmt: expected command")
  } else {
    let mut mode = "write"
    let mut src = ""
    let mut i = 1
    while i < Array::length(args) {
      let arg = Array::get(args, i)
      if arg == "--check" {
        mode = "check"
        ()
      } else if arg == "--stdout" {
        mode = "stdout"
        ()
      } else if String::length(arg) > 0 && String::byte_at(arg, 0) == 45 {
        throw(String::concat("vibe fmt: unknown flag: ", arg))
      } else if src == "" {
        src = arg
        ()
      } else {
        throw("vibe fmt: takes ONE file")
      }
      i = i + 1
    }
    if src == "" {
      throw("usage: vibe fmt [--check|--stdout] <file.vibe>")
    } else {
      (src, mode)
    }
  }
}

fn selfhost_cli_user_fmt_args(args: Array[String]) -> Int with Env + Exception + Fs + Console {
  let (src, mode) = parse_user_fmt_args(args)
  if !Fs::exists(src) {
    throw(String::concat("not found: ", src))
  } else {
    let raw = Fs::read_file(src)
    let pre = fill_require_pins_lenient(raw)
    let formatted = format_source(src, pre)
    let is_vpkg = path_has_suffix(src, ".vpkg")
    let head_end = if is_vpkg {
      0
    } else {
      let e = source_header_end(pre)
      if e > 0 {
        e
      } else {
        0
      }
    }
    let body = String::substring(pre, head_end, String::length(pre))
    let formatted_body = String::substring(formatted, head_end, String::length(formatted))
    if !is_vpkg {
      let err = parse_error_of(body)
      if String::length(err) > 0 {
        throw(String::concat("vibe fmt: refusing to format ", String::concat(src, String::concat(": it does not parse\n  ", err))))
      } else if !program_parses(formatted_body) {
        throw(String::concat("vibe fmt: refusing to rewrite ", src))
      } else {
        ()
      }
    } else {
      ()
    }
    if mode == "stdout" {
      print(formatted)
      0
    } else if mode == "check" {
      if raw == formatted {
        0
      } else {
        println(String::concat("not formatted: ", src))
        1
      }
    } else {
      if raw != formatted {
        Fs::write_file(src, formatted)
      } else {
        ()
      }
      0
    }
  }
}

