//# queries

export fn parse_user_type_at_args(args: Array[String]) -> (String, Int, Int) with Exception {
  if Array::length(args) < 4 {
    throw(String::concat("usage: vibe ", String::concat(Array::get(args, 0), " <file.vibe> <line> <col>")))
  } else {
    let src = Array::get(args, 1)
    let line = user_dispatch_parse_int_or(Array::get(args, 2), 0)
    let col = user_dispatch_parse_int_or(Array::get(args, 3), 0)
    if line < 1 || col < 1 {
      throw(String::concat("usage: vibe ", String::concat(Array::get(args, 0), " <file.vibe> <line> <col>")))
    } else {
      (src, line, col)
    }
  }
}

/// `vibe type-at` (#3000): stdout carries the type and nothing else, so an
/// empty stdout with exit 0 means exactly one thing -- there IS an identifier
/// at the position, and no type is known for it (a note naming it goes to
/// stderr). A position with no identifier under it (whitespace, a keyword, a
/// literal, punctuation, past the end of the line or file) is an error: stderr
/// says so and the exit is 1. So is a file that does not parse, which used to
/// answer nothing with exit 0 as well.
fn selfhost_cli_user_type_at_args(args: Array[String]) -> Int with Exception + Fs + Console + Stderr {
  let (src, line, col) = parse_user_type_at_args(args)
  if !Fs::exists(src) {
    throw(String::concat("not found: ", src))
  } else {
    let source = Fs::read_file(src)
    let ty = type_at_source(source, line, col)
    if ty != "" {
      print_text(ty)
      0
    } else {
      let at = String::concat(src, String::concat(":", String::concat(__to_string(line), String::concat(":", __to_string(col)))))
      let parse_error = parse_error_of(source)
      let name = type_at_ident_at(source, line, col)
      if parse_error != "" {
        // Nothing in a file that does not parse has a type; saying "no
        // identifier" here would blame the position for the file's error.
        Stderr::write_stream(line_terminated(String::concat("type-at: ", String::concat(src, String::concat(" does not parse (run `vibe check` on it): ", parse_error)))))
        1
      } else if name == "" {
        Stderr::write_stream(line_terminated(String::concat("type-at: no identifier at ", String::concat(at, " (the byte column must point into a name)"))))
        1
      } else {
        Stderr::write_stream(line_terminated(String::concat("type-at: no type is known for `", String::concat(name, String::concat("` at ", at)))))
        0
      }
    }
  }
}

fn selfhost_cli_user_doc_at_args(args: Array[String]) -> Int with Exception + Fs + Console {
  let (src, line, col) = parse_user_type_at_args(args)
  if !Fs::exists(src) {
    throw(String::concat("not found: ", src))
  } else {
    print_text(doc_at_source(Fs::read_file(src), line, col))
    0
  }
}

fn join_binding(occ: Array[(Int, Int)]) -> String {
  let n = Array::length(occ)
  if n == 0 {
    ""
  } else {
    let acc = StringBuilder::new()
    let mut i = 0
    while i < n {
      let (s, e) = Array::get(occ, i)
      if i > 0 {
        StringBuilder::push(acc, "\n")
      } else {
        ()
      }
      StringBuilder::push(acc, __to_string(s))
      StringBuilder::push(acc, " ")
      StringBuilder::push(acc, __to_string(e))
      i = i + 1
    }
    StringBuilder::freeze(acc)
  }
}

fn selfhost_cli_user_binding_at_args(args: Array[String]) -> Int with Exception + Fs + Console {
  let (src, line, col) = parse_user_type_at_args(args)
  if !Fs::exists(src) {
    throw(String::concat("not found: ", src))
  } else {
    print_text(join_binding(binding_occurrences(Fs::read_file(src), line, col)))
    0
  }
}

fn escape_doc_field(text: String) -> String {
  let n = String::length(text)
  let acc = StringBuilder::new()
  let mut i = 0
  while i < n {
    let c = String::byte_at(text, i)
    if c == 92 {
      StringBuilder::push(acc, "\\\\")
    } else if c == 10 {
      StringBuilder::push(acc, "\\n")
    } else if c == 13 {
      ()
    } else {
      StringBuilder::push(acc, String::from_byte(c))
    }
    i = i + 1
  }
  StringBuilder::freeze(acc)
}

fn name_field_needs_escape(text: String) -> Bool {
  let n = String::length(text)
  let mut i = 0
  let mut found = false
  while i < n && !found {
    let c = String::byte_at(text, i)
    if c == 92 || c == 32 || (c >= 9 && c <= 13) {
      found = true
    } else {
      ()
    }
    i = i + 1
  }
  found
}

fn name_field_escape_of(c: Int) -> String {
  if c == 92 {
    "\\\\"
  } else if c == 32 {
    "\\s"
  } else if c == 9 {
    "\\t"
  } else if c == 10 {
    "\\n"
  } else if c == 11 {
    "\\v"
  } else if c == 12 {
    "\\f"
  } else if c == 13 {
    "\\r"
  } else {
    String::from_byte(c)
  }
}

fn escape_name_field(text: String) -> String {
  if !name_field_needs_escape(text) {
    text
  } else {
    let n = String::length(text)
    let acc = StringBuilder::new()
    let mut i = 0
    while i < n {
      StringBuilder::push(acc, name_field_escape_of(String::byte_at(text, i)))
      i = i + 1
    }
    StringBuilder::freeze(acc)
  }
}

fn join_symbol_spans(syms: Array[(String, Int, Int, Int, String)]) -> String {
  let n = Array::length(syms)
  let acc = StringBuilder::new()
  let mut first = true
  let mut i = 0
  while i < n {
    let (name, kind, s, e, doc) = Array::get(syms, i)
    if String::length(name) == 0 {
      ()
    } else {
      let head = String::concat(escape_name_field(name), String::concat(" ", String::concat(__to_string(kind), String::concat(" ", String::concat(__to_string(s), String::concat(" ", __to_string(e)))))))
      let line = if String::length(doc) == 0 {
        head
      } else {
        String::concat(head, String::concat(" ", escape_doc_field(doc)))
      }
      if first {
        StringBuilder::push(acc, line)
        first = false
      } else {
        StringBuilder::push(acc, "\n")
        StringBuilder::push(acc, line)
      }
    }
    i = i + 1
  }
  StringBuilder::freeze(acc)
}

fn join_symbol_spans_with_path(rows: Array[(String, String, Int, Int, Int, String)]) -> String {
  let n = Array::length(rows)
  let acc = StringBuilder::new()
  let mut first = true
  let mut i = 0
  while i < n {
    let (path, name, kind, s, e, doc) = Array::get(rows, i)
    if String::length(name) == 0 {
      ()
    } else {
      let head = String::concat(path, String::concat(" ", String::concat(escape_name_field(name), String::concat(" ", String::concat(__to_string(kind), String::concat(" ", String::concat(__to_string(s), String::concat(" ", __to_string(e)))))))))
      let line = if String::length(doc) == 0 {
        head
      } else {
        String::concat(head, String::concat(" ", escape_doc_field(doc)))
      }
      if first {
        StringBuilder::push(acc, line)
        first = false
      } else {
        StringBuilder::push(acc, "\n")
        StringBuilder::push(acc, line)
      }
    }
    i = i + 1
  }
  StringBuilder::freeze(acc)
}

fn symbols_legend() -> String {
  "2 Module\n6 Method\n10 Enum\n11 Interface\n12 Function\n13 Variable\n23 Struct\n24 Event\n26 TypeParameter\n27 Test\n28 Bench"
}

fn selfhost_cli_user_symbols_args(args: Array[String]) -> Int with Exception + Fs + Console + Stderr {
  if Array::length(args) >= 2 && Array::get(args, 1) == "--legend" {
    println(symbols_legend())
    0
  } else if Array::length(args) >= 2 && (Array::get(args, 1) == "--help" || Array::get(args, 1) == "-h") {
    println("usage: vibe symbols [--with-path] <path>...\n       vibe symbols --legend")
    0
  } else {
    let mut with_path = false
    let paths: Array[String] = []
    let mut i = 1
    while i < Array::length(args) {
      let arg = Array::get(args, i)
      if arg == "--with-path" {
        with_path = true
        ()
      } else if arg == "--" {
        i = i + 1
        while i < Array::length(args) {
          Array::push(paths, Array::get(args, i))
          i = i + 1
        }
      } else if String::length(arg) > 0 && String::byte_at(arg, 0) == 45 {
        throw(String::concat("symbols: unknown flag: ", arg))
      } else {
        Array::push(paths, arg)
      }
      i = i + 1
    }
    if Array::length(paths) == 0 {
      throw("usage: vibe symbols [--with-path] <path>...")
    } else {
      // Every root must exist before any row is printed: a sweep that skipped
      // a missing root would print a complete-looking answer to a different
      // question (scripts/test_vibe_symbols.sh, #2381).
      let mut ci = 0
      while ci < Array::length(paths) {
        if !Fs::exists(Array::get(paths, ci)) {
          throw(String::concat("not found: ", Array::get(paths, ci)))
        } else {
          ()
        }
        ci = ci + 1
      }
      // More than one root, or a DIRECTORY root, can produce lines from more
      // than one file -- so the PATH field is not optional there, and a lone
      // directory takes the sweep rather than being read as a file.
      let many = with_path || Array::length(paths) > 1 || Fs::is_dir(Array::get(paths, 0))
      if many {
        let acc = StringBuilder::new()
        let fails: Array[String] = []
        let mut first = true
        let mut pi = 0
        while pi < Array::length(paths) {
          let (rows, failures) = symbol_spans_fs_report(Array::get(paths, pi))
          let chunk = join_symbol_spans_with_path(rows)
          if chunk != "" {
            if first {
              StringBuilder::push(acc, chunk)
              first = false
            } else {
              StringBuilder::push(acc, "\n")
              StringBuilder::push(acc, chunk)
            }
          } else {
            ()
          }
          let mut fi = 0
          while fi < Array::length(failures) {
            Array::push(fails, Array::get(failures, fi))
            fi = fi + 1
          }
          pi = pi + 1
        }
        print_text(StringBuilder::freeze(acc))
        // The symbols contract (AGENTS.md): the rows that were read reach
        // stdout, a file that could not be parsed is NAMED on stderr, and the
        // exit is non-zero. Throwing here would append the failure to the
        // machine-readable stream through the entry's `error:` framing.
        if Array::length(fails) > 0 {
          Stderr::write_stream(line_terminated(String::join(fails, "\n")))
          1
        } else {
          0
        }
      } else {
        let src = Array::get(paths, 0)
        if !Fs::exists(src) {
          throw(String::concat("not found: ", src))
        } else {
          // #2898: the file DECIDES the grammar -- a `.vpkg` is a list of
          // bodyless declarations, not statement grammar. A failure carries
          // the path and, where the contract parser can say which token it
          // stopped on, a `line L:col C:` prefix: `unexpected token: type`
          // with neither was a non-zero exit the caller could not act on.
          let text = Fs::read_file(src)
          let syms = handle {
            symbol_spans_with_docs_for_path(src, text)
          } with { Exception::Throw(msg) => throw(String::concat(src, String::concat(": ", symbol_spans_locate_failure(src, text, msg)))) }
          print_text(join_symbol_spans(syms))
          0
        }
      }
    }
  }
}

fn join_triples_name_int_int(items: Array[(String, Int, Int)]) -> String {
  let n = Array::length(items)
  let acc = StringBuilder::new()
  let mut first = true
  let mut i = 0
  while i < n {
    let (name, s, e) = Array::get(items, i)
    if String::length(name) == 0 {
      ()
    } else {
      let line = String::concat(name, String::concat(" ", String::concat(__to_string(s), String::concat(" ", __to_string(e)))))
      if first {
        StringBuilder::push(acc, line)
        first = false
      } else {
        StringBuilder::push(acc, "\n")
        StringBuilder::push(acc, line)
      }
    }
    i = i + 1
  }
  StringBuilder::freeze(acc)
}

fn selfhost_cli_user_escapes_args(args: Array[String]) -> Int with Exception + Fs + Console {
  let mut strict = false
  let mut src = ""
  let mut i = 1
  while i < Array::length(args) {
    let arg = Array::get(args, i)
    if arg == "--strict" {
      strict = true
      ()
    } else if arg == "--help" || arg == "-h" {
      println("usage: vibe escapes [--strict] <file.vibe>")
      return 0
    } else if String::length(arg) > 0 && String::byte_at(arg, 0) == 45 {
      throw(String::concat("escapes: unknown flag: ", arg))
    } else {
      src = arg
    }
    i = i + 1
  }
  if src == "" {
    throw("usage: vibe escapes [--strict] <file.vibe>")
  } else if !Fs::exists(src) {
    throw(String::concat("not found: ", src))
  } else {
    let spans = if strict {
      escape_spans_strict(Fs::read_file(src))
    } else {
      escape_spans(Fs::read_file(src))
    }
    print_text(join_triples_name_int_int(spans))
    0
  }
}

/// The same three lines `runtime/vibe` prints for `rc-classify --help` without
/// starting a runner (scripts/test_vibe_rc_help.sh); the two texts are kept in
/// step by hand, the gate reads the launcher's.
fn rc_classify_help_text() -> String {
  "usage: vibe rc-classify <file.vibe>\nNAME SET[,SET...] per user function. Empty output = no special sets.\nSets: borrow_ret, borrow_param, view_ret, scalar_ret.\n"
}

fn rc_plan_help_text() -> String {
  "usage: vibe rc-plan [--fn NAME] <file.vibe>\nFN BINDING ACTION COUNT per collapsed Perceus action.\nEmpty output = no actions. ACTION is dup, drop, or alias_dup.\n"
}

fn selfhost_cli_user_rc_classify_args(args: Array[String]) -> Int with Exception + Fs + Console {
  if Array::length(args) >= 2 && (Array::get(args, 1) == "--help" || Array::get(args, 1) == "-h") {
    print_text(rc_classify_help_text())
    0
  } else if Array::length(args) != 2 {
    throw("usage: vibe rc-classify <file.vibe>")
  } else {
    let src = Array::get(args, 1)
    if !Fs::exists(src) {
      throw(String::concat("not found: ", src))
    } else {
      print_text(rc_classify_source(Fs::read_file(src)))
      0
    }
  }
}

fn selfhost_cli_user_rc_plan_args(args: Array[String]) -> Int with Exception + Fs + Console {
  let mut fn_filter = ""
  let mut src = ""
  let mut i = 1
  while i < Array::length(args) {
    let arg = Array::get(args, i)
    if arg == "--fn" {
      i = i + 1
      fn_filter = need_value(args, i, "rc-plan", arg)
      ()
    } else if String::starts_with(arg, "--fn=") {
      fn_filter = arg[5: String::length(arg)]
      ()
    } else if arg == "--help" || arg == "-h" {
      print_text(rc_plan_help_text())
      return 0
    } else if String::length(arg) > 0 && String::byte_at(arg, 0) == 45 {
      throw(String::concat("rc-plan: unknown flag: ", arg))
    } else {
      src = arg
    }
    i = i + 1
  }
  if src == "" {
    throw("usage: vibe rc-plan [--fn NAME] <file.vibe>")
  } else if !Fs::exists(src) {
    throw(String::concat("not found: ", src))
  } else {
    print_text(rc_plan_source(Fs::read_file(src), fn_filter))
    0
  }
}

fn join_alloc_spans(items: Array[(String, String, Int)]) -> String {
  let n = Array::length(items)
  let acc = StringBuilder::new()
  let mut first = true
  let mut i = 0
  while i < n {
    let (fname, kind, off) = Array::get(items, i)
    if first {
      first = false
    } else {
      StringBuilder::push(acc, "\n")
    }
    StringBuilder::push(acc, fname)
    StringBuilder::push(acc, " ")
    StringBuilder::push(acc, kind)
    StringBuilder::push(acc, " ")
    StringBuilder::push(acc, __to_string(off))
    i = i + 1
  }
  StringBuilder::freeze(acc)
}

fn selfhost_cli_user_allocs_args(args: Array[String]) -> Int with Exception + Fs + Console {
  if Array::length(args) != 2 {
    throw("usage: vibe allocs <file.vibe>")
  } else {
    let src = Array::get(args, 1)
    if !Fs::exists(src) {
      throw(String::concat("not found: ", src))
    } else {
      print_text(join_alloc_spans(alloc_spans(Fs::read_file(src))))
      0
    }
  }
}

fn array_contains(items: Array[String], needle: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(items) {
    if Array::get(items, i) == needle {
      found = true
    } else {
      ()
    }
    i = i + 1
  }
  found
}

fn join_dep_paths(groups: Array[(String, Array[(String, String)])], entry_path: String) -> String {
  let acc = StringBuilder::new()
  let seen = Array::slice([""], 0, 0)
  let mut first = true
  let mut gi = 0
  while gi < Array::length(groups) {
    let (_, gsources) = Array::get(groups, gi)
    let mut si = 0
    while si < Array::length(gsources) {
      let (path, _) = Array::get(gsources, si)
      if path == entry_path || array_contains(seen, path) {
        ()
      } else {
        Array::push(seen, path)
        if first {
          StringBuilder::push(acc, path)
          first = false
        } else {
          StringBuilder::push(acc, "\n")
          StringBuilder::push(acc, path)
        }
      }
      si = si + 1
    }
    gi = gi + 1
  }
  StringBuilder::freeze(acc)
}

fn selfhost_cli_user_deps_args(args: Array[String]) -> Int with Env + Exception + Fs + Console {
  let mut direct = false
  let mut src = ""
  let mut i = 1
  while i < Array::length(args) {
    let arg = Array::get(args, i)
    if arg == "--direct" {
      direct = true
      ()
    } else if String::length(arg) > 0 && String::byte_at(arg, 0) == 45 {
      throw(String::concat("deps: unknown flag: ", arg))
    } else if src == "" {
      src = arg
      ()
    } else {
      throw("usage: vibe deps [--direct] <file.vibe>")
    }
    i = i + 1
  }
  if src == "" {
    throw("usage: vibe deps [--direct] <file.vibe>")
  } else if !Fs::exists(src) {
    throw(String::concat("not found: ", src))
  } else if direct {
    let ingested = ingest_source_text_fs(src, Fs::read_file(src))
    let (deps, _, _) = load_or_parse_module_header_fs(src, ingested, 0)
    print_text(String::join(deps, "\n"))
    0
  } else {
    print_text(join_dep_paths(collect_source_groups_fs(src), src))
    0
  }
}

fn selfhost_cli_user_diagnostics_args(args: Array[String]) -> Int with Exception + Fs + Env + Console {
  let mut json = false
  let mut src = ""
  let mut i = 1
  while i < Array::length(args) {
    let arg = Array::get(args, i)
    if arg == "--json" {
      json = true
      ()
    } else if src == "" {
      src = arg
      ()
    } else {
      throw("usage: vibe diagnostics [--json] <file.vibe>")
    }
    i = i + 1
  }
  if src == "" {
    throw("usage: vibe diagnostics [--json] <file.vibe>")
  } else {
    user_diagnostics_report(src, json)
  }
}

/// `vibe diagnostics` is deprecated and FROZEN for the editors that still call
/// it (AGENTS.md, #1567): every diagnostic line raw on stdout (or the LSP
/// Diagnostic array with `--json`), and exit 0 whether or not the file is
/// clean. Routing it through `user_check_single` gave it `vibe check`'s
/// `error:` framing and exit 1 (Codex review of #2858).
fn user_diagnostics_report(src: String, json: Bool) -> Int with Exception + Fs + Env + Console {
  if !Fs::exists(src) {
    throw(String::concat("not found: ", src))
  } else {
    let text = Fs::read_file(src)
    let diags = handle {
      collect_all_diagnostics_with_unstable_for_path(src, text, unstable_opt_in())
    } with { Exception::Throw(_) => {
      let empty: Array[String] = []
      empty
    } }
    if json {
      print(line_terminated(lsp_diagnostics_json_of_messages(text, diags)))
    } else if Array::length(diags) > 0 {
      print_text(String::join(diags, "\n"))
    } else {
      ()
    }
    0
  }
}

fn selfhost_cli_user_grep_args(args: Array[String]) -> Int with Env + Exception + Fs + Profiler + Console + Stderr {
  let mut pattern = ""
  let mut json = false
  let mut only = ""
  // #2914's chunked-sweep contract, as FLAGS rather than env selectors.
  //
  // The env-mode entry (cli_adapter) reads `VIBE_GREP_LIST_FILES` and friends
  // because it has no argv at all -- it is `(input, output)` plus VIBE_*
  // selectors, and that is the only channel there is. This path HAS an
  // argument parser, so using the env spelling here was copying the wrong half
  // of that pattern: `VIBE_GREP_LIST_FILES` is an adapter BRANCH SELECTOR, and
  // a launcher that dispatches by argv must not set one
  // (`check_selector_precedence.sh`, which caught exactly this). A hidden env
  // knob on a user-facing CLI is worse than a flag anyway.
  let mut list_files = false
  let mut file_list = ""
  let mut resume_out = ""
  let wheres: Array[String] = []
  let where_rows: Array[String] = []
  let paths: Array[String] = []
  let mut i = 1
  while i < Array::length(args) {
    let arg = Array::get(args, i)
    if arg == "--help" || arg == "-h" {
      println("usage: vibe grep --pattern '<pat>' [paths]")
      return 0
    } else if arg == "--pattern" {
      i = i + 1
      pattern = need_value(args, i, "grep", arg)
      ()
    } else if String::starts_with(arg, "--pattern=") {
      pattern = arg[10: String::length(arg)]
      ()
    } else if arg == "--json" || arg == "--output-json" {
      json = true
      ()
    } else if arg == "--where" {
      i = i + 1
      Array::push(wheres, need_value(args, i, "grep", arg))
      ()
    } else if String::starts_with(arg, "--where=") {
      Array::push(wheres, arg[8: String::length(arg)])
    } else if arg == "--where-row" {
      i = i + 1
      Array::push(where_rows, need_value(args, i, "grep", arg))
      ()
    } else if String::starts_with(arg, "--where-row=") {
      Array::push(where_rows, arg[12: String::length(arg)])
    } else if arg == "--only-ill-typed" {
      only = "ill"
      ()
    } else if arg == "--only-well-typed" {
      only = "well"
      ()
    } else if arg == "--list-files" {
      list_files = true
      ()
    } else if arg == "--file-list" {
      i = i + 1
      file_list = need_value(args, i, "grep", arg)
      ()
    } else if String::starts_with(arg, "--file-list=") {
      file_list = arg[12: String::length(arg)]
    } else if arg == "--resume-out" {
      i = i + 1
      resume_out = need_value(args, i, "grep", arg)
      ()
    } else if String::starts_with(arg, "--resume-out=") {
      resume_out = arg[13: String::length(arg)]
    } else if arg == "--" {
      i = i + 1
      while i < Array::length(args) {
        Array::push(paths, Array::get(args, i))
        i = i + 1
      }
    } else if String::length(arg) > 0 && String::byte_at(arg, 0) == 45 {
      throw(String::concat("vibe grep: unknown flag: ", arg))
    } else {
      Array::push(paths, arg)
    }
    i = i + 1
  }
  if pattern == "" {
    throw("vibe grep: --pattern needs an argument")
  } else if resume_out != "" && file_list == "" && Array::length(paths) > 1 {
    // `file_list == ""` is half the condition and the important half: WITH an
    // explicit list the index is well defined against it, and the launcher's
    // own chunk calls pass one alongside every original root -- so refusing on
    // the root count alone rejected every chunk of a multi-root typed sweep
    // before it scanned anything (Codex on #2956, P2, against the refusal I
    // added one commit earlier). Without a list the roots are walked
    // separately, and there is no single sequence for an index to mean
    // anything against. Left unrefused, a hand-off in an early
    // root returned partial output and wrote its index, the loop moved on, and
    // THAT root's sweep deleted the index as stale -- exit 0, the first root
    // partly searched, nothing left saying so (Codex on #2956, P1; the delete
    // was my own fix for a stale index, one round earlier).
    //
    // Refused rather than stopped after the first hand-off, because stopping
    // still hands back an index the caller cannot attribute to a root.
    // `--json` below refuses several paths for the same kind of reason: one
    // answer, one input.
    throw("vibe grep --resume-out: one path at a time (the resume index is an offset into a single file list)")
  } else if json && Array::length(paths) > 1 {
    // Each sweep returns one complete JSON array; concatenating two is not
    // JSON. The launcher refused this before the verbs moved (Codex review).
    throw("vibe grep --json: one path at a time (JSON output is a single array)")
  } else {
    if Array::length(paths) == 0 {
      Array::push(paths, ".")
    } else {
      ()
    }
    // #2914: the same file-list / resume contract cli_adapter.vibe carries, so
    // `runtime/vibe grep` can drive a resumable sweep too. Until this, the
    // argv path had no way to be chunked: it stopped at the guard with the
    // located refusal and never finished a tree-wide typed sweep -- measured,
    // file 70 of 1224 -- while its own diagnostic advised lowering
    // `VIBE_GREP_CHUNK_FILES`, a knob that did nothing on this path.
    //
    // There is exactly ONE call to the sweep below. Two call sites are how
    // `VIBE_GREP_RESUME` came to be honoured on one adapter path and silently
    // ignored on the other.
    let chunk_list = file_list
    // The files the sweep WOULD visit, for a driver that wants to partition
    // them. Printed rather than swept; the skip policy stays in source_walk.
    if list_files {
      let listing = StringBuilder::new()
      StringBuilder::push(listing, grep_file_list_banner())
      StringBuilder::push(listing, "\n")
      let mut li = 0
      while li < Array::length(paths) {
        StringBuilder::push(listing, grep_list_files(Array::get(paths, li)))
        li = li + 1
      }
      print_text(StringBuilder::freeze(listing))
      return 0
    } else {
      ()
    }
    // A chunk IS the sweep, once -- not once per path. The chunk a driver
    // hands back was cut from the COMBINED listing of every path, so running
    // it inside the per-path loop would emit each match once per path: two
    // paths, every result doubled, exit 0. That is the silent-wrong shape
    // this repo ranks above crashing, and it is invisible to a one-path gate.
    let job_count = if chunk_list != "" {
      1
    } else {
      Array::length(paths)
    }
    let acc = StringBuilder::new()
    let mut first = true
    let mut pi = 0
    while pi < job_count {
      let sweep_root = Array::get(paths, pi)
      let sweep_files = if chunk_list != "" {
        grep_read_file_list(chunk_list)
      } else {
        grep_collect_files(sweep_root)
      }
      // Which files this sweep was asked about BY NAME, so an unparseable one
      // throws rather than warning (#2940). When a chunk spans several roots
      // it is EVERY named non-directory among them -- a chunk cut from the
      // combined listing has no single root, and answering "directory" for it
      // downgraded a named `bad.vibe` to exit 0 (Codex on #2956, P1).
      let named_files: Array[String] = []
      let mut ni = 0
      while ni < (if chunk_list != "" {
        Array::length(paths)
      } else {
        1
      }) {
        let cand = if chunk_list != "" {
          Array::get(paths, ni)
        } else {
          sweep_root
        }
        if Fs::is_dir(cand) {
          ()
        } else {
          Array::push(named_files, cand)
        }
        ni = ni + 1
      }
      let (text, warnings) = grep_scan_files_report(sweep_files, pattern, wheres, where_rows, only, json, named_files, resume_out)
      // A file the sweep could not parse is reported, not searched: the
      // warning is what tells "no match" from "not searched" apart, so it
      // reaches stderr the way the launcher used to relay `<out>.warn`.
      if warnings != "" {
        Stderr::write_stream(line_terminated(warnings))
      } else {
        ()
      }
      if text != "" {
        if first {
          StringBuilder::push(acc, text)
          first = false
        } else {
          StringBuilder::push(acc, "\n")
          StringBuilder::push(acc, text)
        }
      } else {
        ()
      }
      pi = pi + 1
    }
    print_text(StringBuilder::freeze(acc))
    0
  }
}

/// The verb dispatcher with its exception discharged to an exit code: the
/// framed diagnostic goes to STDERR, where `runtime/vibe` used to print the
/// adapter's `.diag` sidecar, so a verb's machine-readable stdout (symbols
/// rows, grep matches, check diagnostics) is never interleaved with it.
export fn run_user_dispatch_args(args: Array[String]) -> Int with Fs + Env + Stdin + Console + Stderr + Profiler {
  handle {
    selfhost_cli_user_dispatch_args(args)
  } with { Exception::Throw(e) => {
    Stderr::write_stream(line_terminated(format_check_report(e)))
    1
  } }
}

export fn selfhost_cli_user_dispatch_args(args: Array[String]) -> Int with Exception + Fs + Env + Stdin + Console + Stderr + Profiler {
  let argv = rewrite_user_argv(args, Env::get("VIBE_INVOKE_DIR"), Fs::getcwd())
  let first = if Array::length(argv) == 0 {
    "help"
  } else {
    Array::get(argv, 0)
  }
  match first {
    "check" => selfhost_cli_user_check_args(argv),
    "compile" => selfhost_cli_user_compile_args(argv),
    "build" => selfhost_cli_user_compile_args(argv),
    "fmt" => selfhost_cli_user_fmt_args(argv),
    "normalize" => selfhost_cli_user_normalize_args(argv),
    "type-at" => selfhost_cli_user_type_at_args(argv),
    "doc-at" => selfhost_cli_user_doc_at_args(argv),
    "refactor" => selfhost_cli_user_refactor_args(argv),
    "binding-at" => selfhost_cli_user_binding_at_args(argv),
    "symbols" => selfhost_cli_user_symbols_args(argv),
    "escapes" => selfhost_cli_user_escapes_args(argv),
    "rc-classify" => selfhost_cli_user_rc_classify_args(argv),
    "rc-plan" => selfhost_cli_user_rc_plan_args(argv),
    "allocs" => selfhost_cli_user_allocs_args(argv),
    "deps" => selfhost_cli_user_deps_args(argv),
    "diagnostics" => selfhost_cli_user_diagnostics_args(argv),
    "grep" => selfhost_cli_user_grep_args(argv),
    "run" => selfhost_cli_user_run_args(argv),
    "test" => selfhost_cli_user_test_args(argv),
    "bench" => selfhost_cli_user_bench_args(argv),
    "serve" => selfhost_cli_user_serve_args(argv),
    "profile" => selfhost_cli_user_profile_args(argv),
    "lsp" => selfhost_cli_user_lsp_args(argv),
    "hash" => selfhost_cli_user_hash_args(argv),
    "inspect-update" => selfhost_cli_user_inspect_update_args(argv),
    "help" => selfhost_cli_user_help_args(argv),
    "--help" => selfhost_cli_user_help_args(argv),
    "-h" => selfhost_cli_user_help_args(argv),
    _ => throw(String::concat("unknown command: ", String::concat(first, " (try 'vibe help')")))
  }
}
