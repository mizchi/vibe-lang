//# Imports

import ./loader_hotspot_probe.vibe {
  load_selfhost_loader_hotspot_fixture,
  load_selfhost_loader_hotspot_indexed_fixture,
  probe_loader_manifest_groups_encoded,
  probe_loader_manifest_groups_indexed_encoded_with_source_index,
  probe_loader_manifest_groups_linear_encoded,
  probe_loader_manifest_list_count,
  probe_loader_manifest_list_filter_indexed_count_with_index,
  probe_loader_manifest_list_filter_linear_count
}

//# Misc

// #859: top-level tuple-pattern let is a rejected parse error (the
// destructure sugar only lowers correctly inside a function/block body);
// these globals are shared across several `bench` blocks below, so they
// must stay module-level -- expanded into individual field-projection
// `let`s instead of a single pattern-let.
let selfhost_hotspot_fixture = load_selfhost_loader_hotspot_fixture()
let selfhost_base_dir = selfhost_hotspot_fixture.0
let selfhost_manifest_rows = selfhost_hotspot_fixture.1
let selfhost_preloaded_sources = selfhost_hotspot_fixture.2
let selfhost_needed_sources = selfhost_hotspot_fixture.3
let selfhost_needed_paths = selfhost_hotspot_fixture.4

let selfhost_indexed_hotspot_fixture = load_selfhost_loader_hotspot_indexed_fixture()
let selfhost_needed_path_index = selfhost_indexed_hotspot_fixture.5
let selfhost_needed_source_index = selfhost_indexed_hotspot_fixture.6

bench "selfhost/loader_manifest_list" {
  let _ = handle {
    probe_loader_manifest_list_count()
  } with Error {
    Throw(_) => 0
  }
}

bench "selfhost/loader_manifest_list_filter_linear" {
  let _ = probe_loader_manifest_list_filter_linear_count(
    selfhost_preloaded_sources,
    selfhost_needed_paths
  )
}

bench "selfhost/loader_manifest_list_filter_indexed" {
  let _ = probe_loader_manifest_list_filter_indexed_count_with_index(
    selfhost_preloaded_sources,
    selfhost_needed_path_index
  )
}

bench "selfhost/loader_manifest_groups" {
  let _ = handle {
    probe_loader_manifest_groups_encoded()
  } with Error {
    Throw(_) => 0
  }
}

bench "selfhost/loader_manifest_groups_linear" {
  let _ = probe_loader_manifest_groups_linear_encoded(
    selfhost_base_dir,
    selfhost_manifest_rows,
    selfhost_needed_sources
  )
}

bench "selfhost/loader_manifest_groups_indexed" {
  let _ = probe_loader_manifest_groups_indexed_encoded_with_source_index(
    selfhost_base_dir,
    selfhost_manifest_rows,
    selfhost_needed_source_index
  )
}
