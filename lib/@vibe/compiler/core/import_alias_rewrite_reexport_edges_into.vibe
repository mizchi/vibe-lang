// lib/@vibe/compiler/core/import_alias_rewrite.vibe — reexport edges into.

import ./ast.vibe {
  Expr, ImportItem, ImportKind, Pat, Stmt, TypeExpr
}

import @vibe/core {
  struct MutMap, struct MutSet
}

import @vibe/ast {
  type_param_name
}

import ./module_graph_path.vibe {
  dir_of_path, resolve_import_path_candidates_with_roots
}

import ./inline_wasm_marker.vibe {
  inline_wasm_marker_name
}

import ./import_alias_rewrite_pat_binds_shadowing_name.vibe {
  empty_strings, import_alias_rewrite_string_array_contains
}

import ./import_alias_rewrite_rewrite_alias_expr_ix.vibe {
  collect_import_refs, sanitize_namespace_path
}

//# #716 export-name visibility

// The merge flattens every file's top-level statements into one program, so a
// bare exported name used to be globally visible: two files exporting the
// same name collided (function-table first match, by merge order), an export
// shadowing a bare BUILTIN name (float.vibe's `eq`) raced the builtin
// fast-path in every file, and any file could call an export it never
// imported. The plan below renames EVERY exported value def of a non-entry
// file to `name_exp_<path>` at its defining file and rewrites the references
// of files that actually `import` it — full import visibility (#716): a name
// resolves exactly where it is imported (or defined). The ENTRY file's own
// defs and the names its re-export surface resolves to are never renamed:
// they are the program's wasm-export / linked-library ABI.

export fn namespace_exported_name(path: String, name: String) -> String {
  String::concat(name, String::concat("_exp_", sanitize_namespace_path(path)))
}

/// Trait operations keep the operation as the qualified member after export
/// namespacing (`Iterator_exp_<provider>::map`). This gives each provider an
/// unambiguous namespace while preserving the operation spelling consumed by
/// trait dispatch and intrinsic devirtualization.
export fn namespace_exported_def_name(path: String, name: String) -> String {
  let split = String::index_of(name, needle = "::")
  if split > 0 {
    let namespace = String::substring(name, start = 0, end = split)
    let operation = String::substring(name, start = split + 2, end = String::length(name))
    String::concat(namespace, String::concat("_exp_", String::concat(sanitize_namespace_path(path), String::concat("::", operation))))
  } else {
    namespace_exported_name(path = path, name = name)
  }
}

fn append_export_def_name(out: Array[String], extern_names: Array[String], trait_names: Array[String], name: String) -> Unit {
  let qi = String::index_of(name, needle = "::")
  let trait_owned = if qi > 0 {
    import_alias_rewrite_string_array_contains(items = trait_names, target = String::substring(name, start = 0, end = qi))
  } else {
    false
  }
  // Iterator::flatmap devirtualizes Array receivers to the specialization
  // defined beside the trait helper. It must travel under the same provider-
  // unique suffix: otherwise an entry-local Array::flatmap races the imported
  // specialization in the flattened function table.
  let iterator_array_specialization = name == "Array::flatmap" && import_alias_rewrite_string_array_contains(items = trait_names, target = "Iterator")
  if (qi < 0 || trait_owned || iterator_array_specialization) && !import_alias_rewrite_string_array_contains(items = extern_names, target = name) && !import_alias_rewrite_string_array_contains(items = out, target = name) {
    Array::push(out, value = name)
  } else {
    ()
  }
}

/// Top-level VALUE defs this file exports under a bare name, plus qualified
/// helpers owned by a trait declared in the same file. Ordinary
/// `Type::method` lets remain global receiver dispatch, but `Trait::operation`
/// travels with an explicit trait import and therefore needs the same unique
/// provider spelling as a bare export. This is what lets an entry publish its
/// own `Trait::operation` ABI without racing the imported provider's helper in
/// the flattened function table.
export fn collect_export_def_value_names(_ stmts: Array[Stmt]) -> Array[String] {
  let extern_names = empty_strings()
  let let_names = empty_strings()
  let exported_lets = empty_strings()
  let export_items = empty_strings()
  let trait_names = empty_strings()
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, at = i) {
      SLet(exported, _, name, _, _) => {
        Array::push(let_names, value = name)
        if exported {
          Array::push(exported_lets, value = name)
        } else {
          ()
        }
      },
      SExternLet(name, _) => Array::push(extern_names, value = name),
      SExport(items) => {
        let mut j = 0
        while j < Array::length(items) {
          Array::push(export_items, value = Array::get(items, at = j))
          j = j + 1
        }
      },
      STrait(_, name, _, _, _, _) => Array::push(trait_names, value = name),
      _ => ()
    }
    i = i + 1
  }
  let out = empty_strings()
  let mut k = 0
  while k < Array::length(exported_lets) {
    append_export_def_name(out = out, extern_names = extern_names, trait_names = trait_names, name = Array::get(exported_lets, at = k))
    k = k + 1
  }
  let mut m = 0
  while m < Array::length(export_items) {
    let name = Array::get(export_items, at = m)
    if import_alias_rewrite_string_array_contains(items = let_names, target = name) {
      append_export_def_name(out = out, extern_names = extern_names, trait_names = trait_names, name = name)
    } else {
      ()
    }
    m = m + 1
  }
  out
}

export struct ExportRenamePlan {
  plan_paths: Array[String];
  rename_paths: Array[String];
  rename_names: Array[String];
  rename_mangled: Array[String];
  // Provider-unique Iterator operations whose origin is authenticated by an
  // import/re-export edge targeting @vibe/builtin. Facade consumers compare
  // their already-resolved operation renames against this compact set, so
  // provenance follows arbitrary facade chains without another graph walk.
  builtin_iterator_mangled: Array[String];
  // #1259: (path, name) -> mangled index over the three parallel arrays
  // above (plan_rename_key encoding). Built once in build_export_rename_plan
  // -- which needs it for its own facade-closure fixpoint -- and reused by
  // collect_import_value_renames' per-import-item lookups.
  rename_idx: MutMap[String, String];
  // A kinded enum re-export alias belongs to its facade's import surface.
  // Consumers resolve it only when they import that spelling; placing an
  // ordinary STypeAlias in the merged program would affect unrelated units.
  enum_alias_idx: MutMap[String, String];
  enum_alias_private_ctors: MutMap[String, Array[(String, String)]];
  enum_alias_paths: Array[String];
  enum_alias_names: Array[String];
  enum_alias_origins: Array[String];
  enum_origin_ambiguous: MutMap[String, Bool];
  enum_origin_ambiguous_names: Array[String];
  enum_alias_count: Int;
  // #3448: one refusal per type name that two source files both publish into
  // the merged program. Types are not namespaced per module, so such a
  // program would run one module's definition (fields, companions) for the
  // other's type.
  type_collision_errors: Array[String]
}

/// Composite key for rename_idx. '\n' can appear in neither a module path
/// nor a value name, so the encoding is collision-free.
export fn plan_rename_key(path: String, name: String) -> String {
  String::concat(path, String::concat("\n", name))
}

export fn enum_alias_target_is_formal(params: Array[String], head: String) -> Bool {
  for param in params {
    if type_param_name(param) == head {
      return true
    }
  }
  false
}

/// Resolve a raw import path against the set of files in this merge; a
/// directory import (`import ./codegen/wasi { .. }`) has two candidates and we
/// pick the one that is actually part of the program.
/// The external roots under which `known_paths` already hold the package
/// `raw_path` names: `<root>/<raw_path>/index.vpkg` (or `.vibei`) gives
/// `<root>`. Empty for a non-package import.
fn known_package_roots(known_paths: Array[String], raw_path: String) -> Array[String] {
  let roots: Array[String] = []
  if String::starts_with(raw_path, prefix = "@") {
    let suffixes = [
      String::concat("/", String::concat(raw_path, "/index.vpkg")),
      String::concat("/", String::concat(raw_path, "/index.vibei"))
    ]
    let mut i = 0
    while i < Array::length(known_paths) {
      let p = Array::get(known_paths, at = i)
      let mut k = 0
      while k < Array::length(suffixes) {
        let suffix = Array::get(suffixes, at = k)
        if String::ends_with(p, suffix = suffix) {
          let root = String::substring(p, start = 0, end = String::length(p) - String::length(suffix))
          if String::length(root) > 0 && !import_alias_rewrite_string_array_contains(items = roots, target = root) {
            Array::push(roots, value = root)
          } else {
            ()
          }
        } else {
          ()
        }
        k = k + 1
      }
      i = i + 1
    }
  } else {
    ()
  }
  roots
}

export fn resolve_known_import_path(known_paths: Array[String], base_dir: String, raw_path: String, self_path: String) -> String {
  // The external library roots are not read here: a package that resolved
  // through one is already in `known_paths` under its root, so its own path
  // is the root. That keeps this resolver pure (#1962).
  let candidates = resolve_import_path_candidates_with_roots(base_dir = base_dir, raw_path = raw_path, roots = known_package_roots(known_paths = known_paths, raw_path = raw_path))
  let mut chosen = ""
  let mut i = 0
  let mut found = false
  while i < Array::length(candidates) && !found {
    let candidate = Array::get(candidates, at = i)
    // Never resolve to the importing file itself (`export ./codegen` inside
    // codegen.vibe targets the directory) — mirrors header_cache/merge_sources.
    if candidate == self_path {
      i = i + 1
    } else {
      if chosen == "" {
        chosen = candidate
      } else {
        ()
      }
      if import_alias_rewrite_string_array_contains(items = known_paths, target = candidate) {
        chosen = candidate
        found = true
      } else {
        i = i + 1
      }
    }
  }
  if chosen == "" {
    Array::get(candidates, at = 0)
  } else {
    chosen
  }
}

/// Re-export edges of one file: `export ./dep.vibe { a, b as c }` plus the
/// `import { x } ... export { x }` facade idiom (an `export {}` item with no
/// local declaration but a matching import). Pushed as parallel arrays
/// (from-path, public-name, target-path, target-name).
export fn collect_reexport_edges_into(path: String, stmts: Array[Stmt], known_paths: Array[String], edge_from: Array[String], edge_pub: Array[String], edge_tpath: Array[String], edge_tname: Array[String], builtin_iterator_paths: Array[String]) -> Unit {
  let base_dir = dir_of_path(path)
  let local_names = empty_strings()
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, at = i) {
      SLet(_, _, name, _, _) => Array::push(local_names, value = name),
      SLetMut(name, _, _) => Array::push(local_names, value = name),
      SExternLet(name, _) => Array::push(local_names, value = name),
      SStruct(_, name, _, _, _, _) => Array::push(local_names, value = name),
      SEnum(_, name, _, _, _) => Array::push(local_names, value = name),
      STrait(_, name, _, _, _, _) => Array::push(local_names, value = name),
      STypeAlias(_, name, _, _) => Array::push(local_names, value = name),
      SSuberror(_, name, _) => Array::push(local_names, value = name),
      SEffectDef(_, name, _, _) => Array::push(local_names, value = name),
      _ => ()
    }
    i = i + 1
  }
  let import_refs = collect_import_refs(stmts)
  let mut si = 0
  while si < Array::length(stmts) {
    match Array::get(stmts, at = si) {
      SImport(raw_path, items) => if raw_path == "@vibe/builtin" {
        let target = resolve_known_import_path(known_paths = known_paths, base_dir = base_dir, raw_path = raw_path, self_path = path)
        let mut j = 0
        while j < Array::length(items) {
          let item = Array::get(items, at = j)
          let is_iterator_trait = item.name == "Iterator" && (match item.kind {
            Some(ImportTrait) => true,
            _ => false
          })
          if is_iterator_trait && !import_alias_rewrite_string_array_contains(items = builtin_iterator_paths, target = target) {
            Array::push(builtin_iterator_paths, value = target)
          } else {
            ()
          }
          j = j + 1
        }
      } else {
        ()
      },
      SReExport(raw_path, items) => {
        let target = resolve_known_import_path(known_paths = known_paths, base_dir = base_dir, raw_path = raw_path, self_path = path)
        let mut j = 0
        while j < Array::length(items) {
          let item = Array::get(items, at = j)
          let is_builtin_iterator_trait = raw_path == "@vibe/builtin" && item.name == "Iterator" && (match item.kind {
            Some(ImportTrait) => true,
            _ => false
          })
          if is_builtin_iterator_trait && !import_alias_rewrite_string_array_contains(items = builtin_iterator_paths, target = target) {
            Array::push(builtin_iterator_paths, value = target)
          } else {
            ()
          }
          let iname = item.name
          let alias_opt = item.alias
          let public_name = match alias_opt {
            Some(alias) => alias,
            None => iname
          }
          Array::push(edge_from, value = path)
          Array::push(edge_pub, value = public_name)
          Array::push(edge_tpath, value = target)
          Array::push(edge_tname, value = iname)
          j = j + 1
        }
      },
      SExport(items) => {
        let mut j = 0
        while j < Array::length(items) {
          let name = Array::get(items, at = j)
          if !import_alias_rewrite_string_array_contains(items = local_names, target = name) {
            // Imports bind in source order, so a later import with the same
            // local spelling owns the facade export. Walk the already-built
            // reference list backwards; this adds no module-sized scan.
            let mut ri = Array::length(import_refs)
            let mut done = false
            while ri > 0 && !done {
              ri = ri - 1
              let (raw_path, original, local) = Array::get(import_refs, at = ri)
              if local == name {
                Array::push(edge_from, value = path)
                Array::push(edge_pub, value = name)
                Array::push(edge_tpath, value = resolve_known_import_path(known_paths = known_paths, base_dir = base_dir, raw_path = raw_path, self_path = path))
                Array::push(edge_tname, value = original)
                done = true
              } else {
                ()
              }
            }
          } else {
            ()
          }
          j = j + 1
        }
      },
      _ => ()
    }
    si = si + 1
  }
}
