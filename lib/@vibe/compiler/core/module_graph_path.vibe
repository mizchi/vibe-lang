import @vibe/core {
  array_empty
}

//# Functions

/// #897 (ADR-0070 Phase 1): `index.vpkg` is the target spelling `index.vibei`
/// is being renamed to (76 directories, migrated in later phases). Every site
/// that currently recognizes a `.vibei` contract file by extension must also
/// recognize `.vpkg` during the migration, so a directory may use EITHER
/// spelling. This is the ONE shared boolean test — string-comparison sites
/// that only need a yes/no "is this a contract-grammar file" answer should
/// call this instead of duplicating the `String::ends_with` pair. Sites that
/// need to build a candidate path (e.g. `dir + "/index.vpkg"`) still spell the
/// literal suffix themselves.
export fn is_contract_ext(path: String) -> Bool {
  String::ends_with(path, ".vibei") || String::ends_with(path, ".vpkg")
}

export fn dir_of_path(file_path: String) -> String {
  let idx = String::last_index_of(file_path, "/")
  if idx < 0 {
    ""
  } else if idx == 0 {
    "/"
  } else {
    file_path[0: idx]
  }
}

/// Module/package sources must be regular filesystem entries.
export fn ensure_regular_source_fs(path: String) -> Unit with Exception + Fs {
  // The Fs::stat_token host ABI reserves -1 for a symbolic link. This keeps
  // symlink rejection bootstrap-compatible without adding a new builtin that
  // the pinned seed compiler could not yet type-check.
  if Fs::stat_token(path) == -1 {
    throw("symlink module source is not allowed: \{path}")
  } else {
    ()
  }
}

export fn path_in_dir(dir: String, basename: String) -> String {
  if dir == "" {
    basename
  } else if dir == "/" {
    String::concat("/", basename)
  } else {
    String::concat(String::concat(dir, "/"), basename)
  }
}

export fn vpkg_path_in_dir(dir: String) -> String {
  path_in_dir(dir, "index.vpkg")
}

/// The nearest enclosing index.vpkg is the package owner. Returning the
/// contract path (rather than the directory) also distinguishes a root package
/// from "no owner", where both directory strings would otherwise be empty.
export fn nearest_vpkg_path_fs(path: String) -> String with Exception + Fs {
  let mut current = dir_of_path(path)
  let mut found = ""
  let mut searching = true
  while searching {
    let candidate = vpkg_path_in_dir(current)
    if Fs::exists(candidate) {
      ensure_regular_source_fs(candidate)
      found = candidate
      searching = false
    } else {
      let parent = dir_of_path(current)
      if parent == current {
        searching = false
      } else {
        current = parent
      }
    }
  }
  found
}

/// Linear membership scan used by `resolve_reexport_chain` to filter
/// re-exported names. Bounded per-module, not whole-program: `items`
/// (`wanted_names`) is a single re-export selection (typically 1-5 names)
/// and it is scanned once per pub statement of one source file. The
/// original O(N^2)-accumulator survey (#366) classified this as "small N,
/// refactor pointless" and #533 re-confirms it. A `Map[String, Bool]`
/// would NOT help: the runtime emits `Map::has_key` as a linear
/// search (#395, closed not-planned). See
/// bench/perf/README.md ("String-keyed lookup" postmortem).
export fn contains_name(items: Array[String], name: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(items) && !found {
    if Array::get(items, i) == name {
      found = true
    } else {
      i = i + 1
    }
  }
  found
}

/// Linear membership scan used by `collect_direct_dep_paths` to dedup the
/// direct dependency paths of one entry file. Bounded by that file's
/// unique imports (≈5-30), so the dedup is O(D^2) with small D (≤ ~900
/// ops, per #366's survey). NOTE: the whole-graph visited/scheduled sets
/// that used to route through this helper (merge recursion, FS collect,
/// manifest worklists) moved to the bucketed `path_set` below (#533);
/// only genuinely small, per-module dedups should keep using this. Kept
/// linear deliberately for those (#533):
///   - `Map[String, Bool]` is a no-op — the runtime emits
///     `Map::has_key`/`Map::get` as linear searches (#395 not-planned).
///   - A sort+merge dedup is UNSAFE: the resulting `dep_paths` order is
///     preserved into `linked_imports`, which the linked codegen turns
///     into wasm import-section indices (see
///     lib/@vibe/compiler/codegen/wasi/linked_compile.vibe). Reordering would
///     change the emitted binary, breaking reproducibility/parity.
/// First-occurrence insertion order must therefore be preserved.
export fn contains_path(visited: Array[String], path: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(visited) && !found {
    if Array::get(visited, i) == path {
      found = true
    } else {
      i = i + 1
    }
  }
  found
}

/// #533: mutable bucketed string set for whole-graph membership tests.
///
/// The per-module `contains_name` / `contains_path` scans above are fine
/// (small bounded N — see the notes on each), but the graph-traversal
/// dedup sites (`collect_sources_rec`, `collect_merged_stmts_recursive`,
/// the manifest worklist loops) test membership against a set that grows
/// to ALL modules, once per import edge — O(edges × modules) string
/// compares, plus O(modules²) entry copying where the set was a
/// `Map[String, Bool]` (the runtime `Map::set` copies the whole map per
/// insert; `Map::has_key` is a linear scan — #395, closed not-planned).
///
/// This set is plain `Array[Array[String]]` buckets + `Array::push`, so
/// it relies on nothing but O(1)-amortized array ops: membership and
/// insert are O(len(path)) hash + a short bucket scan, independent of
/// module count. Insert-only; iteration order is NOT meaningful — callers
/// that need ordered output must keep their own insertion-ordered array
/// (see the reorder hazard on `contains_path` above).
let path_set_bucket_count = 64

fn path_set_hash(s: String) -> Int {
  let len = String::length(s)
  let mut h = 5381
  let mut i = 0
  while i < len {
    // djb2-xor, masked to 30 bits so `h * 33` stays far below the 61-bit
    // tagged-int range.
    h = ((h * 33)^String::char_code_at(s, i))&0x3FFFFFFF
    i = i + 1
  }
  h
}

export fn path_set_new() -> Array[Array[String]] {
  let buckets = array_empty()
  let mut i = 0
  while i < path_set_bucket_count {
    Array::push(buckets, array_empty())
    i = i + 1
  }
  buckets
}

export fn path_set_contains(set: Array[Array[String]], path: String) -> Bool {
  let bucket = Array::get(set, path_set_hash(path)&(path_set_bucket_count - 1))
  let mut i = 0
  let mut found = false
  while i < Array::length(bucket) && !found {
    if Array::get(bucket, i) == path {
      found = true
    } else {
      i = i + 1
    }
  }
  found
}

/// No membership check: callers gate on `path_set_contains` first (every
/// site below is check-then-add), so adding unconditionally here avoids a
/// second hash walk.
export fn path_set_add(set: Array[Array[String]], path: String) -> Unit {
  Array::push(Array::get(set, path_set_hash(path)&(path_set_bucket_count - 1)), path)
}

export fn normalize_path(path: String) -> String {
  let is_absolute = String::length(path) > 0 && String::char_code_at(path, 0) == 47
  let mut parts = array_empty()
  let len = String::length(path)
  let mut start = 0
  let mut i = 0
  while i <= len {
    let at_sep = if i == len {
      true
    } else {
      String::char_code_at(path, i) == 47
    }
    if at_sep {
      let part = path[start: i]
      let skip_part = if String::length(part) == 0 {
        true
      } else {
        part == "."
      }
      if skip_part {
        ()
      } else if part == ".." {
        // O(1) truncate vs. previous O(N) copy of `parts[0:N-1]` into a
        // fresh Array.
        if Array::length(parts) > 0 {
          Array::truncate(parts, Array::length(parts) - 1)
        }
      } else {
        Array::push(parts, part)
      }
      start = i + 1
    }
    i = i + 1
  }
  // Build the joined output via StringBuilder. The previous code did
  // `out = String::concat(out, ...)` in a loop, which is O(N²) over the
  // segment count because each concat allocates and copies the growing
  // string. Same shape as the StringBuilder migrations issue #366
  // tracks for the rest of this codebase.
  let buf = StringBuilder::new()
  if is_absolute {
    StringBuilder::push(buf, "/")
  }
  let mut pi = 0
  while pi < Array::length(parts) {
    if pi > 0 {
      StringBuilder::push(buf, "/")
    }
    StringBuilder::push(buf, Array::get(parts, pi))
    pi = pi + 1
  }
  StringBuilder::freeze(buf)
}

export fn get_export_name(items: Array[ImportItem], name: String) -> String {
  let mut result = name
  let mut i = 0
  while i < Array::length(items) {
    let item = Array::get(items, i)
    let iname = item.name
    let irename = item.alias
    if iname == name {
      match irename {
        Some(alias) => {
          result = alias
        },
        None => ()
      }
    }
    i = i + 1
  }
  result
}

fn join_relative_path(base_dir: String, raw_path: String) -> String {
  if base_dir == "" || base_dir == "/" {
    String::concat(base_dir, raw_path)
  } else {
    String::concat(base_dir, String::concat("/", raw_path))
  }
}

export fn path_to_module_name(path: String) -> String {
  let len = String::length(path)
  let mut last_slash = -1
  let mut i = 0
  while i < len {
    if String::char_code_at(path, i) == 47 {
      last_slash = i
    }
    i = i + 1
  }
  let base = if last_slash >= 0 {
    path[last_slash + 1: len]
  } else {
    path
  }
  let base_len = String::length(base)
  if String::ends_with(base, ".vibe") {
    base[0: base_len - 5]
  } else {
    base
  }
}

export fn path_has_relative_prefix(raw_path: String, len: Int) -> Bool {
  // Bare `.` / `..` are relative too: `import . { x }` targets the importing
  // file's own directory index. They were previously treated as workspace-
  // root-relative raw paths, so `.` normalized to "" and the first candidate
  // became ".vibe" — the workspace STORE DIRECTORY — which fs_read trapped on
  // with no diagnostic (EISDIR from the host).
  if raw_path == "." || raw_path == ".." {
    true
  } else if len >= 2 {
    if raw_path[0: 2] == "./" {
      true
    } else if len >= 3 {
      raw_path[0: 3] == "../"
    } else {
      false
    }
  } else {
    false
  }
}

export fn resolve_import_path(base_dir: String, raw_path: String) -> String {
  let len = String::length(raw_path)
  let joined = if path_has_relative_prefix(raw_path, len) {
    join_relative_path(base_dir, raw_path)
  } else {
    raw_path
  }
  let normalized = normalize_path(joined)
  if String::ends_with(normalized, ".vibe") {
    normalized
  } else {
    String::concat(normalized, ".vibe")
  }
}

/// #751 (ADR-0065): the private Env effect + checker-only discharge below
/// let this module read VIBE_LIB / VIBE_HOME / HOME without carrying an
/// `Env` row on every resolver in the loader chain: builtin `Env::get`
/// compiles to the env-get host import DIRECTLY, so the handler arm is never
/// invoked at runtime (same mechanism as the Fs handles in
/// fixtures/fs_readdir_test.vibe). The effect declaration is private —
/// nothing outside this module sees it.
effect Env {
  Get(String) -> String
}

fn env_get_raw(name: String) -> String with Env {
  Env::get(name)
}

fn read_env_discharged(name: String) -> String {
  handle {
    env_get_raw(name)
  } with Env {
    Get(_n) => resume("")
  }
}

fn strip_trailing_slash(p: String) -> String {
  let len = String::length(p)
  if len > 1 && String::ends_with(p, "/") {
    p[0: len - 1]
  } else {
    p
  }
}

/// #751 (ADR-0065): external library roots, PATH-style. Pure so it is
/// testable: VIBE_LIB (":"-separated, empty segments dropped) wins;
/// otherwise the default single root is $VIBE_HOME/lib, falling back to
/// $HOME/.vibe/lib. No environment at all -> no external roots
/// (workspace-only resolution).
export fn parse_vibe_lib_roots(vibe_lib: String, vibe_home: String, home: String) -> Array[String] {
  let roots = array_empty()
  if String::length(vibe_lib) > 0 {
    let parts = String::split(vibe_lib, ":")
    let mut i = 0
    while i < Array::length(parts) {
      let part = Array::get(parts, i)
      if String::length(part) > 0 {
        Array::push(roots, strip_trailing_slash(part))
      } else {
        ()
      }
      i = i + 1
    }
  } else if String::length(vibe_home) > 0 {
    Array::push(roots, String::concat(strip_trailing_slash(vibe_home), "/lib"))
  } else if String::length(home) > 0 {
    Array::push(roots, String::concat(strip_trailing_slash(home), "/.vibe/lib"))
  } else {
    ()
  }
  roots
}

export fn external_lib_roots() -> Array[String] {
  parse_vibe_lib_roots(read_env_discharged("VIBE_LIB"), read_env_discharged("VIBE_HOME"), read_env_discharged("HOME"))
}

/// #751: "is the environment flag set to 1" — the loader's freeze switch
/// (VIBE_REQUIRE_PINS) reads through the same checker-only discharge so its
/// signature stays effect-free.
export fn vibe_env_flag(name: String) -> Bool {
  read_env_discharged(name) == "1"
}

/// #758 review (P1): the RESOLUTION ENVIRONMENT as a cache-key seed. The
/// persistent header/dep-list/source-list caches store RESOLVED graphs, and
/// resolution depends on the external lib roots (#751) and the freeze switch
/// — a graph cached without pins under one VIBE_LIB must not be replayed
/// under VIBE_REQUIRE_PINS=1 or a different root list (the freeze gate and
/// the pin verification only run on the cold walk). Folding this seed into
/// the cache paths makes each environment its own cache universe instead of
/// re-verifying cached graphs on load.
export fn resolution_env_seed() -> String {
  let roots = external_lib_roots()
  let pins = if vibe_env_flag("VIBE_REQUIRE_PINS") {
    "1"
  } else {
    "0"
  }
  String::concat("|roots=", String::concat(String::join(roots, ":"), String::concat("|pins=", pins)))
}

export fn resolve_import_path_candidates(base_dir: String, raw_path: String) -> Array[String] {
  // #730 (ADR-0063 §5/§6): `@scope/name` package refs resolve to the
  // workspace store, laid out BY NAME and verified BY HASH against the
  // importer's require pin (verification happens in the loader; this
  // function stays pure). Root-relative, independent of base_dir.
  // #751 (ADR-0065): `lib/@scope/name` is the SECOND candidate — dev-mode
  // resolution for in-repo packages and the materialize target for
  // distributed ones. The pinned store wins when both exist; a lib/-resolved
  // package is a contract package like the store (index.vibei required,
  // boundary + conformance apply by path) but is NOT pin-verified — pins
  // stay mandatory on the store/release path only. External roots (VIBE_LIB,
  // default $VIBE_HOME/lib -> ~/.vibe/lib) come LAST, in list order — the
  // workspace always wins over the installation. Both runners' raw fs lanes
  // read absolute paths, so external roots need no extra preopen.
  if String::starts_with(raw_path, "@") {
    let candidates = array_empty()
    // #897 (ADR-0070 Phase 1): each root probes `.vpkg` (the target spelling)
    // BEFORE `.vibei` (legacy, still valid during the migration), so a
    // directory that has switched to `.vpkg` resolves without needing the
    // pin/verify lanes to change at all — only the candidate list grows.
    Array::push(candidates, String::concat(".vibe/store/", String::concat(raw_path, "/index.vpkg")))
    Array::push(candidates, String::concat(".vibe/store/", String::concat(raw_path, "/index.vibei")))
    Array::push(candidates, String::concat("lib/", String::concat(raw_path, "/index.vpkg")))
    Array::push(candidates, String::concat("lib/", String::concat(raw_path, "/index.vibei")))
    let roots = external_lib_roots()
    let mut ri = 0
    while ri < Array::length(roots) {
      Array::push(candidates, String::concat(Array::get(roots, ri), String::concat("/", String::concat(raw_path, "/index.vpkg"))))
      Array::push(candidates, String::concat(Array::get(roots, ri), String::concat("/", String::concat(raw_path, "/index.vibei"))))
      ri = ri + 1
    }
    return candidates
  } else ()
  let len = String::length(raw_path)
  let joined = if path_has_relative_prefix(raw_path, len) {
    join_relative_path(base_dir, raw_path)
  } else {
    raw_path
  }
  let normalized = normalize_path(joined)
  if String::ends_with(normalized, ".vibe") {
    [normalized]
  } else {
    // #729: a bare (directory-style) import may target a contract package —
    // `<dir>/index.vibei` (or, #897, `<dir>/index.vpkg`) is probed between
    // the plain-file and index.vibe forms. Existence-probing resolvers pick
    // it up when present; index-0 stays the plain-file form so no-match
    // fallbacks are unchanged. `.vpkg` is tried before `.vibei` (#897:
    // target spelling wins when a directory somehow has neither yet
    // resolved, matching the `@scope/name` root ordering above).
    [
      String::concat(normalized, ".vibe"),
      String::concat(normalized, "/index.vpkg"),
      String::concat(normalized, "/index.vibei"),
      String::concat(normalized, "/index.vibe")
    ]
  }
}

/// #1872 (#1770 Phase 2): the compiler's read-side source-access effect.
/// The FS lane discharges it with the real capability builtins
/// (`Fs::exists` / `Fs::read_file`) at the call boundary; an in-memory lane
/// (tests, LSP overlay) discharges the SAME code with a lookup handler, so
/// the two lanes can no longer drift (#729/#730/#740/#749 were all
/// lane-drift bugs). Read-only by design — cache writes stay on `Fs`
/// (see #1872 for the split rationale). Spelled `Source::*`, deliberately
/// NOT `Fs::*`: a fn occupying a capability-builtin name hijacks the
/// perform lowering (recorded in lib/@vibe/fs/index.vpkg).
export effect Source {
  Read(String) -> String
  Exists(String) -> Bool
}

/// #1872 pilot: THE import-path existence probe, unified from the three
/// byte-similar FS copies (loader/loader.vibe resolve_path_fs -- no
/// self-skip, pass self_path = ""; loader/header_cache.vibe resolve_path_fs
/// and wasi_only/merge_sources.vibe resolve_existing_import_path -- both
/// with the self-skip) which had already drifted once (the self_path skip
/// existed in two copies but not the third).
///
/// A directory-style import from a same-named facade file resolves its
/// plain-file candidate to the IMPORTING file itself (`export ./codegen`
/// inside codegen.vibe -> codegen.vibe): a self-dep is never meant, it only
/// manufactures "type_db: import cycle detected", so a candidate equal to
/// `self_path` is skipped. Falls back to the first non-self candidate so a
/// genuinely missing import still reports its plain-file path (and to
/// candidates[0] when every candidate was self).
export fn resolve_import_path_probe(base_dir: String, raw_path: String, self_path: String) -> String with Source {
  let candidates = resolve_import_path_candidates(base_dir, raw_path)
  let mut i = 0
  let mut found = ""
  let mut fallback = ""
  while i < Array::length(candidates) {
    let candidate = Array::get(candidates, i)
    if candidate == self_path {
      ()
    } else {
      if fallback == "" {
        fallback = candidate
      } else {
        ()
      }
      if found == "" && perform Source::Exists(candidate) {
        found = candidate
      } else {
        ()
      }
    }
    i = i + 1
  }
  if found == "" {
    if fallback == "" {
      Array::get(candidates, 0)
    } else {
      fallback
    }
  } else {
    found
  }
}
