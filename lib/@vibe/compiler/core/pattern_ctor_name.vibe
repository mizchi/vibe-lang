//# #3422: the name a constructor pattern resolves by

// The parser keeps the owner of a qualified `Some` / `None` pattern
// (`Maybe::Some`), so the checker can tell it from the builtin `Some` /
// `None` at that pattern. Every other reader -- the checker's pattern typing
// and exhaustiveness, the pre-codegen renames, and codegen's constructor
// table -- compares the bare variant name. Only those two suffixes are
// stripped, so a handler arm's `Ask::Get` is left as written.

/// The bare variant name of a constructor pattern's name.
export fn pattern_ctor_base_name(name: String) -> String {
  if String::length(name) > 6 && String::ends_with(name, "::Some") {
    "Some"
  } else if String::length(name) > 6 && String::ends_with(name, "::None") {
    "None"
  } else {
    name
  }
}

/// The owner a qualified `Some` / `None` pattern names (`Maybe` for
/// `Maybe::Some`), or "" for any other name.
export fn pattern_ctor_owner(name: String) -> String {
  if pattern_ctor_base_name(name) == name {
    ""
  } else {
    String::substring(name, 0, String::length(name) - 6)
  }
}
