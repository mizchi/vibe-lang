// lib/@vibe/compiler/core/trait_ref_aliases.vibe — an applied trait reference
// spelled through a local type alias (#3947).
//
// A trait key is the string `trait_ref_key` makes from the reference AS
// WRITTEN, and impls, bounds and the witnesses lowering synthesizes are all
// matched by that string. `impl Value[Alias] for Note` was recorded as
// `Value[Alias]` while the checker resolved the bound `[V: Value[Alias]]`
// through the alias to `Value[Int]`, so the call answered
// ``no impl `Value[Int]` for `Note` ``; spelling the impl `Value[Int]` instead
// passed the checker, and then the witness desugar, which matches the bound as
// written, found no method and asked for a body that was there.
//
// So every applied key a declaration in this module writes is put in one
// spelling first: each argument with the module's own `type` aliases
// expanded. Both the checker and the desugar run this before they read a key,
// so they compare the same strings, and running it twice changes nothing. A
// name a declaration binds as a type parameter is never expanded. An alias
// imported from another module is expanded when the caller passes it in
// (`canonicalize_trait_ref_aliases_with`, #3953): the checker's import-aware
// entry reads them from its projected environment, so `impl Value[Alias]`
// beside `import ./defs.vibe { Alias }` names the instantiation the checker
// resolves a bound to.
//
// An impl's methods are parsed into top-level bindings named after the impl's
// key (`impl_method_binding_name`), so an impl whose key changes has its
// methods renamed with it: a method left under the old owner is no longer the
// impl's, and its `self` loses the type the impl gives it.

import ./ast.vibe {
  Expr, Stmt, TypeExpr
}

import @vibe/core {
  array_empty
}

import @vibe/ast {
  impl_method_owner, trait_ref_from_key, trait_ref_key, type_param_name
}

//# Functions

/// Rewrite, in place, every applied trait key the top-level declarations of
/// `stmts` write -- an impl's trait and its parameter bounds, a function's
/// type-parameter bounds, a trait's supertraits and method bounds -- with the
/// module's own type aliases expanded in the trait's arguments.
export fn canonicalize_trait_ref_aliases(_ stmts: Array[Stmt]) -> Unit {
  canonicalize_trait_ref_aliases_with(stmts = stmts, imported = array_empty())
}

/// `canonicalize_trait_ref_aliases` with the aliases the module imports as
/// well, `(name, params, body)` under the name this module sees. The module's
/// own aliases come first, so a local declaration wins over an import.
export fn canonicalize_trait_ref_aliases_with(stmts: Array[Stmt], imported: Array[(String, Array[String], TypeExpr)]) -> Unit {
  let aliases = trait_ref_local_aliases(stmts)
  for alias in imported {
    Array::push(aliases, value = alias)
  }
  if Array::length(aliases) > 0 {
    // (old method-owner prefix, new one) for each impl whose key changed.
    let renames: Array[(String, String)] = array_empty()
    let mut i = 0
    while i < Array::length(stmts) {
      let stmt = Array::get(stmts, at = i)
      match trait_ref_alias_stmt(stmt = stmt, aliases = aliases) {
        Some(next) => {
          match (stmt, next) {
            (SImpl(tparams, _, old_key, target), SImpl(_, _, new_key, _)) => if old_key != new_key {
              Array::push(renames, value = (String::concat(impl_method_owner(tparams = tparams, trait_name = old_key, target = target), "::"), String::concat(impl_method_owner(tparams = tparams, trait_name = new_key, target = target), "::")))
            } else {
              ()
            },
            _ => ()
          }
          Array::set(stmts, at = i, value = next)
        },
        None => ()
      }
      i = i + 1
    }
    if Array::length(renames) > 0 {
      trait_ref_rename_impl_methods(stmts = stmts, renames = renames)
    } else {
      ()
    }
  } else {
    ()
  }
}

fn trait_ref_rename_impl_methods(stmts: Array[Stmt], renames: Array[(String, String)]) -> Unit {
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, at = i) {
      SLet(exported, recursive, name, ty, value) => match trait_ref_renamed(name = name, renames = renames) {
        Some(next) => Array::set(stmts, at = i, value = SLet(exported, recursive, next, ty, value)),
        None => ()
      },
      _ => ()
    }
    i = i + 1
  }
}

fn trait_ref_renamed(name: String, renames: Array[(String, String)]) -> Option[String] {
  let mut out: Option[String] = None
  for rename in renames {
    let (old_prefix, new_prefix) = rename
    if (out is None) && String::starts_with(name, prefix = old_prefix) {
      out = Some(String::concat(new_prefix, String::substring(name, start = String::length(old_prefix), end = String::length(name))))
    } else {
      ()
    }
  }
  out
}

fn trait_ref_local_aliases(_ stmts: Array[Stmt]) -> Array[(String, Array[String], TypeExpr)] {
  let out: Array[(String, Array[String], TypeExpr)] = array_empty()
  for stmt in stmts {
    match stmt {
      STypeAlias(_, name, params, target) => Array::push(out, value = (name, params, target)),
      _ => ()
    }
  }
  out
}

/// The statement with its keys canonical, or `None` when nothing changed.
fn trait_ref_alias_stmt(stmt: Stmt, aliases: Array[(String, Array[String], TypeExpr)]) -> Option[Stmt] {
  match stmt {
    SImpl(type_params, bounds, trait_name, target) => {
      let shadow = trait_ref_param_names(type_params)
      let key = trait_ref_alias_key(key = trait_name, aliases = aliases, shadow = shadow)
      let next_bounds = trait_ref_alias_bounds(bounds = bounds, aliases = aliases, shadow = shadow)
      if key == trait_name && trait_ref_bounds_same(a = next_bounds, b = bounds) {
        None
      } else {
        Some(SImpl(type_params, next_bounds, key, target))
      }
    },
    SLet(exported, recursive, name, ty, value) => match trait_ref_alias_fn(expr = value, aliases = aliases) {
      Some(next) => Some(SLet(exported, recursive, name, ty, next)),
      None => None
    },
    SFnDecl(exported, name, value, requires, ensures) => match trait_ref_alias_fn(expr = value, aliases = aliases) {
      Some(next) => Some(SFnDecl(exported, name, next, requires, ensures)),
      None => None
    },
    STrait(exported, name, supers, methods, method_generics, params) => {
      let shadow = trait_ref_param_names(params)
      let next_supers = for key in supers {
        trait_ref_alias_key(key = key, aliases = aliases, shadow = shadow)
      }
      let mut same = trait_ref_strings_same(a = next_supers, b = supers)
      let next_generics = for item in method_generics {
        let (method, tparams, mbounds) = item
        let inner = trait_ref_shadow_union(outer = shadow, inner = trait_ref_param_names(tparams))
        let next = trait_ref_alias_bounds(bounds = mbounds, aliases = aliases, shadow = inner)
        if !trait_ref_bounds_same(a = next, b = mbounds) {
          same = false
        } else {
          ()
        }
        (method, tparams, next)
      }
      if same {
        None
      } else {
        Some(STrait(exported, name, next_supers, methods, next_generics, params))
      }
    },
    _ => None
  }
}

/// A top-level function's type-parameter bounds, canonical.
fn trait_ref_alias_fn(expr: Expr, aliases: Array[(String, Array[String], TypeExpr)]) -> Option[Expr] {
  match expr {
    EFn(type_params, bounds, params, result, effect, body) => {
      let next_bounds = trait_ref_alias_bounds(bounds = bounds, aliases = aliases, shadow = trait_ref_param_names(type_params))
      if trait_ref_bounds_same(a = next_bounds, b = bounds) {
        None
      } else {
        Some(EFn(type_params, next_bounds, params, result, effect, body))
      }
    },
    _ => None
  }
}

fn trait_ref_alias_bounds(bounds: Array[(String, Array[String])], aliases: Array[(String, Array[String], TypeExpr)], shadow: Array[String]) -> Array[(String, Array[String])] {
  for bound in bounds {
    let (param, keys) = bound
    (param, for key in keys {
      trait_ref_alias_key(key = key, aliases = aliases, shadow = shadow)
    })
  }
}

/// The most type nodes one key's arguments may expand to. Past it the key is
/// left as written, and the checker's own alias preflight
/// (`alias_expansion_node_limit`) reports the expansion: a branching alias
/// (`type A1 = (A0, A0)` .. `A30`) is a few lines that expand to a billion
/// nodes, and this pass runs before that preflight (Codex on #3952).
let trait_ref_alias_node_budget = 4096

/// `key` with its trait's arguments expanded; a bare trait name, or a key
/// whose arguments name no alias, comes back unchanged.
fn trait_ref_alias_key(key: String, aliases: Array[(String, Array[String], TypeExpr)], shadow: Array[String]) -> String {
  match trait_ref_from_key(key) {
    Some(TyApp(name, args)) => {
      let budget = [trait_ref_alias_node_budget]
      let next = for arg in args {
        trait_ref_alias_expand(te = arg, aliases = aliases, shadow = shadow, fuel = 64, budget = budget)
      }
      // The expansion shares subtrees, so its size is counted before the key
      // spells every one of them out.
      for arg in next {
        trait_ref_count_nodes(te = arg, budget = budget)
      }
      if Array::get(budget, at = 0) <= 0 {
        key
      } else {
        // Compared as keys: the key string is the identity every consumer
        // matches by, and it is all that can tell an expansion happened.
        trait_ref_key(TyApp(name, next))
      }
    },
    _ => key
  }
}

/// Spend one node of `budget`; false once it is gone.
fn trait_ref_spend(_ budget: Array[Int]) -> Bool {
  let left = Array::get(budget, at = 0)
  if left <= 0 {
    false
  } else {
    Array::set(budget, at = 0, value = left - 1)
    true
  }
}

fn trait_ref_count_nodes(te: TypeExpr, budget: Array[Int]) -> Unit {
  if trait_ref_spend(budget) {
    match te {
      TyApp(_, args) => for arg in args {
        trait_ref_count_nodes(te = arg, budget = budget)
      },
      TyTuple(items) => for item in items {
        trait_ref_count_nodes(te = item, budget = budget)
      },
      TyFn(params, ret, _) => {
        for param in params {
          trait_ref_count_nodes(te = param, budget = budget)
        }
        trait_ref_count_nodes(te = ret, budget = budget)
      },
      _ => ()
    }
  } else {
    ()
  }
}

/// Expand every alias `te` names, recursively. `shadow` holds the type
/// parameters in scope where `te` is written, which are never expanded.
///
/// An alias's body is expanded in its OWN scope -- only its parameters are
/// bound there -- and the arguments, already expanded where they were
/// written, are substituted afterwards. Expanding the substituted body in the
/// caller's scope instead let a caller's parameter capture a name the body
/// meant as another alias: with `type A = Int` and `type B = A`, the bound
/// `Mark[B]` in `fn f[A, T: Mark[B]]` became `Mark[A]` (Codex on #3952).
///
/// `fuel` bounds an alias that (illegally) refers to itself, and `budget` the
/// total work (see `trait_ref_alias_node_budget`); whatever is left when
/// either runs out is kept as written.
fn trait_ref_alias_expand(te: TypeExpr, aliases: Array[(String, Array[String], TypeExpr)], shadow: Array[String], fuel: Int, budget: Array[Int]) -> TypeExpr {
  if fuel <= 0 || !trait_ref_spend(budget) {
    te
  } else {
    match te {
      TyName(name) => if trait_ref_names_contain(names = shadow, name = name) {
        te
      } else {
        match trait_ref_alias_lookup(aliases = aliases, name = name, arity = 0) {
          Some((_, target)) => trait_ref_alias_expand(te = target, aliases = aliases, shadow = array_empty(), fuel = fuel - 1, budget = budget),
          None => te
        }
      },
      TyApp(name, args) => {
        let next = for arg in args {
          trait_ref_alias_expand(te = arg, aliases = aliases, shadow = shadow, fuel = fuel - 1, budget = budget)
        }
        if trait_ref_names_contain(names = shadow, name = name) {
          TyApp(name, next)
        } else {
          match trait_ref_alias_lookup(aliases = aliases, name = name, arity = Array::length(next)) {
            Some((params, target)) => {
              let body = trait_ref_alias_expand(te = target, aliases = aliases, shadow = trait_ref_param_names(params), fuel = fuel - 1, budget = budget)
              trait_ref_substitute(te = body, params = params, args = next)
            },
            None => TyApp(name, next)
          }
        }
      },
      TyTuple(items) => TyTuple(for item in items {
        trait_ref_alias_expand(te = item, aliases = aliases, shadow = shadow, fuel = fuel - 1, budget = budget)
      }),
      TyFn(params, ret, effect) => TyFn(for param in params {
        trait_ref_alias_expand(te = param, aliases = aliases, shadow = shadow, fuel = fuel - 1, budget = budget)
      }, trait_ref_alias_expand(te = ret, aliases = aliases, shadow = shadow, fuel = fuel - 1, budget = budget), effect),
      TyUnit => TyUnit
    }
  }
}

fn trait_ref_alias_lookup(aliases: Array[(String, Array[String], TypeExpr)], name: String, arity: Int) -> Option[(Array[String], TypeExpr)] {
  let mut found: Option[(Array[String], TypeExpr)] = None
  for alias in aliases {
    let (alias_name, params, target) = alias
    if alias_name == name && Array::length(params) == arity && (found is None) {
      found = Some((params, target))
    } else {
      ()
    }
  }
  found
}

/// The argument an alias parameter named `name` stands for, if any.
fn trait_ref_param_arg(params: Array[String], args: Array[TypeExpr], name: String) -> Option[TypeExpr] {
  let mut out: Option[TypeExpr] = None
  let mut i = 0
  while i < Array::length(params) && i < Array::length(args) {
    if (out is None) && type_param_name(Array::get(params, at = i)) == name {
      out = Some(Array::get(args, at = i))
    } else {
      ()
    }
    i = i + 1
  }
  out
}

/// `te` with each of the alias's `params` replaced by the matching argument.
/// A parameter in a constructor position (`G` of `type Apply[G[_], A] =
/// G[A]`) is replaced as the head: `Apply[F, Int]` is `F[Int]`, not
/// `G[Int]` (Codex on #3952).
fn trait_ref_substitute(te: TypeExpr, params: Array[String], args: Array[TypeExpr]) -> TypeExpr {
  match te {
    TyName(name) => match trait_ref_param_arg(params = params, args = args, name = name) {
      Some(arg) => arg,
      None => te
    },
    TyApp(name, items) => {
      let next = for item in items {
        trait_ref_substitute(te = item, params = params, args = args)
      }
      match trait_ref_param_arg(params = params, args = args, name = name) {
        Some(TyName(head)) => TyApp(head, next),
        Some(TyApp(head, applied)) => TyApp(head, Array::concat(applied, next)),
        _ => TyApp(name, next)
      }
    },
    TyTuple(items) => TyTuple(for item in items {
      trait_ref_substitute(te = item, params = params, args = args)
    }),
    TyFn(fparams, ret, effect) => TyFn(for param in fparams {
      trait_ref_substitute(te = param, params = params, args = args)
    }, trait_ref_substitute(te = ret, params = params, args = args), effect),
    TyUnit => TyUnit
  }
}

fn trait_ref_strings_same(a: Array[String], b: Array[String]) -> Bool {
  if Array::length(a) != Array::length(b) {
    false
  } else {
    let mut same = true
    let mut i = 0
    while i < Array::length(a) {
      if Array::get(a, at = i) != Array::get(b, at = i) {
        same = false
      } else {
        ()
      }
      i = i + 1
    }
    same
  }
}

fn trait_ref_bounds_same(a: Array[(String, Array[String])], b: Array[(String, Array[String])]) -> Bool {
  if Array::length(a) != Array::length(b) {
    false
  } else {
    let mut same = true
    let mut i = 0
    while i < Array::length(a) {
      let (_, ka) = Array::get(a, at = i)
      let (_, kb) = Array::get(b, at = i)
      if !trait_ref_strings_same(a = ka, b = kb) {
        same = false
      } else {
        ()
      }
      i = i + 1
    }
    same
  }
}

fn trait_ref_param_names(_ params: Array[String]) -> Array[String] {
  for param in params {
    type_param_name(param)
  }
}

fn trait_ref_shadow_union(outer: Array[String], inner: Array[String]) -> Array[String] {
  let out: Array[String] = array_empty()
  for name in outer {
    Array::push(out, value = name)
  }
  for name in inner {
    Array::push(out, value = name)
  }
  out
}

fn trait_ref_names_contain(names: Array[String], name: String) -> Bool {
  let mut found = false
  for candidate in names {
    if candidate == name {
      found = true
    } else {
      ()
    }
  }
  found
}
