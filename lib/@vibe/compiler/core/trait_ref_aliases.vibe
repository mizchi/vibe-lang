// lib/@vibe/compiler/core/trait_ref_aliases.vibe -- one spelling for every
// applied trait key (#3947, #3953).
//
// A trait key is the string `trait_ref_key` makes from a reference, and impls,
// bounds and the witnesses lowering synthesizes are all matched by that
// string. So `impl Value[Alias] for Note` (`type Alias = Int`) and a bound
// `[V: Value[Int]]` have to reach every consumer as the same string, and so
// do `Unit` and `()`, or `StringMap[V]` and `Map[String, V]`.
//
// This pass rewrites, in place, every applied key the statements write --
// impl heads and bounds, trait supertraits and method bounds, function bounds,
// and the bounds of every lambda nested in an executable body -- through core's
// `canonical_trait_key`: each argument is resolved over the module's own type
// declarations (and, in the checker, the ones it imports) and written back. A
// name a declaration binds as a type parameter is that parameter, never an
// alias of its spelling. The checker runs it before it reads a key, and the
// desugar runs it once more over the merged program, so both compare the same
// strings; running it twice changes nothing.
//
// An impl's methods are parsed into top-level bindings named after the impl's
// key (`impl_method_owner`), so an impl whose key changes has its methods
// renamed with it: a method left under the old owner is no longer the impl's,
// and its `self` loses the type the impl gives it.

import ./ast.vibe {
  Expr, Pat, Stmt
}

import ./types_env_cache.vibe {
  TypeDef
}

import ./canonical_key_defs.vibe {
  canonical_key_defs_with
}

import ./types_unify.vibe {
  canonical_trait_key
}

import @vibe/ast {
  impl_method_owner, trait_ref_is_applied, type_param_name
}

//# Functions

/// Rewrite, in place, every applied trait key `stmts` write so each spells its
/// arguments canonically (see the file header), resolving them over the
/// module's own declarations.
export fn canonicalize_trait_ref_aliases(_ stmts: Array[Stmt]) -> Unit {
  canonicalize_trait_ref_aliases_with(stmts = stmts, imported = [])
}

/// `canonicalize_trait_ref_aliases` with the type definitions the module
/// imports as well (#3953). A type the module declares itself wins over an
/// import of the same name (`canonical_key_defs_with`).
export fn canonicalize_trait_ref_aliases_with(stmts: Array[Stmt], imported: Array[TypeDef]) -> Unit {
  // The definitions are built on the first applied key the pass meets: most
  // modules spell none, and those pay nothing for them.
  Array::truncate(trk_defs, length = 0)
  Array::truncate(trk_source, length = 0)
  Array::push(trk_source, value = (stmts, imported))
  trk_stmts(stmts)
  // The definitions stay for `canonical_program_trait_key`, which witness
  // generation asks later in the same run; the next run replaces them. The
  // program itself is not kept.
  Array::truncate(trk_source, length = 0)
}

/// The applied trait key `key` in the spelling the last
/// `canonicalize_trait_ref_aliases` run gave its program's keys, with
/// `binders` left as written. Witness narrowing substitutes a call's argument
/// types into the bound it requests, and an argument annotated
/// `StringMap[Int]` has to meet the impl spelled `Map[String, Int]` (Codex on
/// #3956).
export fn canonical_program_trait_key(key: String, binders: Array[String]) -> String {
  trk_key(key = key, names = binders)
}

let trk_defs: Array[Array[TypeDef]] = []

let trk_source: Array[(Array[Stmt], Array[TypeDef])] = []

fn trk_key_defs() -> Array[TypeDef] {
  if Array::length(trk_defs) == 0 {
    let built = if Array::length(trk_source) > 0 {
      let (stmts, imported) = Array::get(trk_source, at = 0)
      canonical_key_defs_with(stmts = stmts, imported = imported)
    } else {
      []
    }
    Array::push(trk_defs, value = built)
  } else {
    ()
  }
  Array::get(trk_defs, at = 0)
}

/// The pass over every top-level statement; an impl whose key changed has its
/// method bindings renamed after the loop.
fn trk_stmts(_ stmts: Array[Stmt]) -> Unit {
  let owner_renames: Array[(String, String)] = []
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, at = i) {
      SImpl(tparams, bounds, trait_name, target) => {
        let names = trk_param_names(tparams)
        let next_key = trk_key(key = trait_name, names = names)
        let next_bounds = trk_bounds(bounds = bounds, names = names)
        if next_key != trait_name || next_bounds != bounds {
          Array::set(stmts, at = i, value = SImpl(tparams, next_bounds, next_key, target))
        } else {
          ()
        }
        if next_key != trait_name {
          let before = impl_method_owner(tparams = tparams, trait_name = trait_name, target = target)
          let after = impl_method_owner(tparams = tparams, trait_name = next_key, target = target)
          if before != after {
            Array::push(owner_renames, value = (String::concat(before, "::"), String::concat(after, "::")))
          } else {
            ()
          }
        } else {
          ()
        }
      },
      // A trait's supertraits, and its methods' own binder bounds
      // (`run[T: Value[Alias]](Self, T)`), are matched against the same impls.
      STrait(exported, name, supers, methods, method_tparams, tparams) => {
        let names = trk_param_names(tparams)
        let next_supers = for key in supers {
          trk_key(key = key, names = names)
        }
        let next_rows = for row in method_tparams {
          let (mname, mtparams, mbounds) = row
          let inner = trk_param_names(tparams)
          for t in mtparams {
            Array::push(inner, value = type_param_name(t))
          }
          (mname, mtparams, trk_bounds(bounds = mbounds, names = inner))
        }
        if next_supers != supers || next_rows != method_tparams {
          Array::set(stmts, at = i, value = STrait(exported, name, next_supers, methods, next_rows, tparams))
        } else {
          ()
        }
      },
      // A function's bounds, and those of every lambda nested in a body
      // (`let inner = [V: Value[Alias]](v: V) -> ..`), in every statement that
      // holds an executable expression, as the dictionary rewriting visits
      // them (Codex on #3956).
      SLet(exported, is_rec, name, ty, body) => match trk_expr(e = body, names = [
      ]) {
        Some(next) => Array::set(stmts, at = i, value = SLet(exported, is_rec, name, ty, next)),
        None => ()
      },
      SFnDecl(exported, name, body, attrs, off) => match trk_expr(e = body, names = [
      ]) {
        Some(next) => Array::set(stmts, at = i, value = SFnDecl(exported, name, next, attrs, off)),
        None => ()
      },
      STest(label, body) => match trk_expr(e = body, names = []) {
        Some(next) => Array::set(stmts, at = i, value = STest(label, next)),
        None => ()
      },
      SLetMut(name, ty, body) => match trk_expr(e = body, names = []) {
        Some(next) => Array::set(stmts, at = i, value = SLetMut(name, ty, next)),
        None => ()
      },
      SBench(label, body) => match trk_expr(e = body, names = []) {
        Some(next) => Array::set(stmts, at = i, value = SBench(label, next)),
        None => ()
      },
      SExample(label, body) => match trk_expr(e = body, names = []) {
        Some(next) => Array::set(stmts, at = i, value = SExample(label, next)),
        None => ()
      },
      SExpr(body) => match trk_expr(e = body, names = []) {
        Some(next) => Array::set(stmts, at = i, value = SExpr(next)),
        None => ()
      },
      SLetPat(pat, body) => match trk_expr(e = body, names = []) {
        Some(next) => Array::set(stmts, at = i, value = SLetPat(pat, next)),
        None => ()
      },
      _ => ()
    }
    i = i + 1
  }
  if Array::length(owner_renames) > 0 {
    trk_rename_impl_methods(stmts = stmts, renames = owner_renames)
  } else {
    ()
  }
}

fn trk_param_names(_ params: Array[String]) -> Array[String] {
  for param in params {
    type_param_name(param)
  }
}

/// One key, canonical, with `names` (the binders in scope) kept as written.
fn trk_key(key: String, names: Array[String]) -> String {
  // A bare trait name has no argument to resolve; most keys are bare.
  if !trait_ref_is_applied(key) {
    key
  } else {
    canonical_trait_key(key = key, binders = names, defs = trk_key_defs())
  }
}

fn trk_bounds(bounds: Array[(String, Array[String])], names: Array[String]) -> Array[(String, Array[String])] {
  // Only an applied key can change, so bounds of bare trait names are kept
  // without rebuilding them.
  let mut applied = false
  for bound in bounds {
    let (_, traits) = bound
    for t in traits {
      if !applied && trait_ref_is_applied(t) {
        applied = true
      } else {
        ()
      }
    }
  }
  if applied {
    for bound in bounds {
      let (param, traits) = bound
      (param, for trait_ref in traits {
        trk_key(key = trait_ref, names = names)
      })
    }
  } else {
    bounds
  }
}

fn trk_rename_impl_methods(stmts: Array[Stmt], renames: Array[(String, String)]) -> Unit {
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, at = i) {
      SLet(exported, is_rec, name, ty, body) => match trk_renamed_owner(name = name, renames = renames) {
        Some(next) => Array::set(stmts, at = i, value = SLet(exported, is_rec, next, ty, body)),
        None => ()
      },
      SFnDecl(exported, name, body, attrs, off) => match trk_renamed_owner(name = name, renames = renames) {
        Some(next) => Array::set(stmts, at = i, value = SFnDecl(exported, next, body, attrs, off)),
        None => ()
      },
      _ => ()
    }
    i = i + 1
  }
}

fn trk_renamed_owner(name: String, renames: Array[(String, String)]) -> Option[String] {
  let mut out = None
  for row in renames {
    let (before, after) = row
    if out == None && String::starts_with(name, prefix = before) {
      out = Some(String::concat(after, String::substring(name, start = String::length(before), end = String::length(name))))
    } else {
      ()
    }
  }
  out
}

/// `e` with every lambda's bounds canonical, or None when nothing changed.
/// `names` are the binders in scope, which shadow an alias of their spelling.
fn trk_expr(e: Expr, names: Array[String]) -> Option[Expr] {
  match e {
    EFn(tp, bs, ps, ret, eff, body) => if Array::length(tp) == 0 && Array::length(bs) == 0 {
      // An ordinary lambda binds no type and asks for no witness: only its
      // body can change, under the same binders.
      match trk_expr(e = body, names = names) {
        Some(next) => Some(EFn(tp, bs, ps, ret, eff, next)),
        None => None
      }
    } else {
      let inner: Array[String] = []
      for n in names {
        Array::push(inner, value = n)
      }
      for t in tp {
        Array::push(inner, value = type_param_name(t))
      }
      let nb = trk_bounds(bounds = bs, names = inner)
      let nbody = trk_expr(e = body, names = inner)
      if nb != bs || trk_changed(nbody) {
        Some(EFn(tp, nb, ps, ret, eff, trk_or(o = nbody, e = body)))
      } else {
        None
      }
    },
    ETuple(items) => match trk_list(es = items, names = names) {
      Some(next) => Some(ETuple(next)),
      None => None
    },
    EArray(items) => match trk_list(es = items, names = names) {
      Some(next) => Some(EArray(next)),
      None => None
    },
    EContinue(items) => match trk_list(es = items, names = names) {
      Some(next) => Some(EContinue(next)),
      None => None
    },
    ERecord(n, fields, tas) => match trk_fields(fields = fields, names = names) {
      Some(next) => Some(ERecord(n, next, tas)),
      None => None
    },
    EMap(fields) => match trk_fields(fields = fields, names = names) {
      Some(next) => Some(EMap(next)),
      None => None
    },
    ELoop(binds, body) => {
      let nbinds = trk_fields(fields = binds, names = names)
      let nbody = trk_expr(e = body, names = names)
      if trk_changed(nbinds) || trk_changed(nbody) {
        Some(ELoop(match nbinds {
          Some(x) => x,
          None => binds
        }, trk_or(o = nbody, e = body)))
      } else {
        None
      }
    },
    EIf(c, t, el) => {
      let a = trk_expr(e = c, names = names)
      let b = trk_expr(e = t, names = names)
      let d = trk_expr(e = el, names = names)
      if trk_changed(a) || trk_changed(b) || trk_changed(d) {
        Some(EIf(trk_or(o = a, e = c), trk_or(o = b, e = t), trk_or(o = d, e = el)))
      } else {
        None
      }
    },
    ELet(n, v, b, off) => match trk_pair(a = v, b = b, names = names) {
      Some((x, y)) => Some(ELet(n, x, y, off)),
      None => None
    },
    ELetRec(n, v, b) => match trk_pair(a = v, b = b, names = names) {
      Some((x, y)) => Some(ELetRec(n, x, y)),
      None => None
    },
    ELetMut(n, v, b, off) => match trk_pair(a = v, b = b, names = names) {
      Some((x, y)) => Some(ELetMut(n, x, y, off)),
      None => None
    },
    EAssign(n, v, c, off) => match trk_pair(a = v, b = c, names = names) {
      Some((x, y)) => Some(EAssign(n, x, y, off)),
      None => None
    },
    EAssignOp(n, op, v, c, off) => match trk_pair(a = v, b = c, names = names) {
      Some((x, y)) => Some(EAssignOp(n, op, x, y, off)),
      None => None
    },
    ESeq(a, b) => match trk_pair(a = a, b = b, names = names) {
      Some((x, y)) => Some(ESeq(x, y)),
      None => None
    },
    EWhile(c, b) => match trk_pair(a = c, b = b, names = names) {
      Some((x, y)) => Some(EWhile(x, y)),
      None => None
    },
    EBinOp(op, l, r, off) => match trk_pair(a = l, b = r, names = names) {
      Some((x, y)) => Some(EBinOp(op, x, y, off)),
      None => None
    },
    EForIn(n, idx, it, b) => match trk_pair(a = it, b = b, names = names) {
      Some((x, y)) => Some(EForIn(n, idx, x, y)),
      None => None
    },
    EMatch(sc, arms) => {
      let a = trk_expr(e = sc, names = names)
      let narms = trk_arms(arms = arms, names = names)
      if trk_changed(a) || trk_changed(narms) {
        Some(EMatch(trk_or(o = a, e = sc), match narms {
          Some(x) => x,
          None => arms
        }))
      } else {
        None
      }
    },
    EHandle(body, arms) => {
      let a = trk_expr(e = body, names = names)
      let narms = trk_arms(arms = arms, names = names)
      if trk_changed(a) || trk_changed(narms) {
        Some(EHandle(trk_or(o = a, e = body), match narms {
          Some(x) => x,
          None => arms
        }))
      } else {
        None
      }
    },
    ECall(callee, args, off, cell) => {
      let a = trk_expr(e = callee, names = names)
      let nargs = trk_list(es = args, names = names)
      if trk_changed(a) || trk_changed(nargs) {
        Some(ECall(trk_or(o = a, e = callee), match nargs {
          Some(x) => x,
          None => args
        }, off, cell))
      } else {
        None
      }
    },
    EUnaryOp(op, x) => match trk_expr(e = x, names = names) {
      Some(next) => Some(EUnaryOp(op, next)),
      None => None
    },
    EDot(o, f, o1, o2) => match trk_expr(e = o, names = names) {
      Some(next) => Some(EDot(next, f, o1, o2)),
      None => None
    },
    ELabeledArg(l, n, v) => match trk_expr(e = v, names = names) {
      Some(next) => Some(ELabeledArg(l, n, next)),
      None => None
    },
    EReturn(x) => match trk_expr(e = x, names = names) {
      Some(next) => Some(EReturn(next)),
      None => None
    },
    ESpread(x) => match trk_expr(e = x, names = names) {
      Some(next) => Some(ESpread(next)),
      None => None
    },
    EBreak(Some(x)) => match trk_expr(e = x, names = names) {
      Some(next) => Some(EBreak(Some(next))),
      None => None
    },
    _ => None
  }
}

fn trk_changed[X](_ o: Option[X]) -> Bool {
  match o {
    Some(_) => true,
    None => false
  }
}

fn trk_or(o: Option[Expr], e: Expr) -> Expr {
  match o {
    Some(x) => x,
    None => e
  }
}

fn trk_pair(a: Expr, b: Expr, names: Array[String]) -> Option[(Expr, Expr)] {
  let na = trk_expr(e = a, names = names)
  let nb = trk_expr(e = b, names = names)
  if trk_changed(na) || trk_changed(nb) {
    Some((trk_or(o = na, e = a), trk_or(o = nb, e = b)))
  } else {
    None
  }
}

fn trk_list(es: Array[Expr], names: Array[String]) -> Option[Array[Expr]] {
  // Allocates only from the first element that changes.
  let n = Array::length(es)
  let mut i = 0
  let mut first: Option[Expr] = None
  while i < n && !trk_changed(first) {
    first = trk_expr(e = Array::get(es, at = i), names = names)
    if !trk_changed(first) {
      i = i + 1
    }
  }
  match first {
    None => None,
    Some(changed) => {
      let out: Array[Expr] = []
      let mut j = 0
      while j < i {
        Array::push(out, value = Array::get(es, at = j))
        j = j + 1
      }
      Array::push(out, value = changed)
      j = i + 1
      while j < n {
        let x = Array::get(es, at = j)
        Array::push(out, value = trk_or(o = trk_expr(e = x, names = names), e = x))
        j = j + 1
      }
      Some(out)
    }
  }
}

fn trk_fields(fields: Array[(String, Expr)], names: Array[String]) -> Option[Array[(String, Expr)]] {
  let n = Array::length(fields)
  let mut i = 0
  let mut first: Option[Expr] = None
  while i < n && !trk_changed(first) {
    let (_, x) = Array::get(fields, at = i)
    first = trk_expr(e = x, names = names)
    if !trk_changed(first) {
      i = i + 1
    }
  }
  match first {
    None => None,
    Some(changed) => {
      let out: Array[(String, Expr)] = []
      let mut j = 0
      while j < i {
        Array::push(out, value = Array::get(fields, at = j))
        j = j + 1
      }
      let (name_i, _) = Array::get(fields, at = i)
      Array::push(out, value = (name_i, changed))
      j = i + 1
      while j < n {
        let (fname, x) = Array::get(fields, at = j)
        Array::push(out, value = (fname, trk_or(o = trk_expr(e = x, names = names), e = x)))
        j = j + 1
      }
      Some(out)
    }
  }
}

fn trk_arms(arms: Array[(Pat, Expr)], names: Array[String]) -> Option[Array[(Pat, Expr)]] {
  let n = Array::length(arms)
  let mut i = 0
  let mut first: Option[Expr] = None
  while i < n && !trk_changed(first) {
    let (_, x) = Array::get(arms, at = i)
    first = trk_expr(e = x, names = names)
    if !trk_changed(first) {
      i = i + 1
    }
  }
  match first {
    None => None,
    Some(changed) => {
      let out: Array[(Pat, Expr)] = []
      let mut j = 0
      while j < i {
        Array::push(out, value = Array::get(arms, at = j))
        j = j + 1
      }
      let (pat_i, _) = Array::get(arms, at = i)
      Array::push(out, value = (pat_i, changed))
      j = i + 1
      while j < n {
        let (p, x) = Array::get(arms, at = j)
        Array::push(out, value = (p, trk_or(o = trk_expr(e = x, names = names), e = x)))
        j = j + 1
      }
      Some(out)
    }
  }
}
