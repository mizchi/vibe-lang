/// The labels of builtin `name`, `_` for a positional slot; `None` when the
/// builtin has no row, in which case every label on a call to it is refused.
/// A legacy spelling (`Fs::ReadFile`) answers for its canonical name, the way
/// `lookup_builtin` resolves it.
export fn builtin_param_labels(raw: String) -> Option[Array[String]] {
  let name = canonical_builtin_name(raw)
  let mut found = None
  let mut i = 0
  while i < Array::length(builtin_param_label_rows) {
    let (n, labels) = Array::get(builtin_param_label_rows, i)
    if n == name {
      found = Some(labels)
      i = Array::length(builtin_param_label_rows)
    } else {
      i = i + 1
    }
  }
  found
}

/// Every name the table covers, in table order, for the census test.
export fn builtin_param_label_names() -> Array[String] {
  let out = array_empty()
  for row in builtin_param_label_rows {
    let (n, _) = row
    Array::push(out, n)
  }
  out
}
