//# Imports

import @vibe/core {
  array_empty
}

import ./builtin_name.vibe {
  canonical_builtin_name
}

//# Functions

// ADR-0120 Phase 1a (#3659): each builtin's parameter labels, in declared
// order. `_` marks a positional slot -- it takes no label. A builtin has no
// source declaration to read names from, so this table is where they live.
//
// The rule for `_` is ADR-0120 D3's, applied mechanically:
//   - the receiver of a `T::f` (`Array::get(_, at)`);
//   - the only argument of a one-parameter function (`String::length(_)`);
//   - the operands of a symmetric or operator-like function
//     (`String::concat(_, _)`, `eq(_, _)`, `add(_, _)`);
//   - every parameter of an internal hook (`vibe_*_raw`, `simd_*`, `__*`),
//     which no program is meant to call by name.
// Every other parameter is labeled with its role (`at`, `value`, `start`,
// `end`, `sep`, `needle`, ...).
//
// The labels are public API (ADR-0120 D6): renaming one breaks every call
// that writes it. tests/builtin_param_labels_test.vibe holds the table to the
// builtins' signatures -- every checker-visible registry row has a row here,
// and every row's arity matches the builtin's type. A builtin with no row
// keeps refusing every label (#3651), so a gap fails closed.
//
// Enum constructors (`Some`, `None`) and the codegen intrinsics the parser
// synthesizes (`__index`, `__rec_field`, `__set_field`, `__exn_kind`,
// `__exn_message`) have no row on purpose: they are positional by
// construction.
let builtin_param_label_rows: Array[(String, Array[String])] = [
  // Env
  ("Env::get", ["_"]),
  ("Env::args_len", []),
  ("Env::args_get", ["_"]),
  // Fs
  ("Fs::read_file", ["_"]),
