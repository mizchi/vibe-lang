export fn array_has_int(arr: Array[Int], val: Int, i: Int) -> Bool {
  if i >= Array::length(arr) {
    false
  }
  else if Array::get(arr, at = i) == val {
    true
  }
  else array_has_int(arr = arr, val = val, i = i + 1)
}

fn int_array_has(arr: Array[Int], v: Int) -> Bool {
  let slen = Array::length(arr)
  let mut si = 0
  let mut sfound = false
  let mut sdone = false
  while !sdone {
    if si >= slen {
      sdone = true
    } else if Array::get(arr, at = si) == v {
      sfound = true
      sdone = true
    } else {
      si = si + 1
    }
  }
  sfound
}

/// A row minted by `instantiate` (`$N`), as opposed to a source binder (`e`).
/// `is_effect_var_name` accepts both, which is right where the question is
/// "is this a variable at all" and wrong where it is "may this binding be
/// undone" -- undoing a source-to-source unification loses a constraint the
/// body proved.
fn is_fresh_effect_var_name(_ name: String) -> Bool {
  String::length(name) >= 2 && String::char_code_at(name, at = 0) == 36
}

fn is_effect_var_name(_ name: String) -> Bool {
  let len = String::length(name)
  if len == 1 {
    // a source-level effect variable: a single lowercase letter (`with e`)
    String::char_code_at(name, at = 0) >= 97 && String::char_code_at(name, at = 0) <= 122
  } else if len >= 2 {
    // a FRESH effect variable minted by `instantiate` (`$N`): no real effect
    // name starts with `$`, so this marker is unambiguous.
    String::char_code_at(name, at = 0) == 36
  } else {
    false
  }
}

/// #3589: the row variable a type argument stands for, when it is one: a
/// struct's row parameter is passed a row as `CtNamed(<row>, [])`, so
/// `Holder[e]` carries `e` (or the fresh `$N` a call renamed it to).
export fn row_var_type_arg(_ t: Type) -> Option[String] {
  match t {
    CtNamed(n, args) => if Array::length(args) == 0 && is_effect_var_name(n) {
      Some(n)
    } else {
      None
    },
    _ => None
  }
}

/// Resolve an effect variable name through the effect-binding chain (transitively
/// following var->var links). Returns the bound effect-label string ("" = pure)
/// or None if the variable is unbound.
fn subst_eff_lookup(s: Subst, name: String) -> Option[String] {
  let mut cur = s
  let mut out = None
  let mut done = false
  while !done {
    match cur {
      SubstEmpty => {
        done = true
      },
      SubstBind(_, _, rest) => {
        cur = rest
      },
      SubstBound(_, _, rest) => {
        cur = rest
      },
      SubstValueRange(_, rest) => {
        cur = rest
      },
      SubstCached(_, _, rest) => {
        cur = rest
      },
      SubstEffBind(v, val, rest) => if v == name {
        out = Some(val)
        done = true
      } else {
        cur = rest
      }
    }
  }
  match out {
    Some(val) => if is_effect_var_name(val) {
      match subst_eff_lookup(s = s, name = val) {
        Some(v2) => Some(v2),
        None => Some(val)
      }
    } else {
      Some(val)
    },
    None => None
  }
}

/// One link of the effect-binding chain: the row `name` is bound to directly,
/// without following a variable that row names. None when `name` is unbound.
/// A caller that must stop at a source variable (`e`) reads the chain with
/// this, because a source variable is spelled alike in every signature and its
/// binding in a program-wide substitution may be another function's.
export fn subst_eff_binding(s: Subst, name: String) -> Option[String] {
  let mut cur = s
  let mut out = None
  let mut done = false
  while !done {
    match cur {
      SubstEmpty => {
        done = true
      },
      SubstBind(_, _, rest) => {
        cur = rest
      },
      SubstBound(_, _, rest) => {
        cur = rest
      },
      SubstValueRange(_, rest) => {
        cur = rest
      },
      SubstCached(_, _, rest) => {
        cur = rest
      },
      SubstEffBind(v, val, rest) => if v == name {
        out = Some(val)
        done = true
      } else {
        cur = rest
      }
    }
  }
  out
}

/// The labels the row variable `label` stands for, pushed onto `resolved`.
/// #3575: a variable bound to an OPEN row (`e := Fs, $9`) passes on the
/// variable that row ends in, which may itself be bound by now, so each such
/// variable is resolved in turn (`fuel` bounds a cyclic chain).
fn push_resolved_effect_var(s: Subst, label: String, resolved: Array[String], fuel: Int) -> Unit {
  match subst_eff_lookup(s = s, name = label) {
    Some(bound) => if String::length(bound) > 0 {
      for part in String::split(bound, sep = ",") {
        let trimmed = String::trim(part)
        if String::length(trimmed) == 0 {
          ()
        } else if fuel > 0 && trimmed != label && is_effect_var_name(trimmed) {
          push_resolved_effect_var(s = s, label = trimmed, resolved = resolved, fuel = fuel - 1)
        } else {
          Array::push(resolved, value = trimmed)
        }
      }
      ()
    },
    None => Array::push(resolved, value = label)
  }
}

/// Resolve a CtFn effect annotation through the effect-binding chain: a bound
/// effect variable becomes its binding (an empty binding "" collapses to the
/// pure row `None`); anything else is returned unchanged.
fn resolve_effect_opt(s: Subst, eff: Option[String]) -> Option[String] {
  match eff {
    None => eff,
    Some(row) => if String::index_of(row, needle = ",") < 0 && String::trim(row) == row && !is_effect_var_name(row) && !String::starts_with(row, prefix = "#capture[") {
      eff
    } else {
      let labels = String::split(row, sep = ",")
      let resolved = array_empty()
      let mut i = 0
      while i < Array::length(labels) {
        let label = String::trim(Array::get(labels, at = i))
        if is_effect_var_name(label) {
          push_resolved_effect_var(s = s, label = label, resolved = resolved, fuel = 16)
        } else if String::starts_with(label, prefix = "#capture[") {
          let close = String::index_of(label, needle = "]")
          let mut id = 0
          let mut p = 9
          while p < close {
            id = id * 10 + (String::char_code_at(label, at = p) - 48)
            p = p + 1
          }
          match subst_lookup(s = s, id = id) {
            Some(bound_ty) => {
              let resolved_ty = subst_apply(s = s, ty = bound_ty)
              let region_names = array_empty()
              collect_region_skolems_in_type(ty = resolved_ty, out = region_names)
              if Array::length(region_names) > 0 {
                for region_name in region_names {
                  if !string_array_contains(items = resolved, wanted = region_name) {
                    Array::push(resolved, value = region_name)
                  }
                }
              } else match resolved_ty {
                CtVar(new_id) => Array::push(resolved, value = String::concat("#capture[", String::concat(__to_string(new_id), "]"))),
                _ => ()
              }
            },
            None => Array::push(resolved, value = label)
          }
        } else if String::length(label) > 0 {
          Array::push(resolved, value = label)
        }
        i = i + 1
      }
      if Array::length(resolved) == 0 {
        None
      } else {
        Some(String::join(resolved, sep = ", "))
      }
    }
  }
}

/// Apply the closed part of an effect substitution while publishing a generic
/// scheme. A source binder can temporarily unify with a fresh inference row
/// (`e -> $82`) while its body is checked; publishing `$82` loses the binder
/// that `instantiate` must freshen at each call site. Preserve the original
/// label for every still-open result, while retaining concrete labels learned
/// beside it. A fully closed binding (`e -> Log`) is applied normally.
export fn resolve_effect_opt_preserving_open(s: Subst, eff: Option[String]) -> Option[String] {
  match eff {
    None => None,
    Some(row) => {
      let out = array_empty()
      for raw in String::split(row, sep = ",") {
        let original = String::trim(raw)
        match resolve_effect_opt(s = s, eff = Some(original)) {
          Some(resolved_row) => for resolved_raw in String::split(resolved_row, sep = ",") {
            let resolved = String::trim(resolved_raw)
            // Restore the source spelling ONLY over a fresh `$N`. When one
            // source binder resolves to ANOTHER source binder, the body proved
            // they are the same row, and republishing the original made them
            // independent again:
            //
            //   fn cast[T, e, f](g: (T) -> T with e) -> (T) -> T with f { g }
            //
            // published `with e` for the argument and `with f` for the result,
            // so a caller could bind the callback to one concrete effect and
            // the value it returns to another -- misrepresenting the
            // callback's authority, with no diagnostic (Codex review).
            let published = if is_effect_var_name(original) && is_fresh_effect_var_name(resolved) {
              original
            } else {
              resolved
            }
            if String::length(published) > 0 && !string_array_contains(items = out, wanted = published) {
              Array::push(out, value = published)
            } else {
              ()
            }
          },
          None => ()
        }
      }
      if Array::length(out) == 0 {
        None
      } else {
        Some(String::join(out, sep = ", "))
      }
    }
  }
}

/// Region provenance is carried in a function's checked row as an internal
/// unforgeable label. It is not a runtime effect: the row is simply the one
/// structured slot already preserved by substitution, generalization and
/// containers. `#capture[n]` is dependent on inference variable n and becomes
/// the concrete `#region_n` label when that variable is unified with a
/// region-tagged type.
fn string_array_contains(items: Array[String], wanted: String) -> Bool {
  let mut found = false
  for item in items {
    if item == wanted {
      found = true
    }
  }
  found
}

fn collect_region_skolems_in_type(ty: Type, out: Array[String]) -> Unit {
  match ty {
    CtNamed(name, args) => if String::starts_with(name, prefix = "#region_") {
      if !string_array_contains(items = out, wanted = name) {
        Array::push(out, value = name)
      }
    } else {
      for arg in args {
        collect_region_skolems_in_type(ty = arg, out = out)
      }
    },
    CtFn(params, ret, eff) => {
      match eff {
        Some(row) => {
          for raw in String::split(row, sep = ",") {
            let label = String::trim(raw)
            if String::starts_with(label, prefix = "#region_") && !string_array_contains(items = out, wanted = label) {
              Array::push(out, value = label)
            }
          }
        },
        None => ()
      }
      for param in params {
        collect_region_skolems_in_type(ty = param, out = out)
      }
      collect_region_skolems_in_type(ty = ret, out = out)
    },
    CtArray(elem) => collect_region_skolems_in_type(ty = elem, out = out),
    CtOption(elem) => collect_region_skolems_in_type(ty = elem, out = out),
    CtTuple(items) => {
      for item in items {
        collect_region_skolems_in_type(ty = item, out = out)
      }
    },
    CtRecord(fields) => {
      for field in fields {
        let (_, field_ty) = field
        collect_region_skolems_in_type(ty = field_ty, out = out)
      }
    },
    CtForAll(_, _, body) => collect_region_skolems_in_type(ty = body, out = out),
    _ => ()
  }
}

/// #2158: does `ty` resolve to `Double` under `s`, WITHOUT building the
/// substituted type?
///
/// `subst_apply` below answers the same question, but it rebuilds the whole
/// type structure to do it: for a call result that resolves to a function type
/// or a parameterized nominal, that is a full recursive allocation discarded
/// one comparison later. The Double call-result observation asks this question
/// once per located call result, so on a merged program the size of the
/// compiler the rebuild dominated everything -- measured on
/// `lib/@vibe/compiler/tests/compiler_fs_test.vibe`, whose import closure is
/// the whole compiler: 6.1s to compile before the observation was wired in,
/// 77.5s with it going through `subst_apply`.
///
/// Following the VARIABLE chain is the whole job. `CtDouble` takes no
/// arguments, so a type that is not already `CtDouble` at its head cannot
/// become one by substituting inside it -- there is nothing below the head to
/// look at. Cycle handling matches `subst_apply`'s: a variable already seen
/// ends the walk instead of looping.
export fn subst_resolves_to_double(s: Subst, ty: Type) -> Bool {
  let mut cur = ty
  let seen = array_empty()
  let mut done = false
  let mut result = false
  while !done {
    match cur {
      CtDouble => {
        result = true
        done = true
      },
      // #3543: a `Float` is held exactly as a `Double` is (an f64 whose value
      // is an f32), so every consumer of this head query -- the codegen
      // float classifiers, above all -- must treat it as one.
      CtFloat => {
        result = true
        done = true
      },
      CtVar(vid) => if int_array_has(arr = seen, v = vid) {
        done = true
      } else {
        Array::push(seen, value = vid)
        match subst_lookup(s = s, id = vid) {
          Some(next) => {
            cur = next
          },
          None => {
            done = true
          }
        }
      },
      _ => {
        done = true
      }
    }
  }
  result
}

/// #2391 slice 2: the String sibling of the head query above, with the same
/// cost contract -- follow the variable chain only, never rebuild the type.
/// `CtString` takes no arguments, so a type that is not `CtString` at its
/// head cannot become one by substituting inside it. A String reached only
/// through a type alias head stays unclassified; the consumer degrades to the
/// syntactic classifier for that site, which can miss but never answer wrong.
export fn subst_resolves_to_string(s: Subst, ty: Type) -> Bool {
  let mut cur = ty
  let seen = array_empty()
  let mut done = false
  let mut result = false
  while !done {
    match cur {
      CtString => {
        result = true
        done = true
      },
      CtVar(vid) => if int_array_has(arr = seen, v = vid) {
        done = true
      } else {
        Array::push(seen, value = vid)
        match subst_lookup(s = s, id = vid) {
          Some(next) => {
            cur = next
          },
          None => {
            done = true
          }
        }
      },
      _ => {
        done = true
      }
    }
  }
  result
}

export fn subst_apply(s: Subst, ty: Type) -> Type {
  match ty {
    CtInt => ty,
    CtInt32 => ty,
    CtUInt32 => ty,
    CtBool => ty,
    CtString => ty,
    CtUnit => ty,
    CtDouble => ty,
    CtFloat => ty,
    CtChar => ty,
    CtBytes => ty,
    CtUnknown => ty,
    CtConstructor(_, _) => ty,
    CtVar(first_id) => {
      // The common missing/one-hop case cannot form a variable cycle.
      // Allocate the cycle-detection scratch only for a variable-to-variable
      // chain; the established loop below still handles those chains.
      match subst_lookup(s = s, id = first_id) {
        None => return ty,
        Some(next) => match next {
          CtVar(_) => (),
          _ => return subst_apply(s = s, ty = next)
        }
      }
      let mut cur = ty
      let mut out = ty
      let mut done = false
      let mut seen = array_empty()
      while !done {
        match cur {
          CtVar(vid) => if int_array_has(arr = seen, v = vid) {
            out = cur
            done = true
          } else {
            Array::push(seen, value = vid)
            match subst_lookup(s = s, id = vid) {
              Some(next) => {
                cur = next
                out = next
              },
              None => {
                out = cur
                done = true
              }
            }
          },
          _ => {
            out = subst_apply(s = s, ty = cur)
            done = true
          }
        }
      }
      out
    },
    CtFn(params, ret, effect_name) => {
      let applied: Array[Type] = Array::with_capacity(Array::length(params))
      let mut i = 0
      while i < Array::length(params) {
        Array::push(applied, value = subst_apply(s = s, ty = Array::get(params, at = i)))
        i = i + 1
      }
      CtFn(applied, subst_apply(s = s, ty = ret), resolve_effect_opt(s = s, eff = effect_name))
    },
    CtArray(elem) => CtArray(subst_apply(s = s, ty = elem)),
    CtOption(elem) => CtOption(subst_apply(s = s, ty = elem)),
    CtApplied(head, args) => apply_type_constructor(head = subst_apply(s = s, ty = head), args = for arg in args {
      subst_apply(s = s, ty = arg)
    }),
    CtTuple(elems) => CtTuple(for e in elems {
      subst_apply(s = s, ty = e)
    }),
    CtRecord(rfields) => CtRecord(for rf in rfields {
      let (rfn, rft) = rf
      (rfn, subst_apply(s = s, ty = rft))
    }),
    CtNamed(name, args) => zonk_hkt(CtNamed(name, for arg in args {
      match row_var_type_arg(arg) {
        Some(v) => resolve_row_type_arg(arg = arg, resolved = resolve_effect_opt(s = s, eff = Some(v))),
        None => subst_apply(s = s, ty = arg)
      }
    })),
    CtForAll(_, _, _) => ty,
    _ => ty
  }
}

/// #3589: a row argument (`Holder[$4]`) after its row variable is resolved
/// the way a function's `with $4` is: the labels it is bound to
/// (`Holder[Console]`, the shape a literal storing `run: noisy` has before
/// generalization reads it). Without this, `generalize` published the bound
/// `$4` as a free row, `instantiate` freshened it, and `(make().run)()` in a
/// pure function ran `Console` uncharged. A variable bound to the pure row
/// stays as it was: no argument spells the pure row.
export fn resolve_row_type_arg(arg: Type, resolved: Option[String]) -> Type {
  match resolved {
    Some(row) => CtNamed(row, array_empty()),
    None => arg
  }
}

export fn trait_defined(env: TypeEnv, name: String) -> Bool {
  match env {
    EnvEmpty => false,
    EnvBind(_, _, rest) => trait_defined(env = rest, name = name),
    EnvTraitDef(tname, _, _, _, rest, _, _) => if tname == trait_ref_name(name) {
      true
    } else trait_defined(env = rest, name = name),
    EnvTraitImpl(_, _, rest) => trait_defined(env = rest, name = name),
    EnvShowWrappers(_, _, rest) => trait_defined(env = rest, name = name),
    EnvMutCell(_, _, rest) => trait_defined(env = rest, name = name),
    EnvTraitImplGen(_, _, _, _, rest) => trait_defined(env = rest, name = name),
    EnvTypeDefs(_, _, rest) => trait_defined(env = rest, name = name),
    EnvFlat(_) => false,
    EnvCached(_, _, rest) => trait_defined(env = rest, name = name)
  }
}

/// Every trait name the chain defines, innermost first, in one walk. The
/// answer to `trait_defined(env, n)` for any `n` is whether this list holds
/// `trait_ref_name(n)`; a caller with many names to ask (the import
/// projection asks per imported name, per bound label and per supertrait)
/// walks the chain once and probes the list instead of walking it per name
/// (#2386). Stops where trait_defined stops: an EnvFlat is terminal.
export fn env_trait_def_names(_ env: TypeEnv) -> Array[String] {
  let out = array_empty()
  env_trait_def_names_into(env = env, out = out)
  out
}

/// env_trait_def_names into a caller-owned row: `out` is emptied and refilled,
/// so a caller that asks per edge can reuse one row and allocate nothing.
export fn env_trait_def_names_into(env: TypeEnv, out: Array[String]) -> Unit {
  Array::truncate(out, length = 0)
  let mut cur = env
  let mut done = false
  while !done {
    match cur {
      EnvEmpty => {
        done = true
      },
      EnvBind(_, _, rest) => {
        cur = rest
      },
      EnvTraitDef(tname, _, _, _, rest, _, _) => {
        Array::push(out, value = tname)
        cur = rest
      },
      EnvTraitImpl(_, _, rest) => {
        cur = rest
      },
      EnvShowWrappers(_, _, rest) => {
        cur = rest
      },
      EnvMutCell(_, _, rest) => {
        cur = rest
      },
      EnvTraitImplGen(_, _, _, _, rest) => {
        cur = rest
      },
      EnvTypeDefs(_, _, rest) => {
        cur = rest
      },
      EnvFlat(_) => {
        done = true
      },
      EnvCached(_, _, rest) => {
        cur = rest
      }
    }
  }
}

export fn trait_decl_params(env: TypeEnv, name: String) -> Option[Array[String]] {
  match env {
    EnvEmpty => None,
    EnvBind(_, _, rest) => trait_decl_params(env = rest, name = name),
    EnvTraitDef(tname, _, _, _, rest, params, _) => if tname == trait_ref_name(name) {
      Some(params)
    } else {
      trait_decl_params(env = rest, name = name)
    },
    EnvTraitImpl(_, _, rest) => trait_decl_params(env = rest, name = name),
    EnvShowWrappers(_, _, rest) => trait_decl_params(env = rest, name = name),
    EnvMutCell(_, _, rest) => trait_decl_params(env = rest, name = name),
    EnvTraitImplGen(_, _, _, _, rest) => trait_decl_params(env = rest, name = name),
    EnvTypeDefs(_, _, rest) => trait_decl_params(env = rest, name = name),
    EnvFlat(_) => None,
    EnvCached(_, _, rest) => trait_decl_params(env = rest, name = name)
  }
}

/// #1429: render a stored effect row in the SOURCE spelling. Rows are stored
/// comma-joined; the syntax is `+`-separated. Only for text a reader may
/// copy back into their code -- the contract engine's own signature strings
/// (contract.vibe's fn_sig_text) deliberately stay braced, see the note there.
fn row_to_source_spelling(_ row: String) -> String {
  let parts = String::split(row, sep = ", ")
  let n = Array::length(parts)
  let mut acc = ""
  let mut i = 0
  while i < n {
    acc = if i == 0 {
      Array::get(parts, at = i)
    } else {
      String::concat(acc, String::concat(" + ", Array::get(parts, at = i)))
    }
    i = i + 1
  }
  acc
}

export fn type_to_string(_ ty: Type) -> String {
  match ty {
    CtInt => "Int",
    CtInt32 => "Int32",
    CtUInt32 => "UInt32",
    CtDouble => "Float64",
    CtFloat => "Float32",
    CtBool => "Bool",
    CtString => "String",
    CtChar => "Char",
    CtUnit => "()",
    CtBytes => "Bytes",
    CtVar(id) => "?t\{id}",
    CtConstructor(name, arity) => String::concat(name, String::concat("/", __to_string(arity))),
    CtApplied(head, args) => {
      let parts = for arg in args {
        type_to_string(arg)
      }
      String::concat(type_to_string(head), String::concat("[", String::concat(String::join(parts, sep = ", "), "]")))
    },
    CtForAll(vars, _, body) => {
      let vlen = Array::length(vars)
      let mut vi = 0
      let mut vacc = ""
      while vi < vlen {
        let v = String::concat("?t", __to_string(Array::get(vars, at = vi)))
        let next = if vi > 0 {
          String::concat(vacc, String::concat(" ", v))
        } else v
        vacc = next
        vi = vi + 1
      }
      String::concat("forall ", String::concat(vacc, String::concat(". ", type_to_string(body))))
    },
    CtUnknown => "?",
    CtArray(elem) => String::concat("Array[", String::concat(type_to_string(elem), "]")),
    CtOption(elem) => String::concat("Option[", String::concat(type_to_string(elem), "]")),
    CtEnum(name) => name,
    // #1539: the checker identity is deliberately unspellable so source
    // structs/types cannot forge a provider token. Diagnostics expose only
    // the public nominal spelling.
    CtStruct(name) => if name == "#vibe_stdin_stream" {
      "StdinStream"
    } else {
      name
    },
    CtNamed(name, args) => if name == hkt_app_name() && Array::length(args) >= 1 {
      let z = zonk_hkt(ty)
      match z {
        CtNamed(n2, _) => if n2 == hkt_app_name() {
          let head_s = type_to_string(Array::get(args, at = 0))
          let parts = array_empty()
          let mut pi = 1
          while pi < Array::length(args) {
            Array::push(parts, value = type_to_string(Array::get(args, at = pi)))
            pi = pi + 1
          }
          let mut i = 0
          let mut joined = ""
          while i < Array::length(parts) {
            joined = if i > 0 {
              String::concat(joined, String::concat(", ", Array::get(parts, at = i)))
            } else Array::get(parts, at = i)
            i = i + 1
          }
          String::concat(head_s, String::concat("[", String::concat(joined, "]")))
        } else {
          type_to_string(z)
        },
        _ => type_to_string(z)
      }
    } else if String::starts_with(name, prefix = hkt_ctor_prefix()) {
      name[String::length(hkt_ctor_prefix()): String::length(name)]
    } else if String::starts_with(name, prefix = "#hktformal.") {
      name[String::length("#hktformal."): String::length(name)]
    } else if Array::length(args) == 0 {
      name
    } else {
      let parts = for arg in args {
        type_to_string(arg)
      }
      let mut i = 0
      let mut joined = ""
      while i < Array::length(parts) {
        joined = if i > 0 {
          String::concat(joined, String::concat(", ", Array::get(parts, at = i)))
        } else Array::get(parts, at = i)
        i = i + 1
      }
      String::concat(name, String::concat("[", String::concat(joined, "]")))
    },
    CtTuple(elems) => {
      let parts = for e in elems {
        type_to_string(e)
      }
      let mut i = 0
      let mut joined = ""
      while i < Array::length(parts) {
        joined = if i > 0 {
          String::concat(joined, String::concat(", ", Array::get(parts, at = i)))
        } else Array::get(parts, at = i)
        i = i + 1
      }
      String::concat("(", String::concat(joined, ")"))
    },
    CtRecord(rfields) => {
      let mut ri = 0
      let mut rjoined = ""
      while ri < Array::length(rfields) {
        let (rfn, rft) = Array::get(rfields, at = ri)
        let rpart = String::concat(rfn, String::concat(": ", type_to_string(rft)))
        rjoined = if ri > 0 {
          String::concat(rjoined, String::concat(", ", rpart))
        } else rpart
        ri = ri + 1
      }
      String::concat("record { ", String::concat(rjoined, " }"))
    },
    CtFn(params, ret, effect_name) => {
      let parts = for p in params {
        type_to_string(p)
      }
      let mut i = 0
      let mut joined = ""
      while i < Array::length(parts) {
        joined = if i > 0 {
          String::concat(joined, String::concat(", ", Array::get(parts, at = i)))
        } else Array::get(parts, at = i)
        i = i + 1
      }
      let ret_text = type_to_string(ret)
      let base = String::concat("(", String::concat(joined, String::concat(") -> ", ret_text)))
      match semantic_effect_opt(effect_name) {
        // #1429: this text lands in type-mismatch messages, so it has to be
        // the spelling the reader would type. Rows are stored comma-joined;
        // the syntax is `+`-separated.
        // #3051: a published row spells a formal `NAME$K`; the reader
        // wrote `NAME`.
        Some(name) => String::concat(base, String::concat(" with ", strip_published_row_marks(row_to_source_spelling(name)))),
        None => base
      }
    }
  }
}

/// #3351: `text` with every mark a published row carries removed -- a formal's
/// `NAME$K` written `NAME` (`strip_published_formal_suffixes`) and a struct's
/// `^Name` or an enum's `^^Name` written `Name` (`publish_row_nominals`): the
/// spelling its writer used, which the type parser reads.
export fn strip_published_row_marks(_ text: String) -> String {
  let base = strip_published_formal_suffixes(text)
  if !String::contains(base, needle = "^") {
    base
  } else {
    String::join(String::split(base, sep = "^"), sep = "")
  }
}

/// `text` with every `NAME$K` word (K all digits) written `NAME` -- the
/// spelling a published row gives a formal (`publish_row_formals`, #3051).
export fn strip_published_formal_suffixes(_ text: String) -> String {
  if !String::contains(text, needle = "$") {
    text
  } else {
    let n = String::length(text)
    let sb = StringBuilder::new()
    let mut start = 0 - 1
    let mut i = 0
    while i <= n {
      let c = if i < n {
        String::char_code_at(text, at = i)
      } else {
        0
      }
      let word_char = (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || (c >= 48 && c <= 57) || c == 95 || c == 36
      if word_char {
        if start < 0 {
          start = i
        }
      } else {
        if start >= 0 {
          let w = String::substring(text, start = start, end = i)
          let at = String::last_index_of(w, needle = "$")
          let digits = if at > 0 {
            String::substring(w, start = at + 1, end = String::length(w))
          } else {
            ""
          }
          let mut all_digits = String::length(digits) > 0
          let mut di = 0
          while di < String::length(digits) {
            let dc = String::char_code_at(digits, at = di)
            if dc < 48 || dc > 57 {
              all_digits = false
            }
            di = di + 1
          }
          if all_digits {
            StringBuilder::push(sb, value = String::substring(w, start = 0, end = at))
          } else {
            StringBuilder::push(sb, value = w)
          }
          start = 0 - 1
        }
        if i < n {
          StringBuilder::push(sb, value = String::substring(text, start = i, end = i + 1))
        }
      }
      i = i + 1
    }
    StringBuilder::freeze(sb)
  }
}

fn empty_type_args() -> Array[Type] {
  array_empty()
}

export fn env_lookup_flat(bindings: Array[(String, Type)], name: String) -> Option[Type] {
  let len = Array::length(bindings)
  let mut i = 0
  let mut result = None
  let mut done = false
  while !done {
    if i >= len {
      done = true
    } else {
      let (n, ty) = Array::get(bindings, at = i)
      if n == name {
        result = Some(ty)
        done = true
      } else {
        i = i + 1
      }
    }
  }
  result
}

/// #2125: nominal heads the compiler owns itself. They resolve to
/// `CtNamed(name, args)` with no `TypeDef` behind them and no entry in
/// `resolve_builtin`, so they are indistinguishable from a typo by lookup
/// alone and have to be named.
///
/// This list is EMPIRICAL, not a design: it is what Red runs of
/// `collect_unknown_type_names` over `lib/**` and `fixtures/**` reported as
/// unresolved while the tree compiled clean. Adding a compiler-owned type
/// without adding it here makes every annotation that mentions it an error,
/// which is a loud failure, not a silent one -- `PromptText` joined the list
/// that way (`declare PromptText::new(String) -> PromptText`,
/// builtins/declarations.vibe, names a type `resolve_builtin` does not carry).
///
/// Lives in core so the contract sentinel (`ctm_deferred_type_names`, #2164)
/// and the checker share one predicate. `resolve_builtin` answers for
/// builtin *values* (and a handful of scalar type names); this answers for
/// the remaining type heads.
export fn compiler_owned_type_arity(_ name: String) -> Option[Int] {
  if name == "Array" || name == "Option" || name == "Future" || name == "Task" || name == "ArrayBuilder" || name == "FrozenArray" || name == "FixedArray" || name == "MutBytes" || name == "StringMap" {
    Some(1)
  } else if name == "Map" || name == "MapBuilder" || name == "Attempt" || name == "TaskGroup" || name == "MutList" {
    Some(2)
  } else if name == "TaskHandle" || name == "Sender" || name == "Receiver" || name == "MutMap" {
    Some(3)
  } else if name == "ByteStream" || name == "HostStream" || name == "HostResponse" || name == "StringBuilder" || name == "PromptText" {
    Some(0)
  } else {
    None
  }
}

/// #3588: where the PAYLOAD arguments sit in an application of a
/// compiler-owned head whose region and row slots a signature may leave to
/// the call, as `(start, count)`, or `None` when `name` is not such a head or
/// `argc` is neither its full arity nor its payload-only arity. The
/// task/channel heads carry the region and row first (`TaskHandle[rg, e, T]`,
/// so `TaskHandle[Int]` is the payload alone), the region-bound containers
/// carry the region last (`MutList[T, r]`, `MutMap[K, V, r]`, `MutBytes[r]`).
/// The two spellings of one head line up by these positions; the elided
/// slots are unbound by construction and line up with anything.
export fn owned_head_payload_span(name: String, argc: Int) -> Option[(Int, Int)] {
  let (payload, region_first) = if name == "TaskGroup" {
    (0, true)
  } else if name == "TaskHandle" || name == "Sender" || name == "Receiver" {
    (1, true)
  } else if name == "MutBytes" {
    (0, false)
  } else if name == "MutList" {
    (1, false)
  } else if name == "MutMap" {
    (2, false)
  } else {
    (0 - 1, false)
  }
  match compiler_owned_type_arity(name) {
    Some(full) => if payload < 0 {
      None
    } else if argc == payload {
      Some((0, payload))
    } else if argc == full {
      if region_first {
        Some((full - payload, payload))
      } else {
        Some((0, payload))
      }
    } else {
      None
    },
    None => None
  }
}

export fn resolve_builtin(_ name: String) -> Option[Type] {
  // #3727: `i32` is NOT an alias of `Int`. It used to resolve here, so a
  // program declaring 32 bits got 63-bit arithmetic with a clean check
  // (`2147483647 + 1` answered 2147483648). It is now an unknown type whose
  // message names `Int` (`sized_int_spelling_hint`).
  if name == "Int" {
    Some(CtInt)
  }
  // ADR-0122 (#3728): `Float64` / `Float32` are the canonical spellings.
  // The parser reads the legacy `Double` / `Float` (and `f64` / `f32`) as them
  // in type expressions and qualified names (`float_width_alias`); resolving
  // the legacy names here as well keeps a declaration of that name refused
  // like any other builtin spelling.
  else if name == "Float64" || name == "Double" || name == "f64" {
    Some(CtDouble)
  }
  else if name == "Float32" || name == "Float" || name == "f32" {
    // #3543: `Float` is its own 32-bit type, not an alias of `Double`. It
    // shares Double's f64 representation, and every value it holds is
    // exactly an f32: literals, conversions and arithmetic results are
    // rounded to f32 (see `rewrite_float_arith_stmts`).
    Some(CtFloat)
  }
  else if name == "Int32" {
    // #3730: the exact 32-bit integers (see `CtInt32`).
    Some(CtInt32)
  }
  else if name == "UInt32" {
    Some(CtUInt32)
  }
  else if name == "Bool" {
    Some(CtBool)
  }
  else if name == "String" {
    Some(CtString)
  }
  else if name == "Char" {
    Some(CtChar)
  }
  else if name == "Unit" {
    Some(CtUnit)
  }
  else if name == "Bytes" {
    Some(CtBytes)
  }
  else if name == "StdinStream" {
    // #1539: compiler-owned opaque scalar token. CtStruct with an unspellable
    // identity is concrete (unlike a nullary CtNamed) while remaining
    // impossible for source declarations or literals to manufacture.
    Some(CtStruct("#vibe_stdin_stream"))
  }
  // #3793: `i64`, `u8`..`u64` and `i16` resolved here too, with the 63-bit
  // `Int`'s arithmetic under their names (`u8` 255 + 255 was 510). They are
  // refused by the parser now, like `i32`; `v128` has no arithmetic and stays.
  else if name == "v128" {
    Some(CtNamed(name, empty_type_args()))
  }
  else None
}

/// True when `name` is a compiler-owned type head: either a `resolve_builtin`
/// scalar or a `compiler_owned_type_arity` nominal. Used by the contract
/// types-module sentinel so `StringMap` / `Map` / `MutMap` stop exempting
/// every transparent field in the module (#2164).
export fn is_builtin_type_name(_ name: String) -> Bool {
  match resolve_builtin(name) {
    Some(_) => true,
    None => match compiler_owned_type_arity(name) {
      Some(_) => true,
      None => false
    }
  }
}

/// #2442: does this type mention `CtUnknown` anywhere?
///
/// The registry spells a polymorphic builtin's type with `reg_any()`, which is
/// `CtUnknown`, and every occurrence is INDEPENDENT -- the registry has no way
/// to say that the element in `Array::get`'s parameter and its result are the
/// same type. Direct calls survive that because they have dedicated
/// refinements; a first-class VALUE exposes the raw row and loses the
/// relationship. Measured on this compiler, `let get = Array::get` then
/// `let s: String = get([1], 0)` checked CLEAN and printed garbage, while the
/// direct `Array::get([1], 0)` was correctly rejected with `expected String,
/// got Int`. So a row that mentions an unknown has no sound value form, and
/// `registry_builtin_pure_arity` refuses it.
///
/// Arms are enumerated with no wildcard on purpose: a new `Type` constructor
/// must fail this match rather than default to "no unknown here", which would
/// admit a row silently. Same arm list as `type_clone` below.
export fn type_has_unknown(_ ty: Type) -> Bool {
  match ty {
    CtInt => false,
    CtInt32 => false,
    CtUInt32 => false,
    CtDouble => false,
    CtFloat => false,
    CtBool => false,
    CtString => false,
    CtChar => false,
    CtUnit => false,
    CtBytes => false,
    CtUnknown => true,
    CtVar(_) => false,
    CtConstructor(_, _) => false,
    CtApplied(head, args) => type_has_unknown(head) || types_have_unknown(args),
    CtEnum(_) => false,
    CtStruct(_) => false,
    CtArray(e) => type_has_unknown(e),
    CtOption(e) => type_has_unknown(e),
    CtTuple(es) => types_have_unknown(es),
    CtFn(ps, ret, _) => types_have_unknown(ps) || type_has_unknown(ret),
    CtNamed(_, ts) => types_have_unknown(ts),
    CtForAll(_, _, body) => type_has_unknown(body),
    CtRecord(fields) => {
      let mut i = 0
      let mut found = false
      while i < Array::length(fields) {
        let (_, t) = Array::get(fields, at = i)
        if type_has_unknown(t) {
          found = true
          i = Array::length(fields)
        } else {
          i = i + 1
        }
      }
      found
    }
  }
}

/// #2451: the type with every `CtVar` replaced by `CtUnknown`.
///
/// The builtin registry writes an open position as `reg_var(n)` when the row
/// really means "this position and that position are the SAME type"
/// (`Array::get`'s element and result), and `reg_any()` when it means "any
/// value type is legal here and nothing relates it to anything else". Only the
/// value-form path reads the variables; every other consumer of a registry row
/// -- the direct-call fast path, the effect walk, the contract checker, the
/// codegen lookups -- reads the ERASED view, which is byte-for-byte the row
/// those consumers saw before variables existed. That is what keeps a change
/// to the registry's expressiveness from being a change to what the compiler
/// accepts.
///
/// Arms are enumerated with no wildcard for the same reason `type_has_unknown`
/// above does it: a new `Type` constructor must fail this match rather than
/// pass a variable through unerased.
export fn type_erase_vars(_ ty: Type) -> Type {
  match ty {
    CtInt => ty,
    CtInt32 => ty,
    CtUInt32 => ty,
    CtDouble => ty,
    CtFloat => ty,
    CtBool => ty,
    CtString => ty,
    CtChar => ty,
    CtUnit => ty,
    CtBytes => ty,
    CtUnknown => ty,
    CtVar(_) => CtUnknown,
    CtConstructor(_, _) => ty,
    CtApplied(head, args) => CtApplied(type_erase_vars(head), types_erase_vars(args)),
    CtEnum(_) => ty,
    CtStruct(_) => ty,
    CtArray(e) => CtArray(type_erase_vars(e)),
    CtOption(e) => CtOption(type_erase_vars(e)),
    CtTuple(es) => CtTuple(types_erase_vars(es)),
    CtFn(ps, ret, eff) => CtFn(types_erase_vars(ps), type_erase_vars(ret), eff),
    CtNamed(n, ts) => CtNamed(n, types_erase_vars(ts)),
    // A scheme's variables are BOUND by its own binder, not open positions, so
    // erasing them would destroy the scheme rather than hide a relationship.
    // Registry rows are never schemes -- `registry_builtin_scheme` is what
    // BUILDS one, from a row this has already left alone.
    CtForAll(_, _, _) => ty,
    CtRecord(fields) => CtRecord(for field in fields {
      let (fname, ft) = field
      (fname, type_erase_vars(ft))
    })
  }
}

fn types_erase_vars(_ ts: Array[Type]) -> Array[Type] {
  for t in ts {
    type_erase_vars(t)
  }
}

/// #2451: every distinct `CtVar` id mentioned by a type, in first-occurrence
/// order. Used to close a registry row into a `CtForAll` scheme, so each use
/// site instantiates its own copy of the row's variables.
export fn collect_type_var_ids(ty: Type, out: Array[Int]) -> Unit {
  match ty {
    CtInt => (),
    CtInt32 => (),
    CtUInt32 => (),
    CtDouble => (),
    CtFloat => (),
    CtBool => (),
    CtString => (),
    CtChar => (),
    CtUnit => (),
    CtBytes => (),
    CtUnknown => (),
    CtVar(id) => if int_array_contains(xs = out, v = id) {
      ()
    } else {
      Array::push(out, value = id)
    },
    CtConstructor(_, _) => (),
    CtApplied(head, args) => {
      collect_type_var_ids(ty = head, out = out)
      collect_types_var_ids(ts = args, out = out)
    },
    CtEnum(_) => (),
    CtStruct(_) => (),
    CtArray(e) => collect_type_var_ids(ty = e, out = out),
    CtOption(e) => collect_type_var_ids(ty = e, out = out),
    CtTuple(es) => collect_types_var_ids(ts = es, out = out),
    CtFn(ps, ret, _) => {
      collect_types_var_ids(ts = ps, out = out)
      collect_type_var_ids(ty = ret, out = out)
    },
    CtNamed(_, ts) => collect_types_var_ids(ts = ts, out = out),
    CtForAll(_, _, body) => collect_type_var_ids(ty = body, out = out),
    CtRecord(fields) => {
      let mut i = 0
      while i < Array::length(fields) {
        let (_, ft) = Array::get(fields, at = i)
        collect_type_var_ids(ty = ft, out = out)
        i = i + 1
      }
    }
  }
}

fn collect_types_var_ids(ts: Array[Type], out: Array[Int]) -> Unit {
  let mut i = 0
  while i < Array::length(ts) {
    collect_type_var_ids(ty = Array::get(ts, at = i), out = out)
    i = i + 1
  }
}

fn types_have_unknown(_ ts: Array[Type]) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(ts) {
    if type_has_unknown(Array::get(ts, at = i)) {
      found = true
      i = Array::length(ts)
    } else {
      i = i + 1
    }
  }
  found
}

fn named_constructor_or_resolved(name: String, defs: Array[TypeDef], resolved: Type) -> Type {
  match declared_type_constructor_arity(defs = defs, name = name) {
    Some(arity) => if arity > 0 {
      CtConstructor(name, arity)
    } else {
      resolved
    },
    None => resolved
  }
}

fn reify_named_constructor(name: String, defs: Array[TypeDef], shadow: Array[String], resolved: Type) -> Type {
  let shadow_arity = type_expr_shadowed_arity(shadow = shadow, name = name)
  if shadow_arity > 0 {
    resolved
  } else {
    match find_typedef(defs = defs, name = name) {
      Some(td) => match td {
        TDAlias(_, alias_params, body) => if Array::length(alias_params) > 0 {
          make_alias_constructor(params = alias_params, body = body)
        } else {
          named_constructor_or_resolved(name = name, defs = defs, resolved = resolved)
        },
        _ => named_constructor_or_resolved(name = name, defs = defs, resolved = resolved)
      },
      None => named_constructor_or_resolved(name = name, defs = defs, resolved = resolved)
    }
  }
}

fn type_def_params(_ td: TypeDef) -> Array[String] {
  match td {
    TDEnum(_, params, _) => params,
    TDStruct(_, _, _, params) => params,
    TDAlias(_, params, _) => params,
    TDEffect(_, _, params, _, _) => params,
    TDEffectSet(_, _) => array_empty()
  }
}

fn declared_type_constructor_arity(defs: Array[TypeDef], name: String) -> Option[Int] {
  match find_typedef(defs = defs, name = name) {
    Some(td) => Some(Array::length(type_def_params(td))),
    None => match compiler_owned_type_arity(name) {
      Some(arity) => Some(arity),
      None => match resolve_builtin(name) {
        Some(_) => Some(0),
        None => None
      }
    }
  }
}

/// Reify bare constructor arguments according to the kind declared by the
/// receiving type parameter. A shadowed constructor variable stays nominal so
/// checker binding can replace its head with a CtVar; concrete constructors
/// carry their declared arity explicitly across alias substitution and caches.
/// Parameterized aliases expand to the constructor of their body (`Vec` for
/// `type Vec[T] = Array[T]` becomes Array) rather than a nominal head.
export fn resolve_type_constructor_args(params: Array[String], source_args: Array[TypeExpr], resolved_args: Array[Type], defs: Array[TypeDef], shadow: Array[String]) -> Array[Type] {
  let out = array_empty()
  let mut i = 0
  while i < Array::length(resolved_args) {
    let resolved = Array::get(resolved_args, at = i)
    if i < Array::length(params) && type_param_arity(Array::get(params, at = i)) > 0 && i < Array::length(source_args) {
      match Array::get(source_args, at = i) {
        TyName(name) => Array::push(out, value = reify_named_constructor(name = name, defs = defs, shadow = shadow, resolved = resolved)),
        _ => Array::push(out, value = resolved)
      }
    } else {
      Array::push(out, value = resolved)
    }
    i = i + 1
  }
  out
}

/// Resolve an argument for a trait key without turning a bare alias
/// constructor into a complete type. Key writing keeps its declared name;
/// inference still reifies its body through `resolve_type_constructor_args`.
/// Impl registration and bound lookup must use the same spelling.
export fn resolve_trait_key_arg(te: TypeExpr, defs: Array[TypeDef], shadow: Array[String]) -> Type {
  let constructor = match te {
    TyName(name) => if type_expr_name_is_shadowed(shadow = shadow, name = name) {
      None
    } else match find_typedef(defs = defs, name = name) {
      Some(TDAlias(_, params, _)) => if Array::length(params) > 0 {
        Some(CtConstructor(name, Array::length(params)))
      } else {
        None
      },
      _ => None
    },
    _ => None
  }
  match constructor {
    Some(ty) => ty,
    None => resolve_type_expr_core_shadowed(te = te, defs = defs, shadow = shadow)
  }
}

/// Resolve a source type expression while preserving the enclosing type
/// binders. This is the shared semantic authority used by the checker and by
/// typed classification in later compiler passes.
export fn resolve_type_expr_core_shadowed(te: TypeExpr, defs: Array[TypeDef], shadow: Array[String]) -> Type {
  match te {
    TyUnit => CtUnit,
    TyName(name) => if type_expr_name_is_shadowed(shadow = shadow, name = name) {
      CtNamed(name, array_empty())
    } else {
      match resolve_builtin(name) {
        Some(t) => t,
        None => match find_typedef(defs = defs, name = name) {
          Some(td) => match td {
            TDEnum(n, _, _) => CtEnum(n),
            TDStruct(n, _, _, _) => CtStruct(n),
            TDAlias(_, _, t) => t,
            TDEffect(_, _, _, _, _) => CtNamed(name, array_empty()),
            TDEffectSet(_, _) => CtNamed(name, array_empty())
          },
          None => CtNamed(name, array_empty())
        }
      }
    },
    TyApp(name, args) => {
      let raw_args = for a in args {
        resolve_type_expr_core_shadowed(te = a, defs = defs, shadow = shadow)
      }
      if type_expr_name_is_shadowed(shadow = shadow, name = name) {
        let arity = type_expr_shadowed_arity(shadow = shadow, name = name)
        if arity > 0 {
          CtApplied(CtNamed(name, array_empty()), raw_args)
        } else {
          CtNamed(name, raw_args)
        }
      } else if name == "Array" && Array::length(raw_args) == 1 {
        CtArray(Array::get(raw_args, at = 0))
      } else if name == "Option" && Array::length(raw_args) == 1 {
        CtOption(Array::get(raw_args, at = 0))
      } else if name == "StringMap" && Array::length(raw_args) == 1 {
        // #2263: the concrete name for the builtin map, which is String-keyed
        // (`Map[K, V]`'s generality is not implemented and the name is
        // reserved for it). Resolved here rather than declared as a prelude
        // alias because a prelude type is not in scope without an import
        // (measured: a bare `Byte` parameter answers "unknown type"), and
        // resolving it to the SAME type the ops take keeps every `Map::` op
        // working on a `StringMap[V]` value with no second op family. A
        // user declaration of the name still wins -- generic binders are
        // covered by the shadow test above, and source declarations by defs.
        match find_typedef(defs = defs, name = name) {
          Some(td) => match td {
            TDAlias(_, params, body) => resolve_type_alias_params(ty = body, params = params, args = resolve_type_constructor_args(params = params, source_args = args, resolved_args = raw_args, defs = defs, shadow = shadow)),
            _ => CtNamed(name, raw_args)
          },
          None => CtNamed("Map", [CtString, Array::get(raw_args, at = 0)])
        }
      } else {
        match find_typedef(defs = defs, name = name) {
          Some(td) => match td {
            TDAlias(_, params, body) => resolve_type_alias_params(ty = body, params = params, args = resolve_type_constructor_args(params = params, source_args = args, resolved_args = raw_args, defs = defs, shadow = shadow)),
            _ => CtNamed(name, resolve_type_constructor_args(params = type_def_params(td), source_args = args, resolved_args = raw_args, defs = defs, shadow = shadow))
          },
          None => CtNamed(name, raw_args)
        }
      }
    },
    TyTuple(elems) => CtTuple(for e in elems {
      resolve_type_expr_core_shadowed(te = e, defs = defs, shadow = shadow)
    }),
    TyFn(params, ret, effect_name) => CtFn(for p in params {
      resolve_type_expr_core_shadowed(te = p, defs = defs, shadow = shadow)
    }, resolve_type_expr_core_shadowed(te = ret, defs = defs, shadow = shadow), effect_name)
  }
}

export fn subst_add_bound(s: Subst, id: Int, bounds: Array[String]) -> Subst {
  SubstBound(id, bounds, s)
}

fn empty_var_bounds() -> Array[(Int, Array[String])] {
  array_empty()
}

export fn int_bounds_has_id(pairs: Array[(Int, Array[String])], id: Int, i: Int) -> Bool {
  if i >= Array::length(pairs) {
    false
  } else {
    let (pid, _) = Array::get(pairs, at = i)
    if pid == id {
      true
    } else {
      int_bounds_has_id(pairs = pairs, id = id, i = i + 1)
    }
  }
}

export fn int_bounds_lookup(pairs: Array[(Int, Array[String])], id: Int, i: Int) -> Array[String] {
  if i >= Array::length(pairs) {
    array_empty()
  } else {
    let (pid, bounds) = Array::get(pairs, at = i)
    if pid == id {
      bounds
    } else {
      int_bounds_lookup(pairs = pairs, id = id, i = i + 1)
    }
  }
}

fn int_int_lookup_or(pairs: Array[(Int, Int)], key: Int, fallback: Int, i: Int) -> Int {
  if i >= Array::length(pairs) {
    fallback
  } else {
    let (k, v) = Array::get(pairs, at = i)
    if k == key {
      v
    } else {
      int_int_lookup_or(pairs = pairs, key = key, fallback = fallback, i = i + 1)
    }
  }
}

/// #626 criterion 4: collect the distinct effect-VARIABLE names appearing in a
/// type scheme body (lone `with e` annotations), so `instantiate` can mint a
/// fresh variable per use site and effect polymorphism survives unification.
fn collect_effect_vars_walk(t: Type, out: Array[String]) -> Int {
  match t {
    CtFn(params, ret, eff) => {
      match eff {
        Some(row) => {
          for raw in String::split(row, sep = ",") {
            let name = String::trim(raw)
            if is_effect_var_name(name) {
              let mut seen = false
              let mut k = 0
              while k < Array::length(out) {
                if Array::get(out, at = k) == name {
                  seen = true
                }
                k = k + 1
              }
              if !seen {
                Array::push(out, value = name)
              }
            }
          }
        },
        None => ()
      }
      for p in params {
        let _ = collect_effect_vars_walk(t = p, out = out)
      }
      collect_effect_vars_walk(t = ret, out = out)
    },
    CtArray(elem) => collect_effect_vars_walk(t = elem, out = out),
    CtOption(elem) => collect_effect_vars_walk(t = elem, out = out),
    CtRecord(rfields) => {
      for rf in rfields {
        let (_, rft) = rf
        let _ = collect_effect_vars_walk(t = rft, out = out)
      }
      0
    },
    CtTuple(elems) => {
      for e in elems {
        let _ = collect_effect_vars_walk(t = e, out = out)
      }
      0
    },
    CtNamed(_, args) => {
      for a in args {
        // #3589: a row variable passed as a type argument (`Holder[e]`)
        // is the same variable as the row's `with e`.
        match row_var_type_arg(a) {
          Some(name) => if !string_array_contains(items = out, wanted = name) {
            Array::push(out, value = name)
          },
          None => ()
        }
        let _ = collect_effect_vars_walk(t = a, out = out)
      }
      0
    },
    CtForAll(_, _, body) => collect_effect_vars_walk(t = body, out = out),
    _ => 0
  }
}

fn rename_eff_name(name: String, pairs: Array[(String, String)]) -> String {
  let mut i = 0
  let mut out = name
  while i < Array::length(pairs) {
    let (k, v) = Array::get(pairs, at = i)
    if k == name {
      out = v
    }
    i = i + 1
  }
  out
}

fn rename_effect_row(row: String, pairs: Array[(String, String)]) -> String {
  let labels = array_empty()
  for raw in String::split(row, sep = ",") {
    Array::push(labels, value = rename_eff_name(name = String::trim(raw), pairs = pairs))
  }
  String::join(labels, sep = ", ")
}

fn rename_effect_vars(t: Type, pairs: Array[(String, String)]) -> Type {
  match t {
    CtFn(params, ret, eff) => {
      let new_params = array_empty()
      let mut i = 0
      while i < Array::length(params) {
        Array::push(new_params, value = rename_effect_vars(t = Array::get(params, at = i), pairs = pairs))
        i = i + 1
      }
      let new_eff = match eff {
        Some(row) => Some(rename_effect_row(row = row, pairs = pairs)),
        None => None
      }
      CtFn(new_params, rename_effect_vars(t = ret, pairs = pairs), new_eff)
    },
    CtArray(elem) => CtArray(rename_effect_vars(t = elem, pairs = pairs)),
    CtOption(elem) => CtOption(rename_effect_vars(t = elem, pairs = pairs)),
    CtTuple(elems) => {
      let out = array_empty()
      let mut i = 0
      while i < Array::length(elems) {
        Array::push(out, value = rename_effect_vars(t = Array::get(elems, at = i), pairs = pairs))
        i = i + 1
      }
      CtTuple(out)
    },
    CtRecord(rfields) => {
      let rout = array_empty()
      let mut ri = 0
      while ri < Array::length(rfields) {
        let (rfn, rft) = Array::get(rfields, at = ri)
        Array::push(rout, value = (rfn, rename_effect_vars(t = rft, pairs = pairs)))
        ri = ri + 1
      }
      CtRecord(rout)
    },
    CtNamed(name, args) => {
      let out = array_empty()
      let mut i = 0
      while i < Array::length(args) {
        let a = Array::get(args, at = i)
        Array::push(out, value = match row_var_type_arg(a) {
          Some(v) => CtNamed(rename_eff_name(name = v, pairs = pairs), array_empty()),
          None => rename_effect_vars(t = a, pairs = pairs)
        })
        i = i + 1
      }
      CtNamed(name, out)
    },
    _ => t
  }
}

fn trait_bound_vid_prefix() -> String {
  "#tpvid."
}

export fn parse_trait_bound_vid(_ name: String) -> Option[Int] {
  let prefix = trait_bound_vid_prefix()
  if !String::starts_with(name, prefix = prefix) {
    None
  } else {
    let rest = String::substring(name, start = String::length(prefix), end = String::length(name))
    if String::length(rest) == 0 {
      None
    } else {
      let mut i = 0
      let mut n = 0
      let mut ok = true
      while i < String::length(rest) && ok {
        let c = String::char_code_at(rest, at = i)
        if c >= '0' && c <= '9' {
          n = n * 10 + c - '0'
        } else {
          ok = false
        }
        i = i + 1
      }
      if ok {
        Some(n)
      } else {
        None
      }
    }
  }
}

fn remap_trait_bound_vid_expr(te: TypeExpr, id_map: Array[(Int, Int)]) -> TypeExpr {
  match te {
    TyName(name) => match parse_trait_bound_vid(name) {
      Some(old_id) => TyName(String::concat(trait_bound_vid_prefix(), __to_string(int_int_lookup_or(pairs = id_map, key = old_id, fallback = old_id, i = 0)))),
      None => te
    },
    TyApp(name, args) => {
      let head = match parse_trait_bound_vid(name) {
        Some(old_id) => String::concat(trait_bound_vid_prefix(), __to_string(int_int_lookup_or(pairs = id_map, key = old_id, fallback = old_id, i = 0))),
        None => name
      }
      TyApp(head, for arg in args {
        remap_trait_bound_vid_expr(te = arg, id_map = id_map)
      })
    },
    TyTuple(items) => TyTuple(for item in items {
      remap_trait_bound_vid_expr(te = item, id_map = id_map)
    }),
    TyFn(params, ret, effect) => TyFn(for param in params {
      remap_trait_bound_vid_expr(te = param, id_map = id_map)
    }, remap_trait_bound_vid_expr(te = ret, id_map = id_map), effect),
    TyUnit => TyUnit
  }
}

fn remap_trait_bound_vids(key: String, id_map: Array[(Int, Int)]) -> String {
  match trait_ref_from_key(key) {
    Some(reference) => trait_ref_key(remap_trait_bound_vid_expr(te = reference, id_map = id_map)),
    None => key
  }
}

/// The source spelling of each fresh effect variable `instantiate` minted
/// (`$4` -> `e`), so a message shows the row as the program wrote it
/// (`effect_var_spelling`). Display only: the checker never reads it.
let effect_var_spellings: Array[MutMap[String, String]] = [MutMap::new_string()]

/// Record that `fresh` renames `from`. A variable that is itself a fresh one
/// passes on its own spelling, so a re-instantiated scheme still reads `e`.
fn note_effect_var_spelling(fresh: String, from: String) -> Unit {
  let names = Array::get(effect_var_spellings, at = 0)
  match MutMap::get(names, k = from) {
    Some(src) => MutMap::set(names, k = fresh, v = src),
    None => if String::starts_with(from, prefix = "$") {
      ()
    } else {
      MutMap::set(names, k = fresh, v = from)
    }
  }
}

/// #3557 follow-up: the spelling the source wrote for an effect variable a
/// call instantiated (`$4` -> `e`), or the name unchanged when it is not one.
/// Since #3557 quantified a signature's own `with e` per call, a row-mismatch
/// message printed the internal `Console + $4` where it used to print
/// `Console + e`; an explicit `[e]` binder printed `$7` before that.
export fn effect_var_spelling(_ name: String) -> String {
  match MutMap::get(Array::get(effect_var_spellings, at = 0), k = name) {
    Some(src) => src,
    None => name
  }
}

export fn instantiate(ty: Type, c: Int) -> (Type, Int, Array[(Int, Array[String])]) {
  match ty {
    CtForAll(bound_vars, var_bounds, body) => {
      let blen = Array::length(bound_vars)
      let id_map = array_empty()
      let mut bi = 0
      let mut bacc = SubstEmpty
      // #743: fresh ids must not overlap the scheme's OLD bound ids. An
      // IMPORTED scheme carries bound-var ids from the EXPORTING module's
      // counter domain (FS-compile checks modules separately and caches
      // their envs), so the importing module's counter c can be ≤ an old id.
      // A fresh id equal to another old bound id makes subst_apply's
      // transitive var resolution chain old→fresh→fresh' and COLLAPSES two
      // distinct scheme vars into one — `Err` from the prelude instantiated
      // as `(E) -> Result[E, E]` whenever exactly one extra type var had
      // been allocated before the use site (json_parse's #743).
      let mut bnc = c
      let mut bmax_i = 0
      while bmax_i < blen {
        let bold = Array::get(bound_vars, at = bmax_i)
        if bold >= bnc {
          bnc = bold + 1
        } else {
          ()
        }
        bmax_i = bmax_i + 1
      }
      while bi < blen {
        let old_id = Array::get(bound_vars, at = bi)
        Array::push(id_map, value = (old_id, bnc))
        bacc = SubstBind(old_id, CtVar(bnc), bacc)
        bnc = bnc + 1
        bi = bi + 1
      }
      let inst_s = bacc
      let id_map2 = id_map
      let c1 = bnc
      let new_bounds = array_empty()
      for var_bound in var_bounds {
        let (old_id, bounds) = var_bound
        let new_id = int_int_lookup_or(pairs = id_map2, key = old_id, fallback = old_id, i = 0)
        let remapped = for bound in bounds {
          remap_trait_bound_vids(key = bound, id_map = id_map2)
        }
        Array::push(new_bounds, value = (new_id, remapped))
      };
      let inst_body = subst_apply(s = inst_s, ty = body)
      // #626 criterion 4: freshen the scheme's effect variables so each use site
      // gets its own variable. Without this, binding `e` at one call site would
      // leak to every other call (effect polymorphism would collapse to the
      // first concrete effect). Fresh names are `$<counter>` (never a real
      // effect name), threaded through the same counter as type variables.
      let eff_vars = array_empty()
      let _ = collect_effect_vars_walk(t = inst_body, out = eff_vars)
      let eff_pairs = array_empty()
      let mut ev_i = 0
      let mut ev_c = c1
      while ev_i < Array::length(eff_vars) {
        let ev = Array::get(eff_vars, at = ev_i)
        let fresh = String::concat("$", __to_string(ev_c))
        note_effect_var_spelling(fresh = fresh, from = ev)
        Array::push(eff_pairs, value = (ev, fresh))
        ev_c = ev_c + 1
        ev_i = ev_i + 1
      }
      let final_body = if Array::length(eff_pairs) == 0 {
        inst_body
      } else {
        rename_effect_vars(t = inst_body, pairs = eff_pairs)
      }
      (final_body, ev_c, new_bounds)
    },
    _ => (ty, c, empty_var_bounds())
  }
}

export fn trait_is_subtrait(env: TypeEnv, sub: String, super_name: String) -> Bool {
  if sub == super_name {
    true
  }
  else {
    let supers = trait_supers(env = env, name = sub)
    let slen = Array::length(supers)
    let mut si = 0
    let mut sresult = false
    let mut sdone = false
    while !sdone {
      if si >= slen {
        sdone = true
      } else {
        let s = Array::get(supers, at = si)
        if s == super_name {
          sresult = true
          sdone = true
        } else if trait_is_subtrait(env = env, sub = s, super_name = super_name) {
          sresult = true
          sdone = true
        } else {
          si = si + 1
        }
      }
    }
    sresult
  }
}

fn collect_tvars_walk(t: Type, out: Array[Int]) -> Int {
  match t {
    CtVar(id) => {
      if !array_has_int(arr = out, val = id, i = 0) {
        Array::push(out, value = id)
      }
      0
    },
    CtFn(params, ret, _) => {
      for p in params {
        let _ = collect_tvars_walk(t = p, out = out)
      }
      collect_tvars_walk(t = ret, out = out)
    },
    CtArray(elem) => collect_tvars_walk(t = elem, out = out),
    CtOption(elem) => collect_tvars_walk(t = elem, out = out),
    CtRecord(rfields) => {
      for rf in rfields {
        let (_, rft) = rf
        let _ = collect_tvars_walk(t = rft, out = out)
      }
      0
    },
    CtTuple(elems) => {
      for e in elems {
        let _ = collect_tvars_walk(t = e, out = out)
      }
      0
    },
    // #829: type variables inside an APPLIED named type's arguments (e.g. the
    // `V` in `MutSortedMap[K, V]` when only `K` is mentioned by a parameter) must
    // be quantified too. They used to be skipped, leaving the scheme with a
    // FREE variable whose id is from the exporting module's counter domain —
    // an id-collision landmine (#743's hazard, but for free vars, which
    // `instantiate` does not rename): once generic struct types became real
    // (`CtNamed(S, args)` instead of CtUnknown), a collision bound an
    // importing module's own type param through the shared free var.
    CtNamed(_, args) => {
      for a in args {
        let _ = collect_tvars_walk(t = a, out = out)
      }
      0
    },
    CtConstructor(_, _) => 0,
    CtApplied(head, args) => {
      let _ = collect_tvars_walk(t = head, out = out)
      for arg in args {
        let _ = collect_tvars_walk(t = arg, out = out)
      }
      0
    },
    CtForAll(_, _, body) => collect_tvars_walk(t = body, out = out),
    _ => 0
  }
}

export fn collect_tvars(_ ty: Type) -> Array[Int] {
  let out = array_empty()
  let _ = collect_tvars_walk(t = ty, out = out)
  out
}

fn empty_env_bindings() -> Array[(String, Type)] {
  array_empty()
}

export fn env_flat_bindings(_ env: TypeEnv) -> Array[(String, Type)] {
  let out = empty_env_bindings()
  match env {
    EnvFlat(bindings) => {
      let mut i = 0
      while i < Array::length(bindings) {
        let (name, binding) = Array::get(bindings, at = i)
        Array::push(out, value = (name, binding.ty))
        i = i + 1
      }
      out
    },
    _ => {
      let mut cur = env
      let mut done = false
      while !done {
        match cur {
          EnvEmpty => {
            done = true
          },
          EnvBind(name, binding, rest) => {
            Array::push(out, value = (name, binding.ty))
            cur = rest
          },
          EnvTraitDef(_, _, _, _, rest, _, _) => {
            cur = rest
          },
          EnvTraitImpl(_, _, rest) => {
            cur = rest
          },
          EnvShowWrappers(_, _, rest) => {
            cur = rest
          },
          EnvMutCell(_, _, rest) => {
            cur = rest
          },
          EnvTraitImplGen(_, _, _, _, rest) => {
            cur = rest
          },
          EnvTypeDefs(_, _, rest) => {
            cur = rest
          },
          EnvFlat(bindings) => {
            let mut j = 0
            while j < Array::length(bindings) {
              let (name, binding) = Array::get(bindings, at = j)
              Array::push(out, value = (name, binding.ty))
              j = j + 1
            }
            done = true
          },
          EnvCached(_, _, rest) => {
            cur = rest
          }
        }
      }
      out
    }
  }
}

fn string_array_equal(left: Array[String], right: Array[String]) -> Bool {
  let len = Array::length(left)
  let mut i = 0
  let mut result = true
  let mut done = false
  while !done {
    if i >= len {
      done = true
    } else if Array::get(left, at = i) != Array::get(right, at = i) {
      result = false
      done = true
    } else {
      i = i + 1
    }
  }
  result
}

fn option_string_equal(left: Option[String], right: Option[String]) -> Bool {
  match left {
    Some(left_name) => match right {
      Some(right_name) => left_name == right_name,
      None => false
    },
    None => match right {
      Some(_) => false,
      None => true
    }
  }
}

/// #3417: `text` split at the commas outside brackets and parentheses, each
/// item trimmed. An empty item is kept, so the argument text of `Id[]` is one
/// empty argument; `row_items` is the same split with empty items dropped.
export fn split_top_level_commas(_ text: String) -> Array[String] {
  top_level_comma_items(text = text, keep_empty = true)
}

/// #3417: a stored effect row's items, split at the commas that separate
/// items, trimmed, with empty items dropped. A kind such as
/// `Exception[(Int, Int) -> Int]` holds commas of its own, inside brackets,
/// and stays one item.
export fn row_items(_ row: String) -> Array[String] {
  top_level_comma_items(text = row, keep_empty = false)
}

fn top_level_comma_items(text: String, keep_empty: Bool) -> Array[String] {
  let out = array_empty()
  let n = String::length(text)
  let mut depth = 0
  let mut start = 0
  let mut i = 0
  while i < n {
    let c = String::char_code_at(text, at = i)
    if c == 40 || c == 91 {
      depth = depth + 1
    } else if c == 41 || c == 93 {
      depth = depth - 1
    } else if c == 44 && depth == 0 {
      push_comma_item(out = out, item = String::trim(String::substring(text, start = start, end = i)), keep_empty = keep_empty)
      start = i + 1
    } else {
      ()
    }
    i = i + 1
  }
  push_comma_item(out = out, item = String::trim(String::substring(text, start = start, end = n)), keep_empty = keep_empty)
  out
}

fn push_comma_item(out: Array[String], item: String, keep_empty: Bool) -> Unit {
  if keep_empty || String::length(item) > 0 {
    Array::push(out, value = item)
  } else {
    ()
  }
}

/// #626 criterion 3: an effect annotation `with A + B` is an unordered SET,
/// but `collect_effect_names` joins it source-order into one string ("A, B"),
/// so `{ A, B }` and `{ B, A }` serialize to different strings. Split the
/// comma-separated annotation back into its labels (trimmed, deduplicated) so
/// equality can be decided on the set, not the raw ordered string.
fn effect_label_list(_ eff: Option[String]) -> Array[String] {
  let out = array_empty()
  match eff {
    None => out,
    Some(s) => {
      let raw = String::split(s, sep = ",")
      let mut i = 0
      while i < Array::length(raw) {
        let label = String::trim(Array::get(raw, at = i))
        if String::length(label) > 0 {
          let mut seen = false
          let mut j = 0
          while j < Array::length(out) {
            if Array::get(out, at = j) == label {
              seen = true
            }
            j = j + 1
          }
          if !seen {
            Array::push(out, value = label)
          }
        }
        i = i + 1
      }
      out
    }
  }
}

/// #1340 (ADR-0071): a generic instantiation label (`State[Int]`) compares
/// by its base effect name in row set-equality — mixing spellings
/// (`with State` vs `with State[Int]`) must not fail fn-type
/// unification. For bracketless labels this is exact equality, so
/// pre-#1340 rows are unchanged. Instantiation-precise row identity is the
/// remaining ADR-0071 OperationRef-normalization work.
///
/// ADR-0085 (#1344): the exception effect is the one generic effect that does
/// NOT collapse to its base — `Exception[IoError]` and `Exception[ParseError]`
/// must stay distinct here or the two rows unify and check_assignable never
/// reaches its dropped-label report. The ERASED spellings (`Exception`,
/// `Error`, and either one's `::Throw`) all normalize to `Exception` (#1461
/// flipped this from `Error`), which is what keeps `with Exception` and
/// `with Exception` interchangeable exactly as the #1279 bridge made them --
/// the canonical side of that pair moved, the pairing did not. An erased row
/// and a kinded row do differ
/// here, but that only routes them into check_assignable's structural retry,
/// where effect_row_dropped tolerates them (an erased label is kind-compatible
/// with every kind) — so no pre-#1344 program changes verdict.
fn effect_label_base_name(_ label: String) -> String {
  if is_exception_label(label) {
    let kind = exception_label_kind(label)
    if String::length(kind) == 0 {
      "Exception"
    } else {
      String::concat("Exception[", String::concat(kind, "]"))
    }
  } else {
    let bi = String::index_of(label, needle = "[")
    if bi > 0 {
      String::substring(label, start = 0, end = bi)
    } else {
      label
    }
  }
}

/// #1340 (Codex P1 on #1352): reduce a label list to its BASE names, deduped.
/// effect_label_list dedupes by EXACT label, which is what made "same length +
/// one-way membership" a sound set-equality test. Comparing by base name
/// breaks that invariant on its own -- `{ State[Int], State[String] }` is two
/// exact labels but ONE base -- so `{ State[Int], State[String] }` vs
/// `{ State, Fs }` would match on length AND find every left base on the
/// right, silently accepting a row that drops `Fs`. Deduping by base first
/// restores the invariant: both sides become genuine base-name sets.
fn effect_label_base_set(_ labels: Array[String]) -> Array[String] {
  let out = array_empty()
  let mut i = 0
  while i < Array::length(labels) {
    let raw = Array::get(labels, at = i)
    let provenance = is_row_provenance_label(raw)
    let base = effect_label_base_name(raw)
    let mut seen = false
    let mut j = 0
    while j < Array::length(out) {
      if Array::get(out, at = j) == base {
        seen = true
      }
      j = j + 1
    }
    if !seen && !provenance {
      Array::push(out, value = base)
    }
    i = i + 1
  }
  out
}

/// #3341: a label recording the instantiation a lambda's performs of a
/// generic effect were checked against, `#einst:<effect>:<variable id>`
/// (`checker_row_effect_inst.vibe`). Like the capture and parameter
/// provenance labels it is not an effect: row comparison, display and
/// publication skip it.
export fn is_effect_inst_label(_ label: String) -> Bool {
  String::starts_with(label, prefix = "#einst:")
}

/// #3417: is this trimmed row label provenance the checker records in a row,
/// rather than an effect? That is a region skolem (`#region_<n>`), a capture,
/// a parameter, an aliased parameter or a field parameter
/// (`#capture[..]`, `#param[..]`, `#aliasparam[..]`, `#fieldparam[..]`), or
/// an instantiation (`#einst:`, `effect_inst_of_label`). Row comparison,
/// display, publication and the effect checks skip these labels.
export fn is_row_provenance_label(_ label: String) -> Bool {
  String::starts_with(label, prefix = "#region_") || String::starts_with(label, prefix = "#capture[") || String::starts_with(label, prefix = "#param[") || String::starts_with(label, prefix = "#aliasparam[") || String::starts_with(label, prefix = "#fieldparam[") || is_effect_inst_label(label)
}

/// #3417: the instantiation a function value's performs of a generic effect
/// were checked against (#3341): the effect's name and the type variable
/// that holds its payload. A stored row still carries it as an `#einst:`
/// label. `effect_inst_label_text` is the only writer of that spelling and
/// `effect_inst_of_label` the only reader, so a route reads this value and
/// never the label text.
export struct EffectInst {
  name: String
  var_id: Int
}

/// #3417: the row label that stores `inst`, `#einst:<effect>:<variable id>`.
export fn effect_inst_label_text(_ inst: EffectInst) -> String {
  String::concat("#einst:", String::concat(inst.name, String::concat(":", __to_string(inst.var_id))))
}

/// #3417: the instantiation a trimmed row label stores. `None` for any other
/// label, and for an `#einst:` label without a name or a decimal variable id.
/// The id follows the LAST `:`, so a qualified effect name keeps its own.
export fn effect_inst_of_label(_ label: String) -> Option[EffectInst] {
  if is_effect_inst_label(label) {
    let rest = String::substring(label, start = 7, end = String::length(label))
    let n = String::length(rest)
    let mut cut = 0 - 1
    let mut i = 0
    while i < n {
      if String::byte_at(rest, at = i) == 58 {
        cut = i
      } else {
        ()
      }
      i = i + 1
    }
    if cut > 0 && cut + 1 < n {
      let mut id = 0
      let mut digits = true
      let mut p = cut + 1
      while p < n {
        let ch = String::byte_at(rest, at = p)
        if ch >= 48 && ch <= 57 {
          id = id * 10 + (ch - 48)
        } else {
          digits = false
        }
        p = p + 1
      }
      if digits {
        Some(EffectInst::{
          name: String::substring(rest, start = 0, end = cut),
          var_id: id
        })
      } else {
        None
      }
    } else {
      None
    }
  } else {
    None
  }
}

/// #3417: may `row` store an instantiation? A cheap test ahead of splitting
/// the row into labels; it also answers `true` for the spelling nested in a
/// kind, which `effect_inst_of_label` on a top-level item then rejects.
export fn row_may_have_effect_inst(_ row: String) -> Bool {
  String::contains(row, needle = "#einst:")
}

fn effect_label_sets_equal(left: Option[String], right: Option[String]) -> Bool {
  let ls = effect_label_base_set(effect_label_list(left))
  let rs = effect_label_base_set(effect_label_list(right))
  if Array::length(ls) != Array::length(rs) {
    false
  } else {
    let mut i = 0
    let mut ok = true
    while i < Array::length(ls) {
      let label = Array::get(ls, at = i)
      let mut found = false
      let mut j = 0
      while j < Array::length(rs) {
        if Array::get(rs, at = j) == label {
          found = true
        }
        j = j + 1
      }
      if !found {
        ok = false
      }
      i = i + 1
    }
    ok
  }
}

fn effect_opt_is_var(_ eff: Option[String]) -> Bool {
  let labels = effect_label_list(eff)
  let mut count = 0
  let mut variable = false
  for label in labels {
    if !is_row_provenance_label(label) {
      count = count + 1
      variable = is_effect_var_name(label)
    }
  }
  count == 1 && variable
}

fn semantic_effect_opt(_ eff: Option[String]) -> Option[String] {
  match eff {
    None => None,
    Some(row) => if String::index_of(row, needle = ",") < 0 && String::trim(row) == row && !String::starts_with(row, prefix = "#") {
      Some(row)
    } else {
      let labels = effect_label_list(eff)
      let semantic = array_empty()
      for label in labels {
        if !is_row_provenance_label(label) {
          Array::push(semantic, value = label)
        }
      }
      if Array::length(semantic) == 0 {
        None
      } else {
        Some(String::join(semantic, sep = ", "))
      }
    }
  }
}

fn effect_names_compatible(left: Option[String], right: Option[String]) -> Bool {
  if option_string_equal(left = left, right = right) {
    true
  } else if effect_opt_is_var(left) {
    // #626 criterion 4: an effect variable is NO LONGER a wildcard. It equals
    // only itself (handled by `option_string_equal` above); a variable vs a
    // different effect is reported NOT-equal here so that `unify`'s structural
    // `types_equal` fast path falls through to the `CtFn` arm, where
    // `unify_effects` records the actual binding (and detects a later conflict).
    false
  } else if effect_opt_is_var(right) {
    false
  } else {
    // Neither side is an effect variable: decide on the unordered label set, so
    // `{ A, B }` and `{ B, A }` (and `{ A, A }` vs `{ A }`) are compatible
    // (criterion 3). `None` (pure) vs `Some(concrete)` differ in set size and
    // stay incompatible.
    effect_label_sets_equal(left = left, right = right)
  }
}

/// Unify two effect annotations, binding an effect VARIABLE to the other side
/// (#626 criterion 4 — no longer an unconditional wildcard). Returns the extended
/// substitution, or None on a genuine effect-set conflict.
export fn unify_effects(ea: Option[String], eb: Option[String], s: Subst) -> Option[Subst] {
  let ra = semantic_effect_opt(resolve_effect_opt(s = s, eff = ea))
  let rb = semantic_effect_opt(resolve_effect_opt(s = s, eff = eb))
  let a_is_var = match ra {
    Some(n) => is_effect_var_name(n),
    None => false
  }
  let b_is_var = match rb {
    Some(n) => is_effect_var_name(n),
    None => false
  }
  if a_is_var {
    match ra {
      Some(av) => if Some(av) == rb {
        Some(s)
      } else {
        let bval = match rb {
          Some(bv) => bv,
          None => ""
        }
        Some(SubstEffBind(av, bval, s))
      },
      None => Some(s)
    }
  } else if b_is_var {
    match rb {
      Some(bv) => {
        let aval = match ra {
          Some(av) => av,
          None => ""
        }
        Some(SubstEffBind(bv, aval, s))
      },
      None => Some(s)
    }
  } else {
    match unify_open_rows(ra = ra, rb = rb, s = s) {
      Some(result) => result,
      None => if effect_names_compatible(left = ra, right = rb) {
        Some(s)
      } else {
        None
      }
    }
  }
}

/// #3575: a resolved row split into its concrete labels and its row
/// variables.
fn open_row_parts(_ row: Option[String]) -> (Array[String], Array[String]) {
  let concrete = array_empty()
  let vars = array_empty()
  for label in effect_label_list(row) {
    if is_effect_var_name(label) {
      Array::push(vars, value = label)
    } else {
      Array::push(concrete, value = label)
    }
  }
  (concrete, vars)
}

/// Does `labels` name `label`, compared as row set-equality compares them
/// (`effect_label_base_name`)?
fn row_labels_name(labels: Array[String], label: String) -> Bool {
  let base = effect_label_base_name(label)
  let mut found = false
  for l in labels {
    if !found && effect_label_base_name(l) == base {
      found = true
    }
  }
  found
}

fn row_labels_subset(small: Array[String], big: Array[String]) -> Bool {
  let mut ok = true
  for l in small {
    if ok && !row_labels_name(labels = big, label = l) {
      ok = false
    }
  }
  ok
}

/// The labels of `big` that `small` does not name, then `tail` (a row
/// variable, or "" for none), as one row.
fn row_labels_rest(big: Array[String], small: Array[String], tail: String) -> String {
  let out = array_empty()
  for l in big {
    if !row_labels_name(labels = small, label = l) && !row_labels_name(labels = out, label = l) {
      Array::push(out, value = l)
    }
  }
  if String::length(tail) > 0 {
    Array::push(out, value = tail)
  }
  String::join(out, sep = ", ")
}

/// #3575: unify two rows when one of them is OPEN -- concrete labels beside
/// one row variable, `Console + e`. The variable takes the labels of the other
/// side that the concrete part does not name: `Console + e` against `Console +
/// Fs` binds `e := Fs`, and against `Console + Fs + f` binds `e := Fs + f`.
/// Before, the two rows were compared as label SETS, the variable counting as
/// one more label, so `Console + e` met only `Console + e` and a callback with
/// any further effect was refused as dropping it.
///
/// None when neither row is open in this sense (the caller compares the sets
/// as before); Some(None) when the rows cannot be made equal -- a concrete
/// label of the open side that the other side lacks, which no binding of the
/// variable can supply; Some(Some(s')) otherwise. Two open rows of different
/// variables are unified only when one concrete part contains the other; the
/// general case would need a fresh third variable, and is refused as before.
fn unify_open_rows(ra: Option[String], rb: Option[String], s: Subst) -> Option[Option[Subst]] {
  if row_text_names_var(ra) || row_text_names_var(rb) {
    unify_open_row_parts(ra = ra, rb = rb, s = s)
  } else {
    None
  }
}

/// Does the row text name a row variable (`e`, `$4`) among its labels? Read
/// in place, so the common call -- two closed rows -- allocates nothing.
fn row_text_names_var(_ row: Option[String]) -> Bool {
  match row {
    None => false,
    Some(text) => {
      let n = String::length(text)
      let mut found = false
      let mut start = 0
      let mut i = 0
      while i <= n && !found {
        if i == n || String::char_code_at(text, at = i) == 44 {
          let mut a = start
          while a < i && String::char_code_at(text, at = a) == 32 {
            a = a + 1
          }
          let mut b = i
          while b > a && String::char_code_at(text, at = b - 1) == 32 {
            b = b - 1
          }
          let c = if b > a {
            String::char_code_at(text, at = a)
          } else {
            0
          }
          if (b - a == 1 && c >= 97 && c <= 122) || (b - a >= 2 && c == 36) {
            found = true
          }
          start = i + 1
        }
        i = i + 1
      }
      found
    }
  }
}

fn unify_open_row_parts(ra: Option[String], rb: Option[String], s: Subst) -> Option[Option[Subst]] {
  let (ca, va) = open_row_parts(ra)
  let (cb, vb) = open_row_parts(rb)
  let na = Array::length(va)
  let nb = Array::length(vb)
  if na > 1 || nb > 1 || na + nb == 0 {
    None
  } else if na == 1 && nb == 1 {
    let v = Array::get(va, at = 0)
    let w = Array::get(vb, at = 0)
    if v == w {
      None
    } else if row_labels_subset(small = ca, big = cb) {
      Some(Some(SubstEffBind(v, row_labels_rest(big = cb, small = ca, tail = w), s)))
    } else if row_labels_subset(small = cb, big = ca) {
      Some(Some(SubstEffBind(w, row_labels_rest(big = ca, small = cb, tail = v), s)))
    } else {
      Some(None)
    }
  } else if na == 1 {
    if row_labels_subset(small = ca, big = cb) {
      Some(Some(SubstEffBind(Array::get(va, at = 0), row_labels_rest(big = cb, small = ca, tail = ""), s)))
    } else {
      Some(None)
    }
  } else if row_labels_subset(small = cb, big = ca) {
    Some(Some(SubstEffBind(Array::get(vb, at = 0), row_labels_rest(big = ca, small = cb, tail = ""), s)))
  } else {
    Some(None)
  }
}

/// #3575: the open row variable of `expected`'s row that a function value of
/// type `actual` must widen, and the labels it takes: `actual` performs labels
/// the concrete part of `expected` does not name, and lacks some that it does
/// (`with Env` given to `with Console + e`). A function with fewer effects is
/// assignable to a slot that allows more, so `e := Env` is the binding; plain
/// unification cannot find it because the rows are not equal. An open value
/// row passes its own variable on (`with Fs + f` binds `e := Fs + f`). None
/// for any other shape, including an exception label among the extra ones,
/// whose kinds the assignability check judges on its own (#3540).
export fn open_row_widening(expected: Option[String], actual: Option[String], s: Subst) -> Option[Subst] {
  // A slot whose row names no variable has none to widen; resolving cannot
  // introduce one.
  if row_text_names_var(expected) {
    open_row_widening_parts(expected = expected, actual = actual, s = s)
  } else {
    None
  }
}

fn open_row_widening_parts(expected: Option[String], actual: Option[String], s: Subst) -> Option[Subst] {
  let (ce, ve) = open_row_parts(semantic_effect_opt(resolve_effect_opt(s = s, eff = expected)))
  let (ca, va) = open_row_parts(semantic_effect_opt(resolve_effect_opt(s = s, eff = actual)))
  if Array::length(ve) != 1 || Array::length(va) > 1 || Array::length(ce) == 0 || row_labels_subset(small = ce, big = ca) || row_labels_subset(small = ca, big = ce) {
    None
  } else {
    let v = Array::get(ve, at = 0)
    // An open value row (`Fs + f`) hands its variable on: `e := Fs + f`.
    let tail = if Array::length(va) == 1 {
      Array::get(va, at = 0)
    } else {
      ""
    }
    let mut exception = false
    for l in ca {
      if is_exception_label(l) && !row_labels_name(labels = ce, label = l) {
        exception = true
      }
    }
    if exception || tail == v {
      None
    } else {
      Some(SubstEffBind(v, row_labels_rest(big = ca, small = ce, tail = tail), s))
    }
  }
}

export fn types_equal(a: Type, b: Type) -> Bool {
  match a {
    CtInt => match b {
      CtInt => true,
      _ => false
    },
    CtDouble => match b {
      CtDouble => true,
      _ => false
    },
    CtFloat => match b {
      CtFloat => true,
      _ => false
    },
    CtInt32 => match b {
      CtInt32 => true,
      _ => false
    },
    CtUInt32 => match b {
      CtUInt32 => true,
      _ => false
    },
    CtBool => match b {
      CtBool => true,
      _ => false
    },
    CtString => match b {
      CtString => true,
      _ => false
    },
    CtChar => match b {
      CtChar => true,
      _ => false
    },
    CtUnit => match b {
      CtUnit => true,
      _ => false
    },
    CtBytes => match b {
      CtBytes => true,
      _ => false
    },
    CtUnknown => match b {
      CtUnknown => true,
      _ => false
    },
    CtVar(aid) => match b {
      CtVar(bid) => (aid == bid),
      _ => false
    },
    CtConstructor(aname, aarity) => match b {
      CtConstructor(bname, barity) => aname == bname && aarity == barity,
      _ => false
    },
    CtApplied(ahead, aargs) => match b {
      CtApplied(bhead, bargs) => if Array::length(aargs) != Array::length(bargs) || !types_equal(a = ahead, b = bhead) {
        false
      } else {
        let mut ai = 0
        let mut equal = true
        while ai < Array::length(aargs) && equal {
          equal = types_equal(a = Array::get(aargs, at = ai), b = Array::get(bargs, at = ai))
          ai = ai + 1
        }
        equal
      },
      _ => false
    },
    CtArray(aelem) => match b {
      CtArray(belem) => types_equal(a = aelem, b = belem),
      _ => false
    },
    CtOption(aelem) => match b {
      CtOption(belem) => types_equal(a = aelem, b = belem),
      _ => false
    },
    CtEnum(aname) => match b {
      CtEnum(bname) => aname == bname,
      // A bare named type `CtNamed(X, [])` (zero type args) denotes the same
      // type as the enum `CtEnum(X)`. Cross-module imports can resolve a
      // self-referential enum ctor field type to one form and a function
      // annotation to the other; bridge them so they unify.
      CtNamed(bname, bargs) => aname == bname && Array::length(bargs) == 0,
      _ => false
    },
    CtStruct(aname) => match b {
      CtStruct(bname) => aname == bname,
      CtNamed(bname, bargs) => aname == bname && Array::length(bargs) == 0,
      _ => false
    },
    CtNamed(aname, aargs) => match b {
      CtEnum(bname) => aname == bname && Array::length(aargs) == 0,
      CtStruct(bname) => aname == bname && Array::length(aargs) == 0,
      CtNamed(bname, bargs) =>
      if aname != bname {
        false
      } else if Array::length(aargs) != Array::length(bargs) {
        false
      } else {
        let tae_len = Array::length(aargs)
        let mut tae_i = 0
        let mut tae_result = true
        let mut tae_done = false
        while !tae_done {
          if tae_i >= tae_len {
            tae_done = true
          } else {
            if types_equal(a = Array::get(aargs, at = tae_i), b = Array::get(bargs, at = tae_i)) {
              tae_i = tae_i + 1
            } else {
              tae_result = false
              tae_done = true
            }
          }
        }
        tae_result
      },
      _ => false
    },
    CtTuple(aelems) => match b {
      CtTuple(belems) =>
      if Array::length(aelems) != Array::length(belems) {
        false
      } else {
        let tae_len2 = Array::length(aelems)
        let mut tae_i2 = 0
        let mut tae_result2 = true
        let mut tae_done2 = false
        while !tae_done2 {
          if tae_i2 >= tae_len2 {
            tae_done2 = true
          } else {
            if types_equal(a = Array::get(aelems, at = tae_i2), b = Array::get(belems, at = tae_i2)) {
              tae_i2 = tae_i2 + 1
            } else {
              tae_result2 = false
              tae_done2 = true
            }
          }
        }
        tae_result2
      },
      _ => false
    },
    // #1839: records are structural with LITERAL field order (order IS the
    // runtime slot layout), so equality is order-sensitive: same names in the
    // same positions with equal types.
    CtRecord(arf) => match b {
      CtRecord(brf) =>
      if Array::length(arf) != Array::length(brf) {
        false
      } else {
        let rql = Array::length(arf)
        let mut rqi = 0
        let mut rq_result = true
        let mut rq_done = false
        while !rq_done {
          if rqi >= rql {
            rq_done = true
          } else {
            let (afn, aft) = Array::get(arf, at = rqi)
            let (bfn, bft) = Array::get(brf, at = rqi)
            if afn == bfn && types_equal(a = aft, b = bft) {
              rqi = rqi + 1
            } else {
              rq_result = false
              rq_done = true
            }
          }
        }
        rq_result
      },
      _ => false
    },
    CtFn(aparams, aret, aeffect) => match b {
      CtFn(bparams, bret, beffect) =>
      if Array::length(aparams) != Array::length(bparams) {
        false
      } else if effect_names_compatible(left = aeffect, right = beffect) {
        let tae_len3 = Array::length(aparams)
        let mut tae_i3 = 0
        let mut tae_result3 = true
        let mut tae_done3 = false
        while !tae_done3 {
          if tae_i3 >= tae_len3 {
            tae_done3 = true
          } else {
            if types_equal(a = Array::get(aparams, at = tae_i3), b = Array::get(bparams, at = tae_i3)) {
              tae_i3 = tae_i3 + 1
            } else {
              tae_result3 = false
              tae_done3 = true
            }
          }
        }
        if tae_result3 {
          types_equal(a = aret, b = bret)
        } else {
          false
        }
      } else {
        false
      },
      _ => false
    },
    CtForAll(avars, abounds, abody) => match b {
      CtForAll(bvars, bbounds, bbody) => if Array::length(avars) != Array::length(bvars) {
        false
      } else if Array::length(abounds) != Array::length(bbounds) {
        false
      } else {
        let vlen = Array::length(avars)
        let mut vi = 0
        let mut vresult = true
        let mut vdone = false
        while !vdone {
          if vi >= vlen {
            vdone = true
          } else if Array::get(avars, at = vi) != Array::get(bvars, at = vi) {
            vresult = false
            vdone = true
          } else {
            vi = vi + 1
          }
        }
        if vresult {
          let fbe_len = Array::length(abounds)
          let mut fbe_i = 0
          let mut fbe_result = true
          let mut fbe_done = false
          while !fbe_done {
            if fbe_i >= fbe_len {
              fbe_done = true
            } else {
              let (lvar, lbounds) = Array::get(abounds, at = fbe_i)
              let (rvar, rbounds) = Array::get(bbounds, at = fbe_i)
              if lvar != rvar {
                fbe_result = false
                fbe_done = true
              } else if Array::length(lbounds) != Array::length(rbounds) {
                fbe_result = false
                fbe_done = true
              } else {
                if string_array_equal(left = lbounds, right = rbounds) {
                  fbe_i = fbe_i + 1
                } else {
                  fbe_result = false
                  fbe_done = true
                }
              }
            }
          }
          if fbe_result {
            types_equal(a = abody, b = bbody)
          } else {
            false
          }
        } else {
          false
        }
      }
      ,
      _ => false
    }
  }
}

/// `Char` is a transparent alias of `Int`: char literals (`'A'`) lex to integer
/// tokens (TInt, see lexer.vibe lex_char), so a value of Char and a value of Int
/// share one runtime representation and must unify freely — a `Char` annotation
/// accepts an int value and vice versa (`'A' == 65`, `c + 1`, char_test).
export fn type_application_view(_ ty: Type) -> Option[(Type, Array[Type])] {
  match ty {
    CtApplied(head, args) => Some((head, args)),
    CtArray(elem) => Some((CtConstructor("Array", 1), [elem])),
    CtOption(elem) => Some((CtConstructor("Option", 1), [elem])),
    CtNamed(name, args) => if Array::length(args) > 0 {
      Some((CtConstructor(name, Array::length(args)), args))
    } else {
      None
    },
    _ => None
  }
}

export fn char_int_compatible(ta: Type, tb: Type) -> Bool {
  match ta {
    CtChar => match tb {
      CtInt => true,
      _ => false
    },
    CtInt => match tb {
      CtChar => true,
      _ => false
    },
    _ => false
  }
}
