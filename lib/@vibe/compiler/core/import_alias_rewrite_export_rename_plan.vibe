/// Binary search over the sorted list: the rename asks this of every
/// top-level definition on every run, and the list is a couple of hundred
/// names. `builtin_shadow_rename_names_are_sorted` pins the order.
fn is_builtin_shadow_rename_name(name: String) -> Bool {
  bsearch_leftmost(builtin_shadow_rename_names, name) >= 0
}

/// Whether the literal list is strictly sorted, which the binary search in
/// `is_builtin_shadow_rename_name` requires. Exported for the test that pins it.
export fn builtin_shadow_rename_names_are_sorted() -> Bool {
  let mut ok = true
  let mut i = 1
  while ok && i < Array::length(builtin_shadow_rename_names) {
    ok = str_lt(Array::get(builtin_shadow_rename_names, i - 1), Array::get(builtin_shadow_rename_names, i))
    i = i + 1
  }
  ok
}

/// Whether a program's own top-level definition of `name` is moved aside by
/// `rename_builtin_shadow_defs`, for the tests that walk the list.
export fn builtin_shadow_renames_name(name: String) -> Bool {
  is_builtin_shadow_rename_name(name)
}

/// The spelling a program's own definition of a compiler-called builtin is
/// renamed to. `$` cannot appear in a source identifier, so no program can
/// declare it and no user call can collide with it.
export fn builtin_shadow_rename_of(name: String) -> String {
  String::concat(name, "$user")
}

/// The source spelling of a function name: `builtin_shadow_rename_of`
/// undone, any other name unchanged. The rename is internal to one
/// compilation; what leaves it -- a wasm export of a library that defines
/// `export fn Array::length` -- keeps the name the program wrote (#3132
/// review), so an importer finds `Array::length`, not `Array::length$user`.
/// The name the compilation knows the ENTRY by (#3132 review). `vibe build
/// --entry StringBuilder::new` names the program's own function, which the
/// rename moves to `StringBuilder::new$user`; every internal lookup and DCE
/// root has to use that spelling while the export keeps the source one
/// (`builtin_shadow_source_name`). Answers the same before or after the
/// rename has run, since the lanes differ in where they run it.
export fn builtin_shadow_entry_name(stmts: Array[Stmt], entry_name: String) -> String {
  if !is_builtin_shadow_rename_name(entry_name) {
    entry_name
  } else {
    let renamed = builtin_shadow_rename_of(entry_name)
    let mut found = false
    let mut i = 0
    while !found && i < Array::length(stmts) {
      let name = match Array::get(stmts, i) {
        SLet(_, _, n, _, _) => n,
        SFnDecl(_, n, _, _, _) => n,
        _ => ""
      }
      if name == entry_name || name == renamed {
        found = true
      } else {
        i = i + 1
      }
    }
    if found {
      renamed
    } else {
      entry_name
    }
  }
}

export fn builtin_shadow_source_name(name: String) -> String {
  let suffix = "$user"
  let n = String::length(name)
  let k = String::length(suffix)
  if n > k && String::ends_with(name, suffix) && is_builtin_shadow_rename_name(name[0: n - k]) {
    name[0: n - k]
  } else {
    name
  }
}

/// #3132: a program may define its own top-level `Array::length`,
/// `Map::keys`, ... The checker resolves the program's calls to that
/// definition, but everything downstream is keyed by NAME -- the lowerings
/// that call `Array::get` to walk an array, the desugarings that synthesize
/// `Array::length` for a for-in or an interpolation, the ladders, the
/// borrow tables -- and each of those meant the builtin. Resolved by name,
/// they reached the program's function instead: a for-in, `Array::map`,
/// `Map::keys`, `"\{xs}"` and `==` on arrays compiled to invalid wasm or
/// answered with the program's sentinel.
///
/// So give the program's definition, and every reference to its name, a
/// spelling of its own, and leave the builtin name to mean the builtin
/// everywhere after this pass. The one exception is a reference the COMPILER
/// wrote -- the parser's index-assignment and spread sugar, interpolation's
/// joins, the effect lowerings -- which every such pass spells with
/// `builtin_ref` and so carries `builtin_ref_offset()`. Provenance is that
/// explicit mark, not the absence of a source offset: interpolation
/// re-parses the program's own expressions without offsets, and the library
/// lanes parse whole programs without them (#3132 review), so a program's
/// call can carry -1 too. scripts/review_lint.vibex refuses a bare listed
/// `EIdent` outside codegen, which runs after every rename point.
///
/// Re-runnable, and deliberately so (#3144 round 4): a definition already
/// renamed still puts its SOURCE spelling in the table, so a later run renames
/// the references a pass wrote SINCE by computing a name rather than spelling
/// a literal. The trait-dictionary desugar builds a witness field as
/// `<Type>::<method>`, which for `impl Measured for String { length(..) }` is
/// `String::length`, the impl's own binding; left alone it reached the
/// builtin, and `measure("abc")` through `[T: Measured]` answered 3 instead
/// of the impl's 42. So one sentence holds for every pass: a reference means
/// the program's definition unless it was written with `builtin_ref`. With no
/// listed definition a run is one top-level scan and changes nothing.
///
/// An `export { Array::length }` block is renamed with its definition. Every
/// consumer of an export block matches its entries against declaration names
/// (the split prelude's interface filter, the GC lane's direct-ABI "is this
/// public" test, DCE roots), so an entry left in the source spelling named a
/// declaration that no longer existed. What leaves the compilation keeps the
/// source spelling through `builtin_shadow_source_name`.
///
/// Must run on the WHOLE program; a module partition cannot see a definition
/// in another module.
///
/// #3185: a PRIVATE definition renames the references of its own source unit
/// only. A unit is one file of the merge -- the statements after one
/// `SReExportSourceBoundary` (or its serialized carrier) -- and a private
/// definition that keeps a builtin's spelling after the merge is the entry
/// file's own (every other file's private names are namespaced), which no
/// other file can see: the checker typed each dependency's `Array::get` as the
/// builtin. Renamed program-wide, a dependency's call reached the entry's
/// function instead -- measured, `first([5, 6])` from a module whose
/// `Array::get(xs, 0)` was the builtin answered the entry's 77. So a reference
/// in another unit is marked as the builtin's (`builtin_ref`, keyed with its
/// own offset as `index_site_key` keys an index site), which also keeps every
/// later run from taking it. A published definition (`export`, or named in an
/// `export { }` list) still renames program-wide, as a library's qualified
/// export always has (#2378). A program with no boundaries is one unit.
export fn rename_builtin_shadow_defs(stmts: Array[Stmt]) -> Unit {
  rewrite_builtin_shadow_refs(stmts, true)
}

/// Preserve module-private builtin provenance before a merged source check.
/// Definitions and owned references keep their source names so method checking
/// still sees its original environment. The later rename owns definitions.
export fn mark_private_builtin_references(stmts: Array[Stmt]) -> Unit {
  rewrite_builtin_shadow_refs(stmts, false)
}

fn rewrite_builtin_shadow_refs(stmts: Array[Stmt], rename_defs: Bool) -> Unit {
  let published = empty_aliases()
  let private_defs: Array[(String, Int)] = []
  let listed_exports = builtin_shadow_export_items(stmts)
  let mut unit = 0
  let mut i = 0
  while i < Array::length(stmts) {
    let stmt = Array::get(stmts, i)
    if is_source_unit_boundary(stmt) {
      unit = unit + 1
    } else {
      let (name, exported) = match stmt {
        SLet(e, _, n, _, _) => (n, e),
        SFnDecl(e, n, _, _, _) => (n, e),
        _ => ("", false)
      }
      let source = builtin_shadow_source_name(name)
      if name != "" && is_builtin_shadow_rename_name(source) {
        if exported || builtin_shadow_name_in_unit(listed_exports, source, unit) {
          if !builtin_shadow_rename_listed(published, source) {
            Array::push(published, (source, builtin_shadow_rename_of(source)))
          } else {
            ()
          }
        } else if !builtin_shadow_name_in_unit(private_defs, source, unit) {
          Array::push(private_defs, (source, unit))
        } else {
          ()
        }
      } else {
        ()
      }
    }
    i = i + 1
  }
  if Array::length(published) == 0 && Array::length(private_defs) == 0 {
    ()
  } else {
    // One map per unit that owns a private definition, and one for every
    // other unit; almost always the entry's and the rest.
    let owner_units: Array[Int] = []
    let owner_maps: Array[AliasIdx] = []
    let other_map = aliasidx_build_mode(builtin_shadow_unit_renames(published, private_defs, 0 - 1, rename_defs), true)
    let mut si = 0
    let mut su = 0
    while si < Array::length(stmts) {
      let stmt = Array::get(stmts, si)
      if is_source_unit_boundary(stmt) {
        su = su + 1
      } else {
        let am = if builtin_shadow_unit_owns(private_defs, su) {
          builtin_shadow_owner_map(owner_units, owner_maps, published, private_defs, su, rename_defs)
        } else {
          other_map
        }
        match stmt {
          SLet(exported, is_rec, name, ty, body) => {
            let new_name = if rename_defs && is_builtin_shadow_rename_name(name) {
              builtin_shadow_rename_of(name)
            } else {
              name
            }
            Array::set(stmts, si, SLet(exported, is_rec, new_name, ty, rewrite_alias_expr_ix(body, am)))
          },
          SFnDecl(exported, name, value, reqs, enss) => {
            let new_name = if rename_defs && is_builtin_shadow_rename_name(name) {
              builtin_shadow_rename_of(name)
            } else {
              name
            }
            Array::set(stmts, si, SFnDecl(exported, new_name, rewrite_alias_expr_ix(value, am), rewrite_alias_exprs_ix(reqs, am), rewrite_alias_exprs_ix(enss, am)))
          },
          SLetMut(name, ty, body) => Array::set(stmts, si, SLetMut(name, ty, rewrite_alias_expr_ix(body, am))),
          STest(name, body) => Array::set(stmts, si, STest(name, rewrite_alias_expr_ix(body, am))),
          SBench(name, body) => Array::set(stmts, si, SBench(name, rewrite_alias_expr_ix(body, am))),
          SExpr(body) => Array::set(stmts, si, SExpr(rewrite_alias_expr_ix(body, am))),
          SLetPat(pat, body) => Array::set(stmts, si, SLetPat(pat, rewrite_alias_expr_ix(body, am))),
          SExport(items) => Array::set(stmts, si, SExport(for item in items {
            if rename_defs && builtin_shadow_rename_listed(published, item) {
              builtin_shadow_rename_of(item)
            } else {
              item
            }
          })),
          _ => ()
        }
      }
      si = si + 1
    }
  }
}

/// #3185: whether `stmt` opens a source unit of a merge: the boundary itself,
/// or the carrier a source-text cache serializes it to.
fn is_source_unit_boundary(stmt: Stmt) -> Bool {
  match stmt {
    SReExportSourceBoundary(_, _) => true,
    SImport(_, _) => match builtin_iterator_serialized_boundary_markers(stmt) {
      Some(_) => true,
      None => false
    },
    _ => false
  }
}

/// The names every `export { .. }` list publishes, paired with its source
/// unit. A list in a dependency cannot publish a private entry-file binding
/// with the same spelling. A previous run may have renamed a listed name.
fn builtin_shadow_export_items(stmts: Array[Stmt]) -> Array[(String, Int)] {
  let out: Array[(String, Int)] = []
  let mut unit = 0
  let mut i = 0
  while i < Array::length(stmts) {
    let stmt = Array::get(stmts, i)
    if is_source_unit_boundary(stmt) {
      unit = unit + 1
    } else {
      match stmt {
        SExport(items) => {
          let mut j = 0
          while j < Array::length(items) {
            Array::push(out, (builtin_shadow_source_name(Array::get(items, j)), unit))
            j = j + 1
          }
        },
        _ => ()
      }
    }
    i = i + 1
  }
  out
}

fn builtin_shadow_name_in_unit(items: Array[(String, Int)], name: String, unit: Int) -> Bool {
  let mut found = false
  let mut i = 0
  while !found && i < Array::length(items) {
    let (listed, owner) = Array::get(items, i)
    found = listed == name && owner == unit
    i = i + 1
  }
  found
}

fn builtin_shadow_unit_owns(private_defs: Array[(String, Int)], unit: Int) -> Bool {
  let mut found = false
  let mut i = 0
  while !found && i < Array::length(private_defs) {
    let (_, u) = Array::get(private_defs, i)
    if u == unit {
      found = true
    } else {
      i = i + 1
    }
  }
  found
}

/// The rename map for the statements of `unit` (-1: a unit that owns no
/// private definition). Published definitions rename everywhere; a private
/// definition renames in its own unit, and elsewhere its spelling maps to
/// itself, which the rewrite reads as "mark this reference as the builtin's".
fn builtin_shadow_unit_renames(published: Array[(String, String)], private_defs: Array[(String, Int)], unit: Int, rename_defs: Bool) -> Array[(String, String)] {
  let out = empty_aliases()
  let mut i = 0
  while i < Array::length(published) {
    Array::push(out, Array::get(published, i))
    i = i + 1
  }
  let mut j = 0
  while j < Array::length(private_defs) {
    let (source, u) = Array::get(private_defs, j)
    if builtin_shadow_rename_listed(out, source) {
      ()
    } else if u == unit {
      Array::push(out, (source, builtin_shadow_rename_of(source)))
    } else if !builtin_shadow_name_in_unit(private_defs, source, unit) {
      Array::push(out, (source, source))
    } else {
      ()
    }
    j = j + 1
  }
  if rename_defs {
    out
  } else {
    let marked = empty_aliases()
    for row in out {
      if row.0 == row.1 {
        Array::push(marked, row)
      } else {
        ()
      }
    }
    marked
  }
}

fn builtin_shadow_owner_map(owner_units: Array[Int], owner_maps: Array[AliasIdx], published: Array[(String, String)], private_defs: Array[(String, Int)], unit: Int, rename_defs: Bool) -> AliasIdx {
  let mut found = 0 - 1
  let mut i = 0
  while found < 0 && i < Array::length(owner_units) {
    if Array::get(owner_units, i) == unit {
      found = i
    } else {
      i = i + 1
    }
  }
  if found >= 0 {
    Array::get(owner_maps, found)
  } else {
    let am = aliasidx_build_mode(builtin_shadow_unit_renames(published, private_defs, unit, rename_defs), true)
    Array::push(owner_units, unit)
    Array::push(owner_maps, am)
    am
  }
}

fn builtin_shadow_rename_listed(renames: Array[(String, String)], name: String) -> Bool {
  let mut found = false
  let mut i = 0
  while !found && i < Array::length(renames) {
    let (source, _) = Array::get(renames, i)
    if source == name {
      found = true
    } else {
      i = i + 1
    }
  }
  found
}

fn private_alias_pattern_collides_with_local_ctor(stmts: Array[Stmt], variant: String, imported_ctor: String) -> Bool {
  for stmt in stmts {
    let ctors = match stmt {
      SEnum(false, _, _, members, _) => members,
      SSuberror(false, _, members) => members,
      _ => []
    }
    for ctor in ctors {
      if ctor.0 != imported_ctor && ctor.0 != variant && namespace_rename_original(ctor.0) == variant {
        return true
      }
    }
  }
  false
}

/// Like append_import_alias_rewritten_non_import_stmts_skipping, but with
/// extra (local -> mangled) import-value renames applied in the same pass.
/// Locals covered by `extra_renames` are removed from the legacy alias map
/// (which would rewrite alias -> original instead).
fn private_alias_pattern_renames(stmts: Array[Stmt], extra_renames: Array[(String, String)]) -> Array[(String, String)] with Exception {
  let local_type_aliases = collect_local_type_aliases(stmts)
  let refs: Array[(String, String)] = []
  for stmt in stmts {
    match stmt {
      SQualifiedPatternRefs(rows) => for row in rows {
        let qualifier = if row.0 == "" {
          ""
        } else {
          local_pattern_qualifier_head(row.0, local_type_aliases, Array::length(local_type_aliases) + 1)
        }
        Array::push(refs, (qualifier, row.1))
      },
      _ => ()
    }
  }
  let out = empty_aliases()
  for rename in extra_renames {
    let (local, target) = rename
    let split = String::index_of(local, "::")
    if split > 0 {
      let head = local[0: split]
      let variant = local[split + 2: String::length(local)]
      if String::starts_with(target, variant + "_dep_") {
        let mut matching = false
        let mut competing = false
        for row in refs {
          if row.1 == variant {
            if row.0 == head {
              matching = true
            } else {
              let other_target = if row.0 == "" {
                None
              } else {
                lookup_alias(extra_renames, row.0 + "::" + variant)
              }
              match other_target {
                Some(other) => if other != target {
                  competing = true
                },
                None => competing = true
              }
            }
          }
        }
        if matching {
          if private_alias_pattern_collides_with_local_ctor(stmts, variant, target) {
            throw("rename this module's private variant `" + variant + "` or move the imported `" + local + "` match to a separate module: constructor patterns with this spelling cannot be distinguished after parsing")
          }
          if competing {
            throw("rename one of the variants named `" + variant + "` or place its match in a separate module: qualified and other patterns with that constructor name cannot be distinguished after parsing")
          }
          match lookup_alias(out, variant) {
            Some(previous) => if previous != target {
              throw("rename one of the variants named `" + variant + "` or place its match in a separate module: two private enum aliases need different constructors")
            },
            None => Array::push(out, (variant, target))
          }
        }
      }
    }
  }
  out
}

export fn append_import_alias_rewritten_non_import_stmts_with_renames(merged: Array[Stmt], stmts: Array[Stmt], skipped_locals: Array[String], extra_renames: Array[(String, String)]) -> Unit with Exception {
  let legacy = alias_map_without_names(alias_map_without_names(collect_import_aliases(stmts), skipped_locals), import_value_rename_locals(extra_renames))
  let combined = empty_aliases()
  let mut li = 0
  while li < Array::length(legacy) {
    Array::push(combined, Array::get(legacy, li))
    li = li + 1
  }
  let mut xi = 0
  while xi < Array::length(extra_renames) {
    Array::push(combined, Array::get(extra_renames, xi))
    xi = xi + 1
  }
  let rewritten = rewrite_import_alias_stmts_with_pattern_ctors(stmts, combined, private_alias_pattern_renames(stmts, extra_renames))
  let mut i = 0
  while i < Array::length(stmts) {
    let stmt = Array::get(stmts, i)
    match stmt {
      SImport(path, items) => if is_builtin_iterator_serialized_boundary_path(path) {
        Array::push(merged, stmt)
      } else {
        append_stdin_provider_import_alias_markers(merged, items)
      },
      SReExport(_, _) => (),
      SAliasDecl(_, _) => (),
      _ => Array::push(merged, Array::get(rewritten, i))
    }
    i = i + 1
  }
}
