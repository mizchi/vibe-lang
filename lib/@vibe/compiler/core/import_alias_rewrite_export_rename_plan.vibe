fn stmts_define_iterator_namespace_operation(stmts: Array[Stmt], namespace: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(stmts) && !found {
    found = match Array::get(stmts, i) {
      SLet(_, _, name, _, _) => iterator_namespace_operation(name, namespace),
      SFnDecl(_, name, _, _, _) => iterator_namespace_operation(name, namespace),
      SImport(path, items) => if is_builtin_iterator_serialized_boundary_path(path) {
        false
      } else {
        import_items_bind_iterator_namespace_operation(items, namespace)
      },
      SReExport(_, items) => import_items_bind_iterator_namespace_operation(items, namespace),
      _ => false
    }
    i = i + 1
  }
  found
}

/// Import bindings use source order: the last trait imported into a local
/// namespace is the one whose companion operations that namespace denotes.
/// Provenance must follow that same winner. Retaining the builtin marker after
/// a custom trait replaces it would silently turn the custom operation back
/// into an Array intrinsic during dictionary desugaring.
fn builtin_iterator_trait_wins_namespace(stmts: Array[Stmt], namespace: String) -> Bool {
  let mut wins = false
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SImport(path, items) => {
        let mut j = 0
        while j < Array::length(items) {
          let item = Array::get(items, j)
          let explicit_trait = match item.kind {
            Some(ImportTrait) => true,
            _ => false
          }
          let local = match item.alias {
            Some(alias) => alias,
            None => item.name
          }
          if explicit_trait && local == namespace {
            wins = path == "@vibe/builtin" && item.name == "Iterator"
          } else {
            ()
          }
          j = j + 1
        }
      },
      SReExport(_, items) => {
        let mut j = 0
        while j < Array::length(items) {
          let item = Array::get(items, j)
          let explicit_trait = match item.kind {
            Some(ImportTrait) => true,
            _ => false
          }
          let local = match item.alias {
            Some(alias) => alias,
            None => item.name
          }
          if explicit_trait && local == namespace {
            // Only a direct @vibe/builtin import carries authenticated
            // provenance here. A re-export may name any provider.
            wins = false
          } else {
            ()
          }
          j = j + 1
        }
      },
      STrait(_, name, _, _, _, _) => if name == namespace {
        wins = false
      } else {
        ()
      },
      _ => ()
    }
    i = i + 1
  }
  wins
}

/// Compiler-only provenance carried in an existing source-boundary marker.
/// It is emitted only when this source unit explicitly imports the standard
/// Iterator trait and does not replace any optimized namespace operation.
/// The marker is consumed before codegen and never becomes a runtime value.
export fn builtin_iterator_namespace_markers(stmts: Array[Stmt]) -> Array[String] {
  let out = empty_strings()
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SImport(path, items) => if path == "@vibe/builtin" {
        let mut j = 0
        while j < Array::length(items) {
          let item = Array::get(items, j)
          let explicit_trait = match item.kind {
            Some(ImportTrait) => true,
            _ => false
          }
          if explicit_trait && item.name == "Iterator" {
            let local = match item.alias {
              Some(alias) => alias,
              None => item.name
            }
            // Trait-alias value namespaces remain local (`Iter::*`); only type
            // occurrences canonicalize to the provider. Therefore a local
            // canonical `Iterator::*` helper is independent and cannot block
            // provenance for the imported alias.
            if builtin_iterator_trait_wins_namespace(stmts, local) && !stmts_define_iterator_namespace_operation(stmts, local) {
              // Imported trait-operation wrappers keep the local namespace:
              // `trait Iterator as Iter` materializes `Iter::map`. Recording
              // the local spelling keeps optimization scoped to that wrapper
              // and cannot authorize a distinct local `Iterator::map`.
              let marker = String::concat(builtin_iterator_origin_marker_prefix(), local)
              if !import_alias_rewrite_string_array_contains(out, marker) {
                Array::push(out, marker)
              } else {
                ()
              }
            } else {
              ()
            }
          } else {
            ()
          }
          j = j + 1
        }
      } else {
        ()
      },
      _ => ()
    }
    i = i + 1
  }
  out
}

/// Decode a compiler-only standard Iterator provenance marker.
export fn builtin_iterator_namespace_from_marker(marker: String) -> Option[String] {
  let prefix = builtin_iterator_origin_marker_prefix()
  if String::starts_with(marker, prefix) && String::length(marker) > String::length(prefix) {
    Some(String::substring(marker, String::length(prefix), String::length(marker)))
  } else {
    None
  }
}

/// Add the unique post-link namespaces of standard Iterator operations to a
/// source boundary. Provider helpers are named
/// `Iterator_exp_<provider>::operation`, so the established namespace marker
/// path can authorize devirtualization without guessing a path from the call.
export fn append_builtin_iterator_operation_markers(markers: Array[String], renames: Array[(String, String)]) -> Unit {
  let namespaces = empty_strings()
  let mut mi = 0
  while mi < Array::length(markers) {
    match builtin_iterator_namespace_from_marker(Array::get(markers, mi)) {
      Some(namespace) => Array::push(namespaces, namespace),
      None => ()
    }
    mi = mi + 1
  }
  let mut ri = 0
  while ri < Array::length(renames) {
    let (local, resolved) = Array::get(renames, ri)
    let split = String::index_of(local, "::")
    if split > 0 {
      let namespace = String::substring(local, 0, split)
      if import_alias_rewrite_string_array_contains(namespaces, namespace) && iterator_namespace_operation(local, namespace) {
        let resolved_split = String::index_of(resolved, "::")
        if resolved_split > 0 {
          let resolved_namespace = String::substring(resolved, 0, resolved_split)
          let namespace_marker = String::concat(builtin_iterator_origin_marker_prefix(), resolved_namespace)
          if !import_alias_rewrite_string_array_contains(markers, namespace_marker) {
            Array::push(markers, namespace_marker)
          } else {
            ()
          }
        } else {
          ()
        }
      } else {
        ()
      }
    } else {
      ()
    }
    ri = ri + 1
  }
}

/// Names carried by an in-memory merged-source boundary. The first field is
/// both the local-name blocker set used by builtin desugaring and the
/// compiler-only Iterator provenance payload; the second field records
/// publication-only re-export aliases for checker projection.
export fn merged_source_boundary_names(stmts: Array[Stmt]) -> (Array[String], Array[String]) {
  let locals = empty_strings()
  let surface_only = empty_strings()
  let decided = empty_strings()
  let mut i = Array::length(stmts) - 1
  while i >= 0 {
    match Array::get(stmts, i) {
      SReExport(_, items) => {
        let mut j = Array::length(items) - 1
        while j >= 0 {
          let item = Array::get(items, j)
          let local = match item.alias {
            Some(alias) => alias,
            None => item.name
          }
          if !import_alias_rewrite_string_array_contains(decided, local) {
            Array::push(decided, local)
            Array::push(locals, local)
            match item.alias {
              Some(alias) => Array::push(surface_only, alias),
              None => ()
            }
          } else {
            ()
          }
          j = j - 1
        }
      },
      _ => ()
    }
    i = i - 1
  }
  let markers = builtin_iterator_namespace_markers(stmts)
  let mut mi = 0
  while mi < Array::length(markers) {
    let marker = Array::get(markers, mi)
    if !import_alias_rewrite_string_array_contains(locals, marker) {
      Array::push(locals, marker)
    } else {
      ()
    }
    mi = mi + 1
  }
  (locals, surface_only)
}

/// Private renames for source-local provider helpers when the same source
/// imports that provider trait under an alias. The merged program also
/// contains the provider helper; keeping both under `Provider::operation`
/// would make the wasm function table's first match decide semantics. The
/// imported trait owns `Local::*`, while a separately declared `Provider::*`
/// remains an ordinary local namespace for every trait, not only Iterator.
export fn trait_import_local_operation_renames(stmts: Array[Stmt], path: String) -> Array[(String, String)] {
  let namespaces = empty_strings()
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SImport(raw_path, items) => if !is_builtin_iterator_serialized_boundary_path(raw_path) {
        let mut j = 0
        while j < Array::length(items) {
          let item = Array::get(items, j)
          let explicit_trait = match item.kind {
            Some(ImportTrait) => true,
            _ => false
          }
          if explicit_trait {
            match item.alias {
              Some(alias) => if alias != item.name && !import_alias_rewrite_string_array_contains(namespaces, item.name) {
                Array::push(namespaces, item.name)
              } else {
                ()
              },
              None => ()
            }
          } else {
            ()
          }
          j = j + 1
        }
      },
      _ => ()
    }
    i = i + 1
  }
  let out = empty_aliases()
  i = 0
  while i < Array::length(stmts) {
    let name = match Array::get(stmts, i) {
      SLet(_, _, bound, _, _) => bound,
      SFnDecl(_, bound, _, _, _) => bound,
      _ => ""
    }
    let mut ni = 0
    let mut collides = false
    while ni < Array::length(namespaces) && !collides {
      collides = trait_namespace_operation(name, Array::get(namespaces, ni))
      ni = ni + 1
    }
    if collides {
      // Keep the private spelling outside the provider namespace. Later
      // normalization may recognize that namespace as a trait or intrinsic
      // surface, so a path suffix alone is not a sufficient fence.
      let private_name = namespace_exported_name(path, String::concat("__local_trait_", name))
      Array::push(out, (name, private_name))
    } else {
      ()
    }
    i = i + 1
  }
  out
}

/// Entry exports are part of the final wasm/library ABI. Keep their original
/// qualified spelling while retaining collision renames for private helpers.
export fn trait_import_local_operation_renames_preserving_exports(stmts: Array[Stmt], path: String) -> Array[(String, String)] {
  let renames = trait_import_local_operation_renames(stmts, path)
  let exported = collect_exported_value_names(stmts)
  let out = empty_aliases()
  let mut i = 0
  while i < Array::length(renames) {
    let rename = Array::get(renames, i)
    if !import_alias_rewrite_string_array_contains(exported, rename.0) {
      Array::push(out, rename)
    } else {
      ()
    }
    i = i + 1
  }
  out
}

/// Reject the source-spellable form of an internal provenance carrier.
/// Generated merged-source caches are parsed after the user-source boundary
/// and intentionally do not call this guard.
export fn reject_user_iterator_serialized_boundaries(stmts: Array[Stmt]) -> Unit with Exception {
  if stmts_have_user_iterator_serialized_boundary(stmts) {
    throw("remove reserved compiler import `@vibe/compiler/internal/iterator_boundary`: this path is generated internally and cannot be imported by source files")
  } else {
    ()
  }
}

/// A parseable carrier for Iterator provenance across source-text caches.
/// Ordinary in-memory merges use `SReExportSourceBoundary`; the printer drops
/// that internal node, so TypeDb/group caches need this reserved synthetic
/// import until the merged source is parsed for codegen.
export fn builtin_iterator_serialized_boundary(stmts: Array[Stmt]) -> Stmt {
  let (local_names, _) = merged_source_boundary_names(stmts)
  builtin_iterator_serialized_boundary_from_markers(local_names)
}

export fn builtin_iterator_serialized_boundary_from_markers(markers: Array[String]) -> Stmt {
  SImport(String::concat(builtin_iterator_serialized_boundary_payload_prefix(), encode_boundary_names(markers)), array_empty())
}

/// Recover marker payload from the reserved source-text cache carrier.
export fn builtin_iterator_serialized_boundary_markers(stmt: Stmt) -> Option[Array[String]] {
  match stmt {
    SImport(path, items) => if String::starts_with(path, builtin_iterator_serialized_boundary_payload_prefix()) && Array::length(items) == 0 {
      decode_boundary_names(String::substring(path, String::length(builtin_iterator_serialized_boundary_payload_prefix()), String::length(path)))
    } else if path == builtin_iterator_serialized_boundary_path() {
      // Read compatibility for source-text caches emitted before blockers
      // moved into the path payload. New carriers bind no import names.
      let markers = empty_strings()
      let mut i = 0
      while i < Array::length(items) {
        let item = Array::get(items, i)
        match item.kind {
          Some(ImportTrait) => if item.name == "Iterator" {
            let namespace = match item.alias {
              Some(alias) => alias,
              None => item.name
            }
            Array::push(markers, String::concat(builtin_iterator_origin_marker_prefix(), namespace))
          } else {
            ()
          },
          None => Array::push(markers, item.name),
          _ => ()
        }
        i = i + 1
      }
      Some(markers)
    } else {
      None
    },
    _ => None
  }
}

/// #2386: `namespace_private_value_stmts` applied to the statements the export
/// pass (`apply_export_renames_stmts` with `export_renames`) would have
/// produced -- the merge lane's pair for every non-entry file -- in ONE
/// rebuild of the tree instead of two when the two rename maps compose as a
/// single lookup, and through the two passes otherwise.
///
/// Both passes are the same walker over the same value positions, so their
/// composition is one lookup exactly when no name can answer in both maps or
/// be renamed twice: a private-rename key is neither a key nor a value of the
/// export map, a qualified private key does not carry an export-renamed head,
/// and a qualified export value does not carry a private-renamed head
/// (`alias_renames_compose`). The private renames are collected from the
/// statement heads as the export pass leaves them (a definition's name and an
/// export list are the only spellings the collectors read), so they are the
/// renames the second pass would have computed. Where the export pass and the
/// private stage visit different statement kinds, the fused walker keeps each
/// kind's own map (`namespace_private_stmt_after_renames`).
export fn namespace_private_value_stmts_after_renames(path: String, stmts: Array[Stmt], export_renames: Array[(String, String)]) -> Array[Stmt] {
  if Array::length(export_renames) == 0 {
    namespace_private_value_stmts(path, stmts)
  } else {
    let exports = aliasidx_build(export_renames)
    let heads = for stmt in stmts {
      export_renamed_head(stmt, exports)
    }
    let namespace_suffix_box = [""]
    let exported = collect_exported_value_names(heads)
    let renames = collect_private_value_renames(path, heads, namespace_suffix_box, exported)
    if !alias_renames_compose(exports, renames) {
      namespace_private_value_stmts(path, apply_export_renames_stmts(stmts, export_renames))
    } else {
      let value_renamed = if Array::length(renames) == 0 {
        apply_export_renames_stmts(stmts, export_renames)
      } else {
        let privates = aliasidx_build(renames)
        let both = aliasidx_build(alias_entries_concat(export_renames, renames))
        for stmt in stmts {
          namespace_private_stmt_after_renames(stmt, exports, privates, both)
        }
      }
      namespace_private_type_ctor_stage(path, value_renamed, namespace_suffix_box, exported)
    }
  }
}

/// One statement through the export pass and the private stage at once.
/// `both` is the union map for the positions both passes rewrite; a `let mut`
/// name is renamed by the private stage only, and a bodyless declaration or
/// an export list is visited by the export pass only -- each keeps its own
/// map so the fused walk answers exactly like the pair.
fn namespace_private_stmt_after_renames(stmt: Stmt, exports: AliasIdx, privates: AliasIdx, both: AliasIdx) -> Stmt {
  match stmt {
    SLet(exported, is_rec, name, ty, body) => SLet(exported, is_rec, aliasidx_rename(both, name), ty, rewrite_alias_expr_ix(body, both)),
    SLetMut(name, ty, body) => SLetMut(aliasidx_rename(privates, name), ty, rewrite_alias_expr_ix(body, both)),
    SFnDecl(exported, name, body, requires, ensures) => SFnDecl(exported, aliasidx_rename(exports, name), rewrite_alias_expr_ix(body, exports), for requirement in requires {
      rewrite_alias_expr_ix(requirement, exports)
    }, for guarantee in ensures {
      rewrite_alias_expr_ix(guarantee, exports)
    }),
    SExport(items) => SExport(for item in items {
      aliasidx_rename(exports, item)
    }),
    STest(name, body) => STest(name, rewrite_alias_expr_ix(body, both)),
    SBench(name, body) => SBench(name, rewrite_alias_expr_ix(body, both)),
    SExpr(body) => SExpr(rewrite_alias_expr_ix(body, both)),
    SLetPat(pat, body) => SLetPat(pat, rewrite_alias_expr_ix(body, both)),
    SModule(exported, name, stmts) => SModule(exported, name, namespace_private_value_stmts(name, stmts)),
    _ => stmt
  }
}

/// Follow the last published edge at each facade until it reaches a declared
/// enum. A missing edge or a cycle supplies no constructor rewrite.
fn reexport_enum_origin(path: String, name: String, edge_tpath: Array[String], edge_tname: Array[String], edge_last_idx: MutMap[String, Int], enum_defs: MutMap[String, Bool], enum_type_aliases: MutMap[String, String], published_aliases: MutMap[String, Bool], local_type_heads: MutMap[String, Bool], enum_import_paths: MutMap[String, String], enum_import_names: MutMap[String, String]) -> Option[(String, String, String, Bool)] {
  let mut cur_path = path
  let mut cur_name = name
  let mut depth = 0
  let mut done = false
  let mut origin: Option[(String, String, String, Bool)] = None
  let mut published_alias: Option[String] = None
  while depth <= Array::length(edge_tpath) + MutMap::size(enum_type_aliases) + MutMap::size(enum_import_paths) && !done {
    let key = plan_rename_key(cur_path, cur_name)
    if MutMap::has(enum_defs, key) {
      origin = match MutMap::get(enum_defs, key) {
        Some(true) => Some((cur_name, cur_path, cur_name, true)),
        _ => match published_alias {
          Some(alias) => Some((alias, cur_path, cur_name, false)),
          None => None
        }
      }
      done = true
    } else if MutMap::has(enum_type_aliases, key) {
      if published_alias == None && MutMap::has(published_aliases, key) {
        published_alias = Some(cur_name)
      }
      match MutMap::get(enum_type_aliases, key) {
        Some(next_name) => cur_name = next_name,
        None => done = true
      }
    } else if MutMap::has(local_type_heads, key) {
      done = true
    } else if MutMap::has(enum_import_paths, key) {
      match (MutMap::get(enum_import_paths, key), MutMap::get(enum_import_names, key)) {
        (Some(next_path), Some(next_name)) => {
          cur_path = next_path
          cur_name = next_name
        },
        _ => done = true
      }
    } else {
      match MutMap::get(edge_last_idx, key) {
        Some(next) => {
          cur_path = Array::get(edge_tpath, next)
          cur_name = Array::get(edge_tname, next)
        },
        None => done = true
      }
    }
    depth = depth + 1
  }
  origin
}

/// #3448: the struct, enum or error type a dependency's `stmt` publishes into
/// the merged program, as `(name, kind)`, or `("", "")`. A dependency's
/// EXPORTED type keeps its bare name (a private one is namespaced by its
/// path), so two such declarations of one name collide. The entry's own types
/// are its own (#3343), and a clash the entry can see through an import is the
/// checker's to refuse (#3035), so the entry publishes none here. A package
/// contract restates its implementation's types, so it publishes none either.
fn published_type_of(stmt: Stmt, path: String, is_entry: Bool, exported_names: Array[String]) -> (String, String) {
  let (declared, name, kind) = match stmt {
    SStruct(exported, name, _, _, _, _) => (exported, name, "structs"),
    SEnum(exported, name, _, _, _) => (exported, name, "enums"),
    SSuberror(exported, name, _) => (exported, name, "error types"),
    _ => (false, "", "")
  }
  if name == "" || is_entry || is_contract_ext(path) || !(declared || import_alias_rewrite_string_array_contains(exported_names, name)) {
    ("", "")
  } else {
    (name, kind)
  }
}

/// #3448: are two published declarations of one name the same type? The
/// checker reads them as one when they are the same definition (#3036): the
/// same fields or constructors in the same order, their types equal up to a
/// renaming of the type parameters, and a row read as a set of labels. Such a
/// pair has one layout and one meaning in the merged program.
fn published_types_equivalent(a: Stmt, aa: Array[(String, Array[String], TypeExpr)], b: Stmt, ba: Array[(String, Array[String], TypeExpr)]) -> Bool {
  match (a, b) {
    (SStruct(_, _, af, _, am, ap), SStruct(_, _, bf, _, bm, bp)) => {
      let ar = type_param_renames(ap)
      let br = type_param_renames(bp)
      let mut ok = Array::length(af) == Array::length(bf) && Array::length(am) == Array::length(bm) && type_param_arities_match(ap, bp)
      let mut i = 0
      while ok && i < Array::length(af) {
        let (an, aty) = Array::get(af, i)
        let (bn, bty) = Array::get(bf, i)
        ok = an == bn && type_exprs_equivalent(expand_type_aliases(aty, aa, ar, 0), ar, expand_type_aliases(bty, ba, br, 0), br)
        i = i + 1
      }
      let mut j = 0
      while ok && j < Array::length(am) {
        ok = import_alias_rewrite_string_array_contains(bm, Array::get(am, j))
        j = j + 1
      }
      ok
    },
    (SEnum(_, _, ap, actors, _), SEnum(_, _, bp, bctors, _)) => type_param_arities_match(ap, bp) && ctors_equivalent(actors, aa, type_param_renames(ap), bctors, ba, type_param_renames(bp)),
    (SSuberror(_, _, actors), SSuberror(_, _, bctors)) => ctors_equivalent(actors, aa, [
    ], bctors, ba, []),
    _ => false
  }
}

fn ctors_equivalent(a: Array[(String, Array[TypeExpr])], aa: Array[(String, Array[String], TypeExpr)], ar: Array[(String, String)], b: Array[(String, Array[TypeExpr])], ba: Array[(String, Array[String], TypeExpr)], br: Array[(String, String)]) -> Bool {
  let mut ok = Array::length(a) == Array::length(b)
  let mut i = 0
  while ok && i < Array::length(a) {
    let (an, ats) = Array::get(a, i)
    let (bn, bts) = Array::get(b, i)
    ok = an == bn && type_expr_lists_equivalent(for t in ats {
      expand_type_aliases(t, aa, ar, 0)
    }, ar, for t in bts {
      expand_type_aliases(t, ba, br, 0)
    }, br)
    i = i + 1
  }
  ok
}

/// The transparent `type` aliases a source file declares, as
/// `(name, parameters, target)`.
fn file_type_aliases(stmts: Array[Stmt]) -> Array[(String, Array[String], TypeExpr)] {
  let out: Array[(String, Array[String], TypeExpr)] = []
  for stmt in stmts {
    match stmt {
      STypeAlias(_, name, params, target) => Array::push(out, (name, params, target)),
      SEffectSet(_, name, members) => Array::push(out, effectset_alias_row(name, members)),
      _ => ()
    }
  }
  out
}

/// #3489: an `effectset` travels with the type aliases, under a name no type
/// can spell, so a row is read through it wherever an alias would be: the
/// file's own, imported from its provider, re-exported, through any chain.
fn effectset_alias_key(name: String) -> String {
  String::concat("effectset ", name)
}

fn effectset_alias_row(name: String, members: Array[String]) -> (String, Array[String], TypeExpr) {
  (effectset_alias_key(name), [], TyTuple(for m in members {
    TyName(m)
  }))
}

/// The shared aliases a file imports by name, each under the name its import
/// binds (`import ./a.vibe { N as M }` reads `N`'s target as `M`). An alias
/// is read only from an import that resolves to the file declaring it (Codex
/// on #3467): a nominal `N` imported from another module is that module's.
fn imported_type_aliases_into(stmts: Array[Stmt], path: String, paths: Array[String], shared: Array[(String, String, Array[String], TypeExpr)], out: Array[(String, Array[String], TypeExpr)]) -> Unit {
  for stmt in stmts {
    match stmt {
      SImport(raw_path, items) => {
        let provider = resolve_known_import_path(paths, dir_of_path(path), raw_path, path)
        for item in items {
          let local = match item.alias {
            Some(a) => a,
            None => item.name
          }
          for al in shared {
            let (from, an, ap, target) = al
            if from == provider {
              if an == item.name {
                Array::push(out, (local, ap, target))
              } else if an == effectset_alias_key(item.name) {
                Array::push(out, (effectset_alias_key(local), ap, target))
              }
            }
          }
        }
      },
      _ => ()
    }
  }
  ()
}

/// The exported transparent aliases of the program, with the file that
/// declares each.
fn unique_exported_type_aliases(paths: Array[String], stmts_list: Array[Array[Stmt]]) -> Array[(String, String, Array[String], TypeExpr)] {
  let all: Array[(String, String, Array[String], TypeExpr)] = []
  let mut fi = 0
  while fi < Array::length(stmts_list) {
    let stmts = Array::get(stmts_list, fi)
    let own = file_type_aliases(stmts)
    // An alias published through an export list (`type N = Int; export {
    // N }`) is exported as surely as `export type N` (Codex on #3467).
    let listed = collect_exported_value_names(stmts)
    for stmt in stmts {
      match stmt {
        // Codex on #3467: the target is read in its provider, whose own
        // aliases (`type Hidden = Int; export type N = Hidden`) the importer
        // cannot see. A parameter of the alias is never one of them.
        STypeAlias(exported, name, params, target) => if exported || import_alias_rewrite_string_array_contains(listed, name) {
          let renames = for p in params {
            (type_param_name(p), String::concat("#param:", type_param_name(p)))
          }
          Array::push(all, (Array::get(paths, fi), name, params, expand_type_aliases(target, own, renames, 0)))
        } else {
          ()
        },
        SEffectSet(exported, name, members) => if exported || import_alias_rewrite_string_array_contains(listed, name) {
          let (key, ps, target) = effectset_alias_row(name, members)
          // Read in the provider too (Codex on #3492): `All = { Base }` over
          // its own `Base = { Ask }` publishes `Ask`.
          Array::push(all, (Array::get(paths, fi), key, ps, flatten_effectset_target(target, own)))
        } else {
          ()
        },
        _ => ()
      }
    }
    fi = fi + 1
  }
  // Each alias is keyed by its provider as well as its name (Codex on
  // #3467): an import reads only the provider's own, so two modules
  // exporting `N` do not cancel each other.
  // Codex on #3467: an exported alias spelled through an alias its provider
  // imports (`import ./n.vibe { N }; export type M = N`) is read through
  // that import too. Each round reads one more import deep, until a round
  // changes nothing; the round bound stops a cycle, and a chain longer than
  // it stays unexpanded, which can only keep two types apart.
  let mut cur = all
  let mut changed = true
  let mut rounds = 0
  while changed && rounds < 16 {
    changed = false
    let resolved: Array[(String, String, Array[String], TypeExpr)] = []
    let mut ai = 0
    while ai < Array::length(all) {
      // The provider's own spelling is re-read each round: a target already
      // rewritten names the imported provider's aliases, not this one's.
      let (from, name, params, target) = Array::get(all, ai)
      let (_, _, _, prev) = Array::get(cur, ai)
      let mut fi = 0
      let env: Array[(String, Array[String], TypeExpr)] = []
      while fi < Array::length(paths) {
        if Array::get(paths, fi) == from {
          imported_type_aliases_into(Array::get(stmts_list, fi), from, paths, cur, env)
        }
        fi = fi + 1
      }
      let renames = for p in params {
        (type_param_name(p), String::concat("#param:", type_param_name(p)))
      }
      let next = if String::starts_with(name, "effectset ") {
        flatten_effectset_target(prev, env)
      } else {
        expand_type_aliases(target, env, renames, 0)
      }
      if !type_exprs_equivalent(next, renames, prev, renames) {
        changed = true
      }
      Array::push(resolved, (from, name, params, next))
      ai = ai + 1
    }
    // A facade that re-exports an alias (`export ./a.vibe { N }`) provides it
    // too, under the name it exports (Codex on #3467): an importer of the
    // facade reads the declaring file's `N`. Each round follows one more
    // facade.
    reexported_type_aliases_into(paths, stmts_list, cur, resolved)
    if Array::length(resolved) != Array::length(cur) {
      changed = true
    } else {
      let mut ri = Array::length(all)
      while ri < Array::length(resolved) {
        let (rf, rn, _, rt) = Array::get(resolved, ri)
        let (pf, pn, _, pt) = Array::get(cur, ri)
        if rf != pf || rn != pn || !type_exprs_equivalent(rt, [], pt, []) {
          changed = true
        }
        ri = ri + 1
      }
    }
    cur = resolved
    rounds = rounds + 1
  }
  cur
}

/// The aliases each file re-exports, read from `shared` (`(provider, name,
/// parameters, target)`) and appended to `out` keyed by the re-exporting
/// file and the name it exports.
fn reexported_type_aliases_into(paths: Array[String], stmts_list: Array[Array[Stmt]], shared: Array[(String, String, Array[String], TypeExpr)], out: Array[(String, String, Array[String], TypeExpr)]) -> Unit {
  let mut fi = 0
  while fi < Array::length(stmts_list) {
    let path = Array::get(paths, fi)
    let stmts = Array::get(stmts_list, fi)
    // The two-step form, `import ./a.vibe { N }` then `export { N }`,
    // re-exports the imported alias too (Codex on #3467).
    let listed = collect_exported_value_names(stmts)
    // A name re-exported twice is the later binding (Codex on #3467), as
    // the facade closure reads it (`edge_last_idx`).
    let rows: Array[(String, Array[String], TypeExpr)] = []
    for stmt in stmts {
      let (raw_path, items, all_items) = match stmt {
        SReExport(rp, its) => (rp, its, true),
        SImport(rp, its) => (rp, its, false),
        _ => ("", [], false)
      }
      if raw_path != "" {
        let provider = resolve_known_import_path(paths, dir_of_path(path), raw_path, path)
        for item in items {
          let exported = match item.alias {
            Some(a) => a,
            None => item.name
          }
          if all_items || import_alias_rewrite_string_array_contains(listed, exported) {
            for al in shared {
              let (from, an, ap, target) = al
              // An `effectset` re-exports under its own key (#3489).
              let row_name = if an == item.name {
                exported
              } else if an == effectset_alias_key(item.name) {
                effectset_alias_key(exported)
              } else {
                ""
              }
              if row_name != "" && from == provider {
                let mut ri = 0
                let mut replaced = false
                while ri < Array::length(rows) {
                  if Array::get(rows, ri).0 == row_name {
                    Array::set(rows, ri, (row_name, ap, target))
                    replaced = true
                  }
                  ri = ri + 1
                }
                if !replaced {
                  Array::push(rows, (row_name, ap, target))
                }
              }
            }
          }
        }
      }
    }
    for r in rows {
      let (rn, rp, rt) = r
      Array::push(out, (path, rn, rp, rt))
    }
    fi = fi + 1
  }
  ()
}

/// `t` with the file's aliases expanded, as the checker reads them (Codex on
/// #3467): `type N = Int; struct Box { n: N }` is the `Box { n: Int }` of
/// another module. A type parameter (renamed in `renames`) is never an
/// alias, an alias applied to the wrong number of arguments (a constructor
/// argument, `Holder[Inner]`) stays as written, and the depth bounds a cycle.
fn expand_type_aliases(t: TypeExpr, aliases: Array[(String, Array[String], TypeExpr)], renames: Array[(String, String)], depth: Int) -> TypeExpr {
  if depth > 16 || Array::length(aliases) == 0 {
    t
  } else {
    match t {
      TyName(x) => match find_type_alias(aliases, renames, x, 0) {
        Some(target) => expand_type_aliases(target, aliases, renames, depth + 1),
        None => t
      },
      TyApp(x, args) => {
        let expanded = for arg in args {
          expand_type_aliases(arg, aliases, renames, depth + 1)
        }
        let mut out = TyApp(x, expanded)
        // The first match, as `find_type_alias` reads a bare one: a file's
        // own alias comes before an imported one it shadows (Codex on #3467).
        let mut matched = false
        for al in aliases {
          let (an, ap, target) = al
          if !matched && an == x && renamed_type_name(renames, x) == x && Array::length(ap) == Array::length(expanded) && Array::length(ap) > 0 {
            out = expand_type_aliases(substitute_type_params(target, ap, expanded), aliases, renames, depth + 1)
            matched = true
          }
        }
        out
      },
      TyFn(ps, r, row) => TyFn(for p in ps {
        expand_type_aliases(p, aliases, renames, depth + 1)
      }, expand_type_aliases(r, aliases, renames, depth + 1), match row {
        Some(text) => Some(expand_row_effectsets(text, aliases, 0)),
        None => None
      }),
      TyTuple(items) => TyTuple(for item in items {
        expand_type_aliases(item, aliases, renames, depth + 1)
      }),
      TyUnit => t
    }
  }
}

/// #3489: `text` with each label that names an `effectset` in `aliases`
/// replaced by its members, as the checker reads the row: `with All` of
/// `effectset All = { Ask }` is `with Ask`. Labels split at the top-level
/// `+` and `,`; the depth bounds a cycle.
fn expand_row_effectsets(text: String, aliases: Array[(String, Array[String], TypeExpr)], depth: Int) -> String {
  let labels: Array[String] = []
  let mut cur = ""
  let mut nest = 0
  let mut i = 0
  let n = String::length(text)
  while i <= n {
    let c = if i < n {
      String::byte_at(text, i)
    } else {
      0
    }
    if c == '[' {
      nest = nest + 1
    } else if c == ']' {
      nest = nest - 1
    }
    if c == 0 || (nest == 0 && (c == '+' || c == ',')) {
      let t = String::trim(cur)
      if t != "" {
        Array::push(labels, t)
      }
      cur = ""
    } else {
      cur = String::concat(cur, String::substring(text, i, i + 1))
    }
    i = i + 1
  }
  let out: Array[String] = []
  for label in labels {
    let mut members: Option[Array[String]] = None
    let mut found = false
    if depth < 16 {
      let key = effectset_alias_key(label)
      for al in aliases {
        let (an, _, target) = al
        if !found && an == key {
          found = true
          members = match target {
            TyTuple(items) => Some(for it in items {
              match it {
                TyName(m) => expand_row_effectsets(m, aliases, depth + 1),
                _ => ""
              }
            }),
            _ => None
          }
        }
      }
    }
    match members {
      Some(ms) => {
        for m in ms {
          if m != "" {
            Array::push(out, m)
          }
        }
        ()
      },
      None => Array::push(out, label)
    }
  }
  String::join(out, " + ")
}

/// An `effectset`'s members with each one that names an effectset in
/// `aliases` replaced by its own members.
fn flatten_effectset_target(target: TypeExpr, aliases: Array[(String, Array[String], TypeExpr)]) -> TypeExpr {
  match target {
    TyTuple(items) => {
      let out: Array[TypeExpr] = []
      for item in items {
        match item {
          TyName(m) => {
            for part in String::split(expand_row_effectsets(m, aliases, 0), " + ") {
              if part != "" {
                Array::push(out, TyName(part))
              }
            }
            ()
          },
          _ => Array::push(out, item)
        }
      }
      TyTuple(out)
    },
    _ => target
  }
}

fn find_type_alias(aliases: Array[(String, Array[String], TypeExpr)], renames: Array[(String, String)], name: String, arity: Int) -> Option[TypeExpr] {
  let mut out: Option[TypeExpr] = None
  if renamed_type_name(renames, name) == name {
    // The first match: a file's own aliases come before the program's.
    for al in aliases {
      let (an, ap, target) = al
      match out {
        None => if an == name && Array::length(ap) == arity {
          out = Some(target)
        },
        Some(_) => ()
      }
    }
  }
  out
}

fn substitute_type_params(t: TypeExpr, params: Array[String], args: Array[TypeExpr]) -> TypeExpr {
  match t {
    TyName(x) => {
      let mut out = t
      let mut i = 0
      while i < Array::length(params) {
        if type_param_name(Array::get(params, i)) == x {
          out = Array::get(args, i)
        }
        i = i + 1
      }
      out
    },
    TyApp(x, xs) => {
      let sub_args = for a in xs {
        substitute_type_params(a, params, args)
      }
      // A constructor parameter in head position (`F[A]` of `type Apply[F[_],
      // A] = F[A]`) takes the constructor it is given (Codex on #3467):
      // `Apply[Option, Int]` is `Option[Int]`, not `F[Int]`.
      let mut head = x
      let mut i = 0
      while i < Array::length(params) && i < Array::length(args) {
        if type_param_name(Array::get(params, i)) == x {
          head = match Array::get(args, i) {
            TyName(h) => h,
            TyApp(h, _) => h,
            _ => head
          }
        }
        i = i + 1
      }
      TyApp(head, sub_args)
    },
    TyFn(ps, r, row) => TyFn(for p in ps {
      substitute_type_params(p, params, args)
    }, substitute_type_params(r, params, args), row),
    TyTuple(items) => TyTuple(for item in items {
      substitute_type_params(item, params, args)
    }),
    TyUnit => t
  }
}

/// The top-level name `stmt` declares, for import reachability, or "".
fn top_level_decl_name(stmt: Stmt) -> String {
  match stmt {
    SLet(_, _, name, _, _) => name,
    SLetMut(name, _, _) => name,
    SFnDecl(_, name, _, _, _) => name,
    SStruct(_, name, _, _, _, _) => name,
    SEnum(_, name, _, _, _) => name,
    SSuberror(_, name, _) => name,
    STypeAlias(_, name, _, _) => name,
    STrait(_, name, _, _, _, _) => name,
    SEffectDef(_, name, _, _) => name,
    _ => ""
  }
}

/// #3448: the refusals for type names two REACHED source files both publish./// #3448: the refusals for type names two REACHED source files both publish.
///
/// A package is merged whole -- importing one name from `@vibe/core` brings
/// every member file -- so a publication counts only when its file is reached
/// from the entry through import items: an item reaches the file that
/// declares it, following re-export edges (the last one, as the checker
/// binds), and a reached file's own imports reach further. A local
/// `enum Attempt` beside core's unimported `attempt.vibe` is therefore not a
/// collision, while two modules the program actually uses that both publish
/// `Box` are: the program held two `struct Box` and two `Box::plain`, and ran
/// one module's for the other's type.
fn reached_type_collisions(paths: Array[String], stmts_list: Array[Array[Stmt]], entry_path: String, edge_tpath: Array[String], edge_tname: Array[String], edge_last_idx: MutMap[String, Int]) -> Array[String] {
  let file_count = Array::length(paths)
  let decls: MutMap[String, Bool] = MutMap::new_string()
  let path_idx: MutMap[String, Int] = MutMap::new_string()
  let mut fi = 0
  while fi < file_count {
    let path = Array::get(paths, fi)
    if !MutMap::has(path_idx, path) {
      MutMap::set(path_idx, path, fi)
    } else {
      ()
    }
    let fstmts = Array::get(stmts_list, fi)
    let mut di = 0
    while di < Array::length(fstmts) {
      let dn = top_level_decl_name(Array::get(fstmts, di))
      if dn != "" {
        MutMap::set(decls, plan_rename_key(path, dn), true)
      } else {
        ()
      }
      di = di + 1
    }
    fi = fi + 1
  }
  let reached: MutMap[String, Bool] = MutMap::new_string()
  let seen_items: MutMap[String, Bool] = MutMap::new_string()
  let work_paths: Array[String] = []
  let work_names: Array[String] = []
  let reach_file: (String) -> Unit = (path) -> {
    if !MutMap::has(reached, path) {
      MutMap::set(reached, path, true)
      match MutMap::get(path_idx, path) {
        Some(idx) => {
          let stmts = Array::get(stmts_list, idx)
          let mut si = 0
          while si < Array::length(stmts) {
            // A re-export binds its names in the facade too, so the
            // facade's own code may call them (Codex on #3467): an item that
            // code names reaches its provider like an import's. One it only
            // passes on reaches nothing until an importer names it (the
            // #3036 control `dup_type_formal_marker_ok`), and a package
            // contract holds no code at all.
            let (raw_path, items) = match Array::get(stmts, si) {
              SImport(rp, its) => (rp, its),
              SReExport(rp, its) => if is_contract_ext(path) {
                ("", [])
              } else {
                let used: Array[ImportItem] = []
                for it in its {
                  let local = match it.alias {
                    Some(a) => a,
                    None => it.name
                  }
                  if stmts_code_names(stmts, local) {
                    Array::push(used, it)
                  }
                }
                (rp, used)
              },
              _ => ("", [])
            }
            if raw_path != "" {
              let target = resolve_known_import_path(paths, dir_of_path(path), raw_path, path)
              let mut ii = 0
              while ii < Array::length(items) {
                Array::push(work_paths, target)
                Array::push(work_names, Array::get(items, ii).name)
                ii = ii + 1
              }
            }
            si = si + 1
          }
        },
        None => ()
      }
    } else {
      ()
    }
  }
  reach_file(entry_path)
  let mut wi = 0
  while wi < Array::length(work_paths) {
    let wp = Array::get(work_paths, wi)
    let wn = Array::get(work_names, wi)
    let key = plan_rename_key(wp, wn)
    if !MutMap::has(seen_items, key) {
      MutMap::set(seen_items, key, true)
      if MutMap::has(decls, key) {
        reach_file(wp)
      } else {
        match MutMap::get(edge_last_idx, key) {
          Some(ei) => {
            Array::push(work_paths, Array::get(edge_tpath, ei))
            Array::push(work_names, Array::get(edge_tname, ei))
          },
          // Neither declared nor re-exported here (a builtin, an aggregate
          // import): the file itself is what the item reaches.
          None => reach_file(wp)
        }
      }
    } else {
      ()
    }
    wi = wi + 1
  }
  let first_path: MutMap[String, String] = MutMap::new_string()
  let first_decl: MutMap[String, Stmt] = MutMap::new_string()
  let first_aliases: MutMap[String, Array[(String, Array[String], TypeExpr)]] = MutMap::new_string()
  let errors: Array[String] = []
  // Codex on #3467: a field may spell an alias the file imports
  // (`import ./aliases.vibe { N }`). An exported alias exactly one file of
  // the program declares is that one, so a file's import of the name reads
  // it, under the name the import binds; a name two files export, or one the
  // file does not import (its own private `struct N`), stays unexpanded,
  // which can only keep two types apart, never join two that differ.
  let shared_aliases = unique_exported_type_aliases(paths, stmts_list)
  let mut ci = 0
  while ci < file_count {
    let path = Array::get(paths, ci)
    if MutMap::has(reached, path) {
      let stmts = Array::get(stmts_list, ci)
      let exported_names = collect_exported_value_names(stmts)
      let aliases = file_type_aliases(stmts)
      imported_type_aliases_into(stmts, path, paths, shared_aliases, aliases)
      let mut pi = 0
      while pi < Array::length(stmts) {
        let stmt = Array::get(stmts, pi)
        let (name, kind) = published_type_of(stmt, path, path == entry_path, exported_names)
        if name != "" {
          let same = match (MutMap::get(first_decl, name), MutMap::get(first_aliases, name)) {
            (Some(prior_decl), Some(prior_aliases)) => published_types_equivalent(prior_decl, prior_aliases, stmt, aliases),
            _ => false
          }
          match MutMap::get(first_path, name) {
            // "\n" marks a name already refused: it is never a path. Two
            // equivalent declarations are one type (#3036).
            Some(prior) => if prior != path && prior != "\n" && !same {
              Array::push(errors, String::concat("rename one of the ", String::concat(kind, String::concat(" named `", String::concat(name, String::concat("`: `", String::concat(prior, String::concat("` and `", String::concat(path, "` both declare it for this program, and a program holds one type per name, so code compiled against one would run with the other's fields and methods")))))))))
              MutMap::set(first_path, name, "\n")
            },
            None => {
              MutMap::set(first_path, name, path)
              MutMap::set(first_decl, name, stmt)
              MutMap::set(first_aliases, name, aliases)
            }
          }
        } else {
          ()
        }
        pi = pi + 1
      }
    } else {
      ()
    }
    ci = ci + 1
  }
  errors
}

export fn build_export_rename_plan(paths: Array[String], stmts_list: Array[Array[Stmt]], entry_path: String) -> ExportRenamePlan {
  let file_count = Array::length(paths)
  let def_names_list = array_empty()
  let mut fi = 0
  while fi < file_count {
    Array::push(def_names_list, collect_export_def_value_names(Array::get(stmts_list, fi)))
    fi = fi + 1
  }
  let edge_from = empty_strings()
  let edge_pub = empty_strings()
  let edge_tpath = empty_strings()
  let edge_tname = empty_strings()
  let builtin_iterator_paths = empty_strings()
  let mut ei = 0
  while ei < file_count {
    collect_reexport_edges_into(Array::get(paths, ei), Array::get(stmts_list, ei), paths, edge_from, edge_pub, edge_tpath, edge_tname, builtin_iterator_paths)
    ei = ei + 1
  }
  // The origins of the entry file's re-export surface are program ABI (wasm
  // export names of a linked library / component entry) and stay bare.
  let excluded_paths = empty_strings()
  let excluded_names = empty_strings()
  // #2479: the three lookups below used to scan their parallel arrays per
  // edge (`file_idx_of` over `paths`, `plan_triple_lookup` over the edge
  // arrays and over the exclusions) -- 150 ms of a warm compiler-closure
  // compile. Index each once; `plan_triple_lookup` answered the FIRST match,
  // so an index entry is written only when absent.
  let path_idx: MutMap[String, Int] = MutMap::new_string()
  let mut pi = 0
  while pi < file_count {
    if !MutMap::has(path_idx, Array::get(paths, pi)) {
      MutMap::set(path_idx, Array::get(paths, pi), pi)
    } else {
      ()
    }
    pi = pi + 1
  }
  let edge_idx: MutMap[String, Int] = MutMap::new_string()
  let mut ei2 = 0
  while ei2 < Array::length(edge_from) {
    let ekey = plan_rename_key(Array::get(edge_from, ei2), Array::get(edge_pub, ei2))
    if !MutMap::has(edge_idx, ekey) {
      MutMap::set(edge_idx, ekey, ei2)
    } else {
      ()
    }
    ei2 = ei2 + 1
  }
  // The value-rename index above preserves its historical first edge. Enum
  // publication follows the checker's later-binding-wins rule, including an
  // aggregate `import { E as A }; export { A }` facade. Resolve every last
  // edge through the graph so a second facade does not leave an intermediate
  // alias as a constructor qualifier.
  let enum_defs: MutMap[String, Bool] = MutMap::new_string()
  let enum_ctors: MutMap[String, Array[String]] = MutMap::new_string()
  let enum_origin_first_path: MutMap[String, String] = MutMap::new_string()
  let enum_origin_ambiguous: MutMap[String, Bool] = MutMap::new_string()
  let enum_origin_ambiguous_names: Array[String] = []
  let enum_type_aliases: MutMap[String, String] = MutMap::new_string()
  let published_aliases: MutMap[String, Bool] = MutMap::new_string()
  // Local non-enum heads stop provenance before an earlier import of the
  // same spelling. Eligible type aliases are followed first below.
  let local_type_heads: MutMap[String, Bool] = MutMap::new_string()
  let enum_import_paths: MutMap[String, String] = MutMap::new_string()
  let enum_import_names: MutMap[String, String] = MutMap::new_string()
  let mut dfi = 0
  while dfi < file_count {
    let path = Array::get(paths, dfi)
    let stmts = Array::get(stmts_list, dfi)
    let exported_names = collect_exported_value_names(stmts)
    let mut dsi = 0
    while dsi < Array::length(stmts) {
      match Array::get(stmts, dsi) {
        SEnum(exported, name, _, ctors, _) => {
          MutMap::set(enum_defs, plan_rename_key(path, name), exported || import_alias_rewrite_string_array_contains(exported_names, name))
          let ctor_names: Array[String] = []
          for ctor in ctors {
            Array::push(ctor_names, ctor.0)
          }
          MutMap::set(enum_ctors, plan_rename_key(path, name), ctor_names)
          if exported || import_alias_rewrite_string_array_contains(exported_names, name) {
            match MutMap::get(enum_origin_first_path, name) {
              Some(first_path) => if first_path != path && !MutMap::has(enum_origin_ambiguous, name) {
                MutMap::set(enum_origin_ambiguous, name, true)
                Array::push(enum_origin_ambiguous_names, name)
              },
              None => MutMap::set(enum_origin_first_path, name, path)
            }
          } else {
            ()
          }
        },
        STypeAlias(exported, name, params, target) => {
          MutMap::set(local_type_heads, plan_rename_key(path, name), true)
          if exported || import_alias_rewrite_string_array_contains(exported_names, name) {
            MutMap::set(published_aliases, plan_rename_key(path, name), true)
          }
          match target {
            TyName(head) => if !enum_alias_target_is_formal(params, head) {
              MutMap::set(enum_type_aliases, plan_rename_key(path, name), head)
            },
            TyApp(head, _) => if !enum_alias_target_is_formal(params, head) {
              MutMap::set(enum_type_aliases, plan_rename_key(path, name), head)
            },
            _ => ()
          }
        },
        SStruct(_, name, _, _, _, _) => MutMap::set(local_type_heads, plan_rename_key(path, name), true),
        STrait(_, name, _, _, _, _) => MutMap::set(local_type_heads, plan_rename_key(path, name), true),
        SSuberror(_, name, _) => MutMap::set(local_type_heads, plan_rename_key(path, name), true),
        SEffectDef(_, name, _, _) => MutMap::set(local_type_heads, plan_rename_key(path, name), true),
        SImport(raw_path, items) => {
          let resolved = resolve_known_import_path(paths, dir_of_path(path), raw_path, path)
          let mut imi = 0
          while imi < Array::length(items) {
            let item = Array::get(items, imi)
            let local = match item.alias {
              Some(alias) => alias,
              None => item.name
            }
            let import_key = plan_rename_key(path, local)
            MutMap::set(enum_import_paths, import_key, resolved)
            MutMap::set(enum_import_names, import_key, item.name)
            imi = imi + 1
          }
        },
        _ => ()
      }
      dsi = dsi + 1
    }
    dfi = dfi + 1
  }
  let edge_last_idx: MutMap[String, Int] = MutMap::new_string()
  let mut eli = 0
  while eli < Array::length(edge_from) {
    MutMap::set(edge_last_idx, plan_rename_key(Array::get(edge_from, eli), Array::get(edge_pub, eli)), eli)
    eli = eli + 1
  }
  let type_collision_errors = reached_type_collisions(paths, stmts_list, entry_path, edge_tpath, edge_tname, edge_last_idx)
  let enum_alias_idx: MutMap[String, String] = MutMap::new_string()
  let enum_alias_private_ctors: MutMap[String, Array[(String, String)]] = MutMap::new_string()
  let enum_alias_paths = empty_strings()
  let enum_alias_names = empty_strings()
  let enum_alias_origins = empty_strings()
  let mut enum_alias_count = 0
  let mut eai = 0
  while eai < Array::length(edge_from) {
    let key = plan_rename_key(Array::get(edge_from, eai), Array::get(edge_pub, eai))
    match MutMap::get(edge_last_idx, key) {
      // This lookup asks which edge won, not whether any edge has this key.
      Some(last) => {
        if last == eai {
          match reexport_enum_origin(Array::get(edge_tpath, eai), Array::get(edge_tname, eai), edge_tpath, edge_tname, edge_last_idx, enum_defs, enum_type_aliases, published_aliases, local_type_heads, enum_import_paths, enum_import_names) {
            Some((origin, origin_path, enum_name, is_public)) => if origin != Array::get(edge_pub, eai) || !is_public {
              MutMap::set(enum_alias_idx, key, origin)
              if !is_public {
                let rows: Array[(String, String)] = []
                match MutMap::get(enum_ctors, plan_rename_key(origin_path, enum_name)) {
                  Some(names) => for ctor_name in names {
                    Array::push(rows, (ctor_name, namespace_private_name(origin_path, ctor_name)))
                  },
                  None => ()
                }
                MutMap::set(enum_alias_private_ctors, key, rows)
              }
              Array::push(enum_alias_paths, Array::get(edge_from, eai))
              Array::push(enum_alias_names, Array::get(edge_pub, eai))
              Array::push(enum_alias_origins, origin)
              enum_alias_count = enum_alias_count + 1
            } else {
              ()
            },
            None => ()
          }
        } else {
          ()
        }
      },
      None => ()
    }
    eai = eai + 1
  }
  let excluded_idx: MutMap[String, Bool] = MutMap::new_string()
  let file_idx_of: (String) -> Int = (path) -> {
    match MutMap::get(path_idx, path) {
      Some(i) => i,
      None => -1
    }
  }
  let mut xi = 0
  while xi < Array::length(edge_from) {
    if Array::get(edge_from, xi) == entry_path {
      let mut cur_path = Array::get(edge_tpath, xi)
      let mut cur_name = Array::get(edge_tname, xi)
      let mut depth = 0
      while depth < 16 {
        let idx = file_idx_of(cur_path)
        let is_def = if idx < 0 {
          false
        } else {
          import_alias_rewrite_string_array_contains(Array::get(def_names_list, idx), cur_name)
        }
        if is_def {
          Array::push(excluded_paths, cur_path)
          Array::push(excluded_names, cur_name)
          MutMap::set(excluded_idx, plan_rename_key(cur_path, cur_name), true)
          depth = 16
        } else {
          match MutMap::get(edge_idx, plan_rename_key(cur_path, cur_name)) {
            Some(eidx) => {
              cur_path = Array::get(edge_tpath, eidx)
              cur_name = Array::get(edge_tname, eidx)
              depth = depth + 1
            },
            None => {
              depth = 16
            }
          }
        }
      }
    } else {
      ()
    }
    xi = xi + 1
  }
  let rename_paths = empty_strings()
  let rename_names = empty_strings()
  let rename_mangled = empty_strings()
  let rename_idx: MutMap[String, String] = MutMap::new_string()
  // #2479: the facade-closure fixpoint below scans every rename entry per
  // edge for the ones on the edge's target path (O(passes x edges x
  // renames); the whole of this function's 0.2 s on a warm
  // compiler-closure compile). `rename_by_path` keeps each path's entry
  // indices in insertion order, so that scan reads one bucket. Every push to
  // the three parallel arrays goes through `add_rename`, which also appends
  // to the bucket -- an entry appended while a bucket is being walked lands
  // at its end, exactly where the array scan would have met it.
  let rename_by_path: MutMap[String, Array[Int]] = MutMap::new_string()
  let add_rename: (String, String, String) -> Unit = (rpath, rname, rmangled) -> {
    let ridx = Array::length(rename_paths)
    Array::push(rename_paths, rpath)
    Array::push(rename_names, rname)
    Array::push(rename_mangled, rmangled)
    match MutMap::get(rename_by_path, rpath) {
      Some(bucket) => Array::push(bucket, ridx),
      None => {
        let bucket: Array[Int] = []
        Array::push(bucket, ridx)
        MutMap::set(rename_by_path, rpath, bucket)
      }
    }
  }
  let mut ri = 0
  while ri < file_count {
    let path = Array::get(paths, ri)
    if path == entry_path {
      ()
    } else {
      let def_names = Array::get(def_names_list, ri)
      let mut ni = 0
      while ni < Array::length(def_names) {
        let name = Array::get(def_names, ni)
        let excluded = MutMap::has(excluded_idx, plan_rename_key(path, name))
        if excluded {
          ()
        } else {
          let mangled = namespace_exported_def_name(path, name)
          add_rename(path, name, mangled)
          let key = plan_rename_key(path, name)
          if !MutMap::has(rename_idx, key) {
            MutMap::set(rename_idx, key, mangled)
          } else {
            ()
          }
        }
        ni = ni + 1
      }
      // A provider-qualified helper that collides with an aliased trait import
      // is privately renamed before flattening. Unlike ordinary qualified
      // methods, this rename is part of the module's publication mapping so a
      // dependent import follows the helper instead of the provider builtin.
      let source_stmts = Array::get(stmts_list, ri)
      let exported_names = collect_exported_value_names(source_stmts)
      let trait_collision_renames = trait_import_local_operation_renames(source_stmts, path)
      let mut ci = 0
      while ci < Array::length(trait_collision_renames) {
        let (name, mangled) = Array::get(trait_collision_renames, ci)
        if import_alias_rewrite_string_array_contains(exported_names, name) {
          add_rename(path, name, mangled)
          let key = plan_rename_key(path, name)
          if !MutMap::has(rename_idx, key) {
            MutMap::set(rename_idx, key, mangled)
          } else {
            ()
          }
        } else {
          ()
        }
        ci = ci + 1
      }
    }
    ri = ri + 1
  }
  // Close the rename table over re-export facades so an import THROUGH a
  // facade (`import ./index.vibe { eq }` where index re-exports float's `eq`)
  // resolves to the renamed origin in one lookup.
  let mut changed = true
  while changed {
    changed = false
    let mut ci = 0
    while ci < Array::length(edge_from) {
      let from = Array::get(edge_from, ci)
      let pub_name = Array::get(edge_pub, ci)
      // #3445: two re-exports of one name in one facade -- the checker binds
      // the LATER one (its import environment is later-binding-wins), so
      // only that edge may publish a rename. Following the first one ran
      // the earlier definition under the later one's type.
      let is_last_edge = match MutMap::get(edge_last_idx, plan_rename_key(from, pub_name)) {
        Some(last) => last == ci,
        None => true
      }
      if from == entry_path || !is_last_edge {
        ()
      } else {
        match MutMap::get(rename_idx, plan_rename_key(Array::get(edge_tpath, ci), Array::get(edge_tname, ci))) {
          Some(mangled) => {
            let from_key = plan_rename_key(from, pub_name)
            if MutMap::has(rename_idx, from_key) {
              ()
            } else {
              add_rename(from, pub_name, mangled)
              MutMap::set(rename_idx, from_key, mangled)
              changed = true
            }
          },
          None => ()
        }
        // A trait-only facade also publishes that trait's companion
        // operations. They are not explicit re-export items, so carry every
        // provider-qualified rename with the same head across this edge. The
        // fixpoint makes this work through arbitrary facade chains.
        let target_path = Array::get(edge_tpath, ci)
        let target_name = Array::get(edge_tname, ci)
        let target_prefix = String::concat(target_name, "::")
        let public_prefix = String::concat(pub_name, "::")
        match MutMap::get(rename_by_path, target_path) {
          Some(bucket) => {
            let mut bi = 0
            while bi < Array::length(bucket) {
              let ri2 = Array::get(bucket, bi)
              let source_name = Array::get(rename_names, ri2)
              if String::starts_with(source_name, target_prefix) {
                let from_name = String::concat(public_prefix, String::substring(source_name, String::length(target_prefix), String::length(source_name)))
                let from_key = plan_rename_key(from, from_name)
                if !MutMap::has(rename_idx, from_key) {
                  let mangled = Array::get(rename_mangled, ri2)
                  add_rename(from, from_name, mangled)
                  MutMap::set(rename_idx, from_key, mangled)
                  changed = true
                } else {
                  ()
                }
              } else {
                ()
              }
              bi = bi + 1
            }
          },
          None => ()
        }
      }
      ci = ci + 1
    }
  }
  // Resolve authenticated origins to the same provider-unique values already
  // used by import rewriting. This is computed once from the finished rename
  // plan; consumers perform only membership checks over the small operation
  // set and never re-walk the module graph.
  let builtin_iterator_mangled = empty_strings()
  let mut bmi = 0
  while bmi < Array::length(rename_paths) {
    let source_path = Array::get(rename_paths, bmi)
    let source_name = Array::get(rename_names, bmi)
    let mut trusted = false
    let mut bpi = 0
    while bpi < Array::length(builtin_iterator_paths) && !trusted {
      let provider_path = Array::get(builtin_iterator_paths, bpi)
      trusted = source_path == provider_path || (is_contract_ext(provider_path) && dir_of_path(source_path) == dir_of_path(provider_path))
      bpi = bpi + 1
    }
    if trusted && iterator_namespace_operation(source_name, "Iterator") {
      let mangled = Array::get(rename_mangled, bmi)
      if !import_alias_rewrite_string_array_contains(builtin_iterator_mangled, mangled) {
        Array::push(builtin_iterator_mangled, mangled)
      } else {
        ()
      }
    } else {
      ()
    }
    bmi = bmi + 1
  }
  ExportRenamePlan::{
    plan_paths: paths,
    rename_paths: rename_paths,
    rename_names: rename_names,
    rename_mangled: rename_mangled,
    builtin_iterator_mangled: builtin_iterator_mangled,
    rename_idx: rename_idx,
    enum_alias_idx: enum_alias_idx,
    enum_alias_private_ctors: enum_alias_private_ctors,
    enum_alias_paths: enum_alias_paths,
    enum_alias_names: enum_alias_names,
    enum_alias_origins: enum_alias_origins,
    enum_origin_ambiguous: enum_origin_ambiguous,
    enum_origin_ambiguous_names: enum_origin_ambiguous_names,
    enum_alias_count: enum_alias_count,
    type_collision_errors: type_collision_errors
  }
}

/// Add standard Iterator provenance for operation renames whose resolved
/// provider was authenticated while building the export plan. This is the
/// facade counterpart of the direct-import marker path.
export fn append_builtin_iterator_plan_operation_markers(markers: Array[String], renames: Array[(String, String)], plan: ExportRenamePlan) -> Unit {
  // First preserve the direct-import path. Its local namespace marker is
  // emitted only when the whole namespace is free of source overrides.
  append_builtin_iterator_operation_markers(markers, renames)
  let mut i = 0
  while i < Array::length(renames) {
    let (_, resolved) = Array::get(renames, i)
    if import_alias_rewrite_string_array_contains(plan.builtin_iterator_mangled, resolved) {
      let split = String::index_of(resolved, "::")
      if split > 0 {
        let namespace = String::substring(resolved, 0, split)
        if iterator_namespace_operation(resolved, namespace) {
          let marker = String::concat(builtin_iterator_origin_marker_prefix(), namespace)
          if !import_alias_rewrite_string_array_contains(markers, marker) {
            Array::push(markers, marker)
          } else {
            ()
          }
        } else {
          ()
        }
      } else {
        ()
      }
    } else {
      ()
    }
    i = i + 1
  }
}

export fn export_plan_rename_count(plan: ExportRenamePlan) -> Int {
  Array::length(plan.rename_paths)
}

/// (name -> mangled) pairs for the defs of one file.
export fn export_plan_renames_for(plan: ExportRenamePlan, path: String) -> Array[(String, String)] {
  let out = empty_aliases()
  let rename_paths = plan.rename_paths
  let rename_names = plan.rename_names
  let rename_mangled = plan.rename_mangled
  let mut i = 0
  while i < Array::length(rename_paths) {
    if Array::get(rename_paths, i) == path {
      Array::push(out, (Array::get(rename_names, i), Array::get(rename_mangled, i)))
    } else {
      ()
    }
    i = i + 1
  }
  out
}

/// Deterministic text summary of the plan; callers fold it into merge cache
/// fingerprints so a rename-set change invalidates cached merged sources.
export fn export_plan_fingerprint_text(plan: ExportRenamePlan) -> String {
  let rename_paths = plan.rename_paths
  let rename_names = plan.rename_names
  let rename_mangled = plan.rename_mangled
  let buf = StringBuilder::new()
  StringBuilder::push(buf, "export-renames")
  let mut i = 0
  while i < Array::length(rename_paths) {
    StringBuilder::push(buf, "|")
    StringBuilder::push(buf, Array::get(rename_paths, i))
    StringBuilder::push(buf, ">")
    StringBuilder::push(buf, Array::get(rename_names, i))
    StringBuilder::push(buf, ">")
    StringBuilder::push(buf, Array::get(rename_mangled, i))
    i = i + 1
  }
  let mut bi = 0
  while bi < Array::length(plan.builtin_iterator_mangled) {
    StringBuilder::push(buf, "|builtin-iterator>")
    StringBuilder::push(buf, Array::get(plan.builtin_iterator_mangled, bi))
    bi = bi + 1
  }
  let mut ai = 0
  while ai < Array::length(plan.enum_alias_paths) {
    StringBuilder::push(buf, "|enum>")
    StringBuilder::push(buf, Array::get(plan.enum_alias_paths, ai))
    StringBuilder::push(buf, ">")
    StringBuilder::push(buf, Array::get(plan.enum_alias_names, ai))
    StringBuilder::push(buf, ">")
    StringBuilder::push(buf, Array::get(plan.enum_alias_origins, ai))
    let enum_key = plan_rename_key(Array::get(plan.enum_alias_paths, ai), Array::get(plan.enum_alias_names, ai))
    match MutMap::get(plan.enum_alias_private_ctors, enum_key) {
      Some(rows) => for row in rows {
        StringBuilder::push(buf, "|enum-ctor>")
        StringBuilder::push(buf, row.0)
        StringBuilder::push(buf, ">")
        StringBuilder::push(buf, row.1)
      },
      None => ()
    }
    ai = ai + 1
  }
  for name in plan.enum_origin_ambiguous_names {
    StringBuilder::push(buf, "|enum-ambiguous>")
    StringBuilder::push(buf, name)
  }
  StringBuilder::freeze(buf)
}

fn append_imported_trait_operation_renames(plan: ExportRenamePlan, target: String, item: ImportItem, locally_visible: Bool, out: Array[(String, String)], locals_seen: Array[String]) -> Unit {
  let is_trait = match item.kind {
    Some(ImportTrait) => true,
    _ => false
  }
  if is_trait && locally_visible {
    let local_head = match item.alias {
      Some(alias) => alias,
      None => item.name
    }
    let source_prefix = String::concat(item.name, "::")
    let mut i = 0
    while i < Array::length(plan.rename_paths) {
      let source_name = Array::get(plan.rename_names, i)
      let source_path = Array::get(plan.rename_paths, i)
      let same_provider = source_path == target || (is_contract_ext(target) && dir_of_path(source_path) == dir_of_path(target))
      if same_provider && String::starts_with(source_name, source_prefix) {
        let local_name = String::concat(local_head, String::substring(source_name, String::length(item.name), String::length(source_name)))
        if !import_alias_rewrite_string_array_contains(locals_seen, local_name) {
          Array::push(locals_seen, local_name)
          Array::push(out, (local_name, Array::get(plan.rename_mangled, i)))
        } else {
          ()
        }
      } else {
        ()
      }
      i = i + 1
    }
  } else {
    ()
  }
}

fn append_import_value_renames(plan: ExportRenamePlan, target: String, items: Array[ImportItem], plain_reexports_only: Bool, out: Array[(String, String)], locals_seen: Array[String]) -> Unit with Exception {
  let mut j = Array::length(items) - 1
  while j >= 0 {
    let item = Array::get(items, j)
    let original = item.name
    let alias_opt = item.alias
    let local = match alias_opt {
      Some(alias) => alias,
      None => original
    }
    let locally_visible = if plain_reexports_only {
      match alias_opt {
        Some(_) => false,
        None => true
      }
    } else {
      true
    }
    append_imported_trait_operation_renames(plan, target, item, locally_visible, out, locals_seen)
    if !import_alias_rewrite_string_array_contains(locals_seen, local) {
      // Walk bindings newest-first. Even a target that stays bare claims the
      // spelling and prevents an older import from supplying a stale rename.
      // Publication-only aliases claim their local spelling too: they emit no
      // rewrite, but still override an earlier import with the same local name.
      Array::push(locals_seen, local)
      if locally_visible {
        match MutMap::get(plan.rename_idx, plan_rename_key(target, original)) {
          Some(mangled) => {
            Array::push(out, (local, mangled))
          },
          None => match MutMap::get(plan.enum_alias_idx, plan_rename_key(target, original)) {
            Some(enum_head) => if MutMap::has(plan.enum_origin_ambiguous, enum_head) {
              throw("rename one of the enums named `" + enum_head + "`: imported alias `" + local + "` reaches that name in more than one source file, so its constructor cannot be selected safely")
            } else {
              Array::push(out, (local, enum_head))
              match MutMap::get(plan.enum_alias_private_ctors, plan_rename_key(target, original)) {
                Some(rows) => for row in rows {
                  Array::push(out, (local + "::" + row.0, row.1))
                },
                None => ()
              }
            },
            None => ()
          }
        }
      } else {
        ()
      }
    } else {
      ()
    }
    j = j - 1
  }
}

/// (local -> origin) reference renames for one importing file, including a
/// kinded enum alias imported through a facade. Aliased re-exports remain
/// publication-only in their own source unit and contribute no local rewrite.
export fn collect_import_value_renames(plan: ExportRenamePlan, path: String, stmts: Array[Stmt]) -> Array[(String, String)] with Exception {
  if Array::length(plan.type_collision_errors) > 0 {
    throw(Array::get(plan.type_collision_errors, 0))
  }
  let out = empty_aliases()
  let locals_seen = empty_strings()
  let rename_paths = plan.rename_paths
  let rename_names = plan.rename_names
  let rename_mangled = plan.rename_mangled
  if Array::length(rename_paths) == 0 && plan.enum_alias_count == 0 {
    out
  } else {
    // The checker hoists declarations in this source unit above imports.
    // Their type heads must keep their own constructors and methods even
    // when a facade publishes an enum under the same spelling.
    let declared_types = collect_declared_type_names(stmts)
    let mut ti = 0
    while ti < Array::length(declared_types) {
      Array::push(locals_seen, Array::get(declared_types, ti))
      ti = ti + 1
    }
    // A source-local qualified helper owns its exact spelling. In particular,
    // `import { trait Iterator }` plus a local `Iterator::map` intentionally
    // blocks the imported operation, while an aliased `Iter::map` remains a
    // distinct provider-owned spelling.
    let mut li = 0
    while li < Array::length(stmts) {
      let local_name = match Array::get(stmts, li) {
        SLet(_, _, name, _, _) => name,
        SFnDecl(_, name, _, _, _) => name,
        _ => ""
      }
      if String::index_of(local_name, "::") > 0 && !import_alias_rewrite_string_array_contains(locals_seen, local_name) {
        Array::push(locals_seen, local_name)
      } else {
        ()
      }
      li = li + 1
    }
    let base_dir = dir_of_path(path)
    // `build_import_env_collecting` prepends bindings as it walks source
    // order, so the last statement wins. Visit in reverse and retain only the
    // first occurrence of each local spelling to match that environment.
    let mut i = Array::length(stmts) - 1
    while i >= 0 {
      match Array::get(stmts, i) {
        SImport(raw_path, items) => if !is_builtin_iterator_serialized_boundary_path(raw_path) {
          let target = resolve_known_import_path(plan.plan_paths, base_dir, raw_path, path)
          append_import_value_renames(plan, target, items, false, out, locals_seen)
        },
        SReExport(raw_path, items) => {
          let target = resolve_known_import_path(plan.plan_paths, base_dir, raw_path, path)
          append_import_value_renames(plan, target, items, true, out, locals_seen)
        },
        _ => ()
      }
      i = i - 1
    }
    out
  }
}

export fn import_value_rename_locals(renames: Array[(String, String)]) -> Array[String] {
  let out = empty_strings()
  let mut i = 0
  while i < Array::length(renames) {
    let (local, _) = Array::get(renames, i)
    Array::push(out, local)
    i = i + 1
  }
  out
}

/// Apply (name -> mangled) def renames to one file's statements: SLet def
/// names, `export { ... }` items, and every value reference (shadow-aware via
/// rewrite_import_alias_expr).
export fn apply_export_renames_stmts(stmts: Array[Stmt], renames: Array[(String, String)]) -> Array[Stmt] {
  if Array::length(renames) == 0 {
    stmts
  } else {
    let am = aliasidx_build(renames)
    for stmt in stmts {
      match stmt {
        SLet(exported, is_rec, name, ty, body) => {
          let next_name = match aliasidx_get(am, name) {
            Some(renamed) => renamed,
            None => name
          }
          SLet(exported, is_rec, next_name, ty, rewrite_alias_expr_ix(body, am))
        },
        SFnDecl(exported, name, body, requires, ensures) => {
          let next_name = match aliasidx_get(am, name) {
            Some(renamed) => renamed,
            None => name
          }
          SFnDecl(exported, next_name, rewrite_alias_expr_ix(body, am), for requirement in requires {
            rewrite_alias_expr_ix(requirement, am)
          }, for guarantee in ensures {
            rewrite_alias_expr_ix(guarantee, am)
          })
        },
        SLetMut(name, ty, body) => SLetMut(name, ty, rewrite_alias_expr_ix(body, am)),
        SExport(items) => SExport(for item in items {
          match aliasidx_get(am, item) {
            Some(renamed) => renamed,
            None => item
          }
        }),
        STest(name, body) => STest(name, rewrite_alias_expr_ix(body, am)),
        SBench(name, body) => SBench(name, rewrite_alias_expr_ix(body, am)),
        SExpr(body) => SExpr(rewrite_alias_expr_ix(body, am)),
        SLetPat(pat, body) => SLetPat(pat, rewrite_alias_expr_ix(body, am)),
        _ => stmt
      }
    }
  }
}

/// `export let eq: (Float, Float) -> Bool = float_eq` binds a NAME to another
/// top-level function. The backend function tables register such non-EFn lets
/// as 0-parameter thunks, so a CALL through the alias emits N arguments
/// against a 0-param function — invalid wasm (stack imbalance), on every
/// backend and for any arity (found while fixing #716: @vibe/builtin/float.vibe
/// exports its whole API this way). Rewrite every reference to a top-level
/// function alias (chains followed, ≤16) to the final EFn def's name. The
/// alias def itself stays: it is inert once nothing refers to it, and its
/// export flag keeps the wasm export surface unchanged.
export fn rewrite_top_level_fn_alias_refs(stmts: Array[Stmt]) -> Unit {
  apply_top_level_fn_alias_renames(stmts, collect_top_level_fn_alias_renames(stmts))
}

/// The (alias -> final EFn name) renames `rewrite_top_level_fn_alias_refs`
/// derives, WITHOUT applying them.
///
/// Split out for the per-module prelude (#2647 Codex round 3). The map is a
/// WHOLE-PROGRAM fact: the alias declaration and the call through it routinely
/// live in different modules, and a partition holding only the call has no
/// alias to find, so the rewrite silently does nothing -- and an unrewritten
/// call through a non-`EFn` alias emits N arguments against the 0-parameter
/// thunk the backend registers, which is invalid wasm on every backend. So the
/// map is collected once on the merged program and handed to every module.
export fn collect_top_level_fn_alias_renames(stmts: Array[Stmt]) -> Array[(String, String)] {
  let fn_names = empty_strings()
  let alias_names = empty_strings()
  let alias_targets = empty_strings()
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SLet(_, _, name, _, expr) => match expr {
        EFn(_, _, _, _, _, _) => Array::push(fn_names, name),
        EIdent(target, _) => {
          Array::push(alias_names, name)
          Array::push(alias_targets, target)
        },
        _ => ()
      },
      _ => ()
    }
    i = i + 1
  }
  if Array::length(alias_names) == 0 {
    empty_aliases()
  } else {
    let renames = empty_aliases()
    let mut ai = 0
    while ai < Array::length(alias_names) {
      let mut target = Array::get(alias_targets, ai)
      let mut final_target = ""
      let mut depth = 0
      while depth < 16 {
        if import_alias_rewrite_string_array_contains(fn_names, target) {
          final_target = target
          depth = 16
        } else {
          let mut hop = false
          let mut aj = 0
          while aj < Array::length(alias_names) && !hop {
            if Array::get(alias_names, aj) == target {
              target = Array::get(alias_targets, aj)
              hop = true
            } else {
              aj = aj + 1
            }
          }
          if hop {
            depth = depth + 1
          } else {
            depth = 16
          }
        }
      }
      if final_target != "" && final_target != Array::get(alias_names, ai) {
        Array::push(renames, (Array::get(alias_names, ai), final_target))
      } else {
        ()
      }
      ai = ai + 1
    }
    renames
  }
}

/// Apply a rename map collected by `collect_top_level_fn_alias_renames`,
/// possibly from a LARGER program than `stmts`.
export fn apply_top_level_fn_alias_renames(stmts: Array[Stmt], renames: Array[(String, String)]) -> Unit {
  if Array::length(renames) == 0 {
    ()
  } else {
    let ram = aliasidx_build(renames)
    let mut si = 0
    while si < Array::length(stmts) {
      match Array::get(stmts, si) {
        SLet(exported, is_rec, name, ty, body) => Array::set(stmts, si, SLet(exported, is_rec, name, ty, rewrite_alias_expr_ix(body, ram))),
        SLetMut(name, ty, body) => Array::set(stmts, si, SLetMut(name, ty, rewrite_alias_expr_ix(body, ram))),
        STest(name, body) => Array::set(stmts, si, STest(name, rewrite_alias_expr_ix(body, ram))),
        SBench(name, body) => Array::set(stmts, si, SBench(name, rewrite_alias_expr_ix(body, ram))),
        SExpr(body) => Array::set(stmts, si, SExpr(rewrite_alias_expr_ix(body, ram))),
        SLetPat(pat, body) => Array::set(stmts, si, SLetPat(pat, rewrite_alias_expr_ix(body, ram))),
        _ => ()
      }
      si = si + 1
    }
  }
}

/// #3132, #3185: every builtin spelling the compiler knows BY NAME -- the
/// names a codegen lane intercepts ahead of the function table (the linear
/// call ladder in `codegen/expr/compile_call.vibe`, the arms of
/// `compile_call_gc`), the names its classifiers read the result type of
/// from the spelling (`__to_string`'s renderer, the float and Int
/// classifiers), the calls its desugarings synthesize (for-in,
/// interpolation, structural `==`, effect lowering, iterator
/// devirtualization), the parser's sugar (`__index`, `__rec_field`,
/// `__slice`, `__len`, `__set_field`, `__region_run`), and the capability
/// builtins (#3186). The list is the union of the builtin registry, the
/// ladder's name set, the gc lane's arms and the checker's by-name builtins,
/// so a program's own definition of any of them is moved aside and every call
/// the program wrote reaches it on every lane -- the call the checker types
/// from that definition.
///
/// Before #3185 the list held only the container builtins the compiler itself
/// calls. A program's own `Array::map`, `Int::to_double`, `Char::to_int`,
/// `Map::set`, `__slice` or `Fs::exists` kept its source spelling, so the
/// ladder took the program's direct call and ran the builtin: the checker
/// typed `Int::to_double(3)` from the program's `-> Int` declaration and the
/// call answered `3` on linear and `1.48e-321` on wasm-gc, and a pure
/// program `Fs::exists` -- exempt from the `Fs` row because the program's
/// function answers for it (#2107) -- reached the host import shim on
/// linear. The parser's `obj.f = x` sugar was a bare `__set_field`, so a
/// program's own `fn __set_field` took every field write.
///
/// Excluded on purpose: `Map::iter_get` / `Map::__iter_get_unchecked`, whose
/// source definition the compiler deliberately honours (#2379);
/// `String::equals`, which the prelude defines as source (#2483); and
/// `__compact_fingerprint_hash`, whose `lib/@vibe/cache` definition the
/// linked lane bridges by its namespaced name. A `lib/` package that
/// publishes one of these names publishes it bodyless (`@vibe/builtin`) or as
/// a value alias of its own wrapper (`@vibe/fs`, `@vibe/http`), which the
/// rename moves aside like any definition.
///
/// Kept sorted (`LC_ALL=C`), which `is_builtin_shadow_rename_name` relies on
/// for its binary search. scripts/review_lint.vibex reads this literal to
/// refuse a bare `EIdent` of a listed name outside codegen.
