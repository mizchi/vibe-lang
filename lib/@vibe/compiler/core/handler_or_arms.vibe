//# Or-pattern handler arms (#3301)
//
// A handler arm `A | B => body` means the two arms `A => body` and
// `B => body`: each alternative is its own operation, with its own payload
// and its own continuation `resume`. Every pass that reads a handler arm --
// the checker's typing, exhaustiveness and effect rows, the host-call
// interception, and both effect lowerings -- names ONE operation per arm, and
// none of them read an or-pattern arm. Such an arm was never type-checked,
// and its handle survived lowering for codegen to compile to `unreachable`.
// Splitting the arm before those passes run hands each of them the separate
// arms it already handles, so they cannot disagree about what the arm means.
//
// Each alternative gets its own copy of the body, and an or-pattern arm in
// that body is split again inside every copy, so nested or-pattern arms
// multiply: a chain of n arms with two alternatives each copies its innermost
// body 2^n times. The split refuses an arm whose body it would copy more than
// hoa_copy_limit times rather than expand it. Moving a nested `handle` into a
// top-level `fn` makes each copy a call; a closure written in place is still
// inside the arm, and is copied with it.

import ./ast.vibe {
  Expr, Pat, Stmt
}

import ./expr_children.vibe {
  expr_any_node, expr_child_at, expr_children_pop, expr_children_push, expr_children_top
}

//# Patterns

fn hoa_pat_binds(pat: Pat) -> Bool {
  match pat {
    PWild => false,
    PBind(_) => true,
    PInt(_) => false,
    PFloat(_) => false,
    PString(_) => false,
    PBool(_) => false,
    PCtor(_, subs) => hoa_pats_bind(subs),
    PTuple(subs) => hoa_pats_bind(subs),
    POr(left, right) => hoa_pat_binds(left) || hoa_pat_binds(right),
    PStruct(_, fields) => {
      let mut found = false
      let mut i = 0
      while !found && i < Array::length(fields) {
        let (_, field_pat) = Array::get(fields, i)
        found = hoa_pat_binds(field_pat)
        i = i + 1
      }
      found
    }
  }
}

fn hoa_pats_bind(pats: Array[Pat]) -> Bool {
  let mut found = false
  let mut i = 0
  while !found && i < Array::length(pats) {
    found = hoa_pat_binds(Array::get(pats, i))
    i = i + 1
  }
  found
}

/// Whether the split rewrites an arm with this pattern. An or-pattern whose
/// alternatives bind no name and test no payload always is. One that binds a
/// name, or tests a payload, is split only `with_binders`: the checker leaves
/// it in place so it can refuse it, as it refuses a binding or-pattern in a
/// `match` arm, and the lowerings split it anyway, so no lane can compile it
/// to a handle nothing lowers.
fn hoa_splits(pat: Pat, with_binders: Bool) -> Bool {
  match pat {
    POr(_, _) => with_binders || (!hoa_pat_binds(pat) && !hoa_tests_payload(pat)),
    _ => false
  }
}

/// Whether an alternative tests a payload's value: a literal, a constructor,
/// a tuple or a struct where an operation's payload takes `_` or a name.
/// Neither effect lowering matches an arm's payload patterns -- both bind
/// the payload and dispatch on the operation alone, so `P(1) => ..` runs for
/// `perform P(3)` too -- and the split must not hand them another route to
/// that (#3301, Codex on #3337).
fn hoa_tests_payload(pat: Pat) -> Bool {
  match pat {
    POr(left, right) => hoa_tests_payload(left) || hoa_tests_payload(right),
    PCtor(_, subs) => {
      let mut found = false
      let mut i = 0
      while !found && i < Array::length(subs) {
        found = match Array::get(subs, i) {
          PWild => false,
          PBind(_) => false,
          _ => true
        }
        i = i + 1
      }
      found
    },
    _ => false
  }
}

/// #3301: whether an or-pattern handler arm tests a payload's value
/// (`P(1) | Q(_)`), which the split leaves for the checker to refuse.
export fn handler_or_arm_tests_payload(pat: Pat) -> Bool {
  match pat {
    POr(_, _) => hoa_tests_payload(pat),
    _ => false
  }
}

fn hoa_alternatives_into(pat: Pat, out: Array[Pat]) -> Unit {
  match pat {
    POr(left, right) => {
      hoa_alternatives_into(left, out)
      hoa_alternatives_into(right, out)
    },
    _ => Array::push(out, pat)
  }
}

fn hoa_alternative_count(pat: Pat) -> Int {
  match pat {
    POr(left, right) => hoa_alternative_count(left) + hoa_alternative_count(right),
    _ => 1
  }
}

fn hoa_arms_split_any(arms: Array[(Pat, Expr)], with_binders: Bool) -> Bool {
  let mut found = false
  let mut i = 0
  while !found && i < Array::length(arms) {
    let (pat, _) = Array::get(arms, i)
    found = hoa_splits(pat, with_binders)
    i = i + 1
  }
  found
}

//# Expressions

/// Each arm the split takes becomes one arm per alternative, left to right,
/// in its place, so the first arm that names an operation still wins. Every
/// copy gets a body of its own: the passes after this one rewrite arm bodies,
/// and two arms sharing one tree would share any in-place edit as well.
///
/// For the checker (`with_binders` false) the arm also gets a group id, and
/// every copy's body is stamped with it (hoa_stamp): the checker compares the
/// copies of one source arm, and the stamp is the only thing that says which
/// arms those are -- it reads no offset, order or shape, so a lane that parses
/// without offsets answers as the others do, and two arms the program wrote
/// apart are never taken for one. erase_handler_or_arm_stamps removes the
/// stamps once the check is done.
fn hoa_arms(arms: Array[(Pat, Expr)], split: Bool, with_binders: Bool) -> Array[(Pat, Expr)] {
  let out: Array[(Pat, Expr)] = []
  let mut i = 0
  while i < Array::length(arms) {
    let (pat, body) = Array::get(arms, i)
    if split && hoa_splits(pat, with_binders) {
      let alternatives: Array[Pat] = []
      hoa_alternatives_into(pat, alternatives)
      let group = if with_binders {
        -1
      } else {
        let id = Array::length(hoa_groups)
        Array::push(hoa_groups, (alternatives, body))
        id
      }
      let mut j = 0
      while j < Array::length(alternatives) {
        let copy = hoa_expr(body, with_binders)
        Array::push(out, (Array::get(alternatives, j), if group >= 0 {
          ELet(hoa_stamp_name, EInt(group), copy, -1)
        } else {
          copy
        }))
        j = j + 1
      }
    } else {
      Array::push(out, (pat, hoa_expr(body, with_binders)))
    }
    i = i + 1
  }
  out
}

fn hoa_exprs(exprs: Array[Expr], with_binders: Bool) -> Array[Expr] {
  let out: Array[Expr] = []
  let mut i = 0
  while i < Array::length(exprs) {
    Array::push(out, hoa_expr(Array::get(exprs, i), with_binders))
    i = i + 1
  }
  out
}

fn hoa_named(pairs: Array[(String, Expr)], with_binders: Bool) -> Array[(String, Expr)] {
  let out: Array[(String, Expr)] = []
  let mut i = 0
  while i < Array::length(pairs) {
    let (name, value) = Array::get(pairs, i)
    Array::push(out, (name, hoa_expr(value, with_binders)))
    i = i + 1
  }
  out
}

fn hoa_expr(expr: Expr, with_binders: Bool) -> Expr {
  match expr {
    EInt(_) => expr,
    EFloat(_) => expr,
    EString(_, _) => expr,
    EBool(_) => expr,
    EIdent(_, _) => expr,
    EStringInterp(_) => expr,
    EUnit => expr,
    ETuple(elems) => ETuple(hoa_exprs(elems, with_binders)),
    EArray(elems) => EArray(hoa_exprs(elems, with_binders)),
    ERecord(name, fields, targs) => ERecord(name, hoa_named(fields, with_binders), targs),
    EIf(cond, then_e, else_e) => EIf(hoa_expr(cond, with_binders), hoa_expr(then_e, with_binders), hoa_expr(else_e, with_binders)),
    ELet(name, value, body, off) => ELet(name, hoa_expr(value, with_binders), hoa_expr(body, with_binders), off),
    ELetRec(name, value, body) => ELetRec(name, hoa_expr(value, with_binders), hoa_expr(body, with_binders)),
    ELetMut(name, value, body, off) => ELetMut(name, hoa_expr(value, with_binders), hoa_expr(body, with_binders), off),
    EAssign(name, value, cont, target_off) => EAssign(name, hoa_expr(value, with_binders), hoa_expr(cont, with_binders), target_off),
    EAssignOp(name, op, value, cont, target_off) => EAssignOp(name, op, hoa_expr(value, with_binders), hoa_expr(cont, with_binders), target_off),
    ESeq(first, second) => ESeq(hoa_expr(first, with_binders), hoa_expr(second, with_binders)),
    EMatch(scrutinee, arms) => EMatch(hoa_expr(scrutinee, with_binders), hoa_arms(arms, false, with_binders)),
    EHandle(body, arms) => EHandle(hoa_expr(body, with_binders), hoa_arms(arms, true, with_binders)),
    EWhile(cond, body) => EWhile(hoa_expr(cond, with_binders), hoa_expr(body, with_binders)),
    ELoop(params, body) => ELoop(hoa_named(params, with_binders), hoa_expr(body, with_binders)),
    EForIn(name, index, iter, body) => EForIn(name, index, hoa_expr(iter, with_binders), hoa_expr(body, with_binders)),
    ECall(callee, args, off, resolution) => ECall(hoa_expr(callee, with_binders), hoa_exprs(args, with_binders), off, resolution),
    EBinOp(op, left, right, off) => EBinOp(op, hoa_expr(left, with_binders), hoa_expr(right, with_binders), off),
    EUnaryOp(op, operand) => EUnaryOp(op, hoa_expr(operand, with_binders)),
    EFn(tparams, bounds, params, ret, eff, body) => EFn(tparams, bounds, params, ret, eff, hoa_expr(body, with_binders)),
    EDot(receiver, field, off, field_off) => EDot(hoa_expr(receiver, with_binders), field, off, field_off),
    ELabeledArg(label, name, value) => ELabeledArg(label, name, hoa_expr(value, with_binders)),
    EReturn(value) => EReturn(hoa_expr(value, with_binders)),
    EBreak(value) => match value {
      Some(v) => EBreak(Some(hoa_expr(v, with_binders))),
      None => expr
    },
    EContinue(args) => EContinue(hoa_exprs(args, with_binders)),
    EMap(entries) => EMap(hoa_named(entries, with_binders)),
    ESpread(value) => ESpread(hoa_expr(value, with_binders))
  }
}

fn hoa_node_splits_with_binders(node: Expr) -> Bool {
  match node {
    EHandle(_, arms) => hoa_arms_split_any(arms, true),
    _ => false
  }
}

fn hoa_node_splits_without_binders(node: Expr) -> Bool {
  match node {
    EHandle(_, arms) => hoa_arms_split_any(arms, false),
    _ => false
  }
}

fn hoa_needs_split(expr: Expr, with_binders: Bool) -> Bool {
  if with_binders {
    expr_any_node(expr, hoa_node_splits_with_binders)
  } else {
    expr_any_node(expr, hoa_node_splits_without_binders)
  }
}

fn hoa_split(expr: Expr, with_binders: Bool) -> Expr {
  if hoa_needs_split(expr, with_binders) {
    hoa_expr(expr, with_binders)
  } else {
    expr
  }
}

fn hoa_exprs_need_split(exprs: Array[Expr], with_binders: Bool) -> Bool {
  let mut found = false
  let mut i = 0
  while !found && i < Array::length(exprs) {
    found = hoa_needs_split(Array::get(exprs, i), with_binders)
    i = i + 1
  }
  found
}

//# Copy limit

/// The most copies the split makes of one `handle` that has an or-pattern arm
/// of its own. Bounding that, rather than the depth, keeps the expansion a
/// function of how large the program is instead of an exponential of how deep
/// its or-pattern arms nest. Measured with a chain of nested two-alternative
/// arms (#3301): `vibe check` took 1.6 s at 8 levels, 5.8 s at 12 and 92 s
/// at 14, and had not finished 16 after five minutes. At this limit a chain
/// of nine still compiles, as does an or-pattern arm of up to 256
/// alternatives around another one.
let hoa_copy_limit: Int = 256

/// The smallest source offset any node of `expr` carries, or -1.
fn hoa_first_offset(expr: Expr) -> Int {
  let mut first = match expr {
    EIdent(_, off) => off,
    EString(_, off) => off,
    ELet(_, _, _, off) => off,
    ELetMut(_, _, _, off) => off,
    ECall(_, _, off, _) => off,
    EBinOp(_, _, _, off) => off,
    EDot(_, _, off, _) => off,
    _ => -1
  }
  let mark = expr_children_push(expr)
  let top = expr_children_top()
  let mut i = mark
  while i < top {
    let child = hoa_first_offset(expr_child_at(i))
    if child >= 0 && (first < 0 || child < first) {
      first = child
    } else {
      ()
    }
    i = i + 1
  }
  expr_children_pop(mark)
  first
}

/// The first `handle` in `expr`, in source order, whose current arm expansion
/// together with its enclosing arms exceeds hoa_copy_limit, with that count.
/// `copies` is how many times the split copies `expr`: an arm's body is copied
/// once per alternative of that arm, on top of the copies of the arm itself.
fn hoa_over_limit(expr: Expr, copies: Int, with_binders: Bool) -> Option[(Expr, Int)] {
  match expr {
    EHandle(body, arms) => {
      let mut hit = hoa_over_limit(body, copies, with_binders)
      let mut i = 0
      while hoa_no_hit(hit) && i < Array::length(arms) {
        let (pat, arm_body) = Array::get(arms, i)
        let arm_copies = if hoa_splits(pat, with_binders) {
          copies * hoa_alternative_count(pat)
        } else {
          copies
        }
        hit = if arm_copies > hoa_copy_limit {
          Some((expr, arm_copies))
        } else {
          hoa_over_limit(arm_body, arm_copies, with_binders)
        }
        i = i + 1
      }
      hit
    },
    _ => {
      let mark = expr_children_push(expr)
      let top = expr_children_top()
      let mut hit: Option[(Expr, Int)] = None
      let mut i = mark
      while hoa_no_hit(hit) && i < top {
        hit = hoa_over_limit(expr_child_at(i), copies, with_binders)
        i = i + 1
      }
      expr_children_pop(mark)
      hit
    }
  }
}

fn hoa_no_hit(hit: Option[(Expr, Int)]) -> Bool {
  match hit {
    Some(_) => false,
    None => true
  }
}

/// The refusal for the first `handle` whose arm expansion exceeds
/// hoa_copy_limit, located at that `handle`; None when every arm stays within it.
fn hoa_copy_refusal(stmts: Array[Stmt], with_binders: Bool) -> Option[String] {
  let exprs: Array[Expr] = []
  hoa_stmt_exprs_into(stmts, exprs)
  let mut refusal: Option[String] = None
  let mut i = 0
  while i < Array::length(exprs) {
    let expr = Array::get(exprs, i)
    match refusal {
      Some(_) => (),
      None => if hoa_needs_split(expr, with_binders) {
        match hoa_over_limit(expr, 1, with_binders) {
          Some((site, copies)) => {
            let off = hoa_first_offset(site)
            let marker = if off >= 0 {
              String::concat(" [@off=", String::concat(__to_string(off), "]"))
            } else {
              ""
            }
            refusal = Some(String::concat("write separate handler arms, or move this nested `handle` into a top-level `fn` (passing it the values it uses from around it) and call that here: an or-pattern handler arm (`A | B => ..`) is compiled once per operation, together with every closure and `handle` inside it, so this arm and its enclosing or-pattern arms would compile its body ", String::concat(__to_string(copies), String::concat(" times, over the limit of ", String::concat(__to_string(hoa_copy_limit), marker)))))
          },
          None => ()
        }
      } else {
        ()
      }
    }
    i = i + 1
  }
  refusal
}

//# Group stamps

/// The or-pattern arms the last checker split took, by group id: each arm's
/// alternatives and its body as written.
let hoa_groups: Array[(Array[Pat], Expr)] = Array::slice([([PWild], EUnit)], 0, 0)

/// The binder of the `let` the checker split wraps each copy's body in, its
/// value the arm's group id. `$` cannot begin a name a program writes.
let hoa_stamp_name: String = "$or_arm_group"

/// #3301: the or-pattern arms the last `split_handler_or_arms(_, false)`
/// took, indexed by the group id it stamped on their copies
/// (handler_or_arm_stamp): each arm's alternatives and its body as written.
export fn handler_or_arm_groups() -> Array[(Array[Pat], Expr)] {
  hoa_groups
}

/// #3301: the group id the checker split stamped on an arm body, with the
/// body under the stamp; (-1, body) for a body that carries none.
export fn handler_or_arm_stamp(body: Expr) -> (Int, Expr) {
  match body {
    ELet(name, EInt(group), inner, _) => if name == hoa_stamp_name {
      (group, inner)
    } else {
      (-1, body)
    }
    _ => (-1, body)
  }
}

/// #3301: take the checker split's stamps off every arm in `stmts`, in place,
/// so nothing after the check sees them.
export fn erase_handler_or_arm_stamps(stmts: Array[Stmt]) -> Unit {
  let exprs: Array[Expr] = []
  hoa_stmt_exprs_into(stmts, exprs)
  let mut i = 0
  while i < Array::length(exprs) {
    hoa_erase_stamps(Array::get(exprs, i))
    i = i + 1
  }
}

fn hoa_erase_stamps(expr: Expr) -> Unit {
  match expr {
    EHandle(_, arms) => {
      let mut i = 0
      while i < Array::length(arms) {
        let (pat, body) = Array::get(arms, i)
        let (group, inner) = handler_or_arm_stamp(body)
        if group >= 0 {
          Array::set(arms, i, (pat, inner))
        } else {
          ()
        }
        i = i + 1
      }
    },
    _ => ()
  }
  let mark = expr_children_push(expr)
  let top = expr_children_top()
  let mut i = mark
  while i < top {
    hoa_erase_stamps(expr_child_at(i))
    i = i + 1
  }
  expr_children_pop(mark)
}

//# Statements

/// #3301: split every handler arm `A | B => body` in `stmts` into
/// `A => body` and `B => body`, in place, so each arm names one operation.
/// A statement with no or-pattern handler arm is left as it was, unvisited by
/// the rebuild. With `with_binders` false an alternative that binds a name
/// keeps its arm whole, for the checker to refuse. An arm body the split would
/// copy more than hoa_copy_limit times is refused before anything is split.
export fn split_handler_or_arms(stmts: Array[Stmt], with_binders: Bool) -> Unit with Exception {
  if !with_binders {
    Array::truncate(hoa_groups, 0)
  } else {
    ()
  }
  match hoa_copy_refusal(stmts, with_binders) {
    Some(refusal) => throw(refusal),
    None => {
      let _changed = hoa_split_stmts(stmts, with_binders)
    }
  }
}

/// Every expression a statement in `stmts` holds, the ones
/// hoa_split_stmts rebuilds.
fn hoa_stmt_exprs_into(stmts: Array[Stmt], out: Array[Expr]) -> Unit {
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SLet(_, _, _, _, expr) => Array::push(out, expr),
      SLetMut(_, _, expr) => Array::push(out, expr),
      SExpr(expr) => Array::push(out, expr),
      STest(_, expr) => Array::push(out, expr),
      SBench(_, expr) => Array::push(out, expr),
      SExample(_, expr) => Array::push(out, expr),
      SLetPat(_, expr) => Array::push(out, expr),
      SFnDecl(_, _, value, requires, ensures) => {
        Array::push(out, value)
        let mut j = 0
        while j < Array::length(requires) {
          Array::push(out, Array::get(requires, j))
          j = j + 1
        }
        let mut k = 0
        while k < Array::length(ensures) {
          Array::push(out, Array::get(ensures, k))
          k = k + 1
        }
      },
      SModule(_, _, inner) => hoa_stmt_exprs_into(inner, out),
      _ => ()
    }
    i = i + 1
  }
}

/// Whether any statement was rebuilt. A module's statements are split in a
/// copy: the array may be shared with a cached parse, and only `stmts` itself
/// belongs to the caller.
fn hoa_split_stmts(stmts: Array[Stmt], with_binders: Bool) -> Bool {
  let mut changed = false
  let mut i = 0
  while i < Array::length(stmts) {
    let rebuilt = match Array::get(stmts, i) {
      SLet(exported, is_rec, name, ty, expr) => if hoa_needs_split(expr, with_binders) {
        Some(SLet(exported, is_rec, name, ty, hoa_expr(expr, with_binders)))
      } else {
        None
      },
      SLetMut(name, ty, expr) => if hoa_needs_split(expr, with_binders) {
        Some(SLetMut(name, ty, hoa_expr(expr, with_binders)))
      } else {
        None
      },
      SExpr(expr) => if hoa_needs_split(expr, with_binders) {
        Some(SExpr(hoa_expr(expr, with_binders)))
      } else {
        None
      },
      STest(name, expr) => if hoa_needs_split(expr, with_binders) {
        Some(STest(name, hoa_expr(expr, with_binders)))
      } else {
        None
      },
      SBench(name, expr) => if hoa_needs_split(expr, with_binders) {
        Some(SBench(name, hoa_expr(expr, with_binders)))
      } else {
        None
      },
      SExample(name, expr) => if hoa_needs_split(expr, with_binders) {
        Some(SExample(name, hoa_expr(expr, with_binders)))
      } else {
        None
      },
      SLetPat(pat, expr) => if hoa_needs_split(expr, with_binders) {
        Some(SLetPat(pat, hoa_expr(expr, with_binders)))
      } else {
        None
      },
      SFnDecl(exported, name, value, requires, ensures) => if hoa_needs_split(value, with_binders) || hoa_exprs_need_split(requires, with_binders) || hoa_exprs_need_split(ensures, with_binders) {
        Some(SFnDecl(exported, name, hoa_split(value, with_binders), hoa_exprs(requires, with_binders), hoa_exprs(ensures, with_binders)))
      } else {
        None
      },
      SModule(exported, name, inner) => {
        let copy = Array::slice(inner, 0, Array::length(inner))
        if hoa_split_stmts(copy, with_binders) {
          Some(SModule(exported, name, copy))
        } else {
          None
        }
      },
      _ => None
    }
    match rebuilt {
      Some(stmt) => {
        Array::set(stmts, i, stmt)
        changed = true
      },
      None => ()
    }
    i = i + 1
  }
  changed
}
