//# The unstable-surface rule, in one place (#2248, #2284)
//
// `@vibe/concurrent/experimental` -- the suspendable-task lane of ADR-0068 --
// is outside the SemVer promise and able to change inside a Minor release, so
// importing it requires `VIBE_UNSTABLE=1`. The stable core, `@vibe/concurrent`
// (task groups, channels, `Parallel::map`), re-exports a subset of it and
// needs no opt-in.
//
// Two passes need this rule and they sit on opposite sides of the import
// graph, which is why it lives in core rather than beside either one:
//
//   - `loader.vibe` needs the NAME, as a cheap substring pre-filter while it
//     ingests each module of the resolved closure (#2284). It cannot import
//     `cli_support.vibe`, which is above it.
//   - `cli_support.vibe` needs the NOTE, for the diagnostic it emits after the
//     precise token scan confirms a real `SImport`.
//
// One spelling. The pre-filter deliberately over-matches -- a comment
// mentioning the package counts -- because the verdict is the token scan's,
// never the substring's.

/// The package whose surface is opt-in. Subpaths count:
/// `@vibe/concurrent/experimental/x` is the same surface; the stable parent
/// `@vibe/concurrent` is not.
export let unstable_package_name: String = "@vibe/concurrent/experimental"

/// The diagnostic for an import of that package, or "" for any other name.
/// Leads with the edit that fixes it, per the CLI policy: set the variable, or
/// drop the import.
export fn unstable_package_note(name: String) -> String {
  if name == unstable_package_name || String::starts_with(name, String::concat(unstable_package_name, "/")) {
    "set VIBE_UNSTABLE=1 to build against `@vibe/concurrent/experimental`, or drop the import. Its suspendable-task lane (`spawn_suspend`, `pump_all`, `sleep_wait`, `send_wait` / `recv_wait`, ...) is outside the SemVer promise and can change within a Minor release, so it is opt-in rather than silent (docs/user/reference/stable-surface.md section 6). The stable core -- `TaskGroup::run` / `spawn`, `TaskHandle::join`, channels, `Parallel::map` -- is `@vibe/concurrent`, which needs no opt-in."
  } else {
    ""
  }
}

/// Whether a module's text could possibly carry such an import. Cheap and
/// deliberately loose -- the caller confirms with a token scan.
///
/// A mention on a line whose first non-blank characters are `//` does not
/// count: such a line is a comment or the inside of a multi-line string, and
/// neither can hold an import. That is still an over-match everywhere else,
/// so the token scan keeps the verdict. It matters because the compiler's own
/// sources mention the package in comments -- about 2.4 MB of them -- and
/// every candidate is lexed in full by the closure scan (~37 MB of the
/// self-compile heap before this).
export fn text_mentions_unstable_package(text: String) -> Bool {
  if String::index_of(text, unstable_package_name) < 0 {
    false
  } else {
    let n = String::length(text)
    let mut i = 0
    let mut found = false
    while !found && i < n {
      // `i` is at a line start: skip its indentation, then the whole line if
      // it is a `//` line, else look for the name up to the line's end.
      while i < n && (String::byte_at(text, i) == ' ' || String::byte_at(text, i) == '\t') {
        i = i + 1
      }
      let comment = i + 1 < n && String::byte_at(text, i) == '/' && String::byte_at(text, i + 1) == '/'
      while i < n && String::byte_at(text, i) != '\n' {
        if !comment && !found && unstable_name_at(text, i) {
          found = true
        }
        i = i + 1
      }
      i = i + 1
    }
    found
  }
}

fn unstable_name_at(text: String, at: Int) -> Bool {
  let m = String::length(unstable_package_name)
  if at + m > String::length(text) {
    false
  } else {
    let mut k = 0
    while k < m && String::byte_at(text, at + k) == String::byte_at(unstable_package_name, k) {
      k = k + 1
    }
    k == m
  }
}
