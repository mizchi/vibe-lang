//# Overlapping impls across the modules of one linked program (#3544)
//
// An impl's methods are program-wide bindings named after the target
// (`impl Name for Int { name(..) }` binds `Int::name`), and the merge that
// links the import closure into one program renames private and colliding
// EXPORTED names apart but not these. So two modules that each write `impl
// Name for Int` put two `Int::name` definitions into the linked program, the
// lowering keeps the first, and every caller -- in either module, and in the
// entry -- silently runs whichever module the import order merged first.
// Measured before this check: a main importing both printed `from-a from-a`,
// and `from-b from-b` with the imports swapped; an entry declaring its own
// impl was overridden by an imported one even for its own calls.
//
// The checker refuses the same pair inside ONE file, but it checks each
// module against the impls its imports PUBLISH, and an impl of a trait the
// module does not re-export is not published -- so no per-module check sees
// both. This check reads the linked program itself, after every rename, so
// two definitions of one name here are exactly the ones the lowering would
// collapse. A module reached along two import paths is merged once and so
// counts once.
//
// A derive is counted as the impl it registers, and is held to the rules one
// module is held to. `derive (Show)` on `P` and `impl Show for P` are
// overlapping impls inside one file, so across two they are refused as well.
// A PLAIN definition of the method (`fn P::to_string`) is the override one
// file accepts: the derive generates nothing when the program defines the
// method anywhere (`dtd_source_op_defined`), so the linked program holds that
// one definition whatever the import order, and it is accepted across units
// too (#3551; the program compiled to `custom custom` in both import orders
// before #3544, and #3544 refused it).
//
// Which definitions an impl made is decided per statement, from the run of
// method bindings that follows the `SImpl` in the merged array -- not by the
// owner's prefix, which a plain `fn Int::m` elsewhere in the same unit shares
// with an `impl .. for Int` and would have been exempted by (#3551). A binding
// named after ANY trait (`Base::get` after `impl Child for Int`, `trait Child:
// Base`) sits inside the run rather than ending it, as the checker's
// `collect_impl_method_origins` reads the same shape. Inside the run, a
// binding is the impl's method only when the impl's trait, or a supertrait,
// declares that method: the impl is dispatched through those and nothing else.
// The AST does not record which bindings an impl BLOCK wrote (`fn P::m` and a
// block's `m` lower to the same `let P::m`), so a `fn P::to_string` right
// after `impl Tag for P` is a plain definition, as the derive pass reads it,
// and a `derive (Show)` on `P` elsewhere gives way to it (#3551).
//
// Every unit is read, the loader's generated ones included. A contract's
// facade holds no impls (a contract cannot state one) and its types module
// is the ONE site of the type family it defines (#1879), so their derives are
// the program's derives. Exempting them by path let an ordinary module at the
// types module's path skip the check (#3551).

import ./ast.vibe {
  Stmt, TypeExpr
}

import ./import_alias_rewrite_rewrite_alias_expr_ix.vibe {
  namespace_rename_original
}

import @vibe/ast {
  impl_method_owner, impl_target_head, trait_ref_name
}

import @vibe/core {
  struct MutMap
}

/// One source unit of a linked program: its path, the text it was parsed
/// from (for the location), and its statements' half-open range in the
/// merged array.
export struct LinkedUnit {
  path: String;
  source: String;
  start: Int;
  end: Int
}

export fn linked_unit(path: String, source: String, start: Int, end: Int) -> LinkedUnit {
  LinkedUnit::{ path: path, source: source, start: start, end: end }
}

/// `linked_unit` with the text looked up by path in the merge's sources.
export fn linked_unit_in(sources: Array[(String, String)], path: String, start: Int, end: Int) -> LinkedUnit {
  let mut found = ""
  for entry in sources {
    let (p, text) = entry
    if p == path && found == "" {
      found = text
    } else {
      ()
    }
  }
  linked_unit(path, found, start, end)
}

/// Who binds an impl method name: the unit, what declared it (`impl Name for
/// Int` / `derive (Show) on P`), and where.
struct ImplBinder {
  unit: Int;
  what: String;
  line: Int;
  col: Int
}

/// The refusal for the first impl method name two units of `merged` bind, or
/// `None`. `units` are in merge order and do not overlap.
export fn linked_impl_overlap_error(merged: Array[Stmt], units: Array[LinkedUnit]) -> Option[String] {
  let traits = linked_traits(merged)
  let in_impl = impl_member_flags(merged, units, traits)
  // Every name a plain definition (one no impl made) binds: a derive gives
  // way to it, as `dtd_source_op_defined` makes the derive pass do.
  let plain: MutMap[String, Bool] = MutMap::new_string()
  for unit in units {
    let mut k = unit.start
    while k < unit.end {
      let name = definition_name(Array::get(merged, k))
      if name != "" && !Array::get(in_impl, k) {
        MutMap::set(plain, name, true)
      } else {
        ()
      }
      k = k + 1
    }
  }
  let binders: MutMap[String, ImplBinder] = MutMap::new_string()
  let mut found: Option[String] = None
  let mut u = 0
  while u < Array::length(units) && found is None {
    let unit = Array::get(units, u)
    let impl_lines = line_starts_with_keyword(unit_located_text(unit), "impl")
    let mut impl_ordinal = 0
    let mut k = unit.start
    while k < unit.end && found is None {
      match Array::get(merged, k) {
        SImpl(tparams, _, trait_key, target) => {
          let (line, col) = nth_position(impl_lines, impl_ordinal)
          impl_ordinal = impl_ordinal + 1
          let what = String::concat("impl ", String::concat(trait_ref_name(trait_key), String::concat(" for ", target_display(target))))
          let prefix = String::concat(impl_method_owner(tparams, trait_key, target), "::")
          let run_end = impl_run_end(merged, k, unit.end, traits.names)
          let mut j = k + 1
          while j < run_end && found is None {
            let name = definition_name(Array::get(merged, j))
            if String::length(name) > String::length(prefix) && String::starts_with(name, prefix) {
              let binder = if Array::get(in_impl, j) {
                ImplBinder::{ unit: u, what: what, line: line, col: col }
              } else {
                // In the run but no method the trait dispatches: a plain
                // definition (`plain` above), still the one binding its name
                // may have.
                let (dl, dc) = definition_position(unit_located_text(unit), name)
                ImplBinder::{ unit: u, what: "a definition", line: dl, col: dc }
              }
              found = bind_or_refuse(binders, units, name, binder)
            } else {
              ()
            }
            j = j + 1
          }
          k = run_end
        },
        SStruct(_, name, _, derives, _, _) => {
          found = bind_derives(binders, plain, units, u, name, derives, "struct")
          k = k + 1
        },
        SEnum(_, name, _, _, derives) => {
          found = bind_derives(binders, plain, units, u, name, derives, "enum")
          k = k + 1
        },
        _ => {
          k = k + 1
        }
      }
    }
    u = u + 1
  }
  // A plain definition in another unit that reuses an impl method's name is
  // the same collapse (`fn Int::name` next to an imported `impl .. for Int`).
  let mut v = 0
  while v < Array::length(units) && found is None {
    let unit = Array::get(units, v)
    let mut k = unit.start
    while k < unit.end && found is None {
      let name = definition_name(Array::get(merged, k))
      match MutMap::get(binders, name) {
        Some(binder) => if binder.unit != v && !Array::get(in_impl, k) {
          let (line, col) = definition_position(unit_located_text(unit), name)
          found = Some(overlap_message(name, binder, Array::get(units, binder.unit), ImplBinder::{
            unit: v,
            what: "a definition",
            line: line,
            col: col
          }, unit))
        } else {
          ()
        },
        None => ()
      }
      k = k + 1
    }
    v = v + 1
  }
  found
}

/// The text a refusal's line numbers are counted in, or `""` (no line) when
/// the loader may have prepended lines the file on disk does not hold: a
/// sibling under a contract that shares imports opens with
/// `vpkg_shared_import_marker` and the inherited import lines, so a line
/// counted in the unit's text is not the author's line. Read from the text,
/// as `merged_offset_is_synthesized` does, only to WITHHOLD a line number --
/// a module that merely opens with such a comment loses its line, never its
/// check.
fn unit_located_text(unit: LinkedUnit) -> String {
  if String::starts_with(unit.source, "// vibe: contract facade (desugared from .vibei)\n") || String::starts_with(unit.source, "// vibe: vpkg directory-shared imports (#897)\n") || String::starts_with(unit.source, "// vibe: vpkg contract types module (#1840)\n") {
    ""
  } else {
    unit.source
  }
}

/// What the linked program says about its traits.
struct LinkedTraits {
  /// Every trait name a binding in an impl's run may be named after: each
  /// trait the program declares (as the merge renamed it, which its operation
  /// bindings share) and the checker's builtin ones.
  names: MutMap[String, Bool];
  /// The methods declared by each trait the program declares.
  methods: MutMap[String, Array[String]];
  /// The supertraits of each trait the program declares.
  supers: MutMap[String, Array[String]]
}

fn linked_traits(merged: Array[Stmt]) -> LinkedTraits {
  let names: MutMap[String, Bool] = MutMap::new_string()
  for builtin in [
    "Eq",
    "Ord",
    "Add",
    "Sub",
    "Mul",
    "Div",
    "Send",
    "Show",
    "Hash",
    "Default",
    "Signed"
  ] {
    MutMap::set(names, builtin, true)
  }
  let methods: MutMap[String, Array[String]] = MutMap::new_string()
  let supers: MutMap[String, Array[String]] = MutMap::new_string()
  for stmt in merged {
    match stmt {
      STrait(_, name, sups, sigs, _, _) => {
        MutMap::set(names, name, true)
        let own = string_list_at(methods, name)
        for sig in sigs {
          let (m, _, _) = sig
          Array::push(own, m)
        }
        let up = string_list_at(supers, name)
        for sup in sups {
          Array::push(up, trait_ref_name(sup))
        }
      },
      _ => ()
    }
  }
  LinkedTraits::{ names: names, methods: methods, supers: supers }
}

/// The list `m` holds at `key`, made empty there first when it holds none.
fn string_list_at(m: MutMap[String, Array[String]], key: String) -> Array[String] {
  match MutMap::get(m, key) {
    Some(list) => list,
    None => {
      let fresh: Array[String] = []
      MutMap::set(m, key, fresh)
      fresh
    }
  }
}

/// The methods an impl of `trait_key` is dispatched through: those its trait
/// and every supertrait declare and, for a builtin trait the program declares
/// as a marker (`trait Show`) or not at all, the one its derive generates.
/// `None` when a trait in the chain is neither declared by the linked program
/// nor builtin: nothing then says which bindings are the impl's, so every one
/// in its run counts.
fn impl_dispatched_methods(traits: LinkedTraits, trait_key: String) -> Option[MutMap[String, Bool]] {
  let out: MutMap[String, Bool] = MutMap::new_string()
  let seen: MutMap[String, Bool] = MutMap::new_string()
  let pending = [trait_ref_name(trait_key)]
  let mut known = true
  let mut i = 0
  while i < Array::length(pending) && known {
    let name = Array::get(pending, i)
    if MutMap::has(seen, name) {
      ()
    } else {
      MutMap::set(seen, name, true)
      let declared = match MutMap::get(traits.methods, name) {
        Some(list) => list,
        None => {
          known = name != "" && MutMap::has(traits.names, name)
          []
        }
      }
      for m in declared {
        MutMap::set(out, m, true)
      }
      if Array::length(declared) == 0 {
        for m in derive_methods(name) {
          MutMap::set(out, m, true)
        }
      } else {
        ()
      }
      match MutMap::get(traits.supers, name) {
        Some(list) => for sup in list {
          Array::push(pending, sup)
        },
        None => ()
      }
    }
    i = i + 1
  }
  if known {
    Some(out)
  } else {
    None
  }
}

/// Is `name` a binding in a trait's namespace (`Base::get`)?
fn names_trait_binding(name: String, traits: MutMap[String, Bool]) -> Bool {
  let sep = String::index_of(name, "::")
  sep > 0 && MutMap::has(traits, String::substring(name, 0, sep))
}

/// The name a definition statement binds, or `""`.
fn definition_name(stmt: Stmt) -> String {
  match stmt {
    SLet(_, _, n, _, _) => n,
    SFnDecl(_, n, _, _, _) => n,
    _ => ""
  }
}

/// One past the run of bindings that follows the `SImpl` at `k`: they follow it in
/// the merged array, each named after the impl's owner (`Int::name`), with
/// bindings in a trait's namespace among them: its own trait's (`Name::name`,
/// a default method) or any other's. #3551: a supertrait operation
/// (`Base::get` after `impl Child for Int`) used to end the run, so the
/// `Int::get` after it escaped the check; `collect_impl_method_origins` skips
/// the same bindings.
fn impl_run_end(merged: Array[Stmt], k: Int, end: Int, traits: MutMap[String, Bool]) -> Int {
  match Array::get(merged, k) {
    SImpl(tparams, _, trait_key, target) => {
      let prefix = String::concat(impl_method_owner(tparams, trait_key, target), "::")
      let trait_prefix = String::concat(trait_ref_name(trait_key), "::")
      let mut j = k + 1
      let mut more = true
      while more && j < end {
        let name = definition_name(Array::get(merged, j))
        if String::length(name) > String::length(prefix) && String::starts_with(name, prefix) {
          j = j + 1
        } else if String::length(name) > 0 && String::starts_with(name, trait_prefix) {
          j = j + 1
        } else if names_trait_binding(name, traits) {
          j = j + 1
        } else {
          more = false
        }
      }
      j
    },
    _ => k + 1
  }
}

/// For each statement of `merged`, whether an impl made it (#3551): the
/// statement lies in the run of bindings after an `SImpl` and is a method the
/// impl's trait dispatches (`impl_dispatched_methods`) or a binding in a
/// trait's namespace. A plain `fn Int::m` elsewhere in a unit that also holds
/// an `impl .. for Int` is NOT one, whatever its prefix, and neither is a
/// `fn P::to_string` right after `impl Tag for P` when `Tag` declares no
/// `to_string`.
fn impl_member_flags(merged: Array[Stmt], units: Array[LinkedUnit], traits: LinkedTraits) -> Array[Bool] {
  let flags: Array[Bool] = []
  let mut i = 0
  while i < Array::length(merged) {
    Array::push(flags, false)
    i = i + 1
  }
  for unit in units {
    let mut k = unit.start
    while k < unit.end {
      match Array::get(merged, k) {
        SImpl(tparams, _, trait_key, target) => {
          let prefix = String::concat(impl_method_owner(tparams, trait_key, target), "::")
          let dispatched = impl_dispatched_methods(traits, trait_key)
          let run_end = impl_run_end(merged, k, unit.end, traits.names)
          let mut j = k + 1
          while j < run_end {
            let name = definition_name(Array::get(merged, j))
            let member = if String::length(name) > String::length(prefix) && String::starts_with(name, prefix) {
              match dispatched {
                Some(methods) => MutMap::has(methods, String::substring(name, String::length(prefix), String::length(name))),
                None => true
              }
            } else {
              true
            }
            Array::set(flags, j, member)
            j = j + 1
          }
          k = run_end
        },
        _ => {
          k = k + 1
        }
      }
    }
  }
  flags
}

export fn refuse_linked_impl_overlaps(merged: Array[Stmt], units: Array[LinkedUnit]) -> Unit with Exception {
  match linked_impl_overlap_error(merged, units) {
    Some(msg) => throw(msg),
    None => ()
  }
}

fn bind_or_refuse(binders: MutMap[String, ImplBinder], units: Array[LinkedUnit], name: String, binder: ImplBinder) -> Option[String] {
  match MutMap::get(binders, name) {
    Some(prev) => if prev.unit != binder.unit {
      Some(overlap_message(name, prev, Array::get(units, prev.unit), binder, Array::get(units, binder.unit)))
    } else {
      None
    },
    None => {
      MutMap::set(binders, name, binder)
      None
    }
  }
}

/// The methods a derive binds under its type -- the ones `derive_pass`
/// generates and skips when the program already defines them.
fn derive_methods(which: String) -> Array[String] {
  if which == "Show" {
    ["to_string"]
  } else if which == "Hash" {
    ["hash_key"]
  } else if which == "Eq" {
    ["equals"]
  } else if which == "Ord" {
    ["compare"]
  } else if which == "Default" {
    ["default"]
  } else {
    []
  }
}

/// Bind the methods `derives` generate for `name`, except one a plain
/// definition supplies (`plain`): the derive pass generates nothing then, so
/// the derive binds nothing (#3551).
fn bind_derives(binders: MutMap[String, ImplBinder], plain: MutMap[String, Bool], units: Array[LinkedUnit], u: Int, name: String, derives: Array[String], keyword: String) -> Option[String] {
  let mut found: Option[String] = None
  if Array::length(derives) > 0 {
    let unit = Array::get(units, u)
    let shown = namespace_rename_original(name)
    let (line, col) = type_decl_position(unit_located_text(unit), keyword, shown)
    for listed in derives {
      for method in derive_methods(listed) {
        let overridden = match MutMap::get(plain, String::concat(name, String::concat("::", method))) {
          Some(_) => true,
          None => false
        }
        if !overridden && found is None {
          let what = String::concat("derive (", String::concat(listed, String::concat(") on ", shown)))
          found = bind_or_refuse(binders, units, String::concat(name, String::concat("::", method)), ImplBinder::{
            unit: u,
            what: what,
            line: line,
            col: col
          })
        } else {
          ()
        }
      }
    }
  } else {
    ()
  }
  found
}

fn overlap_message(name: String, first: ImplBinder, first_unit: LinkedUnit, second: ImplBinder, second_unit: LinkedUnit) -> String {
  let here = position_text(second_unit.path, second.line, second.col)
  let there = position_text(first_unit.path, first.line, first.col)
  let shown = namespace_rename_original(name)
  // A derive generates nothing next to an explicit definition, so the impl
  // always wins; it is still the overlap one module may not hold either.
  let why = if String::starts_with(first.what, "derive (") || String::starts_with(second.what, "derive (") {
    "` -- the derive gives way to the impl, so the deriving module, and every caller of the method, would silently run the impl; one module may not hold both either"
  } else {
    "` -- a linked program keeps only one of them, chosen by import order, so every caller, in either module, would silently run that one"
  }
  String::concat(here, String::concat(": remove one of these: `", String::concat(second.what, String::concat("` here and `", String::concat(first.what, String::concat("` in ", String::concat(there, String::concat(" both define `", String::concat(shown, why)))))))))
}

fn position_text(path: String, line: Int, col: Int) -> String {
  if line > 0 {
    String::concat(path, String::concat(": line ", String::concat(Int::to_string(line), String::concat(":", Int::to_string(col)))))
  } else {
    path
  }
}

fn target_display(t: TypeExpr) -> String {
  match t {
    TyName(n) => namespace_rename_original(n),
    TyApp(h, args) => {
      let mut out = String::concat(namespace_rename_original(h), "[")
      let mut i = 0
      while i < Array::length(args) {
        if i > 0 {
          out = String::concat(out, ", ")
        } else {
          ()
        }
        out = String::concat(out, target_display(Array::get(args, i)))
        i = i + 1
      }
      String::concat(out, "]")
    },
    TyTuple(ts) => {
      let mut out = "("
      let mut i = 0
      while i < Array::length(ts) {
        if i > 0 {
          out = String::concat(out, ", ")
        } else {
          ()
        }
        out = String::concat(out, target_display(Array::get(ts, i)))
        i = i + 1
      }
      String::concat(out, ")")
    },
    TyUnit => "Unit",
    _ => impl_target_head(t)
  }
}

/// `(line, col)` of each source line whose first non-blank word is `word`,
/// in order. 1-based line, 1-based byte column.
fn line_starts_with_keyword(source: String, word: String) -> Array[(Int, Int)] {
  let out: Array[(Int, Int)] = []
  let n = String::length(source)
  let wn = String::length(word)
  let mut line = 1
  let mut i = 0
  while i < n {
    // `i` is at the start of a line.
    let mut j = i
    while j < n && (String::byte_at(source, j) == 32 || String::byte_at(source, j) == 9) {
      j = j + 1
    }
    if j + wn < n && String::substring(source, j, j + wn) == word {
      let next = String::byte_at(source, j + wn)
      if next == 32 || next == 91 || next == 9 {
        Array::push(out, (line, j - i + 1))
      } else {
        ()
      }
    } else {
      ()
    }
    while j < n && String::byte_at(source, j) != 10 {
      j = j + 1
    }
    i = j + 1
    line = line + 1
  }
  out
}

fn nth_position(positions: Array[(Int, Int)], k: Int) -> (Int, Int) {
  if k < Array::length(positions) {
    Array::get(positions, k)
  } else {
    (0, 0)
  }
}

/// The first line that declares `<keyword> <name>` (after any `export`).
fn type_decl_position(source: String, keyword: String, name: String) -> (Int, Int) {
  let needle = String::concat(keyword, String::concat(" ", name))
  first_line_containing(source, needle)
}

/// The first line that defines `name` as `fn name` or `let name` (after any
/// `export`) -- at the start of the line, so a comment that quotes the
/// definition is not taken for it.
fn definition_position(source: String, name: String) -> (Int, Int) {
  let (fl, fc) = first_line_declaring(source, String::concat("fn ", name))
  if fl > 0 {
    (fl, fc)
  } else {
    first_line_declaring(source, String::concat("let ", name))
  }
}

/// `(line, col)` of the first line whose text, after indentation and an
/// optional `export `, starts with `needle` followed by a delimiter; the
/// column is that of `needle`. `(0, 0)` when none does.
fn first_line_declaring(source: String, needle: String) -> (Int, Int) {
  let n = String::length(source)
  let nn = String::length(needle)
  let mut line = 1
  let mut i = 0
  let mut fl = 0
  let mut fc = 0
  while i < n && fl == 0 {
    let mut j = i
    while j < n && (String::byte_at(source, j) == 32 || String::byte_at(source, j) == 9) {
      j = j + 1
    }
    if j + 7 <= n && String::substring(source, j, j + 7) == "export " {
      j = j + 7
    } else {
      ()
    }
    let col = j - i + 1
    if j + nn <= n && String::substring(source, j, j + nn) == needle {
      let next = if j + nn < n {
        String::byte_at(source, j + nn)
      } else {
        10
      }
      // `(` `[` ` ` `:` `=` or the line's end.
      if next == 40 || next == 91 || next == 32 || next == 58 || next == 61 || next == 10 {
        fl = line
        fc = col
      } else {
        ()
      }
    } else {
      ()
    }
    while j < n && String::byte_at(source, j) != 10 {
      j = j + 1
    }
    i = j + 1
    line = line + 1
  }
  (fl, fc)
}

fn first_line_containing(source: String, needle: String) -> (Int, Int) {
  let at = String::index_of(source, needle)
  if at < 0 {
    (0, 0)
  } else {
    let mut line = 1
    let mut line_start = 0
    let mut i = 0
    while i < at {
      if String::byte_at(source, i) == 10 {
        line = line + 1
        line_start = i + 1
      } else {
        ()
      }
      i = i + 1
    }
    (line, at - line_start + 1)
  }
}
