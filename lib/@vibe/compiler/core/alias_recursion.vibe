// Shared syntactic recursion check: completion and trait-key preparation must
// both leave recursive declarations for the checker diagnostic.
import ./ast.vibe {
  Stmt, TypeExpr
}
import ./types_env_cache.vibe {
  type_expr_name_is_shadowed
}
import @vibe/core {
  array_empty, struct MutSet
}

fn alias_recursion_names_contain(items: Array[String], wanted: String) -> Bool {
  let mut found = false
  for item in items {
    if item == wanted {
      found = true
    } else {
      ()
    }
  }
  found
}

fn alias_recursion_push_ref(out: Array[String], name: String, seen: MutSet[String]) -> Unit {
  if !MutSet::has(seen, x = name) {
    MutSet::add(seen, x = name)
    Array::push(out, value = name)
  } else {
    ()
  }
}

fn alias_recursion_collect_refs(te: TypeExpr, out: Array[String], seen: MutSet[String]) -> Unit {
  match te {
    TyName(name) => alias_recursion_push_ref(out = out, name = name, seen = seen),
    TyApp(name, args) => {
      alias_recursion_push_ref(out = out, name = name, seen = seen)
      let mut i = 0
      while i < Array::length(args) {
        alias_recursion_collect_refs(te = Array::get(args, at = i), out = out, seen = seen)
        i = i + 1
      }
    },
    TyFn(params, ret, _) => {
      let mut i = 0
      while i < Array::length(params) {
        alias_recursion_collect_refs(te = Array::get(params, at = i), out = out, seen = seen)
        i = i + 1
      }
      alias_recursion_collect_refs(te = ret, out = out, seen = seen)
    },
    TyTuple(items) => {
      let mut i = 0
      while i < Array::length(items) {
        alias_recursion_collect_refs(te = Array::get(items, at = i), out = out, seen = seen)
        i = i + 1
      }
    },
    TyUnit => ()
  }
}

fn alias_decl_body(stmts: Array[Stmt], name: String) -> Option[(Array[String], TypeExpr)] {
  let mut i = 0
  let mut result = None
  while i < Array::length(stmts) && result is None {
    match Array::get(stmts, at = i) {
      STypeAlias(_, alias_name, params, body) => if alias_name == name {
        result = Some((params, body))
      } else {
        ()
      },
      _ => ()
    }
    i = i + 1
  }
  result
}

fn alias_type_expr_reaches(stmts: Array[Stmt], te: TypeExpr, shadow: Array[String], target: String, seen: Array[String]) -> Bool {
  let refs = array_empty()
  alias_recursion_collect_refs(te = te, out = refs, seen = MutSet::new_string())
  let mut i = 0
  let mut reaches = false
  while i < Array::length(refs) && !reaches {
    let name = Array::get(refs, at = i)
    if type_expr_name_is_shadowed(shadow = shadow, name = name) {
      ()
    } else if name == target {
      reaches = true
    } else if alias_recursion_names_contain(items = seen, wanted = name) {
      ()
    } else {
      match alias_decl_body(stmts = stmts, name = name) {
        Some((params, body)) => {
          Array::push(seen, value = name)
          if alias_type_expr_reaches(stmts = stmts, te = body, shadow = params, target = target, seen = seen) {
            reaches = true
          } else {
            ()
          }
        },
        None => ()
      }
    }
    i = i + 1
  }
  reaches
}

export fn type_alias_decl_is_recursive(stmts: Array[Stmt], name: String, params: Array[String], body: TypeExpr) -> Bool {
  alias_type_expr_reaches(stmts = stmts, te = body, shadow = params, target = name, seen = array_empty())
}
