import ./ast.vibe {
  Expr, Stmt
}

import ./call_placement.vibe {
  call_placement_install, call_placement_is_canonical, call_placement_refuse
}

import ./expr_children.vibe {
  expr_child_at, expr_children_pop, expr_children_push, expr_children_top
}

import ./typed_lowering_rows.vibe {
  lowering_row_payload, lowering_row_tag
}

import @vibe/core {
  struct MutMap
}

fn placement_packet_valid(written: Int, mode: Int, slots: Array[Int]) -> Bool {
  let used: MutMap[Int, Bool] = MutMap::new_int()
  let mut valid = written >= 0 && (mode >= 0 && mode <= 2)
  let mut count = 0
  let mut i = 0
  while i < Array::length(slots) && valid {
    let slot = Array::get(slots, i)
    if slot == 0 {
      ()
    } else if slot < 2 {
      valid = false
    } else {
      let source = slot / 2 - 1
      if source >= written || MutMap::has(used, source) {
        valid = false
      } else {
        MutMap::set(used, source, true)
        count = count + 1
      }
    }
    if mode != 0 && slot != (i + 1) * 2 {
      valid = false
    } else {
      ()
    }
    i = i + 1
  }
  valid && count == written && (mode == 0 || Array::length(slots) == written)
}

fn placement_restore_expr(expr: Expr, packets: MutMap[Int, Array[Int]], bad: Bool) -> Unit {
  match expr {
    ECall(_, args, offset, cell) => {
      let mut labeled = false
      for arg in args {
        match arg {
          ELabeledArg(_, _, _) => labeled = true,
          _ => ()
        }
      }
      if call_placement_is_canonical(cell) {
        ()
      } else {
        match MutMap::get(packets, offset) {
          Some(payload) => if bad || Array::length(payload) < 2 {
            call_placement_refuse(cell, true)
          } else {
            call_placement_install(cell, Array::get(payload, 0), Array::get(payload, 1), Array::slice(payload, 2, Array::length(payload)))
          },
          None => if labeled {
            call_placement_refuse(cell, bad)
          } else {
            ()
          }
        }
      }
    },
    _ => ()
  }
  let mark = expr_children_push(expr)
  let end = expr_children_top()
  let mut i = mark
  while i < end {
    placement_restore_expr(expr_child_at(i), packets, bad)
    i = i + 1
  }
  expr_children_pop(mark)
}

fn placement_restore_stmts(stmts: Array[Stmt], packets: MutMap[Int, Array[Int]], bad: Bool) -> Unit {
  for stmt in stmts {
    match stmt {
      SLet(_, _, _, _, body) => placement_restore_expr(body, packets, bad),
      SLetMut(_, _, body) => placement_restore_expr(body, packets, bad),
      SLetPat(_, body) => placement_restore_expr(body, packets, bad),
      SExpr(body) => placement_restore_expr(body, packets, bad),
      STest(_, body) => placement_restore_expr(body, packets, bad),
      SBench(_, body) => placement_restore_expr(body, packets, bad),
      SFnDecl(_, _, body, _, _) => placement_restore_expr(body, packets, bad),
      SModule(_, _, children) => placement_restore_stmts(children, packets, bad),
      _ => ()
    }
  }
  ()
}

/// Restore only source-bound per-file rows, before files are renamed/merged.
/// 13 declares a complete label channel; 14 explicitly records a declined
/// located observation. A missing row in a complete channel is not rowless.
export fn restore_call_placements(stmts: Array[Stmt], rows: Array[Int]) -> Unit {
  let packets: MutMap[Int, Array[Int]] = MutMap::new_int()
  let mut available = false
  let mut declined = false
  let mut bad = false
  let mut packet_count = 0
  let mut i = 0
  while i < Array::length(rows) && !bad {
    let row = Array::get(rows, i)
    let tag = lowering_row_tag(row)
    if row == 13 {
      available = true
      i = i + 1
    } else if row == 14 {
      declined = true
      i = i + 1
    } else if tag >= 0 && tag <= 7 && row >= 0 {
      i = i + 1
    } else if tag == 8 && i + 2 < Array::length(rows) {
      let offset = lowering_row_payload(row)
      let count_row = Array::get(rows, i + 1)
      let mode_row = Array::get(rows, i + 2)
      bad = offset < 0 || lowering_row_tag(count_row) != 9 || lowering_row_tag(mode_row) != 10
      let written = lowering_row_payload(count_row)
      let mode = lowering_row_payload(mode_row)
      let slots: Array[Int] = []
      i = i + 3
      while i < Array::length(rows) && lowering_row_tag(Array::get(rows, i)) == 11 {
        Array::push(slots, lowering_row_payload(Array::get(rows, i)))
        i = i + 1
      }
      if i >= Array::length(rows) {
        bad = true
      } else if lowering_row_tag(Array::get(rows, i)) != 12 || lowering_row_payload(Array::get(rows, i)) != offset {
        bad = true
      } else if !placement_packet_valid(written, mode, slots) {
        bad = true
      } else {
        let payload = [written, mode]
        for slot in slots {
          Array::push(payload, slot)
        }
        match MutMap::get(packets, offset) {
          Some(old) => if old != payload {
            bad = true
          } else {
            ()
          },
          None => MutMap::set(packets, offset, payload)
        }
        packet_count = packet_count + 1
      }
      i = i + 1
    } else {
      bad = true
    }
  }
  bad = bad || (available && declined) || (!available && !declined) || (declined && packet_count > 0)
  if declined && !bad {
    ()
  } else {
    placement_restore_stmts(stmts, packets, bad)
  }
}
