import ./unstable_surface.vibe {
  text_mentions_unstable_package
}

// The pre-filter may over-match (the token scan decides), but it must never
// miss a line that could carry the import. A mention on a `//` line cannot.

test "an import line is a candidate" {
  inspect(text_mentions_unstable_package("import @vibe/concurrent/experimental {\n  TaskGroup\n}\n"), "true")
  inspect(text_mentions_unstable_package("fn f() -> Int {\n  1\n}\n  import  @vibe/concurrent/experimental/x { T }\n"), "true")
}

test "a mention on a code line after a comment line is still a candidate" {
  inspect(text_mentions_unstable_package("// @vibe/concurrent/experimental is proposed\nimport @vibe/concurrent/experimental { T }\n"), "true")
  inspect(text_mentions_unstable_package("let s = \"@vibe/concurrent/experimental\" // not an import, still over-matched\n"), "true")
}

test "mentions only on comment lines are not candidates" {
  inspect(text_mentions_unstable_package("// see @vibe/concurrent/experimental\n   // and @vibe/concurrent/experimental again\nfn f() -> Int {\n  1\n}\n"), "false")
  inspect(text_mentions_unstable_package("\t/// doc: @vibe/concurrent/experimental"), "false")
}

test "text without the name is not a candidate" {
  inspect(text_mentions_unstable_package(""), "false")
  inspect(text_mentions_unstable_package("import @vibe/core { array_empty }\n"), "false")
  inspect(text_mentions_unstable_package("@vibe/concurren"), "false")
  // The stable parent package is not the opt-in surface.
  inspect(text_mentions_unstable_package("import @vibe/concurrent { TaskGroup::run }\n"), "false")
}
