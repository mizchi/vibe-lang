// lib/@vibe/compiler/core/import_alias_rewrite.vibe — which re-exports a
// facade's own code names, for the #3448 collision check.

import ./ast.vibe {
  Expr, Pat, Stmt, TypeExpr
}

import ./expr_children.vibe {
  expr_children
}

import @vibe/ast {
  trait_ref_args, trait_ref_name, type_param_name
}

/// Whether `stmts`' declarations name `name`: a call or value `name`, a
/// qualified `name::..`, a `name::{ .. }` literal or pattern, a constructor
/// pattern, or a type (Codex on #3467): a parameter, result, annotation,
/// field, payload or alias target, and a row label. `fn read(b: Box) { b.x }`
/// names `Box` through its parameter alone. Inside a declaration or lambda
/// that binds a type parameter spelled `name` (`fn id[Box](x: Box)`), a type
/// or qualified spelling is that parameter, not the re-export (Codex on
/// #3492). A file that declares a type, effect or trait of the name itself
/// means its own where it spells one in that namespace: a type position, a
/// bound or supertrait, a row head (Codex on #3492). An expression's or
/// pattern's spelling may mean any of them.
export fn stmts_code_names(stmts: Array[Stmt], name: String) -> Bool {
  let w = CodeNamesWalk::{ stack: [], types: [], rows: [] }
  // The file's own declarations of the name, by namespace (Codex on #3492:
  // a facade may declare a struct `Builds` and re-export a trait `Builds`).
  // An expression's spelling may mean any of them.
  let local_type = stmts_declare_type_head(stmts = stmts, name = name, space = 0)
  let local_trait = stmts_declare_type_head(stmts = stmts, name = name, space = 1)
  let local_effect = stmts_declare_type_head(stmts = stmts, name = name, space = 2)
  let local = local_type || local_trait || local_effect
  let mut pattern_hit = false
  for st in stmts {
    match st {
      SLet(_, _, _, ann, e) => {
        push_type_opt(w = w, t = ann, hidden = local_type)
        Array::push(w.stack, value = (e, false))
      },
      SLetMut(_, ann, e) => {
        push_type_opt(w = w, t = ann, hidden = local_type)
        Array::push(w.stack, value = (e, false))
      },
      SFnDecl(_, _, e, requires, ensures) => {
        Array::push(w.stack, value = (e, false))
        // A contract runs too (Codex on #3492).
        for c in requires {
          Array::push(w.stack, value = (c, false))
        }
        for c in ensures {
          Array::push(w.stack, value = (c, false))
        }
        ()
      },
      SExpr(e) => Array::push(w.stack, value = (e, false)),
      // A test or bench body names what it uses too (Codex on #3492).
      STest(_, e) => Array::push(w.stack, value = (e, false)),
      SBench(_, e) => Array::push(w.stack, value = (e, false)),
      // A top-level destructuring `let` names its pattern's heads and its
      // initializer's (Codex on #3492): `let Box::{ value: x } = make()`.
      SLetPat(pat, e) => {
        if pat_names(p = pat, name = name, qual = String::concat(name, "::"), hidden = local) {
          pattern_hit = true
        }
        Array::push(w.stack, value = (e, false))
      },
      SStruct(_, _, fields, _, _, tparams) => {
        let hidden = local_type || binds_type_param(tparams = tparams, name = name)
        push_types(w = w, ts = for f in fields {
          f.1
        }, hidden = hidden)
      },
      SEnum(_, _, tparams, variants, _) => {
        let hidden = local_type || binds_type_param(tparams = tparams, name = name)
        for v in variants {
          push_types(w = w, ts = v.1, hidden = hidden)
        }
        ()
      },
      SSuberror(_, _, variants) => {
        for v in variants {
          push_types(w = w, ts = v.1, hidden = local_type)
        }
        ()
      },
      STypeAlias(_, _, tparams, target) => Array::push(w.types, value = (target, local_type || binds_type_param(tparams = tparams, name = name))),
      SImpl(tparams, bounds, tr, target) => {
        let hidden = local_type || binds_type_param(tparams = tparams, name = name)
        push_trait_ref(w = w, key = tr, local = local_trait, hidden = hidden)
        Array::push(w.types, value = (target, hidden))
        push_bounds(w = w, bounds = bounds, local = local_trait, hidden = hidden)
      },
      STrait(_, _, supers, sigs, method_gens, tparams) => {
        let hidden = local_type || binds_type_param(tparams = tparams, name = name)
        // A supertrait is a trait reference, so a trait parameter of the
        // same spelling (`trait Uses[Key]: Key`) does not hide its head.
        for sup in supers {
          push_trait_ref(w = w, key = sup, local = local_trait, hidden = hidden)
        }
        for sg in sigs {
          // A method's own type parameters hide the name in its signature
          // (Codex on #3492): `project[Box](x: Box) -> Box`.
          let mut sig_hidden = hidden
          for mg in method_gens {
            if mg.0 == sg.0 && binds_type_param(tparams = mg.1, name = name) {
              sig_hidden = true
            }
          }
          // ... and its bounds name their traits (`project[T: Key]`).
          for mg in method_gens {
            if mg.0 == sg.0 {
              push_bounds(w = w, bounds = mg.2, local = local_trait, hidden = sig_hidden)
            }
          }
          push_types(w = w, ts = sg.1, hidden = sig_hidden)
          Array::push(w.types, value = (sg.2, sig_hidden))
        }
        ()
      },
      SEffectDef(_, _, tparams, ops) => {
        let hidden = local_type || binds_type_param(tparams = tparams, name = name)
        for op in ops {
          push_types(w = w, ts = op.1, hidden = hidden)
          Array::push(w.types, value = (op.2, hidden))
        }
        ()
      },
      SExternLet(_, t) => Array::push(w.types, value = (t, local_type)),
      // A `test .. allows Ask` row lives only in this marker (Codex on #3492).
      STestEffectRows(rows) => {
        for row in rows {
          Array::push(w.rows, value = (row.1, local_effect, local_type))
        }
        ()
      },
      // A qualified pattern (`Box::Full(x) =>`) keeps its qualifier only in
      // this marker (Codex on #3492).
      SQualifiedPatternRefs(rows) => {
        for row in rows {
          if !local && row.0 == name {
            pattern_hit = true
          }
        }
        ()
      },
      SEffectSet(_, _, members) => {
        for m in members {
          Array::push(w.rows, value = (m, local_effect, local_type))
        }
        ()
      },
      _ => ()
    }
  }
  let qual = String::concat(name, "::")
  let mut found = pattern_hit
  while !found && Array::length(w.stack) > 0 {
    let n = Array::length(w.stack)
    let (cur, outer_hidden) = Array::get(w.stack, at = n - 1)
    Array::truncate(w.stack, length = n - 1)
    let mut hidden = outer_hidden
    match cur {
      // A file's own type of the name owns its constructors too: `Box(b)`
      // beside a local `enum Box` is that enum's (Codex on #3492).
      EIdent(x, _) => found = (!local && x == name) || (!local && !hidden && String::starts_with(x, prefix = qual)),
      ERecord(x, _, targs) => {
        found = !local_type && !hidden && (x == name || String::starts_with(x, prefix = qual))
        push_types(w = w, ts = targs, hidden = local_type || hidden)
      },
      EFn(tparams, bounds, params, ret, row, _) => {
        hidden = hidden || binds_type_param(tparams = tparams, name = name)
        let type_hidden = local_type || hidden
        // A bound names its trait (`[T: Key]`), as an annotation names a type
        // (Codex on #3492).
        push_bounds(w = w, bounds = bounds, local = local_trait, hidden = type_hidden)
        for p in params {
          push_type_opt(w = w, t = p.1, hidden = type_hidden)
        }
        push_type_opt(w = w, t = ret, hidden = type_hidden)
        match row {
          Some(text) => Array::push(w.rows, value = (text, local_effect, type_hidden)),
          None => ()
        }
      },
      EMatch(_, arms) => {
        for arm in arms {
          if pat_names(p = arm.0, name = name, qual = qual, hidden = local) {
            found = true
          }
        }
        ()
      },
      EHandle(_, arms) => {
        for arm in arms {
          if pat_names(p = arm.0, name = name, qual = qual, hidden = local) {
            found = true
          }
        }
        ()
      },
      _ => ()
    }
    for child in expr_children(cur) {
      Array::push(w.stack, value = (child, hidden))
    }
  }
  while !found && Array::length(w.types) > 0 {
    let n = Array::length(w.types)
    let (cur, hidden) = Array::get(w.types, at = n - 1)
    Array::truncate(w.types, length = n - 1)
    match cur {
      TyName(x) => found = !hidden && (x == name || String::starts_with(x, prefix = qual)),
      TyApp(x, args) => {
        found = !hidden && (x == name || String::starts_with(x, prefix = qual))
        push_types(w = w, ts = args, hidden = hidden)
      },
      TyFn(ps, r, row) => {
        push_types(w = w, ts = ps, hidden = hidden)
        Array::push(w.types, value = (r, hidden))
        match row {
          Some(text) => Array::push(w.rows, value = (text, local_effect, hidden)),
          None => ()
        }
      },
      TyTuple(items) => push_types(w = w, ts = items, hidden = hidden),
      TyUnit => ()
    }
  }
  for row in w.rows {
    let (text, row_local, hidden) = row
    if !found && row_text_names(text = text, name = name, local = row_local, hidden = hidden) {
      found = true
    }
  }
  found
}

/// Whether `stmts` declare `name` in one namespace: 0 types (struct, enum,
/// suberror, alias), 1 traits, 2 effects and effectsets.
fn stmts_declare_type_head(stmts: Array[Stmt], name: String, space: Int) -> Bool {
  let mut hit = false
  for st in stmts {
    let declared = match st {
      SStruct(_, n, _, _, _, _) => space == 0 && n == name,
      SEnum(_, n, _, _, _) => space == 0 && n == name,
      SSuberror(_, n, _) => space == 0 && n == name,
      STypeAlias(_, n, _, _) => space == 0 && n == name,
      STrait(_, n, _, _, _, _) => space == 1 && n == name,
      SEffectDef(_, n, _, _) => space == 2 && n == name,
      SEffectSet(_, n, _) => space == 2 && n == name,
      _ => false
    }
    hit = hit || declared
  }
  hit
}

/// The walk's pending work, each item with whether a type parameter spelled
/// like the name hides it there.
struct CodeNamesWalk {
  stack: Array[(Expr, Bool)];
  types: Array[(TypeExpr, Bool)];
  rows: Array[(String, Bool, Bool)]
}

fn binds_type_param(tparams: Array[String], name: String) -> Bool {
  let mut hit = false
  for tp in tparams {
    if type_param_name(tp) == name {
      hit = true
    }
  }
  hit
}

/// Each bound's trait references, read like row text: the trait head and
/// any applied arguments.
/// A bound's trait head lives in the trait namespace, so only the file's
/// own declaration of the name (`local`) hides it; a type parameter of the
/// same spelling hides only the bound's arguments (Codex on #3492:
/// `fn use[Key, T: Key](x: T)` still names the trait `Key`).
fn push_bounds(w: CodeNamesWalk, bounds: Array[(String, Array[String])], local: Bool, hidden: Bool) -> Unit {
  for b in bounds {
    for r in b.1 {
      push_trait_ref(w = w, key = r, local = local, hidden = hidden)
    }
  }
  ()
}

/// A trait reference as `trait_ref_key` spells it: a bare name, or an
/// applied one (`Key[Int]`, encoded) whose head and type arguments are
/// decoded so the walk sees both (Codex on #3492: `impl Key[Int] for Local`).
fn push_trait_ref(w: CodeNamesWalk, key: String, local: Bool, hidden: Bool) -> Unit {
  let head = trait_ref_name(key)
  if head != "" {
    Array::push(w.types, value = (TyName(head), local))
  } else {
    Array::push(w.rows, value = (key, local, hidden))
  }
  push_types(w = w, ts = trait_ref_args(key), hidden = hidden)
}

fn push_types(w: CodeNamesWalk, ts: Array[TypeExpr], hidden: Bool) -> Unit {
  for t in ts {
    Array::push(w.types, value = (t, hidden))
  }
  ()
}

fn push_type_opt(w: CodeNamesWalk, t: Option[TypeExpr], hidden: Bool) -> Unit {
  match t {
    Some(x) => Array::push(w.types, value = (x, hidden)),
    None => ()
  }
}

fn pat_names(p: Pat, name: String, qual: String, hidden: Bool) -> Bool {
  match p {
    PCtor(x, ps) => (!hidden && (x == name || String::starts_with(x, prefix = qual))) || pats_name(ps = ps, name = name, qual = qual, hidden = hidden),
    PStruct(x, fields) => {
      let mut hit = !hidden && (x == name || String::starts_with(x, prefix = qual))
      for f in fields {
        if !hit && pat_names(p = f.1, name = name, qual = qual, hidden = hidden) {
          hit = true
        }
      }
      hit
    },
    PTuple(ps) => pats_name(ps = ps, name = name, qual = qual, hidden = hidden),
    POr(a, b) => pat_names(p = a, name = name, qual = qual, hidden = hidden) || pat_names(p = b, name = name, qual = qual, hidden = hidden),
    _ => false
  }
}

fn pats_name(ps: Array[Pat], name: String, qual: String, hidden: Bool) -> Bool {
  let mut hit = false
  for p in ps {
    if !hit && pat_names(p = p, name = name, qual = qual, hidden = hidden) {
      hit = true
    }
  }
  hit
}

/// Whether a row's text (`Ask + Box[Int]`, `{ Ask, Tell }`) has a word
/// spelled `name`. A word after `::` is an operation of the effect before
/// it (`Console::Get`), not a head (Codex on #3492). A CamelCase word at
/// the row's top level is an effect head, hidden only by the file's own declaration
/// (`local`): `fn read[Ask]() -> Int with Ask` still names the effect `Ask`
/// (Codex on #3492). A type argument inside brackets, or a lowercase row
/// variable, is hidden by a binder of its spelling too (`hidden`).
fn row_text_names(text: String, name: String, local: Bool, hidden: Bool) -> Bool {
  let mut hit = false
  let mut word = ""
  let mut qualified = false
  let mut depth = 0
  let n = String::length(text)
  let mut i = 0
  while !hit && i <= n {
    let c = if i < n {
      String::byte_at(text, at = i)
    } else {
      0
    }
    if (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_' {
      if word == "" {
        qualified = i >= 2 && String::byte_at(text, at = i - 1) == ':' && String::byte_at(text, at = i - 2) == ':'
      }
      word = String::concat(word, String::substring(text, start = i, end = i + 1))
    } else {
      let head = depth == 0 && String::length(word) > 0 && String::byte_at(word, at = 0) >= 'A' && String::byte_at(word, at = 0) <= 'Z'
      let shadowed = if head {
        local
      } else {
        hidden
      }
      hit = !qualified && !shadowed && word == name
      word = ""
      if c == '[' {
        depth = depth + 1
      } else if c == ']' {
        depth = depth - 1
      }
    }
    i = i + 1
  }
  hit
}
