// lib/@vibe/compiler/core/import_alias_rewrite.vibe — which re-exports a
// facade's own code names, for the #3448 collision check.

import ./ast.vibe {
  Expr, Pat, Stmt, TypeExpr
}

import ./expr_children.vibe {
  expr_children
}

import @vibe/ast {
  type_param_name
}

/// Whether `stmts`' declarations name `name`: a call or value `name`, a
/// qualified `name::..`, a `name::{ .. }` literal or pattern, a constructor
/// pattern, or a type (Codex on #3467): a parameter, result, annotation,
/// field, payload or alias target, and a row label. `fn read(b: Box) { b.x }`
/// names `Box` through its parameter alone. Inside a declaration or lambda
/// that binds a type parameter spelled `name` (`fn id[Box](x: Box)`), a type
/// or qualified spelling is that parameter, not the re-export (Codex on
/// #3492). A file that declares a type, effect or trait of the name itself
/// means its own wherever it spells one (Codex on #3492).
export fn stmts_code_names(stmts: Array[Stmt], name: String) -> Bool {
  let w = CodeNamesWalk::{ stack: [], types: [], rows: [] }
  let local = stmts_declare_type_head(stmts, name)
  for st in stmts {
    match st {
      SLet(_, _, _, ann, e) => {
        push_type_opt(w, ann, local)
        Array::push(w.stack, (e, local))
      },
      SLetMut(_, ann, e) => {
        push_type_opt(w, ann, local)
        Array::push(w.stack, (e, local))
      },
      SFnDecl(_, _, e, _, _) => Array::push(w.stack, (e, local)),
      SExpr(e) => Array::push(w.stack, (e, local)),
      SStruct(_, _, fields, _, _, tparams) => {
        let hidden = local || binds_type_param(tparams, name)
        push_types(w, for f in fields {
          f.1
        }, hidden)
      },
      SEnum(_, _, tparams, variants, _) => {
        let hidden = local || binds_type_param(tparams, name)
        for v in variants {
          push_types(w, v.1, hidden)
        }
        ()
      },
      SSuberror(_, _, variants) => {
        for v in variants {
          push_types(w, v.1, local)
        }
        ()
      },
      STypeAlias(_, _, tparams, target) => Array::push(w.types, (target, binds_type_param(tparams, name))),
      SImpl(tparams, bounds, tr, target) => {
        let hidden = local || binds_type_param(tparams, name)
        Array::push(w.types, (TyName(tr), local))
        Array::push(w.types, (target, hidden))
        push_bounds(w, bounds, hidden)
      },
      STrait(_, _, tparams, sigs, _, supers) => {
        let hidden = local || binds_type_param(tparams, name)
        for sup in supers {
          Array::push(w.rows, (sup, local))
        }
        for sg in sigs {
          push_types(w, sg.1, hidden)
          Array::push(w.types, (sg.2, hidden))
        }
        ()
      },
      SEffectDef(_, _, tparams, ops) => {
        let hidden = local || binds_type_param(tparams, name)
        for op in ops {
          push_types(w, op.1, hidden)
          Array::push(w.types, (op.2, hidden))
        }
        ()
      },
      SExternLet(_, t) => Array::push(w.types, (t, local)),
      SEffectSet(_, _, members) => {
        for m in members {
          Array::push(w.rows, (m, local))
        }
        ()
      },
      _ => ()
    }
  }
  let qual = String::concat(name, "::")
  let mut found = false
  while !found && Array::length(w.stack) > 0 {
    let n = Array::length(w.stack)
    let (cur, outer_hidden) = Array::get(w.stack, n - 1)
    Array::truncate(w.stack, n - 1)
    let mut hidden = outer_hidden
    match cur {
      EIdent(x, _) => found = x == name || (!hidden && String::starts_with(x, qual)),
      ERecord(x, _, targs) => {
        found = !hidden && (x == name || String::starts_with(x, qual))
        push_types(w, targs, hidden)
      },
      EFn(tparams, bounds, params, ret, row, _) => {
        hidden = hidden || binds_type_param(tparams, name)
        // A bound names its trait (`[T: Key]`), as an annotation names a type
        // (Codex on #3492).
        push_bounds(w, bounds, hidden)
        for p in params {
          push_type_opt(w, p.1, hidden)
        }
        push_type_opt(w, ret, hidden)
        match row {
          Some(text) => Array::push(w.rows, (text, hidden)),
          None => ()
        }
      },
      EMatch(_, arms) => {
        for arm in arms {
          if pat_names(arm.0, name, qual, hidden) {
            found = true
          }
        }
        ()
      },
      EHandle(_, arms) => {
        for arm in arms {
          if pat_names(arm.0, name, qual, hidden) {
            found = true
          }
        }
        ()
      },
      _ => ()
    }
    for child in expr_children(cur) {
      Array::push(w.stack, (child, hidden))
    }
  }
  while !found && Array::length(w.types) > 0 {
    let n = Array::length(w.types)
    let (cur, hidden) = Array::get(w.types, n - 1)
    Array::truncate(w.types, n - 1)
    match cur {
      TyName(x) => found = !hidden && (x == name || String::starts_with(x, qual)),
      TyApp(x, args) => {
        found = !hidden && (x == name || String::starts_with(x, qual))
        push_types(w, args, hidden)
      },
      TyFn(ps, r, row) => {
        push_types(w, ps, hidden)
        Array::push(w.types, (r, hidden))
        match row {
          Some(text) => Array::push(w.rows, (text, hidden)),
          None => ()
        }
      },
      TyTuple(items) => push_types(w, items, hidden),
      TyUnit => ()
    }
  }
  for row in w.rows {
    let (text, hidden) = row
    if !found && !hidden && row_text_names(text, name) {
      found = true
    }
  }
  found
}

fn stmts_declare_type_head(stmts: Array[Stmt], name: String) -> Bool {
  let mut hit = false
  for st in stmts {
    let declared = match st {
      SStruct(_, n, _, _, _, _) => n == name,
      SEnum(_, n, _, _, _) => n == name,
      SSuberror(_, n, _) => n == name,
      STypeAlias(_, n, _, _) => n == name,
      STrait(_, n, _, _, _, _) => n == name,
      SEffectDef(_, n, _, _) => n == name,
      SEffectSet(_, n, _) => n == name,
      _ => false
    }
    hit = hit || declared
  }
  hit
}

/// The walk's pending work, each item with whether a type parameter spelled
/// like the name hides it there.
struct CodeNamesWalk {
  stack: Array[(Expr, Bool)];
  types: Array[(TypeExpr, Bool)];
  rows: Array[(String, Bool)]
}

fn binds_type_param(tparams: Array[String], name: String) -> Bool {
  let mut hit = false
  for tp in tparams {
    if type_param_name(tp) == name {
      hit = true
    }
  }
  hit
}

/// Each bound's trait references, read like row text: the trait head and
/// any applied arguments.
fn push_bounds(w: CodeNamesWalk, bounds: Array[(String, Array[String])], hidden: Bool) -> Unit {
  for b in bounds {
    for r in b.1 {
      Array::push(w.rows, (r, hidden))
    }
  }
  ()
}

fn push_types(w: CodeNamesWalk, ts: Array[TypeExpr], hidden: Bool) -> Unit {
  for t in ts {
    Array::push(w.types, (t, hidden))
  }
  ()
}

fn push_type_opt(w: CodeNamesWalk, t: Option[TypeExpr], hidden: Bool) -> Unit {
  match t {
    Some(x) => Array::push(w.types, (x, hidden)),
    None => ()
  }
}

fn pat_names(p: Pat, name: String, qual: String, hidden: Bool) -> Bool {
  match p {
    PCtor(x, ps) => x == name || (!hidden && String::starts_with(x, qual)) || pats_name(ps, name, qual, hidden),
    PStruct(x, fields) => {
      let mut hit = !hidden && (x == name || String::starts_with(x, qual))
      for f in fields {
        if !hit && pat_names(f.1, name, qual, hidden) {
          hit = true
        }
      }
      hit
    },
    PTuple(ps) => pats_name(ps, name, qual, hidden),
    POr(a, b) => pat_names(a, name, qual, hidden) || pat_names(b, name, qual, hidden),
    _ => false
  }
}

fn pats_name(ps: Array[Pat], name: String, qual: String, hidden: Bool) -> Bool {
  let mut hit = false
  for p in ps {
    if !hit && pat_names(p, name, qual, hidden) {
      hit = true
    }
  }
  hit
}

/// Whether a row's text (`Ask + Box[Int]`, `{ Ask, Tell }`) has a word
/// spelled `name`. A word after `::` is an operation of the effect before
/// it (`Console::Get`), not a head (Codex on #3492).
fn row_text_names(text: String, name: String) -> Bool {
  let mut hit = false
  let mut word = ""
  let mut qualified = false
  let n = String::length(text)
  let mut i = 0
  while !hit && i <= n {
    let c = if i < n {
      String::byte_at(text, i)
    } else {
      0
    }
    if (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_' {
      if word == "" {
        qualified = i >= 2 && String::byte_at(text, i - 1) == ':' && String::byte_at(text, i - 2) == ':'
      }
      word = String::concat(word, String::substring(text, i, i + 1))
    } else {
      hit = !qualified && word == name
      word = ""
    }
    i = i + 1
  }
  hit
}
