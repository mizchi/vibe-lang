//# Standard effect policy — independent standard execution owners (#1496)
//
// The compiler recognizes a small set of standard host providers plus
// entry-boundary exception and runtime scheduling behavior. These owners do
// not classify source-language effects: ordinary user effects simply have no
// standard policy metadata.
//
// Each private owner below records one concern only. WIT declaration-versus-
// provider behavior, resource lowering, and handler semantics intentionally
// remain unchanged in this behavior-preserving slice.
//
// #3143 (ADR-0084 step 1): the same owners also publish their decisions as
// class metadata (`standard_effect_catalog`) over `OperationRef`s
// (`operation_ref.vibe`), and entry admission is decided by classifying the
// lowered operation rather than by provider-name membership.

import ./exception_effect.vibe {
  canonical_exception_effect_name, exception_effect_kind, is_exception_effect_name, is_exception_label
}

import ./operation_ref.vibe {
  EffectArgument, EffectClass, EffectRequirement, OperationRef, classify_operation
}

import @vibe/core {
  array_empty
}

//# Independent standard execution owners

/// `(label, default resource kind)` for standard host providers, in the
/// established provider order. Every current provider uses the process root.
let standard_host_provider_resource_defaults: Array[(String, String)] = [
  ("Fs", "Process::Root"),
  ("Env", "Process::Root"),
  ("Stdin", "Process::Root"),
  ("Stdout", "Process::Root"),
  ("Stderr", "Process::Root"),
  ("Console", "Process::Root"),
  ("Process", "Process::Root"),
  ("Profiler", "Process::Root"),
  ("Http", "Process::Root"),
  ("Socket", "Process::Root")
]

/// Effects supplied by test and bench execution, in established order.
let test_bench_default_effect_labels: Array[String] = [
  "Fs",
  "Env",
  "Stdin",
  "Stdout",
  "Stderr",
  "Console",
  "Process",
  "Profiler",
  "Error",
  "Exception",
  // #2967: a test / bench block runs under the scheduling runtime, so an
  // `Async` callee is in its ambient row like the host providers above.
  "Async"
]

/// Effects allowed in the entry execution cache, in established order.
let entry_cache_safe_effect_labels: Array[String] = [
  "Stdout",
  "Console",
  "Error",
  "Exception",
  "Async"
]

//# Lookups

/// Reduces operation and generic labels to their base effect name:
/// `Fs::read_file` -> `Fs`, `State[Int]` -> `State`.
fn standard_policy_effect_name(_ label: String) -> String {
  let ci = String::index_of(label, needle = "::")
  let head = if ci > 0 {
    String::substring(label, start = 0, end = ci)
  } else {
    label
  }
  let bi = String::index_of(head, needle = "[")
  if bi > 0 {
    String::substring(head, start = 0, end = bi)
  } else {
    head
  }
}

fn standard_host_provider_index(_ name: String) -> Int {
  let mut i = 0
  let mut found = 0 - 1
  while i < Array::length(standard_host_provider_resource_defaults) {
    let (provider_name, _) = Array::get(standard_host_provider_resource_defaults, at = i)
    if provider_name == name {
      found = i
      i = Array::length(standard_host_provider_resource_defaults)
    } else {
      i = i + 1
    }
  }
  found
}

/// True when a label has standard provider or entry-execution metadata.
/// `Exception[K]` is covered by the standard entry-boundary exception policy.
export fn has_standard_effect_policy(_ label: String) -> Bool {
  has_standard_host_provider(label)
  || is_entry_runtime_managed_effect(label)
  // Retains the old arbitrary-string normalization of erased aliases,
  // including malformed generic stems such as `Exception[`.
  || standard_policy_effect_name(label) == "Error"
  || standard_policy_effect_name(label) == "Exception"
}

/// True only for labels supplied by a standard host provider.
export fn has_standard_host_provider(_ label: String) -> Bool {
  standard_host_provider_index(standard_policy_effect_name(label)) >= 0
}

/// The standard host provider's default resource kind, or `""` when none.
export fn standard_provider_default_resource_kind(_ label: String) -> String {
  let idx = standard_host_provider_index(standard_policy_effect_name(label))
  if idx < 0 {
    ""
  } else {
    let (_, resource_kind) = Array::get(standard_host_provider_resource_defaults, at = idx)
    resource_kind
  }
}

/// `Error` / `Exception[K]`: the entry boundary turns an escaping exception
/// into diagnosed failure.
export fn is_entry_boundary_exception(_ label: String) -> Bool {
  is_exception_label(label)
}

/// `Async`: the runtime schedules and discharges this standard effect.
export fn is_runtime_scheduled_effect(_ label: String) -> Bool {
  standard_policy_effect_name(label) == "Async"
}

/// #1460 / #1963: `Stdin`, `Stdout` and `Stderr` are the single-stream
/// providers the `Console` provider is replacing. Only the base name is read,
/// so an operation label (`Stdout::write_stream`) answers like its provider.
/// The authorization direction (`Console` covers these, never the reverse)
/// belongs to the checker; this owner only says which providers are legacy.
export fn is_legacy_console_provider(_ label: String) -> Bool {
  let name = standard_policy_effect_name(label)
  name == "Stdin" || name == "Stdout" || name == "Stderr"
}

/// True when standard entry or runtime execution handles a label, so callers
/// do not add a checker-row requirement or WIT world import.
export fn is_entry_runtime_managed_effect(_ label: String) -> Bool {
  is_entry_boundary_exception(label) || is_runtime_scheduled_effect(label)
}

/// True when an effect can cross a program entry boundary. Host-provider
/// effects are supplied by the process host; runtime-managed effects are
/// discharged by the entry wrapper. Ordinary user effects have neither owner
/// and must be handled before `main` / `_start` returns.
///
/// #3143 (ADR-0084): decided by CLASS, not by provider membership. The label
/// is lowered to an `OperationRef` (`standard_operation_ref`) and classified
/// against `standard_effect_catalog`: a capability (one resource of its
/// kind), the core exception effect and the runtime effect are admitted; an
/// effect without metadata, and a label that does not lower, are not.
export fn is_entry_admitted_effect(_ label: String) -> Bool {
  match standard_operation_ref(label) {
    Some(operation) => match classify_operation(catalog = standard_effect_catalog(), operation = operation) {
      Some(requirement) => match requirement {
        AlgebraicRequirement(_) => false,
        _ => true
      },
      None => false
    },
    None => false
  }
}

//# OperationRef metadata (ADR-0084 step 1, #3143)

/// The effect classes the standard policy knows, keyed by effect definition.
/// Every standard host provider is a capability of its default resource kind
/// (`Process::Root` for all of them today), the exception effect is the core
/// ambient effect, and `Async` is the runtime effect. An ordinary user effect
/// has no entry: its class will come from its own declaration (ADR-0094).
export fn standard_effect_catalog() -> Array[(String, EffectClass)] {
  let out: Array[(String, EffectClass)] = []
  let mut i = 0
  while i < Array::length(standard_host_provider_resource_defaults) {
    let (name, resource_kind) = Array::get(standard_host_provider_resource_defaults, at = i)
    Array::push(out, value = (name, CapabilityClass(resource_kind)))
    i = i + 1
  }
  Array::push(out, value = (canonical_exception_effect_name("Error"), CoreExceptionClass))
  Array::push(out, value = ("Async", RuntimeClass))
  out
}

/// ADR-0094 (#3143): `standard_effect_catalog` with the program's own
/// effects. A declared effect replaces any standard row of its name, so each
/// effect still has exactly one class: a capability of its resource kind when
/// it declares a resource parameter, otherwise algebraic.
export fn effect_catalog_in(_ declared: Array[(String, String)]) -> Array[(String, EffectClass)] {
  let out: Array[(String, EffectClass)] = []
  for row in standard_effect_catalog() {
    match declared_effect_kind(declared = declared, name = row.0) {
      Some(_) => (),
      None => Array::push(out, value = row)
    }
  }
  let seen: Array[String] = []
  let mut i = Array::length(declared) - 1
  while i >= 0 {
    let (name, kind) = Array::get(declared, at = i)
    let mut dup = false
    for s in seen {
      if s == name {
        dup = true
      }
    }
    if !dup {
      Array::push(seen, value = name)
      if kind == "" {
        Array::push(out, value = (name, AlgebraicClass))
      } else {
        Array::push(out, value = (name, CapabilityClass(kind)))
      }
    }
    i = i - 1
  }
  out
}

/// A row label classified against the program's declarations: the label is
/// lowered with `operation_ref_in` and classified against
/// `effect_catalog_in`. `None` when it does not lower or cannot be
/// classified.
export fn classify_label_in(label: String, declared: Array[(String, String)]) -> Option[EffectRequirement] {
  match operation_ref_in(label = label, declared = declared) {
    Some(operation) => classify_operation(catalog = effect_catalog_in(declared), operation = operation),
    None => None
  }
}

/// Byte offset of the first `::` outside brackets, or -1: the operation
/// separator of `Exception[pkg::Err]::Throw` is the second `::`, not the one
/// inside the kind.
fn label_operation_separator(_ label: String) -> Int {
  let n = String::length(label)
  let mut depth = 0
  let mut found = 0 - 1
  let mut i = 0
  while found < 0 && i + 1 < n {
    let c = String::byte_at(label, at = i)
    if c == 91 {
      depth = depth + 1
    } else if c == 93 {
      depth = depth - 1
    } else if c == 58 && depth == 0 && String::byte_at(label, at = i + 1) == 58 {
      found = i
    }
    i = i + 1
  }
  found
}

/// The comma-separated arguments of `Name[a, b]`'s bracket text, split at
/// depth 0 and trimmed, or `None` when one is empty.
fn label_bracket_arguments(_ text: String) -> Option[Array[String]] {
  let out: Array[String] = []
  let n = String::length(text)
  let mut depth = 0
  let mut start = 0
  let mut ok = true
  let mut i = 0
  while i <= n {
    let c = if i < n {
      String::byte_at(text, at = i)
    } else {
      44
    }
    if c == 91 {
      depth = depth + 1
    } else if c == 93 {
      depth = depth - 1
    } else if c == 44 && depth == 0 {
      let item = String::trim(String::substring(text, start = start, end = i))
      if String::length(item) == 0 {
        ok = false
      } else {
        Array::push(out, value = item)
      }
      start = i + 1
    }
    i = i + 1
  }
  if ok && depth == 0 {
    Some(out)
  } else {
    None
  }
}

/// Lower a row label to an `OperationRef`, or `None` when it is malformed
/// (an unclosed or empty bracket).
///
/// - `Fs`, `Fs::read_file`: a standard provider's operations act on its one
///   implicit resource, so the omitted argument is the default singleton
///   (ADR-0084: `with Fs` means `Fs[Process::Root]`). A written argument
///   (`Fs[SrcTree]`) is that resource.
/// - `Exception`, `Error`, `Exception[K]`, and their `::Throw`: the exception
///   effect with exactly one kind argument, `""` for the erased spellings, as
///   `exception_effect_kind` reports it. The Lean model has no erased kind;
///   here it is the kind every other kind is compatible with.
/// - anything else: every bracket argument is a TYPE.
///
/// Program declarations are not consulted here; `operation_ref_in` reads
/// them.
export fn standard_operation_ref(_ label: String) -> Option[OperationRef] {
  operation_ref_in(label = label, declared = [])
}

/// The resource kind `declared` records for effect `name` -- `""` when the
/// effect takes no resource -- or `None` when the program declares no effect
/// of that name. The last entry for a name wins.
fn declared_effect_kind(declared: Array[(String, String)], name: String) -> Option[String] {
  let mut found: Option[String] = None
  for entry in declared {
    if entry.0 == name {
      found = Some(entry.1)
    }
  }
  found
}

/// ADR-0094 (#3143): `standard_operation_ref` against the program's own
/// effect declarations, `declared` being `(effect, resource kind)` with `""`
/// for an effect that takes no resource. A declared effect is read from its
/// declaration, never from the provider table, even when it reuses a
/// provider's name:
///
/// - with a resource parameter, its bracket argument is the
///   `ResourceArgument`, and an omitted one is the kind's singleton when the
///   kind has one (`Clock[_: Process::Root]` -> `Process::Root`);
/// - without one, every bracket argument is a `TypeArgument`.
export fn operation_ref_in(label: String, declared: Array[(String, String)]) -> Option[OperationRef] {
  let sep = label_operation_separator(label)
  let head = if sep >= 0 {
    String::substring(label, start = 0, end = sep)
  } else {
    label
  }
  let operation = if sep >= 0 {
    String::substring(label, start = sep + 2, end = String::length(label))
  } else {
    ""
  }
  if is_exception_effect_name(head) {
    Some(OperationRef::{
      effect_def: canonical_exception_effect_name("Error"),
      operation: operation,
      arguments: [TypeArgument(exception_effect_kind(head))]
    })
  } else {
    let open_at = String::index_of(head, needle = "[")
    let base = if open_at >= 0 {
      String::substring(head, start = 0, end = open_at)
    } else {
      head
    }
    let written = if open_at < 0 {
      Some([])
    } else if String::ends_with(head, suffix = "]") {
      label_bracket_arguments(String::substring(head, start = open_at + 1, end = String::length(head) - 1))
    } else {
      None
    }
    match written {
      Some(texts) => if String::length(base) == 0 {
        None
      } else {
        // The resource kind the effect acts on: its declaration's, else the
        // standard provider's, else none.
        let resource_kind = match declared_effect_kind(declared = declared, name = base) {
          Some(kind) => kind,
          None => standard_provider_default_resource_kind(base)
        }
        let acts_on_resource = resource_kind != ""
        let arguments: Array[EffectArgument] = []
        let mut i = 0
        while i < Array::length(texts) {
          let text = Array::get(texts, at = i)
          if acts_on_resource {
            Array::push(arguments, value = ResourceArgument(text))
          } else {
            Array::push(arguments, value = TypeArgument(text))
          }
          i = i + 1
        }
        if acts_on_resource && Array::length(arguments) == 0 {
          match singleton_resource_of_kind(resource_kind) {
            Some(resource) => Array::push(arguments, value = ResourceArgument(resource)),
            None => ()
          }
        }
        Some(OperationRef::{
          effect_def: base,
          operation: operation,
          arguments: arguments
        })
      },
      None => None
    }
  }
}

//# Resource kinds (ADR-0075 Phase 2 / ADR-0094)

/// The singleton selected by standard provider defaults when resource arguments
/// are omitted. Resource lowering remains unchanged in this slice.
export fn process_root_resource_kind() -> String {
  "Process::Root"
}

/// Singleton resource kind: the language has exactly one process root.
export fn is_singleton_resource_kind(_ path: String) -> Bool {
  path == process_root_resource_kind()
}

/// Resource present without a declaration: the ambient process root.
export fn predeclared_resources() -> Array[(String, String)] {
  let out = array_empty()
  Array::push(out, value = (process_root_resource_kind(), process_root_resource_kind()))
  out
}

/// The one predeclared resource of a singleton `kind` -- the resource an
/// omitted resource argument means -- or `None` for any other kind.
export fn singleton_resource_of_kind(_ kind: String) -> Option[String] {
  let resources = predeclared_resources()
  let mut found: Option[String] = None
  let mut i = 0
  while i < Array::length(resources) {
    let (name, resource_kind) = Array::get(resources, at = i)
    if resource_kind == kind && is_singleton_resource_kind(kind) {
      found = Some(name)
    }
    i = i + 1
  }
  found
}

/// The standard host provider labels, in the established provider order.
/// Derived from the table above so callers that must agree with it (the
/// parser's capability list, #2110) can be checked against it rather than
/// restating it.
export fn standard_host_provider_names() -> Array[String] {
  let out = array_empty()
  let mut i = 0
  while i < Array::length(standard_host_provider_resource_defaults) {
    let (name, _) = Array::get(standard_host_provider_resource_defaults, at = i)
    Array::push(out, value = name)
    i = i + 1
  }
  out
}

/// All labels with standard policy metadata, in the established order.
export fn standard_effect_policy_names() -> Array[String] {
  let out = standard_host_provider_names()
  // Exception and Async policy is predicate-based; these erased spellings
  // retain this exported API's established output.
  Array::push(out, value = "Error")
  Array::push(out, value = "Exception")
  Array::push(out, value = "Async")
  out
}

//# Derived entry policy

fn copied_labels(_ labels: Array[String]) -> Array[String] {
  let out = array_empty()
  let mut i = 0
  while i < Array::length(labels) {
    Array::push(out, value = Array::get(labels, at = i))
    i = i + 1
  }
  out
}

/// Effects test and bench execution supplies by default, in existing order.
export fn test_bench_default_effects() -> Array[String] {
  copied_labels(test_bench_default_effect_labels)
}

/// Effects allowed in the entry execution cache, in existing order.
export fn entry_cache_safe_effects() -> Array[String] {
  copied_labels(entry_cache_safe_effect_labels)
}

/// #1961: cache safety is operation-specific. A broad `Console` row is
/// unsafe because it includes input; exact captured-output operations
/// remain safe. `Stdout` is output-only so the whole provider is safe.
export fn is_entry_cache_safe_operation(_ label: String) -> Bool {
  let effect = standard_policy_effect_name(label)
  if is_entry_runtime_managed_effect(label) {
    true
  } else if effect == "Stdout" {
    true
  } else {
    label == "Console::write_stream" || label == "Console::write_char"
  }
}
