//# Exhaustive structural expression traversal
//
// This deliberately reports only immediate expression children. Checkers own
// scope transitions (lambda parameters, patterns, let bindings, handlers), so
// callers must apply their context before recursing. Keeping the structural
// match here makes adding an Expr variant require one update at the AST edge.

import @vibe/core {
  array_empty
}

import ./ast.vibe {
  Expr, Pat
}

/// #2424: the source offset that identifies an expression node to the
/// typed-lowering channel -- the key the checker files a render / `eq`
/// argument under and the key both codegen lanes look it up by. `-1` for a
/// shape that carries no offset, which classifies nothing.
///
/// Three shapes reach it: a name, a call result, and a dot projection. The
/// first two answer with their own offset. **A projection answers with its
/// FIELD-NAME offset**, not the node offset `parse_postfix` gave it -- that
/// one is the RECEIVER's start (`callee_offset(expr)`), which the receiver
/// itself already owns, so `t.0` and `t` would share a key and the channel
/// would have to choose between refusing the projection (it did, #2424's open
/// tuple-projection row) and rendering the tuple `t` through the integer
/// renderer. The field-name offset is unique to the projection, and the
/// checker has recorded the projection's type there since #645
/// (`tab_dot_field_name_ty`, for hover on the field name), so no new
/// occurrence is needed -- only the agreement that this is the key.
///
/// Single source of truth on purpose: the producer lives in the checker and
/// the consumers in two codegen lanes, and an offset the producer files under
/// one key and a consumer reads under another is not a diagnostic, it is
/// silence.
export fn typed_lowering_arg_offset(expr: Expr) -> Int {
  match expr {
    EIdent(_, off) => off,
    ECall(_, _, off) => off,
    EDot(_, _, _, field_off) => field_off,
    _ => 0 - 1
  }
}

/// #2987: the key under which a render argument the checker typed as
/// UNRENDERABLE (tag 6) rides the Int render channel. Negative, so it can
/// never equal the non-negative `typed_lowering_arg_offset` an Int lookup asks
/// for. Shared by the producer and every consumer for the same reason the key
/// above is.
export fn typed_render_refuse_key(off: Int) -> Int {
  0 - off - 1
}

/// #3066: the head that marks a typed-`==` channel row as a RENDER row.
///
/// A render argument the checker typed as an `Option` / `Array` / tuple rides
/// the typed-`==` rows as `(argument offset, impl_target_key(__render[T]))`.
/// Riding that channel is the point: its rows already reach normalize on every
/// lane that has a checker (the FS module carrier with its rebase and rename,
/// the linked lane, the gc lane), where a new channel would have to be threaded
/// through each of them by hand. The wrapper keeps the two row kinds apart --
/// a `==` lookup never reads a render row, and the other way round -- and it is
/// an ordinary applied type, so the merge's nominal rename reaches `T`. The
/// head is not an identifier (`#` cannot appear in one), so no user type can
/// spell it: a user's `struct __render[T]` once had its genuine `==` rows read
/// as render rows and compared by reference (Codex on #3081).
export fn typed_render_row_head() -> String {
  "#render"
}

/// #2987 / #3068: the message a codegen lane throws when it refuses a render
/// argument filed under `typed_render_refuse_key`. Shared so the linear and gc
/// lanes refuse one program with one sentence: a lane that printed an address
/// where the other refused was #3068. It carries the argument's offset as a
/// ` [@off=N]` marker (#3090), so both lanes name one position as well.
export fn unrenderable_render_message(e: Expr) -> String {
  let what = match e {
    EIdent(n, _) => String::concat("`", String::concat(n, "`")),
    EDot(_, f, _, _) => String::concat("field `", String::concat(f, "`")),
    // #3080: `xs[a:b]` is `__slice` internally; name what the user wrote.
    ECall(EIdent("__slice", _), _, _) => "this slice (`xs[a:b]`)",
    ECall(EIdent(cn, _), _, _) => String::concat("the result of `", String::concat(cn, "`")),
    _ => "this value"
  }
  let base = String::concat("cannot interpolate ", String::concat(what, ": its type is an Option, Array, tuple, Bytes or record whose shape the renderer could not resolve here, so it would print a memory address -- bind it with a type annotation first (e.g. `let v: Option[Int] = ...`, then interpolate `v`) (#2987)"))
  // #3090: anchor the refusal at the interpolated expression -- the key the
  // checker filed the row under, so it names the node the reader wrote. The
  // CLI resolves the marker to `path: line:col`, or strips it where it cannot
  // tell which file the offset indexes.
  let off = typed_lowering_arg_offset(e)
  if off >= 0 {
    String::concat(base, String::concat(" [@off=", String::concat(__to_string(off), "]")))
  } else {
    base
  }
}

/// #2424: the same key, restricted to the shapes the DOUBLE channel may use --
/// a call result or a dot projection. A bare name answers `-1`.
///
/// The restriction is not caution, it is the one collision this encoding has.
/// The Double channel's array carries two producers: tag 0, the primary CALL
/// RESULTS whose type is Double, and tag 4, the render/`eq` ARGUMENTS whose
/// type is Double. A call node's own offset IS its callee identifier's offset
/// (`parse_postfix` passes `callee_offset(expr)`), so for `f()` returning a
/// Double the array holds the offset that `EIdent("f")` also answers with.
/// Reading that array with `typed_lowering_arg_offset` would therefore classify
/// the function VALUE `f` as a Double wherever a classifier is asked about it,
/// and lower it through f64 -- silently.
///
/// The Int channel does not have this problem and does not use this key: its
/// producer emits an offset only when EVERY typed occurrence there resolves to
/// `Int`, so a call offset shared with its callee's `CtFn` occurrence is
/// dropped on disagreement. Tag 0's producer is the call-result capture
/// instead, which has no such agreement rule, so the restriction lives here.
export fn typed_lowering_float_key(expr: Expr) -> Int {
  match expr {
    EIdent(_, _) => 0 - 1,
    _ => typed_lowering_arg_offset(expr)
  }
}

/// #2479: the child list is READ-ONLY for every caller (measured: no call
/// site mutates it), so a leaf answers one shared empty array and a node
/// whose children ARE an array it already holds (`ETuple`, `EArray`,
/// `EContinue`) answers that array. The rest still build a fresh list.
/// Before this, every node of every walk allocated -- 104 ms of
/// `__rt_arr_new` under `expr_children` on a warm compiler-closure compile,
/// most of it for leaves.
let expr_children_none: Array[Expr] = []

export fn expr_children(expr: Expr) -> Array[Expr] {
  match expr {
    EInt(_) => expr_children_none,
    EFloat(_) => expr_children_none,
    EString(_, _) => expr_children_none,
    EBool(_) => expr_children_none,
    EIdent(_, _) => expr_children_none,
    EStringInterp(_) => expr_children_none,
    EUnit => expr_children_none,
    EBreak(None) => expr_children_none,
    ETuple(elems) => elems,
    EArray(elems) => elems,
    EContinue(args) => args,
    _ => expr_children_built(expr)
  }
}

fn expr_children_built(expr: Expr) -> Array[Expr] {
  let children = array_empty()
  expr_children_into(expr, children)
  children
}

/// #2386: the walkers' scratch stack. A walker that only VISITS children
/// used to take `expr_children` -- a fresh array per interior node, filled
/// by pushes -- and read it once: some 250 ms of `__rt_arr_new` /
/// `__rt_arr_push` in a cold compiler-closure compile across a dozen
/// walkers, on both lanes. Its children now go onto this one stack instead:
/// `expr_children_push` appends them and answers the MARK of the first;
/// they sit in `[mark, expr_children_top())`, read by `expr_child_at`, and
/// `expr_children_pop(mark)` truncates back when the walker is done with
/// them. Nested pushes (a walker recursing on a child, or calling another
/// walker) land ABOVE the window and are popped before the walker reads its
/// next slot, so the window stays valid; the discipline is LIFO, the same
/// as the perceus planner's snapshot stack.
let expr_child_scratch: Array[Expr] = []

/// Push `expr`'s children onto the scratch stack; the mark of the first.
export fn expr_children_push(expr: Expr) -> Int {
  let mark = Array::length(expr_child_scratch)
  expr_children_into(expr, expr_child_scratch)
  mark
}

/// One past the last slot the latest push filled.
export fn expr_children_top() -> Int {
  Array::length(expr_child_scratch)
}

export fn expr_child_at(i: Int) -> Expr {
  Array::get(expr_child_scratch, i)
}

/// Release every slot from `mark` up.
export fn expr_children_pop(mark: Int) -> Unit {
  Array::truncate(expr_child_scratch, mark)
}

/// Append `expr`'s immediate children to `out`, in the order
/// `expr_children` lists them.
export fn expr_children_into(expr: Expr, out: Array[Expr]) -> Unit {
  let children = out
  match expr {
    ETuple(elems) => append_exprs(children, elems),
    EArray(elems) => append_exprs(children, elems),
    ERecord(_, fields, _) => append_field_exprs(children, fields),
    EIf(cond, then_e, else_e) => {
      Array::push(children, cond)
      Array::push(children, then_e)
      Array::push(children, else_e)
    },
    ELet(_, val, body, _) => append_pair(children, val, body),
    ELetRec(_, val, body) => append_pair(children, val, body),
    ELetMut(_, val, body, _) => append_pair(children, val, body),
    EAssign(_, val, cont) => append_pair(children, val, cont),
    EAssignOp(_, _, val, cont) => append_pair(children, val, cont),
    ESeq(a, b) => append_pair(children, a, b),
    EMatch(scrutinee, arms) => {
      Array::push(children, scrutinee)
      append_arm_exprs(children, arms)
    },
    EHandle(body, arms) => {
      Array::push(children, body)
      append_arm_exprs(children, arms)
    },
    EWhile(cond, body) => append_pair(children, cond, body),
    ELoop(params, body) => {
      let mut i = 0
      while i < Array::length(params) {
        let (_, init) = Array::get(params, i)
        Array::push(children, init)
        i = i + 1
      }
      Array::push(children, body)
    },
    EForIn(_, _, iter, body) => append_pair(children, iter, body),
    ECall(callee, args, _) => {
      Array::push(children, callee)
      append_exprs(children, args)
    },
    EBinOp(_, left, right, _) => append_pair(children, left, right),
    EUnaryOp(_, operand) => Array::push(children, operand),
    EFn(_, _, _, _, _, body) => Array::push(children, body),
    EDot(obj, _, _, _) => Array::push(children, obj),
    ELabeledArg(_, _, value) => Array::push(children, value),
    EReturn(value) => Array::push(children, value),
    EBreak(Some(value)) => Array::push(children, value),
    EBreak(None) => (),
    EContinue(args) => append_exprs(children, args),
    EMap(fields) => append_field_exprs(children, fields),
    ESpread(value) => Array::push(children, value),
    EInt(_) => (),
    EFloat(_) => (),
    EString(_, _) => (),
    EBool(_) => (),
    EIdent(_, _) => (),
    EStringInterp(_) => (),
    EUnit => ()
  }
}

fn append_pair(dst: Array[Expr], first: Expr, second: Expr) -> Unit {
  Array::push(dst, first)
  Array::push(dst, second)
}

fn append_exprs(dst: Array[Expr], exprs: Array[Expr]) -> Unit {
  let mut i = 0
  while i < Array::length(exprs) {
    Array::push(dst, Array::get(exprs, i))
    i = i + 1
  }
}

fn append_field_exprs(dst: Array[Expr], fields: Array[(String, Expr)]) -> Unit {
  let mut i = 0
  while i < Array::length(fields) {
    let (_, value) = Array::get(fields, i)
    Array::push(dst, value)
    i = i + 1
  }
}

fn append_arm_exprs(dst: Array[Expr], arms: Array[(Pat, Expr)]) -> Unit {
  let mut i = 0
  while i < Array::length(arms) {
    let (_, body) = Array::get(arms, i)
    Array::push(dst, body)
    i = i + 1
  }
}
