// lib/@vibe/compiler/core/import_alias_rewrite.vibe — rewrite alias expr ix.

import ./ast.vibe {
  Expr, ImportItem, ImportKind, Pat, Stmt, TypeExpr
}

import @vibe/core {
  array_empty, struct MutMap, struct MutSet
}

import @vibe/ast {
  impl_method_owner, index_site_key, is_builtin_ref_offset, trait_ref_from_key, trait_ref_key, type_param_name
}

import ./resolved_callee.vibe {
  builtin_callee_resolution
}

import ./call_placement.vibe {
  call_placement_cell_prefix
}

import ./pattern_ctor_name.vibe {
  pattern_ctor_base_name
}

import ./module_graph_path.vibe {
  dir_of_path
}

import ./exception_effect.vibe {
  is_exception_operation_name
}

import ./inline_wasm_marker.vibe {
  inline_wasm_marker_name, wat_callee_names, wat_rewrite_callees
}

import ./import_alias_rewrite_pat_binds_shadowing_name.vibe {
  AliasIdx,
  alias_map_without_name,
  alias_map_without_names,
  alias_map_without_params,
  alias_map_without_pat,
  aliasidx_build,
  aliasidx_rebuild,
  aliasidx_with_pattern_ctors,
  empty_aliases,
  empty_import_refs,
  empty_strings,
  import_alias_rewrite_string_array_contains,
  import_ref_array_contains_local,
  import_ref_has_other_path_for_original,
  is_builtin_iterator_serialized_boundary_path,
  lookup_alias
}

/// #2386: the alias rewrites share every subtree they leave unchanged. This
/// counts the renames the leaf lookups have made: an arm rewrites its
/// children, and constructs a new node only when the count moved while it
/// did -- otherwise it hands back the node it was given, exactly as the
/// empty-map case always did (AST nodes are immutable; the located-parse
/// memo already hands every consumer the same deep nodes). Every rename this
/// file makes goes through `aliasidx_get`, which is what makes the count
/// exact: a rename anywhere below an arm moves it, and a lookup that hits
/// without changing a node only costs that arm a rebuild. Keep it that way --
/// a rename that bypasses `aliasidx_get` would be dropped by its parents.
let alias_rewrite_marks: Array[Int] = [0]

/// #3889: the transparent aliases the module being rewritten declares, so a
/// qualified head that is not an import alias asks the record rows only when
/// it is one of them. Empty for a module that declares none, which then pays
/// one length read per qualified name.
let local_record_alias_heads: Array[String] = []

fn alias_marks() -> Int {
  Array::get(alias_rewrite_marks, at = 0)
}

/// The alias map's answer for `name`, counted when it renames.
export fn aliasidx_get(am: AliasIdx, name: String) -> Option[String] {
  let result = MutMap::get(am.idx, k = name)
  match result {
    Some(_) => {
      Array::set(alias_rewrite_marks, at = 0, value = Array::get(alias_rewrite_marks, at = 0) + 1)
    },
    None => ()
  }
  result
}

/// `items` rewritten under `am`: the same array when no item changed, else
/// a copy that shares every unchanged item.
export fn rewrite_alias_exprs_ix(items: Array[Expr], am: AliasIdx) -> Array[Expr] {
  let mut out = items
  let mut copied = false
  let mut i = 0
  while i < Array::length(items) {
    let m = alias_marks()
    let r = rewrite_alias_expr_ix(expr = Array::get(items, at = i), am = am)
    if copied {
      Array::push(out, value = r)
    } else if alias_marks() != m {
      out = Array::slice(items, start = 0, end = i)
      Array::push(out, value = r)
      copied = true
    } else {
      ()
    }
    i = i + 1
  }
  out
}

/// Named fields (`ERecord`, `EMap`), same sharing as `rewrite_alias_exprs_ix`.
fn rewrite_alias_named_exprs_ix(fields: Array[(String, Expr)], am: AliasIdx) -> Array[(String, Expr)] {
  let mut out = fields
  let mut copied = false
  let mut i = 0
  while i < Array::length(fields) {
    let (name, value) = Array::get(fields, at = i)
    let m = alias_marks()
    let r = rewrite_alias_expr_ix(expr = value, am = am)
    if copied {
      Array::push(out, value = (name, r))
    } else if alias_marks() != m {
      out = Array::slice(fields, start = 0, end = i)
      Array::push(out, value = (name, r))
      copied = true
    } else {
      ()
    }
    i = i + 1
  }
  out
}

/// `match` / `handle` arms, each body under the map minus its pattern's
/// binders, same sharing as `rewrite_alias_exprs_ix`.
fn rewrite_alias_pattern_ctor(pat: Pat, am: AliasIdx) -> Pat {
  match pat {
    PCtor(name, args) => {
      // #3422: a qualified `Maybe::Some` is renamed by its bare name.
      let renamed = match lookup_alias(aliases = am.pattern_ctors, name = pattern_ctor_base_name(name)) {
        Some(next) => {
          Array::set(alias_rewrite_marks, at = 0, value = alias_marks() + 1)
          next
        },
        None => name
      }
      PCtor(renamed, for arg in args {
        rewrite_alias_pattern_ctor(pat = arg, am = am)
      })
    },
    PTuple(args) => PTuple(for arg in args {
      rewrite_alias_pattern_ctor(pat = arg, am = am)
    }),
    POr(left, right) => POr(rewrite_alias_pattern_ctor(pat = left, am = am), rewrite_alias_pattern_ctor(pat = right, am = am)),
    PStruct(name, fields) => PStruct(name, for field in fields {
      (field.0, rewrite_alias_pattern_ctor(pat = field.1, am = am))
    }),
    _ => pat
  }
}

fn rewrite_alias_arms_ix(arms: Array[(Pat, Expr)], am: AliasIdx) -> Array[(Pat, Expr)] {
  let mut out = arms
  let mut copied = false
  let mut i = 0
  while i < Array::length(arms) {
    let (pat, body) = Array::get(arms, at = i)
    let m = alias_marks()
    let next_pat = if Array::length(am.pattern_ctors) > 0 {
      rewrite_alias_pattern_ctor(pat = pat, am = am)
    } else {
      pat
    }
    let r = rewrite_alias_expr_ix(expr = body, am = aliasidx_without_pat(am = am, pat = pat))
    if copied {
      Array::push(out, value = (next_pat, r))
    } else if alias_marks() != m {
      out = Array::slice(arms, start = 0, end = i)
      Array::push(out, value = (next_pat, r))
      copied = true
    } else {
      ()
    }
    i = i + 1
  }
  out
}

/// #3379: an effect operation's arm binds `resume` to its continuation, so
/// an imported `fn resume` is not what `resume` names there. Renaming it to
/// the import's target made `Op => resume(7)` call the function instead of
/// resuming; a top-level `fn resume` of the same module already resolved to
/// the continuation. An exception arm binds no `resume`, so it keeps the
/// import.
fn rewrite_alias_handle_arms_ix(arms: Array[(Pat, Expr)], am: AliasIdx) -> Array[(Pat, Expr)] {
  let mut binds_resume = false
  let mut bi = 0
  while bi < Array::length(arms) && !binds_resume {
    binds_resume = handle_arm_binds_resume(Array::get(arms, at = bi).0)
    bi = bi + 1
  }
  if !binds_resume {
    rewrite_alias_arms_ix(arms = arms, am = am)
  } else {
    let without_resume = aliasidx_without_name(am = am, name = "resume")
    let mut out = arms
    let mut copied = false
    let mut i = 0
    while i < Array::length(arms) {
      let arm = Array::get(arms, at = i)
      let m = alias_marks()
      let arm_aliases = if handle_arm_binds_resume(arm.0) {
        without_resume
      } else {
        am
      }
      let r = Array::get(rewrite_alias_arms_ix(arms = [arm], am = arm_aliases), at = 0)
      if copied {
        Array::push(out, value = r)
      } else if alias_marks() != m {
        out = Array::slice(arms, start = 0, end = i)
        Array::push(out, value = r)
        copied = true
      } else {
        ()
      }
      i = i + 1
    }
    out
  }
}

fn handle_arm_binds_resume(_ p: Pat) -> Bool {
  match p {
    PCtor(label, _) => String::index_of(label, needle = "::") > 0 && !is_exception_operation_name(label),
    POr(l, r) => handle_arm_binds_resume(l) && handle_arm_binds_resume(r),
    _ => false
  }
}

/// Type arguments (`TyApp`, `TyTuple`, `TyFn` params), same sharing.
fn rewrite_alias_types_ix(items: Array[TypeExpr], am: AliasIdx) -> Array[TypeExpr] {
  let mut out = items
  let mut copied = false
  let mut i = 0
  while i < Array::length(items) {
    let m = alias_marks()
    let r = rewrite_alias_type_expr(te = Array::get(items, at = i), am = am)
    if copied {
      Array::push(out, value = r)
    } else if alias_marks() != m {
      out = Array::slice(items, start = 0, end = i)
      Array::push(out, value = r)
      copied = true
    } else {
      ()
    }
    i = i + 1
  }
  out
}

/// alias_map_has_name, O(1): does binding `name` shadow any alias?
fn aliasidx_shadows(am: AliasIdx, name: String) -> Bool {
  MutSet::has(am.shadow_keys, x = name)
}

fn aliasidx_without_name(am: AliasIdx, name: String) -> AliasIdx {
  if aliasidx_shadows(am = am, name = name) {
    aliasidx_rebuild(am = am, entries = alias_map_without_name(aliases = am.entries, name = name))
  } else {
    am
  }
}

fn aliasidx_without_names(am: AliasIdx, names: Array[String]) -> AliasIdx {
  let mut any = false
  let mut i = 0
  while i < Array::length(names) && !any {
    if aliasidx_shadows(am = am, name = type_param_name(Array::get(names, at = i))) {
      any = true
    } else {
      i = i + 1
    }
  }
  if any {
    aliasidx_rebuild(am = am, entries = alias_map_without_names(aliases = am.entries, names = names))
  } else {
    am
  }
}

/// Bound names of a pattern (binders are plain identifiers), for the O(1)
/// shadow pre-check in aliasidx_without_pat. Same walk as pat_binds_name.
fn pat_collect_bound_names(pat: Pat, out: Array[String]) -> Int {
  match pat {
    PBind(bound) => {
      Array::push(out, value = bound); 0
    },
    PCtor(_, pats) => {
      let mut i = 0
      while i < Array::length(pats) {
        pat_collect_bound_names(pat = Array::get(pats, at = i), out = out)
        i = i + 1
      }
      0
    },
    PTuple(pats) => {
      let mut i = 0
      while i < Array::length(pats) {
        pat_collect_bound_names(pat = Array::get(pats, at = i), out = out)
        i = i + 1
      }
      0
    },
    POr(left, right) => {
      pat_collect_bound_names(pat = left, out = out); pat_collect_bound_names(pat = right, out = out)
    },
    PStruct(_, fields) => {
      let mut i = 0
      while i < Array::length(fields) {
        let (_, field_pat) = Array::get(fields, at = i)
        pat_collect_bound_names(pat = field_pat, out = out)
        i = i + 1
      }
      0
    },
    _ => 0
  }
}

fn aliasidx_without_pat(am: AliasIdx, pat: Pat) -> AliasIdx {
  let bound = empty_strings()
  let _ = pat_collect_bound_names(pat = pat, out = bound)
  let mut any = false
  let mut i = 0
  while i < Array::length(bound) && !any {
    if aliasidx_shadows(am = am, name = Array::get(bound, at = i)) {
      any = true
    } else {
      i = i + 1
    }
  }
  if any {
    aliasidx_rebuild(am = am, entries = alias_map_without_pat(aliases = am.entries, pat = pat))
  } else {
    am
  }
}

fn aliasidx_without_params(am: AliasIdx, params: Array[(String, Option[TypeExpr])]) -> AliasIdx {
  let mut any = false
  let mut i = 0
  while i < Array::length(params) && !any {
    let (param_name, _) = Array::get(params, at = i)
    if aliasidx_shadows(am = am, name = param_name) {
      any = true
    } else {
      i = i + 1
    }
  }
  if any {
    aliasidx_rebuild(am = am, entries = alias_map_without_params(aliases = am.entries, params = params))
  } else {
    am
  }
}

export fn rewrite_import_alias_expr(expr: Expr, aliases: Array[(String, String)]) -> Expr {
  if Array::length(aliases) == 0 {
    expr
  } else {
    rewrite_alias_expr_ix(expr = expr, am = aliasidx_build(aliases))
  }
}

/// #1259: prebuilt-index variant for callers that rewrite MANY expressions
/// against the same alias map. rewrite_import_alias_expr builds the index
/// per call, which is fine for one-shot use but was the dominant share of
/// bump-heap growth (and ~300ms of rehash churn) when normalize's module
/// flattening called it once per binding.
export fn make_import_alias_rewriter(_ aliases: Array[(String, String)]) -> (Expr) -> Expr {
  let am = aliasidx_build(aliases)
  (e) -> {
    rewrite_alias_expr_ix(expr = e, am = am)
  }
}

/// #1502: `H::Crimson` -> `Hue::Crimson` when `H` is an import alias. `expr` is
/// returned unchanged for an unqualified name or a head that is not aliased,
/// so the caller keeps sharing the original node in the common case.
fn rewrite_alias_qualified_head(expr: Expr, name: String, am: AliasIdx) -> Expr {
  let qi = String::index_of(name, needle = "::")
  if qi < 0 {
    expr
  } else {
    let head = String::substring(name, start = 0, end = qi)
    if MutMap::has(am.idx, k = String::concat(head, "::__vibe_trait_namespace_alias")) {
      // An explicit `trait Provider as Local` import owns value names under
      // `Local::*`. Unlike a type/constructor reference, `Local::method`
      // must stay local so trait namespace helpers remain distinct from a
      // separately declared `Provider::method`.
      expr
    } else {
      match aliasidx_get(am = am, name = head) {
        Some(original) => EIdent(String::concat(original, String::substring(name, start = qi, end = String::length(name))), -1),
        // #3889: a companion called through a transparent `type M = L` the
        // file declares names `L::m`, the same rows a struct literal through
        // the alias follows. A companion the alias declares itself has a
        // self row (`M::tag` -> `M::tag`), so the exact lookup answers first.
        None => if Array::length(local_record_alias_heads) > 0 && import_alias_rewrite_string_array_contains(items = local_record_alias_heads, target = head) {
          match record_alias_name(am = am, name = head) {
            Some(resolved) => EIdent(String::concat(resolved, String::substring(name, start = qi, end = String::length(name))), -1),
            None => expr
          }
        } else {
          expr
        }
      }
    }
  }
}

fn rewrite_alias_type_opt(ty: Option[TypeExpr], am: AliasIdx) -> Option[TypeExpr] {
  match ty {
    Some(inner) => Some(rewrite_alias_type_expr(te = inner, am = am)),
    None => None
  }
}

fn rewrite_alias_trait_ref(trait_ref: String, am: AliasIdx) -> String {
  match trait_ref_from_key(trait_ref) {
    Some(applied) => trait_ref_key(rewrite_alias_type_expr(te = applied, am = am)),
    None => match aliasidx_get(am = am, name = trait_ref) {
      Some(original) => original,
      None => trait_ref
    }
  }
}

fn rewrite_alias_bounds(bounds: Array[(String, Array[String])], am: AliasIdx) -> Array[(String, Array[String])] {
  for bound in bounds {
    let (param, traits) = bound
    (param, for trait_ref in traits {
      rewrite_alias_trait_ref(trait_ref = trait_ref, am = am)
    })
  }
}

fn rewrite_alias_param_types(params: Array[(String, Option[TypeExpr])], am: AliasIdx) -> Array[(String, Option[TypeExpr])] {
  for param in params {
    let (name, ty) = param
    (name, rewrite_alias_type_opt(ty = ty, am = am))
  }
}

/// #2348: is this expression an inline-wasm marker call, `%wasm("<WAT>")`?
fn is_inline_wasm_marker_body(_ body: Expr) -> Bool {
  match body {
    ECall(callee, args, _, _) => is_inline_wasm_marker(callee = callee, args = args),
    _ => false
  }
}

/// #2348: is this call the parser's inline-wasm marker, `%wasm("<WAT>")`?
fn is_inline_wasm_marker(callee: Expr, args: Array[Expr]) -> Bool {
  match callee {
    EIdent(cname, _) => if cname == inline_wasm_marker_name() && Array::length(args) == 1 {
      match Array::get(args, at = 0) {
        EString(_, _) => true,
        _ => false
      }
    } else {
      false
    },
    _ => false
  }
}

/// #2348: rename the `call $name` callees inside an inline-wasm marker's WAT
/// text with the same map the surrounding rewrite applies to identifiers, so
/// a kernel keeps calling the helper it named after the helper is renamed.
fn rewrite_wat_marker_args(args: Array[Expr], am: AliasIdx) -> Array[Expr] {
  match Array::get(args, at = 0) {
    EString(wat, _) => {
      let names = wat_callee_names(wat)
      let from = array_empty()
      let to = array_empty()
      let mut i = 0
      while i < Array::length(names) {
        let name = Array::get(names, at = i)
        match aliasidx_get(am = am, name = name) {
          Some(renamed) => {
            Array::push(from, value = name)
            Array::push(to, value = renamed)
          },
          None => ()
        }
        i = i + 1
      }
      [EString(wat_rewrite_callees(wat = wat, from = from, to = to), -1)]
    },
    _ => args
  }
}

/// #3185: the identifier a rename-mode entry gives a program-written reference.
/// An entry that maps a spelling to ITSELF marks a reference the program's
/// private definition cannot reach -- another file's -- as the builtin's, keeping
/// its offset as a key (`index_site_key`); any other entry renames it.
fn builtin_shadow_renamed_ident(name: String, renamed: String, off: Int) -> Expr {
  if renamed == name {
    EIdent(name, index_site_key(off))
  } else {
    EIdent(renamed, off)
  }
}

// The unit-owner rename resolves references outside a private definition's
// unit to explicit builtin references. Its synthesized calls need the same
// identity as any other builtin factory, even after a whole-program check.
//
// #3816: only slot zero is the callee's identity. After a check, the slots
// behind it carry the argument placement the checker chose, and the lowering
// refuses a labeled call without one -- so a dependency's
// `Array::get(xs, at = 0)` beside the entry's own `fn Array::get` failed to
// build while the positional spelling built. Replace the identity and keep the
// placement.
fn builtin_shadow_call_resolution(callee: Expr, resolution: Array[Int], am: AliasIdx) -> Array[Int] {
  if am.user_refs_only {
    match callee {
      EIdent(name, off) => if is_builtin_ref_offset(off) {
        let builtin = builtin_callee_resolution(name)
        if call_placement_cell_prefix(cell = resolution, start = 0) {
          let kept = Array::slice(resolution, start = 0, end = Array::length(resolution))
          if Array::length(builtin) > 0 {
            Array::set(kept, at = 0, value = Array::get(builtin, at = 0))
          } else {
            ()
          }
          kept
        } else {
          builtin
        }
      } else {
        resolution
      },
      _ => resolution
    }
  } else {
    resolution
  }
}

export fn rewrite_alias_expr_ix(expr: Expr, am: AliasIdx) -> Expr {
  // Perf: with no aliases the rewrite is the identity, but the match below
  // still rebuilt EVERY node of the tree. Alias maps only shrink on the way
  // down (without_*), so an empty map stays empty for the whole subtree --
  // return the shared node instead of an allocated copy (AST nodes are
  // immutable; `None => expr` below already shares subtrees). #2386: with a
  // map, an arm rewrites its children first and constructs a node only when
  // `alias_marks` moved while it did -- see the counter's note above.
  if Array::length(am.entries) == 0 && Array::length(am.pattern_ctors) == 0 {
    expr
  } else {
    match expr {
      EIdent(name, off) => if am.user_refs_only {
        if is_builtin_ref_offset(off) {
          expr
        } else {
          match aliasidx_get(am = am, name = name) {
            Some(renamed) => builtin_shadow_renamed_ident(name = name, renamed = renamed, off = off),
            None => expr
          }
        }
      } else {
        match aliasidx_get(am = am, name = name) {
          // #3542: the reference keeps its source offset. Dropping it left an
          // imported name (`pi` from `@vibe/core`) with no key, so the
          // checker's type for it reached no consumer: a Double rendered as
          // its box address. The rename changes the spelling, not the node.
          Some(original) => EIdent(original, off),
          // #1502: a qualified constructor reference carries the alias in its
          // HEAD (`import { Hue as H }` then `H::Crimson`), and the whole string
          // is never an alias key, so the lookup above misses and the alias used
          // to survive all the way to codegen -- whose constructor table is keyed
          // by the ORIGINAL unqualified name -- as `undefined variable (ident):
          // H::Crimson`. Rewriting the head here hands the rest of the pipeline
          // the same `Hue::Crimson` an unaliased import would have produced.
          None => rewrite_alias_qualified_head(expr = expr, name = name, am = am)
        }
      },
      ETuple(items) => {
        let m = alias_marks()
        let out = rewrite_alias_exprs_ix(items = items, am = am)
        if alias_marks() == m {
          expr
        } else {
          ETuple(out)
        }
      },
      EArray(items) => {
        let m = alias_marks()
        let out = rewrite_alias_exprs_ix(items = items, am = am)
        if alias_marks() == m {
          expr
        } else {
          EArray(out)
        }
      },
      ERecord(rn, fields, targs) => {
        let m = alias_marks()
        let out = rewrite_alias_named_exprs_ix(fields = fields, am = am)
        // #3837: `Q::{ .. }` after `import ./a.vibe { B as Q }` names `B`.
        // Lowering finds a literal's struct by that name; a name it does not
        // know falls back to the first struct with the same field set, so an
        // unrenamed `Q` printed and dispatched as another same-shaped struct.
        let renamed = if String::length(rn) == 0 {
          None
        } else {
          record_alias_name(am = am, name = rn)
        }
        match renamed {
          Some(original) => ERecord(original, out, targs),
          None => if alias_marks() == m {
            expr
          } else {
            ERecord(rn, out, targs)
          }
        }
      },
      EIf(cond, then_expr, else_expr) => {
        let m = alias_marks()
        let c2 = rewrite_alias_expr_ix(expr = cond, am = am)
        let t2 = rewrite_alias_expr_ix(expr = then_expr, am = am)
        let e2 = rewrite_alias_expr_ix(expr = else_expr, am = am)
        if alias_marks() == m {
          expr
        } else {
          EIf(c2, t2, e2)
        }
      },
      ELet(name, value, body, soff) => {
        let m = alias_marks()
        let v2 = rewrite_alias_expr_ix(expr = value, am = am)
        let b2 = rewrite_alias_expr_ix(expr = body, am = aliasidx_without_name(am = am, name = name))
        if alias_marks() == m {
          expr
        } else {
          ELet(name, v2, b2, soff)
        }
      },
      ELetRec(name, value, body) => {
        let body_aliases = aliasidx_without_name(am = am, name = name)
        let m = alias_marks()
        let v2 = rewrite_alias_expr_ix(expr = value, am = body_aliases)
        let b2 = rewrite_alias_expr_ix(expr = body, am = body_aliases)
        if alias_marks() == m {
          expr
        } else {
          ELetRec(name, v2, b2)
        }
      },
      ELetMut(name, value, body, soff) => {
        let m = alias_marks()
        let v2 = rewrite_alias_expr_ix(expr = value, am = am)
        let b2 = rewrite_alias_expr_ix(expr = body, am = aliasidx_without_name(am = am, name = name))
        if alias_marks() == m {
          expr
        } else {
          ELetMut(name, v2, b2, soff)
        }
      },
      EAssign(name, value, body, target_off) => {
        let m = alias_marks()
        let v2 = rewrite_alias_expr_ix(expr = value, am = am)
        let b2 = rewrite_alias_expr_ix(expr = body, am = am)
        if alias_marks() == m {
          expr
        } else {
          EAssign(name, v2, b2, target_off)
        }
      },
      EAssignOp(name, op, value, body, target_off) => {
        let m = alias_marks()
        let v2 = rewrite_alias_expr_ix(expr = value, am = am)
        let b2 = rewrite_alias_expr_ix(expr = body, am = am)
        if alias_marks() == m {
          expr
        } else {
          EAssignOp(name, op, v2, b2, target_off)
        }
      },
      ESeq(left, right) => {
        let m = alias_marks()
        let l2 = rewrite_alias_expr_ix(expr = left, am = am)
        let r2 = rewrite_alias_expr_ix(expr = right, am = am)
        if alias_marks() == m {
          expr
        } else {
          ESeq(l2, r2)
        }
      },
      EMatch(scrutinee, arms) => {
        let m = alias_marks()
        let s2 = rewrite_alias_expr_ix(expr = scrutinee, am = am)
        let arms2 = rewrite_alias_arms_ix(arms = arms, am = am)
        if alias_marks() == m {
          expr
        } else {
          EMatch(s2, arms2)
        }
      },
      EHandle(body, arms) => {
        let m = alias_marks()
        let b2 = rewrite_alias_expr_ix(expr = body, am = am)
        let arms2 = rewrite_alias_handle_arms_ix(arms = arms, am = am)
        if alias_marks() == m {
          expr
        } else {
          EHandle(b2, arms2)
        }
      },
      EWhile(cond, body) => {
        let m = alias_marks()
        let c2 = rewrite_alias_expr_ix(expr = cond, am = am)
        let b2 = rewrite_alias_expr_ix(expr = body, am = am)
        if alias_marks() == m {
          expr
        } else {
          EWhile(c2, b2)
        }
      },
      ELoop(params, body) => {
        let mut body_aliases = am
        let mut i = 0
        while i < Array::length(params) {
          let (name, _) = Array::get(params, at = i)
          body_aliases = aliasidx_without_name(am = body_aliases, name = name)
          i = i + 1
        }
        let m = alias_marks()
        let out_params = rewrite_alias_named_exprs_ix(fields = params, am = am)
        let b2 = rewrite_alias_expr_ix(expr = body, am = body_aliases)
        if alias_marks() == m {
          expr
        } else {
          ELoop(out_params, b2)
        }
      },
      EForIn(name, index_name, iter, body) => {
        let body_aliases = match index_name {
          Some(index_name) => aliasidx_without_name(am = aliasidx_without_name(am = am, name = name), name = index_name),
          None => aliasidx_without_name(am = am, name = name)
        }
        let m = alias_marks()
        let i2 = rewrite_alias_expr_ix(expr = iter, am = am)
        let b2 = rewrite_alias_expr_ix(expr = body, am = body_aliases)
        if alias_marks() == m {
          expr
        } else {
          EForIn(name, index_name, i2, b2)
        }
      },
      // #2348: an inline-wasm body is `%wasm("<WAT text>")`, and a
      // `(call $helper ...)` inside that text names a fn of this module. The
      // generic rewrite below cannot see it -- the text is an EString -- so a
      // private helper's DEFINITION was renamed by the merge while the
      // `$helper` token was left pointing at a name that no longer existed.
      ECall(callee, args, off, callee_resolution) => if is_inline_wasm_marker(callee = callee, args = args) {
        let m = alias_marks()
        let c2 = rewrite_alias_expr_ix(expr = callee, am = am)
        let a2 = rewrite_wat_marker_args(args = args, am = am)
        if alias_marks() == m {
          expr
        } else {
          ECall(c2, a2, off, builtin_shadow_call_resolution(callee = c2, resolution = callee_resolution, am = am))
        }
      } else {
        let m = alias_marks()
        let c2 = rewrite_alias_expr_ix(expr = callee, am = am)
        let a2 = rewrite_alias_exprs_ix(items = args, am = am)
        if alias_marks() == m {
          expr
        } else {
          ECall(c2, a2, off, builtin_shadow_call_resolution(callee = c2, resolution = callee_resolution, am = am))
        }
      },
      EBinOp(op, left, right, boff) => {
        let m = alias_marks()
        let l2 = rewrite_alias_expr_ix(expr = left, am = am)
        let r2 = rewrite_alias_expr_ix(expr = right, am = am)
        if alias_marks() == m {
          expr
        } else {
          EBinOp(op, l2, r2, boff)
        }
      },
      EUnaryOp(op, value) => {
        let m = alias_marks()
        let v2 = rewrite_alias_expr_ix(expr = value, am = am)
        if alias_marks() == m {
          expr
        } else {
          EUnaryOp(op, v2)
        }
      },
      EFn(type_params, bounds, params, ret_ty, effect, body) => {
        // Type formals shadow imported TYPE aliases, independently of value
        // parameters shadowing imported VALUE aliases. Preserve both
        // namespaces while canonicalizing imported contract aliases in fn
        // parameter and return annotations (#1539 StdinStream as S).
        let type_am = aliasidx_without_names(am = am, names = type_params)
        // #2348: a WAT body's `$name` callees are wasm FUNCTION names, a
        // namespace of their own -- `fn caller(helper: Int) = wasm"(call
        // $helper (local.get $helper))"` calls the fn and reads the param, and
        // the assembler already keeps those apart. So the marker body is
        // rewritten with the UNSHADOWED map: passing it the params-removed one
        // left the callee spelled for a definition the merge had renamed.
        let body_am = if is_inline_wasm_marker_body(body) {
          am
        } else {
          aliasidx_without_params(am = am, params = params)
        }
        let m = alias_marks()
        let bounds2 = rewrite_alias_bounds(bounds = bounds, am = type_am)
        let params2 = rewrite_alias_param_types(params = params, am = type_am)
        let ret2 = rewrite_alias_type_opt(ty = ret_ty, am = type_am)
        let b2 = rewrite_alias_expr_ix(expr = body, am = body_am)
        if alias_marks() == m {
          expr
        } else {
          EFn(type_params, bounds2, params2, ret2, effect, b2)
        }
      },
      // #897: `mod.x` written against a qualified-import namespace (`import
      // ... as mod only { x }`) is encoded as the alias key "mod.x" -- see
      // qualify_import_items in lib/@vibe/parser/parser.vibe. A real
      // identifier can never contain '.', so this lookup only ever hits for
      // that desugaring; anything else falls through to the ordinary EDot
      // rewrite (ordinary struct/record field access).
      EDot(obj, field, off, fdoff) => {
        let namespaced = match obj {
          EIdent(ns, _) => aliasidx_get(am = am, name = String::concat(ns, String::concat(".", field))),
          _ => None
        }
        match namespaced {
          Some(original) => EIdent(original, -1),
          None => {
            let m = alias_marks()
            let o2 = rewrite_alias_expr_ix(expr = obj, am = am)
            if alias_marks() == m {
              expr
            } else {
              EDot(o2, field, off, fdoff)
            }
          }
        }
      },
      ELabeledArg(label, name, body) => {
        let m = alias_marks()
        let b2 = rewrite_alias_expr_ix(expr = body, am = am)
        if alias_marks() == m {
          expr
        } else {
          ELabeledArg(label, name, b2)
        }
      },
      EReturn(value) => {
        let m = alias_marks()
        let v2 = rewrite_alias_expr_ix(expr = value, am = am)
        if alias_marks() == m {
          expr
        } else {
          EReturn(v2)
        }
      },
      EBreak(value) => match value {
        Some(value) => {
          let m = alias_marks()
          let v2 = rewrite_alias_expr_ix(expr = value, am = am)
          if alias_marks() == m {
            expr
          } else {
            EBreak(Some(v2))
          }
        },
        None => expr
      },
      EContinue(values) => {
        let m = alias_marks()
        let out = rewrite_alias_exprs_ix(items = values, am = am)
        if alias_marks() == m {
          expr
        } else {
          EContinue(out)
        }
      },
      EMap(fields) => {
        let m = alias_marks()
        let out = rewrite_alias_named_exprs_ix(fields = fields, am = am)
        if alias_marks() == m {
          expr
        } else {
          EMap(out)
        }
      },
      ESpread(value) => {
        let m = alias_marks()
        let v2 = rewrite_alias_expr_ix(expr = value, am = am)
        if alias_marks() == m {
          expr
        } else {
          ESpread(v2)
        }
      },
      _ => expr
    }
  }
}

fn record_alias_key(_ name: String) -> String {
  String::concat("record ", name)
}

/// The name a transparent alias stands for when a struct literal is written
/// through it: `type M = L` names `L`, and `type B[T] = Box[T]` names `Box`.
/// An alias that fixes or reorders the arguments (`type IB = Box[Int]`) is
/// not one; the checker refuses a literal through it (#3837).
export fn record_alias_target(params: Array[String], target: TypeExpr) -> Option[String] {
  match target {
    TyName(t) => Some(t),
    TyApp(t, args) => if Array::length(args) == Array::length(params) {
      let mut ok = true
      let mut i = 0
      while i < Array::length(args) && ok {
        ok = match Array::get(args, at = i) {
          TyName(n) => n == type_param_name(Array::get(params, at = i)),
          _ => false
        }
        i = i + 1
      }
      if ok {
        Some(t)
      } else {
        None
      }
    } else {
      None
    },
    _ => None
  }
}

/// The struct a literal's name denotes once local transparent aliases and
/// import aliases are followed, or `None` when it names itself.
///
/// The walk is bounded by the size of the map, not by a fixed budget: a fixed
/// 16 stopped a 17-alias chain one hop short of its struct, and the checker,
/// which accepted the literal, cannot see where lowering gave up (Codex on
/// #3855). An acyclic chain is never longer than the map.
fn record_alias_name(am: AliasIdx, name: String) -> Option[String] {
  let mut cur = name
  let mut fuel = Array::length(am.entries) + 1
  while fuel > 0 {
    fuel = fuel - 1
    match MutMap::get(am.idx, k = record_alias_key(cur)) {
      Some(next) => cur = next,
      None => fuel = 0
    }
  }
  let resolved = match aliasidx_get(am = am, name = cur) {
    Some(original) => original,
    None => cur
  }
  if resolved == name {
    None
  } else {
    // A parent keeps its original node unless the marks moved below it
    // (#2386), and a local alias row is read without `aliasidx_get`.
    Array::set(alias_rewrite_marks, at = 0, value = Array::get(alias_rewrite_marks, at = 0) + 1)
    Some(resolved)
  }
}

export fn collect_import_aliases(_ stmts: Array[Stmt]) -> Array[(String, String)] {
  let aliases = empty_aliases()
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, at = i) {
      SImport(raw_path, items) => if !is_builtin_iterator_serialized_boundary_path(raw_path) {
        let mut j = 0
        while j < Array::length(items) {
          let item = Array::get(items, at = j)
          let original = item.name
          let alias_opt = item.alias
          match alias_opt {
            Some(alias) => if alias != original {
              Array::push(aliases, value = (alias, original))
            },
            None => ()
          }
          j = j + 1
        }
      },
      _ => ()
    }
    i = i + 1
  }
  aliases
}

export fn collect_import_refs(_ stmts: Array[Stmt]) -> Array[(String, String, String)] {
  let refs = empty_import_refs()
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, at = i) {
      SImport(raw_path, items) => if !is_builtin_iterator_serialized_boundary_path(raw_path) {
        let mut j = 0
        while j < Array::length(items) {
          let item = Array::get(items, at = j)
          let original = item.name
          let alias_opt = item.alias
          let local = match alias_opt {
            Some(alias) => alias,
            None => original
          }
          Array::push(refs, value = (raw_path, original, local))
          j = j + 1
        }
      },
      _ => ()
    }
    i = i + 1
  }
  refs
}

export fn collect_import_alias_collision_refs(_ stmts: Array[Stmt]) -> Array[(String, String, String)] {
  let refs = collect_import_refs(stmts)
  let out = empty_import_refs()
  let mut i = 0
  while i < Array::length(refs) {
    let (raw_path, original, local) = Array::get(refs, at = i)
    if import_ref_has_other_path_for_original(items = refs, raw_path = raw_path, original = original) && !import_ref_array_contains_local(items = out, target = local) {
      Array::push(out, value = (raw_path, original, local))
    }
    i = i + 1
  }
  out
}

export fn collect_import_alias_collision_locals(_ stmts: Array[Stmt]) -> Array[String] {
  let refs = collect_import_alias_collision_refs(stmts)
  let out = empty_strings()
  let mut i = 0
  while i < Array::length(refs) {
    let (_, _, local) = Array::get(refs, at = i)
    if !import_alias_rewrite_string_array_contains(items = out, target = local) {
      Array::push(out, value = local)
    }
    i = i + 1
  }
  out
}

export fn rewrite_import_alias_stmt(stmt: Stmt, aliases: Array[(String, String)]) -> Stmt {
  rewrite_alias_stmt_ix(stmt = stmt, am = aliasidx_build(aliases))
}

/// Parser-generated impl methods carry the impl target in their internal
/// owner. Rewriting an imported type alias in `SImpl` therefore also has to
/// rename the following method declarations; otherwise trait resolution asks
/// for the canonical owner while codegen only has the source-spelled owner.
fn collect_impl_method_owner_aliases(stmts: Array[Stmt], aliases: Array[(String, String)]) -> Array[(String, String)] {
  let out = empty_aliases()
  let am = aliasidx_build(aliases)
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, at = i) {
      SImpl(tparams, _, trait_name, target) => {
        let type_am = aliasidx_without_names(am = am, names = tparams)
        let rewritten_trait = rewrite_alias_trait_ref(trait_ref = trait_name, am = type_am)
        let rewritten_target = rewrite_alias_type_expr(te = target, am = type_am)
        let source_owner = impl_method_owner(tparams = tparams, trait_name = trait_name, target = target)
        let rewritten_owner = impl_method_owner(tparams = tparams, trait_name = rewritten_trait, target = rewritten_target)
        if source_owner != rewritten_owner {
          Array::push(out, value = (source_owner, rewritten_owner))
        } else {
          ()
        }
      },
      _ => ()
    }
    i = i + 1
  }
  out
}

fn rewrite_impl_method_binding_name(name: String, owner_aliases: Array[(String, String)]) -> String {
  let mut out = name
  let mut i = 0
  let mut found = false
  while i < Array::length(owner_aliases) && !found {
    let (source_owner, rewritten_owner) = Array::get(owner_aliases, at = i)
    let prefix = String::concat(source_owner, "::")
    if String::starts_with(name, prefix = prefix) {
      out = String::concat(rewritten_owner, String::substring(name, start = String::length(source_owner), end = String::length(name)))
      found = true
    } else {
      i = i + 1
    }
  }
  out
}

fn rewrite_impl_method_binding(stmt: Stmt, owner_aliases: Array[(String, String)]) -> Stmt {
  match stmt {
    SLet(exported, is_rec, name, ty, body) => SLet(exported, is_rec, rewrite_impl_method_binding_name(name = name, owner_aliases = owner_aliases), ty, body),
    SFnDecl(exported, name, body, requires, ensures) => SFnDecl(exported, rewrite_impl_method_binding_name(name = name, owner_aliases = owner_aliases), body, requires, ensures),
    // ADR-0120 D3: a declaration's `_` slots follow its name.
    SPositionalParams(rows) => SPositionalParams(for row in rows {
      let (decl, slots) = row
      (rewrite_impl_method_binding_name(name = decl, owner_aliases = owner_aliases), slots)
    }),
    _ => stmt
  }
}

export fn collect_local_type_aliases(_ stmts: Array[Stmt]) -> Array[(String, Array[String], TypeExpr)] {
  let out = []
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, at = i) {
      STypeAlias(_, name, params, target) => Array::push(out, value = (name, params, target)),
      _ => ()
    }
    i = i + 1
  }
  out
}

fn lookup_local_type_alias(aliases: Array[(String, Array[String], TypeExpr)], name: String) -> Option[(Array[String], TypeExpr)] {
  let mut i = 0
  let mut found = None
  while i < Array::length(aliases) {
    let (alias_name, params, target) = Array::get(aliases, at = i)
    if alias_name == name {
      found = Some((params, target))
      i = Array::length(aliases)
    } else {
      i = i + 1
    }
  }
  found
}

fn local_alias_arg(params: Array[String], args: Array[TypeExpr], name: String) -> Option[TypeExpr] {
  let mut i = 0
  let mut found = None
  while i < Array::length(params) {
    if type_param_name(Array::get(params, at = i)) == name && i < Array::length(args) {
      found = Some(Array::get(args, at = i))
      i = Array::length(params)
    } else {
      i = i + 1
    }
  }
  found
}

fn substitute_local_alias_target(target: TypeExpr, params: Array[String], args: Array[TypeExpr]) -> TypeExpr {
  match target {
    TyName(name) => match local_alias_arg(params = params, args = args, name = name) {
      Some(arg) => arg,
      None => target
    },
    TyApp(name, items) => TyApp(name, for item in items {
      substitute_local_alias_target(target = item, params = params, args = args)
    }),
    TyFn(fn_params, ret, effect) => TyFn(for param in fn_params {
      substitute_local_alias_target(target = param, params = params, args = args)
    }, substitute_local_alias_target(target = ret, params = params, args = args), effect),
    TyTuple(items) => TyTuple(for item in items {
      substitute_local_alias_target(target = item, params = params, args = args)
    }),
    TyUnit => target
  }
}

fn normalize_local_alias_target_with_fuel(target: TypeExpr, aliases: Array[(String, Array[String], TypeExpr)], fuel: Int) -> TypeExpr {
  if fuel <= 0 {
    target
  } else match target {
    TyName(name) => match lookup_local_type_alias(aliases = aliases, name = name) {
      Some(alias) => {
        let (params, alias_target) = alias
        if Array::length(params) == 0 {
          normalize_local_alias_target_with_fuel(target = alias_target, aliases = aliases, fuel = fuel - 1)
        } else {
          target
        }
      },
      None => target
    },
    TyApp(name, args) => match lookup_local_type_alias(aliases = aliases, name = name) {
      Some(alias) => {
        let (params, alias_target) = alias
        if Array::length(params) == Array::length(args) {
          normalize_local_alias_target_with_fuel(target = substitute_local_alias_target(target = alias_target, params = params, args = args), aliases = aliases, fuel = fuel - 1)
        } else {
          target
        }
      },
      None => TyApp(name, for arg in args {
        normalize_local_alias_target_with_fuel(target = arg, aliases = aliases, fuel = fuel - 1)
      })
    },
    TyFn(params, ret, effect) => TyFn(for param in params {
      normalize_local_alias_target_with_fuel(target = param, aliases = aliases, fuel = fuel - 1)
    }, normalize_local_alias_target_with_fuel(target = ret, aliases = aliases, fuel = fuel - 1), effect),
    TyTuple(items) => TyTuple(for item in items {
      normalize_local_alias_target_with_fuel(target = item, aliases = aliases, fuel = fuel - 1)
    }),
    TyUnit => target
  }
}

fn normalize_local_alias_target(target: TypeExpr, aliases: Array[(String, Array[String], TypeExpr)]) -> TypeExpr {
  normalize_local_alias_target_with_fuel(target = target, aliases = aliases, fuel = Array::length(aliases) + 1)
}

/// Pattern qualification needs the nominal head, even when a local alias
/// applies type arguments that the constructor pattern does not spell.
export fn local_pattern_qualifier_head(name: String, aliases: Array[(String, Array[String], TypeExpr)], fuel: Int) -> String {
  if fuel <= 0 {
    name
  } else match lookup_local_type_alias(aliases = aliases, name = name) {
    Some(alias) => {
      let next = match alias.1 {
        TyName(head) => head,
        TyApp(head, _) => head,
        _ => name
      }
      if next == name {
        name
      } else {
        local_pattern_qualifier_head(name = next, aliases = aliases, fuel = fuel - 1)
      }
    },
    None => name
  }
}

fn collect_local_impl_method_owner_aliases(stmts: Array[Stmt], aliases: Array[(String, Array[String], TypeExpr)]) -> Array[(String, String)] {
  let out = empty_aliases()
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, at = i) {
      SImpl(tparams, _, trait_name, target) => {
        let normalized_target = normalize_local_alias_target(target = target, aliases = aliases)
        let source_owner = impl_method_owner(tparams = tparams, trait_name = trait_name, target = target)
        let normalized_owner = impl_method_owner(tparams = tparams, trait_name = trait_name, target = normalized_target)
        if source_owner != normalized_owner {
          Array::push(out, value = (source_owner, normalized_owner))
        } else {
          ()
        }
      },
      _ => ()
    }
    i = i + 1
  }
  out
}

fn rewrite_local_alias_impl_stmt(stmt: Stmt, aliases: Array[(String, Array[String], TypeExpr)], owner_aliases: Array[(String, String)]) -> Stmt {
  match rewrite_impl_method_binding(stmt = stmt, owner_aliases = owner_aliases) {
    SImpl(tparams, bounds, trait_name, target) => SImpl(tparams, bounds, trait_name, normalize_local_alias_target(target = target, aliases = aliases)),
    rewritten => rewritten
  }
}

export fn rewrite_import_alias_stmts(stmts: Array[Stmt], aliases: Array[(String, String)]) -> Array[Stmt] {
  rewrite_import_alias_stmts_with_pattern_ctors(stmts = stmts, aliases = aliases, pattern_ctors = [
  ])
}

export fn rewrite_import_alias_stmts_with_pattern_ctors(stmts: Array[Stmt], aliases: Array[(String, String)], pattern_ctors: Array[(String, String)]) -> Array[Stmt] {
  let owner_aliases = collect_impl_method_owner_aliases(stmts = stmts, aliases = aliases)
  let combined = empty_aliases()
  let mut ai = 0
  while ai < Array::length(aliases) {
    Array::push(combined, value = Array::get(aliases, at = ai))
    ai = ai + 1
  }
  let mut oi = 0
  while oi < Array::length(owner_aliases) {
    Array::push(combined, value = Array::get(owner_aliases, at = oi))
    oi = oi + 1
  }
  let mut ti = 0
  while ti < Array::length(stmts) {
    match Array::get(stmts, at = ti) {
      SImport(raw_path, items) => if !is_builtin_iterator_serialized_boundary_path(raw_path) {
        let mut tj = 0
        while tj < Array::length(items) {
          let item = Array::get(items, at = tj)
          match (item.kind, item.alias) {
            (Some(ImportTrait), Some(alias)) => Array::push(combined, value = (String::concat(alias, "::__vibe_trait_namespace_alias"), alias)),
            _ => ()
          }
          tj = tj + 1
        }
      },
      _ => ()
    }
    ti = ti + 1
  }
  // Explicit trait imports materialize local namespace wrappers such as
  // `Iter::map`. They are real value bindings, not type references to rewrite
  // back to `Iterator::map`. Add exact self-mappings before walking bodies so
  // those calls remain local while ordinary `Iter` type occurrences and
  // unbound qualified constructors still canonicalize through the head alias.
  // #3889: the file's transparent aliases, whose own companions keep their
  // spelling below while every other `M::m` follows the alias.
  let local_record_aliases = empty_strings()
  for stmt in stmts {
    match stmt {
      STypeAlias(_, aname, aparams, target) => if record_alias_target(params = aparams, target = target) is Some(_) {
        Array::push(local_record_aliases, value = aname)
      },
      _ => ()
    }
  }
  let mut bi = 0
  while bi < Array::length(stmts) {
    let bound_name = match Array::get(stmts, at = bi) {
      SLet(_, _, name, _, _) => name,
      SLetMut(name, _, _) => name,
      SExternLet(name, _) => name,
      SFnDecl(_, name, _, _, _) => name,
      _ => ""
    }
    let qi = String::index_of(bound_name, needle = "::")
    if qi > 0 {
      let head = String::substring(bound_name, start = 0, end = qi)
      if (lookup_alias(aliases = aliases, name = head) is Some(_)) || import_alias_rewrite_string_array_contains(items = local_record_aliases, target = head) {
        Array::push(combined, value = (bound_name, bound_name))
      } else {
        ()
      }
    } else {
      ()
    }
    bi = bi + 1
  }
  // #3837: a struct literal through a local transparent alias names the
  // struct it aliases. These rows live under a key no identifier can spell,
  // so only the `ERecord` arm reads them.
  //
  // An `as` import is recorded here too, beside its ordinary row. A value
  // binder that spells the alias (`fn f(BQ: Int)`) removes the ordinary row
  // for its body, and rightly so for a value, but `BQ::{ .. }` there still
  // names the type -- the checker resolves it through the type definitions.
  // Without a row the binder cannot remove, the literal reached lowering as
  // `BQ` and was laid out by its field set alone (Codex on #3855).
  for entry in aliases {
    let (alias, original) = entry
    if String::index_of(alias, needle = "::") < 0 && String::index_of(alias, needle = ".") < 0 {
      Array::push(combined, value = (record_alias_key(alias), original))
    } else {
      ()
    }
  }
  for stmt in stmts {
    match stmt {
      STypeAlias(_, aname, aparams, target) => match record_alias_target(params = aparams, target = target) {
        Some(t) => Array::push(combined, value = (record_alias_key(aname), t)),
        None => ()
      },
      _ => ()
    }
  }
  let am = aliasidx_with_pattern_ctors(am = aliasidx_build(namespace_aliases_without_top_level_values(aliases = combined, stmts = stmts)), pattern_ctors = pattern_ctors)
  let saved_heads = Array::slice(local_record_alias_heads, start = 0, end = Array::length(local_record_alias_heads))
  Array::truncate(local_record_alias_heads, length = 0)
  for a in local_record_aliases {
    Array::push(local_record_alias_heads, value = a)
  }
  let imported = for stmt in stmts {
    rewrite_alias_stmt_ix(stmt = rewrite_impl_method_binding(stmt = stmt, owner_aliases = owner_aliases), am = am)
  }
  Array::truncate(local_record_alias_heads, length = 0)
  for a in saved_heads {
    Array::push(local_record_alias_heads, value = a)
  }
  let local_aliases = collect_local_type_aliases(imported)
  let local_owner_aliases = collect_local_impl_method_owner_aliases(stmts = imported, aliases = local_aliases)
  for stmt in imported {
    rewrite_local_alias_impl_stmt(stmt = stmt, aliases = local_aliases, owner_aliases = local_owner_aliases)
  }
}

/// #3490: `aliases` without the qualified-import members (`helper.greet` of
/// `import ./dep.vibe as helper only { greet }`) whose namespace a top-level
/// value of `stmts` rebinds. The checker reads `helper.greet` there as the
/// value's field, as it does under a local `helper` (#897), so the program
/// must not call the import. A plain alias is not touched: a top-level
/// declaration sharing an import's own name is renamed instead (#3444).
fn namespace_aliases_without_top_level_values(aliases: Array[(String, String)], stmts: Array[Stmt]) -> Array[(String, String)] {
  let names = empty_strings()
  for stmt in stmts {
    match stmt {
      SLet(_, _, name, _, _) => Array::push(names, value = name),
      SLetMut(name, _, _) => Array::push(names, value = name),
      SExternLet(name, _) => Array::push(names, value = name),
      SFnDecl(_, name, _, _, _) => Array::push(names, value = name),
      // `let (helper, n) = ..` binds `helper` too (Codex on #3492).
      SLetPat(pat, _) => pat_bound_names_into(pat = pat, out = names),
      _ => ()
    }
  }
  let mut any = false
  for entry in aliases {
    if !any && alias_namespace_rebound(alias = entry.0, names = names) {
      any = true
    }
  }
  if !any {
    aliases
  } else {
    let out = empty_aliases()
    for entry in aliases {
      if !alias_namespace_rebound(alias = entry.0, names = names) {
        Array::push(out, value = entry)
      }
    }
    out
  }
}

fn pat_bound_names_into(pat: Pat, out: Array[String]) -> Unit {
  match pat {
    PBind(name) => Array::push(out, value = name),
    PCtor(_, pats) => pats_bound_names_into(pats = pats, out = out),
    PTuple(pats) => pats_bound_names_into(pats = pats, out = out),
    POr(left, _) => pat_bound_names_into(pat = left, out = out),
    PStruct(_, fields) => pats_bound_names_into(pats = for f in fields {
      f.1
    }, out = out),
    _ => ()
  }
}

fn pats_bound_names_into(pats: Array[Pat], out: Array[String]) -> Unit {
  for p in pats {
    pat_bound_names_into(pat = p, out = out)
  }
  ()
}

fn alias_namespace_rebound(alias: String, names: Array[String]) -> Bool {
  let dot = String::index_of(alias, needle = ".")
  dot > 0 && import_alias_rewrite_string_array_contains(items = names, target = String::substring(alias, start = 0, end = dot))
}

fn rewrite_alias_stmt_ix(stmt: Stmt, am: AliasIdx) -> Stmt {
  match stmt {
    SLet(exported, is_rec, name, ty, body) => SLet(exported, is_rec, name, rewrite_alias_type_opt(ty = ty, am = am), rewrite_alias_expr_ix(expr = body, am = aliasidx_without_name(am = am, name = name))),
    SLetMut(name, ty, body) => SLetMut(name, rewrite_alias_type_opt(ty = ty, am = am), rewrite_alias_expr_ix(expr = body, am = aliasidx_without_name(am = am, name = name))),
    STest(name, body) => STest(name, rewrite_alias_expr_ix(expr = body, am = am)),
    SBench(name, body) => SBench(name, rewrite_alias_expr_ix(expr = body, am = am)),
    SExpr(body) => SExpr(rewrite_alias_expr_ix(expr = body, am = am)),
    SLetPat(pat, body) => SLetPat(if Array::length(am.pattern_ctors) > 0 {
      rewrite_alias_pattern_ctor(pat = pat, am = am)
    } else {
      pat
    }, rewrite_alias_expr_ix(expr = body, am = am)),
    SQualifiedPatternRefs(rows) => SQualifiedPatternRefs(for row in rows {
      let variant = match lookup_alias(aliases = am.pattern_ctors, name = row.1) {
        Some(renamed) => renamed,
        None => row.1
      }
      (row.0, variant)
    }),
    SModule(exported, name, stmts) => {
      SModule(exported, name, rewrite_import_alias_stmts(stmts = stmts, aliases = collect_import_aliases(stmts)))
    },
    // #1502: an import alias used as a type-alias TARGET (`import { Attempt as
    // Att }` then `type Att2[T] = Att[T]`). The expression arm above already
    // normalizes an alias head in a constructor reference; without the type
    // side in step, `Att2` resolves only as far as `Att` and `Att2::Good`
    // reaches codegen still qualified.
    // The alias's own formals are BOUND names, so they are dropped from the
    // map before the target is rewritten -- the same discipline the expression
    // arms above apply with `aliasidx_without_name` / `aliasidx_without_params`.
    // With `import { Hue as T }` in scope, `type Box[T] = T` must keep its `T`.
    //
    // Note this does NOT by itself make that program correct: the checker's own
    // `STypeAlias` arm resolves the target against a `defs` where the import
    // already bound `T`, and captures it there. That capture predates this
    // rewrite (verified by A/B against origin/main, which has no type-side
    // rewrite at all) and is tracked separately -- what this guard buys is that
    // the rewrite is not a SECOND, independent source of the same bug.
    STypeAlias(exported, name, params, target) => STypeAlias(exported, name, params, rewrite_alias_type_expr(te = target, am = aliasidx_without_names(am = am, names = params))),
    SImpl(tparams, bounds, trait_name, target) => {
      let type_am = aliasidx_without_names(am = am, names = tparams)
      SImpl(tparams, rewrite_alias_bounds(bounds = bounds, am = type_am), rewrite_alias_trait_ref(trait_ref = trait_name, am = type_am), rewrite_alias_type_expr(te = target, am = type_am))
    },
    _ => stmt
  }
}

/// The type-expression half of the import-alias rewrite: replace every head
/// that names an import alias with the name it aliases (#1502).
fn rewrite_alias_type_expr(te: TypeExpr, am: AliasIdx) -> TypeExpr {
  match te {
    TyName(n) => match aliasidx_get(am = am, name = n) {
      Some(original) => TyName(original),
      None => te
    },
    TyApp(n, args) => {
      let m = alias_marks()
      let next_name = match aliasidx_get(am = am, name = n) {
        Some(original) => original,
        None => n
      }
      let args2 = rewrite_alias_types_ix(items = args, am = am)
      if alias_marks() == m {
        te
      } else {
        TyApp(next_name, args2)
      }
    },
    TyTuple(items) => {
      let m = alias_marks()
      let items2 = rewrite_alias_types_ix(items = items, am = am)
      if alias_marks() == m {
        te
      } else {
        TyTuple(items2)
      }
    },
    TyFn(ps, ret, eff) => {
      let m = alias_marks()
      let ps2 = rewrite_alias_types_ix(items = ps, am = am)
      let ret2 = rewrite_alias_type_expr(te = ret, am = am)
      if alias_marks() == m {
        te
      } else {
        TyFn(ps2, ret2, eff)
      }
    },
    _ => te
  }
}

export fn stmts_have_import_deep(_ stmts: Array[Stmt]) -> Bool {
  let rec stmt_has_import_deep: (Stmt) -> Bool = (stmt) -> {
    match stmt {
      SImport(path, _) => !is_builtin_iterator_serialized_boundary_path(path),
      SReExport(_, _) => true,
      SModule(_, _, inner_stmts) => stmts_have_import_deep(inner_stmts),
      _ => false
    }
  }
  let mut found = false
  let mut i = 0
  while i < Array::length(stmts) && !found {
    if stmt_has_import_deep(Array::get(stmts, at = i)) {
      found = true
    } else {
      i = i + 1
    }
  }
  found
}

/// The four stdin provider operations (#1539). Exported for the checker's
/// value-reference hook (#3833), which leaves them to the provider validator's
/// own, more specific refusal.
export fn is_stdin_provider_import_value(_ name: String) -> Bool {
  name == "Stdin::read_via_stream" || name == "StdinStream::next" || name == "StdinStream::close" || name == "StdinStream::read_chunk"
}

/// Preserve an imported provider value alias as a canonical value-position
/// marker after the import itself is dropped. The shared pre-codegen provider
/// validator then rejects the marker just like `let n = StdinStream::next`.
/// Type aliases such as `StdinStream as S` deliberately add no marker: their
/// qualified call heads are canonicalized by rewrite_alias_qualified_head.
export fn append_stdin_provider_import_alias_markers(merged: Array[Stmt], items: Array[ImportItem]) -> Unit {
  let mut i = 0
  while i < Array::length(items) {
    let item = Array::get(items, at = i)
    let original = item.name
    let alias_opt = item.alias
    match alias_opt {
      Some(_) => if is_stdin_provider_import_value(original) {
        Array::push(merged, value = SExpr(EIdent(original, -1)))
      } else {
        ()
      },
      None => ()
    }
    i = i + 1
  }
}

export fn append_non_import_stmts_without_alias_rewrite(merged: Array[Stmt], stmts: Array[Stmt]) -> Unit {
  // Even an import-free file needs impl owners normalized through its local
  // transparent aliases. The empty import map keeps every ordinary name
  // untouched while rewrite_import_alias_stmts performs that owner pass.
  let rewritten = rewrite_import_alias_stmts(stmts = stmts, aliases = empty_aliases())
  let mut i = 0
  while i < Array::length(stmts) {
    let stmt = Array::get(stmts, at = i)
    match stmt {
      SImport(path, items) => if is_builtin_iterator_serialized_boundary_path(path) {
        Array::push(merged, value = stmt)
      } else {
        append_stdin_provider_import_alias_markers(merged = merged, items = items)
      },
      SReExport(_, _) => (),
      SAliasDecl(_, _) => (),
      _ => Array::push(merged, value = Array::get(rewritten, at = i))
    }
    i = i + 1
  }
}

export fn append_import_alias_rewritten_non_import_stmts_skipping(merged: Array[Stmt], stmts: Array[Stmt], skipped_locals: Array[String]) -> Unit {
  let aliases = alias_map_without_names(aliases = collect_import_aliases(stmts), names = skipped_locals)
  let rewritten = rewrite_import_alias_stmts(stmts = stmts, aliases = aliases)
  let mut i = 0
  while i < Array::length(stmts) {
    let stmt = Array::get(stmts, at = i)
    match stmt {
      SImport(path, items) => if is_builtin_iterator_serialized_boundary_path(path) {
        Array::push(merged, value = stmt)
      } else {
        append_stdin_provider_import_alias_markers(merged = merged, items = items)
      },
      SReExport(_, _) => (),
      SAliasDecl(_, _) => (),
      _ => Array::push(merged, value = Array::get(rewritten, at = i))
    }
    i = i + 1
  }
}

export fn append_import_alias_rewritten_non_import_stmts(merged: Array[Stmt], stmts: Array[Stmt]) -> Unit {
  append_import_alias_rewritten_non_import_stmts_skipping(merged = merged, stmts = stmts, skipped_locals = empty_strings())
}

export fn rewrite_imported_value_stmt_to_local(stmt: Stmt, original: String, local: String) -> Option[Stmt] {
  let aliases = Array::slice([(original, local)], start = 0, end = 1)
  let rewrite_value: (Expr) -> Expr = (expr) -> {
    if original == local {
      expr
    } else {
      rewrite_import_alias_expr(expr = expr, aliases = aliases)
    }
  }
  match stmt {
    SLet(_, is_rec, name, ty, body) => if name == original {
      Some(SLet(false, is_rec, local, ty, rewrite_value(body)))
    } else {
      None
    },
    SLetMut(name, ty, body) => if name == original {
      Some(SLetMut(local, ty, rewrite_value(body)))
    } else {
      None
    },
    _ => None
  }
}

fn namespace_byte_is_valid(_ code: Int) -> Bool {
  (code >= 'a' && code <= 'z') || (code >= 'A' && code <= 'Z') || (code >= '0' && code <= '9') || code == '_'
}

export fn sanitize_namespace_path(_ path: String) -> String {
  // Keep valid byte spans intact instead of allocating one String and one
  // builder entry per byte. Each rejected byte still becomes one underscore.
  let out = StringBuilder::new()
  let mut span_start = 0
  let mut i = 0
  while i < String::length(path) {
    if !namespace_byte_is_valid(String::char_code_at(path, at = i)) {
      if span_start < i {
        StringBuilder::push(out, value = path[span_start: i])
      }
      StringBuilder::push(out, value = "_")
      span_start = i + 1
    }
    i = i + 1
  }
  if span_start == 0 {
    path
  } else {
    if span_start < String::length(path) {
      StringBuilder::push(out, value = path[span_start: String::length(path)])
    }
    StringBuilder::freeze(out)
  }
}

export fn namespace_private_name(path: String, name: String) -> String {
  String::concat(name, String::concat("_dep_", sanitize_namespace_path(path)))
}

/// #2205: (mangled -> original) for private TYPE and CONSTRUCTOR renames.
/// `derive(Show)` expands after the merge rename has already run, so the
/// renamed declaration is the only spelling it can see -- and it bakes that
/// spelling into the rendered string (`Point_dep_... { x: 3 }` in user
/// output). This table lets the derive generators recover the source name.
///
/// The table is scoped to ONE merged program (Codex rounds 2-3 on #2213):
/// each merge driver resets it before populating, and desugar_trait_dicts
/// clears it after the derive generators have read it. Left to accumulate
/// across compilations in a long-lived process, it would both grow without
/// bound and mis-render a LATER program's genuine type whose name equals a
/// former mangled name (`Point_dep_a_vibe` rendering as `Point`).
///
/// Accepted residual: a merge that never reaches desugar (a query helper
/// like closure_merged_stmt_count, or a check-only text merge) leaves its
/// entries behind until the next merge or desugar clears them. Mis-rendering
/// through that window needs a SUBSEQUENT single-file program that both
/// declares a type spelled exactly like one of those mangled names
/// (`X_dep_<sanitized-path>`) and derives Show on it, in the same process --
/// the growth is bounded (every driver resets on entry), and carrying the
/// mapping inside the AST instead is the invasive fix (#2205 option (c)) not
/// taken here.
let namespace_rename_originals: Array[(String, String)] = array_empty()

/// Reset the #2205 rename table. Called by each merge driver before it
/// populates, and by desugar_trait_dicts once the derive generators are done.
export fn namespace_rename_originals_reset() -> Unit {
  Array::truncate(namespace_rename_originals, length = 0)
}

/// #2205 (Codex round 4 on #2213): metadata-only replay of the private
/// type/constructor renames for a file whose merged TEXT came from a cache.
/// The merge that would have recorded the (mangled -> original) pairs never
/// runs on a cache hit, so the grouped merge replays just the recording
/// (the same collects the rename pass runs, minus any rewriting) to keep
/// derive(Show) rendering identical between cold and warm caches. Running
/// the collects on the RAW stmts is equivalent for this purpose: the value
/// rename that normally precedes them never changes a type or constructor
/// declaration name.
export fn record_namespace_rename_originals_for_file(path: String, stmts: Array[Stmt]) -> Unit {
  let namespace_suffix_box = [""]
  let exported = collect_exported_value_names(stmts)
  let type_renames = collect_private_type_renames(path = path, stmts = stmts, namespace_suffix_box = namespace_suffix_box, exported = exported)
  let _ = collect_private_ctor_renames(path = path, stmts = stmts, type_renames = type_renames, namespace_suffix_box = namespace_suffix_box, exported = exported)
}

/// How many merge renames are recorded. The table is keyed mangled -> original
/// and `namespace_rename_original` is identity for anything absent, so a caller
/// that does not already know the mangled spelling cannot tell an EMPTY table
/// from one that simply has no entry for its name. That distinction is the
/// whole property behind #2647 round 6 -- the table is built by the merge and
/// must survive every module of a per-module prelude -- so it needs an
/// observable form.
export fn namespace_rename_originals_len() -> Int {
  Array::length(namespace_rename_originals)
}

/// Immutable-by-convention metadata for an independent lowering job. The
/// order is significant: namespace_rename_original uses the last match.
export fn namespace_rename_originals_snapshot() -> Array[(String, String)] {
  let out: Array[(String, String)] = []
  for pair in namespace_rename_originals {
    Array::push(out, value = pair)
  }
  out
}

export fn namespace_rename_originals_restore(_ pairs: Array[(String, String)]) -> Unit {
  namespace_rename_originals_reset()
  for pair in pairs {
    Array::push(namespace_rename_originals, value = pair)
  }
  ()
}

fn record_namespace_rename_original(original: String, mangled: String) -> Unit {
  Array::push(namespace_rename_originals, value = (mangled, original))
}

/// The source spelling of a possibly merge-renamed type/constructor name.
/// Returns the name unchanged when it was never renamed by this process.
export fn namespace_rename_original(_ name: String) -> String {
  let mut i = 0
  let mut found = name
  while i < Array::length(namespace_rename_originals) {
    let (mangled, original) = Array::get(namespace_rename_originals, at = i)
    if mangled == name {
      found = original
    } else {
      ()
    }
    i = i + 1
  }
  found
}

/// `path`'s merge rename as a function: `name` maps to
/// `namespace_private_name(path, name)` exactly when that mangled spelling is
/// recorded as a rename of `name` itself
/// (`namespace_rename_original(mangled) == name`), and to itself otherwise.
///
/// A caller mapping many names through one file's renames used to build the
/// mangled string and scan the whole table for EVERY name, renamed or not
/// (the typed-`==` row union, ~21 MB of the self-compile heap). This walks
/// the table once per path; each call after that is one set lookup, and only
/// a name that IS renamed allocates. Last-wins like
/// `namespace_rename_original`: the table is walked from the end and only a
/// mangled spelling's LAST entry counts.
export fn namespace_private_renamer_for_path(_ path: String) -> (String) -> String {
  let renamed = MutSet::new_string()
  let n = Array::length(namespace_rename_originals)
  let suffix = if n > 0 {
    String::concat("_dep_", sanitize_namespace_path(path))
  } else {
    ""
  }
  let suffix_len = String::length(suffix)
  let seen = MutSet::new_string()
  let mut i = n - 1
  while i >= 0 {
    let (mangled, original) = Array::get(namespace_rename_originals, at = i)
    if !MutSet::has(seen, x = mangled) {
      MutSet::add(seen, x = mangled)
      if String::length(mangled) == String::length(original) + suffix_len && String::ends_with(mangled, suffix = suffix) && String::starts_with(mangled, prefix = original) {
        MutSet::add(renamed, x = original)
      }
    }
    i = i - 1
  }
  (name: String) -> if MutSet::has(renamed, x = name) {
    String::concat(name, suffix)
  } else {
    name
  }
}

fn namespace_private_name_with_suffix(namespace_suffix: String, name: String) -> String {
  String::concat(name, String::concat("_dep_", namespace_suffix))
}

fn namespace_private_name_lazy(path: String, name: String, suffix_box: Array[String]) -> String {
  let current = Array::get(suffix_box, at = 0)
  let suffix = if String::length(current) == 0 {
    let sanitized = sanitize_namespace_path(path)
    Array::set(suffix_box, at = 0, value = sanitized)
    sanitized
  } else {
    current
  }
  namespace_private_name_with_suffix(namespace_suffix = suffix, name = name)
}

export fn collect_exported_value_names(_ stmts: Array[Stmt]) -> Array[String] {
  let names = empty_strings()
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, at = i) {
      SLet(true, _, name, _, _) => if !import_alias_rewrite_string_array_contains(items = names, target = name) {
        Array::push(names, value = name)
      },
      SExport(items) => {
        let mut j = 0
        while j < Array::length(items) {
          let name = Array::get(items, at = j)
          if !import_alias_rewrite_string_array_contains(items = names, target = name) {
            Array::push(names, value = name)
          }
          j = j + 1
        }
      },
      _ => ()
    }
    i = i + 1
  }
  names
}

/// The names of types declared `export` in `stmts` (struct/enum/trait/alias/
/// suberror). A qualified method `Type::m` whose `Type` is exported is part of
/// that type's public surface, so it must NOT be module-private-renamed.
export fn collect_exported_type_names(_ stmts: Array[Stmt]) -> Array[String] {
  let names = empty_strings()
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, at = i) {
      SStruct(true, name, _, _, _, _) => Array::push(names, value = name),
      SEnum(true, name, _, _, _) => Array::push(names, value = name),
      STrait(true, name, _, _, _, _) => Array::push(names, value = name),
      STypeAlias(true, name, _, _) => Array::push(names, value = name),
      SSuberror(true, name, _) => Array::push(names, value = name),
      _ => ()
    }
    i = i + 1
  }
  names
}

/// The names of ALL types declared in `stmts` (exported or not). Used with
/// collect_exported_type_names to decide which qualified methods are private.
export fn collect_declared_type_names(_ stmts: Array[Stmt]) -> Array[String] {
  let names = empty_strings()
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, at = i) {
      SStruct(_, name, _, _, _, _) => Array::push(names, value = name),
      SEnum(_, name, _, _, _) => Array::push(names, value = name),
      STrait(_, name, _, _, _, _) => Array::push(names, value = name),
      STypeAlias(_, name, _, _) => Array::push(names, value = name),
      SSuberror(_, name, _) => Array::push(names, value = name),
      SEffectDef(_, name, _, _) => Array::push(names, value = name),
      _ => ()
    }
    i = i + 1
  }
  names
}

/// A qualified `Head::member` value (an impl/trait method `let Type::m = ..`)
/// on a PUBLIC receiver type. Such methods are resolved globally by the
/// receiver type and are referenced unqualified by that type's name, so
/// path-suffixing them in an imported module (`Strm::next` -> `Strm::next$path`)
/// would orphan them from `Strm` — breaking method dispatch and the trait /
/// `for`-iterator desugar's `Type::method` lookup. Public means the head is
/// either exported from this module OR not declared in it at all — the latter
/// covers impls on BUILTIN types (`impl Iterator for Array` desugars to a
/// non-exported `let Array::iter_length = ..` whose head "Array" no module
/// declares; #736 hit this when the prelude's builtin Iterator impls were
/// private-renamed and orphaned from the witness dispatch). Only methods whose
/// head is a type declared in this module and NOT exported keep the old
/// whole-name renaming: that private type is itself renamed and its call sites
/// are rewritten through the same value-rename map, so they stay consistent.
fn qualified_method_of_exported_type(name: String, exported_types: Array[String], declared_types: Array[String]) -> Bool {
  let idx = String::index_of(name, needle = "::")
  if idx < 0 {
    false
  } else {
    let head = String::substring(name, start = 0, end = idx)
    if import_alias_rewrite_string_array_contains(items = exported_types, target = head) {
      true
    } else {
      !import_alias_rewrite_string_array_contains(items = declared_types, target = head)
    }
  }
}

/// The private types `collect_private_type_renames` will rename: the same
/// four declaration kinds under the same `exported` test, names only.
fn collect_private_renamed_type_names(stmts: Array[Stmt], exported: Array[String]) -> Array[String] {
  let names = empty_strings()
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, at = i) {
      SEnum(false, name, _, _, _) => if !import_alias_rewrite_string_array_contains(items = exported, target = name) {
        Array::push(names, value = name)
      },
      SStruct(false, name, _, _, _, _) => if !import_alias_rewrite_string_array_contains(items = exported, target = name) {
        Array::push(names, value = name)
      },
      STypeAlias(false, name, _, _) => if !import_alias_rewrite_string_array_contains(items = exported, target = name) {
        Array::push(names, value = name)
      },
      SSuberror(false, name, _) => if !import_alias_rewrite_string_array_contains(items = exported, target = name) {
        Array::push(names, value = name)
      },
      _ => ()
    }
    i = i + 1
  }
  names
}

/// #3105: the private spelling of a module-private value.
///
/// A qualified method whose head is a private type that the type stage
/// renames (`Pt::measure`, with `Pt` becoming `Pt_dep_<path>`) takes the
/// type's mangled name as its OWNER: `Pt_dep_<path>::measure`. Every consumer
/// that finds a method from its receiver type -- the trait-dictionary builder
/// (`<Type>::<method>`), UFCS `p.measure()`, derive -- asks for exactly that
/// spelling once the type is renamed. Suffixing the whole name instead
/// (`Pt::measure_dep_<path>`) matched none of them, and the impl-owner stage
/// then rewrote the definition to `Pt_dep_<path>::measure_dep_<path>` while
/// the call sites kept `Pt::measure_dep_<path>`. Measured: a private struct
/// with a method-bearing trait impl failed `vibe build` ("add a body for
/// `measure`"), and a direct `Pt::measure(p)` reached codegen unresolved.
///
/// Anything else (a plain value, or a qualified name whose head is not a
/// renamed type, such as a private trait's) keeps the whole-name suffix.
fn private_value_rename(path: String, name: String, renamed_types: Array[String], namespace_suffix_box: Array[String]) -> String {
  let idx = String::index_of(name, needle = "::")
  if idx > 0 && import_alias_rewrite_string_array_contains(items = renamed_types, target = String::substring(name, start = 0, end = idx)) {
    let head = String::substring(name, start = 0, end = idx)
    String::concat(namespace_private_name_lazy(path = path, name = head, suffix_box = namespace_suffix_box), String::substring(name, start = idx, end = String::length(name)))
  } else {
    namespace_private_name_lazy(path = path, name = name, suffix_box = namespace_suffix_box)
  }
}

export fn collect_private_value_renames(path: String, stmts: Array[Stmt], namespace_suffix_box: Array[String], exported: Array[String]) -> Array[(String, String)] {
  let renames = empty_aliases()
  let exported_types = collect_exported_type_names(stmts)
  let declared_types = collect_declared_type_names(stmts)
  let renamed_types = collect_private_renamed_type_names(stmts = stmts, exported = exported)
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, at = i) {
      SLet(false, _, name, _, _) => if !import_alias_rewrite_string_array_contains(items = exported, target = name) && !qualified_method_of_exported_type(name = name, exported_types = exported_types, declared_types = declared_types) {
        Array::push(renames, value = (name, private_value_rename(path = path, name = name, renamed_types = renamed_types, namespace_suffix_box = namespace_suffix_box)))
      },
      SLetMut(name, _, _) => if !import_alias_rewrite_string_array_contains(items = exported, target = name) {
        Array::push(renames, value = (name, namespace_private_name_lazy(path = path, name = name, suffix_box = namespace_suffix_box)))
      },
      _ => ()
    }
    i = i + 1
  }
  renames
}

fn rewrite_private_type_expr(ty: TypeExpr, renames: Array[(String, String)]) -> TypeExpr {
  match ty {
    TyName(name) => match lookup_alias(aliases = renames, name = name) {
      Some(renamed) => TyName(renamed),
      None => ty
    },
    TyApp(name, args) => {
      let next_name = match lookup_alias(aliases = renames, name = name) {
        Some(renamed) => renamed,
        None => name
      }
      TyApp(next_name, for arg in args {
        rewrite_private_type_expr(ty = arg, renames = renames)
      })
    },
    TyFn(params, ret, effect_name) => TyFn(for param in params {
      rewrite_private_type_expr(ty = param, renames = renames)
    }, rewrite_private_type_expr(ty = ret, renames = renames), effect_name),
    TyTuple(items) => TyTuple(for item in items {
      rewrite_private_type_expr(ty = item, renames = renames)
    }),
    TyUnit => ty
  }
}

fn rewrite_private_type_opt(ty: Option[TypeExpr], renames: Array[(String, String)]) -> Option[TypeExpr] {
  match ty {
    Some(inner) => Some(rewrite_private_type_expr(ty = inner, renames = renames)),
    None => None
  }
}

fn rewrite_private_params(params: Array[(String, Option[TypeExpr])], type_renames: Array[(String, String)]) -> Array[(String, Option[TypeExpr])] {
  for param in params {
    let (name, ty) = param
    (name, rewrite_private_type_opt(ty = ty, renames = type_renames))
  }
}

fn rewrite_private_type_ctor_pat(pat: Pat, type_renames: Array[(String, String)], ctor_renames: Array[(String, String)]) -> Pat {
  match pat {
    PCtor(name, pats) => {
      // #3422: a qualified `Maybe::Some` is renamed by its bare name.
      let next_name = match lookup_alias(aliases = ctor_renames, name = pattern_ctor_base_name(name)) {
        Some(renamed) => renamed,
        None => name
      }
      PCtor(next_name, for item in pats {
        rewrite_private_type_ctor_pat(pat = item, type_renames = type_renames, ctor_renames = ctor_renames)
      })
    },
    PTuple(pats) => PTuple(for item in pats {
      rewrite_private_type_ctor_pat(pat = item, type_renames = type_renames, ctor_renames = ctor_renames)
    }),
    POr(left, right) => POr(rewrite_private_type_ctor_pat(pat = left, type_renames = type_renames, ctor_renames = ctor_renames), rewrite_private_type_ctor_pat(pat = right, type_renames = type_renames, ctor_renames = ctor_renames)),
    PStruct(name, fields) => {
      let next_name = match lookup_alias(aliases = type_renames, name = name) {
        Some(renamed) => renamed,
        None => name
      }
      PStruct(next_name, for field in fields {
        let (field_name, field_pat) = field
        (field_name, rewrite_private_type_ctor_pat(pat = field_pat, type_renames = type_renames, ctor_renames = ctor_renames))
      })
    },
    _ => pat
  }
}

fn rewrite_private_type_ctor_expr(expr: Expr, type_renames: Array[(String, String)], ctor_renames: Array[(String, String)]) -> Expr {
  match expr {
    EIdent(name, _) => match lookup_alias(aliases = ctor_renames, name = name) {
      Some(renamed) => EIdent(renamed, -1),
      None => expr
    },
    ETuple(items) => ETuple(for item in items {
      rewrite_private_type_ctor_expr(expr = item, type_renames = type_renames, ctor_renames = ctor_renames)
    }),
    EArray(items) => EArray(for item in items {
      rewrite_private_type_ctor_expr(expr = item, type_renames = type_renames, ctor_renames = ctor_renames)
    }),
    ERecord(rn, fields, targs) => {
      // #810: the struct-literal name now travels in the AST — rename it
      // alongside the type (same as PStruct below), or the checker's named
      // field validation would see the pre-rename spelling after merge.
      let next_rn = match lookup_alias(aliases = type_renames, name = rn) {
        Some(renamed) => renamed,
        None => rn
      }
      // #886: explicit struct type arguments are TypeExprs and may mention
      // renamed private types — rewrite them like any other type position.
      ERecord(next_rn, for field in fields {
        let (name, value) = field
        (name, rewrite_private_type_ctor_expr(expr = value, type_renames = type_renames, ctor_renames = ctor_renames))
      }, for ta in targs {
        rewrite_private_type_expr(ty = ta, renames = type_renames)
      })
    },
    EIf(cond, then_expr, else_expr) => EIf(rewrite_private_type_ctor_expr(expr = cond, type_renames = type_renames, ctor_renames = ctor_renames), rewrite_private_type_ctor_expr(expr = then_expr, type_renames = type_renames, ctor_renames = ctor_renames), rewrite_private_type_ctor_expr(expr = else_expr, type_renames = type_renames, ctor_renames = ctor_renames)),
    ELet(name, value, body, soff) => ELet(name, rewrite_private_type_ctor_expr(expr = value, type_renames = type_renames, ctor_renames = ctor_renames), rewrite_private_type_ctor_expr(expr = body, type_renames = type_renames, ctor_renames = alias_map_without_name(aliases = ctor_renames, name = name)), soff),
    ELetRec(name, value, body) => {
      let body_ctors = alias_map_without_name(aliases = ctor_renames, name = name)
      ELetRec(name, rewrite_private_type_ctor_expr(expr = value, type_renames = type_renames, ctor_renames = body_ctors), rewrite_private_type_ctor_expr(expr = body, type_renames = type_renames, ctor_renames = body_ctors))
    },
    ELetMut(name, value, body, soff) => ELetMut(name, rewrite_private_type_ctor_expr(expr = value, type_renames = type_renames, ctor_renames = ctor_renames), rewrite_private_type_ctor_expr(expr = body, type_renames = type_renames, ctor_renames = alias_map_without_name(aliases = ctor_renames, name = name)), soff),
    EAssign(name, value, body, target_off) => EAssign(name, rewrite_private_type_ctor_expr(expr = value, type_renames = type_renames, ctor_renames = ctor_renames), rewrite_private_type_ctor_expr(expr = body, type_renames = type_renames, ctor_renames = ctor_renames), target_off),
    EAssignOp(name, op, value, body, target_off) => EAssignOp(name, op, rewrite_private_type_ctor_expr(expr = value, type_renames = type_renames, ctor_renames = ctor_renames), rewrite_private_type_ctor_expr(expr = body, type_renames = type_renames, ctor_renames = ctor_renames), target_off),
    ESeq(left, right) => ESeq(rewrite_private_type_ctor_expr(expr = left, type_renames = type_renames, ctor_renames = ctor_renames), rewrite_private_type_ctor_expr(expr = right, type_renames = type_renames, ctor_renames = ctor_renames)),
    EMatch(scrutinee, arms) => EMatch(rewrite_private_type_ctor_expr(expr = scrutinee, type_renames = type_renames, ctor_renames = ctor_renames), for arm in arms {
      let (pat, body) = arm
      let next_pat = rewrite_private_type_ctor_pat(pat = pat, type_renames = type_renames, ctor_renames = ctor_renames)
      (next_pat, rewrite_private_type_ctor_expr(expr = body, type_renames = type_renames, ctor_renames = alias_map_without_pat(aliases = ctor_renames, pat = next_pat)))
    }),
    EHandle(body, arms) => EHandle(rewrite_private_type_ctor_expr(expr = body, type_renames = type_renames, ctor_renames = ctor_renames), for arm in arms {
      let (pat, arm_body) = arm
      let next_pat = rewrite_private_type_ctor_pat(pat = pat, type_renames = type_renames, ctor_renames = ctor_renames)
      (next_pat, rewrite_private_type_ctor_expr(expr = arm_body, type_renames = type_renames, ctor_renames = alias_map_without_pat(aliases = ctor_renames, pat = next_pat)))
    }),
    EWhile(cond, body) => EWhile(rewrite_private_type_ctor_expr(expr = cond, type_renames = type_renames, ctor_renames = ctor_renames), rewrite_private_type_ctor_expr(expr = body, type_renames = type_renames, ctor_renames = ctor_renames)),
    ELoop(params, body) => {
      let out_params = for param in params {
        let (name, init) = param
        (name, rewrite_private_type_ctor_expr(expr = init, type_renames = type_renames, ctor_renames = ctor_renames))
      }
      let mut body_ctors = ctor_renames
      let mut i = 0
      while i < Array::length(params) {
        let (name, _) = Array::get(params, at = i)
        body_ctors = alias_map_without_name(aliases = body_ctors, name = name)
        i = i + 1
      }
      ELoop(out_params, rewrite_private_type_ctor_expr(expr = body, type_renames = type_renames, ctor_renames = body_ctors))
    },
    EForIn(name, index_name, iter, body) => {
      let body_ctors = match index_name {
        Some(index_name) => alias_map_without_name(aliases = alias_map_without_name(aliases = ctor_renames, name = name), name = index_name),
        None => alias_map_without_name(aliases = ctor_renames, name = name)
      }
      EForIn(name, index_name, rewrite_private_type_ctor_expr(expr = iter, type_renames = type_renames, ctor_renames = ctor_renames), rewrite_private_type_ctor_expr(expr = body, type_renames = type_renames, ctor_renames = body_ctors))
    },
    ECall(callee, args, off, callee_resolution) => ECall(rewrite_private_type_ctor_expr(expr = callee, type_renames = type_renames, ctor_renames = ctor_renames), for arg in args {
      rewrite_private_type_ctor_expr(expr = arg, type_renames = type_renames, ctor_renames = ctor_renames)
    }, off, callee_resolution),
    EBinOp(op, left, right, boff) => EBinOp(op, rewrite_private_type_ctor_expr(expr = left, type_renames = type_renames, ctor_renames = ctor_renames), rewrite_private_type_ctor_expr(expr = right, type_renames = type_renames, ctor_renames = ctor_renames), boff),
    EUnaryOp(op, value) => EUnaryOp(op, rewrite_private_type_ctor_expr(expr = value, type_renames = type_renames, ctor_renames = ctor_renames)),
    EFn(type_params, bounds, params, ret_ty, effect, body) => EFn(type_params, bounds, rewrite_private_params(params = params, type_renames = type_renames), rewrite_private_type_opt(ty = ret_ty, renames = type_renames), effect, rewrite_private_type_ctor_expr(expr = body, type_renames = type_renames, ctor_renames = alias_map_without_params(aliases = ctor_renames, params = params))),
    EDot(obj, field, off, fdoff) => EDot(rewrite_private_type_ctor_expr(expr = obj, type_renames = type_renames, ctor_renames = ctor_renames), field, off, fdoff),
    ELabeledArg(label, name, body) => ELabeledArg(label, name, rewrite_private_type_ctor_expr(expr = body, type_renames = type_renames, ctor_renames = ctor_renames)),
    EReturn(value) => EReturn(rewrite_private_type_ctor_expr(expr = value, type_renames = type_renames, ctor_renames = ctor_renames)),
    EBreak(value) => match value {
      Some(value) => EBreak(Some(rewrite_private_type_ctor_expr(expr = value, type_renames = type_renames, ctor_renames = ctor_renames))),
      None => expr
    },
    EContinue(values) => EContinue(for value in values {
      rewrite_private_type_ctor_expr(expr = value, type_renames = type_renames, ctor_renames = ctor_renames)
    }),
    EMap(fields) => EMap(for field in fields {
      let (name, value) = field
      (name, rewrite_private_type_ctor_expr(expr = value, type_renames = type_renames, ctor_renames = ctor_renames))
    }),
    ESpread(value) => ESpread(rewrite_private_type_ctor_expr(expr = value, type_renames = type_renames, ctor_renames = ctor_renames)),
    _ => expr
  }
}

fn collect_private_type_renames(path: String, stmts: Array[Stmt], namespace_suffix_box: Array[String], exported: Array[String]) -> Array[(String, String)] {
  let renames = empty_aliases()
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, at = i) {
      SEnum(false, name, _, _, _) => if !import_alias_rewrite_string_array_contains(items = exported, target = name) {
        let mangled = namespace_private_name_lazy(path = path, name = name, suffix_box = namespace_suffix_box)
        record_namespace_rename_original(original = name, mangled = mangled)
        Array::push(renames, value = (name, mangled))
      },
      SStruct(false, name, _, _, _, _) => if !import_alias_rewrite_string_array_contains(items = exported, target = name) {
        let mangled = namespace_private_name_lazy(path = path, name = name, suffix_box = namespace_suffix_box)
        record_namespace_rename_original(original = name, mangled = mangled)
        Array::push(renames, value = (name, mangled))
      },
      STypeAlias(false, name, _, _) => if !import_alias_rewrite_string_array_contains(items = exported, target = name) {
        Array::push(renames, value = (name, namespace_private_name_lazy(path = path, name = name, suffix_box = namespace_suffix_box)))
      },
      SSuberror(false, name, _) => if !import_alias_rewrite_string_array_contains(items = exported, target = name) {
        let mangled = namespace_private_name_lazy(path = path, name = name, suffix_box = namespace_suffix_box)
        record_namespace_rename_original(original = name, mangled = mangled)
        Array::push(renames, value = (name, mangled))
      },
      _ => ()
    }
    i = i + 1
  }
  renames
}

fn collect_private_ctor_renames(path: String, stmts: Array[Stmt], type_renames: Array[(String, String)], namespace_suffix_box: Array[String], exported: Array[String]) -> Array[(String, String)] {
  let renames = empty_aliases()
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, at = i) {
      SEnum(false, type_name, _, ctors, _) => if !import_alias_rewrite_string_array_contains(items = exported, target = type_name) {
        let mut j = 0
        while j < Array::length(ctors) {
          let (ctor_name, _) = Array::get(ctors, at = j)
          let mangled = namespace_private_name_lazy(path = path, name = ctor_name, suffix_box = namespace_suffix_box)
          record_namespace_rename_original(original = ctor_name, mangled = mangled)
          Array::push(renames, value = (ctor_name, mangled))
          j = j + 1
        }
      },
      SSuberror(false, type_name, ctors) => if !import_alias_rewrite_string_array_contains(items = exported, target = type_name) {
        let mut j = 0
        while j < Array::length(ctors) {
          let (ctor_name, _) = Array::get(ctors, at = j)
          let mangled = namespace_private_name_lazy(path = path, name = ctor_name, suffix_box = namespace_suffix_box)
          record_namespace_rename_original(original = ctor_name, mangled = mangled)
          Array::push(renames, value = (ctor_name, mangled))
          j = j + 1
        }
      },
      _ => ()
    }
    i = i + 1
  }
  type_renames
  renames
}

export fn namespace_private_value_stmts(path: String, stmts: Array[Stmt]) -> Array[Stmt] {
  let namespace_suffix_box = [""]
  let exported = collect_exported_value_names(stmts)
  let renames = collect_private_value_renames(path = path, stmts = stmts, namespace_suffix_box = namespace_suffix_box, exported = exported)
  let value_renamed = if Array::length(renames) == 0 {
    stmts
  } else {
    let ram = aliasidx_build(renames)
    for stmt in stmts {
      namespace_private_stmt(stmt = stmt, ram = ram)
    }
  }
  namespace_private_type_ctor_stage(path = path, value_renamed = value_renamed, namespace_suffix_box = namespace_suffix_box, exported = exported)
}

/// #3444: the ENTRY module's private top-level values that share a name with
/// one of its own imports, namespaced as every other module's privates are.
/// The entry keeps its names bare (they are the program's surface), so a local
/// `fn g` and an imported `g` were one name in the merged program, and the
/// import ran where the checker had typed the local. A dependency module never
/// had this: its privates are always namespaced, so a sibling's own
/// declaration shadows an import there (#897). Only the colliding names move.
///
/// The new name is checked against every name the entry declares or imports,
/// and extended until it is free: `g` in `main.vibe` becomes `g_dep_main_vibe`
/// unless the entry already spells that (Codex on #3470). An EXPORTED
/// declaration cannot move, because its name is the program's surface, so
/// the pair is refused with the edit.
export fn namespace_entry_import_shadows(path: String, stmts: Array[Stmt]) -> Array[Stmt] with Exception {
  let imports = import_value_locals_with_paths(stmts)
  if Array::length(imports) == 0 {
    stmts
  } else {
    let imported = for entry in imports {
      let (local, _) = entry
      local
    }
    let exported = collect_exported_value_names(stmts)
    let declared = top_level_value_names(stmts)
    for entry in imports {
      let (local, from) = entry
      // `import { g }; export { g }` re-publishes the import: no declaration.
      if import_alias_rewrite_string_array_contains(items = exported, target = local) && import_alias_rewrite_string_array_contains(items = declared, target = local) {
        throw("`\{local}` is exported here and also imported from '\{from}': an exported declaration cannot share a name with an import -- remove `\{local}` from the import list, or import it under another name (`{ \{local} as other_name }`) [@fn=\{local}]")
      } else {
        ()
      }
    }
    let taken = declared
    for local in imported {
      Array::push(taken, value = local)
    }
    let renames = empty_aliases()
    for rename in collect_private_value_renames(path = path, stmts = stmts, namespace_suffix_box = [
      ""
    ], exported = exported) {
      let (name, mangled) = rename
      if import_alias_rewrite_string_array_contains(items = imported, target = name) {
        let mut fresh = mangled
        while import_alias_rewrite_string_array_contains(items = taken, target = fresh) {
          fresh = String::concat(fresh, "_")
        }
        Array::push(taken, value = fresh)
        Array::push(renames, value = (name, fresh))
      } else {
        ()
      }
    }
    if Array::length(renames) == 0 {
      stmts
    } else {
      let ram = aliasidx_build(renames)
      for stmt in stmts {
        namespace_private_stmt(stmt = stmt, ram = ram)
      }
    }
  }
}

/// `(local name, import path)` for each item `stmts`' top-level imports bind:
/// the item's alias, or its own name.
fn import_value_locals_with_paths(_ stmts: Array[Stmt]) -> Array[(String, String)] {
  let out: Array[(String, String)] = []
  for stmt in stmts {
    match stmt {
      SImport(from, items) => for item in items {
        Array::push(out, value = (match item.alias {
          Some(a) => a,
          None => item.name
        }, from))
      },
      _ => ()
    }
  }
  out
}

fn top_level_value_names(_ stmts: Array[Stmt]) -> Array[String] {
  let out = empty_strings()
  for stmt in stmts {
    match stmt {
      SLet(_, _, name, _, _) => Array::push(out, value = name),
      SLetMut(name, _, _) => Array::push(out, value = name),
      SExternLet(name, _) => Array::push(out, value = name),
      SFnDecl(_, name, _, _, _) => Array::push(out, value = name),
      _ => ()
    }
  }
  out
}

/// The statement as `apply_export_renames_stmts` leaves its head: the
/// definition name or export items renamed, the body shared.
export fn export_renamed_head(stmt: Stmt, exports: AliasIdx) -> Stmt {
  match stmt {
    SLet(exported, is_rec, name, ty, body) => SLet(exported, is_rec, aliasidx_rename(am = exports, name = name), ty, body),
    SFnDecl(exported, name, body, requires, ensures) => SFnDecl(exported, aliasidx_rename(am = exports, name = name), body, requires, ensures),
    SExport(items) => SExport(for item in items {
      aliasidx_rename(am = exports, name = item)
    }),
    SPositionalParams(rows) => SPositionalParams(for row in rows {
      let (decl, slots) = row
      (aliasidx_rename(am = exports, name = decl), slots)
    }),
    _ => stmt
  }
}

export fn aliasidx_rename(am: AliasIdx, name: String) -> String {
  match aliasidx_get(am = am, name = name) {
    Some(renamed) => renamed,
    None => name
  }
}

export fn alias_entries_concat(first: Array[(String, String)], later: Array[(String, String)]) -> Array[(String, String)] {
  let out = empty_aliases()
  let mut i = 0
  while i < Array::length(first) {
    Array::push(out, value = Array::get(first, at = i))
    i = i + 1
  }
  i = 0
  while i < Array::length(later) {
    Array::push(out, value = Array::get(later, at = i))
    i = i + 1
  }
  out
}

fn qualified_head_of(_ name: String) -> String {
  let qi = String::index_of(name, needle = "::")
  if qi < 0 {
    ""
  } else {
    String::substring(name, start = 0, end = qi)
  }
}

/// Whether rewriting with `first` and then with `later` answers every name
/// exactly like one rewrite with their union (see
/// `namespace_private_value_stmts_after_renames`). Every check is by the
/// spellings the walker consults: a whole identifier against the keys, and
/// the head of a qualified identifier against the keys (a trait-namespace
/// marker key would change that head rule, so no key may be one).
export fn alias_renames_compose(first: AliasIdx, later: Array[(String, String)]) -> Bool {
  let first_values = MutSet::new_string()
  let later_keys = MutSet::new_string()
  let mut ok = true
  let mut i = 0
  while ok && i < Array::length(first.entries) {
    let (key, value) = Array::get(first.entries, at = i)
    MutSet::add(first_values, x = value)
    if String::contains(key, needle = "::__vibe_trait_namespace_alias") {
      ok = false
    } else {
      i = i + 1
    }
  }
  i = 0
  while ok && i < Array::length(later) {
    let (key, _) = Array::get(later, at = i)
    MutSet::add(later_keys, x = key)
    let head = qualified_head_of(key)
    if MutMap::has(first.idx, k = key) || MutSet::has(first_values, x = key) || String::contains(key, needle = "::__vibe_trait_namespace_alias") || (head != "" && (MutMap::has(first.idx, k = head) || MutSet::has(first_values, x = head))) {
      ok = false
    } else {
      i = i + 1
    }
  }
  i = 0
  while ok && i < Array::length(first.entries) {
    let (_, value) = Array::get(first.entries, at = i)
    let head = qualified_head_of(value)
    if head != "" && MutSet::has(later_keys, x = head) {
      ok = false
    } else {
      i = i + 1
    }
  }
  ok
}

/// The type and constructor stage of `namespace_private_value_stmts`, over
/// statements whose private values are already renamed.
export fn namespace_private_type_ctor_stage(path: String, value_renamed: Array[Stmt], namespace_suffix_box: Array[String], exported: Array[String]) -> Array[Stmt] {
  let type_renames = collect_private_type_renames(path = path, stmts = value_renamed, namespace_suffix_box = namespace_suffix_box, exported = exported)
  let ctor_renames = collect_private_ctor_renames(path = path, stmts = value_renamed, type_renames = type_renames, namespace_suffix_box = namespace_suffix_box, exported = exported)
  if Array::length(type_renames) == 0 && Array::length(ctor_renames) == 0 {
    value_renamed
  } else {
    let private_enum_heads = empty_strings()
    for stmt in value_renamed {
      match stmt {
        SEnum(false, name, _, _, _) => if !import_alias_rewrite_string_array_contains(items = exported, target = name) {
          Array::push(private_enum_heads, value = name)
        },
        SSuberror(false, name, _) => if !import_alias_rewrite_string_array_contains(items = exported, target = name) {
          Array::push(private_enum_heads, value = name)
        },
        _ => ()
      }
    }
    let local_type_aliases = collect_local_type_aliases(value_renamed)
    let owner_aliases = collect_impl_method_owner_aliases(stmts = value_renamed, aliases = type_renames)
    let owner_renamed = for stmt in value_renamed {
      rewrite_impl_method_binding(stmt = stmt, owner_aliases = owner_aliases)
    }
    for stmt in owner_renamed {
      namespace_private_type_ctor_stmt(stmt = stmt, type_renames = type_renames, ctor_renames = ctor_renames, private_enum_heads = private_enum_heads, local_type_aliases = local_type_aliases)
    }
  }
}

/// #3929: apply the plan's per-provider renames of this file's exported type
/// aliases (`Alias` -> `Alias_exp_<path>`) to the declaration and to every
/// type position the file writes, the walk the private type renames use.
export fn rename_exported_type_alias_stmts(stmts: Array[Stmt], renames: Array[(String, String)]) -> Array[Stmt] {
  if Array::length(renames) == 0 {
    stmts
  } else {
    for stmt in stmts {
      // A type parameter spelled like the alias is that parameter, not the
      // alias (Codex on #3942): `struct Box[Alias] { value: Alias }`.
      let own = alias_map_without_names(aliases = renames, names = stmt_type_binder_names(stmt))
      let renamed = match stmt {
        // The private walk has no trait arm; a method signature may spell
        // the alias too (Codex on #3942).
        STrait(exported, name, supers, methods, method_tparams, tparams) => STrait(exported, name, supers, for m in methods {
          let (mname, params, ret) = m
          let mrenames = alias_map_without_names(aliases = own, names = trait_method_tparam_names(method_tparams = method_tparams, method = mname))
          (mname, for param in params {
            rewrite_private_type_expr(ty = param, renames = mrenames)
          }, rewrite_private_type_expr(ty = ret, renames = mrenames))
        }, method_tparams, tparams),
        _ => namespace_private_type_ctor_stmt(stmt = stmt, type_renames = own, ctor_renames = array_empty(), private_enum_heads = empty_strings(), local_type_aliases = array_empty())
      }
      match renamed {
        STypeAlias(exported, name, params, target) => match lookup_alias(aliases = renames, name = name) {
          Some(next) => STypeAlias(exported, next, params, target),
          None => renamed
        },
        _ => renamed
      }
    }
  }
}

/// The type parameters a top-level declaration binds over its own body.
fn stmt_type_binder_names(_ stmt: Stmt) -> Array[String] {
  let names = match stmt {
    SStruct(_, _, _, _, _, tparams) => tparams,
    SEnum(_, _, params, _, _) => params,
    STypeAlias(_, _, params, _) => params,
    SLet(_, _, _, _, EFn(tparams, _, _, _, _, _)) => tparams,
    SFnDecl(_, _, EFn(tparams, _, _, _, _, _), _, _) => tparams,
    STrait(_, _, _, _, _, tparams) => tparams,
    _ => empty_strings()
  }
  for name in names {
    let bracket = String::index_of(name, needle = "[")
    if bracket > 0 {
      String::substring(name, start = 0, end = bracket)
    } else {
      name
    }
  }
}

fn trait_method_tparam_names(method_tparams: Array[(String, Array[String], Array[(String, Array[String])])], method: String) -> Array[String] {
  let out = empty_strings()
  for row in method_tparams {
    let (name, tparams, _) = row
    if name == method {
      for t in tparams {
        Array::push(out, value = t)
      }
    }
  }
  out
}

fn namespace_private_type_ctor_stmt(stmt: Stmt, type_renames: Array[(String, String)], ctor_renames: Array[(String, String)], private_enum_heads: Array[String], local_type_aliases: Array[(String, Array[String], TypeExpr)]) -> Stmt {
  match stmt {
    SLet(exported, is_rec, name, ty, body) => SLet(exported, is_rec, name, rewrite_private_type_opt(ty = ty, renames = type_renames), rewrite_private_type_ctor_expr(expr = body, type_renames = type_renames, ctor_renames = alias_map_without_name(aliases = ctor_renames, name = name))),
    SLetMut(name, ty, body) => SLetMut(name, rewrite_private_type_opt(ty = ty, renames = type_renames), rewrite_private_type_ctor_expr(expr = body, type_renames = type_renames, ctor_renames = alias_map_without_name(aliases = ctor_renames, name = name))),
    SEnum(exported, name, params, ctors, derives) => {
      let next_name = if exported {
        name
      } else {
        match lookup_alias(aliases = type_renames, name = name) {
          Some(renamed) => renamed,
          None => name
        }
      }
      SEnum(exported, next_name, params, for ctor in ctors {
        let (ctor_name, args) = ctor
        let next_ctor = if exported {
          ctor_name
        } else {
          match lookup_alias(aliases = ctor_renames, name = ctor_name) {
            Some(renamed) => renamed,
            None => ctor_name
          }
        }
        (next_ctor, for arg in args {
          rewrite_private_type_expr(ty = arg, renames = type_renames)
        })
      }, derives)
    },
    SSuberror(exported, name, ctors) => {
      let next_name = if exported {
        name
      } else {
        match lookup_alias(aliases = type_renames, name = name) {
          Some(renamed) => renamed,
          None => name
        }
      }
      SSuberror(exported, next_name, for ctor in ctors {
        let (ctor_name, args) = ctor
        let next_ctor = if exported {
          ctor_name
        } else {
          match lookup_alias(aliases = ctor_renames, name = ctor_name) {
            Some(renamed) => renamed,
            None => ctor_name
          }
        }
        (next_ctor, for arg in args {
          rewrite_private_type_expr(ty = arg, renames = type_renames)
        })
      })
    },
    SStruct(exported, name, fields, derives, mut_fields, tparams) => {
      let next_name = if exported {
        name
      } else {
        match lookup_alias(aliases = type_renames, name = name) {
          Some(renamed) => renamed,
          None => name
        }
      }
      SStruct(exported, next_name, for field in fields {
        let (field_name, field_ty) = field
        (field_name, rewrite_private_type_expr(ty = field_ty, renames = type_renames))
      }, derives, mut_fields, tparams)
    },
    STypeAlias(exported, name, params, target) => {
      let next_name = if exported {
        name
      } else {
        match lookup_alias(aliases = type_renames, name = name) {
          Some(renamed) => renamed,
          None => name
        }
      }
      STypeAlias(exported, next_name, params, rewrite_private_type_expr(ty = target, renames = type_renames))
    },
    SQualifiedPatternRefs(rows) => SQualifiedPatternRefs(for row in rows {
      let qualifier = match lookup_alias(aliases = type_renames, name = row.0) {
        Some(renamed) => renamed,
        None => row.0
      }
      let head = local_pattern_qualifier_head(name = row.0, aliases = local_type_aliases, fuel = Array::length(local_type_aliases) + 1)
      let variant = if import_alias_rewrite_string_array_contains(items = private_enum_heads, target = head) {
        match lookup_alias(aliases = ctor_renames, name = row.1) {
          Some(renamed) => renamed,
          None => row.1
        }
      } else {
        row.1
      }
      (qualifier, variant)
    }),
    SImpl(tparams, bounds, trait_name, target) => SImpl(tparams, bounds, trait_name, rewrite_private_type_expr(ty = target, renames = alias_map_without_names(aliases = type_renames, names = tparams))),
    SExternLet(name, ty) => SExternLet(name, rewrite_private_type_expr(ty = ty, renames = type_renames)),
    STest(name, body) => STest(name, rewrite_private_type_ctor_expr(expr = body, type_renames = type_renames, ctor_renames = ctor_renames)),
    SBench(name, body) => SBench(name, rewrite_private_type_ctor_expr(expr = body, type_renames = type_renames, ctor_renames = ctor_renames)),
    SExpr(body) => SExpr(rewrite_private_type_ctor_expr(expr = body, type_renames = type_renames, ctor_renames = ctor_renames)),
    SLetPat(pat, body) => {
      let next_pat = rewrite_private_type_ctor_pat(pat = pat, type_renames = type_renames, ctor_renames = ctor_renames)
      SLetPat(next_pat, rewrite_private_type_ctor_expr(expr = body, type_renames = type_renames, ctor_renames = alias_map_without_pat(aliases = ctor_renames, pat = next_pat)))
    },
    SModule(exported, name, stmts) => SModule(exported, name, namespace_private_value_stmts(path = name, stmts = stmts)),
    SEffectDef(exported, name, params, ops) => SEffectDef(exported, name, params, for op in ops {
      let (op_name, op_params, ret_ty) = op
      (op_name, for param in op_params {
        rewrite_private_type_expr(ty = param, renames = type_renames)
      }, rewrite_private_type_expr(ty = ret_ty, renames = type_renames))
    }),
    _ => stmt
  }
}

fn namespace_private_stmt(stmt: Stmt, ram: AliasIdx) -> Stmt {
  match stmt {
    SLet(exported, is_rec, name, ty, body) => {
      let next_name = match aliasidx_get(am = ram, name = name) {
        Some(renamed) => renamed,
        None => name
      }
      SLet(exported, is_rec, next_name, ty, rewrite_alias_expr_ix(expr = body, am = ram))
    },
    SPositionalParams(rows) => SPositionalParams(for row in rows {
      let (decl, slots) = row
      match aliasidx_get(am = ram, name = decl) {
        Some(renamed) => (renamed, slots),
        None => (decl, slots)
      }
    }),
    SLetMut(name, ty, body) => {
      let next_name = match aliasidx_get(am = ram, name = name) {
        Some(renamed) => renamed,
        None => name
      }
      SLetMut(next_name, ty, rewrite_alias_expr_ix(expr = body, am = ram))
    },
    STest(name, body) => STest(name, rewrite_alias_expr_ix(expr = body, am = ram)),
    SBench(name, body) => SBench(name, rewrite_alias_expr_ix(expr = body, am = ram)),
    SExpr(body) => SExpr(rewrite_alias_expr_ix(expr = body, am = ram)),
    SLetPat(pat, body) => SLetPat(pat, rewrite_alias_expr_ix(expr = body, am = ram)),
    SModule(exported, name, stmts) => SModule(exported, name, namespace_private_value_stmts(path = name, stmts = stmts)),
    _ => stmt
  }
}
