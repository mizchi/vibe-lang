// lib/@vibe/compiler/core/import_alias_rewrite.vibe — rewrite alias expr ix.

import ./ast.vibe {
  Expr, ImportItem, ImportKind, Pat, Stmt, TypeExpr
}

import @vibe/core {
  array_empty, struct MutMap, struct MutSet
}

import @vibe/ast {
  impl_method_owner, index_site_key, is_builtin_ref_offset, trait_ref_from_key, trait_ref_key, type_param_name
}

import ./module_graph_path.vibe {
  dir_of_path
}

import ./inline_wasm_marker.vibe {
  inline_wasm_marker_name, wat_callee_names, wat_rewrite_callees
}

import ./import_alias_rewrite_pat_binds_shadowing_name.vibe {
  AliasIdx,
  alias_map_without_name,
  alias_map_without_names,
  alias_map_without_params,
  alias_map_without_pat,
  aliasidx_build,
  aliasidx_rebuild,
  aliasidx_with_pattern_ctors,
  empty_aliases,
  empty_import_refs,
  empty_strings,
  import_alias_rewrite_string_array_contains,
  import_ref_array_contains_local,
  import_ref_has_other_path_for_original,
  is_builtin_iterator_serialized_boundary_path,
  lookup_alias
}

/// #2386: the alias rewrites share every subtree they leave unchanged. This
/// counts the renames the leaf lookups have made: an arm rewrites its
/// children, and constructs a new node only when the count moved while it
/// did -- otherwise it hands back the node it was given, exactly as the
/// empty-map case always did (AST nodes are immutable; the located-parse
/// memo already hands every consumer the same deep nodes). Every rename this
/// file makes goes through `aliasidx_get`, which is what makes the count
/// exact: a rename anywhere below an arm moves it, and a lookup that hits
/// without changing a node only costs that arm a rebuild. Keep it that way --
/// a rename that bypasses `aliasidx_get` would be dropped by its parents.
let alias_rewrite_marks: Array[Int] = [0]

fn alias_marks() -> Int {
  Array::get(alias_rewrite_marks, 0)
}

/// The alias map's answer for `name`, counted when it renames.
export fn aliasidx_get(am: AliasIdx, name: String) -> Option[String] {
  match MutMap::get(am.idx, name) {
    Some(original) => {
      Array::set(alias_rewrite_marks, 0, Array::get(alias_rewrite_marks, 0) + 1)
      Some(original)
    },
    None => None
  }
}

/// `items` rewritten under `am`: the same array when no item changed, else
/// a copy that shares every unchanged item.
export fn rewrite_alias_exprs_ix(items: Array[Expr], am: AliasIdx) -> Array[Expr] {
  let mut out = items
  let mut copied = false
  let mut i = 0
  while i < Array::length(items) {
    let m = alias_marks()
    let r = rewrite_alias_expr_ix(Array::get(items, i), am)
    if copied {
      Array::push(out, r)
    } else if alias_marks() != m {
      out = Array::slice(items, 0, i)
      Array::push(out, r)
      copied = true
    } else {
      ()
    }
    i = i + 1
  }
  out
}

/// Named fields (`ERecord`, `EMap`), same sharing as `rewrite_alias_exprs_ix`.
fn rewrite_alias_named_exprs_ix(fields: Array[(String, Expr)], am: AliasIdx) -> Array[(String, Expr)] {
  let mut out = fields
  let mut copied = false
  let mut i = 0
  while i < Array::length(fields) {
    let (name, value) = Array::get(fields, i)
    let m = alias_marks()
    let r = rewrite_alias_expr_ix(value, am)
    if copied {
      Array::push(out, (name, r))
    } else if alias_marks() != m {
      out = Array::slice(fields, 0, i)
      Array::push(out, (name, r))
      copied = true
    } else {
      ()
    }
    i = i + 1
  }
  out
}

/// `match` / `handle` arms, each body under the map minus its pattern's
/// binders, same sharing as `rewrite_alias_exprs_ix`.
fn rewrite_alias_pattern_ctor(pat: Pat, am: AliasIdx) -> Pat {
  match pat {
    PCtor(name, args) => {
      let renamed = match lookup_alias(am.pattern_ctors, name) {
        Some(next) => {
          Array::set(alias_rewrite_marks, 0, alias_marks() + 1)
          next
        },
        None => name
      }
      PCtor(renamed, for arg in args {
        rewrite_alias_pattern_ctor(arg, am)
      })
    },
    PTuple(args) => PTuple(for arg in args {
      rewrite_alias_pattern_ctor(arg, am)
    }),
    POr(left, right) => POr(rewrite_alias_pattern_ctor(left, am), rewrite_alias_pattern_ctor(right, am)),
    PStruct(name, fields) => PStruct(name, for field in fields {
      (field.0, rewrite_alias_pattern_ctor(field.1, am))
    }),
    _ => pat
  }
}

fn rewrite_alias_arms_ix(arms: Array[(Pat, Expr)], am: AliasIdx) -> Array[(Pat, Expr)] {
  let mut out = arms
  let mut copied = false
  let mut i = 0
  while i < Array::length(arms) {
    let (pat, body) = Array::get(arms, i)
    let m = alias_marks()
    let next_pat = if Array::length(am.pattern_ctors) > 0 {
      rewrite_alias_pattern_ctor(pat, am)
    } else {
      pat
    }
    let r = rewrite_alias_expr_ix(body, aliasidx_without_pat(am, pat))
    if copied {
      Array::push(out, (next_pat, r))
    } else if alias_marks() != m {
      out = Array::slice(arms, 0, i)
      Array::push(out, (next_pat, r))
      copied = true
    } else {
      ()
    }
    i = i + 1
  }
  out
}

/// Type arguments (`TyApp`, `TyTuple`, `TyFn` params), same sharing.
fn rewrite_alias_types_ix(items: Array[TypeExpr], am: AliasIdx) -> Array[TypeExpr] {
  let mut out = items
  let mut copied = false
  let mut i = 0
  while i < Array::length(items) {
    let m = alias_marks()
    let r = rewrite_alias_type_expr(Array::get(items, i), am)
    if copied {
      Array::push(out, r)
    } else if alias_marks() != m {
      out = Array::slice(items, 0, i)
      Array::push(out, r)
      copied = true
    } else {
      ()
    }
    i = i + 1
  }
  out
}

/// alias_map_has_name, O(1): does binding `name` shadow any alias?
fn aliasidx_shadows(am: AliasIdx, name: String) -> Bool {
  MutSet::has(am.shadow_keys, name)
}

fn aliasidx_without_name(am: AliasIdx, name: String) -> AliasIdx {
  if aliasidx_shadows(am, name) {
    aliasidx_rebuild(am, alias_map_without_name(am.entries, name))
  } else {
    am
  }
}

fn aliasidx_without_names(am: AliasIdx, names: Array[String]) -> AliasIdx {
  let mut any = false
  let mut i = 0
  while i < Array::length(names) && !any {
    if aliasidx_shadows(am, type_param_name(Array::get(names, i))) {
      any = true
    } else {
      i = i + 1
    }
  }
  if any {
    aliasidx_rebuild(am, alias_map_without_names(am.entries, names))
  } else {
    am
  }
}

/// Bound names of a pattern (binders are plain identifiers), for the O(1)
/// shadow pre-check in aliasidx_without_pat. Same walk as pat_binds_name.
fn pat_collect_bound_names(pat: Pat, out: Array[String]) -> Int {
  match pat {
    PBind(bound) => {
      Array::push(out, bound); 0
    },
    PCtor(_, pats) => {
      let mut i = 0
      while i < Array::length(pats) {
        pat_collect_bound_names(Array::get(pats, i), out)
        i = i + 1
      }
      0
    },
    PTuple(pats) => {
      let mut i = 0
      while i < Array::length(pats) {
        pat_collect_bound_names(Array::get(pats, i), out)
        i = i + 1
      }
      0
    },
    POr(left, right) => {
      pat_collect_bound_names(left, out); pat_collect_bound_names(right, out)
    },
    PStruct(_, fields) => {
      let mut i = 0
      while i < Array::length(fields) {
        let (_, field_pat) = Array::get(fields, i)
        pat_collect_bound_names(field_pat, out)
        i = i + 1
      }
      0
    },
    _ => 0
  }
}

fn aliasidx_without_pat(am: AliasIdx, pat: Pat) -> AliasIdx {
  let bound = empty_strings()
  let _ = pat_collect_bound_names(pat, bound)
  let mut any = false
  let mut i = 0
  while i < Array::length(bound) && !any {
    if aliasidx_shadows(am, Array::get(bound, i)) {
      any = true
    } else {
      i = i + 1
    }
  }
  if any {
    aliasidx_rebuild(am, alias_map_without_pat(am.entries, pat))
  } else {
    am
  }
}

fn aliasidx_without_params(am: AliasIdx, params: Array[(String, Option[TypeExpr])]) -> AliasIdx {
  let mut any = false
  let mut i = 0
  while i < Array::length(params) && !any {
    let (param_name, _) = Array::get(params, i)
    if aliasidx_shadows(am, param_name) {
      any = true
    } else {
      i = i + 1
    }
  }
  if any {
    aliasidx_rebuild(am, alias_map_without_params(am.entries, params))
  } else {
    am
  }
}

export fn rewrite_import_alias_expr(expr: Expr, aliases: Array[(String, String)]) -> Expr {
  if Array::length(aliases) == 0 {
    expr
  } else {
    rewrite_alias_expr_ix(expr, aliasidx_build(aliases))
  }
}

/// #1259: prebuilt-index variant for callers that rewrite MANY expressions
/// against the same alias map. rewrite_import_alias_expr builds the index
/// per call, which is fine for one-shot use but was the dominant share of
/// bump-heap growth (and ~300ms of rehash churn) when normalize's module
/// flattening called it once per binding.
export fn make_import_alias_rewriter(aliases: Array[(String, String)]) -> (Expr) -> Expr {
  let am = aliasidx_build(aliases)
  (e) -> {
    rewrite_alias_expr_ix(e, am)
  }
}

/// #1502: `H::Crimson` -> `Hue::Crimson` when `H` is an import alias. `expr` is
/// returned unchanged for an unqualified name or a head that is not aliased,
/// so the caller keeps sharing the original node in the common case.
fn rewrite_alias_qualified_head(expr: Expr, name: String, am: AliasIdx) -> Expr {
  let qi = String::index_of(name, "::")
  if qi < 0 {
    expr
  } else {
    let head = String::substring(name, 0, qi)
    if MutMap::has(am.idx, String::concat(head, "::__vibe_trait_namespace_alias")) {
      // An explicit `trait Provider as Local` import owns value names under
      // `Local::*`. Unlike a type/constructor reference, `Local::method`
      // must stay local so trait namespace helpers remain distinct from a
      // separately declared `Provider::method`.
      expr
    } else {
      match aliasidx_get(am, head) {
        Some(original) => EIdent(String::concat(original, String::substring(name, qi, String::length(name))), -1),
        None => expr
      }
    }
  }
}

fn rewrite_alias_type_opt(ty: Option[TypeExpr], am: AliasIdx) -> Option[TypeExpr] {
  match ty {
    Some(inner) => Some(rewrite_alias_type_expr(inner, am)),
    None => None
  }
}

fn rewrite_alias_trait_ref(trait_ref: String, am: AliasIdx) -> String {
  match trait_ref_from_key(trait_ref) {
    Some(applied) => trait_ref_key(rewrite_alias_type_expr(applied, am)),
    None => match aliasidx_get(am, trait_ref) {
      Some(original) => original,
      None => trait_ref
    }
  }
}

fn rewrite_alias_bounds(bounds: Array[(String, Array[String])], am: AliasIdx) -> Array[(String, Array[String])] {
  for bound in bounds {
    let (param, traits) = bound
    (param, for trait_ref in traits {
      rewrite_alias_trait_ref(trait_ref, am)
    })
  }
}

fn rewrite_alias_param_types(params: Array[(String, Option[TypeExpr])], am: AliasIdx) -> Array[(String, Option[TypeExpr])] {
  for param in params {
    let (name, ty) = param
    (name, rewrite_alias_type_opt(ty, am))
  }
}

/// #2348: is this expression an inline-wasm marker call, `%wasm("<WAT>")`?
fn is_inline_wasm_marker_body(body: Expr) -> Bool {
  match body {
    ECall(callee, args, _) => is_inline_wasm_marker(callee, args),
    _ => false
  }
}

/// #2348: is this call the parser's inline-wasm marker, `%wasm("<WAT>")`?
fn is_inline_wasm_marker(callee: Expr, args: Array[Expr]) -> Bool {
  match callee {
    EIdent(cname, _) => if cname == inline_wasm_marker_name() && Array::length(args) == 1 {
      match Array::get(args, 0) {
        EString(_, _) => true,
        _ => false
      }
    } else {
      false
    },
    _ => false
  }
}

/// #2348: rename the `call $name` callees inside an inline-wasm marker's WAT
/// text with the same map the surrounding rewrite applies to identifiers, so
/// a kernel keeps calling the helper it named after the helper is renamed.
fn rewrite_wat_marker_args(args: Array[Expr], am: AliasIdx) -> Array[Expr] {
  match Array::get(args, 0) {
    EString(wat, _) => {
      let names = wat_callee_names(wat)
      let from = array_empty()
      let to = array_empty()
      let mut i = 0
      while i < Array::length(names) {
        let name = Array::get(names, i)
        match aliasidx_get(am, name) {
          Some(renamed) => {
            Array::push(from, name)
            Array::push(to, renamed)
          },
          None => ()
        }
        i = i + 1
      }
      [EString(wat_rewrite_callees(wat, from, to), -1)]
    },
    _ => args
  }
}

/// #3185: the identifier a rename-mode entry gives a program-written reference.
/// An entry that maps a spelling to ITSELF marks a reference the program's
/// private definition cannot reach -- another file's -- as the builtin's, keeping
/// its offset as a key (`index_site_key`); any other entry renames it.
fn builtin_shadow_renamed_ident(name: String, renamed: String, off: Int) -> Expr {
  if renamed == name {
    EIdent(name, index_site_key(off))
  } else {
    EIdent(renamed, off)
  }
}

export fn rewrite_alias_expr_ix(expr: Expr, am: AliasIdx) -> Expr {
  // Perf: with no aliases the rewrite is the identity, but the match below
  // still rebuilt EVERY node of the tree. Alias maps only shrink on the way
  // down (without_*), so an empty map stays empty for the whole subtree --
  // return the shared node instead of an allocated copy (AST nodes are
  // immutable; `None => expr` below already shares subtrees). #2386: with a
  // map, an arm rewrites its children first and constructs a node only when
  // `alias_marks` moved while it did -- see the counter's note above.
  if Array::length(am.entries) == 0 && Array::length(am.pattern_ctors) == 0 {
    expr
  } else {
    match expr {
      EIdent(name, off) => if am.user_refs_only {
        if is_builtin_ref_offset(off) {
          expr
        } else {
          match aliasidx_get(am, name) {
            Some(renamed) => builtin_shadow_renamed_ident(name, renamed, off),
            None => expr
          }
        }
      } else {
        match aliasidx_get(am, name) {
          Some(original) => EIdent(original, -1),
          // #1502: a qualified constructor reference carries the alias in its
          // HEAD (`import { Hue as H }` then `H::Crimson`), and the whole string
          // is never an alias key, so the lookup above misses and the alias used
          // to survive all the way to codegen -- whose constructor table is keyed
          // by the ORIGINAL unqualified name -- as `undefined variable (ident):
          // H::Crimson`. Rewriting the head here hands the rest of the pipeline
          // the same `Hue::Crimson` an unaliased import would have produced.
          None => rewrite_alias_qualified_head(expr, name, am)
        }
      },
      ETuple(items) => {
        let m = alias_marks()
        let out = rewrite_alias_exprs_ix(items, am)
        if alias_marks() == m {
          expr
        } else {
          ETuple(out)
        }
      },
      EArray(items) => {
        let m = alias_marks()
        let out = rewrite_alias_exprs_ix(items, am)
        if alias_marks() == m {
          expr
        } else {
          EArray(out)
        }
      },
      ERecord(rn, fields, targs) => {
        let m = alias_marks()
        let out = rewrite_alias_named_exprs_ix(fields, am)
        if alias_marks() == m {
          expr
        } else {
          ERecord(rn, out, targs)
        }
      },
      EIf(cond, then_expr, else_expr) => {
        let m = alias_marks()
        let c2 = rewrite_alias_expr_ix(cond, am)
        let t2 = rewrite_alias_expr_ix(then_expr, am)
        let e2 = rewrite_alias_expr_ix(else_expr, am)
        if alias_marks() == m {
          expr
        } else {
          EIf(c2, t2, e2)
        }
      },
      ELet(name, value, body, soff) => {
        let m = alias_marks()
        let v2 = rewrite_alias_expr_ix(value, am)
        let b2 = rewrite_alias_expr_ix(body, aliasidx_without_name(am, name))
        if alias_marks() == m {
          expr
        } else {
          ELet(name, v2, b2, soff)
        }
      },
      ELetRec(name, value, body) => {
        let body_aliases = aliasidx_without_name(am, name)
        let m = alias_marks()
        let v2 = rewrite_alias_expr_ix(value, body_aliases)
        let b2 = rewrite_alias_expr_ix(body, body_aliases)
        if alias_marks() == m {
          expr
        } else {
          ELetRec(name, v2, b2)
        }
      },
      ELetMut(name, value, body, soff) => {
        let m = alias_marks()
        let v2 = rewrite_alias_expr_ix(value, am)
        let b2 = rewrite_alias_expr_ix(body, aliasidx_without_name(am, name))
        if alias_marks() == m {
          expr
        } else {
          ELetMut(name, v2, b2, soff)
        }
      },
      EAssign(name, value, body) => {
        let m = alias_marks()
        let v2 = rewrite_alias_expr_ix(value, am)
        let b2 = rewrite_alias_expr_ix(body, am)
        if alias_marks() == m {
          expr
        } else {
          EAssign(name, v2, b2)
        }
      },
      EAssignOp(name, op, value, body) => {
        let m = alias_marks()
        let v2 = rewrite_alias_expr_ix(value, am)
        let b2 = rewrite_alias_expr_ix(body, am)
        if alias_marks() == m {
          expr
        } else {
          EAssignOp(name, op, v2, b2)
        }
      },
      ESeq(left, right) => {
        let m = alias_marks()
        let l2 = rewrite_alias_expr_ix(left, am)
        let r2 = rewrite_alias_expr_ix(right, am)
        if alias_marks() == m {
          expr
        } else {
          ESeq(l2, r2)
        }
      },
      EMatch(scrutinee, arms) => {
        let m = alias_marks()
        let s2 = rewrite_alias_expr_ix(scrutinee, am)
        let arms2 = rewrite_alias_arms_ix(arms, am)
        if alias_marks() == m {
          expr
        } else {
          EMatch(s2, arms2)
        }
      },
      EHandle(body, arms) => {
        let m = alias_marks()
        let b2 = rewrite_alias_expr_ix(body, am)
        let arms2 = rewrite_alias_arms_ix(arms, am)
        if alias_marks() == m {
          expr
        } else {
          EHandle(b2, arms2)
        }
      },
      EWhile(cond, body) => {
        let m = alias_marks()
        let c2 = rewrite_alias_expr_ix(cond, am)
        let b2 = rewrite_alias_expr_ix(body, am)
        if alias_marks() == m {
          expr
        } else {
          EWhile(c2, b2)
        }
      },
      ELoop(params, body) => {
        let mut body_aliases = am
        let mut i = 0
        while i < Array::length(params) {
          let (name, _) = Array::get(params, i)
          body_aliases = aliasidx_without_name(body_aliases, name)
          i = i + 1
        }
        let m = alias_marks()
        let out_params = rewrite_alias_named_exprs_ix(params, am)
        let b2 = rewrite_alias_expr_ix(body, body_aliases)
        if alias_marks() == m {
          expr
        } else {
          ELoop(out_params, b2)
        }
      },
      EForIn(name, index_name, iter, body) => {
        let body_aliases = match index_name {
          Some(index_name) => aliasidx_without_name(aliasidx_without_name(am, name), index_name),
          None => aliasidx_without_name(am, name)
        }
        let m = alias_marks()
        let i2 = rewrite_alias_expr_ix(iter, am)
        let b2 = rewrite_alias_expr_ix(body, body_aliases)
        if alias_marks() == m {
          expr
        } else {
          EForIn(name, index_name, i2, b2)
        }
      },
      // #2348: an inline-wasm body is `%wasm("<WAT text>")`, and a
      // `(call $helper ...)` inside that text names a fn of this module. The
      // generic rewrite below cannot see it -- the text is an EString -- so a
      // private helper's DEFINITION was renamed by the merge while the
      // `$helper` token was left pointing at a name that no longer existed.
      ECall(callee, args, off) => if is_inline_wasm_marker(callee, args) {
        let m = alias_marks()
        let c2 = rewrite_alias_expr_ix(callee, am)
        let a2 = rewrite_wat_marker_args(args, am)
        if alias_marks() == m {
          expr
        } else {
          ECall(c2, a2, off)
        }
      } else {
        let m = alias_marks()
        let c2 = rewrite_alias_expr_ix(callee, am)
        let a2 = rewrite_alias_exprs_ix(args, am)
        if alias_marks() == m {
          expr
        } else {
          ECall(c2, a2, off)
        }
      },
      EBinOp(op, left, right, boff) => {
        let m = alias_marks()
        let l2 = rewrite_alias_expr_ix(left, am)
        let r2 = rewrite_alias_expr_ix(right, am)
        if alias_marks() == m {
          expr
        } else {
          EBinOp(op, l2, r2, boff)
        }
      },
      EUnaryOp(op, value) => {
        let m = alias_marks()
        let v2 = rewrite_alias_expr_ix(value, am)
        if alias_marks() == m {
          expr
        } else {
          EUnaryOp(op, v2)
        }
      },
      EFn(type_params, bounds, params, ret_ty, effect, body) => {
        // Type formals shadow imported TYPE aliases, independently of value
        // parameters shadowing imported VALUE aliases. Preserve both
        // namespaces while canonicalizing imported contract aliases in fn
        // parameter and return annotations (#1539 StdinStream as S).
        let type_am = aliasidx_without_names(am, type_params)
        // #2348: a WAT body's `$name` callees are wasm FUNCTION names, a
        // namespace of their own -- `fn caller(helper: Int) = wasm"(call
        // $helper (local.get $helper))"` calls the fn and reads the param, and
        // the assembler already keeps those apart. So the marker body is
        // rewritten with the UNSHADOWED map: passing it the params-removed one
        // left the callee spelled for a definition the merge had renamed.
        let body_am = if is_inline_wasm_marker_body(body) {
          am
        } else {
          aliasidx_without_params(am, params)
        }
        let m = alias_marks()
        let bounds2 = rewrite_alias_bounds(bounds, type_am)
        let params2 = rewrite_alias_param_types(params, type_am)
        let ret2 = rewrite_alias_type_opt(ret_ty, type_am)
        let b2 = rewrite_alias_expr_ix(body, body_am)
        if alias_marks() == m {
          expr
        } else {
          EFn(type_params, bounds2, params2, ret2, effect, b2)
        }
      },
      // #897: `mod.x` written against a qualified-import namespace (`import
      // ... as mod only { x }`) is encoded as the alias key "mod.x" -- see
      // qualify_import_items in lib/@vibe/parser/parser.vibe. A real
      // identifier can never contain '.', so this lookup only ever hits for
      // that desugaring; anything else falls through to the ordinary EDot
      // rewrite (ordinary struct/record field access).
      EDot(obj, field, off, fdoff) => {
        let namespaced = match obj {
          EIdent(ns, _) => aliasidx_get(am, String::concat(ns, String::concat(".", field))),
          _ => None
        }
        match namespaced {
          Some(original) => EIdent(original, -1),
          None => {
            let m = alias_marks()
            let o2 = rewrite_alias_expr_ix(obj, am)
            if alias_marks() == m {
              expr
            } else {
              EDot(o2, field, off, fdoff)
            }
          }
        }
      },
      ELabeledArg(label, name, body) => {
        let m = alias_marks()
        let b2 = rewrite_alias_expr_ix(body, am)
        if alias_marks() == m {
          expr
        } else {
          ELabeledArg(label, name, b2)
        }
      },
      EReturn(value) => {
        let m = alias_marks()
        let v2 = rewrite_alias_expr_ix(value, am)
        if alias_marks() == m {
          expr
        } else {
          EReturn(v2)
        }
      },
      EBreak(value) => match value {
        Some(value) => {
          let m = alias_marks()
          let v2 = rewrite_alias_expr_ix(value, am)
          if alias_marks() == m {
            expr
          } else {
            EBreak(Some(v2))
          }
        },
        None => expr
      },
      EContinue(values) => {
        let m = alias_marks()
        let out = rewrite_alias_exprs_ix(values, am)
        if alias_marks() == m {
          expr
        } else {
          EContinue(out)
        }
      },
      EMap(fields) => {
        let m = alias_marks()
        let out = rewrite_alias_named_exprs_ix(fields, am)
        if alias_marks() == m {
          expr
        } else {
          EMap(out)
        }
      },
      ESpread(value) => {
        let m = alias_marks()
        let v2 = rewrite_alias_expr_ix(value, am)
        if alias_marks() == m {
          expr
        } else {
          ESpread(v2)
        }
      },
      _ => expr
    }
  }
}

export fn collect_import_aliases(stmts: Array[Stmt]) -> Array[(String, String)] {
  let aliases = empty_aliases()
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SImport(raw_path, items) => if !is_builtin_iterator_serialized_boundary_path(raw_path) {
        let mut j = 0
        while j < Array::length(items) {
          let item = Array::get(items, j)
          let original = item.name
          let alias_opt = item.alias
          match alias_opt {
            Some(alias) => if alias != original {
              Array::push(aliases, (alias, original))
            },
            None => ()
          }
          j = j + 1
        }
      },
      _ => ()
    }
    i = i + 1
  }
  aliases
}

export fn collect_import_refs(stmts: Array[Stmt]) -> Array[(String, String, String)] {
  let refs = empty_import_refs()
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SImport(raw_path, items) => if !is_builtin_iterator_serialized_boundary_path(raw_path) {
        let mut j = 0
        while j < Array::length(items) {
          let item = Array::get(items, j)
          let original = item.name
          let alias_opt = item.alias
          let local = match alias_opt {
            Some(alias) => alias,
            None => original
          }
          Array::push(refs, (raw_path, original, local))
          j = j + 1
        }
      },
      _ => ()
    }
    i = i + 1
  }
  refs
}

export fn collect_import_alias_collision_refs(stmts: Array[Stmt]) -> Array[(String, String, String)] {
  let refs = collect_import_refs(stmts)
  let out = empty_import_refs()
  let mut i = 0
  while i < Array::length(refs) {
    let (raw_path, original, local) = Array::get(refs, i)
    if import_ref_has_other_path_for_original(refs, raw_path, original) && !import_ref_array_contains_local(out, local) {
      Array::push(out, (raw_path, original, local))
    }
    i = i + 1
  }
  out
}

export fn collect_import_alias_collision_locals(stmts: Array[Stmt]) -> Array[String] {
  let refs = collect_import_alias_collision_refs(stmts)
  let out = empty_strings()
  let mut i = 0
  while i < Array::length(refs) {
    let (_, _, local) = Array::get(refs, i)
    if !import_alias_rewrite_string_array_contains(out, local) {
      Array::push(out, local)
    }
    i = i + 1
  }
  out
}

export fn rewrite_import_alias_stmt(stmt: Stmt, aliases: Array[(String, String)]) -> Stmt {
  rewrite_alias_stmt_ix(stmt, aliasidx_build(aliases))
}

/// Parser-generated impl methods carry the impl target in their internal
/// owner. Rewriting an imported type alias in `SImpl` therefore also has to
/// rename the following method declarations; otherwise trait resolution asks
/// for the canonical owner while codegen only has the source-spelled owner.
fn collect_impl_method_owner_aliases(stmts: Array[Stmt], aliases: Array[(String, String)]) -> Array[(String, String)] {
  let out = empty_aliases()
  let am = aliasidx_build(aliases)
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SImpl(tparams, _, trait_name, target) => {
        let type_am = aliasidx_without_names(am, tparams)
        let rewritten_trait = rewrite_alias_trait_ref(trait_name, type_am)
        let rewritten_target = rewrite_alias_type_expr(target, type_am)
        let source_owner = impl_method_owner(tparams, trait_name, target)
        let rewritten_owner = impl_method_owner(tparams, rewritten_trait, rewritten_target)
        if source_owner != rewritten_owner {
          Array::push(out, (source_owner, rewritten_owner))
        } else {
          ()
        }
      },
      _ => ()
    }
    i = i + 1
  }
  out
}

fn rewrite_impl_method_binding_name(name: String, owner_aliases: Array[(String, String)]) -> String {
  let mut out = name
  let mut i = 0
  let mut found = false
  while i < Array::length(owner_aliases) && !found {
    let (source_owner, rewritten_owner) = Array::get(owner_aliases, i)
    let prefix = String::concat(source_owner, "::")
    if String::starts_with(name, prefix) {
      out = String::concat(rewritten_owner, String::substring(name, String::length(source_owner), String::length(name)))
      found = true
    } else {
      i = i + 1
    }
  }
  out
}

fn rewrite_impl_method_binding(stmt: Stmt, owner_aliases: Array[(String, String)]) -> Stmt {
  match stmt {
    SLet(exported, is_rec, name, ty, body) => SLet(exported, is_rec, rewrite_impl_method_binding_name(name, owner_aliases), ty, body),
    SFnDecl(exported, name, body, requires, ensures) => SFnDecl(exported, rewrite_impl_method_binding_name(name, owner_aliases), body, requires, ensures),
    _ => stmt
  }
}

export fn collect_local_type_aliases(stmts: Array[Stmt]) -> Array[(String, Array[String], TypeExpr)] {
  let out = []
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      STypeAlias(_, name, params, target) => Array::push(out, (name, params, target)),
      _ => ()
    }
    i = i + 1
  }
  out
}

fn lookup_local_type_alias(aliases: Array[(String, Array[String], TypeExpr)], name: String) -> Option[(Array[String], TypeExpr)] {
  let mut i = 0
  let mut found = None
  while i < Array::length(aliases) {
    let (alias_name, params, target) = Array::get(aliases, i)
    if alias_name == name {
      found = Some((params, target))
      i = Array::length(aliases)
    } else {
      i = i + 1
    }
  }
  found
}

fn local_alias_arg(params: Array[String], args: Array[TypeExpr], name: String) -> Option[TypeExpr] {
  let mut i = 0
  let mut found = None
  while i < Array::length(params) {
    if type_param_name(Array::get(params, i)) == name && i < Array::length(args) {
      found = Some(Array::get(args, i))
      i = Array::length(params)
    } else {
      i = i + 1
    }
  }
  found
}

fn substitute_local_alias_target(target: TypeExpr, params: Array[String], args: Array[TypeExpr]) -> TypeExpr {
  match target {
    TyName(name) => match local_alias_arg(params, args, name) {
      Some(arg) => arg,
      None => target
    },
    TyApp(name, items) => TyApp(name, for item in items {
      substitute_local_alias_target(item, params, args)
    }),
    TyFn(fn_params, ret, effect) => TyFn(for param in fn_params {
      substitute_local_alias_target(param, params, args)
    }, substitute_local_alias_target(ret, params, args), effect),
    TyTuple(items) => TyTuple(for item in items {
      substitute_local_alias_target(item, params, args)
    }),
    TyUnit => target
  }
}

fn normalize_local_alias_target_with_fuel(target: TypeExpr, aliases: Array[(String, Array[String], TypeExpr)], fuel: Int) -> TypeExpr {
  if fuel <= 0 {
    target
  } else match target {
    TyName(name) => match lookup_local_type_alias(aliases, name) {
      Some(alias) => {
        let (params, alias_target) = alias
        if Array::length(params) == 0 {
          normalize_local_alias_target_with_fuel(alias_target, aliases, fuel - 1)
        } else {
          target
        }
      },
      None => target
    },
    TyApp(name, args) => match lookup_local_type_alias(aliases, name) {
      Some(alias) => {
        let (params, alias_target) = alias
        if Array::length(params) == Array::length(args) {
          normalize_local_alias_target_with_fuel(substitute_local_alias_target(alias_target, params, args), aliases, fuel - 1)
        } else {
          target
        }
      },
      None => TyApp(name, for arg in args {
        normalize_local_alias_target_with_fuel(arg, aliases, fuel - 1)
      })
    },
    TyFn(params, ret, effect) => TyFn(for param in params {
      normalize_local_alias_target_with_fuel(param, aliases, fuel - 1)
    }, normalize_local_alias_target_with_fuel(ret, aliases, fuel - 1), effect),
    TyTuple(items) => TyTuple(for item in items {
      normalize_local_alias_target_with_fuel(item, aliases, fuel - 1)
    }),
    TyUnit => target
  }
}

fn normalize_local_alias_target(target: TypeExpr, aliases: Array[(String, Array[String], TypeExpr)]) -> TypeExpr {
  normalize_local_alias_target_with_fuel(target, aliases, Array::length(aliases) + 1)
}

/// Pattern qualification needs the nominal head, even when a local alias
/// applies type arguments that the constructor pattern does not spell.
export fn local_pattern_qualifier_head(name: String, aliases: Array[(String, Array[String], TypeExpr)], fuel: Int) -> String {
  if fuel <= 0 {
    name
  } else match lookup_local_type_alias(aliases, name) {
    Some(alias) => {
      let next = match alias.1 {
        TyName(head) => head,
        TyApp(head, _) => head,
        _ => name
      }
      if next == name {
        name
      } else {
        local_pattern_qualifier_head(next, aliases, fuel - 1)
      }
    },
    None => name
  }
}

fn collect_local_impl_method_owner_aliases(stmts: Array[Stmt], aliases: Array[(String, Array[String], TypeExpr)]) -> Array[(String, String)] {
  let out = empty_aliases()
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SImpl(tparams, _, trait_name, target) => {
        let normalized_target = normalize_local_alias_target(target, aliases)
        let source_owner = impl_method_owner(tparams, trait_name, target)
        let normalized_owner = impl_method_owner(tparams, trait_name, normalized_target)
        if source_owner != normalized_owner {
          Array::push(out, (source_owner, normalized_owner))
        } else {
          ()
        }
      },
      _ => ()
    }
    i = i + 1
  }
  out
}

fn rewrite_local_alias_impl_stmt(stmt: Stmt, aliases: Array[(String, Array[String], TypeExpr)], owner_aliases: Array[(String, String)]) -> Stmt {
  match rewrite_impl_method_binding(stmt, owner_aliases) {
    SImpl(tparams, bounds, trait_name, target) => SImpl(tparams, bounds, trait_name, normalize_local_alias_target(target, aliases)),
    rewritten => rewritten
  }
}

export fn rewrite_import_alias_stmts(stmts: Array[Stmt], aliases: Array[(String, String)]) -> Array[Stmt] {
  rewrite_import_alias_stmts_with_pattern_ctors(stmts, aliases, [])
}

export fn rewrite_import_alias_stmts_with_pattern_ctors(stmts: Array[Stmt], aliases: Array[(String, String)], pattern_ctors: Array[(String, String)]) -> Array[Stmt] {
  let owner_aliases = collect_impl_method_owner_aliases(stmts, aliases)
  let combined = empty_aliases()
  let mut ai = 0
  while ai < Array::length(aliases) {
    Array::push(combined, Array::get(aliases, ai))
    ai = ai + 1
  }
  let mut oi = 0
  while oi < Array::length(owner_aliases) {
    Array::push(combined, Array::get(owner_aliases, oi))
    oi = oi + 1
  }
  let mut ti = 0
  while ti < Array::length(stmts) {
    match Array::get(stmts, ti) {
      SImport(raw_path, items) => if !is_builtin_iterator_serialized_boundary_path(raw_path) {
        let mut tj = 0
        while tj < Array::length(items) {
          let item = Array::get(items, tj)
          match (item.kind, item.alias) {
            (Some(ImportTrait), Some(alias)) => Array::push(combined, (String::concat(alias, "::__vibe_trait_namespace_alias"), alias)),
            _ => ()
          }
          tj = tj + 1
        }
      },
      _ => ()
    }
    ti = ti + 1
  }
  // Explicit trait imports materialize local namespace wrappers such as
  // `Iter::map`. They are real value bindings, not type references to rewrite
  // back to `Iterator::map`. Add exact self-mappings before walking bodies so
  // those calls remain local while ordinary `Iter` type occurrences and
  // unbound qualified constructors still canonicalize through the head alias.
  let mut bi = 0
  while bi < Array::length(stmts) {
    let bound_name = match Array::get(stmts, bi) {
      SLet(_, _, name, _, _) => name,
      SLetMut(name, _, _) => name,
      SExternLet(name, _) => name,
      SFnDecl(_, name, _, _, _) => name,
      _ => ""
    }
    let qi = String::index_of(bound_name, "::")
    if qi > 0 {
      let head = String::substring(bound_name, 0, qi)
      if lookup_alias(aliases, head) is Some(_) {
        Array::push(combined, (bound_name, bound_name))
      } else {
        ()
      }
    } else {
      ()
    }
    bi = bi + 1
  }
  let am = aliasidx_with_pattern_ctors(aliasidx_build(combined), pattern_ctors)
  let imported = for stmt in stmts {
    rewrite_alias_stmt_ix(rewrite_impl_method_binding(stmt, owner_aliases), am)
  }
  let local_aliases = collect_local_type_aliases(imported)
  let local_owner_aliases = collect_local_impl_method_owner_aliases(imported, local_aliases)
  for stmt in imported {
    rewrite_local_alias_impl_stmt(stmt, local_aliases, local_owner_aliases)
  }
}

fn rewrite_alias_stmt_ix(stmt: Stmt, am: AliasIdx) -> Stmt {
  match stmt {
    SLet(exported, is_rec, name, ty, body) => SLet(exported, is_rec, name, rewrite_alias_type_opt(ty, am), rewrite_alias_expr_ix(body, aliasidx_without_name(am, name))),
    SLetMut(name, ty, body) => SLetMut(name, rewrite_alias_type_opt(ty, am), rewrite_alias_expr_ix(body, aliasidx_without_name(am, name))),
    STest(name, body) => STest(name, rewrite_alias_expr_ix(body, am)),
    SBench(name, body) => SBench(name, rewrite_alias_expr_ix(body, am)),
    SExpr(body) => SExpr(rewrite_alias_expr_ix(body, am)),
    SLetPat(pat, body) => SLetPat(if Array::length(am.pattern_ctors) > 0 {
      rewrite_alias_pattern_ctor(pat, am)
    } else {
      pat
    }, rewrite_alias_expr_ix(body, am)),
    SQualifiedPatternRefs(rows) => SQualifiedPatternRefs(for row in rows {
      let variant = match lookup_alias(am.pattern_ctors, row.1) {
        Some(renamed) => renamed,
        None => row.1
      }
      (row.0, variant)
    }),
    SModule(exported, name, stmts) => {
      SModule(exported, name, rewrite_import_alias_stmts(stmts, collect_import_aliases(stmts)))
    },
    // #1502: an import alias used as a type-alias TARGET (`import { Attempt as
    // Att }` then `type Att2[T] = Att[T]`). The expression arm above already
    // normalizes an alias head in a constructor reference; without the type
    // side in step, `Att2` resolves only as far as `Att` and `Att2::Good`
    // reaches codegen still qualified.
    // The alias's own formals are BOUND names, so they are dropped from the
    // map before the target is rewritten -- the same discipline the expression
    // arms above apply with `aliasidx_without_name` / `aliasidx_without_params`.
    // With `import { Hue as T }` in scope, `type Box[T] = T` must keep its `T`.
    //
    // Note this does NOT by itself make that program correct: the checker's own
    // `STypeAlias` arm resolves the target against a `defs` where the import
    // already bound `T`, and captures it there. That capture predates this
    // rewrite (verified by A/B against origin/main, which has no type-side
    // rewrite at all) and is tracked separately -- what this guard buys is that
    // the rewrite is not a SECOND, independent source of the same bug.
    STypeAlias(exported, name, params, target) => STypeAlias(exported, name, params, rewrite_alias_type_expr(target, aliasidx_without_names(am, params))),
    SImpl(tparams, bounds, trait_name, target) => {
      let type_am = aliasidx_without_names(am, tparams)
      SImpl(tparams, rewrite_alias_bounds(bounds, type_am), rewrite_alias_trait_ref(trait_name, type_am), rewrite_alias_type_expr(target, type_am))
    },
    _ => stmt
  }
}

/// The type-expression half of the import-alias rewrite: replace every head
/// that names an import alias with the name it aliases (#1502).
fn rewrite_alias_type_expr(te: TypeExpr, am: AliasIdx) -> TypeExpr {
  match te {
    TyName(n) => match aliasidx_get(am, n) {
      Some(original) => TyName(original),
      None => te
    },
    TyApp(n, args) => {
      let m = alias_marks()
      let next_name = match aliasidx_get(am, n) {
        Some(original) => original,
        None => n
      }
      let args2 = rewrite_alias_types_ix(args, am)
      if alias_marks() == m {
        te
      } else {
        TyApp(next_name, args2)
      }
    },
    TyTuple(items) => {
      let m = alias_marks()
      let items2 = rewrite_alias_types_ix(items, am)
      if alias_marks() == m {
        te
      } else {
        TyTuple(items2)
      }
    },
    TyFn(ps, ret, eff) => {
      let m = alias_marks()
      let ps2 = rewrite_alias_types_ix(ps, am)
      let ret2 = rewrite_alias_type_expr(ret, am)
      if alias_marks() == m {
        te
      } else {
        TyFn(ps2, ret2, eff)
      }
    },
    _ => te
  }
}

export fn stmts_have_import_deep(stmts: Array[Stmt]) -> Bool {
  let rec stmt_has_import_deep: (Stmt) -> Bool = (stmt) -> {
    match stmt {
      SImport(path, _) => !is_builtin_iterator_serialized_boundary_path(path),
      SReExport(_, _) => true,
      SModule(_, _, inner_stmts) => stmts_have_import_deep(inner_stmts),
      _ => false
    }
  }
  let mut found = false
  let mut i = 0
  while i < Array::length(stmts) && !found {
    if stmt_has_import_deep(Array::get(stmts, i)) {
      found = true
    } else {
      i = i + 1
    }
  }
  found
}

fn is_stdin_provider_import_value(name: String) -> Bool {
  name == "Stdin::read_via_stream" || name == "StdinStream::next" || name == "StdinStream::close" || name == "StdinStream::read_chunk"
}

/// Preserve an imported provider value alias as a canonical value-position
/// marker after the import itself is dropped. The shared pre-codegen provider
/// validator then rejects the marker just like `let n = StdinStream::next`.
/// Type aliases such as `StdinStream as S` deliberately add no marker: their
/// qualified call heads are canonicalized by rewrite_alias_qualified_head.
export fn append_stdin_provider_import_alias_markers(merged: Array[Stmt], items: Array[ImportItem]) -> Unit {
  let mut i = 0
  while i < Array::length(items) {
    let item = Array::get(items, i)
    let original = item.name
    let alias_opt = item.alias
    match alias_opt {
      Some(_) => if is_stdin_provider_import_value(original) {
        Array::push(merged, SExpr(EIdent(original, -1)))
      } else {
        ()
      },
      None => ()
    }
    i = i + 1
  }
}

export fn append_non_import_stmts_without_alias_rewrite(merged: Array[Stmt], stmts: Array[Stmt]) -> Unit {
  // Even an import-free file needs impl owners normalized through its local
  // transparent aliases. The empty import map keeps every ordinary name
  // untouched while rewrite_import_alias_stmts performs that owner pass.
  let rewritten = rewrite_import_alias_stmts(stmts, empty_aliases())
  let mut i = 0
  while i < Array::length(stmts) {
    let stmt = Array::get(stmts, i)
    match stmt {
      SImport(path, items) => if is_builtin_iterator_serialized_boundary_path(path) {
        Array::push(merged, stmt)
      } else {
        append_stdin_provider_import_alias_markers(merged, items)
      },
      SReExport(_, _) => (),
      SAliasDecl(_, _) => (),
      _ => Array::push(merged, Array::get(rewritten, i))
    }
    i = i + 1
  }
}

export fn append_import_alias_rewritten_non_import_stmts_skipping(merged: Array[Stmt], stmts: Array[Stmt], skipped_locals: Array[String]) -> Unit {
  let aliases = alias_map_without_names(collect_import_aliases(stmts), skipped_locals)
  let rewritten = rewrite_import_alias_stmts(stmts, aliases)
  let mut i = 0
  while i < Array::length(stmts) {
    let stmt = Array::get(stmts, i)
    match stmt {
      SImport(path, items) => if is_builtin_iterator_serialized_boundary_path(path) {
        Array::push(merged, stmt)
      } else {
        append_stdin_provider_import_alias_markers(merged, items)
      },
      SReExport(_, _) => (),
      SAliasDecl(_, _) => (),
      _ => Array::push(merged, Array::get(rewritten, i))
    }
    i = i + 1
  }
}

export fn append_import_alias_rewritten_non_import_stmts(merged: Array[Stmt], stmts: Array[Stmt]) -> Unit {
  append_import_alias_rewritten_non_import_stmts_skipping(merged, stmts, empty_strings())
}

export fn rewrite_imported_value_stmt_to_local(stmt: Stmt, original: String, local: String) -> Option[Stmt] {
  let aliases = Array::slice([(original, local)], 0, 1)
  let rewrite_value: (Expr) -> Expr = (expr) -> {
    if original == local {
      expr
    } else {
      rewrite_import_alias_expr(expr, aliases)
    }
  }
  match stmt {
    SLet(_, is_rec, name, ty, body) => if name == original {
      Some(SLet(false, is_rec, local, ty, rewrite_value(body)))
    } else {
      None
    },
    SLetMut(name, ty, body) => if name == original {
      Some(SLetMut(local, ty, rewrite_value(body)))
    } else {
      None
    },
    _ => None
  }
}

fn namespace_byte_is_valid(code: Int) -> Bool {
  (code >= 'a' && code <= 'z') || (code >= 'A' && code <= 'Z') || (code >= '0' && code <= '9') || code == '_'
}

export fn sanitize_namespace_path(path: String) -> String {
  // Keep valid byte spans intact instead of allocating one String and one
  // builder entry per byte. Each rejected byte still becomes one underscore.
  let out = StringBuilder::new()
  let mut span_start = 0
  let mut i = 0
  while i < String::length(path) {
    if !namespace_byte_is_valid(String::char_code_at(path, i)) {
      if span_start < i {
        StringBuilder::push(out, path[span_start: i])
      }
      StringBuilder::push(out, "_")
      span_start = i + 1
    }
    i = i + 1
  }
  if span_start == 0 {
    path
  } else {
    if span_start < String::length(path) {
      StringBuilder::push(out, path[span_start: String::length(path)])
    }
    StringBuilder::freeze(out)
  }
}

export fn namespace_private_name(path: String, name: String) -> String {
  String::concat(name, String::concat("_dep_", sanitize_namespace_path(path)))
}

/// #2205: (mangled -> original) for private TYPE and CONSTRUCTOR renames.
/// `derive(Show)` expands after the merge rename has already run, so the
/// renamed declaration is the only spelling it can see -- and it bakes that
/// spelling into the rendered string (`Point_dep_... { x: 3 }` in user
/// output). This table lets the derive generators recover the source name.
///
/// The table is scoped to ONE merged program (Codex rounds 2-3 on #2213):
/// each merge driver resets it before populating, and desugar_trait_dicts
/// clears it after the derive generators have read it. Left to accumulate
/// across compilations in a long-lived process, it would both grow without
/// bound and mis-render a LATER program's genuine type whose name equals a
/// former mangled name (`Point_dep_a_vibe` rendering as `Point`).
///
/// Accepted residual: a merge that never reaches desugar (a query helper
/// like closure_merged_stmt_count, or a check-only text merge) leaves its
/// entries behind until the next merge or desugar clears them. Mis-rendering
/// through that window needs a SUBSEQUENT single-file program that both
/// declares a type spelled exactly like one of those mangled names
/// (`X_dep_<sanitized-path>`) and derives Show on it, in the same process --
/// the growth is bounded (every driver resets on entry), and carrying the
/// mapping inside the AST instead is the invasive fix (#2205 option (c)) not
/// taken here.
let namespace_rename_originals: Array[(String, String)] = array_empty()

/// Reset the #2205 rename table. Called by each merge driver before it
/// populates, and by desugar_trait_dicts once the derive generators are done.
export fn namespace_rename_originals_reset() -> Unit {
  Array::truncate(namespace_rename_originals, 0)
}

/// #2205 (Codex round 4 on #2213): metadata-only replay of the private
/// type/constructor renames for a file whose merged TEXT came from a cache.
/// The merge that would have recorded the (mangled -> original) pairs never
/// runs on a cache hit, so the grouped merge replays just the recording
/// (the same collects the rename pass runs, minus any rewriting) to keep
/// derive(Show) rendering identical between cold and warm caches. Running
/// the collects on the RAW stmts is equivalent for this purpose: the value
/// rename that normally precedes them never changes a type or constructor
/// declaration name.
export fn record_namespace_rename_originals_for_file(path: String, stmts: Array[Stmt]) -> Unit {
  let namespace_suffix_box = [""]
  let exported = collect_exported_value_names(stmts)
  let type_renames = collect_private_type_renames(path, stmts, namespace_suffix_box, exported)
  let _ = collect_private_ctor_renames(path, stmts, type_renames, namespace_suffix_box, exported)
}

/// How many merge renames are recorded. The table is keyed mangled -> original
/// and `namespace_rename_original` is identity for anything absent, so a caller
/// that does not already know the mangled spelling cannot tell an EMPTY table
/// from one that simply has no entry for its name. That distinction is the
/// whole property behind #2647 round 6 -- the table is built by the merge and
/// must survive every module of a per-module prelude -- so it needs an
/// observable form.
export fn namespace_rename_originals_len() -> Int {
  Array::length(namespace_rename_originals)
}

fn record_namespace_rename_original(original: String, mangled: String) -> Unit {
  Array::push(namespace_rename_originals, (mangled, original))
}

/// The source spelling of a possibly merge-renamed type/constructor name.
/// Returns the name unchanged when it was never renamed by this process.
export fn namespace_rename_original(name: String) -> String {
  let mut i = 0
  let mut found = name
  while i < Array::length(namespace_rename_originals) {
    let (mangled, original) = Array::get(namespace_rename_originals, i)
    if mangled == name {
      found = original
    } else {
      ()
    }
    i = i + 1
  }
  found
}

/// `path`'s merge rename as a function: `name` maps to
/// `namespace_private_name(path, name)` exactly when that mangled spelling is
/// recorded as a rename of `name` itself
/// (`namespace_rename_original(mangled) == name`), and to itself otherwise.
///
/// A caller mapping many names through one file's renames used to build the
/// mangled string and scan the whole table for EVERY name, renamed or not
/// (the typed-`==` row union, ~21 MB of the self-compile heap). This walks
/// the table once per path; each call after that is one set lookup, and only
/// a name that IS renamed allocates. Last-wins like
/// `namespace_rename_original`: the table is walked from the end and only a
/// mangled spelling's LAST entry counts.
export fn namespace_private_renamer_for_path(path: String) -> (String) -> String {
  let renamed = MutSet::new_string()
  let n = Array::length(namespace_rename_originals)
  let suffix = if n > 0 {
    String::concat("_dep_", sanitize_namespace_path(path))
  } else {
    ""
  }
  let suffix_len = String::length(suffix)
  let seen = MutSet::new_string()
  let mut i = n - 1
  while i >= 0 {
    let (mangled, original) = Array::get(namespace_rename_originals, i)
    if !MutSet::has(seen, mangled) {
      MutSet::add(seen, mangled)
      if String::length(mangled) == String::length(original) + suffix_len && String::ends_with(mangled, suffix) && String::starts_with(mangled, original) {
        MutSet::add(renamed, original)
      }
    }
    i = i - 1
  }
  (name: String) -> if MutSet::has(renamed, name) {
    String::concat(name, suffix)
  } else {
    name
  }
}

fn namespace_private_name_with_suffix(namespace_suffix: String, name: String) -> String {
  String::concat(name, String::concat("_dep_", namespace_suffix))
}

fn namespace_private_name_lazy(path: String, name: String, suffix_box: Array[String]) -> String {
  let current = Array::get(suffix_box, 0)
  let suffix = if String::length(current) == 0 {
    let sanitized = sanitize_namespace_path(path)
    Array::set(suffix_box, 0, sanitized)
    sanitized
  } else {
    current
  }
  namespace_private_name_with_suffix(suffix, name)
}

export fn collect_exported_value_names(stmts: Array[Stmt]) -> Array[String] {
  let names = empty_strings()
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SLet(true, _, name, _, _) => if !import_alias_rewrite_string_array_contains(names, name) {
        Array::push(names, name)
      },
      SExport(items) => {
        let mut j = 0
        while j < Array::length(items) {
          let name = Array::get(items, j)
          if !import_alias_rewrite_string_array_contains(names, name) {
            Array::push(names, name)
          }
          j = j + 1
        }
      },
      _ => ()
    }
    i = i + 1
  }
  names
}

/// The names of types declared `export` in `stmts` (struct/enum/trait/alias/
/// suberror). A qualified method `Type::m` whose `Type` is exported is part of
/// that type's public surface, so it must NOT be module-private-renamed.
export fn collect_exported_type_names(stmts: Array[Stmt]) -> Array[String] {
  let names = empty_strings()
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SStruct(true, name, _, _, _, _) => Array::push(names, name),
      SEnum(true, name, _, _, _) => Array::push(names, name),
      STrait(true, name, _, _, _, _) => Array::push(names, name),
      STypeAlias(true, name, _, _) => Array::push(names, name),
      SSuberror(true, name, _) => Array::push(names, name),
      _ => ()
    }
    i = i + 1
  }
  names
}

/// The names of ALL types declared in `stmts` (exported or not). Used with
/// collect_exported_type_names to decide which qualified methods are private.
export fn collect_declared_type_names(stmts: Array[Stmt]) -> Array[String] {
  let names = empty_strings()
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SStruct(_, name, _, _, _, _) => Array::push(names, name),
      SEnum(_, name, _, _, _) => Array::push(names, name),
      STrait(_, name, _, _, _, _) => Array::push(names, name),
      STypeAlias(_, name, _, _) => Array::push(names, name),
      SSuberror(_, name, _) => Array::push(names, name),
      SEffectDef(_, name, _, _) => Array::push(names, name),
      _ => ()
    }
    i = i + 1
  }
  names
}

/// A qualified `Head::member` value (an impl/trait method `let Type::m = ..`)
/// on a PUBLIC receiver type. Such methods are resolved globally by the
/// receiver type and are referenced unqualified by that type's name, so
/// path-suffixing them in an imported module (`Strm::next` -> `Strm::next$path`)
/// would orphan them from `Strm` — breaking method dispatch and the trait /
/// `for`-iterator desugar's `Type::method` lookup. Public means the head is
/// either exported from this module OR not declared in it at all — the latter
/// covers impls on BUILTIN types (`impl Iterator for Array` desugars to a
/// non-exported `let Array::iter_length = ..` whose head "Array" no module
/// declares; #736 hit this when the prelude's builtin Iterator impls were
/// private-renamed and orphaned from the witness dispatch). Only methods whose
/// head is a type declared in this module and NOT exported keep the old
/// whole-name renaming: that private type is itself renamed and its call sites
/// are rewritten through the same value-rename map, so they stay consistent.
fn qualified_method_of_exported_type(name: String, exported_types: Array[String], declared_types: Array[String]) -> Bool {
  let idx = String::index_of(name, "::")
  if idx < 0 {
    false
  } else {
    let head = String::substring(name, 0, idx)
    if import_alias_rewrite_string_array_contains(exported_types, head) {
      true
    } else {
      !import_alias_rewrite_string_array_contains(declared_types, head)
    }
  }
}

/// The private types `collect_private_type_renames` will rename: the same
/// four declaration kinds under the same `exported` test, names only.
fn collect_private_renamed_type_names(stmts: Array[Stmt], exported: Array[String]) -> Array[String] {
  let names = empty_strings()
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SEnum(false, name, _, _, _) => if !import_alias_rewrite_string_array_contains(exported, name) {
        Array::push(names, name)
      },
      SStruct(false, name, _, _, _, _) => if !import_alias_rewrite_string_array_contains(exported, name) {
        Array::push(names, name)
      },
      STypeAlias(false, name, _, _) => if !import_alias_rewrite_string_array_contains(exported, name) {
        Array::push(names, name)
      },
      SSuberror(false, name, _) => if !import_alias_rewrite_string_array_contains(exported, name) {
        Array::push(names, name)
      },
      _ => ()
    }
    i = i + 1
  }
  names
}

/// #3105: the private spelling of a module-private value.
///
/// A qualified method whose head is a private type that the type stage
/// renames (`Pt::measure`, with `Pt` becoming `Pt_dep_<path>`) takes the
/// type's mangled name as its OWNER: `Pt_dep_<path>::measure`. Every consumer
/// that finds a method from its receiver type -- the trait-dictionary builder
/// (`<Type>::<method>`), UFCS `p.measure()`, derive -- asks for exactly that
/// spelling once the type is renamed. Suffixing the whole name instead
/// (`Pt::measure_dep_<path>`) matched none of them, and the impl-owner stage
/// then rewrote the definition to `Pt_dep_<path>::measure_dep_<path>` while
/// the call sites kept `Pt::measure_dep_<path>`. Measured: a private struct
/// with a method-bearing trait impl failed `vibe build` ("add a body for
/// `measure`"), and a direct `Pt::measure(p)` reached codegen unresolved.
///
/// Anything else (a plain value, or a qualified name whose head is not a
/// renamed type, such as a private trait's) keeps the whole-name suffix.
fn private_value_rename(path: String, name: String, renamed_types: Array[String], namespace_suffix_box: Array[String]) -> String {
  let idx = String::index_of(name, "::")
  if idx > 0 && import_alias_rewrite_string_array_contains(renamed_types, String::substring(name, 0, idx)) {
    let head = String::substring(name, 0, idx)
    String::concat(namespace_private_name_lazy(path, head, namespace_suffix_box), String::substring(name, idx, String::length(name)))
  } else {
    namespace_private_name_lazy(path, name, namespace_suffix_box)
  }
}

export fn collect_private_value_renames(path: String, stmts: Array[Stmt], namespace_suffix_box: Array[String], exported: Array[String]) -> Array[(String, String)] {
  let renames = empty_aliases()
  let exported_types = collect_exported_type_names(stmts)
  let declared_types = collect_declared_type_names(stmts)
  let renamed_types = collect_private_renamed_type_names(stmts, exported)
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SLet(false, _, name, _, _) => if !import_alias_rewrite_string_array_contains(exported, name) && !qualified_method_of_exported_type(name, exported_types, declared_types) {
        Array::push(renames, (name, private_value_rename(path, name, renamed_types, namespace_suffix_box)))
      },
      SLetMut(name, _, _) => if !import_alias_rewrite_string_array_contains(exported, name) {
        Array::push(renames, (name, namespace_private_name_lazy(path, name, namespace_suffix_box)))
      },
      _ => ()
    }
    i = i + 1
  }
  renames
}

fn rewrite_private_type_expr(ty: TypeExpr, renames: Array[(String, String)]) -> TypeExpr {
  match ty {
    TyName(name) => match lookup_alias(renames, name) {
      Some(renamed) => TyName(renamed),
      None => ty
    },
    TyApp(name, args) => {
      let next_name = match lookup_alias(renames, name) {
        Some(renamed) => renamed,
        None => name
      }
      TyApp(next_name, for arg in args {
        rewrite_private_type_expr(arg, renames)
      })
    },
    TyFn(params, ret, effect_name) => TyFn(for param in params {
      rewrite_private_type_expr(param, renames)
    }, rewrite_private_type_expr(ret, renames), effect_name),
    TyTuple(items) => TyTuple(for item in items {
      rewrite_private_type_expr(item, renames)
    }),
    TyUnit => ty
  }
}

fn rewrite_private_type_opt(ty: Option[TypeExpr], renames: Array[(String, String)]) -> Option[TypeExpr] {
  match ty {
    Some(inner) => Some(rewrite_private_type_expr(inner, renames)),
    None => None
  }
}

fn rewrite_private_params(params: Array[(String, Option[TypeExpr])], type_renames: Array[(String, String)]) -> Array[(String, Option[TypeExpr])] {
  for param in params {
    let (name, ty) = param
    (name, rewrite_private_type_opt(ty, type_renames))
  }
}

fn rewrite_private_type_ctor_pat(pat: Pat, type_renames: Array[(String, String)], ctor_renames: Array[(String, String)]) -> Pat {
  match pat {
    PCtor(name, pats) => {
      let next_name = match lookup_alias(ctor_renames, name) {
        Some(renamed) => renamed,
        None => name
      }
      PCtor(next_name, for item in pats {
        rewrite_private_type_ctor_pat(item, type_renames, ctor_renames)
      })
    },
    PTuple(pats) => PTuple(for item in pats {
      rewrite_private_type_ctor_pat(item, type_renames, ctor_renames)
    }),
    POr(left, right) => POr(rewrite_private_type_ctor_pat(left, type_renames, ctor_renames), rewrite_private_type_ctor_pat(right, type_renames, ctor_renames)),
    PStruct(name, fields) => {
      let next_name = match lookup_alias(type_renames, name) {
        Some(renamed) => renamed,
        None => name
      }
      PStruct(next_name, for field in fields {
        let (field_name, field_pat) = field
        (field_name, rewrite_private_type_ctor_pat(field_pat, type_renames, ctor_renames))
      })
    },
    _ => pat
  }
}

fn rewrite_private_type_ctor_expr(expr: Expr, type_renames: Array[(String, String)], ctor_renames: Array[(String, String)]) -> Expr {
  match expr {
    EIdent(name, _) => match lookup_alias(ctor_renames, name) {
      Some(renamed) => EIdent(renamed, -1),
      None => expr
    },
    ETuple(items) => ETuple(for item in items {
      rewrite_private_type_ctor_expr(item, type_renames, ctor_renames)
    }),
    EArray(items) => EArray(for item in items {
      rewrite_private_type_ctor_expr(item, type_renames, ctor_renames)
    }),
    ERecord(rn, fields, targs) => {
      // #810: the struct-literal name now travels in the AST — rename it
      // alongside the type (same as PStruct below), or the checker's named
      // field validation would see the pre-rename spelling after merge.
      let next_rn = match lookup_alias(type_renames, rn) {
        Some(renamed) => renamed,
        None => rn
      }
      // #886: explicit struct type arguments are TypeExprs and may mention
      // renamed private types — rewrite them like any other type position.
      ERecord(next_rn, for field in fields {
        let (name, value) = field
        (name, rewrite_private_type_ctor_expr(value, type_renames, ctor_renames))
      }, for ta in targs {
        rewrite_private_type_expr(ta, type_renames)
      })
    },
    EIf(cond, then_expr, else_expr) => EIf(rewrite_private_type_ctor_expr(cond, type_renames, ctor_renames), rewrite_private_type_ctor_expr(then_expr, type_renames, ctor_renames), rewrite_private_type_ctor_expr(else_expr, type_renames, ctor_renames)),
    ELet(name, value, body, soff) => ELet(name, rewrite_private_type_ctor_expr(value, type_renames, ctor_renames), rewrite_private_type_ctor_expr(body, type_renames, alias_map_without_name(ctor_renames, name)), soff),
    ELetRec(name, value, body) => {
      let body_ctors = alias_map_without_name(ctor_renames, name)
      ELetRec(name, rewrite_private_type_ctor_expr(value, type_renames, body_ctors), rewrite_private_type_ctor_expr(body, type_renames, body_ctors))
    },
    ELetMut(name, value, body, soff) => ELetMut(name, rewrite_private_type_ctor_expr(value, type_renames, ctor_renames), rewrite_private_type_ctor_expr(body, type_renames, alias_map_without_name(ctor_renames, name)), soff),
    EAssign(name, value, body) => EAssign(name, rewrite_private_type_ctor_expr(value, type_renames, ctor_renames), rewrite_private_type_ctor_expr(body, type_renames, ctor_renames)),
    EAssignOp(name, op, value, body) => EAssignOp(name, op, rewrite_private_type_ctor_expr(value, type_renames, ctor_renames), rewrite_private_type_ctor_expr(body, type_renames, ctor_renames)),
    ESeq(left, right) => ESeq(rewrite_private_type_ctor_expr(left, type_renames, ctor_renames), rewrite_private_type_ctor_expr(right, type_renames, ctor_renames)),
    EMatch(scrutinee, arms) => EMatch(rewrite_private_type_ctor_expr(scrutinee, type_renames, ctor_renames), for arm in arms {
      let (pat, body) = arm
      let next_pat = rewrite_private_type_ctor_pat(pat, type_renames, ctor_renames)
      (next_pat, rewrite_private_type_ctor_expr(body, type_renames, alias_map_without_pat(ctor_renames, next_pat)))
    }),
    EHandle(body, arms) => EHandle(rewrite_private_type_ctor_expr(body, type_renames, ctor_renames), for arm in arms {
      let (pat, arm_body) = arm
      let next_pat = rewrite_private_type_ctor_pat(pat, type_renames, ctor_renames)
      (next_pat, rewrite_private_type_ctor_expr(arm_body, type_renames, alias_map_without_pat(ctor_renames, next_pat)))
    }),
    EWhile(cond, body) => EWhile(rewrite_private_type_ctor_expr(cond, type_renames, ctor_renames), rewrite_private_type_ctor_expr(body, type_renames, ctor_renames)),
    ELoop(params, body) => {
      let out_params = for param in params {
        let (name, init) = param
        (name, rewrite_private_type_ctor_expr(init, type_renames, ctor_renames))
      }
      let mut body_ctors = ctor_renames
      let mut i = 0
      while i < Array::length(params) {
        let (name, _) = Array::get(params, i)
        body_ctors = alias_map_without_name(body_ctors, name)
        i = i + 1
      }
      ELoop(out_params, rewrite_private_type_ctor_expr(body, type_renames, body_ctors))
    },
    EForIn(name, index_name, iter, body) => {
      let body_ctors = match index_name {
        Some(index_name) => alias_map_without_name(alias_map_without_name(ctor_renames, name), index_name),
        None => alias_map_without_name(ctor_renames, name)
      }
      EForIn(name, index_name, rewrite_private_type_ctor_expr(iter, type_renames, ctor_renames), rewrite_private_type_ctor_expr(body, type_renames, body_ctors))
    },
    ECall(callee, args, off) => ECall(rewrite_private_type_ctor_expr(callee, type_renames, ctor_renames), for arg in args {
      rewrite_private_type_ctor_expr(arg, type_renames, ctor_renames)
    }, off),
    EBinOp(op, left, right, boff) => EBinOp(op, rewrite_private_type_ctor_expr(left, type_renames, ctor_renames), rewrite_private_type_ctor_expr(right, type_renames, ctor_renames), boff),
    EUnaryOp(op, value) => EUnaryOp(op, rewrite_private_type_ctor_expr(value, type_renames, ctor_renames)),
    EFn(type_params, bounds, params, ret_ty, effect, body) => EFn(type_params, bounds, rewrite_private_params(params, type_renames), rewrite_private_type_opt(ret_ty, type_renames), effect, rewrite_private_type_ctor_expr(body, type_renames, alias_map_without_params(ctor_renames, params))),
    EDot(obj, field, off, fdoff) => EDot(rewrite_private_type_ctor_expr(obj, type_renames, ctor_renames), field, off, fdoff),
    ELabeledArg(label, name, body) => ELabeledArg(label, name, rewrite_private_type_ctor_expr(body, type_renames, ctor_renames)),
    EReturn(value) => EReturn(rewrite_private_type_ctor_expr(value, type_renames, ctor_renames)),
    EBreak(value) => match value {
      Some(value) => EBreak(Some(rewrite_private_type_ctor_expr(value, type_renames, ctor_renames))),
      None => expr
    },
    EContinue(values) => EContinue(for value in values {
      rewrite_private_type_ctor_expr(value, type_renames, ctor_renames)
    }),
    EMap(fields) => EMap(for field in fields {
      let (name, value) = field
      (name, rewrite_private_type_ctor_expr(value, type_renames, ctor_renames))
    }),
    ESpread(value) => ESpread(rewrite_private_type_ctor_expr(value, type_renames, ctor_renames)),
    _ => expr
  }
}

fn collect_private_type_renames(path: String, stmts: Array[Stmt], namespace_suffix_box: Array[String], exported: Array[String]) -> Array[(String, String)] {
  let renames = empty_aliases()
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SEnum(false, name, _, _, _) => if !import_alias_rewrite_string_array_contains(exported, name) {
        let mangled = namespace_private_name_lazy(path, name, namespace_suffix_box)
        record_namespace_rename_original(name, mangled)
        Array::push(renames, (name, mangled))
      },
      SStruct(false, name, _, _, _, _) => if !import_alias_rewrite_string_array_contains(exported, name) {
        let mangled = namespace_private_name_lazy(path, name, namespace_suffix_box)
        record_namespace_rename_original(name, mangled)
        Array::push(renames, (name, mangled))
      },
      STypeAlias(false, name, _, _) => if !import_alias_rewrite_string_array_contains(exported, name) {
        Array::push(renames, (name, namespace_private_name_lazy(path, name, namespace_suffix_box)))
      },
      SSuberror(false, name, _) => if !import_alias_rewrite_string_array_contains(exported, name) {
        let mangled = namespace_private_name_lazy(path, name, namespace_suffix_box)
        record_namespace_rename_original(name, mangled)
        Array::push(renames, (name, mangled))
      },
      _ => ()
    }
    i = i + 1
  }
  renames
}

fn collect_private_ctor_renames(path: String, stmts: Array[Stmt], type_renames: Array[(String, String)], namespace_suffix_box: Array[String], exported: Array[String]) -> Array[(String, String)] {
  let renames = empty_aliases()
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SEnum(false, type_name, _, ctors, _) => if !import_alias_rewrite_string_array_contains(exported, type_name) {
        let mut j = 0
        while j < Array::length(ctors) {
          let (ctor_name, _) = Array::get(ctors, j)
          let mangled = namespace_private_name_lazy(path, ctor_name, namespace_suffix_box)
          record_namespace_rename_original(ctor_name, mangled)
          Array::push(renames, (ctor_name, mangled))
          j = j + 1
        }
      },
      SSuberror(false, type_name, ctors) => if !import_alias_rewrite_string_array_contains(exported, type_name) {
        let mut j = 0
        while j < Array::length(ctors) {
          let (ctor_name, _) = Array::get(ctors, j)
          let mangled = namespace_private_name_lazy(path, ctor_name, namespace_suffix_box)
          record_namespace_rename_original(ctor_name, mangled)
          Array::push(renames, (ctor_name, mangled))
          j = j + 1
        }
      },
      _ => ()
    }
    i = i + 1
  }
  type_renames
  renames
}

export fn namespace_private_value_stmts(path: String, stmts: Array[Stmt]) -> Array[Stmt] {
  let namespace_suffix_box = [""]
  let exported = collect_exported_value_names(stmts)
  let renames = collect_private_value_renames(path, stmts, namespace_suffix_box, exported)
  let value_renamed = if Array::length(renames) == 0 {
    stmts
  } else {
    let ram = aliasidx_build(renames)
    for stmt in stmts {
      namespace_private_stmt(stmt, ram)
    }
  }
  namespace_private_type_ctor_stage(path, value_renamed, namespace_suffix_box, exported)
}

/// The statement as `apply_export_renames_stmts` leaves its head: the
/// definition name or export items renamed, the body shared.
export fn export_renamed_head(stmt: Stmt, exports: AliasIdx) -> Stmt {
  match stmt {
    SLet(exported, is_rec, name, ty, body) => SLet(exported, is_rec, aliasidx_rename(exports, name), ty, body),
    SFnDecl(exported, name, body, requires, ensures) => SFnDecl(exported, aliasidx_rename(exports, name), body, requires, ensures),
    SExport(items) => SExport(for item in items {
      aliasidx_rename(exports, item)
    }),
    _ => stmt
  }
}

export fn aliasidx_rename(am: AliasIdx, name: String) -> String {
  match aliasidx_get(am, name) {
    Some(renamed) => renamed,
    None => name
  }
}

export fn alias_entries_concat(first: Array[(String, String)], later: Array[(String, String)]) -> Array[(String, String)] {
  let out = empty_aliases()
  let mut i = 0
  while i < Array::length(first) {
    Array::push(out, Array::get(first, i))
    i = i + 1
  }
  i = 0
  while i < Array::length(later) {
    Array::push(out, Array::get(later, i))
    i = i + 1
  }
  out
}

fn qualified_head_of(name: String) -> String {
  let qi = String::index_of(name, "::")
  if qi < 0 {
    ""
  } else {
    String::substring(name, 0, qi)
  }
}

/// Whether rewriting with `first` and then with `later` answers every name
/// exactly like one rewrite with their union (see
/// `namespace_private_value_stmts_after_renames`). Every check is by the
/// spellings the walker consults: a whole identifier against the keys, and
/// the head of a qualified identifier against the keys (a trait-namespace
/// marker key would change that head rule, so no key may be one).
export fn alias_renames_compose(first: AliasIdx, later: Array[(String, String)]) -> Bool {
  let first_values = MutSet::new_string()
  let later_keys = MutSet::new_string()
  let mut ok = true
  let mut i = 0
  while ok && i < Array::length(first.entries) {
    let (key, value) = Array::get(first.entries, i)
    MutSet::add(first_values, value)
    if String::contains(key, "::__vibe_trait_namespace_alias") {
      ok = false
    } else {
      i = i + 1
    }
  }
  i = 0
  while ok && i < Array::length(later) {
    let (key, _) = Array::get(later, i)
    MutSet::add(later_keys, key)
    let head = qualified_head_of(key)
    if MutMap::has(first.idx, key) || MutSet::has(first_values, key) || String::contains(key, "::__vibe_trait_namespace_alias") || (head != "" && (MutMap::has(first.idx, head) || MutSet::has(first_values, head))) {
      ok = false
    } else {
      i = i + 1
    }
  }
  i = 0
  while ok && i < Array::length(first.entries) {
    let (_, value) = Array::get(first.entries, i)
    let head = qualified_head_of(value)
    if head != "" && MutSet::has(later_keys, head) {
      ok = false
    } else {
      i = i + 1
    }
  }
  ok
}

/// The type and constructor stage of `namespace_private_value_stmts`, over
/// statements whose private values are already renamed.
export fn namespace_private_type_ctor_stage(path: String, value_renamed: Array[Stmt], namespace_suffix_box: Array[String], exported: Array[String]) -> Array[Stmt] {
  let type_renames = collect_private_type_renames(path, value_renamed, namespace_suffix_box, exported)
  let ctor_renames = collect_private_ctor_renames(path, value_renamed, type_renames, namespace_suffix_box, exported)
  if Array::length(type_renames) == 0 && Array::length(ctor_renames) == 0 {
    value_renamed
  } else {
    let private_enum_heads = empty_strings()
    for stmt in value_renamed {
      match stmt {
        SEnum(false, name, _, _, _) => if !import_alias_rewrite_string_array_contains(exported, name) {
          Array::push(private_enum_heads, name)
        },
        SSuberror(false, name, _) => if !import_alias_rewrite_string_array_contains(exported, name) {
          Array::push(private_enum_heads, name)
        },
        _ => ()
      }
    }
    let local_type_aliases = collect_local_type_aliases(value_renamed)
    let owner_aliases = collect_impl_method_owner_aliases(value_renamed, type_renames)
    let owner_renamed = for stmt in value_renamed {
      rewrite_impl_method_binding(stmt, owner_aliases)
    }
    for stmt in owner_renamed {
      namespace_private_type_ctor_stmt(stmt, type_renames, ctor_renames, private_enum_heads, local_type_aliases)
    }
  }
}

fn namespace_private_type_ctor_stmt(stmt: Stmt, type_renames: Array[(String, String)], ctor_renames: Array[(String, String)], private_enum_heads: Array[String], local_type_aliases: Array[(String, Array[String], TypeExpr)]) -> Stmt {
  match stmt {
    SLet(exported, is_rec, name, ty, body) => SLet(exported, is_rec, name, rewrite_private_type_opt(ty, type_renames), rewrite_private_type_ctor_expr(body, type_renames, alias_map_without_name(ctor_renames, name))),
    SLetMut(name, ty, body) => SLetMut(name, rewrite_private_type_opt(ty, type_renames), rewrite_private_type_ctor_expr(body, type_renames, alias_map_without_name(ctor_renames, name))),
    SEnum(exported, name, params, ctors, derives) => {
      let next_name = if exported {
        name
      } else {
        match lookup_alias(type_renames, name) {
          Some(renamed) => renamed,
          None => name
        }
      }
      SEnum(exported, next_name, params, for ctor in ctors {
        let (ctor_name, args) = ctor
        let next_ctor = if exported {
          ctor_name
        } else {
          match lookup_alias(ctor_renames, ctor_name) {
            Some(renamed) => renamed,
            None => ctor_name
          }
        }
        (next_ctor, for arg in args {
          rewrite_private_type_expr(arg, type_renames)
        })
      }, derives)
    },
    SSuberror(exported, name, ctors) => {
      let next_name = if exported {
        name
      } else {
        match lookup_alias(type_renames, name) {
          Some(renamed) => renamed,
          None => name
        }
      }
      SSuberror(exported, next_name, for ctor in ctors {
        let (ctor_name, args) = ctor
        let next_ctor = if exported {
          ctor_name
        } else {
          match lookup_alias(ctor_renames, ctor_name) {
            Some(renamed) => renamed,
            None => ctor_name
          }
        }
        (next_ctor, for arg in args {
          rewrite_private_type_expr(arg, type_renames)
        })
      })
    },
    SStruct(exported, name, fields, derives, mut_fields, tparams) => {
      let next_name = if exported {
        name
      } else {
        match lookup_alias(type_renames, name) {
          Some(renamed) => renamed,
          None => name
        }
      }
      SStruct(exported, next_name, for field in fields {
        let (field_name, field_ty) = field
        (field_name, rewrite_private_type_expr(field_ty, type_renames))
      }, derives, mut_fields, tparams)
    },
    STypeAlias(exported, name, params, target) => {
      let next_name = if exported {
        name
      } else {
        match lookup_alias(type_renames, name) {
          Some(renamed) => renamed,
          None => name
        }
      }
      STypeAlias(exported, next_name, params, rewrite_private_type_expr(target, type_renames))
    },
    SQualifiedPatternRefs(rows) => SQualifiedPatternRefs(for row in rows {
      let qualifier = match lookup_alias(type_renames, row.0) {
        Some(renamed) => renamed,
        None => row.0
      }
      let head = local_pattern_qualifier_head(row.0, local_type_aliases, Array::length(local_type_aliases) + 1)
      let variant = if import_alias_rewrite_string_array_contains(private_enum_heads, head) {
        match lookup_alias(ctor_renames, row.1) {
          Some(renamed) => renamed,
          None => row.1
        }
      } else {
        row.1
      }
      (qualifier, variant)
    }),
    SImpl(tparams, bounds, trait_name, target) => SImpl(tparams, bounds, trait_name, rewrite_private_type_expr(target, alias_map_without_names(type_renames, tparams))),
    SExternLet(name, ty) => SExternLet(name, rewrite_private_type_expr(ty, type_renames)),
    STest(name, body) => STest(name, rewrite_private_type_ctor_expr(body, type_renames, ctor_renames)),
    SBench(name, body) => SBench(name, rewrite_private_type_ctor_expr(body, type_renames, ctor_renames)),
    SExpr(body) => SExpr(rewrite_private_type_ctor_expr(body, type_renames, ctor_renames)),
    SLetPat(pat, body) => {
      let next_pat = rewrite_private_type_ctor_pat(pat, type_renames, ctor_renames)
      SLetPat(next_pat, rewrite_private_type_ctor_expr(body, type_renames, alias_map_without_pat(ctor_renames, next_pat)))
    },
    SModule(exported, name, stmts) => SModule(exported, name, namespace_private_value_stmts(name, stmts)),
    SEffectDef(exported, name, params, ops) => SEffectDef(exported, name, params, for op in ops {
      let (op_name, op_params, ret_ty) = op
      (op_name, for param in op_params {
        rewrite_private_type_expr(param, type_renames)
      }, rewrite_private_type_expr(ret_ty, type_renames))
    }),
    _ => stmt
  }
}

fn namespace_private_stmt(stmt: Stmt, ram: AliasIdx) -> Stmt {
  match stmt {
    SLet(exported, is_rec, name, ty, body) => {
      let next_name = match aliasidx_get(ram, name) {
        Some(renamed) => renamed,
        None => name
      }
      SLet(exported, is_rec, next_name, ty, rewrite_alias_expr_ix(body, ram))
    },
    SLetMut(name, ty, body) => {
      let next_name = match aliasidx_get(ram, name) {
        Some(renamed) => renamed,
        None => name
      }
      SLetMut(next_name, ty, rewrite_alias_expr_ix(body, ram))
    },
    STest(name, body) => STest(name, rewrite_alias_expr_ix(body, ram)),
    SBench(name, body) => SBench(name, rewrite_alias_expr_ix(body, ram)),
    SExpr(body) => SExpr(rewrite_alias_expr_ix(body, ram)),
    SLetPat(pat, body) => SLetPat(pat, rewrite_alias_expr_ix(body, ram)),
    SModule(exported, name, stmts) => SModule(exported, name, namespace_private_value_stmts(name, stmts)),
    _ => stmt
  }
}
