//# Imports

import ./ast.vibe {
  Expr, Pat, Stmt, TypeExpr
}

import ./inline_wasm_marker.vibe {
  inline_wasm_marker_name, wat_callee_names
}

import @vibe/core {
  array_empty, struct MutMap, struct MutSet
}

//# Functions

fn stmt_name(stmt: Stmt) -> Option[String] {
  match stmt {
    SLet(_, _, name, _, _) => Some(name),
    // Preserved `fn` declaration (ADR-0064 #727): a value binding for DCE
    // purposes, exactly like the SLet it lowers to.
    SFnDecl(_, name, _, _, _) => Some(name),
    SLetMut(name, _, _) => Some(name),
    _ => None
  }
}

/// #2386: a plain loop. This used to allocate a recursive closure (`let rec
/// search`) per call, and add_ref calls it once per identifier of every
/// definition: ~3.4 MB of closures per compiler-closure compile on either
/// lane, for a scan over a stack that holds a handful of binders. (A hash
/// set was measured for the stack and rejected: hashing the name costs more
/// than comparing it against the few binders in scope.)
fn dce_array_contains_str(arr: Array[String], s: String) -> Bool {
  let len = Array::length(arr)
  let mut i = 0
  let mut found = false
  while i < len && !found {
    if Array::get(arr, i) == s {
      found = true
    } else {
      i = i + 1
    }
  }
  found
}

// #2386: `out` is deduped through ONE process-wide map stamped with a
// generation per collection (`dce_refs_begin`), so a definition's refs cost
// no allocation of their own -- the per-def set that #1259 rejected on the
// selfcompile heap KPI -- and each identifier is one hash probe instead of a
// scan of every name the definition referenced so far (the compiler's larger
// bodies reference hundreds). `bound` stays a linear scan: it is the binders
// in scope, a handful, and since #2386 it is one stack pushed and truncated
// around each scope rather than a fresh copy per binder (the copy was the
// allocation, per `let` / arm / lambda of every definition). The quadratic
// scans #1259 removed were the per-queue-item def/reachable lookups below,
// which are indexed via `def_idx` / `reachable_seen`.
let dce_refs_seen: Array[MutMap[String, Int]] = [MutMap::new_string()]

let dce_refs_gen: Array[Int] = [0]

/// Start a new reference collection: names seen under an earlier generation
/// are pushed again. Bounded for a resident compiler: the map holds every
/// distinct name ever referenced, so past 65536 it is dropped.
fn dce_refs_begin() -> Unit {
  if MutMap::size(Array::get(dce_refs_seen, 0)) > 65536 {
    Array::set(dce_refs_seen, 0, MutMap::new_string())
  } else {
    ()
  }
  Array::set(dce_refs_gen, 0, Array::get(dce_refs_gen, 0) + 1)
}

fn dce_refs_push_once(out: Array[String], name: String) -> Unit {
  let seen = Array::get(dce_refs_seen, 0)
  let gen = Array::get(dce_refs_gen, 0)
  let already = match MutMap::get(seen, name) {
    Some(stamp) => stamp == gen,
    None => false
  }
  if already {
    ()
  } else {
    MutMap::set(seen, name, gen)
    Array::push(out, name)
  }
}

fn add_ref(out: Array[String], bound: Array[String], name: String) -> Int {
  if not(dce_array_contains_str(bound, name)) {
    dce_refs_push_once(out, name)
  }
  0
}

fn collect_pat_bindings(pat: Pat, bound: Array[String]) -> Int {
  match pat {
    PWild => 0,
    PBind(name) => {
      Array::push(bound, name)
      0
    },
    PInt(_) => 0,
    PFloat(_) => 0,
    PString(_) => 0,
    PBool(_) => 0,
    PCtor(_, pats) => {
      let mut i = 0
      while i < Array::length(pats) {
        collect_pat_bindings(Array::get(pats, i), bound)
        i = i + 1
      }
      0
    },
    PTuple(pats) => {
      let mut i = 0
      while i < Array::length(pats) {
        collect_pat_bindings(Array::get(pats, i), bound)
        i = i + 1
      }
      0
    },
    POr(p1, p2) => {
      collect_pat_bindings(p1, bound)
      collect_pat_bindings(p2, bound)
      0
    },
    PStruct(_, _) => 0
  }
}

/// #2348: add the `call $name` callees of an inline-wasm marker call
/// (`%wasm("<WAT>")`) to `out`. A no-op for every other call.
fn collect_wat_callee_refs(callee: Expr, args: Array[Expr], bound: Array[String], out: Array[String]) -> Int {
  match callee {
    EIdent(cname, _) => if cname == inline_wasm_marker_name() && Array::length(args) == 1 {
      match Array::get(args, 0) {
        EString(wat) => {
          let names = wat_callee_names(wat)
          let mut i = 0
          while i < Array::length(names) {
            // NOT add_ref: `bound` holds the expression's value binders, and a
            // WAT `$name` callee is a wasm FUNCTION name, a namespace of its
            // own. `fn caller(helper: Int) = wasm"(call $helper (local.get
            // $helper))"` calls the fn and reads the param, and the assembler
            // already keeps those apart -- filtering by `bound` here dropped
            // the call edge and DCE then pruned the live helper.
            dce_refs_push_once(out, Array::get(names, i))
            i = i + 1
          }
          0
        },
        _ => 0
      }
    } else {
      0
    },
    _ => 0
  }
}

fn collect_refs_into(expr: Expr, bound: Array[String], out: Array[String]) -> Int {
  match expr {
    EIdent(name, _) => add_ref(out, bound, name),
    EInt(_) => 0,
    EFloat(_) => 0,
    EString(_) => 0,
    EBool(_) => 0,
    EUnit => 0,
    EBreak(_) => 0,
    EContinue(_) => 0,
    EReturn(e) => collect_refs_into(e, bound, out),
    EUnaryOp(_, e) => collect_refs_into(e, bound, out),
    ETuple(items) => {
      let mut i = 0
      while i < Array::length(items) {
        collect_refs_into(Array::get(items, i), bound, out)
        i = i + 1
      }
      0
    },
    EArray(items) => {
      let mut i = 0
      while i < Array::length(items) {
        collect_refs_into(Array::get(items, i), bound, out)
        i = i + 1
      }
      0
    },
    ERecord(_, fields, _) => {
      let mut i = 0
      while i < Array::length(fields) {
        let (_, val) = Array::get(fields, i)
        collect_refs_into(val, bound, out)
        i = i + 1
      }
      0
    },
    EBinOp(_, l, r, _) => {
      collect_refs_into(l, bound, out)
      collect_refs_into(r, bound, out)
      0
    },
    ECall(callee, args, _) => {
      collect_refs_into(callee, bound, out)
      // #2348: an inline-wasm body reaches here as `%wasm("<WAT text>")`, and
      // the text is an EString, which contributes nothing below. A
      // `(call $helper ...)` inside it is a real reference, so without this
      // arm DCE prunes a helper that only a kernel calls and codegen then
      // reports it missing -- while `vibe check`, which runs on the unpruned
      // statements, reports clean.
      collect_wat_callee_refs(callee, args, bound, out)
      let mut i = 0
      while i < Array::length(args) {
        collect_refs_into(Array::get(args, i), bound, out)
        i = i + 1
      }
      0
    },
    EIf(cond, then_e, else_e) => {
      collect_refs_into(cond, bound, out)
      collect_refs_into(then_e, bound, out)
      collect_refs_into(else_e, bound, out)
      0
    },
    ELet(name, val, body, _) => {
      collect_refs_into(val, bound, out)
      let mark = Array::length(bound)
      Array::push(bound, name)
      collect_refs_into(body, bound, out)
      Array::truncate(bound, mark)
      0
    },
    ELetRec(name, val, body) => {
      let mark = Array::length(bound)
      Array::push(bound, name)
      collect_refs_into(val, bound, out)
      collect_refs_into(body, bound, out)
      Array::truncate(bound, mark)
      0
    },
    ELetMut(name, val, body, _) => {
      collect_refs_into(val, bound, out)
      let mark = Array::length(bound)
      Array::push(bound, name)
      collect_refs_into(body, bound, out)
      Array::truncate(bound, mark)
      0
    },
    EAssign(_, val, body) => {
      collect_refs_into(val, bound, out)
      collect_refs_into(body, bound, out)
      0
    },
    EAssignOp(_, _, val, body) => {
      collect_refs_into(val, bound, out)
      collect_refs_into(body, bound, out)
      0
    },
    ESeq(l, r) => {
      collect_refs_into(l, bound, out)
      collect_refs_into(r, bound, out)
      0
    },
    EMatch(scr, arms) => {
      collect_refs_into(scr, bound, out)
      let mut i = 0
      while i < Array::length(arms) {
        let (pat, body) = Array::get(arms, i)
        let mark = Array::length(bound)
        collect_pat_bindings(pat, bound)
        collect_refs_into(body, bound, out)
        Array::truncate(bound, mark)
        i = i + 1
      }
      0
    },
    EHandle(body_expr, arms) => {
      collect_refs_into(body_expr, bound, out)
      let mut i = 0
      while i < Array::length(arms) {
        let (pat, arm_body) = Array::get(arms, i)
        let mark = Array::length(bound)
        collect_pat_bindings(pat, bound)
        collect_refs_into(arm_body, bound, out)
        Array::truncate(bound, mark)
        i = i + 1
      }
      0
    },
    EWhile(cond, body) => {
      collect_refs_into(cond, bound, out)
      collect_refs_into(body, bound, out)
      0
    },
    ELoop(params, body) => {
      let mark = Array::length(bound)
      let mut i = 0
      while i < Array::length(params) {
        let (name, init) = Array::get(params, i)
        collect_refs_into(init, bound, out)
        Array::push(bound, name)
        i = i + 1
      }
      collect_refs_into(body, bound, out)
      Array::truncate(bound, mark)
      0
    },
    EForIn(name, index_name, iter, body) => {
      collect_refs_into(iter, bound, out)
      let mark = Array::length(bound)
      Array::push(bound, name)
      match index_name {
        Some(index_name) => Array::push(bound, index_name),
        None => ()
      }
      collect_refs_into(body, bound, out)
      Array::truncate(bound, mark)
      0
    },
    EFn(_, _, params, _, _, body) => {
      let mark = Array::length(bound)
      let mut i = 0
      while i < Array::length(params) {
        let (pname, _) = Array::get(params, i)
        Array::push(bound, pname)
        i = i + 1
      }
      collect_refs_into(body, bound, out)
      Array::truncate(bound, mark)
      0
    },
    EDot(obj, _, _, _) => {
      collect_refs_into(obj, bound, out)
      0
    },
    ELabeledArg(_, _, e) => {
      collect_refs_into(e, bound, out)
      0
    },
    EMap(fields) => {
      let mut i = 0
      while i < Array::length(fields) {
        let (_, val) = Array::get(fields, i)
        collect_refs_into(val, bound, out)
        i = i + 1
      }
      0
    },
    ESpread(e) => {
      collect_refs_into(e, bound, out)
      0
    },
    EStringInterp(_) => 0
  }
}

fn collect_refs(expr: Expr, bound: Array[String]) -> Array[String] {
  dce_refs_begin()
  let out = array_empty()
  collect_refs_into(expr, bound, out)
  out
}

fn enqueue_reachable(reachable: Array[String], reachable_seen: MutSet[String], queue: Array[String], name: String) -> Unit {
  if not(MutSet::has(reachable_seen, name)) {
    MutSet::add(reachable_seen, name)
    Array::push(reachable, name)
    Array::push(queue, name)
  }
}

fn collect_structural_refs_into_queue(stmt: Stmt, bound: Array[String], reachable: Array[String], reachable_seen: MutSet[String], queue: Array[String]) -> Unit {
  let refs = match stmt {
    STest(_, expr) => collect_refs(expr, bound),
    SBench(_, expr) => collect_refs(expr, bound),
    SExpr(expr) => collect_refs(expr, bound),
    _ => array_empty()
  }
  let mut i = 0
  while i < Array::length(refs) {
    enqueue_reachable(reachable, reachable_seen, queue, Array::get(refs, i))
    i = i + 1
  }
}

fn is_type_or_structural(stmt: Stmt) -> Bool {
  match stmt {
    SEnum(_, _, _, _, _) => true,
    SSuberror(_, _, _) => true,
    SEffectDef(_, _, _, _) => true,
    SStruct(_, _, _, _, _, _) => true,
    STypeAlias(_, _, _, _) => true,
    STrait(_, _, _, _, _, _) => true,
    SImpl(_, _, _, _) => true,
    SExternLet(_, _) => true,
    // ADR-0075 Phase 2 (#1343): a resource declaration is a requirement the
    // executable states, not a value anything references, so reachability
    // must never drop it.
    SResource(_, _) => true,
    SImport(_, _) => true,
    SAliasDecl(_, _) => true,
    STest(_, _) => true,
    SBench(_, _) => true,
    SExpr(_) => true,
    SExport(_) => true,
    SReExport(_, _) => true,
    SModule(_, _, _) => true,
    _ => false
  }
}

export fn dce_stmts(stmts: Array[Stmt], entry_names: Array[String]) -> Array[Stmt] {
  // Early-return on empty input: downstream code uses
  //   `array_empty()`
  // to construct a typed empty `Array[Stmt]`, which traps out-of-bounds
  // when stmts itself is empty. (See `dce_test.vibe: "empty stmts
  // returns empty"`, tracked in #266.)
  if Array::length(stmts) == 0 {
    Array::slice(stmts, 0, 0)
  } else {
    let empty_bound = array_empty()
    let def_names = array_empty()
    let def_refs = array_empty()
    let def_idx: MutMap[String, Array[Int]] = MutMap::new_string()
    let mut i = 0
    while i < Array::length(stmts) {
      let stmt = Array::get(stmts, i)
      match stmt_name(stmt) {
        Some(name) => {
          let di = Array::length(def_names)
          Array::push(def_names, name)
          match MutMap::get(def_idx, name) {
            Some(idxs) => Array::push(idxs, di),
            None => MutMap::set(def_idx, name, Array::slice([di], 0, 1))
          }
          let refs = match stmt {
            SLet(_, _, _, _, expr) => collect_refs(expr, empty_bound),
            // Preserved fn decl (ADR-0064 #727): body refs plus contract-
            // condition refs (requires/ensures execute inside the function
            // after lowering, so helpers they call must stay live).
            SFnDecl(_, _, fn_value, reqs, enss) => {
              dce_refs_begin()
              let out = array_empty()
              let _ = collect_refs_into(fn_value, empty_bound, out)
              let mut cri = 0
              while cri < Array::length(reqs) {
                let _ = collect_refs_into(Array::get(reqs, cri), empty_bound, out)
                cri = cri + 1
              }
              let mut cei = 0
              while cei < Array::length(enss) {
                let _ = collect_refs_into(Array::get(enss, cei), empty_bound, out)
                cei = cei + 1
              }
              out
            },
            SLetMut(_, _, expr) => collect_refs(expr, empty_bound),
            _ => array_empty()
          }
          Array::push(def_refs, refs)
          0
        },
        None => 0
      }
      i = i + 1
    }
    let reachable = array_empty()
    let reachable_seen = MutSet::new_string()
    let queue = array_empty()
    let mut j = 0
    while j < Array::length(entry_names) {
      let name = Array::get(entry_names, j)
      enqueue_reachable(reachable, reachable_seen, queue, name)
      j = j + 1
    }
    let mut sj = 0
    while sj < Array::length(stmts) {
      collect_structural_refs_into_queue(Array::get(stmts, sj), empty_bound, reachable, reachable_seen, queue)
      sj = sj + 1
    }
    let mut qi = 0
    while qi < Array::length(queue) {
      let current = Array::get(queue, qi)
      qi = qi + 1
      match MutMap::get(def_idx, current) {
        Some(idxs) => {
          let mut ki = 0
          while ki < Array::length(idxs) {
            let refs = Array::get(def_refs, Array::get(idxs, ki))
            let mut r = 0
            while r < Array::length(refs) {
              let dep = Array::get(refs, r)
              if not(MutSet::has(reachable_seen, dep)) {
                MutSet::add(reachable_seen, dep)
                Array::push(reachable, dep)
                Array::push(queue, dep)
              }
              r = r + 1
            }
            ki = ki + 1
          }
        },
        None => ()
      }
    }
    let result = array_empty()
    let mut m = 0
    while m < Array::length(stmts) {
      let stmt = Array::get(stmts, m)
      if is_type_or_structural(stmt) {
        Array::push(result, stmt)
      } else {
        match stmt_name(stmt) {
          Some(name) => if MutSet::has(reachable_seen, name) {
            Array::push(result, stmt)
          },
          None => Array::push(result, stmt)
        }
      }
      m = m + 1
    }
    result
  }
}

/// Compute the set of reachable top-level names from `entry_names`, following
/// value-definition refs and structural (type/test/expr) refs to a fixpoint.
/// Mirrors the reachability computation inside `dce_stmts`; kept as a separate
/// (currently unwired) function so module-source emission can reuse it without
/// changing `dce_stmts` (a bootstrap-reachable hot path).
fn dce_reachable_names(stmts: Array[Stmt], entry_names: Array[String]) -> Array[String] {
  let empty_bound = array_empty()
  let def_names = array_empty()
  let def_refs = array_empty()
  let def_idx: MutMap[String, Array[Int]] = MutMap::new_string()
  let mut i = 0
  while i < Array::length(stmts) {
    let stmt = Array::get(stmts, i)
    match stmt_name(stmt) {
      Some(name) => {
        let di = Array::length(def_names)
        Array::push(def_names, name)
        match MutMap::get(def_idx, name) {
          Some(idxs) => Array::push(idxs, di),
          None => MutMap::set(def_idx, name, Array::slice([di], 0, 1))
        }
        let refs = match stmt {
          SLet(_, _, _, _, expr) => collect_refs(expr, empty_bound),
          // Preserved fn decl (ADR-0064 #727): body refs plus contract-
          // condition refs (requires/ensures execute inside the function
          // after lowering, so helpers they call must stay live).
          SFnDecl(_, _, fn_value, reqs, enss) => {
            dce_refs_begin()
            let out = array_empty()
            let _ = collect_refs_into(fn_value, empty_bound, out)
            let mut cri = 0
            while cri < Array::length(reqs) {
              let _ = collect_refs_into(Array::get(reqs, cri), empty_bound, out)
              cri = cri + 1
            }
            let mut cei = 0
            while cei < Array::length(enss) {
              let _ = collect_refs_into(Array::get(enss, cei), empty_bound, out)
              cei = cei + 1
            }
            out
          },
          SLetMut(_, _, expr) => collect_refs(expr, empty_bound),
          _ => array_empty()
        }
        Array::push(def_refs, refs)
        0
      },
      None => 0
    }
    i = i + 1
  }
  let reachable = array_empty()
  let reachable_seen = MutSet::new_string()
  let queue = array_empty()
  let mut j = 0
  while j < Array::length(entry_names) {
    let name = Array::get(entry_names, j)
    enqueue_reachable(reachable, reachable_seen, queue, name)
    j = j + 1
  }
  let mut sj = 0
  while sj < Array::length(stmts) {
    collect_structural_refs_into_queue(Array::get(stmts, sj), empty_bound, reachable, reachable_seen, queue)
    sj = sj + 1
  }
  let mut qi = 0
  while qi < Array::length(queue) {
    let current = Array::get(queue, qi)
    qi = qi + 1
    match MutMap::get(def_idx, current) {
      Some(idxs) => {
        let mut ki = 0
        while ki < Array::length(idxs) {
          let refs = Array::get(def_refs, Array::get(idxs, ki))
          let mut r = 0
          while r < Array::length(refs) {
            let dep = Array::get(refs, r)
            if not(MutSet::has(reachable_seen, dep)) {
              MutSet::add(reachable_seen, dep)
              Array::push(reachable, dep)
              Array::push(queue, dep)
            }
            r = r + 1
          }
          ki = ki + 1
        }
      },
      None => ()
    }
  }
  reachable
}

/// Whether DCE keeps `stmt` given the reachable name set: type/structural
/// statements are always kept; named value defs are kept iff reachable; unnamed
/// statements are kept. (Same per-statement rule `dce_stmts` applies.)
fn dce_keep_stmt(stmt: Stmt, reachable_seen: MutSet[String]) -> Bool {
  if is_type_or_structural(stmt) {
    true
  } else {
    match stmt_name(stmt) {
      Some(name) => MutSet::has(reachable_seen, name),
      None => true
    }
  }
}

/// Per-original-index keep flags from DCE, parallel to `stmts`. Lets callers
/// (e.g. module-source emission) map surviving statements back to their source
/// spans without relying on statement identity/equality. Result length equals
/// `Array::length(stmts)`.
export fn dce_keep_flags(stmts: Array[Stmt], entry_names: Array[String]) -> Array[Bool] {
  dce_keep_flags_via(stmts, stmts, entry_names)
}

/// `dce_keep_flags` with reachability computed over `reach_stmts` instead of
/// `stmts`. Module-source emission needs this split (#2516): its statement
/// list comes from `parse_program_spans`, which carries one bodyless `SImpl`
/// per impl so that the impl text is emitted once, and reachability walked
/// over that list cannot see a call made from an impl method. `reach_stmts`
/// is the full parse of the same program, whose impl method bindings are
/// the statements `stmts` lacks. Every impl is emitted whole (an `SImpl` is
/// structural and always kept), so each of those method bindings is a root:
/// whatever a method calls must survive, or the flat source does not
/// compile. The flags still index `stmts`.
export fn dce_keep_flags_via(stmts: Array[Stmt], reach_stmts: Array[Stmt], entry_names: Array[String]) -> Array[Bool] {
  let flags = array_empty()
  if Array::length(stmts) == 0 {
    flags
  } else {
    let span_names = MutSet::new_string()
    let mut sn = 0
    while sn < Array::length(stmts) {
      match stmt_name(Array::get(stmts, sn)) {
        Some(name) => MutSet::add(span_names, name),
        None => ()
      }
      sn = sn + 1
    }
    let roots = array_empty()
    let mut en = 0
    while en < Array::length(entry_names) {
      Array::push(roots, Array::get(entry_names, en))
      en = en + 1
    }
    let mut rn = 0
    while rn < Array::length(reach_stmts) {
      match stmt_name(Array::get(reach_stmts, rn)) {
        Some(name) => if MutSet::has(span_names, name) {
          ()
        } else {
          Array::push(roots, name)
        },
        None => ()
      }
      rn = rn + 1
    }
    let reachable = dce_reachable_names(reach_stmts, roots)
    let reachable_seen = MutSet::new_string()
    let mut rsi = 0
    while rsi < Array::length(reachable) {
      MutSet::add(reachable_seen, Array::get(reachable, rsi))
      rsi = rsi + 1
    }
    let mut m = 0
    while m < Array::length(stmts) {
      Array::push(flags, dce_keep_stmt(Array::get(stmts, m), reachable_seen))
      m = m + 1
    }
    flags
  }
}
