//# Imports

import ./ast.vibe {
  Expr, Pat, Stmt, TypeExpr
}

import ./inline_wasm_marker.vibe {
  inline_wasm_marker_name, wat_callee_names
}

import @vibe/core {
  array_empty, struct MutMap, struct MutSet
}

//# Functions

fn stmt_name(stmt: Stmt) -> Option[String] {
  match stmt {
    SLet(_, _, name, _, _) => Some(name),
    // Preserved `fn` declaration (ADR-0064 #727): a value binding for DCE
    // purposes, exactly like the SLet it lowers to.
    SFnDecl(_, name, _, _, _) => Some(name),
    SLetMut(name, _, _) => Some(name),
    _ => None
  }
}

/// #2386: a plain loop. This used to allocate a recursive closure (`let rec
/// search`) per call, and add_ref calls it once per identifier of every
/// definition: ~3.4 MB of closures per compiler-closure compile on either
/// lane, for a scan over a stack that holds a handful of binders. (A hash
/// set was measured for the stack and rejected: hashing the name costs more
/// than comparing it against the few binders in scope.)
fn dce_array_contains_str(arr: Array[String], s: String) -> Bool {
  let len = Array::length(arr)
  let mut i = 0
  let mut found = false
  while i < len && !found {
    if Array::get(arr, i) == s {
      found = true
    } else {
      i = i + 1
    }
  }
  found
}

// Each graph owns dense spelling IDs. Lexical binders still use the existing
// scope stack: a symbol ID identifies a spelling, not a lexical binding.
// Only graph construction hashes names; edges, definition chains, per-body
// deduplication, and the reachability queue carry IDs thereafter. IDs never
// escape the pass or participate in serialized cache identities.
struct DceGraph {
  symbols: MutMap[String, Int];
  heads: Array[Int];
  marks: Array[Int];
  live: Array[Bool];
  generation: Array[Int];
  def_next: Array[Int];
  def_refs: Array[Array[Int]];
  stmt_ids: Array[Int]
}

fn dce_graph_new(capacity: Int) -> DceGraph {
  DceGraph::{
    symbols: MutMap::with_capacity_string(capacity * 2 + 16),
    heads: array_empty(),
    marks: array_empty(),
    live: array_empty(),
    generation: [0],
    def_next: array_empty(),
    def_refs: array_empty(),
    // #2554: `capacity` IS this array's final length -- dce_reachable_graph
    // pushes exactly once per statement, on BOTH arms of the `stmt_name`
    // match (an unnamed statement pushes -1). So this is an exact
    // reservation, not an estimate, and it cannot under-reserve and grow.
    stmt_ids: Array::with_capacity(capacity)
  }
}

fn dce_symbol_id(graph: DceGraph, name: String) -> Int {
  match MutMap::get(graph.symbols, name) {
    Some(id) => id,
    None => {
      let id = Array::length(graph.heads)
      MutMap::set(graph.symbols, name, id)
      Array::push(graph.heads, -1)
      Array::push(graph.marks, 0)
      Array::push(graph.live, false)
      id
    }
  }
}

fn dce_refs_begin(graph: DceGraph) -> Unit {
  Array::set(graph.generation, 0, Array::get(graph.generation, 0) + 1)
}

fn dce_refs_push_once(graph: DceGraph, out: Array[Int], name: String) -> Unit {
  let id = dce_symbol_id(graph, name)
  let gen = Array::get(graph.generation, 0)
  if Array::get(graph.marks, id) != gen {
    Array::set(graph.marks, id, gen)
    Array::push(out, id)
  } else {
    ()
  }
}

fn add_ref(graph: DceGraph, out: Array[Int], bound: Array[String], name: String) -> Int {
  if not(dce_array_contains_str(bound, name)) {
    dce_refs_push_once(graph, out, name)
  }
  0
}

fn collect_pat_bindings(pat: Pat, bound: Array[String]) -> Int {
  match pat {
    PWild => 0,
    PBind(name) => {
      Array::push(bound, name)
      0
    },
    PInt(_) => 0,
    PFloat(_) => 0,
    PString(_) => 0,
    PBool(_) => 0,
    PCtor(_, pats) => {
      let mut i = 0
      while i < Array::length(pats) {
        collect_pat_bindings(Array::get(pats, i), bound)
        i = i + 1
      }
      0
    },
    PTuple(pats) => {
      let mut i = 0
      while i < Array::length(pats) {
        collect_pat_bindings(Array::get(pats, i), bound)
        i = i + 1
      }
      0
    },
    POr(p1, p2) => {
      collect_pat_bindings(p1, bound)
      collect_pat_bindings(p2, bound)
      0
    },
    PStruct(_, _) => 0
  }
}

/// #2348: add the `call $name` callees of an inline-wasm marker call
/// (`%wasm("<WAT>")`) to `out`. A no-op for every other call.
fn collect_wat_callee_refs(graph: DceGraph, callee: Expr, args: Array[Expr], bound: Array[String], out: Array[Int]) -> Int {
  match callee {
    EIdent(cname, _) => if cname == inline_wasm_marker_name() && Array::length(args) == 1 {
      match Array::get(args, 0) {
        EString(wat, _) => {
          let names = wat_callee_names(wat)
          let mut i = 0
          while i < Array::length(names) {
            // NOT add_ref: `bound` holds the expression's value binders, and a
            // WAT `$name` callee is a wasm FUNCTION name, a namespace of its
            // own. `fn caller(helper: Int) = wasm"(call $helper (local.get
            // $helper))"` calls the fn and reads the param, and the assembler
            // already keeps those apart -- filtering by `bound` here dropped
            // the call edge and DCE then pruned the live helper.
            dce_refs_push_once(graph, out, Array::get(names, i))
            i = i + 1
          }
          0
        },
        _ => 0
      }
    } else {
      0
    },
    _ => 0
  }
}

fn collect_refs_into(graph: DceGraph, expr: Expr, bound: Array[String], out: Array[Int]) -> Int {
  match expr {
    EIdent(name, _) => add_ref(graph, out, bound, name),
    EInt(_) => 0,
    EFloat(_) => 0,
    EString(_, _) => 0,
    EBool(_) => 0,
    EUnit => 0,
    EBreak(_) => 0,
    EContinue(_) => 0,
    EReturn(e) => collect_refs_into(graph, e, bound, out),
    EUnaryOp(_, e) => collect_refs_into(graph, e, bound, out),
    ETuple(items) => {
      let mut i = 0
      while i < Array::length(items) {
        collect_refs_into(graph, Array::get(items, i), bound, out)
        i = i + 1
      }
      0
    },
    EArray(items) => {
      let mut i = 0
      while i < Array::length(items) {
        collect_refs_into(graph, Array::get(items, i), bound, out)
        i = i + 1
      }
      0
    },
    ERecord(_, fields, _) => {
      let mut i = 0
      while i < Array::length(fields) {
        let (_, val) = Array::get(fields, i)
        collect_refs_into(graph, val, bound, out)
        i = i + 1
      }
      0
    },
    EBinOp(_, l, r, _) => {
      collect_refs_into(graph, l, bound, out)
      collect_refs_into(graph, r, bound, out)
      0
    },
    ECall(callee, args, _) => {
      collect_refs_into(graph, callee, bound, out)
      // #2348: an inline-wasm body reaches here as `%wasm("<WAT text>")`, and
      // the text is an EString, which contributes nothing below. A
      // `(call $helper ...)` inside it is a real reference, so without this
      // arm DCE prunes a helper that only a kernel calls and codegen then
      // reports it missing -- while `vibe check`, which runs on the unpruned
      // statements, reports clean.
      collect_wat_callee_refs(graph, callee, args, bound, out)
      let mut i = 0
      while i < Array::length(args) {
        collect_refs_into(graph, Array::get(args, i), bound, out)
        i = i + 1
      }
      0
    },
    EIf(cond, then_e, else_e) => {
      collect_refs_into(graph, cond, bound, out)
      collect_refs_into(graph, then_e, bound, out)
      collect_refs_into(graph, else_e, bound, out)
      0
    },
    ELet(name, val, body, _) => {
      collect_refs_into(graph, val, bound, out)
      let mark = Array::length(bound)
      Array::push(bound, name)
      collect_refs_into(graph, body, bound, out)
      Array::truncate(bound, mark)
      0
    },
    ELetRec(name, val, body) => {
      let mark = Array::length(bound)
      Array::push(bound, name)
      collect_refs_into(graph, val, bound, out)
      collect_refs_into(graph, body, bound, out)
      Array::truncate(bound, mark)
      0
    },
    ELetMut(name, val, body, _) => {
      collect_refs_into(graph, val, bound, out)
      let mark = Array::length(bound)
      Array::push(bound, name)
      collect_refs_into(graph, body, bound, out)
      Array::truncate(bound, mark)
      0
    },
    EAssign(_, val, body) => {
      collect_refs_into(graph, val, bound, out)
      collect_refs_into(graph, body, bound, out)
      0
    },
    EAssignOp(_, _, val, body) => {
      collect_refs_into(graph, val, bound, out)
      collect_refs_into(graph, body, bound, out)
      0
    },
    ESeq(l, r) => {
      collect_refs_into(graph, l, bound, out)
      collect_refs_into(graph, r, bound, out)
      0
    },
    EMatch(scr, arms) => {
      collect_refs_into(graph, scr, bound, out)
      let mut i = 0
      while i < Array::length(arms) {
        let (pat, body) = Array::get(arms, i)
        let mark = Array::length(bound)
        collect_pat_bindings(pat, bound)
        collect_refs_into(graph, body, bound, out)
        Array::truncate(bound, mark)
        i = i + 1
      }
      0
    },
    EHandle(body_expr, arms) => {
      collect_refs_into(graph, body_expr, bound, out)
      let mut i = 0
      while i < Array::length(arms) {
        let (pat, arm_body) = Array::get(arms, i)
        let mark = Array::length(bound)
        collect_pat_bindings(pat, bound)
        collect_refs_into(graph, arm_body, bound, out)
        Array::truncate(bound, mark)
        i = i + 1
      }
      0
    },
    EWhile(cond, body) => {
      collect_refs_into(graph, cond, bound, out)
      collect_refs_into(graph, body, bound, out)
      0
    },
    ELoop(params, body) => {
      let mark = Array::length(bound)
      let mut i = 0
      while i < Array::length(params) {
        let (name, init) = Array::get(params, i)
        collect_refs_into(graph, init, bound, out)
        Array::push(bound, name)
        i = i + 1
      }
      collect_refs_into(graph, body, bound, out)
      Array::truncate(bound, mark)
      0
    },
    EForIn(name, index_name, iter, body) => {
      collect_refs_into(graph, iter, bound, out)
      let mark = Array::length(bound)
      Array::push(bound, name)
      match index_name {
        Some(index_name) => Array::push(bound, index_name),
        None => ()
      }
      collect_refs_into(graph, body, bound, out)
      Array::truncate(bound, mark)
      0
    },
    EFn(_, _, params, _, _, body) => {
      let mark = Array::length(bound)
      let mut i = 0
      while i < Array::length(params) {
        let (pname, _) = Array::get(params, i)
        Array::push(bound, pname)
        i = i + 1
      }
      collect_refs_into(graph, body, bound, out)
      Array::truncate(bound, mark)
      0
    },
    EDot(obj, _, _, _) => {
      collect_refs_into(graph, obj, bound, out)
      0
    },
    ELabeledArg(_, _, e) => {
      collect_refs_into(graph, e, bound, out)
      0
    },
    EMap(fields) => {
      let mut i = 0
      while i < Array::length(fields) {
        let (_, val) = Array::get(fields, i)
        collect_refs_into(graph, val, bound, out)
        i = i + 1
      }
      0
    },
    ESpread(e) => {
      collect_refs_into(graph, e, bound, out)
      0
    },
    EStringInterp(_) => 0
  }
}

fn collect_refs(graph: DceGraph, expr: Expr, bound: Array[String]) -> Array[Int] {
  dce_refs_begin(graph)
  let out = array_empty()
  collect_refs_into(graph, expr, bound, out)
  out
}

fn enqueue_reachable(graph: DceGraph, queue: Array[Int], id: Int) -> Unit {
  if !Array::get(graph.live, id) {
    Array::set(graph.live, id, true)
    Array::push(queue, id)
  } else {
    ()
  }
}

fn collect_structural_refs_into_queue(graph: DceGraph, stmt: Stmt, bound: Array[String], queue: Array[Int]) -> Unit {
  let refs = match stmt {
    STest(_, expr) => collect_refs(graph, expr, bound),
    SBench(_, expr) => collect_refs(graph, expr, bound),
    SExpr(expr) => collect_refs(graph, expr, bound),
    _ => array_empty()
  }
  let mut i = 0
  while i < Array::length(refs) {
    enqueue_reachable(graph, queue, Array::get(refs, i))
    i = i + 1
  }
}

fn is_type_or_structural(stmt: Stmt) -> Bool {
  match stmt {
    SEnum(_, _, _, _, _) => true,
    SSuberror(_, _, _) => true,
    SEffectDef(_, _, _, _) => true,
    SStruct(_, _, _, _, _, _) => true,
    STypeAlias(_, _, _, _) => true,
    STrait(_, _, _, _, _, _) => true,
    SImpl(_, _, _, _) => true,
    SExternLet(_, _) => true,
    // ADR-0075 Phase 2 (#1343): a resource declaration is a requirement the
    // executable states, not a value anything references, so reachability
    // must never drop it.
    SResource(_, _) => true,
    SImport(_, _) => true,
    SAliasDecl(_, _) => true,
    STest(_, _) => true,
    SBench(_, _) => true,
    SExpr(_) => true,
    SExport(_) => true,
    SReExport(_, _) => true,
    SModule(_, _, _) => true,
    _ => false
  }
}

fn dce_definition_refs(graph: DceGraph, stmt: Stmt, bound: Array[String]) -> Array[Int] {
  match stmt {
    SLet(_, _, _, _, expr) => collect_refs(graph, expr, bound),
    SLetMut(_, _, expr) => collect_refs(graph, expr, bound),
    // Contract conditions execute after lowering; their callees stay live.
    SFnDecl(_, _, fn_value, reqs, enss) => {
      dce_refs_begin(graph)
      let out = array_empty()
      let _ = collect_refs_into(graph, fn_value, bound, out)
      let mut i = 0
      while i < Array::length(reqs) {
        let _ = collect_refs_into(graph, Array::get(reqs, i), bound, out)
        i = i + 1
      }
      let mut j = 0
      while j < Array::length(enss) {
        let _ = collect_refs_into(graph, Array::get(enss, j), bound, out)
        j = j + 1
      }
      out
    },
    _ => array_empty()
  }
}

fn dce_reachable_graph(stmts: Array[Stmt], entry_names: Array[String]) -> DceGraph {
  let graph = dce_graph_new(Array::length(stmts))
  let bound = array_empty()
  let mut i = 0
  while i < Array::length(stmts) {
    let stmt = Array::get(stmts, i)
    match stmt_name(stmt) {
      Some(name) => {
        let id = dce_symbol_id(graph, name)
        Array::push(graph.stmt_ids, id)
        let di = Array::length(graph.def_refs)
        // Several definitions may share a spelling. Follow every definition,
        // even if that spelling was first interned by a forward reference.
        Array::push(graph.def_next, Array::get(graph.heads, id))
        Array::set(graph.heads, id, di)
        Array::push(graph.def_refs, dce_definition_refs(graph, stmt, bound))
      },
      None => Array::push(graph.stmt_ids, -1)
    }
    i = i + 1
  }
  let queue: Array[Int] = []
  let mut j = 0
  while j < Array::length(entry_names) {
    enqueue_reachable(graph, queue, dce_symbol_id(graph, Array::get(entry_names, j)))
    j = j + 1
  }
  let mut sj = 0
  while sj < Array::length(stmts) {
    collect_structural_refs_into_queue(graph, Array::get(stmts, sj), bound, queue)
    sj = sj + 1
  }
  let mut qi = 0
  while qi < Array::length(queue) {
    let id = Array::get(queue, qi)
    qi = qi + 1
    let mut di = Array::get(graph.heads, id)
    while di >= 0 {
      let refs = Array::get(graph.def_refs, di)
      let mut r = 0
      while r < Array::length(refs) {
        enqueue_reachable(graph, queue, Array::get(refs, r))
        r = r + 1
      }
      di = Array::get(graph.def_next, di)
    }
  }
  graph
}

export fn dce_stmts(stmts: Array[Stmt], entry_names: Array[String]) -> Array[Stmt] {
  if Array::length(stmts) == 0 {
    Array::slice(stmts, 0, 0)
  } else {
    let graph = dce_reachable_graph(stmts, entry_names)
    let result = array_empty()
    let mut i = 0
    while i < Array::length(stmts) {
      let stmt = Array::get(stmts, i)
      let id = Array::get(graph.stmt_ids, i)
      // Output remains in source order, independent of ID assignment and
      // traversal order through duplicate definitions.
      if is_type_or_structural(stmt) || id < 0 || Array::get(graph.live, id) {
        Array::push(result, stmt)
      } else {
        ()
      }
      i = i + 1
    }
    result
  }
}

fn dce_keep_stmt(stmt: Stmt, graph: DceGraph) -> Bool {
  if is_type_or_structural(stmt) {
    true
  } else {
    match stmt_name(stmt) {
      Some(name) => match MutMap::get(graph.symbols, name) {
        Some(id) => Array::get(graph.live, id),
        None => false
      },
      None => true
    }
  }
}

/// Per-original-index keep flags from DCE, parallel to `stmts`. Lets callers
/// (e.g. module-source emission) map surviving statements back to their source
/// spans without relying on statement identity/equality. Result length equals
/// `Array::length(stmts)`.
export fn dce_keep_flags(stmts: Array[Stmt], entry_names: Array[String]) -> Array[Bool] {
  dce_keep_flags_via(stmts, stmts, entry_names)
}

/// `dce_keep_flags` with reachability computed over `reach_stmts` instead of
/// `stmts`. Module-source emission needs this split (#2516): its statement
/// list comes from `parse_program_spans`, which carries one bodyless `SImpl`
/// per impl so that the impl text is emitted once, and reachability walked
/// over that list cannot see a call made from an impl method. `reach_stmts`
/// is the full parse of the same program, whose impl method bindings are
/// the statements `stmts` lacks. Every impl is emitted whole (an `SImpl` is
/// structural and always kept), so each of those method bindings is a root:
/// whatever a method calls must survive, or the flat source does not
/// compile. The flags still index `stmts`.
export fn dce_keep_flags_via(stmts: Array[Stmt], reach_stmts: Array[Stmt], entry_names: Array[String]) -> Array[Bool] {
  let flags = array_empty()
  if Array::length(stmts) == 0 {
    flags
  } else {
    let span_names = MutSet::new_string()
    let mut sn = 0
    while sn < Array::length(stmts) {
      match stmt_name(Array::get(stmts, sn)) {
        Some(name) => MutSet::add(span_names, name),
        None => ()
      }
      sn = sn + 1
    }
    let roots = array_empty()
    let mut en = 0
    while en < Array::length(entry_names) {
      Array::push(roots, Array::get(entry_names, en))
      en = en + 1
    }
    let mut rn = 0
    while rn < Array::length(reach_stmts) {
      match stmt_name(Array::get(reach_stmts, rn)) {
        Some(name) => if MutSet::has(span_names, name) {
          ()
        } else {
          Array::push(roots, name)
        },
        None => ()
      }
      rn = rn + 1
    }
    let graph = dce_reachable_graph(reach_stmts, roots)
    let mut m = 0
    while m < Array::length(stmts) {
      Array::push(flags, dce_keep_stmt(Array::get(stmts, m), graph))
      m = m + 1
    }
    flags
  }
}
