  ("vibe_hs_close_raw", CtFn(reg_p1(CtInt), CtInt, None), true, false, false),
  ("Stdin::read_char", CtFn(reg_p0(), CtInt, Some("Stdin")), true, false, true),
  ("simd_skip_ws", CtFn(reg_p3(CtBytes, CtInt, CtInt), CtInt, None), true, true, true),
