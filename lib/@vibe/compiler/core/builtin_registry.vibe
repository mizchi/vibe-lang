  ("array_new", CtFn(reg_p0(), CtArray(reg_any()), None), true, true, true),
  ("Array::length", CtFn(reg_p1(CtArray(reg_any())), CtInt, None), true, true, true),
  ("Array::get", CtFn(reg_p2(CtArray(reg_any()), CtInt), reg_any(), None), true, true, true),
