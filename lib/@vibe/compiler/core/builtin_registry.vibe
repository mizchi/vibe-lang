                                 #|String::length F1;si- TTTTTFF
                                 #|String::equals F2;ssb- TTTTTFF
                                 #|String::concat F2;sss- TTTTFFF
                                 #|Array::with_capacity F1;iAv0;- TTTFFFT
                                 #|array_new F0;Av0;- TTTFFFF
                                 #|Array::length F1;Av0;i- TTTTTFF
                                 #|Array::get F2;Av0;iv0;- TTTTTTF
                                 #|Array::push F2;Av0;v0;u- TTTFFFT
                                 #|Array::push_all F2;Av0;Av0;u- TTTFFFF
                                 #|Array::set F3;Av0;iv0;u- TTTTTFT
                                 #|Float64::to_int F1;di- TTTTTFF
                                 #|Int::to_float64 F1;id- TTTTFFF
                                 #|# #2344: scalar bit primitives. Both lanes -- these are ordinary wasm
                                 #|# instructions, not SIMD, and rank/select needs them far more than it needs
                                 #|# a vector (bench/bench_simd_rank.vibe: i64.popcnt carries 344x of 438x).
                                 #|Int::popcount F1;ii- TTTFTFF
                                 #|Int::ctz F1;ii- TTTFTFF
                                 #|Int::clz F1;ii- TTTFTFF
                                 #|String::char_code_at F2;sii- TTTTTFF
                                 #|String::from_char_code F1;is- TTTTFFF
                                 #|String::substring F3;siis- TTTTFFF
                                 #|Array::truncate F2;Av0;iu- TTTFTFF
                                 #|String::join F2;Asss- TTTTFFF
                                 #|# #1513: POLYMORPHIC — `eq` is the structural equality builtin and is applied
                                 #|# to enums / structs / strings, not just Int. The `CtInt` placeholder here was
                                 #|# harmless while nothing read these parameter types; once the checker's
                                 #|# fast-path argument check started consulting the registry it turned into a
                                 #|# false rejection (measured: `eq(Color::Red, c)` in
                                 #|# docs/language-tour/basics.vibe.md).
                                 #|#
                                 #|# #2442: the two positions are ONE variable, not two `reg_any()`s. Written
                                 #|# as independent unknowns the row said only "two arguments of some type",
                                 #|# which `registry_builtin_pure_arity` refuses outright (`types_mention_unknown`)
                                 #|# -- so `eq` had no value form even with the bare-name clause gone, measured
                                 #|# `registry_builtin_pure_arity("eq") = -1` on ae838ff. It is also the
                                 #|# `FrozenArray` lesson #2451 records one screen up: a value form typed from
                                 #|# independent unknowns loses the relationship, and `let f = eq` would then
                                 #|# check `f(1, "x")` clean. One variable says what `eq` means -- both operands
                                 #|# are the same type.
                                 #|#
                                 #|# Direct calls are unchanged: every consumer but `registry_builtin_scheme`
                                 #|# reads the ERASED view, where `type_erase_vars` puts `CtUnknown` back, so
                                 #|# `eq(Color::Red, c)` keeps tolerating exactly what it tolerated. Parameter
                                 #|# COUNT and return type are unchanged, so the derived `builtin_registry()`
                                 #|# view the codegen lanes read is byte-identical.
                                 #|eq F2;v0;v0;b- TTTFTFF
                                 #|String::ends_with F2;ssb- TTTTTFF
                                 #|String::last_index_of F2;ssi- TTTTTFF
                                 #|String::index_of F2;ssi- TTTTTFF
                                 #|String::contains F2;ssb- TTTTTFF
                                 #|String::starts_with F2;ssb- TTTTTFF
                                 #|String::split F2;ssAs- TTTTFFF
                                 #|String::trim F1;ss- TTTTFFF
                                 #|compiler_sources F0;s- TFFFFFF
                                 #|ArrayBuilder::new F0;oArrayBuilder;- TTTFFFT
                                 #|ArrayBuilder::push F2;oArrayBuilder;?u- TTTFFFT
                                 #|ArrayBuilder::freeze F1;oArrayBuilder;A?- TTTFFFT
                                 #|# #906: FrozenArray[T] -- a checker-only phantom-type wrapper over
                                 #|# Array[T]'s exact same runtime layout (same technique as ArrayBuilder
                                 #|# just above: from_array/to_array are pure identity casts, get/length
                                 #|# alias Array::get/Array::length's own bodies -- see
                                 #|# gc/backend_body.vibe and wasi/linked_compile.vibe). checker.vibe's
                                 #|# FrozenArray::* ECall branches still refine the DIRECT call with the real
                                 #|# per-call-site element type -- they are tolerant where these rows are not
                                 #|# (measured: `FrozenArray::length` on an `Array[Int]` checks clean), so they
                                 #|# are not redundant yet. #2451 gave the rows real variables for the VALUE
                                 #|# form, which had no refinement to fall back on: before that,
                                 #|# `let freeze = FrozenArray::from_array` then
                                 #|# `let fz: FrozenArray[String] = freeze([1, 2])` checked clean and read the
                                 #|# Ints as Strings. These rows also exist so both codegen lanes' func-table
                                 #|# registration (which is DRIVEN by this registry, #415 B-1) has a row to
                                 #|# loop over.
                                 #|FrozenArray::from_array F1;Av0;NFrozenArray;1;v0;- TTTFFFF
                                 #|FrozenArray::get F2;NFrozenArray;1;v0;iv0;- TTTFTFF
                                 #|FrozenArray::length F1;NFrozenArray;1;v0;i- TTTFTFF
                                 #|FrozenArray::to_array F1;NFrozenArray;1;v0;Av0;- TTTFFFF
                                 #|Array::slice F3;Av0;iiAv0;- TTTFFFT
                                 #|Array::concat F2;Av0;Av0;Av0;- TTTTFFF
                                 #|Bytes::new F0;y- TTTFFFF
                                 #|Bytes::with_capacity F1;iy- TTTFFFF
                                 #|Bytes::from_array F1;Aiy- TTTFFFF
                                 #|Bytes::to_array F1;yAi- TTTFFFF
                                 #|Bytes::length F1;yi- TTTTTFF
                                 #|Bytes::get F2;yii- TTTTTFF
                                 #|Bytes::set F3;yiiu- TTTFTFT
                                 #|Bytes::push F2;yiu- TTTFFFF
                                 #|Bytes::append F2;yyu- TTTFFFF
                                 #|Bytes::concat F2;yyy- TTTFFFF
                                 #|Bytes::slice F3;yiiy- TTTFFFF
                                 #|Bytes::index_of_bytes F2;yyi- TTTTTFF
                                 #|Bytes::index_of F2;yii- TTTTTFF
                                 #|Bytes::count F2;yii- TTTTTFF
                                 #|Bytes::last_index_of F2;yii- TTTTTFF
                                 #|Bytes::compare F2;yyi- TTTTTFF
                                 #|__to_string F1;?s- TTTTFFF
                                 #|vibe_rc_drop F1;?u- TFFFTFF
                                 #|vibe_rc_alloc F1;ii- TFFFFFF
                                 #|vibe_rc_dup F1;?u- TFFFTFF
                                 #|vibe_heap_grow_check F0;u- TFFFTFF
                                 #|not F1;bb- FTTTTFF
                                 #|Bytes::blit F4;yyiiu- TTTFFFF
                                 #|Bytes::fill F3;yiiu- FTTFFFF
                                 #|Float64::from_i64_bits F1;id- FTTFFFF
                                 #|Float64::to_float32 F1;df- FTFFFFF
                                 #|Float32::to_float64 F1;fd- FTFFFFF
                                 #|Char::to_int F1;ci- FTTTTFF
                                 #|Char::from_int F1;ic- FTTTTFF
                                 #|Int::to_float32 F1;if- FTTTFFF
                                 #|# #3730: the 32-bit integer conversions. Widening is total; narrowing is
                                 #|# checked (`None` out of range) or wrapping by name. All of them, and
                                 #|# `to_string`, are rewritten to `Int` operations after the check
                                 #|# (`rewrite_int32_stmts`), so no lane lowers these names.
                                 #|Int32::to_int F1;Ii- FFTTFFF
                                 #|UInt32::to_int F1;Ui- FFTTFFF
                                 #|Int::to_int32 F1;iOI- FFTTFFF
                                 #|Int::to_uint32 F1;iOU- FFTTFFF
                                 #|Int::wrap_int32 F1;iI- FFTTFFF
                                 #|Int::wrap_uint32 F1;iU- FFTTFFF
                                 #|Int32::to_string F1;Is- FFTTFFF
                                 #|UInt32::to_string F1;Us- FFTTFFF
                                 #|FixedArray::make F2;i?A?- FTTFFFF
                                 #|FixedArray::length F1;A?i- FTTFTFF
                                 #|FixedArray::get F2;A?i?- FTTFTFF
                                 #|FixedArray::set F3;A?i?u- FTTFTFF
                                 #|FixedArray::unsafe_set F3;A?i?u- FTTFTFF
                                 #|FixedArray::blit F5;A?iA?iiu- FTTFTFF
                                 #|# #835: Int64Array rides on the same linear-memory Array representation
                                 #|# as FixedArray (Array[Int] already stores the full 62-bit tagged Int
                                 #|# per cell, no i32-cell truncation in these backends — unlike the
                                 #|# retired MoonBit host, which needed a distinct i64-cell object layout).
                                 #|# So this is a pure name-level alias onto Array::make/length/get/set,
                                 #|# just typed concretely as Array[Int] instead of FixedArray's generic
                                 #|# Array[Unknown] (cheatsheet documents it strictly for Int word buffers).
                                 #|Int64Array::make F2;iiAi- FTTFFFF
                                 #|Int64Array::length F1;Aii- FTTFTFF
                                 #|Int64Array::get F2;Aiii- FTTFTFF
                                 #|Int64Array::set F3;Aiiiu- FTTFTFF
                                 #|StringBuilder::new F0;oStringBuilder;- FTTFFFT
                                 #|StringBuilder::push F2;oStringBuilder;su- FTTFFFT
                                 #|StringBuilder::freeze F1;oStringBuilder;s- FTTFFFT
                                 #|Map::get F2;oMap;??- FTTTFTF
                                 #|Map::keys F1;oMap;A?- FTTFFFF
                                 #|MapBuilder::new F0;oMapBuilder;- FTTFFFF
                                 #|MapBuilder::set F3;oMapBuilder;??u- FTTFFFF
                                 #|MapBuilder::freeze F1;oMapBuilder;oMap;- FTTFFFF
                                 #|# #1310: has_key/get read the builder without freezing (O(n) scan over
                                 #|# the same handle-indirect storage MapBuilder::set already walks -- see
                                 #|# its search loop in expr/compile_call.vibe / gc/backend_call.vibe).
                                 #|# `get` returns Option[V] (built via a synthesized Some/None `ce` call,
                                 #|# same technique as int_parse_expr / Array::find), not the "0 on miss"
                                 #|# raw-value convention Map::get uses. #2334: the key is `any` here, as
                                 #|# `Map::get`'s is: the map arms (checker_call_map.vibe) check it against
                                 #|# the builder's key slot.
                                 #|MapBuilder::has_key F2;oMapBuilder;?b- FTTFTFF
                                 #|MapBuilder::get F2;oMapBuilder;?O?- FTTFFFF
                                 #|abort F1;su- FFTFTFT
                                 #|assert F1;bu- FTTFTFT
                                 #|assert_true F1;bu- FTTFTFF
                                 #|assert_eq F2;??u- FTTFTFF
                                 #|# #2107: not `None`. Codegen lowers both names onto the tty host
                                 #|# imports, and `builtin_purity` already classifies them impure, so a
                                 #|# `None` row here was the checker alone claiming these are pure. It let
                                 #|# a `fn main allows ()` write to the terminal with a clean `vibe check`.
                                 #|# The row is `Console`, the spelling the book and the diagnostic use.
                                 #|println F1;su!Console; FTTFTFF
                                 #|print F1;su!Console; FTTFTFF
                                 #|map_has F2;oMap;?b- FTTFTFF
                                 #|# Private opt-in native CPU service for independent lowering instances.
                                 #|# Append to preserve existing resolved builtin identifiers.
                                 #|compiler_lowering_run F1;ii!Exception; TFTFFFF

/// typed row: (name, checker signature, in_linear_table, in_gc_table,
/// checker_visible, is_pure, is_non_allocating, is_borrow_ret, is_safe_mut).
/// The last four are the #2584 classification columns: a new builtin is a
/// new row in `registry_rows_text`, and the four lists (pure /
/// non-allocating / borrow-returning / safe-mut) are derived from these flags
/// plus a small extras set of names that are not registry rows.
/// `builtin_registry_typed` still returns the five-tuple lane view; the
/// columns stay on this table.
///
/// Module-level `let`: initialized ONCE (see
/// fixtures/module_let_memo_test.vibe) -- lookup_registry_builtin runs on
/// every unresolved-name lookup in the checker, and rebuilding the rows per
/// call was allocation churn heavy enough to crash the RC-mode in-process
/// compiler tests.
let registry_typed_rows: Array[(String, Type, Bool, Bool, Bool, Bool, Bool, Bool, Bool)] = registry_rows_decode(registry_rows_text)

fn registry_rows_decode(_ text: String) -> Array[(String, Type, Bool, Bool, Bool, Bool, Bool, Bool, Bool)] {
  let out: Array[(String, Type, Bool, Bool, Bool, Bool, Bool, Bool, Bool)] = []
  for line in String::split(text, sep = "\n") {
    if String::length(line) > 0 && !String::starts_with(line, prefix = "#") {
      let cols = String::split(line, sep = " ")
      let pos = [0]
      let ty = registry_type_decode(s = Array::get(cols, at = 1), pos = pos)
      let f = Array::get(cols, at = 2)
      Array::push(out, value = (Array::get(cols, at = 0), ty, registry_flag(f = f, at = 0), registry_flag(f = f, at = 1), registry_flag(f = f, at = 2), registry_flag(f = f, at = 3), registry_flag(f = f, at = 4), registry_flag(f = f, at = 5), registry_flag(f = f, at = 6)))
    }
  }
  out
}

fn registry_flag(f: String, at: Int) -> Bool {
  String::byte_at(f, at = at) == 84
}

/// The text up to the next `;` from `pos`, which moves past it.
fn registry_type_word(s: String, pos: Array[Int]) -> String {
  let start = Array::get(pos, at = 0)
  let mut k = start
  while String::byte_at(s, at = k) != 59 {
    k = k + 1
  }
  Array::set(pos, at = 0, value = k + 1)
  String::substring(s, start = start, end = k)
}

fn registry_type_count(s: String, pos: Array[Int]) -> Int {
  match Int::parse(registry_type_word(s = s, pos = pos)) {
    Some(n) => n,
    None => 0
  }
}

fn registry_types_decode(s: String, pos: Array[Int], n: Int) -> Array[Type] {
  let out: Array[Type] = []
  let mut k = 0
  while k < n {
    Array::push(out, value = registry_type_decode(s = s, pos = pos))
    k = k + 1
  }
  out
}

/// One type of `registry_rows_text`'s prefix code, read from `pos`.
fn registry_type_decode(s: String, pos: Array[Int]) -> Type {
  let c = String::byte_at(s, at = Array::get(pos, at = 0))
  Array::set(pos, at = 0, value = Array::get(pos, at = 0) + 1)
  if c == 105 {
    CtInt
  } else if c == 115 {
    CtString
  } else if c == 117 {
    CtUnit
  } else if c == 98 {
    CtBool
  } else if c == 121 {
    CtBytes
  } else if c == 100 {
    CtDouble
  } else if c == 102 {
    CtFloat
  } else if c == 99 {
    CtChar
  } else if c == 73 {
    CtInt32
  } else if c == 85 {
    CtUInt32
  } else if c == 111 {
    reg_opaque(registry_type_word(s = s, pos = pos))
  } else if c == 83 {
    reg_stdin_stream()
  } else if c == 118 {
    reg_var(registry_type_count(s = s, pos = pos))
  } else if c == 65 {
    CtArray(registry_type_decode(s = s, pos = pos))
  } else if c == 79 {
    CtOption(registry_type_decode(s = s, pos = pos))
  } else if c == 78 {
    let name = registry_type_word(s = s, pos = pos)
    let n = registry_type_count(s = s, pos = pos)
    CtNamed(name, registry_types_decode(s = s, pos = pos, n = n))
  } else if c == 70 {
    let n = registry_type_count(s = s, pos = pos)
    let params = registry_types_decode(s = s, pos = pos, n = n)
    let ret = registry_type_decode(s = s, pos = pos)
    let row_mark = String::byte_at(s, at = Array::get(pos, at = 0))
    Array::set(pos, at = 0, value = Array::get(pos, at = 0) + 1)
    let row = if row_mark == 33 {
      Some(registry_type_word(s = s, pos = pos))
    } else {
      None
    }
    CtFn(params, ret, row)
  } else {
    reg_any()
  }
}

/// #2451: the memo for the ERASED view below. Filled on first use rather than
/// at module init so it cannot depend on module-level `let` ordering.
let registry_typed_rows_erased: Array[(String, Type, Bool, Bool, Bool)] = []

/// The rows as every consumer but the value form sees them: each `reg_var`
/// erased back to `CtUnknown`, so a row that gained real variables reads
/// EXACTLY as it did before (`type_erase_vars`, core/types.vibe, explains why
/// the separation is load-bearing). Rows with no variables are shared, not
/// copied.
export fn builtin_registry_typed() -> Array[(String, Type, Bool, Bool, Bool)] {
  if Array::length(registry_typed_rows_erased) == 0 {
    let mut i = 0
    while i < Array::length(registry_typed_rows) {
      let (name, ty, in_linear, in_gc, visible, _pure, _na, _br, _sm) = Array::get(registry_typed_rows, at = i)
      let vars: Array[Int] = []
      collect_type_var_ids(ty = ty, out = vars)
      let erased = if Array::length(vars) == 0 {
        ty
      } else {
        type_erase_vars(ty)
      }
      Array::push(registry_typed_rows_erased, value = (name, erased, in_linear, in_gc, visible))
      i = i + 1
    }
  } else {
    ()
  }
  registry_typed_rows_erased
}

/// #2451: the row CLOSED into a scheme -- `CtForAll(row variables, [], row)`
/// when it uses `reg_var`, the row itself otherwise, and `None` when the name
/// is not a checker-visible row.
///
/// This is the only reader of the un-erased rows, and the value-form path in
/// the checker is its only caller: it instantiates the scheme so each use site
/// gets its own copy of the row's variables. That is what makes
/// `let get = Array::get` then `let s: String = get([1], 0)` fail with the
/// same message the direct call gives, instead of checking clean and printing
/// garbage.
export fn registry_builtin_scheme(_ name: String) -> Option[Type] {
  let row = registry_first_visible_row(name)
  if row < 0 {
    None
  } else {
    let (_, ty, _, _, _, _, _, _, _) = Array::get(registry_typed_rows, at = row)
    let vars: Array[Int] = []
    collect_type_var_ids(ty = ty, out = vars)
    if Array::length(vars) == 0 {
      Some(ty)
    } else {
      Some(CtForAll(vars, empty_registry_var_bounds(), ty))
    }
  }
}

/// A registry row's variables carry no trait bounds: the rows describe wasm
/// builtins, whose lowering is one instruction sequence for every element
/// type. A bound here would be a claim the codegen cannot honor.
fn empty_registry_var_bounds() -> Array[(Int, Array[String])] {
  array_empty()
}

/// Derived 5-tuple view for the two codegen lanes -- SAME shape as the B-0/B-1
/// table so wasi/linked_compile.vibe and gc/backend_body.vibe are unchanged:
/// param_count = the type's parameter count, returns = 0 iff the return type
/// is CtUnit. #1539's StdinStream::close is the one ABI exception: its hidden
/// raw core route returns tagged zero, which is exactly Unit's value, so it
/// stays value-returning so its direct public call shares the raw import's
/// exact value-returning ABI; source-level operation values are rejected.
export fn builtin_registry() -> Array[(String, Int, Int, Bool, Bool)] {
  let rows = builtin_registry_typed()
  let out = array_empty()
  let mut i = 0
  while i < Array::length(rows) {
    let (name, ty, in_linear, in_gc, _) = Array::get(rows, at = i)
    let (pc, ret) = match ty {
      CtFn(params, ret_ty, _) => {
        let r = match ret_ty {
          CtUnit => if name == "StdinStream::close" {
            1
          } else {
            0
          },
          _ => 1
        }
        (Array::length(params), r)
      },
      _ => (0, 1)
    }
    Array::push(out, value = (name, pc, ret, in_linear, in_gc))
    i = i + 1
  }
  out
}

/// #1513: the parameter COUNT of a checker-visible registry row, or -1 when the
/// name is not one. Split out from `lookup_registry_builtin` because the
/// checker's direct-call FAST PATH (`checker.vibe::builtin_fixed_arity`)
/// deliberately avoids `lookup_builtin` -- #626's seed-heap constraint was about
/// BUILDING nested `CtFn`/`Array` values per call, and this reads the
/// already-built row without constructing anything.
///
/// Before this, that fast path checked arity against a hand-maintained list in
/// checker.vibe, so `Stdout::write_stream()` / `Fs::read_file("a", "b")` /
/// `Env::get("A", "B")` were silently unchecked and emitted an invalid module
/// (measured: the host rejected it at load with `expected 1 elements on the
/// stack for fallthru`, no source position). Which builtins got checked was the
/// maintenance state of that list, not a rule of the language.
export fn registry_builtin_arity(_ name: String) -> Int {
  let row = registry_first_visible_row(name)
  if row < 0 {
    0 - 1
  } else {
    let (_, ty, _, _, _) = Array::get(builtin_registry_typed(), at = row)
    match ty {
      CtFn(params, _, _) => Array::length(params),
      _ => 0 - 1
    }
  }
}

/// #2442: the parameter count of a checker-visible registry row whose type is
/// a function with an EMPTY effect row, or -1 for anything else -- a name that
/// is not a registry row, a row that is not a function, or a row that carries
/// an effect.
///
/// This is the property that replaced `builtin_ident_has_value_form`'s
/// two-name list (`core/builtin_name.vibe`). The arity is what an eta-expansion
/// needs, so returning it rather than a Bool keeps the decision and the
/// lowering reading the same number: a value form is emitted with exactly the
/// parameter count this reports.
///
/// Two boundaries, and neither is an omission.
///
/// The EFFECT row: a direct call to `Fs::read_file` has its row checked at the
/// call site against the capability the caller holds; as a VALUE the row would
/// have to be carried by the binding's function type and demanded again at the
/// indirect call, or `let f = Fs::read_file` launders authority
/// (ADR-0075/0084/0088). Until that is built, an effectful builtin keeps the
/// positioned diagnostic.
///
/// An UNKNOWN anywhere in the signature (Codex review on #2448): the registry
/// spells a polymorphic row with `reg_any()` = `CtUnknown`, and every
/// occurrence is independent -- nothing says the element in `Array::get`'s
/// parameter and its result are the same type. A direct call survives that
/// through its dedicated refinements; a value exposes the raw row and the
/// relationship is gone. Measured: `let get = Array::get` then
/// `let s: String = get([1], 0)` checked CLEAN and printed garbage, while
/// `Array::get([1], 0)` in the same position was correctly rejected with
/// `expected String, got Int`. `Array::push` through a binding loses the same
/// way. So an unknown-bearing row has no sound value form until the registry
/// can express the relationship, which is a change to the registry, not here.
export fn registry_builtin_pure_arity(_ name: String) -> Int {
  // #2451: the UN-erased rows. A row spelled with `reg_var` mentions no
  // unknown, so it passes the test below and gains a value form; the erased
  // view would put `CtUnknown` back and refuse every one of them.
  let row = registry_first_visible_row(name)
  if row < 0 {
    0 - 1
  } else {
    let (_, ty, _, _, _, _, _, _, _) = Array::get(registry_typed_rows, at = row)
    match ty {
      CtFn(params, ret, eff) => match eff {
        Some(_) => 0 - 1,
        None => if types_mention_unknown(params) || type_has_unknown(ret) {
          0 - 1
        } else {
          Array::length(params)
        }
      },
      _ => 0 - 1
    }
  }
}

fn types_mention_unknown(_ ts: Array[Type]) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(ts) {
    if type_has_unknown(Array::get(ts, at = i)) {
      found = true
      i = Array::length(ts)
    } else {
      i = i + 1
    }
  }
  found
}

/// #1513: the declared type of a checker-visible registry row's parameter `i`,
/// or None when the name is not a registry row / has no such parameter.
///
/// Companion to `registry_builtin_arity`, for the same reason and with the same
/// cost profile: the checker's direct-call fast path avoids `lookup_builtin`
/// because #626's seed-heap constraint was about BUILDING nested `CtFn`/`Array`
/// values per call, and this reads the already-built row.
///
/// Returning the TYPE rather than a head kind keeps `head_kind` (and its
/// tolerate-on-unknown rule) in the checker, which is the only place that knows
/// what an "unchecked" head means.
export fn registry_builtin_param_type(name: String, i: Int) -> Option[Type] {
  let row = registry_first_visible_row(name)
  if row < 0 {
    None
  } else {
    let (_, ty, _, _, _) = Array::get(builtin_registry_typed(), at = row)
    match ty {
      CtFn(params, _, _) => if i >= 0 && i < Array::length(params) {
        Some(Array::get(params, at = i))
      } else {
        None
      },
      _ => None
    }
  }
}

/// B-2: the checker-facing lookup, consulted FIRST by
/// checker/builtin_sigs/builtins.vibe::lookup_builtin. Only checker_visible rows resolve;
/// codegen-internal names stay invisible to user code.
// #2386: a sorted view of the registry's names with the row each slot came
// from, built once per process next to the erased rows (the registry is a
// constant). lookup_registry_builtin used to scan every row per query --
// the checker, the contract engine and the evidence pass ask it per call
// site or per declaration -- and now binary-searches the view. The sort is
// stable and the search leftmost, so the first visible row of a name wins
// exactly as the scan answered.
let registry_typed_sorted: Array[String] = []

let registry_typed_sorted_pos: Array[Int] = []

fn registry_typed_index() -> Unit {
  if Array::length(registry_typed_sorted) == 0 {
    let rows = builtin_registry_typed()
    let names = array_empty()
    let mut i = 0
    while i < Array::length(rows) {
      let (rname, _, _, _, _) = Array::get(rows, at = i)
      Array::push(names, value = rname)
      i = i + 1
    }
    let perm = sort_perm_by_names(names)
    i = 0
    while i < Array::length(perm) {
      let row = Array::get(perm, at = i)
      Array::push(registry_typed_sorted, value = Array::get(names, at = row))
      Array::push(registry_typed_sorted_pos, value = row)
      i = i + 1
    }
  } else {
    ()
  }
}

/// The index of the first checker-visible row named `name`, or -1: one
/// leftmost binary search of the sorted view and a forward read of the equal
/// run. The erased rows are built one-to-one from the un-erased rows in the
/// same order, so the index reads either table. #2386: every "first visible
/// row" scan (lookup, arity, pure arity, parameter type, scheme) goes through
/// it; `registry_builtin_pure_arity` alone was asked per identifier by the
/// lambda-site count.
fn registry_first_visible_row(_ name: String) -> Int {
  registry_typed_index()
  let rows = builtin_registry_typed()
  let mut slot = bsearch_leftmost(sorted = registry_typed_sorted, name = name)
  let mut found = 0 - 1
  while slot >= 0 && slot < Array::length(registry_typed_sorted) && Array::get(registry_typed_sorted, at = slot) == name {
    let row = Array::get(registry_typed_sorted_pos, at = slot)
    let (_, _, _, _, visible) = Array::get(rows, at = row)
    if visible {
      found = row
      slot = -1
    } else {
      slot = slot + 1
    }
  }
  found
}

export fn lookup_registry_builtin(_ name: String) -> Option[Type] {
  let row = registry_first_visible_row(name)
  if row < 0 {
    None
  } else {
    let (_, ty, _, _, _) = Array::get(builtin_registry_typed(), at = row)
    Some(ty)
  }
}

/// The builtins codegen dispatches BY SPELLING into a runtime prelude
/// (codegen/common_base/double_runtime.vibe, string_views_runtime.vibe) with
/// no registry row and no func-table entry under this name: typed on the
/// checker's fallback chain, lowered by a callsite arm on each lane. Two
/// consumers must agree on the list, so it lives here: the linear lane's
/// lambda capture scan (common_analysis.vibe, which must not capture the
/// spelling as a free variable) and the #2378 collector (checker_stmt.vibe,
/// which must refuse a dependency's definition at one of these names exactly
/// as it refuses a registry name's -- the guarded arms honor any definition
/// in the merged function table, so an unrefused dependency shadow would be
/// an unrequested override, Codex review on #2708).
export fn runtime_prelude_dispatched_builtin_name(_ name: String) -> Bool {
  name == "String::unicode_length" || name == "String::utf16_length" || name == "String::utf8_length" || name == "Float64::to_string" || name == "Float32::to_string" || name == "Float64::parse"
}

/// The declared return type of the builtin spelled `name`, or `None` when no
/// builtin has that spelling. A registry row answers first; the few builtins
/// typed without a row (the runtime-prelude ones above and the checker's
/// per-namespace lookups) answer from `builtin_return_extra`.
///
/// Codegen used to keep its own spelling lists for "this builtin returns Int"
/// (`ts_int_returning_builtin_name`) and "returns Bool / String"
/// (`cc_builtin_call_ret_kind` and two gc copies). Nothing tied them to the
/// rows, so they drifted: `Bytes::get`, `Char::to_int` and `Int::popcount`
/// were Int to the checker and unknown to codegen. Reading the row makes a
/// new builtin classify where it is declared.
///
/// Spelling only: the caller still owes the shadow check (a local or a user
/// `fn` of the same name owns the call, and its return type is not this one).
/// Any row counts, checker-visible or not -- an invisible row is still the
/// type the lowered call returns.
export fn builtin_declared_return(_ name: String) -> Option[Type] {
  let row = registry_first_row(name)
  if row < 0 {
    builtin_return_extra(name)
  } else {
    let (_, ty, _, _, _, _, _, _, _) = Array::get(registry_typed_rows, at = row)
    match ty {
      CtFn(_, ret, _) => Some(ret),
      _ => None
    }
  }
}

/// Return types of the builtins codegen classifies that have no registry row.
/// A name here must not also be a row (`builtin_return_extras_with_rows`
/// keeps that true), or the two answers could disagree.
let builtin_return_extras: Array[(String, Type)] = [
  ("String::unicode_length", CtInt),
  ("String::utf16_length", CtInt),
  ("String::utf8_length", CtInt),
  ("Array::any", CtBool),
  ("Array::all", CtBool),
  ("Map::has_key", CtBool),
  ("Map::has", CtBool),
  ("Path::is_absolute", CtBool),
  ("Int::to_string", CtString),
  ("Float64::to_string", CtString),
  ("Float32::to_string", CtString)
]

fn builtin_return_extra(_ name: String) -> Option[Type] {
  let mut i = 0
  let mut found = None
  while i < Array::length(builtin_return_extras) {
    let (extra, ret) = Array::get(builtin_return_extras, at = i)
    if extra == name {
      found = Some(ret)
      i = Array::length(builtin_return_extras)
    } else {
      i = i + 1
    }
  }
  found
}

/// The `builtin_return_extras` names that ALSO have a registry row -- empty
/// unless a row was added for one of them, in which case the extra entry is
/// dead and should go. Pinned empty by core/builtin_declared_return_test.vibe.
export fn builtin_return_extras_with_rows() -> Array[String] {
  let out: Array[String] = []
  let mut i = 0
  while i < Array::length(builtin_return_extras) {
    let (name, _) = Array::get(builtin_return_extras, at = i)
    if registry_first_row(name) >= 0 {
      Array::push(out, value = name)
    } else {
      ()
    }
    i = i + 1
  }
  out
}

/// `builtin_declared_return(name)` is `Int`. Spelling only; see there.
export fn builtin_returns_int(_ name: String) -> Bool {
  match builtin_declared_return(name) {
    Some(CtInt) => true,
    _ => false
  }
}

/// `builtin_declared_return(name)` is `Bool`. Spelling only; see there.
export fn builtin_returns_bool(_ name: String) -> Bool {
  match builtin_declared_return(name) {
    Some(CtBool) => true,
    _ => false
  }
}

/// `builtin_declared_return(name)` is `String`. Spelling only; see there.
export fn builtin_returns_string(_ name: String) -> Bool {
  match builtin_declared_return(name) {
    Some(CtString) => true,
    _ => false
  }
}

/// Every registry effect label must have standard provider or entry-execution
/// policy metadata. The registry is operation-keyed while this policy is
/// label-keyed, so this guard prevents a new host builtin from silently
/// missing its standard execution policy.
///
/// The guard intentionally covers registry rows only; labels still present in
/// checker if-chains cannot be enumerated here. It is called from
/// tests/standard_effect_policy_test.vibe and follows `verify_lane_builtins`.
export fn verify_standard_effect_policy_coverage() -> Unit with Exception {
  let rows = builtin_registry_typed()
  let mut i = 0
  while i < Array::length(rows) {
    let (name, ty, _, _, _) = Array::get(rows, at = i)
    match ty {
      CtFn(_, _, Some(eff)) => if has_standard_effect_policy(eff) {
        ()
      } else {
        throw("standard effect policy drift: builtin '\{name}' carries effect label '\{eff}', which has no standard policy in lib/@vibe/compiler/core/standard_effect_policy.vibe. Add its provider or entry-execution policy row.")
      },
      _ => ()
    }
    i = i + 1
  }
}

/// #415 B-0: assert one lane's registered (names, param_counts, returns)
/// arrays agree with the registry. Called by each backend builder right after
/// it finishes its registration pushes; throws with a named diff on any
/// drift. O(n^2) over ~100 entries at compile start — noise next to a parse.
export fn verify_lane_builtins(lane: String, names: Array[String], param_counts: Array[Int], returns: Array[Int]) -> Unit with Exception {
  let is_gc = lane == "gc"
  let reg = builtin_registry()
  // 1. every registered name must have a matching registry row
  let mut i = 0
  while i < Array::length(names) {
    let n = Array::get(names, at = i)
    let mut found = false
    let mut ri = 0
    while ri < Array::length(reg) {
      let (rn, rp, rr, rlin, rgc) = Array::get(reg, at = ri)
      if rn == n {
        found = true
        let claimed = if is_gc {
          rgc
        } else {
          rlin
        }
        if claimed {
          ()
        } else {
          throw("builtin registry drift: '\{n}' is registered by the \{lane} lane but the registry says it is not in that lane's table (lib/@vibe/compiler/core/builtin_registry.vibe, #415)")
        }
        if rp == Array::get(param_counts, at = i) && rr == Array::get(returns, at = i) {
          ()
        } else {
          throw("builtin registry drift: '\{n}' signature mismatch in the \{lane} lane — registry says (params=\{rp}, returns=\{rr}), lane registered (params=\{Array::get(param_counts, at = i)}, returns=\{Array::get(returns, at = i)}) (#415)")
        }
        ri = Array::length(reg)
      } else {
        ri = ri + 1
      }
    }
    if found {
      ()
    } else {
      throw("builtin registry drift: '\{n}' is registered by the \{lane} lane but has no row in lib/@vibe/compiler/core/builtin_registry.vibe (#415) — add one (and decide the other lane explicitly)")
    }
    i = i + 1
  }
  // 2. every registry row claiming this lane must actually be registered.
  // Exemption: the linear lane registers vibe_rc_drop/vibe_rc_alloc only when RC is
  // enabled (VIBE_RC), so their absence in a bump-mode build is not drift —
  // they stay direction-1 verified (if registered, the signature must match).
  let mut ri2 = 0
  while ri2 < Array::length(reg) {
    let (rn2, _, _, rlin2, rgc2) = Array::get(reg, at = ri2)
    let claimed2 = (if is_gc {
      rgc2
    } else {
      rlin2
    }) && not(String::starts_with(rn2, prefix = "vibe_rc_"))
    if claimed2 {
      let mut found2 = false
      let mut i2 = 0
      while i2 < Array::length(names) {
        if Array::get(names, at = i2) == rn2 {
          found2 = true
          i2 = Array::length(names)
        } else {
          i2 = i2 + 1
        }
      }
      if found2 {
        ()
      } else {
        throw("builtin registry drift: registry claims '\{rn2}' is in the \{lane} lane's table but the lane did not register it (#415)")
      }
    } else {
      ()
    }
    ri2 = ri2 + 1
  }
}

//# ADR-0091 (#1262): does this builtin allocate?

/// True when calling `name` may put something new on the heap.
///
/// **The polarity is deliberate: unknown names answer `true`.** This feeds
/// `#zero_alloc`, and there the two mistakes are not symmetric --
///
///   - answering `true` for a builtin that does not allocate REJECTS a valid
///     `#zero_alloc` function. Wrong, but the author sees a diagnostic naming
///     the site and can argue with it.
///   - answering `false` for one that DOES allocate lets an allocating
///     function pass the check. The annotation then certifies something
///     untrue, silently -- the P0 failure mode.
///
/// So the non-allocating FLAG on each registry row enumerates what
/// provably does NOT allocate, and everything else (including a builtin
/// added tomorrow with the flag left false) falls through to `true`. A new
/// builtin is over-reported until someone classifies it, never under-reported.
///
/// Floats are treated as allocating (`Int::to_float` and friends): the linear
/// backend heap-boxes them, which is exactly the implicit allocation ADR-0091
/// expects this check to make visible (#510).
export fn builtin_allocates(_ name: String) -> Bool {
  !builtin_is_non_allocating(name)
}

/// Classification columns of the named registry row, or all-false when the
/// name is not a row. (pure, non_allocating, borrow_ret, safe_mut).
///
/// Indexed the same way as `lookup_registry_builtin` (#2386). Walking
/// every registry row per query would undo that index:
/// `builtin_allocates` is asked per call site. Invisible rows still
/// classify -- `vibe_rc_drop` is checker-invisible and non-allocating.
fn registry_first_row(_ name: String) -> Int {
  registry_typed_index()
  let slot = bsearch_leftmost(sorted = registry_typed_sorted, name = name)
  if slot >= 0 && slot < Array::length(registry_typed_sorted) && Array::get(registry_typed_sorted, at = slot) == name {
    Array::get(registry_typed_sorted_pos, at = slot)
  } else {
    0 - 1
  }
}

fn registry_class_of(_ name: String) -> (Bool, Bool, Bool, Bool) {
  let row = registry_first_row(name)
  if row < 0 {
    (false, false, false, false)
  } else {
    let (_, _, _, _, _, rp, ra, rb, rs) = Array::get(registry_typed_rows, at = row)
    (rp, ra, rb, rs)
  }
}

fn names_with_class_bit(_ bit: Int) -> Array[String] {
  let out: Array[String] = []
  let mut i = 0
  while i < Array::length(registry_typed_rows) {
    let (n, _, _, _, _, rp, ra, rb, rs) = Array::get(registry_typed_rows, at = i)
    let on = if bit == 0 {
      rp
    } else if bit == 1 {
      ra
    } else if bit == 2 {
      rb
    } else {
      rs
    }
    if on {
      Array::push(out, value = n)
    } else {
      ()
    }
    i = i + 1
  }
  out
}

/// Registry names whose row is flagged pure. A copy: a caller that pushed
/// into the returned array would widen the suspend-class allowlist.
export fn registry_pure_builtin_names() -> Array[String] {
  names_with_class_bit(0)
}

/// #4146: a builtin whose only effect is the value it returns -- a
/// checker-visible registry row flagged pure, whose type carries no effect
/// row and returns something other than `Unit`. A call to one whose value is
/// thrown away does nothing. The pure flag alone is not this question: it is
/// the suspend-class allowlist, so it also admits `sleep`, the stdin stream
/// operations and `Array::set`, which act and are kept apart here by their row
/// or their `Unit` result.
///
/// A `__`-prefixed intrinsic (`__to_string`, `__generic_add`) is not a name a
/// program spells for its value: generated code and the compiler's own gates
/// call it as a statement on purpose, to exercise its lowering.
export fn builtin_result_is_its_only_effect(_ name: String) -> Bool {
  let row = registry_first_visible_row(name)
  if row < 0 || String::starts_with(name, prefix = "__") {
    false
  } else {
    let (_, ty, _, _, _, pure, _, _, _) = Array::get(registry_typed_rows, at = row)
    pure && match ty {
      CtFn(_, ret, None) => match ret {
        CtUnit => false,
        _ => true
      },
      _ => false
    }
  }
}

/// Registry names whose row is flagged safe-mut. Same copy rule as
/// `registry_pure_builtin_names`.
export fn registry_safe_mut_builtin_names() -> Array[String] {
  names_with_class_bit(3)
}

/// Names that are not registry rows but are still non-allocating. Length
/// views and Map iterator gets are served by callsite lowering, not a
/// func-table row; they keep this extras list so a new REGISTRY builtin
/// cannot hide here.
fn extra_non_allocating(_ name: String) -> Bool {
  name == "String::unicode_length" || name == "String::utf16_length" || name == "String::utf8_length" || name == "Map::iter_get" || name == "Map::__iter_get_unchecked"
}

/// Names that are not registry rows but are still borrow-returning.
/// ONE spelling (#1979, #2584): `borrow_ret_names_build` copies this into
/// the membership table that both `is_borrow_ret_builtin` and
/// `borrow_ret_builtin_names` read. Adding a name here and not there was
/// the MutList::get drift -- wrappers classified as owned-returning and
/// RC callers dropped an interior view (#1932).
let borrow_ret_extra_names: Array[String] = [
  "MutList::get",
  "Map::iter_get",
  "Map::__iter_get_unchecked",
  "__index",
  "__rec_field"
]

/// The borrow-RETURNING builtins: their result is an interior view sharing a
/// call argument's refcount (an element read in place), never a fresh owned
/// reference. Callers must not plan an independent drop for a binding of such
/// a result, and functions whose tails reduce to these are themselves
/// borrow-returning (#707).
///
/// SINGLE SOURCE OF TRUTH (#1979, #2584): registry rows carry the flag;
/// extras above are the names that are not rows. Perceus removes a
/// source-owned shadowable name from this seed before classifying calls.
/// The predicate SCANS this table -- it does not re-derive membership
/// from the row flags plus a second extras spelling.
fn borrow_ret_names_build() -> Array[String] {
  let out = names_with_class_bit(2)
  let mut i = 0
  while i < Array::length(borrow_ret_extra_names) {
    Array::push(out, value = Array::get(borrow_ret_extra_names, at = i))
    i = i + 1
  }
  out
}

let borrow_ret_builtin_name_table: Array[String] = borrow_ret_names_build()

/// Returns a fresh array on each call because
/// compute_borrow_returning_names' fixed-point worklist pushes discovered user
/// functions into the one it is given.
export fn borrow_ret_builtin_names() -> Array[String] {
  Array::slice(borrow_ret_builtin_name_table, start = 0, end = Array::length(borrow_ret_builtin_name_table))
}

/// Membership in `borrow_ret_builtin_names`, before source ownership is
/// applied by the whole-program Perceus classifier.
///
/// Scans the shared module-level table directly: this predicate runs once
/// per call site across the whole program, so it must not allocate a
/// fresh copy per query and must not walk the whole registry.
export fn is_borrow_ret_builtin(_ name: String) -> Bool {
  let names = borrow_ret_builtin_name_table
  let mut i = 0
  let mut found = false
  while i < Array::length(names) {
    if Array::get(names, at = i) == name {
      found = true
    } else {
      ()
    }
    i = i + 1
  }
  found
}

fn builtin_is_non_allocating(_ name: String) -> Bool {
  let (_, na, _, _) = registry_class_of(name)
  na || extra_non_allocating(name)
}
