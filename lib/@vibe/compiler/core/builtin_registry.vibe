//# Imports

import ./types.vibe {
  Type
}

// Standard host-provider and entry-execution policy is a sibling in this
// package, so the drift guard below reads it directly instead of through the
// @vibe/compiler/core facade.
import ./standard_effect_policy.vibe {
  has_standard_effect_policy
}

import @vibe/core {
  array_empty
}

//# Functions

// #415: the central declarative registry of func-table builtins across
// both backends. Row: (name, param_count, returns_value 0|1,
// in_linear_table, in_gc_table).
//
// B-1: this registry DRIVES both lanes' registration. The linear builder
// (wasi/linked_compile.vibe) and the gc builder (gc/backend_body.vibe) each
// loop over these rows (filtered by their lane flag) and only resolve the
// lane-local function/body INDEX via a per-lane match — names, param counts
// and returns exist ONLY here. Adding a builtin = one row here + one index
// match arm in each claiming lane (+ the import/body wiring). A row claiming
// a lane whose index match has no arm fails every build by name; the
// remaining verify_lane_builtins pass (below) guards any future hand-edited
// registration path against drifting from this table (the wasm-gc HOF-gap
// class of regression this issue exists to prevent).
//
// Lane semantics:
// - in_linear_table / in_gc_table refer to the lane's FUNC-TABLE registration
//   only. A name absent from a lane's table may still be served there by a
//   callsite lowering (expr/compile_call.vibe, gc/backend_call.vibe) or by
//   prelude vibe source — B-1 will classify those; B-0 pins what exists.
// - Host imports (Fs::/Env::/sleep/...) are linear-only by design: the gc
//   lane is the pure-test lane and gates host builtins out as a group.
// B-2: rows now carry the CHECKER TYPE as the single source of truth.
// param_count / returns for the lanes are DERIVED from that type
// (builtin_registry() below); the checker resolves these names through
// lookup_registry_builtin FIRST, so the per-namespace checker lookup files
// no longer need (and must not re-add) arms for registry names.
// checker_visible=false rows are codegen-internal (desugar/compile_call
// artifacts, RC runtime hooks, canonical-name aliases) -- the checker never
// sees those names, and their synthesized types only feed the derived
// param/returns view.

// #1520 提案2: rows spell the unconstrained type by MEANING, not by the raw
// constructor, so a reader can tell a deliberately-unchecked position from a
// placeholder someone forgot to fill in:
//
//   - reg_any()     — deliberately POLYMORPHIC: any value type is legal at this
//                     position and the checker's head-kind compare tolerates it
//                     (`eq` / `assert_eq`, container element types).
//   - reg_opaque(k) — an internal HANDLE with no checker-type representation
//                     (builder objects, Map). `k` names the handle kind for the
//                     reader; the value is ignored.
//   - bare CtUnknown — not allowed in rows. It reads as "not written yet",
//                     which is exactly how the #1519 `eq`-declared-as-CtInt
//                     class of lie stayed invisible: nothing distinguished a
//                     row nobody had thought about from a row deliberately
//                     left open.
//
// All three produce the same runtime value (CtUnknown) — this is documentation
// the type system cannot express, enforced by review + the golden positive
// corpus (builtin_registry_golden_test.vibe), not by the checker.
fn reg_any() -> Type {
  CtUnknown
}

fn reg_opaque(kind: String) -> Type {
  let _ = kind
  CtUnknown
}

fn reg_p0() -> Array[Type] {
  array_empty()
}

fn reg_p1(a: Type) -> Array[Type] {
  let arr = reg_p0()
  Array::push(arr, a)
  arr
}

fn reg_p2(a: Type, b: Type) -> Array[Type] {
  let arr = reg_p1(a)
  Array::push(arr, b)
  arr
}

fn reg_p3(a: Type, b: Type, c: Type) -> Array[Type] {
  let arr = reg_p2(a, b)
  Array::push(arr, c)
  arr
}

fn reg_p4(a: Type, b: Type, c: Type, d: Type) -> Array[Type] {
  let arr = reg_p3(a, b, c)
  Array::push(arr, d)
  arr
}

fn reg_p5(a: Type, b: Type, c: Type, d: Type, e: Type) -> Array[Type] {
  let arr = reg_p4(a, b, c, d)
  Array::push(arr, e)
  arr
}

/// typed row: (name, checker signature, in_linear_table, in_gc_table,
/// checker_visible). Module-level `let`: initialized ONCE (see
/// fixtures/module_let_memo_test.vibe) -- lookup_registry_builtin runs on
/// every unresolved-name lookup in the checker, and rebuilding 116 rows of
/// nested CtFn/Array values per call was allocation churn heavy enough to
/// crash the RC-mode in-process compiler tests.
let registry_typed_rows: Array[(String, Type, Bool, Bool, Bool)] = [
  ("Env::get", CtFn(reg_p1(CtString), CtString, Some("Env")), true, false, true),
  ("Env::args_len", CtFn(reg_p0(), CtInt, Some("Env")), true, false, true),
  ("Env::args_get", CtFn(reg_p1(CtInt), CtString, Some("Env")), true, false, true),
  ("Fs::read_file", CtFn(reg_p1(CtString), CtString, Some("Fs")), true, false, true),
  ("Fs::exists", CtFn(reg_p1(CtString), CtBool, Some("Fs")), true, false, true),
  ("Fs::stat_token", CtFn(reg_p1(CtString), CtInt, Some("Fs")), true, false, true),
  // #795: alias-collision-proof surface for the same import.
  ("vibe_fs_stat_token_raw", CtFn(reg_p1(CtString), CtInt, Some("Fs")), true, false, true),
  ("Fs::write_file", CtFn(reg_p2(CtString, CtString), CtUnit, Some("Fs")), true, false, true),
  // Registered but deliberately unused by compiler sources until the cache
  // publisher adopts it, preserving seed compatibility.
  ("Fs::publish_immutable_text", CtFn(reg_p2(CtString, CtString), CtBool, Some("Fs")), true, false, true),
  ("Fs::write_bytes", CtFn(reg_p2(CtString, CtBytes), CtUnit, Some("Fs")), true, false, true),
  ("Fs::read_bytes", CtFn(reg_p1(CtString), CtBytes, Some("Fs")), true, false, true),
  ("vibe_fs_read_dir_raw", CtFn(reg_p1(CtString), CtString, Some("Fs")), true, false, false),
  ("sh", CtFn(reg_p1(CtString), CtString, Some("Process")), true, false, true),
  ("vibe_sh_lines_raw", CtFn(reg_p1(CtString), CtString, Some("Process")), true, false, false),
  // #865: structured subprocess result. `vibe_sh_capture_raw` runs the
  // command ONCE (unlike a naive 3-accessor design that would re-run it)
  // and parks {exit_code, stdout, stderr} behind a handle -- same
  // handle+accessor shape as the #794 HTTP client imports below, chosen so
  // a structured result doesn't require struct-returning host ABI work.
  // checker_visible=true (unlike vibe_sh_lines_raw's raw half) because these
  // are plain qualified names (no bare "sh"/"sh_lines" collision risk), so
  // ordinary vibe source (lib/@vibe/process/process.vibe) calls them
  // directly, mirroring lib/@vibe/http/http.vibe's `vibe_http_*_raw`
  // direct-call convention -- no compile_call.vibe special-casing needed.
  ("vibe_sh_capture_raw", CtFn(reg_p1(CtString), CtInt, Some("Process")), true, false, true),
  ("vibe_sh_capture_exit_code_raw", CtFn(reg_p1(CtInt), CtInt, Some("Process")), true, false, true),
  ("vibe_sh_capture_stdout_raw", CtFn(reg_p1(CtInt), CtString, Some("Process")), true, false, true),
  ("vibe_sh_capture_stderr_raw", CtFn(reg_p1(CtInt), CtString, Some("Process")), true, false, true),
  ("vibe_sh_capture_close_raw", CtFn(reg_p1(CtInt), CtUnit, Some("Process")), true, false, true),
  // #903/#865: propagate a guest-chosen exit code to the real OS process
  // exit status (unlike a `main() -> Int` return, which `_start` only
  // PRINTS -- see ADR-0069's entry_returns_unit comment in
  // codegen/wasi/linked_compile.vibe). Traps via the host runner's
  // existing exit-trap mechanism (Rust `viberun`: reuses ExitTrap, the
  // same trap the legacy `__moonbit_sys_unstable::exit` import already
  // used; JS runner: `process.exit(code)` directly) -- never returns.
  ("vibe_process_exit_raw", CtFn(reg_p1(CtInt), CtUnit, Some("Process")), true, false, true),
  ("Stdin::read_stream", CtFn(reg_p1(CtInt), CtString, Some("Stdin")), true, false, true),
  ("Stdout::write_stream", CtFn(reg_p1(CtString), CtUnit, Some("Stdout")), true, false, true),
  ("Stdout::write_char", CtFn(reg_p1(CtInt), CtUnit, Some("Stdout")), true, false, true),
  // #865: Stderr, mirroring Stdout::write_stream / Stdout::write_char exactly
  // (own host effect name "Stderr" so a function using only stderr does not
  // need to declare `with Stdout`).
  ("Stderr::write_stream", CtFn(reg_p1(CtString), CtUnit, Some("Stderr")), true, false, true),
  ("Stderr::write_char", CtFn(reg_p1(CtInt), CtUnit, Some("Stderr")), true, false, true),
  // #1460 Phase 1: the `Console` capability -- one effect covering the three
  // tty streams, replacing Stdin/Stdout/Stderr. Both name sets are live here
  // ON PURPOSE and only for the length of the migration:
  //
  //   the committed seed knows ONLY the legacy three, and the seed is what
  //   compiles this file. So the compiler must learn `Console` in a build the
  //   seed can still produce, that build becomes the next seed, and only THEN
  //   can lib/ (this file included) move to `Console::*`. Deleting the legacy
  //   entries in the same commit that adds these would make the compiler
  //   unbuildable from its own seed.
  //
  // The stderr pair cannot keep its operation spelling once the effects
  // merge -- `Console::write_stream` is already taken by stdout -- so the
  // error side is named apart rather than disambiguated by effect.
  //
  // Phase 3 removes the six legacy entries above and this comment with them.
  ("Console::read_stream", CtFn(reg_p1(CtInt), CtString, Some("Console")), true, false, true),
  ("Console::read_char", CtFn(reg_p0(), CtInt, Some("Console")), true, false, true),
  ("Console::write_stream", CtFn(reg_p1(CtString), CtUnit, Some("Console")), true, false, true),
  ("Console::write_char", CtFn(reg_p1(CtInt), CtUnit, Some("Console")), true, false, true),
  ("Console::write_err_stream", CtFn(reg_p1(CtString), CtUnit, Some("Console")), true, false, true),
  ("Console::write_err_char", CtFn(reg_p1(CtInt), CtUnit, Some("Console")), true, false, true),
  ("resolve_path", CtFn(reg_p1(CtString), CtString, None), true, false, false),
  ("Fs::remove", CtFn(reg_p1(CtString), CtUnit, Some("Fs")), true, false, true),
  ("Fs::mkdir_p", CtFn(reg_p1(CtString), CtUnit, Some("Fs")), true, false, true),
  ("Fs::mkdir", CtFn(reg_p1(CtString), CtUnit, Some("Fs")), true, false, true),
  ("Fs::chdir", CtFn(reg_p1(CtString), CtUnit, Some("Fs")), true, false, true),
  ("Fs::copy", CtFn(reg_p2(CtString, CtString), CtUnit, Some("Fs")), true, false, true),
  ("Fs::append", CtFn(reg_p2(CtString, CtString), CtUnit, Some("Fs")), true, false, true),
  ("Fs::rename", CtFn(reg_p2(CtString, CtString), CtUnit, Some("Fs")), true, false, true),
  ("Fs::is_dir", CtFn(reg_p1(CtString), CtBool, Some("Fs")), true, false, true),
  ("Fs::is_file", CtFn(reg_p1(CtString), CtBool, Some("Fs")), true, false, true),
  ("Fs::getcwd", CtFn(reg_p0(), CtString, Some("Fs")), true, false, true),
  // Socket client host imports (vibe.tcp_*) -- same "checker-legal (see
  // builtins/declarations.vibe), zero codegen wiring" gap the Fs::* rows
  // above closed. #1232 review: raw dunder names, NOT `Socket::tcp_connect`
  // -- lib/@vibe/socket's package index.vpkg ALSO declares `effect
  // TcpSocket { Connect(String,Int)->Int; Read(Int,Int)->String;
  // Write(Int,String)->Unit; Close(Int)->Unit }` for its in-package
  // mock-handler tests, and that effect's operations are STRUCTURALLY
  // IDENTICAL in signature to these builtins -- a qualified call under the
  // `Socket::` name let the checker's effect-row resolution match BOTH the
  // builtin's own row and TcpSocket's, unioning a spurious `{ TcpSocket }`
  // requirement onto every caller. Same collision class Http's client-side
  // functions (lib/@vibe/http/http.vibe) already document and avoid via
  // `vibe_http_*_raw` naming -- follow that precedent here too.
  // checker_visible=true: no bare-name collision risk, so ordinary vibe
  // source (lib/@vibe/socket/tcp.vibe's low-level layer) calls them
  // directly, same convention as Fs::*/Http's client raw calls -- no
  // compile_call.vibe special-casing needed. Supersedes the now-dead
  // Socket::tcp_* arms in checker/builtins_net.vibe (lookup_registry_builtin
  // runs first; this file's file-header comment: per-namespace checker
  // lookup files "must not re-add" arms for registry names).
  ("vibe_tcp_connect_raw", CtFn(reg_p2(CtString, CtInt), CtInt, Some("Socket")), true, false, true),
  ("vibe_tcp_read_raw", CtFn(reg_p2(CtInt, CtInt), CtString, Some("Socket")), true, false, true),
  ("vibe_tcp_write_raw", CtFn(reg_p2(CtInt, CtString), CtUnit, Some("Socket")), true, false, true),
  ("vibe_tcp_close_raw", CtFn(reg_p1(CtInt), CtUnit, Some("Socket")), true, false, true),
  // #794: HTTP client host imports (vibe.http_*) -- host builtins are
  // linear-only by design (the gc lane is the pure-test lane).
  ("vibe_http_request_raw", CtFn(reg_p4(CtString, CtString, CtString, CtString), CtInt, Some("Http")), true, false, true),
  ("vibe_http_response_status_raw", CtFn(reg_p1(CtInt), CtInt, Some("Http")), true, false, true),
  ("vibe_http_response_header_raw", CtFn(reg_p2(CtInt, CtString), CtString, Some("Http")), true, false, true),
  ("vibe_http_response_body_raw", CtFn(reg_p1(CtInt), CtString, Some("Http")), true, false, true),
  ("vibe_http_close_raw", CtFn(reg_p1(CtInt), CtUnit, Some("Http")), true, false, true),
  ("Profiler::now_us", CtFn(reg_p0(), CtInt, Some("Profiler")), true, false, true),
  ("Profiler::NowUs", CtFn(reg_p0(), CtInt, None), true, false, false),
  // Current bump-heap pointer (bytes) — the allocation analog of now_us,
  // for per-phase memory attribution in profiles/benches.
  ("Profiler::heap_bytes", CtFn(reg_p0(), CtInt, Some("Profiler")), true, false, true),
  ("Profiler::HeapBytes", CtFn(reg_p0(), CtInt, None), true, false, false),
  ("sleep", CtFn(reg_p1(CtInt), CtUnit, Some("Async")), true, false, true),
  // #1227: same host import as `sleep`, but row-free -- see
  // checker/builtins_system.vibe for why the row cannot be discharged.
  ("sleep_blocking", CtFn(reg_p1(CtInt), CtUnit, None), true, false, true),
  // ADR-0089 step 4 (#1218): raw halves of `host_future_get` (the checker
  // surface lives in checker/builtins_async.vibe; compile_call lowers it to
  // a [state=2, handle] future cell over vibe_hf_get_raw). Both are
  // codegen-internal (checker_visible=false): user source never spells
  // them, they appear only in injected AST (the entry boundary's
  // `__entry_settle`) and the compile_call lowering. They lower to the
  // `vibe.host_future_get` / `vibe.host_future_wait` host imports, which
  // only the component adapter module provides (spec §3.13/§3.14) -- a
  // plain-wasm host has no waitable machinery to implement them with.
  ("vibe_hf_get_raw", CtFn(reg_p0(), CtInt, None), true, false, false),
  ("vibe_hf_wait_raw", CtFn(reg_p1(CtInt), CtInt, None), true, false, false),
  // ADR-0089 Decision 3 (#1218): the shared READ half of the named host
  // streams (`host_stream_named` / `host_stream_next`, spec §3.18) -- one
  // byte per call, -1 at end of stream. Codegen-internal like the vibe_hf_*
  // pair above: appears only in the injected `__entry_settle` stream arm,
  // lowers to the `vibe.host_stream_read` host import that only the
  // component adapter provides. The per-name GET halves
  // (`vibe_hs_get_raw$<name>`) are program-minted and registered
  // dynamically in linked_compile, exactly like `vibe_hf_get_raw$<name>`.
  ("vibe_hs_read_raw", CtFn(reg_p1(CtInt), CtInt, None), true, false, false),
  // ADR-0089 Decision 3 follow-up (#1218): the shared CLOSE half. Releases
  // the readable end of a host stream the guest stopped reading before end
  // of stream (`host_stream_close`, spec §3.18) -- the read half only drops
  // the end when it reaches EOS, so a partially consumed stream used to
  // hold its handle for the component instance's whole lifetime. Same
  // codegen-internal shape as the read half (injected `__hs_close` only),
