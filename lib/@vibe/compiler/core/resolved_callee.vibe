import ./call_placement.vibe {
  call_placement_cell_prefix
}

import @vibe/core {
  struct MutMap
}

import ./ast.vibe {
  Expr, Stmt
}
import ./expr_children.vibe {
  expr_child_at, expr_children_pop, expr_children_push, expr_children_top
}

import ./typed_lowering_rows.vibe {
  lowering_row_encode, lowering_row_payload, lowering_row_rebase, lowering_row_tag
}

// Operation identities are separate from source spellings and binding names.
// The call's fourth field retains the checker's answer through AST rewrites.
// Empty = not migrated; -1 = a program binding; positive = builtin operation.

export let builtin_mutbytes_empty: Int = 1
export let builtin_mutbytes_push: Int = 2
export let builtin_mutbytes_append: Int = 3
export let builtin_mutbytes_length: Int = 4
export let builtin_mutbytes_to_bytes: Int = 5
export let builtin_mutlist_empty: Int = 6
export let builtin_mutlist_push: Int = 7
export let builtin_mutlist_freeze: Int = 8
export let builtin_mutlist_to_array: Int = 9
export let builtin_mutlist_get: Int = 10
export let builtin_mutlist_length: Int = 11
export let builtin_mutlist_truncate: Int = 12
export let builtin_array_with_capacity: Int = 13
export let builtin_array_push: Int = 14
export let builtin_array_set: Int = 15

// Compiler-owned control forms are synthesized after checking. They are not
// ordinary callable builtins and have no runtime function-table rows.
export let builtin_frame_scope: Int = 16
export let builtin_frame_jump: Int = 17

// (source name, operation identity, arity, runtime alias).
let builtin_operations: Array[(String, Int, Int, String)] = [
  ("MutBytes::empty", builtin_mutbytes_empty, 1, ""),
  ("MutBytes::push", builtin_mutbytes_push, 2, "Bytes::push"),
  ("MutBytes::append", builtin_mutbytes_append, 2, "Bytes::append"),
  ("MutBytes::length", builtin_mutbytes_length, 1, "Bytes::length"),
  ("MutBytes::to_bytes", builtin_mutbytes_to_bytes, 1, ""),
  ("MutList::empty", builtin_mutlist_empty, 1, ""),
  ("MutList::push", builtin_mutlist_push, 2, "ArrayBuilder::push"),
  ("MutList::freeze", builtin_mutlist_freeze, 1, ""),
  ("MutList::to_array", builtin_mutlist_to_array, 1, ""),
  ("MutList::get", builtin_mutlist_get, 2, "Array::get"),
  ("MutList::length", builtin_mutlist_length, 1, "Array::length"),
  ("MutList::truncate", builtin_mutlist_truncate, 2, "Array::truncate"),
  ("Array::with_capacity", builtin_array_with_capacity, 1, "Array::with_capacity"),
  ("Array::push", builtin_array_push, 2, "Array::push"),
  ("Array::set", builtin_array_set, 3, "Array::set"),
  ("$scps_frame_scope", builtin_frame_scope, 2, ""),
  ("$scps_frame_jump", builtin_frame_jump, 3, "")
]

/// Source-name lookup belongs to the checker and explicit builtin factories.
export fn resolved_builtin_operation_from_source(name: String) -> Int {
  if !String::starts_with(name, "MutBytes::") && !String::starts_with(name, "MutList::") && !String::starts_with(name, "Array::") && !String::starts_with(name, "$scps_frame_") {
    0
  } else {
    let mut result = 0
    let mut i = 0
    while i < Array::length(builtin_operations) {
      let row = Array::get(builtin_operations, i)
      if row.0 == name {
        result = row.1
      } else {
        ()
      }
      i = i + 1
    }
    result
  }
}

// Codegen-only per-call annotation: [marker, site id, original cell...].
// It is attached to a fresh cell after normalization; shared checked calls
// and the original binding/builtin answer remain unchanged.
let return_call_marker: Int = -361604
export fn return_call_site(resolution: Array[Int]) -> Int {
  if Array::length(resolution) >= 2 && Array::get(resolution, 0) == return_call_marker && Array::get(resolution, 1) >= 0 {
    Array::get(resolution, 1)
  } else {
    -1
  }
}
export fn return_call_original(resolution: Array[Int]) -> Array[Int] {
  if return_call_site(resolution) >= 0 {
    Array::slice(resolution, 2, Array::length(resolution))
  } else {
    resolution
  }
}
export fn return_call_resolve(resolution: Array[Int], site: Int) -> Array[Int] {
  let original = return_call_original(resolution)
  let out = [return_call_marker, site]
  for item in original {
    Array::push(out, item)
  }
  out
}
export fn resolved_callee_operation(resolution: Array[Int]) -> Int {
  let n = Array::length(resolution)
  if n == 1 || call_placement_cell_prefix(resolution, 0) {
    Array::get(resolution, 0)
  } else if return_call_site(resolution) >= 0 && (n == 3 || call_placement_cell_prefix(resolution, 2)) {
    Array::get(resolution, 2)
  } else {
    0
  }
}

export fn builtin_operation_arity(operation: Int) -> Int {
  if operation >= 1 && operation <= Array::length(builtin_operations) {
    Array::get(builtin_operations, operation - 1).2
  } else {
    0 - 1
  }
}

/// Shared lowering targets explicitly name builtins, never program bindings.
export fn builtin_operation_alias(operation: Int) -> String {
  if operation >= 1 && operation <= Array::length(builtin_operations) {
    Array::get(builtin_operations, operation - 1).3
  } else {
    ""
  }
}

// Tag 7 in the per-module lowering carrier stores (call offset, identity).
// Its payload reserves 16 bits for identity; 0 represents a program binding.
// Compiler-source fingerprints invalidate sidecars using the old 3-bit layout.
let callee_identity_radix: Int = 65536
/// Rebase all typed-lowering channels without losing the callee identity.
export fn resolved_callee_row_rebase(row: Int, base: Int) -> Int {
  lowering_row_rebase(row, base)
}

let callee_capture: Array[Int] = []
export fn resolved_callee_capture_reset() -> Unit {
  Array::truncate(callee_capture, 0)
}
export fn resolved_callee_capture_record(offset: Int, operation: Int) -> Unit {
  if offset >= 0 && (operation == 0 - 1 || builtin_operation_arity(operation) >= 0) {
    let identity = if operation == 0 - 1 {
      0
    } else {
      operation
    }
    Array::push(callee_capture, lowering_row_encode(offset * callee_identity_radix + identity, 7))
  }
}
export fn resolved_callee_capture_rows() -> Array[Int] {
  Array::slice(callee_capture, 0, Array::length(callee_capture))
}
fn restore_callee_expr(expr: Expr, operations: MutMap[Int, Int]) -> Unit {
  match expr {
    ECall(_, _, offset, resolution) => {
      match MutMap::get(operations, offset) {
        Some(operation) => {
          if Array::length(resolution) == 0 {
            Array::push(resolution, operation)
          } else {
            Array::set(resolution, 0, operation)
          }
        },
        None => ()
      }
    },
    _ => ()
  }
  let mark = expr_children_push(expr)
  let end = expr_children_top()
  let mut child_index = mark
  while child_index < end {
    restore_callee_expr(expr_child_at(child_index), operations)
    child_index = child_index + 1
  }
  expr_children_pop(mark)
}
fn restore_callee_stmts(stmts: Array[Stmt], operations: MutMap[Int, Int]) -> Unit {
  let mut statement_index = 0
  while statement_index < Array::length(stmts) {
    match Array::get(stmts, statement_index) {
      SLet(_, _, _, _, body) => restore_callee_expr(body, operations),
      SLetMut(_, _, body) => restore_callee_expr(body, operations),
      SLetPat(_, body) => restore_callee_expr(body, operations),
      STest(_, body) => restore_callee_expr(body, operations),
      SBench(_, body) => restore_callee_expr(body, operations),
      SExpr(body) => restore_callee_expr(body, operations),
      SModule(_, _, children) => restore_callee_stmts(children, operations),
      _ => ()
    }
    statement_index = statement_index + 1
  }
}
export fn restore_resolved_callees(stmts: Array[Stmt], rows: Array[Int]) -> Unit {
  let mut has_callees = false
  for row in rows {
    if lowering_row_tag(row) == 7 {
      has_callees = true
    }
  }
  if has_callees {
    let operations: MutMap[Int, Int] = MutMap::new_int()
    for row in rows {
      if lowering_row_tag(row) == 7 {
        let payload = lowering_row_payload(row)
        let identity = payload % callee_identity_radix
        if identity == 0 || builtin_operation_arity(identity) >= 0 {
          MutMap::set(operations, payload / callee_identity_radix, if identity == 0 {
            0 - 1
          } else {
            identity
          })
        } else {
          ()
        }
      }
    }
    restore_callee_stmts(stmts, operations)
  }
}

/// For compiler-synthesized calls AFTER the caller resolved a builtin value.
/// Program references must go through the checker, never this factory.
export fn builtin_callee_resolution(name: String) -> Array[Int] {
  let operation = resolved_builtin_operation_from_source(name)
  if operation > 0 {
    [operation]
  } else {
    []
  }
}
