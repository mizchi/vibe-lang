//# Exports that outlive the executable strip
//
// An executable's export section is filtered right after the compile
// (`strip_executable_wasm`, cli_support, #1100): a flat module source spells
// every function `export`, and nothing outside can reasonably call the
// `*_exp_lib__*` module-linking names it produces, so only the entry,
// `_start`, `cli_main` and the per-block `__test_*` / `__bench_*` exports
// stay. Two codegen passes need that answer while they still have the
// program in hand -- `fold_const_bool_params` (is this exported function
// callable from outside?) and the module pruner (is this export a root?)
// -- so the keep list is spelled ONCE here, over an abstract byte reader,
// and the strip reads it from the same place. Whether the strip will run is
// the COMPILE's own input, not process state (#1953): every entry that will
// strip its output passes `exports_stripped = true` down its own call chain,
// and every other caller passes `false`, under which an export stays an
// export. Two compiles in one process -- nested, sequential, or one that
// threw half way -- therefore cannot see each other's answer.

//# The keep list

fn export_name_eq(len: Int, at: (Int) -> Int, s: String) -> Bool {
  if len != String::length(s) {
    false
  } else {
    let mut i = 0
    let mut same = true
    while same && i < len {
      if at(i) != String::char_code_at(s, at = i) {
        same = false
      } else {
        i = i + 1
      }
    }
    same
  }
}

fn export_name_starts_with(len: Int, at: (Int) -> Int, prefix: String) -> Bool {
  let plen = String::length(prefix)
  if len < plen {
    false
  } else {
    export_name_eq(len = plen, at = at, s = prefix)
  }
}

/// The one spelling of what the strip keeps, over a name of `len` bytes read
/// through `at`: the entry, `_start`, `cli_main` (the runners address it by
/// name), and the per-block test / bench exports.
fn executable_export_kept_by(len: Int, at: (Int) -> Int, entry_name: String) -> Bool {
  export_name_eq(len = len, at = at, s = entry_name) || export_name_eq(len = len, at = at, s = "_start") || export_name_eq(len = len, at = at, s = "cli_main") || export_name_starts_with(len = len, at = at, prefix = "__bench_") || export_name_starts_with(len = len, at = at, prefix = "__test_")
}

/// Is the export named by `wasm[start .. start + n)` kept?
export fn executable_export_kept_bytes(wasm: Bytes, start: Int, n: Int, entry_name: String) -> Bool {
  executable_export_kept_by(len = n, at = (i) -> Bytes::get(wasm, at = start + i), entry_name = entry_name)
}

/// Is the export `name` kept?
export fn executable_export_kept(name: String, entry_name: String) -> Bool {
  executable_export_kept_by(len = String::length(name), at = (i) -> String::char_code_at(name, at = i), entry_name = entry_name)
}
