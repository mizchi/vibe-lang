fn is_row_var_type_arg(_ t: Type) -> Bool {
  match row_var_type_arg(t) {
    Some(_) => true,
    None => false
  }
}

fn int_array_has_id(ids: Array[Int], id: Int) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(ids) {
    if Array::get(ids, at = i) == id {
      found = true
    } else {
      ()
    }
    i = i + 1
  }
  found
}

/// `subst_apply`, but `CtVar` ids in `keep` stay free. Used to keep an
/// explicit constructor parameter `F` quantified while still zonking
/// element variables the body solved.
export fn subst_apply_except(s: Subst, ty: Type, keep: Array[Int]) -> Type {
  subst_apply_except_go(s = s, ty = ty, keep = keep)
}

fn subst_apply_except_go(s: Subst, ty: Type, keep: Array[Int]) -> Type {
  match ty {
    CtVar(id) => if int_array_has_id(ids = keep, id = id) {
      CtVar(id)
    } else {
      subst_apply(s = s, ty = ty)
    },
    CtFn(params, ret, effect_name) => {
      let ps = array_empty()
      let mut i = 0
      while i < Array::length(params) {
        Array::push(ps, value = subst_apply_except_go(s = s, ty = Array::get(params, at = i), keep = keep))
        i = i + 1
      }
      CtFn(ps, subst_apply_except_go(s = s, ty = ret, keep = keep), resolve_effect_opt_preserving_open(s = s, eff = effect_name))
    },
    CtArray(elem) => CtArray(subst_apply_except_go(s = s, ty = elem, keep = keep)),
    CtOption(elem) => CtOption(subst_apply_except_go(s = s, ty = elem, keep = keep)),
    CtTuple(elems) => {
      let out = array_empty()
      let mut i = 0
      while i < Array::length(elems) {
        Array::push(out, value = subst_apply_except_go(s = s, ty = Array::get(elems, at = i), keep = keep))
        i = i + 1
      }
      CtTuple(out)
    },
    CtRecord(rfields) => {
      let out = array_empty()
      let mut i = 0
      while i < Array::length(rfields) {
        let (n, t) = Array::get(rfields, at = i)
        Array::push(out, value = (n, subst_apply_except_go(s = s, ty = t, keep = keep)))
        i = i + 1
      }
      CtRecord(out)
    },
    CtNamed(name, args) => {
      let ra = array_empty()
      let mut i = 0
      while i < Array::length(args) {
        let a = Array::get(args, at = i)
        Array::push(ra, value = match row_var_type_arg(a) {
          // #3589: a row argument resolves as the row of a `CtFn` does here.
          Some(v) => resolve_row_type_arg(arg = a, resolved = resolve_effect_opt_preserving_open(s = s, eff = Some(v))),
          None => subst_apply_except_go(s = s, ty = a, keep = keep)
        })
        i = i + 1
      }
      zonk_hkt(CtNamed(name, ra))
    },
    CtForAll(_, _, _) => ty,
    _ => ty
  }
}

fn unify_type_arrays(xs: Array[Type], ys: Array[Type], s: Subst) -> Option[Subst] {
  if Array::length(xs) != Array::length(ys) {
    None
  } else {
    let mut i = 0
    let mut acc = s
    let mut out = Some(s)
    let mut done = false
    while !done {
      if i >= Array::length(xs) {
        out = Some(acc)
        done = true
      } else {
        match unify(a = Array::get(xs, at = i), b = Array::get(ys, at = i), s = acc) {
          Some(s2) => {
            acc = s2
            i = i + 1
          },
          None => {
            out = None
            done = true
          }
        }
      }
    }
    out
  }
}

fn unify_hkt(ta: Type, tb: Type, s: Subst) -> Option[Subst] {
  match tb {
    CtVar(id) => if occurs_in(id = id, ty = ta) {
      None
    } else {
      Some(subst_bind_value(id = id, ty = ta, s = s))
    },
    _ => match ta {
      CtVar(id) => if occurs_in(id = id, ty = tb) {
        None
      } else {
        Some(subst_bind_value(id = id, ty = tb, s = s))
      },
      _ => unify_hkt_ctors(ta = ta, tb = tb, s = s)
    }
  }
}

fn unify_hkt_ctors(ta: Type, tb: Type, s: Subst) -> Option[Subst] {
  match ta {
    CtNamed(an, aa) => if an == hkt_app_name() && Array::length(aa) >= 1 {
      let a_head = Array::get(aa, at = 0)
      let a_rest = array_empty()
      let mut ai = 1
      while ai < Array::length(aa) {
        Array::push(a_rest, value = Array::get(aa, at = ai))
        ai = ai + 1
      }
      match tb {
        CtNamed(bn, ba) => if bn == hkt_app_name() && Array::length(ba) >= 1 {
          unify_type_arrays(xs = aa, ys = ba, s = s)
        } else if bn != hkt_app_name() {
          match unify(a = a_head, b = hkt_ctor(bn), s = s) {
            Some(s1) => unify_type_arrays(xs = a_rest, ys = ba, s = s1),
            None => None
          }
        } else {
          None
        },
        CtArray(e) => if Array::length(a_rest) == 1 {
          match unify(a = a_head, b = hkt_ctor("Array"), s = s) {
            Some(s1) => unify(a = Array::get(a_rest, at = 0), b = e, s = s1),
            None => None
          }
        } else {
          None
        },
        CtOption(e) => if Array::length(a_rest) == 1 {
          match unify(a = a_head, b = hkt_ctor("Option"), s = s) {
            Some(s1) => unify(a = Array::get(a_rest, at = 0), b = e, s = s1),
            None => None
          }
        } else {
          None
        },
        _ => None
      }
    } else {
      None
    },
    CtArray(e) => match tb {
      CtNamed(bn, ba) => if bn == hkt_app_name() && Array::length(ba) == 2 {
        match unify(a = hkt_ctor("Array"), b = Array::get(ba, at = 0), s = s) {
          Some(s1) => unify(a = e, b = Array::get(ba, at = 1), s = s1),
          None => None
        }
      } else {
        None
      },
      _ => None
    },
    CtOption(e) => match tb {
      CtNamed(bn, ba) => if bn == hkt_app_name() && Array::length(ba) == 2 {
        match unify(a = hkt_ctor("Option"), b = Array::get(ba, at = 0), s = s) {
          Some(s1) => unify(a = e, b = Array::get(ba, at = 1), s = s1),
          None => None
        }
      } else {
        None
      },
      _ => None
    },
    _ => match tb {
      CtNamed(bn, ba) => if bn == hkt_app_name() && Array::length(ba) >= 1 {
        unify_hkt(ta = tb, tb = ta, s = s)
      } else {
        None
      },
      _ => None
    }
  }
}

/// Look up a trait method's declared signature (param TypeExprs + return
/// TypeExpr) by trait name + method name. `Self` appears verbatim as
/// `TyName("Self")` in the stored signature; the caller substitutes it.
export fn trait_method_sig(env: TypeEnv, trait_name: String, method_name: String) -> Option[(Array[TypeExpr], TypeExpr)] {
  match trait_method_sig_binders(env = env, trait_name = trait_name, method_name = method_name) {
    Some(found) => {
      let (params, ret, _) = found
      Some((params, ret))
    },
    None => None
  }
}

/// The declared name at the head of a (possibly generic) named type, for
/// recognizing iterator-shaped trait impl targets. This query asks only about
/// the constructor's protocol shape, so it deliberately ignores retained type
/// arguments.
fn trait_target_head_name(_ ty: Type) -> String {
  match ty {
    CtNamed(n, _) => n,
    CtStruct(n) => n,
    CtEnum(n) => n,
    CtConstructor(n, _) => n,
    CtApplied(head, _) => type_constructor_name(head),
    _ => ""
  }
}

fn type_name_iterator_impl_scan(scan: TypeEnv, full: TypeEnv, type_name: String) -> Bool {
  match scan {
    EnvEmpty => false,
    EnvBind(_, _, rest) => type_name_iterator_impl_scan(scan = rest, full = full, type_name = type_name),
    EnvShowWrappers(_, _, rest) => type_name_iterator_impl_scan(scan = rest, full = full, type_name = type_name),
    EnvMutCell(_, _, rest) => type_name_iterator_impl_scan(scan = rest, full = full, type_name = type_name),
    EnvTraitDef(_, _, _, _, rest, _, _) => type_name_iterator_impl_scan(scan = rest, full = full, type_name = type_name),
    EnvTraitImpl(tname, target, rest) => {
      let hit = trait_target_head_name(target) == type_name && (match trait_method_sig(env = full, trait_name = tname, method_name = "next") {
        Some(_) => true,
        None => false
      })
      if hit {
        true
      } else type_name_iterator_impl_scan(scan = rest, full = full, type_name = type_name)
    },
    EnvTraitImplGen(_, _, _, _, rest) => type_name_iterator_impl_scan(scan = rest, full = full, type_name = type_name),
    EnvTypeDefs(_, _, rest) => type_name_iterator_impl_scan(scan = rest, full = full, type_name = type_name),
    EnvFlat(_) => false,
    EnvCached(_, _, rest) => type_name_iterator_impl_scan(scan = rest, full = full, type_name = type_name)
  }
}

/// True iff a type named `type_name` has an `impl Tr for type_name` where the
/// trait `Tr` declares a `next` method — i.e. the type is iterator-shaped
/// (`Iterator[T] { next(Self) -> Option[(T, Self)] }`). The checker's `for x in
/// it` element-type inference uses this to recognise struct-trait iterators
/// (`LazyIter`, async streams, …) and bind the loop variable to the iterator's
/// element type instead of `CtUnknown`.
export fn type_name_has_iterator_impl(env: TypeEnv, type_name: String) -> Bool {
  type_name_iterator_impl_scan(scan = env, full = env, type_name = type_name)
}

/// #1358: is this trait's `next` the ASYNC one (`-> Future[..]`) rather than the
/// sync `-> Option[..]`? That return head is the single bit the dict-passing
/// desugar switches on when it decides to wrap each loop step in `await(..)`
/// (`fn_return_is_future` in desugar_trait_dict.vibe), so the checker reads the
/// same bit from the trait declaration to decide whether the loop needs `Async`.
fn trait_next_returns_future(env: TypeEnv, trait_name: String) -> Bool {
  match trait_method_sig(env = env, trait_name = trait_name, method_name = "next") {
    Some(sig) => {
      let (_, ret) = sig
      match ret {
        TyApp(n, _) => n == "Future",
        TyName(n) => n == "Future",
        _ => false
      }
    },
    None => false
  }
}

fn type_name_async_iterator_impl_scan(scan: TypeEnv, full: TypeEnv, type_name: String) -> Bool {
  match scan {
    EnvEmpty => false,
    EnvBind(_, _, rest) => type_name_async_iterator_impl_scan(scan = rest, full = full, type_name = type_name),
    EnvShowWrappers(_, _, rest) => type_name_async_iterator_impl_scan(scan = rest, full = full, type_name = type_name),
    EnvMutCell(_, _, rest) => type_name_async_iterator_impl_scan(scan = rest, full = full, type_name = type_name),
    EnvTraitDef(_, _, _, _, rest, _, _) => type_name_async_iterator_impl_scan(scan = rest, full = full, type_name = type_name),
    EnvTraitImpl(tname, target, rest) => {
      let hit = trait_target_head_name(target) == type_name && trait_next_returns_future(env = full, trait_name = tname)
      if hit {
        true
      } else type_name_async_iterator_impl_scan(scan = rest, full = full, type_name = type_name)
    },
    // #1347/#1358 (Codex P1 on PR #1364): a GENERIC impl (`impl [T] AIter for
    // Iter[T]`) is recorded as EnvTraitImplGen, and skipping it here let the
    // async loop through unchecked -- the desugar has no such distinction (it
    // sees the lowered `Iter::next` and injects `await` on a Future return),
    // so a generically-implemented async iterator suspended from a row-free
    // function with no diagnostic. Verified against a repro that RAN the await
    // loop (a sync EForIn over the struct would have trapped). This protocol
    // query is constructor-shaped, so head-name matching mirrors the
    // non-generic arm even though the complete impl target is retained.
    //
    // The SYNC sibling scan above deliberately keeps skipping this case: it
    // feeds element-type inference, where widening the match would change
    // inferred types across the codebase rather than close a soundness hole.
    EnvTraitImplGen(tname, _, _, target, rest) => {
      let hit = trait_target_head_name(target) == type_name && trait_next_returns_future(env = full, trait_name = tname)
      if hit {
        true
      } else type_name_async_iterator_impl_scan(scan = rest, full = full, type_name = type_name)
    },
    EnvTypeDefs(_, _, rest) => type_name_async_iterator_impl_scan(scan = rest, full = full, type_name = type_name),
    EnvFlat(_) => false,
    EnvCached(_, _, rest) => type_name_async_iterator_impl_scan(scan = rest, full = full, type_name = type_name)
  }
}

/// #1358: the ASYNC half of type_name_has_iterator_impl — true iff `type_name`
/// implements an iterator trait whose `next` yields a `Future`, i.e. driving it
/// with `for x in it` awaits every step. The `await(..)` is injected AFTER the
/// checker (desugar_trait_dicts), so the effect pass cannot see an async
/// primitive in the program text and has to recognise the loop by its iterand's
/// type instead — see check_async_effects_expr's EForIn arm.
export fn type_name_has_async_iterator_impl(env: TypeEnv, type_name: String) -> Bool {
  type_name_async_iterator_impl_scan(scan = env, full = env, type_name = type_name)
}

/// Like `trait_method_sig_binders` but follows supertraits transitively. The
/// binders come from whichever trait actually declared the method, so an
/// inherited method carries the SUPERtrait's formals, not the subtrait's.
export fn trait_method_sig_binders_deep(env: TypeEnv, trait_name: String, method_name: String) -> Option[(Array[TypeExpr], TypeExpr, Array[String])] {
  match trait_method_sig_binders(env = env, trait_name = trait_name, method_name = method_name) {
    Some(sig) => Some(sig),
    None => {
      let supers = trait_supers(env = env, name = trait_name)
      let mut i = 0
      let mut result = None
      while i < Array::length(supers) {
        let pending = match result {
          None => true,
          _ => false
        }
        if pending {
          match trait_method_sig_binders_deep(env = env, trait_name = Array::get(supers, at = i), method_name = method_name) {
            Some(sig) => {
              result = Some(sig)
            },
            None => ()
          }
        } else {
          ()
        }
        i = i + 1
      }
      result
    }
  }
}

/// Like `trait_method_sig` but follows supertraits transitively, so a method
/// inherited from a supertrait (`trait B: A` calling an `A` method on `[T: B]`)
/// resolves. Trait hierarchies are acyclic, so the recursion terminates.
export fn trait_method_sig_deep(env: TypeEnv, trait_name: String, method_name: String) -> Option[(Array[TypeExpr], TypeExpr)] {
  match trait_method_sig_binders_deep(env = env, trait_name = trait_name, method_name = method_name) {
    Some(found) => {
      let (params, ret, _) = found
      Some((params, ret))
    },
    None => None
  }
}

/// Collect the trait bounds recorded for a specific type variable id in the
/// current substitution (`subst_add_bound` entries). Used to resolve a
/// `T::method` call where `T` is a bounded generic parameter.
export fn subst_bounds_for(s: Subst, id: Int) -> Array[String] {
  let out = ArrayBuilder::new()
  let mut cur = s
  let mut done = false
  while !done {
    match cur {
      SubstEmpty => {
        done = true
      },
      SubstBind(_, _, rest) => {
        cur = rest
      },
      SubstBound(bid, bounds, rest) => {
        if bid == id {
          let mut i = 0
          while i < Array::length(bounds) {
            ArrayBuilder::push(out, value = Array::get(bounds, at = i))
            i = i + 1
          }
        } else {
          ()
        }
        cur = rest
      },
      SubstValueRange(_, rest) => {
        cur = rest
      },
      SubstCached(_, bounds_cache, rest) => {
        let key = __to_string(id)
        if Map::has_key(bounds_cache, key = key) {
          let bounds = Map::get(bounds_cache, key = key)
          let mut i = 0
          while i < Array::length(bounds) {
            ArrayBuilder::push(out, value = Array::get(bounds, at = i))
            i = i + 1
          }
        } else {
          ()
        }
        cur = rest
      },
      SubstEffBind(_, _, rest) => {
        cur = rest
      }
    }
  }
  ArrayBuilder::freeze(out)
}

/// #3588: two spellings of one compiler-owned head, one with its region and
/// row slots left to the call (`TaskHandle[Int]`) and one in full
/// (`TaskHandle[rg, e, String]`), unify through their payload positions
/// (`owned_head_payload_span`); the elided slots are unbound and constrain
/// nothing. Any other arity mismatch fails, as before. Failing here used to
/// leave the payload uncompared: the checker tolerates a failed `CtNamed`
/// pair, so `TaskHandle[Int]` returned as a `TaskHandle[rg, e, String]`
/// checked clean and `join` read the task's `Int` as a `String`.
fn unify_owned_elided(a: Type, b: Type, s: Subst) -> Option[Subst] {
  match a {
    CtNamed(an, aargs) => match b {
      CtNamed(bn, bargs) => if an != bn {
        None
      } else match owned_head_payload_span(name = an, argc = Array::length(aargs)) {
        Some((astart, acount)) => match owned_head_payload_span(name = bn, argc = Array::length(bargs)) {
          Some((bstart, bcount)) => if acount == bcount {
            unify_type_arrays(xs = Array::slice(aargs, start = astart, end = astart + acount), ys = Array::slice(bargs, start = bstart, end = bstart + bcount), s = s)
          } else {
            None
          },
          None => None
        },
        None => None
      },
      _ => None
    },
    _ => None
  }
}

/// `Some(result)` means application decomposition handled the pair. Outer
/// `None` means ordinary first-order unification should continue.
fn unify_type_applications(a: Type, b: Type, s: Subst) -> Option[Option[Subst]] {
  match type_application_view(a) {
    Some(ap) => match type_application_view(b) {
      Some(bp) => {
        let (ahead, aargs) = ap
        let (bhead, bargs) = bp
        if Array::length(aargs) != Array::length(bargs) {
          Some(unify_owned_elided(a = a, b = b, s = s))
        } else match unify(a = ahead, b = bhead, s = s) {
          None => Some(None),
          Some(head_subst) => {
            let mut acc = head_subst
            let mut i = 0
            let mut ok = true
            while i < Array::length(aargs) && ok {
              match unify(a = Array::get(aargs, at = i), b = Array::get(bargs, at = i), s = acc) {
                Some(next) => {
                  acc = next
                },
                None => {
                  ok = false
                }
              }
              i = i + 1
            }
            if ok {
              Some(Some(acc))
            } else {
              Some(None)
            }
          }
        }
      },
      None => None
    },
    None => match type_application_view(b) {
      Some(_) => None,
      None => None
    }
  }
}

export fn unify(a: Type, b: Type, s: Subst) -> Option[Subst] {
  let ta = subst_apply(s = s, ty = a)
  let tb = subst_apply(s = s, ty = b)
  if types_equal(a = ta, b = tb) {
    Some(s)
  } else if char_int_compatible(ta = ta, tb = tb) {
    Some(s)
  } else match ta {
    CtUnknown => Some(s),
    _ => match tb {
      CtUnknown => Some(s),
      _ => if is_hkt_app(ta) || is_hkt_app(tb) {
        unify_hkt(ta = ta, tb = tb, s = s)
      } else match unify_type_applications(a = ta, b = tb, s = s) {
        Some(result) => result,
        None => match ta {
          CtVar(id) => if occurs_in(id = id, ty = tb) {
            None
          } else Some(subst_bind_value(id = id, ty = tb, s = s)),
          _ => match tb {
            CtVar(id) => if occurs_in(id = id, ty = ta) {
              None
            } else Some(subst_bind_value(id = id, ty = ta, s = s)),
            _ => match ta {
              CtForAll(_, _, body_a) => match tb {
                CtForAll(_, _, body_b) => unify(a = body_a, b = body_b, s = s),
                _ => unify(a = body_a, b = tb, s = s)
              },
              _ => match tb {
                CtForAll(_, _, body_b) => unify(a = ta, b = body_b, s = s),
                _ => match ta {
                  CtArray(ea) => match tb {
                    CtArray(eb) => unify(a = ea, b = eb, s = s),
                    _ => None
                  },
                  CtOption(ea) => match tb {
                    CtOption(eb) => unify(a = ea, b = eb, s = s),
                    _ => None
                  },
                  CtFn(pa, ra, aeffect) => match tb {
                    CtFn(pb, rb, beffect) => if Array::length(pa) != Array::length(pb) {
                      None
                    }
                    else {
                      let ul_len = Array::length(pa)
                      let mut ul_i = 0
                      let mut ul_acc = s
                      let mut ul_result = Some(s)
                      let mut ul_done = false
                      while !ul_done {
                        if ul_i >= ul_len {
                          ul_result = Some(ul_acc)
                          ul_done = true
                        } else {
                          match unify(a = Array::get(pa, at = ul_i), b = Array::get(pb, at = ul_i), s = ul_acc) {
                            Some(s2) => {
                              ul_acc = s2
                              ul_i = ul_i + 1
                            },
                            None => {
                              ul_result = None
                              ul_done = true
                            }
                          }
                        }
                      }
                      // #626 criterion 4: unify params, then the return type, then
                      // the EFFECT row — binding an effect variable to the other
                      // side (or failing on a genuine effect conflict) instead of
                      // the old unconditional-wildcard accept.
                      match ul_result {
                        Some(s2) => match unify(a = ra, b = rb, s = s2) {
                          Some(s3) => unify_effects(ea = aeffect, eb = beffect, s = s3),
                          None => None
                        },
                        None => None
                      }
                    },
                    _ => None
                  },
                  CtTuple(ea) => match tb {
                    CtTuple(eb) => if Array::length(ea) != Array::length(eb) {
                      None
                    }
                    else {
                      let ul_len2 = Array::length(ea)
                      let mut ul_i2 = 0
                      let mut ul_acc2 = s
                      let mut ul_result2 = Some(s)
                      let mut ul_done2 = false
                      while !ul_done2 {
                        if ul_i2 >= ul_len2 {
                          ul_result2 = Some(ul_acc2)
                          ul_done2 = true
                        } else {
                          match unify(a = Array::get(ea, at = ul_i2), b = Array::get(eb, at = ul_i2), s = ul_acc2) {
                            Some(s2) => {
                              ul_acc2 = s2
                              ul_i2 = ul_i2 + 1
                            },
                            None => {
                              ul_result2 = None
                              ul_done2 = true
                            }
                          }
                        }
                      }
                      ul_result2
                    },
                    _ => None
                  },
                  // #1839: records unify only with records of the same shape —
                  // same field names in the same order (order IS the runtime
                  // slot layout), field types unified pairwise. Against any
                  // nominal type (CtStruct/CtNamed/...) the catch-all below
                  // rejects, which is the point: an anonymous record can never
                  // silently satisfy a struct-typed position.
                  CtRecord(raf) => match tb {
                    CtRecord(rbf) => if Array::length(raf) != Array::length(rbf) {
                      None
                    }
                    else {
                      let ur_len = Array::length(raf)
                      let mut ur_i = 0
                      let mut ur_acc = s
                      let mut ur_result = Some(s)
                      let mut ur_done = false
                      while !ur_done {
                        if ur_i >= ur_len {
                          ur_result = Some(ur_acc)
                          ur_done = true
                        } else {
                          let (ur_an, ur_at) = Array::get(raf, at = ur_i)
                          let (ur_bn, ur_bt) = Array::get(rbf, at = ur_i)
                          if ur_an != ur_bn {
                            ur_result = None
                            ur_done = true
                          } else {
                            match unify(a = ur_at, b = ur_bt, s = ur_acc) {
                              Some(s2) => {
                                ur_acc = s2
                                ur_i = ur_i + 1
                              },
                              None => {
                                ur_result = None
                                ur_done = true
                              }
                            }
                          }
                        }
                      }
                      ur_result
                    },
                    _ => None
                  },
                  CtEnum(a_name) => match tb {
                    CtEnum(b_name) => if a_name == b_name {
                      Some(s)
                    } else None,
                    // Bridge `CtEnum(X)` with `CtNamed(X, args)` of any arity: an
                    // enum VALUE carries no type args (constructors yield a bare
                    // CtEnum), so it must still unify by name with an applied
                    // annotation like `Result[U, E]`.
                    CtNamed(b_name, _) => if a_name == b_name {
                      Some(s)
                    } else None,
                    _ => None
                  },
                  CtStruct(a_name) => match tb {
                    CtStruct(b_name) => if a_name == b_name {
                      Some(s)
                    } else None,
                    // #829: a bare `CtStruct(S)` (unparameterized annotation /
                    // pre-bound structural fn signature) unifies by name with an
                    // INSTANTIATED `CtNamed(S, args)` of any arity — the bare
                    // form carries no argument information to conflict with,
                    // exactly like the CtEnum/CtNamed bridge below.
                    //
                    // #843 review follow-up (Codex P1): this bridge (both this
                    // arm and its mirror in the `CtNamed(a_name, _)` case below)
                    // lets a value's real #829-instantiated args get discarded
                    // when it flows through a bare annotation (`let x: Box =
                    // Box::{v:1}` types `x` as bare `Box`, forgetting `[Int]`),
                    // and a LATER, unrelated annotation can then silently
                    // re-narrow it (`let y: Box[String] = x; y.v` reads a
                    // stored Int as String) — this is a real, confirmed hole.
                    // It is NOT fixed by restricting the bridge's direction:
                    // call sites are inconsistent about which side is
                    // "expected" (`check_assignable(expected, actual, ..)` →
                    // `unify(expected, actual, ..)`, but the function-body
                    // return-type check calls `unify(body_ty, declared_ret,
                    // ..)` — actual FIRST) — a one-directional restriction here
                    // broke the legitimate mirror case instead (a trait `impl
                    // Trait for S { ... }` method's bare-`S`-typed return
                    // accepting a freshly `S::{...}`-constructed `S[X]`, gate
                    // section 18) without closing the hole (the erasure
                    // happens earlier, in the ascription-lambda / `let`
                    // annotation machinery that decides which of {declared,
                    // inferred} type to keep — not in `unify` itself). Full
                    // bridge restored pending a real fix (tracked in #844:
                    // thread fresh type vars through bare generic-struct
                    // annotations instead of erasing to `CtStruct`, so the
                    // annotation's own vars — not a name-only bridge — carry
                    // the value's real args forward).
                    CtNamed(b_name, _) => if a_name == b_name {
                      Some(s)
                    } else None,
                    _ => None
                  },
                  CtNamed(a_name, a_args) => match tb {
                    // Symmetric to the CtEnum bridge: an applied `CtNamed(X, args)`
                    // unifies with the bare enum value `CtEnum(X)` by name.
                    CtEnum(b_name) => if a_name == b_name {
                      Some(s)
                    } else None,
                    // #829: symmetric bridge — an applied `CtNamed(S, args)`
                    // unifies with the bare struct `CtStruct(S)` by name. See
                    // the long #843/#844 note on the `CtStruct(a_name)` arm
                    // above — restored (not narrowed) for the same reason.
                    CtStruct(b_name) => if a_name == b_name {
                      Some(s)
                    } else None,
                    CtNamed(b_name, b_args) => if a_name != b_name {
                      // #3589: a struct's row argument is a row, so a row
                      // variable there unifies like the row of a function
                      // type: `Holder[$4]` against `Holder[Console]` binds
                      // `$4` to `Console`.
                      if Array::length(a_args) == 0 && Array::length(b_args) == 0 && (is_row_var_type_arg(ta) || is_row_var_type_arg(tb)) {
                        unify_effects(ea = Some(a_name), eb = Some(b_name), s = s)
                      } else {
                        None
                      }
                    }
                    else if Array::length(a_args) != Array::length(b_args) {
                      unify_owned_elided(a = ta, b = tb, s = s)
                    }
                    else {
                      let ul_len3 = Array::length(a_args)
                      let mut ul_i3 = 0
                      let mut ul_acc3 = s
                      let mut ul_result3 = Some(s)
                      let mut ul_done3 = false
                      while !ul_done3 {
                        if ul_i3 >= ul_len3 {
                          ul_result3 = Some(ul_acc3)
                          ul_done3 = true
                        } else {
                          match unify(a = Array::get(a_args, at = ul_i3), b = Array::get(b_args, at = ul_i3), s = ul_acc3) {
                            Some(s2) => {
                              ul_acc3 = s2
                              ul_i3 = ul_i3 + 1
                            },
                            None => {
                              ul_result3 = None
                              ul_done3 = true
                            }
                          }
                        }
                      }
                      ul_result3
                    },
                    _ => None
                  },
                  _ => None
                }
              }
            }
          }
        }
      }
    }
  }
}

export fn types_compatible(expected: Type, actual: Type) -> Bool {
  match expected {
    CtUnknown => true,
    _ => match actual {
      CtUnknown => true,
      _ => types_equal(a = expected, b = actual)
    }
  }
}

fn impl_pattern_param_index(params: Array[String], name: String) -> Int {
  let mut result = -1
  let mut i = 0
  while i < Array::length(params) && result < 0 {
    if type_param_name(Array::get(params, at = i)) == name {
      result = i
    } else {
      ()
    }
    i = i + 1
  }
  result
}

/// Replace each impl-target formal with a fresh checker variable. Using one
/// stable variable per formal preserves repeated-variable constraints such as
/// `Pair[T, T]`; using disjoint bases for the two candidates lets ordinary
/// unification decide whether their instance sets intersect.
fn freshen_impl_pattern(ty: Type, params: Array[String], base: Int) -> Type {
  match ty {
    CtNamed(name, args) => {
      let param_index = if Array::length(args) == 0 {
        impl_pattern_param_index(params = params, name = name)
      } else {
        -1
      }
      if param_index >= 0 {
        CtVar(base + param_index)
      } else {
        CtNamed(name, for arg in args {
          freshen_impl_pattern(ty = arg, params = params, base = base)
        })
      }
    },
    CtArray(elem) => CtArray(freshen_impl_pattern(ty = elem, params = params, base = base)),
    CtOption(elem) => CtOption(freshen_impl_pattern(ty = elem, params = params, base = base)),
    CtTuple(items) => CtTuple(for item in items {
      freshen_impl_pattern(ty = item, params = params, base = base)
    }),
    CtFn(args, ret, effect) => CtFn(for arg in args {
      freshen_impl_pattern(ty = arg, params = params, base = base)
    }, freshen_impl_pattern(ty = ret, params = params, base = base), effect),
    CtRecord(fields) => CtRecord(for field in fields {
      let (name, field_ty) = field
      (name, freshen_impl_pattern(ty = field_ty, params = params, base = base))
    }),
    _ => ty
  }
}

fn impl_pattern_effects_equal(left: Option[String], right: Option[String]) -> Bool {
  match (left, right) {
    (None, None) => true,
    (Some(a), Some(b)) => a == b,
    _ => false
  }
}

fn is_fresh_impl_pattern_var(_ id: Int) -> Bool {
  id >= 100000000 && id < 300000000
}

/// Trait-instance overlap is stricter than expression unification: assignment
/// coercions such as Char <-> Int and the CtUnknown wildcard must not make two
/// impl heads overlap. This unifier handles only the fresh variables introduced
/// from impl formals and otherwise requires the same type structure.
fn unify_impl_patterns_exact(left: Type, right: Type, subst: Subst) -> Option[Subst] {
  let a = subst_apply(s = subst, ty = left)
  let b = subst_apply(s = subst, ty = right)
  if types_equal(a = a, b = b) {
    Some(subst)
  } else {
    match a {
      CtVar(id) => if is_fresh_impl_pattern_var(id) {
        if occurs_in(id = id, ty = b) {
          None
        } else {
          Some(subst_bind_value(id = id, ty = b, s = subst))
        }
      } else {
        None
      },
      _ => match b {
        CtVar(id) => if is_fresh_impl_pattern_var(id) {
          if occurs_in(id = id, ty = a) {
            None
          } else {
            Some(subst_bind_value(id = id, ty = a, s = subst))
          }
        } else {
          None
        },
        _ => match (a, b) {
          (CtArray(ae), CtArray(be)) => unify_impl_patterns_exact(left = ae, right = be, subst = subst),
          (CtOption(ae), CtOption(be)) => unify_impl_patterns_exact(left = ae, right = be, subst = subst),
          (CtTuple(a_items), CtTuple(b_items)) => {
            if Array::length(a_items) != Array::length(b_items) {
              None
            } else {
              let mut result = Some(subst)
              let mut i = 0
              while i < Array::length(a_items) {
                result = match result {
                  Some(current) => unify_impl_patterns_exact(left = Array::get(a_items, at = i), right = Array::get(b_items, at = i), subst = current),
                  None => None
                }
                i = i + 1
              }
              result
            }
          },
          (CtFn(aa, ar, ae), CtFn(ba, br, be)) => {
            if Array::length(aa) != Array::length(ba) || !impl_pattern_effects_equal(left = ae, right = be) {
              None
            } else {
              let mut result = Some(subst)
              let mut i = 0
              while i < Array::length(aa) {
                result = match result {
                  Some(current) => unify_impl_patterns_exact(left = Array::get(aa, at = i), right = Array::get(ba, at = i), subst = current),
                  None => None
                }
                i = i + 1
              }
              match result {
                Some(current) => unify_impl_patterns_exact(left = ar, right = br, subst = current),
                None => None
              }
            }
          },
          (CtNamed(an, aa), CtNamed(bn, ba)) => {
            if an != bn || Array::length(aa) != Array::length(ba) {
              None
            } else {
              let mut result = Some(subst)
              let mut i = 0
              while i < Array::length(aa) {
                result = match result {
                  Some(current) => unify_impl_patterns_exact(left = Array::get(aa, at = i), right = Array::get(ba, at = i), subst = current),
                  None => None
                }
                i = i + 1
              }
              result
            }
          },
          (CtStruct(an), CtNamed(bn, _)) => if an == bn {
            Some(subst)
          } else {
            None
          },
          (CtNamed(an, _), CtStruct(bn)) => if an == bn {
            Some(subst)
          } else {
            None
          },
          (CtEnum(an), CtNamed(bn, _)) => if an == bn {
            Some(subst)
          } else {
            None
          },
          (CtNamed(an, _), CtEnum(bn)) => if an == bn {
            Some(subst)
          } else {
            None
          },
          _ => None
        }
      }
    }
  }
}

fn impl_target_patterns_overlap(left_params: Array[String], left_target: Type, right_params: Array[String], right_target: Type) -> Bool {
  let left = freshen_impl_pattern(ty = left_target, params = left_params, base = 100000000)
  let right = freshen_impl_pattern(ty = right_target, params = right_params, base = 200000000)
  match unify_impl_patterns_exact(left = left, right = right, subst = SubstEmpty) {
    Some(_) => true,
    None => false
  }
}

/// Decide coherence over the trait application and target as one pattern.
/// The same impl binder can occur in both halves (`impl [T] Value[T] for
/// Box[T]`), so freshening and unification must share one substitution rather
/// than comparing the trait arguments and target independently.
export fn impl_trait_and_target_patterns_overlap(left_trait: String, left_params: Array[String], left_target: Type, right_trait: String, right_params: Array[String], right_target: Type) -> Bool {
  if trait_ref_name(left_trait) != trait_ref_name(right_trait) {
    false
  } else match (trait_ref_from_key(left_trait), trait_ref_from_key(right_trait)) {
    (Some(left_ref), Some(right_ref)) => {
      let left_pattern = CtTuple([
        trait_ref_type_expr_type(left_ref),
        left_target
      ])
      let right_pattern = CtTuple([
        trait_ref_type_expr_type(right_ref),
        right_target
      ])
      let left = freshen_impl_pattern(ty = left_pattern, params = left_params, base = 100000000)
      let right = freshen_impl_pattern(ty = right_pattern, params = right_params, base = 200000000)
      match unify_impl_patterns_exact(left = left, right = right, subst = SubstEmpty) {
        Some(_) => true,
        None => false
      }
    },
    // A bare parameterized trait spelling is the compatibility form that
    // denotes the whole trait family. Its target therefore remains the only
    // coherence discriminator when paired with an applied spelling.
    _ => impl_target_patterns_overlap(left_params = left_params, left_target = left_target, right_params = right_params, right_target = right_target)
  }
}

/// Return the first existing target whose instance set intersects the new
/// target. TypeEnv is newest-first, so this is deterministic for a fixed
/// source order and gives the checker both candidate targets for its error.
export fn overlapping_impl_target_for(env: TypeEnv, trait_name: String, new_params: Array[String], new_target: Type) -> Option[Type] {
  match env {
    EnvEmpty => None,
    EnvBind(_, _, rest) => overlapping_impl_target_for(env = rest, trait_name = trait_name, new_params = new_params, new_target = new_target),
    EnvShowWrappers(_, _, rest) => overlapping_impl_target_for(env = rest, trait_name = trait_name, new_params = new_params, new_target = new_target),
    EnvMutCell(_, _, rest) => overlapping_impl_target_for(env = rest, trait_name = trait_name, new_params = new_params, new_target = new_target),
    // A newer declaration of the same trait starts a new instance scope. This
    // is how a package's method-bearing definition replaces an imported
    // bodyless marker contract (for example @vibe/core Default replacing the
    // @vibe/builtin bound-only declaration) without treating their mirrored
    // primitive impl declarations as source duplicates. Impl nodes belonging
    // to the current declaration are always above this boundary.
    EnvTraitDef(name, _, _, _, rest, _, _) => if name == trait_ref_name(trait_name) {
      None
    } else {
      overlapping_impl_target_for(env = rest, trait_name = trait_name, new_params = new_params, new_target = new_target)
    },
    EnvTraitImpl(tname, target, rest) => if impl_trait_and_target_patterns_overlap(left_trait = tname, left_params = array_empty(), left_target = target, right_trait = trait_name, right_params = new_params, right_target = new_target) {
      Some(target)
    } else {
      overlapping_impl_target_for(env = rest, trait_name = trait_name, new_params = new_params, new_target = new_target)
    },
    EnvTraitImplGen(tname, params, _, target, rest) => if impl_trait_and_target_patterns_overlap(left_trait = tname, left_params = params, left_target = target, right_trait = trait_name, right_params = new_params, right_target = new_target) {
      Some(target)
    } else {
      overlapping_impl_target_for(env = rest, trait_name = trait_name, new_params = new_params, new_target = new_target)
    },
    EnvTypeDefs(_, _, rest) => overlapping_impl_target_for(env = rest, trait_name = trait_name, new_params = new_params, new_target = new_target),
    EnvFlat(_) => None,
    EnvCached(_, _, rest) => overlapping_impl_target_for(env = rest, trait_name = trait_name, new_params = new_params, new_target = new_target)
  }
}

export fn impls_overlap_for(env: TypeEnv, trait_name: String, new_target: Type) -> Bool {
  match overlapping_impl_target_for(env = env, trait_name = trait_name, new_params = array_empty(), new_target = new_target) {
    Some(_) => true,
    None => false
  }
}

/// #829: a deliberately bare `impl Trait for S` has no target arguments, but
/// an instantiated generic struct value is typed `CtNamed(S, args)`. Bridge
/// the two by head name: the bare impl covers the constructor family.
fn struct_impl_target_matches(target: Type, resolved: Type) -> Bool {
  match resolved {
    CtNamed(rname, rargs) => if Array::length(rargs) > 0 {
      match target {
        CtStruct(tname) => tname == rname,
        CtNamed(tname, targs) => tname == rname && Array::length(targs) == 0,
        _ => false
      }
    } else {
      false
    },
    _ => false
  }
}

/// #1503: a bare constructor impl (`impl Show for Array`) records
/// `CtNamed("Array", [])`, which `types_equal` cannot match against a concrete
/// `CtArray(CtInt)` use site. Match only that intentionally unspecialized bare
/// spelling by constructor. Applied targets retain their arguments and must
/// match exactly instead of passing through this fallback.
fn erased_impl_ctor_matches(target: Type, resolved: Type) -> Bool {
  let head = type_constructor_name(resolved)
  match target {
    CtNamed(tname, targs) => Array::length(targs) == 0 && head != "" && tname == head,
    // A bare user-defined generic head is retained as its nominal declaration
    // node in an impl target, while constructor inference resolves the use
    // site to CtConstructor after #2337. Both denote the same erased family.
    CtStruct(tname) => head != "" && tname == head,
    CtEnum(tname) => head != "" && tname == head,
    // Keep this arm for already-reified constructor targets (for example a
    // target reconstructed from a checked artifact).
    CtConstructor(tname, _) => head != "" && tname == head,
    _ => false
  }
}

/// Apply the shared receiver-matching rule for a non-generic impl. Bare
/// constructor impls cover the constructor family only for method-bearing
/// traits; marker traits retain their stricter representation-safety gate.
fn concrete_trait_impl_target_matches(full: TypeEnv, trait_name: String, target: Type, resolved: Type) -> Bool {
  types_equal(a = target, b = resolved) || struct_impl_target_matches(target = target, resolved = resolved) || (erased_impl_ctor_matches(target = target, resolved = resolved) && trait_is_method_bearing(env = full, trait_name = trait_name))
}

fn type_implements_check_env(e: TypeEnv, full: TypeEnv, trait_name: String, resolved: Type) -> Bool {
  match e {
    EnvEmpty => false,
    EnvBind(_, _, rest) => type_implements_check_env(e = rest, full = full, trait_name = trait_name, resolved = resolved),
    EnvShowWrappers(_, _, rest) => type_implements_check_env(e = rest, full = full, trait_name = trait_name, resolved = resolved),
    EnvMutCell(_, _, rest) => type_implements_check_env(e = rest, full = full, trait_name = trait_name, resolved = resolved),
    EnvTraitDef(_, _, _, _, rest, _, _) => type_implements_check_env(e = rest, full = full, trait_name = trait_name, resolved = resolved),
    EnvTraitImpl(tname, target, rest) => if tname == trait_name {
      // The constructor fallback carries the SAME soundness gate as the generic
      // path (see trait_is_method_bearing): a marker trait dispatches to the
      // builtin `==` / `<`, and those are reference equality on `Array` /
      // `Bytes`, so honouring `impl Eq for Array[Int]` would make `==` silently
      // wrong on the very type the bound was written for.
      if concrete_trait_impl_target_matches(full = full, trait_name = trait_name, target = target, resolved = resolved) {
        true
      }
      else type_implements_check_env(e = rest, full = full, trait_name = trait_name, resolved = resolved)
    } else type_implements_check_env(e = rest, full = full, trait_name = trait_name, resolved = resolved),
    EnvTraitImplGen(_, _, _, _, rest) => type_implements_check_env(e = rest, full = full, trait_name = trait_name, resolved = resolved),
    EnvTypeDefs(_, _, rest) => type_implements_check_env(e = rest, full = full, trait_name = trait_name, resolved = resolved),
    EnvFlat(_) => false,
    EnvCached(_, _, rest) => type_implements_check_env(e = rest, full = full, trait_name = trait_name, resolved = resolved)
  }
}

/// #1503 diagnostics: an impl for this trait IS declared on the resolved type's
/// constructor (bare or generic spelling), it just did not satisfy the bound. Lets the
/// bound checker say "declared but not usable, and here is why" instead of the
/// flatly false `no impl \`Eq\` for \`Array[Int]\`` when the user wrote that
/// impl three lines above.
export fn trait_impl_declared_for_ctor(e: TypeEnv, trait_name: String, resolved: Type) -> Bool {
  let head = type_constructor_name(resolved)
  if head == "" {
    false
  } else {
    match e {
      EnvEmpty => false,
      EnvBind(_, _, rest) => trait_impl_declared_for_ctor(e = rest, trait_name = trait_name, resolved = resolved),
      EnvShowWrappers(_, _, rest) => trait_impl_declared_for_ctor(e = rest, trait_name = trait_name, resolved = resolved),
      EnvMutCell(_, _, rest) => trait_impl_declared_for_ctor(e = rest, trait_name = trait_name, resolved = resolved),
      EnvTraitDef(_, _, _, _, rest, _, _) => trait_impl_declared_for_ctor(e = rest, trait_name = trait_name, resolved = resolved),
      EnvTraitImpl(tname, target, rest) => if tname == trait_name && type_constructor_name(target) == head {
        true
      } else {
        trait_impl_declared_for_ctor(e = rest, trait_name = trait_name, resolved = resolved)
      },
      EnvTraitImplGen(itrait, _, _, target, rest) => if itrait == trait_name && type_constructor_name(target) == head {
        true
      } else {
        trait_impl_declared_for_ctor(e = rest, trait_name = trait_name, resolved = resolved)
      },
      EnvTypeDefs(_, _, rest) => trait_impl_declared_for_ctor(e = rest, trait_name = trait_name, resolved = resolved),
      EnvFlat(_) => false,
      EnvCached(_, _, rest) => trait_impl_declared_for_ctor(e = rest, trait_name = trait_name, resolved = resolved)
    }
  }
}

/// #1503 diagnostics: true when `trait_name` is declared with no methods (a
/// marker trait). Exported so the bound checker can explain the marker-trait
/// gate; the gate itself lives in trait_is_method_bearing.
export fn trait_is_marker(env: TypeEnv, trait_name: String) -> Bool {
  not(trait_is_method_bearing(env = env, trait_name = trait_name))
}

export fn collect_subst_bounds_pairs(_ s: Subst) -> Array[(Int, Array[String])] {
  let out = array_empty()
  let mut cur = s
  let mut done = false
  while !done {
    match cur {
      SubstEmpty => {
        done = true
      },
      SubstBind(_, _, rest) => {
        cur = rest
      },
      SubstBound(id, bounds, rest) => {
        if !int_bounds_has_id(pairs = out, id = id, i = 0) {
          Array::push(out, value = (id, bounds))
        }
        cur = rest
      },
      SubstValueRange(_, rest) => {
        cur = rest
      },
      SubstCached(_, _, rest) => {
        cur = rest
      },
      SubstEffBind(_, _, rest) => {
        cur = rest
      }
    }
  }
  out
}

/// #2459: `generalize`, minus the variables that are still FREE IN THE
/// ENVIRONMENT. Quantifying one of those hands every use its own copy of a
/// slot that has exactly one runtime home -- measured, `let g2 = g` on a
/// lambda capturing `let xs = []` turned `forall U. (U, ?k) -> U` into
/// `forall U ?k. (U, ?k) -> U`, and the two calls then put an `Int` and a
/// `String` into one array.
///
/// `exclude` is the caller's answer to "which variables belong to something
/// else". An empty `exclude` is exactly `generalize`.
export fn generalize_except(s: Subst, ty: Type, exclude: Array[Int]) -> Type {
  match ty {
    CtForAll(vars, bounds, body) => CtForAll(vars, bounds, subst_apply_except(s = s, ty = body, keep = vars)),
    _ => {
      let resolved = subst_apply(s = s, ty = ty)
      let tvars = array_empty()
      for vid in collect_tvars(resolved) {
        if array_has_int(arr = exclude, val = vid, i = 0) {
          ()
        } else {
          Array::push(tvars, value = vid)
        }
      }
      if Array::length(tvars) == 0 {
        resolved
      } else {
        let bounds_pairs = collect_subst_bounds_pairs(s)
        let var_bounds = array_empty()
        for vid in tvars {
          let bounds = int_bounds_lookup(pairs = bounds_pairs, id = vid, i = 0)
          if Array::length(bounds) != 0 {
            Array::push(var_bounds, value = (vid, bounds))
          }
        }
        CtForAll(tvars, var_bounds, resolved)
      }
    }
  }
}

export fn generalize(s: Subst, ty: Type) -> Type {
  match ty {
    CtForAll(vars, bounds, body) => CtForAll(vars, bounds, subst_apply_except(s = s, ty = body, keep = vars)),
    _ => {
      let resolved = subst_apply(s = s, ty = ty)
      let tvars = collect_tvars(resolved)
      if Array::length(tvars) == 0 {
        resolved
      } else {
        let bounds_pairs = collect_subst_bounds_pairs(s)
        let var_bounds = array_empty()
        for vid in tvars {
          let bounds = int_bounds_lookup(pairs = bounds_pairs, id = vid, i = 0)
          if Array::length(bounds) != 0 {
            Array::push(var_bounds, value = (vid, bounds))
          }
        }
        CtForAll(tvars, var_bounds, resolved)
      }
    }
  }
}

/// Does an impl of some SUBTRAIT of `trait_name` cover `resolved`? (`impl Child
/// for P` satisfies a `[T: Base]` bound when `trait Child: Base`.)
///
/// #1503 follow-up (Codex review on #1528): both halves of this scan were
/// incomplete in the same way as the direct scan was.
///
///   * `EnvTraitImpl` matched only `types_equal` / `struct_impl_target_matches`,
///     so a bare constructor impl (`impl Child for Array`) never matched a
///     concrete instantiation -- the same hole `erased_impl_ctor_matches`
///     closes for the direct scan, with the same
///     method-bearing gate on the BOUND trait (that is the trait the caller
///     dispatches through).
///   * `EnvTraitImplGen` was skipped outright, so `impl [T] Child for Array[T]`
///     could not satisfy `[T: Base]` at all.
fn type_implements_check_super(e2: TypeEnv, full_env: TypeEnv, s: Subst, trait_name: String, resolved: Type) -> Bool {
  match e2 {
    EnvEmpty => false,
    EnvBind(_, _, rest) => type_implements_check_super(e2 = rest, full_env = full_env, s = s, trait_name = trait_name, resolved = resolved),
    EnvShowWrappers(_, _, rest) => type_implements_check_super(e2 = rest, full_env = full_env, s = s, trait_name = trait_name, resolved = resolved),
    EnvMutCell(_, _, rest) => type_implements_check_super(e2 = rest, full_env = full_env, s = s, trait_name = trait_name, resolved = resolved),
    EnvTraitDef(_, _, _, _, rest, _, _) => type_implements_check_super(e2 = rest, full_env = full_env, s = s, trait_name = trait_name, resolved = resolved),
    EnvTraitImpl(tname, target, rest) => if concrete_trait_impl_target_matches(full = full_env, trait_name = trait_name, target = target, resolved = resolved) {
      if trait_is_subtrait(env = full_env, sub = tname, super_name = trait_name) {
        true
      }
      else type_implements_check_super(e2 = rest, full_env = full_env, s = s, trait_name = trait_name, resolved = resolved)
    } else type_implements_check_super(e2 = rest, full_env = full_env, s = s, trait_name = trait_name, resolved = resolved),
    EnvTraitImplGen(itrait, tparams, bounds, target, rest) => match generic_subtrait_impl_args(full = full_env, itrait = itrait, tparams = tparams, target = target, trait_name = trait_name, resolved = resolved) {
      Some(args) => if generic_bounds_hold(full = full_env, s = s, tparams = tparams, bounds = bounds, args = args) {
        true
      } else {
        type_implements_check_super(e2 = rest, full_env = full_env, s = s, trait_name = trait_name, resolved = resolved)
      },
      None => type_implements_check_super(e2 = rest, full_env = full_env, s = s, trait_name = trait_name, resolved = resolved)
    },
    EnvTypeDefs(_, _, rest) => type_implements_check_super(e2 = rest, full_env = full_env, s = s, trait_name = trait_name, resolved = resolved),
    EnvFlat(_) => false,
    EnvCached(_, _, rest) => type_implements_check_super(e2 = rest, full_env = full_env, s = s, trait_name = trait_name, resolved = resolved)
  }
}

/// Constructor/head name of a type. Returns "" for types with no nominal
/// constructor (tuples, primitives, vars) so they never match a generic impl.
/// #3947: the key a trait reference is matched under, with each type argument
/// resolved over `defs` and written back (`canonical_trait_arg_type_expr`).
/// The checker's impl registration, the linked program's coherence check and
/// the lowering all canonicalize through this, so `Value[Alias]`
/// (`type Alias = Int`) and `Value[Int]` are one key to each of them. A name
/// in `binders` is kept as written, even beside `type T = Int`, while the
/// structure around it is canonical: `Value[StringMap[T]]` is
/// `Value[Map[String, T]]` (Codex on #3956). A bare trait name is kept as
/// written.
///
/// The size of what this writes back is bounded where `defs` are built
/// (`canonical_key_defs_with`): an alias that would expand past the checker's
/// alias preflight is left out of them, so a key through it stays as written
/// and the preflight refuses the source. No budget is applied here, because a
/// key the checker accepts must be spelled the same way on the impl side and
/// on the bound side (Codex on #3995).
export fn canonical_trait_key(key: String, binders: Array[String], defs: Array[TypeDef]) -> String {
  if !trait_ref_is_applied(key) {
    key
  } else {
    match trait_ref_from_key(key) {
      Some(TyApp(head, args)) => {
        let mut changed = false
        let mapped = for arg in args {
          match canonical_trait_arg_type_expr(resolve_type_expr_core_shadowed(te = arg, defs = defs, shadow = binders)) {
            Some(next) => {
              if next != arg {
                changed = true
              } else {
                ()
              }
              next
            },
            None => arg
          }
        }
        if changed {
          trait_ref_key(TyApp(head, mapped))
        } else {
          key
        }
      },
      _ => key
    }
  }
}

/// #3947: a resolved type written back as the `TypeExpr` a trait key spells,
/// or None for a type no key can spell (an unsolved variable). The checker's
/// bound keys and impl keys, and the lowering's expansion of both, all use
/// this one writer, so a key the checker accepts is a key the lowering finds:
/// `Unit` is `()`, `StringMap[V]` is `Map[String, V]`, the float widths are
/// `Float64` / `Float32`.
export fn canonical_trait_arg_type_expr(_ ty: Type) -> Option[TypeExpr] {
  match ty {
    CtInt => Some(TyName("Int")),
    // #3730: a bound is judged by the checker, which keeps the nominal type.
    CtInt32 => Some(TyName("Int32")),
    CtUInt32 => Some(TyName("UInt32")),
    CtDouble => Some(TyName("Float64")),
    CtFloat => Some(TyName("Float32")),
    CtBool => Some(TyName("Bool")),
    CtString => Some(TyName("String")),
    CtChar => Some(TyName("Char")),
    CtBytes => Some(TyName("Bytes")),
    CtUnit => Some(TyUnit),
    CtArray(elem) => match canonical_trait_arg_type_expr(elem) {
      Some(arg) => Some(TyApp("Array", [arg])),
      None => None
    },
    CtOption(elem) => match canonical_trait_arg_type_expr(elem) {
      Some(arg) => Some(TyApp("Option", [arg])),
      None => None
    },
    CtTuple(items) => {
      let out = array_empty()
      let mut ok = true
      for item in items {
        match canonical_trait_arg_type_expr(item) {
          Some(mapped) => Array::push(out, value = mapped),
          None => {
            ok = false
          }
        }
      }
      if ok {
        Some(TyTuple(out))
      } else {
        None
      }
    },
    CtFn(params, ret, effect) => {
      let out = array_empty()
      let mut ok = true
      for param in params {
        match canonical_trait_arg_type_expr(param) {
          Some(mapped) => Array::push(out, value = mapped),
          None => {
            ok = false
          }
        }
      }
      match canonical_trait_arg_type_expr(ret) {
        Some(mapped_ret) => if ok {
          Some(TyFn(out, mapped_ret, effect))
        } else {
          None
        },
        None => None
      }
    },
    CtNamed(name, args) => {
      let out = array_empty()
      let mut ok = true
      for arg in args {
        match canonical_trait_arg_type_expr(arg) {
          Some(mapped) => Array::push(out, value = mapped),
          None => {
            ok = false
          }
        }
      }
      if !ok {
        None
      } else if Array::length(out) == 0 {
        Some(TyName(name))
      } else {
        Some(TyApp(name, out))
      }
    },
    CtConstructor(name, _) => Some(TyName(name)),
    CtApplied(head, args) => {
      let name = type_constructor_name(head)
      let out = array_empty()
      let mut ok = name != ""
      for arg in args {
        match canonical_trait_arg_type_expr(arg) {
          Some(mapped) => Array::push(out, value = mapped),
          None => {
            ok = false
          }
        }
      }
      if ok {
        Some(TyApp(name, out))
      } else {
        None
      }
    },
    CtEnum(name) => Some(TyName(name)),
    CtStruct(name) => Some(TyName(name)),
    _ => None
  }
}

export fn type_constructor_name(_ ty: Type) -> String {
  match ty {
    CtArray(_) => "Array",
    CtOption(_) => "Option",
    CtNamed(n, args) => if n == hkt_app_name() && Array::length(args) >= 1 {
      type_constructor_name(Array::get(args, at = 0))
    } else if String::starts_with(n, prefix = hkt_ctor_prefix()) {
      n[String::length(hkt_ctor_prefix()): String::length(n)]
    } else {
      n
    },
    CtConstructor(name, _) => name,
    CtApplied(head, _) => type_constructor_name(head),
    CtStruct(n) => n,
    CtEnum(n) => n,
    _ => ""
  }
}

/// True iff `trait_name` declares at least one method (a method-bearing trait).
/// Marker traits (Eq/Ord/Add/…, declared `trait Eq` with no body) and undeclared
/// bound names (e.g. `Iterator`) return false. This is the soundness gate for
/// generic-impl resolution: a method-bearing trait dispatches through the threaded
/// witness dictionary (so a generic impl runs the correct per-type method),
/// whereas a marker trait "dispatches" via a builtin operator (`==`, `<`) that
/// does NOT structurally handle a container — so matching a marker-trait generic
/// impl would let `==` be used on e.g. `Option[Int]` where it silently misbehaves.
fn trait_is_method_bearing(env: TypeEnv, trait_name: String) -> Bool {
  match env {
    EnvEmpty => false,
    EnvBind(_, _, rest) => trait_is_method_bearing(env = rest, trait_name = trait_name),
    EnvTraitDef(tname, _, _, methods, rest, _, _) => if tname == trait_ref_name(trait_name) {
      Array::length(methods) > 0
    } else trait_is_method_bearing(env = rest, trait_name = trait_name),
    EnvTraitImpl(_, _, rest) => trait_is_method_bearing(env = rest, trait_name = trait_name),
    EnvShowWrappers(_, _, rest) => trait_is_method_bearing(env = rest, trait_name = trait_name),
    EnvMutCell(_, _, rest) => trait_is_method_bearing(env = rest, trait_name = trait_name),
    EnvTraitImplGen(_, _, _, _, rest) => trait_is_method_bearing(env = rest, trait_name = trait_name),
    EnvTypeDefs(_, _, rest) => trait_is_method_bearing(env = rest, trait_name = trait_name),
    EnvFlat(_) => false,
    EnvCached(_, _, rest) => trait_is_method_bearing(env = rest, trait_name = trait_name)
  }
}

// True iff a type-parameter bound list carries no real trait bound (only the
// empty / `""` sentinel entries). Increment A of generic-impl support matches
// the per-parameter trait bounds of a generic impl. Increment A (`impl [T]
// Trait for C`) has empty bounds; Increment B (`impl [T: Bound] Trait for
// C[T]`) carries them and is satisfied only when every type argument of the
// concrete type satisfies them — a dictionary-of-dictionaries: `C[K]: Trait`
// iff `K: Bound`.

/// Type arguments of a (possibly generic) type, for checking a generic impl's
/// per-parameter bounds against the concrete element types.
fn type_args_of(_ ty: Type) -> Array[Type] {
  match ty {
    CtArray(e) => Array::slice([e], start = 0, end = 1),
    CtOption(e) => Array::slice([e], start = 0, end = 1),
    CtNamed(n, args) => if n == hkt_app_name() && Array::length(args) >= 1 {
      let rest = array_empty()
      let mut i = 1
      while i < Array::length(args) {
        Array::push(rest, value = Array::get(args, at = i))
        i = i + 1
      }
      rest
    } else {
      args
    },
    _ => array_empty()
  }
}

fn generic_param_index(tparams: Array[String], name: String) -> Int {
  let mut i = 0
  let mut found = 0 - 1
  while i < Array::length(tparams) && found < 0 {
    if type_param_name(Array::get(tparams, at = i)) == name {
      found = i
    } else {
      i = i + 1
    }
  }
  found
}

fn generic_target_match(template: Type, actual: Type, tparams: Array[String], args: Array[Type]) -> Bool {
  match template {
    CtNamed(name, targs) => {
      let pi = if Array::length(targs) == 0 {
        generic_param_index(tparams = tparams, name = name)
      } else {
        0 - 1
      }
      if pi >= 0 {
        match Array::get(args, at = pi) {
          CtUnknown => {
            Array::set(args, at = pi, value = actual)
            true
          },
          bound => types_equal(a = bound, b = actual)
        }
      } else {
        match actual {
          CtNamed(aname, aargs) => if name == aname && Array::length(targs) == Array::length(aargs) {
            let mut i = 0
            let mut ok = true
            while i < Array::length(targs) && ok {
              ok = generic_target_match(template = Array::get(targs, at = i), actual = Array::get(aargs, at = i), tparams = tparams, args = args)
              i = i + 1
            }
            ok
          } else {
            false
          },
          CtArray(actual_inner) => if name == "Array" && Array::length(targs) == 1 {
            generic_target_match(template = Array::get(targs, at = 0), actual = actual_inner, tparams = tparams, args = args)
          } else {
            false
          },
          CtOption(actual_inner) => if name == "Option" && Array::length(targs) == 1 {
            generic_target_match(template = Array::get(targs, at = 0), actual = actual_inner, tparams = tparams, args = args)
          } else {
            false
          },
          _ => false
        }
      }
    },
    CtArray(inner) => match actual {
      CtArray(actual_inner) => generic_target_match(template = inner, actual = actual_inner, tparams = tparams, args = args),
      CtNamed("Array", actual_args) => if Array::length(actual_args) == 1 {
        generic_target_match(template = inner, actual = Array::get(actual_args, at = 0), tparams = tparams, args = args)
      } else {
        false
      },
      _ => false
    },
    CtOption(inner) => match actual {
      CtOption(actual_inner) => generic_target_match(template = inner, actual = actual_inner, tparams = tparams, args = args),
      CtNamed("Option", actual_args) => if Array::length(actual_args) == 1 {
        generic_target_match(template = inner, actual = Array::get(actual_args, at = 0), tparams = tparams, args = args)
      } else {
        false
      },
      _ => false
    },
    CtTuple(items) => match actual {
      CtTuple(actual_items) => if Array::length(items) == Array::length(actual_items) {
        let mut i = 0
        let mut ok = true
        while i < Array::length(items) && ok {
          ok = generic_target_match(template = Array::get(items, at = i), actual = Array::get(actual_items, at = i), tparams = tparams, args = args)
          i = i + 1
        }
        ok
      } else {
        false
      },
      _ => false
    },
    CtFn(params, ret, effect) => match actual {
      CtFn(actual_params, actual_ret, actual_effect) => if Array::length(params) == Array::length(actual_params) && impl_pattern_effects_equal(left = effect, right = actual_effect) {
        let mut i = 0
        let mut ok = true
        while i < Array::length(params) && ok {
          ok = generic_target_match(template = Array::get(params, at = i), actual = Array::get(actual_params, at = i), tparams = tparams, args = args)
          i = i + 1
        }
        ok && generic_target_match(template = ret, actual = actual_ret, tparams = tparams, args = args)
      } else {
        false
      },
      _ => false
    },
    _ => types_equal(a = template, b = actual)
  }
}

fn trait_ref_type_expr_type(_ expr: TypeExpr) -> Type {
  match expr {
    TyName(name) => match resolve_builtin(name) {
      Some(ty) => ty,
      None => CtNamed(name, array_empty())
    },
    TyApp(name, args) => {
      let resolved = for arg in args {
        trait_ref_type_expr_type(arg)
      }
      if name == "Array" && Array::length(resolved) == 1 {
        CtArray(Array::get(resolved, at = 0))
      } else if name == "Option" && Array::length(resolved) == 1 {
        CtOption(Array::get(resolved, at = 0))
      } else {
        CtNamed(name, resolved)
      }
    },
    TyTuple(items) => CtTuple(for item in items {
      trait_ref_type_expr_type(item)
    }),
    TyFn(params, ret, effect) => CtFn(for param in params {
      trait_ref_type_expr_type(param)
    }, trait_ref_type_expr_type(ret), effect),
    TyUnit => CtUnit
  }
}

fn generic_trait_ref_matches(template_key: String, actual_key: String, tparams: Array[String], args: Array[Type]) -> Bool {
  if template_key == actual_key {
    true
  } else {
    match trait_ref_from_key(template_key) {
      Some(template) => match trait_ref_from_key(actual_key) {
        Some(actual) => if trait_ref_name(template_key) == trait_ref_name(actual_key) {
          generic_target_match(template = trait_ref_type_expr_type(template), actual = trait_ref_type_expr_type(actual), tparams = tparams, args = args)
        } else {
          false
        },
        None => false
      },
      None => false
    }
  }
}

/// Match the retained impl target against one concrete use and return its type
/// arguments in impl-binder order. Reordered targets such as `Pair[V, K]`
/// therefore bind V to the first concrete slot and K to the second instead of
/// silently applying bounds by declaration order.
fn generic_target_args(tparams: Array[String], target: Type, resolved: Type) -> Option[Array[Type]] {
  let target_args = type_args_of(target)
  if Array::length(target_args) == 0 {
    let legacy = type_args_of(resolved)
    if type_constructor_name(target) == type_constructor_name(resolved) && Array::length(legacy) == Array::length(tparams) {
      Some(legacy)
    } else {
      None
    }
  } else {
    let args = array_empty()
    let mut i = 0
    while i < Array::length(tparams) {
      Array::push(args, value = CtUnknown)
      i = i + 1
    }
    if generic_target_match(template = target, actual = resolved, tparams = tparams, args = args) {
      let mut ai = 0
      let mut complete = true
      while ai < Array::length(args) {
        match Array::get(args, at = ai) {
          CtUnknown => {
            complete = false
          },
          _ => ()
        }
        ai = ai + 1
      }
      if complete {
        Some(args)
      } else {
        None
      }
    } else {
      None
    }
  }
}

/// The target arguments of a generic impl of `itrait` (`impl [tparams]
/// itrait for target`) when it stands for `trait_name` itself at `resolved`,
/// before its parameter bounds are judged; None when it does not. The rule
/// `generic_impl_satisfies` applies, shared with `generic_impl_cmp_refusal`.
fn generic_direct_impl_args(full: TypeEnv, itrait: String, tparams: Array[String], target: Type, trait_name: String, resolved: Type) -> Option[Array[Type]] {
  let head = type_constructor_name(resolved)
  if head != "" && type_constructor_name(target) == head && trait_is_method_bearing(env = full, trait_name = trait_name) {
    match generic_target_args(tparams = tparams, target = target, resolved = resolved) {
      Some(args) => if generic_trait_ref_matches(template_key = itrait, actual_key = trait_name, tparams = tparams, args = args) {
        Some(args)
      } else {
        None
      },
      None => None
    }
  } else {
    None
  }
}

/// The same for a generic impl of a SUBTRAIT of `trait_name` (`impl [T: Eq]
/// Child for Box[T]` standing for `Base` with `trait Child: Base`): the rule
/// `type_implements_check_super` applies, shared with
/// `generic_impl_cmp_refusal`.
fn generic_subtrait_impl_args(full: TypeEnv, itrait: String, tparams: Array[String], target: Type, trait_name: String, resolved: Type) -> Option[Array[Type]] {
  let head = type_constructor_name(resolved)
  if head != "" && type_constructor_name(target) == head && trait_is_method_bearing(env = full, trait_name = trait_name) && trait_is_subtrait(env = full, sub = itrait, super_name = trait_name) && itrait != trait_name {
    generic_target_args(tparams = tparams, target = target, resolved = resolved)
  } else {
    None
  }
}

/// Does an in-env method-bearing generic impl cover the concrete `resolved`
/// type? The retained target is matched structurally and each bound is checked
/// against the concrete argument bound to its own impl parameter. The
/// dict-passing desugar synthesizes a `{ method: C::method }` witness
/// (unbounded) or a nested closure witness supplying the element dict
/// (bounded). (#5 generic impls.)
fn generic_impl_satisfies(scan: TypeEnv, full: TypeEnv, s: Subst, trait_name: String, resolved: Type) -> Bool {
  match scan {
    EnvEmpty => false,
    EnvBind(_, _, rest) => generic_impl_satisfies(scan = rest, full = full, s = s, trait_name = trait_name, resolved = resolved),
    EnvTraitDef(_, _, _, _, rest, _, _) => generic_impl_satisfies(scan = rest, full = full, s = s, trait_name = trait_name, resolved = resolved),
    EnvTraitImpl(_, _, rest) => generic_impl_satisfies(scan = rest, full = full, s = s, trait_name = trait_name, resolved = resolved),
    EnvShowWrappers(_, _, rest) => generic_impl_satisfies(scan = rest, full = full, s = s, trait_name = trait_name, resolved = resolved),
    EnvMutCell(_, _, rest) => generic_impl_satisfies(scan = rest, full = full, s = s, trait_name = trait_name, resolved = resolved),
    EnvTraitImplGen(itrait, tparams, bounds, target, rest) => match generic_direct_impl_args(full = full, itrait = itrait, tparams = tparams, target = target, trait_name = trait_name, resolved = resolved) {
      Some(args) => if generic_bounds_hold(full = full, s = s, tparams = tparams, bounds = bounds, args = args) {
        true
      } else {
        generic_impl_satisfies(scan = rest, full = full, s = s, trait_name = trait_name, resolved = resolved)
      },
      None => generic_impl_satisfies(scan = rest, full = full, s = s, trait_name = trait_name, resolved = resolved)
    },
    EnvTypeDefs(_, _, rest) => generic_impl_satisfies(scan = rest, full = full, s = s, trait_name = trait_name, resolved = resolved),
    EnvFlat(_) => false,
    EnvCached(_, _, rest) => generic_impl_satisfies(scan = rest, full = full, s = s, trait_name = trait_name, resolved = resolved)
  }
}

/// #3350: the parameter bound that keeps a generic impl of `trait_name`, or
/// of a subtrait of it, from applying to `resolved` because it reaches no
/// comparison witness there --
/// `Some((bound, refused, arg))`, where `refused` is the trait
/// `erased_cmp_bound_refusal` names for `bound` at the argument `arg` -- or
/// None. The checker names the edit from it; `generic_bounds_hold` is what
/// refuses.
export fn generic_impl_cmp_refusal(env: TypeEnv, s: Subst, trait_name: String, resolved: Type) -> Option[(String, String, Type)] {
  let head = type_constructor_name(resolved)
  if head == "" {
    None
  } else {
    gicr_scan(scan = env, full = env, s = s, trait_name = trait_name, resolved = resolved, head = head)
  }
}

fn gicr_scan(scan: TypeEnv, full: TypeEnv, s: Subst, trait_name: String, resolved: Type, head: String) -> Option[(String, String, Type)] {
  match scan {
    EnvEmpty => None,
    EnvBind(_, _, rest) => gicr_scan(scan = rest, full = full, s = s, trait_name = trait_name, resolved = resolved, head = head),
    EnvTraitDef(_, _, _, _, rest, _, _) => gicr_scan(scan = rest, full = full, s = s, trait_name = trait_name, resolved = resolved, head = head),
    EnvTraitImpl(_, _, rest) => gicr_scan(scan = rest, full = full, s = s, trait_name = trait_name, resolved = resolved, head = head),
    EnvShowWrappers(_, _, rest) => gicr_scan(scan = rest, full = full, s = s, trait_name = trait_name, resolved = resolved, head = head),
    EnvMutCell(_, _, rest) => gicr_scan(scan = rest, full = full, s = s, trait_name = trait_name, resolved = resolved, head = head),
    EnvTraitImplGen(itrait, tparams, bounds, target, rest) => {
      // Codex on #3349: the impls resolution would use -- of `trait_name`
      // itself (`generic_impl_satisfies`) or of a subtrait of it
      // (`type_implements_check_super`) -- by the same two rules, so a
      // `[U: Base]` refused because `impl [T: Eq] Child for Box[T]`'s bound
      // reaches no witness names that bound too.
      let candidate = match generic_direct_impl_args(full = full, itrait = itrait, tparams = tparams, target = target, trait_name = trait_name, resolved = resolved) {
        Some(args) => Some(args),
        None => generic_subtrait_impl_args(full = full, itrait = itrait, tparams = tparams, target = target, trait_name = trait_name, resolved = resolved)
      }
      match candidate {
        Some(args) => match gicr_bound_refusal(full = full, s = s, tparams = tparams, bounds = bounds, args = args) {
          Some(found) => Some(found),
          None => gicr_scan(scan = rest, full = full, s = s, trait_name = trait_name, resolved = resolved, head = head)
        },
        None => gicr_scan(scan = rest, full = full, s = s, trait_name = trait_name, resolved = resolved, head = head)
      }
    },
    EnvTypeDefs(_, _, rest) => gicr_scan(scan = rest, full = full, s = s, trait_name = trait_name, resolved = resolved, head = head),
    EnvFlat(_) => None,
    EnvCached(_, _, rest) => gicr_scan(scan = rest, full = full, s = s, trait_name = trait_name, resolved = resolved, head = head)
  }
}

fn gicr_bound_refusal(full: TypeEnv, s: Subst, tparams: Array[String], bounds: Array[(String, Array[String])], args: Array[Type]) -> Option[(String, String, Type)] {
  let mut found: Option[(String, String, Type)] = None
  let mut have = false
  let mut bi = 0
  while bi < Array::length(bounds) {
    let (param, btraits) = Array::get(bounds, at = bi)
    let ai = generic_param_index(tparams = tparams, name = param)
    let mut ti = 0
    while ti < Array::length(btraits) {
      let bt = Array::get(btraits, at = ti)
      if !have && bt != "" && ai >= 0 && ai < Array::length(args) {
        match subst_apply(s = s, ty = Array::get(args, at = ai)) {
          CtUnknown => (),
          CtVar(_) => (),
          arg => {
            let refused = if impl_param_add32_refused(env = full, bound = bt, resolved = arg) {
              impl_param_add32_marker()
            } else {
              erased_cmp_bound_refusal(env = full, bound = bt, resolved = arg)
            }
            if refused != "" {
              found = Some((bt, refused, arg))
              have = true
            } else {
              ()
            }
          }
        }
      } else {
        ()
      }
      ti = ti + 1
    }
    bi = bi + 1
  }
  found
}

/// #3825 (Codex on #3857): a generic impl's parameter bound that entails
/// `Add`, at an `Int32` / `UInt32` argument, does not hold. The impl's body
/// adds through the parameter's `Add` witness, and that dictionary is built
/// after the `Int32` pass has erased the argument to `Int`, so
/// `impl [T: Add] Twice for Box[T]` at `Box[Int32]` doubled `2147483647` to
/// `4294967294`. A generic call's own `[T: Add]` wraps (its witness is chosen
/// from the checker's row at the call); an impl's parameter has no call site
/// of its own to carry that row, so it is refused instead.
fn impl_param_add32_refused(env: TypeEnv, bound: String, resolved: Type) -> Bool {
  let is32 = match resolved {
    CtInt32 => true,
    CtUInt32 => true,
    _ => false
  }
  if !is32 {
    false
  } else {
    let pending: Array[String] = [bound]
    let seen: Array[String] = []
    let mut found = false
    while !found && Array::length(pending) > 0 {
      let cur = Array::get(pending, at = Array::length(pending) - 1)
      Array::truncate(pending, length = Array::length(pending) - 1)
      let name = trait_ref_name(cur)
      if ecb_seen(seen = seen, name = name) {
        ()
      } else if name == "Add" {
        found = true
      } else {
        Array::push(seen, value = name)
        let supers = trait_supers(env = env, name = name)
        let mut i = 0
        while i < Array::length(supers) {
          Array::push(pending, value = Array::get(supers, at = i))
          i = i + 1
        }
      }
    }
    found
  }
}

/// The trait `generic_impl_cmp_refusal` names for `impl_param_add32_refused`.
/// `#` cannot start a trait name, so it is told apart from a real one.
export fn impl_param_add32_marker() -> String {
  "#add32"
}

//# Comparison bounds that reach no witness (#2523, #3327, #3350)

/// #2523: does the builtin `==` / `<` compare a value of this type by VALUE?
///
/// An erased formal compares with the builtin `==` / `<` whenever no witness
/// reaches it. That is content comparison for the tagged immediates and the
/// byte string (`Int`, `Bool`, `Char`, `String`), and REFERENCE identity for
/// everything else: `Array`, `Bytes`, a tuple, an `Option`, a declared struct
/// or enum.
///
/// **`Double` is NOT on the list** (#2895). It is not a tagged immediate the
/// way an `Int` is, so the raw comparison reads the box, not the number:
/// `bare[T: Eq](1.5, 1.5)` over a marker `Eq` answered FALSE, and under
/// `[T: Ord]` both `lt(2.5, 1.5)` and `gt(2.5, 1.5)` answered as if the
/// operands were addresses.
///
/// Erring toward `false` costs a correct program a diagnostic, which the gates
/// see; erring toward `true` keeps a silently wrong answer, which nothing sees.
fn erased_cmp_is_by_value(_ ty: Type) -> Bool {
  match ty {
    CtInt => true,
    CtInt32 => true,
    CtUInt32 => true,
    CtBool => true,
    CtChar => true,
    CtString => true,
    CtNamed(name, args) => Array::length(args) == 0 && (name == "Int" || name == "Bool" || name == "Char" || name == "String"),
    _ => false
  }
}

/// #3158 review: does the erased `+` an `[T: Add]` body lowers to
/// (`__generic_add`) add a value of this type correctly? It concatenates two
/// packed strings and otherwise runs a raw `i64.add`: right for `Int` (a tagged
/// immediate) and `String`, the raw add of two boxes for anything else
/// (`add2(1.5, 2.25)` printed `add=0`).
fn erased_add_is_by_value(_ ty: Type) -> Bool {
  match ty {
    CtInt => true,
    CtString => true,
    CtNamed(name, args) => Array::length(args) == 0 && (name == "Int" || name == "String"),
    _ => false
  }
}

/// #3350: the trait through which `bound` would compare (or add) a `resolved`
/// value WITHOUT a witness -- the bound itself, or a trait it extends through
/// its supertraits, transitively -- or "" when every comparison it licenses is
/// sound at `resolved`.
///
/// What decides it is whether the operator can reach a witness, not whether the
/// trait declares methods:
///
/// - `==` dispatches only through `equals(Self, Self) -> Bool`
///   (`dtd_eq_witness_dict`). A bound that reaches a trait named `Eq` is sound
///   when its witness dictionary carries that method -- the first `equals` its
///   supertraits flatten to, which `bound_flat_self_equals` computes with the
///   dictionary's own flattening: the builtin `Eq`, a program `Eq` that
///   declares it, a subtrait that declares it (`trait Key: Eq { equals(Self,
///   Self) -> Bool }`), or a sibling supertrait flattened first. Measured on
///   the #3327 stage2 (43ee1c792), a program `Eq` whose one method was
///   `tag(Self) -> Int` answered `false` for two equal `Pt`, and so did
///   `trait Key: Bad + Good + Eq {}` over the BUILTIN `Eq`, whose dictionary
///   keeps `Bad`'s `equals(Int, Int)` (#3350).
/// - `<` has no witness path at all, so a trait named `Ord` is judged by the
///   type alone: a program `Ord` with `rank` or `compare` answered `true` for
///   `smaller(Token 2, Token 1)`.
/// - `+` dispatches through the first retained `add(Self, Self) -> Self`.
///   A marker Add, or an Add with only `plus`, still uses `__generic_add`
///   and is refused at boxed values.
///
/// Every other trait, and every comparison at a type the builtin compares by
/// value, is left alone. The walk mirrors `bound_entails_send` and keeps a
/// visited set, so a cyclic declaration terminates.
export fn erased_cmp_bound_refusal(env: TypeEnv, bound: String, resolved: Type) -> String {
  let pending: Array[String] = [bound]
  let seen: Array[String] = []
  let mut found = ""
  while found == "" && Array::length(pending) > 0 {
    let cur = Array::get(pending, at = Array::length(pending) - 1)
    Array::truncate(pending, length = Array::length(pending) - 1)
    let name = trait_ref_name(cur)
    if ecb_seen(seen = seen, name = name) {
      ()
    } else {
      Array::push(seen, value = name)
      let refused = if name == "Eq" {
        not(erased_cmp_is_by_value(resolved)) && not(bound_flat_self_equals(env = env, bound = bound))
      } else if name == "Ord" {
        not(erased_cmp_is_by_value(resolved))
      } else if name == "Add" {
        not(erased_add_is_by_value(resolved)) && not(bound_flat_self_add(env = env, bound = bound))
      } else {
        false
      }
      if refused {
        found = cur
      } else {
        let supers = trait_supers(env = env, name = name)
        let mut i = 0
        while i < Array::length(supers) {
          Array::push(pending, value = Array::get(supers, at = i))
          i = i + 1
        }
      }
    }
  }
  found
}

fn ecb_seen(seen: Array[String], name: String) -> Bool {
  let mut found = false
  let mut i = 0
  while !found && i < Array::length(seen) {
    if Array::get(seen, at = i) == name {
      found = true
    } else {
      ()
    }
    i = i + 1
  }
  found
}

/// Decode an instantiated bound reference while preserving its fresh type
/// variables. The serialized `#tpvid.N` spelling is checker provenance, not a
/// nominal type name.
fn instantiated_bound_ref_type(_ expr: TypeExpr) -> Type {
  match expr {
    TyName(name) => match parse_trait_bound_vid(name) {
      Some(id) => CtVar(id),
      None => trait_ref_type_expr_type(expr)
    },
    TyApp(name, nested) => {
      let args = for item in nested {
        instantiated_bound_ref_type(item)
      }
      match parse_trait_bound_vid(name) {
        Some(id) => apply_type_constructor(head = CtVar(id), args = args),
        None => if name == "Array" && Array::length(args) == 1 {
          CtArray(Array::get(args, at = 0))
        } else if name == "Option" && Array::length(args) == 1 {
          CtOption(Array::get(args, at = 0))
        } else {
          CtNamed(name, args)
        }
      }
    },
    TyTuple(items) => CtTuple(for item in items {
      instantiated_bound_ref_type(item)
    }),
    TyFn(params, ret, effect) => CtFn(for param in params {
      instantiated_bound_ref_type(param)
    }, instantiated_bound_ref_type(ret), effect),
    TyUnit => CtUnit
  }
}

/// Instantiate the trait reference written on a generic impl using the type
/// arguments recovered by matching its target against the receiver.
fn generic_impl_ref_type(expr: TypeExpr, tparams: Array[String], args: Array[Type]) -> Type {
  match expr {
    TyName(name) => {
      let pi = generic_param_index(tparams = tparams, name = name)
      if pi >= 0 && pi < Array::length(args) {
        Array::get(args, at = pi)
      } else {
        trait_ref_type_expr_type(expr)
      }
    },
    TyApp(name, nested) => {
      let resolved = for item in nested {
        generic_impl_ref_type(expr = item, tparams = tparams, args = args)
      }
      let pi = generic_param_index(tparams = tparams, name = name)
      if pi >= 0 && pi < Array::length(args) {
        apply_type_constructor(head = Array::get(args, at = pi), args = resolved)
      } else if name == "Array" && Array::length(resolved) == 1 {
        CtArray(Array::get(resolved, at = 0))
      } else if name == "Option" && Array::length(resolved) == 1 {
        CtOption(Array::get(resolved, at = 0))
      } else {
        CtNamed(name, resolved)
      }
    },
    TyTuple(items) => CtTuple(for item in items {
      generic_impl_ref_type(expr = item, tparams = tparams, args = args)
    }),
    TyFn(params, ret, effect) => CtFn(for param in params {
      generic_impl_ref_type(expr = param, tparams = tparams, args = args)
    }, generic_impl_ref_type(expr = ret, tparams = tparams, args = args), effect),
    TyUnit => CtUnit
  }
}

fn trait_key_type_for_bound(_ key: String) -> Type {
  match trait_ref_from_key(key) {
    Some(reference) => instantiated_bound_ref_type(reference),
    None => CtNamed(key, array_empty())
  }
}

fn trait_key_type_for_generic_impl(key: String, tparams: Array[String], args: Array[Type]) -> Type {
  match trait_ref_from_key(key) {
    Some(reference) => generic_impl_ref_type(expr = reference, tparams = tparams, args = args),
    None => CtNamed(key, array_empty())
  }
}

/// Count impls that can determine the type arguments of `bound` from a
/// concrete receiver. A count above one is deliberately ambiguous and the
/// caller leaves the variables unresolved.
fn trait_bound_receiver_refinements(scan: TypeEnv, full: TypeEnv, s: Subst, bound: String, receiver: Type) -> (Int, Subst) {
  let (rest_count, rest_subst) = match scan {
    EnvEmpty => (0, s),
    EnvBind(_, _, rest) => trait_bound_receiver_refinements(scan = rest, full = full, s = s, bound = bound, receiver = receiver),
    EnvTraitDef(_, _, _, _, rest, _, _) => trait_bound_receiver_refinements(scan = rest, full = full, s = s, bound = bound, receiver = receiver),
    EnvTraitImpl(_, _, rest) => trait_bound_receiver_refinements(scan = rest, full = full, s = s, bound = bound, receiver = receiver),
    EnvShowWrappers(_, _, rest) => trait_bound_receiver_refinements(scan = rest, full = full, s = s, bound = bound, receiver = receiver),
    EnvMutCell(_, _, rest) => trait_bound_receiver_refinements(scan = rest, full = full, s = s, bound = bound, receiver = receiver),
    EnvTraitImplGen(_, _, _, _, rest) => trait_bound_receiver_refinements(scan = rest, full = full, s = s, bound = bound, receiver = receiver),
    EnvTypeDefs(_, _, rest) => trait_bound_receiver_refinements(scan = rest, full = full, s = s, bound = bound, receiver = receiver),
    EnvFlat(_) => (0, s),
    EnvCached(_, _, rest) => trait_bound_receiver_refinements(scan = rest, full = full, s = s, bound = bound, receiver = receiver)
  }
  let current = match scan {
    EnvTraitImpl(itrait, target, _) => if trait_ref_name(itrait) == trait_ref_name(bound) && concrete_trait_impl_target_matches(full = full, trait_name = trait_ref_name(bound), target = subst_apply(s = s, ty = target), resolved = receiver) {
      unify(a = trait_key_type_for_bound(bound), b = trait_key_type_for_generic_impl(key = itrait, tparams = array_empty(), args = array_empty()), s = s)
    } else {
      None
    },
    EnvTraitImplGen(itrait, tparams, bounds, target, _) => if trait_ref_name(itrait) == trait_ref_name(bound) {
      match generic_target_args(tparams = tparams, target = target, resolved = receiver) {
        Some(args) => if generic_bounds_hold(full = full, s = s, tparams = tparams, bounds = bounds, args = args) {
          unify(a = trait_key_type_for_bound(bound), b = trait_key_type_for_generic_impl(key = itrait, tparams = tparams, args = args), s = s)
        } else {
          None
        },
        None => None
      }
    } else {
      None
    },
    _ => None
  }
  match current {
    Some(current_subst) => {
      if rest_count == 0 {
        (1, current_subst)
      } else if rest_count == 1 && types_equal(a = subst_apply(s = current_subst, ty = trait_key_type_for_bound(bound)), b = subst_apply(s = rest_subst, ty = trait_key_type_for_bound(bound))) {
        // Import projection may retain the same impl through more than one
        // facade layer. Equal answers are duplicates, not an ambiguous choice.
        (1, current_subst)
      } else {
        (rest_count + 1, s)
      }
    },
    None => (rest_count, rest_subst)
  }
}

/// Refine type variables mentioned by a parameter's applied trait bounds from
/// the unique visible impl for its concrete receiver. This lets a signature
/// such as `[A, C: Iterator[A]] (C, (A) -> B)` infer `A` from `Array[A]`
/// before checking the callback, without making an ambiguous impl choice.
export fn refine_trait_bounds_from_receiver(env: TypeEnv, s: Subst, param: Type, receiver: Type) -> Subst {
  match param {
    CtVar(id) => {
      let bounds = subst_bounds_for(s = s, id = id)
      let mut out = s
      let mut i = 0
      while i < Array::length(bounds) {
        let bound = Array::get(bounds, at = i)
        let (count, refined) = trait_bound_receiver_refinements(scan = env, full = env, s = out, bound = bound, receiver = subst_apply(s = out, ty = receiver))
        if count == 1 {
          out = refined
        } else {
          ()
        }
        i = i + 1
      }
      out
    },
    _ => s
  }
}

/// Every non-empty per-parameter bound is satisfied by every concrete type
/// argument. Empty bound lists (Increment A) hold trivially.
fn generic_bounds_hold(full: TypeEnv, s: Subst, tparams: Array[String], bounds: Array[(String, Array[String])], args: Array[Type]) -> Bool {
  let mut bi = 0
  let mut ok = true
  while bi < Array::length(bounds) {
    let (param, btraits) = Array::get(bounds, at = bi)
    let ai = generic_param_index(tparams = tparams, name = param)
    let mut ti = 0
    while ti < Array::length(btraits) {
      let bt = Array::get(btraits, at = ti)
      if bt != "" && ai >= 0 && ai < Array::length(args) {
        // A still-unknown element type (e.g. a struct literal, which the
        // checker types as `CtUnknown`) defers its bound to the dict-passing
        // desugar — which infers the element type syntactically and either
        // threads the nested witness or fails loudly. This mirrors how a
        // `CtUnknown` receiver skips the top-level bound check, so accepting
        // it here is no less sound.
        //
        // #3350: a comparison bound that reaches no witness at this argument
        // does not hold either. The impl's body compares the parameter with
        // the builtin `==` / `<` / `+`, so `impl [T: Eq] Same for Box[T]`
        // over a marker `Eq` answered `false` for two equal `Box[Pt]`. A
        // still-open argument is judged where its own formal is instantiated.
        match subst_apply(s = s, ty = Array::get(args, at = ai)) {
          CtUnknown => (),
          CtVar(_) => if not(type_implements_trait(env = full, s = s, ty = Array::get(args, at = ai), trait_name = bt)) {
            ok = false
          } else {
            ()
          },
          arg => if not(type_implements_trait(env = full, s = s, ty = arg, trait_name = bt)) || erased_cmp_bound_refusal(env = full, bound = bt, resolved = arg) != "" || impl_param_add32_refused(env = full, bound = bt, resolved = arg) {
            ok = false
          } else {
            ()
          }
        }
      } else {
        ()
      }
      ti = ti + 1
    }
    bi = bi + 1
  }
  ok
}

export fn type_implements_trait(env: TypeEnv, s: Subst, ty: Type, trait_name: String) -> Bool {
  let resolved = subst_apply(s = s, ty = ty)
  if type_implements_check_env(e = env, full = env, trait_name = trait_name, resolved = resolved) {
    true
  }
  else if generic_impl_satisfies(scan = env, full = env, s = s, trait_name = trait_name, resolved = resolved) {
    true
  }
  else if int32_type(resolved) && int32_borrows_int_impl(env = env, trait_name = trait_name) && type_implements_trait(env = env, s = s, ty = CtInt, trait_name = trait_name) {
    true
  }
  else {
    // #1503 follow-up: this used to bail out when the BOUND trait had no
    // supertraits of its own, which is the wrong question -- what satisfies a
    // `[T: Base]` bound is an impl of some trait that has `Base` as a super,
    // and `Base` itself being a root trait is the normal case for that. The
    // guard made `trait Child: Base` + `impl Child for P` + `[T: Base]` report
    // `no impl Base for P` for EVERY type, parameterized or not (measured on a
    // plain struct), i.e. supertrait-satisfied bounds never worked at all.
    type_implements_check_super(e2 = env, full_env = env, s = s, trait_name = trait_name, resolved = resolved)
  }
}

/// #3730: an `Int32` / `UInt32` value is an `Int` once erased, so the
/// witness a bound's dictionary reaches for it is `Int`'s. That is exact for a
/// trait whose methods only READ `Self` (`Hash::hash_key(Self) -> String`
/// hashes the same integer), and only that shape is borrowed: every parameter
/// is exactly `Self` or mentions no `Self`, and no result mentions it. Any
/// other place a `Self` can sit lets `Int`'s impl produce one outside the
/// 32-bit range, unwrapped: a result (`Default`, `Add`), a container it can
/// write (`fill(Self, Array[Self])` pushing 2147483648), or a callback it can
/// call. Nor is a marker trait, one with supertraits or one with header
/// parameters borrowed, which this rule does not read.
///
/// #3824: the one `Self` result borrowed is the shipped `Default`'s, whose
/// `Int` impl returns `0`, in range for both types. "Shipped" is decided by
/// where the definition came from, not by its shape: the seed's rows (no
/// definition at all), or a trait declared as `Default` in a module reached
/// through an import spelled `@vibe/core`, under whatever local name an `as`
/// gives it (`env_trait_definition_origin`). A program's own
/// `trait Default`, or one reached any other way, keeps the rule above, so an
/// `impl Default for Int` returning 4294967296 is not borrowed.
fn int32_borrows_int_impl(env: TypeEnv, trait_name: String) -> Bool {
  if int32_borrows_shipped_default(env = env, trait_name = trait_ref_name(trait_name)) {
    true
  } else {
    int32_borrows_reading_impl(env = env, trait_name = trait_name)
  }
}

fn int32_borrows_shipped_default(env: TypeEnv, trait_name: String) -> Bool {
  match trait_definition(env = env, name = trait_name) {
    None => trait_name == "Default",
    Some((supers, methods, params, _)) => Array::length(supers) == 0 && Array::length(params) == 0 && Array::length(methods) == 1 && match Array::get(methods, at = 0) {
      (mname, mparams, TyName(ret)) => mname == "default" && Array::length(mparams) == 0 && ret == "Self",
      _ => false
    } && env_trait_definition_origin(env = env, name = trait_name) == Some(("@vibe/core", "Default"))
  }
}

fn int32_borrows_reading_impl(env: TypeEnv, trait_name: String) -> Bool {
  match trait_definition(env = env, name = trait_name) {
    Some((supers, methods, params, _)) => if Array::length(methods) == 0 || Array::length(supers) > 0 || Array::length(params) > 0 {
      false
    } else {
      let mut ok = true
      for m in methods {
        let (_, params, ret) = m
        if type_expr_mentions_self(ret) {
          ok = false
        } else {
          ()
        }
        for p in params {
          let bare_self = match p {
            TyName(n) => n == "Self",
            _ => false
          }
          if !bare_self && type_expr_mentions_self(p) {
            ok = false
          } else {
            ()
          }
        }
      }
      ok
    },
    None => false
  }
}

fn int32_type(_ t: Type) -> Bool {
  match t {
    CtInt32 => true,
    CtUInt32 => true,
    _ => false
  }
}

fn type_expr_mentions_self(_ t: TypeExpr) -> Bool {
  match t {
    TyName(n) => n == "Self",
    TyApp(n, args) => n == "Self" || type_exprs_mention_self(args),
    TyFn(params, ret, _) => type_exprs_mention_self(params) || type_expr_mentions_self(ret),
    TyTuple(items) => type_exprs_mention_self(items),
    TyUnit => false
  }
}

fn type_exprs_mention_self(_ ts: Array[TypeExpr]) -> Bool {
  let mut found = false
  for t in ts {
    if type_expr_mentions_self(t) {
      found = true
    } else {
      ()
    }
  }
  found
}

//# #3042: the prelude `Ordering`

/// #3042 (ADR-0118): the result type of `compare`. `derive (Ord)` generates
/// `T::compare(a, b) -> Ordering`, and every program sees `Ordering` and its
/// constructors `Less` / `Equal` / `Greater` without an import, the way it
/// sees `Option`. It is an ordinary enum, not a checker-owned type: the checker
/// checks this declaration ahead of a module that does not declare its own
/// (`seed_prelude_ordering`), and the lowering appends it to a program that
/// constructs one (`dtd_append_prelude_ordering`), so exhaustiveness, `==`,
/// `Show` and codegen all treat it exactly like a declared enum. The variant
/// order is the order `derive (Ord)` compares in: `Less < Equal < Greater`.
export fn prelude_ordering_stmt() -> Stmt {
  let variants: Array[(String, Array[TypeExpr])] = array_empty()
  let less_payload: Array[TypeExpr] = array_empty()
  let equal_payload: Array[TypeExpr] = array_empty()
  let greater_payload: Array[TypeExpr] = array_empty()
  Array::push(variants, value = ("Less", less_payload))
  Array::push(variants, value = ("Equal", equal_payload))
  Array::push(variants, value = ("Greater", greater_payload))
  let derives: Array[String] = array_empty()
  Array::push(derives, value = "Eq")
  Array::push(derives, value = "Ord")
  Array::push(derives, value = "Show")
  let params: Array[String] = array_empty()
  SEnum(false, "Ordering", params, variants, derives)
}

/// #3042: is `name` one of the prelude `Ordering`'s constructor spellings?
export fn is_prelude_ordering_variant(_ name: String) -> Bool {
  name == "Less" || name == "Equal" || name == "Greater"
}

/// #3042: does `stmts` declare the type name `Ordering`, or a constructor or
/// value spelled like one of its variants, at top level? Such a program keeps its
/// own declaration: the prelude enum is neither checked ahead of it nor
/// appended to it, because constructors are global across a merged program
/// and two `Less` would make every bare reference ambiguous.
export fn stmts_shadow_prelude_ordering(_ stmts: Array[Stmt]) -> Bool {
  let mut found = false
  let mut i = 0
  while !found && i < Array::length(stmts) {
    found = match Array::get(stmts, at = i) {
      SEnum(_, name, _, variants, _) => name == "Ordering" || variants_shadow_prelude_ordering(variants),
      SSuberror(_, name, variants) => name == "Ordering" || variants_shadow_prelude_ordering(variants),
      SStruct(_, name, _, _, _, _) => name == "Ordering",
      STypeAlias(_, name, _, _) => name == "Ordering",
      // A top-level value spelled like a constructor wins over it where the
      // two meet, so a derived `compare` would build that value.
      SLet(_, _, name, _, _) => name == "Ordering" || is_prelude_ordering_variant(name),
      SLetMut(name, _, _) => name == "Ordering" || is_prelude_ordering_variant(name),
      SExternLet(name, _) => name == "Ordering" || is_prelude_ordering_variant(name),
      SLetPat(pat, _) => pat_binds_prelude_ordering_name(pat),
      _ => false
    }
    i = i + 1
  }
  found
}

fn variants_shadow_prelude_ordering(_ variants: Array[(String, Array[TypeExpr])]) -> Bool {
  let mut found = false
  let mut i = 0
  while !found && i < Array::length(variants) {
    let (vname, _) = Array::get(variants, at = i)
    found = is_prelude_ordering_variant(vname)
    i = i + 1
  }
  found
}

/// #3042: does `stmts` declare an `enum Ordering { Less; Equal; Greater }` of
/// exactly the prelude's shape (nullary variants, in that order)? A program
/// that re-declares the prelude enum verbatim -- `@vibe/builtin`'s
/// `ordering.vibe` is one -- still gets a working `derive (Ord)`; any other
/// declaration of those names cannot, and the checker says so rather than let
/// the generated `compare` build values of the wrong type.
export fn stmts_declare_prelude_ordering_shape(_ stmts: Array[Stmt]) -> Bool {
  let mut found = false
  let mut i = 0
  while !found && i < Array::length(stmts) {
    found = match Array::get(stmts, at = i) {
      SEnum(_, name, params, variants, _) => name == "Ordering" && Array::length(params) == 0 && Array::length(variants) == 3 && ordering_variant_is(variants = variants, i = 0, expected = "Less") && ordering_variant_is(variants = variants, i = 1, expected = "Equal") && ordering_variant_is(variants = variants, i = 2, expected = "Greater"),
      _ => false
    }
    i = i + 1
  }
  found
}

/// #3042: does `stmts` build or take apart an `Ordering` by syntax -- derive
/// `Ord`, name `Less` / `Equal` / `Greater` (bare or `Ordering::`-qualified)
/// as a value, or match on one as a pattern? The lowering appends the prelude
/// declaration only to such a program; the checker additionally counts a
/// type annotation that mentions `Ordering`.
export fn stmts_use_prelude_ordering(_ stmts: Array[Stmt]) -> Bool {
  let mut found = false
  let mut i = 0
  while !found && i < Array::length(stmts) {
    found = match Array::get(stmts, at = i) {
      SStruct(_, _, _, derives, _, _) => strings_contain_ord(derives),
      SEnum(_, _, _, _, derives) => strings_contain_ord(derives),
      SLet(_, _, _, _, body) => expr_uses_prelude_ordering(body),
      SLetMut(_, _, body) => expr_uses_prelude_ordering(body),
      SLetPat(pat, body) => pat_names_prelude_ordering(pat) || expr_uses_prelude_ordering(body),
      STest(_, body) => expr_uses_prelude_ordering(body),
      SBench(_, body) => expr_uses_prelude_ordering(body),
      SExample(_, body) => expr_uses_prelude_ordering(body),
      SExpr(body) => expr_uses_prelude_ordering(body),
      SModule(_, _, body) => stmts_use_prelude_ordering(body),
      SQualifiedPatternRefs(refs) => qualified_refs_name_ordering(refs),
      _ => false
    }
    i = i + 1
  }
  found
}

fn strings_contain_ord(_ names: Array[String]) -> Bool {
  let mut found = false
  let mut i = 0
  while !found && i < Array::length(names) {
    found = Array::get(names, at = i) == "Ord"
    i = i + 1
  }
  found
}

fn qualified_refs_name_ordering(_ refs: Array[(String, String)]) -> Bool {
  let mut found = false
  let mut i = 0
  while !found && i < Array::length(refs) {
    let (owner, _) = Array::get(refs, at = i)
    found = owner == "Ordering"
    i = i + 1
  }
  found
}

fn name_is_prelude_ordering_ctor(_ name: String) -> Bool {
  is_prelude_ordering_variant(name) || String::starts_with(name, prefix = "Ordering::")
}

fn expr_uses_prelude_ordering(_ e: Expr) -> Bool {
  match e {
    EIdent(name, _) => name_is_prelude_ordering_ctor(name),
    EMatch(scrutinee, arms) => {
      let mut found = expr_uses_prelude_ordering(scrutinee)
      let mut i = 0
      while !found && i < Array::length(arms) {
        let (pat, body) = Array::get(arms, at = i)
        found = pat_names_prelude_ordering(pat) || expr_uses_prelude_ordering(body)
        i = i + 1
      }
      found
    },
    _ => {
      let mark = expr_children_push(e)
      let top = expr_children_top()
      let mut i = mark
      let mut found = false
      while !found && i < top {
        found = expr_uses_prelude_ordering(expr_child_at(i))
        i = i + 1
      }
      expr_children_pop(mark)
      found
    }
  }
}

fn pat_names_prelude_ordering(_ pat: Pat) -> Bool {
  match pat {
    PCtor(name, subs) => name_is_prelude_ordering_ctor(name) || pats_name_prelude_ordering(subs),
    PTuple(subs) => pats_name_prelude_ordering(subs),
    POr(left, right) => pat_names_prelude_ordering(left) || pat_names_prelude_ordering(right),
    PStruct(_, fields) => {
      let mut found = false
      let mut i = 0
      while !found && i < Array::length(fields) {
        let (_, sub) = Array::get(fields, at = i)
        found = pat_names_prelude_ordering(sub)
        i = i + 1
      }
      found
    },
    _ => false
  }
}

/// Does a destructuring pattern BIND a value named `Less` / `Equal` /
/// `Greater` (a field pun such as `let Holder::{ Less } = h`)? That value
/// shadows the constructor as a top-level `let Less` does.
fn pat_binds_prelude_ordering_name(_ pat: Pat) -> Bool {
  match pat {
    PBind(name) => is_prelude_ordering_variant(name),
    PCtor(_, subs) => pats_bind_prelude_ordering_name(subs),
    PTuple(subs) => pats_bind_prelude_ordering_name(subs),
    POr(left, right) => pat_binds_prelude_ordering_name(left) || pat_binds_prelude_ordering_name(right),
    PStruct(_, fields) => {
      let mut found = false
      for field in fields {
        let (_, sub) = field
        if pat_binds_prelude_ordering_name(sub) {
          found = true
        }
      }
      found
    },
    _ => false
  }
}

fn pats_bind_prelude_ordering_name(_ pats: Array[Pat]) -> Bool {
  let mut found = false
  for p in pats {
    if pat_binds_prelude_ordering_name(p) {
      found = true
    }
  }
  found
}

fn pats_name_prelude_ordering(_ pats: Array[Pat]) -> Bool {
  let mut found = false
  let mut i = 0
  while !found && i < Array::length(pats) {
    found = pat_names_prelude_ordering(Array::get(pats, at = i))
    i = i + 1
  }
  found
}

fn ordering_variant_is(variants: Array[(String, Array[TypeExpr])], i: Int, expected: String) -> Bool {
  let (vname, payload) = Array::get(variants, at = i)
  vname == expected && Array::length(payload) == 0
}
