// #897: annotated `: String` so `version` fingerprints as a declared
// contract value (`val String`) for check_contract -- an unannotated
// `export let` reports "lacks the full annotations required by the
// contract" (same requirement as @vibe/parser/polyfill.vibe's own
// `export let version: String = "0.1.0"`).
