import @vibe/core {
  array_empty
}

//# Functions

// Sorted-name index utilities: the compiler's `Map` is a flat assoc list, so
// `Map::get` / `Map::has_key` are O(entries) with an `eq` call per entry --
// every "Map membership index" over a large name table is still a linear
// scan. For per-ident lookups against thousands of names (fn tables, ctor
// tables, fn_returns), a one-time stable sort + binary search turns each
// lookup into ~log2(N) `String <` comparisons.
//
// Stability contract: sort_perm_by_names is a STABLE merge sort, and
// bsearch_leftmost returns the LEFTMOST slot of an equal run -- together
// they preserve linear-scan "first match wins" semantics for tables with
// duplicate keys (results are byte-identical to the linear scan they
// replace).

/// Lexicographic (char-code) string less-than. Written char-by-char instead of
/// `a < b`, which costs one out-of-line `__rt_str_char_code_at` call PER BYTE
/// on one of the compiler's hottest comparisons.
///
/// The reason is NOT the one this comment used to give ("the String `<`
/// desugar, str_lex_diff #746, is newer than the pinned seed"). That is stale:
/// the seed bump to console-exception-rowvar-2026-08-06 moved the seed past
/// #746, and the committed seed compiles and correctly runs `a < b` on String
/// today. Replacing this body with `a < b` was measured to be CORRECT --
/// 81 pairs in the doubly-indirected call shape sort_perm_by_names actually
/// uses, 0 disagreements with this loop, on both the seed and stage2.
///
/// It still cannot land, for a different reason: the bundle build round-trips
/// the compiler's own sources through MERGED SOURCE TEXT.
/// bootstrap_merge_flatten_tool pass 1 runs the seed with
/// VIBE_EMIT_MERGED_SOURCE=1 and pass 3 re-compiles the text it emitted, but
/// the emitted text is POST-DESUGAR: `a < b` on String has already become a
/// call to `str_lex_diff`, which is a codegen builtin and not a source-level
/// name. Pass 3 then dies with `unknown name: str_lex_diff`. So compiler
/// sources may not use String `<` at all until that emitter round-trips --
/// it currently prints a name it cannot read back.
///
/// If that is fixed, this body becomes `a < b` and the loop goes away. Two
/// things to keep when it does. Keep it a FUNCTION with `String` parameters:
/// inlining it as `Array::get(xs, i) < Array::get(xs, j)` is #1184, where `<`
/// on two Array::get results degrades to a LENGTH-FIRST comparison (`"b" <
/// "ab"` comes out true) and would silently reorder the sort. #1184 is marked
/// closed but its own repro still prints the wrong answer on today's stage2;
/// only adding a `: String` annotation rescues it.
export fn str_lt(a: String, b: String) -> Bool {
  let la = String::length(a)
  let lb = String::length(b)
  let lim = if la < lb {
    la
  } else {
    lb
  }
  let mut i = 0
  let mut res = la < lb
  let mut done = false
  while i < lim && !done {
    let ca = String::char_code_at(a, i)
    let cb = String::char_code_at(b, i)
    if ca < cb {
      res = true
      done = true
    } else if ca > cb {
      res = false
      done = true
    } else {
      i = i + 1
    }
  }
  res
}

/// Stable bottom-up merge sort. Returns the permutation `perm` such that
/// names[perm[0]] <= names[perm[1]] <= ... (ties keep original order).
export fn sort_perm_by_names(names: Array[String]) -> Array[Int] {
  let n = Array::length(names)
  let mut src = array_empty()
  let mut i = 0
  while i < n {
    Array::push(src, i)
    i = i + 1
  }
  let mut buf = Array::slice(src, 0, n)
  let mut width = 1
  while width < n {
    let mut lo = 0
    while lo < n {
      let mid = if lo + width < n {
        lo + width
      } else {
        n
      }
      let hi = if lo + width + width < n {
        lo + width + width
      } else {
        n
      }
      let mut a = lo
      let mut b = mid
      let mut k = lo
      while k < hi {
        let take_left = if a >= mid {
          false
        } else if b >= hi {
          true
        } else {
          // names[src[a]] <= names[src[b]] takes the left run: stable.
          !str_lt(Array::get(names, Array::get(src, b)), Array::get(names, Array::get(src, a)))
        }
        if take_left {
          Array::set(buf, k, Array::get(src, a))
          a = a + 1
        } else {
          Array::set(buf, k, Array::get(src, b))
          b = b + 1
        }
        k = k + 1
      }
      lo = hi
    }
    let tmp = src
    src = buf
    buf = tmp
    width = width + width
  }
  src
}

export fn apply_perm_strings(names: Array[String], perm: Array[Int]) -> Array[String] {
  let out = array_empty()
  let mut i = 0
  while i < Array::length(perm) {
    Array::push(out, Array::get(names, Array::get(perm, i)))
    i = i + 1
  }
  out
}

/// Convenience: names -> sorted copy (membership-only callers).
export fn sorted_names_of(names: Array[String]) -> Array[String] {
  apply_perm_strings(names, sort_perm_by_names(names))
}

/// Leftmost binary search over a SORTED name array. Returns the smallest slot
/// holding `name`, or -1 when absent.
export fn bsearch_leftmost(sorted: Array[String], name: String) -> Int {
  let mut lo = 0
  let mut hi = Array::length(sorted)
  while lo < hi {
    let mid = (lo + hi) / 2
    if str_lt(Array::get(sorted, mid), name) {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  if lo < Array::length(sorted) && Array::get(sorted, lo) == name {
    lo
  } else {
    -1
  }
}
