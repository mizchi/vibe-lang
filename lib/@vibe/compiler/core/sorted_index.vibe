//# Imports

// #1353: implementation lives in @vibe/core. This file is an SReExport
// shim so existing `import ../core` / `import ./sorted_index.vibe`
// spellings keep working. check_contract trusts the re-export at face
// value; lib/@vibe/core/index.vpkg pins the signatures.
export ../../../../lib/@vibe/core {
  apply_perm_strings, bsearch_leftmost, sort_perm_by_names, sorted_names_of, str_lt
}
