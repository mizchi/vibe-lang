// lib/@vibe/compiler/core — effect row items.
//
// #3417: how a stored effect row's text is read. `row_items` splits it into
// labels, `row_item_of_label` reads one label as a `RowItem`, and the
// provenance labels the checker records next to effects
// (`is_row_provenance_label`, `#einst:` instantiations) are told apart here.

import @vibe/core {
  array_empty
}

/// #3417: `text` split at the commas outside brackets and parentheses, each
/// item trimmed. An empty item is kept, so the argument text of `Id[]` is one
/// empty argument; `row_items` is the same split with empty items dropped.
export fn split_top_level_commas(_ text: String) -> Array[String] {
  top_level_comma_items(text = text, keep_empty = true)
}

/// #3417: a stored effect row's items, split at the commas that separate
/// items, trimmed, with empty items dropped. A kind such as
/// `Exception[(Int, Int) -> Int]` holds commas of its own, inside brackets,
/// and stays one item.
export fn row_items(_ row: String) -> Array[String] {
  top_level_comma_items(text = row, keep_empty = false)
}

fn top_level_comma_items(text: String, keep_empty: Bool) -> Array[String] {
  let out = array_empty()
  let n = String::length(text)
  let mut depth = 0
  let mut start = 0
  let mut i = 0
  while i < n {
    let c = String::char_code_at(text, at = i)
    if c == 40 || c == 91 {
      depth = depth + 1
    } else if c == 41 || c == 93 {
      depth = depth - 1
    } else if c == 44 && depth == 0 {
      push_comma_item(out = out, item = String::trim(String::substring(text, start = start, end = i)), keep_empty = keep_empty)
      start = i + 1
    } else {
      ()
    }
    i = i + 1
  }
  push_comma_item(out = out, item = String::trim(String::substring(text, start = start, end = n)), keep_empty = keep_empty)
  out
}

fn push_comma_item(out: Array[String], item: String, keep_empty: Bool) -> Unit {
  if keep_empty || String::length(item) > 0 {
    Array::push(out, value = item)
  } else {
    ()
  }
}

/// #3341: a label recording the instantiation a lambda's performs of a
/// generic effect were checked against, `#einst:<effect>:<variable id>`
/// (`checker_row_effect_inst.vibe`). Like the capture and parameter
/// provenance labels it is not an effect: row comparison, display and
/// publication skip it.
export fn is_effect_inst_label(_ label: String) -> Bool {
  String::starts_with(label, prefix = "#einst:")
}

/// #3417: is this trimmed row label provenance the checker records in a row,
/// rather than an effect? That is a region skolem (`#region_<n>`), a capture,
/// a parameter, an aliased parameter or a field parameter
/// (`#capture[..]`, `#param[..]`, `#aliasparam[..]`, `#fieldparam[..]`), or
/// an instantiation (`#einst:`, `effect_inst_of_label`). Row comparison,
/// display, publication and the effect checks skip these labels.
export fn is_row_provenance_label(_ label: String) -> Bool {
  String::starts_with(label, prefix = "#region_") || String::starts_with(label, prefix = "#capture[") || String::starts_with(label, prefix = "#param[") || String::starts_with(label, prefix = "#aliasparam[") || String::starts_with(label, prefix = "#fieldparam[") || is_effect_inst_label(label)
}

/// #3417: the instantiation a function value's performs of a generic effect
/// were checked against (#3341): the effect's name and the type variable
/// that holds its payload. A stored row still carries it as an `#einst:`
/// label. `effect_inst_label_text` is the only writer of that spelling and
/// `effect_inst_of_label` the only reader, so a route reads this value and
/// never the label text.
export struct EffectInst {
  name: String
  var_id: Int
}

/// #3417: the row label that stores `inst`, `#einst:<effect>:<variable id>`.
export fn effect_inst_label_text(_ inst: EffectInst) -> String {
  String::concat("#einst:", String::concat(inst.name, String::concat(":", __to_string(inst.var_id))))
}

/// #3417: the instantiation a trimmed row label stores. `None` for any other
/// label, and for an `#einst:` label without a name or a decimal variable id.
/// The id follows the LAST `:`, so a qualified effect name keeps its own.
export fn effect_inst_of_label(_ label: String) -> Option[EffectInst] {
  if is_effect_inst_label(label) {
    let rest = String::substring(label, start = 7, end = String::length(label))
    let n = String::length(rest)
    let mut cut = 0 - 1
    let mut i = 0
    while i < n {
      if String::byte_at(rest, at = i) == 58 {
        cut = i
      } else {
        ()
      }
      i = i + 1
    }
    if cut > 0 && cut + 1 < n {
      let mut id = 0
      let mut digits = true
      let mut p = cut + 1
      while p < n {
        let ch = String::byte_at(rest, at = p)
        if ch >= 48 && ch <= 57 {
          id = id * 10 + (ch - 48)
        } else {
          digits = false
        }
        p = p + 1
      }
      if digits {
        Some(EffectInst::{
          name: String::substring(rest, start = 0, end = cut),
          var_id: id
        })
      } else {
        None
      }
    } else {
      None
    }
  } else {
    None
  }
}

/// #3417: may `row` store an instantiation? A cheap test ahead of splitting
/// the row into labels; it also answers `true` for the spelling nested in a
/// kind, which `effect_inst_of_label` on a top-level item then rejects.
export fn row_may_have_effect_inst(_ row: String) -> Bool {
  String::contains(row, needle = "#einst:")
}

/// #3417: one item of a stored effect row, read once from its label.
///
/// - `RowEffect(name, args)`: an effect. `State[Int]` is `("State", ["Int"])`;
///   each argument is trimmed and its spaces removed. A label that is not
///   `Name[..]` with the whole tail bracketed (`IO`, `Fs::read_file`,
///   `State[Int]::Get`) is its own name with no arguments.
/// - `RowInst(inst)`: an instantiation the checker recorded (`#einst:`).
/// - `RowProvenance(label)`: any other provenance label, verbatim.
export enum RowItem {
  RowEffect(String, Array[String]);
  RowInst(EffectInst);
  RowProvenance(String)
}

/// #3417: the item a trimmed row label stores.
export fn row_item_of_label(_ label: String) -> RowItem {
  match effect_inst_of_label(label) {
    Some(inst) => RowInst(inst),
    None => if is_row_provenance_label(label) {
      RowProvenance(label)
    } else {
      let open_at = String::index_of(label, needle = "[")
      if open_at > 0 && bracket_closes_at_end(text = label, open_at = open_at) {
        let args: Array[String] = []
        for arg in split_top_level_commas(String::substring(label, start = open_at + 1, end = String::length(label) - 1)) {
          Array::push(args, value = String::join(String::split(arg, sep = " "), sep = ""))
        }
        RowEffect(String::substring(label, start = 0, end = open_at), args)
      } else {
        RowEffect(label, [])
      }
    }
  }
}

/// #3417: a stored row's items, in order (`row_items`, then
/// `row_item_of_label`).
export fn parse_row_items(_ row: Option[String]) -> Array[RowItem] {
  let out: Array[RowItem] = []
  match row {
    Some(text) => for label in row_items(text) {
      Array::push(out, value = row_item_of_label(label))
    },
    None => ()
  }
  out
}

/// Does the `[` at `open_at` close at the last byte of `text`, and not before?
fn bracket_closes_at_end(text: String, open_at: Int) -> Bool {
  let n = String::length(text)
  let mut depth = 0
  let mut close = 0 - 1
  let mut i = open_at
  while i < n && close < 0 {
    let c = String::byte_at(text, at = i)
    if c == 91 {
      depth = depth + 1
    } else if c == 93 {
      depth = depth - 1
      if depth == 0 {
        close = i
      } else {
        ()
      }
    } else {
      ()
    }
    i = i + 1
  }
  close == n - 1
}
