// lib/@vibe/compiler/core/canonical_key_defs.vibe -- the type declarations
// `canonical_trait_key` resolves a trait key's arguments against (#3947,
// #3953), built from a module's statements and the definitions it imports.

import ./alias_expansion_count.vibe {
  alias_expansion_node_limit, type_expr_expansion_node_count
}

import ./ast.vibe {
  Stmt, TypeExpr
}

import ./types_env_cache.vibe {
  Type, TypeDef
}

import ./types_types_equal.vibe {
  resolve_type_expr_core_shadowed
}

import @vibe/ast {
  type_param_name
}

//# Functions

/// #3947: the type declarations of `stmts` as `canonical_trait_key` resolves
/// against them. A struct, enum or suberror is entered by name and parameters
/// (the resolver keeps a declared name as written, so a program's own
/// `struct StringMap[T]` is that type, not the builtin map); an alias by its
/// resolved body, one round per alias when an alias names another.
export fn canonical_key_defs(_ stmts: Array[Stmt]) -> Array[TypeDef] {
  canonical_key_defs_with(stmts = stmts, imported = [])
}

/// `canonical_key_defs` with the definitions a module imports as well
/// (#3953). A type the module declares itself -- an alias, a struct, an enum,
/// a suberror -- wins over an import of the same name, as when the checker
/// seeds imported type definitions (`seed_imported_type_defs`); the imports
/// are entered after the module's own nominal types and before its aliases'
/// rounds, so a local alias over an imported type resolves through it.
///
/// Resolving an alias copies its expansion, and a few lines of aliases can
/// expand to tens of millions of nodes (Codex on #3995). So each resolution is
/// preflighted with the checker's own count (`type_expr_expansion_node_count`,
/// the one `refresh_completed_alias_defs` runs) before it allocates, against
/// the same limit. An alias the count puts over the limit is capped: it is not
/// resolved again, an alias that names it counts as over the limit too, and
/// none of them is returned. A key through a capped alias stays as written,
/// and the checker's preflight refuses the source with the edit; an alias the
/// checker accepts is expanded alike on an impl's key and on a bound's.
export fn canonical_key_defs_with(stmts: Array[Stmt], imported: Array[TypeDef]) -> Array[TypeDef] {
  let nominal: Array[TypeDef] = []
  let aliases: Array[(String, Array[String], TypeExpr)] = []
  for stmt in stmts {
    match stmt {
      SStruct(_, name, _, _, _, tparams) => Array::push(nominal, value = TDStruct(name, [
      ], [], tparams)),
      SEnum(_, name, params, _, _) => Array::push(nominal, value = TDEnum(name, params, [
      ])),
      SSuberror(_, name, _) => Array::push(nominal, value = TDEnum(name, [], [])),
      STypeAlias(_, name, params, target) => Array::push(aliases, value = (name, params, target)),
      _ => ()
    }
  }
  let limit = alias_expansion_node_limit()
  let alias_names: Array[String] = []
  for row in aliases {
    let (name, _, _) = row
    Array::push(alias_names, value = name)
  }
  let local_names: Array[String] = []
  for name in alias_names {
    Array::push(local_names, value = name)
  }
  for d in nominal {
    Array::push(local_names, value = canonical_key_def_name(d))
  }
  for d in imported {
    let name = canonical_key_def_name(d)
    if !canonical_key_names_contain(names = local_names, name = name) && !canonical_key_imported_oversized(def = d, limit = limit) {
      Array::push(nominal, value = d)
    } else {
      ()
    }
  }
  let mut chained = false
  for row in aliases {
    let (_, _, target) = row
    if !chained && canonical_key_arg_names(ty = target, binders = alias_names) {
      chained = true
    } else {
      ()
    }
  }
  let rounds = if chained {
    Array::length(aliases)
  } else if Array::length(aliases) > 0 {
    1
  } else {
    0
  }
  // The aliases sit after the nominal definitions, at fixed positions, so
  // `capped` can name them by index as the count expects. Before its first
  // round an alias stands for itself, as a name the resolver keeps.
  let defs: Array[TypeDef] = []
  for d in nominal {
    Array::push(defs, value = d)
  }
  let base = Array::length(defs)
  for row in aliases {
    let (name, params, _) = row
    Array::push(defs, value = TDAlias(name, params, CtNamed(name, [])))
  }
  let capped: Array[Int] = []
  let mut r = 0
  while r < rounds {
    let mut ai = 0
    while ai < Array::length(aliases) {
      let at = base + ai
      if !canonical_key_ints_contain(items = capped, wanted = at) {
        let (name, params, target) = Array::get(aliases, at = ai)
        if type_expr_expansion_node_count(te = target, defs = defs, shadow = params, capped_aliases = capped, limit = limit) > limit {
          Array::push(capped, value = at)
        } else {
          Array::set(defs, at = at, value = TDAlias(name, params, resolve_type_expr_core_shadowed(te = target, defs = defs, shadow = params)))
        }
      } else {
        ()
      }
      ai = ai + 1
    }
    r = r + 1
  }
  let out: Array[TypeDef] = []
  let mut i = 0
  while i < Array::length(defs) {
    if !canonical_key_ints_contain(items = capped, wanted = i) {
      Array::push(out, value = Array::get(defs, at = i))
    } else {
      ()
    }
    i = i + 1
  }
  out
}

/// An imported alias whose resolved body is over the limit is left out like a
/// local one: a key through it would copy that body. The body is counted with
/// each parameter as one node, by the same count.
fn canonical_key_imported_oversized(def: TypeDef, limit: Int) -> Bool {
  match def {
    TDAlias(name, params, _) => {
      let te = if Array::length(params) == 0 {
        TyName(name)
      } else {
        TyApp(name, for p in params {
          TyName(type_param_name(p))
        })
      }
      type_expr_expansion_node_count(te = te, defs = [def], shadow = [], capped_aliases = [
      ], limit = limit) > limit
    },
    _ => false
  }
}

fn canonical_key_ints_contain(items: Array[Int], wanted: Int) -> Bool {
  let mut found = false
  for item in items {
    if !found && item == wanted {
      found = true
    } else {
      ()
    }
  }
  found
}

fn canonical_key_def_name(_ def: TypeDef) -> String {
  match def {
    TDEnum(name, _, _) => name,
    TDStruct(name, _, _, _) => name,
    TDAlias(name, _, _) => name,
    TDEffect(name, _, _, _, _) => name,
    TDEffectSet(name, _) => name
  }
}

fn canonical_key_names_contain(names: Array[String], name: String) -> Bool {
  let mut found = false
  for candidate in names {
    if !found && candidate == name {
      found = true
    } else {
      ()
    }
  }
  found
}

fn canonical_key_arg_names(ty: TypeExpr, binders: Array[String]) -> Bool {
  match ty {
    TyName(n) => {
      let mut found = false
      for b in binders {
        if !found && type_param_name(b) == n {
          found = true
        } else {
          ()
        }
      }
      found
    },
    TyApp(n, args) => canonical_key_arg_names(ty = TyName(n), binders = binders) || canonical_key_args_name(tys = args, binders = binders),
    TyTuple(items) => canonical_key_args_name(tys = items, binders = binders),
    TyFn(params, ret, _) => canonical_key_arg_names(ty = ret, binders = binders) || canonical_key_args_name(tys = params, binders = binders),
    TyUnit => false
  }
}

fn canonical_key_args_name(tys: Array[TypeExpr], binders: Array[String]) -> Bool {
  let mut found = false
  for t in tys {
    if !found && canonical_key_arg_names(ty = t, binders = binders) {
      found = true
    } else {
      ()
    }
  }
  found
}
