//# Core Exception alias predicates (#1279)
//
// `Exception` is the source-level alias of the legacy `Error` effect during
// the #1279 bridge. Both names deliberately lower to the same abortive Wasm
// exception tag. Keep every spelling check here so the later ADR-0085 typed
// `Exception[E]` migration has one replacement boundary.

/// True for either spelling of the interim abortive exception effect.
export fn is_exception_effect_name(name: String) -> Bool {
  name == "Error" || name == "Exception"
}

/// Canonical checker/codegen row label for either alias spelling.
export fn canonical_exception_effect_name(name: String) -> String {
  if is_exception_effect_name(name) {
    "Error"
  } else {
    name
  }
}

/// True for any qualified operation of the interim exception alias.
export fn is_exception_operation_name(name: String) -> Bool {
  let split = String::index_of(name, "::")
  split > 0 && is_exception_effect_name(String::substring(name, 0, split))
}

/// True for an operation name that lowers to the shared abortive exception tag.
export fn is_exception_throw_operation(name: String) -> Bool {
  name == "Error::Throw" || name == "Exception::Throw"
}

/// True for the constructor name used by an abortive exception handler arm.
/// `Throw` remains accepted for the pre-existing AST-level codegen callers.
export fn is_exception_throw_handler_name(name: String) -> Bool {
  name == "Throw" || is_exception_throw_operation(name)
}

/// Alias-aware equality for effect-row labels and qualified Throw operations.
export fn exception_effect_labels_equal(left: String, right: String) -> Bool {
  left == right || (is_exception_effect_name(left) && is_exception_effect_name(right)) || (is_exception_throw_operation(left) && is_exception_throw_operation(right))
}
