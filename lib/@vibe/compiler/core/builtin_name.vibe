//# Functions

export fn canonical_builtin_name(name: String) -> String {
  match name {
    "Fs::ReadFile" => "Fs::read_file",
    "Fs::WriteFile" => "Fs::write_file",
    "Fs::ReadBytes" => "Fs::read_bytes",
    "Fs::WriteBytes" => "Fs::write_bytes",
    "Fs::Exists" => "Fs::exists",
    "Fs::StatToken" => "Fs::stat_token",
    "Fs::ReadDir" => "Fs::readdir",
    "Fs::IsDir" => "Fs::is_dir",
    "Fs::IsFile" => "Fs::is_file",
    "Fs::Mkdir" => "Fs::mkdir",
    "Fs::MkdirP" => "Fs::mkdir_p",
    "Fs::Getcwd" => "Fs::getcwd",
    "Fs::Chdir" => "Fs::chdir",
    "Fs::Remove" => "Fs::remove",
    "Fs::Copy" => "Fs::copy",
    "Fs::Append" => "Fs::append",
    "Fs::Rename" => "Fs::rename",
    "Env::Get" => "Env::get",
    "Env::ArgsLen" => "Env::args_len",
    "Env::ArgsGet" => "Env::args_get",
    "Profiler::NowUs" => "Profiler::now_us",
    "Profiler::HeapBytes" => "Profiler::heap_bytes",
    // ADR-0098 Phase 1: expose names that state the runtime's byte semantics
    // honestly while retaining the legacy spellings for source compatibility.
    "String::byte_at" => "String::char_code_at",
    "String::from_byte" => "String::from_char_code",
    // ADR-0101 (3) / #1262: the Builder family's terminal verb is `build`, so
    // the type name and the verb correspond lexically (`StringBuilder::build()
    // -> String`). `freeze` is reserved for the verb that produces a Frozen-
    // (persistent + Send) value, which is NOT what this returns -- the worst
    // case of the old spelling was `ArrayBuilder::freeze -> Array`, where the
    // result of "freeze" is mutable. The legacy spelling keeps working and is
    // marked deprecated in the builtin deprecation table (core/builtin_deprecated.vibe).
    "StringBuilder::build" => "StringBuilder::freeze",
    _ => name
  }
}
