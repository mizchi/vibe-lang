//# Imports

import ./builtin_registry.vibe {
  registry_builtin_pure_arity
}

//# Functions

export fn canonical_builtin_name(name: String) -> String {
  // #2386: every legacy spelling below starts with `F`, `E`, `P` or `S`, so
  // any other first byte (a bare user name, `Array::`, `MutMap::`, ...) is
  // its own canonical spelling without the 25 compares of the ladder.
  let first = if String::length(name) == 0 {
    0
  } else {
    String::char_code_at(name, 0)
  }
  if first != 'F' && first != 'E' && first != 'P' && first != 'S' {
    name
  } else {
    canonical_builtin_name_ladder(name)
  }
}

fn canonical_builtin_name_ladder(name: String) -> String {
  match name {
    "Fs::ReadFile" => "Fs::read_file",
    "Fs::WriteFile" => "Fs::write_file",
    "Fs::ReadBytes" => "Fs::read_bytes",
    "Fs::WriteBytes" => "Fs::write_bytes",
    "Fs::Exists" => "Fs::exists",
    "Fs::StatToken" => "Fs::stat_token",
    "Fs::ReadDir" => "Fs::readdir",
    "Fs::IsDir" => "Fs::is_dir",
    "Fs::IsFile" => "Fs::is_file",
    "Fs::Mkdir" => "Fs::mkdir",
    "Fs::MkdirP" => "Fs::mkdir_p",
    "Fs::Getcwd" => "Fs::getcwd",
    "Fs::Chdir" => "Fs::chdir",
    "Fs::Remove" => "Fs::remove",
    "Fs::RemoveFile" => "Fs::remove_file",
    "Fs::RemoveTree" => "Fs::remove_tree",
    "Fs::Copy" => "Fs::copy",
    "Fs::Append" => "Fs::append",
    "Fs::Rename" => "Fs::rename",
    "Env::Get" => "Env::get",
    "Env::ArgsLen" => "Env::args_len",
    "Env::ArgsGet" => "Env::args_get",
    "Profiler::NowUs" => "Profiler::now_us",
    "Profiler::HeapBytes" => "Profiler::heap_bytes",
    // ADR-0098 Phase 1: expose names that state the runtime's byte semantics
    // honestly while retaining the legacy spellings for source compatibility.
    "String::byte_at" => "String::char_code_at",
    "String::from_byte" => "String::from_char_code",
    // ADR-0101 (3) / #1262: the Builder family's terminal verb is `build`, so
    // the type name and the verb correspond lexically (`StringBuilder::build()
    // -> String`). `freeze` is reserved for the verb that produces a Frozen-
    // (persistent + Send) value, which is NOT what this returns -- the worst
    // case of the old spelling was `ArrayBuilder::freeze -> Array`, where the
    // result of "freeze" is mutable. The legacy spelling keeps working and is
    // marked deprecated below. `StringBuilder::freeze` stays OFF that
    // list until a bootstrap bump: compiler source must keep `freeze`
    // while the seed does not know `build`.
    "StringBuilder::build" => "StringBuilder::freeze",
    _ => name
  }
}

/// #1733 / #2433 / #2442: the arity at which a builtin may be materialized as
/// a VALUE -- bound to a name and called later rather than only called
/// directly -- or -1 when it has no value form.
///
/// A builtin's function index lives BELOW `func_offset`, while a first-class
/// function value is an index into the indirect call table, which holds user
/// functions and lambdas only. `table_slot = fidx - func_offset` is therefore
/// negative for every builtin, and builtin bodies carry no closure-env
/// parameter, so the closure signature would not match even if a slot existed.
/// Measured on stage2 before #2433: `let f = eq` emitted a module the runtime
/// refused (`invalid signature index`), and `let h = String::concat` compiled
/// and then trapped with `table index is out of bounds`.
///
/// The value form is therefore not the builtin itself but an ETA-EXPANSION:
/// both codegen lanes emit `(a, b) -> name(a, b)`, an ordinary lambda with an
/// ordinary table slot and an ordinary closure env, whose body is the same
/// direct call a source call site would have written. #1733 built that for the
/// two FrozenArray conversions and hardcoded arity 1; this is the same
/// lowering with the arity read from the registry, so the answer is a PROPERTY
/// of the name rather than a two-element list a reader has to memorize.
///
/// `registry_builtin_pure_arity` is the single source of truth: the checker
/// grants the value form only when it agrees with the arity of the type the
/// checker itself inferred, and both lanes emit exactly that many parameters.
/// Two copies of the decision would drift into either a spurious error or the
/// load-time failure #2433 removed.
///
/// An EFFECTFUL builtin is refused by `registry_builtin_pure_arity` -- see
/// that function.
///
/// #2442: a BARE (unqualified) builtin name used to be refused here too, and
/// that one was a compiler limitation rather than a language decision.
/// `count_lambda_sites_expr` (codegen/common_analysis) predicts, for the whole
/// program, exactly how many lambda table slots the codegen walk will allocate,
/// and the walk THROWS when the two disagree. It was a purely syntactic walk
/// with no scope, so it could only decide the value form from the name, while
/// codegen decides it after the locals, constants, constructors and the func
/// table have failed. Those two agree for a name nothing else can bind, and
/// disagree for one that can: an ordinary `let eq = (a, b) -> ...` made the
/// planner reserve a slot for a use codegen resolved to the local, and a
/// program that compiled would have failed with `lambda plan over-count`.
///
/// Both sides were fixed rather than the name being admitted on its own. The
/// planner threads a bound set for locals and takes the whole-program names
/// that shadow (user functions, module-level int constants, constructors), and
/// the value-form arm moved BELOW the constants and the constructors in both
/// backends, which is the order the checker already resolves in
/// (`builtin_ident_is_value` is asked only on the `None =>` arm of the env
/// lookup). `lib/@vibe/compiler/tests/builtin_ident_value_test.vibe` measures
/// the count on both readings.
/// #2451: there is no name list left here. #1733's `FrozenArray::from_array` /
/// `FrozenArray::to_array` used to be carved out by name, because their rows
/// were polymorphic (`Array[?] -> FrozenArray[?]`) and the unknown test below
/// refused every polymorphic row -- but they had shipped with a value form
/// since #1733, so refusing them would have taken away a spelling users had.
/// The carve-out was honest about the cost: with the row saying nothing about
/// the relationship between the argument's element and the result's, the
/// UNANNOTATED `let freeze = FrozenArray::from_array` then
/// `let fz: FrozenArray[String] = freeze([1, 2])` checked CLEAN and read the
/// Ints as Strings.
///
/// Those rows now say it (`reg_var`, core/builtin_registry.vibe), so they
/// mention no unknown and reach the same property every other row does. The
/// annotated spelling still compiles; the unannotated one is now rejected.
export fn builtin_value_form_arity(name: String) -> Int {
  // #2386: canonicalization maps qualified spellings to qualified spellings,
  // so a bare name passes through it unchanged.
  registry_builtin_pure_arity(canonical_builtin_name(name))
}

//# Builtin deprecation table (ADR-0098 / ADR-0101).
//#
//# `#deprecated` is a source declaration marker. Builtins have no declaration
//# site in user code, so old *spellings* that `canonical_builtin_name` still
//# accepts would never warn. Lives in this file (not a sibling) so the
//# compiler does not pay another module's selfcompile heap for a lookup table.

export fn builtin_deprecated_message(name: String) -> Option[String] {
  // #1962 chose option 1: public host helpers lower to the same operation
  // algebra as `perform`, so the CamelCase name IS the operation's spelling --
  // `Fs::ReadFile` is the algebraic operation and `Fs::read_file` is the
  // capability builtin, the two tracks AGENTS.md keeps apart ("effect 名と代数
  // effect の operation は CamelCase ... capability builtin ... は本当に関数
  // なので Effect::snake_case。この二トラックは揺れではなく用途の違い").
  //
  // Twenty-four rows here said the opposite, telling a reader to move OFF the
  // operation spelling. Measured, that advice was wrong in both positions it
  // could fire:
  //
  //   perform Fs::ReadFile(p)      -- warns, and the snake form names the
  //                                   builtin, not the operation
  //   handler arm Fs::ReadFile(p)  -- warns, and the edit it names does not
  //                                   compile: `handler-set arms must name a
  //                                   fully qualified operation`
  //
  // so `lib/@vibe/fs/fs.vibe` -- the file that DEFINES the interceptable
  // wrapper -- and `fs_test.vibe` -- the five tests proving interception works
  // -- warned on every one of their own correct spellings. AGENTS.md requires
  // a diagnostic to lead with the edit that fixes it; this one led away from
  // the spelling the model settled on.
  //
  // `canonical_builtin_name` still maps the two together, which is what makes
  // an un-intercepted operation lower to the direct call. That mapping is the
  // implementation detail; it is not advice, and it was never the thing that
  // needed saying to a reader.
  //
  // The rows that remain are ordinary renames with no operation/builtin split
  // behind them.
  match name {
    "String::char_code_at" => Some("use String::byte_at"),
    "String::from_char_code" => Some("use String::from_byte"),
    "Char::to_int" => Some("Char is an Int alias; drop the conversion"),
    "Char::from_int" => Some("Char is an Int alias; drop the conversion"),
    "Map::has" => Some("use Map::has_key"),
    "map_has" => Some("use Map::has_key"),
    _ => None
  }
}

export fn append_builtin_deprecated(out: Array[(String, String)]) -> Unit {
  let names = [
    "String::char_code_at",
    "String::from_char_code",
    "Char::to_int",
    "Char::from_int",
    "Map::has",
    "map_has"
  ]
  let mut i = 0
  while i < Array::length(names) {
    let n = Array::get(names, i)
    match builtin_deprecated_message(n) {
      Some(msg) => Array::push(out, (n, msg)),
      None => ()
    }
    i = i + 1
  }
}
