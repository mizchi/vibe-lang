//# Functions

export fn canonical_builtin_name(name: String) -> String {
  match name {
    "Fs::ReadFile" => "Fs::read_file",
    "Fs::WriteFile" => "Fs::write_file",
    "Fs::ReadBytes" => "Fs::read_bytes",
    "Fs::WriteBytes" => "Fs::write_bytes",
    "Fs::Exists" => "Fs::exists",
    "Fs::StatToken" => "Fs::stat_token",
    "Fs::ReadDir" => "Fs::readdir",
    "Fs::IsDir" => "Fs::is_dir",
    "Fs::IsFile" => "Fs::is_file",
    "Fs::Mkdir" => "Fs::mkdir",
    "Fs::MkdirP" => "Fs::mkdir_p",
    "Fs::Getcwd" => "Fs::getcwd",
    "Fs::Chdir" => "Fs::chdir",
    "Fs::Remove" => "Fs::remove",
    "Fs::Copy" => "Fs::copy",
    "Fs::Append" => "Fs::append",
    "Fs::Rename" => "Fs::rename",
    "Env::Get" => "Env::get",
    "Env::ArgsLen" => "Env::args_len",
    "Env::ArgsGet" => "Env::args_get",
    "Profiler::NowUs" => "Profiler::now_us",
    "Profiler::HeapBytes" => "Profiler::heap_bytes",
    // ADR-0098 Phase 1: expose names that state the runtime's byte semantics
    // honestly while retaining the legacy spellings for source compatibility.
    "String::byte_at" => "String::char_code_at",
    "String::from_byte" => "String::from_char_code",
    // ADR-0101 (3) / #1262: the Builder family's terminal verb is `build`, so
    // the type name and the verb correspond lexically (`StringBuilder::build()
    // -> String`). `freeze` is reserved for the verb that produces a Frozen-
    // (persistent + Send) value, which is NOT what this returns -- the worst
    // case of the old spelling was `ArrayBuilder::freeze -> Array`, where the
    // result of "freeze" is mutable. The legacy spelling keeps working and is
    // marked deprecated below. `StringBuilder::freeze` stays OFF that
    // list until a bootstrap bump: compiler source must keep `freeze`
    // while the seed does not know `build`.
    "StringBuilder::build" => "StringBuilder::freeze",
    _ => name
  }
}

/// #1733 / #2433: the builtins that have a VALUE form, i.e. that may be bound
/// to a name and called later rather than only called directly.
///
/// The set is small and it is not a matter of taste: a builtin's function index
/// lives BELOW `func_offset`, while a first-class function value is an index
/// into the indirect call table, which holds user functions and lambdas only.
/// `table_slot = fidx - func_offset` is therefore negative for every builtin,
/// and builtin bodies carry no closure-env parameter, so the closure signature
/// would not match even if a slot existed. Measured on stage2: `let f = eq`
/// emitted a module the runtime refused (`invalid signature index`), and
/// `let h = String::concat` compiled and then trapped with `table index is out
/// of bounds`.
///
/// The two names below are exempt because #1733 gave them a real value form:
/// `compile_expr` / `backend_expr` materialize them as a one-argument LAMBDA
/// (`frozen_array_conversion_closure`), which is an ordinary closure with an
/// ordinary table slot. `fixtures/frozen_array_copies_test.vibe` calls both
/// through a binding and passes.
///
/// This is the single source of truth for that set: the checker rejects a
/// builtin ident in value position unless this says yes, and both codegen
/// lanes ask it which names to eta-expand. Adding a name here without the
/// matching lowering would move a load-time failure into a runtime trap, so
/// the two must be decided in one place.
export fn builtin_ident_has_value_form(name: String) -> Bool {
  let n = canonical_builtin_name(name)
  n == "FrozenArray::from_array" || n == "FrozenArray::to_array"
}

//# Builtin deprecation table (ADR-0098 / ADR-0101).
//#
//# `#deprecated` is a source declaration marker. Builtins have no declaration
//# site in user code, so old *spellings* that `canonical_builtin_name` still
//# accepts would never warn. Lives in this file (not a sibling) so the
//# compiler does not pay another module's selfcompile heap for a lookup table.

export fn builtin_deprecated_message(name: String) -> Option[String] {
  match name {
    "String::char_code_at" => Some("use String::byte_at"),
    "String::from_char_code" => Some("use String::from_byte"),
    "Char::to_int" => Some("Char is an Int alias; drop the conversion"),
    "Char::from_int" => Some("Char is an Int alias; drop the conversion"),
    "Fs::ReadFile" => Some("use Fs::read_file"),
    "Fs::WriteFile" => Some("use Fs::write_file"),
    "Fs::ReadBytes" => Some("use Fs::read_bytes"),
    "Fs::WriteBytes" => Some("use Fs::write_bytes"),
    "Fs::Exists" => Some("use Fs::exists"),
    "Fs::StatToken" => Some("use Fs::stat_token"),
    "Fs::ReadDir" => Some("use Fs::readdir"),
    "Fs::IsDir" => Some("use Fs::is_dir"),
    "Fs::IsFile" => Some("use Fs::is_file"),
    "Fs::Mkdir" => Some("use Fs::mkdir"),
    "Fs::MkdirP" => Some("use Fs::mkdir_p"),
    "Fs::Getcwd" => Some("use Fs::getcwd"),
    "Fs::Chdir" => Some("use Fs::chdir"),
    "Fs::Remove" => Some("use Fs::remove"),
    "Fs::Copy" => Some("use Fs::copy"),
    "Fs::Append" => Some("use Fs::append"),
    "Fs::Rename" => Some("use Fs::rename"),
    "Env::Get" => Some("use Env::get"),
    "Env::ArgsLen" => Some("use Env::args_len"),
    "Env::ArgsGet" => Some("use Env::args_get"),
    "Profiler::NowUs" => Some("use Profiler::now_us"),
    "Profiler::HeapBytes" => Some("use Profiler::heap_bytes"),
    "Map::has" => Some("use Map::has_key"),
    "map_has" => Some("use Map::has_key"),
    _ => None
  }
}

export fn append_builtin_deprecated(out: Array[(String, String)]) -> Unit {
  let names = [
    "String::char_code_at",
    "String::from_char_code",
    "Char::to_int",
    "Char::from_int",
    "Fs::ReadFile",
    "Fs::WriteFile",
    "Fs::ReadBytes",
    "Fs::WriteBytes",
    "Fs::Exists",
    "Fs::StatToken",
    "Fs::ReadDir",
    "Fs::IsDir",
    "Fs::IsFile",
    "Fs::Mkdir",
    "Fs::MkdirP",
    "Fs::Getcwd",
    "Fs::Chdir",
    "Fs::Remove",
    "Fs::Copy",
    "Fs::Append",
    "Fs::Rename",
    "Env::Get",
    "Env::ArgsLen",
    "Env::ArgsGet",
    "Profiler::NowUs",
    "Profiler::HeapBytes",
    "Map::has",
    "map_has"
  ]
  let mut i = 0
  while i < Array::length(names) {
    let n = Array::get(names, i)
    match builtin_deprecated_message(n) {
      Some(msg) => Array::push(out, (n, msg)),
      None => ()
    }
    i = i + 1
  }
}
