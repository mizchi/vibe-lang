//# Imports

// #753 (ADR-0065 Phase 3): the AST enums live in the @vibe/ast contract
// package; this module is a re-export shim so the compiler's existing
// `import ../core/ast.vibe` / `import ../core` spellings keep working.
// #897 (core/ vpkg migration): rewritten from the old bare
// `import ../../../../lib/@vibe/ast {...}` + separate `export {...}`
// two-step to the `export <path> { names }` SReExport form -- a bare
// import + export does NOT satisfy check_contract as an implementation for
// a declared contract name (only a real local `export fn`/`export type`
// body, or an SReExport, counts; see syntax/ast.vibe's identical fix for
// @vibe/parser's Token). core/index.vpkg's `type Expr`/`Pat`/`Stmt`/
// `TypeExpr` declarations are satisfied by this SReExport at face value
// (check_contract trusts re-exported names without a body/arity check —
// the source package's own contract, @vibe/ast/index.vpkg, is what
// actually pins their shape).
export ../../../../lib/@vibe/ast {
  Expr, ImportItem, ImportKind, Pat, Stmt, TypeExpr
}
