//# Imports

// #753 (ADR-0065 Phase 3): the AST enums live in the @vibe/ast contract
// package; this module is a re-export shim so the compiler's existing
// `import ../core/ast.vibe` / `import ../core` spellings keep working.
// (`export <path>` re-export requires a ./-prefixed path in the current
// seed's parser, so this is spelled import + bare export.)
import ../../../../lib/@vibe/ast {
  Expr, Pat, Stmt, TypeExpr
}

//# Misc

export {
  Pat, Expr, Stmt, TypeExpr
}
