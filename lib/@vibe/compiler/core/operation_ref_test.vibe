//# OperationRef classifier: the Lean oracle corpus, the builtin registry, and
//# entry admission (#3143, ADR-0084 step 1)
//
// The first test is a DIFFERENTIAL: it reads the corpus the Lean model
// generates (`formal/oracle/effect-taxonomy.tsv`, kept fresh by
// `formal-check`), runs each case's catalog and operations through this
// package's classifier, renders the outcome the way `TaxonomyOracle.lean`
// does, and compares it with the recorded verdict and result.

import ./operation_ref.vibe {
  EffectArgument, EffectClass, EffectRequirement, OperationRef, classify_operation, classify_row, effect_catalog_lookup_unique
}

import ./standard_effect_policy.vibe {
  is_entry_admitted_effect, standard_effect_catalog, standard_operation_ref
}

import ./builtin_registry.vibe {
  builtin_registry_typed
}

import ./types.vibe {
  Type
}

//# Oracle syntax (`TaxonomyOracle.lean`'s renderers)

/// Split `text` at the commas that are outside parentheses and brackets.
fn split_top_level(_ text: String) -> Array[String] {
  let out: Array[String] = []
  let n = String::length(text)
  let mut depth = 0
  let mut start = 0
  let mut i = 0
  while i < n {
    let c = String::byte_at(text, at = i)
    if c == 40 || c == 91 {
      depth = depth + 1
    } else if c == 41 || c == 93 {
      depth = depth - 1
    } else if c == 44 && depth == 0 {
      Array::push(out, value = String::substring(text, start = start, end = i))
      start = i + 1
    }
    i = i + 1
  }
  if n > start {
    Array::push(out, value = String::substring(text, start = start, end = n))
  }
  out
}

/// The items of a rendered list `[a,b,c]`.
fn list_items(_ text: String) -> Array[String] {
  split_top_level(String::substring(text, start = 1, end = String::length(text) - 1))
}

fn parse_class(_ text: String) -> EffectClass {
  if text == "algebraic" {
    AlgebraicClass
  } else if text == "core-exception" {
    CoreExceptionClass
  } else if String::starts_with(text, prefix = "capability(kind=") {
    CapabilityClass(String::substring(text, start = 16, end = String::length(text) - 1))
  } else {
    RuntimeClass
  }
}

fn parse_catalog(_ text: String) -> Array[(String, EffectClass)] {
  let out: Array[(String, EffectClass)] = []
  let items = list_items(text)
  let mut i = 0
  while i < Array::length(items) {
    let item = Array::get(items, at = i)
    let eq = String::index_of(item, needle = "=")
    let id = String::substring(item, start = 0, end = eq)
    let class_text = String::substring(item, start = eq + 1, end = String::length(item))
    Array::push(out, value = (id, parse_class(class_text)))
    i = i + 1
  }
  out
}

fn parse_argument(_ text: String) -> EffectArgument {
  let colon = String::index_of(text, needle = ":")
  let tag = String::substring(text, start = 0, end = colon)
  let value = String::substring(text, start = colon + 1, end = String::length(text))
  if tag == "resource" {
    ResourceArgument(value)
  } else if tag == "region" {
    RegionArgument(value)
  } else {
    TypeArgument(value)
  }
}

/// `pkg/module#def:op(arg,...)`.
fn parse_operation(_ text: String) -> OperationRef {
  let colon = String::index_of(text, needle = ":")
  let open_at = String::index_of(text, needle = "(")
  let argument_texts = split_top_level(String::substring(text, start = open_at + 1, end = String::length(text) - 1))
  let arguments: Array[EffectArgument] = []
  let mut i = 0
  while i < Array::length(argument_texts) {
    Array::push(arguments, value = parse_argument(Array::get(argument_texts, at = i)))
    i = i + 1
  }
  OperationRef::{
    effect_def: String::substring(text, start = 0, end = colon),
    operation: String::substring(text, start = colon + 1, end = open_at),
    arguments: arguments
  }
}

fn parse_operations(_ text: String) -> Array[OperationRef] {
  let out: Array[OperationRef] = []
  let items = list_items(text)
  let mut i = 0
  while i < Array::length(items) {
    Array::push(out, value = parse_operation(Array::get(items, at = i)))
    i = i + 1
  }
  out
}

fn render_argument(_ argument: EffectArgument) -> String {
  match argument {
    TypeArgument(v) => "type:\{v}",
    RegionArgument(v) => "region:\{v}",
    ResourceArgument(v) => "resource:\{v}"
  }
}

fn render_operation(_ operation: OperationRef) -> String {
  let parts: Array[String] = []
  let mut i = 0
  while i < Array::length(operation.arguments) {
    Array::push(parts, value = render_argument(Array::get(operation.arguments, at = i)))
    i = i + 1
  }
  let args = String::join(parts, sep = ",")
  "\{operation.effect_def}:\{operation.operation}(\{args})"
}

fn render_requirement(_ requirement: EffectRequirement) -> String {
  match requirement {
    CapabilityRequirement(operation, kind, resource) => {
      let op = render_operation(operation)
      "capability(\{op};kind=\{kind};resource=\{resource})"
    },
    AlgebraicRequirement(operation) => {
      let op = render_operation(operation)
      "algebraic(\{op})"
    },
    ExceptionRequirement(kind) => "exception(kind=\{kind})",
    RuntimeRequirement(operation) => {
      let op = render_operation(operation)
      "runtime(\{op})"
    }
  }
}

/// `(verdict, result)` as the oracle records them.
fn render_outcome(_ outcome: Option[Array[EffectRequirement]]) -> (String, String) {
  match outcome {
    Some(row) => {
      let parts: Array[String] = []
      let mut i = 0
      while i < Array::length(row) {
        Array::push(parts, value = render_requirement(Array::get(row, at = i)))
        i = i + 1
      }
      let rendered = String::join(parts, sep = ",")
      ("accept", "[\{rendered}]")
    },
    None => ("reject", "none")
  }
}

/// One line per oracle case: `name verdict` when the classifier agrees, and
/// `name MISMATCH expected=... actual=...` when it does not.
fn oracle_report(_ corpus: String) -> String {
  let lines = String::split(corpus, sep = "\n")
  let out: Array[String] = []
  let mut i = 2
  while i < Array::length(lines) {
    let line = Array::get(lines, at = i)
    if String::length(line) > 0 {
      let cols = String::split(line, sep = "\t")
      let name = Array::get(cols, at = 0)
      let verdict = Array::get(cols, at = 2)
      let result = Array::get(cols, at = 3)
      let outcome = classify_row(catalog = parse_catalog(Array::get(cols, at = 4)), operations = parse_operations(Array::get(cols, at = 5)))
      let (actual_verdict, actual_result) = render_outcome(outcome)
      if actual_verdict == verdict && actual_result == result {
        Array::push(out, value = "\{name} \{verdict}")
      } else {
        Array::push(out, value = "\{name} MISMATCH expected=\{verdict}:\{result} actual=\{actual_verdict}:\{actual_result}")
      }
    }
    i = i + 1
  }
  String::join(out, sep = "\n")
}

test "the classifier agrees with the Lean oracle corpus" {
  let corpus = Fs::read_file("formal/oracle/effect-taxonomy.tsv")
  assert(String::starts_with(corpus, prefix = "version\t1\nname\tissue\tverdict\tresult\tcatalog\toperations\n"))
  inspect(oracle_report(corpus), content = "capability-resource accept\ncapability-generic-resource accept\nalgebraic-resource-free accept\nalgebraic-generic-region accept\ncore-exception-typed accept\nmixed-row accept\nunknown-metadata reject\nduplicate-metadata reject\ncapability-missing-resource reject\ncapability-duplicate-resource reject\nalgebraic-forged-resource reject\nexception-missing-type reject\nexception-multiple-types reject\nexception-resource-argument reject\nrow-fails-atomically reject")
}

test "the oracle comparison reports a disagreement" {
  // Red side of the differential: a corpus row whose recorded result the
  // classifier does not produce must be reported, not pass.
  let forged = "version\t1\nname\tissue\tverdict\tresult\tcatalog\toperations\nforged\t#3143\taccept\t[algebraic(example/app/logger#0:0(resource:0))]\t[example/app/logger#0=algebraic]\t[example/app/logger#0:0(resource:0)]\n"
  inspect(oracle_report(forged), content = "forged MISMATCH expected=accept:[algebraic(example/app/logger#0:0(resource:0))] actual=reject:none")
}

test "a catalog entry recorded twice is not unique, even with one class" {
  // The oracle's duplicate-metadata case records two DIFFERENT classes, so a
  // lookup that keeps the first or the last match also rejects it. Two equal
  // entries are still two declarations of one effect.
  let fs = CapabilityClass("0")
  let catalog = [("vibe/std/fs#0", fs), ("vibe/std/fs#0", fs)]
  let read = OperationRef::{
    effect_def: "vibe/std/fs#0",
    operation: "0",
    arguments: [ResourceArgument("0")]
  }
  assert(effect_catalog_lookup_unique(catalog = catalog, effect_def = "vibe/std/fs#0") is None)
  assert(classify_operation(catalog = catalog, operation = read) is None)
  assert(classify_operation(catalog = [("vibe/std/fs#0", fs)], operation = read) is Some(_))
}

//# The standard catalog

fn standard_outcome(_ label: String) -> String {
  match standard_operation_ref(label) {
    Some(operation) => {
      let row = [operation]
      let (verdict, result) = render_outcome(classify_row(catalog = standard_effect_catalog(), operations = row))
      "\{verdict} \{result}"
    },
    None => "malformed"
  }
}

test "standard labels lower to OperationRefs with the implicit process root" {
  let labels = [
    "Fs",
    "Fs::read_file",
    "Fs[SrcTree]::read_file",
    "Console::write_stream",
    "Exception",
    "Error::Throw",
    "Exception[IoError]",
    "Exception[Map[K, V]]::Throw",
    "Async",
    "Async::Suspend",
    "Ask::Get",
    "State[Int]",
    "Fs[",
    "Fs[]"
  ]
  let rows: Array[String] = []
  let mut i = 0
  while i < Array::length(labels) {
    let label = Array::get(labels, at = i)
    let outcome = standard_outcome(label)
    Array::push(rows, value = "\{label} => \{outcome}")
    i = i + 1
  }
  inspect(String::join(rows, sep = "\n"), content = "Fs => accept [capability(Fs:(resource:Process::Root);kind=Process::Root;resource=Process::Root)]\nFs::read_file => accept [capability(Fs:read_file(resource:Process::Root);kind=Process::Root;resource=Process::Root)]\nFs[SrcTree]::read_file => accept [capability(Fs:read_file(resource:SrcTree);kind=Process::Root;resource=SrcTree)]\nConsole::write_stream => accept [capability(Console:write_stream(resource:Process::Root);kind=Process::Root;resource=Process::Root)]\nException => accept [exception(kind=)]\nError::Throw => accept [exception(kind=)]\nException[IoError] => accept [exception(kind=IoError)]\nException[Map[K, V]]::Throw => accept [exception(kind=Map[K, V])]\nAsync => accept [runtime(Async:())]\nAsync::Suspend => accept [runtime(Async:Suspend())]\nAsk::Get => reject none\nState[Int] => reject none\nFs[ => malformed\nFs[] => malformed")
}

test "every effectful registry builtin classifies under the standard catalog" {
  // ADR-0084 step 1: lowering a builtin's operation to its OperationRef gives
  // a host capability on the implicit process root, or the exception /
  // runtime effect -- never an algebraic or unclassified operation.
  let rows = builtin_registry_typed()
  let refused: Array[String] = []
  let mut capabilities = 0
  let mut others = 0
  let mut i = 0
  while i < Array::length(rows) {
    let (name, ty, _, _, _) = Array::get(rows, at = i)
    match ty {
      CtFn(_, _, Some(eff)) => {
        let sep = String::index_of(name, needle = "::")
        let op = if sep > 0 {
          String::substring(name, start = sep + 2, end = String::length(name))
        } else {
          name
        }
        let outcome = match standard_operation_ref("\{eff}::\{op}") {
          Some(operation) => classify_operation(catalog = standard_effect_catalog(), operation = operation),
          None => None
        }
        match outcome {
          Some(requirement) => match requirement {
            CapabilityRequirement(_, kind, resource) => if kind == "Process::Root" && resource == "Process::Root" {
              capabilities = capabilities + 1
            } else {
              Array::push(refused, value = "\{name}: \{kind} \{resource}")
            },
            AlgebraicRequirement(_) => Array::push(refused, value = "\{name}: algebraic"),
            _ => {
              others = others + 1
            }
          },
          None => Array::push(refused, value = "\{name}: unclassified")
        }
      },
      _ => ()
    }
    i = i + 1
  }
  assert(capabilities > 0)
  assert(others > 0)
  inspect(String::join(refused, sep = "\n"), content = "")
}

test "entry admission keys on the classified requirement" {
  assert(is_entry_admitted_effect("Fs"))
  assert(is_entry_admitted_effect("Fs[SrcTree]"))
  assert(is_entry_admitted_effect("Error"))
  assert(is_entry_admitted_effect("Exception[IoError]::Throw"))
  assert(is_entry_admitted_effect("Async::Suspend"))
  assert(!is_entry_admitted_effect("Ask"))
  assert(!is_entry_admitted_effect("State[Int]"))
  assert(!is_entry_admitted_effect("Fs["))
  assert(!is_entry_admitted_effect(""))
}
