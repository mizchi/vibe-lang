//# Imports

import ./ast.vibe {
  TypeExpr
}

import ./exception_effect.vibe {
  exception_label_kind, is_exception_label
}

import ./sorted_index.vibe {
  apply_perm_strings, bsearch_leftmost, sort_perm_by_names
}

import @vibe/core {
  array_empty
}

//# Types

export enum Type {
  CtInt;
  CtDouble;
  CtBool;
  CtString;
  CtChar;
  CtUnit;
  CtTuple(Array[Type]);
  CtArray(Type);
  CtOption(Type);
  CtFn(Array[Type], Type, Option[String]);
  CtEnum(String);
  CtStruct(String);
  CtBytes;
  CtNamed(String, Array[Type]);
  CtVar(Int);
  CtForAll(Array[Int], Array[(Int, Array[String])], Type);
  CtUnknown;
  // #1839: an explicit anonymous `record { ... }` literal. Structural, field
  // order = LITERAL order (which is also the runtime slot layout, tag 0), so
  // equality/unification are order-sensitive. Distinct from CtStruct so a
  // record can never silently flow into a nominal struct position — unify
  // rejects the pair, and the diagnostic prints the record's shape.
  CtRecord(Array[(String, Type)])
}

export enum TypeDef {
  TDEnum(String, Array[String], Array[(String, Array[Type])]);
  // #829: (name, fields, mut field names, declared type params). Type params
  // are APPENDED so positional matches of the older 3-field form stay aligned.
  TDStruct(String, Array[(String, Type)], Array[String], Array[String]);
  TDAlias(String, Array[String], Type);
  // #813: a declared effect's operation signatures — (op name, param types,
  // return type) — so perform arguments, handler arm names/arity/payloads,
  // and resume values can be validated. #1340 (ADR-0071): the declared type
  // params are APPENDED (same convention as TDStruct's #829 slot) so generic
  // effects register too — a type param resolves to a rigid `CtNamed(param,
  // [])` inside the op signatures, and use sites instantiate it per
  // perform/handle via subst_type_params + fresh inference vars.
  TDEffect(String, Array[(String, Array[Type], Type)], Array[String]);
  // Effectsets are declaration authority too: a selected import must carry
  // its exact member closure, rather than re-inferring permission from case.
  TDEffectSet(String, Array[String])
}

/// Checker-internal authority for where a value binding was resolved.
/// Persistent/public TypeEnv transport intentionally drops this payload.
export enum BindingOrigin {
  BindingOriginUnavailable;
  BindingOriginModuleExport(String, String)
}

export struct EnvValueBinding {
  ty: Type;
  origin: BindingOrigin
}

export fn env_value_binding(ty: Type) -> EnvValueBinding {
  EnvValueBinding::{
    ty: ty,
    origin: BindingOriginUnavailable
  }
}

export fn env_value_binding_with_origin(ty: Type, origin: BindingOrigin) -> EnvValueBinding {
  EnvValueBinding::{
    ty: ty,
    origin: origin
  }
}

export enum TypeEnv {
  EnvEmpty;
  EnvBind(String, EnvValueBinding, TypeEnv);
  // Header params are sixth and method generic provenance is appended seventh,
  // so every older positional slot, including rest, retains its meaning.
  // Both are retained checker provenance.
  EnvTraitDef(String, Array[String], Bool, Array[(String, Array[TypeExpr], TypeExpr)], TypeEnv, Array[String], Array[(String, Array[String], Array[(String, Array[String])])]);
  EnvTraitImpl(String, Type, TypeEnv);
  EnvTraitImplGen(String, Array[String], Array[(String, Array[String])], Type, TypeEnv);
  // Published typedef authority. Unlike the retired enum value carrier this
  // keeps enums, structs, and aliases in one lossless declaration channel.
  // `defs` is the declaration closure required to interpret exported
  // signatures; `selectable` is the public declaration surface. Keeping them
  // separate prevents a private dependency of an exported signature from
  // becoming importable by name.
  EnvTypeDefs(Array[TypeDef], Array[String], TypeEnv);
  // #1262 / ADR-0100 (1): the STRICT escape fact for a `let mut` binding.
  // `EnvBind` alone says "name : Type" and nothing about how the binding may
  // be written, so every check that needs "is this a mutable cell?" had to
  // re-derive it from the raw AST (the duplicate walks catalogued in
  // docs/side-effect-consolidation.md 4.5). This node is a MARKER laid over
  // the ordinary value binding -- `env_bind_mut` pushes it in FRONT of the
  // `EnvBind` it describes, so type lookup is unchanged and only the new
  // `env_mut_escape` query sees it. The Bool is the strict escape judgment
  // (checker/checker_escape.vibe): true = some closure captures this binding,
  // i.e. codegen lowers it to a shared heap ref cell and its writes are
  // observable outside the declaring scope; false = it stays a wasm local.
  // Function-local in normal module checking, and module export envs carry no
  // `let mut`. Exported TypeEnv composition and codec fixtures can still cache
  // this marker, so `env_mut_escape` treats cached indexes as transparent.
  EnvMutCell(String, Bool, TypeEnv);
  EnvFlat(Array[(String, EnvValueBinding)]);
  // Sorted names/types pair (see core/sorted_index.vibe), instead of a
  // Map[String, Type]: this compiler's `Map` is a flat assoc list, so
  // `Map::has_key` + `Map::get` were TWO O(entries) linear scans per lookup
  // -- exactly the "Map membership index is still linear" trap from #799.
  // Names are unique (built by env_cache below), so a stable sort + leftmost
  // bsearch gives the same result in O(log N) with no dedup step needed.
  EnvCached(Array[String], Array[EnvValueBinding], TypeEnv)
}

export enum Subst {
  SubstEmpty;
  SubstBind(Int, Type, Subst);
  SubstBound(Int, Array[String], Subst);
  SubstCached(Map[String, Type], Map[String, Array[String]], Subst);
  // #626 criterion 4: an effect-variable binding `var := effect-label-string`
  // ("" meaning the pure/empty row). Effect variables are no longer a wildcard
  // that is compatible with everything — `unify` records their binding here and
  // `subst_apply` resolves CtFn effects through it, so `e` actually unifies to
  // its first binding and a later conflicting use is a type error.
  SubstEffBind(String, String, Subst)
}

//# Functions

export fn env_bind(env: TypeEnv, name: String, ty: Type) -> TypeEnv {
  env_bind_with_origin(env, name, ty, BindingOriginUnavailable)
}

export fn env_bind_with_origin(env: TypeEnv, name: String, ty: Type, origin: BindingOrigin) -> TypeEnv {
  let binding = env_value_binding_with_origin(ty, origin)
  match env {
    // Keeping the cache at the head is only sound while the new binding's
    // name is NOT in the cached index: env_lookup consults the index first,
    // so a same-named binding tucked under it would be permanently shadowed
    // by the older cached entry (#1583 -- an import env is cached before a
    // function body is checked, and a parameter named like an import then
    // resolved to the import). Bind shadowing names IN FRONT of the cache.
    EnvCached(names_sorted, types_sorted, rest) => if bsearch_leftmost(names_sorted, name) >= 0 {
      EnvBind(name, binding, env)
    } else {
      EnvCached(names_sorted, types_sorted, EnvBind(name, binding, rest))
    },
    _ => EnvBind(name, binding, env)
  }
}

/// Bind `name : ty` AND record that it is a `let mut` cell whose strict
/// escape judgment is `escapes` (#1262). The marker goes in FRONT of the
/// ordinary binding, so `env_lookup` behaves exactly as it would for
/// `env_bind` and only `env_mut_escape` below can observe the difference.
export fn env_bind_mut(env: TypeEnv, name: String, ty: Type, escapes: Bool) -> TypeEnv {
  EnvMutCell(name, escapes, env_bind(env, name, ty))
}

/// The mutability fact for `name` at this point in the chain, or `None` when
/// the binding in scope is not a `let mut` cell.
///
/// Shadowing falls out of the authoritative chain order rather than needing
/// its own rule: the FIRST binding node that mentions `name` decides, so an
/// inner immutable `let name = ...` (`EnvBind`) answers `None` even while an
/// outer `EnvMutCell(name, ...)` is still further down. `EnvCached` is only an
/// acceleration index and is transparent to this query; its `rest` retains
/// the binding and marker order that decides the fact.
/// That is what makes this the STRICT side of ADR-0100 (1) -- the enforcement
/// lane, which must stay silent when unsure -- as opposed to codegen's
/// deliberately conservative `is_mut_captured_in`, which does not subtract
/// shadowing because over-boxing is only slow, never wrong.
export fn env_mut_escape(env: TypeEnv, name: String) -> Option[Bool] {
  let mut cur = env
  let mut result = None
  let mut done = false
  while !done {
    match cur {
      EnvEmpty => {
        done = true
      },
      EnvMutCell(n, escapes, rest) => if n == name {
        result = Some(escapes)
        done = true
      } else {
        cur = rest
      },
      EnvBind(n, _, rest) => if n == name {
        done = true
      } else {
        cur = rest
      },
      EnvTraitDef(_, _, _, _, rest, _, _) => {
        cur = rest
      },
      EnvTraitImpl(_, _, rest) => {
        cur = rest
      },
      EnvTraitImplGen(_, _, _, _, rest) => {
        cur = rest
      },
      EnvTypeDefs(_, _, rest) => {
        cur = rest
      },
      EnvFlat(_) => {
        done = true
      },
      EnvCached(_, _, rest) => {
        // Cached arrays accelerate value lookup but carry no mutability fact.
        // The authoritative chain in `rest` retains both binding shadow order
        // and any paired EnvMutCell marker.
        cur = rest
      }
    }
  }
  result
}

/// Collect declaration authority in the chain's lookup order. Declaration
/// nodes are semantic transport, not value bindings, so cached value indexes
/// never participate in this walk.
export fn env_type_defs(env: TypeEnv) -> Array[TypeDef] {
  let out = array_empty()
  let mut cur = env
  let mut done = false
  while !done {
    match cur {
      EnvEmpty => {
        done = true
      },
      EnvBind(_, _, rest) => {
        cur = rest
      },
      EnvTraitDef(_, _, _, _, rest, _, _) => {
        cur = rest
      },
      EnvTraitImpl(_, _, rest) => {
        cur = rest
      },
      EnvMutCell(_, _, rest) => {
        cur = rest
      },
      EnvTraitImplGen(_, _, _, _, rest) => {
        cur = rest
      },
      EnvTypeDefs(defs, _, rest) => {
        let mut i = 0
        while i < Array::length(defs) {
          Array::push(out, Array::get(defs, i))
          i = i + 1
        }
        cur = rest
      },
      EnvFlat(_) => {
        done = true
      },
      EnvCached(_, _, rest) => {
        cur = rest
      }
    }
  }
  out
}

/// Names explicitly published for selected import. The declaration closure
/// itself can include private names needed only to interpret a public type.
export fn env_selectable_type_defs(env: TypeEnv) -> Array[String] {
  let out = array_empty()
  let mut cur = env
  let mut done = false
  while !done {
    match cur {
      EnvEmpty => {
        done = true
      },
      EnvBind(_, _, rest) => {
        cur = rest
      },
      EnvTraitDef(_, _, _, _, rest, _, _) => {
        cur = rest
      },
      EnvTraitImpl(_, _, rest) => {
        cur = rest
      },
      EnvMutCell(_, _, rest) => {
        cur = rest
      },
      EnvTraitImplGen(_, _, _, _, rest) => {
        cur = rest
      },
      EnvTypeDefs(_, selectable, rest) => {
        let mut i = 0
        while i < Array::length(selectable) {
          Array::push(out, Array::get(selectable, i))
          i = i + 1
        }
        cur = rest
      },
      EnvFlat(_) => {
        done = true
      },
      EnvCached(_, _, rest) => {
        cur = rest
      }
    }
  }
  out
}

export fn env_cache(env: TypeEnv) -> TypeEnv {
  let is_empty = match env {
    EnvEmpty => true,
    _ => false
  }
  if is_empty {
    EnvEmpty
  } else {
    let names = ArrayBuilder::new()
    let types = ArrayBuilder::new()
    let mut cur = env
    let mut done = false
    while !done {
      match cur {
        EnvEmpty => {
          done = true
        },
        EnvBind(n, binding, rest) => {
          ArrayBuilder::push(names, n)
          ArrayBuilder::push(types, binding)
          cur = rest
        },
        EnvTraitDef(_, _, _, _, rest, _, _) => {
          cur = rest
        },
        EnvTraitImpl(_, _, rest) => {
          cur = rest
        },
        EnvMutCell(_, _, rest) => {
          cur = rest
        },
        EnvTraitImplGen(_, _, _, _, rest) => {
          cur = rest
        },
        EnvTypeDefs(_, _, rest) => {
          cur = rest
        },
        EnvFlat(bindings) => {
          let mut j = 0
          while j < Array::length(bindings) {
            let (n, binding) = Array::get(bindings, j)
            ArrayBuilder::push(names, n)
            ArrayBuilder::push(types, binding)
            j = j + 1
          }
          done = true
        },
        EnvCached(_, _, rest) => {
          cur = rest
        }
      }
    }
    let na = ArrayBuilder::freeze(names)
    let ta = ArrayBuilder::freeze(types)
    // `na`/`ta` are collected innermost-binding-first (the traversal above
    // walks `cur = rest` outward from the head). A STABLE sort keeps that
    // relative order among same-named entries, and bsearch_leftmost returns
    // the leftmost (= innermost = correctly-shadowing) one -- so no reverse
    // pass or dedup step is needed to match the old Map's "last set wins"
    // (which was fed outermost-first specifically to get this same result).
    let perm = sort_perm_by_names(na)
    let names_sorted = apply_perm_strings(na, perm)
    let types_sorted = array_empty()
    let mut i = 0
    while i < Array::length(perm) {
      Array::push(types_sorted, Array::get(ta, Array::get(perm, i)))
      i = i + 1
    }
    EnvCached(names_sorted, types_sorted, env)
  }
}

export fn fresh_var(c: Int) -> (Type, Int) {
  (CtVar(c), c + 1)
}

export fn occurs_in(id: Int, ty: Type) -> Bool {
  match ty {
    CtVar(vid) => (id == vid),
    CtFn(params, ret, _) => {
      let mut i = 0
      let mut found = false
      while i < Array::length(params) {
        if occurs_in(id, Array::get(params, i)) {
          found = true
          i = Array::length(params)
        } else {
          i = i + 1
        }
      }
      found || occurs_in(id, ret)
    },
    CtArray(elem) => occurs_in(id, elem),
    CtOption(elem) => occurs_in(id, elem),
    CtRecord(rfields) => {
      let mut ri = 0
      let mut rfound = false
      while ri < Array::length(rfields) {
        let (_, rft) = Array::get(rfields, ri)
        if occurs_in(id, rft) {
          rfound = true
          ri = Array::length(rfields)
        } else {
          ri = ri + 1
        }
      }
      rfound
    },
    CtTuple(elems) => {
      let mut i = 0
      let mut found = false
      while i < Array::length(elems) {
        if occurs_in(id, Array::get(elems, i)) {
          found = true
          i = Array::length(elems)
        } else {
          i = i + 1
        }
      }
      found
    },
    CtForAll(_, _, body) => occurs_in(id, body),
    _ => false
  }
}

export fn env_lookup(env: TypeEnv, name: String) -> Option[Type] {
  match env_lookup_binding(env, name) {
    Some(binding) => Some(binding.ty),
    None => None
  }
}

export fn env_lookup_binding(env: TypeEnv, name: String) -> Option[EnvValueBinding] {
  let mut cur = env
  let mut result = None
  let mut done = false
  while !done {
    match cur {
      EnvEmpty => {
        done = true
      },
      EnvBind(n, binding, rest) => if n == name {
        result = Some(binding)
        done = true
      } else {
        cur = rest
      },
      EnvTraitDef(_, _, _, _, rest, _, _) => {
        cur = rest
      },
      EnvTraitImpl(_, _, rest) => {
        cur = rest
      },
      EnvMutCell(_, _, rest) => {
        cur = rest
      },
      EnvTraitImplGen(_, _, _, _, rest) => {
        cur = rest
      },
      EnvTypeDefs(_, _, rest) => {
        cur = rest
      },
      EnvFlat(bindings) => {
        let mut j = 0
        while j < Array::length(bindings) && !done {
          let (n, binding) = Array::get(bindings, j)
          if n == name {
            result = Some(binding)
            done = true
          } else {
            j = j + 1
          }
        }
        if !done {
          done = true
        }
      },
      EnvCached(names_sorted, types_sorted, rest) => {
        let slot = bsearch_leftmost(names_sorted, name)
        if slot >= 0 {
          result = Some(Array::get(types_sorted, slot))
          done = true
        } else {
          cur = rest
        }
      }
    }
  }
  result
}

export fn env_bind_all(env: TypeEnv, bindings: Array[(String, Type)]) -> TypeEnv {
  let len = Array::length(bindings)
  let mut i = 0
  let mut acc = env
  while i < len {
    let (name, ty) = Array::get(bindings, i)
    acc = env_bind(acc, name, ty)
    i = i + 1
  }
  acc
}

/// #1502: `find_typedef` for callers that want the `TDEnum` a name ultimately
/// denotes, following `TDAlias` hops. A qualified constructor reference
/// (`C::Red`, `H::Crimson`) resolves its qualifier through here so an alias
/// works as a qualifier exactly like the name it aliases; matching `TDEnum`
/// directly off `find_typedef` is what made `type C = Color` then `C::Red`
/// report `unknown name`.
///
/// A PARAMETERIZED alias resolves to the underlying enum's own `TDEnum`, so the
/// constructor scheme comes out in the ALIASED enum's formals. For a plain
/// renaming (`type C[T] = Shape[T]`) that is exactly right. For a partial
/// application (`type IntShape = Shape[Int]`) it is loose: `IntShape::Wrap`
/// types as `forall T. (T) -> Shape[T]`, so the alias does not pin `T` the way
/// the spelling suggests. That is no worse than writing `Shape::Wrap` directly
/// (both accept `Shape[String]`) and it is not unsound -- the use site still
/// unifies -- so this slice leaves it. Pinning it needs the alias's own
/// argument list substituted into the payloads, which is a different change.
///
/// `fuel` bounds a cyclic alias chain (`type A = B` / `type B = A`). Such a
/// program is rejected elsewhere; here we only need to not spin.
export fn find_enum_typedef(defs: Array[TypeDef], name: String) -> Option[TypeDef] {
  let mut cur = name
  let mut fuel = 16
  let mut result = None
  let mut done = false
  while !done {
    if fuel <= 0 {
      done = true
    } else {
      fuel = fuel - 1
      match find_typedef(defs, cur) {
        Some(TDEnum(en, eparams, evariants)) => {
          result = Some(TDEnum(en, eparams, evariants))
          done = true
        },
        // Only a named target can name an enum; anything else (a tuple, a
        // function type, a builtin) ends the walk with no enum.
        Some(TDAlias(_, _, target)) => match target {
          CtEnum(n) => {
            cur = n
          },
          CtNamed(n, _) => {
            cur = n
          },
          _ => {
            done = true
          }
        },
        _ => {
          done = true
        }
      }
    }
  }
  result
}

export fn find_typedef(defs: Array[TypeDef], name: String) -> Option[TypeDef] {
  let len = Array::length(defs)
  let mut i = 0
  let mut result = None
  let mut done = false
  while !done {
    if i >= len {
      done = true
    } else {
      let d = Array::get(defs, i)
      let dname = match d {
        TDEnum(n, _, _) => n,
        TDStruct(n, _, _, _) => n,
        TDAlias(n, _, _) => n,
        TDEffect(n, _, _) => n,
        TDEffectSet(n, _) => n
      }
      if dname == name {
        result = Some(d)
        done = true
      } else {
        i = i + 1
      }
    }
  }
  result
}

export fn subst_lookup(s: Subst, id: Int) -> Option[Type] {
  let mut cur = s
  let mut out = None
  let mut done = false
  let key = __to_string(id)
  while !done {
    match cur {
      SubstEmpty => {
        done = true
      },
      SubstBind(i, ty, rest) => if i == id {
        out = Some(ty)
        done = true
      } else {
        cur = rest
      }
      ,
      SubstBound(_, _, rest) => {
        cur = rest
      },
      SubstCached(cache, _, rest) => if Map::has_key(cache, key) {
        out = Some(Map::get(cache, key))
        done = true
      } else {
        cur = rest
      }
      ,
      SubstEffBind(_, _, rest) => {
        cur = rest
      }
    }
  }
  out
}

export fn trait_supers(env: TypeEnv, name: String) -> Array[String] {
  let empty = array_empty()
  match env {
    EnvEmpty => empty,
    EnvBind(_, _, rest) => trait_supers(rest, name),
    EnvTraitDef(tname, supers, _, _, rest, _, _) => if tname == name {
      supers
    } else trait_supers(rest, name),
    EnvTraitImpl(_, _, rest) => trait_supers(rest, name),
    EnvMutCell(_, _, rest) => trait_supers(rest, name),
    EnvTraitImplGen(_, _, _, _, rest) => trait_supers(rest, name),
    EnvTypeDefs(_, _, rest) => trait_supers(rest, name),
    EnvFlat(_) => empty,
    EnvCached(_, _, rest) => trait_supers(rest, name)
  }
}

/// The type formals in scope for one trait method's declared signature: the
/// trait header's own params (`trait Iter[T]`) followed by that method's own
/// generics (`map[U](Self, (T) -> U)`). Anything in this list is a binder, not
/// a lookup into the surrounding type definitions.
fn trait_method_binder_names(tparams: Array[String], method_gens: Array[(String, Array[String], Array[(String, Array[String])])], method_name: String) -> Array[String] {
  let out = ArrayBuilder::new()
  let mut i = 0
  while i < Array::length(tparams) {
    ArrayBuilder::push(out, Array::get(tparams, i))
    i = i + 1
  }
  let mut j = 0
  while j < Array::length(method_gens) {
    let (mname, gparams, _) = Array::get(method_gens, j)
    if mname == method_name {
      let mut k = 0
      while k < Array::length(gparams) {
        ArrayBuilder::push(out, Array::get(gparams, k))
        k = k + 1
      }
    } else {
      ()
    }
    j = j + 1
  }
  ArrayBuilder::freeze(out)
}

/// Look up a trait method's declared signature (param TypeExprs + return
/// TypeExpr) by trait name + method name, together with the type formals that
/// signature binds (`trait_method_binder_names`). `Self` appears verbatim as
/// `TyName("Self")` in the stored signature; the caller substitutes it.
///
/// The binders are NOT decoration: a caller that resolves the signature
/// against the module's type definitions must let them shadow it, or an
/// import alias with the same name captures the formal (#1512). This is the
/// single env walk — `trait_method_sig` is a projection of it, so the two can
/// never disagree about which trait a method came from.
export fn trait_method_sig_binders(env: TypeEnv, trait_name: String, method_name: String) -> Option[(Array[TypeExpr], TypeExpr, Array[String])] {
  match env {
    EnvEmpty => None,
    EnvBind(_, _, rest) => trait_method_sig_binders(rest, trait_name, method_name),
    EnvTraitDef(tname, _, _, methods, rest, tparams, method_gens) => if tname == trait_name {
      let mlen = Array::length(methods)
      let mut i = 0
      let mut found = None
      while i < mlen {
        let (mname, params, ret) = Array::get(methods, i)
        if mname == method_name {
          found = Some((params, ret))
          i = mlen
        } else {
          i = i + 1
        }
      }
      match found {
        Some(sig) => {
          let (params, ret) = sig
          Some((params, ret, trait_method_binder_names(tparams, method_gens, method_name)))
        },
        None => trait_method_sig_binders(rest, trait_name, method_name)
      }
    } else trait_method_sig_binders(rest, trait_name, method_name),
    EnvTraitImpl(_, _, rest) => trait_method_sig_binders(rest, trait_name, method_name),
    EnvMutCell(_, _, rest) => trait_method_sig_binders(rest, trait_name, method_name),
    EnvTraitImplGen(_, _, _, _, rest) => trait_method_sig_binders(rest, trait_name, method_name),
    EnvTypeDefs(_, _, rest) => trait_method_sig_binders(rest, trait_name, method_name),
    EnvFlat(_) => None,
    EnvCached(_, _, rest) => trait_method_sig_binders(rest, trait_name, method_name)
  }
}

/// Look up a trait method's declared signature (param TypeExprs + return
/// TypeExpr) by trait name + method name. `Self` appears verbatim as
/// `TyName("Self")` in the stored signature; the caller substitutes it.
export fn trait_method_sig(env: TypeEnv, trait_name: String, method_name: String) -> Option[(Array[TypeExpr], TypeExpr)] {
  match trait_method_sig_binders(env, trait_name, method_name) {
    Some(found) => {
      let (params, ret, _) = found
      Some((params, ret))
    },
    None => None
  }
}

/// The declared name at the head of a (possibly generic) named type, for
/// matching against a trait impl's target. Impl targets are stored with their
/// type arguments erased to `CtUnknown` (see the `SImpl` handler), so element
/// types must be matched by head name, not by `types_equal`.
fn trait_target_head_name(ty: Type) -> String {
  match ty {
    CtNamed(n, _) => n,
    CtStruct(n) => n,
    CtEnum(n) => n,
    _ => ""
  }
}

fn type_name_iterator_impl_scan(scan: TypeEnv, full: TypeEnv, type_name: String) -> Bool {
  match scan {
    EnvEmpty => false,
    EnvBind(_, _, rest) => type_name_iterator_impl_scan(rest, full, type_name),
    EnvMutCell(_, _, rest) => type_name_iterator_impl_scan(rest, full, type_name),
    EnvTraitDef(_, _, _, _, rest, _, _) => type_name_iterator_impl_scan(rest, full, type_name),
    EnvTraitImpl(tname, target, rest) => {
      let hit = trait_target_head_name(target) == type_name && (match trait_method_sig(full, tname, "next") {
        Some(_) => true,
        None => false
      })
      if hit {
        true
      } else type_name_iterator_impl_scan(rest, full, type_name)
    },
    EnvTraitImplGen(_, _, _, _, rest) => type_name_iterator_impl_scan(rest, full, type_name),
    EnvTypeDefs(_, _, rest) => type_name_iterator_impl_scan(rest, full, type_name),
    EnvFlat(_) => false,
    EnvCached(_, _, rest) => type_name_iterator_impl_scan(rest, full, type_name)
  }
}

/// True iff a type named `type_name` has an `impl Tr for type_name` where the
/// trait `Tr` declares a `next` method — i.e. the type is iterator-shaped
/// (`Iterator[T] { next(Self) -> Option[(T, Self)] }`). The checker's `for x in
/// it` element-type inference uses this to recognise struct-trait iterators
/// (`LazyIter`, async streams, …) and bind the loop variable to the iterator's
/// element type instead of `CtUnknown`.
export fn type_name_has_iterator_impl(env: TypeEnv, type_name: String) -> Bool {
  type_name_iterator_impl_scan(env, env, type_name)
}

/// #1358: is this trait's `next` the ASYNC one (`-> Future[..]`) rather than the
/// sync `-> Option[..]`? That return head is the single bit the dict-passing
/// desugar switches on when it decides to wrap each loop step in `await(..)`
/// (`fn_return_is_future` in desugar_trait_dict.vibe), so the checker reads the
/// same bit from the trait declaration to decide whether the loop needs `Async`.
fn trait_next_returns_future(env: TypeEnv, trait_name: String) -> Bool {
  match trait_method_sig(env, trait_name, "next") {
    Some(sig) => {
      let (_, ret) = sig
      match ret {
        TyApp(n, _) => n == "Future",
        TyName(n) => n == "Future",
        _ => false
      }
    },
    None => false
  }
}

fn type_name_async_iterator_impl_scan(scan: TypeEnv, full: TypeEnv, type_name: String) -> Bool {
  match scan {
    EnvEmpty => false,
    EnvBind(_, _, rest) => type_name_async_iterator_impl_scan(rest, full, type_name),
    EnvMutCell(_, _, rest) => type_name_async_iterator_impl_scan(rest, full, type_name),
    EnvTraitDef(_, _, _, _, rest, _, _) => type_name_async_iterator_impl_scan(rest, full, type_name),
    EnvTraitImpl(tname, target, rest) => {
      let hit = trait_target_head_name(target) == type_name && trait_next_returns_future(full, tname)
      if hit {
        true
      } else type_name_async_iterator_impl_scan(rest, full, type_name)
    },
    // #1347/#1358 (Codex P1 on PR #1364): a GENERIC impl (`impl [T] AIter for
    // Iter[T]`) is recorded as EnvTraitImplGen, and skipping it here let the
    // async loop through unchecked -- the desugar has no such distinction (it
    // sees the lowered `Iter::next` and injects `await` on a Future return),
    // so a generically-implemented async iterator suspended from a row-free
    // function with no diagnostic. Verified against a repro that RAN the await
    // loop (a sync EForIn over the struct would have trapped). Impl targets
    // store their type arguments erased, so head-name matching is exact here
    // just as it is in the non-generic arm.
    //
    // The SYNC sibling scan above deliberately keeps skipping this case: it
    // feeds element-type inference, where widening the match would change
    // inferred types across the codebase rather than close a soundness hole.
    EnvTraitImplGen(tname, _, _, target, rest) => {
      let hit = trait_target_head_name(target) == type_name && trait_next_returns_future(full, tname)
      if hit {
        true
      } else type_name_async_iterator_impl_scan(rest, full, type_name)
    },
    EnvTypeDefs(_, _, rest) => type_name_async_iterator_impl_scan(rest, full, type_name),
    EnvFlat(_) => false,
    EnvCached(_, _, rest) => type_name_async_iterator_impl_scan(rest, full, type_name)
  }
}

/// #1358: the ASYNC half of type_name_has_iterator_impl — true iff `type_name`
/// implements an iterator trait whose `next` yields a `Future`, i.e. driving it
/// with `for x in it` awaits every step. The `await(..)` is injected AFTER the
/// checker (desugar_trait_dicts), so the effect pass cannot see an async
/// primitive in the program text and has to recognise the loop by its iterand's
/// type instead — see check_async_effects_expr's EForIn arm.
export fn type_name_has_async_iterator_impl(env: TypeEnv, type_name: String) -> Bool {
  type_name_async_iterator_impl_scan(env, env, type_name)
}

/// Like `trait_method_sig_binders` but follows supertraits transitively. The
/// binders come from whichever trait actually declared the method, so an
/// inherited method carries the SUPERtrait's formals, not the subtrait's.
export fn trait_method_sig_binders_deep(env: TypeEnv, trait_name: String, method_name: String) -> Option[(Array[TypeExpr], TypeExpr, Array[String])] {
  match trait_method_sig_binders(env, trait_name, method_name) {
    Some(sig) => Some(sig),
    None => {
      let supers = trait_supers(env, trait_name)
      let mut i = 0
      let mut result = None
      while i < Array::length(supers) {
        let pending = match result {
          None => true,
          _ => false
        }
        if pending {
          match trait_method_sig_binders_deep(env, Array::get(supers, i), method_name) {
            Some(sig) => {
              result = Some(sig)
            },
            None => ()
          }
        } else {
          ()
        }
        i = i + 1
      }
      result
    }
  }
}

/// Like `trait_method_sig` but follows supertraits transitively, so a method
/// inherited from a supertrait (`trait B: A` calling an `A` method on `[T: B]`)
/// resolves. Trait hierarchies are acyclic, so the recursion terminates.
export fn trait_method_sig_deep(env: TypeEnv, trait_name: String, method_name: String) -> Option[(Array[TypeExpr], TypeExpr)] {
  match trait_method_sig_binders_deep(env, trait_name, method_name) {
    Some(found) => {
      let (params, ret, _) = found
      Some((params, ret))
    },
    None => None
  }
}

/// Collect the trait bounds recorded for a specific type variable id in the
/// current substitution (`subst_add_bound` entries). Used to resolve a
/// `T::method` call where `T` is a bounded generic parameter.
export fn subst_bounds_for(s: Subst, id: Int) -> Array[String] {
  let out = ArrayBuilder::new()
  let mut cur = s
  let mut done = false
  while !done {
    match cur {
      SubstEmpty => {
        done = true
      },
      SubstBind(_, _, rest) => {
        cur = rest
      },
      SubstBound(bid, bounds, rest) => {
        if bid == id {
          let mut i = 0
          while i < Array::length(bounds) {
            ArrayBuilder::push(out, Array::get(bounds, i))
            i = i + 1
          }
        } else {
          ()
        }
        cur = rest
      },
      SubstCached(_, bounds_cache, rest) => {
        let key = __to_string(id)
        if Map::has_key(bounds_cache, key) {
          let bounds = Map::get(bounds_cache, key)
          let mut i = 0
          while i < Array::length(bounds) {
            ArrayBuilder::push(out, Array::get(bounds, i))
            i = i + 1
          }
        } else {
          ()
        }
        cur = rest
      },
      SubstEffBind(_, _, rest) => {
        cur = rest
      }
    }
  }
  ArrayBuilder::freeze(out)
}

fn array_has_int(arr: Array[Int], val: Int, i: Int) -> Bool {
  if i >= Array::length(arr) {
    false
  }
  else if Array::get(arr, i) == val {
    true
  }
  else array_has_int(arr, val, i + 1)
}

fn int_array_has(arr: Array[Int], v: Int) -> Bool {
  let slen = Array::length(arr)
  let mut si = 0
  let mut sfound = false
  let mut sdone = false
  while !sdone {
    if si >= slen {
      sdone = true
    } else if Array::get(arr, si) == v {
      sfound = true
      sdone = true
    } else {
      si = si + 1
    }
  }
  sfound
}

fn is_effect_var_name(name: String) -> Bool {
  let len = String::length(name)
  if len == 1 {
    // a source-level effect variable: a single lowercase letter (`with e`)
    String::char_code_at(name, 0) >= 97 && String::char_code_at(name, 0) <= 122
  } else if len >= 2 {
    // a FRESH effect variable minted by `instantiate` (`$N`): no real effect
    // name starts with `$`, so this marker is unambiguous.
    String::char_code_at(name, 0) == 36
  } else {
    false
  }
}

/// Resolve an effect variable name through the effect-binding chain (transitively
/// following var->var links). Returns the bound effect-label string ("" = pure)
/// or None if the variable is unbound.
fn subst_eff_lookup(s: Subst, name: String) -> Option[String] {
  let mut cur = s
  let mut out = None
  let mut done = false
  while !done {
    match cur {
      SubstEmpty => {
        done = true
      },
      SubstBind(_, _, rest) => {
        cur = rest
      },
      SubstBound(_, _, rest) => {
        cur = rest
      },
      SubstCached(_, _, rest) => {
        cur = rest
      },
      SubstEffBind(v, val, rest) => if v == name {
        out = Some(val)
        done = true
      } else {
        cur = rest
      }
    }
  }
  match out {
    Some(val) => if is_effect_var_name(val) {
      match subst_eff_lookup(s, val) {
        Some(v2) => Some(v2),
        None => Some(val)
      }
    } else {
      Some(val)
    },
    None => None
  }
}

/// Resolve a CtFn effect annotation through the effect-binding chain: a bound
/// effect variable becomes its binding (an empty binding "" collapses to the
/// pure row `None`); anything else is returned unchanged.
fn resolve_effect_opt(s: Subst, eff: Option[String]) -> Option[String] {
  match eff {
    None => None,
    Some(row) => {
      let labels = String::split(row, ",")
      let resolved = array_empty()
      let mut i = 0
      while i < Array::length(labels) {
        let label = String::trim(Array::get(labels, i))
        if is_effect_var_name(label) {
          match subst_eff_lookup(s, label) {
            Some(bound) => if String::length(bound) > 0 {
              for part in String::split(bound, ",") {
                let trimmed = String::trim(part)
                if String::length(trimmed) > 0 {
                  Array::push(resolved, trimmed)
                }
              }
              ()
            },
            None => Array::push(resolved, label)
          }
        } else if String::starts_with(label, "#capture[") {
          let close = String::index_of(label, "]")
          let mut id = 0
          let mut p = 9
          while p < close {
            id = id * 10 + (String::char_code_at(label, p) - 48)
            p = p + 1
          }
          match subst_lookup(s, id) {
            Some(bound_ty) => {
              let resolved_ty = subst_apply(s, bound_ty)
              let region_names = array_empty()
              collect_region_skolems_in_type(resolved_ty, region_names)
              if Array::length(region_names) > 0 {
                for region_name in region_names {
                  if !string_array_contains(resolved, region_name) {
                    Array::push(resolved, region_name)
                  }
                }
              } else match resolved_ty {
                  CtVar(new_id) => Array::push(resolved, String::concat("#capture[", String::concat(__to_string(new_id), "]"))),
                  _ => ()
              }
            },
            None => Array::push(resolved, label)
          }
        } else if String::length(label) > 0 {
          Array::push(resolved, label)
        }
        i = i + 1
      }
      if Array::length(resolved) == 0 {
        None
      } else {
        Some(String::join(resolved, ", "))
      }
    }
  }
}

/// Region provenance is carried in a function's checked row as an internal
/// unforgeable label. It is not a runtime effect: the row is simply the one
/// structured slot already preserved by substitution, generalization and
/// containers. `#capture[n]` is dependent on inference variable n and becomes
/// the concrete `#region_n` label when that variable is unified with a
/// region-tagged type.
fn string_array_contains(items: Array[String], wanted: String) -> Bool {
  let mut found = false
  for item in items {
    if item == wanted {
      found = true
    }
  }
  found
}

fn collect_region_skolems_in_type(ty: Type, out: Array[String]) -> Unit {
  match ty {
    CtNamed(name, args) => if String::starts_with(name, "#region_") {
      if !string_array_contains(out, name) {
        Array::push(out, name)
      }
    } else {
      for arg in args {
        collect_region_skolems_in_type(arg, out)
      }
    },
    CtFn(params, ret, eff) => {
      match eff {
        Some(row) => {
          for raw in String::split(row, ",") {
            let label = String::trim(raw)
            if String::starts_with(label, "#region_") && !string_array_contains(out, label) {
              Array::push(out, label)
            }
          }
        },
        None => ()
      }
      for param in params {
        collect_region_skolems_in_type(param, out)
      }
      collect_region_skolems_in_type(ret, out)
    },
    CtArray(elem) => collect_region_skolems_in_type(elem, out),
    CtOption(elem) => collect_region_skolems_in_type(elem, out),
    CtTuple(items) => {
      for item in items {
        collect_region_skolems_in_type(item, out)
      }
    },
    CtRecord(fields) => {
      for field in fields {
        let (_, field_ty) = field
        collect_region_skolems_in_type(field_ty, out)
      }
    },
    CtForAll(_, _, body) => collect_region_skolems_in_type(body, out),
    _ => ()
  }
}

export fn subst_apply(s: Subst, ty: Type) -> Type {
  match ty {
    CtInt => ty,
    CtBool => ty,
    CtString => ty,
    CtUnit => ty,
    CtDouble => ty,
    CtChar => ty,
    CtBytes => ty,
    CtUnknown => ty,
    CtVar(_) => {
      let mut cur = ty
      let mut out = ty
      let mut done = false
      let mut seen = array_empty()
      while !done {
        match cur {
          CtVar(vid) => if int_array_has(seen, vid) {
            out = cur
            done = true
          } else {
            Array::push(seen, vid)
            match subst_lookup(s, vid) {
              Some(next) => {
                cur = next
                out = next
              },
              None => {
                out = cur
                done = true
              }
            }
          },
          _ => {
            out = subst_apply(s, cur)
            done = true
          }
        }
      }
      out
    },
    CtFn(params, ret, effect_name) => {
      let apply_params: (Array[Type]) -> Array[Type] = (items) -> {
        let out = array_empty()
        let mut i = 0
        while i < Array::length(items) {
          Array::push(out, subst_apply(s, Array::get(items, i)))
          i = i + 1
        }
        out
      }
      CtFn(apply_params(params), subst_apply(s, ret), resolve_effect_opt(s, effect_name))
    },
    CtArray(elem) => CtArray(subst_apply(s, elem)),
    CtOption(elem) => CtOption(subst_apply(s, elem)),
    CtTuple(elems) => CtTuple(for e in elems {
      subst_apply(s, e)
    }),
    CtRecord(rfields) => CtRecord(for rf in rfields {
      let (rfn, rft) = rf
      (rfn, subst_apply(s, rft))
    }),
    CtNamed(name, args) => CtNamed(name, for arg in args {
      subst_apply(s, arg)
    }),
    CtForAll(_, _, _) => ty,
    _ => ty
  }
}

export fn trait_defined(env: TypeEnv, name: String) -> Bool {
  match env {
    EnvEmpty => false,
    EnvBind(_, _, rest) => trait_defined(rest, name),
    EnvTraitDef(tname, _, _, _, rest, _, _) => if tname == name {
      true
    } else trait_defined(rest, name),
    EnvTraitImpl(_, _, rest) => trait_defined(rest, name),
    EnvMutCell(_, _, rest) => trait_defined(rest, name),
    EnvTraitImplGen(_, _, _, _, rest) => trait_defined(rest, name),
    EnvTypeDefs(_, _, rest) => trait_defined(rest, name),
    EnvFlat(_) => false,
    EnvCached(_, _, rest) => trait_defined(rest, name)
  }
}

/// #1429: render a stored effect row in the SOURCE spelling. Rows are stored
/// comma-joined; the syntax is `+`-separated. Only for text a reader may
/// copy back into their code -- the contract engine's own signature strings
/// (contract.vibe's fn_sig_text) deliberately stay braced, see the note there.
fn row_to_source_spelling(row: String) -> String {
  let parts = String::split(row, ", ")
  let n = Array::length(parts)
  let mut acc = ""
  let mut i = 0
  while i < n {
    acc = if i == 0 {
      Array::get(parts, i)
    } else {
      String::concat(acc, String::concat(" + ", Array::get(parts, i)))
    }
    i = i + 1
  }
  acc
}

export fn type_to_string(ty: Type) -> String {
  match ty {
    CtInt => "Int",
    CtDouble => "Double",
    CtBool => "Bool",
    CtString => "String",
    CtChar => "Char",
    CtUnit => "()",
    CtBytes => "Bytes",
    CtVar(id) => "?t\{id}",
    CtForAll(vars, _, body) => {
      let vlen = Array::length(vars)
      let mut vi = 0
      let mut vacc = ""
      while vi < vlen {
        let v = String::concat("?t", __to_string(Array::get(vars, vi)))
        let next = if vi > 0 {
          String::concat(vacc, String::concat(" ", v))
        } else v
        vacc = next
        vi = vi + 1
      }
      String::concat("forall ", String::concat(vacc, String::concat(". ", type_to_string(body))))
    },
    CtUnknown => "?",
    CtArray(elem) => String::concat("Array[", String::concat(type_to_string(elem), "]")),
    CtOption(elem) => String::concat("Option[", String::concat(type_to_string(elem), "]")),
    CtEnum(name) => name,
    // #1539: the checker identity is deliberately unspellable so source
    // structs/types cannot forge a provider token. Diagnostics expose only
    // the public nominal spelling.
    CtStruct(name) => if name == "#vibe_stdin_stream" {
      "StdinStream"
    } else {
      name
    },
    CtNamed(name, args) => if Array::length(args) == 0 {
      name
    } else {
      let parts = for arg in args {
        type_to_string(arg)
      }
      let mut i = 0
      let mut joined = ""
      while i < Array::length(parts) {
        joined = if i > 0 {
          String::concat(joined, String::concat(", ", Array::get(parts, i)))
        } else Array::get(parts, i)
        i = i + 1
      }
      String::concat(name, String::concat("[", String::concat(joined, "]")))
    },
    CtTuple(elems) => {
      let parts = for e in elems {
        type_to_string(e)
      }
      let mut i = 0
      let mut joined = ""
      while i < Array::length(parts) {
        joined = if i > 0 {
          String::concat(joined, String::concat(", ", Array::get(parts, i)))
        } else Array::get(parts, i)
        i = i + 1
      }
      String::concat("(", String::concat(joined, ")"))
    },
    CtRecord(rfields) => {
      let mut ri = 0
      let mut rjoined = ""
      while ri < Array::length(rfields) {
        let (rfn, rft) = Array::get(rfields, ri)
        let rpart = String::concat(rfn, String::concat(": ", type_to_string(rft)))
        rjoined = if ri > 0 {
          String::concat(rjoined, String::concat(", ", rpart))
        } else rpart
        ri = ri + 1
      }
      String::concat("record { ", String::concat(rjoined, " }"))
    },
    CtFn(params, ret, effect_name) => {
      let parts = for p in params {
        type_to_string(p)
      }
      let mut i = 0
      let mut joined = ""
      while i < Array::length(parts) {
        joined = if i > 0 {
          String::concat(joined, String::concat(", ", Array::get(parts, i)))
        } else Array::get(parts, i)
        i = i + 1
      }
      let ret_text = type_to_string(ret)
      let base = String::concat("(", String::concat(joined, String::concat(") -> ", ret_text)))
      match semantic_effect_opt(effect_name) {
        // #1429: this text lands in type-mismatch messages, so it has to be
        // the spelling the reader would type. Rows are stored comma-joined;
        // the syntax is `+`-separated.
        Some(name) => String::concat(base, String::concat(" with ", row_to_source_spelling(name))),
        None => base
      }
    }
  }
}

fn empty_type_args() -> Array[Type] {
  array_empty()
}

export fn env_lookup_flat(bindings: Array[(String, Type)], name: String) -> Option[Type] {
  let len = Array::length(bindings)
  let mut i = 0
  let mut result = None
  let mut done = false
  while !done {
    if i >= len {
      done = true
    } else {
      let (n, ty) = Array::get(bindings, i)
      if n == name {
        result = Some(ty)
        done = true
      } else {
        i = i + 1
      }
    }
  }
  result
}

export fn resolve_builtin(name: String) -> Option[Type] {
  if name == "Int" || name == "i32" {
    Some(CtInt)
  }
  else if name == "Double" || name == "f64" || name == "Float" || name == "f32" {
    // This type system has no distinct 32-bit float: `Float` is
    // unified with `Double` (codegen is f64-only, and float literals such as
    // `0.0f` are already typed CtDouble). Without this, `Float` resolved to an
    // opaque CtNamed and `x < 0.0f` mismatched (Float vs Double).
    Some(CtDouble)
  }
  else if name == "Bool" {
    Some(CtBool)
  }
  else if name == "String" {
    Some(CtString)
  }
  else if name == "Char" {
    Some(CtChar)
  }
  else if name == "Unit" {
    Some(CtUnit)
  }
  else if name == "Bytes" {
    Some(CtBytes)
  }
  else if name == "StdinStream" {
    // #1539: compiler-owned opaque scalar token. CtStruct with an unspellable
    // identity is concrete (unlike a nullary CtNamed) while remaining
    // impossible for source declarations or literals to manufacture.
    Some(CtStruct("#vibe_stdin_stream"))
  }
  else if name == "V128" {
    // #536: first-class WebAssembly 128-bit SIMD type. Represented structurally
    // as CtNamed("V128", []) (no core Type enum variant), mirroring how
    // Future/Stream/Task are represented; a V128 value is a tagged pointer to a
    // 16-byte heap box (see codegen in compile_call.vibe).
    Some(CtNamed("V128", empty_type_args()))
  }
  else if name == "i64"
  || name == "u8"
  || name == "u16"
  || name == "u32"
  || name == "u64"
  || name == "i16"
  || name == "v128" {
    Some(CtNamed(name, empty_type_args()))
  }
  else None
}

export fn subst_add_bound(s: Subst, id: Int, bounds: Array[String]) -> Subst {
  SubstBound(id, bounds, s)
}

fn empty_var_bounds() -> Array[(Int, Array[String])] {
  array_empty()
}

fn int_bounds_has_id(pairs: Array[(Int, Array[String])], id: Int, i: Int) -> Bool {
  if i >= Array::length(pairs) {
    false
  } else {
    let (pid, _) = Array::get(pairs, i)
    if pid == id {
      true
    } else {
      int_bounds_has_id(pairs, id, i + 1)
    }
  }
}

fn int_bounds_lookup(pairs: Array[(Int, Array[String])], id: Int, i: Int) -> Array[String] {
  if i >= Array::length(pairs) {
    array_empty()
  } else {
    let (pid, bounds) = Array::get(pairs, i)
    if pid == id {
      bounds
    } else {
      int_bounds_lookup(pairs, id, i + 1)
    }
  }
}

fn int_int_lookup_or(pairs: Array[(Int, Int)], key: Int, fallback: Int, i: Int) -> Int {
  if i >= Array::length(pairs) {
    fallback
  } else {
    let (k, v) = Array::get(pairs, i)
    if k == key {
      v
    } else {
      int_int_lookup_or(pairs, key, fallback, i + 1)
    }
  }
}

/// #626 criterion 4: collect the distinct effect-VARIABLE names appearing in a
/// type scheme body (lone `with e` annotations), so `instantiate` can mint a
/// fresh variable per use site and effect polymorphism survives unification.
fn collect_effect_vars_walk(t: Type, out: Array[String]) -> Int {
  match t {
    CtFn(params, ret, eff) => {
      match eff {
        Some(name) => if is_effect_var_name(name) {
          let mut seen = false
          let mut k = 0
          while k < Array::length(out) {
            if Array::get(out, k) == name {
              seen = true
            }
            k = k + 1
          }
          if !seen {
            Array::push(out, name)
          }
        },
        None => ()
      }
      for p in params {
        let _ = collect_effect_vars_walk(p, out)
      }
      collect_effect_vars_walk(ret, out)
    },
    CtArray(elem) => collect_effect_vars_walk(elem, out),
    CtOption(elem) => collect_effect_vars_walk(elem, out),
    CtRecord(rfields) => {
      for rf in rfields {
        let (_, rft) = rf
        let _ = collect_effect_vars_walk(rft, out)
      }
      0
    },
    CtTuple(elems) => {
      for e in elems {
        let _ = collect_effect_vars_walk(e, out)
      }
      0
    },
    CtNamed(_, args) => {
      for a in args {
        let _ = collect_effect_vars_walk(a, out)
      }
      0
    },
    CtForAll(_, _, body) => collect_effect_vars_walk(body, out),
    _ => 0
  }
}

fn rename_eff_name(name: String, pairs: Array[(String, String)]) -> String {
  let mut i = 0
  let mut out = name
  while i < Array::length(pairs) {
    let (k, v) = Array::get(pairs, i)
    if k == name {
      out = v
    }
    i = i + 1
  }
  out
}

fn rename_effect_vars(t: Type, pairs: Array[(String, String)]) -> Type {
  match t {
    CtFn(params, ret, eff) => {
      let new_params = array_empty()
      let mut i = 0
      while i < Array::length(params) {
        Array::push(new_params, rename_effect_vars(Array::get(params, i), pairs))
        i = i + 1
      }
      let new_eff = match eff {
        Some(name) => Some(rename_eff_name(name, pairs)),
        None => None
      }
      CtFn(new_params, rename_effect_vars(ret, pairs), new_eff)
    },
    CtArray(elem) => CtArray(rename_effect_vars(elem, pairs)),
    CtOption(elem) => CtOption(rename_effect_vars(elem, pairs)),
    CtTuple(elems) => {
      let out = array_empty()
      let mut i = 0
      while i < Array::length(elems) {
        Array::push(out, rename_effect_vars(Array::get(elems, i), pairs))
        i = i + 1
      }
      CtTuple(out)
    },
    CtRecord(rfields) => {
      let rout = array_empty()
      let mut ri = 0
      while ri < Array::length(rfields) {
        let (rfn, rft) = Array::get(rfields, ri)
        Array::push(rout, (rfn, rename_effect_vars(rft, pairs)))
        ri = ri + 1
      }
      CtRecord(rout)
    },
    CtNamed(name, args) => {
      let out = array_empty()
      let mut i = 0
      while i < Array::length(args) {
        Array::push(out, rename_effect_vars(Array::get(args, i), pairs))
        i = i + 1
      }
      CtNamed(name, out)
    },
    _ => t
  }
}

export fn instantiate(ty: Type, c: Int) -> (Type, Int, Array[(Int, Array[String])]) {
  match ty {
    CtForAll(bound_vars, var_bounds, body) => {
      let blen = Array::length(bound_vars)
      let id_map = array_empty()
      let mut bi = 0
      let mut bacc = SubstEmpty
      // #743: fresh ids must not overlap the scheme's OLD bound ids. An
      // IMPORTED scheme carries bound-var ids from the EXPORTING module's
      // counter domain (FS-compile checks modules separately and caches
      // their envs), so the importing module's counter c can be ≤ an old id.
      // A fresh id equal to another old bound id makes subst_apply's
      // transitive var resolution chain old→fresh→fresh' and COLLAPSES two
      // distinct scheme vars into one — `Err` from the prelude instantiated
      // as `(E) -> Result[E, E]` whenever exactly one extra type var had
      // been allocated before the use site (json_parse's #743).
      let mut bnc = c
      let mut bmax_i = 0
      while bmax_i < blen {
        let bold = Array::get(bound_vars, bmax_i)
        if bold >= bnc {
          bnc = bold + 1
        } else {
          ()
        }
        bmax_i = bmax_i + 1
      }
      while bi < blen {
        let old_id = Array::get(bound_vars, bi)
        Array::push(id_map, (old_id, bnc))
        bacc = SubstBind(old_id, CtVar(bnc), bacc)
        bnc = bnc + 1
        bi = bi + 1
      }
      let inst_s = bacc
      let id_map2 = id_map
      let c1 = bnc
      let new_bounds = array_empty()
      for var_bound in var_bounds {
        let (old_id, bounds) = var_bound
        let new_id = int_int_lookup_or(id_map2, old_id, old_id, 0)
        Array::push(new_bounds, (new_id, bounds))
      };
      let inst_body = subst_apply(inst_s, body)
      // #626 criterion 4: freshen the scheme's effect variables so each use site
      // gets its own variable. Without this, binding `e` at one call site would
      // leak to every other call (effect polymorphism would collapse to the
      // first concrete effect). Fresh names are `$<counter>` (never a real
      // effect name), threaded through the same counter as type variables.
      let eff_vars = array_empty()
      let _ = collect_effect_vars_walk(inst_body, eff_vars)
      let eff_pairs = array_empty()
      let mut ev_i = 0
      let mut ev_c = c1
      while ev_i < Array::length(eff_vars) {
        let ev = Array::get(eff_vars, ev_i)
        Array::push(eff_pairs, (ev, String::concat("$", __to_string(ev_c))))
        ev_c = ev_c + 1
        ev_i = ev_i + 1
      }
      let final_body = if Array::length(eff_pairs) == 0 {
        inst_body
      } else {
        rename_effect_vars(inst_body, eff_pairs)
      }
      (final_body, ev_c, new_bounds)
    },
    _ => (ty, c, empty_var_bounds())
  }
}

export fn trait_is_subtrait(env: TypeEnv, sub: String, super_name: String) -> Bool {
  if sub == super_name {
    true
  }
  else {
    let supers = trait_supers(env, sub)
    let slen = Array::length(supers)
    let mut si = 0
    let mut sresult = false
    let mut sdone = false
    while !sdone {
      if si >= slen {
        sdone = true
      } else {
        let s = Array::get(supers, si)
        if s == super_name {
          sresult = true
          sdone = true
        } else if trait_is_subtrait(env, s, super_name) {
          sresult = true
          sdone = true
        } else {
          si = si + 1
        }
      }
    }
    sresult
  }
}

fn collect_tvars_walk(t: Type, out: Array[Int]) -> Int {
  match t {
    CtVar(id) => {
      if !array_has_int(out, id, 0) {
        Array::push(out, id)
      }
      0
    },
    CtFn(params, ret, _) => {
      for p in params {
        let _ = collect_tvars_walk(p, out)
      }
      collect_tvars_walk(ret, out)
    },
    CtArray(elem) => collect_tvars_walk(elem, out),
    CtOption(elem) => collect_tvars_walk(elem, out),
    CtRecord(rfields) => {
      for rf in rfields {
        let (_, rft) = rf
        let _ = collect_tvars_walk(rft, out)
      }
      0
    },
    CtTuple(elems) => {
      for e in elems {
        let _ = collect_tvars_walk(e, out)
      }
      0
    },
    // #829: type variables inside an APPLIED named type's arguments (e.g. the
    // `V` in `MutSortedMap[K, V]` when only `K` is mentioned by a parameter) must
    // be quantified too. They used to be skipped, leaving the scheme with a
    // FREE variable whose id is from the exporting module's counter domain —
    // an id-collision landmine (#743's hazard, but for free vars, which
    // `instantiate` does not rename): once generic struct types became real
    // (`CtNamed(S, args)` instead of CtUnknown), a collision bound an
    // importing module's own type param through the shared free var.
    CtNamed(_, args) => {
      for a in args {
        let _ = collect_tvars_walk(a, out)
      }
      0
    },
    CtForAll(_, _, body) => collect_tvars_walk(body, out),
    _ => 0
  }
}

export fn collect_tvars(ty: Type) -> Array[Int] {
  let out = array_empty()
  let _ = collect_tvars_walk(ty, out)
  out
}

fn empty_env_bindings() -> Array[(String, Type)] {
  array_empty()
}

export fn env_flat_bindings(env: TypeEnv) -> Array[(String, Type)] {
  let out = empty_env_bindings()
  match env {
    EnvFlat(bindings) => {
      let mut i = 0
      while i < Array::length(bindings) {
        let (name, binding) = Array::get(bindings, i)
        Array::push(out, (name, binding.ty))
        i = i + 1
      }
      out
    },
    _ => {
      let mut cur = env
      let mut done = false
      while !done {
        match cur {
          EnvEmpty => {
            done = true
          },
          EnvBind(name, binding, rest) => {
            Array::push(out, (name, binding.ty))
            cur = rest
          },
          EnvTraitDef(_, _, _, _, rest, _, _) => {
            cur = rest
          },
          EnvTraitImpl(_, _, rest) => {
            cur = rest
          },
          EnvMutCell(_, _, rest) => {
            cur = rest
          },
          EnvTraitImplGen(_, _, _, _, rest) => {
            cur = rest
          },
          EnvTypeDefs(_, _, rest) => {
            cur = rest
          },
          EnvFlat(bindings) => {
            let mut j = 0
            while j < Array::length(bindings) {
              let (name, binding) = Array::get(bindings, j)
              Array::push(out, (name, binding.ty))
              j = j + 1
            }
            done = true
          },
          EnvCached(_, _, rest) => {
            cur = rest
          }
        }
      }
      out
    }
  }
}

fn string_array_equal(left: Array[String], right: Array[String]) -> Bool {
  let len = Array::length(left)
  let mut i = 0
  let mut result = true
  let mut done = false
  while !done {
    if i >= len {
      done = true
    } else if Array::get(left, i) != Array::get(right, i) {
      result = false
      done = true
    } else {
      i = i + 1
    }
  }
  result
}

fn option_string_equal(left: Option[String], right: Option[String]) -> Bool {
  match left {
    Some(left_name) => match right {
      Some(right_name) => left_name == right_name,
      None => false
    },
    None => match right {
      Some(_) => false,
      None => true
    }
  }
}

/// #626 criterion 3: an effect annotation `with A + B` is an unordered SET,
/// but `collect_effect_names` joins it source-order into one string ("A, B"),
/// so `{ A, B }` and `{ B, A }` serialize to different strings. Split the
/// comma-separated annotation back into its labels (trimmed, deduplicated) so
/// equality can be decided on the set, not the raw ordered string.
fn effect_label_list(eff: Option[String]) -> Array[String] {
  let out = array_empty()
  match eff {
    None => out,
    Some(s) => {
      let raw = String::split(s, ",")
      let mut i = 0
      while i < Array::length(raw) {
        let label = String::trim(Array::get(raw, i))
        if String::length(label) > 0 {
          let mut seen = false
          let mut j = 0
          while j < Array::length(out) {
            if Array::get(out, j) == label {
              seen = true
            }
            j = j + 1
          }
          if !seen {
            Array::push(out, label)
          }
        }
        i = i + 1
      }
      out
    }
  }
}

/// #1340 (ADR-0071): a generic instantiation label (`State[Int]`) compares
/// by its base effect name in row set-equality — mixing spellings
/// (`with State` vs `with State[Int]`) must not fail fn-type
/// unification. For bracketless labels this is exact equality, so
/// pre-#1340 rows are unchanged. Instantiation-precise row identity is the
/// remaining ADR-0071 OperationRef-normalization work.
///
/// ADR-0085 (#1344): the exception effect is the one generic effect that does
/// NOT collapse to its base — `Exception[IoError]` and `Exception[ParseError]`
/// must stay distinct here or the two rows unify and check_assignable never
/// reaches its dropped-label report. The ERASED spellings (`Exception`,
/// `Error`, and either one's `::Throw`) all normalize to `Exception` (#1461
/// flipped this from `Error`), which is what keeps `with Exception` and
/// `with Exception` interchangeable exactly as the #1279 bridge made them --
/// the canonical side of that pair moved, the pairing did not. An erased row
/// and a kinded row do differ
/// here, but that only routes them into check_assignable's structural retry,
/// where effect_row_dropped tolerates them (an erased label is kind-compatible
/// with every kind) — so no pre-#1344 program changes verdict.
fn effect_label_base_name(label: String) -> String {
  if is_exception_label(label) {
    let kind = exception_label_kind(label)
    if String::length(kind) == 0 {
      "Exception"
    } else {
      String::concat("Exception[", String::concat(kind, "]"))
    }
  } else {
    let bi = String::index_of(label, "[")
    if bi > 0 {
      String::substring(label, 0, bi)
    } else {
      label
    }
  }
}

/// #1340 (Codex P1 on #1352): reduce a label list to its BASE names, deduped.
/// effect_label_list dedupes by EXACT label, which is what made "same length +
/// one-way membership" a sound set-equality test. Comparing by base name
/// breaks that invariant on its own -- `{ State[Int], State[String] }` is two
/// exact labels but ONE base -- so `{ State[Int], State[String] }` vs
/// `{ State, Fs }` would match on length AND find every left base on the
/// right, silently accepting a row that drops `Fs`. Deduping by base first
/// restores the invariant: both sides become genuine base-name sets.
fn effect_label_base_set(labels: Array[String]) -> Array[String] {
  let out = array_empty()
  let mut i = 0
  while i < Array::length(labels) {
    let raw = Array::get(labels, i)
    let provenance = String::starts_with(raw, "#region_") || String::starts_with(raw, "#capture[")
    let base = effect_label_base_name(raw)
    let mut seen = false
    let mut j = 0
    while j < Array::length(out) {
      if Array::get(out, j) == base {
        seen = true
      }
      j = j + 1
    }
    if !seen && !provenance {
      Array::push(out, base)
    }
    i = i + 1
  }
  out
}

fn effect_label_sets_equal(left: Option[String], right: Option[String]) -> Bool {
  let ls = effect_label_base_set(effect_label_list(left))
  let rs = effect_label_base_set(effect_label_list(right))
  if Array::length(ls) != Array::length(rs) {
    false
  } else {
    let mut i = 0
    let mut ok = true
    while i < Array::length(ls) {
      let label = Array::get(ls, i)
      let mut found = false
      let mut j = 0
      while j < Array::length(rs) {
        if Array::get(rs, j) == label {
          found = true
        }
        j = j + 1
      }
      if !found {
        ok = false
      }
      i = i + 1
    }
    ok
  }
}

fn effect_opt_is_var(eff: Option[String]) -> Bool {
  let labels = effect_label_list(eff)
  let mut count = 0
  let mut variable = false
  for label in labels {
    if !String::starts_with(label, "#region_") && !String::starts_with(label, "#capture[") {
      count = count + 1
      variable = is_effect_var_name(label)
    }
  }
  count == 1 && variable
}

fn semantic_effect_opt(eff: Option[String]) -> Option[String] {
  let labels = effect_label_list(eff)
  let semantic = array_empty()
  for label in labels {
    if !String::starts_with(label, "#region_") && !String::starts_with(label, "#capture[") {
      Array::push(semantic, label)
    }
  }
  if Array::length(semantic) == 0 {
    None
  } else {
    Some(String::join(semantic, ", "))
  }
}

fn effect_names_compatible(left: Option[String], right: Option[String]) -> Bool {
  if option_string_equal(left, right) {
    true
  } else if effect_opt_is_var(left) {
    // #626 criterion 4: an effect variable is NO LONGER a wildcard. It equals
    // only itself (handled by `option_string_equal` above); a variable vs a
    // different effect is reported NOT-equal here so that `unify`'s structural
    // `types_equal` fast path falls through to the `CtFn` arm, where
    // `unify_effects` records the actual binding (and detects a later conflict).
    false
  } else if effect_opt_is_var(right) {
    false
  } else {
    // Neither side is an effect variable: decide on the unordered label set, so
    // `{ A, B }` and `{ B, A }` (and `{ A, A }` vs `{ A }`) are compatible
    // (criterion 3). `None` (pure) vs `Some(concrete)` differ in set size and
    // stay incompatible.
    effect_label_sets_equal(left, right)
  }
}

/// Unify two effect annotations, binding an effect VARIABLE to the other side
/// (#626 criterion 4 — no longer an unconditional wildcard). Returns the extended
/// substitution, or None on a genuine effect-set conflict.
fn unify_effects(ea: Option[String], eb: Option[String], s: Subst) -> Option[Subst] {
  let ra = semantic_effect_opt(resolve_effect_opt(s, ea))
  let rb = semantic_effect_opt(resolve_effect_opt(s, eb))
  let a_is_var = match ra {
    Some(n) => is_effect_var_name(n),
    None => false
  }
  let b_is_var = match rb {
    Some(n) => is_effect_var_name(n),
    None => false
  }
  if a_is_var {
    match ra {
      Some(av) => if Some(av) == rb {
        Some(s)
      } else {
        let bval = match rb {
          Some(bv) => bv,
          None => ""
        }
        Some(SubstEffBind(av, bval, s))
      },
      None => Some(s)
    }
  } else if b_is_var {
    match rb {
      Some(bv) => {
        let aval = match ra {
          Some(av) => av,
          None => ""
        }
        Some(SubstEffBind(bv, aval, s))
      },
      None => Some(s)
    }
  } else if effect_names_compatible(ra, rb) {
    Some(s)
  } else {
    None
  }
}

export fn types_equal(a: Type, b: Type) -> Bool {
  match a {
    CtInt => match b {
      CtInt => true,
      _ => false
    },
    CtDouble => match b {
      CtDouble => true,
      _ => false
    },
    CtBool => match b {
      CtBool => true,
      _ => false
    },
    CtString => match b {
      CtString => true,
      _ => false
    },
    CtChar => match b {
      CtChar => true,
      _ => false
    },
    CtUnit => match b {
      CtUnit => true,
      _ => false
    },
    CtBytes => match b {
      CtBytes => true,
      _ => false
    },
    CtUnknown => match b {
      CtUnknown => true,
      _ => false
    },
    CtVar(aid) => match b {
      CtVar(bid) => (aid == bid),
      _ => false
    },
    CtArray(aelem) => match b {
      CtArray(belem) => types_equal(aelem, belem),
      _ => false
    },
    CtOption(aelem) => match b {
      CtOption(belem) => types_equal(aelem, belem),
      _ => false
    },
    CtEnum(aname) => match b {
      CtEnum(bname) => aname == bname,
      // A bare named type `CtNamed(X, [])` (zero type args) denotes the same
      // type as the enum `CtEnum(X)`. Cross-module imports can resolve a
      // self-referential enum ctor field type to one form and a function
      // annotation to the other; bridge them so they unify.
      CtNamed(bname, bargs) => aname == bname && Array::length(bargs) == 0,
      _ => false
    },
    CtStruct(aname) => match b {
      CtStruct(bname) => aname == bname,
      CtNamed(bname, bargs) => aname == bname && Array::length(bargs) == 0,
      _ => false
    },
    CtNamed(aname, aargs) => match b {
      CtEnum(bname) => aname == bname && Array::length(aargs) == 0,
      CtStruct(bname) => aname == bname && Array::length(aargs) == 0,
      CtNamed(bname, bargs) =>
      if aname != bname {
        false
      } else if Array::length(aargs) != Array::length(bargs) {
        false
      } else {
        let tae_len = Array::length(aargs)
        let mut tae_i = 0
        let mut tae_result = true
        let mut tae_done = false
        while !tae_done {
          if tae_i >= tae_len {
            tae_done = true
          } else {
            if types_equal(Array::get(aargs, tae_i), Array::get(bargs, tae_i)) {
              tae_i = tae_i + 1
            } else {
              tae_result = false
              tae_done = true
            }
          }
        }
        tae_result
      },
      _ => false
    },
    CtTuple(aelems) => match b {
      CtTuple(belems) =>
      if Array::length(aelems) != Array::length(belems) {
        false
      } else {
        let tae_len2 = Array::length(aelems)
        let mut tae_i2 = 0
        let mut tae_result2 = true
        let mut tae_done2 = false
        while !tae_done2 {
          if tae_i2 >= tae_len2 {
            tae_done2 = true
          } else {
            if types_equal(Array::get(aelems, tae_i2), Array::get(belems, tae_i2)) {
              tae_i2 = tae_i2 + 1
            } else {
              tae_result2 = false
              tae_done2 = true
            }
          }
        }
        tae_result2
      },
      _ => false
    },
    // #1839: records are structural with LITERAL field order (order IS the
    // runtime slot layout), so equality is order-sensitive: same names in the
    // same positions with equal types.
    CtRecord(arf) => match b {
      CtRecord(brf) =>
      if Array::length(arf) != Array::length(brf) {
        false
      } else {
        let rql = Array::length(arf)
        let mut rqi = 0
        let mut rq_result = true
        let mut rq_done = false
        while !rq_done {
          if rqi >= rql {
            rq_done = true
          } else {
            let (afn, aft) = Array::get(arf, rqi)
            let (bfn, bft) = Array::get(brf, rqi)
            if afn == bfn && types_equal(aft, bft) {
              rqi = rqi + 1
            } else {
              rq_result = false
              rq_done = true
            }
          }
        }
        rq_result
      },
      _ => false
    },
    CtFn(aparams, aret, aeffect) => match b {
      CtFn(bparams, bret, beffect) =>
      if Array::length(aparams) != Array::length(bparams) {
        false
      } else if effect_names_compatible(aeffect, beffect) {
        let tae_len3 = Array::length(aparams)
        let mut tae_i3 = 0
        let mut tae_result3 = true
        let mut tae_done3 = false
        while !tae_done3 {
          if tae_i3 >= tae_len3 {
            tae_done3 = true
          } else {
            if types_equal(Array::get(aparams, tae_i3), Array::get(bparams, tae_i3)) {
              tae_i3 = tae_i3 + 1
            } else {
              tae_result3 = false
              tae_done3 = true
            }
          }
        }
        if tae_result3 {
          types_equal(aret, bret)
        } else {
          false
        }
      } else {
        false
      },
      _ => false
    },
    CtForAll(avars, abounds, abody) => match b {
      CtForAll(bvars, bbounds, bbody) => if Array::length(avars) != Array::length(bvars) {
        false
      } else if Array::length(abounds) != Array::length(bbounds) {
        false
      } else {
        let vlen = Array::length(avars)
        let mut vi = 0
        let mut vresult = true
        let mut vdone = false
        while !vdone {
          if vi >= vlen {
            vdone = true
          } else if Array::get(avars, vi) != Array::get(bvars, vi) {
            vresult = false
            vdone = true
          } else {
            vi = vi + 1
          }
        }
        if vresult {
          let fbe_len = Array::length(abounds)
          let mut fbe_i = 0
          let mut fbe_result = true
          let mut fbe_done = false
          while !fbe_done {
            if fbe_i >= fbe_len {
              fbe_done = true
            } else {
              let (lvar, lbounds) = Array::get(abounds, fbe_i)
              let (rvar, rbounds) = Array::get(bbounds, fbe_i)
              if lvar != rvar {
                fbe_result = false
                fbe_done = true
              } else if Array::length(lbounds) != Array::length(rbounds) {
                fbe_result = false
                fbe_done = true
              } else {
                if string_array_equal(lbounds, rbounds) {
                  fbe_i = fbe_i + 1
                } else {
                  fbe_result = false
                  fbe_done = true
                }
              }
            }
          }
          if fbe_result {
            types_equal(abody, bbody)
          } else {
            false
          }
        } else {
          false
        }
      }
      ,
      _ => false
    }
  }
}

/// `Char` is a transparent alias of `Int`: char literals (`'A'`) lex to integer
/// tokens (TInt, see lexer.vibe lex_char), so a value of Char and a value of Int
/// share one runtime representation and must unify freely — a `Char` annotation
/// accepts an int value and vice versa (`'A' == 65`, `c + 1`, char_test).
fn char_int_compatible(ta: Type, tb: Type) -> Bool {
  match ta {
    CtChar => match tb {
      CtInt => true,
      _ => false
    },
    CtInt => match tb {
      CtChar => true,
      _ => false
    },
    _ => false
  }
}

///|
export fn unify(a: Type, b: Type, s: Subst) -> Option[Subst] {
  let ta = subst_apply(s, a)
  let tb = subst_apply(s, b)
  if types_equal(ta, tb) {
    Some(s)
  }
  else if char_int_compatible(ta, tb) {
    Some(s)
  }
  // #1324: `CtUnknown` means "no information", so it is compatible with
  // everything -- but it must never BIND a type variable to itself. This
  // arm used to sit BELOW the two `CtVar` arms, so `unify(CtVar(T),
  // CtUnknown)` recorded `T := CtUnknown` and erased T for good. That fires
  // on any `fn f[T](..) -> T` whose body reaches `throw` in a T-typed
  // position (`throw`'s own result is CtUnknown -- builtins_misc.vibe's
  // lookup_throw), which is exactly the shape #1324 gives
  // `TaskGroup::run` / `TaskHandle::join`. The declaration's generalized
  // scheme then carries `CtUnknown` where `T` belongs, and checker.vibe's
  // #1081 region-escape scan -- which asks whether the zonked body return
  // still mentions this run call's rigid skolem -- silently saw
  // `CtUnknown` and stopped rejecting real escapes
  // (fixtures/err_region_escape_return.vibe compiled clean).
  // Leaving the variable UNBOUND is strictly better on both counts: the
  // var stays free to unify with the real type from another use site, and
  // a type that was never learned stays unknown instead of masquerading as
  // a known one.
  else match ta {
    CtUnknown => Some(s),
    _ => match tb {
      CtUnknown => Some(s),
      _ => match ta {
        CtVar(id) => if occurs_in(id, tb) {
          None
        } else Some(SubstBind(id, tb, s)),
        _ => match tb {
          CtVar(id) => if occurs_in(id, ta) {
            None
          } else Some(SubstBind(id, ta, s)),
          _ => match ta {
            CtForAll(_, _, body_a) => match tb {
              CtForAll(_, _, body_b) => unify(body_a, body_b, s),
              _ => unify(body_a, tb, s)
            },
            _ => match tb {
              CtForAll(_, _, body_b) => unify(ta, body_b, s),
              _ => match ta {
                CtArray(ea) => match tb {
                  CtArray(eb) => unify(ea, eb, s),
                  _ => None
                },
                CtOption(ea) => match tb {
                  CtOption(eb) => unify(ea, eb, s),
                  _ => None
                },
                CtFn(pa, ra, aeffect) => match tb {
                  CtFn(pb, rb, beffect) => if Array::length(pa) != Array::length(pb) {
                    None
                  }
                  else {
                    let ul_len = Array::length(pa)
                    let mut ul_i = 0
                    let mut ul_acc = s
                    let mut ul_result = Some(s)
                    let mut ul_done = false
                    while !ul_done {
                      if ul_i >= ul_len {
                        ul_result = Some(ul_acc)
                        ul_done = true
                      } else {
                        match unify(Array::get(pa, ul_i), Array::get(pb, ul_i), ul_acc) {
                          Some(s2) => {
                            ul_acc = s2
                            ul_i = ul_i + 1
                          },
                          None => {
                            ul_result = None
                            ul_done = true
                          }
                        }
                      }
                    }
                    // #626 criterion 4: unify params, then the return type, then
                    // the EFFECT row — binding an effect variable to the other
                    // side (or failing on a genuine effect conflict) instead of
                    // the old unconditional-wildcard accept.
                    match ul_result {
                      Some(s2) => match unify(ra, rb, s2) {
                        Some(s3) => unify_effects(aeffect, beffect, s3),
                        None => None
                      },
                      None => None
                    }
                  },
                  _ => None
                },
                CtTuple(ea) => match tb {
                  CtTuple(eb) => if Array::length(ea) != Array::length(eb) {
                    None
                  }
                  else {
                    let ul_len2 = Array::length(ea)
                    let mut ul_i2 = 0
                    let mut ul_acc2 = s
                    let mut ul_result2 = Some(s)
                    let mut ul_done2 = false
                    while !ul_done2 {
                      if ul_i2 >= ul_len2 {
                        ul_result2 = Some(ul_acc2)
                        ul_done2 = true
                      } else {
                        match unify(Array::get(ea, ul_i2), Array::get(eb, ul_i2), ul_acc2) {
                          Some(s2) => {
                            ul_acc2 = s2
                            ul_i2 = ul_i2 + 1
                          },
                          None => {
                            ul_result2 = None
                            ul_done2 = true
                          }
                        }
                      }
                    }
                    ul_result2
                  },
                  _ => None
                },
                // #1839: records unify only with records of the same shape —
                // same field names in the same order (order IS the runtime
                // slot layout), field types unified pairwise. Against any
                // nominal type (CtStruct/CtNamed/...) the catch-all below
                // rejects, which is the point: an anonymous record can never
                // silently satisfy a struct-typed position.
                CtRecord(raf) => match tb {
                  CtRecord(rbf) => if Array::length(raf) != Array::length(rbf) {
                    None
                  }
                  else {
                    let ur_len = Array::length(raf)
                    let mut ur_i = 0
                    let mut ur_acc = s
                    let mut ur_result = Some(s)
                    let mut ur_done = false
                    while !ur_done {
                      if ur_i >= ur_len {
                        ur_result = Some(ur_acc)
                        ur_done = true
                      } else {
                        let (ur_an, ur_at) = Array::get(raf, ur_i)
                        let (ur_bn, ur_bt) = Array::get(rbf, ur_i)
                        if ur_an != ur_bn {
                          ur_result = None
                          ur_done = true
                        } else {
                          match unify(ur_at, ur_bt, ur_acc) {
                            Some(s2) => {
                              ur_acc = s2
                              ur_i = ur_i + 1
                            },
                            None => {
                              ur_result = None
                              ur_done = true
                            }
                          }
                        }
                      }
                    }
                    ur_result
                  },
                  _ => None
                },
                CtEnum(a_name) => match tb {
                  CtEnum(b_name) => if a_name == b_name {
                    Some(s)
                  } else None,
                  // Bridge `CtEnum(X)` with `CtNamed(X, args)` of any arity: an
                  // enum VALUE carries no type args (constructors yield a bare
                  // CtEnum), so it must still unify by name with an applied
                  // annotation like `Result[U, E]`.
                  CtNamed(b_name, _) => if a_name == b_name {
                    Some(s)
                  } else None,
                  _ => None
                },
                CtStruct(a_name) => match tb {
                  CtStruct(b_name) => if a_name == b_name {
                    Some(s)
                  } else None,
                  // #829: a bare `CtStruct(S)` (unparameterized annotation /
                  // pre-bound structural fn signature) unifies by name with an
                  // INSTANTIATED `CtNamed(S, args)` of any arity — the bare
                  // form carries no argument information to conflict with,
                  // exactly like the CtEnum/CtNamed bridge below.
                  //
                  // #843 review follow-up (Codex P1): this bridge (both this
                  // arm and its mirror in the `CtNamed(a_name, _)` case below)
                  // lets a value's real #829-instantiated args get discarded
                  // when it flows through a bare annotation (`let x: Box =
                  // Box::{v:1}` types `x` as bare `Box`, forgetting `[Int]`),
                  // and a LATER, unrelated annotation can then silently
                  // re-narrow it (`let y: Box[String] = x; y.v` reads a
                  // stored Int as String) — this is a real, confirmed hole.
                  // It is NOT fixed by restricting the bridge's direction:
                  // call sites are inconsistent about which side is
                  // "expected" (`check_assignable(expected, actual, ..)` →
                  // `unify(expected, actual, ..)`, but the function-body
                  // return-type check calls `unify(body_ty, declared_ret,
                  // ..)` — actual FIRST) — a one-directional restriction here
                  // broke the legitimate mirror case instead (a trait `impl
                  // Trait for S { ... }` method's bare-`S`-typed return
                  // accepting a freshly `S::{...}`-constructed `S[X]`, gate
                  // section 18) without closing the hole (the erasure
                  // happens earlier, in the ascription-lambda / `let`
                  // annotation machinery that decides which of {declared,
                  // inferred} type to keep — not in `unify` itself). Full
                  // bridge restored pending a real fix (tracked in #844:
                  // thread fresh type vars through bare generic-struct
                  // annotations instead of erasing to `CtStruct`, so the
                  // annotation's own vars — not a name-only bridge — carry
                  // the value's real args forward).
                  CtNamed(b_name, _) => if a_name == b_name {
                    Some(s)
                  } else None,
                  _ => None
                },
                CtNamed(a_name, a_args) => match tb {
                  // Symmetric to the CtEnum bridge: an applied `CtNamed(X, args)`
                  // unifies with the bare enum value `CtEnum(X)` by name.
                  CtEnum(b_name) => if a_name == b_name {
                    Some(s)
                  } else None,
                  // #829: symmetric bridge — an applied `CtNamed(S, args)`
                  // unifies with the bare struct `CtStruct(S)` by name. See
                  // the long #843/#844 note on the `CtStruct(a_name)` arm
                  // above — restored (not narrowed) for the same reason.
                  CtStruct(b_name) => if a_name == b_name {
                    Some(s)
                  } else None,
                  CtNamed(b_name, b_args) => if a_name != b_name {
                    None
                  }
                  else if Array::length(a_args) != Array::length(b_args) {
                    None
                  }
                  else {
                    let ul_len3 = Array::length(a_args)
                    let mut ul_i3 = 0
                    let mut ul_acc3 = s
                    let mut ul_result3 = Some(s)
                    let mut ul_done3 = false
                    while !ul_done3 {
                      if ul_i3 >= ul_len3 {
                        ul_result3 = Some(ul_acc3)
                        ul_done3 = true
                      } else {
                        match unify(Array::get(a_args, ul_i3), Array::get(b_args, ul_i3), ul_acc3) {
                          Some(s2) => {
                            ul_acc3 = s2
                            ul_i3 = ul_i3 + 1
                          },
                          None => {
                            ul_result3 = None
                            ul_done3 = true
                          }
                        }
                      }
                    }
                    ul_result3
                  },
                  _ => None
                },
                _ => None
              }
            }
          }
        }
      }
    }
  }
}

export fn types_compatible(expected: Type, actual: Type) -> Bool {
  match expected {
    CtUnknown => true,
    _ => match actual {
      CtUnknown => true,
      _ => types_equal(expected, actual)
    }
  }
}

export fn impls_overlap_for(env: TypeEnv, trait_name: String, new_target: Type) -> Bool {
  match env {
    EnvEmpty => false,
    EnvBind(_, _, rest) => impls_overlap_for(rest, trait_name, new_target),
    EnvMutCell(_, _, rest) => impls_overlap_for(rest, trait_name, new_target),
    EnvTraitDef(_, _, _, _, rest, _, _) => impls_overlap_for(rest, trait_name, new_target),
    EnvTraitImpl(tname, target, rest) => if tname == trait_name {
      if types_equal(target, new_target) {
        true
      }
      else impls_overlap_for(rest, trait_name, new_target)
    } else impls_overlap_for(rest, trait_name, new_target),
    EnvTraitImplGen(_, _, _, _, rest) => impls_overlap_for(rest, trait_name, new_target),
    EnvTypeDefs(_, _, rest) => impls_overlap_for(rest, trait_name, new_target),
    EnvFlat(_) => false,
    EnvCached(_, _, rest) => impls_overlap_for(rest, trait_name, new_target)
  }
}

/// #829: an `impl Trait for S` stores its target with the type arguments
/// ERASED (the SImpl handler registers `CtNamed(S, [])` / `CtStruct(S)`), but
/// an instantiated generic struct value is now typed `CtNamed(S, args)`.
/// Bridge the two by head name — the unparameterized impl covers every
/// instantiation — mirroring the CtEnum/CtNamed unify bridge.
fn struct_impl_target_matches(target: Type, resolved: Type) -> Bool {
  match resolved {
    CtNamed(rname, rargs) => if Array::length(rargs) > 0 {
      match target {
        CtStruct(tname) => tname == rname,
        CtNamed(tname, targs) => tname == rname && Array::length(targs) == 0,
        _ => false
      }
    } else {
      false
    },
    _ => false
  }
}

/// #1503: a CONCRETE impl on a parameterized type (`impl Show for Array[Int]`)
/// records only the head name -- `parse_impl_stmt` reads the identifier after
/// `for` and `skip_bracketed_args` discards `[Int]` -- so the target lands in
/// the env as the bare `CtNamed("Array", [])`. `types_equal` then never matches
/// the concrete `CtArray(CtInt)` at the use site and the impl is invisible,
/// while the GENERIC spelling of the same impl (`impl [T] Show for Array[T]`,
/// which goes through EnvTraitImplGen) resolves by constructor and works.
///
/// Match by constructor here so the two spellings behave identically. Erasing
/// the type args on the concrete side loses nothing the env ever had: the
/// parser already threw them away, so `impl Show for Array[Int]` and
/// `impl Show for Array[String]` are the same declaration today. Narrowing an
/// impl to one instantiation needs the parser to keep the args first (that is a
/// separate, larger change; noted on #1503).
fn concrete_impl_ctor_matches(target: Type, resolved: Type) -> Bool {
  let head = type_constructor_name(resolved)
  match target {
    CtNamed(tname, targs) => Array::length(targs) == 0 && head != "" && tname == head,
    _ => false
  }
}

fn type_implements_check_env(e: TypeEnv, full: TypeEnv, trait_name: String, resolved: Type) -> Bool {
  match e {
    EnvEmpty => false,
    EnvBind(_, _, rest) => type_implements_check_env(rest, full, trait_name, resolved),
    EnvMutCell(_, _, rest) => type_implements_check_env(rest, full, trait_name, resolved),
    EnvTraitDef(_, _, _, _, rest, _, _) => type_implements_check_env(rest, full, trait_name, resolved),
    EnvTraitImpl(tname, target, rest) => if tname == trait_name {
      // The constructor fallback carries the SAME soundness gate as the generic
      // path (see trait_is_method_bearing): a marker trait dispatches to the
      // builtin `==` / `<`, and those are reference equality on `Array` /
      // `Bytes`, so honouring `impl Eq for Array[Int]` would make `==` silently
      // wrong on the very type the bound was written for.
      if types_equal(target, resolved) || struct_impl_target_matches(target, resolved) || (concrete_impl_ctor_matches(target, resolved) && trait_is_method_bearing(full, trait_name)) {
        true
      }
      else type_implements_check_env(rest, full, trait_name, resolved)
    } else type_implements_check_env(rest, full, trait_name, resolved),
    EnvTraitImplGen(_, _, _, _, rest) => type_implements_check_env(rest, full, trait_name, resolved),
    EnvTypeDefs(_, _, rest) => type_implements_check_env(rest, full, trait_name, resolved),
    EnvFlat(_) => false,
    EnvCached(_, _, rest) => type_implements_check_env(rest, full, trait_name, resolved)
  }
}

/// #1503 diagnostics: an impl for this trait IS declared on the resolved type's
/// constructor (either spelling), it just did not satisfy the bound. Lets the
/// bound checker say "declared but not usable, and here is why" instead of the
/// flatly false `no impl \`Eq\` for \`Array[Int]\`` when the user wrote that
/// impl three lines above.
export fn trait_impl_declared_for_ctor(e: TypeEnv, trait_name: String, resolved: Type) -> Bool {
  let head = type_constructor_name(resolved)
  if head == "" {
    false
  } else {
    match e {
      EnvEmpty => false,
      EnvBind(_, _, rest) => trait_impl_declared_for_ctor(rest, trait_name, resolved),
      EnvMutCell(_, _, rest) => trait_impl_declared_for_ctor(rest, trait_name, resolved),
      EnvTraitDef(_, _, _, _, rest, _, _) => trait_impl_declared_for_ctor(rest, trait_name, resolved),
      EnvTraitImpl(tname, target, rest) => if tname == trait_name && type_constructor_name(target) == head {
        true
      } else {
        trait_impl_declared_for_ctor(rest, trait_name, resolved)
      },
      EnvTraitImplGen(itrait, _, _, target, rest) => if itrait == trait_name && type_constructor_name(target) == head {
        true
      } else {
        trait_impl_declared_for_ctor(rest, trait_name, resolved)
      },
      EnvTypeDefs(_, _, rest) => trait_impl_declared_for_ctor(rest, trait_name, resolved),
      EnvFlat(_) => false,
      EnvCached(_, _, rest) => trait_impl_declared_for_ctor(rest, trait_name, resolved)
    }
  }
}

/// #1503 diagnostics: true when `trait_name` is declared with no methods (a
/// marker trait). Exported so the bound checker can explain the marker-trait
/// gate; the gate itself lives in trait_is_method_bearing.
export fn trait_is_marker(env: TypeEnv, trait_name: String) -> Bool {
  not(trait_is_method_bearing(env, trait_name))
}

export fn collect_subst_bounds_pairs(s: Subst) -> Array[(Int, Array[String])] {
  let out = array_empty()
  let mut cur = s
  let mut done = false
  while !done {
    match cur {
      SubstEmpty => {
        done = true
      },
      SubstBind(_, _, rest) => {
        cur = rest
      },
      SubstBound(id, bounds, rest) => {
        if !int_bounds_has_id(out, id, 0) {
          Array::push(out, (id, bounds))
        }
        cur = rest
      },
      SubstCached(_, _, rest) => {
        cur = rest
      },
      SubstEffBind(_, _, rest) => {
        cur = rest
      }
    }
  }
  out
}

export fn generalize(s: Subst, ty: Type) -> Type {
  let resolved = subst_apply(s, ty)
  let tvars = collect_tvars(resolved)
  if Array::length(tvars) == 0 {
    resolved
  }
  else {
    let bounds_pairs = collect_subst_bounds_pairs(s)
    let var_bounds = array_empty()
    for vid in tvars {
      let bounds = int_bounds_lookup(bounds_pairs, vid, 0)
      if Array::length(bounds) != 0 {
        Array::push(var_bounds, (vid, bounds))
      }
    }
    CtForAll(tvars, var_bounds, resolved)
  }
}

/// Does an impl of some SUBTRAIT of `trait_name` cover `resolved`? (`impl Child
/// for P` satisfies a `[T: Base]` bound when `trait Child: Base`.)
///
/// #1503 follow-up (Codex review on #1528): both halves of this scan were
/// incomplete in the same way as the direct scan was.
///
///   * `EnvTraitImpl` matched only `types_equal` / `struct_impl_target_matches`,
///     so a concrete impl on a parameterized type (whose target the parser
///     erased to the bare `CtNamed("Array", [])`) never matched -- the same hole
///     `concrete_impl_ctor_matches` closes for the direct scan, with the same
///     method-bearing gate on the BOUND trait (that is the trait the caller
///     dispatches through).
///   * `EnvTraitImplGen` was skipped outright, so `impl [T] Child for Array[T]`
///     could not satisfy `[T: Base]` at all.
fn type_implements_check_super(e2: TypeEnv, full_env: TypeEnv, s: Subst, trait_name: String, resolved: Type) -> Bool {
  match e2 {
    EnvEmpty => false,
    EnvBind(_, _, rest) => type_implements_check_super(rest, full_env, s, trait_name, resolved),
    EnvMutCell(_, _, rest) => type_implements_check_super(rest, full_env, s, trait_name, resolved),
    EnvTraitDef(_, _, _, _, rest, _, _) => type_implements_check_super(rest, full_env, s, trait_name, resolved),
    EnvTraitImpl(tname, target, rest) => if types_equal(target, resolved) || struct_impl_target_matches(target, resolved) || (concrete_impl_ctor_matches(target, resolved) && trait_is_method_bearing(full_env, trait_name)) {
      if trait_is_subtrait(full_env, tname, trait_name) {
        true
      }
      else type_implements_check_super(rest, full_env, s, trait_name, resolved)
    } else type_implements_check_super(rest, full_env, s, trait_name, resolved),
    EnvTraitImplGen(itrait, _, bounds, target, rest) => {
      let head = type_constructor_name(resolved)
      let shape_ok = head != "" && type_constructor_name(target) == head && trait_is_method_bearing(full_env, trait_name) && trait_is_subtrait(full_env, itrait, trait_name) && itrait != trait_name
      if shape_ok && generic_bounds_hold(full_env, s, bounds, type_args_of(resolved)) {
        true
      } else {
        type_implements_check_super(rest, full_env, s, trait_name, resolved)
      }
    },
    EnvTypeDefs(_, _, rest) => type_implements_check_super(rest, full_env, s, trait_name, resolved),
    EnvFlat(_) => false,
    EnvCached(_, _, rest) => type_implements_check_super(rest, full_env, s, trait_name, resolved)
  }
}

/// Constructor/head name of a type, for matching a generic impl's erased target
/// against a concrete type (`Array[Int]` and the impl target `Array` both have
/// head "Array"). Returns "" for types with no nominal constructor (tuples,
/// primitives, vars) so they never match a generic impl.
export fn type_constructor_name(ty: Type) -> String {
  match ty {
    CtArray(_) => "Array",
    CtOption(_) => "Option",
    CtNamed(n, _) => n,
    CtStruct(n) => n,
    CtEnum(n) => n,
    _ => ""
  }
}

/// True iff `trait_name` declares at least one method (a method-bearing trait).
/// Marker traits (Eq/Ord/Add/…, declared `trait Eq` with no body) and undeclared
/// bound names (e.g. `Iterable`) return false. This is the soundness gate for
/// generic-impl resolution: a method-bearing trait dispatches through the threaded
/// witness dictionary (so a generic impl runs the correct per-type method),
/// whereas a marker trait "dispatches" via a builtin operator (`==`, `<`) that
/// does NOT structurally handle a container — so matching a marker-trait generic
/// impl would let `==` be used on e.g. `Option[Int]` where it silently misbehaves.
fn trait_is_method_bearing(env: TypeEnv, trait_name: String) -> Bool {
  match env {
    EnvEmpty => false,
    EnvBind(_, _, rest) => trait_is_method_bearing(rest, trait_name),
    EnvTraitDef(tname, _, _, methods, rest, _, _) => if tname == trait_name {
      Array::length(methods) > 0
    } else trait_is_method_bearing(rest, trait_name),
    EnvTraitImpl(_, _, rest) => trait_is_method_bearing(rest, trait_name),
    EnvMutCell(_, _, rest) => trait_is_method_bearing(rest, trait_name),
    EnvTraitImplGen(_, _, _, _, rest) => trait_is_method_bearing(rest, trait_name),
    EnvTypeDefs(_, _, rest) => trait_is_method_bearing(rest, trait_name),
    EnvFlat(_) => false,
    EnvCached(_, _, rest) => trait_is_method_bearing(rest, trait_name)
  }
}

// True iff a type-parameter bound list carries no real trait bound (only the
// empty / `""` sentinel entries). Increment A of generic-impl support matches
// the per-parameter trait bounds of a generic impl. Increment A (`impl [T]
// Trait for C`) has empty bounds; Increment B (`impl [T: Bound] Trait for
// C[T]`) carries them and is satisfied only when every type argument of the
// concrete type satisfies them — a dictionary-of-dictionaries: `C[K]: Trait`
// iff `K: Bound`.

/// Type arguments of a (possibly generic) type, for checking a generic impl's
/// per-parameter bounds against the concrete element types.
fn type_args_of(ty: Type) -> Array[Type] {
  match ty {
    CtArray(e) => Array::slice([
      e
    ], 0, 1),
    CtOption(e) => Array::slice([
      e
    ], 0, 1),
    CtNamed(_, args) => args,
    _ => array_empty()
  }
}

/// Does an in-env method-bearing generic impl `impl [T(: Bound)?] Trait for C`
/// cover the concrete `resolved` type? Matched by constructor name (the impl
/// target's args are erased); for a bounded impl, EVERY type argument of
/// `resolved` must satisfy EVERY bound (recursively via `type_implements_trait`),
/// which is the dictionary-of-dictionaries condition. The dict-passing desugar
/// synthesizes a `{ method: C::method }` witness (unbounded) or a nested closure
/// witness supplying the element dict (bounded). (#5 generic impls.)
fn generic_impl_satisfies(scan: TypeEnv, full: TypeEnv, s: Subst, trait_name: String, resolved: Type) -> Bool {
  match scan {
    EnvEmpty => false,
    EnvBind(_, _, rest) => generic_impl_satisfies(rest, full, s, trait_name, resolved),
    EnvTraitDef(_, _, _, _, rest, _, _) => generic_impl_satisfies(rest, full, s, trait_name, resolved),
    EnvTraitImpl(_, _, rest) => generic_impl_satisfies(rest, full, s, trait_name, resolved),
    EnvMutCell(_, _, rest) => generic_impl_satisfies(rest, full, s, trait_name, resolved),
    EnvTraitImplGen(itrait, _tparams, bounds, target, rest) => {
      let head = type_constructor_name(resolved)
      let shape_ok = itrait == trait_name && head != "" && type_constructor_name(target) == head && trait_is_method_bearing(full, trait_name)
      if shape_ok && generic_bounds_hold(full, s, bounds, type_args_of(resolved)) {
        true
      } else generic_impl_satisfies(rest, full, s, trait_name, resolved)
    },
    EnvTypeDefs(_, _, rest) => generic_impl_satisfies(rest, full, s, trait_name, resolved),
    EnvFlat(_) => false,
    EnvCached(_, _, rest) => generic_impl_satisfies(rest, full, s, trait_name, resolved)
  }
}

/// Every non-empty per-parameter bound is satisfied by every concrete type
/// argument. Empty bound lists (Increment A) hold trivially.
fn generic_bounds_hold(full: TypeEnv, s: Subst, bounds: Array[(String, Array[String])], args: Array[Type]) -> Bool {
  let mut bi = 0
  let mut ok = true
  while bi < Array::length(bounds) {
    let (_, btraits) = Array::get(bounds, bi)
    let mut ti = 0
    while ti < Array::length(btraits) {
      let bt = Array::get(btraits, ti)
      if bt != "" {
        let mut ai = 0
        while ai < Array::length(args) {
          // A still-unknown element type (e.g. a struct literal, which the
          // checker types as `CtUnknown`) defers its bound to the dict-passing
          // desugar — which infers the element type syntactically and either
          // threads the nested witness or fails loudly. This mirrors how a
          // `CtUnknown` receiver skips the top-level bound check, so accepting
          // it here is no less sound.
          match subst_apply(s, Array::get(args, ai)) {
            CtUnknown => (),
            _ => if not(type_implements_trait(full, s, Array::get(args, ai), bt)) {
              ok = false
            } else {
              ()
            }
          }
          ai = ai + 1
        }
      } else {
        ()
      }
      ti = ti + 1
    }
    bi = bi + 1
  }
  ok
}

export fn type_implements_trait(env: TypeEnv, s: Subst, ty: Type, trait_name: String) -> Bool {
  let resolved = subst_apply(s, ty)
  if type_implements_check_env(env, env, trait_name, resolved) {
    true
  }
  else if generic_impl_satisfies(env, env, s, trait_name, resolved) {
    true
  }
  else {
    // #1503 follow-up: this used to bail out when the BOUND trait had no
    // supertraits of its own, which is the wrong question -- what satisfies a
    // `[T: Base]` bound is an impl of some trait that has `Base` as a super,
    // and `Base` itself being a root trait is the normal case for that. The
    // guard made `trait Child: Base` + `impl Child for P` + `[T: Base]` report
    // `no impl Base for P` for EVERY type, parameterized or not (measured on a
    // plain struct), i.e. supertrait-satisfied bounds never worked at all.
    type_implements_check_super(env, env, s, trait_name, resolved)
  }
}
