import @vibe/core {
  hash_string
}

import ./env_name_index.vibe {
  env_name_index_at, env_name_index_find, env_name_index_is_sorted, env_name_index_length, env_name_index_new
}

test "cached names resolve to the first row ID, including hash collisions" {
  let index = env_name_index_new(["Aa", "Aa", "BB", "zz"])
  inspect(env_name_index_length(index), "4")
  inspect(env_name_index_find(index, "Aa"), "0")
  inspect(env_name_index_find(index, "BB"), "2")
  inspect(env_name_index_find(index, "missing"), "-1")
  inspect(env_name_index_at(index, 1), "Aa")
  inspect(env_name_index_is_sorted(index), "true")
}

test "the index owns its names and later caller mutations cannot change IDs" {
  let names = ["a", "b"]
  let index = env_name_index_new(names)
  Array::set(names, 0, "changed")
  Array::push(names, "extra")
  inspect(env_name_index_find(index, "a"), "0")
  inspect(env_name_index_find(index, "changed"), "-1")
  inspect(env_name_index_find(index, "extra"), "-1")
  inspect(env_name_index_length(index), "2")
}

test "empty and singleton indexes resolve without a hash table" {
  let empty = env_name_index_new([])
  inspect(env_name_index_find(empty, "x"), "-1")
  let single = env_name_index_new(["x"])
  inspect(env_name_index_find(single, "x"), "0")
  inspect(env_name_index_find(single, "y"), "-1")
}

test "malformed name order remains detectable by artifact validators" {
  let index = env_name_index_new(["z", "a"])
  inspect(env_name_index_is_sorted(index), "false")
  inspect(env_name_index_at(index, 0), "z")
  inspect(env_name_index_at(index, 1), "a")
}

test "repeated hits and misses do not allocate lookup results" {
  let index = env_name_index_new(["Aa", "BB", "a", "b", "c", "d", "e", "f"])
  let before = Profiler::heap_bytes()
  let mut total = 0
  let mut i = 0
  while i < 1000 {
    total = total + env_name_index_find(index, "BB")
    total = total + env_name_index_find(index, "missing")
    i = i + 1
  }
  let allocated = Profiler::heap_bytes() - before
  inspect(total, "0")
  inspect(allocated, "0")
}

fn colliding_name(bits: Int) -> String {
  let out = StringBuilder::new()
  StringBuilder::push(out, "b")
  let mut mask = 32
  while mask > 0 {
    StringBuilder::push(out, if (bits&mask) == 0 {
      "Aa"
    } else {
      "BB"
    })
    mask = mask / 2
  }
  StringBuilder::freeze(out)
}

test "collision chains wrap around the table and a colliding miss terminates" {
  // Equal-length Aa/BB words collide under the base-31 string hash. The b
  // prefix hashes to slot 125 in the 128-slot table; 63 rows force wrapping.
  inspect(hash_string(colliding_name(0))&127, "125")
  inspect(hash_string(colliding_name(63)) == hash_string(colliding_name(0)), "true")
  let names: Array[String] = []
  let mut i = 0
  while i < 63 {
    Array::push(names, colliding_name(i))
    i = i + 1
  }
  let index = env_name_index_new(names)
  inspect(env_name_index_is_sorted(index), "true")
  i = 0
  while i < 63 {
    // Rebuild the spelling so hits cannot depend on string identity.
    assert(env_name_index_find(index, colliding_name(i)) == i)
    i = i + 1
  }
  inspect(env_name_index_find(index, colliding_name(63)), "-1")
  inspect(env_name_index_length(index), "63")
}
