import @vibe/compiler/core {
  resolved_callee_operation, return_call_original, return_call_resolve, return_call_site
}

test "return call annotation preserves builtin and program authority" {
  for original in [[], [-1], [1], [15], [16], [17], [1, 2]] {
    let before = Array::slice(original, 0, Array::length(original))
    let annotated = return_call_resolve(original, 42)
    assert(return_call_site(annotated) == 42)
    assert(resolved_callee_operation(annotated) == resolved_callee_operation(original))
    assert(return_call_original(annotated) == before)
    assert(original == before)
    let again = return_call_resolve(annotated, 43)
    assert(return_call_site(again) == 43)
    assert(return_call_original(again) == before)
  }
}
test "ordinary resolved calls do not acquire unwind authority" {
  for original in [[], [-1], [1], [1, 2], [0, -361604]] {
    assert(return_call_site(original) == -1)
  }
}
