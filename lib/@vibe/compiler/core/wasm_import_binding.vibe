//# Imports

import @vibe/core {
  array_empty
}

import ./inline_wasm_marker.vibe {
  wat_callee_names
}

//# Functions

// `import ./z3.wasm { z3_mk_config }` -- a foreign CORE wasm module imported
// with the types its own binary declares.
//
// The loader does not parse a `.wasm` file as vibe source. It hands the bytes
// to `wasm_import_binding_source`, which reads the type, import, function and
// export sections and writes the binding module as vibe text. Every later
// phase -- header collection, the checker, `vibe check`, codegen -- sees an
// ordinary module, so the import list, `as` renames and "is not exported by"
// diagnostics behave exactly as they do for a `.vibe` file.
//
// Each exported function `F` with an admitted signature becomes two
// declarations:
//
//   fn wasm_raw_f(a0: Int, ..) -> Int = wasm "..(call $__wasm_import.<id> ..).."
//   export fn f(a0: Int, ..) -> R { wasm_raw_f(a0, ..) }
//
// The inline-wasm body converts between vibe's tagged `Int` and the core
// value types, and calls the foreign function through a core import whose
// module is `vibe:wasm:<path>` and whose field is the export's own name
// (`wasm_import_callee`). The codegen collects those callees from the
// inline-wasm bodies, emits one typed import per distinct callee, and a
// runner links the module at `<path>` under that name.
//
// The admitted signatures, and why the rest are refused rather than guessed:
//
//   - `i32` param and result: a `UInt32` (#3730), the unsigned reading of
//     the 32 bits, so a value outside it is a compile-time error. A
//     C-compiled module's `i32` mostly carries addresses, which stay
//     non-negative; a signed argument is `Int::wrap_uint32(n)`. (The memory
//     accessors below keep `Int`; the stub still traps an `Int` outside
//     -2^31 .. 2^32-1 there.)
//   - `i64` param: exact (a 63-bit `Int` sign-extends into 64 bits).
//   - `i64` result: TRAPS when the value needs the 64th bit, since a 63-bit
//     `Int` cannot hold it.
//   - no result: the wrapper returns `Unit`.
//   - `f32` / `f64` / `v128` / reference types / multiple results: not
//     offered. A `Double` is a boxed value on the linear lane, and no
//     inline-wasm boundary for it exists yet; the binding lists these exports
//     in a comment instead of exposing a wrong type.
//
// A module whose memory a runner can reach -- an exported one, or an
// imported one the host supplies -- additionally gets
// `wasm_memory_load_u8(addr) -> Int`, `wasm_memory_store_u8(addr, value)` and
// `wasm_memory_size() -> Int` (bytes). The foreign memory is not this
// module's memory; these go through runner-provided `vibe:memory.*` fields of
// a separate import module, `vibe:wasm-memory:<path>` (so no export of the
// module can collide with them), which is how a binding passes strings to and
// from the foreign side.
//
// Export names are mapped to vibe identifiers by lower-casing ASCII letters
// and replacing every other character outside `[a-z0-9_]` with `_`
// (`Z3_mk_config` -> `z3_mk_config`). Two exports that map to the same name
// are BOTH withheld (listed in the comment) rather than one silently winning.

/// Is `path` a foreign core-wasm import (`import ./x.wasm { .. }`)?
export fn is_wasm_import_path(_ path: String) -> Bool {
  String::ends_with(path, suffix = ".wasm")
}

/// The core import module a binding of `path` calls through.
export fn wasm_import_module_name(_ path: String) -> String {
  String::concat("vibe:wasm:", path)
}

/// The core import module the memory accessors of `path` call through. It is
/// NOT the module's own namespace: a foreign export may be named anything,
/// including `vibe:memory.size`, and an accessor defined beside it would
/// replace the export the binding offers under that name.
export fn wasm_memory_module_name(_ path: String) -> String {
  String::concat("vibe:wasm-memory:", path)
}

fn wib_fresh_strings() -> Array[String] {
  array_empty()
}

fn wib_fresh_ints() -> Array[Int] {
  array_empty()
}

fn wib_fresh_sigs() -> Array[(Array[Int], Array[Int])] {
  array_empty()
}

fn wib_hex_digit(_ n: Int) -> String {
  "0123456789abcdef"[n: n + 1]
}

/// Lower-case hex of every byte of `s`. A module path and an export name may
/// hold any byte, and the inline-wasm tokenizer ends a word at whitespace,
/// `(`, `)` and `;`; hex keeps the callee one word whatever they contain.
export fn wasm_import_hex(_ s: String) -> String {
  let mut out = ""
  let mut i = 0
  while i < String::length(s) {
    let b = String::byte_at(s, at = i)
    out = String::concat(out, String::concat(wib_hex_digit(b>>4), wib_hex_digit(b&15)))
    i = i + 1
  }
  out
}

fn wib_hex_value(_ c: Int) -> Int {
  if c >= 48 && c <= 57 {
    c - 48
  } else if c >= 97 && c <= 102 {
    c - 87
  } else {
    -1
  }
}

/// The inverse of `wasm_import_hex`; `None` when `s` is not lower-case hex
/// of an even length.
export fn wasm_import_unhex(_ s: String) -> Option[String] {
  let n = String::length(s)
  if n % 2 != 0 {
    None
  } else {
    let mut out = ""
    let mut ok = true
    let mut i = 0
    while ok && i < n {
      let hi = wib_hex_value(String::byte_at(s, at = i))
      let lo = wib_hex_value(String::byte_at(s, at = i + 1))
      if hi < 0 || lo < 0 {
        ok = false
      } else {
        out = String::concat(out, String::from_byte(hi * 16 + lo))
      }
      i = i + 2
    }
    if ok {
      Some(out)
    } else {
      None
    }
  }
}

/// The signature spelling a callee carries: one letter per param (`i` = i32,
/// `I` = i64), `_`, then the result letter or nothing. `(i32, i64) -> i32`
/// is `iI_i`; `() -> ()` is `_`.
export fn wasm_import_sig_text(params: Array[Int], results: Array[Int]) -> String {
  let mut out = ""
  for p in params {
    out = String::concat(out, wib_valtype_letter(p))
  }
  out = String::concat(out, "_")
  for r in results {
    out = String::concat(out, wib_valtype_letter(r))
  }
  out
}

fn wib_valtype_letter(_ vt: Int) -> String {
  if vt == 0x7F {
    "i"
  } else if vt == 0x7E {
    "I"
  } else {
    "?"
  }
}

/// The inline-wasm callee that names one foreign function:
/// `__wasm_import.<hex module>.<hex field>.<sig>`.
export fn wasm_import_callee(module_name: String, field: String, params: Array[Int], results: Array[Int]) -> String {
  String::concat("__wasm_import.", String::concat(wasm_import_hex(module_name), String::concat(".", String::concat(wasm_import_hex(field), String::concat(".", wasm_import_sig_text(params = params, results = results))))))
}

/// The callee prefix every foreign-function call in an inline-wasm body
/// starts with.
export fn wasm_import_callee_prefix() -> String {
  "__wasm_import."
}

/// Decode a callee minted by `wasm_import_callee` into
/// `(module, field, params, results)` valtype codes. `None` for anything
/// else -- including a signature letter that is not `i` / `I`, so a
/// hand-written callee cannot ask for a type the conversion does not cover.
export fn wasm_import_decode_callee(_ callee: String) -> Option[(String, String, Array[Int], Array[Int])] {
  let prefix = wasm_import_callee_prefix()
  if !String::starts_with(callee, prefix = prefix) {
    None
  } else {
    let rest = String::substring(callee, start = String::length(prefix), end = String::length(callee))
    let d1 = String::index_of(rest, needle = ".")
    if d1 < 0 {
      None
    } else {
      let after1 = String::substring(rest, start = d1 + 1, end = String::length(rest))
      let d2 = String::index_of(after1, needle = ".")
      if d2 < 0 {
        None
      } else {
        let sig = String::substring(after1, start = d2 + 1, end = String::length(after1))
        match (wasm_import_unhex(String::substring(rest, start = 0, end = d1)), wasm_import_unhex(String::substring(after1, start = 0, end = d2))) {
          (Some(m), Some(f)) => match wib_decode_sig(sig) {
            Some((ps, rs)) => Some((m, f, ps, rs)),
            None => None
          },
          _ => None
        }
      }
    }
  }
}

fn wib_decode_sig(_ sig: String) -> Option[(Array[Int], Array[Int])] {
  let us = String::index_of(sig, needle = "_")
  if us < 0 {
    None
  } else {
    let ps = wib_fresh_ints()
    let rs = wib_fresh_ints()
    let mut ok = true
    let mut i = 0
    while i < String::length(sig) {
      if i != us {
        let c = String::byte_at(sig, at = i)
        let vt = if c == 105 {
          0x7F
        } else if c == 73 {
          0x7E
        } else {
          0
        }
        if vt == 0 {
          ok = false
        } else if i < us {
          Array::push(ps, value = vt)
        } else {
          Array::push(rs, value = vt)
        }
      } else {
        ()
      }
      i = i + 1
    }
    if ok && Array::length(rs) <= 1 && String::index_of(String::substring(sig, start = us + 1, end = String::length(sig)), needle = "_") < 0 {
      Some((ps, rs))
    } else {
      None
    }
  }
}

/// Every distinct foreign-function callee the inline-wasm bodies `wats`
/// call, sorted, so the import indices the codegen reserves for them do not
/// depend on declaration order.
export fn wasm_import_callees_in(_ wats: Array[String]) -> Array[String] {
  let found = wib_fresh_strings()
  // A body that does not spell the prefix calls no foreign function; skip it
  // before wat_callee_names allocates its callee list (the compiler's own
  // inline-wasm kernels, on every compile).
  let marker = String::concat("$", wasm_import_callee_prefix())
  for wat in wats {
    let names = if String::contains(wat, needle = marker) {
      wat_callee_names(wat)
    } else {
      wib_fresh_strings()
    }
    for name in names {
      if wib_is_foreign_callee(name) {
        let mut seen = false
        for f in found {
          if f == name {
            seen = true
          } else {
            ()
          }
        }
        if !seen {
          Array::push(found, value = name)
        } else {
          ()
        }
      } else {
        ()
      }
    }
  }
  // Insertion sort: a module imports a handful of foreign functions, and the
  // byte order of the callee spelling is all that is needed.
  let n = Array::length(found)
  let mut i = 1
  while i < n {
    let mut j = i
    while j > 0 && wib_str_lt(a = Array::get(found, at = j), b = Array::get(found, at = j - 1)) {
      let t = Array::get(found, at = j)
      Array::set(found, at = j, value = Array::get(found, at = j - 1))
      Array::set(found, at = j - 1, value = t)
      j = j - 1
    }
    i = i + 1
  }
  found
}

fn wib_is_foreign_callee(_ name: String) -> Bool {
  match wasm_import_decode_callee(name) {
    Some(_) => true,
    None => false
  }
}

/// Byte-wise `a < b` (see CLAUDE.md on why `String <` is not used here).
fn wib_str_lt(a: String, b: String) -> Bool {
  let la = String::length(a)
  let lb = String::length(b)
  let mut i = 0
  let mut res = la < lb
  let mut decided = false
  while !decided && i < la && i < lb {
    let ca = String::byte_at(a, at = i)
    let cb = String::byte_at(b, at = i)
    if ca != cb {
      res = ca < cb
      decided = true
    } else {
      i = i + 1
    }
  }
  res
}

// ---------------------------------------------------------------------------
// Binary reading

fn wib_byte(bytes: Bytes, pos: Int) -> Int with Exception {
  if pos < 0 || pos >= Bytes::length(bytes) {
    throw("truncated wasm binary (read past byte \{pos})")
  } else {
    Bytes::get(bytes, at = pos)
  }
}

/// Unsigned LEB128 at `pos`: `(value, next position)`. Values wider than 62
/// bits are refused instead of wrapping into a different number.
fn wib_leb_u(bytes: Bytes, pos: Int) -> (Int, Int) with Exception {
  let mut result = 0
  let mut shift = 0
  let mut p = pos
  let mut more = true
  while more {
    let b = wib_byte(bytes = bytes, pos = p)
    if shift >= 62 {
      throw("malformed wasm binary: LEB128 at byte \{pos} is too wide")
    } else {
      ()
    }
    result = result|((b&0x7F)<<shift)
    shift = shift + 7
    p = p + 1
    more = (b&0x80) != 0
  }
  (result, p)
}

fn wib_name(bytes: Bytes, pos: Int) -> (String, Int) with Exception {
  let (len, p) = wib_leb_u(bytes = bytes, pos = pos)
  if p + len > Bytes::length(bytes) {
    throw("truncated wasm binary (a name at byte \{pos} runs past the end)")
  } else {
    let parts = wib_fresh_strings()
    let mut i = p
    while i < p + len {
      Array::push(parts, value = String::from_byte(Bytes::get(bytes, at = i)))
      i = i + 1
    }
    (String::join(parts, sep = ""), p + len)
  }
}

/// Skip a value type, including the multi-byte reference forms
/// (`(ref null? <heaptype>)`, 0x63 / 0x64 + s33 heap type).
fn wib_skip_valtype(bytes: Bytes, pos: Int) -> Int with Exception {
  let b = wib_byte(bytes = bytes, pos = pos)
  if b == 0x63 || b == 0x64 {
    let (_, p) = wib_leb_u(bytes = bytes, pos = pos + 1)
    p
  } else {
    pos + 1
  }
}

fn wib_skip_limits(bytes: Bytes, pos: Int) -> Int with Exception {
  let flags = wib_byte(bytes = bytes, pos = pos)
  let (_, p1) = wib_leb_u(bytes = bytes, pos = pos + 1)
  if (flags&1) != 0 {
    let (_, p2) = wib_leb_u(bytes = bytes, pos = p1)
    p2
  } else {
    p1
  }
}

/// `(params, results)` for every type in the type section; a non-function
/// form (a GC struct / array type, a rec group) gets an entry whose params
/// hold `-1`, so a function of that type is reported as not offered instead
/// of misread.
fn wib_parse_types(bytes: Bytes, start: Int) -> Array[(Array[Int], Array[Int])] with Exception {
  let out = wib_fresh_sigs()
  let (count, p0) = wib_leb_u(bytes = bytes, pos = start)
  let mut p = p0
  let mut i = 0
  while i < count {
    let form = wib_byte(bytes = bytes, pos = p)
    if form != 0x60 {
      // Anything else changes how the rest of the section is laid out, and
      // this reader does not follow those layouts: stop here. Types past
      // this point resolve to "unknown type" below.
      i = count
    } else {
      let ps = wib_fresh_ints()
      let rs = wib_fresh_ints()
      let (np, pp) = wib_leb_u(bytes = bytes, pos = p + 1)
      let mut q = pp
      let mut k = 0
      while k < np {
        let vt = wib_byte(bytes = bytes, pos = q)
        Array::push(ps, value = vt)
        q = wib_skip_valtype(bytes = bytes, pos = q)
        k = k + 1
      }
      let (nr, rp) = wib_leb_u(bytes = bytes, pos = q)
      q = rp
      k = 0
      while k < nr {
        let vt = wib_byte(bytes = bytes, pos = q)
        Array::push(rs, value = vt)
        q = wib_skip_valtype(bytes = bytes, pos = q)
        k = k + 1
      }
      Array::push(out, value = (ps, rs))
      p = q
      i = i + 1
    }
  }
  out
}

/// What the binding needs from a core module: the type of each function in
/// the function index space (imports first), the exported functions as
/// `(name, function index)`, and whether the module has a memory.
fn wib_read_module(_ bytes: Bytes) -> (Array[(Array[Int], Array[Int])], Array[Int], Array[(String, Int)], Bool) with Exception {
  let n0 = Bytes::length(bytes)
  if n0 < 8 || Bytes::get(bytes, at = 0) != 0 || Bytes::get(bytes, at = 1) != 97 || Bytes::get(bytes, at = 2) != 115 || Bytes::get(bytes, at = 3) != 109 {
    throw("not a wasm binary (missing the \\0asm header)")
  } else if Bytes::get(bytes, at = 4) != 1 || Bytes::get(bytes, at = 5) != 0 || Bytes::get(bytes, at = 6) != 0 || Bytes::get(bytes, at = 7) != 0 {
    if Bytes::get(bytes, at = 4) == 0x0D && Bytes::get(bytes, at = 6) == 1 {
      throw("unsupported wasm component layer (only layer 1, binary version 0x0d, is read)")
    } else {
      throw("unsupported wasm binary version (only core wasm version 1 is read)")
    }
  } else {
    ()
  }
  let mut types = wib_fresh_sigs()
  let func_types = wib_fresh_ints()
  let exports: Array[(String, Int)] = []
  let mut has_memory = false
  let mut p = 8
  let n = n0
  while p < n {
    let id = wib_byte(bytes = bytes, pos = p)
    let (size, body) = wib_leb_u(bytes = bytes, pos = p + 1)
    let end = body + size
    if end > n {
      throw("truncated wasm binary (section \{id} runs past the end)")
    } else {
      ()
    }
    if id == 1 {
      types = wib_parse_types(bytes = bytes, start = body)
    } else if id == 2 {
      let (count, p0) = wib_leb_u(bytes = bytes, pos = body)
      let mut q = p0
      let mut i = 0
      while i < count {
        let (_, q1) = wib_name(bytes = bytes, pos = q)
        let (_, q2) = wib_name(bytes = bytes, pos = q1)
        let kind = wib_byte(bytes = bytes, pos = q2)
        if kind == 0 {
          let (ti, q3) = wib_leb_u(bytes = bytes, pos = q2 + 1)
          Array::push(func_types, value = ti)
          q = q3
        } else if kind == 1 {
          q = wib_skip_limits(bytes = bytes, pos = wib_skip_valtype(bytes = bytes, pos = q2 + 1))
        } else if kind == 2 {
          has_memory = true
          q = wib_skip_limits(bytes = bytes, pos = q2 + 1)
        } else if kind == 3 {
          q = wib_skip_valtype(bytes = bytes, pos = q2 + 1) + 1
        } else if kind == 4 {
          let (_, q3) = wib_leb_u(bytes = bytes, pos = q2 + 2)
          q = q3
        } else {
          throw("malformed wasm binary: unknown import kind \{kind}")
        }
        i = i + 1
      }
    } else if id == 3 {
      let (count, p0) = wib_leb_u(bytes = bytes, pos = body)
      let mut q = p0
      let mut i = 0
      while i < count {
        let (ti, q1) = wib_leb_u(bytes = bytes, pos = q)
        Array::push(func_types, value = ti)
        q = q1
        i = i + 1
      }
    } else if id == 5 {
      // A DEFINED memory alone does not count: the runner reaches a foreign
      // memory only through the module's exports (or, for an imported one,
      // because the host supplied it), so the accessors would link to nothing.
      ()
    } else if id == 7 {
      let (count, p0) = wib_leb_u(bytes = bytes, pos = body)
      let mut q = p0
      let mut i = 0
      while i < count {
        let (nm, q1) = wib_name(bytes = bytes, pos = q)
        let kind = wib_byte(bytes = bytes, pos = q1)
        let (idx, q2) = wib_leb_u(bytes = bytes, pos = q1 + 1)
        if kind == 0 {
          Array::push(exports, value = (nm, idx))
        } else if kind == 2 {
          has_memory = true
        } else {
          ()
        }
        q = q2
        i = i + 1
      }
    } else {
      ()
    }
    p = end
  }
  let fn_sigs = wib_fresh_sigs()
  for ti in func_types {
    if ti < Array::length(types) {
      Array::push(fn_sigs, value = Array::get(types, at = ti))
    } else {
      Array::push(fn_sigs, value = ([-1], wib_fresh_ints()))
    }
  }
  (fn_sigs, func_types, exports, has_memory)
}

// ---------------------------------------------------------------------------
// Naming

/// Words an offered name must not be spelled as. Every hard keyword of
/// `keyword_lookup` (lib/@vibe/parser/lexer.vibe) is here --
/// tests/wasm_import_binding_test.vibe reads that function's spellings and
/// fails on one this list misses -- plus soft keywords that would read as
/// syntax in a declaration position.
fn wib_reserved_words() -> Array[String] {
  [
    "fn",
    "let",
    "mut",
    "rec",
    "if",
    "else",
    "match",
    "while",
    "for",
    "in",
    "loop",
    "break",
    "continue",
    "return",
    "true",
    "false",
    "with",
    "handle",
    "perform",
    "resume",
    "effect",
    "effectset",
    "test",
    "example",
    "bench",
    "enum",
    "struct",
    "trait",
    "impl",
    "type",
    "opaque",
    "import",
    "export",
    "module",
    "extern",
    "internal",
    "as",
    "only",
    "where",
    "requires",
    "ensures",
    "is",
    "guard",
    "resource",
    "suberror",
    "throw",
    "await",
    "async",
    "region",
    "self",
    "wasm",
    "and",
    "or",
    "not",
    "do",
    "open",
    "raise",
    "yield",
    "derive",
    "declare",
    "taskgroup"
  ]
}

/// The vibe identifier an export is offered under, or "" when none can be
/// formed (an empty name, or one that maps to the wildcard `_`).
export fn wasm_import_vibe_name(_ export_name: String) -> String {
  let mut out = ""
  let mut i = 0
  while i < String::length(export_name) {
    let c = String::byte_at(export_name, at = i)
    let mapped = if c >= 65 && c <= 90 {
      c + 32
    } else if (c >= 97 && c <= 122) || (c >= 48 && c <= 57) || c == 95 {
      c
    } else {
      95
    }
    out = String::concat(out, String::from_byte(mapped))
    i = i + 1
  }
  if out == "" || out == "_" {
    ""
  } else {
    let first = String::byte_at(out, at = 0)
    let led = if first >= 48 && first <= 57 {
      String::concat("_", out)
    } else {
      out
    }
    let mut reserved = false
    for w in wib_reserved_words() {
      if w == led {
        reserved = true
      } else {
        ()
      }
    }
    if reserved {
      String::concat(led, "_")
    } else {
      led
    }
  }
}

fn wib_sig_admitted(params: Array[Int], results: Array[Int]) -> Bool {
  let mut ok = Array::length(results) <= 1
  for p in params {
    if p != 0x7F && p != 0x7E {
      ok = false
    } else {
      ()
    }
  }
  for r in results {
    if r != 0x7F && r != 0x7E {
      ok = false
    } else {
      ()
    }
  }
  ok
}

fn wib_valtype_wat(_ vt: Int) -> String {
  if vt == 0x7F {
    "i32"
  } else if vt == 0x7E {
    "i64"
  } else if vt == 0x7D {
    "f32"
  } else if vt == 0x7C {
    "f64"
  } else if vt == 0x7B {
    "v128"
  } else if vt < 0 {
    "<unknown type>"
  } else {
    "ref"
  }
}

fn wib_sig_wat(params: Array[Int], results: Array[Int]) -> String {
  let mut ps = ""
  let mut i = 0
  while i < Array::length(params) {
    ps = String::concat(ps, String::concat(if i > 0 {
      ", "
    } else {
      ""
    }, wib_valtype_wat(Array::get(params, at = i))))
    i = i + 1
  }
  let mut rs = ""
  let mut j = 0
  while j < Array::length(results) {
    rs = String::concat(rs, String::concat(if j > 0 {
      ", "
    } else {
      ""
    }, wib_valtype_wat(Array::get(results, at = j))))
    j = j + 1
  }
  "(\{ps}) -> (\{rs})"
}

// ---------------------------------------------------------------------------
// Emission

/// The number an `Int` param holds. `vibe.int.untag` assembles to the
/// compiling lane's representation (a shift on RC, nothing on bump), so the
/// synthesized text is right on both.
fn wib_untag(_ param: String) -> String {
  "(vibe.int.untag (local.get $\{param}))"
}

/// The inline-wasm body for one foreign function.
fn wib_body(callee: String, params: Array[Int], results: Array[Int]) -> String {
  let mut checks = ""
  let mut args = ""
  let mut i = 0
  while i < Array::length(params) {
    let pn = "a\{i}"
    if Array::get(params, at = i) == 0x7F {
      checks = String::concat(checks, "(if (i64.lt_s \{wib_untag(pn)} (i64.const -2147483648)) (then unreachable)) (if (i64.gt_s \{wib_untag(pn)} (i64.const 4294967295)) (then unreachable)) ")
      args = String::concat(args, " (i32.wrap_i64 \{wib_untag(pn)})")
    } else {
      args = String::concat(args, " \{wib_untag(pn)}")
    }
    i = i + 1
  }
  let call = "(call $\{callee}\{args})"
  if Array::length(results) == 0 {
    "\{checks}\{call} (i64.const 0)"
  } else if Array::get(results, at = 0) == 0x7F {
    // Read unsigned: the wrapper offers the result as `UInt32` (#3730).
    "\{checks}(vibe.int.tag (i64.extend_i32_u \{call}))"
  } else {
    "(local $r i64) \{checks}(local.set $r \{call}) (if (i64.ne (i64.shr_s (i64.shl (local.get $r) (i64.const 1)) (i64.const 1)) (local.get $r)) (then unreachable)) (vibe.int.tag (local.get $r))"
  }
}

fn wib_param_list(_ n: Int) -> String {
  let mut out = ""
  let mut i = 0
  while i < n {
    out = String::concat(out, String::concat(if i > 0 {
      ", "
    } else {
      ""
    }, "_ a\{i}: Int"))
    i = i + 1
  }
  out
}

/// A doc-comment-safe rendering of an export name: bytes outside printable
/// ASCII, and the backtick, are shown as `\xNN`.
fn wib_display_name(_ name: String) -> String {
  let mut out = ""
  let mut i = 0
  while i < String::length(name) {
    let c = String::byte_at(name, at = i)
    if c >= 32 && c < 127 && c != 96 && c != 92 {
      out = String::concat(out, String::from_byte(c))
    } else {
      out = String::concat(out, String::concat("\\x", String::concat(wib_hex_digit(c>>4), wib_hex_digit(c&15))))
    }
    i = i + 1
  }
  out
}

/// The prefix of this binding module's private stubs: `wasm_raw_`, with
/// `_` appended until no public name in `public` starts with it. A private
/// name is the prefix plus a public name, so it can equal neither another
/// private one nor any public declaration -- an export called `wasm_raw_foo`
/// next to `foo` gets the stub `wasm_raw__foo` instead of sharing one name.
fn wib_private_prefix(_ public: Array[String]) -> String {
  let mut prefix = "wasm_raw_"
  let mut clash = true
  while clash {
    clash = false
    for nm in public {
      if String::starts_with(nm, prefix = prefix) {
        clash = true
      } else {
        ()
      }
    }
    if clash {
      prefix = String::concat(prefix, "_")
    } else {
      ()
    }
  }
  prefix
}

/// #3730: a core `i32` is offered as `UInt32`, the unsigned reading of its
/// 32 bits, so the width is the type: a value that does not fit is a
/// compile-time error at the call, not the stub's trap. Addresses -- what most
/// `i32` parameters of a C-compiled module carry -- stay non-negative; a
/// signed argument is passed as `Int::wrap_uint32(n)`. An `i64` stays `Int`.
/// The raw stub keeps `Int` for every value: the wrapper widens a `UInt32`
/// argument exactly, and keeps the low 32 bits of a result the stub already
/// read unsigned, which is exact. The runner-served memory accessors keep
/// `Int` (`typed = false`): an address or a byte as a plain integer, the
/// signature `lib/@vibex/z3/cstring.vibe` and the cheatsheet document.
fn wib_emit_fn(out: Array[String], raw: String, vibe_name: String, doc: String, callee: String, params: Array[Int], results: Array[Int], typed: Bool) -> Unit {
  let n = Array::length(params)
  let wrap_params = wib_fresh_strings()
  let wrap_args = wib_fresh_strings()
  let mut i = 0
  while i < n {
    if typed && Array::get(params, at = i) == 0x7F {
      Array::push(wrap_params, value = "_ a\{i}: UInt32")
      Array::push(wrap_args, value = "UInt32::to_int(a\{i})")
    } else {
      Array::push(wrap_params, value = "_ a\{i}: Int")
      Array::push(wrap_args, value = "a\{i}")
    }
    i = i + 1
  }
  let call = "\{raw}\{vibe_name}(\{String::join(wrap_args, sep = ", ")})"
  let ps = String::join(wrap_params, sep = ", ")
  Array::push(out, value = "/// \{doc}\n")
  Array::push(out, value = "fn \{raw}\{vibe_name}(\{wib_param_list(n)}) -> Int = wasm \"\{wib_body(callee = callee, params = params, results = results)}\"\n")
  if Array::length(results) == 0 {
    Array::push(out, value = "export fn \{vibe_name}(\{ps}) -> Unit {\n  let _ = \{call}\n  ()\n}\n\n")
  } else if typed && Array::get(results, at = 0) == 0x7F {
    Array::push(out, value = "export fn \{vibe_name}(\{ps}) -> UInt32 {\n  Int::wrap_uint32(\{call})\n}\n\n")
  } else {
    Array::push(out, value = "export fn \{vibe_name}(\{ps}) -> Int {\n  \{call}\n}\n\n")
  }
}

/// The vibe source of the binding module for the core wasm binary `bytes`
/// at `path`. Throws a located-by-path message when the binary cannot be
/// read.
export fn wasm_import_binding_source(path: String, bytes: Bytes) -> String with Exception {
  if wib_is_component(bytes) {
    wib_component_binding_source(path = path, bytes = bytes)
  } else {
    wib_core_binding_source(path = path, bytes = bytes)
  }
}

fn wib_is_component(_ bytes: Bytes) -> Bool {
  Bytes::length(bytes) >= 8 && Bytes::get(bytes, at = 0) == 0 && Bytes::get(bytes, at = 1) == 97 && Bytes::get(bytes, at = 2) == 115 && Bytes::get(bytes, at = 3) == 109 && Bytes::get(bytes, at = 4) == 0x0D && Bytes::get(bytes, at = 5) == 0 && Bytes::get(bytes, at = 6) == 1 && Bytes::get(bytes, at = 7) == 0
}

fn wib_core_binding_source(path: String, bytes: Bytes) -> String with Exception {
  let (fn_sigs, _, exports, has_memory) = handle {
    wib_read_module(bytes)
  } with { Exception::Throw(msg) => throw("cannot import \{path}: \{msg}") }
  let module_name = wasm_import_module_name(path)
  let names = wib_fresh_strings()
  for ex in exports {
    let (nm, _) = ex
    Array::push(names, value = wasm_import_vibe_name(nm))
  }
  let mem_names = [
    "wasm_memory_load_u8",
    "wasm_memory_store_u8",
    "wasm_memory_size"
  ]
  let public = wib_fresh_strings()
  for nm in names {
    Array::push(public, value = nm)
  }
  for m in mem_names {
    Array::push(public, value = m)
  }
  let raw = wib_private_prefix(public)
  let out = wib_fresh_strings()
  let withheld = wib_fresh_strings()
  Array::push(out, value = "// Bindings synthesized from the core wasm module \{wib_display_name(path)}.\n// Imports resolve through `\{wib_display_name(module_name)}`.\n\n")
  let mut i = 0
  while i < Array::length(exports) {
    let (nm, fidx) = Array::get(exports, at = i)
    let vn = Array::get(names, at = i)
    let mut dup = false
    let mut j = 0
    while j < Array::length(names) {
      if j != i && Array::get(names, at = j) == vn {
        dup = true
      } else {
        ()
      }
      j = j + 1
    }
    for m in mem_names {
      if has_memory && m == vn {
        dup = true
      } else {
        ()
      }
    }
    let (ps, rs) = if fidx < Array::length(fn_sigs) {
      Array::get(fn_sigs, at = fidx)
    } else {
      ([-1], wib_fresh_ints())
    }
    let shown = wib_display_name(nm)
    if vn == "" {
      Array::push(withheld, value = "`\{shown}`: no vibe identifier can be formed from the name")
    } else if dup {
      Array::push(withheld, value = "`\{shown}`: its vibe name `\{vn}` is shared with another export")
    } else if !wib_sig_admitted(params = ps, results = rs) {
      Array::push(withheld, value = "`\{shown}` \{wib_sig_wat(params = ps, results = rs)}: only i32 / i64 params and at most one i32 / i64 result cross the boundary")
    } else {
      wib_emit_fn(out = out, raw = raw, vibe_name = vn, doc = "`\{shown}` from \{wib_display_name(path)}: core wasm \{wib_sig_wat(params = ps, results = rs)}.", callee = wasm_import_callee(module_name = module_name, field = nm, params = ps, results = rs), params = ps, results = rs, typed = true)
    }
    i = i + 1
  }
  if has_memory {
    wib_emit_fn(out = out, raw = raw, vibe_name = "wasm_memory_load_u8", doc = "The byte at `a0` in the module's memory (0..255).", callee = wasm_import_callee(module_name = wasm_memory_module_name(path), field = "vibe:memory.load8_u", params = [
      0x7F
    ], results = [0x7F]), params = [0x7F], results = [0x7F], typed = false)
    wib_emit_fn(out = out, raw = raw, vibe_name = "wasm_memory_store_u8", doc = "Store the low 8 bits of `a1` at `a0` in the module's memory.", callee = wasm_import_callee(module_name = wasm_memory_module_name(path), field = "vibe:memory.store8", params = [
      0x7F,
      0x7F
    ], results = wib_fresh_ints()), params = [0x7F, 0x7F], results = wib_fresh_ints(), typed = false)
    wib_emit_fn(out = out, raw = raw, vibe_name = "wasm_memory_size", doc = "The module's memory size in bytes.", callee = wasm_import_callee(module_name = wasm_memory_module_name(path), field = "vibe:memory.size", params = wib_fresh_ints(), results = [
      0x7E
    ]), params = wib_fresh_ints(), results = [0x7E], typed = false)
  } else {
    ()
  }
  if Array::length(withheld) > 0 {
    Array::push(out, value = "// Exports not offered:\n")
    for w in withheld {
      Array::push(out, value = String::concat("//   ", String::concat(w, "\n")))
    }
  } else {
    ()
  }
  String::join(out, sep = "")
}

/// The first line of the text a failed synthesis returns instead of a
/// binding. It is a comment, so a lane that does not look for it still
/// parses an empty module (and reports the imported names as not exported);
/// the loader lanes look for it and refuse the import with the message.
export fn wasm_import_error_marker() -> String {
  "//! vibe-wasm-import-error: "
}

/// `wasm_import_binding_source` for a read path that cannot throw: the
/// failure comes back as `wasm_import_error_marker()` + the message.
export fn wasm_import_binding_source_or_error(path: String, bytes: Bytes) -> String {
  handle {
    wasm_import_binding_source(path = path, bytes = bytes)
  } with { Exception::Throw(msg) => String::concat(wasm_import_error_marker(), String::concat(msg, "\n")) }
}

/// The message of a failed synthesis, if `text` is one.
export fn wasm_import_error_in(_ text: String) -> Option[String] {
  let marker = wasm_import_error_marker()
  if String::starts_with(text, prefix = marker) {
    let nl = String::index_of(text, needle = "\n")
    let stop = if nl < 0 {
      String::length(text)
    } else {
      nl
    }
    Some(String::substring(text, start = String::length(marker), end = stop))
  } else {
    None
  }
}

/// Throw the message of a failed `.wasm` synthesis (see
/// `wasm_import_binding_source_or_error`); any other text passes.
export fn refuse_failed_wasm_import(_ text: String) -> Unit with Exception {
  match wasm_import_error_in(text) {
    Some(msg) => throw(msg),
    None => ()
  }
}

// ---------------------------------------------------------------------------
// Components (`import ./greeter.component.wasm { greet }`)
//
// A component's exported functions are typed by its component type section,
// in WIT terms, so the binding takes their types from there instead of from
// core valtypes. What is read, and what is refused rather than guessed:
//
//   - world-level function exports (`export greet: func(..)`); an exported
//     INTERFACE (an instance) is listed as not offered;
//   - params and result of `s8`..`u64` -> `Int`, `string` -> `String`, and no
//     result -> `Unit`. Everything else (bool, char, floats, lists, records,
//     variants, resources, ...) is not offered yet;
//   - the type / func index spaces are followed through the type, canon,
//     alias, import and export sections. A form this reader does not follow
//     (a component or instance type -- what an imported interface declares --
//     or an unknown canon or type form) stops it, and every function typed
//     after that point is listed as not offered.
//
// The call itself goes through a core import of module `vibe:component:<path>`
// whose field is the export's name: Int params pass untagged, a string passes
// as the raw Bytes object pointer of its bytes, and an Int / string result
// comes back as an untagged i64 / packed string. The runner instantiates the
// component and does the canonical-ABI lifting and lowering on the program's
// behalf -- including the range check of each Int against its WIT width.

/// The core import module a component binding of `path` calls through.
export fn wasm_component_module_name(_ path: String) -> String {
  String::concat("vibe:component:", path)
}

/// WIT name of a primitive component valtype code, or "" for anything else.
fn wib_cv_name(_ code: Int) -> String {
  if code == 0x7f {
    "bool"
  } else if code == 0x7e {
    "s8"
  } else if code == 0x7d {
    "u8"
  } else if code == 0x7c {
    "s16"
  } else if code == 0x7b {
    "u16"
  } else if code == 0x7a {
    "s32"
  } else if code == 0x79 {
    "u32"
  } else if code == 0x78 {
    "s64"
  } else if code == 0x77 {
    "u64"
  } else if code == 0x76 {
    "f32"
  } else if code == 0x75 {
    "f64"
  } else if code == 0x74 {
    "char"
  } else if code == 0x73 {
    "string"
  } else {
    ""
  }
}

fn wib_cv_is_int(_ code: Int) -> Bool {
  code >= 0x77 && code <= 0x7e
}

fn wib_cv_admitted(_ code: Int) -> Bool {
  wib_cv_is_int(code) || code == 0x73
}

/// A valtype: a primitive code (0x64..0x7f), or 0x100 + a type index.
fn wib_read_cvaltype(bytes: Bytes, pos: Int) -> (Int, Int) with Exception {
  let b = wib_byte(bytes = bytes, pos = pos)
  if b >= 0x64 && b <= 0x7f {
    (b, pos + 1)
  } else {
    let (idx, p) = wib_leb_u(bytes = bytes, pos = pos)
    (0x100 + idx, p)
  }
}

fn wib_cv_show(_ code: Int) -> String {
  let n = wib_cv_name(code)
  if n != "" {
    n
  } else if code >= 0x100 {
    "<type \{code - 0x100}>"
  } else {
    "<type form 0x\{wib_hex_digit((code >> 4) & 15)}\{wib_hex_digit(code & 15)}>"
  }
}

/// A component export name (`importname'` / `exportname'`): a discriminant,
/// then the name. 0x00 is the current form and 0x01 the legacy one (both
/// precede exactly one string, as wasmparser reads them); 0x02 adds a vector
/// of options (`implements` / version suffix / external id), each a tag byte
/// and a string, which are skipped.
fn wib_component_extern_name(bytes: Bytes, pos: Int) -> (String, Int) with Exception {
  let d = wib_byte(bytes = bytes, pos = pos)
  let (nm, p) = wib_name(bytes = bytes, pos = pos + 1)
  if d == 0x00 || d == 0x01 {
    (nm, p)
  } else if d == 0x02 {
    let (count, p1) = wib_leb_u(bytes = bytes, pos = p)
    let mut q = p1
    let mut i = 0
    while i < count {
      let (_, q1) = wib_name(bytes = bytes, pos = q + 1)
      q = q1
      i = i + 1
    }
    (nm, q)
  } else {
    throw("unknown component name form 0x\{wib_hex_digit((d >> 4) & 15)}\{wib_hex_digit(d & 15)}")
  }
}

/// Skip an `externdesc`; answers `(func type index or -1, adds a type?, next)`.
fn wib_component_externdesc(bytes: Bytes, pos: Int) -> (Int, Bool, Int) with Exception {
  let k = wib_byte(bytes = bytes, pos = pos)
  if k == 0x00 {
    let (_, p) = wib_leb_u(bytes = bytes, pos = pos + 2)
    (-1, false, p)
  } else if k == 0x01 {
    let (ti, p) = wib_leb_u(bytes = bytes, pos = pos + 1)
    (ti, false, p)
  } else if k == 0x02 {
    let vb = wib_byte(bytes = bytes, pos = pos + 1)
    if vb == 0x00 {
      let (_, p) = wib_leb_u(bytes = bytes, pos = pos + 2)
      (-1, false, p)
    } else {
      let (_, p) = wib_read_cvaltype(bytes = bytes, pos = pos + 2)
      (-1, false, p)
    }
  } else if k == 0x03 {
    let tb = wib_byte(bytes = bytes, pos = pos + 1)
    if tb == 0x00 {
      let (_, p) = wib_leb_u(bytes = bytes, pos = pos + 2)
      (-1, true, p)
    } else {
      (-1, true, pos + 2)
    }
  } else if k == 0x04 || k == 0x05 {
    let (_, p) = wib_leb_u(bytes = bytes, pos = pos + 1)
    (-1, false, p)
  } else {
    throw("unknown component externdesc 0x\{wib_hex_digit((k >> 4) & 15)}\{wib_hex_digit(k & 15)}")
  }
}

/// `(exports as (name, func type index or -1, why-not-offered or ""),
/// types as (params, param labels, results))` of a component. A type entry
/// that is not a function type has params `[-1]`.
fn wib_read_component(_ bytes: Bytes) -> (Array[(String, Int, String)], Array[(Array[Int], Array[String], Array[Int])]) with Exception {
  let types: Array[(Array[Int], Array[String], Array[Int])] = []
  let funcs = wib_fresh_ints()
  let exports: Array[(String, Int, String)] = []
  // Once a form this reader cannot follow appears, later indices are
  // unknown: `lost` is the reason, and every later entry records it.
  let mut lost = ""
  let mut p = 8
  let n = Bytes::length(bytes)
  while p < n {
    let id = wib_byte(bytes = bytes, pos = p)
    let (size, body) = wib_leb_u(bytes = bytes, pos = p + 1)
    let end = body + size
    if end > n {
      throw("truncated component (section \{id} runs past the end)")
    } else {
      ()
    }
    if lost != "" {
      ()
    } else if id == 7 {
      let (count, p0) = wib_leb_u(bytes = bytes, pos = body)
      let mut q = p0
      let mut i = 0
      while i < count && lost == "" {
        let form = wib_byte(bytes = bytes, pos = q)
        if form == 0x40 {
          let ps = wib_fresh_ints()
          let labels = wib_fresh_strings()
          let (np, pp) = wib_leb_u(bytes = bytes, pos = q + 1)
          let mut r = pp
          let mut k = 0
          while k < np {
            let (label, r1) = wib_name(bytes = bytes, pos = r)
            let (vt, r2) = wib_read_cvaltype(bytes = bytes, pos = r1)
            Array::push(labels, value = label)
            Array::push(ps, value = vt)
            r = r2
            k = k + 1
          }
          let rs = wib_fresh_ints()
          let rk = wib_byte(bytes = bytes, pos = r)
          if rk == 0x00 {
            let (vt, r3) = wib_read_cvaltype(bytes = bytes, pos = r + 1)
            Array::push(rs, value = vt)
            r = r3
          } else if rk == 0x01 {
            let (nr, r3) = wib_leb_u(bytes = bytes, pos = r + 1)
            r = r3
            let mut j = 0
            while j < nr {
              let (_, r4) = wib_name(bytes = bytes, pos = r)
              let (vt, r5) = wib_read_cvaltype(bytes = bytes, pos = r4)
              Array::push(rs, value = vt)
              Array::push(rs, value = -1)
              r = r5
              j = j + 1
            }
          } else {
            lost = "an unknown function result form"
          }
          Array::push(types, value = (ps, labels, rs))
          q = r
        } else if form >= 0x73 && form <= 0x7f {
          Array::push(types, value = ([-1], wib_fresh_strings(), wib_fresh_ints()))
          q = q + 1
        } else if form == 0x6b || form == 0x70 {
          let (_, r) = wib_read_cvaltype(bytes = bytes, pos = q + 1)
          Array::push(types, value = ([-1], wib_fresh_strings(), wib_fresh_ints()))
          q = r
        } else if form == 0x6f {
          let (cnt, r0) = wib_leb_u(bytes = bytes, pos = q + 1)
          let mut r = r0
          let mut k = 0
          while k < cnt {
            let (_, r1) = wib_read_cvaltype(bytes = bytes, pos = r)
            r = r1
            k = k + 1
          }
          Array::push(types, value = ([-1], wib_fresh_strings(), wib_fresh_ints()))
          q = r
        } else if form == 0x72 {
          let (cnt, r0) = wib_leb_u(bytes = bytes, pos = q + 1)
          let mut r = r0
          let mut k = 0
          while k < cnt {
            let (_, r1) = wib_name(bytes = bytes, pos = r)
            let (_, r2) = wib_read_cvaltype(bytes = bytes, pos = r1)
            r = r2
            k = k + 1
          }
          Array::push(types, value = ([-1], wib_fresh_strings(), wib_fresh_ints()))
          q = r
        } else if form == 0x6e || form == 0x6d {
          let (cnt, r0) = wib_leb_u(bytes = bytes, pos = q + 1)
          let mut r = r0
          let mut k = 0
          while k < cnt {
            let (_, r1) = wib_name(bytes = bytes, pos = r)
            r = r1
            k = k + 1
          }
          Array::push(types, value = ([-1], wib_fresh_strings(), wib_fresh_ints()))
          q = r
        } else if form == 0x69 || form == 0x68 {
          let (_, r) = wib_leb_u(bytes = bytes, pos = q + 1)
          Array::push(types, value = ([-1], wib_fresh_strings(), wib_fresh_ints()))
          q = r
        } else {
          lost = "a type form this reader does not follow (0x\{wib_hex_digit((form >> 4) & 15)}\{wib_hex_digit(form & 15)}; a component or instance type is what an imported interface declares)"
        }
        i = i + 1
      }
    } else if id == 8 {
      let (count, p0) = wib_leb_u(bytes = bytes, pos = body)
      let mut q = p0
      let mut i = 0
      while i < count && lost == "" {
        let op = wib_byte(bytes = bytes, pos = q)
        if op == 0x00 || op == 0x01 {
          // lift `0x00 0x00 corefunc opts type` / lower `0x01 0x00 func opts`
          let (_, q1) = wib_leb_u(bytes = bytes, pos = q + 2)
          let (nopt, q2) = wib_leb_u(bytes = bytes, pos = q1)
          let mut r = q2
          let mut k = 0
          while k < nopt && lost == "" {
            let o = wib_byte(bytes = bytes, pos = r)
            if o <= 0x02 || o == 0x06 {
              r = r + 1
            } else if o >= 0x03 && o <= 0x07 {
              let (_, r1) = wib_leb_u(bytes = bytes, pos = r + 1)
              r = r1
            } else {
              lost = "an unknown canonical option"
            }
            k = k + 1
          }
          if op == 0x00 {
            let (ti, r1) = wib_leb_u(bytes = bytes, pos = r)
            Array::push(funcs, value = ti)
            q = r1
          } else {
            q = r
          }
        } else if op == 0x02 || op == 0x03 || op == 0x04 {
          let (_, q1) = wib_leb_u(bytes = bytes, pos = q + 1)
          q = q1
        } else {
          lost = "a canonical builtin this reader does not follow"
        }
        i = i + 1
      }
    } else if id == 6 {
      let (count, p0) = wib_leb_u(bytes = bytes, pos = body)
      let mut q = p0
      let mut i = 0
      while i < count {
        let sort = wib_byte(bytes = bytes, pos = q)
        let after_sort = if sort == 0x00 {
          q + 2
        } else {
          q + 1
        }
        let tk = wib_byte(bytes = bytes, pos = after_sort)
        let after_target = if tk == 0x00 || tk == 0x01 {
          let (_, t1) = wib_leb_u(bytes = bytes, pos = after_sort + 1)
          let (_, t2) = wib_name(bytes = bytes, pos = t1)
          t2
        } else {
          let (_, t1) = wib_leb_u(bytes = bytes, pos = after_sort + 1)
          let (_, t2) = wib_leb_u(bytes = bytes, pos = t1)
          t2
        }
        if sort == 0x01 {
          Array::push(funcs, value = -1)
        } else if sort == 0x03 {
          Array::push(types, value = ([-1], wib_fresh_strings(), wib_fresh_ints()))
        } else {
          ()
        }
        q = after_target
        i = i + 1
      }
    } else if id == 10 {
      let (count, p0) = wib_leb_u(bytes = bytes, pos = body)
      let mut q = p0
      let mut i = 0
      while i < count {
        let (_, q1) = wib_component_extern_name(bytes = bytes, pos = q)
        let (fti, adds_type, q2) = wib_component_externdesc(bytes = bytes, pos = q1)
        if wib_byte(bytes = bytes, pos = q1) == 0x01 {
          Array::push(funcs, value = fti)
        } else if adds_type {
          Array::push(types, value = ([-1], wib_fresh_strings(), wib_fresh_ints()))
        } else {
          ()
        }
        q = q2
        i = i + 1
      }
    } else if id == 11 {
      let (count, p0) = wib_leb_u(bytes = bytes, pos = body)
      let mut q = p0
      let mut i = 0
      while i < count {
        let (nm, q1) = wib_component_extern_name(bytes = bytes, pos = q)
        let sort = wib_byte(bytes = bytes, pos = q1)
        let after_sort = if sort == 0x00 {
          q1 + 2
        } else {
          q1 + 1
        }
        let (idx, q2) = wib_leb_u(bytes = bytes, pos = after_sort)
        let has_desc = wib_byte(bytes = bytes, pos = q2)
        let (desc_fti, desc_type, q3) = if has_desc == 0x01 {
          wib_component_externdesc(bytes = bytes, pos = q2 + 1)
        } else {
          (-1, false, q2 + 1)
        }
        if sort == 0x01 {
          let fti = if desc_fti >= 0 {
            desc_fti
          } else if idx < Array::length(funcs) {
            Array::get(funcs, at = idx)
          } else {
            -1
          }
          Array::push(funcs, value = fti)
          Array::push(exports, value = (nm, fti, ""))
        } else if sort == 0x05 {
          Array::push(exports, value = (nm, -1, "an exported interface (instance); only world-level functions are read yet"))
        } else if sort == 0x03 || desc_type {
          Array::push(types, value = ([-1], wib_fresh_strings(), wib_fresh_ints()))
        } else {
          ()
        }
        q = q3
        i = i + 1
      }
    } else {
      ()
    }
    if lost != "" {
      Array::push(exports, value = ("", -2, lost))
    } else {
      ()
    }
    p = end
  }
  (exports, types)
}

/// `<export>#<params>-><result>` in WIT type names, e.g. `add#s32,s32->s32`,
/// `greet#string->string`, `tick#->`. `#` cannot occur in a WIT name, so the
/// runner splits at the last one.
export fn wasm_component_field(name: String, params: Array[Int], results: Array[Int]) -> String {
  let ps = wib_fresh_strings()
  for c in params {
    Array::push(ps, value = wib_cv_name(c))
  }
  let rs = wib_fresh_strings()
  for c in results {
    Array::push(rs, value = wib_cv_name(c))
  }
  "\{name}#\{String::join(ps, sep = ",")}->\{String::join(rs, sep = ",")}"
}

fn wib_component_sig_text(params: Array[Int], labels: Array[String], results: Array[Int]) -> String {
  let parts = wib_fresh_strings()
  let mut i = 0
  while i < Array::length(params) {
    let label = if i < Array::length(labels) {
      Array::get(labels, at = i)
    } else {
      "p\{i}"
    }
    Array::push(parts, value = "\{label}: \{wib_cv_show(Array::get(params, at = i))}")
    i = i + 1
  }
  let ps = String::join(parts, sep = ", ")
  if Array::length(results) == 0 {
    "func(\{ps})"
  } else if Array::length(results) == 1 {
    "func(\{ps}) -> \{wib_cv_show(Array::get(results, at = 0))}"
  } else {
    "func(\{ps}) -> <\{Array::length(results) / 2} named results>"
  }
}

/// The 32-bit vibe type a WIT integer width is offered as: `s8` / `s16` /
/// `s32` as `Int32`, `u8` / `u16` / `u32` as `UInt32` (#3730, #3826); `""`
/// for `s64` / `u64`, which stay `Int`. A narrow width's values all fit, so
/// a result is exact; an argument outside the narrow range is a valid
/// `Int32` / `UInt32` that the runner refuses at the call, naming the range
/// (`int_to_cval` in viberun's foreign_link.rs), rather than truncating it.
fn wib_cv_int32_type(_ code: Int) -> String {
  if code == 0x7a || code == 0x7c || code == 0x7e {
    "Int32"
  } else if code == 0x79 || code == 0x7b || code == 0x7d {
    "UInt32"
  } else {
    ""
  }
}

/// The public type of an integer component parameter, and the argument the
/// wrapper hands the raw `Int` stub: a width offered as `Int32` / `UInt32`
/// is widened exactly; `s64` / `u64` stay an `Int` the runner range-checks.
fn wib_cv_int_wrapper(code: Int, arg: String) -> (String, String) {
  let t = wib_cv_int32_type(code)
  if t == "" {
    ("Int", arg)
  } else {
    (t, "\{t}::to_int(\{arg})")
  }
}

/// The public type of an integer component result.
fn wib_cv_int_result_type(_ code: Int) -> String {
  let t = wib_cv_int32_type(code)
  if t == "" {
    "Int"
  } else {
    t
  }
}

fn wib_component_emit(out: Array[String], raw: String, vibe_name: String, doc: String, callee: String, params: Array[Int], results: Array[Int]) -> Unit {
  let raw_params = wib_fresh_strings()
  let wrap_params = wib_fresh_strings()
  let wrap_args = wib_fresh_strings()
  let mut args = ""
  let mut i = 0
  while i < Array::length(params) {
    if Array::get(params, at = i) == 0x73 {
      Array::push(raw_params, value = "_ a\{i}: Bytes")
      Array::push(wrap_params, value = "_ a\{i}: String")
      Array::push(wrap_args, value = "\{raw}_string_bytes(a\{i})")
      args = String::concat(args, " (local.get $a\{i})")
    } else {
      // An `s32` / `u32` is offered as `Int32` / `UInt32` (#3730), so the
      // WIT width is the parameter's type: a value that does not fit is a
      // compile-time error at the call rather than the runner's refusal. The
      // raw stub keeps the `Int` every value crosses the boundary as.
      let (wrap_ty, wrap_arg) = wib_cv_int_wrapper(code = Array::get(params, at = i), arg = "a\{i}")
      Array::push(raw_params, value = "_ a\{i}: Int")
      Array::push(wrap_params, value = "_ a\{i}: \{wrap_ty}")
      Array::push(wrap_args, value = wrap_arg)
      args = String::concat(args, " \{wib_untag("a\{i}")}")
    }
    i = i + 1
  }
  let call = "(call $\{callee}\{args})"
  let has_result = Array::length(results) == 1
  let result_is_string = has_result && Array::get(results, at = 0) == 0x73
  let (raw_ret, body, wrap_ret) = if !has_result {
    ("Int", "\{call} (i64.const 0)", "Unit")
  } else if result_is_string {
    ("String", call, "String")
  } else {
    ("Int", "(vibe.int.tag \{call})", wib_cv_int_result_type(Array::get(results, at = 0)))
  }
  let wrapped_call = "\{raw}\{vibe_name}(\{String::join(wrap_args, sep = ", ")})"
  // The runner checks the component's signature against the one compiled
  // in before any call, so a result of a width offered as `Int32` /
  // `UInt32` is in range and keeping its low 32 bits is exact.
  let result_ty = if !has_result || result_is_string {
    ""
  } else {
    wib_cv_int32_type(Array::get(results, at = 0))
  }
  let result_expr = if result_ty == "Int32" {
    "Int::wrap_int32(\{wrapped_call})"
  } else if result_ty == "UInt32" {
    "Int::wrap_uint32(\{wrapped_call})"
  } else {
    wrapped_call
  }
  Array::push(out, value = "/// \{doc}\n")
  Array::push(out, value = "fn \{raw}\{vibe_name}(\{String::join(raw_params, sep = ", ")}) -> \{raw_ret} = wasm \"\{body}\"\n")
  if has_result {
    Array::push(out, value = "export fn \{vibe_name}(\{String::join(wrap_params, sep = ", ")}) -> \{wrap_ret} {\n  \{result_expr}\n}\n\n")
  } else {
    Array::push(out, value = "export fn \{vibe_name}(\{String::join(wrap_params, sep = ", ")}) -> Unit {\n  let _ = \{raw}\{vibe_name}(\{String::join(wrap_args, sep = ", ")})\n  ()\n}\n\n")
  }
}

fn wib_component_binding_source(path: String, bytes: Bytes) -> String with Exception {
  let (exports, types) = handle {
    wib_read_component(bytes)
  } with { Exception::Throw(msg) => throw("cannot import \{path}: \{msg}") }
  let module_name = wasm_component_module_name(path)
  let out = wib_fresh_strings()
  let withheld = wib_fresh_strings()
  Array::push(out, value = "// Bindings synthesized from the wasm component \{wib_display_name(path)}.\n// Calls resolve through `\{wib_display_name(module_name)}`.\n\n")
  let names = wib_fresh_strings()
  for ex in exports {
    let (nm, _, _) = ex
    Array::push(names, value = wasm_import_vibe_name(nm))
  }
  let raw = wib_private_prefix(names)
  // The bytes of a `string` argument, copied into the Bytes object the
  // runner reads (the stub of an export named `_string_bytes` would be the
  // same name, so that export is withheld below).
  Array::push(out, value = "fn \{raw}_string_bytes(_ s: String) -> Bytes {\n  let b = Bytes::with_capacity(String::length(s))\n  let mut i = 0\n  while i < String::length(s) {\n    Bytes::push(b, value = String::byte_at(s, at = i))\n    i = i + 1\n  }\n  b\n}\n\n")
  let mut i = 0
  while i < Array::length(exports) {
    let (nm, fti, why) = Array::get(exports, at = i)
    let vn = Array::get(names, at = i)
    let shown = wib_display_name(nm)
    let mut dup = vn == "_string_bytes"
    let mut j = 0
    while j < Array::length(names) {
      if j != i && Array::get(names, at = j) == vn {
        dup = true
      } else {
        ()
      }
      j = j + 1
    }
    if fti == -2 {
      Array::push(withheld, value = "everything typed after this point: the reader stopped at \{why}")
    } else if why != "" {
      Array::push(withheld, value = "`\{shown}`: \{why}")
    } else if vn == "" {
      Array::push(withheld, value = "`\{shown}`: no vibe identifier can be formed from the name")
    } else if dup {
      Array::push(withheld, value = "`\{shown}`: its vibe name `\{vn}` is shared with another export")
    } else if fti < 0 || fti >= Array::length(types) {
      Array::push(withheld, value = "`\{shown}`: its function type could not be followed")
    } else {
      let (ps, labels, rs) = Array::get(types, at = fti)
      let mut ok = !(Array::length(ps) == 1 && Array::get(ps, at = 0) == -1) && Array::length(rs) <= 1
      for c in ps {
        if !wib_cv_admitted(c) {
          ok = false
        } else {
          ()
        }
      }
      for c in rs {
        if !wib_cv_admitted(c) {
          ok = false
        } else {
          ()
        }
      }
      let sig = wib_component_sig_text(params = ps, labels = labels, results = rs)
      if !ok {
        Array::push(withheld, value = "`\{shown}`: \{sig} -- only s8..u64 (as Int) and string params, and at most one such result, cross the boundary yet")
      } else {
        let core_params = wib_fresh_ints()
        for _c in ps {
          Array::push(core_params, value = 0x7E)
        }
        let core_results = wib_fresh_ints()
        for _c in rs {
          Array::push(core_results, value = 0x7E)
        }
        // The field carries the WIT signature the binding was typed against
        // (`add#s32,s32->s32`): every value crosses in an i64 slot, so the
        // core type cannot tell `-> s32` from `-> string`, and the runner
        // refuses a component whose export no longer matches instead of
        // converting by the new type.
        wib_component_emit(out = out, raw = raw, vibe_name = vn, doc = "`\{shown}: \{sig}` from the component \{wib_display_name(path)}.", callee = wasm_import_callee(module_name = module_name, field = wasm_component_field(name = nm, params = ps, results = rs), params = core_params, results = core_results), params = ps, results = rs)
      }
    }
    i = i + 1
  }
  if Array::length(withheld) > 0 {
    Array::push(out, value = "// Exports not offered:\n")
    for w in withheld {
      Array::push(out, value = String::concat("//   ", String::concat(w, "\n")))
    }
  } else {
    ()
  }
  String::join(out, sep = "")
}
