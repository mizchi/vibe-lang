//# Imports

import ./ast.vibe {
  Expr, ImportItem, Pat, Stmt, TypeExpr
}

import @vibe/core {
  array_empty, struct MutMap, struct MutSet
}

import ./module_graph_path.vibe {
  dir_of_path, resolve_import_path_candidates
}

//# Functions

fn empty_aliases() -> Array[(String, String)] {
  array_empty()
}

fn empty_strings() -> Array[String] {
  array_empty()
}

fn empty_import_refs() -> Array[(String, String, String)] {
  array_empty()
}

fn string_array_contains(items: Array[String], target: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(items) && !found {
    if Array::get(items, i) == target {
      found = true
    } else {
      i = i + 1
    }
  }
  found
}

fn import_ref_array_contains_local(items: Array[(String, String, String)], target: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(items) && !found {
    let (_, _, local) = Array::get(items, i)
    if local == target {
      found = true
    } else {
      i = i + 1
    }
  }
  found
}

fn import_ref_has_other_path_for_original(items: Array[(String, String, String)], raw_path: String, original: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(items) && !found {
    let (other_path, other_original, _) = Array::get(items, i)
    if other_original == original && other_path != raw_path {
      found = true
    } else {
      i = i + 1
    }
  }
  found
}

fn lookup_alias(aliases: Array[(String, String)], name: String) -> Option[String] {
  let mut i = 0
  let mut found = None
  while i < Array::length(aliases) {
    let (alias, original) = Array::get(aliases, i)
    if alias == name {
      found = Some(original)
      i = Array::length(aliases)
    } else {
      i = i + 1
    }
  }
  found
}

/// #897/Codex P2: a local binder named `ns` must also shadow any qualified-
/// import namespace aliases it introduces ("ns.x", "ns.y" from `import ...
/// as ns only { x, y }`) -- otherwise `ns.add` inside that binder's scope,
/// where `ns` is a genuine local value with its own `add` field, gets
/// mis-rewritten to the IMPORTED `add` instead of the real field access
/// (silently wrong codegen, not just a diagnostic gap). `alias_is_shadowed`
/// centralizes the "does binder `name` shadow this alias key" test so the
/// exact-match and dotted-namespace-prefix cases can never drift apart.
fn alias_is_shadowed(alias: String, name: String) -> Bool {
  alias == name || (String::starts_with(alias, name) && String::length(alias) > String::length(name) && String::char_code_at(alias, String::length(name)) == '.')
}

/// Perf: the without_* family runs at EVERY binder (let/lambda/match arm)
/// while rewriting every expression, but a binder that shadows an alias is
/// rare -- in the common case nothing is removed. Pre-scan and return the
/// input map unchanged (alias maps are read-only after construction, so
/// sharing is safe); only allocate the filtered copy when a removal is real.
/// A full-closure compile profile showed this trio as the #2 __rt_arr_push /
/// __rt_heap_grow_check caller after perceus copy_ints.
fn alias_map_has_name(aliases: Array[(String, String)], name: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(aliases) && !found {
    let (alias, _) = Array::get(aliases, i)
    if alias_is_shadowed(alias, name) {
      found = true
    } else {
      i = i + 1
    }
  }
  found
}

fn alias_map_without_name(aliases: Array[(String, String)], name: String) -> Array[(String, String)] {
  if !alias_map_has_name(aliases, name) {
    aliases
  } else {
    let out = empty_aliases()
    let mut i = 0
    while i < Array::length(aliases) {
      let (alias, original) = Array::get(aliases, i)
      if !alias_is_shadowed(alias, name) {
        Array::push(out, (alias, original))
      }
      i = i + 1
    }
    out
  }
}

/// #897/Codex P2: same dotted-namespace-prefix shadowing as alias_is_shadowed
/// above, generalized to a whole array of shadowing names (this helper's
/// callers pass collision/rename-local lists, not a single binder name).
fn names_shadow_alias(names: Array[String], alias: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(names) && !found {
    if alias_is_shadowed(alias, Array::get(names, i)) {
      found = true
    } else {
      i = i + 1
    }
  }
  found
}

fn alias_map_without_names(aliases: Array[(String, String)], names: Array[String]) -> Array[(String, String)] {
  let mut any = false
  let mut j = 0
  while j < Array::length(aliases) && !any {
    let (alias, _) = Array::get(aliases, j)
    if names_shadow_alias(names, alias) {
      any = true
    } else {
      j = j + 1
    }
  }
  if !any {
    aliases
  } else {
    let out = empty_aliases()
    let mut i = 0
    while i < Array::length(aliases) {
      let (alias, original) = Array::get(aliases, i)
      if !names_shadow_alias(names, alias) {
        Array::push(out, (alias, original))
      }
      i = i + 1
    }
    out
  }
}

fn alias_map_put_last(aliases: Array[(String, String)], local: String, target: String) -> Unit {
  let mut i = 0
  let mut found = false
  while i < Array::length(aliases) && !found {
    let (alias, _) = Array::get(aliases, i)
    if alias == local {
      Array::set(aliases, i, (local, target))
      found = true
    } else {
      i = i + 1
    }
  }
  if !found {
    Array::push(aliases, (local, target))
  } else {
    ()
  }
}

fn pat_binds_name(pat: Pat, name: String) -> Bool {
  match pat {
    PBind(bound) => bound == name,
    PCtor(_, pats) => {
      let mut found = false
      let mut i = 0
      while i < Array::length(pats) && !found {
        if pat_binds_name(Array::get(pats, i), name) {
          found = true
        } else {
          i = i + 1
        }
      }
      found
    },
    PTuple(pats) => {
      let mut found = false
      let mut i = 0
      while i < Array::length(pats) && !found {
        if pat_binds_name(Array::get(pats, i), name) {
          found = true
        } else {
          i = i + 1
        }
      }
      found
    },
    POr(left, right) => pat_binds_name(left, name) || pat_binds_name(right, name),
    PStruct(_, fields) => {
      let mut found = false
      let mut i = 0
      while i < Array::length(fields) && !found {
        let (_, field_pat) = Array::get(fields, i)
        if pat_binds_name(field_pat, name) {
          found = true
        } else {
          i = i + 1
        }
      }
      found
    },
    _ => false
  }
}

/// Does `pat` bind any name that shadows `alias` (exactly, or as its dotted
/// namespace prefix)? Structurally identical to pat_binds_name's walk, but
/// the leaf test is `alias_is_shadowed` so both shadowing forms are decided
/// in ONE traversal with no prefix extraction -- see pat_shadows_alias.
fn pat_binds_shadowing_name(pat: Pat, alias: String) -> Bool {
  match pat {
    PBind(bound) => alias_is_shadowed(alias, bound),
    PCtor(_, pats) => {
      let mut found = false
      let mut i = 0
      while i < Array::length(pats) && !found {
        if pat_binds_shadowing_name(Array::get(pats, i), alias) {
          found = true
        } else {
          i = i + 1
        }
      }
      found
    },
    PTuple(pats) => {
      let mut found = false
      let mut i = 0
      while i < Array::length(pats) && !found {
        if pat_binds_shadowing_name(Array::get(pats, i), alias) {
          found = true
        } else {
          i = i + 1
        }
      }
      found
    },
    POr(left, right) =>
    pat_binds_shadowing_name(left, alias) || pat_binds_shadowing_name(right, alias),
    PStruct(_, fields) => {
      let mut found = false
      let mut i = 0
      while i < Array::length(fields) && !found {
        let (_, field_pat) = Array::get(fields, i)
        if pat_binds_shadowing_name(field_pat, alias) {
          found = true
        } else {
          i = i + 1
        }
      }
      found
    },
    _ => false
  }
}

/// Does any name bound by `pat` shadow `alias`?
///
/// Perf (#1237 follow-up): this used to be `pat_binds_name(pat, alias) ||
/// pat_binds_name(pat, <alias's namespace prefix>)`, which per (binder,
/// alias) pair walked the pattern TWICE and paid a `String::index_of` plus a
/// `String::substring` ALLOCATION to cut the namespace prefix out -- for a
/// prefix that is a pure function of the alias and never changes. Since
/// alias_map_without_pat runs this at every binder against every alias, a
/// full-closure compile profile attributed 17.2% of the whole merge/rename
/// phase to `alias_namespace_prefix` and the `String::index_of` underneath
/// it. Testing `alias_is_shadowed` at each bound name instead is one walk
/// with no allocation.
///
/// Equivalent because a pattern binder is an identifier and so never
/// contains a dot: `alias_is_shadowed(alias, bound)` is then true exactly
/// when `bound == alias` or `bound` is alias's FIRST dotted segment, which
/// is precisely the old pair of checks. This is the same identifier-has-no-
/// dot argument the `without_*` family already relies on -- alias_is_shadowed
/// is the predicate it uses, so the two now agree by construction instead of
/// by two separately-maintained spellings.
fn pat_shadows_alias(pat: Pat, alias: String) -> Bool {
  pat_binds_shadowing_name(pat, alias)
}

fn alias_map_without_pat(aliases: Array[(String, String)], pat: Pat) -> Array[(String, String)] {
  let mut any = false
  let mut j = 0
  while j < Array::length(aliases) && !any {
    let (alias, _) = Array::get(aliases, j)
    if pat_shadows_alias(pat, alias) {
      any = true
    } else {
      j = j + 1
    }
  }
  if !any {
    aliases
  } else {
    let out = empty_aliases()
    let mut i = 0
    while i < Array::length(aliases) {
      let (alias, original) = Array::get(aliases, i)
      if !pat_shadows_alias(pat, alias) {
        Array::push(out, (alias, original))
      }
      i = i + 1
    }
    out
  }
}

fn param_binds_name(params: Array[(String, Option[TypeExpr])], name: String) -> Bool {
  let mut found = false
  let mut i = 0
  while i < Array::length(params) && !found {
    let (param_name, _) = Array::get(params, i)
    if param_name == name {
      found = true
    } else {
      i = i + 1
    }
  }
  found
}

/// Parameter-list counterpart of pat_shadows_alias -- same rewrite, same
/// reasoning (see that function's note).
fn params_shadow_alias(params: Array[(String, Option[TypeExpr])], alias: String) -> Bool {
  let mut found = false
  let mut i = 0
  while i < Array::length(params) && !found {
    let (param_name, _) = Array::get(params, i)
    if alias_is_shadowed(alias, param_name) {
      found = true
    } else {
      i = i + 1
    }
  }
  found
}

fn alias_map_without_params(aliases: Array[(String, String)], params: Array[(String, Option[TypeExpr])]) -> Array[(String, String)] {
  let mut any = false
  let mut j = 0
  while j < Array::length(aliases) && !any {
    let (alias, _) = Array::get(aliases, j)
    if params_shadow_alias(params, alias) {
      any = true
    } else {
      j = j + 1
    }
  }
  if !any {
    aliases
  } else {
    let out = empty_aliases()
    let mut i = 0
    while i < Array::length(aliases) {
      let (alias, original) = Array::get(aliases, i)
      if !params_shadow_alias(params, alias) {
        Array::push(out, (alias, original))
      }
      i = i + 1
    }
    out
  }
}

/// #1259: indexed view of one alias map. `entries` stays the canonical
/// first-match array -- the filtered copies the without_* family produces
/// run through the SAME filter functions, so every lookup result is
/// identical to the linear scans it replaces. `idx` maps alias -> original
/// with first-push-wins, and `shadow_keys` holds every name whose binding
/// would shadow at least one alias (each alias itself plus each of its
/// dotted prefixes, per alias_is_shadowed), turning the at-every-binder
/// "does this binder shadow anything" pre-scan from O(aliases) into O(1).
/// A full-closure compile profile put the lookup_alias / alias_map_has_name
/// scans at ~8% of total CPU before this index.
struct AliasIdx {
  entries: Array[(String, String)];
  idx: MutMap[String, String];
  shadow_keys: MutSet[String]
}

fn aliasidx_build(entries: Array[(String, String)]) -> AliasIdx {
  let idx: MutMap[String, String] = MutMap::new_string()
  let shadow_keys = MutSet::new_string()
  let mut i = 0
  while i < Array::length(entries) {
    let (alias, original) = Array::get(entries, i)
    if !MutMap::has(idx, alias) {
      MutMap::set(idx, alias, original)
    } else {
      ()
    }
    MutSet::add(shadow_keys, alias)
    let mut ci = 0
    while ci < String::length(alias) {
      if String::char_code_at(alias, ci) == '.' {
        MutSet::add(shadow_keys, alias[0: ci])
      } else {
        ()
      }
      ci = ci + 1
    }
    i = i + 1
  }
  AliasIdx::{
    entries: entries,
    idx: idx,
    shadow_keys: shadow_keys
  }
}

/// alias_map_has_name, O(1): does binding `name` shadow any alias?
fn aliasidx_shadows(am: AliasIdx, name: String) -> Bool {
  MutSet::has(am.shadow_keys, name)
}

fn aliasidx_without_name(am: AliasIdx, name: String) -> AliasIdx {
  if aliasidx_shadows(am, name) {
    aliasidx_build(alias_map_without_name(am.entries, name))
  } else {
    am
  }
}

fn aliasidx_without_names(am: AliasIdx, names: Array[String]) -> AliasIdx {
  let mut any = false
  let mut i = 0
  while i < Array::length(names) && !any {
    if aliasidx_shadows(am, Array::get(names, i)) {
      any = true
    } else {
      i = i + 1
    }
  }
  if any {
    aliasidx_build(alias_map_without_names(am.entries, names))
  } else {
    am
  }
}

/// Bound names of a pattern (binders are plain identifiers), for the O(1)
/// shadow pre-check in aliasidx_without_pat. Same walk as pat_binds_name.
fn pat_collect_bound_names(pat: Pat, out: Array[String]) -> Int {
  match pat {
    PBind(bound) => {
      Array::push(out, bound); 0
    },
    PCtor(_, pats) => {
      let mut i = 0
      while i < Array::length(pats) {
        pat_collect_bound_names(Array::get(pats, i), out)
        i = i + 1
      }
      0
    },
    PTuple(pats) => {
      let mut i = 0
      while i < Array::length(pats) {
        pat_collect_bound_names(Array::get(pats, i), out)
        i = i + 1
      }
      0
    },
    POr(left, right) => {
      pat_collect_bound_names(left, out); pat_collect_bound_names(right, out)
    },
    PStruct(_, fields) => {
      let mut i = 0
      while i < Array::length(fields) {
        let (_, field_pat) = Array::get(fields, i)
        pat_collect_bound_names(field_pat, out)
        i = i + 1
      }
      0
    },
    _ => 0
  }
}

fn aliasidx_without_pat(am: AliasIdx, pat: Pat) -> AliasIdx {
  let bound = empty_strings()
  let _ = pat_collect_bound_names(pat, bound)
  let mut any = false
  let mut i = 0
  while i < Array::length(bound) && !any {
    if aliasidx_shadows(am, Array::get(bound, i)) {
      any = true
    } else {
      i = i + 1
    }
  }
  if any {
    aliasidx_build(alias_map_without_pat(am.entries, pat))
  } else {
    am
  }
}

fn aliasidx_without_params(am: AliasIdx, params: Array[(String, Option[TypeExpr])]) -> AliasIdx {
  let mut any = false
  let mut i = 0
  while i < Array::length(params) && !any {
    let (param_name, _) = Array::get(params, i)
    if aliasidx_shadows(am, param_name) {
      any = true
    } else {
      i = i + 1
    }
  }
  if any {
    aliasidx_build(alias_map_without_params(am.entries, params))
  } else {
    am
  }
}

export fn rewrite_import_alias_expr(expr: Expr, aliases: Array[(String, String)]) -> Expr {
  if Array::length(aliases) == 0 {
    expr
  } else {
    rewrite_alias_expr_ix(expr, aliasidx_build(aliases))
  }
}

/// #1259: prebuilt-index variant for callers that rewrite MANY expressions
/// against the same alias map. rewrite_import_alias_expr builds the index
/// per call, which is fine for one-shot use but was the dominant share of
/// bump-heap growth (and ~300ms of rehash churn) when normalize's module
/// flattening called it once per binding.
export fn make_import_alias_rewriter(aliases: Array[(String, String)]) -> (Expr) -> Expr {
  let am = aliasidx_build(aliases)
  (e) -> {
    rewrite_alias_expr_ix(e, am)
  }
}

/// #1502: `H::Crimson` -> `Hue::Crimson` when `H` is an import alias. `expr` is
/// returned unchanged for an unqualified name or a head that is not aliased,
/// so the caller keeps sharing the original node in the common case.
fn rewrite_alias_qualified_head(expr: Expr, name: String, am: AliasIdx) -> Expr {
  let qi = String::index_of(name, "::")
  if qi < 0 {
    expr
  } else {
    let head = String::substring(name, 0, qi)
    match MutMap::get(am.idx, head) {
      Some(original) => EIdent(String::concat(original, String::substring(name, qi, String::length(name))), -1),
      None => expr
    }
  }
}

fn rewrite_alias_type_opt(ty: Option[TypeExpr], am: AliasIdx) -> Option[TypeExpr] {
  match ty {
    Some(inner) => Some(rewrite_alias_type_expr(inner, am)),
    None => None
  }
}

fn rewrite_alias_param_types(params: Array[(String, Option[TypeExpr])], am: AliasIdx) -> Array[(String, Option[TypeExpr])] {
  for param in params {
    let (name, ty) = param
    (name, rewrite_alias_type_opt(ty, am))
  }
}

fn rewrite_alias_expr_ix(expr: Expr, am: AliasIdx) -> Expr {
  // Perf: with no aliases the rewrite is the identity, but the match below
  // still rebuilt EVERY node of the tree. Alias maps only shrink on the way
  // down (without_*), so an empty map stays empty for the whole subtree --
  // return the shared node instead of an allocated copy (AST nodes are
  // immutable; `None => expr` below already shares subtrees).
  if Array::length(am.entries) == 0 {
    expr
  } else {
    match expr {
      EIdent(name, _) => match MutMap::get(am.idx, name) {
        Some(original) => EIdent(original, -1),
        // #1502: a qualified constructor reference carries the alias in its
        // HEAD (`import { Hue as H }` then `H::Crimson`), and the whole string
        // is never an alias key, so the lookup above misses and the alias used
        // to survive all the way to codegen -- whose constructor table is keyed
        // by the ORIGINAL unqualified name -- as `undefined variable (ident):
        // H::Crimson`. Rewriting the head here hands the rest of the pipeline
        // the same `Hue::Crimson` an unaliased import would have produced.
        None => rewrite_alias_qualified_head(expr, name, am)
      },
      ETuple(items) => ETuple(for item in items {
        rewrite_alias_expr_ix(item, am)
      }),
      EArray(items) => EArray(for item in items {
        rewrite_alias_expr_ix(item, am)
      }),
      ERecord(rn, fields, targs) => ERecord(rn, for field in fields {
        let (name, value) = field
        (name, rewrite_alias_expr_ix(value, am))
      }, targs),
      EIf(cond, then_expr, else_expr) => EIf(rewrite_alias_expr_ix(cond, am), rewrite_alias_expr_ix(then_expr, am), rewrite_alias_expr_ix(else_expr, am)),
      ELet(name, value, body, soff) => ELet(name, rewrite_alias_expr_ix(value, am), rewrite_alias_expr_ix(body, aliasidx_without_name(am, name)), soff),
      ELetRec(name, value, body) => {
        let body_aliases = aliasidx_without_name(am, name)
        ELetRec(name, rewrite_alias_expr_ix(value, body_aliases), rewrite_alias_expr_ix(body, body_aliases))
      },
      ELetMut(name, value, body, soff) => ELetMut(name, rewrite_alias_expr_ix(value, am), rewrite_alias_expr_ix(body, aliasidx_without_name(am, name)), soff),
      EAssign(name, value, body) => EAssign(name, rewrite_alias_expr_ix(value, am), rewrite_alias_expr_ix(body, am)),
      EAssignOp(name, op, value, body) => EAssignOp(name, op, rewrite_alias_expr_ix(value, am), rewrite_alias_expr_ix(body, am)),
      ESeq(left, right) => ESeq(rewrite_alias_expr_ix(left, am), rewrite_alias_expr_ix(right, am)),
      EMatch(scrutinee, arms) => EMatch(rewrite_alias_expr_ix(scrutinee, am), for arm in arms {
        let (pat, body) = arm
        (pat, rewrite_alias_expr_ix(body, aliasidx_without_pat(am, pat)))
      }),
      EHandle(body, arms) => EHandle(rewrite_alias_expr_ix(body, am), for arm in arms {
        let (pat, arm_body) = arm
        (pat, rewrite_alias_expr_ix(arm_body, aliasidx_without_pat(am, pat)))
      }),
      EWhile(cond, body) => EWhile(rewrite_alias_expr_ix(cond, am), rewrite_alias_expr_ix(body, am)),
      ELoop(params, body) => {
        let out_params = for param in params {
          let (name, init) = param
          (name, rewrite_alias_expr_ix(init, am))
        }
        let mut body_aliases = am
        let mut i = 0
        while i < Array::length(params) {
          let (name, _) = Array::get(params, i)
          body_aliases = aliasidx_without_name(body_aliases, name)
          i = i + 1
        }
        ELoop(out_params, rewrite_alias_expr_ix(body, body_aliases))
      },
      EForIn(name, index_name, iter, body) => {
        let body_aliases = match index_name {
          Some(index_name) => aliasidx_without_name(aliasidx_without_name(am, name), index_name),
          None => aliasidx_without_name(am, name)
        }
        EForIn(name, index_name, rewrite_alias_expr_ix(iter, am), rewrite_alias_expr_ix(body, body_aliases))
      },
      ECall(callee, args, off) => ECall(rewrite_alias_expr_ix(callee, am), for arg in args {
        rewrite_alias_expr_ix(arg, am)
      }, off),
      EBinOp(op, left, right) => EBinOp(op, rewrite_alias_expr_ix(left, am), rewrite_alias_expr_ix(right, am)),
      EUnaryOp(op, value) => EUnaryOp(op, rewrite_alias_expr_ix(value, am)),
      EFn(type_params, bounds, params, ret_ty, effect, body) => {
        // Type formals shadow imported TYPE aliases, independently of value
        // parameters shadowing imported VALUE aliases. Preserve both
        // namespaces while canonicalizing imported contract aliases in fn
        // parameter and return annotations (#1539 StdinStream as S).
        let type_am = aliasidx_without_names(am, type_params)
        EFn(type_params, bounds, rewrite_alias_param_types(params, type_am), rewrite_alias_type_opt(ret_ty, type_am), effect, rewrite_alias_expr_ix(body, aliasidx_without_params(am, params)))
      },
      // #897: `mod.x` written against a qualified-import namespace (`import
      // ... as mod only { x }`) is encoded as the alias key "mod.x" -- see
      // qualify_import_items in lib/@vibe/parser/parser.vibe. A real
      // identifier can never contain '.', so this lookup only ever hits for
      // that desugaring; anything else falls through to the ordinary EDot
      // rewrite (ordinary struct/record field access).
      EDot(obj, field, off, fdoff) => match obj {
        EIdent(ns, _) => match MutMap::get(am.idx, String::concat(ns, String::concat(".", field))) {
          Some(original) => EIdent(original, -1),
          None => EDot(rewrite_alias_expr_ix(obj, am), field, off, fdoff)
        },
        _ => EDot(rewrite_alias_expr_ix(obj, am), field, off, fdoff)
      },
      ELabeledArg(label, name, body) => ELabeledArg(label, name, rewrite_alias_expr_ix(body, am)),
      EReturn(value) => EReturn(rewrite_alias_expr_ix(value, am)),
      EBreak(value) => match value {
        Some(value) => EBreak(Some(rewrite_alias_expr_ix(value, am))),
        None => expr
      },
      EContinue(values) => EContinue(for value in values {
        rewrite_alias_expr_ix(value, am)
      }),
      EMap(fields) => EMap(for field in fields {
        let (name, value) = field
        (name, rewrite_alias_expr_ix(value, am))
      }),
      ESpread(value) => ESpread(rewrite_alias_expr_ix(value, am)),
      _ => expr
    }
  }
}

fn collect_item_aliases(items: Array[ImportItem], aliases: Array[(String, String)]) -> Unit {
  let mut j = 0
  while j < Array::length(items) {
    let item = Array::get(items, j)
    let original = item.name
    let alias_opt = item.alias
    match alias_opt {
      Some(alias) => if alias != original {
        Array::push(aliases, (alias, original))
      },
      None => ()
    }
    j = j + 1
  }
}

export fn collect_import_aliases(stmts: Array[Stmt]) -> Array[(String, String)] {
  let aliases = empty_aliases()
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SImport(_, items) => collect_item_aliases(items, aliases),
      SReExport(_, items) => collect_item_aliases(items, aliases),
      _ => ()
    }
    i = i + 1
  }
  aliases
}

fn collect_import_refs(stmts: Array[Stmt]) -> Array[(String, String, String)] {
  let refs = empty_import_refs()
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SImport(raw_path, items) => {
        let mut j = 0
        while j < Array::length(items) {
          let item = Array::get(items, j)
          let original = item.name
          let alias_opt = item.alias
          let local = match alias_opt {
            Some(alias) => alias,
            None => original
          }
          Array::push(refs, (raw_path, original, local))
          j = j + 1
        }
      },
      _ => ()
    }
    i = i + 1
  }
  refs
}

export fn collect_import_alias_collision_refs(stmts: Array[Stmt]) -> Array[(String, String, String)] {
  let refs = collect_import_refs(stmts)
  let out = empty_import_refs()
  let mut i = 0
  while i < Array::length(refs) {
    let (raw_path, original, local) = Array::get(refs, i)
    if import_ref_has_other_path_for_original(refs, raw_path, original) && !import_ref_array_contains_local(out, local) {
      Array::push(out, (raw_path, original, local))
    }
    i = i + 1
  }
  out
}

export fn collect_import_alias_collision_locals(stmts: Array[Stmt]) -> Array[String] {
  let refs = collect_import_alias_collision_refs(stmts)
  let out = empty_strings()
  let mut i = 0
  while i < Array::length(refs) {
    let (_, _, local) = Array::get(refs, i)
    if !string_array_contains(out, local) {
      Array::push(out, local)
    }
    i = i + 1
  }
  out
}

export fn rewrite_import_alias_stmt(stmt: Stmt, aliases: Array[(String, String)]) -> Stmt {
  rewrite_alias_stmt_ix(stmt, aliasidx_build(aliases))
}

fn rewrite_alias_stmt_ix(stmt: Stmt, am: AliasIdx) -> Stmt {
  match stmt {
    SLet(exported, is_rec, name, ty, body) => SLet(exported, is_rec, name, rewrite_alias_type_opt(ty, am), rewrite_alias_expr_ix(body, aliasidx_without_name(am, name))),
    SLetMut(name, ty, body) => SLetMut(name, rewrite_alias_type_opt(ty, am), rewrite_alias_expr_ix(body, aliasidx_without_name(am, name))),
    STest(name, body) => STest(name, rewrite_alias_expr_ix(body, am)),
    SBench(name, body) => SBench(name, rewrite_alias_expr_ix(body, am)),
    SExpr(body) => SExpr(rewrite_alias_expr_ix(body, am)),
    SLetPat(pat, body) => SLetPat(pat, rewrite_alias_expr_ix(body, am)),
    SModule(exported, name, stmts) => {
      let module_am = aliasidx_build(collect_import_aliases(stmts))
      SModule(exported, name, for inner_stmt in stmts {
        rewrite_alias_stmt_ix(inner_stmt, module_am)
      })
    },
    // #1502: an import alias used as a type-alias TARGET (`import { Attempt as
    // Att }` then `type Att2[T] = Att[T]`). The expression arm above already
    // normalizes an alias head in a constructor reference; without the type
    // side in step, `Att2` resolves only as far as `Att` and `Att2::Good`
    // reaches codegen still qualified.
    // The alias's own formals are BOUND names, so they are dropped from the
    // map before the target is rewritten -- the same discipline the expression
    // arms above apply with `aliasidx_without_name` / `aliasidx_without_params`.
    // With `import { Hue as T }` in scope, `type Box[T] = T` must keep its `T`.
    //
    // Note this does NOT by itself make that program correct: the checker's own
    // `STypeAlias` arm resolves the target against a `defs` where the import
    // already bound `T`, and captures it there. That capture predates this
    // rewrite (verified by A/B against origin/main, which has no type-side
    // rewrite at all) and is tracked separately -- what this guard buys is that
    // the rewrite is not a SECOND, independent source of the same bug.
    STypeAlias(exported, name, params, target) => STypeAlias(exported, name, params, rewrite_alias_type_expr(target, aliasidx_without_names(am, params))),
    _ => stmt
  }
}

/// The type-expression half of the import-alias rewrite: replace every head
/// that names an import alias with the name it aliases (#1502).
fn rewrite_alias_type_expr(te: TypeExpr, am: AliasIdx) -> TypeExpr {
  match te {
    TyName(n) => match MutMap::get(am.idx, n) {
      Some(original) => TyName(original),
      None => te
    },
    TyApp(n, args) => {
      let next_name = match MutMap::get(am.idx, n) {
        Some(original) => original,
        None => n
      }
      TyApp(next_name, for arg in args {
        rewrite_alias_type_expr(arg, am)
      })
    },
    TyTuple(items) => TyTuple(for item in items {
      rewrite_alias_type_expr(item, am)
    }),
    TyFn(ps, ret, eff) => TyFn(for p in ps {
      rewrite_alias_type_expr(p, am)
    }, rewrite_alias_type_expr(ret, am), eff),
    _ => te
  }
}

export fn stmts_have_import_deep(stmts: Array[Stmt]) -> Bool {
  let rec stmt_has_import_deep: (Stmt) -> Bool = (stmt) -> {
    match stmt {
      SImport(_, _) => true,
      SReExport(_, _) => true,
      SModule(_, _, inner_stmts) => stmts_have_import_deep(inner_stmts),
      _ => false
    }
  }
  let mut found = false
  let mut i = 0
  while i < Array::length(stmts) && !found {
    if stmt_has_import_deep(Array::get(stmts, i)) {
      found = true
    } else {
      i = i + 1
    }
  }
  found
}

fn is_stdin_provider_import_value(name: String) -> Bool {
  name == "Stdin::read_via_stream" || name == "StdinStream::next" || name == "StdinStream::close" || name == "StdinStream::read_chunk"
}

/// Preserve an imported provider value alias as a canonical value-position
/// marker after the import itself is dropped. The shared pre-codegen provider
/// validator then rejects the marker just like `let n = StdinStream::next`.
/// Type aliases such as `StdinStream as S` deliberately add no marker: their
/// qualified call heads are canonicalized by rewrite_alias_qualified_head.
fn append_stdin_provider_import_alias_markers(merged: Array[Stmt], items: Array[ImportItem]) -> Unit {
  let mut i = 0
  while i < Array::length(items) {
    let item = Array::get(items, i)
    let original = item.name
    let alias_opt = item.alias
    match alias_opt {
      Some(_) => if is_stdin_provider_import_value(original) {
        Array::push(merged, SExpr(EIdent(original, -1)))
      } else {
        ()
      },
      None => ()
    }
    i = i + 1
  }
}

export fn append_non_import_stmts_without_alias_rewrite(merged: Array[Stmt], stmts: Array[Stmt]) -> Unit {
  let mut i = 0
  while i < Array::length(stmts) {
    let stmt = Array::get(stmts, i)
    match stmt {
      SImport(_, items) => append_stdin_provider_import_alias_markers(merged, items),
      SReExport(_, _) => (),
      SAliasDecl(_, _) => (),
      _ => Array::push(merged, stmt)
    }
    i = i + 1
  }
}

export fn append_import_alias_rewritten_non_import_stmts_skipping(merged: Array[Stmt], stmts: Array[Stmt], skipped_locals: Array[String]) -> Unit {
  let aliases = alias_map_without_names(collect_import_aliases(stmts), skipped_locals)
  let should_rewrite = Array::length(aliases) > 0
  let am = aliasidx_build(aliases)
  let mut i = 0
  while i < Array::length(stmts) {
    let stmt = Array::get(stmts, i)
    match stmt {
      SImport(_, items) => append_stdin_provider_import_alias_markers(merged, items),
      SReExport(_, _) => (),
      SAliasDecl(_, _) => (),
      SModule(_, _, _) => Array::push(merged, rewrite_alias_stmt_ix(stmt, am)),
      _ => if should_rewrite {
        Array::push(merged, rewrite_alias_stmt_ix(stmt, am))
      } else {
        Array::push(merged, stmt)
      }
    }
    i = i + 1
  }
}

export fn append_import_alias_rewritten_non_import_stmts(merged: Array[Stmt], stmts: Array[Stmt]) -> Unit {
  append_import_alias_rewritten_non_import_stmts_skipping(merged, stmts, empty_strings())
}

export fn rewrite_imported_value_stmt_to_local(stmt: Stmt, original: String, local: String) -> Option[Stmt] {
  let aliases = Array::slice([(original, local)], 0, 1)
  let rewrite_value: (Expr) -> Expr = (expr) -> {
    if original == local {
      expr
    } else {
      rewrite_import_alias_expr(expr, aliases)
    }
  }
  match stmt {
    SLet(_, is_rec, name, ty, body) => if name == original {
      Some(SLet(false, is_rec, local, ty, rewrite_value(body)))
    } else {
      None
    },
    SLetMut(name, ty, body) => if name == original {
      Some(SLetMut(local, ty, rewrite_value(body)))
    } else {
      None
    },
    _ => None
  }
}

fn sanitize_namespace_char(code: Int) -> String {
  if (code >= 'a' && code <= 'z') || (code >= 'A' && code <= 'Z') || (code >= '0' && code <= '9') || code == '_' {
    String::from_char_code(code)
  } else {
    "_"
  }
}

fn sanitize_namespace_path(path: String) -> String {
  // O(N) build via StringBuilder; the previous `out = String::concat(out, ...)`
  // per char was O(N²) over the path length (issue #366).
  let out = StringBuilder::new()
  let mut i = 0
  while i < String::length(path) {
    StringBuilder::push(out, sanitize_namespace_char(String::char_code_at(path, i)))
    i = i + 1
  }
  StringBuilder::freeze(out)
}

fn namespace_private_name(path: String, name: String) -> String {
  String::concat(name, String::concat("_dep_", sanitize_namespace_path(path)))
}

/// #2205: (mangled -> original) for private TYPE and CONSTRUCTOR renames.
/// `derive(Show)` expands after the merge rename has already run, so the
/// renamed declaration is the only spelling it can see -- and it bakes that
/// spelling into the rendered string (`Point_dep_... { x: 3 }` in user
/// output). This table lets the derive generators recover the source name.
///
/// The table is scoped to ONE merged program (Codex rounds 2-3 on #2213):
/// each merge driver resets it before populating, and desugar_trait_dicts
/// clears it after the derive generators have read it. Left to accumulate
/// across compilations in a long-lived process, it would both grow without
/// bound and mis-render a LATER program's genuine type whose name equals a
/// former mangled name (`Point_dep_a_vibe` rendering as `Point`).
///
/// Accepted residual: a merge that never reaches desugar (a query helper
/// like closure_merged_stmt_count, or a check-only text merge) leaves its
/// entries behind until the next merge or desugar clears them. Mis-rendering
/// through that window needs a SUBSEQUENT single-file program that both
/// declares a type spelled exactly like one of those mangled names
/// (`X_dep_<sanitized-path>`) and derives Show on it, in the same process --
/// the growth is bounded (every driver resets on entry), and carrying the
/// mapping inside the AST instead is the invasive fix (#2205 option (c)) not
/// taken here.
let namespace_rename_originals: Array[(String, String)] = array_empty()

/// Reset the #2205 rename table. Called by each merge driver before it
/// populates, and by desugar_trait_dicts once the derive generators are done.
export fn namespace_rename_originals_reset() -> Unit {
  Array::truncate(namespace_rename_originals, 0)
}

/// #2205 (Codex round 4 on #2213): metadata-only replay of the private
/// type/constructor renames for a file whose merged TEXT came from a cache.
/// The merge that would have recorded the (mangled -> original) pairs never
/// runs on a cache hit, so the grouped merge replays just the recording
/// (the same collects the rename pass runs, minus any rewriting) to keep
/// derive(Show) rendering identical between cold and warm caches. Running
/// the collects on the RAW stmts is equivalent for this purpose: the value
/// rename that normally precedes them never changes a type or constructor
/// declaration name.
export fn record_namespace_rename_originals_for_file(path: String, stmts: Array[Stmt]) -> Unit {
  let namespace_suffix_box = [""]
  let exported = collect_exported_value_names(stmts)
  let type_renames = collect_private_type_renames(path, stmts, namespace_suffix_box, exported)
  let _ = collect_private_ctor_renames(path, stmts, type_renames, namespace_suffix_box, exported)
}

fn record_namespace_rename_original(original: String, mangled: String) -> Unit {
  Array::push(namespace_rename_originals, (mangled, original))
}

/// The source spelling of a possibly merge-renamed type/constructor name.
/// Returns the name unchanged when it was never renamed by this process.
export fn namespace_rename_original(name: String) -> String {
  let mut i = 0
  let mut found = name
  while i < Array::length(namespace_rename_originals) {
    let (mangled, original) = Array::get(namespace_rename_originals, i)
    if mangled == name {
      found = original
    } else {
      ()
    }
    i = i + 1
  }
  found
}

fn namespace_private_name_with_suffix(namespace_suffix: String, name: String) -> String {
  String::concat(name, String::concat("_dep_", namespace_suffix))
}

fn namespace_private_name_lazy(path: String, name: String, suffix_box: Array[String]) -> String {
  let current = Array::get(suffix_box, 0)
  let suffix = if String::length(current) == 0 {
    let sanitized = sanitize_namespace_path(path)
    Array::set(suffix_box, 0, sanitized)
    sanitized
  } else {
    current
  }
  namespace_private_name_with_suffix(suffix, name)
}

fn collect_exported_value_names(stmts: Array[Stmt]) -> Array[String] {
  let names = empty_strings()
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SLet(true, _, name, _, _) => if !string_array_contains(names, name) {
        Array::push(names, name)
      },
      SExport(items) => {
        let mut j = 0
        while j < Array::length(items) {
          let name = Array::get(items, j)
          if !string_array_contains(names, name) {
            Array::push(names, name)
          }
          j = j + 1
        }
      },
      _ => ()
    }
    i = i + 1
  }
  names
}

/// The names of types declared `export` in `stmts` (struct/enum/trait/alias/
/// suberror). A qualified method `Type::m` whose `Type` is exported is part of
/// that type's public surface, so it must NOT be module-private-renamed.
fn collect_exported_type_names(stmts: Array[Stmt]) -> Array[String] {
  let names = empty_strings()
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SStruct(true, name, _, _, _, _) => Array::push(names, name),
      SEnum(true, name, _, _, _) => Array::push(names, name),
      STrait(true, name, _, _, _, _) => Array::push(names, name),
      STypeAlias(true, name, _, _) => Array::push(names, name),
      SSuberror(true, name, _) => Array::push(names, name),
      _ => ()
    }
    i = i + 1
  }
  names
}

/// The names of ALL types declared in `stmts` (exported or not). Used with
/// collect_exported_type_names to decide which qualified methods are private.
fn collect_declared_type_names(stmts: Array[Stmt]) -> Array[String] {
  let names = empty_strings()
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SStruct(_, name, _, _, _, _) => Array::push(names, name),
      SEnum(_, name, _, _, _) => Array::push(names, name),
      STrait(_, name, _, _, _, _) => Array::push(names, name),
      STypeAlias(_, name, _, _) => Array::push(names, name),
      SSuberror(_, name, _) => Array::push(names, name),
      _ => ()
    }
    i = i + 1
  }
  names
}

/// A qualified `Head::member` value (an impl/trait method `let Type::m = ..`)
/// on a PUBLIC receiver type. Such methods are resolved globally by the
/// receiver type and are referenced unqualified by that type's name, so
/// path-suffixing them in an imported module (`Strm::next` -> `Strm::next$path`)
/// would orphan them from `Strm` — breaking method dispatch and the trait /
/// `for`-iterator desugar's `Type::method` lookup. Public means the head is
/// either exported from this module OR not declared in it at all — the latter
/// covers impls on BUILTIN types (`impl Iterable for Array` desugars to a
/// non-exported `let Array::iter_length = ..` whose head "Array" no module
/// declares; #736 hit this when the prelude's builtin Iterable impls were
/// private-renamed and orphaned from the witness dispatch). Only methods whose
/// head is a type declared in this module and NOT exported keep the old
/// whole-name renaming: that private type is itself renamed and its call sites
/// are rewritten through the same value-rename map, so they stay consistent.
fn qualified_method_of_exported_type(name: String, exported_types: Array[String], declared_types: Array[String]) -> Bool {
  let idx = String::index_of(name, "::")
  if idx < 0 {
    false
  } else {
    let head = String::substring(name, 0, idx)
    if string_array_contains(exported_types, head) {
      true
    } else {
      !string_array_contains(declared_types, head)
    }
  }
}

fn collect_private_value_renames(path: String, stmts: Array[Stmt], namespace_suffix_box: Array[String], exported: Array[String]) -> Array[(String, String)] {
  let renames = empty_aliases()
  let exported_types = collect_exported_type_names(stmts)
  let declared_types = collect_declared_type_names(stmts)
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SLet(false, _, name, _, _) => if !string_array_contains(exported, name) && !qualified_method_of_exported_type(name, exported_types, declared_types) {
        Array::push(renames, (name, namespace_private_name_lazy(path, name, namespace_suffix_box)))
      },
      SLetMut(name, _, _) => if !string_array_contains(exported, name) {
        Array::push(renames, (name, namespace_private_name_lazy(path, name, namespace_suffix_box)))
      },
      _ => ()
    }
    i = i + 1
  }
  renames
}

fn rewrite_private_type_expr(ty: TypeExpr, renames: Array[(String, String)]) -> TypeExpr {
  match ty {
    TyName(name) => match lookup_alias(renames, name) {
      Some(renamed) => TyName(renamed),
      None => ty
    },
    TyApp(name, args) => {
      let next_name = match lookup_alias(renames, name) {
        Some(renamed) => renamed,
        None => name
      }
      TyApp(next_name, for arg in args {
        rewrite_private_type_expr(arg, renames)
      })
    },
    TyFn(params, ret, effect_name) => TyFn(for param in params {
      rewrite_private_type_expr(param, renames)
    }, rewrite_private_type_expr(ret, renames), effect_name),
    TyTuple(items) => TyTuple(for item in items {
      rewrite_private_type_expr(item, renames)
    }),
    TyUnit => ty
  }
}

fn rewrite_private_type_opt(ty: Option[TypeExpr], renames: Array[(String, String)]) -> Option[TypeExpr] {
  match ty {
    Some(inner) => Some(rewrite_private_type_expr(inner, renames)),
    None => None
  }
}

fn rewrite_private_params(params: Array[(String, Option[TypeExpr])], type_renames: Array[(String, String)]) -> Array[(String, Option[TypeExpr])] {
  for param in params {
    let (name, ty) = param
    (name, rewrite_private_type_opt(ty, type_renames))
  }
}

fn rewrite_private_type_ctor_pat(pat: Pat, type_renames: Array[(String, String)], ctor_renames: Array[(String, String)]) -> Pat {
  match pat {
    PCtor(name, pats) => {
      let next_name = match lookup_alias(ctor_renames, name) {
        Some(renamed) => renamed,
        None => name
      }
      PCtor(next_name, for item in pats {
        rewrite_private_type_ctor_pat(item, type_renames, ctor_renames)
      })
    },
    PTuple(pats) => PTuple(for item in pats {
      rewrite_private_type_ctor_pat(item, type_renames, ctor_renames)
    }),
    POr(left, right) => POr(rewrite_private_type_ctor_pat(left, type_renames, ctor_renames), rewrite_private_type_ctor_pat(right, type_renames, ctor_renames)),
    PStruct(name, fields) => {
      let next_name = match lookup_alias(type_renames, name) {
        Some(renamed) => renamed,
        None => name
      }
      PStruct(next_name, for field in fields {
        let (field_name, field_pat) = field
        (field_name, rewrite_private_type_ctor_pat(field_pat, type_renames, ctor_renames))
      })
    },
    _ => pat
  }
}

fn rewrite_private_type_ctor_expr(expr: Expr, type_renames: Array[(String, String)], ctor_renames: Array[(String, String)]) -> Expr {
  match expr {
    EIdent(name, _) => match lookup_alias(ctor_renames, name) {
      Some(renamed) => EIdent(renamed, -1),
      None => expr
    },
    ETuple(items) => ETuple(for item in items {
      rewrite_private_type_ctor_expr(item, type_renames, ctor_renames)
    }),
    EArray(items) => EArray(for item in items {
      rewrite_private_type_ctor_expr(item, type_renames, ctor_renames)
    }),
    ERecord(rn, fields, targs) => {
      // #810: the struct-literal name now travels in the AST — rename it
      // alongside the type (same as PStruct below), or the checker's named
      // field validation would see the pre-rename spelling after merge.
      let next_rn = match lookup_alias(type_renames, rn) {
        Some(renamed) => renamed,
        None => rn
      }
      // #886: explicit struct type arguments are TypeExprs and may mention
      // renamed private types — rewrite them like any other type position.
      ERecord(next_rn, for field in fields {
        let (name, value) = field
        (name, rewrite_private_type_ctor_expr(value, type_renames, ctor_renames))
      }, for ta in targs {
        rewrite_private_type_expr(ta, type_renames)
      })
    },
    EIf(cond, then_expr, else_expr) => EIf(rewrite_private_type_ctor_expr(cond, type_renames, ctor_renames), rewrite_private_type_ctor_expr(then_expr, type_renames, ctor_renames), rewrite_private_type_ctor_expr(else_expr, type_renames, ctor_renames)),
    ELet(name, value, body, soff) => ELet(name, rewrite_private_type_ctor_expr(value, type_renames, ctor_renames), rewrite_private_type_ctor_expr(body, type_renames, alias_map_without_name(ctor_renames, name)), soff),
    ELetRec(name, value, body) => {
      let body_ctors = alias_map_without_name(ctor_renames, name)
      ELetRec(name, rewrite_private_type_ctor_expr(value, type_renames, body_ctors), rewrite_private_type_ctor_expr(body, type_renames, body_ctors))
    },
    ELetMut(name, value, body, soff) => ELetMut(name, rewrite_private_type_ctor_expr(value, type_renames, ctor_renames), rewrite_private_type_ctor_expr(body, type_renames, alias_map_without_name(ctor_renames, name)), soff),
    EAssign(name, value, body) => EAssign(name, rewrite_private_type_ctor_expr(value, type_renames, ctor_renames), rewrite_private_type_ctor_expr(body, type_renames, ctor_renames)),
    EAssignOp(name, op, value, body) => EAssignOp(name, op, rewrite_private_type_ctor_expr(value, type_renames, ctor_renames), rewrite_private_type_ctor_expr(body, type_renames, ctor_renames)),
    ESeq(left, right) => ESeq(rewrite_private_type_ctor_expr(left, type_renames, ctor_renames), rewrite_private_type_ctor_expr(right, type_renames, ctor_renames)),
    EMatch(scrutinee, arms) => EMatch(rewrite_private_type_ctor_expr(scrutinee, type_renames, ctor_renames), for arm in arms {
      let (pat, body) = arm
      let next_pat = rewrite_private_type_ctor_pat(pat, type_renames, ctor_renames)
      (next_pat, rewrite_private_type_ctor_expr(body, type_renames, alias_map_without_pat(ctor_renames, next_pat)))
    }),
    EHandle(body, arms) => EHandle(rewrite_private_type_ctor_expr(body, type_renames, ctor_renames), for arm in arms {
      let (pat, arm_body) = arm
      let next_pat = rewrite_private_type_ctor_pat(pat, type_renames, ctor_renames)
      (next_pat, rewrite_private_type_ctor_expr(arm_body, type_renames, alias_map_without_pat(ctor_renames, next_pat)))
    }),
    EWhile(cond, body) => EWhile(rewrite_private_type_ctor_expr(cond, type_renames, ctor_renames), rewrite_private_type_ctor_expr(body, type_renames, ctor_renames)),
    ELoop(params, body) => {
      let out_params = for param in params {
        let (name, init) = param
        (name, rewrite_private_type_ctor_expr(init, type_renames, ctor_renames))
      }
      let mut body_ctors = ctor_renames
      let mut i = 0
      while i < Array::length(params) {
        let (name, _) = Array::get(params, i)
        body_ctors = alias_map_without_name(body_ctors, name)
        i = i + 1
      }
      ELoop(out_params, rewrite_private_type_ctor_expr(body, type_renames, body_ctors))
    },
    EForIn(name, index_name, iter, body) => {
      let body_ctors = match index_name {
        Some(index_name) => alias_map_without_name(alias_map_without_name(ctor_renames, name), index_name),
        None => alias_map_without_name(ctor_renames, name)
      }
      EForIn(name, index_name, rewrite_private_type_ctor_expr(iter, type_renames, ctor_renames), rewrite_private_type_ctor_expr(body, type_renames, body_ctors))
    },
    ECall(callee, args, off) => ECall(rewrite_private_type_ctor_expr(callee, type_renames, ctor_renames), for arg in args {
      rewrite_private_type_ctor_expr(arg, type_renames, ctor_renames)
    }, off),
    EBinOp(op, left, right) => EBinOp(op, rewrite_private_type_ctor_expr(left, type_renames, ctor_renames), rewrite_private_type_ctor_expr(right, type_renames, ctor_renames)),
    EUnaryOp(op, value) => EUnaryOp(op, rewrite_private_type_ctor_expr(value, type_renames, ctor_renames)),
    EFn(type_params, bounds, params, ret_ty, effect, body) => EFn(type_params, bounds, rewrite_private_params(params, type_renames), rewrite_private_type_opt(ret_ty, type_renames), effect, rewrite_private_type_ctor_expr(body, type_renames, alias_map_without_params(ctor_renames, params))),
    EDot(obj, field, off, fdoff) => EDot(rewrite_private_type_ctor_expr(obj, type_renames, ctor_renames), field, off, fdoff),
    ELabeledArg(label, name, body) => ELabeledArg(label, name, rewrite_private_type_ctor_expr(body, type_renames, ctor_renames)),
    EReturn(value) => EReturn(rewrite_private_type_ctor_expr(value, type_renames, ctor_renames)),
    EBreak(value) => match value {
      Some(value) => EBreak(Some(rewrite_private_type_ctor_expr(value, type_renames, ctor_renames))),
      None => expr
    },
    EContinue(values) => EContinue(for value in values {
      rewrite_private_type_ctor_expr(value, type_renames, ctor_renames)
    }),
    EMap(fields) => EMap(for field in fields {
      let (name, value) = field
      (name, rewrite_private_type_ctor_expr(value, type_renames, ctor_renames))
    }),
    ESpread(value) => ESpread(rewrite_private_type_ctor_expr(value, type_renames, ctor_renames)),
    _ => expr
  }
}

fn collect_private_type_renames(path: String, stmts: Array[Stmt], namespace_suffix_box: Array[String], exported: Array[String]) -> Array[(String, String)] {
  let renames = empty_aliases()
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SEnum(false, name, _, _, _) => if !string_array_contains(exported, name) {
        let mangled = namespace_private_name_lazy(path, name, namespace_suffix_box)
        record_namespace_rename_original(name, mangled)
        Array::push(renames, (name, mangled))
      },
      SStruct(false, name, _, _, _, _) => if !string_array_contains(exported, name) {
        let mangled = namespace_private_name_lazy(path, name, namespace_suffix_box)
        record_namespace_rename_original(name, mangled)
        Array::push(renames, (name, mangled))
      },
      STypeAlias(false, name, _, _) => if !string_array_contains(exported, name) {
        Array::push(renames, (name, namespace_private_name_lazy(path, name, namespace_suffix_box)))
      },
      SSuberror(false, name, _) => if !string_array_contains(exported, name) {
        let mangled = namespace_private_name_lazy(path, name, namespace_suffix_box)
        record_namespace_rename_original(name, mangled)
        Array::push(renames, (name, mangled))
      },
      _ => ()
    }
    i = i + 1
  }
  renames
}

fn collect_private_ctor_renames(path: String, stmts: Array[Stmt], type_renames: Array[(String, String)], namespace_suffix_box: Array[String], exported: Array[String]) -> Array[(String, String)] {
  let renames = empty_aliases()
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SEnum(false, type_name, _, ctors, _) => if !string_array_contains(exported, type_name) {
        let mut j = 0
        while j < Array::length(ctors) {
          let (ctor_name, _) = Array::get(ctors, j)
          let mangled = namespace_private_name_lazy(path, ctor_name, namespace_suffix_box)
          record_namespace_rename_original(ctor_name, mangled)
          Array::push(renames, (ctor_name, mangled))
          j = j + 1
        }
      },
      SSuberror(false, type_name, ctors) => if !string_array_contains(exported, type_name) {
        let mut j = 0
        while j < Array::length(ctors) {
          let (ctor_name, _) = Array::get(ctors, j)
          let mangled = namespace_private_name_lazy(path, ctor_name, namespace_suffix_box)
          record_namespace_rename_original(ctor_name, mangled)
          Array::push(renames, (ctor_name, mangled))
          j = j + 1
        }
      },
      _ => ()
    }
    i = i + 1
  }
  type_renames
  renames
}

export fn namespace_private_value_stmts(path: String, stmts: Array[Stmt]) -> Array[Stmt] {
  let namespace_private_type_ctor_stmt_local: (Stmt, Array[(String, String)], Array[(String, String)]) -> Stmt = (stmt, type_renames, ctor_renames) -> {
    match stmt {
      SLet(exported, is_rec, name, ty, body) => SLet(exported, is_rec, name, rewrite_private_type_opt(ty, type_renames), rewrite_private_type_ctor_expr(body, type_renames, alias_map_without_name(ctor_renames, name))),
      SLetMut(name, ty, body) => SLetMut(name, rewrite_private_type_opt(ty, type_renames), rewrite_private_type_ctor_expr(body, type_renames, alias_map_without_name(ctor_renames, name))),
      SEnum(exported, name, params, ctors, derives) => {
        let next_name = if exported {
          name
        } else {
          match lookup_alias(type_renames, name) {
            Some(renamed) => renamed,
            None => name
          }
        }
        SEnum(exported, next_name, params, for ctor in ctors {
          let (ctor_name, args) = ctor
          let next_ctor = if exported {
            ctor_name
          } else {
            match lookup_alias(ctor_renames, ctor_name) {
              Some(renamed) => renamed,
              None => ctor_name
            }
          }
          (next_ctor, for arg in args {
            rewrite_private_type_expr(arg, type_renames)
          })
        }, derives)
      },
      SSuberror(exported, name, ctors) => {
        let next_name = if exported {
          name
        } else {
          match lookup_alias(type_renames, name) {
            Some(renamed) => renamed,
            None => name
          }
        }
        SSuberror(exported, next_name, for ctor in ctors {
          let (ctor_name, args) = ctor
          let next_ctor = if exported {
            ctor_name
          } else {
            match lookup_alias(ctor_renames, ctor_name) {
              Some(renamed) => renamed,
              None => ctor_name
            }
          }
          (next_ctor, for arg in args {
            rewrite_private_type_expr(arg, type_renames)
          })
        })
      },
      SStruct(exported, name, fields, derives, mut_fields, tparams) => {
        let next_name = if exported {
          name
        } else {
          match lookup_alias(type_renames, name) {
            Some(renamed) => renamed,
            None => name
          }
        }
        SStruct(exported, next_name, for field in fields {
          let (field_name, field_ty) = field
          (field_name, rewrite_private_type_expr(field_ty, type_renames))
        }, derives, mut_fields, tparams)
      },
      STypeAlias(exported, name, params, target) => {
        let next_name = if exported {
          name
        } else {
          match lookup_alias(type_renames, name) {
            Some(renamed) => renamed,
            None => name
          }
        }
        STypeAlias(exported, next_name, params, rewrite_private_type_expr(target, type_renames))
      },
      SImpl(tparams, bounds, trait_name, target_name) => {
        let next_target = match lookup_alias(type_renames, target_name) {
          Some(renamed) => renamed,
          None => target_name
        }
        SImpl(tparams, bounds, trait_name, next_target)
      },
      SExternLet(name, ty) => SExternLet(name, rewrite_private_type_expr(ty, type_renames)),
      STest(name, body) => STest(name, rewrite_private_type_ctor_expr(body, type_renames, ctor_renames)),
      SBench(name, body) => SBench(name, rewrite_private_type_ctor_expr(body, type_renames, ctor_renames)),
      SExpr(body) => SExpr(rewrite_private_type_ctor_expr(body, type_renames, ctor_renames)),
      SLetPat(pat, body) => {
        let next_pat = rewrite_private_type_ctor_pat(pat, type_renames, ctor_renames)
        SLetPat(next_pat, rewrite_private_type_ctor_expr(body, type_renames, alias_map_without_pat(ctor_renames, next_pat)))
      },
      SModule(exported, name, body_stmts) => SModule(exported, name, namespace_private_value_stmts(name, body_stmts)),
      SEffectDef(exported, name, params, ops) => SEffectDef(exported, name, params, for op in ops {
        let (op_name, op_params, ret_ty) = op
        (op_name, for param in op_params {
          rewrite_private_type_expr(param, type_renames)
        }, rewrite_private_type_expr(ret_ty, type_renames))
      }),
      _ => stmt
    }
  }
  let namespace_private_stmt_local: (Stmt, AliasIdx) -> Stmt = (stmt, ram) -> {
    match stmt {
      SLet(exported, is_rec, name, ty, body) => {
        let next_name = match MutMap::get(ram.idx, name) {
          Some(renamed) => renamed,
          None => name
        }
        SLet(exported, is_rec, next_name, ty, rewrite_alias_expr_ix(body, ram))
      },
      SLetMut(name, ty, body) => {
        let next_name = match MutMap::get(ram.idx, name) {
          Some(renamed) => renamed,
          None => name
        }
        SLetMut(next_name, ty, rewrite_alias_expr_ix(body, ram))
      },
      STest(name, body) => STest(name, rewrite_alias_expr_ix(body, ram)),
      SBench(name, body) => SBench(name, rewrite_alias_expr_ix(body, ram)),
      SExpr(body) => SExpr(rewrite_alias_expr_ix(body, ram)),
      SLetPat(pat, body) => SLetPat(pat, rewrite_alias_expr_ix(body, ram)),
      SModule(exported, name, body_stmts) => SModule(exported, name, namespace_private_value_stmts(name, body_stmts)),
      _ => stmt
    }
  }
  let namespace_suffix_box = [""]
  let exported = collect_exported_value_names(stmts)
  let renames = collect_private_value_renames(path, stmts, namespace_suffix_box, exported)
  let value_renamed = if Array::length(renames) == 0 {
    stmts
  } else {
    let ram = aliasidx_build(renames)
    for stmt in stmts {
      namespace_private_stmt_local(stmt, ram)
    }
  }
  let type_renames = collect_private_type_renames(path, value_renamed, namespace_suffix_box, exported)
  let ctor_renames = collect_private_ctor_renames(path, value_renamed, type_renames, namespace_suffix_box, exported)
  if Array::length(type_renames) == 0 && Array::length(ctor_renames) == 0 {
    value_renamed
  } else {
    for stmt in value_renamed {
      namespace_private_type_ctor_stmt_local(stmt, type_renames, ctor_renames)
    }
  }
}

fn namespace_private_type_ctor_stmt(stmt: Stmt, type_renames: Array[(String, String)], ctor_renames: Array[(String, String)]) -> Stmt {
  match stmt {
    SLet(exported, is_rec, name, ty, body) => SLet(exported, is_rec, name, rewrite_private_type_opt(ty, type_renames), rewrite_private_type_ctor_expr(body, type_renames, alias_map_without_name(ctor_renames, name))),
    SLetMut(name, ty, body) => SLetMut(name, rewrite_private_type_opt(ty, type_renames), rewrite_private_type_ctor_expr(body, type_renames, alias_map_without_name(ctor_renames, name))),
    SEnum(exported, name, params, ctors, derives) => {
      let next_name = if exported {
        name
      } else {
        match lookup_alias(type_renames, name) {
          Some(renamed) => renamed,
          None => name
        }
      }
      SEnum(exported, next_name, params, for ctor in ctors {
        let (ctor_name, args) = ctor
        let next_ctor = if exported {
          ctor_name
        } else {
          match lookup_alias(ctor_renames, ctor_name) {
            Some(renamed) => renamed,
            None => ctor_name
          }
        }
        (next_ctor, for arg in args {
          rewrite_private_type_expr(arg, type_renames)
        })
      }, derives)
    },
    SSuberror(exported, name, ctors) => {
      let next_name = if exported {
        name
      } else {
        match lookup_alias(type_renames, name) {
          Some(renamed) => renamed,
          None => name
        }
      }
      SSuberror(exported, next_name, for ctor in ctors {
        let (ctor_name, args) = ctor
        let next_ctor = if exported {
          ctor_name
        } else {
          match lookup_alias(ctor_renames, ctor_name) {
            Some(renamed) => renamed,
            None => ctor_name
          }
        }
        (next_ctor, for arg in args {
          rewrite_private_type_expr(arg, type_renames)
        })
      })
    },
    SStruct(exported, name, fields, derives, mut_fields, tparams) => {
      let next_name = if exported {
        name
      } else {
        match lookup_alias(type_renames, name) {
          Some(renamed) => renamed,
          None => name
        }
      }
      SStruct(exported, next_name, for field in fields {
        let (field_name, field_ty) = field
        (field_name, rewrite_private_type_expr(field_ty, type_renames))
      }, derives, mut_fields, tparams)
    },
    STypeAlias(exported, name, params, target) => {
      let next_name = if exported {
        name
      } else {
        match lookup_alias(type_renames, name) {
          Some(renamed) => renamed,
          None => name
        }
      }
      STypeAlias(exported, next_name, params, rewrite_private_type_expr(target, type_renames))
    },
    SImpl(tparams, bounds, trait_name, target_name) => {
      let next_target = match lookup_alias(type_renames, target_name) {
        Some(renamed) => renamed,
        None => target_name
      }
      SImpl(tparams, bounds, trait_name, next_target)
    },
    SExternLet(name, ty) => SExternLet(name, rewrite_private_type_expr(ty, type_renames)),
    STest(name, body) => STest(name, rewrite_private_type_ctor_expr(body, type_renames, ctor_renames)),
    SBench(name, body) => SBench(name, rewrite_private_type_ctor_expr(body, type_renames, ctor_renames)),
    SExpr(body) => SExpr(rewrite_private_type_ctor_expr(body, type_renames, ctor_renames)),
    SLetPat(pat, body) => {
      let next_pat = rewrite_private_type_ctor_pat(pat, type_renames, ctor_renames)
      SLetPat(next_pat, rewrite_private_type_ctor_expr(body, type_renames, alias_map_without_pat(ctor_renames, next_pat)))
    },
    SModule(exported, name, stmts) => SModule(exported, name, namespace_private_value_stmts(name, stmts)),
    SEffectDef(exported, name, params, ops) => SEffectDef(exported, name, params, for op in ops {
      let (op_name, op_params, ret_ty) = op
      (op_name, for param in op_params {
        rewrite_private_type_expr(param, type_renames)
      }, rewrite_private_type_expr(ret_ty, type_renames))
    }),
    _ => stmt
  }
}

fn namespace_private_stmt(stmt: Stmt, ram: AliasIdx) -> Stmt {
  match stmt {
    SLet(exported, is_rec, name, ty, body) => {
      let next_name = match MutMap::get(ram.idx, name) {
        Some(renamed) => renamed,
        None => name
      }
      SLet(exported, is_rec, next_name, ty, rewrite_alias_expr_ix(body, ram))
    },
    SLetMut(name, ty, body) => {
      let next_name = match MutMap::get(ram.idx, name) {
        Some(renamed) => renamed,
        None => name
      }
      SLetMut(next_name, ty, rewrite_alias_expr_ix(body, ram))
    },
    STest(name, body) => STest(name, rewrite_alias_expr_ix(body, ram)),
    SBench(name, body) => SBench(name, rewrite_alias_expr_ix(body, ram)),
    SExpr(body) => SExpr(rewrite_alias_expr_ix(body, ram)),
    SLetPat(pat, body) => SLetPat(pat, rewrite_alias_expr_ix(body, ram)),
    SModule(exported, name, stmts) => SModule(exported, name, namespace_private_value_stmts(name, stmts)),
    _ => stmt
  }
}

fn namespace_private_value_stmts_legacy_ordered(path: String, stmts: Array[Stmt]) -> Array[Stmt] {
  let namespace_suffix_box = [""]
  let exported = collect_exported_value_names(stmts)
  let renames = collect_private_value_renames(path, stmts, namespace_suffix_box, exported)
  let value_renamed = if Array::length(renames) == 0 {
    stmts
  } else {
    let ram = aliasidx_build(renames)
    for stmt in stmts {
      namespace_private_stmt(stmt, ram)
    }
  }
  let type_renames = collect_private_type_renames(path, value_renamed, namespace_suffix_box, exported)
  let ctor_renames = collect_private_ctor_renames(path, value_renamed, type_renames, namespace_suffix_box, exported)
  if Array::length(type_renames) == 0 && Array::length(ctor_renames) == 0 {
    value_renamed
  } else {
    for stmt in value_renamed {
      namespace_private_type_ctor_stmt(stmt, type_renames, ctor_renames)
    }
  }
}

//# #716 export-name visibility

// The merge flattens every file's top-level statements into one program, so a
// bare exported name used to be globally visible: two files exporting the
// same name collided (function-table first match, by merge order), an export
// shadowing a bare BUILTIN name (float.vibe's `eq`) raced the builtin
// fast-path in every file, and any file could call an export it never
// imported. The plan below renames EVERY exported value def of a non-entry
// file to `name_exp_<path>` at its defining file and rewrites the references
// of files that actually `import` it — full import visibility (#716): a name
// resolves exactly where it is imported (or defined). The ENTRY file's own
// defs and the names its re-export surface resolves to are never renamed:
// they are the program's wasm-export / linked-library ABI.

export fn namespace_exported_name(path: String, name: String) -> String {
  String::concat(name, String::concat("_exp_", sanitize_namespace_path(path)))
}

/// Top-level VALUE defs this file exports under a bare (unqualified) name:
/// `export let f` plus a plain `let f` listed in an `export { ... }` block.
/// Excludes qualified `Type::method` lets (dispatched globally by receiver
/// type), `let mut` globals (an `EAssign` target is a plain string the
/// expression rewriter cannot rename), and extern lets (host import names).
export fn collect_export_def_value_names(stmts: Array[Stmt]) -> Array[String] {
  let extern_names = empty_strings()
  let let_names = empty_strings()
  let exported_lets = empty_strings()
  let export_items = empty_strings()
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SLet(exported, _, name, _, _) => {
        Array::push(let_names, name)
        if exported {
          Array::push(exported_lets, name)
        } else {
          ()
        }
      },
      SExternLet(name, _) => Array::push(extern_names, name),
      SExport(items) => {
        let mut j = 0
        while j < Array::length(items) {
          Array::push(export_items, Array::get(items, j))
          j = j + 1
        }
      },
      _ => ()
    }
    i = i + 1
  }
  let out = empty_strings()
  let push_def_name: (String) -> Unit = (name) -> {
    if String::index_of(name, "::") < 0 && !string_array_contains(extern_names, name) && !string_array_contains(out, name) {
      Array::push(out, name)
    } else {
      ()
    }
  }
  let mut k = 0
  while k < Array::length(exported_lets) {
    push_def_name(Array::get(exported_lets, k))
    k = k + 1
  }
  let mut m = 0
  while m < Array::length(export_items) {
    let name = Array::get(export_items, m)
    if string_array_contains(let_names, name) {
      push_def_name(name)
    } else {
      ()
    }
    m = m + 1
  }
  out
}

export struct ExportRenamePlan {
  plan_paths: Array[String];
  rename_paths: Array[String];
  rename_names: Array[String];
  rename_mangled: Array[String];
  // #1259: (path, name) -> mangled index over the three parallel arrays
  // above (plan_rename_key encoding). Built once in build_export_rename_plan
  // -- which needs it for its own facade-closure fixpoint -- and reused by
  // collect_import_value_renames' per-import-item lookups.
  rename_idx: MutMap[String, String]
}

/// Composite key for rename_idx. '\n' can appear in neither a module path
/// nor a value name, so the encoding is collision-free.
fn plan_rename_key(path: String, name: String) -> String {
  String::concat(path, String::concat("\n", name))
}

/// Resolve a raw import path against the set of files in this merge; a
/// directory import (`import ./codegen/wasi { .. }`) has two candidates and we
/// pick the one that is actually part of the program.
fn resolve_known_import_path(known_paths: Array[String], base_dir: String, raw_path: String, self_path: String) -> String {
  let candidates = resolve_import_path_candidates(base_dir, raw_path)
  let mut chosen = ""
  let mut i = 0
  let mut found = false
  while i < Array::length(candidates) && !found {
    let candidate = Array::get(candidates, i)
    // Never resolve to the importing file itself (`export ./codegen` inside
    // codegen.vibe targets the directory) — mirrors header_cache/merge_sources.
    if candidate == self_path {
      i = i + 1
    } else {
      if chosen == "" {
        chosen = candidate
      } else {
        ()
      }
      if string_array_contains(known_paths, candidate) {
        chosen = candidate
        found = true
      } else {
        i = i + 1
      }
    }
  }
  if chosen == "" {
    Array::get(candidates, 0)
  } else {
    chosen
  }
}

fn plan_triple_lookup(tpaths: Array[String], tnames: Array[String], tvalues: Array[String], path: String, name: String) -> Option[String] {
  let mut i = 0
  let mut found = None
  while i < Array::length(tpaths) {
    if Array::get(tpaths, i) == path && Array::get(tnames, i) == name {
      found = Some(Array::get(tvalues, i))
      i = Array::length(tpaths)
    } else {
      i = i + 1
    }
  }
  found
}

/// Re-export edges of one file: `export ./dep.vibe { a, b as c }` plus the
/// `import { x } ... export { x }` facade idiom (an `export {}` item with no
/// local let def but a matching import). Pushed as parallel arrays
/// (from-path, public-name, target-path, target-name).
fn collect_reexport_edges_into(path: String, stmts: Array[Stmt], known_paths: Array[String], edge_from: Array[String], edge_pub: Array[String], edge_tpath: Array[String], edge_tname: Array[String]) -> Unit {
  let base_dir = dir_of_path(path)
  let let_names = empty_strings()
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SLet(_, _, name, _, _) => Array::push(let_names, name),
      SLetMut(name, _, _) => Array::push(let_names, name),
      _ => ()
    }
    i = i + 1
  }
  let import_refs = collect_import_refs(stmts)
  let mut si = 0
  while si < Array::length(stmts) {
    match Array::get(stmts, si) {
      SReExport(raw_path, items) => {
        let target = resolve_known_import_path(known_paths, base_dir, raw_path, path)
        let mut j = 0
        while j < Array::length(items) {
          let item = Array::get(items, j)
          let iname = item.name
          let alias_opt = item.alias
          let public_name = match alias_opt {
            Some(alias) => alias,
            None => iname
          }
          Array::push(edge_from, path)
          Array::push(edge_pub, public_name)
          Array::push(edge_tpath, target)
          Array::push(edge_tname, iname)
          j = j + 1
        }
      },
      SExport(items) => {
        let mut j = 0
        while j < Array::length(items) {
          let name = Array::get(items, j)
          if !string_array_contains(let_names, name) {
            let mut ri = 0
            let mut done = false
            while ri < Array::length(import_refs) && !done {
              let (raw_path, original, local) = Array::get(import_refs, ri)
              if local == name {
                Array::push(edge_from, path)
                Array::push(edge_pub, name)
                Array::push(edge_tpath, resolve_known_import_path(known_paths, base_dir, raw_path, path))
                Array::push(edge_tname, original)
                done = true
              } else {
                ri = ri + 1
              }
            }
          } else {
            ()
          }
          j = j + 1
        }
      },
      _ => ()
    }
    si = si + 1
  }
}

export fn build_export_rename_plan(paths: Array[String], stmts_list: Array[Array[Stmt]], entry_path: String) -> ExportRenamePlan {
  let file_count = Array::length(paths)
  let def_names_list = array_empty()
  let mut fi = 0
  while fi < file_count {
    Array::push(def_names_list, collect_export_def_value_names(Array::get(stmts_list, fi)))
    fi = fi + 1
  }
  let edge_from = empty_strings()
  let edge_pub = empty_strings()
  let edge_tpath = empty_strings()
  let edge_tname = empty_strings()
  let mut ei = 0
  while ei < file_count {
    collect_reexport_edges_into(Array::get(paths, ei), Array::get(stmts_list, ei), paths, edge_from, edge_pub, edge_tpath, edge_tname)
    ei = ei + 1
  }
  // The origins of the entry file's re-export surface are program ABI (wasm
  // export names of a linked library / component entry) and stay bare.
  let excluded_paths = empty_strings()
  let excluded_names = empty_strings()
  let file_idx_of: (String) -> Int = (path) -> {
    let mut i = 0
    let mut found = -1
    while i < file_count {
      if Array::get(paths, i) == path {
        found = i
        i = file_count
      } else {
        i = i + 1
      }
    }
    found
  }
  let mut xi = 0
  while xi < Array::length(edge_from) {
    if Array::get(edge_from, xi) == entry_path {
      let mut cur_path = Array::get(edge_tpath, xi)
      let mut cur_name = Array::get(edge_tname, xi)
      let mut depth = 0
      while depth < 16 {
        let idx = file_idx_of(cur_path)
        let is_def = if idx < 0 {
          false
        } else {
          string_array_contains(Array::get(def_names_list, idx), cur_name)
        }
        if is_def {
          Array::push(excluded_paths, cur_path)
          Array::push(excluded_names, cur_name)
          depth = 16
        } else {
          match plan_triple_lookup(edge_from, edge_pub, edge_tpath, cur_path, cur_name) {
            Some(next_path) => {
              match plan_triple_lookup(edge_from, edge_pub, edge_tname, cur_path, cur_name) {
                Some(next_name) => {
                  cur_path = next_path
                  cur_name = next_name
                  depth = depth + 1
                },
                None => {
                  depth = 16
                }
              }
            },
            None => {
              depth = 16
            }
          }
        }
      }
    } else {
      ()
    }
    xi = xi + 1
  }
  let rename_paths = empty_strings()
  let rename_names = empty_strings()
  let rename_mangled = empty_strings()
  let rename_idx: MutMap[String, String] = MutMap::new_string()
  let mut ri = 0
  while ri < file_count {
    let path = Array::get(paths, ri)
    if path == entry_path {
      ()
    } else {
      let def_names = Array::get(def_names_list, ri)
      let mut ni = 0
      while ni < Array::length(def_names) {
        let name = Array::get(def_names, ni)
        let excluded = match plan_triple_lookup(excluded_paths, excluded_names, excluded_names, path, name) {
          Some(_) => true,
          None => false
        }
        if excluded {
          ()
        } else {
          let mangled = namespace_exported_name(path, name)
          Array::push(rename_paths, path)
          Array::push(rename_names, name)
          Array::push(rename_mangled, mangled)
          let key = plan_rename_key(path, name)
          if !MutMap::has(rename_idx, key) {
            MutMap::set(rename_idx, key, mangled)
          } else {
            ()
          }
        }
        ni = ni + 1
      }
    }
    ri = ri + 1
  }
  // Entry re-export origins stay unmangled, so they were missing from
  // rename_idx and a nested public name could not close to the origin def.
  // Identity mappings let the facade-closure walk (and a same-file re-export
  // lookup) return the bare origin name.
  let mut oi = 0
  while oi < Array::length(excluded_paths) {
    let origin_path = Array::get(excluded_paths, oi)
    let origin_name = Array::get(excluded_names, oi)
    let origin_key = plan_rename_key(origin_path, origin_name)
    if !MutMap::has(rename_idx, origin_key) {
      MutMap::set(rename_idx, origin_key, origin_name)
    } else {
      ()
    }
    oi = oi + 1
  }
  // Close the rename table over re-export facades so an import THROUGH a
  // facade (`import ./index.vibe { eq }` where index re-exports float's `eq`)
  // resolves to the renamed origin in one lookup.
  let mut changed = true
  while changed {
    changed = false
    let mut ci = 0
    while ci < Array::length(edge_from) {
      let from = Array::get(edge_from, ci)
      let pub_name = Array::get(edge_pub, ci)
      if from == entry_path {
        ()
      } else {
        match MutMap::get(rename_idx, plan_rename_key(Array::get(edge_tpath, ci), Array::get(edge_tname, ci))) {
          Some(mangled) => {
            let from_key = plan_rename_key(from, pub_name)
            if MutMap::has(rename_idx, from_key) {
              ()
            } else {
              Array::push(rename_paths, from)
              Array::push(rename_names, pub_name)
              Array::push(rename_mangled, mangled)
              MutMap::set(rename_idx, from_key, mangled)
              changed = true
            }
          },
          None => ()
        }
      }
      ci = ci + 1
    }
  }
  ExportRenamePlan::{
    plan_paths: paths,
    rename_paths: rename_paths,
    rename_names: rename_names,
    rename_mangled: rename_mangled,
    rename_idx: rename_idx
  }
}

export fn export_plan_rename_count(plan: ExportRenamePlan) -> Int {
  Array::length(plan.rename_paths)
}

/// (name -> mangled) pairs for the defs of one file.
export fn export_plan_renames_for(plan: ExportRenamePlan, path: String) -> Array[(String, String)] {
  let out = empty_aliases()
  let rename_paths = plan.rename_paths
  let rename_names = plan.rename_names
  let rename_mangled = plan.rename_mangled
  let mut i = 0
  while i < Array::length(rename_paths) {
    if Array::get(rename_paths, i) == path {
      Array::push(out, (Array::get(rename_names, i), Array::get(rename_mangled, i)))
    } else {
      ()
    }
    i = i + 1
  }
  out
}

/// Deterministic text summary of the plan; callers fold it into merge cache
/// fingerprints so a rename-set change invalidates cached merged sources.
export fn export_plan_fingerprint_text(plan: ExportRenamePlan) -> String {
  let rename_paths = plan.rename_paths
  let rename_names = plan.rename_names
  let rename_mangled = plan.rename_mangled
  let buf = StringBuilder::new()
  StringBuilder::push(buf, "export-renames")
  let mut i = 0
  while i < Array::length(rename_paths) {
    StringBuilder::push(buf, "|")
    StringBuilder::push(buf, Array::get(rename_paths, i))
    StringBuilder::push(buf, ">")
    StringBuilder::push(buf, Array::get(rename_names, i))
    StringBuilder::push(buf, ">")
    StringBuilder::push(buf, Array::get(rename_mangled, i))
    i = i + 1
  }
  StringBuilder::freeze(buf)
}

fn collect_plan_item_renames(plan: ExportRenamePlan, base_dir: String, self_path: String, raw_path: String, items: Array[ImportItem], out: Array[(String, String)]) -> Unit {
  let target = resolve_known_import_path(plan.plan_paths, base_dir, raw_path, self_path)
  let mut j = 0
  while j < Array::length(items) {
    let item = Array::get(items, j)
    let original = item.name
    let alias_opt = item.alias
    let local = match alias_opt {
      Some(alias) => alias,
      None => original
    }
    if String::index_of(original, "::") < 0 {
      match MutMap::get(plan.rename_idx, plan_rename_key(target, original)) {
        Some(mangled) => alias_map_put_last(out, local, mangled),
        None => ()
      }
    } else {
      ()
    }
    j = j + 1
  }
}

/// (local -> mangled-or-origin) reference renames for one file, derived from
/// its `import` and re-export statements against the plan. Last bind wins,
/// matching `env_bind` prepend / `env_lookup` first-match in the checker.
export fn collect_import_value_renames(plan: ExportRenamePlan, path: String, stmts: Array[Stmt]) -> Array[(String, String)] {
  let out = empty_aliases()
  let base_dir = dir_of_path(path)
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SImport(raw_path, items) => collect_plan_item_renames(plan, base_dir, path, raw_path, items, out),
      SReExport(raw_path, items) => collect_plan_item_renames(plan, base_dir, path, raw_path, items, out),
      _ => ()
    }
    i = i + 1
  }
  out
}

export fn import_value_rename_locals(renames: Array[(String, String)]) -> Array[String] {
  let out = empty_strings()
  let mut i = 0
  while i < Array::length(renames) {
    let (local, _) = Array::get(renames, i)
    Array::push(out, local)
    i = i + 1
  }
  out
}

/// Apply (name -> mangled) def renames to one file's statements: SLet def
/// names, `export { ... }` items, and every value reference (shadow-aware via
/// rewrite_import_alias_expr).
export fn apply_export_renames_stmts(stmts: Array[Stmt], renames: Array[(String, String)]) -> Array[Stmt] {
  if Array::length(renames) == 0 {
    stmts
  } else {
    let am = aliasidx_build(renames)
    for stmt in stmts {
      match stmt {
        SLet(exported, is_rec, name, ty, body) => {
          let next_name = match MutMap::get(am.idx, name) {
            Some(renamed) => renamed,
            None => name
          }
          SLet(exported, is_rec, next_name, ty, rewrite_alias_expr_ix(body, am))
        },
        SLetMut(name, ty, body) => SLetMut(name, ty, rewrite_alias_expr_ix(body, am)),
        SExport(items) => SExport(for item in items {
          match MutMap::get(am.idx, item) {
            Some(renamed) => renamed,
            None => item
          }
        }),
        STest(name, body) => STest(name, rewrite_alias_expr_ix(body, am)),
        SBench(name, body) => SBench(name, rewrite_alias_expr_ix(body, am)),
        SExpr(body) => SExpr(rewrite_alias_expr_ix(body, am)),
        SLetPat(pat, body) => SLetPat(pat, rewrite_alias_expr_ix(body, am)),
        _ => stmt
      }
    }
  }
}

/// `export let eq: (Float, Float) -> Bool = float_eq` binds a NAME to another
/// top-level function. The backend function tables register such non-EFn lets
/// as 0-parameter thunks, so a CALL through the alias emits N arguments
/// against a 0-param function — invalid wasm (stack imbalance), on every
/// backend and for any arity (found while fixing #716: @vibe/builtin/float.vibe
/// exports its whole API this way). Rewrite every reference to a top-level
/// function alias (chains followed, ≤16) to the final EFn def's name. The
/// alias def itself stays: it is inert once nothing refers to it, and its
/// export flag keeps the wasm export surface unchanged.
export fn rewrite_top_level_fn_alias_refs(stmts: Array[Stmt]) -> Unit {
  let fn_names = empty_strings()
  let alias_names = empty_strings()
  let alias_targets = empty_strings()
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SLet(_, _, name, _, expr) => match expr {
        EFn(_, _, _, _, _, _) => Array::push(fn_names, name),
        EIdent(target, _) => {
          Array::push(alias_names, name)
          Array::push(alias_targets, target)
        },
        _ => ()
      },
      _ => ()
    }
    i = i + 1
  }
  if Array::length(alias_names) == 0 {
    ()
  } else {
    let renames = empty_aliases()
    let mut ai = 0
    while ai < Array::length(alias_names) {
      let mut target = Array::get(alias_targets, ai)
      let mut final_target = ""
      let mut depth = 0
      while depth < 16 {
        if string_array_contains(fn_names, target) {
          final_target = target
          depth = 16
        } else {
          let mut hop = false
          let mut aj = 0
          while aj < Array::length(alias_names) && !hop {
            if Array::get(alias_names, aj) == target {
              target = Array::get(alias_targets, aj)
              hop = true
            } else {
              aj = aj + 1
            }
          }
          if hop {
            depth = depth + 1
          } else {
            depth = 16
          }
        }
      }
      if final_target != "" && final_target != Array::get(alias_names, ai) {
        Array::push(renames, (Array::get(alias_names, ai), final_target))
      } else {
        ()
      }
      ai = ai + 1
    }
    if Array::length(renames) == 0 {
      ()
    } else {
      let ram = aliasidx_build(renames)
      let mut si = 0
      while si < Array::length(stmts) {
        match Array::get(stmts, si) {
          SLet(exported, is_rec, name, ty, body) => Array::set(stmts, si, SLet(exported, is_rec, name, ty, rewrite_alias_expr_ix(body, ram))),
          SLetMut(name, ty, body) => Array::set(stmts, si, SLetMut(name, ty, rewrite_alias_expr_ix(body, ram))),
          STest(name, body) => Array::set(stmts, si, STest(name, rewrite_alias_expr_ix(body, ram))),
          SBench(name, body) => Array::set(stmts, si, SBench(name, rewrite_alias_expr_ix(body, ram))),
          SExpr(body) => Array::set(stmts, si, SExpr(rewrite_alias_expr_ix(body, ram))),
          SLetPat(pat, body) => Array::set(stmts, si, SLetPat(pat, rewrite_alias_expr_ix(body, ram))),
          _ => ()
        }
        si = si + 1
      }
    }
  }
}

/// Like append_import_alias_rewritten_non_import_stmts_skipping, but with
/// extra (local -> mangled) import-value renames applied in the same pass.
/// Locals covered by `extra_renames` are removed from the legacy alias map
/// (which would rewrite alias -> original instead).
export fn append_import_alias_rewritten_non_import_stmts_with_renames(merged: Array[Stmt], stmts: Array[Stmt], skipped_locals: Array[String], extra_renames: Array[(String, String)]) -> Unit {
  let legacy = alias_map_without_names(alias_map_without_names(collect_import_aliases(stmts), skipped_locals), import_value_rename_locals(extra_renames))
  let combined = empty_aliases()
  let mut li = 0
  while li < Array::length(legacy) {
    Array::push(combined, Array::get(legacy, li))
    li = li + 1
  }
  let mut xi = 0
  while xi < Array::length(extra_renames) {
    Array::push(combined, Array::get(extra_renames, xi))
    xi = xi + 1
  }
  let should_rewrite = Array::length(combined) > 0
  let am = aliasidx_build(combined)
  let mut i = 0
  while i < Array::length(stmts) {
    let stmt = Array::get(stmts, i)
    match stmt {
      SImport(_, items) => append_stdin_provider_import_alias_markers(merged, items),
      SReExport(_, _) => (),
      SAliasDecl(_, _) => (),
      SModule(_, _, _) => Array::push(merged, rewrite_alias_stmt_ix(stmt, am)),
      _ => if should_rewrite {
        Array::push(merged, rewrite_alias_stmt_ix(stmt, am))
      } else {
        Array::push(merged, stmt)
      }
    }
    i = i + 1
  }
}
