import ./ast.vibe {
  Expr, Stmt
}

import ./expr_children.vibe {
  expr_child_at, expr_children_pop, expr_children_push, expr_children_top
}

import ./polyfill.vibe {
  __to_string
}

import ./typed_lowering_rows.vibe {
  lowering_row_encode
}

import @vibe/core {
  struct MutMap
}

// A suffix leaves the callee's operation in slot zero. Checked placements
// contain no pool IDs or AST nodes, so a cell can cross a process boundary.
export let param_names_prefix: String = "#params:"

let placement_marker: Int = -3660
let wanted_names: Array[MutMap[String, Bool]] = [MutMap::new_string()]
let wanted_methods: Array[MutMap[String, Bool]] = [MutMap::new_string()]
let checked_cells: Array[(Int, Array[Int])] = []

/// One checker run: forget the previous run's placements and demand.
export fn call_placement_capture_begin() -> Unit {
  Array::truncate(checked_cells, 0)
  Array::set(wanted_names, 0, MutMap::new_string())
  Array::set(wanted_methods, 0, MutMap::new_string())
}

export fn call_placement_capture_end() -> Unit {
  ()
}

/// Demand is an allocation filter, never callee resolution. The checker
/// still queries the actual TypeEnv binding at every call it places.
export fn call_placement_wants_binding(name: String) -> Bool {
  if MutMap::has(Array::get(wanted_names, 0), name) {
    true
  } else {
    let cut = String::last_index_of(name, "::")
    cut >= 0 && MutMap::has(Array::get(wanted_methods, 0), name[cut + 2: String::length(name)])
  }
}

// Roles: 1 checked placement over the written arguments, 2/3 refusal,
// 4 lowered, 5 placed by the checker (the stored arguments are in declared
// order; lowering still owes the written-order temporaries). A cell of role
// 4 or 5 is never shared with a written call: the passes that rewrite a call
// to its placed form give it a fresh cell (`call_placement_copy`), because a
// memoized parse shares its cells with every later compile of the same text.
export fn call_placement_cell_prefix(cell: Array[Int], start: Int) -> Bool {
  Array::length(cell) >= start + 3 && Array::get(cell, start + 1) == placement_marker && Array::get(cell, start + 2) >= 1 && Array::get(cell, start + 2) <= 5
}

fn placement_role(cell: Array[Int]) -> Int {
  if call_placement_cell_prefix(cell, 0) {
    Array::get(cell, 2)
  } else {
    -1
  }
}

fn placement_begin(cell: Array[Int], role: Int) -> Unit {
  if Array::length(cell) == 0 {
    Array::push(cell, 0)
  } else {
    Array::truncate(cell, 1)
  }
  Array::push(cell, placement_marker)
  Array::push(cell, role)
}

export fn call_placement_get(cell: Array[Int]) -> Option[(Int, Int, Array[Int])] {
  let role = placement_role(cell)
  if (role == 1 || role == 4 || role == 5) && Array::length(cell) >= 5 {
    Some((Array::get(cell, 3), Array::get(cell, 4), Array::slice(cell, 5, Array::length(cell))))
  } else {
    None
  }
}

fn placement_call_name(callee: Expr) -> String {
  match callee {
    EIdent(name, _) => name,
    EDot(_, name, _, _) => name,
    _ => "<call>"
  }
}

fn placement_refusal_message(cell: Array[Int], callee: Expr, offset: Int) -> String {
  let mut name = placement_call_name(callee)
  let mut at = offset
  let mut disagreement = false
  if Array::length(cell) >= 5 && call_placement_is_refused(cell) {
    at = Array::get(cell, 3)
    disagreement = Array::get(cell, 4) == 1
    let text = StringBuilder::new()
    let mut i = 5
    while i < Array::length(cell) {
      StringBuilder::push(text, String::from_char_code(Array::get(cell, i)))
      i = i + 1
    }
    name = StringBuilder::freeze(text)
  } else {
    ()
  }
  if disagreement {
    "labeled argument placement disagrees with the checker for `" + name + "` at byte " + __to_string(at) + "; rebuild from checked source instead of using a different argument order"
  } else {
    "missing or invalid checker argument placement for `" + name + "` at byte " + __to_string(at) + "; check this source before lowering it"
  }
}

export fn call_placement_install(cell: Array[Int], written: Int, mode: Int, slots: Array[Int]) -> Unit {
  placement_begin(cell, 1)
  Array::push(cell, written)
  Array::push(cell, mode)
  for slot in slots {
    Array::push(cell, slot)
  }
  ()
}

/// A variable-length packet avoids a fixed arity limit or bit-packed source
/// indices. Only the header/footer have coordinates; payload rows never rebase.
export fn call_placement_append_rows(rows: Array[Int], offset: Int, cell: Array[Int]) -> Unit {
  if offset >= 0 {
    match call_placement_get(cell) {
      Some((written, mode, slots)) => {
        Array::push(rows, lowering_row_encode(offset, 8))
        Array::push(rows, lowering_row_encode(written, 9))
        Array::push(rows, lowering_row_encode(mode, 10))
        for slot in slots {
          Array::push(rows, lowering_row_encode(slot, 11))
        }
        Array::push(rows, lowering_row_encode(offset, 12))
      },
      None => ()
    }
  } else {
    ()
  }
}

export fn call_placement_refuse(cell: Array[Int], invalid: Bool) -> Unit {
  placement_begin(cell, if invalid {
    3
  } else {
    2
  })
}

export fn call_placement_checked_rows() -> Array[Int] {
  let rows = [13]
  for entry in checked_cells {
    let (offset, cell) = entry
    call_placement_append_rows(rows, offset, cell)
  }
  rows
}

/// Precheck macros consume a call's arguments positionally. A checked
/// placement that moves or fills an argument cannot survive that, so the cell
/// -- which the macro's replacement keeps -- is refused, by the call's name,
/// and lowering reports it there.
export fn call_placement_note_positional(callee: Expr, args: Array[Expr], offset: Int, cell: Array[Int]) -> Unit {
  match call_placement_get(cell) {
    Some((written, mode, slots)) => if placement_role(cell) == 1 && mode == 0 && !placement_is_identity(written, slots, Array::length(args)) {
      placement_refuse_named(cell, callee, offset)
    } else {
      ()
    },
    None => ()
  }
}

fn placement_refuse_named(cell: Array[Int], callee: Expr, offset: Int) -> Unit {
  placement_begin(cell, 3)
  Array::push(cell, offset)
  Array::push(cell, 0)
  let name = placement_call_name(callee)
  let mut i = 0
  while i < String::length(name) {
    Array::push(cell, String::char_code_at(name, i))
    i = i + 1
  }
}

fn placement_is_identity(written: Int, slots: Array[Int], count: Int) -> Bool {
  let mut same = written == count && Array::length(slots) == count
  let mut i = 0
  while i < Array::length(slots) && same {
    same = Array::get(slots, i) == (i + 1) * 2
    i = i + 1
  }
  same
}

export fn call_placement_is_refused(cell: Array[Int]) -> Bool {
  placement_role(cell) == 2 || placement_role(cell) == 3
}

export fn call_placement_is_canonical(cell: Array[Int]) -> Bool {
  placement_role(cell) == 4
}

fn placement_slots_valid(written: Int, mode: Int, slots: Array[Int], start: Int) -> Bool {
  let used: MutMap[Int, Bool] = MutMap::new_int()
  let mut valid = written >= 0 && (mode >= 0 && mode <= 2)
  let mut count = 0
  let mut i = start
  while i < Array::length(slots) && valid {
    let slot = Array::get(slots, i)
    if slot == 0 {
      ()
    } else if slot < 2 {
      valid = false
    } else {
      let source = slot / 2 - 1
      if source >= written || MutMap::has(used, source) {
        valid = false
      } else {
        MutMap::set(used, source, true)
        count = count + 1
      }
    }
    if mode != 0 && slot != (i - start + 1) * 2 {
      valid = false
    } else {
      ()
    }
    i = i + 1
  }
  valid && count == written && (mode == 0 || Array::length(slots) - start == written)
}

/// One payload grammar serves source-row restoration and binary AST transport.
export fn call_placement_payload_valid(written: Int, mode: Int, slots: Array[Int]) -> Bool {
  placement_slots_valid(written, mode, slots, 0)
}

/// Raw snapshot pool IDs cannot cross a process boundary. Checked/expected
/// placements and explicit refusals retain their validated payload instead.
export fn call_placement_wire_valid(cell: Array[Int], start: Int) -> Bool {
  if start < 0 || !call_placement_cell_prefix(cell, start) {
    false
  } else {
    let role = Array::get(cell, start + 2)
    if role == 1 || role == 4 || role == 5 {
      Array::length(cell) >= start + 5 && placement_slots_valid(Array::get(cell, start + 3), Array::get(cell, start + 4), cell, start + 5)
    } else if role == 2 || role == 3 {
      if Array::length(cell) == start + 3 {
        true
      }
      else if Array::length(cell) < start + 5 {
        false
      }
      else {
        let mut valid = Array::get(cell, start + 3) >= 0 - 1 && (Array::get(cell, start + 4) == 0 || Array::get(cell, start + 4) == 1)
        let mut i = start + 5
        while i < Array::length(cell) && valid {
          let byte = Array::get(cell, i)
          valid = byte >= 0 && byte <= 255
          i = i + 1
        }
        valid
      }
    } else {
      false
    }
  }
}

/// The call's arguments are still as written, and its cell holds the checked
/// placement that orders them.
export fn call_placement_is_written(cell: Array[Int]) -> Bool {
  placement_role(cell) == 1 && Array::length(cell) >= 5
}

/// The checker already placed the stored arguments.
export fn call_placement_is_placed(cell: Array[Int]) -> Bool {
  placement_role(cell) == 5
}

/// A fresh cell for the rewritten call: the same operation and placement,
/// under `role`. The written call keeps its own cell untouched.
export fn call_placement_copy(cell: Array[Int], role: Int) -> Array[Int] {
  let out = for item in cell {
    item
  }
  if call_placement_cell_prefix(out, 0) {
    Array::set(out, 2, role)
  } else {
    ()
  }
  out
}

/// ADR-0120 Phase 1c (#3661): the checker records the placement it resolved
/// from the call's binding, over the arguments as written. A cell the checker
/// already placed (role 5) or lowering already lowered (role 4) belongs to a
/// rewritten call and keeps its payload, which is still the written one.
export fn call_placement_record(cell: Array[Int], offset: Int, written: Int, mode: Int, slots: Array[Int]) -> Unit {
  let role = placement_role(cell)
  if role == 4 || role == 5 {
    ()
  } else {
    call_placement_install(cell, written, mode, slots)
  }
  if offset >= 0 {
    Array::push(checked_cells, (offset, cell))
  } else {
    ()
  }
}

/// The edit for a call that reached lowering with labels and no checked
/// placement, or with a refused one.
export fn call_placement_lowering_refusal(cell: Array[Int], callee: Expr, offset: Int) -> String {
  placement_refusal_message(cell, callee, offset)
}

fn placement_value(arg: Expr) -> Expr {
  match arg {
    ELabeledArg(_, _, value) => value,
    _ => arg
  }
}

/// The declared-order argument list of a mode-0 placement: slot 0 omits the
/// parameter (`None`), an even slot `2 * (source + 1)` takes that written
/// argument without its label, an odd one wraps it in `Some(..)`. The checker
/// types exactly these nodes, and the passes after it store them.
export fn call_placement_build(written: Array[Expr], slots: Array[Int]) -> Array[Expr] {
  let out: Array[Expr] = []
  for slot in slots {
    if slot == 0 {
      Array::push(out, EIdent("None", 0 - 1))
    } else {
      let value = placement_value(Array::get(written, slot / 2 - 1))
      if slot - (slot / 2) * 2 == 1 {
        Array::push(out, ECall(EIdent("Some", 0 - 1), [value], 0 - 1, []))
      } else {
        Array::push(out, value)
      }
    }
  }
  out
}

/// The written arguments of a call already placed, read back off its placed
/// arguments and slots (an omitted slot wrote nothing; a wrapped one wrote
/// the `Some` payload). Labels are gone, which is all lowering needs: the
/// written order of evaluation.
export fn call_placement_written_of(placed: Array[Expr], written: Int, slots: Array[Int]) -> Array[Expr] {
  let out: Array[Expr] = []
  let mut wi = 0
  while wi < written {
    Array::push(out, EUnit)
    wi = wi + 1
  }
  let mut pj = 0
  while pj < Array::length(slots) && pj < Array::length(placed) {
    let slot = Array::get(slots, pj)
    if slot > 0 && slot / 2 - 1 < written {
      let arg = Array::get(placed, pj)
      let value = if slot - (slot / 2) * 2 == 1 {
        match arg {
          ECall(EIdent(ctor, _), wrapped, _, _) => if ctor == "Some" && Array::length(wrapped) == 1 {
            Array::get(wrapped, 0)
          } else {
            arg
          },
          _ => arg
        }
      } else {
        arg
      }
      Array::set(out, slot / 2 - 1, value)
    } else {
      ()
    }
    pj = pj + 1
  }
  out
}

fn placement_demand_expr(expr: Expr) -> Unit {
  match expr {
    ECall(callee, args, _, _) => {
      let mut labeled = false
      for arg in args {
        match arg {
          ELabeledArg(_, _, _) => labeled = true,
          _ => ()
        }
      }
      if labeled {
        match callee {
          EIdent(name, _) => MutMap::set(Array::get(wanted_names, 0), name, true),
          EDot(EIdent(ns, _), name, _, _) => {
            MutMap::set(Array::get(wanted_names, 0), ns + "." + name, true)
            MutMap::set(Array::get(wanted_methods, 0), name, true)
          },
          EDot(_, name, _, _) => MutMap::set(Array::get(wanted_methods, 0), name, true),
          _ => ()
        }
      } else {
        ()
      }
    },
    _ => ()
  }
  let mark = expr_children_push(expr)
  let end = expr_children_top()
  let mut i = mark
  while i < end {
    placement_demand_expr(expr_child_at(i))
    i = i + 1
  }
  expr_children_pop(mark)
}

/// Which bindings a labeled call names, so the checker keeps their parameter
/// headers. An allocation filter only: the checker resolves every call's
/// callee in its own environment (`call_placement_wants_binding`).
export fn call_placement_demand_scan(stmts: Array[Stmt]) -> Unit {
  for stmt in stmts {
    match stmt {
      SLet(_, _, _, _, body) => placement_demand_expr(body),
      SLetMut(_, _, body) => placement_demand_expr(body),
      SLetPat(_, body) => placement_demand_expr(body),
      SExpr(body) => placement_demand_expr(body),
      STest(_, body) => placement_demand_expr(body),
      SBench(_, body) => placement_demand_expr(body),
      SExample(_, body) => placement_demand_expr(body),
      SFnDecl(_, _, body, _, _) => placement_demand_expr(body),
      SModule(_, _, children) => call_placement_demand_scan(children),
      _ => ()
    }
  }
  ()
}
