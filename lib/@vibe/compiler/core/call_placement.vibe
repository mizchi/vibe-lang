import ./ast.vibe {
  Expr
}

import ./polyfill.vibe {
  __to_string
}

import ./typed_lowering_rows.vibe {
  lowering_row_encode
}

// A suffix leaves the callee's operation in slot zero. Raw snapshots exist
// only during one check; checked placements contain no pool IDs or AST nodes.
export let param_names_prefix: String = "#params:"

let placement_marker: Int = -3660
let capture_epoch: Array[Int] = [0]
let capture_active: Array[Bool] = [false]
let raw_calls: Array[(Expr, Array[Expr], Bool, Int)] = []
let checked_cells: Array[(Int, Array[Int])] = []

export fn call_placement_capture_begin() -> Unit {
  Array::truncate(raw_calls, length = 0)
  Array::truncate(checked_cells, length = 0)
  Array::set(capture_epoch, at = 0, value = Array::get(capture_epoch, at = 0) + 1)
  Array::set(capture_active, at = 0, value = true)
}

export fn call_placement_capture_end() -> Unit {
  Array::set(capture_active, at = 0, value = false)
}

export fn call_placement_cell_prefix(cell: Array[Int], start: Int) -> Bool {
  Array::length(cell) >= start + 3 && Array::get(cell, at = start + 1) == placement_marker && Array::get(cell, at = start + 2) >= 0 && Array::get(cell, at = start + 2) <= 4
}

fn placement_role(_ cell: Array[Int]) -> Int {
  if call_placement_cell_prefix(cell = cell, start = 0) {
    Array::get(cell, at = 2)
  } else {
    -1
  }
}

fn placement_begin(cell: Array[Int], role: Int) -> Unit {
  if Array::length(cell) == 0 {
    Array::push(cell, value = 0)
  } else {
    Array::truncate(cell, length = 1)
  }
  Array::push(cell, value = placement_marker)
  Array::push(cell, value = role)
}

/// Unlocated calls have distinct cells too. An epoch and pool ID avoid
/// conflating all of their -1 offsets, or reading a previous check's pool.
export fn call_placement_raw(_ cell: Array[Int]) -> Option[(Expr, Array[Expr], Bool, Int)] {
  if placement_role(cell) == 0 && Array::length(cell) == 5 && Array::get(cell, at = 3) == Array::get(capture_epoch, at = 0) {
    let id = Array::get(cell, at = 4)
    if id >= 0 && id < Array::length(raw_calls) {
      Some(Array::get(raw_calls, at = id))
    } else {
      None
    }
  } else {
    None
  }
}

export fn call_placement_get(_ cell: Array[Int]) -> Option[(Int, Int, Array[Int])] {
  if (placement_role(cell) == 1 || placement_role(cell) == 4) && Array::length(cell) >= 5 {
    Some((Array::get(cell, at = 3), Array::get(cell, at = 4), Array::slice(cell, start = 5, end = Array::length(cell))))
  } else {
    None
  }
}

fn placement_call_name(_ callee: Expr) -> String {
  match callee {
    EIdent(name, _) => name,
    EDot(_, name, _, _) => name,
    _ => "<call>"
  }
}

fn placement_disagreement(callee: Expr, offset: Int) -> String {
  "labeled argument placement disagrees with the checker for `" + placement_call_name(callee) + "` at byte " + __to_string(offset) + "; rebuild from checked source instead of using a different argument order"
}

// Keep a refusal with its owning call cell: later macro passes can replace
// the call and reset their scratch buffers without losing its source name.
fn placement_refuse_named(cell: Array[Int], callee: Expr, offset: Int, disagreement: Bool) -> Unit {
  let role = if disagreement {
    3
  } else {
    placement_role(cell)
  }
  placement_begin(cell = cell, role = if role == 2 {
    2
  } else {
    3
  })
  Array::push(cell, value = offset)
  Array::push(cell, value = if disagreement {
    1
  } else {
    0
  })
  let name = placement_call_name(callee)
  let mut i = 0
  while i < String::length(name) {
    Array::push(cell, value = String::char_code_at(name, at = i))
    i = i + 1
  }
}

fn placement_refusal_message(cell: Array[Int], callee: Expr, offset: Int) -> String {
  let mut name = placement_call_name(callee)
  let mut at = offset
  let mut disagreement = false
  if Array::length(cell) >= 5 {
    at = Array::get(cell, at = 3)
    disagreement = Array::get(cell, at = 4) == 1
    let text = StringBuilder::new()
    let mut i = 5
    while i < Array::length(cell) {
      StringBuilder::push(text, value = String::from_char_code(Array::get(cell, at = i)))
      i = i + 1
    }
    name = StringBuilder::freeze(text)
  } else {
    placement_refuse_named(cell = cell, callee = callee, offset = offset, disagreement = false)
  }
  if disagreement {
    "labeled argument placement disagrees with the checker for `" + name + "` at byte " + __to_string(at) + "; rebuild from checked source instead of using a different argument order"
  } else {
    "missing or invalid checker argument placement for `" + name + "` at byte " + __to_string(at) + "; check this source before lowering it"
  }
}

/// Capture source structure only. Callee resolution and slot selection belong
/// to call typing, after the actual value binding has been selected.
export fn call_placement_capture_source(callee: Expr, args: Array[Expr], offset: Int, cell: Array[Int], macro_call: Bool) -> Unit {
  if Array::get(capture_active, at = 0) && (call_placement_raw(cell) is None) {
    let id = Array::length(raw_calls)
    Array::push(raw_calls, value = (callee, args, macro_call, offset))
    placement_begin(cell = cell, role = 0)
    Array::push(cell, value = Array::get(capture_epoch, at = 0))
    Array::push(cell, value = id)
  } else {
    ()
  }
}

/// Publish the placement selected by typing. A macro has already consumed
/// positional slots, so certify its fixed layout before retaining that fact.
export fn call_placement_publish(callee: Expr, offset: Int, cell: Array[Int], written: Int, mode: Int, slots: Array[Int], errors: Array[String]) -> Unit {
  let applied = match call_placement_raw(cell) {
    Some((_, _, macro_call, _)) => macro_call,
    None => false
  }
  let mut valid = true
  if applied {
    valid = Array::length(slots) == written
    let mut i = 0
    while i < Array::length(slots) {
      valid = valid && Array::get(slots, at = i) == (i + 1) * 2; i = i + 1
    }
  } else {
    ()
  }
  call_placement_install(cell = cell, written = written, mode = mode, slots = slots)
  if !valid {
    Array::push(errors, value = placement_disagreement(callee = callee, offset = offset))
    placement_refuse_named(cell = cell, callee = callee, offset = offset, disagreement = true)
  } else if applied {
    Array::set(cell, at = 2, value = 4)
  } else {
    ()
  }
  if offset >= 0 {
    Array::push(checked_cells, value = (offset, cell))
  } else {
    ()
  }
}

export fn call_placement_install(cell: Array[Int], written: Int, mode: Int, slots: Array[Int]) -> Unit {
  placement_begin(cell = cell, role = 1)
  Array::push(cell, value = written)
  Array::push(cell, value = mode)
  for slot in slots {
    Array::push(cell, value = slot)
  }
  ()
}

/// A variable-length packet avoids a fixed arity limit or bit-packed source
/// indices. Only the header/footer have coordinates; payload rows never rebase.
export fn call_placement_append_rows(rows: Array[Int], offset: Int, cell: Array[Int]) -> Unit {
  if offset >= 0 {
    match call_placement_get(cell) {
      Some((written, mode, slots)) => {
        Array::push(rows, value = lowering_row_encode(payload = offset, tag = 8))
        Array::push(rows, value = lowering_row_encode(payload = written, tag = 9))
        Array::push(rows, value = lowering_row_encode(payload = mode, tag = 10))
        for slot in slots {
          Array::push(rows, value = lowering_row_encode(payload = slot, tag = 11))
        }
        Array::push(rows, value = lowering_row_encode(payload = offset, tag = 12))
      },
      None => ()
    }
  } else {
    ()
  }
}

export fn call_placement_refuse(cell: Array[Int], invalid: Bool) -> Unit {
  placement_begin(cell = cell, role = if invalid {
    3
  } else {
    2
  })
}

export fn call_placement_checked_rows() -> Array[Int] {
  let rows = [13]
  for entry in checked_cells {
    let (offset, cell) = entry
    call_placement_append_rows(rows = rows, offset = offset, cell = cell)
  }
  rows
}

/// Precheck macros consume positional arguments too. Verify before they erase
/// the original call; carry a refused cell so the enclosing lowering reports
/// it even if a later pass clears its own error buffer.
export fn call_placement_note_positional(callee: Expr, args: Array[Expr], offset: Int, cell: Array[Int]) -> Unit {
  if Array::get(capture_active, at = 0) {
    call_placement_capture_source(callee = callee, args = args, offset = offset, cell = cell, macro_call = true)
  } else if placement_role(cell) == 4 || placement_role(cell) == 2 || placement_role(cell) == 3 {
    ()
  } else {
    match call_placement_get(cell) {
      Some((written, _, slots)) => {
        let mut valid = written == Array::length(args) && Array::length(slots) == written
        let mut i = 0
        while i < Array::length(slots) {
          valid = valid && Array::get(slots, at = i) == (i + 1) * 2; i = i + 1
        }
        if valid {
          Array::set(cell, at = 2, value = 4)
        } else {
          placement_refuse_named(cell = cell, callee = callee, offset = offset, disagreement = true)
        }
      },
      None => {
        let mut labeled = false
        for arg in args {
          match arg {
            ELabeledArg(_, _, _) => labeled = true,
            _ => ()
          }
        }
        if labeled {
          placement_refuse_named(cell = cell, callee = callee, offset = offset, disagreement = false)
        } else {
          ()
        }
      }
    }
  }
}

export fn call_placement_is_refused(_ cell: Array[Int]) -> Bool {
  placement_role(cell) == 2 || placement_role(cell) == 3
}

export fn call_placement_is_canonical(_ cell: Array[Int]) -> Bool {
  placement_role(cell) == 4
}

fn placement_slots_valid(written: Int, mode: Int, slots: Array[Int], start: Int) -> Bool {
  // A call's arity is small, so a repeated source is found by scanning the
  // slots before it. This runs several times per labeled call (the checker's
  // views, the lowering), and the hash set it used to build per call was most
  // of what a label cost the checker.
  let mut valid = written >= 0 && (mode >= 0 && mode <= 2)
  let mut count = 0
  let mut i = start
  while i < Array::length(slots) && valid {
    let slot = Array::get(slots, at = i)
    if slot == 0 {
      ()
    } else if slot < 2 {
      valid = false
    } else {
      let source = slot / 2 - 1
      if source >= written || placement_source_seen(slots = slots, start = start, end = i, source = source) {
        valid = false
      } else {
        count = count + 1
      }
    }
    if mode != 0 && slot != (i - start + 1) * 2 {
      valid = false
    } else {
      ()
    }
    i = i + 1
  }
  valid && count == written && (mode == 0 || Array::length(slots) - start == written)
}

fn placement_source_seen(slots: Array[Int], start: Int, end: Int, source: Int) -> Bool {
  let mut seen = false
  let mut j = start
  while j < end && !seen {
    let earlier = Array::get(slots, at = j)
    seen = earlier >= 2 && earlier / 2 - 1 == source
    j = j + 1
  }
  seen
}

/// One payload grammar serves source-row restoration and binary AST transport.
export fn call_placement_payload_valid(written: Int, mode: Int, slots: Array[Int]) -> Bool {
  placement_slots_valid(written = written, mode = mode, slots = slots, start = 0)
}

/// Raw snapshot pool IDs cannot cross a process boundary. Checked/expected
/// placements and explicit refusals retain their validated payload instead.
export fn call_placement_wire_valid(cell: Array[Int], start: Int) -> Bool {
  if start < 0 || !call_placement_cell_prefix(cell = cell, start = start) {
    false
  } else {
    let role = Array::get(cell, at = start + 2)
    if role == 1 || role == 4 {
      Array::length(cell) >= start + 5 && placement_slots_valid(written = Array::get(cell, at = start + 3), mode = Array::get(cell, at = start + 4), slots = cell, start = start + 5)
    } else if role == 2 || role == 3 {
      if Array::length(cell) == start + 3 {
        true
      }
      else if Array::length(cell) < start + 5 {
        false
      }
      else {
        let mut valid = Array::get(cell, at = start + 3) >= 0 - 1 && (Array::get(cell, at = start + 4) == 0 || Array::get(cell, at = start + 4) == 1)
        let mut i = start + 5
        while i < Array::length(cell) && valid {
          let byte = Array::get(cell, at = i)
          valid = byte >= 0 && byte <= 255
          i = i + 1
        }
        valid
      }
    } else {
      false
    }
  }
}

/// A source-bound placement still needs its argument list constructed.
export fn call_placement_is_pending(_ cell: Array[Int]) -> Bool {
  placement_role(cell) == 1 || placement_role(cell) == 2 || placement_role(cell) == 3
}

/// Only the lowering that constructs arguments marks a placement applied.
export fn call_placement_mark_applied(_ cell: Array[Int]) -> Unit {
  if placement_role(cell) == 1 {
    Array::set(cell, at = 2, value = 4)
  } else {
    ()
  }
}

/// Retain a macro's original source name when reporting an absent placement.
export fn call_placement_error(cell: Array[Int], callee: Expr, offset: Int) -> String {
  placement_refusal_message(cell = cell, callee = callee, offset = offset)
}

/// Read the call's placement kind without copying its source-index payload.
export fn call_placement_mode(_ cell: Array[Int]) -> Int {
  let role = placement_role(cell)
  if (role == 1 || role == 4) && Array::length(cell) >= 5 {
    Array::get(cell, at = 4)
  } else {
    -1
  }
}

/// Read a pending source argument's formal slot without allocating a reverse
/// map. The result is `(formal + 1) * 2 + wrapSome`; applied calls are already
/// in formal order and return the positional identity instead.
export fn call_placement_source_slot(cell: Array[Int], source: Int, written: Int) -> Int {
  let mut result = (source + 1) * 2
  if placement_role(cell) == 1 && Array::length(cell) >= 5 && Array::get(cell, at = 3) == written && Array::get(cell, at = 4) == 0 {
    let mut i = 5
    let mut found = false
    while i < Array::length(cell) && !found {
      let code = Array::get(cell, at = i)
      if code >= 2 && code / 2 - 1 == source {
        result = (i - 4) * 2 + code % 2
        found = true
      } else {
        ()
      }
      i = i + 1
    }
  } else {
    ()
  }
  result
}

/// A checked placement that fills formal slot `i` from written argument `i`,
/// for every one of `written` slots, with no `Some` wrapping: what a call whose
/// labels follow the declaration's order publishes, and so nearly every
/// labeled call. Read in place, so asking costs no copy of the payload.
export fn call_placement_is_identity(cell: Array[Int], written: Int) -> Bool {
  let role = placement_role(cell)
  if (role == 1 || role == 4) && Array::length(cell) == 5 + written && Array::get(cell, at = 3) == written && Array::get(cell, at = 4) == 0 {
    let mut same = true
    let mut i = 0
    while same && i < written {
      same = Array::get(cell, at = 5 + i) == (i + 1) * 2
      i = i + 1
    }
    same
  } else {
    false
  }
}

/// Read checked formal arguments for semantic checks. The source expressions
/// and their call cells remain unchanged. Some owns a new formal-order array;
/// ordinary positional calls answer None without allocating.
export fn call_placement_argument_view(args: Array[Expr], cell: Array[Int]) -> Option[Array[Expr]] {
  if call_placement_is_pending(cell) && call_placement_is_identity(cell = cell, written = Array::length(args)) {
    Some(for arg in args {
      match arg {
        ELabeledArg(_, _, value) => value,
        value => value
      }
    })
  } else if call_placement_is_pending(cell) && call_placement_mode(cell) == 0 {
    match call_placement_get(cell) {
      Some((written, mode, slots)) => if written == Array::length(args) && call_placement_payload_valid(written = written, mode = mode, slots = slots) {
        Some(for code in slots {
          if code == 0 {
            EIdent("None", -1)
          } else {
            let value = match Array::get(args, at = code / 2 - 1) {
              ELabeledArg(_, _, value) => value,
              value => value
            }
            if code % 2 == 1 {
              ECall(EIdent("Some", -1), [value], -1, [])
            } else {
              value
            }
          }
        })
      } else {
        None
      },
      None => None
    }
  } else {
    None
  }
}

/// The bare-callee method retry types `bump(b, n = 3)` as `b.bump(n = 3)`,
/// so the placement it publishes covers the explicit arguments only. The
/// call that is lowered is the one written, where the receiver is argument
/// 0: shift every source index past it and place the receiver first.
/// `explicit` is the retry's argument count, so a placement that already
/// covers the receiver (a re-check that published nothing new) is kept.
export fn call_placement_prepend_receiver(cell: Array[Int], explicit: Int) -> Unit {
  if placement_role(cell) == 1 {
    match call_placement_get(cell) {
      Some((written, mode, slots)) => if written == explicit {
        let full = [2]
        for code in slots {
          Array::push(full, value = if code == 0 {
            0
          } else {
            code + 2
          })
        }
        call_placement_install(cell = cell, written = written + 1, mode = mode, slots = full)
      } else {
        ()
      },
      None => ()
    }
  } else {
    ()
  }
}

/// ADR-0120: the value a written argument passes -- `name = value` is `value`.
/// An analysis that reads an argument's shape (a lambda literal, a function
/// named as a callback, a handle it carries) reads this, so a label cannot
/// hide what the argument is.
export fn call_arg_value(_ arg: Expr) -> Expr {
  match arg {
    ELabeledArg(_, _, value) => call_arg_value(value),
    _ => arg
  }
}

/// ADR-0120: the formal parameter that written argument `source` fills, or
/// -1 when that is not known. Labels never reorder, but an omitted optional
/// parameter shifts every labeled argument after it, so an analysis that
/// pairs an unwrapped argument with a parameter asks here rather than using
/// the written index. A checked placement answers for itself; without one,
/// the written index is the formal one only while no label precedes it.
export fn call_arg_formal(args: Array[Expr], cell: Array[Int], source: Int) -> Int {
  let written = Array::length(args)
  let role = placement_role(cell)
  if role == 1 && Array::length(cell) >= 5 && Array::get(cell, at = 3) == written {
    call_placement_source_slot(cell = cell, source = source, written = written) / 2 - 1
  } else if role == 4 {
    source
  } else {
    let mut plain = true
    let mut i = 0
    while plain && i <= source && i < written {
      plain = !(Array::get(args, at = i) is ELabeledArg(_, _, _))
      i = i + 1
    }
    if plain {
      source
    } else {
      -1
    }
  }
}

/// `call_arg_value` of each written argument.
export fn call_arg_values(_ args: Array[Expr]) -> Array[Expr] {
  for arg in args {
    call_arg_value(arg)
  }
}
