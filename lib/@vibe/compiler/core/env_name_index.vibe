import @vibe/core {
  bsearch_leftmost, hash_string, str_lt, struct MutMap
}

/// Immutable name-to-row-ID index owned by one cached environment. The owned
/// name snapshot is also the canonical transport order, including duplicates.
/// Neither the snapshot nor the probe slots are exposed for mutation.
export struct EnvNameIndex {
  names: Array[String];
  slots: Array[Int];
  sorted: Bool;
  // Present only when the index covers all lookup-visible bindings in its
  // tail, including any authoritative rows in older cached nodes.
  // A shared set records names tucked behind this index after construction.
  // Growth can cause an older branch to scan unnecessarily, never to miss a
  // binding: membership is only an over-approximation for the miss fast path.
  tail_names: Option[MutMap[String, Int]]
}

export fn env_name_index_new(_ names: Array[String]) -> EnvNameIndex {
  let owned = Array::slice(names, start = 0, end = Array::length(names))
  let n = Array::length(owned)
  let mut sorted = true
  let mut i = 1
  while i < n && sorted {
    if str_lt(a = Array::get(owned, at = i), b = Array::get(owned, at = i - 1)) {
      sorted = false
    }
    i = i + 1
  }
  let slots: Array[Int] = if n > 1 && sorted {
    let mut reserve = 16
    while reserve < n * 2 {
      reserve = reserve * 2
    }
    Array::with_capacity(reserve)
  } else {
    []
  }
  // Tiny indexes need no table. Malformed ordering remains available to
  // artifact validators and keeps the legacy lookup behavior.
  if n > 1 && sorted {
    let mut cap = 16
    while cap < n * 2 {
      cap = cap * 2
    }
    let mut fill = 0
    while fill < cap {
      Array::push(slots, value = -1)
      fill = fill + 1
    }
    let mut row = 0
    while row < n {
      let name = Array::get(owned, at = row)
      let mut slot = hash_string(name)&(cap - 1)
      let mut done = false
      while !done {
        let prev = Array::get(slots, at = slot)
        if prev < 0 {
          Array::set(slots, at = slot, value = row)
          done = true
        } else if String::equals(Array::get(owned, at = prev), name) {
          // The first row wins, as with the stable sort and leftmost search.
          done = true
        } else {
          slot = (slot + 1)&(cap - 1)
        }
      }
      row = row + 1
    }
  }
  EnvNameIndex::{ names: owned, slots: slots, sorted: sorted, tail_names: None }
}

export fn env_name_index_with_tail_names(_ index: EnvNameIndex) -> EnvNameIndex {
  EnvNameIndex::{
    names: index.names,
    slots: index.slots,
    sorted: index.sorted,
    tail_names: Some(MutMap::new_string())
  }
}

export fn env_name_index_has_tail_names(_ index: EnvNameIndex) -> Bool {
  index.tail_names is Some(_)
}

export fn env_name_index_note_tail_binding(index: EnvNameIndex, name: String) -> Unit {
  match index.tail_names {
    Some(names) => MutMap::set(names, k = name, v = 1),
    None => ()
  }
}

export fn env_name_index_miss_is_final(index: EnvNameIndex, name: String) -> Bool {
  match index.tail_names {
    Some(names) => !MutMap::has(names, k = name),
    None => false
  }
}

export fn env_name_index_length(_ index: EnvNameIndex) -> Int {
  Array::length(index.names)
}

export fn env_name_index_at(index: EnvNameIndex, row: Int) -> String {
  Array::get(index.names, at = row)
}

export fn env_name_index_is_sorted(_ index: EnvNameIndex) -> Bool {
  index.sorted
}

/// Return the first row ID or -1. A raw integer avoids allocating an Option
/// at every checker lookup. Probe slots are never themselves symbol IDs.
export fn env_name_index_find(index: EnvNameIndex, name: String) -> Int {
  let cap = Array::length(index.slots)
  if cap == 0 {
    bsearch_leftmost(sorted = index.names, name = name)
  } else {
    let mut slot = hash_string(name)&(cap - 1)
    let mut result = -1
    let mut done = false
    while !done {
      let row = Array::get(index.slots, at = slot)
      if row < 0 {
        done = true
      } else if String::equals(Array::get(index.names, at = row), name) {
        result = row
        done = true
      } else {
        slot = (slot + 1)&(cap - 1)
      }
    }
    result
  }
}
