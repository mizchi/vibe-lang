// One encoding for checker facts, their persisted carrier, and file rebasing.

/// Four low tag bits leave scalar/callee tags 0–7 unchanged as channels.
export fn lowering_row_encode(payload: Int, tag: Int) -> Int {
  payload * 16 + tag
}

export fn lowering_row_payload(row: Int) -> Int {
  row / 16
}

export fn lowering_row_tag(row: Int) -> Int {
  row % 16
}

/// Placement packets have coordinate rows (8/12) and non-coordinate rows:
/// written count (9), mode (10), slot indices (11), availability (13/14).
/// A callee identity (7) retains its extra 16-bit operation field.
export fn lowering_row_rebase(row: Int, base: Int) -> Int {
  let tag = lowering_row_tag(row)
  if tag == 9 || tag == 10 || tag == 11 || tag == 13 || tag == 14 {
    row
  } else if tag == 7 {
    row + base * 65536 * 16
  } else {
    row + base * 16
  }
}
