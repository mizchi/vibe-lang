// One encoding for checker facts, their persisted carrier, and file rebasing.

import @vibe/ast {
  Expr, TypeExpr, impl_target_key
}

import ./expr_children.vibe {
  typed_render_row_offset
}

// Branches and blocks carry no offset of their own. Use a value-producing
// leaf, which cannot also be an argument of the enclosing call.
export fn row_free_callback_offset(_ expr: Expr) -> Int {
  match expr {
    EIf(_, yes, no) => {
      let off = row_free_callback_offset(yes)
      if off >= 0 {
        off
      } else {
        row_free_callback_offset(no)
      }
    },
    ELet(_, _, result, _) => row_free_callback_offset(result),
    ELetMut(_, _, result, _) => row_free_callback_offset(result),
    ELetRec(_, _, result) => row_free_callback_offset(result),
    ESeq(_, result) => row_free_callback_offset(result),
    EAssign(_, _, result, _) => row_free_callback_offset(result),
    EAssignOp(_, _, _, result, _) => row_free_callback_offset(result),
    _ => typed_render_row_offset(expr)
  }
}

/// The argument's checked function type has no row and the receiving slot
/// has one. Keep this fact with the existing offset-keyed lowering rows.
export let row_free_callback_key: String = impl_target_key(TyName("#row-free-callback"))

/// Four low tag bits leave scalar/callee tags 0–7 unchanged as channels.
export fn lowering_row_encode(payload: Int, tag: Int) -> Int {
  payload * 16 + tag
}

export fn lowering_row_payload(_ row: Int) -> Int {
  row / 16
}

export fn lowering_row_tag(_ row: Int) -> Int {
  row % 16
}

/// Placement packets have coordinate rows (8/12) and non-coordinate rows:
/// written count (9), mode (10), slot indices (11), availability (13/14).
/// A callee identity (7) retains its extra 16-bit operation field.
export fn lowering_row_rebase(row: Int, base: Int) -> Int {
  let tag = lowering_row_tag(row)
  if tag == 9 || tag == 10 || tag == 11 || tag == 13 || tag == 14 {
    row
  } else if tag == 7 {
    row + base * 65536 * 16
  } else {
    row + base * 16
  }
}
