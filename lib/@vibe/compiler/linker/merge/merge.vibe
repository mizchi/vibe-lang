fn string_array_contains(items: Array[String], target: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(items) && !found {
    if Array::get(items, at = i) == target {
      found = true
    } else {
      i = i + 1
    }
  }
  found
}

fn lookup_source_stmts_by_path(sources: Array[(String, String)], source_stmts: Array[Array[Stmt]], target_path: String) -> Option[Array[Stmt]] {
  let mut i = 0
  let mut found = None
  while i < Array::length(sources) {
    let (path, _) = Array::get(sources, at = i)
    if path == target_path {
      found = Some(Array::get(source_stmts, at = i))
      i = Array::length(sources)
    } else {
      i = i + 1
    }
  }
  found
}

fn merge_lowering_for_path(inputs: Option[CheckedLoweringInputs], path: String) -> Option[Array[Int]] with Exception {
  match inputs {
    Some(owned) => Some(CheckedLoweringInputs::for_path(owned, path = path)),
    None => checked_lowering_for_path(path)
  }
}

/// #716: collision-def fallback (see merge_sources.vibe). `excluded_locals`
/// are the locals the export-rename plan already rewrites; the inline copy gets
/// the target file's export renames applied first.
fn append_import_alias_collision_defs_from_sources(merged: Array[Stmt], current_path: String, stmts: Array[Stmt], sources: Array[(String, String)], source_stmts: Array[Array[Stmt]], plan: ExportRenamePlan, fallback_clone_offset_delta: Array[Int], fallback_clone_offset_span: Int, excluded_locals: Array[String], flat_paths: Array[String], flat_bases: Array[Int], clone_float_offsets_out: Array[Int], lowering_inputs: Option[CheckedLoweringInputs]) -> Array[String] with Exception {
  let refs = collect_import_alias_collision_refs(stmts)
  let emitted = array_empty()
  let base_dir = dir_of_path(current_path)
  let mut i = 0
  while i < Array::length(refs) {
    let (raw_path, original, local) = Array::get(refs, at = i)
    if !string_array_contains(items = emitted, target = local) && !string_array_contains(items = excluded_locals, target = local) {
      let resolved = resolve_import_path(base_dir = base_dir, raw_path = raw_path)
      match lookup_source_stmts_by_path(sources = sources, source_stmts = source_stmts, target_path = resolved) {
        Some(parsed_source_stmts) => {
          // Reuse the merge's authoritative parsed copy. In the GC lane this
          // copy already carries the provider file's rebased offsets; reparsing
          // the raw source here would silently return to source-relative
          // offsets only for alias-collision fallback definitions.
          let provider_stmts = namespace_private_value_stmts_after_renames(path = resolved, stmts = parsed_source_stmts, export_renames = export_plan_renames_for(plan = plan, path = resolved))
          let mut j = 0
          let mut done = false
          while j < Array::length(provider_stmts) && !done {
            match rewrite_imported_value_stmt_to_local(stmt = Array::get(provider_stmts, at = j), original = original, local = local) {
              Some(local_stmt) => {
                let located_local_stmt = if fallback_clone_offset_span > 0 {
                  // A fallback is a real second copy of the provider body, so
                  // it needs a second location range too. Reusing the provider
                  // offsets would make the fail-closed call-result filter drop
                  // both the original and the clone's Double observations.
                  let delta = Array::get(fallback_clone_offset_delta, at = 0)
                  Array::set(fallback_clone_offset_delta, at = 0, value = delta + fallback_clone_offset_span)
                  // #2391 (#2425 review): the clone is a second copy of
                  // provider CODE in a fresh offset range, so it needs a
                  // second copy of the provider's Double call-result offsets
                  // too, or a Double-returning call inside the clone's body
                  // falls back to the syntactic classifier and prints raw
                  // bits. The clone's node offsets are the provider's
                  // MERGE-SPACE offsets (its file base plus its module-space
                  // offset -- source_stmts is the rebased table) plus this
                  // clone's delta; entries for provider statements the clone
                  // does not contain match no call node and stay inert.
                  match lookup_flat_base(flat_paths = flat_paths, flat_bases = flat_bases, path = resolved) {
                    Some(provider_base) => match merge_lowering_for_path(inputs = lowering_inputs, path = resolved) {
                      Some(provider_offsets) => {
                        let mut k = 0
                        while k < Array::length(provider_offsets) {
                          // The table is tag-encoded (offset * 16 + tag, see
                          // typed_lowering_enc), so shifting a row by the
                          // clone's merge-space delta adds (base + delta) * 16
                          // -- the tag bits stay untouched. Callee tag 7 has one
                          // more identity field, so rebasing is shared with core/resolved_callee.
                          let row = Array::get(provider_offsets, at = k)
                          Array::push(clone_float_offsets_out, value = resolved_callee_row_rebase(row = row, base = (provider_base + delta)))
                          k = k + 1
                        }
                      },
                      None => ()
                    },
                    None => ()
                  }
                  shift_stmt_offsets(stmt = local_stmt, delta = delta)
                } else {
                  local_stmt
                }
                Array::push(merged, value = located_local_stmt)
                Array::push(emitted, value = local)
                done = true
              },
              None => ()
            }
            j = j + 1
          }
        },
        None => ()
      }
    }
    i = i + 1
  }
  emitted
}

/// The disjoint-merge offset base recorded for `path`, or None when the merge
/// runs without disjoint offset spaces (the callers then pass empty tables).
fn lookup_flat_base(flat_paths: Array[String], flat_bases: Array[Int], path: String) -> Option[Int] {
  let n = Array::length(flat_paths)
  let mut i = 0
  let mut found: Option[Int] = None
  while i < n {
    if Array::get(flat_paths, at = i) == path {
      found = Some(Array::get(flat_bases, at = i))
      i = n
    } else {
      i = i + 1
    }
  }
  found
}

/// #716: parse every source once and build the export-rename plan for the whole
/// program (the merge output of one file depends on the export surfaces of ALL
/// files: ambiguous exported names are renamed at their defs and at importing
/// files' references).
fn parse_sources_for_merge(_ sources: Array[(String, String)], cfg: TargetCfg, lowering_inputs: Option[CheckedLoweringInputs]) -> (Array[String], Array[Array[Stmt]]) with Exception {
  let file_paths = array_empty()
  let file_stmts = array_empty()
  let mut si = 0
  while si < Array::length(sources) {
    let (path, source) = Array::get(sources, at = si)
    Array::push(file_paths, value = path)
    Array::push(file_stmts, value = match lowering_inputs {
      Some(inputs) => engine_parse_program_with_lowering(path = path, source = source, cfg = cfg, rows = CheckedLoweringInputs::for_path(inputs, path = path)),
      None => engine_parse_program_with_path_with_config(path = path, source = source, cfg = cfg)
    })
    si = si + 1
  }
  (file_paths, file_stmts)
}

/// One file's contribution to the merged program. `stmts` are the file's parsed
/// statements, `is_entry_source` mirrors the pre-#716 per-group entry rule
/// (entry keeps its private names), and `plan`/`sources` drive the export-name
/// rewriting and the collision-def fallback.
fn append_merged_stmts_for_file(merged: Array[Stmt], path: String, stmts: Array[Stmt], is_entry_source: Bool, plan: ExportRenamePlan, sources: Array[(String, String)], source_stmts: Array[Array[Stmt]], fallback_clone_offset_delta: Array[Int], fallback_clone_offset_span: Int, flat_paths: Array[String], flat_bases: Array[Int], clone_float_offsets_out: Array[Int], units: Array[LinkedUnit], shipped_default_paths: Array[String], lowering_inputs: Option[CheckedLoweringInputs]) -> Unit with Exception {
  let unit_start = Array::length(merged)
  // Preserve the proof that an optimized trait namespace came from the
  // standard module. Desugaring consumes this source-local marker before
  // codegen; it is not part of the runtime program.
  let import_renames = if stmts_have_import_deep(stmts) {
    collect_import_value_renames(plan = plan, path = path, stmts = stmts)
  } else {
    array_empty()
  }
  let (boundary_locals, boundary_surface_only) = merged_source_boundary_names(stmts)
  append_builtin_iterator_plan_operation_markers(markers = boundary_locals, renames = import_renames, plan = plan)
  if merge_path_listed(paths = shipped_default_paths, path = path) {
    Array::push(boundary_locals, value = merged_trait_origin_marker("Default"))
  } else {
    ()
  }
  Array::push(merged, value = SReExportSourceBoundary(boundary_locals, boundary_surface_only))
  let collision_renames = if is_entry_source {
    trait_import_local_operation_renames_preserving_exports(stmts = stmts, path = path)
  } else {
    trait_import_local_operation_renames(stmts = stmts, path = path)
  }
  let collision_renamed = apply_export_renames_stmts(stmts = stmts, renames = collision_renames)
  let namespaced_stmts = if is_entry_source {
    namespace_entry_import_shadows(path = path, stmts = collision_renamed)
  } else {
    namespace_private_value_stmts_after_renames(path = path, stmts = collision_renamed, export_renames = export_plan_renames_for(plan = plan, path = path))
  }
  if stmts_have_import_deep(stmts) {
    // #3443: only the locals the fallback cloned stop being rewritten. A
    // collision local with no value to clone (a type, a constructor) keeps
    // its alias: dropping it left `B::plain` unresolved at codegen when `Box`
    // also arrived through a re-export of the same module.
    let skipped_locals = append_import_alias_collision_defs_from_sources(merged = merged, current_path = path, stmts = stmts, sources = sources, source_stmts = source_stmts, plan = plan, fallback_clone_offset_delta = fallback_clone_offset_delta, fallback_clone_offset_span = fallback_clone_offset_span, excluded_locals = import_value_rename_locals(import_renames), flat_paths = flat_paths, flat_bases = flat_bases, clone_float_offsets_out = clone_float_offsets_out, lowering_inputs = lowering_inputs)
    append_import_alias_rewritten_non_import_stmts_with_renames(merged = merged, stmts = namespaced_stmts, skipped_locals = skipped_locals, extra_renames = import_renames)
  } else {
    append_non_import_stmts_without_alias_rewrite(merged = merged, stmts = namespaced_stmts)
  }
  // #3544: this file's share of the linked program, for the impl-overlap check.
  Array::push(units, value = linked_unit_in(sources = sources, path = path, start = unit_start, end = Array::length(merged)))
}

fn merge_path_listed(paths: Array[String], path: String) -> Bool {
  let mut found = false
  for p in paths {
    found = found || p == path
  }
  found
}

/// #3824: the shipped `@vibe/core` file that declares `trait Default`, as
/// this merge spells it: the `default.vibe` beside the contract an import
/// spelled exactly `@vibe/core` resolves to, when that file is one of the
/// merged ones. Resolution, not the path's spelling, decides it, so a program
/// file that only ends like the shipped one is not listed.
fn shipped_core_default_paths(paths: Array[String], stmts_list: Array[Array[Stmt]]) -> Array[String] {
  let out: Array[String] = []
  let mut i = 0
  while i < Array::length(paths) {
    let path = Array::get(paths, at = i)
    for st in Array::get(stmts_list, at = i) {
      let raw = match st {
        SImport(raw_path, _) => raw_path,
        SReExport(raw_path, _) => raw_path,
        _ => ""
      }
      if raw == "@vibe/core" {
        let contract = resolve_known_import_path(known_paths = paths, base_dir = dir_of_path(path), raw_path = raw, self_path = path)
        if contract != "" {
          let candidate = String::concat(dir_of_path(contract), "/default.vibe")
          if merge_path_listed(paths = paths, path = candidate) && !merge_path_listed(paths = out, path = candidate) {
            Array::push(out, value = candidate)
          } else {
            ()
          }
        } else {
          ()
        }
      } else {
        ()
      }
    }
    i = i + 1
  }
  out
}

/// Build one merged program with a single rename plan and append order.
/// Direct Bool controls specialize observation work out of lanes that do not
/// consume it. Counts and statement IDs describe every flat source seat,
/// including repeated paths and empty files; clone bodies belong to their
/// importing source's contribution.
fn build_grouped_merged_stmts_impl(source_groups: Array[(String, Array[(String, String)])], disjoint_offset_spaces: Bool, flat_paths_out: Array[String], flat_bases_out: Array[Int], clone_float_offsets_out: Array[Int], stmt_file_id_out: Array[Int], collect_stmt_ids: Bool, file_fps_out: Array[String], file_counts_out: Array[Int], collect_file_counts: Bool, cfg: TargetCfg, lowering_inputs: Option[CheckedLoweringInputs]) -> Array[Stmt] with Exception {
  let flat_sources = flatten_group_sources(source_groups)
  match lowering_inputs {
    Some(inputs) => CheckedLoweringInputs::validate(inputs, sources = flat_sources, cfg_identity = target_cfg_identity(cfg)),
    None => ()
  }
  // #2205: the rename table describes ONE merged program.
  namespace_rename_originals_reset()
  let merged = array_empty()
  // #716: the plan spans ALL groups (imports cross group boundaries), so the
  // flat source list is parsed once here and reused per group.
  let (file_paths, file_stmts) = parse_sources_for_merge(flat_sources, cfg = cfg, lowering_inputs = lowering_inputs)
  let fallback_clone_offset_delta = [0]
  // #3090: record the offset space this merge builds, and only a DISJOINT one:
  // without the rebase every file's offsets start at 0, so a merged offset
  // names no one file.
  merged_offset_space_reset()
  // Keep one authoritative parsed copy per file for both the ordinary merge
  // contribution and alias-collision fallback definitions. The GC variant
  // rebases the whole table up front, so no later helper can accidentally
  // reintroduce source-relative offsets by reparsing a provider.
  let located_file_stmts = if disjoint_offset_spaces {
    let out = array_empty()
    let mut offset_base = 0
    let mut source_idx = 0
    while source_idx < Array::length(flat_sources) {
      Array::push(out, value = shift_stmts_offsets(stmts = Array::get(file_stmts, at = source_idx), delta = offset_base))
      // #2391: report each flat file's offset base so a caller can shift
      // per-module offset tables (checked_lowering_for_path, keyed
      // in each file's OWN offset space) into this merge's space.
      Array::push(flat_paths_out, value = Array::get(file_paths, at = source_idx))
      Array::push(flat_bases_out, value = offset_base)
      let (source_path, source) = Array::get(flat_sources, at = source_idx)
      merged_offset_space_add(path = source_path, source = source, base = offset_base)
      if collect_file_counts {
        Array::push(file_fps_out, value = compact_source_fingerprint_memo(path = source_path, source = source))
      } else {
        ()
      }
      // A source of N bytes occupies [base, base + N). The extra byte keeps
      // even an offset exactly at EOF disjoint from the following file.
      offset_base = offset_base + String::length(source) + 1
      source_idx = source_idx + 1
    }
    Array::set(fallback_clone_offset_delta, at = 0, value = offset_base)
    out
  } else {
    file_stmts
  }
  let fallback_clone_offset_span = Array::get(fallback_clone_offset_delta, at = 0)
  let plan_entry = if Array::length(file_paths) > 0 {
    Array::get(file_paths, at = Array::length(file_paths) - 1)
  } else {
    ""
  }
  let plan = build_export_rename_plan(paths = file_paths, stmts_list = file_stmts, entry_path = plan_entry)
  let shipped_default_paths = shipped_core_default_paths(paths = file_paths, stmts_list = file_stmts)
  // #740: the is-entry flag must mean "the LAST file of the WHOLE merge"
  // (the plan entry, whose exports stay unrenamed). It was `si ==
  // source_count - 1` — the last file of EVERY GROUP — so every group
  // tail (ripple/ripple.vibe, desugar_trait_dict.vibe, ...) skipped its
  // export renames while callers were rewritten to the renamed names:
  // "undefined variable (local): <name>_exp_<path>" at codegen.
  let flat_total = Array::length(file_paths)
  let units = []
  let mut flat_idx = 0
  let mut gi = 0
  while gi < Array::length(source_groups) {
    let (_, sources) = Array::get(source_groups, at = gi)
    let source_count = Array::length(sources)
    let mut si = 0
    while si < source_count {
      let path = Array::get(file_paths, at = flat_idx)
      let stmts = Array::get(located_file_stmts, at = flat_idx)
      let before = Array::length(merged)
      // Every parser offset is relative to one file. The GC checker's
      // call-result table is keyed by those offsets, so merging files without
      // rebasing lets one file's Double call classify another file's Int call.
      // Shift before the namespace/import rewrites; they preserve locations.
      append_merged_stmts_for_file(merged = merged, path = path, stmts = stmts, is_entry_source = flat_idx == flat_total - 1, plan = plan, sources = flat_sources, source_stmts = located_file_stmts, fallback_clone_offset_delta = fallback_clone_offset_delta, fallback_clone_offset_span = fallback_clone_offset_span, flat_paths = flat_paths_out, flat_bases = flat_bases_out, clone_float_offsets_out = clone_float_offsets_out, units = units, shipped_default_paths = shipped_default_paths, lowering_inputs = lowering_inputs)
      // Everything this file contributed, including the alias-collision
      // fallback definitions it pulls in from providers, belongs to it: they
      // are emitted into this file's region and rewritten against its imports.
      if collect_stmt_ids {
        let mut prov_k = before
        while prov_k < Array::length(merged) {
          Array::push(stmt_file_id_out, value = flat_idx)
          prov_k = prov_k + 1
        }
      } else {
        ()
      }
      if collect_file_counts {
        Array::push(file_counts_out, value = Array::length(merged) - before)
      } else {
        ()
      }
      flat_idx = flat_idx + 1
      si = si + 1
    }
    gi = gi + 1
  }
  refuse_linked_impl_overlaps(merged = merged, units = units)
  merged
}

export fn build_grouped_merged_stmts(_ source_groups: Array[(String, Array[(String, String)])]) -> Array[Stmt] with Env + Exception {
  build_grouped_merged_stmts_with_config(source_groups, cfg = target_cfg_ambient())
}

/// Merge target-selected statements without reading ambient flag cells.
/// Typed lowering, location metadata and observation sinks retain their owners.
export fn build_grouped_merged_stmts_with_config(_ source_groups: Array[(String, Array[(String, String)])], cfg: TargetCfg) -> Array[Stmt] with Exception {
  build_grouped_merged_stmts_impl(source_groups = source_groups, disjoint_offset_spaces = false, flat_paths_out = array_empty(), flat_bases_out = array_empty(), clone_float_offsets_out = array_empty(), stmt_file_id_out = array_empty(), collect_stmt_ids = false, file_fps_out = [
  ], file_counts_out = [], collect_file_counts = false, cfg = cfg, lowering_inputs = None)
}

/// Capture target flags once and return the selected linked source as text.
export fn build_grouped_merged_source_configured(_ source_groups: Array[(String, Array[(String, String)])]) -> String with Config + Exception {
  let cfg = target_cfg_capture()
  print_program(build_grouped_merged_stmts_with_config(source_groups, cfg = cfg))
}

export fn build_grouped_merged_stmts_gc(_ source_groups: Array[(String, Array[(String, String)])]) -> Array[Stmt] with Env + Exception {
  build_grouped_merged_stmts_impl(source_groups = source_groups, disjoint_offset_spaces = true, flat_paths_out = array_empty(), flat_bases_out = array_empty(), clone_float_offsets_out = array_empty(), stmt_file_id_out = array_empty(), collect_stmt_ids = false, file_fps_out = [
  ], file_counts_out = [], collect_file_counts = false, cfg = target_cfg_ambient(), lowering_inputs = None)
}

/// #2391: the merge every offsets-consuming linear FS lane shares -- each file
/// rebased into a disjoint offset range (same rebase as the gc lane, #2226) so
/// the per-module offset tables union without collisions. Returns the merged
/// program -- with the typed String-binop rewrite (slice 2) already applied:
/// `a < b` becomes `str_lex_diff(a, b) < 0` and `a + b` becomes
/// `String::concat(a, b)` exactly where the modular check recorded a String
/// operand, the same forms the desugar tracker emits for the shapes it can
/// classify syntactically -- plus the Double call-result offset table for
/// codegen. The rewrite anchors with the checker's own channel anchor
/// (typed_lowering_binop_anchor), so
/// both sides compute the anchor identically by construction.
export fn merged_stmts_and_offsets(_ source_groups: Array[(String, Array[(String, String)])]) -> (Array[Stmt], Array[Int], Array[Int], Array[Int], Array[Int], Array[String]) with Env + Exception {
  merged_stmts_and_offsets_impl(source_groups = source_groups, stmt_file_id_out = [
  ], collect_stmt_ids = false, cfg = target_cfg_ambient(), lowering_inputs = None)
}

/// The typed merge retaining one owner ID per merged statement. The String
/// binop rewrite preserves the count, so the IDs remain aligned afterwards.
export fn merged_stmts_and_offsets_prov(source_groups: Array[(String, Array[(String, String)])], stmt_file_id_out: Array[Int]) -> (Array[Stmt], Array[Int], Array[Int], Array[Int], Array[Int], Array[String]) with Env + Exception {
  merged_stmts_and_offsets_impl(source_groups = source_groups, stmt_file_id_out = stmt_file_id_out, collect_stmt_ids = true, cfg = target_cfg_ambient(), lowering_inputs = None)
}

/// Merge typed products captured for these exact sources and target flags.
/// Namespace and location metadata remain owned by the serial merge phase.
export fn merged_stmts_and_offsets_with_config(source_groups: Array[(String, Array[(String, String)])], cfg: TargetCfg, inputs: CheckedLoweringInputs) -> (Array[Stmt], Array[Int], Array[Int], Array[Int], Array[Int], Array[String]) with Exception {
  merged_stmts_and_offsets_impl(source_groups = source_groups, stmt_file_id_out = [
  ], collect_stmt_ids = false, cfg = cfg, lowering_inputs = Some(inputs))
}

fn merged_stmts_and_offsets_impl(source_groups: Array[(String, Array[(String, String)])], stmt_file_id_out: Array[Int], collect_stmt_ids: Bool, cfg: TargetCfg, lowering_inputs: Option[CheckedLoweringInputs]) -> (Array[Stmt], Array[Int], Array[Int], Array[Int], Array[Int], Array[String]) with Exception {
  let flat_paths: Array[String] = []
  let flat_bases: Array[Int] = []
  let clone_float_offsets: Array[Int] = []
  let merged = build_grouped_merged_stmts_impl(source_groups = source_groups, disjoint_offset_spaces = true, flat_paths_out = flat_paths, flat_bases_out = flat_bases, clone_float_offsets_out = clone_float_offsets, stmt_file_id_out = stmt_file_id_out, collect_stmt_ids = collect_stmt_ids, file_fps_out = [
  ], file_counts_out = [], collect_file_counts = false, cfg = cfg, lowering_inputs = lowering_inputs)
  let (floats, rels, pluses, int_renders, bool_renders) = split_checked_lowering(match lowering_inputs {
    Some(inputs) => CheckedLoweringInputs::union_lowering(inputs, flat_paths = flat_paths, flat_bases = flat_bases, clone_float_offsets = clone_float_offsets),
    None => union_checked_lowering_with_clones(flat_paths = flat_paths, flat_bases = flat_bases, clone_float_offsets = clone_float_offsets)
  })
  // #2441: the typed-`==` rows ride the same disjoint offset spaces.
  let (eq_offs, eq_keys) = match lowering_inputs {
    Some(inputs) => CheckedLoweringInputs::union_eq_rows(inputs, flat_paths = flat_paths, flat_bases = flat_bases),
    None => union_checked_eq_rows(flat_paths = flat_paths, flat_bases = flat_bases)
  }
  (rewrite_string_binops_stmts(stmts = merged, rels = rels, pluses = pluses, anchor = typed_lowering_binop_anchor), floats, int_renders, bool_renders, eq_offs, eq_keys)
}

/// Interior-line breakpoints: sorted offsets of each '\n' in `src` past the block the loader
/// prepends to a directory-shared sibling, so lines count on disk (#3656). Local codegen copy.
///
/// Sized by a counting pass first: grown from empty, a compiler-sized source
/// list left every doubling's buffer behind on the heap.
fn file_newline_offsets(_ src: String) -> Array[Int] {
  let n = String::length(src)
  let mut count = 0
  let mut j = loader_prepended_prefix_bytes(src)
  while j < n {
    if String::byte_at(src, at = j) == 10 {
      count = count + 1
    }
    j = j + 1
  }
  let arr = Array::with_capacity(count)
  let mut i = loader_prepended_prefix_bytes(src)
  while i < n {
    if String::char_code_at(src, at = i) == 10 {
      Array::push(arr, value = i)
    } else {
      ()
    }
    i = i + 1
  }
  arr
}

/// Interior-line breakpoints (span-arc step5, multi-file): like
/// build_grouped_merged_stmts but ALSO records, per merged top-level statement,
/// which SOURCE FILE it came from — so codegen can map each statement's char
/// offset to a line IN ITS OWN FILE (offsets from different files collide after
/// the merge). Returns (merged, file_basenames, file_newlines, stmt_file_id):
///   file_basenames[k] / file_newlines[k]  — the k-th distinct source file
///   stmt_file_id[s]                        — file id of merged top-level stmt s
/// Provenance is captured by measuring the merged-array length delta around each
/// source's append, so it stays aligned no matter how many statements a source
/// contributes; the append calls themselves mirror the ordinary offsets merge
/// exactly, so `merged` is identical to the normal (rc/bump) path.
///
/// #2391: the merge is disjoint-rebased like the ordinary path, and each
/// file's NEWLINE table is shifted by the same base. `offset_to_line` only
/// compares newline offsets against statement offsets, so shifting both
/// sides by one base leaves every computed line number unchanged -- the
/// break lane keeps its per-file line mapping with no codegen change, and
/// the float-offset union (via the caller-passed sinks, same contract as
/// build_grouped_merged_stmts_impl) speaks the same offset space.
/// #2388: the merge plus the per-file debug provenance the break lane needs --
/// `files[k]` the PATH of flat source k, `file_nls[k]` its newline offsets
/// already shifted into the merge's offset space, `stmt_file_id[s]` the flat
/// source that owns merged statement s.
///
/// #2199: the path, not the basename it used to be. `files` is also what a
/// production trap prints (`vibe.dbgfiles`, via `frame: main (<file>:<line>)`),
/// and a basename there is not a thing to open from the project root -- and
/// names no one file as soon as the program pulls in two packages, each with
/// its own `index.vibe` (Codex P2 on PR #2867). What the loader opened is what
/// the reader can open. The break lane is unaffected: a `--break <file>:<line>`
/// spec is reduced to its basename before matching, and the runner matches and
/// prints these entries by basename too.
///
/// This used to be a SECOND COPY of build_grouped_merged_stmts_impl with the
/// provenance collection interleaved, carrying a comment promising that its
/// `merged` "stays identical to the normal (non-break) merge" -- a property
/// nothing checked, between two bodies that had to be edited in step. It is a
/// wrapper now, so the promise holds by construction.
///
/// `files` and `file_nls` are derived here rather than inside the merge
/// because a newline table costs a scan of every source byte. Production
/// trap maps and the break lane consume one, while the counted merge does not. The bases come from the merge's own
/// `flat_bases_out`: its first `Array::length(flat_sources)` entries are the
/// per-source offset bases, recorded before the append loop runs (the
/// alias-collision fallback appends further entries after those, which is why
/// the count is taken from the sources and not from the array's length).
export fn build_grouped_merged_stmts_prov(source_groups: Array[(String, Array[(String, String)])], flat_paths_out: Array[String], flat_bases_out: Array[Int], clone_float_offsets_out: Array[Int]) -> (Array[Stmt], Array[String], Array[Array[Int]], Array[Int]) with Env + Exception {
  let stmt_file_id = array_empty()
  let merged = build_grouped_merged_stmts_impl(source_groups = source_groups, disjoint_offset_spaces = true, flat_paths_out = flat_paths_out, flat_bases_out = flat_bases_out, clone_float_offsets_out = clone_float_offsets_out, stmt_file_id_out = stmt_file_id, collect_stmt_ids = true, file_fps_out = [
  ], file_counts_out = [], collect_file_counts = false, cfg = target_cfg_ambient(), lowering_inputs = None)
  let flat_sources = flatten_group_sources(source_groups)
  let files = array_empty()
  let file_nls = array_empty()
  let mut si = 0
  while si < Array::length(flat_sources) {
    let (flat_path, flat_source) = Array::get(flat_sources, at = si)
    Array::push(files, value = flat_path)
    let base = if si < Array::length(flat_bases_out) {
      Array::get(flat_bases_out, at = si)
    } else {
      0
    }
    let nls = file_newline_offsets(flat_source)
    let mut nli = 0
    while nli < Array::length(nls) {
      Array::set(nls, at = nli, value = Array::get(nls, at = nli) + base)
      nli = nli + 1
    }
    Array::push(file_nls, value = nls)
    si = si + 1
  }
  (merged, files, file_nls, stmt_file_id)
}

/// Merge for the body cache, retaining per-source identities and run lengths.
/// Uses the ordinary merge's append and location layout without allocating
/// an unused per-statement ID table or scanning source text for newlines.
export fn build_grouped_merged_stmts_counted(_ source_groups: Array[(String, Array[(String, String)])]) -> (Array[Stmt], Array[String], Array[String], Array[Int], Array[Int], Array[Int]) with Env + Exception {
  let paths: Array[String] = []
  let fps: Array[String] = []
  let counts: Array[Int] = []
  let bases: Array[Int] = []
  let clones: Array[Int] = []
  let merged = build_grouped_merged_stmts_impl(source_groups = source_groups, disjoint_offset_spaces = true, flat_paths_out = paths, flat_bases_out = bases, clone_float_offsets_out = clones, stmt_file_id_out = [
  ], collect_stmt_ids = false, file_fps_out = fps, file_counts_out = counts, collect_file_counts = true, cfg = target_cfg_ambient(), lowering_inputs = None)
  (merged, paths, fps, counts, bases, clones)
}

/// Expand a counted merge's run lengths into statement provenance and scan
/// its source groups for the same rebased newline tables as the ordinary lane.
/// Empty source groups retain an empty newline table for synthetic callers.
export fn ordinary_lane_dbg_prov(file_paths: Array[String], file_counts: Array[Int], source_groups: Array[(String, Array[(String, String)])], file_bases: Array[Int]) -> DbgProv {
  let files = array_empty()
  let stmt_file_id = array_empty()
  let mut i = 0
  while i < Array::length(file_paths) && i < Array::length(file_counts) {
    // #2199: the path the loader opened, like `build_grouped_merged_stmts_prov`
    // -- the two lanes feed the same `vibe.dbgfiles`, so a basename here would
    // make a trap's location depend on whether the body cache was on.
    Array::push(files, value = Array::get(file_paths, at = i))
    let n = Array::get(file_counts, at = i)
    let mut k = 0
    while k < n {
      Array::push(stmt_file_id, value = i)
      k = k + 1
    }
    i = i + 1
  }
  let flat = flatten_group_sources(source_groups)
  let file_nls = array_empty()
  let mut si = 0
  while si < Array::length(flat) {
    let (_, flat_source) = Array::get(flat, at = si)
    let base = if si < Array::length(file_bases) {
      Array::get(file_bases, at = si)
    } else {
      0
    }
    let nls = file_newline_offsets(flat_source)
    let mut nli = 0
    while nli < Array::length(nls) {
      Array::set(nls, at = nli, value = Array::get(nls, at = nli) + base)
      nli = nli + 1
    }
    Array::push(file_nls, value = nls)
    si = si + 1
  }
  DbgProv::{ files: files, file_nls: file_nls, stmt_file_id: stmt_file_id }
}

/// #1872 boundary 4: the inline-sources merge (`entry/compiler/fs_compile`) --
/// one flat source list in import order, entry last -- is the grouped merge
/// over a single group, with disjoint offset spaces. The group's name is never
/// read, so there is one merge implementation for both entry families. Each
/// file's base and every alias-collision clone's float offsets are reported for
/// the caller to rebase its own typed-lowering rows.
export fn build_inline_merged_stmts(sources: Array[(String, String)], flat_paths_out: Array[String], flat_bases_out: Array[Int], clone_float_offsets_out: Array[Int]) -> Array[Stmt] with Exception {
  build_grouped_merged_stmts_impl(source_groups = [("", sources)], disjoint_offset_spaces = true, flat_paths_out = flat_paths_out, flat_bases_out = flat_bases_out, clone_float_offsets_out = clone_float_offsets_out, stmt_file_id_out = [
  ], collect_stmt_ids = false, file_fps_out = [], file_counts_out = [], collect_file_counts = false, cfg = target_cfg_ambient(), lowering_inputs = None)
}

/// Located merge without statement provenance, retaining the shared file bases.
export fn build_grouped_merged_stmts_with_offsets(source_groups: Array[(String, Array[(String, String)])], flat_paths: Array[String], flat_bases: Array[Int]) -> Array[Stmt] with Env + Exception {
  build_grouped_merged_stmts_impl(source_groups = source_groups, disjoint_offset_spaces = true, flat_paths_out = flat_paths, flat_bases_out = flat_bases, clone_float_offsets_out = [
  ], stmt_file_id_out = [], collect_stmt_ids = false, file_fps_out = [], file_counts_out = [
  ], collect_file_counts = false, cfg = target_cfg_ambient(), lowering_inputs = None)
}

/// #1872 boundary 4: the in-db artifact fingerprint of a merged or module
/// source text, shared by both compile driver families (one copy, so the two
/// lanes cannot key one artifact two ways).
export fn artifact_fingerprint_from_source(_ source: String) -> String {
  let mod1 = 2147483647
  let mod2 = 2147483629
  let step1 = 131
  let step2 = 65599
  let len = String::length(source)
  let mut h1 = 17
  let mut h2 = 29
  let mut i = 0
  while i < len {
    let c = String::char_code_at(source, at = i)
    h1 = (h1 * step1 + c + 1) % mod1
    h2 = (h2 * step2 + c + i + 1) % mod2
    i = i + 1
  }
  String::concat(__to_string(len), String::concat(":", String::concat(__to_string(h1), String::concat(":", __to_string(h2)))))
}

/// #1872 boundary 4: the cache-key text of the three typed-lowering offset
/// tables (float calls, Int renders, Bool renders), shared by both drivers.
export fn typed_offsets_key(floats: Array[Int], ints: Array[Int], bools: Array[Int]) -> String {
  let out = StringBuilder::new()
  let mut k = 0
  while k < 3 {
    let table = if k == 0 {
      floats
    } else if k == 1 {
      ints
    } else {
      bools
    }
    StringBuilder::push(out, value = "|")
    let mut i = 0
    while i < Array::length(table) {
      StringBuilder::push(out, value = Int::to_string(Array::get(table, at = i)))
      StringBuilder::push(out, value = ",")
      i = i + 1
    }
    k = k + 1
  }
  StringBuilder::freeze(out)
}

/// #1872 boundary 4: the module lane keeps only function bindings and the
/// serialized builtin-iterator boundary markers; shared by both drivers.
export fn module_lane_filter_stmts(_ stmts: Array[Stmt]) -> Array[Stmt] {
  let filtered = array_empty()
  let mut i = 0
  while i < Array::length(stmts) {
    let stmt = Array::get(stmts, at = i)
    let keep = match stmt {
      SLet(_, _, _, _, expr) => match expr {
        EFn(_, _, _, _, _, _) => true,
        _ => false
      },
      _ => builtin_iterator_serialized_boundary_markers(stmt) is Some(_)
    }
    if keep {
      Array::push(filtered, value = stmt)
    } else {
      ()
    }
    i = i + 1
  }
  filtered
}
