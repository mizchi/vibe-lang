//# Imports

import @vibe/compiler/core {
  Type
}

import @vibe/core {
  array_empty
}

//# Functions

fn no_params() -> Array[Type] {
  array_empty()
}

export fn lookup_char(name: String) -> Option[Type] {
  if name == "Char::to_int" {
    Some(CtFn([CtChar], CtInt, None))
  }
  else if name == "Char::from_int" {
    Some(CtFn([CtInt], CtChar, None))
  }
  else None
}

export fn lookup_json(name: String) -> Option[Type] {
  if name == "Json::stringify" {
    Some(CtFn([CtUnknown], CtString, None))
  }
  else if name == "Json::parse" {
    Some(CtFn([CtString], CtUnknown, None))
  }
  else if name == "Json::stringify_lines" {
    Some(CtFn([CtUnknown], CtString, None))
  }
  else if name == "Json::parse_lines" {
    Some(CtFn([CtString], CtArray(CtUnknown), None))
  }
  else if name == "Json::type_of" {
    Some(CtFn([CtUnknown], CtString, None))
  }
  else if name == "Json::get" {
    Some(CtFn([CtUnknown, CtString], CtUnknown, None))
  }
  else if name == "Json::index" {
    Some(CtFn([CtUnknown, CtInt], CtUnknown, None))
  }
  else if name == "Json::number" {
    Some(CtFn([CtUnknown], CtDouble, None))
  }
  else if name == "Json::bool" {
    Some(CtFn([CtUnknown], CtBool, None))
  }
  else if name == "Json::length" {
    Some(CtFn([CtUnknown], CtInt, None))
  }
  else if name == "Json::keys" {
    Some(CtFn([CtUnknown], CtArray(CtString), None))
  }
  else None
}

export fn lookup_numeric(name: String) -> Option[Type] {
  if name == "Int::parse" {
    Some(CtFn([CtString], CtOption(CtInt), None))
  }
  else if name == "Double::parse" {
    Some(CtFn([CtString], CtOption(CtDouble), None))
  }
  else if name == "Int::abs" {
    Some(CtFn([CtInt], CtInt, None))
  }
  else if name == "Int::is_even" {
    Some(CtFn([CtInt], CtBool, None))
  }
  else if name == "Int::max" {
    Some(CtFn([CtInt, CtInt], CtInt, None))
  }
  else if name == "Int::clamp" {
    Some(CtFn([CtInt, CtInt, CtInt], CtInt, None))
  }
  else if name == "Double::abs" {
    Some(CtFn([CtDouble], CtDouble, None))
  }
  else if name == "Double::floor" {
    Some(CtFn([CtDouble], CtInt, None))
  }
  else if name == "Double::max" {
    Some(CtFn([CtDouble, CtDouble], CtDouble, None))
  }
  else if name == "Int::to_float" {
    Some(CtFn([CtInt], CtDouble, None))
  }
  else if name == "Float::to_int" {
    Some(CtFn([CtDouble], CtInt, None))
  }
  else if name == "Float::to_double" {
    Some(CtFn([CtDouble], CtDouble, None))
  }
  else if name == "Double::to_float" {
    Some(CtFn([CtDouble], CtDouble, None))
  }
  else None
}

export fn lookup_wasm_ops(name: String) -> Option[Type] {
  if name == "i32_eq" {
    Some(CtFn([CtInt, CtInt], CtBool, None))
  }
  else if name == "i32_eqz" {
    Some(CtFn([CtInt], CtBool, None))
  }
  else if name == "i32_load" {
    Some(CtFn([CtUnknown, CtInt], CtInt, None))
  }
  else if name == "i32_store" {
    Some(CtFn([CtUnknown, CtInt, CtInt], CtUnit, None))
  }
  else if name == "i32_shr_u" {
    Some(CtFn([CtInt, CtInt], CtInt, None))
  }
  else if name == "f32_eq" {
    Some(CtFn([CtDouble, CtDouble], CtBool, None))
  }
  else if name == "f32_load" {
    Some(CtFn([CtUnknown, CtInt], CtDouble, None))
  }
  else if name == "f32_store" {
    Some(CtFn([CtUnknown, CtInt, CtDouble], CtUnit, None))
  }
  else if name == "f64_eq" {
    Some(CtFn([CtDouble, CtDouble], CtBool, None))
  }
  else if name == "f64_load" {
    Some(CtFn([CtUnknown, CtInt], CtDouble, None))
  }
  else if name == "f64_store" {
    Some(CtFn([CtUnknown, CtInt, CtDouble], CtUnit, None))
  }
  else None
}

export fn lookup_array_extra(name: String) -> Option[Type] {
  if name == "Array::truncate" {
    Some(CtFn([CtArray(CtUnknown), CtInt], CtUnit, None))
  }
  else None
}

export fn lookup_string_extra(name: String) -> Option[Type] {
  if name == "String::join" {
    Some(CtFn([CtArray(CtString), CtString], CtString, None))
  }
  else if name == "String::replace" {
    Some(CtFn([CtString, CtString, CtString], CtString, None))
  }
  else if name == "String::split" {
    Some(CtFn([CtString, CtString], CtArray(CtString), None))
  }
  else if name == "String::to_upper" {
    Some(CtFn([CtString], CtString, None))
  }
  else if name == "String::trim" {
    Some(CtFn([CtString], CtString, None))
  }
  else if name == "String::unicode_length" {
    Some(CtFn([CtString], CtInt, None))
  }
  else if name == "Lines::parse" {
    Some(CtFn([CtArray(CtString)], CtString, None))
  }
  else if name == "Lines::stringify" {
    Some(CtFn([CtString], CtArray(CtString), None))
  }
  else None
}

export fn lookup_extended(name: String) -> Option[Type] {
  match lookup_numeric(name) {
    Some(t) => Some(t),
    None => match lookup_json(name) {
      Some(t) => Some(t),
      None => match lookup_char(name) {
        Some(t) => Some(t),
        None => match lookup_string_extra(name) {
          Some(t) => Some(t),
          None => match lookup_array_extra(name) {
            Some(t) => Some(t),
            None => lookup_wasm_ops(name)
          }
        }
      }
    }
  }
}
