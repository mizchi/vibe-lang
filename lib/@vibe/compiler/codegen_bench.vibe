//# Imports

import @vibe/compiler/core {
  Expr, Stmt, TypeExpr
}

import @vibe/core {
  array_empty
}

import @vibe/compiler/codegen {
  compile_module
}

//# Functions

fn empty_type_params() -> Array[String] {
  array_empty()
}

fn empty_type_bounds() -> Array[(String, Array[String])] {
  array_empty()
}

fn int_param(name: String) -> (String, Option[TypeExpr]) {
  (name, Some(TyName("Int")))
}

fn build_lambda(i: Int) -> Expr {
  let param_name = String::concat("y_", __to_string(i))
  EFn(empty_type_params(), empty_type_bounds(), [int_param(param_name)], Some(TyName("Int")), None, EBinOp("+", EIdent("x", -1), EIdent(param_name, -1)))
}

fn build_lambda_chain_body(n: Int) -> Expr {
  let mut i = n
  let mut body = EInt(0)
  while i > 0 {
    body = ELet(String::concat("f_", __to_string(i)), build_lambda(i), body, -1)
    i = i - 1
  }
  ELet("x", EInt(1), body, -1)
}

fn build_lambda_chain_module(n: Int) -> Array[Stmt] {
  [
    SLet(true, false, "main", None, EFn(empty_type_params(), empty_type_bounds(), array_empty(), Some(TyName("Int")), None, build_lambda_chain_body(n)))
  ]
}

fn helper_name(i: Int) -> String {
  String::concat("helper_", __to_string(i))
}

fn build_helper_stmt(i: Int) -> Stmt {
  SLet(false, false, helper_name(i), None, EFn(empty_type_params(), empty_type_bounds(), [
    int_param("z")
  ], Some(TyName("Int")), None, EIdent("z", -1)))
}

fn build_lambda_chain_module_with_helpers(helper_count: Int, lambda_count: Int) -> Array[Stmt] {
  let stmts = array_empty()
  let mut hi = 0
  while hi < helper_count {
    Array::push(stmts, build_helper_stmt(hi))
    hi = hi + 1
  }
  let main_stmts = build_lambda_chain_module(lambda_count)
  Array::push(stmts, Array::get(main_stmts, 0))
  stmts
}

//# Misc

let lambda_chain_64 = build_lambda_chain_module(64)
let lambda_chain_helpers_128_64 = build_lambda_chain_module_with_helpers(128, 64)

bench "codegen_lambda_chain_64" {
  let bytes = compile_module(lambda_chain_64)
  let _ = Bytes::length(bytes)
}

bench "codegen_lambda_chain_helpers_128_64" {
  let bytes = compile_module(lambda_chain_helpers_128_64)
  let _ = Bytes::length(bytes)
}
