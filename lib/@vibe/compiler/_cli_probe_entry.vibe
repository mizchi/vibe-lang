//# Imports

import @vibe/compiler/entry/source_compile/wasi_only {
  compile_source_wasi_only
}

import ../cli/dispatch.vibe {
  read_arg
}

import ./cli_support.vibe {
  build_linked_debug_entry, compile_debug_library, compile_release_file
}

//# Functions

export fn probe_arg0_len() -> Int {
  String::length(read_arg(0))
}

export fn probe_arg1_len() -> Int {
  String::length(read_arg(1))
}

export fn probe_arg2_len() -> Int {
  String::length(read_arg(2))
}

export fn probe_arg3_len() -> Int {
  String::length(read_arg(3))
}

export fn probe_args_len() -> Int with Env {
  perform Env::ArgsLen
}

export fn probe_source_len() -> Int with Exception + Fs + Env {
  let source = perform Fs::ReadFile(read_arg(0))
  String::length(source)
}

export fn probe_compile_len() -> Int with Exception + Fs + Env {
  let source = perform Fs::ReadFile(read_arg(0))
  let bytes = compile_source_wasi_only(source, read_arg(2))
  Bytes::length(bytes)
}

export fn probe_compile_file_len() -> Int with Exception + Fs + Env {
  let bytes = compile_release_file(read_arg(0), read_arg(2))
  Bytes::length(bytes)
}

export fn probe_compile_library_len() -> Int with Exception + Fs + Env {
  let bytes = compile_debug_library(read_arg(0))
  Bytes::length(bytes)
}

export fn probe_compile_linked_file_len() -> Int with Exception + Fs + Env {
  let (bytes, _) = build_linked_debug_entry(read_arg(0), read_arg(2))
  Bytes::length(bytes)
}
