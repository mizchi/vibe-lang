//# Imports

import @vibe/compiler/core {
  Type, TypeDef, find_typedef
}

import @vibe/core {
  array_empty
}

//# Functions

fn has_string(arr: Array[String], s: String, i: Int) -> Bool {
  if i >= Array::length(arr) {
    false
  } else if Array::get(arr, i) == s {
    true
  } else {
    has_string(arr, s, i + 1)
  }
}

fn empty_strings() -> Array[String] {
  array_empty()
}

fn normalize_inner(ty: Type, defs: Array[TypeDef], visited: Array[String]) -> Type {
  match ty {
    CtNamed(name, _args) => if has_string(visited, name, 0) {
      ty
    } else {
      Array::push(visited, name)
      match find_typedef(defs, name) {
        Some(td) => match td {
          TDAlias(_n, _, target) => normalize_inner(target, defs, visited),
          TDEnum(n, _, _) => CtEnum(n),
          TDStruct(n, _, _, _) => CtStruct(n),
          TDEffect(en, _, _) => CtNamed(en, array_empty())
        },
        None => ty
      }
    }
    ,
    CtFn(params, ret, he) => {
      let np = for p in params {
        normalize_inner(p, defs, visited)
      }
      CtFn(np, normalize_inner(ret, defs, visited), he)
    },
    CtArray(elem) => CtArray(normalize_inner(elem, defs, visited)),
    CtOption(elem) => CtOption(normalize_inner(elem, defs, visited)),
    CtTuple(elems) => CtTuple(for e in elems {
      normalize_inner(e, defs, visited)
    }),
    CtForAll(vars, bounds, body) => CtForAll(vars, bounds, normalize_inner(body, defs, visited)),
    _ => ty
  }
}

export fn normalize_type(ty: Type, defs: Array[TypeDef]) -> Type {
  normalize_inner(ty, defs, empty_strings())
}
