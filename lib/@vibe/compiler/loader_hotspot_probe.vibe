//# Imports

import @vibe/core {
  array_empty
}

// #847/#897: `join_path` used to be unreachable through `loader/index.vibe`
// (that module defines its own private, same-named `join_path` — a
// deliberate local duplicate, see its own #740 comment — so it couldn't
// re-export manifest_sources.vibe's `join_path` without a collision). Now
// that loader/ is a real `index.vpkg` package boundary, join_path is
// declared directly in the contract (no facade re-export needed), so it
// reaches here through the same package import as everything else below.
import @vibe/compiler/loader {
  build_grouped_sources_from_manifest_row_source_index,
  build_grouped_sources_from_manifest_rows,
  build_manifest_path_index,
  build_manifest_source_index,
  collect_all_sources_fs,
  collect_source_groups_fs,
  filter_manifest_sources_by_path_index,
  filter_manifest_sources_by_paths,
  filter_manifest_sources_by_source_index,
  join_path,
  load_manifest_full_sources,
  try_load_manifest_rows
}

//# Functions

let loader_entry_path = "lib/@vibe/compiler/loader/loader.vibe"

fn contains_str(values: Array[String], target: String) -> Bool {
  let mut found = false
  let mut i = 0
  while i < Array::length(values) {
    if Array::get(values, i) == target {
      found = true
      i = Array::length(values)
    } else {
      i = i + 1
    }
  }
  found
}

fn collect_source_paths(sources: Array[(String, String)]) -> Array[String] {
  let paths = array_empty()
  let mut i = 0
  while i < Array::length(sources) {
    let (path, _) = Array::get(sources, i)
    Array::push(paths, path)
    i = i + 1
  }
  paths
}

fn source_lookup_linear(sources: Array[(String, String)], path_key: String) -> Option[String] {
  let mut found = None
  let mut i = 0
  while i < Array::length(sources) {
    match found {
      Some(_) => (),
      None => {
        let (path, source) = Array::get(sources, i)
        if path == path_key {
          found = Some(source)
        }
      }
    }
    i = i + 1
  }
  found
}

fn push_grouped_source(groups: Array[(String, Array[(String, String)])], group_name: String, path: String, source: String) -> Unit {
  let mut i = 0
  let mut found = false
  while i < Array::length(groups) {
    let (name, sources) = Array::get(groups, i)
    if name == group_name {
      Array::push(sources, (path, source))
      found = true
      i = Array::length(groups)
    } else {
      i = i + 1
    }
  }
  if !found {
    let sources = array_empty()
    Array::push(sources, (path, source))
    Array::push(groups, (group_name, sources))
  }
}

fn encode_grouped_sources(groups: Array[(String, Array[(String, String)])]) -> Int {
  let mut total_sources = 0
  let mut i = 0
  while i < Array::length(groups) {
    let (_, sources) = Array::get(groups, i)
    total_sources = total_sources + Array::length(sources)
    i = i + 1
  }
  Array::length(groups) * 1000 + total_sources
}

export fn load_loader_hotspot_fixture() -> (String, Array[(String, String)], Array[(String, String)], Array[(String, String)], Array[String]) with Error + Fs {
  let entry_path = loader_entry_path
  match try_load_manifest_rows(entry_path) {
    Some((base_dir, rows)) => {
      let preloaded_sources = load_manifest_full_sources(base_dir, rows)
      let needed_sources = collect_all_sources_fs(entry_path)
      let needed_paths = collect_source_paths(needed_sources)
      (base_dir, rows, preloaded_sources, needed_sources, needed_paths)
    },
    None => throw("manifest rows are unavailable")
  }
}

export fn load_loader_hotspot_indexed_fixture() -> (String, Array[(String, String)], Array[(String, String)], Array[(String, String)], Array[String], Map[String, String], Map[String, Bool], Map[String, String]) with Error + Fs {
  let (base_dir, rows, preloaded_sources, needed_sources, needed_paths) = load_loader_hotspot_fixture()
  let preloaded_source_index = build_manifest_source_index(preloaded_sources)
  let needed_path_index = build_manifest_path_index(needed_paths)
  let needed_source_index = build_manifest_source_index(needed_sources)
  (base_dir, rows, preloaded_sources, needed_sources, needed_paths, preloaded_source_index, needed_path_index, needed_source_index)
}

export fn probe_loader_manifest_list_count() -> Int with Error + Fs {
  let sources = collect_all_sources_fs(loader_entry_path)
  Array::length(sources)
}

export fn probe_loader_manifest_list_filter_linear_count(preloaded_sources: Array[(String, String)], needed_paths: Array[String]) -> Int {
  let filtered_sources = array_empty()
  let mut i = 0
  while i < Array::length(preloaded_sources) {
    let (path, source) = Array::get(preloaded_sources, i)
    if contains_str(needed_paths, path) {
      Array::push(filtered_sources, (path, source))
    }
    i = i + 1
  }
  Array::length(filtered_sources)
}

export fn probe_loader_manifest_list_filter_indexed_count(preloaded_sources: Array[(String, String)], needed_paths: Array[String]) -> Int {
  let filtered_sources = filter_manifest_sources_by_paths(preloaded_sources, needed_paths)
  Array::length(filtered_sources)
}

export fn probe_loader_manifest_list_filter_indexed_count_with_index(preloaded_sources: Array[(String, String)], needed_path_index: Map[String, Bool]) -> Int {
  let filtered_sources = filter_manifest_sources_by_path_index(preloaded_sources, needed_path_index)
  Array::length(filtered_sources)
}

export fn probe_loader_manifest_list_filter_source_indexed_count(needed_paths: Array[String], preloaded_source_index: Map[String, String]) -> Int {
  let filtered_sources = filter_manifest_sources_by_source_index(needed_paths, preloaded_source_index)
  Array::length(filtered_sources)
}

export fn probe_loader_manifest_groups_encoded() -> Int with Error + Fs {
  let groups = collect_source_groups_fs(loader_entry_path)
  encode_grouped_sources(groups)
}

export fn probe_loader_manifest_groups_linear_encoded(base_dir: String, rows: Array[(String, String)], needed_sources: Array[(String, String)]) -> Int {
  let groups = array_empty()
  let mut i = 0
  while i < Array::length(rows) {
    let (group_name, rel_path) = Array::get(rows, i)
    // #769: use join_path (normalizes `../`), not raw concat -- the manifest
    // gained `../../../lib/@vibe/...` rows after this probe was written, and
    // un-normalized paths never matched the collected sources (44 vs 50
    // sources against the indexed baseline).
    let path = join_path(base_dir, rel_path)
    match source_lookup_linear(needed_sources, path) {
      Some(source) => push_grouped_source(groups, group_name, path, source),
      None => ()
    }
    i = i + 1
  }
  encode_grouped_sources(groups)
}

export fn probe_loader_manifest_groups_indexed_encoded(base_dir: String, rows: Array[(String, String)], needed_sources: Array[(String, String)]) -> Int {
  let groups = build_grouped_sources_from_manifest_rows(base_dir, rows, needed_sources)
  encode_grouped_sources(groups)
}

export fn probe_loader_manifest_groups_indexed_encoded_with_source_index(base_dir: String, rows: Array[(String, String)], needed_source_index: Map[String, String]) -> Int {
  let groups = build_grouped_sources_from_manifest_row_source_index(base_dir, rows, needed_source_index)
  encode_grouped_sources(groups)
}
