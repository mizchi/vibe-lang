e == \"simd_skip_ws\" {\n    Some(CtFn(bytes_three_params(CtBytes, CtInt, CtInt), CtInt, None))\n  }\n  else None\n}\n\nfn lookup_simd_scan_alnum(name: String) -> Option[Type] {\n  if name == \"simd_scan_alnum\" {\n    Some(CtFn(bytes_three_params(CtBytes, CtInt, CtInt), CtInt, None))\n  }\n  else None\n}\n\nfn lookup_simd_scan_alnum_str(name: String) -> Option[Type] {\n  if name == \"simd_scan_alnum_str\" {\n    Some(CtFn(bytes_three_params(CtString, CtInt, CtInt), CtInt, None))\n  }\n  else None\n}\n\nexport fn lookup_bytes(name: String) -> Option[Type] {\n  match lookup_bytes_group_a(name) {\n    Some(t) => Some(t),\n    None => match lookup_bytes_group_b(name) {\n      Some(t) => Some(t),\n      None => match lookup_bytes_group_c(name) {\n        Some(t) => Some(t),\n        None => match lookup_simd_skip_ws(name) {\n          Some(t) => Some(t),\n          None => match lookup_simd_scan_alnum(name) {\n            Some(t) => Some(t),\n            None => lookup_simd_scan_alnum_str(name)\n          }\n        }\n      }\n    }\n  }\n}\n")
