, emit_closure_resolve, emit_i64_extend_i32_u, is_mut_captured_in\\n}\\n\\nimport ../common_base {\\n  CompileCtxGc, CtorTable, FuncTable, LambdaTable, StrTable, emit_binop_op, emit_i32_eq, emit_i32_eqz, emit_i32_ge_u, emit_i32_mul, emit_i32_ne, emit_i32_sub, emit_i64_load, emit_i64_store, emit_str_ref, find_func_stmt, lookup_ctor, resolve_func, resolve_local\\n}\\n\\nimport ../common_extractors {\\n  array_contains_str, emit_assignop_op, emit_memory_copy, find_catchall_idx, str_table_lookup\\n}\\n\\nimport ../wasm_emit {\\n  emit_heap_memory_grow_check, emit_block_i64, emit_block_void, emit_br, emit_br_if, emit_call, emit_call_indirect, emit_code_section, emit_code_section_with_locals, emit_data_section, emit_data_section_multi, emit_drop, emit_element_section_active, emit_else, emit_end, emit_export_section, emit_export_section_multi, emit_exports_with_memory, emit_f64_add, emit_f64_const_bits, emit_f64_convert_i64_s, emit_f64_div, emit_f64_eq, emit_f64_ge, emit_f64_gt, emit_f64_le, emit_f64_lt, emit_f64_mul, emit_f64_ne, emit_f64_neg, emit_f64_reinterpret_i64, emit_f64_sub, emit_func_type_raw, emit_function_section, emit_global_get, emit_global_section_i32_mut, emit_global_set, emit_header, emit_i32_add, emit_i32_const, emit_i32_load, emit_i32_load8_u, emit_i32_store, emit_i32_store8, emit_i32_wrap_i64, emit_i64_add, emit_i64_and, emit_i64_const, emit_i64_div_s, emit_i64_eq, emit_i64_eqz, emit_i64_extend_i32_s, emit_i64_ge_s, emit_i64_gt_s, emit_i64_le_s, emit_i64_lt_s, emit_i64_mul, emit_i64_ne, emit_i64_or, emit_i64_reinterpret_f64, emit_i64_rem_s, emit_i64_shl, emit_i64_shr_s, emit_i64_sub, emit_i64_trunc_f64_s, emit_i64_xor, emit_if_i64, emit_if_void, emit_import_section_func, emit_local_get, emit_local_set, emit_local_tee, emit_loop_void, emit_memory_section, emit_name, emit_return, emit_struct_get, emit_struct_new, emit_struct_set, emit_struct_type_raw, emit_table_section_funcref, emit_type_section, emit_type_section_multi, string_to_data\\n}\\n\\n//# Functions\\n\\nexport fn gc_gen_str_substring_body() -> Bytes {\\n  let b = bytebuf_new()\\n  emit_local_get(b, 0)\\n  emit_i64_const(b, 32)\\n  emit_i64_shr_s(b)\\n  emit_i32_wrap_i64(b)\\n  emit_local_set(b, 3)\\n  emit_local_get(b, 2)\\n  emit_local_get(b, 1)\\n  emit_i64_sub(b)\\n  emit_i32_wrap_i64(b)\\n  emit_local_set(b, 4)\\n  emit_local_get(b, 3)\\n  emit_local_get(b, 1)\\n  emit_i32_wrap_i64(b)\\n  emit_i32_add(b)\\n  emit_i64_extend_i32_u(b)\\n  emit_i64_const(b, 32)\\n  emit_i64_shl(b)\\n  emit_local_get(b, 4)\\n  emit_i64_extend_i32_u(b)\\n  emit_i64_or(b)\\n  b\\n}\\n\\nexport fn gc_gen_str_char_code_at_body() -> Bytes {\\n  let b = bytebuf_new()\\n  emit_local_get(b, 0)\\n  emit_i64_const(b, 32)\\n  emit_i64_shr_s(b)\\n  emit_i32_wrap_i64(b)\\n  emit_local_set(b, 2)\\n  emit_local_get(b, 2)\\n  emit_local_get(b, 1)\\n  emit_i32_wrap_i64(b)\\n  emit_i32_add(b)\\n  emit_i32_load8_u(b, 0, 0)\\n  emit_i64_extend_i32_u(b)\\n  b\\n}\\n\\nexport fn gc_gen_str_from_char_code_body() -> Bytes {\\n  let b = bytebuf_new()\\n  emit_global_get(b, 0)\\n  emit_local_tee(b, 1)\\n  emit_i32_const(b, 1)\\n  emit_i32_add(b)\\n  emit_i32_const(b, 7)\\n  emit_i32_add(b)\\n  emit_i32_const(b, -8)\\n  bytebuf_push(b, 113)\\n  emit_global_set(b, 0)\\n  // #415: gc-lane heap bump must grow linear memory like the linear\\n  // backend does -- without this any allocation past the initial page\\n  // traps OOB (the gc smoke fixture only ever allocated a few bytes).\\n  emit_heap_memory_grow_check(b)\\n  emit_local_get(b, 1)\\n  emit_local_get(b, 0)\\n  emit_i32_wrap_i64(b)\\n  emit_i32_store8(b, 0, 0)\\n  emit_local_get(b, 1)\\n  emit_i64_extend_i32_u(b)\\n  emit_i64_const(b, 32)\\n  emit_i64_shl(b)\\n  emit_i64_const(b, 1)\\n  emit_i64_or(b)\\n  b\\n}\\n\")\n}\n\nlet cli_adapter_source_113 = () -> (String, String) {\n  (\"lib/@vibe/compiler/codegen/gc/backend_builtins_numeric.vibe\",\n\"//# Imports\\n\\nimport ../../core {\\n  Expr, Pat, Stmt, TypeExpr, bytebuf_length, bytebuf_new, bytebuf_push, bytebuf_push_section, bytebuf_push_vec_header, bytebuf_to_bytes, leb128_encode_s64, leb128_encode_u32\\n}\\n\\nimport ../common_analysis {\\n  collect_free_vars, collect_strings_stmts, emit_closure_call_tail, emit_closure_resolve, emit_i64_extend_i32_u, is_mut_captured_in\\n}\\n\\nimport ../common_base {\\n  CompileCtxGc, CtorTable, FuncTable, LambdaTable, StrTable, emit_binop_op, emit_i32_eq, emit_i32_eqz, emit_i32_ge_u, emit_i32_mul, emit_i32_ne, emit_i32_sub, emit_i64_load, emit_i64_store, emit_str_ref, find_func_stmt, lookup_ctor, resolve_func, resolve_local\\n}\\n\\nimport ../common_extractors {\\n  array_contains_str, emit_assignop_op, emit_memory_copy, find_catchall_idx, str_table_lookup\\n}\\n\\nimport ../wasm_emit {\\n  emit_heap_memory_grow_check, emit_block_i64, emit_block_void, emit_br, emit_br_if, emit_call, emit_call_indirect, emit_code_section, emit_code_section_with_locals, emit_data_section, emit_data_section_multi, emit_drop, emit_element_section_active, emit_else, emit_end, emit_export_section, emit_export_section_multi, emit_exports_with_memory, emit_f64_add, emit_f64_const_bits, emit_f64_const_lohi, emit_f64_convert_i64_s, emit_f64_div, emit_f64_eq, emit_f64_ge, emit_f64_gt, emit_f64_le, emit_f64_lt, emit_f64_mul, emit_f64_ne, emit_f64_neg, emit_f64_reinterpret_i64, emit_f64_sub, emit_func_type_raw, emit_function_section, emit_global_get, emit_global_section_i32_mut, emit_global_set, emit_header, emit_i32_add, emit_i32_const, emit_i32_load, emit_i32_load8_u, emit_i32_store, emit_i32_store8, emit_i32_wrap_i64, emit_i64_add, emit_i64_and, emit_i64_const, emit_i64_div_s, emit_i64_eq, emit_i64_eqz, emit_i64_extend_i32_s, emit_i64_ge_s, emit_i64_gt_s, emit_i64_le_s, emit_i64_lt_s, emit_i64_mul, emit_i64_ne, emit_i64_or, emit_i64_reinterpret_f64, emit_i64_rem_s, emit_i64_shl, emit_i64_shr_s, emit_i64_sub, emit_i64_trunc_f64_s, emit_i64_xor, emit_if_i64, emit_if_void, emit_import_section_func, emit_local_get, emit_local_set, emit_local_tee, emit_loop_void, emit_memory_section, emit_name, emit_return, emit_struct_get, emit_struct_new, emit_struct_set, emit_struct_type_raw, emit_table_section_funcref, emit_type_section, emit_type_section_multi, string_to_data\\n}\\n\\n//# Functions\\n\\nexport fn gc_gen_identity_body() -> Bytes {\\n  let b = bytebuf_new()\\n  emit_local_get(b, 0)\\n  b\\n}\\n\\n// Push `memory.size * 65536` (linear memory size in BYTES) as an i64.\\nfn gc_emit_mem_size_bytes(b: Bytes) -> Unit {\\n  bytebuf_push(b, 63)\\n  bytebuf_push(b, 0)\\n  emit_i64_extend_i32_u(b)\\n  emit_i64_const(b, 65536)\\n  emit_i64_mul(b)\\n}\\n\\n// #538 P4.5: runtime-dispatching `__to_string`, ported from the linear lane's\\n// inline call-site handler (compile_call.vibe, #606/#664 heuristics). String\\n// interpolation desugars EVERY `\\\\{x}` to `__to_string(x)`; the gc lane used to\\n// resolve that to the compiled program's own decimal-only `__to_string(Int)`,\\n// so interpolating a String rendered its packed (ptr<<32)|len pointer as a\\n// NUMBER — the parser's `\\\"\\\\{acc}, \\\\{name}\\\"` effect-row join produced rows like\\n// \\\"127642133069826, 127659312939013\\\" when the gc-compiled compiler ran, and\\n// every multi-label `with { A, B }` declaration stopped authorizing anything.\\n// Layout facts: params (val:i64); locals 1=neg 2=cur 3=abs 4=hp 5=len (i64);\\n// scratch digits build at bytes 46..1 (gc data_base is 64, so 0..63 is free).\\nexport fn gc_gen_to_string_body() -> Bytes {\\n  let b = bytebuf_new()\\n  emit_block_i64(b)\\n  // Looks-like-string test: ptr = val >> 32 (unsigned) >= 64, ptr < memsize,\\n  // ptr + len <= memsize  ->  identity (it IS a string).\\n  emit_local_get(b, 0)\\n  emit_i64_const(b, 32)\\n  bytebuf_push(b, 136)\\n  emit_local_tee(b, 3)\\n  emit_i64_const(b, 64)\\n  emit_i64_ge_s(b)\\n  emit_local_get(b, 3)\\n  gc_emit_mem_size_bytes(b)\\n  emit_i64_lt_s(b)\\n  bytebuf_push(b, 113)\\n  emit_local_get(b, 3)\\n  emit_local_get(b, 0)\\n  emit_i64_const(b, 4294967295)\\n  emit_i64_and(b)\\n  emit_i64_add(b)\\n  gc_emit_mem_size_bytes(b)\\n  emit_i64_le_s(b)\\n  bytebuf_push(b, 113)\\n  emit_if_void(b)\\n  emit_local_get(b, 0)\\n  emit_br(b, 1)\\n  emit_end(b)\\n  // Integer path: render decimal digits right-to-left into scratch bytes\\n  // 46..1, then copy to a fresh heap string.\\n  emit_i64_const(b, 46)\\n  emit_local_set(b, 2)\\n  emit_local_get(b, 0)\\n  emit_i64_const(b, 0)\\n  emit_i64_lt_s(b)\\n  emit_i64_extend_i32_s(b)\\n  emit_local_set(b, 1)\\n  emit_local_get(b, 0)\\n  emit_i64_const(b, 0)\\n  emit_i64_lt_s(b)\\n  emit_if_i64(b)\\n  emit_i64_const(b, 0)\\n  emit_local_get(b, 0)\\n  emit_i64_sub(b)\\n  emit_else(b)\\n  emit_local_get(b, 0)\\n  emit_end(b)\\n  emit_local_set(b, 3)\\n  emit_local_get(b, 3)\\n  emit_i64_eqz(b)\\n  emit_if_void(b)\\n  emit_local_get(b, 2)\\n  emit_i32_wrap_i64(b)\\n  emit_i32_const(b, 48)\\n  emit_i32_store8(b, 0, 0)\\n  emit_local_get(b, 2)\\n  emit_i64_const(b, 1)\\n  emit_i64_sub(b)\\n  emit_local_set(b, 2)\\n  emit_end(b)\\n  emit_block_void(b)\\n  emit_loop_void(b)\\n  emit_local_get(b, 3)\\n  emit_i64_eqz(b)\\n  emit_br_if(b, 1)\\n  emit_local_get(b, 2)\\n  emit_i32_wrap_i64(b)\\n  emit_local_get(b, 3)\\n  emit_i64_const(b, 10)\\n  emit_i64_rem_s(b)\\n  emit_i32_wrap_i64(b)\\n  emit_i32_const(b, 48)\\n  emit_i32_add(b)\\n  emit_i32_store8(b, 0, 0)\\n  emit_local_get(b, 2)\\n  emit_i64_const(b, 1)\\n  emit_i64_sub(b)\\n  emit_local_set(b, 2)\\n  emit_local_get(b, 3)\\n  emit_i64_const(b, 10)\\n  emit_i64_div_s(b)\\n  emit_local_set(b, 3)\\n  emit_br(b, 0)\\n  emit_end(b)\\n  emit_end(b)\\n  emit_local_get(b, 1)\\n  emit_i32_wrap_i64(b)\\n  emit_if_void(b)\\n  emit_local_get(b, 2)\\n  emit_i32_wrap_i64(b)\\n  emit_i32_const(b, 45)\\n  emit_i32_store8(b, 0, 0)\\n  emit_local_get(b, 2)\\n  emit_i64_const(b, 1)\\n  emit_i64_sub(b)\\n  emit_local_set(b, 2)\\n  emit_end(b)\\n  emit_global_get(b, 0)\\n  emit_i64_extend_i32_u(b)\\n  emit_local_set(b, 4)\\n  emit_i64_const(b, 46)\\n  emit_local_get(b, 2)\\n  emit_i64_sub(b)\\n  emit_local_set(b, 5)\\n  // Bump + grow check BEFORE the memory.copy into the fresh allocation —\\n  // same ordering fix as the linear inline `__to_string` handler\\n  // (compile_call.vibe): copying first traps when the previous allocation\\n  // left global 0 within `len` bytes of the memory end.\\n  emit_local_get(b, 4)\\n  emit_i32_wrap_i64(b)\\n  emit_local_get(b, 5)\\n  emit_i32_wrap_i64(b)\\n  emit_i32_const(b, 7)\\n  emit_i32_add(b)\\n  emit_i32_const(b, -8)\\n  bytebuf_push(b, 113)\\n  emit_i32_add(b)\\n  emit_global_set(b, 0)\\n  emit_heap_memory_grow_check(b)\\n  emit_local_get(b, 4)\\n  emit_i32_wrap_i64(b)\\n  emit_local_get(b, 2)\\n  emit_i64_const(b, 1)\\n  emit_i64_add(b)\\n  emit_i32_wrap_i64(b)\\n  emit_local_get(b, 5)\\n  emit_i32_wrap_i64(b)\\n  emit_memory_copy(b)\\n  emit_local_get(b, 4)\\n  emit_i64_const(b, 32)\\n  emit_i64_shl(b)\\n  emit_local_get(b, 5)\\n  emit_i64_or(b)\\n  emit_end(b)\\n  b\\n}\\n\\n// #997: see the identical guard + rationale on `gen_double_to_int_body` in\\n// codegen/builtin_bodies/bodies_core_b.vibe -- `i64.trunc_f64_s` traps on\\n// NaN/out-of-range, and this backend doesn't target the\\n// nontrapping-float-to-int-conversions proposal either, so NaN and\\n// out-of-i64-range doubles saturate to 0 instead of trunc'ing.\\nexport fn gc_gen_double_to_int_body() -> Bytes {\\n  let b = bytebuf_new()\\n  emit_local_get(b, 0)\\n  emit_f64_reinterpret_i64(b)\\n  emit_local_get(b, 0)\\n  emit_f64_reinterpret_i64(b)\\n  emit_f64_ne(b)\\n  emit_if_i64(b)\\n  emit_i64_const(b, 0)\\n  emit_else(b)\\n  emit_local_get(b, 0)\\n  emit_f64_reinterpret_i64(b)\\n  emit_f64_const_lohi(b, 0, 1138753536)\\n  emit_f64_lt(b)\\n  emit_if_i64(b)\\n  emit_local_get(b, 0)\\n  emit_f64_reinterpret_i64(b)\\n  emit_f64_const_lohi(b, 0, 3286237184)\\n  emit_f64_ge(b)\\n  emit_if_i64(b)\\n  emit_local_get(b, 0)\\n  emit_f64_reinterpret_i64(b)\\n  emit_i64_trunc_f64_s(b)\\n  emit_else(b)\\n  emit_i64_const(b, 0)\\n  emit_end(b)\\n  emit_else(b)\\n  emit_i64_const(b, 0)\\n  emit_end(b)\\n  emit_end(b)\\n  b\\n}\\n\\nexport fn gc_gen_int_to_double_body() -> Bytes {\\n  let b = bytebuf_new()\\n  emit_local_get(b, 0)\\n  emit_f64_convert_i64_s(b)\\n  emit_i64_reinterpret_f64(b)\\n  b\\n}\\n\")\n}\n\nlet cli_adapter_source_114 = () -> (String, String) {\n  (\"lib/@vibe/compiler/codegen/gc/backend_body.vibe\",\n\"//# Imports\\n\\nimport ../../core {\\n  Expr, Pat, Stmt, TypeExpr, bytebuf_length, bytebuf_new, bytebuf_push, bytebuf_push_buf, bytebuf_push_section, bytebuf_push_vec_header, bytebuf_to_bytes, leb128_encode_s64, leb128_encode_u32, rewrite_top_level_fn_alias_refs\\n}\\n\\nimport ../common_analysis {\\n  collect_free_vars, collect_strings_stmts, emit_closure_call_tail, emit_closure_resolve, emit_i64_extend_i32_u, is_mut_captured_in, stmts_contain_exceptions\\n}\\n\\nimport ../common_base {\\n  CompileCtxGc, CtorTable, FuncTable, LambdaTable, StrTable, agg_info_of_type_expr, compute_agg_returning, ctor_sorted_index, fn_type_param_types, emit_binop_op, emit_i32_eq, emit_i32_eqz, emit_i32_ge_u, emit_i32_mul, emit_i32_ne, emit_i32_sub, emit_i64_load, emit_i64_store, emit_str_ref, lookup_ctor, resolve_func, resolve_local\\n}\\n\\nimport ../common_extractors {\\n  array_contains_str, emit_assignop_op, emit_memory_copy, find_catchall_idx, str_table_lookup\\n}\\n\\nimport ../wasm_emit {\\n  emit_block_i64, emit_block_void, emit_br, emit_br_if, emit_call, emit_call_indirect, emit_code_section, emit_code_section_with_locals, emit_data_section, emit_data_section_multi, emit_drop, emit_element_section_active, emit_else, emit_end, emit_export_section, emit_export_section_multi, emit_exports_with_memory, emit_f64_add, emit_f64_const_bits, emit_f64_convert_i64_s, emit_f64_div, emit_f64_eq, emit_f64_ge, emit_f64_gt, emit_f64_le, emit_f64_lt, emit_f64_mul, emit_f64_ne, emit_f64_neg, emit_f64_reinterpret_i64, emit_f64_sub, emit_func_type_raw, emit_function_section, emit_global_get, emit_global_section_i32_mut, emit_global_set, emit_header, emit_i32_add, emit_i32_const, emit_i32_load, emit_i32_load8_u, emit_i32_store, emit_i32_store8, emit_i32_wrap_i64, emit_i64_add, emit_i64_and, emit_i64_const, emit_i64_div_s, emit_i64_eq, emit_i64_eqz, emit_i64_extend_i32_s, emit_i64_ge_s, emit_i64_gt_s, emit_i64_le_s, emit_i64_lt_s, emit_i64_mul, emit_i64_ne, emit_i64_or, emit_i64_reinterpret_f64, emit_i64_rem_s, emit_i64_shl, emit_i64_shr_s, emit_i64_sub, emit_i64_trunc_f64_s, emit_i64_xor, emit_if_i64, emit_if_void, emit_import_section_func, emit_local_get, emit_local_set, emit_local_tee, emit_loop_void, emit_memory_section, emit_name, emit_return, emit_struct_get, emit_struct_new, emit_struct_set, emit_struct_type_raw, emit_table_section_funcref, emit_type_section, emit_type_section_multi, string_to_data\\n}\\n\\nimport ../builtin_registry.vibe {\\n  builtin_registry, verify_lane_builtins\\n}\\n\\nimport ../builtin_bodies {\\n  gen_str_eq_body, gen_str_lex_diff_body, gen_bytes_append_body, gen_bytes_blit_body, gen_bytes_concat_body, gen_bytes_fill_body, gen_bytes_from_array_body, gen_bytes_get_body, gen_bytes_new_body, gen_bytes_push_body, gen_bytes_set_body, gen_bytes_slice_body, gen_bytes_to_array_body, gen_eq_body, gen_string_contains_body, gen_string_ends_with_body, gen_string_index_of_body, gen_string_join_body, gen_string_last_index_of_body, gen_string_split_body, gen_string_starts_with_body, gen_string_trim_body\\n}\\n\\nimport ./backend_builtins_array_alloc.vibe {\\n  gc_gen_arr_concat_body, gc_gen_arr_len_body, gc_gen_arr_new_body, gc_gen_arr_push_all_body, gc_gen_arr_slice_body, gc_gen_arr_truncate_body\\n}\\n\\nimport ./backend_builtins_array_get.vibe {\\n  gc_gen_arr_get_body\\n}\\n\\nimport ./backend_builtins_array_push.vibe {\\n  gc_gen_arr_push_body\\n}\\n\\nimport ./backend_builtins_array_set.vibe {\\n  gc_gen_arr_set_body\\n}\\n\\nimport ./backend_builtins_numeric.vibe {\\n  gc_gen_double_to_int_body, gc_gen_identity_body, gc_gen_int_to_double_body, gc_gen_to_string_body\\n}\\n\\nimport ./backend_builtins_print.vibe {\\n  gc_gen_print_i64_body, gc_gen_print_str_body\\n}\\n\\nimport ./backend_builtins_string.vibe {\\n  gc_gen_str_concat_body, gc_gen_str_eq_body, gc_gen_str_len_body\\n}\\n\\nimport ./backend_builtins_string_extra.vibe {\\n  gc_gen_str_char_code_at_body, gc_gen_str_from_char_code_body, gc_gen_str_substring_body\\n}\\n\\nimport ./backend_expr.vibe {\\n  compile_expr_gc\\n}\\n\\nimport ../wasi/linked_helpers.vibe {\\n  stmts_use_builtin\\n}\\n\\n\\n//# Functions\\n\\n// #805 (ADR-0072): inline wasm (`fn f(..) -> Int = wasm \\\"...\\\"`, carried as\\n// the parser-internal `%wasm(\\\"<WAT>\\\")` marker body) is LINEAR-BACKEND ONLY —\\n// the WAT text is written against the linear backend's raw 62-bit tagged i64\\n// ABI, which the wasm-gc backend does not share. Reject loudly instead of\\n// letting the marker fall through to an opaque unknown-function error.\\nfn gc_reject_inline_wasm(stmts: Array[Stmt]) -> Unit with { Error } {\\n  let mut i = 0\\n  while i < Array::length(stmts) {\\n    match Array::get(stmts, i) {\\n      SLet(_, _, iw_name, _, iw_expr) => match iw_expr {\\n        EFn(_, _, _, _, _, iw_body) => match iw_body {\\n          ECall(iw_cal, iw_args, _) => match iw_cal {\\n            EIdent(iw_cn, _) => if iw_cn == \\\"%wasm\\\" && Array::length(iw_args) == 1 {\\n              throw(\\\"inline wasm fn '\\\\{iw_name}' (= wasm \\\\\\\"...\\\\\\\") is linear-backend only; the wasm-gc backend does not support it (#805)\\\")\\n            } else {\\n              ()\\n            },\\n            _ => ()\\n          },\\n          _ => ()\\n        },\\n        _ => ()\\n      },\\n      _ => ()\\n    }\\n    i = i + 1\\n  }\\n}\\n\\nexport fn compile_wasi_module_gc(stmts: Array[Stmt], entry_name: String) -> Bytes with { Error } {\\n  // #805: inline-wasm fns are linear-backend only — reject before any work.\\n  gc_reject_inline_wasm(stmts)\\n  // Top-level `let f = g` function aliases: retarget references to the final\\n  // EFn def so calls do not route through a 0-param thunk registration\\n  // (invalid wasm for any call arity). See import_alias_rewrite.vibe.\\n  rewrite_top_level_fn_alias_refs(stmts)\\n  let fn_names_list = Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n  let fn_param_counts = Array::slice([\\n    0\\n  ], 0, 0)\\n  let fn_needs_env_list = Array::slice([\\n    true\\n  ], 0, 0)\\n  let user_func_stmts = Array::slice([\\n    SExpr(EUnit)\\n  ], 0, 0)\\n  let mut i = 0\\n  while i < Array::length(stmts) {\\n    let stmt = Array::get(stmts, i)\\n    match stmt {\\n      SLet(_, _, name, _, expr) => match expr {\\n        EFn(_, _, params, _, _, _) => {\\n          Array::push(fn_names_list, name)\\n          Array::push(fn_param_counts, Array::length(params))\\n          Array::push(fn_needs_env_list, true)\\n          Array::push(user_func_stmts, stmt)\\n          0\\n        },\\n        _ => 0\\n      }\\n      ,\\n      _ => 0\\n    }\\n    i = i + 1\\n  }\\n  let ctor_names_list = Array::slice([\\n    \\\"None\\\",\\n    \\\"Some\\\"\\n  ], 0, 2)\\n  let ctor_tags_list = Array::slice([\\n    0,\\n    1\\n  ], 0, 2)\\n  let ctor_field_counts_list = Array::slice([\\n    0,\\n    1\\n  ], 0, 2)\\n  let ctor_type_names_list = Array::slice([\\n    \\\"Option\\\",\\n    \\\"Option\\\"\\n  ], 0, 2)\\n  let mut type_index = 1\\n  let mut ei2 = 0\\n  while ei2 < Array::length(stmts) {\\n    match Array::get(stmts, ei2) {\\n      SEnum(_, ename, _, variants, _) => {\\n        type_index = type_index + 1\\n        let mut vi = 0\\n        while vi < Array::length(variants) {\\n          let (vname, vfields) = Array::get(variants, vi)\\n          Array::push(ctor_names_list, vname)\\n          Array::push(ctor_tags_list, (type_index<<16)|vi)\\n          Array::push(ctor_field_counts_list, Array::length(vfields))\\n          Array::push(ctor_type_names_list, ename)\\n          vi = vi + 1\\n        }\\n        0\\n      },\\n      SStruct(_, sname, sfields, _, _, _) => {\\n        type_index = type_index + 1\\n        Array::push(ctor_names_list, sname)\\n        Array::push(ctor_tags_list, type_index<<16)\\n        Array::push(ctor_field_counts_list, Array::length(sfields))\\n        Array::push(ctor_type_names_list, sname)\\n        0\\n      },\\n      _ => 0\\n    }\\n    ei2 = ei2 + 1\\n  }\\n  // Sorted ctor-name index (see CtorTable.names_sorted): built once here,\\n  // shared by every CtorTable literal below.\\n  let (gc_ctor_names_sorted, gc_ctor_names_sorted_pos) = ctor_sorted_index(ctor_names_list)\\n  // #538: module-level literal constants (Int / Bool / String). The user-func\\n  // walk keeps only EFn lets; scalar lets like `let op_call = 16` previously\\n  // vanished and every reference threw \\\"undefined variable\\\".\\n  let gc_const_names_l = Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n  let gc_const_kinds_l = Array::slice([\\n    0\\n  ], 0, 0)\\n  let gc_const_ivals_l = Array::slice([\\n    0\\n  ], 0, 0)\\n  let gc_const_svals_l = Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n  let gc_global_names_l = Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n  let gc_global_exprs_l = Array::slice([\\n    EUnit\\n  ], 0, 0)\\n  let mut gci = 0\\n  while gci < Array::length(stmts) {\\n    match Array::get(stmts, gci) {\\n      SLet(_, _, cname, _, cval) => match cval {\\n        EInt(iv) => {\\n          Array::push(gc_const_names_l, cname)\\n          Array::push(gc_const_kinds_l, 0)\\n          Array::push(gc_const_ivals_l, iv)\\n          Array::push(gc_const_svals_l, \\\"\\\")\\n        },\\n        EBool(bv) => {\\n          Array::push(gc_const_names_l, cname)\\n          Array::push(gc_const_kinds_l, 0)\\n          Array::push(gc_const_ivals_l, if bv {\\n            1\\n          } else {\\n            0\\n          })\\n          Array::push(gc_const_svals_l, \\\"\\\")\\n        },\\n        EString(sv) => {\\n          Array::push(gc_const_names_l, cname)\\n          Array::push(gc_const_kinds_l, 1)\\n          Array::push(gc_const_ivals_l, 0)\\n          Array::push(gc_const_svals_l, sv)\\n        },\\n        EFn(_, _, _, _, _, _) => (),\\n        _ => {\\n          // Computed module-level value: a mutable i64 global initialized at\\n          // the top of _start (B12 port).\\n          Array::push(gc_global_names_l, cname)\\n          Array::push(gc_global_exprs_l, cval)\\n        }\\n      },\\n      _ => ()\\n    }\\n    gci = gci + 1\\n  }\\n  let struct_names = Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n  let struct_field_names = Array::slice([\\n    Array::slice([\\n      \\\"\\\"\\n    ], 0, 0)\\n  ], 0, 0)\\n  let mut si = 0\\n  while si < Array::length(stmts) {\\n    match Array::get(stmts, si) {\\n      SStruct(_, sname, sfields, _, _, _) => {\\n        Array::push(struct_names, sname)\\n        let fnames = Array::slice([\\n          \\\"\\\"\\n        ], 0, 0)\\n        let mut sfi = 0\\n        while sfi < Array::length(sfields) {\\n          let (fname, _) = Array::get(sfields, sfi)\\n          Array::push(fnames, fname)\\n          sfi = sfi + 1\\n        }\\n        Array::push(struct_field_names, fnames)\\n        ()\\n      },\\n      _ => ()\\n    }\\n    si = si + 1\\n  }\\n  let num_user_funcs = Array::length(fn_names_list)\\n  if num_user_funcs == 0 {\\n    throw(\\\"no functions found to compile\\\")\\n  }\\n  let mut entry_user_idx = -1\\n  let mut ei = 0\\n  while ei < num_user_funcs {\\n    if Array::get(fn_names_list, ei) == entry_name {\\n      entry_user_idx = ei\\n    }\\n    ei = ei + 1\\n  }\\n  if entry_user_idx < 0 {\\n    throw(String::concat(\\\"entry function not found: \\\", entry_name))\\n  }\\n  let str_strs = collect_strings_stmts(stmts)\\n  // #538: StringBuilder::freeze joins with \\\"\\\" and println appends \\\"\\\\n\\\"; both\\n  // must exist in the string table even when the program has no such literal.\\n  if !array_contains_str(str_strs, \\\"\\\") {\\n    Array::push(str_strs, \\\"\\\")\\n  }\\n  if !array_contains_str(str_strs, \\\"\\\\n\\\") {\\n    Array::push(str_strs, \\\"\\\\n\\\")\\n  }\\n  let num_strings = Array::length(str_strs)\\n  let data_base = 64\\n  let str_offsets = Array::slice([\\n    0\\n  ], 0, 0)\\n  let str_lengths = Array::slice([\\n    0\\n  ], 0, 0)\\n  let mut str_pos = data_base\\n  let mut si = 0\\n  while si < num_strings {\\n    let s = Array::get(str_strs, si)\\n    let slen = String::length(s)\\n    Array::push(str_offsets, str_pos)\\n    Array::push(str_lengths, slen)\\n    str_pos = str_pos + slen\\n    si = si + 1\\n  }\\n  let heap_start = ((str_pos + 7) / 8) * 8\\n  let num_generated = 42\\n  // #538: host imports (module \\\"vibe\\\", tagged-i64 ABI -- the same raw ABI the\\n  // linear backend and the node host runner speak). Gated as a GROUP: pure\\n  // modules stay import-free (runnable on bare wasmtime); a module touching\\n  // any Env::/Fs:: builtin imports all nine at indices 1..9, shifting every\\n  // generated-body index by 9 (hbo).\\n  let use_host = stmts_use_builtin(stmts, fn_names_list, \\\"Env::get\\\") || stmts_use_builtin(stmts, fn_names_list, \\\"Env::args_len\\\") || stmts_use_builtin(stmts, fn_names_list, \\\"Env::args_get\\\") || stmts_use_builtin(stmts, fn_names_list, \\\"Fs::read_file\\\") || stmts_use_builtin(stmts, fn_names_list, \\\"Fs::exists\\\") || stmts_use_builtin(stmts, fn_names_list, \\\"Fs::stat_token\\\") || stmts_use_builtin(stmts, fn_names_list, \\\"Fs::write_file\\\") || stmts_use_builtin(stmts, fn_names_list, \\\"Fs::write_bytes\\\") || stmts_use_builtin(stmts, fn_names_list, \\\"Fs::read_bytes\\\") || stmts_use_builtin(stmts, fn_names_list, \\\"Profiler::now_us\\\")\\n  let hbo = if use_host {\\n    10\\n  } else {\\n    0\\n  }\\n  let func_offset = 1 + hbo + num_generated\\n  // #415 B-1: the central registry DRIVES the gc lane's registration too.\\n  // (name, params, returns) come from builtin_registry() rows with in_gc =\\n  // true; only the gc GENERATED-BODY INDEX is lane-local, resolved by the\\n  // match below. Adding a gc builtin = one registry row + one match arm (+\\n  // its generated body); param-count and returns live ONLY in the registry.\\n  let builtin_defs = Array::slice([\\n    (\\\"\\\", 0, 0, 0)\\n  ], 0, 0)\\n  let gc_registry_rows = builtin_registry()\\n  let mut gc_reg_i = 0\\n  while gc_reg_i < Array::length(gc_registry_rows) {\\n    let (gc_name, gc_params, gc_returns, _, gc_in_gc) = Array::get(gc_registry_rows, gc_reg_i)\\n    if gc_in_gc {\\n      let gc_body_idx = match gc_name {\\n        \\\"print_int\\\" => 1,\\n        \\\"print_str\\\" => 2,\\n        \\\"String::length\\\" => 3,\\n        \\\"String::equals\\\" => 4,\\n        \\\"String::concat\\\" => 5,\\n        \\\"array_new\\\" => 6,\\n        \\\"Array::length\\\" => 7,\\n        \\\"Array::get\\\" => 8,\\n        \\\"Array::push\\\" => 9,\\n        \\\"Array::set\\\" => 10,\\n        \\\"Double::to_int\\\" => 11,\\n        \\\"Int::to_double\\\" => 12,\\n        \\\"String::char_code_at\\\" => 13,\\n        \\\"String::from_char_code\\\" => 14,\\n        \\\"String::substring\\\" => 15,\\n        \\\"ArrayBuilder::new\\\" => 6,\\n        \\\"ArrayBuilder::push\\\" => 9,\\n        \\\"ArrayBuilder::freeze\\\" => 16,\\n        \\\"Array::slice\\\" => 38,\\n        \\\"Array::concat\\\" => 39,\\n        \\\"Array::truncate\\\" => 40,\\n        \\\"Array::push_all\\\" => 41,\\n        \\\"str_lex_diff\\\" => 42,\\n        \\\"eq\\\" => 29,\\n        \\\"not\\\" => 6,\\n        \\\"String::join\\\" => 35,\\n        \\\"String::ends_with\\\" => 33,\\n        \\\"String::last_index_of\\\" => 34,\\n        \\\"String::starts_with\\\" => 32,\\n        \\\"String::contains\\\" => 31,\\n        \\\"String::index_of\\\" => 30,\\n        \\\"String::split\\\" => 36,\\n        \\\"String::trim\\\" => 37,\\n        \\\"Bytes::new\\\" => 18,\\n        \\\"Bytes::length\\\" => 7,\\n        \\\"Bytes::get\\\" => 19,\\n        \\\"Bytes::set\\\" => 20,\\n        \\\"Bytes::push\\\" => 21,\\n        \\\"Bytes::append\\\" => 22,\\n        \\\"Bytes::concat\\\" => 23,\\n        \\\"Bytes::slice\\\" => 24,\\n        \\\"Bytes::from_array\\\" => 25,\\n        \\\"Bytes::to_array\\\" => 26,\\n        \\\"Bytes::blit\\\" => 27,\\n        \\\"Bytes::fill\\\" => 28,\\n        \\\"Double::to_i64_bits\\\" => 16,\\n        \\\"Double::from_i64_bits\\\" => 16,\\n        // #538 P4.5: identity wraps the trait-dict desugar emits around float\\n        // `==` operands (and int->float widening); all no-ops in the raw-bits\\n        // i64 world, same as the linear lane's compile_call identity handling.\\n        \\\"Double::to_float\\\" => 16,\\n        \\\"Float::to_double\\\" => 16,\\n        \\\"Char::to_int\\\" => 16,\\n        \\\"Char::from_int\\\" => 16,\\n        \\\"Int::to_float\\\" => 12,\\n        \\\"FixedArray::make\\\" => 6,\\n        \\\"FixedArray::length\\\" => 6,\\n        \\\"FixedArray::get\\\" => 6,\\n        \\\"FixedArray::set\\\" => 6,\\n        \\\"FixedArray::unsafe_set\\\" => 6,\\n        \\\"FixedArray::blit\\\" => 6,\\n        \\\"Int64Array::make\\\" => 6,\\n        \\\"Int64Array::length\\\" => 6,\\n        \\\"Int64Array::get\\\" => 6,\\n        \\\"Int64Array::set\\\" => 6,\\n        \\\"StringBuilder::new\\\" => 6,\\n        \\\"StringBuilder::push\\\" => 6,\\n        \\\"StringBuilder::freeze\\\" => 6,\\n        \\\"Map::get\\\" => 6,\\n        \\\"Map::keys\\\" => 6,\\n        \\\"MapBuilder::new\\\" => 6,\\n        \\\"MapBuilder::set\\\" => 6,\\n        \\\"MapBuilder::freeze\\\" => 6,\\n        \\\"__to_string\\\" => 17,\\n        \\\"assert\\\" => 6,\\n        \\\"assert_true\\\" => 6,\\n        \\\"assert_eq\\\" => 6,\\n        \\\"println\\\" => 6,\\n        \\\"print\\\" => 6,\\n        \\\"map_has\\\" => 6,\\n        _ => 0 - 1\\n      }\\n      if gc_body_idx < 0 {\\n        throw(\\\"builtin registry drift: no gc body-index mapping for builtin '\\\\{gc_name}' (add a match arm in backend_body.vibe, #415)\\\")\\n      } else {\\n        ()\\n      }\\n      Array::push(builtin_defs, (gc_name, gc_params, gc_body_idx, gc_returns))\\n    } else {\\n      ()\\n    }\\n    gc_reg_i = gc_reg_i + 1\\n  }\\n  // #415 B-0: builtin_defs must agree with the central registry (name set +\\n  // params + returns, both directions). The table is static, so this is a\\n  // full bidirectional check — a builtin added to the linear lane without an\\n  // explicit gc decision (or vice versa) fails every gc build by name.\\n  let __reg_names = Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n  let __reg_params = Array::slice([\\n    0\\n  ], 0, 0)\\n  let __reg_returns = Array::slice([\\n    0\\n  ], 0, 0)\\n  let mut __ri = 0\\n  while __ri < Array::length(builtin_defs) {\\n    let (rbname, rbparams, _, rbreturns) = Array::get(builtin_defs, __ri)\\n    Array::push(__reg_names, rbname)\\n    Array::push(__reg_params, rbparams)\\n    Array::push(__reg_returns, rbreturns)\\n    __ri = __ri + 1\\n  }\\n  verify_lane_builtins(\\\"gc\\\", __reg_names, __reg_params, __reg_returns)\\n  let mut __bi = 0\\n  while __bi < Array::length(builtin_defs) {\\n    let (bname, bparams, _, _) = Array::get(builtin_defs, __bi)\\n    Array::push(fn_names_list, bname)\\n    Array::push(fn_param_counts, bparams)\\n    Array::push(fn_needs_env_list, false)\\n    __bi = __bi + 1\\n  }\\n  let fn_indices_list = Array::slice([\\n    0\\n  ], 0, 0)\\n  let fn_returns_list = Array::slice([\\n    0\\n  ], 0, 0)\\n  let mut fi = 0\\n  while fi < num_user_funcs {\\n    Array::push(fn_indices_list, fi + func_offset)\\n    Array::push(fn_returns_list, 1)\\n    fi = fi + 1\\n  }\\n  let mut __bi2 = 0\\n  while __bi2 < Array::length(builtin_defs) {\\n    let (_, _, bwasm_idx, breturns) = Array::get(builtin_defs, __bi2)\\n    Array::push(fn_indices_list, bwasm_idx + hbo)\\n    Array::push(fn_returns_list, breturns)\\n    __bi2 = __bi2 + 1\\n  }\\n  // #538: host-import builtins at absolute import indices 1..9.\\n  if use_host {\\n    let host_defs = [\\n      (\\\"Env::get\\\", 1, 1, 1),\\n      (\\\"Env::args_len\\\", 0, 2, 1),\\n      (\\\"Env::args_get\\\", 1, 3, 1),\\n      (\\\"Fs::read_file\\\", 1, 4, 1),\\n      (\\\"Fs::exists\\\", 1, 5, 1),\\n      (\\\"Fs::stat_token\\\", 1, 6, 1),\\n      (\\\"Fs::write_file\\\", 2, 7, 0),\\n      (\\\"Fs::write_bytes\\\", 2, 8, 0),\\n      (\\\"Fs::read_bytes\\\", 1, 9, 1),\\n      (\\\"Profiler::now_us\\\", 0, 10, 1)\\n    ]\\n    let mut __hd = 0\\n    while __hd < Array::length(host_defs) {\\n      let (hname, hparams, hidx, hret) = Array::get(host_defs, __hd)\\n      Array::push(fn_names_list, hname)\\n      Array::push(fn_param_counts, hparams)\\n      Array::push(fn_needs_env_list, false)\\n      Array::push(fn_indices_list, hidx)\\n      Array::push(fn_returns_list, hret)\\n      __hd = __hd + 1\\n    }\\n  } else {\\n    ()\\n  }\\n  let ft_names = Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n  let ft_indices = Array::slice([\\n    0\\n  ], 0, 0)\\n  // #724 round 2: (fn name -> declared aggregate return shape) table for\\n  // `let a = f(..)` structural `==` (see compute_agg_returning).\\n  let gc_agg_ret_names_l = Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n  let gc_agg_ret_infos_l = Array::slice([\\n    0\\n  ], 0, 0)\\n  compute_agg_returning(stmts, CtorTable::{\\n    names: ctor_names_list, tags: ctor_tags_list, field_counts: ctor_field_counts_list, type_names: ctor_type_names_list, struct_names: struct_names, struct_field_names: struct_field_names, names_sorted: gc_ctor_names_sorted, names_sorted_pos: gc_ctor_names_sorted_pos\\n  }, gc_agg_ret_names_l, gc_agg_ret_infos_l)\\n  let ft_params = Array::slice([\\n    0\\n  ], 0, 0)\\n  let ft_returns = Array::slice([\\n    0\\n  ], 0, 0)\\n  let ft_needs_env = Array::slice([\\n    true\\n  ], 0, 0)\\n  let mut ft_copy_i = 0\\n  while ft_copy_i < Array::length(fn_names_list) {\\n    Array::push(ft_names, Array::get(fn_names_list, ft_copy_i))\\n    Array::push(ft_indices, Array::get(fn_indices_list, ft_copy_i))\\n    Array::push(ft_params, Array::get(fn_param_counts, ft_copy_i))\\n    Array::push(ft_returns, Array::get(fn_returns_list, ft_copy_i))\\n    Array::push(ft_needs_env, Array::get(fn_needs_env_list, ft_copy_i))\\n    ft_copy_i = ft_copy_i + 1\\n  }\\n  let refcell_type_idx = 10\\n  let closure_type_base = 11\\n  let fresh_bytes_array: () -> Array[Bytes] = () -> {\\n    ArrayBuilder::freeze(ArrayBuilder::new())\\n  }\\n  let lt_w = LambdaTable::{\\n    bodies: fresh_bytes_array(),\\n    param_counts: Array::slice([\\n      0\\n    ], 0, 0),\\n    captures: Array::slice([\\n      Array::slice([\\n        \\\"\\\"\\n      ], 0, 0)\\n    ], 0, 0),\\n    meta_i32: Array::slice([\\n      0\\n    ], 0, 0),\\n    meta_i64: Array::slice([\\n      0\\n    ], 0, 0)\\n  }\\n  let bodies = fresh_bytes_array()\\n  let meta_i32 = Array::slice([\\n    0\\n  ], 0, 0)\\n  let meta_i64 = Array::slice([\\n    0\\n  ], 0, 0)\\n  let user_ref_local_indices_all = Array::slice([\\n    Array::slice([\\n      0\\n    ], 0, 0)\\n  ], 0, 0)\\n  // #415 B-1: one call = one gc builtin body — body bytes, extra local\\n  // counts, the (always empty here) user-ref locals row, and the\\n  // function-section type index together. The function section splices\\n  // gc_builtin_type_idxs in this same order; the count mismatch guard below\\n  // still applies.\\n  let gc_builtin_type_idxs = Array::slice([\\n    0\\n  ], 0, 0)\\n  let push_gc_builtin: (Bytes, Int, Int, Int) -> Unit = (body, m32, m64, type_idx) -> {\\n    Array::push(bodies, body)\\n    Array::push(meta_i32, m32)\\n    Array::push(meta_i64, m64)\\n    Array::push(user_ref_local_indices_all, Array::slice([\\n      0\\n    ], 0, 0))\\n    Array::push(gc_builtin_type_idxs, type_idx)\\n  }\\n  push_gc_builtin(gc_gen_print_i64_body(), 3, 1, 1)\\n  push_gc_builtin(gc_gen_print_str_body(), 2, 0, 1)\\n  push_gc_builtin(gc_gen_str_len_body(), 0, 0, 3)\\n  // #748: strings live in linear memory with the same packed layout in the\\n  // gc lane, so the SIMD chunk-compare generator is shared verbatim\\n  // (chunk_limit local -> meta_i32 6).\\n  push_gc_builtin(gen_str_eq_body(), 6, 0, 4)\\n  push_gc_builtin(gc_gen_str_concat_body(), 6, 0, 4)\\n  push_gc_builtin(gc_gen_arr_new_body(), 1, 0, 5)\\n  push_gc_builtin(gc_gen_arr_len_body(), 0, 0, 3)\\n  push_gc_builtin(gc_gen_arr_get_body(), 1, 0, 4)\\n  push_gc_builtin(gc_gen_arr_push_body(), 6, 0, 6)\\n  push_gc_builtin(gc_gen_arr_set_body(), 1, 0, 7)\\n  push_gc_builtin(gc_gen_double_to_int_body(), 0, 0, 3)\\n  push_gc_builtin(gc_gen_int_to_double_body(), 0, 0, 3)\\n  push_gc_builtin(gc_gen_str_char_code_at_body(), 1, 0, 4)\\n  push_gc_builtin(gc_gen_str_from_char_code_body(), 1, 0, 3)\\n  push_gc_builtin(gc_gen_str_substring_body(), 2, 0, 8)\\n  push_gc_builtin(gc_gen_identity_body(), 0, 0, 3)\\n  // Body 17 (__to_string): runtime string-vs-int dispatch, NOT identity —\\n  // interpolation routes every `\\\\{x}` here (see gc_gen_to_string_body).\\n  push_gc_builtin(gc_gen_to_string_body(), 0, 5, 3)\\n  push_gc_builtin(gen_bytes_new_body(), 1, 0, 5)\\n  push_gc_builtin(gen_bytes_get_body(false), 1, 0, 4)\\n  push_gc_builtin(gen_bytes_set_body(false), 1, 0, 7)\\n  push_gc_builtin(gen_bytes_push_body(false), 6, 0, 6)\\n  push_gc_builtin(gen_bytes_append_body(false, hbo + 7, hbo + 19, hbo + 21), 2, 0, 6)\\n  push_gc_builtin(gen_bytes_concat_body(hbo + 18, hbo + 22), 0, 1, 4)\\n  push_gc_builtin(gen_bytes_slice_body(false, hbo + 18, hbo + 19, hbo + 21), 2, 1, 8)\\n  push_gc_builtin(gen_bytes_from_array_body(false, hbo + 7, hbo + 8, hbo + 18, hbo + 21), 2, 1, 3)\\n  push_gc_builtin(gen_bytes_to_array_body(false, hbo + 6, hbo + 9, hbo + 7, hbo + 19), 2, 1, 3)\\n  push_gc_builtin(gen_bytes_blit_body(false, hbo + 19, hbo + 21), 2, 0, 9)\\n  push_gc_builtin(gen_bytes_fill_body(false, hbo + 21), 2, 0, 7)\\n  // #538: generic eq (i64 fast path + looks-like-string guarded content eq)\\n  // -- Map::get/has_key/MapBuilder::set resolve \\\"eq\\\" from the func table, and\\n  // before this existed the placeholder index called array_new, which returns\\n  // a fresh non-zero pointer: every key comparison was TRUE (silent wrong Map\\n  // results). The gc string repr is the same packed (offset<<32)|len as the\\n  // linear backend, so the linear bodies are reused verbatim below.\\n  push_gc_builtin(gen_eq_body(hbo + 4), 0, 0, 4)\\n  push_gc_builtin(gen_string_index_of_body(false, hbo + 3, hbo + 15, hbo + 4), 8, 0, 4)\\n  push_gc_builtin(gen_string_contains_body(false, hbo + 30), 0, 0, 4)\\n  push_gc_builtin(gen_string_starts_with_body(false, hbo + 3, hbo + 15, hbo + 4), 2, 1, 4)\\n  push_gc_builtin(gen_string_ends_with_body(false, hbo + 3, hbo + 15, hbo + 4), 2, 1, 4)\\n  push_gc_builtin(gen_string_last_index_of_body(false, hbo + 3, hbo + 15, hbo + 4), 3, 1, 4)\\n  push_gc_builtin(gen_string_join_body(false, hbo + 7, hbo + 8, hbo + 5), 9, 1, 4)\\n  push_gc_builtin(gen_string_split_body(false, hbo + 6, hbo + 9, hbo + 3, hbo + 15, hbo + 30), 4, 1, 4)\\n  push_gc_builtin(gen_string_trim_body(false, hbo + 3, hbo + 13, hbo + 15), 4, 0, 3)\\n  push_gc_builtin(gc_gen_arr_slice_body(hbo + 6, hbo + 8, hbo + 9), 0, 2, 8)\\n  push_gc_builtin(gc_gen_arr_concat_body(hbo + 6, hbo + 7, hbo + 8, hbo + 9), 0, 3, 4)\\n  push_gc_builtin(gc_gen_arr_truncate_body(), 0, 0, 6)\\n  push_gc_builtin(gc_gen_arr_push_all_body(hbo + 7, hbo + 8, hbo + 9), 0, 2, 6)\\n  // #746: same packed-string layout as the linear lane, generator shared\\n  // verbatim (untagged ints in the gc lane -> enable_rc=false).\\n  push_gc_builtin(gen_str_lex_diff_body(false), 7, 0, 4)\\n  let mut bi = 0\\n  while bi < num_user_funcs {\\n    let stmt = Array::get(user_func_stmts, bi)\\n    match stmt {\\n      SLet(_, _, _, gc_fn_ann, expr) => match expr {\\n        EFn(_, _, params, _, _, body) => {\\n          let body_buf = bytebuf_new()\\n          let local_names = Array::slice([\\n            \\\"\\\"\\n          ], 0, 0)\\n          let gc_agg_slots_f = Array::slice([\\n            0\\n          ], 0, 0)\\n          let mut ppi = 0\\n          while ppi < Array::length(params) {\\n            let (pname, _) = Array::get(params, ppi)\\n            Array::push(local_names, pname)\\n            ppi = ppi + 1\\n          }\\n          Array::push(local_names, \\\"__env\\\")\\n          let param_count = Array::length(params) + 1\\n          // #724 round 2: seed the aggregate-shape log from annotated params.\\n          // #744 gc mirror: seed float tracking from annotated Float/Double\\n          // params in the same walk (linear tracks these via float_local_slots).\\n          let gc_float_names_f = Array::slice([\\n            \\\"\\\"\\n          ], 0, 0)\\n          let gc_sig_ptypes = fn_type_param_types(gc_fn_ann)\\n          let mut psi = 0\\n          while psi < Array::length(params) {\\n            let pann = match gc_sig_ptypes {\\n              Some(pts) => if Array::length(pts) == Array::length(params) {\\n                Some(Array::get(pts, psi))\\n              } else {\\n                let (_, pa) = Array::get(params, psi)\\n                pa\\n              },\\n              None => {\\n                let (_, pa) = Array::get(params, psi)\\n                pa\\n              }\\n            }\\n            match pann {\\n              Some(pte) => {\\n                let pinfo = agg_info_of_type_expr(CtorTable::{\\n                  names: ctor_names_list, tags: ctor_tags_list, field_counts: ctor_field_counts_list, type_names: ctor_type_names_list, struct_names: struct_names, struct_field_names: struct_field_names, names_sorted: gc_ctor_names_sorted, names_sorted_pos: gc_ctor_names_sorted_pos\\n                }, pte)\\n                if pinfo > 0 {\\n                  Array::push(gc_agg_slots_f, psi * 256 + pinfo)\\n                } else {\\n                  ()\\n                }\\n                match pte {\\n                  TyName(ptn) => if ptn == \\\"Float\\\" || ptn == \\\"Double\\\" {\\n                    let (psname, _) = Array::get(params, psi)\\n                    Array::push(gc_float_names_f, psname)\\n                  } else {\\n                    ()\\n                  },\\n                  _ => ()\\n                }\\n              },\\n              None => ()\\n            }\\n            psi = psi + 1\\n          }\\n          let ref_cell_names_f = Array::slice([\\n            \\\"\\\"\\n          ], 0, 0)\\n          let ref_local_indices_f = Array::slice([\\n            0\\n          ], 0, 0)\\n          let ft = FuncTable::{\\n            names: ft_names,\\n            indices: ft_indices,\\n            params: ft_params,\\n            returns: ft_returns,\\n            needs_env: ft_needs_env\\n          }\\n          let st = StrTable::{\\n            strs: str_strs, offsets: str_offsets, lengths: str_lengths\\n          }\\n          let ct = CtorTable::{\\n            names: ctor_names_list, tags: ctor_tags_list, field_counts: ctor_field_counts_list, type_names: ctor_type_names_list, struct_names: struct_names, struct_field_names: struct_field_names, names_sorted: gc_ctor_names_sorted, names_sorted_pos: gc_ctor_names_sorted_pos\\n          }\\n          let func_ctx = CompileCtxGc::{\\n            func_table: ft, str_table: st, lambda_table: lt_w,\\n            num_user_funcs: num_user_funcs, func_offset: func_offset,\\n            ref_cell_names: ref_cell_names_f, ref_local_indices: ref_local_indices_f,\\n            refcell_type_idx: refcell_type_idx, closure_type_base: closure_type_base,\\n            gc_ctor_table: ct,\\n            gc_const_names: gc_const_names_l, gc_const_kinds: gc_const_kinds_l,\\n            gc_const_ivals: gc_const_ivals_l, gc_const_svals: gc_const_svals_l,\\n            gc_global_names: gc_global_names_l,\\n            gc_float_locals: gc_float_names_f,\\n            gc_agg_local_slots: gc_agg_slots_f,\\n            gc_agg_ret_names: gc_agg_ret_names_l,\\n            gc_agg_ret_infos: gc_agg_ret_infos_l\\n          }\\n          let final_nl = compile_expr_gc(body_buf, body, local_names, param_count, func_ctx, -1)\\n          Array::push(bodies, body_buf)\\n          let extra = if final_nl > param_count {\\n            final_nl - param_count\\n          } else {\\n            0\\n          }\\n          Array::push(meta_i32, 0)\\n          Array::push(meta_i64, extra)\\n          Array::push(user_ref_local_indices_all, ref_local_indices_f)\\n        },\\n        _ => throw(\\\"expected function\\\")\\n      }\\n      ,\\n      _ => throw(\\\"expected let statement\\\")\\n    }\\n    bi = bi + 1\\n  }\\n  let start_body = bytebuf_new()\\n  let entry_func_idx = entry_user_idx + func_offset\\n  let entry_params = Array::get(ft_params, entry_user_idx)\\n  if entry_params != 0 {\\n    throw(\\\"WASI entry function must take 0 parameters\\\")\\n  }\\n  // #538: initialize computed module-level globals (statement order) before\\n  // the entry runs. Compiled with a fresh local frame; lambdas created here\\n  // land in lt_w like any other (num_lambdas is computed AFTER this).\\n  let mut start_extra_locals = 0\\n  if Array::length(gc_global_names_l) > 0 {\\n    let init_ref_cells = Array::slice([\\n      \\\"\\\"\\n    ], 0, 0)\\n    let init_ref_idx = Array::slice([\\n      0\\n    ], 0, 0)\\n    let init_ctx = CompileCtxGc::{\\n      func_table: FuncTable::{\\n        names: ft_names, indices: ft_indices, params: ft_params,\\n        returns: ft_returns, needs_env: ft_needs_env\\n      },\\n      str_table: StrTable::{\\n        strs: str_strs, offsets: str_offsets, lengths: str_lengths\\n      },\\n      lambda_table: lt_w,\\n      num_user_funcs: num_user_funcs, func_offset: func_offset,\\n      ref_cell_names: init_ref_cells, ref_local_indices: init_ref_idx,\\n      refcell_type_idx: refcell_type_idx, closure_type_base: closure_type_base,\\n      gc_ctor_table: CtorTable::{\\n        names: ctor_names_list, tags: ctor_tags_list,