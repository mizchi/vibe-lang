generic call path we are NOT going through), so the raw byte value\\n      // is correct on BOTH lanes. Import gating in linked_compile.vibe\\n      // includes println/print for exactly this path.\\n      let (ws_idx, _, _) = resolve_func(ctx.func_table, \\\"Stdout::write_stream\\\")\\n      let nl = ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)\\n      emit_call(buf, ws_idx)\\n      if fname == \\\"println\\\" {\\n        let (wc_idx, _, _) = resolve_func(ctx.func_table, \\\"Stdout::write_char\\\")\\n        emit_i64_const(buf, 10)\\n        emit_call(buf, wc_idx)\\n      } else {\\n        ()\\n      }\\n      emit_i64_const(buf, 0)\\n      nl\\n    }\\n    else if fname == \\\"__rec_field\\\" {\\n      let nl = ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)\\n      let idx_expr = Array::get(args, 1)\\n      let field_idx = get_eint_value(idx_expr)\\n      emit_i64_const(buf, -2)\\n      emit_i64_and(buf)\\n      emit_i32_wrap_i64(buf)\\n      emit_i64_load(buf, 3, 8 + field_idx * 8)\\n      nl\\n    }\\n    else if fname == \\\"__len\\\" {\\n      let (sl_idx, _, _) = resolve_func(ctx.func_table, \\\"String::length\\\")\\n      let (bl_idx, _, _) = resolve_func(ctx.func_table, \\\"Bytes::length\\\")\\n      let (al_idx, _, _) = resolve_func(ctx.func_table, \\\"Array::length\\\")\\n      let obj_local = next_local\\n      let ptr_local = next_local + 1\\n      let cap_local = next_local + 2\\n      Array::push(local_names, \\\"__len_obj\\\")\\n      Array::push(local_names, \\\"__len_ptr\\\")\\n      Array::push(local_names, \\\"__len_cap\\\")\\n      let mut nl = next_local + 3\\n      nl = ce(buf, Array::get(args, 0), local_names, nl, ctx, ld)\\n      emit_local_set(buf, obj_local)\\n      emit_local_get(buf, obj_local)\\n      emit_i64_const(buf, 32)\\n      emit_i64_shr_s(buf)\\n      emit_i64_eqz(buf)\\n      emit_if_i64(buf)\\n      emit_local_get(buf, obj_local)\\n      emit_local_set(buf, ptr_local)\\n      emit_local_get(