"\nimport @vibe/compiler/core {\n  Type\n}\n\nimport @vibe/core {\n  array_empty\n}\n\n\nfn bytes_no_params() -> Array[Type] {\n  array_empty()\n}\n\nfn bytes_one_param(a: Type) -> Array[Type] {\n  let arr = bytes_no_params()\n  Array::push(arr, a)\n  arr\n}\n\nfn bytes_two_params(a: Type, b: Type) -> Array[Type] {\n  let arr = bytes_no_params()\n  Array::push(arr, a)\n  Array::push(arr, b)\n  arr\n}\n\nfn bytes_four_params(a: Type, b: Type, c: Type, d: Type) -> Array[Type] {\n  let arr = bytes_no_params()\n  Array::push(arr, a)\n  Array::push(arr, b)\n  Array::push(arr, c)\n  Array::push(arr, d)\n  arr\n}\n\nfn bytes_three_params(a: Type, b: Type, c: Type) -> Array[Type] {\n  let arr = bytes_no_params()\n  Array::push(arr, a)\n  Array::push(arr, b)\n  Array::push(arr, c)\n  arr\n}\n\nfn lookup_bytes_get(name: String) -> Option[Type] {\n  if name == \"Bytes::get\" {\n    Some(CtFn(bytes_two_params(CtBytes, CtInt), CtInt, None))\n  }\n  else None\n}\n\nfn lookup_bytes_new(name: String) -> Option[Type] {\n  if name == \"Bytes::new\" {\n    Some(CtFn(bytes_no_params(), CtBytes, None))\n  }\n  else None\n}\n\nfn lookup_bytes_set(name: String) -> Option[Type] {\n  if name == \"Bytes::set\" {\n    Some(CtFn(bytes_three_params(CtBytes, CtInt, CtInt), CtUnit, None))\n  }\n  else None\n}\n\nfn lookup_bytes_blit(name: String) -> Option[Type] {\n  if name == \"Bytes::blit\" {\n    Some(CtFn(bytes_four_params(CtBytes, CtBytes, CtInt, CtInt), CtUnit, None))\n  }\n  else None\n}\n\nfn lookup_bytes_fill(name: String) -> Option[Type] {\n  if name == \"Bytes::fill\" {\n    Some(CtFn(bytes_three_params(CtBytes, CtInt, CtInt), CtUnit, None))\n  }\n  else None\n}\n\nfn lookup_bytes_push(name: String) -> Option[Type] {\n  if name == \"Bytes::push\" {\n    Some(CtFn(bytes_two_params(CtBytes, CtInt), CtUnit, None))\n  }\n  else None\n}\n\nfn lookup_bytes_slice(name: String) -> Option[Type] {\n  if name == \"Bytes::slice\" {\n    Some(CtFn(bytes_three_params(CtBytes, CtInt, CtInt), CtBytes, None))\n  }\n  else None\n}\n\nfn lookup_bytes_append(name: String) -> Option[Type] {\n  if name == \"Bytes::append\" {\n    Some(CtFn(bytes_two_params(CtBytes, CtBytes), CtUnit, None))\n  }\n  else None\n}\n\nfn lookup_bytes_concat(name: String) -> Option[Type] {\n  if name == \"Bytes::concat\" {\n    Some(CtFn(bytes_two_params(CtBytes, CtBytes), CtBytes, None))\n  }\n  else None\n}\n\nfn lookup_bytes_length(name: String) -> Option[Type] {\n  if name == \"Bytes::length\" {\n    Some(CtFn(bytes_one_param(CtBytes), CtInt, None))\n  }\n  else None\n}\n\nfn lookup_bytes_group_a(name: String) -> Option[Type] {\n  match lookup_bytes_new(name) {\n    Some(t) => Some(t),\n    None => match lookup_bytes_length(name) {\n      Some(t) => Some(t),\n      None => match lookup_bytes_get(name) {\n        Some(t) => Some(t),\n        None => lookup_bytes_set(name)\n      }\n    }\n  }\n}\n\nfn lookup_bytes_group_b(name: String) -> Option[Type] {\n  match lookup_bytes_push(name) {\n    Some(t) => Some(t),\n    None => match lookup_bytes_concat(name) {\n      Some(t) => Some(t),\n      None => match lookup_bytes_slice(name) {\n        Some(t) => Some(t),\n        None => lookup_bytes_append(name)\n      }\n    }\n  }\n}\n\nfn lookup_bytes_to_array(name: String) -> Option[Type] {\n  if name == \"Bytes::to_array\" {\n    Some(CtFn(bytes_one_param(CtBytes), CtArray(CtInt), None))\n  }\n  else None\n}\n\nfn lookup_bytes_from_array(name: String) -> Option[Type] {\n  if name == \"Bytes::from_array\" {\n    Some(CtFn(bytes_one_param(CtArray(CtInt)), CtBytes, None))\n  }\n  else None\n}\n\nfn lookup_bytes_group_c(name: String) -> Option[Type] {\n  match lookup_bytes_blit(name) {\n    Some(t) => Some(t),\n    None => match lookup_bytes_fill(name) {\n      Some(t) => Some(t),\n      None => match lookup_bytes_from_array(name) {\n        Some(t) => Some(t),\n        None => lookup_bytes_to_array(name)\n      }\n    }\n  }\n}\n\nfn lookup_simd_skip_ws(name: String) -> Option[Type] {\n  if name == \"simd_skip_ws\" {\n    Some(CtFn(bytes_three_params(CtBytes, CtInt, CtInt), CtInt, None))\n  }\n  else None\n}\n\nfn lookup_simd_scan_alnum(name: String) -> Option[Type] {\n  if name == \"simd_scan_alnum\" {\n    Some(CtFn(bytes_three_params(CtBytes, CtInt, CtInt), CtInt, None))\n  }\n  else None\n}\n\nfn lookup_simd_scan_alnum_str(name: String) -> Option[Type] {\n  if name == \"simd_scan_alnum_str\" {\n    Some(CtFn(bytes_three_params(CtString, CtInt, CtInt), CtInt, None))\n  }\n  else None\n}\n\nexport fn lookup_bytes(name: String) -> Option[Type] {\n  match lookup_bytes_group_a(name) {\n    Some(t) => Some(t),\n    None => match lookup_bytes_group_b(name) {\n      Some(t) => Some(t),\n      None => match lookup_bytes_group_c(name) {\n        Some(t) => Some(t),\n        None => match lookup_simd_skip_ws(name) {\n          Some(t) => Some(t),\n          None => match lookup_simd_scan_alnum(name) {\n            Some(t) => Some(t),\n            None => lookup_simd_scan_alnum_str(name)\n          }\n        }\n      }\n    }\n  }\n}\n")
}

let source_46 = () -> (String, String) {
  ("lib/@vibe/compiler/checker/builtins_simd.vibe",
"\nimport @vibe/compiler/core {\n  Type\n}\n\nimport @vibe/core {\n  array_empty\n}\n\n\n\nfn simd_no_params() -> Array[Type] {\n  array_empty()\n}\n\nfn simd_v128_ty() -> Type {\n  CtNamed(\"V128\", simd_no_params())\n}\n\nfn simd_one_param(a: Type) -> Array[Type] {\n  let arr = simd_no_params()\n  Array::push(arr, a)\n  arr\n}\n\nfn simd_two_params(a: Type, b: Type) -> Array[Type] {\n  let arr = simd_no_params()\n  Array::push(arr, a)\n  Array::push(arr, b)\n  arr\n}\n\nfn simd_three_params(a: Type, b: Type, c: Type) -> Array[Type] {\n  let arr = simd_no_params()\n  Array::push(arr, a)\n  Array::push(arr, b)\n  Array::push(arr, c)\n  arr\n}\n\nfn lookup_simd_mem(name: String) -> Option[Type] {\n  if name == \"v128_load\" {\n    Some(CtFn(simd_two_params(CtBytes, CtInt), simd_v128_ty(), None))\n  } else if name == \"v128_store\" {\n    Some(CtFn(simd_three_params(CtBytes, CtInt, simd_v128_ty()), CtUnit, None))\n  } else if name == \"simd_skip_ws\" {\n    Some(CtFn(simd_three_params(CtBytes, CtInt, CtInt), CtInt, None))\n  } else {\n    None\n  }\n}\n\nfn lookup_simd_lane_a(name: String) -> Option[Type] {\n  if name == \"v128_splat_i8x16\" {\n    Some(CtFn(simd_one_param(CtInt), simd_v128_ty(), None))\n  } else if name == \"v128_eq_i8x16\" {\n    Some(CtFn(simd_two_params(simd_v128_ty(), simd_v128_ty()), simd_v128_ty(), None))\n  } else if name == \"v128_le_u_i8x16\" {\n    Some(CtFn(simd_two_params(simd_v128_ty(), simd_v128_ty()), simd_v128_ty(), None))\n  } else if name == \"v128_ge_u_i8x16\" {\n    Some(CtFn(simd_two_params(simd_v128_ty(), simd_v128_ty()), simd_v128_ty(), None))\n  } else {\n    None\n  }\n}\n\nfn lookup_simd_lane_b(name: String) -> Option[Type] {\n  if name == \"v128_and\" {\n    Some(CtFn(simd_two_params(simd_v128_ty(), simd_v128_ty()), simd_v128_ty(), None))\n  } else if name == \"v128_or\" {\n    Some(CtFn(simd_two_params(simd_v128_ty(), simd_v128_ty()), simd_v128_ty(), None))\n  } else if name == \"v128_not\" {\n    Some(CtFn(simd_one_param(simd_v128_ty()), simd_v128_ty(), None))\n  } else {\n    None\n  }\n}\n\nfn lookup_simd_reduce(name: String) -> Option[Type] {\n  if name == \"v128_bitmask_i8x16\" {\n    Some(CtFn(simd_one_param(simd_v128_ty()), CtInt, None))\n  } else if name == \"v128_any_true\" {\n    Some(CtFn(simd_one_param(simd_v128_ty()), CtBool, None))\n  } else if name == \"v128_all_true_i8x16\" {\n    Some(CtFn(simd_one_param(simd_v128_ty()), CtBool, None))\n  } else {\n    None\n  }\n}\n\nexport fn lookup_simd(name: String) -> Option[Type] {\n  match lookup_simd_mem(name) {\n    Some(t) => Some(t),\n    None => match lookup_simd_lane_a(name) {\n      Some(t) => Some(t),\n      None => match lookup_simd_lane_b(name) {\n        Some(t) => Some(t),\n        None => lookup_simd_reduce(name)\n      }\n    }\n  }\n}\n")
}

