//# Compiler source bundle

// All compiler source files bundled as (path, source) pairs.
// Used by selfbuild_compile_stage2 to avoid filesystem access.
let empty_grouped_sources = () -> Array[(String, Array[(String, String)])] {
  Array::slice([("", Array::slice([("", "")], 0, 0))], 0, 0)
}

let push_grouped_source_pair = (groups: Array[(String, Array[(String, String)])], group_name: String, pair: (String, String)) -> Unit {
  let (path, source) = pair
  let mut i = 0
  let mut found = false
  while i < Array::length(groups) {
    let (name, sources) = Array::get(groups, i)
    if String::equals(name, group_name) {
      Array::push(sources, (path, source))
      found = true
      i = Array::length(groups)
    } else {
      i = i + 1
    }
  }
  if !found {
    let sources = Array::slice([("", "")], 0, 0)
    Array::push(sources, (path, source))
    Array::push(groups, (group_name, sources))
  }
}

let source_0 = () -> (String, String) {
  ("lib/@vibe/ast/index.vpkg",
"version 0.1.0\n\n// @vibe/ast — the vibe surface-syntax AST (ADR-0065 Phase 3, #753).\n// The top level of this contract IS the package: the AST enums are\n// TRANSPARENT type definitions (checker/codegen/printer pattern-match and\n// construct them, so the definition itself is the public contract — changing\n// a variant is a breaking change by construction). The implementation stub\n// exists only so the explicit impl import suppresses sibling auto-discovery\n// (tests beside this file must not join the facade).\n//\n// Node shapes deliberately expose the compiler's internal representation\n// (e.g. the Int byte-offset slot on EIdent/ECall/EDot): this package is the\n// compiler's own working AST, not an abstraction over it. Consumers that\n// need stability should pin (#751).\n\nexport enum Pat {\n  PWild;\n  PBind(String);\n  PInt(Int);\n  PFloat(Double);\n  PString(String);\n  PBool(Bool);\n  PCtor(String, Array[Pat]);\n  PTuple(Array[Pat]);\n  POr(Pat, Pat);\n  PStruct(String, Array[(String, Pat)])\n}\n\nexport enum TypeExpr {\n  TyName(String);\n  TyApp(String, Array[TypeExpr]);\n  TyFn(Array[TypeExpr], TypeExpr, Option[String]);\n  TyTuple(Array[TypeExpr]);\n  TyUnit\n}\n\nexport enum Expr {\n  EInt(Int);\n  EFloat(Double);\n  EString(String);\n  EBool(Bool);\n  EIdent(String, Int);\n  ETuple(Array[Expr]);\n  EArray(Array[Expr]);\n  // #886: the third slot carries EXPLICIT struct type arguments\n  // (`Pair[Int]::{ .. }`); empty for the inferred form (`Pair::{ .. }`,\n  // #829's field-driven instantiation) and for anonymous `record { .. }`.\n  ERecord(String, Array[(String, Expr)], Array[TypeExpr]);\n  EIf(Expr, Expr, Expr);\n  ELet(String, Expr, Expr, Int);\n  ELetRec(String, Expr, Expr);\n  ELetMut(String, Expr, Expr, Int);\n  EAssign(String, Expr, Expr);\n  EAssignOp(String, String, Expr, Expr);\n  ESeq(Expr, Expr);\n  EMatch(Expr, Array[(Pat, Expr)]);\n  EHandle(Expr, Array[(Pat, Expr)]);\n  EWhile(Expr, Expr);\n  ELoop(Array[(String, Expr)], Expr);\n  EForIn(String, Option[String], Expr, Expr);\n  ECall(Expr, Array[Expr], Int);\n  EBinOp(String, Expr, Expr);\n  EUnaryOp(String, Expr);\n  EFn(Array[String], Array[(String, Array[String])], Array[(String, Option[TypeExpr])], Option[TypeExpr], Option[String], Expr);\n  EDot(Expr, String, Int, Int);\n  ELabeledArg(String, String, Expr);\n  EReturn(Expr);\n  EBreak(Option[Expr]);\n  EContinue(Array[Expr]);\n  EMap(Array[(String, Expr)]);\n  ESpread(Expr);\n  EStringInterp(Array[String]);\n  EUnit\n}\n\nexport enum Stmt {\n  SLet(Bool, Bool, String, Option[TypeExpr], Expr);\n  SLetMut(String, Option[TypeExpr], Expr);\n  SEnum(Bool, String, Array[String], Array[(String, Array[TypeExpr])], Array[String]);\n  SSuberror(Bool, String, Array[(String, Array[TypeExpr])]);\n  // #829: (exported, name, fields, derives, mut field names, type params).\n  // Type params are APPENDED so positional matches of the older 5-field form\n  // stay aligned.\n  SStruct(Bool, String, Array[(String, TypeExpr)], Array[String], Array[String], Array[String]);\n  STypeAlias(Bool, String, Array[String], TypeExpr);\n  STrait(Bool, String, Array[String], Array[(String, Array[TypeExpr], TypeExpr)], Array[(String, Array[String], Array[(String, Array[String])])]);\n  SImpl(Array[String], Array[(String, Array[String])], String, String);\n  SExternLet(String, TypeExpr);\n  SImport(String, Array[(String, Option[String])]);\n  STest(String, Expr);\n  SBench(String, Expr);\n  SExpr(Expr);\n  SExport(Array[String]);\n  SReExport(String, Array[(String, Option[String])]);\n  SAliasDecl(String, String);\n  SLetPat(Pat, Expr);\n  SModule(Bool, String, Array[Stmt]);\n  SEffectDef(Bool, String, Array[String], Array[(String, Array[TypeExpr], TypeExpr)]);\n  // ADR-0071 (#755, docs/effectset.md) step 2: `effectset Name = { A, B,\n  // Effect::op }` -- a named, reusable set of effect-row items (effect\n  // names, qualified operations, or other effectset names). Fields:\n  // (exported, name -- possibly qualified as `Effect::Name`, member items\n  // -- each the exact same row-item text collect_effect_names produces,\n  // i.e. a bare identifier or an `Effect::op` qualified string). No type\n  // params yet (generic effectsets like `State::Read[T]` are deferred).\n  // Parser + printer only as of this revision -- resolution (expanding\n  // members recursively, cycle/collision detection) is a separate,\n  // not-yet-implemented step; see checker_stmt.vibe's explicit rejection.\n  SEffectSet(Bool, String, Array[String]);\n  // ADR-0064 (#727/#731): a `fn` declaration kept in declaration form —\n  // (exported, name, EFn value, requires conditions, ensures conditions).\n  // The parser's default program entry points lower this to the legacy\n  // `SLet(exported, true, name, None, EFn(..))` shape (contracts desugared\n  // to runtime asserts) via lower_fn_decl_stmt BEFORE checker/codegen, so\n  // only the printer / normalize (which parse with the *_preserving entry\n  // points) ever see this constructor.\n  SFnDecl(Bool, String, Expr, Array[Expr], Array[Expr])\n}\n")
}

