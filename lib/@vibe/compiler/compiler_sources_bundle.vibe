emit_i64_eq, emit_i64_eqz, emit_i64_extend_i32_s, emit_i64_ge_s, emit_i64_gt_s, emit_i64_le_s, emit_i64_lt_s, emit_i64_mul, emit_i64_ne, emit_i64_or, emit_i64_reinterpret_f64, emit_i64_rem_s, emit_i64_shl, emit_i64_shr_s, emit_i64_sub, emit_i64_trunc_f64_s, emit_i64_xor, emit_if_i64, emit_if_void, emit_import_section_func, emit_local_get, emit_local_set, emit_local_tee, emit_loop_void, emit_memory_section, emit_name, emit_return, emit_table_section_funcref, emit_type_section, emit_type_section_multi, string_to_data\\n}\\n\\n//# Functions\\n\\n\\nexport fn compile_lambda(buf: Bytes, params: Array[(String, Option[TypeExpr])], fn_body: Expr, local_names: Array[String], next_local: Int, ctx: CompileCtx, ld: Int, compile_fn: (Bytes, Expr, Array[String], Int, CompileCtx, Int) -> Int with { Error }) -> Int with { Error } {\\n  let param_names_arr = Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n  let mut pi = 0\\n  while pi < Array::length(params) {\\n    let (pname, _) = Array::get(params, pi)\\n    Array::push(param_names_arr, pname)\\n    pi = pi + 1\\n  }\\n  // #875 fix 2: consume the \\\"currently-compiling let-rec closure's own name\\\"\\n  // hint (set by compile_expr_tail.vibe's ELetRec handler immediately before\\n  // it calls compile_expr on this exact EFn value -- see\\n  // CompileCtx.pending_letrec_self_name's doc comment). Read + clear it right\\n  // away (before computing captures, and well before any recursive call that\\n  // could set it again for a nested let-rec) so it never leaks past this one\\n  // lambda. Any EFn that is NOT a let-rec's own value (anonymous lambda,\\n  // non-rec `let`) finds this empty and behaves exactly as before.\\n  let self_name = if Array::length(ctx.pending_letrec_self_name) > 0 {\\n    let sn = Array::get(ctx.pending_letrec_self_name, 0)\\n    Array::truncate(ctx.pending_letrec_self_name, 0)\\n    sn\\n  } else {\\n    \\\"\\\"\\n  }\\n  let captures = collect_free_vars_indexed_self(fn_body, param_names_arr, ctx.capture_name_index, self_name)\\n  let num_captures = Array::length(captures)\\n  let user_params = Array::length(params)\\n  let lam_buf = bytebuf_new()\\n  let lam_locals = Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n  let mut lpi = 0\\n  while lpi < user_params {\\n    let (lpname_raw, _) = Array::get(params, lpi)\\n    let lpnlen = String::length(lpname_raw)\\n    let lpname = if lpnlen > 0 {\\n      let lpc = String::char_code_at(lpname_raw, lpnlen - 1)\\n      if lpc == '~' {\\n        lpname_raw[0: lpnlen - 1]\\n      } else if lpc == '?' {\\n        lpname_raw[0: lpnlen - 1]\\n      } else {\\n        lpname_raw\\n      }\\n    } else lpname_raw\\n    Array::push(lam_locals, lpname)\\n    lpi = lpi + 1\\n  }\\n  Array::push(lam_locals, \\\"__env\\\")\\n  let env_param_idx = user_params\\n  let lam_nl_start = user_params + 1\\n  let lam_ref_cells = Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n  let mut ci3 = 0\\n  let mut lam_nl = lam_nl_start\\n  while ci3 < num_captures {\\n    let cap_local = lam_nl\\n    let cap_name = Array::get(captures, ci3)\\n    emit_local_get(lam_buf, env_param_idx)\\n    emit_i32_wrap_i64(lam_buf)\\n    emit_i64_load(lam_buf, 3, 8 + ci3 * 8)\\n    // #699: a captured RC ref cell is stored odd-tagged in the env (so the\\n    // closure's class-7 drop classifies and frees it). The inner body uses the\\n    // cell as an even vptr (load/store at +0), so untag on load back.\\n    if ctx.enable_rc && array_contains_str(ctx.ref_cell_names, cap_name) {\\n      emit_i64_const(lam_buf, -2)\\n      emit_i64_and(lam_buf)\\n    }\\n    emit_local_set(lam_buf, cap_local)\\n    Array::push(lam_locals, cap_name)\\n    if array_contains_str(ctx.ref_cell_names, cap_name) {\\n      Array::push(lam_ref_cells, cap_name)\\n    } else {\\n      ()\\n    }\\n    // #705: a captured non-refcell heap var is a BORROWED view of the defining\\n    // scope's binding — the env store (below) does NOT bump its rc, and the\\n    // body's perceus plan never tracks a free var, so any owning consume inside\\n    // the closure decrements a refcount the closure does not own. Left unbalanced\\n    // that frees the defining scope's value early (double free / heap cycle when\\n    // a recursive closure consumes a captured list each iteration — e.g. a set\\n    // op's `contains(b, head)` over a borrowed `b`). Dup the capture once per\\n    // owning consume here in the prologue: it runs per invocation, so a recursive\\n    // closure consuming the capture each call stays balanced (defining scope\\n    // still drops it exactly once). Ref-cell captures (#699) own their cell via\\n    // the env store and are reclaimed by the closure's class-7 drop; skip them.\\n    if ctx.enable_rc && !array_contains_str(ctx.ref_cell_names, cap_name) {\\n      let cap_consumes = md_consume_count(fn_body, cap_name)\\n      let mut cdup = 0\\n      while cdup < cap_consumes {\\n        emit_rc_dup_guarded(lam_buf, cap_local, ctx.rc_shadow)\\n        cdup = cdup + 1\\n      }\\n    } else {\\n      ()\\n    }\\n    lam_nl = lam_nl + 1\\n    ci3 = ci3 + 1\\n  }\\n  let norm_params = Array::slice(params, 0, 0)\\n  let mut npi = 0\\n  while npi < Array::length(params) {\\n    let (rawn, pty) = Array::get(params, npi)\\n    let rnlen = String::length(rawn)\\n    let sn = if rnlen > 0 {\\n      let lc = String::char_code_at(rawn, rnlen - 1)\\n      if lc == '~' || lc == '?' {\\n        rawn[0: rnlen - 1]\\n      } else {\\n        rawn\\n      }\\n    } else {\\n      rawn\\n    }\\n    Array::push(norm_params, (sn, pty))\\n    npi = npi + 1\\n  }\\n  let lam_drops = Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n  let lam_alias_dups = Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n  let lam_dups = Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n  let lam_heap_params = Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n  if ctx.enable_rc {\\n    let lam_plan = build_perceus_plan_with_params(norm_params, fn_body, ctx.borrow_ret_names)\\n    let mut ldi = 0\\n    while ldi < Array::length(lam_plan) {\\n      let lpa = Array::get(lam_plan, ldi)\\n      if pa_is_drop(lpa) {\\n        Array::push(lam_drops, lpa.name)\\n      } else if pa_is_alias_dup(lpa) {\\n        Array::push(lam_alias_dups, lpa.name)\\n      } else if pa_is_dup(lpa) {\\n        Array::push(lam_dups, lpa.name)\\n      } else {\\n        ()\\n      }\\n      ldi = ldi + 1\\n    }\\n    let mut hpi = 0\\n    while hpi < Array::length(norm_params) {\\n      let (hpn, hpt) = Array::get(norm_params, hpi)\\n      if param_is_heap_in_body(hpn, hpt, fn_body) {\\n        Array::push(lam_heap_params, hpn)\\n      } else {\\n        ()\\n      }\\n      hpi = hpi + 1\\n    }\\n  }\\n  // #744: annotated Float/Double LAMBDA params seed float_local_slots exactly\\n  // like top-level fn params do (linked_compile's psi loop) — without this a\\n  // local `(v: Double, by: Double) -> Double { v * by }` compiled `v * by` as\\n  // an INTEGER multiply of the f64 bits (and under RC compared/box-leaked\\n  // pointers), so closure float math was silently garbage.\\n  let lam_float_slots = Array::slice([\\n    0\\n  ], 0, 0)\\n  let mut lfs_i = 0\\n  while lfs_i < user_params {\\n    let (_, lfs_ann) = Array::get(norm_params, lfs_i)\\n    match lfs_ann {\\n      Some(lfs_ty) => match lfs_ty {\\n        TyName(lfs_tn) => if lfs_tn == \\\"Float\\\" || lfs_tn == \\\"Double\\\" {\\n          Array::push(lam_float_slots, lfs_i * 2 + 1)\\n        } else {\\n          ()\\n        },\\n        _ => ()\\n      },\\n      None => ()\\n    }\\n    lfs_i = lfs_i + 1\\n  }\\n  let lam_ctx = CompileCtx::{\\n    func_table: ctx.func_table, str_table: ctx.str_table,\\n    lambda_table: ctx.lambda_table,\\n    num_user_funcs: ctx.num_user_funcs, func_offset: ctx.func_offset,\\n    ref_cell_names: lam_ref_cells, ctor_table: ctx.ctor_table,\\n    thunk_names: ctx.thunk_names,\\n    const_int_names: ctx.const_int_names,\\n    const_int_values: ctx.const_int_values,\\n    enable_rc: ctx.enable_rc,\\n    rc_shadow: ctx.rc_shadow,\\n    rc_drop_names: lam_drops,\\n    rc_alias_dup_names: lam_alias_dups,\\n    heap_binding_names: lam_heap_params,\\n    rc_drop_func_idx: ctx.rc_drop_func_idx,\\n    rc_alloc_func_idx: ctx.rc_alloc_func_idx,\\n    heap_grow_check_func_idx: ctx.heap_grow_check_func_idx,\\n    rc_dup_names: lam_dups,\\n    capture_name_index: ctx.capture_name_index,\\n    float_local_slots: lam_float_slots,\\n    int_local_slots: Array::slice([\\n      0\\n    ], 0, 0),\\n    agg_local_slots: Array::slice([\\n      0\\n    ], 0, 0),\\n    agg_local_exprs: Array::slice([\\n      EInt(0)\\n    ], 0, 0),\\n    agg_ret_names: ctx.agg_ret_names,\\n    agg_ret_infos: ctx.agg_ret_infos,\\n    heap_ret_names: ctx.heap_ret_names,\\n    effect_names: ctx.effect_names,\\n    effect_op_keys: ctx.effect_op_keys,\\n    effect_op_arities: ctx.effect_op_arities,\\n    cov: ctx.cov,\\n    dbg_line_idx: ctx.dbg_line_idx,\\n    dbg_line_nl: ctx.dbg_line_nl,\\n    dbg_line_file_id: ctx.dbg_line_file_id,\\n    loop_borrowed_names: Array::slice([\\n      \\\"\\\"\\n    ], 0, 0),\\n    loop_consumed_names: Array::slice([\\n      \\\"\\\"\\n    ], 0, 0),\\n    borrow_ret_names: ctx.borrow_ret_names,\\n    scalar_ret_names: ctx.scalar_ret_names,\\n    // #875 fix 2: a nested `let rec` inside THIS lambda's own body must not\\n    // see a stale hint left over from compiling this lambda's own value (that\\n    // hint was already read+cleared on `ctx`, above, before we got here --\\n    // this is an independent, freshly-derived ctx for the body, so start it\\n    // empty too rather than aliasing ctx's now-cleared array).\\n    pending_letrec_self_name: Array::slice([\\n      \\\"\\\"\\n    ], 0, 0)\\n  }\\n  if ctx.enable_rc {\\n    let mut dpi = 0\\n    while dpi < Array::length(norm_params) {\\n      let (dpn, dpt) = Array::get(norm_params, dpi)\\n      if param_is_heap_in_body(dpn, dpt, fn_body) {\\n        let mut dcount = 0\\n        let mut dqi = 0\\n        while dqi < Array::length(lam_dups) {\\n          if Array::get(lam_dups, dqi) == dpn {\\n            dcount = dcount + 1\\n          } else {\\n            ()\\n          }\\n          dqi = dqi + 1\\n        }\\n        let mut de = 0\\n        while de < dcount {\\n          emit_rc_dup_guarded(lam_buf, dpi, ctx.rc_shadow)\\n          de = de + 1\\n        }\\n      } else {\\n        ()\\n      }\\n      dpi = dpi + 1\\n    }\\n  } else {\\n    ()\\n  }\\n  let final_lam_nl = compile_fn(lam_buf, fn_body, lam_locals, lam_nl, lam_ctx, -1)\\n  let mut tail_lam_nl = final_lam_nl\\n  if ctx.enable_rc && ctx.rc_drop_func_idx >= 0 {\\n    let tail_root = scope_tail_proj_root(fn_body)\\n    let mut need_dup = false\\n    let mut ti = 0\\n    while ti < Array::length(norm_params) {\\n      let (tpn, tpt) = Array::get(norm_params, ti)\\n      if param_is_heap_in_body(tpn, tpt, fn_body) && array_contains_str(lam_drops, tpn) && tpn == tail_root {\\n        need_dup = true\\n      } else {\\n        ()\\n      }\\n      ti = ti + 1\\n    }\\n    let rtemp = final_lam_nl\\n    if need_dup {\\n      emit_local_set(lam_buf, rtemp)\\n      emit_rc_dup_guarded(lam_buf, rtemp, ctx.rc_shadow)\\n      tail_lam_nl = final_lam_nl + 1\\n    } else {\\n      ()\\n    }\\n    let mut tj = 0\\n    while tj < Array::length(norm_params) {\\n      let (dpn2, dpt2) = Array::get(norm_params, tj)\\n      if param_is_heap_in_body(dpn2, dpt2, fn_body) && array_contains_str(lam_drops, dpn2) {\\n        emit_local_get(lam_buf, tj)\\n        emit_call(lam_buf, ctx.rc_drop_func_idx)\\n      } else {\\n        ()\\n      }\\n      tj = tj + 1\\n    }\\n    if need_dup {\\n      emit_local_get(lam_buf, rtemp)\\n    } else {\\n      ()\\n    }\\n  } else {\\n    ()\\n  }\\n  let lambda_idx = Array::length(ctx.lambda_table.bodies)\\n  Array::push(ctx.lambda_table.bodies, lam_buf)\\n  Array::push(ctx.lambda_table.param_counts, user_params + 1)\\n  Array::push(ctx.lambda_table.captures, captures)\\n  let mut extra_lam = 0\\n  let min_lam_nl = user_params + 1\\n  if tail_lam_nl > min_lam_nl {\\n    extra_lam = tail_lam_nl - min_lam_nl\\n  }\\n  Array::push(ctx.lambda_table.meta_i32, 0)\\n  Array::push(ctx.lambda_table.meta_i64, extra_lam)\\n  let table_slot = ctx.num_user_funcs + lambda_idx\\n  if num_captures == 0 {\\n    emit_i64_const(buf, (table_slot<<2)|2)\\n    next_local\\n  } else {\\n    let ptr_local = next_local\\n    let nl2 = next_local + 1\\n    Array::push(local_names, \\\"__closure_ptr\\\")\\n    let cap_off = if ctx.enable_rc {\\n      16\\n    } else {\\n      8\\n    }\\n    if ctx.enable_rc {\\n      let total = 16 + num_captures * 8\\n      emit_i64_const(buf, total)\\n      emit_call(buf, ctx.rc_alloc_func_idx)\\n      emit_local_set(buf, ptr_local)\\n      emit_local_get(buf, ptr_local)\\n      emit_i32_wrap_i64(buf)\\n      emit_i32_const(buf, total)\\n      emit_i32_store(buf, 2, 0)\\n      emit_local_get(buf, ptr_local)\\n      emit_i32_wrap_i64(buf)\\n      emit_i32_const(buf, 1)\\n      emit_i32_store(buf, 2, 4)\\n      emit_local_get(buf, ptr_local)\\n      emit_i32_wrap_i64(buf)\\n      emit_i32_const(buf, 7)\\n      emit_i32_store8(buf, 0, 7)\\n      emit_local_get(buf, ptr_local)\\n      emit_i32_wrap_i64(buf)\\n      emit_i32_const(buf, table_slot)\\n      emit_i32_store(buf, 2, 8)\\n      emit_local_get(buf, ptr_local)\\n      emit_i32_wrap_i64(buf)\\n      emit_i32_const(buf, num_captures)\\n      emit_i32_store(buf, 2, 12)\\n    } else {\\n      emit_global_get(buf, 0)\\n      emit_i64_extend_i32_u(buf)\\n      emit_local_tee(buf, ptr_local)\\n      emit_i32_wrap_i64(buf)\\n      emit_i32_const(buf, 8 + num_captures * 8)\\n      emit_i32_add(buf)\\n      emit_global_set(buf, 0)\\n      emit_heap_grow_after_heap_set(buf, ctx)\\n      emit_local_get(buf, ptr_local)\\n      emit_i32_wrap_i64(buf)\\n      emit_i32_const(buf, table_slot)\\n      emit_i32_store(buf, 2, 0)\\n      emit_local_get(buf, ptr_local)\\n      emit_i32_wrap_i64(buf)\\n      emit_i32_const(buf, num_captures)\\n      emit_i32_store(buf, 2, 4)\\n    }\\n    let mut csi = 0\\n    while csi < num_captures {\\n      let cap_name = Array::get(captures, csi)\\n      let mut __cap_resolve = -1\\n      let mut __cri = Array::length(local_names) - 1\\n      while __cri >= 0 {\\n        if Array::get(local_names, __cri) == cap_name {\\n          __cap_resolve = __cri\\n          __cri = -1\\n        } else {\\n          __cri = __cri - 1\\n        }\\n      }\\n      if __cap_resolve >= 0 {\\n        if ctx.enable_rc && array_contains_str(ctx.ref_cell_names, cap_name) {\\n          // #699: own the captured RC ref cell. Store it odd-tagged so the\\n          // closure's class-7 drop (gen_rc_drop_body) recognises it as an owned\\n          // heap value, and bump its refcount (unguarded — a ref cell is always\\n          // heap) so the shared cell survives until BOTH the defining scope and\\n          // this closure have dropped it.\\n          emit_local_get(buf, ptr_local)\\n          emit_i32_wrap_i64(buf)\\n          emit_local_get(buf, __cap_resolve)\\n          emit_i64_const(buf, 1)\\n          emit_i64_or(buf)\\n          emit_i64_store(buf, 3, cap_off + csi * 8)\\n          emit_rc_word_inc_saturating(buf, () -> {\\n            emit_local_get(buf, __cap_resolve)\\n            emit_i32_wrap_i64(buf)\\n            emit_i32_const(buf, 4)\\n            emit_i32_sub(buf)\\n          })\\n        } else {\\n          emit_local_get(buf, ptr_local)\\n          emit_i32_wrap_i64(buf)\\n          emit_local_get(buf, __cap_resolve)\\n          emit_i64_store(buf, 3, cap_off + csi * 8)\\n        }\\n      } else {\\n        emit_local_get(buf, ptr_local)\\n        emit_i32_wrap_i64(buf)\\n        emit_i64_const(buf, 0)\\n        emit_i64_store(buf, 3, cap_off + csi * 8)\\n      }\\n      csi = csi + 1\\n    }\\n    if ctx.enable_rc {\\n      emit_local_get(buf, ptr_local)\\n      emit_i64_const(buf, 8)\\n      emit_i64_add(buf)\\n      emit_i64_const(buf, 1)\\n      emit_i64_or(buf)\\n    } else {\\n      emit_local_get(buf, ptr_local)\\n      emit_i64_const(buf, 1)\\n      emit_i64_or(buf)\\n    }\\n    nl2\\n  }\\n}\\n\")\n}\n\nlet cli_adapter_source_73 = () -> (String, String) {\n  (\"lib/@vibe/compiler/codegen/builtin_registry.vibe\",\n\"//# Imports\\n\\nimport ../core/index.vibe {\\n  Type\\n}\\n\\n//# Functions\\n\\n// #415: the central declarative registry of func-table builtins across\\n// both backends. Row: (name, param_count, returns_value 0|1,\\n// in_linear_table, in_gc_table).\\n//\\n// B-1: this registry DRIVES both lanes' registration. The linear builder\\n// (wasi/linked_compile.vibe) and the gc builder (gc/backend_body.vibe) each\\n// loop over these rows (filtered by their lane flag) and only resolve the\\n// lane-local function/body INDEX via a per-lane match — names, param counts\\n// and returns exist ONLY here. Adding a builtin = one row here + one index\\n// match arm in each claiming lane (+ the import/body wiring). A row claiming\\n// a lane whose index match has no arm fails every build by name; the\\n// remaining verify_lane_builtins pass (below) guards any future hand-edited\\n// registration path against drifting from this table (the wasm-gc HOF-gap\\n// class of regression this issue exists to prevent).\\n//\\n// Lane semantics:\\n// - in_linear_table / in_gc_table refer to the lane's FUNC-TABLE registration\\n//   only. A name absent from a lane's table may still be served there by a\\n//   callsite lowering (expr/compile_call.vibe, gc/backend_call.vibe) or by\\n//   prelude vibe source — B-1 will classify those; B-0 pins what exists.\\n// - Host imports (Fs::/Env::/sleep/...) are linear-only by design: the gc\\n//   lane is the pure-test lane and gates host builtins out as a group.\\n// B-2: rows now carry the CHECKER TYPE as the single source of truth.\\n// param_count / returns for the lanes are DERIVED from that type\\n// (builtin_registry() below); the checker resolves these names through\\n// lookup_registry_builtin FIRST, so the per-namespace checker lookup files\\n// no longer need (and must not re-add) arms for registry names.\\n// checker_visible=false rows are codegen-internal (desugar/compile_call\\n// artifacts, RC runtime hooks, canonical-name aliases) -- the checker never\\n// sees those names, and their synthesized types only feed the derived\\n// param/returns view.\\n\\nfn reg_p0() -> Array[Type] {\\n  Array::slice([\\n    CtUnknown\\n  ], 0, 0)\\n}\\n\\nfn reg_p1(a: Type) -> Array[Type] {\\n  let arr = reg_p0()\\n  Array::push(arr, a)\\n  arr\\n}\\n\\nfn reg_p2(a: Type, b: Type) -> Array[Type] {\\n  let arr = reg_p1(a)\\n  Array::push(arr, b)\\n  arr\\n}\\n\\nfn reg_p3(a: Type, b: Type, c: Type) -> Array[Type] {\\n  let arr = reg_p2(a, b)\\n  Array::push(arr, c)\\n  arr\\n}\\n\\nfn reg_p4(a: Type, b: Type, c: Type, d: Type) -> Array[Type] {\\n  let arr = reg_p3(a, b, c)\\n  Array::push(arr, d)\\n  arr\\n}\\n\\nfn reg_p5(a: Type, b: Type, c: Type, d: Type, e: Type) -> Array[Type] {\\n  let arr = reg_p4(a, b, c, d)\\n  Array::push(arr, e)\\n  arr\\n}\\n\\n// typed row: (name, checker signature, in_linear_table, in_gc_table,\\n// checker_visible). Module-level `let`: initialized ONCE (see\\n// fixtures/module_let_memo_test.vibe) -- lookup_registry_builtin runs on\\n// every unresolved-name lookup in the checker, and rebuilding 116 rows of\\n// nested CtFn/Array values per call was allocation churn heavy enough to\\n// crash the RC-mode in-process compiler tests.\\nlet registry_typed_rows: Array[(String, Type, Bool, Bool, Bool)] = [\\n    (\\\"Env::get\\\", CtFn(reg_p1(CtString), CtString, Some(\\\"Env\\\")), true, false, true),\\n    (\\\"Env::args_len\\\", CtFn(reg_p0(), CtInt, Some(\\\"Env\\\")), true, false, true),\\n    (\\\"Env::args_get\\\", CtFn(reg_p1(CtInt), CtString, Some(\\\"Env\\\")), true, false, true),\\n    (\\\"Fs::read_file\\\", CtFn(reg_p1(CtString), CtString, Some(\\\"Fs\\\")), true, false, true),\\n    (\\\"Fs::exists\\\", CtFn(reg_p1(CtString), CtBool, Some(\\\"Fs\\\")), true, false, true),\\n    (\\\"Fs::stat_token\\\", CtFn(reg_p1(CtString), CtInt, Some(\\\"Fs\\\")), true, false, true),\\n    // #795: alias-collision-proof surface for the same import.\\n    (\\\"vibe_fs_stat_token_raw\\\", CtFn(reg_p1(CtString), CtInt, Some(\\\"Fs\\\")), true, false, true),\\n    (\\\"Fs::write_file\\\", CtFn(reg_p2(CtString, CtString), CtUnit, Some(\\\"Fs\\\")), true, false, true),\\n    (\\\"Fs::write_bytes\\\", CtFn(reg_p2(CtString, CtBytes), CtUnit, Some(\\\"Fs\\\")), true, false, true),\\n    (\\\"Fs::read_bytes\\\", CtFn(reg_p1(CtString), CtBytes, Some(\\\"Fs\\\")), true, false, true),\\n    (\\\"vibe_fs_read_dir_raw\\\", CtFn(reg_p1(CtString), CtString, Some(\\\"Fs\\\")), true, false, false),\\n    (\\\"sh\\\", CtFn(reg_p1(CtString), CtString, Some(\\\"Process\\\")), true, false, true),\\n    (\\\"vibe_sh_lines_raw\\\", CtFn(reg_p1(CtString), CtString, Some(\\\"Process\\\")), true, false, false),\\n    // #865: structured subprocess result. `vibe_sh_capture_raw` runs the\\n    // command ONCE (unlike a naive 3-accessor design that would re-run it)\\n    // and parks {exit_code, stdout, stderr} behind a handle -- same\\n    // handle+accessor shape as the #794 HTTP client imports below, chosen so\\n    // a structured result doesn't require struct-returning host ABI work.\\n    // checker_visible=true (unlike vibe_sh_lines_raw's raw half) because these\\n    // are plain qualified names (no bare \\\"sh\\\"/\\\"sh_lines\\\" collision risk), so\\n    // ordinary vibe source (lib/@vibe/process/process.vibe) calls them\\n    // directly, mirroring lib/@vibe/http/http.vibe's `vibe_http_*_raw`\\n    // direct-call convention -- no compile_call.vibe special-casing needed.\\n    (\\\"vibe_sh_capture_raw\\\", CtFn(reg_p1(CtString), CtInt, Some(\\\"Process\\\")), true, false, true),\\n    (\\\"vibe_sh_capture_exit_code_raw\\\", CtFn(reg_p1(CtInt), CtInt, Some(\\\"Process\\\")), true, false, true),\\n    (\\\"vibe_sh_capture_stdout_raw\\\", CtFn(reg_p1(CtInt), CtString, Some(\\\"Process\\\")), true, false, true),\\n    (\\\"vibe_sh_capture_stderr_raw\\\", CtFn(reg_p1(CtInt), CtString, Some(\\\"Process\\\")), true, false, true),\\n    (\\\"vibe_sh_capture_close_raw\\\", CtFn(reg_p1(CtInt), CtUnit, Some(\\\"Process\\\")), true, false, true),\\n    // #903/#865: propagate a guest-chosen exit code to the real OS process\\n    // exit status (unlike a `main() -> Int` return, which `_start` only\\n    // PRINTS -- see ADR-0069's entry_returns_unit comment in\\n    // codegen/wasi/linked_compile.vibe). Traps via the host runner's\\n    // existing exit-trap mechanism (Rust `vibewt`: reuses ExitTrap, the\\n    // same trap the legacy `__moonbit_sys_unstable::exit` import already\\n    // used; JS runner: `process.exit(code)` directly) -- never returns.\\n    (\\\"vibe_process_exit_raw\\\", CtFn(reg_p1(CtInt), CtUnit, Some(\\\"Process\\\")), true, false, true),\\n    (\\\"Stdin::read_stream\\\", CtFn(reg_p1(CtInt), CtString, Some(\\\"Stdin\\\")), true, false, true),\\n    (\\\"Stdout::write_stream\\\", CtFn(reg_p1(CtString), CtUnit, Some(\\\"Stdout\\\")), true, false, true),\\n    (\\\"Stdout::write_char\\\", CtFn(reg_p1(CtInt), CtUnit, Some(\\\"Stdout\\\")), true, false, true),\\n    // #865: Stderr, mirroring Stdout::write_stream / Stdout::write_char exactly\\n    // (own host effect name \\\"Stderr\\\" so a function using only stderr does not\\n    // need to declare `with { Stdout }`).\\n    (\\\"Stderr::write_stream\\\", CtFn(reg_p1(CtString), CtUnit, Some(\\\"Stderr\\\")), true, false, true),\\n    (\\\"Stderr::write_char\\\", CtFn(reg_p1(CtInt), CtUnit, Some(\\\"Stderr\\\")), true, false, true),\\n    (\\\"resolve_path\\\", CtFn(reg_p1(CtString), CtString, None), true, false, false),\\n    (\\\"Fs::remove\\\", CtFn(reg_p1(CtString), CtUnit, Some(\\\"Fs\\\")), true, false, true),\\n    (\\\"Fs::mkdir_p\\\", CtFn(reg_p1(CtString), CtUnit, Some(\\\"Fs\\\")), true, false, true),\\n    (\\\"Fs::mkdir\\\", CtFn(reg_p1(CtString), CtUnit, Some(\\\"Fs\\\")), true, false, true),\\n    (\\\"Fs::chdir\\\", CtFn(reg_p1(CtString), CtUnit, Some(\\\"Fs\\\")), true, false, true),\\n    (\\\"Fs::copy\\\", CtFn(reg_p2(CtString, CtString), CtUnit, Some(\\\"Fs\\\")), true, false, true),\\n    (\\\"Fs::append\\\", CtFn(reg_p2(CtString, CtString), CtUnit, Some(\\\"Fs\\\")), true, false, true),\\n    (\\\"Fs::rename\\\", CtFn(reg_p2(CtString, CtString), CtUnit, Some(\\\"Fs\\\")), true, false, true),\\n    (\\\"Fs::is_dir\\\", CtFn(reg_p1(CtString), CtBool, Some(\\\"Fs\\\")), true, false, true),\\n    (\\\"Fs::is_file\\\", CtFn(reg_p1(CtString), CtBool, Some(\\\"Fs\\\")), true, false, true),\\n    (\\\"Fs::getcwd\\\", CtFn(reg_p0(), CtString, Some(\\\"Fs\\\")), true, false, true),\\n    // #794: HTTP client host imports (vibe.http_*) -- host builtins are\\n    // linear-only by design (the gc lane is the pure-test lane).\\n    (\\\"vibe_http_request_raw\\\", CtFn(reg_p4(CtString, CtString, CtString, CtString), CtInt, Some(\\\"Http\\\")), true, false, true),\\n    (\\\"vibe_http_response_status_raw\\\", CtFn(reg_p1(CtInt), CtInt, Some(\\\"Http\\\")), true, false, true),\\n    (\\\"vibe_http_response_header_raw\\\", CtFn(reg_p2(CtInt, CtString), CtString, Some(\\\"Http\\\")), true, false, true),\\n    (\\\"vibe_http_response_body_raw\\\", CtFn(reg_p1(CtInt), CtString, Some(\\\"Http\\\")), true, false, true),\\n    (\\\"vibe_http_close_raw\\\", CtFn(reg_p1(CtInt), CtUnit, Some(\\\"Http\\\")), true, false, true),\\n    (\\\"Profiler::now_us\\\", CtFn(reg_p0(), CtInt, Some(\\\"Profiler\\\")), true, false, true),\\n    (\\\"Profiler::NowUs\\\", CtFn(reg_p0(), CtInt, None), true, false, false),\\n    // Current bump-heap pointer (bytes) — the allocation analog of now_us,\\n    // for per-phase memory attribution in profiles/benches.\\n    (\\\"Profiler::heap_bytes\\\", CtFn(reg_p0(), CtInt, Some(\\\"Profiler\\\")), true, false, true),\\n    (\\\"Profiler::HeapBytes\\\", CtFn(reg_p0(), CtInt, None), true, false, false),\\n    (\\\"sleep\\\", CtFn(reg_p1(CtInt), CtUnit, Some(\\\"Async\\\")), true, false, true),\\n    (\\\"Stdin::read_char\\\", CtFn(reg_p0(), CtInt, Some(\\\"Stdin\\\")), true, false, true),\\n    (\\\"simd_skip_ws\\\", CtFn(reg_p3(CtBytes, CtInt, CtInt), CtInt, None), true, false, true),\\n    (\\\"simd_scan_alnum\\\", CtFn(reg_p3(CtBytes, CtInt, CtInt), CtInt, None), true, false, true),\\n    (\\\"simd_scan_alnum_str\\\", CtFn(reg_p3(CtString, CtInt, CtInt), CtInt, None), true, false, true),\\n    (\\\"str_lex_diff\\\", CtFn(reg_p2(CtString, CtString), CtInt, None), true, true, false),\\n    (\\\"print_int\\\", CtFn(reg_p1(CtInt), CtUnit, None), true, true, false),\\n    (\\\"print_str\\\", CtFn(reg_p1(CtString), CtUnit, None), true, true, false),\\n    (\\\"String::length\\\", CtFn(reg_p1(CtString), CtInt, None), true, true, true),\\n    (\\\"String::equals\\\", CtFn(reg_p2(CtString, CtString), CtBool, None), true, true, true),\\n    (\\\"String::concat\\\", CtFn(reg_p2(CtString, CtString), CtString, None), true, true, true),\\n    (\\\"array_new\\\", CtFn(reg_p0(), CtArray(CtUnknown), None), true, true, true),\\n    (\\\"Array::length\\\", CtFn(reg_p1(CtArray(CtUnknown)), CtInt, None), true, true, true),\\n    (\\\"Array::get\\\", CtFn(reg_p2(CtArray(CtUnknown), CtInt), CtUnknown, None), true, true, true),\\n    (\\\"Array::push\\\", CtFn(reg_p2(CtArray(CtUnknown), CtUnknown), CtUnit, None), true, true, true),\\n    (\\\"Array::push_all\\\", CtFn(reg_p2(CtArray(CtUnknown), CtArray(CtUnknown)), CtUnit, None), true, true, true),\\n    (\\\"Array::set\\\", CtFn(reg_p3(CtArray(CtUnknown), CtInt, CtUnknown), CtUnit, None), true, true, true),\\n    (\\\"Double::to_int\\\", CtFn(reg_p1(CtDouble), CtInt, None), true, true, true),\\n    (\\\"Int::to_double\\\", CtFn(reg_p1(CtInt), CtDouble, None), true, true, true),\\n    (\\\"String::char_code_at\\\", CtFn(reg_p2(CtString, CtInt), CtInt, None), true, true, true),\\n    (\\\"String::from_char_code\\\", CtFn(reg_p1(CtInt), CtString, None), true, true, true),\\n    (\\\"String::substring\\\", CtFn(reg_p3(CtString, CtInt, CtInt), CtString, None), true, true, true),\\n    (\\\"Array::truncate\\\", CtFn(reg_p2(CtArray(CtUnknown), CtInt), CtUnit, None), true, true, true),\\n    (\\\"String::join\\\", CtFn(reg_p2(CtArray(CtString), CtString), CtString, None), true, true, true),\\n    (\\\"eq\\\", CtFn(reg_p2(CtInt, CtInt), CtBool, None), true, true, true),\\n    (\\\"String::ends_with\\\", CtFn(reg_p2(CtString, CtString), CtBool, None), true, true, true),\\n    (\\\"String::last_index_of\\\", CtFn(reg_p2(CtString, CtString), CtInt, None), true, true, true),\\n    (\\\"String::index_of\\\", CtFn(reg_p2(CtString, CtString), CtInt, None), true, true, true),\\n    (\\\"String::contains\\\", CtFn(reg_p2(CtString, CtString), CtBool, None), true, true, true),\\n    (\\\"String::starts_with\\\", CtFn(reg_p2(CtString, CtString), CtBool, None), true, true, true),\\n    (\\\"String::split\\\", CtFn(reg_p2(CtString, CtString), CtArray(CtString), None), true, true, true),\\n    (\\\"String::trim\\\", CtFn(reg_p1(CtString), CtString, None), true, true, true),\\n    (\\\"selfhost_sources\\\", CtFn(reg_p0(), CtString, None), true, false, false),\\n    (\\\"ArrayBuilder::new\\\", CtFn(reg_p0(), CtUnknown, None), true, true, true),\\n    (\\\"ArrayBuilder::push\\\", CtFn(reg_p2(CtUnknown, CtUnknown), CtUnit, None), true, true, true),\\n    (\\\"ArrayBuilder::freeze\\\", CtFn(reg_p1(CtUnknown), CtArray(CtUnknown), None), true, true, true),\\n    (\\\"Array::slice\\\", CtFn(reg_p3(CtArray(CtUnknown), CtInt, CtInt), CtArray(CtUnknown), None), true, true, true),\\n    (\\\"Array::concat\\\", CtFn(reg_p2(CtArray(CtUnknown), CtArray(CtUnknown)), CtArray(CtUnknown), None), true, true, true),\\n    (\\\"Bytes::new\\\", CtFn(reg_p0(), CtBytes, None), true, true, true),\\n    (\\\"Bytes::from_array\\\", CtFn(reg_p1(CtArray(CtInt)), CtBytes, None), true, true, true),\\n    (\\\"Bytes::to_array\\\", CtFn(reg_p1(CtBytes), CtArray(CtInt), None), true, true, true),\\n    (\\\"Bytes::length\\\", CtFn(reg_p1(CtBytes), CtInt, None), true, true, true),\\n    (\\\"Bytes::get\\\", CtFn(reg_p2(CtBytes, CtInt), CtInt, None), true, true, true),\\n    (\\\"Bytes::set\\\", CtFn(reg_p3(CtBytes, CtInt, CtInt), CtUnit, None), true, true, true),\\n    (\\\"Bytes::push\\\", CtFn(reg_p2(CtBytes, CtInt), CtUnit, None), true, true, true),\\n    (\\\"Bytes::append\\\", CtFn(reg_p2(CtBytes, CtBytes), CtUnit, None), true, true, true),\\n    (\\\"Bytes::concat\\\", CtFn(reg_p2(CtBytes, CtBytes), CtBytes, None), true, true, true),\\n    (\\\"Bytes::slice\\\", CtFn(reg_p3(CtBytes, CtInt, CtInt), CtBytes, None), true, true, true),\\n    (\\\"Double::to_i64_bits\\\", CtFn(reg_p1(CtDouble), CtInt, None), true, true, true),\\n    (\\\"__to_string\\\", CtFn(reg_p1(CtUnknown), CtString, None), true, true, true),\\n    (\\\"vibe_rc_drop\\\", CtFn(reg_p1(CtUnknown), CtUnit, None), true, false, false),\\n    (\\\"vibe_rc_alloc\\\", CtFn(reg_p1(CtInt), CtInt, None), true, false, false),\\n    (\\\"vibe_heap_grow_check\\\", CtFn(reg_p0(), CtUnit, None), true, false, false),\\n    (\\\"not\\\", CtFn(reg_p1(CtBool), CtBool, None), false, true, true),\\n    (\\\"Bytes::blit\\\", CtFn(reg_p4(CtBytes, CtBytes, CtInt, CtInt), CtUnit, None), false, true, true),\\n    (\\\"Bytes::fill\\\", CtFn(reg_p3(CtBytes, CtInt, CtInt), CtUnit, None), false, true, true),\\n    (\\\"Double::from_i64_bits\\\", CtFn(reg_p1(CtInt), CtDouble, None), false, true, true),\\n    (\\\"Double::to_float\\\", CtFn(reg_p1(CtDouble), CtDouble, None), false, true, false),\\n    (\\\"Float::to_double\\\", CtFn(reg_p1(CtDouble), CtDouble, None), false, true, false),\\n    (\\\"Char::to_int\\\", CtFn(reg_p1(CtChar), CtInt, None), false, true, true),\\n    (\\\"Char::from_int\\\", CtFn(reg_p1(CtInt), CtChar, None), false, true, true),\\n    (\\\"Int::to_float\\\", CtFn(reg_p1(CtInt), CtDouble, None), false, true, true),\\n    (\\\"FixedArray::make\\\", CtFn(reg_p2(CtInt, CtUnknown), CtArray(CtUnknown), None), false, true, true),\\n    (\\\"FixedArray::length\\\", CtFn(reg_p1(CtArray(CtUnknown)), CtInt, None), false, true, true),\\n    (\\\"FixedArray::get\\\", CtFn(reg_p2(CtArray(CtUnknown), CtInt), CtUnknown, None), false, true, true),\\n    (\\\"FixedArray::set\\\", CtFn(reg_p3(CtArray(CtUnknown), CtInt, CtUnknown), CtUnit, None), false, true, true),\\n    (\\\"FixedArray::unsafe_set\\\", CtFn(reg_p3(CtArray(CtUnknown), CtInt, CtUnknown), CtUnit, None), false, true, true),\\n    (\\\"FixedArray::blit\\\", CtFn(reg_p5(CtArray(CtUnknown), CtInt, CtArray(CtUnknown), CtInt, CtInt), CtUnit, None), false, true, true),\\n    // #835: Int64Array rides on the same linear-memory Array representation\\n    // as FixedArray (Array[Int] already stores the full 62-bit tagged Int\\n    // per cell, no i32-cell truncation in the selfhost backends — unlike the\\n    // retired MoonBit host, which needed a distinct i64-cell object layout).\\n    // So this is a pure name-level alias onto Array::make/length/get/set,\\n    // just typed concretely as Array[Int] instead of FixedArray's generic\\n    // Array[Unknown] (cheatsheet documents it strictly for Int word buffers).\\n    (\\\"Int64Array::make\\\", CtFn(reg_p2(CtInt, CtInt), CtArray(CtInt), None), false, true, true),\\n    (\\\"Int64Array::length\\\", CtFn(reg_p1(CtArray(CtInt)), CtInt, None), false, true, true),\\n    (\\\"Int64Array::get\\\", CtFn(reg_p2(CtArray(CtInt), CtInt), CtInt, None), false, true, true),\\n    (\\\"Int64Array::set\\\", CtFn(reg_p3(CtArray(CtInt), CtInt, CtInt), CtUnit, None), false, true, true),\\n    (\\\"StringBuilder::new\\\", CtFn(reg_p0(), CtUnknown, None), false, true, true),\\n    (\\\"StringBuilder::push\\\", CtFn(reg_p2(CtUnknown, CtString), CtUnit, None), false, true, true),\\n    (\\\"StringBuilder::freeze\\\", CtFn(reg_p1(CtUnknown), CtString, None), false, true, true),\\n    (\\\"Map::get\\\", CtFn(reg_p2(CtUnknown, CtString), CtUnknown, None), false, true, true),\\n    (\\\"Map::keys\\\", CtFn(reg_p1(CtUnknown), CtArray(CtString), None), false, true, true),\\n    (\\\"MapBuilder::new\\\", CtFn(reg_p0(), CtUnknown, None), false, true, true),\\n    (\\\"MapBuilder::set\\\", CtFn(reg_p3(CtUnknown, CtString, CtUnknown), CtUnit, None), false, true, true),\\n    (\\\"MapBuilder::freeze\\\", CtFn(reg_p1(CtUnknown), CtUnknown, None), false, true, true),\\n    (\\\"assert\\\", CtFn(reg_p1(CtBool), CtUnit, None), false, true, true),\\n    (\\\"assert_true\\\", CtFn(reg_p1(CtBool), CtUnit, None), false, true, true),\\n    (\\\"assert_eq\\\", CtFn(reg_p2(CtUnknown, CtUnknown), CtUnit, None), false, true, true),\\n    (\\\"println\\\", CtFn(reg_p1(CtString), CtUnit, None), false, true, true),\\n    (\\\"print\\\", CtFn(reg_p1(CtString), CtUnit, None), false, true, true),\\n    (\\\"map_has\\\", CtFn(reg_p2(CtUnknown, CtString), CtBool, None), false, true, true)\\n  ]\\n\\nexport fn builtin_registry_typed() -> Array[(String, Type, Bool, Bool, Bool)] {\\n  registry_typed_rows\\n}\\n\\n// Derived 5-tuple view for the two codegen lanes -- SAME shape as the B-0/B-1\\n// table so wasi/linked_compile.vibe and gc/backend_body.vibe are unchanged:\\n// param_count = the type's parameter count, returns = 0 iff the return type\\n// is CtUnit.\\nexport fn builtin_registry() -> Array[(String, Int, Int, Bool, Bool)] {\\n  let rows = builtin_registry_typed()\\n  let out = Array::slice([\\n    (\\\"\\\", 0, 0, false, false)\\n  ], 0, 0)\\n  let mut i = 0\\n  while i < Array::length(rows) {\\n    let (name, ty, in_linear, in_gc, _) = Array::get(rows, i)\\n    let (pc, ret) = match ty {\\n      CtFn(params, ret_ty, _) => {\\n        let r = match ret_ty {\\n          CtUnit => 0,\\n          _ => 1\\n        }\\n        (Array::length(params), r)\\n      },\\n      _ => (0, 1)\\n    }\\n    Array::push(out, (name, pc, ret, in_linear, in_gc))\\n    i = i + 1\\n  }\\n  out\\n}\\n\\n// B-2: the checker-facing lookup, consulted FIRST by\\n// checker/builtins.vibe::lookup_builtin. Only checker_visible rows resolve;\\n// codegen-internal names stay invisible to user code.\\nexport fn lookup_registry_builtin(name: String) -> Option[Type] {\\n  let rows = builtin_registry_typed()\\n  let mut i = 0\\n  let mut found = None\\n  while i < Array::length(rows) {\\n    let (rname, ty, _, _, visible) = Array::get(rows, i)\\n    if rname == name && visible {\\n      found = Some(ty)\\n      i = Array::length(rows)\\n    } else {\\n      i = i + 1\\n    }\\n  }\\n  found\\n}\\n\\n// #415 B-0: assert one lane's registered (names, param_counts, returns)\\n// arrays agree with the registry. Called by each backend builder right after\\n// it finishes its registration pushes; throws with a named diff on any\\n// drift. O(n^2) over ~100 entries at compile start — noise next to a parse.\\nexport fn verify_lane_builtins(lane: String, names: Array[String], param_counts: Array[Int], returns: Array[Int]) -> Unit with { Error } {\\n  let is_gc = lane == \\\"gc\\\"\\n  let reg = builtin_registry()\\n  // 1. every registered name must have a matching registry row\\n  let mut i = 0\\n  while i < Array::length(names) {\\n    let n = Array::get(names, i)\\n    let mut found = false\\n    let mut ri = 0\\n    while ri < Array::length(reg) {\\n      let (rn, rp, rr, rlin, rgc) = Array::get(reg, ri)\\n      if rn == n {\\n        found = true\\n        let claimed = if is_gc { rgc } else { rlin }\\n        if claimed {\\n          ()\\n        } else {\\n          throw(\\\"builtin registry drift: '\\\\{n}' is registered by the \\\\{lane} lane but the registry says it is not in that lane's table (lib/@vibe/compiler/codegen/builtin_registry.vibe, #415)\\\")\\n        }\\n        if rp == Array::get(param_counts, i) && rr == Array::get(returns, i) {\\n          ()\\n        } else {\\n          throw(\\\"builtin registry drift: '\\\\{n}' signature mismatch in the \\\\{lane} lane — registry says (params=\\\\{rp}, returns=\\\\{rr}), lane registered (params=\\\\{Array::get(param_counts, i)}, returns=\\\\{Array::get(returns, i)}) (#415)\\\")\\n        }\\n        ri = Array::length(reg)\\n      } else {\\n        ri = ri + 1\\n      }\\n    }\\n    if found {\\n      ()\\n    } else {\\n      throw(\\\"builtin registry drift: '\\\\{n}' is registered by the \\\\{lane} lane but has no row in lib/@vibe/compiler/codegen/builtin_registry.vibe (#415) — add one (and decide the other lane explicitly)\\\")\\n    }\\n    i = i + 1\\n  }\\n  // 2. every registry row claiming this lane must actually be registered.\\n  // Exemption: the linear lane registers vibe_rc_drop/vibe_rc_alloc only when RC is\\n  // enabled (VIBE_RC), so their absence in a bump-mode build is not drift —\\n  // they stay direction-1 verified (if registered, the signature must match).\\n  let mut ri2 = 0\\n  while ri2 < Array::length(reg) {\\n    let (rn2, _, _, rlin2, rgc2) = Array::get(reg, ri2)\\n    let claimed2 = (if is_gc { rgc2 } else { rlin2 }) && not(String::starts_with(rn2, \\\"vibe_rc_\\\"))\\n    if claimed2 {\\n      let mut found2 = false\\n      let mut i2 = 0\\n      while i2 < Array::length(names) {\\n        if Array::get(names, i2) == rn2 {\\n          found2 = true\\n          i2 = Array::length(names)\\n        } else {\\n          i2 = i2 + 1\\n        }\\n      }\\n      if found2 {\\n        ()\\n      } else {\\n        throw(\\\"builtin registry drift: registry claims '\\\\{rn2}' is in the \\\\{lane} lane's table but the lane did not register it (#415)\\\")\\n      }\\n    } else {\\n      ()\\n    }\\n    ri2 = ri2 + 1\\n  }\\n}\\n\")\n}\n\nlet cli_adapter_source_74 = () -> (String, String) {\n  (\"lib/@vibe/compiler/codegen/double_to_string_expr.vibe\",\n\"//# Imports\\n\\nimport ../core {\\n  Expr, Pat, Stmt, TypeExpr\\n}\\n\\n//# Functions\\n\\n// #744: fixed-precision Double→String, synthesized as ordinary AST and lowered\\n// via each backend's `ce` at `__to_string` callsites whose argument is\\n// statically floatish (string interpolation of a Double used to stringify the\\n// raw f64 bits — `\\\"\\\\{42.0}\\\"` printed \\\"4631107791820423168\\\"). Integer part\\n// exact; fraction as 15 scaled digits with trailing zeros trimmed (round-trips\\n// human-scale values: 3.14 / 0.0125 / -1.5). Same algorithm as vibe/json's\\n// format_number. String pieces are built with String::from_char_code so no\\n// string-table seeding is needed. Beyond ~9e14 the fraction is meaningless:\\n// integer part only. The synthesized code follows ordinary source conventions,\\n// so RC boxing, the bump lane's raw bits, and the gc lane's raw bits all work\\n// through each backend's normal float codegen paths. Shared by the linear\\n// callsite handler (expr/compile_call.vibe) and the gc dispatch\\n// (gc/backend_call.vibe) — keep it backend-agnostic.\\nexport fn double_to_string_expr(arg: Expr) -> Expr {\\n  let c1: (String, Expr) -> Expr = (f, a0) -> {\\n    ECall(EIdent(f, -1), [\\n      a0\\n    ], -1)\\n  }\\n  let c2: (String, Expr, Expr) -> Expr = (f, a0, a1) -> {\\n    ECall(EIdent(f, -1), [\\n      a0,\\n      a1\\n    ], -1)\\n  }\\n  let c3: (String, Expr, Expr, Expr) -> Expr = (f, a0, a1, a2) -> {\\n    ECall(EIdent(f, -1), [\\n      a0,\\n      a1,\\n      a2\\n    ], -1)\\n  }\\n  let n = EIdent(\\\"__dts_n\\\", -1)\\n  let neg = EIdent(\\\"__dts_neg\\\", -1)\\n  let a = EIdent(\\\"__dts_a\\\", -1)\\n  let ip = EIdent(\\\"__dts_ip\\\", -1)\\n  let frac = EIdent(\\\"__dts_frac\\\", -1)\\n  let s0 = EIdent(\\\"__dts_s0\\\", -1)\\n  let ip2 = EIdent(\\\"__dts_ip2\\\", -1)\\n  let sc = EIdent(\\\"__dts_sc\\\", -1)\\n  let istr = EIdent(\\\"__dts_istr\\\", -1)\\n  let signed = EIdent(\\\"__dts_signed\\\", -1)\\n  let ds = EIdent(\\\"__dts_ds\\\", -1)\\n  let endv = EIdent(\\\"__dts_end\\\", -1)\\n  let big = EIdent(\\\"__dts_big\\\", -1)\\n  let ch_minus = c1(\\\"String::from_char_code\\\", EInt(45))\\n  let ch_dot = c1(\\\"String::from_char_code\\\", EInt(46))\\n  let ch_zero = c1(\\\"String::from_char_code\\\", EInt(48))\\n  let scale_int = EInt(1000000000000000)\\n  // 15 fractional digits: zero-pad to 15, trim trailing zeros, append.\\n  let frac_tail = ELetMut(\\\"__dts_ds\\\", c1(\\\"__to_string\\\", sc), ELetMut(\\\"__dts_end\\\", EInt(15), ESeq(EWhile(EBinOp(\\\"<\\\", c1(\\\"String::length\\\", ds), EInt(15)), EAssign(\\\"__dts_ds\\\", c2(\\\"String::concat\\\", ch_zero, ds), EUnit)), ESeq(EWhile(EBinOp(\\\"==\\\", c2(\\\"String::char_code_at\\\", ds, EBinOp(\\\"-\\\", endv, EInt(1))), EInt(48)), EAssign(\\\"__dts_end\\\", EBinOp(\\\"-\\\", endv, EInt(1)), EUnit)), c2(\\\"String::concat\\\", signed, c2(\\\"String::concat\\\", ch_dot, c3(\\\"String::substring\\\", ds, EInt(0), endv))))), -1), -1)\\n  let signed_val = EIf(neg, EIf(EBinOp(\\\">\\\", ip2, EInt(0)), c2(\\\"String::concat\\\", ch_minus, istr), EIf(EBinOp(\\\">\\\", sc, EInt(0)), c2(\\\"String::concat\\\", ch_minus, istr), istr)), istr)\\n  let small = ELet(\\\"__dts_ip\\\", c1(\\\"Double::to_int\\\", a), ELet(\\\"__dts_frac\\\", EBinOp(\\\"-\\\", a, c1(\\\"Int::to_double\\\", ip)), ELet(\\\"__dts_s0\\\", c1(\\\"Double::to_int\\\", EBinOp(\\\"+\\\", EBinOp(\\\"*\\\", frac, EFloat(1000000000000000.0)), EFloat(0.5))), ELet(\\\"__dts_ip2\\\", EIf(EBinOp(\\\">=\\\", s0, scale_int), EBinOp(\\\"+\\\", ip, EInt(1)), ip), ELet(\\\"__dts_sc\\\", EIf(EBinOp(\\\">=\\\", s0, scale_int), EInt(0), s0), ELet(\\\"__dts_istr\\\", c1(\\\"__to_string\\\", ip2), ELet(\\\"__dts_signed\\\", signed_val, EIf(EBinOp(\\\"==\\\", sc, EInt(0)), signed, frac_tail), -1), -1), -1), -1), -1), -1), -1)\\n  let big_case = ELet(\\\"__dts_big\\\", c1(\\\"__to_string\\\", c1(\\\"Double::to_int\\\", a)), EIf(neg, c2(\\\"String::concat\\\", ch_minus, big), big), -1)\\n  ELet(\\\"__dts_n\\\", arg, ELet(\\\"__dts_neg\\\", EBinOp(\\\"<\\\", n, EFloat(0.0)), ELet(\\\"__dts_a\\\", EIf(neg, EBinOp(\\\"-\\\", EFloat(0.0), n), n), EIf(EBinOp(\\\">=\\\", a, EFloat(900000000000000.0)), big_case, small), -1), -1), -1)\\n}\\n\")\n}\n\nlet cli_adapter_source_75 = () -> (String, String) {\n  (\"lib/@vibe/compiler/codegen/int_parse_expr.vibe\",\n\"//# Imports\\n\\nimport ../core {\\n  Expr, Pat, Stmt, TypeExpr\\n}\\n\\n//# Functions\\n\\n// #767: Int::parse(s) -> Option[Int], synthesized as ordinary AST (same\\n// technique as double_to_string_expr) and lowered via each backend's `ce`.\\n// Building this as composed calls to already-working builtins (String::length\\n// / String::char_code_at / Some / None) means no new raw-wasm enum/Option\\n// construction is needed — the normal expr compiler already knows how to\\n// build Option values. Accepts an optional leading '-'; any other non-digit\\n// character, or an empty string (after the sign), yields None.\\nexport fn int_parse_expr(arg: Expr) -> Expr {\\n  let c1: (String, Expr) -> Expr = (f, a0) -> {\\n    ECall(EIdent(f, -1), [\\n      a0\\n    ], -1)\\n  }\\n  let c2: (String, Expr, Expr) -> Expr = (f, a0, a1) -> {\\n    ECall(EIdent(f, -1), [\\n      a0,\\n      a1\\n    ], -1)\\n  }\\n  let s = EIdent(\\\"__ip_s\\\", -1)\\n  let len = EIdent(\\\"__ip_len\\\", -1)\\n  let start = EIdent(\\\"__ip_start\\\", -1)\\n  let neg = EIdent(\\\"__ip_neg\\\", -1)\\n  let i = EIdent(\\\"__ip_i\\\", -1)\\n  let acc = EIdent(\\\"__ip_acc\\\", -1)\\n  let valid = EIdent(\\\"__ip_valid\\\", -1)\\n  let ch = EIdent(\\\"__ip_ch\\\", -1)\\n  // Overflow guard: reject when `acc * 10 + digit` would exceed\\n  // Int::max_value (2^61 - 1) — pre-check `acc > (max - d) / 10` so the\\n  // accumulator never wraps. Without this, \\\"2305843009213693952\\\" (max + 1)\\n  // silently parsed as an out-of-range value. The exact min_value string\\n  // also yields None (its magnitude is max_value + 1).\\n  let digit_step = EIf(EBinOp(\\\">\\\", acc, EBinOp(\\\"/\\\", EBinOp(\\\"-\\\", EInt(2305843009213693951), EBinOp(\\\"-\\\", ch, EInt(48))), EInt(10))), EAssign(\\\"__ip_valid\\\", EBool(false), EUnit), EAssign(\\\"__ip_acc\\\", EBinOp(\\\"+\\\", EBinOp(\\\"*\\\", acc, EInt(10)), EBinOp(\\\"-\\\", ch, EInt(48))), EUnit))\\n  let loop_body = ELet(\\\"__ip_ch\\\", c2(\\\"String::char_code_at\\\", s, i), ESeq(\\n    EIf(EBinOp(\\\"||\\\", EBinOp(\\\"<\\\", ch, EInt(48)), EBinOp(\\\">\\\", ch, EInt(57))), EAssign(\\\"__ip_valid\\\", EBool(false), EUnit), digit_step),\\n    EAssign(\\\"__ip_i\\\", EBinOp(\\\"+\\\", i, EInt(1)), EUnit)\\n  ), -1)\\n  let while_loop = EWhile(EBinOp(\\\"<\\\", i, len), loop_body)\\n  let result_val = EIf(neg, EBinOp(\\\"-\\\", EInt(0), acc), acc)\\n  let final_check = EIf(EBinOp(\\\"&&\\\", valid, EBinOp(\\\"<\\\", start, len)), c1(\\\"Some\\\", result_val), EIdent(\\\"None\\\", -1))\\n  ELet(\\\"__ip_s\\\", arg, ELet(\\\"__ip_len\\\", c1(\\\"String::length\\\", s), EIf(EBinOp(\\\"==\\\", len, EInt(0)), EIdent(\\\"None\\\", -1), ELet(\\\"__ip_neg\\\", EBinOp(\\\"==\\\", c2(\\\"String::char_code_at\\\", s, EInt(0)), EInt(45)), ELet(\\\"__ip_start\\\", EIf(neg, EInt(1), EInt(0)), ELetMut(\\\"__ip_i\\\", start, ELetMut(\\\"__ip_acc\\\", EInt(0), ELetMut(\\\"__ip_valid\\\", EBool(true), ESeq(while_loop, final_check), -1), -1), -1), -1), -1)), -1), -1)\\n}\\n\")\n}\n\nlet cli_adapter_source_76 = () -> (String, String) {\n  (\"lib/@vibe/compiler/codegen/expr/compile_call.vibe\",\n\"//# Imports\\n\\nimport ../../builtin_name.vibe {\\n  canonical_builtin_name\\n}\\n\\nimport ../../core {\\n  Expr, Pat, Stmt, TypeExpr, bytebuf_length, bytebuf_new, bytebuf_push, bytebuf_push_section, bytebuf_push_vec_header, bytebuf_to_bytes, leb128_encode_s64, leb128_encode_u32\\n}\\n\\nimport ../common_analysis {\\n  collect_free_vars, collect_strings_stmts, emit_closure_call_tail, emit_closure_resolve, emit_i64_extend_i32_u, is_mut_captured_in\\n}\\n\\nimport ../common_base {\\n  emit_rc_word_inc_saturating, CompileCtx, CtorTable, FuncTable, LambdaTable, StrTable, agg_expr_lookup, agg_slot_lookup, emit_rc_dup_guarded, effect_name_to_tag, effect_op_index, emit_binop_op, emit_box_float, emit_heap_grow_after_heap_set, emit_i32_eq, emit_i32_eqz, emit_i32_ge_u, emit_i32_gt_u, emit_i32_mul, emit_i32_ne, emit_i32_sub, emit_i64_load, emit_i64_store, emit_index_one, emit_str_ref, emit_unbox_float, expr_tag, find_local_slot, get_arm_body, get_arm_pat, get_ebinop_op, get_efn_body, get_eif_cond, get_eif_else, get_eif_then, get_elet_body, get_elet_name, get_elet_val, get_slet_expr, get_slet_name, is_efn, is_eident, is_etuple, is_pbind, is_pbool, is_pctor, is_pint, is_pstring, is_ptuple, is_pwild, is_slet, ctor_table_index_of, resolve_func, resolve_local, struct_field_candidates, struct_field_dispatch_cases\\n}\\n\\nimport ../common_extractors {\\n  array_contains_str, emit_assignop_op, emit_memory_copy, find_catchall_idx, get_earray_elems, get_eassign_body, get_eassign_name, get_eassign_val, get_eassignop_body, get_eassignop_name, get_eassignop_op, get_eassignop_val, get_ebinop_lhs, get_ebinop_rhs, get_ebool_value, get_ecall_args, get_ecall_callee, get_efloat_value, get_efn_params, get_eforin_body, get_eforin_iter, get_eforin_name, get_eident_name, get_eint_value, get_eletmut_body, get_eletmut_name, get_eletmut_val, get_eletrec_body, get_eletrec_name, get_eletrec_val, get_eseq_first, get_eseq_second, get_estring_value, get_etuple_elems, get_eunaryop_expr, get_eunaryop_op, get_ewhile_body, get_ewhile_cond, get_match_arms, get_match_scrutinee, get_pbind_name, get_pbool_value, get_pctor_args, get_pctor_name, get_pint_value, get_pstring_value, get_ptuple_pats, get_slet_export, str_table_lookup\\n}\\n\\nimport ../wasm_emit {\\n  emit_block_i64, emit_block_void, emit_br, emit_br_if, emit_call, emit_call_indirect, emit_code_section, emit_code_section_with_locals, emit_data_section, emit_data_section_multi, emit_drop, emit_element_section_active, emit_else, emit_end, emit_export_section, emit_export_section_multi, emit_exports_full, emit_exports_with_memory, emit_f64_add, emit_f64_const_bits, emit_f64_const_lohi, emit_f64_convert_i64_s, emit_f64_div, emit_f64_eq, emit_f64_ge, emit_f64_gt, emit_f64_le, emit_f64_lt, emit_f64_mul, emit_f64_ne, emit_f64_neg, emit_f64_reinterpret_i64, emit_f64_sub, emit_f64_abs, emit_f64_ceil, emit_f64_floor, emit_f64_max, emit_f64_min, emit_func_type_raw, emit_function_section, emit_global_get, emit_global_section_i32_mut, emit_global_set, emit_header, emit_i32_add, emit_i32_const, emit_i32_load, emit_i32_load8_u, emit_i32_store, emit_i32_store8, emit_i32_wrap_i64, emit_i64_add, emit_i64_and, emit_i64_const, emit_i64_div_s, emit_i64_eq, emit_i64_eqz, emit_i64_extend_i32_s, emit_i64_ge_s, emit_i64_gt_s, emit_i64_le_s, emit_i64_lt_s, emit_i64_mul, emit_i64_ne, emit_i64_or, emit_i64_reinterpret_f64, emit_i64_rem_s, emit_i64_shl, emit_i64_shr_s, emit_i64_sub, emit_i64_trunc_f64_s, emit_i64_xor, emit_if_i64, emit_if_void, emit_import_section_func, emit_local_get, emit_local_set, emit_local_tee, emit_loop_void, emit_memory_section, emit_name, emit_return, emit_table_section_funcref, emit_type_section, emit_type_section_multi, string_to_data, emit_v128_load, emit_v128_store, emit_i8x16_splat, emit_i8x16_eq, emit_i8x16_le_u, emit_i8x16_ge_u, emit_v128_and, emit_v128_or, emit_v128_not, emit_i8x16_bitmask, emit_v128_any_true, emit_i8x16_all_true, emit_v128_const_splat_byte\\n}\\n\\nimport ./compile_lambda.vibe {\\n  compile_lambda\\n}\\n\\nimport ./compile_match.vibe {\\n  compile_match\\n}\\n\\nimport ../double_to_string_expr.vibe {\\n  double_to_string_expr\\n}\\n\\nimport ../int_parse_expr.vibe {\\n  int_parse_expr\\n}\\n\\n//# Functions\\n\\n// A field projection `a.f` (EDot) passed as an argument to an owning user\\n// function (which drops its parameters) is a borrow of the source aggregate.\\n// Without a retain the callee's param-drop frees it while the source still\\n// references it — a double-free that corrupts the free list (e.g. derived\\n// `T::equals` passing `a.items` to the consuming `__arr_equals__` helper, #704).\\n// #929: non-throwing func-table membership probe (resolve_func throws on a\\n// missing name). The println/print fallback lowering below must yield to a\\n// SOURCE-provided definition (@vibe/io's println, or a user shadow) whenever\\n// one is merged into the program.\\nfn cc_ft_has(ft: FuncTable, name: String) -> Bool {\\n  let mut i = 0\\n  let mut found = false\\n  while i < Array::length(ft.names) {\\n    if Array::get(ft.names, i) == name {\\n      found = true\\n      i = Array::length(ft.names)\\n    } else {\\n      i = i + 1\\n    }\\n  }\\n  found\\n}\\n\\n// Perceus emits no action for bare projections, so this guarded dup is the only\\n// owner-increment. Scalars are no-ops; this is NOT applied to borrow-arg0\\n// builtins (Array::get/length etc.), which do not drop their argument.\\nfn cc_is_projection(e: Expr) -> Bool {\\n  match e {\\n    EDot(_, _, _, _) => true,\\n    _ => false\\n  }\\n}\\n\\n// #705: a borrow-RETURNING builtin call (`Array::get` / `Map::get` / `__index`)\\n// yields a borrowed view of a heap element — its refcount is NOT bumped, like a\\n// projection `a.f`. When that result is consumed in an OWNING position (a ctor\\n// field, or an owning call arg of a fn that drops its params), it must be\\n// rc_dup'd or the container's recursive drop and the consume double-free the\\n// same element (e.g. `chk(Array::get(ps, i))` recursing over a heap array, or\\n// `validate(s, Map::get(obj, key))`). Scalars are even so the guarded dup is a\\n// runtime no-op for `Array[Int]` etc.\\nexport fn cc_is_borrow_ret_call(e: Expr, ctx: CompileCtx) -> Bool {\\n  match e {\\n    ECall(callee, _, _) =>\\n    match callee {\\n      EIdent(f, _) => f == \\\"Array::get\\\" || f == \\\"Map::get\\\" || f == \\\"__index\\\" || f == \\\"__rec_field\\\" || array_contains_str(ctx.borrow_ret_names, f),\\n      _ => false\\n    },\\n    _ => false\\n  }\\n}\\n\\n// Is `e` provably a scalar (Int/Bool) by structure alone — an int/bool literal,\\n// a bitwise/shift/comparison/logical binop, or a logical `!`? Conservative: no\\n// ident-slot/type lookup and no arith ops (+,-,*,/ can be Float). Used to route\\n// an explicit `eq(a, b)` to a direct i64.eq when an operand is provably scalar,\\n// matching how the `==` binop dispatches intish operands (emit_eq_value). Without\\n// this, `eq(int, int)` falls through to the generic bound `eq` whose\\n// `looks_like_string`/str_eq fallback reads OOB on ints resembling fat-pointers\\n// (#678 residual) — e.g. leb128's `eq(val, 0)` trapped under RC (#705).\\nfn cc_arg_is_scalarish(e: Expr) -> Bool with { Error } {\\n  let t = expr_tag(e)\\n  if t == 0 || t == 1 {\\n    true\\n  } else if t == 5 {\\n    let op = get_ebinop_op(e)\\n    op == \\\"&\\\" || op == \\\"|\\\" || op == \\\"^\\\" || op == \\\"<<\\\" || op == \\\">>\\\" || op == \\\"%\\\" || op == \\\"<\\\" || op == \\\">\\\" || op == \\\"<=\\\" || op == \\\">=\\\" || op == \\\"==\\\" || op == \\\"!=\\\" || op == \\\"&&\\\" || op == \\\"||\\\"\\n  } else if t == 6 {\\n    let uop = get_eunaryop_op(e)\\n    // `!x` is Bool; `-x` is scalar iff its operand is (so a negative int literal\\n    // like `-1`, which parses as unary minus of `1`, is detected as scalar).\\n    uop == \\\"!\\\" || (uop == \\\"-\\\" && cc_arg_is_scalarish(get_eunaryop_expr(e)))\\n  } else {\\n    false\\n  }\\n}\\n\\n// #745: local mirror of compile_expr_tail's expr_is_floatish/slot_is_floatish\\n// (importing them here would be a cycle: compile_expr_tail imports this file).\\n// Used to route `eq(a, b)` with a float operand onto the unbox + f64.eq path\\n// under RC — the scalar i64.eq below compares BOX POINTERS for boxed floats,\\n// so `eq(0.0125, 0.0125)` came out false and the assert trapped.\\nfn cc_slot_is_floatish(ctx: CompileCtx, slot: Int) -> Bool {\\n  let arr = ctx.float_local_slots\\n  let mut j = Array::length(arr) - 1\\n  let mut result = false\\n  while j >= 0 {\\n    let entry = Array::get(arr, j)\\n    if entry / 2 == slot {\\n      result = (entry % 2) == 1\\n      j = -1\\n    } else {\\n      j = j - 1\\n    }\\n  }\\n  result\\n}\\n\\nfn cc_expr_is_floatish(e: Expr, local_names: Array[String], ctx: CompileCtx) -> Bool with { Error } {\\n  // fbox (#797): mirror of expr_is_floatish's EDot tuple-projection case --\\n  // `t.N` on a tracked tuple-literal binding recurses into the backing\\n  // ETuple element via the #724 agg log.\\n  let dot_float = match e {\\n    EDot(dobj, dfield, _, _) => {\\n      let fc = String::char_code_at(dfield, 0)\\n      if fc >= 48 && fc <= 57 && is_eident(dobj) {\\n        let slot = find_local_slot(local_names, get_eident_name(dobj))\\n        if slot >= 0 {\\n          let info = agg_slot_lookup(ctx.agg_local_slots, slot)\\n          if info >= 0 && info / 64 == 1 {\\n            let backing = agg_expr_lookup(ctx.agg_local_slots, ctx.agg_local_exprs, slot)\\n            if is_etuple(backing) {\\n              let elems = get_etuple_elems(backing)\\n              let mut k = 0\\n              let mut fp = 0\\n              while fp < String::length(dfield) {\\n                k = k * 10 + (String::char_code_at(dfield, fp) - 48)\\n                fp = fp + 1\\n              }\\n              if k >= 0 && k < Array::length(elems) {\\n                cc_expr_is_floatish(Array::get(elems, k), local_names, ctx)\\n              } else {\\n                false\\n              }\\n            } else {\\n              false\\n            }\\n          } else {\\n            false\\n          }\\n        } else {\\n          false\\n        }\\n      } else {\\n        false\\n      }\\n    },\\n    _ => false\\n  }\\n  let tag = expr_tag(e)\\n  if dot_float {\\n    true\\n  } else if tag == 2 {\\n    true\\n  } else if tag == 4 {\\n    let nm = get_eident_name(e)\\n    let len = Array::length(local_names)\\n    let mut i = len - 1\\n    let mut slot = -1\\n    while i >= 0 {\\n      if Array::get(local_names, i) == nm {\\n        slot = i\\n        i = -1\\n      } else {\\n        i = i - 1\\n      }\\n    }\\n    if slot >= 0 {\\n      cc_slot_is_floatish(ctx, slot)\\n    } else {\\n      false\\n    }\\n  } else if tag == 5 {\\n    let op = get_ebinop_op(e)\\n    if op == \\\"+\\\" || op == \\\"-\\\" || op == \\\"*\\\" || op == \\\"/\\\" {\\n      cc_expr_is_floatish(get_ebinop_lhs(e), local_names, ctx) || cc_expr_is_floatish(get_ebinop_rhs(e), local_names, ctx)\\n    } else {\\n      false\\n    }\\n  } else if tag == 6 {\\n    let op = get_eunaryop_op(e)\\n    if op == \\\"-\\\" {\\n      cc_expr_is_floatish(get_eunaryop_expr(e), local_names, ctx)\\n    } else {\\n      false\\n    }\\n  } else if tag == 8 {\\n    let callee = get_ecall_callee(e)\\n    if is_eident(callee) {\\n      let fname = get_eident_name(callee)\\n      if fname == \\\"Int::to_double\\\" || fname == \\\"Int::to_float\\\" || fname == \\\"Float::to_double\\\" || fname == \\\"Double::to_float\\\" || fname == \\\"Double::from_i64_bits\\\" {\\n        true\\n      } else if fname == \\\"__rec_field\\\" {\\n        // fbox (#797): mirror of expr_is_floatish's tuple-projection case --\\n        // `t.0` on a tracked tuple-literal binding recurses into the backing\\n        // ETuple element via the #724 agg log (heap fields hold raw f64 bits,\\n        // so the reader must recover float-ness statically).\\n        let args = get_ecall_args(e)\\n        if Array::length(args) == 2 && is_eident(Array::get(args, 0)) && expr_tag(Array::get(args, 1)) == 0 {\\n          let slot = find_local_slot(local_names, get_eident_name(Array::get(args, 0)))\\n          if slot >= 0 {\\n            let info = agg_slot_lookup(ctx.agg_local_slots, slot)\\n            if info >= 0 && info / 64 == 1 {\\n              let backing = agg_expr_lookup(ctx.agg_local_slots, ctx.agg_local_exprs, slot)\\n              if is_etuple(backing) {\\n                let elems = get_etuple_elems(backing)\\n                let k = get_eint_value(Array::get(args, 1))\\n                if k >= 0 && k < Array::length(elems) {\\n                  cc_expr_is_floatish(Array::get(elems, k), local_names, ctx)\\n                } else {\\n                  false\\n                }\\n              } else {\\n                false\\n              }\\n            } else {\\n              false\\n            }\\n          } else {\\n            false\\n          }\\n        } else {\\n          false\\n        }\\n      } else {\\n        false\\n      }\\n    } else {\\n      false\\n    }\\n  } else {\\n    false\\n  }\\n}\\n\\n// #950: FIRST-match index of `name` in the func table, or -1 on a miss.\\n// Mirrors resolve_func's scan (first match wins) without throwing, so a\\n// classifier can ask \\\"which entry would actually serve this call?\\\".\\nfn cc_ft_first_idx(ft: FuncTable, name: String) -> Int {\\n  let len = Array::length(ft.names)\\n  let mut i = 0\\n  let mut found = -1\\n  while i < len {\\n    if Array::get(ft.names, i) == name {\\n      found = i\\n      i = len\\n    } else {\\n      i = i + 1\\n    }\\n  }\\n  found\\n}\\n\\n// #950: declared return kind of a call whose callee resolves to a BUILTIN —\\n// 0 = unknown, 1 = Bool, 2 = String. This is the type-directed half of the\\n// interpolation display fix: `\\\"\\\\{String::contains(a, b)}\\\"` printed 1/0 and\\n// `\\\"\\\\{String::join([], \\\"-\\\")}\\\"` printed 0 (the packed empty-string encoding,\\n// misread as Int by __to_string's runtime string-pointer heuristic), because\\n// the display classifiers were purely syntactic and never consulted the\\n// builtin's declared return type.\\n//\\n// Shadow-safety (the reason #784 deliberately skipped name-based\\n// classification): the func table lays out USER functions first (indices\\n// < ctx.num_user_funcs) and appends the registered builtins after them, and\\n// call emission resolves FIRST match (resolve_func) / prefers a bound call\\n// (prefer_bound_call). So the builtin's declared type only applies when the\\n// name is NOT locally bound AND its first func-table match (if any) is NOT a\\n// user function. A user/prelude shadow therefore classifies as 0 (unknown),\\n// exactly matching what the actual call emission dispatches to. Name sets\\n// mirror the checker's declared types (checker/checker.vibe\\n// direct_builtin_return / codegen/builtin_registry.vibe).\\nexport fn cc_builtin_call_ret_kind(e: Expr, local_names: Array[String], ctx: CompileCtx) -> Int with { Error } {\\n  if expr_tag(e) == 8 {\\n    let bcallee = get_ecall_callee(e)\\n    if is_eident(bcallee) {\\n      let bn = canonical_builtin_name(get_eident_name(bcallee))\\n      let kind = if bn == \\\"eq\\\" || bn == \\\"not\\\" || bn == \\\"String::equals\\\" || bn == \\\"String::contains\\\" || bn == \\\"String::starts_with\\\" || bn == \\\"String::ends_with\\\" || bn == \\\"Array::contains\\\" || bn == \\\"Array::any\\\" || bn == \\\"Array::all\\\" || bn == \\\"Map::has_key\\\" || bn == \\\"Map::has\\\" || bn == \\\"map_has\\\" || bn == \\\"Path::is_absolute\\\" || bn == \\\"Fs::exists\\\" || bn == \\\"Fs::is_dir\\\" || bn == \\\"Fs::is_file\\\" {\\n        1\\n      } else if bn == \\\"__to_string\\\" || bn == \\\"Int::to_string\\\" || bn == \\\"Double::to_string\\\" || bn == \\\"Float::to_string\\\" || bn == \\\"String::concat\\\" || bn == \\\"String::substring\\\" || bn == \\\"String::trim\\\" || bn == \\\"String::from_char_code\\\" || bn == \\\"String::join\\\" || bn == \\\"Env::get\\\" || bn == \\\"Env::args_get\\\" || bn == \\\"Fs::read_file\\\" || bn == \\\"Fs::getcwd\\\" || bn == \\\"sh\\\" {\\n        2\\n      } else {\\n        0\\n      }\\n      if kind == 0 {\\n        0\\n      } else if find_local_slot(local_names, bn) >= 0 {\\n        0\\n      } else {\\n        let fi = cc_ft_first_idx(ctx.func_table, bn)\\n        if fi >= 0 && fi < ctx.num_user_funcs {\\n          0\\n        } else {\\n          kind\\n        }\\n      }\\n    } else {\\n      0\\n    }\\n  } else {\\n    0\\n  }\\n}\\n\\n// #950: is `e` statically a String? The stringish sibling of\\n// cc_expr_is_boolish below (same structure, same slot-log discipline: kind-2\\n// entries in ctx.int_local_slots track `let`-bound strings, see\\n// compile_expr_tail's slot_is_intish doc). Consumed by the `__to_string`\\n// dispatch: a statically-String segment IS the result, so it bypasses the\\n// runtime string-pointer heuristic — which misreads the packed empty-string\\n// encoding 0 (e.g. `String::join([], sep)`, ptr 0 / len 0) as Int 0 and\\n// printed \\\"0\\\" for a perfectly legal empty string.\\nexport fn cc_expr_is_stringish(e: Expr, local_names: Array[String], ctx: CompileCtx) -> Bool with { Error } {\\n  let tag = expr_tag(e)\\n  if tag == 3 {\\n    true\\n  } else if tag == 4 {\\n    // A bare ident `let`-bound to a stringish value — kind-2 entry in\\n    // ctx.int_local_slots (slot*4 + kind). Same scan as the boolish kind-3\\n    // lookup below.\\n    let nm = get_eident_name(e)\\n    let mut i = Array::length(local_names) - 1\\n    let mut slot = -1\\n    while i >= 0 {\\n      if Array::get(local_names, i) == nm {\\n        slot = i\\n        i = -1\\n      } else {\\n        i = i - 1\\n      }\\n    }\\n    if slot >= 0 {\\n      let arr = ctx.int_local_slots\\n      let mut j = Array::length(arr) - 1\\n      let mut result = false\\n      while j >= 0 {\\n        let entry = Array::get(arr, j)\\n        if entry / 4 == slot {\\n          result = (entry % 4) == 2\\n          j = -1\\n        } else {\\n          j = j - 1\\n        }\\n      }\\n      result\\n    } else {\\n      false\\n    }\\n  } else if tag == 9 {\\n    cc_expr_is_stringish(get_elet_body(e), local_names, ctx)\\n  } else if tag == 10 {\\n    cc_expr_is_stringish(get_eletrec_body(e), local_names, ctx)\\n  } else if tag == 11 {\\n    cc_expr_is_stringish(get_eletmut_body(e), local_names, ctx)\\n  } else if tag == 14 {\\n    cc_expr_is_stringish(get_eseq_second(e), local_names, ctx)\\n  } else if tag == 7 {\\n    cc_expr_is_stringish(get_eif_then(e), local_names, ctx) && cc_expr_is_stringish(get_eif_else(e), local_names, ctx)\\n  } else if tag == 16 {\\n    let arms = get_match_arms(e)\\n    let alen2 = Array::length(arms)\\n    if alen2 == 0 {\\n      false\\n    } else {\\n      let mut all_str = true\\n      let mut si2 = 0\\n      while si2 < alen2 {\\n        if !cc_expr_is_stringish(get_arm_body(Array::get(arms, si2)), local_names, ctx) {\\n          all_str = false\\n        } else {\\n          ()\\n        }\\n        si2 = si2 + 1\\n      }\\n      all_str\\n    }\\n  } else if tag == 8 {\\n    let bcallee = get_ecall_callee(e)\\n    if is_efn(bcallee) && Array::length(get_ecall_args(e)) == 1 {\\n      // `let s: String = e` ascription marker `((__asc: String) -> __asc)(e)`\\n      // — honor the annotation (same shapes as the Bool arm in\\n      // cc_expr_is_boolish below, incl. the uniquify-renamed form).\\n      let fparams = get_efn_params(bcallee)\\n      if Array::length(fparams) == 1 {\\n        let (asc_name, asc_ty) = Array::get(fparams, 0)\\n        (asc_name == \\\"__asc\\\" || (String::starts_with(asc_name, \\\"__shadow_\\\") && String::ends_with(asc_name, \\\"___asc\\\"))) && (match asc_ty {\\n          Some(TyName(tn)) => tn == \\\"String\\\",\\n          _ => false\\n        })\\n      } else {\\n        false\\n      }\\n    } else {\\n      cc_builtin_call_ret_kind(e, local_names, ctx) == 2\\n    }\\n  } else {\\n    false\\n  }\\n}\\n\\n// #784: is `e` statically — BY SHAPE — a Bool via an UNSHADOWABLE form? A bool\\n// literal, a comparison / logical binary op, or a `!` unary. These lower directly\\n// (operators bypass name resolution) so the classification is always correct.\\n// Used to route `\\\"\\\\{b}\\\"` / `__to_string(b)` to a \\\"true\\\"/\\\"false\\\" formatter instead\\n// of the integer path (which prints 1/0, since Bool and Int share the tagged-int\\n// runtime representation). Purely syntactic, like `cc_expr_is_floatish`.\\n//\\n// #950: calls to bool-returning BUILTINS are now classified through\\n// cc_builtin_call_ret_kind (see the tag-8 arm), which checks the same\\n// user-shadow conditions the actual call emission honors via\\n// `prefer_bound_call` — closing the gap #784 documented (a name-only match\\n// would have misformatted a shadowed function's result; the shadow-aware\\n// lookup does not). A bool bound to a local and then interpolated is covered\\n// by the kind-3 slot log. Never fires for an integer expression, so the\\n// pervasive `__to_string(<int>)` calls (lengths, offsets, ids) are untouched.\\nfn cc_expr_is_boolish(e: Expr, local_names: Array[String], ctx: CompileCtx) -> Bool with { Error } {\\n  let tag = expr_tag(e)\\n  if tag == 1 {\\n    true\\n  } else if tag == 4 {\\n    // #769: a bare ident `let`-bound to a boolish value -- kind-3 entry in\\n    // ctx.int_local_slots (slot*4 + kind, see compile_expr_tail's\\n    // slot_is_intish). Closes the documented #785-P2 gap where\\n    // `let b = true; \\\"\\\\{b}\\\"` printed the raw integer. Duplicated slot scan\\n    // (expr_is_boolish lives in compile_expr_tail, which imports this file --\\n    // importing back would be circular).\\n    let nm = get_eident_name(e)\\n    let mut i = Array::length(local_names) - 1\\n    let mut slot = -1\\n    while i >= 0 {\\n      if Array::get(local_names, i) == nm {\\n        slot = i\\n        i = -1\\n      } else {\\n        i = i - 1\\n      }\\n    }\\n    if slot >= 0 {\\n      let arr = ctx.int_local_slots\\n      let mut j = Array::length(arr) - 1\\n      let mut result = false\\n      while j >= 0 {\\n        let entry = Array::get(arr, j)\\n        if entry / 4 == slot {\\n          result = (entry % 4) == 3\\n          j = -1\\n        } else {\\n          j = j - 1\\n        }\\n      }\\n      result\\n    } else {\\n      false\\n    }\\n  } else if tag == 5 {\\n    let op = get_ebinop_op(e)\\n    op == \\\"==\\\" || op == \\\"!=\\\" || op == \\\"<\\\" || op == \\\">\\\" || op == \\\"<=\\\" || op == \\\">=\\\" || op == \\\"&&\\\" || op == \\\"||\\\"\\n  } else if tag == 6 {\\n    get_eunaryop_op(e) == \\\"!\\\"\\n  } else if tag == 16 {\\n    // #815: an `is` expression desugars at parse time to a match whose arms\\n    // all return Bool literals — classify such a match as boolish so\\n    // `\\\"\\\\{opt is None}\\\"` prints true/false instead of the raw 0/1.\\n    // #825: arm bodies recurse through cc_expr_is_boolish (not just Bool\\n    // literals), because the structural `==` dispatch on Option/Result/tuple\\n    // lowers to nested matches whose leaf arms are `==`/`&&` chains and Bool\\n    // literals — so `\\\"\\\\{Some(1) == Some(1)}\\\"` prints true, not 1.\\n    let arms = get_match_arms(e)\\n    let alen2 = Array::length(arms)\\n    if alen2 == 0 {\\n      false\\n    } else {\\n      let mut all_bool = true\\n      let mut bi2 = 0\\n      while bi2 < alen2 {\\n        if !cc_expr_is_boolish(get_arm_body(Array::get(arms, bi2)), local_names, ctx) {\\n          all_bool = false\\n        } else {\\n          ()\\n        }\\n        bi2 = bi2 + 1\\n      }\\n      all_bool\\n    }\\n  } else if tag == 9 {\\n    // #825: the normalize pass lifts a non-ident match scrutinee into\\n    // `let __m_scrut_N = <e> in match ...` (lift_match_scrutinees), so a\\n    // boolish match arrives here wrapped in a let — classify by the BODY.\\n    // Same for the other body-position wrappers below.\\n    cc_expr_is_boolish(get_elet_body(e), local_names, ctx)\\n  } else if tag == 10 {\\n    cc_expr_is_boolish(get_eletrec_body(e), local_names, ctx)\\n  } else if tag == 11 {\\n    cc_expr_is_boolish(get_eletmut_body(e), local_names, ctx)\\n  } else if tag == 14 {\\n    cc_expr_is_boolish(get_eseq_second(e), local_names, ctx)\\n  } else if tag == 7 {\\n    // An if-expression is boolish when BOTH branches are.\\n    cc_expr_is_boolish(get_eif_then(e), local_names, ctx) && cc_expr_is_boolish(get_eif_else(e), local_names, ctx)\\n  } else if tag == 8 {\\n    // #815: the `==` desugar rewrites array equality to the compiler-emitted\\n    // `__arr_equals__<key>` helper and struct/enum equality to `T::equals`\\n    // (both Bool-returning), so the EBinOp shape above is gone by codegen.\\n    // `__arr_equals__` is a reserved compiler prefix; `::equals` (2 args) is\\n    // the == rewrite's exact output shape. A `not(...)` wrap (the `!=`\\n    // rewrite's output) is classified only when its single argument is itself\\n    // boolish AND `not` is not locally shadowed (display-only risk, see the\\n    // expr_is_boolish twin in compile_expr_tail.vibe).\\n    let bcallee = get_ecall_callee(e)\\n    if is_eident(bcallee) {\\n      let bcn = get_eident_name(bcallee)\\n      String::starts_with(bcn, \\\"__arr_equals__\\\") || (String::ends_with(bcn, \\\"::equals\\\") && Array::length(get_ecall_args(e)) == 2) || (bcn == \\\"not\\\" && Array::length(get_ecall_args(e)) == 1 && find_local_slot(local_names, \\\"not\\\") < 0 && cc_expr_is_boolish(Array::get(get_ecall_args(e), 0), local_names, ctx)) || cc_builtin_call_ret_kind(e, local_names, ctx) == 1\\n    } else if is_efn(bcallee) && Array::length(get_ecall_args(e)) == 1 {\\n      // #815: `let x: Bool = e` parses to the ascription marker\\n      // `((__asc: Bool) -> __asc)(e)` (see parser_expr_dispatch's\\n      // ascribe_wrap) — honor the annotation so the binding's slot is logged\\n      // boolish even when `e` itself is opaque.\\n      // The SECOND and later ascriptions in one function arrive with the\\n      // param renamed to `__shadow_<n>___asc` (normalize's\\n      // uniquify_shadowed_bindings; per-function `seen` de-dup), so match\\n      // that renamed form too — otherwise only the first annotated let per\\n      // function was classified (#825 follow-up).\\n      let fparams = get_efn_params(bcallee)\\n      if Array::length(fparams) == 1 {\\n        let (asc_name, asc_ty) = Array::get(fparams, 0)\\n        (asc_name == \\\"__asc\\\" || (String::starts_with(asc_name, \\\"__shadow_\\\") && String::ends_with(asc_name, \\\"___asc\\\"))) && (match asc_ty {\\n          Some(TyName(tn)) => tn == \\\"Bool\\\",\\n          _ => false\\n        })\\n      } else {\\n        false\\n      }\\n    } else {\\n      false\\n    }\\n  } else {\\n    false\\n  }\\n}\\n\\n// #706: is `e` a bare reference to a value live-in to an enclosing loop (and not\\n// a `mut` ref-cell, whose reassignment already manages its own drop)? Passing\\n// such a value to a consuming (owning) parameter inside the loop frees it on the\\n// first iteration; dup'ing at the call site keeps the loop-carried reference\\n// alive across the back-edge. rc_dup is a no-op on scalars, so a scalar loop var\\n// caught here costs only a wasted (guarded) dup, not a correctness problem.\\nexport fn cc_is_loop_borrowed_ident(e: Expr, ctx: CompileCtx) -> Bool {\\n  match e {\\n    EIdent(name, _) =>\\n    array_contains_str(ctx.loop_borrowed_names, name) && !array_contains_str(ctx.ref_cell_names, name),\\n    _ => false\\n  }\\n}\\n\\n// Builtins whose arg0 is BORROWED (read in place, not consumed/dropped). Kept in\\n// sync with `is_borrow_arg0_call` in perceus/index.vibe — a projection passed as\\n// arg0 to one of these must NOT be rc_dup'd at the call site (the callee never\\n// drops it, so the dup would leak; #704). Other argument positions are owning.\\nfn cc_is_borrow_arg0_call(f: String) -> Bool {\\n  f == \\\"__index\\\" || f == \\\"Array::get\\\" || f == \\\"Array::length\\\" || f == \\\"Array::set\\\" || f == \\\"Array::push\\\" || f == \\\"ArrayBuilder::push\\\" || f == \\\"StringBuilder::push\\\" || f == \\\"MapBuilder::set\\\" || f == \\\"Map::get\\\" || f == \\\"Map::keys\\\" || f == \\\"Map::has_key\\\" || f == \\\"Map::has\\\" || f == \\\"Map::set\\\" || f == \\\"Map::size\\\" || f == \\\"Map::values\\\" || f == \\\"Map::delete\\\" || f == \\\"Bytes::push\\\" || f == \\\"Bytes::set\\\" || f == \\\"Bytes::get\\\" || f == \\\"Bytes::length\\\" || f == \\\"__rec_field\\\"\\n}\\n\\n// #745: retain a borrowed argument that a STORING inline builtin (Map::set /\\n// MapBuilder::set key+value) keeps a reference to. The generic owning-call\\n// path already dups projection / borrow-returning-call / loop-borrowed args\\n// (see the `__argdup` sites below), but the inline-emitted builtins compile\\n// their args directly and skipped it — json's `build_json_map` stored\\n// `Array::get(vals, i)` un-retained, and once `vals` died the map's entry\\n// pointed at freed memory (ctor match on `Map::get` then read garbage).\\n// Expects the freshly compiled arg on the wasm stack; leaves it there.\\nfn cc_retain_stored_arg(buf: Bytes, carg: Expr, local_names: Array[String], nl: Int, ctx: CompileCtx) -> Int with { Error } {\\n  let is_loop_borrow = ctx.enable_rc && cc_is_loop_borrowed_ident(carg, ctx)\\n  if ctx.enable_rc && (cc_is_projection(carg) || cc_is_borrow_ret_call(carg, ctx) || is_loop_borrow) {\\n    // #706 leak follow-up: a loop-borrowed trigger needs the epilogue's\\n    // compensating drop, same as the generic path's `__argdup` sites.\\n    if is_loop_borrow {\\n      Array::push(ctx.loop_consumed_names, get_eident_name(carg))\\n    } else {\\n      ()\\n    }\\n    Array::push(local_names, \\\"__argdup\\\")\\n    emit_local_tee(buf, nl)\\n    emit_rc_dup_guarded(buf, nl, ctx.rc_shadow)\\n    nl + 1\\n  } else {\\n    nl\\n  }\\n}\\n\\n// #664/#678: is `e` statically — BY SHAPE — a known integer that must NOT be run\\n// through `__to_string`'s string-pointer heuristic (which misreads a large int\\n// as an empty string)? An Int literal, or a bitwise/shift/mod expression (those\\n// operators are never float or string). Bare idents are deliberately excluded:\\n// a per-slot \\\"is int\\\" log is unsound because slots are reused across scopes\\n// without updating it. Covers `\\\"\\\\{1 << 40}\\\"` and integer-literal interpolation.\\nfn ts_known_int(e: Expr, local_names: Array[String], ctx: CompileCtx) -> Bool {\\n  let tag = expr_tag(e)\\n  if tag == 0 {\\n    true\\n  } else if tag == 5 {\\n    let op = get_ebinop_op(e)\\n    op == \\\"&\\\" || op == \\\"|\\\" || op == \\\"^\\\" || op == \\\"<<\\\" || op == \\\">>\\\" || op == \\\"%\\\"\\n  } else if tag == 8 {\\n    // #769 (#664 follow-up): a DIRECT call to a known Int-returning builtin is\\n    // statically an Int -- force the integer path. The #664 runtime bound\\n    // (`ptr + len <= memory_size`) is load-dependent: once the process has\\n    // grown to hundreds of MB (a cold full-closure FS compile), a 61-bit\\n    // `Fs::stat_token` hash whose high word lands below memory_size and whose\\n    // low word keeps ptr+len in bounds passes the string-pointer heuristic and\\n    // is emitted as GARBAGE BYTES (observed: a deterministic ~100MB\\n    // persistent-source-groups cache row for one specific file, \\\"invalid\\n    // persistent source group cache group row\\\" on re-read). The bound can\\n    // never be airtight for 61-bit hashes; static knowledge is.\\n    match get_ecall_callee(e) {\\n      EIdent(cn, _) => cn == \\\"Fs::stat_token\\\" || cn == \\\"vibe_fs_stat_token_raw\\\" || cn == \\\"Profiler::now_us\\\" || cn == \\\"Profiler::heap_bytes\\\" || cn == \\\"Env::args_len\\\" || cn == \\\"String::length\\\" || cn == \\\"Array::length\\\" || cn == \\\"Bytes::length\\\" || cn == \\\"String::char_code_at\\\" || cn == \\\"String::index_of\\\" || cn == \\\"String::last_index_of\\\" || cn == \\\"Stdin::read_char\\\",\\n      _ => false\\n    }\\n  } else {\\n    false\\n  }\\n}\\n\\n// A synthesized `EString` literal is NOT in the compile unit's string table\\n// (same constraint double_to_string_expr documents) — a flag label is only\\n// known at codegen time, so it can't have been pre-interned like a literal\\n// from the original source. Build it char-by-char via `String::from_char_code`\\n// + `String::concat` instead, exactly like double_to_string_expr's `ch_minus`\\n// / `ch_dot` pieces. `s` must be non-empty (callers only pass \\\" -<label>\\\").\\nfn uninterned_string_expr(s: String, i: Int) -> Expr {\\n  let ch = ECall(EIdent(\\\"String::from_char_code\\\", -1), [\\n    EInt(String::char_code_at(s, i))\\n  ], -1)\\n  if i >= String::length(s) - 1 {\\n    ch\\n  } else {\\n    ECall(EIdent(\\\"String::concat\\\", -1), [\\n      ch,\\n      uninterned_string_expr(s, i + 1)\\n    ], -1)\\n  }\\n}\\n\\n// #777: `sh_lines(cmd, flag1 = boolExpr1, flag2 = boolExpr2, ...)` — extra\\n// labeled boolean args (beyond the command string) become `-<label>`\\n// appended to the command when the labeled expression is true, so callers\\n// can write `sh_lines(\\\"ls\\\", a = true)` instead of building the flag string\\n// by hand. NOTE: argument labels are NOT part of a general keyword-argument\\n// feature here — labels are purely decorative for ordinary calls (args\\n// still bind positionally), so this reads the literal label text directly\\n// off the `ELabeledArg` AST node rather than relying on any label-based\\n// rebinding machinery (there isn't one).\\nfn sh_lines_flag_cmd(acc: Expr, args: Array[Expr], i: Int) -> Expr {\\n  if i >= Array::length(args) {\\n    acc\\n  } else {\\n    let next_acc = match Array::get(args, i) {\\n      ELabeledArg(label, _, cond) => EIf(cond, ECall(EIdent(\\\"String::concat\\\", -1), [\\n        acc,\\n        uninterned_string_expr(String::concat(\\\" -\\\", label), 0)\\n      ], -1), acc),\\n      _ => acc\\n    }\\n    sh_lines_flag_cmd(next_acc, args, i + 1)\\n  }\\n}\\n\\nexport fn compile_call(buf: Bytes, callee: Expr, args: Array[Expr], local_names: Array[String], next_local: Int, ctx: CompileCtx, ld: Int, ce: (Bytes, Expr, Array[String], Int, CompileCtx, Int) -> Int with { Error }) -> Int with { Error } {\\n  if is_eident(callee) {\\n    let fname0 = canonical_builtin_name(get_eident_name(callee))\\n    // Stream[T] (docs/spec/wasi-p3-async.md §2.4) is backed by the eager Array\\n    // machinery on the linear backend: map/fold reuse the existing inline\\n    // Array::map / Array::fold lowering verbatim (same arg order, same value\\n    // representation). empty/once/filter are handled explicitly below.\\n    let fname = if fname0 == \\\"Stream::map\\\" {\\n      \\\"Array::map\\\"\\n    } else if fname0 == \\\"Stream::fold\\\" {\\n      \\\"Array::fold\\\"\\n    } else {\\n      fname0\\n    }\\n    let fn_len2 = Array::length(ctx.func_table.names)\\n    let mut fn_idx_in_list = -1\\n    let mut __tr_j = 0\\n    while __tr_j < fn_len2 {\\n      if Array::get(ctx.func_table.names, __tr_j) == fname {\\n        fn_idx_in_list = __tr_j\\n        __tr_j = fn_len2\\n      } else {\\n        __tr_j = __tr_j + 1\\n      }\\n    }\\n    let mut local_idx_hint = -1\\n    let mut li = Array::length(local_names) - 1\\n    while li >= 0 {\\n      if Array::get(local_names, li) == fname {\\n        local_idx_hint = li\\n        li = -1\\n      } else {\\n        li = li - 1\\n      }\\n    }\\n    let prefer_bound_call = fn_idx_in_list >= 0 || local_idx_hint >= 0\\n    let ctor_lookup_idx = ctor_table_index_of(ctx.ctor_table, fname)\\n    if ctor_lookup_idx >= 0 {\\n      let tag = Array::get(ctx.ctor_table.tags, ctor_lookup_idx)\\n      let fc = Array::get(ctx.ctor_table.field_counts, ctor_lookup_idx)\\n      let ptr_local = next_local\\n      Array::push(local_names, \\\"__ctor_ptr\\\")\\n      let actual_args = if Array::length(args) == 1 {\\n        match Array::get(args, 0) {\\n          ERecord(_, rec_fields, _) => {\\n            let mut si2 = 0\\n            let mut sn_idx = -1\\n            while si2 < Array::length(ctx.ctor_table.struct_names) {\\n              if Array::get(ctx.ctor_table.struct_names, si2) == fname {\\n                sn_idx = si2\\n                si2 = Array::length(ctx.ctor_table.struct_names)\\n              } else {\\n                si2 = si2 + 1\\n              }\\n            }\\n            if sn_idx >= 0 {\\n              let def_fnames = Array::get(ctx.ctor_table.struct_field_names, sn_idx)\\n              let ordered = Array::slice([\\n                EUnit\\n              ], 0, 0)\\n              let mut oi = 0\\n              while oi < Array::length(def_fnames) {\\n                let target_name = Array::get(def_fnames, oi)\\n                let mut ri = 0\\n                let mut found_rfv = EUnit\\n                while ri < Array::length(rec_fields) {\\n                  let (rfn, rfv) = Array::get(rec_fields, ri)\\n                  if rfn == target_name {\\n                    found_rfv = rfv\\n                    ri = Array::length(rec_fields)\\n                  } else {\\n                    ri = ri + 1\\n                  }\\n                }\\n                Array::push(ordered, found_rfv)\\n                oi = oi + 1\\n              }\\n              ordered\\n            } else {\\n              args\\n            }\\n          },\\n          _ => args\\n        }\\n      } else {\\n        args\\n      }\\n      if ctx.enable_rc {\\n        let total = 16 + fc * 8\\n        emit_i64_const(buf, total)\\n        emit_call(buf, ctx.rc_alloc_func_idx)\\n        emit_local_set(buf, ptr_local)\\n        emit_local_get(buf, ptr_local)\\n        emit_i32_wrap_i64(buf)\\n        emit_i32_const(buf, total)\\n        emit_i32_store(buf, 2, 0)\\n        emit_local_get(buf, ptr_local)\\n        emit_i32_wrap_i64(buf)\\n        emit_i32_const(buf, 1)\\n        emit_i32_store(buf, 2, 4)\\n        emit_local_get(buf, ptr_local)\\n        emit_i32_wrap_i64(buf)\\n        emit_i32_const(buf, 1)\\n        emit_i32_store8(buf, 0, 7)\\n        emit_local_get(buf, ptr_local)\\n        emit_i32_wrap_i64(buf)\\n        emit_i32_const(buf, tag)\\n        emit_i32_store(buf, 2, 8)\\n        emit_local_get(buf, ptr_local)\\n        emit_i32_wrap_i64(buf)\\n        emit_i32_const(buf, fc)\\n        emit_i32_store(buf, 2, 12)\\n        let mut nl_c = next_local + 1\\n        let mut fi_c = 0\\n        while fi_c < Array::length(actual_args) {\\n          let carg_c = Array::get(actual_args, fi_c)\\n          nl_c = ce(buf, carg_c, local_names, nl_c, ctx, ld)\\n          let val_local = nl_c\\n          Array::push(local_names, \\\"__ctor_val\\\")\\n          emit_local_set(buf, val_local)\\n          nl_c = nl_c + 1\\n          // A heap field projection `a.f` stored into a constructor is a borrow;\\n          // the constructed value OWNS its fields (drop class 1 recurses), so\\n          // retain it or the source's drop double-frees it (e.g. `Some(b.items)`\\n          // returned while `b` is dropped). Mirrors the ERecord field-store dup\\n          // (#704). Perceus emits no action for bare projections.\\n          // #715: also retain a bare-ident arg whose binding is borrow-bound or\\n          // loop-borrowed (cc_is_loop_borrowed_ident) -- same gap as the ETuple\\n          // case in compile_expr_tail2.vibe (see the comment there).\\n          if ctx.enable_rc && (cc_is_projection(carg_c) || cc_is_borrow_ret_call(carg_c, ctx) || cc_is_loop_borrowed_ident(carg_c, ctx)) {\\n            emit_rc_dup_guarded(buf, val_local, ctx.rc_shadow)\\n          } else {\\n            ()\\n          }\\n          emit_local_get(buf, ptr_local)\\n          emit_i32_wrap_i64(buf)\\n          emit_local_get(buf, val_local)\\n          emit_i64_store(buf, 3, 16 + fi_c * 8)\\n          fi_c = fi_c + 1\\n        }\\n        emit_local_get(buf, ptr_local)\\n        emit_i64_const(buf, 8)\\n        emit_i64_add(buf)\\n        emit_i64_const(buf, 1)\\n        emit_i64_or(buf)\\n        nl_c\\n      } else {\\n        let obj_size = 8 + fc * 8\\n        emit_global_get(buf, 0)\\n        emit_i64_extend_i32_u(buf)\\n        emit_local_set(buf, ptr_local)\\n        emit_global_get(buf, 0)\\n        emit_i32_const(buf, obj_size)\\n        emit_i32_add(buf)\\n        emit_global_set(buf, 0)\\n        emit_heap_grow_after_heap_set(buf, ctx)\\n        emit_local_get(buf, ptr_local)\\n        emit_i32_wrap_i64(buf)\\n        emit_i32_const(buf, tag)\\n        emit_i32_store(buf, 2, 0)\\n        emit_local_get(buf, ptr_local)\\n        emit_i32_wrap_i64(buf)\\n        emit_i32_const(buf, fc)\\n        emit_i32_store(buf, 2, 4)\\n        let mut nl_c = next_local + 1\\n        let mut fi_c = 0\\n        while fi_c < Array::length(actual_args) {\\n          nl_c = ce(buf, Array::get(actual_args, fi_c), local_names, nl_c, ctx, ld)\\n          let val_local = nl_c\\n          Array::push(local_names, \\\"__ctor_val\\\")\\n          emit_local_set(buf, val_local)\\n          nl_c = nl_c + 1\\n          emit_local_get(buf, ptr_local)\\n          emit_i32_wrap_i64(buf)\\n          emit_local_get(buf, val_local)\\n          emit_i64_store(buf, 3, 8 + fi_c * 8)\\n          fi_c = fi_c + 1\\n        }\\n        emit_local_get(buf, ptr_local)\\n        emit_i64_const(buf, 1)\\n        emit_i64_or(buf)\\n        nl_c\\n      }\\n    }\\n    else if fname == \\\"eq\\\" && Array::length(args) == 2 && ctx.enable_rc && (cc_expr_is_floatish(Array::get(args, 0), local_names, ctx) || cc_expr_is_floatish(Array::get(args, 1), local_names, ctx)) {\\n      // #745: under RC floats are BOXED — the scalar i64.eq below would\\n      // compare box pointers, so `eq(0.0125, 0.0125)` returned false. Take\\n      // the same unbox + f64.eq path the `==` binop uses. Non-RC floats are\\n      // raw f64 bits in an i64, where bitwise i64.eq matches the existing\\n      // `==` behavior, so this branch is RC-only.\\n      let mut nl = ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)\\n      emit_unbox_float(buf)\\n      emit_f64_reinterpret_i64(buf)\\n      nl = ce(buf, Array::get(args, 1), local_names, nl, ctx, ld)\\n      emit_unbox_float(buf)\\n      emit_f64_reinterpret_i64(buf)\\n      emit_f64_eq(buf)\\n      emit_i64_extend_i32_s(buf)\\n      // Tag the Bool like the scalar branch below (ADR-0055).\\n      emit_i64_const(buf, 1)\\n      emit_i64_shl(buf)\\n      nl\\n    }\\n    else if fname == \\\"eq\\\" && Array::length(args) == 2 && (!prefer_bound_call || cc_arg_is_scalarish(Array::get(args, 0)) || cc_arg_is_scalarish(Array::get(args, 1))) {\\n      // Direct i64.eq for `eq(a, b)` when it is the builtin and at least one\\n      // operand is provably scalar. This sidesteps the bound `eq`'s string\\n      // fallback, which reads OOB on Int values resembling fat-pointers (#705):\\n      // `==` already dispatches intish operands this way via emit_eq_value, and\\n      // `eq` must match. A genuinely string/heap `eq` (no scalar operand) still\\n      // falls through to the bound call below.\\n      //\\n      // #710/#711: keeping the scalarish disjunct (not just !prefer_bound_call)\\n      // is required -- prefer_bound_call is a global cross-file name match, not\\n      // scoped to the calling file (see #711), so dropping it regressed\\n      // leb128_test.vibe. Root fix tracked in #711.\\n      let mut nl = ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)\\n      nl = ce(buf, Array::get(args, 1), local_names, nl, ctx, ld)\\n      emit_i64_eq(buf)\\n      emit_i64_extend_i32_s(buf)\\n      // ADR-0055: under RC a Bool is a TAGGED scalar (true = 1<<1). The raw\\n      // i64.eq result is 0/1 (untagged); tag it so `eq(..) == true`/`if`/derived\\n      // comparisons see the same representation as a bool literal (#705 — without\\n      // this, `eq(a,b) == true` compared untagged 1 against tagged 2 and failed).\\n      // The bump backend leaves bools untagged, so only shift under RC.\\n      if ctx.enable_rc {\\n        emit_i64_const(buf, 1)\\n        emit_i64_shl(buf)\\n      } else {\\n        ()\\n      }\\n      nl\\n    }\\n    else if !prefer_bound_call && fname == \\\"not\\\" {\\n      let nl = ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)\\n      emit_i64_eqz(buf)\\n      emit_i64_extend_i32_s(buf)\\n      if ctx.enable_rc {\\n        emit_i64_const(buf, 1)\\n        emit_i64_shl(buf)\\n      } else {\\n        ()\\n      }\\n      nl\\n    }\\n    else if !prefer_bound_call && fname == \\\"await\\\" {\\n      // M1b-3b (docs/spec/wasi-p3-async.md): awaiting a ready future yields the\\n      // value directly (ready-future fast path). Real blocking future.read for\\n      // async sources (host async imports / spawned subtasks) is M1b-3c.\\n      ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)\\n    }\\n    else if !prefer_bound_call && fname == \\\"Future::ready\\\" {\\n      // Future::ready(x) carries x directly — no canon future is created for an\\n      // already-resolved value.\\n      ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)\\n    }\\n    else if !prefer_bound_call && fname == \\\"Task::spawn\\\" {\\n      // Structured concurrency, synchronous model (docs/spec/wasi-p3-async.md\\n      // §2.5): on the single-threaded linear backend a spawned task runs its\\n      // thunk eagerly, so the Task[T] value *is* the resolved result. `join`\\n      // is then identity and `cancel` a no-op. Real subtask spawn over\\n      // waitable-set / future.cancel is documented future work.\\n      let nl = ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)\\n      let fn_l = nl\\n      let slot_l = nl + 1\\n      let env_l = nl + 2\\n      Array::push(local_names, \\\"__spawn_fn\\\")\\n      Array::push(local_names, \\\"__spawn_slot\\\")\\n      Array::push(local_names, \\\"__spawn_env\\\")\\n      emit_local_set(buf, fn_l)\\n      emit_closure_resolve(buf, fn_l, slot_l, env_l)\\n      emit_closure_call_tail(buf, env_l, slot_l, 9, 0)\\n      nl + 3\\n    }\\n    else if !prefer_bound_call && fname == \\\"Task::join\\\" {\\n      // The task already holds its resolved value (eager spawn) — join is the\\n      // identity projection onto that value.\\n      ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)\\n    }\\n    else if !prefer_bound_call && fname == \\\"Task::cancel\\\" {\\n      // The eager task has already completed; cancel evaluates the handle for\\n      // its effects, drops it, and yields Unit.\\n      let nl = ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)\\n      emit_drop(buf)\\n      emit_i64_const(buf, 0)\\n      nl\\n    }\\n    else if !prefer_bound_call && fname == \\\"Task::race\\\" {\\n      // Both tasks are already resolved under the eager model; race resolves to\\n      // the first task's value. (b is evaluated for its effects, then dropped.)\\n      let mut nl = ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)\\n      nl = ce(buf, Array::get(args, 1), local_names, nl, ctx, ld)\\n      emit_drop(buf)\\n      nl\\n    }\\n    else if !prefer_bound_call && fname == \\\"Stream::empty\\\" {\\n      // Empty stream = empty backing array.\\n      let (arr_new_fi, _, _) = resolve_func(ctx.func_table, \\\"array_new\\\")\\n      emit_call(buf, arr_new_fi)\\n      next_local\\n    }\\n    else if !prefer_bound_call && fname == \\\"Stream::once\\\" {\\n      // Singleton stream = one-element backing array.\\n      let (arr_new_fi, _, _) = resolve_func(ctx.func_table, \\\"array_new\\\")\\n      let (arr_push_fi, _, _) = resolve_func(ctx.func_table, \\\"Array::push\\\")\\n      let nl = ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)\\n      let val_l = nl\\n      let arr_l = nl + 1\\n      Array::push(local_names, \\\"__once_val\\\")\\n      Array::push(local_names, \\\"__once_arr\\\")\\n      emit_local_set(buf, val_l)\\n      emit_call(buf, arr_new_fi)\\n      emit_local_set(buf, arr_l)\\n      emit_local_get(buf, arr_l)\\n      emit_local_get(buf, val_l)\\n      emit_call(buf, arr_push_fi)\\n      emit_local_get(buf, arr_l)\\n      nl + 2\\n    }\\n    else if !prefer_bound_call && fname == \\\"Stream::filter\\\" {\\n      // Eager filter: walk the backing array, keep elements whose predicate is\\n      // truthy. Mirrors the Array::map loop but pushes conditionally.\\n      let (arr_new_fi, _, _) = resolve_func(ctx.func_table, \\\"array_new\\\")\\n      let (arr_len_fi, _, _) = resolve_func(ctx.func_table, \\\"Array::length\\\")\\n      let (arr_get_fi, _, _) = resolve_func(ctx.func_table, \\\"Array::get\\\")\\n      let (arr_push_fi, _, _) = resolve_func(ctx.func_table, \\\"Array::push\\\")\\n      let mut nl = ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)\\n      nl = ce(buf, Array::get(args, 1), local_names, nl, ctx, ld)\\n      let arr_l = nl\\n      let fn_l = nl + 1\\n      let res_l = nl + 2\\n      let len_l = nl + 3\\n      let i_l = nl + 4\\n      let slot_l = nl + 5\\n      let env_l = nl + 6\\n      let elem_l = nl + 7\\n      Array::push(local_names, \\\"__filter_arr\\\")\\n      Array::push(local_names, \\\"__filter_fn\\\")\\n      Array::push(local_names, \\\"__filter_res\\\")\\n      Array::push(local_names, \\\"__filter_len\\\")\\n      Array::push(local_names, \\\"__filter_i\\\")\\n      Array::push(local_names, \\\"__filter_slot\\\")\\n      Array::push(local_names, \\\"__filter_env\\\")\\n      Array::push(local_names, \\\"__filter_elem\\\")\\n      emit_local_set(buf, fn_l)\\n      emit_local_set(buf, arr_l)\\n      emit_call(buf, arr_new_fi)\\n      emit_local_set(buf, res_l)\\n      emit_local_get(buf, arr_l)\\n      emit_call(buf, arr_len_fi)\\n      emit_local_set(buf, len_l)\\n      emit_i64_const(buf, 0)\\n      emit_local_set(buf, i_l)\\n      emit_closure_resolve(buf, fn_l, slot_l, env_l)\\n      emit_block_void(buf)\\n      emit_loop_void(buf)\\n      emit_local_get(buf, i_l)\\n      emit_local_get(buf, len_l)\\n      emit_i64_ge_s(buf)\\n      emit_br_if(buf, 1)\\n      emit_local_get(buf, arr_l)\\n      emit_local_get(buf, i_l)\\n      emit_call(buf, arr_get_fi)\\n      emit_local_set(buf, elem_l)\\n      emit_local_get(buf, elem_l)\\n      emit_closure_call_tail(buf, env_l, slot_l, 9, 1)\\n      emit_i64_const(buf, 0)\\n      emit_i64_ne(buf)\\n      emit_if_void(buf)\\n      emit_local_get(buf, res_l)\\n      emit_local_get(buf, elem_l)\\n      emit_call(buf, arr_push_fi)\\n      emit_end(buf)\\n      emit_local_get(buf, i_l)\\n      emit_index_one(buf, ctx)\\n      emit_i64_add(buf)\\n      emit_local_set(buf, i_l)\\n      emit_br(buf, 0)\\n      emit_end(buf)\\n      emit_end(buf)\\n      emit_local_get(buf, res_l)\\n      nl + 8\\n    }\\n    else if !prefer_bound_call && fname == \\\"Stream::next\\\" {\\n      // Stream::next(s) : Future[Option[T]] (docs/spec §2.4). On the eager\\n      // Array-backed model `next` peeks the head: Some(s[0]) if non-empty else\\n      // None. Synthesize the Option expression and reuse the existing ctor +\\n      // Array::length/get lowering via `ce`. (await unwraps the ready future.)\\n      let s_expr = Array::get(args, 0)\\n      let synth = ELet(\\\"__nx_s\\\", s_expr, EIf(ECall(EIdent(\\\"lt\\\", -1), [\\n        EInt(0),\\n        ECall(EIdent(\\\"Array::length\\\", -1), [\\n          EIdent(\\\"__nx_s\\\", -1)\\n        ], -1)\\n      ], -1), ECall(EIdent(\\\"Some\\\", -1), [\\n        ECall(EIdent(\\\"Array::get\\\", -1), [\\n          EIdent(\\\"__nx_s\\\", -1),\\n          EInt(0)\\n        ], -1)\\n      ], -1), ECall(EIdent(\\\"None\\\", -1), Array::slice([\\n        EUnit\\n      ], 0, 0), -1)), -1)\\n      ce(buf, synth, local_names, next_local, ctx, ld)\\n    }\\n    else if !prefer_bound_call && fname == \\\"Task::timeout\\\" {\\n      // Task::timeout(ms, thunk) : Option[T] (docs/spec §2.5). Synchronous eager\\n      // model: the thunk always completes, so the result is Some(thunk()); the\\n      // deadline is evaluated for its effects then ignored. Synthesized and\\n      // lowered via `ce` so the Some ctor + 0-arg closure call reuse existing\\n      // lowering.\\n      let ms_expr = Array::get(args, 0)\\n      let thunk_expr = Array::get(args, 1)\\n      let synth = ELet(\\\"__to_fn\\\", thunk_expr, ELet(\\\"__to_ms\\\", ms_expr, ECall(EIdent(\\\"Some\\\", -1), [\\n        ECall(EIdent(\\\"__to_fn\\\", -1), Array::slice([\\n          EUnit\\n        ], 0, 0), -1)\\n      ], -1), -1), -1)\\n      ce(buf, synth, local_names, next_local, ctx, ld)\\n    }\\n    else if !prefer_bound_call && fname == \\\"String::to_bytes\\\" {\\n      // String::to_bytes(s) : Stream[Int]  (ByteStream, docs/spec §2.4/§4.1).\\n      // Eagerly materialise the string's bytes into the Array that backs a\\n      // Stream[Int], so request/response bodies can be consumed with the Stream\\n      // combinators. Synthesized as a `let mut arr = []; while i < length(s) {\\n      // Array::push(arr, char_code_at(s, i)); i = i + 1 }; arr` loop and lowered\\n      // via `ce`, so String::length/char_code_at + the loop counter follow the\\n      // same (RC) tagging conventions as ordinary source. char_code_at reads one\\n      // byte (i32.load8_u), so this is byte-accurate.\\n      let s_expr = Array::get(args, 0)\\n      let loop_body = ESeq(ECall(EIdent(\\\"Array::push\\\", -1), [\\n        EIdent(\\\"__tb_arr\\\", -1),\\n        ECall(EIdent(\\\"String::char_code_at\\\", -1), [\\n          EIdent(\\\"__tb_s\\\", -1),\\n          EIdent(\\\"__tb_i\\\", -1)\\n        ], -1)\\n      ], -1), EAssign(\\\"__tb_i\\\", ECall(EIdent(\\\"add\\\", -1), [\\n        EIdent(\\\"__tb_i\\\", -1),\\n        EInt(1)\\n      ], -1), EUnit))\\n      let synth = ELet(\\\"__tb_s\\\", s_expr, ELetMut(\\\"__tb_arr\\\", EArray(Array::slice([\\n        EUnit\\n      ], 0, 0)), ELetMut(\\\"__tb_i\\\", EInt(0), ESeq(EWhile(ECall(EIdent(\\\"lt\\\", -1), [\\n        EIdent(\\\"__tb_i\\\", -1),\\n        ECall(EIdent(\\\"String::length\\\", -1), [\\n          EIdent(\\\"__tb_s\\\", -1)\\n        ], -1)\\n      ], -1), loop_body), EIdent(\\\"__tb_arr\\\", -1)), -1), -1), -1)\\n      ce(buf, synth, local_names, next_local, ctx, ld)\\n    }\\n    else if !prefer_bound_call && fname == \\\"Stream::to_string\\\" {\\n      // Stream::to_string(bs) : String  (ByteStream -> String, docs/spec\\n      // §M2c-2). Collect a Stream[Int] of byte codes into a String, e.g. to\\n      // build a response body. Synthesized as `let parts = []; while i <\\n      // length(bs) { Array::push(parts, String::from_char_code(bs[i])); i = i +\\n      // 1 }; String::join(parts, \\\"\\\")` and lowered via `ce`. Pushing one-char\\n      // pieces and joining once is O(n); the earlier `acc = String::concat(acc,\\n      // ...)` accumulator was O(n^2) (each concat copied the whole prefix), the\\n      // dominant cost in the streaming bench (4 KB to_string: 1.77s -> see\\n      // scripts/bench_streaming.sh). linked_compile always seeds \\\"\\\" into the\\n      // string table, so the join separator literal resolves.\\n      let bs_expr = Array::get(args, 0)\\n      let ts_body = ESeq(ECall(EIdent(\\\"Array::push\\\", -1), [\\n        EIdent(\\\"__ts_parts\\\", -1),\\n        ECall(EIdent(\\\"String::from_char_code\\\", -1), [\\n          ECall(EIdent(\\\"Array::get\\\", -1), [\\n            EIdent(\\\"__ts_arr\\\", -1),\\n            EIdent(\\\"__ts_i\\\", -1)\\n          ], -1)\\n        ], -1)\\n      ], -1), EAssign(\\\"__ts_i\\\", ECall(EIdent(\\\"add\\\", -1), [\\n        EIdent(\\\"__ts_i\\\", -1),\\n        EInt(1)\\n      ], -1), EUnit))\\n      let synth = ELet(\\\"__ts_arr\\\", bs_expr, ELetMut(\\\"__ts_parts\\\", EArray(Array::slice([\\n        EUnit\\n      ], 0, 0)), ELetMut(\\\"__ts_i\\\", EInt(0), ESeq(EWhile(ECall(EIdent(\\\"lt\\\", -1), [\\n        EIdent(\\\"__ts_i\\\", -1),\\n        ECall(EIdent(\\\"Array::length\\\", -1), [\\n          EIdent(\\\"__ts_arr\\\", -1)\\n        ], -1)\\n      ], -1), ts_body), ECall(EIdent(\\\"String::join\\\", -1), [\\n        EIdent(\\\"__ts_parts\\\", -1),\\n        EString(\\\"\\\")\\n      ], -1)), -1), -1), -1)\\n      ce(buf, synth, local_names, next_local, ctx, ld)\\n    }\\n    else if !prefer_bound_call && fname == \\\"add\\\" {\\n      let mut nl = ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)\\n      nl = ce(buf, Array::get(args, 1), local_names, nl, ctx, ld)\\n      emit_i64_add(buf)\\n      nl\\n    }\\n    else if !prefer_bound_call && fname == \\\"sub\\\" {\\n      let mut nl = ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)\\n      nl = ce(buf, Array::get(args, 1), local_names, nl, ctx, ld)\\n      emit_i64_sub(buf)\\n      nl\\n    }\\n    else if !prefer_bound_call && fname == \\\"mul\\\" {\\n      let mut nl = ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)\\n      nl = ce(buf, Array::get(args, 1), local_names, nl, ctx, ld)\\n      emit_i64_mul(buf)\\n      // Under RC, Int values are tagged `(n << 1)`. Multiplying two tagged\\n      // operands raw gives `(a*b) << 2` (an extra factor of 2 vs. the `<< 1`\\n      // every other Int carries) -- shift right once to correct back, exactly\\n      // like the `*` EBinOp path does (compile_expr.vibe `op == \\\"*\\\"`) that\\n      // this builtin fast path duplicates but had not mirrored.\\n      if ctx.enable_rc {\\n        emit_i64_const(buf, 1)\\n        emit_i64_shr_s(buf)\\n      } else {\\n        ()\\n      }\\n      nl\\n    }\\n    else if !prefer_bound_call && fname == \\\"lt\\\" {\\n      let mut nl = ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)\\n      nl = ce(buf, Array::get(args, 1), local_names, nl, ctx, ld)\\n      emit_i64_lt_s(buf)\\n      emit_i64_extend_i32_s(buf)\\n      // Under RC, Bool values are also tagged `(0|1) << 1` (mirrors the `<`\\n      // EBinOp path's retag) -- untagged here means callers see 0 (== false\\n      // tagged) but a true result reads as 1 instead of the expected 2.\\n      if ctx.enable_rc {\\n        emit_i64_const(buf, 1)\\n        emit_i64_shl(buf)\\n      } else {\\n        ()\\n      }\\n      nl\\n    }\\n    else if !prefer_bound_call && fname == \\\"simd_skip_ws\\\" {\\n      // #536 Phase 3: fused SIMD whitespace skip.\\n      // simd_skip_ws(src: Bytes, pos: Int, len: Int) -> Int returns the first\\n      // index >= pos that is NOT ASCII whitespace (' ' \\\\t \\\\n \\\\r), or len if all\\n      // remaining bytes are whitespace. Scans 16 bytes at a time with the v128\\n      // chunk kept on the operand stack (NO heap boxing — the per-op boxed v128\\n      // intrinsics would bump-allocate 16 bytes each and leak), plus a scalar\\n      // tail. Bytes layout (gen_bytes_get_body): [alloc@0][len@4][payload_ptr@8].\\n      let mut nl = ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)\\n      nl = ce(buf, Array::get(args, 1), local_names, nl, ctx, ld)\\n      nl = ce(buf, Array::get(args, 2), local_names, nl, ctx, ld)\\n      let base_l = nl\\n      let pos_l = nl + 1\\n      let len_l = nl + 2\\n      let res_l = nl + 3\\n      let mask_l = nl + 4\\n      let addr_l = nl + 5\\n      let b_l = nl + 6\\n      Array::push(local_names, \\\"__sw_base\\\")\\n      Array::push(local_names, \\\"__sw_pos\\\")\\n      Array::push(local_names, \\\"__sw_len\\\")\\n      Array::push(local_names, \\\"__sw_res\\\")\\n      Array::push(local_names, \\\"__sw_mask\\\")\\n      Array::push(local_names, \\\"__sw_addr\\\")\\n      Array::push(local_names, \\\"__sw_b\\\")\\n      // stack: srcval, posval, lenval\\n      emit_local_set(buf, len_l)\\n      emit_local_set(buf, pos_l)\\n      // top = srcval; base = payload_ptr (i32 @ +8) extended to i64\\n      emit_i32_wrap_i64(buf)\\n      emit_i32_load(buf, 2, 8)\\n      emit_i64_extend_i32_u(buf)\\n      emit_local_set(buf, base_l)\\n      // res defaults to len (every path overwrites it; keep it defined)\\n      emit_local_get(buf, len_l)\\n      emit_local_set(buf, res_l)\\n      emit_block_void(buf)\\n      // $ret\\n      emit_block_void(buf)\\n      // $tail\\n      emit_loop_void(buf)\\n      // $scan: if (pos + 16 > len) br $tail\\n      emit_local_get(buf, pos_l)\\n      emit_i32_wrap_i64(buf)\\n      emit_i32_const(buf, 16)\\n      emit_i32_add(buf)\\n      emit_local_get(buf, len_l)\\n      emit_i32_wrap_i64(buf)\\n      emit_i32_gt_u(buf)\\n      emit_if_void(buf)\\n      emit_br(buf, 2)\\n      emit_end(buf)\\n      // addr = base + pos\\n      emit_local_get(buf, base_l)\\n      emit_i32_wrap_i64(buf)\\n      emit_local_get(buf, pos_l)\\n      emit_i32_wrap_i64(buf)\\n      emit_i32_add(buf)\\n      emit_i64_extend_i32_u(buf)\\n      emit_local_set(buf, addr_l)\\n      // is_ws = (c==0x20) | (c==0x09) | (c==0x0A) | (c==0x0D), v128 on stack\\n      emit_local_get(buf, addr_l)\\n      emit_i32_wrap_i64(buf)\\n      emit_v128_load(buf, 0, 0)\\n      emit_v128_const_splat_byte(buf, 32)\\n      emit_i8x16_eq(buf)\\n      emit_local_get(buf, addr_l)\\n      emit_i32_wrap_i64(buf)\\n      emit_v128_load(buf, 0, 0)\\n      emit_v128_const_splat_byte(buf, 9)\\n      emit_i8x16_eq(buf)\\n      emit_v128_or(buf)\\n      emit_local_get(buf, addr_l)\\n      emit_i32_wrap_i64(buf)\\n      emit_v128_load(buf, 0, 0)\\n      emit_v128_const_splat_byte(buf, 10)\\n      emit_i8x16_eq(buf)\\n      emit_v128_or(buf)\\n      emit_local_get(buf, addr_l)\\n      emit_i32_wrap_i64(buf)\\n      emit_v128_load(buf, 0, 0)\\n      emit_v128_const_splat_byte(buf, 13)\\n      emit_i8x16_eq(buf)\\n      emit_v128_or(buf)\\n      // mask = bitmask(not(is_ws)): bit i set => lane i is NON-whitespace\\n      emit_v128_not(buf)\\n      emit_i8x16_bitmask(buf)\\n      emit_i64_extend_i32_u(buf)\\n      emit_local_set(buf, mask_l)\\n      // if (mask == 0) { pos += 16; br $scan }\\n      emit_local_get(buf, mask_l)\\n      emit_i32_wrap_i64(buf)\\n      emit_i32_eqz(buf)\\n      emit_if_void(buf)\\n      emit_local_get(buf, pos_l)\\n      emit_i64_const(buf, 16)\\n      emit_i64_add(buf)\\n      emit_local_set(buf, pos_l)\\n      emit_br(buf, 1)\\n      emit_end(buf)\\n      // found: res = pos + ctz(mask); br $ret\\n      emit_local_get(buf, pos_l)\\n      emit_i32_wrap_i64(buf)\\n      emit_local_get(buf, mask_l)\\n      emit_i32_wrap_i64(buf)\\n      bytebuf_push(buf, 104)\\n      // i32.ctz\\n      emit_i32_add(buf)\\n      emit_i64_extend_i32_u(buf)\\n      emit_local_set(buf, res_l)\\n      emit_br(b