s(CtUnknown, CtString), CtInt, Some(\"TcpSocket\")))\n  }\n  else None\n}\n\nfn lookup_http_response_body(name: String) -> Option[Type] {\n  if name == \"Http::response_body\" {\n    Some(CtFn(net_one_param(CtUnknown), CtString, Some(\"HttpClient\")))\n  }\n  else None\n}\n\nfn lookup_socket_tcp_connect(name: String) -> Option[Type] {\n  if name == \"Socket::tcp_connect\" {\n    Some(CtFn(net_two_params(CtString, CtInt), CtUnknown, Some(\"TcpSocket\")))\n  }\n  else None\n}\n\nfn lookup_net_group_a(name: String) -> Option[Type] {\n  match lookup_socket_tcp_connect(name) {\n    Some(t) => Some(t),\n    None => match lookup_socket_tcp_read(name) {\n      Some(t) => Some(t),\n      None => match lookup_socket_tcp_write(name) {\n        Some(t) => Some(t),\n        None => lookup_socket_tcp_close(name)\n      }\n    }\n  }\n}\n\nfn lookup_http_request_header(name: String) -> Option[Type] {\n  if name == \"Http::request_header\" {\n    Some(CtFn(net_two_params(CtUnknown, CtString), CtString, Some(\"HttpIncoming\")))\n  }\n  else None\n}\n\nfn lookup_net_group_d(name: String) -> Option[Type] {\n  match lookup_http_request_header(name) {\n    Some(t) => Some(t),\n    None => lookup_http_respond(name)\n  }\n}\n\nfn lookup_http_request_method(name: String) -> Option[Type] {\n  if name == \"Http::request_method\" {\n    Some(CtFn(net_one_param(CtUnknown), CtString, Some(\"HttpIncoming\")))\n  }\n  else None\n}\n\nfn lookup_net_group_c(name: String) -> Option[Type] {\n  match lookup_http_close(name) {\n    Some(t) => Some(t),\n    None => match lookup_http_listen(name) {\n      Some(t) => Some(t),\n      None => match lookup_http_accept(name) {\n        Some(t) => Some(t),\n        None => lookup_http_request_method(name)\n      }\n    }\n  }\n}\n\nfn lookup_http_response_header(name: String) -> Option[Type] {\n  if name == \"Http::response_header\" {\n    Some(CtFn(net_two_params(CtUnknown, CtString), CtString, Some(\"HttpClient\")))\n  }\n  else None\n}\n\nfn lookup_http_response_status(name: String) -> Option[Type] {\n  if name == \"Http::response_status\" {\n    Some(CtFn(net_one_param(CtUnknown), CtInt, Some(\"HttpClient\")))\n  }\n  else None\n}\n\nfn lookup_net_group_b(name: String) -> Option[Type] {\n  match lookup_http_request(name) {\n    Some(t) => Some(t),\n    None => match lookup_http_response_status(name) {\n      Some(t) => Some(t),\n      None => match lookup_http_response_header(name) {\n        Some(t) => Some(t),\n        None => lookup_http_response_body(name)\n      }\n    }\n  }\n}\n\nexport fn lookup_net(name: String) -> Option[Type] {\n  match lookup_net_group_a(name) {\n    Some(t) => Some(t),\n    None => match lookup_net_group_b(name) {\n      Some(t) => Some(t),\n      None => match lookup_net_group_c(name) {\n        Some(t) => Some(t),\n        None => lookup_net_group_d(name)\n      }\n    }\n  }\n}\n")
