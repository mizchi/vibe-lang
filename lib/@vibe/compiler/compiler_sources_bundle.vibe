let source_2 = () -> (String, String) {
  ("lib/@vibe/parser/index.vpkg",
"version 0.1.0\n\n// @vibe/parser — the vibe lexer / parser / printer (ADR-0065 Phase 3, #753).\n// Depends on @vibe/ast (the impl files import ../ast for the node types;\n// Expr/Pat/Stmt/TypeExpr in the signatures below are those types). Token is\n// a bodyless type declaration: the enum definition lives in token.vibe (the\n// lexer/parser construct and match it, so a transparent contract definition\n// would hit the impl-before-facade check order, #752 rule), and the facade\n// re-exports it with ctors intact.\n//\n// The surface deliberately includes the parser-combinator primitives\n// (peek/tk_name/parse_type/parse_fn_signature/...) — the compiler's contract\n// engine, cst lowering, and editor tooling build on them, and conformance\n// requires every `export let` of the impl files to be declared here.\n\ntype Token\n\n// --- polyfill\n\n// --- token\nfn token_to_string(t: Token) -> String\n\n// --- float_format\nfn double_to_string_compiler(d: Double) -> String\nfn parse_decimal_float(int_str: String, frac_str: String) -> Double\n\n// --- lexer\nfn lex(src: String) -> Array[Token] with { Error }\nfn lex_ok(src: String) -> Bool\nfn lex_with_offsets(src: String) -> (Array[Token], Array[Int], Array[Int]) with { Error }\nfn lex_with_offsets_recovering(src: String) -> (Array[Token], Array[Int], Array[Int], Array[Int], Array[String])\nfn offset_to_line_col(src: String, offset: Int) -> (Int, Int)\n\n// --- parser_base\nfn peek(tokens: Array[Token], pos: Int) -> Token\nfn tk_name(t: Token) -> String\nfn skip_semi(tokens: Array[Token], pos: Int) -> Int\nfn parse_derive_names(tokens: Array[Token], pos: Int) -> (Array[String], Int) with { Error }\nfn skip_derive(tokens: Array[Token], pos: Int) -> Int with { Error }\nfn skip_braced_body(tokens: Array[Token], pos: Int) -> Int\nfn collect_import_path(tokens: Array[Token], pos: Int, acc: String) -> (String, Int) with { Error }\nfn parse_type(tokens: Array[Token], pos: Int) -> (TypeExpr, Int) with { Error }\n\n// --- parser_expr (+ primary/core/dispatch stages)\nfn parse(tokens: Array[Token]) -> Expr with { Error }\nfn parse_ok(tokens: Array[Token]) -> Bool\nfn parse_expr(tokens: Array[Token], pos: Int) -> (Expr, Int) with { Error }\nfn parse_impl(tokens: Array[Token], starts: Array[Int], pos: Int, min_prec: Int) -> (Expr, Int) with { Error }\nfn parse_fn_signature(tokens: Array[Token], pos: Int) -> ((String, Array[String], Array[(String, Array[String])]), (Array[(String, Option[TypeExpr])], TypeExpr, Option[String]), (Array[Expr], Array[Expr]), Int) with { Error }\nfn parse_primary(tokens: Array[Token], starts: Array[Int], pos: Int, k: (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error }\nfn parse_infix(tokens: Array[Token], starts: Array[Int], pos: Int, min_prec: Int, depth: Int, k: (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error }\nfn parse_infix_no_is(tokens: Array[Token], starts: Array[Int], pos: Int, min_prec: Int, depth: Int, k: (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error }\nfn parse_impl_dispatch(tokens: Array[Token], starts: Array[Int], pos: Int, depth: Int, k: (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error }\n\n// --- parser_expr (fn-declaration lowering, ADR-0064 #727/#731)\nfn lower_fn_decl_stmt(stmt: Stmt) -> Stmt\nfn lower_fn_decl_stmts(stmts: Array[Stmt]) -> Array[Stmt]\n\n// --- parser\nfn parse_stmt(tokens: Array[Token], starts: Array[Int], pos: Int) -> (Stmt, Int) with { Error }\nfn parse_stmt_preserving(tokens: Array[Token], starts: Array[Int], pos: Int) -> (Stmt, Int) with { Error }\nfn parse_program(tokens: Array[Token]) -> Array[Stmt] with { Error }\nfn parse_program_preserving(tokens: Array[Token]) -> Array[Stmt] with { Error }\nfn parse_program_located(tokens: Array[Token], starts: Array[Int], src: String) -> Array[Stmt] with { Error }\nfn parse_program_recovering(tokens: Array[Token], starts: Array[Int], src: String) -> (Array[Stmt], Array[String]) with { Error }\nfn parse_program_spans(tokens: Array[Token], starts: Array[Int], ends: Array[Int]) -> (Array[Stmt], Array[Int], Array[Int]) with { Error }\n\n// --- expand_interp\nfn resolve_interp_expr(e: Expr) -> Expr with { Error }\nfn resolve_interp_stmts(stmts: Array[Stmt]) -> Array[Stmt] with { Error }\n\n// --- printer\nfn print_pat(p: Pat) -> String\nfn print_type_expr(t: TypeExpr) -> String\nfn print_expr(e: Expr) -> String\nfn print_stmt(s: Stmt) -> String\nfn print_program(stmts: Array[Stmt]) -> String\n")
}

let source_3 = () -> (String, String) {
  ("lib/@vibe/parser/polyfill.vibe",
"\nfn __to_string(n: Int) -> String {\n  if n == 0 {\n    \"0\"\n  } else {\n    let mut val = n\n    let mut neg = false\n    if val < 0 {\n      neg = true\n      val = 0 - val\n    }\n    let digits = Array::slice([\n      \"\"\n    ], 0, 0)\n    while val > 0 {\n      let d = val - (val / 10) * 10\n      let ch = if d == 0 {\n        \"0\"\n      }\n      else if d == 1 {\n        \"1\"\n      }\n      else if d == 2 {\n        \"2\"\n      }\n      else if d == 3 {\n        \"3\"\n      }\n      else if d == 4 {\n        \"4\"\n      }\n      else if d == 5 {\n        \"5\"\n      }\n      else if d == 6 {\n        \"6\"\n      }\n      else if d == 7 {\n        \"7\"\n      }\n      else if d == 8 {\n        \"8\"\n      }\n      else {\n        \"9\"\n      }\n      Array::push(digits, ch)\n      val = val / 10\n    }\n    let mut result = if neg {\n      \"-\"\n    } else {\n      \"\"\n    }\n    let mut i = Array::length(digits) - 1\n    while i >= 0 {\n      result = String::concat(result, Array::get(digits, i))\n      i = i - 1\n    }\n    result\n  }\n}\n\n\nexport {\n  __to_string\n}\n")
}

let source_4 = () -> (String, String) {
  ("lib/@vibe/parser/token.vibe",
"\n\n\n\nexport enum Token {\n  TInt(Int);\n  TFloat(Double);\n  TString(String);\n  TIdent(String);\n  TLet;\n  TRec;\n  TMut;\n  TFn;\n  TIf;\n  TElse;\n  TMatch;\n  TIs;\n  TDo;\n  TEnum;\n  TStruct;\n  TType;\n  TTrait;\n  TImpl;\n  TExport;\n  TTest;\n  TWhile;\n  TFor;\n  TIn;\n  TLoop;\n  TBreak;\n  TContinue;\n  TReturn;\n  TWith;\n  THandle;\n  TThrow;\n  TRaise;\n  TYield;\n  TBench;\n  TDeclare;\n  TAs;\n  TModule;\n  TSuberror;\n  TDerive;\n  TOpen;\n  TImport;\n  TPlus;\n  TMinus;\n  TStar;\n  TSlash;\n  TPercent;\n  TEqEq;\n  TNeq;\n  TLt;\n  TLte;\n  TGt;\n  TGte;\n  TAnd;\n  TOr;\n  TNot;\n  TBitAnd;\n  TBitOr;\n  TBitXor;\n  TLShift;\n  TRShift;\n  TPipeGt;\n  TArrow;\n  TThinArrow;\n  TEq;\n  TDot;\n  TColon;\n  TDoubleColon;\n  TComma;\n  TSemicolon;\n  THash;\n  TTilde;\n  TQuestion;\n  TPlusEq;\n  TMinusEq;\n  TStarEq;\n  TSlashEq;\n  TPercentEq;\n  TLParen;\n  TRParen;\n  TLBrace;\n  TRBrace;\n  TLBracket;\n  TRBracket;\n  TDotDot;\n  TDotDotDot;\n  TStringInterp(Array[String], Array[Int]);\n  TEof\n}\n\n\nexport fn token_to_string(t: Token) -> String {\n  match t {\n    TInt(n) => String::concat(\"TInt(\", String::concat(__to_string(n), \")\")),\n    TFloat(n) =>\n    String::concat(\"TFloat(\", String::concat(double_to_string_compiler(n), \")\")),\n    TString(s) => String::concat(\"TString(\\\"\", String::concat(s, \"\\\")\")),\n    TIdent(s) => String::concat(\"TIdent(\", String::concat(s, \")\")),\n    TLet => \"TLet\",\n    TRec => \"TRec\",\n    TMut => \"TMut\",\n    TFn => \"TFn\",\n    TIf => \"TIf\",\n    TElse => \"TElse\",\n    TMatch => \"TMatch\",\n    TIs => \"TIs\",\n    TDo => \"TDo\",\n    TEnum => \"TEnum\",\n    TStruct => \"TStruct\",\n    TType => \"TType\",\n    TTrait => \"TTrait\",\n    TImpl => \"TImpl\",\n    TExport => \"TExport\",\n    TTest => \"TTest\",\n    TWhile => \"TWhile\",\n    TFor => \"TFor\",\n    TIn => \"TIn\",\n    TLoop => \"TLoop\",\n    TBreak => \"TBreak\",\n    TContinue => \"TContinue\",\n    TReturn => \"TReturn\",\n    TWith => \"TWith\",\n    THandle => \"THandle\",\n    TThrow => \"TThrow\",\n    TRaise => \"TRaise\",\n    TYield => \"TYield\",\n    TBench => \"TBench\",\n    TDeclare => \"TDeclare\",\n    TAs => \"TAs\",\n    TModule => \"TModule\",\n    TSuberror => \"TSuberror\",\n    TDerive => \"TDerive\",\n    TOpen => \"TOpen\",\n    TImport => \"TImport\",\n    TPlus => \"TPlus\",\n    TMinus => \"TMinus\",\n    TStar => \"TStar\",\n    TSlash => \"TSlash\",\n    TPercent => \"TPercent\",\n    TEqEq => \"TEqEq\",\n    TNeq => \"TNeq\",\n    TLt => \"TLt\",\n    TLte => \"TLte\",\n    TGt => \"TGt\",\n    TGte => \"TGte\",\n    TAnd => \"TAnd\",\n    TOr => \"TOr\",\n    TNot => \"TNot\",\n    TBitAnd => \"TBitAnd\",\n    TBitOr => \"TBitOr\",\n    TBitXor => \"TBitXor\",\n    TLShift => \"TLShift\",\n    TRShift => \"TRShift\",\n    TPipeGt => \"TPipeGt\",\n    TArrow => \"TArrow\",\n    TThinArrow => \"TThinArrow\",\n    TEq => \"TEq\",\n    TDot => \"TDot\",\n    TColon => \"TColon\",\n    TDoubleColon => \"TDoubleColon\",\n    TComma => \"TComma\",\n    TSemicolon => \"TSemicolon\",\n    THash => \"THash\",\n    TTilde => \"TTilde\",\n    TQuestion => \"TQuestion\",\n    TPlusEq => \"TPlusEq\",\n    TMinusEq => \"TMinusEq\",\n    TStarEq => \"TStarEq\",\n    TSlashEq => \"TSlashEq\",\n    TPercentEq => \"TPercentEq\",\n    TLParen => \"TLParen\",\n    TRParen => \"TRParen\",\n    TLBrace => \"TLBrace\",\n    TRBrace => \"TRBrace\",\n    TLBracket => \"TLBracket\",\n    TRBracket => \"TRBracket\",\n    TDotDot => \"TDotDot\",\n    TDotDotDot => \"TDotDotDot\",\n    TStringInterp(_, _) => \"TStringInterp\",\n    TEof => \"TEof\"\n  }\n}\n")
}

let source_5 = () -> (String, String) {
  ("lib/@vibe/parser/float_format.vibe",
"\n\n\n\n\nexport fn parse_decimal_float(int_str: String, frac_str: String) -> Double {\n  let flen = String::length(frac_str)\n  let all = String::concat(int_str, frac_str)\n  let total = String::length(all)\n  let mut exp10 = 0 - flen\n  let mut start = 0\n  while start < total - 1 && String::char_code_at(all, start) == '0' {\n    start = start + 1\n  }\n  let mut end = total\n  while end - start > 1 && String::char_code_at(all, end - 1) == '0' {\n    end = end - 1\n    exp10 = exp10 + 1\n  }\n  if String::char_code_at(all, start) == '0' {\n    0.0\n  } else {\n    let nsig = end - start\n    if nsig <= 15 && exp10 + 22 >= 0 && exp10 <= 22 {\n      let mut m = 0\n      let mut k = start\n      while k < end {\n        m = m * 10 + (String::char_code_at(all, k) - 48)\n        k = k + 1\n      }\n      let mut pw = 1.0\n      let mut pj = 0\n      let pe = if exp10 >= 0 {\n        exp10\n      } else {\n        0 - exp10\n      }\n      while pj < pe {\n        pw = pw * 10.0\n        pj = pj + 1\n      }\n      if exp10 >= 0 {\n        Int::to_double(m) * pw\n      } else {\n        Int::to_double(m) / pw\n      }\n    } else {\n      let mut hi = 0.0\n      let mut lo = 0.0\n      let mut tp = 0.0\n      let mut tc = 0.0\n      let mut terr = 0.0\n      let mut ah = 0.0\n      let mut al = 0.0\n      let mut bh = 0.0\n      let mut bl = 0.0\n      let mut td = 0.0\n      let mut ph = 0.0\n      let mut pl = 0.0\n      let mut psmall = 0.0\n      let mut mph = 0.0\n      let mut mpl = 0.0\n      let mut tneg = 0.0\n      let mut q1 = 0.0\n      let mut q2 = 0.0\n      let mut p22 = 1.0\n      let mut p22i = 0\n      while p22i < 22 {\n        p22 = p22 * 10.0\n        p22i = p22i + 1\n      }\n      let mut absorb = 0\n      while exp10 > 0 && nsig + absorb < 31 {\n        absorb = absorb + 1\n        exp10 = exp10 - 1\n      }\n      let mut used = 0\n      let mut sticky = false\n      let mut k = start\n      let mut phase = 0\n      while phase < 2 {\n        let dostep = if phase == 0 {\n          k < end\n        } else {\n          k < absorb\n        }\n        if dostep {\n          let dig = if phase == 0 {\n            String::char_code_at(all, k) - 48\n          } else {\n            0\n          }\n          if phase == 1 || used < 31 {\n            td = 10.0\n            tp = hi * (td * 1.0)\n            tc = 134217729.0 * hi\n            ah = tc - (tc - hi * 1.0)\n            al = hi - ah * 1.0\n            tc = 134217729.0 * td\n            bh = tc - (tc - td * 1.0)\n            bl = td - bh * 1.0\n            terr = ((ah * (bh * 1.0) - tp) + ah * (bl * 1.0) + al * (bh * 1.0)) + al * (bl * 1.0)\n            terr = terr + lo * (td * 1.0)\n            hi = tp + terr * 1.0\n            lo = terr - (hi - tp * 1.0)\n            if phase == 0 {\n              td = Int::to_double(dig)\n              tp = hi + td * 1.0\n              tc = tp - hi * 1.0\n              terr = (hi - (tp - tc * 1.0)) + (td - tc * 1.0)\n              terr = terr + lo * 1.0\n              hi = tp + terr * 1.0\n              lo = terr - (hi - tp * 1.0)\n            } else {\n              ()\n            }\n            used = used + 1\n          } else {\n            exp10 = exp10 + 1\n            if dig != 0 {\n              sticky = true\n            } else {\n              ()\n            }\n          }\n          k = k + 1\n        } else {\n          phase = phase + 1\n          k = if phase == 1 {\n            0\n          } else {\n            k\n          }\n        }\n      }\n      if sticky {\n        td = 0.5\n        tp = hi + td * 1.0\n        tc = tp - hi * 1.0\n        terr = (hi - (tp - tc * 1.0)) + (td - tc * 1.0)\n        terr = terr + lo * 1.0\n        hi = tp + terr * 1.0\n        lo = terr - (hi - tp * 1.0)\n      } else {\n        ()\n      }\n      let e_dec = exp10 + used - 1\n      if e_dec > 308 {\n        let mut infv = 1.0\n        let mut infi = 0\n        while infi < 1100 {\n          infv = infv * 2.0\n          infi = infi + 1\n        }\n        infv\n      } else if e_dec + 324 < 0 {\n        0.0\n      } else if exp10 > 0 {\n        let big = exp10 > 270\n        let e_first = if big {\n          exp10 - 270\n        } else {\n          exp10\n        }\n        ph = 1.0\n        pl = 0.0\n        let mut ke = e_first\n        while ke > 22 {\n          tp = ph * (p22 * 1.0)\n          tc = 134217729.0 * ph\n          ah = tc - (tc - ph * 1.0)\n          al = ph - ah * 1.0\n          tc = 134217729.0 * p22\n          bh = tc - (tc - p22 * 1.0)\n          bl = p22 - bh * 1.0\n          terr = ((ah * (bh * 1.0) - tp) + ah * (bl * 1.0) + al * (bh * 1.0)) + al * (bl * 1.0)\n          terr = terr + pl * (p22 * 1.0)\n          ph = tp + terr * 1.0\n          pl = terr - (ph - tp * 1.0)\n          ke = ke - 22\n        }\n        psmall = 1.0\n        while ke > 0 {\n          psmall = psmall * 10.0\n          ke = ke - 1\n        }\n        tp = ph * (psmall * 1.0)\n        tc = 134217729.0 * ph\n        ah = tc - (tc - ph * 1.0)\n        al = ph - ah * 1.0\n        tc = 134217729.0 * psmall\n        bh = tc - (tc - psmall * 1.0)\n        bl = psmall - bh * 1.0\n        terr = ((ah * (bh * 1.0) - tp) + ah * (bl * 1.0) + al * (bh * 1.0)) + al * (bl * 1.0)\n        terr = terr + pl * (psmall * 1.0)\n        ph = tp + terr * 1.0\n        pl = terr - (ph - tp * 1.0)\n        tp = hi * (ph * 1.0)\n        tc = 134217729.0 * hi\n        ah = tc - (tc - hi * 1.0)\n        al = hi - ah * 1.0\n        tc = 134217729.0 * ph\n        bh = tc - (tc - ph * 1.0)\n        bl = ph - bh * 1.0\n        terr = ((ah * (bh * 1.0) - tp) + ah * (bl * 1.0) + al * (bh * 1.0)) + al * (bl * 1.0)\n        terr = terr + (hi * (pl * 1.0) + lo * (ph * 1.0))\n        hi = tp + terr * 1.0\n        lo = terr - (hi - tp * 1.0)\n        if big {\n          let mut p128 = 1.0\n          let mut p128i = 0\n          while p128i < 128 {\n            p128 = p128 * 2.0\n            p128i = p128i + 1\n          }