"\n\n\n\n\n\n\n\nfn entry_declares_async_int(stmts: Array[Stmt], entry_name: String) -> Bool {\n  let mut found = false\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SLet(_, _, name, opt_ty, _) => if name == entry_name {\n        match opt_ty {\n          Some(ty) => match ty {\n            TyFn(params, ret, opt_eff) => match opt_eff {\n              Some(eff) => if String::contains(eff, \"Async\") && Array::length(params) == 0 {\n                match ret {\n                  TyName(rn) => if rn == \"Int\" {\n                    found = true\n                  } else {\n                    ()\n                  },\n                  _ => ()\n                }\n              } else {\n                ()\n              },\n              None => ()\n            },\n            _ => ()\n          },\n          None => ()\n        }\n      } else {\n        ()\n      },\n      _ => ()\n    }\n    i = i + 1\n  }\n  found\n}\n\nfn maybe_wrap_async_component(bytes: Bytes, wrap_async: Bool) -> Bytes {\n  if wrap_async {\n    comp_emit_component_wasm_async_trampolined_p1(bytes, \"run\", 120)\n  } else {\n    bytes\n  }\n}\n\nexport fn compile_source_wasi_only(source: String, entry_name: String) -> Bytes with { Error } {\n  let tokens = lex(source)\n  let stmts = parse_program(tokens)\n  expand_interp_stmts(stmts)\n  let _ = check_program(stmts)\n  let wrap_async = (entry_name == \"run\") && entry_declares_async_int(stmts, entry_name)\n  strip_generic_type_params(stmts)\n  maybe_wrap_async_component(compile_wasi_module_impl(stmts, entry_name), wrap_async)\n}\n\nexport fn compile_source_wasi_only_coverage(source: String, entry_name: String) -> Bytes with { Error } {\n  let tokens = lex(source)\n  let stmts = parse_program(tokens)\n  expand_interp_stmts(stmts)\n  let _ = check_program(stmts)\n  strip_generic_type_params(stmts)\n  compile_wasi_module_coverage_impl(stmts, entry_name)\n}\n\nexport fn compile_source_wasi_only_rc(source: String, entry_name: String) -> Bytes with { Error } {\n  let tokens = lex(source)\n  let stmts = parse_program(tokens)\n  expand_interp_stmts(stmts)\n  let _ = check_program(stmts)\n  let wrap_async = (entry_name == \"run\") && entry_declares_async_int(stmts, entry_name)\n  strip_generic_type_params(stmts)\n  maybe_wrap_async_component(compile_wasi_module_rc_impl(stmts, entry_name), wrap_async)\n}\n\nexport fn compile_source_wasi_only_rc_shadow(source: String, entry_name: String) -> Bytes with { Error } {\n  let tokens = lex(source)\n  let stmts = parse_program(tokens)\n  expand_interp_stmts(stmts)\n  let _ = check_program(stmts)\n  let wrap_async = (entry_name == \"run\") && entry_declares_async_int(stmts, entry_name)\n  strip_generic_type_params(stmts)\n  maybe_wrap_async_component(compile_wasi_module_rc_shadow_impl(stmts, entry_name), wrap_async)\n}\n")
