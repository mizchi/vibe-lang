let source_215 = () -> (String, String) {
  ("lib/@vibe/json/jsonrpc.vibe",
"\nimport @vibe/prelude {\n  Result\n}\n\n\n\n\nexport enum RpcId {\n  IdNum(Int);\n  IdStr(String);\n  IdNull\n}\n\nexport enum RpcMessage {\n  Request(String, Json, RpcId);\n  Notification(String, Json);\n  SuccessResponse(RpcId, Json);\n  ErrorResponse(RpcId, Int, String, Json)\n}\n\n\nfn require_key(obj: Map[String, Json], key: String) -> Result[Json, String] {\n  if Map::has_key(obj, key) {\n    Ok(Map::get(obj, key))\n  } else {\n    Err(\"missing key: \\{key}\")\n  }\n}\n\nfn get_string(obj: Map[String, Json], key: String) -> Result[String, String] {\n  match require_key(obj, key) {\n    Ok(JStr(s)) => Ok(s),\n    Ok(_) => Err(\"expected string for key: \\{key}\"),\n    Err(msg) => Err(msg)\n  }\n}\n\nfn get_object(j: Json, message: String) -> Result[Map[String, Json], String] {\n  match j {\n    JObj(m) => Ok(m),\n    _ => Err(message)\n  }\n}\n\nfn parse_rpc_id(j: Json) -> Result[RpcId, String] {\n  match j {\n    JNum(n) => Ok(IdNum(Double::to_int(n))),\n    JStr(s) => Ok(IdStr(s)),\n    JNull => Ok(IdNull),\n    _ => Err(\"invalid id\")\n  }\n}\n\nexport fn parse_message(input: String) -> Result[RpcMessage, String] {\n  match parse(input) {\n    Ok((json, _)) => match get_object(json, \"expected object\") {\n      Ok(obj) => match get_string(obj, \"jsonrpc\") {\n        Ok(jsonrpc) =>\n        if jsonrpc != \"2.0\" {\n          Err(\"invalid jsonrpc version\")\n        } else {\n          let has_method = Map::has_key(obj, \"method\")\n          let has_result = Map::has_key(obj, \"result\")\n          let has_error = Map::has_key(obj, \"error\")\n          if has_method {\n            match get_string(obj, \"method\") {\n              Ok(method) => {\n                let params = if Map::has_key(obj, \"params\") {\n                  Map::get(obj, \"params\")\n                } else JNull\n                if Map::has_key(obj, \"id\") {\n                  match parse_rpc_id(Map::get(obj, \"id\")) {\n                    Ok(id) => Ok(Request(method, params, id)),\n                    Err(msg) => Err(msg)\n                  }\n                } else Ok(Notification(method, params))\n              },\n              Err(msg) => Err(msg)\n            }\n          } else if has_result {\n            match require_key(obj, \"id\") {\n              Ok(id_json) => match parse_rpc_id(id_json) {\n                Ok(id) => Ok(SuccessResponse(id, Map::get(obj, \"result\"))),\n                Err(msg) => Err(msg)\n              },\n              Err(msg) => Err(msg)\n            }\n          } else if has_error {\n            match require_key(obj, \"id\") {\n              Ok(id_json) => match parse_rpc_id(id_json) {\n                Ok(id) => match get_object(Map::get(obj, \"error\"), \"error must be object\") {\n                  Ok(err_obj) => match require_key(err_obj, \"code\") {\n                    Ok(JNum(n)) => match get_string(err_obj, \"message\") {\n                      Ok(message) => {\n                        let data = if Map::has_key(err_obj, \"data\") {\n                          Map::get(err_obj, \"data\")\n                        } else JNull\n                        Ok(ErrorResponse(id, Double::to_int(n), message, data))\n                      },\n                      Err(msg) => Err(msg)\n                    },\n                    Ok(_) => Err(\"error code must be number\"),\n                    Err(msg) => Err(msg)\n                  },\n                  Err(msg) => Err(msg)\n                },\n                Err(msg) => Err(msg)\n              },\n              Err(msg) => Err(msg)\n            }\n          } else Err(\"invalid message: missing method, result, or error\")\n        },\n        Err(msg) => Err(msg)\n      },\n      Err(msg) => Err(msg)\n    },\n    Err(msg) => Err(msg)\n  }\n}\n\nfn rpc_id_json_str(id: RpcId) -> String {\n  match id {\n    IdNum(n) => stringify(JNum(Int::to_double(n))),\n    IdStr(s) => stringify(JStr(s)),\n    IdNull => \"null\"\n  }\n}\n\nexport fn stringify_error(id: RpcId, code: Int, message: String, data: Json) -> String {\n  let code_str = stringify(JNum(Int::to_double(code)))\n  let msg_str = stringify(JStr(message))\n  let data_str = stringify(data)\n  let id_str = rpc_id_json_str(id)\n  let err_str = \"{\\\"code\\\":\\{code_str},\\\"message\\\":\\{msg_str},\\\"data\\\":\\{data_str}}\"\n  \"{\\\"jsonrpc\\\":\\\"2.0\\\",\\\"error\\\":\\{err_str},\\\"id\\\":\\{id_str}}\"\n}\n\nexport fn stringify_request(method: String, params: Json, id: RpcId) -> String {\n  let method_str = stringify(JStr(method))\n  let params_str = stringify(params)\n  let id_str = rpc_id_json_str(id)\n  \"{\\\"jsonrpc\\\":\\\"2.0\\\",\\\"method\\\":\\{method_str},\\\"params\\\":\\{params_str},\\\"id\\\":\\{id_str}}\"\n}\n\nexport fn stringify_response(id: RpcId, result: Json) -> String {\n  let result_str = stringify(result)\n  let id_str = rpc_id_json_str(id)\n  \"{\\\"jsonrpc\\\":\\\"2.0\\\",\\\"result\\\":\\{result_str},\\\"id\\\":\\{id_str}}\"\n}\n\nexport fn stringify_notification(method: String, params: Json) -> String {\n  let method_str = stringify(JStr(method))\n  let params_str = stringify(params)\n  \"{\\\"jsonrpc\\\":\\\"2.0\\\",\\\"method\\\":\\{method_str},\\\"params\\\":\\{params_str}}\"\n}\n\nexport fn RpcMessage::parse(input: String) -> Result[RpcMessage, String] {\n  parse_message(input)\n}\n\nexport fn RpcMessage::stringify_error(id: RpcId, code: Int, message: String, data: Json) -> String {\n  stringify_error(id, code, message, data)\n}\n\nexport fn RpcMessage::stringify_request(method: String, params: Json, id: RpcId) -> String {\n  stringify_request(method, params, id)\n}\n\nexport fn RpcMessage::stringify_response(id: RpcId, result: Json) -> String {\n  stringify_response(id, result)\n}\n\nexport fn RpcMessage::stringify_notification(method: String, params: Json) -> String {\n  stringify_notification(method, params)\n}\n")
}

let source_216 = () -> (String, String) {
  ("lib/@vibe/lsp/index.vpkg",
"name = @vibe/lsp\nversion = 0.0.1\ndescription =\n  #|@vibe/lsp — self-hosted `vibe lsp` Language Server Protocol server\n  #|(JSON-RPC 2.0 / Content-Length transport, initialize/hover/definition/\n  #|references/rename/documentSymbol/diagnostics/completion/signatureHelp/\n  #|workspaceSymbol).\ndeps = {\n  @vibe/compiler/runtime : 0.0.1\n  @vibe/core : 0.2.0\n  @vibe/json : 0.0.1\n  @vibe/parser : 0.1.0\n}\n\ngenerated_hash =\n\n// @vibe/lsp — extracted out of lib/@vibe/compiler/ (compiler 本体 のみを\n// 置く場所, docs/adding-modules.md) so its effect surface reads as an\n// ordinary package boundary rather than compiler-internal code: the whole\n// file only ever consumes @vibe/compiler/runtime's PUBLIC contract\n// (type_at_source / binding_occurrences / symbol_spans / doc_at_source /\n// collect_all_diagnostics), never compiler internals, so nothing about the\n// implementation actually required living inside lib/@vibe/compiler/.\n//\n// The `Lsp` effect itself (Hover/Definition/References/Rename/\n// DocumentSymbol/Diagnostics/Completion/SignatureHelp/WorkspaceSymbol) is\n// declared and fully discharged inside lsp_server.vibe's own\n// `lsp_run_with_handler` — see that function's doc comment for why\n// perform/handle stay textually co-located there (replay-safety, and the\n// #1070 effectful-closure-parameter trap this file already worked around\n// once). It never crosses this package's boundary, so it is deliberately\n// NOT part of the contract below.\n\nfn lsp_main() -> Int with { Stdin, Stdout }\nfn lsp_diagnostics_safe(source: String) -> Json\nfn lsp_diagnostics_json_string(source: String) -> String\n")
}

let source_217 = () -> (String, String) {
  ("lib/@vibe/lsp/lsp_server.vibe",
"\n\nimport @vibe/compiler/runtime {\n  binding_occurrences, collect_all_diagnostics, doc_at_source, symbol_spans, type_at_source\n}\n\nimport @vibe/parser {\n  offset_to_line_col\n}\n\nimport @vibe/core {\n  array_empty\n}\n\nimport @vibe/json {\n  Json\n}\n\n\neffect Lsp {\n  Hover(String, Int, Int) -> Json\n  Definition(String, Int, Int) -> Json\n  References(String, Int, Int) -> Json\n  Rename(String, Int, Int, String) -> Json\n  DocumentSymbol(String) -> Json\n  Diagnostics(String) -> Json\n  Completion(String, Int, Int) -> Json\n  SignatureHelp(String, Int, Int) -> Json\n  WorkspaceSymbol(String) -> Json\n}\n\n\nfn lsp_read_header_line() -> String with { Stdin } {\n  let mut acc = \"\"\n  let mut done = false\n  while not(done) {\n    let c = Stdin::read_char()\n    if c < 0 {\n      done = true\n    } else if c == 10 {\n      done = true\n    } else if c == 13 {\n      ()\n    } else {\n      acc = String::concat(acc, String::from_char_code(c))\n    }\n  }\n  acc\n}\n\nfn lsp_parse_uint_or(s: String, default: Int) -> Int {\n  let len = String::length(s)\n  if len == 0 {\n    default\n  } else {\n    let mut i = 0\n    let mut acc = 0\n    let mut ok = true\n    while ok && i < len {\n      let c = String::char_code_at(s, i)\n      if c >= '0' && c <= '9' {\n        acc = acc * 10 + (c - '0')\n        i = i + 1\n      } else {\n        ok = false\n      }\n    }\n    if ok {\n      acc\n    } else {\n      default\n    }\n  }\n}\n\nfn lsp_read_content_length() -> Int with { Stdin } {\n  let mut content_length = -1\n  let mut done = false\n  let mut saw_any = false\n  while not(done) {\n    let line = lsp_read_header_line()\n    if String::length(line) == 0 {\n      done = true\n    } else {\n      saw_any = true\n      if String::starts_with(line, \"Content-Length:\") {\n        let rest = String::trim(line[16: String::length(line)])\n        content_length = lsp_parse_uint_or(rest, -1)\n      } else {\n        ()\n      }\n    }\n  }\n  if saw_any {\n    content_length\n  } else {\n    -1\n  }\n}\n\nfn lsp_read_body(n: Int) -> String with { Stdin } {\n  let sb = StringBuilder::new()\n  let mut remaining = n\n  let mut eof = false\n  while remaining > 0 && not(eof) {\n    let chunk = Stdin::read_stream(remaining)\n    if String::length(chunk) == 0 {\n      eof = true\n    } else {\n      StringBuilder::push(sb, chunk)\n      remaining = remaining - String::length(chunk)\n    }\n  }\n  StringBuilder::freeze(sb)\n}\n\nfn lsp_read_message() -> Option[String] with { Stdin } {\n  let content_length = lsp_read_content_length()\n  if content_length < 0 {\n    None\n  } else {\n    Some(lsp_read_body(content_length))\n  }\n}\n\nfn lsp_write_message(body: String) -> Unit with { Stdout } {\n  let len = String::length(body)\n  Stdout::write_stream(\"Content-Length: \")\n  Stdout::write_stream(Int::to_string(len))\n  Stdout::write_stream(\"\\r\\n\\r\\n\")\n  Stdout::write_stream(body)\n}\n\n\nfn jnum_int(n: Int) -> Json {\n  JNum(Int::to_double(n))\n}\n\nfn jpos(line: Int, character: Int) -> Json {\n  JObj(Map::from_pairs([\n    (\"line\", jnum_int(line)),\n    (\"character\", jnum_int(character))\n  ]))\n}\n\nfn jrange(start_line: Int, start_char: Int, end_line: Int, end_char: Int) -> Json {\n  JObj(Map::from_pairs([\n    (\"start\", jpos(start_line, start_char)),\n    (\"end\", jpos(end_line, end_char))\n  ]))\n}\n\nfn jrange_pos(p1: (Int, Int), p2: (Int, Int)) -> Json {\n  let (l1, c1) = p1\n  let (l2, c2) = p2\n  jrange(l1, c1, l2, c2)\n}\n\nfn jlocation(uri: String, r: Json) -> Json {\n  JObj(Map::from_pairs([\n    (\"uri\", JStr(uri)),\n    (\"range\", r)\n  ]))\n}\n\nfn jparam_uri(params: Json) -> String {\n  Json::string(Json::field(Json::field(params, \"textDocument\"), \"uri\"))\n}\n\nfn jparam_line0(params: Json) -> Int {\n  Double::to_int(Json::number(Json::field(Json::field(params, \"position\"), \"line\")))\n}\n\nfn jparam_char0(params: Json) -> Int {\n  Double::to_int(Json::number(Json::field(Json::field(params, \"position\"), \"character\")))\n}\n\n\nfn lsp_utf8_seq_len(b0: Int) -> Int {\n  if b0 >= 0xF0 && b0 <= 0xF7 {\n    4\n  } else if b0 >= 0xE0 && b0 <= 0xEF {\n    3\n  } else if b0 >= 0xC2 && b0 <= 0xDF {\n    2\n  } else {\n    1\n  }\n}\n\nfn lsp_utf8_decode(source: String, pos: Int, seq_len: Int) -> Int {\n  if seq_len == 1 {\n    String::char_code_at(source, pos)\n  } else if seq_len == 2 {\n    let b0 = String::char_code_at(source, pos)&0x1F\n    let b1 = String::char_code_at(source, pos + 1)&0x3F\n    (b0<<6)|b1\n  } else if seq_len == 3 {\n    let b0 = String::char_code_at(source, pos)&0x0F\n    let b1 = String::char_code_at(source, pos + 1)&0x3F\n    let b2 = String::char_code_at(source, pos + 2)&0x3F\n    (b0<<12)|(b1<<6)|b2\n  } else {\n    let b0 = String::char_code_at(source, pos)&0x07\n    let b1 = String::char_code_at(source, pos + 1)&0x3F\n    let b2 = String::char_code_at(source, pos + 2)&0x3F\n    let b3 = String::char_code_at(source, pos + 3)&0x3F\n    (b0<<18)|(b1<<12)|(b2<<6)|b3\n  }\n}\n\nfn lsp_line_start_offset(source: String, line0: Int) -> Int {\n  if line0 <= 0 {\n    0\n  } else {\n    let len = String::length(source)\n    let mut pos = 0\n    let mut line = 0\n    let mut found = -1\n    while pos < len && found < 0 {\n      if String::char_code_at(source, pos) == 10 {\n        line = line + 1\n        if line == line0 {\n          found = pos + 1\n        }\n      }\n      pos = pos + 1\n    }\n    if found >= 0 {\n      found\n    } else {\n      len\n    }\n  }\n}\n\nfn lsp_line_end_offset(source: String, line_start: Int) -> Int {\n  let len = String::length(source)\n  let mut pos = line_start\n  while pos < len && String::char_code_at(source, pos) != 10 {\n    pos = pos + 1\n  }\n  pos\n}\n\nfn lsp_utf16_to_byte_col(source: String, line_start: Int, line_end: Int, utf16_target: Int) -> Int {\n  let mut pos = line_start\n  let mut units = 0\n  while pos < line_end && units < utf16_target {\n    let b0 = String::char_code_at(source, pos)\n    let seq_len = lsp_utf8_seq_len(b0)\n    let cp = lsp_utf8_decode(source, pos, seq_len)\n    let width = if cp > 0xFFFF {\n      2\n    } else {\n      1\n    }\n    pos = pos + seq_len\n    units = units + width\n  }\n  pos - line_start\n}\n\nfn lsp_byte_col_to_utf16(source: String, line_start: Int, byte_col: Int) -> Int {\n  let mut pos = line_start\n  let target = line_start + byte_col\n  let mut units = 0\n  while pos < target {\n    let b0 = String::char_code_at(source, pos)\n    let seq_len = lsp_utf8_seq_len(b0)\n    let cp = lsp_utf8_decode(source, pos, seq_len)\n    let width = if cp > 0xFFFF {\n      2\n    } else {\n      1\n    }\n    pos = pos + seq_len\n    units = units + width\n  }\n  units\n}\n\nfn lsp_pos_to_byte_col(source: String, line0: Int, utf16_char0: Int) -> Int {\n  let line_start = lsp_line_start_offset(source, line0)\n  let line_end = lsp_line_end_offset(source, line_start)\n  lsp_utf16_to_byte_col(source, line_start, line_end, utf16_char0)\n}\n\nfn lsp_offset_to_pos(source: String, offset: Int) -> (Int, Int) {\n  let (line1, col1) = offset_to_line_col(source, offset)\n  let line0 = line1 - 1\n  let byte_col0 = col1 - 1\n  let line_start = lsp_line_start_offset(source, line0)\n  (line0, lsp_byte_col_to_utf16(source, line_start, byte_col0))\n}\n\n\nfn lsp_split_labels(s: String) -> Array[String] {\n  if String::length(s) == 0 {\n    array_empty()\n  } else {\n    let out = array_empty()\n    let mut rest = s\n    let mut go = true\n    while go {\n      let idx = String::index_of(rest, \", \")\n      if idx < 0 {\n        Array::push(out, rest)\n        go = false\n      } else {\n        Array::push(out, rest[0: idx])\n        rest = rest[idx + 2: String::length(rest)]\n      }\n    }\n    out\n  }\n}\n\nfn lsp_effect_row_mismatch_fix(text: String) -> Json {\n  let prefix = \"effect row mismatch for '\"\n  if !String::starts_with(text, prefix) {\n    JNull\n  } else {\n    let after_prefix = text[String::length(prefix): String::length(text)]\n    let close_quote = String::index_of(after_prefix, \"'\")\n    if close_quote < 0 {\n      JNull\n    } else {\n      let fname = after_prefix[0: close_quote]\n      let missing_marker = \": missing { \"\n      let rest = after_prefix[close_quote: String::length(after_prefix)]\n      let mi = String::index_of(rest, missing_marker)\n      if mi < 0 {\n        JNull\n      } else {\n        let after_missing = rest[mi + String::length(missing_marker): String::length(rest)]\n        let mend = String::index_of(after_missing, \" }\")\n        if mend < 0 {\n          JNull\n        } else {\n          let missing_str = after_missing[0: mend]\n          let req_marker = \"requires { \"\n          let ri = String::index_of(after_missing, req_marker)\n          if ri < 0 {\n            JNull\n          } else {\n            let after_req = after_missing[ri + String::length(req_marker): String::length(after_missing)]\n            let rend = String::index_of(after_req, \" })\")\n            if rend < 0 {\n              JNull\n            } else {\n              let required_str = after_req[0: rend]\n              JObj(Map::from_pairs([\n                (\"kind\", JStr(\"add_with_clause\")),\n                (\"target\", JStr(fname)),\n                (\"add\", JArr(for x in lsp_split_labels(missing_str) {\n                  JStr(x)\n                })),\n                (\"with\", JArr(for x in lsp_split_labels(required_str) {\n                  JStr(x)\n                })),\n                (\"note\", JStr(\"no position included -- resolve `target`'s declaration via `vibe symbols <file>`\"))\n              ]))\n            }\n          }\n        }\n      }\n    }\n  }\n}\n\nfn lsp_diag_severity(text: String) -> Int {\n  if String::starts_with(text, \"warning: \") {\n    2\n  } else {\n    1\n  }\n}\n\nfn lsp_parse_diag_line(msg: String) -> Json {\n  if String::starts_with(msg, \"line \") {\n    let after = msg[5: String::length(msg)]\n    let colon1 = String::index_of(after, \":\")\n    if colon1 < 0 {\n      lsp_diag_fallback(msg)\n    } else {\n      let line_str = after[0: colon1]\n      let rest1 = after[colon1 + 1: String::length(after)]\n      let colon2 = String::index_of(rest1, \":\")\n      if colon2 < 0 {\n        lsp_diag_fallback(msg)\n      } else {\n        let col_str = rest1[0: colon2]\n        let text = String::trim(rest1[colon2 + 1: String::length(rest1)])\n        let line1 = lsp_parse_uint_or(line_str, 1)\n        let col1 = lsp_parse_uint_or(col_str, 1)\n        let line0 = if line1 > 0 {\n          line1 - 1\n        } else {\n          0\n        }\n        let col0 = if col1 > 0 {\n          col1 - 1\n        } else {\n          0\n        }\n        JObj(Map::from_pairs([\n          (\"range\", jrange(line0, col0, line0, col0 + 1)),\n          (\"severity\", jnum_int(lsp_diag_severity(text))),\n          (\"source\", JStr(\"vibe\")),\n          (\"message\", JStr(text)),\n          (\"data\", lsp_effect_row_mismatch_fix(text))\n        ]))\n      }\n    }\n  } else {\n    lsp_diag_fallback(msg)\n  }\n}\n\nfn lsp_diag_fallback(msg: String) -> Json {\n  JObj(Map::from_pairs([\n    (\"range\", jrange(0, 0, 0, 1)),\n    (\"severity\", jnum_int(lsp_diag_severity(msg))),\n    (\"source\", JStr(\"vibe\")),\n    (\"message\", JStr(msg)),\n    (\"data\", lsp_effect_row_mismatch_fix(msg))\n  ]))\n}\n\n\nfn lsp_handle_hover(source: String, line0: Int, char0: Int) -> Json {\n  let ty = type_at_source(source, line0 + 1, char0 + 1)\n  let doc = doc_at_source(source, line0 + 1, char0 + 1)\n  if String::length(ty) == 0 && String::length(doc) == 0 {\n    JNull\n  } else {\n    let ty_block = if String::length(ty) == 0 {\n      \"\"\n    } else {\n      String::concat(\"```vibe\\n\", String::concat(ty, \"\\n```\"))\n    }\n    let body = if String::length(doc) == 0 {\n      ty_block\n    } else if String::length(ty_block) == 0 {\n      doc\n    } else {\n      String::concat(ty_block, String::concat(\"\\n\\n\", doc))\n    }\n    JObj(Map::from_pairs([\n      (\"contents\", JObj(Map::from_pairs([\n        (\"kind\", JStr(\"markdown\")),\n        (\"value\", JStr(body))\n      ])))\n    ]))\n  }\n}\n\nfn lsp_handle_definition(source: String, uri: String, line0: Int, char0: Int) -> Json {\n  let occ = binding_occurrences(source, line0 + 1, char0 + 1)\n  if Array::length(occ) == 0 {\n    JNull\n  } else {\n    let (start_off, _end_off) = Array::get(occ, 0)\n    let p = lsp_offset_to_pos(source, start_off)\n    let (l, c) = p\n    jlocation(uri, jrange(l, c, l, c))\n  }\n}\n\nfn lsp_handle_references(source: String, uri: String, line0: Int, char0: Int) -> Json {\n  let occ = binding_occurrences(source, line0 + 1, char0 + 1)\n  JArr(for pair in occ {\n    let (start_off, end_off) = pair\n    let ps = lsp_offset_to_pos(source, start_off)\n    let pe = lsp_offset_to_pos(source, end_off)\n    jlocation(uri, jrange_pos(ps, pe))\n  })\n}\n\nfn lsp_handle_rename(source: String, uri: String, line0: Int, char0: Int, new_name: String) -> Json {\n  let occ = binding_occurrences(source, line0 + 1, char0 + 1)\n  if Array::length(occ) == 0 {\n    JNull\n  } else {\n    let edits = for pair in occ {\n      let (start_off, end_off) = pair\n      let ps = lsp_offset_to_pos(source, start_off)\n      let pe = lsp_offset_to_pos(source, end_off)\n      JObj(Map::from_pairs([\n        (\"range\", jrange_pos(ps, pe)),\n        (\"newText\", JStr(new_name))\n      ]))\n    }\n    let changes = Map::set(Map::new(), uri, JArr(edits))\n    JObj(Map::from_pairs([\n      (\"changes\", JObj(changes))\n    ]))\n  }\n}\n\nfn lsp_handle_document_symbol(source: String) -> Json with { Error } {\n  let syms = symbol_spans(source)\n  JArr(for entry in syms {\n    let (name, kind, start_off, end_off) = entry\n    let ps = lsp_offset_to_pos(source, start_off)\n    let pe = lsp_offset_to_pos(source, end_off)\n    let r = jrange_pos(ps, pe)\n    JObj(Map::from_pairs([\n      (\"name\", JStr(name)),\n      (\"kind\", jnum_int(kind)),\n      (\"range\", r),\n      (\"selectionRange\", r)\n    ]))\n  })\n}\n\nfn lsp_handle_diagnostics(source: String) -> Json with { Error } {\n  let diags = collect_all_diagnostics(source)\n  JArr(for msg in diags {\n    lsp_parse_diag_line(msg)\n  })\n}\n\nfn lsp_document_symbol_safe(source: String) -> Json {\n  handle {\n    lsp_handle_document_symbol(source)\n  } with Error {\n    Throw(_) => JArr([\n    ])\n  }\n}\n\nexport fn lsp_diagnostics_safe(source: String) -> Json {\n  handle {\n    lsp_handle_diagnostics(source)\n  } with Error {\n    Throw(_) => JArr([\n    ])\n  }\n}\n\nexport fn lsp_diagnostics_json_string(source: String) -> String {\n  Json::stringify(lsp_diagnostics_safe(source))\n}\n\n\nfn lsp_completion_item_kind(sym_kind: Int) -> Int {\n  if sym_kind == 12 {\n    3\n  } else if sym_kind == 13 {\n    6\n  } else if sym_kind == 10 {\n    13\n  } else if sym_kind == 23 {\n    22\n  } else if sym_kind == 11 {\n    8\n  } else if sym_kind == 24 {\n    23\n  } else if sym_kind == 2 {\n    9\n  } else {\n    7\n  }\n}\n\nfn lsp_keyword_completions() -> Array[String] {\n  [\n    \"let\",\n    \"mut\",\n    \"fn\",\n    \"enum\",\n    \"struct\",\n    \"trait\",\n    \"impl\",\n    \"effect\",\n    \"effectset\",\n    \"handle\",\n    \"with\",\n    \"perform\",\n    \"resume\",\n    \"match\",\n    \"if\",\n    \"else\",\n    \"while\",\n    \"for\",\n    \"in\",\n    \"return\",\n    \"break\",\n    \"continue\",\n    \"import\",\n    \"export\",\n    \"test\",\n    \"bench\",\n    \"throw\",\n    \"true\",\n    \"false\",\n    \"type\"\n  ]\n}\n\nfn lsp_keyword_items() -> Array[Json] {\n  for kw in lsp_keyword_completions() {\n    JObj(Map::from_pairs([\n      (\"label\", JStr(kw)),\n      (\"kind\", jnum_int(14))\n    ]))\n  }\n}\n\nfn lsp_handle_completion(source: String) -> Json with { Error } {\n  let syms = symbol_spans(source)\n  let sym_items = for entry in syms {\n    let (name, kind, _, _) = entry\n    JObj(Map::from_pairs([\n      (\"label\", JStr(name)),\n      (\"kind\", jnum_int(lsp_completion_item_kind(kind)))\n    ]))\n  }\n  JArr(Array::concat(sym_items, lsp_keyword_items()))\n}\n\nfn lsp_completion_safe(source: String) -> Json {\n  handle {\n    lsp_handle_completion(source)\n  } with Error {\n    Throw(_) => JArr(lsp_keyword_items())\n  }\n}\n\nfn lsp_is_ident_byte(b: Int) -> Bool {\n  (b >= 48 && b <= 57) || (b >= 65 && b <= 90) || (b >= 97 && b <= 122) || b == 95 || b == 58\n}\n\nfn lsp_call_open_paren(source: String, cursor: Int) -> (Int, Int) {\n  let mut pos = cursor - 1\n  let mut depth = 0\n  let mut commas = 0\n  let mut open_off = -1\n  let mut stopped = false\n  while pos >= 0 && open_off < 0 && !stopped {\n    let b = String::char_code_at(source, pos)\n    if b == 41 || b == 93 || b == 125 {\n      depth = depth + 1\n    } else if b == 40 {\n      if depth == 0 {\n        open_off = pos\n      } else {\n        depth = depth - 1\n      }\n    } else if b == 91 || b == 123 {\n      if depth > 0 {\n        depth = depth - 1\n      } else {\n        stopped = true\n      }\n    } else if b == 44 && depth == 0 {\n      commas = commas + 1\n    } else {\n      ()\n    }\n    if open_off < 0 {\n      pos = pos - 1\n    } else {\n      ()\n    }\n  }\n  (open_off, commas)\n}\n\nfn lsp_signature_param_labels(ty: String) -> Array[String] {\n  let out = array_empty()\n  let len = String::length(ty)\n  if len == 0 || String::char_code_at(ty, 0) != 40 {\n    out\n  } else {\n    let mut depth = 1\n    let mut pos = 1\n    let mut seg_start = 1\n    let mut done = false\n    while pos < len && !done {\n      let b = String::char_code_at(ty, pos)\n      if b == 40 || b == 91 {\n        depth = depth + 1\n      } else if b == 41 || b == 93 {\n        depth = depth - 1\n        if depth == 0 {\n          if pos > seg_start {\n            Array::push(out, String::trim(ty[seg_start: pos]))\n          } else {\n            ()\n          }\n          done = true\n        } else {\n          ()\n        }\n      } else if b == 44 && depth == 1 {\n        Array::push(out, String::trim(ty[seg_start: pos]))\n        seg_start = pos + 1\n      } else {\n        ()\n      }\n      pos = pos + 1\n    }\n    out\n  }\n}\n\nfn lsp_handle_signature_help(source: String, line0: Int, byte_col: Int) -> Json {\n  let cursor = lsp_line_start_offset(source, line0) + byte_col\n  let (open_off, commas) = lsp_call_open_paren(source, cursor)\n  if open_off < 0 {\n    JNull\n  } else {\n    let mut e = open_off\n    while e > 0 && (String::char_code_at(source, e - 1) == 32 || String::char_code_at(source, e - 1) == 9) {\n      e = e - 1\n    }\n    let mut s = e\n    while s > 0 && lsp_is_ident_byte(String::char_code_at(source, s - 1)) {\n      s = s - 1\n    }\n    if s == e {\n      JNull\n    } else {\n      let name = source[s: e]\n      let (l1, c1) = offset_to_line_col(source, s)\n      let occ = binding_occurrences(source, l1, c1)\n      let (tl, tc) = if Array::length(occ) > 0 {\n        let (def_start, _) = Array::get(occ, 0)\n        offset_to_line_col(source, def_start)\n      } else {\n        (l1, c1)\n      }\n      let ty = type_at_source(source, tl, tc)\n      if String::length(ty) == 0 {\n        JNull\n      } else {\n        let params = for p in lsp_signature_param_labels(ty) {\n          JObj(Map::from_pairs([\n            (\"label\", JStr(p))\n          ]))\n        }\n        JObj(Map::from_pairs([\n          (\"signatures\", JArr([\n            JObj(Map::from_pairs([\n              (\"label\", JStr(String::concat(name, String::concat(\": \", ty)))),\n              (\"parameters\", JArr(params))\n            ]))\n          ])),\n          (\"activeSignature\", jnum_int(0)),\n          (\"activeParameter\", jnum_int(commas))\n        ]))\n      }\n    }\n  }\n}\n\nfn lsp_symbols_for_doc_safe(source: String) -> Array[(String, Int, Int, Int)] {\n  handle {\n    symbol_spans(source)\n  } with Error {\n    Throw(_) => Array::slice([\n      (\"\", 0, 0, 0)\n    ], 0, 0)\n  }\n}\n\nfn lsp_ascii_lower(s: String) -> String {\n  let len = String::length(s)\n  let sb = StringBuilder::new()\n  let mut i = 0\n  while i < len {\n    let code = String::char_code_at(s, i)\n    let lower = if code >= 65 && code <= 90 {\n      code + 32\n    } else {\n      code\n    }\n    StringBuilder::push(sb, String::from_char_code(lower))\n    i = i + 1\n  }\n  StringBuilder::freeze(sb)\n}\n\nfn lsp_query_matches(name: String, query_lower: String) -> Bool {\n  String::length(query_lower) == 0 || String::contains(lsp_ascii_lower(name), query_lower)\n}\n\nfn lsp_handle_workspace_symbol(query: String, docs: Map[String, String]) -> Json {\n  let query_lower = lsp_ascii_lower(query)\n  let out = array_empty()\n  let uris = Map::keys(docs)\n  let mut ui = 0\n  while ui < Array::length(uris) {\n    let uri = Array::get(uris, ui)\n    let src = lsp_doc_text(docs, uri)\n    let syms = lsp_symbols_for_doc_safe(src)\n    let mut si = 0\n    while si < Array::length(syms) {\n      let (name, kind, start_off, end_off) = Array::get(syms, si)\n      if lsp_query_matches(name, query_lower) {\n        let ps = lsp_offset_to_pos(src, start_off)\n        let pe = lsp_offset_to_pos(src, end_off)\n        Array::push(out, JObj(Map::from_pairs([\n          (\"name\", JStr(name)),\n          (\"kind\", jnum_int(kind)),\n          (\"location\", jlocation(uri, jrange_pos(ps, pe)))\n        ])))\n      } else {\n        ()\n      }\n      si = si + 1\n    }\n    ui = ui + 1\n  }\n  JArr(out)\n}\n\nfn lsp_op_hover() -> Int {\n  0\n}\nfn lsp_op_definition() -> Int {\n  1\n}\nfn lsp_op_references() -> Int {\n  2\n}\nfn lsp_op_rename() -> Int {\n  3\n}\nfn lsp_op_document_symbol() -> Int {\n  4\n}\nfn lsp_op_diagnostics() -> Int {\n  5\n}\nfn lsp_op_completion() -> Int {\n  6\n}\nfn lsp_op_signature_help() -> Int {\n  7\n}\nfn lsp_op_workspace_symbol() -> Int {\n  8\n}\n\nfn lsp_run_with_handler(op: Int, uri: String, l: Int, c: Int, new_name: String, docs: Map[String, String]) -> Json {\n  handle {\n    if op == lsp_op_hover() {\n      perform Lsp::Hover(uri, l, c)\n    } else if op == lsp_op_definition() {\n      perform Lsp::Definition(uri, l, c)\n    } else if op == lsp_op_references() {\n      perform Lsp::References(uri, l, c)\n    } else if op == lsp_op_rename() {\n      perform Lsp::Rename(uri, l, c, new_name)\n    } else if op == lsp_op_document_symbol() {\n      perform Lsp::DocumentSymbol(uri)\n    } else if op == lsp_op_completion() {\n      perform Lsp::Completion(uri, l, c)\n    } else if op == lsp_op_signature_help() {\n      perform Lsp::SignatureHelp(uri, l, c)\n    } else if op == lsp_op_workspace_symbol() {\n      perform Lsp::WorkspaceSymbol(new_name)\n    } else {\n      perform Lsp::Diagnostics(uri)\n    }\n  } with Lsp {\n    Hover(u2, l2, c2) => resume({\n      let src = lsp_doc_text(docs, u2)\n      lsp_handle_hover(src, l2, lsp_pos_to_byte_col(src, l2, c2))\n    });\n    Definition(u2, l2, c2) => resume({\n      let src = lsp_doc_text(docs, u2)\n      lsp_handle_definition(src, u2, l2, lsp_pos_to_byte_col(src, l2, c2))\n    });\n    References(u2, l2, c2) => resume({\n      let src = lsp_doc_text(docs, u2)\n      lsp_handle_references(src, u2, l2, lsp_pos_to_byte_col(src, l2, c2))\n    });\n    Rename(u2, l2, c2, nn) => resume({\n      let src = lsp_doc_text(docs, u2)\n      lsp_handle_rename(src, u2, l2, lsp_pos_to_byte_col(src, l2, c2), nn)\n    });\n    DocumentSymbol(u2) => resume(lsp_document_symbol_safe(lsp_doc_text(docs, u2)));\n    Diagnostics(u2) => resume(lsp_diagnostics_safe(lsp_doc_text(docs, u2)));\n    Completion(u2, _, _) => resume(lsp_completion_safe(lsp_doc_text(docs, u2)));\n    SignatureHelp(u2, l2, c2) => resume({\n      let src = lsp_doc_text(docs, u2)\n      lsp_handle_signature_help(src, l2, lsp_pos_to_byte_col(src, l2, c2))\n    });\n    WorkspaceSymbol(q) => resume(lsp_handle_workspace_symbol(q, docs))\n  }\n}\n\nfn lsp_doc_text(docs: Map[String, String], uri: String) -> String {\n  if Map::has_key(docs, uri) {\n    Map::get(docs, uri)\n  } else {\n    \"\"\n  }\n}\n\n\nfn lsp_capabilities() -> Json {\n  JObj(Map::from_pairs([\n    (\"textDocumentSync\", jnum_int(1)),\n    (\"hoverProvider\", JBool(true)),\n    (\"definitionProvider\", JBool(true)),\n    (\"referencesProvider\", JBool(true)),\n    (\"renameProvider\", JBool(true)),\n    (\"documentSymbolProvider\", JBool(true)),\n    (\"completionProvider\", JObj(Map::from_pairs([\n      (\"triggerCharacters\", JArr([\n        JStr(\".\"),\n        JStr(\":\")\n      ]))\n    ]))),\n    (\"signatureHelpProvider\", JObj(Map::from_pairs([\n      (\"triggerCharacters\", JArr([\n        JStr(\"(\"),\n        JStr(\",\")\n      ]))\n    ]))),\n    (\"workspaceSymbolProvider\", JBool(true))\n  ]))\n}\n\nfn lsp_initialize_result() -> Json {\n  JObj(Map::from_pairs([\n    (\"capabilities\", lsp_capabilities()),\n    (\"serverInfo\", JObj(Map::from_pairs([\n      (\"name\", JStr(\"vibe-lsp-selfhost\")),\n      (\"version\", JStr(\"0.1.0\"))\n    ])))\n  ]))\n}\n\nfn lsp_dispatch_request(method: String, params: Json, docs: Map[String, String]) -> Json {\n  if method == \"initialize\" {\n    lsp_initialize_result()\n  } else if method == \"textDocument/hover\" {\n    let uri = jparam_uri(params)\n    let l = jparam_line0(params)\n    let c = jparam_char0(params)\n    lsp_run_with_handler(lsp_op_hover(), uri, l, c, \"\", docs)\n  } else if method == \"textDocument/definition\" {\n    let uri = jparam_uri(params)\n    let l = jparam_line0(params)\n    let c = jparam_char0(params)\n    lsp_run_with_handler(lsp_op_definition(), uri, l, c, \"\", docs)\n  } else if method == \"textDocument/references\" {\n    let uri = jparam_uri(params)\n    let l = jparam_line0(params)\n    let c = jparam_char0(params)\n    lsp_run_with_handler(lsp_op_references(), uri, l, c, \"\", docs)\n  } else if method == \"textDocument/rename\" {\n    let uri = jparam_uri(params)\n    let l = jparam_line0(params)\n    let c = jparam_char0(params)\n    let new_name = Json::string(Json::field(params, \"newName\"))\n    lsp_run_with_handler(lsp_op_rename(), uri, l, c, new_name, docs)\n  } else if method == \"textDocument/documentSymbol\" {\n    let uri = jparam_uri(params)\n    lsp_run_with_handler(lsp_op_document_symbol(), uri, 0, 0, \"\", docs)\n  } else if method == \"textDocument/completion\" {\n    let uri = jparam_uri(params)\n    let l = jparam_line0(params)\n    let c = jparam_char0(params)\n    lsp_run_with_handler(lsp_op_completion(), uri, l, c, \"\", docs)\n  } else if method == \"textDocument/signatureHelp\" {\n    let uri = jparam_uri(params)\n    let l = jparam_line0(params)\n    let c = jparam_char0(params)\n    lsp_run_with_handler(lsp_op_signature_help(), uri, l, c, \"\", docs)\n  } else if method == \"workspace/symbol\" {\n    let q = Json::string(Json::field(params, \"query\"))\n    lsp_run_with_handler(lsp_op_workspace_symbol(), \"\", 0, 0, q, docs)\n  } else if method == \"shutdown\" {\n    JNull\n  } else {\n    JNull\n  }\n}\n\nfn lsp_diagnostics_for(uri: String, docs: Map[String, String]) -> Json {\n  lsp_run_with_handler(lsp_op_diagnostics(), uri, 0, 0, \"\", docs)\n}\n\n\nfn lsp_apply_did_open(docs: Map[String, String], params: Json) -> Map[String, String] {\n  let uri = jparam_uri(params)\n  let text = Json::string(Json::field(Json::field(params, \"textDocument\"), \"text\"))\n  Map::set(docs, uri, text)\n}\n\nfn lsp_apply_did_change(docs: Map[String, String], params: Json) -> Map[String, String] {\n  let uri = jparam_uri(params)\n  let changes = Json::field(params, \"contentChanges\")\n  if Json::length(changes) == 0 {\n    docs\n  } else {\n    let last = Json::index(changes, Json::length(changes) - 1)\n    let text = Json::string(Json::field(last, \"text\"))\n    Map::set(docs, uri, text)\n  }\n}\n\nfn lsp_apply_did_close(docs: Map[String, String], params: Json) -> Map[String, String] {\n  let uri = jparam_uri(params)\n  Map::delete(docs, uri)\n}\n\n\nfn lsp_parse_envelope(body: String) -> Json {\n  Json::parse(body)\n}\n\nfn lsp_env_method(j: Json) -> String {\n  Json::string(Json::field(j, \"method\"))\n}\n\nfn lsp_env_params(j: Json) -> Json {\n  Json::field(j, \"params\")\n}\n\nfn lsp_env_id(j: Json) -> Json {\n  Json::field(j, \"id\")\n}\n\nfn lsp_env_is_request(j: Json) -> Bool {\n  String::length(lsp_env_method(j)) > 0 && !Json::is_null(lsp_env_id(j))\n}\n\nfn lsp_env_is_notification(j: Json) -> Bool {\n  String::length(lsp_env_method(j)) > 0 && Json::is_null(lsp_env_id(j))\n}\n\nfn lsp_stringify_response(id: Json, result: Json) -> String {\n  Json::stringify(JObj(Map::from_pairs([\n    (\"jsonrpc\", JStr(\"2.0\")),\n    (\"id\", id),\n    (\"result\", result)\n  ])))\n}\n\nfn lsp_stringify_notification(method: String, params: Json) -> String {\n  Json::stringify(JObj(Map::from_pairs([\n    (\"jsonrpc\", JStr(\"2.0\")),\n    (\"method\", JStr(method)),\n    (\"params\", params)\n  ])))\n}\n\n\nfn lsp_send_response(id: Json, result: Json) -> Unit with { Stdout } {\n  lsp_write_message(lsp_stringify_response(id, result))\n}\n\nfn lsp_send_diagnostics_notification(uri: String, diags: Json) -> Unit with { Stdout } {\n  let params = JObj(Map::from_pairs([\n    (\"uri\", JStr(uri)),\n    (\"diagnostics\", diags)\n  ]))\n  lsp_write_message(lsp_stringify_notification(\"textDocument/publishDiagnostics\", params))\n}\n\nfn lsp_step(docs: Map[String, String]) -> (Map[String, String], Bool) with { Stdin, Stdout } {\n  match lsp_read_message() {\n    None => (docs, true),\n    Some(body) => {\n      let msg = lsp_parse_envelope(body)\n      if lsp_env_is_request(msg) {\n        let method = lsp_env_method(msg)\n        let params = lsp_env_params(msg)\n        let id = lsp_env_id(msg)\n        let result = lsp_dispatch_request(method, params, docs)\n        lsp_send_response(id, result)\n        (docs, false)\n      } else if lsp_env_is_notification(msg) {\n        let method = lsp_env_method(msg)\n        let params = lsp_env_params(msg)\n        if method == \"exit\" {\n          (docs, true)\n        } else if method == \"initialized\" {\n          (docs, false)\n        } else if method == \"textDocument/didOpen\" {\n          let new_docs = lsp_apply_did_open(docs, params)\n          let uri = jparam_uri(params)\n          lsp_send_diagnostics_notification(uri, lsp_diagnostics_for(uri, new_docs))\n          (new_docs, false)\n        } else if method == \"textDocument/didChange\" {\n          let new_docs = lsp_apply_did_change(docs, params)\n          let uri = jparam_uri(params)\n          lsp_send_diagnostics_notification(uri, lsp_diagnostics_for(uri, new_docs))\n          (new_docs, false)\n        } else if method == \"textDocument/didSave\" {\n          let uri = jparam_uri(params)\n          lsp_send_diagnostics_notification(uri, lsp_diagnostics_for(uri, docs))\n          (docs, false)\n        } else if method == \"textDocument/didClose\" {\n          let new_docs = lsp_apply_did_close(docs, params)\n          let uri = jparam_uri(params)\n          lsp_send_diagnostics_notification(uri, JArr([\n          ]))\n          (new_docs, false)\n        } else {\n          (docs, false)\n        }\n      } else {\n        (docs, false)\n      }\n    }\n  }\n}\n\nexport fn lsp_main() -> Int with { Stdin, Stdout } {\n  let mut docs = Map::new()\n  let mut running = true\n  while running {\n    let (new_docs, should_exit) = lsp_step(docs)\n    docs = new_docs\n    running = not(should_exit)\n  }\n  0\n}\n")
}

let source_218 = () -> (String, String) {
  ("lib/@vibe/compiler/contract/index.vpkg",
"name = @vibe/compiler/contract\nversion = 0.0.1\ndescription =\n  #|@vibe/compiler/contract — the .vpkg/.vibei contract conformance engine\ndeps = {\n  @vibe/compiler/core : 0.0.1\n  @vibe/compiler/syntax : 0.0.1\n  @vibe/core : 0.2.0\n}\n\ngenerated_hash =\n\n// @vibe/compiler/contract — the .vpkg/.vibei contract conformance engine\n// itself (ADR-0063 Phase C, #729): bodyless-declaration parsing, impl\n// def/type collection, conformance checking, facade generation, contract /\n// package hashing, and the semver bump classifier (#731/#752/#847).\n// COMPILER-INTERNAL contract batch 2 (ADR-0070 Phase 3, #897) — compiled\n// into the compiler itself via compiler_sources_manifest.tsv (group\n// `loader`, dual-row: this contract + contract.vibe). Yes: the conformance\n// engine now checks its own contract.\n//\n// The old index.vibe was not a facade but the whole implementation (the\n// package is single-file), so it moved verbatim to contract.vibe. The\n// surface is fns plus two exported String constants (`let name: Type`\n// bodyless value declarations, #752; @vibe/cache `version` precedent,\n// PR #914). No exported types: every struct/enum this package touches\n// (Stmt/Token/TypeExpr) is owned by ../core / ../syntax and arrives as\n// structural signature text resolved against the implementation imports\n// when the facade is merged in (@vibe/symbol / @vibe/parser precedent —\n// no re-import needed here). The impl's trailing bare\n// `export { parse_contract_program, ... }` block (SExport) re-exports\n// names this file already defines+exports, is invisible to check_contract\n// (which only sees SLet defs and SReExport), and stays verbatim in\n// contract.vibe. No `version` binding existed (compiler-internal package).\n\n// --- facade / shared-import markers (#740/#753, #897)\nlet contract_facade_marker: String\nlet vpkg_shared_import_marker: String\n\n// --- contract grammar\nfn parse_contract_program(tokens: Array[Token]) -> (Array[(String, String)], Array[(String, Int)], Array[Stmt]) with { Error }\nfn classify_contract_stmts(stmts: Array[Stmt]) -> (Array[String], Array[Stmt]) with { Error }\nfn contract_impl_import_raw_paths(stmts: Array[Stmt]) -> Array[String] with { Error }\nfn contract_directory_shared_imports(stmts: Array[Stmt]) -> Array[Stmt]\nfn contract_directory_shared_import_prefix_text(stmts: Array[Stmt]) -> String\n\n// --- implementation surface collection + conformance\nfn collect_impl_fn_defs(stmts: Array[Stmt]) -> Array[(String, Option[String], Bool)]\nfn collect_impl_type_defs(stmts: Array[Stmt]) -> Array[(String, Bool, Int)]\nfn check_contract(decls: Array[(String, String)], opaque_names: Array[(String, Int)], impl_stmts: Array[Stmt], contract_type_defs: Array[Stmt]) -> Array[String]\n\n// --- facade generation\nfn contract_facade_source(decls: Array[(String, String)], opaque_names: Array[(String, Int)], type_defs: Array[Stmt], impl_units: Array[(String, Array[Stmt])]) -> String with { Error }\n\n// --- hashing\nfn contract_hash(fn_decls: Array[(String, String)], opaque_names: Array[(String, Int)], type_defs: Array[Stmt]) -> String\nfn package_hash_from_sources(sources: Array[(String, String)]) -> String\n\n// --- version / pin grammar (#751/#752)\nfn is_strict_semver(v: String) -> Bool\nfn is_package_pin(h: String) -> Bool\nfn extract_require_pins(source: String) -> (Array[(String, String, String)], String) with { Error }\nfn extract_package_version(source: String) -> String with { Error }\n\n// --- package header grammar (#1128)\nfn extract_package_name(source: String) -> String with { Error }\nfn extract_package_main(source: String) -> Bool with { Error }\nfn extract_package_description(source: String) -> String with { Error }\nfn extract_package_deps(source: String) -> Array[(String, String)] with { Error }\nfn extract_package_generated_hash(source: String) -> String with { Error }\nfn canonicalize_for_hash(source: String) -> String with { Error }\nfn replace_generated_hash_directive(source: String, new_value: String) -> String with { Error }\nfn deps_missing_for_imports(deps: Array[(String, String)], impl_sources: Array[String]) -> Array[String]\n\n// --- semver surface diff (#731)\nfn contract_surface_lines(fn_decls: Array[(String, String)], opaque_names: Array[(String, Int)], type_defs: Array[Stmt]) -> Array[String]\nfn classify_contract_change(old_lines: Array[String], new_lines: Array[String]) -> String\nfn semver_bump_kind(prev: String, next: String) -> Option[String]\nfn verify_publish_bump(prev_version: String, next_version: String, old_lines: Array[String], new_lines: Array[String]) -> Array[String]\n")
}

let source_219 = () -> (String, String) {
  ("lib/@vibe/compiler/contract/contract.vibe",
"\nimport @vibe/compiler/core {\n  Expr, Stmt, TypeExpr\n}\n\nimport @vibe/compiler/syntax {\n  Token, parse_fn_signature, parse_stmt, parse_type, peek, print_stmt, print_type_expr, tk_name\n}\n\nimport @vibe/core {\n  array_empty, sha1\n}\n\n\nexport let contract_facade_marker: String = \"// vibe: contract facade (desugared from .vibei)\\n\"\n\nexport let vpkg_shared_import_marker: String = \"// vibe: vpkg directory-shared imports (#897)\\n\"\n\n\nfn fn_sig_text(tps: Array[String], tbs: Array[(String, Array[String])], params: Array[(String, Option[TypeExpr])], ret_ty: TypeExpr, eff_opt: Option[String]) -> Option[String] {\n  let mut missing = false\n  let parts = array_empty()\n  let mut i = 0\n  while i < Array::length(params) {\n    let (pname, pty_opt) = Array::get(params, i)\n    match pty_opt {\n      Some(pty) => {\n        let tystr = print_type_expr(pty)\n        let entry = if String::ends_with(pname, \"~\") {\n          \"\\{pname}: \\{tystr}\"\n        } else tystr\n        Array::push(parts, entry)\n      },\n      None => {\n        missing = true\n      }\n    }\n    i = i + 1\n  }\n  if missing {\n    None\n  } else {\n    let gen = if Array::length(tps) == 0 {\n      \"\"\n    } else {\n      let entries = array_empty()\n      let mut gi = 0\n      while gi < Array::length(tps) {\n        let tp = Array::get(tps, gi)\n        let mut bound = \"\"\n        let mut bi = 0\n        while bi < Array::length(tbs) {\n          let (bname, bnds) = Array::get(tbs, bi)\n          if bname == tp && Array::length(bnds) > 0 {\n            bound = String::join(bnds, \" + \")\n          } else ()\n          bi = bi + 1\n        }\n        let entry = if String::length(bound) == 0 {\n          tp\n        } else \"\\{tp}: \\{bound}\"\n        Array::push(entries, entry)\n        gi = gi + 1\n      }\n      \"[\\{String::join(entries, \", \")}]\"\n    }\n    let eff = match eff_opt {\n      Some(e) => \" with { \\{e} }\",\n      None => \"\"\n    }\n    Some(\"\\{gen}(\\{String::join(parts, \", \")}) -> \\{print_type_expr(ret_ty)}\\{eff}\")\n  }\n}\n\nexport fn parse_contract_program(tokens: Array[Token]) -> (Array[(String, String)], Array[(String, Int)], Array[Stmt]) with { Error } {\n  let decls = array_empty()\n  let opaques = array_empty()\n  let stmts = array_empty()\n  let mut pos = 0\n  let mut done = false\n  while !done {\n    match peek(tokens, pos) {\n      TEof => {\n        done = true\n      },\n      TType => {\n        let mut la = pos + 1\n        let tname = match peek(tokens, la) {\n          TIdent(tn) => tn,\n          _ => \"\"\n        }\n        let mut is_bodyless = false\n        let mut arity = 0\n        if tname == \"\" {\n          ()\n        } else {\n          la = la + 1\n          let mut scan = la\n          match peek(tokens, scan) {\n            TLBracket => {\n              let mut depth = 1\n              arity = 1\n              scan = scan + 1\n              while depth > 0 {\n                match peek(tokens, scan) {\n                  TLBracket => {\n                    depth = depth + 1\n                  },\n                  TRBracket => {\n                    depth = depth - 1\n                  },\n                  TComma => if depth == 1 {\n                    arity = arity + 1\n                  } else {\n                    ()\n                  },\n                  TEof => {\n                    depth = 0\n                  },\n                  _ => ()\n                }\n                scan = scan + 1\n              }\n            },\n            _ => ()\n          }\n          match peek(tokens, scan) {\n            TEq => {\n              arity = 0\n            },\n            _ => {\n              is_bodyless = true\n              la = scan\n            }\n          }\n        }\n        if is_bodyless {\n          Array::push(opaques, (tname, arity))\n          pos = la\n        } else {\n          let (stmt, next) = parse_stmt(tokens, [\n          ], pos)\n          Array::push(stmts, stmt)\n          pos = next\n        }\n      },\n      TLet => {\n        match peek(tokens, pos + 1) {\n          TMut => throw(\"contract let declaration cannot be `mut` (#752)\"),\n          _ => ()\n        }\n        let vname = match peek(tokens, pos + 1) {\n          TIdent(vn) => vn,\n          _ => throw(\"expected value name after 'let' in a contract\")\n        }\n        match peek(tokens, pos + 2) {\n          TColon => (),\n          _ => throw(\"contract value declaration '\\{vname}' requires a type annotation (#752)\")\n        }\n        let (vty, vnext) = parse_type(tokens, pos + 3)\n        match peek(tokens, vnext) {\n          TEq => throw(\"contract value declaration '\\{vname}' must not have a definition (#752)\"),\n          _ => ()\n        }\n        Array::push(decls, (vname, String::concat(\"val \", print_type_expr(vty))))\n        pos = vnext\n      },\n      TIdent(head) => if head == \"opaque\" {\n        match peek(tokens, pos + 1) {\n          TType => match peek(tokens, pos + 2) {\n            TIdent(oname) => {\n              match peek(tokens, pos + 3) {\n                TLBracket => throw(\"opaque type '\\{oname}': type parameters are not yet supported (#729)\"),\n                _ => ()\n              }\n              Array::push(opaques, (oname, 0))\n              pos = pos + 3\n            },\n            _ => throw(\"expected type name after 'opaque type'\")\n          },\n          _ => throw(\"expected 'type' after 'opaque'\")\n        }\n      } else {\n        let (stmt, next) = parse_stmt(tokens, [\n        ], pos)\n        Array::push(stmts, stmt)\n        pos = next\n      },\n      TFn => {\n        let (dhead, dsig, _, next) = parse_fn_signature(tokens, pos + 1)\n        let (name, tps, tbs) = dhead\n        let (params, ret_ty, eff_opt) = dsig\n        match peek(tokens, next) {\n          TLBrace => throw(\"contract fn declaration '\\{name}' must not have a body (#729)\"),\n          _ => ()\n        }\n        match fn_sig_text(tps, tbs, params, ret_ty, eff_opt) {\n          Some(sig) => Array::push(decls, (name, sig)),\n          None => throw(\"contract fn declaration '\\{name}' requires full annotations\")\n        }\n        pos = next\n      },\n      _ => {\n        let (stmt, next) = parse_stmt(tokens, [\n        ], pos)\n        Array::push(stmts, stmt)\n        pos = next\n      }\n    }\n  }\n  (decls, opaques, stmts)\n}\n\nexport fn collect_impl_fn_defs(stmts: Array[Stmt]) -> Array[(String, Option[String], Bool)] {\n  let out = array_empty()\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SLet(exported, _, name, ty_opt, val) => match val {\n        EFn(tps, tbs, params, ret_opt, eff_opt, _) => {\n          let sig = match ret_opt {\n            Some(ret_ty) => fn_sig_text(tps, tbs, params, ret_ty, eff_opt),\n            None => None\n          }\n          Array::push(out, (name, sig, exported))\n        },\n        _ => match ty_opt {\n          Some(vty) => Array::push(out, (name, Some(String::concat(\"val \", print_type_expr(vty))), exported)),\n          None => Array::push(out, (name, None, exported))\n        }\n      },\n      _ => ()\n    }\n    i = i + 1\n  }\n  out\n}\n\nexport fn collect_impl_type_defs(stmts: Array[Stmt]) -> Array[(String, Bool, Int)] {\n  let out = array_empty()\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SStruct(exported, name, _, _, _, tparams) => Array::push(out, (name, exported, Array::length(tparams))),\n      SEnum(exported, name, tparams, _, _) => Array::push(out, (name, exported, Array::length(tparams))),\n      STypeAlias(exported, name, tparams, _) => Array::push(out, (name, exported, Array::length(tparams))),\n      SSuberror(exported, name, _) => Array::push(out, (name, exported, 0)),\n      _ => ()\n    }\n    i = i + 1\n  }\n  out\n}\n\nfn collect_reexported_names(impl_stmts: Array[Stmt]) -> Array[String] {\n  let out = array_empty()\n  let mut i = 0\n  while i < Array::length(impl_stmts) {\n    match Array::get(impl_stmts, i) {\n      SReExport(_, items) => {\n        let mut ii = 0\n        while ii < Array::length(items) {\n          let (rname, alias_opt) = Array::get(items, ii)\n          let exported_name = match alias_opt {\n            Some(a) => a,\n            None => rname\n          }\n          Array::push(out, exported_name)\n          ii = ii + 1\n        }\n      },\n      _ => ()\n    }\n    i = i + 1\n  }\n  out\n}\n\nfn array_contains_string(xs: Array[String], target: String) -> Bool {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(xs) {\n    if Array::get(xs, i) == target {\n      found = true\n    } else ()\n    i = i + 1\n  }\n  found\n}\n\nfn ctr_es_index_of(names: Array[String], name: String) -> Int {\n  let mut i = 0\n  let mut found = -1\n  while i < Array::length(names) {\n    if Array::get(names, i) == name {\n      found = i\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  found\n}\n\nfn ctr_es_contains(arr: Array[String], v: String) -> Bool {\n  ctr_es_index_of(arr, v) >= 0\n}\n\nfn ctr_es_collect_tables(stmts: Array[Stmt]) -> (Array[String], Array[Array[String]]) {\n  let es_names = array_empty()\n  let es_members_list = array_empty()\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SEffectSet(_, esname, esmembers) => {\n        Array::push(es_names, esname)\n        Array::push(es_members_list, esmembers)\n      },\n      _ => ()\n    }\n    i = i + 1\n  }\n  (es_names, es_members_list)\n}\n\nfn ctr_es_expand_into(es_names: Array[String], es_members_list: Array[Array[String]], name: String, path: Array[String], out: Array[String]) -> Unit {\n  if ctr_es_contains(path, name) {\n    ()\n  } else {\n    let idx = ctr_es_index_of(es_names, name)\n    if idx < 0 {\n      if ctr_es_contains(out, name) {\n        ()\n      } else {\n        Array::push(out, name)\n      }\n    } else {\n      Array::push(path, name)\n      let members = Array::get(es_members_list, idx)\n      let mut mi = 0\n      while mi < Array::length(members) {\n        ctr_es_expand_into(es_names, es_members_list, Array::get(members, mi), path, out)\n        mi = mi + 1\n      }\n      Array::truncate(path, Array::length(path) - 1)\n    }\n  }\n}\n\nfn ctr_es_join_comma(names: Array[String]) -> String {\n  let mut result = \"\"\n  let mut i = 0\n  while i < Array::length(names) {\n    if i == 0 {\n      result = Array::get(names, i)\n    } else {\n      result = String::concat(result, String::concat(\", \", Array::get(names, i)))\n    }\n    i = i + 1\n  }\n  result\n}\n\nfn ctr_es_expand_row_string(row: String, es_names: Array[String], es_members_list: Array[Array[String]]) -> String {\n  let raw = String::split(row, \", \")\n  let out = array_empty()\n  let mut i = 0\n  while i < Array::length(raw) {\n    let expanded = array_empty()\n    ctr_es_expand_into(es_names, es_members_list, Array::get(raw, i), array_empty(), expanded)\n    let mut j = 0\n    while j < Array::length(expanded) {\n      let e = Array::get(expanded, j)\n      if ctr_es_contains(out, e) {\n        ()\n      } else {\n        Array::push(out, e)\n      }\n      j = j + 1\n    }\n    i = i + 1\n  }\n  ctr_es_join_comma(out)\n}\n\nfn ctr_expand_sig_row(sig: String, es_names: Array[String], es_members_list: Array[Array[String]]) -> String {\n  if Array::length(es_names) == 0 {\n    sig\n  } else {\n    let marker = \" with { \"\n    let idx = String::index_of(sig, marker)\n    if idx < 0 {\n      sig\n    } else {\n      let slen = String::length(sig)\n      let mlen = String::length(marker)\n      if slen < idx + mlen + 2 {\n        sig\n      } else {\n        let last_two = String::substring(sig, slen - 2, slen)\n        if last_two != \" }\" {\n          sig\n        } else {\n          let head = String::substring(sig, 0, idx)\n          let row = String::substring(sig, idx + mlen, slen - 2)\n          let expanded = ctr_es_expand_row_string(row, es_names, es_members_list)\n          String::concat(head, String::concat(marker, String::concat(expanded, \" }\")))\n        }\n      }\n    }\n  }\n}\n\nexport fn check_contract(decls: Array[(String, String)], opaque_names: Array[(String, Int)], impl_stmts: Array[Stmt], contract_type_defs: Array[Stmt]) -> Array[String] {\n  let errors = array_empty()\n  let (ctr_es_names, ctr_es_members_list) = ctr_es_collect_tables(contract_type_defs)\n  let defs = collect_impl_fn_defs(impl_stmts)\n  let reexported = collect_reexported_names(impl_stmts)\n  let mut di = 0\n  while di < Array::length(decls) {\n    let (dname, dsig) = Array::get(decls, di)\n    let dsig_expanded = ctr_expand_sig_row(dsig, ctr_es_names, ctr_es_members_list)\n    let mut satisfied = false\n    let mut seen_any = false\n    let mut best_msg = \"\"\n    let mut fi = 0\n    while fi < Array::length(defs) {\n      let (fname, fsig_opt, fexported) = Array::get(defs, fi)\n      if fname == dname {\n        seen_any = true\n        match fsig_opt {\n          Some(fsig) => if ctr_expand_sig_row(fsig, ctr_es_names, ctr_es_members_list) == dsig_expanded {\n            if fexported {\n              satisfied = true\n            } else {\n              best_msg = \"contract declaration '\\{dname}' is implemented but not exported by its implementation file\"\n            }\n          } else {\n            if best_msg == \"\" {\n              best_msg = \"signature mismatch for '\\{dname}': contract \\{dsig} but implementation \\{fsig}\"\n            } else ()\n          },\n          None => if best_msg == \"\" {\n            best_msg = \"implementation of '\\{dname}' lacks the full annotations required by the contract\"\n          } else ()\n        }\n      } else ()\n      fi = fi + 1\n    }\n    if satisfied {\n      ()\n    } else if array_contains_string(reexported, dname) {\n      ()\n    } else if seen_any {\n      Array::push(errors, best_msg)\n    } else {\n      Array::push(errors, \"contract declaration '\\{dname}' has no implementation\")\n    }\n    di = di + 1\n  }\n  let mut ei = 0\n  while ei < Array::length(defs) {\n    let (fname, _fsig_opt, fexported) = Array::get(defs, ei)\n    if fexported {\n      let mut declared = false\n      let mut ci = 0\n      while ci < Array::length(decls) {\n        let (dname, _dsig) = Array::get(decls, ci)\n        if dname == fname {\n          declared = true\n        } else ()\n        ci = ci + 1\n      }\n      if declared {\n        ()\n      } else {\n        Array::push(errors, \"exported '\\{fname}' is not declared in the contract\")\n      }\n    } else ()\n    ei = ei + 1\n  }\n  let type_defs = collect_impl_type_defs(impl_stmts)\n  let mut oi = 0\n  while oi < Array::length(opaque_names) {\n    let (oname, oarity) = Array::get(opaque_names, oi)\n    let mut ofound = array_contains_string(reexported, oname)\n    let mut ti = 0\n    while ti < Array::length(type_defs) {\n      let (tname, texported, tarity) = Array::get(type_defs, ti)\n      if tname == oname {\n        ofound = true\n        if texported {\n          ()\n        } else {\n          Array::push(errors, \"opaque type '\\{oname}' is implemented but not exported by its implementation file\")\n        }\n        if tarity == oarity {\n          ()\n        } else {\n          Array::push(errors, \"type '\\{oname}' arity mismatch: contract declares \\{oarity} type parameter(s), implementation defines \\{tarity}\")\n        }\n      } else ()\n      ti = ti + 1\n    }\n    if ofound {\n      ()\n    } else {\n      Array::push(errors, \"opaque type '\\{oname}' has no implementation\")\n    }\n    oi = oi + 1\n  }\n  let mut xi = 0\n  while xi < Array::length(type_defs) {\n    let (tname, texported, _) = Array::get(type_defs, xi)\n    if texported {\n      let mut tdeclared = false\n      let mut oj = 0\n      while oj < Array::length(opaque_names) {\n        let (ojname, _) = Array::get(opaque_names, oj)\n        if ojname == tname {\n          tdeclared = true\n        } else ()\n        oj = oj + 1\n      }\n      if tdeclared {\n        ()\n      } else {\n        Array::push(errors, \"exported type '\\{tname}' is not declared in the contract (declare it as `opaque type \\{tname}` or define it transparently in the contract)\")\n      }\n    } else ()\n    xi = xi + 1\n  }\n  let mut rxi = 0\n  while rxi < Array::length(reexported) {\n    let exported_name = Array::get(reexported, rxi)\n    let mut rdeclared = false\n    let mut rdi = 0\n    while rdi < Array::length(decls) {\n      let (dname, _) = Array::get(decls, rdi)\n      if dname == exported_name {\n        rdeclared = true\n      } else ()\n      rdi = rdi + 1\n    }\n    if rdeclared {\n      ()\n    } else {\n      let mut roi = 0\n      while roi < Array::length(opaque_names) {\n        let (oname, _) = Array::get(opaque_names, roi)\n        if oname == exported_name {\n          rdeclared = true\n        } else ()\n        roi = roi + 1\n      }\n    }\n    if rdeclared {\n      ()\n    } else {\n      Array::push(errors, \"re-exported '\\{exported_name}' is not declared in the contract\")\n    }\n    rxi = rxi + 1\n  }\n  errors\n}\n\nexport fn classify_contract_stmts(stmts: Array[Stmt]) -> (Array[String], Array[Stmt]) with { Error } {\n  let raws = array_empty()\n  let type_defs = array_empty()\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SImport(raw_path, _) => Array::push(raws, raw_path),\n      SStruct(_, name, fields, derives, mut_names, tparams) => Array::push(type_defs, SStruct(true, name, fields, derives, mut_names, tparams)),\n      SEnum(_, name, tparams, ctors, derives) => Array::push(type_defs, SEnum(true, name, tparams, ctors, derives)),\n      STypeAlias(_, name, tparams, ty) => Array::push(type_defs, STypeAlias(true, name, tparams, ty)),\n      SEffectDef(_, ename, etparams, eops) => Array::push(type_defs, SEffectDef(true, ename, etparams, eops)),\n      SEffectSet(_, esname, esmembers) => Array::push(type_defs, SEffectSet(true, esname, esmembers)),\n      _ => throw(\"unsupported statement in a contract file (index.vpkg / index.vibei): only fn declarations, opaque type declarations, transparent type/effect/effectset definitions, and implementation-file imports are allowed (#729)\")\n    }\n    i = i + 1\n  }\n  (raws, type_defs)\n}\n\nexport fn contract_impl_import_raw_paths(stmts: Array[Stmt]) -> Array[String] with { Error } {\n  let (raws, _) = classify_contract_stmts(stmts)\n  raws\n}\n\nfn import_items_are_dot_qualified(items: Array[(String, Option[String])]) -> Bool {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(items) && !found {\n    let (_, alias) = Array::get(items, i)\n    match alias {\n      Some(a) => if String::index_of(a, \".\") >= 0 {\n        found = true\n      } else {\n        ()\n      },\n      None => ()\n    }\n    i = i + 1\n  }\n  found\n}\n\nexport fn contract_directory_shared_imports(stmts: Array[Stmt]) -> Array[Stmt] {\n  let out = array_empty()\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SImport(raw_path, items) =>\n      if String::starts_with(raw_path, \"@\") && !import_items_are_dot_qualified(items) {\n        Array::push(out, SImport(raw_path, items))\n      } else {\n        ()\n      },\n      _ => ()\n    }\n    i = i + 1\n  }\n  out\n}\n\nexport fn contract_directory_shared_import_prefix_text(stmts: Array[Stmt]) -> String {\n  let shared = contract_directory_shared_imports(stmts)\n  if Array::length(shared) == 0 {\n    \"\"\n  } else {\n    let lines = array_empty()\n    let mut i = 0\n    while i < Array::length(shared) {\n      Array::push(lines, print_stmt(Array::get(shared, i)))\n      i = i + 1\n    }\n    String::concat(String::join(lines, \"\\n\"), \"\\n\")\n  }\n}\n\nexport fn contract_facade_source(decls: Array[(String, String)], opaque_names: Array[(String, Int)], type_defs: Array[Stmt], impl_units: Array[(String, Array[Stmt])]) -> String with { Error } {\n  let lines = array_empty()\n  let mut tdi = 0\n  while tdi < Array::length(type_defs) {\n    Array::push(lines, print_stmt(Array::get(type_defs, tdi)))\n    tdi = tdi + 1\n  }\n  let allocated = array_empty()\n  let mut ui = 0\n  while ui < Array::length(impl_units) {\n    let (raw, unit_stmts) = Array::get(impl_units, ui)\n    let defs = collect_impl_fn_defs(unit_stmts)\n    let unit_types = collect_impl_type_defs(unit_stmts)\n    let unit_reexported = collect_reexported_names(unit_stmts)\n    let names = array_empty()\n    let mut oi = 0\n    while oi < Array::length(opaque_names) {\n      let (oname, _) = Array::get(opaque_names, oi)\n      let mut otaken = false\n      let mut oai = 0\n      while oai < Array::length(allocated) {\n        if Array::get(allocated, oai) == \"type \\{oname}\" {\n          otaken = true\n        } else ()\n        oai = oai + 1\n      }\n      if otaken {\n        ()\n      } else {\n        let mut here = array_contains_string(unit_reexported, oname)\n        let mut uti = 0\n        while uti < Array::length(unit_types) {\n          let (tname, _, _) = Array::get(unit_types, uti)\n          if tname == oname {\n            here = true\n          } else ()\n          uti = uti + 1\n        }\n        if here {\n          Array::push(names, \"type \\{oname}\")\n          Array::push(allocated, \"type \\{oname}\")\n        } else ()\n      }\n      oi = oi + 1\n    }\n    let mut di = 0\n    while di < Array::length(decls) {\n      let (dname, _) = Array::get(decls, di)\n      let mut taken = false\n      let mut ai = 0\n      while ai < Array::length(allocated) {\n        if Array::get(allocated, ai) == dname {\n          taken = true\n        } else ()\n        ai = ai + 1\n      }\n      if taken {\n        ()\n      } else {\n        let mut defined_here = array_contains_string(unit_reexported, dname)\n        let mut fi = 0\n        while fi < Array::length(defs) {\n          let (fname, _, fexp) = Array::get(defs, fi)\n          if fname == dname && fexp {\n            defined_here = true\n          } else ()\n          fi = fi + 1\n        }\n        if defined_here {\n          Array::push(names, dname)\n          Array::push(allocated, dname)\n        } else ()\n      }\n      di = di + 1\n    }\n    if Array::length(names) > 0 {\n      Array::push(lines, \"export \\{raw} { \\{String::join(names, \", \")} }\")\n    } else {\n      Array::push(lines, \"import \\{raw} {}\")\n    }\n    ui = ui + 1\n  }\n  if Array::length(allocated) != Array::length(decls) + Array::length(opaque_names) {\n    throw(\"contract facade: some declarations have no implementation file (run check_contract first)\")\n  } else ()\n  String::concat(String::join(lines, \"\\n\"), \"\\n\")\n}\n\n\nfn sorted_strings(items: Array[String]) -> Array[String] {\n  let out = array_empty()\n  let mut i = 0\n  while i < Array::length(items) {\n    Array::push(out, Array::get(items, i))\n    i = i + 1\n  }\n  let n = Array::length(out)\n  let mut a = 0\n  while a < n {\n    let mut b = a + 1\n    let mut min_i = a\n    while b < n {\n      let x = Array::get(out, b)\n      let y = Array::get(out, min_i)\n      let xl = String::length(x)\n      let yl = String::length(y)\n      let mut ci = 0\n      let mut cmp = 0\n      while cmp == 0 && ci < xl && ci < yl {\n        let cx = String::char_code_at(x, ci)\n        let cy = String::char_code_at(y, ci)\n        if cx < cy {\n          cmp = 0 - 1\n        } else if cx > cy {\n          cmp = 1\n        } else ()\n        ci = ci + 1\n      }\n      if cmp == 0 {\n        if xl < yl {\n          cmp = 0 - 1\n        } else if xl > yl {\n          cmp = 1\n        } else ()\n      } else ()\n      if cmp < 0 {\n        min_i = b\n      } else ()\n      b = b + 1\n    }\n    if min_i != a {\n      let tmp = Array::get(out, a)\n      Array::set(out, a, Array::get(out, min_i))\n      Array::set(out, min_i, tmp)\n    } else ()\n    a = a + 1\n  }\n  out\n}\n\nexport fn contract_hash(fn_decls: Array[(String, String)], opaque_names: Array[(String, Int)], type_defs: Array[Stmt]) -> String {\n  let canon = String::join(sorted_strings(contract_surface_lines(fn_decls, opaque_names, type_defs)), \"\\n\")\n  \"ct:sha1:\\{sha1(String::concat(\"vibei:v1\\n\", canon))}\"\n}\n\nexport fn package_hash_from_sources(sources: Array[(String, String)]) -> String {\n  let keys = array_empty()\n  let mut i = 0\n  while i < Array::length(sources) {\n    let (path, _) = Array::get(sources, i)\n    Array::push(keys, path)\n    i = i + 1\n  }\n  let ordered = sorted_strings(keys)\n  let sb = StringBuilder::new()\n  StringBuilder::push(sb, \"vibe-pkg:v1\\n\")\n  let mut ki = 0\n  while ki < Array::length(ordered) {\n    let key = Array::get(ordered, ki)\n    let mut si = 0\n    while si < Array::length(sources) {\n      let (path, text) = Array::get(sources, si)\n      if path == key {\n        StringBuilder::push(sb, \"file \\{path} \\{String::length(text)}\\n\")\n        StringBuilder::push(sb, text)\n        StringBuilder::push(sb, \"\\n\")\n        si = Array::length(sources)\n      } else {\n        si = si + 1\n      }\n    }\n    ki = ki + 1\n  }\n  \"pkg:sha1:\\{sha1(StringBuilder::freeze(sb))}\"\n}\n\n\nfn is_package_name(n: String) -> Bool {\n  if !String::starts_with(n, \"@\") {\n    false\n  } else {\n    let segs = String::split(n, \"/\")\n    if Array::length(segs) < 2 || String::length(Array::get(segs, 0)) <= 1 {\n      false\n    } else {\n      let mut i = 1\n      let mut ok = true\n      while i < Array::length(segs) {\n        if String::length(Array::get(segs, i)) == 0 {\n          ok = false\n        }\n        i = i + 1\n      }\n      ok\n    }\n  }\n}\n\nfn blank_of(s: String) -> String {\n  let sb = StringBuilder::new()\n  let mut i = 0\n  while i < String::length(s) {\n    StringBuilder::push(sb, \" \")\n    i = i + 1\n  }\n  StringBuilder::freeze(sb)\n}\n\nfn parse_deps_entry(trimmed: String) -> (String, String) with { Error } {\n  let parts = String::split(trimmed, \":\")\n  if Array::length(parts) != 2 {\n    throw(\"malformed deps entry (expected: @scope/pkg : x.y.z): \\{trimmed}\")\n  } else ()\n  let dname = String::trim(Array::get(parts, 0))\n  let dver = String::trim(Array::get(parts, 1))\n  if !is_package_name(dname) {\n    throw(\"deps package name must be @scope/name: \\{trimmed}\")\n  } else ()\n  if !is_strict_semver(dver) {\n    throw(\"deps version must be a strict semver triple (x.y.z): \\{trimmed}\")\n  } else ()\n  (dname, dver)\n}\n\nfn consume_description_block(source: String, len: Int, start: Int) -> (String, Int, String) with { Error } {\n  let parts = array_empty()\n  let sb = StringBuilder::new()\n  let mut pos = start\n  let mut col = -1\n  let mut cont = true\n  while cont && pos < len {\n    let mut nl = pos\n    while nl < len && String::char_code_at(source, nl) != 10 {\n      nl = nl + 1\n    }\n    let dline = String::substring(source, pos, nl)\n    let mut j = 0\n    while j < String::length(dline) && (String::char_code_at(dline, j) == ' ' || String::char_code_at(dline, j) == '\\t') {\n      j = j + 1\n    }\n    let is_bar = j + 1 < String::length(dline) && String::char_code_at(dline, j) == '#' && String::char_code_at(dline, j + 1) == '|'\n    if is_bar {\n      if col < 0 {\n        col = j\n      } else if j != col {\n        throw(\"description #| continuation must be indented to column \\{__to_string(col + 1)}: \\{dline}\")\n      } else ()\n      Array::push(parts, String::substring(dline, j + 2, String::length(dline)))\n      StringBuilder::push(sb, blank_of(dline))\n      if nl < len {\n        StringBuilder::push(sb, \"\\n\")\n      } else ()\n      pos = nl + 1\n    } else {\n      cont = false\n    }\n  }\n  (String::join(parts, \"\\n\"), pos, StringBuilder::freeze(sb))\n}\n\nfn consume_deps_block(source: String, len: Int, start: Int) -> (Array[(String, String)], Int, String) with { Error } {\n  let entries = array_empty()\n  let sb = StringBuilder::new()\n  let mut pos = start\n  let mut closed = false\n  while !closed && pos < len {\n    let mut nl = pos\n    while nl < len && String::char_code_at(source, nl) != 10 {\n      nl = nl + 1\n    }\n    let dline = String::substring(source, pos, nl)\n    let dtrimmed = String::trim(dline)\n    if dtrimmed == \"}\" {\n      StringBuilder::push(sb, blank_of(dline))\n      closed = true\n    } else if String::length(dtrimmed) == 0 {\n      StringBuilder::push(sb, dline)\n    } else {\n      let (dname, dver) = parse_deps_entry(dtrimmed)\n      Array::push(entries, (dname, dver))\n      StringBuilder::push(sb, blank_of(dline))\n    }\n    if nl < len {\n      StringBuilder::push(sb, \"\\n\")\n    } else ()\n    pos = nl + 1\n  }\n  if !closed {\n    throw(\"unterminated deps block (missing closing '}')\")\n  } else ()\n  (entries, pos, StringBuilder::freeze(sb))\n}\n\nfn is_digit_run(s: String, from: Int, to: Int) -> Bool {\n  if to <= from {\n    false\n  } else {\n    let mut i = from\n    let mut ok = true\n    while i < to {\n      let c = String::char_code_at(s, i)\n      if c < '0' || c > '9' {\n        ok = false\n        i = to\n      } else {\n        i = i + 1\n      }\n    }\n    ok\n  }\n}\n\nexport fn is_strict_semver(v: String) -> Bool {\n  let start = if String::starts_with(v, \"^\") {\n    1\n  } else 0\n  let body = String::substring(v, start, String::length(v))\n  let parts = String::split(body, \".\")\n  if Array::length(parts) != 3 {\n    false\n  } else {\n    let a = Array::get(parts, 0)\n    let b = Array::get(parts, 1)\n    let c = Array::get(parts, 2)\n    is_digit_run(a, 0, String::length(a)) && is_digit_run(b, 0, String::length(b)) && is_digit_run(c, 0, String::length(c))\n  }\n}\n\nexport fn is_package_pin(h: String) -> Bool {\n  if !String::starts_with(h, \"#pkg:sha1:\") {\n    false\n  } else if String::length(h) != 50 {\n    false\n  } else {\n    let mut i = 10\n    let mut ok = true\n    while i < 50 {\n      let c = String::char_code_at(h, i)\n      let is_hex = (c >= '0' && c <= '9') || (c >= 'a' && c <= 'f')\n      if is_hex {\n        i = i + 1\n      } else {\n        ok = false\n        i = 50\n      }\n    }\n    ok\n  }\n}\n\nfn split_fields(line: String) -> Array[String] {\n  let raw = String::split(String::trim(line), \" \")\n  let out = array_empty()\n  let mut i = 0\n  while i < Array::length(raw) {\n    let f = Array::get(raw, i)\n    if String::length(f) > 0 {\n      Array::push(out, f)\n    } else ()\n    i = i + 1\n  }\n  out\n}\n\nfn scan_package_header(source: String) -> (Array[(String, String, String)], String, String, Bool, String, Array[(String, String)], String, String) with { Error } {\n  let pins = array_empty()\n  let deps = array_empty()\n  let sb = StringBuilder::new()\n  let len = String::length(source)\n  let mut pos = 0\n  let mut scanning = true\n  let mut name = \"\"\n  let mut version = \"\"\n  let mut main = false\n  let mut description = \"\"\n  let mut generated_hash = \"\"\n  let mut seen_name = false\n  let mut seen_version = false\n  let mut seen_main = false\n  let mut seen_description = false\n  let mut seen_deps = false\n  let mut seen_hash = false\n  while pos < len {\n    let mut nl = pos\n    while nl < len && String::char_code_at(source, nl) != 10 {\n      nl = nl + 1\n    }\n    let line = String::substring(source, pos, nl)\n    let trimmed = String::trim(line)\n    let mut next_pos = nl + 1\n    if !scanning {\n      StringBuilder::push(sb, line)\n    } else if String::starts_with(trimmed, \"version =\") {\n      if seen_version {\n        throw(\"duplicate version directive: \\{trimmed}\")\n      } else ()\n      let v = String::trim(String::substring(trimmed, 9, String::length(trimmed)))\n      if String::starts_with(v, \"^\") || !is_strict_semver(v) {\n        throw(\"version directive must be an exact semver triple (x.y.z): \\{trimmed}\")\n      } else ()\n      version = v\n      seen_version = true\n      StringBuilder::push(sb, blank_of(line))\n    } else if String::starts_with(trimmed, \"version \") {\n      let vfields = split_fields(trimmed)\n      if Array::length(vfields) != 2 {\n        throw(\"malformed version directive (expected: version x.y.z): \\{trimmed}\")\n      } else ()\n      let v = Array::get(vfields, 1)\n      if String::starts_with(v, \"^\") || !is_strict_semver(v) {\n        throw(\"version directive must be an exact semver triple (x.y.z): \\{trimmed}\")\n      } else ()\n      if seen_version {\n        throw(\"duplicate version directive: \\{trimmed}\")\n      } else ()\n      version = v\n      seen_version = true\n      StringBuilder::push(sb, blank_of(line))\n    } else if String::starts_with(trimmed, \"name =\") {\n      if seen_name {\n        throw(\"duplicate name directive: \\{trimmed}\")\n      } else ()\n      let n = String::trim(String::substring(trimmed, 6, String::length(trimmed)))\n      if !is_package_name(n) {\n        throw(\"name directive must be @scope/name: \\{trimmed}\")\n      } else ()\n      name = n\n      seen_name = true\n      StringBuilder::push(sb, blank_of(line))\n    } else if String::starts_with(trimmed, \"main =\") {\n      if seen_main {\n        throw(\"duplicate main directive: \\{trimmed}\")\n      } else ()\n      let m = String::trim(String::substring(trimmed, 6, String::length(trimmed)))\n      if m == \"true\" {\n        main = true\n      } else if m == \"false\" {\n        main = false\n      } else {\n        throw(\"main directive must be true or false: \\{trimmed}\")\n      }\n      seen_main = true\n      StringBuilder::push(sb, blank_of(line))\n    } else if String::starts_with(trimmed, \"generated_hash =\") {\n      if seen_hash {\n        throw(\"duplicate generated_hash directive: \\{trimmed}\")\n      } else ()\n      let gh = String::trim(String::substring(trimmed, 17, String::length(trimmed)))\n      if (String::length(gh) > 0) && !is_package_pin(gh) {\n        throw(\"generated_hash must be empty or #pkg:sha1:<40hex>: \\{trimmed}\")\n      } else ()\n      generated_hash = gh\n      seen_hash = true\n      StringBuilder::push(sb, blank_of(line))\n    } else if trimmed == \"description =\" {\n      if seen_description {\n        throw(\"duplicate description directive: \\{trimmed}\")\n      } else ()\n      StringBuilder::push(sb, blank_of(line))\n      let (dtext, dpos, dblanked) = consume_description_block(source, len, nl + 1)\n      description = dtext\n      seen_description = true\n      StringBuilder::push(sb, dblanked)\n      next_pos = dpos\n    } else if trimmed == \"deps = {}\" {\n      if seen_deps {\n        throw(\"duplicate deps directive: \\{trimmed}\")\n      } else ()\n      seen_deps = true\n      StringBuilder::push(sb, blank_of(line))\n    } else if trimmed == \"deps = {\" {\n      if seen_deps {\n        throw(\"duplicate deps directive: \\{trimmed}\")\n      } else ()\n      StringBuilder::push(sb, blank_of(line))\n      let (dentries, dpos, dblanked) = consume_deps_block(source, len, nl + 1)\n      deps_extend(deps, dentries)\n      seen_deps = true\n      StringBuilder::push(sb, dblanked)\n      next_pos = dpos\n    } else if String::starts_with(trimmed, \"require \") {\n      let fields = split_fields(trimmed)\n      let nfields = Array::length(fields)\n      if nfields != 5 && nfields != 3 {\n        throw(\"malformed require line (expected: require @scope/name x.y.z [= #pkg:sha1:<40hex>]): \\{trimmed}\")\n      } else ()\n      let rname = Array::get(fields, 1)\n      let rver = Array::get(fields, 2)\n      if !String::starts_with(rname, \"@\") {\n        throw(\"require package name must start with '@': \\{rname}\")\n      } else ()\n      if !is_strict_semver(rver) {\n        throw(\"require version must be a strict semver triple (x.y.z or ^x.y.z): \\{rver}\")\n      } else ()\n      let pin_hash = if nfields == 5 {\n        let eq = Array::get(fields, 3)\n        let pin = Array::get(fields, 4)\n        if eq == \"=\" {\n          ()\n        } else {\n          throw(\"malformed require line (missing '='): \\{trimmed}\")\n        }\n        if !is_package_pin(pin) {\n          throw(\"require pin must be #pkg:sha1:<40hex> (compute with `vibe hash`): \\{pin}\")\n        } else ()\n        String::substring(pin, 1, String::length(pin))\n      } else {\n        \"\"\n      }\n      Array::push(pins, (rname, rver, pin_hash))\n      StringBuilder::push(sb, blank_of(line))\n    } else if String::length(trimmed) == 0 || String::starts_with(trimmed, \"//\") {\n      StringBuilder::push(sb, line)\n    } else {\n      scanning = false\n      StringBuilder::push(sb, line)\n    }\n    if nl < len {\n      StringBuilder::push(sb, \"\\n\")\n    } else ()\n    pos = next_pos\n  }\n  (pins, name, version, main, description, deps, generated_hash, StringBuilder::freeze(sb))\n}\n\nfn deps_extend(deps: Array[(String, String)], more: Array[(String, String)]) -> Unit {\n  let mut i = 0\n  while i < Array::length(more) {\n    Array::push(deps, Array::get(more, i))\n    i = i + 1\n  }\n}\n\nexport fn extract_require_pins(source: String) -> (Array[(String, String, String)], String) with { Error } {\n  let (pins, _name, _version, _main, _description, _deps, _hash, blanked) = scan_package_header(source)\n  (pins, blanked)\n}\n\nexport fn extract_package_version(source: String) -> String with { Error } {\n  let (_pins, _name, version, _main, _description, _deps, _hash, _blanked) = scan_package_header(source)\n  version\n}\n\nexport fn extract_package_name(source: String) -> String with { Error } {\n  let (_pins, name, _version, _main, _description, _deps, _hash, _blanked) = scan_package_header(source)\n  name\n}\n\nexport fn extract_package_main(source: String) -> Bool with { Error } {\n  let (_pins, _name, _version, main, _description, _deps, _hash, _blanked) = scan_package_header(source)\n  main\n}\n\nexport fn extract_package_description(source: String) -> String with { Error } {\n  let (_pins, _name, _version, _main, description, _deps, _hash, _blanked) = scan_package_header(source)\n  description\n}\n\nexport fn extract_package_deps(source: String) -> Array[(String, String)] with { Error } {\n  let (_pins, _name, _version, _main, _description, deps, _hash, _blanked) = scan_package_header(source)\n  deps\n}\n\nexport fn extract_package_generated_hash(source: String) -> String with { Error } {\n  let (_pins, _name, _version, _main, _description, _deps, hash, _blanked) = scan_package_header(source)\n  hash\n}\n\nfn has_generated_hash_directive(source: String) -> Bool {\n  let lines = String::split(source, \"\\n\")\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(lines) && !found {\n    if String::starts_with(String::trim(Array::get(lines, i)), \"generated_hash =\") {\n      found = true\n    } else {\n      i = i + 1\n    }\n  }\n  found\n}\n\nexport fn canonicalize_for_hash(source: String) -> String with { Error } {\n  if has_generated_hash_directive(source) {\n    replace_generated_hash_directive(source, \"\")\n  } else {\n    source\n  }\n}\n\nexport fn replace_generated_hash_directive(source: String, new_value: String) -> String with { Error } {\n  let lines = String::split(source, \"\\n\")\n  let out = array_empty()\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(lines) {\n    let line = Array::get(lines, i)\n    if (!found) && String::starts_with(String::trim(line), \"generated_hash =\") {\n      found = true\n      let replacement = if String::length(new_value) == 0 {\n        \"generated_hash =\"\n      } else {\n        \"generated_hash = \\{new_value}\"\n      }\n      Array::push(out, replacement)\n    } else {\n      Array::push(out, line)\n    }\n    i = i + 1\n  }\n  if !found {\n    throw(\"no generated_hash directive found (this tool only rewrites #1128-migrated index.vpkg files)\")\n  } else ()\n  String::join(out, \"\\n\")\n}\n\nexport fn deps_missing_for_imports(deps: Array[(String, String)], impl_sources: Array[String]) -> Array[String] {\n  let missing = array_empty()\n  let mut si = 0\n  while si < Array::length(impl_sources) {\n    let src = Array::get(impl_sources, si)\n    let len = String::length(src)\n    let mut pos = 0\n    while pos < len {\n      let mut nl = pos\n      while nl < len && String::char_code_at(src, nl) != 10 {\n        nl = nl + 1\n      }\n      let trimmed = String::trim(String::substring(src, pos, nl))\n      if String::starts_with(trimmed, \"import @\") {\n        let after = String::substring(trimmed, 7, String::length(trimmed))\n        let mut ei = 0\n        while ei < String::length(after) && String::char_code_at(after, ei) != ' ' {\n          ei = ei + 1\n        }\n        let pkg = String::substring(after, 0, ei)\n        let mut found = false\n        let mut di = 0\n        while di < Array::length(deps) {\n          let (dname, _dver) = Array::get(deps, di)\n          if dname == pkg {\n            found = true\n          } else ()\n          di = di + 1\n        }\n        if !found && !str_in(missing, pkg) {\n          Array::push(missing, pkg)\n        } else ()\n      } else ()\n      pos = nl + 1\n    }\n    si = si + 1\n  }\n  missing\n}\n\n\nfn str_in(arr: Array[String], target: String) -> Bool {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(arr) && !found {\n    if Array::get(arr, i) == target {\n      found = true\n    } else {\n      i = i + 1\n    }\n  }\n  found\n}\n\nexport fn contract_surface_lines(fn_decls: Array[(String, String)], opaque_names: Array[(String, Int)], type_defs: Array[Stmt]) -> Array[String] {\n  let lines = array_empty()\n  let mut i = 0\n  while i < Array::length(fn_decls) {\n    let (dname, dsig) = Array::get(fn_decls, i)\n    Array::push(lines, \"fn \\{dname} \\{dsig}\")\n    i = i + 1\n  }\n  let mut oi = 0\n  while oi < Array::length(opaque_names) {\n    let (oname, oarity) = Array::get(opaque_names, oi)\n    let oline = if oarity == 0 {\n      \"opaque \\{oname}\"\n    } else {\n      \"opaque \\{oname}[\\{oarity}]\"\n    }\n    Array::push(lines, oline)\n    oi = oi + 1\n  }\n  let mut ti = 0\n  while ti < Array::length(type_defs) {\n    Array::push(lines, \"type \\{print_stmt(Array::get(type_defs, ti))}\")\n    ti = ti + 1\n  }\n  lines\n}\n\nexport fn classify_contract_change(old_lines: Array[String], new_lines: Array[String]) -> String {\n  let mut all_old_kept = true\n  let mut i = 0\n  while i < Array::length(old_lines) {\n    if str_in(new_lines, Array::get(old_lines, i)) {\n      ()\n    } else {\n      all_old_kept = false\n    }\n    i = i + 1\n  }\n  if !all_old_kept {\n    \"major\"\n  } else {\n    let mut any_new = false\n    let mut j = 0\n    while j < Array::length(new_lines) {\n      if str_in(old_lines, Array::get(new_lines, j)) {\n        ()\n      } else {\n        any_new = true\n      }\n      j = j + 1\n    }\n    if any_new {\n      \"minor\"\n    } else {\n      \"patch\"\n    }\n  }\n}\n\nfn digits_to_int(raw: String) -> Int {\n  let len = String::length(raw)\n  let mut result = 0\n  let mut i = 0\n  while i < len {\n    result = result * 10 + (String::char_code_at(raw, i) - 48)\n    i = i + 1\n  }\n  result\n}\n\nfn semver_parts(v: String) -> Option[(Int, Int, Int)] {\n  if is_strict_semver(v) && !String::starts_with(v, \"^\") {\n    let parts = String::split(v, \".\")\n    Some((digits_to_int(Array::get(parts, 0)), digits_to_int(Array::get(parts, 1)), digits_to_int(Array::get(parts, 2))))\n  } else {\n    None\n  }\n}\n\nexport fn semver_bump_kind(prev: String, next: String) -> Option[String] {\n  match semver_parts(prev) {\n    None => None,\n    Some(pp) => match semver_parts(next) {\n      None => None,\n      Some(np) => {\n        let (pa, pb, pc) = pp\n        let (na, nb, nc) = np\n        if na == pa + 1 && nb == 0 && nc == 0 {\n          Some(\"major\")\n        } else if na == pa && nb == pb + 1 && nc == 0 {\n          Some(\"minor\")\n        } else if na == pa && nb == pb && nc == pc + 1 {\n          Some(\"patch\")\n        } else {\n          None\n        }\n      }\n    }\n  }\n}\n\nexport fn verify_publish_bump(prev_version: String, next_version: String, old_lines: Array[String], new_lines: Array[String]) -> Array[String] {\n  let errors = array_empty()\n  let required = classify_contract_change(old_lines, new_lines)\n  match semver_bump_kind(prev_version, next_version) {\n    None => Array::push(errors, \"\\{prev_version} -> \\{next_version} is not a single forward semver bump\"),\n    Some(claimed) => if claimed == required {\n      ()\n    } else {\n      Array::push(errors, \"version \\{prev_version} -> \\{next_version} claims a \\{claimed} bump but the contract change requires \\{required}\")\n    }\n  }\n  errors\n}\n\nexport {\n  check_contract, collect_impl_fn_defs, parse_contract_program\n}\n")
}

let source_220 = () -> (String, String) {
  ("lib/@vibe/compiler/loader/index.vpkg",
"name = @vibe/compiler/loader\nversion = 0.0.1\ndescription =\n  #|@vibe/compiler/loader — ADR-0070 / #897 compiler-internal contract,\ndeps = {\n  @vibe/cache : 0.0.1\n  @vibe/compiler/cache : 0.0.1\n  @vibe/compiler/checker : 0.0.1\n  @vibe/compiler/contract : 0.0.1\n  @vibe/compiler/core : 0.0.1\n  @vibe/compiler/runtime/eval_loader : 0.0.1\n  @vibe/compiler/syntax : 0.0.1\n  @vibe/core : 0.2.0\n}\n\ngenerated_hash =\n\n// @vibe/compiler/loader — ADR-0070 / #897 compiler-internal contract,\n// compiler-internal batch 7. Module-graph loading: source collection off\n// disk (collect_all_sources_fs / collect_source_groups_fs /\n// collect_sources_rec), persistent list/group/manifest-header caching (the\n// resolution_context_*, load_persistent_*, store_persistent_* families),\n// contract/publish-bump plumbing (contract_package_hashes_fs,\n// fill_require_pins_fs*, publish_check_fs), package-boundary enforcement\n// (enforce_incoming_boundary_fs, validate_index_layout_fs, vpkg directory\n// scanning), plus the tab-separated build manifest reader\n// (manifest_sources.vibe) and its persistent header-scan cache\n// (header_cache.vibe). Three files, no naming collision on the established\n// `git mv index.vibe <dirname>.vibe` rename convention (unlike checker/'s\n// and codegen/'s batches), so the old index.vibe moved verbatim to\n// loader.vibe.\n//\n// loader.vibe is NOT a pure facade — like codegen/common_base's batch, it\n// carries substantial real implementation of its own (source collection,\n// caching, contract/publish helpers) in addition to importing and\n// re-exporting a chosen subset of manifest_sources.vibe's surface. Its\n// existing `export ./manifest_sources.vibe { .. }` SReExport block (added\n// under #847, see its own comment in loader.vibe) stays untouched: this\n// contract is now the actual source of truth for the package's full export\n// surface (all 34 names below, across all 3 files), so the facade's\n// partial, hand-picked re-export list is no longer load-bearing for\n// outside callers — they reach every name here through this contract\n// regardless of what loader.vibe itself re-exports, exactly like\n// checker_facade.vibe's partial list after checker/'s batch.\n//\n// join_path naming wrinkle (the specific case #847 flagged this directory\n// as a \"facade-design blocker\" over): loader.vibe defines its own PRIVATE,\n// same-named `join_path` helper (a deliberate duplicate, see its own #740\n// comment) — so loader.vibe can never itself\n// `export ./manifest_sources.vibe { join_path }` without colliding with\n// its own local binding, and manifest_sources.vibe's `join_path` was\n// therefore unreachable through the old plain-index.vibe facade.\n// loader_hotspot_probe.vibe worked around this with a documented direct\n// leaf import straight from `loader/manifest_sources.vibe`. A .vpkg\n// contract has no such collision: it declares bodyless signatures, not\n// executable bindings, so `join_path` below (grouped under\n// manifest_sources.vibe) declares the export cleanly. The workaround leaf\n// import is retracted by this migration — loader_hotspot_probe.vibe now\n// gets `join_path` the same way as every other manifest_sources.vibe\n// export, through this contract's `import ../loader { .. }` package form.\n//\n// No exported types: TypeEnv/Stmt/Subst/Type (../core) and Map (builtin)\n// are plain structural signature text here, not declared at all\n// (normalize/perceus/contract precedent) — ../core itself was not yet\n// migrated to vpkg at the time of this batch (out of scope then), so\n// loader.vibe / header_cache.vibe kept their existing bare `import\n// ../core/index.vibe { .. }` style references unchanged. #897 batch 9\n// migrated core/ to its own index.vpkg and, per that contract's own\n// boundary-enforcement note, converted these two literal leaf-path\n// references to the bare `import ../core { .. }` package form (manifest_sources.vibe\n// never imported this compiler-internal ../core — its `@vibe/core` import\n// is the unrelated external stdlib package).\n//\n// External-caller fixes (literal `loader/index.vibe` /\n// `loader/manifest_sources.vibe` / `loader/header_cache.vibe` paths → bare\n// `../loader` / `./loader` package form, now that leaf-file imports from\n// outside the package are rejected by enforce_incoming_boundary_fs):\n// cli_adapter.vibe, loader_hotspot_probe.vibe (also folds its join_path\n// workaround import into the package form), loader_list_materialize_bench.vibe,\n// loader_materialize_bench.vibe, tests/contract_vpkg_test.vibe,\n// tests/loader_manifest_sources_test.vibe,\n// entry/source_compile/wasi_only/merge_sources.vibe,\n// entry/compiler/file_compile/file_compile.vibe,\n// entry/compiler/fs_compile/index.vibe. No import cycle found: none of\n// loader/'s own dependencies (checker/, runtime/eval_loader/, contract/,\n// syntax/ — all already vpkg) import back into loader/.\n//\n// Compiled into the compiler itself via compiler_sources_manifest.tsv\n// (group `loader`): the old single `loader/index.vibe` row becomes a dual\n// row (this contract + loader.vibe); header_cache.vibe and\n// manifest_sources.vibe already had their own rows and are unchanged.\n\n// --- loader.vibe\nfn resolution_context_fingerprint_fs() -> String with { Error, Fs }\nfn ingest_source_text_fs(path: String, raw: String) -> String with { Error, Fs }\nfn load_persistent_source_group_fingerprint_if_valid(entry_path: String) -> Option[String] with { Error, Fs }\nfn load_or_parse_module_header_fs(path: String, source: String, parse_count: Int) -> (Array[String], Array[String], Int) with { Error, Fs }\nfn check_module(source: String, path: String, sources: Array[(String, String)], loading: Array[String], checked_cache: Array[(String, TypeEnv)]) -> TypeEnv with { Error }\nfn contract_package_hashes_fs(path: String) -> (String, String) with { Error, Fs }\nfn fill_require_pins_fs(source: String) -> String with { Error, Fs }\nfn fill_require_pins_fs_mode(source: String, repin: Bool) -> String with { Error, Fs }\nfn publish_check_fs(prev_contract_path: String, next_contract_path: String, prev_version: String, next_version: String) -> Array[String] with { Error, Fs }\nfn collect_all_sources_fs(entry_path: String) -> Array[(String, String)] with { Error, Fs }\nfn collect_source_groups_fs(entry_path: String) -> Array[(String, Array[(String, String)])] with { Error, Fs }\nfn collect_merged_stmts(sources: Array[(String, String)]) -> Array[Stmt] with { Error }\nfn find_missing_vpkg_dirs(root: String) -> Array[String] with { Error, Fs }\nfn check_missing_vpkg_dirs(root: String) -> Int with { Error, Fs }\nfn write_generated_hash_fs(path: String) -> String with { Error, Fs }\nfn find_deps_missing(root: String) -> Array[String] with { Error, Fs }\nfn check_deps_missing(root: String) -> Int with { Error, Fs }\n\n// --- header_cache.vibe\nfn contract_sibling_impl_raws(dir: String) -> Array[String] with { Error, Fs }\nfn merge_impl_raws_dedupe(explicit: Array[String], discovered: Array[String]) -> Array[String]\nfn load_or_parse_module_header_fs_impl(path: String, source: String, parse_count: Int) -> (Array[String], Array[String], Int) with { Error, Fs }\n\n// --- manifest_sources.vibe\nfn join_path(base_dir: String, rel_path: String) -> String\nfn build_manifest_source_index(sources: Array[(String, String)]) -> Map[String, String]\nfn build_manifest_path_index(paths: Array[String]) -> Map[String, Bool]\nfn try_load_manifest_rows(entry_path: String) -> Option[(String, Array[(String, String)])] with { Error, Fs }\nfn load_manifest_full_sources(base_dir: String, rows: Array[(String, String)]) -> Array[(String, String)] with { Error, Fs }\nfn build_grouped_sources_from_manifest_row_source_index(base_dir: String, rows: Array[(String, String)], source_index: Map[String, String]) -> Array[(String, Array[(String, String)])]\nfn build_grouped_sources_from_manifest_rows(base_dir: String, rows: Array[(String, String)], sources: Array[(String, String)]) -> Array[(String, Array[(String, String)])]\nfn filter_manifest_sources_by_path_index(preloaded_sources: Array[(String, String)], needed_path_index: Map[String, Bool]) -> Array[(String, String)]\nfn filter_manifest_sources_by_paths(preloaded_sources: Array[(String, String)], needed_paths: Array[String]) -> Array[(String, String)]\nfn filter_manifest_sources_by_paths_linear(preloaded_sources: Array[(String, String)], needed_paths: Array[String]) -> Array[(String, String)]\nfn filter_manifest_sources_by_source_index(needed_paths: Array[String], preloaded_source_index: Map[String, String]) -> Array[(String, String)]\nfn probe_manifest_header_rows_count(entry_path: String) -> Int with { Error, Fs }\nfn probe_manifest_header_rows_uncached_count(entry_path: String) -> Int with { Error, Fs }\nfn probe_manifest_needed_paths_count(entry_path: String) -> Int with { Error, Fs }\nfn probe_manifest_scan_paths_count(entry_path: String) -> Int with { Error, Fs }\nfn try_collect_manifest_sources_fs(entry_path: String) -> Option[(String, Array[(String, String)])] with { Error, Fs }\nfn try_collect_manifest_source_groups_fs(entry_path: String) -> Option[(String, Array[(String, Array[(String, String)])])] with { Error, Fs }\n")
}

let source_221 = () -> (String, String) {
  ("lib/@vibe/compiler/loader/loader.vibe",
"\nimport @vibe/compiler/syntax {\n  lex, parse_program, parse_program_preserving\n}\n\nimport @vibe/core {\n  array_empty\n}\n\nimport @vibe/compiler/core {\n  Expr,\n  Stmt,\n  Subst,\n  Type,\n  TypeDef,\n  TypeEnv,\n  TypeExpr,\n  contains_path,\n  dir_of_path,\n  ensure_regular_source_fs,\n  env_bind,\n  env_lookup,\n  external_lib_roots,\n  is_contract_ext,\n  nearest_vpkg_path_fs,\n  normalize_path,\n  path_in_dir,\n  path_set_add,\n  path_set_contains,\n  path_set_new,\n  resolve_import_path,\n  resolve_import_path_candidates,\n  vibe_env_flag,\n  vpkg_path_in_dir\n}\n\nimport @vibe/compiler/checker {\n  check_stmts\n}\n\nimport @vibe/compiler/runtime/eval_loader {\n  collect_exports, load_and_parse\n}\n\n\nimport @vibe/compiler/contract {\n  canonicalize_for_hash,\n  check_contract,\n  classify_contract_stmts,\n  contract_directory_shared_import_prefix_text,\n  contract_facade_marker,\n  contract_facade_source,\n  contract_hash,\n  contract_surface_lines,\n  deps_missing_for_imports,\n  extract_package_deps,\n  extract_package_name,\n  extract_package_version,\n  extract_require_pins,\n  package_hash_from_sources,\n  parse_contract_program,\n  replace_generated_hash_directive,\n  verify_publish_bump,\n  vpkg_shared_import_marker\n}\n\n\n\nimport @vibe/compiler/cache {\n  build_source_groups_fingerprint_from_compact_fingerprints,\n  compact_string_fingerprint,\n  fingerprint_file_fs,\n  normalize_persistent_cache_text,\n  persistent_contract_facade_cache_path,\n  persistent_module_header_cache_path,\n  persistent_source_group_cache_path,\n  persistent_source_list_cache_path,\n  persistent_vpkg_prefix_cache_path\n}\n\nfn validate_vibex_entry_source(path: String, source: String) -> Unit with { Error } {\n  if !String::ends_with(path, \".vibex\") {\n    ()\n  } else {\n    let stmts = parse_program_preserving(lex(source))\n    let mut main_count = 0\n    let mut saw_value_main = false\n    let mut invalid_shape = false\n    let mut missing_effect_row = false\n    let mut exported_main = false\n    let mut i = 0\n    while i < Array::length(stmts) {\n      match Array::get(stmts, i) {\n        SFnDecl(exported, name, value, _, _) => if name == \"main\" {\n          main_count = main_count + 1\n          if exported {\n            exported_main = true\n          } else {\n            ()\n          }\n          match value {\n            EFn(type_params, _, params, ret, effects, _) => {\n              let returns_unit = match ret {\n                Some(TyName(name)) => name == \"Unit\",\n                _ => false\n              }\n              if Array::length(type_params) != 0 || Array::length(params) != 0 || !returns_unit {\n                invalid_shape = true\n              } else {\n                ()\n              }\n              match effects {\n                Some(_) => (),\n                None => {\n                  missing_effect_row = true\n                }\n              }\n            },\n            _ => {\n              invalid_shape = true\n            }\n          }\n        } else {\n          ()\n        },\n        SLet(_, _, name, _, _) => if name == \"main\" {\n          saw_value_main = true\n        } else {\n          ()\n        },\n        _ => ()\n      }\n      i = i + 1\n    }\n    if saw_value_main {\n      throw(\"\\{path}: value-bound main is not allowed in .vibex; use 'fn main with { ... } { ... }'\")\n    } else if main_count != 1 {\n      throw(\"\\{path}: .vibex executable requires exactly one fn main\")\n    } else if exported_main {\n      throw(\"\\{path}: .vibex fn main is an entry declaration and cannot be exported\")\n    } else if invalid_shape {\n      throw(\"\\{path}: .vibex fn main must have type () -> Unit\")\n    } else if missing_effect_row {\n      throw(\"\\{path}: .vibex fn main requires an explicit effect row; write 'with { }' for a pure entry\")\n    } else {\n      ()\n    }\n  }\n}\n\n\nfn source_lookup(sources: Array[(String, String)], path_key: String) -> Option[String] {\n  let mut i = 0\n  let mut found = None\n  while i < Array::length(sources) {\n    match found {\n      Some(_) => (),\n      None => {\n        let (p, src) = Array::get(sources, i)\n        if p == path_key {\n          found = Some(src)\n        }\n      }\n    }\n    i = i + 1\n  }\n  found\n}\n\nfn resolve_path_in_sources(base_dir: String, raw_path: String, sources: Array[(String, String)]) -> Option[(String, String)] {\n  let candidates = resolve_import_path_candidates(base_dir, raw_path)\n  let mut i = 0\n  let mut found = None\n  while i < Array::length(candidates) {\n    match found {\n      Some(_) => (),\n      None => {\n        let candidate = Array::get(candidates, i)\n        match source_lookup(sources, candidate) {\n          Some(source) => {\n            found = Some((candidate, source))\n          }\n          None => ()\n        }\n      }\n    }\n    i = i + 1\n  }\n  found\n}\n\nfn resolve_path_fs(base_dir: String, raw_path: String) -> String with { Fs } {\n  let candidates = resolve_import_path_candidates(base_dir, raw_path)\n  let mut i = 0\n  let mut found = \"\"\n  while i < Array::length(candidates) {\n    if found == \"\" {\n      let candidate = Array::get(candidates, i)\n      let candidate_exists = Fs::exists(candidate)\n      if candidate_exists {\n        found = candidate\n      }\n    }\n    i = i + 1\n  }\n  if found == \"\" {\n    Array::get(candidates, 0)\n  } else {\n    found\n  }\n}\n\nfn join_path(base_dir: String, rel_path: String) -> String {\n  if base_dir == \"\" {\n    normalize_path(rel_path)\n  } else {\n    normalize_path(String::concat(base_dir, String::concat(\"/\", rel_path)))\n  }\n}\n\nfn strip_trailing_cr(line: String) -> String {\n  let len = String::length(line)\n  if len > 0 {\n    if String::char_code_at(line, len - 1) == 13 {\n      line[0: len - 1]\n    } else {\n      line\n    }\n  } else {\n    line\n  }\n}\n\nfn string_to_bytes(s: String) -> Bytes {\n  let out = Bytes::new()\n  let len = String::length(s)\n  let mut i = 0\n  while i < len {\n    Bytes::push(out, String::char_code_at(s, i))\n    i = i + 1\n  }\n  out\n}\n\nfn special_bundle_header(path: String) -> Option[(Array[String], Array[String])] {\n  if String::ends_with(path, \"compiler_sources_bundle.vibe\") {\n    Some((array_empty(), [\n      \"compiler_sources\",\n      \"compiler_source_groups\"\n    ]))\n  } else {\n    None\n  }\n}\n\nfn split_tsv_fields(line: String) -> Array[String] {\n  let fields = array_empty()\n  let len = String::length(line)\n  let mut start = 0\n  let mut i = 0\n  while i <= len {\n    let at_field_end = if i == len {\n      true\n    } else {\n      String::char_code_at(line, i) == 9\n    }\n    if at_field_end {\n      Array::push(fields, line[start: i])\n      start = i + 1\n    }\n    i = i + 1\n  }\n  fields\n}\n\nlet header_value_separator = String::from_char_code(31)\n\nfn join_header_values(values: Array[String]) -> String {\n  let sb = StringBuilder::new()\n  let mut i = 0\n  while i < Array::length(values) {\n    if i > 0 {\n      StringBuilder::push(sb, header_value_separator)\n    }\n    StringBuilder::push(sb, Array::get(values, i))\n    i = i + 1\n  }\n  StringBuilder::freeze(sb)\n}\n\nfn split_header_values(text: String) -> Array[String] {\n  let values = array_empty()\n  if String::length(text) == 0 {\n    values\n  } else {\n    let sep = String::char_code_at(header_value_separator, 0)\n    let len = String::length(text)\n    let mut start = 0\n    let mut i = 0\n    while i <= len {\n      let at_value_end = if i == len {\n        true\n      } else {\n        String::char_code_at(text, i) == sep\n      }\n      if at_value_end {\n        Array::push(values, text[start: i])\n        start = i + 1\n      }\n      i = i + 1\n    }\n    values\n  }\n}\n\nfn empty_source_specs() -> Array[(String, String)] {\n  array_empty()\n}\n\nfn copy_source_specs(sources: Array[(String, String)]) -> Array[(String, String)] {\n  let out = empty_source_specs()\n  let mut i = 0\n  while i < Array::length(sources) {\n    Array::push(out, Array::get(sources, i))\n    i = i + 1\n  }\n  out\n}\n\nfn empty_group_specs() -> Array[(String, String, String)] {\n  array_empty()\n}\n\nfn empty_source_cache_specs() -> Array[(String, String, String)] {\n  array_empty()\n}\n\nfn empty_group_cache_specs() -> Array[(String, String, String, String)] {\n  array_empty()\n}\n\nfn empty_grouped_sources() -> Array[(String, Array[(String, String)])] {\n  array_empty()\n}\n\nfn source_paths(sources: Array[(String, String)]) -> Array[String] {\n  let paths = array_empty()\n  let mut i = 0\n  while i < Array::length(sources) {\n    let (path, _) = Array::get(sources, i)\n    if path != \"\" {\n      Array::push(paths, path)\n    } else ()\n    i = i + 1\n  }\n  paths\n}\n\nfn source_cache_spec_paths(specs: Array[(String, String, String)]) -> Array[String] {\n  let paths = array_empty()\n  let mut i = 0\n  while i < Array::length(specs) {\n    let (path, _, _) = Array::get(specs, i)\n    if path != \"\" {\n      Array::push(paths, path)\n    } else ()\n    i = i + 1\n  }\n  paths\n}\n\nfn grouped_source_paths(groups: Array[(String, Array[(String, String)])]) -> Array[String] {\n  let paths = array_empty()\n  let mut gi = 0\n  while gi < Array::length(groups) {\n    let (_, sources) = Array::get(groups, gi)\n    let mut si = 0\n    while si < Array::length(sources) {\n      let (path, _) = Array::get(sources, si)\n      if path != \"\" {\n        Array::push(paths, path)\n      } else ()\n      si = si + 1\n    }\n    gi = gi + 1\n  }\n  paths\n}\n\nfn group_cache_row_paths(rows: Array[(String, String, String, String)]) -> Array[String] {\n  let paths = array_empty()\n  let mut i = 0\n  while i < Array::length(rows) {\n    let (_, path, _, _) = Array::get(rows, i)\n    if path != \"\" {\n      Array::push(paths, path)\n    } else ()\n    i = i + 1\n  }\n  paths\n}\n\nfn push_grouped_source(groups: Array[(String, Array[(String, String)])], group_name: String, path: String, source: String) -> Unit {\n  let group_count = Array::length(groups)\n  let handled_by_tail = if group_count > 0 {\n    let (last_name, last_sources) = Array::get(groups, group_count - 1)\n    if last_name == group_name {\n      Array::push(last_sources, (path, source))\n      true\n    } else {\n      false\n    }\n  } else {\n    false\n  }\n  if !handled_by_tail {\n    let mut i = 0\n    let mut found_index = -1\n    while i < group_count {\n      if found_index == -1 {\n        let (name, sources) = Array::get(groups, i)\n        if name == group_name {\n          Array::push(sources, (path, source))\n          found_index = i\n        }\n      }\n      i = i + 1\n    }\n    if found_index == -1 {\n      let sources = array_empty()\n      Array::push(sources, (path, source))\n      Array::push(groups, (group_name, sources))\n    }\n  }\n}\n\nfn push_grouped_source_fingerprint(groups: Array[(String, Array[(String, String)])], group_name: String, path: String, source_fingerprint: String) -> Unit {\n  let group_count = Array::length(groups)\n  let handled_by_tail = if group_count > 0 {\n    let (last_name, last_specs) = Array::get(groups, group_count - 1)\n    if last_name == group_name {\n      Array::push(last_specs, (path, source_fingerprint))\n      true\n    } else {\n      false\n    }\n  } else {\n    false\n  }\n  if !handled_by_tail {\n    let mut i = 0\n    let mut found_index = -1\n    while i < group_count {\n      if found_index == -1 {\n        let (name, specs) = Array::get(groups, i)\n        if name == group_name {\n          Array::push(specs, (path, source_fingerprint))\n          found_index = i\n        }\n      }\n      i = i + 1\n    }\n    if found_index == -1 {\n      let specs = array_empty()\n      Array::push(specs, (path, source_fingerprint))\n      Array::push(groups, (group_name, specs))\n    }\n  }\n}\n\nfn empty_manifest_header_cache_rows() -> Array[(String, String, String, String)] {\n  array_empty()\n}\n\nfn push_context_packages_under(sb: StringBuilder, root: String) -> Unit with { Error, Fs } {\n  if Fs::exists(root) {\n    let scopes = Fs::readdir(root)\n    let mut i = 0\n    while i < Array::length(scopes) {\n      let scope = Array::get(scopes, i)\n      if String::starts_with(scope, \"@\") {\n        let scope_dir = String::concat(root, String::concat(\"/\", scope))\n        let names = Fs::readdir(scope_dir)\n        let mut j = 0\n        while j < Array::length(names) {\n          let name = Array::get(names, j)\n          let pkg_dir = String::concat(scope_dir, String::concat(\"/\", name))\n          if Fs::exists(String::concat(pkg_dir, \"/index.vpkg\")) || Fs::exists(String::concat(pkg_dir, \"/index.vibei\")) {\n            StringBuilder::push(sb, root)\n            StringBuilder::push(sb, \"|\")\n            StringBuilder::push(sb, scope)\n            StringBuilder::push(sb, \"/\")\n            StringBuilder::push(sb, name)\n            StringBuilder::push(sb, \"\\n\")\n          } else {\n            ()\n          }\n          j = j + 1\n        }\n      } else {\n        ()\n      }\n      i = i + 1\n    }\n  } else {\n    ()\n  }\n}\n\nexport fn resolution_context_fingerprint_fs() -> String with { Error, Fs } {\n  let sb = StringBuilder::new()\n  push_context_packages_under(sb, \".vibe/store\")\n  push_context_packages_under(sb, \"lib\")\n  let roots = external_lib_roots()\n  let mut i = 0\n  while i < Array::length(roots) {\n    push_context_packages_under(sb, Array::get(roots, i))\n    i = i + 1\n  }\n  compact_string_fingerprint(StringBuilder::freeze(sb))\n}\n\nfn module_policy_context_fingerprint_fs(entry_path: String, paths: Array[String]) -> String with { Error, Fs } {\n  let sb = StringBuilder::new()\n  let owners = array_empty()\n  let all_paths = array_empty()\n  if entry_path != \"\" {\n    Array::push(all_paths, entry_path)\n  } else ()\n  let mut pi = 0\n  while pi < Array::length(paths) {\n    let path = Array::get(paths, pi)\n    if path != \"\" && !contains_path(all_paths, path) {\n      Array::push(all_paths, path)\n    } else ()\n    pi = pi + 1\n  }\n  let mut i = 0\n  while i < Array::length(all_paths) {\n    let path = Array::get(all_paths, i)\n    StringBuilder::push(sb, \"source|\")\n    StringBuilder::push(sb, path)\n    if Fs::exists(path) {\n      validate_index_layout_fs(path)\n      let owner = nearest_vpkg_path_fs(path)\n      StringBuilder::push(sb, \"|owner|\")\n      StringBuilder::push(sb, owner)\n      if owner != \"\" && !contains_path(owners, owner) {\n        Array::push(owners, owner)\n      } else ()\n    } else {\n      StringBuilder::push(sb, \"|missing\")\n    }\n    StringBuilder::push(sb, \"\\n\")\n    i = i + 1\n  }\n  let mut oi = 0\n  while oi < Array::length(owners) {\n    let owner = Array::get(owners, oi)\n    validate_index_layout_fs(owner)\n    StringBuilder::push(sb, \"contract|\")\n    StringBuilder::push(sb, owner)\n    StringBuilder::push(sb, \"|\")\n    StringBuilder::push(sb, fingerprint_file_fs(owner))\n    StringBuilder::push(sb, \"\\n\")\n    let roots = contract_sibling_impl_raws(dir_of_path(owner))\n    let mut ri = 0\n    while ri < Array::length(roots) {\n      StringBuilder::push(sb, \"root|\")\n      StringBuilder::push(sb, owner)\n      StringBuilder::push(sb, \"|\")\n      StringBuilder::push(sb, Array::get(roots, ri))\n      StringBuilder::push(sb, \"\\n\")\n      ri = ri + 1\n    }\n    oi = oi + 1\n  }\n  compact_string_fingerprint(StringBuilder::freeze(sb))\n}\n\nfn persistent_resolution_context_fingerprint_fs(entry_path: String, paths: Array[String]) -> String with { Error, Fs } {\n  String::concat(resolution_context_fingerprint_fs(), String::concat(\":\", module_policy_context_fingerprint_fs(entry_path, paths)))\n}\n\nfn resolution_context_is_valid(resctx: Option[String], entry_path: String, paths: Array[String]) -> Bool with { Error, Fs } {\n  match resctx {\n    Some(fp) => fp == persistent_resolution_context_fingerprint_fs(entry_path, paths),\n    None => false\n  }\n}\n\nfn parse_persistent_source_list_cache(raw: String) -> (Int, Option[(String, String, String)], Array[(String, String, String)], Option[String]) with { Error } {\n  let len = String::length(raw)\n  let mut line_start = 0\n  let mut i = 0\n  let mut version = 0\n  let mut manifest = None\n  let mut resctx = None\n  let sources = empty_source_cache_specs()\n  while i <= len {\n    let at_line_end = if i == len {\n      true\n    } else {\n      String::char_code_at(raw, i) == 10\n    }\n    if at_line_end {\n      let line = strip_trailing_cr(raw[line_start: i])\n      if String::length(line) > 0 {\n        let fields = split_tsv_fields(line)\n        let tag = Array::get(fields, 0)\n        if tag == \"version\" {\n          if Array::length(fields) != 2 {\n            throw(\"invalid persistent source list cache version\")\n          }\n          let version_text = Array::get(fields, 1)\n          if version_text == \"1\" {\n            version = 1\n          } else if version_text == \"2\" {\n            version = 2\n          } else if version_text == \"3\" {\n            version = 3\n          } else {\n            throw(\"invalid persistent source list cache version\")\n          }\n        } else if tag == \"resctx\" {\n          if Array::length(fields) != 2 {\n            throw(\"invalid persistent source list cache resctx row\")\n          }\n          resctx = Some(Array::get(fields, 1))\n        } else if tag == \"manifest\" {\n          if version == 1 {\n            if Array::length(fields) != 3 {\n              throw(\"invalid persistent source list cache manifest row\")\n            }\n            manifest = Some((Array::get(fields, 1), \"\", Array::get(fields, 2)))\n          } else {\n            if Array::length(fields) != 4 {\n              throw(\"invalid persistent source list cache manifest row\")\n            }\n            manifest = Some((Array::get(fields, 1), Array::get(fields, 2), Array::get(fields, 3)))\n          }\n        } else if tag == \"source\" {\n          if version == 1 {\n            if Array::length(fields) != 3 {\n              throw(\"invalid persistent source list cache source row\")\n            }\n            Array::push(sources, (Array::get(fields, 1), \"\", Array::get(fields, 2)))\n          } else {\n            if Array::length(fields) != 4 {\n              throw(\"invalid persistent source list cache source row\")\n            }\n            Array::push(sources, (Array::get(fields, 1), Array::get(fields, 2), Array::get(fields, 3)))\n          }\n        } else {\n          throw(String::concat(\"invalid persistent source list cache row: \", line))\n        }\n      }\n      line_start = i + 1\n    }\n    i = i + 1\n  }\n  (version, manifest, sources, resctx)\n}\n\nfn parse_persistent_source_group_cache(raw: String) -> (Int, Option[(String, String, String)], Array[(String, String, String, String)], Option[String]) with { Error } {\n  let len = String::length(raw)\n  let mut line_start = 0\n  let mut i = 0\n  let mut version = 0\n  let mut manifest = None\n  let mut resctx = None\n  let rows = empty_group_cache_specs()\n  while i <= len {\n    let at_line_end = if i == len {\n      true\n    } else {\n      String::char_code_at(raw, i) == 10\n    }\n    if at_line_end {\n      let line = strip_trailing_cr(raw[line_start: i])\n      if String::length(line) > 0 {\n        let fields = split_tsv_fields(line)\n        let tag = Array::get(fields, 0)\n        if tag == \"version\" {\n          if Array::length(fields) != 2 {\n            throw(\"invalid persistent source group cache version\")\n          }\n          let version_text = Array::get(fields, 1)\n          if version_text == \"1\" {\n            version = 1\n          } else if version_text == \"2\" {\n            version = 2\n          } else if version_text == \"3\" {\n            version = 3\n          } else {\n            throw(\"invalid persistent source group cache version\")\n          }\n        } else if tag == \"resctx\" {\n          if Array::length(fields) != 2 {\n            throw(\"invalid persistent source group cache resctx row\")\n          }\n          resctx = Some(Array::get(fields, 1))\n        } else if tag == \"manifest\" {\n          if version == 1 {\n            if Array::length(fields) != 3 {\n              throw(\"invalid persistent source group cache manifest row\")\n            }\n            manifest = Some((Array::get(fields, 1), \"\", Array::get(fields, 2)))\n          } else {\n            if Array::length(fields) != 4 {\n              throw(\"invalid persistent source group cache manifest row\")\n            }\n            manifest = Some((Array::get(fields, 1), Array::get(fields, 2), Array::get(fields, 3)))\n          }\n        } else if tag == \"group\" {\n          if version == 1 {\n            if Array::length(fields) != 4 {\n              throw(\"invalid persistent source group cache group row\")\n            }\n            Array::push(rows, (Array::get(fields, 1), Array::get(fields, 2), \"\", Array::get(fields, 3)))\n          } else {\n            if Array::length(fields) != 5 {\n              throw(\"invalid persistent source group cache group row\")\n            }\n            Array::push(rows, (Array::get(fields, 1), Array::get(fields, 2), Array::get(fields, 3), Array::get(fields, 4)))\n          }\n        } else {\n          throw(String::concat(\"invalid persistent source group cache row: \", line))\n        }\n      }\n      line_start = i + 1\n    }\n    i = i + 1\n  }\n  (version, manifest, rows, resctx)\n}\n\nfn matches_cached_file_spec(path: String, stat_token_text: String, source_fingerprint: String) -> Bool with { Error, Fs } {\n  if !(Fs::exists(path)) {\n    false\n  } else {\n    let has_stat_token = String::length(stat_token_text) > 0\n    if has_stat_token {\n      if __to_string(Fs::stat_token(path)) == stat_token_text {\n        true\n      } else if String::length(source_fingerprint) > 0 {\n        fingerprint_file_fs(path) == source_fingerprint\n      } else {\n        false\n      }\n    } else if String::length(source_fingerprint) > 0 {\n      fingerprint_file_fs(path) == source_fingerprint\n    } else {\n      false\n    }\n  }\n}\n\nfn load_source_if_cached_file_spec_matches(path: String, stat_token_text: String, source_fingerprint: String) -> Option[String] with { Error, Fs } {\n  if !(Fs::exists(path)) {\n    None\n  } else {\n    let has_stat_token = String::length(stat_token_text) > 0\n    if has_stat_token {\n      if __to_string(Fs::stat_token(path)) == stat_token_text {\n        Some(Fs::read_file(path))\n      } else if String::length(source_fingerprint) > 0 {\n        let source = Fs::read_file(path)\n        if compact_string_fingerprint(source) == source_fingerprint {\n          Some(source)\n        } else {\n          None\n        }\n      } else {\n        None\n      }\n    } else if String::length(source_fingerprint) > 0 {\n      let source = Fs::read_file(path)\n      if compact_string_fingerprint(source) == source_fingerprint {\n        Some(source)\n      } else {\n        None\n      }\n    } else {\n      None\n    }\n  }\n}\n\n\nfn path_basename(path: String) -> String {\n  let idx = String::last_index_of(path, \"/\")\n  if idx < 0 {\n    path\n  } else {\n    path[idx + 1: String::length(path)]\n  }\n}\n\nfn is_vpkg_companion_basename(name: String) -> Bool {\n  String::ends_with(name, \"_test.vibe\") || String::ends_with(name, \"_bench.vibe\")\n}\n\nfn is_vpkg_explicit_only_basename(name: String) -> Bool {\n  String::ends_with(name, \".vibe\") && (String::starts_with(name, \"_\") || String::ends_with(name, \".draft.vibe\"))\n}\n\nfn is_vpkg_direct_production_basename(name: String) -> Bool {\n  name != \"index.vibei\" && name != \"index.vibe\" && name != \"index.vpkg\" && String::ends_with(name, \".vibe\") && !is_vpkg_companion_basename(name) && !String::ends_with(name, \".draft.vibe\") && !String::starts_with(name, \"_\")\n}\n\nfn validate_index_layout_fs(path: String) -> Unit with { Error, Fs } {\n  ensure_regular_source_fs(path)\n  let dir = dir_of_path(path)\n  let present = array_empty()\n  if Fs::exists(path_in_dir(dir, \"index.vibe\")) {\n    Array::push(present, \"index.vibe\")\n  } else ()\n  if Fs::exists(path_in_dir(dir, \"index.vibei\")) {\n    Array::push(present, \"index.vibei\")\n  } else ()\n  if Fs::exists(vpkg_path_in_dir(dir)) {\n    Array::push(present, \"index.vpkg\")\n  } else ()\n  if Array::length(present) > 1 {\n    throw(\"\\{String::join(present, \" and \")} exist in \\{dir} (#729/#897): a boundary has exactly one index\")\n  } else ()\n}\n\nfn vpkg_directory_shared_import_prefix_fs(path: String) -> String with { Error, Fs } {\n  if is_contract_ext(path) {\n    \"\"\n  } else {\n    let basename = path_basename(path)\n    let vpkg_path = if is_vpkg_companion_basename(basename) || is_vpkg_explicit_only_basename(basename) {\n      nearest_vpkg_path_fs(path)\n    } else if is_vpkg_direct_production_basename(basename) {\n      let direct = vpkg_path_in_dir(dir_of_path(path))\n      if Fs::exists(direct) {\n        direct\n      } else {\n        \"\"\n      }\n    } else {\n      \"\"\n    }\n    if vpkg_path == \"\" {\n      \"\"\n    } else {\n      ensure_regular_source_fs(vpkg_path)\n      let prefix_cache_path = persistent_vpkg_prefix_cache_path(vpkg_path, fingerprint_file_fs(vpkg_path))\n      let cached_prefix = if Fs::exists(prefix_cache_path) {\n        normalize_persistent_cache_text(Fs::read_file(prefix_cache_path))\n      } else {\n        \"\"\n      }\n      if String::starts_with(cached_prefix, \"v1\\n\") {\n        cached_prefix[3: String::length(cached_prefix)]\n      } else {\n        let vpkg_raw = Fs::read_file(vpkg_path)\n        let (_, vpkg_pin_blanked) = extract_require_pins(vpkg_raw)\n        let (_, _, vpkg_extra) = parse_contract_program(lex(vpkg_pin_blanked))\n        let prefix_text = contract_directory_shared_import_prefix_text(vpkg_extra)\n        Fs::write_file(prefix_cache_path, String::concat(\"v1\\n\", prefix_text))\n        prefix_text\n      }\n    }\n  }\n}\n\nfn apply_vpkg_directory_shared_imports_fs(path: String, pin_blanked: String) -> String with { Error, Fs } {\n  if String::starts_with(pin_blanked, vpkg_shared_import_marker) {\n    pin_blanked\n  } else {\n    let prefix = vpkg_directory_shared_import_prefix_fs(path)\n    if prefix == \"\" {\n      pin_blanked\n    } else {\n      String::concat(vpkg_shared_import_marker, String::concat(prefix, pin_blanked))\n    }\n  }\n}\n\nexport fn ingest_source_text_fs(path: String, raw: String) -> String with { Error, Fs } {\n  let (_, pin_blanked) = extract_require_pins(raw)\n  if is_contract_ext(path) {\n    if String::starts_with(pin_blanked, contract_facade_marker) {\n      pin_blanked\n    } else {\n      String::concat(contract_facade_marker, desugar_contract_source_fs(path, pin_blanked))\n    }\n  } else {\n    apply_vpkg_directory_shared_imports_fs(path, pin_blanked)\n  }\n}\n\nfn ingest_grouped_sources_fs(groups: Array[(String, Array[(String, String)])]) -> Array[(String, Array[(String, String)])] with { Error, Fs } {\n  let out = empty_grouped_sources()\n  let mut gi = 0\n  while gi < Array::length(groups) {\n    let (gname, gsources) = Array::get(groups, gi)\n    let mut si = 0\n    while si < Array::length(gsources) {\n      let (spath, stext) = Array::get(gsources, si)\n      push_grouped_source(out, gname, spath, ingest_source_text_fs(spath, stext))\n      si = si + 1\n    }\n    gi = gi + 1\n  }\n  out\n}\n\nfn load_cached_sources_rec(specs: Array[(String, String, String)], index: Int, out: Array[(String, String)]) -> Option[Array[(String, String)]] with { Error, Fs } {\n  if index >= Array::length(specs) {\n    Some(out)\n  } else {\n    let (path, stat_token_text, source_fingerprint) = Array::get(specs, index)\n    match load_source_if_cached_file_spec_matches(path, stat_token_text, source_fingerprint) {\n      Some(source) => {\n        Array::push(out, (path, ingest_source_text_fs(path, source)))\n        load_cached_sources_rec(specs, index + 1, out)\n      },\n      None => None\n    }\n  }\n}\n\nfn load_cached_grouped_sources_rec(rows: Array[(String, String, String, String)], index: Int, out: Array[(String, Array[(String, String)])]) -> Option[Array[(String, Array[(String, String)])]] with { Error, Fs } {\n  if index >= Array::length(rows) {\n    Some(out)\n  } else {\n    let (group_name, path, stat_token_text, source_fingerprint) = Array::get(rows, index)\n    match load_source_if_cached_file_spec_matches(path, stat_token_text, source_fingerprint) {\n      Some(source) => {\n        push_grouped_source(out, group_name, path, ingest_source_text_fs(path, source))\n        load_cached_grouped_sources_rec(rows, index + 1, out)\n      },\n      None => None\n    }\n  }\n}\n\nfn load_cached_group_fingerprint_rec(rows: Array[(String, String, String, String)], index: Int, out: Array[(String, Array[(String, String)])]) -> Option[Array[(String, Array[(String, String)])]] with { Error, Fs } {\n  if index >= Array::length(rows) {\n    Some(out)\n  } else {\n    let (group_name, path, stat_token_text, source_fingerprint) = Array::get(rows, index)\n    if !(matches_cached_file_spec(path, stat_token_text, source_fingerprint)) {\n      None\n    } else {\n      push_grouped_source_fingerprint(out, group_name, path, source_fingerprint)\n      load_cached_group_fingerprint_rec(rows, index + 1, out)\n    }\n  }\n}\n\nfn manifest_cache_is_valid(manifest: Option[(String, String, String)]) -> Bool with { Error, Fs } {\n  match manifest {\n    Some((path, stat_token_text, source_fingerprint)) =>\n    matches_cached_file_spec(path, stat_token_text, source_fingerprint),\n    None => true\n  }\n}\n\nfn load_persistent_sources_cache_if_valid(entry_path: String) -> Option[Array[(String, String)]] with { Error, Fs } {\n  let cache_path = persistent_source_list_cache_path(entry_path)\n  if !(Fs::exists(cache_path)) {\n    None\n  } else {\n    let (_, manifest, specs, resctx) = parse_persistent_source_list_cache(normalize_persistent_cache_text(Fs::read_file(cache_path)))\n    if !(resolution_context_is_valid(resctx, entry_path, source_cache_spec_paths(specs))) {\n      None\n    } else if !(manifest_cache_is_valid(manifest)) {\n      None\n    } else {\n      load_cached_sources_rec(specs, 0, empty_source_specs())\n    }\n  }\n}\n\nfn load_persistent_source_groups_cache_if_valid(entry_path: String) -> Option[Array[(String, Array[(String, String)])]] with { Error, Fs } {\n  let cache_path = persistent_source_group_cache_path(entry_path)\n  if !(Fs::exists(cache_path)) {\n    None\n  } else {\n    let (_, manifest, rows, resctx) = parse_persistent_source_group_cache(normalize_persistent_cache_text(Fs::read_file(cache_path)))\n    if !(resolution_context_is_valid(resctx, entry_path, group_cache_row_paths(rows))) {\n      None\n    } else if !(manifest_cache_is_valid(manifest)) {\n      None\n    } else {\n      load_cached_grouped_sources_rec(rows, 0, empty_grouped_sources())\n    }\n  }\n}\n\nfn manifest_path_of(manifest: Option[(String, String, String)]) -> Option[String] {\n  match manifest {\n    Some((path, _, _)) => Some(path),\n    None => None\n  }\n}\n\nfn load_persistent_sources_from_group_cache_if_valid(entry_path: String) -> Option[(Option[String], Array[(String, String)])] with { Error, Fs } {\n  let cache_path = persistent_source_group_cache_path(entry_path)\n  if !(Fs::exists(cache_path)) {\n    None\n  } else {\n    let (_, manifest, rows, resctx) = parse_persistent_source_group_cache(normalize_persistent_cache_text(Fs::read_file(cache_path)))\n    if !(resolution_context_is_valid(resctx, entry_path, group_cache_row_paths(rows))) {\n      None\n    } else if !(manifest_cache_is_valid(manifest)) {\n      None\n    } else {\n      let specs = empty_source_cache_specs()\n      let mut i = 0\n      while i < Array::length(rows) {\n        let (_, path, stat_token_text, source_fingerprint) = Array::get(rows, i)\n        Array::push(specs, (path, stat_token_text, source_fingerprint))\n        i = i + 1\n      }\n      match load_cached_sources_rec(specs, 0, empty_source_specs()) {\n        Some(sources) => Some((manifest_path_of(manifest), sources)),\n        None => None\n      }\n    }\n  }\n}\n\nfn load_persistent_source_groups_from_source_list_cache_if_valid(entry_path: String) -> Option[(Option[String], Array[(String, Array[(String, String)])])] with { Error, Fs } {\n  let cache_path = persistent_source_list_cache_path(entry_path)\n  if !(Fs::exists(cache_path)) {\n    None\n  } else {\n    let (_, manifest, specs, resctx) = parse_persistent_source_list_cache(normalize_persistent_cache_text(Fs::read_file(cache_path)))\n    if !(resolution_context_is_valid(resctx, entry_path, source_cache_spec_paths(specs))) {\n      None\n    } else if !(manifest_cache_is_valid(manifest)) {\n      None\n    } else {\n      match load_cached_sources_rec(specs, 0, empty_source_specs()) {\n        Some(sources) =>\n        match try_load_manifest_rows(entry_path) {\n          Some((base_dir, rows)) => {\n            let groups = build_grouped_sources_from_manifest_rows(base_dir, rows, sources)\n            if Array::length(flatten_group_sources(groups)) != Array::length(rows) {\n              None\n            } else {\n              Some((manifest_path_of(manifest), groups))\n            }\n          },\n          None => {\n            let groups = empty_grouped_sources()\n            Array::push(groups, (\"recursive\", sources))\n            Some((None, groups))\n          }\n        },\n        None => None\n      }\n    }\n  }\n}\n\nexport fn load_persistent_source_group_fingerprint_if_valid(entry_path: String) -> Option[String] with { Error, Fs } {\n  let cache_path = persistent_source_group_cache_path(entry_path)\n  if !(Fs::exists(cache_path)) {\n    None\n  } else {\n    let (_, manifest, rows, resctx) = parse_persistent_source_group_cache(normalize_persistent_cache_text(Fs::read_file(cache_path)))\n    if !(resolution_context_is_valid(resctx, entry_path, group_cache_row_paths(rows))) {\n      None\n    } else if !(manifest_cache_is_valid(manifest)) {\n      None\n    } else {\n      match load_cached_group_fingerprint_rec(rows, 0, empty_grouped_sources()) {\n        Some(groups) => Some(build_source_groups_fingerprint_from_compact_fingerprints(groups)),\n        None => None\n      }\n    }\n  }\n}\n\nfn build_persistent_sources_cache_text(entry_path: String, manifest_path: Option[String], sources: Array[(String, String)]) -> String with { Error, Fs } {\n  let sb = StringBuilder::new()\n  StringBuilder::push(sb, \"version\\t3\\n\")\n  StringBuilder::push(sb, \"resctx\\t\")\n  StringBuilder::push(sb, persistent_resolution_context_fingerprint_fs(entry_path, source_paths(sources)))\n  StringBuilder::push(sb, \"\\n\")\n  match manifest_path {\n    Some(path) => {\n      StringBuilder::push(sb, \"manifest\\t\")\n      StringBuilder::push(sb, path)\n      StringBuilder::push(sb, \"\\t\")\n      StringBuilder::push(sb, __to_string(Fs::stat_token(path)))\n      StringBuilder::push(sb, \"\\t\")\n      StringBuilder::push(sb, fingerprint_file_fs(path))\n      StringBuilder::push(sb, \"\\n\")\n    },\n    None => ()\n  }\n  let mut i = 0\n  while i < Array::length(sources) {\n    let (path, source) = Array::get(sources, i)\n    if String::length(path) == 0 {\n      ()\n    } else {\n      StringBuilder::push(sb, \"source\\t\")\n      StringBuilder::push(sb, path)\n      StringBuilder::push(sb, \"\\t\")\n      StringBuilder::push(sb, __to_string(Fs::stat_token(path)))\n      StringBuilder::push(sb, \"\\t\")\n      StringBuilder::push(sb, compact_string_fingerprint(source))\n      StringBuilder::push(sb, \"\\n\")\n    }\n    i = i + 1\n  }\n  StringBuilder::freeze(sb)\n}\n\nfn build_persistent_source_groups_cache_text(entry_path: String, manifest_path: Option[String], groups: Array[(String, Array[(String, String)])]) -> String with { Error, Fs } {\n  let sb = StringBuilder::new()\n  StringBuilder::push(sb, \"version\\t3\\n\")\n  StringBuilder::push(sb, \"resctx\\t\")\n  StringBuilder::push(sb, persistent_resolution_context_fingerprint_fs(entry_path, grouped_source_paths(groups)))\n  StringBuilder::push(sb, \"\\n\")\n  match manifest_path {\n    Some(path) => {\n      StringBuilder::push(sb, \"manifest\\t\")\n      StringBuilder::push(sb, path)\n      StringBuilder::push(sb, \"\\t\")\n      StringBuilder::push(sb, __to_string(Fs::stat_token(path)))\n      StringBuilder::push(sb, \"\\t\")\n      StringBuilder::push(sb, fingerprint_file_fs(path))\n      StringBuilder::push(sb, \"\\n\")\n    },\n    None => ()\n  }\n  let mut gi = 0\n  while gi < Array::length(groups) {\n    let (group_name, sources) = Array::get(groups, gi)\n    let mut si = 0\n    while si < Array::length(sources) {\n      let (path, source) = Array::get(sources, si)\n      if String::length(path) == 0 {\n        ()\n      } else {\n        StringBuilder::push(sb, \"group\\t\")\n        StringBuilder::push(sb, group_name)\n        StringBuilder::push(sb, \"\\t\")\n        StringBuilder::push(sb, path)\n        StringBuilder::push(sb, \"\\t\")\n        StringBuilder::push(sb, __to_string(Fs::stat_token(path)))\n        StringBuilder::push(sb, \"\\t\")\n        StringBuilder::push(sb, compact_string_fingerprint(source))\n        StringBuilder::push(sb, \"\\n\")\n      }\n      si = si + 1\n    }\n    gi = gi + 1\n  }\n  StringBuilder::freeze(sb)\n}\n\nfn collect_import_deps_from_stmts(stmts: Array[Stmt], base_dir: String) -> Array[String] with { Fs } {\n  let deps = array_empty()\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SImport(raw_path, _) => Array::push(deps, resolve_path_fs(base_dir, raw_path)),\n      SReExport(raw_path, _) => Array::push(deps, resolve_path_fs(base_dir, raw_path)),\n      _ => ()\n    }\n    i = i + 1\n  }\n  deps\n}\n\nexport fn load_or_parse_module_header_fs(path: String, source: String, parse_count: Int) -> (Array[String], Array[String], Int) with { Error, Fs } {\n  load_or_parse_module_header_fs_impl(path, source, parse_count)\n}\n\nfn store_persistent_sources_cache(entry_path: String, manifest_path: Option[String], sources: Array[(String, String)]) -> Unit with { Error, Fs } {\n  Fs::write_file(persistent_source_list_cache_path(entry_path), build_persistent_sources_cache_text(entry_path, manifest_path, sources))\n}\n\nfn store_persistent_source_groups_cache(entry_path: String, manifest_path: Option[String], groups: Array[(String, Array[(String, String)])]) -> Unit with { Error, Fs } {\n  Fs::write_file(persistent_source_group_cache_path(entry_path), build_persistent_source_groups_cache_text(entry_path, manifest_path, groups))\n}\n\nfn copy_grouped_sources(groups: Array[(String, Array[(String, String)])]) -> Array[(String, Array[(String, String)])] {\n  let out = empty_grouped_sources()\n  let mut gi = 0\n  while gi < Array::length(groups) {\n    let (group_name, sources) = Array::get(groups, gi)\n    let copied_sources = copy_source_specs(sources)\n    Array::push(out, (group_name, copied_sources))\n    gi = gi + 1\n  }\n  out\n}\n\nfn flatten_group_sources(groups: Array[(String, Array[(String, String)])]) -> Array[(String, String)] {\n  let out = empty_source_specs()\n  let mut gi = 0\n  while gi < Array::length(groups) {\n    let (_, sources) = Array::get(groups, gi)\n    let mut si = 0\n    while si < Array::length(sources) {\n      Array::push(out, Array::get(sources, si))\n      si = si + 1\n    }\n    gi = gi + 1\n  }\n  out\n}\n\nfn filter_group_sources(groups: Array[(String, Array[(String, String)])], ordered_sources: Array[(String, String)]) -> Array[(String, Array[(String, String)])] {\n  let filtered = empty_grouped_sources()\n  let mut gi = 0\n  while gi < Array::length(groups) {\n    let (group_name, sources) = Array::get(groups, gi)\n    let next_sources = empty_source_specs()\n    let mut si = 0\n    while si < Array::length(sources) {\n      let pair = Array::get(sources, si)\n      let (path, _) = pair\n      match source_lookup(ordered_sources, path) {\n        Some(_) => Array::push(next_sources, pair),\n        None => ()\n      }\n      si = si + 1\n    }\n    if Array::length(next_sources) > 0 {\n      Array::push(filtered, (group_name, next_sources))\n    }\n    gi = gi + 1\n  }\n  filtered\n}\n\nfn special_bundle_source_groups(entry_path: String) -> Option[Array[(String, Array[(String, String)])]] {\n  let _ = entry_path\n  None\n}\n\nfn normalize_bundle_source_groups(groups: Array[(String, Array[(String, String)])], main_path: String, main_source: String) -> Array[(String, Array[(String, String)])] {\n  let normalized = empty_grouped_sources()\n  let mut found = false\n  let mut gi = 0\n  while gi < Array::length(groups) {\n    let (group_name, sources) = Array::get(groups, gi)\n    let next_sources = empty_source_specs()\n    let mut si = 0\n    while si < Array::length(sources) {\n      let (path, source) = Array::get(sources, si)\n      if path == main_path {\n        Array::push(next_sources, (path, main_source))\n        found = true\n      } else {\n        Array::push(next_sources, (path, source))\n      }\n      si = si + 1\n    }\n    Array::push(normalized, (group_name, next_sources))\n    gi = gi + 1\n  }\n  if !found {\n    let entry_sources = empty_source_specs()\n    Array::push(entry_sources, (main_path, main_source))\n    Array::push(normalized, (\"entry\", entry_sources))\n  }\n  normalized\n}\n\nfn special_manifest_sources(entry_path: String) -> Option[(String, Array[(String, String)])] {\n  let _ = entry_path\n  None\n}\n\nfn special_manifest_source_groups(entry_path: String) -> Option[(String, Array[(String, Array[(String, String)])])] {\n  let _ = entry_path\n  None\n}\n\n\nfn cache_lookup(cache: Array[(String, TypeEnv)], path: String) -> Option[TypeEnv] {\n  let len = Array::length(cache)\n  let mut i = 0\n  let mut result = None\n  let mut done = false\n  while i < len {\n    if done {\n      i = len\n    } else {\n      let (p, e) = Array::get(cache, i)\n      if p == path {\n        result = Some(e)\n        done = true\n      }\n      i = i + 1\n    }\n  }\n  result\n}\n\nfn export_marker_name(name: String) -> String {\n  String::concat(\"__vibe_internal_export__:\", name)\n}\n\nfn env_has_export_marker(env: TypeEnv, name: String) -> Bool {\n  match env_lookup(env, export_marker_name(name)) {\n    Some(_) => true,\n    None => false\n  }\n}\n\nfn bind_export_markers(env: TypeEnv, exports: Array[String]) -> TypeEnv {\n  let mut acc = env\n  let mut i = 0\n  while i < Array::length(exports) {\n    acc = env_bind(acc, export_marker_name(Array::get(exports, i)), CtUnit)\n    i = i + 1\n  }\n  acc\n}\n\nfn bind_checked_imports(names: Array[(String, Option[String])], i: Int, env: TypeEnv, mod_env: TypeEnv) -> TypeEnv {\n  if i >= Array::length(names) {\n    env\n  } else {\n    let (name, alias) = Array::get(names, i)\n    let bound_name = match alias {\n      Some(a) => a,\n      None => name\n    }\n    let new_env = if env_has_export_marker(mod_env, name) {\n      match env_lookup(mod_env, name) {\n        Some(ty) => env_bind(env, bound_name, ty),\n        None => env\n      }\n    } else {\n      env\n    }\n    bind_checked_imports(names, i + 1, new_env, mod_env)\n  }\n}\n\n\nexport fn check_module(source: String, path: String, sources: Array[(String, String)], loading: Array[String], checked_cache: Array[(String, TypeEnv)]) -> TypeEnv with { Error } {\n  let cached = cache_lookup(checked_cache, path)\n  match cached {\n    Some(env) => env,\n    None => {\n      if contains_path(loading, path) {\n        throw(String::concat(\"import cycle detected: \", path))\n      }\n      let tokens = lex(source)\n      let stmts = parse_program(tokens)\n      let base_dir = dir_of_path(path)\n      let saved_loading_len = Array::length(loading)\n      Array::push(loading, path)\n      let mut import_env = EnvEmpty\n      let mut ri = 0\n      while ri < Array::length(stmts) {\n        let stmt = Array::get(stmts, ri)\n        import_env = match stmt {\n          SImport(raw_path, names) => {\n            match resolve_path_in_sources(base_dir, raw_path, sources) {\n              None => throw(String::concat(\"module not found: \", resolve_import_path(base_dir, raw_path))),\n              Some((resolved, mod_source)) => {\n                let mod_env = check_module(mod_source, resolved, sources, loading, checked_cache)\n                bind_checked_imports(names, 0, import_env, mod_env)\n              }\n            }\n          },\n          SReExport(raw_path, names) => {\n            match resolve_path_in_sources(base_dir, raw_path, sources) {\n              None => throw(String::concat(\"module not found: \", resolve_import_path(base_dir, raw_path))),\n              Some((resolved, mod_source)) => {\n                let mod_env = check_module(mod_source, resolved, sources, loading, checked_cache)\n                bind_checked_imports(names, 0, import_env, mod_env)\n              }\n            }\n          },\n          _ => import_env\n        }\n        ri = ri + 1\n      }\n      Array::truncate(loading, saved_loading_len)\n      let empty_defs = array_empty()\n      let check_errors = array_empty()\n      let check_tytab = array_empty()\n      let (env, _, _) = check_stmts(stmts, 0, import_env, empty_defs, SubstEmpty, 0, check_errors, check_tytab)\n      let cached_env = bind_export_markers(env, collect_exports(stmts))\n      Array::push(checked_cache, (path, cached_env))\n      cached_env\n    }\n  }\n}\n\n\nfn desugar_contract_source_fs(path: String, source: String) -> String with { Error, Fs } {\n  let dir = dir_of_path(path)\n  validate_index_layout_fs(path)\n  let (decls_raw, opaque_names, extra) = parse_contract_program(lex(source))\n  let pkg_version = extract_package_version(Fs::read_file(path))\n  let decls = array_empty()\n  let mut dvi = 0\n  while dvi < Array::length(decls_raw) {\n    let (dname, dsig) = Array::get(decls_raw, dvi)\n    if dname == \"version\" && dsig == \"val String\" && pkg_version != \"\" {\n      ()\n    } else {\n      Array::push(decls, (dname, dsig))\n    }\n    dvi = dvi + 1\n  }\n  let (impl_raws0, type_defs) = classify_contract_stmts(extra)\n  let impl_raws = if String::ends_with(path, \".vpkg\") {\n    merge_impl_raws_dedupe(impl_raws0, contract_sibling_impl_raws(dir))\n  } else if Array::length(impl_raws0) == 0 {\n    contract_sibling_impl_raws(dir)\n  } else {\n    impl_raws0\n  }\n  let contract_fp = fingerprint_file_fs(path)\n  let closure_fp_sb = StringBuilder::new()\n  StringBuilder::push(closure_fp_sb, contract_fp)\n  let member_paths = array_empty()\n  let member_raws = array_empty()\n  let mut fpi = 0\n  while fpi < Array::length(impl_raws) {\n    let fp_raw = Array::get(impl_raws, fpi)\n    let fp_resolved = resolve_path_fs(dir, fp_raw)\n    ensure_regular_source_fs(fp_resolved)\n    StringBuilder::push(closure_fp_sb, \"|\")\n    StringBuilder::push(closure_fp_sb, fp_resolved)\n    StringBuilder::push(closure_fp_sb, \":\")\n    StringBuilder::push(closure_fp_sb, fingerprint_file_fs(fp_resolved))\n    Array::push(member_paths, fp_resolved)\n    Array::push(member_raws, fp_raw)\n    fpi = fpi + 1\n  }\n  let closure_fp = compact_string_fingerprint(StringBuilder::freeze(closure_fp_sb))\n  let facade_cache_path = persistent_contract_facade_cache_path(path, closure_fp)\n  let cached_facade = if Fs::exists(facade_cache_path) {\n    normalize_persistent_cache_text(Fs::read_file(facade_cache_path))\n  } else {\n    \"\"\n  }\n  if String::starts_with(cached_facade, \"v1\\n\") {\n    return cached_facade[3: String::length(cached_facade)]\n  } else {\n    ()\n  }\n  let fresh_fp_sb = StringBuilder::new()\n  StringBuilder::push(fresh_fp_sb, contract_fp)\n  let impl_units = array_empty()\n  let union_stmts = array_empty()\n  let mut ri = 0\n  while ri < Array::length(member_raws) {\n    let raw = Array::get(member_raws, ri)\n    let resolved = Array::get(member_paths, ri)\n    let resolved_content = Fs::read_file(resolved)\n    StringBuilder::push(fresh_fp_sb, \"|\")\n    StringBuilder::push(fresh_fp_sb, resolved)\n    StringBuilder::push(fresh_fp_sb, \":\")\n    StringBuilder::push(fresh_fp_sb, compact_string_fingerprint(resolved_content))\n    let impl_ingested = ingest_source_text_fs(resolved, resolved_content)\n    let impl_stmts = parse_program(lex(impl_ingested))\n    Array::push(impl_units, (raw, impl_stmts))\n    let is_boundary_unit = String::ends_with(resolved, \"/index.vibei\") || String::ends_with(resolved, \"/index.vpkg\") || String::ends_with(resolved, \"/index.vibe\")\n    if is_boundary_unit {\n      ()\n    } else {\n      let mut si = 0\n      while si < Array::length(impl_stmts) {\n        Array::push(union_stmts, Array::get(impl_stmts, si))\n        si = si + 1\n      }\n    }\n    ri = ri + 1\n  }\n  let errors = check_contract(decls, opaque_names, union_stmts, type_defs)\n  if Array::length(errors) > 0 {\n    throw(\"\\{path}: contract violation: \\{String::join(errors, \"; \")}\")\n  } else ()\n  let facade = contract_facade_source(decls, opaque_names, type_defs, impl_units)\n  let facade_final = if pkg_version == \"\" {\n    facade\n  } else {\n    String::concat(facade, \"\\nexport let version: String = \\\"\\{pkg_version}\\\"\\n\")\n  }\n  let fresh_closure_fp = compact_string_fingerprint(StringBuilder::freeze(fresh_fp_sb))\n  Fs::write_file(persistent_contract_facade_cache_path(path, fresh_closure_fp), String::concat(\"v1\\n\", facade_final))\n  facade_final\n}\n\nexport fn contract_package_hashes_fs(path: String) -> (String, String) with { Error, Fs } {\n  validate_index_layout_fs(path)\n  let raw = Fs::read_file(path)\n  let (_, blanked) = extract_require_pins(raw)\n  let (decls, opaques, extra) = parse_contract_program(lex(blanked))\n  let (impl_raws0, type_defs) = classify_contract_stmts(extra)\n  let package_contract = normalize_path(path)\n  let dir = dir_of_path(package_contract)\n  let impl_raws = if String::ends_with(path, \".vpkg\") {\n    merge_impl_raws_dedupe(impl_raws0, contract_sibling_impl_raws(dir))\n  } else if Array::length(impl_raws0) == 0 {\n    contract_sibling_impl_raws(dir)\n  } else {\n    impl_raws0\n  }\n  let sources = array_empty()\n  let contract_last_slash = String::last_index_of(path, \"/\")\n  let contract_basename = if contract_last_slash < 0 {\n    path\n  } else {\n    path[contract_last_slash + 1: String::length(path)]\n  }\n  Array::push(sources, (contract_basename, canonicalize_for_hash(raw)))\n  let mut ri = 0\n  if String::ends_with(package_contract, \".vpkg\") {\n    let visited = path_set_new()\n    while ri < Array::length(impl_raws) {\n      let resolved = resolve_path_fs(dir, Array::get(impl_raws, ri))\n      collect_package_hash_source_closure_fs(package_contract, dir, resolved, sources, visited)\n      ri = ri + 1\n    }\n  } else {\n    while ri < Array::length(impl_raws) {\n      let iraw = Array::get(impl_raws, ri)\n      let resolved = resolve_path_fs(dir, iraw)\n      ensure_regular_source_fs(resolved)\n      let itext = Fs::read_file(resolved)\n      Array::push(sources, (iraw, itext))\n      ri = ri + 1\n    }\n  }\n  (package_hash_from_sources(sources), contract_hash(decls, opaques, type_defs))\n}\n\nexport fn write_generated_hash_fs(path: String) -> String with { Error, Fs } {\n  let (pkg_hash, _ct_hash) = contract_package_hashes_fs(path)\n  replace_generated_hash_directive(Fs::read_file(path), \"#\\{pkg_hash}\")\n}\n\nexport fn fill_require_pins_fs(source: String) -> String with { Error, Fs } {\n  fill_require_pins_fs_mode(source, false)\n}\n\nexport fn fill_require_pins_fs_mode(source: String, repin: Bool) -> String with { Error, Fs } {\n  let sb = StringBuilder::new()\n  let len = String::length(source)\n  let mut pos = 0\n  let mut scanning = true\n  while pos < len {\n    let mut nl = pos\n    while nl < len && String::char_code_at(source, nl) != 10 {\n      nl = nl + 1\n    }\n    let line = String::substring(source, pos, nl)\n    let trimmed = String::trim(line)\n    let mut emitted = false\n    if scanning && String::starts_with(trimmed, \"require \") {\n      let (pins_one, _) = extract_require_pins(String::concat(trimmed, \"\\n\"))\n      if Array::length(pins_one) == 1 {\n        let (pname, pver, ppin) = Array::get(pins_one, 0)\n        if ppin == \"\" || repin {\n          let store_index_vpkg = String::concat(\".vibe/store/\", String::concat(pname, \"/index.vpkg\"))\n          let store_index_vibei = String::concat(\".vibe/store/\", String::concat(pname, \"/index.vibei\"))\n          let store_index = if Fs::exists(store_index_vpkg) {\n            store_index_vpkg\n          } else {\n            store_index_vibei\n          }\n          if Fs::exists(store_index) {\n            ()\n          } else {\n            throw(\"cannot pin \\{pname} offline: not installed in the store (.vibe/store/\\{pname}/)\")\n          }\n          let (pkg_hash, _) = contract_package_hashes_fs(store_index)\n          StringBuilder::push(sb, \"require \\{pname} \\{pver} = #\\{pkg_hash}\")\n          emitted = true\n        } else ()\n      } else ()\n    } else {\n      if String::length(trimmed) == 0 || String::starts_with(trimmed, \"//\") {\n        ()\n      } else {\n        scanning = false\n      }\n    }\n    if emitted {\n      ()\n    } else {\n      StringBuilder::push(sb, line)\n    }\n    if nl < len {\n      StringBuilder::push(sb, \"\\n\")\n    } else ()\n    pos = nl + 1\n  }\n  StringBuilder::freeze(sb)\n}\n\nexport fn publish_check_fs(prev_contract_path: String, next_contract_path: String, prev_version: String, next_version: String) -> Array[String] with { Error, Fs } {\n  let prev_raw = Fs::read_file(prev_contract_path)\n  let (_, prev_blanked) = extract_require_pins(prev_raw)\n  let (pd, po, pextra) = parse_contract_program(lex(prev_blanked))\n  let (_, ptypes) = classify_contract_stmts(pextra)\n  let next_raw = Fs::read_file(next_contract_path)\n  let (_, next_blanked) = extract_require_pins(next_raw)\n  let (nd, no, nextra) = parse_contract_program(lex(next_blanked))\n  let (_, ntypes) = classify_contract_stmts(nextra)\n  let prev_directive = extract_package_version(prev_raw)\n  let next_directive = extract_package_version(next_raw)\n  let errors = array_empty()\n  if prev_version != \"\" && prev_directive != \"\" && prev_version != prev_directive {\n    Array::push(errors, \"previous version \\{prev_version} contradicts the contract's version directive \\{prev_directive}\")\n  } else ()\n  if next_version != \"\" && next_directive != \"\" && next_version != next_directive {\n    Array::push(errors, \"claimed version \\{next_version} contradicts the contract's version directive \\{next_directive}\")\n  } else ()\n  let pv = if prev_version != \"\" {\n    prev_version\n  } else {\n    prev_directive\n  }\n  let nv = if next_version != \"\" {\n    next_version\n  } else {\n    next_directive\n  }\n  if pv == \"\" || nv == \"\" {\n    Array::push(errors, \"publish versions unavailable: pass them explicitly or add a `version x.y.z` directive to the contract (#754)\")\n    errors\n  } else if Array::length(errors) > 0 {\n    errors\n  } else {\n    verify_publish_bump(pv, nv, contract_surface_lines(pd, po, ptypes), contract_surface_lines(nd, no, ntypes))\n  }\n}\n\nfn verify_store_package_fs(importer: String, pins: Array[(String, String, String)], store_index_path: String) -> Unit with { Error, Fs } {\n  let prefix = \".vibe/store/\"\n  let suffix = if String::ends_with(store_index_path, \"/index.vpkg\") {\n    \"/index.vpkg\"\n  } else {\n    \"/index.vibei\"\n  }\n  let name = String::substring(store_index_path, String::length(prefix), String::length(store_index_path) - String::length(suffix))\n  let mut pin_hash = \"\"\n  let mut pin_found = false\n  let mut pi = 0\n  while pi < Array::length(pins) {\n    let (pname, _, phash) = Array::get(pins, pi)\n    if pname == name {\n      pin_hash = phash\n      pin_found = true\n    } else ()\n    pi = pi + 1\n  }\n  if pin_found {\n    ()\n  } else {\n    throw(\"no require pin for \\{name} in \\{importer} (add: require \\{name} <x.y.z> = #<pkg-hash>; compute with `vibe hash`)\")\n  }\n  if pin_hash == \"\" {\n    throw(\"unpinned require for \\{name} in \\{importer}: run `vibe fmt` (VIBE_FILL_PINS=1) to insert the pin from the store\")\n  } else ()\n  if Fs::exists(store_index_path) {\n    ()\n  } else {\n    throw(\"package \\{name} is not installed in the store (.vibe/store/\\{name}/)\")\n  }\n  let (actual, _) = contract_package_hashes_fs(store_index_path)\n  if actual == pin_hash {\n    ()\n  } else {\n    throw(\"pin mismatch for \\{name}: \\{importer} requires #\\{pin_hash} but the store copy is #\\{actual}\")\n  }\n}\n\nfn verify_lib_package_fs(importer: String, pins: Array[(String, String, String)], lib_index_path: String) -> Unit with { Error, Fs } {\n  let suffix = if String::ends_with(lib_index_path, \"/index.vpkg\") {\n    \"/index.vpkg\"\n  } else {\n    \"/index.vibei\"\n  }\n  let at = String::last_index_of(lib_index_path, \"@\")\n  let name = String::substring(lib_index_path, at, String::length(lib_index_path) - String::length(suffix))\n  let mut pin_hash = \"\"\n  let mut pi = 0\n  while pi < Array::length(pins) {\n    let (pname, _, phash) = Array::get(pins, pi)\n    if pname == name {\n      pin_hash = phash\n    } else ()\n    pi = pi + 1\n  }\n  if pin_hash == \"\" {\n    if vibe_env_flag(\"VIBE_REQUIRE_PINS\") {\n      throw(\"pin required for \\{name} (VIBE_REQUIRE_PINS=1): \\{importer} resolves it via the dev-mode lib lane; add `require \\{name} <version> = #pkg:sha1:<hash>` (ADR-0065)\")\n    } else if !(Fs::exists(lib_index_path)) {\n      throw(\"cannot resolve import \\{name}: not found via lib/ or VIBE_LIB (looked for \\{lib_index_path})\")\n    } else ()\n  } else {\n    let (actual, _) = contract_package_hashes_fs(lib_index_path)\n    if actual == pin_hash {\n      ()\n    } else {\n      throw(\"pin mismatch for \\{name}: \\{importer} requires #\\{pin_hash} but the lib/ copy is #\\{actual}\")\n    }\n  }\n}\n\nfn enforce_incoming_boundary_fs(importer: String, target: String) -> Unit with { Error, Fs } {\n  if is_vpkg_companion_basename(path_basename(target)) {\n    throw(\"cannot import test/bench companion as a module target: \\{target}\")\n  } else ()\n  let target_owner = nearest_vpkg_path_fs(target)\n  if target_owner == \"\" {\n    ()\n  } else if target == target_owner {\n    ()\n  } else {\n    let importer_owner = nearest_vpkg_path_fs(importer)\n    if importer_owner == target_owner {\n      ()\n    } else {\n      throw(\"cannot import \\{target} across a package boundary; target owner is \\{target_owner} (#729); import the owner contract instead\")\n    }\n  }\n}\n\nfn package_relative_hash_key(package_dir: String, source_path: String) -> String with { Error } {\n  let prefix = if package_dir == \"\" {\n    \"\"\n  } else if package_dir == \"/\" {\n    \"/\"\n  } else {\n    String::concat(package_dir, \"/\")\n  }\n  let relative = if prefix == \"\" {\n    source_path\n  } else if String::starts_with(source_path, prefix) {\n    source_path[String::length(prefix): String::length(source_path)]\n  } else {\n    throw(\"package hash source \\{source_path} is outside package directory \\{package_dir}\")\n  }\n  String::concat(\"./\", relative)\n}\n\nfn collect_package_hash_source_closure_fs(package_contract: String, package_dir: String, source_path: String, sources: Array[(String, String)], visited: Array[Array[String]]) -> Unit with { Error, Fs } {\n  if path_set_contains(visited, source_path) {\n    ()\n  } else {\n    path_set_add(visited, source_path)\n    validate_index_layout_fs(source_path)\n    let source = Fs::read_file(source_path)\n    Array::push(sources, (package_relative_hash_key(package_dir, source_path), source))\n    let (deps, _, _) = load_or_parse_module_header_fs(source_path, source, 0)\n    let mut i = 0\n    while i < Array::length(deps) {\n      let dep = Array::get(deps, i)\n      enforce_incoming_boundary_fs(source_path, dep)\n      let dep_owner = nearest_vpkg_path_fs(dep)\n      if dep_owner == package_contract && dep != package_contract {\n        collect_package_hash_source_closure_fs(package_contract, package_dir, dep, sources, visited)\n      } else {\n        ()\n      }\n      i = i + 1\n    }\n  }\n}\n\nfn collect_sources_rec(path: String, sources: Array[(String, String)], visited: Array[Array[String]]) -> Unit with { Error, Fs } {\n  if path_set_contains(visited, path) {\n    ()\n  }\n  else {\n    path_set_add(visited, path)\n    if !(Fs::exists(path)) {\n      throw(\"cannot resolve module: \\{path} does not exist\")\n    } else ()\n    validate_index_layout_fs(path)\n    let raw_source = Fs::read_file(path)\n    let (pins, pin_blanked) = extract_require_pins(raw_source)\n    let source = if is_contract_ext(path) {\n      String::concat(contract_facade_marker, desugar_contract_source_fs(path, pin_blanked))\n    } else {\n      apply_vpkg_directory_shared_imports_fs(path, pin_blanked)\n    }\n    let (deps, _, _) = load_or_parse_module_header_fs(path, source, 0)\n    let mut i = 0\n    while i < Array::length(deps) {\n      let dep = Array::get(deps, i)\n      enforce_incoming_boundary_fs(path, dep)\n      if String::starts_with(dep, \".vibe/store/\") && is_contract_ext(dep) {\n        verify_store_package_fs(path, pins, dep)\n      } else if is_contract_ext(dep) && String::last_index_of(dep, \"@\") >= 0 {\n        verify_lib_package_fs(path, pins, dep)\n      } else ()\n      collect_sources_rec(dep, sources, visited)\n      i = i + 1\n    }\n    Array::push(sources, (path, source))\n  }\n}\n\nexport fn collect_all_sources_fs(entry_path: String) -> Array[(String, String)] with { Error, Fs } {\n  match special_manifest_sources(entry_path) {\n    Some((manifest_path, sources)) => {\n      let _ = manifest_path\n      copy_source_specs(sources)\n    },\n    None =>\n    match load_persistent_sources_cache_if_valid(entry_path) {\n      Some(sources) => sources,\n      None => {\n        match try_collect_manifest_sources_fs(entry_path) {\n          Some((manifest_path, sources)) => {\n            store_persistent_sources_cache(entry_path, Some(manifest_path), sources)\n            sources\n          },\n          None => {\n            match try_load_manifest_rows(entry_path) {\n              Some((base_dir, rows)) => {\n                let manifest_path = join_path(base_dir, \"compiler_sources_manifest.tsv\")\n                let preloaded_sources = load_manifest_full_sources(base_dir, rows)\n                store_persistent_sources_cache(entry_path, Some(manifest_path), preloaded_sources)\n                preloaded_sources\n              },\n              None => {\n                let sources = array_empty()\n                let visited = path_set_new()\n                collect_sources_rec(entry_path, sources, visited)\n                store_persistent_sources_cache(entry_path, None, sources)\n                sources\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}\n\nfn move_entry_last_grouped(groups: Array[(String, Array[(String, String)])], entry_path: String) -> Array[(String, Array[(String, String)])] {\n  let glen = Array::length(groups)\n  let mut total = 0\n  let mut gi = 0\n  while gi < glen {\n    let (_, gsources) = Array::get(groups, gi)\n    total = total + Array::length(gsources)\n    gi = gi + 1\n  }\n  let mut seen = 0\n  let mut entry_is_last = false\n  let mut entry_found = false\n  let mut entry_source = \"\"\n  gi = 0\n  while gi < glen {\n    let (_, gsources) = Array::get(groups, gi)\n    let mut si = 0\n    while si < Array::length(gsources) {\n      seen = seen + 1\n      let (spath, stext) = Array::get(gsources, si)\n      if spath == entry_path {\n        entry_found = true\n        entry_source = stext\n        if seen == total {\n          entry_is_last = true\n        } else {\n          ()\n        }\n      } else {\n        ()\n      }\n      si = si + 1\n    }\n    gi = gi + 1\n  }\n  if !entry_found || entry_is_last {\n    groups\n  } else {\n    let out = empty_grouped_sources()\n    gi = 0\n    while gi < glen {\n      let (gname, gsources) = Array::get(groups, gi)\n      let mut si = 0\n      while si < Array::length(gsources) {\n        let (spath, stext) = Array::get(gsources, si)\n        if spath == entry_path {\n          ()\n        } else {\n          push_grouped_source(out, gname, spath, stext)\n        }\n        si = si + 1\n      }\n      gi = gi + 1\n    }\n    push_grouped_source(out, \"entry_last\", entry_path, entry_source)\n    out\n  }\n}\n\nexport fn collect_source_groups_fs(entry_path: String) -> Array[(String, Array[(String, String)])] with { Error, Fs } {\n  if String::ends_with(entry_path, \".vibex\") {\n    ensure_regular_source_fs(entry_path)\n    validate_vibex_entry_source(entry_path, Fs::read_file(entry_path))\n  } else {\n    ()\n  }\n  let collected = match special_manifest_source_groups(entry_path) {\n    Some((manifest_path, groups)) => {\n      let _ = manifest_path\n      copy_grouped_sources(groups)\n    },\n    None =>\n    match load_persistent_source_groups_cache_if_valid(entry_path) {\n      Some(groups) => groups,\n      None =>\n      match load_persistent_source_groups_from_source_list_cache_if_valid(entry_path) {\n        Some((manifest_path, groups)) => {\n          store_persistent_source_groups_cache(entry_path, manifest_path, groups)\n          groups\n        },\n        None =>\n        match try_collect_manifest_source_groups_fs(entry_path) {\n          Some((manifest_path, groups)) => {\n            store_persistent_source_groups_cache(entry_path, Some(manifest_path), groups)\n            groups\n          },\n          None =>\n          match try_load_manifest_rows(entry_path) {\n            Some((base_dir, rows)) => {\n              let manifest_path = join_path(base_dir, \"compiler_sources_manifest.tsv\")\n              let preloaded_sources = load_manifest_full_sources(base_dir, rows)\n              let groups = empty_grouped_sources()\n              let mut j = 0\n              while j < Array::length(rows) {\n                let (group_name, rel_path) = Array::get(rows, j)\n                let path = join_path(base_dir, rel_path)\n                let mut found = \"\"\n                let mut k = 0\n                while k < Array::length(preloaded_sources) {\n                  if found == \"\" {\n                    let (source_path, source_text) = Array::get(preloaded_sources, k)\n                    if source_path == path {\n                      found = source_text\n                    }\n                  }\n                  k = k + 1\n                }\n                if found == \"\" {\n                  ()\n                } else {\n                  push_grouped_source(groups, group_name, path, found)\n                }\n                j = j + 1\n              }\n              store_persistent_source_groups_cache(entry_path, Some(manifest_path), groups)\n              groups\n            },\n            None => {\n              let groups = empty_grouped_sources()\n              let recursive_sources = collect_all_sources_fs(entry_path)\n              Array::push(groups, (\"recursive\", recursive_sources))\n              store_persistent_source_groups_cache(entry_path, None, groups)\n              groups\n            }\n          }\n        }\n      }\n    }\n  }\n  move_entry_last_grouped(ingest_grouped_sources_fs(collected), entry_path)\n}\n\n\nexport fn collect_merged_stmts(sources: Array[(String, String)]) -> Array[Stmt] with { Error } {\n  let merged = array_empty()\n  let mut si = 0\n  while si < Array::length(sources) {\n    let (_, src) = Array::get(sources, si)\n    let stmts = parse_program(lex(src))\n    let mut j = 0\n    while j < Array::length(stmts) {\n      let stmt = Array::get(stmts, j)\n      match stmt {\n        SImport(_, _) => (),\n        SReExport(_, _) => (),\n        SAliasDecl(_, _) => (),\n        _ => Array::push(merged, stmt)\n      }\n      j = j + 1\n    }\n    si = si + 1\n  }\n  merged\n}\n\nfn vpkg_scan_is_directory(path: String) -> Bool with { Fs } {\n  Fs::exists(String::concat(path, \"/.\"))\n}\n\nfn vpkg_scan_skip_dir(name: String) -> Bool {\n  (String::length(name) > 0 && String::char_code_at(name, 0) == '.') || name == \"_build\" || name == \"node_modules\" || name == \"target\" || name == \"deps\"\n}\n\nfn vpkg_scan_rec(dir: String, out: Array[String]) -> Unit with { Error, Fs } {\n  let has_vpkg = Fs::exists(String::concat(dir, \"/index.vpkg\"))\n  let has_vibei = Fs::exists(String::concat(dir, \"/index.vibei\"))\n  let has_vibe = Fs::exists(String::concat(dir, \"/index.vibe\"))\n  if !has_vpkg && (has_vibei || has_vibe) {\n    Array::push(out, dir)\n  } else {\n    ()\n  }\n  let names = Fs::readdir(dir)\n  let mut i = 0\n  while i < Array::length(names) {\n    let name = Array::get(names, i)\n    if !vpkg_scan_skip_dir(name) {\n      let full = String::concat(dir, String::concat(\"/\", name))\n      if vpkg_scan_is_directory(full) {\n        vpkg_scan_rec(full, out)\n      } else {\n        ()\n      }\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n}\n\nexport fn find_missing_vpkg_dirs(root: String) -> Array[String] with { Error, Fs } {\n  let out = array_empty()\n  vpkg_scan_rec(root, out)\n  out\n}\n\nexport fn check_missing_vpkg_dirs(root: String) -> Int with { Error, Fs } {\n  let missing = find_missing_vpkg_dirs(root)\n  if Array::length(missing) == 0 {\n    0\n  } else {\n    throw(String::concat(\"missing index.vpkg (#897) in: \", String::join(missing, \", \")))\n  }\n}\n\nfn package_deps_missing(dir: String) -> Array[String] with { Error, Fs } {\n  let vpkg_path = String::concat(dir, \"/index.vpkg\")\n  if !Fs::exists(vpkg_path) {\n    array_empty()\n  } else {\n    let raw = Fs::read_file(vpkg_path)\n    let name = extract_package_name(raw)\n    if name == \"\" {\n      array_empty()\n    } else {\n      let deps = extract_package_deps(raw)\n      let (_pins, blanked) = extract_require_pins(raw)\n      let (_decls, _opaques, extra) = parse_contract_program(lex(blanked))\n      let (impl_raws0, _type_defs) = classify_contract_stmts(extra)\n      let impl_raws = merge_impl_raws_dedupe(impl_raws0, contract_sibling_impl_raws(dir))\n      let impl_sources = array_empty()\n      let mut i = 0\n      while i < Array::length(impl_raws) {\n        let resolved = resolve_path_fs(dir, Array::get(impl_raws, i))\n        Array::push(impl_sources, Fs::read_file(resolved))\n        i = i + 1\n      }\n      let missing = deps_missing_for_imports(deps, impl_sources)\n      let out = array_empty()\n      let mut mi = 0\n      while mi < Array::length(missing) {\n        Array::push(out, \"\\{dir}: import of \\{Array::get(missing, mi)} not declared in deps\")\n        mi = mi + 1\n      }\n      out\n    }\n  }\n}\n\nfn deps_missing_scan_rec(dir: String, out: Array[String]) -> Unit with { Error, Fs } {\n  let here = package_deps_missing(dir)\n  let mut hi = 0\n  while hi < Array::length(here) {\n    Array::push(out, Array::get(here, hi))\n    hi = hi + 1\n  }\n  let names = Fs::readdir(dir)\n  let mut i = 0\n  while i < Array::length(names) {\n    let name = Array::get(names, i)\n    if !vpkg_scan_skip_dir(name) {\n      let full = String::concat(dir, String::concat(\"/\", name))\n      if vpkg_scan_is_directory(full) {\n        deps_missing_scan_rec(full, out)\n      } else {\n        ()\n      }\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n}\n\nexport fn find_deps_missing(root: String) -> Array[String] with { Error, Fs } {\n  let out = array_empty()\n  deps_missing_scan_rec(root, out)\n  out\n}\n\nexport fn check_deps_missing(root: String) -> Int with { Error, Fs } {\n  let missing = find_deps_missing(root)\n  if Array::length(missing) == 0 {\n    0\n  } else {\n    throw(String::concat(\"deps missing for imports (#1128/#1145): \", String::join(missing, \"; \")))\n  }\n}\n")
}

let source_222 = () -> (String, String) {
  ("lib/@vibe/compiler/normalize/index.vpkg",
"name = @vibe/compiler/normalize\nversion = 0.0.1\ndescription =\n  #|@vibe/compiler/normalize — the `vibe normalize` canonicalizing source\ndeps = {\n  @vibe/compiler/contract : 0.0.1\n  @vibe/compiler/core : 0.0.1\n  @vibe/compiler/syntax : 0.0.1\n  @vibe/core : 0.2.0\n}\n\ngenerated_hash =\n\n// @vibe/compiler/normalize — the `vibe normalize` canonicalizing source\n// transform (parse -> module flatten -> DCE -> categorize -> re-render), plus\n// the two RC-enabling pure AST rewrites codegen runs before building each\n// function's Perceus plan: lift_match_scrutinees (#703/#708) and\n// uniquify_shadowed_bindings (#712/#715). First COMPILER-INTERNAL contract\n// batch (ADR-0070 Phase 3, #897) — unlike the stdlib batches, this package\n// is compiled into the compiler itself via compiler_sources_manifest.tsv\n// (group `normalize`, dual-row: this contract + normalize.vibe).\n//\n// The old index.vibe was not a facade but the whole implementation (the\n// package is single-file), so it moved verbatim to normalize.vibe and this\n// contract declares its four exported fns. No exported types, no `version`\n// binding existed (compiler-internal package — nothing to preserve, unlike\n// the PR #914 stdlib precedent), so the surface is fns only. Signature\n// types (Stmt/Expr from ../core) are structural signature text resolved\n// against the implementation import when the facade is merged in — same\n// precedent as @vibe/symbol / @vibe/parser (no re-import needed here).\n\nfn normalize_stmts(stmts: Array[Stmt]) -> Array[Stmt]\nfn normalize_source(src: String) -> String with { Error }\nfn lift_match_scrutinees(expr: Expr, counter: Array[Int]) -> Expr\nfn uniquify_shadowed_bindings(expr: Expr, env: Map[String, String], counter: Array[Int], seen: Array[String]) -> Expr\n\n// #1194 (ADR-0081): recv.method(args) -> Type::method(recv, args) where\n// locally recoverable. Exported directly (in addition to being wired into\n// normalize_stmts) so it's unit-testable on a bare Stmt list.\nfn normalize_dot_calls(stmts: Array[Stmt]) -> Array[Stmt]\n")
}

let source_223 = () -> (String, String) {
  ("lib/@vibe/compiler/normalize/normalize.vibe",
"\n\nimport @vibe/compiler/contract {\n  extract_require_pins\n}\n\nimport @vibe/core {\n  array_empty\n}\n\nimport @vibe/compiler/syntax {\n  Token, lex, parse_program_preserving, print_stmt\n}\n\nimport @vibe/compiler/core {\n  Expr, Pat, Stmt, TypeExpr, dce_stmts, make_import_alias_rewriter\n}\n\n\nfn empty_stmts() -> Array[Stmt] {\n  array_empty()\n}\n\nfn empty_strs() -> Array[String] {\n  array_empty()\n}\n\nfn join_module_name(prefix: String, name: String) -> String {\n  if prefix == \"\" {\n    name\n  } else {\n    String::concat(prefix, String::concat(\"::\", name))\n  }\n}\n\nfn module_value_aliases(body: Array[Stmt], prefix: String, out: Array[(String, String)]) -> Int {\n  let mut i = 0\n  while i < Array::length(body) {\n    match Array::get(body, i) {\n      SLet(_, _, name, _, _) => {\n        Array::push(out, (name, join_module_name(prefix, name)))\n        0\n      },\n      SLetMut(name, _, _) => {\n        Array::push(out, (name, join_module_name(prefix, name)))\n        0\n      },\n      SExternLet(name, _) => {\n        Array::push(out, (name, join_module_name(prefix, name)))\n        0\n      },\n      SModule(_, inner, inner_body) => {\n        let _ = module_value_aliases(inner_body, join_module_name(prefix, inner), out)\n        0\n      },\n      _ => 0\n    }\n    i = i + 1\n  }\n  0\n}\n\nfn flatten_module_body(body: Array[Stmt], prefix: String, rewrite_aliases: (Expr) -> Expr, out: Array[Stmt]) -> Int {\n  let mut i = 0\n  while i < Array::length(body) {\n    match Array::get(body, i) {\n      SLet(exp, is_rec, name, ty, b) => {\n        Array::push(out, SLet(exp, is_rec, join_module_name(prefix, name), ty, rewrite_aliases(b)))\n        0\n      },\n      SLetMut(name, ty, b) => {\n        Array::push(out, SLetMut(join_module_name(prefix, name), ty, rewrite_aliases(b)))\n        0\n      },\n      SExternLet(name, ty) => {\n        Array::push(out, SExternLet(join_module_name(prefix, name), ty))\n        0\n      },\n      SModule(_, inner, inner_body) => {\n        let _ = flatten_module_body(inner_body, join_module_name(prefix, inner), rewrite_aliases, out)\n        0\n      },\n      other => {\n        Array::push(out, other)\n        0\n      }\n    }\n    i = i + 1\n  }\n  0\n}\n\nfn is_module_stmt(stmt: Stmt) -> Bool {\n  match stmt {\n    SModule(_, _, _) => true,\n    _ => false\n  }\n}\n\n\nfn exported_value_names(stmts: Array[Stmt]) -> Array[String] {\n  let roots = empty_strs()\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SLet(exp, _, name, _, _) => if exp || String::contains(name, \"::\") {\n        Array::push(roots, name)\n      },\n      SFnDecl(exp, name, _, _, _) => if exp || String::contains(name, \"::\") {\n        Array::push(roots, name)\n      },\n      SLetMut(name, _, _) => if String::contains(name, \"::\") {\n        Array::push(roots, name)\n      },\n      SExport(names) => {\n        let mut j = 0\n        while j < Array::length(names) {\n          Array::push(roots, Array::get(names, j))\n          j = j + 1\n        }\n        0\n      },\n      _ => 0\n    }\n    i = i + 1\n  }\n  roots\n}\n\nfn aggregate_export_names(stmts: Array[Stmt]) -> Array[String] {\n  let names = empty_strs()\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SExport(exported) => {\n        let mut j = 0\n        while j < Array::length(exported) {\n          Array::push(names, Array::get(exported, j))\n          j = j + 1\n        }\n        0\n      },\n      _ => 0\n    }\n    i = i + 1\n  }\n  names\n}\n\nfn str_array_has(arr: Array[String], target: String) -> Bool {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(arr) && !found {\n    if Array::get(arr, i) == target {\n      found = true\n    } else {\n      i = i + 1\n    }\n  }\n  found\n}\n\nfn promote_aggregate_exports(stmts: Array[Stmt], agg: Array[String]) -> Array[Stmt] {\n  let result = empty_stmts()\n  let mut i = 0\n  while i < Array::length(stmts) {\n    let stmt = Array::get(stmts, i)\n    let promoted = match stmt {\n      SLet(exp, is_rec, name, ty, body) => if !exp && str_array_has(agg, name) {\n        SLet(true, is_rec, name, ty, body)\n      } else {\n        stmt\n      },\n      SFnDecl(exp, name, fn_value, reqs, enss) => if !exp && str_array_has(agg, name) {\n        SFnDecl(true, name, fn_value, reqs, enss)\n      } else {\n        stmt\n      },\n      _ => stmt\n    }\n    Array::push(result, promoted)\n    i = i + 1\n  }\n  result\n}\n\n\nfn collect_type_names_into(ty: TypeExpr, out: Array[String]) -> Int {\n  match ty {\n    TyName(n) => {\n      Array::push(out, n)\n      0\n    },\n    TyApp(n, args) => {\n      Array::push(out, n)\n      let mut i = 0\n      while i < Array::length(args) {\n        let _ = collect_type_names_into(Array::get(args, i), out)\n        i = i + 1\n      }\n      0\n    },\n    TyFn(params, ret, _) => {\n      let mut i = 0\n      while i < Array::length(params) {\n        let _ = collect_type_names_into(Array::get(params, i), out)\n        i = i + 1\n      }\n      let _ = collect_type_names_into(ret, out)\n      0\n    },\n    TyTuple(items) => {\n      let mut i = 0\n      while i < Array::length(items) {\n        let _ = collect_type_names_into(Array::get(items, i), out)\n        i = i + 1\n      }\n      0\n    },\n    TyUnit => 0\n  }\n}\n\nfn collect_opt_type_into(ty_opt: Option[TypeExpr], out: Array[String]) -> Int {\n  match ty_opt {\n    Some(ty) => collect_type_names_into(ty, out),\n    None => 0\n  }\n}\n\nfn collect_stmt_type_refs_into(stmt: Stmt, out: Array[String]) -> Int {\n  match stmt {\n    SLet(_, _, _, ty, _) => collect_opt_type_into(ty, out),\n    SFnDecl(_, _, fn_value, _, _) => match fn_value {\n      EFn(_, _, params, ret_opt, _, _) => {\n        let mut fpi = 0\n        while fpi < Array::length(params) {\n          let (_, pty) = Array::get(params, fpi)\n          let _ = collect_opt_type_into(pty, out)\n          fpi = fpi + 1\n        }\n        collect_opt_type_into(ret_opt, out)\n      },\n      _ => 0\n    },\n    SLetMut(_, ty, _) => collect_opt_type_into(ty, out),\n    SExternLet(_, ty) => collect_type_names_into(ty, out),\n    STypeAlias(_, _, _, rhs) => collect_type_names_into(rhs, out),\n    SStruct(_, _, fields, _, _, _) => {\n      let mut i = 0\n      while i < Array::length(fields) {\n        let (_, fty) = Array::get(fields, i)\n        let _ = collect_type_names_into(fty, out)\n        i = i + 1\n      }\n      0\n    },\n    SEnum(_, _, _, ctors, _) => {\n      let mut i = 0\n      while i < Array::length(ctors) {\n        let (_, args) = Array::get(ctors, i)\n        let mut j = 0\n        while j < Array::length(args) {\n          let _ = collect_type_names_into(Array::get(args, j), out)\n          j = j + 1\n        }\n        i = i + 1\n      }\n      0\n    },\n    SImpl(_, _, _, type_name) => {\n      Array::push(out, type_name)\n      0\n    },\n    _ => 0\n  }\n}\n\nfn drop_unused_type_aliases(stmts: Array[Stmt]) -> Array[Stmt] {\n  let referenced = empty_strs()\n  let mut i = 0\n  while i < Array::length(stmts) {\n    let _ = collect_stmt_type_refs_into(Array::get(stmts, i), referenced)\n    i = i + 1\n  }\n  let result = empty_stmts()\n  let mut k = 0\n  while k < Array::length(stmts) {\n    let stmt = Array::get(stmts, k)\n    let keep = match stmt {\n      STypeAlias(exp, name, _, _) => exp || str_array_has(referenced, name),\n      _ => true\n    }\n    if keep {\n      Array::push(result, stmt)\n    }\n    k = k + 1\n  }\n  result\n}\n\n\nfn stmt_section(stmt: Stmt) -> Int {\n  match stmt {\n    SImport(_, _) => 0,\n    SReExport(_, _) => 0,\n    SAliasDecl(_, _) => 0,\n    SEnum(_, _, _, _, _) => 1,\n    SSuberror(_, _, _) => 1,\n    SStruct(_, _, _, _, _, _) => 1,\n    STypeAlias(_, _, _, _) => 1,\n    STrait(_, _, _, _, _, _) => 1,\n    SImpl(_, _, _, _) => 1,\n    SEffectDef(_, _, _, _) => 1,\n    SExternLet(_, _) => 1,\n    SLet(_, _, _, _, _) => 2,\n    SFnDecl(_, _, _, _, _) => 2,\n    SLetMut(_, _, _) => 2,\n    SLetPat(_, _) => 2,\n    STest(_, _) => 3,\n    SBench(_, _) => 3,\n    SExport(_) => 9,\n    SExpr(_) => 9,\n    _ => 9\n  }\n}\n\nfn section_header(section: Int) -> String {\n  if section == 0 {\n    \"//# Imports\"\n  } else if section == 1 {\n    \"//# Types\"\n  } else if section == 2 {\n    \"//# Functions\"\n  } else {\n    \"//# Tests\"\n  }\n}\n\nfn render_section(stmts: Array[Stmt], section: Int) -> String {\n  let parts = empty_strs()\n  let mut i = 0\n  while i < Array::length(stmts) {\n    let stmt = Array::get(stmts, i)\n    if stmt_section(stmt) == section {\n      Array::push(parts, print_stmt(stmt))\n    }\n    i = i + 1\n  }\n  if Array::length(parts) == 0 {\n    \"\"\n  } else {\n    let body = String::join(parts, \"\\n\\n\")\n    String::concat(section_header(section), String::concat(\"\\n\\n\", body))\n  }\n}\n\n\nfn normalize_empty_type_exprs() -> Array[TypeExpr] {\n  array_empty()\n}\n\nfn all_params_typed(params: Array[(String, Option[TypeExpr])]) -> Bool {\n  let mut i = 0\n  let mut ok = true\n  while i < Array::length(params) {\n    let (_, ty_opt) = Array::get(params, i)\n    match ty_opt {\n      Some(_) => 0,\n      None => {\n        ok = false\n        0\n      }\n    }\n    i = i + 1\n  }\n  ok\n}\n\nfn param_type_list(params: Array[(String, Option[TypeExpr])]) -> Array[TypeExpr] {\n  let out = normalize_empty_type_exprs()\n  let mut i = 0\n  while i < Array::length(params) {\n    let (_, ty_opt) = Array::get(params, i)\n    match ty_opt {\n      Some(ty) => Array::push(out, ty),\n      None => 0\n    }\n    i = i + 1\n  }\n  out\n}\n\nfn strip_param_types(params: Array[(String, Option[TypeExpr])]) -> Array[(String, Option[TypeExpr])] {\n  let out = array_empty()\n  let mut i = 0\n  while i < Array::length(params) {\n    let (name, _) = Array::get(params, i)\n    Array::push(out, (name, None))\n    i = i + 1\n  }\n  out\n}\n\nfn hoist_lambda_let(stmt: Stmt) -> Stmt {\n  match stmt {\n    SLet(exp, is_rec, name, ty, value) => match ty {\n      Some(_) => stmt,\n      None => match value {\n        EFn(type_params, bounds, params, ret_opt, effect, body) => match ret_opt {\n          None => stmt,\n          Some(ret_ty) => if Array::length(type_params) == 0 && all_params_typed(params) {\n            SLet(exp, is_rec, name, Some(TyFn(param_type_list(params), ret_ty, effect)), EFn(type_params, bounds, strip_param_types(params), None, None, body))\n          } else {\n            stmt\n          }\n        },\n        _ => stmt\n      }\n    },\n    _ => stmt\n  }\n}\n\nfn hoist_lambda_lets(stmts: Array[Stmt]) -> Array[Stmt] {\n  let out = empty_stmts()\n  let mut i = 0\n  while i < Array::length(stmts) {\n    Array::push(out, hoist_lambda_let(Array::get(stmts, i)))\n    i = i + 1\n  }\n  out\n}\n\n\nfn fold_int_binop(op: String, a: Int, b: Int) -> Option[Int] {\n  if op == \"+\" {\n    Some(a + b)\n  } else if op == \"-\" {\n    Some(a - b)\n  } else if op == \"*\" {\n    Some(a * b)\n  } else {\n    None\n  }\n}\n\nfn fold_expr(expr: Expr) -> Expr {\n  match expr {\n    EInt(_) => expr,\n    EFloat(_) => expr,\n    EString(_) => expr,\n    EBool(_) => expr,\n    EIdent(_, _) => expr,\n    EUnit => expr,\n    EStringInterp(_) => expr,\n    ETuple(items) => ETuple(for it in items {\n      fold_expr(it)\n    }),\n    EArray(items) => EArray(for it in items {\n      fold_expr(it)\n    }),\n    ERecord(rn, fields, targs) => ERecord(rn, for f in fields {\n      let (n, v) = f\n      (n, fold_expr(v))\n    }, targs),\n    EIf(c, t, e) => EIf(fold_expr(c), fold_expr(t), fold_expr(e)),\n    ELet(n, v, b, soff) => ELet(n, fold_expr(v), fold_expr(b), soff),\n    ELetRec(n, v, b) => ELetRec(n, fold_expr(v), fold_expr(b)),\n    ELetMut(n, v, b, soff) => ELetMut(n, fold_expr(v), fold_expr(b), soff),\n    EAssign(n, v, b) => EAssign(n, fold_expr(v), fold_expr(b)),\n    EAssignOp(op, n, v, b) => EAssignOp(op, n, fold_expr(v), fold_expr(b)),\n    ESeq(a, b) => ESeq(fold_expr(a), fold_expr(b)),\n    EMatch(s, arms) => EMatch(fold_expr(s), for a in arms {\n      let (p, e) = a\n      (p, fold_expr(e))\n    }),\n    EHandle(s, arms) => EHandle(fold_expr(s), for a in arms {\n      let (p, e) = a\n      (p, fold_expr(e))\n    }),\n    EWhile(c, b) => EWhile(fold_expr(c), fold_expr(b)),\n    ELoop(params, b) => ELoop(for pr in params {\n      let (n, init) = pr\n      (n, fold_expr(init))\n    }, fold_expr(b)),\n    EForIn(n, idx, it, b) => EForIn(n, idx, fold_expr(it), fold_expr(b)),\n    ECall(callee, args, off) => ECall(fold_expr(callee), for a in args {\n      fold_expr(a)\n    }, off),\n    EBinOp(op, l, r) => {\n      let fl = fold_expr(l)\n      let fr = fold_expr(r)\n      match fl {\n        EInt(a) => match fr {\n          EInt(b) => match fold_int_binop(op, a, b) {\n            Some(v) => EInt(v),\n            None => EBinOp(op, fl, fr)\n          },\n          _ => EBinOp(op, fl, fr)\n        },\n        _ => EBinOp(op, fl, fr)\n      }\n    },\n    EUnaryOp(op, e) => EUnaryOp(op, fold_expr(e)),\n    EFn(tp, bounds, params, ret, eff, body) => EFn(tp, bounds, params, ret, eff, fold_expr(body)),\n    EDot(e, field, off, fdoff) => EDot(fold_expr(e), field, off, fdoff),\n    ELabeledArg(label, modifier, v) => ELabeledArg(label, modifier, fold_expr(v)),\n    EReturn(e) => EReturn(fold_expr(e)),\n    EBreak(opt) => match opt {\n      Some(v) => EBreak(Some(fold_expr(v))),\n      None => EBreak(None)\n    },\n    EContinue(args) => EContinue(for a in args {\n      fold_expr(a)\n    }),\n    EMap(fields) => EMap(for f in fields {\n      let (k, v) = f\n      (k, fold_expr(v))\n    }),\n    ESpread(e) => ESpread(fold_expr(e))\n  }\n}\n\nfn fresh_shadow_name(counter: Array[Int], name: String) -> String {\n  let n = Array::get(counter, 0)\n  Array::set(counter, 0, n + 1)\n  String::concat(String::concat(\"__shadow_\", __to_string(n)), String::concat(\"_\", name))\n}\n\nfn uq_lookup(env: Map[String, String], name: String) -> String {\n  if Map::has_key(env, name) {\n    Map::get(env, name)\n  } else {\n    name\n  }\n}\n\nfn uq_seen_contains(seen: Array[String], name: String) -> Bool {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(seen) {\n    if Array::get(seen, i) == name {\n      found = true\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  found\n}\n\nfn uq_bind_name(name: String, env: Map[String, String], counter: Array[Int], seen: Array[String]) -> (String, Map[String, String]) {\n  let nlen = String::length(name)\n  let lastc = if nlen > 0 {\n    String::char_code_at(name, nlen - 1)\n  } else {\n    0\n  }\n  if lastc == '~' || lastc == '?' {\n    (name, env)\n  } else if Map::has_key(env, name) || uq_seen_contains(seen, name) {\n    let fresh = fresh_shadow_name(counter, name)\n    (fresh, Map::set(env, name, fresh))\n  } else {\n    Array::push(seen, name)\n    (name, Map::set(env, name, name))\n  }\n}\n\nfn uq_pat_names(pat: Pat, out: Array[String]) -> Unit {\n  match pat {\n    PBind(name) => Array::push(out, name),\n    PCtor(_, args) => {\n      let mut i = 0\n      while i < Array::length(args) {\n        uq_pat_names(Array::get(args, i), out)\n        i = i + 1\n      }\n    },\n    PTuple(pats) => {\n      let mut i = 0\n      while i < Array::length(pats) {\n        uq_pat_names(Array::get(pats, i), out)\n        i = i + 1\n      }\n    },\n    POr(l, _r) => uq_pat_names(l, out),\n    PStruct(_, fields) => {\n      let mut i = 0\n      while i < Array::length(fields) {\n        let (_, fp) = Array::get(fields, i)\n        uq_pat_names(fp, out)\n        i = i + 1\n      }\n    },\n    PInt(_) => (),\n    PFloat(_) => (),\n    PString(_) => (),\n    PBool(_) => (),\n    PWild => ()\n  }\n}\n\nfn uq_pat_rewrite(pat: Pat, env: Map[String, String]) -> Pat {\n  match pat {\n    PBind(name) => PBind(uq_lookup(env, name)),\n    PCtor(name, args) => PCtor(name, for a in args {\n      uq_pat_rewrite(a, env)\n    }),\n    PTuple(pats) => PTuple(for a in pats {\n      uq_pat_rewrite(a, env)\n    }),\n    POr(l, r) => POr(uq_pat_rewrite(l, env), uq_pat_rewrite(r, env)),\n    PStruct(name, fields) => PStruct(name, for f in fields {\n      let (fname, fp) = f\n      (fname, uq_pat_rewrite(fp, env))\n    }),\n    _ => pat\n  }\n}\n\nfn uq_bind_pat(pat: Pat, env: Map[String, String], counter: Array[Int], seen: Array[String]) -> (Pat, Map[String, String]) {\n  let names: Array[String] = [\n  ]\n  uq_pat_names(pat, names)\n  let mut env2 = env\n  let mut i = 0\n  while i < Array::length(names) {\n    let (_, env3) = uq_bind_name(Array::get(names, i), env2, counter, seen)\n    env2 = env3\n    i = i + 1\n  }\n  (uq_pat_rewrite(pat, env2), env2)\n}\n\nexport fn uniquify_shadowed_bindings(expr: Expr, env: Map[String, String], counter: Array[Int], seen: Array[String]) -> Expr {\n  match expr {\n    EInt(_) => expr,\n    EFloat(_) => expr,\n    EString(_) => expr,\n    EBool(_) => expr,\n    EIdent(name, off) => EIdent(uq_lookup(env, name), off),\n    EUnit => expr,\n    EStringInterp(_) => expr,\n    ETuple(items) => ETuple(for it in items {\n      uniquify_shadowed_bindings(it, env, counter, seen)\n    }),\n    EArray(items) => EArray(for it in items {\n      uniquify_shadowed_bindings(it, env, counter, seen)\n    }),\n    ERecord(rn, fields, targs) => ERecord(rn, for f in fields {\n      let (n, v) = f\n      (n, uniquify_shadowed_bindings(v, env, counter, seen))\n    }, targs),\n    EIf(c, t, e) => EIf(uniquify_shadowed_bindings(c, env, counter, seen), uniquify_shadowed_bindings(t, env, counter, seen), uniquify_shadowed_bindings(e, env, counter, seen)),\n    ELet(n, v, b, soff) => {\n      let v2 = uniquify_shadowed_bindings(v, env, counter, seen)\n      let (n2, env2) = uq_bind_name(n, env, counter, seen)\n      ELet(n2, v2, uniquify_shadowed_bindings(b, env2, counter, seen), soff)\n    },\n    ELetRec(n, v, b) => {\n      let (n2, env2) = uq_bind_name(n, env, counter, seen)\n      let v2 = uniquify_shadowed_bindings(v, env2, counter, seen)\n      ELetRec(n2, v2, uniquify_shadowed_bindings(b, env2, counter, seen))\n    },\n    ELetMut(n, v, b, soff) => {\n      let v2 = uniquify_shadowed_bindings(v, env, counter, seen)\n      let (n2, env2) = uq_bind_name(n, env, counter, seen)\n      ELetMut(n2, v2, uniquify_shadowed_bindings(b, env2, counter, seen), soff)\n    },\n    EAssign(n, v, b) => EAssign(uq_lookup(env, n), uniquify_shadowed_bindings(v, env, counter, seen), uniquify_shadowed_bindings(b, env, counter, seen)),\n    EAssignOp(n, op, v, b) => EAssignOp(uq_lookup(env, n), op, uniquify_shadowed_bindings(v, env, counter, seen), uniquify_shadowed_bindings(b, env, counter, seen)),\n    ESeq(a, b) => ESeq(uniquify_shadowed_bindings(a, env, counter, seen), uniquify_shadowed_bindings(b, env, counter, seen)),\n    EMatch(s, arms) => EMatch(uniquify_shadowed_bindings(s, env, counter, seen), for a in arms {\n      let (p, e) = a\n      let (p2, env2) = uq_bind_pat(p, env, counter, seen)\n      (p2, uniquify_shadowed_bindings(e, env2, counter, seen))\n    }),\n    EHandle(s, arms) => EHandle(uniquify_shadowed_bindings(s, env, counter, seen), for a in arms {\n      let (p, e) = a\n      let (p2, env2) = uq_bind_pat(p, env, counter, seen)\n      (p2, uniquify_shadowed_bindings(e, env2, counter, seen))\n    }),\n    EWhile(c, b) => EWhile(uniquify_shadowed_bindings(c, env, counter, seen), uniquify_shadowed_bindings(b, env, counter, seen)),\n    ELoop(params, b) => {\n      let mut env2 = env\n      let zipped: Array[(String, Expr)] = [\n      ]\n      let mut pi = 0\n      while pi < Array::length(params) {\n        let (pn, init) = Array::get(params, pi)\n        let init2 = uniquify_shadowed_bindings(init, env, counter, seen)\n        let (pn2, envN) = uq_bind_name(pn, env2, counter, seen)\n        env2 = envN\n        Array::push(zipped, (pn2, init2))\n        pi = pi + 1\n      }\n      ELoop(zipped, uniquify_shadowed_bindings(b, env2, counter, seen))\n    },\n    EForIn(n, idx, it, b) => {\n      let it2 = uniquify_shadowed_bindings(it, env, counter, seen)\n      let (n2, env2) = uq_bind_name(n, env, counter, seen)\n      let (idx2, env3) = match idx {\n        Some(iname) => {\n          let (iname2, envI) = uq_bind_name(iname, env2, counter, seen)\n          (Some(iname2), envI)\n        },\n        None => (None, env2)\n      }\n      EForIn(n2, idx2, it2, uniquify_shadowed_bindings(b, env3, counter, seen))\n    },\n    ECall(callee, args, off) => ECall(uniquify_shadowed_bindings(callee, env, counter, seen), for a in args {\n      uniquify_shadowed_bindings(a, env, counter, seen)\n    }, off),\n    EBinOp(op, l, r) => EBinOp(op, uniquify_shadowed_bindings(l, env, counter, seen), uniquify_shadowed_bindings(r, env, counter, seen)),\n    EUnaryOp(op, e) => EUnaryOp(op, uniquify_shadowed_bindings(e, env, counter, seen)),\n    EFn(tp, bounds, params, ret, eff, body) => {\n      let mut env2 = env\n      let params2: Array[(String, Option[TypeExpr])] = [\n      ]\n      let mut fi = 0\n      while fi < Array::length(params) {\n        let (pn, pty) = Array::get(params, fi)\n        let (pn2, envN) = uq_bind_name(pn, env2, counter, seen)\n        env2 = envN\n        Array::push(params2, (pn2, pty))\n        fi = fi + 1\n      }\n      EFn(tp, bounds, params2, ret, eff, uniquify_shadowed_bindings(body, env2, counter, seen))\n    },\n    EDot(e, field, off, fdoff) => EDot(uniquify_shadowed_bindings(e, env, counter, seen), field, off, fdoff),\n    ELabeledArg(label, modifier, v) => ELabeledArg(label, modifier, uniquify_shadowed_bindings(v, env, counter, seen)),\n    EReturn(e) => EReturn(uniquify_shadowed_bindings(e, env, counter, seen)),\n    EBreak(opt) => match opt {\n      Some(v) => EBreak(Some(uniquify_shadowed_bindings(v, env, counter, seen))),\n      None => EBreak(None)\n    },\n    EContinue(args) => EContinue(for a in args {\n      uniquify_shadowed_bindings(a, env, counter, seen)\n    }),\n    EMap(fields) => EMap(for f in fields {\n      let (k, v) = f\n      (k, uniquify_shadowed_bindings(v, env, counter, seen))\n    }),\n    ESpread(e) => ESpread(uniquify_shadowed_bindings(e, env, counter, seen))\n  }\n}\n\nfn fresh_m_scrut_name(counter: Array[Int]) -> String {\n  let n = Array::get(counter, 0)\n  Array::set(counter, 0, n + 1)\n  String::concat(\"__m_scrut_\", __to_string(n))\n}\n\nexport fn lift_match_scrutinees(expr: Expr, counter: Array[Int]) -> Expr {\n  match expr {\n    EInt(_) => expr,\n    EFloat(_) => expr,\n    EString(_) => expr,\n    EBool(_) => expr,\n    EIdent(_, _) => expr,\n    EUnit => expr,\n    EStringInterp(_) => expr,\n    ETuple(items) => ETuple(for it in items {\n      lift_match_scrutinees(it, counter)\n    }),\n    EArray(items) => EArray(for it in items {\n      lift_match_scrutinees(it, counter)\n    }),\n    ERecord(rn, fields, targs) => ERecord(rn, for f in fields {\n      let (n, v) = f\n      (n, lift_match_scrutinees(v, counter))\n    }, targs),\n    EIf(c, t, e) => EIf(lift_match_scrutinees(c, counter), lift_match_scrutinees(t, counter), lift_match_scrutinees(e, counter)),\n    ELet(n, v, b, soff) => ELet(n, lift_match_scrutinees(v, counter), lift_match_scrutinees(b, counter), soff),\n    ELetRec(n, v, b) => ELetRec(n, lift_match_scrutinees(v, counter), lift_match_scrutinees(b, counter)),\n    ELetMut(n, v, b, soff) => ELetMut(n, lift_match_scrutinees(v, counter), lift_match_scrutinees(b, counter), soff),\n    EAssign(n, v, b) => EAssign(n, lift_match_scrutinees(v, counter), lift_match_scrutinees(b, counter)),\n    EAssignOp(op, n, v, b) => EAssignOp(op, n, lift_match_scrutinees(v, counter), lift_match_scrutinees(b, counter)),\n    ESeq(a, b) => ESeq(lift_match_scrutinees(a, counter), lift_match_scrutinees(b, counter)),\n    EMatch(s, arms) => {\n      let lifted_arms = for a in arms {\n        let (p, e) = a\n        (p, lift_match_scrutinees(e, counter))\n      }\n      let ls = lift_match_scrutinees(s, counter)\n      match ls {\n        EIdent(_, _) => EMatch(ls, lifted_arms),\n        _ => {\n          let fresh = fresh_m_scrut_name(counter)\n          ELet(fresh, ls, EMatch(EIdent(fresh, -1), lifted_arms), -1)\n        }\n      }\n    },\n    EHandle(s, arms) => EHandle(lift_match_scrutinees(s, counter), for a in arms {\n      let (p, e) = a\n      (p, lift_match_scrutinees(e, counter))\n    }),\n    EWhile(c, b) => EWhile(lift_match_scrutinees(c, counter), lift_match_scrutinees(b, counter)),\n    ELoop(params, b) => ELoop(for pr in params {\n      let (n, init) = pr\n      (n, lift_match_scrutinees(init, counter))\n    }, lift_match_scrutinees(b, counter)),\n    EForIn(n, idx, it, b) => EForIn(n, idx, lift_match_scrutinees(it, counter), lift_match_scrutinees(b, counter)),\n    ECall(callee, args, off) => ECall(lift_match_scrutinees(callee, counter), for a in args {\n      lift_match_scrutinees(a, counter)\n    }, off),\n    EBinOp(op, l, r) => EBinOp(op, lift_match_scrutinees(l, counter), lift_match_scrutinees(r, counter)),\n    EUnaryOp(op, e) => EUnaryOp(op, lift_match_scrutinees(e, counter)),\n    EFn(tp, bounds, params, ret, eff, body) => EFn(tp, bounds, params, ret, eff, lift_match_scrutinees(body, counter)),\n    EDot(e, field, off, fdoff) => EDot(lift_match_scrutinees(e, counter), field, off, fdoff),\n    ELabeledArg(label, modifier, v) => ELabeledArg(label, modifier, lift_match_scrutinees(v, counter)),\n    EReturn(e) => EReturn(lift_match_scrutinees(e, counter)),\n    EBreak(opt) => match opt {\n      Some(v) => EBreak(Some(lift_match_scrutinees(v, counter))),\n      None => EBreak(None)\n    },\n    EContinue(args) => EContinue(for a in args {\n      lift_match_scrutinees(a, counter)\n    }),\n    EMap(fields) => EMap(for f in fields {\n      let (k, v) = f\n      (k, lift_match_scrutinees(v, counter))\n    }),\n    ESpread(e) => ESpread(lift_match_scrutinees(e, counter))\n  }\n}\n\nfn fold_stmt(stmt: Stmt) -> Stmt {\n  match stmt {\n    SLet(exp, is_rec, name, ty, body) => SLet(exp, is_rec, name, ty, fold_expr(body)),\n    SFnDecl(exp, name, fn_value, reqs, enss) => SFnDecl(exp, name, fold_expr(fn_value), reqs, enss),\n    SLetMut(name, ty, body) => SLetMut(name, ty, fold_expr(body)),\n    STest(n, body) => STest(n, fold_expr(body)),\n    SBench(n, body) => SBench(n, fold_expr(body)),\n    SExpr(e) => SExpr(fold_expr(e)),\n    SLetPat(p, body) => SLetPat(p, fold_expr(body)),\n    _ => stmt\n  }\n}\n\nfn fold_stmts(stmts: Array[Stmt]) -> Array[Stmt] {\n  let out = empty_stmts()\n  let mut i = 0\n  while i < Array::length(stmts) {\n    Array::push(out, fold_stmt(Array::get(stmts, i)))\n    i = i + 1\n  }\n  out\n}\n\n\nfn literal_type(e: Expr) -> Option[TypeExpr] {\n  match e {\n    EInt(_) => Some(TyName(\"Int\")),\n    EBool(_) => Some(TyName(\"Bool\")),\n    EString(_) => Some(TyName(\"String\")),\n    EFloat(_) => Some(TyName(\"Double\")),\n    _ => None\n  }\n}\n\nfn annotate_literal_let(stmt: Stmt) -> Stmt {\n  match stmt {\n    SLet(exp, is_rec, name, ty, body) => match ty {\n      Some(_) => stmt,\n      None => match literal_type(body) {\n        Some(t) => SLet(exp, is_rec, name, Some(t), body),\n        None => stmt\n      }\n    },\n    _ => stmt\n  }\n}\n\nfn annotate_literal_lets(stmts: Array[Stmt]) -> Array[Stmt] {\n  let out = empty_stmts()\n  let mut i = 0\n  while i < Array::length(stmts) {\n    Array::push(out, annotate_literal_let(Array::get(stmts, i)))\n    i = i + 1\n  }\n  out\n}\n\n\nfn ndc_struct_field_sets(stmts: Array[Stmt]) -> Array[(String, Array[String])] {\n  let out = array_empty()\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SStruct(_, sname, fields, _, _, _) => {\n        let names = empty_strs()\n        let mut j = 0\n        while j < Array::length(fields) {\n          let (fname, _) = Array::get(fields, j)\n          Array::push(names, fname)\n          j = j + 1\n        }\n        Array::push(out, (sname, names))\n      },\n      SEnum(_, ename, _, _, _) => Array::push(out, (ename, empty_strs())),\n      _ => ()\n    }\n    i = i + 1\n  }\n  out\n}\n\nfn ndc_struct_set_member(struct_sets: Array[(String, Array[String])], name: String, member: String) -> Bool {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(struct_sets) {\n    let (sname, members) = Array::get(struct_sets, i)\n    if sname == name {\n      found = str_array_has(members, member)\n      i = Array::length(struct_sets)\n    } else {\n      i = i + 1\n    }\n  }\n  found\n}\n\nfn ndc_ret_name(ret: Option[TypeExpr]) -> String {\n  match ret {\n    Some(te) => match te {\n      TyName(n) => n,\n      TyApp(n, _) => n,\n      _ => \"\"\n    },\n    None => \"\"\n  }\n}\n\nfn ndc_fn_returns(stmts: Array[Stmt]) -> Array[(String, String)] {\n  let out = array_empty()\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SLet(_, _, fname, _, body) => match body {\n        EFn(_, _, _, ret, _, _) => Array::push(out, (fname, ndc_ret_name(ret))),\n        _ => ()\n      },\n      SFnDecl(_, fname, body, _, _) => match body {\n        EFn(_, _, _, ret, _, _) => Array::push(out, (fname, ndc_ret_name(ret))),\n        _ => ()\n      },\n      SEnum(_, ename, _, variants, _) => {\n        let mut vi = 0\n        while vi < Array::length(variants) {\n          let (vname, _) = Array::get(variants, vi)\n          Array::push(out, (vname, ename))\n          vi = vi + 1\n        }\n      },\n      _ => ()\n    }\n    i = i + 1\n  }\n  out\n}\n\nfn ndc_fn_exists(fn_returns: Array[(String, String)], fname: String) -> Bool {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(fn_returns) {\n    let (n, _) = Array::get(fn_returns, i)\n    if n == fname {\n      found = true\n      i = Array::length(fn_returns)\n    } else {\n      i = i + 1\n    }\n  }\n  found\n}\n\nfn ndc_fn_return_type(fn_returns: Array[(String, String)], fname: String) -> Option[String] {\n  let mut i = 0\n  let mut result = None\n  while i < Array::length(fn_returns) {\n    let (n, rt) = Array::get(fn_returns, i)\n    if n == fname {\n      result = if String::length(rt) == 0 {\n        None\n      } else {\n        Some(rt)\n      }\n      i = Array::length(fn_returns)\n    } else {\n      i = i + 1\n    }\n  }\n  result\n}\n\nfn ndc_lookup_var_type(var_types: Array[(String, String)], name: String) -> Option[String] {\n  let mut i = 0\n  let mut result = None\n  while i < Array::length(var_types) {\n    let (vn, vt) = Array::get(var_types, i)\n    if vn == name {\n      result = Some(vt)\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  result\n}\n\nfn ndc_extend_var_types(var_types: Array[(String, String)], name: String, inferred: Option[String]) -> Array[(String, String)] {\n  match inferred {\n    Some(tname) => {\n      let out = array_empty()\n      let mut i = 0\n      while i < Array::length(var_types) {\n        Array::push(out, Array::get(var_types, i))\n        i = i + 1\n      }\n      Array::push(out, (name, tname))\n      out\n    },\n    None => var_types\n  }\n}\n\nfn ndc_seed_var_types(params: Array[(String, Option[TypeExpr])], base: Array[(String, String)]) -> Array[(String, String)] {\n  let out = array_empty()\n  let mut b = 0\n  while b < Array::length(base) {\n    Array::push(out, Array::get(base, b))\n    b = b + 1\n  }\n  let mut i = 0\n  while i < Array::length(params) {\n    let (pname, ann) = Array::get(params, i)\n    match ann {\n      Some(TyName(tn)) => Array::push(out, (pname, tn)),\n      Some(TyApp(tn, _)) => Array::push(out, (pname, tn)),\n      _ => ()\n    }\n    i = i + 1\n  }\n  out\n}\n\nfn ndc_field_sets_match(a: Array[String], b: Array[String]) -> Bool {\n  if Array::length(a) != Array::length(b) {\n    false\n  } else {\n    let mut i = 0\n    let mut ok = true\n    while i < Array::length(a) {\n      if str_array_has(b, Array::get(a, i)) {\n        i = i + 1\n      } else {\n        ok = false\n        i = Array::length(a)\n      }\n    }\n    ok\n  }\n}\n\nfn ndc_infer_type_name(e: Expr, struct_sets: Array[(String, Array[String])], var_types: Array[(String, String)], fn_returns: Array[(String, String)]) -> Option[String] {\n  match e {\n    EInt(_) => Some(\"Int\"),\n    EBool(_) => Some(\"Bool\"),\n    EString(_) => Some(\"String\"),\n    EFloat(_) => Some(\"Double\"),\n    EArray(_) => Some(\"Array\"),\n    EMap(_) => Some(\"Map\"),\n    EIdent(name, _) => if name == \"None\" {\n      Some(\"Option\")\n    } else {\n      match ndc_lookup_var_type(var_types, name) {\n        Some(t) => Some(t),\n        None => ndc_fn_return_type(fn_returns, name)\n      }\n    },\n    ECall(callee, _, _) => match callee {\n      EIdent(\"Some\", _) => Some(\"Option\"),\n      EIdent(\"Ok\", _) => Some(\"Result\"),\n      EIdent(\"Err\", _) => Some(\"Result\"),\n      EIdent(fname, _) => ndc_fn_return_type(fn_returns, fname),\n      EFn(_, _, params, _, _, _) => if Array::length(params) == 1 {\n        let (_, ann) = Array::get(params, 0)\n        match ann {\n          Some(TyName(n)) => Some(n),\n          Some(TyApp(n, _)) => Some(n),\n          _ => None\n        }\n      } else {\n        None\n      },\n      _ => None\n    },\n    ERecord(_, fields, _) => {\n      let names = empty_strs()\n      let mut i = 0\n      while i < Array::length(fields) {\n        let (fname, _) = Array::get(fields, i)\n        Array::push(names, fname)\n        i = i + 1\n      }\n      let mut j = 0\n      let mut result = None\n      while j < Array::length(struct_sets) {\n        let (sname, sfields) = Array::get(struct_sets, j)\n        if ndc_field_sets_match(names, sfields) {\n          result = Some(sname)\n          j = Array::length(struct_sets)\n        } else {\n          j = j + 1\n        }\n      }\n      result\n    },\n    _ => None\n  }\n}\n\nfn ndc_prepend(head: Expr, rest: Array[Expr]) -> Array[Expr] {\n  let out = array_empty()\n  Array::push(out, head)\n  let mut i = 0\n  while i < Array::length(rest) {\n    Array::push(out, Array::get(rest, i))\n    i = i + 1\n  }\n  out\n}\n\nfn ndc_qualified_call(robj: Expr, method: String, struct_sets: Array[(String, Array[String])], var_types: Array[(String, String)], fn_returns: Array[(String, String)]) -> Option[String] {\n  match ndc_infer_type_name(robj, struct_sets, var_types, fn_returns) {\n    Some(tn) => {\n      let qual = String::concat(tn, String::concat(\"::\", method))\n      let is_field = ndc_struct_set_member(struct_sets, tn, method)\n      if !is_field && ndc_fn_exists(fn_returns, qual) {\n        Some(qual)\n      } else {\n        None\n      }\n    },\n    None => None\n  }\n}\n\nfn normalize_dot_calls_expr(expr: Expr, struct_sets: Array[(String, Array[String])], var_types: Array[(String, String)], fn_returns: Array[(String, String)]) -> Expr {\n  match expr {\n    EInt(_) => expr,\n    EFloat(_) => expr,\n    EString(_) => expr,\n    EBool(_) => expr,\n    EIdent(_, _) => expr,\n    EUnit => expr,\n    EStringInterp(_) => expr,\n    ETuple(items) => ETuple(for it in items {\n      normalize_dot_calls_expr(it, struct_sets, var_types, fn_returns)\n    }),\n    EArray(items) => EArray(for it in items {\n      normalize_dot_calls_expr(it, struct_sets, var_types, fn_returns)\n    }),\n    ERecord(rn, fields, targs) => ERecord(rn, for f in fields {\n      let (n, v) = f\n      (n, normalize_dot_calls_expr(v, struct_sets, var_types, fn_returns))\n    }, targs),\n    EIf(c, t, el) => EIf(normalize_dot_calls_expr(c, struct_sets, var_types, fn_returns), normalize_dot_calls_expr(t, struct_sets, var_types, fn_returns), normalize_dot_calls_expr(el, struct_sets, var_types, fn_returns)),\n    ELet(n, v, b, soff) => {\n      let v2 = normalize_dot_calls_expr(v, struct_sets, var_types, fn_returns)\n      let inferred = ndc_infer_type_name(v2, struct_sets, var_types, fn_returns)\n      let var_types2 = ndc_extend_var_types(var_types, n, inferred)\n      ELet(n, v2, normalize_dot_calls_expr(b, struct_sets, var_types2, fn_returns), soff)\n    },\n    ELetRec(n, v, b) => {\n      let v2 = normalize_dot_calls_expr(v, struct_sets, var_types, fn_returns)\n      let inferred = ndc_infer_type_name(v2, struct_sets, var_types, fn_returns)\n      let var_types2 = ndc_extend_var_types(var_types, n, inferred)\n      ELetRec(n, v2, normalize_dot_calls_expr(b, struct_sets, var_types2, fn_returns))\n    },\n    ELetMut(n, v, b, soff) => ELetMut(n, normalize_dot_calls_expr(v, struct_sets, var_types, fn_returns), normalize_dot_calls_expr(b, struct_sets, var_types, fn_returns), soff),\n    EAssign(n, v, b) => EAssign(n, normalize_dot_calls_expr(v, struct_sets, var_types, fn_returns), normalize_dot_calls_expr(b, struct_sets, var_types, fn_returns)),\n    EAssignOp(n, op, v, b) => EAssignOp(n, op, normalize_dot_calls_expr(v, struct_sets, var_types, fn_returns), normalize_dot_calls_expr(b, struct_sets, var_types, fn_returns)),\n    ESeq(a, b) => ESeq(normalize_dot_calls_expr(a, struct_sets, var_types, fn_returns), normalize_dot_calls_expr(b, struct_sets, var_types, fn_returns)),\n    EMatch(s, arms) => EMatch(normalize_dot_calls_expr(s, struct_sets, var_types, fn_returns), for a in arms {\n      let (p, e2) = a\n      (p, normalize_dot_calls_expr(e2, struct_sets, var_types, fn_returns))\n    }),\n    EHandle(s, arms) => EHandle(normalize_dot_calls_expr(s, struct_sets, var_types, fn_returns), for a in arms {\n      let (p, e2) = a\n      (p, normalize_dot_calls_expr(e2, struct_sets, var_types, fn_returns))\n    }),\n    EWhile(c, b) => EWhile(normalize_dot_calls_expr(c, struct_sets, var_types, fn_returns), normalize_dot_calls_expr(b, struct_sets, var_types, fn_returns)),\n    ELoop(params, b) => ELoop(for p in params {\n      let (pn, init) = p\n      (pn, normalize_dot_calls_expr(init, struct_sets, var_types, fn_returns))\n    }, normalize_dot_calls_expr(b, struct_sets, var_types, fn_returns)),\n    EForIn(n, idx, it, b) => EForIn(n, idx, normalize_dot_calls_expr(it, struct_sets, var_types, fn_returns), normalize_dot_calls_expr(b, struct_sets, var_types, fn_returns)),\n    ECall(callee, args, off) => {\n      let rargs = for a in args {\n        normalize_dot_calls_expr(a, struct_sets, var_types, fn_returns)\n      }\n      match callee {\n        EDot(obj, m, doff, fdoff) => {\n          let robj = normalize_dot_calls_expr(obj, struct_sets, var_types, fn_returns)\n          match ndc_qualified_call(robj, m, struct_sets, var_types, fn_returns) {\n            Some(qual) => ECall(EIdent(qual, doff), ndc_prepend(robj, rargs), off),\n            None => ECall(EDot(robj, m, doff, fdoff), rargs, off)\n          }\n        },\n        _ => ECall(normalize_dot_calls_expr(callee, struct_sets, var_types, fn_returns), rargs, off)\n      }\n    },\n    EBinOp(op, l, r) => EBinOp(op, normalize_dot_calls_expr(l, struct_sets, var_types, fn_returns), normalize_dot_calls_expr(r, struct_sets, var_types, fn_returns)),\n    EUnaryOp(op, e2) => EUnaryOp(op, normalize_dot_calls_expr(e2, struct_sets, var_types, fn_returns)),\n    EFn(tp, bounds, params, ret, eff, body) => {\n      let var_types2 = ndc_seed_var_types(params, var_types)\n      EFn(tp, bounds, params, ret, eff, normalize_dot_calls_expr(body, struct_sets, var_types2, fn_returns))\n    },\n    EDot(e2, field, off, fdoff) => EDot(normalize_dot_calls_expr(e2, struct_sets, var_types, fn_returns), field, off, fdoff),\n    ELabeledArg(label, modifier, v) => ELabeledArg(label, modifier, normalize_dot_calls_expr(v, struct_sets, var_types, fn_returns)),\n    EReturn(e2) => EReturn(normalize_dot_calls_expr(e2, struct_sets, var_types, fn_returns)),\n    EBreak(opt) => match opt {\n      Some(v) => EBreak(Some(normalize_dot_calls_expr(v, struct_sets, var_types, fn_returns))),\n      None => EBreak(None)\n    },\n    EContinue(args) => EContinue(for a in args {\n      normalize_dot_calls_expr(a, struct_sets, var_types, fn_returns)\n    }),\n    EMap(fields) => EMap(for f in fields {\n      let (k, v) = f\n      (k, normalize_dot_calls_expr(v, struct_sets, var_types, fn_returns))\n    }),\n    ESpread(e2) => ESpread(normalize_dot_calls_expr(e2, struct_sets, var_types, fn_returns))\n  }\n}\n\nfn normalize_dot_calls_stmt(stmt: Stmt, struct_sets: Array[(String, Array[String])], fn_returns: Array[(String, String)]) -> Stmt {\n  match stmt {\n    SLet(exp, is_rec, name, ty, body) => SLet(exp, is_rec, name, ty, normalize_dot_calls_expr(body, struct_sets, array_empty(), fn_returns)),\n    SFnDecl(exp, name, fn_value, reqs, enss) => SFnDecl(exp, name, normalize_dot_calls_expr(fn_value, struct_sets, array_empty(), fn_returns), reqs, enss),\n    SLetMut(name, ty, body) => SLetMut(name, ty, normalize_dot_calls_expr(body, struct_sets, array_empty(), fn_returns)),\n    STest(n, body) => STest(n, normalize_dot_calls_expr(body, struct_sets, array_empty(), fn_returns)),\n    SBench(n, body) => SBench(n, normalize_dot_calls_expr(body, struct_sets, array_empty(), fn_returns)),\n    SExpr(e) => SExpr(normalize_dot_calls_expr(e, struct_sets, array_empty(), fn_returns)),\n    SLetPat(p, body) => SLetPat(p, normalize_dot_calls_expr(body, struct_sets, array_empty(), fn_returns)),\n    _ => stmt\n  }\n}\n\nexport fn normalize_dot_calls(stmts: Array[Stmt]) -> Array[Stmt] {\n  let struct_sets = ndc_struct_field_sets(stmts)\n  let fn_returns = ndc_fn_returns(stmts)\n  for s in stmts {\n    normalize_dot_calls_stmt(s, struct_sets, fn_returns)\n  }\n}\n\nexport fn normalize_stmts(stmts: Array[Stmt]) -> Array[Stmt] {\n  let nonmods = empty_stmts()\n  let mut i = 0\n  while i < Array::length(stmts) {\n    let stmt = Array::get(stmts, i)\n    if !is_module_stmt(stmt) {\n      Array::push(nonmods, stmt)\n    }\n    i = i + 1\n  }\n  let result = empty_stmts()\n  let live_top = dce_stmts(nonmods, exported_value_names(nonmods))\n  Array::push_all(result, live_top)\n  let mut m = 0\n  while m < Array::length(stmts) {\n    match Array::get(stmts, m) {\n      SModule(_, name, body) => {\n        let live_body = dce_stmts(body, exported_value_names(body))\n        let aliases = array_empty()\n        let _ = module_value_aliases(live_body, name, aliases)\n        let _ = flatten_module_body(live_body, name, make_import_alias_rewriter(aliases), result)\n        0\n      },\n      _ => 0\n    }\n    m = m + 1\n  }\n  let promoted = promote_aggregate_exports(result, aggregate_export_names(stmts))\n  hoist_lambda_lets(annotate_literal_lets(normalize_dot_calls(fold_stmts(drop_unused_type_aliases(promoted)))))\n}\n\nexport fn normalize_source(src: String) -> String with { Error } {\n  let (req_pins, src_wo_requires) = extract_require_pins(src)\n  let toks_cfg = lex(src_wo_requires)\n  let mut ci = 0\n  while ci < Array::length(toks_cfg) {\n    match Array::get(toks_cfg, ci) {\n      THash => throw(\"cannot normalize a source containing #cfg directives\"),\n      _ => ()\n    }\n    ci = ci + 1\n  }\n  let stmts = parse_program_preserving(toks_cfg)\n  let kept = normalize_stmts(stmts)\n  let sections = empty_strs()\n  if Array::length(req_pins) > 0 {\n    let req_lines = empty_strs()\n    let mut ri = 0\n    while ri < Array::length(req_pins) {\n      let (rname, rver, rpin) = Array::get(req_pins, ri)\n      if rpin == \"\" {\n        Array::push(req_lines, \"require \\{rname} \\{rver}\")\n      } else {\n        Array::push(req_lines, \"require \\{rname} \\{rver} = #\\{rpin}\")\n      }\n      ri = ri + 1\n    }\n    Array::push(sections, String::join(req_lines, \"\\n\"))\n  } else ()\n  let mut s = 0\n  while s <= 3 {\n    let rendered = render_section(kept, s)\n    if rendered != \"\" {\n      Array::push(sections, rendered)\n    }\n    s = s + 1\n  }\n  String::concat(String::join(sections, \"\\n\\n\"), \"\\n\")\n}\n")
}

let source_224 = () -> (String, String) {
  ("lib/@vibe/compiler/codegen/common_base/desugar_trait_dict.vibe",
"\nimport @vibe/compiler/core {\n  Expr, Pat, Stmt, TypeExpr, is_exception_throw_operation, sort_perm_by_names, str_lt\n}\n\nimport @vibe/core {\n  array_empty\n}\n\n\n\nfn empty_expr_array() -> Array[Expr] {\n  array_empty()\n}\n\nfn empty_str_array() -> Array[String] {\n  array_empty()\n}\n\nfn empty_ty_args() -> Array[TypeExpr] {\n  array_empty()\n}\n\nfn empty_type_exprs() -> Array[TypeExpr] {\n  array_empty()\n}\n\nfn method_names_of_sigs(methods: Array[(String, Array[TypeExpr], TypeExpr)]) -> Array[String] {\n  let out = empty_str_array()\n  let mut i = 0\n  while i < Array::length(methods) {\n    let (mname, _, _) = Array::get(methods, i)\n    Array::push(out, mname)\n    i = i + 1\n  }\n  out\n}\n\nfn str_array_contains(arr: Array[String], val: String) -> Bool {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(arr) {\n    if Array::get(arr, i) == val {\n      found = true\n      i = Array::length(arr)\n    } else {\n      i = i + 1\n    }\n  }\n  found\n}\n\nfn split_qualified(name: String) -> Option[(String, String)] {\n  let idx = String::index_of(name, \"::\")\n  if idx < 0 {\n    None\n  } else {\n    let head = String::substring(name, 0, idx)\n    let member = String::substring(name, idx + 2, String::length(name))\n    Some((head, member))\n  }\n}\n\nfn dict_struct_name(trait_name: String) -> String {\n  String::concat(trait_name, \"Dict\")\n}\n\nfn dict_param_name(trait_name: String, tparam: String) -> String {\n  String::concat(\"__dict_\", String::concat(trait_name, String::concat(\"_\", tparam)))\n}\n\nfn collect_method_traits(stmts: Array[Stmt]) -> Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])] {\n  let out = array_empty()\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      STrait(_, tname, _, methods, _, _) => if Array::length(methods) > 0 {\n        Array::push(out, (tname, methods))\n      } else {\n        ()\n      },\n      _ => ()\n    }\n    i = i + 1\n  }\n  out\n}\n\n\nfn empty_method_gens() -> Array[(String, Array[String], Array[(String, Array[String])])] {\n  array_empty()\n}\n\nfn collect_trait_method_gens(stmts: Array[Stmt]) -> Array[(String, Array[(String, Array[String], Array[(String, Array[String])])])] {\n  let out = array_empty()\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      STrait(_, tname, _, _, method_gens, _) => {\n        let mut any = false\n        let mut j = 0\n        while j < Array::length(method_gens) {\n          let (_, tps, _) = Array::get(method_gens, j)\n          if Array::length(tps) > 0 {\n            any = true\n          } else {\n            ()\n          }\n          j = j + 1\n        }\n        if any {\n          Array::push(out, (tname, method_gens))\n        } else {\n          ()\n        }\n      },\n      _ => ()\n    }\n    i = i + 1\n  }\n  out\n}\n\nfn lookup_method_gen(table: Array[(String, Array[(String, Array[String], Array[(String, Array[String])])])], trait_name: String, method: String) -> Option[(Array[String], Array[(String, Array[String])])] {\n  let mut i = 0\n  let mut result = None\n  while i < Array::length(table) {\n    let (tn, gens) = Array::get(table, i)\n    if tn == trait_name {\n      let mut j = 0\n      while j < Array::length(gens) {\n        let (mname, tps, bounds) = Array::get(gens, j)\n        if mname == method && Array::length(tps) > 0 {\n          result = Some((tps, bounds))\n          j = Array::length(gens)\n        } else {\n          j = j + 1\n        }\n      }\n      i = Array::length(table)\n    } else {\n      i = i + 1\n    }\n  }\n  result\n}\n\nfn collect_impl_trait_map(stmts: Array[Stmt]) -> Array[(String, String)] {\n  let out = array_empty()\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SImpl(_, _, trait_name, type_name) => Array::push(out, (type_name, trait_name)),\n      _ => ()\n    }\n    i = i + 1\n  }\n  out\n}\n\nfn lookup_trait_method_param_types(traits: Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], trait_name: String, method: String) -> Option[Array[TypeExpr]] {\n  match lookup_trait_sigs(traits, trait_name) {\n    Some(sigs) => {\n      let mut j = 0\n      let mut result = None\n      while j < Array::length(sigs) {\n        let (mname, ptypes, _) = Array::get(sigs, j)\n        if mname == method {\n          result = Some(ptypes)\n          j = Array::length(sigs)\n        } else {\n          j = j + 1\n        }\n      }\n      result\n    },\n    None => None\n  }\n}\n\nfn find_method_generic_for_impl(impl_map: Array[(String, String)], gen_table: Array[(String, Array[(String, Array[String], Array[(String, Array[String])])])], traits: Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], type_name: String, method: String) -> Option[(Array[String], Array[(String, Array[String])], Array[TypeExpr])] {\n  let mut i = 0\n  let mut result = None\n  while i < Array::length(impl_map) {\n    let (tn, trait_name) = Array::get(impl_map, i)\n    if tn == type_name {\n      match lookup_method_gen(gen_table, trait_name, method) {\n        Some(g) => {\n          let (tps, bounds) = g\n          match lookup_trait_method_param_types(traits, trait_name, method) {\n            Some(ptypes) => {\n              result = Some((tps, bounds, ptypes))\n              i = Array::length(impl_map)\n            },\n            None => {\n              i = i + 1\n            }\n          }\n        },\n        None => {\n          i = i + 1\n        }\n      }\n    } else {\n      i = i + 1\n    }\n  }\n  result\n}\n\nfn annotate_params_from_sig(params: Array[(String, Option[TypeExpr])], ptypes: Array[TypeExpr]) -> Array[(String, Option[TypeExpr])] {\n  let out = array_empty()\n  let mut i = 0\n  while i < Array::length(params) {\n    let (pname, ann) = Array::get(params, i)\n    let new_ann = match ann {\n      Some(_) => ann,\n      None => if i < Array::length(ptypes) {\n        Some(Array::get(ptypes, i))\n      } else {\n        None\n      }\n    }\n    Array::push(out, (pname, new_ann))\n    i = i + 1\n  }\n  out\n}\n\nfn inject_method_generics(stmts: Array[Stmt], impl_map: Array[(String, String)], gen_table: Array[(String, Array[(String, Array[String], Array[(String, Array[String])])])], traits: Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])]) -> Unit {\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SLet(exp, isrec, qname, ann, body) => match body {\n        EFn(tparams, bounds, params, ret, eff, fbody) => if Array::length(tparams) == 0 {\n          match split_qualified(qname) {\n            Some(parts) => {\n              let (cname, method) = parts\n              match find_method_generic_for_impl(impl_map, gen_table, traits, cname, method) {\n                Some(g) => {\n                  let (mtparams, mtbounds, ptypes) = g\n                  let new_params = annotate_params_from_sig(params, ptypes)\n                  let new_efn = EFn(mtparams, mtbounds, new_params, ret, eff, fbody)\n                  Array::set(stmts, i, SLet(exp, isrec, qname, ann, new_efn))\n                },\n                None => ()\n              }\n            },\n            None => ()\n          }\n        } else {\n          ()\n        },\n        _ => ()\n      },\n      _ => ()\n    }\n    i = i + 1\n  }\n}\n\nfn inject_trait_method_generics_with(stmts: Array[Stmt], traits: Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])]) -> Unit {\n  let method_gen_table = collect_trait_method_gens(stmts)\n  if Array::length(method_gen_table) > 0 {\n    let impl_map = collect_impl_trait_map(stmts)\n    inject_method_generics(stmts, impl_map, method_gen_table, traits)\n  } else {\n    ()\n  }\n}\n\nexport fn inject_trait_method_generics(stmts: Array[Stmt]) -> Unit {\n  let traits_raw = collect_method_traits(stmts)\n  let supers_map = collect_trait_supers(stmts)\n  let traits = flatten_traits(traits_raw, supers_map)\n  inject_trait_method_generics_with(stmts, traits)\n}\n\nfn is_result_ctor_name(s: String) -> Bool {\n  s == \"Ok\" || s == \"Err\" || s == \"Result::Ok\" || s == \"Result::Err\"\n}\n\nfn ty_mentions_result(te: TypeExpr) -> Bool {\n  match te {\n    TyName(n) => n == \"Result\",\n    TyApp(n, args) => if n == \"Result\" {\n      true\n    } else {\n      let mut i = 0\n      let mut found = false\n      while i < Array::length(args) {\n        if ty_mentions_result(Array::get(args, i)) {\n          found = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      found\n    },\n    TyFn(params, ret, _) => {\n      let mut found = ty_mentions_result(ret)\n      let mut i = 0\n      while i < Array::length(params) {\n        if ty_mentions_result(Array::get(params, i)) {\n          found = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      found\n    },\n    TyTuple(elems) => {\n      let mut found = false\n      let mut i = 0\n      while i < Array::length(elems) {\n        if ty_mentions_result(Array::get(elems, i)) {\n          found = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      found\n    },\n    TyUnit => false\n  }\n}\n\nfn opt_ty_mentions_result(o: Option[TypeExpr]) -> Bool {\n  match o {\n    Some(t) => ty_mentions_result(t),\n    None => false\n  }\n}\n\nfn pat_mentions_result(p: Pat) -> Bool {\n  match p {\n    PCtor(name, sub) => if is_result_ctor_name(name) {\n      true\n    } else {\n      let mut i = 0\n      let mut found = false\n      while i < Array::length(sub) {\n        if pat_mentions_result(Array::get(sub, i)) {\n          found = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      found\n    },\n    PStruct(name, fields) => if is_result_ctor_name(name) || name == \"Result\" {\n      true\n    } else {\n      let mut i = 0\n      let mut found = false\n      while i < Array::length(fields) {\n        let (_, fp) = Array::get(fields, i)\n        if pat_mentions_result(fp) {\n          found = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      found\n    },\n    PTuple(sub) => {\n      let mut i = 0\n      let mut found = false\n      while i < Array::length(sub) {\n        if pat_mentions_result(Array::get(sub, i)) {\n          found = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      found\n    },\n    POr(a, b) => pat_mentions_result(a) || pat_mentions_result(b),\n    _ => false\n  }\n}\n\nfn expr_mentions_result(e: Expr) -> Bool {\n  match e {\n    EIdent(n, _) => is_result_ctor_name(n) || n == \"Result\",\n    ETuple(elems) => {\n      let mut i = 0\n      let mut found = false\n      while i < Array::length(elems) {\n        if expr_mentions_result(Array::get(elems, i)) {\n          found = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      found\n    },\n    EArray(elems) => {\n      let mut i = 0\n      let mut found = false\n      while i < Array::length(elems) {\n        if expr_mentions_result(Array::get(elems, i)) {\n          found = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      found\n    },\n    ERecord(_, fields, _) => {\n      let mut i = 0\n      let mut found = false\n      while i < Array::length(fields) {\n        let (_, v) = Array::get(fields, i)\n        if expr_mentions_result(v) {\n          found = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      found\n    },\n    EMap(fields) => {\n      let mut i = 0\n      let mut found = false\n      while i < Array::length(fields) {\n        let (_, v) = Array::get(fields, i)\n        if expr_mentions_result(v) {\n          found = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      found\n    },\n    EIf(c, t, el) => expr_mentions_result(c) || expr_mentions_result(t) || expr_mentions_result(el),\n    ELet(_, v, b, _) => expr_mentions_result(v) || expr_mentions_result(b),\n    ELetRec(_, v, b) => expr_mentions_result(v) || expr_mentions_result(b),\n    ELetMut(_, v, b, _) => expr_mentions_result(v) || expr_mentions_result(b),\n    EAssign(_, v, b) => expr_mentions_result(v) || expr_mentions_result(b),\n    EAssignOp(_, _, v, b) => expr_mentions_result(v) || expr_mentions_result(b),\n    ESeq(a, b) => expr_mentions_result(a) || expr_mentions_result(b),\n    EMatch(scrut, arms) => {\n      let mut found = expr_mentions_result(scrut)\n      let mut i = 0\n      while i < Array::length(arms) {\n        let (p, b) = Array::get(arms, i)\n        if pat_mentions_result(p) || expr_mentions_result(b) {\n          found = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      found\n    },\n    EHandle(scrut, arms) => {\n      let mut found = expr_mentions_result(scrut)\n      let mut i = 0\n      while i < Array::length(arms) {\n        let (p, b) = Array::get(arms, i)\n        if pat_mentions_result(p) || expr_mentions_result(b) {\n          found = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      found\n    },\n    EWhile(c, b) => expr_mentions_result(c) || expr_mentions_result(b),\n    ELoop(params, body) => {\n      let mut found = expr_mentions_result(body)\n      let mut i = 0\n      while i < Array::length(params) {\n        let (_, v) = Array::get(params, i)\n        if expr_mentions_result(v) {\n          found = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      found\n    },\n    EForIn(_, _, it, body) => expr_mentions_result(it) || expr_mentions_result(body),\n    ECall(callee, args, _) => {\n      let mut found = expr_mentions_result(callee)\n      let mut i = 0\n      while i < Array::length(args) {\n        if expr_mentions_result(Array::get(args, i)) {\n          found = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      found\n    },\n    EBinOp(_, l, r) => expr_mentions_result(l) || expr_mentions_result(r),\n    EUnaryOp(_, x) => expr_mentions_result(x),\n    EFn(_, _, params, ret, _, body) => {\n      let mut found = opt_ty_mentions_result(ret) || expr_mentions_result(body)\n      let mut i = 0\n      while i < Array::length(params) {\n        let (_, ann) = Array::get(params, i)\n        if opt_ty_mentions_result(ann) {\n          found = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      found\n    },\n    EDot(o, _, _, _) => expr_mentions_result(o),\n    ELabeledArg(_, _, v) => expr_mentions_result(v),\n    EReturn(x) => expr_mentions_result(x),\n    EBreak(o) => match o {\n      Some(x) => expr_mentions_result(x),\n      None => false\n    },\n    EContinue(xs) => {\n      let mut i = 0\n      let mut found = false\n      while i < Array::length(xs) {\n        if expr_mentions_result(Array::get(xs, i)) {\n          found = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      found\n    },\n    ESpread(x) => expr_mentions_result(x),\n    _ => false\n  }\n}\n\nfn stmt_mentions_result(s: Stmt) -> Bool {\n  match s {\n    SLet(_, _, _, ann, v) => opt_ty_mentions_result(ann) || expr_mentions_result(v),\n    SLetMut(_, ann, v) => opt_ty_mentions_result(ann) || expr_mentions_result(v),\n    STest(_, b) => expr_mentions_result(b),\n    SBench(_, b) => expr_mentions_result(b),\n    SExpr(e) => expr_mentions_result(e),\n    SLetPat(p, e) => pat_mentions_result(p) || expr_mentions_result(e),\n    SExternLet(_, te) => ty_mentions_result(te),\n    STypeAlias(_, _, _, te) => ty_mentions_result(te),\n    SStruct(_, _, fields, _, _, _) => {\n      let mut i = 0\n      let mut found = false\n      while i < Array::length(fields) {\n        let (_, te) = Array::get(fields, i)\n        if ty_mentions_result(te) {\n          found = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      found\n    },\n    SModule(_, _, body) => {\n      let mut i = 0\n      let mut found = false\n      while i < Array::length(body) {\n        if stmt_mentions_result(Array::get(body, i)) {\n          found = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      found\n    },\n    _ => false\n  }\n}\n\nfn program_mentions_result(stmts: Array[Stmt]) -> Bool {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(stmts) {\n    if stmt_mentions_result(Array::get(stmts, i)) {\n      found = true\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  found\n}\n\nfn result_already_present(stmts: Array[Stmt]) -> Bool {\n  let mut present = false\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SEnum(_, name, _, variants, _) => {\n        if name == \"Result\" {\n          present = true\n        } else {\n          ()\n        }\n        let mut vi = 0\n        while vi < Array::length(variants) {\n          let (vn, _) = Array::get(variants, vi)\n          if vn == \"Ok\" || vn == \"Err\" {\n            present = true\n          } else {\n            ()\n          }\n          vi = vi + 1\n        }\n      },\n      SStruct(_, name, _, _, _, _) => if name == \"Result\" {\n        present = true\n      } else {\n        ()\n      },\n      STypeAlias(_, name, _, _) => if name == \"Result\" {\n        present = true\n      } else {\n        ()\n      },\n      SImport(_, names) => {\n        let mut ni = 0\n        while ni < Array::length(names) {\n          let (nm, _) = Array::get(names, ni)\n          if nm == \"Result\" || nm == \"Ok\" || nm == \"Err\" {\n            present = true\n          } else {\n            ()\n          }\n          ni = ni + 1\n        }\n      },\n      SReExport(_, names) => {\n        let mut ni = 0\n        while ni < Array::length(names) {\n          let (nm, _) = Array::get(names, ni)\n          if nm == \"Result\" || nm == \"Ok\" || nm == \"Err\" {\n            present = true\n          } else {\n            ()\n          }\n          ni = ni + 1\n        }\n      },\n      _ => ()\n    }\n    i = i + 1\n  }\n  present\n}\n\nexport fn inject_prelude_result(stmts: Array[Stmt]) -> Unit {\n  if result_already_present(stmts) || !program_mentions_result(stmts) {\n    ()\n  } else {\n    let variants = [\n      (\"Ok\", [\n        TyName(\"T\")\n      ]),\n      (\"Err\", [\n        TyName(\"E\")\n      ])\n    ]\n    let params = [\n      \"T\",\n      \"E\"\n    ]\n    Array::push(stmts, SEnum(false, \"Result\", params, variants, empty_str_array()))\n  }\n}\n\n\nfn exn_kind_cell_name() -> String {\n  \"__exn_kind_cell\"\n}\n\nfn exn_kind_cell_stmt() -> Stmt {\n  SLet(false, false, exn_kind_cell_name(), None, EArray([\n    EString(\"\"),\n    EString(\"\")\n  ]))\n}\n\nexport fn exn_kind_read_expr() -> Expr {\n  ECall(EIdent(\"Array::get\", -1), [\n    EIdent(exn_kind_cell_name(), -1),\n    EInt(0)\n  ], -1)\n}\n\nfn exn_kind_write_expr(kind: String) -> Expr {\n  ECall(EIdent(\"Array::set\", -1), [\n    EIdent(exn_kind_cell_name(), -1),\n    EInt(0),\n    EString(kind)\n  ], -1)\n}\n\nexport fn exn_msg_read_expr() -> Expr {\n  ECall(EIdent(\"Array::get\", -1), [\n    EIdent(exn_kind_cell_name(), -1),\n    EInt(1)\n  ], -1)\n}\n\nfn exn_msg_write_expr(rendered: Expr) -> Expr {\n  ECall(EIdent(\"Array::set\", -1), [\n    EIdent(exn_kind_cell_name(), -1),\n    EInt(1),\n    rendered\n  ], -1)\n}\n\nexport fn ensure_exn_kind_cell(stmts: Array[Stmt]) -> Unit {\n  if exn_kind_cell_present(stmts) {\n    ()\n  } else {\n    Array::push(stmts, exn_kind_cell_stmt())\n  }\n}\n\nfn exn_kind_cell_present(stmts: Array[Stmt]) -> Bool {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SLet(_, _, n, _, _) => if n == exn_kind_cell_name() {\n        found = true\n      } else {\n        ()\n      },\n      _ => ()\n    }\n    i = i + 1\n  }\n  found\n}\n\nlet dtd_exn_kind_state = [\n  0,\n  0,\n  0\n]\n\nfn exn_kind_suppressed() -> Bool {\n  Array::get(dtd_exn_kind_state, 0) == 1\n}\n\nfn exn_kind_mark_used() -> Unit {\n  Array::set(dtd_exn_kind_state, 1, 1)\n}\n\nfn exn_kind_fresh_payload_name() -> String {\n  let n = Array::get(dtd_exn_kind_state, 2)\n  Array::set(dtd_exn_kind_state, 2, n + 1)\n  String::concat(\"__exn_payload\", __to_string(n))\n}\n\nfn is_perform_throw_shape(callee: Expr, args: Array[Expr]) -> Bool {\n  let head = match callee {\n    EIdent(n, _) => n == \"perform\",\n    _ => false\n  }\n  if head && Array::length(args) == 1 {\n    match Array::get(args, 0) {\n      ECall(op_callee, oargs, _) => match op_callee {\n        EIdent(op_n, _) => is_exception_throw_operation(op_n) && Array::length(oargs) == 1,\n        _ => false\n      },\n      _ => false\n    }\n  } else {\n    false\n  }\n}\n\nfn is_exception_kind_read(callee: Expr, args: Array[Expr]) -> Bool {\n  match callee {\n    EIdent(n, _) => n == \"__exn_kind\" && Array::length(args) == 0,\n    _ => false\n  }\n}\n\nfn is_exception_message_read(callee: Expr, args: Array[Expr]) -> Bool {\n  match callee {\n    EIdent(n, _) => n == \"__exn_message\" && Array::length(args) == 0,\n    _ => false\n  }\n}\n\nfn perform_throw_payload(args: Array[Expr]) -> Expr {\n  match Array::get(args, 0) {\n    ECall(_, oargs, _) => Array::get(oargs, 0),\n    _ => EUnit\n  }\n}\n\nfn perform_throw_with_payload(args: Array[Expr], payload: Expr) -> Array[Expr] {\n  match Array::get(args, 0) {\n    ECall(op_callee, _, ooff) => [\n      ECall(op_callee, [\n        payload\n      ], ooff)\n    ],\n    _ => args\n  }\n}\n\nfn collect_trait_supers(stmts: Array[Stmt]) -> Array[(String, Array[String])] {\n  let out = array_empty()\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      STrait(_, tname, supers, _, _, _) => Array::push(out, (tname, supers)),\n      _ => ()\n    }\n    i = i + 1\n  }\n  out\n}\n\nfn lookup_supers(supers_map: Array[(String, Array[String])], name: String) -> Array[String] {\n  let mut i = 0\n  let mut result = empty_str_array()\n  while i < Array::length(supers_map) {\n    let (tname, supers) = Array::get(supers_map, i)\n    if tname == name {\n      result = supers\n      i = Array::length(supers_map)\n    } else {\n      i = i + 1\n    }\n  }\n  result\n}\n\nfn flatten_trait_sigs_into(tname: String, traits_raw: Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], supers_map: Array[(String, Array[String])], acc_names: Array[String], out: Array[(String, Array[TypeExpr], TypeExpr)]) -> Unit {\n  let supers = lookup_supers(supers_map, tname)\n  let mut s = 0\n  while s < Array::length(supers) {\n    flatten_trait_sigs_into(Array::get(supers, s), traits_raw, supers_map, acc_names, out)\n    s = s + 1\n  }\n  match lookup_trait_sigs(traits_raw, tname) {\n    Some(sigs) => {\n      let mut i = 0\n      while i < Array::length(sigs) {\n        let (mname, params, ret) = Array::get(sigs, i)\n        if str_array_contains(acc_names, mname) {\n          ()\n        } else {\n          Array::push(acc_names, mname)\n          Array::push(out, (mname, params, ret))\n        }\n        i = i + 1\n      }\n    },\n    None => ()\n  }\n}\n\nfn flatten_traits(traits_raw: Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], supers_map: Array[(String, Array[String])]) -> Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])] {\n  let out = array_empty()\n  let mut i = 0\n  while i < Array::length(traits_raw) {\n    let (tname, _) = Array::get(traits_raw, i)\n    let acc_names = empty_str_array()\n    let flat = array_empty()\n    flatten_trait_sigs_into(tname, traits_raw, supers_map, acc_names, flat)\n    Array::push(out, (tname, flat))\n    i = i + 1\n  }\n  out\n}\n\nfn lookup_trait_sigs(traits: Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], name: String) -> Option[Array[(String, Array[TypeExpr], TypeExpr)]] {\n  let mut i = 0\n  let mut result = None\n  while i < Array::length(traits) {\n    let (tname, sigs) = Array::get(traits, i)\n    if tname == name {\n      result = Some(sigs)\n      i = Array::length(traits)\n    } else {\n      i = i + 1\n    }\n  }\n  result\n}\n\nfn collect_struct_field_sets(stmts: Array[Stmt]) -> Array[(String, Array[String])] {\n  let out = array_empty()\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SStruct(_, sname, fields, _, _, _) => {\n        let names = empty_str_array()\n        let mut j = 0\n        while j < Array::length(fields) {\n          let (fname, _) = Array::get(fields, j)\n          Array::push(names, fname)\n          j = j + 1\n        }\n        Array::push(out, (sname, names))\n      },\n      SEnum(_, ename, _, _, _) => Array::push(out, (ename, empty_str_array())),\n      _ => ()\n    }\n    i = i + 1\n  }\n  out\n}\n\nfn make_dict_struct_stmt(trait_name: String, sigs: Array[(String, Array[TypeExpr], TypeExpr)]) -> Stmt {\n  let fields = array_empty()\n  let mut i = 0\n  while i < Array::length(sigs) {\n    let (mname, params, ret) = Array::get(sigs, i)\n    Array::push(fields, (mname, TyFn(params, ret, None)))\n    i = i + 1\n  }\n  SStruct(false, dict_struct_name(trait_name), fields, empty_str_array(), empty_str_array(), empty_str_array())\n}\n\nfn field_sets_match(a: Array[String], b: Array[String]) -> Bool {\n  if Array::length(a) != Array::length(b) {\n    false\n  } else {\n    let mut i = 0\n    let mut ok = true\n    while i < Array::length(a) {\n      if str_array_contains(b, Array::get(a, i)) {\n        i = i + 1\n      } else {\n        ok = false\n        i = Array::length(a)\n      }\n    }\n    ok\n  }\n}\n\nfn struct_set_has(struct_sets: Array[(String, Array[String])], name: String) -> Bool {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(struct_sets) {\n    let (sname, _) = Array::get(struct_sets, i)\n    if sname == name {\n      found = true\n      i = Array::length(struct_sets)\n    } else {\n      i = i + 1\n    }\n  }\n  found\n}\n\nfn struct_set_member(struct_sets: Array[(String, Array[String])], name: String, member: String) -> Bool {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(struct_sets) {\n    let (sname, members) = Array::get(struct_sets, i)\n    if sname == name {\n      let mut j = 0\n      while j < Array::length(members) {\n        if Array::get(members, j) == member {\n          found = true\n          j = Array::length(members)\n        } else {\n          j = j + 1\n        }\n      }\n      i = Array::length(struct_sets)\n    } else {\n      i = i + 1\n    }\n  }\n  found\n}\n\nfn prepend_expr(head: Expr, rest: Array[Expr]) -> Array[Expr] {\n  let out = array_empty()\n  Array::push(out, head)\n  let mut i = 0\n  while i < Array::length(rest) {\n    Array::push(out, Array::get(rest, i))\n    i = i + 1\n  }\n  out\n}\n\nfn lookup_var_type(var_types: Array[(String, String)], name: String) -> Option[String] {\n  let mut i = 0\n  let mut result = None\n  while i < Array::length(var_types) {\n    let (vn, vt) = Array::get(var_types, i)\n    if vn == name {\n      result = Some(vt)\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  result\n}\n\nfn ctor_enum_of_name(fn_returns: Array[(String, String)], name: String) -> Option[String] {\n  match fn_return_type(fn_returns, name) {\n    Some(t) => Some(t),\n    None => match split_qualified(name) {\n      Some(parts) => {\n        let (head, member) = parts\n        match fn_return_type(fn_returns, member) {\n          Some(en) => if en == head {\n            Some(en)\n          } else {\n            None\n          },\n          None => None\n        }\n      },\n      None => None\n    }\n  }\n}\n\nfn infer_arg_type_name(arg: Expr, struct_sets: Array[(String, Array[String])], var_types: Array[(String, String)], fn_returns: Array[(String, String)]) -> Option[String] {\n  match arg {\n    EInt(_) => Some(\"Int\"),\n    EBool(_) => Some(\"Bool\"),\n    EString(_) => Some(\"String\"),\n    EFloat(_) => Some(\"Double\"),\n    EBinOp(bop, bl, br) => if bop == \"+\" {\n      let lstr = match infer_arg_type_name(bl, struct_sets, var_types, fn_returns) {\n        Some(t) => t == \"String\",\n        None => false\n      }\n      let rstr = match infer_arg_type_name(br, struct_sets, var_types, fn_returns) {\n        Some(t) => t == \"String\",\n        None => false\n      }\n      if lstr || rstr {\n        Some(\"String\")\n      } else {\n        None\n      }\n    } else {\n      None\n    },\n    EArray(_) => Some(\"Array\"),\n    EMap(_) => Some(\"Map\"),\n    EIdent(name, _) => if name == \"None\" {\n      Some(\"Option\")\n    } else {\n      match lookup_var_type(var_types, name) {\n        Some(t) => Some(t),\n        None => ctor_enum_of_name(fn_returns, name)\n      }\n    },\n    EDot(obj, field, _, _) => match infer_arg_type_name(obj, struct_sets, var_types, fn_returns) {\n      Some(otype) => fn_return_type(fn_returns, struct_field_type_key(otype, field)),\n      None => None\n    },\n    ECall(callee, cargs, _) => match callee {\n      EIdent(\"Some\", _) => Some(\"Option\"),\n      EIdent(\"Ok\", _) => Some(\"Result\"),\n      EIdent(\"Err\", _) => Some(\"Result\"),\n      EIdent(\"Array::get\", _) => if Array::length(cargs) == 2 {\n        match Array::get(cargs, 0) {\n          EIdent(arrname, _) => array_elem_type_of(var_types, arrname),\n          _ => None\n        }\n      } else {\n        None\n      },\n      EIdent(\"__index\", _) => if Array::length(cargs) == 2 {\n        match Array::get(cargs, 0) {\n          EIdent(arrname, _) => array_elem_type_of(var_types, arrname),\n          _ => None\n        }\n      } else {\n        None\n      },\n      EIdent(\"host_stream_named\", _) => Some(\"HostStream\"),\n      EIdent(\"String::concat\", _) => Some(\"String\"),\n      EIdent(\"String::join\", _) => Some(\"String\"),\n      EIdent(\"String::substring\", _) => Some(\"String\"),\n      EIdent(\"String::trim\", _) => Some(\"String\"),\n      EIdent(\"String::replace\", _) => Some(\"String\"),\n      EIdent(\"String::from_char_code\", _) => Some(\"String\"),\n      EIdent(\"__to_string\", _) => Some(\"String\"),\n      EIdent(\"Map::set\", _) => Some(\"Map\"),\n      EIdent(\"Map::remove\", _) => Some(\"Map\"),\n      EIdent(\"Map::insert\", _) => Some(\"Map\"),\n      EIdent(\"Map::delete\", _) => Some(\"Map\"),\n      EIdent(\"MapBuilder::freeze\", _) => Some(\"Map\"),\n      EIdent(\"Stream::once\", _) => Some(\"Stream\"),\n      EIdent(\"Stream::empty\", _) => Some(\"Stream\"),\n      EIdent(\"Stream::map\", _) => Some(\"Stream\"),\n      EIdent(\"Stream::filter\", _) => Some(\"Stream\"),\n      EIdent(\"String::to_bytes\", _) => Some(\"Stream\"),\n      EIdent(fname, _) => ctor_enum_of_name(fn_returns, fname),\n      EFn(_, _, params, _, _, _) => if Array::length(params) == 1 {\n        let (_, ann) = Array::get(params, 0)\n        match ann {\n          Some(TyName(n)) => Some(n),\n          Some(TyApp(n, _)) => Some(n),\n          _ => None\n        }\n      } else {\n        None\n      },\n      EDot(dobj, dmethod, _, _) => {\n        let recv_tn = infer_arg_type_name(dobj, struct_sets, var_types, fn_returns)\n        let qual_rt = match recv_tn {\n          Some(tn) => fn_return_type(fn_returns, String::concat(tn, String::concat(\"::\", dmethod))),\n          None => None\n        }\n        match qual_rt {\n          Some(rt) => Some(rt),\n          None => fn_return_type(fn_returns, dmethod)\n        }\n      },\n      _ => None\n    },\n    ERecord(_, fields, _) => {\n      let names = empty_str_array()\n      let mut i = 0\n      while i < Array::length(fields) {\n        let (fname, _) = Array::get(fields, i)\n        Array::push(names, fname)\n        i = i + 1\n      }\n      let mut j = 0\n      let mut result = None\n      while j < Array::length(struct_sets) {\n        let (sname, sfields) = Array::get(struct_sets, j)\n        if field_sets_match(names, sfields) {\n          result = Some(sname)\n          j = Array::length(struct_sets)\n        } else {\n          j = j + 1\n        }\n      }\n      result\n    },\n    _ => None\n  }\n}\n\nfn is_concrete_or_known_type_name(t: String, struct_sets: Array[(String, Array[String])]) -> Bool {\n  t == \"Int\" || t == \"Bool\" || t == \"String\" || t == \"Double\" || t == \"Float\" || t == \"Array\" || t == \"Map\" || t == \"Option\" || t == \"Result\" || t == \"Stream\" || struct_set_has(struct_sets, t)\n}\n\nfn is_erased_generic_operand(l: Expr, r: Expr, struct_sets: Array[(String, Array[String])], var_types: Array[(String, String)], fn_returns: Array[(String, String)]) -> Bool {\n  let lg = match infer_arg_type_name(l, struct_sets, var_types, fn_returns) {\n    Some(t) => !is_concrete_or_known_type_name(t, struct_sets),\n    None => false\n  }\n  let rg = match infer_arg_type_name(r, struct_sets, var_types, fn_returns) {\n    Some(t) => !is_concrete_or_known_type_name(t, struct_sets),\n    None => false\n  }\n  lg || rg\n}\n\nfn map_index_rewrite(callee: Expr, args: Array[Expr], rwargs: Array[Expr], struct_sets: Array[(String, Array[String])], var_types: Array[(String, String)], fn_returns: Array[(String, String)]) -> Option[Expr] {\n  match callee {\n    EIdent(nm, _) => if nm == \"__index\" && Array::length(args) == 2 {\n      let recv_map = match infer_arg_type_name(Array::get(args, 0), struct_sets, var_types, fn_returns) {\n        Some(t) => t == \"Map\",\n        None => false\n      }\n      if recv_map {\n        Some(ECall(EIdent(\"Map::get\", -1), rwargs, -1))\n      } else {\n        None\n      }\n    } else {\n      None\n    },\n    _ => None\n  }\n}\n\nfn anon_record_prefix() -> String {\n  \"__anonrec:\"\n}\n\nfn anon_record_sentinel(names: Array[String]) -> String {\n  let mut s = anon_record_prefix()\n  let mut i = 0\n  while i < Array::length(names) {\n    if i > 0 {\n      s = String::concat(s, \",\")\n    } else {\n      ()\n    }\n    s = String::concat(s, Array::get(names, i))\n    i = i + 1\n  }\n  s\n}\n\nfn anon_field_index(sentinel: String, field: String) -> Int {\n  let prefix = anon_record_prefix()\n  if !String::starts_with(sentinel, prefix) {\n    -1\n  } else {\n    let mut rest = String::substring(sentinel, String::length(prefix), String::length(sentinel))\n    let mut idx = 0\n    let mut found = -1\n    let mut go = true\n    while go {\n      let comma = String::index_of(rest, \",\")\n      let tok = if comma < 0 {\n        rest\n      } else {\n        String::substring(rest, 0, comma)\n      }\n      if tok == field {\n        found = idx\n        go = false\n      } else if comma < 0 {\n        go = false\n      } else {\n        rest = String::substring(rest, comma + 1, String::length(rest))\n        idx = idx + 1\n      }\n    }\n    found\n  }\n}\n\nfn anon_record_inferred(val: Expr, struct_sets: Array[(String, Array[String])]) -> Option[String] {\n  match val {\n    ERecord(_, fields, _) => {\n      let names = empty_str_array()\n      let mut i = 0\n      while i < Array::length(fields) {\n        let (fname, _) = Array::get(fields, i)\n        Array::push(names, fname)\n        i = i + 1\n      }\n      let mut j = 0\n      let mut matched = false\n      while j < Array::length(struct_sets) {\n        let (_, sfields) = Array::get(struct_sets, j)\n        if field_sets_match(names, sfields) {\n          matched = true\n          j = Array::length(struct_sets)\n        } else {\n          j = j + 1\n        }\n      }\n      if matched {\n        None\n      } else {\n        Some(anon_record_sentinel(names))\n      }\n    },\n    _ => None\n  }\n}\n\nfn anon_or_infer(val: Expr, struct_sets: Array[(String, Array[String])], var_types: Array[(String, String)], fn_returns: Array[(String, String)]) -> Option[String] {\n  match anon_record_inferred(val, struct_sets) {\n    Some(s) => Some(s),\n    None => infer_arg_type_name(val, struct_sets, var_types, fn_returns)\n  }\n}\n\nfn anon_dot_rewrite(obj: Expr, field: String, off: Int, robj: Expr, var_types: Array[(String, String)]) -> Option[Expr] {\n  match obj {\n    EIdent(vn, _) => match lookup_var_type(var_types, vn) {\n      Some(t) => {\n        let idx = anon_field_index(t, field)\n        if idx >= 0 {\n          Some(ECall(EIdent(\"__rec_field\", off), [\n            robj,\n            EInt(idx)\n          ], off))\n        } else {\n          None\n        }\n      },\n      None => None\n    },\n    _ => None\n  }\n}\n\nfn empty_threaded() -> Array[(String, String, Int)] {\n  array_empty()\n}\n\nfn empty_dict_binds() -> Array[(String, String, String, Array[String])] {\n  array_empty()\n}\n\nfn already_threaded(params: Array[(String, Option[TypeExpr])]) -> Bool {\n  if Array::length(params) == 0 {\n    false\n  } else {\n    let (pname, _) = Array::get(params, 0)\n    String::starts_with(pname, \"__dict_\")\n  }\n}\n\nfn find_recv_index(params: Array[(String, Option[TypeExpr])], tp: String) -> Int {\n  let mut i = 0\n  let mut idx = -1\n  while i < Array::length(params) {\n    let (_, ann) = Array::get(params, i)\n    match ann {\n      Some(TyName(n)) => if n == tp {\n        idx = i\n        i = Array::length(params)\n      } else {\n        i = i + 1\n      },\n      _ => {\n        i = i + 1\n      }\n    }\n  }\n  idx\n}\n\nfn find_array_elem_recv_index(params: Array[(String, Option[TypeExpr])], tp: String) -> Int {\n  let mut i = 0\n  let mut idx = -1\n  while i < Array::length(params) {\n    let (_, ann) = Array::get(params, i)\n    match ann {\n      Some(TyApp(\"Array\", targs)) => if Array::length(targs) == 1 {\n        match Array::get(targs, 0) {\n          TyName(n) => if n == tp {\n            idx = i\n            i = Array::length(params)\n          } else {\n            i = i + 1\n          },\n          _ => {\n            i = i + 1\n          }\n        }\n      } else {\n        i = i + 1\n      },\n      _ => {\n        i = i + 1\n      }\n    }\n  }\n  idx\n}\n\nfn encode_array_elem_recv_index(idx: Int) -> Int {\n  0 - idx - 2\n}\n\nfn is_array_elem_recv_index(idx: Int) -> Bool {\n  idx <= (0 - 2)\n}\n\nfn decode_array_elem_recv_index(idx: Int) -> Int {\n  0 - idx - 2\n}\n\nfn qualified_head(name: String) -> String {\n  match split_qualified(name) {\n    Some(parts) => {\n      let (head, _) = parts\n      head\n    },\n    None => \"\"\n  }\n}\n\nfn collect_generic_impl_types(stmts: Array[Stmt]) -> Array[String] {\n  let out = empty_str_array()\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SImpl(tparams, tbounds, _, type_name) => if Array::length(tparams) > 0 {\n        let mut has_bound = false\n        let mut bi = 0\n        while bi < Array::length(tbounds) {\n          let (_, bs) = Array::get(tbounds, bi)\n          let mut bj = 0\n          while bj < Array::length(bs) {\n            if Array::get(bs, bj) != \"\" {\n              has_bound = true\n            } else {\n              ()\n            }\n            bj = bj + 1\n          }\n          bi = bi + 1\n        }\n        if has_bound {\n          Array::push(out, type_name)\n        } else {\n          ()\n        }\n      } else (),\n      _ => ()\n    }\n    i = i + 1\n  }\n  out\n}\n\nfn build_gens(stmts: Array[Stmt], traits: Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], gimpl_types: Array[String]) -> Array[(String, Array[(String, String, Int)])] {\n  let out = array_empty()\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SLet(_, _, fname, _, body) => match body {\n        EFn(_, bounds, params, _, _, _) => if already_threaded(params) {\n          ()\n        } else {\n          let threaded = empty_threaded()\n          let mut bi = 0\n          while bi < Array::length(bounds) {\n            let (tp, trait_list) = Array::get(bounds, bi)\n            let mut ti = 0\n            while ti < Array::length(trait_list) {\n              let tr = Array::get(trait_list, ti)\n              match lookup_trait_sigs(traits, tr) {\n                Some(_) => {\n                  let ridx = find_recv_index(params, tp)\n                  if ridx >= 0 {\n                    Array::push(threaded, (tp, tr, ridx))\n                  } else if str_array_contains(gimpl_types, qualified_head(fname)) {\n                    Array::push(threaded, (tp, tr, 0 - 1))\n                  } else {\n                    let widx = find_array_elem_recv_index(params, tp)\n                    if widx >= 0 {\n                      Array::push(threaded, (tp, tr, encode_array_elem_recv_index(widx)))\n                    } else {\n                      ()\n                    }\n                  }\n                },\n                None => ()\n              }\n              ti = ti + 1\n            }\n            bi = bi + 1\n          }\n          if Array::length(threaded) > 0 {\n            Array::push(out, (fname, threaded))\n          } else {\n            ()\n          }\n        },\n        _ => ()\n      },\n      _ => ()\n    }\n    i = i + 1\n  }\n  out\n}\n\nfn lookup_gen(gens: Array[(String, Array[(String, String, Int)])], name: String) -> Option[Array[(String, String, Int)]] {\n  let mut i = 0\n  let mut result = None\n  while i < Array::length(gens) {\n    let (gname, threaded) = Array::get(gens, i)\n    if gname == name {\n      result = Some(threaded)\n      i = Array::length(gens)\n    } else {\n      i = i + 1\n    }\n  }\n  result\n}\n\nfn find_dict_for_method(dict_binds: Array[(String, String, String, Array[String])], head: String, member: String) -> Option[String] {\n  let mut i = 0\n  let mut result = None\n  while i < Array::length(dict_binds) {\n    let (tp, _, dict_pname, methods) = Array::get(dict_binds, i)\n    if tp == head && str_array_contains(methods, member) {\n      result = Some(dict_pname)\n      i = Array::length(dict_binds)\n    } else {\n      i = i + 1\n    }\n  }\n  result\n}\n\nfn find_dict_for_trait(dict_binds: Array[(String, String, String, Array[String])], tparam: String, trait_name: String) -> Option[String] {\n  let mut i = 0\n  let mut result = None\n  while i < Array::length(dict_binds) {\n    let (tp, tr, dict_pname, _) = Array::get(dict_binds, i)\n    if tp == tparam && tr == trait_name {\n      result = Some(dict_pname)\n      i = Array::length(dict_binds)\n    } else {\n      i = i + 1\n    }\n  }\n  result\n}\n\nfn first_array_elem(e: Expr) -> Option[Expr] {\n  match e {\n    EArray(elems) => if Array::length(elems) > 0 {\n      Some(Array::get(elems, 0))\n    } else None,\n    _ => None\n  }\n}\n\nfn build_concrete_dict(cname: String, trait_name: String, traits: Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], gens: Array[(String, Array[(String, String, Int)])], struct_sets: Array[(String, Array[String])], var_types: Array[(String, String)], fn_returns: Array[(String, String)], arg_expr: Expr) -> Option[Expr] {\n  match lookup_trait_sigs(traits, trait_name) {\n    Some(sigs) => {\n      let mnames = method_names_of_sigs(sigs)\n      let recfields = array_empty()\n      let mut mi = 0\n      let mut failed = false\n      while mi < Array::length(mnames) {\n        let m = Array::get(mnames, mi)\n        let qm = String::concat(cname, String::concat(\"::\", m))\n        if not(fn_exists(fn_returns, qm)) {\n          failed = true\n        } else {\n          match lookup_gen(gens, qm) {\n            Some(threaded) => {\n              match first_array_elem(arg_expr) {\n                Some(elem) => match infer_arg_type_name(elem, struct_sets, var_types, fn_returns) {\n                  Some(en) => {\n                    let callargs = empty_expr_array()\n                    let mut bi = 0\n                    let mut subok = true\n                    while bi < Array::length(threaded) {\n                      let (_, btrait, _) = Array::get(threaded, bi)\n                      match build_concrete_dict(en, btrait, traits, gens, struct_sets, var_types, fn_returns, elem) {\n                        Some(sd) => Array::push(callargs, sd),\n                        None => {\n                          subok = false\n                        }\n                      }\n                      bi = bi + 1\n                    }\n                    if subok {\n                      Array::push(callargs, EIdent(\"__w\", -1))\n                      let closure = EFn(empty_str_array(), array_empty(), Array::slice([\n                        (\"__w\", None)\n                      ], 0, 1), None, None, ECall(EIdent(qm, -1), callargs, -1))\n                      Array::push(recfields, (m, closure))\n                    } else {\n                      failed = true\n                    }\n                  },\n                  None => {\n                    failed = true\n                  }\n                },\n                None => {\n                  failed = true\n                }\n              }\n            },\n            None => Array::push(recfields, (m, EIdent(qm, -1)))\n          }\n        }\n        mi = mi + 1\n      }\n      if failed {\n        None\n      } else {\n        Some(ERecord(\"\", recfields, empty_ty_args()))\n      }\n    },\n    None => None\n  }\n}\n\nfn infer_arg_elem_type_name(arg: Expr, struct_sets: Array[(String, Array[String])], var_types: Array[(String, String)], fn_returns: Array[(String, String)]) -> Option[String] {\n  match arg {\n    EIdent(name, _) => array_elem_type_of(var_types, name),\n    EArray(elems) => if Array::length(elems) > 0 {\n      infer_arg_type_name(Array::get(elems, 0), struct_sets, var_types, fn_returns)\n    } else {\n      None\n    },\n    _ => None\n  }\n}\n\nfn synth_dicts(threaded: Array[(String, String, Int)], orig_args: Array[Expr], traits: Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], struct_sets: Array[(String, Array[String])], var_types: Array[(String, String)], dict_binds: Array[(String, String, String, Array[String])], fn_returns: Array[(String, String)], gens: Array[(String, Array[(String, String, Int)])]) -> Option[Array[Expr]] {\n  let dicts = empty_expr_array()\n  let mut ok = true\n  let mut bi = 0\n  while bi < Array::length(threaded) {\n    let (_, trait_name, recv_idx_raw) = Array::get(threaded, bi)\n    let is_elem_recv = is_array_elem_recv_index(recv_idx_raw)\n    let recv_idx = if is_elem_recv {\n      decode_array_elem_recv_index(recv_idx_raw)\n    } else {\n      recv_idx_raw\n    }\n    if ok && recv_idx >= 0 && recv_idx < Array::length(orig_args) {\n      let recv_arg = Array::get(orig_args, recv_idx)\n      let inferred = if is_elem_recv {\n        infer_arg_elem_type_name(recv_arg, struct_sets, var_types, fn_returns)\n      } else {\n        infer_arg_type_name(recv_arg, struct_sets, var_types, fn_returns)\n      }\n      match inferred {\n        Some(nm) => match find_dict_for_trait(dict_binds, nm, trait_name) {\n          Some(dict_pname) => Array::push(dicts, EIdent(dict_pname, -1)),\n          None => match build_concrete_dict(nm, trait_name, traits, gens, struct_sets, var_types, fn_returns, recv_arg) {\n            Some(dict) => Array::push(dicts, dict),\n            None => {\n              ok = false\n            }\n          }\n        },\n        None => {\n          ok = false\n        }\n      }\n    } else {\n      ok = false\n    }\n    bi = bi + 1\n  }\n  if ok {\n    Some(dicts)\n  } else {\n    None\n  }\n}\n\nfn concat_expr_arrays(a: Array[Expr], b: Array[Expr]) -> Array[Expr] {\n  let out = empty_expr_array()\n  let mut i = 0\n  while i < Array::length(a) {\n    Array::push(out, Array::get(a, i))\n    i = i + 1\n  }\n  let mut j = 0\n  while j < Array::length(b) {\n    Array::push(out, Array::get(b, j))\n    j = j + 1\n  }\n  out\n}\n\nfn array_elem_key(pname: String) -> String {\n  String::concat(\"__arrelem$\", pname)\n}\n\nfn array_elem_type_of(var_types: Array[(String, String)], name: String) -> Option[String] {\n  lookup_var_type(var_types, array_elem_key(name))\n}\n\nfn array_elem_bind(var_types: Array[(String, String)], name: String, val: Expr, struct_sets: Array[(String, Array[String])], fn_returns: Array[(String, String)]) -> Array[(String, String)] {\n  match val {\n    EArray(elems) => if Array::length(elems) > 0 {\n      match infer_arg_type_name(Array::get(elems, 0), struct_sets, var_types, fn_returns) {\n        Some(elemty) => {\n          let out = array_empty()\n          let mut i = 0\n          while i < Array::length(var_types) {\n            Array::push(out, Array::get(var_types, i))\n            i = i + 1\n          }\n          Array::push(out, (array_elem_key(name), elemty))\n          out\n        },\n        None => var_types\n      }\n    } else {\n      var_types\n    },\n    _ => var_types\n  }\n}\n\nfn seed_var_types(params: Array[(String, Option[TypeExpr])], tparams: Array[String], base: Array[(String, String)]) -> Array[(String, String)] {\n  let _ = tparams\n  let out = array_empty()\n  let mut b = 0\n  while b < Array::length(base) {\n    Array::push(out, Array::get(base, b))\n    b = b + 1\n  }\n  let mut i = 0\n  while i < Array::length(params) {\n    let (pname, ann) = Array::get(params, i)\n    match ann {\n      Some(TyName(tn)) => Array::push(out, (pname, tn)),\n      Some(TyApp(tn, targs)) => {\n        Array::push(out, (pname, tn))\n        if tn == \"Array\" && Array::length(targs) == 1 {\n          match Array::get(targs, 0) {\n            TyName(elem) => Array::push(out, (array_elem_key(pname), elem)),\n            _ => ()\n          }\n        }\n      },\n      _ => ()\n    }\n    i = i + 1\n  }\n  out\n}\n\nfn fn_body_tail_expr(e: Expr) -> Expr {\n  match e {\n    ELet(_, _, rest, _) => fn_body_tail_expr(rest),\n    ELetMut(_, _, rest, _) => fn_body_tail_expr(rest),\n    ELetRec(_, _, rest) => fn_body_tail_expr(rest),\n    ESeq(_, rest) => fn_body_tail_expr(rest),\n    other => other\n  }\n}\n\nfn fn_return_head_of(ret: Option[TypeExpr], body: Expr) -> String {\n  match ret {\n    Some(te) => match te {\n      TyName(n) => n,\n      TyApp(n, _) => n,\n      TyFn(_, _, _) => fn_type_return_head(),\n      _ => \"\"\n    },\n    None => match fn_body_tail_expr(body) {\n      EFn(_, _, _, _, _, _) => fn_type_return_head(),\n      _ => \"\"\n    }\n  }\n}\n\nfn struct_field_type_key(struct_name: String, field: String) -> String {\n  String::concat(struct_name, String::concat(\".\", field))\n}\n\nfn collect_struct_field_types(stmts: Array[Stmt], out: Array[(String, String)]) -> Unit {\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SStruct(_, sname, fields, _, _, _) => {\n        let mut j = 0\n        while j < Array::length(fields) {\n          let (fname, fty) = Array::get(fields, j)\n          let head = match fty {\n            TyName(n) => n,\n            TyApp(n, _) => n,\n            _ => \"\"\n          }\n          if String::length(head) > 0 {\n            Array::push(out, (struct_field_type_key(sname, fname), head))\n          } else {\n            ()\n          }\n          j = j + 1\n        }\n      },\n      SModule(_, _, inner) => collect_struct_field_types(inner, out),\n      _ => ()\n    }\n    i = i + 1\n  }\n}\n\nfn collect_fn_returns(stmts: Array[Stmt]) -> Array[(String, String)] {\n  let out = array_empty()\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SLet(_, _, fname, _, body) => match body {\n        EFn(_, _, _, ret, _, fbody) => {\n          Array::push(out, (fname, fn_return_head_of(ret, fbody)))\n        },\n        _ => ()\n      },\n      SFnDecl(_, fname, body, _, _) => match body {\n        EFn(_, _, _, ret, _, fbody) => {\n          Array::push(out, (fname, fn_return_head_of(ret, fbody)))\n        },\n        _ => ()\n      },\n      SEnum(_, ename, _, variants, _) => {\n        let mut vi = 0\n        while vi < Array::length(variants) {\n          let (vname, _) = Array::get(variants, vi)\n          Array::push(out, (vname, ename))\n          vi = vi + 1\n        }\n      },\n      _ => ()\n    }\n    i = i + 1\n  }\n  collect_struct_field_types(stmts, out)\n  let names = array_empty()\n  let mut ni = 0\n  while ni < Array::length(out) {\n    let (n, _) = Array::get(out, ni)\n    Array::push(names, n)\n    ni = ni + 1\n  }\n  let perm = sort_perm_by_names(names)\n  let sorted = array_empty()\n  let mut pi = 0\n  while pi < Array::length(perm) {\n    Array::push(sorted, Array::get(out, Array::get(perm, pi)))\n    pi = pi + 1\n  }\n  sorted\n}\n\nfn fn_returns_find(fn_returns: Array[(String, String)], fname: String) -> Int {\n  let mut lo = 0\n  let mut hi = Array::length(fn_returns)\n  while lo < hi {\n    let mid = (lo + hi) / 2\n    let (n, _) = Array::get(fn_returns, mid)\n    if str_lt(n, fname) {\n      lo = mid + 1\n    } else {\n      hi = mid\n    }\n  }\n  let mut res = -1\n  if lo < Array::length(fn_returns) {\n    let (n2, _) = Array::get(fn_returns, lo)\n    if n2 == fname {\n      res = lo\n    }\n  }\n  res\n}\n\nfn fn_exists(fn_returns: Array[(String, String)], fname: String) -> Bool {\n  fn_returns_find(fn_returns, fname) >= 0\n}\n\nfn fn_type_return_head() -> String {\n  \"->\"\n}\n\nfn fn_return_type(fn_returns: Array[(String, String)], fname: String) -> Option[String] {\n  let idx = fn_returns_find(fn_returns, fname)\n  if idx < 0 {\n    None\n  } else {\n    let (_, rt) = Array::get(fn_returns, idx)\n    if String::length(rt) == 0 || rt == fn_type_return_head() {\n      None\n    } else {\n      Some(rt)\n    }\n  }\n}\n\nfn fn_return_is_fn_type(fn_returns: Array[(String, String)], fname: String) -> Bool {\n  let idx = fn_returns_find(fn_returns, fname)\n  if idx < 0 {\n    false\n  } else {\n    let (_, rt) = Array::get(fn_returns, idx)\n    rt == fn_type_return_head()\n  }\n}\n\nfn build_iter_for_with(name: String, nextcall: Expr, iter: Expr, body: Expr) -> Expr {\n  let some_arm = (PCtor(\"Some\", [\n    PTuple([\n      PBind(name),\n      PBind(\"__iter_rest\")\n    ])\n  ]), EAssign(\"__iter_cur\", EIdent(\"__iter_rest\", -1), body))\n  let none_arm = (PCtor(\"None\", array_empty()), EAssign(\"__iter_go\", EBool(false), EUnit))\n  let loop_body = EMatch(nextcall, [\n    some_arm,\n    none_arm\n  ])\n  ELet(\"__iter_src\", iter, ELetMut(\"__iter_cur\", EIdent(\"__iter_src\", -1), ELetMut(\"__iter_go\", EBool(true), EWhile(EIdent(\"__iter_go\", -1), loop_body), -1), -1), -1)\n}\n\nfn next_call_for(ctype: String) -> Expr {\n  ECall(EIdent(String::concat(ctype, \"::next\"), -1), [\n    EIdent(\"__iter_cur\", -1)\n  ], -1)\n}\n\nfn build_iter_for(name: String, ctype: String, iter: Expr, body: Expr) -> Expr {\n  build_iter_for_with(name, next_call_for(ctype), iter, body)\n}\n\nfn build_indexed_iter_for(name: String, idx: Option[String], ctype: String, iter: Expr, body: Expr) -> Expr {\n  let get_call = ECall(EIdent(String::concat(ctype, \"::iter_get\"), -1), [\n    EIdent(\"__iter_src\", -1),\n    EIdent(\"__iter_i\", -1)\n  ], -1)\n  let len_call = ECall(EIdent(String::concat(ctype, \"::iter_length\"), -1), [\n    EIdent(\"__iter_src\", -1)\n  ], -1)\n  let incr = EAssign(\"__iter_i\", EBinOp(\"+\", EIdent(\"__iter_i\", -1), EInt(1)), EUnit)\n  let bound_body = match idx {\n    Some(iname) => ELet(iname, EIdent(\"__iter_i\", -1), body, -1),\n    None => body\n  }\n  let loop_body = ELet(name, get_call, ESeq(bound_body, incr), -1)\n  ELet(\"__iter_src\", iter, ELet(\"__iter_n\", len_call, ELetMut(\"__iter_i\", EInt(0), EWhile(EBinOp(\"<\", EIdent(\"__iter_i\", -1), EIdent(\"__iter_n\", -1)), loop_body), -1), -1), -1)\n}\n\nfn build_host_stream_for(name: String, iter: Expr, body: Expr) -> Expr {\n  let read_call = ECall(EIdent(\"host_stream_next\", -1), [\n    EIdent(\"__hs_src\", -1)\n  ], -1)\n  let advance = EAssign(\"__hs_b\", read_call, EUnit)\n  let loop_body = ELet(name, EIdent(\"__hs_b\", -1), ESeq(body, advance), -1)\n  ELet(\"__hs_src\", iter, ELetMut(\"__hs_b\", read_call, EWhile(EBinOp(\"<=\", EInt(0), EIdent(\"__hs_b\", -1)), loop_body), -1), -1)\n}\n\nfn build_await_iter_for(name: String, ctype: String, iter: Expr, body: Expr) -> Expr {\n  let awaited = ECall(EIdent(\"await\", -1), [\n    next_call_for(ctype)\n  ], -1)\n  build_iter_for_with(name, awaited, iter, body)\n}\n\nfn build_pull_for_in(value_name: String, index_name: Option[String], iterable: Expr, body: Expr) -> Expr {\n  let some_arm = match index_name {\n    Some(ix) => ESeq(body, EAssign(ix, EBinOp(\"+\", EIdent(ix, -1), EInt(1)), EUnit)),\n    None => ESeq(body, EUnit)\n  }\n  let loop_body = EMatch(ECall(EIdent(\"__pull_next\", -1), array_empty(), -1), [\n    (PCtor(\"Some\", [\n      PBind(value_name)\n    ]), some_arm),\n    (PCtor(\"None\", array_empty()), EAssign(\"__pull_continue\", EBool(false), EUnit))\n  ])\n  let core_loop = ELetMut(\"__pull_continue\", EBool(true), EWhile(EIdent(\"__pull_continue\", -1), loop_body), -1)\n  let with_index = match index_name {\n    Some(ix) => ELetMut(ix, EInt(0), core_loop, -1),\n    None => core_loop\n  }\n  ELet(\"__pull_next\", iterable, with_index, -1)\n}\n\nfn fn_return_is_future(fn_returns: Array[(String, String)], fname: String) -> Bool {\n  match fn_return_type(fn_returns, fname) {\n    Some(head) => head == \"Future\",\n    None => false\n  }\n}\n\nfn for_await_is_pull_source(inner: Expr, fn_returns: Array[(String, String)]) -> Bool {\n  match inner {\n    EFn(_, _, _, _, _, _) => true,\n    ECall(callee, _, _) => match callee {\n      EIdent(fname, _) => fn_return_is_fn_type(fn_returns, fname),\n      _ => false\n    },\n    _ => false\n  }\n}\n\nfn classify_trait_free_for_loop(name: String, idx: Option[String], iter: Expr, riter: Expr, rbody: Expr, struct_sets: Array[(String, Array[String])], var_types: Array[(String, String)], fn_returns: Array[(String, String)]) -> Expr {\n  match infer_arg_type_name(iter, struct_sets, var_types, fn_returns) {\n    Some(tn) => if tn == \"HostStream\" {\n      build_host_stream_for(name, riter, rbody)\n    } else if fn_exists(fn_returns, String::concat(tn, \"::next\")) && fn_return_is_future(fn_returns, String::concat(tn, \"::next\")) {\n      build_await_iter_for(name, tn, riter, rbody)\n    } else {\n      classify_indexed_for_loop(name, idx, iter, riter, rbody, struct_sets, var_types, fn_returns)\n    },\n    None => if for_await_is_pull_source(iter, fn_returns) {\n      build_pull_for_in(name, idx, riter, rbody)\n    } else {\n      EForIn(name, idx, riter, rbody)\n    }\n  }\n}\n\nfn classify_indexed_for_loop(name: String, idx: Option[String], iter: Expr, riter: Expr, rbody: Expr, struct_sets: Array[(String, Array[String])], var_types: Array[(String, String)], fn_returns: Array[(String, String)]) -> Expr {\n  match infer_arg_type_name(iter, struct_sets, var_types, fn_returns) {\n    Some(tn) => if struct_set_has(struct_sets, tn) && fn_exists(fn_returns, String::concat(tn, \"::iter_length\")) && fn_exists(fn_returns, String::concat(tn, \"::iter_get\")) {\n      build_indexed_iter_for(name, idx, tn, riter, rbody)\n    } else {\n      EForIn(name, idx, riter, rbody)\n    },\n    None => EForIn(name, idx, riter, rbody)\n  }\n}\n\nfn classify_sync_for_loop(name: String, idx: Option[String], iter: Expr, riter: Expr, rbody: Expr, struct_sets: Array[(String, Array[String])], var_types: Array[(String, String)], fn_returns: Array[(String, String)]) -> Expr {\n  match infer_arg_type_name(iter, struct_sets, var_types, fn_returns) {\n    Some(tn) => if tn == \"HostStream\" {\n      build_host_stream_for(name, riter, rbody)\n    } else if fn_exists(fn_returns, String::concat(tn, \"::next\")) {\n      if fn_return_is_future(fn_returns, String::concat(tn, \"::next\")) {\n        build_await_iter_for(name, tn, riter, rbody)\n      } else {\n        build_iter_for(name, tn, riter, rbody)\n      }\n    } else {\n      match fn_return_type(fn_returns, String::concat(tn, \"::iter\")) {\n        Some(itertype) => build_iter_for(name, itertype, ECall(EIdent(String::concat(tn, \"::iter\"), -1), [\n          riter\n        ], -1), rbody),\n        None => classify_indexed_for_loop(name, idx, iter, riter, rbody, struct_sets, var_types, fn_returns)\n      }\n    },\n    None => if for_await_is_pull_source(iter, fn_returns) {\n      build_pull_for_in(name, idx, riter, rbody)\n    } else {\n      EForIn(name, idx, riter, rbody)\n    }\n  }\n}\n\nfn railway_bind_payload_type(val: Expr, struct_sets: Array[(String, Array[String])], var_types: Array[(String, String)], fn_returns: Array[(String, String)]) -> Option[String] {\n  match val {\n    ECall(callee, inner_args, _) => match callee {\n      EIdent(cname, _) => if (cname == \"Some\" || cname == \"Ok\") && Array::length(inner_args) == 1 {\n        infer_arg_type_name(Array::get(inner_args, 0), struct_sets, var_types, fn_returns)\n      } else {\n        None\n      },\n      _ => None\n    },\n    _ => None\n  }\n}\n\nfn extend_var_types(var_types: Array[(String, String)], name: String, inferred: Option[String]) -> Array[(String, String)] {\n  match inferred {\n    Some(tname) => {\n      let out = array_empty()\n      let mut i = 0\n      while i < Array::length(var_types) {\n        Array::push(out, Array::get(var_types, i))\n        i = i + 1\n      }\n      Array::push(out, (name, tname))\n      out\n    },\n    None => var_types\n  }\n}\n\nfn qual_ctor_member(head: String, member: String, struct_sets: Array[(String, Array[String])], fn_returns: Array[(String, String)]) -> Option[String] {\n  if struct_set_has(struct_sets, head) {\n    match fn_return_type(fn_returns, member) {\n      Some(en) => if en == head {\n        Some(member)\n      } else {\n        None\n      },\n      None => None\n    }\n  } else {\n    None\n  }\n}\n\nfn try_sentinel(callee: Expr, args: Array[Expr]) -> Int {\n  match callee {\n    EIdent(n, _) => if n == \"__try_bind\" {\n      if Array::length(args) == 2 {\n        match Array::get(args, 1) {\n          EFn(_, _, ps, _, _, _) => if Array::length(ps) == 1 {\n            0\n          } else {\n            2\n          },\n          _ => 2\n        }\n      } else {\n        2\n      }\n    } else if n == \"__try_op\" {\n      if Array::length(args) == 1 {\n        1\n      } else {\n        2\n      }\n    } else {\n      2\n    },\n    _ => 2\n  }\n}\n\nfn railway_val_off(e: Expr) -> Int {\n  match e {\n    EIdent(_, off) => off,\n    ECall(callee, _, off) => if off >= 0 {\n      off\n    } else {\n      railway_val_off(callee)\n    },\n    EDot(base, _, off, _) => if off >= 0 {\n      off\n    } else {\n      railway_val_off(base)\n    },\n    EBinOp(_, lhs, _) => railway_val_off(lhs),\n    _ => -1\n  }\n}\n\nfn lower_try_bind(val: Expr, name: String, rest: Expr, inferred: Option[String]) -> Expr {\n  let voff = railway_val_off(val)\n  match inferred {\n    Some(tn) => if tn == \"Option\" {\n      EMatch(val, [\n        (PCtor(\"Some\", [\n          PBind(name)\n        ]), rest),\n        (PCtor(\"None\", array_empty()), EIdent(\"None\", voff))\n      ])\n    } else {\n      EMatch(val, [\n        (PCtor(\"Ok\", [\n          PBind(name)\n        ]), rest),\n        (PCtor(\"Err\", [\n          PBind(\"__bind_err\")\n        ]), ECall(EIdent(\"Err\", voff), [\n          EIdent(\"__bind_err\", -1)\n        ], voff))\n      ])\n    },\n    None => EMatch(val, [\n      (PCtor(\"Ok\", [\n        PBind(name)\n      ]), rest),\n      (PCtor(\"Err\", [\n        PBind(\"__bind_err\")\n      ]), ECall(EIdent(\"Err\", voff), [\n        EIdent(\"__bind_err\", -1)\n      ], voff))\n    ])\n  }\n}\n\nfn lower_try_op(val: Expr, inferred: Option[String]) -> Expr {\n  let voff = railway_val_off(val)\n  match inferred {\n    Some(tn) => if tn == \"Option\" {\n      EMatch(val, [\n        (PCtor(\"Some\", [\n          PBind(\"__try_v\")\n        ]), EIdent(\"__try_v\", -1)),\n        (PCtor(\"None\", array_empty()), EReturn(EIdent(\"None\", voff)))\n      ])\n    } else {\n      EMatch(val, [\n        (PCtor(\"Ok\", [\n          PBind(\"__try_v\")\n        ]), EIdent(\"__try_v\", -1)),\n        (PCtor(\"Err\", [\n          PBind(\"__try_e\")\n        ]), EReturn(ECall(EIdent(\"Err\", voff), [\n          EIdent(\"__try_e\", -1)\n        ], voff)))\n      ])\n    },\n    None => EMatch(val, [\n      (PCtor(\"Ok\", [\n        PBind(\"__try_v\")\n      ]), EIdent(\"__try_v\", -1)),\n      (PCtor(\"Err\", [\n        PBind(\"__try_e\")\n      ]), EReturn(ECall(EIdent(\"Err\", voff), [\n        EIdent(\"__try_e\", -1)\n      ], voff)))\n    ])\n  }\n}\n\nfn railway_rw(expr: Expr, struct_sets: Array[(String, Array[String])], var_types: Array[(String, String)], fn_returns: Array[(String, String)]) -> Expr {\n  match expr {\n    ECall(callee, args, off) => {\n      let k = try_sentinel(callee, args)\n      if k == 0 {\n        let val = Array::get(args, 0)\n        match Array::get(args, 1) {\n          EFn(_, _, ps, _, _, rest) => {\n            let (name, _) = Array::get(ps, 0)\n            let rwval = railway_rw(val, struct_sets, var_types, fn_returns)\n            let inferred = infer_arg_type_name(val, struct_sets, var_types, fn_returns)\n            let body_vars = extend_var_types(var_types, name, railway_bind_payload_type(val, struct_sets, var_types, fn_returns))\n            let rwrest = railway_rw(rest, struct_sets, body_vars, fn_returns)\n            lower_try_bind(rwval, name, rwrest, inferred)\n          },\n          _ => EUnit\n        }\n      } else if k == 1 {\n        let val = Array::get(args, 0)\n        let rwval = railway_rw(val, struct_sets, var_types, fn_returns)\n        lower_try_op(rwval, infer_arg_type_name(val, struct_sets, var_types, fn_returns))\n      } else {\n        let rwargs = for a in args {\n          railway_rw(a, struct_sets, var_types, fn_returns)\n        }\n        match map_index_rewrite(callee, args, rwargs, struct_sets, var_types, fn_returns) {\n          Some(map_get) => map_get,\n          None => ECall(railway_rw(callee, struct_sets, var_types, fn_returns), rwargs, off)\n        }\n      }\n    },\n    EInt(_) => expr,\n    EFloat(_) => expr,\n    EString(_) => expr,\n    EBool(_) => expr,\n    EUnit => expr,\n    ESpread(e) => ESpread(railway_rw(e, struct_sets, var_types, fn_returns)),\n    EStringInterp(_) => expr,\n    EIdent(_, _) => expr,\n    ETuple(elems) => ETuple(for e in elems {\n      railway_rw(e, struct_sets, var_types, fn_returns)\n    }),\n    EArray(elems) => EArray(for e in elems {\n      railway_rw(e, struct_sets, var_types, fn_returns)\n    }),\n    ERecord(rn, fields, targs) => {\n      let out = array_empty()\n      let mut i = 0\n      while i < Array::length(fields) {\n        let (fname, fval) = Array::get(fields, i)\n        Array::push(out, (fname, railway_rw(fval, struct_sets, var_types, fn_returns)))\n        i = i + 1\n      }\n      ERecord(rn, out, targs)\n    },\n    EMap(fields) => {\n      let out = array_empty()\n      let mut i = 0\n      while i < Array::length(fields) {\n        let (k, v) = Array::get(fields, i)\n        Array::push(out, (k, railway_rw(v, struct_sets, var_types, fn_returns)))\n        i = i + 1\n      }\n      EMap(out)\n    },\n    EIf(c, t, e) => EIf(railway_rw(c, struct_sets, var_types, fn_returns), railway_rw(t, struct_sets, var_types, fn_returns), railway_rw(e, struct_sets, var_types, fn_returns)),\n    ELet(name, val, body, soff) => {\n      let new_val = railway_rw(val, struct_sets, var_types, fn_returns)\n      let body_vars = extend_var_types(var_types, name, anon_or_infer(val, struct_sets, var_types, fn_returns))\n      ELet(name, new_val, railway_rw(body, struct_sets, body_vars, fn_returns), soff)\n    },\n    ELetRec(name, val, body) => ELetRec(name, railway_rw(val, struct_sets, var_types, fn_returns), railway_rw(body, struct_sets, var_types, fn_returns)),\n    ELetMut(name, val, body, soff) => {\n      let new_val = railway_rw(val, struct_sets, var_types, fn_returns)\n      let body_vars = extend_var_types(var_types, name, anon_or_infer(val, struct_sets, var_types, fn_returns))\n      ELetMut(name, new_val, railway_rw(body, struct_sets, body_vars, fn_returns), soff)\n    },\n    EAssign(name, val, cont) => EAssign(name, railway_rw(val, struct_sets, var_types, fn_returns), railway_rw(cont, struct_sets, var_types, fn_returns)),\n    EAssignOp(name, op, val, cont) => EAssignOp(name, op, railway_rw(val, struct_sets, var_types, fn_returns), railway_rw(cont, struct_sets, var_types, fn_returns)),\n    ESeq(a, b) => ESeq(railway_rw(a, struct_sets, var_types, fn_returns), railway_rw(b, struct_sets, var_types, fn_returns)),\n    EMatch(scrut, arms) => {\n      let out = array_empty()\n      let mut i = 0\n      while i < Array::length(arms) {\n        let (p, b) = Array::get(arms, i)\n        Array::push(out, (p, railway_rw(b, struct_sets, var_types, fn_returns)))\n        i = i + 1\n      }\n      EMatch(railway_rw(scrut, struct_sets, var_types, fn_returns), out)\n    },\n    EHandle(scrut, arms) => {\n      let out = array_empty()\n      let mut i = 0\n      while i < Array::length(arms) {\n        let (p, b) = Array::get(arms, i)\n        Array::push(out, (p, railway_rw(b, struct_sets, var_types, fn_returns)))\n        i = i + 1\n      }\n      EHandle(railway_rw(scrut, struct_sets, var_types, fn_returns), out)\n    },\n    EWhile(c, b) => EWhile(railway_rw(c, struct_sets, var_types, fn_returns), railway_rw(b, struct_sets, var_types, fn_returns)),\n    ELoop(params, body) => ELoop(for param in params {\n      let (name, init) = param\n      (name, railway_rw(init, struct_sets, var_types, fn_returns))\n    }, railway_rw(body, struct_sets, var_types, fn_returns)),\n    EForIn(name, idx, iter, body) => EForIn(name, idx, railway_rw(iter, struct_sets, var_types, fn_returns), railway_rw(body, struct_sets, var_types, fn_returns)),\n    EBinOp(op, l, r) => EBinOp(op, railway_rw(l, struct_sets, var_types, fn_returns), railway_rw(r, struct_sets, var_types, fn_returns)),\n    EUnaryOp(op, e) => EUnaryOp(op, railway_rw(e, struct_sets, var_types, fn_returns)),\n    EFn(tp, bs, ps, ret, eff, body) => EFn(tp, bs, ps, ret, eff, railway_rw(body, struct_sets, seed_var_types(ps, tp, var_types), fn_returns)),\n    EDot(obj, field, off, fdoff) => {\n      let robj = railway_rw(obj, struct_sets, var_types, fn_returns)\n      match anon_dot_rewrite(obj, field, off, robj, var_types) {\n        Some(rw) => rw,\n        None => EDot(robj, field, off, fdoff)\n      }\n    },\n    ELabeledArg(label, name, body) => ELabeledArg(label, name, railway_rw(body, struct_sets, var_types, fn_returns)),\n    EReturn(e) => EReturn(railway_rw(e, struct_sets, var_types, fn_returns)),\n    EBreak(opt) => match opt {\n      Some(e) => EBreak(Some(railway_rw(e, struct_sets, var_types, fn_returns))),\n      None => expr\n    },\n    EContinue(exprs) => EContinue(for e in exprs {\n      railway_rw(e, struct_sets, var_types, fn_returns)\n    })\n  }\n}\n\nfn collect_toplevel_anon_records(stmts: Array[Stmt], struct_sets: Array[(String, Array[String])]) -> Array[(String, String)] {\n  let out = array_empty()\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SLet(_, _, name, _, val) => match anon_record_inferred(val, struct_sets) {\n        Some(sentinel) => Array::push(out, (name, sentinel)),\n        None => ()\n      },\n      _ => ()\n    }\n    i = i + 1\n  }\n  out\n}\n\nfn railway_rw_stmt(s: Stmt, struct_sets: Array[(String, Array[String])], fn_returns: Array[(String, String)], toplevel_vars: Array[(String, String)]) -> Stmt {\n  match s {\n    SLet(exp, isrec, fname, ann, body) => SLet(exp, isrec, fname, ann, railway_rw(body, struct_sets, toplevel_vars, fn_returns)),\n    SLetMut(name, ty, e) => SLetMut(name, ty, railway_rw(e, struct_sets, toplevel_vars, fn_returns)),\n    STest(name, body) => STest(name, railway_rw(body, struct_sets, toplevel_vars, fn_returns)),\n    SBench(name, body) => SBench(name, railway_rw(body, struct_sets, toplevel_vars, fn_returns)),\n    SExpr(e) => SExpr(railway_rw(e, struct_sets, toplevel_vars, fn_returns)),\n    SModule(exp, name, body) => SModule(exp, name, for inner in body {\n      railway_rw_stmt(inner, struct_sets, fn_returns, toplevel_vars)\n    }),\n    _ => s\n  }\n}\n\nexport fn desugar_railway_binds(stmts: Array[Stmt]) -> Unit {\n  let struct_sets = collect_struct_field_sets(stmts)\n  let fn_returns = collect_fn_returns(stmts)\n  let toplevel_vars = collect_toplevel_anon_records(stmts, struct_sets)\n  let mut i = 0\n  while i < Array::length(stmts) {\n    Array::set(stmts, i, railway_rw_stmt(Array::get(stmts, i), struct_sets, fn_returns, toplevel_vars))\n    i = i + 1\n  }\n}\n\n\nlet dtd_show_self_fn = [\n  \"\"\n]\n\nfn show_self_fn_set(name: String) -> Unit {\n  Array::set(dtd_show_self_fn, 0, name)\n}\n\nfn is_interp_to_string_call(callee: Expr, args: Array[Expr]) -> Bool {\n  match callee {\n    EIdent(n, _) => n == \"__to_string\" && Array::length(args) == 1,\n    _ => false\n  }\n}\n\nfn interp_show_target(arg: Expr, struct_sets: Array[(String, Array[String])], var_types: Array[(String, String)], fn_returns: Array[(String, String)]) -> String {\n  match infer_arg_type_name(arg, struct_sets, var_types, fn_returns) {\n    Some(tn) => {\n      let target = String::concat(tn, \"::to_string\")\n      if !is_scalar_type_name(tn) && fn_exists(fn_returns, target) && target != Array::get(dtd_show_self_fn, 0) {\n        target\n      } else {\n        \"\"\n      }\n    },\n    None => \"\"\n  }\n}\n\n\nlet dtd_show_tmp = [\n  0\n]\n\nfn show_tmp_name() -> String {\n  let n = Array::get(dtd_show_tmp, 0)\n  Array::set(dtd_show_tmp, 0, n + 1)\n  String::concat(\"__show_v\", __to_string(n))\n}\n\nfn interp_render_sub(sub: Expr, gens: Array[(String, Array[(String, String, Int)])], traits: Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], struct_sets: Array[(String, Array[String])], dict_binds: Array[(String, String, String, Array[String])], var_types: Array[(String, String)], fn_returns: Array[(String, String)]) -> Expr with { Error } {\n  rewrite_expr(ECall(EIdent(\"__to_string\", -1), Array::slice([\n    sub\n  ], 0, 1), -1), gens, traits, struct_sets, dict_binds, var_types, fn_returns)\n}\n\nfn interp_join(items: Array[Expr], open_s: String, sep: String, close_s: String, gens: Array[(String, Array[(String, String, Int)])], traits: Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], struct_sets: Array[(String, Array[String])], dict_binds: Array[(String, String, String, Array[String])], var_types: Array[(String, String)], fn_returns: Array[(String, String)]) -> Expr with { Error } {\n  let mut acc = EString(open_s)\n  let mut i = 0\n  while i < Array::length(items) {\n    let piece = interp_render_sub(Array::get(items, i), gens, traits, struct_sets, dict_binds, var_types, fn_returns)\n    acc = if i == 0 {\n      concat2(acc, piece)\n    } else {\n      concat2(concat2(acc, EString(sep)), piece)\n    }\n    i = i + 1\n  }\n  concat2(acc, EString(close_s))\n}\n\nfn interp_wrap1(ctor: String, payload: Expr, gens: Array[(String, Array[(String, String, Int)])], traits: Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], struct_sets: Array[(String, Array[String])], dict_binds: Array[(String, String, String, Array[String])], var_types: Array[(String, String)], fn_returns: Array[(String, String)]) -> Expr with { Error } {\n  concat2(EString(String::concat(ctor, \"(\")), concat2(interp_render_sub(payload, gens, traits, struct_sets, dict_binds, var_types, fn_returns), EString(\")\")))\n}\n\nfn interp_expand_by_head(arg: Expr, head: String, gens: Array[(String, Array[(String, String, Int)])], traits: Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], struct_sets: Array[(String, Array[String])], dict_binds: Array[(String, String, String, Array[String])], var_types: Array[(String, String)], fn_returns: Array[(String, String)]) -> Option[Expr] with { Error } {\n  if head == \"Option\" {\n    let v = show_tmp_name()\n    Some(EMatch(rewrite_expr(arg, gens, traits, struct_sets, dict_binds, var_types, fn_returns), Array::slice([\n      (PCtor(\"Some\", Array::slice([\n        PBind(v)\n      ], 0, 1)), interp_wrap1(\"Some\", EIdent(v, -1), gens, traits, struct_sets, dict_binds, var_types, fn_returns)),\n      (PCtor(\"None\", array_empty()), EString(\"None\"))\n    ], 0, 2)))\n  } else if head == \"Result\" {\n    let ov = show_tmp_name()\n    let ev = show_tmp_name()\n    Some(EMatch(rewrite_expr(arg, gens, traits, struct_sets, dict_binds, var_types, fn_returns), Array::slice([\n      (PCtor(\"Ok\", Array::slice([\n        PBind(ov)\n      ], 0, 1)), interp_wrap1(\"Ok\", EIdent(ov, -1), gens, traits, struct_sets, dict_binds, var_types, fn_returns)),\n      (PCtor(\"Err\", Array::slice([\n        PBind(ev)\n      ], 0, 1)), interp_wrap1(\"Err\", EIdent(ev, -1), gens, traits, struct_sets, dict_binds, var_types, fn_returns))\n    ], 0, 2)))\n  } else {\n    None\n  }\n}\n\nfn interp_expand(arg: Expr, gens: Array[(String, Array[(String, String, Int)])], traits: Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], struct_sets: Array[(String, Array[String])], dict_binds: Array[(String, String, String, Array[String])], var_types: Array[(String, String)], fn_returns: Array[(String, String)]) -> Option[Expr] with { Error } {\n  let head = match infer_arg_type_name(arg, struct_sets, var_types, fn_returns) {\n    Some(h) => h,\n    None => \"\"\n  }\n  match arg {\n    ETuple(items) => Some(interp_join(items, \"(\", \", \", \")\", gens, traits, struct_sets, dict_binds, var_types, fn_returns)),\n    EArray(items) => Some(interp_join(items, \"[\", \", \", \"]\", gens, traits, struct_sets, dict_binds, var_types, fn_returns)),\n    EIdent(n, _) => if n == \"None\" && head == \"Option\" {\n      Some(EString(\"None\"))\n    } else {\n      interp_expand_by_head(arg, head, gens, traits, struct_sets, dict_binds, var_types, fn_returns)\n    },\n    ECall(callee, cargs, _) => match callee {\n      EIdent(cn, _) => if Array::length(cargs) == 1 && ((head == \"Option\" && cn == \"Some\") || (head == \"Result\" && (cn == \"Ok\" || cn == \"Err\"))) {\n        Some(interp_wrap1(cn, Array::get(cargs, 0), gens, traits, struct_sets, dict_binds, var_types, fn_returns))\n      } else {\n        interp_expand_by_head(arg, head, gens, traits, struct_sets, dict_binds, var_types, fn_returns)\n      },\n      _ => interp_expand_by_head(arg, head, gens, traits, struct_sets, dict_binds, var_types, fn_returns)\n    },\n    _ => interp_expand_by_head(arg, head, gens, traits, struct_sets, dict_binds, var_types, fn_returns)\n  }\n}\n\nfn interp_has_repl(r: Option[Expr]) -> Bool {\n  match r {\n    Some(_) => true,\n    None => false\n  }\n}\n\nfn interp_take_repl(r: Option[Expr]) -> Expr {\n  match r {\n    Some(e) => e,\n    None => EUnit\n  }\n}\n\nfn rewrite_expr(expr: Expr, gens: Array[(String, Array[(String, String, Int)])], traits: Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], struct_sets: Array[(String, Array[String])], dict_binds: Array[(String, String, String, Array[String])], var_types: Array[(String, String)], fn_returns: Array[(String, String)]) -> Expr with { Error } {\n  match expr {\n    EIdent(name, off) => match split_qualified(name) {\n      Some(parts) => {\n        let (head, member) = parts\n        match find_dict_for_method(dict_binds, head, member) {\n          Some(dict_pname) => EDot(EIdent(dict_pname, -1), member, -1, -1),\n          None => match qual_ctor_member(head, member, struct_sets, fn_returns) {\n            Some(m) => EIdent(m, off),\n            None => expr\n          }\n        }\n      },\n      None => expr\n    },\n    ECall(callee, args, off) => {\n      let try_kind = try_sentinel(callee, args)\n      let interp_repl = if is_interp_to_string_call(callee, args) {\n        let show_target = interp_show_target(Array::get(args, 0), struct_sets, var_types, fn_returns)\n        if show_target != \"\" {\n          Some(ECall(EIdent(show_target, -1), Array::slice([\n            rewrite_expr(Array::get(args, 0), gens, traits, struct_sets, dict_binds, var_types, fn_returns)\n          ], 0, 1), off))\n        } else {\n          interp_expand(Array::get(args, 0), gens, traits, struct_sets, dict_binds, var_types, fn_returns)\n        }\n      } else {\n        None\n      }\n      if try_kind == 0 {\n        let val = Array::get(args, 0)\n        match Array::get(args, 1) {\n          EFn(_, _, ps, _, _, rest) => {\n            let (name, _) = Array::get(ps, 0)\n            let rwval = rewrite_expr(val, gens, traits, struct_sets, dict_binds, var_types, fn_returns)\n            let inferred = infer_arg_type_name(val, struct_sets, var_types, fn_returns)\n            let body_vars = extend_var_types(var_types, name, railway_bind_payload_type(val, struct_sets, var_types, fn_returns))\n            let rwrest = rewrite_expr(rest, gens, traits, struct_sets, dict_binds, body_vars, fn_returns)\n            lower_try_bind(rwval, name, rwrest, inferred)\n          },\n          _ => EUnit\n        }\n      } else if try_kind == 1 {\n        let val = Array::get(args, 0)\n        let rwval = rewrite_expr(val, gens, traits, struct_sets, dict_binds, var_types, fn_returns)\n        lower_try_op(rwval, infer_arg_type_name(val, struct_sets, var_types, fn_returns))\n      } else if interp_has_repl(interp_repl) {\n        interp_take_repl(interp_repl)\n      } else if !exn_kind_suppressed() && is_exception_kind_read(callee, args) {\n        exn_kind_mark_used()\n        exn_kind_read_expr()\n      } else if !exn_kind_suppressed() && is_exception_message_read(callee, args) {\n        exn_kind_mark_used()\n        exn_msg_read_expr()\n      } else if !exn_kind_suppressed() && is_perform_throw_shape(callee, args) {\n        let kind = match infer_arg_type_name(perform_throw_payload(args), struct_sets, var_types, fn_returns) {\n          Some(k) => k,\n          None => \"\"\n        }\n        let rwargs = for a in args {\n          rewrite_expr(a, gens, traits, struct_sets, dict_binds, var_types, fn_returns)\n        }\n        exn_kind_mark_used()\n        let pname = exn_kind_fresh_payload_name()\n        let render_vars = if kind == \"\" {\n          var_types\n        } else {\n          extend_var_types(var_types, pname, Some(kind))\n        }\n        let render_target = interp_show_target(EIdent(pname, -1), struct_sets, render_vars, fn_returns)\n        let rendered = if render_target != \"\" {\n          Some(ECall(EIdent(render_target, -1), Array::slice([\n            EIdent(pname, -1)\n          ], 0, 1), -1))\n        } else {\n          interp_expand(EIdent(pname, -1), gens, traits, struct_sets, dict_binds, render_vars, fn_returns)\n        }\n        let msg_write = exn_msg_write_expr(if interp_has_repl(rendered) {\n          interp_take_repl(rendered)\n        } else {\n          EString(\"\")\n        })\n        ELet(pname, perform_throw_payload(rwargs), ESeq(exn_kind_write_expr(kind), ESeq(msg_write, ECall(callee, perform_throw_with_payload(rwargs, EIdent(pname, -1)), off))), -1)\n      } else {\n        let rwargs = for a in args {\n          rewrite_expr(a, gens, traits, struct_sets, dict_binds, var_types, fn_returns)\n        }\n        match map_index_rewrite(callee, args, rwargs, struct_sets, var_types, fn_returns) {\n          Some(map_get) => map_get,\n          None =>\n          match callee {\n            EIdent(name0, coff) => {\n              let name_ctor = match split_qualified(name0) {\n                Some(parts0) => {\n                  let (h0, m0) = parts0\n                  match qual_ctor_member(h0, m0, struct_sets, fn_returns) {\n                    Some(mm) => mm,\n                    None => name0\n                  }\n                },\n                None => name0\n              }\n              let name = if String::index_of(name_ctor, \"::\") < 0 && !fn_exists(fn_returns, name_ctor) && Array::length(args) >= 1 {\n                match infer_arg_type_name(Array::get(args, 0), struct_sets, var_types, fn_returns) {\n                  Some(tn) => {\n                    let qual = String::concat(tn, String::concat(\"::\", name_ctor))\n                    if struct_set_has(struct_sets, tn) && fn_exists(fn_returns, qual) {\n                      qual\n                    } else {\n                      name_ctor\n                    }\n                  },\n                  None => name_ctor\n                }\n              } else {\n                name_ctor\n              }\n              let as_method = match split_qualified(name) {\n                Some(parts) => {\n                  let (head, member) = parts\n                  find_dict_for_method(dict_binds, head, member)\n                },\n                None => None\n              }\n              match as_method {\n                Some(dict_pname) => ECall(EDot(EIdent(dict_pname, -1), member_of(name), -1, -1), rwargs, off),\n                None => match lookup_gen(gens, name) {\n                  Some(threaded) => match synth_dicts(threaded, args, traits, struct_sets, var_types, dict_binds, fn_returns, gens) {\n                    Some(dicts) => ECall(EIdent(name, coff), concat_expr_arrays(dicts, rwargs), off),\n                    None => ECall(EIdent(name, coff), rwargs, off)\n                  },\n                  None => ECall(EIdent(name, coff), rwargs, off)\n                }\n              }\n            },\n            EDot(obj, m, doff, fdoff) => {\n              let robj = rewrite_expr(obj, gens, traits, struct_sets, dict_binds, var_types, fn_returns)\n              let recv_tn = infer_arg_type_name(obj, struct_sets, var_types, fn_returns)\n              let as_tparam_dict = match recv_tn {\n                Some(tn) => find_dict_for_method(dict_binds, tn, m),\n                None => None\n              }\n              let as_recv_method = match as_tparam_dict {\n                Some(_) => None,\n                None => match recv_tn {\n                  Some(tn) => {\n                    let qual = String::concat(tn, String::concat(\"::\", m))\n                    let is_field = struct_set_member(struct_sets, tn, m)\n                    if !is_field && fn_exists(fn_returns, qual) {\n                      Some(qual)\n                    } else {\n                      None\n                    }\n                  },\n                  None => None\n                }\n              }\n              match as_tparam_dict {\n                Some(dict_pname) => ECall(EDot(EIdent(dict_pname, -1), m, -1, -1), prepend_expr(robj, rwargs), off),\n                None => match as_recv_method {\n                  Some(qual) => match lookup_gen(gens, qual) {\n                    Some(threaded) => match synth_dicts(threaded, prepend_expr(obj, args), traits, struct_sets, var_types, dict_binds, fn_returns, gens) {\n                      Some(dicts) => ECall(EIdent(qual, doff), concat_expr_arrays(dicts, prepend_expr(robj, rwargs)), off),\n                      None => ECall(EIdent(qual, doff), prepend_expr(robj, rwargs), off)\n                    },\n                    None => ECall(EIdent(qual, doff), prepend_expr(robj, rwargs), off)\n                  },\n                  None => ECall(EDot(robj, m, doff, fdoff), rwargs, off)\n                }\n              }\n            },\n            _ => ECall(rewrite_expr(callee, gens, traits, struct_sets, dict_binds, var_types, fn_returns), rwargs, off)\n          }\n        }\n      }\n    },\n    EInt(_) => expr,\n    EFloat(_) => expr,\n    EString(_) => expr,\n    EBool(_) => expr,\n    EUnit => expr,\n    ESpread(_) => expr,\n    EStringInterp(_) => expr,\n    ETuple(elems) => ETuple(for e in elems {\n      rewrite_expr(e, gens, traits, struct_sets, dict_binds, var_types, fn_returns)\n    }),\n    EArray(elems) => EArray(for e in elems {\n      rewrite_expr(e, gens, traits, struct_sets, dict_binds, var_types, fn_returns)\n    }),\n    ERecord(rn, fields, targs) => {\n      let out = array_empty()\n      let mut i = 0\n      while i < Array::length(fields) {\n        let (fname, fval) = Array::get(fields, i)\n        Array::push(out, (fname, rewrite_expr(fval, gens, traits, struct_sets, dict_binds, var_types, fn_returns)))\n        i = i + 1\n      }\n      ERecord(rn, out, targs)\n    },\n    EMap(fields) => {\n      let out = array_empty()\n      let mut i = 0\n      while i < Array::length(fields) {\n        let (k, v) = Array::get(fields, i)\n        Array::push(out, (k, rewrite_expr(v, gens, traits, struct_sets, dict_binds, var_types, fn_returns)))\n        i = i + 1\n      }\n      EMap(out)\n    },\n    EIf(c, t, e) => EIf(rewrite_expr(c, gens, traits, struct_sets, dict_binds, var_types, fn_returns), rewrite_expr(t, gens, traits, struct_sets, dict_binds, var_types, fn_returns), rewrite_expr(e, gens, traits, struct_sets, dict_binds, var_types, fn_returns)),\n    ELet(name, val, body, soff) => {\n      let new_val = rewrite_expr(val, gens, traits, struct_sets, dict_binds, var_types, fn_returns)\n      let body_vars0 = extend_var_types(var_types, name, anon_or_infer(val, struct_sets, var_types, fn_returns))\n      let body_vars = array_elem_bind(body_vars0, name, val, struct_sets, fn_returns)\n      ELet(name, new_val, rewrite_expr(body, gens, traits, struct_sets, dict_binds, body_vars, fn_returns), soff)\n    },\n    ELetRec(name, val, body) => ELetRec(name, rewrite_expr(val, gens, traits, struct_sets, dict_binds, var_types, fn_returns), rewrite_expr(body, gens, traits, struct_sets, dict_binds, var_types, fn_returns)),\n    ELetMut(name, val, body, soff) => {\n      let new_val = rewrite_expr(val, gens, traits, struct_sets, dict_binds, var_types, fn_returns)\n      let body_vars0 = extend_var_types(var_types, name, anon_or_infer(val, struct_sets, var_types, fn_returns))\n      let body_vars = array_elem_bind(body_vars0, name, val, struct_sets, fn_returns)\n      ELetMut(name, new_val, rewrite_expr(body, gens, traits, struct_sets, dict_binds, body_vars, fn_returns), soff)\n    },\n    EAssign(name, val, cont) => EAssign(name, rewrite_expr(val, gens, traits, struct_sets, dict_binds, var_types, fn_returns), rewrite_expr(cont, gens, traits, struct_sets, dict_binds, var_types, fn_returns)),\n    EAssignOp(name, op, val, cont) => EAssignOp(name, op, rewrite_expr(val, gens, traits, struct_sets, dict_binds, var_types, fn_returns), rewrite_expr(cont, gens, traits, struct_sets, dict_binds, var_types, fn_returns)),\n    ESeq(a, b) => ESeq(rewrite_expr(a, gens, traits, struct_sets, dict_binds, var_types, fn_returns), rewrite_expr(b, gens, traits, struct_sets, dict_binds, var_types, fn_returns)),\n    EMatch(scrut, arms) => {\n      let out = array_empty()\n      let mut i = 0\n      while i < Array::length(arms) {\n        let (p, b) = Array::get(arms, i)\n        Array::push(out, (p, rewrite_expr(b, gens, traits, struct_sets, dict_binds, var_types, fn_returns)))\n        i = i + 1\n      }\n      EMatch(rewrite_expr(scrut, gens, traits, struct_sets, dict_binds, var_types, fn_returns), out)\n    },\n    EHandle(scrut, arms) => {\n      let out = array_empty()\n      let mut i = 0\n      while i < Array::length(arms) {\n        let (p, b) = Array::get(arms, i)\n        Array::push(out, (p, rewrite_expr(b, gens, traits, struct_sets, dict_binds, var_types, fn_returns)))\n        i = i + 1\n      }\n      EHandle(rewrite_expr(scrut, gens, traits, struct_sets, dict_binds, var_types, fn_returns), out)\n    },\n    EWhile(c, b) => EWhile(rewrite_expr(c, gens, traits, struct_sets, dict_binds, var_types, fn_returns), rewrite_expr(b, gens, traits, struct_sets, dict_binds, var_types, fn_returns)),\n    ELoop(params, body) => ELoop(for param in params {\n      let (name, init) = param\n      (name, rewrite_expr(init, gens, traits, struct_sets, dict_binds, var_types, fn_returns))\n    }, rewrite_expr(body, gens, traits, struct_sets, dict_binds, var_types, fn_returns)),\n    EForIn(name, idx, iter, body) => {\n      let rbody = rewrite_expr(body, gens, traits, struct_sets, dict_binds, var_types, fn_returns)\n      let riter = rewrite_expr(iter, gens, traits, struct_sets, dict_binds, var_types, fn_returns)\n      if Array::length(traits) == 0 {\n        classify_trait_free_for_loop(name, idx, iter, riter, rbody, struct_sets, var_types, fn_returns)\n      } else {\n        classify_sync_for_loop(name, idx, iter, riter, rbody, struct_sets, var_types, fn_returns)\n      }\n    },\n    EBinOp(op, l, r) => {\n      let rl = rewrite_expr(l, gens, traits, struct_sets, dict_binds, var_types, fn_returns)\n      let rr = rewrite_expr(r, gens, traits, struct_sets, dict_binds, var_types, fn_returns)\n      if op == \"==\" || op == \"!=\" {\n        let empty_l = is_empty_array_lit(l)\n        let empty_r = is_empty_array_lit(r)\n        let arr_elem = match infer_earray_elem_type(l) {\n          Some(t) => Some(t),\n          None => infer_earray_elem_type(r)\n        }\n        if empty_l || empty_r {\n          let other = if empty_l {\n            rr\n          } else {\n            rl\n          }\n          let lencmp = EBinOp(\"==\", ECall(EIdent(\"Array::length\", -1), [\n            other\n          ], -1), EInt(0))\n          if op == \"==\" {\n            lencmp\n          } else {\n            ECall(EIdent(\"not\", -1), [\n              lencmp\n            ], -1)\n          }\n        } else {\n          match arr_elem {\n            Some(elem) => {\n              let call = ECall(EIdent(arr_equals_name(elem), -1), [\n                rl,\n                rr\n              ], -1)\n              if op == \"==\" {\n                call\n              } else {\n                ECall(EIdent(\"not\", -1), [\n                  call\n                ], -1)\n              }\n            },\n            None => {\n              let sty = infer_static_eq_type_binop(l, r)\n              let dty = match sty {\n                Some(t) => if static_eq_dispatchable(t) {\n                  Some(t)\n                } else {\n                  None\n                },\n                None => None\n              }\n              match dty {\n                Some(dt) => {\n                  let call = eq_for_typed(dt, rl, rr, empty_str_array())\n                  if op == \"==\" {\n                    call\n                  } else {\n                    ECall(EIdent(\"not\", -1), [\n                      call\n                    ], -1)\n                  }\n                },\n                None => {\n                  let ty = match infer_arg_type_name(l, struct_sets, var_types, fn_returns) {\n                    Some(t) => Some(t),\n                    None => infer_arg_type_name(r, struct_sets, var_types, fn_returns)\n                  }\n                  match ty {\n                    Some(t) => if struct_set_has(struct_sets, t) {\n                      let call = ECall(EIdent(String::concat(t, \"::equals\"), -1), [\n                        rl,\n                        rr\n                      ], -1)\n                      if op == \"==\" {\n                        call\n                      } else {\n                        ECall(EIdent(\"not\", -1), [\n                          call\n                        ], -1)\n                      }\n                    } else if t == \"Option\" {\n                      let eqm = opt_eq_match(rl, rr)\n                      if op == \"==\" {\n                        eqm\n                      } else {\n                        ECall(EIdent(\"not\", -1), [\n                          eqm\n                        ], -1)\n                      }\n                    } else if t == \"Result\" {\n                      let eqm = result_eq_match(rl, rr)\n                      if op == \"==\" {\n                        eqm\n                      } else {\n                        ECall(EIdent(\"not\", -1), [\n                          eqm\n                        ], -1)\n                      }\n                    } else {\n                      EBinOp(op, rl, rr)\n                    },\n                    None => EBinOp(op, rl, rr)\n                  }\n                }\n              }\n            }\n          }\n        }\n      } else if op == \"<\" || op == \">\" || op == \"<=\" || op == \">=\" {\n        let rel_stringish = (match infer_arg_type_name(l, struct_sets, var_types, fn_returns) {\n          Some(t) => t == \"String\",\n          None => false\n        }) || (match infer_arg_type_name(r, struct_sets, var_types, fn_returns) {\n          Some(t) => t == \"String\",\n          None => false\n        })\n        if rel_stringish {\n          EBinOp(op, ECall(EIdent(\"str_lex_diff\", -1), [\n            rl,\n            rr\n          ], -1), EInt(0))\n        } else if is_erased_generic_operand(l, r, struct_sets, var_types, fn_returns) {\n          EBinOp(op, ECall(EIdent(\"__generic_rel_diff\", -1), [\n            rl,\n            rr\n          ], -1), EInt(0))\n        } else {\n          EBinOp(op, rl, rr)\n        }\n      } else if op == \"+\" {\n        let stringish = (match infer_arg_type_name(l, struct_sets, var_types, fn_returns) {\n          Some(t) => t == \"String\",\n          None => false\n        }) || (match infer_arg_type_name(r, struct_sets, var_types, fn_returns) {\n          Some(t) => t == \"String\",\n          None => false\n        })\n        if stringish {\n          ECall(EIdent(\"String::concat\", -1), [\n            rl,\n            rr\n          ], -1)\n        } else if is_erased_generic_operand(l, r, struct_sets, var_types, fn_returns) {\n          ECall(EIdent(\"__generic_add\", -1), [\n            rl,\n            rr\n          ], -1)\n        } else {\n          EBinOp(op, rl, rr)\n        }\n      } else {\n        EBinOp(op, rl, rr)\n      }\n    },\n    EUnaryOp(op, e) => EUnaryOp(op, rewrite_expr(e, gens, traits, struct_sets, dict_binds, var_types, fn_returns)),\n    EFn(tp, bs, ps, ret, eff, body) => EFn(tp, bs, ps, ret, eff, rewrite_expr(body, gens, traits, struct_sets, dict_binds, seed_var_types(ps, tp, var_types), fn_returns)),\n    EDot(obj, field, off, fdoff) => {\n      let robj = rewrite_expr(obj, gens, traits, struct_sets, dict_binds, var_types, fn_returns)\n      match anon_dot_rewrite(obj, field, off, robj, var_types) {\n        Some(rw) => rw,\n        None => EDot(robj, field, off, fdoff)\n      }\n    },\n    ELabeledArg(label, name, body) => ELabeledArg(label, name, rewrite_expr(body, gens, traits, struct_sets, dict_binds, var_types, fn_returns)),\n    EReturn(e) => EReturn(rewrite_expr(e, gens, traits, struct_sets, dict_binds, var_types, fn_returns)),\n    EBreak(opt) => match opt {\n      Some(e) => EBreak(Some(rewrite_expr(e, gens, traits, struct_sets, dict_binds, var_types, fn_returns))),\n      None => expr\n    },\n    EContinue(exprs) => EContinue(for e in exprs {\n      rewrite_expr(e, gens, traits, struct_sets, dict_binds, var_types, fn_returns)\n    })\n  }\n}\n\nfn member_of(name: String) -> String {\n  match split_qualified(name) {\n    Some(parts) => {\n      let (_, member) = parts\n      member\n    },\n    None => name\n  }\n}\n\nfn dict_binds_of(threaded: Array[(String, String, Int)], traits: Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])]) -> Array[(String, String, String, Array[String])] {\n  let out = empty_dict_binds()\n  let mut i = 0\n  while i < Array::length(threaded) {\n    let (tp, trait_name, _) = Array::get(threaded, i)\n    let methods = match lookup_trait_sigs(traits, trait_name) {\n      Some(sigs) => method_names_of_sigs(sigs),\n      None => empty_str_array()\n    }\n    Array::push(out, (tp, trait_name, dict_param_name(trait_name, tp), methods))\n    i = i + 1\n  }\n  out\n}\n\nfn thread_dict_params(threaded: Array[(String, String, Int)], params: Array[(String, Option[TypeExpr])]) -> Array[(String, Option[TypeExpr])] {\n  let result = array_empty()\n  let mut i = 0\n  while i < Array::length(threaded) {\n    let (tp, trait_name, _) = Array::get(threaded, i)\n    let dty = TyApp(dict_struct_name(trait_name), [\n      TyName(tp)\n    ])\n    Array::push(result, (dict_param_name(trait_name, tp), Some(dty)))\n    i = i + 1\n  }\n  let mut j = 0\n  while j < Array::length(params) {\n    Array::push(result, Array::get(params, j))\n    j = j + 1\n  }\n  result\n}\n\nfn rewrite_stmt(stmt: Stmt, gens: Array[(String, Array[(String, String, Int)])], traits: Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], struct_sets: Array[(String, Array[String])], fn_returns: Array[(String, String)], toplevel_vars: Array[(String, String)]) -> Stmt with { Error } {\n  let no_binds = empty_dict_binds()\n  show_self_fn_set(match stmt {\n    SLet(_, _, sname, _, _) => sname,\n    _ => \"\"\n  })\n  match stmt {\n    SLet(exp, isrec, fname, ann, body) => match lookup_gen(gens, fname) {\n      Some(threaded) => match body {\n        EFn(tparams, bounds, params, ret, eff, fbody) => {\n          let binds = dict_binds_of(threaded, traits)\n          let new_params = thread_dict_params(threaded, params)\n          let seeded = seed_var_types(params, tparams, toplevel_vars)\n          let new_body = rewrite_expr(fbody, gens, traits, struct_sets, binds, seeded, fn_returns)\n          SLet(exp, isrec, fname, ann, EFn(tparams, bounds, new_params, ret, eff, new_body))\n        },\n        _ => stmt\n      },\n      None => SLet(exp, isrec, fname, ann, rewrite_expr(body, gens, traits, struct_sets, no_binds, toplevel_vars, fn_returns))\n    },\n    SLetMut(name, ty, e) => SLetMut(name, ty, rewrite_expr(e, gens, traits, struct_sets, no_binds, toplevel_vars, fn_returns)),\n    STest(name, body) => STest(name, rewrite_expr(body, gens, traits, struct_sets, no_binds, toplevel_vars, fn_returns)),\n    SBench(name, body) => SBench(name, rewrite_expr(body, gens, traits, struct_sets, no_binds, toplevel_vars, fn_returns)),\n    SExpr(e) => SExpr(rewrite_expr(e, gens, traits, struct_sets, no_binds, toplevel_vars, fn_returns)),\n    SModule(exp, name, body) => SModule(exp, name, for s in body {\n      rewrite_stmt(s, gens, traits, struct_sets, fn_returns, toplevel_vars)\n    }),\n    _ => stmt\n  }\n}\n\n\nfn qualified_name(tname: String, method: String) -> String {\n  String::concat(tname, String::concat(\"::\", method))\n}\n\nfn top_level_fn_exists(stmts: Array[Stmt], fname: String) -> Bool {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SLet(_, _, name, _, _) => if name == fname {\n        found = true\n        i = Array::length(stmts)\n      } else {\n        i = i + 1\n      },\n      _ => {\n        i = i + 1\n      }\n    }\n  }\n  found\n}\n\nfn concat2(a: Expr, b: Expr) -> Expr {\n  ECall(EIdent(\"String::concat\", -1), [\n    a,\n    b\n  ], -1)\n}\n\nfn ts_type_key(ty: TypeExpr) -> String {\n  match ty {\n    TyName(n) => n,\n    TyApp(n, args) => {\n      let mut s = n\n      let mut i = 0\n      while i < Array::length(args) {\n        s = String::concat(s, String::concat(\"_\", ts_type_key(Array::get(args, i))))\n        i = i + 1\n      }\n      s\n    },\n    TyTuple(ts) => {\n      let mut s = \"Tup\"\n      let mut i = 0\n      while i < Array::length(ts) {\n        s = String::concat(s, String::concat(\"_\", ts_type_key(Array::get(ts, i))))\n        i = i + 1\n      }\n      s\n    },\n    TyUnit => \"Unit\",\n    _ => \"Any\"\n  }\n}\n\nfn arr_to_string_name(t: TypeExpr) -> String {\n  String::concat(\"__arr_to_string__\", ts_type_key(t))\n}\n\nfn show_for_typed(fty: TypeExpr, val: Expr, known_types: Array[String]) -> Expr {\n  match fty {\n    TyName(\"String\") => val,\n    TyName(n) => if !is_scalar_type_name(n) && str_array_contains(known_types, n) {\n      ECall(EIdent(qualified_name(n, \"to_string\"), -1), Array::slice([\n        val\n      ], 0, 1), -1)\n    } else {\n      ECall(EIdent(\"__to_string\", -1), Array::slice([\n        val\n      ], 0, 1), -1)\n    },\n    TyApp(\"Option\", args) => if Array::length(args) == 1 {\n      let t = Array::get(args, 0)\n      let inner = show_for_typed(t, EIdent(\"__os_v\", -1), known_types)\n      let some_body = concat2(EString(\"Some(\"), concat2(inner, EString(\")\")))\n      EMatch(val, Array::slice([\n        (PCtor(\"Some\", Array::slice([\n          PBind(\"__os_v\")\n        ], 0, 1)), some_body),\n        (PCtor(\"None\", array_empty()), EString(\"None\"))\n      ], 0, 2))\n    } else {\n      ECall(EIdent(\"__to_string\", -1), Array::slice([\n        val\n      ], 0, 1), -1)\n    },\n    TyApp(\"Result\", args) => if Array::length(args) == 2 {\n      let t = Array::get(args, 0)\n      let e = Array::get(args, 1)\n      let ok_inner = show_for_typed(t, EIdent(\"__rs_v\", -1), known_types)\n      let err_inner = show_for_typed(e, EIdent(\"__rs_v\", -1), known_types)\n      let ok_body = concat2(EString(\"Ok(\"), concat2(ok_inner, EString(\")\")))\n      let err_body = concat2(EString(\"Err(\"), concat2(err_inner, EString(\")\")))\n      EMatch(val, Array::slice([\n        (PCtor(\"Ok\", Array::slice([\n          PBind(\"__rs_v\")\n        ], 0, 1)), ok_body),\n        (PCtor(\"Err\", Array::slice([\n          PBind(\"__rs_v\")\n        ], 0, 1)), err_body)\n      ], 0, 2))\n    } else {\n      ECall(EIdent(\"__to_string\", -1), Array::slice([\n        val\n      ], 0, 1), -1)\n    },\n    TyTuple(ts) => {\n      let n = Array::length(ts)\n      let pats = array_empty()\n      let mut i = 0\n      while i < n {\n        Array::push(pats, PBind(String::concat(\"__ts_t\", idx_str(i))))\n        i = i + 1\n      }\n      let segs = empty_expr_array()\n      Array::push(segs, EString(\"(\"))\n      let mut k = 0\n      while k < n {\n        if k > 0 {\n          Array::push(segs, EString(\", \"))\n        } else {\n          ()\n        }\n        Array::push(segs, show_for_typed(Array::get(ts, k), EIdent(String::concat(\"__ts_t\", idx_str(k)), -1), known_types))\n        k = k + 1\n      }\n      Array::push(segs, EString(\")\"))\n      let mut acc = Array::get(segs, Array::length(segs) - 1)\n      let mut j = Array::length(segs) - 2\n      while j >= 0 {\n        acc = concat2(Array::get(segs, j), acc)\n        j = j - 1\n      }\n      EMatch(val, Array::slice([\n        (PTuple(pats), acc)\n      ], 0, 1))\n    },\n    TyApp(\"Array\", args) => if Array::length(args) == 1 {\n      ECall(EIdent(arr_to_string_name(Array::get(args, 0)), -1), Array::slice([\n        val\n      ], 0, 1), -1)\n    } else {\n      ECall(EIdent(\"__to_string\", -1), Array::slice([\n        val\n      ], 0, 1), -1)\n    },\n    TyApp(n, _) => if str_array_contains(known_types, n) {\n      ECall(EIdent(qualified_name(n, \"to_string\"), -1), Array::slice([\n        val\n      ], 0, 1), -1)\n    } else {\n      ECall(EIdent(\"__to_string\", -1), Array::slice([\n        val\n      ], 0, 1), -1)\n    },\n    _ => ECall(EIdent(\"__to_string\", -1), Array::slice([\n      val\n    ], 0, 1), -1)\n  }\n}\n\nfn field_show_expr(fname: String, fty: TypeExpr, known_types: Array[String]) -> Expr {\n  show_for_typed(fty, EDot(EIdent(\"self\", -1), fname, -1, -1), known_types)\n}\n\nfn gen_arr_to_string_fn(elem_ty: TypeExpr, known_types: Array[String]) -> Stmt {\n  let elem_get = ECall(EIdent(\"Array::get\", -1), Array::slice([\n    EIdent(\"a\", -1),\n    EIdent(\"__as_i\", -1)\n  ], 0, 2), -1)\n  let elem_show = show_for_typed(elem_ty, elem_get, known_types)\n  let sep = EIf(EBinOp(\"==\", EIdent(\"__as_i\", -1), EInt(0)), EString(\"\"), EString(\", \"))\n  let append = concat2(concat2(EIdent(\"__as_acc\", -1), sep), elem_show)\n  let set_acc = EAssign(\"__as_acc\", append, EUnit)\n  let incr = EAssign(\"__as_i\", EBinOp(\"+\", EIdent(\"__as_i\", -1), EInt(1)), EUnit)\n  let loop_body = ESeq(set_acc, incr)\n  let while_loop = EWhile(EBinOp(\"<\", EIdent(\"__as_i\", -1), ECall(EIdent(\"Array::length\", -1), Array::slice([\n    EIdent(\"a\", -1)\n  ], 0, 1), -1)), loop_body)\n  let closed = concat2(EIdent(\"__as_acc\", -1), EString(\"]\"))\n  let body = ELetMut(\"__as_i\", EInt(0), ELetMut(\"__as_acc\", EString(\"[\"), ESeq(while_loop, closed), -1), -1)\n  let arr_ty = TyApp(\"Array\", Array::slice([\n    elem_ty\n  ], 0, 1))\n  let params = Array::slice([\n    (\"a\", Some(arr_ty))\n  ], 0, 1)\n  let no_tp = array_empty()\n  let no_tb = array_empty()\n  SLet(false, false, arr_to_string_name(elem_ty), None, EFn(no_tp, no_tb, params, Some(TyName(\"String\")), None, body))\n}\n\nfn gen_show_fn(tname: String, fields: Array[(String, TypeExpr)], known_types: Array[String]) -> Stmt {\n  let segs = empty_expr_array()\n  Array::push(segs, EString(String::concat(tname, \" { \")))\n  let mut i = 0\n  while i < Array::length(fields) {\n    let (fname, fty) = Array::get(fields, i)\n    let sep = if i == 0 {\n      \"\"\n    } else \", \"\n    Array::push(segs, EString(String::concat(sep, String::concat(fname, \": \"))))\n    Array::push(segs, field_show_expr(fname, fty, known_types))\n    i = i + 1\n  }\n  Array::push(segs, EString(\" }\"))\n  let mut body = Array::get(segs, Array::length(segs) - 1)\n  let mut j = Array::length(segs) - 2\n  while j >= 0 {\n    body = concat2(Array::get(segs, j), body)\n    j = j - 1\n  }\n  let params = Array::slice([\n    (\"self\", Some(TyName(tname)))\n  ], 0, 1)\n  let no_tp = array_empty()\n  let no_tb = array_empty()\n  SLet(false, false, qualified_name(tname, \"to_string\"), None, EFn(no_tp, no_tb, params, Some(TyName(\"String\")), None, body))\n}\n\nfn is_scalar_type_name(n: String) -> Bool {\n  n == \"Int\" || n == \"Double\" || n == \"Bool\" || n == \"String\" || n == \"Char\" || n == \"Unit\" || n == \"Bytes\"\n}\n\nfn type_key(ty: TypeExpr) -> String {\n  match ty {\n    TyName(n) => n,\n    TyApp(n, args) => {\n      let mut s = n\n      let mut i = 0\n      while i < Array::length(args) {\n        s = String::concat(s, String::concat(\"_\", type_key(Array::get(args, i))))\n        i = i + 1\n      }\n      s\n    },\n    TyTuple(ts) => {\n      let mut s = \"Tup\"\n      let mut i = 0\n      while i < Array::length(ts) {\n        s = String::concat(s, String::concat(\"_\", type_key(Array::get(ts, i))))\n        i = i + 1\n      }\n      s\n    },\n    TyUnit => \"Unit\",\n    _ => \"Any\"\n  }\n}\n\nfn arr_equals_name(t: TypeExpr) -> String {\n  String::concat(\"__arr_equals__\", type_key(t))\n}\n\nfn opt_eq_match(lhs: Expr, rhs: Expr) -> Expr {\n  let some_inner = EMatch(rhs, Array::slice([\n    (PCtor(\"Some\", Array::slice([\n      PBind(\"__oeq_r\")\n    ], 0, 1)), EBinOp(\"==\", EIdent(\"__oeq_l\", -1), EIdent(\"__oeq_r\", -1))),\n    (PWild, EBool(false))\n  ], 0, 2))\n  let none_inner = EMatch(rhs, Array::slice([\n    (PCtor(\"None\", array_empty()), EBool(true)),\n    (PWild, EBool(false))\n  ], 0, 2))\n  EMatch(lhs, Array::slice([\n    (PCtor(\"Some\", Array::slice([\n      PBind(\"__oeq_l\")\n    ], 0, 1)), some_inner),\n    (PCtor(\"None\", array_empty()), none_inner)\n  ], 0, 2))\n}\n\nfn result_eq_match(lhs: Expr, rhs: Expr) -> Expr {\n  let ok_inner = EMatch(rhs, Array::slice([\n    (PCtor(\"Ok\", Array::slice([\n      PBind(\"__req_r\")\n    ], 0, 1)), EBinOp(\"==\", EIdent(\"__req_l\", -1), EIdent(\"__req_r\", -1))),\n    (PWild, EBool(false))\n  ], 0, 2))\n  let err_inner = EMatch(rhs, Array::slice([\n    (PCtor(\"Err\", Array::slice([\n      PBind(\"__req_r\")\n    ], 0, 1)), EBinOp(\"==\", EIdent(\"__req_l\", -1), EIdent(\"__req_r\", -1))),\n    (PWild, EBool(false))\n  ], 0, 2))\n  EMatch(lhs, Array::slice([\n    (PCtor(\"Ok\", Array::slice([\n      PBind(\"__req_l\")\n    ], 0, 1)), ok_inner),\n    (PCtor(\"Err\", Array::slice([\n      PBind(\"__req_l\")\n    ], 0, 1)), err_inner)\n  ], 0, 2))\n}\n\nfn eq_for_typed(fty: TypeExpr, lhs: Expr, rhs: Expr, known_types: Array[String]) -> Expr {\n  match fty {\n    TyName(n) => if n == \"Double\" || n == \"Float\" {\n      EBinOp(\"==\", ECall(EIdent(\"Double::to_float\", -1), Array::slice([\n        lhs\n      ], 0, 1), -1), ECall(EIdent(\"Double::to_float\", -1), Array::slice([\n        rhs\n      ], 0, 1), -1))\n    } else if !is_scalar_type_name(n) && str_array_contains(known_types, n) {\n      ECall(EIdent(qualified_name(n, \"equals\"), -1), Array::slice([\n        lhs,\n        rhs\n      ], 0, 2), -1)\n    } else {\n      EBinOp(\"==\", lhs, rhs)\n    },\n    TyApp(\"Option\", args) => if Array::length(args) == 1 {\n      let t = Array::get(args, 0)\n      let inner_eq = eq_for_typed(t, EIdent(\"__oeq_l\", -1), EIdent(\"__oeq_r\", -1), known_types)\n      let some_inner = EMatch(rhs, Array::slice([\n        (PCtor(\"Some\", Array::slice([\n          PBind(\"__oeq_r\")\n        ], 0, 1)), inner_eq),\n        (PWild, EBool(false))\n      ], 0, 2))\n      let none_inner = EMatch(rhs, Array::slice([\n        (PCtor(\"None\", array_empty()), EBool(true)),\n        (PWild, EBool(false))\n      ], 0, 2))\n      EMatch(lhs, Array::slice([\n        (PCtor(\"Some\", Array::slice([\n          PBind(\"__oeq_l\")\n        ], 0, 1)), some_inner),\n        (PCtor(\"None\", array_empty()), none_inner)\n      ], 0, 2))\n    } else {\n      EBinOp(\"==\", lhs, rhs)\n    },\n    TyApp(\"Result\", args) => if Array::length(args) == 2 {\n      let t = Array::get(args, 0)\n      let e = Array::get(args, 1)\n      let ok_eq = eq_for_typed(t, EIdent(\"__req_l\", -1), EIdent(\"__req_r\", -1), known_types)\n      let err_eq = eq_for_typed(e, EIdent(\"__req_l\", -1), EIdent(\"__req_r\", -1), known_types)\n      let ok_inner = EMatch(rhs, Array::slice([\n        (PCtor(\"Ok\", Array::slice([\n          PBind(\"__req_r\")\n        ], 0, 1)), ok_eq),\n        (PWild, EBool(false))\n      ], 0, 2))\n      let err_inner = EMatch(rhs, Array::slice([\n        (PCtor(\"Err\", Array::slice([\n          PBind(\"__req_r\")\n        ], 0, 1)), err_eq),\n        (PWild, EBool(false))\n      ], 0, 2))\n      EMatch(lhs, Array::slice([\n        (PCtor(\"Ok\", Array::slice([\n          PBind(\"__req_l\")\n        ], 0, 1)), ok_inner),\n        (PCtor(\"Err\", Array::slice([\n          PBind(\"__req_l\")\n        ], 0, 1)), err_inner)\n      ], 0, 2))\n    } else {\n      EBinOp(\"==\", lhs, rhs)\n    },\n    TyTuple(ts) => {\n      let n = Array::length(ts)\n      let lpats = array_empty()\n      let rpats = array_empty()\n      let mut i = 0\n      while i < n {\n        Array::push(lpats, PBind(String::concat(\"__teq_l\", idx_str(i))))\n        Array::push(rpats, PBind(String::concat(\"__teq_r\", idx_str(i))))\n        i = i + 1\n      }\n      let mut conj = EBool(true)\n      let mut j = n - 1\n      while j >= 0 {\n        let cmp = eq_for_typed(Array::get(ts, j), EIdent(String::concat(\"__teq_l\", idx_str(j)), -1), EIdent(String::concat(\"__teq_r\", idx_str(j)), -1), known_types)\n        conj = EBinOp(\"&&\", cmp, conj)\n        j = j - 1\n      }\n      let inner = EMatch(rhs, Array::slice([\n        (PTuple(rpats), conj)\n      ], 0, 1))\n      EMatch(lhs, Array::slice([\n        (PTuple(lpats), inner)\n      ], 0, 1))\n    },\n    TyApp(\"Array\", args) => if Array::length(args) == 1 {\n      ECall(EIdent(arr_equals_name(Array::get(args, 0)), -1), Array::slice([\n        lhs,\n        rhs\n      ], 0, 2), -1)\n    } else {\n      EBinOp(\"==\", lhs, rhs)\n    },\n    TyApp(n, _) => if str_array_contains(known_types, n) {\n      ECall(EIdent(qualified_name(n, \"equals\"), -1), Array::slice([\n        lhs,\n        rhs\n      ], 0, 2), -1)\n    } else {\n      EBinOp(\"==\", lhs, rhs)\n    },\n    _ => EBinOp(\"==\", lhs, rhs)\n  }\n}\n\nfn gen_arr_equals_fn(elem_ty: TypeExpr, known_types: Array[String]) -> Stmt {\n  let len_a = ECall(EIdent(\"Array::length\", -1), Array::slice([\n    EIdent(\"a\", -1)\n  ], 0, 1), -1)\n  let len_b = ECall(EIdent(\"Array::length\", -1), Array::slice([\n    EIdent(\"b\", -1)\n  ], 0, 1), -1)\n  let elem_a = ECall(EIdent(\"Array::get\", -1), Array::slice([\n    EIdent(\"a\", -1),\n    EIdent(\"__ae_i\", -1)\n  ], 0, 2), -1)\n  let elem_b = ECall(EIdent(\"Array::get\", -1), Array::slice([\n    EIdent(\"b\", -1),\n    EIdent(\"__ae_i\", -1)\n  ], 0, 2), -1)\n  let elem_eq = eq_for_typed(elem_ty, elem_a, elem_b, known_types)\n  let not_eq = ECall(EIdent(\"not\", -1), Array::slice([\n    elem_eq\n  ], 0, 1), -1)\n  let set_false = EIf(not_eq, EAssign(\"__ae_ok\", EBool(false), EUnit), EUnit)\n  let incr = EAssign(\"__ae_i\", EBinOp(\"+\", EIdent(\"__ae_i\", -1), EInt(1)), EUnit)\n  let loop_body = ESeq(set_false, incr)\n  let while_loop = EWhile(EBinOp(\"<\", EIdent(\"__ae_i\", -1), ECall(EIdent(\"Array::length\", -1), Array::slice([\n    EIdent(\"a\", -1)\n  ], 0, 1), -1)), loop_body)\n  let body_eq = ELetMut(\"__ae_i\", EInt(0), ELetMut(\"__ae_ok\", EBool(true), ESeq(while_loop, EIdent(\"__ae_ok\", -1)), -1), -1)\n  let body = EIf(EBinOp(\"!=\", len_a, len_b), EBool(false), body_eq)\n  let arr_ty = TyApp(\"Array\", Array::slice([\n    elem_ty\n  ], 0, 1))\n  let params = Array::slice([\n    (\"a\", Some(arr_ty)),\n    (\"b\", Some(arr_ty))\n  ], 0, 2)\n  let no_tp = array_empty()\n  let no_tb = array_empty()\n  SLet(false, false, arr_equals_name(elem_ty), None, EFn(no_tp, no_tb, params, Some(TyName(\"Bool\")), None, body))\n}\n\nfn field_eq_expr(fname: String, fty: TypeExpr, known_types: Array[String]) -> Expr {\n  eq_for_typed(fty, EDot(EIdent(\"a\", -1), fname, -1, -1), EDot(EIdent(\"b\", -1), fname, -1, -1), known_types)\n}\n\nfn gen_eq_fn(tname: String, fields: Array[(String, TypeExpr)], known_types: Array[String]) -> Stmt {\n  let mut body = EBool(true)\n  let mut i = Array::length(fields) - 1\n  while i >= 0 {\n    let (fname, fty) = Array::get(fields, i)\n    body = EBinOp(\"&&\", field_eq_expr(fname, fty, known_types), body)\n    i = i - 1\n  }\n  let params = Array::slice([\n    (\"a\", Some(TyName(tname))),\n    (\"b\", Some(TyName(tname)))\n  ], 0, 2)\n  let no_tp = array_empty()\n  let no_tb = array_empty()\n  SLet(false, false, qualified_name(tname, \"equals\"), None, EFn(no_tp, no_tb, params, Some(TyName(\"Bool\")), None, body))\n}\n\nfn digit_str(d: Int) -> String {\n  if d == 0 {\n    \"0\"\n  } else if d == 1 {\n    \"1\"\n  } else if d == 2 {\n    \"2\"\n  } else if d == 3 {\n    \"3\"\n  } else if d == 4 {\n    \"4\"\n  } else if d == 5 {\n    \"5\"\n  } else if d == 6 {\n    \"6\"\n  } else if d == 7 {\n    \"7\"\n  } else if d == 8 {\n    \"8\"\n  } else {\n    \"9\"\n  }\n}\n\nfn idx_str(n: Int) -> String {\n  if n < 10 {\n    digit_str(n)\n  } else {\n    String::concat(idx_str(n / 10), digit_str(n % 10))\n  }\n}\n\nfn gen_enum_eq_fn(ename: String, variants: Array[(String, Array[TypeExpr])], known_types: Array[String]) -> Stmt {\n  let outer_arms = array_empty()\n  let mut vi = 0\n  while vi < Array::length(variants) {\n    let (vname, ftypes) = Array::get(variants, vi)\n    let nf = Array::length(ftypes)\n    let abinds = array_empty()\n    let bbinds = array_empty()\n    let mut fi = 0\n    while fi < nf {\n      Array::push(abinds, PBind(String::concat(\"__a\", idx_str(fi))))\n      Array::push(bbinds, PBind(String::concat(\"__b\", idx_str(fi))))\n      fi = fi + 1\n    }\n    let mut body = EBool(true)\n    let mut bi = nf - 1\n    while bi >= 0 {\n      let cmp = eq_for_typed(Array::get(ftypes, bi), EIdent(String::concat(\"__a\", idx_str(bi)), -1), EIdent(String::concat(\"__b\", idx_str(bi)), -1), known_types)\n      body = EBinOp(\"&&\", cmp, body)\n      bi = bi - 1\n    }\n    let inner_arms = Array::slice([\n      (PCtor(vname, bbinds), body),\n      (PWild, EBool(false))\n    ], 0, 2)\n    let inner = EMatch(EIdent(\"b\", -1), inner_arms)\n    Array::push(outer_arms, (PCtor(vname, abinds), inner))\n    vi = vi + 1\n  }\n  let params = Array::slice([\n    (\"a\", Some(TyName(ename))),\n    (\"b\", Some(TyName(ename)))\n  ], 0, 2)\n  let no_tp = array_empty()\n  let no_tb = array_empty()\n  SLet(false, false, qualified_name(ename, \"equals\"), None, EFn(no_tp, no_tb, params, Some(TyName(\"Bool\")), None, EMatch(EIdent(\"a\", -1), outer_arms)))\n}\n\nfn gen_compare_fn(tname: String, fields: Array[(String, TypeExpr)]) -> Stmt {\n  let neg_one = 0 - 1\n  let mut body = EInt(0)\n  let mut i = Array::length(fields) - 1\n  while i >= 0 {\n    let (fname, _) = Array::get(fields, i)\n    let af = EDot(EIdent(\"a\", -1), fname, -1, -1)\n    let bf = EDot(EIdent(\"b\", -1), fname, -1, -1)\n    body = EIf(EBinOp(\"<\", af, bf), EInt(neg_one), EIf(EBinOp(\">\", af, bf), EInt(1), body))\n    i = i - 1\n  }\n  let params = Array::slice([\n    (\"a\", Some(TyName(tname))),\n    (\"b\", Some(TyName(tname)))\n  ], 0, 2)\n  let no_tp = array_empty()\n  let no_tb = array_empty()\n  SLet(false, false, qualified_name(tname, \"compare\"), None, EFn(no_tp, no_tb, params, Some(TyName(\"Int\")), None, body))\n}\n\nfn show_expr_typed(val: Expr, fty: TypeExpr, known_types: Array[String]) -> Expr {\n  show_for_typed(fty, val, known_types)\n}\n\nfn gen_enum_show_fn(ename: String, variants: Array[(String, Array[TypeExpr])], known_types: Array[String]) -> Stmt {\n  let arms = array_empty()\n  let mut vi = 0\n  while vi < Array::length(variants) {\n    let (vname, ftypes) = Array::get(variants, vi)\n    let nf = Array::length(ftypes)\n    let binds = array_empty()\n    let mut fi = 0\n    while fi < nf {\n      Array::push(binds, PBind(String::concat(\"__s\", idx_str(fi))))\n      fi = fi + 1\n    }\n    let body = if nf == 0 {\n      EString(vname)\n    } else {\n      let segs = empty_expr_array()\n      Array::push(segs, EString(String::concat(vname, \"(\")))\n      let mut si = 0\n      while si < nf {\n        let sep = if si == 0 {\n          \"\"\n        } else \", \"\n        if sep != \"\" {\n          Array::push(segs, EString(sep))\n        } else {\n          ()\n        }\n        Array::push(segs, show_expr_typed(EIdent(String::concat(\"__s\", idx_str(si)), -1), Array::get(ftypes, si), known_types))\n        si = si + 1\n      }\n      Array::push(segs, EString(\")\"))\n      let mut acc = Array::get(segs, Array::length(segs) - 1)\n      let mut j = Array::length(segs) - 2\n      while j >= 0 {\n        acc = concat2(Array::get(segs, j), acc)\n        j = j - 1\n      }\n      acc\n    }\n    Array::push(arms, (PCtor(vname, binds), body))\n    vi = vi + 1\n  }\n  let params = Array::slice([\n    (\"self\", Some(TyName(ename)))\n  ], 0, 1)\n  let no_tp = array_empty()\n  let no_tb = array_empty()\n  SLet(false, false, qualified_name(ename, \"to_string\"), None, EFn(no_tp, no_tb, params, Some(TyName(\"String\")), None, EMatch(EIdent(\"self\", -1), arms)))\n}\n\nfn gen_hash_key_fn(tname: String) -> Stmt {\n  let body = ECall(EIdent(qualified_name(tname, \"to_string\"), -1), Array::slice([\n    EIdent(\"self\", -1)\n  ], 0, 1), -1)\n  let params = Array::slice([\n    (\"self\", Some(TyName(tname)))\n  ], 0, 1)\n  let no_tp = array_empty()\n  let no_tb = array_empty()\n  SLet(false, false, qualified_name(tname, \"hash_key\"), None, EFn(no_tp, no_tb, params, Some(TyName(\"String\")), None, body))\n}\n\nfn collect_show_array_elems(ty: TypeExpr, acc: Array[TypeExpr], keys: Array[String]) -> Unit {\n  match ty {\n    TyApp(\"Array\", args) => if Array::length(args) == 1 {\n      let et = Array::get(args, 0)\n      let k = ts_type_key(et)\n      if str_array_contains(keys, k) {\n        ()\n      } else {\n        Array::push(keys, k)\n        Array::push(acc, et)\n      }\n    } else {\n      ()\n    },\n    _ => ()\n  }\n}\n\nfn compare_for_typed(fty: TypeExpr, lhs: Expr, rhs: Expr, known_types: Array[String]) -> Expr {\n  let neg_one = 0 - 1\n  match fty {\n    TyName(n) => if !is_scalar_type_name(n) && str_array_contains(known_types, n) {\n      ECall(EIdent(qualified_name(n, \"compare\"), -1), Array::slice([\n        lhs,\n        rhs\n      ], 0, 2), -1)\n    } else {\n      EIf(EBinOp(\"<\", lhs, rhs), EInt(neg_one), EIf(EBinOp(\">\", lhs, rhs), EInt(1), EInt(0)))\n    },\n    _ => EIf(EBinOp(\"<\", lhs, rhs), EInt(neg_one), EIf(EBinOp(\">\", lhs, rhs), EInt(1), EInt(0)))\n  }\n}\n\nfn gen_enum_compare_fn(ename: String, variants: Array[(String, Array[TypeExpr])], known_types: Array[String]) -> Stmt {\n  let neg_one = 0 - 1\n  let outer_arms = array_empty()\n  let mut ai = 0\n  while ai < Array::length(variants) {\n    let (avname, aftypes) = Array::get(variants, ai)\n    let anf = Array::length(aftypes)\n    let abinds = array_empty()\n    let mut afi = 0\n    while afi < anf {\n      Array::push(abinds, PBind(String::concat(\"__a\", idx_str(afi))))\n      afi = afi + 1\n    }\n    let inner_arms = array_empty()\n    let mut bi = 0\n    while bi < Array::length(variants) {\n      let (bvname, bftypes) = Array::get(variants, bi)\n      let bnf = Array::length(bftypes)\n      let bbinds = array_empty()\n      let mut bfi = 0\n      while bfi < bnf {\n        Array::push(bbinds, PBind(String::concat(\"__b\", idx_str(bfi))))\n        bfi = bfi + 1\n      }\n      let arm_body = if ai == bi {\n        let mut body = EInt(0)\n        let mut pi = anf - 1\n        while pi >= 0 {\n          let cmp = compare_for_typed(Array::get(aftypes, pi), EIdent(String::concat(\"__a\", idx_str(pi)), -1), EIdent(String::concat(\"__b\", idx_str(pi)), -1), known_types)\n          let prev = body\n          body = EIf(EBinOp(\"<\", cmp, EInt(0)), EInt(neg_one), EIf(EBinOp(\">\", cmp, EInt(0)), EInt(1), prev))\n          pi = pi - 1\n        }\n        body\n      } else if ai < bi {\n        EInt(neg_one)\n      } else {\n        EInt(1)\n      }\n      Array::push(inner_arms, (PCtor(bvname, bbinds), arm_body))\n      bi = bi + 1\n    }\n    Array::push(outer_arms, (PCtor(avname, abinds), EMatch(EIdent(\"b\", -1), inner_arms)))\n    ai = ai + 1\n  }\n  let params = Array::slice([\n    (\"a\", Some(TyName(ename))),\n    (\"b\", Some(TyName(ename)))\n  ], 0, 2)\n  let no_tp = array_empty()\n  let no_tb = array_empty()\n  SLet(false, false, qualified_name(ename, \"compare\"), None, EFn(no_tp, no_tb, params, Some(TyName(\"Int\")), None, EMatch(EIdent(\"a\", -1), outer_arms)))\n}\n\nfn default_for_type(fty: TypeExpr, known_types: Array[String]) -> Expr {\n  match fty {\n    TyName(\"Int\") => EInt(0),\n    TyName(\"Double\") => EFloat(0.0),\n    TyName(\"Float\") => EFloat(0.0),\n    TyName(\"Bool\") => EBool(false),\n    TyName(\"String\") => EString(\"\"),\n    TyName(\"Unit\") => EUnit,\n    TyName(n) => if str_array_contains(known_types, n) {\n      ECall(EIdent(qualified_name(n, \"default\"), -1), empty_expr_array(), -1)\n    } else {\n      EUnit\n    },\n    TyApp(\"Option\", _) => EIdent(\"None\", -1),\n    TyApp(\"Array\", _) => EArray(empty_expr_array()),\n    TyApp(n, _) => if str_array_contains(known_types, n) {\n      ECall(EIdent(qualified_name(n, \"default\"), -1), empty_expr_array(), -1)\n    } else {\n      EUnit\n    },\n    TyUnit => EUnit,\n    _ => EUnit\n  }\n}\n\nfn gen_default_fn(tname: String, fields: Array[(String, TypeExpr)], known_types: Array[String]) -> Stmt {\n  let rec_fields = array_empty()\n  let mut i = 0\n  while i < Array::length(fields) {\n    let (fname, fty) = Array::get(fields, i)\n    Array::push(rec_fields, (fname, default_for_type(fty, known_types)))\n    i = i + 1\n  }\n  let no_params = array_empty()\n  let no_tp = array_empty()\n  let no_tb = array_empty()\n  SLet(false, false, qualified_name(tname, \"default\"), None, EFn(no_tp, no_tb, no_params, Some(TyName(tname)), None, ERecord(\"\", rec_fields, empty_ty_args())))\n}\n\nfn gen_enum_default_fn(ename: String, variants: Array[(String, Array[TypeExpr])], known_types: Array[String]) -> Stmt {\n  let (vname, ftypes) = Array::get(variants, 0)\n  let body = if Array::length(ftypes) == 0 {\n    EIdent(vname, -1)\n  } else {\n    let args = empty_expr_array()\n    let mut i = 0\n    while i < Array::length(ftypes) {\n      Array::push(args, default_for_type(Array::get(ftypes, i), known_types))\n      i = i + 1\n    }\n    ECall(EIdent(vname, -1), args, -1)\n  }\n  let no_params = array_empty()\n  let no_tp = array_empty()\n  let no_tb = array_empty()\n  SLet(false, false, qualified_name(ename, \"default\"), None, EFn(no_tp, no_tb, no_params, Some(TyName(ename)), None, body))\n}\n\nfn collect_array_elem_types(ty: TypeExpr, acc: Array[TypeExpr], acc_keys: Array[String]) -> Unit {\n  match ty {\n    TyApp(\"Array\", args) => if Array::length(args) == 1 {\n      let e = Array::get(args, 0)\n      let k = type_key(e)\n      if !str_array_contains(acc_keys, k) {\n        Array::push(acc, e)\n        Array::push(acc_keys, k)\n      } else {\n        ()\n      }\n      collect_array_elem_types(e, acc, acc_keys)\n    } else {\n      ()\n    },\n    TyApp(_, args) => {\n      let mut i = 0\n      while i < Array::length(args) {\n        collect_array_elem_types(Array::get(args, i), acc, acc_keys)\n        i = i + 1\n      }\n    },\n    TyTuple(ts) => {\n      let mut i = 0\n      while i < Array::length(ts) {\n        collect_array_elem_types(Array::get(ts, i), acc, acc_keys)\n        i = i + 1\n      }\n    },\n    _ => ()\n  }\n}\n\nfn is_empty_array_lit(e: Expr) -> Bool {\n  match e {\n    EArray(elems) => Array::length(elems) == 0,\n    _ => false\n  }\n}\n\nfn infer_earray_elem_type(arr: Expr) -> Option[TypeExpr] {\n  match arr {\n    EArray(elems) => if Array::length(elems) == 0 {\n      None\n    } else {\n      match Array::get(elems, 0) {\n        EInt(_) => Some(TyName(\"Int\")),\n        EBool(_) => Some(TyName(\"Bool\")),\n        EString(_) => Some(TyName(\"String\")),\n        EFloat(_) => Some(TyName(\"Double\")),\n        EArray(_) => match infer_earray_elem_type(Array::get(elems, 0)) {\n          Some(inner) => Some(TyApp(\"Array\", Array::slice([\n            inner\n          ], 0, 1))),\n          None => None\n        },\n        _ => None\n      }\n    },\n    _ => None\n  }\n}\n\nfn ty_contains_eq_unknown(t: TypeExpr) -> Bool {\n  match t {\n    TyName(n) => n == \"__EqUnknown\",\n    TyApp(_, args) => {\n      let mut i = 0\n      let mut found = false\n      while i < Array::length(args) {\n        if ty_contains_eq_unknown(Array::get(args, i)) {\n          found = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      found\n    },\n    TyTuple(ts) => {\n      let mut i = 0\n      let mut found = false\n      while i < Array::length(ts) {\n        if ty_contains_eq_unknown(Array::get(ts, i)) {\n          found = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      found\n    },\n    _ => false\n  }\n}\n\nfn infer_static_eq_type(e: Expr) -> Option[TypeExpr] {\n  match e {\n    EInt(_) => Some(TyName(\"Int\")),\n    EBool(_) => Some(TyName(\"Bool\")),\n    EString(_) => Some(TyName(\"String\")),\n    EFloat(_) => Some(TyName(\"Double\")),\n    EUnit => Some(TyUnit),\n    EArray(elems) => if Array::length(elems) == 0 {\n      None\n    } else {\n      match infer_static_eq_type(Array::get(elems, 0)) {\n        Some(t) => if ty_contains_eq_unknown(t) {\n          None\n        } else {\n          Some(TyApp(\"Array\", Array::slice([\n            t\n          ], 0, 1)))\n        },\n        None => None\n      }\n    },\n    ETuple(es) => {\n      let ts = empty_type_exprs()\n      let mut i = 0\n      while i < Array::length(es) {\n        match infer_static_eq_type(Array::get(es, i)) {\n          Some(t) => Array::push(ts, t),\n          None => Array::push(ts, TyName(\"__EqUnknown\"))\n        }\n        i = i + 1\n      }\n      Some(TyTuple(ts))\n    },\n    EIdent(n, _) => if n == \"None\" {\n      Some(TyApp(\"Option\", Array::slice([\n        TyName(\"__EqUnknown\")\n      ], 0, 1)))\n    } else {\n      None\n    },\n    ECall(callee, args, _) => match callee {\n      EIdent(\"Option::Some\", _) => if Array::length(args) == 1 {\n        let pt = match infer_static_eq_type(Array::get(args, 0)) {\n          Some(t) => t,\n          None => TyName(\"__EqUnknown\")\n        }\n        Some(TyApp(\"Option\", Array::slice([\n          pt\n        ], 0, 1)))\n      } else {\n        None\n      },\n      EIdent(\"Result::Ok\", _) => if Array::length(args) == 1 {\n        let pt = match infer_static_eq_type(Array::get(args, 0)) {\n          Some(t) => t,\n          None => TyName(\"__EqUnknown\")\n        }\n        Some(TyApp(\"Result\", Array::slice([\n          pt,\n          TyName(\"__EqUnknown\")\n        ], 0, 2)))\n      } else {\n        None\n      },\n      EIdent(\"Result::Err\", _) => if Array::length(args) == 1 {\n        let pt = match infer_static_eq_type(Array::get(args, 0)) {\n          Some(t) => t,\n          None => TyName(\"__EqUnknown\")\n        }\n        Some(TyApp(\"Result\", Array::slice([\n          TyName(\"__EqUnknown\"),\n          pt\n        ], 0, 2)))\n      } else {\n        None\n      },\n      EIdent(\"Some\", _) => if Array::length(args) == 1 {\n        let pt = match infer_static_eq_type(Array::get(args, 0)) {\n          Some(t) => t,\n          None => TyName(\"__EqUnknown\")\n        }\n        Some(TyApp(\"Option\", Array::slice([\n          pt\n        ], 0, 1)))\n      } else {\n        None\n      },\n      EIdent(\"Ok\", _) => if Array::length(args) == 1 {\n        let pt = match infer_static_eq_type(Array::get(args, 0)) {\n          Some(t) => t,\n          None => TyName(\"__EqUnknown\")\n        }\n        Some(TyApp(\"Result\", Array::slice([\n          pt,\n          TyName(\"__EqUnknown\")\n        ], 0, 2)))\n      } else {\n        None\n      },\n      EIdent(\"Err\", _) => if Array::length(args) == 1 {\n        let pt = match infer_static_eq_type(Array::get(args, 0)) {\n          Some(t) => t,\n          None => TyName(\"__EqUnknown\")\n        }\n        Some(TyApp(\"Result\", Array::slice([\n          TyName(\"__EqUnknown\"),\n          pt\n        ], 0, 2)))\n      } else {\n        None\n      },\n      _ => None\n    },\n    _ => None\n  }\n}\n\nfn infer_static_eq_type_binop(l: Expr, r: Expr) -> Option[TypeExpr] {\n  let lt = infer_static_eq_type(l)\n  let rt = infer_static_eq_type(r)\n  match lt {\n    Some(lty) => if ty_contains_eq_unknown(lty) {\n      match rt {\n        Some(rty) => if ty_contains_eq_unknown(rty) {\n          Some(lty)\n        } else {\n          Some(rty)\n        },\n        None => Some(lty)\n      }\n    } else {\n      Some(lty)\n    },\n    None => rt\n  }\n}\n\nfn static_eq_dispatchable(t: TypeExpr) -> Bool {\n  match t {\n    TyApp(n, args) => (n == \"Option\" && Array::length(args) == 1) || (n == \"Result\" && Array::length(args) == 2) || (n == \"Array\" && Array::length(args) == 1),\n    TyTuple(_) => true,\n    _ => false\n  }\n}\n\nfn collect_bare_array_eq_keys(e: Expr, acc: Array[TypeExpr], acc_keys: Array[String]) -> Unit {\n  match e {\n    EBinOp(op, l, r) => {\n      if op == \"==\" || op == \"!=\" {\n        let et = match infer_earray_elem_type(l) {\n          Some(t) => Some(t),\n          None => infer_earray_elem_type(r)\n        }\n        match et {\n          Some(t) => {\n            let k = type_key(t)\n            if !str_array_contains(acc_keys, k) {\n              Array::push(acc, t)\n              Array::push(acc_keys, k)\n            } else {\n              ()\n            }\n            collect_array_elem_types(t, acc, acc_keys)\n          },\n          None => ()\n        }\n        let sty = infer_static_eq_type_binop(l, r)\n        match sty {\n          Some(t2) => collect_array_elem_types(t2, acc, acc_keys),\n          None => ()\n        }\n      } else {\n        ()\n      }\n      collect_bare_array_eq_keys(l, acc, acc_keys)\n      collect_bare_array_eq_keys(r, acc, acc_keys)\n    },\n    EInt(_) => (),\n    EFloat(_) => (),\n    EString(_) => (),\n    EBool(_) => (),\n    EIdent(_, _) => (),\n    EUnit => (),\n    ETuple(es) => collect_bare_array_eq_keys_list(es, acc, acc_keys),\n    EArray(es) => collect_bare_array_eq_keys_list(es, acc, acc_keys),\n    ERecord(_, fs, _) => {\n      let mut i = 0\n      while i < Array::length(fs) {\n        let (_, fe) = Array::get(fs, i)\n        collect_bare_array_eq_keys(fe, acc, acc_keys)\n        i = i + 1\n      }\n    },\n    EMap(fs) => {\n      let mut i = 0\n      while i < Array::length(fs) {\n        let (_, fe) = Array::get(fs, i)\n        collect_bare_array_eq_keys(fe, acc, acc_keys)\n        i = i + 1\n      }\n    },\n    EIf(c, t, el) => {\n      collect_bare_array_eq_keys(c, acc, acc_keys)\n      collect_bare_array_eq_keys(t, acc, acc_keys)\n      collect_bare_array_eq_keys(el, acc, acc_keys)\n    },\n    ELet(_, v, b, _) => {\n      collect_bare_array_eq_keys(v, acc, acc_keys)\n      collect_bare_array_eq_keys(b, acc, acc_keys)\n    },\n    ELetRec(_, v, b) => {\n      collect_bare_array_eq_keys(v, acc, acc_keys)\n      collect_bare_array_eq_keys(b, acc, acc_keys)\n    },\n    ELetMut(_, v, b, _) => {\n      collect_bare_array_eq_keys(v, acc, acc_keys)\n      collect_bare_array_eq_keys(b, acc, acc_keys)\n    },\n    EAssign(_, v, c) => {\n      collect_bare_array_eq_keys(v, acc, acc_keys)\n      collect_bare_array_eq_keys(c, acc, acc_keys)\n    },\n    EAssignOp(_, _, v, c) => {\n      collect_bare_array_eq_keys(v, acc, acc_keys)\n      collect_bare_array_eq_keys(c, acc, acc_keys)\n    },\n    ESeq(a, b) => {\n      collect_bare_array_eq_keys(a, acc, acc_keys)\n      collect_bare_array_eq_keys(b, acc, acc_keys)\n    },\n    EMatch(s, arms) => {\n      collect_bare_array_eq_keys(s, acc, acc_keys)\n      collect_bare_array_eq_keys_arms(arms, acc, acc_keys)\n    },\n    EHandle(s, arms) => {\n      collect_bare_array_eq_keys(s, acc, acc_keys)\n      collect_bare_array_eq_keys_arms(arms, acc, acc_keys)\n    },\n    EWhile(c, b) => {\n      collect_bare_array_eq_keys(c, acc, acc_keys)\n      collect_bare_array_eq_keys(b, acc, acc_keys)\n    },\n    ELoop(params, b) => {\n      let mut i = 0\n      while i < Array::length(params) {\n        let (_, init) = Array::get(params, i)\n        collect_bare_array_eq_keys(init, acc, acc_keys)\n        i = i + 1\n      }\n      collect_bare_array_eq_keys(b, acc, acc_keys)\n    },\n    EForIn(_, _, it, b) => {\n      collect_bare_array_eq_keys(it, acc, acc_keys)\n      collect_bare_array_eq_keys(b, acc, acc_keys)\n    },\n    ECall(callee, args, _) => {\n      collect_bare_array_eq_keys(callee, acc, acc_keys)\n      collect_bare_array_eq_keys_list(args, acc, acc_keys)\n    },\n    EUnaryOp(_, x) => collect_bare_array_eq_keys(x, acc, acc_keys),\n    EFn(_, _, _, _, _, b) => collect_bare_array_eq_keys(b, acc, acc_keys),\n    EDot(o, _, _, _) => collect_bare_array_eq_keys(o, acc, acc_keys),\n    ELabeledArg(_, _, b) => collect_bare_array_eq_keys(b, acc, acc_keys),\n    EReturn(x) => collect_bare_array_eq_keys(x, acc, acc_keys),\n    EBreak(opt) => match opt {\n      Some(x) => collect_bare_array_eq_keys(x, acc, acc_keys),\n      None => ()\n    },\n    EContinue(es) => collect_bare_array_eq_keys_list(es, acc, acc_keys),\n    ESpread(x) => collect_bare_array_eq_keys(x, acc, acc_keys),\n    _ => ()\n  }\n}\n\nfn collect_bare_array_eq_keys_list(es: Array[Expr], acc: Array[TypeExpr], acc_keys: Array[String]) -> Unit {\n  let mut i = 0\n  while i < Array::length(es) {\n    collect_bare_array_eq_keys(Array::get(es, i), acc, acc_keys)\n    i = i + 1\n  }\n}\n\nfn collect_bare_array_eq_keys_arms(arms: Array[(Pat, Expr)], acc: Array[TypeExpr], acc_keys: Array[String]) -> Unit {\n  let mut i = 0\n  while i < Array::length(arms) {\n    let (_, b) = Array::get(arms, i)\n    collect_bare_array_eq_keys(b, acc, acc_keys)\n    i = i + 1\n  }\n}\n\nfn collect_decl_type_names(stmts: Array[Stmt]) -> Array[String] {\n  let out = empty_str_array()\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SStruct(_, name, _, _, _, _) => Array::push(out, name),\n      SEnum(_, ename, _, _, _) => Array::push(out, ename),\n      _ => ()\n    }\n    i = i + 1\n  }\n  out\n}\n\nexport fn desugar_derives(stmts: Array[Stmt]) -> Unit {\n  let gen = empty_stmt_list()\n  let known_types = collect_decl_type_names(stmts)\n  let arr_elems = empty_type_exprs()\n  let arr_keys = empty_str_array()\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SStruct(_, name, fields, derives, _, _) => {\n        if (str_array_contains(derives, \"Show\") || str_array_contains(derives, \"Hash\")) && !top_level_fn_exists(stmts, qualified_name(name, \"to_string\")) {\n          Array::push(gen, gen_show_fn(name, fields, known_types))\n        } else {\n          ()\n        }\n        if str_array_contains(derives, \"Hash\") && !top_level_fn_exists(stmts, qualified_name(name, \"hash_key\")) {\n          Array::push(gen, gen_hash_key_fn(name))\n        } else {\n          ()\n        }\n        if str_array_contains(derives, \"Show\") || str_array_contains(derives, \"Hash\") {\n          let mut fi = 0\n          while fi < Array::length(fields) {\n            let (_, fty) = Array::get(fields, fi)\n            collect_show_array_elems(fty, arr_elems, arr_keys)\n            fi = fi + 1\n          }\n        } else {\n          ()\n        }\n        if str_array_contains(derives, \"Ord\") && !top_level_fn_exists(stmts, qualified_name(name, \"compare\")) {\n          Array::push(gen, gen_compare_fn(name, fields))\n        } else {\n          ()\n        }\n        if str_array_contains(derives, \"Default\") && !top_level_fn_exists(stmts, qualified_name(name, \"default\")) {\n          Array::push(gen, gen_default_fn(name, fields, known_types))\n        } else {\n          ()\n        }\n        if !top_level_fn_exists(stmts, qualified_name(name, \"equals\")) {\n          Array::push(gen, gen_eq_fn(name, fields, known_types))\n        } else {\n          ()\n        }\n      },\n      SEnum(_, ename, _, variants, derives) => {\n        if (str_array_contains(derives, \"Show\") || str_array_contains(derives, \"Hash\")) && !top_level_fn_exists(stmts, qualified_name(ename, \"to_string\")) {\n          Array::push(gen, gen_enum_show_fn(ename, variants, known_types))\n        } else {\n          ()\n        }\n        if str_array_contains(derives, \"Hash\") && !top_level_fn_exists(stmts, qualified_name(ename, \"hash_key\")) {\n          Array::push(gen, gen_hash_key_fn(ename))\n        } else {\n          ()\n        }\n        if str_array_contains(derives, \"Show\") || str_array_contains(derives, \"Hash\") {\n          let mut vi = 0\n          while vi < Array::length(variants) {\n            let (_, ftypes) = Array::get(variants, vi)\n            let mut ti = 0\n            while ti < Array::length(ftypes) {\n              collect_show_array_elems(Array::get(ftypes, ti), arr_elems, arr_keys)\n              ti = ti + 1\n            }\n            vi = vi + 1\n          }\n        } else {\n          ()\n        }\n        if str_array_contains(derives, \"Ord\") && !top_level_fn_exists(stmts, qualified_name(ename, \"compare\")) {\n          Array::push(gen, gen_enum_compare_fn(ename, variants, known_types))\n        } else {\n          ()\n        }\n        if str_array_contains(derives, \"Default\") && !top_level_fn_exists(stmts, qualified_name(ename, \"default\")) {\n          Array::push(gen, gen_enum_default_fn(ename, variants, known_types))\n        } else {\n          ()\n        }\n        if !top_level_fn_exists(stmts, qualified_name(ename, \"equals\")) {\n          Array::push(gen, gen_enum_eq_fn(ename, variants, known_types))\n        } else {\n          ()\n        }\n      },\n      _ => ()\n    }\n    i = i + 1\n  }\n  let elem_types = empty_type_exprs()\n  let elem_keys = empty_str_array()\n  let mut si = 0\n  while si < Array::length(stmts) {\n    match Array::get(stmts, si) {\n      SStruct(_, _, fields, _, _, _) => {\n        let mut fi = 0\n        while fi < Array::length(fields) {\n          let (_, fty) = Array::get(fields, fi)\n          collect_array_elem_types(fty, elem_types, elem_keys)\n          fi = fi + 1\n        }\n      },\n      SEnum(_, _, _, variants, _) => {\n        let mut vi = 0\n        while vi < Array::length(variants) {\n          let (_, ftypes) = Array::get(variants, vi)\n          let mut ti = 0\n          while ti < Array::length(ftypes) {\n            collect_array_elem_types(Array::get(ftypes, ti), elem_types, elem_keys)\n            ti = ti + 1\n          }\n          vi = vi + 1\n        }\n      },\n      SLet(_, _, _, _, e) => collect_bare_array_eq_keys(e, elem_types, elem_keys),\n      SLetMut(_, _, e) => collect_bare_array_eq_keys(e, elem_types, elem_keys),\n      SExpr(e) => collect_bare_array_eq_keys(e, elem_types, elem_keys),\n      STest(_, e) => collect_bare_array_eq_keys(e, elem_types, elem_keys),\n      SBench(_, e) => collect_bare_array_eq_keys(e, elem_types, elem_keys),\n      _ => ()\n    }\n    si = si + 1\n  }\n  let mut wi = 0\n  while wi < Array::length(elem_types) {\n    collect_array_elem_types(Array::get(elem_types, wi), elem_types, elem_keys)\n    wi = wi + 1\n  }\n  let mut ei = 0\n  while ei < Array::length(elem_types) {\n    let et = Array::get(elem_types, ei)\n    if !top_level_fn_exists(stmts, arr_equals_name(et)) {\n      Array::push(gen, gen_arr_equals_fn(et, known_types))\n    } else {\n      ()\n    }\n    ei = ei + 1\n  }\n  let mut wi2 = 0\n  while wi2 < Array::length(arr_elems) {\n    collect_show_array_elems(Array::get(arr_elems, wi2), arr_elems, arr_keys)\n    wi2 = wi2 + 1\n  }\n  let mut ei2 = 0\n  while ei2 < Array::length(arr_elems) {\n    let et2 = Array::get(arr_elems, ei2)\n    if !top_level_fn_exists(stmts, arr_to_string_name(et2)) {\n      Array::push(gen, gen_arr_to_string_fn(et2, known_types))\n    } else {\n      ()\n    }\n    ei2 = ei2 + 1\n  }\n  let mut g = 0\n  while g < Array::length(gen) {\n    Array::push(stmts, Array::get(gen, g))\n    g = g + 1\n  }\n}\n\nfn empty_stmt_list() -> Array[Stmt] {\n  array_empty()\n}\n\nfn struct_decl_exists(stmts: Array[Stmt], name: String) -> Bool {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SStruct(_, sname, _, _, _, _) => if sname == name {\n        found = true\n        i = Array::length(stmts)\n      } else {\n        i = i + 1\n      },\n      _ => {\n        i = i + 1\n      }\n    }\n  }\n  found\n}\n\nfn dlh_name_ok(n: String) -> Bool {\n  if n == \"perform\" || n == \"throw\" || n == \"resume\" {\n    true\n  } else if String::index_of(n, \"::\") >= 0 {\n    true\n  } else if String::length(n) > 0 {\n    let c = String::char_code_at(n, 0)\n    c >= 65 && c <= 90\n  } else {\n    false\n  }\n}\n\nfn dlh_with(arr: Array[String], name: String) -> Array[String] {\n  let out = Array::slice(arr, 0, Array::length(arr))\n  Array::push(out, name)\n  out\n}\n\nfn dlh_contains(arr: Array[String], name: String) -> Bool {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(arr) {\n    if Array::get(arr, i) == name {\n      found = true\n      i = Array::length(arr)\n    } else {\n      i = i + 1\n    }\n  }\n  found\n}\n\nfn dlh_strip_tilde(n: String) -> String {\n  let ln = String::length(n)\n  if ln > 0 && n[ln - 1: ln] == \"~\" {\n    n[0: ln - 1]\n  } else {\n    n\n  }\n}\n\nfn dlh_pat_binds(p: Pat, out: Array[String]) -> Unit {\n  match p {\n    PBind(n) => Array::push(out, n),\n    PCtor(_, args) => {\n      let mut i = 0\n      while i < Array::length(args) {\n        dlh_pat_binds(Array::get(args, i), out)\n        i = i + 1\n      }\n    },\n    PTuple(ps) => {\n      let mut i = 0\n      while i < Array::length(ps) {\n        dlh_pat_binds(Array::get(ps, i), out)\n        i = i + 1\n      }\n    },\n    POr(a, b) => {\n      dlh_pat_binds(a, out)\n      dlh_pat_binds(b, out)\n    },\n    PStruct(_, fields) => {\n      let mut i = 0\n      while i < Array::length(fields) {\n        let (_, fp) = Array::get(fields, i)\n        dlh_pat_binds(fp, out)\n        i = i + 1\n      }\n    },\n    _ => ()\n  }\n}\n\nfn dlh_has_perform(expr: Expr) -> Bool {\n  match expr {\n    ECall(callee, args, _) => {\n      let head = match callee {\n        EIdent(n, _) => n == \"perform\",\n        _ => false\n      }\n      let is_throw_shape = if head && Array::length(args) == 1 {\n        match Array::get(args, 0) {\n          ECall(op_callee, _, _) => match op_callee {\n            EIdent(op_n, _) => is_exception_throw_operation(op_n),\n            _ => false\n          },\n          _ => false\n        }\n      } else {\n        false\n      }\n      if head && !is_throw_shape {\n        true\n      } else {\n        let mut i = 0\n        let mut found = dlh_has_perform(callee)\n        while i < Array::length(args) {\n          if dlh_has_perform(Array::get(args, i)) {\n            found = true\n          } else {\n            ()\n          }\n          i = i + 1\n        }\n        found\n      }\n    },\n    EBinOp(_, l, r) => dlh_has_perform(l) || dlh_has_perform(r),\n    EUnaryOp(_, e) => dlh_has_perform(e),\n    EIf(c, t, e) => dlh_has_perform(c) || dlh_has_perform(t) || dlh_has_perform(e),\n    ELet(_, v, b, _) => dlh_has_perform(v) || dlh_has_perform(b),\n    ELetRec(_, v, b) => dlh_has_perform(v) || dlh_has_perform(b),\n    ELetMut(_, v, b, _) => dlh_has_perform(v) || dlh_has_perform(b),\n    EAssign(_, v, c) => dlh_has_perform(v) || dlh_has_perform(c),\n    EAssignOp(_, _, v, c) => dlh_has_perform(v) || dlh_has_perform(c),\n    ESeq(a, b) => dlh_has_perform(a) || dlh_has_perform(b),\n    EWhile(c, b) => dlh_has_perform(c) || dlh_has_perform(b),\n    EForIn(_, _, it, b) => dlh_has_perform(it) || dlh_has_perform(b),\n    EDot(o, _, _, _) => dlh_has_perform(o),\n    ELabeledArg(_, _, e) => dlh_has_perform(e),\n    EReturn(e) => dlh_has_perform(e),\n    EMatch(s, arms) => dlh_has_perform(s) || dlh_has_perform_arms(arms),\n    EHandle(s, _) => dlh_has_perform(s),\n    _ => false\n  }\n}\n\nfn dlh_collect_performed_effect_names(expr: Expr, out: Array[String]) -> Unit {\n  match expr {\n    ECall(callee, args, _) => {\n      let head = match callee {\n        EIdent(n, _) => n == \"perform\",\n        _ => false\n      }\n      if head && Array::length(args) == 1 {\n        let operand = Array::get(args, 0)\n        let qname = match operand {\n          EIdent(qn, _) => Some(qn),\n          ECall(op_callee, _, _) => match op_callee {\n            EIdent(qn, _) => Some(qn),\n            _ => None\n          },\n          _ => None\n        }\n        match qname {\n          Some(qn) => if !is_exception_throw_operation(qn) {\n            let ename = match split_qualified(qn) {\n              Some((h, _)) => h,\n              None => qn\n            }\n            if dlh_contains(out, ename) {\n              ()\n            } else {\n              Array::push(out, ename)\n            }\n          } else {\n            ()\n          },\n          None => ()\n        }\n      } else {\n        ()\n      }\n      dlh_collect_performed_effect_names(callee, out)\n      let mut i = 0\n      while i < Array::length(args) {\n        dlh_collect_performed_effect_names(Array::get(args, i), out)\n        i = i + 1\n      }\n    },\n    EBinOp(_, l, r) => {\n      dlh_collect_performed_effect_names(l, out)\n      dlh_collect_performed_effect_names(r, out)\n    },\n    EUnaryOp(_, e) => dlh_collect_performed_effect_names(e, out),\n    EIf(c, t, e) => {\n      dlh_collect_performed_effect_names(c, out)\n      dlh_collect_performed_effect_names(t, out)\n      dlh_collect_performed_effect_names(e, out)\n    },\n    ELet(_, v, b, _) => {\n      dlh_collect_performed_effect_names(v, out)\n      dlh_collect_performed_effect_names(b, out)\n    },\n    ELetRec(_, v, b) => {\n      dlh_collect_performed_effect_names(v, out)\n      dlh_collect_performed_effect_names(b, out)\n    },\n    ELetMut(_, v, b, _) => {\n      dlh_collect_performed_effect_names(v, out)\n      dlh_collect_performed_effect_names(b, out)\n    },\n    EAssign(_, v, c) => {\n      dlh_collect_performed_effect_names(v, out)\n      dlh_collect_performed_effect_names(c, out)\n    },\n    EAssignOp(_, _, v, c) => {\n      dlh_collect_performed_effect_names(v, out)\n      dlh_collect_performed_effect_names(c, out)\n    },\n    ESeq(a, b) => {\n      dlh_collect_performed_effect_names(a, out)\n      dlh_collect_performed_effect_names(b, out)\n    },\n    EWhile(c, b) => {\n      dlh_collect_performed_effect_names(c, out)\n      dlh_collect_performed_effect_names(b, out)\n    },\n    EForIn(_, _, it, b) => {\n      dlh_collect_performed_effect_names(it, out)\n      dlh_collect_performed_effect_names(b, out)\n    },\n    EDot(o, _, _, _) => dlh_collect_performed_effect_names(o, out),\n    ELabeledArg(_, _, e) => dlh_collect_performed_effect_names(e, out),\n    EReturn(e) => dlh_collect_performed_effect_names(e, out),\n    EMatch(s, arms) => {\n      dlh_collect_performed_effect_names(s, out)\n      dlh_collect_performed_effect_names_arms(arms, out)\n    },\n    EHandle(s, _) => dlh_collect_performed_effect_names(s, out),\n    _ => ()\n  }\n}\n\nfn dlh_collect_performed_effect_names_arms(arms: Array[(Pat, Expr)], out: Array[String]) -> Unit {\n  let mut i = 0\n  while i < Array::length(arms) {\n    let (_, b) = Array::get(arms, i)\n    dlh_collect_performed_effect_names(b, out)\n    i = i + 1\n  }\n}\n\nfn dlh_join_comma(names: Array[String]) -> String {\n  let mut out = \"\"\n  let mut i = 0\n  while i < Array::length(names) {\n    if i == 0 {\n      out = Array::get(names, i)\n    } else {\n      out = String::concat(String::concat(out, \", \"), Array::get(names, i))\n    }\n    i = i + 1\n  }\n  out\n}\n\nfn dlh_has_perform_arms(arms: Array[(Pat, Expr)]) -> Bool {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(arms) {\n    let (_, b) = Array::get(arms, i)\n    if dlh_has_perform(b) {\n      found = true\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  found\n}\n\nfn dlh_scan_free(expr: Expr, bound: Array[String], bad: Array[String]) -> Unit {\n  match expr {\n    EIdent(n, _) => if dlh_name_ok(n) || dlh_contains(bound, n) {\n      ()\n    } else {\n      Array::push(bad, n)\n    },\n    EBinOp(_, l, r) => {\n      dlh_scan_free(l, bound, bad)\n      dlh_scan_free(r, bound, bad)\n    },\n    EUnaryOp(_, e) => dlh_scan_free(e, bound, bad),\n    ECall(callee, args, _) => {\n      dlh_scan_free(callee, bound, bad)\n      let mut i = 0\n      while i < Array::length(args) {\n        dlh_scan_free(Array::get(args, i), bound, bad)\n        i = i + 1\n      }\n    },\n    ETuple(es) => {\n      let mut i = 0\n      while i < Array::length(es) {\n        dlh_scan_free(Array::get(es, i), bound, bad)\n        i = i + 1\n      }\n    },\n    EArray(es) => {\n      let mut i = 0\n      while i < Array::length(es) {\n        dlh_scan_free(Array::get(es, i), bound, bad)\n        i = i + 1\n      }\n    },\n    ESpread(e) => dlh_scan_free(e, bound, bad),\n    EContinue(es) => {\n      let mut i = 0\n      while i < Array::length(es) {\n        dlh_scan_free(Array::get(es, i), bound, bad)\n        i = i + 1\n      }\n    },\n    ERecord(_, fs, _) => {\n      let mut i = 0\n      while i < Array::length(fs) {\n        let (_, v) = Array::get(fs, i)\n        dlh_scan_free(v, bound, bad)\n        i = i + 1\n      }\n    },\n    EMap(fs) => {\n      let mut i = 0\n      while i < Array::length(fs) {\n        let (_, v) = Array::get(fs, i)\n        dlh_scan_free(v, bound, bad)\n        i = i + 1\n      }\n    },\n    EIf(c, t, e) => {\n      dlh_scan_free(c, bound, bad)\n      dlh_scan_free(t, bound, bad)\n      dlh_scan_free(e, bound, bad)\n    },\n    ELet(name, v, b, _) => {\n      dlh_scan_free(v, bound, bad)\n      dlh_scan_free(b, dlh_with(bound, name), bad)\n    },\n    ELetRec(name, v, b) => {\n      let b2 = dlh_with(bound, name)\n      dlh_scan_free(v, b2, bad)\n      dlh_scan_free(b, b2, bad)\n    },\n    ELetMut(name, v, b, _) => {\n      dlh_scan_free(v, bound, bad)\n      dlh_scan_free(b, dlh_with(bound, name), bad)\n    },\n    EAssign(name, v, c) => {\n      if dlh_name_ok(name) || dlh_contains(bound, name) {\n        ()\n      } else {\n        Array::push(bad, name)\n      }\n      dlh_scan_free(v, bound, bad)\n      dlh_scan_free(c, bound, bad)\n    },\n    EAssignOp(name, _, v, c) => {\n      if dlh_name_ok(name) || dlh_contains(bound, name) {\n        ()\n      } else {\n        Array::push(bad, name)\n      }\n      dlh_scan_free(v, bound, bad)\n      dlh_scan_free(c, bound, bad)\n    },\n    ESeq(a, b) => {\n      dlh_scan_free(a, bound, bad)\n      dlh_scan_free(b, bound, bad)\n    },\n    EWhile(c, b) => {\n      dlh_scan_free(c, bound, bad)\n      dlh_scan_free(b, bound, bad)\n    },\n    EForIn(name, idxn, it, b) => {\n      dlh_scan_free(it, bound, bad)\n      let mut b2 = dlh_with(bound, name)\n      b2 = match idxn {\n        Some(inm) => dlh_with(b2, inm),\n        None => b2\n      }\n      dlh_scan_free(b, b2, bad)\n    },\n    EDot(o, _, _, _) => dlh_scan_free(o, bound, bad),\n    ELabeledArg(_, _, e) => dlh_scan_free(e, bound, bad),\n    EReturn(e) => dlh_scan_free(e, bound, bad),\n    EBreak(opt) => match opt {\n      Some(e) => dlh_scan_free(e, bound, bad),\n      None => ()\n    },\n    EFn(_, _, params, _, _, body) => {\n      let mut inner = bound\n      let mut i = 0\n      while i < Array::length(params) {\n        let (pn, _) = Array::get(params, i)\n        inner = dlh_with(inner, dlh_strip_tilde(pn))\n        i = i + 1\n      }\n      dlh_scan_free(body, inner, bad)\n    },\n    EMatch(s, arms) => {\n      dlh_scan_free(s, bound, bad)\n      dlh_scan_arms(arms, bound, bad)\n    },\n    EHandle(s, arms) => {\n      dlh_scan_free(s, bound, bad)\n      dlh_scan_arms(arms, bound, bad)\n    },\n    ELoop(params, b) => {\n      let mut b2 = bound\n      let mut i = 0\n      while i < Array::length(params) {\n        let (pn, init) = Array::get(params, i)\n        dlh_scan_free(init, bound, bad)\n        b2 = dlh_with(b2, pn)\n        i = i + 1\n      }\n      dlh_scan_free(b, b2, bad)\n    },\n    _ => ()\n  }\n}\n\nfn dlh_scan_arms(arms: Array[(Pat, Expr)], bound: Array[String], bad: Array[String]) -> Unit {\n  let mut i = 0\n  while i < Array::length(arms) {\n    let (p, b) = Array::get(arms, i)\n    let mut ab = bound\n    let pb = empty_str_array()\n    dlh_pat_binds(p, pb)\n    let mut j = 0\n    while j < Array::length(pb) {\n      ab = dlh_with(ab, Array::get(pb, j))\n      j = j + 1\n    }\n    dlh_scan_free(b, ab, bad)\n    i = i + 1\n  }\n}\n\nfn dlh_subst(expr: Expr, from: String, to: String) -> Expr {\n  match expr {\n    EIdent(n, off) => if n == from {\n      EIdent(to, off)\n    } else {\n      expr\n    },\n    EBinOp(op, l, r) => EBinOp(op, dlh_subst(l, from, to), dlh_subst(r, from, to)),\n    EUnaryOp(op, e) => EUnaryOp(op, dlh_subst(e, from, to)),\n    ECall(callee, args, off) => ECall(dlh_subst(callee, from, to), for a in args {\n      dlh_subst(a, from, to)\n    }, off),\n    ETuple(es) => ETuple(for e in es {\n      dlh_subst(e, from, to)\n    }),\n    EArray(es) => EArray(for e in es {\n      dlh_subst(e, from, to)\n    }),\n    ESpread(e) => ESpread(dlh_subst(e, from, to)),\n    EContinue(es) => EContinue(for e in es {\n      dlh_subst(e, from, to)\n    }),\n    ERecord(rn, fs, targs) => {\n      let out = array_empty()\n      let mut i = 0\n      while i < Array::length(fs) {\n        let (k, v) = Array::get(fs, i)\n        Array::push(out, (k, dlh_subst(v, from, to)))\n        i = i + 1\n      }\n      ERecord(rn, out, targs)\n    },\n    EMap(fs) => {\n      let out = array_empty()\n      let mut i = 0\n      while i < Array::length(fs) {\n        let (k, v) = Array::get(fs, i)\n        Array::push(out, (k, dlh_subst(v, from, to)))\n        i = i + 1\n      }\n      EMap(out)\n    },\n    EIf(c, t, e) => EIf(dlh_subst(c, from, to), dlh_subst(t, from, to), dlh_subst(e, from, to)),\n    ELet(name, v, b, soff) => ELet(name, dlh_subst(v, from, to), if name == from {\n      b\n    } else {\n      dlh_subst(b, from, to)\n    }, soff),\n    ELetRec(name, v, b) => if name == from {\n      ELetRec(name, v, b)\n    } else {\n      ELetRec(name, dlh_subst(v, from, to), dlh_subst(b, from, to))\n    },\n    ELetMut(name, v, b, soff) => ELetMut(name, dlh_subst(v, from, to), if name == from {\n      b\n    } else {\n      dlh_subst(b, from, to)\n    }, soff),\n    EAssign(name, v, c) => EAssign(name, dlh_subst(v, from, to), dlh_subst(c, from, to)),\n    EAssignOp(name, op, v, c) => EAssignOp(name, op, dlh_subst(v, from, to), dlh_subst(c, from, to)),\n    ESeq(a, b) => ESeq(dlh_subst(a, from, to), dlh_subst(b, from, to)),\n    EWhile(c, b) => EWhile(dlh_subst(c, from, to), dlh_subst(b, from, to)),\n    EForIn(name, idxn, it, b) => {\n      let shadow = name == from || (match idxn {\n        Some(inm) => inm == from,\n        None => false\n      })\n      EForIn(name, idxn, dlh_subst(it, from, to), if shadow {\n        b\n      } else {\n        dlh_subst(b, from, to)\n      })\n    },\n    EDot(o, f, off, fdoff) => EDot(dlh_subst(o, from, to), f, off, fdoff),\n    ELabeledArg(l, m, e) => ELabeledArg(l, m, dlh_subst(e, from, to)),\n    EReturn(e) => EReturn(dlh_subst(e, from, to)),\n    EBreak(opt) => match opt {\n      Some(e) => EBreak(Some(dlh_subst(e, from, to))),\n      None => expr\n    },\n    EFn(tp, bnds, params, rt, eff, body) => {\n      let mut shadow = false\n      let mut i = 0\n      while i < Array::length(params) {\n        let (pn, _) = Array::get(params, i)\n        if dlh_strip_tilde(pn) == from {\n          shadow = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      if shadow {\n        expr\n      } else {\n        EFn(tp, bnds, params, rt, eff, dlh_subst(body, from, to))\n      }\n    },\n    EMatch(s, arms) => EMatch(dlh_subst(s, from, to), dlh_subst_arms(arms, from, to)),\n    EHandle(s, arms) => EHandle(dlh_subst(s, from, to), dlh_subst_arms(arms, from, to)),\n    ELoop(params, b) => {\n      let mut shadow = false\n      let out = array_empty()\n      let mut i = 0\n      while i < Array::length(params) {\n        let (pn, init) = Array::get(params, i)\n        if pn == from {\n          shadow = true\n        } else {\n          ()\n        }\n        Array::push(out, (pn, dlh_subst(init, from, to)))\n        i = i + 1\n      }\n      ELoop(out, if shadow {\n        b\n      } else {\n        dlh_subst(b, from, to)\n      })\n    },\n    _ => expr\n  }\n}\n\nfn dlh_subst_arms(arms: Array[(Pat, Expr)], from: String, to: String) -> Array[(Pat, Expr)] {\n  let out = array_empty()\n  let mut i = 0\n  while i < Array::length(arms) {\n    let (p, b) = Array::get(arms, i)\n    let pb = empty_str_array()\n    dlh_pat_binds(p, pb)\n    let shadow = dlh_contains(pb, from)\n    Array::push(out, (p, if shadow {\n      b\n    } else {\n      dlh_subst(b, from, to)\n    }))\n    i = i + 1\n  }\n  out\n}\n\nfn dlh_mocd_scan(expr: Expr, marker: String, bad: Array[Bool]) -> Unit {\n  match expr {\n    EIdent(n, _) => if n == marker {\n      Array::set(bad, 0, true)\n    } else {\n      ()\n    },\n    ECall(callee, args, _) => {\n      match callee {\n        EIdent(n, _) => if n == marker {\n          ()\n        } else {\n          dlh_mocd_scan(callee, marker, bad)\n        },\n        _ => dlh_mocd_scan(callee, marker, bad)\n      }\n      let mut i = 0\n      while i < Array::length(args) {\n        dlh_mocd_scan(Array::get(args, i), marker, bad)\n        i = i + 1\n      }\n    },\n    EBinOp(_, l, r) => {\n      dlh_mocd_scan(l, marker, bad)\n      dlh_mocd_scan(r, marker, bad)\n    },\n    EUnaryOp(_, e) => dlh_mocd_scan(e, marker, bad),\n    ETuple(es) => {\n      let mut i = 0\n      while i < Array::length(es) {\n        dlh_mocd_scan(Array::get(es, i), marker, bad)\n        i = i + 1\n      }\n    },\n    EArray(es) => {\n      let mut i = 0\n      while i < Array::length(es) {\n        dlh_mocd_scan(Array::get(es, i), marker, bad)\n        i = i + 1\n      }\n    },\n    ESpread(e) => dlh_mocd_scan(e, marker, bad),\n    EContinue(es) => {\n      let mut i = 0\n      while i < Array::length(es) {\n        dlh_mocd_scan(Array::get(es, i), marker, bad)\n        i = i + 1\n      }\n    },\n    ERecord(_, fs, _) => {\n      let mut i = 0\n      while i < Array::length(fs) {\n        let (_, v) = Array::get(fs, i)\n        dlh_mocd_scan(v, marker, bad)\n        i = i + 1\n      }\n    },\n    EMap(fs) => {\n      let mut i = 0\n      while i < Array::length(fs) {\n        let (_, v) = Array::get(fs, i)\n        dlh_mocd_scan(v, marker, bad)\n        i = i + 1\n      }\n    },\n    EIf(c, t, e) => {\n      dlh_mocd_scan(c, marker, bad)\n      dlh_mocd_scan(t, marker, bad)\n      dlh_mocd_scan(e, marker, bad)\n    },\n    ELet(_, v, b, _) => {\n      dlh_mocd_scan(v, marker, bad)\n      dlh_mocd_scan(b, marker, bad)\n    },\n    ELetRec(_, v, b) => {\n      dlh_mocd_scan(v, marker, bad)\n      dlh_mocd_scan(b, marker, bad)\n    },\n    ELetMut(_, v, b, _) => {\n      dlh_mocd_scan(v, marker, bad)\n      dlh_mocd_scan(b, marker, bad)\n    },\n    EAssign(n, v, c) => {\n      if n == marker {\n        Array::set(bad, 0, true)\n      } else {\n        ()\n      }\n      dlh_mocd_scan(v, marker, bad)\n      dlh_mocd_scan(c, marker, bad)\n    },\n    EAssignOp(n, _, v, c) => {\n      if n == marker {\n        Array::set(bad, 0, true)\n      } else {\n        ()\n      }\n      dlh_mocd_scan(v, marker, bad)\n      dlh_mocd_scan(c, marker, bad)\n    },\n    ESeq(a, b) => {\n      dlh_mocd_scan(a, marker, bad)\n      dlh_mocd_scan(b, marker, bad)\n    },\n    EWhile(c, b) => {\n      dlh_mocd_scan(c, marker, bad)\n      dlh_mocd_scan(b, marker, bad)\n    },\n    EForIn(_, _, it, b) => {\n      dlh_mocd_scan(it, marker, bad)\n      dlh_mocd_scan(b, marker, bad)\n    },\n    EDot(o, _, _, _) => dlh_mocd_scan(o, marker, bad),\n    ELabeledArg(_, _, e) => dlh_mocd_scan(e, marker, bad),\n    EReturn(e) => dlh_mocd_scan(e, marker, bad),\n    EBreak(opt) => match opt {\n      Some(e) => dlh_mocd_scan(e, marker, bad),\n      None => ()\n    },\n    EFn(_, _, _, _, _, body) => dlh_mocd_scan(body, marker, bad),\n    EMatch(s, arms) => {\n      dlh_mocd_scan(s, marker, bad)\n      dlh_mocd_scan_arms(arms, marker, bad)\n    },\n    EHandle(s, arms) => {\n      dlh_mocd_scan(s, marker, bad)\n      dlh_mocd_scan_arms(arms, marker, bad)\n    },\n    ELoop(params, b) => {\n      let mut i = 0\n      while i < Array::length(params) {\n        let (_, init) = Array::get(params, i)\n        dlh_mocd_scan(init, marker, bad)\n        i = i + 1\n      }\n      dlh_mocd_scan(b, marker, bad)\n    },\n    _ => ()\n  }\n}\n\nfn dlh_mocd_scan_arms(arms: Array[(Pat, Expr)], marker: String, bad: Array[Bool]) -> Unit {\n  let mut i = 0\n  while i < Array::length(arms) {\n    let (_, b) = Array::get(arms, i)\n    dlh_mocd_scan(b, marker, bad)\n    i = i + 1\n  }\n}\n\nfn dlh_marker_only_called_directly(expr: Expr, marker: String) -> Bool {\n  let bad = [\n    false\n  ]\n  dlh_mocd_scan(expr, marker, bad)\n  !Array::get(bad, 0)\n}\n\nfn dlh_prepend_and_rename_calls(expr: Expr, marker: String, fresh: String, extra_names: Array[String]) -> Expr {\n  match expr {\n    ECall(callee, args, off) => match callee {\n      EIdent(n, coff) => if n == marker {\n        let extra_args = for en in extra_names {\n          EIdent(en, coff)\n        }\n        ECall(EIdent(fresh, coff), Array::concat(extra_args, for a in args {\n          dlh_prepend_and_rename_calls(a, marker, fresh, extra_names)\n        }), off)\n      } else {\n        ECall(dlh_prepend_and_rename_calls(callee, marker, fresh, extra_names), for a in args {\n          dlh_prepend_and_rename_calls(a, marker, fresh, extra_names)\n        }, off)\n      },\n      _ => ECall(dlh_prepend_and_rename_calls(callee, marker, fresh, extra_names), for a in args {\n        dlh_prepend_and_rename_calls(a, marker, fresh, extra_names)\n      }, off)\n    },\n    EBinOp(op, l, r) => EBinOp(op, dlh_prepend_and_rename_calls(l, marker, fresh, extra_names), dlh_prepend_and_rename_calls(r, marker, fresh, extra_names)),\n    EUnaryOp(op, e) => EUnaryOp(op, dlh_prepend_and_rename_calls(e, marker, fresh, extra_names)),\n    ETuple(es) => ETuple(for e in es {\n      dlh_prepend_and_rename_calls(e, marker, fresh, extra_names)\n    }),\n    EArray(es) => EArray(for e in es {\n      dlh_prepend_and_rename_calls(e, marker, fresh, extra_names)\n    }),\n    ESpread(e) => ESpread(dlh_prepend_and_rename_calls(e, marker, fresh, extra_names)),\n    EContinue(es) => EContinue(for e in es {\n      dlh_prepend_and_rename_calls(e, marker, fresh, extra_names)\n    }),\n    ERecord(rn, fs, targs) => {\n      let out = array_empty()\n      let mut i = 0\n      while i < Array::length(fs) {\n        let (k, v) = Array::get(fs, i)\n        Array::push(out, (k, dlh_prepend_and_rename_calls(v, marker, fresh, extra_names)))\n        i = i + 1\n      }\n      ERecord(rn, out, targs)\n    },\n    EMap(fs) => {\n      let out = array_empty()\n      let mut i = 0\n      while i < Array::length(fs) {\n        let (k, v) = Array::get(fs, i)\n        Array::push(out, (k, dlh_prepend_and_rename_calls(v, marker, fresh, extra_names)))\n        i = i + 1\n      }\n      EMap(out)\n    },\n    EIf(c, t, e) => EIf(dlh_prepend_and_rename_calls(c, marker, fresh, extra_names), dlh_prepend_and_rename_calls(t, marker, fresh, extra_names), dlh_prepend_and_rename_calls(e, marker, fresh, extra_names)),\n    ELet(n, v, b, soff) => ELet(n, dlh_prepend_and_rename_calls(v, marker, fresh, extra_names), dlh_prepend_and_rename_calls(b, marker, fresh, extra_names), soff),\n    ELetRec(n, v, b) => ELetRec(n, dlh_prepend_and_rename_calls(v, marker, fresh, extra_names), dlh_prepend_and_rename_calls(b, marker, fresh, extra_names)),\n    ELetMut(n, v, b, soff) => ELetMut(n, dlh_prepend_and_rename_calls(v, marker, fresh, extra_names), dlh_prepend_and_rename_calls(b, marker, fresh, extra_names), soff),\n    EAssign(n, v, c) => EAssign(n, dlh_prepend_and_rename_calls(v, marker, fresh, extra_names), dlh_prepend_and_rename_calls(c, marker, fresh, extra_names)),\n    EAssignOp(n, op, v, c) => EAssignOp(n, op, dlh_prepend_and_rename_calls(v, marker, fresh, extra_names), dlh_prepend_and_rename_calls(c, marker, fresh, extra_names)),\n    ESeq(a, b) => ESeq(dlh_prepend_and_rename_calls(a, marker, fresh, extra_names), dlh_prepend_and_rename_calls(b, marker, fresh, extra_names)),\n    EWhile(c, b) => EWhile(dlh_prepend_and_rename_calls(c, marker, fresh, extra_names), dlh_prepend_and_rename_calls(b, marker, fresh, extra_names)),\n    EForIn(n, idxn, it, b) => EForIn(n, idxn, dlh_prepend_and_rename_calls(it, marker, fresh, extra_names), dlh_prepend_and_rename_calls(b, marker, fresh, extra_names)),\n    EDot(o, f, off, fdoff) => EDot(dlh_prepend_and_rename_calls(o, marker, fresh, extra_names), f, off, fdoff),\n    ELabeledArg(l, m, e) => ELabeledArg(l, m, dlh_prepend_and_rename_calls(e, marker, fresh, extra_names)),\n    EReturn(e) => EReturn(dlh_prepend_and_rename_calls(e, marker, fresh, extra_names)),\n    EBreak(opt) => EBreak(match opt {\n      Some(e) => Some(dlh_prepend_and_rename_calls(e, marker, fresh, extra_names)),\n      None => None\n    }),\n    EFn(tp, bnds, params, rt, eff, body) => EFn(tp, bnds, params, rt, eff, dlh_prepend_and_rename_calls(body, marker, fresh, extra_names)),\n    EMatch(s, arms) => EMatch(dlh_prepend_and_rename_calls(s, marker, fresh, extra_names), for a in arms {\n      let (p, b) = a\n      (p, dlh_prepend_and_rename_calls(b, marker, fresh, extra_names))\n    }),\n    EHandle(s, arms) => EHandle(dlh_prepend_and_rename_calls(s, marker, fresh, extra_names), for a in arms {\n      let (p, b) = a\n      (p, dlh_prepend_and_rename_calls(b, marker, fresh, extra_names))\n    }),\n    ELoop(params, b) => ELoop(for p in params {\n      let (pn, init) = p\n      (pn, dlh_prepend_and_rename_calls(init, marker, fresh, extra_names))\n    }, dlh_prepend_and_rename_calls(b, marker, fresh, extra_names)),\n    _ => expr\n  }\n}\n\nfn dlh_dedup_names(names: Array[String]) -> Array[String] {\n  let out = array_empty()\n  let mut i = 0\n  while i < Array::length(names) {\n    let n = Array::get(names, i)\n    if dlh_contains(out, n) {\n      ()\n    } else {\n      Array::push(out, n)\n    }\n    i = i + 1\n  }\n  out\n}\n\nfn dlh_names_ever_assigned(expr: Expr, names: Array[String]) -> Bool {\n  let bad = [\n    false\n  ]\n  dlh_naa_scan(expr, names, bad)\n  Array::get(bad, 0)\n}\n\nfn dlh_naa_scan(expr: Expr, names: Array[String], bad: Array[Bool]) -> Unit {\n  match expr {\n    EAssign(n, v, c) => {\n      if dlh_contains(names, n) {\n        Array::set(bad, 0, true)\n      } else {\n        ()\n      }\n      dlh_naa_scan(v, names, bad)\n      dlh_naa_scan(c, names, bad)\n    },\n    EAssignOp(n, _, v, c) => {\n      if dlh_contains(names, n) {\n        Array::set(bad, 0, true)\n      } else {\n        ()\n      }\n      dlh_naa_scan(v, names, bad)\n      dlh_naa_scan(c, names, bad)\n    },\n    ECall(callee, args, _) => {\n      dlh_naa_scan(callee, names, bad)\n      let mut i = 0\n      while i < Array::length(args) {\n        dlh_naa_scan(Array::get(args, i), names, bad)\n        i = i + 1\n      }\n    },\n    EBinOp(_, l, r) => {\n      dlh_naa_scan(l, names, bad)\n      dlh_naa_scan(r, names, bad)\n    },\n    EUnaryOp(_, e) => dlh_naa_scan(e, names, bad),\n    ETuple(es) => {\n      let mut i = 0\n      while i < Array::length(es) {\n        dlh_naa_scan(Array::get(es, i), names, bad)\n        i = i + 1\n      }\n    },\n    EArray(es) => {\n      let mut i = 0\n      while i < Array::length(es) {\n        dlh_naa_scan(Array::get(es, i), names, bad)\n        i = i + 1\n      }\n    },\n    ESpread(e) => dlh_naa_scan(e, names, bad),\n    EContinue(es) => {\n      let mut i = 0\n      while i < Array::length(es) {\n        dlh_naa_scan(Array::get(es, i), names, bad)\n        i = i + 1\n      }\n    },\n    ERecord(_, fs, _) => {\n      let mut i = 0\n      while i < Array::length(fs) {\n        let (_, v) = Array::get(fs, i)\n        dlh_naa_scan(v, names, bad)\n        i = i + 1\n      }\n    },\n    EMap(fs) => {\n      let mut i = 0\n      while i < Array::length(fs) {\n        let (_, v) = Array::get(fs, i)\n        dlh_naa_scan(v, names, bad)\n        i = i + 1\n      }\n    },\n    EIf(c, t, e) => {\n      dlh_naa_scan(c, names, bad)\n      dlh_naa_scan(t, names, bad)\n      dlh_naa_scan(e, names, bad)\n    },\n    ELet(_, v, b, _) => {\n      dlh_naa_scan(v, names, bad)\n      dlh_naa_scan(b, names, bad)\n    },\n    ELetRec(_, v, b) => {\n      dlh_naa_scan(v, names, bad)\n      dlh_naa_scan(b, names, bad)\n    },\n    ELetMut(_, v, b, _) => {\n      dlh_naa_scan(v, names, bad)\n      dlh_naa_scan(b, names, bad)\n    },\n    ESeq(a, b) => {\n      dlh_naa_scan(a, names, bad)\n      dlh_naa_scan(b, names, bad)\n    },\n    EWhile(c, b) => {\n      dlh_naa_scan(c, names, bad)\n      dlh_naa_scan(b, names, bad)\n    },\n    EForIn(_, _, it, b) => {\n      dlh_naa_scan(it, names, bad)\n      dlh_naa_scan(b, names, bad)\n    },\n    EDot(o, _, _, _) => dlh_naa_scan(o, names, bad),\n    ELabeledArg(_, _, e) => dlh_naa_scan(e, names, bad),\n    EReturn(e) => dlh_naa_scan(e, names, bad),\n    EBreak(opt) => match opt {\n      Some(e) => dlh_naa_scan(e, names, bad),\n      None => ()\n    },\n    EFn(_, _, _, _, _, body) => dlh_naa_scan(body, names, bad),\n    EMatch(s, arms) => {\n      dlh_naa_scan(s, names, bad)\n      dlh_naa_scan_arms(arms, names, bad)\n    },\n    EHandle(s, arms) => {\n      dlh_naa_scan(s, names, bad)\n      dlh_naa_scan_arms(arms, names, bad)\n    },\n    ELoop(params, b) => {\n      let mut i = 0\n      while i < Array::length(params) {\n        let (_, init) = Array::get(params, i)\n        dlh_naa_scan(init, names, bad)\n        i = i + 1\n      }\n      dlh_naa_scan(b, names, bad)\n    },\n    _ => ()\n  }\n}\n\nfn dlh_naa_scan_arms(arms: Array[(Pat, Expr)], names: Array[String], bad: Array[Bool]) -> Unit {\n  let mut i = 0\n  while i < Array::length(arms) {\n    let (_, b) = Array::get(arms, i)\n    dlh_naa_scan(b, names, bad)\n    i = i + 1\n  }\n}\n\nfn dlh_row_is_effectful(eff: Option[String]) -> Bool {\n  match eff {\n    Some(s) => String::trim(s) != \"\",\n    None => false\n  }\n}\n\nfn dlh_args_have_literal_efn(args: Array[Expr]) -> Bool {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(args) && !found {\n    match Array::get(args, i) {\n      EFn(_, _, _, _, _, fbody) => if dlh_has_perform(fbody) {\n        found = true\n      } else {\n        ()\n      },\n      ELabeledArg(_, _, inner) => match inner {\n        EFn(_, _, _, _, _, fbody) => if dlh_has_perform(fbody) {\n          found = true\n        } else {\n          ()\n        },\n        _ => ()\n      },\n      _ => ()\n    }\n    i = i + 1\n  }\n  found\n}\n\nfn dlh_letbind_literal_args(callee: Expr, args: Array[Expr], off: Int, ctr: Array[Int]) -> Expr {\n  let new_args = array_empty()\n  let lits = array_empty()\n  let mut i = 0\n  while i < Array::length(args) {\n    let a = Array::get(args, i)\n    match a {\n      EFn(_, _, _, _, _, fbody) => if dlh_has_perform(fbody) {\n        let idx = Array::get(ctr, 0)\n        Array::set(ctr, 0, idx + 1)\n        let nm = \"__dlh_arglit_\\{idx}\"\n        Array::push(lits, (nm, a))\n        Array::push(new_args, EIdent(nm, off))\n      } else {\n        Array::push(new_args, a)\n      },\n      ELabeledArg(lbl, mname, inner) => match inner {\n        EFn(_, _, _, _, _, fbody) => if dlh_has_perform(fbody) {\n          let idx = Array::get(ctr, 0)\n          Array::set(ctr, 0, idx + 1)\n          let nm = \"__dlh_arglit_\\{idx}\"\n          Array::push(lits, (nm, inner))\n          Array::push(new_args, ELabeledArg(lbl, mname, EIdent(nm, off)))\n        } else {\n          Array::push(new_args, a)\n        },\n        _ => Array::push(new_args, a)\n      },\n      other => Array::push(new_args, other)\n    }\n    i = i + 1\n  }\n  let mut wrapped = ECall(callee, new_args, off)\n  let mut k = Array::length(lits) - 1\n  while k >= 0 {\n    let (nm, lit) = Array::get(lits, k)\n    wrapped = ELet(nm, lit, wrapped, off)\n    k = k - 1\n  }\n  wrapped\n}\n\nfn dlh_hoist_expr(expr: Expr, hoisted: Array[Stmt], ctr: Array[Int]) -> Expr {\n  match expr {\n    ELet(name, v, b, soff) => match v {\n      EFn(tp, bnds, params, rt, eff, fbody) => {\n        let eff_is_blank = match eff {\n          None => true,\n          Some(es) => String::trim(es) == \"\"\n        }\n        let eff_fixed = if eff_is_blank {\n          let performed = empty_str_array()\n          dlh_collect_performed_effect_names(fbody, performed)\n          if Array::length(performed) == 0 {\n            eff\n          } else {\n            Some(dlh_join_comma(performed))\n          }\n        } else {\n          eff\n        }\n        let hoisted_fn = dlh_hoist_expr(EFn(tp, bnds, params, rt, eff_fixed, fbody), hoisted, ctr)\n        let rest = dlh_hoist_expr(b, hoisted, ctr)\n        let bad = empty_str_array()\n        let mut pb = empty_str_array()\n        let mut i = 0\n        while i < Array::length(params) {\n          let (pn, _) = Array::get(params, i)\n          pb = dlh_with(pb, dlh_strip_tilde(pn))\n          i = i + 1\n        }\n        match hoisted_fn {\n          EFn(_, _, _, _, _, hb) => dlh_scan_free(hb, pb, bad),\n          _ => ()\n        }\n        let hoistable = dlh_has_perform(fbody) && Array::length(bad) == 0\n        if hoistable {\n          let idx = Array::get(ctr, 0)\n          Array::set(ctr, 0, idx + 1)\n          let fresh = \"__hoisted_lam_\\{idx}_\\{name}\"\n          Array::push(hoisted, SLet(false, false, fresh, None, hoisted_fn))\n          dlh_subst(rest, name, fresh)\n        } else if dlh_has_perform(fbody) && Array::length(bad) > 0 {\n          let idx = Array::get(ctr, 0)\n          Array::set(ctr, 0, idx + 1)\n          let marker = \"__dlh_cc_marker_\\{idx}\"\n          let rest_marked = dlh_subst(rest, name, marker)\n          let captured = dlh_dedup_names(bad)\n          if dlh_marker_only_called_directly(rest_marked, marker) && !dlh_names_ever_assigned(fbody, captured) && !dlh_names_ever_assigned(rest, captured) {\n            let extra_params = for cn in captured {\n              (cn, None)\n            }\n            let new_params = Array::concat(extra_params, params)\n            let hoisted_fn2 = match hoisted_fn {\n              EFn(tp2, bnds2, _, rt2, eff2, hb2) => EFn(tp2, bnds2, new_params, rt2, eff2, hb2),\n              _ => hoisted_fn\n            }\n            let fresh = \"__hoisted_lam_\\{idx}_\\{name}\"\n            Array::push(hoisted, SLet(false, false, fresh, None, hoisted_fn2))\n            dlh_prepend_and_rename_calls(rest_marked, marker, fresh, captured)\n          } else {\n            ELet(name, hoisted_fn, rest, soff)\n          }\n        } else {\n          ELet(name, hoisted_fn, rest, soff)\n        }\n      },\n      _ => ELet(name, dlh_hoist_expr(v, hoisted, ctr), dlh_hoist_expr(b, hoisted, ctr), soff)\n    },\n    EBinOp(op, l, r) => EBinOp(op, dlh_hoist_expr(l, hoisted, ctr), dlh_hoist_expr(r, hoisted, ctr)),\n    EUnaryOp(op, e) => EUnaryOp(op, dlh_hoist_expr(e, hoisted, ctr)),\n    ECall(callee, args, off) => match callee {\n      EFn(_, _, _, _, ceff, cfbody) => if dlh_has_perform(cfbody) || dlh_row_is_effectful(ceff) {\n        let idx = Array::get(ctr, 0)\n        Array::set(ctr, 0, idx + 1)\n        let iife_name = \"__dlh_iife_\\{idx}\"\n        dlh_hoist_expr(ELet(iife_name, callee, ECall(EIdent(iife_name, off), args, off), off), hoisted, ctr)\n      } else {\n        ECall(dlh_hoist_expr(callee, hoisted, ctr), for a in args {\n          dlh_hoist_expr(a, hoisted, ctr)\n        }, off)\n      },\n      _ => if dlh_args_have_literal_efn(args) {\n        dlh_hoist_expr(dlh_letbind_literal_args(callee, args, off, ctr), hoisted, ctr)\n      } else {\n        ECall(dlh_hoist_expr(callee, hoisted, ctr), for a in args {\n          dlh_hoist_expr(a, hoisted, ctr)\n        }, off)\n      }\n    },\n    ETuple(es) => ETuple(for e in es {\n      dlh_hoist_expr(e, hoisted, ctr)\n    }),\n    EArray(es) => EArray(for e in es {\n      dlh_hoist_expr(e, hoisted, ctr)\n    }),\n    ESpread(e) => ESpread(dlh_hoist_expr(e, hoisted, ctr)),\n    EContinue(es) => EContinue(for e in es {\n      dlh_hoist_expr(e, hoisted, ctr)\n    }),\n    ERecord(rn, fs, targs) => {\n      let out = array_empty()\n      let mut i = 0\n      while i < Array::length(fs) {\n        let (k, v) = Array::get(fs, i)\n        Array::push(out, (k, dlh_hoist_expr(v, hoisted, ctr)))\n        i = i + 1\n      }\n      ERecord(rn, out, targs)\n    },\n    EMap(fs) => {\n      let out = array_empty()\n      let mut i = 0\n      while i < Array::length(fs) {\n        let (k, v) = Array::get(fs, i)\n        Array::push(out, (k, dlh_hoist_expr(v, hoisted, ctr)))\n        i = i + 1\n      }\n      EMap(out)\n    },\n    EIf(c, t, e) => EIf(dlh_hoist_expr(c, hoisted, ctr), dlh_hoist_expr(t, hoisted, ctr), dlh_hoist_expr(e, hoisted, ctr)),\n    ELetRec(name, v, b) => ELetRec(name, dlh_hoist_expr(v, hoisted, ctr), dlh_hoist_expr(b, hoisted, ctr)),\n    ELetMut(name, v, b, soff) => ELetMut(name, dlh_hoist_expr(v, hoisted, ctr), dlh_hoist_expr(b, hoisted, ctr), soff),\n    EAssign(name, v, c) => EAssign(name, dlh_hoist_expr(v, hoisted, ctr), dlh_hoist_expr(c, hoisted, ctr)),\n    EAssignOp(name, op, v, c) => EAssignOp(name, op, dlh_hoist_expr(v, hoisted, ctr), dlh_hoist_expr(c, hoisted, ctr)),\n    ESeq(a, b) => ESeq(dlh_hoist_expr(a, hoisted, ctr), dlh_hoist_expr(b, hoisted, ctr)),\n    EWhile(c, b) => EWhile(dlh_hoist_expr(c, hoisted, ctr), dlh_hoist_expr(b, hoisted, ctr)),\n    EForIn(name, idxn, it, b) => EForIn(name, idxn, dlh_hoist_expr(it, hoisted, ctr), dlh_hoist_expr(b, hoisted, ctr)),\n    EDot(o, f, off, fdoff) => EDot(dlh_hoist_expr(o, hoisted, ctr), f, off, fdoff),\n    ELabeledArg(l, m, e) => ELabeledArg(l, m, dlh_hoist_expr(e, hoisted, ctr)),\n    EReturn(e) => EReturn(dlh_hoist_expr(e, hoisted, ctr)),\n    EBreak(opt) => match opt {\n      Some(e) => EBreak(Some(dlh_hoist_expr(e, hoisted, ctr))),\n      None => expr\n    },\n    EFn(tp, bnds, params, rt, eff, body) => EFn(tp, bnds, params, rt, eff, dlh_hoist_expr(body, hoisted, ctr)),\n    EMatch(s, arms) => EMatch(dlh_hoist_expr(s, hoisted, ctr), dlh_hoist_arms(arms, hoisted, ctr)),\n    EHandle(s, arms) => EHandle(dlh_hoist_expr(s, hoisted, ctr), dlh_hoist_arms(arms, hoisted, ctr)),\n    ELoop(params, b) => {\n      let out = array_empty()\n      let mut i = 0\n      while i < Array::length(params) {\n        let (pn, init) = Array::get(params, i)\n        Array::push(out, (pn, dlh_hoist_expr(init, hoisted, ctr)))\n        i = i + 1\n      }\n      ELoop(out, dlh_hoist_expr(b, hoisted, ctr))\n    },\n    _ => expr\n  }\n}\n\nfn dlh_hoist_arms(arms: Array[(Pat, Expr)], hoisted: Array[Stmt], ctr: Array[Int]) -> Array[(Pat, Expr)] {\n  let out = array_empty()\n  let mut i = 0\n  while i < Array::length(arms) {\n    let (p, b) = Array::get(arms, i)\n    Array::push(out, (p, dlh_hoist_expr(b, hoisted, ctr)))\n    i = i + 1\n  }\n  out\n}\n\nfn dlh_hoist_stmt(stmt: Stmt, hoisted: Array[Stmt], ctr: Array[Int]) -> Stmt {\n  match stmt {\n    SLet(ex, rc, name, ty, body) => SLet(ex, rc, name, ty, dlh_hoist_expr(body, hoisted, ctr)),\n    SLetMut(name, ty, body) => SLetMut(name, ty, dlh_hoist_expr(body, hoisted, ctr)),\n    STest(name, body) => STest(name, dlh_hoist_expr(body, hoisted, ctr)),\n    SBench(name, body) => SBench(name, dlh_hoist_expr(body, hoisted, ctr)),\n    SExpr(e) => SExpr(dlh_hoist_expr(e, hoisted, ctr)),\n    SLetPat(pat, e) => SLetPat(pat, dlh_hoist_expr(e, hoisted, ctr)),\n    _ => stmt\n  }\n}\n\nexport fn desugar_hoist_local_lambdas(stmts: Array[Stmt]) -> Unit {\n  let hoisted = array_empty()\n  let ctr = [\n    0\n  ]\n  let n = Array::length(stmts)\n  let mut i = 0\n  while i < n {\n    Array::set(stmts, i, dlh_hoist_stmt(Array::get(stmts, i), hoisted, ctr))\n    i = i + 1\n  }\n  let mut h = 0\n  while h < Array::length(hoisted) {\n    Array::push(stmts, Array::get(hoisted, h))\n    h = h + 1\n  }\n}\n\nfn strip_label_tilde(n: String) -> String {\n  let ln = String::length(n)\n  if ln > 0 {\n    let last = n[ln - 1: ln]\n    if last == \"~\" || last == \"?\" {\n      n[0: ln - 1]\n    } else {\n      n\n    }\n  } else {\n    n\n  }\n}\n\nfn collect_fn_param_labels(stmts: Array[Stmt]) -> Array[(String, Array[String])] {\n  let out = array_empty()\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SLet(_, _, fname, _, body) => match body {\n        EFn(_, _, params, _, _, _) => {\n          let labels = empty_str_array()\n          let mut pi = 0\n          while pi < Array::length(params) {\n            let (pn, _) = Array::get(params, pi)\n            Array::push(labels, strip_label_tilde(pn))\n            pi = pi + 1\n          }\n          Array::push(out, (fname, labels))\n        },\n        _ => ()\n      },\n      _ => ()\n    }\n    i = i + 1\n  }\n  out\n}\n\nfn lookup_param_labels(tbl: Array[(String, Array[String])], fname: String) -> Option[Array[String]] {\n  let mut i = 0\n  let mut found = None\n  while i < Array::length(tbl) {\n    let (n, labels) = Array::get(tbl, i)\n    if n == fname {\n      found = Some(labels)\n      i = Array::length(tbl)\n    } else {\n      i = i + 1\n    }\n  }\n  found\n}\n\nfn reorder_labeled_args(args: Array[Expr], param_labels: Array[String]) -> Option[Array[Expr]] {\n  if Array::length(args) != Array::length(param_labels) {\n    None\n  } else {\n    let mut all_labeled = true\n    let mut i = 0\n    while i < Array::length(args) {\n      let is_lbl = match Array::get(args, i) {\n        ELabeledArg(_, _, _) => true,\n        _ => false\n      }\n      if is_lbl {\n        ()\n      } else {\n        all_labeled = false\n      }\n      i = i + 1\n    }\n    if !all_labeled {\n      None\n    } else {\n      let out = empty_expr_array()\n      let mut ok = true\n      let mut pj = 0\n      while pj < Array::length(param_labels) {\n        let want = Array::get(param_labels, pj)\n        let mut fk = -1\n        let mut k = 0\n        while k < Array::length(args) {\n          match Array::get(args, k) {\n            ELabeledArg(lbl, _, _) => if lbl == want && fk < 0 {\n              fk = k\n            } else {\n              ()\n            },\n            _ => ()\n          }\n          k = k + 1\n        }\n        if fk < 0 {\n          ok = false\n          pj = Array::length(param_labels)\n        } else {\n          Array::push(out, Array::get(args, fk))\n          pj = pj + 1\n        }\n      }\n      if ok {\n        Some(out)\n      } else {\n        None\n      }\n    }\n  }\n}\n\nfn relabel_shadowed(shadows: Array[String], name: String) -> Bool {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(shadows) {\n    if Array::get(shadows, i) == name {\n      found = true\n      i = Array::length(shadows)\n    } else {\n      i = i + 1\n    }\n  }\n  found\n}\n\nfn relabel_pat_binds(pat: Pat, shadows: Array[String]) -> Unit {\n  match pat {\n    PBind(n) => Array::push(shadows, n),\n    PCtor(_, ps) => {\n      let mut i = 0\n      while i < Array::length(ps) {\n        relabel_pat_binds(Array::get(ps, i), shadows)\n        i = i + 1\n      }\n    },\n    PTuple(ps) => {\n      let mut i = 0\n      while i < Array::length(ps) {\n        relabel_pat_binds(Array::get(ps, i), shadows)\n        i = i + 1\n      }\n    },\n    POr(a, b) => {\n      relabel_pat_binds(a, shadows)\n      relabel_pat_binds(b, shadows)\n    },\n    PStruct(_, fields) => {\n      let mut i = 0\n      while i < Array::length(fields) {\n        let (_, fp) = Array::get(fields, i)\n        relabel_pat_binds(fp, shadows)\n        i = i + 1\n      }\n    },\n    _ => ()\n  }\n}\n\nfn strip_labeled_wrappers(args: Array[Expr]) -> Array[Expr] {\n  let out = empty_expr_array()\n  let mut i = 0\n  while i < Array::length(args) {\n    match Array::get(args, i) {\n      ELabeledArg(_, _, v) => Array::push(out, v),\n      other => Array::push(out, other)\n    }\n    i = i + 1\n  }\n  out\n}\n\nfn strip_in_position_labels(args: Array[Expr], labels: Array[String]) -> Array[Expr] {\n  let out = empty_expr_array()\n  let mut i = 0\n  while i < Array::length(args) {\n    let arg = Array::get(args, i)\n    match arg {\n      ELabeledArg(lbl, m, v) => if i < Array::length(labels) && Array::get(labels, i) == lbl {\n        Array::push(out, v)\n      } else {\n        Array::push(out, ELabeledArg(lbl, m, v))\n      },\n      other => Array::push(out, other)\n    }\n    i = i + 1\n  }\n  out\n}\n\nfn relabel_expr(expr: Expr, tbl: Array[(String, Array[String])], shadows: Array[String]) -> Expr {\n  match expr {\n    ECall(callee, args, off) => {\n      let rargs = for a in args {\n        relabel_expr(a, tbl, shadows)\n      }\n      let rcallee = relabel_expr(callee, tbl, shadows)\n      let mut any_labeled_arg = false\n      let mut la_i = 0\n      while la_i < Array::length(rargs) {\n        match Array::get(rargs, la_i) {\n          ELabeledArg(_, _, _) => {\n            any_labeled_arg = true\n          },\n          _ => ()\n        }\n        la_i = la_i + 1\n      }\n      let final_args = if any_labeled_arg {\n        match callee {\n          EIdent(fname, _) => if relabel_shadowed(shadows, fname) {\n            rargs\n          } else {\n            match lookup_param_labels(tbl, fname) {\n              Some(labels) => match reorder_labeled_args(rargs, labels) {\n                Some(reordered) => strip_labeled_wrappers(reordered),\n                None => strip_in_position_labels(rargs, labels)\n              },\n              None => rargs\n            }\n          },\n          _ => rargs\n        }\n      } else {\n        rargs\n      }\n      ECall(rcallee, final_args, off)\n    },\n    EBinOp(op, l, r) => EBinOp(op, relabel_expr(l, tbl, shadows), relabel_expr(r, tbl, shadows)),\n    EUnaryOp(op, e) => EUnaryOp(op, relabel_expr(e, tbl, shadows)),\n    ETuple(elems) => ETuple(for e in elems {\n      relabel_expr(e, tbl, shadows)\n    }),\n    EArray(elems) => EArray(for e in elems {\n      relabel_expr(e, tbl, shadows)\n    }),\n    ESpread(e) => ESpread(relabel_expr(e, tbl, shadows)),\n    ERecord(rn, fields, targs) => {\n      let out = array_empty()\n      let mut i = 0\n      while i < Array::length(fields) {\n        let (fname, fval) = Array::get(fields, i)\n        Array::push(out, (fname, relabel_expr(fval, tbl, shadows)))\n        i = i + 1\n      }\n      ERecord(rn, out, targs)\n    },\n    EMap(fields) => {\n      let out = array_empty()\n      let mut i = 0\n      while i < Array::length(fields) {\n        let (k, v) = Array::get(fields, i)\n        Array::push(out, (k, relabel_expr(v, tbl, shadows)))\n        i = i + 1\n      }\n      EMap(out)\n    },\n    EIf(c, t, e) => EIf(relabel_expr(c, tbl, shadows), relabel_expr(t, tbl, shadows), relabel_expr(e, tbl, shadows)),\n    ELet(name, v, b, soff) => {\n      let rv = relabel_expr(v, tbl, shadows)\n      let mark = Array::length(shadows)\n      Array::push(shadows, name)\n      let rb = relabel_expr(b, tbl, shadows)\n      Array::truncate(shadows, mark)\n      ELet(name, rv, rb, soff)\n    },\n    ELetRec(name, v, b) => {\n      let mark = Array::length(shadows)\n      Array::push(shadows, name)\n      let rv = relabel_expr(v, tbl, shadows)\n      let rb = relabel_expr(b, tbl, shadows)\n      Array::truncate(shadows, mark)\n      ELetRec(name, rv, rb)\n    },\n    ELetMut(name, v, b, soff) => {\n      let rv = relabel_expr(v, tbl, shadows)\n      let mark = Array::length(shadows)\n      Array::push(shadows, name)\n      let rb = relabel_expr(b, tbl, shadows)\n      Array::truncate(shadows, mark)\n      ELetMut(name, rv, rb, soff)\n    },\n    EAssign(name, v, c) => EAssign(name, relabel_expr(v, tbl, shadows), relabel_expr(c, tbl, shadows)),\n    EAssignOp(name, op, v, c) => EAssignOp(name, op, relabel_expr(v, tbl, shadows), relabel_expr(c, tbl, shadows)),\n    ESeq(a, b) => ESeq(relabel_expr(a, tbl, shadows), relabel_expr(b, tbl, shadows)),\n    EMatch(scrut, arms) => {\n      let rscrut = relabel_expr(scrut, tbl, shadows)\n      let out = array_empty()\n      let mut i = 0\n      while i < Array::length(arms) {\n        let (p, b) = Array::get(arms, i)\n        let mark = Array::length(shadows)\n        relabel_pat_binds(p, shadows)\n        Array::push(out, (p, relabel_expr(b, tbl, shadows)))\n        Array::truncate(shadows, mark)\n        i = i + 1\n      }\n      EMatch(rscrut, out)\n    },\n    EHandle(scrut, arms) => {\n      let rscrut = relabel_expr(scrut, tbl, shadows)\n      let out = array_empty()\n      let mut i = 0\n      while i < Array::length(arms) {\n        let (p, b) = Array::get(arms, i)\n        let mark = Array::length(shadows)\n        relabel_pat_binds(p, shadows)\n        Array::push(out, (p, relabel_expr(b, tbl, shadows)))\n        Array::truncate(shadows, mark)\n        i = i + 1\n      }\n      EHandle(rscrut, out)\n    },\n    EWhile(c, b) => EWhile(relabel_expr(c, tbl, shadows), relabel_expr(b, tbl, shadows)),\n    ELoop(params, b) => {\n      let rinits = for param in params {\n        let (name, init) = param\n        (name, relabel_expr(init, tbl, shadows))\n      }\n      let mark = Array::length(shadows)\n      let mut pi = 0\n      while pi < Array::length(params) {\n        let (pname, _) = Array::get(params, pi)\n        Array::push(shadows, pname)\n        pi = pi + 1\n      }\n      let rb = relabel_expr(b, tbl, shadows)\n      Array::truncate(shadows, mark)\n      ELoop(rinits, rb)\n    },\n    EForIn(name, idx, iter, b) => {\n      let riter = relabel_expr(iter, tbl, shadows)\n      let mark = Array::length(shadows)\n      Array::push(shadows, name)\n      match idx {\n        Some(ix) => Array::push(shadows, ix),\n        None => ()\n      }\n      let rb = relabel_expr(b, tbl, shadows)\n      Array::truncate(shadows, mark)\n      EForIn(name, idx, riter, rb)\n    },\n    EFn(tp, bnds, params, rt, eff, b) => {\n      let mark = Array::length(shadows)\n      let mut pi = 0\n      while pi < Array::length(params) {\n        let (pn, _) = Array::get(params, pi)\n        Array::push(shadows, strip_label_tilde(pn))\n        pi = pi + 1\n      }\n      let rb = relabel_expr(b, tbl, shadows)\n      Array::truncate(shadows, mark)\n      EFn(tp, bnds, params, rt, eff, rb)\n    },\n    EDot(obj, field, off, fdoff) => EDot(relabel_expr(obj, tbl, shadows), field, off, fdoff),\n    ELabeledArg(label, name, b) => ELabeledArg(label, name, relabel_expr(b, tbl, shadows)),\n    EReturn(e) => EReturn(relabel_expr(e, tbl, shadows)),\n    EBreak(opt) => match opt {\n      Some(e) => EBreak(Some(relabel_expr(e, tbl, shadows))),\n      None => expr\n    },\n    EContinue(exprs) => EContinue(for e in exprs {\n      relabel_expr(e, tbl, shadows)\n    }),\n    _ => expr\n  }\n}\n\nfn relabel_stmt(stmt: Stmt, tbl: Array[(String, Array[String])]) -> Stmt {\n  match stmt {\n    SLet(ex, rc, name, ty, body) => SLet(ex, rc, name, ty, relabel_expr(body, tbl, empty_str_array())),\n    SLetMut(name, ty, body) => SLetMut(name, ty, relabel_expr(body, tbl, empty_str_array())),\n    STest(name, body) => STest(name, relabel_expr(body, tbl, empty_str_array())),\n    SBench(name, body) => SBench(name, relabel_expr(body, tbl, empty_str_array())),\n    SExpr(e) => SExpr(relabel_expr(e, tbl, empty_str_array())),\n    SLetPat(pat, e) => SLetPat(pat, relabel_expr(e, tbl, empty_str_array())),\n    SModule(ex, name, stmts) => SModule(ex, name, for s in stmts {\n      relabel_stmt(s, tbl)\n    }),\n    _ => stmt\n  }\n}\n\nfn expr_has_labeled_arg(expr: Expr) -> Bool {\n  match expr {\n    ELabeledArg(_, _, _) => true,\n    ECall(callee, args, _) => {\n      let mut found = expr_has_labeled_arg(callee)\n      let mut i = 0\n      while i < Array::length(args) {\n        if found {\n          i = Array::length(args)\n        } else {\n          found = expr_has_labeled_arg(Array::get(args, i))\n          i = i + 1\n        }\n      }\n      found\n    },\n    EBinOp(_, l, r) => expr_has_labeled_arg(l) || expr_has_labeled_arg(r),\n    EUnaryOp(_, e) => expr_has_labeled_arg(e),\n    ETuple(elems) => arr_has_labeled_arg(elems),\n    EArray(elems) => arr_has_labeled_arg(elems),\n    ESpread(e) => expr_has_labeled_arg(e),\n    ERecord(_, fields, _) => pairs_have_labeled_arg(fields),\n    EMap(fields) => pairs_have_labeled_arg(fields),\n    EIf(c, t, e) => expr_has_labeled_arg(c) || expr_has_labeled_arg(t) || expr_has_labeled_arg(e),\n    ELet(_, v, b, _) => expr_has_labeled_arg(v) || expr_has_labeled_arg(b),\n    ELetRec(_, v, b) => expr_has_labeled_arg(v) || expr_has_labeled_arg(b),\n    ELetMut(_, v, b, _) => expr_has_labeled_arg(v) || expr_has_labeled_arg(b),\n    EAssign(_, v, k) => expr_has_labeled_arg(v) || expr_has_labeled_arg(k),\n    EAssignOp(_, _, v, k) => expr_has_labeled_arg(v) || expr_has_labeled_arg(k),\n    ESeq(a, b) => expr_has_labeled_arg(a) || expr_has_labeled_arg(b),\n    EMatch(scrut, arms) => expr_has_labeled_arg(scrut) || arms_have_labeled_arg(arms),\n    EHandle(scrut, arms) => expr_has_labeled_arg(scrut) || arms_have_labeled_arg(arms),\n    EWhile(c, b) => expr_has_labeled_arg(c) || expr_has_labeled_arg(b),\n    ELoop(inits, b) => pairs_have_labeled_arg(inits) || expr_has_labeled_arg(b),\n    EForIn(_, _, iter, b) => expr_has_labeled_arg(iter) || expr_has_labeled_arg(b),\n    EFn(_, _, _, _, _, b) => expr_has_labeled_arg(b),\n    EDot(obj, _, _, _) => expr_has_labeled_arg(obj),\n    EReturn(e) => expr_has_labeled_arg(e),\n    EBreak(opt) => match opt {\n      Some(e) => expr_has_labeled_arg(e),\n      None => false\n    },\n    EContinue(exprs) => arr_has_labeled_arg(exprs),\n    _ => false\n  }\n}\n\nfn arr_has_labeled_arg(exprs: Array[Expr]) -> Bool {\n  let mut found = false\n  let mut i = 0\n  while i < Array::length(exprs) {\n    if found {\n      i = Array::length(exprs)\n    } else {\n      found = expr_has_labeled_arg(Array::get(exprs, i))\n      i = i + 1\n    }\n  }\n  found\n}\n\nfn pairs_have_labeled_arg(pairs: Array[(String, Expr)]) -> Bool {\n  let mut found = false\n  let mut i = 0\n  while i < Array::length(pairs) {\n    if found {\n      i = Array::length(pairs)\n    } else {\n      let (_, v) = Array::get(pairs, i)\n      found = expr_has_labeled_arg(v)\n      i = i + 1\n    }\n  }\n  found\n}\n\nfn arms_have_labeled_arg(arms: Array[(Pat, Expr)]) -> Bool {\n  let mut found = false\n  let mut i = 0\n  while i < Array::length(arms) {\n    if found {\n      i = Array::length(arms)\n    } else {\n      let (_, b) = Array::get(arms, i)\n      found = expr_has_labeled_arg(b)\n      i = i + 1\n    }\n  }\n  found\n}\n\nfn stmt_has_labeled_arg(stmt: Stmt) -> Bool {\n  match stmt {\n    SLet(_, _, _, _, body) => expr_has_labeled_arg(body),\n    SLetMut(_, _, body) => expr_has_labeled_arg(body),\n    STest(_, body) => expr_has_labeled_arg(body),\n    SBench(_, body) => expr_has_labeled_arg(body),\n    SExpr(e) => expr_has_labeled_arg(e),\n    SLetPat(_, e) => expr_has_labeled_arg(e),\n    SModule(_, _, ms) => {\n      let mut found = false\n      let mut i = 0\n      while i < Array::length(ms) {\n        if found {\n          i = Array::length(ms)\n        } else {\n          found = stmt_has_labeled_arg(Array::get(ms, i))\n          i = i + 1\n        }\n      }\n      found\n    },\n    _ => false\n  }\n}\n\nexport fn desugar_labeled_args(stmts: Array[Stmt]) -> Unit {\n  let tbl = collect_fn_param_labels(stmts)\n  if Array::length(tbl) == 0 {\n    ()\n  } else {\n    let mut i = 0\n    while i < Array::length(stmts) {\n      if stmt_has_labeled_arg(Array::get(stmts, i)) {\n        Array::set(stmts, i, relabel_stmt(Array::get(stmts, i), tbl))\n      } else {\n        ()\n      }\n      i = i + 1\n    }\n  }\n}\n\nfn das_expr(expr: Expr) -> Expr {\n  match expr {\n    EArray(elems) => {\n      let mut has_spread = false\n      let mut si0 = 0\n      while si0 < Array::length(elems) {\n        match Array::get(elems, si0) {\n          ESpread(_) => {\n            has_spread = true\n          },\n          _ => ()\n        }\n        si0 = si0 + 1\n      }\n      if has_spread {\n        let segments = array_empty()\n        let mut buf = empty_expr_array()\n        let mut si = 0\n        while si < Array::length(elems) {\n          let elem = Array::get(elems, si)\n          match elem {\n            ESpread(inner) => {\n              if Array::length(buf) > 0 {\n                Array::push(segments, EArray(for e in buf {\n                  das_expr(e)\n                }))\n                buf = empty_expr_array()\n              } else {\n                ()\n              }\n              Array::push(segments, das_expr(inner))\n            },\n            _ => Array::push(buf, elem)\n          }\n          si = si + 1\n        }\n        if Array::length(buf) > 0 {\n          Array::push(segments, EArray(for e in buf {\n            das_expr(e)\n          }))\n        } else {\n          ()\n        }\n        let mut acc = Array::get(segments, 0)\n        let mut fi = 1\n        while fi < Array::length(segments) {\n          acc = ECall(EIdent(\"Array::concat\", 0 - 1), [\n            acc,\n            Array::get(segments, fi)\n          ], 0 - 1)\n          fi = fi + 1\n        }\n        acc\n      } else {\n        EArray(for e in elems {\n          das_expr(e)\n        })\n      }\n    },\n    ETuple(es) => ETuple(for e in es {\n      das_expr(e)\n    }),\n    ERecord(rn, fs, targs) => {\n      let out = array_empty()\n      let mut i = 0\n      while i < Array::length(fs) {\n        let (k, v) = Array::get(fs, i)\n        Array::push(out, (k, das_expr(v)))\n        i = i + 1\n      }\n      ERecord(rn, out, targs)\n    },\n    EMap(fs) => {\n      let out = array_empty()\n      let mut i = 0\n      while i < Array::length(fs) {\n        let (k, v) = Array::get(fs, i)\n        Array::push(out, (k, das_expr(v)))\n        i = i + 1\n      }\n      EMap(out)\n    },\n    EIf(c, t, e) => EIf(das_expr(c), das_expr(t), das_expr(e)),\n    ELet(n, v, b, soff) => ELet(n, das_expr(v), das_expr(b), soff),\n    ELetRec(n, v, b) => ELetRec(n, das_expr(v), das_expr(b)),\n    ELetMut(n, v, b, soff) => ELetMut(n, das_expr(v), das_expr(b), soff),\n    EAssign(n, v, c) => EAssign(n, das_expr(v), das_expr(c)),\n    EAssignOp(n, op, v, c) => EAssignOp(n, op, das_expr(v), das_expr(c)),\n    ESeq(a, b) => ESeq(das_expr(a), das_expr(b)),\n    EMatch(s, arms) => EMatch(das_expr(s), das_arms(arms)),\n    EHandle(s, arms) => EHandle(das_expr(s), das_arms(arms)),\n    EWhile(c, b) => EWhile(das_expr(c), das_expr(b)),\n    ELoop(params, b) => ELoop(for param in params {\n      let (name, init) = param\n      (name, das_expr(init))\n    }, das_expr(b)),\n    EForIn(n, idxn, it, b) => EForIn(n, idxn, das_expr(it), das_expr(b)),\n    ECall(callee, args, off) => ECall(das_expr(callee), for a in args {\n      das_expr(a)\n    }, off),\n    EBinOp(op, l, r) => EBinOp(op, das_expr(l), das_expr(r)),\n    EUnaryOp(op, e) => EUnaryOp(op, das_expr(e)),\n    EFn(tp, tb, params, rt, eff, body) => EFn(tp, tb, params, rt, eff, das_expr(body)),\n    EDot(o, f, off, fdoff) => EDot(das_expr(o), f, off, fdoff),\n    ELabeledArg(l, m, e) => ELabeledArg(l, m, das_expr(e)),\n    EReturn(e) => EReturn(das_expr(e)),\n    EBreak(opt) => match opt {\n      Some(e) => EBreak(Some(das_expr(e))),\n      None => expr\n    },\n    EContinue(es) => EContinue(for e in es {\n      das_expr(e)\n    }),\n    ESpread(inner) => ESpread(das_expr(inner)),\n    _ => expr\n  }\n}\n\nfn das_arms(arms: Array[(Pat, Expr)]) -> Array[(Pat, Expr)] {\n  let out = array_empty()\n  let mut i = 0\n  while i < Array::length(arms) {\n    let (p, b) = Array::get(arms, i)\n    Array::push(out, (p, das_expr(b)))\n    i = i + 1\n  }\n  out\n}\n\nfn das_stmt(stmt: Stmt) -> Stmt {\n  match stmt {\n    SLet(ex, rc, name, ty, body) => SLet(ex, rc, name, ty, das_expr(body)),\n    SLetMut(name, ty, body) => SLetMut(name, ty, das_expr(body)),\n    STest(name, body) => STest(name, das_expr(body)),\n    SBench(name, body) => SBench(name, das_expr(body)),\n    SExpr(e) => SExpr(das_expr(e)),\n    SLetPat(pat, e) => SLetPat(pat, das_expr(e)),\n    _ => stmt\n  }\n}\n\nexport fn desugar_array_spread(stmts: Array[Stmt]) -> Unit {\n  let n = Array::length(stmts)\n  let mut i = 0\n  while i < n {\n    Array::set(stmts, i, das_stmt(Array::get(stmts, i)))\n    i = i + 1\n  }\n}\n\nfn dtpw_exprs_bind_name(es: Array[Expr], name: String) -> Bool {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(es) && !found {\n    if dtpw_expr_binds_name(Array::get(es, i), name) {\n      found = true\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  found\n}\n\nfn dtpw_expr_binds_name(expr: Expr, name: String) -> Bool {\n  match expr {\n    EFn(_, _, params, _, _, body) => {\n      let mut i = 0\n      let mut found = false\n      while i < Array::length(params) && !found {\n        let (pn, _) = Array::get(params, i)\n        if dlh_strip_tilde(pn) == name {\n          found = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      found || dtpw_expr_binds_name(body, name)\n    },\n    ELet(n, v, b, _) => n == name || dtpw_expr_binds_name(v, name) || dtpw_expr_binds_name(b, name),\n    ELetRec(n, v, b) => n == name || dtpw_expr_binds_name(v, name) || dtpw_expr_binds_name(b, name),\n    ELetMut(n, v, b, _) => n == name || dtpw_expr_binds_name(v, name) || dtpw_expr_binds_name(b, name),\n    EForIn(n, idxn, it, b) => {\n      let idx_hit = match idxn {\n        Some(i2) => i2 == name,\n        None => false\n      }\n      n == name || idx_hit || dtpw_expr_binds_name(it, name) || dtpw_expr_binds_name(b, name)\n    },\n    ELoop(params, b) => {\n      let mut i = 0\n      let mut found = false\n      while i < Array::length(params) && !found {\n        let (pn, init) = Array::get(params, i)\n        if pn == name || dtpw_expr_binds_name(init, name) {\n          found = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      found || dtpw_expr_binds_name(b, name)\n    },\n    EMatch(s, arms) => {\n      let mut i = 0\n      let mut found = dtpw_expr_binds_name(s, name)\n      while i < Array::length(arms) && !found {\n        let (p, b) = Array::get(arms, i)\n        let bound = array_empty()\n        dlh_pat_binds(p, bound)\n        if dlh_contains(bound, name) || dtpw_expr_binds_name(b, name) {\n          found = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      found\n    },\n    EHandle(s, arms) => {\n      let mut i = 0\n      let mut found = dtpw_expr_binds_name(s, name)\n      while i < Array::length(arms) && !found {\n        let (p, b) = Array::get(arms, i)\n        let bound = array_empty()\n        dlh_pat_binds(p, bound)\n        if dlh_contains(bound, name) || dtpw_expr_binds_name(b, name) {\n          found = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      found\n    },\n    ECall(callee, args, _) => dtpw_expr_binds_name(callee, name) || dtpw_exprs_bind_name(args, name),\n    EBinOp(_, l, r) => dtpw_expr_binds_name(l, name) || dtpw_expr_binds_name(r, name),\n    EUnaryOp(_, e) => dtpw_expr_binds_name(e, name),\n    ETuple(es) => dtpw_exprs_bind_name(es, name),\n    EArray(es) => dtpw_exprs_bind_name(es, name),\n    ESpread(e) => dtpw_expr_binds_name(e, name),\n    EContinue(es) => dtpw_exprs_bind_name(es, name),\n    ERecord(_, fs, _) => {\n      let mut i = 0\n      let mut found = false\n      while i < Array::length(fs) && !found {\n        let (_, v) = Array::get(fs, i)\n        if dtpw_expr_binds_name(v, name) {\n          found = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      found\n    },\n    EMap(fs) => {\n      let mut i = 0\n      let mut found = false\n      while i < Array::length(fs) && !found {\n        let (_, v) = Array::get(fs, i)\n        if dtpw_expr_binds_name(v, name) {\n          found = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      found\n    },\n    EIf(c, t, e) => dtpw_expr_binds_name(c, name) || dtpw_expr_binds_name(t, name) || dtpw_expr_binds_name(e, name),\n    EAssign(_, v, c) => dtpw_expr_binds_name(v, name) || dtpw_expr_binds_name(c, name),\n    EAssignOp(_, _, v, c) => dtpw_expr_binds_name(v, name) || dtpw_expr_binds_name(c, name),\n    ESeq(a, b) => dtpw_expr_binds_name(a, name) || dtpw_expr_binds_name(b, name),\n    EWhile(c, b) => dtpw_expr_binds_name(c, name) || dtpw_expr_binds_name(b, name),\n    EDot(o, _, _, _) => dtpw_expr_binds_name(o, name),\n    ELabeledArg(_, _, e) => dtpw_expr_binds_name(e, name),\n    EReturn(e) => dtpw_expr_binds_name(e, name),\n    EBreak(opt) => match opt {\n      Some(e) => dtpw_expr_binds_name(e, name),\n      None => false\n    },\n    _ => false\n  }\n}\n\nfn dtpw_collect_wrappers(stmts: Array[Stmt]) -> Array[String] {\n  let out = array_empty()\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SLet(_, _, name, _, EFn(_, _, params, _, _, body)) => if Array::length(params) == 1 {\n        let (pname, _) = Array::get(params, 0)\n        let stripped = dlh_strip_tilde(pname)\n        match body {\n          ECall(callee, args, _) => match callee {\n            EIdent(cn, _) => if cn == stripped && Array::length(args) == 0 {\n              Array::push(out, name)\n            } else {\n              ()\n            },\n            _ => ()\n          },\n          _ => ()\n        }\n      } else {\n        ()\n      },\n      _ => ()\n    }\n    i = i + 1\n  }\n  let safe = array_empty()\n  let mut j = 0\n  while j < Array::length(out) {\n    let wn = Array::get(out, j)\n    let mut shadowed = false\n    let mut k = 0\n    while k < Array::length(stmts) && !shadowed {\n      match Array::get(stmts, k) {\n        SLet(_, _, _, _, sv) => if dtpw_expr_binds_name(sv, wn) {\n          shadowed = true\n        } else {\n          ()\n        },\n        _ => ()\n      }\n      k = k + 1\n    }\n    if !shadowed {\n      Array::push(safe, wn)\n    } else {\n      ()\n    }\n    j = j + 1\n  }\n  safe\n}\n\nfn dtpw_inline_expr(expr: Expr, wrappers: Array[String]) -> Expr {\n  match expr {\n    ECall(callee, args, off) => match callee {\n      EIdent(wn, _) => if dlh_contains(wrappers, wn) && Array::length(args) == 1 {\n        ECall(dtpw_inline_expr(Array::get(args, 0), wrappers), array_empty(), off)\n      } else {\n        ECall(dtpw_inline_expr(callee, wrappers), for a in args {\n          dtpw_inline_expr(a, wrappers)\n        }, off)\n      },\n      _ => ECall(dtpw_inline_expr(callee, wrappers), for a in args {\n        dtpw_inline_expr(a, wrappers)\n      }, off)\n    },\n    EBinOp(op, l, r) => EBinOp(op, dtpw_inline_expr(l, wrappers), dtpw_inline_expr(r, wrappers)),\n    EUnaryOp(op, e) => EUnaryOp(op, dtpw_inline_expr(e, wrappers)),\n    ETuple(es) => ETuple(for e in es {\n      dtpw_inline_expr(e, wrappers)\n    }),\n    EArray(es) => EArray(for e in es {\n      dtpw_inline_expr(e, wrappers)\n    }),\n    ESpread(e) => ESpread(dtpw_inline_expr(e, wrappers)),\n    EContinue(es) => EContinue(for e in es {\n      dtpw_inline_expr(e, wrappers)\n    }),\n    ERecord(rn, fs, targs) => {\n      let out = array_empty()\n      let mut i = 0\n      while i < Array::length(fs) {\n        let (k, v) = Array::get(fs, i)\n        Array::push(out, (k, dtpw_inline_expr(v, wrappers)))\n        i = i + 1\n      }\n      ERecord(rn, out, targs)\n    },\n    EMap(fs) => {\n      let out = array_empty()\n      let mut i = 0\n      while i < Array::length(fs) {\n        let (k, v) = Array::get(fs, i)\n        Array::push(out, (k, dtpw_inline_expr(v, wrappers)))\n        i = i + 1\n      }\n      EMap(out)\n    },\n    EIf(c, t, e) => EIf(dtpw_inline_expr(c, wrappers), dtpw_inline_expr(t, wrappers), dtpw_inline_expr(e, wrappers)),\n    ELet(n, v, b, soff) => ELet(n, dtpw_inline_expr(v, wrappers), dtpw_inline_expr(b, wrappers), soff),\n    ELetRec(n, v, b) => ELetRec(n, dtpw_inline_expr(v, wrappers), dtpw_inline_expr(b, wrappers)),\n    ELetMut(n, v, b, soff) => ELetMut(n, dtpw_inline_expr(v, wrappers), dtpw_inline_expr(b, wrappers), soff),\n    EAssign(n, v, c) => EAssign(n, dtpw_inline_expr(v, wrappers), dtpw_inline_expr(c, wrappers)),\n    EAssignOp(n, op, v, c) => EAssignOp(n, op, dtpw_inline_expr(v, wrappers), dtpw_inline_expr(c, wrappers)),\n    ESeq(a, b) => ESeq(dtpw_inline_expr(a, wrappers), dtpw_inline_expr(b, wrappers)),\n    EWhile(c, b) => EWhile(dtpw_inline_expr(c, wrappers), dtpw_inline_expr(b, wrappers)),\n    EForIn(n, idxn, it, b) => EForIn(n, idxn, dtpw_inline_expr(it, wrappers), dtpw_inline_expr(b, wrappers)),\n    EDot(o, f, off, fdoff) => EDot(dtpw_inline_expr(o, wrappers), f, off, fdoff),\n    ELabeledArg(l, m, e) => ELabeledArg(l, m, dtpw_inline_expr(e, wrappers)),\n    EReturn(e) => EReturn(dtpw_inline_expr(e, wrappers)),\n    EBreak(opt) => EBreak(match opt {\n      Some(e) => Some(dtpw_inline_expr(e, wrappers)),\n      None => None\n    }),\n    EFn(tp, bnds, params, rt, eff, body) => EFn(tp, bnds, params, rt, eff, dtpw_inline_expr(body, wrappers)),\n    EMatch(s, arms) => EMatch(dtpw_inline_expr(s, wrappers), for a in arms {\n      let (p, b) = a\n      (p, dtpw_inline_expr(b, wrappers))\n    }),\n    EHandle(s, arms) => EHandle(dtpw_inline_expr(s, wrappers), for a in arms {\n      let (p, b) = a\n      (p, dtpw_inline_expr(b, wrappers))\n    }),\n    ELoop(params, b) => ELoop(for p in params {\n      let (pn, init) = p\n      (pn, dtpw_inline_expr(init, wrappers))\n    }, dtpw_inline_expr(b, wrappers)),\n    _ => expr\n  }\n}\n\nfn dtpw_inline_trivial_wrappers(stmts: Array[Stmt]) -> Unit {\n  let wrappers = dtpw_collect_wrappers(stmts)\n  if Array::length(wrappers) == 0 {\n    ()\n  } else {\n    let mut i = 0\n    while i < Array::length(stmts) {\n      match Array::get(stmts, i) {\n        SLet(exported, is_rec, name, ty, expr) => Array::set(stmts, i, SLet(exported, is_rec, name, ty, dtpw_inline_expr(expr, wrappers))),\n        _ => ()\n      }\n      i = i + 1\n    }\n  }\n}\n\nexport fn desugar_trait_dicts(stmts: Array[Stmt]) -> Unit with { Error } {\n  desugar_array_spread(stmts)\n  dtpw_inline_trivial_wrappers(stmts)\n  desugar_hoist_local_lambdas(stmts)\n  desugar_labeled_args(stmts)\n  inject_prelude_result(stmts)\n  desugar_derives(stmts)\n  let traits_raw = collect_method_traits(stmts)\n  let supers_map = collect_trait_supers(stmts)\n  let traits = flatten_traits(traits_raw, supers_map)\n  inject_trait_method_generics_with(stmts, traits)\n  let struct_sets = collect_struct_field_sets(stmts)\n  let fn_returns = collect_fn_returns(stmts)\n  let gimpl_types = collect_generic_impl_types(stmts)\n  let gens = build_gens(stmts, traits, gimpl_types)\n  let toplevel_vars = collect_toplevel_anon_records(stmts, struct_sets)\n  Array::set(dtd_exn_kind_state, 0, if exn_kind_cell_present(stmts) {\n    1\n  } else {\n    0\n  })\n  Array::set(dtd_exn_kind_state, 1, 0)\n  Array::set(dtd_exn_kind_state, 2, 0)\n  let mut i = 0\n  while i < Array::length(stmts) {\n    Array::set(stmts, i, rewrite_stmt(Array::get(stmts, i), gens, traits, struct_sets, fn_returns, toplevel_vars))\n    i = i + 1\n  }\n  if Array::get(dtd_exn_kind_state, 1) == 1 {\n    ensure_exn_kind_cell(stmts)\n  } else {\n    ()\n  }\n  if Array::length(traits_raw) == 0 {\n    ()\n  } else {\n    let mut ti = 0\n    while ti < Array::length(traits) {\n      let (trait_name, sigs) = Array::get(traits, ti)\n      if struct_decl_exists(stmts, dict_struct_name(trait_name)) {\n        ()\n      } else {\n        Array::push(stmts, make_dict_struct_stmt(trait_name, sigs))\n      }\n      ti = ti + 1\n    }\n  }\n}\n")
}

let source_225 = () -> (String, String) {
  ("lib/@vibe/compiler/codegen/common_base/self_tail_call.vibe",
"\nimport @vibe/compiler/core {\n  Expr, Pat, Stmt, TypeExpr, __to_string\n}\n\nimport @vibe/core {\n  array_empty\n}\n\n\nexport fn rewrite_self_tail_calls(stmts: Array[Stmt]) -> Unit {\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SLet(exported, is_rec, name, ty, expr) => match expr {\n        EFn(tps, tbs, params, ret, eff, body) => {\n          let param_names = stc_param_names(params)\n          let arity = Array::length(param_names)\n          if stc_eligible(name, params, param_names, arity, body) {\n            let new_body = stc_build_loop_body(name, param_names, arity, body)\n            Array::set(stmts, i, SLet(exported, is_rec, name, ty, EFn(tps, tbs, params, ret, eff, new_body)))\n          } else {\n            ()\n          }\n        },\n        _ => ()\n      },\n      _ => ()\n    }\n    i = i + 1\n  }\n}\n\nfn stc_param_names(params: Array[(String, Option[TypeExpr])]) -> Array[String] {\n  for p in params {\n    let (pn, _) = p\n    pn\n  }\n}\n\nfn stc_eligible(name: String, params: Array[(String, Option[TypeExpr])], param_names: Array[String], arity: Int, body: Expr) -> Bool {\n  if !stc_params_all_scalar(params) {\n    false\n  } else if !stc_tail_has_self_call(body, name, arity) {\n    false\n  } else if stc_params_bind_name(params, name) {\n    false\n  } else if stc_expr_binds_name(body, name) {\n    false\n  } else {\n    !stc_expr_has_handle_or_return(body)\n  }\n}\n\nfn stc_params_all_scalar(params: Array[(String, Option[TypeExpr])]) -> Bool {\n  let mut i = 0\n  let mut all_scalar = true\n  while i < Array::length(params) {\n    let (_, oty) = Array::get(params, i)\n    if !stc_type_is_scalar(oty) {\n      all_scalar = false\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  all_scalar\n}\n\nfn stc_type_is_scalar(oty: Option[TypeExpr]) -> Bool {\n  match oty {\n    Some(TyName(n)) => n == \"Int\" || n == \"Bool\" || n == \"Float\" || n == \"Double\",\n    Some(TyUnit) => true,\n    _ => false\n  }\n}\n\n\nfn stc_is_reserved_name(n: String) -> Bool {\n  String::starts_with(n, \"__stc\")\n}\n\nfn stc_name_unsafe(n: String, target: String) -> Bool {\n  n == target || stc_is_reserved_name(n)\n}\n\nfn stc_expr_binds_name(expr: Expr, target: String) -> Bool {\n  match expr {\n    ELet(n, v, b, _) => stc_name_unsafe(n, target) || stc_expr_binds_name(v, target) || stc_expr_binds_name(b, target),\n    ELetMut(n, v, b, _) => stc_name_unsafe(n, target) || stc_expr_binds_name(v, target) || stc_expr_binds_name(b, target),\n    ELetRec(n, v, b) => stc_name_unsafe(n, target) || stc_expr_binds_name(v, target) || stc_expr_binds_name(b, target),\n    EFn(_, _, params, _, _, b) => stc_params_bind_name(params, target) || stc_expr_binds_name(b, target),\n    EForIn(n, idx, it, b) => stc_name_unsafe(n, target) || stc_opt_name_is(idx, target) || stc_expr_binds_name(it, target) || stc_expr_binds_name(b, target),\n    EMatch(s, arms) => stc_expr_binds_name(s, target) || stc_arms_bind_name(arms, target),\n    EHandle(s, arms) => stc_expr_binds_name(s, target) || stc_arms_bind_name(arms, target),\n    EIf(c, t, e) => stc_expr_binds_name(c, target) || stc_expr_binds_name(t, target) || stc_expr_binds_name(e, target),\n    ESeq(a, b) => stc_expr_binds_name(a, target) || stc_expr_binds_name(b, target),\n    EWhile(c, b) => stc_expr_binds_name(c, target) || stc_expr_binds_name(b, target),\n    ELoop(pairs, b) => stc_loop_pairs_bind_name(pairs, target) || stc_expr_binds_name(b, target),\n    ECall(callee, args, _) => stc_expr_binds_name(callee, target) || stc_exprs_bind_name(args, target),\n    EBinOp(_, l, r) => stc_expr_binds_name(l, target) || stc_expr_binds_name(r, target),\n    EUnaryOp(_, e2) => stc_expr_binds_name(e2, target),\n    EAssign(_, v, c) => stc_expr_binds_name(v, target) || stc_expr_binds_name(c, target),\n    EAssignOp(_, _, v, c) => stc_expr_binds_name(v, target) || stc_expr_binds_name(c, target),\n    EDot(o, _, _, _) => stc_expr_binds_name(o, target),\n    ELabeledArg(_, _, v) => stc_expr_binds_name(v, target),\n    EReturn(e2) => stc_expr_binds_name(e2, target),\n    EBreak(opt) => match opt {\n      Some(e2) => stc_expr_binds_name(e2, target),\n      None => false\n    },\n    EContinue(args) => stc_exprs_bind_name(args, target),\n    ETuple(elems) => stc_exprs_bind_name(elems, target),\n    EArray(elems) => stc_exprs_bind_name(elems, target),\n    ERecord(_, fields, _) => stc_fields_bind_name(fields, target),\n    EMap(fields) => stc_fields_bind_name(fields, target),\n    ESpread(e2) => stc_expr_binds_name(e2, target),\n    _ => false\n  }\n}\n\nfn stc_opt_name_is(opt: Option[String], target: String) -> Bool {\n  match opt {\n    Some(n) => stc_name_unsafe(n, target),\n    None => false\n  }\n}\n\nfn stc_exprs_bind_name(exprs: Array[Expr], target: String) -> Bool {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(exprs) {\n    if stc_expr_binds_name(Array::get(exprs, i), target) {\n      found = true\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  found\n}\n\nfn stc_fields_bind_name(fields: Array[(String, Expr)], target: String) -> Bool {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(fields) {\n    let (_, v) = Array::get(fields, i)\n    if stc_expr_binds_name(v, target) {\n      found = true\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  found\n}\n\nfn stc_params_bind_name(params: Array[(String, Option[TypeExpr])], target: String) -> Bool {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(params) {\n    let (pn, _) = Array::get(params, i)\n    if stc_name_unsafe(pn, target) {\n      found = true\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  found\n}\n\nfn stc_loop_pairs_bind_name(pairs: Array[(String, Expr)], target: String) -> Bool {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(pairs) {\n    let (pn, init) = Array::get(pairs, i)\n    if stc_name_unsafe(pn, target) || stc_expr_binds_name(init, target) {\n      found = true\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  found\n}\n\nfn stc_pat_binds_name(pat: Pat, target: String) -> Bool {\n  match pat {\n    PBind(n) => stc_name_unsafe(n, target),\n    PCtor(_, ps) => stc_pats_bind_name(ps, target),\n    PTuple(ps) => stc_pats_bind_name(ps, target),\n    POr(a, b) => stc_pat_binds_name(a, target) || stc_pat_binds_name(b, target),\n    PStruct(_, fields) => {\n      let mut i = 0\n      let mut found = false\n      while i < Array::length(fields) {\n        let (_, p) = Array::get(fields, i)\n        if stc_pat_binds_name(p, target) {\n          found = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      found\n    },\n    _ => false\n  }\n}\n\nfn stc_pats_bind_name(pats: Array[Pat], target: String) -> Bool {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(pats) {\n    if stc_pat_binds_name(Array::get(pats, i), target) {\n      found = true\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  found\n}\n\nfn stc_arms_bind_name(arms: Array[(Pat, Expr)], target: String) -> Bool {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(arms) {\n    let (p, ex) = Array::get(arms, i)\n    if stc_pat_binds_name(p, target) || stc_expr_binds_name(ex, target) {\n      found = true\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  found\n}\n\n\nfn stc_expr_has_handle_or_return(expr: Expr) -> Bool {\n  match expr {\n    EHandle(_, _) => true,\n    EReturn(_) => true,\n    EFn(_, _, _, _, _, _) => true,\n    ELet(_, v, b, _) => stc_expr_has_handle_or_return(v) || stc_expr_has_handle_or_return(b),\n    ELetMut(_, v, b, _) => stc_expr_has_handle_or_return(v) || stc_expr_has_handle_or_return(b),\n    ELetRec(_, v, b) => stc_expr_has_handle_or_return(v) || stc_expr_has_handle_or_return(b),\n    EForIn(_, _, it, b) => stc_expr_has_handle_or_return(it) || stc_expr_has_handle_or_return(b),\n    EMatch(s, arms) => stc_expr_has_handle_or_return(s) || stc_arms_have_handle_or_return(arms),\n    EIf(c, t, e) => stc_expr_has_handle_or_return(c) || stc_expr_has_handle_or_return(t) || stc_expr_has_handle_or_return(e),\n    ESeq(a, b) => stc_expr_has_handle_or_return(a) || stc_expr_has_handle_or_return(b),\n    EWhile(c, b) => stc_expr_has_handle_or_return(c) || stc_expr_has_handle_or_return(b),\n    ELoop(pairs, b) => stc_loop_pairs_have_handle_or_return(pairs) || stc_expr_has_handle_or_return(b),\n    ECall(callee, args, _) => stc_expr_has_handle_or_return(callee) || stc_exprs_have_handle_or_return(args),\n    EBinOp(_, l, r) => stc_expr_has_handle_or_return(l) || stc_expr_has_handle_or_return(r),\n    EUnaryOp(_, e2) => stc_expr_has_handle_or_return(e2),\n    EAssign(_, v, c) => stc_expr_has_handle_or_return(v) || stc_expr_has_handle_or_return(c),\n    EAssignOp(_, _, v, c) => stc_expr_has_handle_or_return(v) || stc_expr_has_handle_or_return(c),\n    EDot(o, _, _, _) => stc_expr_has_handle_or_return(o),\n    ELabeledArg(_, _, v) => stc_expr_has_handle_or_return(v),\n    EBreak(opt) => match opt {\n      Some(e2) => stc_expr_has_handle_or_return(e2),\n      None => false\n    },\n    EContinue(args) => stc_exprs_have_handle_or_return(args),\n    ETuple(elems) => stc_exprs_have_handle_or_return(elems),\n    EArray(elems) => stc_exprs_have_handle_or_return(elems),\n    ERecord(_, fields, _) => stc_fields_have_handle_or_return(fields),\n    EMap(fields) => stc_fields_have_handle_or_return(fields),\n    ESpread(e2) => stc_expr_has_handle_or_return(e2),\n    _ => false\n  }\n}\n\nfn stc_exprs_have_handle_or_return(exprs: Array[Expr]) -> Bool {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(exprs) {\n    if stc_expr_has_handle_or_return(Array::get(exprs, i)) {\n      found = true\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  found\n}\n\nfn stc_fields_have_handle_or_return(fields: Array[(String, Expr)]) -> Bool {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(fields) {\n    let (_, v) = Array::get(fields, i)\n    if stc_expr_has_handle_or_return(v) {\n      found = true\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  found\n}\n\nfn stc_loop_pairs_have_handle_or_return(pairs: Array[(String, Expr)]) -> Bool {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(pairs) {\n    let (_, init) = Array::get(pairs, i)\n    if stc_expr_has_handle_or_return(init) {\n      found = true\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  found\n}\n\nfn stc_arms_have_handle_or_return(arms: Array[(Pat, Expr)]) -> Bool {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(arms) {\n    let (_, ex) = Array::get(arms, i)\n    if stc_expr_has_handle_or_return(ex) {\n      found = true\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  found\n}\n\n\nfn stc_is_self_call(expr: Expr, name: String, arity: Int) -> Bool {\n  match expr {\n    ECall(callee, args, _) => match callee {\n      EIdent(cn, _) => cn == name && Array::length(args) == arity,\n      _ => false\n    },\n    _ => false\n  }\n}\n\nfn stc_tail_has_self_call(expr: Expr, name: String, arity: Int) -> Bool {\n  match expr {\n    EIf(_, t, e) => stc_tail_has_self_call(t, name, arity) || stc_tail_has_self_call(e, name, arity),\n    EMatch(_, arms) => stc_tail_arms_have_self_call(arms, name, arity),\n    ELet(_, _, b, _) => stc_tail_has_self_call(b, name, arity),\n    ELetMut(_, _, b, _) => stc_tail_has_self_call(b, name, arity),\n    ELetRec(_, _, b) => stc_tail_has_self_call(b, name, arity),\n    ESeq(_, b) => stc_tail_has_self_call(b, name, arity),\n    EAssign(_, _, c) => stc_tail_has_self_call(c, name, arity),\n    EAssignOp(_, _, _, c) => stc_tail_has_self_call(c, name, arity),\n    _ => stc_is_self_call(expr, name, arity)\n  }\n}\n\nfn stc_tail_arms_have_self_call(arms: Array[(Pat, Expr)], name: String, arity: Int) -> Bool {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(arms) {\n    let (_, ex) = Array::get(arms, i)\n    if stc_tail_has_self_call(ex, name, arity) {\n      found = true\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  found\n}\n\n\nfn stc_build_loop_body(name: String, param_names: Array[String], arity: Int, body: Expr) -> Expr {\n  let transformed = stc_rewrite_tail(body, name, param_names, arity, 0)\n  let while_expr = EWhile(EBool(true), transformed)\n  let looped = ELetMut(\"__stc_result\", EInt(0), ESeq(while_expr, EIdent(\"__stc_result\", -1)), -1)\n  let mut wrapped = looped\n  let mut wi = arity - 1\n  while wi >= 0 {\n    let pn = Array::get(param_names, wi)\n    wrapped = ELetMut(pn, EIdent(pn, -1), wrapped, -1)\n    wi = wi - 1\n  }\n  wrapped\n}\n\nfn stc_rewrite_tail(expr: Expr, name: String, param_names: Array[String], arity: Int, seq: Int) -> Expr {\n  match expr {\n    EIf(c, t, e) => EIf(c, stc_rewrite_tail(t, name, param_names, arity, seq * 2 + 1), stc_rewrite_tail(e, name, param_names, arity, seq * 2 + 2)),\n    EMatch(s, arms) => EMatch(s, stc_rewrite_tail_arms(arms, name, param_names, arity, seq)),\n    ELet(n, v, b, off) => ELet(n, v, stc_rewrite_tail(b, name, param_names, arity, seq), off),\n    ELetMut(n, v, b, off) => ELetMut(n, v, stc_rewrite_tail(b, name, param_names, arity, seq), off),\n    ELetRec(n, v, b) => ELetRec(n, v, stc_rewrite_tail(b, name, param_names, arity, seq)),\n    ESeq(a, b) => ESeq(a, stc_rewrite_tail(b, name, param_names, arity, seq)),\n    EAssign(n, v, c) => EAssign(n, v, stc_rewrite_tail(c, name, param_names, arity, seq)),\n    EAssignOp(n, op, v, c) => EAssignOp(n, op, v, stc_rewrite_tail(c, name, param_names, arity, seq)),\n    _ => if stc_is_self_call(expr, name, arity) {\n      stc_build_continue(expr, param_names, arity, seq)\n    } else {\n      EAssign(\"__stc_result\", expr, EBreak(None))\n    }\n  }\n}\n\nfn stc_rewrite_tail_arms(arms: Array[(Pat, Expr)], name: String, param_names: Array[String], arity: Int, seq: Int) -> Array[(Pat, Expr)] {\n  let mut i = 0\n  let mut out = array_empty()\n  while i < Array::length(arms) {\n    let (p, ex) = Array::get(arms, i)\n    Array::push(out, (p, stc_rewrite_tail(ex, name, param_names, arity, seq * 101 + i)))\n    i = i + 1\n  }\n  out\n}\n\nfn stc_build_continue(call_expr: Expr, param_names: Array[String], arity: Int, seq: Int) -> Expr {\n  match call_expr {\n    ECall(_, args, _) => {\n      let mut result = EContinue(array_empty())\n      let mut ai = arity - 1\n      while ai >= 0 {\n        let tmp = stc_temp_name(seq, ai)\n        result = EAssign(Array::get(param_names, ai), EIdent(tmp, -1), result)\n        ai = ai - 1\n      }\n      let mut aj = arity - 1\n      while aj >= 0 {\n        let tmp = stc_temp_name(seq, aj)\n        result = ELet(tmp, Array::get(args, aj), result, -1)\n        aj = aj - 1\n      }\n      result\n    },\n    _ => call_expr\n  }\n}\n\nfn stc_temp_name(seq: Int, idx: Int) -> String {\n  String::concat(\"__stc\", String::concat(__to_string(seq), String::concat(\"_\", __to_string(idx))))\n}\n")
}

let source_226 = () -> (String, String) {
  ("lib/@vibe/compiler/codegen/common_base/inline_direct_perform.vibe",
"\nimport @vibe/compiler/core {\n  Expr, Pat, Stmt, TypeExpr, dce_keep_flags, is_exception_effect_name, is_exception_throw_handler_name, is_exception_throw_operation\n}\n\nimport @vibe/core {\n  array_empty\n}\n\n\nexport fn inline_direct_performs(stmts: Array[Stmt]) -> Unit {\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SLet(exported, is_rec, name, ty, expr) => {\n        let new_expr = idp_rewrite(expr, idp_empty_table())\n        Array::set(stmts, i, SLet(exported, is_rec, name, ty, new_expr))\n      },\n      _ => ()\n    }\n    i = i + 1\n  }\n}\n\nfn idp_empty_table() -> (Array[String], Array[Array[String]], Array[Expr]) {\n  (array_empty_str(), array_empty_arr_str(), array_empty_expr())\n}\n\nfn array_empty_str() -> Array[String] {\n  Array::slice([\n    \"\"\n  ], 0, 0)\n}\n\nfn array_empty_arr_str() -> Array[Array[String]] {\n  Array::slice([\n    array_empty_str()\n  ], 0, 0)\n}\n\nfn array_empty_expr() -> Array[Expr] {\n  Array::slice([\n    EUnit\n  ], 0, 0)\n}\n\nfn array_empty_ecfg() -> Array[(String, Array[String], Array[String])] {\n  Array::slice([\n    (\"\", array_empty_str(), array_empty_str())\n  ], 0, 0)\n}\n\nfn array_empty_scope() -> Array[(String, String)] {\n  Array::slice([\n    (\"\", \"\")\n  ], 0, 0)\n}\n\nfn idp_table_is_empty(table: (Array[String], Array[Array[String]], Array[Expr])) -> Bool {\n  let (names, _, _) = table\n  Array::length(names) == 0\n}\n\nfn idp_table_lookup(table: (Array[String], Array[Array[String]], Array[Expr]), qname: String) -> Int {\n  let (names, _, _) = table\n  let mut i = 0\n  let mut found = -1\n  while i < Array::length(names) {\n    if Array::get(names, i) == qname {\n      found = i\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  found\n}\n\nfn idp_has_unsafe_construct(expr: Expr) -> Bool {\n  match expr {\n    EFn(_, _, _, _, _, _) => true,\n    EHandle(_, _) => true,\n    ELet(_, v, b, _) => idp_has_unsafe_construct(v) || idp_has_unsafe_construct(b),\n    ELetMut(_, v, b, _) => idp_has_unsafe_construct(v) || idp_has_unsafe_construct(b),\n    ELetRec(_, v, b) => idp_has_unsafe_construct(v) || idp_has_unsafe_construct(b),\n    ESeq(a, b) => idp_has_unsafe_construct(a) || idp_has_unsafe_construct(b),\n    EIf(c, t, e) => idp_has_unsafe_construct(c) || idp_has_unsafe_construct(t) || idp_has_unsafe_construct(e),\n    EMatch(s, arms) => idp_has_unsafe_construct(s) || idp_arms_have_unsafe_construct(arms),\n    EWhile(c, b) => idp_has_unsafe_construct(c) || idp_has_unsafe_construct(b),\n    EForIn(_, _, it, b) => idp_has_unsafe_construct(it) || idp_has_unsafe_construct(b),\n    ECall(callee, args, _) => match callee {\n      EIdent(nm, _) => if nm == \"perform\" && Array::length(args) == 1 {\n        idp_perform_operand_has_unsafe_construct(Array::get(args, 0))\n      } else if idp_is_pure_builtin_call(nm) {\n        idp_exprs_have_unsafe_construct(args)\n      } else {\n        idp_call_is_unsafe(callee) || idp_exprs_have_unsafe_construct(args)\n      },\n      _ => idp_call_is_unsafe(callee) || idp_exprs_have_unsafe_construct(args)\n    },\n    EBinOp(_, l, r) => idp_has_unsafe_construct(l) || idp_has_unsafe_construct(r),\n    EUnaryOp(_, e2) => idp_has_unsafe_construct(e2),\n    EAssign(_, v, c) => idp_has_unsafe_construct(v) || idp_has_unsafe_construct(c),\n    EAssignOp(_, _, v, c) => idp_has_unsafe_construct(v) || idp_has_unsafe_construct(c),\n    EDot(_, _, _, _) => true,\n    ELabeledArg(_, _, v) => idp_has_unsafe_construct(v),\n    EReturn(e2) => idp_has_unsafe_construct(e2),\n    EBreak(opt) => match opt {\n      Some(e2) => idp_has_unsafe_construct(e2),\n      None => false\n    },\n    EContinue(args) => idp_exprs_have_unsafe_construct(args),\n    ETuple(elems) => idp_exprs_have_unsafe_construct(elems),\n    EArray(elems) => idp_exprs_have_unsafe_construct(elems),\n    ERecord(_, fields, _) => idp_fields_have_unsafe_construct(fields),\n    EMap(fields) => idp_fields_have_unsafe_construct(fields),\n    ESpread(e2) => idp_has_unsafe_construct(e2),\n    ELoop(pairs, b) => idp_pairs_have_unsafe_construct(pairs) || idp_has_unsafe_construct(b),\n    _ => false\n  }\n}\n\nfn idp_call_is_unsafe(callee: Expr) -> Bool {\n  match callee {\n    EIdent(nm, _) => nm != \"perform\",\n    _ => true\n  }\n}\n\nfn idp_pure_builtin_names() -> Array[String] {\n  [\n    \"String::concat\",\n    \"String::equals\",\n    \"String::length\",\n    \"String::substring\",\n    \"string_char_at\",\n    \"String::trim\",\n    \"String::split\",\n    \"String::contains\",\n    \"String::index_of\",\n    \"String::to_lower\",\n    \"String::to_upper\",\n    \"String::ends_with\",\n    \"String::starts_with\",\n    \"String::char_code_at\",\n    \"String::last_index_of\",\n    \"String::from_char_code\",\n    \"String::join\",\n    \"Char::to_int\",\n    \"Char::from_int\",\n    \"Int::to_double\",\n    \"Int::to_float\",\n    \"Int::to_string\",\n    \"Double::to_int\",\n    \"Float::to_int\",\n    \"Double::to_string\",\n    \"Float::to_string\",\n    \"Double::abs\",\n    \"Double::floor\",\n    \"Double::ceil\",\n    \"Double::max\",\n    \"Double::min\",\n    \"Int::parse\",\n    \"Double::parse\",\n    \"__index\",\n    \"Array::get\",\n    \"Map::get\",\n    \"Bytes::get\",\n    \"Array::length\",\n    \"Map::size\",\n    \"Bytes::length\",\n    \"__to_string\",\n    \"not\",\n    \"__generic_add\",\n    \"__generic_rel_diff\",\n    \"str_lex_diff\",\n    \"Array::set\",\n    \"sleep\",\n    \"sleep_blocking\",\n    \"Future::pending\",\n    \"Future::ready\",\n    \"Future::resolve\",\n    \"host_future_get\",\n    \"vibe_hf_get_raw\",\n    \"vibe_hf_wait_raw\",\n    \"host_future_named\",\n    \"host_stream_named\",\n    \"vibe_hs_close_raw\",\n    \"vibe_hs_read_raw\"\n  ]\n}\n\nfn idp_is_host_future_named_raw(nm: String) -> Bool {\n  String::starts_with(nm, \"vibe_hf_get_raw$\")\n}\n\nfn idp_is_host_stream_named_raw(nm: String) -> Bool {\n  String::starts_with(nm, \"vibe_hs_get_raw$\")\n}\n\nfn idp_is_pure_builtin_call(nm: String) -> Bool {\n  if idp_is_host_future_named_raw(nm) || idp_is_host_stream_named_raw(nm) {\n    true\n  } else {\n    let names = idp_pure_builtin_names()\n    let mut i = 0\n    let mut found = false\n    while i < Array::length(names) {\n      if Array::get(names, i) == nm {\n        found = true\n      } else {\n        ()\n      }\n      i = i + 1\n    }\n    found\n  }\n}\n\nfn idp_perform_operand_has_unsafe_construct(operand: Expr) -> Bool {\n  match operand {\n    EIdent(_, _) => false,\n    ECall(op_callee, op_args, _) => match op_callee {\n      EIdent(_, _) => idp_exprs_have_unsafe_construct(op_args),\n      _ => true\n    },\n    _ => true\n  }\n}\n\nfn idp_exprs_have_unsafe_construct(exprs: Array[Expr]) -> Bool {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(exprs) {\n    if idp_has_unsafe_construct(Array::get(exprs, i)) {\n      found = true\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  found\n}\n\nfn idp_fields_have_unsafe_construct(fields: Array[(String, Expr)]) -> Bool {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(fields) {\n    let (_, v) = Array::get(fields, i)\n    if idp_has_unsafe_construct(v) {\n      found = true\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  found\n}\n\nfn idp_pairs_have_unsafe_construct(pairs: Array[(String, Expr)]) -> Bool {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(pairs) {\n    let (_, v) = Array::get(pairs, i)\n    if idp_has_unsafe_construct(v) {\n      found = true\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  found\n}\n\nfn idp_arms_have_unsafe_construct(arms: Array[(Pat, Expr)]) -> Bool {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(arms) {\n    let (_, ex) = Array::get(arms, i)\n    if idp_has_unsafe_construct(ex) {\n      found = true\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  found\n}\n\n\nfn idp_pat_bind_names(pat: Pat) -> Array[String] {\n  match pat {\n    PCtor(_, subpats) => for p in subpats {\n      match p {\n        PBind(n) => n,\n        _ => \"_\"\n      }\n    },\n    _ => array_empty_str()\n  }\n}\n\nfn idp_pat_qname(pat: Pat) -> String {\n  match pat {\n    PCtor(name, _) => name,\n    _ => \"\"\n  }\n}\n\nfn idp_strip_tail_resume(expr: Expr) -> Expr {\n  match expr {\n    EIf(c, t, e) => EIf(c, idp_strip_tail_resume(t), idp_strip_tail_resume(e)),\n    EMatch(s, arms) => EMatch(s, idp_strip_tail_resume_arms(arms)),\n    ELet(n, v, b, off) => ELet(n, v, idp_strip_tail_resume(b), off),\n    ELetMut(n, v, b, off) => ELetMut(n, v, idp_strip_tail_resume(b), off),\n    ELetRec(n, v, b) => ELetRec(n, v, idp_strip_tail_resume(b)),\n    ESeq(a, b) => ESeq(a, idp_strip_tail_resume(b)),\n    EAssign(n, v, c) => EAssign(n, v, idp_strip_tail_resume(c)),\n    EAssignOp(n, op, v, c) => EAssignOp(n, op, v, idp_strip_tail_resume(c)),\n    EReturn(e2) => EReturn(idp_strip_tail_resume(e2)),\n    ECall(callee, args, _) => match callee {\n      EIdent(nm, _) => if nm == \"resume\" && Array::length(args) == 1 {\n        Array::get(args, 0)\n      } else {\n        expr\n      },\n      _ => expr\n    },\n    _ => expr\n  }\n}\n\nfn idp_strip_tail_resume_arms(arms: Array[(Pat, Expr)]) -> Array[(Pat, Expr)] {\n  for a in arms {\n    let (p, ex) = a\n    (p, idp_strip_tail_resume(ex))\n  }\n}\n\n\nfn idp_rewrite(expr: Expr, table: (Array[String], Array[Array[String]], Array[Expr])) -> Expr {\n  match expr {\n    EHandle(body, arms) => idp_rewrite_handle(body, arms, table),\n    EFn(tps, tbs, params, ret, eff, b) => EFn(tps, tbs, params, ret, eff, idp_rewrite(b, idp_empty_table())),\n    ELet(n, v, b, off) => ELet(n, idp_rewrite(v, table), idp_rewrite(b, table), off),\n    ELetMut(n, v, b, off) => ELetMut(n, idp_rewrite(v, table), idp_rewrite(b, table), off),\n    ELetRec(n, v, b) => ELetRec(n, idp_rewrite(v, table), idp_rewrite(b, table)),\n    ESeq(a, b) => ESeq(idp_rewrite(a, table), idp_rewrite(b, table)),\n    EIf(c, t, e) => EIf(idp_rewrite(c, table), idp_rewrite(t, table), idp_rewrite(e, table)),\n    EMatch(s, arms) => EMatch(idp_rewrite(s, table), idp_rewrite_arms(arms, table)),\n    EWhile(c, b) => EWhile(idp_rewrite(c, table), idp_rewrite(b, table)),\n    EForIn(n, idx, it, b) => EForIn(n, idx, idp_rewrite(it, table), idp_rewrite(b, table)),\n    ECall(callee, args, off) => idp_rewrite_call(callee, args, off, table),\n    EBinOp(op, l, r) => EBinOp(op, idp_rewrite(l, table), idp_rewrite(r, table)),\n    EUnaryOp(op, e2) => EUnaryOp(op, idp_rewrite(e2, table)),\n    EAssign(n, v, c) => EAssign(n, idp_rewrite(v, table), idp_rewrite(c, table)),\n    EAssignOp(n, op, v, c) => EAssignOp(n, op, idp_rewrite(v, table), idp_rewrite(c, table)),\n    EDot(o, f, off1, off2) => EDot(idp_rewrite(o, table), f, off1, off2),\n    ELabeledArg(l, n, v) => ELabeledArg(l, n, idp_rewrite(v, table)),\n    EReturn(e2) => EReturn(idp_rewrite(e2, table)),\n    EBreak(opt) => EBreak(match opt {\n      Some(e2) => Some(idp_rewrite(e2, table)),\n      None => None\n    }),\n    EContinue(args) => EContinue(idp_rewrite_exprs(args, table)),\n    ETuple(elems) => ETuple(idp_rewrite_exprs(elems, table)),\n    EArray(elems) => EArray(idp_rewrite_exprs(elems, table)),\n    ERecord(n, fields, tas) => ERecord(n, idp_rewrite_fields(fields, table), tas),\n    EMap(fields) => EMap(idp_rewrite_fields(fields, table)),\n    ESpread(e2) => ESpread(idp_rewrite(e2, table)),\n    ELoop(pairs, b) => ELoop(idp_rewrite_pairs(pairs, table), idp_rewrite(b, table)),\n    _ => expr\n  }\n}\n\nfn idp_rewrite_exprs(exprs: Array[Expr], table: (Array[String], Array[Array[String]], Array[Expr])) -> Array[Expr] {\n  for e in exprs {\n    idp_rewrite(e, table)\n  }\n}\n\nfn idp_rewrite_fields(fields: Array[(String, Expr)], table: (Array[String], Array[Array[String]], Array[Expr])) -> Array[(String, Expr)] {\n  for f in fields {\n    let (n, v) = f\n    (n, idp_rewrite(v, table))\n  }\n}\n\nfn idp_rewrite_pairs(pairs: Array[(String, Expr)], table: (Array[String], Array[Array[String]], Array[Expr])) -> Array[(String, Expr)] {\n  for p in pairs {\n    let (n, v) = p\n    (n, idp_rewrite(v, table))\n  }\n}\n\nfn idp_rewrite_arms(arms: Array[(Pat, Expr)], table: (Array[String], Array[Array[String]], Array[Expr])) -> Array[(Pat, Expr)] {\n  for a in arms {\n    let (p, ex) = a\n    (p, idp_rewrite(ex, table))\n  }\n}\n\nfn idp_arms_discharge_error(arms: Array[(Pat, Expr)]) -> Bool {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(arms) {\n    let (p, _) = Array::get(arms, i)\n    let q = idp_pat_qname(p)\n    if is_exception_throw_handler_name(q) {\n      found = true\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  found\n}\n\nfn idp_rewrite_handle(body: Expr, arms: Array[(Pat, Expr)], outer_table: (Array[String], Array[Array[String]], Array[Expr])) -> Expr {\n  if idp_has_unsafe_construct(body) || idp_arms_discharge_error(arms) {\n    EHandle(idp_rewrite(body, idp_empty_table()), idp_rewrite_arms(arms, idp_empty_table()))\n  } else {\n    let op_names = for a in arms {\n      let (p, _) = a\n      idp_pat_qname(p)\n    }\n    let bind_names = for a in arms {\n      let (p, _) = a\n      idp_pat_bind_names(p)\n    }\n    let prepared_bodies = for a in arms {\n      let (_, ex) = a\n      idp_strip_tail_resume(idp_rewrite(ex, idp_empty_table()))\n    }\n    let table = (op_names, bind_names, prepared_bodies)\n    idp_rewrite(body, table)\n  }\n}\n\nfn idp_rewrite_call(callee: Expr, args: Array[Expr], off: Int, table: (Array[String], Array[Array[String]], Array[Expr])) -> Expr {\n  match callee {\n    EIdent(nm, _) => if nm == \"perform\" && Array::length(args) == 1 && !idp_table_is_empty(table) {\n      idp_rewrite_perform(Array::get(args, 0), table)\n    } else {\n      ECall(idp_rewrite(callee, table), idp_rewrite_exprs(args, table), off)\n    },\n    _ => ECall(idp_rewrite(callee, table), idp_rewrite_exprs(args, table), off)\n  }\n}\n\nfn idp_rewrite_perform(operand: Expr, table: (Array[String], Array[Array[String]], Array[Expr])) -> Expr {\n  match operand {\n    EIdent(qname, _) => idp_splice_or_leave(qname, array_empty_expr(), operand, table),\n    ECall(op_callee, op_args, _) => match op_callee {\n      EIdent(qname, _) => idp_splice_or_leave(qname, idp_rewrite_exprs(op_args, table), operand, table),\n      _ => ECall(EIdent(\"perform\", -1), [\n        idp_rewrite(operand, table)\n      ], -1)\n    },\n    _ => ECall(EIdent(\"perform\", -1), [\n      idp_rewrite(operand, table)\n    ], -1)\n  }\n}\n\nfn idp_splice_or_leave(qname: String, actual_args: Array[Expr], original_operand: Expr, table: (Array[String], Array[Array[String]], Array[Expr])) -> Expr {\n  let idx = idp_table_lookup(table, qname)\n  if idx < 0 {\n    ECall(EIdent(\"perform\", -1), [\n      original_operand\n    ], -1)\n  } else {\n    let (_, bind_names_list, prepared_bodies) = table\n    let bind_names = Array::get(bind_names_list, idx)\n    let prepared_body = Array::get(prepared_bodies, idx)\n    idp_bind_args(bind_names, actual_args, prepared_body)\n  }\n}\n\nfn idp_bind_args(bind_names: Array[String], actual_args: Array[Expr], prepared_body: Expr) -> Expr {\n  let n = Array::length(bind_names)\n  let mut result = prepared_body\n  let mut i = n - 1\n  while i >= 0 {\n    if i < Array::length(actual_args) {\n      result = ELet(Array::get(bind_names, i), Array::get(actual_args, i), result, -1)\n    } else {\n      ()\n    }\n    i = i - 1\n  }\n  result\n}\n\nfn edp_ho_row_names_contain(row: Option[String], ename: String) -> Bool {\n  match row {\n    None => false,\n    Some(s) => {\n      let parts = String::split(s, \",\")\n      let mut i = 0\n      let mut found = false\n      while i < Array::length(parts) {\n        let label = String::trim(Array::get(parts, i))\n        let qi = String::index_of(label, \"::\")\n        let head = if qi > 0 {\n          label[0: qi]\n        } else {\n          label\n        }\n        let bi = String::index_of(head, \"[\")\n        let base = if bi > 0 {\n          head[0: bi]\n        } else {\n          head\n        }\n        if base == ename {\n          found = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      found\n    }\n  }\n}\n\nfn edp_ho_texpr_has_block_row(t: TypeExpr, ename: String) -> Bool {\n  match t {\n    TyFn(ps, ret, eff) => if edp_ho_row_names_contain(eff, ename) {\n      true\n    } else {\n      edp_ho_texprs_have_block_row(ps, ename) || edp_ho_texpr_has_block_row(ret, ename)\n    },\n    TyApp(_, args) => edp_ho_texprs_have_block_row(args, ename),\n    TyTuple(elems) => edp_ho_texprs_have_block_row(elems, ename),\n    _ => false\n  }\n}\n\nfn edp_ho_texprs_have_block_row(ts: Array[TypeExpr], ename: String) -> Bool {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(ts) && !found {\n    found = edp_ho_texpr_has_block_row(Array::get(ts, i), ename)\n    i = i + 1\n  }\n  found\n}\n\nfn edp_higher_order_error_msg(ename: String, ho: String) -> String {\n  let tail = String::concat(ho, String::concat(\"` takes a block whose own row carries '\", String::concat(ename, \"', and invoking that block from a handler arm would require migrating the effect's evidence across the arm boundary. Higher-order effects (an operation parameterised by an EFFECTFUL block) are not supported -- ADR-0089 Part A / #1347. Make the block PURE (a row-free function parameter works, and keeps the arm's start/end pairing), or handle the effect inside the function that builds the block\")))\n  String::concat(\"effect '\", String::concat(ename, String::concat(\"' cannot be compiled here: operation `\", tail)))\n}\n\nfn edp_higher_order_block_owner(effect_defs: Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], ename: String) -> String {\n  let mut i = 0\n  let mut hit = \"\"\n  while i < Array::length(effect_defs) && String::length(hit) == 0 {\n    let (tname, ops) = Array::get(effect_defs, i)\n    let mut j = 0\n    while j < Array::length(ops) && String::length(hit) == 0 {\n      let (opname, params, _) = Array::get(ops, j)\n      if edp_ho_texprs_have_block_row(params, ename) {\n        hit = String::concat(tname, String::concat(\"::\", opname))\n      } else {\n        ()\n      }\n      j = j + 1\n    }\n    i = i + 1\n  }\n  hit\n}\n\nexport fn evidence_dict_pass(stmts: Array[Stmt], entry_name: String) -> Array[String] {\n  let errs = empty_str_array()\n  let effect_defs = edp_collect_effect_defs(stmts)\n  let vhe_names = empty_str_array()\n  let mut vhn = 0\n  while vhn < Array::length(effect_defs) {\n    let (vh_declared, _) = Array::get(effect_defs, vhn)\n    if edp_str_array_contains(vhe_names, vh_declared) {\n      ()\n    } else {\n      Array::push(vhe_names, vh_declared)\n    }\n    vhn = vhn + 1\n  }\n  edp_collect_handle_effect_names(stmts, vhe_names)\n  let vhe_fn_defs = edp_collect_fn_defs(stmts)\n  let vhe_fn_names = edp_all_fn_names(vhe_fn_defs)\n  let vhe_inert = edp_pure_fn_names(vhe_fn_defs)\n  edp_append_free_host_inert_names(stmts, vhe_inert)\n  let mut vhi = 0\n  while vhi < Array::length(vhe_names) {\n    let vh_name = Array::get(vhe_names, vhi)\n    if edp_program_user_performs(stmts, vh_name) {\n      edp_erase_effect_handles(stmts, vh_name, true, edp_collect_performing_fns(stmts, vhe_fn_defs, vh_name, vhe_inert, vhe_fn_names), vhe_inert, vhe_fn_names)\n    } else {\n      edp_erase_effect_handles(stmts, vh_name, false, empty_str_array(), vhe_inert, vhe_fn_names)\n    }\n    vhi = vhi + 1\n  }\n  let fn_defs = edp_collect_fn_defs(stmts)\n  edp_alpha_rename_shadowed(stmts, effect_defs, fn_defs)\n  let keep = dce_keep_flags(stmts, [\n    entry_name\n  ])\n  let plans = edp_plan_migrations(stmts, effect_defs, fn_defs, keep, errs)\n  let mut pi = 0\n  while pi < Array::length(plans) {\n    let (ename, ops, needing, handle_sites) = Array::get(plans, pi)\n    edp_apply_migration(stmts, ename, ops, needing, handle_sites, fn_defs)\n    pi = pi + 1\n  }\n  if Array::length(errs) == 0 {\n    let bad = edp_first_live_replay_handle(stmts, keep)\n    if String::length(bad) > 0 {\n      let ho = edp_higher_order_block_owner(effect_defs, bad)\n      if String::length(ho) > 0 {\n        Array::push(errs, edp_higher_order_error_msg(bad, ho))\n      } else {\n        Array::push(errs, String::concat(String::concat(\"handle of effect '\", bad), \"' cannot be compiled: the site is not eligible for evidence-passing migration (ADR-0076) and the replay engine was removed (追記34 V2) -- restructure the handled body so its performs are statically visible to the migration (direct performs, calls to named top-level functions, or row-annotated closure literals), or handle the effect inside the function that performs it\"))\n      }\n    } else {\n      ()\n    }\n  } else {\n    ()\n  }\n  errs\n}\n\nfn edp_user_perform_effect_of(expr: Expr) -> String {\n  match expr {\n    ECall(callee, args, _) => match callee {\n      EIdent(nm, _) => if nm == \"perform\" && Array::length(args) == 1 {\n        let q = match Array::get(args, 0) {\n          ECall(inner, _, _) => match inner {\n            EIdent(qn, _) => qn,\n            _ => \"\"\n          },\n          EIdent(qn, _) => qn,\n          _ => \"\"\n        }\n        if String::length(q) > 0 {\n          edp_effect_name_of(q)\n        } else {\n          \"\"\n        }\n      } else {\n        \"\"\n      },\n      _ => \"\"\n    },\n    _ => \"\"\n  }\n}\n\nfn edp_performs_user_effect_expr(expr: Expr, ename: String) -> Bool {\n  if edp_user_perform_effect_of(expr) == ename {\n    true\n  } else {\n    match expr {\n      EFn(_, _, _, _, _, b) => edp_performs_user_effect_expr(b, ename),\n      EHandle(b, arms) => {\n        let mut found = edp_performs_user_effect_expr(b, ename)\n        let mut i = 0\n        while i < Array::length(arms) && !found {\n          let (_, ex) = Array::get(arms, i)\n          found = edp_performs_user_effect_expr(ex, ename)\n          i = i + 1\n        }\n        found\n      },\n      EIf(c, t, e2) => edp_performs_user_effect_expr(c, ename) || edp_performs_user_effect_expr(t, ename) || edp_performs_user_effect_expr(e2, ename),\n      EMatch(s, arms) => {\n        let mut found = edp_performs_user_effect_expr(s, ename)\n        let mut i = 0\n        while i < Array::length(arms) && !found {\n          let (_, ex) = Array::get(arms, i)\n          found = edp_performs_user_effect_expr(ex, ename)\n          i = i + 1\n        }\n        found\n      },\n      EWhile(c, b) => edp_performs_user_effect_expr(c, ename) || edp_performs_user_effect_expr(b, ename),\n      EForIn(_, _, it, b) => edp_performs_user_effect_expr(it, ename) || edp_performs_user_effect_expr(b, ename),\n      ELoop(pairs, b) => {\n        let mut found = edp_performs_user_effect_expr(b, ename)\n        let mut i = 0\n        while i < Array::length(pairs) && !found {\n          let (_, v) = Array::get(pairs, i)\n          found = edp_performs_user_effect_expr(v, ename)\n          i = i + 1\n        }\n        found\n      },\n      ELet(_, v, b, _) => edp_performs_user_effect_expr(v, ename) || edp_performs_user_effect_expr(b, ename),\n      ELetMut(_, v, b, _) => edp_performs_user_effect_expr(v, ename) || edp_performs_user_effect_expr(b, ename),\n      ELetRec(_, v, b) => edp_performs_user_effect_expr(v, ename) || edp_performs_user_effect_expr(b, ename),\n      ESeq(a, b) => edp_performs_user_effect_expr(a, ename) || edp_performs_user_effect_expr(b, ename),\n      EAssign(_, v, c) => edp_performs_user_effect_expr(v, ename) || edp_performs_user_effect_expr(c, ename),\n      EAssignOp(_, _, v, c) => edp_performs_user_effect_expr(v, ename) || edp_performs_user_effect_expr(c, ename),\n      EReturn(e2) => edp_performs_user_effect_expr(e2, ename),\n      EDot(o, _, _, _) => edp_performs_user_effect_expr(o, ename),\n      ECall(callee, args, _) => edp_performs_user_effect_expr(callee, ename) || edp_performs_user_effect_exprs(args, ename),\n      EBinOp(_, l, r) => edp_performs_user_effect_expr(l, ename) || edp_performs_user_effect_expr(r, ename),\n      EUnaryOp(_, e2) => edp_performs_user_effect_expr(e2, ename),\n      ELabeledArg(_, _, v) => edp_performs_user_effect_expr(v, ename),\n      EBreak(opt) => match opt {\n        Some(e2) => edp_performs_user_effect_expr(e2, ename),\n        None => false\n      },\n      EContinue(args) => edp_performs_user_effect_exprs(args, ename),\n      ETuple(elems) => edp_performs_user_effect_exprs(elems, ename),\n      EArray(elems) => edp_performs_user_effect_exprs(elems, ename),\n      ERecord(_, fields, _) => {\n        let mut found = false\n        let mut i = 0\n        while i < Array::length(fields) && !found {\n          let (_, v) = Array::get(fields, i)\n          found = edp_performs_user_effect_expr(v, ename)\n          i = i + 1\n        }\n        found\n      },\n      EMap(fields) => {\n        let mut found = false\n        let mut i = 0\n        while i < Array::length(fields) && !found {\n          let (_, v) = Array::get(fields, i)\n          found = edp_performs_user_effect_expr(v, ename)\n          i = i + 1\n        }\n        found\n      },\n      ESpread(e2) => edp_performs_user_effect_expr(e2, ename),\n      _ => false\n    }\n  }\n}\n\nfn edp_performs_user_effect_exprs(es: Array[Expr], ename: String) -> Bool {\n  let mut found = false\n  let mut i = 0\n  while i < Array::length(es) && !found {\n    found = edp_performs_user_effect_expr(Array::get(es, i), ename)\n    i = i + 1\n  }\n  found\n}\n\nfn edp_body_may_perform(body: Expr, ename: String, perf_fns: Array[String], inert: Array[String], fn_names: Array[String]) -> Bool {\n  if edp_user_perform_effect_of(body) == ename {\n    true\n  } else {\n    match body {\n      ECall(callee, args, _) => match callee {\n        EIdent(nm, _) => if nm == \"perform\" {\n          edp_may_perform_exprs(args, ename, perf_fns, inert, fn_names)\n        } else if edp_str_array_contains(perf_fns, nm) {\n          true\n        } else if edp_callee_is_resolvable(nm, inert, fn_names) {\n          edp_may_perform_exprs(args, ename, perf_fns, inert, fn_names)\n        } else {\n          true\n        },\n        _ => true\n      },\n      EHandle(b, arms) => if edp_handle_matches_effect(arms, ename) {\n        edp_may_perform_arms(arms, ename, perf_fns, inert, fn_names)\n      } else {\n        edp_body_may_perform(b, ename, perf_fns, inert, fn_names) || edp_may_perform_arms(arms, ename, perf_fns, inert, fn_names)\n      },\n      EFn(_, _, _, _, _, b) => edp_body_may_perform(b, ename, perf_fns, inert, fn_names),\n      EIf(c, t, e2) => edp_body_may_perform(c, ename, perf_fns, inert, fn_names) || edp_body_may_perform(t, ename, perf_fns, inert, fn_names) || edp_body_may_perform(e2, ename, perf_fns, inert, fn_names),\n      EMatch(s, arms) => edp_body_may_perform(s, ename, perf_fns, inert, fn_names) || edp_may_perform_arms(arms, ename, perf_fns, inert, fn_names),\n      EWhile(c, b) => edp_body_may_perform(c, ename, perf_fns, inert, fn_names) || edp_body_may_perform(b, ename, perf_fns, inert, fn_names),\n      EForIn(_, _, it, b) => edp_body_may_perform(it, ename, perf_fns, inert, fn_names) || edp_body_may_perform(b, ename, perf_fns, inert, fn_names),\n      ELoop(pairs, b) => edp_may_perform_pairs(pairs, ename, perf_fns, inert, fn_names) || edp_body_may_perform(b, ename, perf_fns, inert, fn_names),\n      ELet(_, v, b, _) => edp_body_may_perform(v, ename, perf_fns, inert, fn_names) || edp_body_may_perform(b, ename, perf_fns, inert, fn_names),\n      ELetMut(_, v, b, _) => edp_body_may_perform(v, ename, perf_fns, inert, fn_names) || edp_body_may_perform(b, ename, perf_fns, inert, fn_names),\n      ELetRec(_, v, b) => edp_body_may_perform(v, ename, perf_fns, inert, fn_names) || edp_body_may_perform(b, ename, perf_fns, inert, fn_names),\n      ESeq(a, b) => edp_body_may_perform(a, ename, perf_fns, inert, fn_names) || edp_body_may_perform(b, ename, perf_fns, inert, fn_names),\n      EAssign(_, v, c) => edp_body_may_perform(v, ename, perf_fns, inert, fn_names) || edp_body_may_perform(c, ename, perf_fns, inert, fn_names),\n      EAssignOp(_, _, v, c) => edp_body_may_perform(v, ename, perf_fns, inert, fn_names) || edp_body_may_perform(c, ename, perf_fns, inert, fn_names),\n      EReturn(e2) => edp_body_may_perform(e2, ename, perf_fns, inert, fn_names),\n      EDot(o, _, _, _) => edp_body_may_perform(o, ename, perf_fns, inert, fn_names),\n      EBinOp(_, l, r) => edp_body_may_perform(l, ename, perf_fns, inert, fn_names) || edp_body_may_perform(r, ename, perf_fns, inert, fn_names),\n      EUnaryOp(_, e2) => edp_body_may_perform(e2, ename, perf_fns, inert, fn_names),\n      ELabeledArg(_, _, v) => edp_body_may_perform(v, ename, perf_fns, inert, fn_names),\n      EBreak(opt) => match opt {\n        Some(e2) => edp_body_may_perform(e2, ename, perf_fns, inert, fn_names),\n        None => false\n      },\n      EContinue(args) => edp_may_perform_exprs(args, ename, perf_fns, inert, fn_names),\n      ETuple(elems) => edp_may_perform_exprs(elems, ename, perf_fns, inert, fn_names),\n      EArray(elems) => edp_may_perform_exprs(elems, ename, perf_fns, inert, fn_names),\n      ERecord(_, fields, _) => edp_may_perform_fields(fields, ename, perf_fns, inert, fn_names),\n      EMap(fields) => edp_may_perform_fields(fields, ename, perf_fns, inert, fn_names),\n      ESpread(e2) => edp_body_may_perform(e2, ename, perf_fns, inert, fn_names),\n      _ => false\n    }\n  }\n}\n\nfn edp_may_perform_exprs(es: Array[Expr], ename: String, perf_fns: Array[String], inert: Array[String], fn_names: Array[String]) -> Bool {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(es) && !found {\n    found = edp_body_may_perform(Array::get(es, i), ename, perf_fns, inert, fn_names)\n    i = i + 1\n  }\n  found\n}\n\nfn edp_may_perform_arms(arms: Array[(Pat, Expr)], ename: String, perf_fns: Array[String], inert: Array[String], fn_names: Array[String]) -> Bool {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(arms) && !found {\n    let (_, ex) = Array::get(arms, i)\n    found = edp_body_may_perform(ex, ename, perf_fns, inert, fn_names)\n    i = i + 1\n  }\n  found\n}\n\nfn edp_may_perform_pairs(pairs: Array[(String, Expr)], ename: String, perf_fns: Array[String], inert: Array[String], fn_names: Array[String]) -> Bool {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(pairs) && !found {\n    let (_, v) = Array::get(pairs, i)\n    found = edp_body_may_perform(v, ename, perf_fns, inert, fn_names)\n    i = i + 1\n  }\n  found\n}\n\nfn edp_may_perform_fields(fields: Array[(String, Expr)], ename: String, perf_fns: Array[String], inert: Array[String], fn_names: Array[String]) -> Bool {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(fields) && !found {\n    let (_, v) = Array::get(fields, i)\n    found = edp_body_may_perform(v, ename, perf_fns, inert, fn_names)\n    i = i + 1\n  }\n  found\n}\n\nfn edp_collect_performing_fns(stmts: Array[Stmt], fn_defs: Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], ename: String, inert: Array[String], fn_names: Array[String]) -> Array[String] {\n  let out = empty_str_array()\n  let mut i = 0\n  while i < Array::length(fn_defs) {\n    let (_, _, _, nm, _, _) = Array::get(fn_defs, i)\n    match edp_find_fn_body(stmts, fn_defs, nm) {\n      Some(body) => if (edp_performs_user_effect_expr(body, ename) || edp_body_has_opaque_call(body, inert, fn_names)) && !edp_str_array_contains(out, nm) {\n        Array::push(out, nm)\n      } else {\n        ()\n      },\n      None => ()\n    }\n    i = i + 1\n  }\n  let mut grew = true\n  let mut rounds = 0\n  while grew && rounds < Array::length(fn_defs) + 1 {\n    grew = false\n    rounds = rounds + 1\n    let mut j = 0\n    while j < Array::length(fn_defs) {\n      let (_, _, _, nm2, _, _) = Array::get(fn_defs, j)\n      if edp_str_array_contains(out, nm2) {\n        ()\n      } else {\n        match edp_find_fn_body(stmts, fn_defs, nm2) {\n          Some(body2) => if edp_body_calls_any(body2, out) {\n            Array::push(out, nm2)\n            grew = true\n          } else {\n            ()\n          },\n          None => ()\n        }\n      }\n      j = j + 1\n    }\n  }\n  out\n}\n\nfn edp_callee_is_resolvable(nm: String, inert: Array[String], fn_names: Array[String]) -> Bool {\n  nm == \"perform\" || nm == \"resume\" || edp_is_pure_builtin_call(nm) || edp_name_is_host_raw_shape(nm) || edp_str_array_contains(inert, nm) || edp_str_array_contains(fn_names, nm)\n}\n\nfn edp_body_has_opaque_call(expr: Expr, inert: Array[String], fn_names: Array[String]) -> Bool {\n  match expr {\n    ECall(callee, args, _) => {\n      let opaque = match callee {\n        EIdent(nm, _) => !edp_callee_is_resolvable(nm, inert, fn_names),\n        _ => true\n      }\n      opaque || edp_opaque_call_exprs(args, inert, fn_names)\n    },\n    EFn(_, _, _, _, _, b) => edp_body_has_opaque_call(b, inert, fn_names),\n    EHandle(b, arms) => edp_body_has_opaque_call(b, inert, fn_names) || edp_opaque_call_arms(arms, inert, fn_names),\n    EIf(c, t, e2) => edp_body_has_opaque_call(c, inert, fn_names) || edp_body_has_opaque_call(t, inert, fn_names) || edp_body_has_opaque_call(e2, inert, fn_names),\n    EMatch(s, arms) => edp_body_has_opaque_call(s, inert, fn_names) || edp_opaque_call_arms(arms, inert, fn_names),\n    EWhile(c, b) => edp_body_has_opaque_call(c, inert, fn_names) || edp_body_has_opaque_call(b, inert, fn_names),\n    EForIn(_, _, it, b) => edp_body_has_opaque_call(it, inert, fn_names) || edp_body_has_opaque_call(b, inert, fn_names),\n    ELoop(pairs, b) => {\n      let mut i = 0\n      let mut found = false\n      while i < Array::length(pairs) && !found {\n        let (_, v) = Array::get(pairs, i)\n        found = edp_body_has_opaque_call(v, inert, fn_names)\n        i = i + 1\n      }\n      found || edp_body_has_opaque_call(b, inert, fn_names)\n    },\n    ELet(_, v, b, _) => edp_body_has_opaque_call(v, inert, fn_names) || edp_body_has_opaque_call(b, inert, fn_names),\n    ELetMut(_, v, b, _) => edp_body_has_opaque_call(v, inert, fn_names) || edp_body_has_opaque_call(b, inert, fn_names),\n    ELetRec(_, v, b) => edp_body_has_opaque_call(v, inert, fn_names) || edp_body_has_opaque_call(b, inert, fn_names),\n    ESeq(a, b) => edp_body_has_opaque_call(a, inert, fn_names) || edp_body_has_opaque_call(b, inert, fn_names),\n    EAssign(_, v, c) => edp_body_has_opaque_call(v, inert, fn_names) || edp_body_has_opaque_call(c, inert, fn_names),\n    EAssignOp(_, _, v, c) => edp_body_has_opaque_call(v, inert, fn_names) || edp_body_has_opaque_call(c, inert, fn_names),\n    EReturn(e2) => edp_body_has_opaque_call(e2, inert, fn_names),\n    EDot(o, _, _, _) => edp_body_has_opaque_call(o, inert, fn_names),\n    EBinOp(_, l, r) => edp_body_has_opaque_call(l, inert, fn_names) || edp_body_has_opaque_call(r, inert, fn_names),\n    EUnaryOp(_, e2) => edp_body_has_opaque_call(e2, inert, fn_names),\n    ELabeledArg(_, _, v) => edp_body_has_opaque_call(v, inert, fn_names),\n    EBreak(opt) => match opt {\n      Some(e2) => edp_body_has_opaque_call(e2, inert, fn_names),\n      None => false\n    },\n    EContinue(args) => edp_opaque_call_exprs(args, inert, fn_names),\n    ETuple(elems) => edp_opaque_call_exprs(elems, inert, fn_names),\n    EArray(elems) => edp_opaque_call_exprs(elems, inert, fn_names),\n    ERecord(_, fields, _) => edp_opaque_call_fields(fields, inert, fn_names),\n    EMap(fields) => edp_opaque_call_fields(fields, inert, fn_names),\n    ESpread(e2) => edp_body_has_opaque_call(e2, inert, fn_names),\n    _ => false\n  }\n}\n\nfn edp_opaque_call_exprs(es: Array[Expr], inert: Array[String], fn_names: Array[String]) -> Bool {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(es) && !found {\n    found = edp_body_has_opaque_call(Array::get(es, i), inert, fn_names)\n    i = i + 1\n  }\n  found\n}\n\nfn edp_opaque_call_arms(arms: Array[(Pat, Expr)], inert: Array[String], fn_names: Array[String]) -> Bool {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(arms) && !found {\n    let (_, ex) = Array::get(arms, i)\n    found = edp_body_has_opaque_call(ex, inert, fn_names)\n    i = i + 1\n  }\n  found\n}\n\nfn edp_opaque_call_fields(fields: Array[(String, Expr)], inert: Array[String], fn_names: Array[String]) -> Bool {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(fields) && !found {\n    let (_, v) = Array::get(fields, i)\n    found = edp_body_has_opaque_call(v, inert, fn_names)\n    i = i + 1\n  }\n  found\n}\n\nfn edp_body_calls_any(expr: Expr, names: Array[String]) -> Bool {\n  match expr {\n    ECall(callee, args, _) => {\n      let hit = match callee {\n        EIdent(nm, _) => edp_str_array_contains(names, nm),\n        _ => false\n      }\n      hit || edp_body_calls_any(callee, names) || edp_calls_any_exprs(args, names)\n    },\n    EFn(_, _, _, _, _, b) => edp_body_calls_any(b, names),\n    EHandle(b, arms) => edp_body_calls_any(b, names) || edp_calls_any_arms(arms, names),\n    EIf(c, t, e2) => edp_body_calls_any(c, names) || edp_body_calls_any(t, names) || edp_body_calls_any(e2, names),\n    EMatch(s, arms) => edp_body_calls_any(s, names) || edp_calls_any_arms(arms, names),\n    EWhile(c, b) => edp_body_calls_any(c, names) || edp_body_calls_any(b, names),\n    EForIn(_, _, it, b) => edp_body_calls_any(it, names) || edp_body_calls_any(b, names),\n    ELoop(pairs, b) => {\n      let mut i = 0\n      let mut found = false\n      while i < Array::length(pairs) && !found {\n        let (_, v) = Array::get(pairs, i)\n        found = edp_body_calls_any(v, names)\n        i = i + 1\n      }\n      found || edp_body_calls_any(b, names)\n    },\n    ELet(_, v, b, _) => edp_body_calls_any(v, names) || edp_body_calls_any(b, names),\n    ELetMut(_, v, b, _) => edp_body_calls_any(v, names) || edp_body_calls_any(b, names),\n    ELetRec(_, v, b) => edp_body_calls_any(v, names) || edp_body_calls_any(b, names),\n    ESeq(a, b) => edp_body_calls_any(a, names) || edp_body_calls_any(b, names),\n    EAssign(_, v, c) => edp_body_calls_any(v, names) || edp_body_calls_any(c, names),\n    EAssignOp(_, _, v, c) => edp_body_calls_any(v, names) || edp_body_calls_any(c, names),\n    EReturn(e2) => edp_body_calls_any(e2, names),\n    EDot(o, _, _, _) => edp_body_calls_any(o, names),\n    EBinOp(_, l, r) => edp_body_calls_any(l, names) || edp_body_calls_any(r, names),\n    EUnaryOp(_, e2) => edp_body_calls_any(e2, names),\n    ELabeledArg(_, _, v) => edp_body_calls_any(v, names),\n    EBreak(opt) => match opt {\n      Some(e2) => edp_body_calls_any(e2, names),\n      None => false\n    },\n    EContinue(args) => edp_calls_any_exprs(args, names),\n    ETuple(elems) => edp_calls_any_exprs(elems, names),\n    EArray(elems) => edp_calls_any_exprs(elems, names),\n    ERecord(_, fields, _) => edp_calls_any_fields(fields, names),\n    EMap(fields) => edp_calls_any_fields(fields, names),\n    ESpread(e2) => edp_body_calls_any(e2, names),\n    _ => false\n  }\n}\n\nfn edp_calls_any_exprs(es: Array[Expr], names: Array[String]) -> Bool {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(es) && !found {\n    found = edp_body_calls_any(Array::get(es, i), names)\n    i = i + 1\n  }\n  found\n}\n\nfn edp_calls_any_arms(arms: Array[(Pat, Expr)], names: Array[String]) -> Bool {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(arms) && !found {\n    let (_, ex) = Array::get(arms, i)\n    found = edp_body_calls_any(ex, names)\n    i = i + 1\n  }\n  found\n}\n\nfn edp_calls_any_fields(fields: Array[(String, Expr)], names: Array[String]) -> Bool {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(fields) && !found {\n    let (_, v) = Array::get(fields, i)\n    found = edp_body_calls_any(v, names)\n    i = i + 1\n  }\n  found\n}\n\nfn edp_all_fn_names(fn_defs: Array[(Int, Bool, Bool, String, Option[TypeExpr], String)]) -> Array[String] {\n  let out = empty_str_array()\n  let mut i = 0\n  while i < Array::length(fn_defs) {\n    let (_, _, _, nm, _, _) = Array::get(fn_defs, i)\n    if edp_str_array_contains(out, nm) {\n      ()\n    } else {\n      Array::push(out, nm)\n    }\n    i = i + 1\n  }\n  out\n}\n\nfn edp_program_user_performs(stmts: Array[Stmt], ename: String) -> Bool {\n  let mut found = false\n  let mut i = 0\n  while i < Array::length(stmts) && !found {\n    match Array::get(stmts, i) {\n      SLet(_, _, _, _, expr) => {\n        found = edp_performs_user_effect_expr(expr, ename)\n      },\n      SLetMut(_, _, expr) => {\n        found = edp_performs_user_effect_expr(expr, ename)\n      },\n      SExpr(expr) => {\n        found = edp_performs_user_effect_expr(expr, ename)\n      },\n      STest(_, expr) => {\n        found = edp_performs_user_effect_expr(expr, ename)\n      },\n      SBench(_, expr) => {\n        found = edp_performs_user_effect_expr(expr, ename)\n      },\n      _ => ()\n    }\n    i = i + 1\n  }\n  found\n}\n\nfn edp_erase_effect_handles_expr(expr: Expr, ename: String, analyze: Bool, perf_fns: Array[String], inert: Array[String], fn_names: Array[String]) -> Expr {\n  match expr {\n    EHandle(body, arms) => {\n      let body2 = edp_erase_effect_handles_expr(body, ename, analyze, perf_fns, inert, fn_names)\n      if edp_handle_matches_effect(arms, ename) && (!analyze || !edp_body_may_perform(body, ename, perf_fns, inert, fn_names)) {\n        body2\n      } else {\n        EHandle(body2, for a in arms {\n          let (p, ex) = a\n          (p, edp_erase_effect_handles_expr(ex, ename, analyze, perf_fns, inert, fn_names))\n        })\n      }\n    },\n    EFn(tps, tbs, params, ret, eff, body) => EFn(tps, tbs, params, ret, eff, edp_erase_effect_handles_expr(body, ename, analyze, perf_fns, inert, fn_names)),\n    EIf(c, t, e2) => EIf(edp_erase_effect_handles_expr(c, ename, analyze, perf_fns, inert, fn_names), edp_erase_effect_handles_expr(t, ename, analyze, perf_fns, inert, fn_names), edp_erase_effect_handles_expr(e2, ename, analyze, perf_fns, inert, fn_names)),\n    EMatch(s, arms) => EMatch(edp_erase_effect_handles_expr(s, ename, analyze, perf_fns, inert, fn_names), for a in arms {\n      let (p, ex) = a\n      (p, edp_erase_effect_handles_expr(ex, ename, analyze, perf_fns, inert, fn_names))\n    }),\n    EWhile(c, b) => EWhile(edp_erase_effect_handles_expr(c, ename, analyze, perf_fns, inert, fn_names), edp_erase_effect_handles_expr(b, ename, analyze, perf_fns, inert, fn_names)),\n    EForIn(n, idx, it, b) => EForIn(n, idx, edp_erase_effect_handles_expr(it, ename, analyze, perf_fns, inert, fn_names), edp_erase_effect_handles_expr(b, ename, analyze, perf_fns, inert, fn_names)),\n    ELoop(pairs, b) => ELoop(for pr in pairs {\n      let (n, v) = pr\n      (n, edp_erase_effect_handles_expr(v, ename, analyze, perf_fns, inert, fn_names))\n    }, edp_erase_effect_handles_expr(b, ename, analyze, perf_fns, inert, fn_names)),\n    ELet(n, v, b, off) => ELet(n, edp_erase_effect_handles_expr(v, ename, analyze, perf_fns, inert, fn_names), edp_erase_effect_handles_expr(b, ename, analyze, perf_fns, inert, fn_names), off),\n    ELetMut(n, v, b, off) => ELetMut(n, edp_erase_effect_handles_expr(v, ename, analyze, perf_fns, inert, fn_names), edp_erase_effect_handles_expr(b, ename, analyze, perf_fns, inert, fn_names), off),\n    ELetRec(n, v, b) => ELetRec(n, edp_erase_effect_handles_expr(v, ename, analyze, perf_fns, inert, fn_names), edp_erase_effect_handles_expr(b, ename, analyze, perf_fns, inert, fn_names)),\n    ESeq(a, b) => ESeq(edp_erase_effect_handles_expr(a, ename, analyze, perf_fns, inert, fn_names), edp_erase_effect_handles_expr(b, ename, analyze, perf_fns, inert, fn_names)),\n    EAssign(n, v, c) => EAssign(n, edp_erase_effect_handles_expr(v, ename, analyze, perf_fns, inert, fn_names), edp_erase_effect_handles_expr(c, ename, analyze, perf_fns, inert, fn_names)),\n    EAssignOp(n, op, v, c) => EAssignOp(n, op, edp_erase_effect_handles_expr(v, ename, analyze, perf_fns, inert, fn_names), edp_erase_effect_handles_expr(c, ename, analyze, perf_fns, inert, fn_names)),\n    EReturn(e2) => EReturn(edp_erase_effect_handles_expr(e2, ename, analyze, perf_fns, inert, fn_names)),\n    EDot(o, f, off1, off2) => EDot(edp_erase_effect_handles_expr(o, ename, analyze, perf_fns, inert, fn_names), f, off1, off2),\n    ECall(callee, args, off) => ECall(edp_erase_effect_handles_expr(callee, ename, analyze, perf_fns, inert, fn_names), edp_erase_effect_handles_exprs(args, ename, analyze, perf_fns, inert, fn_names), off),\n    EBinOp(op, l, r) => EBinOp(op, edp_erase_effect_handles_expr(l, ename, analyze, perf_fns, inert, fn_names), edp_erase_effect_handles_expr(r, ename, analyze, perf_fns, inert, fn_names)),\n    EUnaryOp(op, e2) => EUnaryOp(op, edp_erase_effect_handles_expr(e2, ename, analyze, perf_fns, inert, fn_names)),\n    ELabeledArg(l, n, v) => ELabeledArg(l, n, edp_erase_effect_handles_expr(v, ename, analyze, perf_fns, inert, fn_names)),\n    EBreak(opt) => EBreak(match opt {\n      Some(e2) => Some(edp_erase_effect_handles_expr(e2, ename, analyze, perf_fns, inert, fn_names)),\n      None => None\n    }),\n    EContinue(args) => EContinue(edp_erase_effect_handles_exprs(args, ename, analyze, perf_fns, inert, fn_names)),\n    ETuple(elems) => ETuple(edp_erase_effect_handles_exprs(elems, ename, analyze, perf_fns, inert, fn_names)),\n    EArray(elems) => EArray(edp_erase_effect_handles_exprs(elems, ename, analyze, perf_fns, inert, fn_names)),\n    ERecord(rn, fields, targs) => ERecord(rn, for f in fields {\n      let (fn2, v) = f\n      (fn2, edp_erase_effect_handles_expr(v, ename, analyze, perf_fns, inert, fn_names))\n    }, targs),\n    EMap(fields) => EMap(for f in fields {\n      let (fn2, v) = f\n      (fn2, edp_erase_effect_handles_expr(v, ename, analyze, perf_fns, inert, fn_names))\n    }),\n    ESpread(e2) => ESpread(edp_erase_effect_handles_expr(e2, ename, analyze, perf_fns, inert, fn_names)),\n    _ => expr\n  }\n}\n\nfn edp_erase_effect_handles_exprs(es: Array[Expr], ename: String, analyze: Bool, perf_fns: Array[String], inert: Array[String], fn_names: Array[String]) -> Array[Expr] {\n  for e in es {\n    edp_erase_effect_handles_expr(e, ename, analyze, perf_fns, inert, fn_names)\n  }\n}\n\nfn edp_erase_effect_handles(stmts: Array[Stmt], ename: String, analyze: Bool, perf_fns: Array[String], inert: Array[String], fn_names: Array[String]) -> Unit {\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SLet(exported, is_rec, name, ty, expr) => Array::set(stmts, i, SLet(exported, is_rec, name, ty, edp_erase_effect_handles_expr(expr, ename, analyze, perf_fns, inert, fn_names))),\n      SLetMut(nm, ty, expr) => Array::set(stmts, i, SLetMut(nm, ty, edp_erase_effect_handles_expr(expr, ename, analyze, perf_fns, inert, fn_names))),\n      SExpr(expr) => Array::set(stmts, i, SExpr(edp_erase_effect_handles_expr(expr, ename, analyze, perf_fns, inert, fn_names))),\n      STest(tn, expr) => Array::set(stmts, i, STest(tn, edp_erase_effect_handles_expr(expr, ename, analyze, perf_fns, inert, fn_names))),\n      SBench(bn, expr) => Array::set(stmts, i, SBench(bn, edp_erase_effect_handles_expr(expr, ename, analyze, perf_fns, inert, fn_names))),\n      _ => ()\n    }\n    i = i + 1\n  }\n}\n\nfn edp_ar_fresh(counter: Array[Int], name: String, taken: Array[String]) -> String {\n  let mut out = \"\"\n  while out == \"\" {\n    let n = Array::get(counter, 0)\n    Array::set(counter, 0, n + 1)\n    let cand = String::concat(String::concat(String::concat(\"__edpsh_\", __to_string(n)), \"_\"), name)\n    if edp_str_array_contains(taken, cand) {\n      ()\n    } else {\n      out = cand\n    }\n  }\n  out\n}\n\nfn edp_collect_prefixed_names(stmts: Array[Stmt], prefix: String, out: Array[String]) -> Unit {\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SLet(_, _, nm, _, expr) => {\n        edp_prefix_push(nm, prefix, out)\n        edp_collect_prefixed_expr(expr, prefix, out)\n      },\n      SLetMut(nm, _, expr) => {\n        edp_prefix_push(nm, prefix, out)\n        edp_collect_prefixed_expr(expr, prefix, out)\n      },\n      SExpr(expr) => edp_collect_prefixed_expr(expr, prefix, out),\n      STest(_, expr) => edp_collect_prefixed_expr(expr, prefix, out),\n      SBench(_, expr) => edp_collect_prefixed_expr(expr, prefix, out),\n      _ => ()\n    }\n    i = i + 1\n  }\n}\n\nfn edp_prefix_push(nm: String, prefix: String, out: Array[String]) -> Unit {\n  if String::starts_with(nm, prefix) && !edp_str_array_contains(out, nm) {\n    Array::push(out, nm)\n  } else {\n    ()\n  }\n}\n\nfn edp_collect_prefixed_pat(p: Pat, prefix: String, out: Array[String]) -> Unit {\n  let names = array_empty()\n  edp_pat_binds(p, names)\n  let mut i = 0\n  while i < Array::length(names) {\n    edp_prefix_push(Array::get(names, i), prefix, out)\n    i = i + 1\n  }\n}\n\nfn edp_collect_prefixed_exprs(es: Array[Expr], prefix: String, out: Array[String]) -> Unit {\n  let mut i = 0\n  while i < Array::length(es) {\n    edp_collect_prefixed_expr(Array::get(es, i), prefix, out)\n    i = i + 1\n  }\n}\n\nfn edp_collect_prefixed_expr(expr: Expr, prefix: String, out: Array[String]) -> Unit {\n  match expr {\n    EIdent(nm, _) => edp_prefix_push(nm, prefix, out),\n    EFn(_, _, params, _, _, body) => {\n      let mut i = 0\n      while i < Array::length(params) {\n        let (pn, _) = Array::get(params, i)\n        edp_prefix_push(edp_strip_tilde(pn), prefix, out)\n        i = i + 1\n      }\n      edp_collect_prefixed_expr(body, prefix, out)\n    },\n    EHandle(b, arms) => {\n      edp_collect_prefixed_expr(b, prefix, out)\n      let mut i = 0\n      while i < Array::length(arms) {\n        let (p, ex) = Array::get(arms, i)\n        edp_collect_prefixed_pat(p, prefix, out)\n        edp_collect_prefixed_expr(ex, prefix, out)\n        i = i + 1\n      }\n    },\n    EMatch(s, arms) => {\n      edp_collect_prefixed_expr(s, prefix, out)\n      let mut i = 0\n      while i < Array::length(arms) {\n        let (p, ex) = Array::get(arms, i)\n        edp_collect_prefixed_pat(p, prefix, out)\n        edp_collect_prefixed_expr(ex, prefix, out)\n        i = i + 1\n      }\n    },\n    EIf(c, t, e2) => {\n      edp_collect_prefixed_expr(c, prefix, out)\n      edp_collect_prefixed_expr(t, prefix, out)\n      edp_collect_prefixed_expr(e2, prefix, out)\n    },\n    EWhile(c, b) => {\n      edp_collect_prefixed_expr(c, prefix, out)\n      edp_collect_prefixed_expr(b, prefix, out)\n    },\n    EForIn(n, idx, it, b) => {\n      edp_prefix_push(n, prefix, out)\n      match idx {\n        Some(iname) => edp_prefix_push(iname, prefix, out),\n        None => ()\n      }\n      edp_collect_prefixed_expr(it, prefix, out)\n      edp_collect_prefixed_expr(b, prefix, out)\n    },\n    ELoop(pairs, b) => {\n      let mut i = 0\n      while i < Array::length(pairs) {\n        let (pn, v) = Array::get(pairs, i)\n        edp_prefix_push(pn, prefix, out)\n        edp_collect_prefixed_expr(v, prefix, out)\n        i = i + 1\n      }\n      edp_collect_prefixed_expr(b, prefix, out)\n    },\n    ELet(n, v, b, _) => {\n      edp_prefix_push(n, prefix, out)\n      edp_collect_prefixed_expr(v, prefix, out)\n      edp_collect_prefixed_expr(b, prefix, out)\n    },\n    ELetMut(n, v, b, _) => {\n      edp_prefix_push(n, prefix, out)\n      edp_collect_prefixed_expr(v, prefix, out)\n      edp_collect_prefixed_expr(b, prefix, out)\n    },\n    ELetRec(n, v, b) => {\n      edp_prefix_push(n, prefix, out)\n      edp_collect_prefixed_expr(v, prefix, out)\n      edp_collect_prefixed_expr(b, prefix, out)\n    },\n    ESeq(a, b) => {\n      edp_collect_prefixed_expr(a, prefix, out)\n      edp_collect_prefixed_expr(b, prefix, out)\n    },\n    EAssign(n, v, c) => {\n      edp_prefix_push(n, prefix, out)\n      edp_collect_prefixed_expr(v, prefix, out)\n      edp_collect_prefixed_expr(c, prefix, out)\n    },\n    EAssignOp(n, _, v, c) => {\n      edp_prefix_push(n, prefix, out)\n      edp_collect_prefixed_expr(v, prefix, out)\n      edp_collect_prefixed_expr(c, prefix, out)\n    },\n    EReturn(e2) => edp_collect_prefixed_expr(e2, prefix, out),\n    EDot(o, _, _, _) => edp_collect_prefixed_expr(o, prefix, out),\n    ECall(callee, args, _) => {\n      edp_collect_prefixed_expr(callee, prefix, out)\n      edp_collect_prefixed_exprs(args, prefix, out)\n    },\n    EBinOp(_, l, r) => {\n      edp_collect_prefixed_expr(l, prefix, out)\n      edp_collect_prefixed_expr(r, prefix, out)\n    },\n    EUnaryOp(_, e2) => edp_collect_prefixed_expr(e2, prefix, out),\n    ELabeledArg(_, _, v) => edp_collect_prefixed_expr(v, prefix, out),\n    EBreak(opt) => match opt {\n      Some(e2) => edp_collect_prefixed_expr(e2, prefix, out),\n      None => ()\n    },\n    EContinue(args) => edp_collect_prefixed_exprs(args, prefix, out),\n    ETuple(elems) => edp_collect_prefixed_exprs(elems, prefix, out),\n    EArray(elems) => edp_collect_prefixed_exprs(elems, prefix, out),\n    ERecord(_, fields, _) => {\n      let mut i = 0\n      while i < Array::length(fields) {\n        let (_, v) = Array::get(fields, i)\n        edp_collect_prefixed_expr(v, prefix, out)\n        i = i + 1\n      }\n    },\n    EMap(fields) => {\n      let mut i = 0\n      while i < Array::length(fields) {\n        let (_, v) = Array::get(fields, i)\n        edp_collect_prefixed_expr(v, prefix, out)\n        i = i + 1\n      }\n    },\n    ESpread(e2) => edp_collect_prefixed_expr(e2, prefix, out),\n    _ => ()\n  }\n}\n\nfn edp_ar_lookup(env_names: Array[String], env_repl: Array[String], name: String) -> String {\n  let mut i = Array::length(env_names) - 1\n  let mut out = name\n  let mut found = false\n  while i >= 0 && !found {\n    if Array::get(env_names, i) == name {\n      out = Array::get(env_repl, i)\n      found = true\n    } else {\n      ()\n    }\n    i = i - 1\n  }\n  out\n}\n\nfn edp_ar_bind(name: String, seed: Array[String], env_names: Array[String], env_repl: Array[String], counter: Array[Int], taken: Array[String]) -> String {\n  if edp_str_array_contains(seed, name) {\n    let fresh = edp_ar_fresh(counter, name, taken)\n    Array::push(env_names, name)\n    Array::push(env_repl, fresh)\n    fresh\n  } else {\n    name\n  }\n}\n\nfn edp_ar_pat_rewrite(p: Pat, env_names: Array[String], env_repl: Array[String]) -> Pat {\n  match p {\n    PBind(n) => PBind(edp_ar_lookup(env_names, env_repl, n)),\n    PCtor(nm, args) => PCtor(nm, for a in args {\n      edp_ar_pat_rewrite(a, env_names, env_repl)\n    }),\n    PTuple(ps) => PTuple(for a in ps {\n      edp_ar_pat_rewrite(a, env_names, env_repl)\n    }),\n    POr(a, b) => POr(edp_ar_pat_rewrite(a, env_names, env_repl), edp_ar_pat_rewrite(b, env_names, env_repl)),\n    PStruct(nm, fields) => PStruct(nm, for f in fields {\n      let (fname, fp) = f\n      (fname, edp_ar_pat_rewrite(fp, env_names, env_repl))\n    }),\n    _ => p\n  }\n}\n\nfn edp_ar_bind_pat(p: Pat, seed: Array[String], env_names: Array[String], env_repl: Array[String], counter: Array[Int], taken: Array[String]) -> Pat {\n  let names = array_empty()\n  edp_pat_binds(p, names)\n  let mut i = 0\n  while i < Array::length(names) {\n    let _ = edp_ar_bind(Array::get(names, i), seed, env_names, env_repl, counter, taken)\n    i = i + 1\n  }\n  edp_ar_pat_rewrite(p, env_names, env_repl)\n}\n\nfn edp_ar_exprs(es: Array[Expr], seed: Array[String], env_names: Array[String], env_repl: Array[String], counter: Array[Int], taken: Array[String]) -> Array[Expr] {\n  for e in es {\n    edp_ar_expr(e, seed, env_names, env_repl, counter, taken)\n  }\n}\n\nfn edp_ar_expr(expr: Expr, seed: Array[String], env_names: Array[String], env_repl: Array[String], counter: Array[Int], taken: Array[String]) -> Expr {\n  match expr {\n    EIdent(n, off) => EIdent(edp_ar_lookup(env_names, env_repl, n), off),\n    EFn(tps, tbs, params, ret, eff, body) => {\n      let base = Array::length(env_names)\n      let params2: Array[(String, Option[TypeExpr])] = [\n      ]\n      let mut i = 0\n      while i < Array::length(params) {\n        let (pn, pty) = Array::get(params, i)\n        Array::push(params2, (edp_ar_bind(pn, seed, env_names, env_repl, counter, taken), pty))\n        i = i + 1\n      }\n      let body2 = edp_ar_expr(body, seed, env_names, env_repl, counter, taken)\n      Array::truncate(env_names, base)\n      Array::truncate(env_repl, base)\n      EFn(tps, tbs, params2, ret, eff, body2)\n    },\n    EHandle(body, arms) => EHandle(edp_ar_expr(body, seed, env_names, env_repl, counter, taken), for a in arms {\n      let (p, ex) = a\n      let base = Array::length(env_names)\n      let p2 = edp_ar_bind_pat(p, seed, env_names, env_repl, counter, taken)\n      let ex2 = edp_ar_expr(ex, seed, env_names, env_repl, counter, taken)\n      Array::truncate(env_names, base)\n      Array::truncate(env_repl, base)\n      (p2, ex2)\n    }),\n    EMatch(s, arms) => EMatch(edp_ar_expr(s, seed, env_names, env_repl, counter, taken), for a in arms {\n      let (p, ex) = a\n      let base = Array::length(env_names)\n      let p2 = edp_ar_bind_pat(p, seed, env_names, env_repl, counter, taken)\n      let ex2 = edp_ar_expr(ex, seed, env_names, env_repl, counter, taken)\n      Array::truncate(env_names, base)\n      Array::truncate(env_repl, base)\n      (p2, ex2)\n    }),\n    EIf(c, t, e2) => EIf(edp_ar_expr(c, seed, env_names, env_repl, counter, taken), edp_ar_expr(t, seed, env_names, env_repl, counter, taken), edp_ar_expr(e2, seed, env_names, env_repl, counter, taken)),\n    EWhile(c, b) => EWhile(edp_ar_expr(c, seed, env_names, env_repl, counter, taken), edp_ar_expr(b, seed, env_names, env_repl, counter, taken)),\n    EForIn(n, idx, it, b) => {\n      let it2 = edp_ar_expr(it, seed, env_names, env_repl, counter, taken)\n      let base = Array::length(env_names)\n      let n2 = edp_ar_bind(n, seed, env_names, env_repl, counter, taken)\n      let idx2 = match idx {\n        Some(iname) => Some(edp_ar_bind(iname, seed, env_names, env_repl, counter, taken)),\n        None => None\n      }\n      let b2 = edp_ar_expr(b, seed, env_names, env_repl, counter, taken)\n      Array::truncate(env_names, base)\n      Array::truncate(env_repl, base)\n      EForIn(n2, idx2, it2, b2)\n    },\n    ELoop(pairs, b) => {\n      let inits2: Array[Expr] = [\n      ]\n      let mut i = 0\n      while i < Array::length(pairs) {\n        let (_, v) = Array::get(pairs, i)\n        Array::push(inits2, edp_ar_expr(v, seed, env_names, env_repl, counter, taken))\n        i = i + 1\n      }\n      let base = Array::length(env_names)\n      let pairs2: Array[(String, Expr)] = [\n      ]\n      let mut j = 0\n      while j < Array::length(pairs) {\n        let (pn, _) = Array::get(pairs, j)\n        Array::push(pairs2, (edp_ar_bind(pn, seed, env_names, env_repl, counter, taken), Array::get(inits2, j)))\n        j = j + 1\n      }\n      let b2 = edp_ar_expr(b, seed, env_names, env_repl, counter, taken)\n      Array::truncate(env_names, base)\n      Array::truncate(env_repl, base)\n      ELoop(pairs2, b2)\n    },\n    ELet(n, v, b, off) => {\n      let v2 = edp_ar_expr(v, seed, env_names, env_repl, counter, taken)\n      let base = Array::length(env_names)\n      let n2 = edp_ar_bind(n, seed, env_names, env_repl, counter, taken)\n      let b2 = edp_ar_expr(b, seed, env_names, env_repl, counter, taken)\n      Array::truncate(env_names, base)\n      Array::truncate(env_repl, base)\n      ELet(n2, v2, b2, off)\n    },\n    ELetMut(n, v, b, off) => {\n      let v2 = edp_ar_expr(v, seed, env_names, env_repl, counter, taken)\n      let base = Array::length(env_names)\n      let n2 = edp_ar_bind(n, seed, env_names, env_repl, counter, taken)\n      let b2 = edp_ar_expr(b, seed, env_names, env_repl, counter, taken)\n      Array::truncate(env_names, base)\n      Array::truncate(env_repl, base)\n      ELetMut(n2, v2, b2, off)\n    },\n    ELetRec(n, v, b) => {\n      let base = Array::length(env_names)\n      let n2 = edp_ar_bind(n, seed, env_names, env_repl, counter, taken)\n      let v2 = edp_ar_expr(v, seed, env_names, env_repl, counter, taken)\n      let b2 = edp_ar_expr(b, seed, env_names, env_repl, counter, taken)\n      Array::truncate(env_names, base)\n      Array::truncate(env_repl, base)\n      ELetRec(n2, v2, b2)\n    },\n    ESeq(a, b) => ESeq(edp_ar_expr(a, seed, env_names, env_repl, counter, taken), edp_ar_expr(b, seed, env_names, env_repl, counter, taken)),\n    EAssign(n, v, c) => EAssign(edp_ar_lookup(env_names, env_repl, n), edp_ar_expr(v, seed, env_names, env_repl, counter, taken), edp_ar_expr(c, seed, env_names, env_repl, counter, taken)),\n    EAssignOp(n, op, v, c) => EAssignOp(edp_ar_lookup(env_names, env_repl, n), op, edp_ar_expr(v, seed, env_names, env_repl, counter, taken), edp_ar_expr(c, seed, env_names, env_repl, counter, taken)),\n    EReturn(e2) => EReturn(edp_ar_expr(e2, seed, env_names, env_repl, counter, taken)),\n    EDot(o, f, off1, off2) => EDot(edp_ar_expr(o, seed, env_names, env_repl, counter, taken), f, off1, off2),\n    ECall(callee, args, off) => ECall(edp_ar_expr(callee, seed, env_names, env_repl, counter, taken), edp_ar_exprs(args, seed, env_names, env_repl, counter, taken), off),\n    EBinOp(op, l, r) => EBinOp(op, edp_ar_expr(l, seed, env_names, env_repl, counter, taken), edp_ar_expr(r, seed, env_names, env_repl, counter, taken)),\n    EUnaryOp(op, e2) => EUnaryOp(op, edp_ar_expr(e2, seed, env_names, env_repl, counter, taken)),\n    ELabeledArg(l, n, v) => ELabeledArg(l, n, edp_ar_expr(v, seed, env_names, env_repl, counter, taken)),\n    EBreak(opt) => EBreak(match opt {\n      Some(e2) => Some(edp_ar_expr(e2, seed, env_names, env_repl, counter, taken)),\n      None => None\n    }),\n    EContinue(args) => EContinue(edp_ar_exprs(args, seed, env_names, env_repl, counter, taken)),\n    ETuple(elems) => ETuple(edp_ar_exprs(elems, seed, env_names, env_repl, counter, taken)),\n    EArray(elems) => EArray(edp_ar_exprs(elems, seed, env_names, env_repl, counter, taken)),\n    ERecord(rn, fields, targs) => ERecord(rn, for f in fields {\n      let (fn2, v) = f\n      (fn2, edp_ar_expr(v, seed, env_names, env_repl, counter, taken))\n    }, targs),\n    EMap(fields) => EMap(for f in fields {\n      let (fn2, v) = f\n      (fn2, edp_ar_expr(v, seed, env_names, env_repl, counter, taken))\n    }),\n    ESpread(e2) => ESpread(edp_ar_expr(e2, seed, env_names, env_repl, counter, taken)),\n    _ => expr\n  }\n}\n\nfn edp_alpha_rename_shadowed(stmts: Array[Stmt], effect_defs: Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], fn_defs: Array[(Int, Bool, Bool, String, Option[TypeExpr], String)]) -> Unit {\n  let es_names = array_empty()\n  let es_members_list = array_empty()\n  edp_es_collect_into(stmts, es_names, es_members_list)\n  let seed = empty_str_array()\n  let mut ei = 0\n  while ei < Array::length(effect_defs) {\n    let (ename, _) = Array::get(effect_defs, ei)\n    let needing = edp_needing_names(fn_defs, ename, es_names, es_members_list)\n    let mut ni = 0\n    while ni < Array::length(needing) {\n      let nm = Array::get(needing, ni)\n      if edp_str_array_contains(seed, nm) {\n        ()\n      } else {\n        let mut shadowed = false\n        let mut si = 0\n        while si < Array::length(stmts) && !shadowed {\n          let sv_opt = match Array::get(stmts, si) {\n            SLet(_, _, _, _, sv) => Some(sv),\n            SLetMut(_, _, sv) => Some(sv),\n            SExpr(sv) => Some(sv),\n            STest(_, sv) => Some(sv),\n            SBench(_, sv) => Some(sv),\n            _ => None\n          }\n          match sv_opt {\n            Some(sv) => if edp_expr_binds_name(sv, nm) {\n              shadowed = true\n            } else {\n              ()\n            },\n            None => ()\n          }\n          si = si + 1\n        }\n        if shadowed {\n          Array::push(seed, nm)\n        } else {\n          ()\n        }\n      }\n      ni = ni + 1\n    }\n    ei = ei + 1\n  }\n  if Array::length(seed) == 0 {\n    ()\n  } else {\n    let counter = [\n      0\n    ]\n    let taken = empty_str_array()\n    edp_collect_prefixed_names(stmts, \"__edpsh_\", taken)\n    let mut i = 0\n    while i < Array::length(stmts) {\n      let expr_opt = match Array::get(stmts, i) {\n        SLet(_, _, _, _, expr) => Some(expr),\n        SLetMut(_, _, expr) => Some(expr),\n        SExpr(expr) => Some(expr),\n        STest(_, expr) => Some(expr),\n        SBench(_, expr) => Some(expr),\n        _ => None\n      }\n      match expr_opt {\n        Some(expr) => {\n          let mut hits = false\n          let mut sj = 0\n          while sj < Array::length(seed) && !hits {\n            hits = edp_expr_binds_name(expr, Array::get(seed, sj))\n            sj = sj + 1\n          }\n          if hits {\n            let env_names = empty_str_array()\n            let env_repl = empty_str_array()\n            let new_expr = edp_ar_expr(expr, seed, env_names, env_repl, counter, taken)\n            match Array::get(stmts, i) {\n              SLet(exported, is_rec, name, ty, _) => Array::set(stmts, i, SLet(exported, is_rec, name, ty, new_expr)),\n              SLetMut(nm2, ty2, _) => Array::set(stmts, i, SLetMut(nm2, ty2, new_expr)),\n              SExpr(_) => Array::set(stmts, i, SExpr(new_expr)),\n              STest(tn2, _) => Array::set(stmts, i, STest(tn2, new_expr)),\n              SBench(bn2, _) => Array::set(stmts, i, SBench(bn2, new_expr)),\n              _ => ()\n            }\n          } else {\n            ()\n          }\n        },\n        None => ()\n      }\n      i = i + 1\n    }\n  }\n}\n\nfn edp_first_live_replay_handle(stmts: Array[Stmt], keep: Array[Bool]) -> String {\n  let mut i = 0\n  let mut found = \"\"\n  while i < Array::length(stmts) && found == \"\" {\n    match Array::get(stmts, i) {\n      SLet(_, _, _, _, expr) => {\n        let dead_fn = match expr {\n          EFn(_, _, _, _, _, _) => if i < Array::length(keep) {\n            !Array::get(keep, i)\n          } else {\n            false\n          },\n          _ => false\n        }\n        if dead_fn {\n          ()\n        } else {\n          found = edp_nonerror_handle_desc_expr(expr)\n        }\n      },\n      SLetMut(_, _, expr) => {\n        found = edp_nonerror_handle_desc_expr(expr)\n      },\n      SExpr(expr) => {\n        found = edp_nonerror_handle_desc_expr(expr)\n      },\n      STest(_, expr) => {\n        found = edp_nonerror_handle_desc_expr(expr)\n      },\n      SBench(_, expr) => {\n        found = edp_nonerror_handle_desc_expr(expr)\n      },\n      _ => ()\n    }\n    i = i + 1\n  }\n  found\n}\n\nfn edp_nonerror_handle_desc_expr(expr: Expr) -> String {\n  match expr {\n    EHandle(body, arms) => {\n      let mut own = \"\"\n      if Array::length(arms) > 0 {\n        let (p, _) = Array::get(arms, 0)\n        match p {\n          PCtor(qname, _) => if is_exception_throw_operation(qname) {\n            ()\n          } else {\n            own = edp_effect_name_of(qname)\n          },\n          PWild => {\n            own = \"<catch-all>\"\n          },\n          PBind(_) => {\n            own = \"<catch-all>\"\n          },\n          _ => ()\n        }\n      } else {\n        ()\n      }\n      if own == \"\" {\n        let inner = edp_nonerror_handle_desc_expr(body)\n        if inner == \"\" {\n          edp_nonerror_handle_desc_arms(arms)\n        } else {\n          inner\n        }\n      } else {\n        own\n      }\n    },\n    EFn(_, _, _, _, _, b) => edp_nonerror_handle_desc_expr(b),\n    EIf(c, t, e2) => {\n      let a = edp_nonerror_handle_desc_expr(c)\n      if a == \"\" {\n        let b = edp_nonerror_handle_desc_expr(t)\n        if b == \"\" {\n          edp_nonerror_handle_desc_expr(e2)\n        } else {\n          b\n        }\n      } else {\n        a\n      }\n    },\n    EMatch(s, arms) => {\n      let a = edp_nonerror_handle_desc_expr(s)\n      if a == \"\" {\n        edp_nonerror_handle_desc_arms(arms)\n      } else {\n        a\n      }\n    },\n    EWhile(c, b) => {\n      let a = edp_nonerror_handle_desc_expr(c)\n      if a == \"\" {\n        edp_nonerror_handle_desc_expr(b)\n      } else {\n        a\n      }\n    },\n    EForIn(_, _, it, b) => {\n      let a = edp_nonerror_handle_desc_expr(it)\n      if a == \"\" {\n        edp_nonerror_handle_desc_expr(b)\n      } else {\n        a\n      }\n    },\n    ELoop(pairs, b) => {\n      let mut out = \"\"\n      let mut i = 0\n      while i < Array::length(pairs) && out == \"\" {\n        let (_, v) = Array::get(pairs, i)\n        out = edp_nonerror_handle_desc_expr(v)\n        i = i + 1\n      }\n      if out == \"\" {\n        edp_nonerror_handle_desc_expr(b)\n      } else {\n        out\n      }\n    },\n    ELet(_, v, b, _) => {\n      let a = edp_nonerror_handle_desc_expr(v)\n      if a == \"\" {\n        edp_nonerror_handle_desc_expr(b)\n      } else {\n        a\n      }\n    },\n    ELetMut(_, v, b, _) => {\n      let a = edp_nonerror_handle_desc_expr(v)\n      if a == \"\" {\n        edp_nonerror_handle_desc_expr(b)\n      } else {\n        a\n      }\n    },\n    ELetRec(_, v, b) => {\n      let a = edp_nonerror_handle_desc_expr(v)\n      if a == \"\" {\n        edp_nonerror_handle_desc_expr(b)\n      } else {\n        a\n      }\n    },\n    ESeq(a, b) => {\n      let x = edp_nonerror_handle_desc_expr(a)\n      if x == \"\" {\n        edp_nonerror_handle_desc_expr(b)\n      } else {\n        x\n      }\n    },\n    EAssign(_, v, c) => {\n      let a = edp_nonerror_handle_desc_expr(v)\n      if a == \"\" {\n        edp_nonerror_handle_desc_expr(c)\n      } else {\n        a\n      }\n    },\n    EAssignOp(_, _, v, c) => {\n      let a = edp_nonerror_handle_desc_expr(v)\n      if a == \"\" {\n        edp_nonerror_handle_desc_expr(c)\n      } else {\n        a\n      }\n    },\n    EReturn(e2) => edp_nonerror_handle_desc_expr(e2),\n    EDot(o, _, _, _) => edp_nonerror_handle_desc_expr(o),\n    ECall(callee, args, _) => {\n      let a = edp_nonerror_handle_desc_expr(callee)\n      if a == \"\" {\n        edp_nonerror_handle_desc_exprs(args)\n      } else {\n        a\n      }\n    },\n    EBinOp(_, l, r) => {\n      let a = edp_nonerror_handle_desc_expr(l)\n      if a == \"\" {\n        edp_nonerror_handle_desc_expr(r)\n      } else {\n        a\n      }\n    },\n    EUnaryOp(_, e2) => edp_nonerror_handle_desc_expr(e2),\n    ELabeledArg(_, _, v) => edp_nonerror_handle_desc_expr(v),\n    EBreak(opt) => match opt {\n      Some(e2) => edp_nonerror_handle_desc_expr(e2),\n      None => \"\"\n    },\n    EContinue(args) => edp_nonerror_handle_desc_exprs(args),\n    ETuple(elems) => edp_nonerror_handle_desc_exprs(elems),\n    EArray(elems) => edp_nonerror_handle_desc_exprs(elems),\n    ERecord(_, fields, _) => {\n      let mut out = \"\"\n      let mut i = 0\n      while i < Array::length(fields) && out == \"\" {\n        let (_, v) = Array::get(fields, i)\n        out = edp_nonerror_handle_desc_expr(v)\n        i = i + 1\n      }\n      out\n    },\n    EMap(fields) => {\n      let mut out = \"\"\n      let mut i = 0\n      while i < Array::length(fields) && out == \"\" {\n        let (_, v) = Array::get(fields, i)\n        out = edp_nonerror_handle_desc_expr(v)\n        i = i + 1\n      }\n      out\n    },\n    ESpread(e2) => edp_nonerror_handle_desc_expr(e2),\n    _ => \"\"\n  }\n}\n\nfn edp_nonerror_handle_desc_exprs(es: Array[Expr]) -> String {\n  let mut out = \"\"\n  let mut i = 0\n  while i < Array::length(es) && out == \"\" {\n    out = edp_nonerror_handle_desc_expr(Array::get(es, i))\n    i = i + 1\n  }\n  out\n}\n\nfn edp_nonerror_handle_desc_arms(arms: Array[(Pat, Expr)]) -> String {\n  let mut out = \"\"\n  let mut i = 0\n  while i < Array::length(arms) && out == \"\" {\n    let (_, ex) = Array::get(arms, i)\n    out = edp_nonerror_handle_desc_expr(ex)\n    i = i + 1\n  }\n  out\n}\n\nfn edp_drop_unreachable_needing(needing: Array[String], fn_defs: Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], keep: Array[Bool]) -> Array[String] {\n  let out = array_empty()\n  let mut ni = 0\n  while ni < Array::length(needing) {\n    let nm = Array::get(needing, ni)\n    if edp_needing_name_reachable(nm, fn_defs, keep) {\n      Array::push(out, nm)\n    } else {\n      ()\n    }\n    ni = ni + 1\n  }\n  out\n}\n\nfn edp_strip_tilde(n: String) -> String {\n  let ln = String::length(n)\n  if ln > 0 && n[ln - 1: ln] == \"~\" {\n    n[0: ln - 1]\n  } else {\n    n\n  }\n}\n\nfn edp_pat_binds(p: Pat, out: Array[String]) -> Unit {\n  match p {\n    PBind(n) => Array::push(out, n),\n    PCtor(_, args) => {\n      let mut i = 0\n      while i < Array::length(args) {\n        edp_pat_binds(Array::get(args, i), out)\n        i = i + 1\n      }\n    },\n    PTuple(ps) => {\n      let mut i = 0\n      while i < Array::length(ps) {\n        edp_pat_binds(Array::get(ps, i), out)\n        i = i + 1\n      }\n    },\n    POr(a, b) => {\n      edp_pat_binds(a, out)\n      edp_pat_binds(b, out)\n    },\n    PStruct(_, fields) => {\n      let mut i = 0\n      while i < Array::length(fields) {\n        let (_, fp) = Array::get(fields, i)\n        edp_pat_binds(fp, out)\n        i = i + 1\n      }\n    },\n    _ => ()\n  }\n}\n\nfn edp_expr_binds_name(expr: Expr, name: String) -> Bool {\n  match expr {\n    EFn(_, _, params, _, _, body) => {\n      let mut i = 0\n      let mut found = false\n      while i < Array::length(params) && !found {\n        let (pn, _) = Array::get(params, i)\n        if edp_strip_tilde(pn) == name {\n          found = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      found || edp_expr_binds_name(body, name)\n    },\n    EHandle(body, arms) => {\n      let mut i = 0\n      let mut found = edp_expr_binds_name(body, name)\n      while i < Array::length(arms) && !found {\n        let (p, ex) = Array::get(arms, i)\n        let bound = array_empty()\n        edp_pat_binds(p, bound)\n        if edp_str_array_contains(bound, name) || edp_expr_binds_name(ex, name) {\n          found = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      found\n    },\n    EIf(c, t, e2) => edp_expr_binds_name(c, name) || edp_expr_binds_name(t, name) || edp_expr_binds_name(e2, name),\n    EMatch(s, arms) => {\n      let mut i = 0\n      let mut found = edp_expr_binds_name(s, name)\n      while i < Array::length(arms) && !found {\n        let (p, ex) = Array::get(arms, i)\n        let bound = array_empty()\n        edp_pat_binds(p, bound)\n        if edp_str_array_contains(bound, name) || edp_expr_binds_name(ex, name) {\n          found = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      found\n    },\n    EWhile(c, b) => edp_expr_binds_name(c, name) || edp_expr_binds_name(b, name),\n    EForIn(n, idx, it, b) => {\n      let idx_hit = match idx {\n        Some(i2) => i2 == name,\n        None => false\n      }\n      n == name || idx_hit || edp_expr_binds_name(it, name) || edp_expr_binds_name(b, name)\n    },\n    ELoop(pairs, b) => {\n      let mut i = 0\n      let mut found = false\n      while i < Array::length(pairs) && !found {\n        let (n, v) = Array::get(pairs, i)\n        if n == name || edp_expr_binds_name(v, name) {\n          found = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      found || edp_expr_binds_name(b, name)\n    },\n    ELet(n, v, b, _) => n == name || edp_expr_binds_name(v, name) || edp_expr_binds_name(b, name),\n    ELetMut(n, v, b, _) => n == name || edp_expr_binds_name(v, name) || edp_expr_binds_name(b, name),\n    ELetRec(n, v, b) => n == name || edp_expr_binds_name(v, name) || edp_expr_binds_name(b, name),\n    ESeq(a, b) => edp_expr_binds_name(a, name) || edp_expr_binds_name(b, name),\n    EAssign(_, v, c) => edp_expr_binds_name(v, name) || edp_expr_binds_name(c, name),\n    EAssignOp(_, _, v, c) => edp_expr_binds_name(v, name) || edp_expr_binds_name(c, name),\n    EReturn(e2) => edp_expr_binds_name(e2, name),\n    EDot(o, _, _, _) => edp_expr_binds_name(o, name),\n    ECall(callee, args, _) => edp_expr_binds_name(callee, name) || edp_exprs_bind_name(args, name),\n    EBinOp(_, l, r) => edp_expr_binds_name(l, name) || edp_expr_binds_name(r, name),\n    EUnaryOp(_, e2) => edp_expr_binds_name(e2, name),\n    ELabeledArg(_, _, v) => edp_expr_binds_name(v, name),\n    EBreak(opt) => match opt {\n      Some(e2) => edp_expr_binds_name(e2, name),\n      None => false\n    },\n    EContinue(args) => edp_exprs_bind_name(args, name),\n    ETuple(elems) => edp_exprs_bind_name(elems, name),\n    EArray(elems) => edp_exprs_bind_name(elems, name),\n    ERecord(_, fields, _) => {\n      let mut i = 0\n      let mut found = false\n      while i < Array::length(fields) && !found {\n        let (_, v) = Array::get(fields, i)\n        if edp_expr_binds_name(v, name) {\n          found = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      found\n    },\n    EMap(fields) => {\n      let mut i = 0\n      let mut found = false\n      while i < Array::length(fields) && !found {\n        let (_, v) = Array::get(fields, i)\n        if edp_expr_binds_name(v, name) {\n          found = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      found\n    },\n    ESpread(e2) => edp_expr_binds_name(e2, name),\n    _ => false\n  }\n}\n\nfn edp_exprs_bind_name(es: Array[Expr], name: String) -> Bool {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(es) && !found {\n    if edp_expr_binds_name(Array::get(es, i), name) {\n      found = true\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  found\n}\n\nfn edp_drop_shadowed_needing(needing: Array[String], stmts: Array[Stmt]) -> Array[String] {\n  let out = array_empty()\n  let mut ni = 0\n  while ni < Array::length(needing) {\n    let nm = Array::get(needing, ni)\n    let mut shadowed = false\n    let mut si = 0\n    while si < Array::length(stmts) && !shadowed {\n      let sv_opt = match Array::get(stmts, si) {\n        SLet(_, _, _, _, sv) => Some(sv),\n        SLetMut(_, _, sv) => Some(sv),\n        SExpr(sv) => Some(sv),\n        STest(_, sv) => Some(sv),\n        SBench(_, sv) => Some(sv),\n        _ => None\n      }\n      match sv_opt {\n        Some(sv) => if edp_expr_binds_name(sv, nm) {\n          shadowed = true\n        } else {\n          ()\n        },\n        None => ()\n      }\n      si = si + 1\n    }\n    if shadowed {\n      ()\n    } else {\n      Array::push(out, nm)\n    }\n    ni = ni + 1\n  }\n  out\n}\n\nfn edp_drop_self_discharging_needing(needing: Array[String], stmts: Array[Stmt], fn_defs: Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], ename: String) -> Array[String] {\n  let out = array_empty()\n  let mut ni = 0\n  while ni < Array::length(needing) {\n    let nm = Array::get(needing, ni)\n    let drop = match edp_find_fn_body(stmts, fn_defs, nm) {\n      Some(body) => edp_body_is_bare_self_discharge(body, ename),\n      None => false\n    }\n    if drop {\n      ()\n    } else {\n      Array::push(out, nm)\n    }\n    ni = ni + 1\n  }\n  out\n}\n\nfn edp_body_is_bare_self_discharge(body: Expr, ename: String) -> Bool {\n  match body {\n    EHandle(_, arms) => edp_handle_matches_effect(arms, ename),\n    _ => false\n  }\n}\n\nfn edp_needing_name_reachable(name: String, fn_defs: Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], keep: Array[Bool]) -> Bool {\n  let mut fi = 0\n  let mut result = true\n  let mut found = false\n  while fi < Array::length(fn_defs) {\n    let (idx, _, _, nm, _, _) = Array::get(fn_defs, fi)\n    if nm == name && !found {\n      found = true\n      result = if idx >= 0 && idx < Array::length(keep) {\n        Array::get(keep, idx)\n      } else {\n        true\n      }\n    } else {\n      ()\n    }\n    fi = fi + 1\n  }\n  result\n}\n\nfn edp_plan_migrations(stmts: Array[Stmt], effect_defs: Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], fn_defs: Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], keep: Array[Bool], errs: Array[String]) -> Array[(String, Array[(String, Array[TypeExpr], TypeExpr)], Array[String], Array[(Expr, Array[(Pat, Expr)])])] {\n  let es_names = array_empty()\n  let es_members_list = array_empty()\n  edp_es_collect_into(stmts, es_names, es_members_list)\n  let plans = array_empty()\n  let mut ei = 0\n  while ei < Array::length(effect_defs) {\n    let (ename, ops) = Array::get(effect_defs, ei)\n    let needing_all = edp_needing_names(fn_defs, ename, es_names, es_members_list)\n    let needing_unshadowed = edp_drop_shadowed_needing(needing_all, stmts)\n    let needing_sd = edp_drop_self_discharging_needing(needing_unshadowed, stmts, fn_defs, ename)\n    let pf_inert = edp_pure_fn_names(fn_defs)\n    edp_append_free_host_inert_names(stmts, pf_inert)\n    edp_append_perform_free_row_fns(stmts, fn_defs, ename, pf_inert)\n    let needing_full = array_empty()\n    let mut pfi = 0\n    while pfi < Array::length(needing_sd) {\n      let pf_nm = Array::get(needing_sd, pfi)\n      if edp_str_array_contains(pf_inert, pf_nm) {\n        ()\n      } else {\n        Array::push(needing_full, pf_nm)\n      }\n      pfi = pfi + 1\n    }\n    let live_sites = Array::length(needing_full) > 0 && Array::length(edp_collect_handle_sites(stmts, ename)) > 0\n    if live_sites {\n      edp_etawrap_stmts(stmts, needing_full, ename, fn_defs, es_names, es_members_list)\n    } else {\n      ()\n    }\n    let escaped = if live_sites {\n      edp_needing_escape_stmts(stmts, needing_full, ename, fn_defs, es_names, es_members_list)\n    } else {\n      \"\"\n    }\n    if escaped != \"\" {\n      Array::push(errs, String::concat(String::concat(String::concat(\"function `\", escaped), String::concat(\"` carries effect \", ename)), String::concat(String::concat(\" and is passed as a VALUE into a slot whose type does not carry that row, so evidence-passing (ADR-0076) cannot reach the call through it (#1261) -- annotate the receiving parameter (and any binding it flows through) with `with { \", ename), \" }`, or call the function directly instead of passing it\")))\n    } else {\n      ()\n    }\n    match edp_try_plan_for_effect(stmts, ename, ops, needing_full, fn_defs) {\n      Some(plan) => if escaped == \"\" {\n        Array::push(plans, plan)\n      } else {\n        ()\n      },\n      None => {\n        let needing_live = edp_drop_unreachable_needing(needing_full, fn_defs, keep)\n        let mut planned2 = false\n        if Array::length(needing_live) == Array::length(needing_full) {\n          ()\n        } else {\n          match edp_try_plan_for_effect(stmts, ename, ops, needing_live, fn_defs) {\n            Some(plan2) => {\n              Array::push(plans, plan2)\n              planned2 = true\n            },\n            None => ()\n          }\n        }\n        if !planned2 {\n          let gb = empty_str_array()\n          let gl = array_empty()\n          edp_row_lit_scan(stmts, ename, needing_full, es_names, es_members_list, gb, gl)\n          if Array::length(edp_collect_handle_sites(stmts, ename)) > 0 && (Array::length(gb) > 0 || Array::length(gl) > 0 || edp_any_row_typed_param(stmts, fn_defs, ename, es_names, es_members_list)) {\n            let ho = edp_higher_order_block_owner(effect_defs, ename)\n            if String::length(ho) > 0 {\n              Array::push(errs, edp_higher_order_error_msg(ename, ho))\n            } else {\n              Array::push(errs, String::concat(String::concat(\"effect \", ename), \" has closure values whose row carries it (type-directed evidence, ADR-0076 追記34), but its evidence migration is not fully eligible -- a handle body, a needing function, or a row-carrying closure literal calls something the pass cannot see through; replay fallback is not available for closure-value programs\"))\n            }\n          } else {\n            ()\n          }\n        } else {\n          ()\n        }\n      }\n    }\n    ei = ei + 1\n  }\n  plans\n}\n\nfn edp_try_plan_for_effect(stmts: Array[Stmt], ename: String, ops: Array[(String, Array[TypeExpr], TypeExpr)], needing: Array[String], fn_defs: Array[(Int, Bool, Bool, String, Option[TypeExpr], String)]) -> Option[(String, Array[(String, Array[TypeExpr], TypeExpr)], Array[String], Array[(Expr, Array[(Pat, Expr)])])] {\n  let handle_sites = edp_collect_handle_sites(stmts, ename)\n  let worth = Array::length(needing) > 0 || Array::length(handle_sites) > 0 || edp_any_handle_owner_cp(stmts, ename, needing, fn_defs)\n  if !worth {\n    None\n  } else {\n    if edp_all_sites_eligible(stmts, ename, needing, handle_sites, fn_defs) {\n      Some((ename, ops, needing, handle_sites))\n    } else {\n      None\n    }\n  }\n}\n\nfn edp_any_handle_owner_cp(stmts: Array[Stmt], ename: String, needing: Array[String], fn_defs: Array[(Int, Bool, Bool, String, Option[TypeExpr], String)]) -> Bool {\n  let pure_fns = edp_pure_fn_names(fn_defs)\n  edp_append_free_host_inert_names(stmts, pure_fns)\n  edp_append_perform_free_row_fns(stmts, fn_defs, ename, pure_fns)\n  let es_names = array_empty()\n  let es_members_list = array_empty()\n  edp_es_collect_into(stmts, es_names, es_members_list)\n  let mut si = 0\n  let mut found = false\n  while si < Array::length(stmts) && !found {\n    match Array::get(stmts, si) {\n      SLet(_, _, snm, _, sval) => match sval {\n        EFn(_, _, sparams, _, _, sbody) => if Array::length(edp_handle_owner_cps(stmts, snm, sparams, sbody, ename, needing, pure_fns, es_names, es_members_list)) > 0 {\n          found = true\n        } else {\n          ()\n        },\n        _ => ()\n      },\n      _ => ()\n    }\n    si = si + 1\n  }\n  found\n}\n\nfn edp_es_collect_into(stmts: Array[Stmt], es_names: Array[String], es_members_list: Array[Array[String]]) -> Unit {\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SEffectSet(_, esname, esmembers) => {\n        Array::push(es_names, esname)\n        Array::push(es_members_list, esmembers)\n      },\n      _ => ()\n    }\n    i = i + 1\n  }\n}\n\nfn edp_es_expand_into(es_names: Array[String], es_members_list: Array[Array[String]], name: String, path: Array[String], out: Array[String]) -> Unit {\n  if edp_str_array_contains(path, name) {\n    ()\n  } else {\n    let idx = edp_str_array_index_of(es_names, name)\n    if idx < 0 {\n      if edp_str_array_contains(out, name) {\n        ()\n      } else {\n        Array::push(out, name)\n      }\n    } else {\n      Array::push(path, name)\n      let members = Array::get(es_members_list, idx)\n      let mut mi = 0\n      while mi < Array::length(members) {\n        edp_es_expand_into(es_names, es_members_list, Array::get(members, mi), path, out)\n        mi = mi + 1\n      }\n      Array::truncate(path, Array::length(path) - 1)\n    }\n  }\n}\n\nfn edp_effect_name_of(label: String) -> String {\n  let bidx = String::index_of(label, \"[\")\n  let base = if bidx > 0 {\n    String::substring(label, 0, bidx)\n  } else {\n    label\n  }\n  let idx = String::index_of(base, \"::\")\n  if idx > 0 {\n    String::substring(base, 0, idx)\n  } else {\n    base\n  }\n}\n\nfn edp_resolve_effect_names_into(label: String, es_names: Array[String], es_members_list: Array[Array[String]], out: Array[String]) -> Unit {\n  if edp_str_array_contains(es_names, label) {\n    let leaves = array_empty()\n    edp_es_expand_into(es_names, es_members_list, label, array_empty(), leaves)\n    let mut li = 0\n    while li < Array::length(leaves) {\n      let ename = edp_effect_name_of(Array::get(leaves, li))\n      if edp_str_array_contains(out, ename) {\n        ()\n      } else {\n        Array::push(out, ename)\n      }\n      li = li + 1\n    }\n  } else {\n    let ename = edp_effect_name_of(label)\n    if edp_str_array_contains(out, ename) {\n      ()\n    } else {\n      Array::push(out, ename)\n    }\n  }\n}\n\nfn edp_str_array_index_of(arr: Array[String], v: String) -> Int {\n  let mut i = 0\n  let mut found = -1\n  while i < Array::length(arr) {\n    if Array::get(arr, i) == v {\n      found = i\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  found\n}\n\n\nfn edp_collect_effect_defs(stmts: Array[Stmt]) -> Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])] {\n  let out = array_empty()\n  let seen = empty_str_array()\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SEffectDef(_, name, _, ops) => if edp_str_array_contains(seen, name) {\n        ()\n      } else {\n        Array::push(seen, name)\n        Array::push(out, (name, ops))\n      },\n      _ => ()\n    }\n    i = i + 1\n  }\n  out\n}\n\nfn edp_collect_fn_defs(stmts: Array[Stmt]) -> Array[(Int, Bool, Bool, String, Option[TypeExpr], String)] {\n  let out = array_empty()\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SLet(exported, is_rec, name, ty, expr) => match expr {\n        EFn(_, _, _, _, eff, _) => {\n          let row = match eff {\n            Some(s) => s,\n            None => \"\"\n          }\n          Array::push(out, (i, exported, is_rec, name, ty, row))\n        },\n        _ => ()\n      },\n      _ => ()\n    }\n    i = i + 1\n  }\n  out\n}\n\nfn edp_row_is_exactly(row: String, ename: String, es_names: Array[String], es_members_list: Array[Array[String]]) -> Bool {\n  if row == ename {\n    true\n  } else {\n    let parts = String::split(row, \",\")\n    let mut i = 0\n    let mut found = false\n    while i < Array::length(parts) {\n      let label = String::trim(Array::get(parts, i))\n      let resolved = array_empty()\n      edp_resolve_effect_names_into(label, es_names, es_members_list, resolved)\n      if edp_str_array_contains(resolved, ename) {\n        found = true\n      } else {\n        ()\n      }\n      i = i + 1\n    }\n    found\n  }\n}\n\nfn edp_needing_names(fn_defs: Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], ename: String, es_names: Array[String], es_members_list: Array[Array[String]]) -> Array[String] {\n  let out = array_empty()\n  let mut i = 0\n  while i < Array::length(fn_defs) {\n    let (_, _, _, name, _, row) = Array::get(fn_defs, i)\n    if edp_row_is_exactly(row, ename, es_names, es_members_list) {\n      Array::push(out, name)\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  out\n}\n\nfn edp_str_array_contains(arr: Array[String], v: String) -> Bool {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(arr) {\n    if Array::get(arr, i) == v {\n      found = true\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  found\n}\n\n\nfn edp_dict_struct_name(ename: String) -> String {\n  String::concat(\"__EvDict_\", ename)\n}\n\nfn edp_dict_param_name(ename: String) -> String {\n  String::concat(\"__ev_\", ename)\n}\n\nfn edp_strip_effect_prefix(qname: String, ename: String) -> String {\n  let prefix = String::concat(ename, \"::\")\n  let plen = String::length(prefix)\n  if String::length(qname) > plen && String::substring(qname, 0, plen) == prefix {\n    String::substring(qname, plen, String::length(qname))\n  } else {\n    qname\n  }\n}\n\nfn edp_struct_decl_exists(stmts: Array[Stmt], sname: String) -> Bool {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SStruct(_, n, _, _, _, _) => if n == sname {\n        found = true\n      } else {\n        ()\n      },\n      _ => ()\n    }\n    i = i + 1\n  }\n  found\n}\n\nfn edp_make_dict_struct_stmt(ename: String, ops: Array[(String, Array[TypeExpr], TypeExpr)]) -> Stmt {\n  let fields = array_empty()\n  let mut i = 0\n  while i < Array::length(ops) {\n    let (opname, params, ret) = Array::get(ops, i)\n    Array::push(fields, (opname, TyFn(params, ret, None)))\n    i = i + 1\n  }\n  SStruct(false, edp_dict_struct_name(ename), fields, empty_str_array(), empty_str_array(), empty_str_array())\n}\n\nfn empty_str_array() -> Array[String] {\n  array_empty()\n}\n\nfn edp_has_unsafe_construct(expr: Expr, needing: Array[String], ename: String, pure_fns: Array[String]) -> Bool {\n  edp_has_unsafe_construct_sc(expr, needing, ename, pure_fns, empty_str_array(), edp_empty_bool_array())\n}\n\nfn edp_empty_bool_array() -> Array[Bool] {\n  let out: Array[Bool] = [\n  ]\n  out\n}\n\nfn edp_expr_is_fn_literal(e: Expr) -> Bool {\n  match e {\n    EFn(_, _, _, _, _, _) => true,\n    _ => false\n  }\n}\n\nfn edp_local_safe_lookup(ls_names: Array[String], ls_flags: Array[Bool], name: String) -> Int {\n  let mut i = Array::length(ls_names) - 1\n  let mut out = -1\n  while i >= 0 && out < 0 {\n    if Array::get(ls_names, i) == name {\n      out = if Array::get(ls_flags, i) {\n        1\n      } else {\n        0\n      }\n    } else {\n      ()\n    }\n    i = i - 1\n  }\n  out\n}\n\nfn edp_ls_push_pat(p: Pat, ls_names: Array[String], ls_flags: Array[Bool]) -> Unit {\n  let names = array_empty()\n  edp_pat_binds(p, names)\n  let mut i = 0\n  while i < Array::length(names) {\n    Array::push(ls_names, Array::get(names, i))\n    Array::push(ls_flags, false)\n    i = i + 1\n  }\n}\n\nfn edp_has_unsafe_construct_sc(expr: Expr, needing: Array[String], ename: String, pure_fns: Array[String], ls_names: Array[String], ls_flags: Array[Bool]) -> Bool {\n  match expr {\n    EFn(_, _, params, _, _, body) => {\n      let base = Array::length(ls_names)\n      let mut pi = 0\n      while pi < Array::length(params) {\n        let (pn, _) = Array::get(params, pi)\n        Array::push(ls_names, edp_strip_tilde(pn))\n        Array::push(ls_flags, false)\n        pi = pi + 1\n      }\n      let r = edp_has_unsafe_construct_sc(body, needing, ename, pure_fns, ls_names, ls_flags)\n      Array::truncate(ls_names, base)\n      Array::truncate(ls_flags, base)\n      r\n    },\n    EHandle(body, arms) => if edp_handle_matches_effect(arms, ename) {\n      true\n    } else {\n      edp_has_unsafe_construct_sc(body, needing, ename, pure_fns, ls_names, ls_flags) || edp_arms_have_unsafe_construct(arms, needing, ename, pure_fns, ls_names, ls_flags)\n    },\n    EIf(c, t, e) => edp_has_unsafe_construct_sc(c, needing, ename, pure_fns, ls_names, ls_flags) || edp_has_unsafe_construct_sc(t, needing, ename, pure_fns, ls_names, ls_flags) || edp_has_unsafe_construct_sc(e, needing, ename, pure_fns, ls_names, ls_flags),\n    EMatch(s, arms) => edp_has_unsafe_construct_sc(s, needing, ename, pure_fns, ls_names, ls_flags) || edp_arms_have_unsafe_construct(arms, needing, ename, pure_fns, ls_names, ls_flags),\n    EWhile(c, b) => edp_has_unsafe_construct_sc(c, needing, ename, pure_fns, ls_names, ls_flags) || edp_has_unsafe_construct_sc(b, needing, ename, pure_fns, ls_names, ls_flags),\n    EForIn(n, idx, it, b) => {\n      if edp_has_unsafe_construct_sc(it, needing, ename, pure_fns, ls_names, ls_flags) {\n        true\n      } else {\n        let base = Array::length(ls_names)\n        Array::push(ls_names, n)\n        Array::push(ls_flags, false)\n        match idx {\n          Some(iname) => {\n            Array::push(ls_names, iname)\n            Array::push(ls_flags, false)\n          },\n          None => ()\n        }\n        let r = edp_has_unsafe_construct_sc(b, needing, ename, pure_fns, ls_names, ls_flags)\n        Array::truncate(ls_names, base)\n        Array::truncate(ls_flags, base)\n        r\n      }\n    },\n    ELoop(pairs, b) => {\n      if edp_pairs_have_unsafe_construct(pairs, needing, ename, pure_fns, ls_names, ls_flags) {\n        true\n      } else {\n        let base = Array::length(ls_names)\n        let mut li = 0\n        while li < Array::length(pairs) {\n          let (ln, _) = Array::get(pairs, li)\n          Array::push(ls_names, ln)\n          Array::push(ls_flags, false)\n          li = li + 1\n        }\n        let r = edp_has_unsafe_construct_sc(b, needing, ename, pure_fns, ls_names, ls_flags)\n        Array::truncate(ls_names, base)\n        Array::truncate(ls_flags, base)\n        r\n      }\n    },\n    ELet(n, v, b, _) => {\n      if edp_has_unsafe_construct_sc(v, needing, ename, pure_fns, ls_names, ls_flags) {\n        true\n      } else {\n        let base = Array::length(ls_names)\n        Array::push(ls_names, n)\n        Array::push(ls_flags, edp_expr_is_fn_literal(v))\n        let r = edp_has_unsafe_construct_sc(b, needing, ename, pure_fns, ls_names, ls_flags)\n        Array::truncate(ls_names, base)\n        Array::truncate(ls_flags, base)\n        r\n      }\n    },\n    ELetMut(n, v, b, _) => {\n      if edp_has_unsafe_construct_sc(v, needing, ename, pure_fns, ls_names, ls_flags) {\n        true\n      } else {\n        let base = Array::length(ls_names)\n        Array::push(ls_names, n)\n        Array::push(ls_flags, false)\n        let r = edp_has_unsafe_construct_sc(b, needing, ename, pure_fns, ls_names, ls_flags)\n        Array::truncate(ls_names, base)\n        Array::truncate(ls_flags, base)\n        r\n      }\n    },\n    ELetRec(n, v, b) => {\n      let base = Array::length(ls_names)\n      Array::push(ls_names, n)\n      Array::push(ls_flags, edp_expr_is_fn_literal(v))\n      let r = edp_has_unsafe_construct_sc(v, needing, ename, pure_fns, ls_names, ls_flags) || edp_has_unsafe_construct_sc(b, needing, ename, pure_fns, ls_names, ls_flags)\n      Array::truncate(ls_names, base)\n      Array::truncate(ls_flags, base)\n      r\n    },\n    ESeq(a, b) => edp_has_unsafe_construct_sc(a, needing, ename, pure_fns, ls_names, ls_flags) || edp_has_unsafe_construct_sc(b, needing, ename, pure_fns, ls_names, ls_flags),\n    ECall(callee, args, _) => match callee {\n      EIdent(nm, _) => if nm == \"perform\" && Array::length(args) == 1 {\n        edp_perform_operand_has_unsafe_construct(Array::get(args, 0), needing, ename, pure_fns, ls_names, ls_flags)\n      } else if nm == \"resume\" {\n        edp_exprs_have_unsafe_construct(args, needing, ename, pure_fns, ls_names, ls_flags)\n      } else {\n        let local = edp_local_safe_lookup(ls_names, ls_flags, nm)\n        if local == 1 {\n          edp_exprs_have_unsafe_construct(args, needing, ename, pure_fns, ls_names, ls_flags)\n        } else if local == 0 {\n          true\n        } else if edp_is_pure_builtin_call(nm) {\n          edp_exprs_have_unsafe_construct(args, needing, ename, pure_fns, ls_names, ls_flags)\n        } else if edp_str_array_contains(needing, nm) {\n          edp_exprs_have_unsafe_construct(args, needing, ename, pure_fns, ls_names, ls_flags)\n        } else if edp_str_array_contains(pure_fns, nm) {\n          edp_exprs_have_unsafe_construct(args, needing, ename, pure_fns, ls_names, ls_flags)\n        } else {\n          true\n        }\n      },\n      _ => true\n    },\n    EBinOp(_, l, r) => edp_has_unsafe_construct_sc(l, needing, ename, pure_fns, ls_names, ls_flags) || edp_has_unsafe_construct_sc(r, needing, ename, pure_fns, ls_names, ls_flags),\n    EUnaryOp(_, e2) => edp_has_unsafe_construct_sc(e2, needing, ename, pure_fns, ls_names, ls_flags),\n    EAssign(_, v, c) => edp_has_unsafe_construct_sc(v, needing, ename, pure_fns, ls_names, ls_flags) || edp_has_unsafe_construct_sc(c, needing, ename, pure_fns, ls_names, ls_flags),\n    EAssignOp(_, _, v, c) => edp_has_unsafe_construct_sc(v, needing, ename, pure_fns, ls_names, ls_flags) || edp_has_unsafe_construct_sc(c, needing, ename, pure_fns, ls_names, ls_flags),\n    EDot(o, _, _, _) => edp_has_unsafe_construct_sc(o, needing, ename, pure_fns, ls_names, ls_flags),\n    ELabeledArg(_, _, v) => edp_has_unsafe_construct_sc(v, needing, ename, pure_fns, ls_names, ls_flags),\n    EReturn(e2) => edp_has_unsafe_construct_sc(e2, needing, ename, pure_fns, ls_names, ls_flags),\n    EBreak(opt) => match opt {\n      Some(e2) => edp_has_unsafe_construct_sc(e2, needing, ename, pure_fns, ls_names, ls_flags),\n      None => false\n    },\n    EContinue(args) => edp_exprs_have_unsafe_construct(args, needing, ename, pure_fns, ls_names, ls_flags),\n    ETuple(elems) => edp_exprs_have_unsafe_construct(elems, needing, ename, pure_fns, ls_names, ls_flags),\n    EArray(elems) => edp_exprs_have_unsafe_construct(elems, needing, ename, pure_fns, ls_names, ls_flags),\n    ERecord(_, fields, _) => edp_fields_have_unsafe_construct(fields, needing, ename, pure_fns, ls_names, ls_flags),\n    EMap(fields) => edp_fields_have_unsafe_construct(fields, needing, ename, pure_fns, ls_names, ls_flags),\n    ESpread(e2) => edp_has_unsafe_construct_sc(e2, needing, ename, pure_fns, ls_names, ls_flags),\n    _ => false\n  }\n}\n\nfn edp_pure_builtin_names() -> Array[String] {\n  [\n    \"String::concat\",\n    \"String::equals\",\n    \"String::length\",\n    \"String::substring\",\n    \"string_char_at\",\n    \"String::trim\",\n    \"String::split\",\n    \"String::contains\",\n    \"String::index_of\",\n    \"String::to_lower\",\n    \"String::to_upper\",\n    \"String::ends_with\",\n    \"String::starts_with\",\n    \"String::char_code_at\",\n    \"String::last_index_of\",\n    \"String::from_char_code\",\n    \"String::join\",\n    \"Char::to_int\",\n    \"Char::from_int\",\n    \"Int::to_double\",\n    \"Int::to_float\",\n    \"Int::to_string\",\n    \"Double::to_int\",\n    \"Float::to_int\",\n    \"Double::to_string\",\n    \"Float::to_string\",\n    \"Double::abs\",\n    \"Double::floor\",\n    \"Double::ceil\",\n    \"Double::max\",\n    \"Double::min\",\n    \"Int::parse\",\n    \"Double::parse\",\n    \"__index\",\n    \"Array::get\",\n    \"Map::get\",\n    \"Bytes::get\",\n    \"Array::length\",\n    \"Map::size\",\n    \"Bytes::length\",\n    \"__to_string\",\n    \"not\",\n    \"__generic_add\",\n    \"__generic_rel_diff\",\n    \"str_lex_diff\",\n    \"Array::set\",\n    \"sleep\",\n    \"sleep_blocking\",\n    \"Future::pending\",\n    \"Future::ready\",\n    \"Future::resolve\",\n    \"host_future_get\",\n    \"vibe_hf_get_raw\",\n    \"vibe_hf_wait_raw\",\n    \"host_future_named\",\n    \"host_stream_named\",\n    \"vibe_hs_close_raw\",\n    \"vibe_hs_read_raw\"\n  ]\n}\n\nfn edp_is_pure_builtin_call(nm: String) -> Bool {\n  idp_is_host_future_named_raw(nm) || idp_is_host_stream_named_raw(nm) || edp_str_array_contains(edp_pure_builtin_names(), nm)\n}\n\nfn edp_pure_fn_names(fn_defs: Array[(Int, Bool, Bool, String, Option[TypeExpr], String)]) -> Array[String] {\n  let out = array_empty()\n  let mut i = 0\n  while i < Array::length(fn_defs) {\n    let (_, _, _, name, _, row) = Array::get(fn_defs, i)\n    if row == \"\" {\n      Array::push(out, name)\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  out\n}\n\nfn edp_name_is_host_raw_shape(nm: String) -> Bool {\n  String::starts_with(nm, \"vibe_\") && String::ends_with(nm, \"_raw\")\n}\n\nfn edp_fn_is_perform_free(stmts: Array[Stmt], fn_defs: Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], nm: String, ename: String, base_inert: Array[String]) -> Bool {\n  match edp_find_fn_body(stmts, fn_defs, nm) {\n    Some(body) => !edp_performs_user_effect_expr(body, ename) && !edp_has_unsafe_construct(body, empty_str_array(), ename, base_inert),\n    None => false\n  }\n}\n\nfn edp_append_perform_free_row_fns(stmts: Array[Stmt], fn_defs: Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], ename: String, pure_fns: Array[String]) -> Unit {\n  let es_names = array_empty()\n  let es_members_list = array_empty()\n  edp_es_collect_into(stmts, es_names, es_members_list)\n  let candidates = edp_needing_names(fn_defs, ename, es_names, es_members_list)\n  let mut i = 0\n  while i < Array::length(candidates) {\n    let nm = Array::get(candidates, i)\n    if edp_str_array_contains(pure_fns, nm) {\n      ()\n    } else if edp_fn_is_perform_free(stmts, fn_defs, nm, ename, pure_fns) {\n      Array::push(pure_fns, nm)\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n}\n\nfn edp_append_free_host_inert_names(stmts: Array[Stmt], pure_fns: Array[String]) -> Unit {\n  let top_names = empty_str_array()\n  let mut ti = 0\n  while ti < Array::length(stmts) {\n    match Array::get(stmts, ti) {\n      SLet(_, _, nm, _, _) => Array::push(top_names, nm),\n      SLetMut(nm, _, _) => Array::push(top_names, nm),\n      _ => ()\n    }\n    ti = ti + 1\n  }\n  let found = empty_str_array()\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SLet(_, _, _, _, expr) => edp_collect_host_raw_callees(expr, found),\n      SLetMut(_, _, expr) => edp_collect_host_raw_callees(expr, found),\n      SExpr(expr) => edp_collect_host_raw_callees(expr, found),\n      STest(_, expr) => edp_collect_host_raw_callees(expr, found),\n      SBench(_, expr) => edp_collect_host_raw_callees(expr, found),\n      _ => ()\n    }\n    i = i + 1\n  }\n  let mut fi = 0\n  while fi < Array::length(found) {\n    let nm = Array::get(found, fi)\n    if edp_str_array_contains(top_names, nm) || edp_str_array_contains(pure_fns, nm) {\n      ()\n    } else {\n      Array::push(pure_fns, nm)\n    }\n    fi = fi + 1\n  }\n}\n\nfn edp_collect_host_raw_callees(expr: Expr, out: Array[String]) -> Unit {\n  match expr {\n    ECall(callee, args, _) => {\n      match callee {\n        EIdent(nm, _) => if edp_name_is_host_raw_shape(nm) && !edp_str_array_contains(out, nm) {\n          Array::push(out, nm)\n        } else {\n          ()\n        },\n        _ => edp_collect_host_raw_callees(callee, out)\n      }\n      let mut i = 0\n      while i < Array::length(args) {\n        edp_collect_host_raw_callees(Array::get(args, i), out)\n        i = i + 1\n      }\n    },\n    EFn(_, _, _, _, _, b) => edp_collect_host_raw_callees(b, out),\n    EHandle(b, arms) => {\n      edp_collect_host_raw_callees(b, out)\n      let mut i = 0\n      while i < Array::length(arms) {\n        let (_, ex) = Array::get(arms, i)\n        edp_collect_host_raw_callees(ex, out)\n        i = i + 1\n      }\n    },\n    EIf(c, t, e2) => {\n      edp_collect_host_raw_callees(c, out)\n      edp_collect_host_raw_callees(t, out)\n      edp_collect_host_raw_callees(e2, out)\n    },\n    EMatch(s, arms) => {\n      edp_collect_host_raw_callees(s, out)\n      let mut i = 0\n      while i < Array::length(arms) {\n        let (_, ex) = Array::get(arms, i)\n        edp_collect_host_raw_callees(ex, out)\n        i = i + 1\n      }\n    },\n    EWhile(c, b) => {\n      edp_collect_host_raw_callees(c, out)\n      edp_collect_host_raw_callees(b, out)\n    },\n    EForIn(_, _, it, b) => {\n      edp_collect_host_raw_callees(it, out)\n      edp_collect_host_raw_callees(b, out)\n    },\n    ELoop(pairs, b) => {\n      let mut i = 0\n      while i < Array::length(pairs) {\n        let (_, v) = Array::get(pairs, i)\n        edp_collect_host_raw_callees(v, out)\n        i = i + 1\n      }\n      edp_collect_host_raw_callees(b, out)\n    },\n    ELet(_, v, b, _) => {\n      edp_collect_host_raw_callees(v, out)\n      edp_collect_host_raw_callees(b, out)\n    },\n    ELetMut(_, v, b, _) => {\n      edp_collect_host_raw_callees(v, out)\n      edp_collect_host_raw_callees(b, out)\n    },\n    ELetRec(_, v, b) => {\n      edp_collect_host_raw_callees(v, out)\n      edp_collect_host_raw_callees(b, out)\n    },\n    ESeq(a, b) => {\n      edp_collect_host_raw_callees(a, out)\n      edp_collect_host_raw_callees(b, out)\n    },\n    EAssign(_, v, c) => {\n      edp_collect_host_raw_callees(v, out)\n      edp_collect_host_raw_callees(c, out)\n    },\n    EAssignOp(_, _, v, c) => {\n      edp_collect_host_raw_callees(v, out)\n      edp_collect_host_raw_callees(c, out)\n    },\n    EReturn(e2) => edp_collect_host_raw_callees(e2, out),\n    EDot(o, _, _, _) => edp_collect_host_raw_callees(o, out),\n    EBinOp(_, l, r) => {\n      edp_collect_host_raw_callees(l, out)\n      edp_collect_host_raw_callees(r, out)\n    },\n    EUnaryOp(_, e2) => edp_collect_host_raw_callees(e2, out),\n    ELabeledArg(_, _, v) => edp_collect_host_raw_callees(v, out),\n    EBreak(opt) => match opt {\n      Some(e2) => edp_collect_host_raw_callees(e2, out),\n      None => ()\n    },\n    EContinue(args) => {\n      let mut i = 0\n      while i < Array::length(args) {\n        edp_collect_host_raw_callees(Array::get(args, i), out)\n        i = i + 1\n      }\n    },\n    ETuple(elems) => {\n      let mut i = 0\n      while i < Array::length(elems) {\n        edp_collect_host_raw_callees(Array::get(elems, i), out)\n        i = i + 1\n      }\n    },\n    EArray(elems) => {\n      let mut i = 0\n      while i < Array::length(elems) {\n        edp_collect_host_raw_callees(Array::get(elems, i), out)\n        i = i + 1\n      }\n    },\n    ERecord(_, fields, _) => {\n      let mut i = 0\n      while i < Array::length(fields) {\n        let (_, v) = Array::get(fields, i)\n        edp_collect_host_raw_callees(v, out)\n        i = i + 1\n      }\n    },\n    EMap(fields) => {\n      let mut i = 0\n      while i < Array::length(fields) {\n        let (_, v) = Array::get(fields, i)\n        edp_collect_host_raw_callees(v, out)\n        i = i + 1\n      }\n    },\n    ESpread(e2) => edp_collect_host_raw_callees(e2, out),\n    _ => ()\n  }\n}\n\nfn edp_perform_operand_has_unsafe_construct(operand: Expr, needing: Array[String], ename: String, pure_fns: Array[String], ls_names: Array[String], ls_flags: Array[Bool]) -> Bool {\n  match operand {\n    EIdent(_, _) => false,\n    ECall(op_callee, op_args, _) => match op_callee {\n      EIdent(_, _) => edp_exprs_have_unsafe_construct(op_args, needing, ename, pure_fns, ls_names, ls_flags),\n      _ => true\n    },\n    _ => true\n  }\n}\n\nfn edp_exprs_have_unsafe_construct(exprs: Array[Expr], needing: Array[String], ename: String, pure_fns: Array[String], ls_names: Array[String], ls_flags: Array[Bool]) -> Bool {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(exprs) {\n    if edp_has_unsafe_construct_sc(Array::get(exprs, i), needing, ename, pure_fns, ls_names, ls_flags) {\n      found = true\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  found\n}\n\nfn edp_fields_have_unsafe_construct(fields: Array[(String, Expr)], needing: Array[String], ename: String, pure_fns: Array[String], ls_names: Array[String], ls_flags: Array[Bool]) -> Bool {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(fields) {\n    let (_, v) = Array::get(fields, i)\n    if edp_has_unsafe_construct_sc(v, needing, ename, pure_fns, ls_names, ls_flags) {\n      found = true\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  found\n}\n\nfn edp_pairs_have_unsafe_construct(pairs: Array[(String, Expr)], needing: Array[String], ename: String, pure_fns: Array[String], ls_names: Array[String], ls_flags: Array[Bool]) -> Bool {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(pairs) {\n    let (_, v) = Array::get(pairs, i)\n    if edp_has_unsafe_construct_sc(v, needing, ename, pure_fns, ls_names, ls_flags) {\n      found = true\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  found\n}\n\nfn edp_arms_have_unsafe_construct(arms: Array[(Pat, Expr)], needing: Array[String], ename: String, pure_fns: Array[String], ls_names: Array[String], ls_flags: Array[Bool]) -> Bool {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(arms) {\n    let (p, ex) = Array::get(arms, i)\n    let base = Array::length(ls_names)\n    edp_ls_push_pat(p, ls_names, ls_flags)\n    if edp_has_unsafe_construct_sc(ex, needing, ename, pure_fns, ls_names, ls_flags) {\n      found = true\n    } else {\n      ()\n    }\n    Array::truncate(ls_names, base)\n    Array::truncate(ls_flags, base)\n    i = i + 1\n  }\n  found\n}\n\n\nfn edp_pat_bind_names(pat: Pat) -> Array[String] {\n  match pat {\n    PCtor(_, subpats) => for p in subpats {\n      match p {\n        PBind(n) => n,\n        _ => \"_\"\n      }\n    },\n    _ => empty_str_array()\n  }\n}\n\nfn edp_pat_qname(pat: Pat) -> String {\n  match pat {\n    PCtor(name, _) => name,\n    _ => \"\"\n  }\n}\n\nfn edp_strip_tail_resume(expr: Expr) -> Expr {\n  match expr {\n    EIf(c, t, e) => EIf(c, edp_strip_tail_resume(t), edp_strip_tail_resume(e)),\n    EMatch(s, arms) => EMatch(s, edp_strip_tail_resume_arms(arms)),\n    ELet(n, v, b, off) => ELet(n, v, edp_strip_tail_resume(b), off),\n    ELetMut(n, v, b, off) => ELetMut(n, v, edp_strip_tail_resume(b), off),\n    ELetRec(n, v, b) => ELetRec(n, v, edp_strip_tail_resume(b)),\n    ESeq(a, b) => ESeq(a, edp_strip_tail_resume(b)),\n    EAssign(n, v, c) => EAssign(n, v, edp_strip_tail_resume(c)),\n    EAssignOp(n, op, v, c) => EAssignOp(n, op, v, edp_strip_tail_resume(c)),\n    EReturn(e2) => EReturn(edp_strip_tail_resume(e2)),\n    ECall(callee, args, _) => match callee {\n      EIdent(nm, _) => if nm == \"resume\" && Array::length(args) == 1 {\n        Array::get(args, 0)\n      } else {\n        expr\n      },\n      _ => expr\n    },\n    _ => expr\n  }\n}\n\nfn edp_strip_tail_resume_arms(arms: Array[(Pat, Expr)]) -> Array[(Pat, Expr)] {\n  for a in arms {\n    let (p, ex) = a\n    (p, edp_strip_tail_resume(ex))\n  }\n}\n\n\nfn edp_collect_handle_sites(stmts: Array[Stmt], ename: String) -> Array[(Expr, Array[(Pat, Expr)])] {\n  let out = array_empty()\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SLet(_, _, _, _, expr) => edp_collect_handle_sites_expr(expr, ename, out),\n      SLetMut(_, _, expr) => edp_collect_handle_sites_expr(expr, ename, out),\n      SExpr(expr) => edp_collect_handle_sites_expr(expr, ename, out),\n      STest(_, expr) => edp_collect_handle_sites_expr(expr, ename, out),\n      SBench(_, expr) => edp_collect_handle_sites_expr(expr, ename, out),\n      _ => ()\n    }\n    i = i + 1\n  }\n  out\n}\n\nfn edp_collect_handle_effect_names(stmts: Array[Stmt], out: Array[String]) -> Unit {\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SLet(_, _, _, _, expr) => edp_collect_handle_effect_names_expr(expr, out),\n      SLetMut(_, _, expr) => edp_collect_handle_effect_names_expr(expr, out),\n      SExpr(expr) => edp_collect_handle_effect_names_expr(expr, out),\n      STest(_, expr) => edp_collect_handle_effect_names_expr(expr, out),\n      SBench(_, expr) => edp_collect_handle_effect_names_expr(expr, out),\n      _ => ()\n    }\n    i = i + 1\n  }\n}\n\nfn edp_collect_handle_effect_names_expr(expr: Expr, out: Array[String]) -> Unit {\n  match expr {\n    EHandle(body, arms) => {\n      if Array::length(arms) > 0 {\n        let (p, _) = Array::get(arms, 0)\n        let qname = edp_pat_qname(p)\n        let (eff_opt, _) = edp_split_qualified(qname)\n        match eff_opt {\n          Some(e) => if is_exception_effect_name(e) || edp_str_array_contains(out, e) {\n            ()\n          } else {\n            Array::push(out, e)\n          },\n          None => ()\n        }\n      } else {\n        ()\n      }\n      edp_collect_handle_effect_names_expr(body, out)\n      let mut i = 0\n      while i < Array::length(arms) {\n        let (_, ex) = Array::get(arms, i)\n        edp_collect_handle_effect_names_expr(ex, out)\n        i = i + 1\n      }\n    },\n    EFn(_, _, _, _, _, b) => edp_collect_handle_effect_names_expr(b, out),\n    EIf(c, t, e2) => {\n      edp_collect_handle_effect_names_expr(c, out)\n      edp_collect_handle_effect_names_expr(t, out)\n      edp_collect_handle_effect_names_expr(e2, out)\n    },\n    EMatch(s, arms) => {\n      edp_collect_handle_effect_names_expr(s, out)\n      let mut i = 0\n      while i < Array::length(arms) {\n        let (_, ex) = Array::get(arms, i)\n        edp_collect_handle_effect_names_expr(ex, out)\n        i = i + 1\n      }\n    },\n    EWhile(c, b) => {\n      edp_collect_handle_effect_names_expr(c, out)\n      edp_collect_handle_effect_names_expr(b, out)\n    },\n    EForIn(_, _, it, b) => {\n      edp_collect_handle_effect_names_expr(it, out)\n      edp_collect_handle_effect_names_expr(b, out)\n    },\n    ELoop(pairs, b) => {\n      let mut i = 0\n      while i < Array::length(pairs) {\n        let (_, v) = Array::get(pairs, i)\n        edp_collect_handle_effect_names_expr(v, out)\n        i = i + 1\n      }\n      edp_collect_handle_effect_names_expr(b, out)\n    },\n    ELet(_, v, b, _) => {\n      edp_collect_handle_effect_names_expr(v, out)\n      edp_collect_handle_effect_names_expr(b, out)\n    },\n    ELetMut(_, v, b, _) => {\n      edp_collect_handle_effect_names_expr(v, out)\n      edp_collect_handle_effect_names_expr(b, out)\n    },\n    ELetRec(_, v, b) => {\n      edp_collect_handle_effect_names_expr(v, out)\n      edp_collect_handle_effect_names_expr(b, out)\n    },\n    ESeq(a, b) => {\n      edp_collect_handle_effect_names_expr(a, out)\n      edp_collect_handle_effect_names_expr(b, out)\n    },\n    EAssign(_, v, c) => {\n      edp_collect_handle_effect_names_expr(v, out)\n      edp_collect_handle_effect_names_expr(c, out)\n    },\n    EAssignOp(_, _, v, c) => {\n      edp_collect_handle_effect_names_expr(v, out)\n      edp_collect_handle_effect_names_expr(c, out)\n    },\n    EReturn(e2) => edp_collect_handle_effect_names_expr(e2, out),\n    EDot(o, _, _, _) => edp_collect_handle_effect_names_expr(o, out),\n    ECall(callee, args, _) => {\n      edp_collect_handle_effect_names_expr(callee, out)\n      let mut i = 0\n      while i < Array::length(args) {\n        edp_collect_handle_effect_names_expr(Array::get(args, i), out)\n        i = i + 1\n      }\n    },\n    EBinOp(_, l, r) => {\n      edp_collect_handle_effect_names_expr(l, out)\n      edp_collect_handle_effect_names_expr(r, out)\n    },\n    EUnaryOp(_, e2) => edp_collect_handle_effect_names_expr(e2, out),\n    ELabeledArg(_, _, v) => edp_collect_handle_effect_names_expr(v, out),\n    EBreak(opt) => match opt {\n      Some(e2) => edp_collect_handle_effect_names_expr(e2, out),\n      None => ()\n    },\n    EContinue(args) => {\n      let mut i = 0\n      while i < Array::length(args) {\n        edp_collect_handle_effect_names_expr(Array::get(args, i), out)\n        i = i + 1\n      }\n    },\n    ETuple(elems) => {\n      let mut i = 0\n      while i < Array::length(elems) {\n        edp_collect_handle_effect_names_expr(Array::get(elems, i), out)\n        i = i + 1\n      }\n    },\n    EArray(elems) => {\n      let mut i = 0\n      while i < Array::length(elems) {\n        edp_collect_handle_effect_names_expr(Array::get(elems, i), out)\n        i = i + 1\n      }\n    },\n    ERecord(_, fields, _) => {\n      let mut i = 0\n      while i < Array::length(fields) {\n        let (_, v) = Array::get(fields, i)\n        edp_collect_handle_effect_names_expr(v, out)\n        i = i + 1\n      }\n    },\n    EMap(fields) => {\n      let mut i = 0\n      while i < Array::length(fields) {\n        let (_, v) = Array::get(fields, i)\n        edp_collect_handle_effect_names_expr(v, out)\n        i = i + 1\n      }\n    },\n    ESpread(e2) => edp_collect_handle_effect_names_expr(e2, out),\n    _ => ()\n  }\n}\n\nfn edp_handle_matches_effect(arms: Array[(Pat, Expr)], ename: String) -> Bool {\n  if Array::length(arms) == 0 {\n    false\n  } else {\n    let (p, _) = Array::get(arms, 0)\n    let qname = edp_pat_qname(p)\n    let (eff_opt, _) = edp_split_qualified(qname)\n    match eff_opt {\n      Some(e) => e == ename,\n      None => false\n    }\n  }\n}\n\nfn edp_split_qualified(name: String) -> (Option[String], String) {\n  let idx = String::index_of(name, \"::\")\n  if idx > 0 {\n    (Some(String::substring(name, 0, idx)), String::substring(name, idx + 2, String::length(name)))\n  } else {\n    (None, name)\n  }\n}\n\nfn edp_collect_handle_sites_expr(expr: Expr, ename: String, out: Array[(Expr, Array[(Pat, Expr)])]) -> Unit {\n  match expr {\n    EHandle(body, arms) => if edp_handle_matches_effect(arms, ename) {\n      Array::push(out, (body, arms))\n    } else {\n      edp_collect_handle_sites_expr(body, ename, out)\n    },\n    EFn(_, _, _, _, _, b) => edp_collect_handle_sites_expr(b, ename, out),\n    ELet(_, v, b, _) => {\n      edp_collect_handle_sites_expr(v, ename, out)\n      edp_collect_handle_sites_expr(b, ename, out)\n    },\n    ELetMut(_, v, b, _) => {\n      edp_collect_handle_sites_expr(v, ename, out)\n      edp_collect_handle_sites_expr(b, ename, out)\n    },\n    ELetRec(_, v, b) => {\n      edp_collect_handle_sites_expr(v, ename, out)\n      edp_collect_handle_sites_expr(b, ename, out)\n    },\n    ESeq(a, b) => {\n      edp_collect_handle_sites_expr(a, ename, out)\n      edp_collect_handle_sites_expr(b, ename, out)\n    },\n    EIf(c, t, e) => {\n      edp_collect_handle_sites_expr(c, ename, out)\n      edp_collect_handle_sites_expr(t, ename, out)\n      edp_collect_handle_sites_expr(e, ename, out)\n    },\n    EMatch(s, arms) => {\n      edp_collect_handle_sites_expr(s, ename, out)\n      for a in arms {\n        let (_, ex) = a\n        edp_collect_handle_sites_expr(ex, ename, out)\n      }\n    },\n    EWhile(c, b) => {\n      edp_collect_handle_sites_expr(c, ename, out)\n      edp_collect_handle_sites_expr(b, ename, out)\n    },\n    EForIn(_, _, it, b) => {\n      edp_collect_handle_sites_expr(it, ename, out)\n      edp_collect_handle_sites_expr(b, ename, out)\n    },\n    ECall(callee, args, _) => {\n      edp_collect_handle_sites_expr(callee, ename, out)\n      for a in args {\n        edp_collect_handle_sites_expr(a, ename, out)\n      }\n    },\n    EBinOp(_, l, r) => {\n      edp_collect_handle_sites_expr(l, ename, out)\n      edp_collect_handle_sites_expr(r, ename, out)\n    },\n    EUnaryOp(_, e2) => edp_collect_handle_sites_expr(e2, ename, out),\n    EAssign(_, v, c) => {\n      edp_collect_handle_sites_expr(v, ename, out)\n      edp_collect_handle_sites_expr(c, ename, out)\n    },\n    EAssignOp(_, _, v, c) => {\n      edp_collect_handle_sites_expr(v, ename, out)\n      edp_collect_handle_sites_expr(c, ename, out)\n    },\n    EDot(o, _, _, _) => edp_collect_handle_sites_expr(o, ename, out),\n    ELabeledArg(_, _, v) => edp_collect_handle_sites_expr(v, ename, out),\n    EReturn(e2) => edp_collect_handle_sites_expr(e2, ename, out),\n    EBreak(opt) => match opt {\n      Some(e2) => edp_collect_handle_sites_expr(e2, ename, out),\n      None => ()\n    },\n    EContinue(args) => for a in args {\n      edp_collect_handle_sites_expr(a, ename, out)\n    },\n    ETuple(elems) => for a in elems {\n      edp_collect_handle_sites_expr(a, ename, out)\n    },\n    EArray(elems) => for a in elems {\n      edp_collect_handle_sites_expr(a, ename, out)\n    },\n    ERecord(_, fields, _) => for f in fields {\n      let (_, v) = f\n      edp_collect_handle_sites_expr(v, ename, out)\n    },\n    EMap(fields) => for f in fields {\n      let (_, v) = f\n      edp_collect_handle_sites_expr(v, ename, out)\n    },\n    ESpread(e2) => edp_collect_handle_sites_expr(e2, ename, out),\n    ELoop(pairs, b) => {\n      for p in pairs {\n        let (_, v) = p\n        edp_collect_handle_sites_expr(v, ename, out)\n      }\n      edp_collect_handle_sites_expr(b, ename, out)\n    },\n    _ => ()\n  }\n}\n\nfn edp_all_sites_eligible(stmts: Array[Stmt], ename: String, needing: Array[String], handle_sites: Array[(Expr, Array[(Pat, Expr)])], fn_defs: Array[(Int, Bool, Bool, String, Option[TypeExpr], String)]) -> Bool {\n  if Array::length(handle_sites) == 0 {\n    false\n  } else {\n    let pure_fns = edp_pure_fn_names(fn_defs)\n    edp_append_free_host_inert_names(stmts, pure_fns)\n    edp_append_perform_free_row_fns(stmts, fn_defs, ename, pure_fns)\n    let es_names = array_empty()\n    let es_members_list = array_empty()\n    edp_es_collect_into(stmts, es_names, es_members_list)\n    let td_binds_raw = empty_str_array()\n    let td_lits = array_empty()\n    edp_row_lit_scan(stmts, ename, needing, es_names, es_members_list, td_binds_raw, td_lits)\n    let td_poison = empty_str_array()\n    edp_collect_poison_stmts(stmts, ename, needing, es_names, es_members_list, td_poison)\n    let td_binds = edp_filter_unpoisoned(td_binds_raw, td_poison)\n    let td_mode = Array::length(td_binds) > 0 || Array::length(td_lits) > 0 || edp_any_row_typed_param(stmts, fn_defs, ename, es_names, es_members_list)\n    let mut ok = true\n    let mut hsi = 0\n    while hsi < Array::length(stmts) {\n      let sval_opt = match Array::get(stmts, hsi) {\n        SLet(_, _, _, _, sv) => Some(sv),\n        SLetMut(_, _, sv) => Some(sv),\n        SExpr(sv) => Some(sv),\n        STest(_, sv) => Some(sv),\n        SBench(_, sv) => Some(sv),\n        _ => None\n      }\n      match sval_opt {\n        Some(sval) => {\n          let hext = match Array::get(stmts, hsi) {\n            SLet(_, _, snm, _, _) => match sval {\n              EFn(_, _, sparams, _, _, sbody) => edp_closure_param_names_only(edp_handle_owner_cps(stmts, snm, sparams, sbody, ename, needing, pure_fns, es_names, es_members_list)),\n              _ => empty_str_array()\n            },\n            _ => empty_str_array()\n          }\n          let tdext = if td_mode {\n            match sval {\n              EFn(_, _, sparams2, _, _, _) => Array::concat(td_binds, edp_row_typed_param_names(sparams2, ename, es_names, es_members_list)),\n              _ => td_binds\n            }\n          } else {\n            empty_str_array()\n          }\n          let call_safe_h = Array::concat(Array::concat(needing, hext), tdext)\n          let sites = array_empty()\n          edp_collect_handle_sites_expr(sval, ename, sites)\n          let mut hi = 0\n          while hi < Array::length(sites) {\n            let (body, _) = Array::get(sites, hi)\n            if edp_has_unsafe_construct(body, call_safe_h, ename, pure_fns) {\n              ok = false\n            } else {\n              ()\n            }\n            hi = hi + 1\n          }\n        },\n        None => ()\n      }\n      hsi = hsi + 1\n    }\n    let mut ni = 0\n    while ni < Array::length(needing) {\n      let nm = Array::get(needing, ni)\n      match edp_find_fn_params_and_body(stmts, fn_defs, nm) {\n        Some((gparams, b)) => {\n          let own_cp = edp_own_closure_params(stmts, nm, gparams, ename, needing, pure_fns, es_names, es_members_list)\n          let tdext2 = if td_mode {\n            Array::concat(td_binds, edp_row_typed_param_names(gparams, ename, es_names, es_members_list))\n          } else {\n            empty_str_array()\n          }\n          let call_safe = Array::concat(Array::concat(needing, edp_closure_param_names_only(own_cp)), tdext2)\n          if edp_has_unsafe_construct(b, call_safe, ename, pure_fns) {\n            ok = false\n          } else {\n            ()\n          }\n        },\n        None => {\n          ok = false\n        }\n      }\n      ni = ni + 1\n    }\n    let mut tli = 0\n    while tli < Array::length(td_lits) {\n      match Array::get(td_lits, tli) {\n        EFn(_, _, lparams, _, _, lbody) => {\n          let lsafe = Array::concat(Array::concat(needing, td_binds), edp_row_typed_param_names(lparams, ename, es_names, es_members_list))\n          if edp_has_unsafe_construct(lbody, lsafe, ename, pure_fns) {\n            ok = false\n          } else {\n            ()\n          }\n        },\n        _ => ()\n      }\n      tli = tli + 1\n    }\n    ok\n  }\n}\n\nfn edp_find_fn_body(stmts: Array[Stmt], fn_defs: Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], name: String) -> Option[Expr] {\n  let mut i = 0\n  let mut result = None\n  while i < Array::length(fn_defs) {\n    let (idx, _, _, nm, _, _) = Array::get(fn_defs, i)\n    if nm == name {\n      match Array::get(stmts, idx) {\n        SLet(_, _, _, _, EFn(_, _, _, _, _, body)) => {\n          result = Some(body)\n        },\n        _ => ()\n      }\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  result\n}\n\n\nfn edp_type_is_fn_row_exactly(pty: Option[TypeExpr], ename: String, es_names: Array[String], es_members_list: Array[Array[String]]) -> Bool {\n  match pty {\n    Some(t) => match t {\n      TyFn(_, _, roweff) => match roweff {\n        Some(row) => edp_row_is_exactly(row, ename, es_names, es_members_list),\n        None => false\n      },\n      _ => false\n    },\n    None => false\n  }\n}\n\nfn edp_find_fn_params_and_body(stmts: Array[Stmt], fn_defs: Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], name: String) -> Option[(Array[(String, Option[TypeExpr])], Expr)] {\n  let mut i = 0\n  let mut result = None\n  while i < Array::length(fn_defs) {\n    let (idx, _, _, nm, _, _) = Array::get(fn_defs, i)\n    if nm == name {\n      match Array::get(stmts, idx) {\n        SLet(_, _, _, _, EFn(_, _, params, _, _, body)) => {\n          result = Some((params, body))\n        },\n        _ => ()\n      }\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  result\n}\n\n\nfn edp_params_have_dict(params: Array[(String, Option[TypeExpr])], dict_pname: String) -> Bool {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(params) {\n    let (pn, _) = Array::get(params, i)\n    if pn == dict_pname {\n      found = true\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  found\n}\n\nfn edp_efn_row_carries(expr: Expr, ename: String, es_names: Array[String], es_members_list: Array[Array[String]]) -> Bool {\n  match expr {\n    EFn(_, _, params, _, eff, _) => match eff {\n      Some(row) => {\n        let already = edp_params_have_dict(params, edp_dict_param_name(ename))\n        !already && edp_row_is_exactly(row, ename, es_names, es_members_list)\n      },\n      None => false\n    },\n    _ => false\n  }\n}\n\nfn edp_row_typed_param_names(params: Array[(String, Option[TypeExpr])], ename: String, es_names: Array[String], es_members_list: Array[Array[String]]) -> Array[String] {\n  let out = empty_str_array()\n  let mut i = 0\n  while i < Array::length(params) {\n    let (pn, pty) = Array::get(params, i)\n    if edp_type_is_fn_row_exactly(pty, ename, es_names, es_members_list) {\n      Array::push(out, edp_strip_tilde(pn))\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  out\n}\n\nfn edp_row_lit_scan(stmts: Array[Stmt], ename: String, needing: Array[String], es_names: Array[String], es_members_list: Array[Array[String]], binds: Array[String], lits: Array[Expr]) -> Unit {\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SLet(_, _, _, _, expr) => match expr {\n        EFn(_, _, _, _, _, fb) => edp_row_lit_scan_expr(fb, ename, needing, es_names, es_members_list, binds, lits),\n        _ => edp_row_lit_scan_expr(expr, ename, needing, es_names, es_members_list, binds, lits)\n      },\n      SLetMut(_, _, expr) => edp_row_lit_scan_expr(expr, ename, needing, es_names, es_members_list, binds, lits),\n      SExpr(expr) => edp_row_lit_scan_expr(expr, ename, needing, es_names, es_members_list, binds, lits),\n      STest(_, expr) => edp_row_lit_scan_expr(expr, ename, needing, es_names, es_members_list, binds, lits),\n      SBench(_, expr) => edp_row_lit_scan_expr(expr, ename, needing, es_names, es_members_list, binds, lits),\n      _ => ()\n    }\n    i = i + 1\n  }\n}\n\nfn edp_filter_unpoisoned(binds: Array[String], poison: Array[String]) -> Array[String] {\n  let out = empty_str_array()\n  let mut i = 0\n  while i < Array::length(binds) {\n    let nm = Array::get(binds, i)\n    if edp_str_array_contains(poison, nm) || edp_str_array_contains(out, nm) {\n      ()\n    } else {\n      Array::push(out, nm)\n    }\n    i = i + 1\n  }\n  out\n}\n\nfn edp_collect_poison_stmts(stmts: Array[Stmt], ename: String, needing: Array[String], es_names: Array[String], es_members_list: Array[Array[String]], poison: Array[String]) -> Unit {\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SLet(_, _, snm, _, expr) => match expr {\n        EFn(_, _, params, _, _, fb) => {\n          if edp_row_lit_bindable(expr, ename, needing, es_names, es_members_list) {\n            ()\n          } else {\n            edp_poison_add(snm, poison)\n          }\n          edp_poison_params(params, ename, es_names, es_members_list, poison)\n          edp_collect_poison_expr(fb, ename, needing, es_names, es_members_list, poison)\n        },\n        _ => {\n          if edp_row_lit_bindable(expr, ename, needing, es_names, es_members_list) {\n            ()\n          } else {\n            edp_poison_add(snm, poison)\n          }\n          edp_collect_poison_expr(expr, ename, needing, es_names, es_members_list, poison)\n        }\n      },\n      SLetMut(snm, _, expr) => {\n        edp_poison_add(snm, poison)\n        edp_collect_poison_expr(expr, ename, needing, es_names, es_members_list, poison)\n      },\n      SExpr(expr) => edp_collect_poison_expr(expr, ename, needing, es_names, es_members_list, poison),\n      STest(_, expr) => edp_collect_poison_expr(expr, ename, needing, es_names, es_members_list, poison),\n      SBench(_, expr) => edp_collect_poison_expr(expr, ename, needing, es_names, es_members_list, poison),\n      _ => ()\n    }\n    i = i + 1\n  }\n}\n\nfn edp_poison_params(params: Array[(String, Option[TypeExpr])], ename: String, es_names: Array[String], es_members_list: Array[Array[String]], poison: Array[String]) -> Unit {\n  let mut i = 0\n  while i < Array::length(params) {\n    let (pn, pty) = Array::get(params, i)\n    if edp_type_is_fn_row_exactly(pty, ename, es_names, es_members_list) {\n      ()\n    } else {\n      let nm = edp_strip_tilde(pn)\n      if edp_str_array_contains(poison, nm) {\n        ()\n      } else {\n        Array::push(poison, nm)\n      }\n    }\n    i = i + 1\n  }\n}\n\nfn edp_poison_add(nm: String, poison: Array[String]) -> Unit {\n  if edp_str_array_contains(poison, nm) {\n    ()\n  } else {\n    Array::push(poison, nm)\n  }\n}\n\nfn edp_collect_poison_expr(e: Expr, ename: String, needing: Array[String], es_names: Array[String], es_members_list: Array[Array[String]], poison: Array[String]) -> Unit {\n  match e {\n    ELet(n, v, b, _) => {\n      if !edp_row_lit_bindable(v, ename, needing, es_names, es_members_list) {\n        edp_poison_add(n, poison)\n      } else {\n        ()\n      }\n      edp_collect_poison_expr(v, ename, needing, es_names, es_members_list, poison)\n      edp_collect_poison_expr(b, ename, needing, es_names, es_members_list, poison)\n    },\n    ELetRec(n, v, b) => {\n      if !edp_row_lit_bindable(v, ename, needing, es_names, es_members_list) {\n        edp_poison_add(n, poison)\n      } else {\n        ()\n      }\n      edp_collect_poison_expr(v, ename, needing, es_names, es_members_list, poison)\n      edp_collect_poison_expr(b, ename, needing, es_names, es_members_list, poison)\n    },\n    ELetMut(n, v, b, _) => {\n      edp_poison_add(n, poison)\n      edp_collect_poison_expr(v, ename, needing, es_names, es_members_list, poison)\n      edp_collect_poison_expr(b, ename, needing, es_names, es_members_list, poison)\n    },\n    EFn(_, _, params, _, _, fb) => {\n      edp_poison_params(params, ename, es_names, es_members_list, poison)\n      edp_collect_poison_expr(fb, ename, needing, es_names, es_members_list, poison)\n    },\n    ESeq(a, b) => {\n      edp_collect_poison_expr(a, ename, needing, es_names, es_members_list, poison)\n      edp_collect_poison_expr(b, ename, needing, es_names, es_members_list, poison)\n    },\n    EIf(c, t, el) => {\n      edp_collect_poison_expr(c, ename, needing, es_names, es_members_list, poison)\n      edp_collect_poison_expr(t, ename, needing, es_names, es_members_list, poison)\n      edp_collect_poison_expr(el, ename, needing, es_names, es_members_list, poison)\n    },\n    EMatch(sc, arms) => {\n      edp_collect_poison_expr(sc, ename, needing, es_names, es_members_list, poison)\n      let mut ai = 0\n      while ai < Array::length(arms) {\n        let (pp, ex) = Array::get(arms, ai)\n        edp_poison_pat(pp, poison)\n        edp_collect_poison_expr(ex, ename, needing, es_names, es_members_list, poison)\n        ai = ai + 1\n      }\n    },\n    EHandle(bd, arms) => {\n      edp_collect_poison_expr(bd, ename, needing, es_names, es_members_list, poison)\n      let mut ai = 0\n      while ai < Array::length(arms) {\n        let (pp, ex) = Array::get(arms, ai)\n        edp_poison_pat(pp, poison)\n        edp_collect_poison_expr(ex, ename, needing, es_names, es_members_list, poison)\n        ai = ai + 1\n      }\n    },\n    ECall(callee, args, _) => {\n      edp_collect_poison_expr(callee, ename, needing, es_names, es_members_list, poison)\n      let mut ai = 0\n      while ai < Array::length(args) {\n        edp_collect_poison_expr(Array::get(args, ai), ename, needing, es_names, es_members_list, poison)\n        ai = ai + 1\n      }\n    },\n    EWhile(c, b) => {\n      edp_collect_poison_expr(c, ename, needing, es_names, es_members_list, poison)\n      edp_collect_poison_expr(b, ename, needing, es_names, es_members_list, poison)\n    },\n    EForIn(n, idx, it, b) => {\n      edp_poison_add(n, poison)\n      match idx {\n        Some(ix) => edp_poison_add(ix, poison),\n        None => ()\n      }\n      edp_collect_poison_expr(it, ename, needing, es_names, es_members_list, poison)\n      edp_collect_poison_expr(b, ename, needing, es_names, es_members_list, poison)\n    },\n    ELoop(pairs, b) => {\n      let mut pi = 0\n      while pi < Array::length(pairs) {\n        let (n, v) = Array::get(pairs, pi)\n        edp_poison_add(n, poison)\n        edp_collect_poison_expr(v, ename, needing, es_names, es_members_list, poison)\n        pi = pi + 1\n      }\n      edp_collect_poison_expr(b, ename, needing, es_names, es_members_list, poison)\n    },\n    EBinOp(_, l, r) => {\n      edp_collect_poison_expr(l, ename, needing, es_names, es_members_list, poison)\n      edp_collect_poison_expr(r, ename, needing, es_names, es_members_list, poison)\n    },\n    EUnaryOp(_, x) => edp_collect_poison_expr(x, ename, needing, es_names, es_members_list, poison),\n    EAssign(_, v, c) => {\n      edp_collect_poison_expr(v, ename, needing, es_names, es_members_list, poison)\n      edp_collect_poison_expr(c, ename, needing, es_names, es_members_list, poison)\n    },\n    EAssignOp(_, _, v, c) => {\n      edp_collect_poison_expr(v, ename, needing, es_names, es_members_list, poison)\n      edp_collect_poison_expr(c, ename, needing, es_names, es_members_list, poison)\n    },\n    EReturn(x) => edp_collect_poison_expr(x, ename, needing, es_names, es_members_list, poison),\n    EDot(o, _, _, _) => edp_collect_poison_expr(o, ename, needing, es_names, es_members_list, poison),\n    ELabeledArg(_, _, v) => edp_collect_poison_expr(v, ename, needing, es_names, es_members_list, poison),\n    EBreak(opt) => match opt {\n      Some(x) => edp_collect_poison_expr(x, ename, needing, es_names, es_members_list, poison),\n      None => ()\n    },\n    EContinue(args) => {\n      let mut ai = 0\n      while ai < Array::length(args) {\n        edp_collect_poison_expr(Array::get(args, ai), ename, needing, es_names, es_members_list, poison)\n        ai = ai + 1\n      }\n    },\n    ETuple(items) => {\n      let mut ai = 0\n      while ai < Array::length(items) {\n        edp_collect_poison_expr(Array::get(items, ai), ename, needing, es_names, es_members_list, poison)\n        ai = ai + 1\n      }\n    },\n    EArray(items) => {\n      let mut ai = 0\n      while ai < Array::length(items) {\n        edp_collect_poison_expr(Array::get(items, ai), ename, needing, es_names, es_members_list, poison)\n        ai = ai + 1\n      }\n    },\n    ERecord(_, fields, _) => {\n      let mut ai = 0\n      while ai < Array::length(fields) {\n        let (_, v) = Array::get(fields, ai)\n        edp_collect_poison_expr(v, ename, needing, es_names, es_members_list, poison)\n        ai = ai + 1\n      }\n    },\n    EMap(fields) => {\n      let mut ai = 0\n      while ai < Array::length(fields) {\n        let (_, v) = Array::get(fields, ai)\n        edp_collect_poison_expr(v, ename, needing, es_names, es_members_list, poison)\n        ai = ai + 1\n      }\n    },\n    ESpread(x) => edp_collect_poison_expr(x, ename, needing, es_names, es_members_list, poison),\n    _ => ()\n  }\n}\n\nfn edp_poison_pat(p: Pat, poison: Array[String]) -> Unit {\n  let names = empty_str_array()\n  edp_pat_binds(p, names)\n  let mut i = 0\n  while i < Array::length(names) {\n    edp_poison_add(Array::get(names, i), poison)\n    i = i + 1\n  }\n}\n\nfn edp_row_lit_bindable(v: Expr, ename: String, needing: Array[String], es_names: Array[String], es_members_list: Array[Array[String]]) -> Bool {\n  if edp_efn_row_carries(v, ename, es_names, es_members_list) {\n    true\n  } else {\n    match v {\n      EIdent(nm, _) => edp_str_array_contains(needing, nm),\n      _ => false\n    }\n  }\n}\n\nfn edp_row_lit_scan_expr(e: Expr, ename: String, needing: Array[String], es_names: Array[String], es_members_list: Array[Array[String]], binds: Array[String], lits: Array[Expr]) -> Unit {\n  if edp_efn_row_carries(e, ename, es_names, es_members_list) {\n    Array::push(lits, e)\n  } else {\n    ()\n  }\n  match e {\n    ELet(n, v, b, _) => {\n      if edp_row_lit_bindable(v, ename, needing, es_names, es_members_list) {\n        Array::push(binds, n)\n      } else {\n        ()\n      }\n      edp_row_lit_scan_expr(v, ename, needing, es_names, es_members_list, binds, lits)\n      edp_row_lit_scan_expr(b, ename, needing, es_names, es_members_list, binds, lits)\n    },\n    ELetRec(n, v, b) => {\n      if edp_row_lit_bindable(v, ename, needing, es_names, es_members_list) {\n        Array::push(binds, n)\n      } else {\n        ()\n      }\n      edp_row_lit_scan_expr(v, ename, needing, es_names, es_members_list, binds, lits)\n      edp_row_lit_scan_expr(b, ename, needing, es_names, es_members_list, binds, lits)\n    },\n    ELetMut(_, v, b, _) => {\n      edp_row_lit_scan_expr(v, ename, needing, es_names, es_members_list, binds, lits)\n      edp_row_lit_scan_expr(b, ename, needing, es_names, es_members_list, binds, lits)\n    },\n    EFn(_, _, _, _, _, fb) => edp_row_lit_scan_expr(fb, ename, needing, es_names, es_members_list, binds, lits),\n    ESeq(a, b) => {\n      edp_row_lit_scan_expr(a, ename, needing, es_names, es_members_list, binds, lits)\n      edp_row_lit_scan_expr(b, ename, needing, es_names, es_members_list, binds, lits)\n    },\n    EIf(c, t, el) => {\n      edp_row_lit_scan_expr(c, ename, needing, es_names, es_members_list, binds, lits)\n      edp_row_lit_scan_expr(t, ename, needing, es_names, es_members_list, binds, lits)\n      edp_row_lit_scan_expr(el, ename, needing, es_names, es_members_list, binds, lits)\n    },\n    EMatch(sc, arms) => {\n      edp_row_lit_scan_expr(sc, ename, needing, es_names, es_members_list, binds, lits)\n      let mut ai = 0\n      while ai < Array::length(arms) {\n        let (_, ex) = Array::get(arms, ai)\n        edp_row_lit_scan_expr(ex, ename, needing, es_names, es_members_list, binds, lits)\n        ai = ai + 1\n      }\n    },\n    EHandle(bd, arms) => {\n      edp_row_lit_scan_expr(bd, ename, needing, es_names, es_members_list, binds, lits)\n      let mut ai = 0\n      while ai < Array::length(arms) {\n        let (_, ex) = Array::get(arms, ai)\n        edp_row_lit_scan_expr(ex, ename, needing, es_names, es_members_list, binds, lits)\n        ai = ai + 1\n      }\n    },\n    ECall(callee, args, _) => {\n      edp_row_lit_scan_expr(callee, ename, needing, es_names, es_members_list, binds, lits)\n      let mut ai = 0\n      while ai < Array::length(args) {\n        edp_row_lit_scan_expr(Array::get(args, ai), ename, needing, es_names, es_members_list, binds, lits)\n        ai = ai + 1\n      }\n    },\n    EWhile(c, b) => {\n      edp_row_lit_scan_expr(c, ename, needing, es_names, es_members_list, binds, lits)\n      edp_row_lit_scan_expr(b, ename, needing, es_names, es_members_list, binds, lits)\n    },\n    EForIn(_, _, it, b) => {\n      edp_row_lit_scan_expr(it, ename, needing, es_names, es_members_list, binds, lits)\n      edp_row_lit_scan_expr(b, ename, needing, es_names, es_members_list, binds, lits)\n    },\n    ELoop(pairs, b) => {\n      let mut pi = 0\n      while pi < Array::length(pairs) {\n        let (_, v) = Array::get(pairs, pi)\n        edp_row_lit_scan_expr(v, ename, needing, es_names, es_members_list, binds, lits)\n        pi = pi + 1\n      }\n      edp_row_lit_scan_expr(b, ename, needing, es_names, es_members_list, binds, lits)\n    },\n    EBinOp(_, l, r) => {\n      edp_row_lit_scan_expr(l, ename, needing, es_names, es_members_list, binds, lits)\n      edp_row_lit_scan_expr(r, ename, needing, es_names, es_members_list, binds, lits)\n    },\n    EUnaryOp(_, x) => edp_row_lit_scan_expr(x, ename, needing, es_names, es_members_list, binds, lits),\n    EAssign(_, v, c) => {\n      edp_row_lit_scan_expr(v, ename, needing, es_names, es_members_list, binds, lits)\n      edp_row_lit_scan_expr(c, ename, needing, es_names, es_members_list, binds, lits)\n    },\n    EAssignOp(_, _, v, c) => {\n      edp_row_lit_scan_expr(v, ename, needing, es_names, es_members_list, binds, lits)\n      edp_row_lit_scan_expr(c, ename, needing, es_names, es_members_list, binds, lits)\n    },\n    EReturn(x) => edp_row_lit_scan_expr(x, ename, needing, es_names, es_members_list, binds, lits),\n    EDot(o, _, _, _) => edp_row_lit_scan_expr(o, ename, needing, es_names, es_members_list, binds, lits),\n    ELabeledArg(_, _, v) => edp_row_lit_scan_expr(v, ename, needing, es_names, es_members_list, binds, lits),\n    EBreak(opt) => match opt {\n      Some(x) => edp_row_lit_scan_expr(x, ename, needing, es_names, es_members_list, binds, lits),\n      None => ()\n    },\n    EContinue(args) => {\n      let mut ai = 0\n      while ai < Array::length(args) {\n        edp_row_lit_scan_expr(Array::get(args, ai), ename, needing, es_names, es_members_list, binds, lits)\n        ai = ai + 1\n      }\n    },\n    ETuple(items) => {\n      let mut ai = 0\n      while ai < Array::length(items) {\n        edp_row_lit_scan_expr(Array::get(items, ai), ename, needing, es_names, es_members_list, binds, lits)\n        ai = ai + 1\n      }\n    },\n    EArray(items) => {\n      let mut ai = 0\n      while ai < Array::length(items) {\n        edp_row_lit_scan_expr(Array::get(items, ai), ename, needing, es_names, es_members_list, binds, lits)\n        ai = ai + 1\n      }\n    },\n    ERecord(_, fields, _) => {\n      let mut ai = 0\n      while ai < Array::length(fields) {\n        let (_, v) = Array::get(fields, ai)\n        edp_row_lit_scan_expr(v, ename, needing, es_names, es_members_list, binds, lits)\n        ai = ai + 1\n      }\n    },\n    EMap(fields) => {\n      let mut ai = 0\n      while ai < Array::length(fields) {\n        let (_, v) = Array::get(fields, ai)\n        edp_row_lit_scan_expr(v, ename, needing, es_names, es_members_list, binds, lits)\n        ai = ai + 1\n      }\n    },\n    ESpread(x) => edp_row_lit_scan_expr(x, ename, needing, es_names, es_members_list, binds, lits),\n    _ => ()\n  }\n}\n\nfn edp_any_row_typed_param(stmts: Array[Stmt], fn_defs: Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], ename: String, es_names: Array[String], es_members_list: Array[Array[String]]) -> Bool {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(fn_defs) {\n    let (idx, _, _, _, _, _) = Array::get(fn_defs, i)\n    match Array::get(stmts, idx) {\n      SLet(_, _, _, _, EFn(_, _, params, _, _, _)) => if Array::length(edp_row_typed_param_names(params, ename, es_names, es_members_list)) > 0 {\n        found = true\n      } else {\n        ()\n      },\n      _ => ()\n    }\n    i = i + 1\n  }\n  found\n}\n\nfn edp_efn_eligible_for_migration(expr: Expr, ename: String, needing: Array[String], pure_fns: Array[String], es_names: Array[String], es_members_list: Array[Array[String]]) -> Bool {\n  match expr {\n    EFn(_, _, _, _, eff, body) => {\n      let row = match eff {\n        Some(s) => s,\n        None => \"\"\n      }\n      edp_row_is_exactly(row, ename, es_names, es_members_list) && !edp_has_unsafe_construct(body, needing, ename, pure_fns)\n    },\n    _ => false\n  }\n}\n\nfn edp_count_ident_uses_stmts(stmts: Array[Stmt], name: String) -> Int {\n  let mut total = 0\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SLet(_, _, _, _, expr) => {\n        total = total + edp_count_ident_uses(expr, name)\n      },\n      _ => ()\n    }\n    i = i + 1\n  }\n  total\n}\n\nfn edp_params_of_fn(stmts: Array[Stmt], fn_defs: Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], nm: String) -> Option[Array[(String, Option[TypeExpr])]] {\n  let mut out: Option[Array[(String, Option[TypeExpr])]] = None\n  let mut i = 0\n  while i < Array::length(fn_defs) {\n    let (idx, _, _, name, _, _) = Array::get(fn_defs, i)\n    if name == nm {\n      match Array::get(stmts, idx) {\n        SLet(_, _, _, _, EFn(_, _, params, _, _, _)) => {\n          out = Some(params)\n        },\n        _ => ()\n      }\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  out\n}\n\nfn edp_arg_slot_accepts_needing(stmts: Array[Stmt], fn_defs: Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], callee_nm: String, pos: Int, ename: String, es_names: Array[String], es_members_list: Array[Array[String]]) -> Bool {\n  match edp_params_of_fn(stmts, fn_defs, callee_nm) {\n    Some(params) => if pos < Array::length(params) {\n      let (_, pty) = Array::get(params, pos)\n      match pty {\n        Some(TyFn(_, _, _)) => edp_type_is_fn_row_exactly(pty, ename, es_names, es_members_list),\n        _ => true\n      }\n    } else {\n      true\n    },\n    None => true\n  }\n}\n\nfn edp_needing_escape(e: Expr, needing: Array[String], ename: String, stmts: Array[Stmt], fn_defs: Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], es_names: Array[String], es_members_list: Array[Array[String]]) -> String {\n  match e {\n    ECall(callee, args, _) => {\n      let callee_nm = match callee {\n        EIdent(cn, _) => cn,\n        _ => \"\"\n      }\n      let mut hit = if callee_nm == \"\" {\n        edp_needing_escape(callee, needing, ename, stmts, fn_defs, es_names, es_members_list)\n      } else {\n        \"\"\n      }\n      let mut i = 0\n      while i < Array::length(args) && hit == \"\" {\n        let a = Array::get(args, i)\n        let bare = match a {\n          EIdent(an, _) => if edp_str_array_contains(needing, an) {\n            an\n          } else {\n            \"\"\n          },\n          _ => \"\"\n        }\n        if bare == \"\" {\n          hit = edp_needing_escape(a, needing, ename, stmts, fn_defs, es_names, es_members_list)\n        } else if callee_nm != \"\" && edp_arg_slot_accepts_needing(stmts, fn_defs, callee_nm, i, ename, es_names, es_members_list) {\n          ()\n        } else {\n          hit = bare\n        }\n        i = i + 1\n      }\n      hit\n    },\n    EFn(_, _, _, _, _, b) => edp_needing_escape(b, needing, ename, stmts, fn_defs, es_names, es_members_list),\n    EHandle(b, arms) => edp_needing_escape_or(edp_needing_escape(b, needing, ename, stmts, fn_defs, es_names, es_members_list), edp_needing_escape_arms(arms, needing, ename, stmts, fn_defs, es_names, es_members_list)),\n    EIf(c, t, el) => edp_needing_escape_or(edp_needing_escape(c, needing, ename, stmts, fn_defs, es_names, es_members_list), edp_needing_escape_or(edp_needing_escape(t, needing, ename, stmts, fn_defs, es_names, es_members_list), edp_needing_escape(el, needing, ename, stmts, fn_defs, es_names, es_members_list))),\n    EMatch(s, arms) => edp_needing_escape_or(edp_needing_escape(s, needing, ename, stmts, fn_defs, es_names, es_members_list), edp_needing_escape_arms(arms, needing, ename, stmts, fn_defs, es_names, es_members_list)),\n    EWhile(c, b) => edp_needing_escape_or(edp_needing_escape(c, needing, ename, stmts, fn_defs, es_names, es_members_list), edp_needing_escape(b, needing, ename, stmts, fn_defs, es_names, es_members_list)),\n    EForIn(_, _, it, b) => edp_needing_escape_or(edp_needing_escape(it, needing, ename, stmts, fn_defs, es_names, es_members_list), edp_needing_escape(b, needing, ename, stmts, fn_defs, es_names, es_members_list)),\n    ELoop(pairs, b) => edp_needing_escape_or(edp_needing_escape_pairs(pairs, needing, ename, stmts, fn_defs, es_names, es_members_list), edp_needing_escape(b, needing, ename, stmts, fn_defs, es_names, es_members_list)),\n    ELet(_, v, b, _) => edp_needing_escape_or(edp_needing_escape(v, needing, ename, stmts, fn_defs, es_names, es_members_list), edp_needing_escape(b, needing, ename, stmts, fn_defs, es_names, es_members_list)),\n    ELetMut(_, v, b, _) => edp_needing_escape_or(edp_needing_escape(v, needing, ename, stmts, fn_defs, es_names, es_members_list), edp_needing_escape(b, needing, ename, stmts, fn_defs, es_names, es_members_list)),\n    ELetRec(_, v, b) => edp_needing_escape_or(edp_needing_escape(v, needing, ename, stmts, fn_defs, es_names, es_members_list), edp_needing_escape(b, needing, ename, stmts, fn_defs, es_names, es_members_list)),\n    ESeq(a, b) => edp_needing_escape_or(edp_needing_escape(a, needing, ename, stmts, fn_defs, es_names, es_members_list), edp_needing_escape(b, needing, ename, stmts, fn_defs, es_names, es_members_list)),\n    EBinOp(_, l, r) => edp_needing_escape_or(edp_needing_escape(l, needing, ename, stmts, fn_defs, es_names, es_members_list), edp_needing_escape(r, needing, ename, stmts, fn_defs, es_names, es_members_list)),\n    EUnaryOp(_, x) => edp_needing_escape(x, needing, ename, stmts, fn_defs, es_names, es_members_list),\n    EAssign(_, v, c) => edp_needing_escape_or(edp_needing_escape(v, needing, ename, stmts, fn_defs, es_names, es_members_list), edp_needing_escape(c, needing, ename, stmts, fn_defs, es_names, es_members_list)),\n    EAssignOp(_, _, v, c) => edp_needing_escape_or(edp_needing_escape(v, needing, ename, stmts, fn_defs, es_names, es_members_list), edp_needing_escape(c, needing, ename, stmts, fn_defs, es_names, es_members_list)),\n    EDot(o, _, _, _) => edp_needing_escape(o, needing, ename, stmts, fn_defs, es_names, es_members_list),\n    ELabeledArg(_, _, v) => edp_needing_escape(v, needing, ename, stmts, fn_defs, es_names, es_members_list),\n    EReturn(x) => edp_needing_escape(x, needing, ename, stmts, fn_defs, es_names, es_members_list),\n    EBreak(opt) => match opt {\n      Some(x) => edp_needing_escape(x, needing, ename, stmts, fn_defs, es_names, es_members_list),\n      None => \"\"\n    },\n    EContinue(args) => edp_needing_escape_exprs(args, needing, ename, stmts, fn_defs, es_names, es_members_list),\n    ETuple(items) => edp_needing_escape_exprs(items, needing, ename, stmts, fn_defs, es_names, es_members_list),\n    EArray(items) => edp_needing_escape_exprs(items, needing, ename, stmts, fn_defs, es_names, es_members_list),\n    ERecord(_, fields, _) => edp_needing_escape_pairs(fields, needing, ename, stmts, fn_defs, es_names, es_members_list),\n    EMap(fields) => edp_needing_escape_pairs(fields, needing, ename, stmts, fn_defs, es_names, es_members_list),\n    ESpread(x) => edp_needing_escape(x, needing, ename, stmts, fn_defs, es_names, es_members_list),\n    _ => \"\"\n  }\n}\n\nfn edp_needing_escape_or(a: String, b: String) -> String {\n  if a == \"\" {\n    b\n  } else {\n    a\n  }\n}\n\nfn edp_needing_escape_exprs(es: Array[Expr], needing: Array[String], ename: String, stmts: Array[Stmt], fn_defs: Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], es_names: Array[String], es_members_list: Array[Array[String]]) -> String {\n  let mut hit = \"\"\n  let mut i = 0\n  while i < Array::length(es) && hit == \"\" {\n    hit = edp_needing_escape(Array::get(es, i), needing, ename, stmts, fn_defs, es_names, es_members_list)\n    i = i + 1\n  }\n  hit\n}\n\nfn edp_needing_escape_pairs(pairs: Array[(String, Expr)], needing: Array[String], ename: String, stmts: Array[Stmt], fn_defs: Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], es_names: Array[String], es_members_list: Array[Array[String]]) -> String {\n  let mut hit = \"\"\n  let mut i = 0\n  while i < Array::length(pairs) && hit == \"\" {\n    let (_, v) = Array::get(pairs, i)\n    hit = edp_needing_escape(v, needing, ename, stmts, fn_defs, es_names, es_members_list)\n    i = i + 1\n  }\n  hit\n}\n\nfn edp_needing_escape_arms(arms: Array[(Pat, Expr)], needing: Array[String], ename: String, stmts: Array[Stmt], fn_defs: Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], es_names: Array[String], es_members_list: Array[Array[String]]) -> String {\n  let mut hit = \"\"\n  let mut i = 0\n  while i < Array::length(arms) && hit == \"\" {\n    let (_, ex) = Array::get(arms, i)\n    hit = edp_needing_escape(ex, needing, ename, stmts, fn_defs, es_names, es_members_list)\n    i = i + 1\n  }\n  hit\n}\n\nfn edp_needing_escape_stmts(stmts: Array[Stmt], needing: Array[String], ename: String, fn_defs: Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], es_names: Array[String], es_members_list: Array[Array[String]]) -> String {\n  let mut hit = \"\"\n  let mut i = 0\n  while i < Array::length(stmts) && hit == \"\" {\n    match Array::get(stmts, i) {\n      SLet(_, _, _, _, expr) => {\n        hit = edp_needing_escape(expr, needing, ename, stmts, fn_defs, es_names, es_members_list)\n      },\n      SLetMut(_, _, expr) => {\n        hit = edp_needing_escape(expr, needing, ename, stmts, fn_defs, es_names, es_members_list)\n      },\n      SExpr(expr) => {\n        hit = edp_needing_escape(expr, needing, ename, stmts, fn_defs, es_names, es_members_list)\n      },\n      STest(_, expr) => {\n        hit = edp_needing_escape(expr, needing, ename, stmts, fn_defs, es_names, es_members_list)\n      },\n      SBench(_, expr) => {\n        hit = edp_needing_escape(expr, needing, ename, stmts, fn_defs, es_names, es_members_list)\n      },\n      _ => ()\n    }\n    i = i + 1\n  }\n  hit\n}\n\nfn edp_etawrap_value(stmts: Array[Stmt], fn_defs: Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], nm: String) -> Option[Expr] {\n  match edp_params_of_fn(stmts, fn_defs, nm) {\n    Some(params) => {\n      let mut plain = true\n      let mut ci = 0\n      while ci < Array::length(params) {\n        let (pn, _) = Array::get(params, ci)\n        if String::starts_with(pn, \"~\") || String::starts_with(pn, \"?\") {\n          plain = false\n        } else {\n          ()\n        }\n        ci = ci + 1\n      }\n      if plain {\n        let wparams = array_empty()\n        let cargs = array_empty()\n        let mut i = 0\n        while i < Array::length(params) {\n          let wn = String::concat(\"__edpw_\", Int::to_string(i))\n          Array::push(wparams, (wn, None))\n          Array::push(cargs, EIdent(wn, -1))\n          i = i + 1\n        }\n        Some(EFn(empty_str_array(), array_empty(), wparams, None, None, ECall(EIdent(nm, -1), cargs, -1)))\n      } else {\n        None\n      }\n    },\n    None => None\n  }\n}\n\nfn edp_etawrap_stmts(stmts: Array[Stmt], needing: Array[String], ename: String, fn_defs: Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], es_names: Array[String], es_members_list: Array[Array[String]]) -> Unit {\n  let wc = (stmts, fn_defs, es_names, es_members_list)\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SLet(ex, isrec, nm, ty, expr) => {\n        let scope = edp_str_array_contains(needing, nm)\n        Array::set(stmts, i, SLet(ex, isrec, nm, ty, edp_etawrap_expr(expr, scope, needing, ename, wc)))\n      },\n      SLetMut(nm, ty, expr) => {\n        Array::set(stmts, i, SLetMut(nm, ty, edp_etawrap_expr(expr, false, needing, ename, wc)))\n      },\n      SExpr(expr) => {\n        Array::set(stmts, i, SExpr(edp_etawrap_expr(expr, false, needing, ename, wc)))\n      },\n      STest(nm, expr) => {\n        Array::set(stmts, i, STest(nm, edp_etawrap_expr(expr, false, needing, ename, wc)))\n      },\n      SBench(nm, expr) => {\n        Array::set(stmts, i, SBench(nm, edp_etawrap_expr(expr, false, needing, ename, wc)))\n      },\n      _ => ()\n    }\n    i = i + 1\n  }\n}\n\nfn edp_etawrap_expr(e: Expr, in_scope: Bool, needing: Array[String], ename: String, wc: (Array[Stmt], Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], Array[String], Array[Array[String]])) -> Expr {\n  match e {\n    ECall(callee, args, off) => {\n      let (wstmts, wfn_defs, wes_names, wes_members) = wc\n      let callee_nm = match callee {\n        EIdent(cn, _) => cn,\n        _ => \"\"\n      }\n      let new_callee = if callee_nm == \"\" {\n        edp_etawrap_expr(callee, in_scope, needing, ename, wc)\n      } else {\n        callee\n      }\n      let new_args = array_empty()\n      let mut i = 0\n      while i < Array::length(args) {\n        let a = Array::get(args, i)\n        let bare = match a {\n          EIdent(an, _) => if edp_str_array_contains(needing, an) {\n            an\n          } else {\n            \"\"\n          },\n          _ => \"\"\n        }\n        let wrapped = if bare != \"\" && in_scope && callee_nm != \"\" && !edp_arg_slot_accepts_needing(wstmts, wfn_defs, callee_nm, i, ename, wes_names, wes_members) {\n          edp_etawrap_value(wstmts, wfn_defs, bare)\n        } else {\n          None\n        }\n        match wrapped {\n          Some(w) => Array::push(new_args, w),\n          None => Array::push(new_args, edp_etawrap_expr(a, in_scope, needing, ename, wc))\n        }\n        i = i + 1\n      }\n      ECall(new_callee, new_args, off)\n    },\n    EFn(tps, tbs, params, ret, eff, b) => EFn(tps, tbs, params, ret, eff, edp_etawrap_expr(b, in_scope, needing, ename, wc)),\n    EHandle(b, arms) => {\n      let matches = edp_handle_matches_effect(arms, ename)\n      let body_scope = if matches {\n        true\n      } else {\n        in_scope\n      }\n      let arm_scope = if matches {\n        false\n      } else {\n        in_scope\n      }\n      EHandle(edp_etawrap_expr(b, body_scope, needing, ename, wc), edp_etawrap_arms(arms, arm_scope, needing, ename, wc))\n    },\n    EIf(c, t, el) => EIf(edp_etawrap_expr(c, in_scope, needing, ename, wc), edp_etawrap_expr(t, in_scope, needing, ename, wc), edp_etawrap_expr(el, in_scope, needing, ename, wc)),\n    EMatch(s, arms) => EMatch(edp_etawrap_expr(s, in_scope, needing, ename, wc), edp_etawrap_arms(arms, in_scope, needing, ename, wc)),\n    EWhile(c, b) => EWhile(edp_etawrap_expr(c, in_scope, needing, ename, wc), edp_etawrap_expr(b, in_scope, needing, ename, wc)),\n    EForIn(n, idx, it, b) => EForIn(n, idx, edp_etawrap_expr(it, in_scope, needing, ename, wc), edp_etawrap_expr(b, in_scope, needing, ename, wc)),\n    ELoop(pairs, b) => ELoop(edp_etawrap_pairs(pairs, in_scope, needing, ename, wc), edp_etawrap_expr(b, in_scope, needing, ename, wc)),\n    ELet(n, v, b, off) => ELet(n, edp_etawrap_expr(v, in_scope, needing, ename, wc), edp_etawrap_expr(b, in_scope, needing, ename, wc), off),\n    ELetMut(n, v, b, off) => ELetMut(n, edp_etawrap_expr(v, in_scope, needing, ename, wc), edp_etawrap_expr(b, in_scope, needing, ename, wc), off),\n    ELetRec(n, v, b) => ELetRec(n, edp_etawrap_expr(v, in_scope, needing, ename, wc), edp_etawrap_expr(b, in_scope, needing, ename, wc)),\n    ESeq(a, b) => ESeq(edp_etawrap_expr(a, in_scope, needing, ename, wc), edp_etawrap_expr(b, in_scope, needing, ename, wc)),\n    EBinOp(op, l, r) => EBinOp(op, edp_etawrap_expr(l, in_scope, needing, ename, wc), edp_etawrap_expr(r, in_scope, needing, ename, wc)),\n    EUnaryOp(op, x) => EUnaryOp(op, edp_etawrap_expr(x, in_scope, needing, ename, wc)),\n    EAssign(n, v, c) => EAssign(n, edp_etawrap_expr(v, in_scope, needing, ename, wc), edp_etawrap_expr(c, in_scope, needing, ename, wc)),\n    EAssignOp(op, n, v, c) => EAssignOp(op, n, edp_etawrap_expr(v, in_scope, needing, ename, wc), edp_etawrap_expr(c, in_scope, needing, ename, wc)),\n    EDot(o, f, o1, o2) => EDot(edp_etawrap_expr(o, in_scope, needing, ename, wc), f, o1, o2),\n    ELabeledArg(l, n, v) => ELabeledArg(l, n, edp_etawrap_expr(v, in_scope, needing, ename, wc)),\n    EReturn(x) => EReturn(edp_etawrap_expr(x, in_scope, needing, ename, wc)),\n    EBreak(opt) => EBreak(match opt {\n      Some(x) => Some(edp_etawrap_expr(x, in_scope, needing, ename, wc)),\n      None => None\n    }),\n    EContinue(args) => EContinue(edp_etawrap_exprs(args, in_scope, needing, ename, wc)),\n    ETuple(items) => ETuple(edp_etawrap_exprs(items, in_scope, needing, ename, wc)),\n    EArray(items) => EArray(edp_etawrap_exprs(items, in_scope, needing, ename, wc)),\n    ERecord(n, fields, tas) => ERecord(n, edp_etawrap_pairs(fields, in_scope, needing, ename, wc), tas),\n    EMap(fields) => EMap(edp_etawrap_pairs(fields, in_scope, needing, ename, wc)),\n    ESpread(x) => ESpread(edp_etawrap_expr(x, in_scope, needing, ename, wc)),\n    _ => e\n  }\n}\n\nfn edp_etawrap_exprs(es: Array[Expr], in_scope: Bool, needing: Array[String], ename: String, wc: (Array[Stmt], Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], Array[String], Array[Array[String]])) -> Array[Expr] {\n  for x in es {\n    edp_etawrap_expr(x, in_scope, needing, ename, wc)\n  }\n}\n\nfn edp_etawrap_pairs(pairs: Array[(String, Expr)], in_scope: Bool, needing: Array[String], ename: String, wc: (Array[Stmt], Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], Array[String], Array[Array[String]])) -> Array[(String, Expr)] {\n  for p in pairs {\n    let (n, v) = p\n    (n, edp_etawrap_expr(v, in_scope, needing, ename, wc))\n  }\n}\n\nfn edp_etawrap_arms(arms: Array[(Pat, Expr)], in_scope: Bool, needing: Array[String], ename: String, wc: (Array[Stmt], Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], Array[String], Array[Array[String]])) -> Array[(Pat, Expr)] {\n  for a in arms {\n    let (p, ex) = a\n    (p, edp_etawrap_expr(ex, in_scope, needing, ename, wc))\n  }\n}\n\nfn edp_count_ident_uses(expr: Expr, name: String) -> Int {\n  match expr {\n    EIdent(nm, _) => if nm == name {\n      1\n    } else {\n      0\n    },\n    EFn(_, _, _, _, _, body) => edp_count_ident_uses(body, name),\n    EHandle(body, arms) => edp_count_ident_uses(body, name) + edp_count_ident_uses_arms(arms, name),\n    EIf(c, t, e) => edp_count_ident_uses(c, name) + edp_count_ident_uses(t, name) + edp_count_ident_uses(e, name),\n    EMatch(s, arms) => edp_count_ident_uses(s, name) + edp_count_ident_uses_arms(arms, name),\n    EWhile(c, b) => edp_count_ident_uses(c, name) + edp_count_ident_uses(b, name),\n    EForIn(_, _, it, b) => edp_count_ident_uses(it, name) + edp_count_ident_uses(b, name),\n    ELoop(pairs, b) => edp_count_ident_uses_pairs(pairs, name) + edp_count_ident_uses(b, name),\n    ELet(_, v, b, _) => edp_count_ident_uses(v, name) + edp_count_ident_uses(b, name),\n    ELetMut(_, v, b, _) => edp_count_ident_uses(v, name) + edp_count_ident_uses(b, name),\n    ELetRec(_, v, b) => edp_count_ident_uses(v, name) + edp_count_ident_uses(b, name),\n    ESeq(a, b) => edp_count_ident_uses(a, name) + edp_count_ident_uses(b, name),\n    ECall(callee, args, _) => edp_count_ident_uses(callee, name) + edp_count_ident_uses_exprs(args, name),\n    EBinOp(_, l, r) => edp_count_ident_uses(l, name) + edp_count_ident_uses(r, name),\n    EUnaryOp(_, e2) => edp_count_ident_uses(e2, name),\n    EAssign(_, v, c) => edp_count_ident_uses(v, name) + edp_count_ident_uses(c, name),\n    EAssignOp(_, _, v, c) => edp_count_ident_uses(v, name) + edp_count_ident_uses(c, name),\n    EDot(o, _, _, _) => edp_count_ident_uses(o, name),\n    ELabeledArg(_, _, v) => edp_count_ident_uses(v, name),\n    EReturn(e2) => edp_count_ident_uses(e2, name),\n    EBreak(opt) => match opt {\n      Some(e2) => edp_count_ident_uses(e2, name),\n      None => 0\n    },\n    EContinue(args) => edp_count_ident_uses_exprs(args, name),\n    ETuple(elems) => edp_count_ident_uses_exprs(elems, name),\n    EArray(elems) => edp_count_ident_uses_exprs(elems, name),\n    ERecord(_, fields, _) => edp_count_ident_uses_fields(fields, name),\n    EMap(fields) => edp_count_ident_uses_fields(fields, name),\n    ESpread(e2) => edp_count_ident_uses(e2, name),\n    _ => 0\n  }\n}\n\nfn edp_count_ident_uses_exprs(exprs: Array[Expr], name: String) -> Int {\n  let mut total = 0\n  let mut i = 0\n  while i < Array::length(exprs) {\n    total = total + edp_count_ident_uses(Array::get(exprs, i), name)\n    i = i + 1\n  }\n  total\n}\n\nfn edp_count_ident_uses_arms(arms: Array[(Pat, Expr)], name: String) -> Int {\n  let mut total = 0\n  let mut i = 0\n  while i < Array::length(arms) {\n    let (_, ex) = Array::get(arms, i)\n    total = total + edp_count_ident_uses(ex, name)\n    i = i + 1\n  }\n  total\n}\n\nfn edp_count_ident_uses_pairs(pairs: Array[(String, Expr)], name: String) -> Int {\n  let mut total = 0\n  let mut i = 0\n  while i < Array::length(pairs) {\n    let (_, v) = Array::get(pairs, i)\n    total = total + edp_count_ident_uses(v, name)\n    i = i + 1\n  }\n  total\n}\n\nfn edp_count_ident_uses_fields(fields: Array[(String, Expr)], name: String) -> Int {\n  let mut total = 0\n  let mut i = 0\n  while i < Array::length(fields) {\n    let (_, v) = Array::get(fields, i)\n    total = total + edp_count_ident_uses(v, name)\n    i = i + 1\n  }\n  total\n}\n\nfn edp_count_safe_closure_bindings_stmts(stmts: Array[Stmt], xname: String, ename: String, needing: Array[String], pure_fns: Array[String], es_names: Array[String], es_members_list: Array[Array[String]]) -> Int {\n  let mut total = 0\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SLet(_, _, nm, _, expr) => {\n        let self_hit = if nm == xname && edp_efn_eligible_for_migration(expr, ename, needing, pure_fns, es_names, es_members_list) {\n          1\n        } else {\n          0\n        }\n        total = total + self_hit + edp_count_safe_closure_bindings(expr, xname, ename, needing, pure_fns, es_names, es_members_list)\n      },\n      _ => ()\n    }\n    i = i + 1\n  }\n  total\n}\n\nfn edp_count_safe_closure_bindings(expr: Expr, xname: String, ename: String, needing: Array[String], pure_fns: Array[String], es_names: Array[String], es_members_list: Array[Array[String]]) -> Int {\n  match expr {\n    ELet(n, v, b, _) => {\n      let self_hit = if n == xname && edp_efn_eligible_for_migration(v, ename, needing, pure_fns, es_names, es_members_list) {\n        1\n      } else {\n        0\n      }\n      self_hit + edp_count_safe_closure_bindings(v, xname, ename, needing, pure_fns, es_names, es_members_list) + edp_count_safe_closure_bindings(b, xname, ename, needing, pure_fns, es_names, es_members_list)\n    },\n    ELetRec(n, v, b) => {\n      let self_hit = if n == xname && edp_efn_eligible_for_migration(v, ename, needing, pure_fns, es_names, es_members_list) {\n        1\n      } else {\n        0\n      }\n      self_hit + edp_count_safe_closure_bindings(v, xname, ename, needing, pure_fns, es_names, es_members_list) + edp_count_safe_closure_bindings(b, xname, ename, needing, pure_fns, es_names, es_members_list)\n    },\n    EFn(_, _, _, _, _, body) => edp_count_safe_closure_bindings(body, xname, ename, needing, pure_fns, es_names, es_members_list),\n    EHandle(body, arms) => edp_count_safe_closure_bindings(body, xname, ename, needing, pure_fns, es_names, es_members_list) + edp_count_safe_closure_bindings_arms(arms, xname, ename, needing, pure_fns, es_names, es_members_list),\n    EIf(c, t, e) => edp_count_safe_closure_bindings(c, xname, ename, needing, pure_fns, es_names, es_members_list) + edp_count_safe_closure_bindings(t, xname, ename, needing, pure_fns, es_names, es_members_list) + edp_count_safe_closure_bindings(e, xname, ename, needing, pure_fns, es_names, es_members_list),\n    EMatch(s, arms) => edp_count_safe_closure_bindings(s, xname, ename, needing, pure_fns, es_names, es_members_list) + edp_count_safe_closure_bindings_arms(arms, xname, ename, needing, pure_fns, es_names, es_members_list),\n    EWhile(c, b) => edp_count_safe_closure_bindings(c, xname, ename, needing, pure_fns, es_names, es_members_list) + edp_count_safe_closure_bindings(b, xname, ename, needing, pure_fns, es_names, es_members_list),\n    EForIn(_, _, it, b) => edp_count_safe_closure_bindings(it, xname, ename, needing, pure_fns, es_names, es_members_list) + edp_count_safe_closure_bindings(b, xname, ename, needing, pure_fns, es_names, es_members_list),\n    ELoop(pairs, b) => edp_count_safe_closure_bindings_pairs(pairs, xname, ename, needing, pure_fns, es_names, es_members_list) + edp_count_safe_closure_bindings(b, xname, ename, needing, pure_fns, es_names, es_members_list),\n    ELetMut(_, v, b, _) => edp_count_safe_closure_bindings(v, xname, ename, needing, pure_fns, es_names, es_members_list) + edp_count_safe_closure_bindings(b, xname, ename, needing, pure_fns, es_names, es_members_list),\n    ESeq(a, b) => edp_count_safe_closure_bindings(a, xname, ename, needing, pure_fns, es_names, es_members_list) + edp_count_safe_closure_bindings(b, xname, ename, needing, pure_fns, es_names, es_members_list),\n    EAssign(_, v, c) => edp_count_safe_closure_bindings(v, xname, ename, needing, pure_fns, es_names, es_members_list) + edp_count_safe_closure_bindings(c, xname, ename, needing, pure_fns, es_names, es_members_list),\n    EAssignOp(_, _, v, c) => edp_count_safe_closure_bindings(v, xname, ename, needing, pure_fns, es_names, es_members_list) + edp_count_safe_closure_bindings(c, xname, ename, needing, pure_fns, es_names, es_members_list),\n    EDot(o, _, _, _) => edp_count_safe_closure_bindings(o, xname, ename, needing, pure_fns, es_names, es_members_list),\n    ELabeledArg(_, _, v) => edp_count_safe_closure_bindings(v, xname, ename, needing, pure_fns, es_names, es_members_list),\n    EReturn(e2) => edp_count_safe_closure_bindings(e2, xname, ename, needing, pure_fns, es_names, es_members_list),\n    EBreak(opt) => match opt {\n      Some(e2) => edp_count_safe_closure_bindings(e2, xname, ename, needing, pure_fns, es_names, es_members_list),\n      None => 0\n    },\n    ECall(callee, args, _) => edp_count_safe_closure_bindings(callee, xname, ename, needing, pure_fns, es_names, es_members_list) + edp_count_safe_closure_bindings_exprs(args, xname, ename, needing, pure_fns, es_names, es_members_list),\n    EBinOp(_, l, r) => edp_count_safe_closure_bindings(l, xname, ename, needing, pure_fns, es_names, es_members_list) + edp_count_safe_closure_bindings(r, xname, ename, needing, pure_fns, es_names, es_members_list),\n    EUnaryOp(_, e2) => edp_count_safe_closure_bindings(e2, xname, ename, needing, pure_fns, es_names, es_members_list),\n    EContinue(args) => edp_count_safe_closure_bindings_exprs(args, xname, ename, needing, pure_fns, es_names, es_members_list),\n    ETuple(elems) => edp_count_safe_closure_bindings_exprs(elems, xname, ename, needing, pure_fns, es_names, es_members_list),\n    EArray(elems) => edp_count_safe_closure_bindings_exprs(elems, xname, ename, needing, pure_fns, es_names, es_members_list),\n    ERecord(_, fields, _) => edp_count_safe_closure_bindings_fields(fields, xname, ename, needing, pure_fns, es_names, es_members_list),\n    EMap(fields) => edp_count_safe_closure_bindings_fields(fields, xname, ename, needing, pure_fns, es_names, es_members_list),\n    ESpread(e2) => edp_count_safe_closure_bindings(e2, xname, ename, needing, pure_fns, es_names, es_members_list),\n    _ => 0\n  }\n}\n\nfn edp_count_safe_closure_bindings_exprs(exprs: Array[Expr], xname: String, ename: String, needing: Array[String], pure_fns: Array[String], es_names: Array[String], es_members_list: Array[Array[String]]) -> Int {\n  let mut total = 0\n  let mut i = 0\n  while i < Array::length(exprs) {\n    total = total + edp_count_safe_closure_bindings(Array::get(exprs, i), xname, ename, needing, pure_fns, es_names, es_members_list)\n    i = i + 1\n  }\n  total\n}\n\nfn edp_count_safe_closure_bindings_arms(arms: Array[(Pat, Expr)], xname: String, ename: String, needing: Array[String], pure_fns: Array[String], es_names: Array[String], es_members_list: Array[Array[String]]) -> Int {\n  let mut total = 0\n  let mut i = 0\n  while i < Array::length(arms) {\n    let (_, ex) = Array::get(arms, i)\n    total = total + edp_count_safe_closure_bindings(ex, xname, ename, needing, pure_fns, es_names, es_members_list)\n    i = i + 1\n  }\n  total\n}\n\nfn edp_count_safe_closure_bindings_pairs(pairs: Array[(String, Expr)], xname: String, ename: String, needing: Array[String], pure_fns: Array[String], es_names: Array[String], es_members_list: Array[Array[String]]) -> Int {\n  let mut total = 0\n  let mut i = 0\n  while i < Array::length(pairs) {\n    let (_, v) = Array::get(pairs, i)\n    total = total + edp_count_safe_closure_bindings(v, xname, ename, needing, pure_fns, es_names, es_members_list)\n    i = i + 1\n  }\n  total\n}\n\nfn edp_count_safe_closure_bindings_fields(fields: Array[(String, Expr)], xname: String, ename: String, needing: Array[String], pure_fns: Array[String], es_names: Array[String], es_members_list: Array[Array[String]]) -> Int {\n  let mut total = 0\n  let mut i = 0\n  while i < Array::length(fields) {\n    let (_, v) = Array::get(fields, i)\n    total = total + edp_count_safe_closure_bindings(v, xname, ename, needing, pure_fns, es_names, es_members_list)\n    i = i + 1\n  }\n  total\n}\n\nfn edp_collect_ecall_arg_idents(stmts: Array[Stmt], gname: String, argpos: Int) -> Array[String] {\n  let out = array_empty()\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SLet(_, _, _, _, expr) => edp_collect_ecall_arg_idents_expr(expr, gname, argpos, out),\n      SLetMut(_, _, expr) => edp_collect_ecall_arg_idents_expr(expr, gname, argpos, out),\n      SExpr(expr) => edp_collect_ecall_arg_idents_expr(expr, gname, argpos, out),\n      STest(_, expr) => edp_collect_ecall_arg_idents_expr(expr, gname, argpos, out),\n      SBench(_, expr) => edp_collect_ecall_arg_idents_expr(expr, gname, argpos, out),\n      _ => ()\n    }\n    i = i + 1\n  }\n  out\n}\n\nfn edp_collect_ecall_arg_idents_expr(expr: Expr, gname: String, argpos: Int, out: Array[String]) -> Unit {\n  match expr {\n    ECall(callee, args, _) => {\n      match callee {\n        EIdent(nm, _) => if nm == gname {\n          if Array::length(args) > argpos {\n            match Array::get(args, argpos) {\n              EIdent(xn, _) => Array::push(out, xn),\n              _ => Array::push(out, \"##edp_unsafe##\")\n            }\n          } else {\n            Array::push(out, \"##edp_unsafe##\")\n          }\n        } else {\n          ()\n        },\n        _ => ()\n      }\n      edp_collect_ecall_arg_idents_expr(callee, gname, argpos, out)\n      edp_collect_ecall_arg_idents_exprs(args, gname, argpos, out)\n    },\n    EFn(_, _, _, _, _, body) => edp_collect_ecall_arg_idents_expr(body, gname, argpos, out),\n    EHandle(body, arms) => {\n      edp_collect_ecall_arg_idents_expr(body, gname, argpos, out)\n      edp_collect_ecall_arg_idents_arms(arms, gname, argpos, out)\n    },\n    EIf(c, t, e) => {\n      edp_collect_ecall_arg_idents_expr(c, gname, argpos, out)\n      edp_collect_ecall_arg_idents_expr(t, gname, argpos, out)\n      edp_collect_ecall_arg_idents_expr(e, gname, argpos, out)\n    },\n    EMatch(s, arms) => {\n      edp_collect_ecall_arg_idents_expr(s, gname, argpos, out)\n      edp_collect_ecall_arg_idents_arms(arms, gname, argpos, out)\n    },\n    EWhile(c, b) => {\n      edp_collect_ecall_arg_idents_expr(c, gname, argpos, out)\n      edp_collect_ecall_arg_idents_expr(b, gname, argpos, out)\n    },\n    EForIn(_, _, it, b) => {\n      edp_collect_ecall_arg_idents_expr(it, gname, argpos, out)\n      edp_collect_ecall_arg_idents_expr(b, gname, argpos, out)\n    },\n    ELoop(pairs, b) => {\n      let mut i = 0\n      while i < Array::length(pairs) {\n        let (_, v) = Array::get(pairs, i)\n        edp_collect_ecall_arg_idents_expr(v, gname, argpos, out)\n        i = i + 1\n      }\n      edp_collect_ecall_arg_idents_expr(b, gname, argpos, out)\n    },\n    ELet(_, v, b, _) => {\n      edp_collect_ecall_arg_idents_expr(v, gname, argpos, out)\n      edp_collect_ecall_arg_idents_expr(b, gname, argpos, out)\n    },\n    ELetMut(_, v, b, _) => {\n      edp_collect_ecall_arg_idents_expr(v, gname, argpos, out)\n      edp_collect_ecall_arg_idents_expr(b, gname, argpos, out)\n    },\n    ELetRec(_, v, b) => {\n      edp_collect_ecall_arg_idents_expr(v, gname, argpos, out)\n      edp_collect_ecall_arg_idents_expr(b, gname, argpos, out)\n    },\n    ESeq(a, b) => {\n      edp_collect_ecall_arg_idents_expr(a, gname, argpos, out)\n      edp_collect_ecall_arg_idents_expr(b, gname, argpos, out)\n    },\n    EBinOp(_, l, r) => {\n      edp_collect_ecall_arg_idents_expr(l, gname, argpos, out)\n      edp_collect_ecall_arg_idents_expr(r, gname, argpos, out)\n    },\n    EUnaryOp(_, e2) => edp_collect_ecall_arg_idents_expr(e2, gname, argpos, out),\n    EAssign(_, v, c) => {\n      edp_collect_ecall_arg_idents_expr(v, gname, argpos, out)\n      edp_collect_ecall_arg_idents_expr(c, gname, argpos, out)\n    },\n    EAssignOp(_, _, v, c) => {\n      edp_collect_ecall_arg_idents_expr(v, gname, argpos, out)\n      edp_collect_ecall_arg_idents_expr(c, gname, argpos, out)\n    },\n    EDot(o, _, _, _) => edp_collect_ecall_arg_idents_expr(o, gname, argpos, out),\n    ELabeledArg(_, _, v) => edp_collect_ecall_arg_idents_expr(v, gname, argpos, out),\n    EReturn(e2) => edp_collect_ecall_arg_idents_expr(e2, gname, argpos, out),\n    EBreak(opt) => match opt {\n      Some(e2) => edp_collect_ecall_arg_idents_expr(e2, gname, argpos, out),\n      None => ()\n    },\n    EContinue(args) => edp_collect_ecall_arg_idents_exprs(args, gname, argpos, out),\n    ETuple(elems) => edp_collect_ecall_arg_idents_exprs(elems, gname, argpos, out),\n    EArray(elems) => edp_collect_ecall_arg_idents_exprs(elems, gname, argpos, out),\n    ERecord(_, fields, _) => {\n      let mut i = 0\n      while i < Array::length(fields) {\n        let (_, v) = Array::get(fields, i)\n        edp_collect_ecall_arg_idents_expr(v, gname, argpos, out)\n        i = i + 1\n      }\n    },\n    EMap(fields) => {\n      let mut i = 0\n      while i < Array::length(fields) {\n        let (_, v) = Array::get(fields, i)\n        edp_collect_ecall_arg_idents_expr(v, gname, argpos, out)\n        i = i + 1\n      }\n    },\n    ESpread(e2) => edp_collect_ecall_arg_idents_expr(e2, gname, argpos, out),\n    _ => ()\n  }\n}\n\nfn edp_collect_ecall_arg_idents_exprs(exprs: Array[Expr], gname: String, argpos: Int, out: Array[String]) -> Unit {\n  let mut i = 0\n  while i < Array::length(exprs) {\n    edp_collect_ecall_arg_idents_expr(Array::get(exprs, i), gname, argpos, out)\n    i = i + 1\n  }\n}\n\nfn edp_collect_ecall_arg_idents_arms(arms: Array[(Pat, Expr)], gname: String, argpos: Int, out: Array[String]) -> Unit {\n  let mut i = 0\n  while i < Array::length(arms) {\n    let (_, ex) = Array::get(arms, i)\n    edp_collect_ecall_arg_idents_expr(ex, gname, argpos, out)\n    i = i + 1\n  }\n}\n\nfn edp_closure_param_universally_safe(stmts: Array[Stmt], gname: String, pi: Int, ename: String, needing: Array[String], pure_fns: Array[String], es_names: Array[String], es_members_list: Array[Array[String]]) -> Bool {\n  let candidates = edp_collect_ecall_arg_idents(stmts, gname, pi)\n  let mut i = 0\n  let mut ok = true\n  while i < Array::length(candidates) {\n    let xn = Array::get(candidates, i)\n    if xn == \"##edp_unsafe##\" {\n      ok = false\n    } else if edp_count_ident_uses_stmts(stmts, xn) != 1 {\n      ok = false\n    } else if edp_count_safe_closure_bindings_stmts(stmts, xn, ename, needing, pure_fns, es_names, es_members_list) < 1 {\n      ok = false\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  ok\n}\n\nfn edp_own_closure_params(stmts: Array[Stmt], gname: String, gparams: Array[(String, Option[TypeExpr])], ename: String, needing: Array[String], pure_fns: Array[String], es_names: Array[String], es_members_list: Array[Array[String]]) -> Array[(String, Int)] {\n  let out = array_empty()\n  let mut pi = 0\n  while pi < Array::length(gparams) {\n    let (pname, pty) = Array::get(gparams, pi)\n    if edp_type_is_fn_row_exactly(pty, ename, es_names, es_members_list) && edp_closure_param_universally_safe(stmts, gname, pi, ename, needing, pure_fns, es_names, es_members_list) {\n      Array::push(out, (edp_strip_tilde(pname), pi))\n    } else {\n      ()\n    }\n    pi = pi + 1\n  }\n  out\n}\n\nfn edp_closure_param_names_only(pairs: Array[(String, Int)]) -> Array[String] {\n  for p in pairs {\n    let (n, _) = p\n    n\n  }\n}\n\n\nfn edp_count_direct_calls(expr: Expr, name: String) -> Int {\n  match expr {\n    ECall(callee, args, _) => {\n      let self_hit = match callee {\n        EIdent(nm, _) => if nm == name {\n          1\n        } else {\n          0\n        },\n        _ => edp_count_direct_calls(callee, name)\n      }\n      self_hit + edp_count_direct_calls_exprs(args, name)\n    },\n    EFn(_, _, _, _, _, body) => edp_count_direct_calls(body, name),\n    EHandle(body, arms) => edp_count_direct_calls(body, name) + edp_count_direct_calls_arms(arms, name),\n    EIf(c, t, e) => edp_count_direct_calls(c, name) + edp_count_direct_calls(t, name) + edp_count_direct_calls(e, name),\n    EMatch(s, arms) => edp_count_direct_calls(s, name) + edp_count_direct_calls_arms(arms, name),\n    EWhile(c, b) => edp_count_direct_calls(c, name) + edp_count_direct_calls(b, name),\n    EForIn(_, _, it, b) => edp_count_direct_calls(it, name) + edp_count_direct_calls(b, name),\n    ELoop(pairs, b) => {\n      let mut total = 0\n      let mut i = 0\n      while i < Array::length(pairs) {\n        let (_, v) = Array::get(pairs, i)\n        total = total + edp_count_direct_calls(v, name)\n        i = i + 1\n      }\n      total + edp_count_direct_calls(b, name)\n    },\n    ELet(_, v, b, _) => edp_count_direct_calls(v, name) + edp_count_direct_calls(b, name),\n    ELetMut(_, v, b, _) => edp_count_direct_calls(v, name) + edp_count_direct_calls(b, name),\n    ELetRec(_, v, b) => edp_count_direct_calls(v, name) + edp_count_direct_calls(b, name),\n    ESeq(a, b) => edp_count_direct_calls(a, name) + edp_count_direct_calls(b, name),\n    EBinOp(_, l, r) => edp_count_direct_calls(l, name) + edp_count_direct_calls(r, name),\n    EUnaryOp(_, e2) => edp_count_direct_calls(e2, name),\n    EAssign(_, v, c) => edp_count_direct_calls(v, name) + edp_count_direct_calls(c, name),\n    EAssignOp(_, _, v, c) => edp_count_direct_calls(v, name) + edp_count_direct_calls(c, name),\n    EDot(o, _, _, _) => edp_count_direct_calls(o, name),\n    ELabeledArg(_, _, v) => edp_count_direct_calls(v, name),\n    EReturn(e2) => edp_count_direct_calls(e2, name),\n    EBreak(opt) => match opt {\n      Some(e2) => edp_count_direct_calls(e2, name),\n      None => 0\n    },\n    EContinue(args) => edp_count_direct_calls_exprs(args, name),\n    ETuple(elems) => edp_count_direct_calls_exprs(elems, name),\n    EArray(elems) => edp_count_direct_calls_exprs(elems, name),\n    ERecord(_, fields, _) => edp_count_direct_calls_fields(fields, name),\n    EMap(fields) => edp_count_direct_calls_fields(fields, name),\n    ESpread(e2) => edp_count_direct_calls(e2, name),\n    _ => 0\n  }\n}\n\nfn edp_count_direct_calls_exprs(exprs: Array[Expr], name: String) -> Int {\n  let mut total = 0\n  let mut i = 0\n  while i < Array::length(exprs) {\n    total = total + edp_count_direct_calls(Array::get(exprs, i), name)\n    i = i + 1\n  }\n  total\n}\n\nfn edp_count_direct_calls_arms(arms: Array[(Pat, Expr)], name: String) -> Int {\n  let mut total = 0\n  let mut i = 0\n  while i < Array::length(arms) {\n    let (_, ex) = Array::get(arms, i)\n    total = total + edp_count_direct_calls(ex, name)\n    i = i + 1\n  }\n  total\n}\n\nfn edp_count_direct_calls_fields(fields: Array[(String, Expr)], name: String) -> Int {\n  let mut total = 0\n  let mut i = 0\n  while i < Array::length(fields) {\n    let (_, v) = Array::get(fields, i)\n    total = total + edp_count_direct_calls(v, name)\n    i = i + 1\n  }\n  total\n}\n\nfn edp_count_direct_calls_stmts(stmts: Array[Stmt], name: String) -> Int {\n  let mut total = 0\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SLet(_, _, _, _, expr) => {\n        total = total + edp_count_direct_calls(expr, name)\n      },\n      _ => ()\n    }\n    i = i + 1\n  }\n  total\n}\n\nfn edp_fn_used_as_value(stmts: Array[Stmt], fname: String) -> Bool {\n  edp_count_ident_uses_stmts(stmts, fname) > edp_count_direct_calls_stmts(stmts, fname)\n}\n\nfn edp_param_uses_confined_to_handle_calls(body: Expr, pname: String, ename: String) -> Bool {\n  let total = edp_count_ident_uses(body, pname)\n  let sites = array_empty()\n  edp_collect_handle_sites_expr(body, ename, sites)\n  let mut uses_in = 0\n  let mut calls_in = 0\n  let mut i = 0\n  while i < Array::length(sites) {\n    let (hb, _) = Array::get(sites, i)\n    uses_in = uses_in + edp_count_ident_uses(hb, pname)\n    calls_in = calls_in + edp_count_direct_calls(hb, pname)\n    i = i + 1\n  }\n  total > 0 && total == uses_in && uses_in == calls_in\n}\n\nfn edp_handle_owner_cps(stmts: Array[Stmt], fname: String, fparams: Array[(String, Option[TypeExpr])], fbody: Expr, ename: String, needing: Array[String], pure_fns: Array[String], es_names: Array[String], es_members_list: Array[Array[String]]) -> Array[(String, Int)] {\n  let out = array_empty()\n  let mut has_row_param = false\n  let mut hp = 0\n  while hp < Array::length(fparams) {\n    let (_, hpty) = Array::get(fparams, hp)\n    if edp_type_is_fn_row_exactly(hpty, ename, es_names, es_members_list) {\n      has_row_param = true\n    } else {\n      ()\n    }\n    hp = hp + 1\n  }\n  if !has_row_param || edp_str_array_contains(needing, fname) {\n    out\n  } else {\n    let local_ok = array_empty()\n    let mut pi = 0\n    while pi < Array::length(fparams) {\n      let (pname_raw, pty) = Array::get(fparams, pi)\n      let pname = edp_strip_tilde(pname_raw)\n      if edp_type_is_fn_row_exactly(pty, ename, es_names, es_members_list) && !edp_expr_binds_name(fbody, pname) && edp_param_uses_confined_to_handle_calls(fbody, pname, ename) {\n        Array::push(local_ok, (pname, pi))\n      } else {\n        ()\n      }\n      pi = pi + 1\n    }\n    if Array::length(local_ok) == 0 {\n      out\n    } else if edp_fn_used_as_value(stmts, fname) {\n      out\n    } else {\n      let mut li = 0\n      while li < Array::length(local_ok) {\n        let (pname, ppos) = Array::get(local_ok, li)\n        if edp_closure_param_universally_safe(stmts, fname, ppos, ename, needing, pure_fns, es_names, es_members_list) {\n          Array::push(out, (pname, ppos))\n        } else {\n          ()\n        }\n        li = li + 1\n      }\n      out\n    }\n  }\n}\n\nfn edp_sweep_row_lits_stmts(stmts: Array[Stmt], ename: String, dict_pname: String, call_safe: Array[String], es_names: Array[String], es_members_list: Array[Array[String]]) -> Unit {\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SLet(exported, is_rec, nm, ty, expr) => match expr {\n        EFn(tps, tbs, params, ret, eff, fb) => Array::set(stmts, i, SLet(exported, is_rec, nm, ty, EFn(tps, tbs, params, ret, eff, edp_sweep_row_lits_expr(fb, ename, dict_pname, call_safe, es_names, es_members_list)))),\n        _ => Array::set(stmts, i, SLet(exported, is_rec, nm, ty, edp_sweep_row_lits_expr(expr, ename, dict_pname, call_safe, es_names, es_members_list)))\n      },\n      SLetMut(nm, ty, expr) => Array::set(stmts, i, SLetMut(nm, ty, edp_sweep_row_lits_expr(expr, ename, dict_pname, call_safe, es_names, es_members_list))),\n      SExpr(expr) => Array::set(stmts, i, SExpr(edp_sweep_row_lits_expr(expr, ename, dict_pname, call_safe, es_names, es_members_list))),\n      STest(tn, expr) => Array::set(stmts, i, STest(tn, edp_sweep_row_lits_expr(expr, ename, dict_pname, call_safe, es_names, es_members_list))),\n      SBench(bn, expr) => Array::set(stmts, i, SBench(bn, edp_sweep_row_lits_expr(expr, ename, dict_pname, call_safe, es_names, es_members_list))),\n      _ => ()\n    }\n    i = i + 1\n  }\n}\n\nfn edp_sweep_row_lits_expr(e: Expr, ename: String, dict_pname: String, call_safe: Array[String], es_names: Array[String], es_members_list: Array[Array[String]]) -> Expr {\n  match e {\n    EFn(tps, tbs, params, ret, eff, body) => {\n      let body2 = edp_sweep_row_lits_expr(body, ename, dict_pname, call_safe, es_names, es_members_list)\n      let node2 = EFn(tps, tbs, params, ret, eff, body2)\n      if edp_efn_row_carries(node2, ename, es_names, es_members_list) {\n        let lsafe = Array::concat(call_safe, edp_row_typed_param_names(params, ename, es_names, es_members_list))\n        let new_params = Array::concat([\n          (dict_pname, Some(TyName(edp_dict_struct_name(ename))))\n        ], params)\n        EFn(tps, tbs, new_params, ret, eff, edp_rewrite_needing_body(body2, ename, dict_pname, lsafe))\n      } else {\n        node2\n      }\n    },\n    ELet(n, v, b, off) => ELet(n, edp_sweep_row_lits_expr(v, ename, dict_pname, call_safe, es_names, es_members_list), edp_sweep_row_lits_expr(b, ename, dict_pname, call_safe, es_names, es_members_list), off),\n    ELetRec(n, v, b) => ELetRec(n, edp_sweep_row_lits_expr(v, ename, dict_pname, call_safe, es_names, es_members_list), edp_sweep_row_lits_expr(b, ename, dict_pname, call_safe, es_names, es_members_list)),\n    ELetMut(n, v, b, off) => ELetMut(n, edp_sweep_row_lits_expr(v, ename, dict_pname, call_safe, es_names, es_members_list), edp_sweep_row_lits_expr(b, ename, dict_pname, call_safe, es_names, es_members_list), off),\n    ESeq(a, b) => ESeq(edp_sweep_row_lits_expr(a, ename, dict_pname, call_safe, es_names, es_members_list), edp_sweep_row_lits_expr(b, ename, dict_pname, call_safe, es_names, es_members_list)),\n    EIf(c, t, el) => EIf(edp_sweep_row_lits_expr(c, ename, dict_pname, call_safe, es_names, es_members_list), edp_sweep_row_lits_expr(t, ename, dict_pname, call_safe, es_names, es_members_list), edp_sweep_row_lits_expr(el, ename, dict_pname, call_safe, es_names, es_members_list)),\n    EMatch(sc, arms) => EMatch(edp_sweep_row_lits_expr(sc, ename, dict_pname, call_safe, es_names, es_members_list), for a in arms {\n      let (pp, ex) = a\n      (pp, edp_sweep_row_lits_expr(ex, ename, dict_pname, call_safe, es_names, es_members_list))\n    }),\n    EHandle(bd, arms) => EHandle(edp_sweep_row_lits_expr(bd, ename, dict_pname, call_safe, es_names, es_members_list), for a in arms {\n      let (pp, ex) = a\n      (pp, edp_sweep_row_lits_expr(ex, ename, dict_pname, call_safe, es_names, es_members_list))\n    }),\n    ECall(callee, args, off) => ECall(edp_sweep_row_lits_expr(callee, ename, dict_pname, call_safe, es_names, es_members_list), for a in args {\n      edp_sweep_row_lits_expr(a, ename, dict_pname, call_safe, es_names, es_members_list)\n    }, off),\n    EWhile(c, b) => EWhile(edp_sweep_row_lits_expr(c, ename, dict_pname, call_safe, es_names, es_members_list), edp_sweep_row_lits_expr(b, ename, dict_pname, call_safe, es_names, es_members_list)),\n    EForIn(n, idx, it, b) => EForIn(n, idx, edp_sweep_row_lits_expr(it, ename, dict_pname, call_safe, es_names, es_members_list), edp_sweep_row_lits_expr(b, ename, dict_pname, call_safe, es_names, es_members_list)),\n    ELoop(pairs, b) => ELoop(for pr in pairs {\n      let (n, v) = pr\n      (n, edp_sweep_row_lits_expr(v, ename, dict_pname, call_safe, es_names, es_members_list))\n    }, edp_sweep_row_lits_expr(b, ename, dict_pname, call_safe, es_names, es_members_list)),\n    EBinOp(op, l, r) => EBinOp(op, edp_sweep_row_lits_expr(l, ename, dict_pname, call_safe, es_names, es_members_list), edp_sweep_row_lits_expr(r, ename, dict_pname, call_safe, es_names, es_members_list)),\n    EUnaryOp(op, x) => EUnaryOp(op, edp_sweep_row_lits_expr(x, ename, dict_pname, call_safe, es_names, es_members_list)),\n    EAssign(n, v, c) => EAssign(n, edp_sweep_row_lits_expr(v, ename, dict_pname, call_safe, es_names, es_members_list), edp_sweep_row_lits_expr(c, ename, dict_pname, call_safe, es_names, es_members_list)),\n    EAssignOp(n, op, v, c) => EAssignOp(n, op, edp_sweep_row_lits_expr(v, ename, dict_pname, call_safe, es_names, es_members_list), edp_sweep_row_lits_expr(c, ename, dict_pname, call_safe, es_names, es_members_list)),\n    EReturn(x) => EReturn(edp_sweep_row_lits_expr(x, ename, dict_pname, call_safe, es_names, es_members_list)),\n    EDot(o, f, o1, o2) => EDot(edp_sweep_row_lits_expr(o, ename, dict_pname, call_safe, es_names, es_members_list), f, o1, o2),\n    ELabeledArg(l, n, v) => ELabeledArg(l, n, edp_sweep_row_lits_expr(v, ename, dict_pname, call_safe, es_names, es_members_list)),\n    EBreak(opt) => EBreak(match opt {\n      Some(x) => Some(edp_sweep_row_lits_expr(x, ename, dict_pname, call_safe, es_names, es_members_list)),\n      None => None\n    }),\n    EContinue(args) => EContinue(for a in args {\n      edp_sweep_row_lits_expr(a, ename, dict_pname, call_safe, es_names, es_members_list)\n    }),\n    ETuple(items) => ETuple(for a in items {\n      edp_sweep_row_lits_expr(a, ename, dict_pname, call_safe, es_names, es_members_list)\n    }),\n    EArray(items) => EArray(for a in items {\n      edp_sweep_row_lits_expr(a, ename, dict_pname, call_safe, es_names, es_members_list)\n    }),\n    ERecord(n, fields, tas) => ERecord(n, for f in fields {\n      let (fn2, v) = f\n      (fn2, edp_sweep_row_lits_expr(v, ename, dict_pname, call_safe, es_names, es_members_list))\n    }, tas),\n    EMap(fields) => EMap(for f in fields {\n      let (fn2, v) = f\n      (fn2, edp_sweep_row_lits_expr(v, ename, dict_pname, call_safe, es_names, es_members_list))\n    }),\n    ESpread(x) => ESpread(edp_sweep_row_lits_expr(x, ename, dict_pname, call_safe, es_names, es_members_list)),\n    _ => e\n  }\n}\n\nfn edp_maybe_migrate_efn(expr: Expr, ename: String, dict_pname: String, needing: Array[String], pure_fns: Array[String], es_names: Array[String], es_members_list: Array[Array[String]]) -> Option[Expr] {\n  match expr {\n    EFn(tps, tbs, params, ret, eff, body) => if edp_params_have_dict(params, dict_pname) {\n      None\n    } else if edp_efn_eligible_for_migration(expr, ename, needing, pure_fns, es_names, es_members_list) {\n      let new_params = Array::concat([\n        (dict_pname, Some(TyName(edp_dict_struct_name(ename))))\n      ], params)\n      let new_body = edp_rewrite_needing_body(body, ename, dict_pname, needing)\n      Some(EFn(tps, tbs, new_params, ret, eff, new_body))\n    } else {\n      None\n    },\n    _ => None\n  }\n}\n\nfn edp_migrate_closure_binding_stmts(stmts: Array[Stmt], xname: String, ename: String, dict_pname: String, needing: Array[String], pure_fns: Array[String], es_names: Array[String], es_members_list: Array[Array[String]]) -> Unit {\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SLet(exported, is_rec, nm, ty, expr) => if nm == xname {\n        match edp_maybe_migrate_efn(expr, ename, dict_pname, needing, pure_fns, es_names, es_members_list) {\n          Some(new_expr) => Array::set(stmts, i, SLet(exported, is_rec, nm, ty, new_expr)),\n          None => ()\n        }\n      } else {\n        Array::set(stmts, i, SLet(exported, is_rec, nm, ty, edp_migrate_closure_binding_expr(expr, xname, ename, dict_pname, needing, pure_fns, es_names, es_members_list)))\n      },\n      SLetMut(nm2, ty2, expr) => Array::set(stmts, i, SLetMut(nm2, ty2, edp_migrate_closure_binding_expr(expr, xname, ename, dict_pname, needing, pure_fns, es_names, es_members_list))),\n      SExpr(expr) => Array::set(stmts, i, SExpr(edp_migrate_closure_binding_expr(expr, xname, ename, dict_pname, needing, pure_fns, es_names, es_members_list))),\n      STest(tn, expr) => Array::set(stmts, i, STest(tn, edp_migrate_closure_binding_expr(expr, xname, ename, dict_pname, needing, pure_fns, es_names, es_members_list))),\n      SBench(bn, expr) => Array::set(stmts, i, SBench(bn, edp_migrate_closure_binding_expr(expr, xname, ename, dict_pname, needing, pure_fns, es_names, es_members_list))),\n      _ => ()\n    }\n    i = i + 1\n  }\n}\n\nfn edp_migrate_closure_binding_expr(expr: Expr, xname: String, ename: String, dict_pname: String, needing: Array[String], pure_fns: Array[String], es_names: Array[String], es_members_list: Array[Array[String]]) -> Expr {\n  match expr {\n    ELet(n, v, b, off) => if n == xname {\n      match edp_maybe_migrate_efn(v, ename, dict_pname, needing, pure_fns, es_names, es_members_list) {\n        Some(nv) => ELet(n, nv, edp_migrate_closure_binding_expr(b, xname, ename, dict_pname, needing, pure_fns, es_names, es_members_list), off),\n        None => ELet(n, edp_migrate_closure_binding_expr(v, xname, ename, dict_pname, needing, pure_fns, es_names, es_members_list), edp_migrate_closure_binding_expr(b, xname, ename, dict_pname, needing, pure_fns, es_names, es_members_list), off)\n      }\n    } else {\n      ELet(n, edp_migrate_closure_binding_expr(v, xname, ename, dict_pname, needing, pure_fns, es_names, es_members_list), edp_migrate_closure_binding_expr(b, xname, ename, dict_pname, needing, pure_fns, es_names, es_members_list), off)\n    },\n    ELetRec(n, v, b) => if n == xname {\n      match edp_maybe_migrate_efn(v, ename, dict_pname, needing, pure_fns, es_names, es_members_list) {\n        Some(nv) => ELetRec(n, nv, edp_migrate_closure_binding_expr(b, xname, ename, dict_pname, needing, pure_fns, es_names, es_members_list)),\n        None => ELetRec(n, edp_migrate_closure_binding_expr(v, xname, ename, dict_pname, needing, pure_fns, es_names, es_members_list), edp_migrate_closure_binding_expr(b, xname, ename, dict_pname, needing, pure_fns, es_names, es_members_list))\n      }\n    } else {\n      ELetRec(n, edp_migrate_closure_binding_expr(v, xname, ename, dict_pname, needing, pure_fns, es_names, es_members_list), edp_migrate_closure_binding_expr(b, xname, ename, dict_pname, needing, pure_fns, es_names, es_members_list))\n    },\n    EFn(tps, tbs, params, ret, eff, body) => EFn(tps, tbs, params, ret, eff, edp_migrate_closure_binding_expr(body, xname, ename, dict_pname, needing, pure_fns, es_names, es_members_list)),\n    EHandle(body, arms) => EHandle(edp_migrate_closure_binding_expr(body, xname, ename, dict_pname, needing, pure_fns, es_names, es_members_list), for a in arms {\n      let (p, ex) = a\n      (p, edp_migrate_closure_binding_expr(ex, xname, ename, dict_pname, needing, pure_fns, es_names, es_members_list))\n    }),\n    EIf(c, t, e) => EIf(edp_migrate_closure_binding_expr(c, xname, ename, dict_pname, needing, pure_fns, es_names, es_members_list), edp_migrate_closure_binding_expr(t, xname, ename, dict_pname, needing, pure_fns, es_names, es_members_list), edp_migrate_closure_binding_expr(e, xname, ename, dict_pname, needing, pure_fns, es_names, es_members_list)),\n    EMatch(s, arms) => EMatch(edp_migrate_closure_binding_expr(s, xname, ename, dict_pname, needing, pure_fns, es_names, es_members_list), for a in arms {\n      let (p, ex) = a\n      (p, edp_migrate_closure_binding_expr(ex, xname, ename, dict_pname, needing, pure_fns, es_names, es_members_list))\n    }),\n    EWhile(c, b) => EWhile(edp_migrate_closure_binding_expr(c, xname, ename, dict_pname, needing, pure_fns, es_names, es_members_list), edp_migrate_closure_binding_expr(b, xname, ename, dict_pname, needing, pure_fns, es_names, es_members_list)),\n    EForIn(n, idx, it, b) => EForIn(n, idx, edp_migrate_closure_binding_expr(it, xname, ename, dict_pname, needing, pure_fns, es_names, es_members_list), edp_migrate_closure_binding_expr(b, xname, ename, dict_pname, needing, pure_fns, es_names, es_members_list)),\n    ELoop(pairs, b) => ELoop(for p in pairs {\n      let (n, v) = p\n      (n, edp_migrate_closure_binding_expr(v, xname, ename, dict_pname, needing, pure_fns, es_names, es_members_list))\n    }, edp_migrate_closure_binding_expr(b, xname, ename, dict_pname, needing, pure_fns, es_names, es_members_list)),\n    ELetMut(n, v, b, off) => ELetMut(n, edp_migrate_closure_binding_expr(v, xname, ename, dict_pname, needing, pure_fns, es_names, es_members_list), edp_migrate_closure_binding_expr(b, xname, ename, dict_pname, needing, pure_fns, es_names, es_members_list), off),\n    ESeq(a, b) => ESeq(edp_migrate_closure_binding_expr(a, xname, ename, dict_pname, needing, pure_fns, es_names, es_members_list), edp_migrate_closure_binding_expr(b, xname, ename, dict_pname, needing, pure_fns, es_names, es_members_list)),\n    EAssign(n, v, c) => EAssign(n, edp_migrate_closure_binding_expr(v, xname, ename, dict_pname, needing, pure_fns, es_names, es_members_list), edp_migrate_closure_binding_expr(c, xname, ename, dict_pname, needing, pure_fns, es_names, es_members_list)),\n    EAssignOp(n, op, v, c) => EAssignOp(n, op, edp_migrate_closure_binding_expr(v, xname, ename, dict_pname, needing, pure_fns, es_names, es_members_list), edp_migrate_closure_binding_expr(c, xname, ename, dict_pname, needing, pure_fns, es_names, es_members_list)),\n    EDot(o, f, off1, off2) => EDot(edp_migrate_closure_binding_expr(o, xname, ename, dict_pname, needing, pure_fns, es_names, es_members_list), f, off1, off2),\n    ECall(callee, args, off) => ECall(callee, for a in args {\n      edp_migrate_closure_binding_expr(a, xname, ename, dict_pname, needing, pure_fns, es_names, es_members_list)\n    }, off),\n    EBinOp(op, l, r) => EBinOp(op, edp_migrate_closure_binding_expr(l, xname, ename, dict_pname, needing, pure_fns, es_names, es_members_list), edp_migrate_closure_binding_expr(r, xname, ename, dict_pname, needing, pure_fns, es_names, es_members_list)),\n    EUnaryOp(op, e2) => EUnaryOp(op, edp_migrate_closure_binding_expr(e2, xname, ename, dict_pname, needing, pure_fns, es_names, es_members_list)),\n    ELabeledArg(l, n, v) => ELabeledArg(l, n, edp_migrate_closure_binding_expr(v, xname, ename, dict_pname, needing, pure_fns, es_names, es_members_list)),\n    EReturn(e2) => EReturn(edp_migrate_closure_binding_expr(e2, xname, ename, dict_pname, needing, pure_fns, es_names, es_members_list)),\n    EBreak(opt) => EBreak(match opt {\n      Some(e2) => Some(edp_migrate_closure_binding_expr(e2, xname, ename, dict_pname, needing, pure_fns, es_names, es_members_list)),\n      None => None\n    }),\n    EContinue(args) => EContinue(for a in args {\n      edp_migrate_closure_binding_expr(a, xname, ename, dict_pname, needing, pure_fns, es_names, es_members_list)\n    }),\n    ETuple(elems) => ETuple(for e2 in elems {\n      edp_migrate_closure_binding_expr(e2, xname, ename, dict_pname, needing, pure_fns, es_names, es_members_list)\n    }),\n    EArray(elems) => EArray(for e2 in elems {\n      edp_migrate_closure_binding_expr(e2, xname, ename, dict_pname, needing, pure_fns, es_names, es_members_list)\n    }),\n    ERecord(n, fields, tas) => ERecord(n, for f in fields {\n      let (fn2, v) = f\n      (fn2, edp_migrate_closure_binding_expr(v, xname, ename, dict_pname, needing, pure_fns, es_names, es_members_list))\n    }, tas),\n    EMap(fields) => EMap(for f in fields {\n      let (fn2, v) = f\n      (fn2, edp_migrate_closure_binding_expr(v, xname, ename, dict_pname, needing, pure_fns, es_names, es_members_list))\n    }),\n    ESpread(e2) => ESpread(edp_migrate_closure_binding_expr(e2, xname, ename, dict_pname, needing, pure_fns, es_names, es_members_list)),\n    _ => expr\n  }\n}\n\n\nfn edp_apply_migration(stmts: Array[Stmt], ename: String, ops: Array[(String, Array[TypeExpr], TypeExpr)], needing: Array[String], handle_sites: Array[(Expr, Array[(Pat, Expr)])], fn_defs: Array[(Int, Bool, Bool, String, Option[TypeExpr], String)]) -> Unit {\n  let dict_pname = edp_dict_param_name(ename)\n  let dict_tyname = edp_dict_struct_name(ename)\n  let pure_fns = edp_pure_fn_names(fn_defs)\n  edp_append_free_host_inert_names(stmts, pure_fns)\n  edp_append_perform_free_row_fns(stmts, fn_defs, ename, pure_fns)\n  let es_names = array_empty()\n  let es_members_list = array_empty()\n  edp_es_collect_into(stmts, es_names, es_members_list)\n  let own_cp_map = array_empty()\n  let mut ni0 = 0\n  while ni0 < Array::length(needing) {\n    let gname = Array::get(needing, ni0)\n    match edp_find_fn_params_and_body(stmts, fn_defs, gname) {\n      Some((gparams, _)) => {\n        let own_cp = edp_own_closure_params(stmts, gname, gparams, ename, needing, pure_fns, es_names, es_members_list)\n        Array::push(own_cp_map, own_cp)\n        let mut cpi = 0\n        while cpi < Array::length(own_cp) {\n          let (_, ppos) = Array::get(own_cp, cpi)\n          let candidates = edp_collect_ecall_arg_idents(stmts, gname, ppos)\n          let mut ci = 0\n          while ci < Array::length(candidates) {\n            let xn = Array::get(candidates, ci)\n            if xn == \"##edp_unsafe##\" || edp_str_array_contains(needing, xn) {\n              ()\n            } else {\n              edp_migrate_closure_binding_stmts(stmts, xn, ename, dict_pname, needing, pure_fns, es_names, es_members_list)\n            }\n            ci = ci + 1\n          }\n          cpi = cpi + 1\n        }\n      },\n      None => Array::push(own_cp_map, array_empty())\n    }\n    ni0 = ni0 + 1\n  }\n  let hcp_by_stmt = array_empty()\n  let mut hsi0 = 0\n  while hsi0 < Array::length(stmts) {\n    match Array::get(stmts, hsi0) {\n      SLet(_, _, snm, _, sval) => match sval {\n        EFn(_, _, sparams, _, _, sbody) => Array::push(hcp_by_stmt, (snm, edp_handle_owner_cps(stmts, snm, sparams, sbody, ename, needing, pure_fns, es_names, es_members_list))),\n        _ => Array::push(hcp_by_stmt, (\"\", array_empty()))\n      },\n      _ => Array::push(hcp_by_stmt, (\"\", array_empty()))\n    }\n    hsi0 = hsi0 + 1\n  }\n  let mut hsi1 = 0\n  while hsi1 < Array::length(hcp_by_stmt) {\n    let (howner, hcps) = Array::get(hcp_by_stmt, hsi1)\n    let mut hcpi = 0\n    while hcpi < Array::length(hcps) {\n      let (_, ppos) = Array::get(hcps, hcpi)\n      let hc_candidates = edp_collect_ecall_arg_idents(stmts, howner, ppos)\n      let mut hci = 0\n      while hci < Array::length(hc_candidates) {\n        let xn = Array::get(hc_candidates, hci)\n        if xn == \"##edp_unsafe##\" || edp_str_array_contains(needing, xn) {\n          ()\n        } else {\n          edp_migrate_closure_binding_stmts(stmts, xn, ename, dict_pname, needing, pure_fns, es_names, es_members_list)\n        }\n        hci = hci + 1\n      }\n      hcpi = hcpi + 1\n    }\n    hsi1 = hsi1 + 1\n  }\n  let td_binds_raw = empty_str_array()\n  let td_lits0 = array_empty()\n  edp_row_lit_scan(stmts, ename, needing, es_names, es_members_list, td_binds_raw, td_lits0)\n  let td_poison0 = empty_str_array()\n  edp_collect_poison_stmts(stmts, ename, needing, es_names, es_members_list, td_poison0)\n  let td_binds = edp_filter_unpoisoned(td_binds_raw, td_poison0)\n  let td_mode = Array::length(td_binds) > 0 || Array::length(td_lits0) > 0 || edp_any_row_typed_param(stmts, fn_defs, ename, es_names, es_members_list)\n  if td_mode {\n    let td_safe = Array::concat(needing, td_binds)\n    edp_sweep_row_lits_stmts(stmts, ename, dict_pname, td_safe, es_names, es_members_list)\n  } else {\n    ()\n  }\n  let mut ni = 0\n  while ni < Array::length(needing) {\n    let nm = Array::get(needing, ni)\n    let own_cp = Array::get(own_cp_map, ni)\n    let tdw = if td_mode {\n      match edp_find_fn_params_and_body(stmts, fn_defs, nm) {\n        Some((gparams2, _)) => Array::concat(td_binds, edp_row_typed_param_names(gparams2, ename, es_names, es_members_list)),\n        None => td_binds\n      }\n    } else {\n      empty_str_array()\n    }\n    let call_safe = Array::concat(Array::concat(needing, edp_closure_param_names_only(own_cp)), tdw)\n    edp_rewrite_needing_fn(stmts, fn_defs, nm, ename, dict_pname, dict_tyname, call_safe)\n    ni = ni + 1\n  }\n  let mut si = 0\n  while si < Array::length(stmts) {\n    match Array::get(stmts, si) {\n      SLet(exported, is_rec, name, ty, expr) => {\n        let (_, hcps2) = Array::get(hcp_by_stmt, si)\n        let tdh = if td_mode {\n          match expr {\n            EFn(_, _, sparams3, _, _, _) => Array::concat(td_binds, edp_row_typed_param_names(sparams3, ename, es_names, es_members_list)),\n            _ => td_binds\n          }\n        } else {\n          empty_str_array()\n        }\n        let needing_h = Array::concat(Array::concat(needing, edp_closure_param_names_only(hcps2)), tdh)\n        Array::set(stmts, si, SLet(exported, is_rec, name, ty, edp_find_rewrite_handles(expr, ename, needing_h)))\n      },\n      SLetMut(nm2, ty2, expr) => {\n        let tdh2 = if td_mode {\n          td_binds\n        } else {\n          empty_str_array()\n        }\n        Array::set(stmts, si, SLetMut(nm2, ty2, edp_find_rewrite_handles(expr, ename, Array::concat(needing, tdh2))))\n      },\n      SExpr(expr) => {\n        let tdh2 = if td_mode {\n          td_binds\n        } else {\n          empty_str_array()\n        }\n        Array::set(stmts, si, SExpr(edp_find_rewrite_handles(expr, ename, Array::concat(needing, tdh2))))\n      },\n      STest(tn2, expr) => {\n        let tdh2 = if td_mode {\n          td_binds\n        } else {\n          empty_str_array()\n        }\n        Array::set(stmts, si, STest(tn2, edp_find_rewrite_handles(expr, ename, Array::concat(needing, tdh2))))\n      },\n      SBench(bn2, expr) => {\n        let tdh2 = if td_mode {\n          td_binds\n        } else {\n          empty_str_array()\n        }\n        Array::set(stmts, si, SBench(bn2, edp_find_rewrite_handles(expr, ename, Array::concat(needing, tdh2))))\n      },\n      _ => ()\n    }\n    si = si + 1\n  }\n  if edp_struct_decl_exists(stmts, dict_tyname) {\n    ()\n  } else {\n    Array::push(stmts, edp_make_dict_struct_stmt(ename, ops))\n  }\n}\n\nfn edp_rewrite_needing_fn(stmts: Array[Stmt], fn_defs: Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], name: String, ename: String, dict_pname: String, dict_tyname: String, needing: Array[String]) -> Unit {\n  let mut i = 0\n  while i < Array::length(fn_defs) {\n    let (idx, exported, is_rec, nm, ty, _) = Array::get(fn_defs, i)\n    if nm == name {\n      match Array::get(stmts, idx) {\n        SLet(_, _, _, _, EFn(tps, tbs, params, ret, eff, body)) => if edp_params_have_dict(params, dict_pname) {\n          ()\n        } else {\n          let new_params = Array::concat([\n            (dict_pname, Some(TyName(dict_tyname)))\n          ], params)\n          let new_body = edp_rewrite_needing_body(body, ename, dict_pname, needing)\n          Array::set(stmts, idx, SLet(exported, is_rec, nm, ty, EFn(tps, tbs, new_params, ret, eff, new_body)))\n        },\n        _ => ()\n      }\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n}\n\nfn edp_rewrite_needing_body(expr: Expr, ename: String, dict_pname: String, needing: Array[String]) -> Expr {\n  match expr {\n    EFn(tps, tbs, params, ret, eff, body) => if edp_params_have_dict(params, dict_pname) {\n      expr\n    } else {\n      EFn(tps, tbs, params, ret, eff, edp_rewrite_needing_body(body, ename, dict_pname, needing))\n    },\n    EHandle(body, arms) => if edp_handle_matches_effect(arms, ename) {\n      expr\n    } else {\n      EHandle(edp_rewrite_needing_body(body, ename, dict_pname, needing), for a in arms {\n        let (p, ex) = a\n        (p, edp_rewrite_needing_body(ex, ename, dict_pname, needing))\n      })\n    },\n    EIf(c, t, e) => EIf(edp_rewrite_needing_body(c, ename, dict_pname, needing), edp_rewrite_needing_body(t, ename, dict_pname, needing), edp_rewrite_needing_body(e, ename, dict_pname, needing)),\n    EMatch(s, arms) => EMatch(edp_rewrite_needing_body(s, ename, dict_pname, needing), for a in arms {\n      let (p, ex) = a\n      (p, edp_rewrite_needing_body(ex, ename, dict_pname, needing))\n    }),\n    EWhile(c, b) => EWhile(edp_rewrite_needing_body(c, ename, dict_pname, needing), edp_rewrite_needing_body(b, ename, dict_pname, needing)),\n    EForIn(n, idx, it, b) => EForIn(n, idx, edp_rewrite_needing_body(it, ename, dict_pname, needing), edp_rewrite_needing_body(b, ename, dict_pname, needing)),\n    ELoop(pairs, b) => ELoop(for p in pairs {\n      let (n, v) = p\n      (n, edp_rewrite_needing_body(v, ename, dict_pname, needing))\n    }, edp_rewrite_needing_body(b, ename, dict_pname, needing)),\n    ELet(n, v, b, off) => ELet(n, edp_rewrite_needing_body(v, ename, dict_pname, needing), edp_rewrite_needing_body(b, ename, dict_pname, needing), off),\n    ELetMut(n, v, b, off) => ELetMut(n, edp_rewrite_needing_body(v, ename, dict_pname, needing), edp_rewrite_needing_body(b, ename, dict_pname, needing), off),\n    ELetRec(n, v, b) => ELetRec(n, edp_rewrite_needing_body(v, ename, dict_pname, needing), edp_rewrite_needing_body(b, ename, dict_pname, needing)),\n    ESeq(a, b) => ESeq(edp_rewrite_needing_body(a, ename, dict_pname, needing), edp_rewrite_needing_body(b, ename, dict_pname, needing)),\n    EAssign(n, v, c) => EAssign(n, edp_rewrite_needing_body(v, ename, dict_pname, needing), edp_rewrite_needing_body(c, ename, dict_pname, needing)),\n    EAssignOp(n, op, v, c) => EAssignOp(n, op, edp_rewrite_needing_body(v, ename, dict_pname, needing), edp_rewrite_needing_body(c, ename, dict_pname, needing)),\n    EReturn(e2) => EReturn(edp_rewrite_needing_body(e2, ename, dict_pname, needing)),\n    EDot(o, f, off1, off2) => EDot(edp_rewrite_needing_body(o, ename, dict_pname, needing), f, off1, off2),\n    ECall(callee, args, off) => match callee {\n      EIdent(nm, _) => if nm == \"perform\" && Array::length(args) == 1 {\n        edp_rewrite_perform_via_dict(Array::get(args, 0), ename, dict_pname, needing)\n      } else if edp_str_array_contains(needing, nm) {\n        ECall(callee, edp_prepend_dict_arg(dict_pname, edp_rewrite_needing_body_exprs(args, ename, dict_pname, needing)), off)\n      } else {\n        ECall(callee, edp_rewrite_needing_body_exprs(args, ename, dict_pname, needing), off)\n      },\n      _ => ECall(callee, edp_rewrite_needing_body_exprs(args, ename, dict_pname, needing), off)\n    },\n    EBinOp(op, l, r) => EBinOp(op, edp_rewrite_needing_body(l, ename, dict_pname, needing), edp_rewrite_needing_body(r, ename, dict_pname, needing)),\n    EUnaryOp(op, e2) => EUnaryOp(op, edp_rewrite_needing_body(e2, ename, dict_pname, needing)),\n    ELabeledArg(l, n, v) => ELabeledArg(l, n, edp_rewrite_needing_body(v, ename, dict_pname, needing)),\n    EBreak(opt) => EBreak(match opt {\n      Some(e2) => Some(edp_rewrite_needing_body(e2, ename, dict_pname, needing)),\n      None => None\n    }),\n    EContinue(args) => EContinue(edp_rewrite_needing_body_exprs(args, ename, dict_pname, needing)),\n    ETuple(elems) => ETuple(edp_rewrite_needing_body_exprs(elems, ename, dict_pname, needing)),\n    EArray(elems) => EArray(edp_rewrite_needing_body_exprs(elems, ename, dict_pname, needing)),\n    ERecord(n, fields, tas) => ERecord(n, for f in fields {\n      let (fn2, v) = f\n      (fn2, edp_rewrite_needing_body(v, ename, dict_pname, needing))\n    }, tas),\n    EMap(fields) => EMap(for f in fields {\n      let (fn2, v) = f\n      (fn2, edp_rewrite_needing_body(v, ename, dict_pname, needing))\n    }),\n    ESpread(e2) => ESpread(edp_rewrite_needing_body(e2, ename, dict_pname, needing)),\n    _ => expr\n  }\n}\n\nfn edp_rewrite_needing_body_exprs(exprs: Array[Expr], ename: String, dict_pname: String, needing: Array[String]) -> Array[Expr] {\n  for e in exprs {\n    edp_rewrite_needing_body(e, ename, dict_pname, needing)\n  }\n}\n\nfn edp_prepend_dict_arg(dict_pname: String, args: Array[Expr]) -> Array[Expr] {\n  Array::concat([\n    EIdent(dict_pname, -1)\n  ], args)\n}\n\nfn edp_qname_is_for_effect(qname: String, ename: String) -> Bool {\n  let (eff_opt, _) = edp_split_qualified(qname)\n  match eff_opt {\n    Some(e) => e == ename,\n    None => false\n  }\n}\n\nfn edp_rewrite_perform_via_dict(operand: Expr, ename: String, dict_pname: String, needing: Array[String]) -> Expr {\n  match operand {\n    EIdent(qname, _) => if edp_qname_is_for_effect(qname, ename) {\n      ECall(EDot(EIdent(dict_pname, -1), edp_strip_effect_prefix(qname, ename), -1, -1), array_empty(), -1)\n    } else {\n      ECall(EIdent(\"perform\", -1), [\n        operand\n      ], -1)\n    },\n    ECall(op_callee, op_args, _) => match op_callee {\n      EIdent(qname, _) => if edp_qname_is_for_effect(qname, ename) {\n        ECall(EDot(EIdent(dict_pname, -1), edp_strip_effect_prefix(qname, ename), -1, -1), edp_rewrite_needing_body_exprs(op_args, ename, dict_pname, needing), -1)\n      } else {\n        ECall(EIdent(\"perform\", -1), [\n          ECall(op_callee, edp_rewrite_needing_body_exprs(op_args, ename, dict_pname, needing), -1)\n        ], -1)\n      },\n      _ => ECall(EIdent(\"perform\", -1), [\n        operand\n      ], -1)\n    },\n    _ => ECall(EIdent(\"perform\", -1), [\n      operand\n    ], -1)\n  }\n}\n\n\nfn edp_rewrite_handle_site(body: Expr, arms: Array[(Pat, Expr)], ename: String, needing: Array[String]) -> Expr {\n  let op_names = for a in arms {\n    let (p, _) = a\n    edp_pat_qname(p)\n  }\n  let bind_names = for a in arms {\n    let (p, _) = a\n    edp_pat_bind_names(p)\n  }\n  let prepared_bodies = for a in arms {\n    let (_, ex) = a\n    edp_strip_tail_resume(ex)\n  }\n  let dict_literal = edp_build_dict_literal(ename, op_names, bind_names, prepared_bodies)\n  edp_rewrite_handle_body(body, ename, op_names, bind_names, prepared_bodies, dict_literal, needing)\n}\n\nfn edp_build_dict_literal(ename: String, op_names: Array[String], bind_names: Array[Array[String]], prepared_bodies: Array[Expr]) -> Expr {\n  let fields = array_empty()\n  let mut i = 0\n  while i < Array::length(op_names) {\n    let bare = edp_strip_effect_prefix(Array::get(op_names, i), ename)\n    let params = for n in Array::get(bind_names, i) {\n      (n, None)\n    }\n    let closure = EFn(empty_str_array(), array_empty(), params, None, None, Array::get(prepared_bodies, i))\n    Array::push(fields, (bare, closure))\n    i = i + 1\n  }\n  ERecord(\"\", fields, array_empty())\n}\n\nfn edp_table_lookup(op_names: Array[String], qname: String) -> Int {\n  let mut i = 0\n  let mut found = -1\n  while i < Array::length(op_names) {\n    if Array::get(op_names, i) == qname {\n      found = i\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  found\n}\n\nfn edp_bind_args(bind_names: Array[String], actual_args: Array[Expr], prepared_body: Expr) -> Expr {\n  let n = Array::length(bind_names)\n  let mut result = prepared_body\n  let mut i = n - 1\n  while i >= 0 {\n    if i < Array::length(actual_args) {\n      result = ELet(Array::get(bind_names, i), Array::get(actual_args, i), result, -1)\n    } else {\n      ()\n    }\n    i = i - 1\n  }\n  result\n}\n\nfn edp_rewrite_handle_body(expr: Expr, ename: String, op_names: Array[String], bind_names_list: Array[Array[String]], prepared_bodies: Array[Expr], dict_literal: Expr, needing: Array[String]) -> Expr {\n  match expr {\n    EFn(tps, tbs, params, ret, eff, body) => if edp_params_have_dict(params, edp_dict_param_name(ename)) {\n      expr\n    } else {\n      EFn(tps, tbs, params, ret, eff, edp_rewrite_handle_body(body, ename, op_names, bind_names_list, prepared_bodies, dict_literal, needing))\n    },\n    EHandle(body, arms) => if edp_handle_matches_effect(arms, ename) {\n      expr\n    } else {\n      EHandle(edp_rewrite_handle_body(body, ename, op_names, bind_names_list, prepared_bodies, dict_literal, needing), for a in arms {\n        let (p, ex) = a\n        (p, edp_rewrite_handle_body(ex, ename, op_names, bind_names_list, prepared_bodies, dict_literal, needing))\n      })\n    },\n    EIf(c, t, e) => EIf(edp_rewrite_handle_body(c, ename, op_names, bind_names_list, prepared_bodies, dict_literal, needing), edp_rewrite_handle_body(t, ename, op_names, bind_names_list, prepared_bodies, dict_literal, needing), edp_rewrite_handle_body(e, ename, op_names, bind_names_list, prepared_bodies, dict_literal, needing)),\n    EMatch(s, arms) => EMatch(edp_rewrite_handle_body(s, ename, op_names, bind_names_list, prepared_bodies, dict_literal, needing), for a in arms {\n      let (p, ex) = a\n      (p, edp_rewrite_handle_body(ex, ename, op_names, bind_names_list, prepared_bodies, dict_literal, needing))\n    }),\n    EWhile(c, b) => EWhile(edp_rewrite_handle_body(c, ename, op_names, bind_names_list, prepared_bodies, dict_literal, needing), edp_rewrite_handle_body(b, ename, op_names, bind_names_list, prepared_bodies, dict_literal, needing)),\n    EForIn(n, idx, it, b) => EForIn(n, idx, edp_rewrite_handle_body(it, ename, op_names, bind_names_list, prepared_bodies, dict_literal, needing), edp_rewrite_handle_body(b, ename, op_names, bind_names_list, prepared_bodies, dict_literal, needing)),\n    ELoop(pairs, b) => ELoop(for p in pairs {\n      let (n, v) = p\n      (n, edp_rewrite_handle_body(v, ename, op_names, bind_names_list, prepared_bodies, dict_literal, needing))\n    }, edp_rewrite_handle_body(b, ename, op_names, bind_names_list, prepared_bodies, dict_literal, needing)),\n    ELet(n, v, b, off) => ELet(n, edp_rewrite_handle_body(v, ename, op_names, bind_names_list, prepared_bodies, dict_literal, needing), edp_rewrite_handle_body(b, ename, op_names, bind_names_list, prepared_bodies, dict_literal, needing), off),\n    ELetMut(n, v, b, off) => ELetMut(n, edp_rewrite_handle_body(v, ename, op_names, bind_names_list, prepared_bodies, dict_literal, needing), edp_rewrite_handle_body(b, ename, op_names, bind_names_list, prepared_bodies, dict_literal, needing), off),\n    ELetRec(n, v, b) => ELetRec(n, edp_rewrite_handle_body(v, ename, op_names, bind_names_list, prepared_bodies, dict_literal, needing), edp_rewrite_handle_body(b, ename, op_names, bind_names_list, prepared_bodies, dict_literal, needing)),\n    ESeq(a, b) => ESeq(edp_rewrite_handle_body(a, ename, op_names, bind_names_list, prepared_bodies, dict_literal, needing), edp_rewrite_handle_body(b, ename, op_names, bind_names_list, prepared_bodies, dict_literal, needing)),\n    EAssign(n, v, c) => EAssign(n, edp_rewrite_handle_body(v, ename, op_names, bind_names_list, prepared_bodies, dict_literal, needing), edp_rewrite_handle_body(c, ename, op_names, bind_names_list, prepared_bodies, dict_literal, needing)),\n    EAssignOp(n, op, v, c) => EAssignOp(n, op, edp_rewrite_handle_body(v, ename, op_names, bind_names_list, prepared_bodies, dict_literal, needing), edp_rewrite_handle_body(c, ename, op_names, bind_names_list, prepared_bodies, dict_literal, needing)),\n    EReturn(e2) => EReturn(edp_rewrite_handle_body(e2, ename, op_names, bind_names_list, prepared_bodies, dict_literal, needing)),\n    EDot(o, f, off1, off2) => EDot(edp_rewrite_handle_body(o, ename, op_names, bind_names_list, prepared_bodies, dict_literal, needing), f, off1, off2),\n    ECall(callee, args, off) => match callee {\n      EIdent(nm, _) => if nm == \"perform\" && Array::length(args) == 1 {\n        edp_splice_perform(Array::get(args, 0), op_names, bind_names_list, prepared_bodies)\n      } else if edp_str_array_contains(needing, nm) {\n        ECall(callee, edp_prepend_expr(dict_literal, edp_rewrite_handle_body_exprs(args, ename, op_names, bind_names_list, prepared_bodies, dict_literal, needing)), off)\n      } else {\n        ECall(callee, edp_rewrite_handle_body_exprs(args, ename, op_names, bind_names_list, prepared_bodies, dict_literal, needing), off)\n      },\n      _ => ECall(callee, edp_rewrite_handle_body_exprs(args, ename, op_names, bind_names_list, prepared_bodies, dict_literal, needing), off)\n    },\n    EBinOp(op, l, r) => EBinOp(op, edp_rewrite_handle_body(l, ename, op_names, bind_names_list, prepared_bodies, dict_literal, needing), edp_rewrite_handle_body(r, ename, op_names, bind_names_list, prepared_bodies, dict_literal, needing)),\n    EUnaryOp(op, e2) => EUnaryOp(op, edp_rewrite_handle_body(e2, ename, op_names, bind_names_list, prepared_bodies, dict_literal, needing)),\n    ELabeledArg(l, n, v) => ELabeledArg(l, n, edp_rewrite_handle_body(v, ename, op_names, bind_names_list, prepared_bodies, dict_literal, needing)),\n    EBreak(opt) => EBreak(match opt {\n      Some(e2) => Some(edp_rewrite_handle_body(e2, ename, op_names, bind_names_list, prepared_bodies, dict_literal, needing)),\n      None => None\n    }),\n    EContinue(args) => EContinue(edp_rewrite_handle_body_exprs(args, ename, op_names, bind_names_list, prepared_bodies, dict_literal, needing)),\n    ETuple(elems) => ETuple(edp_rewrite_handle_body_exprs(elems, ename, op_names, bind_names_list, prepared_bodies, dict_literal, needing)),\n    EArray(elems) => EArray(edp_rewrite_handle_body_exprs(elems, ename, op_names, bind_names_list, prepared_bodies, dict_literal, needing)),\n    ERecord(n, fields, tas) => ERecord(n, for f in fields {\n      let (fn2, v) = f\n      (fn2, edp_rewrite_handle_body(v, ename, op_names, bind_names_list, prepared_bodies, dict_literal, needing))\n    }, tas),\n    EMap(fields) => EMap(for f in fields {\n      let (fn2, v) = f\n      (fn2, edp_rewrite_handle_body(v, ename, op_names, bind_names_list, prepared_bodies, dict_literal, needing))\n    }),\n    ESpread(e2) => ESpread(edp_rewrite_handle_body(e2, ename, op_names, bind_names_list, prepared_bodies, dict_literal, needing)),\n    _ => expr\n  }\n}\n\nfn edp_rewrite_handle_body_exprs(exprs: Array[Expr], ename: String, op_names: Array[String], bind_names_list: Array[Array[String]], prepared_bodies: Array[Expr], dict_literal: Expr, needing: Array[String]) -> Array[Expr] {\n  for e in exprs {\n    edp_rewrite_handle_body(e, ename, op_names, bind_names_list, prepared_bodies, dict_literal, needing)\n  }\n}\n\nfn edp_prepend_expr(v: Expr, args: Array[Expr]) -> Array[Expr] {\n  Array::concat([\n    v\n  ], args)\n}\n\nfn edp_splice_perform(operand: Expr, op_names: Array[String], bind_names_list: Array[Array[String]], prepared_bodies: Array[Expr]) -> Expr {\n  match operand {\n    EIdent(qname, _) => edp_splice_or_leave(qname, array_empty(), operand, op_names, bind_names_list, prepared_bodies),\n    ECall(op_callee, op_args, _) => match op_callee {\n      EIdent(qname, _) => edp_splice_or_leave(qname, op_args, operand, op_names, bind_names_list, prepared_bodies),\n      _ => ECall(EIdent(\"perform\", -1), [\n        operand\n      ], -1)\n    },\n    _ => ECall(EIdent(\"perform\", -1), [\n      operand\n    ], -1)\n  }\n}\n\nfn edp_splice_or_leave(qname: String, actual_args: Array[Expr], original_operand: Expr, op_names: Array[String], bind_names_list: Array[Array[String]], prepared_bodies: Array[Expr]) -> Expr {\n  let idx = edp_table_lookup(op_names, qname)\n  if idx < 0 {\n    ECall(EIdent(\"perform\", -1), [\n      original_operand\n    ], -1)\n  } else {\n    edp_bind_args(Array::get(bind_names_list, idx), actual_args, Array::get(prepared_bodies, idx))\n  }\n}\n\nfn edp_find_rewrite_handles(expr: Expr, ename: String, needing: Array[String]) -> Expr {\n  match expr {\n    EHandle(body, arms) => if edp_handle_matches_effect(arms, ename) {\n      edp_rewrite_handle_site(body, arms, ename, needing)\n    } else {\n      EHandle(edp_find_rewrite_handles(body, ename, needing), for a in arms {\n        let (p, ex) = a\n        (p, edp_find_rewrite_handles(ex, ename, needing))\n      })\n    },\n    EFn(tps, tbs, params, ret, eff, b) => EFn(tps, tbs, params, ret, eff, edp_find_rewrite_handles(b, ename, needing)),\n    ELet(n, v, b, off) => ELet(n, edp_find_rewrite_handles(v, ename, needing), edp_find_rewrite_handles(b, ename, needing), off),\n    ELetMut(n, v, b, off) => ELetMut(n, edp_find_rewrite_handles(v, ename, needing), edp_find_rewrite_handles(b, ename, needing), off),\n    ELetRec(n, v, b) => ELetRec(n, edp_find_rewrite_handles(v, ename, needing), edp_find_rewrite_handles(b, ename, needing)),\n    ESeq(a, b) => ESeq(edp_find_rewrite_handles(a, ename, needing), edp_find_rewrite_handles(b, ename, needing)),\n    EIf(c, t, e) => EIf(edp_find_rewrite_handles(c, ename, needing), edp_find_rewrite_handles(t, ename, needing), edp_find_rewrite_handles(e, ename, needing)),\n    EMatch(s, arms) => EMatch(edp_find_rewrite_handles(s, ename, needing), for a in arms {\n      let (p, ex) = a\n      (p, edp_find_rewrite_handles(ex, ename, needing))\n    }),\n    EWhile(c, b) => EWhile(edp_find_rewrite_handles(c, ename, needing), edp_find_rewrite_handles(b, ename, needing)),\n    EForIn(n, idx, it, b) => EForIn(n, idx, edp_find_rewrite_handles(it, ename, needing), edp_find_rewrite_handles(b, ename, needing)),\n    ECall(callee, args, off) => ECall(edp_find_rewrite_handles(callee, ename, needing), for a in args {\n      edp_find_rewrite_handles(a, ename, needing)\n    }, off),\n    EBinOp(op, l, r) => EBinOp(op, edp_find_rewrite_handles(l, ename, needing), edp_find_rewrite_handles(r, ename, needing)),\n    EUnaryOp(op, e2) => EUnaryOp(op, edp_find_rewrite_handles(e2, ename, needing)),\n    EAssign(n, v, c) => EAssign(n, edp_find_rewrite_handles(v, ename, needing), edp_find_rewrite_handles(c, ename, needing)),\n    EAssignOp(n, op, v, c) => EAssignOp(n, op, edp_find_rewrite_handles(v, ename, needing), edp_find_rewrite_handles(c, ename, needing)),\n    EDot(o, f, off1, off2) => EDot(edp_find_rewrite_handles(o, ename, needing), f, off1, off2),\n    ELabeledArg(l, n, v) => ELabeledArg(l, n, edp_find_rewrite_handles(v, ename, needing)),\n    EReturn(e2) => EReturn(edp_find_rewrite_handles(e2, ename, needing)),\n    EBreak(opt) => EBreak(match opt {\n      Some(e2) => Some(edp_find_rewrite_handles(e2, ename, needing)),\n      None => None\n    }),\n    EContinue(args) => EContinue(for a in args {\n      edp_find_rewrite_handles(a, ename, needing)\n    }),\n    ETuple(elems) => ETuple(for a in elems {\n      edp_find_rewrite_handles(a, ename, needing)\n    }),\n    EArray(elems) => EArray(for a in elems {\n      edp_find_rewrite_handles(a, ename, needing)\n    }),\n    ERecord(n, fields, tas) => ERecord(n, for f in fields {\n      let (fn2, v) = f\n      (fn2, edp_find_rewrite_handles(v, ename, needing))\n    }, tas),\n    EMap(fields) => EMap(for f in fields {\n      let (fn2, v) = f\n      (fn2, edp_find_rewrite_handles(v, ename, needing))\n    }),\n    ESpread(e2) => ESpread(edp_find_rewrite_handles(e2, ename, needing)),\n    ELoop(pairs, b) => ELoop(for p in pairs {\n      let (n, v) = p\n      (n, edp_find_rewrite_handles(v, ename, needing))\n    }, edp_find_rewrite_handles(b, ename, needing)),\n    _ => expr\n  }\n}\n\nexport fn suspend_cps_pass(stmts: Array[Stmt]) -> Array[String] {\n  let errs = array_empty_str()\n  let mut any_trigger = false\n  let mut i0 = 0\n  while i0 < Array::length(stmts) {\n    if scps_stmt_has_trigger(Array::get(stmts, i0)) {\n      any_trigger = true\n    } else {\n      ()\n    }\n    i0 = i0 + 1\n  }\n  if !any_trigger {\n    errs\n  } else {\n    let effect_defs = edp_collect_effect_defs(stmts)\n    let fn_defs = edp_collect_fn_defs(stmts)\n    let es_names = array_empty()\n    let es_members_list = array_empty()\n    edp_es_collect_into(stmts, es_names, es_members_list)\n    let ctor_names = scps_collect_ctor_names(stmts)\n    let ctx = (stmts, effect_defs, fn_defs, es_names, es_members_list, ctor_names)\n    let st = (scps_ctr_box(), array_empty_str(), array_empty_str(), array_empty_str(), array_empty_str(), scps_empty_stmts(), errs)\n    let cps_effs = scps_collect_cps_effs(stmts)\n    let ecfgs = array_empty_ecfg()\n    let mut ce = 0\n    while ce < Array::length(cps_effs) {\n      Array::push(ecfgs, scps_ecfg_for(ctx, Array::get(cps_effs, ce)))\n      ce = ce + 1\n    }\n    let split_effs = array_empty_str()\n    let mut ip = 0\n    while ip < (if Array::length(ecfgs) > 0 {\n      Array::length(stmts)\n    } else {\n      0\n    }) {\n      match Array::get(stmts, ip) {\n        SLet(exported, is_rec, name, ty, expr) => Array::set(stmts, ip, SLet(exported, is_rec, name, ty, match expr {\n          EFn(tps, tbs, params, ret, eff, b) => EFn(tps, tbs, params, ret, eff, scps_prepass_expr(b, ecfgs, ctx, st, split_effs)),\n          _ => scps_prepass_expr(expr, ecfgs, ctx, st, split_effs)\n        })),\n        SLetMut(name, ty, expr) => Array::set(stmts, ip, SLetMut(name, ty, match expr {\n          EFn(tps, tbs, params, ret, eff, b) => EFn(tps, tbs, params, ret, eff, scps_prepass_expr(b, ecfgs, ctx, st, split_effs)),\n          _ => scps_prepass_expr(expr, ecfgs, ctx, st, split_effs)\n        })),\n        SExpr(expr) => Array::set(stmts, ip, SExpr(scps_prepass_expr(expr, ecfgs, ctx, st, split_effs))),\n        STest(tn, expr) => Array::set(stmts, ip, STest(tn, scps_prepass_expr(expr, ecfgs, ctx, st, split_effs))),\n        SBench(bn, expr) => Array::set(stmts, ip, SBench(bn, scps_prepass_expr(expr, ecfgs, ctx, st, split_effs))),\n        _ => ()\n      }\n      ip = ip + 1\n    }\n    let scope = array_empty_scope()\n    let mut i = 0\n    while i < Array::length(stmts) {\n      if scps_stmt_has_trigger(Array::get(stmts, i)) {\n        match Array::get(stmts, i) {\n          SLet(exported, is_rec, name, ty, expr) => Array::set(stmts, i, SLet(exported, is_rec, name, ty, scps_rewrite(expr, ctx, st, cps_effs, scope))),\n          SLetMut(name, ty, expr) => Array::set(stmts, i, SLetMut(name, ty, scps_rewrite(expr, ctx, st, cps_effs, scope))),\n          SExpr(expr) => Array::set(stmts, i, SExpr(scps_rewrite(expr, ctx, st, cps_effs, scope))),\n          STest(tn, expr) => Array::set(stmts, i, STest(tn, scps_rewrite(expr, ctx, st, cps_effs, scope))),\n          SBench(bn, expr) => Array::set(stmts, i, SBench(bn, scps_rewrite(expr, ctx, st, cps_effs, scope))),\n          _ => ()\n        }\n      } else {\n        ()\n      }\n      i = i + 1\n    }\n    let (_, _, _, q_eff, q_fn, inj, _) = st\n    let mut qi = 0\n    while qi < Array::length(q_fn) {\n      scps_emit_clone(Array::get(q_eff, qi), Array::get(q_fn, qi), ctx, st)\n      qi = qi + 1\n    }\n    let mut j = 0\n    while j < Array::length(inj) {\n      Array::push(stmts, Array::get(inj, j))\n      j = j + 1\n    }\n    if Array::length(split_effs) > 0 {\n      let mut gi = 0\n      while gi < Array::length(stmts) {\n        match scps_stmt_expr_of(Array::get(stmts, gi)) {\n          Some(expr) => scps_guard_untriggered(expr, split_effs, errs),\n          None => ()\n        }\n        gi = gi + 1\n      }\n    } else {\n      ()\n    }\n    errs\n  }\n}\n\n\nfn scps_ctr_box() -> Array[Int] {\n  [\n    0\n  ]\n}\n\nfn scps_next_site(st: (Array[Int], Array[String], Array[String], Array[String], Array[String], Array[Stmt], Array[String])) -> Int {\n  let (ctr, _, _, _, _, _, _) = st\n  let site = Array::get(ctr, 0)\n  Array::set(ctr, 0, site + 1)\n  site\n}\n\nfn scps_st_errs(st: (Array[Int], Array[String], Array[String], Array[String], Array[String], Array[Stmt], Array[String])) -> Array[String] {\n  let (_, _, _, _, _, _, errs) = st\n  errs\n}\n\nfn scps_st_inj(st: (Array[Int], Array[String], Array[String], Array[String], Array[String], Array[Stmt], Array[String])) -> Array[Stmt] {\n  let (_, _, _, _, _, inj, _) = st\n  inj\n}\n\n\nfn scps_empty_stmts() -> Array[Stmt] {\n  Array::slice([\n    SExpr(EUnit)\n  ], 0, 0)\n}\n\nfn scps_empty_pats() -> Array[Pat] {\n  Array::slice([\n    PWild\n  ], 0, 0)\n}\n\nfn scps_empty_arms() -> Array[(Pat, Expr)] {\n  Array::slice([\n    (PWild, EUnit)\n  ], 0, 0)\n}\n\nfn scps_empty_tys() -> Array[TypeExpr] {\n  Array::slice([\n    TyUnit\n  ], 0, 0)\n}\n\nfn scps_empty_ctors() -> Array[(String, Array[TypeExpr])] {\n  Array::slice([\n    (\"\", scps_empty_tys())\n  ], 0, 0)\n}\n\nfn scps_empty_tbs() -> Array[(String, Array[String])] {\n  Array::slice([\n    (\"\", array_empty_str())\n  ], 0, 0)\n}\n\nfn scps_empty_params() -> Array[(String, Option[TypeExpr])] {\n  Array::slice([\n    (\"\", None)\n  ], 0, 0)\n}\n\nfn scps_mk_fn1(param: String, body: Expr) -> Expr {\n  let ps = scps_empty_params()\n  Array::push(ps, (param, None))\n  EFn(array_empty_str(), scps_empty_tbs(), ps, None, None, body)\n}\n\nfn scps_mk_fn2(p1: String, p2: String, body: Expr) -> Expr {\n  let ps = scps_empty_params()\n  Array::push(ps, (p1, None))\n  Array::push(ps, (p2, None))\n  EFn(array_empty_str(), scps_empty_tbs(), ps, None, None, body)\n}\n\n\nfn scps_step_name(eff: String) -> String {\n  String::concat(\"__ScpsStep_\", eff)\n}\n\nfn scps_done_name(eff: String) -> String {\n  String::concat(\"__ScpsDone_\", eff)\n}\n\nfn scps_y_name(eff: String, opname: String) -> String {\n  String::concat(String::concat(String::concat(\"__ScpsY_\", eff), \"_\"), opname)\n}\n\nfn scps_bubble_name(eff: String) -> String {\n  String::concat(\"__scps_bubble_\", eff)\n}\n\nfn scps_sanitize(name: String) -> String {\n  let parts = String::split(name, \"::\")\n  String::join(parts, \"__\")\n}\n\nfn scps_clone_name(eff: String, fname: String) -> String {\n  String::concat(String::concat(String::concat(\"__scps_cps_\", eff), \"_\"), scps_sanitize(fname))\n}\n\nfn scps_local(prefix: String, site: Int) -> String {\n  String::concat(prefix, Int::to_string(site))\n}\n\nfn scps_op_suffix(qname: String) -> String {\n  let ci = String::index_of(qname, \"::\")\n  if ci > 0 {\n    String::substring(qname, ci + 2, String::length(qname))\n  } else {\n    qname\n  }\n}\n\n\nfn scps_collect_ctor_names(stmts: Array[Stmt]) -> Array[String] {\n  let out = array_empty_str()\n  Array::push(out, \"Some\")\n  Array::push(out, \"Ok\")\n  Array::push(out, \"Err\")\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SEnum(_, _, _, ctors, _) => {\n        let mut ci = 0\n        while ci < Array::length(ctors) {\n          let (cn, _) = Array::get(ctors, ci)\n          Array::push(out, cn)\n          ci = ci + 1\n        }\n      },\n      SSuberror(_, _, ctors) => {\n        let mut ci = 0\n        while ci < Array::length(ctors) {\n          let (cn, _) = Array::get(ctors, ci)\n          Array::push(out, cn)\n          ci = ci + 1\n        }\n      },\n      _ => ()\n    }\n    i = i + 1\n  }\n  out\n}\n\nfn scps_effect_decl_ops(ctx: (Array[Stmt], Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], Array[String], Array[Array[String]], Array[String]), eff: String) -> (Bool, Array[(String, Int)]) {\n  let (_, effect_defs, _, _, _, _) = ctx\n  let out = Array::slice([\n    (\"\", 0)\n  ], 0, 0)\n  let mut found = false\n  let mut i = 0\n  while i < Array::length(effect_defs) {\n    let (name, ops) = Array::get(effect_defs, i)\n    if name == eff {\n      found = true\n      let mut oi = 0\n      while oi < Array::length(ops) {\n        let (opname, params, _) = Array::get(ops, oi)\n        Array::push(out, (opname, Array::length(params)))\n        oi = oi + 1\n      }\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  (found, out)\n}\n\nfn scps_needing_for(ctx: (Array[Stmt], Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], Array[String], Array[Array[String]], Array[String]), eff: String) -> Array[String] {\n  let (_, _, fn_defs, es_names, es_members_list, _) = ctx\n  edp_needing_names(fn_defs, eff, es_names, es_members_list)\n}\n\nfn scps_fn_row_of(ctx: (Array[Stmt], Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], Array[String], Array[Array[String]], Array[String]), name: String) -> (Bool, String) {\n  let (_, _, fn_defs, _, _, _) = ctx\n  let mut found = false\n  let mut row = \"\"\n  let mut i = 0\n  while i < Array::length(fn_defs) {\n    let (_, _, _, fname, _, frow) = Array::get(fn_defs, i)\n    if fname == name {\n      found = true\n      row = frow\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  (found, row)\n}\n\nfn scps_row_has_var(row: String) -> Bool {\n  if row == \"\" {\n    false\n  } else {\n    let parts = String::split(row, \",\")\n    let mut has = false\n    let mut i = 0\n    while i < Array::length(parts) {\n      let item = String::trim(Array::get(parts, i))\n      if String::length(item) > 0 && String::index_of(item, \"::\") < 0 {\n        let c = String::char_code_at(item, 0)\n        if c >= 97 && c <= 122 {\n          has = true\n        } else {\n          ()\n        }\n      } else {\n        ()\n      }\n      i = i + 1\n    }\n    has\n  }\n}\n\nfn scps_row_contains(ctx: (Array[Stmt], Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], Array[String], Array[Array[String]], Array[String]), row: String, eff: String) -> Bool {\n  let (_, _, _, es_names, es_members_list, _) = ctx\n  if row == \"\" {\n    false\n  } else {\n    edp_row_is_exactly(row, eff, es_names, es_members_list)\n  }\n}\n\nfn scps_is_ctor_name(ctx: (Array[Stmt], Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], Array[String], Array[Array[String]], Array[String]), nm: String) -> Bool {\n  let (_, _, _, _, _, ctor_names) = ctx\n  edp_str_array_contains(ctor_names, nm)\n}\n\n\nfn scps_pat_binds_resume(p: Pat) -> Bool {\n  match p {\n    PBind(n) => n == \"resume\",\n    PCtor(_, ps) => scps_pats_bind_resume(ps),\n    PTuple(ps) => scps_pats_bind_resume(ps),\n    POr(a, b) => scps_pat_binds_resume(a) || scps_pat_binds_resume(b),\n    PStruct(_, fields) => {\n      let mut i = 0\n      let mut found = false\n      while i < Array::length(fields) {\n        let (_, fp) = Array::get(fields, i)\n        if scps_pat_binds_resume(fp) {\n          found = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      found\n    },\n    _ => false\n  }\n}\n\nfn scps_pats_bind_resume(ps: Array[Pat]) -> Bool {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(ps) {\n    if scps_pat_binds_resume(Array::get(ps, i)) {\n      found = true\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  found\n}\n\nfn scps_fn_params_bind_resume(params: Array[(String, Option[TypeExpr])]) -> Bool {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(params) {\n    let (pn, _) = Array::get(params, i)\n    let ln = String::length(pn)\n    let base = if ln > 0 && pn[ln - 1: ln] == \"~\" {\n      pn[0: ln - 1]\n    } else {\n      pn\n    }\n    if base == \"resume\" {\n      found = true\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  found\n}\n\nfn scps_arm_refs_resume_value(e: Expr, sh: Bool) -> Bool {\n  match e {\n    EIdent(nm, _) => nm == \"resume\" && !sh,\n    ECall(callee, args, _) => {\n      let callee_hit = match callee {\n        EIdent(_, _) => false,\n        _ => scps_arm_refs_resume_value(callee, sh)\n      }\n      callee_hit || scps_exprs_ref_resume_value(args, sh)\n    },\n    ELet(n, v, b, _) => scps_arm_refs_resume_value(v, sh) || scps_arm_refs_resume_value(b, sh || n == \"resume\"),\n    ELetMut(n, v, b, _) => scps_arm_refs_resume_value(v, sh) || scps_arm_refs_resume_value(b, sh || n == \"resume\"),\n    ELetRec(n, v, b) => scps_arm_refs_resume_value(v, sh || n == \"resume\") || scps_arm_refs_resume_value(b, sh || n == \"resume\"),\n    ESeq(a, b) => scps_arm_refs_resume_value(a, sh) || scps_arm_refs_resume_value(b, sh),\n    EIf(c, t, el) => scps_arm_refs_resume_value(c, sh) || scps_arm_refs_resume_value(t, sh) || scps_arm_refs_resume_value(el, sh),\n    EMatch(s, arms) => {\n      let mut hit = scps_arm_refs_resume_value(s, sh)\n      let mut i = 0\n      while i < Array::length(arms) {\n        let (p, ex) = Array::get(arms, i)\n        if scps_arm_refs_resume_value(ex, sh || scps_pat_binds_resume(p)) {\n          hit = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      hit\n    },\n    EHandle(b, arms) => {\n      let mut hit = scps_arm_refs_resume_value(b, sh)\n      let mut i = 0\n      while i < Array::length(arms) {\n        let (_, ex) = Array::get(arms, i)\n        if scps_arm_refs_resume_value(ex, true) {\n          hit = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      hit\n    },\n    EFn(_, _, params, _, _, b) => scps_arm_refs_resume_value(b, sh || scps_fn_params_bind_resume(params)),\n    EWhile(c, b) => scps_arm_refs_resume_value(c, sh) || scps_arm_refs_resume_value(b, sh),\n    EForIn(v1, v2, it, b) => {\n      let for_sh = v1 == \"resume\" || (match v2 {\n        Some(v2n) => v2n == \"resume\",\n        None => false\n      })\n      scps_arm_refs_resume_value(it, sh) || scps_arm_refs_resume_value(b, sh || for_sh)\n    },\n    ELoop(pairs, b) => {\n      let mut hit = false\n      let mut loop_sh = sh\n      let mut i = 0\n      while i < Array::length(pairs) {\n        let (n, v) = Array::get(pairs, i)\n        if n == \"resume\" {\n          loop_sh = true\n        } else {\n          ()\n        }\n        if scps_arm_refs_resume_value(v, sh) {\n          hit = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      hit || scps_arm_refs_resume_value(b, loop_sh)\n    },\n    EBinOp(_, l, r) => scps_arm_refs_resume_value(l, sh) || scps_arm_refs_resume_value(r, sh),\n    EUnaryOp(_, e2) => scps_arm_refs_resume_value(e2, sh),\n    EAssign(_, v, c) => scps_arm_refs_resume_value(v, sh) || scps_arm_refs_resume_value(c, sh),\n    EAssignOp(_, _, v, c) => scps_arm_refs_resume_value(v, sh) || scps_arm_refs_resume_value(c, sh),\n    EReturn(e2) => scps_arm_refs_resume_value(e2, sh),\n    EDot(o, _, _, _) => scps_arm_refs_resume_value(o, sh),\n    ELabeledArg(_, _, v) => scps_arm_refs_resume_value(v, sh),\n    EBreak(opt) => match opt {\n      Some(e2) => scps_arm_refs_resume_value(e2, sh),\n      None => false\n    },\n    EContinue(args) => scps_exprs_ref_resume_value(args, sh),\n    ETuple(elems) => scps_exprs_ref_resume_value(elems, sh),\n    EArray(elems) => scps_exprs_ref_resume_value(elems, sh),\n    ERecord(_, fields, _) => scps_fields_ref_resume_value(fields, sh),\n    EMap(fields) => scps_fields_ref_resume_value(fields, sh),\n    ESpread(e2) => scps_arm_refs_resume_value(e2, sh),\n    _ => false\n  }\n}\n\nfn scps_exprs_ref_resume_value(es: Array[Expr], sh: Bool) -> Bool {\n  let mut i = 0\n  let mut hit = false\n  while i < Array::length(es) {\n    if scps_arm_refs_resume_value(Array::get(es, i), sh) {\n      hit = true\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  hit\n}\n\nfn scps_fields_ref_resume_value(fields: Array[(String, Expr)], sh: Bool) -> Bool {\n  let mut i = 0\n  let mut hit = false\n  while i < Array::length(fields) {\n    let (_, v) = Array::get(fields, i)\n    if scps_arm_refs_resume_value(v, sh) {\n      hit = true\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  hit\n}\n\n\nfn scps_op_index(ops: Array[String], q: String) -> Int {\n  let mut i = 0\n  let mut found = -1\n  while i < Array::length(ops) {\n    if Array::get(ops, i) == q {\n      found = i\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  found\n}\n\nfn scps_as_target_perform(e: Expr, ops: Array[String]) -> Int {\n  match e {\n    ECall(callee, pargs, _) => match callee {\n      EIdent(nm, _) => if nm == \"perform\" && Array::length(pargs) == 1 {\n        match Array::get(pargs, 0) {\n          EIdent(q, _) => scps_op_index(ops, q),\n          ECall(opc, _, _) => match opc {\n            EIdent(q, _) => scps_op_index(ops, q),\n            _ => -1\n          },\n          _ => -1\n        }\n      } else {\n        -1\n      },\n      _ => -1\n    },\n    _ => -1\n  }\n}\n\nfn scps_perform_args(e: Expr) -> Array[Expr] {\n  match e {\n    ECall(_, pargs, _) => if Array::length(pargs) == 1 {\n      match Array::get(pargs, 0) {\n        ECall(_, op_args, _) => op_args,\n        _ => array_empty_expr()\n      }\n    } else {\n      array_empty_expr()\n    },\n    _ => array_empty_expr()\n  }\n}\n\nfn scps_as_needing_call(e: Expr, sctx: (String, Array[String], Array[String], Int, Array[String])) -> String {\n  let (_, _, needing, _, _) = sctx\n  match e {\n    ECall(callee, _, _) => match callee {\n      EIdent(nm, _) => if nm != \"perform\" && edp_str_array_contains(needing, nm) {\n        nm\n      } else {\n        \"\"\n      },\n      _ => \"\"\n    },\n    _ => \"\"\n  }\n}\n\nfn scps_call_args(e: Expr) -> Array[Expr] {\n  match e {\n    ECall(_, args, _) => args,\n    _ => array_empty_expr()\n  }\n}\n\n\nfn scps_as_cps_local_call(e: Expr, sctx: (String, Array[String], Array[String], Int, Array[String])) -> String {\n  let (_, _, _, _, cps_locals) = sctx\n  match e {\n    ECall(callee, _, _) => match callee {\n      EIdent(nm, _) => if edp_str_array_contains(cps_locals, nm) {\n        nm\n      } else {\n        \"\"\n      },\n      _ => \"\"\n    },\n    _ => \"\"\n  }\n}\n\nfn scps_ty_row(ty: Option[TypeExpr]) -> String {\n  match ty {\n    Some(t) => match t {\n      TyFn(_, _, row_opt) => match row_opt {\n        Some(row) => row,\n        None => \"\"\n      },\n      _ => \"\"\n    },\n    None => \"\"\n  }\n}\n\nfn scps_literal_is_step_for(v: Expr, eff: String) -> Bool {\n  match v {\n    EFn(_, _, _, _, _, b) => {\n      let dn = scps_done_name(eff)\n      let bn = scps_bubble_name(eff)\n      scps_mentions_step(b, dn, scps_y_name(eff, \"\"), bn) || scps_mentions_step(b, dn, scps_clone_name(eff, \"\"), bn)\n    },\n    _ => false\n  }\n}\n\nfn scps_mentions_step(e: Expr, dn: String, yprefix: String, bn: String) -> Bool {\n  match e {\n    EIdent(nm, _) => nm == dn || nm == bn || String::starts_with(nm, yprefix),\n    ECall(callee, args, _) => scps_mentions_step(callee, dn, yprefix, bn) || scps_exprs_mention_step(args, dn, yprefix, bn),\n    ELet(_, v, b, _) => scps_mentions_step(v, dn, yprefix, bn) || scps_mentions_step(b, dn, yprefix, bn),\n    ELetMut(_, v, b, _) => scps_mentions_step(v, dn, yprefix, bn) || scps_mentions_step(b, dn, yprefix, bn),\n    ELetRec(_, v, b) => scps_mentions_step(v, dn, yprefix, bn) || scps_mentions_step(b, dn, yprefix, bn),\n    ESeq(a, b) => scps_mentions_step(a, dn, yprefix, bn) || scps_mentions_step(b, dn, yprefix, bn),\n    EIf(c, t, el) => scps_mentions_step(c, dn, yprefix, bn) || scps_mentions_step(t, dn, yprefix, bn) || scps_mentions_step(el, dn, yprefix, bn),\n    EMatch(s, arms) => {\n      let mut hit = scps_mentions_step(s, dn, yprefix, bn)\n      let mut i = 0\n      while i < Array::length(arms) {\n        let (_, ex) = Array::get(arms, i)\n        if scps_mentions_step(ex, dn, yprefix, bn) {\n          hit = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      hit\n    },\n    EHandle(s, arms) => {\n      let mut hit = scps_mentions_step(s, dn, yprefix, bn)\n      let mut i = 0\n      while i < Array::length(arms) {\n        let (_, ex) = Array::get(arms, i)\n        if scps_mentions_step(ex, dn, yprefix, bn) {\n          hit = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      hit\n    },\n    EFn(_, _, _, _, _, b) => scps_mentions_step(b, dn, yprefix, bn),\n    EWhile(c, b) => scps_mentions_step(c, dn, yprefix, bn) || scps_mentions_step(b, dn, yprefix, bn),\n    EForIn(_, _, it, b) => scps_mentions_step(it, dn, yprefix, bn) || scps_mentions_step(b, dn, yprefix, bn),\n    EBinOp(_, l, r) => scps_mentions_step(l, dn, yprefix, bn) || scps_mentions_step(r, dn, yprefix, bn),\n    EUnaryOp(_, x) => scps_mentions_step(x, dn, yprefix, bn),\n    EAssign(_, v, c) => scps_mentions_step(v, dn, yprefix, bn) || scps_mentions_step(c, dn, yprefix, bn),\n    EAssignOp(_, _, v, c) => scps_mentions_step(v, dn, yprefix, bn) || scps_mentions_step(c, dn, yprefix, bn),\n    EReturn(x) => scps_mentions_step(x, dn, yprefix, bn),\n    EDot(o, _, _, _) => scps_mentions_step(o, dn, yprefix, bn),\n    ELabeledArg(_, _, v) => scps_mentions_step(v, dn, yprefix, bn),\n    EBreak(opt) => match opt {\n      Some(x) => scps_mentions_step(x, dn, yprefix, bn),\n      None => false\n    },\n    EContinue(args) => scps_exprs_mention_step(args, dn, yprefix, bn),\n    ETuple(items) => scps_exprs_mention_step(items, dn, yprefix, bn),\n    EArray(items) => scps_exprs_mention_step(items, dn, yprefix, bn),\n    ERecord(_, fields, _) => scps_fields_mention_step(fields, dn, yprefix, bn),\n    EMap(fields) => scps_fields_mention_step(fields, dn, yprefix, bn),\n    ESpread(x) => scps_mentions_step(x, dn, yprefix, bn),\n    ELoop(pairs, b) => {\n      let mut hit = scps_mentions_step(b, dn, yprefix, bn)\n      let mut i = 0\n      while i < Array::length(pairs) {\n        let (_, v) = Array::get(pairs, i)\n        if scps_mentions_step(v, dn, yprefix, bn) {\n          hit = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      hit\n    },\n    _ => false\n  }\n}\n\nfn scps_exprs_mention_step(es: Array[Expr], dn: String, yprefix: String, bn: String) -> Bool {\n  let mut i = 0\n  let mut hit = false\n  while i < Array::length(es) {\n    if scps_mentions_step(Array::get(es, i), dn, yprefix, bn) {\n      hit = true\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  hit\n}\n\nfn scps_fields_mention_step(fields: Array[(String, Expr)], dn: String, yprefix: String, bn: String) -> Bool {\n  let mut i = 0\n  let mut hit = false\n  while i < Array::length(fields) {\n    let (_, v) = Array::get(fields, i)\n    if scps_mentions_step(v, dn, yprefix, bn) {\n      hit = true\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  hit\n}\n\nfn scps_contains_susp(e: Expr, sctx: (String, Array[String], Array[String], Int, Array[String])) -> Bool {\n  let (_, ops, _, _, _) = sctx\n  if scps_as_target_perform(e, ops) >= 0 || scps_as_needing_call(e, sctx) != \"\" || scps_as_cps_local_call(e, sctx) != \"\" {\n    true\n  } else {\n    match e {\n      ECall(callee, args, _) => scps_contains_susp(callee, sctx) || scps_exprs_contain_susp(args, sctx),\n      ELet(_, v, b, _) => scps_contains_susp(v, sctx) || scps_contains_susp(b, sctx),\n      ELetMut(_, v, b, _) => scps_contains_susp(v, sctx) || scps_contains_susp(b, sctx),\n      ELetRec(_, v, b) => scps_contains_susp(v, sctx) || scps_contains_susp(b, sctx),\n      ESeq(a, b) => scps_contains_susp(a, sctx) || scps_contains_susp(b, sctx),\n      EIf(c, t, el) => scps_contains_susp(c, sctx) || scps_contains_susp(t, sctx) || scps_contains_susp(el, sctx),\n      EMatch(s, arms) => scps_contains_susp(s, sctx) || scps_arms_contain_susp(arms, sctx),\n      EHandle(b, arms) => scps_contains_susp(b, sctx) || scps_arms_contain_susp(arms, sctx),\n      EFn(_, _, _, _, _, b) => scps_contains_susp(b, sctx),\n      EWhile(c, b) => scps_contains_susp(c, sctx) || scps_contains_susp(b, sctx),\n      EForIn(_, _, it, b) => scps_contains_susp(it, sctx) || scps_contains_susp(b, sctx),\n      ELoop(pairs, b) => scps_pairs_contain_susp(pairs, sctx) || scps_contains_susp(b, sctx),\n      EBinOp(_, l, r) => scps_contains_susp(l, sctx) || scps_contains_susp(r, sctx),\n      EUnaryOp(_, e2) => scps_contains_susp(e2, sctx),\n      EAssign(_, v, c) => scps_contains_susp(v, sctx) || scps_contains_susp(c, sctx),\n      EAssignOp(_, _, v, c) => scps_contains_susp(v, sctx) || scps_contains_susp(c, sctx),\n      EReturn(e2) => scps_contains_susp(e2, sctx),\n      EDot(o, _, _, _) => scps_contains_susp(o, sctx),\n      ELabeledArg(_, _, v) => scps_contains_susp(v, sctx),\n      EBreak(opt) => match opt {\n        Some(e2) => scps_contains_susp(e2, sctx),\n        None => false\n      },\n      EContinue(args) => scps_exprs_contain_susp(args, sctx),\n      ETuple(elems) => scps_exprs_contain_susp(elems, sctx),\n      EArray(elems) => scps_exprs_contain_susp(elems, sctx),\n      ERecord(_, fields, _) => scps_fields_contain_susp(fields, sctx),\n      EMap(fields) => scps_fields_contain_susp(fields, sctx),\n      ESpread(e2) => scps_contains_susp(e2, sctx),\n      _ => false\n    }\n  }\n}\n\nfn scps_exprs_contain_susp(es: Array[Expr], sctx: (String, Array[String], Array[String], Int, Array[String])) -> Bool {\n  let mut i = 0\n  let mut hit = false\n  while i < Array::length(es) {\n    if scps_contains_susp(Array::get(es, i), sctx) {\n      hit = true\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  hit\n}\n\nfn scps_fields_contain_susp(fields: Array[(String, Expr)], sctx: (String, Array[String], Array[String], Int, Array[String])) -> Bool {\n  let mut i = 0\n  let mut hit = false\n  while i < Array::length(fields) {\n    let (_, v) = Array::get(fields, i)\n    if scps_contains_susp(v, sctx) {\n      hit = true\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  hit\n}\n\nfn scps_pairs_contain_susp(pairs: Array[(String, Expr)], sctx: (String, Array[String], Array[String], Int, Array[String])) -> Bool {\n  let mut i = 0\n  let mut hit = false\n  while i < Array::length(pairs) {\n    let (_, v) = Array::get(pairs, i)\n    if scps_contains_susp(v, sctx) {\n      hit = true\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  hit\n}\n\nfn scps_arms_contain_susp(arms: Array[(Pat, Expr)], sctx: (String, Array[String], Array[String], Int, Array[String])) -> Bool {\n  let mut i = 0\n  let mut hit = false\n  while i < Array::length(arms) {\n    let (_, ex) = Array::get(arms, i)\n    if scps_contains_susp(ex, sctx) {\n      hit = true\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  hit\n}\n\nfn scps_calls_ok(e: Expr, sctx: (String, Array[String], Array[String], Int, Array[String]), ctx: (Array[Stmt], Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], Array[String], Array[Array[String]], Array[String])) -> Bool {\n  let (eff, _, needing, _, cps_locals) = sctx\n  match e {\n    ECall(callee, args, _) => match callee {\n      EIdent(nm, _) => if nm == \"perform\" && Array::length(args) == 1 {\n        match Array::get(args, 0) {\n          EIdent(_, _) => true,\n          ECall(opc, op_args, _) => match opc {\n            EIdent(_, _) => scps_exprs_calls_ok(op_args, sctx, ctx),\n            _ => false\n          },\n          _ => false\n        }\n      } else if idp_is_pure_builtin_call(nm) || scps_is_safe_mut_builtin(nm) || scps_is_ctor_name(ctx, nm) || edp_str_array_contains(needing, nm) {\n        scps_exprs_calls_ok(args, sctx, ctx)\n      } else if edp_str_array_contains(cps_locals, nm) || String::starts_with(nm, \"__scps_\") || String::starts_with(nm, \"__Scps\") {\n        scps_exprs_calls_ok(args, sctx, ctx)\n      } else {\n        let (is_fn, row) = scps_fn_row_of(ctx, nm)\n        if is_fn && !scps_row_contains(ctx, row, eff) && !scps_row_has_var(row) {\n          scps_exprs_calls_ok(args, sctx, ctx)\n        } else {\n          false\n        }\n      },\n      _ => false\n    },\n    ELet(_, v, b, _) => scps_calls_ok(v, sctx, ctx) && scps_calls_ok(b, sctx, ctx),\n    ELetMut(_, v, b, _) => scps_calls_ok(v, sctx, ctx) && scps_calls_ok(b, sctx, ctx),\n    ELetRec(_, v, b) => scps_calls_ok(v, sctx, ctx) && scps_calls_ok(b, sctx, ctx),\n    ESeq(a, b) => scps_calls_ok(a, sctx, ctx) && scps_calls_ok(b, sctx, ctx),\n    EIf(c, t, el) => scps_calls_ok(c, sctx, ctx) && scps_calls_ok(t, sctx, ctx) && scps_calls_ok(el, sctx, ctx),\n    EMatch(s, arms) => {\n      let mut ok = scps_calls_ok(s, sctx, ctx)\n      let mut i = 0\n      while i < Array::length(arms) {\n        let (_, ex) = Array::get(arms, i)\n        if !scps_calls_ok(ex, sctx, ctx) {\n          ok = false\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      ok\n    },\n    EHandle(_, _) => false,\n    EFn(_, _, _, _, _, b) => scps_calls_ok(b, sctx, ctx),\n    EWhile(c, b) => scps_calls_ok(c, sctx, ctx) && scps_calls_ok(b, sctx, ctx),\n    EForIn(_, _, it, b) => scps_calls_ok(it, sctx, ctx) && scps_calls_ok(b, sctx, ctx),\n    ELoop(pairs, b) => {\n      let mut ok = scps_calls_ok(b, sctx, ctx)\n      let mut i = 0\n      while i < Array::length(pairs) {\n        let (_, v) = Array::get(pairs, i)\n        if !scps_calls_ok(v, sctx, ctx) {\n          ok = false\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      ok\n    },\n    EBinOp(_, l, r) => scps_calls_ok(l, sctx, ctx) && scps_calls_ok(r, sctx, ctx),\n    EUnaryOp(_, e2) => scps_calls_ok(e2, sctx, ctx),\n    EAssign(_, v, c) => scps_calls_ok(v, sctx, ctx) && scps_calls_ok(c, sctx, ctx),\n    EAssignOp(_, _, v, c) => scps_calls_ok(v, sctx, ctx) && scps_calls_ok(c, sctx, ctx),\n    EReturn(e2) => scps_calls_ok(e2, sctx, ctx),\n    EDot(o, _, _, _) => scps_calls_ok(o, sctx, ctx),\n    ELabeledArg(_, _, v) => scps_calls_ok(v, sctx, ctx),\n    EBreak(opt) => match opt {\n      Some(e2) => scps_calls_ok(e2, sctx, ctx),\n      None => true\n    },\n    EContinue(args) => scps_exprs_calls_ok(args, sctx, ctx),\n    ETuple(elems) => scps_exprs_calls_ok(elems, sctx, ctx),\n    EArray(elems) => scps_exprs_calls_ok(elems, sctx, ctx),\n    ERecord(_, fields, _) => scps_fields_calls_ok(fields, sctx, ctx),\n    EMap(fields) => scps_fields_calls_ok(fields, sctx, ctx),\n    ESpread(e2) => scps_calls_ok(e2, sctx, ctx),\n    _ => true\n  }\n}\n\nfn scps_exprs_calls_ok(es: Array[Expr], sctx: (String, Array[String], Array[String], Int, Array[String]), ctx: (Array[Stmt], Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], Array[String], Array[Array[String]], Array[String])) -> Bool {\n  let mut i = 0\n  let mut ok = true\n  while i < Array::length(es) {\n    if !scps_calls_ok(Array::get(es, i), sctx, ctx) {\n      ok = false\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  ok\n}\n\nfn scps_fields_calls_ok(fields: Array[(String, Expr)], sctx: (String, Array[String], Array[String], Int, Array[String]), ctx: (Array[Stmt], Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], Array[String], Array[Array[String]], Array[String])) -> Bool {\n  let mut i = 0\n  let mut ok = true\n  while i < Array::length(fields) {\n    let (_, v) = Array::get(fields, i)\n    if !scps_calls_ok(v, sctx, ctx) {\n      ok = false\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  ok\n}\n\n\nfn scps_mk_yield(eff: String, opname: String, args: Array[Expr], bind_name: String, cont_body: Expr) -> Expr {\n  let payload = array_empty_expr()\n  let mut i = 0\n  while i < Array::length(args) {\n    Array::push(payload, Array::get(args, i))\n    i = i + 1\n  }\n  Array::push(payload, scps_mk_fn1(bind_name, cont_body))\n  ECall(EIdent(scps_y_name(eff, opname), -1), payload, -1)\n}\n\nfn scps_mk_done(eff: String, v: Expr) -> Expr {\n  ECall(EIdent(scps_done_name(eff), -1), [\n    v\n  ], -1)\n}\n\n\nfn scps_ensure_effect_runtime(eff: String, ctx: (Array[Stmt], Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], Array[String], Array[Array[String]], Array[String]), st: (Array[Int], Array[String], Array[String], Array[String], Array[String], Array[Stmt], Array[String])) -> Unit {\n  let (_, injected, _, _, _, inj, _) = st\n  if edp_str_array_contains(injected, eff) {\n    ()\n  } else {\n    Array::push(injected, eff)\n    let (_, decl_ops) = scps_effect_decl_ops(ctx, eff)\n    let ctors = scps_empty_ctors()\n    let done_tys = scps_empty_tys()\n    Array::push(done_tys, TyName(\"Int\"))\n    Array::push(ctors, (scps_done_name(eff), done_tys))\n    let mut ei = 0\n    while ei < Array::length(decl_ops) {\n      let (opname, arity) = Array::get(decl_ops, ei)\n      let ytys = scps_empty_tys()\n      let mut ti = 0\n      while ti < arity + 1 {\n        Array::push(ytys, TyName(\"Int\"))\n        ti = ti + 1\n      }\n      Array::push(ctors, (scps_y_name(eff, opname), ytys))\n      ei = ei + 1\n    }\n    Array::push(inj, SEnum(false, scps_step_name(eff), array_empty_str(), ctors, array_empty_str()))\n    let bname = scps_bubble_name(eff)\n    let marms = scps_empty_arms()\n    let done_pats = scps_empty_pats()\n    Array::push(done_pats, PBind(\"__scps_bv\"))\n    Array::push(marms, (PCtor(scps_done_name(eff), done_pats), ECall(EIdent(\"__scps_bk\", -1), [\n      EIdent(\"__scps_bv\", -1)\n    ], -1)))\n    let mut bi = 0\n    while bi < Array::length(decl_ops) {\n      let (opname, arity) = Array::get(decl_ops, bi)\n      let ypats = scps_empty_pats()\n      let yargs = array_empty_expr()\n      let mut pi = 0\n      while pi < arity {\n        let pname = scps_local(\"__scps_bp\", pi)\n        Array::push(ypats, PBind(pname))\n        Array::push(yargs, EIdent(pname, -1))\n        pi = pi + 1\n      }\n      Array::push(ypats, PBind(\"__scps_bkk\"))\n      let rewrap = scps_mk_fn1(\"__scps_brv\", ECall(EIdent(bname, -1), [\n        ECall(EIdent(\"__scps_bkk\", -1), [\n          EIdent(\"__scps_brv\", -1)\n        ], -1),\n        EIdent(\"__scps_bk\", -1)\n      ], -1))\n      Array::push(yargs, rewrap)\n      Array::push(marms, (PCtor(scps_y_name(eff, opname), ypats), ECall(EIdent(scps_y_name(eff, opname), -1), yargs, -1)))\n      bi = bi + 1\n    }\n    let bfn = scps_mk_fn2(\"__scps_bst\", \"__scps_bk\", EMatch(EIdent(\"__scps_bst\", -1), marms))\n    Array::push(inj, SLet(false, true, bname, None, bfn))\n  }\n}\n\n\nfn scps_need_clone(eff: String, fname: String, st: (Array[Int], Array[String], Array[String], Array[String], Array[String], Array[Stmt], Array[String])) -> Unit {\n  let (_, _, clone_keys, q_eff, q_fn, _, _) = st\n  let key = String::concat(String::concat(eff, \"||\"), fname)\n  if edp_str_array_contains(clone_keys, key) {\n    ()\n  } else {\n    Array::push(clone_keys, key)\n    Array::push(q_eff, eff)\n    Array::push(q_fn, fname)\n  }\n}\n\n\nfn scps_split_tail(e: Expr, sctx: (String, Array[String], Array[String], Int, Array[String]), ctx: (Array[Stmt], Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], Array[String], Array[Array[String]], Array[String]), st: (Array[Int], Array[String], Array[String], Array[String], Array[String], Array[Stmt], Array[String])) -> (Bool, Expr) {\n  let (eff, ops, _, site, cps_locals) = sctx\n  if !scps_contains_susp(e, sctx) {\n    (true, scps_mk_done(eff, e))\n  } else {\n    let tail_idx = scps_as_target_perform(e, ops)\n    let tail_needing = scps_as_needing_call(e, sctx)\n    let tail_cps = scps_as_cps_local_call(e, sctx)\n    if tail_idx >= 0 {\n      let targs = scps_perform_args(e)\n      if scps_exprs_contain_susp(targs, sctx) {\n        (false, e)\n      } else {\n        let tv = scps_local(\"__scps_tv\", site)\n        (true, scps_mk_yield(eff, scps_op_suffix(Array::get(ops, tail_idx)), targs, tv, scps_mk_done(eff, EIdent(tv, -1))))\n      }\n    } else if tail_needing != \"\" {\n      let cargs = scps_call_args(e)\n      if scps_exprs_contain_susp(cargs, sctx) {\n        (false, e)\n      } else {\n        scps_need_clone(eff, tail_needing, st)\n        (true, ECall(EIdent(scps_clone_name(eff, tail_needing), -1), cargs, -1))\n      }\n    } else if tail_cps != \"\" {\n      let cargs = scps_call_args(e)\n      if scps_exprs_contain_susp(cargs, sctx) {\n        (false, e)\n      } else {\n        (true, e)\n      }\n    } else {\n      match e {\n        ELet(x, v, b, off) => {\n          let vp = scps_as_target_perform(v, ops)\n          let vn = scps_as_needing_call(v, sctx)\n          let vc = scps_as_cps_local_call(v, sctx)\n          if vp >= 0 {\n            let vargs = scps_perform_args(v)\n            if scps_exprs_contain_susp(vargs, sctx) {\n              (false, e)\n            } else {\n              let (bok, bexpr) = scps_split_tail(b, sctx, ctx, st)\n              (bok, scps_mk_yield(eff, scps_op_suffix(Array::get(ops, vp)), vargs, x, bexpr))\n            }\n          } else if vn != \"\" {\n            let vargs = scps_call_args(v)\n            if scps_exprs_contain_susp(vargs, sctx) {\n              (false, e)\n            } else {\n              scps_need_clone(eff, vn, st)\n              let (bok, bexpr) = scps_split_tail(b, sctx, ctx, st)\n              (bok, ECall(EIdent(scps_bubble_name(eff), -1), [\n                ECall(EIdent(scps_clone_name(eff, vn), -1), vargs, -1),\n                scps_mk_fn1(x, bexpr)\n              ], -1))\n            }\n          } else if vc != \"\" {\n            let vargs = scps_call_args(v)\n            if scps_exprs_contain_susp(vargs, sctx) {\n              (false, e)\n            } else {\n              let (bok, bexpr) = scps_split_tail(b, sctx, ctx, st)\n              (bok, ECall(EIdent(scps_bubble_name(eff), -1), [\n                v,\n                scps_mk_fn1(x, bexpr)\n              ], -1))\n            }\n          } else if scps_contains_susp(v, sctx) {\n            (false, e)\n          } else {\n            let is_step_lit = scps_literal_is_step_for(v, eff)\n            let (_, s_ops, s_needing, s_site, s_cps) = sctx\n            let sctx2 = if is_step_lit {\n              let ext = Array::slice(s_cps, 0, Array::length(s_cps))\n              Array::push(ext, x)\n              (eff, s_ops, s_needing, s_site, ext)\n            } else if edp_str_array_contains(s_cps, x) {\n              let masked = array_empty_str()\n              let mut mi = 0\n              while mi < Array::length(s_cps) {\n                let mnm = Array::get(s_cps, mi)\n                if mnm == x {\n                  ()\n                } else {\n                  Array::push(masked, mnm)\n                }\n                mi = mi + 1\n              }\n              (eff, s_ops, s_needing, s_site, masked)\n            } else {\n              sctx\n            }\n            let (bok, bexpr) = scps_split_tail(b, sctx2, ctx, st)\n            (bok, ELet(x, v, bexpr, off))\n          }\n        },\n        ESeq(a, b) => match a {\n          EWhile(wc, wb) => if scps_contains_susp(a, sctx) {\n            scps_split_while(wc, wb, b, sctx, ctx, st)\n          } else {\n            let (bok, bexpr) = scps_split_tail(b, sctx, ctx, st)\n            (bok, ESeq(a, bexpr))\n          },\n          _ => {\n            let ap = scps_as_target_perform(a, ops)\n            let an = scps_as_needing_call(a, sctx)\n            if ap >= 0 {\n              let aargs = scps_perform_args(a)\n              if scps_exprs_contain_susp(aargs, sctx) {\n                (false, e)\n              } else {\n                let (bok, bexpr) = scps_split_tail(b, sctx, ctx, st)\n                (bok, scps_mk_yield(eff, scps_op_suffix(Array::get(ops, ap)), aargs, scps_local(\"__scps_w\", site), bexpr))\n              }\n            } else if an != \"\" {\n              let aargs = scps_call_args(a)\n              if scps_exprs_contain_susp(aargs, sctx) {\n                (false, e)\n              } else {\n                scps_need_clone(eff, an, st)\n                let (bok, bexpr) = scps_split_tail(b, sctx, ctx, st)\n                (bok, ECall(EIdent(scps_bubble_name(eff), -1), [\n                  ECall(EIdent(scps_clone_name(eff, an), -1), aargs, -1),\n                  scps_mk_fn1(scps_local(\"__scps_w\", site), bexpr)\n                ], -1))\n              }\n            } else if scps_as_cps_local_call(a, sctx) != \"\" {\n              let aargs = scps_call_args(a)\n              if scps_exprs_contain_susp(aargs, sctx) {\n                (false, e)\n              } else {\n                let (bok, bexpr) = scps_split_tail(b, sctx, ctx, st)\n                (bok, ECall(EIdent(scps_bubble_name(eff), -1), [\n                  a,\n                  scps_mk_fn1(scps_local(\"__scps_w\", site), bexpr)\n                ], -1))\n              }\n            } else if scps_contains_susp(a, sctx) {\n              (false, e)\n            } else {\n              let (bok, bexpr) = scps_split_tail(b, sctx, ctx, st)\n              (bok, ESeq(a, bexpr))\n            }\n          }\n        },\n        EIf(c, t, el) => if scps_contains_susp(c, sctx) {\n          (false, e)\n        } else {\n          let (tok, te) = scps_split_tail(t, sctx, ctx, st)\n          let (eok, ee) = scps_split_tail(el, sctx, ctx, st)\n          if tok && eok {\n            (true, EIf(c, te, ee))\n          } else {\n            (false, e)\n          }\n        },\n        EMatch(s, arms) => if scps_contains_susp(s, sctx) {\n          (false, e)\n        } else {\n          let out = scps_empty_arms()\n          let mut ok = true\n          let mut i = 0\n          while i < Array::length(arms) {\n            let (mp, mb) = Array::get(arms, i)\n            let (aok, ae) = scps_split_tail(mb, sctx, ctx, st)\n            if !aok {\n              ok = false\n            } else {\n              ()\n            }\n            Array::push(out, (mp, ae))\n            i = i + 1\n          }\n          if ok {\n            (true, EMatch(s, out))\n          } else {\n            (false, e)\n          }\n        },\n        ELetMut(x, v, b, off) => if scps_contains_susp(v, sctx) {\n          (false, e)\n        } else {\n          let (_, s_ops, s_needing, s_site, s_cps) = sctx\n          let masked = array_empty_str()\n          let mut mi = 0\n          while mi < Array::length(s_cps) {\n            let mnm = Array::get(s_cps, mi)\n            if mnm == x {\n              ()\n            } else {\n              Array::push(masked, mnm)\n            }\n            mi = mi + 1\n          }\n          let sctx2 = (eff, s_ops, s_needing, s_site, masked)\n          let (bok, bexpr) = scps_split_tail(scps_cellify(b, x), sctx2, ctx, st)\n          let cell = array_empty_expr()\n          Array::push(cell, v)\n          (bok, ELet(x, EArray(cell), bexpr, off))\n        },\n        EWhile(c, b) => scps_split_while(c, b, EUnit, sctx, ctx, st),\n        _ => (false, e)\n      }\n    }\n  }\n}\n\n\nfn scps_has_loop_ctl(e: Expr) -> Bool {\n  match e {\n    EBreak(_) => true,\n    EContinue(_) => true,\n    EReturn(_) => true,\n    ELet(_, v, b, _) => scps_has_loop_ctl(v) || scps_has_loop_ctl(b),\n    ELetMut(_, v, b, _) => scps_has_loop_ctl(v) || scps_has_loop_ctl(b),\n    ELetRec(_, v, b) => scps_has_loop_ctl(v) || scps_has_loop_ctl(b),\n    ESeq(a, b) => scps_has_loop_ctl(a) || scps_has_loop_ctl(b),\n    EIf(c, t, el) => scps_has_loop_ctl(c) || scps_has_loop_ctl(t) || scps_has_loop_ctl(el),\n    EMatch(s, arms) => scps_has_loop_ctl(s) || scps_arms_have_loop_ctl(arms),\n    EHandle(b, arms) => scps_has_loop_ctl(b) || scps_arms_have_loop_ctl(arms),\n    EFn(_, _, _, _, _, _) => false,\n    EWhile(c, b) => scps_has_loop_ctl(c) || scps_has_loop_ctl(b),\n    EForIn(_, _, it, b) => scps_has_loop_ctl(it) || scps_has_loop_ctl(b),\n    ELoop(pairs, b) => scps_pairs_have_loop_ctl(pairs) || scps_has_loop_ctl(b),\n    ECall(callee, args, _) => scps_has_loop_ctl(callee) || scps_exprs_have_loop_ctl(args),\n    EBinOp(_, l, r) => scps_has_loop_ctl(l) || scps_has_loop_ctl(r),\n    EUnaryOp(_, a) => scps_has_loop_ctl(a),\n    EAssign(_, v, b) => scps_has_loop_ctl(v) || scps_has_loop_ctl(b),\n    EAssignOp(_, _, v, b) => scps_has_loop_ctl(v) || scps_has_loop_ctl(b),\n    EDot(o, _, _, _) => scps_has_loop_ctl(o),\n    ELabeledArg(_, _, v) => scps_has_loop_ctl(v),\n    ETuple(items) => scps_exprs_have_loop_ctl(items),\n    EArray(items) => scps_exprs_have_loop_ctl(items),\n    ERecord(_, fields, _) => scps_pairs_have_loop_ctl(fields),\n    EMap(fields) => scps_pairs_have_loop_ctl(fields),\n    ESpread(a) => scps_has_loop_ctl(a),\n    _ => false\n  }\n}\n\nfn scps_exprs_have_loop_ctl(es: Array[Expr]) -> Bool {\n  let mut i = 0\n  let mut hit = false\n  while i < Array::length(es) {\n    if scps_has_loop_ctl(Array::get(es, i)) {\n      hit = true\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  hit\n}\n\nfn scps_pairs_have_loop_ctl(pairs: Array[(String, Expr)]) -> Bool {\n  let mut i = 0\n  let mut hit = false\n  while i < Array::length(pairs) {\n    let (_, v) = Array::get(pairs, i)\n    if scps_has_loop_ctl(v) {\n      hit = true\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  hit\n}\n\nfn scps_arms_have_loop_ctl(arms: Array[(Pat, Expr)]) -> Bool {\n  let mut i = 0\n  let mut hit = false\n  while i < Array::length(arms) {\n    let (_, ex) = Array::get(arms, i)\n    if scps_has_loop_ctl(ex) {\n      hit = true\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  hit\n}\n\nfn scps_pat_binds_name(p: Pat, x: String) -> Bool {\n  match p {\n    PBind(n) => n == x,\n    PCtor(_, ps) => scps_pats_bind_name(ps, x),\n    PTuple(ps) => scps_pats_bind_name(ps, x),\n    POr(a, b) => scps_pat_binds_name(a, x) || scps_pat_binds_name(b, x),\n    PStruct(_, fields) => {\n      let mut i = 0\n      let mut hit = false\n      while i < Array::length(fields) {\n        let (_, fp) = Array::get(fields, i)\n        if scps_pat_binds_name(fp, x) {\n          hit = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      hit\n    },\n    _ => false\n  }\n}\n\nfn scps_pats_bind_name(ps: Array[Pat], x: String) -> Bool {\n  let mut i = 0\n  let mut hit = false\n  while i < Array::length(ps) {\n    if scps_pat_binds_name(Array::get(ps, i), x) {\n      hit = true\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  hit\n}\n\nfn scps_params_bind_name(params: Array[(String, Option[TypeExpr])], x: String) -> Bool {\n  let mut i = 0\n  let mut hit = false\n  while i < Array::length(params) {\n    let (nm, _) = Array::get(params, i)\n    if nm == x {\n      hit = true\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  hit\n}\n\nfn scps_cell_get(x: String, off: Int) -> Expr {\n  ECall(EIdent(\"Array::get\", -1), [\n    EIdent(x, off),\n    EInt(0)\n  ], -1)\n}\n\nfn scps_cell_set(x: String, v: Expr) -> Expr {\n  ECall(EIdent(\"Array::set\", -1), [\n    EIdent(x, -1),\n    EInt(0),\n    v\n  ], -1)\n}\n\nfn scps_cellify(e: Expr, x: String) -> Expr {\n  match e {\n    EIdent(nm, off) => if nm == x {\n      scps_cell_get(nm, off)\n    } else {\n      e\n    },\n    EAssign(nm, v, b) => if nm == x {\n      ESeq(scps_cell_set(nm, scps_cellify(v, x)), scps_cellify(b, x))\n    } else {\n      EAssign(nm, scps_cellify(v, x), scps_cellify(b, x))\n    },\n    EAssignOp(op, nm, v, b) => if nm == x {\n      ESeq(scps_cell_set(nm, EBinOp(op, scps_cell_get(nm, -1), scps_cellify(v, x))), scps_cellify(b, x))\n    } else {\n      EAssignOp(op, nm, scps_cellify(v, x), scps_cellify(b, x))\n    },\n    ELet(nm, v, b, off) => ELet(nm, scps_cellify(v, x), if nm == x {\n      b\n    } else {\n      scps_cellify(b, x)\n    }, off),\n    ELetMut(nm, v, b, off) => ELetMut(nm, scps_cellify(v, x), if nm == x {\n      b\n    } else {\n      scps_cellify(b, x)\n    }, off),\n    ELetRec(nm, v, b) => if nm == x {\n      e\n    } else {\n      ELetRec(nm, scps_cellify(v, x), scps_cellify(b, x))\n    },\n    ESeq(a, b) => ESeq(scps_cellify(a, x), scps_cellify(b, x)),\n    EIf(c, t, el) => EIf(scps_cellify(c, x), scps_cellify(t, x), scps_cellify(el, x)),\n    EMatch(s, arms) => EMatch(scps_cellify(s, x), scps_cellify_arms(arms, x)),\n    EHandle(b, arms) => EHandle(scps_cellify(b, x), scps_cellify_arms(arms, x)),\n    EFn(tps, tbs, params, rt, ef, b) => if scps_params_bind_name(params, x) {\n      e\n    } else {\n      EFn(tps, tbs, params, rt, ef, scps_cellify(b, x))\n    },\n    EWhile(c, b) => EWhile(scps_cellify(c, x), scps_cellify(b, x)),\n    EForIn(nm, idx, it, b) => {\n      let shadowed = nm == x || match idx {\n        Some(inm) => inm == x,\n        None => false\n      }\n      EForIn(nm, idx, scps_cellify(it, x), if shadowed {\n        b\n      } else {\n        scps_cellify(b, x)\n      })\n    },\n    ELoop(pairs, b) => {\n      let mut shadowed = false\n      let out = scps_empty_pairs()\n      let mut i = 0\n      while i < Array::length(pairs) {\n        let (nm, v) = Array::get(pairs, i)\n        if nm == x {\n          shadowed = true\n        } else {\n          ()\n        }\n        Array::push(out, (nm, scps_cellify(v, x)))\n        i = i + 1\n      }\n      ELoop(out, if shadowed {\n        b\n      } else {\n        scps_cellify(b, x)\n      })\n    },\n    ECall(callee, args, off) => ECall(scps_cellify(callee, x), scps_cellify_exprs(args, x), off),\n    EBinOp(op, l, r) => EBinOp(op, scps_cellify(l, x), scps_cellify(r, x)),\n    EUnaryOp(op, a) => EUnaryOp(op, scps_cellify(a, x)),\n    EReturn(a) => EReturn(scps_cellify(a, x)),\n    EDot(o, f, off, foff) => EDot(scps_cellify(o, x), f, off, foff),\n    ELabeledArg(l, m, v) => ELabeledArg(l, m, scps_cellify(v, x)),\n    EBreak(opt) => match opt {\n      Some(a) => EBreak(Some(scps_cellify(a, x))),\n      None => e\n    },\n    EContinue(args) => EContinue(scps_cellify_exprs(args, x)),\n    ETuple(items) => ETuple(scps_cellify_exprs(items, x)),\n    EArray(items) => EArray(scps_cellify_exprs(items, x)),\n    ERecord(rn, fields, targs) => ERecord(rn, scps_cellify_pairs(fields, x), targs),\n    EMap(fields) => EMap(scps_cellify_pairs(fields, x)),\n    ESpread(a) => ESpread(scps_cellify(a, x)),\n    _ => e\n  }\n}\n\nfn scps_empty_pairs() -> Array[(String, Expr)] {\n  Array::slice([\n    (\"\", EUnit)\n  ], 0, 0)\n}\n\nfn scps_cellify_exprs(es: Array[Expr], x: String) -> Array[Expr] {\n  let out = array_empty_expr()\n  let mut i = 0\n  while i < Array::length(es) {\n    Array::push(out, scps_cellify(Array::get(es, i), x))\n    i = i + 1\n  }\n  out\n}\n\nfn scps_cellify_pairs(pairs: Array[(String, Expr)], x: String) -> Array[(String, Expr)] {\n  let out = scps_empty_pairs()\n  let mut i = 0\n  while i < Array::length(pairs) {\n    let (nm, v) = Array::get(pairs, i)\n    Array::push(out, (nm, scps_cellify(v, x)))\n    i = i + 1\n  }\n  out\n}\n\nfn scps_cellify_arms(arms: Array[(Pat, Expr)], x: String) -> Array[(Pat, Expr)] {\n  let out = scps_empty_arms()\n  let mut i = 0\n  while i < Array::length(arms) {\n    let (p, ex) = Array::get(arms, i)\n    Array::push(out, (p, if scps_pat_binds_name(p, x) {\n      ex\n    } else {\n      scps_cellify(ex, x)\n    }))\n    i = i + 1\n  }\n  out\n}\n\nfn scps_seq_append(e: Expr, k: Expr) -> Expr {\n  match e {\n    ELet(x, v, b, off) => ELet(x, v, scps_seq_append(b, k), off),\n    ELetMut(x, v, b, off) => ELetMut(x, v, scps_seq_append(b, k), off),\n    ELetRec(x, v, b) => ELetRec(x, v, scps_seq_append(b, k)),\n    ESeq(a, b) => ESeq(a, scps_seq_append(b, k)),\n    EAssign(nm, v, b) => EAssign(nm, v, scps_seq_append(b, k)),\n    EAssignOp(op, nm, v, b) => EAssignOp(op, nm, v, scps_seq_append(b, k)),\n    EIf(c, t, el) => EIf(c, scps_seq_append(t, k), scps_seq_append(el, k)),\n    EMatch(s, arms) => {\n      let out = scps_empty_arms()\n      let mut i = 0\n      while i < Array::length(arms) {\n        let (p, ex) = Array::get(arms, i)\n        Array::push(out, (p, scps_seq_append(ex, k)))\n        i = i + 1\n      }\n      EMatch(s, out)\n    },\n    EUnit => k,\n    _ => ESeq(e, k)\n  }\n}\n\nfn scps_split_while(c: Expr, body: Expr, rest: Expr, sctx: (String, Array[String], Array[String], Int, Array[String]), ctx: (Array[Stmt], Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], Array[String], Array[Array[String]], Array[String]), st: (Array[Int], Array[String], Array[String], Array[String], Array[String], Array[Stmt], Array[String])) -> (Bool, Expr) {\n  let (eff, s_ops, s_needing, s_site, s_cps) = sctx\n  let orig = ESeq(EWhile(c, body), rest)\n  if scps_contains_susp(c, sctx) || scps_has_loop_ctl(body) {\n    (false, orig)\n  } else {\n    let lp = scps_local(\"__scps_lp\", scps_next_site(st))\n    let ext = Array::slice(s_cps, 0, Array::length(s_cps))\n    Array::push(ext, lp)\n    let sctx2 = (eff, s_ops, s_needing, s_site, ext)\n    let step = scps_seq_append(body, ECall(EIdent(lp, -1), array_empty_expr(), -1))\n    let (iok, ibody) = scps_split_tail(step, sctx2, ctx, st)\n    let (rok, rbody) = scps_split_tail(rest, sctx2, ctx, st)\n    if iok && rok {\n      let lam = EFn(array_empty_str(), scps_empty_tbs(), scps_empty_params(), None, None, EIf(c, ibody, rbody))\n      (true, ELetRec(lp, lam, ECall(EIdent(lp, -1), array_empty_expr(), -1)))\n    } else {\n      (false, orig)\n    }\n  }\n}\n\n\nfn scps_transform_handle(body: Expr, arms: Array[(Pat, Expr)], ctx: (Array[Stmt], Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], Array[String], Array[Array[String]], Array[String]), st: (Array[Int], Array[String], Array[String], Array[String], Array[String], Array[Stmt], Array[String]), scope: Array[(String, String)]) -> Option[Expr] {\n  let errs = scps_st_errs(st)\n  let mut eff = \"\"\n  let mut shape_ok = true\n  let mut si = 0\n  while si < Array::length(arms) {\n    let (p, _) = Array::get(arms, si)\n    match p {\n      PCtor(q, _) => {\n        let ci = String::index_of(q, \"::\")\n        if ci > 0 {\n          let qe = String::substring(q, 0, ci)\n          if eff == \"\" {\n            eff = qe\n          } else if eff == qe {\n            ()\n          } else {\n            shape_ok = false\n          }\n        } else {\n          shape_ok = false\n        }\n      },\n      _ => {\n        shape_ok = false\n      }\n    }\n    si = si + 1\n  }\n  let (eff_declared, decl_ops) = scps_effect_decl_ops(ctx, eff)\n  if !shape_ok || idp_arms_discharge_error(arms) || !eff_declared {\n    Array::push(errs, \"a handler arm captures `resume` as a value, but this handle has an Error arm (Error is non-resumable, #640), mixes effects, or handles a non-declared effect -- not supported by the suspend lowering (#817, ADR-0076)\")\n    None\n  } else {\n    let ops_qnames = array_empty_str()\n    let mut oi = 0\n    while oi < Array::length(decl_ops) {\n      let (opname, _) = Array::get(decl_ops, oi)\n      Array::push(ops_qnames, String::concat(String::concat(eff, \"::\"), opname))\n      oi = oi + 1\n    }\n    let needing = scps_needing_for(ctx, eff)\n    let site = scps_next_site(st)\n    let cps_seed = array_empty_str()\n    let seen_scope = array_empty_str()\n    let mut sci = Array::length(scope) - 1\n    while sci >= 0 {\n      let (snm, srow) = Array::get(scope, sci)\n      if edp_str_array_contains(seen_scope, snm) {\n        ()\n      } else {\n        Array::push(seen_scope, snm)\n        if srow != \"\" && scps_row_contains(ctx, srow, eff) {\n          Array::push(cps_seed, snm)\n        } else {\n          ()\n        }\n      }\n      sci = sci - 1\n    }\n    let sctx = (eff, ops_qnames, needing, site, cps_seed)\n    if !scps_calls_ok(body, sctx, ctx) {\n      Array::push(errs, \"a handler arm captures `resume` as a value (suspend class, ADR-0076 Phase 3a/3b), but the handle body calls something this suspend lowering cannot see through (a local closure, a method-style callee, a nested handle, or a function whose declared row has a row variable) -- only `perform`, pure builtins, constructors, provably effect-free functions, and functions whose concrete row carries the handled effect may be called in the handled body (#817)\")\n      None\n    } else {\n      let (split_ok, split_body) = scps_split_tail(body, sctx, ctx, st)\n      if !split_ok {\n        Array::push(errs, \"a handler arm captures `resume` as a value (suspend class, ADR-0076 Phase 3a/3b), but a perform of the handled effect (or a call to a function that performs it) is not directly on the handle body's let/seq/tail/branch-tail spine (a `while` loop carrying `break`/`continue`/`return`, a `for`/`loop` form, nested closures/handles, and nested expression positions are not eligible; a plain `while` + `let mut` spine is, #1230) (#817)\")\n        None\n      } else {\n        scps_ensure_effect_runtime(eff, ctx, st)\n        let drive = scps_local(\"__scps_drive\", site)\n        let kname = scps_local(\"__scps_k\", site)\n        let once = scps_local(\"__scps_once\", site)\n        let rv = scps_local(\"__scps_rv\", site)\n        let vname = scps_local(\"__scps_v\", site)\n        let dmarms = scps_empty_arms()\n        let done_pats = scps_empty_pats()\n        Array::push(done_pats, PBind(vname))\n        Array::push(dmarms, (PCtor(scps_done_name(eff), done_pats), EIdent(vname, -1)))\n        let mut di = 0\n        while di < Array::length(arms) {\n          let (p, ab) = Array::get(arms, di)\n          let (aq, subpats) = match p {\n            PCtor(q, sp) => (q, sp),\n            _ => (\"\", scps_empty_pats())\n          }\n          let ypats = scps_empty_pats()\n          let mut pi = 0\n          while pi < Array::length(subpats) {\n            Array::push(ypats, Array::get(subpats, pi))\n            pi = pi + 1\n          }\n          Array::push(ypats, PBind(kname))\n          let once_get = ECall(EIdent(\"Array::get\", -1), [\n            EIdent(once, -1),\n            EInt(0)\n          ], -1)\n          let trap = ESeq(ECall(EIdent(\"Stderr::write_stream\", -1), [\n            EString(\"vibe: resume one-shot continuation called twice (#817, ADR-0076 Phase 3a)\\n\")\n          ], -1), ECall(EIdent(\"Array::get\", -1), [\n            EArray([\n              EInt(0)\n            ]),\n            EInt(1)\n          ], -1))\n          let set_true = ECall(EIdent(\"Array::set\", -1), [\n            EIdent(once, -1),\n            EInt(0),\n            EBool(true)\n          ], -1)\n          let drive_call = ECall(EIdent(drive, -1), [\n            ECall(EIdent(kname, -1), [\n              EIdent(rv, -1)\n            ], -1)\n          ], -1)\n          let rfn = scps_mk_fn1(rv, EIf(once_get, trap, ESeq(set_true, drive_call)))\n          let lowered = ELet(once, EArray([\n            EBool(false)\n          ]), ELet(\"resume\", rfn, ab, -1), -1)\n          Array::push(dmarms, (PCtor(scps_y_name(eff, scps_op_suffix(aq)), ypats), lowered))\n          di = di + 1\n        }\n        let stn = scps_local(\"__scps_st\", site)\n        let dfn = scps_mk_fn1(stn, EMatch(EIdent(stn, -1), dmarms))\n        Some(ELetRec(drive, dfn, ECall(EIdent(drive, -1), [\n          split_body\n        ], -1)))\n      }\n    }\n  }\n}\n\n\nfn scps_emit_clone(eff: String, fname: String, ctx: (Array[Stmt], Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], Array[String], Array[Array[String]], Array[String]), st: (Array[Int], Array[String], Array[String], Array[String], Array[String], Array[Stmt], Array[String])) -> Unit {\n  let (stmts, _, fn_defs, _, _, _) = ctx\n  let errs = scps_st_errs(st)\n  let mut def_idx = -1\n  let mut fi = 0\n  while fi < Array::length(fn_defs) {\n    let (idx, _, _, name, _, _) = Array::get(fn_defs, fi)\n    if name == fname {\n      def_idx = idx\n    } else {\n      ()\n    }\n    fi = fi + 1\n  }\n  if def_idx < 0 {\n    Array::push(errs, String::concat(String::concat(\"suspend lowering: internal error -- no top-level definition found for `\", fname), \"` while emitting its CPS clone (#817)\"))\n  } else {\n    match Array::get(stmts, def_idx) {\n      SLet(_, _, _, _, EFn(tps, tbs, params, _, _, fbody)) => {\n        scps_ensure_effect_runtime(eff, ctx, st)\n        let (_, decl_ops) = scps_effect_decl_ops(ctx, eff)\n        let ops_qnames = array_empty_str()\n        let mut oi = 0\n        while oi < Array::length(decl_ops) {\n          let (opname, _) = Array::get(decl_ops, oi)\n          Array::push(ops_qnames, String::concat(String::concat(eff, \"::\"), opname))\n          oi = oi + 1\n        }\n        let needing = scps_needing_for(ctx, eff)\n        let site = scps_next_site(st)\n        let cps_seed = array_empty_str()\n        let mut cpi = 0\n        while cpi < Array::length(params) {\n          let (pnm, pty) = Array::get(params, cpi)\n          let prow = scps_ty_row(pty)\n          if prow != \"\" && scps_row_contains(ctx, prow, eff) {\n            Array::push(cps_seed, pnm)\n          } else {\n            ()\n          }\n          cpi = cpi + 1\n        }\n        let sctx = (eff, ops_qnames, needing, site, cps_seed)\n        if !scps_calls_ok(fbody, sctx, ctx) {\n          Array::push(errs, String::concat(String::concat(String::concat(\"function `\", fname), String::concat(\"` (whose row carries \", eff)), \") is called from a suspend-class handle body, but its own body calls something the suspend lowering cannot see through (a local closure, a method-style callee, a nested handle, or a row-variable callee) (#817, ADR-0076 Phase 3b)\"))\n        } else {\n          let (split_ok, split_body) = scps_split_tail(fbody, sctx, ctx, st)\n          if !split_ok {\n            Array::push(errs, String::concat(String::concat(String::concat(\"function `\", fname), String::concat(\"` (whose row carries \", eff)), \") is called from a suspend-class handle body, but a perform of that effect (or a call to a function that performs it) is not directly on its body's let/seq/tail/branch-tail spine (a `while` loop carrying `break`/`continue`/`return`, a `for`/`loop` form, nested closures/handles, and nested expression positions are not eligible; a plain `while` + `let mut` spine is, #1230) (#817, ADR-0076 Phase 3b)\"))\n          } else {\n            Array::push(scps_st_inj(st), SLet(false, true, scps_clone_name(eff, fname), None, EFn(tps, tbs, params, None, None, split_body)))\n          }\n        }\n      },\n      _ => Array::push(errs, String::concat(String::concat(\"suspend lowering: internal error -- `\", fname), \"` is not a plain top-level function definition (#817)\"))\n    }\n  }\n}\n\n\nfn scps_scope_push_pat(p: Pat, scope: Array[(String, String)]) -> Unit {\n  match p {\n    PBind(n) => Array::push(scope, (n, \"\")),\n    PCtor(_, ps) => {\n      let mut i = 0\n      while i < Array::length(ps) {\n        scps_scope_push_pat(Array::get(ps, i), scope)\n        i = i + 1\n      }\n    },\n    PTuple(ps) => {\n      let mut i = 0\n      while i < Array::length(ps) {\n        scps_scope_push_pat(Array::get(ps, i), scope)\n        i = i + 1\n      }\n    },\n    POr(a, b) => {\n      scps_scope_push_pat(a, scope)\n      scps_scope_push_pat(b, scope)\n    },\n    PStruct(_, fields) => {\n      let mut i = 0\n      while i < Array::length(fields) {\n        let (_, fp) = Array::get(fields, i)\n        scps_scope_push_pat(fp, scope)\n        i = i + 1\n      }\n    },\n    _ => ()\n  }\n}\n\nfn scps_let_bind_row(v: Expr, cps_effs: Array[String]) -> String {\n  let mut row = \"\"\n  let mut i = 0\n  while i < Array::length(cps_effs) {\n    let eff = Array::get(cps_effs, i)\n    if row == \"\" && scps_literal_is_step_for(v, eff) {\n      row = eff\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  row\n}\n\nfn scps_rewrite(e: Expr, ctx: (Array[Stmt], Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], Array[String], Array[Array[String]], Array[String]), st: (Array[Int], Array[String], Array[String], Array[String], Array[String], Array[Stmt], Array[String]), cps_effs: Array[String], scope: Array[(String, String)]) -> Expr {\n  match e {\n    EHandle(body, arms) => {\n      let rbody = scps_rewrite(body, ctx, st, cps_effs, scope)\n      let rarms = for a in arms {\n        let (p, ex) = a\n        let amark = Array::length(scope)\n        scps_scope_push_pat(p, scope)\n        let rex = scps_rewrite(ex, ctx, st, cps_effs, scope)\n        Array::truncate(scope, amark)\n        (p, rex)\n      }\n      let mut triggered = false\n      let mut ai = 0\n      while ai < Array::length(rarms) {\n        let (ap, ab) = Array::get(rarms, ai)\n        if scps_arm_refs_resume_value(ab, scps_pat_binds_resume(ap)) {\n          triggered = true\n        } else {\n          ()\n        }\n        ai = ai + 1\n      }\n      if triggered {\n        match scps_transform_handle(rbody, rarms, ctx, st, scope) {\n          Some(t) => t,\n          None => EHandle(rbody, rarms)\n        }\n      } else {\n        EHandle(rbody, rarms)\n      }\n    },\n    EFn(tps, tbs, params, ret, eff, b) => {\n      let fmark = Array::length(scope)\n      let mut fpi = 0\n      while fpi < Array::length(params) {\n        let (pnm, pty) = Array::get(params, fpi)\n        Array::push(scope, (pnm, scps_ty_row(pty)))\n        fpi = fpi + 1\n      }\n      let rb = scps_rewrite(b, ctx, st, cps_effs, scope)\n      Array::truncate(scope, fmark)\n      EFn(tps, tbs, params, ret, eff, rb)\n    },\n    ELet(n, v, b, off) => {\n      let rv = scps_rewrite(v, ctx, st, cps_effs, scope)\n      let lmark = Array::length(scope)\n      Array::push(scope, (n, scps_let_bind_row(rv, cps_effs)))\n      let rb = scps_rewrite(b, ctx, st, cps_effs, scope)\n      Array::truncate(scope, lmark)\n      ELet(n, rv, rb, off)\n    },\n    ELetMut(n, v, b, off) => {\n      let rv = scps_rewrite(v, ctx, st, cps_effs, scope)\n      let lmark = Array::length(scope)\n      Array::push(scope, (n, \"\"))\n      let rb = scps_rewrite(b, ctx, st, cps_effs, scope)\n      Array::truncate(scope, lmark)\n      ELetMut(n, rv, rb, off)\n    },\n    ELetRec(n, v, b) => {\n      let lmark = Array::length(scope)\n      Array::push(scope, (n, \"\"))\n      let rv = scps_rewrite(v, ctx, st, cps_effs, scope)\n      let rb = scps_rewrite(b, ctx, st, cps_effs, scope)\n      Array::truncate(scope, lmark)\n      ELetRec(n, rv, rb)\n    },\n    ESeq(a, b) => ESeq(scps_rewrite(a, ctx, st, cps_effs, scope), scps_rewrite(b, ctx, st, cps_effs, scope)),\n    EIf(c, t, el) => EIf(scps_rewrite(c, ctx, st, cps_effs, scope), scps_rewrite(t, ctx, st, cps_effs, scope), scps_rewrite(el, ctx, st, cps_effs, scope)),\n    EMatch(s, arms) => EMatch(scps_rewrite(s, ctx, st, cps_effs, scope), for a in arms {\n      let (p, ex) = a\n      let amark = Array::length(scope)\n      scps_scope_push_pat(p, scope)\n      let rex = scps_rewrite(ex, ctx, st, cps_effs, scope)\n      Array::truncate(scope, amark)\n      (p, rex)\n    }),\n    EWhile(c, b) => EWhile(scps_rewrite(c, ctx, st, cps_effs, scope), scps_rewrite(b, ctx, st, cps_effs, scope)),\n    EForIn(n, idx, it, b) => {\n      let rit = scps_rewrite(it, ctx, st, cps_effs, scope)\n      let fmark = Array::length(scope)\n      Array::push(scope, (n, \"\"))\n      match idx {\n        Some(ix) => Array::push(scope, (ix, \"\")),\n        None => ()\n      }\n      let rb = scps_rewrite(b, ctx, st, cps_effs, scope)\n      Array::truncate(scope, fmark)\n      EForIn(n, idx, rit, rb)\n    },\n    ECall(callee, args, off) => ECall(scps_rewrite(callee, ctx, st, cps_effs, scope), for a in args {\n      scps_rewrite(a, ctx, st, cps_effs, scope)\n    }, off),\n    EBinOp(op, l, r) => EBinOp(op, scps_rewrite(l, ctx, st, cps_effs, scope), scps_rewrite(r, ctx, st, cps_effs, scope)),\n    EUnaryOp(op, e2) => EUnaryOp(op, scps_rewrite(e2, ctx, st, cps_effs, scope)),\n    EAssign(n, v, c) => EAssign(n, scps_rewrite(v, ctx, st, cps_effs, scope), scps_rewrite(c, ctx, st, cps_effs, scope)),\n    EAssignOp(n, op, v, c) => EAssignOp(n, op, scps_rewrite(v, ctx, st, cps_effs, scope), scps_rewrite(c, ctx, st, cps_effs, scope)),\n    EDot(o, f, off1, off2) => EDot(scps_rewrite(o, ctx, st, cps_effs, scope), f, off1, off2),\n    ELabeledArg(l, n, v) => ELabeledArg(l, n, scps_rewrite(v, ctx, st, cps_effs, scope)),\n    EReturn(e2) => EReturn(scps_rewrite(e2, ctx, st, cps_effs, scope)),\n    EBreak(opt) => EBreak(match opt {\n      Some(e2) => Some(scps_rewrite(e2, ctx, st, cps_effs, scope)),\n      None => None\n    }),\n    EContinue(args) => EContinue(for a in args {\n      scps_rewrite(a, ctx, st, cps_effs, scope)\n    }),\n    ETuple(elems) => ETuple(for a in elems {\n      scps_rewrite(a, ctx, st, cps_effs, scope)\n    }),\n    EArray(elems) => EArray(for a in elems {\n      scps_rewrite(a, ctx, st, cps_effs, scope)\n    }),\n    ERecord(n, fields, tas) => ERecord(n, for f in fields {\n      let (fn2, v) = f\n      (fn2, scps_rewrite(v, ctx, st, cps_effs, scope))\n    }, tas),\n    EMap(fields) => EMap(for f in fields {\n      let (fn2, v) = f\n      (fn2, scps_rewrite(v, ctx, st, cps_effs, scope))\n    }),\n    ESpread(e2) => ESpread(scps_rewrite(e2, ctx, st, cps_effs, scope)),\n    ELoop(pairs, b) => {\n      let rpairs = for p in pairs {\n        let (n, v) = p\n        (n, scps_rewrite(v, ctx, st, cps_effs, scope))\n      }\n      let lmark = Array::length(scope)\n      let mut lpi = 0\n      while lpi < Array::length(pairs) {\n        let (n, _) = Array::get(pairs, lpi)\n        Array::push(scope, (n, \"\"))\n        lpi = lpi + 1\n      }\n      let rb = scps_rewrite(b, ctx, st, cps_effs, scope)\n      Array::truncate(scope, lmark)\n      ELoop(rpairs, rb)\n    },\n    _ => e\n  }\n}\n\nfn scps_is_safe_mut_builtin(nm: String) -> Bool {\n  let names = [\n    \"Array::push\",\n    \"Array::set\",\n    \"Array::slice\",\n    \"ArrayBuilder::new\",\n    \"ArrayBuilder::push\",\n    \"ArrayBuilder::freeze\",\n    \"Map::set\",\n    \"Map::delete\",\n    \"Bytes::set\",\n    \"StringBuilder::new\",\n    \"StringBuilder::push\",\n    \"StringBuilder::freeze\",\n    \"__set_field\",\n    \"__index\",\n    \"assert\"\n  ]\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(names) {\n    if Array::get(names, i) == nm {\n      found = true\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  found\n}\n\n\nfn scps_collect_cps_effs_expr(e: Expr, out: Array[String]) -> Unit {\n  match e {\n    EHandle(b, arms) => {\n      scps_collect_cps_effs_expr(b, out)\n      let mut i = 0\n      while i < Array::length(arms) {\n        let (p, ex) = Array::get(arms, i)\n        if scps_arm_refs_resume_value(ex, scps_pat_binds_resume(p)) {\n          match p {\n            PCtor(q, _) => {\n              let ci = String::index_of(q, \"::\")\n              if ci > 0 {\n                let qe = String::substring(q, 0, ci)\n                if edp_str_array_contains(out, qe) {\n                  ()\n                } else {\n                  Array::push(out, qe)\n                }\n              } else {\n                ()\n              }\n            },\n            _ => ()\n          }\n        } else {\n          ()\n        }\n        scps_collect_cps_effs_expr(ex, out)\n        i = i + 1\n      }\n    },\n    EFn(_, _, _, _, _, b) => scps_collect_cps_effs_expr(b, out),\n    ELet(_, v, b, _) => {\n      scps_collect_cps_effs_expr(v, out)\n      scps_collect_cps_effs_expr(b, out)\n    },\n    ELetMut(_, v, b, _) => {\n      scps_collect_cps_effs_expr(v, out)\n      scps_collect_cps_effs_expr(b, out)\n    },\n    ELetRec(_, v, b) => {\n      scps_collect_cps_effs_expr(v, out)\n      scps_collect_cps_effs_expr(b, out)\n    },\n    ESeq(a, b) => {\n      scps_collect_cps_effs_expr(a, out)\n      scps_collect_cps_effs_expr(b, out)\n    },\n    EIf(c, t, el) => {\n      scps_collect_cps_effs_expr(c, out)\n      scps_collect_cps_effs_expr(t, out)\n      scps_collect_cps_effs_expr(el, out)\n    },\n    EMatch(s, arms) => {\n      scps_collect_cps_effs_expr(s, out)\n      let mut i = 0\n      while i < Array::length(arms) {\n        let (_, ex) = Array::get(arms, i)\n        scps_collect_cps_effs_expr(ex, out)\n        i = i + 1\n      }\n    },\n    ECall(callee, args, _) => {\n      scps_collect_cps_effs_expr(callee, out)\n      let mut i = 0\n      while i < Array::length(args) {\n        scps_collect_cps_effs_expr(Array::get(args, i), out)\n        i = i + 1\n      }\n    },\n    EWhile(c, b) => {\n      scps_collect_cps_effs_expr(c, out)\n      scps_collect_cps_effs_expr(b, out)\n    },\n    EForIn(_, _, it, b) => {\n      scps_collect_cps_effs_expr(it, out)\n      scps_collect_cps_effs_expr(b, out)\n    },\n    ELoop(pairs, b) => {\n      let mut i = 0\n      while i < Array::length(pairs) {\n        let (_, v) = Array::get(pairs, i)\n        scps_collect_cps_effs_expr(v, out)\n        i = i + 1\n      }\n      scps_collect_cps_effs_expr(b, out)\n    },\n    EBinOp(_, l, r) => {\n      scps_collect_cps_effs_expr(l, out)\n      scps_collect_cps_effs_expr(r, out)\n    },\n    EUnaryOp(_, x) => scps_collect_cps_effs_expr(x, out),\n    EAssign(_, v, c) => {\n      scps_collect_cps_effs_expr(v, out)\n      scps_collect_cps_effs_expr(c, out)\n    },\n    EAssignOp(_, _, v, c) => {\n      scps_collect_cps_effs_expr(v, out)\n      scps_collect_cps_effs_expr(c, out)\n    },\n    EReturn(x) => scps_collect_cps_effs_expr(x, out),\n    EDot(o, _, _, _) => scps_collect_cps_effs_expr(o, out),\n    ELabeledArg(_, _, v) => scps_collect_cps_effs_expr(v, out),\n    EBreak(opt) => match opt {\n      Some(x) => scps_collect_cps_effs_expr(x, out),\n      None => ()\n    },\n    EContinue(args) => {\n      let mut i = 0\n      while i < Array::length(args) {\n        scps_collect_cps_effs_expr(Array::get(args, i), out)\n        i = i + 1\n      }\n    },\n    ETuple(items) => {\n      let mut i = 0\n      while i < Array::length(items) {\n        scps_collect_cps_effs_expr(Array::get(items, i), out)\n        i = i + 1\n      }\n    },\n    EArray(items) => {\n      let mut i = 0\n      while i < Array::length(items) {\n        scps_collect_cps_effs_expr(Array::get(items, i), out)\n        i = i + 1\n      }\n    },\n    ERecord(_, fields, _) => {\n      let mut i = 0\n      while i < Array::length(fields) {\n        let (_, v) = Array::get(fields, i)\n        scps_collect_cps_effs_expr(v, out)\n        i = i + 1\n      }\n    },\n    EMap(fields) => {\n      let mut i = 0\n      while i < Array::length(fields) {\n        let (_, v) = Array::get(fields, i)\n        scps_collect_cps_effs_expr(v, out)\n        i = i + 1\n      }\n    },\n    ESpread(x) => scps_collect_cps_effs_expr(x, out),\n    _ => ()\n  }\n}\n\nfn scps_stmt_expr_of(s: Stmt) -> Option[Expr] {\n  match s {\n    SLet(_, _, _, _, expr) => Some(expr),\n    SLetMut(_, _, expr) => Some(expr),\n    SExpr(expr) => Some(expr),\n    STest(_, expr) => Some(expr),\n    SBench(_, expr) => Some(expr),\n    _ => None\n  }\n}\n\nfn scps_collect_cps_effs(stmts: Array[Stmt]) -> Array[String] {\n  let out = array_empty_str()\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match scps_stmt_expr_of(Array::get(stmts, i)) {\n      Some(expr) => scps_collect_cps_effs_expr(expr, out),\n      None => ()\n    }\n    i = i + 1\n  }\n  out\n}\n\n\nfn scps_lit_needs(e: Expr, sctx: (String, Array[String], Array[String], Int, Array[String])) -> Bool {\n  let (eff, ops, _, _, _) = sctx\n  if scps_as_target_perform(e, ops) >= 0 || scps_as_needing_call(e, sctx) != \"\" {\n    true\n  } else {\n    match e {\n      EHandle(b, arms) => {\n        let mut discharges = false\n        if Array::length(arms) > 0 {\n          let (p0, _) = Array::get(arms, 0)\n          match p0 {\n            PCtor(q, _) => {\n              let ci = String::index_of(q, \"::\")\n              if ci > 0 && String::substring(q, 0, ci) == eff {\n                discharges = true\n              } else {\n                ()\n              }\n            },\n            _ => ()\n          }\n        } else {\n          ()\n        }\n        if discharges {\n          false\n        } else {\n          let mut hit = scps_lit_needs(b, sctx)\n          let mut i = 0\n          while i < Array::length(arms) {\n            let (_, ex) = Array::get(arms, i)\n            if scps_lit_needs(ex, sctx) {\n              hit = true\n            } else {\n              ()\n            }\n            i = i + 1\n          }\n          hit\n        }\n      },\n      ECall(callee, args, _) => scps_lit_needs(callee, sctx) || scps_exprs_lit_need(args, sctx),\n      ELet(_, v, b, _) => scps_lit_needs(v, sctx) || scps_lit_needs(b, sctx),\n      ELetMut(_, v, b, _) => scps_lit_needs(v, sctx) || scps_lit_needs(b, sctx),\n      ELetRec(_, v, b) => scps_lit_needs(v, sctx) || scps_lit_needs(b, sctx),\n      ESeq(a, b) => scps_lit_needs(a, sctx) || scps_lit_needs(b, sctx),\n      EIf(c, t, el) => scps_lit_needs(c, sctx) || scps_lit_needs(t, sctx) || scps_lit_needs(el, sctx),\n      EMatch(s, arms) => {\n        let mut hit = scps_lit_needs(s, sctx)\n        let mut i = 0\n        while i < Array::length(arms) {\n          let (_, ex) = Array::get(arms, i)\n          if scps_lit_needs(ex, sctx) {\n            hit = true\n          } else {\n            ()\n          }\n          i = i + 1\n        }\n        hit\n      },\n      EFn(_, _, _, _, _, b) => scps_lit_needs(b, sctx),\n      EWhile(c, b) => scps_lit_needs(c, sctx) || scps_lit_needs(b, sctx),\n      EForIn(_, _, it, b) => scps_lit_needs(it, sctx) || scps_lit_needs(b, sctx),\n      ELoop(pairs, b) => {\n        let mut hit = scps_lit_needs(b, sctx)\n        let mut i = 0\n        while i < Array::length(pairs) {\n          let (_, v) = Array::get(pairs, i)\n          if scps_lit_needs(v, sctx) {\n            hit = true\n          } else {\n            ()\n          }\n          i = i + 1\n        }\n        hit\n      },\n      EBinOp(_, l, r) => scps_lit_needs(l, sctx) || scps_lit_needs(r, sctx),\n      EUnaryOp(_, x) => scps_lit_needs(x, sctx),\n      EAssign(_, v, c) => scps_lit_needs(v, sctx) || scps_lit_needs(c, sctx),\n      EAssignOp(_, _, v, c) => scps_lit_needs(v, sctx) || scps_lit_needs(c, sctx),\n      EReturn(x) => scps_lit_needs(x, sctx),\n      EDot(o, _, _, _) => scps_lit_needs(o, sctx),\n      ELabeledArg(_, _, v) => scps_lit_needs(v, sctx),\n      EBreak(opt) => match opt {\n        Some(x) => scps_lit_needs(x, sctx),\n        None => false\n      },\n      EContinue(args) => scps_exprs_lit_need(args, sctx),\n      ETuple(items) => scps_exprs_lit_need(items, sctx),\n      EArray(items) => scps_exprs_lit_need(items, sctx),\n      ERecord(_, fields, _) => scps_fields_lit_need(fields, sctx),\n      EMap(fields) => scps_fields_lit_need(fields, sctx),\n      ESpread(x) => scps_lit_needs(x, sctx),\n      _ => false\n    }\n  }\n}\n\nfn scps_exprs_lit_need(es: Array[Expr], sctx: (String, Array[String], Array[String], Int, Array[String])) -> Bool {\n  let mut i = 0\n  let mut hit = false\n  while i < Array::length(es) {\n    if scps_lit_needs(Array::get(es, i), sctx) {\n      hit = true\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  hit\n}\n\nfn scps_fields_lit_need(fields: Array[(String, Expr)], sctx: (String, Array[String], Array[String], Int, Array[String])) -> Bool {\n  let mut i = 0\n  let mut hit = false\n  while i < Array::length(fields) {\n    let (_, v) = Array::get(fields, i)\n    if scps_lit_needs(v, sctx) {\n      hit = true\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  hit\n}\n\n\nfn scps_ecfg_for(ctx: (Array[Stmt], Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], Array[String], Array[Array[String]], Array[String]), eff: String) -> (String, Array[String], Array[String]) {\n  let (_, decl_ops) = scps_effect_decl_ops(ctx, eff)\n  let ops_qnames = array_empty_str()\n  let mut oi = 0\n  while oi < Array::length(decl_ops) {\n    let (opname, _) = Array::get(decl_ops, oi)\n    Array::push(ops_qnames, String::concat(String::concat(eff, \"::\"), opname))\n    oi = oi + 1\n  }\n  (eff, ops_qnames, scps_needing_for(ctx, eff))\n}\n\nfn scps_fn_def_params(ctx: (Array[Stmt], Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], Array[String], Array[Array[String]], Array[String]), name: String) -> Option[Array[(String, Option[TypeExpr])]] {\n  let (stmts, _, fn_defs, _, _, _) = ctx\n  let mut def_idx = -1\n  let mut fi = 0\n  while fi < Array::length(fn_defs) {\n    let (idx, _, _, fnm, _, _) = Array::get(fn_defs, fi)\n    if fnm == name {\n      def_idx = idx\n    } else {\n      ()\n    }\n    fi = fi + 1\n  }\n  if def_idx < 0 {\n    None\n  } else {\n    match Array::get(stmts, def_idx) {\n      SLet(_, _, _, _, EFn(_, _, params, _, _, _)) => Some(params),\n      _ => None\n    }\n  }\n}\n\nfn scps_split_literal(tps: Array[String], tbs: Array[(String, Array[String])], params: Array[(String, Option[TypeExpr])], b: Expr, ecfg: (String, Array[String], Array[String]), ctx: (Array[Stmt], Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], Array[String], Array[Array[String]], Array[String]), st: (Array[Int], Array[String], Array[String], Array[String], Array[String], Array[Stmt], Array[String])) -> Expr {\n  let (eff, ops_qnames, needing) = ecfg\n  let errs = scps_st_errs(st)\n  let site = scps_next_site(st)\n  let cps_seed = array_empty_str()\n  let mut cpi = 0\n  while cpi < Array::length(params) {\n    let (pnm, pty) = Array::get(params, cpi)\n    let prow = scps_ty_row(pty)\n    if prow != \"\" && scps_row_contains(ctx, prow, eff) {\n      Array::push(cps_seed, pnm)\n    } else {\n      ()\n    }\n    cpi = cpi + 1\n  }\n  let sctx = (eff, ops_qnames, needing, site, cps_seed)\n  if !scps_calls_ok(b, sctx, ctx) {\n    Array::push(errs, String::concat(String::concat(\"a closure literal whose row carries \", eff), \" (suspend class, ADR-0076 追記31 Vertical B) calls something the suspend lowering cannot see through (a local closure, a method-style callee, a nested handle, or a row-variable callee) (#817)\"))\n    EFn(tps, tbs, params, None, None, b)\n  } else {\n    let (split_ok, split_body) = scps_split_tail(b, sctx, ctx, st)\n    if !split_ok {\n      Array::push(errs, String::concat(String::concat(\"a closure literal whose row carries \", eff), \" (suspend class, ADR-0076 追記31 Vertical B) performs it (or calls a function that performs it) off the let/seq/tail/branch-tail spine (a `while` loop carrying `break`/`continue`/`return`, a `for`/`loop` form, nested closures/handles, and nested expression positions are not eligible; a plain `while` + `let mut` spine is, #1230) (#817)\"))\n      EFn(tps, tbs, params, None, None, b)\n    } else {\n      scps_ensure_effect_runtime(eff, ctx, st)\n      EFn(tps, tbs, params, None, None, split_body)\n    }\n  }\n}\n\nfn scps_prepass_expr(e: Expr, ecfgs: Array[(String, Array[String], Array[String])], ctx: (Array[Stmt], Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], Array[String], Array[Array[String]], Array[String]), st: (Array[Int], Array[String], Array[String], Array[String], Array[String], Array[Stmt], Array[String]), split_effs: Array[String]) -> Expr {\n  match e {\n    EFn(tps, tbs, params, ret, eff, b) => {\n      let b2 = scps_prepass_expr(b, ecfgs, ctx, st, split_effs)\n      let mut hit_eff = \"\"\n      let mut multi = false\n      let mut ei = 0\n      while ei < Array::length(ecfgs) {\n        let (ceff, cops, cneeding) = Array::get(ecfgs, ei)\n        let probe = (ceff, cops, cneeding, 0, array_empty_str())\n        if scps_lit_needs(b2, probe) {\n          if hit_eff == \"\" {\n            hit_eff = ceff\n          } else {\n            multi = true\n          }\n        } else {\n          ()\n        }\n        ei = ei + 1\n      }\n      if multi {\n        Array::push(scps_st_errs(st), \"a closure literal raw-performs more than one suspend-class effect -- not supported (split the effect or handle one of them inside the literal) (ADR-0076 追記31 Vertical B)\")\n        EFn(tps, tbs, params, ret, eff, b2)\n      } else if hit_eff != \"\" {\n        let mut cfg = (\"\", array_empty_str(), array_empty_str())\n        let mut ci = 0\n        while ci < Array::length(ecfgs) {\n          let (ceff, _, _) = Array::get(ecfgs, ci)\n          if ceff == hit_eff {\n            cfg = Array::get(ecfgs, ci)\n          } else {\n            ()\n          }\n          ci = ci + 1\n        }\n        if edp_str_array_contains(split_effs, hit_eff) {\n          ()\n        } else {\n          Array::push(split_effs, hit_eff)\n        }\n        scps_split_literal(tps, tbs, params, b2, cfg, ctx, st)\n      } else {\n        EFn(tps, tbs, params, ret, eff, b2)\n      }\n    },\n    ECall(callee, args, off) => {\n      let rcallee = scps_prepass_expr(callee, ecfgs, ctx, st, split_effs)\n      let rargs = for a in args {\n        scps_prepass_expr(a, ecfgs, ctx, st, split_effs)\n      }\n      match rcallee {\n        EIdent(fname, _) => match scps_fn_def_params(ctx, fname) {\n          Some(fparams) => {\n            let mut aj = 0\n            while aj < Array::length(rargs) {\n              if aj < Array::length(fparams) {\n                let (_, pty) = Array::get(fparams, aj)\n                let prow = scps_ty_row(pty)\n                if prow != \"\" {\n                  let mut ei2 = 0\n                  while ei2 < Array::length(ecfgs) {\n                    let (ceff, _, cneeding) = Array::get(ecfgs, ei2)\n                    if scps_row_contains(ctx, prow, ceff) {\n                      match Array::get(rargs, aj) {\n                        EFn(atps, atbs, aparams, aret, aeff, ab) => if scps_literal_is_step_for(Array::get(rargs, aj), ceff) {\n                          ()\n                        } else {\n                          let mut cfg2 = (\"\", array_empty_str(), array_empty_str())\n                          let mut ci2 = 0\n                          while ci2 < Array::length(ecfgs) {\n                            let (ceff2, _, _) = Array::get(ecfgs, ci2)\n                            if ceff2 == ceff {\n                              cfg2 = Array::get(ecfgs, ci2)\n                            } else {\n                              ()\n                            }\n                            ci2 = ci2 + 1\n                          }\n                          if edp_str_array_contains(split_effs, ceff) {\n                            ()\n                          } else {\n                            Array::push(split_effs, ceff)\n                          }\n                          Array::set(rargs, aj, scps_split_literal(atps, atbs, aparams, ab, cfg2, ctx, st))\n                        },\n                        EIdent(anm, aoff) => if edp_str_array_contains(cneeding, anm) {\n                          scps_need_clone(ceff, anm, st)\n                          if edp_str_array_contains(split_effs, ceff) {\n                            ()\n                          } else {\n                            Array::push(split_effs, ceff)\n                          }\n                          Array::set(rargs, aj, EIdent(scps_clone_name(ceff, anm), aoff))\n                        } else {\n                          ()\n                        },\n                        _ => ()\n                      }\n                    } else {\n                      ()\n                    }\n                    ei2 = ei2 + 1\n                  }\n                } else {\n                  ()\n                }\n              } else {\n                ()\n              }\n              aj = aj + 1\n            }\n          },\n          None => ()\n        },\n        _ => ()\n      }\n      ECall(rcallee, rargs, off)\n    },\n    EHandle(b, arms) => EHandle(scps_prepass_expr(b, ecfgs, ctx, st, split_effs), for a in arms {\n      let (p, ex) = a\n      (p, scps_prepass_expr(ex, ecfgs, ctx, st, split_effs))\n    }),\n    ELet(n, v, b, off) => ELet(n, scps_prepass_expr(v, ecfgs, ctx, st, split_effs), scps_prepass_expr(b, ecfgs, ctx, st, split_effs), off),\n    ELetMut(n, v, b, off) => ELetMut(n, scps_prepass_expr(v, ecfgs, ctx, st, split_effs), scps_prepass_expr(b, ecfgs, ctx, st, split_effs), off),\n    ELetRec(n, v, b) => ELetRec(n, scps_prepass_expr(v, ecfgs, ctx, st, split_effs), scps_prepass_expr(b, ecfgs, ctx, st, split_effs)),\n    ESeq(a, b) => ESeq(scps_prepass_expr(a, ecfgs, ctx, st, split_effs), scps_prepass_expr(b, ecfgs, ctx, st, split_effs)),\n    EIf(c, t, el) => EIf(scps_prepass_expr(c, ecfgs, ctx, st, split_effs), scps_prepass_expr(t, ecfgs, ctx, st, split_effs), scps_prepass_expr(el, ecfgs, ctx, st, split_effs)),\n    EMatch(s, arms) => EMatch(scps_prepass_expr(s, ecfgs, ctx, st, split_effs), for a in arms {\n      let (p, ex) = a\n      (p, scps_prepass_expr(ex, ecfgs, ctx, st, split_effs))\n    }),\n    EWhile(c, b) => EWhile(scps_prepass_expr(c, ecfgs, ctx, st, split_effs), scps_prepass_expr(b, ecfgs, ctx, st, split_effs)),\n    EForIn(n, idx, it, b) => EForIn(n, idx, scps_prepass_expr(it, ecfgs, ctx, st, split_effs), scps_prepass_expr(b, ecfgs, ctx, st, split_effs)),\n    EBinOp(op, l, r) => EBinOp(op, scps_prepass_expr(l, ecfgs, ctx, st, split_effs), scps_prepass_expr(r, ecfgs, ctx, st, split_effs)),\n    EUnaryOp(op, x) => EUnaryOp(op, scps_prepass_expr(x, ecfgs, ctx, st, split_effs)),\n    EAssign(n, v, c) => EAssign(n, scps_prepass_expr(v, ecfgs, ctx, st, split_effs), scps_prepass_expr(c, ecfgs, ctx, st, split_effs)),\n    EAssignOp(n, op, v, c) => EAssignOp(n, op, scps_prepass_expr(v, ecfgs, ctx, st, split_effs), scps_prepass_expr(c, ecfgs, ctx, st, split_effs)),\n    EDot(o, f, off1, off2) => EDot(scps_prepass_expr(o, ecfgs, ctx, st, split_effs), f, off1, off2),\n    ELabeledArg(l, n, v) => ELabeledArg(l, n, scps_prepass_expr(v, ecfgs, ctx, st, split_effs)),\n    EReturn(x) => EReturn(scps_prepass_expr(x, ecfgs, ctx, st, split_effs)),\n    EBreak(opt) => EBreak(match opt {\n      Some(x) => Some(scps_prepass_expr(x, ecfgs, ctx, st, split_effs)),\n      None => None\n    }),\n    EContinue(args) => EContinue(for a in args {\n      scps_prepass_expr(a, ecfgs, ctx, st, split_effs)\n    }),\n    ETuple(items) => ETuple(for a in items {\n      scps_prepass_expr(a, ecfgs, ctx, st, split_effs)\n    }),\n    EArray(items) => EArray(for a in items {\n      scps_prepass_expr(a, ecfgs, ctx, st, split_effs)\n    }),\n    ERecord(n, fields, tas) => ERecord(n, for f in fields {\n      let (fn2, v) = f\n      (fn2, scps_prepass_expr(v, ecfgs, ctx, st, split_effs))\n    }, tas),\n    EMap(fields) => EMap(for f in fields {\n      let (fn2, v) = f\n      (fn2, scps_prepass_expr(v, ecfgs, ctx, st, split_effs))\n    }),\n    ESpread(x) => ESpread(scps_prepass_expr(x, ecfgs, ctx, st, split_effs)),\n    ELoop(pairs, b) => ELoop(for p in pairs {\n      let (n, v) = p\n      (n, scps_prepass_expr(v, ecfgs, ctx, st, split_effs))\n    }, scps_prepass_expr(b, ecfgs, ctx, st, split_effs)),\n    _ => e\n  }\n}\n\n\nfn scps_guard_untriggered(e: Expr, guard_effs: Array[String], errs: Array[String]) -> Unit {\n  match e {\n    EHandle(b, arms) => {\n      scps_guard_untriggered(b, guard_effs, errs)\n      if Array::length(arms) > 0 {\n        let (p0, _) = Array::get(arms, 0)\n        match p0 {\n          PCtor(q, _) => {\n            let ci = String::index_of(q, \"::\")\n            if ci > 0 && edp_str_array_contains(guard_effs, String::substring(q, 0, ci)) {\n              Array::push(errs, String::concat(String::concat(\"effect \", String::substring(q, 0, ci)), \" has step-compiled closure values (a literal or argument was CPS-lowered for it), but this handle for it does not capture `resume` as a value -- mixing the step convention with tail-resumptive/replay handling of the same effect is not supported; split the effect or make every handler suspend-class (ADR-0076 追記31 Vertical B)\"))\n            } else {\n              ()\n            }\n          },\n          _ => ()\n        }\n      } else {\n        ()\n      }\n      let mut i = 0\n      while i < Array::length(arms) {\n        let (_, ex) = Array::get(arms, i)\n        scps_guard_untriggered(ex, guard_effs, errs)\n        i = i + 1\n      }\n    },\n    EFn(_, _, _, _, _, b) => scps_guard_untriggered(b, guard_effs, errs),\n    ELet(_, v, b, _) => {\n      scps_guard_untriggered(v, guard_effs, errs)\n      scps_guard_untriggered(b, guard_effs, errs)\n    },\n    ELetMut(_, v, b, _) => {\n      scps_guard_untriggered(v, guard_effs, errs)\n      scps_guard_untriggered(b, guard_effs, errs)\n    },\n    ELetRec(_, v, b) => {\n      scps_guard_untriggered(v, guard_effs, errs)\n      scps_guard_untriggered(b, guard_effs, errs)\n    },\n    ESeq(a, b) => {\n      scps_guard_untriggered(a, guard_effs, errs)\n      scps_guard_untriggered(b, guard_effs, errs)\n    },\n    EIf(c, t, el) => {\n      scps_guard_untriggered(c, guard_effs, errs)\n      scps_guard_untriggered(t, guard_effs, errs)\n      scps_guard_untriggered(el, guard_effs, errs)\n    },\n    EMatch(s, arms) => {\n      scps_guard_untriggered(s, guard_effs, errs)\n      let mut i = 0\n      while i < Array::length(arms) {\n        let (_, ex) = Array::get(arms, i)\n        scps_guard_untriggered(ex, guard_effs, errs)\n        i = i + 1\n      }\n    },\n    ECall(callee, args, _) => {\n      scps_guard_untriggered(callee, guard_effs, errs)\n      let mut i = 0\n      while i < Array::length(args) {\n        scps_guard_untriggered(Array::get(args, i), guard_effs, errs)\n        i = i + 1\n      }\n    },\n    EWhile(c, b) => {\n      scps_guard_untriggered(c, guard_effs, errs)\n      scps_guard_untriggered(b, guard_effs, errs)\n    },\n    EForIn(_, _, it, b) => {\n      scps_guard_untriggered(it, guard_effs, errs)\n      scps_guard_untriggered(b, guard_effs, errs)\n    },\n    ELoop(pairs, b) => {\n      let mut i = 0\n      while i < Array::length(pairs) {\n        let (_, v) = Array::get(pairs, i)\n        scps_guard_untriggered(v, guard_effs, errs)\n        i = i + 1\n      }\n      scps_guard_untriggered(b, guard_effs, errs)\n    },\n    EBinOp(_, l, r) => {\n      scps_guard_untriggered(l, guard_effs, errs)\n      scps_guard_untriggered(r, guard_effs, errs)\n    },\n    EUnaryOp(_, x) => scps_guard_untriggered(x, guard_effs, errs),\n    EAssign(_, v, c) => {\n      scps_guard_untriggered(v, guard_effs, errs)\n      scps_guard_untriggered(c, guard_effs, errs)\n    },\n    EAssignOp(_, _, v, c) => {\n      scps_guard_untriggered(v, guard_effs, errs)\n      scps_guard_untriggered(c, guard_effs, errs)\n    },\n    EReturn(x) => scps_guard_untriggered(x, guard_effs, errs),\n    EDot(o, _, _, _) => scps_guard_untriggered(o, guard_effs, errs),\n    ELabeledArg(_, _, v) => scps_guard_untriggered(v, guard_effs, errs),\n    EBreak(opt) => match opt {\n      Some(x) => scps_guard_untriggered(x, guard_effs, errs),\n      None => ()\n    },\n    EContinue(args) => {\n      let mut i = 0\n      while i < Array::length(args) {\n        scps_guard_untriggered(Array::get(args, i), guard_effs, errs)\n        i = i + 1\n      }\n    },\n    ETuple(items) => {\n      let mut i = 0\n      while i < Array::length(items) {\n        scps_guard_untriggered(Array::get(items, i), guard_effs, errs)\n        i = i + 1\n      }\n    },\n    EArray(items) => {\n      let mut i = 0\n      while i < Array::length(items) {\n        scps_guard_untriggered(Array::get(items, i), guard_effs, errs)\n        i = i + 1\n      }\n    },\n    ERecord(_, fields, _) => {\n      let mut i = 0\n      while i < Array::length(fields) {\n        let (_, v) = Array::get(fields, i)\n        scps_guard_untriggered(v, guard_effs, errs)\n        i = i + 1\n      }\n    },\n    EMap(fields) => {\n      let mut i = 0\n      while i < Array::length(fields) {\n        let (_, v) = Array::get(fields, i)\n        scps_guard_untriggered(v, guard_effs, errs)\n        i = i + 1\n      }\n    },\n    ESpread(x) => scps_guard_untriggered(x, guard_effs, errs),\n    _ => ()\n  }\n}\n\nfn scps_expr_has_trigger(e: Expr) -> Bool {\n  match e {\n    EHandle(b, arms) => {\n      let mut hit = scps_expr_has_trigger(b)\n      let mut i = 0\n      while i < Array::length(arms) {\n        let (p, ex) = Array::get(arms, i)\n        if scps_arm_refs_resume_value(ex, scps_pat_binds_resume(p)) || scps_expr_has_trigger(ex) {\n          hit = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      hit\n    },\n    EFn(_, _, _, _, _, b) => scps_expr_has_trigger(b),\n    ELet(_, v, b, _) => scps_expr_has_trigger(v) || scps_expr_has_trigger(b),\n    ELetMut(_, v, b, _) => scps_expr_has_trigger(v) || scps_expr_has_trigger(b),\n    ELetRec(_, v, b) => scps_expr_has_trigger(v) || scps_expr_has_trigger(b),\n    ESeq(a, b) => scps_expr_has_trigger(a) || scps_expr_has_trigger(b),\n    EIf(c, t, el) => scps_expr_has_trigger(c) || scps_expr_has_trigger(t) || scps_expr_has_trigger(el),\n    EMatch(s, arms) => {\n      let mut hit = scps_expr_has_trigger(s)\n      let mut i = 0\n      while i < Array::length(arms) {\n        let (_, ex) = Array::get(arms, i)\n        if scps_expr_has_trigger(ex) {\n          hit = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      hit\n    },\n    EWhile(c, b) => scps_expr_has_trigger(c) || scps_expr_has_trigger(b),\n    EForIn(_, _, it, b) => scps_expr_has_trigger(it) || scps_expr_has_trigger(b),\n    ELoop(pairs, b) => {\n      let mut hit = scps_expr_has_trigger(b)\n      let mut i = 0\n      while i < Array::length(pairs) {\n        let (_, v) = Array::get(pairs, i)\n        if scps_expr_has_trigger(v) {\n          hit = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      hit\n    },\n    ECall(callee, args, _) => {\n      let mut hit = scps_expr_has_trigger(callee)\n      let mut i = 0\n      while i < Array::length(args) {\n        if scps_expr_has_trigger(Array::get(args, i)) {\n          hit = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      hit\n    },\n    EBinOp(_, l, r) => scps_expr_has_trigger(l) || scps_expr_has_trigger(r),\n    EUnaryOp(_, x) => scps_expr_has_trigger(x),\n    EAssign(_, v, b) => scps_expr_has_trigger(v) || scps_expr_has_trigger(b),\n    EAssignOp(_, _, v, b) => scps_expr_has_trigger(v) || scps_expr_has_trigger(b),\n    EReturn(x) => scps_expr_has_trigger(x),\n    EDot(o, _, _, _) => scps_expr_has_trigger(o),\n    ELabeledArg(_, _, v) => scps_expr_has_trigger(v),\n    EBreak(opt) => match opt {\n      Some(x) => scps_expr_has_trigger(x),\n      None => false\n    },\n    EContinue(args) => {\n      let mut hit = false\n      let mut i = 0\n      while i < Array::length(args) {\n        if scps_expr_has_trigger(Array::get(args, i)) {\n          hit = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      hit\n    },\n    ETuple(items) => {\n      let mut hit = false\n      let mut i = 0\n      while i < Array::length(items) {\n        if scps_expr_has_trigger(Array::get(items, i)) {\n          hit = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      hit\n    },\n    EArray(items) => {\n      let mut hit = false\n      let mut i = 0\n      while i < Array::length(items) {\n        if scps_expr_has_trigger(Array::get(items, i)) {\n          hit = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      hit\n    },\n    ERecord(_, fields, _) => {\n      let mut hit = false\n      let mut i = 0\n      while i < Array::length(fields) {\n        let (_, v) = Array::get(fields, i)\n        if scps_expr_has_trigger(v) {\n          hit = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      hit\n    },\n    EMap(fields) => {\n      let mut hit = false\n      let mut i = 0\n      while i < Array::length(fields) {\n        let (_, v) = Array::get(fields, i)\n        if scps_expr_has_trigger(v) {\n          hit = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      hit\n    },\n    ESpread(x) => scps_expr_has_trigger(x),\n    _ => false\n  }\n}\n\nfn scps_stmt_has_trigger(s: Stmt) -> Bool {\n  match s {\n    SLet(_, _, _, _, expr) => scps_expr_has_trigger(expr),\n    SLetMut(_, _, expr) => scps_expr_has_trigger(expr),\n    SExpr(expr) => scps_expr_has_trigger(expr),\n    STest(_, expr) => scps_expr_has_trigger(expr),\n    SBench(_, expr) => scps_expr_has_trigger(expr),\n    _ => false\n  }\n}\n\n\nexport fn await_poll_pass(stmts: Array[Stmt], host_future: Bool, waiter_hooks: Bool) -> Unit {\n  if awp_program_defines_await(stmts) {\n    ()\n  } else {\n    let ctr = [\n      0\n    ]\n    let mut i = 0\n    while i < Array::length(stmts) {\n      match Array::get(stmts, i) {\n        SLet(ex, isrec, nm, ty, expr) => {\n          Array::set(stmts, i, SLet(ex, isrec, nm, ty, awp_tail(expr, ctr)))\n        },\n        SLetMut(nm, ty, expr) => {\n          Array::set(stmts, i, SLetMut(nm, ty, awp_tail(expr, ctr)))\n        },\n        SExpr(expr) => {\n          Array::set(stmts, i, SExpr(awp_tail(expr, ctr)))\n        },\n        STest(nm, expr) => {\n          Array::set(stmts, i, STest(nm, awp_tail(expr, ctr)))\n        },\n        SBench(nm, expr) => {\n          Array::set(stmts, i, SBench(nm, awp_tail(expr, ctr)))\n        },\n        _ => ()\n      }\n      i = i + 1\n    }\n    if Array::get(ctr, 0) > 0 {\n      Array::push(stmts, awp_poll_fn_def(host_future, waiter_hooks))\n      if host_future {\n        Array::push(stmts, awp_pay_fn_def())\n        Array::push(stmts, awp_settle_fn_def())\n      } else {\n        ()\n      }\n    } else {\n      ()\n    }\n  }\n}\n\nfn awp_poll_fn_def(host_future: Bool, waiter_hooks: Bool) -> Stmt {\n  let fut = EIdent(\"__aw_fut\", -1)\n  let state = ECall(EIdent(\"Array::get\", -1), [\n    fut,\n    EInt(0)\n  ], -1)\n  let pending = EBinOp(\"<\", EInt(0), state)\n  let payload = ECall(EIdent(\"Array::get\", -1), [\n    fut,\n    EInt(1)\n  ], -1)\n  let loop_body = if host_future {\n    let suspend = ECall(EIdent(\"perform\", -1), [\n      ECall(EIdent(\"Async::Suspend\", -1), [\n        EIdent(\"__aw_p\", -1)\n      ], -1)\n    ], -1)\n    let pay = ECall(EIdent(\"__aw_pay\", -1), [\n      fut\n    ], -1)\n    let settle = ECall(EIdent(\"__aw_settle\", -1), [\n      fut,\n      EIdent(\"__aw_w\", -1)\n    ], -1)\n    ELet(\"__aw_p\", pay, ELet(\"__aw_w\", suspend, ELet(\"__aw_s\", settle, EUnit, -1), -1), -1)\n  } else if waiter_hooks {\n    let wait_call = ECall(EIdent(\"__aw_wait\", -1), [\n      fut\n    ], -1)\n    ELet(\"__aw_w\", wait_call, EUnit, -1)\n  } else {\n    let suspend = ECall(EIdent(\"perform\", -1), [\n      ECall(EIdent(\"Async::Suspend\", -1), [\n        EInt(1)\n      ], -1)\n    ], -1)\n    ELet(\"__aw_w\", suspend, EUnit, -1)\n  }\n  let body = ESeq(EWhile(pending, loop_body), payload)\n  let params: Array[(String, Option[TypeExpr])] = [\n    (\"__aw_fut\", None)\n  ]\n  SLet(false, false, \"__aw_poll\", None, EFn(array_empty_str(), array_empty(), params, None, Some(\"Async\"), body))\n}\n\nfn awp_pay_fn_def() -> Stmt {\n  let f = EIdent(\"__awp_f\", -1)\n  let state = ECall(EIdent(\"Array::get\", -1), [\n    f,\n    EInt(0)\n  ], -1)\n  let hnd = ECall(EIdent(\"Array::get\", -1), [\n    f,\n    EInt(1)\n  ], -1)\n  let body = EIf(EBinOp(\"==\", state, EInt(2)), EBinOp(\"+\", hnd, EInt(2)), EInt(1))\n  let params: Array[(String, Option[TypeExpr])] = [\n    (\"__awp_f\", None)\n  ]\n  SLet(false, false, \"__aw_pay\", None, EFn(array_empty_str(), array_empty(), params, None, None, body))\n}\n\nfn awp_settle_fn_def() -> Stmt {\n  let f = EIdent(\"__aws_f\", -1)\n  let state = ECall(EIdent(\"Array::get\", -1), [\n    f,\n    EInt(0)\n  ], -1)\n  let set_payload = ECall(EIdent(\"Array::set\", -1), [\n    f,\n    EInt(1),\n    EIdent(\"__aws_v\", -1)\n  ], -1)\n  let set_state = ECall(EIdent(\"Array::set\", -1), [\n    f,\n    EInt(0),\n    EInt(0)\n  ], -1)\n  let body = EIf(EBinOp(\"==\", state, EInt(2)), ESeq(set_payload, ESeq(set_state, EInt(0))), EInt(0))\n  let params: Array[(String, Option[TypeExpr])] = [\n    (\"__aws_f\", None),\n    (\"__aws_v\", None)\n  ]\n  SLet(false, false, \"__aw_settle\", None, EFn(array_empty_str(), array_empty(), params, None, None, body))\n}\n\nfn awp_program_defines_await(stmts: Array[Stmt]) -> Bool {\n  let mut found = false\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SLet(_, _, nm, _, _) => if nm == \"await\" {\n        found = true\n      } else {\n        ()\n      },\n      _ => ()\n    }\n    i = i + 1\n  }\n  found\n}\n\nfn awp_lift(e: Expr, ctr: Array[Int], binds: Array[(String, Expr, String)]) -> Expr {\n  match e {\n    ECall(callee, args, off) => {\n      let callee_nm = match callee {\n        EIdent(cn, _) => cn,\n        _ => \"\"\n      }\n      if callee_nm == \"await\" && Array::length(args) == 1 {\n        let inner = awp_lift(Array::get(args, 0), ctr, binds)\n        match awp_ready_payload(inner) {\n          Some(payload) => payload,\n          None => {\n            let n = Array::get(ctr, 0)\n            Array::set(ctr, 0, n + 1)\n            let fname = String::concat(\"__aw_f_\", Int::to_string(n))\n            let vname = String::concat(\"__aw_v_\", Int::to_string(n))\n            Array::push(binds, (fname, inner, vname))\n            EIdent(vname, -1)\n          }\n        }\n      } else {\n        let new_callee = if callee_nm == \"\" {\n          awp_lift(callee, ctr, binds)\n        } else {\n          callee\n        }\n        ECall(new_callee, awp_lift_exprs(args, ctr, binds), off)\n      }\n    },\n    EBinOp(op, l, r) => EBinOp(op, awp_lift(l, ctr, binds), awp_lift(r, ctr, binds)),\n    EUnaryOp(op, x) => EUnaryOp(op, awp_lift(x, ctr, binds)),\n    EDot(o, f, o1, o2) => EDot(awp_lift(o, ctr, binds), f, o1, o2),\n    ELabeledArg(l, n, v) => ELabeledArg(l, n, awp_lift(v, ctr, binds)),\n    ETuple(items) => ETuple(awp_lift_exprs(items, ctr, binds)),\n    EArray(items) => EArray(awp_lift_exprs(items, ctr, binds)),\n    ESpread(x) => ESpread(awp_lift(x, ctr, binds)),\n    ERecord(n, fields, tas) => ERecord(n, awp_lift_pairs(fields, ctr, binds), tas),\n    EMap(fields) => EMap(awp_lift_pairs(fields, ctr, binds)),\n    _ => awp_rewrite(e, ctr)\n  }\n}\n\nfn awp_lift_exprs(es: Array[Expr], ctr: Array[Int], binds: Array[(String, Expr, String)]) -> Array[Expr] {\n  for x in es {\n    awp_lift(x, ctr, binds)\n  }\n}\n\nfn awp_lift_pairs(pairs: Array[(String, Expr)], ctr: Array[Int], binds: Array[(String, Expr, String)]) -> Array[(String, Expr)] {\n  for p in pairs {\n    let (n, v) = p\n    (n, awp_lift(v, ctr, binds))\n  }\n}\n\nfn awp_wrap(binds: Array[(String, Expr, String)], inner: Expr) -> Expr {\n  let mut out = inner\n  let mut i = Array::length(binds) - 1\n  while i >= 0 {\n    let (fname, fut, vname) = Array::get(binds, i)\n    let poll = ECall(EIdent(\"__aw_poll\", -1), [\n      EIdent(fname, -1)\n    ], -1)\n    out = ELet(fname, fut, ELet(vname, poll, out, -1), -1)\n    i = i - 1\n  }\n  out\n}\n\nfn awp_spine(e: Expr, ctr: Array[Int], rebuild_is_tail: Bool) -> Expr {\n  let _ = rebuild_is_tail\n  let binds = array_empty()\n  let lifted = awp_lift(e, ctr, binds)\n  awp_wrap(binds, lifted)\n}\n\nfn awp_ready_payload(fut: Expr) -> Option[Expr] {\n  match fut {\n    ECall(callee, args, _) => match callee {\n      EIdent(nm, _) => if nm == \"Future::ready\" && Array::length(args) == 1 {\n        Some(Array::get(args, 0))\n      } else {\n        None\n      },\n      _ => None\n    },\n    _ => None\n  }\n}\n\nfn awp_rewrite(e: Expr, ctr: Array[Int]) -> Expr {\n  match e {\n    ELet(n, v, b, off) => {\n      let binds = array_empty()\n      let v2 = awp_lift(v, ctr, binds)\n      awp_wrap(binds, ELet(n, v2, awp_tail(b, ctr), off))\n    },\n    ELetMut(n, v, b, off) => {\n      let binds = array_empty()\n      let v2 = awp_lift(v, ctr, binds)\n      awp_wrap(binds, ELetMut(n, v2, awp_tail(b, ctr), off))\n    },\n    ELetRec(n, v, b) => ELetRec(n, awp_tail(v, ctr), awp_tail(b, ctr)),\n    ESeq(a, b) => {\n      let binds = array_empty()\n      let a2 = awp_lift(a, ctr, binds)\n      awp_wrap(binds, ESeq(a2, awp_tail(b, ctr)))\n    },\n    EAssign(n, v, c) => {\n      let binds = array_empty()\n      let v2 = awp_lift(v, ctr, binds)\n      awp_wrap(binds, EAssign(n, v2, awp_tail(c, ctr)))\n    },\n    EAssignOp(op, n, v, c) => {\n      let binds = array_empty()\n      let v2 = awp_lift(v, ctr, binds)\n      awp_wrap(binds, EAssignOp(op, n, v2, awp_tail(c, ctr)))\n    },\n    EIf(c, t, el) => {\n      let binds = array_empty()\n      let c2 = awp_lift(c, ctr, binds)\n      awp_wrap(binds, EIf(c2, awp_tail(t, ctr), awp_tail(el, ctr)))\n    },\n    EMatch(sc, arms) => {\n      let binds = array_empty()\n      let sc2 = awp_lift(sc, ctr, binds)\n      awp_wrap(binds, EMatch(sc2, awp_rewrite_arms(arms, ctr)))\n    },\n    EWhile(c, b) => EWhile(awp_tail(c, ctr), awp_tail(b, ctr)),\n    EForIn(n, idx, it, b) => {\n      let binds = array_empty()\n      let it2 = awp_lift(it, ctr, binds)\n      awp_wrap(binds, EForIn(n, idx, it2, awp_tail(b, ctr)))\n    },\n    ELoop(pairs, b) => ELoop(awp_rewrite_pairs(pairs, ctr), awp_tail(b, ctr)),\n    EFn(tps, tbs, params, ret, eff, b) => EFn(tps, tbs, params, ret, eff, awp_tail(b, ctr)),\n    EHandle(b, arms) => EHandle(awp_tail(b, ctr), awp_rewrite_arms(arms, ctr)),\n    EReturn(x) => {\n      let binds = array_empty()\n      let x2 = awp_lift(x, ctr, binds)\n      awp_wrap(binds, EReturn(x2))\n    },\n    EBreak(opt) => match opt {\n      Some(x) => {\n        let binds = array_empty()\n        let x2 = awp_lift(x, ctr, binds)\n        awp_wrap(binds, EBreak(Some(x2)))\n      },\n      None => e\n    },\n    EContinue(args) => {\n      let binds = array_empty()\n      let args2 = awp_lift_exprs(args, ctr, binds)\n      awp_wrap(binds, EContinue(args2))\n    },\n    _ => e\n  }\n}\n\nfn awp_tail(e: Expr, ctr: Array[Int]) -> Expr {\n  match e {\n    ELet(_, _, _, _) => awp_rewrite(e, ctr),\n    ELetMut(_, _, _, _) => awp_rewrite(e, ctr),\n    ELetRec(_, _, _) => awp_rewrite(e, ctr),\n    ESeq(_, _) => awp_rewrite(e, ctr),\n    EAssign(_, _, _) => awp_rewrite(e, ctr),\n    EAssignOp(_, _, _, _) => awp_rewrite(e, ctr),\n    EIf(_, _, _) => awp_rewrite(e, ctr),\n    EMatch(_, _) => awp_rewrite(e, ctr),\n    EWhile(_, _) => awp_rewrite(e, ctr),\n    EForIn(_, _, _, _) => awp_rewrite(e, ctr),\n    ELoop(_, _) => awp_rewrite(e, ctr),\n    EFn(_, _, _, _, _, _) => awp_rewrite(e, ctr),\n    EHandle(_, _) => awp_rewrite(e, ctr),\n    EReturn(_) => awp_rewrite(e, ctr),\n    EBreak(_) => awp_rewrite(e, ctr),\n    EContinue(_) => awp_rewrite(e, ctr),\n    _ => awp_spine(e, ctr, true)\n  }\n}\n\nfn awp_rewrite_pairs(pairs: Array[(String, Expr)], ctr: Array[Int]) -> Array[(String, Expr)] {\n  for p in pairs {\n    let (n, v) = p\n    (n, awp_tail(v, ctr))\n  }\n}\n\nfn awp_rewrite_arms(arms: Array[(Pat, Expr)], ctr: Array[Int]) -> Array[(Pat, Expr)] {\n  for a in arms {\n    let (p, ex) = a\n    (p, awp_tail(ex, ctr))\n  }\n}\n")
}

let source_227 = () -> (String, String) {
  ("lib/@vibe/compiler/entry/source_compile/wasi_only/index.vpkg",
"name = @vibe/compiler/entry/source_compile/wasi_only\nversion = 0.0.1\ndescription =\n  #|@vibe/compiler/entry/source_compile/wasi_only — ADR-0070 / #897 compiler-\ndeps = {\n  @vibe/compiler/checker : 0.0.1\n  @vibe/compiler/codegen : 0.0.1\n  @vibe/compiler/codegen/common_base : 0.0.1\n  @vibe/compiler/codegen/wasi : 0.0.1\n  @vibe/compiler/codegen/wasm_emit : 0.0.1\n  @vibe/compiler/core : 0.0.1\n  @vibe/compiler/loader : 0.0.1\n  @vibe/compiler/syntax : 0.0.1\n  @vibe/core : 0.2.0\n}\n\ngenerated_hash =\n\n// @vibe/compiler/entry/source_compile/wasi_only — ADR-0070 / #897 compiler-\n// internal contract, part of entry/'s own explicit \"high risk\" sub-batch\n// (issue #897 body: \"高リスク (要個別設計判断)... entry/ とそのサブディレ\n// クトリ\"), migrated alongside entry/compiler/, entry/compiler/fs_compile/,\n// and entry/source_compile/ in the same batch. Its sibling\n// entry/source_compile/gc_only/ (the wasm-gc-backend analogue) was already\n// migrated in an earlier #897 batch -- see that package's index.vpkg for\n// the simpler single-file shape this directory does NOT have.\n//\n// Directory-shared-scope package: 22 impl files (~1164 lines), of which\n// only 13 carry a REAL exported def (`export fn`) -- the other 9 are pure\n// re-export shims, each pairing a genuine `export ./sibling.vibe { name }`\n// cross-file SReExport with a redundant bare `export { name }` block for\n// the same name (harmless: check_contract's collect_reexported_names only\n// looks at the SReExport form, so the trailing bare block is inert). The\n// 13 real-def files, grouped below: linked_artifacts.vibe (4),\n// linked_library.vibe (1), merge_sources.vibe (2), preprocess_compile.vibe\n// (4), preprocess_interp.vibe (1), preprocess_interp_parse.vibe (1),\n// preprocess_interp_rewrite_impl.vibe (1), preprocess_interp_string_build.vibe\n// (1), preprocess_interp_string_collect.vibe (1),\n// preprocess_interp_string_fold_core.vibe (1),\n// preprocess_interp_string_fold_loop.vibe (1),\n// preprocess_interp_string_fold_nonempty.vibe (1), preprocess_strip.vibe (1)\n// -- 20 names total, all declared below.\n//\n// Deliberately NOT declared (the #847-documented trap this migration keeps\n// hitting): path_utils.vibe's `empty_stmt_array` and linked_helpers.vibe's\n// `path_to_module_name` / `resolve_reexport_chain` are each a PRIVATE local\n// `fn` (no `export` on the fn itself) promoted to sibling-file visibility\n// ONLY via a trailing bare `export { name }` block -- collect_impl_fn_defs\n// sees them with `exported = false` (the SLet node's own flag, unaffected\n// by a later bare SExport), so declaring them here would fail check_contract\n// with \"implemented but not exported by its implementation file\" (the exact\n// documented trap for the bare `export {}` promotion shape). Nothing outside\n// this directory ever imported them by that name pre-migration either (only\n// sibling files did, via directory-shared scope / leaf imports within the\n// same directory, both still legal post-migration) -- confirmed via a\n// repo-wide grep, not assumed. merge_sources.vibe's `collect_merged_stmts_recursive`\n// is the same private+bare-exported shape and is likewise undeclared.\n//\n// Naming: no collision (wasi_only/wasi_only.vibe did not exist, mirroring\n// gc_only/gc_only.vibe's sibling precedent), old index.vibe moved verbatim\n// to wasi_only.vibe.\n//\n// External-caller fixes (literal leaf-path references into this directory\n// from OUTSIDE it, now that enforce_incoming_boundary_fs rejects them once\n// this directory is a package boundary):\n//   - lib/@vibe/compiler/index.vibe: `./entry/source_compile/wasi_only/index.vibe\n//     { compile_source_wasi_only, compile_source_wasi_only_rc }` -> bare\n//     `./entry/source_compile/wasi_only { .. }` package form.\n//   - tests/compiler_fs_test.vibe: had BOTH a leaf import of\n//     linked_artifacts.vibe (`collect_linked_compile_inputs`) and an\n//     existing package-form import in the same file -- merged into the one\n//     package-form import.\n//   - cli_adapter.vibe: two leaf imports (preprocess.vibe, merge_sources.vibe)\n//     merged into one package-form import.\n//   - cli_support.vibe: three leaf imports (linked_artifacts.vibe,\n//     preprocess_interp.vibe, linked_library.vibe) merged into one\n//     package-form import; the FOURTH leaf import (path_utils.vibe's\n//     `empty_stmt_array`) is dropped entirely rather than routed through the\n//     package form, since `empty_stmt_array` is one of the undeclared\n//     private names above (see that trap note) -- its body is a one-line\n//     forward to `@vibe/core`'s generic `array_empty[T]()`, already imported\n//     in cli_support.vibe under its own name, so the two call sites just\n//     call `array_empty()` directly instead.\n//   - selfbuild_gate_sources_b.vibe: five string-literal fixtures embedding\n//     `import ./entry/source_compile/wasi_only/index.vibe { .. }` as source\n//     TEXT (compiled via the FS lane, not parsed as this file's own\n//     imports) now target `./entry/source_compile/wasi_only/wasi_only.vibe`\n//     -- the renamed leaf file -- keeping each fixture's original \"leaf\n//     import of an internal file\" test shape intact (same fix codegen/'s\n//     own batch made for its analogous `./codegen/index.vibe` fixtures).\n//\n// No import cycle found: none of this directory's own dependencies\n// (checker/, codegen/wasi, codegen/common_base, core/, syntax/,\n// module_graph_path.vibe -- all already vpkg or plain leaf files) import\n// back into entry/source_compile/wasi_only/.\n//\n// Compiled into the compiler itself via compiler_sources_manifest.tsv\n// (group `entry`): the old single `entry/source_compile/wasi_only/index.vibe`\n// row becomes a dual row (this contract + wasi_only.vibe); the other 21\n// sibling files already had their own rows and are unchanged.\n//\n// No exported types: Stmt/Expr (../../../core) and Token (../../../syntax)\n// arrive as structural signature text (loader/runtime/core precedent -- no\n// re-import needed here).\n\n// --- linked_artifacts.vibe\nfn collect_linked_dep_inputs_for_stmts(entry_path: String, entry_stmts: Array[Stmt]) -> (Array[Stmt], Array[(String, String, Int, Int)], Array[(String, String)]) with { Error, Fs }\nfn collect_linked_compile_inputs(entry_path: String) -> (Array[Stmt], Array[Stmt], Array[(String, String, Int, Int)], Array[(String, String)]) with { Error, Fs }\nfn compile_file_wasi_linked_artifacts(entry_path: String, entry_name: String) -> (Bytes, Array[(String, String, Int, Int)], Array[(String, String)]) with { Error, Fs }\nfn compile_file_wasi_linked(entry_path: String, entry_name: String) -> (Bytes, Array[(String, String, Int, Int)]) with { Error, Fs }\n\n// --- linked_library.vibe\nfn compile_file_wasi_library(dep_path: String) -> Bytes with { Error, Fs }\n\n// --- merge_sources.vibe\nfn merged_program_source_fs(entry_path: String) -> String with { Error, Fs }\nfn compile_file_wasi_only(entry_path: String, entry_name: String) -> Bytes with { Error, Fs }\n\n// --- preprocess_compile.vibe\nfn compile_source_wasi_only(source: String, entry_name: String) -> Bytes with { Error }\nfn compile_source_wasi_only_coverage(source: String, entry_name: String) -> Bytes with { Error }\nfn compile_source_wasi_only_rc(source: String, entry_name: String) -> Bytes with { Error }\nfn compile_source_wasi_only_rc_shadow(source: String, entry_name: String) -> Bytes with { Error }\n\n// --- preprocess_interp.vibe\nfn expand_interp_stmts(stmts: Array[Stmt]) -> Unit with { Error }\n\n// --- preprocess_interp_parse.vibe\nfn parse_interp_expr(tokens: Array[Token]) -> Expr with { Error }\n\n// --- preprocess_interp_rewrite_impl.vibe\nfn rewrite_interp(e: Expr) -> Expr with { Error }\n\n// --- preprocess_interp_string_build.vibe\nfn rewrite_interp_string(parts: Array[String]) -> Expr with { Error }\n\n// --- preprocess_interp_string_collect.vibe\nfn collect_interp_exprs(parts: Array[String]) -> Array[Expr] with { Error }\n\n// --- preprocess_interp_string_fold_core.vibe\nfn fold_interp_exprs(result_arr: Array[Expr]) -> Expr\n\n// --- preprocess_interp_string_fold_loop.vibe\nfn fold_interp_exprs_loop(result_arr: Array[Expr], result_len: Int, result0: Expr, j0: Int) -> Expr\n\n// --- preprocess_interp_string_fold_nonempty.vibe\nfn fold_interp_exprs_nonempty(result_arr: Array[Expr], result_len: Int) -> Expr\n\n// --- preprocess_strip.vibe\nfn strip_generic_type_params(stmts: Array[Stmt]) -> Unit\n\n// --- component_codegen.vibe (relocated here from compiler/ top level,\n// #897 batch; single real external consumer was this directory's own\n// preprocess_compile.vibe, now an ordinary same-package sibling reference)\nfn comp_generate_string_trampoline(string_param_count: Int, call_run_init: Int) -> Bytes\nfn comp_emit_component_wasm(core_wasm: Bytes) -> Bytes\nfn comp_emit_component_wasm_with_lift(core_wasm: Bytes, export_name: String) -> Bytes\nfn comp_emit_component_wasm_with_string_lift(core_wasm: Bytes, target_func_name: String, export_name: String, string_param_count: Int, param_names: Array[String], is_async: Int) -> Bytes\nfn comp_emit_component_wasm_async(core_wasm: Bytes, export_name: String, result_valtype: Int) -> Bytes\nfn comp_emit_component_wasm_async_trampolined(main_core_wasm: Bytes, export_name: String, comp_result_valtype: Int) -> Bytes\nfn comp_emit_component_wasm_async_trampolined_p1(main_core_wasm: Bytes, export_name: String, comp_result_valtype: Int) -> Bytes\nfn comp_emit_component_wasm_async_spawned_future(export_name: String, comp_result_valtype: Int) -> Bytes with { Error }\nfn comp_emit_component_wasm_async_concurrent_awaits(export_name: String, comp_result_valtype: Int) -> Bytes with { Error }\nfn comp_emit_component_wasm_future_value(export_name: String, comp_result_valtype: Int) -> Bytes with { Error }\nfn comp_emit_component_wasm_stream_value(export_name: String, comp_result_valtype: Int) -> Bytes with { Error }\n// ADR-0089 D2 / step 4 (#1218): host-supplied future<u32> -- imports\n// `get-future`, parks the read on waitable-set.wait until the host's\n// producer resolves (driven by runtime/viberun's FutureReader import).\nfn comp_emit_component_wasm_host_future_value(export_name: String, comp_result_valtype: Int) -> Bytes with { Error }\n// ADR-0089 step 4 (#1218): REAL-source wiring -- wrap a compiled core whose\n// program calls `host_future_get` (core imports vibe.host_future_get/_wait,\n// sniffed by comp_core_imports_host_future) into the adapter-backed async\n// component (get-future import + waitable-set.wait park + u32 lift).\nfn comp_core_imports_host_future(core_wasm: Bytes) -> Bool\n// ADR-0089 (c) (#1218): the host-future GET core import names, in\n// declaration order -- the list both the adapter layout and the component's\n// import/lower order are derived from.\nfn comp_core_host_future_names(core_wasm: Bytes) -> Array[String]\n// ADR-0089 Decision 3 (#1218): the host-stream siblings -- named\n// `vibe.host_stream_get$<name>` core imports become per-name `stream<u8>`\n// component imports on the same adapter-backed composition (spec §3.18).\nfn comp_core_imports_host_stream(core_wasm: Bytes) -> Bool\nfn comp_core_host_stream_names(core_wasm: Bytes) -> Array[String]\nfn comp_emit_component_wasm_async_hostfuture(main_core_wasm: Bytes, export_name: String) -> Bytes with { Error }\nfn comp_generate_string_trampoline_packed(string_param_count: Int) -> Bytes\nfn comp_emit_component_wasm_string_handler(core_wasm: Bytes, target_func_name: String, export_name: String, param_names: Array[String]) -> Bytes with { Error }\nfn comp_emit_component_wasm_string_handler_stubbed(core_wasm: Bytes, target_func_name: String, export_name: String, param_names: Array[String]) -> Bytes with { Error }\nfn comp_emit_component_wasm_string_handler_vfs(core_wasm: Bytes, target_func_name: String, export_name: String, param_names: Array[String]) -> Bytes with { Error }\n")
}

