et_eunaryop_op,\n  get_ewhile_body,\n  get_ewhile_cond,\n  get_match_arms,\n  get_match_scrutinee,\n  get_pbind_name,\n  get_pbool_value,\n  get_pctor_args,\n  get_pctor_name,\n  get_pint_value,\n  get_pstring_value,\n  get_ptuple_pats,\n  get_slet_export,\n  str_table_lookup\n}\n\nimport @vibe/compiler/codegen/wasm_emit {\n  emit_block_i64,\n  emit_block_void,\n  emit_br,\n  emit_br_if,\n  emit_call,\n  emit_call_indirect,\n  emit_code_section,\n  emit_code_section_with_locals,\n  emit_data_section,\n  emit_data_section_multi,\n  emit_drop,\n  emit_element_section_active,\n  emit_else,\n  emit_end,\n  emit_export_section,\n  emit_export_section_multi,\n  emit_exports_full,\n  emit_exports_with_memory,\n  emit_f64_add,\n  emit_f64_const_bits,\n  emit_f64_convert_i64_s,\n  emit_f64_div,\n  emit_f64_eq,\n  emit_f64_ge,\n  emit_f64_gt,\n  emit_f64_le,\n  emit_f64_lt,\n  emit_f64_mul,\n  emit_f64_ne,\n  emit_f64_neg,\n  emit_f64_reinterpret_i64,\n  emit_f64_sub,\n  emit_func_type_raw,\n  emit_function_section,\n  emit_global_get,\n  emit_global_section_i32_mut,\n  emit_global_set,\n  emit_header,\n  emit_i32_add,\n  emit_i32_const,\n  emit_i32_load,\n  emit_i32_load8_u,\n  emit_i32_store,\n  emit_i32_store8,\n  emit_i32_wrap_i64,\n  emit_i64_add,\n  emit_i64_and,\n  emit_i64_const,\n  emit_i64_div_s,\n  emit_i64_eq,\n  emit_i64_eqz,\n  emit_i64_extend_i32_s,\n  emit_i64_ge_s,\n  emit_i64_gt_s,\n  emit_i64_le_s,\n  emit_i64_lt_s,\n  emit_i64_mul,\n  emit_i64_ne,\n  emit_i64_or,\n  emit_i64_reinterpret_f64,\n  emit_i64_rem_s,\n  emit_i64_shl,\n  emit_i64_shr_s,\n  emit_i64_sub,\n  emit_i64_trunc_f64_s,\n  emit_i64_xor,\n  emit_if_i64,\n  emit_if_void,\n  emit_import_section_func,\n  emit_local_get,\n  emit_local_set,\n  emit_local_tee,\n  emit_loop_void,\n  emit_memory_section,\n  emit_name,\n  emit_return,\n  emit_table_section_funcref,\n  emit_type_section,\n  emit_type_section_multi,\n  string_to_data\n}\n\n\n\n\n\n\nexport fn compile_expr_tail2(buf: Bytes, expr: Expr, local_names: Array[String], next_local: Int, ctx: CompileCtx, ld: Int, compile_expr: (Bytes, Expr, Array[String], Int, CompileCtx, Int) -> Int with { Error }) -> Int with { Error } {\n  let __tag = expr_tag(expr)\n  if __tag == 15 {\n    let __tuple_elems = get_etuple_elems(expr)\n    let num_elems = Array::length(__tuple_elems)\n    let ptr_local = next_local\n    Array::push(local_names, \"__tuple_ptr\")\n    let mut nl = next_local + 1\n    if ctx.enable_rc {\n      let total = 16 + num_elems * 8\n      emit_i64_const(buf, total)\n      emit_call(buf, ctx.rc_alloc_func_idx)\n      emit_local_set(buf, ptr_local)\n      emit_local_get(buf, ptr_local)\n      emit_i32_wrap_i64(buf)\n      emit_i32_const(buf, total)\n      emit_i32_store(buf, 2, 0)\n      emit_local_get(buf, ptr_local)\n      emit_i32_wrap_i64(buf)\n      emit_i32_const(buf, 1)\n      emit_i32_store(buf, 2, 4)\n      emit_local_get(buf, ptr_local)\n      emit_i32_wrap_i64(buf)\n      emit_i32_const(buf, 1)\n      emit_i32_store8(buf, 0, 7)\n      emit_local_get(buf, ptr_local)\n      emit_i32_wrap_i64(buf)\n      emit_i32_const(buf, 3)\n      emit_i32_store(buf, 2, 8)\n      emit_local_get(buf, ptr_local)\n      emit_i32_wrap_i64(buf)\n      emit_i32_const(buf, num_elems)\n      emit_i32_store(buf, 2, 12)\n      let mut tri = 0\n      while tri < num_elems {\n        let __tup_elem = Array::get(__tuple_elems, tri)\n        nl = compile_expr(buf, __tup_elem, local_names, nl, ctx, ld)\n        let __tup_val_local = nl\n        Array::push(local_names, \"__tup_val\")\n        emit_local_set(buf, __tup_val_local)\n        nl = nl + 1\n        let __tup_is_proj = match __tup_elem {\n          EDot(_, _, _, _) => true,\n          _ => false\n        }\n        if ctx.enable_rc && (__tup_is_proj || cc_is_borrow_ret_call(__tup_elem, ctx) || cc_is_loop_borrowed_ident(__tup_elem, ctx)) {\n          emit_rc_dup_guarded(buf, __tup_val_local, ctx.rc_shadow)\n        } else {\n          ()\n        }\n        emit_local_get(buf, ptr_local)\n        emit_i32_wrap_i64(buf)\n        emit_local_get(buf, __tup_val_local)\n        emit_i64_store(buf, 3, 16 + tri * 8)\n        tri = tri + 1\n      }\n      emit_local_get(buf, ptr_local)\n      emit_i64_const(buf, 8)\n      emit_i64_add(buf)\n      emit_i64_const(buf, 1)\n      emit_i64_or(buf)\n      nl\n    } else {\n      let alloc_size = num_elems * 8\n      emit_global_get(buf, 0)\n      emit_i64_extend_i32_u(buf)\n      emit_local_tee(buf, ptr_local)\n      emit_i32_wrap_i64(buf)\n      emit_i32_const(buf, alloc_size)\n      emit_i32_add(buf)\n      emit_global_set(buf, 0)\n      emit_heap_grow_after_heap_set(buf, ctx)\n      let mut ti = 0\n      while ti < num_elems {\n        emit_local_get(buf, ptr_local)\n        emit_i32_wrap_i64(buf)\n        nl = compile_expr(buf, Array::get(__tuple_elems, ti), local_names, nl, ctx, ld)\n        emit_i64_store(buf, 3, ti * 8)\n        ti = ti + 1\n      }\n      emit_local_get(buf, ptr_local)\n      nl\n    }\n  } else if __tag == 16 {\n    compile_match(buf, expr, local_names, next_local, ctx, ld, compile_expr)\n  } else if __tag == 17 {\n    let elems = get_earray_elems(expr)\n    let n_elems = Array::length(elems)\n    if ctx.enable_rc {\n      let cap = if n_elems > 8 {\n        n_elems\n      } else {\n        8\n      }\n      let total = 20 + cap * 8\n      let ptr_local = next_local\n      Array::push(local_names, \"__arr_ptr\")\n      let mut nl = next_local + 1\n      emit_i64_const(buf, total)\n      emit_call(buf, ctx.rc_alloc_func_idx)\n      emit_local_set(buf, ptr_local)\n      emit_local_get(buf, ptr_local)\n      emit_i32_wrap_i64(buf)\n      emit_i32_const(buf, total)\n      emit_i32_store(buf, 2, 0)\n      emit_local_get(buf, ptr_local)\n      emit_i32_wrap_i64(buf)\n      emit_i32_const(buf, 1)\n      emit_i32_store(buf, 2, 4)\n      emit_local_get(buf, ptr_local)\n      emit_i32_wrap_i64(buf)\n      emit_i32_const(buf, 5)\n      emit_i32_store8(buf, 0, 7)\n      emit_local_get(buf, ptr_local)\n      emit_i32_wrap_i64(buf)\n      emit_i32_const(buf, cap)\n      emit_i32_store(buf, 2, 8)\n      emit_local_get(buf, ptr_local)\n      emit_i32_wrap_i64(buf)\n      emit_i32_const(buf, n_elems)\n      emit_i32_store(buf, 2, 12)\n      emit_local_get(buf, ptr_local)\n      emit_i32_wrap_i64(buf)\n      emit_local_get(buf, ptr_local)\n      emit_i32_wrap_i64(buf)\n      emit_i32_const(buf, 20)\n      emit_i32_add(buf)\n      emit_i32_store(buf, 2, 16)\n      let mut ai = 0\n      while ai < n_elems {\n        let __arr_elem = Array::get(elems, ai)\n        nl = compile_expr(buf, __arr_elem, local_names, nl, ctx, ld)\n        let __arr_val_local = nl\n        Array::push(local_names, \"__arr_val\")\n        emit_local_set(buf, __arr_val_local)\n        nl = nl + 1\n        let __arr_is_proj = match __arr_elem {\n          EDot(_, _, _, _) => true,\n          _ => false\n        }\n        if __arr_is_proj || cc_is_borrow_ret_call(__arr_elem, ctx) || cc_is_loop_borrowed_ident(__arr_elem, ctx) {\n          emit_rc_dup_guarded(buf, __arr_val_local, ctx.rc_shadow)\n        } else {\n          ()\n        }\n        emit_local_get(buf, ptr_local)\n        emit_i32_wrap_i64(buf)\n        emit_local_get(buf, __arr_val_local)\n        emit_i64_store(buf, 3, 20 + ai * 8)\n        ai = ai + 1\n      }\n      emit_local_get(buf, ptr_local)\n      emit_i64_const(buf, 8)\n      emit_i64_add(buf)\n      emit_i64_const(buf, 1)\n      emit_i64_or(buf)\n      nl\n    } else {\n      let (arr_new_idx, _, _) = resolve_func(ctx.func_table, \"array_new\")\n      let (arr_push_idx, _, _) = resolve_func(ctx.func_table, \"Array::push\")\n      let arr_local = next_local\n      emit_call(buf, arr_new_idx)\n      emit_local_set(buf, arr_local)\n      Array::push(local_names, \"__arr_lit\")\n      let mut nl = next_local + 1\n      let mut ei = 0\n      while ei < Array::length(elems) {\n        emit_local_get(buf, arr_local)\n        nl = compile_expr(buf, Array::get(elems, ei), local_names, nl, ctx, ld)\n        emit_call(buf, arr_push_idx)\n        ei = ei + 1\n      }\n      emit_local_get(buf, arr_local)\n      nl\n    }\n  } else if __tag == 18 {\n    let names_len_at_forin = Array::length(local_names)\n    let var_name = get_eforin_name(expr)\n    let iter_expr = get_eforin_iter(expr)\n    let body = get_eforin_body(expr)\n    let lb_base = Array::length(ctx.loop_borrowed_names)\n    if ctx.enable_rc {\n      let mut lbi = 0\n      while lbi < names_len_at_forin {\n        Array::push(ctx.loop_borrowed_names, Array::get(local_names, lbi))\n        lbi = lbi + 1\n      }\n    } else {\n      ()\n    }\n    let (arr_new_fi, _, _) = resolve_func(ctx.func_table, \"array_new\")\n    let (arr_len_fi, _, _) = resolve_func(ctx.func_table, \"Array::length\")\n    let (arr_get_fi, _, _) = resolve_func(ctx.func_table, \"Array::get\")\n    let (arr_push_fi, _, _) = resolve_func(ctx.func_table, \"Array::push\")\n    let result_local = next_local\n    let arr_local = next_local + 1\n    let i_local = next_local + 2\n    Array::push(local_names, \"__forin_res\")\n    Array::push(local_names, \"__forin_arr\")\n    Array::push(local_names, \"__forin_i\")\n    emit_call(buf, arr_new_fi)\n    emit_local_set(buf, result_local)\n    let nl1pre = compile_expr(buf, iter_expr, local_names, next_local + 3, ctx, ld)\n    emit_local_set(buf, arr_local)\n    let (str_len_fi, _, _) = resolve_func(ctx.func_table, \"String::length\")\n    let (str_ccat_fi, _, _) = resolve_func(ctx.func_table, \"String::char_code_at\")\n    let conv_local = nl1pre\n    let j_local = nl1pre + 1\n    Array::push(local_names, \"__forin_conv\")\n    Array::push(local_names, \"__forin_j\")\n    let nl1 = nl1pre + 2\n    emit_local_get(buf, arr_local)\n    emit_i64_const(buf, 32)\n    emit_i64_shr_s(buf)\n    emit_i64_eqz(buf)\n    emit_if_void(buf)\n    emit_else(buf)\n    emit_call(buf, arr_new_fi)\n    emit_local_set(buf, conv_local)\n    emit_i64_const(buf, 0)\n    emit_local_set(buf, j_local)\n    emit_block_void(buf)\n    emit_loop_void(buf)\n    emit_local_get(buf, j_local)\n    emit_local_get(buf, arr_local)\n    emit_call(buf, str_len_fi)\n    if ctx.enable_rc {\n      emit_i64_const(buf, 1)\n      emit_i64_shr_s(buf)\n    } else {\n      ()\n    }\n    emit_i64_ge_s(buf)\n    emit_br_if(buf, 1)\n    emit_local_get(buf, conv_local)\n    emit_local_get(buf, arr_local)\n    emit_local_get(buf, j_local)\n    if ctx.enable_rc {\n      emit_i64_const(buf, 1)\n      emit_i64_shl(buf)\n    } else {\n      ()\n    }\n    emit_call(buf, str_ccat_fi)\n    emit_call(buf, arr_push_fi)\n    emit_local_get(buf, j_local)\n    emit_i64_const(buf, 1)\n    emit_i64_add(buf)\n    emit_local_set(buf, j_local)\n    emit_br(buf, 0)\n    emit_end(buf)\n    emit_end(buf)\n    emit_local_get(buf, conv_local)\n    emit_local_set(buf, arr_local)\n    emit_end(buf)\n    emit_i64_const(buf, 0)\n    emit_local_set(buf, i_local)\n    emit_block_void(buf)\n    emit_loop_void(buf)\n    emit_local_get(buf, i_local)\n    emit_local_get(buf, arr_local)\n    emit_call(buf, arr_len_fi)\n    if ctx.enable_rc {\n      emit_i64_const(buf, 1)\n      emit_i64_shr_s(buf)\n    }\n    emit_i64_ge_s(buf)\n    emit_br_if(buf, 1)\n    let index_name = get_eforin_index(expr)\n    let var_local = match index_name {\n      Some(idx_name) => {\n        emit_local_get(buf, i_local)\n        if ctx.enable_rc {\n          emit_i64_const(buf, 1)\n          emit_i64_shl(buf)\n        }\n        emit_local_set(buf, nl1)\n        Array::push(local_names, idx_name)\n        nl1 + 1\n      },\n      None => nl1\n    }\n    emit_local_get(buf, arr_local)\n    emit_local_get(buf, i_local)\n    if ctx.enable_rc {\n      emit_i64_const(buf, 1)\n      emit_i64_shl(buf)\n    }\n    emit_call(buf, arr_get_fi)\n    emit_local_set(buf, var_local)\n    Array::push(local_names, var_name)\n    if ctx.enable_rc {\n      Array::push(ctx.loop_borrowed_names, var_name)\n    } else {\n      ()\n    }\n    let nl2 = var_local + 1\n    let nl3 = compile_expr(buf, body, local_names, nl2, ctx, 0)\n    let body_val = nl3\n    Array::push(local_names, \"__forin_val\")\n    emit_local_set(buf, body_val)\n    emit_local_get(buf, result_local)\n    emit_local_get(buf, body_val)\n    emit_call(buf, arr_push_fi)\n    emit_local_get(buf, i_local)\n    emit_i64_const(buf, 1)\n    emit_i64_add(buf)\n    emit_local_set(buf, i_local)\n    emit_br(buf, 0)\n    emit_end(buf)\n    emit_end(buf)\n    Array::truncate(ctx.loop_borrowed_names, lb_base)\n    emit_local_get(buf, result_local)\n    let final_nl = nl3 + 1\n    Array::truncate(local_names, names_len_at_forin)\n    while Array::length(local_names) < final_nl {\n      Array::push(local_names, \"\")\n    }\n    final_nl\n  } else {\n    compile_expr_tail3(buf, expr, local_names, next_local, ctx, ld, compile_expr)\n  }\n}\n")
}

