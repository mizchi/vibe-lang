i)\n        let aop = if is_pctor(apat) {\n          effect_op_index(ctx.effect_op_keys, get_pctor_name(apat))\n        } else {\n          0 - 1\n        }\n        emit_global_get(buf, g_op_idx_global)\n        emit_i64_const(buf, aop)\n        emit_i64_eq(buf)\n        emit_if_i64(buf)\n        let arm_names_start = Array::length(local_names)\n        let arm_ref_cells_start = Array::length(ctx.ref_cell_names)\n        t6_bind_from_raw(buf, apat, raw_l, ctx, local_names)\n        let anl = compile_expr(buf, abody, local_names, Array::length(local_names), ctx, ld)\n        let mut arm_mask_i = arm_names_start\n        while arm_mask_i < Array::length(local_names) {\n          Array::set(local_names, arm_mask_i, \"\")\n          arm_mask_i = arm_mask_i + 1\n        }\n        Array::truncate(ctx.ref_cell_names, arm_ref_cells_start)\n        if anl > max_nl {\n          max_nl = anl\n        } else {\n          ()\n        }\n        emit_else(buf)\n        di = di + 1\n      }\n      bytebuf_push(buf, 0)\n      let mut ce = 0\n      while ce < Array::length(arms) {\n        emit_end(buf)\n        ce = ce + 1\n      }\n      max_nl\n    } else {\n      compile_expr(buf, fallback_expr, local_names, Array::length(local_names), ctx, ld)\n    }\n    emit_end(buf)\n    emit_br(buf, 2)\n    emit_end(buf)\n    emit_drop(buf)\n    emit_br(buf, 0)\n    emit_end(buf)\n    bytebuf_push(buf, 0)\n    emit_end(buf)\n    let mut post_mask_i = body_names_start\n    while post_mask_i < Array::length(local_names) {\n      Array::set(local_names, post_mask_i, \"\")\n      post_mask_i = post_mask_i + 1\n    }\n    Array::truncate(ctx.ref_cell_names, body_ref_cells_start)\n    nl2\n  } else {\n    compile_expr(buf, body, local_names, next_local, ctx, ld)\n  }\n}\n")
