"\nimport @vibe/compiler/core {\n  Type\n}\n\nimport @vibe/core {\n  array_empty\n}\n\n\nfn fixed_array_no_params() -> Array[Type] {\n  array_empty()\n}\n\nfn fixed_array_one_param(a: Type) -> Array[Type] {\n  let arr = fixed_array_no_params()\n  Array::push(arr, a)\n  arr\n}\n\nfn fixed_array_two_params(a: Type, b: Type) -> Array[Type] {\n  let arr = fixed_array_no_params()\n  Array::push(arr, a)\n  Array::push(arr, b)\n  arr\n}\n\nfn fixed_array_five_params(a: Type, b: Type, c: Type, d: Type, e: Type) -> Array[Type] {\n  let arr = fixed_array_no_params()\n  Array::push(arr, a)\n  Array::push(arr, b)\n  Array::push(arr, c)\n  Array::push(arr, d)\n  Array::push(arr, e)\n  arr\n}\n\nfn fixed_array_three_params(a: Type, b: Type, c: Type) -> Array[Type] {\n  let arr = fixed_array_no_params()\n  Array::push(arr, a)\n  Array::push(arr, b)\n  Array::push(arr, c)\n  arr\n}\n\nfn lookup_fixed_array_get(name: String) -> Option[Type] {\n  if name == \"FixedArray::get\" {\n    Some(CtFn(fixed_array_two_params(CtArray(CtUnknown), CtInt), CtUnknown, None))\n  }\n  else None\n}\n\nfn lookup_fixed_array_set(name: String) -> Option[Type] {\n  if name == \"FixedArray::set\" {\n    Some(CtFn(fixed_array_three_params(CtArray(CtUnknown), CtInt, CtUnknown), CtUnit, None))\n  }\n  else None\n}\n\nfn lookup_fixed_array_blit(name: String) -> Option[Type] {\n  if name == \"FixedArray::blit\" {\n    Some(CtFn(fixed_array_five_params(CtArray(CtUnknown), CtInt, CtArray(CtUnknown), CtInt, CtInt), CtUnit, None))\n  }\n  else None\n}\n\nfn lookup_fixed_array_make(name: String) -> Option[Type] {\n  if name == \"FixedArray::make\" {\n    Some(CtFn(fixed_array_two_params(CtInt, CtUnknown), CtArray(CtUnknown), None))\n  }\n  else None\n}\n\nfn lookup_fixed_array_length(name: String) -> Option[Type] {\n  if name == \"FixedArray::length\" {\n    Some(CtFn(fixed_array_one_param(CtArray(CtUnknown)), CtInt, None))\n  }\n  else None\n}\n\nfn lookup_fixed_array_group_a(name: String) -> Option[Type] {\n  match lookup_fixed_array_make(name) {\n    Some(t) => Some(t),\n    None => match lookup_fixed_array_length(name) {\n      Some(t) => Some(t),\n      None => lookup_fixed_array_get(name)\n    }\n  }\n}\n\nfn lookup_fixed_array_unsafe_set(name: String) -> Option[Type] {\n  if name == \"FixedArray::unsafe_set\" {\n    Some(CtFn(fixed_array_three_params(CtArray(CtUnknown), CtInt, CtUnknown), CtUnit, None))\n  }\n  else None\n}\n\nfn lookup_fixed_array_group_b(name: String) -> Option[Type] {\n  match lookup_fixed_array_set(name) {\n    Some(t) => Some(t),\n    None => match lookup_fixed_array_unsafe_set(name) {\n      Some(t) => Some(t),\n      None => lookup_fixed_array_blit(name)\n    }\n  }\n}\n\nexport fn lookup_fixed_array(name: String) -> Option[Type] {\n  match lookup_fixed_array_group_a(name) {\n    Some(t) => Some(t),\n    None => lookup_fixed_array_group_b(name)\n  }\n}\n")
}

