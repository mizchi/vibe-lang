_i64_and, emit_i64_const, emit_i64_div_s, emit_i64_eq, emit_i64_eqz, emit_i64_extend_i32_s, emit_i64_ge_s, emit_i64_gt_s, emit_i64_le_s, emit_i64_lt_s, emit_i64_mul, emit_i64_ne, emit_i64_or, emit_i64_reinterpret_f64, emit_i64_rem_s, emit_i64_shl, emit_i64_shr_s, emit_i64_sub, emit_i64_trunc_f64_s, emit_i64_xor, emit_if_i64, emit_if_void, emit_import_section_func, emit_local_get, emit_local_set, emit_local_tee, emit_loop_void, emit_memory_section, emit_name, emit_return, emit_table_section_funcref, emit_type_section, emit_type_section_multi, string_to_data\\n}\\n\\nimport ./compile_call.vibe {\\n  cc_is_borrow_ret_call, cc_is_loop_borrowed_ident, compile_call\\n}\\n\\nimport ./compile_expr_tail3.vibe {\\n  compile_expr_tail3\\n}\\n\\nimport ./compile_lambda.vibe {\\n  compile_lambda\\n}\\n\\nimport ./compile_match.vibe {\\n  compile_match\\n}\\n\\n//# Functions\\n\\nexport fn compile_expr_tail2(buf: Bytes, expr: Expr, local_names: Array[String], next_local: Int, ctx: CompileCtx, ld: Int, compile_expr: (Bytes, Expr, Array[String], Int, CompileCtx, Int) -> Int with { Error }) -> Int with { Error } {\\n  let __tag = expr_tag(expr)\\n  if __tag == 15 {\\n    let __tuple_elems = get_etuple_elems(expr)\\n    let num_elems = Array::length(__tuple_elems)\\n    let ptr_local = next_local\\n    Array::push(local_names, \\\"__tuple_ptr\\\")\\n    let mut nl = next_local + 1\\n    if ctx.enable_rc {\\n      // RC layout (docs/spec/selfhost-rc-port.md):\\n      //   block_start: [alloc_size@0][rc_count@4][type_id@8][length@12][payload@16...]\\n      // The tuple value is block_start+8 (points at type_id), so the live header\\n      // is [alloc_size@ptr-8][rc_count@ptr-4][type_id@ptr+0][length@ptr+4] and the\\n      // payload stays at ptr+8 (field access is unchanged). ptr_local holds\\n      // block_start. type_id 3 = tuple.\\n      let total = 16 + num_elems * 8\\n      // ADR-0055 Stage 4: allocate via the free-list search helper (vibe_rc_alloc) —\\n      // exact-fit reuse anywhere in the list, else bump. Replaces the inline\\n      // head-only check, which fragmented when interleaved sizes were freed.\\n      emit_i64_const(buf, total)\\n      emit_call(buf, ctx.rc_alloc_func_idx)\\n      emit_local_set(buf, ptr_local)\\n      // header words at block_start\\n      emit_local_get(buf, ptr_local)\\n      emit_i32_wrap_i64(buf)\\n      emit_i32_const(buf, total)\\n      emit_i32_store(buf, 2, 0)\\n      emit_local_get(buf, ptr_local)\\n      emit_i32_wrap_i64(buf)\\n      emit_i32_const(buf, 1)\\n      emit_i32_store(buf, 2, 4)\\n      // ADR-0055 Stage 2c/3: uniform drop-class byte in the rc_count word's high\\n      // byte (block+7 = value-1). rc stays in the low 24 bits, so dec (full-word\\n      // -1) and the `*256 == 0` zero-test ignore this byte. 1 = field-vector\\n      // ([?@value+0][count@value+4][fields@value+8+i*8]) — the generic recursive\\n      // rc_drop loops `count` fields. (docs/spec/uniform-value-repr.md)\\n      emit_local_get(buf, ptr_local)\\n      emit_i32_wrap_i64(buf)\\n      emit_i32_const(buf, 1)\\n      emit_i32_store8(buf, 0, 7)\\n      emit_local_get(buf, ptr_local)\\n      emit_i32_wrap_i64(buf)\\n      emit_i32_const(buf, 3)\\n      emit_i32_store(buf, 2, 8)\\n      emit_local_get(buf, ptr_local)\\n      emit_i32_wrap_i64(buf)\\n      emit_i32_const(buf, num_elems)\\n      emit_i32_store(buf, 2, 12)\\n      let mut tri = 0\\n      while tri < num_elems {\\n        let __tup_elem = Array::get(__tuple_elems, tri)\\n        nl = compile_expr(buf, __tup_elem, local_names, nl, ctx, ld)\\n        let __tup_val_local = nl\\n        Array::push(local_names, \\\"__tup_val\\\")\\n        emit_local_set(buf, __tup_val_local)\\n        nl = nl + 1\\n        // #715: a tuple element sourced from a field projection (`a.f`) or a\\n        // borrow-returning call (Array::get/Map::get/__rec_field/a user\\n        // wrapper) is a BORROWED view of its source, exactly like the same\\n        // case already handled for ERecord fields above (#704/#708) --\\n        // without this retain, dropping the source after storing its\\n        // element into this owning tuple leaves the tuple holding a\\n        // dangling reference once the source is freed.\\n        //\\n        // The same applies to a BARE IDENT element whose binding is itself\\n        // borrow-bound (`let pt2 = f(resolved, env)` where `f` returns its\\n        // own argument -- the #708 is_borrow_ret_ext piggyback marks such a\\n        // name loop-borrowed for the let's body) or live-in to an enclosing\\n        // loop (#706): compile_call already dups these at call-argument\\n        // positions via cc_is_loop_borrowed_ident, but a tuple literal\\n        // stored the bare borrowed ref undup'd, so the true owner's\\n        // scope-end drop freed the block the escaping tuple still pointed\\n        // at (checker.vibe's `(pt2, s1, c1)` in check_expr's EFn param loop\\n        // -- the `enum Shape { Circle }` / `(Int) -> Int` one-line repros'\\n        // confirmed UAF site).\\n        let __tup_is_proj = match __tup_elem {\\n          EDot(_, _, _, _) => true,\\n          _ => false\\n        }\\n        if ctx.enable_rc && (__tup_is_proj || cc_is_borrow_ret_call(__tup_elem, ctx) || cc_is_loop_borrowed_ident(__tup_elem, ctx)) {\\n          emit_rc_dup_guarded(buf, __tup_val_local, ctx.rc_shadow)\\n        } else {\\n          ()\\n        }\\n        emit_local_get(buf, ptr_local)\\n        emit_i32_wrap_i64(buf)\\n        emit_local_get(buf, __tup_val_local)\\n        emit_i64_store(buf, 3, 16 + tri * 8)\\n        tri = tri + 1\\n      }\\n      // tuple value = (block_start + 8) | 1 (ADR-0055 Stage 2: all heap pointers\\n      // are odd so a generic recursive rc_drop can classify fields by `& 1`).\\n      emit_local_get(buf, ptr_local)\\n      emit_i64_const(buf, 8)\\n      emit_i64_add(buf)\\n      emit_i64_const(buf, 1)\\n      emit_i64_or(buf)\\n      nl\\n    } else {\\n      let alloc_size = num_elems * 8\\n      emit_global_get(buf, 0)\\n      emit_i64_extend_i32_u(buf)\\n      emit_local_tee(buf, ptr_local)\\n      emit_i32_wrap_i64(buf)\\n      emit_i32_const(buf, alloc_size)\\n      emit_i32_add(buf)\\n      emit_global_set(buf, 0)\\n      emit_heap_grow_after_heap_set(buf, ctx)\\n      let mut ti = 0\\n      while ti < num_elems {\\n        emit_local_get(buf, ptr_local)\\n        emit_i32_wrap_i64(buf)\\n        nl = compile_expr(buf, Array::get(__tuple_elems, ti), local_names, nl, ctx, ld)\\n        emit_i64_store(buf, 3, ti * 8)\\n        ti = ti + 1\\n      }\\n      emit_local_get(buf, ptr_local)\\n      nl\\n    }\\n  } else if __tag == 16 {\\n    compile_match(buf, expr, local_names, next_local, ctx, ld, compile_expr)\\n  } else if __tag == 17 {\\n    let elems = get_earray_elems(expr)\\n    let n_elems = Array::length(elems)\\n    if ctx.enable_rc {\\n      // RC array literal: inline-allocate the array object with the tuple-style\\n      // RC layout so it drops like a tuple (value = block+8, untagged). Object\\n      // layout at the value pointer matches the array runtime\\n      // (`[capacity@0][length@4][data_ptr@8][inline_data@12...]`); data_ptr points\\n      // at the inline buffer (value+12). capacity defaults to 8 (as array_new)\\n      // but is sized up for larger literals so all elements fit inline.\\n      // The header behind is [alloc_size@-8][rc_count@-4]; the array runtime\\n      // (Array::get / length / push) reads value+0/+4/+8, unchanged.\\n      // (docs/spec/selfhost-rc-port.md)\\n      let cap = if n_elems > 8 {\\n        n_elems\\n      } else {\\n        8\\n      }\\n      let total = 20 + cap * 8\\n      let ptr_local = next_local\\n      Array::push(local_names, \\\"__arr_ptr\\\")\\n      let mut nl = next_local + 1\\n      // ADR-0055 Stage 4: allocate via the free-list search helper (vibe_rc_alloc).\\n      emit_i64_const(buf, total)\\n      emit_call(buf, ctx.rc_alloc_func_idx)\\n      emit_local_set(buf, ptr_local)\\n      // header at block_start\\n      emit_local_get(buf, ptr_local)\\n      emit_i32_wrap_i64(buf)\\n      emit_i32_const(buf, total)\\n      emit_i32_store(buf, 2, 0)\\n      emit_local_get(buf, ptr_local)\\n      emit_i32_wrap_i64(buf)\\n      emit_i32_const(buf, 1)\\n      emit_i32_store(buf, 2, 4)\\n      // ADR-0055 Stage 2c/3: drop-class byte (block+7). 5 = array — value+0 is\\n      // capacity (not a count) and elements live behind data_ptr@value+8, so the\\n      // recursive rc_drop must use the array path, not the field-vector loop.\\n      emit_local_get(buf, ptr_local)\\n      emit_i32_wrap_i64(buf)\\n      emit_i32_const(buf, 5)\\n      emit_i32_store8(buf, 0, 7)\\n      // array object at block_start+8 = value: capacity, length, data_ptr\\n      emit_local_get(buf, ptr_local)\\n      emit_i32_wrap_i64(buf)\\n      emit_i32_const(buf, cap)\\n      emit_i32_store(buf, 2, 8)\\n      emit_local_get(buf, ptr_local)\\n      emit_i32_wrap_i64(buf)\\n      emit_i32_const(buf, n_elems)\\n      emit_i32_store(buf, 2, 12)\\n      // data_ptr = value + 12 = block_start + 20 (inline buffer)\\n      emit_local_get(buf, ptr_local)\\n      emit_i32_wrap_i64(buf)\\n      emit_local_get(buf, ptr_local)\\n      emit_i32_wrap_i64(buf)\\n      emit_i32_const(buf, 20)\\n      emit_i32_add(buf)\\n      emit_i32_store(buf, 2, 16)\\n      // store elements at block_start + 20 + i*8\\n      let mut ai = 0\\n      while ai < n_elems {\\n        let __arr_elem = Array::get(elems, ai)\\n        nl = compile_expr(buf, __arr_elem, local_names, nl, ctx, ld)\\n        let __arr_val_local = nl\\n        Array::push(local_names, \\\"__arr_val\\\")\\n        emit_local_set(buf, __arr_val_local)\\n        nl = nl + 1\\n        // #715: an array-literal element sourced from a projection, a\\n        // borrow-returning call, or a borrow-bound/loop-borrowed bare ident\\n        // is a BORROWED view of its source; the array OWNS its elements\\n        // (drop class 5 recurses), so retain it or the source's drop frees\\n        // the block this array still points at. Same gap/fix as the ETuple\\n        // case above (see its comment).\\n        let __arr_is_proj = match __arr_elem {\\n          EDot(_, _, _, _) => true,\\n          _ => false\\n        }\\n        if __arr_is_proj || cc_is_borrow_ret_call(__arr_elem, ctx) || cc_is_loop_borrowed_ident(__arr_elem, ctx) {\\n          emit_rc_dup_guarded(buf, __arr_val_local, ctx.rc_shadow)\\n        } else {\\n          ()\\n        }\\n        emit_local_get(buf, ptr_local)\\n        emit_i32_wrap_i64(buf)\\n        emit_local_get(buf, __arr_val_local)\\n        emit_i64_store(buf, 3, 20 + ai * 8)\\n        ai = ai + 1\\n      }\\n      // array value = (block_start + 8) | 1 (ADR-0055 Stage 2b: odd heap pointer)\\n      emit_local_get(buf, ptr_local)\\n      emit_i64_const(buf, 8)\\n      emit_i64_add(buf)\\n      emit_i64_const(buf, 1)\\n      emit_i64_or(buf)\\n      nl\\n    } else {\\n      let (arr_new_idx, _, _) = resolve_func(ctx.func_table, \\\"array_new\\\")\\n      let (arr_push_idx, _, _) = resolve_func(ctx.func_table, \\\"Array::push\\\")\\n      let arr_local = next_local\\n      emit_call(buf, arr_new_idx)\\n      emit_local_set(buf, arr_local)\\n      Array::push(local_names, \\\"__arr_lit\\\")\\n      let mut nl = next_local + 1\\n      let mut ei = 0\\n      while ei < Array::length(elems) {\\n        emit_local_get(buf, arr_local)\\n        nl = compile_expr(buf, Array::get(elems, ei), local_names, nl, ctx, ld)\\n        emit_call(buf, arr_push_idx)\\n        ei = ei + 1\\n      }\\n      emit_local_get(buf, arr_local)\\n      nl\\n    }\\n  } else if __tag == 18 {\\n    let names_len_at_forin = Array::length(local_names)\\n    let var_name = get_eforin_name(expr)\\n    let iter_expr = get_eforin_iter(expr)\\n    let body = get_eforin_body(expr)\\n    // #715: mirror EWhile's (#706) loop-borrowed-names protection. The outer\\n    // locals live at loop entry are re-consumed on every iteration via the\\n    // back-edge (`br 0`), so a consuming use of one inside the body must dup\\n    // to survive past the first iteration. Names declared inside the body\\n    // (var_name, index_name, __forin_* temps) are appended past lb_base and\\n    // never added here, matching EWhile.\\n    let lb_base = Array::length(ctx.loop_borrowed_names)\\n    if ctx.enable_rc {\\n      let mut lbi = 0\\n      while lbi < names_len_at_forin {\\n        Array::push(ctx.loop_borrowed_names, Array::get(local_names, lbi))\\n        lbi = lbi + 1\\n      }\\n    } else {\\n      ()\\n    }\\n    let (arr_new_fi, _, _) = resolve_func(ctx.func_table, \\\"array_new\\\")\\n    let (arr_len_fi, _, _) = resolve_func(ctx.func_table, \\\"Array::length\\\")\\n    let (arr_get_fi, _, _) = resolve_func(ctx.func_table, \\\"Array::get\\\")\\n    let (arr_push_fi, _, _) = resolve_func(ctx.func_table, \\\"Array::push\\\")\\n    let result_local = next_local\\n    let arr_local = next_local + 1\\n    let i_local = next_local + 2\\n    Array::push(local_names, \\\"__forin_res\\\")\\n    Array::push(local_names, \\\"__forin_arr\\\")\\n    Array::push(local_names, \\\"__forin_i\\\")\\n    emit_call(buf, arr_new_fi)\\n    emit_local_set(buf, result_local)\\n    let nl1pre = compile_expr(buf, iter_expr, local_names, next_local + 3, ctx, ld)\\n    emit_local_set(buf, arr_local)\\n    // #807: for-in over a String silently iterated zero times — the loop\\n    // below reads `Array::length` from the value, but a String is an\\n    // `(offset << 32) | length` fat pointer, not an array pointer. Array\\n    // values (rc-tagged or not) are 32-bit heap pointers whose high 32 bits\\n    // are zero, so dispatch on the high bits at runtime (same fat-pointer\\n    // discrimination family as `__to_string`, ADR-0058) and materialize the\\n    // string's bytes into a fresh Array[Int] of char codes before the shared\\n    // array loop. The offset-0 interned string (\\\"\\\") misclassifies as an\\n    // array whose length load reads zeroed memory — 0 iterations either way,\\n    // so it stays correct. String offsets are < 2^31, so the arithmetic\\n    // shift never sign-extends. Under RC the materialized array is not\\n    // dropped at loop exit (same as the iterated value today).\\n    let (str_len_fi, _, _) = resolve_func(ctx.func_table, \\\"String::length\\\")\\n    let (str_ccat_fi, _, _) = resolve_func(ctx.func_table, \\\"String::char_code_at\\\")\\n    let conv_local = nl1pre\\n    let j_local = nl1pre + 1\\n    Array::push(local_names, \\\"__forin_conv\\\")\\n    Array::push(local_names, \\\"__forin_j\\\")\\n    let nl1 = nl1pre + 2\\n    emit_local_get(buf, arr_local)\\n    emit_i64_const(buf, 32)\\n    emit_i64_shr_s(buf)\\n    emit_i64_eqz(buf)\\n    emit_if_void(buf)\\n    emit_else(buf)\\n    emit_call(buf, arr_new_fi)\\n    emit_local_set(buf, conv_local)\\n    emit_i64_const(buf, 0)\\n    emit_local_set(buf, j_local)\\n    emit_block_void(buf)\\n    emit_loop_void(buf)\\n    emit_local_get(buf, j_local)\\n    emit_local_get(buf, arr_local)\\n    emit_call(buf, str_len_fi)\\n    if ctx.enable_rc {\\n      emit_i64_const(buf, 1)\\n      emit_i64_shr_s(buf)\\n    } else {\\n      ()\\n    }\\n    emit_i64_ge_s(buf)\\n    emit_br_if(buf, 1)\\n    emit_local_get(buf, conv_local)\\n    emit_local_get(buf, arr_local)\\n    emit_local_get(buf, j_local)\\n    if ctx.enable_rc {\\n      emit_i64_const(buf, 1)\\n      emit_i64_shl(buf)\\n    } else {\\n      ()\\n    }\\n    emit_call(buf, str_ccat_fi)\\n    emit_call(buf, arr_push_fi)\\n    emit_local_get(buf, j_local)\\n    emit_i64_const(buf, 1)\\n    emit_i64_add(buf)\\n    emit_local_set(buf, j_local)\\n    emit_br(buf, 0)\\n    emit_end(buf)\\n    emit_end(buf)\\n    emit_local_get(buf, conv_local)\\n    emit_local_set(buf, arr_local)\\n    emit_end(buf)\\n    emit_i64_const(buf, 0)\\n    emit_local_set(buf, i_local)\\n    emit_block_void(buf)\\n    emit_loop_void(buf)\\n    emit_local_get(buf, i_local)\\n    emit_local_get(buf, arr_local)\\n    emit_call(buf, arr_len_fi)\\n    // `i_local` is a raw counter (init 0, step 1). Under RC `Array::length`\\n    // returns a tagged Int (`len << 1`), so untag it to compare against the raw\\n    // counter — otherwise the loop runs twice per element (#704). The index is\\n    // re-tagged at the `Array::get` site below.\\n    if ctx.enable_rc {\\n      emit_i64_const(buf, 1)\\n      emit_i64_shr_s(buf)\\n    }\\n    emit_i64_ge_s(buf)\\n    emit_br_if(buf, 1)\\n    // Indexed `for i, x in arr`: bind the loop counter to the user index name\\n    // before the value var (gc backend parity — backend_expr.vibe). The counter\\n    // `i_local` is a raw i64; under RC ints are `value << 1`, so shift to match\\n    // the user-visible Int representation (same as EInt codegen).\\n    let index_name = get_eforin_index(expr)\\n    let var_local = match index_name {\\n      Some(idx_name) => {\\n        emit_local_get(buf, i_local)\\n        if ctx.enable_rc {\\n          emit_i64_const(buf, 1)\\n          emit_i64_shl(buf)\\n        }\\n        emit_local_set(buf, nl1)\\n        Array::push(local_names, idx_name)\\n        nl1 + 1\\n      },\\n      None => nl1\\n    }\\n    emit_local_get(buf, arr_local)\\n    emit_local_get(buf, i_local)\\n    // Re-tag the raw counter to a vibe Int (`i << 1`) so `Array::get` (which\\n    // untags its index under RC) reads the correct element (#704).\\n    if ctx.enable_rc {\\n      emit_i64_const(buf, 1)\\n      emit_i64_shl(buf)\\n    }\\n    emit_call(buf, arr_get_fi)\\n    emit_local_set(buf, var_local)\\n    Array::push(local_names, var_name)\\n    // #715: `var_name` is bound to `Array::get(arr, i)`'s result every\\n    // iteration -- a BORROWED view into `arr_local`, exactly like a\\n    // hand-written `let var_name = Array::get(arr, i)` (compile_expr_tail.vibe's\\n    // is_borrow_ret handling, which deliberately leaves such a let untracked\\n    // and instead dups at each owning consuming use via the loop_borrowed_names\\n    // piggyback -- see its #708-follow-up comment). EForIn's implicit bind\\n    // skipped that registration entirely, so a body that passes `var_name` to a\\n    // function taking ownership of its argument (e.g. a self-recursive call\\n    // like `resolve_type_expr(p, defs)`) let the callee drop a reference the\\n    // array still owns -- a same-address free while `arr_local` still points at\\n    // it, corrupting the free list once `arr_local` is later dropped or reread.\\n    // Reuse the same ctx.loop_borrowed_names mechanism (cc_is_loop_borrowed_ident\\n    // in compile_call.vibe) so owning uses of `var_name` inside `body` get the\\n    // missing dup; the existing `Array::truncate(ctx.loop_borrowed_names, lb_base)`\\n    // below already restores the outer state since this push lands after lb_base.\\n    if ctx.enable_rc {\\n      Array::push(ctx.loop_borrowed_names, var_name)\\n    } else {\\n      ()\\n    }\\n    let nl2 = var_local + 1\\n    // Same innermost-loop ld reset as EWhile (see compile_expr_tail3).\\n    let nl3 = compile_expr(buf, body, local_names, nl2, ctx, 0)\\n    let body_val = nl3\\n    Array::push(local_names, \\\"__forin_val\\\")\\n    emit_local_set(buf, body_val)\\n    emit_local_get(buf, result_local)\\n    emit_local_get(buf, body_val)\\n    emit_call(buf, arr_push_fi)\\n    emit_local_get(buf, i_local)\\n    emit_i64_const(buf, 1)\\n    emit_i64_add(buf)\\n    emit_local_set(buf, i_local)\\n    emit_br(buf, 0)\\n    emit_end(buf)\\n    emit_end(buf)\\n    Array::truncate(ctx.loop_borrowed_names, lb_base)\\n    emit_local_get(buf, result_local)\\n    // Restore the outer scope. The loop's internal bindings (result/arr/i, the\\n    // optional index name, the value name, and the body temp) must not leak into\\n    // later identifier lookups, which scan local_names from the end and would\\n    // otherwise resolve a shadowed outer var to a stale loop slot. Mirror\\n    // compile_match: truncate back to the entry length, then pad with placeholders\\n    // up to the high-water local count so slot numbering is preserved.\\n    let final_nl = nl3 + 1\\n    Array::truncate(local_names, names_len_at_forin)\\n    while Array::length(local_names) < final_nl {\\n      Array::push(local_names, \\\"\\\")\\n    }\\n    final_nl\\n  } else {\\n    compile_expr_tail3(buf, expr, local_names, next_local, ctx, ld, compile_expr)\\n  }\\n}\\n\")\n}\n\nlet cli_adapter_source_83 = () -> (String, String) {\n  (\"lib/@vibe/compiler/codegen/expr/compile_expr_tail.vibe\",\n\"//# Imports\\n\\nimport ../../core {\\n  Expr, Pat, Stmt, TypeExpr, bytebuf_length, bytebuf_new, bytebuf_push, bytebuf_push_section, bytebuf_push_vec_header, bytebuf_to_bytes, leb128_encode_s64, leb128_encode_u32\\n}\\n\\nimport ../common_analysis {\\n  collect_free_vars, collect_free_vars_indexed, collect_free_vars_indexed_self, collect_strings_stmts, emit_closure_call_tail, emit_closure_resolve, emit_i64_extend_i32_u, mut_needs_ref_cell, proj_root_ident, scope_tail_proj_root\\n}\\n\\nimport ../common_base {\\n  CompileCtx, CtorTable, FuncTable, LambdaTable, StrTable, agg_expr_lookup, agg_ret_lookup, agg_slot_lookup, find_local_slot, emit_rc_dup_guarded, emit_binop_op, emit_heap_grow_after_heap_set, emit_i32_eq, emit_i32_eqz, emit_i32_ge_u, emit_i32_mul, emit_i32_ne, emit_i32_sub, emit_i64_load, emit_i64_store, emit_str_ref, expr_tag, get_arm_body, get_arm_pat, get_ebinop_op, get_efn_body, get_eif_cond, get_eif_else, get_eif_then, get_elet_body, get_elet_name, get_elet_off, get_elet_val, get_eletmut_off, get_slet_expr, get_slet_name, is_ctor_call, is_earray, is_efn, is_eident, is_erecord, is_etuple, is_nullary_ctor_ident, is_pbind, is_pbool, is_pctor, is_pint, is_pstring, is_ptuple, is_pwild, is_slet, lookup_ctor, resolve_func, resolve_local\\n}\\n\\nimport ../common_extractors {\\n  array_contains_str, emit_assignop_op, emit_memory_copy, find_catchall_idx, first_offset, get_earray_elems, get_eassign_body, get_eassign_name, get_eassign_val, get_eassignop_body, get_eassignop_name, get_eassignop_op, get_eassignop_val, get_ebinop_lhs, get_ebinop_rhs, get_ebool_value, get_ecall_args, get_ecall_callee, get_efloat_value, get_efn_params, get_eforin_body, get_eforin_iter, get_eforin_name, get_eident_name, get_eint_value, get_eletmut_body, get_eletmut_name, get_eletmut_val, get_eletrec_body, get_eletrec_name, get_eletrec_val, get_eseq_first, get_eseq_second, get_estring_value, get_etuple_elems, get_eunaryop_expr, get_eunaryop_op, get_ewhile_body, get_ewhile_cond, get_match_arms, get_match_scrutinee, get_pbind_name, get_pbool_value, get_pctor_args, get_pctor_name, get_pint_value, get_pstring_value, get_ptuple_pats, get_slet_export, offset_to_line, str_table_lookup\\n}\\n\\nimport ../wasm_emit {\\n  emit_block_i64, emit_block_void, emit_br, emit_br_if, emit_call, emit_call_indirect, emit_code_section, emit_code_section_with_locals, emit_data_section, emit_data_section_multi, emit_drop, emit_element_section_active, emit_else, emit_end, emit_export_section, emit_export_section_multi, emit_exports_full, emit_exports_with_memory, emit_f64_add, emit_f64_const_bits, emit_f64_convert_i64_s, emit_f64_div, emit_f64_eq, emit_f64_ge, emit_f64_gt, emit_f64_le, emit_f64_lt, emit_f64_mul, emit_f64_ne, emit_f64_neg, emit_f64_reinterpret_i64, emit_f64_sub, emit_func_type_raw, emit_function_section, emit_global_get, emit_global_section_i32_mut, emit_global_set, emit_header, emit_i32_add, emit_i32_const, emit_i32_load, emit_i32_load8_u, emit_i32_store, emit_i32_store8, emit_i32_wrap_i64, emit_i64_add, emit_i64_and, emit_i64_const, emit_i64_div_s, emit_i64_eq, emit_i64_eqz, emit_i64_extend_i32_s, emit_i64_ge_s, emit_i64_gt_s, emit_i64_le_s, emit_i64_lt_s, emit_i64_mul, emit_i64_ne, emit_i64_or, emit_i64_reinterpret_f64, emit_i64_rem_s, emit_i64_shl, emit_i64_shr_s, emit_i64_sub, emit_i64_trunc_f64_s, emit_i64_xor, emit_if_i64, emit_if_void, emit_import_section_func, emit_local_get, emit_local_set, emit_local_tee, emit_loop_void, emit_memory_section, emit_name, emit_return, emit_table_section_funcref, emit_type_section, emit_type_section_multi, string_to_data\\n}\\n\\nimport ./compile_call.vibe {\\n  compile_call, cc_builtin_call_ret_kind, cc_expr_is_stringish\\n}\\n\\nimport ./compile_expr_tail2.vibe {\\n  compile_expr_tail2\\n}\\n\\nimport ./compile_lambda.vibe {\\n  compile_lambda\\n}\\n\\nimport ./compile_match.vibe {\\n  compile_match\\n}\\n\\n//# Functions\\n\\n// ADR-0055 tag repair for compound assignment: under RC both operands are\\n// tagged (n<<1), so `+`, `-`, `%` preserve the tag for free, but `*` yields\\n// ab<<2 (shift right once) and `/` yields a/b untagged (shift left once).\\n// The raw emit_assignop_op alone silently doubled `x *= 2` results under RC.\\nfn emit_assignop_rc_tag_fix(buf: Bytes, enable_rc: Bool, op: String) -> Unit {\\n  if enable_rc && op == \\\"*\\\" {\\n    emit_i64_const(buf, 1)\\n    emit_i64_shr_s(buf)\\n  } else if enable_rc && op == \\\"/\\\" {\\n    emit_i64_const(buf, 1)\\n    emit_i64_shl(buf)\\n  } else {\\n    ()\\n  }\\n}\\n\\n\\n// Interior-line breakpoints (span-arc step5): when break-mode line instrumentation\\n// is active (ctx.dbg_line_idx >= 0), emit `i32.const <line>` + `call dbg_line` for\\n// the statement whose value subexpression is `value`, deriving the 1-based source\\n// line from the value's first offset. No-op when off or when no offset is found,\\n// so the default codegen path is byte-identical. Stack-neutral: dbg_line is\\n// `(i32) -> ()`, the i32 const it consumes leaves the stack unchanged.\\nfn emit_dbg_line_for(buf: Bytes, value: Expr, ctx: CompileCtx) -> Unit {\\n  emit_dbg_line_stmt(buf, value, -1, ctx)\\n}\\n\\n// #644: like emit_dbg_line_for, but with the STATEMENT's own source offset as\\n// the fallback anchor. `let a = 1` binds a bare literal whose subexpression\\n// carries no offset (first_offset = -1) -- the ELet/ELetMut node's stmt offset\\n// (the `let` keyword token) still locates the line, so the probe is emitted\\n// and the line is breakpoint-able.\\nfn emit_dbg_line_stmt(buf: Bytes, value: Expr, stmt_off: Int, ctx: CompileCtx) -> Unit {\\n  if ctx.dbg_line_idx >= 0 {\\n    let voff = first_offset(value)\\n    let off = if voff >= 0 { voff } else { stmt_off }\\n    if off >= 0 {\\n      let line = offset_to_line(ctx.dbg_line_nl, off)\\n      emit_i32_const(buf, ctx.dbg_line_file_id)\\n      emit_i32_const(buf, line)\\n      emit_call(buf, ctx.dbg_line_idx)\\n    } else {\\n      ()\\n    }\\n  } else {\\n    ()\\n  }\\n}\\n\\nfn is_edot(e: Expr) -> Bool {\\n  match e {\\n    EDot(_, _, _, _) => true,\\n    _ => false\\n  }\\n}\\n\\nfn efn_is_capturing(value: Expr, ctx: CompileCtx) -> Bool with { Error } {\\n  let params = get_efn_params(value)\\n  let pnames = Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n  let mut pi = 0\\n  while pi < Array::length(params) {\\n    let (pn, _) = Array::get(params, pi)\\n    Array::push(pnames, pn)\\n    pi = pi + 1\\n  }\\n  let caps = collect_free_vars_indexed(get_efn_body(value), pnames, ctx.capture_name_index)\\n  Array::length(caps) > 0\\n}\\n\\nfn slot_is_floatish(ctx: CompileCtx, slot: Int) -> Bool {\\n  let arr = ctx.float_local_slots\\n  let mut j = Array::length(arr) - 1\\n  let mut result = false\\n  while j >= 0 {\\n    let entry = Array::get(arr, j)\\n    if entry / 2 == slot {\\n      result = (entry % 2) == 1\\n      j = -1\\n    } else {\\n      j = j - 1\\n    }\\n  }\\n  result\\n}\\n\\n// #678: is the local in `slot` known to hold an Int/Bool? Mirrors\\n// slot_is_floatish over ctx.int_local_slots. #769 encoding: `slot*4 + kind`,\\n// kind 0 = cleared (reclassifying rebind of a reused slot), 1 = Int, 2 =\\n// String (#950), 3 = Bool -- bit 0 still means \\\"intish\\\" (both 1 and 3), so\\n// every pre-existing intish consumer is unchanged, while kind 3 additionally\\n// lets `__to_string` format a bool-bound IDENT as \\\"true\\\"/\\\"false\\\" (the\\n// #784/#785-P2 gap: `let b = true; \\\"\\\\{b}\\\"` printed the raw integer) and kind\\n// 2 routes a string-bound IDENT down `__to_string`'s identity path (the #950\\n// gap: `let j = String::join([], \\\"-\\\"); \\\"\\\\{j}\\\"` printed \\\"0\\\", the packed\\n// empty-string encoding misread as an Int). Most-recent entry wins; the log\\n// is pruned at branch/arm boundaries (int_log_reset_above) so a slot reused\\n// by a non-`let` binder reads false here rather than a stale entry.\\nfn slot_is_intish(ctx: CompileCtx, slot: Int) -> Bool {\\n  let arr = ctx.int_local_slots\\n  let mut j = Array::length(arr) - 1\\n  let mut result = false\\n  while j >= 0 {\\n    let entry = Array::get(arr, j)\\n    if entry / 4 == slot {\\n      result = (entry % 2) == 1\\n      j = -1\\n    } else {\\n      j = j - 1\\n    }\\n  }\\n  result\\n}\\n\\n// #769: is the local in `slot` known to hold specifically a Bool (kind 3)?\\nfn slot_is_boolish(ctx: CompileCtx, slot: Int) -> Bool {\\n  let arr = ctx.int_local_slots\\n  let mut j = Array::length(arr) - 1\\n  let mut result = false\\n  while j >= 0 {\\n    let entry = Array::get(arr, j)\\n    if entry / 4 == slot {\\n      result = (entry % 4) == 3\\n      j = -1\\n    } else {\\n      j = j - 1\\n    }\\n  }\\n  result\\n}\\n\\n// #950: is the local in `slot` known to hold specifically a String (kind 2)?\\n// Consulted only by the rebind-clear logic at the `let`/`let mut` logging\\n// sites (a non-string rebind of a previously-stringish slot must log a\\n// kind-0 override, or a later bare-ident read would see the stale kind-2\\n// entry and take __to_string's identity path on a non-string value).\\nfn slot_is_stringish(ctx: CompileCtx, slot: Int) -> Bool {\\n  let arr = ctx.int_local_slots\\n  let mut j = Array::length(arr) - 1\\n  let mut result = false\\n  while j >= 0 {\\n    let entry = Array::get(arr, j)\\n    if entry / 4 == slot {\\n      result = (entry % 4) == 2\\n      j = -1\\n    } else {\\n      j = j - 1\\n    }\\n  }\\n  result\\n}\\n\\n// #769: does `e` statically evaluate to a Bool? Bool literals, comparison /\\n// logical operators, `!`, and -- via the kind-3 slot log above -- a bare ident\\n// `let`-bound to a boolish value. Syntactic over-approximation like\\n// expr_is_intish; consumers use it only to pick \\\"true\\\"/\\\"false\\\" formatting.\\nexport fn expr_is_boolish(e: Expr, local_names: Array[String], ctx: CompileCtx) -> Bool with { Error } {\\n  let tag = expr_tag(e)\\n  if tag == 1 {\\n    true\\n  } else if tag == 4 {\\n    let nm = get_eident_name(e)\\n    let mut i = Array::length(local_names) - 1\\n    let mut slot = -1\\n    while i >= 0 {\\n      if Array::get(local_names, i) == nm {\\n        slot = i\\n        i = -1\\n      } else {\\n        i = i - 1\\n      }\\n    }\\n    if slot >= 0 {\\n      slot_is_boolish(ctx, slot)\\n    } else {\\n      false\\n    }\\n  } else if tag == 5 {\\n    let op = get_ebinop_op(e)\\n    op == \\\"==\\\" || op == \\\"!=\\\" || op == \\\"<\\\" || op == \\\">\\\" || op == \\\"<=\\\" || op == \\\">=\\\" || op == \\\"&&\\\" || op == \\\"||\\\"\\n  } else if tag == 6 {\\n    get_eunaryop_op(e) == \\\"!\\\"\\n  } else if tag == 16 {\\n    // #815: an `is` expression desugars at parse time to a match whose arms\\n    // all return Bool literals — classify such a match as boolish so\\n    // `\\\"\\\\{opt is None}\\\"` prints true/false instead of the raw 0/1.\\n    // #825: arm bodies recurse through expr_is_boolish (not just Bool\\n    // literals), because the structural `==` dispatch on Option/Result/tuple\\n    // lowers to nested matches whose leaf arms are `==`/`&&` chains and Bool\\n    // literals — so `\\\"\\\\{Some(1) == Some(1)}\\\"` prints true, not 1.\\n    let arms = get_match_arms(e)\\n    let alen2 = Array::length(arms)\\n    if alen2 == 0 {\\n      false\\n    } else {\\n      let mut all_bool = true\\n      let mut bi2 = 0\\n      while bi2 < alen2 {\\n        if !expr_is_boolish(get_arm_body(Array::get(arms, bi2)), local_names, ctx) {\\n          all_bool = false\\n        } else {\\n          ()\\n        }\\n        bi2 = bi2 + 1\\n      }\\n      all_bool\\n    }\\n  } else if tag == 9 {\\n    // #825: the normalize pass lifts a non-ident match scrutinee into\\n    // `let __m_scrut_N = <e> in match ...` (lift_match_scrutinees), so a\\n    // boolish match arrives here wrapped in a let — classify by the BODY.\\n    // Same for the other body-position wrappers below.\\n    expr_is_boolish(get_elet_body(e), local_names, ctx)\\n  } else if tag == 10 {\\n    expr_is_boolish(get_eletrec_body(e), local_names, ctx)\\n  } else if tag == 11 {\\n    expr_is_boolish(get_eletmut_body(e), local_names, ctx)\\n  } else if tag == 14 {\\n    expr_is_boolish(get_eseq_second(e), local_names, ctx)\\n  } else if tag == 7 {\\n    // An if-expression is boolish when BOTH branches are.\\n    expr_is_boolish(get_eif_then(e), local_names, ctx) && expr_is_boolish(get_eif_else(e), local_names, ctx)\\n  } else if tag == 8 {\\n    // #815: the `==` desugar rewrites array equality to the compiler-emitted\\n    // `__arr_equals__<key>` helper and struct/enum equality to `T::equals`\\n    // (both Bool-returning), so the EBinOp shape above is gone by codegen.\\n    // `__arr_equals__` is a reserved compiler prefix; `::equals` (2 args) is\\n    // the == rewrite's exact output shape. A `not(...)` wrap (the `!=`\\n    // rewrite's output) is classified only when its single argument is itself\\n    // boolish AND `not` is not locally shadowed — a user global `not` taking\\n    // a boolish arg but returning non-Bool could still misformat, but that is\\n    // display-only and vanishingly rare (relaxes the #785-P2 caution).\\n    let bcallee = get_ecall_callee(e)\\n    if is_eident(bcallee) {\\n      let bcn = get_eident_name(bcallee)\\n      String::starts_with(bcn, \\\"__arr_equals__\\\") || (String::ends_with(bcn, \\\"::equals\\\") && Array::length(get_ecall_args(e)) == 2) || (bcn == \\\"not\\\" && Array::length(get_ecall_args(e)) == 1 && find_local_slot(local_names, \\\"not\\\") < 0 && expr_is_boolish(Array::get(get_ecall_args(e), 0), local_names, ctx)) || cc_builtin_call_ret_kind(e, local_names, ctx) == 1\\n    } else if is_efn(bcallee) && Array::length(get_ecall_args(e)) == 1 {\\n      // #815: `let x: Bool = e` parses to the ascription marker\\n      // `((__asc: Bool) -> __asc)(e)` (ELet carries no type field, see\\n      // parser_expr_dispatch's ascribe_wrap) — honor the annotation so the\\n      // binding's slot is logged boolish even when `e` itself is opaque.\\n      // The SECOND and later ascriptions in one function arrive with the\\n      // param renamed to `__shadow_<n>___asc` (normalize's\\n      // uniquify_shadowed_bindings; per-function `seen` de-dup), so match\\n      // that renamed form too — otherwise only the first annotated let per\\n      // function was classified (#825 follow-up).\\n      let fparams = get_efn_params(bcallee)\\n      if Array::length(fparams) == 1 {\\n        let (asc_name, asc_ty) = Array::get(fparams, 0)\\n        (asc_name == \\\"__asc\\\" || (String::starts_with(asc_name, \\\"__shadow_\\\") && String::ends_with(asc_name, \\\"___asc\\\"))) && (match asc_ty {\\n          Some(TyName(tn)) => tn == \\\"Bool\\\",\\n          _ => false\\n        })\\n      } else {\\n        false\\n      }\\n    } else {\\n      false\\n    }\\n  } else {\\n    false\\n  }\\n}\\n\\n// Blocker-3 (ADR-0055): does `e` statically evaluate to an f64 bit pattern?\\n// Syntactic over-approximation (the AST is untyped): float literals, float\\n// arithmetic / comparison over floatish operands, float-producing conversions,\\n// and — crucially — a *variable* bound to a floatish value (tracked in\\n// ctx.float_local_slots as `let`s compile). This lets `let x = 1.5; x + y`\\n// take the f64 path. Shared by compile_expr (binop/unary instruction choice)\\n// and the `let` handler below (which populates float_local_slots).\\nexport fn expr_is_floatish(e: Expr, local_names: Array[String], ctx: CompileCtx) -> Bool with { Error } {\\n  // fbox (#797): `t.N` tuple projection survives to codegen as EDot (expr_tag\\n  // -1), NOT as __rec_field (that lowering is only produced for tuple\\n  // DESTRUCTURING and record-pattern desugars). Heap fields store floats as\\n  // raw f64 bits (boxed under RC), so the reader must recover float-ness\\n  // statically -- without this, `let t = (1.5, 2.5); t.0 + t.1` integer-adds\\n  // two bit patterns into NaN and Double::to_int traps. The #724 agg log\\n  // keeps the backing ETuple expression per slot; recurse into the projected\\n  // element. Untracked bindings stay false (same over-approximation as the\\n  // rest of this predicate).\\n  let dot_float = match e {\\n    EDot(dobj, dfield, _, _) => {\\n      let fc = String::char_code_at(dfield, 0)\\n      if fc >= 48 && fc <= 57 && is_eident(dobj) {\\n        let slot = find_local_slot(local_names, get_eident_name(dobj))\\n        if slot >= 0 {\\n          let info = agg_slot_lookup(ctx.agg_local_slots, slot)\\n          if info >= 0 && info / 64 == 1 {\\n            let backing = agg_expr_lookup(ctx.agg_local_slots, ctx.agg_local_exprs, slot)\\n            if is_etuple(backing) {\\n              let elems = get_etuple_elems(backing)\\n              let mut k = 0\\n              let mut fp = 0\\n              while fp < String::length(dfield) {\\n                k = k * 10 + (String::char_code_at(dfield, fp) - 48)\\n                fp = fp + 1\\n              }\\n              if k >= 0 && k < Array::length(elems) {\\n                expr_is_floatish(Array::get(elems, k), local_names, ctx)\\n              } else {\\n                false\\n              }\\n            } else {\\n              false\\n            }\\n          } else {\\n            false\\n          }\\n        } else {\\n          false\\n        }\\n      } else {\\n        false\\n      }\\n    },\\n    _ => false\\n  }\\n  let tag = expr_tag(e)\\n  if dot_float {\\n    true\\n  } else if tag == 2 {\\n    true\\n  } else if tag == 4 {\\n    let nm = get_eident_name(e)\\n    let len = Array::length(local_names)\\n    let mut i = len - 1\\n    let mut slot = -1\\n    while i >= 0 {\\n      if Array::get(local_names, i) == nm {\\n        slot = i\\n        i = -1\\n      } else {\\n        i = i - 1\\n      }\\n    }\\n    if slot >= 0 {\\n      slot_is_floatish(ctx, slot)\\n    } else {\\n      false\\n    }\\n  } else if tag == 5 {\\n    let op = get_ebinop_op(e)\\n    // #744: arithmetic only. A float COMPARISON (`n < 0.0`) yields a Bool —\\n    // including `<`/`>`/`<=`/`>=` here marked a let-bound comparison result\\n    // as floatish, and a later `neg && ...` on that Bool took the float binop\\n    // path and threw \\\"unsupported float binop: &&\\\".\\n    if op == \\\"+\\\" || op == \\\"-\\\" || op == \\\"*\\\" || op == \\\"/\\\" {\\n      expr_is_floatish(get_ebinop_lhs(e), local_names, ctx) || expr_is_floatish(get_ebinop_rhs(e), local_names, ctx)\\n    } else {\\n      false\\n    }\\n  } else if tag == 6 {\\n    let op = get_eunaryop_op(e)\\n    if op == \\\"-\\\" {\\n      expr_is_floatish(get_eunaryop_expr(e), local_names, ctx)\\n    } else {\\n      false\\n    }\\n  } else if tag == 8 {\\n    let callee = get_ecall_callee(e)\\n    if is_eident(callee) {\\n      let fname = get_eident_name(callee)\\n      if fname == \\\"Int::to_double\\\" || fname == \\\"Int::to_float\\\" || fname == \\\"Float::to_double\\\" || fname == \\\"Double::to_float\\\" || fname == \\\"Double::from_i64_bits\\\" {\\n        true\\n      } else if fname == \\\"__rec_field\\\" {\\n        // fbox (#797): `t.0` on a TRACKED tuple-literal binding (`let t =\\n        // (1.5, 2.5)`). Heap fields store floats as RAW f64 bits, so the\\n        // reader must recover float-ness statically -- without this, `t.0 +\\n        // t.1` integer-adds two bit patterns into NaN and `Double::to_int`\\n        // traps (\\\"invalid conversion to integer\\\"). The #724 agg log already\\n        // keeps the backing ETuple expression per slot; recurse into the\\n        // projected element. Non-literal / untracked bindings stay false\\n        // (same over-approximation as the rest of this predicate).\\n        let args = get_ecall_args(e)\\n        if Array::length(args) == 2 && is_eident(Array::get(args, 0)) && expr_tag(Array::get(args, 1)) == 0 {\\n          let slot = find_local_slot(local_names, get_eident_name(Array::get(args, 0)))\\n          if slot >= 0 {\\n            let info = agg_slot_lookup(ctx.agg_local_slots, slot)\\n            if info >= 0 && info / 64 == 1 {\\n              let backing = agg_expr_lookup(ctx.agg_local_slots, ctx.agg_local_exprs, slot)\\n              if is_etuple(backing) {\\n                let elems = get_etuple_elems(backing)\\n                let k = get_eint_value(Array::get(args, 1))\\n                if k >= 0 && k < Array::length(elems) {\\n                  expr_is_floatish(Array::get(elems, k), local_names, ctx)\\n                } else {\\n                  false\\n                }\\n              } else {\\n                false\\n              }\\n            } else {\\n              false\\n            }\\n          } else {\\n            false\\n          }\\n        } else {\\n          false\\n        }\\n      } else {\\n        false\\n      }\\n    } else {\\n      false\\n    }\\n  } else {\\n    false\\n  }\\n}\\n\\n// #678: is `e` unambiguously an integer/bool scalar — never a string or float?\\n// Such an operand makes `==`/`!=` a direct i64.eq instead of the polymorphic\\n// `eq` builtin, whose string fall-back misreads a large integer as a string\\n// fat-pointer `(ptr<<32)|len` (two unequal ints with a zero low word compare\\n// EQUAL). Integral by SHAPE: literals, bitwise/comparison/logical operators,\\n// non-float arithmetic. A bare identifier is integral when its slot was bound\\n// to a definitely-integral value (ctx.int_local_slots, the dual of\\n// expr_is_floatish) — sound because that log is pruned at every branch/arm\\n// boundary (int_log_reset_above), so a slot reused by a non-`let` binder\\n// holding a string is never read as int. Unclassified operands (a call return,\\n// an untracked param/capture) stay false and fall back to the bounds-guarded\\n// `eq` — the narrow remaining residual.\\nexport fn expr_is_intish(e: Expr, local_names: Array[String], ctx: CompileCtx) -> Bool with { Error } {\\n  let tag = expr_tag(e)\\n  if tag == 0 {\\n    true\\n  } else if tag == 1 {\\n    true\\n  } else if tag == 4 {\\n    let nm = get_eident_name(e)\\n    let len = Array::length(local_names)\\n    let mut i = len - 1\\n    let mut slot = -1\\n    while i >= 0 {\\n      if Array::get(local_names, i) == nm {\\n        slot = i\\n        i = -1\\n      } else {\\n        i = i - 1\\n      }\\n    }\\n    if slot >= 0 {\\n      slot_is_intish(ctx, slot)\\n    } else {\\n      false\\n    }\\n  } else if tag == 5 {\\n    let op = get_ebinop_op(e)\\n    if op == \\\"&\\\" || op == \\\"|\\\" || op == \\\"^\\\" || op == \\\"<<\\\" || op == \\\">>\\\" || op == \\\"%\\\" || op == \\\"<\\\" || op == \\\">\\\" || op == \\\"<=\\\" || op == \\\">=\\\" || op == \\\"==\\\" || op == \\\"!=\\\" || op == \\\"&&\\\" || op == \\\"||\\\" {\\n      true\\n    } else if op == \\\"+\\\" || op == \\\"-\\\" || op == \\\"*\\\" || op == \\\"/\\\" {\\n      !expr_is_floatish(e, local_names, ctx)\\n    } else {\\n      false\\n    }\\n  } else if tag == 6 {\\n    let op = get_eunaryop_op(e)\\n    op == \\\"!\\\"\\n  } else {\\n    false\\n  }\\n}\\n\\n\\nfn assign_value_mentions(value: Expr, name: String) -> Bool {\\n  let empty1 = Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n  let empty2 = Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n  array_contains_str(collect_free_vars(value, empty1, empty2), name)\\n}\\n\\nfn reassign_carry_safe(e: Expr, name: String) -> Bool {\\n  if !assign_value_mentions(e, name) {\\n    true\\n  } else {\\n    match e {\\n      EIdent(_, _) => true,\\n      EDot(_, _, _, _) => proj_root_ident(e) == name,\\n      EBinOp(_, l, r) => reassign_carry_safe(l, name) && reassign_carry_safe(r, name),\\n      EUnaryOp(_, x) => reassign_carry_safe(x, name),\\n      _ => false\\n    }\\n  }\\n}\\n\\nfn emit_rc_value_ptr_i32(buf: Bytes, local_idx: Int, tagged: Bool) -> Unit {\\n  emit_local_get(buf, local_idx)\\n  if tagged {\\n    emit_i64_const(buf, -2)\\n    emit_i64_and(buf)\\n  } else {\\n    ()\\n  }\\n  emit_i32_wrap_i64(buf)\\n}\\n\\nfn emit_rc_drop_local(buf: Bytes, local_idx: Int, tagged: Bool) -> Unit {\\n  // #720: a saturated rc (low 24 bits == 0xFFFFFF) marks an immortal block\\n  // (see emit_rc_word_inc_saturating) -- never decrement, never free.\\n  emit_rc_value_ptr_i32(buf, local_idx, tagged)\\n  emit_i32_const(buf, 4)\\n  emit_i32_sub(buf)\\n  emit_i32_load(buf, 2, 0)\\n  emit_i32_const(buf, 16777215)\\n  bytebuf_push(buf, 113)\\n  emit_i32_const(buf, 16777215)\\n  emit_i32_ne(buf)\\n  emit_if_void(buf)\\n  emit_rc_value_ptr_i32(buf, local_idx, tagged)\\n  emit_i32_const(buf, 4)\\n  emit_i32_sub(buf)\\n  emit_rc_value_ptr_i32(buf, local_idx, tagged)\\n  emit_i32_const(buf, 4)\\n  emit_i32_sub(buf)\\n  emit_i32_load(buf, 2, 0)\\n  emit_i32_const(buf, 1)\\n  emit_i32_sub(buf)\\n  emit_i32_store(buf, 2, 0)\\n  emit_rc_value_ptr_i32(buf, local_idx, tagged)\\n  emit_i32_const(buf, 4)\\n  emit_i32_sub(buf)\\n  emit_i32_load(buf, 2, 0)\\n  emit_i32_const(buf, 256)\\n  emit_i32_mul(buf)\\n  emit_i32_eqz(buf)\\n  emit_if_void(buf)\\n  emit_rc_value_ptr_i32(buf, local_idx, tagged)\\n  emit_i32_const(buf, 4)\\n  emit_i32_sub(buf)\\n  emit_global_get(buf, 2)\\n  emit_i32_store(buf, 2, 0)\\n  emit_rc_value_ptr_i32(buf, local_idx, tagged)\\n  emit_global_set(buf, 2)\\n  emit_end(buf)\\n  emit_end(buf)\\n}\\n\\nfn reassign_self_reusable(value: Expr, name: String) -> Bool with { Error } {\\n  if is_etuple(value) {\\n    let elems = get_etuple_elems(value)\\n    let mut i = 0\\n    let mut ok = true\\n    while i < Array::length(elems) {\\n      if !reassign_carry_safe(Array::get(elems, i), name) {\\n        ok = false\\n      } else {\\n        ()\\n      }\\n      i = i + 1\\n    }\\n    ok\\n  } else {\\n    false\\n  }\\n}\\n\\n// #791: shared RC heap-classification for a `let`/`let mut` binding's INITIAL\\n// value, extracted so ELet (tag 9) and ELetMut (tag 11) can never drift apart\\n// again -- the entire #715/#791 bug family was ELetMut silently missing shape\\n// coverage (EIf/EMatch/ELet/ESeq/EDot/EFn/generic-ECall) that ELet already\\n// had, one shape re-discovered and patched at a time without ever being\\n// ported to the sibling form. Requires `value` to already be compiled and\\n// stored into `local_idx` (so the is_edot/is_eident-alias branches' immediate\\n// `emit_rc_dup_guarded(buf, local_idx, ...)` targets the right local) --\\n// call this AFTER `compile_expr(buf, value, ...)` + the corresponding\\n// `emit_local_set`/`emit_local_tee`, never before. Pushes `name` into\\n// `ctx.heap_binding_names` whenever the value's shape can't be proven scalar;\\n// over-classifying is a leak/no-op at worst (guarded dup/drop no-ops on a\\n// tagged-even scalar), under-classifying is the corruption class both issues\\n// hit. Returns (rc_kind, is_borrow_ret_ext) exactly as the original inline\\n// ELet chain did, for callers that still need those (loop_borrowed_names\\n// scoping for a borrow-returning call's alias).\\nfn classify_let_value_heap(buf: Bytes, value: Expr, name: String, local_idx: Int, local_names: Array[String], ctx: CompileCtx) -> (Int, Bool) with { Error } {\\n  let mut rc_kind = 0\\n  let mut is_borrow_ret_ext = false\\n  if ctx.enable_rc {\\n    if expr_is_floatish(value, local_names, ctx) {\\n      rc_kind = 2\\n      Array::push(ctx.heap_binding_names, name)\\n    } else if is_etuple(value) {\\n      rc_kind = 2\\n      Array::push(ctx.heap_binding_names, name)\\n    } else if is_earray(value) {\\n      rc_kind = 2\\n      Array::push(ctx.heap_binding_names, name)\\n    } else if is_erecord(value) {\\n      rc_kind = 2\\n      Array::push(ctx.heap_binding_names, name)\\n    } else if is_ctor_call(value, ctx.ctor_table) {\\n      rc_kind = 2\\n      Array::push(ctx.heap_binding_names, name)\\n    } else if is_nullary_ctor_ident(value, ctx.ctor_table) {\\n      rc_kind = 2\\n      Array::push(ctx.heap_binding_names, name)\\n    } else if is_eident(value) {\\n      let src = get_eident_name(value)\\n      if array_contains_str(ctx.heap_binding_names, src) {\\n        rc_kind = 2\\n        Array::push(ctx.heap_binding_names, name)\\n        if array_contains_str(ctx.rc_alias_dup_names, name) {\\n          emit_rc_dup_guarded(buf, local_idx, ctx.rc_shadow)\\n        } else {\\n          ()\\n        }\\n      } else {\\n        ()\\n      }\\n    } else if expr_tag(value) == 8 {\\n      let callee = get_ecall_callee(value)\\n      let is_borrow_ret = if is_eident(callee) {\\n        let cn = get_eident_name(callee)\\n        cn == \\\"Array::get\\\" || cn == \\\"__index\\\" || cn == \\\"Map::get\\\" || cn == \\\"__rec_field\\\" || array_contains_str(ctx.borrow_ret_names, cn)\\n      } else {\\n        false\\n      }\\n      // #791: consult the DECLARED return-type table (compute_heap_returning,\\n      // built once from a syntactic scan of top-level signatures -- see its\\n      // doc comment) before falling back to the blanket \\\"any ECall is heap\\\"\\n      // default. This makes the common `let mut s = Set::new()` case\\n      // precise (uses the function's OWN declared `-> Set[T]` signature)\\n      // instead of over-approximating every call, without needing full\\n      // checker-inferred types threaded through codegen.\\n      let is_declared_heap_ret = if is_eident(callee) {\\n        array_contains_str(ctx.heap_ret_names, get_eident_name(callee))\\n      } else {\\n        false\\n      }\\n      let is_builtin_scalar_ret = if is_eident(callee) {\\n        let cn = get_eident_name(callee)\\n        let is_always_registered = cn == \\\"Array::length\\\" || cn == \\\"Bytes::length\\\" || cn == \\\"String::length\\\" || cn == \\\"eq\\\"\\n        let is_user_shadowed = !is_always_registered && array_contains_str(ctx.func_table.names, cn)\\n        !is_user_shadowed && (cn == \\\"Array::length\\\" || cn == \\\"Bytes::length\\\" || cn == \\\"String::length\\\" || cn == \\\"Map::has_key\\\" || cn == \\\"Array::contains\\\" || cn == \\\"eq\\\" || cn == \\\"not\\\" || cn == \\\"add\\\" || cn == \\\"sub\\\" || cn == \\\"mul\\\" || cn == \\\"lt\\\")\\n      } else {\\n        false\\n      }\\n      let is_scalar_ret = if is_eident(callee) {\\n        array_contains_str(ctx.scalar_ret_names, get_eident_name(callee)) || is_builtin_scalar_ret\\n      } else {\\n        false\\n      }\\n      if is_borrow_ret || is_scalar_ret {\\n        ()\\n      } else if is_declared_heap_ret {\\n        rc_kind = 2\\n        Array::push(ctx.heap_binding_names, name)\\n      } else {\\n        // No declared signature resolved either way (unannotated callee, a\\n        // local closure, or a shadowed/unresolved name) -- default to heap,\\n        // same \\\"leak/no-op at worst\\\" over-approximation the rest of this\\n        // chain already relies on.\\n        rc_kind = 2\\n        Array::push(ctx.heap_binding_names, name)\\n      }\\n      is_borrow_ret_ext = is_borrow_ret\\n    } else if is_edot(value) {\\n      rc_kind = 2\\n      Array::push(ctx.heap_binding_names, name)\\n      emit_rc_dup_guarded(buf, local_idx, ctx.rc_shadow)\\n    } else if is_efn(value) {\\n      if efn_is_capturing(value, ctx) {\\n        rc_kind = 2\\n        Array::push(ctx.heap_binding_names, name)\\n      } else {\\n        ()\\n      }\\n    } else if expr_tag(value) == 7 {\\n      rc_kind = 2\\n      Array::push(ctx.heap_binding_names, name)\\n    } else if expr_tag(value) == 16 {\\n      rc_kind = 2\\n      Array::push(ctx.heap_binding_names, name)\\n    } else if expr_tag(value) == 9 || expr_tag(value) == 14 {\\n      rc_kind = 2\\n      Array::push(ctx.heap_binding_names, name)\\n    } else {\\n      let __sf_tag = expr_tag(value)\\n      if is_eident(value) || __sf_tag == 0 || __sf_tag == 1 || __sf_tag == 2 || __sf_tag == 3 || __sf_tag == 22 {\\n        ()\\n      } else {\\n        rc_kind = 2\\n        Array::push(ctx.heap_binding_names, name)\\n      }\\n    }\\n  } else {\\n    ()\\n  }\\n  (rc_kind, is_borrow_ret_ext)\\n}\\n\\n// #768 (heap-corruption root cause): a `let` whose value is an if/match and\\n// whose scope-end drop is planned (rc_drop_names) consumes ONE reference per\\n// EXECUTION -- but a branch tail that is a bare loop-borrowed ident (or a\\n// projection off one) is a BORROWED read of a loop-carried binding, and the\\n// static Perceus dup budget cannot cover per-iteration reads (same class as\\n// #706's call-arg case, which dups at consuming call sites). Without a dup the\\n// per-iteration drop eats the loop-carried reference itself: refcount reaches\\n// 0 while the outer structure still points at the block, the free-list reuses\\n// it, and the next allocation aliases live data (use-after-free observed as\\n// the ensure_grouped_source_bucket / loader_manifest_sources_test corruption:\\n// `let bucket = if cached { last } else { ensure(...) }` inside `while`).\\n// This rewrite wraps exactly those branch tails in a codegen-internal\\n// `__loop_tail_retain(x)` marker (compile_call emits value + guarded rc_dup),\\n// so the drop consumes the dup instead. Tails bound INSIDE the branch (fresh\\n// call results like the `ensure(...)` arm) are not loop-borrowed and stay\\n// unwrapped -- no new retention on the owned path. Guarded dup no-ops on\\n// scalars/non-RC values; worst case is the codebase-wide \\\"leak, never corrupt\\\"\\n// trade.\\nfn retain_wrap_branch_tails(e: Expr, ctx: CompileCtx) -> Expr with { Error } {\\n  match e {\\n    EIdent(x, p) => if array_contains_str(ctx.loop_borrowed_names, x) && !array_contains_str(ctx.ref_cell_names, x) {\\n      ECall(EIdent(\\\"__loop_tail_retain\\\", -1), [\\n        EIdent(x, p)\\n      ], -1)\\n    } else {\\n      e\\n    },\\n    EDot(_, _, _, _) => {\\n      let root = proj_root_ident(e)\\n      if String::length(root) > 0 && array_contains_str(ctx.loop_borrowed_names, root) && !array_contains_str(ctx.ref_cell_names, root) {\\n        ECall(EIdent(\\\"__loop_tail_retain\\\", -1), [\\n          e\\n        ], -1)\\n      } else {\\n        e\\n      }\\n    },\\n    EIf(c, t, el) => EIf(c, retain_wrap_branch_tails(t, ctx), retain_wrap_branch_tails(el, ctx)),\\n    EMatch(scrut, arms) => {\\n      if Array::length(arms) == 0 {\\n        e\\n      } else {\\n        let out = Array::slice([\\n          Array::get(arms, 0)\\n        ], 0, 0)\\n        let mut ai = 0\\n        while ai < Array::length(arms) {\\n          let (apat, abody) = Array::get(arms, ai)\\n          Array::push(out, (apat, retain_wrap_branch_tails(abody, ctx)))\\n          ai = ai + 1\\n        }\\n        EMatch(scrut, out)\\n      }\\n    },\\n    ELet(n, v, b, soff) => ELet(n, v, retain_wrap_branch_tails(b, ctx), soff),\\n    ELetMut(n, v, b, soff) => ELetMut(n, v, retain_wrap_branch_tails(b, ctx), soff),\\n    ESeq(a, b) => ESeq(a, retain_wrap_branch_tails(b, ctx)),\\n    EAssign(n, v, b) => EAssign(n, v, retain_wrap_branch_tails(b, ctx)),\\n    EAssignOp(o, n, v, b) => EAssignOp(o, n, v, retain_wrap_branch_tails(b, ctx)),\\n    _ => e\\n  }\\n}\\n\\n// #768 (companion to retain_wrap_branch_tails): true when an if/match VALUE\\n// has at least one branch tail that is a BORROWED read -- a loop-borrowed /\\n// borrow-bound bare ident, a projection, or a borrow-returning call. A `let`\\n// bound to such a value is itself a (conditional) borrowed view, so it must be\\n// marked borrow-bound for its body scope exactly like #708 marks a direct\\n// `let x = Array::get(..)`: otherwise the borrow is laundered through the\\n// alias chain and a consuming call's #706/#708 arg dup never fires (observed:\\n// build_merged_stmts_inline's `let namespaced_stmts = if entry {\\n// export_renamed } else { namespace(...) }` passed to an owning callee, whose\\n// param drop freed the block `file_stmts` still owned -- the function-exit\\n// recursive drop then double-freed it, shadow-trapped at that exact site).\\n// The owned branch (fresh call result) sees at most an extra guarded dup at\\n// consuming sites -- the codebase-wide \\\"leak, never corrupt\\\" trade.\\nfn value_has_borrowed_branch_tail(e: Expr, ctx: CompileCtx) -> Bool {\\n  match e {\\n    EIdent(x, _) => array_contains_str(ctx.loop_borrowed_names, x) && !array_contains_str(ctx.ref_cell_names, x),\\n    EDot(_, _, _, _) => true,\\n    ECall(callee, _, _) => match callee {\\n      EIdent(cn, _) => cn == \\\"Array::get\\\" || cn == \\\"__index\\\" || cn == \\\"Map::get\\\" || cn == \\\"__rec_field\\\" || array_contains_str(ctx.borrow_ret_names, cn),\\n      _ => false\\n    },\\n    EIf(_, t, el) => value_has_borrowed_branch_tail(t, ctx) || value_has_borrowed_branch_tail(el, ctx),\\n    EMatch(_, arms) => {\\n      let mut found = false\\n      let mut ai = 0\\n      while ai < Array::length(arms) {\\n        let (_, abody) = Array::get(arms, ai)\\n        if value_has_borrowed_branch_tail(abody, ctx) {\\n          found = true\\n          ai = Array::length(arms)\\n        } else {\\n          ai = ai + 1\\n        }\\n      }\\n      found\\n    },\\n    ELet(_, _, b, _) => value_has_borrowed_branch_tail(b, ctx),\\n    ELetMut(_, _, b, _) => value_has_borrowed_branch_tail(b, ctx),\\n    ESeq(_, b) => value_has_borrowed_branch_tail(b, ctx),\\n    EAssign(_, _, b) => value_has_borrowed_branch_tail(b, ctx),\\n    EAssignOp(_, _, _, b) => value_has_borrowed_branch_tail(b, ctx),\\n    _ => false\\n  }\\n}\\n\\n// #768: apply the branch-tail retain rewrite (see retain_wrap_branch_tails)\\n// when this binding's scope-end drop is planned AND we are inside a loop\\n// (loop_borrowed_names non-empty -- empty outside loops and under bump, so\\n// codegen elsewhere is byte-identical). Only if/match values are rewritten;\\n// the top-level node kind is preserved, so classification of the ORIGINAL\\n// `value` below stays valid.\\nfn retain_wrap_let_value(value: Expr, name: String, ctx: CompileCtx) -> Expr with { Error } {\\n  if ctx.enable_rc && (expr_tag(value) == 7 || expr_tag(value) == 16) && Array::length(ctx.loop_borrowed_names) > 0 && array_contains_str(ctx.rc_drop_names, name) {\\n    retain_wrap_branch_tails(value, ctx)\\n  } else {\\n    value\\n  }\\n}\\n\\nexport fn compile_expr_tail(buf: Bytes, expr: Expr, local_names: Array[String], next_local: Int, ctx: CompileCtx, ld: Int, compile_expr: (Bytes, Expr, Array[String], Int, CompileCtx, Int) -> Int with { Error }) -> Int with { Error } {\\n  let __tag = expr_tag(expr)\\n  if __tag == 9 {\\n    let name = get_elet_name(expr)\\n    let value = get_elet_val(expr)\\n    let body = get_elet_body(expr)\\n    let local_idx = next_local\\n    emit_dbg_line_stmt(buf, value, get_elet_off(expr), ctx)\\n    Array::push(local_names, name)\\n    let nl = compile_expr(buf, retain_wrap_let_value(value, name, ctx), local_names, next_local + 1, ctx, ld)\\n    emit_local_set(buf, local_idx)\\n    let val_is_float = expr_is_floatish(value, local_names, ctx)\\n    if val_is_float {\\n      Array::push(ctx.float_local_slots, local_idx * 2 + 1)\\n    } else if slot_is_floatish(ctx, local_idx) {\\n      Array::push(ctx.float_local_slots, local_idx * 2)\\n    }\\n    // #678: log whether this binding holds a definitely-integral value, so a\\n    // later bare-ident `==` on it bypasses the string-pointer-misreading `eq`.\\n    // Always (re)log when the slot was previously classified, so a rebind of a\\n    // reused slot overrides the earlier entry. #769/#950 encoding: slot*4 +\\n    // kind (0 clear / 1 int / 2 string / 3 bool) -- see slot_is_intish.\\n    if expr_is_boolish(value, local_names, ctx) {\\n      Array::push(ctx.int_local_slots, local_idx * 4 + 3)\\n    } else if expr_is_intish(value, local_names, ctx) {\\n      Array::push(ctx.int_local_slots, local_idx * 4 + 1)\\n    } else if cc_expr_is_stringish(value, local_names, ctx) {\\n      Array::push(ctx.int_local_slots, local_idx * 4 + 2)\\n    } else if slot_is_intish(ctx, local_idx) || slot_is_stringish(ctx, local_idx) {\\n      Array::push(ctx.int_local_slots, local_idx * 4)\\n    }\\n    // #724: log this binding's AGGREGATE shape (tuple arity / ctor-record\\n    // field count) so `a == b` with both sides bound takes the structural\\n    // comparators. kind*64+n; 0 overrides a reused slot. See\\n    // CompileCtx.agg_local_slots.\\n    let agg_entry = if is_etuple(value) {\\n      64 + Array::length(get_etuple_elems(value))\\n    } else if is_ctor_call(value, ctx.ctor_table) {\\n      let cargs = get_ecall_args(value)\\n      // `S::{ ... }` sugar arrives as ECall(S, [ERecord]) — the runtime\\n      // field count is the record's, not the call arity.\\n      let fcnt = if Array::length(cargs) == 1 {\\n        match Array::get(cargs, 0) {\\n          ERecord(_, rfields, _) => Array::length(rfields),\\n          _ => Array::length(cargs)\\n        }\\n      } else {\\n        Array::length(cargs)\\n      }\\n      128 + fcnt\\n    } else if is_nullary_ctor_ident(value, ctx.ctor_table) {\\n      128\\n    } else if is_erecord(value) {\\n      // Records are [tag@0][len@4][fields@8+] since #722, walkable like ctors.\\n      match value {\\n        ERecord(_, rfields, _) => 128 + Array::length(rfields),\\n        _ => 0\\n      }\\n    } else if expr_tag(value) == 8 {\\n      // #724 round 2: `let a = f(..)` — classify by f's DECLARED return type\\n      // (agg_ret table). Only for a global fn name (a local shadowing `f`\\n      // makes this a closure call of unknown type).\\n      match get_ecall_callee(value) {\\n        EIdent(cfn, _) => if find_local_slot(local_names, cfn) < 0 {\\n          let rinfo = agg_ret_lookup(ctx.agg_ret_names, ctx.agg_ret_infos, cfn)\\n          if rinfo > 0 {\\n            rinfo\\n          } else {\\n            0\\n          }\\n        } else {\\n          0\\n        },\\n        _ => 0\\n      }\\n    } else if is_eident(value) {\\n      // Alias of a tracked binding: propagate its shape.\\n      let src_slot = find_local_slot(local_names, get_eident_name(value))\\n      if src_slot >= 0 {\\n        let src_info = agg_slot_lookup(ctx.agg_local_slots, src_slot)\\n        if src_info > 0 {\\n          src_info\\n        } else {\\n          0\\n        }\\n      } else {\\n        0\\n      }\\n    } else {\\n      0\\n    }\\n    // #672 (post-#724): the shape LITERAL backing `agg_entry`, kept in\\n    // lockstep with agg_local_slots (see CompileCtx.agg_local_exprs) so a\\n    // both-sides-tracked `a == b` can recurse into NESTED aggregate elements\\n    // (e.g. `let a = ((1,2),3)`) instead of only comparing the top-level\\n    // shape. An alias propagates its SOURCE's shape expr (not just the\\n    // kind+n int); everything else that isn't a literal (call-result via\\n    // agg_ret, round-2 param/return tracking) has no literal to recurse\\n    // into, so it stores the inert EInt(0) placeholder — those tracked\\n    // slots still get correct TOP-level structural comparison (unchanged\\n    // from before this change) but nested elements under them keep the\\n    // pre-existing generic-eq fallback.\\n    let agg_shape_expr = if is_etuple(value) {\\n      value\\n    } else if is_ctor_call(value, ctx.ctor_table) {\\n      value\\n    } else if is_nullary_ctor_ident(value, ctx.ctor_table) {\\n      value\\n    } else if is_erecord(value) {\\n      value\\n    } else if is_eident(value) {\\n      let src_slot = find_local_slot(local_names, get_eident_name(value))\\n      if src_slot >= 0 {\\n        agg_expr_lookup(ctx.agg_local_slots, ctx.agg_local_exprs, src_slot)\\n      } else {\\n        EInt(0)\\n      }\\n    } else {\\n      EInt(0)\\n    }\\n    Array::push(ctx.agg_local_slots, local_idx * 256 + agg_entry)\\n    Array::push(ctx.agg_local_exprs, agg_shape_expr)\\n    let (rc_kind, is_borrow_ret_ext) = classify_let_value_heap(buf, value, name, local_idx, local_names, ctx)\\n    if ctx.enable_rc && rc_kind > 0 {\\n      let mut dbi = 0\\n      while dbi < Array::length(ctx.rc_dup_names) {\\n        if Array::get(ctx.rc_dup_names, dbi) == name {\\n          emit_rc_dup_guarded(buf, local_idx, ctx.rc_shadow)\\n        } else {\\n          ()\\n        }\\n        dbi = dbi + 1\\n      }\\n    } else {\\n      ()\\n    }\\n    // #712: this `let` may SHADOW an outer loop-borrowed identifier of the same\\n    // name (e.g. `while ... { let x = ...; f(x) }` rebinding `x` inside a loop\\n    // whose header already loop-borrowed an outer `x`, #706). cc_is_loop_borrowed_ident\\n    // (compile_call.vibe) matches by NAME ONLY, so without this an owning call on\\n    // the INNER `x` would be mistaken for a reference to the OUTER loop-carried\\n    // one -- a spurious rc_dup now, and (via loop_consumed_names) a spurious extra\\n    // epilogue rc_drop for a parameter this `let` never touches. Mask every\\n    // existing occurrence of `name` out of loop_borrowed_names for exactly the\\n    // scope of `body`, then restore the same count after; membership is all\\n    // `array_contains_str` ever tests, so compacting out of order is safe.\\n    let mut lb_shadow_removed = 0\\n    if ctx.enable_rc {\\n      let lb_arr = ctx.loop_borrowed_names\\n      let lb_n = Array::length(lb_arr)\\n      let mut lb_w = 0\\n      let mut lb_i = 0\\n      while lb_i < lb_n {\\n        let e = Array::get(lb_arr, lb_i)\\n        if e == name {\\n          lb_shadow_removed = lb_shadow_removed + 1\\n        } else {\\n          Array::set(lb_arr, lb_w, e)\\n          lb_w = lb_w + 1\\n        }\\n        lb_i = lb_i + 1\\n      }\\n      Array::truncate(lb_arr, lb_w)\\n    } else {\\n      ()\\n    }\\n    // #708 follow-up: scope `name` into loop_borrowed_names for exactly the\\n    // extent of `body`'s compilation (push before, truncate after), so a bare\\n    // later reference to a borrow-bound name gets the same retain-before-\\n    // owning-call treatment a loop-carried parameter already gets. Safe to do\\n    // even outside a loop (loop_borrowed_names is otherwise empty there, and\\n    // this push/truncate pair never leaks past this let's own body).\\n    let lb_mark = Array::length(ctx.loop_borrowed_names)\\n    // #768: an if/match value with a borrowed branch tail makes this binding a\\n    // (conditional) borrowed view too -- mark it borrow-bound for the body\\n    // scope so consuming calls dup it (see value_has_borrowed_branch_tail).\\n    let value_borrow_like = ctx.enable_rc && (expr_tag(value) == 7 || expr_tag(value) == 16) && value_has_borrowed_branch_tail(value, ctx)\\n    if ctx.enable_rc && (is_borrow_ret_ext || value_borrow_like) {\\n      Array::push(ctx.loop_borrowed_names, name)\\n    } else {\\n      ()\\n    }\\n    let nl2 = compile_expr(buf, body, local_names, nl, ctx, ld)\\n    if ctx.enable_rc && (is_borrow_ret_ext || value_borrow_like) {\\n      Array::truncate(ctx.loop_borrowed_names, lb_mark)\\n    } else {\\n      ()\\n    }\\n    // #712: restore the shadow-masked occurrences now that `body` (the only\\n    // scope where `name` shadows the outer loop-borrowed binding) is compiled.\\n    let mut lb_restore_i = 0\\n    while lb_restore_i < lb_shadow_removed {\\n      Array::push(ctx.loop_borrowed_names, name)\\n      lb_restore_i = lb_restore_i + 1\\n    }\\n    if ctx.enable_rc && rc_kind > 0 && array_contains_str(ctx.rc_drop_names, name) {\\n      if ctx.rc_drop_func_idx >= 0 && scope_tail_proj_root(body) == name {\\n        emit_local_set(buf, nl2)\\n        emit_rc_dup_guarded(buf, nl2, ctx.rc_shadow)\\n        emit_local_get(buf, local_idx)\\n        emit_call(buf, ctx.rc_drop_func_idx)\\n        emit_local_get(buf, nl2)\\n        nl2 + 1\\n      } else {\\n        if ctx.rc_drop_func_idx >= 0 {\\n          emit_local_get(buf, local_idx)\\n          emit_call(buf, ctx.rc_drop_func_idx)\\n        } else if rc_kind == 1 {\\n          emit_rc_drop_local(buf, local_idx, false)\\n        } else {\\n          emit_rc_drop_local(buf, local_idx, true)\\n        }\\n        nl2\\n      }\\n    } else {\\n      nl2\\n    }\\n  } else if __tag == 10 {\\n    let name = get_eletrec_name(expr)\\n    let value = get_eletrec_val(expr)\\n    let body = get_eletrec_body(expr)\\n    let local_idx = next_local\\n    Array::push(local_names, name)\\n    // #875 fix 2: hint compile_lambda (the immediate, sole callee that\\n    // compiling an EFn value dispatches to) that NAME is this closure's own\\n    // let-rec binding, so its capture computation force-includes NAME even if\\n    // NAME collides with an unrelated entry in ctx.capture_name_index. Only\\n    // set when `value` is actually an EFn (a non-lambda let-rec value, e.g.\\n    // `let rec x = some_expr`, has no self-capture concept); compile_lambda\\n    // consumes and clears this immediately, so it cannot leak to any other\\n    // lambda compiled afterward. See CompileCtx.pending_letrec_self_name.\\n    if is_efn(value) {\\n      Array::truncate(ctx.pending_letrec_self_name, 0)\\n      Array::push(ctx.pending_letrec_self_name, name)\\n    } else {\\n      ()\\n    }\\n    let nl = compile_expr(buf, value, local_names, next_local + 1, ctx, ld)\\n    emit_local_set(buf, local_idx)\\n    if is_efn(value) {\\n      let params = get_efn_params(value)\\n      let fn_body = get_efn_body(value)\\n      let param_names_bp = Array::slice([\\n        \\\"\\\"\\n      ], 0, 0)\\n      let mut bpi = 0\\n      while bpi < Array::length(params) {\\n        let (pn, _) = Array::get(params, bpi)\\n        Array::push(param_names_bp, pn)\\n        bpi = bpi + 1\\n      }\\n      // #875 fix 2: same force-include as compile_lambda's own capture\\n      // computation above -- this is a REDUNDANT recomputation (must match\\n      // compile_lambda's `captures` exactly to find the right self_cap_idx\\n      // slot), so it needs the same self_name override, passed directly\\n      // since `name` is already in scope here (no ctx hint needed at this\\n      // call site).\\n      let caps = collect_free_vars_indexed_self(fn_body, param_names_bp, ctx.capture_name_index, name)\\n      let mut self_cap_idx = -1\\n      let mut bci = 0\\n      while bci < Array::length(caps) {\\n        if Array::get(caps, bci) == name {\\n          self_cap_idx = bci\\n        }\\n        bci = bci + 1\\n      }\\n      if self_cap_idx >= 0 {\\n        emit_local_get(buf, local_idx)\\n        emit_i64_const(buf, -4)\\n        emit_i64_and(buf)\\n        emit_i32_wrap_i64(buf)\\n        emit_local_get(buf, local_idx)\\n        emit_i64_store(buf, 3, 8 + self_cap_idx * 8)\\n      }\\n      0\\n    } else {\\n      0\\n    }\\n    let nl2 = compile_expr(buf, body, local_names, nl, ctx, ld)\\n    nl2\\n  } else if __tag == 11 {\\n    let name = get_eletmut_name(expr)\\n    let value = get_eletmut_val(expr)\\n    let body = get_eletmut_body(expr)\\n    let local_idx = next_local\\n    emit_dbg_line_stmt(buf, value, get_eletmut_off(expr), ctx)\\n    Array::push(local_names, name)\\n    if expr_is_floatish(value, local_names, ctx) {\\n      Array::push(ctx.float_local_slots, local_idx * 2 + 1)\\n    } else if slot_is_floatish(ctx, local_idx) {\\n      Array::push(ctx.float_local_slots, local_idx * 2)\\n    }\\n    // #678: track integral mutable bindings too (an Int local stays Int across\\n    // reassignments — the checker forbids changing its type), so a bare-ident\\n    // `==` on it uses the direct i64 path. #769/#950: slot*4 + kind encoding,\\n    // bool tracked as kind 3, string as kind 2 (a mut Bool/String stays that\\n    // type across reassignments too).\\n    if expr_is_boolish(value, local_names, ctx) {\\n      Array::push(ctx.int_local_slots, local_idx * 4 + 3)\\n    } else if expr_is_intish(value, local_names, ctx) {\\n      Array::push(ctx.int_local_slots, local_idx * 4 + 1)\\n    } else if cc_expr_is_stringish(value, local_names, ctx) {\\n      Array::push(ctx.int_local_slots, local_idx * 4 + 2)\\n    } else if slot_is_intish(ctx, local_idx) || slot_is_stringish(ctx, local_idx) {\\n      Array::push(ctx.int_local_slots, local_idx * 4)\\n    }\\n    if mut_needs_ref_cell(body, name) {\\n      Array::push(ctx.ref_cell_names, name)\\n      if ctx.enable_rc && ctx.rc_alloc_func_idx >= 0 && ctx.rc_drop_func_idx >= 0 && expr_is_intish(value, local_names, ctx) {\\n        // #699 RC-managed ref cell: a captured `let mut` is heap-boxed for\\n        // by-reference sharing; under RC make that box an RC object so it is\\n        // reclaimed instead of leaking. Layout [alloc_size@0][rc_count@4 +\\n        // class8@7][payload@8]; the cell local holds vptr=block+8 (even) so the\\n        // read/write/assign-op sites are byte-identical to the raw-box path. The\\n        // capturing closure dups it (compile_lambda.vibe) and drops it via the\\n        // class-7 owned-capture recursion (gen_rc_drop_body); the defining scope\\n        // drops it inline below. Restricted to intish (scalar) values so the\\n        // payload is never a heap object that the body could return (no\\n        // use-after-free): class-8 payload-drop then stays a no-op.\\n        emit_i64_const(buf, 16)\\n        emit_call(buf, ctx.rc_alloc_func_idx)\\n        emit_local_set(buf, local_idx)\\n        emit_local_get(buf, local_idx)\\n        emit_i32_wrap_i64(buf)\\n        emit_i32_const(buf, 16)\\n        emit_i32_store(buf, 2, 0)\\n        emit_local_get(buf, local_idx)\\n        emit_i32_wrap_i64(buf)\\n        emit_i32_const(buf, 1)\\n        emit_i32_store(buf, 2, 4)\\n        emit_local_get(buf, local_idx)\\n        emit_i32_wrap_i64(buf)\\n        emit_i32_const(buf, 8)\\n        emit_i32_store8(buf, 0, 7)\\n        emit_local_get(buf, local_idx)\\n        emit_i64_const(buf, 8)\\n        emit_i64_add(buf)\\n        emit_local_set(buf, local_idx)\\n        emit_local_get(buf, local_idx)\\n        emit_i32_wrap_i64(buf)\\n        let nl = compile_expr(buf, value, local_names, next_local + 1, ctx, ld)\\n        emit_i64_store(buf, 3, 0)\\n        let nl2 = compile_expr(buf, body, local_names, nl, ctx, ld)\\n        emit_local_get(buf, local_idx)\\n        emit_i64_const(buf, 1)\\n        emit_i64_or(buf)\\n        emit_call(buf, ctx.rc_drop_func_idx)\\n        nl2\\n      } else {\\n      emit_global_get(buf, 0)\\n      emit_i64_extend_i32_u(buf)\\n      emit_local_tee(buf, local_idx)\\n      emit_i32_wrap_i64(buf)\\n      emit_i32_const(buf, 8)\\n      emit_i32_add(buf)\\n      emit_global_set(buf, 0)\\n      emit_heap_grow_after_heap_set(buf, ctx)\\n      emit_local_get(buf, local_idx)\\n      emit_i32_wrap_i64(buf)\\n      let nl = compile_expr(buf, value, local_names, next_local + 1, ctx, ld)\\n      emit_i64_store(buf, 3, 0)\\n      let nl2 = compile_expr(buf, body, local_names, nl, ctx, ld)\\n      nl2\\n      }\\n    } else {\\n      // #768: same branch-tail retain rewrite as ELet (see retain_wrap_let_value).\\n      let nl = compile_expr(buf, retain_wrap_let_value(value, name, ctx), local_names, next_local + 1, ctx, ld)\\n      emit_local_set(buf, local_idx)\\n      // #791: classify AFTER the value is compiled + stored (local_idx now\\n      // holds it), matching ELet's ordering -- classify_let_value_heap's\\n      // is_edot/is_eident-alias branches emit an immediate guarded dup\\n      // against local_idx, which only makes sense once it holds the fresh\\n      // value. See classify_let_value_heap's doc comment for why ELetMut\\n      // needs the identical (not just overlapping) classification ELet\\n      // uses -- this used to be a narrower, hand-duplicated condition list\\n      // that repeatedly drifted out of sync with ELet's (the #715/#791 bug\\n      // family); sharing one function makes that drift impossible.\\n      let (_mut_rc_kind, _mut_is_borrow_ret_ext) = classify_let_value_heap(buf, value, name, local_idx, local_names, ctx)\\n      // #715: the ELet path (tag 9) emits every dup the Perceus plan budgeted\\n      // for a binding (ctx.rc_dup_names) at its declaration site -- this\\n      // ELetMut path never did, while the matching scope-end drop below DID\\n      // fire. A `let mut found = None; while .. { match found { .. } }; found`\\n      // accumulator (checker_effects.vibe's lookup_fn_effs) gets a planned\\n      // dup from the #706 borrow-retention bump (the bare `match found`\\n      // borrow) plus a planned scope-end drop; with the dup silently skipped,\\n      // the tail-returned Option's only reference was consumed by the return\\n      // AND by the drop -- the caller's lifted `__m_scrut_N` scrutinee then\\n      // recursively re-dropped the freed block (byte-exact double-free\\n      // confirmed by the drop-site-stamped shadow diagnostic: first free at\\n      // this branch's scope-end drop, second inside\\n      // check_perform_effects_expr_tx). The guarded dup no-ops on scalars, so\\n      // over-emission for a scalar-planned name is harmless.\\n      if ctx.enable_rc {\\n        let mut mdbi = 0\\n        while mdbi < Array::length(ctx.rc_dup_names) {\\n          if Array::get(ctx.rc_dup_names, mdbi) == name {\\n            emit_rc_dup_guarded(buf, local_idx, ctx.rc_shadow)\\n          } else {\\n            ()\\n          }\\n          mdbi = mdbi + 1\\n        }\\n      } else {\\n        ()\\n      }\\n      let nl2 = compile_expr(buf, body, local_names, nl, ctx, ld)\\n      if ctx.enable_rc && array_contains_str(ctx.heap_binding_names, name) && array_contains_str(ctx.rc_drop_names, name) && ctx.rc_drop_func_idx >= 0 {\\n        if scope_tail_proj_root(body) == name {\\n          emit_local_set(buf, nl2)\\n          emit_rc_dup_guarded(buf, nl2, ctx.rc_shadow)\\n          emit_local_get(buf, local_idx)\\n          emit_call(buf, ctx.rc_drop_func_idx)\\n          emit_local_get(buf, nl2)\\n          nl2 + 1\\n        } else {\\n          emit_local_get(buf, local_idx)\\n          emit_call(buf, ctx.rc_drop_func_idx)\\n          nl2\\n        }\\n      } else {\\n        nl2\\n      }\\n    }\\n  } else if __tag == 12 {\\n    let name = get_eassign_name(expr)\\n    let value = get_eassign_val(expr)\\n    let body = get_eassign_body(expr)\\n    let idx = resolve_local(local_names, name, \\\"assign\\\")\\n    if array_contains_str(ctx.ref_cell_names, name) {\\n      emit_local_get(buf, idx)\\n      emit_i32_wrap_i64(buf)\\n      let nl = compile_expr(buf, value, local_names, next_local, ctx, ld)\\n      emit_i64_store(buf, 3, 0)\\n      compile_expr(buf, body, local_names, nl, ctx, ld)\\n    } else {\\n      let is_heap_mut = ctx.enable_rc && ctx.rc_drop_func_idx >= 0 && array_contains_str(ctx.heap_binding_names, name)\\n      let is_self = assign_value_mentions(value, name)\\n      if is_heap_mut && is_self && reassign_self_reusable(value, name) {\\n        let old_temp = next_local\\n        let scratch = next_local + 1\\n        let base = next_local + 2\\n        emit_local_get(buf, idx)\\n        emit_local_set(buf, old_temp)\\n        let elems = get_etuple_elems(value)\\n        let mut ei = 0\\n        while ei < Array::length(elems) {\\n          let elem = Array::get(elems, ei)\\n          if (is_eident(elem) && get_eident_name(elem) == name) || (is_edot(elem) && proj_root_ident(elem) == name) {\\n            let _ = compile_expr(buf, elem, local_names, base, ctx, ld)\\n            emit_local_set(buf, scratch)\\n            emit_rc_dup_guarded(buf, scratch, ctx.rc_shadow)\\n          } else {\\n            ()\\n          }\\n          ei = ei + 1\\n        }\\n        let nl = compile_expr(buf, value, local_names, base, ctx, ld)\\n        emit_local_set(buf, idx)\\n        emit_local_get(buf, old_temp)\\n        emit_call(buf, ctx.rc_drop_func_idx)\\n        compile_expr(buf, body, local_names, nl, ctx, ld)\\n      } else {\\n        if is_heap_mut && !is_self {\\n          emit_local_get(buf, idx)\\n          emit_call(buf, ctx.rc_drop_func_idx)\\n        } else {\\n          ()\\n        }\\n        let nl = compile_expr(buf, value, local_names, next_local, ctx, ld)\\n        emit_local_set(buf, idx)\\n        if is_heap_mut && !is_self && is_edot(value) {\\n          emit_rc_dup_guarded(buf, idx, ctx.rc_shadow)\\n        } else {\\n          ()\\n        }\\n        // #715/#791: the Perceus plan's dup budget for a `let mut` binding\\n        // (ctx.rc_dup_names occurrences) is applied ONCE, to the INITIAL value\\n        // at the declaration site -- but the scope-end drop and every\\n        // remaining owning use consume the binding's CURRENT value. After a\\n        // reassignment, the freshly stored value carries only its own single\\n        // reference; without re-applying the budget here, the tail use plus\\n        // the scope-end drop over-consume it by exactly the planned dup count\\n        // (checker_effects.vibe's lookup_fn_effs: `let mut found = None;\\n        // ... found = Some(..) ...; found` -- the returned Some was freed by\\n        // the binding's scope-end drop while the caller still held it; the\\n        // #706 borrow-retention bump from the bare `match found` is what put\\n        // the +1 in the budget). Worst case this over-retains (a leak) when\\n        // part of the budget was already spent before the reassign -- the\\n        // codebase-wide \\\"leak/no-op at worst, never corrupt\\\" trade.\\n        //\\n        // #791: this budget reapplication was gated on `!is_self`, so a\\n        // SELF-referential reassignment (`s = f(s, ...)`, e.g. a loop\\n        // accumulator `s = Set::add(s, i)`) never got it -- only the narrow\\n        // `reassign_self_reusable` tuple-element branch above has its own\\n        // protection, and non-tuple self-reassignment (an ECall RHS, the\\n        // common accumulator shape) falls through to this same `else` with\\n        // no compensating dup at all. The freshly stored value then carries\\n        // only the single reference `f` returned, so the FIRST subsequent\\n        // owning use of `s` (which internally drops its param) frees it\\n        // prematurely; later uses read/reuse the freed block, corrupting\\n        // memory once an intervening allocation reuses it (2+ further uses\\n        // needed to observe it -- 1 further use still \\\"works\\\" because\\n        // nothing has overwritten the freed-but-untouched memory yet).\\n        // Reproduced/diagnosed via #791 (examples/set_test.vibe \\\"multiple\\n        // adds\\\"): `let mut s = Set::new(); while ... { s = Set::add(s, i) };\\n        // assert(Set::size(s)==20); assert(Set::contains(s,0));\\n        // assert(Set::contains(s,19))` traps under RC1 -- `Set::size`/\\n        // `Set::contains` take `s` by projection only (`s.items`), which\\n        // Perceus's use-counting doesn't count as an owning use, so both\\n        // functions unconditionally drop `s` in their epilogue; the caller\\n        // must dup before every non-last such call, exactly like the\\n        // `!is_self` case already handles. Applying the same budget here\\n        // (mirroring the `!is_self` path) fixes it: at worst an extra dup on\\n        // an already-dead reference (a leak, per the trade-off above), never\\n        // a missing one.\\n        if ctx.enable_rc && is_heap_mut {\\n          let mut adbi = 0\\n          while adbi < Array::length(ctx.rc_dup_names) {\\n            if Array::get(ctx.rc_dup_names, adbi) == name {\\n              emit_rc_dup_guarded(buf, idx, ctx.rc_shadow)\\n            } else {\\n              ()\\n            }\\n            adbi = adbi + 1\\n          }\\n        } else {\\n          ()\\n        }\\n        compile_expr(buf, body, local_names, nl, ctx, ld)\\n      }\\n    }\\n  } else if __tag == 13 {\\n    let name = get_eassignop_name(expr)\\n    let op = get_eassignop_op(expr)\\n    let value = get_eassignop_val(expr)\\n    let body = get_eassignop_body(expr)\\n    let idx = resolve_local(local_names, name, \\\"assignop\\\")\\n    if array_contains_str(ctx.ref_cell_names, name) {\\n      emit_local_get(buf, idx)\\n      emit_i32_wrap_i64(buf)\\n      emit_local_get(buf, idx)\\n      emit_i32_wrap_i64(buf)\\n      emit_i64_load(buf, 3, 0)\\n      let nl = compile_expr(buf, value, local_names, next_local, ctx, ld)\\n      emit_assignop_op(buf, op)\\n      emit_assignop_rc_tag_fix(buf, ctx.enable_rc, op)\\n      emit_i64_store(buf, 3, 0)\\n      compile_expr(buf, body, local_names, nl, ctx, ld)\\n    } else {\\n      emit_local_get(buf, idx)\\n      let nl = compile_expr(buf, value, local_names, next_local, ctx, ld)\\n      emit_assignop_op(buf, op)\\n      emit_assignop_rc_tag_fix(buf, ctx.enable_rc, op)\\n      emit_local_set(buf, idx)\\n      compile_expr(buf, body, local_names, nl, ctx, ld)\\n    }\\n  } else if __tag == 14 {\\n    let first = get_eseq_first(expr)\\n    let second = get_eseq_second(expr)\\n    emit_dbg_line_for(buf, first, ctx)\\n    let nl = compile_expr(buf, first, local_names, next_local, ctx, ld)\\n    emit_drop(buf)\\n    compile_expr(buf, second, local_names, nl, ctx, ld)\\n  } else {\\n    compile_expr_tail2(buf, expr, local_names, next_local, ctx, ld, compile_expr)\\n  }\\n}\\n\")\n}\n\nlet cli_adapter_source_84 = () -> (String, String) {\n  (\"lib/@vibe/compiler/codegen/expr/compile_expr.vibe\",\n\"//# Imports\\n\\nimport ../../core {\\n  Expr, Pat, Stmt, TypeExpr, bytebuf_length, bytebuf_new, bytebuf_push, bytebuf_push_section, bytebuf_push_vec_header, bytebuf_to_bytes, leb128_encode_s64, leb128_encode_u32\\n}\\n\\nimport ../common_analysis {\\n  collect_free_vars, collect_strings_stmts, emit_closure_call_tail, emit_closure_resolve, emit_i64_extend_i32_u, is_mut_captured_in\\n}\\n\\nimport ../common_base {\\n  CompileCtx, CtorTable, FuncTable, LambdaTable, StrTable, agg_expr_of_ident, agg_info_of_ident, agg_log_reset_above2, cov_emit_branch, emit_binop_op, emit_box_float, emit_heap_grow_after_heap_set, emit_i32_eq, emit_i32_eqz, emit_i32_ge_u, emit_i32_mul, emit_i32_ne, emit_i32_sub, emit_i64_load, emit_i64_store, emit_str_ref, emit_unbox_float, expr_tag, int_log_reset_above, get_arm_body, get_arm_pat, get_ebinop_op, get_efn_body, get_eif_cond, get_eif_else, get_eif_then, get_elet_body, get_elet_name, get_elet_val, get_slet_expr, get_slet_name, is_ctor_call, is_efn, is_eident, is_erecord, is_etuple, is_nullary_ctor_ident, is_pbind, is_pbool, is_pctor, is_pint, is_pstring, is_ptuple, is_pwild, is_slet, ctor_table_index_of, resolve_func, resolve_local\\n}\\n\\nimport ../common_extractors {\\n  array_contains_str, emit_assignop_op, emit_memory_copy, find_catchall_idx, get_earray_elems, get_eassign_body, get_eassign_name, get_eassign_val, get_eassignop_body, get_eassignop_name, get_eassignop_op, get_eassignop_val, get_ebinop_lhs, get_ebinop_rhs, get_ebool_value, get_ecall_args, get_ecall_callee, get_efloat_value, get_efn_params, get_eforin_body, get_eforin_iter, get_eforin_name, get_eident_name, get_eint_value, get_eletmut_body, get_eletmut_name, get_eletmut_val, get_eletrec_body, get_eletrec_name, get_eletrec_val, get_eseq_first, get_eseq_second, get_estring_value, get_etuple_elems, get_eunaryop_expr, get_eunaryop_op, get_ewhile_body, get_ewhile_cond, get_match_arms, get_match_scrutinee, get_pbind_name, get_pbool_value, get_pctor_args, get_pctor_name, get_pint_value, get_pstring_value, get_ptuple_pats, get_slet_export, str_table_lookup\\n}\\n\\nimport ../wasm_emit {\\n  emit_block_i64, emit_block_void, emit_br, emit_br_if, emit_call, emit_call_indirect, emit_code_section, emit_code_section_with_locals, emit_data_section, emit_data_section_multi, emit_drop, emit_element_section_active, emit_else, emit_end, emit_export_section, emit_export_section_multi, emit_exports_full, emit_exports_with_memory, emit_f64_add, emit_f64_const_bits, emit_f64_const_lohi, emit_f64_convert_i64_s, emit_f64_div, emit_f64_eq, emit_f64_ge, emit_f64_gt, emit_f64_le, emit_f64_lt, emit_f64_mul, emit_f64_ne, emit_f64_neg, emit_f64_reinterpret_i64, emit_f64_sub, emit_func_type_raw, emit_function_section, emit_global_get, emit_global_section_i32_mut, emit_global_set, emit_header, emit_i32_add, emit_i32_const, emit_i32_load, emit_i32_load8_u, emit_i32_store, emit_i32_store8, emit_i32_wrap_i64, emit_i64_add, emit_i64_and, emit_i64_const, emit_i64_div_s, emit_i64_eq, emit_i64_eqz, emit_i64_extend_i32_s, emit_i64_ge_s, emit_i64_gt_s, emit_i64_le_s, emit_i64_lt_s, emit_i64_mul, emit_i64_ne, emit_i64_or, emit_i64_reinterpret_f64, emit_i64_rem_s, emit_i64_shl, emit_i64_shr_s, emit_i64_sub, emit_i64_trunc_f64_s, emit_i64_xor, emit_if_i64, emit_if_void, emit_import_section_func, emit_local_get, emit_local_set, emit_local_tee, emit_loop_void, emit_memory_section, emit_name, emit_return, emit_table_section_funcref, emit_type_section, emit_type_section_multi, string_to_data\\n}\\n\\nimport ./compile_call.vibe {\\n  compile_call\\n}\\n\\nimport ./compile_expr_tail.vibe {\\n  compile_expr_tail, expr_is_floatish, expr_is_intish\\n}\\n\\nimport ./compile_lambda.vibe {\\n  compile_lambda\\n}\\n\\nimport ./compile_match.vibe {\\n  compile_match\\n}\\n\\n//# Functions\\n\\n// #672: emit structural equality for two tuples (non-rc layout: element i at\\n// ptr+i*8, value = raw pointer). The arity comes from whichever operand is a\\n// tuple literal (the checker guarantees same-arity tuples on both sides).\\n// Evaluates each operand to a pointer in a temp local, then ANDs an element-wise\\n// generic `eq` over all elements. Produces a raw i64 0/1. `compile_expr_fn` is\\n// the main expression compiler, threaded to avoid a forward reference.\\nfn emit_tuple_struct_eq(buf: Bytes, lhs: Expr, rhs: Expr, num: Int, local_names: Array[String], next_local: Int, ctx: CompileCtx, ld: Int, compile_expr_fn: (Bytes, Expr, Array[String], Int, CompileCtx, Int) -> Int with { Error }) -> Int with { Error } {\\n  let aptr = next_local\\n  Array::push(local_names, \\\"__eqa\\\")\\n  let bptr = next_local + 1\\n  Array::push(local_names, \\\"__eqb\\\")\\n  let nl1 = compile_expr_fn(buf, lhs, local_names, next_local + 2, ctx, ld)\\n  // RC tuples are tagged (`value = (block_start+8)|1`) and carry an 8-byte\\n  // header (type_id/length) before the fields, unlike the bare `i*8`-packed\\n  // non-RC layout — untag and skip the header so field reads land on the\\n  // actual elements instead of the header words (previously read as if they\\n  // were fields 0/1, making equal-valued tuples at different addresses\\n  // compare unequal; this is also why the RC path was disabled entirely\\n  // before this fix).\\n  if ctx.enable_rc {\\n    emit_i64_const(buf, -2)\\n    emit_i64_and(buf)\\n  } else {\\n    ()\\n  }\\n  emit_local_set(buf, aptr)\\n  let nl2 = compile_expr_fn(buf, rhs, local_names, nl1, ctx, ld)\\n  if ctx.enable_rc {\\n    emit_i64_const(buf, -2)\\n    emit_i64_and(buf)\\n  } else {\\n    ()\\n  }\\n  emit_local_set(buf, bptr)\\n  let field_off = if ctx.enable_rc {\\n    8\\n  } else {\\n    0\\n  }\\n  let (eq_fidx, _, _) = resolve_func(ctx.func_table, \\\"eq\\\")\\n  emit_i64_const(buf, 1)\\n  let mut i = 0\\n  while i < num {\\n    emit_local_get(buf, aptr)\\n    emit_i32_wrap_i64(buf)\\n    emit_i64_load(buf, 3, field_off + i * 8)\\n    emit_local_get(buf, bptr)\\n    emit_i32_wrap_i64(buf)\\n    emit_i64_load(buf, 3, field_off + i * 8)\\n    emit_call(buf, eq_fidx)\\n    emit_i64_and(buf)\\n    i = i + 1\\n  }\\n  nl2\\n}\\n\\n// #672: structural equality for two enum constructor values (non-rc layout:\\n// value = ptr|1, tag i32 at ptr+0, field i at ptr+8+i*8). One operand is a ctor\\n// literal so the field count `fc` is statically known. Compares the runtime\\n// tags first (different variants => not equal, e.g. `Circle(5) != Point`), then\\n// — when tags match — ANDs an element-wise generic `eq` over the `fc` fields.\\n// Flat ctors (Int/String/Bool fields) are correct; nested-ctor fields fall back\\n// to `eq` (so recursive types stay non-structural — tracked in #672).\\nfn emit_ctor_struct_eq(buf: Bytes, lhs: Expr, rhs: Expr, fc: Int, local_names: Array[String], next_local: Int, ctx: CompileCtx, ld: Int, compile_expr_fn: (Bytes, Expr, Array[String], Int, CompileCtx, Int) -> Int with { Error }) -> Int with { Error } {\\n  let aptr = next_local\\n  Array::push(local_names, \\\"__ceqa\\\")\\n  let bptr = next_local + 1\\n  Array::push(local_names, \\\"__ceqb\\\")\\n  let nl1 = compile_expr_fn(buf, lhs, local_names, next_local + 2, ctx, ld)\\n  emit_i64_const(buf, -2)\\n  emit_i64_and(buf)\\n  emit_local_set(buf, aptr)\\n  let nl2 = compile_expr_fn(buf, rhs, local_names, nl1, ctx, ld)\\n  emit_i64_const(buf, -2)\\n  emit_i64_and(buf)\\n  emit_local_set(buf, bptr)\\n  emit_local_get(buf, aptr)\\n  emit_i32_wrap_i64(buf)\\n  emit_i32_load(buf, 2, 0)\\n  emit_local_get(buf, bptr)\\n  emit_i32_wrap_i64(buf)\\n  emit_i32_load(buf, 2, 0)\\n  emit_i32_eq(buf)\\n  emit_if_i64(buf)\\n  let (eq_fidx, _, _) = resolve_func(ctx.func_table, \\\"eq\\\")\\n  if fc == 63 {\\n    // #724 round 2: DYNAMIC field count — fc 63 marks an enum-typed value\\n    // whose variant (hence argc) is only known at runtime. Equal tags imply\\n    // equal argc, so loop over argc@4 read from the value itself.\\n    let res_l = nl2\\n    let cnt_l = nl2 + 1\\n    let ii_l = nl2 + 2\\n    Array::push(local_names, \\\"__ceq_res\\\")\\n    Array::push(local_names, \\\"__ceq_cnt\\\")\\n    Array::push(local_names, \\\"__ceq_i\\\")\\n    emit_i64_const(buf, 1)\\n    emit_local_set(buf, res_l)\\n    emit_local_get(buf, aptr)\\n    emit_i32_wrap_i64(buf)\\n    emit_i32_load(buf, 2, 4)\\n    emit_i64_extend_i32_u(buf)\\n    emit_local_set(buf, cnt_l)\\n    emit_i64_const(buf, 0)\\n    emit_local_set(buf, ii_l)\\n    emit_block_void(buf)\\n    emit_loop_void(buf)\\n    emit_local_get(buf, ii_l)\\n    emit_local_get(buf, cnt_l)\\n    emit_i64_ge_s(buf)\\n    emit_br_if(buf, 1)\\n    emit_local_get(buf, res_l)\\n    emit_local_get(buf, aptr)\\n    emit_i32_wrap_i64(buf)\\n    emit_local_get(buf, ii_l)\\n    emit_i32_wrap_i64(buf)\\n    emit_i32_const(buf, 8)\\n    emit_i32_mul(buf)\\n    emit_i32_add(buf)\\n    emit_i64_load(buf, 3, 8)\\n    emit_local_get(buf, bptr)\\n    emit_i32_wrap_i64(buf)\\n    emit_local_get(buf, ii_l)\\n    emit_i32_wrap_i64(buf)\\n    emit_i32_const(buf, 8)\\n    emit_i32_mul(buf)\\n    emit_i32_add(buf)\\n    emit_i64_load(buf, 3, 8)\\n    emit_call(buf, eq_fidx)\\n    emit_i64_and(buf)\\n    emit_local_set(buf, res_l)\\n    emit_local_get(buf, ii_l)\\n    emit_i64_const(buf, 1)\\n    emit_i64_add(buf)\\n    emit_local_set(buf, ii_l)\\n    emit_br(buf, 0)\\n    emit_end(buf)\\n    emit_end(buf)\\n    emit_local_get(buf, res_l)\\n    emit_else(buf)\\n    emit_i64_const(buf, 0)\\n    emit_end(buf)\\n    nl2 + 3\\n  } else {\\n    emit_i64_const(buf, 1)\\n    let mut i = 0\\n    while i < fc {\\n      emit_local_get(buf, aptr)\\n      emit_i32_wrap_i64(buf)\\n      emit_i64_load(buf, 3, 8 + i * 8)\\n      emit_local_get(buf, bptr)\\n      emit_i32_wrap_i64(buf)\\n      emit_i64_load(buf, 3, 8 + i * 8)\\n      emit_call(buf, eq_fidx)\\n      emit_i64_and(buf)\\n      i = i + 1\\n    }\\n    emit_else(buf)\\n    emit_i64_const(buf, 0)\\n    emit_end(buf)\\n    nl2\\n  }\\n}\\n\\n// #672 (post-#724): true when `e` is a shape AST node the recursive\\n// structural comparator below can walk directly — a tuple literal, a\\n// payload-ctor call, a nullary-ctor ident, or a record literal (records and\\n// ctors share the runtime [tag@0][argc@4][fields@8+] layout since #722).\\nfn is_agg_shape(e: Expr, ct: CtorTable) -> Bool {\\n  is_etuple(e) || is_ctor_call(e, ct) || is_nullary_ctor_ident(e, ct) || is_erecord(e)\\n}\\n\\n// #672 (post-#724): the shape literal for a FIELD sub-expression `el` inside\\n// an enclosing tuple/ctor/record shape, resolving one level further than\\n// is_agg_shape alone — `el` may itself be a tracked-variable ident (e.g. the\\n// `a` in `(a, 3)` where `let a = (1, 2)` earlier) rather than a literal\\n// written inline. Returns `el` itself when it is already a literal shape, the\\n// ident's tracked agg_local_exprs shape when it resolves to one, or EInt(0)\\n// (not an aggregate shape — a plain leaf, gated by is_agg_shape at the call\\n// site) otherwise. This is what lets `(a, 3) == (b, 3)` recurse into `a`/`b`'s\\n// OWN tracked nested shape instead of only comparing the outer pair.\\nfn resolved_element_shape(el: Expr, ctx: CompileCtx, local_names: Array[String]) -> Expr {\\n  if is_agg_shape(el, ctx.ctor_table) {\\n    el\\n  } else if is_eident(el) {\\n    let s = agg_expr_of_ident(ctx.agg_local_slots, ctx.agg_local_exprs, el, local_names)\\n    if is_agg_shape(s, ctx.ctor_table) {\\n      s\\n    } else {\\n      EInt(0)\\n    }\\n  } else {\\n    EInt(0)\\n  }\\n}\\n\\n// #672 (post-#724): the field VALUE expressions of a ctor/record shape, in\\n// runtime field order — `Array::length` of the result is the field count.\\n// Mirrors the `S::{ .. }` ECall-sugar unwrap the existing (flat, #724)\\n// cfc computation used, so a defensively-parsed record-sugar ctor call\\n// (single ERecord arg) reports its RECORD's field count/exprs, not the\\n// call's own 1-arg arity.\\nfn ctor_shape_field_exprs(shape: Expr, ct: CtorTable) -> Array[Expr] {\\n  if is_ctor_call(shape, ct) {\\n    let cargs = get_ecall_args(shape)\\n    if Array::length(cargs) == 1 {\\n      match Array::get(cargs, 0) {\\n        ERecord(_, rfields, _) => {\\n          let out = Array::slice([\\n            EInt(0)\\n          ], 0, 0)\\n          let mut i = 0\\n          while i < Array::length(rfields) {\\n            let (_, fv) = Array::get(rfields, i)\\n            Array::push(out, fv)\\n            i = i + 1\\n          }\\n          out\\n        },\\n        _ => cargs\\n      }\\n    } else {\\n      cargs\\n    }\\n  } else {\\n    match shape {\\n      ERecord(_, rfields, _) => {\\n        let out = Array::slice([\\n          EInt(0)\\n        ], 0, 0)\\n        let mut i = 0\\n        while i < Array::length(rfields) {\\n          let (_, fv) = Array::get(rfields, i)\\n          Array::push(out, fv)\\n          i = i + 1\\n        }\\n        out\\n      },\\n      _ => Array::slice([\\n        EInt(0)\\n      ], 0, 0)\\n    }\\n  }\\n}\\n\\n// #672 (post-#724): RECURSIVE structural equality driven by a shape AST node\\n// (a tuple / ctor / record literal — see is_agg_shape). The two values under\\n// comparison are already evaluated into local slots `asl`/`bsl` (raw i64:\\n// pointer for aggregates, scalar otherwise — the same representation\\n// compile_expr leaves on the stack, whether freshly evaluated or loaded back\\n// out of a parent aggregate's field). Leaves a single i64 0/1 on the stack.\\n//\\n// For each field: when the shape says the field is ITSELF an aggregate\\n// (nested tuple/ctor/record), the field's raw i64 is loaded into fresh locals\\n// and this function RECURSES on that field's own shape sub-expression —\\n// fixing the residual #672 gap (nested aggregates compared elementwise via\\n// the type-blind generic `eq`, which pointer-compares two structurally-equal\\n// but distinctly-allocated nested aggregates as unequal). A field whose shape\\n// is not statically an aggregate (scalar, or an opaque call-result / bound\\n// name we cannot see the literal shape of) keeps the old generic-`eq` leaf\\n// comparison — same residual as before, just one level shallower.\\nfn emit_eq_shape_slots(buf: Bytes, shape: Expr, asl: Int, bsl: Int, local_names: Array[String], nl0: Int, ctx: CompileCtx, ld: Int, ce: (Bytes, Expr, Array[String], Int, CompileCtx, Int) -> Int with { Error }) -> Int with { Error } {\\n  let (eq_fidx, _, _) = resolve_func(ctx.func_table, \\\"eq\\\")\\n  if is_etuple(shape) {\\n    let elems = get_etuple_elems(shape)\\n    let num = Array::length(elems)\\n    let ap = nl0\\n    Array::push(local_names, \\\"__seqta\\\")\\n    let bp = nl0 + 1\\n    Array::push(local_names, \\\"__seqtb\\\")\\n    emit_local_get(buf, asl)\\n    if ctx.enable_rc {\\n      emit_i64_const(buf, -2)\\n      emit_i64_and(buf)\\n    } else {\\n      ()\\n    }\\n    emit_local_set(buf, ap)\\n    emit_local_get(buf, bsl)\\n    if ctx.enable_rc {\\n      emit_i64_const(buf, -2)\\n      emit_i64_and(buf)\\n    } else {\\n      ()\\n    }\\n    emit_local_set(buf, bp)\\n    let field_off = if ctx.enable_rc {\\n      8\\n    } else {\\n      0\\n    }\\n    emit_i64_const(buf, 1)\\n    let mut nl = nl0 + 2\\n    let mut i = 0\\n    while i < num {\\n      let el = Array::get(elems, i)\\n      let el_shape = resolved_element_shape(el, ctx, local_names)\\n      if is_agg_shape(el_shape, ctx.ctor_table) {\\n        let na = nl\\n        Array::push(local_names, \\\"__seqea\\\")\\n        let nb = nl + 1\\n        Array::push(local_names, \\\"__seqeb\\\")\\n        emit_local_get(buf, ap)\\n        emit_i32_wrap_i64(buf)\\n        emit_i64_load(buf, 3, field_off + i * 8)\\n        emit_local_set(buf, na)\\n        emit_local_get(buf, bp)\\n        emit_i32_wrap_i64(buf)\\n        emit_i64_load(buf, 3, field_off + i * 8)\\n        emit_local_set(buf, nb)\\n        nl = emit_eq_shape_slots(buf, el_shape, na, nb, local_names, nl + 2, ctx, ld, ce)\\n        emit_i64_and(buf)\\n      } else {\\n        emit_local_get(buf, ap)\\n        emit_i32_wrap_i64(buf)\\n        emit_i64_load(buf, 3, field_off + i * 8)\\n        emit_local_get(buf, bp)\\n        emit_i32_wrap_i64(buf)\\n        emit_i64_load(buf, 3, field_off + i * 8)\\n        emit_call(buf, eq_fidx)\\n        emit_i64_and(buf)\\n      }\\n      i = i + 1\\n    }\\n    nl\\n  } else if is_ctor_call(shape, ctx.ctor_table) || is_nullary_ctor_ident(shape, ctx.ctor_table) || is_erecord(shape) {\\n    let field_exprs = ctor_shape_field_exprs(shape, ctx.ctor_table)\\n    let fc = Array::length(field_exprs)\\n    let ap = nl0\\n    Array::push(local_names, \\\"__seqca\\\")\\n    let bp = nl0 + 1\\n    Array::push(local_names, \\\"__seqcb\\\")\\n    emit_local_get(buf, asl)\\n    emit_i64_const(buf, -2)\\n    emit_i64_and(buf)\\n    emit_local_set(buf, ap)\\n    emit_local_get(buf, bsl)\\n    emit_i64_const(buf, -2)\\n    emit_i64_and(buf)\\n    emit_local_set(buf, bp)\\n    emit_local_get(buf, ap)\\n    emit_i32_wrap_i64(buf)\\n    emit_i32_load(buf, 2, 0)\\n    emit_local_get(buf, bp)\\n    emit_i32_wrap_i64(buf)\\n    emit_i32_load(buf, 2, 0)\\n    emit_i32_eq(buf)\\n    emit_if_i64(buf)\\n    emit_i64_const(buf, 1)\\n    let mut nl = nl0 + 2\\n    let mut i = 0\\n    while i < fc {\\n      let el = Array::get(field_exprs, i)\\n      let el_shape = resolved_element_shape(el, ctx, local_names)\\n      if is_agg_shape(el_shape, ctx.ctor_table) {\\n        let na = nl\\n        Array::push(local_names, \\\"__seqfa\\\")\\n        let nb = nl + 1\\n        Array::push(local_names, \\\"__seqfb\\\")\\n        emit_local_get(buf, ap)\\n        emit_i32_wrap_i64(buf)\\n        emit_i64_load(buf, 3, 8 + i * 8)\\n        emit_local_set(buf, na)\\n        emit_local_get(buf, bp)\\n        emit_i32_wrap_i64(buf)\\n        emit_i64_load(buf, 3, 8 + i * 8)\\n        emit_local_set(buf, nb)\\n        nl = emit_eq_shape_slots(buf, el_shape, na, nb, local_names, nl + 2, ctx, ld, ce)\\n        emit_i64_and(buf)\\n      } else {\\n        emit_local_get(buf, ap)\\n        emit_i32_wrap_i64(buf)\\n        emit_i64_load(buf, 3, 8 + i * 8)\\n        emit_local_get(buf, bp)\\n        emit_i32_wrap_i64(buf)\\n        emit_i64_load(buf, 3, 8 + i * 8)\\n        emit_call(buf, eq_fidx)\\n        emit_i64_and(buf)\\n      }\\n      i = i + 1\\n    }\\n    emit_else(buf)\\n    emit_i64_const(buf, 0)\\n    emit_end(buf)\\n    nl\\n  } else {\\n    // Not a statically-known aggregate shape (scalar leaf, or an opaque\\n    // sub-value whose shape this pass cannot see) — the pre-#672-nested\\n    // generic-eq comparison, unchanged.\\n    emit_local_get(buf, asl)\\n    emit_local_get(buf, bsl)\\n    emit_call(buf, eq_fidx)\\n    nl0\\n  }\\n}\\n\\n// #672 (post-#724): top-level wrapper — evaluate `lhs`/`rhs` (via `ce`, the\\n// main expression compiler) into fresh raw-value locals, then drive the\\n// RECURSIVE structural walk from `shape` (a tuple/ctor/record literal AST —\\n// either operand's literal, or a tracked variable's recorded shape literal,\\n// see CompileCtx.agg_local_exprs). Supersedes the flat emit_tuple_struct_eq /\\n// emit_ctor_struct_eq for every case where an actual shape LITERAL is known\\n// (nested elements now recurse instead of falling back to generic `eq`);\\n// callers fall back to the old flat comparators when only a shallow kind+n\\n// is known (no literal in scope — e.g. a round-2 declared-return-type or\\n// dynamic-argc tracked binding), which is unchanged from before this change.\\nfn emit_eq_shape_top(buf: Bytes, shape: Expr, lhs: Expr, rhs: Expr, local_names: Array[String], next_local: Int, ctx: CompileCtx, ld: Int, ce: (Bytes, Expr, Array[String], Int, CompileCtx, Int) -> Int with { Error }) -> Int with { Error } {\\n  let aptr = next_local\\n  Array::push(local_names, \\\"__seqa\\\")\\n  let bptr = next_local + 1\\n  Array::push(local_names, \\\"__seqb\\\")\\n  let nl1 = ce(buf, lhs, local_names, next_local + 2, ctx, ld)\\n  emit_local_set(buf, aptr)\\n  let nl2 = ce(buf, rhs, local_names, nl1, ctx, ld)\\n  emit_local_set(buf, bptr)\\n  emit_eq_shape_slots(buf, shape, aptr, bptr, local_names, nl2, ctx, ld, ce)\\n}\\n\\n// #672: emit the equality test for `lhs == rhs`, leaving a raw i64 0/1 on the\\n// stack (1 = equal). Routes through the structural comparators when an operand\\n// is a tuple / ctor literal (non-rc), else the generic runtime `eq`. Every `==`\\n// / `!=` codegen site — the general expression form AND the if / `!`-if / while\\n// condition fast-paths — calls this, so structural equality is consistent\\n// across all of them (the post-processing each site applies to the 0/1 result —\\n// `i32_wrap`/`i32_eqz`/rc-shift — is unchanged).\\nfn emit_eq_value(buf: Bytes, lhs: Expr, rhs: Expr, local_names: Array[String], next_local: Int, ctx: CompileCtx, ld: Int, ce: (Bytes, Expr, Array[String], Int, CompileCtx, Int) -> Int with { Error }) -> Int with { Error } {\\n  // #724: aggregate shape of a bare-ident operand whose `let` value was a\\n  // tuple/ctor/record literal (kind*64+n, or -1) — extends the structural\\n  // comparators below to both-sides-bound comparisons.\\n  let lhs_agg = agg_info_of_ident(ctx.agg_local_slots, lhs, local_names)\\n  let rhs_agg = agg_info_of_ident(ctx.agg_local_slots, rhs, local_names)\\n  if is_etuple(lhs) || is_etuple(rhs) {\\n    // #672: a tuple LITERAL operand always carries its own shape — always\\n    // safe (and correct for nesting) to drive the recursive comparator.\\n    let lit = if is_etuple(lhs) {\\n      lhs\\n    } else {\\n      rhs\\n    }\\n    emit_eq_shape_top(buf, lit, lhs, rhs, local_names, next_local, ctx, ld, ce)\\n  } else if lhs_agg / 64 == 1 || rhs_agg / 64 == 1 {\\n    // Tracked tuple binding on at least one side; the checker guarantees the\\n    // other side is the same tuple type, so its arity matches. #672: when the\\n    // tracked slot's recorded shape is an actual tuple LITERAL (agg_local_exprs\\n    // — a direct `let a = (..)` or an alias of one), recurse through it so\\n    // nested elements compare structurally too; otherwise (no literal in\\n    // scope, e.g. a round-2 declared-return-type tuple) fall back to the flat,\\n    // depth-1 comparator exactly as before this change.\\n    let tshape = if lhs_agg / 64 == 1 {\\n      agg_expr_of_ident(ctx.agg_local_slots, ctx.agg_local_exprs, lhs, local_names)\\n    } else {\\n      agg_expr_of_ident(ctx.agg_local_slots, ctx.agg_local_exprs, rhs, local_names)\\n    }\\n    if is_etuple(tshape) {\\n      emit_eq_shape_top(buf, tshape, lhs, rhs, local_names, next_local, ctx, ld, ce)\\n    } else {\\n      let tn = if lhs_agg / 64 == 1 {\\n        lhs_agg % 64\\n      } else {\\n        rhs_agg % 64\\n      }\\n      emit_tuple_struct_eq(buf, lhs, rhs, tn, local_names, next_local, ctx, ld, ce)\\n    }\\n  } else if is_ctor_call(lhs, ctx.ctor_table) || is_nullary_ctor_ident(lhs, ctx.ctor_table) || is_ctor_call(rhs, ctx.ctor_table) || is_nullary_ctor_ident(rhs, ctx.ctor_table) {\\n    // #672: a payload/nullary ctor LITERAL operand always carries its own\\n    // shape — always safe to drive the recursive comparator.\\n    let clit = if is_ctor_call(lhs, ctx.ctor_table) || is_nullary_ctor_ident(lhs, ctx.ctor_table) {\\n      lhs\\n    } else {\\n      rhs\\n    }\\n    emit_eq_shape_top(buf, clit, lhs, rhs, local_names, next_local, ctx, ld, ce)\\n  } else if lhs_agg / 64 == 2 || rhs_agg / 64 == 2 {\\n    // Tracked ctor/record binding: values carry [tag@0][argc@4][fields@8+],\\n    // so the tag-comparing structural walk applies. #672: recurse through the\\n    // tracked slot's recorded shape LITERAL when one is on file (a direct\\n    // `let`/alias of a ctor/record literal); otherwise (round-2\\n    // declared-type or dynamic-argc tracking, no literal in scope) fall back\\n    // to the flat, depth-1 comparator exactly as before this change — when\\n    // BOTH sides are tracked as DIFFERENT variants the field counts can\\n    // differ, so that fallback walks the larger count (the tag comparison\\n    // short-circuits unequal variants before any field read).\\n    let cshape = if lhs_agg / 64 == 2 {\\n      agg_expr_of_ident(ctx.agg_local_slots, ctx.agg_local_exprs, lhs, local_names)\\n    } else {\\n      agg_expr_of_ident(ctx.agg_local_slots, ctx.agg_local_exprs, rhs, local_names)\\n    }\\n    if is_agg_shape(cshape, ctx.ctor_table) {\\n      emit_eq_shape_top(buf, cshape, lhs, rhs, local_names, next_local, ctx, ld, ce)\\n    } else {\\n      let lfc = if lhs_agg / 64 == 2 {\\n        lhs_agg % 64\\n      } else {\\n        0\\n      }\\n      let rfc = if rhs_agg / 64 == 2 {\\n        rhs_agg % 64\\n      } else {\\n        0\\n      }\\n      let cfc = if lfc > rfc {\\n        lfc\\n      } else {\\n        rfc\\n      }\\n      emit_ctor_struct_eq(buf, lhs, rhs, cfc, local_names, next_local, ctx, ld, ce)\\n    }\\n  } else if expr_is_intish(lhs, local_names, ctx) || expr_is_intish(rhs, local_names, ctx) {\\n    // A definitely-integer comparison: a direct i64.eq is both faster and\\n    // CORRECT for the full value range, sidestepping the `eq` builtin's\\n    // string-pointer fall-back. The type checker guarantees the other operand\\n    // is the same scalar type, so one intish side is enough.\\n    let nl1 = ce(buf, lhs, local_names, next_local, ctx, ld)\\n    let nl2 = ce(buf, rhs, local_names, nl1, ctx, ld)\\n    emit_i64_eq(buf)\\n    emit_i64_extend_i32_s(buf)\\n    nl2\\n  } else {\\n    let nl1 = ce(buf, lhs, local_names, next_local, ctx, ld)\\n    let nl2 = ce(buf, rhs, local_names, nl1, ctx, ld)\\n    let (eq_fidx, _, _) = resolve_func(ctx.func_table, \\\"eq\\\")\\n    emit_call(buf, eq_fidx)\\n    nl2\\n  }\\n}\\n\\nexport fn compile_expr(buf: Bytes, expr: Expr, local_names: Array[String], next_local: Int, ctx: CompileCtx, ld: Int) -> Int with { Error } {\\n  let __tag = expr_tag(expr)\\n  if __tag == 0 {\\n    let n = get_eint_value(expr)\\n    emit_i64_const(buf, n)\\n    if ctx.enable_rc {\\n      emit_i64_const(buf, 1)\\n      emit_i64_shl(buf)\\n    }\\n    next_local\\n  } else if __tag == 1 {\\n    let b_val = get_ebool_value(expr)\\n    emit_i64_const(buf, if b_val {\\n      if ctx.enable_rc {\\n        2\\n      } else {\\n        1\\n      }\\n    } else {\\n      0\\n    })\\n    next_local\\n  } else if __tag == 2 {\\n    let v = get_efloat_value(expr)\\n    let lo = Double::to_i64_bits_lo(v)\\n    let hi = Double::to_i64_bits_hi(v)\\n    emit_f64_const_lohi(buf, lo, hi)\\n    emit_i64_reinterpret_f64(buf)\\n    if ctx.enable_rc {\\n      Array::push(local_names, \\\"__fbits\\\")\\n      Array::push(local_names, \\\"__fbox\\\")\\n      emit_box_float(buf, ctx, next_local, next_local + 1)\\n      next_local + 2\\n    } else {\\n      next_local\\n    }\\n  } else if __tag == 3 {\\n    let s = get_estring_value(expr)\\n    let idx = str_table_lookup(ctx.str_table.strs, s)\\n    emit_str_ref(buf, Array::get(ctx.str_table.offsets, idx), Array::get(ctx.str_table.lengths, idx))\\n    next_local\\n  } else if __tag == 4 {\\n    let name = get_eident_name(expr)\\n    let len = Array::length(local_names)\\n    let mut __tl_i = len - 1\\n    let mut __tl_result = -1\\n    while __tl_i >= 0 {\\n      if Array::get(local_names, __tl_i) == name {\\n        __tl_result = __tl_i\\n        __tl_i = -1\\n      } else {\\n        __tl_i = __tl_i - 1\\n      }\\n    }\\n    let local_idx = __tl_result\\n    if local_idx >= 0 {\\n      if array_contains_str(ctx.ref_cell_names, name) {\\n        emit_local_get(buf, local_idx)\\n        emit_i32_wrap_i64(buf)\\n        emit_i64_load(buf, 3, 0)\\n      } else {\\n        emit_local_get(buf, local_idx)\\n      }\\n      next_local\\n    } else {\\n      let mut __ci_idx = -1\\n      let __ci_len = Array::length(ctx.const_int_names)\\n      let mut __ci_j = 0\\n      while __ci_j < __ci_len {\\n        if Array::get(ctx.const_int_names, __ci_j) == name {\\n          __ci_idx = __ci_j\\n          __ci_j = __ci_len\\n        } else {\\n          __ci_j = __ci_j + 1\\n        }\\n      }\\n      if __ci_idx >= 0 {\\n        emit_i64_const(buf, Array::get(ctx.const_int_values, __ci_idx))\\n        if ctx.enable_rc {\\n          emit_i64_const(buf, 1)\\n          emit_i64_shl(buf)\\n        }\\n        next_local\\n      } else {\\n        let ctor_idx = ctor_table_index_of(ctx.ctor_table, name)\\n        if ctor_idx >= 0 {\\n          let tag_c = Array::get(ctx.ctor_table.tags, ctor_idx)\\n          let ptr_l = next_local\\n          Array::push(local_names, \\\"__ctor_ptr\\\")\\n          if ctx.enable_rc {\\n            emit_i64_const(buf, 16)\\n            emit_call(buf, ctx.rc_alloc_func_idx)\\n            emit_local_set(buf, ptr_l)\\n            emit_local_get(buf, ptr_l)\\n            emit_i32_wrap_i64(buf)\\n            emit_i32_const(buf, 16)\\n            emit_i32_store(buf, 2, 0)\\n            emit_local_get(buf, ptr_l)\\n            emit_i32_wrap_i64(buf)\\n            emit_i32_const(buf, 1)\\n            emit_i32_store(buf, 2, 4)\\n            emit_local_get(buf, ptr_l)\\n            emit_i32_wrap_i64(buf)\\n            emit_i32_const(buf, 1)\\n            emit_i32_store8(buf, 0, 7)\\n            emit_local_get(buf, ptr_l)\\n            emit_i32_wrap_i64(buf)\\n            emit_i32_const(buf, tag_c)\\n            emit_i32_store(buf, 2, 8)\\n            emit_local_get(buf, ptr_l)\\n            emit_i32_wrap_i64(buf)\\n            emit_i32_const(buf, 0)\\n            emit_i32_store(buf, 2, 12)\\n            emit_local_get(buf, ptr_l)\\n            emit_i64_const(buf, 8)\\n            emit_i64_add(buf)\\n            emit_i64_const(buf, 1)\\n            emit_i64_or(buf)\\n            next_local + 1\\n          } else {\\n            emit_global_get(buf, 0)\\n            emit_i64_extend_i32_u(buf)\\n            emit_local_set(buf, ptr_l)\\n            emit_global_get(buf, 0)\\n            emit_i32_const(buf, 8)\\n            emit_i32_add(buf)\\n            emit_global_set(buf, 0)\\n            emit_heap_grow_after_heap_set(buf, ctx)\\n            emit_local_get(buf, ptr_l)\\n            emit_i32_wrap_i64(buf)\\n            emit_i32_const(buf, tag_c)\\n            emit_i32_store(buf, 2, 0)\\n            emit_local_get(buf, ptr_l)\\n            emit_i32_wrap_i64(buf)\\n            emit_i32_const(buf, 0)\\n            emit_i32_store(buf, 2, 4)\\n            emit_local_get(buf, ptr_l)\\n            emit_i64_const(buf, 1)\\n            emit_i64_or(buf)\\n            next_local + 1\\n          }\\n        } else {\\n          let fn_len = Array::length(ctx.func_table.names)\\n          let mut __tf_j = 0\\n          let mut __tf_result = -1\\n          while __tf_j < fn_len {\\n            if Array::get(ctx.func_table.names, __tf_j) == name {\\n              __tf_result = __tf_j\\n              __tf_j = fn_len\\n            } else {\\n              __tf_j = __tf_j + 1\\n            }\\n          }\\n          if __tf_result < 0 {\\n            let mut diag = String::concat(\\\"undefined variable (ident): \\\", name)\\n            diag = String::concat(diag, \\\" | locals=[\\\")\\n            let mut di = 0\\n            while di < len {\\n              if di > 0 {\\n                diag = String::concat(diag, \\\",\\\")\\n              }\\n              diag = String::concat(diag, Array::get(local_names, di))\\n              di = di + 1\\n            }\\n            diag = String::concat(diag, \\\"]\\\")\\n            throw(diag)\\n          }\\n          let fni = __tf_result\\n          let fidx = Array::get(ctx.func_table.indices, fni)\\n          if array_contains_str(ctx.thunk_names, name) {\\n            emit_i64_const(buf, 0)\\n            emit_call(buf, fidx)\\n            next_local\\n          } else {\\n            let table_slot = fidx - ctx.func_offset\\n            emit_i64_const(buf, (table_slot<<2)|2)\\n            next_local\\n          }\\n        }\\n      }\\n    }\\n  } else if __tag == 5 {\\n    let op = get_ebinop_op(expr)\\n    let lhs = get_ebinop_lhs(expr)\\n    let rhs = get_ebinop_rhs(expr)\\n    if op == \\\"&&\\\" || op == \\\"||\\\" {\\n      // Short-circuit lowering. The old eager `i64.and`/`i64.or` (still what\\n      // emit_binop_op does) evaluated BOTH operands, so `false && inc()` ran\\n      // inc()'s side effects. Bool reprs: false = 0 in both lanes, true = 2\\n      // (tagged) under RC / 1 otherwise; eqz treats any non-zero as true.\\n      let nl1 = compile_expr(buf, lhs, local_names, next_local, ctx, ld)\\n      emit_i64_eqz(buf)\\n      if op == \\\"&&\\\" {\\n        emit_if_i64(buf)\\n        emit_i64_const(buf, 0)\\n        emit_else(buf)\\n        let nl2 = compile_expr(buf, rhs, local_names, nl1, ctx, ld)\\n        emit_end(buf)\\n        nl2\\n      } else {\\n        emit_if_i64(buf)\\n        let nl2 = compile_expr(buf, rhs, local_names, nl1, ctx, ld)\\n        emit_else(buf)\\n        emit_i64_const(buf, if ctx.enable_rc {\\n          2\\n        } else {\\n          1\\n        })\\n        emit_end(buf)\\n        nl2\\n      }\\n    } else if op == \\\"==\\\" && !(ctx.enable_rc && (expr_is_floatish(lhs, local_names, ctx) || expr_is_floatish(rhs, local_names, ctx))) {\\n      // #704: float `==`/`!=` under RC must NOT go through emit_eq_value — under\\n      // RC a float is a BOXED heap value, so the generic eq compares box\\n      // pointers (always unequal for two distinct boxes), making `0.0 == 0.0`\\n      // false. Divert floatish RC `==`/`!=` to the float branch below, which\\n      // unboxes and compares values with f64_eq/f64_ne. (Non-RC keeps the raw\\n      // i64-bits compare here, so the default path is byte-identical.)\\n      let nle = emit_eq_value(buf, lhs, rhs, local_names, next_local, ctx, ld, compile_expr)\\n      if ctx.enable_rc {\\n        emit_i64_const(buf, 1)\\n        emit_i64_shl(buf)\\n      }\\n      nle\\n    } else if op == \\\"!=\\\" && !(ctx.enable_rc && (expr_is_floatish(lhs, local_names, ctx) || expr_is_floatish(rhs, local_names, ctx))) {\\n      let nle = emit_eq_value(buf, lhs, rhs, local_names, next_local, ctx, ld, compile_expr)\\n      emit_i64_eqz(buf)\\n      emit_i64_extend_i32_s(buf)\\n      if ctx.enable_rc {\\n        emit_i64_const(buf, 1)\\n        emit_i64_shl(buf)\\n      }\\n      nle\\n    } else if expr_is_floatish(lhs, local_names, ctx) || expr_is_floatish(rhs, local_names, ctx) {\\n      let nl1 = compile_expr(buf, lhs, local_names, next_local, ctx, ld)\\n      if ctx.enable_rc {\\n        emit_unbox_float(buf)\\n      }\\n      emit_f64_reinterpret_i64(buf)\\n      let nl2 = compile_expr(buf, rhs, local_names, nl1, ctx, ld)\\n      if ctx.enable_rc {\\n        emit_unbox_float(buf)\\n      }\\n      emit_f64_reinterpret_i64(buf)\\n      if op == \\\"+\\\" || op == \\\"-\\\" || op == \\\"*\\\" || op == \\\"/\\\" {\\n        if op == \\\"+\\\" {\\n          emit_f64_add(buf)\\n        } else if op == \\\"-\\\" {\\n          emit_f64_sub(buf)\\n        } else if op == \\\"*\\\" {\\n          emit_f64_mul(buf)\\n        } else {\\n          emit_f64_div(buf)\\n        }\\n        emit_i64_reinterpret_f64(buf)\\n        if ctx.enable_rc {\\n          Array::push(local_names, \\\"__fbits\\\")\\n          Array::push(local_names, \\\"__fbox\\\")\\n          emit_box_float(buf, ctx, nl2, nl2 + 1)\\n          nl2 + 2\\n        } else {\\n          nl2\\n        }\\n      } else {\\n        if op == \\\"==\\\" {\\n          emit_f64_eq(buf)\\n        } else if op == \\\"!=\\\" {\\n          emit_f64_ne(buf)\\n        } else if op == \\\"<\\\" {\\n          emit_f64_lt(buf)\\n        } else if op == \\\">\\\" {\\n          emit_f64_gt(buf)\\n        } else if op == \\\"<=\\\" {\\n          emit_f64_le(buf)\\n        } else if op == \\\">=\\\" {\\n          emit_f64_ge(buf)\\n        } else {\\n          throw(String::concat(\\\"unsupported float binop: \\\", op))\\n        }\\n        emit_i64_extend_i32_s(buf)\\n        if ctx.enable_rc {\\n          emit_i64_const(buf, 1)\\n          emit_i64_shl(buf)\\n        }\\n        nl2\\n      }\\n    } else if ctx.enable_rc {\\n      if op == \\\"<<\\\" {\\n        let nl1 = compile_expr(buf, lhs, local_names, next_local, ctx, ld)\\n        let nl2 = compile_expr(buf, rhs, local_names, nl1, ctx, ld)\\n        emit_i64_const(buf, 1)\\n        emit_i64_shr_s(buf)\\n        emit_i64_shl(buf)\\n        nl2\\n      } else if op == \\\">>\\\" {\\n        let nl1 = compile_expr(buf, lhs, local_names, next_local, ctx, ld)\\n        emit_i64_const(buf, 1)\\n        emit_i64_shr_s(buf)\\n        let nl2 = compile_expr(buf, rhs, local_names, nl1, ctx, ld)\\n        emit_i64_const(buf, 1)\\n        emit_i64_shr_s(buf)\\n        emit_i64_shr_s(buf)\\n        emit_i64_const(buf, 1)\\n        emit_i64_shl(buf)\\n        nl2\\n      } else {\\n        let nl1 = compile_expr(buf, lhs, local_names, next_local, ctx, ld)\\n        let nl2 = compile_expr(buf, rhs, local_names, nl1, ctx, ld)\\n        emit_binop_op(buf, op)\\n        if op == \\\"*\\\" {\\n          emit_i64_const(buf, 1)\\n          emit_i64_shr_s(buf)\\n        } else if op == \\\"/\\\" {\\n          emit_i64_const(buf, 1)\\n          emit_i64_shl(buf)\\n        } else if op == \\\"<\\\" || op == \\\">\\\" || op == \\\"<=\\\" || op == \\\">=\\\" {\\n          emit_i64_const(buf, 1)\\n          emit_i64_shl(buf)\\n        } else {\\n          ()\\n        }\\n        nl2\\n      }\\n    } else {\\n      let nl1 = compile_expr(buf, lhs, local_names, next_local, ctx, ld)\\n      let nl2 = compile_expr(buf, rhs, local_names, nl1, ctx, ld)\\n      emit_binop_op(buf, op)\\n      nl2\\n    }\\n  } else if __tag == 6 {\\n    let op = get_eunaryop_op(expr)\\n    let operand = get_eunaryop_expr(expr)\\n    if op == \\\"-\\\" {\\n      if expr_is_floatish(operand, local_names, ctx) {\\n        let nl = compile_expr(buf, operand, local_names, next_local, ctx, ld)\\n        // #745: under RC the operand is a BOXED float — unbox before the\\n        // f64.neg and rebox the result, exactly like the float binop path.\\n        // Without this, `-1.0` negated the box POINTER and the \\\"float\\\" that\\n        // escaped was garbage bits.\\n        if ctx.enable_rc {\\n          emit_unbox_float(buf)\\n        }\\n        emit_f64_reinterpret_i64(buf)\\n        emit_f64_neg(buf)\\n        emit_i64_reinterpret_f64(buf)\\n        if ctx.enable_rc {\\n          Array::push(local_names, \\\"__fbits\\\")\\n          Array::push(local_names, \\\"__fbox\\\")\\n          emit_box_float(buf, ctx, nl, nl + 1)\\n          nl + 2\\n        } else {\\n          nl\\n        }\\n      } else {\\n        emit_i64_const(buf, 0)\\n        let nl = compile_expr(buf, operand, local_names, next_local, ctx, ld)\\n        emit_i64_sub(buf)\\n        nl\\n      }\\n    } else if op == \\\"!\\\" {\\n      let nl = compile_expr(buf, operand, local_names, next_local, ctx, ld)\\n      emit_i64_eqz(buf)\\n      emit_i64_extend_i32_s(buf)\\n      if ctx.enable_rc {\\n        emit_i64_const(buf, 1)\\n        emit_i64_shl(buf)\\n      }\\n      nl\\n    } else {\\n      throw(String::concat(\\\"unsupported unary op: \\\", op))\\n    }\\n  } else if __tag == 7 {\\n    let cond = get_eif_cond(expr)\\n    let then_e = get_eif_then(expr)\\n    let else_e = get_eif_else(expr)\\n    let cond_tag = expr_tag(cond)\\n    let nl1 = if cond_tag == 5 {\\n      let cop = get_ebinop_op(cond)\\n      if cop == \\\"==\\\" || cop == \\\"!=\\\" || cop == \\\"<\\\" || cop == \\\">\\\" || cop == \\\"<=\\\" || cop == \\\">=\\\" {\\n        let clhs = get_ebinop_lhs(cond)\\n        let crhs = get_ebinop_rhs(cond)\\n        if cop == \\\"==\\\" && !(ctx.enable_rc && (expr_is_floatish(clhs, local_names, ctx) || expr_is_floatish(crhs, local_names, ctx))) {\\n          let cnl2 = emit_eq_value(buf, clhs, crhs, local_names, next_local, ctx, ld, compile_expr)\\n          emit_i32_wrap_i64(buf)\\n          cnl2\\n        } else if cop == \\\"!=\\\" && !(ctx.enable_rc && (expr_is_floatish(clhs, local_names, ctx) || expr_is_floatish(crhs, local_names, ctx))) {\\n          let cnl2 = emit_eq_value(buf, clhs, crhs, local_names, next_local, ctx, ld, compile_expr)\\n          emit_i32_wrap_i64(buf)\\n          emit_i32_eqz(buf)\\n          cnl2\\n        } else if expr_is_floatish(clhs, local_names, ctx) || expr_is_floatish(crhs, local_names, ctx) {\\n          // #704: unbox boxed floats under RC before reinterpreting as f64, and\\n          // handle ==/!= here (f64_eq/f64_ne) so float equality in an if/while\\n          // condition compares values, not box pointers.\\n          let cnl1 = compile_expr(buf, clhs, local_names, next_local, ctx, ld)\\n          if ctx.enable_rc {\\n            emit_unbox_float(buf)\\n          } else {\\n            ()\\n          }\\n          emit_f64_reinterpret_i64(buf)\\n          let cnl2 = compile_expr(buf, crhs, local_names, cnl1, ctx, ld)\\n          if ctx.enable_rc {\\n            emit_unbox_float(buf)\\n          } else {\\n            ()\\n          }\\n          emit_f64_reinterpret_i64(buf)\\n          if cop == \\\"==\\\" {\\n            emit_f64_eq(buf)\\n          }\\n          else if cop == \\\"!=\\\" {\\n            emit_f64_ne(buf)\\n          }\\n          else if cop == \\\"<\\\" {\\n            emit_f64_lt(buf)\\n          }\\n          else if cop == \\\">\\\" {\\n            emit_f64_gt(buf)\\n          }\\n          else if cop == \\\"<=\\\" {\\n            emit_f64_le(buf)\\n          }\\n          else {\\n            emit_f64_ge(buf)\\n          }\\n          cnl2\\n        } else {\\n          let cnl1 = compile_expr(buf, clhs, local_names, next_local, ctx, ld)\\n          let cnl2 = compile_expr(buf, crhs, local_names, cnl1, ctx, ld)\\n          if cop == \\\"<\\\" {\\n            emit_i64_lt_s(buf)\\n          }\\n          else if cop == \\\">\\\" {\\n            emit_i64_gt_s(buf)\\n          }\\n          else if cop == \\\"<=\\\" {\\n            emit_i64_le_s(buf)\\n          }\\n          else {\\n            emit_i64_ge_s(buf)\\n          }\\n          cnl2\\n        }\\n      } else {\\n        let cnl = compile_expr(buf, cond, local_names, next_local, ctx, ld)\\n        emit_i32_wrap_i64(buf)\\n        cnl\\n      }\\n    } else if cond_tag == 1 {\\n      let b_val = get_ebool_value(cond)\\n      emit_i32_const(buf, if b_val {\\n        1\\n      } else {\\n        0\\n      })\\n      next_local\\n    } else if cond_tag == 6 {\\n      let uop = get_eunaryop_op(cond)\\n      let uoperand = get_eunaryop_expr(cond)\\n      if uop == \\\"!\\\" {\\n        let inner_tag = expr_tag(uoperand)\\n        if inner_tag == 5 {\\n          let iop = get_ebinop_op(uoperand)\\n          if iop == \\\"==\\\" || iop == \\\"!=\\\" || iop == \\\"<\\\" || iop == \\\">\\\" || iop == \\\"<=\\\" || iop == \\\">=\\\" {\\n            let ilhs = get_ebinop_lhs(uoperand)\\n            let irhs = get_ebinop_rhs(uoperand)\\n            if iop == \\\"==\\\" && !(ctx.enable_rc && (expr_is_floatish(ilhs, local_names, ctx) || expr_is_floatish(irhs, local_names, ctx))) {\\n              let inl2 = emit_eq_value(buf, ilhs, irhs, local_names, next_local, ctx, ld, compile_expr)\\n              emit_i32_wrap_i64(buf)\\n              emit_i32_eqz(buf)\\n              inl2\\n            } else if iop == \\\"!=\\\" && !(ctx.enable_rc && (expr_is_floatish(ilhs, local_names, ctx) || expr_is_floatish(irhs, local_names, ctx))) {\\n              let inl2 = emit_eq_value(buf, ilhs, irhs, local_names, next_local, ctx, ld, compile_expr)\\n              emit_i32_wrap_i64(buf)\\n              emit_i32_eqz(buf)\\n              emit_i32_eqz(buf)\\n              inl2\\n            } else if expr_is_floatish(ilhs, local_names, ctx) || expr_is_floatish(irhs, local_names, ctx) {\\n              // #704: unbox boxed floats under RC; handle ==/!= via f64_eq/f64_ne.\\n              // This arm is `!(ilhs iop irhs)`, so the trailing eqz negates.\\n              let inl1 = compile_expr(buf, ilhs, local_names, next_local, ctx, ld)\\n              if ctx.enable_rc {\\n                emit_unbox_float(buf)\\n              } else {\\n                ()\\n              }\\n              emit_f64_reinterpret_i64(buf)\\n              let inl2 = compile_expr(buf, irhs, local_names, inl1, ctx, ld)\\n              if ctx.enable_rc {\\n                emit_unbox_float(buf)\\n              } else {\\n                ()\\n              }\\n              emit_f64_reinterpret_i64(buf)\\n              if iop == \\\"==\\\" {\\n                emit_f64_eq(buf)\\n              }\\n              else if iop == \\\"!=\\\" {\\n                emit_f64_ne(buf)\\n              }\\n              else if iop == \\\"<\\\" {\\n                emit_f64_lt(buf)\\n              }\\n              else if iop == \\\">\\\" {\\n                emit_f64_gt(buf)\\n              }\\n              else if iop == \\\"<=\\\" {\\n                emit_f64_le(buf)\\n              }\\n              else {\\n                emit_f64_ge(buf)\\n              }\\n              emit_i32_eqz(buf)\\n              inl2\\n            } else {\\n              let inl1 = compile_expr(buf, ilhs, local_names, next_local, ctx, ld)\\n              let inl2 = compile_expr(buf, irhs, local_names, inl1, ctx, ld)\\n              if iop == \\\"<\\\" {\\n                emit_i64_lt_s(buf)\\n              }\\n              else if iop == \\\">\\\" {\\n                emit_i64_gt_s(buf)\\n              }\\n              else if iop == \\\"<=\\\" {\\n                emit_i64_le_s(buf)\\n              }\\n              else {\\n                emit_i64_ge_s(buf)\\n              }\\n              emit_i32_eqz(buf)\\n              inl2\\n            }\\n          } else {\\n            let cnl = compile_expr(buf, cond, local_names, next_local, ctx, ld)\\n            emit_i32_wrap_i64(buf)\\n            cnl\\n          }\\n        } else {\\n          let cnl = compile_expr(buf, cond, local_names, next_local, ctx, ld)\\n          emit_i32_wrap_i64(buf)\\n          cnl\\n        }\\n      } else {\\n        let cnl = compile_expr(buf, cond, local_names, next_local, ctx, ld)\\n        emit_i32_wrap_i64(buf)\\n        cnl\\n      }\\n    } else {\\n      let cnl = compile_expr(buf, cond, local_names, next_local, ctx, ld)\\n      emit_i32_wrap_i64(buf)\\n      cnl\\n    }\\n    emit_if_i64(buf)\\n    let ld_inner = if ld >= 0 {\\n      ld + 1\\n    } else {\\n      -1\\n    }\\n    let names_len_before = Array::length(local_names)\\n    // #cov branch: the then-branch was taken.\\n    cov_emit_branch(buf, ctx.cov)\\n    let nl2 = compile_expr(buf, then_e, local_names, nl1, ctx, ld_inner)\\n    emit_else(buf)\\n    Array::truncate(local_names, names_len_before)\\n    // #678: the then-branch may have logged integral slots >= names_len_before\\n    // that the else-branch is about to reuse; drop them so a non-`let` rebind\\n    // there is not misread as int.\\n    int_log_reset_above(ctx, names_len_before)\\n    agg_log_reset_above2(ctx.agg_local_slots, ctx.agg_local_exprs, names_len_before)\\n    // #cov branch: the else-branch was taken.\\n    cov_emit_branch(buf, ctx.cov)\\n    let nl3 = compile_expr(buf, else_e, local_names, nl1, ctx, ld_inner)\\n    emit_end(buf)\\n    let max_nl_if = if nl2 > nl3 {\\n      nl2\\n    } else {\\n      nl3\\n    }\\n    while Array::length(local_names) < max_nl_if {\\n      Array::push(local_names, \\\"\\\")\\n    }\\n    max_nl_if\\n  } else if __tag == 8 {\\n    compile_call(buf, get_ecall_callee(expr), get_ecall_args(expr), local_names, next_local, ctx, ld, compile_expr)\\n  } else {\\n    compile_expr_tail(buf, expr, local_names, next_local, ctx, ld, compile_expr)\\n  }\\n}\\n\")\n}\n\nlet cli_adapter_source_85 = () -> (String, String) {\n  (\"lib/@vibe/compiler/codegen/expr/compile_module_expr.vibe\",\n\"//# Imports\\n\\nimport ../../core {\\n  Expr, Stmt, bytebuf_new, bytebuf_to_bytes,\\n  sorted_names_of\\n}\\n\\nimport ../common_base {\\n  CompileCtx, CtorTable, FuncTable, LambdaTable, StrTable, cov_disabled\\n}\\n\\nimport ../wasm_emit {\\n  emit_code_section_with_locals, emit_export_section_multi, emit_function_section, emit_header, emit_type_section_multi\\n}\\n\\nimport ./compile_expr.vibe {\\n  compile_expr\\n}\\n\\n//# Functions\\n\\nexport fn compile_module_expr(stmts: Array[Stmt]) -> Bytes with { Error } {\\n  let fresh_int_array: () -> Array[Int] = () -> {\\n    ArrayBuilder::freeze(ArrayBuilder::new())\\n  }\\n  let fresh_string_array: () -> Array[String] = () -> {\\n    ArrayBuilder::freeze(ArrayBuilder::new())\\n  }\\n  let fresh_expr_array: () -> Array[Expr] = () -> {\\n    ArrayBuilder::freeze(ArrayBuilder::new())\\n  }\\n  let fresh_bytes_matrix: () -> Array[Bytes] = () -> {\\n    ArrayBuilder::freeze(ArrayBuilder::new())\\n  }\\n  let fresh_string_matrix: () -> Array[Array[String]] = () -> {\\n    ArrayBuilder::freeze(ArrayBuilder::new())\\n  }\\n  let fn_names_list = fresh_string_array()\\n  let fn_param_counts = fresh_int_array()\\n  let export_names = fresh_string_array()\\n  let export_indices = fresh_int_array()\\n  let fn_bodies_list = fresh_expr_array()\\n  let fn_param_names_list = fresh_string_matrix()\\n  let mut i = 0\\n  while i < Array::length(stmts) {\\n    let stmt = Array::get(stmts, i)\\n    match stmt {\\n      SLet(is_export, _, name, _, expr) => match expr {\\n        EFn(_, _, params, _, _, body) => {\\n          let cur_idx = Array::length(fn_names_list)\\n          Array::push(fn_names_list, name)\\n          Array::push(fn_param_counts, Array::length(params))\\n          Array::push(fn_bodies_list, body)\\n          let pnames = fresh_string_array()\\n          let mut pi = 0\\n          while pi < Array::length(params) {\\n            let (pname, _) = Array::get(params, pi)\\n            Array::push(pnames, pname)\\n            pi = pi + 1\\n          }\\n          Array::push(fn_param_names_list, pnames)\\n          if is_export {\\n            Array::push(export_names, name)\\n            Array::push(export_indices, cur_idx)\\n          }\\n          0\\n        },\\n        _ => 0\\n      },\\n      _ => 0\\n    }\\n    i = i + 1\\n  }\\n  let num_funcs = Array::length(fn_names_list)\\n  if num_funcs == 0 {\\n    let out = bytebuf_new()\\n    let empty_type_defs = fresh_int_array()\\n    let empty_type_indices = fresh_int_array()\\n    let empty_body = bytebuf_new()\\n    let empty_bodies = fresh_bytes_matrix()\\n    Array::push(empty_bodies, empty_body)\\n    let empty_local_counts = fresh_int_array()\\n    Array::push(empty_local_counts, 0)\\n    emit_header(out)\\n    emit_type_section_multi(out, empty_type_defs)\\n    emit_function_section(out, empty_type_indices)\\n    emit_code_section_with_locals(out, empty_bodies, empty_local_counts)\\n    bytebuf_to_bytes(out)\\n  } else {\\n    let fn_indices_list = fresh_int_array()\\n    let fn_returns_list = fresh_int_array()\\n    let fn_needs_env_list = ArrayBuilder::freeze(ArrayBuilder::new())\\n    let mut fi = 0\\n    while fi < num_funcs {\\n      Array::push(fn_indices_list, fi)\\n      Array::push(fn_returns_list, 1)\\n      Array::push(fn_needs_env_list, false)\\n      fi = fi + 1\\n    }\\n    let type_defs = fresh_int_array()\\n    let mut ti = 0\\n    while ti < num_funcs {\\n      Array::push(type_defs, Array::get(fn_param_counts, ti))\\n      Array::push(type_defs, 1)\\n      ti = ti + 1\\n    }\\n    let type_indices = fresh_int_array()\\n    let mut tii = 0\\n    while tii < num_funcs {\\n      Array::push(type_indices, tii)\\n      tii = tii + 1\\n    }\\n    let lt_m = LambdaTable::{\\n      bodies: fresh_bytes_matrix(),\\n      param_counts: fresh_int_array(),\\n      captures: fresh_string_matrix(),\\n      meta_i32: fresh_int_array(),\\n      meta_i64: fresh_int_array()\\n    }\\n    let empty_str_table = StrTable::{\\n      strs: fresh_string_array(),\\n      offsets: fresh_int_array(),\\n      lengths: fresh_int_array()\\n    }\\n    let empty_ctor_table = CtorTable::{\\n      names: fresh_string_array(),\\n      tags: fresh_int_array(),\\n      field_counts: fresh_int_array(),\\n      type_names: fresh_string_array(),\\n      struct_names: fresh_string_array(),\\n      struct_field_names: fresh_string_matrix(),\\n      names_sorted: fresh_string_array(),\\n      names_sorted_pos: fresh_int_array()\\n    }\\n    let empty_thunk_names = fresh_string_array()\\n    let empty_const_int_names = fresh_string_array()\\n    let empty_const_int_values = fresh_int_array()\\n    let empty_rc_drop_names = fresh_string_array()\\n    let empty_rc_alias_dup_names = fresh_string_array()\\n    let empty_rc_dup_names = fresh_string_array()\\n    let bodies = fresh_bytes_matrix()\\n    let local_counts = fresh_int_array()\\n    // Sorted capture index (see CompileCtx.capture_name_index): built once,\\n    // shared by every per-function ctx below.\\n    let cni_sorted = sorted_names_of(fn_names_list)\\n    let mut bi = 0\\n    while bi < num_funcs {\\n      let body = Array::get(fn_bodies_list, bi)\\n      let param_names = Array::get(fn_param_names_list, bi)\\n      let body_buf = bytebuf_new()\\n      let local_names = fresh_string_array()\\n      let mut pi = 0\\n      while pi < Array::length(param_names) {\\n        Array::push(local_names, Array::get(param_names, pi))\\n        pi = pi + 1\\n      }\\n      let param_count = Array::length(param_names)\\n      let empty_ref_cells = fresh_string_array()\\n      let compile_ctx = CompileCtx::{\\n        func_table: FuncTable::{\\n          names: fn_names_list,\\n          indices: fn_indices_list,\\n          params: fn_param_counts,\\n          returns: fn_returns_list,\\n          needs_env: fn_needs_env_list\\n        },\\n        str_table: empty_str_table,\\n        lambda_table: lt_m,\\n        num_user_funcs: num_funcs, func_offset: 0,\\n        ref_cell_names: empty_ref_cells,\\n        ctor_table: empty_ctor_table,\\n        thunk_names: empty_thunk_names,\\n        const_int_names: empty_const_int_names,\\n        const_int_values: empty_const_int_values,\\n        enable_rc: false,\\n        rc_shadow: false,\\n        rc_drop_names: empty_rc_drop_names,\\n        rc_alias_dup_names: empty_rc_alias_dup_names,\\n        heap_binding_names: fresh_string_array(),\\n        rc_drop_func_idx: -1,\\n        rc_alloc_func_idx: -1,\\n        heap_grow_check_func_idx: -1,\\n        rc_dup_names: empty_rc_dup_names,\\n        capture_name_index: cni_sorted,\\n        float_local_slots: fresh_int_array(),\\n        int_local_slots: fresh_int_array(),\\n        agg_local_slots: fresh_int_array(),\\n        agg_local_exprs: fresh_expr_array(),\\n        agg_ret_names: fresh_string_array(),\\n        agg_ret_infos: fresh_int_array(),\\n        heap_ret_names: fresh_string_array(),\\n        effect_names: fresh_string_array(),\\n        effect_op_keys: fresh_string_array(),\\n        effect_op_arities: fresh_int_array(),\\n        cov: cov_disabled(),\\n        dbg_line_idx: -1,\\n        dbg_line_nl: fresh_int_array(),\\n        dbg_line_file_id: 0,\\n        loop_borrowed_names: fresh_string_array(),\\n        loop_consumed_names: fresh_string_array(),\\n        borrow_ret_names: fresh_string_array(),\\n        scalar_ret_names: fresh_string_array(),\\n        pending_letrec_self_name: fresh_string_array()\\n      }\\n      let final_nl = compile_expr(body_buf, body, local_names, param_count, compile_ctx, -1)\\n      Array::push(bodies, body_buf)\\n      let extra = if final_nl > param_count {\\n        final_nl - param_count\\n      } else {\\n        0\\n      }\\n      Array::push(local_counts, extra)\\n      bi = bi + 1\\n    }\\n    let out = bytebuf_new()\\n    emit_header(out)\\n    emit_type_section_multi(out, type_defs)\\n    emit_function_section(out, type_indices)\\n    if Array::length(export_names) > 0 {\\n      emit_export_section_multi(out, export_names, export_indices)\\n    }\\n    emit_code_section_with_locals(out, bodies, local_counts)\\n    bytebuf_to_bytes(out)\\n  }\\n}\\n\")\n}\n\nlet cli_adapter_source_86 = () -> (String, String) {\n  (\"lib/@vibe/compiler/codegen/expr/core.vibe\",\n\"//# Imports\\n\\nexport ./compile_expr.vibe {\\n  compile_expr\\n}\\n\\nexport ./compile_module_expr.vibe {\\n  compile_module_expr\\n}\\n\\n//# Misc\\n\\nexport {\\n  compile_expr, compile_module_expr\\n}\\n\")\n}\n\nlet cli_adapter_source_87 = () -> (String, String) {\n  (\"lib/@vibe/compiler/codegen/inline_wat.vibe\",\n\"//# Imports\\n\\nimport ../core {\\n  bytebuf_new, bytebuf_push, bytebuf_push_buf, leb128_encode_s32, leb128_encode_s64, leb128_encode_u32\\n}\\n\\n//# Functions\\n\\n// #805 inline wasm: a small WAT-body assembler for the linear backend's\\n// `fn f(a: Int, b: Int) -> Int = wasm \\\"(i64.add (local.get $a) (local.get $b))\\\"`\\n// form. Compiles the body TEXT of one function to raw instruction bytes\\n// (no locals-declaration header, no trailing 0x0B end opcode — exactly the\\n// `bodies` convention of linked_compile.vibe's code-section builder, which\\n// adds both).\\n//\\n// Why not reuse lib/@vibex/wasm/wat_encoder? Three reasons, each fatal for\\n// this use (see ADR-0072):\\n//   1. wat_encoder has NO SIMD (0xFD prefix) support at all — a headline\\n//      motivation for inline wasm (roadmap item 7) — so it would need\\n//      extension anyway.\\n//   2. its body walker emits folded S-expressions in PREFIX order (the\\n//      operator before its operands), which mis-orders the canonical\\n//      `(i64.add (local.get $a) (local.get $b))` spelling. This assembler\\n//      implements real folded-form semantics (operands first).\\n//   3. it silently resolves unknown instruction/local names to index 0 with\\n//      no error channel; inline wasm needs located compile errors.\\n// Pulling the 2.8k-line package into the compiler dependency closure (and\\n// its source into the seed-compiled bundle) for a subset we would then have\\n// to patch was strictly worse than this ~600-line purpose-built assembler.\\n//\\n// Supported subset (v0.3 slice, documented in docs/cheatsheet.md):\\n//   - folded S-expressions AND flat instruction sequences; structured\\n//     control (block/loop/if) is folded-form ONLY\\n//   - `(block $l (result i64) ...)`, `(loop $l ...)`,\\n//     `(if (result T)? <cond> (then ...) (else ...)?)`, br / br_if with\\n//     `$label` or numeric relative depth; return/unreachable/nop/drop/select\\n//   - local.get / local.set / local.tee over the fn's own params\\n//     (`$paramname` or numeric index); NO `(local ...)` declarations\\n//   - i32/i64 const (decimal / hex / `_` separators; vibe Int range only),\\n//     full i32/i64 integer arithmetic / compare / shift / rotate /\\n//     conversion set, f32/f64 arithmetic + compares (no f32/f64.const)\\n//   - memory loads/stores with optional `offset=` / `align=` (align in\\n//     bytes, spec-style), memory.size / memory.grow\\n//   - SIMD (0xFD): v128.load/store, v128.const, splat / extract_lane /\\n//     replace_lane, integer lane arithmetic + compares, bitwise, all_true /\\n//     any_true / bitmask, swizzle, shifts\\n//   - NOT supported (clear errors): call / call_indirect / br_table /\\n//     global.get/set / f32.const / f64.const / (local ...) declarations\\n\\nfn iw_err(fn_name: String, msg: String, off: Int) -> String {\\n  \\\"inline wasm (fn \\\\{fn_name}): \\\\{msg} (WAT offset \\\\{off})\\\"\\n}\\n\\nfn iw_fresh_ints() -> Array[Int] {\\n  Array::slice([\\n    0\\n  ], 0, 0)\\n}\\n\\nfn iw_fresh_strings() -> Array[String] {\\n  Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n}\\n\\nfn iw_is_space(c: Int) -> Bool {\\n  c == 32 || c == 9 || c == 10 || c == 13\\n}\\n\\n// Token kinds: 1 = '(', 2 = ')', 3 = word. Words end at whitespace, parens\\n// or ';'. Comments: `;; ...` to end of line, `(; ... ;)` (non-nested).\\nfn iw_tokenize(fn_name: String, src: String) -> (Array[Int], Array[String], Array[Int]) with { Error } {\\n  let kinds = iw_fresh_ints()\\n  let texts = iw_fresh_strings()\\n  let offs = iw_fresh_ints()\\n  let n = String::length(src)\\n  let mut i = 0\\n  while i < n {\\n    let c = String::char_code_at(src, i)\\n    if iw_is_space(c) {\\n      i = i + 1\\n    } else if c == 59 {\\n      // ';' — only meaningful as ';;' line comment\\n      if i + 1 < n && String::char_code_at(src, i + 1) == 59 {\\n        while i < n && String::char_code_at(src, i) != 10 {\\n          i = i + 1\\n        }\\n      } else {\\n        throw(iw_err(fn_name, \\\"stray ';' (use ';;' line comments)\\\", i))\\n      }\\n    } else if c == 40 {\\n      // '(' — possibly a '(;' block comment\\n      if i + 1 < n && String::char_code_at(src, i + 1) == 59 {\\n        let mut j = i + 2\\n        let mut closed = false\\n        while j + 1 < n && !closed {\\n          if String::char_code_at(src, j) == 59 && String::char_code_at(src, j + 1) == 41 {\\n            closed = true\\n          } else {\\n            j = j + 1\\n          }\\n        }\\n        if !closed {\\n          throw(iw_err(fn_name, \\\"unterminated '(;' block comment\\\", i))\\n        } else {\\n          ()\\n        }\\n        i = j + 2\\n      } else {\\n        Array::push(kinds, 1)\\n        Array::push(texts, \\\"\\\")\\n        Array::push(offs, i)\\n        i = i + 1\\n      }\\n    } else if c == 41 {\\n      Array::push(kinds, 2)\\n      Array::push(texts, \\\"\\\")\\n      Array::push(offs, i)\\n      i = i + 1\\n    } else {\\n      let start = i\\n      let mut j = i\\n      let mut stop = false\\n      while j < n && !stop {\\n        let wc = String::char_code_at(src, j)\\n        if iw_is_space(wc) || wc == 40 || wc == 41 || wc == 59 {\\n          stop = true\\n        } else {\\n          j = j + 1\\n        }\\n      }\\n      Array::push(kinds, 3)\\n      Array::push(texts, String::substring(src, start, j))\\n      Array::push(offs, start)\\n      i = j\\n    }\\n  }\\n  (kinds, texts, offs)\\n}\\n\\n// Integer immediates: decimal / 0x-hex, optional leading '-', '_' separators.\\nfn iw_parse_int(fn_name: String, s: String, off: Int) -> Int with { Error } {\\n  let n = String::length(s)\\n  let mut i = 0\\n  let mut neg = false\\n  if i < n && String::char_code_at(s, i) == '-' {\\n    neg = true\\n    i = i + 1\\n  } else {\\n    ()\\n  }\\n  let mut hex = false\\n  if i + 1 < n && String::char_code_at(s, i) == '0' {\\n    let x = String::char_code_at(s, i + 1)\\n    if x == 'x' || x == 'X' {\\n      hex = true\\n      i = i + 2\\n    } else {\\n      ()\\n    }\\n  } else {\\n    ()\\n  }\\n  let mut v = 0\\n  let mut any = false\\n  while i < n {\\n    let c = String::char_code_at(s, i)\\n    if c == '_' {\\n      i = i + 1\\n    } else if hex {\\n      let d = if c >= '0' && c <= '9' {\\n        c - '0'\\n      } else if c >= 'a' && c <= 'f' {\\n        c - 'a' + 10\\n      } else if c >= 'A' && c <= 'F' {\\n        c - 'A' + 10\\n      } else {\\n        0 - 1\\n      }\\n      if d < 0 {\\n        throw(iw_err(fn_name, \\\"invalid integer literal '\\\\{s}'\\\", off))\\n      } else {\\n        ()\\n      }\\n      v = v * 16 + d\\n      any = true\\n      i = i + 1\\n    } else {\\n      if c >= '0' && c <= '9' {\\n        v = v * 10 + (c - '0')\\n        any = true\\n        i = i + 1\\n      } else {\\n        throw(iw_err(fn_name, \\\"invalid integer literal '\\\\{s}'\\\", off))\\n      }\\n    }\\n  }\\n  if !any {\\n    throw(iw_err(fn_name, \\\"invalid integer literal '\\\\{s}'\\\", off))\\n  } else {\\n    ()\\n  }\\n  if neg {\\n    0 - v\\n  } else {\\n    v\\n  }\\n}\\n\\n// Core single-byte opcodes with NO immediates.\\nfn iw_core_table() -> Array[(String, Int)] {\\n  [\\n    (\\\"unreachable\\\", 0x00), (\\\"nop\\\", 0x01), (\\\"return\\\", 0x0F), (\\\"drop\\\", 0x1A), (\\\"select\\\", 0x1B),\\n    (\\\"i32.eqz\\\", 0x45), (\\\"i32.eq\\\", 0x46), (\\\"i32.ne\\\", 0x47), (\\\"i32.lt_s\\\", 0x48), (\\\"i32.lt_u\\\", 0x49),\\n    (\\\"i32.gt_s\\\", 0x4A), (\\\"i32.gt_u\\\", 0x4B), (\\\"i32.le_s\\\", 0x4C), (\\\"i32.le_u\\\", 0x4D), (\\\"i32.ge_s\\\", 0x4E), (\\\"i32.ge_u\\\", 0x4F),\\n    (\\\"i64.eqz\\\", 0x50), (\\\"i64.eq\\\", 0x51), (\\\"i64.ne\\\", 0x52), (\\\"i64.lt_s\\\", 0x53), (\\\"i64.lt_u\\\", 0x54),\\n    (\\\"i64.gt_s\\\", 0x55), (\\\"i64.gt_u\\\", 0x56), (\\\"i64.le_s\\\", 0x57), (\\\"i64.le_u\\\", 0x58), (\\\"i64.ge_s\\\", 0x59), (\\\"i64.ge_u\\\", 0x5A),\\n    (\\\"f32.eq\\\", 0x5B), (\\\"f32.ne\\\", 0x5C), (\\\"f32.lt\\\", 0x5D), (\\\"f32.gt\\\", 0x5E), (\\\"f32.le\\\", 0x5F), (\\\"f32.ge\\\", 0x60),\\n    (\\\"f64.eq\\\", 0x61), (\\\"f64.ne\\\", 0x62), (\\\"f64.lt\\\", 0x63), (\\\"f64.gt\\\", 0x64), (\\\"f64.le\\\", 0x65), (\\\"f64.ge\\\", 0x66),\\n    (\\\"i32.clz\\\", 0x67), (\\\"i32.ctz\\\", 0x68), (\\\"i32.popcnt\\\", 0x69),\\n    (\\\"i32.add\\\", 0x6A), (\\\"i32.sub\\\", 0x6B), (\\\"i32.mul\\\", 0x6C), (\\\"i32.div_s\\\", 0x6D), (\\\"i32.div_u\\\", 0x6E),\\n    (\\\"i32.rem_s\\\", 0x6F), (\\\"i32.rem_u\\\", 0x70), (\\\"i32.and\\\", 0x71), (\\\"i32.or\\\", 0x72), (\\\"i32.xor\\\", 0x73),\\n    (\\\"i32.shl\\\", 0x74), (\\\"i32.shr_s\\\", 0x75), (\\\"i32.shr_u\\\", 0x76), (\\\"i32.rotl\\\", 0x77), (\\\"i32.rotr\\\", 0x78),\\n    (\\\"i64.clz\\\", 0x79), (\\\"i64.ctz\\\", 0x7A), (\\\"i64.popcnt\\\", 0x7B),\\n    (\\\"i64.add\\\", 0x7C), (\\\"i64.sub\\\", 0x7D), (\\\"i64.mul\\\", 0x7E), (\\\"i64.div_s\\\", 0x7F), (\\\"i64.div_u\\\", 0x80),\\n    (\\\"i64.rem_s\\\", 0x81), (\\\"i64.rem_u\\\", 0x82), (\\\"i64.and\\\", 0x83), (\\\"i64.or\\\", 0x84), (\\\"i64.xor\\\", 0x85),\\n    (\\\"i64.shl\\\", 0x86), (\\\"i64.shr_s\\\", 0x87), (\\\"i64.shr_u\\\", 0x88), (\\\"i64.rotl\\\", 0x89), (\\\"i64.rotr\\\", 0x8A),\\n    (\\\"f32.abs\\\", 0x8B), (\\\"f32.neg\\\", 0x8C), (\\\"f32.ceil\\\", 0x8D), (\\\"f32.floor\\\", 0x8E), (\\\"f32.trunc\\\", 0x8F),\\n    (\\\"f32.nearest\\\", 0x90), (\\\"f32.sqrt\\\", 0x91), (\\\"f32.add\\\", 0x92), (\\\"f32.sub\\\", 0x93), (\\\"f32.mul\\\", 0x94),\\n    (\\\"f32.div\\\", 0x95), (\\\"f32.min\\\", 0x96), (\\\"f32.max\\\", 0x97), (\\\"f32.copysign\\\", 0x98),\\n    (\\\"f64.abs\\\", 0x99), (\\\"f64.neg\\\", 0x9A), (\\\"f64.ceil\\\", 0x9B), (\\\"f64.floor\\\", 0x9C), (\\\"f64.trunc\\\", 0x9D),\\n    (\\\"f64.nearest\\\", 0x9E), (\\\"f64.sqrt\\\", 0x9F), (\\\"f64.add\\\", 0xA0), (\\\"f64.sub\\\", 0xA1), (\\\"f64.mul\\\", 0xA2),\\n    (\\\"f64.div\\\", 0xA3), (\\\"f64.min\\\", 0xA4), (\\\"f64.max\\\", 0xA5), (\\\"f64.copysign\\\", 0xA6),\\n    (\\\"i32.wrap_i64\\\", 0xA7),\\n    (\\\"i32.trunc_f32_s\\\", 0xA8), (\\\"i32.trunc_f32_u\\\", 0xA9), (\\\"i32.trunc_f64_s\\\", 0xAA), (\\\"i32.trunc_f64_u\\\", 0xAB),\\n    (\\\"i64.extend_i32_s\\\", 0xAC), (\\\"i64.extend_i32_u\\\", 0xAD),\\n    (\\\"i64.trunc_f32_s\\\", 0xAE), (\\\"i64.trunc_f32_u\\\", 0xAF), (\\\"i64.trunc_f64_s\\\", 0xB0), (\\\"i64.trunc_f64_u\\\", 0xB1),\\n    (\\\"f32.convert_i32_s\\\", 0xB2), (\\\"f32.convert_i32_u\\\", 0xB3), (\\\"f32.convert_i64_s\\\", 0xB4), (\\\"f32.convert_i64_u\\\", 0xB5),\\n    (\\\"f32.demote_f64\\\", 0xB6),\\n    (\\\"f64.convert_i32_s\\\", 0xB7), (\\\"f64.convert_i32_u\\\", 0xB8), (\\\"f64.convert_i64_s\\\", 0xB9), (\\\"f64.convert_i64_u\\\", 0xBA),\\n    (\\\"f64.promote_f32\\\", 0xBB),\\n    (\\\"i32.reinterpret_f32\\\", 0xBC), (\\\"i64.reinterpret_f64\\\", 0xBD), (\\\"f32.reinterpret_i32\\\", 0xBE), (\\\"f64.reinterpret_i64\\\", 0xBF),\\n    (\\\"i32.extend8_s\\\", 0xC0), (\\\"i32.extend16_s\\\", 0xC1), (\\\"i64.extend8_s\\\", 0xC2), (\\\"i64.extend16_s\\\", 0xC3), (\\\"i64.extend32_s\\\", 0xC4)\\n  ]\\n}\\n\\n// SIMD (0xFD-prefixed) sub-opcodes with NO immediates. Sub-opcode values are\\n// the wasm spec's; the handful the codegen already emits (wasm_emit/simd.vibe)\\n// agree with these entries.\\nfn iw_simd_table() -> Array[(String, Int)] {\\n  [\\n    (\\\"i8x16.swizzle\\\", 14), (\\\"i8x16.splat\\\", 15), (\\\"i16x8.splat\\\", 16), (\\\"i32x4.splat\\\", 17),\\n    (\\\"i64x2.splat\\\", 18), (\\\"f32x4.splat\\\", 19), (\\\"f64x2.splat\\\", 20),\\n    (\\\"i8x16.eq\\\", 35), (\\\"i8x16.ne\\\", 36), (\\\"i8x16.lt_s\\\", 37), (\\\"i8x16.lt_u\\\", 38), (\\\"i8x16.gt_s\\\", 39),\\n    (\\\"i8x16.gt_u\\\", 40), (\\\"i8x16.le_s\\\", 41), (\\\"i8x16.le_u\\\", 42), (\\\"i8x16.ge_s\\\", 43), (\\\"i8x16.ge_u\\\", 44),\\n    (\\\"i16x8.eq\\\", 45), (\\\"i16x8.ne\\\", 46), (\\\"i16x8.lt_s\\\", 47), (\\\"i16x8.lt_u\\\", 48), (\\\"i16x8.gt_s\\\", 49),\\n    (\\\"i16x8.gt_u\\\", 50), (\\\"i16x8.le_s\\\", 51), (\\\"i16x8.le_u\\\", 52), (\\\"i16x8.ge_s\\\", 53), (\\\"i16x8.ge_u\\\", 54),\\n    (\\\"i32x4.eq\\\", 55), (\\\"i32x4.ne\\\", 56), (\\\"i32x4.lt_s\\\", 57), (\\\"i32x4.lt_u\\\", 58), (\\\"i32x4.gt_s\\\", 59),\\n    (\\\"i32x4.gt_u\\\", 60), (\\\"i32x4.le_s\\\", 61), (\\\"i32x4.le_u\\\", 62), (\\\"i32x4.ge_s\\\", 63), (\\\"i32x4.ge_u\\\", 64),\\n    (\\\"f32x4.eq\\\", 65), (\\\"f32x4.ne\\\", 66), (\\\"f32x4.lt\\\", 67), (\\\"f32x4.gt\\\", 68), (\\\"f32x4.le\\\", 69), (\\\"f32x4.ge\\\", 70),\\n    (\\\"f64x2.eq\\\", 71), (\\\"f64x2.ne\\\", 72), (\\\"f64x2.lt\\\", 73), (\\\"f64x2.gt\\\", 74), (\\\"f64x2.le\\\", 75), (\\\"f64x2.ge\\\", 76),\\n    (\\\"v128.not\\\", 77), (\\\"v128.and\\\", 78), (\\\"v128.andnot\\\", 79), (\\\"v128.or\\\", 80), (\\\"v128.xor\\\", 81),\\n    (\\\"v128.bitselect\\\", 82), (\\\"v128.any_true\\\", 83),\\n    (\\\"i8x16.abs\\\", 96), (\\\"i8x16.neg\\\", 97), (\\\"i8x16.popcnt\\\", 98), (\\\"i8x16.all_true\\\", 99), (\\\"i8x16.bitmask\\\", 100),\\n    (\\\"i8x16.shl\\\", 107), (\\\"i8x16.shr_s\\\", 108), (\\\"i8x16.shr_u\\\", 109),\\n    (\\\"i8x16.add\\\", 110), (\\\"i8x16.add_sat_s\\\", 111), (\\\"i8x16.add_sat_u\\\", 112),\\n    (\\\"i8x16.sub\\\", 113), (\\\"i8x16.sub_sat_s\\\", 114), (\\\"i8x16.sub_sat_u\\\", 115),\\n    (\\\"i8x16.min_s\\\", 118), (\\\"i8x16.min_u\\\", 119), (\\\"i8x16.max_s\\\", 120), (\\\"i8x16.max_u\\\", 121), (\\\"i8x16.avgr_u\\\", 123),\\n    (\\\"i16x8.abs\\\", 128), (\\\"i16x8.neg\\\", 129), (\\\"i16x8.all_true\\\", 131), (\\\"i16x8.bitmask\\\", 132),\\n    (\\\"i16x8.shl\\\", 139), (\\\"i16x8.shr_s\\\", 140), (\\\"i16x8.shr_u\\\", 141),\\n    (\\\"i16x8.add\\\", 142), (\\\"i16x8.sub\\\", 145), (\\\"i16x8.mul\\\", 149),\\n    (\\\"i16x8.min_s\\\", 150), (\\\"i16x8.min_u\\\", 151), (\\\"i16x8.max_s\\\", 152), (\\\"i16x8.max_u\\\", 153), (\\\"i16x8.avgr_u\\\", 155),\\n    (\\\"i32x4.abs\\\", 160), (\\\"i32x4.neg\\\", 161), (\\\"i32x4.all_true\\\", 163), (\\\"i32x4.bitmask\\\", 164),\\n    (\\\"i32x4.shl\\\", 171), (\\\"i32x4.shr_s\\\", 172), (\\\"i32x4.shr_u\\\", 173),\\n    (\\\"i32x4.add\\\", 174), (\\\"i32x4.sub\\\", 177), (\\\"i32x4.mul\\\", 181),\\n    (\\\"i32x4.min_s\\\", 182), (\\\"i32x4.min_u\\\", 183), (\\\"i32x4.max_s\\\", 184), (\\\"i32x4.max_u\\\", 185),\\n    (\\\"i32x4.dot_i16x8_s\\\", 186),\\n    (\\\"i64x2.abs\\\", 192), (\\\"i64x2.neg\\\", 193), (\\\"i64x2.all_true\\\", 195), (\\\"i64x2.bitmask\\\", 196),\\n    (\\\"i64x2.shl\\\", 203), (\\\"i64x2.shr_s\\\", 204), (\\\"i64x2.shr_u\\\", 205),\\n    (\\\"i64x2.add\\\", 206), (\\\"i64x2.sub\\\", 209), (\\\"i64x2.mul\\\", 213),\\n    (\\\"i64x2.eq\\\", 214), (\\\"i64x2.ne\\\", 215), (\\\"i64x2.lt_s\\\", 216), (\\\"i64x2.gt_s\\\", 217), (\\\"i64x2.le_s\\\", 218), (\\\"i64x2.ge_s\\\", 219),\\n    (\\\"f32x4.abs\\\", 224), (\\\"f32x4.neg\\\", 225), (\\\"f32x4.sqrt\\\", 227),\\n    (\\\"f32x4.add\\\", 228), (\\\"f32x4.sub\\\", 229), (\\\"f32x4.mul\\\", 230), (\\\"f32x4.div\\\", 231), (\\\"f32x4.min\\\", 232), (\\\"f32x4.max\\\", 233),\\n    (\\\"f64x2.abs\\\", 236), (\\\"f64x2.neg\\\", 237), (\\\"f64x2.sqrt\\\", 239),\\n    (\\\"f64x2.add\\\", 240), (\\\"f64x2.sub\\\", 241), (\\\"f64x2.mul\\\", 242), (\\\"f64x2.div\\\", 243), (\\\"f64x2.min\\\", 244), (\\\"f64x2.max\\\", 245)\\n  ]\\n}\\n\\n// SIMD lane-immediate sub-opcodes (0xFD + sub + one lane byte).\\n// Lane count of a SIMD lane-immediate op, from its shape prefix\\n// (i8x16.* -> 16 lanes, ..., f64x2.* -> 2). Callers only pass names that\\n// matched iw_simd_lane_table, so the fallthrough is the two-lane shapes.\\nfn iw_lane_count(name: String) -> Int {\\n  if String::starts_with(name, \\\"i8x16.\\\") {\\n    16\\n  } else if String::starts_with(name, \\\"i16x8.\\\") {\\n    8\\n  } else if String::starts_with(name, \\\"i32x4.\\\") || String::starts_with(name, \\\"f32x4.\\\") {\\n    4\\n  } else {\\n    2\\n  }\\n}\\n\\nfn iw_simd_lane_table() -> Array[(String, Int)] {\\n  [\\n    (\\\"i8x16.extract_lane_s\\\", 21), (\\\"i8x16.extract_lane_u\\\", 22), (\\\"i8x16.replace_lane\\\", 23),\\n    (\\\"i16x8.extract_lane_s\\\", 24), (\\\"i16x8.extract_lane_u\\\", 25), (\\\"i16x8.replace_lane\\\", 26),\\n    (\\\"i32x4.extract_lane\\\", 27), (\\\"i32x4.replace_lane\\\", 28),\\n    (\\\"i64x2.extract_lane\\\", 29), (\\\"i64x2.replace_lane\\\", 30),\\n    (\\\"f32x4.extract_lane\\\", 31), (\\\"f32x4.replace_lane\\\", 32),\\n    (\\\"f64x2.extract_lane\\\", 33), (\\\"f64x2.replace_lane\\\", 34)\\n  ]\\n}\\n\\n// Core memory ops: (name, opcode, default align exponent).\\nfn iw_mem_table() -> Array[(String, Int, Int)] {\\n  [\\n    (\\\"i32.load\\\", 0x28, 2), (\\\"i64.load\\\", 0x29, 3), (\\\"f32.load\\\", 0x2A, 2), (\\\"f64.load\\\", 0x2B, 3),\\n    (\\\"i32.load8_s\\\", 0x2C, 0), (\\\"i32.load8_u\\\", 0x2D, 0), (\\\"i32.load16_s\\\", 0x2E, 1), (\\\"i32.load16_u\\\", 0x2F, 1),\\n    (\\\"i64.load8_s\\\", 0x30, 0), (\\\"i64.load8_u\\\", 0x31, 0), (\\\"i64.load16_s\\\", 0x32, 1), (\\\"i64.load16_u\\\", 0x33, 1),\\n    (\\\"i64.load32_s\\\", 0x34, 2), (\\\"i64.load32_u\\\", 0x35, 2),\\n    (\\\"i32.store\\\", 0x36, 2), (\\\"i64.store\\\", 0x37, 3), (\\\"f32.store\\\", 0x38, 2), (\\\"f64.store\\\", 0x39, 3),\\n    (\\\"i32.store8\\\", 0x3A, 0), (\\\"i32.store16\\\", 0x3B, 1),\\n    (\\\"i64.store8\\\", 0x3C, 0), (\\\"i64.store16\\\", 0x3D, 1), (\\\"i64.store32\\\", 0x3E, 2)\\n  ]\\n}\\n\\nfn iw_lookup(table: Array[(String, Int)], name: String) -> Int {\\n  let n = Array::length(table)\\n  let mut i = 0\\n  let mut found = 0 - 1\\n  while i < n {\\n    let (tn, tv) = Array::get(table, i)\\n    if tn == name {\\n      found = tv\\n      i = n\\n    } else {\\n      i = i + 1\\n    }\\n  }\\n  found\\n}\\n\\nfn iw_mem_lookup(name: String) -> (Int, Int) {\\n  let table = iw_mem_table()\\n  let n = Array::length(table)\\n  let mut i = 0\\n  let mut op = 0 - 1\\n  let mut al = 0\\n  while i < n {\\n    let (tn, tv, ta) = Array::get(table, i)\\n    if tn == name {\\n      op = tv\\n      al = ta\\n      i = n\\n    } else {\\n      i = i + 1\\n    }\\n  }\\n  (op, al)\\n}\\n\\n// Local resolution: `$name` against the fn's own params (locals 0..n-1),\\n// or a bare numeric index (locals >= param count are the codegen's own —\\n// index `param_count` is the closure env slot — so named access is the\\n// safe spelling).\\nfn iw_local_idx(fn_name: String, params: Array[String], tok: String, off: Int) -> Int with { Error } {\\n  if String::length(tok) > 0 && String::char_code_at(tok, 0) == '$' {\\n    let want = String::substring(tok, 1, String::length(tok))\\n    let n = Array::length(params)\\n    let mut i = 0\\n    let mut found = 0 - 1\\n    while i < n {\\n      if Array::get(params, i) == want {\\n        found = i\\n        i = n\\n      } else {\\n        i = i + 1\\n      }\\n    }\\n    if found < 0 {\\n      throw(iw_err(fn_name, \\\"unknown local '\\\\{tok}' — inline wasm locals are the fn's own params\\\", off))\\n    } else {\\n      found\\n    }\\n  } else {\\n    iw_parse_int(fn_name, tok, off)\\n  }\\n}\\n\\n// Label resolution: `$name` bound by an enclosing block/loop/if (innermost\\n// binding wins), or a bare numeric relative depth.\\nfn iw_label_rel(fn_name: String, lbl_names: Array[String], lbl_depths: Array[Int], tok: String, depth: Int, off: Int) -> Int with { Error } {\\n  if String::length(tok) > 0 && String::char_code_at(tok, 0) == '$' {\\n    let n = Array::length(lbl_names)\\n    let mut i = n\\n    let mut bound = 0 - 1\\n    while i > 0 {\\n      i = i - 1\\n      if Array::get(lbl_names, i) == tok {\\n        bound = Array::get(lbl_depths, i)\\n        i = 0\\n      } else {\\n        ()\\n      }\\n    }\\n    if bound < 0 {\\n      throw(iw_err(fn_name, \\\"unknown label '\\\\{tok}'\\\", off))\\n    } else {\\n      depth - bound - 1\\n    }\\n  } else {\\n    iw_parse_int(fn_name, tok, off)\\n  }\\n}\\n\\nfn iw_valtype_code(fn_name: String, name: String, off: Int) -> Int with { Error } {\\n  match name {\\n    \\\"i32\\\" => 0x7F,\\n    \\\"i64\\\" => 0x7E,\\n    \\\"f32\\\" => 0x7D,\\n    \\\"f64\\\" => 0x7C,\\n    \\\"v128\\\" => 0x7B,\\n    _ => throw(iw_err(fn_name, \\\"unknown value type '\\\\{name}'\\\", off))\\n  }\\n}\\n\\n// Optional `(result T)` clause at `pos`; returns (blocktype byte, next pos).\\nfn iw_blocktype(fn_name: String, kinds: Array[Int], texts: Array[String], offs: Array[Int], pos: Int, end: Int) -> (Int, Int) with { Error } {\\n  if pos + 1 < end && Array::get(kinds, pos) == 1 && Array::get(kinds, pos + 1) == 3 && Array::get(texts, pos + 1) == \\\"result\\\" {\\n    if pos + 3 < end && Array::get(kinds, pos + 2) == 3 && Array::get(kinds, pos + 3) == 2 {\\n      let vt = iw_valtype_code(fn_name, Array::get(texts, pos + 2), Array::get(offs, pos + 2));\\n      (vt, pos + 4)\\n    } else {\\n      throw(iw_err(fn_name, \\\"malformed (result T) clause\\\", Array::get(offs, pos)))\\n    }\\n  } else {\\n    (0x40, pos)\\n  }\\n}\\n\\n// Optional `offset=N` / `align=N` immediates (align given in BYTES, encoded\\n// as its log2 exponent, spec-style). Returns (align_exp, offset, next pos).\\nfn iw_memarg(fn_name: String, kinds: Array[Int], texts: Array[String], offs: Array[Int], pos: Int, end: Int, default_align: Int) -> (Int, Int, Int) with { Error } {\\n  let mut align = default_align\\n  let mut offset = 0\\n  let mut p = pos\\n  let mut done = false\\n  while !done {\\n    if p < end && Array::get(kinds, p) == 3 {\\n      let t = Array::get(texts, p)\\n      if String::starts_with(t, \\\"offset=\\\") {\\n        offset = iw_parse_int(fn_name, String::substring(t, 7, String::length(t)), Array::get(offs, p))\\n        p = p + 1\\n      } else if String::starts_with(t, \\\"align=\\\") {\\n        let a = iw_parse_int(fn_name, String::substring(t, 6, String::length(t)), Array::get(offs, p))\\n        // Codex P2 on #933: floor-log2 of an arbitrary int silently\\n        // reinterpreted align=3 as align=2, and an over-aligned value\\n        // (align=16 on i32.load) survived to fail only in the wasm\\n        // validator. Malformed WAT must be rejected HERE with a located\\n        // error: a positive power of two, at most the natural alignment.\\n        if a <= 0 || (a & (a - 1)) != 0 {\\n          throw(iw_err(fn_name, \\\"align=\\\\{a} is invalid (must be a positive power of two)\\\", Array::get(offs, p)))\\n        }\\n        let mut e = 0\\n        let mut av = a\\n        while av > 1 {\\n          e = e + 1\\n          av = av / 2\\n        }\\n        if e > default_align {\\n          throw(iw_err(fn_name, \\\"align=\\\\{a} exceeds the instruction's natural alignment (\\\\{1 << default_align})\\\", Array::get(offs, p)))\\n        }\\n        align = e\\n        p = p + 1\\n      } else {\\n        done = true\\n      }\\n    } else {\\n      done = true\\n    }\\n  }\\n  (align, offset, p)\\n}\\n\\n// Require a word token at `pos` (the immediate of the op named `opname`).\\nfn iw_want_word(fn_name: String, kinds: Array[Int], texts: Array[String], offs: Array[Int], pos: Int, end: Int, opname: String) -> String with { Error } {\\n  if pos < end && Array::get(kinds, pos) == 3 {\\n    Array::get(texts, pos)\\n  } else {\\n    let off = if pos < Array::length(offs) {\\n      Array::get(offs, pos)\\n    } else {\\n      0 - 1\\n    }\\n    throw(iw_err(fn_name, \\\"'\\\\{opname}' expects an immediate operand\\\", off))\\n  }\\n}\\n\\n// `v128.const <shape> <lane ints...>` — shape is i8x16/i16x8/i32x4/i64x2;\\n// encodes the 16-byte little-endian immediate. Returns next pos.\\nfn iw_v128_const(buf: Bytes, fn_name: String, kinds: Array[Int], texts: Array[String], offs: Array[Int], pos: Int, end: Int) -> Int with { Error } {\\n  let shape = iw_want_word(fn_name, kinds, texts, offs, pos, end, \\\"v128.const\\\")\\n  let (lane_count, lane_bytes) = match shape {\\n    \\\"i8x16\\\" => (16, 1),\\n    \\\"i16x8\\\" => (8, 2),\\n    \\\"i32x4\\\" => (4, 4),\\n    \\\"i64x2\\\" => (2, 8),\\n    _ => throw(iw_err(fn_name, \\\"v128.const shape must be i8x16/i16x8/i32x4/i64x2, got '\\\\{shape}'\\\", Array::get(offs, pos)))\\n  }\\n  bytebuf_push(buf, 0xFD)\\n  leb128_encode_u32(buf, 12)\\n  let mut p = pos + 1\\n  let mut li = 0\\n  while li < lane_count {\\n    let t = iw_want_word(fn_name, kinds, texts, offs, p, end, \\\"v128.const\\\")\\n    let v = iw_parse_int(fn_name, t, Array::get(offs, p))\\n    let mut bi = 0\\n    while bi < lane_bytes {\\n      bytebuf_push(buf, (v >> (bi * 8)) & 255)\\n      bi = bi + 1\\n    }\\n    p = p + 1\\n    li = li + 1\\n  }\\n  p\\n}\\n\\n// Emit ONE plain (non-control) instruction word at `pos` plus its immediates\\n// into `buf`. Returns the position after the instruction + immediates.\\nfn iw_plain_op(buf: Bytes, fn_name: String, kinds: Array[Int], texts: Array[String], offs: Array[Int], pos: Int, end: Int, params: Array[String], lbl_names: Array[String], lbl_depths: Array[Int], depth: Int) -> Int with { Error } {\\n  let name = Array::get(texts, pos)\\n  let off = Array::get(offs, pos)\\n  if name == \\\"block\\\" || name == \\\"loop\\\" || name == \\\"if\\\" || name == \\\"else\\\" || name == \\\"end\\\" || name == \\\"then\\\" {\\n    throw(iw_err(fn_name, \\\"structured control must use the folded form: (block ...) / (loop ...) / (if <cond> (then ...) (else ...))\\\", off))\\n  } else if name == \\\"local.get\\\" || name == \\\"local.set\\\" || name == \\\"local.tee\\\" {\\n    let opc = if name == \\\"local.get\\\" {\\n      0x20\\n    } else if name == \\\"local.set\\\" {\\n      0x21\\n    } else {\\n      0x22\\n    }\\n    let t = iw_want_word(fn_name, kinds, texts, offs, pos + 1, end, name)\\n    let idx = iw_local_idx(fn_name, params, t, Array::get(offs, pos + 1))\\n    bytebuf_push(buf, opc)\\n    leb128_encode_u32(buf, idx)\\n    pos + 2\\n  } else if name == \\\"br\\\" || name == \\\"br_if\\\" {\\n    let t = iw_want_word(fn_name, kinds, texts, offs, pos + 1, end, name)\\n    let rel = iw_label_rel(fn_name, lbl_names, lbl_depths, t, depth, Array::get(offs, pos + 1))\\n    if rel < 0 {\\n      throw(iw_err(fn_name, \\\"label '\\\\{t}' is not visible from this branch\\\", Array::get(offs, pos + 1)))\\n    } else {\\n      ()\\n    }\\n    bytebuf_push(buf, if name == \\\"br\\\" {\\n      0x0C\\n    } else {\\n      0x0D\\n    })\\n    leb128_encode_u32(buf, rel)\\n    pos + 2\\n  } else if name == \\\"i32.const\\\" {\\n    let t = iw_want_word(fn_name, kinds, texts, offs, pos + 1, end, name)\\n    let v = iw_parse_int(fn_name, t, Array::get(offs, pos + 1))\\n    bytebuf_push(buf, 0x41)\\n    leb128_encode_s32(buf, v)\\n    pos + 2\\n  } else if name == \\\"i64.const\\\" {\\n    let t = iw_want_word(fn_name, kinds, texts, offs, pos + 1, end, name)\\n    let v = iw_parse_int(fn_name, t, Array::get(offs, pos + 1))\\n    bytebuf_push(buf, 0x42)\\n    leb128_encode_s64(buf, v)\\n    pos + 2\\n  } else if name == \\\"f32.const\\\" || name == \\\"f64.const\\\" {\\n    throw(iw_err(fn_name, \\\"'\\\\{name}' is not supported in inline wasm (v0.3 slice); build the bit pattern with i64.const + f64.reinterpret_i64\\\", off))\\n  } else if name == \\\"memory.size\\\" || name == \\\"memory.grow\\\" {\\n    bytebuf_push(buf, if name == \\\"memory.size\\\" {\\n      0x3F\\n    } else {\\n      0x40\\n    })\\n    bytebuf_push(buf, 0x00)\\n    pos + 1\\n  } else if name == \\\"v128.const\\\" {\\n    iw_v128_const(buf, fn_name, kinds, texts, offs, pos + 1, end)\\n  } else if name == \\\"v128.load\\\" || name == \\\"v128.store\\\" {\\n    let (align, offset, next) = iw_memarg(fn_name, kinds, texts, offs, pos + 1, end, 4)\\n    bytebuf_push(buf, 0xFD)\\n    leb128_encode_u32(buf, if name == \\\"v128.load\\\" {\\n      0\\n    } else {\\n      11\\n    })\\n    leb128_encode_u32(buf, align)\\n    leb128_encode_u32(buf, offset)\\n    next\\n  } else if name == \\\"call\\\" || name == \\\"call_indirect\\\" || name == \\\"return_call\\\" {\\n    throw(iw_err(fn_name, \\\"'\\\\{name}' is not supported in inline wasm (v0.3 slice: bodies cannot reference other functions)\\\", off))\\n  } else if name == \\\"global.get\\\" || name == \\\"global.set\\\" {\\n    throw(iw_err(fn_name, \\\"'\\\\{name}' is not supported in inline wasm (v0.3 slice: runtime globals are not addressable)\\\", off))\\n  } else if name == \\\"br_table\\\" {\\n    throw(iw_err(fn_name, \\\"'br_table' is not supported in inline wasm (v0.3 slice)\\\", off))\\n  } else if name == \\\"local\\\" {\\n    throw(iw_err(fn_name, \\\"'(local ...)' declarations are not supported in inline wasm (v0.3 slice); use the fn's params as scratch locals\\\", off))\\n  } else {\\n    let core_opc = iw_lookup(iw_core_table(), name)\\n    if core_opc >= 0 {\\n      bytebuf_push(buf, core_opc)\\n      pos + 1\\n    } else {\\n      let lane_sub = iw_lookup(iw_simd_lane_table(), name)\\n      if lane_sub >= 0 {\\n        let t = iw_want_word(fn_name, kinds, texts, offs, pos + 1, end, name)\\n        let lane = iw_parse_int(fn_name, t, Array::get(offs, pos + 1))\\n        // Codex P2 on #933: `lane & 255` truncated out-of-range lane\\n        // indices (i8x16.extract_lane_s 16, replace_lane -1) into a wasm\\n        // file that only the validator rejects. Bound-check against the\\n        // shape's lane count for the promised located error.\\n        let lane_cnt = iw_lane_count(name)\\n        if lane < 0 || lane >= lane_cnt {\\n          throw(iw_err(fn_name, \\\"lane index \\\\{lane} is out of range for '\\\\{name}' (0..\\\\{lane_cnt - 1})\\\", Array::get(offs, pos + 1)))\\n        }\\n        bytebuf_push(buf, 0xFD)\\n        leb128_encode_u32(buf, lane_sub)\\n        bytebuf_push(buf, lane & 255)\\n        pos + 2\\n      } else {\\n        let (mem_opc, mem_align) = iw_mem_lookup(name)\\n        if mem_opc >= 0 {\\n          let (align, offset, next) = iw_memarg(fn_name, kinds, texts, offs, pos + 1, end, mem_align)\\n          bytebuf_push(buf, mem_opc)\\n          leb128_encode_u32(buf, align)\\n          leb128_encode_u32(buf, offset)\\n          next\\n        } else {\\n          let simd_sub = iw_lookup(iw_simd_table(), name)\\n          if simd_sub >= 0 {\\n            bytebuf_push(buf, 0xFD)\\n            leb128_encode_u32(buf, simd_sub)\\n            pos + 1\\n          } else {\\n            throw(iw_err(fn_name, \\\"unknown or unsupported instruction '\\\\{name}'\\\", off))\\n          }\\n        }\\n      }\\n    }\\n  }\\n}\\n\\n// One sequence item at `pos`: either a folded `(...)` expression or a plain\\n// instruction word. Returns the position after the item.\\nfn iw_item(out: Bytes, fn_name: String, kinds: Array[Int], texts: Array[String], offs: Array[Int], pos: Int, end: Int, params: Array[String], lbl_names: Array[String], lbl_depths: Array[Int], depth: Int) -> Int with { Error } {\\n  let k = Array::get(kinds, pos)\\n  if k == 3 {\\n    iw_plain_op(out, fn_name, kinds, texts, offs, pos, end, params, lbl_names, lbl_depths, depth)\\n  } else if k == 1 {\\n    if pos + 1 >= end || Array::get(kinds, pos + 1) != 3 {\\n      throw(iw_err(fn_name, \\\"expected an instruction name after '('\\\", Array::get(offs, pos)))\\n    } else {\\n      ()\\n    }\\n    let head = Array::get(texts, pos + 1)\\n    if head == \\\"block\\\" || head == \\\"loop\\\" {\\n      iw_folded_block(out, fn_name, kinds, texts, offs, pos, end, params, lbl_names, lbl_depths, depth)\\n    } else if head == \\\"if\\\" {\\n      iw_folded_if(out, fn_name, kinds, texts, offs, pos, end, params, lbl_names, lbl_depths, depth)\\n    } else if head == \\\"then\\\" || head == \\\"else\\\" || head == \\\"result\\\" {\\n      throw(iw_err(fn_name, \\\"misplaced '(\\\\{head} ...)' clause\\\", Array::get(offs, pos)))\\n    } else {\\n      iw_folded_op(out, fn_name, kinds, texts, offs, pos, end, params, lbl_names, lbl_depths, depth)\\n    }\\n  } else {\\n    throw(iw_err(fn_name, \\\"unexpected ')'\\\", Array::get(offs, pos)))\\n  }\\n}\\n\\n// A sequence of items up to (not consuming) a closing ')' or the end.\\nfn iw_seq(out: Bytes, fn_name: String, kinds: Array[Int], texts: Array[String], offs: Array[Int], pos: Int, end: Int, params: Array[String], lbl_names: Array[String], lbl_depths: Array[Int], depth: Int) -> Int with { Error } {\\n  let mut p = pos\\n  let mut done = false\\n  while !done {\\n    if p >= end {\\n      done = true\\n    } else if Array::get(kinds, p) == 2 {\\n      done = true\\n    } else {\\n      p = iw_item(out, fn_name, kinds, texts, offs, p, end, params, lbl_names, lbl_depths, depth)\\n    }\\n  }\\n  p\\n}\\n\\n// Folded `(op <immediates> <operand exprs...>)`: real folded-form semantics —\\n// the operand expressions are emitted FIRST, then the op itself.\\nfn iw_folded_op(out: Bytes, fn_name: String, kinds: Array[Int], texts: Array[String], offs: Array[Int], pos: Int, end: Int, params: Array[String], lbl_names: Array[String], lbl_depths: Array[Int], depth: Int) -> Int with { Error } {\\n  let opb = bytebuf_new()\\n  let after_imm = iw_plain_op(opb, fn_name, kinds, texts, offs, pos + 1, end, params, lbl_names, lbl_depths, depth)\\n  let mut p = after_imm\\n  let mut done = false\\n  while !done {\\n    if p >= end {\\n      throw(iw_err(fn_name, \\\"missing ')' closing folded '\\\\{Array::get(texts, pos + 1)}'\\\", Array::get(offs, pos)))\\n    } else if Array::get(kinds, p) == 2 {\\n      done = true\\n    } else if Array::get(kinds, p) == 1 {\\n      p = iw_item(out, fn_name, kinds, texts, offs, p, end, params, lbl_names, lbl_depths, depth)\\n    } else {\\n      throw(iw_err(fn_name, \\\"unexpected '\\\\{Array::get(texts, p)}' inside folded '\\\\{Array::get(texts, pos + 1)}' — operands must be parenthesized\\\", Array::get(offs, p)))\\n    }\\n  }\\n  bytebuf_push_buf(out, opb)\\n  p + 1\\n}\\n\\n// Folded `(block $l? (result T)? ...)` / `(loop $l? (result T)? ...)`.\\nfn iw_folded_block(out: Bytes, fn_name: String, kinds: Array[Int], texts: Array[String], offs: Array[Int], pos: Int, end: Int, params: Array[String], lbl_names: Array[String], lbl_depths: Array[Int], depth: Int) -> Int with { Error } {\\n  let head = Array::get(texts, pos + 1)\\n  bytebuf_push(out, if head == \\\"loop\\\" {\\n    0x03\\n  } else {\\n    0x02\\n  })\\n  let lbl_mark = Array::length(lbl_names)\\n  let mut q = pos + 2\\n  if q < end && Array::get(kinds, q) == 3 && String::length(Array::get(texts, q)) > 0 && String::char_code_at(Array::get(texts, q), 0) == '$' {\\n    Array::push(lbl_names, Array::get(texts, q))\\n    Array::push(lbl_depths, depth)\\n    q = q + 1\\n  } else {\\n    ()\\n  }\\n  let (bt, after_bt) = iw_blocktype(fn_name, kinds, texts, offs, q, end)\\n  bytebuf_push(out, bt)\\n  let bq = iw_seq(out, fn_name, kinds, texts, offs, after_bt, end, params, lbl_names, lbl_depths, depth + 1)\\n  if bq >= end || Array::get(kinds, bq) != 2 {\\n    throw(iw_err(fn_name, \\\"missing ')' closing '\\\\{head}'\\\", Array::get(offs, pos)))\\n  } else {\\n    ()\\n  }\\n  bytebuf_push(out, 0x0B)\\n  Array::truncate(lbl_names, lbl_mark)\\n  Array::truncate(lbl_depths, lbl_mark)\\n  bq + 1\\n}\\n\\n// Folded `(if $l? (result T)? <cond exprs...> (then ...) (else ...)?)`.\\n// The condition is emitted first, then 0x04 + blocktype, then the branches.\\nfn iw_folded_if(out: Bytes, fn_name: String, kinds: Array[Int], texts: Array[String], offs: Array[Int], pos: Int, end: Int, params: Array[String], lbl_names: Array[String], lbl_depths: Array[Int], depth: Int) -> Int with { Error } {\\n  let lbl_mark = Array::length(lbl_names)\\n  let mut q = pos + 2\\n  if q < end && Array::get(kinds, q) == 3 && String::length(Array::get(texts, q)) > 0 && String::char_code_at(Array::get(texts, q), 0) == '$' {\\n    Array::push(lbl_names, Array::get(texts, q))\\n    Array::push(lbl_depths, depth)\\n    q = q + 1\\n  } else {\\n    ()\\n  }\\n  let (bt, after_bt) = iw_blocktype(fn_name, kinds, texts, offs, q, end)\\n  // condition: folded expressions until the '(then ...)' clause\\n  let mut p = after_bt\\n  let mut cond_done = false\\n  while !cond_done {\\n    if p >= end {\\n      throw(iw_err(fn_name, \\\"missing '(then ...)' clause in folded 'if'\\\", Array::get(offs, pos)))\\n    } else if Array::get(kinds, p) == 1 && p + 1 < end && Array::get(kinds, p + 1) == 3 && Array::get(texts, p + 1) == \\\"then\\\" {\\n      cond_done = true\\n    } else if Array::get(kinds, p) == 1 {\\n      p = iw_item(out, fn_name, kinds, texts, offs, p, end, params, lbl_names, lbl_depths, depth)\\n    } else {\\n      throw(iw_err(fn_name, \\\"unexpected token in folded 'if' condition (condition operands must be parenthesized)\\\", Array::get(offs, p)))\\n    }\\n  }\\n  bytebuf_push(out, 0x04)\\n  bytebuf_push(out, bt)\\n  // then branch: p is at '(' of (then ...)\\n  let tq = iw_seq(out, fn_name, kinds, texts, offs, p + 2, end, params, lbl_names, lbl_depths, depth + 1)\\n  if tq >= end || Array::get(kinds, tq) != 2 {\\n    throw(iw_err(fn_name, \\\"missing ')' closing '(then ...)'\\\", Array::get(offs, p)))\\n  } else {\\n    ()\\n  }\\n  let mut r = tq + 1\\n  if r + 1 < end && Array::get(kinds, r) == 1 && Array::get(kinds, r + 1) == 3 && Array::get(texts, r + 1) == \\\"else\\\" {\\n    bytebuf_push(out, 0x05)\\n    let eq = iw_seq(out, fn_name, kinds, texts, offs, r + 2, end, params, lbl_names, lbl_depths, depth + 1)\\n    if eq >= end || Array::get(kinds, eq) != 2 {\\n      throw(iw_err(fn_name, \\\"missing ')' closing '(else ...)'\\\", Array::get(offs, r)))\\n    } else {\\n      ()\\n    }\\n    r = eq + 1\\n  } else {\\n    ()\\n  }\\n  if r >= end || Array::get(kinds, r) != 2 {\\n    throw(iw_err(fn_name, \\\"missing ')' closing folded 'if'\\\", Array::get(offs, pos)))\\n  } else {\\n    ()\\n  }\\n  bytebuf_push(out, 0x0B)\\n  Array::truncate(lbl_names, lbl_mark)\\n  Array::truncate(lbl_depths, lbl_mark)\\n  r + 1\\n}\\n\\n// Entry: compile one inline-wasm fn body's WAT text to raw instruction bytes.\\n// `param_names` are the fn's declared params in order (wasm locals 0..n-1 on\\n// the linear backend; every param and the result are RAW 62-bit tagged i64\\n// values — ADR-0055/ADR-0072 — the WAT author untags/retags explicitly).\\nexport fn compile_inline_wat(fn_name: String, wat: String, param_names: Array[String]) -> Bytes with { Error } {\\n  let (kinds, texts, offs) = iw_tokenize(fn_name, wat)\\n  let out = bytebuf_new()\\n  let lbl_names = iw_fresh_strings()\\n  let lbl_depths = iw_fresh_ints()\\n  let end = Array::length(kinds)\\n  if end == 0 {\\n    throw(iw_err(fn_name, \\\"empty inline wasm body\\\", 0))\\n  } else {\\n    ()\\n  }\\n  let final_pos = iw_seq(out, fn_name, kinds, texts, offs, 0, end, param_names, lbl_names, lbl_depths, 0)\\n  if final_pos != end {\\n    throw(iw_err(fn_name, \\\"unbalanced ')'\\\", Array::get(offs, final_pos)))\\n  } else {\\n    ()\\n  }\\n  out\\n}\\n\\n//# Misc\\n\\nexport {\\n  compile_inline_wat\\n}\\n\")\n}\n\nlet cli_adapter_source_88 = () -> (String, String) {\n  (\"lib/@vibe/compiler/codegen/wasi/linked_helpers.vibe\",\n\"//# Imports\\n\\nimport ../../builtin_name.vibe {\\n  canonical_builtin_name\\n}\\n\\nimport ../../core {\\n  Expr, Stmt,\\n  sorted_names_of\\n}\\n\\nimport ../common_analysis {\\n  collect_free_vars, collect_free_vars_indexed\\n}\\n\\nimport ../common_extractors {\\n  array_contains_str\\n}\\n\\n//# Functions\\n\\nfn expr_uses_builtin(expr: Expr, fn_names: Array[String], target: String) -> Bool {\\n  let free_vars = collect_free_vars(expr, Array::slice([\\n    \\\"\\\"\\n  ], 0, 0), fn_names)\\n  let normalized_target = canonical_builtin_name(target)\\n  let mut i = 0\\n  let mut found = false\\n  while i < Array::length(free_vars) && !found {\\n    found = canonical_builtin_name(Array::get(free_vars, i)) == normalized_target\\n    i = i + 1\\n  }\\n  found\\n}\\n\\nexport fn stmts_use_builtin(stmts: Array[Stmt], fn_names: Array[String], target: String) -> Bool {\\n  let mut i = 0\\n  let mut found = false\\n  while i < Array::length(stmts) && !found {\\n    found = match Array::get(stmts, i) {\\n      SLet(_, _, _, _, expr) => expr_uses_builtin(expr, fn_names, target),\\n      SLetMut(_, _, expr) => expr_uses_builtin(expr, fn_names, target),\\n      STest(_, expr) => expr_uses_builtin(expr, fn_names, target),\\n      SBench(_, expr) => expr_uses_builtin(expr, fn_names, target),\\n      SExpr(expr) => expr_uses_builtin(expr, fn_names, target),\\n      SModule(_, _, inner) => stmts_use_builtin(inner, fn_names, target),\\n      _ => false\\n    }\\n    i = i + 1\\n  }\\n  found\\n}\\n\\n// #799 perf: ONE walk over the whole program collecting every free name's\\n// canonical builtin form into a set. linked_compile's ~40 need_<builtin>\\n// flags used to each call stmts_use_builtin -- a full-AST walk per flag,\\n// with a linear fn_names scan per ident inside -- which was a top entry in\\n// compiler-closure compile profiles. Same semantics: a name counts as \\\"used\\\"\\n// only where it is FREE (not a user fn, not locally bound), and the flag\\n// reads compare canonical names exactly like expr_uses_builtin did.\\nfn push_free_canonical(expr: Expr, fn_name_index: Array[String], sink: Array[(String, Bool)]) -> Unit {\\n  let fvs = collect_free_vars_indexed(expr, Array::slice([\\n    \\\"\\\"\\n  ], 0, 0), fn_name_index)\\n  let mut j = 0\\n  while j < Array::length(fvs) {\\n    Array::push(sink, (canonical_builtin_name(Array::get(fvs, j)), true))\\n    j = j + 1\\n  }\\n}\\n\\nexport fn collect_used_builtin_names_into(stmts: Array[Stmt], fn_names: Array[String], fn_name_index: Array[String], sink: Array[(String, Bool)]) -> Unit {\\n  let mut i = 0\\n  while i < Array::length(stmts) {\\n    match Array::get(stmts, i) {\\n      SLet(_, _, _, _, expr) => push_free_canonical(expr, fn_name_index, sink),\\n      SLetMut(_, _, expr) => push_free_canonical(expr, fn_name_index, sink),\\n      STest(_, expr) => push_free_canonical(expr, fn_name_index, sink),\\n      SBench(_, expr) => push_free_canonical(expr, fn_name_index, sink),\\n      SExpr(expr) => push_free_canonical(expr, fn_name_index, sink),\\n      SModule(_, _, inner) => collect_used_builtin_names_into(inner, fn_names, fn_name_index, sink),\\n      _ => ()\\n    }\\n    i = i + 1\\n  }\\n}\\n\\n\\nexport fn collect_used_builtin_names(stmts: Array[Stmt], fn_names: Array[String]) -> Map[String, Bool] {\\n  // Sorted membership index (see core/sorted_index.vibe) -- the MapBuilder\\n  // version was O(N^2) to build and O(N) per lookup.\\n  let fn_name_index = sorted_names_of(fn_names)\\n  let sink = Array::slice([\\n    (\\\"\\\", false)\\n  ], 0, 0)\\n  collect_used_builtin_names_into(stmts, fn_names, fn_name_index, sink)\\n  let set_b = MapBuilder::new()\\n  let mut k = 0\\n  while k < Array::length(sink) {\\n    let (nm, _) = Array::get(sink, k)\\n    MapBuilder::set(set_b, nm, true)\\n    k = k + 1\\n  }\\n  MapBuilder::freeze(set_b)\\n}\\n\")\n}\n\nlet cli_adapter_source_89 = () -> (String, String) {\n  (\"lib/@vibe/compiler/codegen/wasi/linked_compile.vibe\",\n\"//# Imports\\n\\nimport ../../core {\\n  Expr, Pat, Stmt, TypeExpr, bytebuf_length, bytebuf_new, bytebuf_push, bytebuf_push_buf, bytebuf_push_section, bytebuf_push_vec_header, bytebuf_to_bytes, leb128_encode_s64, leb128_encode_u32, rewrite_top_level_fn_alias_refs, sorted_names_of\\n}\\n\\nimport ../../desugar_trait_dict.vibe {\\n  desugar_trait_dicts\\n}\\n\\nimport ../../normalize {\\n  lift_match_scrutinees, uniquify_shadowed_bindings\\n}\\n\\nimport ../../perceus {\\n  PerceusAction, build_perceus_plan, build_perceus_plan_with_params, compute_borrow_returning_names, compute_heap_returning, compute_scalar_returning_names, elaborate_heap_params, pa_is_alias_dup, pa_is_drop, pa_is_dup, param_is_heap_in_body\\n}\\n\\nimport ../builtin_bodies {\\n  gen_arr_concat_body, gen_arr_get_body, gen_arr_len_body, gen_arr_new_body, gen_arr_push_all_body, gen_arr_push_body, gen_arr_set_body, gen_arr_slice_body, gen_arr_truncate_body, gen_bytes_append_body, gen_bytes_concat_body, gen_bytes_from_array_body, gen_bytes_get_body, gen_bytes_len_body, gen_bytes_new_body, gen_bytes_push_body, gen_bytes_set_body, gen_bytes_slice_body, gen_bytes_to_array_body, gen_eq_body, gen_rc_alloc_body, gen_rc_drop_body, gen_selfhost_sources_proper_body, gen_selfhost_sources_stub_body, gen_simd_scan_alnum_body, gen_simd_skip_ws_body, gen_str_char_code_at_body, gen_str_concat_body, gen_str_eq_body, gen_str_lex_diff_body, gen_str_from_char_code_body, gen_str_len_body, gen_str_substring_body, gen_string_contains_body, gen_string_ends_with_body, gen_string_index_of_body, gen_string_join_body, gen_string_last_index_of_body, gen_string_split_body, gen_string_starts_with_body, gen_string_trim_body, static_arr_get_body, static_arr_len_body, static_arr_set_body, static_arr_truncate_body, static_double_to_int_body, static_fs_stub_body, static_fs_write_bytes_stub_body, static_identity_body, static_int_to_double_body, static_print_i64_body, static_print_str_body, static_str_char_code_at_body, static_str_eq_body, static_str_len_body\\n}\\n\\nimport ../builtin_registry.vibe {\\n  builtin_registry, verify_lane_builtins\\n}\\n\\nimport ../inline_wat.vibe {\\n  compile_inline_wat\\n}\\n\\nimport ../common_analysis {\\n  collect_free_vars, collect_strings_stmts, emit_closure_call_tail, emit_closure_resolve, emit_i64_extend_i32_u, is_mut_captured_in, scope_tail_proj_root, stmts_contain_exceptions\\n}\\n\\nimport ../common_base {\\n  rc_shadow_reserve,\\n  CompileCtx, CovState, CtorTable, DbgProv, FuncTable, LambdaTable, StrTable, agg_info_of_type_expr, compute_agg_returning, ctor_sorted_index, emit_rc_dup_guarded, empty_dbg_prov, emit_binop_op, emit_i32_eq, emit_i32_eqz, emit_i32_ge_u, emit_i32_mul, emit_i32_ne, emit_i32_sub, emit_i64_load, emit_i64_store, emit_str_ref, expr_tag, fn_type_param_types, get_arm_body, get_arm_pat, get_ebinop_op, get_efn_body, get_eif_cond, get_eif_else, get_eif_then, get_elet_body, get_elet_name, get_elet_val, get_slet_expr, get_slet_name, get_slet_type, is_efn, is_eident, is_etuple, is_pbind, is_pbool, is_pctor, is_pint, is_pstring, is_ptuple, is_pwild, is_slet, lookup_ctor, resolve_func, resolve_local\\n}\\n\\nimport ../common_extractors {\\n  array_contains_str, build_newline_offsets, emit_assignop_op, emit_memory_copy, find_catchall_idx, get_earray_elems, get_eassign_body, get_eassign_name, get_eassign_val, get_eassignop_body, get_eassignop_name, get_eassignop_op, get_eassignop_val, get_ebinop_lhs, get_ebinop_rhs, get_ebool_value, get_ecall_args, get_ecall_callee, get_efloat_value, get_efn_params, get_eforin_body, get_eforin_iter, get_eforin_name, get_eident_name, get_eint_value, get_eletmut_body, get_eletmut_name, get_eletmut_val, get_eletrec_body, get_eletrec_name, get_eletrec_val, get_eseq_first, get_eseq_second, get_estring_value, get_etuple_elems, get_eunaryop_expr, get_eunaryop_op, get_ewhile_body, get_ewhile_cond, get_match_arms, get_match_scrutinee, get_pbind_name, get_pbool_value, get_pctor_args, get_pctor_name, get_pint_value, get_pstring_value, get_ptuple_pats, get_slet_export, str_table_lookup\\n}\\n\\nimport ../expr {\\n  compile_expr\\n}\\n\\nimport ../wasm_emit {\\n  emit_block_i64, emit_block_void, emit_br, emit_br_if, emit_call, emit_call_indirect, emit_code_section, emit_code_section_with_locals, emit_data_section, emit_data_section_multi, emit_drop, emit_element_section_active, emit_else, emit_end, emit_export_section, emit_export_section_multi, emit_exports_full, emit_exports_with_memory, emit_f64_add, emit_f64_const_bits, emit_f64_convert_i64_s, emit_f64_div, emit_f64_eq, emit_f64_ge, emit_f64_gt, emit_f64_le, emit_f64_lt, emit_f64_mul, emit_f64_ne, emit_f64_neg, emit_f64_reinterpret_i64, emit_f64_sub, emit_func_type_raw, emit_function_section, emit_global_get, emit_global_section_i32_mut, emit_global_set, emit_header, emit_heap_memory_grow_check, emit_i32_add, emit_i32_const, emit_i32_load, emit_i32_load8_u, emit_i32_store, emit_i32_store8, emit_i64_store, emit_i32_wrap_i64, emit_i64_add, emit_i64_and, emit_i64_const, emit_i64_div_s, emit_i64_eq, emit_i64_eqz, emit_i64_extend_i32_s, emit_i64_ge_s, emit_i64_gt_s, emit_i64_le_s, emit_i64_lt_s, emit_i64_mul, emit_i64_ne, emit_i64_or, emit_i64_reinterpret_f64, emit_i64_rem_s, emit_i64_shl, emit_i64_shr_s, emit_i64_sub, emit_i64_trunc_f64_s, emit_i64_xor, emit_if_i64, emit_if_void, emit_import_section_func, emit_local_get, emit_local_set, emit_local_tee, emit_loop_void, emit_memory_section, emit_name, emit_return, emit_table_section_funcref, emit_type_section, emit_type_section_multi, emit_vibe_abi_custom_section, emit_function_name_section, string_to_data\\n}\\n\\nimport ./linked_helpers.vibe {\\n  stmts_use_builtin, collect_used_builtin_names\\n}\\n\\n//# Functions\\n\\nlet wasm_page_size = 65536\\n\\nfn lc_fresh_int_array() -> Array[Int] {\\n  ArrayBuilder::freeze(ArrayBuilder::new())\\n}\\n\\nfn lc_fresh_bool_array() -> Array[Bool] {\\n  ArrayBuilder::freeze(ArrayBuilder::new())\\n}\\n\\nfn lc_fresh_bytes_array() -> Array[Bytes] {\\n  ArrayBuilder::freeze(ArrayBuilder::new())\\n}\\n\\nfn lc_fresh_string_array() -> Array[String] {\\n  ArrayBuilder::freeze(ArrayBuilder::new())\\n}\\n\\nfn lc_fresh_expr_array() -> Array[Expr] {\\n  ArrayBuilder::freeze(ArrayBuilder::new())\\n}\\n\\n\\nfn lc_fresh_string_matrix() -> Array[Array[String]] {\\n  ArrayBuilder::freeze(ArrayBuilder::new())\\n}\\n\\nfn gen_heap_grow_check_body() -> Bytes {\\n  let b = bytebuf_new()\\n  emit_heap_memory_grow_check(b)\\n  b\\n}\\n\\n// #805 (ADR-0072): collect the inline-wasm fns (`fn f(..) -> Int = wasm\\n// \\\"...\\\"`, carried as the parser-internal `%wasm(\\\"<WAT>\\\")` marker body) into\\n// parallel name/WAT-text arrays and REPLACE each marker body with a neutral\\n// EInt(0) IN PLACE — so every downstream analysis (Perceus plans, borrow/\\n// scalar-return classification, string-table collection, coverage) sees an\\n// ordinary trivial body and the WAT text never leaks into the data section.\\n// The per-fn codegen loop then splices the assembled instruction bytes\\n// (compile_inline_wat) instead of running compile_expr for these names.\\nfn lc_extract_inline_wasm(stmts: Array[Stmt], names: Array[String], wats: Array[String]) -> Unit {\\n  let mut i = 0\\n  while i < Array::length(stmts) {\\n    match Array::get(stmts, i) {\\n      SLet(iw_exp, iw_rec, iw_name, iw_ann, iw_expr) => match iw_expr {\\n        EFn(iw_tps, iw_tbs, iw_params, iw_ret, iw_eff, iw_body) => match iw_body {\\n          ECall(iw_cal, iw_args, _) => match iw_cal {\\n            EIdent(iw_cn, _) => if iw_cn == \\\"%wasm\\\" && Array::length(iw_args) == 1 {\\n              match Array::get(iw_args, 0) {\\n                EString(iw_wat) => {\\n                  Array::push(names, iw_name)\\n                  Array::push(wats, iw_wat)\\n                  Array::set(stmts, i, SLet(iw_exp, iw_rec, iw_name, iw_ann, EFn(iw_tps, iw_tbs, iw_params, iw_ret, iw_eff, EInt(0))))\\n                },\\n                _ => ()\\n              }\\n            } else {\\n              ()\\n            },\\n            _ => ()\\n          },\\n          _ => ()\\n        },\\n        _ => ()\\n      },\\n      _ => ()\\n    }\\n    i = i + 1\\n  }\\n}\\n\\nlet default_wasi_memory_min_pages = 64\\n\\nexport fn wasi_memory_min_pages_for_heap(heap_start: Int) -> Int {\\n  let needed_pages = (heap_start + wasm_page_size - 1) / wasm_page_size\\n  if needed_pages > default_wasi_memory_min_pages {\\n    needed_pages\\n  } else {\\n    default_wasi_memory_min_pages\\n  }\\n}\\n\\n// ADR-0069: `Unit` in a declared return position — either the canonical\\n// TyUnit (`-> ()`) or the named spelling (`-> Unit`, what parse_type produces\\n// and what the `fn main {}` desugar emits).\\nfn linked_type_expr_is_unit(t: TypeExpr) -> Bool {\\n  match t {\\n    TyUnit => true,\\n    TyName(n) => n == \\\"Unit\\\",\\n    _ => false\\n  }\\n}\\n\\nexport fn compile_wasi_module_linked_impl(stmts: Array[Stmt], entry_name: String, selfhost_srcs: Array[(String, String)], linked_imports: Array[(String, String, Int, Int)], library_mode: Bool, enable_rc: Bool, coverage: Bool, debug_trace: Bool, debug_break: Bool, rc_shadow: Bool, prov: DbgProv) -> Bytes with { Error } {\\n  // Method-bearing-trait dictionary passing (#641 PR-3). Universal codegen\\n  // convergence point — runs here on the fully merged program before generic\\n  // type params are stripped (just below). No-op unless a method-bearing trait\\n  // is declared, and idempotent if an earlier pipeline stage already desugared.\\n  desugar_trait_dicts(stmts)\\n  // Top-level `let f = g` function aliases: retarget references to the final\\n  // EFn def so calls do not route through the 0-param thunk registration\\n  // below (invalid wasm for any call arity). See import_alias_rewrite.vibe.\\n  rewrite_top_level_fn_alias_refs(stmts)\\n  // #805: inline-wasm fns — extract WAT texts + neutralize marker bodies\\n  // BEFORE any analysis below (see lc_extract_inline_wasm's doc comment).\\n  let iw_names = lc_fresh_string_array()\\n  let iw_wats = lc_fresh_string_array()\\n  lc_extract_inline_wasm(stmts, iw_names, iw_wats)\\n  // #707: functions whose entire body is transitively a tail-call to a\\n  // borrow-returning builtin (Array::get/Map::get/__index) -- e.g. a thin\\n  // `peek(toks, pos) -> Array::get(toks, pos)` wrapper. Computed once over the\\n  // whole merged program and threaded into every function's Perceus plan so a\\n  // `let v = peek(...)` binding (including the match-scrutinee-lift's\\n  // `let __m_scrut = peek(...)`, see normalize/index.vibe) is recognized the\\n  // same as a direct `let v = Array::get(...)` one.\\n  let lc_borrow_ret_names = compute_borrow_returning_names(stmts)\\n  // #710: see CompileCtx.scalar_ret_names' doc comment (common_base/index.vibe).\\n  let lc_scalar_ret_names = compute_scalar_returning_names(stmts)\\n  let fn_names_list = lc_fresh_string_array()\\n  let fn_param_counts = lc_fresh_int_array()\\n  let fn_needs_env_list = lc_fresh_bool_array()\\n  let fn_stmt_indices = lc_fresh_int_array()\\n  let thunk_names_list = lc_fresh_string_array()\\n  let const_int_names_list = lc_fresh_string_array()\\n  let const_int_values_list = lc_fresh_int_array()\\n  let export_fn_names = lc_fresh_string_array()\\n  let export_fn_user_indices = lc_fresh_int_array()\\n  let test_fn_names = lc_fresh_string_array()\\n  let empty_tp = Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n  let empty_bounds = Array::slice([\\n    (\\\"\\\", Array::slice([\\n      \\\"\\\"\\n    ], 0, 0))\\n  ], 0, 0)\\n  let empty_params = Array::slice([\\n    (\\\"\\\", None)\\n  ], 0, 0)\\n  let mut pi = 0\\n  while pi < Array::length(stmts) {\\n    match Array::get(stmts, pi) {\\n      STest(tname, tbody) => {\\n        let test_fn = String::concat(\\\"__test_\\\", tname)\\n        Array::push(test_fn_names, test_fn)\\n        Array::set(stmts, pi, SLet(false, false, test_fn, None, EFn(empty_tp, empty_bounds, empty_params, None, None, ESeq(tbody, EInt(0)))))\\n      },\\n      SBench(bname, bbody) => {\\n        let bench_fn = String::concat(\\\"__bench_\\\", bname)\\n        Array::push(test_fn_names, bench_fn)\\n        Array::set(stmts, pi, SLet(false, false, bench_fn, None, EFn(empty_tp, empty_bounds, empty_params, None, None, ESeq(bbody, EInt(0)))))\\n      },\\n      SLet(sl_exp, sl_rec, sl_name, sl_ann, sl_expr) => match sl_expr {\\n        EFn(tparams, _, params, ret, eff, body) => if Array::length(tparams) > 0 {\\n          Array::set(stmts, pi, SLet(sl_exp, sl_rec, sl_name, sl_ann, EFn(empty_tp, empty_bounds, params, ret, eff, body)))\\n        }\\n        ,\\n        _ => ()\\n      },\\n      _ => ()\\n    }\\n    pi = pi + 1\\n  }\\n  if Array::length(test_fn_names) > 0 {\\n    let mut has_entry = false\\n    let mut ei = 0\\n    while ei < Array::length(stmts) {\\n      match Array::get(stmts, ei) {\\n        SLet(is_exp, _, name, _, _) => if is_exp && name == entry_name {\\n          has_entry = true\\n        },\\n        _ => ()\\n      }\\n      ei = ei + 1\\n    }\\n    if !has_entry {\\n      ()\\n    }\\n  }\\n  let mut i = 0\\n  while i < Array::length(stmts) {\\n    let stmt = Array::get(stmts, i)\\n    if is_slet(stmt) {\\n      let name = get_slet_name(stmt)\\n      let expr = get_slet_expr(stmt)\\n      let is_export = get_slet_export(stmt)\\n      let user_idx = Array::length(fn_names_list)\\n      // #715: `expr_tag(expr)` hoisted out of the `else` branch below and\\n      // computed here, unconditionally -- so it (like `is_efn(expr)` above)\\n      // contributes to `expr`'s always-consumed prefix instead of only being\\n      // paid for on the `else` path. This alone still leaves the `else`\\n      // branch's own nested if asymmetric (`get_eint_value`=1 use vs the\\n      // thunk fallback's 0), so the thunk fallback below also aliases `expr`\\n      // once (`let __sf_thunk_expr = expr`) to match. With both asymmetries\\n      // resolved, `then` and `else` each consume `expr` the same number of\\n      // times, so pc_emit's EIf MIN-merge (#705) lands on the SAME remaining\\n      // count regardless of which branch a given statement actually takes --\\n      // previously the merge could permanently assume more consumption than\\n      // a commonly-taken branch (int-constant or thunk statements, which are\\n      // NOT rare like a false `is_efn` check on a real function body) really\\n      // performed, skipping the loop-body scope-end drop and leaking `expr`\\n      // (a heap Expr node) on every such statement.\\n      let __sf_etag = expr_tag(expr)\\n      if is_efn(expr) {\\n        let params = get_efn_params(expr)\\n        Array::push(fn_names_list, name)\\n        Array::push(fn_param_counts, Array::length(params))\\n        Array::push(fn_needs_env_list, true)\\n        Array::push(fn_stmt_indices, i)\\n      } else {\\n        if (__sf_etag == 0) && !is_export {\\n          Array::push(const_int_names_list, name)\\n          Array::push(const_int_values_list, get_eint_value(expr))\\n        } else {\\n          let __sf_thunk_expr = expr\\n          Array::push(fn_names_list, name)\\n          Array::push(fn_param_counts, 0)\\n          Array::push(fn_needs_env_list, true)\\n          Array::push(fn_stmt_indices, i)\\n          Array::push(thunk_names_list, name)\\n        }\\n      }\\n      if is_export || library_mode {\\n        Array::push(export_fn_names, name)\\n        Array::push(export_fn_user_indices, user_idx)\\n      }\\n    }\\n    i = i + 1\\n  }\\n  let ctor_names_list = lc_fresh_string_array()\\n  Array::push(ctor_names_list, \\\"None\\\")\\n  Array::push(ctor_names_list, \\\"Some\\\")\\n  let ctor_tags_list = lc_fresh_int_array()\\n  Array::push(ctor_tags_list, 0)\\n  Array::push(ctor_tags_list, 1)\\n  let ctor_field_counts_list = lc_fresh_int_array()\\n  Array::push(ctor_field_counts_list, 0)\\n  Array::push(ctor_field_counts_list, 1)\\n  let ctor_type_names_list = lc_fresh_string_array()\\n  Array::push(ctor_type_names_list, \\\"Option\\\")\\n  Array::push(ctor_type_names_list, \\\"Option\\\")\\n  let mut type_index = 1\\n  let mut ei2 = 0\\n  while ei2 < Array::length(stmts) {\\n    match Array::get(stmts, ei2) {\\n      SEnum(_, ename, _, variants, _) => {\\n        type_index = type_index + 1\\n        let mut vi = 0\\n        while vi < Array::length(variants) {\\n          let (vname, vfields) = Array::get(variants, vi)\\n          Array::push(ctor_names_list, vname)\\n          Array::push(ctor_tags_list, (type_index<<16)|vi)\\n          Array::push(ctor_field_counts_list, Array::length(vfields))\\n          Array::push(ctor_type_names_list, ename)\\n          vi = vi + 1\\n        }\\n        0\\n      },\\n      SStruct(_, sname, sfields, _, _, _) => {\\n        type_index = type_index + 1\\n        Array::push(ctor_names_list, sname)\\n        Array::push(ctor_tags_list, type_index<<16)\\n        Array::push(ctor_field_counts_list, Array::length(sfields))\\n        Array::push(ctor_type_names_list, sname)\\n        0\\n      },\\n      SSuberror(_, ename, variants) => {\\n        // #786: a suberror is a single-typed enum whose constructors produce a\\n        // throwable value; register its ctors in the ctor table like an enum's\\n        // so `KeyInvalid(\\\"x\\\")` allocates a tagged value instead of resolving to\\n        // an undefined name at codegen.\\n        type_index = type_index + 1\\n        let mut vi = 0\\n        while vi < Array::length(variants) {\\n          let (vname, vfields) = Array::get(variants, vi)\\n          Array::push(ctor_names_list, vname)\\n          Array::push(ctor_tags_list, (type_index<<16)|vi)\\n          Array::push(ctor_field_counts_list, Array::length(vfields))\\n          Array::push(ctor_type_names_list, ename)\\n          vi = vi + 1\\n        }\\n        0\\n      },\\n      _ => 0\\n    }\\n    ei2 = ei2 + 1\\n  }\\n  let struct_names = lc_fresh_string_array()\\n  let struct_field_names = lc_fresh_string_matrix()\\n  let mut si = 0\\n  while si < Array::length(stmts) {\\n    match Array::get(stmts, si) {\\n      SStruct(_, sname, sfields, _, _, _) => {\\n        Array::push(struct_names, sname)\\n        let fnames = lc_fresh_string_array()\\n        let mut sfi = 0\\n        while sfi < Array::length(sfields) {\\n          let (fname, _) = Array::get(sfields, sfi)\\n          Array::push(fnames, fname)\\n          sfi = sfi + 1\\n        }\\n        Array::push(struct_field_names, fnames)\\n        ()\\n      },\\n      _ => ()\\n    }\\n    si = si + 1\\n  }\\n  // Sorted ctor-name index (see CtorTable.names_sorted): built once here,\\n  // shared by this table literal and every per-function ctor_table below.\\n  let (lc_ctor_names_sorted, lc_ctor_names_sorted_pos) = ctor_sorted_index(ctor_names_list)\\n  // #724 round 2: (fn name -> declared aggregate return shape) table so\\n  // `let a = f(..)` bindings participate in structural `==` (see\\n  // compute_agg_returning in common_base).\\n  let lc_agg_ret_names = lc_fresh_string_array()\\n  let lc_agg_ret_infos = lc_fresh_int_array()\\n  compute_agg_returning(stmts, CtorTable::{\\n    names: ctor_names_list, tags: ctor_tags_list, field_counts: ctor_field_counts_list, type_names: ctor_type_names_list, struct_names: struct_names, struct_field_names: struct_field_names, names_sorted: lc_ctor_names_sorted, names_sorted_pos: lc_ctor_names_sorted_pos\\n  }, lc_agg_ret_names, lc_agg_ret_infos)\\n  // #791: program-wide (fn name) set for declared-heap-returning top-level\\n  // functions (see compute_heap_returning in perceus/index.vibe). Consulted\\n  // by classify_let_value_heap (compile_expr_tail.vibe) to classify\\n  // `let`/`let mut` bindings whose value is a call by the CALLEE's own\\n  // declared signature, instead of always over-approximating every call as\\n  // heap.\\n  let lc_heap_ret_names = compute_heap_returning(stmts)\\n  let num_user_funcs = Array::length(fn_names_list)\\n  if num_user_funcs == 0 {\\n    throw(\\\"no functions found to compile\\\")\\n  }\\n  let mut entry_user_idx = -1\\n  let mut ei = 0\\n  while ei < num_user_funcs {\\n    if Array::get(fn_names_list, ei) == entry_name {\\n      entry_user_idx = ei\\n    }\\n    ei = ei + 1\\n  }\\n  // ADR-0069 Phase 1: a missing entry is a compile error. Historically ANY\\n  // unknown entry name fell through to the test-runner `_start` synthesis, so\\n  // an entry typo silently produced a no-op module. Only the explicit\\n  // `__no_entry__` sentinel (vibe test / bench) may synthesize the test runner\\n  // now. Library mode passes a synthetic entry name it never calls, so it is\\n  // exempt.\\n  if entry_user_idx < 0 && !library_mode && entry_name != \\\"__no_entry__\\\" {\\n    throw(\\\"entry `\\\\{entry_name}` not found: no exported function named `\\\\{entry_name}` (use __no_entry__ to build a test runner)\\\")\\n  }\\n  let str_strs = collect_strings_stmts(stmts)\\n  let rec add_map_keys_expr: (Expr) -> Unit = (e) -> {\\n    match e {\\n      EMap(fields) => {\\n        let mut mi = 0\\n        while mi < Array::length(fields) {\\n          let (key, val) = Array::get(fields, mi)\\n          if !array_contains_str(str_strs, key) {\\n            Array::push(str_strs, key)\\n          }\\n          add_map_keys_expr(val)\\n          mi = mi + 1\\n        }\\n      },\\n      EStringInterp(parts) => {\\n        let mut pi3 = 0\\n        while pi3 < Array::length(parts) {\\n          if pi3 % 2 == 0 {\\n            let part = Array::get(parts, pi3)\\n            if String::length(part) > 0 && !array_contains_str(str_strs, part) {\\n              Array::push(str_strs, part)\\n            }\\n          }\\n          pi3 = pi3 + 1\\n        }\\n      },\\n      ELet(_, val, body, _) => {\\n        add_map_keys_expr(val); add_map_keys_expr(body)\\n      },\\n      ELetMut(_, val, body, _) => {\\n        add_map_keys_expr(val); add_map_keys_expr(body)\\n      },\\n      ELetRec(_, val, body) => {\\n        add_map_keys_expr(val); add_map_keys_expr(body)\\n      },\\n      ESeq(a, b) => {\\n        add_map_keys_expr(a); add_map_keys_expr(b)\\n      },\\n      EIf(c, t, e) => {\\n        add_map_keys_expr(c); add_map_keys_expr(t); add_map_keys_expr(e)\\n      },\\n      EFn(_, _, _, _, _, body) => add_map_keys_expr(body),\\n      EHandle(body, _) => add_map_keys_expr(body),\\n      ECall(callee, args, _) => {\\n        add_map_keys_expr(callee)\\n        let mut ai = 0\\n        while ai < Array::length(args) {\\n          add_map_keys_expr(Array::get(args, ai))\\n          ai = ai + 1\\n        }\\n      },\\n      _ => ()\\n    }\\n  }\\n  let mut __mk = 0\\n  while __mk < Array::length(stmts) {\\n    match Array::get(stmts, __mk) {\\n      SLet(_, _, _, _, expr) => add_map_keys_expr(expr),\\n      STest(_, expr) => add_map_keys_expr(expr),\\n      SBench(_, expr) => add_map_keys_expr(expr),\\n      _ => ()\\n    }\\n    __mk = __mk + 1\\n  }\\n  // Always seed the empty string so codegen that materialises \\\"\\\" (e.g.\\n  // StringBuilder::freeze's join separator, Stream::to_string's accumulator)\\n  // can rely on str_table_lookup(\\\"\\\") succeeding even when the source never\\n  // mentions \\\"\\\" literally.\\n  if !array_contains_str(str_strs, \\\"\\\") {\\n    Array::push(str_strs, \\\"\\\")\\n  }\\n  let src_str_base = Array::length(str_strs)\\n  let num_src_pairs = Array::length(selfhost_srcs)\\n  let mut __src_i = 0\\n  while __src_i < num_src_pairs {\\n    let (__src_path, __src_content) = Array::get(selfhost_srcs, __src_i)\\n    Array::push(str_strs, __src_path)\\n    Array::push(str_strs, __src_content)\\n    __src_i = __src_i + 1\\n  }\\n  let num_strings = Array::length(str_strs)\\n  let data_base = 64\\n  let str_offsets = lc_fresh_int_array()\\n  let str_lengths = lc_fresh_int_array()\\n  let mut str_pos = data_base\\n  let mut si = 0\\n  while si < num_strings {\\n    let s = Array::get(str_strs, si)\\n    let slen = String::length(s)\\n    Array::push(str_offsets, str_pos)\\n    Array::push(str_lengths, slen)\\n    str_pos = str_pos + slen\\n    si = si + 1\\n  }\\n  let heap_start = ((str_pos + 7) / 8) * 8\\n  let effect_names_list = lc_fresh_string_array()\\n  let effect_op_keys_list = lc_fresh_string_array()\\n  let effect_op_arities_list = Array::slice([\\n    0\\n  ], 0, 0)\\n  let mut eff_collect_i = 0\\n  while eff_collect_i < Array::length(stmts) {\\n    match Array::get(stmts, eff_collect_i) {\\n      SEffectDef(_, eff_name, _, ops) => {\\n        if eff_name != \\\"Error\\\" && !array_contains_str(effect_names_list, eff_name) {\\n          Array::push(effect_names_list, eff_name)\\n        } else {\\n          ()\\n        }\\n        let mut op_i = 0\\n        while op_i < Array::length(ops) {\\n          let (op_name, op_params, _) = Array::get(ops, op_i)\\n          Array::push(effect_op_keys_list, String::concat(String::concat(eff_name, \\\"::\\\"), op_name))\\n          Array::push(effect_op_arities_list, Array::length(op_params))\\n          op_i = op_i + 1\\n        }\\n      },\\n      _ => ()\\n    }\\n    eff_collect_i = eff_collect_i + 1\\n  }\\n  // Per-effect region stride (#553). Each effect tag gets a reserved region\\n  // below the heap frontier holding the replay-handler control words (+0\\n  // perform counter, +8 resume-memo count) and the resume-memo array (+16 +\\n  // k*8). The replay model stores one i64 per `perform` resolved within a\\n  // `handle`, so the region is O(performs). At 8192 B (1022 entries) a loop\\n  // performing more than ~1022-2046 times overflowed the region into the live\\n  // heap, where the growing memo chased and clobbered the reused payload-tuple\\n  // free block (~8 B/iter past the threshold, ADR-0055). 131072 B (16382\\n  // entries) covers the full verify regime (N2=11000) with headroom; programs\\n  // performing more than ~16K times within one handle still spill (a hard\\n  // bound of the replay-based handler — unbounded performs need a\\n  // continuation-based handler). MUST stay in sync with the `* 131072` strides\\n  // in compile_call.vibe (perform) and compile_expr_tail6.vibe (handler arm).\\n  let eff_reserve = (Array::length(effect_names_list) + 1) * 131072\\n  // Function-level coverage (gated by `coverage`): a 1-byte-per-user-function\\n  // hit bitmap placed in a dedicated reserve ABOVE the effect regions and BELOW\\n  // the heap frontier, so it never collides with effect words or the live heap.\\n  // `cov_base` is a compile-time-constant address baked into each function's\\n  // prologue store. When coverage is off, cov_reserve is 0 and codegen output is\\n  // byte-identical to the normal build (the self-host fixpoint is unaffected).\\n  let cov_count = num_user_funcs\\n  let cov_base = heap_start + eff_reserve\\n  let cov_reserve = if coverage {\\n    ((cov_count + 7) / 8) * 8\\n  } else {\\n    0\\n  }\\n  // #cov branch coverage: a second 1-byte-per-branch hit region directly above\\n  // the function-hit region. Branch ids are assigned sequentially during codegen\\n  // (CovState.next), so the count is not known up front — reserve a fixed cap.\\n  // 65536 branches is generous headroom (the whole compiler has a few thousand).\\n  // Off => branch_reserve is 0 and the layout/codegen is byte-identical.\\n  let cov_branch_cap = 65536\\n  let cov_branch_base = cov_base + cov_reserve\\n  let cov_branch_reserve = if coverage {\\n    cov_branch_cap\\n  } else {\\n    0\\n  }\\n  // Function-call execution trace (debugger / DAP P1 groundwork, gated by\\n  // `debug_trace`). A dedicated region directly above the coverage regions and\\n  // below the heap frontier holds a 4-byte counter cell followed by a fixed-cap\\n  // log of i32 slots. Each user function's entry, in debug mode, appends its\\n  // own user index to the log (counter-bounded). A `vibe.trace` custom section\\n  // records the layout + function names so the runner can dump the entry\\n  // sequence. Off => trace_reserve is 0 and the layout/codegen is byte-identical\\n  // to a normal build (the self-host fixpoint is unaffected).\\n  let trace_cap = 4096\\n  let trace_counter_addr = cov_branch_base + cov_branch_reserve\\n  let trace_log_base = trace_counter_addr + 4\\n  let trace_reserve = if debug_trace {\\n    4 + trace_cap * 4\\n  } else {\\n    0\\n  }\\n  // debugger argument inspection (DAP P2, gated by `debug_break`). A dedicated\\n  // region directly above the trace region holds a 4-byte count cell followed by\\n  // a fixed-cap array of i64 slots. At each user function entry, in break mode,\\n  // the function's i64 parameters are spilled here (capped at dbgargs_cap) and\\n  // the count cell is set, BEFORE calling the `vibe::dbg_break` host hook. The\\n  // hook reads them out of guest memory and prints `args: [...]`. A\\n  // `vibe.dbgargs` custom section publishes the two addresses to the runner.\\n  // Off => dbgargs_reserve is 0 and the layout/codegen is byte-identical to a\\n  // normal build (the self-host fixpoint is unaffected).\\n  let dbgargs_cap = 16\\n  let dbgargs_count_addr = trace_counter_addr + trace_reserve\\n  let dbgargs_base = dbgargs_count_addr + 8\\n  let dbgargs_reserve = if debug_break {\\n    8 + dbgargs_cap * 8\\n  } else {\\n    0\\n  }\\n  let cov_state = CovState::{\\n    enabled: coverage,\\n    base: cov_branch_base,\\n    cap: cov_branch_cap,\\n    next: [\\n      0\\n    ],\\n    cur_fn: [\\n      0\\n    ],\\n    owners: ArrayBuilder::freeze(ArrayBuilder::new())\\n  }\\n  // #799 perf: ONE program walk collecting the canonical free-name set,\\n  // then every need_<builtin> flag below is a map lookup. Previously each\\n  // flag re-walked the whole AST (~40 walks) with a linear fn_names scan per\\n  // ident inside.\\n  let used_builtin_names = collect_used_builtin_names(stmts, fn_names_list)\\n  let need_env_get_builtin = Map::has_key(used_builtin_names, \\\"Env::get\\\")\\n  let need_env_args_len_builtin = Map::has_key(used_builtin_names, \\\"Env::args_len\\\")\\n  let need_env_args_get_builtin = Map::has_key(used_builtin_names, \\\"Env::args_get\\\")\\n  let need_fs_read_file_builtin = Map::has_key(used_builtin_names, \\\"Fs::read_file\\\")\\n  let need_fs_exists_builtin = Map::has_key(used_builtin_names, \\\"Fs::exists\\\")\\n  // #795: vibe_fs_stat_token_raw is the alias-collision-proof surface for the\\n  // same import (lib/@vibe/fs/fs.vibe calls it; see checker/builtins_fs.vibe).\\n  let need_fs_stat_token_builtin = Map::has_key(used_builtin_names, \\\"Fs::stat_token\\\") || Map::has_key(used_builtin_names, \\\"vibe_fs_stat_token_raw\\\")\\n  let need_fs_write_file_builtin = Map::has_key(used_builtin_names, \\\"Fs::write_file\\\")\\n  let need_fs_write_bytes_builtin = Map::has_key(used_builtin_names, \\\"Fs::write_bytes\\\")\\n  // #632: `Fs::read_bytes(path) -> Bytes` — the binary-exact read counterpart of\\n  // Fs::write_bytes, a `vibe.fs_read_bytes (i64) -> i64` host import (type 3,\\n  // same shape as fs_read_file). Gated on use so non-users reserve no import\\n  // (fixpoint-safe). Lets the persistent artifact cache store/load wasm raw.\\n  let need_fs_read_bytes_builtin = Map::has_key(used_builtin_names, \\\"Fs::read_bytes\\\")\\n  // #729/#730: `Fs::readdir(path) -> Array[String]` — a `vibe.fs_read_dir\\n  // (i64) -> i64` host import (type 3, same packed-string shape as\\n  // fs_read_file: the host returns the byte-sorted entry NAMES \\\"\\\\n\\\"-joined as\\n  // ONE string, no host-side array building). compile_call lowers the\\n  // Array[String] surface to `String::split` over that string. Gated on use\\n  // (fixpoint-safe). Unblocks contract-package sibling auto-discovery and the\\n  // global store walk.\\n  let need_fs_readdir_builtin = Map::has_key(used_builtin_names, \\\"Fs::readdir\\\")\\n  let need_profiler_now_us_builtin = Map::has_key(used_builtin_names, \\\"Profiler::now_us\\\")\\n  // `Profiler::heap_bytes() -> Int`: a `vibe.profile-heap-bytes () -> i64`\\n  // host import (type 5, same shape as profile-now-us). Returns the guest's\\n  // current bump-heap pointer (`__heap_ptr`) so vibe code can attribute its\\n  // own allocation growth per phase, mirroring how now_us attributes time.\\n  // Gated on use so non-users reserve no import (fixpoint-safe).\\n  let need_profiler_heap_bytes_builtin = Map::has_key(used_builtin_names, \\\"Profiler::heap_bytes\\\")\\n  // `sleep(ms)` (Async): a `vibe.sleep (i64) -> ()` host import. The host\\n  // implements it as an async function so the guest fiber genuinely\\n  // suspends/resumes (docs/spec/wasi-p3-async.md §2.3, examples/async_host).\\n  // Gated on use, so programs without `sleep` reserve no import (fixpoint-safe).\\n  let need_sleep_builtin = Map::has_key(used_builtin_names, \\\"sleep\\\")\\n  // `Stdin::read_char() -> Int`: a value-returning `vibe.stdin_read_char () ->\\n  // i64` host import. Implemented async by the host (it can suspend the guest\\n  // until a char is available), so this is the data-consuming analog of `sleep`\\n  // — the shape of a host async source (HTTP body byte, stdin char). Gated on\\n  // use (fixpoint-safe).\\n  let need_stdin_read_char_builtin = Map::has_key(used_builtin_names, \\\"Stdin::read_char\\\")\\n  // Process effect host imports: `sh(cmd)` runs a shell command (returns 0) and\\n  // `sh_lines(cmd)` returns its stdout \\\"\\\\n\\\"-joined as ONE string (same packed\\n  // ABI as fs_read_dir; compile_call lowers the Array[String] surface to a\\n  // String::split). Both `vibe.sh` / `vibe.sh_lines (i64) -> i64` host imports,\\n  // gated on use so non-users reserve no import (fixpoint-safe). Revives the\\n  // process/time/shell stdlib whose functions call these.\\n  let need_sh_builtin = Map::has_key(used_builtin_names, \\\"sh\\\")\\n  let need_sh_lines_builtin = Map::has_key(used_builtin_names, \\\"sh_lines\\\")\\n  // #865: structured subprocess result host imports -- `vibe_sh_capture_raw`\\n  // runs the command once (handle), the three accessors read the cached\\n  // {exit_code, stdout, stderr}, `vibe_sh_capture_close_raw` frees it. Same\\n  // handle+accessor shape as the #794 HTTP client imports below. Gated on\\n  // use, same fixpoint-safety discipline as sh/sh_lines above.\\n  let need_sh_capture_builtin = Map::has_key(used_builtin_names, \\\"vibe_sh_capture_raw\\\")\\n  let need_sh_capture_exit_code_builtin = Map::has_key(used_builtin_names, \\\"vibe_sh_capture_exit_code_raw\\\")\\n  let need_sh_capture_stdout_builtin = Map::has_key(used_builtin_names, \\\"vibe_sh_capture_stdout_raw\\\")\\n  let need_sh_capture_stderr_builtin = Map::has_key(used_builtin_names, \\\"vibe_sh_capture_stderr_raw\\\")\\n  let need_sh_capture_close_builtin = Map::has_key(used_builtin_names, \\\"vibe_sh_capture_close_raw\\\")\\n  // #903/#865: `Process::exit(code) -> Unit` -- propagates the guest's exit\\n  // code to the real OS process exit status via the host runner's\\n  // exit-trap mechanism (never returns in practice, but is typed Unit --\\n  // there's no `Never` type). `vibe.process_exit (i64) -> ()` host import,\\n  // void like Fs::remove/sh_capture_close, gated on use (fixpoint-safe).\\n  let need_process_exit_builtin = Map::has_key(used_builtin_names, \\\"vibe_process_exit_raw\\\")\\n  // Stdin/Stdout host effects for vibe/io: `Stdin::read_stream(n) -> String`\\n  // (`vibe.stdin_read_stream (i64) -> i64`, value-returning like fs_read_file),\\n  // `Stdout::write_stream(s) -> Unit` and `Stdout::write_char(c) -> Unit`\\n  // (`vibe.stdout_write_stream` / `vibe.stdout_write_char (i64) -> ()`, void like\\n  // sleep). All gated on use so non-users reserve no import (fixpoint-safe) —\\n  // the compiler's own build uses none, so its bytes are unchanged. Revives the\\n  // io stdlib whose read/print/println/write_char helpers call these builtins.\\n  let need_stdin_read_stream_builtin = Map::has_key(used_builtin_names, \\\"Stdin::read_stream\\\")\\n  // #929: the println/print BUILTIN lowering (compile_call.vibe) synthesizes\\n  // calls onto these two imports when no source-provided println/print is\\n  // merged, so their use also gates the imports in. collect_used_builtin_names\\n  // only counts FREE names -- a program using @vibe/io's (or its own) println\\n  // fn does not trip this, exactly matching the lowering's cc_ft_has guard.\\n  let used_print_builtin = Map::has_key(used_builtin_names, \\\"println\\\") || Map::has_key(used_builtin_names, \\\"print\\\")\\n  let need_stdout_write_stream_builtin = Map::has_key(used_builtin_names, \\\"Stdout::write_stream\\\") || used_print_builtin\\n  let need_stdout_write_char_builtin = Map::has_key(used_builtin_names, \\\"Stdout::write_char\\\") || used_print_builtin\\n  // #865: `Stderr::write_stream(s) -> Unit` / `Stderr::write_char(c) -> Unit`\\n  // (`vibe.stderr_write_stream` / `vibe.stderr_write_char (i64) -> ()`, void\\n  // like stdout's), same shapes/gating as the Stdout pair above.\\n  let need_stderr_write_stream_builtin = Map::has_key(used_builtin_names, \\\"Stderr::write_stream\\\")\\n  let need_stderr_write_char_builtin = Map::has_key(used_builtin_names, \\\"Stderr::write_char\\\")\\n  // #762: `Path::ref` / `Path::resolve` both lower (compile_call) to the\\n  // `resolve_path` host import — resolve a path to absolute against the process\\n  // CWD. `vibe.resolve_path (i64) -> i64`, value-returning like fs_read_file,\\n  // gated on either surface name so non-users reserve no import (fixpoint-safe).\\n  let need_resolve_path_builtin = Map::has_key(used_builtin_names, \\\"Path::ref\\\") || Map::has_key(used_builtin_names, \\\"Path::resolve\\\")\\n  // #768: `Fs::remove(path) -> Unit` — a `vibe.fs_remove (i64) -> ()` host\\n  // import (type 1, like sleep/stdout_write_char). Checker-recognized since\\n  // `builtins_fs.vibe`'s `lookup_fs_remove` but never wired to codegen, so any\\n  // caller hit \\\"undefined variable (local): Fs::remove @call\\\". Gated on use so\\n  // non-users reserve no import (fixpoint-safe).\\n  let need_fs_remove_builtin = Map::has_key(used_builtin_names, \\\"Fs::remove\\\")\\n  // #768: `Fs::mkdir_p(path) -> Unit` (recursive mkdir) — same shape/import\\n  // type as Fs::remove. Same gap: checker-recognized (builtins_fs.vibe's\\n  // lookup_fs_mkdir_p) but had no codegen wiring at all.\\n  let need_fs_mkdir_p_builtin = Map::has_key(used_builtin_names, \\\"Fs::mkdir_p\\\")\\n  // #768: the rest of lib/@vibe/shell/commands.vibe's Fs surface — same\\n  // \\\"checker-legal (or newly made so), zero codegen wiring\\\" gap as\\n  // Fs::remove/Fs::mkdir_p, and the JS host runner already implements all of\\n  // fs_mkdir/fs_chdir/fs_copy/fs_append/fs_rename/fs_is_dir/fs_is_file/\\n  // fs_getcwd. Fs::mkdir (non-recursive, distinct from Fs::mkdir_p) was\\n  // likewise checker-legal but had no codegen wiring at all.\\n  let need_fs_mkdir_builtin = Map::has_key(used_builtin_names, \\\"Fs::mkdir\\\")\\n  let need_fs_chdir_builtin = Map::has_key(used_builtin_names, \\\"Fs::chdir\\\")\\n  let need_fs_copy_builtin = Map::has_key(used_builtin_names, \\\"Fs::copy\\\")\\n  let need_fs_append_builtin = Map::has_key(used_builtin_names, \\\"Fs::append\\\")\\n  let need_fs_rename_builtin = Map::has_key(used_builtin_names, \\\"Fs::rename\\\")\\n  let need_fs_is_dir_builtin = Map::has_key(used_builtin_names, \\\"Fs::is_dir\\\")\\n  let need_fs_is_file_builtin = Map::has_key(used_builtin_names, \\\"Fs::is_file\\\")\\n  let need_fs_getcwd_builtin = Map::has_key(used_builtin_names, \\\"Fs::getcwd\\\")\\n  // #794: HTTP client host imports. lib/@vibe/http's client functions call\\n  // the `__http_*_raw` builtins (dunder names so units bundling the package's\\n  // index.vibe -- which exports alias functions literally named\\n  // `Http::request` etc. -- cannot capture the ident, see #795). Each lowers\\n  // to a `vibe.http_*` host import, gated on use (fixpoint-safe: the compiler\\n  // itself uses none, so its bytes are unchanged).\\n  let need_http_request_builtin = Map::has_key(used_builtin_names, \\\"vibe_http_request_raw\\\")\\n  let need_http_response_status_builtin = Map::has_key(used_builtin_names, \\\"vibe_http_response_status_raw\\\")\\n  let need_http_response_header_builtin = Map::has_key(used_builtin_names, \\\"vibe_http_response_header_raw\\\")\\n  let need_http_response_body_builtin = Map::has_key(used_builtin_names, \\\"vibe_http_response_body_raw\\\")\\n  let need_http_close_builtin = Map::has_key(used_builtin_names, \\\"vibe_http_close_raw\\\")\\n  let mut next_import_idx = 1\\n  let env_get_import_idx = if need_env_get_builtin {\\n    let idx = next_import_idx\\n    next_import_idx = next_import_idx + 1\\n    idx\\n  } else {\\n    -1\\n  }\\n  let env_args_len_import_idx = if need_env_args_len_builtin {\\n    let idx = next_import_idx\\n    next_import_idx = next_import_idx + 1\\n    idx\\n  } else {\\n    -1\\n  }\\n  let env_args_get_import_idx = if need_env_args_get_builtin {\\n    let idx = next_import_idx\\n    next_import_idx = next_import_idx + 1\\n    idx\\n  } else {\\n    -1\\n  }\\n  let fs_read_file_import_idx = if need_fs_read_file_builtin {\\n    let idx = next_import_idx\\n    next_import_idx = next_import_idx + 1\\n    idx\\n  } else {\\n    -1\\n  }\\n  let fs_exists_import_idx = if need_fs_exists_builtin {\\n    let idx = next_import_idx\\n    next_import_idx = next_import_idx + 1\\n    idx\\n  } else {\\n    -1\\n  }\\n  let fs_stat_token_import_idx = if need_fs_stat_token_builtin {\\n    let idx = next_import_idx\\n    next_import_idx = next_import_idx + 1\\n    idx\\n  } else {\\n    -1\\n  }\\n  let fs_write_file_import_idx = if need_fs_write_file_builtin {\\n    let idx = next_import_idx\\n    next_import_idx = next_import_idx + 1\\n    idx\\n  } else {\\n    -1\\n  }\\n  let fs_write_bytes_import_idx = if need_fs_write_bytes_builtin {\\n    let idx = next_import_idx\\n    next_import_idx = next_import_idx + 1\\n    idx\\n  } else {\\n    -1\\n  }\\n  // #632: reserved immediately after fs_write_bytes; the import emission below\\n  // must stay in this same order so the index matches the descriptor.\\n  let fs_read_bytes_import_idx = if need_fs_read_bytes_builtin {\\n    let idx = next_import_idx\\n    next_import_idx = next_import_idx + 1\\n    idx\\n  } else {\\n    -1\\n  }\\n  // #729/#730: reserved immediately after fs_read_bytes; the import emission\\n  // below must stay in this same order so the index matches the descriptor.\\n  let fs_read_dir_import_idx = if need_fs_readdir_builtin {\\n    let idx = next_import_idx\\n    next_import_idx = next_import_idx + 1\\n    idx\\n  } else {\\n    -1\\n  }\\n  let profiler_now_us_import_idx = if need_profiler_now_us_builtin {\\n    let idx = next_import_idx\\n    next_import_idx = next_import_idx + 1\\n    idx\\n  } else {\\n    -1\\n  }\\n  // reserved immediately after profile-now-us; the import emission below must\\n  // stay in this same order so the index matches the descriptor.\\n  let profiler_heap_bytes_import_idx = if need_profiler_heap_bytes_builtin {\\n    let idx = next_import_idx\\n    next_import_idx = next_import_idx + 1\\n    idx\\n  } else {\\n    -1\\n  }\\n  let sleep_import_idx = if need_sleep_builtin {\\n    let idx = next_import_idx\\n    next_import_idx = next_import_idx + 1\\n    idx\\n  } else {\\n    -1\\n  }\\n  let stdin_read_char_import_idx = if need_stdin_read_char_builtin {\\n    let idx = next_import_idx\\n    next_import_idx = next_import_idx + 1\\n    idx\\n  } else {\\n    -1\\n  }\\n  // reserved immediately after stdin_read_char; the import emission below must\\n  // stay in this same order so the index matches the descriptor.\\n  let sh_import_idx = if need_sh_builtin {\\n    let idx = next_import_idx\\n    next_import_idx = next_import_idx + 1\\n    idx\\n  } else {\\n    -1\\n  }\\n  let sh_lines_import_idx = if need_sh_lines_builtin {\\n    let idx = next_import_idx\\n    next_import_idx = next_import_idx + 1\\n    idx\\n  } else {\\n    -1\\n  }\\n  // reserved immediately after sh_lines; the import emission below must stay in\\n  // this same order so the index matches the descriptor.\\n  let stdin_read_stream_import_idx = if need_stdin_read_stream_builtin {\\n    let idx = next_import_idx\\n    next_import_idx = next_import_idx + 1\\n    idx\\n  } else {\\n    -1\\n  }\\n  let stdout_write_stream_import_idx = if need_stdout_write_stream_builtin {\\n    let idx = next_import_idx\\n    next_import_idx = next_import_idx + 1\\n    idx\\n  } else {\\n    -1\\n  }\\n  let stdout_write_char_import_idx = if need_stdout_write_char_builtin {\\n    let idx = next_import_idx\\n    next_import_idx = next_import_idx + 1\\n    idx\\n  } else {\\n    -1\\n  }\\n  // reserved immediately after stdout_write_char; the import emission below must\\n  // stay in this same order so the index matches the descriptor.\\n  let resolve_path_import_idx = if need_resolve_path_builtin {\\n    let idx = next_import_idx\\n    next_import_idx = next_import_idx + 1\\n    idx\\n  } else {\\n    -1\\n  }\\n  // #768: reserved immediately after resolve_path; the import emission below\\n  // must stay in this same order so the index matches the descriptor.\\n  let fs_remove_import_idx = if need_fs_remove_builtin {\\n    let idx = next_import_idx\\n    next_import_idx = next_import_idx + 1\\n    idx\\n  } else {\\n    -1\\n  }\\n  // #768: reserved immediately after fs_remove; the import emission below must\\n  // stay in this same order so the index matches the descriptor.\\n  let fs_mkdir_p_import_idx = if need_fs_mkdir_p_builtin {\\n    let idx = next_import_idx\\n    next_import_idx = next_import_idx + 1\\n    idx\\n  } else {\\n    -1\\n  }\\n  // #768: reserved immediately after fs_mkdir_p, in this fixed order; the\\n  // import emission below must match.\\n  let fs_mkdir_import_idx = if need_fs_mkdir_builtin {\\n    let idx = next_import_idx\\n    next_import_idx = next_import_idx + 1\\n    idx\\n  } else {\\n    -1\\n  }\\n  let fs_chdir_import_idx = if need_fs_chdir_builtin {\\n    let idx = next_import_idx\\n    next_import_idx = next_import_idx + 1\\n    idx\\n  } else {\\n    -1\\n  }\\n  let fs_copy_import_idx = if need_fs_copy_builtin {\\n    let idx = next_import_idx\\n    next_import_idx = next_import_idx + 1\\n    idx\\n  } else {\\n    -1\\n  }\\n  let fs_append_import_idx = if need_fs_append_builtin {\\n    let idx = next_import_idx\\n    next_import_idx = next_import_idx + 1\\n    idx\\n  } else {\\n    -1\\n  }\\n  let fs_rename_import_idx = if need_fs_rename_builtin {\\n    let idx = next_import_idx\\n    next_import_idx = next_import_idx + 1\\n    idx\\n  } else {\\n    -1\\n  }\\n  let fs_is_dir_import_idx = if need_fs_is_dir_builtin {\\n    let idx = next_import_idx\\n    next_import_idx = next_import_idx + 1\\n    idx\\n  } else {\\n    -1\\n  }\\n  let fs_is_file_import_idx = if need_fs_is_file_builtin {\\n    let idx = next_import_idx\\n    next_import_idx = next_import_idx + 1\\n    idx\\n  } else {\\n    -1\\n  }\\n  let fs_getcwd_import_idx = if need_fs_getcwd_builtin {\\n    let idx = next_import_idx\\n    next_import_idx = next_import_idx + 1\\n    idx\\n  } else {\\n    -1\\n  }\\n  // #794: HTTP client imports -- reserved after fs_getcwd (before dbg_break),\\n  // in the same order as their emission below.\\n  let http_request_import_idx = if need_http_request_builtin {\\n    let idx = next_import_idx\\n    next_import_idx = next_import_idx + 1\\n    idx\\n  } else {\\n    -1\\n  }\\n  let http_response_status_import_idx = if need_http_response_status_builtin {\\n    let idx = next_import_idx\\n    next_import_idx = next_import_idx + 1\\n    idx\\n  } else {\\n    -1\\n  }\\n  let http_response_header_import_idx = if need_http_response_header_builtin {\\n    let idx = next_import_idx\\n    next_import_idx = next_import_idx + 1\\n    idx\\n  } else {\\n    -1\\n  }\\n  let http_response_body_import_idx = if need_http_response_body_builtin {\\n    let idx = next_import_idx\\n    next_import_idx = next_import_idx + 1\\n    idx\\n  } else {\\n    -1\\n  }\\n  let http_close_import_idx = if need_http_close_builtin {\\n    let idx = next_import_idx\\n    next_import_idx = next_import_idx + 1\\n    idx\\n  } else {\\n    -1\\n  }\\n  // #865: `Process::capture` host imports -- reserved after http_close\\n  // (before dbg_break), in the same order as their emission below. All five\\n  // reuse EXISTING base func types (3 = `(i64)->i64`, 1 = `(i64)->()`), so no\\n  // new type-section entry is needed (unlike #794's http_request).\\n  let sh_capture_import_idx = if need_sh_capture_builtin {\\n    let idx = next_import_idx\\n    next_import_idx = next_import_idx + 1\\n    idx\\n  } else {\\n    -1\\n  }\\n  let sh_capture_exit_code_import_idx = if need_sh_capture_exit_code_builtin {\\n    let idx = next_import_idx\\n    next_import_idx = next_import_idx + 1\\n    idx\\n  } else {\\n    -1\\n  }\\n  let sh_capture_stdout_import_idx = if need_sh_capture_stdout_builtin {\\n    let idx = next_import_idx\\n    next_import_idx = next_import_idx + 1\\n    idx\\n  } else {\\n    -1\\n  }\\n  let sh_capture_stderr_import_idx = if need_sh_capture_stderr_builtin {\\n    let idx = next_import_idx\\n    next_import_idx = next_import_idx + 1\\n    idx\\n  } else {\\n    -1\\n  }\\n  let sh_capture_close_import_idx = if need_sh_capture_close_builtin {\\n    let idx = next_import_idx\\n    next_import_idx = next_import_idx + 1\\n    idx\\n  } else {\\n    -1\\n  }\\n  // #903/#865: `Process::exit(code)` host import -- void like Fs::remove\\n  // (type 1), reserved after sh_capture_close, before Stderr.\\n  let process_exit_import_idx = if need_process_exit_builtin {\\n    let idx = next_import_idx\\n    next_import_idx = next_import_idx + 1\\n    idx\\n  } else {\\n    -1\\n  }\\n  // #865: `Stderr::write_stream` / `Stderr::write_char` host imports --\\n  // reserved after sh_capture_close (before dbg_break), same shapes as the\\n  // Stdout pair (type 3 value-returning is N/A here; both are void type 1).\\n  let stderr_write_stream_import_idx = if need_stderr_write_stream_builtin {\\n    let idx = next_import_idx\\n    next_import_idx = next_import_idx + 1\\n    idx\\n  } else {\\n    -1\\n  }\\n  let stderr_write_char_import_idx = if need_stderr_write_char_builtin {\\n    let idx = next_import_idx\\n    next_import_idx = next_import_idx + 1\\n    idx\\n  } else {\\n    -1\\n  }\\n  // debugger breakpoint (DAP P1): in break mode emit a conditional `vibe::dbg_break`\\n  // host import (() -> ()) called at each user-function entry. Default OFF, so\\n  // num_imported_funcs / func_offset are unchanged for normal builds (fixpoint).\\n  let dbg_break_import_idx = if debug_break {\\n    let idx = next_import_idx\\n    next_import_idx = next_import_idx + 1\\n    idx\\n  } else {\\n    -1\\n  }\\n  // Interior-line breakpoints (span-arc step5): in break mode with per-file\\n  // provenance, reserve a `vibe::dbg_line (i32 file_id, i32 line) -> ()` host\\n  // import called at each statement boundary. Each function's line is mapped\\n  // against ITS OWN source file (prov.file_nls[file_id]) so multi-file entries\\n  // work. Gated on `debug_break && prov has files`, so default builds reserve\\n  // nothing and stay byte-identical.\\n  let dbg_line_on = debug_break && Array::length(prov.files) > 0\\n  let dbg_line_import_idx = if dbg_line_on {\\n    let idx = next_import_idx\\n    next_import_idx = next_import_idx + 1\\n    idx\\n  } else {\\n    -1\\n  }\\n  let linked_import_indices = lc_fresh_int_array()\\n  let linked_import_names = lc_fresh_string_array()\\n  let mut li_i = 0\\n  while li_i < Array::length(linked_imports) {\\n    let (_, lfn_name, _, _) = Array::get(linked_imports, li_i)\\n    Array::push(linked_import_indices, next_import_idx)\\n    Array::push(linked_import_names, lfn_name)\\n    next_import_idx = next_import_idx + 1\\n    li_i = li_i + 1\\n  }\\n  let num_imported_funcs = next_import_idx\\n  let print_int_idx = num_imported_funcs\\n  let print_str_idx = print_int_idx + 1\\n  let str_len_idx = print_str_idx + 1\\n  let str_eq_idx = str_len_idx + 1\\n  let str_concat_idx = str_eq_idx + 1\\n  let arr_new_idx = str_concat_idx + 1\\n  let arr_len_idx = arr_new_idx + 1\\n  let arr_get_idx = arr_len_idx + 1\\n  let arr_push_idx = arr_get_idx + 1\\n  let arr_set_idx = arr_push_idx + 1\\n  let double_to_int_idx = arr_set_idx + 1\\n  let int_to_double_idx = double_to_int_idx + 1\\n  let str_char_code_at_idx = int_to_double_idx + 1\\n  let str_from_char_code_idx = str_char_code_at_idx + 1\\n  let str_substring_idx = str_from_char_code_idx + 1\\n  let identity_idx = str_substring_idx + 1\\n  let arr_slice_idx = identity_idx + 1\\n  let arr_concat_idx = arr_slice_idx + 1\\n  let arr_truncate_idx = arr_concat_idx + 1\\n  let string_join_idx = arr_truncate_idx + 1\\n  let fs_read_file_stub_idx = string_join_idx + 1\\n  let fs_exists_stub_idx = fs_read_file_stub_idx + 1\\n  let fs_stat_token_stub_idx = fs_exists_stub_idx + 1\\n  let fs_write_file_stub_idx = fs_stat_token_stub_idx + 1\\n  let fs_write_bytes_stub_idx = fs_write_file_stub_idx + 1\\n  let eq_idx = fs_write_bytes_stub_idx + 1\\n  let string_ends_with_idx = eq_idx + 1\\n  let string_last_index_of_idx = string_ends_with_idx + 1\\n  let arr_push_all_idx = string_last_index_of_idx + 1\\n  let string_index_of_idx = arr_push_all_idx + 1\\n  let string_contains_idx = string_index_of_idx + 1\\n  let string_starts_with_idx = string_contains_idx + 1\\n  let string_split_idx = string_starts_with_idx + 1\\n  let string_trim_idx = string_split_idx + 1\\n  let selfhost_sources_idx = string_trim_idx + 1\\n  let bytes_new_idx = selfhost_sources_idx + 1\\n  let bytes_len_idx = bytes_new_idx + 1\\n  let bytes_get_idx = bytes_len_idx + 1\\n  let bytes_set_idx = bytes_get_idx + 1\\n  let bytes_push_idx = bytes_set_idx + 1\\n  let bytes_append_idx = bytes_push_idx + 1\\n  let bytes_concat_idx = bytes_append_idx + 1\\n  let bytes_slice_idx = bytes_concat_idx + 1\\n  let bytes_from_array_idx = bytes_slice_idx + 1\\n  let bytes_to_array_idx = bytes_from_array_idx + 1\\n  let rc_drop_idx = bytes_to_array_idx + 1\\n  let rc_alloc_idx = rc_drop_idx + 1\\n  let heap_grow_check_idx = if enable_rc {\\n    rc_alloc_idx + 1\\n  } else {\\n    bytes_to_array_idx + 1\\n  }\\n  let simd_skip_ws_idx = heap_grow_check_idx + 1\\n  let simd_scan_alnum_idx = simd_skip_ws_idx + 1\\n  let simd_scan_alnum_str_idx = simd_scan_alnum_idx + 1\\n  let str_lex_diff_idx = simd_scan_alnum_str_idx + 1\\n  let env_get_idx = if env_get_import_idx >= 0 {\\n    env_get_import_idx\\n  } else {\\n    fs_read_file_stub_idx\\n  }\\n  let env_args_len_idx = if env_args_len_import_idx >= 0 {\\n    env_args_len_import_idx\\n  } else {\\n    fs_exists_stub_idx\\n  }\\n  let env_args_get_idx = if env_args_get_import_idx >= 0 {\\n    env_args_get_import_idx\\n  } else {\\n    fs_read_file_stub_idx\\n  }\\n  let fs_read_file_idx = if fs_read_file_import_idx >= 0 {\\n    fs_read_file_import_idx\\n  } else {\\n    fs_read_file_stub_idx\\n  }\\n  let fs_exists_idx = if fs_exists_import_idx >= 0 {\\n    fs_exists_import_idx\\n  } else {\\n    fs_exists_stub_idx\\n  }\\n  let fs_stat_token_idx = if fs_stat_token_import_idx >= 0 {\\n    fs_stat_token_import_idx\\n  } else {\\n    fs_stat_token_stub_idx\\n  }\\n  let fs_write_file_idx = if fs_write_file_import_idx >= 0 {\\n    fs_write_file_import_idx\\n  } else {\\n    fs_write_file_stub_idx\\n  }\\n  let fs_write_bytes_idx = if fs_write_bytes_import_idx >= 0 {\\n    fs_write_bytes_import_idx\\n  } else {\\n    fs_write_bytes_stub_idx\\n  }\\n  // #632: no dedicated stub — when read_bytes is unused the builtin index just\\n  // needs SOME valid never-called slot, so reuse the fs_read_file stub (a\\n  // `(i64)->i64` placeholder). The real call site only exists when the import is\\n  // reserved.\\n  let fs_read_bytes_idx = if fs_read_bytes_import_idx >= 0 {\\n    fs_read_bytes_import_idx\\n  } else {\\n    fs_read_file_stub_idx\\n  }\\n  // #729/#730: like read_bytes, no dedicated stub — unused readdir reuses the\\n  // fs_read_file stub (a `(i64)->i64` never-called placeholder).\\n  let fs_read_dir_idx = if fs_read_dir_import_idx >= 0 {\\n    fs_read_dir_import_idx\\n  } else {\\n    fs_read_file_stub_idx\\n  }\\n  let profiler_now_us_idx = if profiler_now_us_import_idx >= 0 {\\n    profiler_now_us_import_idx\\n  } else {\\n    env_args_len_idx\\n  }\\n  // Profiler::heap_bytes call target: the import when reserved, else a\\n  // never-called `() -> i64` stub (mirrors now_us's fallback).\\n  let profiler_heap_bytes_idx = if profiler_heap_bytes_import_idx >= 0 {\\n    profiler_heap_bytes_import_idx\\n  } else {\\n    env_args_len_idx\\n  }\\n  // `sleep` call target: the import when reserved, else a never-called stub\\n  // (the builtin is only emitted as a call when the program uses `sleep`, which\\n  // is exactly when the import is reserved).\\n  let sleep_idx = if sleep_import_idx >= 0 {\\n    sleep_import_idx\\n  } else {\\n    env_args_len_idx\\n  }\\n  let stdin_read_char_idx = if stdin_read_char_import_idx >= 0 {\\n    stdin_read_char_import_idx\\n  } else {\\n    env_args_len_idx\\n  }\\n  // sh / sh_lines call targets: the import when reserved, else the fs_read_file\\n  // stub (a `(i64)->i64` never-called placeholder) — the real call site only\\n  // exists when the import is reserved (i.e. when the program uses sh/sh_lines).\\n  let sh_idx = if sh_import_idx >= 0 {\\n    sh_import_idx\\n  } else {\\n    fs_read_file_stub_idx\\n  }\\n  let sh_lines_idx = if sh_lines_import_idx >= 0 {\\n    sh_lines_import_idx\\n  } else {\\n    fs_read_file_stub_idx\\n  }\\n  // Stdin::read_stream / Stdout::write_stream / Stdout::write_char call targets:\\n  // the import when reserved, else a never-called stub (read_stream is\\n  // value-returning like sh -> fs_read_file stub; the void write ops mirror\\n  // sleep's fallback to env_args_len). The real call site only exists when the\\n  // matching import is reserved (i.e. when the program uses io).\\n  let stdin_read_stream_idx = if stdin_read_stream_import_idx >= 0 {\\n    stdin_read_stream_import_idx\\n  } else {\\n    fs_read_file_stub_idx\\n  }\\n  let stdout_write_stream_idx = if stdout_write_stream_import_idx >= 0 {\\n    stdout_write_stream_import_idx\\n  } else {\\n    env_args_len_idx\\n  }\\n  let stdout_write_char_idx = if stdout_write_char_import_idx >= 0 {\\n    stdout_write_char_import_idx\\n  } else {\\n    env_args_len_idx\\n  }\\n  // resolve_path call target: the import when reserved, else the fs_read_file\\n  // stub (a `(i64)->i64` never-called placeholder — same shape).\\n  let resolve_path_idx = if resolve_path_import_idx >= 0 {\\n    resolve_path_import_idx\\n  } else {\\n    fs_read_file_stub_idx\\n  }\\n  // #768: Fs::remove call target — the import when reserved, else a\\n  // never-called stub (void return, so mirrors sleep_idx/stdout_write_char_idx's\\n  // fallback to env_args_len_idx).\\n  let fs_remove_idx = if fs_remove_import_idx >= 0 {\\n    fs_remove_import_idx\\n  } else {\\n    env_args_len_idx\\n  }\\n  // #768: Fs::mkdir_p call target — same fallback shape as fs_remove_idx.\\n  let fs_mkdir_p_idx = if fs_mkdir_p_import_idx >= 0 {\\n    fs_mkdir_p_import_idx\\n  } else {\\n    env_args_len_idx\\n  }\\n  // #768: void Fs ops (mkdir/chdir/copy/append/rename) — same fallback shape\\n  // as fs_remove_idx/fs_mkdir_p_idx.\\n  let fs_mkdir_idx = if fs_mkdir_import_idx >= 0 {\\n    fs_mkdir_import_idx\\n  } else {\\n    env_args_len_idx\\n  }\\n  let fs_chdir_idx = if fs_chdir_import_idx >= 0 {\\n    fs_chdir_import_idx\\n  } else {\\n    env_args_len_idx\\n  }\\n  let fs_copy_idx = if fs_copy_import_idx >= 0 {\\n    fs_copy_import_idx\\n  } else {\\n    env_args_len_idx\\n  }\\n  let fs_append_idx = if fs_append_import_idx >= 0 {\\n    fs_append_import_idx\\n  } else {\\n    env_args_len_idx\\n  }\\n  let fs_rename_idx = if fs_rename_import_idx >= 0 {\\n    fs_rename_import_idx\\n  } else {\\n    env_args_len_idx\\n  }\\n  // #768: value-returning Fs ops (is_dir/is_file bool, getcwd string) —\\n  // fallback to the fs_read_file stub (an `(i64)->i64`-shaped never-called\\n  // placeholder), same as other value-returning fallbacks above.\\n  let fs_is_dir_idx = if fs_is_dir_import_idx >= 0 {\\n    fs_is_dir_import_idx\\n  } else {\\n    fs_read_file_stub_idx\\n  }\\n  let fs_is_file_idx = if fs_is_file_import_idx >= 0 {\\n    fs_is_file_import_idx\\n  } else {\\n    fs_read_file_stub_idx\\n  }\\n  let fs_getcwd_idx = if fs_getcwd_import_idx >= 0 {\\n    fs_getcwd_import_idx\\n  } else {\\n    env_args_len_idx\\n  }\\n  // #794: never-called placeholders when unused, like the Fs fallbacks above.\\n  let http_request_idx = if http_request_import_idx >= 0 {\\n    http_request_import_idx\\n  } else {\\n    fs_read_file_stub_idx\\n  }\\n  let http_response_status_idx = if http_response_status_import_idx >= 0 {\\n    http_response_status_import_idx\\n  } else {\\n    fs_read_file_stub_idx\\n  }\\n  let http_response_header_idx = if http_response_header_import_idx >= 0 {\\n    http_response_header_import_idx\\n  } else {\\n    fs_read_file_stub_idx\\n  }\\n  let http_response_body_idx = if http_response_body_import_idx >= 0 {\\n    http_response_body_import_idx\\n  } else {\\n    fs_read_file_stub_idx\\n  }\\n  let http_close_idx = if http_close_import_idx >= 0 {\\n    http_close_import_idx\\n  } else {\\n    fs_read_file_stub_idx\\n  }\\n  // #865: never-called placeholders when unused, like the http fallbacks\\n  // above. The four value-returning ops fall back to the fs_read_file stub\\n  // (a `(i64)->i64` never-called placeholder); the void close op falls back\\n  // to env_args_len_idx, mirroring fs_remove_idx/http_close_idx's own choice.\\n  let sh_capture_idx = if sh_capture_import_idx >= 0 {\\n    sh_capture_import_idx\\n  } else {\\n    fs_read_file_stub_idx\\n  }\\n  let sh_capture_exit_code_idx = if sh_capture_exit_code_import_idx >= 0 {\\n    sh_capture_exit_code_import_idx\\n  } else {\\n    fs_read_file_stub_idx\\n  }\\n  let sh_capture_stdout_idx = if sh_capture_stdout_import_idx >= 0 {\\n    sh_capture_stdout_import_idx\\n  } else {\\n    fs_read_file_stub_idx\\n  }\\n  let sh_capture_stderr_idx = if sh_capture_stderr_import_idx >= 0 {\\n    sh_capture_stderr_import_idx\\n  } else {\\n    fs_read_file_stub_idx\\n  }\\n  let sh_capture_close_idx = if sh_capture_close_import_idx >= 0 {\\n    sh_capture_close_import_idx\\n  } else {\\n    env_args_len_idx\\n  }\\n  // #903/#865: Process::exit call target -- void op, same fallback shape as\\n  // fs_remove_idx/sh_capture_close_idx.\\n  let process_exit_idx = if process_exit_import_idx >= 0 {\\n    process_exit_import_idx\\n  } else {\\n    env_args_len_idx\\n  }\\n  // #865: Stderr::write_stream / Stderr::write_char call targets -- void ops,\\n  // same fallback shape as stdout_write_stream_idx/stdout_write_char_idx.\\n  let stderr_write_stream_idx = if stderr_write_stream_import_idx >= 0 {\\n    stderr_write_stream_import_idx\\n  } else {\\n    env_args_len_idx\\n  }\\n  let stderr_write_char_idx = if stderr_write_char_import_idx >= 0 {\\n    stderr_write_char_import_idx\\n  } else {\\n    env_args_len_idx\\n  }\\n  let max_builtin_func_idx = str_lex_diff_idx\\n  let num_generated = (max_builtin_func_idx - num_imported_funcs) + 1\\n  let func_offset = num_imported_funcs + num_generated\\n  let fn_indices_list = lc_fresh_int_array()\\n  let fn_returns_list = lc_fresh_int_array()\\n  let mut fi = 0\\n  while fi < num_user_funcs {\\n    Array::push(fn_indices_list, fi + func_offset)\\n    Array::push(fn_returns_list, 1)\\n    fi = fi + 1\\n  }\\n  let builtin_names_list = lc_fresh_string_array()\\n  let builtin_param_counts = lc_fresh_int_array()\\n  let builtin_needs_env_list = lc_fresh_bool_array()\\n  let builtin_indices_list = lc_fresh_int_array()\\n  let builtin_returns_list = lc_fresh_int_array()\\n  // #415 B-1: the central registry DRIVES the linear lane's registration.\\n  // Names, param counts, and returns come straight from builtin_registry()\\n  // rows with in_linear = true; only the function INDEX is lane-local (the\\n  // idx bindings computed above), resolved by the match below. Adding a\\n  // linear builtin = one registry row + one match arm here (+ the import /\\n  // body wiring); param-count and returns live ONLY in the registry.\\n  // needs_env is false for every static builtin -- only the linked-import\\n  // bridges appended after verify carry an env. vibe_rc_drop/vibe_rc_alloc\\n  // register under RC builds only (mirrored by verify_lane_builtins'\\n  // vibe_rc_ exemption).\\n  let registry_rows = builtin_registry()\\n  let mut reg_i = 0\\n  while reg_i < Array::length(registry_rows) {\\n    let (reg_name, reg_params, reg_returns, reg_linear, _) = Array::get(registry_rows, reg_i)\\n    let reg_include = reg_linear && (enable_rc || !String::starts_with(reg_name, \\\"vibe_rc_\\\"))\\n    if reg_include {\\n      let reg_idx = match reg_name {\\n        \\\"Env::get\\\" => env_get_idx,\\n        \\\"Env::args_len\\\" => env_args_len_idx,\\n        \\\"Env::args_get\\\" => env_args_get_idx,\\n        \\\"Fs::read_file\\\" => fs_read_file_idx,\\n        \\\"Fs::exists\\\" => fs_exists_idx,\\n        \\\"Fs::stat_token\\\" => fs_stat_token_idx,\\n        // #795: alias-collision-proof name, same import index as Fs::stat_token.\\n        \\\"vibe_fs_stat_token_raw\\\" => fs_stat_token_idx,\\n        \\\"Fs::write_file\\\" => fs_write_file_idx,\\n        \\\"Fs::write_bytes\\\" => fs_write_bytes_idx,\\n        \\\"Fs::read_bytes\\\" => fs_read_bytes_idx,\\n        // #729/#730: RAW half of Fs::readdir -- compile_call lowers the surface.\\n        \\\"vibe_fs_read_dir_raw\\\" => fs_read_dir_idx,\\n        \\\"Fs::remove\\\" => fs_remove_idx,\\n        \\\"Fs::mkdir_p\\\" => fs_mkdir_p_idx,\\n        \\\"Fs::mkdir\\\" => fs_mkdir_idx,\\n        \\\"Fs::chdir\\\" => fs_chdir_idx,\\n        \\\"Fs::copy\\\" => fs_copy_idx,\\n        \\\"Fs::append\\\" => fs_append_idx,\\n        \\\"Fs::rename\\\" => fs_rename_idx,\\n        \\\"Fs::is_dir\\\" => fs_is_dir_idx,\\n        \\\"Fs::is_file\\\" => fs_is_file_idx,\\n        \\\"Fs::getcwd\\\" => fs_getcwd_idx,\\n        // #794: HTTP client host ops (raw dunder surface names, see checker/builtins_net.vibe).\\n        \\\"vibe_http_request_raw\\\" => http_request_idx,\\n        \\\"vibe_http_response_status_raw\\\" => http_response_status_idx,\\n        \\\"vibe_http_response_header_raw\\\" => http_response_header_idx,\\n        \\\"vibe_http_response_body_raw\\\" => http_response_body_idx,\\n        \\\"vibe_http_close_raw\\\" => http_close_idx,\\n        \\\"sh\\\" => sh_idx,\\n        // RAW half of sh_lines -- compile_call lowers the Array[String] surface.\\n        \\\"vibe_sh_lines_raw\\\" => sh_lines_idx,\\n        // #865: structured subprocess result (raw dunder names -- called\\n        // directly from lib/@vibe/process/process.vibe, same convention as\\n        // the vibe_http_*_raw names above).\\n        \\\"vibe_sh_capture_raw\\\" => sh_capture_idx,\\n        \\\"vibe_sh_capture_exit_code_raw\\\" => sh_capture_exit_code_idx,\\n        \\\"vibe_sh_capture_stdout_raw\\\" => sh_capture_stdout_idx,\\n        \\\"vibe_sh_capture_stderr_raw\\\" => sh_capture_stderr_idx,\\n        \\\"vibe_sh_capture_close_raw\\\" => sh_capture_close_idx,\\n        \\\"vibe_process_exit_raw\\\" => process_exit_idx,\\n        \\\"Stdin::read_stream\\\" => stdin_read_stream_idx,\\n        \\\"Stdout::write_stream\\\" => stdout_write_stream_idx,\\n        \\\"Stdout::write_char\\\" => stdout_write_char_idx,\\n        // #865: Stderr, same shapes as the Stdout pair above.\\n        \\\"Stderr::write_stream\\\" => stderr_write_stream_idx,\\n        \\\"Stderr::write_char\\\" => stderr_write_char_idx,\\n        // #762: RAW host op behind Path::ref / Path::resolve.\\n        \\\"resolve_path\\\" => resolve_path_idx,\\n        \\\"Profiler::now_us\\\" => profiler_now_us_idx,\\n        \\\"Profiler::NowUs\\\" => profiler_now_us_idx,\\n        \\\"Profiler::heap_bytes\\\" => profiler_heap_bytes_idx,\\n        \\\"Profiler::HeapBytes\\\" => profiler_heap_bytes_idx,\\n        \\\"sleep\\\" => sleep_idx,\\n        \\\"Stdin::read_char\\\" => stdin_read_char_idx,\\n        \\\"simd_skip_ws\\\" => simd_skip_ws_idx,\\n        \\\"simd_scan_alnum\\\" => simd_scan_alnum_idx,\\n        \\\"simd_scan_alnum_str\\\" => simd_scan_alnum_str_idx,\\n        // #746: backs String < > <= >= (desugar rewrites to str_lex_diff(a,b) <op> 0).\\n        \\\"str_lex_diff\\\" => str_lex_diff_idx,\\n        \\\"print_int\\\" => print_int_idx,\\n        \\\"print_str\\\" => print_str_idx,\\n        \\\"String::length\\\" => str_len_idx,\\n        \\\"String::equals\\\" => str_eq_idx,\\n        \\\"String::concat\\\" => str_concat_idx,\\n        \\\"array_new\\\" => arr_new_idx,\\n        \\\"Array::length\\\" => arr_len_idx,\\n        \\\"Array::get\\\" => arr_get_idx,\\n        \\\"Array::push\\\" => arr_push_idx,\\n        \\\"Array::push_all\\\" => arr_push_all_idx,\\n        \\\"Array::set\\\" => arr_set_idx,\\n        \\\"Double::to_int\\\" => double_to_int_idx,\\n        \\\"Int::to_double\\\" => int_to_double_idx,\\n        \\\"String::char_code_at\\\" => str_char_code_at_idx,\\n        \\\"String::from_char_code\\\" => str_from_char_code_idx,\\n        \\\"String::substring\\\" => str_substring_idx,\\n        \\\"Array::truncate\\\" => arr_truncate_idx,\\n        \\\"String::join\\\" => string_join_idx,\\n        \\\"eq\\\" => eq_idx,\\n        \\\"String::ends_with\\\" => string_ends_with_idx,\\n        \\\"String::last_index_of\\\" => string_last_index_of_idx,\\n        \\\"String::index_of\\\" => string_index_of_idx,\\n        \\\"String::contains\\\" => string_contains_idx,\\n        \\\"String::starts_with\\\" => string_starts_with_idx,\\n        \\\"String::split\\\" => string_split_idx,\\n        \\\"String::trim\\\" => string_trim_idx,\\n        \\\"selfhost_sources\\\" => selfhost_sources_idx,\\n        \\\"ArrayBuilder::new\\\" => arr_new_idx,\\n        \\\"ArrayBuilder::push\\\" => arr_push_idx,\\n        \\\"ArrayBuilder::freeze\\\" => identity_idx,\\n        \\\"Array::slice\\\" => arr_slice_idx,\\n        \\\"Array::concat\\\" => arr_concat_idx,\\n        \\\"Bytes::new\\\" => bytes_new_idx,\\n        \\\"Bytes::from_array\\\" => bytes_from_array_idx,\\n        \\\"Bytes::to_array\\\" => bytes_to_array_idx,\\n        \\\"Bytes::length\\\" => bytes_len_idx,\\n        \\\"Bytes::get\\\" => bytes_get_idx,\\n        \\\"Bytes::set\\\" => bytes_set_idx,\\n        \\\"Bytes::push\\\" => bytes_push_idx,\\n        \\\"Bytes::append\\\" => bytes_append_idx,\\n        \\\"Bytes::concat\\\" => bytes_concat_idx,\\n        \\\"Bytes::slice\\\" => bytes_slice_idx,\\n        \\\"Double::to_i64_bits\\\" => identity_idx,\\n        \\\"__to_string\\\" => identity_idx,\\n        \\\"vibe_rc_drop\\\" => rc_drop_idx,\\n        \\\"vibe_rc_alloc\\\" => rc_alloc_idx,\\n        \\\"vibe_heap_grow_check\\\" => heap_grow_check_idx,\\n        _ => 0 - 1\\n      }\\n      if reg_idx < 0 {\\n        throw(\\\"builtin registry drift: no linear function-index mapping for builtin '\\\\{reg_name}' (add a match arm in linked_compile.vibe, #415)\\\")\\n      } else {\\n        ()\\n      }\\n      Array::push(builtin_names_list, reg_name)\\n      Array::push(builtin_param_counts, reg_params)\\n      Array::push(builtin_needs_env_list, false)\\n      Array::push(builtin_indices_list, reg_idx)\\n      Array::push(builtin_returns_list, reg_returns)\\n    } else {\\n      ()\\n    }\\n    reg_i = reg_i + 1\\n  }\\n  // #415 B-0: the static registration above must agree with the central\\n  // registry (name set + params + returns, both directions). Placed BEFORE\\n  // the linked_imports loop — those are user-declared effect bridges with\\n  // dynamic names, not builtins.\\n  verify_lane_builtins(\\\"linear\\\", builtin_names_list, builtin_param_counts, builtin_returns_list)\\n  let mut li_reg = 0\\n  while li_reg < Array::length(linked_imports) {\\n    let (_, lfn_name, lparams, lreturns) = Array::get(linked_imports, li_reg)\\n    Array::push(builtin_names_list, lfn_name)\\n    Array::push(builtin_param_counts, lparams)\\n    Array::push(builtin_needs_env_list, true)\\n    Array::push(builtin_indices_list, Array::get(linked_import_indices, li_reg))\\n    Array::push(builtin_returns_list, lreturns)\\n    li_reg = li_reg + 1\\n  }\\n  let mut all_fn_i = 0\\n  while all_fn_i < Array::length(builtin_names_list) {\\n    Array::push(fn_names_list, Array::get(builtin_names_list, all_fn_i))\\n    Array::push(fn_param_counts, Array::get(builtin_param_counts, all_fn_i))\\n    Array::push(fn_needs_env_list, Array::get(builtin_needs_env_list, all_fn_i))\\n    Array::push(fn_indices_list, Array::get(builtin_indices_list, all_fn_i))\\n    Array::push(fn_returns_list, Array::get(builtin_returns_list, all_fn_i))\\n    all_fn_i = all_fn_i + 1\\n  }\\n  let all_fn_names_list = fn_names_list\\n  let all_fn_param_counts = fn_param_counts\\n  let all_fn_needs_env_list = fn_needs_env_list\\n  let all_fn_indices_list = fn_indices_list\\n  let all_fn_returns_list = fn_returns_list\\n  let num_base_types = 9\\n  let lt_w = LambdaTable::{\\n    bodies: lc_fresh_bytes_array(),\\n    param_counts: lc_fresh_int_array(),\\n    captures: lc_fresh_string_matrix(),\\n    meta_i32: lc_fresh_int_array(),\\n    meta_i64: lc_fresh_int_array()\\n  }\\n  let bodies = lc_fresh_bytes_array()\\n  let meta_i32 = lc_fresh_int_array()\\n  let meta_i64 = lc_fresh_int_array()\\n  let builtin_type_idxs = lc_fresh_int_array()\\n  // #415 B-1: one call = one builtin body. The body bytes, its extra local\\n  // counts (meta_i32/meta_i64), and its function-section type index are\\n  // pushed TOGETHER, killing the four-way positional alignment this block\\n  // used to share with a bare number list ~1,400 lines below (the function\\n  // section splices builtin_type_idxs in this same order; a count mismatch\\n  // still throws there).\\n  let push_builtin: (Bytes, Int, Int, Int) -> Unit = (body, m32, m64, type_idx) -> {\\n    Array::push(bodies, body)\\n    Array::push(meta_i32, m32)\\n    Array::push(meta_i64, m64)\\n    Array::push(builtin_type_idxs, type_idx)\\n  }\\n  push_builtin(static_print_i64_body(), 3, 1, 1)\\n  push_builtin(static_print_str_body(), 2, 0, 1)\\n  push_builtin(if enable_rc {\\n    gen_str_len_body(true)\\n  } else {\\n    static_str_len_body()\\n  }, 0, 0, 3)\\n  // #748: SIMD chunk compare needs the extra chunk_limit local (meta_i32 6).\\n  push_builtin(gen_str_eq_body(), 6, 0, 4)\\n  push_builtin(gen_str_concat_body(), 6, 0, 4)\\n  if enable_rc {\\n    push_builtin(gen_arr_new_body(true, rc_alloc_idx), 1, 0, 5)\\n    push_builtin(gen_arr_len_body(true), 0, 0, 3)\\n    push_builtin(gen_arr_get_body(true), 1, 0, 4)\\n    push_builtin(gen_arr_push_body(true, rc_alloc_idx, rc_shadow), 6, 0, 6)\\n    push_builtin(gen_arr_set_body(true), 1, 0, 7)\\n  } else {\\n    push_builtin(gen_arr_new_body(false, rc_alloc_idx), 1, 0, 5)\\n    push_builtin(static_arr_len_body(), 0, 0, 3)\\n    push_builtin(static_arr_get_body(), 1, 0, 4)\\n    push_builtin(gen_arr_push_body(false, rc_alloc_idx, rc_shadow), 6, 0, 6)\\n    push_builtin(static_arr_set_body(), 1, 0, 7)\\n  }\\n  push_builtin(static_double_to_int_body(), 0, 0, 3)\\n  push_builtin(static_int_to_double_body(), 0, 0, 3)\\n  push_builtin(if enable_rc {\\n    gen_str_char_code_at_body(true)\\n  } else {\\n    static_str_char_code_at_body()\\n  }, 1, 0, 4)\\n  push_builtin(gen_str_from_char_code_body(enable_rc), 1, 0, 3)\\n  // #982: substring's clamp prologue needs one i64 scratch (len) — meta 2/1.\\n  push_builtin(gen_str_substring_body(enable_rc), 2, 1, 8)\\n  push_builtin(static_identity_body(), 0, 0, 3)\\n  if enable_rc {\\n    push_builtin(gen_arr_slice_body(true, rc_alloc_idx, rc_shadow), 7, 1, 8)\\n  } else {\\n    // #982: the clamp prologue's i64 len scratch (RC reuses local 10 = elem).\\n    push_builtin(gen_arr_slice_body(false, rc_alloc_idx, rc_shadow), 6, 1, 8)\\n  }\\n  push_builtin(gen_arr_concat_body(), 9, 0, 4)\\n  push_builtin(if enable_rc {\\n    gen_arr_truncate_body(true)\\n  } else {\\n    static_arr_truncate_body()\\n  }, 0, 0, 6)\\n  push_builtin(gen_string_join_body(enable_rc, arr_len_idx, arr_get_idx, str_concat_idx), 9, 1, 4)\\n  push_builtin(static_fs_stub_body(), 0, 0, 3)\\n  push_builtin(static_fs_stub_body(), 0, 0, 3)\\n  push_builtin(static_fs_stub_body(), 0, 0, 3)\\n  push_builtin(static_fs_write_bytes_stub_body(), 0, 0, 6)\\n  push_builtin(static_fs_write_bytes_stub_body(), 0, 0, 6)\\n  push_builtin(gen_eq_body(str_eq_idx), 0, 0, 4)\\n  push_builtin(gen_string_ends_with_body(enable_rc, str_len_idx, str_substring_idx, str_eq_idx), 2, 1, 4)\\n  push_builtin(gen_string_last_index_of_body(enable_rc, str_len_idx, str_substring_idx, str_eq_idx), 3, 1, 4)\\n  if enable_rc {\\n    push_builtin(gen_arr_push_all_body(true, rc_alloc_idx, rc_shadow), 10, 1, 6)\\n  } else {\\n    push_builtin(gen_arr_push_all_body(false, rc_alloc_idx, rc_shadow), 9, 0, 6)\\n  }\\n  // #748 memchr rewrite: 8 i32 locals, the i64 substring scratch is gone.\\n  push_builtin(gen_string_index_of_body(enable_rc, str_len_idx, str_substring_idx, str_eq_idx), 8, 0, 4)\\n  push_builtin(gen_string_contains_body(enable_rc, string_index_of_idx), 0, 0, 4)\\n  push_builtin(gen_string_starts_with_body(enable_rc, str_len_idx, str_substring_idx, str_eq_idx), 2, 1, 4)\\n  push_builtin(gen_string_split_body(enable_rc, arr_new_idx, arr_push_idx, str_len_idx, str_substring_idx, string_index_of_idx), 4, 1, 4)\\n  push_builtin(gen_string_trim_body(enable_rc, str_len_idx, str_char_code_at_idx, str_substring_idx), 4, 0, 3)\\n  if num_src_pairs > 0 {\\n    push_builtin(gen_selfhost_sources_proper_body(num_src_pairs, str_offsets, str_lengths, src_str_base, arr_new_idx, arr_push_idx), 1, 1, 5)\\n  } else {\\n    push_builtin(gen_selfhost_sources_stub_body(arr_new_idx), 0, 0, 5)\\n  }\\n  push_builtin(gen_bytes_new_body(), 1, 0, 5)\\n  push_builtin(gen_bytes_len_body(enable_rc), 0, 0, 3)\\n  push_builtin(gen_bytes_get_body(enable_rc), 1, 0, 4)\\n  push_builtin(gen_bytes_set_body(enable_rc), 1, 0, 7)\\n  push_builtin(gen_bytes_push_body(enable_rc), 6, 0, 6)\\n  push_builtin(gen_bytes_append_body(enable_rc, bytes_len_idx, bytes_get_idx, bytes_push_idx), 2, 0, 6)\\n  push_builtin(gen_bytes_concat_body(bytes_new_idx, bytes_append_idx), 0, 1, 4)\\n  push_builtin(gen_bytes_slice_body(enable_rc, bytes_new_idx, bytes_get_idx, bytes_push_idx), 2, 1, 8)\\n  push_builtin(gen_bytes_from_array_body(enable_rc, arr_len_idx, arr_get_idx, bytes_new_idx, bytes_push_idx), 2, 1, 3)\\n  push_builtin(gen_bytes_to_array_body(enable_rc, arr_new_idx, arr_push_idx, bytes_len_idx, bytes_get_idx), 2, 1, 3)\\n  if enable_rc {\\n    push_builtin(gen_rc_drop_body(rc_drop_idx, rc_shadow), 5, 1, 1)\\n    push_builtin(gen_rc_alloc_body(rc_shadow), 4, 0, 3)\\n  } else {\\n    ()\\n  }\\n  push_builtin(gen_heap_grow_check_body(), 0, 0, 2)\\n  push_builtin(gen_simd_skip_ws_body(enable_rc), 2, 2, 8)\\n  push_builtin(gen_simd_scan_alnum_body(enable_rc, false), 1, 3, 8)\\n  push_builtin(gen_simd_scan_alnum_body(enable_rc, true), 1, 3, 8)\\n  push_builtin(gen_str_lex_diff_body(enable_rc), 7, 0, 4)\\n  // #708: one counter cell shared across every function's lift pass, so each\\n  // lift site gets a distinct `__m_scrut_N` name (see lift_match_scrutinees).\\n  let m_scrut_counter = [0]\\n  // #712: one counter cell shared across every function's uniquify pass, so\\n  // every renamed shadow gets a distinct `__shadow_N_<name>` (see\\n  // uniquify_shadowed_bindings).\\n  let uq_shadow_counter = [0]\\n  // #799 perf: ONE membership index over the flat fn + ctor name tables,\\n  // shared by every per-function CompileCtx below. collect_free_vars_indexed\\n  // consults it per ident instead of linearly scanning ~thousands of names\\n  // (which dominated compiler-closure compile profiles).\\n  // Round 2: a SORTED array + binary search -- the previous MapBuilder index\\n  // was O(N^2) to build (set scans for duplicates) and O(N) per has_key.\\n  let capture_index_names = lc_fresh_string_array()\\n  let mut cib_i = 0\\n  while cib_i < Array::length(all_fn_names_list) {\\n    Array::push(capture_index_names, Array::get(all_fn_names_list, cib_i))\\n    cib_i = cib_i + 1\\n  }\\n  let mut cib_j = 0\\n  while cib_j < Array::length(ctor_names_list) {\\n    Array::push(capture_index_names, Array::get(ctor_names_list, cib_j))\\n    cib_j = cib_j + 1\\n  }\\n  let capture_name_index_shared = sorted_names_of(capture_index_names)\\n  let mut bi = 0\\n  while bi < num_user_funcs {\\n    let __bi_stmt = Array::get(stmts, Array::get(fn_stmt_indices, bi))\\n    // #703 follow-up: under RC, lift temporary match scrutinees into lets so the\\n    // Perceus pass (which drops named bindings) reclaims them. Applied here, the\\n    // SAME transformed body feeds both build_perceus_plan (below) and the body\\n    // compilation, keeping the plan and codegen consistent. Non-RC is unchanged.\\n    //\\n    // #712: before lifting scrutinees, alpha-rename any binding that shadows an\\n    // enclosing one (within this same function) to a fresh unique name, so RC\\n    // codegen's name-keyed bookkeeping (heap_binding_names, rc_drop_names,\\n    // rc_alias_dup_names, rc_dup_names, loop_borrowed_names, and the Perceus\\n    // plan itself) can never confuse two distinct bindings that happen to share\\n    // a name. See uniquify_shadowed_bindings's doc comment (normalize/index.vibe).\\n    let __bi_expr = if enable_rc {\\n      // #715: fresh per-function seen-set -- name uniqueness is only required\\n      // within one function (Perceus plans and codegen bookkeeping are\\n      // per-function), and per-function reset keeps first binders unrenamed.\\n      let uq_seen: Array[String] = [\\n      ]\\n      lift_match_scrutinees(uniquify_shadowed_bindings(get_slet_expr(__bi_stmt), Map::new(), uq_shadow_counter, uq_seen), m_scrut_counter)\\n    } else {\\n      get_slet_expr(__bi_stmt)\\n    }\\n    let body_buf = bytebuf_new()\\n    // #cov: mark this user function as executed (store 1 at cov_base + bi).\\n    // Stack-neutral and local-free, so prepending it to the body is safe.\\n    if coverage {\\n      emit_i32_const(body_buf, cov_base + bi)\\n      emit_i32_const(body_buf, 1)\\n      emit_i32_store8(body_buf, 0, 0)\\n      // #cov branch: tell branch instrumentation which function owns the branches\\n      // emitted while compiling this body.\\n      Array::set(cov_state.cur_fn, 0, bi)\\n    } else {\\n      ()\\n    }\\n    // debugger trace (DAP P1 groundwork): in debug mode, append this user\\n    // function's index `bi` to the in-memory trace log when there is still room.\\n    // Stack-neutral and local-free, so prepending it to the body is safe:\\n    //   if load[counter_addr] < cap {\\n    //     store[log_base + load[counter_addr]*4] = bi\\n    //     store[counter_addr] = load[counter_addr] + 1\\n    //   }\\n    // `counter` is reloaded from memory each time (idempotent), avoiding locals.\\n    if debug_trace {\\n      emit_i32_const(body_buf, trace_counter_addr)\\n      emit_i32_load(body_buf, 2, 0)\\n      emit_i32_const(body_buf, trace_cap)\\n      emit_i32_ge_u(body_buf)\\n      emit_i32_eqz(body_buf)\\n      emit_if_void(body_buf)\\n      // store[log_base + counter*4] = bi\\n      emit_i32_const(body_buf, trace_log_base)\\n      emit_i32_const(body_buf, trace_counter_addr)\\n      emit_i32_load(body_buf, 2, 0)\\n      emit_i32_const(body_buf, 4)\\n      emit_i32_mul(body_buf)\\n      emit_i32_add(body_buf)\\n      emit_i32_const(body_buf, bi)\\n      emit_i32_store(body_buf, 2, 0)\\n      // store[counter_addr] = counter + 1\\n      emit_i32_const(body_buf, trace_counter_addr)\\n      emit_i32_const(body_buf, trace_counter_addr)\\n      emit_i32_load(body_buf, 2, 0)\\n      emit_i32_const(body_buf, 1)\\n      emit_i32_add(body_buf)\\n      emit_i32_store(body_buf, 2, 0)\\n      emit_end(body_buf)\\n    } else {\\n      ()\\n    }\\n    // #715: computed here, BEFORE the `debug_break` block below, and reused by\\n    // it via `Array::length(lc_norm_params)` instead of a second independent\\n    // `is_efn(__bi_expr)`/`get_efn_params(__bi_expr)` call. Both accessors\\n    // unconditionally rc_drop their argument, so each call is a real \\\"use\\\" of\\n    // `__bi_expr` for Perceus's purposes; having it called from BOTH branches\\n    // of the (usually-false) `if debug_break` AND unconditionally right after\\n    // made the `if debug_break {...} else {...}` construct's `then` branch\\n    // statically \\\"consume\\\" 2 extra units of `__bi_expr`'s remaining-use budget\\n    // that, in the overwhelmingly common `debug_break == false` case, never\\n    // actually execute. perceus/index.vibe's `pc_emit` EIf handling takes the\\n    // MIN of the two branches' resulting `remaining` and carries it forward\\n    // (see the #705 comment there) to avoid double-freeing a value fully\\n    // consumed on the taken branch -- but that also means the *lower* (more-\\n    // consuming) branch's count wins even when it is the branch that is\\n    // essentially never taken, permanently starving the dup budget needed by\\n    // `__bi_expr`'s later, always-executed uses below (`lc_norm_params` itself\\n    // was one of them) and eventually causing a use of an already-freed\\n    // pointer (#715's free-list corruption during RC self-hosting). Hoisting\\n    // this computation out from under `debug_break` removes the only\\n    // asymmetric-branch use of `__bi_expr` in this function (the other\\n    // `is_efn(__bi_expr)`-gated branches all have `is_efn(__bi_expr)` true on\\n    // effectively every real program, so their MIN-selected branch already\\n    // matches the branch actually taken).\\n    // #715: `get_slet_type(__bi_stmt)` hoisted out of the `is_efn(__bi_expr)`\\n    // `then` branch and computed here, unconditionally -- previously it was\\n    // the ONLY use of `__bi_stmt` inside this specific `if`'s `then` branch\\n    // (the `else` branch, `Array::slice([(\\\"\\\",None)],0,0)`, never touches\\n    // `__bi_stmt`), and `__bi_expr` is NOT an EFn for every `bi` iteration:\\n    // `fn_names_list`/`fn_stmt_indices` also carry thunk entries (see the\\n    // classification loop above), so the `else` path here is a real, common\\n    // occurrence, not a rare edge case. Same leak mechanism as the\\n    // `lc_norm_params`/`__bi_body`/`dn_expr`/classification-loop fixes above\\n    // -- `pc_emit`'s EIf MIN-merge (#705) otherwise permanently assumes the\\n    // `then`-branch's higher `__bi_stmt` consumption even on thunk (`else`)\\n    // iterations, leaking `__bi_stmt` (a heap Stmt node) on each one.\\n    let __sf_slet_type = get_slet_type(__bi_stmt)\\n    let lc_norm_params = if is_efn(__bi_expr) {\\n      let ps = get_efn_params(__bi_expr)\\n      let sig_args_raw = fn_type_param_types(__sf_slet_type)\\n      let single_tuple_param = match sig_args_raw {\\n        Some(a) => Array::length(ps) == 1 && Array::length(a) > 1,\\n        None => false\\n      }\\n      let np = Array::slice(ps, 0, 0)\\n      let mut spi = 0\\n      while spi < Array::length(ps) {\\n        let (sraw, sty) = Array::get(ps, spi)\\n        let slen = String::length(sraw)\\n        let ssn = if slen > 0 {\\n          let slc = String::char_code_at(sraw, slen - 1)\\n          if slc == '~' || slc == '?' {\\n            sraw[0: slen - 1]\\n          } else {\\n            sraw\\n          }\\n        } else {\\n          sraw\\n        }\\n        let resolved_ty = match sty {\\n          Some(_) => sty,\\n          None =>\\n          match sig_args_raw {\\n            Some(args) =>\\n            if single_tuple_param {\\n              Some(TyTuple(args))\\n            } else if Array::length(args) == Array::length(ps) {\\n              Some(Array::get(args, spi))\\n            } else {\\n              None\\n            },\\n            None => None\\n          }\\n        }\\n        Array::push(np, (ssn, resolved_ty))\\n        spi = spi + 1\\n      }\\n      np\\n    } else {\\n      // #715: alias `__sf_slet_type` once here too, matching `then`'s single\\n      // use (via `fn_type_param_types`) now that it is hoisted above -- see\\n      // that binding's doc comment.\\n      let __sf_lnp_ty = __sf_slet_type\\n      Array::slice([\\n        (\\\"\\\", None)\\n      ], 0, 0)\\n    }\\n    // debugger breakpoint (DAP P1): in break mode, call the host hook\\n    // `vibe::dbg_break` at this user function's entry. The hook inspects the\\n    // wasm backtrace to name the entering function and pauses when it is in the\\n    // breakpoint set. Stack-neutral (() -> ()), so prepending is safe.\\n    if debug_break {\\n      // DAP P2: spill this function's i64 parameters into the dbgargs region so\\n      // the host hook can read and print them. All user-function wasm params are\\n      // i64 (vibe value ABI); locals 0..nparams-1 hold the params at entry.\\n      let dbg_nparams = Array::length(lc_norm_params)\\n      let dbg_n = if dbg_nparams > dbgargs_cap {\\n        dbgargs_cap\\n      } else {\\n        dbg_nparams\\n      }\\n      let mut dbg_pi = 0\\n      while dbg_pi < dbg_n {\\n        emit_i32_const(body_buf, dbgargs_base + dbg_pi * 8)\\n        emit_local_get(body_buf, dbg_pi)\\n        emit_i64_store(body_buf, 3, 0)\\n        dbg_pi = dbg_pi + 1\\n      }\\n      emit_i32_const(body_buf, dbgargs_count_addr)\\n      emit_i32_const(body_buf, dbg_n)\\n      emit_i32_store(body_buf, 2, 0)\\n      emit_call(body_buf, dbg_break_import_idx)\\n    } else {\\n      ()\\n    }\\n    let local_names = lc_fresh_string_array()\\n    let fn_name_dbg = Array::get(fn_names_list, bi)\\n    let rc_drops = Array::slice([\\n      \\\"\\\"\\n    ], 0, 0)\\n    let rc_alias_dups = Array::slice([\\n      \\\"\\\"\\n    ], 0, 0)\\n    let rc_dups = Array::slice([\\n      \\\"\\\"\\n    ], 0, 0)\\n    let lc_heap_params = lc_fresh_string_array()\\n    // #715: computed once, unconditionally (regardless of `enable_rc`), and\\n    // reused below both for the Perceus plan and for the actual codegen call\\n    // to `compile_expr` -- instead of a separate `get_efn_body(__bi_expr)`\\n    // call under `enable_rc` (as `fbody`) AND another one further down (as\\n    // `body`, inside the `is_efn(__bi_expr)` block). Each independent\\n    // `get_efn_body(__bi_expr)`/`get_efn_params(__bi_expr)` call is a real\\n    // additional owning \\\"use\\\" of `__bi_expr` for Perceus's purposes (neither\\n    // is registered in `is_borrow_arg0_call`), inflating the dup budget\\n    // `__bi_expr` statically needs. See the `lc_norm_params` doc comment\\n    // above (the same redundant-call pattern, already fixed once for\\n    // `get_efn_params`) for the full double-free mechanism this avoids.\\n    let __bi_body = if is_efn(__bi_expr) {\\n      get_efn_body(__bi_expr)\\n    } else {\\n      __bi_expr\\n    }\\n    if enable_rc {\\n      let plan = build_perceus_plan_with_params(lc_norm_params, __bi_body, lc_borrow_ret_names)\\n      let mut lhpi = 0\\n      while lhpi < Array::length(lc_norm_params) {\\n        let (lhpn, lhpt) = Array::get(lc_norm_params, lhpi)\\n        if param_is_heap_in_body(lhpn, lhpt, __bi_body) {\\n          Array::push(lc_heap_params, lhpn)\\n        } else {\\n          ()\\n        }\\n        lhpi = lhpi + 1\\n      }\\n      let mut di = 0\\n      while di < Array::length(plan) {\\n        let pa = Array::get(plan, di)\\n        if pa_is_drop(pa) {\\n          Array::push(rc_drops, pa.name)\\n        } else if pa_is_alias_dup(pa) {\\n          Array::push(rc_alias_dups, pa.name)\\n        } else if pa_is_dup(pa) {\\n          Array::push(rc_dups, pa.name)\\n        } else {\\n          ()\\n        }\\n        di = di + 1\\n      }\\n    }\\n    // Interior-line breakpoints: this function's source file id + that file's\\n    // newline index (for mapping its statement offsets to lines). Off => 0/empty.\\n    let dbg_fid = if dbg_line_on {\\n      Array::get(prov.stmt_file_id, Array::get(fn_stmt_indices, bi))\\n    } else {\\n      0\\n    }\\n    let dbg_nls = if dbg_line_on {\\n      Array::get(prov.file_nls, dbg_fid)\\n    } else {\\n      lc_fresh_int_array()\\n    }\\n    let compile_ctx = CompileCtx::{\\n      func_table: FuncTable::{\\n        names: all_fn_names_list,\\n        indices: all_fn_indices_list,\\n        params: all_fn_param_counts,\\n        returns: all_fn_returns_list,\\n        needs_env: all_fn_needs_env_list\\n      },\\n      str_table: StrTable::{\\n        strs: str_strs, offsets: str_offsets, lengths: str_lengths\\n      },\\n      lambda_table: lt_w,\\n      num_user_funcs: num_user_funcs, func_offset: func_offset,\\n      ref_cell_names: lc_fresh_string_array(),\\n      ctor_table: CtorTable::{\\n        names: ctor_names_list, tags: ctor_tags_list, field_counts: ctor_field_counts_list, type_names: ctor_type_names_list, struct_names: struct_names, struct_field_names: struct_field_names, names_sorted: lc_ctor_names_sorted, names_sorted_pos: lc_ctor_names_sorted_pos\\n      },\\n      thunk_names: thunk_names_list,\\n      const_int_names: const_int_names_list,\\n      const_int_values: const_int_values_list,\\n      enable_rc: enable_rc,\\n      rc_shadow: rc_shadow,\\n      rc_drop_names: rc_drops,\\n      rc_alias_dup_names: rc_alias_dups,\\n      heap_binding_names: lc_heap_params,\\n      rc_drop_func_idx: if enable_rc {\\n        rc_drop_idx\\n      } else {\\n        -1\\n      },\\n      rc_alloc_func_idx: if enable_rc {\\n        rc_alloc_idx\\n      } else {\\n        -1\\n      },\\n      heap_grow_check_func_idx: heap_grow_check_idx,\\n      rc_dup_names: rc_dups,\\n      capture_name_index: capture_name_index_shared,\\n      float_local_slots: lc_fresh_int_array(),\\n      int_local_slots: lc_fresh_int_array(),\\n      agg_local_slots: lc_fresh_int_array(),\\n      agg_local_exprs: lc_fresh_expr_array(),\\n      agg_ret_names: lc_agg_ret_names,\\n      agg_ret_infos: lc_agg_ret_infos,\\n      heap_ret_names: lc_heap_ret_names,\\n      effect_names: effect_names_list,\\n      effect_op_keys: effect_op_keys_list,\\n      effect_op_arities: effect_op_arities_list,\\n      cov: cov_state,\\n      dbg_line_idx: dbg_line_import_idx,\\n      dbg_line_nl: dbg_nls,\\n      dbg_line_file_id: dbg_fid,\\n      loop_borrowed_names: lc_fresh_string_array(),\\n      loop_consumed_names: lc_fresh_string_array(),\\n      borrow_ret_names: lc_borrow_ret_names,\\n      scalar_ret_names: lc_scalar_ret_names,\\n      pending_letrec_self_name: lc_fresh_string_array()\\n    }\\n    if is_efn(__bi_expr) {\\n      // #715: `lc_norm_params` (built above from `get_efn_params(__bi_expr)`)\\n      // already carries each parameter's `~`/`?`-stripped name in `.0` --\\n      // reuse it instead of a second `get_efn_params(__bi_expr)` call plus a\\n      // duplicate stripping pass (see the `__bi_body` doc comment above).\\n      let body = __bi_body\\n      let mut pi = 0\\n      while pi < Array::length(lc_norm_params) {\\n        let (pname, _) = Array::get(lc_norm_params, pi)\\n        Array::push(local_names, pname)\\n        pi = pi + 1\\n      }\\n      // #724 round 2: seed the aggregate-shape log from ANNOTATED params\\n      // (param slot i = local i), so `p == q` on tuple/struct/enum-typed\\n      // params compares structurally.\\n      let sig_ptypes = fn_type_param_types(__sf_slet_type)\\n      let mut psi = 0\\n      while psi < Array::length(lc_norm_params) {\\n        // Prefer the SLet signature's param types (`let f: (P2) -> ..`);\\n        // fall back to a per-param annotation (`(p: P2) -> ..`).\\n        let pann = match sig_ptypes {\\n          Some(pts) => if Array::length(pts) == Array::length(lc_norm_params) {\\n            Some(Array::get(pts, psi))\\n          } else {\\n            let (_, pa) = Array::get(lc_norm_params, psi)\\n            pa\\n          },\\n          None => {\\n            let (_, pa) = Array::get(lc_norm_params, psi)\\n            pa\\n          }\\n        }\\n        match pann {\\n          Some(pte) => {\\n            let pinfo = agg_info_of_type_expr(compile_ctx.ctor_table, pte)\\n            if pinfo > 0 {\\n              Array::push(compile_ctx.agg_local_slots, psi * 256 + pinfo)\\n              // #811: agg_local_exprs is the index-aligned PARALLEL of\\n              // agg_local_slots (agg_log_reset_above2 prunes both in\\n              // lockstep, reading exprs[i] for every slots[i]). This param\\n              // seed pushed only to slots, leaving exprs one entry short —\\n              // every later reset then read exprs out of bounds and\\n              // compacted the garbage back in. Push the same \\\"no shape\\n              // expr\\\" placeholder the let-binding site uses.\\n              Array::push(compile_ctx.agg_local_exprs, EInt(0))\\n            } else {\\n              ()\\n            }\\n            // Float/Double-typed params feed expr_is_floatish the same way\\n            // let-bound floats do; without this, `a == b` on annotated float\\n            // params misses the f64 path and (under RC, where floats are\\n            // boxed) compares heap pointers — `1.5 == 1.5` came out false.\\n            match pte {\\n              TyName(ptn) => if ptn == \\\"Float\\\" || ptn == \\\"Double\\\" {\\n                Array::push(compile_ctx.float_local_slots, psi * 2 + 1)\\n              } else {\\n                ()\\n              },\\n              _ => ()\\n            }\\n          },\\n          None => ()\\n        }\\n        psi = psi + 1\\n      }\\n      Array::push(local_names, \\\"__env\\\")\\n      let param_count = Array::length(lc_norm_params) + 1\\n      if enable_rc {\\n        let mut edi = 0\\n        while edi < Array::length(lc_norm_params) {\\n          let (edn, _edt) = Array::get(lc_norm_params, edi)\\n          if array_contains_str(lc_heap_params, edn) {\\n            let mut edc = 0\\n            let mut edj = 0\\n            while edj < Array::length(rc_dups) {\\n              if Array::get(rc_dups, edj) == edn {\\n                edc = edc + 1\\n              } else {\\n                ()\\n              }\\n              edj = edj + 1\\n            }\\n            let mut ede = 0\\n            while ede < edc {\\n              emit_rc_dup_guarded(body_buf, edi, rc_shadow)\\n              ede = ede + 1\\n            }\\n          } else {\\n            ()\\n          }\\n          edi = edi + 1\\n        }\\n      } else {\\n        ()\\n      }\\n      // #805: an inline-wasm fn's instruction bytes come from the WAT\\n      // assembler, not compile_expr (its AST body is a neutral EInt(0) after\\n      // lc_extract_inline_wasm). Params are Int-only (parser-enforced), so\\n      // no RC/Perceus bookkeeping applies; no extra locals are introduced\\n      // (final_nl == param_count => meta extra 0).\\n      let mut iw_found = -1\\n      let mut iw_scan = 0\\n      while iw_scan < Array::length(iw_names) {\\n        if Array::get(iw_names, iw_scan) == fn_name_dbg {\\n          iw_found = iw_scan\\n          iw_scan = Array::length(iw_names)\\n        } else {\\n          iw_scan = iw_scan + 1\\n        }\\n      }\\n      let final_nl = if iw_found >= 0 {\\n        let iw_param_names = lc_fresh_string_array()\\n        let mut iw_pi = 0\\n        while iw_pi < Array::length(lc_norm_params) {\\n          let (iw_pn, _) = Array::get(lc_norm_params, iw_pi)\\n          Array::push(iw_param_names, iw_pn)\\n          iw_pi = iw_pi + 1\\n        }\\n        bytebuf_push_buf(body_buf, compile_inline_wat(fn_name_dbg, Array::get(iw_wats, iw_found), iw_param_names))\\n        param_count\\n      } else {\\n        compile_expr(body_buf, body, local_names, param_count, compile_ctx, -1)\\n      }\\n      let mut tail_nl = final_nl\\n      if enable_rc && rc_drop_idx >= 0 {\\n        let tail_root = scope_tail_proj_root(body)\\n        // #706 leak follow-up: a loop-borrowed param's protective rc_dup (see\\n        // compile_call.vibe's cc_is_loop_borrowed_ident sites) is matched by the\\n        // callee's OWN internal drop each iteration — it never touches this\\n        // function's own slot-held reference. The Perceus plan still counts that\\n        // textual occurrence as \\\"one real consume\\\" (so `remaining` hits 0 and no\\n        // PaDrop is emitted), leaking the binding's own reference once per such\\n        // occurrence. Count each param's occurrences in loop_consumed_names and\\n        // emit that many EXTRA rc_drop calls here — purely additive to the\\n        // existing rc_drops accounting, so it cannot perturb any decision the\\n        // plan and codegen already agree on elsewhere.\\n        let mut need_dup = false\\n        let mut tci = 0\\n        while tci < Array::length(lc_norm_params) {\\n          let (tcn, _tct) = Array::get(lc_norm_params, tci)\\n          let mut tcn_loop_extra = 0\\n          let mut tcle = 0\\n          while tcle < Array::length(compile_ctx.loop_consumed_names) {\\n            if Array::get(compile_ctx.loop_consumed_names, tcle) == tcn {\\n              tcn_loop_extra = tcn_loop_extra + 1\\n            } else {\\n              ()\\n            }\\n            tcle = tcle + 1\\n          }\\n          if array_contains_str(lc_heap_params, tcn) && (array_contains_str(rc_drops, tcn) || tcn_loop_extra > 0) && tcn == tail_root {\\n            need_dup = true\\n          } else {\\n            ()\\n          }\\n          tci = tci + 1\\n        }\\n        let rtemp = final_nl\\n        if need_dup {\\n          emit_local_set(body_buf, rtemp)\\n          emit_rc_dup_guarded(body_buf, rtemp, rc_shadow)\\n          tail_nl = final_nl + 1\\n        } else {\\n          ()\\n        }\\n        let mut tdj = 0\\n        while tdj < Array::length(lc_norm_params) {\\n          let (tdn, _tdt) = Array::get(lc_norm_params, tdj)\\n          if array_contains_str(lc_heap_params, tdn) {\\n            // #725: a loop-protected consume (per-iteration dup at the call\\n            // site, #706 above) is NET-ZERO at runtime — the dup is matched by\\n            // the callee's own drop each execution and never touches the\\n            // param's single owned reference. So the epilogue owes EXACTLY ONE\\n            // drop for that reference, regardless of how many textual\\n            // loop-consumed SITES exist: a second site in a sibling match arm\\n            // (even one that never executes — its protective dup is emitted\\n            // but never runs) previously got its own per-occurrence drop,\\n            // over-releasing the CALLER's value and poisoning the RC free\\n            // list (fuzz/findings/issue725/). When a loop site exists it also\\n            // absorbs the plan's PaDrop (the textual counts ate the budget the\\n            // plan would otherwise drop), so emit one drop total either way.\\n            let mut tdn_loop_count = 0\\n            let mut tdle = 0\\n            while tdle < Array::length(compile_ctx.loop_consumed_names) {\\n              if Array::get(compile_ctx.loop_consumed_names, tdle) == tdn {\\n                tdn_loop_count = tdn_loop_count + 1\\n              } else {\\n                ()\\n              }\\n              tdle = tdle + 1\\n            }\\n            if array_contains_str(rc_drops, tdn) || tdn_loop_count > 0 {\\n              emit_local_get(body_buf, tdj)\\n              emit_call(body_buf, rc_drop_idx)\\n            } else {\\n              ()\\n            }\\n          } else {\\n            ()\\n          }\\n          tdj = tdj + 1\\n        }\\n        if need_dup {\\n          emit_local_get(body_buf, rtemp)\\n        } else {\\n          ()\\n        }\\n      } else {\\n        ()\\n      }\\n      if enable_rc && fn_name_dbg == entry_name {\\n        emit_i64_const(body_buf, 1)\\n        emit_i64_shr_s(body_buf)\\n      }\\n      Array::push(bodies, body_buf)\\n      let extra = if tail_nl > param_count {\\n        tail_nl - param_count\\n      } else {\\n        0\\n      }\\n      Array::push(meta_i32, 0)\\n      Array::push(meta_i64, extra)\\n    } else {\\n      // Module-level non-function `let` (a THUNK): previously the initializer\\n      // re-ran on EVERY reference, so a 16-entry lookup table cost an O(size)\\n      // allocation per access (~148 B/call in bench/_probe_sb_phases.vibe)\\n      // and, worse, each access saw a FRESH value while the gc backend\\n      // initializes module globals ONCE — a cross-backend semantics split\\n      // (mutations visible there, lost here). Memoize: two appended i64\\n      // globals per thunk (value + init flag; base index rc?7:6, after\\n      // g_op_index). First call computes and caches, later calls reload.\\n      // Under RC the cache holds one permanent reference and every return\\n      // (both paths) hands the caller a guarded-dup'd reference, so consumer\\n      // drops balance exactly like the old fresh-value contract.\\n      Array::push(local_names, \\\"__env\\\")\\n      let param_count = 1\\n      let mut tg_k = -1\\n      let mut tg_i = 0\\n      while tg_i < Array::length(thunk_names_list) {\\n        if Array::get(thunk_names_list, tg_i) == fn_name_dbg {\\n          tg_k = tg_i\\n          tg_i = Array::length(thunk_names_list)\\n        } else {\\n          tg_i = tg_i + 1\\n        }\\n      }\\n      let tg_base = if enable_rc {\\n        7\\n      } else {\\n        6\\n      }\\n      let tg_value_g = tg_base + tg_k * 2\\n      let tg_flag_g = tg_value_g + 1\\n      emit_global_get(body_buf, tg_flag_g)\\n      emit_i32_wrap_i64(body_buf)\\n      emit_if_i64(body_buf)\\n      emit_global_get(body_buf, tg_value_g)\\n      emit_local_tee(body_buf, 1)\\n      if enable_rc {\\n        emit_rc_dup_guarded(body_buf, 1, rc_shadow)\\n      } else {\\n        ()\\n      }\\n      emit_else(body_buf)\\n      Array::push(local_names, \\\"__thunk_memo\\\")\\n      let final_nl = compile_expr(body_buf, __bi_expr, local_names, 2, compile_ctx, -1)\\n      emit_local_tee(body_buf, 1)\\n      emit_global_set(body_buf, tg_value_g)\\n      if enable_rc {\\n        emit_rc_dup_guarded(body_buf, 1, rc_shadow)\\n      } else {\\n        ()\\n      }\\n      emit_i64_const(body_buf, 1)\\n      emit_global_set(body_buf, tg_flag_g)\\n      emit_local_get(body_buf, 1)\\n      emit_end(body_buf)\\n      if enable_rc && fn_name_dbg == entry_name {\\n        emit_i64_const(body_buf, 1)\\n        emit_i64_shr_s(body_buf)\\n      }\\n      Array::push(bodies, body_buf)\\n      let extra = if final_nl > param_count {\\n        final_nl - param_count\\n      } else {\\n        0\\n      }\\n      Array::push(meta_i32, 0)\\n      Array::push(meta_i64, extra)\\n    }\\n    bi = bi + 1\\n  }\\n  let num_lambdas = Array::length(lt_w.bodies)\\n  let start_body = bytebuf_new()\\n  let entry_func_idx = if entry_user_idx >= 0 {\\n    entry_user_idx + func_offset\\n  } else {\\n    -1\\n  }\\n  // ADR-0069: the synthesized `_start` prints the entry's Int return via\\n  // print_int (the historical `let main: () -> Int` convention), but a\\n  // Unit-returning entry (`fn main {}` desugars to `() -> Unit`, and any\\n  // explicit `let main: () -> Unit`) must NOT print — the old behavior\\n  // appended a stray `0` line after the program's own output. Detect Unit\\n  // from the entry's declared return type: the EFn return annotation or the\\n  // binding's `: (..) -> Unit` type annotation.\\n  let mut entry_returns_unit = false\\n  if entry_user_idx >= 0 {\\n    let mut eri = 0\\n    while eri < Array::length(stmts) {\\n      match Array::get(stmts, eri) {\\n        SLet(_, _, ename, eann, eval) => if ename == entry_name {\\n          let ann_unit = match eann {\\n            Some(TyFn(_, ann_ret, _)) => linked_type_expr_is_unit(ann_ret),\\n            _ => false\\n          }\\n          let ret_unit = match eval {\\n            EFn(_, _, _, efn_ret, _, _) => match efn_ret {\\n              Some(rt) => linked_type_expr_is_unit(rt),\\n              None => false\\n            },\\n            _ => false\\n          }\\n          if ann_unit || ret_unit {\\n            entry_returns_unit = true\\n          }\\n        },\\n        _ => ()\\n      }\\n      eri = eri + 1\\n    }\\n  }\\n  if entry_user_idx >= 0 {\\n    let entry_params = Array::get(fn_param_counts, entry_user_idx)\\n    if entry_params != 0 {\\n      throw(\\\"WASI entry function must take 0 parameters\\\")\\n    }\\n    emit_i64_const(start_body, 0)\\n    emit_call(start_body, entry_func_idx)\\n    if entry_returns_unit {\\n      emit_drop(start_body)\\n    } else {\\n      emit_call(start_body, print_int_idx)\\n    }\\n  } else {\\n    let mut sti = 0\\n    while sti < Array::length(test_fn_names) {\\n      let stname = Array::get(test_fn_names, sti)\\n      let mut __stj = 0\\n      let mut __stf = -1\\n      while __stj < Array::length(fn_names_list) {\\n        if Array::get(fn_names_list, __stj) == stname {\\n          __stf = __stj\\n        }\\n        __stj = __stj + 1\\n      }\\n      if __stf >= 0 {\\n        emit_i64_const(start_body, 0)\\n        emit_call(start_body, func_offset + __stf)\\n        emit_drop(start_body)\\n      }\\n      sti = sti + 1\\n    }\\n  }\\n  Array::push(bodies, start_body)\\n  Array::push(meta_i32, 0)\\n  Array::push(meta_i64, 0)\\n  let run_body = bytebuf_new()\\n  if entry_func_idx >= 0 {\\n    emit_i64_const(run_body, 0)\\n    emit_call(run_body, entry_func_idx)\\n  } else {\\n    let mut rti = 0\\n    while rti < Array::length(test_fn_names) {\\n      let tname = Array::get(test_fn_names, rti)\\n      let mut __rtj = 0\\n      let mut __rtf = -1\\n      while __rtj < Array::length(fn_names_list) {\\n        if Array::get(fn_names_list, __rtj) == tname {\\n          __rtf = __rtj\\n        }\\n        __rtj = __rtj + 1\\n      }\\n      if __rtf >= 0 {\\n        emit_i64_const(run_body, 0)\\n        emit_call(run_body, func_offset + __rtf)\\n        emit_drop(run_body)\\n      }\\n      rti = rti + 1\\n    }\\n    emit_i64_const(run_body, 0)\\n  }\\n  Array::push(bodies, run_body)\\n  Array::push(meta_i32, 0)\\n  Array::push(meta_i64, 0)\\n  let mut li = 0\\n  while li < num_lambdas {\\n    Array::push(bodies, Array::get(lt_w.bodies, li))\\n    Array::push(meta_i32, Array::get(lt_w.meta_i32, li))\\n    Array::push(meta_i64, Array::get(lt_w.meta_i64, li))\\n    li = li + 1\\n  }\\n  let mut max_closure_arity = -1\\n  let mut lai = 0\\n  while lai < num_lambdas {\\n    let lpc = Array::get(lt_w.param_counts, lai) - 1\\n    if lpc > max_closure_arity {\\n      max_closure_arity = lpc\\n    }\\n    lai = lai + 1\\n  }\\n  let mut uai = 0\\n  while uai < num_user_funcs {\\n    let upc = Array::get(fn_param_counts, uai)\\n    if upc > max_closure_arity {\\n      max_closure_arity = upc\\n    }\\n    uai = uai + 1\\n  }\\n  let mut iai = 0\\n  while iai < Array::length(linked_imports) {\\n    let (_, _, ipc, _) = Array::get(linked_imports, iai)\\n    if ipc > max_closure_arity {\\n      max_closure_arity = ipc\\n    }\\n    iai = iai + 1\\n  }\\n  let num_closure_types = if max_closure_arity >= 0 {\\n    max_closure_arity + 1\\n  } else {\\n    0\\n  }\\n  // Interior-line breakpoints (span-arc step5): when active, the `vibe::dbg_line`\\n  // import needs an `(i32) -> ()` func type. No existing base type is `(i32)->()`\\n  // (type 1 is `(i64)->()`), so append one new type AFTER all base + closure\\n  // types at index `num_base_types + num_closure_types`. This is strictly beyond\\n  // every linked-import type index (which use `num_base_types + lparams`, bounded\\n  // by num_closure_types), so existing indices are unshifted. -1 when off.\\n  let dbg_line_type_idx = if dbg_line_on {\\n    num_base_types + num_closure_types\\n  } else {\\n    -1\\n  }\\n  let extra_dbg_types = if dbg_line_on {\\n    1\\n  } else {\\n    0\\n  }\\n  // #794: `vibe.http_request` needs an `(i64,i64,i64,i64) -> i64` func type.\\n  // No base type has 4 i64 params, and closure types are data-dependent (only\\n  // present up to the max closure arity in the unit), so append one dedicated\\n  // type AFTER base + closure + dbg types when the import is live. Off =>\\n  // byte-identical type section (fixpoint-safe).\\n  let http_request_type_idx = if need_http_request_builtin {\\n    num_base_types + num_closure_types + extra_dbg_types\\n  } else {\\n    -1\\n  }\\n  let extra_http_types = if need_http_request_builtin {\\n    1\\n  } else {\\n    0\\n  }\\n  let type_content = bytebuf_new()\\n  bytebuf_push_vec_header(type_content, num_base_types + num_closure_types + extra_dbg_types + extra_http_types)\\n  emit_func_type_raw(type_content, [\\n    127,\\n    127,\\n    127,\\n    127\\n  ], [\\n    127\\n  ])\\n  emit_func_type_raw(type_content, [\\n    126\\n  ], Array::slice([\\n    0\\n  ], 0, 0))\\n  emit_func_type_raw(type_content, Array::slice([\\n    0\\n  ], 0, 0), Array::slice([\\n    0\\n  ], 0, 0))\\n  emit_func_type_raw(type_content, [\\n    126\\n  ], [\\n    126\\n  ])\\n  emit_func_type_raw(type_content, [\\n    126,\\n    126\\n  ], [\\n    126\\n  ])\\n  emit_func_type_raw(type_content, Array::slice([\\n    0\\n  ], 0, 0), [\\n    126\\n  ])\\n  emit_func_type_raw(type_content, [\\n    126,\\n    126\\n  ], Array::slice([\\n    0\\n  ], 0, 0))\\n  emit_func_type_raw(type_content, [\\n    126,\\n    126,\\n    126\\n  ], Array::slice([\\n    0\\n  ], 0, 0))\\n  emit_func_type_raw(type_content, [\\n    126,\\n    126,\\n    126\\n  ], [\\n    126\\n  ])\\n  let mut cti = 0\\n  while cti < num_closure_types {\\n    let num_params = cti + 1\\n    let ct_params = lc_fresh_int_array()\\n    let mut cpti = 0\\n    while cpti < num_params {\\n      Array::push(ct_params, 126)\\n      cpti = cpti + 1\\n    }\\n    emit_func_type_raw(type_content, ct_params, [\\n      126\\n    ])\\n    cti = cti + 1\\n  }\\n  // Interior-line breakpoints: append the `(i32, i32) -> ()` type for\\n  // `vibe::dbg_line` (127 = i32; params = file_id, line). Only when active, so the\\n  // type section is byte-identical off.\\n  if dbg_line_on {\\n    emit_func_type_raw(type_content, [\\n      127,\\n      127\\n    ], Array::slice([\\n      0\\n    ], 0, 0))\\n  } else {\\n    ()\\n  }\\n  // #794: the `(i64,i64,i64,i64) -> i64` type for vibe.http_request, appended\\n  // last so every other type index is unshifted.\\n  if need_http_request_builtin {\\n    emit_func_type_raw(type_content, [\\n      126,\\n      126,\\n      126,\\n      126\\n    ], [\\n      126\\n    ])\\n  } else {\\n    ()\\n  }\\n  let out = bytebuf_new()\\n  emit_header(out)\\n  emit_vibe_abi_custom_section(out, \\\"raw\\\")\\n  // #cov: emit a `vibe_cov` custom section describing the function-hit bitmap.\\n  // Layout of the payload: i32 LE cov_base, i32 LE cov_count, then the\\n  // user-function names (one per line, in bitmap-index order). The consumer\\n  // reads memory[cov_base .. cov_base+cov_count] after running and maps each\\n  // hit byte back to a name. Only present in coverage builds.\\n  if coverage {\\n    let cov_content = bytebuf_new()\\n    let cov_name = \\\"vibe_cov\\\"\\n    leb128_encode_u32(cov_content, String::length(cov_name))\\n    let mut cni = 0\\n    while cni < String::length(cov_name) {\\n      bytebuf_push(cov_content, String::char_code_at(cov_name, cni))\\n      cni = cni + 1\\n    }\\n    bytebuf_push(cov_content, cov_base & 255)\\n    bytebuf_push(cov_content, (cov_base >> 8) & 255)\\n    bytebuf_push(cov_content, (cov_base >> 16) & 255)\\n    bytebuf_push(cov_content, (cov_base >> 24) & 255)\\n    bytebuf_push(cov_content, cov_count & 255)\\n    bytebuf_push(cov_content, (cov_count >> 8) & 255)\\n    bytebuf_push(cov_content, (cov_count >> 16) & 255)\\n    bytebuf_push(cov_content, (cov_count >> 24) & 255)\\n    let mut covni = 0\\n    while covni < num_user_funcs {\\n      let covnm = Array::get(fn_names_list, covni)\\n      let covnml = String::length(covnm)\\n      let mut covci = 0\\n      while covci < covnml {\\n        bytebuf_push(cov_content, String::char_code_at(covnm, covci))\\n        covci = covci + 1\\n      }\\n      bytebuf_push(cov_content, 10)\\n      covni = covni + 1\\n    }\\n    bytebuf_push_section(out, 0, cov_content)\\n    // #cov branch: a `vibe_cov_branch` custom section describing the branch-hit\\n    // bitmap. Payload: i32 LE branch_base, i32 LE branch_count, then\\n    // branch_count i32 LE entries giving the owning user-function index per\\n    // branch id (in id order). The consumer reads memory[base .. base+count]\\n    // after running and attributes each hit branch to its function (names from\\n    // the `vibe_cov` section), so it can report per-function branch coverage.\\n    let covb_content = bytebuf_new()\\n    let covb_name = \\\"vibe_cov_branch\\\"\\n    leb128_encode_u32(covb_content, String::length(covb_name))\\n    let mut covbni = 0\\n    while covbni < String::length(covb_name) {\\n      bytebuf_push(covb_content, String::char_code_at(covb_name, covbni))\\n      covbni = covbni + 1\\n    }\\n    let covb_count = Array::get(cov_state.next, 0)\\n    bytebuf_push(covb_content, cov_branch_base & 255)\\n    bytebuf_push(covb_content, (cov_branch_base >> 8) & 255)\\n    bytebuf_push(covb_content, (cov_branch_base >> 16) & 255)\\n    bytebuf_push(covb_content, (cov_branch_base >> 24) & 255)\\n    bytebuf_push(covb_content, covb_count & 255)\\n    bytebuf_push(covb_content, (covb_count >> 8) & 255)\\n    bytebuf_push(covb_content, (covb_count >> 16) & 255)\\n    bytebuf_push(covb_content, (covb_count >> 24) & 255)\\n    let mut covbi = 0\\n    while covbi < covb_count {\\n      let owner = Array::get(cov_state.owners, covbi)\\n      bytebuf_push(covb_content, owner & 255)\\n      bytebuf_push(covb_content, (owner >> 8) & 255)\\n      bytebuf_push(covb_content, (owner >> 16) & 255)\\n      bytebuf_push(covb_content, (owner >> 24) & 255)\\n      covbi = covbi + 1\\n    }\\n    bytebuf_push_section(out, 0, covb_content)\\n  } else {\\n    ()\\n  }\\n  // debugger trace (DAP P1 groundwork): emit a `vibe.trace` custom section\\n  // describing the in-memory trace log. Payload layout: i32 LE counter_addr,\\n  // i32 LE log_base, i32 LE cap, then the user-function names (one per line, in\\n  // user-index order — the same list the name section uses). The runner reads\\n  // memory[counter_addr] for the count, then `count` i32 entries from log_base,\\n  // and maps each index to a name. Only present in debug-trace builds.\\n  if debug_trace {\\n    let tr_content = bytebuf_new()\\n    let tr_name = \\\"vibe.trace\\\"\\n    leb128_encode_u32(tr_content, String::length(tr_name))\\n    let mut trni = 0\\n    while trni < String::length(tr_name) {\\n      bytebuf_push(tr_content, String::char_code_at(tr_name, trni))\\n      trni = trni + 1\\n    }\\n    bytebuf_push(tr_content, trace_counter_addr & 255)\\n    bytebuf_push(tr_content, (trace_counter_addr >> 8) & 255)\\n    bytebuf_push(tr_content, (trace_counter_addr >> 16) & 255)\\n    bytebuf_push(tr_content, (trace_counter_addr >> 24) & 255)\\n    bytebuf_push(tr_content, trace_log_base & 255)\\n    bytebuf_push(tr_content, (trace_log_base >> 8) & 255)\\n    bytebuf_push(tr_content, (trace_log_base >> 16) & 255)\\n    bytebuf_push(tr_content, (trace_log_base >> 24) & 255)\\n    bytebuf_push(tr_content, trace_cap & 255)\\n    bytebuf_push(tr_content, (trace_cap >> 8) & 255)\\n    bytebuf_push(tr_content, (trace_cap >> 16) & 255)\\n    bytebuf_push(tr_content, (trace_cap >> 24) & 255)\\n    let mut trni2 = 0\\n    while trni2 < num_user_funcs {\\n      let trnm = Array::get(fn_names_list, trni2)\\n      let trnml = String::length(trnm)\\n      let mut trci = 0\\n      while trci < trnml {\\n        bytebuf_push(tr_content, String::char_code_at(trnm, trci))\\n        trci = trci + 1\\n      }\\n      bytebuf_push(tr_content, 10)\\n      trni2 = trni2 + 1\\n    }\\n    bytebuf_push_section(out, 0, tr_content)\\n  } else {\\n    ()\\n  }\\n  // debugger argument inspection (DAP P2): emit a `vibe.dbgargs` custom section\\n  // publishing the addresses + value ABI the runner reads. Payload layout:\\n  // i32 LE dbgargs_count_addr, i32 LE dbgargs_base, i32 LE tag_mode. At a\\n  // breakpoint the runner reads memory[count_addr] (i32) for the arg count, then\\n  // that many i64 values from dbgargs_base, decoding each per tag_mode:\\n  //   tag_mode 0 (enable_rc off): values are plain untagged i64 ints.\\n  //   tag_mode 1 (enable_rc on):  values are 1-bit tagged — low bit 0 => int\\n  //                               (raw >> 1), low bit 1 => heap pointer (hex).\\n  // Only present in break builds.\\n  if debug_break {\\n    let da_content = bytebuf_new()\\n    let da_name = \\\"vibe.dbgargs\\\"\\n    leb128_encode_u32(da_content, String::length(da_name))\\n    let mut dani = 0\\n    while dani < String::length(da_name) {\\n      bytebuf_push(da_content, String::char_code_at(da_name, dani))\\n      dani = dani + 1\\n    }\\n    bytebuf_push(da_content, dbgargs_count_addr & 255)\\n    bytebuf_push(da_content, (dbgargs_count_addr >> 8) & 255)\\n    bytebuf_push(da_content, (dbgargs_count_addr >> 16) & 255)\\n    bytebuf_push(da_content, (dbgargs_count_addr >> 24) & 255)\\n    bytebuf_push(da_content, dbgargs_base & 255)\\n    bytebuf_push(da_content, (dbgargs_base >> 8) & 255)\\n    bytebuf_push(da_content, (dbgargs_base >> 16) & 255)\\n    bytebuf_push(da_content, (dbgargs_base >> 24) & 255)\\n    let da_tag_mode = if enable_rc {\\n      1\\n    } else {\\n      0\\n    }\\n    bytebuf_push(da_content, da_tag_mode & 255)\\n    bytebuf_push(da_content, (da_tag_mode >> 8) & 255)\\n    bytebuf_push(da_content, (da_tag_mode >> 16) & 255)\\n    bytebuf_push(da_content, (da_tag_mode >> 24) & 255)\\n    bytebuf_push_section(out, 0, da_content)\\n  } else {\\n    ()\\n  }\\n  // debugger named-parameter inspection (DAP P4): emit a `vibe.dbgnames` custom\\n  // section listing, per user function (in user-index order — the same order as\\n  // the name section / fn_names_list / vibe.dbgargs spill), that function's name\\n  // followed by its parameter names. One record per function, terminated by\\n  // newline (10); within a record fields are tab-delimited (9): the first field\\n  // is the function name, the remaining fields are the parameter names. A\\n  // function with no params emits just its name + newline. Names are capped at\\n  // dbgargs_cap to match the spilled value count. The runner keys a map by\\n  // function name so entering-function F's names can be paired with F's spilled\\n  // values to print `args: [name=value]`. Only present in break builds; off =>\\n  // byte-identical to a normal build (fixpoint preserved).\\n  if debug_break {\\n    let dn_content = bytebuf_new()\\n    let dn_name = \\\"vibe.dbgnames\\\"\\n    leb128_encode_u32(dn_content, String::length(dn_name))\\n    let mut dnni = 0\\n    while dnni < String::length(dn_name) {\\n      bytebuf_push(dn_content, String::char_code_at(dn_name, dnni))\\n      dnni = dnni + 1\\n    }\\n    let mut dnfi = 0\\n    while dnfi < num_user_funcs {\\n      let dn_fnname = Array::get(fn_names_list, dnfi)\\n      let mut dn_fci = 0\\n      while dn_fci < String::length(dn_fnname) {\\n        bytebuf_push(dn_content, String::char_code_at(dn_fnname, dn_fci))\\n        dn_fci = dn_fci + 1\\n      }\\n      let dn_stmt = Array::get(stmts, Array::get(fn_stmt_indices, dnfi))\\n      let dn_expr = get_slet_expr(dn_stmt)\\n      if is_efn(dn_expr) {\\n        let dn_params = get_efn_params(dn_expr)\\n        let dn_np = Array::length(dn_params)\\n        let dn_n = if dn_np > dbgargs_cap {\\n          dbgargs_cap\\n        } else {\\n          dn_np\\n        }\\n        let mut dn_pi = 0\\n        while dn_pi < dn_n {\\n          let (dn_pname_raw, _) = Array::get(dn_params, dn_pi)\\n          let dn_pnl = String::length(dn_pname_raw)\\n          let dn_pname = if dn_pnl > 0 {\\n            let dn_plc = String::char_code_at(dn_pname_raw, dn_pnl - 1)\\n            if dn_plc == '~' || dn_plc == '?' {\\n              dn_pname_raw[0: dn_pnl - 1]\\n            } else {\\n              dn_pname_raw\\n            }\\n          } else {\\n            dn_pname_raw\\n          }\\n          bytebuf_push(dn_content, 9)\\n          let mut dn_ci = 0\\n          while dn_ci < String::length(dn_pname) {\\n            bytebuf_push(dn_content, String::char_code_at(dn_pname, dn_ci))\\n            dn_ci = dn_ci + 1\\n          }\\n          dn_pi = dn_pi + 1\\n        }\\n      } else {\\n        // #715: `dn_expr` is a fresh per-iteration owned binding (like\\n        // `__bi_expr` in the main codegen loop above), and -- unlike\\n        // `__bi_expr` -- `is_efn(dn_expr)` is NOT overwhelmingly true here:\\n        // `fn_stmt_indices` legitimately mixes real functions with non-\\n        // function \\\"thunk\\\" entries (constant initializers), so this `else`\\n        // is a common, not rare, runtime path. An empty `else { () }` uses\\n        // `dn_expr` zero times while `then` uses it once (via\\n        // `get_efn_params`), so `pc_emit`'s EIf MIN-merge (#705) permanently\\n        // carries the `then`-consumed (lower) remaining forward even on the\\n        // iterations that really take this branch -- the loop-body scope-end\\n        // drop for `dn_expr` is then skipped based on that borrowed count,\\n        // leaking `dn_expr` on every thunk entry. Call `is_efn` again here,\\n        // discarding the result, purely to consume `dn_expr` exactly once --\\n        // matching `then`'s single consuming use so both branches leave the\\n        // same remaining count and the plan's assumption holds either way.\\n        is_efn(dn_expr)\\n      }\\n      bytebuf_push(dn_content, 10)\\n      dnfi = dnfi + 1\\n    }\\n    bytebuf_push_section(out, 0, dn_content)\\n  } else {\\n    ()\\n  }\\n  // Interior-line breakpoints (span-arc step5, multi-file): emit a `vibe.dbgfiles`\\n  // custom section listing the source-file basenames in file-id order, one per\\n  // line (terminated by newline 10). `vibe::dbg_line(file_id, line)` passes the\\n  // file id; the runner indexes this table to recover the basename and match a\\n  // `--break <file>:<line>` spec. Only present when dbg_line is active, so off =>\\n  // byte-identical (fixpoint preserved).\\n  if dbg_line_on {\\n    let df_content = bytebuf_new()\\n    let df_name = \\\"vibe.dbgfiles\\\"\\n    leb128_encode_u32(df_content, String::length(df_name))\\n    let mut dfni = 0\\n    while dfni < String::length(df_name) {\\n      bytebuf_push(df_content, String::char_code_at(df_name, dfni))\\n      dfni = dfni + 1\\n    }\\n    let mut dffi = 0\\n    while dffi < Array::length(prov.files) {\\n      let df_base = Array::get(prov.files, dffi)\\n      let mut df_ci = 0\\n      while df_ci < String::length(df_base) {\\n        bytebuf_push(df_content, String::char_code_at(df_base, df_ci))\\n        df_ci = df_ci + 1\\n      }\\n      bytebuf_push(df_content, 10)\\n      dffi = dffi + 1\\n    }\\n    bytebuf_push_section(out, 0, df_content)\\n  } else {\\n    ()\\n  }\\n  bytebuf_push_section(out, 1, type_content)\\n  let import_content = bytebuf_new()\\n  bytebuf_push_vec_header(import_content, num_imported_funcs)\\n  emit_name(import_content, \\\"wasi_snapshot_preview1\\\")\\n  emit_name(import_content, \\\"fd_write\\\")\\n  bytebuf_push(import_content, 0)\\n  leb128_encode_u32(import_content, 0)\\n  if env_get_import_idx >= 0 {\\n    emit_name(import_content, \\\"vibe\\\")\\n    emit_name(import_content, \\\"env-get\\\")\\n    bytebuf_push(import_content, 0)\\n    leb128_encode_u32(import_content, 3)\\n  }\\n  if env_args_len_import_idx >= 0 {\\n    emit_name(import_content, \\\"vibe\\\")\\n    emit_name(import_content, \\\"args-len\\\")\\n    bytebuf_push(import_content, 0)\\n    leb128_encode_u32(import_content, 5)\\n  }\\n  if env_args_get_import_idx >= 0 {\\n    emit_name(import_content, \\\"vibe\\\")\\n    emit_name(import_content, \\\"args-get\\\")\\n    bytebuf_push(import_content, 0)\\n    leb128_encode_u32(import_content, 3)\\n  }\\n  if fs_read_file_import_idx >= 0 {\\n    emit_name(import_content, \\\"vibe\\\")\\n    emit_name(import_content, \\\"fs_read_file\\\")\\n    bytebuf_push(import_content, 0)\\n    leb128_encode_u32(import_content, 3)\\n  }\\n  if fs_exists_import_idx >= 0 {\\n    emit_name(import_content, \\\"vibe\\\")\\n    emit_name(import_content, \\\"fs_exists\\\")\\n    bytebuf_push(import_content, 0)\\n    leb128_encode_u32(import_content, 3)\\n  }\\n  if fs_stat_token_import_idx >= 0 {\\n    emit_name(import_content, \\\"vibe\\\")\\n    emit_name(import_content, \\\"fs_stat_token\\\")\\n    bytebuf_push(import_content, 0)\\n    leb128_encode_u32(import_content, 3)\\n  }\\n  if fs_write_file_import_idx >= 0 {\\n    emit_name(import_content, \\\"vibe\\\")\\n    emit_name(import_content, \\\"fs_write_file\\\")\\n    bytebuf_push(import_content, 0)\\n    leb128_encode_u32(import_content, 6)\\n  }\\n  if fs_write_bytes_import_idx >= 0 {\\n    emit_name(import_content, \\\"vibe\\\")\\n    emit_name(import_content, \\\"fs_write_bytes\\\")\\n    bytebuf_push(import_content, 0)\\n    leb128_encode_u32(import_content, 6)\\n  }\\n  // #632: fs_read_bytes — emitted right after fs_write_bytes to match its\\n  // reserved index. Type 3 is `(i64) -> i64` (same as fs_read_file).\\n  if fs_read_bytes_import_idx >= 0 {\\n    emit_name(import_content, \\\"vibe\\\")\\n    emit_name(import_content, \\\"fs_read_bytes\\\")\\n    bytebuf_push(import_content, 0)\\n    leb128_encode_u32(import_content, 3)\\n  }\\n  // #729/#730: fs_read_dir — emitted right after fs_read_bytes to match its\\n  // reserved index. Type 3 is `(i64) -> i64` (same as fs_read_file).\\n  if fs_read_dir_import_idx >= 0 {\\n    emit_name(import_content, \\\"vibe\\\")\\n    emit_name(import_content, \\\"fs_read_dir\\\")\\n    bytebuf_push(import_content, 0)\\n    leb128_encode_u32(import_content, 3)\\n  }\\n  if profiler_now_us_import_idx >= 0 {\\n    emit_name(import_content, \\\"vibe\\\")\\n    emit_name(import_content, \\\"profile-now-us\\\")\\n    bytebuf_push(import_content, 0)\\n    leb128_encode_u32(import_content, 5)\\n  }\\n  // `vibe.profile-heap-bytes () -> i64` — emitted right after profile-now-us\\n  // to match its reserved index. Type 5 is `() -> i64` (same as now-us).\\n  if profiler_heap_bytes_import_idx >= 0 {\\n    emit_name(import_content, \\\"vibe\\\")\\n    emit_name(import_content, \\\"profile-heap-bytes\\\")\\n    bytebuf_push(import_content, 0)\\n    leb128_encode_u32(import_content, 5)\\n  }\\n  // `vibe.sleep (i64) -> ()` — reserved index after profiler, matching the\\n  // allocation order above. Type 1 is `(i64) -> ()`.\\n  if sleep_import_idx >= 0 {\\n    emit_name(import_content, \\\"vibe\\\")\\n    emit_name(import_content, \\\"sleep\\\")\\n    bytebuf_push(import_content, 0)\\n    leb128_encode_u32(import_content, 1)\\n  } else {\\n    ()\\n  }\\n  // `vibe.stdin_read_char () -> i64` — after sleep, matching allocation order.\\n  // Type 5 is `() -> i64` (same as profile-now-us).\\n  if stdin_read_char_import_idx >= 0 {\\n    emit_name(import_content, \\\"vibe\\\")\\n    emit_name(import_content, \\\"stdin_read_char\\\")\\n    bytebuf_push(import_content, 0)\\n    leb128_encode_u32(import_content, 5)\\n  } else {\\n    ()\\n  }\\n  // `vibe.sh (i64) -> i64` and `vibe.sh_lines (i64) -> i64` — reserved after\\n  // stdin_read_char (before dbg_break), matching allocation order. Type 3 is\\n  // `(i64) -> i64` (same as fs_read_file / fs_read_dir).\\n  if sh_import_idx >= 0 {\\n    emit_name(import_content, \\\"vibe\\\")\\n    emit_name(import_content, \\\"sh\\\")\\n    bytebuf_push(import_content, 0)\\n    leb128_encode_u32(import_content, 3)\\n  } else {\\n    ()\\n  }\\n  if sh_lines_import_idx >= 0 {\\n    emit_name(import_content, \\\"vibe\\\")\\n    emit_name(import_content, \\\"sh_lines\\\")\\n    bytebuf_push(import_content, 0)\\n    leb128_encode_u32(import_content, 3)\\n  } else {\\n    ()\\n  }\\n  // `vibe.stdin_read_stream (i64) -> i64` (type 3, like fs_read_file), then the\\n  // two void `vibe.stdout_write_stream` / `vibe.stdout_write_char (i64) -> ()`\\n  // (type 1, like sleep) — reserved after sh_lines (before dbg_break), matching\\n  // allocation order.\\n  if stdin_read_stream_import_idx >= 0 {\\n    emit_name(import_content, \\\"vibe\\\")\\n    emit_name(import_content, \\\"stdin_read_stream\\\")\\n    bytebuf_push(import_content, 0)\\n    leb128_encode_u32(import_content, 3)\\n  } else {\\n    ()\\n  }\\n  if stdout_write_stream_import_idx >= 0 {\\n    emit_name(import_content, \\\"vibe\\\")\\n    emit_name(import_content, \\\"stdout_write_stream\\\")\\n    bytebuf_push(import_content, 0)\\n    leb128_encode_u32(import_content, 1)\\n  } else {\\n    ()\\n  }\\n  if stdout_write_char_import_idx >= 0 {\\n    emit_name(import_content, \\\"vibe\\\")\\n    emit_name(import_content, \\\"stdout_write_char\\\")\\n    bytebuf_push(import_content, 0)\\n    leb128_encode_u32(import_content, 1)\\n  } else {\\n    ()\\n  }\\n  // `vibe.resolve_path (i64) -> i64` (type 3, like fs_read_file) — reserved after\\n  // stdout_write_char (before dbg_break), matching allocation order.\\n  if resolve_path_import_idx >= 0 {\\n    emit_name(import_content, \\\"vibe\\\")\\n    emit_name(import_content, \\\"resolve_path\\\")\\n    bytebuf_push(import_content, 0)\\n    leb128_encode_u32(import_content, 3)\\n  } else {\\n    ()\\n  }\\n  // #768: `vibe.fs_remove (i64) -> ()` (type 1, like sleep) — reserved after\\n  // resolve_path (before dbg_break), matching allocation order.\\n  if fs_remove_import_idx >= 0 {\\n    emit_name(import_content, \\\"vibe\\\")\\n    emit_name(import_content, \\\"fs_remove\\\")\\n    bytebuf_push(import_content, 0)\\n    leb128_encode_u32(import_content, 1)\\n  } else {\\n    ()\\n  }\\n  // #768: `vibe.fs_mkdir_p (i64) -> ()` (type 1, like fs_remove) — reserved\\n  // after fs_remove (before dbg_break), matching allocation order.\\n  if fs_mkdir_p_import_idx >= 0 {\\n    emit_name(import_content, \\\"vibe\\\")\\n    emit_name(import_content, \\\"fs_mkdir_p\\\")\\n    bytebuf_push(import_content, 0)\\n    leb128_encode_u32(import_content, 1)\\n  } else {\\n    ()\\n  }\\n  // #768: `vibe.fs_mkdir (i64) -> ()` (type 1, like fs_remove) — reserved\\n  // after fs_mkdir_p, matching allocation order.\\n  if fs_mkdir_import_idx >= 0 {\\n    emit_name(import_content, \\\"vibe\\\")\\n    emit_name(import_content, \\\"fs_mkdir\\\")\\n    bytebuf_push(import_content, 0)\\n    leb128_encode_u32(import_content, 1)\\n  } else {\\n    ()\\n  }\\n  // #768: `vibe.fs_chdir (i64) -> ()` (type 1, like fs_remove) — reserved\\n  // after fs_mkdir, matching allocation order.\\n  if fs_chdir_import_idx >= 0 {\\n    emit_name(import_content, \\\"vibe\\\")\\n    emit_name(import_content, \\\"fs_chdir\\\")\\n    bytebuf_push(import_content, 0)\\n    leb128_encode_u32(import_content, 1)\\n  } else {\\n    ()\\n  }\\n  // #768: `vibe.fs_copy (i64, i64) -> ()` (type 6, like fs_write_file).\\n  if fs_copy_import_idx >= 0 {\\n    emit_name(import_content, \\\"vibe\\\")\\n    emit_name(import_content, \\\"fs_copy\\\")\\n    bytebuf_push(import_content, 0)\\n    leb128_encode_u32(import_content, 6)\\n  } else {\\n    ()\\n  }\\n  // #768: `vibe.fs_append (i64, i64) -> ()` (type 6, like fs_write_file).\\n  if fs_append_import_idx >= 0 {\\n    emit_name(import_content, \\\"vibe\\\")\\n    emit_name(import_content, \\\"fs_append\\\")\\n    bytebuf_push(import_content, 0)\\n    leb128_encode_u32(import_content, 6)\\n  } else {\\n    ()\\n  }\\n  // #768: `vibe.fs_rename (i64, i64) -> ()` (type 6, like fs_write_file).\\n  if fs_rename_import_idx >= 0 {\\n    emit_name(import_content, \\\"vibe\\\")\\n    emit_name(import_content, \\\"fs_rename\\\")\\n    bytebuf_push(import_content, 0)\\n    leb128_encode_u32(import_content, 6)\\n  } else {\\n    ()\\n  }\\n  // #768: `vibe.fs_is_dir (i64) -> i64` (type 3, like fs_exists/fs_read_file).\\n  if fs_is_dir_import_idx >= 0 {\\n    emit_name(import_content, \\\"vibe\\\")\\n    emit_name(import_content, \\\"fs_is_dir\\\")\\n    bytebuf_push(import_content, 0)\\n    leb128_encode_u32(import_content, 3)\\n  } else {\\n    ()\\n  }\\n  // #768: `vibe.fs_is_file (i64) -> i64` (type 3, like fs_exists).\\n  if fs_is_file_import_idx >= 0 {\\n    emit_name(import_content, \\\"vibe\\\")\\n    emit_name(import_content, \\\"fs_is_file\\\")\\n    bytebuf_push(import_content, 0)\\n    leb128_encode_u32(import_content, 3)\\n  } else {\\n    ()\\n  }\\n  // #768: `vibe.fs_getcwd () -> i64` (type 5, like profile-now-us).\\n  if fs_getcwd_import_idx >= 0 {\\n    emit_name(import_content, \\\"vibe\\\")\\n    emit_name(import_content, \\\"fs_getcwd\\\")\\n    bytebuf_push(import_content, 0)\\n    leb128_encode_u32(import_content, 5)\\n  } else {\\n    ()\\n  }\\n  // #794: `vibe.http_request (i64,i64,i64,i64) -> i64` — the dedicated type\\n  // appended after base/closure/dbg types (http_request_type_idx).\\n  if http_request_import_idx >= 0 {\\n    emit_name(import_content, \\\"vibe\\\")\\n    emit_name(import_content, \\\"http_request\\\")\\n    bytebuf_push(import_content, 0)\\n    leb128_encode_u32(import_content, http_request_type_idx)\\n  } else {\\n    ()\\n  }\\n  // #794: `vibe.http_response_status (i64) -> i64` (type 3, like fs_exists).\\n  if http_response_status_import_idx >= 0 {\\n    emit_name(import_content, \\\"vibe\\\")\\n    emit_name(import_content, \\\"http_response_status\\\")\\n    bytebuf_push(import_content, 0)\\n    leb128_encode_u32(import_content, 3)\\n  } else {\\n    ()\\n  }\\n  // #794: `vibe.http_response_header (i64, i64) -> i64` (type 4).\\n  if http_response_header_import_idx >= 0 {\\n    emit_name(import_content, \\\"vibe\\\")\\n    emit_name(import_content, \\\"http_response_header\\\")\\n    bytebuf_push(import_content, 0)\\n    leb128_encode_u32(import_content, 4)\\n  } else {\\n    ()\\n  }\\n  // #794: `vibe.http_response_body (i64) -> i64` (type 3, like fs_read_file).\\n  if http_response_body_import_idx >= 0 {\\n    emit_name(import_content, \\\"vibe\\\")\\n    emit_name(import_content, \\\"http_response_body\\\")\\n    bytebuf_push(import_content, 0)\\n    leb128_encode_u32(import_content, 3)\\n  } else {\\n    ()\\n  }\\n  // #794: `vibe.http_close (i64) -> ()` (type 1, like fs_remove).\\n  if http_close_import_idx >= 0 {\\n    emit_name(import_content, \\\"vibe\\\")\\n    emit_name(import_content, \\\"http_close\\\")\\n    bytebuf_push(import_content, 0)\\n    leb128_encode_u32(import_content, 1)\\n  } else {\\n    ()\\n  }\\n  // #865: `vibe.sh_capture (i64) -> i64` (type 3, like fs_read_file) -- runs\\n  // the command once and returns