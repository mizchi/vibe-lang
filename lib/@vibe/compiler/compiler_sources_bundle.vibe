"\n\n\nexport fn int_parse_expr(arg: Expr) -> Expr {\n  let c1: (String, Expr) -> Expr = (f, a0) -> {\n    ECall(EIdent(f, -1), [\n      a0\n    ], -1)\n  }\n  let c2: (String, Expr, Expr) -> Expr = (f, a0, a1) -> {\n    ECall(EIdent(f, -1), [\n      a0,\n      a1\n    ], -1)\n  }\n  let s = EIdent(\"__ip_s\", -1)\n  let len = EIdent(\"__ip_len\", -1)\n  let start = EIdent(\"__ip_start\", -1)\n  let neg = EIdent(\"__ip_neg\", -1)\n  let i = EIdent(\"__ip_i\", -1)\n  let acc = EIdent(\"__ip_acc\", -1)\n  let valid = EIdent(\"__ip_valid\", -1)\n  let ch = EIdent(\"__ip_ch\", -1)\n  let digit_step = EIf(EBinOp(\">\", acc, EBinOp(\"/\", EBinOp(\"-\", EInt(2305843009213693951), EBinOp(\"-\", ch, EInt(48))), EInt(10))), EAssign(\"__ip_valid\", EBool(false), EUnit), EAssign(\"__ip_acc\", EBinOp(\"+\", EBinOp(\"*\", acc, EInt(10)), EBinOp(\"-\", ch, EInt(48))), EUnit))\n  let loop_body = ELet(\"__ip_ch\", c2(\"String::char_code_at\", s, i), ESeq(\n    EIf(EBinOp(\"||\", EBinOp(\"<\", ch, EInt(48)), EBinOp(\">\", ch, EInt(57))), EAssign(\"__ip_valid\", EBool(false), EUnit), digit_step),\n    EAssign(\"__ip_i\", EBinOp(\"+\", i, EInt(1)), EUnit)\n  ), -1)\n  let while_loop = EWhile(EBinOp(\"<\", i, len), loop_body)\n  let result_val = EIf(neg, EBinOp(\"-\", EInt(0), acc), acc)\n  let final_check = EIf(EBinOp(\"&&\", valid, EBinOp(\"<\", start, len)), c1(\"Some\", result_val), EIdent(\"None\", -1))\n  ELet(\"__ip_s\", arg, ELet(\"__ip_len\", c1(\"String::length\", s), EIf(EBinOp(\"==\", len, EInt(0)), EIdent(\"None\", -1), ELet(\"__ip_neg\", EBinOp(\"==\", c2(\"String::char_code_at\", s, EInt(0)), EInt(45)), ELet(\"__ip_start\", EIf(neg, EInt(1), EInt(0)), ELetMut(\"__ip_i\", start, ELetMut(\"__ip_acc\", EInt(0), ELetMut(\"__ip_valid\", EBool(true), ESeq(while_loop, final_check), -1), -1), -1), -1), -1)), -1), -1)\n}\n")
