e == \\\"Http::respond\\\" {\\n    Some(CtFn(net_three_params(CtUnknown, CtInt, CtString), CtUnit, Some(\\\"HttpServer\\\")))\\n  }\\n  else None\\n}\\n\\nfn lookup_socket_tcp_read(name: String) -> Option[Type] {\\n  if name == \\\"Socket::tcp_read\\\" {\\n    Some(CtFn(net_two_params(CtUnknown, CtInt), CtString, Some(\\\"TcpSocket\\\")))\\n  }\\n  else None\\n}\\n\\nfn lookup_socket_tcp_close(name: String) -> Option[Type] {\\n  if name == \\\"Socket::tcp_close\\\" {\\n    Some(CtFn(net_one_param(CtUnknown), CtUnit, Some(\\\"TcpSocket\\\")))\\n  }\\n  else None\\n}\\n\\nfn lookup_socket_tcp_write(name: String) -> Option[Type] {\\n  if name == \\\"Socket::tcp_write\\\" {\\n    Some(CtFn(net_two_params(CtUnknown, CtString), CtInt, Some(\\\"TcpSocket\\\")))\\n  }\\n  else None\\n}\\n\\nfn lookup_http_response_body(name: String) -> Option[Type] {\\n  if name == \\\"Http::response_body\\\" {\\n    Some(CtFn(net_one_param(CtUnknown), CtString, Some(\\\"HttpClient\\\")))\\n  }\\n  else None\\n}\\n\\nfn lookup_socket_tcp_connect(name: String) -> Option[Type] {\\n  if name == \\\"Socket::tcp_connect\\\" {\\n    Some(CtFn(net_two_params(CtString, CtInt), CtUnknown, Some(\\\"TcpSocket\\\")))\\n  }\\n  else None\\n}\\n\\nfn lookup_net_group_a(name: String) -> Option[Type] {\\n  match lookup_socket_tcp_connect(name) {\\n    Some(t) => Some(t),\\n    None => match lookup_socket_tcp_read(name) {\\n      Some(t) => Some(t),\\n      None => match lookup_socket_tcp_write(name) {\\n        Some(t) => Some(t),\\n        None => lookup_socket_tcp_close(name)\\n      }\\n    }\\n  }\\n}\\n\\nfn lookup_http_request_header(name: String) -> Option[Type] {\\n  if name == \\\"Http::request_header\\\" {\\n    Some(CtFn(net_two_params(CtUnknown, CtString), CtString, Some(\\\"HttpIncoming\\\")))\\n  }\\n  else None\\n}\\n\\nfn lookup_net_group_d(name: String) -> Option[Type] {\\n  match lookup_http_request_header(name) {\\n    Some(t) => Some(t),\\n    None => lookup_http_respond(name)\\n  }\\n}\\n\\nfn lookup_http_request_method(name: String) -> Option[Type] {\\n  if name == \\\"Http::request_method\\\" {\\n    Some(CtFn(net_one_param(CtUnknown), CtString, Some(\\\"HttpIncoming\\\")))\\n  }\\n  else None\\n}\\n\\nfn lookup_net_group_c(name: String) -> Option[Type] {\\n  match lookup_http_close(name) {\\n    Some(t) => Some(t),\\n    None => match lookup_http_listen(name) {\\n      Some(t) => Some(t),\\n      None => match lookup_http_accept(name) {\\n        Some(t) => Some(t),\\n        None => lookup_http_request_method(name)\\n      }\\n    }\\n  }\\n}\\n\\nfn lookup_http_response_header(name: String) -> Option[Type] {\\n  if name == \\\"Http::response_header\\\" {\\n    Some(CtFn(net_two_params(CtUnknown, CtString), CtString, Some(\\\"HttpClient\\\")))\\n  }\\n  else None\\n}\\n\\nfn lookup_http_response_status(name: String) -> Option[Type] {\\n  if name == \\\"Http::response_status\\\" {\\n    Some(CtFn(net_one_param(CtUnknown), CtInt, Some(\\\"HttpClient\\\")))\\n  }\\n  else None\\n}\\n\\nfn lookup_net_group_b(name: String) -> Option[Type] {\\n  match lookup_http_request(name) {\\n    Some(t) => Some(t),\\n    None => match lookup_http_response_status(name) {\\n      Some(t) => Some(t),\\n      None => match lookup_http_response_header(name) {\\n        Some(t) => Some(t),\\n        None => lookup_http_response_body(name)\\n      }\\n    }\\n  }\\n}\\n\\nexport fn lookup_net(name: String) -> Option[Type] {\\n  match lookup_net_group_a(name) {\\n    Some(t) => Some(t),\\n    None => match lookup_net_group_b(name) {\\n      Some(t) => Some(t),\\n      None => match lookup_net_group_c(name) {\\n        Some(t) => Some(t),\\n        None => lookup_net_group_d(name)\\n      }\\n    }\\n  }\\n}\\n\")\n}\n\nlet cli_adapter_source_32 = () -> (String, String) {\n  (\"lib/@vibe/compiler/checker/builtins_misc.vibe\",\n\"//# Imports\\n\\nimport ../core/index.vibe {\\n  Type\\n}\\n\\n//# Functions\\n\\nfn misc_no_params() -> Array[Type] {\\n  Array::slice([\\n    CtUnknown\\n  ], 0, 0)\\n}\\n\\nfn misc_one_param(a: Type) -> Array[Type] {\\n  let arr = misc_no_params()\\n  Array::push(arr, a)\\n  arr\\n}\\n\\nfn lookup_not(name: String) -> Option[Type] {\\n  if name == \\\"not\\\" {\\n    Some(CtFn(misc_one_param(CtBool), CtBool, None))\\n  }\\n  else None\\n}\\n\\nfn lookup_neg(name: String) -> Option[Type] {\\n  if name == \\\"__neg\\\" {\\n    Some(CtFn(misc_one_param(CtUnknown), CtUnknown, None))\\n  }\\n  else None\\n}\\n\\nfn misc_two_params(a: Type, b: Type) -> Array[Type] {\\n  let arr = misc_no_params()\\n  Array::push(arr, a)\\n  Array::push(arr, b)\\n  arr\\n}\\n\\nfn lookup_eq(name: String) -> Option[Type] {\\n  if name == \\\"eq\\\" {\\n    Some(CtFn(misc_two_params(CtInt, CtInt), CtBool, None))\\n  }\\n  else None\\n}\\n\\nfn lookup_arithmetic_helper(name: String) -> Option[Type] {\\n  if name == \\\"add\\\" || name == \\\"sub\\\" || name == \\\"mul\\\" {\\n    Some(CtFn(misc_two_params(CtInt, CtInt), CtInt, None))\\n  } else if name == \\\"lt\\\" {\\n    Some(CtFn(misc_two_params(CtInt, CtInt), CtBool, None))\\n  } else {\\n    None\\n  }\\n}\\n\\nfn lookup_none(name: String) -> Option[Type] {\\n  if name == \\\"None\\\" {\\n    Some(CtOption(CtUnknown))\\n  }\\n  else None\\n}\\n\\nfn lookup_some(name: String) -> Option[Type] {\\n  if name == \\\"Some\\\" {\\n    Some(CtFn(misc_one_param(CtUnknown), CtOption(CtUnknown), None))\\n  }\\n  else None\\n}\\n\\nfn lookup_index(name: String) -> Option[Type] {\\n  if name == \\\"__index\\\" {\\n    Some(CtFn(misc_two_params(CtUnknown, CtUnknown), CtUnknown, None))\\n  }\\n  else if name == \\\"__set_field\\\" {\\n    // Build the param list inline rather than via the shared `misc_three_params`\\n    // helper: adding a second call site for that private helper triggered a\\n    // namespace-hash collision in the wasm bundler (#492).\\n    let set_field_params = misc_no_params()\\n    Array::push(set_field_params, CtUnknown)\\n    Array::push(set_field_params, CtString)\\n    Array::push(set_field_params, CtUnknown)\\n    Some(CtFn(set_field_params, CtUnit, None))\\n  }\\n  else None\\n}\\n\\nfn lookup_print(name: String) -> Option[Type] {\\n  if name == \\\"print\\\" {\\n    Some(CtFn(misc_one_param(CtString), CtUnit, None))\\n  }\\n  else None\\n}\\n\\nfn lookup_throw(name: String) -> Option[Type] {\\n  if name == \\\"throw\\\" {\\n    // #786: `throw` accepts any value, not just String — a `suberror` value\\n    // (`throw(KeyInvalid(\\\"x\\\"))`) is thrown through the same Error effect. The\\n    // Error handler arms are unchecked (see checker EHandle), so widening the\\n    // payload from CtString to CtUnknown only affects the throw call site and\\n    // still accepts every existing `throw(\\\"msg\\\")`.\\n    Some(CtFn(misc_one_param(CtUnknown), CtUnknown, Some(\\\"Error\\\")))\\n  }\\n  else None\\n}\\n\\nfn misc_three_params(a: Type, b: Type, c: Type) -> Array[Type] {\\n  let arr = misc_no_params()\\n  Array::push(arr, a)\\n  Array::push(arr, b)\\n  Array::push(arr, c)\\n  arr\\n}\\n\\nfn lookup_slice(name: String) -> Option[Type] {\\n  if name == \\\"__slice\\\" {\\n    Some(CtFn(misc_three_params(CtUnknown, CtInt, CtInt), CtUnknown, None))\\n  }\\n  else None\\n}\\n\\nfn lookup_assert(name: String) -> Option[Type] {\\n  if name == \\\"assert\\\" {\\n    Some(CtFn(misc_one_param(CtBool), CtUnit, None))\\n  }\\n  else if name == \\\"assert_true\\\" {\\n    Some(CtFn(misc_one_param(CtBool), CtUnit, None))\\n  }\\n  else if name == \\\"assert_eq\\\" {\\n    Some(CtFn([\\n      CtUnknown,\\n      CtUnknown\\n    ], CtUnit, None))\\n  }\\n  else None\\n}\\n\\nfn lookup_println(name: String) -> Option[Type] {\\n  if name == \\\"println\\\" {\\n    Some(CtFn(misc_one_param(CtString), CtUnit, None))\\n  }\\n  else None\\n}\\n\\nfn lookup_to_string(name: String) -> Option[Type] {\\n  if name == \\\"__to_string\\\" {\\n    Some(CtFn(misc_one_param(CtUnknown), CtString, None))\\n  }\\n  else None\\n}\\n\\nfn lookup_len(name: String) -> Option[Type] {\\n  if name == \\\"__len\\\" {\\n    Some(CtFn(misc_one_param(CtUnknown), CtInt, None))\\n  }\\n  else None\\n}\\n\\nfn lookup_iter_intrinsic(name: String) -> Option[Type] {\\n  if name == \\\"iter_require\\\" {\\n    Some(CtFn(misc_one_param(CtUnknown), CtUnknown, None))\\n  } else if name == \\\"iter_length\\\" {\\n    Some(CtFn(misc_one_param(CtUnknown), CtInt, None))\\n  } else if name == \\\"iter_get\\\" {\\n    Some(CtFn(misc_two_params(CtUnknown, CtInt), CtUnknown, None))\\n  } else if name == \\\"String::iter_length\\\" {\\n    Some(CtFn(misc_one_param(CtString), CtInt, None))\\n  } else if name == \\\"String::iter_get\\\" {\\n    Some(CtFn(misc_two_params(CtString, CtInt), CtInt, None))\\n  } else if name == \\\"Map::iter_length\\\" {\\n    Some(CtFn(misc_one_param(CtUnknown), CtInt, None))\\n  } else if name == \\\"Map::iter_get\\\" {\\n    Some(CtFn(misc_two_params(CtUnknown, CtInt), CtUnknown, None))\\n  } else {\\n    None\\n  }\\n}\\n\\nfn lookup_char_to_int(name: String) -> Option[Type] {\\n  if name == \\\"Char::to_int\\\" {\\n    Some(CtFn(misc_one_param(CtChar), CtInt, None))\\n  }\\n  else None\\n}\\n\\nfn lookup_misc_group_a(name: String) -> Option[Type] {\\n  match lookup_arithmetic_helper(name) {\\n    Some(t) => Some(t),\\n    None => match lookup_eq(name) {\\n      Some(t) => Some(t),\\n      None => match lookup_not(name) {\\n        Some(t) => Some(t),\\n        None => match lookup_neg(name) {\\n          Some(t) => Some(t),\\n          None => match lookup_to_string(name) {\\n            Some(t) => Some(t),\\n            None => match lookup_len(name) {\\n              Some(t) => Some(t),\\n              None => lookup_index(name)\\n            }\\n          }\\n        }\\n      }\\n    }\\n  }\\n}\\n\\nfn lookup_misc_group_b(name: String) -> Option[Type] {\\n  match lookup_slice(name) {\\n    Some(t) => Some(t),\\n    None => match lookup_print(name) {\\n      Some(t) => Some(t),\\n      None => match lookup_println(name) {\\n        Some(t) => Some(t),\\n        None => lookup_assert(name)\\n      }\\n    }\\n  }\\n}\\n\\nfn lookup_misc_group_e(name: String) -> Option[Type] {\\n  if name == \\\"String::join\\\" {\\n    // (Array[String], String) -> String  (host builtin)\\n    Some(CtFn(misc_two_params(CtArray(CtString), CtString), CtString, None))\\n  } else if name == \\\"__rec_field\\\" {\\n    // selfhost record-pattern desugar: __rec_field(record, index) -> field value.\\n    // Lenient (field type unknown); only needs to resolve, not constrain.\\n    Some(CtFn(misc_two_params(CtUnknown, CtInt), CtUnknown, None))\\n  } else {\\n    match lookup_iter_intrinsic(name) {\\n      Some(t) => Some(t),\\n      None => lookup_none(name)\\n    }\\n  }\\n}\\n\\nfn lookup_char_from_int(name: String) -> Option[Type] {\\n  if name == \\\"Char::from_int\\\" {\\n    Some(CtFn(misc_one_param(CtInt), CtChar, None))\\n  }\\n  else None\\n}\\n\\nfn lookup_double_to_int(name: String) -> Option[Type] {\\n  // `Float` is `CtDouble` under the hood (see core/types.vibe) — codegen\\n  // already treats \\\"Double::to_int\\\" / \\\"Float::to_int\\\" as the same case, so\\n  // accept both spellings here too.\\n  if name == \\\"Double::to_int\\\" || name == \\\"Float::to_int\\\" {\\n    Some(CtFn(misc_one_param(CtDouble), CtInt, None))\\n  }\\n  else None\\n}\\n\\nfn lookup_int_to_double(name: String) -> Option[Type] {\\n  if name == \\\"Int::to_double\\\" || name == \\\"Int::to_float\\\" {\\n    Some(CtFn(misc_one_param(CtInt), CtDouble, None))\\n  }\\n  else if name == \\\"Int::to_string\\\" {\\n    // Documented in the cheatsheet's conversion set but never wired up —\\n    // codegen lowers it to the `__to_string` integer path (#740 fallout:\\n    // ripple_test rotted against it).\\n    Some(CtFn(misc_one_param(CtInt), CtString, None))\\n  }\\n  else None\\n}\\n\\nfn lookup_double_to_i64_bits(name: String) -> Option[Type] {\\n  if name == \\\"Double::to_i64_bits\\\" || name == \\\"Double::to_i64_bits_lo\\\" || name == \\\"Double::to_i64_bits_hi\\\" {\\n    Some(CtFn(misc_one_param(CtDouble), CtInt, None))\\n  }\\n  else None\\n}\\n\\nfn lookup_misc_group_c(name: String) -> Option[Type] {\\n  match lookup_throw(name) {\\n    Some(t) => Some(t),\\n    None => match lookup_int_to_double(name) {\\n      Some(t) => Some(t),\\n      None => match lookup_double_to_int(name) {\\n        Some(t) => Some(t),\\n        None => lookup_double_to_i64_bits(name)\\n      }\\n    }\\n  }\\n}\\n\\nfn lookup_double_from_i64_bits(name: String) -> Option[Type] {\\n  if name == \\\"Double::from_i64_bits\\\" {\\n    Some(CtFn(misc_one_param(CtInt), CtDouble, None))\\n  }\\n  else None\\n}\\n\\nfn lookup_misc_group_d(name: String) -> Option[Type] {\\n  match lookup_double_from_i64_bits(name) {\\n    Some(t) => Some(t),\\n    None => match lookup_char_to_int(name) {\\n      Some(t) => Some(t),\\n      None => match lookup_char_from_int(name) {\\n        Some(t) => Some(t),\\n        None => lookup_some(name)\\n      }\\n    }\\n  }\\n}\\n\\n// Double::to_string / Float::to_string: codegen already lowers these through\\n// `double_to_string_expr` (the same formatter string interpolation of a\\n// float uses via `__to_string`) — only the checker-side registration was\\n// missing.\\nfn lookup_double_to_string(name: String) -> Option[Type] {\\n  if name == \\\"Double::to_string\\\" || name == \\\"Float::to_string\\\" {\\n    Some(CtFn(misc_one_param(CtDouble), CtString, None))\\n  }\\n  else None\\n}\\n\\n// Native single-opcode f64 ops (f64.abs/floor/ceil/min/max) — cheap to wire\\n// up since wasm has direct instructions for all of them.\\nfn lookup_double_unary_op(name: String) -> Option[Type] {\\n  if name == \\\"Double::abs\\\" || name == \\\"Double::floor\\\" || name == \\\"Double::ceil\\\" {\\n    Some(CtFn(misc_one_param(CtDouble), CtDouble, None))\\n  }\\n  else None\\n}\\n\\nfn lookup_double_binary_op(name: String) -> Option[Type] {\\n  if name == \\\"Double::max\\\" || name == \\\"Double::min\\\" {\\n    Some(CtFn(misc_two_params(CtDouble, CtDouble), CtDouble, None))\\n  }\\n  else None\\n}\\n\\n// Int::abs/signum/is_even/is_odd/max/min/clamp are intentionally NOT\\n// registered as compiler builtins here: lib/@vibe/prelude/int.vibe already\\n// defines all of them as regular user-space functions (with correct\\n// overflow/saturation semantics, e.g. Int::abs(int_min_value) ==\\n// int_max_value). Registering them as builtins too would let this\\n// checker-side entry win over the prelude definition and silently swap in\\n// different (wrong-for-edge-cases) codegen — this previously broke\\n// lib/@vibe/prelude/int_test.vibe after a #767 attempt added them.\\nfn lookup_int_parse(name: String) -> Option[Type] {\\n  if name == \\\"Int::parse\\\" {\\n    Some(CtFn(misc_one_param(CtString), CtOption(CtInt), None))\\n  }\\n  else None\\n}\\n\\nfn lookup_misc_group_f(name: String) -> Option[Type] {\\n  match lookup_double_to_string(name) {\\n    Some(t) => Some(t),\\n    None => match lookup_double_unary_op(name) {\\n      Some(t) => Some(t),\\n      None => match lookup_double_binary_op(name) {\\n        Some(t) => Some(t),\\n        None => lookup_int_parse(name)\\n      }\\n    }\\n  }\\n}\\n\\nexport fn lookup_misc(name: String) -> Option[Type] {\\n  match lookup_misc_group_a(name) {\\n    Some(t) => Some(t),\\n    None => match lookup_misc_group_b(name) {\\n      Some(t) => Some(t),\\n      None => match lookup_misc_group_c(name) {\\n        Some(t) => Some(t),\\n        None => match lookup_misc_group_d(name) {\\n          Some(t) => Some(t),\\n          None => match lookup_misc_group_e(name) {\\n            Some(t) => Some(t),\\n            None => lookup_misc_group_f(name)\\n          }\\n        }\\n      }\\n    }\\n  }\\n}\\n\")\n}\n\nlet cli_adapter_source_33 = () -> (String, String) {\n  (\"lib/@vibe/compiler/checker/builtins_array.vibe\",\n\"//# Imports\\n\\nimport ../core/index.vibe {\\n  Type\\n}\\n\\n//# Functions\\n\\nfn array_no_params() -> Array[Type] {\\n  Array::slice([\\n    CtUnknown\\n  ], 0, 0)\\n}\\n\\nfn array_one_param(a: Type) -> Array[Type] {\\n  let arr = array_no_params()\\n  Array::push(arr, a)\\n  arr\\n}\\n\\nfn array_two_params(a: Type, b: Type) -> Array[Type] {\\n  let arr = array_no_params()\\n  Array::push(arr, a)\\n  Array::push(arr, b)\\n  arr\\n}\\n\\nfn array_three_params(a: Type, b: Type, c: Type) -> Array[Type] {\\n  let arr = array_no_params()\\n  Array::push(arr, a)\\n  Array::push(arr, b)\\n  Array::push(arr, c)\\n  arr\\n}\\n\\nfn lookup_array_get(name: String) -> Option[Type] {\\n  if name == \\\"Array::get\\\" {\\n    Some(CtFn(array_two_params(CtArray(CtUnknown), CtInt), CtUnknown, None))\\n  }\\n  else None\\n}\\n\\nfn lookup_array_new(name: String) -> Option[Type] {\\n  if name == \\\"array_new\\\" {\\n    Some(CtFn(array_no_params(), CtArray(CtUnknown), None))\\n  }\\n  else None\\n}\\n\\nfn lookup_array_set(name: String) -> Option[Type] {\\n  if name == \\\"Array::set\\\" {\\n    Some(CtFn(array_three_params(CtArray(CtUnknown), CtInt, CtUnknown), CtUnit, None))\\n  }\\n  else None\\n}\\n\\nfn lookup_array_push(name: String) -> Option[Type] {\\n  if name == \\\"Array::push\\\" {\\n    Some(CtFn(array_two_params(CtArray(CtUnknown), CtUnknown), CtUnit, None))\\n  }\\n  else None\\n}\\n\\nfn lookup_array_slice(name: String) -> Option[Type] {\\n  if name == \\\"Array::slice\\\" {\\n    Some(CtFn(array_three_params(CtArray(CtUnknown), CtInt, CtInt), CtArray(CtUnknown), None))\\n  }\\n  else None\\n}\\n\\nfn lookup_array_concat(name: String) -> Option[Type] {\\n  if name == \\\"Array::concat\\\" {\\n    Some(CtFn(array_two_params(CtArray(CtUnknown), CtArray(CtUnknown)), CtArray(CtUnknown), None))\\n  }\\n  else None\\n}\\n\\nfn lookup_array_map(name: String) -> Option[Type] {\\n  if name == \\\"Array::map\\\" {\\n    Some(CtFn(\\n      array_two_params(CtArray(CtUnknown), CtFn(array_one_param(CtUnknown), CtUnknown, None)),\\n      CtArray(CtUnkn