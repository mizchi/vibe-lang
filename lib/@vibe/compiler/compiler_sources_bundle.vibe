\n              hs1 = eans\n              hc1 = eanc\n              let eres_now = subst_apply(hs1, hres)\n              let earm_now = subst_apply(hs1, earm_ty)\n              if eres_now is CtUnknown {\n                hres = earm_now\n              } else {\n                hs1 = check_assignable(eres_now, earm_now, hs1, errors, \"handler arm value type mismatch with the handle body's type\", 0 - 1)\n              }\n            } else {\n              ()\n            }\n          },\n          _ => ()\n        }\n        hai = hai + 1\n      }\n      let hx_eff = array_empty()\n      let hx_ops = array_empty()\n      let mut hxi = 0\n      while hxi < Array::length(harms) {\n        let (hxpat, _) = Array::get(harms, hxi)\n        match hxpat {\n          PCtor(hxq, _) => {\n            let hxci = String::index_of(hxq, \"::\")\n            if hxci > 0 && effect_is_declared(defs, String::substring(hxq, 0, hxci)) {\n              Array::push(hx_eff, String::substring(hxq, 0, hxci))\n              Array::push(hx_ops, String::substring(hxq, hxci + 2, String::length(hxq)))\n            } else {\n              ()\n            }\n          },\n          _ => ()\n        }\n        hxi = hxi + 1\n      }\n      if Array::length(hx_eff) > 0 {\n        match find_typedef(defs, Array::get(hx_eff, 0)) {\n          Some(TDEffect(_, hx_decl_ops, _)) => {\n            let mut hoi = 0\n            while hoi < Array::length(hx_decl_ops) {\n              let (hx_op_name, _, _) = Array::get(hx_decl_ops, hoi)\n              let mut hx_found = false\n              let mut hoj = 0\n              while hoj < Array::length(hx_ops) {\n                if Array::get(hx_ops, hoj) == hx_op_name {\n                  hx_found = true\n                } else {\n                  ()\n                }\n                hoj = hoj + 1\n              }\n              if hx_found {\n                ()\n              } else {\n                Array::push(errors, String::concat(\"non-exhaustive handler: operation `\", String::concat(hx_op_name, String::concat(\"` of effect \", String::concat(Array::get(hx_eff, 0), \" has no arm — performing it would trap at runtime; add an arm for it\")))))\n              }\n              hoi = hoi + 1\n            }\n          },\n          _ => ()\n        }\n      } else {\n        ()\n      }\n      (hres, hs1, hc1)\n    },\n    EWhile(cond, body) => {\n      let (ct, s1, c1) = check_expr(cond, env, defs, s, c, errors, tytab)\n      let resolved_ct = subst_apply(s1, ct)\n      match resolved_ct {\n        CtBool => (),\n        CtUnknown => (),\n        CtVar(_) => (),\n        _ => Array::push(errors, \"while condition must be Bool\")\n      }\n      let (_, s2, c2) = check_expr(body, env_bind(env, \"__in_loop__\", CtUnit), defs, s1, c1, errors, tytab)\n      (CtUnit, s2, c2)\n    },\n    ELoop(params, body) => {\n      let mut env1 = env\n      let mut s1 = s\n      let mut c1 = c\n      let mut i = 0\n      while i < Array::length(params) {\n        let (name, init) = Array::get(params, i)\n        let (pt, ns, nc) = check_expr(init, env1, defs, s1, c1, errors, tytab)\n        env1 = env_bind(env1, name, pt)\n        s1 = ns\n        c1 = nc\n        i = i + 1\n      }\n      let (_, s2, c2) = check_expr(body, env_bind(env1, \"__in_loop__\", CtUnit), defs, s1, c1, errors, tytab)\n      (CtUnit, s2, c2)\n    },\n    EForIn(name, index_name, iterable, body) => {\n      let (it, s1, c1) = check_expr(iterable, env, defs, s, c, errors, tytab)\n      let it_resolved = subst_apply(s1, it)\n      let (et, c1b) = match it_resolved {\n        CtArray(elem) => (elem, c1),\n        CtNamed(nm, args) => if Array::length(args) > 0 {\n          (Array::get(args, 0), c1)\n        } else if nm == \"HostStream\" {\n          (CtInt, c1)\n        } else if nm == \"Stream\" || type_name_has_iterator_impl(env, nm) {\n          fresh_var(c1)\n        } else (CtUnknown, c1),\n        CtStruct(nm) => if type_name_has_iterator_impl(env, nm) {\n          fresh_var(c1)\n        } else (CtUnknown, c1),\n        other => {\n          let flag = match other {\n            CtInt => true,\n            CtDouble => true,\n            CtBool => true,\n            CtUnit => true,\n            CtChar => true,\n            _ => false\n          }\n          if flag {\n            Array::push(errors, \"for loop requires an iterable (Array or iterator)\")\n          } else {\n            ()\n          }\n          (CtUnknown, c1)\n        }\n      }\n      let env2 = env_bind(env, name, et)\n      let env3 = match index_name {\n        Some(index_name) => env_bind(env2, index_name, CtInt),\n        None => env2\n      }\n      let (bt, s2, c2) = check_expr(body, env_bind(env3, \"__in_loop__\", CtUnit), defs, s1, c1b, errors, tytab)\n      (CtArray(bt), s2, c2)\n    },\n    EDot(obj, field, dot_off, field_off) => {\n      let qualified_key = match obj {\n        EIdent(ns, _) => match env_lookup(env, ns) {\n          Some(_) => None,\n          None => Some(String::concat(ns, String::concat(\".\", field)))\n        },\n        _ => None\n      }\n      let qualified_hit = match qualified_key {\n        Some(k) => env_lookup(env, k),\n        None => None\n      }\n      match qualified_hit {\n        Some(_) => match qualified_key {\n          Some(k) => check_expr(EIdent(k, field_off), env, defs, s, c, errors, tytab),\n          None => (CtUnknown, s, c)\n        },\n        None => {\n          let (obj_ty, s1, c1) = check_expr(obj, env, defs, s, c, errors, tytab)\n          let resolved = subst_apply(s1, obj_ty)\n          let field_ty = match resolved {\n            CtStruct(sname) => match find_typedef(defs, sname) {\n              Some(td) => match td {\n                TDStruct(_, fields, _, _) => {\n                  let rec find_field: (Int) -> Option[Type] = (i) -> {\n                    if i >= Array::length(fields) {\n                      None\n                    } else {\n                      let (fname, ftype) = Array::get(fields, i)\n                      if fname == field {\n                        Some(ftype)\n                      } else find_field(i + 1)\n                    }\n                  }\n                  match find_field(0) {\n                    Some(ft) => ft,\n                    None => {\n                      Array::push(errors, String::concat(String::concat(\"unknown field '\", String::concat(field, String::concat(\"' on struct \", sname))), if field_off >= 0 {\n                        off_marker_len(field_off, String::length(field))\n                      } else {\n                        off_marker(dot_off)\n                      }))\n                      CtUnknown\n                    }\n                  }\n                },\n                _ => CtUnknown\n              },\n              None => CtUnknown\n            },\n            CtNamed(gname, gargs) => match find_typedef(defs, gname) {\n              Some(td) => match td {\n                TDStruct(_, gfields, _, gtparams) => {\n                  let rec find_field_g: (Int) -> Option[Type] = (i) -> {\n                    if i >= Array::length(gfields) {\n                      None\n                    } else {\n                      let (fname, ftype) = Array::get(gfields, i)\n                      if fname == field {\n                        Some(ftype)\n                      } else find_field_g(i + 1)\n                    }\n                  }\n                  match find_field_g(0) {\n                    Some(ft) => inst_struct_field_ty(ft, gtparams, gargs),\n                    None => {\n                      Array::push(errors, String::concat(String::concat(\"unknown field '\", String::concat(field, String::concat(\"' on struct \", gname))), if field_off >= 0 {\n                        off_marker_len(field_off, String::length(field))\n                      } else {\n                        off_marker(dot_off)\n                      }))\n                      CtUnknown\n                    }\n                  }\n                },\n                _ => CtUnknown\n              },\n              None => CtUnknown\n            },\n            CtTuple(elems) => match parse_tuple_index(field) {\n              Some(idx) => if idx >= 0 && idx < Array::length(elems) {\n                Array::get(elems, idx)\n              } else {\n                Array::push(errors, String::concat(String::concat(\"tuple index \", String::concat(field, String::concat(\" out of range for a \", String::concat(__to_string(Array::length(elems)), \"-tuple\")))), if field_off >= 0 {\n                  off_marker_len(field_off, String::length(field))\n                } else {\n                  off_marker(dot_off)\n                }))\n                CtUnknown\n              },\n              None => CtUnknown\n            },\n            other => {\n              let not_struct = match other {\n                CtInt => true,\n                CtDouble => true,\n                CtBool => true,\n                CtChar => true,\n                CtUnit => true,\n                CtOption(_) => true,\n                CtFn(_, _, _) => true,\n                _ => false\n              }\n              if not_struct {\n                Array::push(errors, String::concat(String::concat(\"field access `.\", String::concat(field, \"` on a non-struct value\")), if field_off >= 0 {\n                  off_marker_len(field_off, String::length(field))\n                } else {\n                  off_marker(dot_off)\n                }))\n              } else {\n                ()\n              }\n              CtUnknown\n            }\n          }\n          if dot_off >= 0 {\n            Array::push(tytab, (dot_off, field_ty))\n          } else {\n            ()\n          }\n          if field_off >= 0 && field_off != dot_off {\n            Array::push(tytab, (field_off, field_ty))\n          } else {\n            ()\n          }\n          (field_ty, s1, c1)\n        }\n      }\n    },\n    EFn(tparams, tbounds, params, ret_ty, effect, body) => {\n      let tplen = Array::length(tparams)\n      let mut tp_env = env\n      let mut s0 = s\n      let mut c0 = c\n      let mut tpi = 0\n      while tpi < tplen {\n        let tpname = Array::get(tparams, tpi)\n        match fresh_var(c0) {\n          (tv, nc) => {\n            let vid = nc - 1\n            let tblen = Array::length(tbounds)\n            let mut bounds = array_empty()\n            let mut tbi = 0\n            let mut found_bounds = false\n            while tbi < tblen {\n              let (bname, blist) = Array::get(tbounds, tbi)\n              if !found_bounds && bname == tpname {\n                bounds = blist\n                found_bounds = true\n              }\n              tbi = tbi + 1\n            }\n            s0 = if Array::length(bounds) == 0 {\n              s0\n            } else subst_add_bound(s0, vid, bounds)\n            tp_env = env_bind(tp_env, tpname, tv)\n            c0 = nc\n          },\n          _ => ()\n        }\n        tpi = tpi + 1\n      }\n      let plen = Array::length(params)\n      let mut fn_env = tp_env\n      let mut s1 = s0\n      let mut c1 = c0\n      let param_types = array_empty()\n      let mut pi = 0\n      while pi < plen {\n        let (raw_name, ann) = Array::get(params, pi)\n        let nlen = String::length(raw_name)\n        let name = if nlen > 0 {\n          let lc = String::char_code_at(raw_name, nlen - 1)\n          if lc == '~' || lc == '?' {\n            raw_name[0: nlen - 1]\n          } else raw_name\n        } else raw_name\n        let (pt, ns, nc) = match ann {\n          Some(te) => {\n            let resolved = resolve_type_expr(te, defs)\n            let pt2 = resolve_tparams_in(resolved, fn_env)\n            (pt2, s1, c1)\n          },\n          None => {\n            let (tv, nc2) = fresh_var(c1)\n            (tv, s1, nc2)\n          }\n        }\n        fn_env = env_bind(fn_env, name, pt)\n        Array::push(param_types, pt)\n        s1 = ns\n        c1 = nc\n        pi = pi + 1\n      }\n      let body_env = match ret_ty {\n        Some(rte) => env_bind(fn_env, \"__return__\", resolve_tparams_in(resolve_type_expr(rte, defs), fn_env)),\n        None => env_bind(fn_env, \"__return__\", CtUnknown)\n      }\n      let (bt, s2, c2) = check_expr(body, body_env, defs, s1, c1, errors, tytab)\n      let (final_ret, s3) = match ret_ty {\n        Some(te) => {\n          let resolved = resolve_type_expr(te, defs)\n          let resolved_ret = resolve_tparams_in(resolved, fn_env)\n          match unify(bt, resolved_ret, s2) {\n            Some(ns) => (subst_apply(ns, resolved_ret), ns),\n            None => {\n              Array::push(errors, String::concat(\"return type mismatch: expected \", String::concat(type_to_string(resolved_ret), String::concat(\", got \", type_to_string(bt)))))\n              (CtUnknown, s2)\n            }\n          }\n        },\n        None => (subst_apply(s2, bt), s2)\n      }\n      (CtFn(param_types, final_ret, effect), s3, c2)\n    },\n    EBreak(opt) => {\n      match env_lookup(env, \"__in_loop__\") {\n        Some(_) => (),\n        None => Array::push(errors, \"`break` outside a loop\")\n      }\n      match opt {\n        Some(e) => {\n          let (_, s1, c1) = check_expr(e, env, defs, s, c, errors, tytab)\n          (CtUnit, s1, c1)\n        },\n        None => (CtUnit, s, c)\n      }\n    },\n    EContinue(args) => {\n      match env_lookup(env, \"__in_loop__\") {\n        Some(_) => (),\n        None => Array::push(errors, \"`continue` outside a loop\")\n      }\n      let alen = Array::length(args)\n      let mut s1 = s\n      let mut c1 = c\n      let mut ai = 0\n      while ai < alen {\n        let (_, ns, nc) = check_expr(Array::get(args, ai), env, defs, s1, c1, errors, tytab)\n        s1 = ns\n        c1 = nc\n        ai = ai + 1\n      }\n      (CtUnit, s1, c1)\n    },\n    ERecord(rn, fields, targs) => {\n      let flen = Array::length(fields)\n      let mut s1 = s\n      let mut c1 = c\n      let field_tys = array_empty()\n      let mut fi = 0\n      while fi < flen {\n        let (fname, fval) = Array::get(fields, fi)\n        let mut dj = 0\n        let mut dup = false\n        while dj < Array::length(field_tys) {\n          let (pn, _) = Array::get(field_tys, dj)\n          if pn == fname {\n            dup = true\n          } else {\n            ()\n          }\n          dj = dj + 1\n        }\n        if dup {\n          Array::push(errors, String::concat(\"duplicate field `\", String::concat(fname, \"` in record literal\")))\n        } else {\n          ()\n        }\n        let (ft, ns, nc) = check_expr(fval, env, defs, s1, c1, errors, tytab)\n        Array::push(field_tys, (fname, ft))\n        s1 = ns\n        c1 = nc\n        fi = fi + 1\n      }\n      if rn != \"\" {\n        match find_typedef(defs, rn) {\n          Some(td) => match td {\n            TDStruct(_, dfields, _, s_tparams) => {\n              let mut ui = 0\n              while ui < Array::length(field_tys) {\n                let (an, _) = Array::get(field_tys, ui)\n                let mut known = false\n                let mut uj = 0\n                while uj < Array::length(dfields) {\n                  let (dn, _) = Array::get(dfields, uj)\n                  if dn == an {\n                    known = true\n                  } else {\n                    ()\n                  }\n                  uj = uj + 1\n                }\n                if !known {\n                  Array::push(errors, String::concat(\"unknown field `\", String::concat(an, String::concat(\"` for struct \", rn))))\n                } else {\n                  ()\n                }\n                ui = ui + 1\n              }\n              let tplen = Array::length(s_tparams)\n              let ntargs = Array::length(targs)\n              if ntargs > 0 && ntargs != tplen {\n                Array::push(errors, \"struct \\{rn} expects \\{tplen} type argument(s), got \\{ntargs} in `\\{rn}[...]::{ ... }` (#886 explicit struct type arguments)\")\n              }\n              let use_explicit = ntargs > 0 && ntargs == tplen\n              let fresh_targs = array_empty()\n              let mut c2 = c1\n              let mut tpi = 0\n              while tpi < tplen {\n                if use_explicit {\n                  Array::push(fresh_targs, resolve_tparams_in(resolve_type_expr(Array::get(targs, tpi), defs), env))\n                } else {\n                  match fresh_var(c2) {\n                    (tv, nc) => {\n                      Array::push(fresh_targs, tv)\n                      c2 = nc\n                    },\n                    _ => ()\n                  }\n                }\n                tpi = tpi + 1\n              }\n              let mut mi = 0\n              while mi < Array::length(dfields) {\n                let (dn, dty0) = Array::get(dfields, mi)\n                let dty = if tplen > 0 {\n                  subst_type_params(dty0, s_tparams, fresh_targs)\n                } else {\n                  dty0\n                }\n                match lookup_actual_field_ty(field_tys, dn) {\n                  Some(aty) => {\n                    s1 = check_assignable(dty, subst_apply(s1, aty), s1, errors, String::concat(\"struct field type mismatch for \", dn), 0 - 1)\n                  },\n                  None => Array::push(errors, String::concat(\"missing field `\", String::concat(dn, String::concat(\"` in construction of struct \", rn))))\n                }\n                mi = mi + 1\n              }\n              if struct_fields_ground(dfields) {\n                (CtStruct(rn), s1, c2)\n              } else if tplen > 0 {\n                let inst_targs = for ta in fresh_targs {\n                  subst_apply(s1, ta)\n                }\n                (CtNamed(rn, inst_targs), s1, c2)\n              } else {\n                (CtUnknown, s1, c2)\n              }\n            },\n            _ => {\n              Array::push(errors, String::concat(\"`\", String::concat(rn, \"` is not a struct (struct literal)\")))\n              (CtUnknown, s1, c1)\n            }\n          },\n          None => {\n            let s2f = check_record_fields(defs, field_tys, s1, errors)\n            let rec_tyf = match resolve_record_struct_name(defs, field_tys) {\n              Some(sname) => CtStruct(sname),\n              None => CtUnknown\n            }\n            (rec_tyf, s2f, c1)\n          }\n        }\n      } else {\n        let s2 = check_record_fields(defs, field_tys, s1, errors)\n        let rec_ty = match resolve_record_struct_name(defs, field_tys) {\n          Some(sname) => CtStruct(sname),\n          None => CtUnknown\n        }\n        (rec_ty, s2, c1)\n      }\n    },\n    ETuple(items) => {\n      let ilen = Array::length(items)\n      let mut s1 = s\n      let mut c1 = c\n      let tys = array_empty()\n      let mut ti = 0\n      while ti < ilen {\n        let (it, ns, nc) = check_expr(Array::get(items, ti), env, defs, s1, c1, errors, tytab)\n        Array::push(tys, it)\n        s1 = ns\n        c1 = nc\n        ti = ti + 1\n      }\n      (CtTuple(tys), s1, c1)\n    },\n    EArray(items) => {\n      let ilen = Array::length(items)\n      let mut s1 = s\n      let mut c1 = c\n      let mut elem_ty = CtUnknown\n      let mut check_elems = false\n      let mut ai = 0\n      while ai < ilen {\n        let (it, ns, nc) = check_expr(Array::get(items, ai), env, defs, s1, c1, errors, tytab)\n        s1 = ns\n        c1 = nc\n        if ai == 0 {\n          elem_ty = it\n          check_elems = match subst_apply(s1, it) {\n            CtInt => true,\n            CtDouble => true,\n            CtBool => true,\n            CtString => true,\n            CtChar => true,\n            CtArray(inner) => match inner {\n              CtInt => true,\n              CtDouble => true,\n              CtBool => true,\n              CtString => true,\n              CtChar => true,\n              _ => false\n            },\n            _ => false\n          }\n        } else {\n          if check_elems {\n            s1 = check_assignable(elem_ty, subst_apply(s1, it), s1, errors, \"array elements have incompatible types\", 0 - 1)\n          } else {\n            ()\n          }\n        }\n        ai = ai + 1\n      }\n      (CtArray(elem_ty), s1, c1)\n    },\n    EReturn(e) => {\n      let (et, s1, c1) = check_expr(e, env, defs, s, c, errors, tytab)\n      match env_lookup(env, \"__return__\") {\n        Some(rt) => {\n          let rte = subst_apply(s1, rt)\n          let ate = subst_apply(s1, et)\n          if railway_heads_conflict(rte, ate) {\n            Array::push(errors, String::concat(\"return type mismatch\", String::concat(\": expected \", String::concat(type_to_string(rte), String::concat(\", got \", String::concat(type_to_string(ate), off_marker(railway_expr_off(e))))))))\n          } else {\n            let _ = check_assignable(rte, ate, s1, errors, \"return type mismatch\", 0 - 1)\n            ()\n          }\n        },\n        None => ()\n      }\n      (et, s1, c1)\n    },\n    EMap(mpairs) => {\n      let mut ms1 = s\n      let mut mc1 = c\n      let mut mvty: Type = CtUnknown\n      let mut mchk_v = false\n      let mut mi = 0\n      while mi < Array::length(mpairs) {\n        let (_, mve) = Array::get(mpairs, mi)\n        let (mvt, mvs, mvc) = check_expr(mve, env, defs, ms1, mc1, errors, tytab)\n        ms1 = mvs\n        mc1 = mvc\n        if mi == 0 {\n          mvty = mvt\n          mchk_v = map_literal_ground(subst_apply(ms1, mvt))\n        } else {\n          if mchk_v {\n            ms1 = check_assignable(mvty, subst_apply(ms1, mvt), ms1, errors, \"map literal values have incompatible types\", 0 - 1)\n          } else {\n            ()\n          }\n        }\n        mi = mi + 1\n      }\n      if Array::length(mpairs) == 0 {\n        let (mv0, mc2) = fresh_var(mc1)\n        (CtNamed(\"Map\", [\n          CtString,\n          mv0\n        ]), ms1, mc2)\n      } else {\n        (CtNamed(\"Map\", [\n          CtString,\n          subst_apply(ms1, mvty)\n        ]), ms1, mc1)\n      }\n    },\n    ELabeledArg(_, _, la_val) => {\n      let (_, la_s, la_c) = check_expr(la_val, env, defs, s, c, errors, tytab)\n      (CtUnknown, la_s, la_c)\n    },\n    _ => (CtUnknown, s, c)\n  }\n}\n\nfn map_literal_ground(t: Type) -> Bool {\n  match t {\n    CtInt => true,\n    CtDouble => true,\n    CtBool => true,\n    CtString => true,\n    CtChar => true,\n    _ => false\n  }\n}\n")
}

let source_58 = () -> (String, String) {
  ("lib/@vibe/compiler/checker/checker_stmt.vibe",
"\n\nimport @vibe/core {\n  array_empty\n}\n\n\nimport @vibe/compiler/core {\n  Expr,\n  Pat,\n  Stmt,\n  Subst,\n  Type,\n  TypeDef,\n  TypeEnv,\n  TypeExpr,\n  collect_subst_bounds_pairs,\n  env_bind,\n  env_cache,\n  env_flat_bindings,\n  env_lookup_flat,\n  generalize,\n  resolve_builtin,\n  subst_apply,\n  trait_defined,\n  type_implements_trait,\n  type_to_string\n}\n\n\n\n\nimport @vibe/compiler/codegen {\n  desugar_labeled_args, desugar_railway_binds, inject_prelude_result, inject_trait_method_generics\n}\n\n\nexport struct CheckedProgram {\n  checked_stmts: Array[Stmt];\n  final_env: TypeEnv;\n  type_defs: Array[TypeDef];\n  final_subst: Subst;\n  typed_occurrences: Array[(Int, Type)]\n}\n\nexport struct CheckedProgramTypeDefsObservation {\n  checked_program: CheckedProgram;\n  type_def_binders: Array[Array[Int]]\n}\n\n\nfn top_stmt_expr_off(e: Expr) -> Int {\n  match e {\n    EIdent(_, off) => off,\n    ECall(callee, _, off) => if off >= 0 {\n      off\n    } else {\n      top_stmt_expr_off(callee)\n    },\n    EDot(base, _, off, _) => if off >= 0 {\n      off\n    } else {\n      top_stmt_expr_off(base)\n    },\n    EBinOp(_, lhs, _) => top_stmt_expr_off(lhs),\n    EUnaryOp(_, inner) => top_stmt_expr_off(inner),\n    ELet(_, val, _, _) => top_stmt_expr_off(val),\n    ELetRec(_, val, _) => top_stmt_expr_off(val),\n    ELetMut(_, val, _, _) => top_stmt_expr_off(val),\n    EAssign(_, val, _) => top_stmt_expr_off(val),\n    EAssignOp(_, _, val, _) => top_stmt_expr_off(val),\n    ESeq(first, _) => top_stmt_expr_off(first),\n    EIf(cond, _, _) => top_stmt_expr_off(cond),\n    EMatch(scrut, _) => top_stmt_expr_off(scrut),\n    EReturn(inner) => top_stmt_expr_off(inner),\n    _ => 0 - 1\n  }\n}\n\n\nfn es_index_of(names: Array[String], name: String) -> Int {\n  let mut i = 0\n  let mut found = -1\n  while i < Array::length(names) {\n    if Array::get(names, i) == name {\n      found = i\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  found\n}\n\nfn es_string_array_contains(arr: Array[String], v: String) -> Bool {\n  es_index_of(arr, v) >= 0\n}\n\nfn es_split_qualified(name: String) -> (Option[String], String) {\n  let idx = String::index_of(name, \"::\")\n  if idx > 0 {\n    (Some(String::substring(name, 0, idx)), String::substring(name, idx + 2, String::length(name)))\n  } else {\n    (None, name)\n  }\n}\n\nfn es_join_arrow(names: Array[String]) -> String {\n  let mut result = \"\"\n  let mut i = 0\n  while i < Array::length(names) {\n    if i == 0 {\n      result = Array::get(names, i)\n    } else {\n      result = String::concat(result, String::concat(\" -> \", Array::get(names, i)))\n    }\n    i = i + 1\n  }\n  result\n}\n\nfn es_detect_cycle(es_names: Array[String], es_members_list: Array[Array[String]], name: String, path: Array[String]) -> Option[String] {\n  if es_string_array_contains(path, name) {\n    Some(String::concat(\"effectset cycle: \", String::concat(es_join_arrow(path), String::concat(\" -> \", name))))\n  } else {\n    let idx = es_index_of(es_names, name)\n    if idx < 0 {\n      None\n    } else {\n      let members = Array::get(es_members_list, idx)\n      Array::push(path, name)\n      let mut mi = 0\n      let mut result = None\n      while mi < Array::length(members) {\n        match result {\n          None => {\n            result = es_detect_cycle(es_names, es_members_list, Array::get(members, mi), path)\n          },\n          Some(_) => ()\n        }\n        mi = mi + 1\n      }\n      Array::truncate(path, Array::length(path) - 1)\n      result\n    }\n  }\n}\n\nfn es_qualified_collision(ed_names: Array[String], ed_ops_list: Array[Array[String]], qualified_name: String) -> Bool {\n  let (eff_opt, member_name) = es_split_qualified(qualified_name)\n  match eff_opt {\n    Some(eff) => {\n      let idx = es_index_of(ed_names, eff)\n      if idx < 0 {\n        false\n      } else {\n        es_string_array_contains(Array::get(ed_ops_list, idx), member_name)\n      }\n    },\n    None => false\n  }\n}\n\nfn es_collect_tables(stmts: Array[Stmt], from_idx: Int) -> (Array[String], Array[Array[String]], Array[String], Array[Array[String]]) {\n  let es_names = array_empty()\n  let es_members_list = array_empty()\n  let ed_names = array_empty()\n  let ed_ops_list = array_empty()\n  let mut i = from_idx\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SEffectSet(_, esname, esmembers) => {\n        Array::push(es_names, esname)\n        Array::push(es_members_list, esmembers)\n      },\n      SEffectDef(_, edname, _, edops) => {\n        let opnames = for op in edops {\n          let (opname, _, _) = op\n          opname\n        }\n        Array::push(ed_names, edname)\n        Array::push(ed_ops_list, opnames)\n      },\n      _ => ()\n    }\n    i = i + 1\n  }\n  (es_names, es_members_list, ed_names, ed_ops_list)\n}\n\nfn es_expand_into(es_names: Array[String], es_members_list: Array[Array[String]], name: String, path: Array[String], out: Array[String]) -> Unit {\n  if es_string_array_contains(path, name) {\n    ()\n  } else {\n    let idx = es_index_of(es_names, name)\n    if idx < 0 {\n      if es_string_array_contains(out, name) {\n        ()\n      } else {\n        Array::push(out, name)\n      }\n    } else {\n      Array::push(path, name)\n      let members = Array::get(es_members_list, idx)\n      let mut mi = 0\n      while mi < Array::length(members) {\n        es_expand_into(es_names, es_members_list, Array::get(members, mi), path, out)\n        mi = mi + 1\n      }\n      Array::truncate(path, Array::length(path) - 1)\n    }\n  }\n}\n\nfn es_expand_label(es_names: Array[String], es_members_list: Array[Array[String]], name: String) -> Array[String] {\n  let out = array_empty()\n  es_expand_into(es_names, es_members_list, name, array_empty(), out)\n  out\n}\n\nfn es_join_comma(names: Array[String]) -> String {\n  let mut result = \"\"\n  let mut i = 0\n  while i < Array::length(names) {\n    if i == 0 {\n      result = Array::get(names, i)\n    } else {\n      result = String::concat(result, String::concat(\", \", Array::get(names, i)))\n    }\n    i = i + 1\n  }\n  result\n}\n\nfn es_expand_row_string(row: String, es_names: Array[String], es_members_list: Array[Array[String]]) -> String {\n  if Array::length(es_names) == 0 {\n    row\n  } else {\n    let raw = String::split(row, \", \")\n    let out = array_empty()\n    let mut i = 0\n    while i < Array::length(raw) {\n      let expanded = es_expand_label(es_names, es_members_list, Array::get(raw, i))\n      let mut j = 0\n      while j < Array::length(expanded) {\n        let e = Array::get(expanded, j)\n        if es_string_array_contains(out, e) {\n          ()\n        } else {\n          Array::push(out, e)\n        }\n        j = j + 1\n      }\n      i = i + 1\n    }\n    es_join_comma(out)\n  }\n}\n\nfn es_expand_opt_row(eff: Option[String], es_names: Array[String], es_members_list: Array[Array[String]]) -> Option[String] {\n  match eff {\n    Some(row) => Some(es_expand_row_string(row, es_names, es_members_list)),\n    None => None\n  }\n}\n\nfn es_expand_texpr(te: TypeExpr, es_names: Array[String], es_members_list: Array[Array[String]]) -> TypeExpr {\n  match te {\n    TyFn(params, ret, eff) => TyFn(params, ret, es_expand_opt_row(eff, es_names, es_members_list)),\n    _ => te\n  }\n}\n\nfn es_expand_opt_texpr(ty: Option[TypeExpr], es_names: Array[String], es_members_list: Array[Array[String]]) -> Option[TypeExpr] {\n  match ty {\n    Some(te) => Some(es_expand_texpr(te, es_names, es_members_list)),\n    None => None\n  }\n}\n\nfn es_expand_top_value(e: Expr, es_names: Array[String], es_members_list: Array[Array[String]]) -> Expr {\n  match e {\n    EFn(tps, tbs, params, ret, eff, body) => {\n      let expanded_params = for p in params {\n        let (pname, pty) = p\n        (pname, es_expand_opt_texpr(pty, es_names, es_members_list))\n      }\n      EFn(tps, tbs, expanded_params, ret, es_expand_opt_row(eff, es_names, es_members_list), body)\n    },\n    _ => e\n  }\n}\n\nfn es_expand_stmt_effect_rows(stmt: Stmt, es_names: Array[String], es_members_list: Array[Array[String]]) -> Stmt {\n  match stmt {\n    SLet(exported, is_rec, name, ty, body) => SLet(exported, is_rec, name, es_expand_opt_texpr(ty, es_names, es_members_list), es_expand_top_value(body, es_names, es_members_list)),\n    SLetMut(name, ty, body) => SLetMut(name, es_expand_opt_texpr(ty, es_names, es_members_list), es_expand_top_value(body, es_names, es_members_list)),\n    _ => stmt\n  }\n}\n\nfn es_expand_stmts_effect_rows(stmts: Array[Stmt], es_names: Array[String], es_members_list: Array[Array[String]]) -> Array[Stmt] {\n  if Array::length(es_names) == 0 {\n    stmts\n  } else {\n    for s in stmts {\n      es_expand_stmt_effect_rows(s, es_names, es_members_list)\n    }\n  }\n}\n\nfn top_level_reject_msg(what: String, e: Expr) -> String {\n  let base = String::concat(what, \" (ADR-0069)\")\n  let off = top_stmt_expr_off(e)\n  if off >= 0 {\n    String::concat(base, String::concat(\" [@off=\", String::concat(__to_string(off), \"]\")))\n  } else {\n    base\n  }\n}\n\nfn import_cache_lookup(cache: Array[(String, Type)], name: String, i: Int) -> Option[Type] {\n  if i >= Array::length(cache) {\n    None\n  }\n  else {\n    let (cached_name, cached_ty) = Array::get(cache, i)\n    if cached_name == name {\n      Some(cached_ty)\n    }\n    else import_cache_lookup(cache, name, i + 1)\n  }\n}\n\nfn bind_stmt_imports(env: TypeEnv, names: Array[(String, Option[String])]) -> TypeEnv {\n  let env_bindings = env_flat_bindings(env)\n  let import_cache = array_empty()\n  let nlen = Array::length(names)\n  let mut i = 0\n  let mut acc = env\n  while i < nlen {\n    let (name, alias) = Array::get(names, i)\n    let bound_name = match alias {\n      Some(a) => a,\n      None => name\n    }\n    let ty = match import_cache_lookup(import_cache, name, 0) {\n      Some(t) => t,\n      None => {\n        let resolved = match env_lookup_flat(env_bindings, name) {\n          Some(t) => t,\n          None => CtUnknown\n        }\n        Array::push(import_cache, (name, resolved))\n        resolved\n      }\n    }\n    let acc_with_name = env_bind(acc, bound_name, ty)\n    acc = match env_lookup_flat(env_bindings, fn_return_env_name(name)) {\n      Some(ret_ty) => env_bind(acc_with_name, fn_return_env_name(bound_name), ret_ty),\n      None => acc_with_name\n    }\n    i = i + 1\n  }\n  acc\n}\n\nfn annotation_return_type(ann: Option[TypeExpr], defs: Array[TypeDef]) -> Option[Type] {\n  match ann {\n    Some(te) => match te {\n      TyFn(params, ret, _) => {\n        let ret_box = Array::slice([\n          ret\n        ], 0, 1)\n        let _ = Array::length(params)\n        Some(resolve_type_expr(Array::get(ret_box, 0), defs))\n      },\n      _ => None\n    },\n    None => None\n  }\n}\n\nfn fn_expr_return_type(expr: Expr, defs: Array[TypeDef]) -> Option[Type] {\n  match expr {\n    EFn(_, _, _, ret_ty, _, _) => match ret_ty {\n      Some(te) => Some(resolve_type_expr(te, defs)),\n      None => None\n    },\n    _ => None\n  }\n}\n\nfn bind_fn_return(env: TypeEnv, name: String, ret_ty: Type) -> TypeEnv {\n  env_bind(env, fn_return_env_name(name), ret_ty)\n}\n\nfn bind_annotation_return(env: TypeEnv, name: String, ann: Option[TypeExpr], defs: Array[TypeDef]) -> TypeEnv {\n  match annotation_return_type(ann, defs) {\n    Some(ret_ty) => bind_fn_return(env, name, ret_ty),\n    None => env\n  }\n}\n\nfn bind_value_or_annotation_return(env: TypeEnv, name: String, val: Expr, ann: Option[TypeExpr], defs: Array[TypeDef]) -> TypeEnv {\n  match fn_expr_return_type(val, defs) {\n    Some(ret_ty) => bind_fn_return(env, name, ret_ty),\n    None => bind_annotation_return(env, name, ann, defs)\n  }\n}\n\nfn struct_derives_has(derives: Array[String], name: String) -> Bool {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(derives) {\n    if Array::get(derives, i) == name {\n      found = true\n      i = Array::length(derives)\n    } else {\n      i = i + 1\n    }\n  }\n  found\n}\n\nfn derive_name_is_known(name: String) -> Bool {\n  name == \"Eq\" || name == \"Ord\" || name == \"Show\" || name == \"Hash\" || name == \"Default\"\n}\n\nfn find_other_enum_declaring_variant(defs: Array[TypeDef], enum_name: String, vname: String) -> Option[String] {\n  let mut i = 0\n  let mut found = None\n  while i < Array::length(defs) {\n    match Array::get(defs, i) {\n      TDEnum(other_name, _, other_variants) => if other_name != enum_name {\n        let mut vi = 0\n        while vi < Array::length(other_variants) {\n          let (ovn, _) = Array::get(other_variants, vi)\n          if ovn == vname {\n            found = Some(other_name)\n          } else {\n            ()\n          }\n          vi = vi + 1\n        }\n      } else {\n        ()\n      },\n      _ => ()\n    }\n    i = i + 1\n  }\n  found\n}\n\nfn validate_derives(derives: Array[String], errors: Array[String]) -> Unit {\n  let mut i = 0\n  while i < Array::length(derives) {\n    let name = Array::get(derives, i)\n    if name != \"\" && !derive_name_is_known(name) {\n      Array::push(errors, String::concat(\"unknown trait: \", name))\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n}\n\nfn stmt_is_type_decl(stmt: Stmt) -> Bool {\n  match stmt {\n    SEnum(_, _, _, _, _) => true,\n    SSuberror(_, _, _) => true,\n    SStruct(_, _, _, _, _, _) => true,\n    STypeAlias(_, _, _, _) => true,\n    _ => false\n  }\n}\n\nfn reorder_type_decls_first(stmts: Array[Stmt], start: Int) -> Array[Stmt] {\n  let out = Array::slice(stmts, 0, start)\n  let n = Array::length(stmts)\n  let mut i = start\n  while i < n {\n    let st = Array::get(stmts, i)\n    if stmt_is_type_decl(st) {\n      Array::push(out, st)\n    }\n    i = i + 1\n  }\n  let mut j = start\n  while j < n {\n    let st = Array::get(stmts, j)\n    if !stmt_is_type_decl(st) {\n      Array::push(out, st)\n    }\n    j = j + 1\n  }\n  out\n}\n\nfn check_stmts_with_binders(raw_stmts: Array[Stmt], i: Int, env: TypeEnv, defs: Array[TypeDef], type_def_binders: Array[Array[Int]], s: Subst, c: Int, errors: Array[String], tytab: Array[(Int, Type)]) -> (TypeEnv, Subst, Int) {\n  let stmts = reorder_type_decls_first(raw_stmts, i)\n  let mut idx = i\n  let mut cur_env = env\n  let mut cur_s = s\n  let mut cur_c = c\n  let mut hoist_i = idx\n  while hoist_i < Array::length(stmts) {\n    match Array::get(stmts, hoist_i) {\n      SLet(_, _, hname, hann, _) => {\n        let ht = match hann {\n          Some(hte) => resolve_type_expr(hte, defs),\n          None => CtUnknown\n        }\n        cur_env = env_bind(cur_env, hname, ht)\n      },\n      _ => ()\n    }\n    hoist_i = hoist_i + 1\n  }\n  let (es_names, es_members_list, ed_names, ed_ops_list) = es_collect_tables(stmts, idx)\n  let mut resume_shadowed_top = false\n  let mut rst_i = idx\n  while rst_i < Array::length(stmts) {\n    match Array::get(stmts, rst_i) {\n      SLet(_, _, rstname, _, _) => if rstname == \"resume\" {\n        resume_shadowed_top = true\n      } else {\n        ()\n      },\n      SLetMut(rstname, _, _) => if rstname == \"resume\" {\n        resume_shadowed_top = true\n      } else {\n        ()\n      },\n      SExternLet(rstname, _) => if rstname == \"resume\" {\n        resume_shadowed_top = true\n      } else {\n        ()\n      },\n      SLetPat(rstpat, _) => if pat_binds_resume(rstpat) {\n        resume_shadowed_top = true\n      } else {\n        ()\n      },\n      SImport(_, rstnames) => {\n        let mut rn_i = 0\n        while rn_i < Array::length(rstnames) {\n          let (rn_name, rn_alias) = Array::get(rstnames, rn_i)\n          let rn_bound = match rn_alias {\n            Some(a) => a,\n            None => rn_name\n          }\n          if rn_bound == \"resume\" {\n            resume_shadowed_top = true\n          } else {\n            ()\n          }\n          rn_i = rn_i + 1\n        }\n      },\n      SReExport(_, rstnames) => {\n        let mut rn_i = 0\n        while rn_i < Array::length(rstnames) {\n          let (rn_name, rn_alias) = Array::get(rstnames, rn_i)\n          let rn_bound = match rn_alias {\n            Some(a) => a,\n            None => rn_name\n          }\n          if rn_bound == \"resume\" {\n            resume_shadowed_top = true\n          } else {\n            ()\n          }\n          rn_i = rn_i + 1\n        }\n      },\n      _ => ()\n    }\n    rst_i = rst_i + 1\n  }\n  while idx < Array::length(stmts) {\n    let env = cur_env\n    let s = cur_s\n    let c = cur_c\n    let stmt = Array::get(stmts, idx)\n    match stmt {\n      SLet(_, _, _, _, rv) => reject_resume_outside_handler(rv, resume_shadowed_top, errors),\n      SLetMut(_, _, rv) => reject_resume_outside_handler(rv, resume_shadowed_top, errors),\n      SLetPat(_, rv) => reject_resume_outside_handler(rv, resume_shadowed_top, errors),\n      STest(_, rb) => reject_resume_outside_handler(rb, resume_shadowed_top, errors),\n      SBench(_, rb) => reject_resume_outside_handler(rb, resume_shadowed_top, errors),\n      SExpr(re) => reject_resume_outside_handler(re, resume_shadowed_top, errors),\n      _ => ()\n    }\n    let (new_env, s1, c1) = match stmt {\n      SLet(_, is_rec, name, ann, val) => {\n        let (vt, ns0, nc) = if is_rec {\n          check_expr(val, env_bind(env, name, CtUnknown), defs, s, c, errors, tytab)\n        } else {\n          check_expr(val, env, defs, s, c, errors, tytab)\n        }\n        let (ns, t) = match ann {\n          Some(te) => {\n            let resolved_te = resolve_type_expr(te, defs)\n            let actual_v = subst_apply(ns0, vt)\n            let ns_b = check_assignable(resolved_te, actual_v, ns0, errors, String::concat(\"binding type mismatch for \", name), 0 - 1)\n            (ns_b, preserve_generic_instantiation(resolved_te, subst_apply(ns_b, vt)))\n          },\n          None => {\n            let vt_resolved = subst_apply(ns0, vt)\n            if is_array_builder_ty(vt_resolved) || is_region_tagged_ty(vt_resolved) {\n              (ns0, vt)\n            } else {\n              (ns0, generalize(ns0, vt))\n            }\n          }\n        }\n        let env1 = env_bind(env, name, t)\n        (bind_value_or_annotation_return(env1, name, val, ann, defs), ns, nc)\n      },\n      SLetMut(name, ann, val) => {\n        Array::push(errors, top_level_reject_msg(\"top-level `let mut` bindings are not allowed; move it into fn main\", val))\n        let (vt, ns0, nc) = check_expr(val, env, defs, s, c, errors, tytab)\n        let ns = match ann {\n          Some(te) => check_assignable(resolve_type_expr(te, defs), subst_apply(ns0, vt), ns0, errors, String::concat(\"binding type mismatch for \", name), 0 - 1),\n          None => ns0\n        }\n        let t = match ann {\n          Some(te) => resolve_type_expr(te, defs),\n          None => vt\n        }\n        let env1 = env_bind(env, name, t)\n        (bind_value_or_annotation_return(env1, name, val, ann, defs), ns, nc)\n      },\n      SLetPat(pat, val) => {\n        let (vt, ns, nc) = check_expr(val, env, defs, s, c, errors, tytab)\n        let new_env = match pat {\n          PTuple(pats) => match vt {\n            CtTuple(types) => {\n              let mut e = env\n              let mut pi = 0\n              while pi < Array::length(pats) {\n                match Array::get(pats, pi) {\n                  PBind(name) => if pi < Array::length(types) {\n                    e = env_bind(e, name, Array::get(types, pi))\n                  } else {\n                    e = env_bind(e, name, CtUnknown)\n                  },\n                  _ => ()\n                }\n                pi = pi + 1\n              }\n              e\n            },\n            _ => {\n              let concrete_non_tuple = match subst_apply(ns, vt) {\n                CtInt => true,\n                CtDouble => true,\n                CtBool => true,\n                CtString => true,\n                CtChar => true,\n                CtUnit => true,\n                CtBytes => true,\n                CtArray(_) => true,\n                CtOption(_) => true,\n                CtFn(_, _, _) => true,\n                CtStruct(_) => true,\n                CtEnum(_) => true,\n                _ => false\n              }\n              if concrete_non_tuple {\n                Array::push(errors, \"tuple pattern cannot destructure a non-tuple value\")\n              } else {\n                ()\n              }\n              let mut e = env\n              let mut pi = 0\n              while pi < Array::length(pats) {\n                match Array::get(pats, pi) {\n                  PBind(name) => {\n                    e = env_bind(e, name, CtUnknown)\n                  },\n                  _ => ()\n                }\n                pi = pi + 1\n              }\n              e\n            }\n          },\n          PBind(name) => env_bind(env, name, vt),\n          PStruct(_, fields) => {\n            let mut e = env\n            let mut fi = 0\n            while fi < Array::length(fields) {\n              let (_, fpat) = Array::get(fields, fi)\n              match fpat {\n                PBind(name) => {\n                  e = env_bind(e, name, CtUnknown)\n                },\n                _ => ()\n              }\n              fi = fi + 1\n            }\n            e\n          },\n          _ => env\n        }\n        (new_env, ns, nc)\n      },\n      SEnum(_, name, params, variants, enum_derives) => {\n        validate_derives(enum_derives, errors)\n        let param_len = Array::length(params)\n        let param_var_ids = array_empty()\n        let param_var_types = array_empty()\n        let mut pi = 0\n        while pi < param_len {\n          let vid = c + pi\n          Array::push(param_var_ids, vid)\n          Array::push(param_var_types, CtVar(vid))\n          pi = pi + 1\n        }\n        let ctor_result_type = if param_len == 0 {\n          CtEnum(name)\n        } else {\n          CtNamed(name, param_var_types)\n        }\n        let ctor_bounds = array_empty()\n        let resolved_variants = array_empty()\n        let mut vi = 0\n        while vi < Array::length(variants) {\n          let (vname, vtypes) = Array::get(variants, vi)\n          let resolved_vtypes = array_empty()\n          let mut ti = 0\n          while ti < Array::length(vtypes) {\n            let vt = subst_type_params(resolve_type_expr(Array::get(vtypes, ti), defs), params, param_var_types)\n            Array::push(resolved_vtypes, vt)\n            ti = ti + 1\n          }\n          Array::push(resolved_variants, (vname, resolved_vtypes))\n          vi = vi + 1\n        }\n        Array::push(defs, TDEnum(name, params, resolved_variants))\n        Array::push(type_def_binders, param_var_ids)\n        let mut env1 = env_bind(env, name, CtEnum(name))\n        let mut ci2 = 0\n        while ci2 < Array::length(variants) {\n          let (vname, vtypes) = Array::get(variants, ci2)\n          match find_other_enum_declaring_variant(defs, name, vname) {\n            Some(other) => Array::push(errors, String::concat(String::concat(String::concat(String::concat(\"constructor name collision: \", vname), \" is declared by both \"), other), String::concat(\" and \", String::concat(name, \" in the same compiled unit; bare constructor references are ambiguous (qualified construction is not supported) -- rename one variant\")))),\n            None => ()\n          }\n          let ctor_ty = if Array::length(vtypes) == 0 {\n            ctor_result_type\n          } else {\n            let resolved_args = array_empty()\n            let mut ai = 0\n            while ai < Array::length(vtypes) {\n              let arg_ty = subst_type_params(resolve_type_expr(Array::get(vtypes, ai), defs), params, param_var_types)\n              Array::push(resolved_args, arg_ty)\n              ai = ai + 1\n            }\n            CtFn(resolved_args, ctor_result_type, None)\n          }\n          let exported_ctor_ty = if param_len == 0 {\n            ctor_ty\n          } else {\n            CtForAll(param_var_ids, ctor_bounds, ctor_ty)\n          }\n          env1 = env_bind(env1, vname, exported_ctor_ty)\n          match ctor_ty {\n            CtFn(_, ret, _) => {\n              let exported_ret_ty = if param_len == 0 {\n                ret\n              } else {\n                CtForAll(param_var_ids, ctor_bounds, ret)\n              }\n              env1 = bind_fn_return(env1, vname, exported_ret_ty)\n            },\n            _ => ()\n          }\n          ci2 = ci2 + 1\n        }\n        let env_eq = env_bind(env1, String::concat(name, \"::equals\"), CtFn([\n          ctor_result_type,\n          ctor_result_type\n        ], CtBool, None))\n        let env_ord = if struct_derives_has(enum_derives, \"Ord\") {\n          env_bind(env_eq, String::concat(name, \"::compare\"), CtFn([\n            ctor_result_type,\n            ctor_result_type\n          ], CtInt, None))\n        } else {\n          env_eq\n        }\n        let env_show = if struct_derives_has(enum_derives, \"Show\") || struct_derives_has(enum_derives, \"Hash\") {\n          env_bind(env_ord, String::concat(name, \"::to_string\"), CtFn([\n            ctor_result_type\n          ], CtString, None))\n        } else {\n          env_ord\n        }\n        let env_hash = if struct_derives_has(enum_derives, \"Hash\") {\n          let env_h = EnvTraitImpl(\"Hash\", ctor_result_type, env_show)\n          env_bind(env_h, String::concat(name, \"::hash_key\"), CtFn([\n            ctor_result_type\n          ], CtString, None))\n        } else {\n          env_show\n        }\n        let env_default = if struct_derives_has(enum_derives, \"Default\") {\n          env_bind(env_hash, String::concat(name, \"::default\"), CtFn(array_empty(), ctor_result_type, None))\n        } else {\n          env_hash\n        }\n        (env_default, s, c + param_len)\n      },\n      SSuberror(_, name, variants) => {\n        let ctor_result_type = CtEnum(name)\n        let resolved_variants = array_empty()\n        let mut vi = 0\n        while vi < Array::length(variants) {\n          let (vname, vtypes) = Array::get(variants, vi)\n          let resolved_vtypes = array_empty()\n          let mut ti = 0\n          while ti < Array::length(vtypes) {\n            Array::push(resolved_vtypes, resolve_type_expr(Array::get(vtypes, ti), defs))\n            ti = ti + 1\n          }\n          Array::push(resolved_variants, (vname, resolved_vtypes))\n          vi = vi + 1\n        }\n        Array::push(defs, TDEnum(name, array_empty(), resolved_variants))\n        Array::push(type_def_binders, array_empty())\n        let mut env1 = env_bind(env, name, CtEnum(name))\n        let mut ci2 = 0\n        while ci2 < Array::length(variants) {\n          let (vname, vtypes) = Array::get(variants, ci2)\n          let ctor_ty = if Array::length(vtypes) == 0 {\n            ctor_result_type\n          } else {\n            let resolved_args = array_empty()\n            let mut ai = 0\n            while ai < Array::length(vtypes) {\n              Array::push(resolved_args, resolve_type_expr(Array::get(vtypes, ai), defs))\n              ai = ai + 1\n            }\n            CtFn(resolved_args, ctor_result_type, None)\n          }\n          env1 = env_bind(env1, vname, ctor_ty)\n          match ctor_ty {\n            CtFn(_, ret, _) => {\n              env1 = bind_fn_return(env1, vname, ret)\n            },\n            _ => ()\n          }\n          ci2 = ci2 + 1\n        }\n        let env_eq = env_bind(env1, String::concat(name, \"::equals\"), CtFn([\n          ctor_result_type,\n          ctor_result_type\n        ], CtBool, None))\n        (env_eq, s, c)\n      },\n      SStruct(_, name, field_defs, derives, mut_fields, tparams) => {\n        validate_derives(derives, errors)\n        let resolved_fields = array_empty()\n        let mut fi = 0\n        while fi < Array::length(field_defs) {\n          let (fname, ftype_expr) = Array::get(field_defs, fi)\n          let ftype = resolve_type_expr(ftype_expr, defs)\n          Array::push(resolved_fields, (fname, ftype))\n          fi = fi + 1\n        }\n        Array::push(defs, TDStruct(name, resolved_fields, mut_fields, tparams))\n        Array::push(type_def_binders, array_empty())\n        let field_types = array_empty()\n        let mut fj = 0\n        while fj < Array::length(resolved_fields) {\n          let (_, fty) = Array::get(resolved_fields, fj)\n          Array::push(field_types, fty)\n          fj = fj + 1\n        }\n        let env1 = env_bind(env, name, CtFn(field_types, CtStruct(name), None))\n        let env2 = if struct_derives_has(derives, \"Ord\") {\n          env_bind(env1, String::concat(name, \"::compare\"), CtFn([\n            CtStruct(name),\n            CtStruct(name)\n          ], CtInt, None))\n        } else {\n          env1\n        }\n        let env3 = if struct_derives_has(derives, \"Show\") || struct_derives_has(derives, \"Hash\") {\n          env_bind(env2, String::concat(name, \"::to_string\"), CtFn([\n            CtStruct(name)\n          ], CtString, None))\n        } else {\n          env2\n        }\n        let env4 = env_bind(env3, String::concat(name, \"::equals\"), CtFn([\n          CtStruct(name),\n          CtStruct(name)\n        ], CtBool, None))\n        let env_hash = if struct_derives_has(derives, \"Hash\") {\n          let env_h = EnvTraitImpl(\"Hash\", CtStruct(name), env4)\n          env_bind(env_h, String::concat(name, \"::hash_key\"), CtFn([\n            CtStruct(name)\n          ], CtString, None))\n        } else {\n          env4\n        }\n        let env5 = if struct_derives_has(derives, \"Default\") {\n          env_bind(env_hash, String::concat(name, \"::default\"), CtFn(array_empty(), CtStruct(name), None))\n        } else {\n          env_hash\n        }\n        (bind_fn_return(env5, name, CtStruct(name)), s, c)\n      },\n      STypeAlias(_, name, params, te) => {\n        let t = resolve_type_expr(te, defs)\n        Array::push(defs, TDAlias(name, params, t))\n        Array::push(type_def_binders, array_empty())\n        (env_bind(env, name, t), s, c)\n      },\n      SExternLet(name, te) => {\n        let t = resolve_type_expr(te, defs)\n        let env1 = env_bind(env, name, t)\n        (bind_annotation_return(env1, name, Some(te), defs), s, c)\n      },\n      STest(_, body) => {\n        let (_, ns, nc) = check_expr(body, env, defs, s, c, errors, tytab)\n        (env, ns, nc)\n      },\n      SBench(_, body) => {\n        let (_, ns, nc) = check_expr(body, env, defs, s, c, errors, tytab)\n        (env, ns, nc)\n      },\n      SExpr(expr) => {\n        let is_zero_alloc_marker = match expr {\n          EIdent(id_name, _) => id_name == \"@zero_alloc\",\n          _ => false\n        }\n        if is_zero_alloc_marker {\n          (env, s, c)\n        } else {\n          Array::push(errors, top_level_reject_msg(\"top-level expressions are not allowed; move it into fn main\", expr))\n          let (_, ns, nc) = check_expr(expr, env, defs, s, c, errors, tytab)\n          (env, ns, nc)\n        }\n      },\n      SModule(_, _, body) => {\n        let _ = check_stmts_with_binders(body, 0, env, defs, type_def_binders, s, c, errors, tytab)\n        (env, s, c)\n      },\n      SImport(_, names) => (bind_stmt_imports(env, names), s, c)\n      ,\n      SReExport(_, names) => (bind_stmt_imports(env, names), s, c)\n      ,\n      SAliasDecl(_, _) => (env, s, c)\n      ,\n      STrait(_, name, supers, methods, _, tparams) => {\n        let is_open = false\n        (EnvTraitDef(name, supers, is_open, methods, env, tparams), s, c)\n      },\n      SImpl(tparams, tbounds, trait_name, type_name) => {\n        if trait_name == \"Send\" {\n          Array::push(errors, \"`Send` is a compiler-judged structural marker and cannot be implemented; remove `impl Send`\")\n        } else {\n          ()\n        }\n        let target = match resolve_builtin(type_name) {\n          Some(t) => t,\n          None => CtNamed(type_name, array_empty())\n        }\n        let new_env = if Array::length(tparams) > 0 {\n          EnvTraitImplGen(trait_name, tparams, tbounds, target, env)\n        } else {\n          EnvTraitImpl(trait_name, target, env)\n        }\n        (new_env, s, c)\n      },\n      SEffectDef(_, ename, eparams, ops) => {\n        let resolved_ops = array_empty()\n        let mut oi = 0\n        while oi < Array::length(ops) {\n          let (opname, opparams, opret) = Array::get(ops, oi)\n          let rp = array_empty()\n          let mut pi = 0\n          while pi < Array::length(opparams) {\n            Array::push(rp, resolve_type_expr(Array::get(opparams, pi), defs))\n            pi = pi + 1\n          }\n          Array::push(resolved_ops, (opname, rp, resolve_type_expr(opret, defs)))\n          oi = oi + 1\n        }\n        Array::push(defs, TDEffect(ename, resolved_ops, eparams))\n        Array::push(type_def_binders, array_empty())\n        (env, s, c)\n      },\n      SEffectSet(_, esname, _) => {\n        if es_qualified_collision(ed_names, ed_ops_list, esname) {\n          Array::push(errors, String::concat(\"effectset '\", String::concat(esname, \"' collides with an operation of the same name declared on its effect (operations and effectsets share the effect-row member namespace) -- rename the effectset or the operation\")))\n        } else {\n          match es_detect_cycle(es_names, es_members_list, esname, array_empty()) {\n            Some(msg) => Array::push(errors, msg),\n            None => ()\n          }\n        }\n        (env, s, c)\n      },\n      _ => (env, s, c)\n    }\n    cur_env = new_env\n    cur_s = s1\n    cur_c = c1\n    idx = idx + 1\n  }\n  (cur_env, cur_s, cur_c)\n}\n\nfn check_program_bounds(env: TypeEnv, s: Subst, defs: Array[TypeDef], errors: Array[String]) -> Unit {\n  check_program_bounds_impl(env, s, defs, errors, false)\n}\n\nfn check_program_bounds_impl(env: TypeEnv, s: Subst, defs: Array[TypeDef], errors: Array[String], send_only: Bool) -> Unit {\n  let pairs = collect_subst_bounds_pairs(s)\n  let n = Array::length(pairs)\n  let mut i = 0\n  while i < n {\n    let (vid, bounds) = Array::get(pairs, i)\n    let resolved = subst_apply(s, CtVar(vid))\n    match resolved {\n      CtVar(_) => (),\n      CtUnknown => (),\n      _ => {\n        let bn = Array::length(bounds)\n        let mut bi = 0\n        while bi < bn {\n          let b = Array::get(bounds, bi)\n          let sat = if b == \"\" {\n            true\n          } else if b == \"Send\" {\n            type_send_ok(env, s, defs, resolved)\n          } else if send_only {\n            true\n          } else {\n            type_implements_trait(env, s, resolved, b)\n          }\n          if b != \"\" && not(sat) {\n            Array::push(errors, String::concat(\"no impl `\", String::concat(b, String::concat(\"` for `\", String::concat(type_to_string(resolved), \"`\")))))\n          }\n          bi = bi + 1\n        }\n      }\n    }\n    i = i + 1\n  }\n}\n\nfn geff_row_targ_errors_into(row: Option[String], ed_names: Array[String], ed_tpcounts: Array[Int], es_names: Array[String], errors: Array[String]) -> Unit {\n  match row {\n    None => (),\n    Some(r) => {\n      let raw = String::split(r, \",\")\n      let mut i = 0\n      while i < Array::length(raw) {\n        let label = String::trim(Array::get(raw, i))\n        let bi = String::index_of(label, \"[\")\n        if bi > 0 {\n          let base = label[0: bi]\n          let inner = String::trim(label[bi + 1: String::length(label) - 1])\n          let mut is_es = false\n          let mut esi = 0\n          while esi < Array::length(es_names) {\n            if Array::get(es_names, esi) == base {\n              is_es = true\n            } else {\n              ()\n            }\n            esi = esi + 1\n          }\n          if is_es {\n            Array::push(errors, String::concat(\"effect row item `\", String::concat(label, String::concat(\"`: `\", String::concat(base, \"` is an effectset — effectset instantiation in a row is not supported yet (ADR-0071)\")))))\n          } else if String::length(inner) == 0 {\n            Array::push(errors, String::concat(\"effect row item `\", String::concat(label, \"` needs a type argument between the brackets\")))\n          } else {\n            let mut edi = 0\n            let mut tpc = 0 - 1\n            while edi < Array::length(ed_names) {\n              if Array::get(ed_names, edi) == base {\n                tpc = Array::get(ed_tpcounts, edi)\n              } else {\n                ()\n              }\n              edi = edi + 1\n            }\n            if tpc == 0 {\n              Array::push(errors, String::concat(\"effect row item `\", String::concat(label, String::concat(\"`: effect \", String::concat(base, \" declares no type parameters\")))))\n            } else if tpc > 1 {\n              Array::push(errors, String::concat(\"effect row item `\", String::concat(label, String::concat(\"`: effect \", String::concat(base, String::concat(\" declares \", String::concat(__to_string(tpc), \" type parameters; a row item supports exactly one type argument for now\")))))))\n            } else {\n              ()\n            }\n          }\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n    }\n  }\n}\n\nfn geff_check_texpr_rows(te: TypeExpr, ed_names: Array[String], ed_tpcounts: Array[Int], es_names: Array[String], errors: Array[String]) -> Unit {\n  match te {\n    TyFn(params, ret, eff) => {\n      geff_row_targ_errors_into(eff, ed_names, ed_tpcounts, es_names, errors)\n      let mut i = 0\n      while i < Array::length(params) {\n        geff_check_texpr_rows(Array::get(params, i), ed_names, ed_tpcounts, es_names, errors)\n        i = i + 1\n      }\n      geff_check_texpr_rows(ret, ed_names, ed_tpcounts, es_names, errors)\n    },\n    TyApp(_, args) => {\n      let mut i = 0\n      while i < Array::length(args) {\n        geff_check_texpr_rows(Array::get(args, i), ed_names, ed_tpcounts, es_names, errors)\n        i = i + 1\n      }\n    },\n    TyTuple(elems) => {\n      let mut i = 0\n      while i < Array::length(elems) {\n        geff_check_texpr_rows(Array::get(elems, i), ed_names, ed_tpcounts, es_names, errors)\n        i = i + 1\n      }\n    },\n    _ => ()\n  }\n}\n\nfn geff_check_opt_texpr_rows(te: Option[TypeExpr], ed_names: Array[String], ed_tpcounts: Array[Int], es_names: Array[String], errors: Array[String]) -> Unit {\n  match te {\n    Some(t) => geff_check_texpr_rows(t, ed_names, ed_tpcounts, es_names, errors),\n    None => ()\n  }\n}\n\nfn geff_check_value_rows(e: Expr, ed_names: Array[String], ed_tpcounts: Array[Int], es_names: Array[String], errors: Array[String]) -> Unit {\n  match e {\n    EFn(_, _, params, ret, eff, _) => {\n      geff_row_targ_errors_into(eff, ed_names, ed_tpcounts, es_names, errors)\n      let mut i = 0\n      while i < Array::length(params) {\n        let (_, pty) = Array::get(params, i)\n        geff_check_opt_texpr_rows(pty, ed_names, ed_tpcounts, es_names, errors)\n        i = i + 1\n      }\n      geff_check_opt_texpr_rows(ret, ed_names, ed_tpcounts, es_names, errors)\n    },\n    _ => ()\n  }\n}\n\nfn geff_validate_row_targs(stmts: Array[Stmt], errors: Array[String]) -> Unit {\n  let ed_names = array_empty()\n  let ed_tpcounts = array_empty()\n  let es_names = array_empty()\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SEffectDef(_, ename, eparams, _) => {\n        Array::push(ed_names, ename)\n        Array::push(ed_tpcounts, Array::length(eparams))\n      },\n      SEffectSet(_, esname, _) => Array::push(es_names, esname),\n      _ => ()\n    }\n    i = i + 1\n  }\n  let mut j = 0\n  while j < Array::length(stmts) {\n    match Array::get(stmts, j) {\n      SLet(_, _, _, ty, body) => {\n        geff_check_opt_texpr_rows(ty, ed_names, ed_tpcounts, es_names, errors)\n        geff_check_value_rows(body, ed_names, ed_tpcounts, es_names, errors)\n      },\n      SLetMut(_, ty, body) => {\n        geff_check_opt_texpr_rows(ty, ed_names, ed_tpcounts, es_names, errors)\n        geff_check_value_rows(body, ed_names, ed_tpcounts, es_names, errors)\n      },\n      _ => ()\n    }\n    j = j + 1\n  }\n}\n\nfn collect_async_effect_errors(stmts: Array[Stmt], env: TypeEnv, frozen_errors: Array[String]) -> Unit {\n  if Array::length(frozen_errors) == 0 {\n    let eff_errs = check_async_effects_stmts(stmts, env)\n    let mut i = 0\n    while i < Array::length(eff_errs) {\n      Array::push(frozen_errors, effect_error_to_string(Array::get(eff_errs, i)))\n      i = i + 1\n    }\n    if Array::length(frozen_errors) == 0 {\n      geff_validate_row_targs(stmts, frozen_errors)\n    }\n    if Array::length(frozen_errors) == 0 {\n      let (perform_es_names, perform_es_members_list, _, _) = es_collect_tables(stmts, 0)\n      let expanded_stmts = es_expand_stmts_effect_rows(stmts, perform_es_names, perform_es_members_list)\n      let perform_errs = check_perform_effects_stmts_env(expanded_stmts, env)\n      let mut j = 0\n      while j < Array::length(perform_errs) {\n        Array::push(frozen_errors, effect_error_to_string(Array::get(perform_errs, j)))\n        j = j + 1\n      }\n    }\n    if Array::length(frozen_errors) == 0 {\n      let mut_errs = check_mutability_stmts(stmts)\n      let mut k = 0\n      while k < Array::length(mut_errs) {\n        Array::push(frozen_errors, effect_error_to_string(Array::get(mut_errs, k)))\n        k = k + 1\n      }\n    }\n  }\n}\n\nfn labeled_name_marker(off: Int, len: Int) -> String {\n  if off >= 0 && len > 0 {\n    String::concat(\" [@off=\", String::concat(__to_string(off), String::concat(\":\", String::concat(__to_string(off + len), \"]\"))))\n  } else if off >= 0 {\n    String::concat(\" [@off=\", String::concat(__to_string(off), \"]\"))\n  } else {\n    \"\"\n  }\n}\n\nfn labeled_param_base_name(n: String) -> String {\n  let ln = String::length(n)\n  if ln > 0 {\n    let last = n[ln - 1: ln]\n    if last == \"~\" || last == \"?\" {\n      n[0: ln - 1]\n    } else {\n      n\n    }\n  } else {\n    n\n  }\n}\n\nfn collect_labeled_check_fns(stmts: Array[Stmt]) -> Array[(String, Array[String])] {\n  let out = array_empty()\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SLet(_, _, fname, _, body) => match body {\n        EFn(_, _, params, _, _, _) => {\n          let names = array_empty()\n          let mut pi = 0\n          while pi < Array::length(params) {\n            let (pn, _) = Array::get(params, pi)\n            Array::push(names, labeled_param_base_name(pn))\n            pi = pi + 1\n          }\n          Array::push(out, (fname, names))\n        },\n        _ => ()\n      },\n      _ => ()\n    }\n    i = i + 1\n  }\n  out\n}\n\nfn lookup_labeled_check_fn(tbl: Array[(String, Array[String])], fname: String) -> Option[Array[String]] {\n  let mut i = 0\n  let mut found = None\n  while i < Array::length(tbl) {\n    let (n, names) = Array::get(tbl, i)\n    if n == fname {\n      found = Some(names)\n      i = Array::length(tbl)\n    } else {\n      i = i + 1\n    }\n  }\n  found\n}\n\nfn check_mixed_argument_modes(fname: String, fname_off: Int, args: Array[Expr], errors: Array[String]) -> Unit {\n  let mut has_labeled = false\n  let mut has_plain = false\n  let mut i = 0\n  while i < Array::length(args) {\n    match Array::get(args, i) {\n      ELabeledArg(_, _, _) => {\n        has_labeled = true\n      },\n      _ => {\n        has_plain = true\n      }\n    }\n    i = i + 1\n  }\n  if has_labeled && has_plain {\n    let marker = labeled_name_marker(fname_off, String::length(fname))\n    Array::push(errors, String::concat(\"call to \", String::concat(fname, String::concat(\" mixes positional and labeled arguments — use either all positional or all labeled arguments\", marker))))\n  } else {\n    ()\n  }\n}\n\nfn labeled_name_check_call(fname: String, fname_off: Int, args: Array[Expr], pnames: Array[String], errors: Array[String]) -> Unit {\n  let mut ai = 0\n  while ai < Array::length(args) {\n    match Array::get(args, ai) {\n      ELabeledArg(lbl, _, _) => {\n        let in_position = if ai < Array::length(pnames) {\n          Array::get(pnames, ai) == lbl\n        } else {\n          false\n        }\n        if in_position {\n          ()\n        } else {\n          let mut known = false\n          let mut pi = 0\n          while pi < Array::length(pnames) {\n            if Array::get(pnames, pi) == lbl {\n              known = true\n            } else {\n              ()\n            }\n            pi = pi + 1\n          }\n          let marker = labeled_name_marker(fname_off, String::length(fname))\n          if known {\n            Array::push(errors, String::concat(\"labeled argument `\", String::concat(lbl, String::concat(\"` for \", String::concat(fname, String::concat(\" is out of declared parameter order\", marker))))))\n          } else {\n            Array::push(errors, String::concat(\"unknown labeled argument `\", String::concat(lbl, String::concat(\"` for \", String::concat(fname, marker)))))\n          }\n        }\n      },\n      _ => ()\n    }\n    ai = ai + 1\n  }\n}\n\nfn labeled_walk_shadowed(shadows: Array[String], name: String) -> Bool {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(shadows) {\n    if Array::get(shadows, i) == name {\n      found = true\n      i = Array::length(shadows)\n    } else {\n      i = i + 1\n    }\n  }\n  found\n}\n\nfn labeled_walk_pat_binds(pat: Pat, shadows: Array[String]) -> Unit {\n  match pat {\n    PBind(n) => Array::push(shadows, n),\n    PCtor(_, ps) => {\n      let mut i = 0\n      while i < Array::length(ps) {\n        labeled_walk_pat_binds(Array::get(ps, i), shadows)\n        i = i + 1\n      }\n    },\n    PTuple(ps) => {\n      let mut i = 0\n      while i < Array::length(ps) {\n        labeled_walk_pat_binds(Array::get(ps, i), shadows)\n        i = i + 1\n      }\n    },\n    POr(a, b) => {\n      labeled_walk_pat_binds(a, shadows)\n      labeled_walk_pat_binds(b, shadows)\n    },\n    PStruct(_, fields) => {\n      let mut i = 0\n      while i < Array::length(fields) {\n        let (_, fp) = Array::get(fields, i)\n        labeled_walk_pat_binds(fp, shadows)\n        i = i + 1\n      }\n    },\n    _ => ()\n  }\n}\n\nfn labeled_name_check_expr(e: Expr, tbl: Array[(String, Array[String])], shadows: Array[String], errors: Array[String], pre_desugar: Bool) -> Unit {\n  match e {\n    ECall(callee, args, _) => {\n      labeled_name_check_expr(callee, tbl, shadows, errors, pre_desugar)\n      let mut i = 0\n      while i < Array::length(args) {\n        labeled_name_check_expr(Array::get(args, i), tbl, shadows, errors, pre_desugar)\n        i = i + 1\n      }\n      match callee {\n        EIdent(fname, fname_off) => {\n          let mut has_labeled = false\n          let mut li = 0\n          while li < Array::length(args) {\n            match Array::get(args, li) {\n              ELabeledArg(_, _, _) => {\n                has_labeled = true\n              },\n              _ => ()\n            }\n            li = li + 1\n          }\n          if has_labeled {\n            if pre_desugar {\n              if labeled_walk_shadowed(shadows, fname) {\n                check_mixed_argument_modes(fname, fname_off, args, errors)\n              } else {\n                match lookup_labeled_check_fn(tbl, fname) {\n                  Some(_) => check_mixed_argument_modes(fname, fname_off, args, errors),\n                  None => ()\n                }\n              }\n            } else if !labeled_walk_shadowed(shadows, fname) {\n              match lookup_labeled_check_fn(tbl, fname) {\n                Some(pnames) => labeled_name_check_call(fname, fname_off, args, pnames, errors),\n                None => ()\n              }\n            } else {\n              ()\n            }\n          } else {\n            ()\n          }\n        },\n        _ => ()\n      }\n    },\n    ELabeledArg(_, _, v) => labeled_name_check_expr(v, tbl, shadows, errors, pre_desugar),\n    EBinOp(_, l, r) => {\n      labeled_name_check_expr(l, tbl, shadows, errors, pre_desugar)\n      labeled_name_check_expr(r, tbl, shadows, errors, pre_desugar)\n    },\n    EUnaryOp(_, inner) => labeled_name_check_expr(inner, tbl, shadows, errors, pre_desugar),\n    ETuple(items) => {\n      let mut i = 0\n      while i < Array::length(items) {\n        labeled_name_check_expr(Array::get(items, i), tbl, shadows, errors, pre_desugar)\n        i = i + 1\n      }\n    },\n    EArray(items) => {\n      let mut i = 0\n      while i < Array::length(items) {\n        labeled_name_check_expr(Array::get(items, i), tbl, shadows, errors, pre_desugar)\n        i = i + 1\n      }\n    },\n    ESpread(inner) => labeled_name_check_expr(inner, tbl, shadows, errors, pre_desugar),\n    ERecord(_, fields, _) => {\n      let mut i = 0\n      while i < Array::length(fields) {\n        let (_, fv) = Array::get(fields, i)\n        labeled_name_check_expr(fv, tbl, shadows, errors, pre_desugar)\n        i = i + 1\n      }\n    },\n    EMap(pairs) => {\n      let mut i = 0\n      while i < Array::length(pairs) {\n        let (_, pv) = Array::get(pairs, i)\n        labeled_name_check_expr(pv, tbl, shadows, errors, pre_desugar)\n        i = i + 1\n      }\n    },\n    EIf(cnd, thn, els) => {\n      labeled_name_check_expr(cnd, tbl, shadows, errors, pre_desugar)\n      labeled_name_check_expr(thn, tbl, shadows, errors, pre_desugar)\n      labeled_name_check_expr(els, tbl, shadows, errors, pre_desugar)\n    },\n    ELet(name, v, b, _) => {\n      labeled_name_check_expr(v, tbl, shadows, errors, pre_desugar)\n      let mark = Array::length(shadows)\n      Array::push(shadows, name)\n      labeled_name_check_expr(b, tbl, shadows, errors, pre_desugar)\n      Array::truncate(shadows, mark)\n    },\n    ELetRec(name, v, b) => {\n      let mark = Array::length(shadows)\n      Array::push(shadows, name)\n      labeled_name_check_expr(v, tbl, shadows, errors, pre_desugar)\n      labeled_name_check_expr(b, tbl, shadows, errors, pre_desugar)\n      Array::truncate(shadows, mark)\n    },\n    ELetMut(name, v, b, _) => {\n      labeled_name_check_expr(v, tbl, shadows, errors, pre_desugar)\n      let mark = Array::length(shadows)\n      Array::push(shadows, name)\n      labeled_name_check_expr(b, tbl, shadows, errors, pre_desugar)\n      Array::truncate(shadows, mark)\n    },\n    EAssign(_, v, k) => {\n      labeled_name_check_expr(v, tbl, shadows, errors, pre_desugar)\n      labeled_name_check_expr(k, tbl, shadows, errors, pre_desugar)\n    },\n    EAssignOp(_, _, v, k) => {\n      labeled_name_check_expr(v, tbl, shadows, errors, pre_desugar)\n      labeled_name_check_expr(k, tbl, shadows, errors, pre_desugar)\n    },\n    ESeq(a, b) => {\n      labeled_name_check_expr(a, tbl, shadows, errors, pre_desugar)\n      labeled_name_check_expr(b, tbl, shadows, errors, pre_desugar)\n    },\n    EMatch(scrut, arms) => {\n      labeled_name_check_expr(scrut, tbl, shadows, errors, pre_desugar)\n      let mut i = 0\n      while i < Array::length(arms) {\n        let (ap, ab) = Array::get(arms, i)\n        let mark = Array::length(shadows)\n        labeled_walk_pat_binds(ap, shadows)\n        labeled_name_check_expr(ab, tbl, shadows, errors, pre_desugar)\n        Array::truncate(shadows, mark)\n        i = i + 1\n      }\n    },\n    EHandle(scrut, arms) => {\n      labeled_name_check_expr(scrut, tbl, shadows, errors, pre_desugar)\n      let mut i = 0\n      while i < Array::length(arms) {\n        let (ap, ab) = Array::get(arms, i)\n        let mark = Array::length(shadows)\n        labeled_walk_pat_binds(ap, shadows)\n        labeled_name_check_expr(ab, tbl, shadows, errors, pre_desugar)\n        Array::truncate(shadows, mark)\n        i = i + 1\n      }\n    },\n    EWhile(cnd, body) => {\n      labeled_name_check_expr(cnd, tbl, shadows, errors, pre_desugar)\n      labeled_name_check_expr(body, tbl, shadows, errors, pre_desugar)\n    },\n    ELoop(inits, body) => {\n      let mut i = 0\n      while i < Array::length(inits) {\n        let (_, iv) = Array::get(inits, i)\n        labeled_name_check_expr(iv, tbl, shadows, errors, pre_desugar)\n        i = i + 1\n      }\n      let mark = Array::length(shadows)\n      let mut pi = 0\n      while pi < Array::length(inits) {\n        let (pname, _) = Array::get(inits, pi)\n        Array::push(shadows, pname)\n        pi = pi + 1\n      }\n      labeled_name_check_expr(body, tbl, shadows, errors, pre_desugar)\n      Array::truncate(shadows, mark)\n    },\n    EForIn(name, idx, iter, body) => {\n      labeled_name_check_expr(iter, tbl, shadows, errors, pre_desugar)\n      let mark = Array::length(shadows)\n      Array::push(shadows, name)\n      match idx {\n        Some(ix) => Array::push(shadows, ix),\n        None => ()\n      }\n      labeled_name_check_expr(body, tbl, shadows, errors, pre_desugar)\n      Array::truncate(shadows, mark)\n    },\n    EFn(_, _, fparams, _, _, body) => {\n      let mark = Array::length(shadows)\n      let mut pi = 0\n      while pi < Array::length(fparams) {\n        let (pn, _) = Array::get(fparams, pi)\n        Array::push(shadows, labeled_param_base_name(pn))\n        pi = pi + 1\n      }\n      labeled_name_check_expr(body, tbl, shadows, errors, pre_desugar)\n      Array::truncate(shadows, mark)\n    },\n    EDot(obj, _, _, _) => labeled_name_check_expr(obj, tbl, shadows, errors, pre_desugar),\n    EReturn(inner) => labeled_name_check_expr(inner, tbl, shadows, errors, pre_desugar),\n    EBreak(opt) => match opt {\n      Some(inner) => labeled_name_check_expr(inner, tbl, shadows, errors, pre_desugar),\n      None => ()\n    },\n    EContinue(exprs) => {\n      let mut i = 0\n      while i < Array::length(exprs) {\n        labeled_name_check_expr(Array::get(exprs, i), tbl, shadows, errors, pre_desugar)\n        i = i + 1\n      }\n    },\n    _ => ()\n  }\n}\n\nfn labeled_name_check_stmt(stmt: Stmt, tbl: Array[(String, Array[String])], errors: Array[String], pre_desugar: Bool) -> Unit {\n  match stmt {\n    SLet(_, _, _, _, body) => labeled_name_check_expr(body, tbl, array_empty(), errors, pre_desugar),\n    SLetMut(_, _, body) => labeled_name_check_expr(body, tbl, array_empty(), errors, pre_desugar),\n    STest(_, body) => labeled_name_check_expr(body, tbl, array_empty(), errors, pre_desugar),\n    SBench(_, body) => labeled_name_check_expr(body, tbl, array_empty(), errors, pre_desugar),\n    SExpr(e) => labeled_name_check_expr(e, tbl, array_empty(), errors, pre_desugar),\n    SLetPat(_, e) => labeled_name_check_expr(e, tbl, array_empty(), errors, pre_desugar),\n    SModule(_, _, ms) => {\n      let mut i = 0\n      while i < Array::length(ms) {\n        labeled_name_check_stmt(Array::get(ms, i), tbl, errors, pre_desugar)\n        i = i + 1\n      }\n    },\n    _ => ()\n  }\n}\n\nfn check_labeled_arg_names_stmts(stmts: Array[Stmt], errors: Array[String], pre_desugar: Bool) -> Unit {\n  let tbl = collect_labeled_check_fns(stmts)\n  if Array::length(tbl) == 0 {\n    ()\n  } else {\n    let mut i = 0\n    while i < Array::length(stmts) {\n      labeled_name_check_stmt(Array::get(stmts, i), tbl, errors, pre_desugar)\n      i = i + 1\n    }\n  }\n}\n\nexport fn check_stmts(raw_stmts: Array[Stmt], i: Int, env: TypeEnv, defs: Array[TypeDef], s: Subst, c: Int, errors: Array[String], tytab: Array[(Int, Type)]) -> (TypeEnv, Subst, Int) {\n  let ignored_type_def_binders = array_empty()\n  check_stmts_with_binders(raw_stmts, i, env, defs, ignored_type_def_binders, s, c, errors, tytab)\n}\n\nfn check_program_type_defs_observation_impl(stmts: Array[Stmt]) -> CheckedProgramTypeDefsObservation with { Error } {\n  inject_prelude_result(stmts)\n  inject_trait_method_generics(stmts)\n  desugar_railway_binds(stmts)\n  let errors = ArrayBuilder::new()\n  let frozen_errors = ArrayBuilder::freeze(errors)\n  check_labeled_arg_names_stmts(stmts, frozen_errors, true)\n  desugar_labeled_args(stmts)\n  let empty_defs = array_empty()\n  let type_def_binders = array_empty()\n  let seeded_raw_env = if trait_defined(EnvEmpty, \"Eq\") {\n    EnvEmpty\n  } else {\n    register_builtin_traits(EnvEmpty)\n  }\n  let seeded_env = env_cache(seeded_raw_env)\n  let tytab = array_empty()\n  check_labeled_arg_names_stmts(stmts, frozen_errors, false)\n  let expanded_stmts = {\n    let (top_es_names, top_es_members_list, _, _) = es_collect_tables(stmts, 0)\n    es_expand_stmts_effect_rows(stmts, top_es_names, top_es_members_list)\n  }\n  let (env, final_s, _) = check_stmts_with_binders(expanded_stmts, 0, seeded_env, empty_defs, type_def_binders, SubstEmpty, 0, frozen_errors, tytab)\n  check_program_bounds(env, final_s, empty_defs, frozen_errors)\n  collect_async_effect_errors(expanded_stmts, env, frozen_errors)\n  let spawnable_mut_errors = check_spawnable_mut_captures_stmts(stmts)\n  let mut smi = 0\n  while smi < Array::length(spawnable_mut_errors) {\n    Array::push(frozen_errors, Array::get(spawnable_mut_errors, smi))\n    smi = smi + 1\n  }\n  if Array::length(frozen_errors) > 0 {\n    throw(Array::get(frozen_errors, 0))\n  }\n  CheckedProgramTypeDefsObservation::{\n    checked_program: CheckedProgram::{\n      checked_stmts: stmts,\n      final_env: env,\n      type_defs: empty_defs,\n      final_subst: final_s,\n      typed_occurrences: tytab\n    },\n    type_def_binders: type_def_binders\n  }\n}\n\nexport fn check_program_type_defs_observation(stmts: Array[Stmt]) -> CheckedProgramTypeDefsObservation with { Error } {\n  check_program_type_defs_observation_impl(stmts)\n}\n\nexport fn check_program_result(stmts: Array[Stmt]) -> CheckedProgram with { Error } {\n  check_program_type_defs_observation_impl(stmts).checked_program\n}\n\nexport fn check_program(stmts: Array[Stmt]) -> TypeEnv with { Error } {\n  check_program_result(stmts).final_env\n}\n\nexport fn check_program_type_table(stmts: Array[Stmt]) -> (Array[(Int, Type)], Subst) with { Error } {\n  let empty_defs = array_empty()\n  let seeded_raw_env = if trait_defined(EnvEmpty, \"Eq\") {\n    EnvEmpty\n  } else {\n    register_builtin_traits(EnvEmpty)\n  }\n  let seeded_env = env_cache(seeded_raw_env)\n  let errors = ArrayBuilder::new()\n  let frozen_errors = ArrayBuilder::freeze(errors)\n  let tytab = array_empty()\n  handle {\n    let (_, final_s, _) = check_stmts(stmts, 0, seeded_env, empty_defs, SubstEmpty, 0, frozen_errors, tytab)\n    (tytab, final_s)\n  } with Error {\n    Throw(_) => (tytab, SubstEmpty)\n  }\n}\n\nfn check_program_with_env_type_defs_observation_impl(stmts: Array[Stmt], initial_env: TypeEnv) -> CheckedProgramTypeDefsObservation with { Error } {\n  match initial_env {\n    EnvEmpty => check_program_type_defs_observation_impl(stmts),\n    _ => {\n      inject_prelude_result(stmts)\n      inject_trait_method_generics(stmts)\n      desugar_railway_binds(stmts)\n      let errors = ArrayBuilder::new()\n      let frozen_errors = ArrayBuilder::freeze(errors)\n      check_labeled_arg_names_stmts(stmts, frozen_errors, true)\n      desugar_labeled_args(stmts)\n      let empty_defs = array_empty()\n      let type_def_binders = array_empty()\n      let cached_env = env_cache(initial_env)\n      let seeded_raw_env = if trait_defined(cached_env, \"Eq\") {\n        cached_env\n      } else {\n        register_builtin_traits(cached_env)\n      }\n      let seeded_env = env_cache(seeded_raw_env)\n      let tytab = array_empty()\n      check_labeled_arg_names_stmts(stmts, frozen_errors, false)\n      let (env, final_s, _) = check_stmts_with_binders(stmts, 0, seeded_env, empty_defs, type_def_binders, SubstEmpty, 0, frozen_errors, tytab)\n      check_program_bounds_impl(env, final_s, empty_defs, frozen_errors, true)\n      collect_async_effect_errors(stmts, env, frozen_errors)\n      let spawnable_mut_errors = check_spawnable_mut_captures_stmts(stmts)\n      let mut smi = 0\n      while smi < Array::length(spawnable_mut_errors) {\n        Array::push(frozen_errors, Array::get(spawnable_mut_errors, smi))\n        smi = smi + 1\n      }\n      if Array::length(frozen_errors) > 0 {\n        throw(Array::get(frozen_errors, 0))\n      }\n      CheckedProgramTypeDefsObservation::{\n        checked_program: CheckedProgram::{\n          checked_stmts: stmts,\n          final_env: env,\n          type_defs: empty_defs,\n          final_subst: final_s,\n          typed_occurrences: tytab\n        },\n        type_def_binders: type_def_binders\n      }\n    }\n  }\n}\n\nexport fn check_program_with_env_type_defs_observation(stmts: Array[Stmt], initial_env: TypeEnv) -> CheckedProgramTypeDefsObservation with { Error } {\n  check_program_with_env_type_defs_observation_impl(stmts, initial_env)\n}\n\nexport fn check_program_with_env_result(stmts: Array[Stmt], initial_env: TypeEnv) -> CheckedProgram with { Error } {\n  check_program_with_env_type_defs_observation_impl(stmts, initial_env).checked_program\n}\n\nexport fn check_program_with_env(stmts: Array[Stmt], initial_env: TypeEnv) -> TypeEnv with { Error } {\n  check_program_with_env_result(stmts, initial_env).final_env\n}\n\n\nfn warning_names_contains(arr: Array[String], s: String) -> Bool {\n  let len = Array::length(arr)\n  let mut i = 0\n  let mut found = false\n  while i < len {\n    if Array::get(arr, i) == s {\n      found = true\n      i = len\n    } else {\n      i = i + 1\n    }\n  }\n  found\n}\n\nfn push_ref_name(out: Array[String], name: String) -> Unit {\n  if warning_names_contains(out, name) {\n    ()\n  } else {\n    Array::push(out, name)\n  }\n}\n\nfn collect_texpr_ref_names(te: TypeExpr, out: Array[String]) -> Unit {\n  match te {\n    TyName(name) => push_ref_name(out, name),\n    TyApp(name, args) => {\n      push_ref_name(out, name)\n      let mut i = 0\n      while i < Array::length(args) {\n        collect_texpr_ref_names(Array::get(args, i), out)\n        i = i + 1\n      }\n    },\n    TyFn(params, ret, _) => {\n      let mut i = 0\n      while i < Array::length(params) {\n        collect_texpr_ref_names(Array::get(params, i), out)\n        i = i + 1\n      }\n      collect_texpr_ref_names(ret, out)\n    },\n    TyTuple(items) => {\n      let mut i = 0\n      while i < Array::length(items) {\n        collect_texpr_ref_names(Array::get(items, i), out)\n        i = i + 1\n      }\n    },\n    TyUnit => ()\n  }\n}\n\nfn collect_opt_texpr_ref_names(ty: Option[TypeExpr], out: Array[String]) -> Unit {\n  match ty {\n    Some(te) => collect_texpr_ref_names(te, out),\n    None => ()\n  }\n}\n\nfn collect_referenced_names_expr(expr: Expr, bound: Array[String], out: Array[String]) -> Unit {\n  match expr {\n    EIdent(name, _) => if labeled_walk_shadowed(bound, name) {\n      ()\n    } else {\n      push_ref_name(out, name)\n    },\n    EInt(_) => (),\n    EFloat(_) => (),\n    EString(_) => (),\n    EBool(_) => (),\n    EUnit => (),\n    EBreak(opt) => match opt {\n      Some(e) => collect_referenced_names_expr(e, bound, out),\n      None => ()\n    },\n    EContinue(items) => {\n      let mut i = 0\n      while i < Array::length(items) {\n        collect_referenced_names_expr(Array::get(items, i), bound, out)\n        i = i + 1\n      }\n    },\n    EReturn(e) => collect_referenced_names_expr(e, bound, out),\n    EUnaryOp(_, e) => collect_referenced_names_expr(e, bound, out),\n    ETuple(items) => {\n      let mut i = 0\n      while i < Array::length(items) {\n        collect_referenced_names_expr(Array::get(items, i), bound, out)\n        i = i + 1\n      }\n    },\n    EArray(items) => {\n      let mut i = 0\n      while i < Array::length(items) {\n        collect_referenced_names_expr(Array::get(items, i), bound, out)\n        i = i + 1\n      }\n    },\n    ERecord(name, fields, targs) => {\n      push_ref_name(out, name)\n      let mut i = 0\n      while i < Array::length(fields) {\n        let (_, val) = Array::get(fields, i)\n        collect_referenced_names_expr(val, bound, out)\n        i = i + 1\n      }\n      let mut ti = 0\n      while ti < Array::length(targs) {\n        collect_texpr_ref_names(Array::get(targs, ti), out)\n        ti = ti + 1\n      }\n    },\n    EBinOp(_, l, r) => {\n      collect_referenced_names_expr(l, bound, out)\n      collect_referenced_names_expr(r, bound, out)\n    },\n    ECall(callee, args, _) => {\n      collect_referenced_names_expr(callee, bound, out)\n      let mut i = 0\n      while i < Array::length(args) {\n        collect_referenced_names_expr(Array::get(args, i), bound, out)\n        i = i + 1\n      }\n    },\n    EIf(cond, then_e, else_e) => {\n      collect_referenced_names_expr(cond, bound, out)\n      collect_referenced_names_expr(then_e, bound, out)\n      collect_referenced_names_expr(else_e, bound, out)\n    },\n    ELet(name, val, body, _) => {\n      collect_referenced_names_expr(val, bound, out)\n      let mark = Array::length(bound)\n      Array::push(bound, name)\n      collect_referenced_names_expr(body, bound, out)\n      Array::truncate(bound, mark)\n    },\n    ELetRec(name, val, body) => {\n      let mark = Array::length(bound)\n      Array::push(bound, name)\n      collect_referenced_names_expr(val, bound, out)\n      collect_referenced_names_expr(body, bound, out)\n      Array::truncate(bound, mark)\n    },\n    ELetMut(name, val, body, _) => {\n      collect_referenced_names_expr(val, bound, out)\n      let mark = Array::length(bound)\n      Array::push(bound, name)\n      collect_referenced_names_expr(body, bound, out)\n      Array::truncate(bound, mark)\n    },\n    EAssign(_, val, body) => {\n      collect_referenced_names_expr(val, bound, out)\n      collect_referenced_names_expr(body, bound, out)\n    },\n    EAssignOp(_, _, val, body) => {\n      collect_referenced_names_expr(val, bound, out)\n      collect_referenced_names_expr(body, bound, out)\n    },\n    ESeq(l, r) => {\n      collect_referenced_names_expr(l, bound, out)\n      collect_referenced_names_expr(r, bound, out)\n    },\n    EMatch(scr, arms) => {\n      collect_referenced_names_expr(scr, bound, out)\n      let mut i = 0\n      while i < Array::length(arms) {\n        let (pat, body) = Array::get(arms, i)\n        let mark = Array::length(bound)\n        labeled_walk_pat_binds(pat, bound)\n        collect_referenced_names_expr(body, bound, out)\n        Array::truncate(bound, mark)\n        i = i + 1\n      }\n    },\n    EHandle(body_expr, arms) => {\n      collect_referenced_names_expr(body_expr, bound, out)\n      let mut i = 0\n      while i < Array::length(arms) {\n        let (pat, arm_body) = Array::get(arms, i)\n        let mark = Array::length(bound)\n        labeled_walk_pat_binds(pat, bound)\n        collect_referenced_names_expr(arm_body, bound, out)\n        Array::truncate(bound, mark)\n        i = i + 1\n      }\n    },\n    EWhile(cond, body) => {\n      collect_referenced_names_expr(cond, bound, out)\n      collect_referenced_names_expr(body, bound, out)\n    },\n    ELoop(params, body) => {\n      let mark = Array::length(bound)\n      let mut i = 0\n      while i < Array::length(params) {\n        let (_, init) = Array::get(params, i)\n        collect_referenced_names_expr(init, bound, out)\n        i = i + 1\n      }\n      let mut j = 0\n      while j < Array::length(params) {\n        let (pname, _) = Array::get(params, j)\n        Array::push(bound, pname)\n        j = j + 1\n      }\n      collect_referenced_names_expr(body, bound, out)\n      Array::truncate(bound, mark)\n    },\n    EForIn(name, idx_opt, iter, body) => {\n      collect_referenced_names_expr(iter, bound, out)\n      let mark = Array::length(bound)\n      Array::push(bound, name)\n      match idx_opt {\n        Some(idx) => Array::push(bound, idx),\n        None => ()\n      }\n      collect_referenced_names_expr(body, bound, out)\n      Array::truncate(bound, mark)\n    },\n    EFn(_, _, params, ret, _, body) => {\n      let mark = Array::length(bound)\n      let mut i = 0\n      while i < Array::length(params) {\n        let (pname, pty) = Array::get(params, i)\n        collect_opt_texpr_ref_names(pty, out)\n        Array::push(bound, labeled_param_base_name(pname))\n        i = i + 1\n      }\n      collect_opt_texpr_ref_names(ret, out)\n      collect_referenced_names_expr(body, bound, out)\n      Array::truncate(bound, mark)\n    },\n    EDot(obj, _, _, _) => collect_referenced_names_expr(obj, bound, out),\n    ELabeledArg(_, _, e) => collect_referenced_names_expr(e, bound, out),\n    EMap(fields) => {\n      let mut i = 0\n      while i < Array::length(fields) {\n        let (_, val) = Array::get(fields, i)\n        collect_referenced_names_expr(val, bound, out)\n        i = i + 1\n      }\n    },\n    ESpread(e) => collect_referenced_names_expr(e, bound, out),\n    EStringInterp(_) => ()\n  }\n}\n\nfn collect_referenced_names_expr_top(expr: Expr, out: Array[String]) -> Unit {\n  collect_referenced_names_expr(expr, array_empty(), out)\n}\n\nfn collect_referenced_names_stmts(stmts: Array[Stmt], out: Array[String]) -> Unit {\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SLet(_, _, _, ann, val) => {\n        collect_opt_texpr_ref_names(ann, out)\n        collect_referenced_names_expr_top(val, out)\n      },\n      SLetMut(_, ann, val) => {\n        collect_opt_texpr_ref_names(ann, out)\n        collect_referenced_names_expr_top(val, out)\n      },\n      SLetPat(_, val) => collect_referenced_names_expr_top(val, out),\n      SEnum(_, _, _, variants, _) => {\n        let mut vi = 0\n        while vi < Array::length(variants) {\n          let (_, vtypes) = Array::get(variants, vi)\n          let mut ti = 0\n          while ti < Array::length(vtypes) {\n            collect_texpr_ref_names(Array::get(vtypes, ti), out)\n            ti = ti + 1\n          }\n          vi = vi + 1\n        }\n      },\n      SSuberror(_, _, variants) => {\n        let mut vi = 0\n        while vi < Array::length(variants) {\n          let (_, vtypes) = Array::get(variants, vi)\n          let mut ti = 0\n          while ti < Array::length(vtypes) {\n            collect_texpr_ref_names(Array::get(vtypes, ti), out)\n            ti = ti + 1\n          }\n          vi = vi + 1\n        }\n      },\n      SStruct(_, _, fields, _, _, _) => {\n        let mut fi = 0\n        while fi < Array::length(fields) {\n          let (_, fty) = Array::get(fields, fi)\n          collect_texpr_ref_names(fty, out)\n          fi = fi + 1\n        }\n      },\n      STypeAlias(_, _, _, te) => collect_texpr_ref_names(te, out),\n      STrait(_, _, _, methods, _, _) => {\n        let mut mi = 0\n        while mi < Array::length(methods) {\n          let (_, ptypes, rty) = Array::get(methods, mi)\n          let mut pi = 0\n          while pi < Array::length(ptypes) {\n            collect_texpr_ref_names(Array::get(ptypes, pi), out)\n            pi = pi + 1\n          }\n          collect_texpr_ref_names(rty, out)\n          mi = mi + 1\n        }\n      },\n      SExternLet(_, te) => collect_texpr_ref_names(te, out),\n      SEffectDef(_, _, _, ops) => {\n        let mut oi = 0\n        while oi < Array::length(ops) {\n          let (_, ptypes, rty) = Array::get(ops, oi)\n          let mut pi = 0\n          while pi < Array::length(ptypes) {\n            collect_texpr_ref_names(Array::get(ptypes, pi), out)\n            pi = pi + 1\n          }\n          collect_texpr_ref_names(rty, out)\n          oi = oi + 1\n        }\n      },\n      STest(_, val) => collect_referenced_names_expr_top(val, out),\n      SBench(_, val) => collect_referenced_names_expr_top(val, out),\n      SExpr(val) => collect_referenced_names_expr_top(val, out),\n      SModule(_, _, body) => collect_referenced_names_stmts(body, out),\n      _ => ()\n    }\n    i = i + 1\n  }\n}\n\nfn unused_alias_referenced(used: Array[String], bare: String, qualified_prefix: String) -> Bool {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(used) {\n    let name = Array::get(used, i)\n    if name == bare || String::starts_with(name, qualified_prefix) {\n      found = true\n      i = Array::length(used)\n    } else {\n      i = i + 1\n    }\n  }\n  found\n}\n\nexport fn detect_unused_imports(stmts: Array[Stmt]) -> Array[(String, String, String)] {\n  let used = array_empty()\n  collect_referenced_names_stmts(stmts, used)\n  let out = array_empty()\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SImport(path, items) => {\n        let mut j = 0\n        while j < Array::length(items) {\n          let (orig, alias) = Array::get(items, j)\n          let local = match alias {\n            Some(a) => a,\n            None => orig\n          }\n          if warning_names_contains(used, local) {\n            ()\n          } else {\n            let msg = String::concat(\"imported name '\", String::concat(local, String::concat(\"' from '\", String::concat(path, \"' is never used in this file\"))))\n            Array::push(out, (\"unused_import\", local, msg))\n          }\n          j = j + 1\n        }\n      },\n      SAliasDecl(alias, path) => {\n        let qualified_prefix = String::concat(\"@\", String::concat(alias, \"::\"))\n        let bare = String::concat(\"@\", alias)\n        if unused_alias_referenced(used, bare, qualified_prefix) {\n          ()\n        } else {\n          let msg = String::concat(\"import alias '\", String::concat(bare, String::concat(\"' for '\", String::concat(path, \"' is never used in this file (referenced elsewhere in a whole-program merge? consider a named import instead)\"))))\n          Array::push(out, (\"unused_import\", alias, msg))\n        }\n      },\n      _ => ()\n    }\n    i = i + 1\n  }\n  out\n}\n\nfn collect_discard_call_offsets_expr(expr: Expr, out: Array[Int]) -> Unit {\n  match expr {\n    ESeq(left, right) => {\n      match left {\n        ECall(_, _, call_off) => if call_off >= 0 {\n          Array::push(out, call_off)\n        } else {\n          ()\n        },\n        _ => ()\n      }\n      collect_discard_call_offsets_expr(left, out)\n      collect_discard_call_offsets_expr(right, out)\n    },\n    EIf(cond, then_e, else_e) => {\n      collect_discard_call_offsets_expr(cond, out)\n      collect_discard_call_offsets_expr(then_e, out)\n      collect_discard_call_offsets_expr(else_e, out)\n    },\n    ELet(_, val, body, _) => {\n      collect_discard_call_offsets_expr(val, out)\n      collect_discard_call_offsets_expr(body, out)\n    },\n    ELetRec(_, val, body) => {\n      collect_discard_call_offsets_expr(val, out)\n      collect_discard_call_offsets_expr(body, out)\n    },\n    ELetMut(_, val, body, _) => {\n      collect_discard_call_offsets_expr(val, out)\n      collect_discard_call_offsets_expr(body, out)\n    },\n    EAssign(_, val, body) => {\n      collect_discard_call_offsets_expr(val, out)\n      collect_discard_call_offsets_expr(body, out)\n    },\n    EAssignOp(_, _, val, body) => {\n      collect_discard_call_offsets_expr(val, out)\n      collect_discard_call_offsets_expr(body, out)\n    },\n    EMatch(scr, arms) => {\n      collect_discard_call_offsets_expr(scr, out)\n      let mut i = 0\n      while i < Array::length(arms) {\n        let (_, body) = Array::get(arms, i)\n        collect_discard_call_offsets_expr(body, out)\n        i = i + 1\n      }\n    },\n    EHandle(body_expr, arms) => {\n      collect_discard_call_offsets_expr(body_expr, out)\n      let mut i = 0\n      while i < Array::length(arms) {\n        let (_, arm_body) = Array::get(arms, i)\n        collect_discard_call_offsets_expr(arm_body, out)\n        i = i + 1\n      }\n    },\n    EWhile(cond, body) => {\n      collect_discard_call_offsets_expr(cond, out)\n      collect_discard_call_offsets_expr(body, out)\n    },\n    ELoop(params, body) => {\n      let mut i = 0\n      while i < Array::length(params) {\n        let (_, init) = Array::get(params, i)\n        collect_discard_call_offsets_expr(init, out)\n        i = i + 1\n      }\n      collect_discard_call_offsets_expr(body, out)\n    },\n    EForIn(_, _, iter, body) => {\n      collect_discard_call_offsets_expr(iter, out)\n      collect_discard_call_offsets_expr(body, out)\n    },\n    ECall(callee, args, _) => {\n      collect_discard_call_offsets_expr(callee, out)\n      let mut i = 0\n      while i < Array::length(args) {\n        collect_discard_call_offsets_expr(Array::get(args, i), out)\n        i = i + 1\n      }\n    },\n    EBinOp(_, l, r) => {\n      collect_discard_call_offsets_expr(l, out)\n      collect_discard_call_offsets_expr(r, out)\n    },\n    EUnaryOp(_, e) => collect_discard_call_offsets_expr(e, out),\n    ETuple(items) => {\n      let mut i = 0\n      while i < Array::length(items) {\n        collect_discard_call_offsets_expr(Array::get(items, i), out)\n        i = i + 1\n      }\n    },\n    EArray(items) => {\n      let mut i = 0\n      while i < Array::length(items) {\n        collect_discard_call_offsets_expr(Array::get(items, i), out)\n        i = i + 1\n      }\n    },\n    ERecord(_, fields, _) => {\n      let mut i = 0\n      while i < Array::length(fields) {\n        let (_, val) = Array::get(fields, i)\n        collect_discard_call_offsets_expr(val, out)\n        i = i + 1\n      }\n    },\n    EFn(_, _, _, _, _, body) => collect_discard_call_offsets_expr(body, out),\n    EDot(obj, _, _, _) => collect_discard_call_offsets_expr(obj, out),\n    ELabeledArg(_, _, e) => collect_discard_call_offsets_expr(e, out),\n    EMap(fields) => {\n      let mut i = 0\n      while i < Array::length(fields) {\n        let (_, val) = Array::get(fields, i)\n        collect_discard_call_offsets_expr(val, out)\n        i = i + 1\n      }\n    },\n    ESpread(e) => collect_discard_call_offsets_expr(e, out),\n    EReturn(e) => collect_discard_call_offsets_expr(e, out),\n    EBreak(opt) => match opt {\n      Some(e) => collect_discard_call_offsets_expr(e, out),\n      None => ()\n    },\n    EContinue(items) => {\n      let mut i = 0\n      while i < Array::length(items) {\n        collect_discard_call_offsets_expr(Array::get(items, i), out)\n        i = i + 1\n      }\n    },\n    _ => ()\n  }\n}\n\nfn collect_discard_call_offsets_stmts(stmts: Array[Stmt], out: Array[Int]) -> Unit {\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SLet(_, _, _, _, val) => collect_discard_call_offsets_expr(val, out),\n      SLetMut(_, _, val) => collect_discard_call_offsets_expr(val, out),\n      SLetPat(_, val) => collect_discard_call_offsets_expr(val, out),\n      STest(_, val) => collect_discard_call_offsets_expr(val, out),\n      SBench(_, val) => collect_discard_call_offsets_expr(val, out),\n      SExpr(val) => collect_discard_call_offsets_expr(val, out),\n      SModule(_, _, body) => collect_discard_call_offsets_stmts(body, out),\n      _ => ()\n    }\n    i = i + 1\n  }\n}\n\nfn lookup_tytab_offset(tytab: Array[(Int, Type)], off: Int) -> Option[Type] {\n  let mut i = 0\n  let mut found = None\n  while i < Array::length(tytab) {\n    let (o, t) = Array::get(tytab, i)\n    if o == off {\n      found = Some(t)\n      i = Array::length(tytab)\n    } else {\n      i = i + 1\n    }\n  }\n  found\n}\n\nfn discard_type_worth_warning(ty: Type) -> Bool {\n  match ty {\n    CtUnit => false,\n    CtUnknown => false,\n    CtVar(_) => false,\n    _ => true\n  }\n}\n\nexport fn detect_unbound_nonunit_returns(stmts: Array[Stmt], tytab: Array[(Int, Type)], final_s: Subst) -> Array[String] {\n  let offsets = array_empty()\n  collect_discard_call_offsets_stmts(stmts, offsets)\n  let out = array_empty()\n  let mut i = 0\n  while i < Array::length(offsets) {\n    let off = Array::get(offsets, i)\n    match lookup_tytab_offset(tytab, off) {\n      Some(ty) => {\n        let resolved = subst_apply(final_s, ty)\n        if discard_type_worth_warning(resolved) {\n          let marker = labeled_name_marker(off, 0)\n          Array::push(out, String::concat(\"expression result of type `\", String::concat(type_to_string(resolved), String::concat(\"` is unused -- bind it (e.g. `let _ = ...`) if this is intentional\", marker))))\n        } else {\n          ()\n        }\n      },\n      None => ()\n    }\n    i = i + 1\n  }\n  out\n}\n\n")
}

let source_59 = () -> (String, String) {
  ("lib/@vibe/compiler/checker/canonical_checked_type_state.vibe",
"\nimport @vibe/compiler/core {\n  Subst, Type, TypeDef, TypeEnv, __to_string, canonical_exception_effect_name, str_lt, subst_lookup\n}\n\nimport @vibe/core {\n  array_empty\n}\n\n\nfn canonical_piece(text: String) -> String {\n  String::concat(__to_string(String::length(text)), String::concat(\":\", text))\n}\n\nfn canonical_node(tag: String, fields: Array[String]) -> String {\n  let mut out = String::concat(tag, __to_string(Array::length(fields)))\n  let mut i = 0\n  while i < Array::length(fields) {\n    out = String::concat(out, canonical_piece(Array::get(fields, i)))\n    i = i + 1\n  }\n  out\n}\n\nfn int_in(items: Array[Int], id: Int) -> Bool {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(items) && !found {\n    if Array::get(items, i) == id {\n      found = true\n    } else {\n      i = i + 1\n    }\n  }\n  found\n}\n\nfn int_index(items: Array[Int], id: Int) -> Int {\n  let mut i = 0\n  let mut out = -1\n  while i < Array::length(items) && out < 0 {\n    if Array::get(items, i) == id {\n      out = i\n    } else {\n      i = i + 1\n    }\n  }\n  out\n}\n\nfn string_in(items: Array[String], item: String) -> Bool {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(items) && !found {\n    if Array::get(items, i) == item {\n      found = true\n    } else {\n      i = i + 1\n    }\n  }\n  found\n}\n\nfn sorted_unique_strings(items: Array[String]) -> Array[String] {\n  let out = array_empty()\n  let mut i = 0\n  while i < Array::length(items) {\n    let item = Array::get(items, i)\n    if !string_in(out, item) {\n      let mut at = Array::length(out)\n      let mut j = 0\n      while j < Array::length(out) && at == Array::length(out) {\n        if str_lt(item, Array::get(out, j)) {\n          at = j\n        } else {\n          j = j + 1\n        }\n      }\n      Array::push(out, item)\n      let mut k = Array::length(out) - 1\n      while k > at {\n        Array::set(out, k, Array::get(out, k - 1))\n        k = k - 1\n      }\n      Array::set(out, at, item)\n    }\n    i = i + 1\n  }\n  out\n}\n\n\nfn canonical_effect_labels(text: String) -> Array[String] {\n  let raw = array_empty()\n  let mut start = 0\n  let mut depth = 0\n  let mut i = 0\n  while i < String::length(text) {\n    let c = String::char_code_at(text, i)\n    if c == 91 || c == 40 || c == 123 {\n      depth = depth + 1\n    } else if (c == 93 || c == 41 || c == 125) && depth > 0 {\n      depth = depth - 1\n    } else if c == 44 && depth == 0 {\n      let label = String::trim(String::substring(text, start, i))\n      if String::length(label) > 0 {\n        Array::push(raw, canonical_exception_effect_name(label))\n      }\n      start = i + 1\n    }\n    i = i + 1\n  }\n  let last = String::trim(String::substring(text, start, String::length(text)))\n  if String::length(last) > 0 {\n    Array::push(raw, canonical_exception_effect_name(last))\n  }\n  sorted_unique_strings(raw)\n}\n\nfn canonical_is_effect_var(name: String) -> Bool {\n  let len = String::length(name)\n  if len == 1 {\n    String::char_code_at(name, 0) >= 97 && String::char_code_at(name, 0) <= 122\n  } else if len >= 2 {\n    String::char_code_at(name, 0) == 36\n  } else {\n    false\n  }\n}\n\nfn canonical_effect_lookup(s: Subst, name: String, seen: Array[String]) -> Option[String] {\n  if string_in(seen, name) {\n    Some(name)\n  } else {\n    let next_seen = Array::slice(seen, 0, Array::length(seen))\n    Array::push(next_seen, name)\n    let mut cur = s\n    let mut found = None\n    let mut done = false\n    while !done {\n      match cur {\n        SubstEmpty => {\n          done = true\n        },\n        SubstBind(_, _, rest) => {\n          cur = rest\n        },\n        SubstBound(_, _, rest) => {\n          cur = rest\n        },\n        SubstCached(_, _, rest) => {\n          cur = rest\n        },\n        SubstEffBind(v, value, rest) => if v == name {\n          found = Some(value)\n          done = true\n        } else {\n          cur = rest\n        }\n      }\n    }\n    match found {\n      Some(value) => if canonical_is_effect_var(value) {\n        canonical_effect_lookup(s, value, next_seen)\n      } else {\n        Some(value)\n      },\n      None => None\n    }\n  }\n}\n\nfn canonical_effect(s: Subst, effect: Option[String]) -> String {\n  match effect {\n    None => canonical_node(\"EP\", array_empty()),\n    Some(name) => {\n      let resolved = if canonical_is_effect_var(name) {\n        canonical_effect_lookup(s, name, array_empty())\n      } else {\n        Some(name)\n      }\n      match resolved {\n        Some(text) => if String::length(text) == 0 {\n          canonical_node(\"EP\", array_empty())\n        } else {\n          canonical_node(\"ER\", canonical_effect_labels(text))\n        },\n        None => canonical_node(\"EV\", [\n          name\n        ])\n      }\n    }\n  }\n}\n\n\nfn canonical_free_var(id: Int, free_ids: Array[Int], free_names: Array[String]) -> String {\n  let found = int_index(free_ids, id)\n  if found >= 0 {\n    Array::get(free_names, found)\n  } else {\n    let name = String::concat(\"f\", __to_string(Array::length(free_ids)))\n    Array::push(free_ids, id)\n    Array::push(free_names, name)\n    name\n  }\n}\n\nfn canonical_bounds_for(vars: Array[Int], rows: Array[(Int, Array[String])], id: Int) -> String {\n  let labels = array_empty()\n  let mut i = 0\n  while i < Array::length(rows) {\n    let (row_id, row_labels) = Array::get(rows, i)\n    if row_id == id {\n      let mut j = 0\n      while j < Array::length(row_labels) {\n        Array::push(labels, Array::get(row_labels, j))\n        j = j + 1\n      }\n    }\n    i = i + 1\n  }\n  canonical_node(\"B\", sorted_unique_strings(labels))\n}\n\nfn canonical_named_bound(names: Array[String], name: String) -> Int {\n  let mut i = 0\n  let mut found = -1\n  while i < Array::length(names) && found < 0 {\n    if Array::get(names, i) == name {\n      found = i\n    } else {\n      i = i + 1\n    }\n  }\n  found\n}\n\nfn canonical_type(ty: Type, s: Subst, bound_ids: Array[Int], bound_names: Array[String], free_ids: Array[Int], free_names: Array[String], resolving: Array[Int]) -> String {\n  match ty {\n    CtInt => canonical_node(\"I\", array_empty()),\n    CtDouble => canonical_node(\"D\", array_empty()),\n    CtBool => canonical_node(\"Z\", array_empty()),\n    CtString => canonical_node(\"S\", array_empty()),\n    CtChar => canonical_node(\"C\", array_empty()),\n    CtUnit => canonical_node(\"U\", array_empty()),\n    CtBytes => canonical_node(\"Y\", array_empty()),\n    CtUnknown => canonical_node(\"X\", array_empty()),\n    CtVar(id) => {\n      let bound_at = int_index(bound_ids, id)\n      if bound_at >= 0 {\n        canonical_node(\"Q\", [\n          __to_string(bound_at)\n        ])\n      } else if int_in(resolving, id) {\n        canonical_node(\"V\", [\n          canonical_free_var(id, free_ids, free_names)\n        ])\n      } else {\n        match subst_lookup(s, id) {\n          Some(next) => {\n            let next_resolving = Array::slice(resolving, 0, Array::length(resolving))\n            Array::push(next_resolving, id)\n            canonical_type(next, s, bound_ids, bound_names, free_ids, free_names, next_resolving)\n          },\n          None => canonical_node(\"V\", [\n            canonical_free_var(id, free_ids, free_names)\n          ])\n        }\n      }\n    },\n    CtTuple(items) => {\n      let fields = array_empty()\n      let mut i = 0\n      while i < Array::length(items) {\n        Array::push(fields, canonical_type(Array::get(items, i), s, bound_ids, bound_names, free_ids, free_names, resolving))\n        i = i + 1\n      }\n      canonical_node(\"T\", fields)\n    },\n    CtArray(item) => canonical_node(\"A\", [\n      canonical_type(item, s, bound_ids, bound_names, free_ids, free_names, resolving)\n    ]),\n    CtOption(item) => canonical_node(\"O\", [\n      canonical_type(item, s, bound_ids, bound_names, free_ids, free_names, resolving)\n    ]),\n    CtEnum(name) => canonical_node(\"N\", [\n      name\n    ]),\n    CtStruct(name) => canonical_node(\"R\", [\n      name\n    ]),\n    CtNamed(name, args) => {\n      let bound_at = if Array::length(args) == 0 {\n        canonical_named_bound(bound_names, name)\n      } else {\n        -1\n      }\n      if bound_at >= 0 {\n        canonical_node(\"Q\", [\n          __to_string(bound_at)\n        ])\n      } else {\n        let fields = [\n          name\n        ]\n        let mut i = 0\n        while i < Array::length(args) {\n          Array::push(fields, canonical_type(Array::get(args, i), s, bound_ids, bound_names, free_ids, free_names, resolving))\n          i = i + 1\n        }\n        canonical_node(\"M\", fields)\n      }\n    },\n    CtFn(params, ret, effect) => {\n      let fields = array_empty()\n      let mut i = 0\n      while i < Array::length(params) {\n        Array::push(fields, canonical_type(Array::get(params, i), s, bound_ids, bound_names, free_ids, free_names, resolving))\n        i = i + 1\n      }\n      Array::push(fields, canonical_type(ret, s, bound_ids, bound_names, free_ids, free_names, resolving))\n      Array::push(fields, canonical_effect_with_params(s, effect, bound_names))\n      canonical_node(\"F\", fields)\n    },\n    CtForAll(vars, rows, body) => {\n      let nested_bound = Array::slice(vars, 0, Array::length(vars))\n      let mut i = 0\n      while i < Array::length(bound_ids) {\n        Array::push(nested_bound, Array::get(bound_ids, i))\n        i = i + 1\n      }\n      let fields = array_empty()\n      let mut j = 0\n      while j < Array::length(vars) {\n        let id = Array::get(vars, j)\n        Array::push(fields, canonical_bounds_for(vars, rows, id))\n        j = j + 1\n      }\n      Array::push(fields, canonical_type(body, s, nested_bound, bound_names, free_ids, free_names, resolving))\n      canonical_node(\"G\", fields)\n    }\n  }\n}\n\n\nfn canonical_name_seen(names: Array[String], name: String) -> Bool {\n  string_in(names, name)\n}\n\nfn canonical_collect_effective_bindings(env: TypeEnv) -> Array[(String, Type)] {\n  let out = array_empty()\n  let seen = array_empty()\n  let mut cur = env\n  let mut done = false\n  while !done {\n    match cur {\n      EnvEmpty => {\n        done = true\n      },\n      EnvBind(name, ty, rest) => {\n        if !canonical_name_seen(seen, name) {\n          Array::push(seen, name)\n          if !String::starts_with(name, \"__fn_ret__:\") {\n            Array::push(out, (name, ty))\n          }\n        }\n        cur = rest\n      },\n      EnvTraitDef(_, _, _, _, rest, _) => {\n        cur = rest\n      },\n      EnvTraitImpl(_, _, rest) => {\n        cur = rest\n      },\n      EnvTraitImplGen(_, _, _, _, rest) => {\n        cur = rest\n      },\n      EnvFlat(bindings) => {\n        let mut i = 0\n        while i < Array::length(bindings) {\n          let (name, ty) = Array::get(bindings, i)\n          if !canonical_name_seen(seen, name) {\n            Array::push(seen, name)\n            if !String::starts_with(name, \"__fn_ret__:\") {\n              Array::push(out, (name, ty))\n            }\n          }\n          i = i + 1\n        }\n        done = true\n      },\n      EnvCached(names, types, rest) => {\n        let mut i = 0\n        while i < Array::length(names) {\n          let name = Array::get(names, i)\n          if !canonical_name_seen(seen, name) {\n            Array::push(seen, name)\n            if !String::starts_with(name, \"__fn_ret__:\") {\n              Array::push(out, (name, Array::get(types, i)))\n            }\n          }\n          i = i + 1\n        }\n        cur = rest\n      }\n    }\n  }\n  out\n}\n\nfn canonical_sorted_bindings(bindings: Array[(String, Type)]) -> Array[(String, Type)] {\n  let out = array_empty()\n  let mut i = 0\n  while i < Array::length(bindings) {\n    let item = Array::get(bindings, i)\n    let (name, _) = item\n    let mut at = Array::length(out)\n    let mut j = 0\n    while j < Array::length(out) && at == Array::length(out) {\n      let (other, _) = Array::get(out, j)\n      if str_lt(name, other) {\n        at = j\n      } else {\n        j = j + 1\n      }\n    }\n    Array::push(out, item)\n    let mut k = Array::length(out) - 1\n    while k > at {\n      Array::set(out, k, Array::get(out, k - 1))\n      k = k - 1\n    }\n    Array::set(out, at, item)\n    i = i + 1\n  }\n  out\n}\n\nexport fn canonical_effective_value_env_snapshot(env: TypeEnv, s: Subst) -> String {\n  let bindings = canonical_sorted_bindings(canonical_collect_effective_bindings(env))\n  let free_ids = array_empty()\n  let free_names = array_empty()\n  let fields = [\n    \"v1\"\n  ]\n  let mut i = 0\n  while i < Array::length(bindings) {\n    let (name, ty) = Array::get(bindings, i)\n    Array::push(fields, canonical_node(\"B\", [\n      name,\n      canonical_type(ty, s, array_empty(), array_empty(), free_ids, free_names, array_empty())\n    ]))\n    i = i + 1\n  }\n  canonical_node(\"CEVS\", fields)\n}\n\nexport fn canonical_checked_value_env_snapshot(checked: CheckedProgram) -> String {\n  canonical_effective_value_env_snapshot(checked.final_env, checked.final_subst)\n}\n\n\nfn canonical_trait_impl_param_position(params: Array[String], name: String) -> Int {\n  let mut i = 0\n  let mut position = -1\n  let mut matches = 0\n  while i < Array::length(params) {\n    if Array::get(params, i) == name {\n      position = i\n      matches = matches + 1\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  if matches == 0 {\n    -1\n  } else if matches == 1 {\n    position\n  } else {\n    -2\n  }\n}\n\nfn canonical_trait_impl_bounds(params: Array[String], bounds: Array[(String, Array[String])]) -> String {\n  let rows = array_empty()\n  let mut position = 0\n  while position < Array::length(params) {\n    let labels = array_empty()\n    let mut i = 0\n    while i < Array::length(bounds) {\n      let (name, row_labels) = Array::get(bounds, i)\n      if canonical_trait_impl_param_position(params, name) == position {\n        let mut j = 0\n        while j < Array::length(row_labels) {\n          Array::push(labels, Array::get(row_labels, j))\n          j = j + 1\n        }\n      } else {\n        ()\n      }\n      i = i + 1\n    }\n    let label_set = sorted_unique_strings(labels)\n    let label_encoding = canonical_node(\"L\", label_set)\n    let row = canonical_node(\"R\", [\n      __to_string(position),\n      label_encoding\n    ])\n    Array::push(rows, row)\n    position = position + 1\n  }\n  let malformed = array_empty()\n  let mut i = 0\n  while i < Array::length(bounds) {\n    let (name, labels) = Array::get(bounds, i)\n    let position = canonical_trait_impl_param_position(params, name)\n    if position == -1 {\n      let label_set = sorted_unique_strings(labels)\n      let label_encoding = canonical_node(\"L\", label_set)\n      let marker = canonical_node(\"M\", [\n        \"reason\",\n        \"unbound_bound_parameter\",\n        \"name\",\n        name,\n        \"labels\",\n        label_encoding\n      ])\n      Array::push(malformed, marker)\n    } else if position == -2 {\n      let label_set = sorted_unique_strings(labels)\n      let label_encoding = canonical_node(\"L\", label_set)\n      let marker = canonical_node(\"M\", [\n        \"reason\",\n        \"ambiguous_bound_parameter\",\n        \"name\",\n        name,\n        \"labels\",\n        label_encoding\n      ])\n      Array::push(malformed, marker)\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  let normalized_malformed = sorted_unique_strings(malformed)\n  let mut j = 0\n  while j < Array::length(normalized_malformed) {\n    Array::push(rows, Array::get(normalized_malformed, j))\n    j = j + 1\n  }\n  canonical_node(\"B\", rows)\n}\n\nfn canonical_trait_impl_entry(trait_name: String, target: Type, s: Subst, free_ids: Array[Int], free_names: Array[String]) -> String {\n  let encoded_target = canonical_type(target, s, array_empty(), array_empty(), free_ids, free_names, array_empty())\n  canonical_node(\"I\", [\n    trait_name,\n    encoded_target\n  ])\n}\n\nfn canonical_trait_impl_gen_entry(trait_name: String, params: Array[String], bounds: Array[(String, Array[String])], target: Type, s: Subst, free_ids: Array[Int], free_names: Array[String]) -> String {\n  let encoded_bounds = canonical_trait_impl_bounds(params, bounds)\n  let encoded_target = canonical_type(target, s, array_empty(), array_empty(), free_ids, free_names, array_empty())\n  canonical_node(\"G\", [\n    trait_name,\n    __to_string(Array::length(params)),\n    encoded_bounds,\n    encoded_target\n  ])\n}\n\nexport fn canonical_retained_trait_impl_entries_snapshot(env: TypeEnv, s: Subst) -> String {\n  let fields = [\n    \"v1\"\n  ]\n  let free_ids = array_empty()\n  let free_names = array_empty()\n  let mut cur = env\n  let mut done = false\n  while !done {\n    match cur {\n      EnvEmpty => {\n        done = true\n      },\n      EnvBind(_, _, rest) => {\n        cur = rest\n      },\n      EnvTraitDef(_, _, _, _, rest, _) => {\n        cur = rest\n      },\n      EnvTraitImpl(trait_name, target, rest) => {\n        let entry = canonical_trait_impl_entry(trait_name, target, s, free_ids, free_names)\n        Array::push(fields, entry)\n        cur = rest\n      },\n      EnvTraitImplGen(trait_name, params, bounds, target, rest) => {\n        let entry = canonical_trait_impl_gen_entry(trait_name, params, bounds, target, s, free_ids, free_names)\n        Array::push(fields, entry)\n        cur = rest\n      },\n      EnvFlat(_) => {\n        done = true\n      },\n      EnvCached(_, _, rest) => {\n        cur = rest\n      }\n    }\n  }\n  canonical_node(\"CTIS\", fields)\n}\n\n\nfn canonical_effect_label_with_params(label: String, params: Array[String]) -> String {\n  let mut out = \"\"\n  let mut i = 0\n  while i < String::length(label) {\n    let code = String::char_code_at(label, i)\n    let is_ident = (code >= 65 && code <= 90) || (code >= 97 && code <= 122) || (code >= 48 && code <= 57) || code == 95\n    if is_ident {\n      let start = i\n      while i < String::length(label) {\n        let inner = String::char_code_at(label, i)\n        if (inner >= 65 && inner <= 90) || (inner >= 97 && inner <= 122) || (inner >= 48 && inner <= 57) || inner == 95 {\n          i = i + 1\n        } else {\n          ()\n          break\n        }\n      }\n      let token = String::substring(label, start, i)\n      let at = canonical_named_bound(params, token)\n      if at >= 0 {\n        out = String::concat(out, String::concat(\"Q\", __to_string(at)))\n      } else {\n        out = String::concat(out, token)\n      }\n    } else {\n      out = String::concat(out, String::substring(label, i, i + 1))\n      i = i + 1\n    }\n  }\n  out\n}\n\nfn canonical_effect_with_params(s: Subst, effect: Option[String], params: Array[String]) -> String {\n  match effect {\n    None => canonical_node(\"EP\", array_empty()),\n    Some(name) => {\n      let resolved = if canonical_is_effect_var(name) {\n        canonical_effect_lookup(s, name, array_empty())\n      } else {\n        Some(name)\n      }\n      match resolved {\n        Some(text) => if String::length(text) == 0 {\n          canonical_node(\"EP\", array_empty())\n        } else {\n          let labels = canonical_effect_labels(text)\n          let normalized = array_empty()\n          let mut i = 0\n          while i < Array::length(labels) {\n            Array::push(normalized, canonical_effect_label_with_params(Array::get(labels, i), params))\n            i = i + 1\n          }\n          canonical_node(\"ER\", sorted_unique_strings(normalized))\n        },\n        None => canonical_node(\"EV\", [\n          canonical_effect_label_with_params(name, params)\n        ])\n      }\n    }\n  }\n}\n\nfn canonical_typedef_type(ty: Type, s: Subst, enum_binders: Array[Int], rigid_params: Array[String], free_ids: Array[Int], free_names: Array[String]) -> String {\n  canonical_type(ty, s, enum_binders, rigid_params, free_ids, free_names, array_empty())\n}\n\nfn canonical_typedef(def: TypeDef, binders: Array[Int], s: Subst, free_ids: Array[Int], free_names: Array[String]) -> String {\n  match def {\n    TDEnum(name, params, variants) => {\n      let fields = [\n        name,\n        __to_string(Array::length(params))\n      ]\n      let mut i = 0\n      while i < Array::length(variants) {\n        let (variant_name, payloads) = Array::get(variants, i)\n        let variant_fields = [\n          variant_name\n        ]\n        let mut j = 0\n        while j < Array::length(payloads) {\n          Array::push(variant_fields, canonical_typedef_type(Array::get(payloads, j), s, binders, array_empty(), free_ids, free_names))\n          j = j + 1\n        }\n        Array::push(fields, canonical_node(\"V\", variant_fields))\n        i = i + 1\n      }\n      canonical_node(\"E\", fields)\n    },\n    TDStruct(name, fields_raw, mut_fields, params) => {\n      let fields = [\n        name,\n        __to_string(Array::length(params))\n      ]\n      let mut i = 0\n      while i < Array::length(fields_raw) {\n        let (field_name, field_ty) = Array::get(fields_raw, i)\n        Array::push(fields, canonical_node(\"F\", [\n          field_name,\n          canonical_typedef_type(field_ty, s, array_empty(), params, free_ids, free_names)\n        ]))\n        i = i + 1\n      }\n      Array::push(fields, canonical_node(\"MU\", sorted_unique_strings(mut_fields)))\n      canonical_node(\"S\", fields)\n    },\n    TDAlias(name, params, body) => canonical_node(\"A\", [\n      name,\n      __to_string(Array::length(params)),\n      canonical_typedef_type(body, s, array_empty(), params, free_ids, free_names)\n    ]),\n    TDEffect(name, ops, params) => {\n      let fields = [\n        name,\n        __to_string(Array::length(params))\n      ]\n      let mut i = 0\n      while i < Array::length(ops) {\n        let (op_name, args, ret) = Array::get(ops, i)\n        let op_fields = [\n          op_name\n        ]\n        let mut j = 0\n        while j < Array::length(args) {\n          Array::push(op_fields, canonical_typedef_type(Array::get(args, j), s, array_empty(), params, free_ids, free_names))\n          j = j + 1\n        }\n        Array::push(op_fields, canonical_typedef_type(ret, s, array_empty(), params, free_ids, free_names))\n        Array::push(fields, canonical_node(\"O\", op_fields))\n        i = i + 1\n      }\n      canonical_node(\"K\", fields)\n    }\n  }\n}\n\nfn canonical_typedef_kind(def: TypeDef) -> String {\n  match def {\n    TDEnum(_, _, _) => \"enum\",\n    TDStruct(_, _, _, _) => \"struct\",\n    TDAlias(_, _, _) => \"alias\",\n    TDEffect(_, _, _) => \"effect\"\n  }\n}\n\nfn canonical_malformed_provenance(position: Int, kind: String, defs_count: Int, binders_count: Int, expected_binders: Int, actual_binders: Int, reason: String) -> String {\n  canonical_node(\"M\", [\n    \"position\",\n    __to_string(position),\n    \"kind\",\n    kind,\n    \"defs_count\",\n    __to_string(defs_count),\n    \"binders_count\",\n    __to_string(binders_count),\n    \"expected_binders\",\n    __to_string(expected_binders),\n    \"actual_binders\",\n    __to_string(actual_binders),\n    \"reason\",\n    reason\n  ])\n}\n\nexport fn canonical_checked_type_defs_snapshot(observation: CheckedProgramTypeDefsObservation) -> String {\n  let fields = [\n    \"v1\"\n  ]\n  let checked = observation.checked_program\n  let defs = checked.type_defs\n  let binders_by_def = observation.type_def_binders\n  let defs_count = Array::length(defs)\n  let binders_count = Array::length(binders_by_def)\n  let free_ids = array_empty()\n  let free_names = array_empty()\n  if defs_count != binders_count {\n    Array::push(fields, canonical_malformed_provenance(-1, \"array\", defs_count, binders_count, defs_count, binders_count, \"array_count_mismatch\"))\n  } else {\n    ()\n  }\n  let mut i = 0\n  while i < defs_count {\n    let def = Array::get(defs, i)\n    let kind = canonical_typedef_kind(def)\n    if i >= binders_count {\n      let expected = match def {\n        TDEnum(_, params, _) => Array::length(params),\n        _ => 0\n      }\n      Array::push(fields, canonical_malformed_provenance(i, kind, defs_count, binders_count, expected, -1, \"missing_metadata\"))\n    } else {\n      let binders = Array::get(binders_by_def, i)\n      let actual = Array::length(binders)\n      match def {\n        TDEnum(_, params, _) => {\n          let expected = Array::length(params)\n          if actual != expected {\n            Array::push(fields, canonical_malformed_provenance(i, kind, defs_count, binders_count, expected, actual, \"enum_binder_count_mismatch\"))\n          } else {\n            Array::push(fields, canonical_typedef(def, binders, checked.final_subst, free_ids, free_names))\n          }\n        },\n        _ => if actual != 0 {\n          Array::push(fields, canonical_malformed_provenance(i, kind, defs_count, binders_count, 0, actual, \"non_enum_binders\"))\n        } else {\n          Array::push(fields, canonical_typedef(def, binders, checked.final_subst, free_ids, free_names))\n        }\n      }\n    }\n    i = i + 1\n  }\n  while i < binders_count {\n    Array::push(fields, canonical_malformed_provenance(i, \"none\", defs_count, binders_count, 0, Array::length(Array::get(binders_by_def, i)), \"surplus_metadata\"))\n    i = i + 1\n  }\n  canonical_node(\"CTDS\", fields)\n}\n")
}

let source_60 = () -> (String, String) {
  ("lib/@vibe/compiler/checker/index.vpkg",
"name = @vibe/compiler/checker\nversion = 0.0.1\ndescription =\n  #|@vibe/compiler/checker — ADR-0070 / #897 compiler-internal contract.\ndeps = {\n  @vibe/compiler/codegen : 0.0.1\n  @vibe/compiler/core : 0.0.1\n  @vibe/core : 0.2.0\n}\n\ngenerated_hash =\n\n// @vibe/compiler/checker — ADR-0070 / #897 compiler-internal contract.\n// Directory-shared-scope package (20 files): the type checker's builtin\n// signature tables (builtins.vibe + 13 builtins_*.vibe lookup_* modules),\n// the core expression/statement checker (checker.vibe, checker_stmt.vibe),\n// pattern checking + exhaustiveness (checker_pattern.vibe,\n// checker_exhaustive.vibe), type-expr resolution (checker_resolve.vibe), and\n// the effect/mutability discipline passes (checker_effects.vibe — see\n// relocation note below). checker_facade.vibe (see naming note below)\n// re-exports a SUBSET of the surface (lookup_builtin, check_expr,\n// check_pattern, pat_has_unsupported_or_binding, resolve_type_expr,\n// CheckedProgram, check_program, check_program_result,\n// check_program_type_table, check_program_with_env,\n// check_program_with_env_result, check_stmts,\n// canonical_retained_trait_impl_entries_snapshot, canonical_checked_type_defs_snapshot, canonical_checked_value_env_snapshot, canonical_effective_value_env_snapshot, and the narrowly scoped type-definition observation APIs) via the `export ./file.vibe { names }`\n// SReExport form (#726);\n// every other name below is defined directly (`export fn`) in its own\n// sibling file and reaches outside importers purely through this package's\n// directory-shared scope + the facade generated from THIS contract (not\n// from checker_facade.vibe's own hand-written re-export list, which the\n// generated facade supersedes at ingestion time) — same shape as\n// codegen/expr's expr.vibe/core.vibe/support.vibe split.\n//\n// Naming-collision note: the established rename convention for this\n// migration batch is `git mv index.vibe <dirname>.vibe` (see\n// codegen/expr/expr.vibe, codegen/gc/gc.vibe, syntax/syntax.vibe). For this\n// directory the dirname is \"checker\", but `checker/checker.vibe` already\n// exists as a substantial (5.3k line) real implementation file — the core\n// expression checker, not a facade — so `git mv index.vibe checker.vibe`\n// would silently clobber it. `validate_index_layout_fs` also forbids\n// index.vibe and index.vpkg coexisting in the same directory (\"a boundary\n// has exactly one index\"), so leaving index.vibe in place unrenamed was not\n// an option either (loader/index.vibe::desugar_contract_source_fs). The old\n// index.vibe was therefore renamed to `checker_facade.vibe` instead —\n// non-colliding, and its content did not need any other change: directory\n// auto-discovery (`contract_sibling_impl_raws`) already reaches every other\n// sibling file regardless of what checker_facade.vibe itself re-exports, so\n// the facade file's existing partial re-export list stays correct as-is.\n//\n// checker_effects.vibe relocation note: this file used to live at\n// lib/@vibe/compiler/checker_effects.vibe (a sibling of the checker/\n// directory, not inside it) specifically so `checker/checker_stmt.vibe`\n// (which needs check_perform_effects_stmts_env etc. from it) could import it\n// as a \"#847 Phase C exception\" direct leaf import, deliberately bypassing\n// checker's own facade — routing that import through the facade would close\n// a real cycle (checker package -> checker_stmt.vibe -> checker_effects.vibe\n// -> checker package). Once checker/ became a real `index.vpkg` package\n// boundary, `enforce_incoming_boundary_fs` (#729) rejected that same direct\n// leaf import from OUTSIDE the package (\"cannot import ... across a package\n// boundary\"), since checker_effects.vibe itself was not a checker/ member —\n// and routing it through the package (the boundary-legal alternative)\n// reintroduced the exact cycle the leaf import had been added to avoid\n// (confirmed empirically: `type_db: import cycle detected at\n// checker/index.vpkg`). Moving checker_effects.vibe INTO checker/ resolves\n// both constraints at once: checker_stmt.vibe's own need for it becomes an\n// ordinary same-package sibling import (no facade indirection, no cycle),\n// and every outside consumer (entry/compiler/file_compile/file_compile.vibe,\n// several tests) now reaches its surface through this contract like any\n// other checker export. EffectError is declared transparently (bodyless,\n// no `opaque` keyword) rather than opaque, matching common_base's structs:\n// several tests pattern-match its constructors directly (e.g.\n// `EEEffectfulCallOutsideEffect(_) => true`), so the declaration only\n// attests name + arity while checker_effects.vibe's real enum definition\n// stays the single source of truth callers actually see.\n//\n// Compiled into the compiler itself via compiler_sources_manifest.tsv\n// (group `checker`): the old single `checker/index.vibe` row becomes a\n// dual row (this contract + checker_facade.vibe); the former top-level\n// `checker_effects.vibe` row is repointed to `checker/checker_effects.vibe`;\n// every other impl file in this directory already had its own manifest row\n// before this migration and is unchanged.\n\n// --- builtins.vibe\nfn lookup_builtin(name: String) -> Option[Type]\n\n// --- builtins_array.vibe\nfn lookup_array(name: String) -> Option[Type]\n\n// --- builtins_async.vibe\nfn lookup_async(name: String) -> Option[Type]\n\n// --- builtins_builders.vibe\nfn lookup_array_builder(name: String) -> Option[Type]\nfn lookup_string_builder(name: String) -> Option[Type]\n\n// --- builtins_bytes.vibe\nfn lookup_bytes(name: String) -> Option[Type]\n\n// --- builtins_fixed_array.vibe\nfn lookup_fixed_array(name: String) -> Option[Type]\n\n// --- builtins_frozen_array.vibe\nfn lookup_frozen_array(name: String) -> Option[Type]\n\n// --- builtins_fs.vibe\nfn lookup_fs(name: String) -> Option[Type]\n\n// --- builtins_map.vibe\nfn lookup_map(name: String) -> Option[Type]\n\n// --- builtins_misc.vibe\nfn lookup_misc(name: String) -> Option[Type]\n\n// --- builtins_net.vibe\nfn lookup_net(name: String) -> Option[Type]\n\n// --- builtins_simd.vibe\nfn lookup_simd(name: String) -> Option[Type]\n\n// --- builtins_string1.vibe\nfn lookup_string1(name: String) -> Option[Type]\n\n// --- builtins_string2.vibe\nfn lookup_string2(name: String) -> Option[Type]\n\n// --- builtins_system.vibe\nfn lookup_io(name: String) -> Option[Type]\n\n// --- checker.vibe\nfn check_assignable(expected: Type, actual: Type, s: Subst, errors: Array[String], what: String, off: Int) -> Subst\nfn detect_narrowed_generic_mismatch(expected: Type, actual: Type, s: Subst, errors: Array[String], what: String, off: Int) -> Subst\nfn preserve_generic_instantiation(resolved: Type, actual: Type) -> Type\nfn fn_return_env_name(name: String) -> String\nfn is_array_builder_ty(t: Type) -> Bool\nfn is_region_tagged_ty(t: Type) -> Bool\nfn pat_binds_resume(p: Pat) -> Bool\nfn reject_resume_outside_handler(e: Expr, sh: Bool, errors: Array[String]) -> Unit\nfn check_expr(expr: Expr, env: TypeEnv, defs: Array[TypeDef], s: Subst, c: Int, errors: Array[String], tytab: Array[(Int, Type)]) -> (Type, Subst, Int)\n\n// --- checker_exhaustive.vibe\nfn match_nonexhaustive_witness(scr_ty: Type, pats: Array[Pat], defs: Array[TypeDef]) -> Option[String]\n\n// --- checker_pattern.vibe\nfn pat_has_unsupported_or_binding(pat: Pat) -> Bool\nfn check_pattern(pat: Pat, scrutinee_ty: Type, env: TypeEnv, defs: Array[TypeDef], errors: Array[String]) -> TypeEnv\n\n// --- checker_resolve.vibe\nfn subst_type_params(ty: Type, params: Array[String], args: Array[Type]) -> Type\nfn resolve_type_expr(te: TypeExpr, defs: Array[TypeDef]) -> Type\n\n// --- checker_spawnable.vibe (#1081 step 3 Phase B)\nfn check_spawnable_captures(env: TypeEnv, s: Subst, defs: Array[TypeDef], f_expr: Expr, r_here: Type) -> Array[String]\nfn check_spawnable_mut_captures_stmts(stmts: Array[Stmt]) -> Array[String]\n\n// --- canonical_checked_type_state.vibe\n// Observation-only canonical encodings of effective final value bindings,\n// retained trait implementations, and separately supplied typedef provenance.\n// They are not runtime or persistent-cache serializations.\nfn canonical_effective_value_env_snapshot(env: TypeEnv, s: Subst) -> String\nfn canonical_checked_value_env_snapshot(checked: CheckedProgram) -> String\nfn canonical_retained_trait_impl_entries_snapshot(env: TypeEnv, s: Subst) -> String\nfn canonical_checked_type_defs_snapshot(observation: CheckedProgramTypeDefsObservation) -> String\n\n// --- checker_stmt.vibe\n// Transparent so checker-boundary consumers can inspect the preserved\n// production outputs; field shape is defined by checker_stmt.vibe.\ntype CheckedProgram\ntype CheckedProgramTypeDefsObservation\nfn check_stmts(raw_stmts: Array[Stmt], i: Int, env: TypeEnv, defs: Array[TypeDef], s: Subst, c: Int, errors: Array[String], tytab: Array[(Int, Type)]) -> (TypeEnv, Subst, Int)\nfn check_program_result(stmts: Array[Stmt]) -> CheckedProgram with { Error }\nfn check_program_type_defs_observation(stmts: Array[Stmt]) -> CheckedProgramTypeDefsObservation with { Error }\nfn check_program(stmts: Array[Stmt]) -> TypeEnv with { Error }\nfn check_program_type_table(stmts: Array[Stmt]) -> (Array[(Int, Type)], Subst) with { Error }\nfn check_program_with_env_result(stmts: Array[Stmt], initial_env: TypeEnv) -> CheckedProgram with { Error }\nfn check_program_with_env_type_defs_observation(stmts: Array[Stmt], initial_env: TypeEnv) -> CheckedProgramTypeDefsObservation with { Error }\nfn check_program_with_env(stmts: Array[Stmt], initial_env: TypeEnv) -> TypeEnv with { Error }\nfn detect_unused_imports(stmts: Array[Stmt]) -> Array[(String, String, String)]\nfn detect_unbound_nonunit_returns(stmts: Array[Stmt], tytab: Array[(Int, Type)], final_s: Subst) -> Array[String]\n\n// --- checker_trait.vibe (relocated here from compiler/ top level, #897\n// batch; used to live outside checker/ so checker_stmt.vibe's need for\n// register_builtin_traits was a #847-style direct leaf import bypassing the\n// facade -- once checker/ became a real index.vpkg package boundary,\n// enforce_incoming_boundary_fs rejected that leaf import from outside the\n// package, same class of fix as checker_effects.vibe's relocation above.\n// Its own former `./types.vibe` import (a top-level re-export shim of\n// core/'s own types, deleted in this same batch -- see core/'s Subst,\n// Type, TypeEnv, impls_overlap_for, trait_defined, type_implements_trait)\n// is now a direct `../core` import.\nfn satisfies_bound(env: TypeEnv, s: Subst, ty: Type, bound: String) -> Bool\nfn send_subst_vars(ty: Type, vids: Array[Int], args: Array[Type]) -> Type\nfn type_send_ok(env: TypeEnv, s: Subst, defs: Array[TypeDef], ty: Type) -> Bool\nfn check_bounds_satisfied(env: TypeEnv, s: Subst, ty: Type, bounds: Array[String]) -> Array[String]\nfn register_builtin_traits(env: TypeEnv) -> TypeEnv\nfn validate_supers_defined(env: TypeEnv, supers: Array[String]) -> Array[String]\nfn validate_impl_no_overlap(env: TypeEnv, trait_name: String, target: Type) -> Bool\n\n// --- checker_effects.vibe (relocated here, see header note above)\ntype EffectError\nfn set_error_row_checked(on: Bool) -> Unit\nfn effect_error_to_string(err: EffectError) -> String\nfn check_async_effects_expr(expr: Expr, env: TypeEnv, in_async: Bool) -> Array[EffectError]\nfn check_async_effects_stmt(stmt: Stmt, env: TypeEnv) -> Array[EffectError]\nfn check_async_effects_stmts(stmts: Array[Stmt], env: TypeEnv) -> Array[EffectError]\nfn check_perform_effects_expr_tx(root: Expr, root_declared: Array[String], root_in_handle: Bool, fn_names: Array[String], fn_effs: Array[Array[String]], root_ov_names: Array[String], root_ov_effs: Array[Array[String]]) -> Array[EffectError]\nfn check_perform_effects_expr(root: Expr, root_declared: Array[String], root_in_handle: Bool) -> Array[EffectError]\nfn check_perform_effects_stmt(stmt: Stmt) -> Array[EffectError]\nfn check_perform_effects_stmts(stmts: Array[Stmt]) -> Array[EffectError]\nfn check_perform_effects_stmts_env(stmts: Array[Stmt], env: TypeEnv) -> Array[EffectError]\nfn file_tests_cacheable(stmts: Array[Stmt]) -> Bool\nfn file_entry_cacheable(stmts: Array[Stmt], entry_name: String) -> Bool\nfn check_mutability_expr(expr: Expr, mutable: Array[String]) -> Array[EffectError]\nfn check_mutability_stmts(stmts: Array[Stmt]) -> Array[EffectError]\n")
}

