"\n\n\nfn system_no_params() -> Array[Type] {\n  Array::slice([\n    CtUnknown\n  ], 0, 0)\n}\n\nfn lookup_io_a(name: String) -> Option[Type] {\n  if name == \"sh\" {\n    Some(CtFn([\n      CtString\n    ], CtString, Some(\"Process\")))\n  } else if name == \"sh_lines\" {\n    Some(CtFn([\n      CtString\n    ], CtArray(CtString), Some(\"Process\")))\n  } else if name == \"path\" {\n    Some(CtFn([\n      CtString\n    ], CtUnknown, None))\n  } else if name == \"Path::ref\" {\n    Some(CtFn([\n      CtString\n    ], CtString, None))\n  } else if name == \"Path::to_string\" {\n    Some(CtFn([\n      CtUnknown\n    ], CtString, None))\n  } else if name == \"Path::is_absolute\" {\n    Some(CtFn([\n      CtString\n    ], CtBool, None))\n  } else if name == \"PromptText::new\" {\n    Some(CtFn([\n      CtString\n    ], CtString, None))\n  } else if name == \"Stdin::read_char\" {\n    Some(CtFn(system_no_params(), CtInt, Some(\"Stdin\")))\n  } else if name == \"Stdin::read_stream\" {\n    Some(CtFn([\n      CtInt\n    ], CtString, Some(\"Stdin\")))\n  } else {\n    None\n  }\n}\n\nfn lookup_io_b(name: String) -> Option[Type] {\n  if name == \"Stdout::write_char\" {\n    Some(CtFn([\n      CtInt\n    ], CtUnit, Some(\"Stdout\")))\n  } else if name == \"Stdout::write_stream\" {\n    Some(CtFn([\n      CtString\n    ], CtUnit, Some(\"Stdout\")))\n  } else if name == \"Env::get\" {\n    Some(CtFn([\n      CtString\n    ], CtString, Some(\"Env\")))\n  } else if name == \"Env::args_len\" {\n    Some(CtFn(system_no_params(), CtInt, Some(\"Env\")))\n  } else if name == \"Env::args_get\" {\n    Some(CtFn([\n      CtInt\n    ], CtString, Some(\"Env\")))\n  } else if name == \"Profiler::now_us\" {\n    Some(CtFn(system_no_params(), CtInt, Some(\"Profiler\")))\n  } else if name == \"sleep\" {\n    Some(CtFn([\n      CtInt\n    ], CtUnit, Some(\"Async\")))\n  } else if name == \"Path::resolve\" {\n    Some(CtFn([\n      CtString\n    ], CtString, None))\n  } else {\n    None\n  }\n}\n\nfn lookup_io_c(name: String) -> Option[Type] {\n  if name == \"Lines::parse\" {\n    Some(CtFn([\n      CtString\n    ], CtArray(CtString), None))\n  } else if name == \"Lines::stringify\" {\n    Some(CtFn([\n      CtArray(CtString)\n    ], CtString, None))\n  } else if name == \"Llm::complete\" {\n    Some(CtFn([\n      CtString,\n      CtString\n    ], CtString, Some(\"Llm\")))\n  } else if name == \"Rlm::run\" {\n    Some(CtFn([\n      CtString,\n      CtString\n    ], CtString, Some(\"Llm\")))\n  } else if name == \"Rlm::finalize\" {\n    Some(CtFn([\n      CtString\n    ], CtString, None))\n  } else {\n    None\n  }\n}\n\nexport fn lookup_io(name: String) -> Option[Type] {\n  match lookup_io_a(name) {\n    Some(t) => Some(t),\n    None => match lookup_io_b(name) {\n      Some(t) => Some(t),\n      None => lookup_io_c(name)\n    }\n  }\n}\n")
}

