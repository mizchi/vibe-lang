let source_190 = () -> (String, String) {
  ("lib/@vibe/core/list.vibe",
"\n\nexport enum List[T] {\n  Nil;\n  Cons(T, List[T])\n}\n\nimpl [T] Iterable for List[T]\n\n\nexport fn list_nth[T](xs: List[T], n: Int) -> Option[T] {\n  match xs {\n    Nil => None,\n    Cons(h, t) => if n == 0 {\n      Some(h)\n    } else list_nth(t, n - 1)\n  }\n}\n\nexport fn nth[T](xs: List[T], n: Int) -> Option[T] {\n  list_nth(xs, n)\n}\n\nexport fn list_of3[T](a: T, b: T, c: T) -> List[T] {\n  Cons(a, Cons(b, Cons(c, Nil)))\n}\n\nexport fn of3[T](a: T, b: T, c: T) -> List[T] {\n  list_of3(a, b, c)\n}\n\nexport fn list_of5[T](a: T, b: T, c: T, d: T, e: T) -> List[T] {\n  Cons(a, Cons(b, Cons(c, Cons(d, Cons(e, Nil)))))\n}\n\nexport fn of5[T](a: T, b: T, c: T, d: T, e: T) -> List[T] {\n  list_of5(a, b, c, d, e)\n}\n\nexport fn list_cons[T](x: T, xs: List[T]) -> List[T] {\n  Cons(x, xs)\n}\n\nexport fn list_drop[T](n: Int, xs: List[T]) -> List[T] {\n  if n <= 0 {\n    xs\n  }\n  else match xs {\n    Nil => Nil,\n    Cons(_, t) => list_drop(n - 1, t)\n  }\n}\n\nexport fn drop[T](xs: List[T], n: Int) -> List[T] {\n  list_drop(n, xs)\n}\n\nexport fn list_fold[A, B](f: (acc: B, x: A) -> B, init: B, xs: List[A]) -> B {\n  let rec go = (acc: B, rest: List[A]) -> B {\n    match rest {\n      Nil => acc,\n      Cons(h, t) => go(f(acc, h), t)\n    }\n  }\n  go(init, xs)\n}\n\nexport fn list_sum(xs: List[Int]) -> Int {\n  list_fold((acc: Int, x: Int) -> Int {\n    acc + x\n  }, 0, xs)\n}\n\nexport fn sum(xs: List[Int]) -> Int {\n  list_sum(xs)\n}\n\nexport fn list_head[T](xs: List[T]) -> Option[T] {\n  match xs {\n    Cons(h, _) => Some(h),\n    _ => None\n  }\n}\n\nexport fn head[T](xs: List[T]) -> Option[T] {\n  list_head(xs)\n}\n\nexport fn list_iter[T, R](f: (x: T) -> R, xs: List[T]) -> Int {\n  let rec go = (count: Int, rest: List[T]) -> Int {\n    match rest {\n      Nil => count,\n      Cons(h, t) => {\n        f(h)\n        go(count + 1, t)\n      }\n    }\n  }\n  go(0, xs)\n}\n\nexport fn iter[T, R](xs: List[T], f: (x: T) -> R) -> Int {\n  list_iter(f, xs)\n}\n\nexport fn list_tail[T](xs: List[T]) -> List[T] {\n  match xs {\n    Cons(_, t) => t,\n    _ => Nil\n  }\n}\n\nexport fn tail[T](xs: List[T]) -> List[T] {\n  list_tail(xs)\n}\n\nexport fn list_empty[T]() -> List[T] {\n  Nil\n}\n\nfn empty[T]() -> List[T] {\n  list_empty()\n}\n\nexport fn list_length[T](xs: List[T]) -> Int {\n  match xs {\n    Nil => 0,\n    Cons(_, t) => 1 + list_length(t)\n  }\n}\n\nexport fn length[T](xs: List[T]) -> Int {\n  list_length(xs)\n}\n\nexport fn iter_length[T](xs: List[T]) -> Int {\n  list_length(xs)\n}\n\nexport fn list_reverse[T](xs: List[T]) -> List[T] {\n  let rec go = (acc: List[T], rest: List[T]) -> List[T] {\n    match rest {\n      Nil => acc,\n      Cons(h, t) => go(Cons(h, acc), t)\n    }\n  }\n  go(Nil, xs)\n}\n\nexport fn reverse[T](xs: List[T]) -> List[T] {\n  list_reverse(xs)\n}\n\nexport fn list_map[A, B](f: (x: A) -> B, xs: List[A]) -> List[B] {\n  let rec go = (acc: List[B], rest: List[A]) -> List[B] {\n    match rest {\n      Nil => acc,\n      Cons(h, t) => go(Cons(f(h), acc), t)\n    }\n  }\n  list_reverse(go(Nil, xs))\n}\n\nexport fn list_zip[A, B](xs: List[A], ys: List[B]) -> List[(A, B)] {\n  let rec go = (acc: List[(A, B)], left: List[A], right: List[B]) -> List[(A, B)] {\n    match (left, right) {\n      (Cons(x, xt), Cons(y, yt)) => go(Cons((x, y), acc), xt, yt),\n      _ => list_reverse(acc)\n    }\n  }\n  go(Nil, xs, ys)\n}\n\nexport fn zip[A, B](xs: List[A], ys: List[B]) -> List[(A, B)] {\n  list_zip(xs, ys)\n}\n\nexport fn list_take[T](n: Int, xs: List[T]) -> List[T] {\n  let rec go = (acc: List[T], rest: List[T], count: Int) -> List[T] {\n    if count <= 0 {\n      acc\n    }\n    else match rest {\n      Nil => acc,\n      Cons(h, t) => go(Cons(h, acc), t, count - 1)\n    }\n  }\n  list_reverse(go(Nil, xs, n))\n}\n\nexport fn take[T](xs: List[T], n: Int) -> List[T] {\n  list_take(n, xs)\n}\n\nexport fn list_append[T](xs: List[T], ys: List[T]) -> List[T] {\n  let rec go = (acc: List[T], rest: List[T]) -> List[T] {\n    match rest {\n      Nil => acc,\n      Cons(h, t) => go(Cons(h, acc), t)\n    }\n  }\n  go(ys, list_reverse(xs))\n}\n\nexport fn append[T](xs: List[T], ys: List[T]) -> List[T] {\n  list_append(xs, ys)\n}\n\nexport fn list_filter[T](pred: (x: T) -> Bool, xs: List[T]) -> List[T] {\n  let rec go = (acc: List[T], rest: List[T]) -> List[T] {\n    match rest {\n      Nil => acc,\n      Cons(h, t) =>\n      if pred(h) {\n        go(Cons(h, acc), t)\n      }\n      else go(acc, t)\n    }\n  }\n  list_reverse(go(Nil, xs))\n}\n\nexport fn filter[T](xs: List[T], pred: (x: T) -> Bool) -> List[T] {\n  list_filter(pred, xs)\n}\n\nexport fn list_flatmap[A, B](f: (x: A) -> List[B], xs: List[A]) -> List[B] {\n  let rec go = (rest: List[A]) -> List[B] {\n    match rest {\n      Nil => Nil,\n      Cons(h, t) => list_append(f(h), go(t))\n    }\n  }\n  go(xs)\n}\n\nexport fn flatmap[A, B](xs: List[A], f: (x: A) -> List[B]) -> List[B] {\n  list_flatmap(f, xs)\n}\n\nexport fn list_is_empty[T](xs: List[T]) -> Bool {\n  xs is Nil\n}\n\nfn is_empty[T](xs: List[T]) -> Bool {\n  list_is_empty(xs)\n}\n\nexport fn list_iter_get[T](xs: List[T], index: Int) -> T {\n  match xs {\n    Cons(h, t) =>\n    if index == 0 {\n      h\n    } else list_iter_get(t, index - 1)\n    Nil => list_iter_get(xs, index)\n  }\n}\n\nexport fn iter_get[T](xs: List[T], index: Int) -> T {\n  list_iter_get(xs, index)\n}\n\nexport fn list_singleton[T](x: T) -> List[T] {\n  Cons(x, Nil)\n}\n\nexport fn singleton[T](x: T) -> List[T] {\n  list_singleton(x)\n}\n\nexport fn list_contains_by[T](eq: (a: T, b: T) -> Bool, value: T, xs: List[T]) -> Bool {\n  match xs {\n    Nil => false,\n    Cons(h, t) => if eq(h, value) {\n      true\n    } else list_contains_by(eq, value, t)\n  }\n}\n\nfn contains_by[T](xs: List[T], eq: (a: T, b: T) -> Bool, value: T) -> Bool {\n  list_contains_by(eq, value, xs)\n}\n\nexport fn List::nth[T](xs: List[T], n: Int) -> Option[T] {\n  list_nth(xs, n)\n}\n\nexport fn List::sum(xs: List[Int]) -> Int {\n  list_sum(xs)\n}\n\nexport fn List::zip[A, B](xs: List[A], ys: List[B]) -> List[(A, B)] {\n  list_zip(xs, ys)\n}\n\nexport fn List::drop[T](xs: List[T], n: Int) -> List[T] {\n  list_drop(n, xs)\n}\n\nexport fn List::head[T](xs: List[T]) -> Option[T] {\n  list_head(xs)\n}\n\nexport fn List::iter[T, R](xs: List[T], f: (x: T) -> R) -> Int {\n  list_iter(f, xs)\n}\n\nexport fn List::tail[T](xs: List[T]) -> List[T] {\n  list_tail(xs)\n}\n\nexport fn List::take[T](xs: List[T], n: Int) -> List[T] {\n  list_take(n, xs)\n}\n\nexport fn List::append[T](xs: List[T], ys: List[T]) -> List[T] {\n  list_append(xs, ys)\n}\n\nexport fn List::filter[T](xs: List[T], pred: (x: T) -> Bool) -> List[T] {\n  list_filter(pred, xs)\n}\n\nexport fn List::length[T](xs: List[T]) -> Int {\n  list_length(xs)\n}\n\nexport fn List::flatmap[A, B](xs: List[A], f: (x: A) -> List[B]) -> List[B] {\n  list_flatmap(f, xs)\n}\n\nexport fn List::reverse[T](xs: List[T]) -> List[T] {\n  list_reverse(xs)\n}\n\nexport fn List::is_empty[T](xs: List[T]) -> Bool {\n  list_is_empty(xs)\n}\n\nexport fn List::iter_get[T](xs: List[T], index: Int) -> T {\n  iter_get(xs, index)\n}\n\nexport fn List::contains_by[T](xs: List[T], eq: (a: T, b: T) -> Bool, value: T) -> Bool {\n  list_contains_by(eq, value, xs)\n}\n\nexport fn List::iter_length[T](xs: List[T]) -> Int {\n  iter_length(xs)\n}\n")
}

let source_191 = () -> (String, String) {
  ("lib/@vibe/core/set.vibe",
"\n\n\n\nexport struct StringSet {\n  entries: Map[String, Bool]\n}\n\nexport struct Set[T] {\n  entries: Map[String, T]\n}\n\n\nexport fn size(s: StringSet) -> Int {\n  Array::length(Map::keys(s.entries))\n}\n\nexport fn empty() -> StringSet {\n  StringSet::{\n    entries: Map::new()\n  }\n}\n\nexport fn contains(s: StringSet, value: String) -> Bool {\n  Map::has_key(s.entries, value)\n}\n\nexport fn add(s: StringSet, value: String) -> StringSet {\n  StringSet::{\n    entries: Map::set(s.entries, value, true)\n  }\n}\n\nexport fn remove(s: StringSet, value: String) -> StringSet {\n  let keys = Map::keys(s.entries)\n  let len = Array::length(keys)\n  let rec go = (i: Int, acc: Map[String, Bool]) -> Map[String, Bool] {\n    if i >= len {\n      acc\n    } else {\n      let k = Array::get(keys, i)\n      if k == value {\n        go(i + 1, acc)\n      } else go(i + 1, Map::set(acc, k, true))\n    }\n  }\n  StringSet::{\n    entries: go(0, Map::new())\n  }\n}\n\nexport fn is_empty(s: StringSet) -> Bool {\n  Array::length(Map::keys(s.entries)) == 0\n}\n\nexport fn set_union(a: StringSet, b: StringSet) -> StringSet {\n  let keys = Map::keys(b.entries)\n  let len = Array::length(keys)\n  let rec go = (i: Int, acc: Map[String, Bool]) -> Map[String, Bool] {\n    if i >= len {\n      acc\n    } else go(i + 1, Map::set(acc, Array::get(keys, i), true))\n  }\n  StringSet::{\n    entries: go(0, a.entries)\n  }\n}\n\nexport fn from_array(values: Array[String]) -> StringSet {\n  let len = Array::length(values)\n  let rec go = (i: Int, acc: Map[String, Bool]) -> Map[String, Bool] {\n    if i >= len {\n      acc\n    } else go(i + 1, Map::set(acc, Array::get(values, i), true))\n  }\n  StringSet::{\n    entries: go(0, Map::new())\n  }\n}\n\nexport fn set_intersect(a: StringSet, b: StringSet) -> StringSet {\n  let keys = Map::keys(a.entries)\n  let len = Array::length(keys)\n  let rec go = (i: Int, acc: Map[String, Bool]) -> Map[String, Bool] {\n    if i >= len {\n      acc\n    } else {\n      let k = Array::get(keys, i)\n      if Map::has_key(b.entries, k) {\n        go(i + 1, Map::set(acc, k, true))\n      } else go(i + 1, acc)\n    }\n  }\n  StringSet::{\n    entries: go(0, Map::new())\n  }\n}\n\nexport fn set_difference(a: StringSet, b: StringSet) -> StringSet {\n  let keys = Map::keys(a.entries)\n  let len = Array::length(keys)\n  let rec go = (i: Int, acc: Map[String, Bool]) -> Map[String, Bool] {\n    if i >= len {\n      acc\n    } else {\n      let k = Array::get(keys, i)\n      if Map::has_key(b.entries, k) {\n        go(i + 1, acc)\n      } else go(i + 1, Map::set(acc, k, true))\n    }\n  }\n  StringSet::{\n    entries: go(0, Map::new())\n  }\n}\n\nexport fn set_value_to_string[T](value: T) -> String {\n  __to_string(value)\n}\n\nexport fn add_by[T](s: StringSet, value: T) -> StringSet {\n  add(s, set_value_to_string(value))\n}\n\nexport fn remove_by[T](s: StringSet, value: T) -> StringSet {\n  remove(s, set_value_to_string(value))\n}\n\nexport fn contains_by[T](s: StringSet, value: T) -> Bool {\n  contains(s, set_value_to_string(value))\n}\n\nexport fn from_array_by[T](values: Array[T]) -> StringSet {\n  let len = Array::length(values)\n  let rec go = (i: Int, acc: StringSet) -> StringSet {\n    if i >= len {\n      acc\n    } else go(i + 1, add_by(acc, Array::get(values, i)))\n  }\n  go(0, empty())\n}\n\n\nexport fn StringSet::size(s: StringSet) -> Int {\n  size(s)\n}\n\nexport fn StringSet::contains(s: StringSet, value: String) -> Bool {\n  contains(s, value)\n}\n\nexport fn StringSet::add(s: StringSet, value: String) -> StringSet {\n  add(s, value)\n}\n\nexport fn StringSet::remove(s: StringSet, value: String) -> StringSet {\n  remove(s, value)\n}\n\nexport fn StringSet::is_empty(s: StringSet) -> Bool {\n  is_empty(s)\n}\n\nexport fn StringSet::union(a: StringSet, b: StringSet) -> StringSet {\n  set_union(a, b)\n}\n\nexport fn StringSet::intersect(a: StringSet, b: StringSet) -> StringSet {\n  set_intersect(a, b)\n}\n\nexport fn StringSet::difference(a: StringSet, b: StringSet) -> StringSet {\n  set_difference(a, b)\n}\n\nexport fn StringSet::add_by[T](s: StringSet, value: T) -> StringSet {\n  add_by(s, value)\n}\n\nexport fn StringSet::remove_by[T](s: StringSet, value: T) -> StringSet {\n  remove_by(s, value)\n}\n\nexport fn StringSet::contains_by[T](s: StringSet, value: T) -> Bool {\n  contains_by(s, value)\n}\n\n\nexport fn Set::new[T]() -> Set[T] {\n  Set::{\n    entries: Map::new()\n  }\n}\n\nexport fn Set::size[T](s: Set[T]) -> Int {\n  Array::length(Map::keys(s.entries))\n}\n\nexport fn Set::is_empty[T](s: Set[T]) -> Bool {\n  eq(Set::size(s), 0)\n}\n\nexport fn Set::contains[T: Hash](s: Set[T], value: T) -> Bool {\n  Map::has_key(s.entries, map_key_to_string(value))\n}\n\nexport fn Set::add[T: Hash](s: Set[T], value: T) -> Set[T] {\n  Set::{\n    entries: Map::set(s.entries, map_key_to_string(value), value)\n  }\n}\n\nexport fn Set::remove[T: Hash](s: Set[T], value: T) -> Set[T] {\n  Set::{\n    entries: Map::delete(s.entries, map_key_to_string(value))\n  }\n}\n\nexport fn Set::to_array[T](s: Set[T]) -> Array[T] {\n  let keys = Map::keys(s.entries)\n  let len = Array::length(keys)\n  let out = ArrayBuilder::new()\n  let rec go = (i: Int) -> Unit {\n    if i >= len {\n      ()\n    } else {\n      ArrayBuilder::push(out, Map::get(s.entries, Array::get(keys, i)))\n      go(i + 1)\n    }\n  }\n  go(0)\n  ArrayBuilder::freeze(out)\n}\n\nexport fn Set::from_array[T: Hash](values: Array[T]) -> Set[T] {\n  let len = Array::length(values)\n  let rec go = (i: Int, acc: Map[String, T]) -> Map[String, T] {\n    if i >= len {\n      acc\n    } else {\n      let v = Array::get(values, i)\n      go(i + 1, Map::set(acc, map_key_to_string(v), v))\n    }\n  }\n  Set::{\n    entries: go(0, Map::new())\n  }\n}\n\nexport fn Set::union[T](a: Set[T], b: Set[T]) -> Set[T] {\n  let keys = Map::keys(b.entries)\n  let len = Array::length(keys)\n  let rec go = (i: Int, acc: Map[String, T]) -> Map[String, T] {\n    if i >= len {\n      acc\n    } else {\n      let k = Array::get(keys, i)\n      go(i + 1, Map::set(acc, k, Map::get(b.entries, k)))\n    }\n  }\n  Set::{\n    entries: go(0, a.entries)\n  }\n}\n\nexport fn Set::intersect[T](a: Set[T], b: Set[T]) -> Set[T] {\n  let keys = Map::keys(a.entries)\n  let len = Array::length(keys)\n  let rec go = (i: Int, acc: Map[String, T]) -> Map[String, T] {\n    if i >= len {\n      acc\n    } else {\n      let k = Array::get(keys, i)\n      if Map::has_key(b.entries, k) {\n        go(i + 1, Map::set(acc, k, Map::get(a.entries, k)))\n      } else go(i + 1, acc)\n    }\n  }\n  Set::{\n    entries: go(0, Map::new())\n  }\n}\n\nexport fn Set::difference[T](a: Set[T], b: Set[T]) -> Set[T] {\n  let keys = Map::keys(a.entries)\n  let len = Array::length(keys)\n  let rec go = (i: Int, acc: Map[String, T]) -> Map[String, T] {\n    if i >= len {\n      acc\n    } else {\n      let k = Array::get(keys, i)\n      if Map::has_key(b.entries, k) {\n        go(i + 1, acc)\n      } else go(i + 1, Map::set(acc, k, Map::get(a.entries, k)))\n    }\n  }\n  Set::{\n    entries: go(0, Map::new())\n  }\n}\n")
}

let source_192 = () -> (String, String) {
  ("lib/@vibe/core/map_get.vibe",
"\n\nexport fn get[V](m: Map[String, V], key: String) -> Option[V] {\n  if Map::has_key(m, key) {\n    Some(Map::get(m, key))\n  } else None\n}\n\nexport fn keys[V](m: Map[String, V]) -> Array[String] {\n  Map::keys(m)\n}\n\nexport fn get_or[V](m: Map[String, V], key: String, default: V) -> V {\n  match get(m, key) {\n    Some(value) => value,\n    _ => default\n  }\n}\n\nexport fn values[V](m: Map[String, V]) -> Array[V] {\n  let ks = Map::keys(m)\n  let out = ArrayBuilder::new()\n  let n = Array::length(ks)\n  let mut i = 0\n  while i < n {\n    ArrayBuilder::push(out, Map::get(m, Array::get(ks, i)))\n    i = i + 1\n  }\n  ArrayBuilder::freeze(out)\n}\n\nexport fn has_key[V](m: Map[String, V], key: String) -> Bool {\n  Map::has_key(m, key)\n}\n\nexport fn get_or_else[V](m: Map[String, V], key: String, default: () -> V) -> V {\n  match get(m, key) {\n    Some(value) => value,\n    _ => default()\n  }\n}\n")
}

let source_193 = () -> (String, String) {
  ("lib/@vibe/core/map.vibe",
"\n\n\nexport trait Hash {\n  hash_key(Self) -> String\n}\n\nimpl Hash for Int {\n  hash_key(self) -> String {\n    __to_string(self)\n  }\n}\n\nimpl Hash for Float {\n  hash_key(self) -> String {\n    __to_string(self)\n  }\n}\n\nimpl Hash for Double {\n  hash_key(self) -> String {\n    __to_string(self)\n  }\n}\n\nimpl Hash for Bool {\n  hash_key(self) -> String {\n    __to_string(self)\n  }\n}\n\nimpl Hash for Char {\n  hash_key(self) -> String {\n    __to_string(self)\n  }\n}\n\nimpl Hash for String {\n  hash_key(self) -> String {\n    self\n  }\n}\n\n\nexport fn length[V](m: Map[String, V]) -> Int {\n  Array::length(Map::keys(m))\n}\n\nexport fn is_empty[V](m: Map[String, V]) -> Bool {\n  length(m) == 0\n}\n\nexport fn map_key_to_string[K: Hash](key: K) -> String {\n  K::hash_key(key)\n}\n\nexport fn get_by[K: Hash, V](m: Map[String, V], key: K) -> Option[V] {\n  get(m, map_key_to_string(key))\n}\n\nexport fn has_by[K: Hash, V](m: Map[String, V], key: K) -> Bool {\n  has_key(m, map_key_to_string(key))\n}\n\nexport fn get_or_by[K: Hash, V](m: Map[String, V], key: K, default: V) -> V {\n  get_or(m, map_key_to_string(key), default)\n}\n\nexport fn get_or_else_by[K: Hash, V](m: Map[String, V], key: K, default: () -> V) -> V {\n  get_or_else(m, map_key_to_string(key), default)\n}\n\nexport fn set_by[K: Hash, V](m: Map[String, V], key: K, value: V) -> Map[String, V] {\n  Map::set(m, map_key_to_string(key), value)\n}\n\nexport fn delete_by[K: Hash, V](m: Map[String, V], key: K) -> Map[String, V] {\n  Map::delete(m, map_key_to_string(key))\n}\n")
}

