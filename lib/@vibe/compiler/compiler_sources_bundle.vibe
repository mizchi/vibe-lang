hoice consistent with e.g. Array::slice's\\n// clamping elsewhere in this file) instead of trunc'ing at all.\\nexport fn gen_double_to_int_body() -> Bytes {\\n  let b = bytebuf_new()\\n  // NaN: x != x is only true for NaN.\\n  emit_local_get(b, 0)\\n  emit_f64_reinterpret_i64(b)\\n  emit_local_get(b, 0)\\n  emit_f64_reinterpret_i64(b)\\n  emit_f64_ne(b)\\n  emit_if_i64(b)\\n  emit_i64_const(b, 0)\\n  emit_else(b)\\n  // Upper bound: trunc_f64_s is defined for x < 2^63.\\n  emit_local_get(b, 0)\\n  emit_f64_reinterpret_i64(b)\\n  emit_f64_const_lohi(b, 0, 1138753536)\\n  emit_f64_lt(b)\\n  emit_if_i64(b)\\n  // Lower bound: trunc_f64_s is defined for x >= -2^63.\\n  emit_local_get(b, 0)\\n  emit_f64_reinterpret_i64(b)\\n  emit_f64_const_lohi(b, 0, 3286237184)\\n  emit_f64_ge(b)\\n  emit_if_i64(b)\\n  emit_local_get(b, 0)\\n  emit_f64_reinterpret_i64(b)\\n  emit_i64_trunc_f64_s(b)\\n  emit_else(b)\\n  emit_i64_const(b, 0)\\n  emit_end(b)\\n  emit_else(b)\\n  emit_i64_const(b, 0)\\n  emit_end(b)\\n  emit_end(b)\\n  b\\n}\\n\\nexport fn gen_int_to_double_body() -> Bytes {\\n  let b = bytebuf_new()\\n  emit_local_get(b, 0)\\n  emit_f64_convert_i64_s(b)\\n  emit_i64_reinterpret_f64(b)\\n  b\\n}\\n\\n// #982: substring had ZERO bounds checks — the packed `(ptr+start)<<32 |\\n// (end-start)` view silently read adjacent heap for `end > len`, produced a\\n// u32-wrapped length ~4294967294 for `end < start` (i64_extend_i32_u on the\\n// negative difference), and read BEFORE the string for a negative `start`.\\n// Clamp start into [0, len] and end into [start', len] up front (the same\\n// tolerate-not-trap choice as Array::slice below), so every downstream packed\\n// view stays inside the source string and `end < start` yields \\\"\\\". Locals:\\n// 3/4 = existing i32 scratch, 5 = NEW i64 scratch holding len (meta bumped\\n// 2/0 -> 2/1 at the linked_compile push_builtin site).\\nexport fn gen_str_substring_body(enable_rc: Bool) -> Bytes {\\n  let b = bytebuf_new()\\n  // lo