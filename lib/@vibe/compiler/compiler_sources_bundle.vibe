let source_77 = () -> (String, String) {
  ("lib/@vibe/compiler/codegen/wasm_emit/simd.vibe",
"\nimport @vibe/compiler/core {\n  bytebuf_push, leb128_encode_u32\n}\n\n\nlet simd_prefix = 253\n\nlet simd_v128_load = 0\nlet simd_v128_store = 11\n\nlet simd_i8x16_splat = 15\n\nlet simd_i8x16_swizzle = 14\n\nlet simd_i8x16_eq = 35\nlet simd_i8x16_le_u = 42\nlet simd_i8x16_ge_u = 44\n\nlet simd_i8x16_sub = 113\nlet simd_i8x16_min_u = 119\n\nlet simd_v128_any_true = 83\n\nlet simd_v128_and = 78\nlet simd_v128_not = 77\n\nlet simd_i8x16_all_true = 99\nlet simd_i8x16_bitmask = 100\n\nlet simd_v128_const = 12\n\n\nexport fn emit_v128_load(buf: Bytes, align: Int, offset: Int) -> Unit {\n  bytebuf_push(buf, simd_prefix)\n  leb128_encode_u32(buf, simd_v128_load)\n  leb128_encode_u32(buf, align)\n  leb128_encode_u32(buf, offset)\n}\n\nexport fn emit_v128_store(buf: Bytes, align: Int, offset: Int) -> Unit {\n  bytebuf_push(buf, simd_prefix)\n  leb128_encode_u32(buf, simd_v128_store)\n  leb128_encode_u32(buf, align)\n  leb128_encode_u32(buf, offset)\n}\n\n\nexport fn emit_i8x16_splat(buf: Bytes) -> Unit {\n  bytebuf_push(buf, simd_prefix)\n  leb128_encode_u32(buf, simd_i8x16_splat)\n}\n\n\nexport fn emit_i8x16_eq(buf: Bytes) -> Unit {\n  bytebuf_push(buf, simd_prefix)\n  leb128_encode_u32(buf, simd_i8x16_eq)\n}\n\nexport fn emit_i8x16_le_u(buf: Bytes) -> Unit {\n  bytebuf_push(buf, simd_prefix)\n  leb128_encode_u32(buf, simd_i8x16_le_u)\n}\n\nexport fn emit_i8x16_ge_u(buf: Bytes) -> Unit {\n  bytebuf_push(buf, simd_prefix)\n  leb128_encode_u32(buf, simd_i8x16_ge_u)\n}\n\nexport fn emit_i8x16_swizzle(buf: Bytes) -> Unit {\n  bytebuf_push(buf, simd_prefix)\n  leb128_encode_u32(buf, simd_i8x16_swizzle)\n}\n\nexport fn emit_i8x16_sub(buf: Bytes) -> Unit {\n  bytebuf_push(buf, simd_prefix)\n  leb128_encode_u32(buf, simd_i8x16_sub)\n}\n\nexport fn emit_i8x16_min_u(buf: Bytes) -> Unit {\n  bytebuf_push(buf, simd_prefix)\n  leb128_encode_u32(buf, simd_i8x16_min_u)\n}\n\n\nexport fn emit_v128_any_true(buf: Bytes) -> Unit {\n  bytebuf_push(buf, simd_prefix)\n  leb128_encode_u32(buf, simd_v128_any_true)\n}\n\nexport fn emit_i8x16_all_true(buf: Bytes) -> Unit {\n  bytebuf_push(buf, simd_prefix)\n  leb128_encode_u32(buf, simd_i8x16_all_true)\n}\n\nexport fn emit_i8x16_bitmask(buf: Bytes) -> Unit {\n  bytebuf_push(buf, simd_prefix)\n  leb128_encode_u32(buf, simd_i8x16_bitmask)\n}\n\n\nexport fn emit_v128_and(buf: Bytes) -> Unit {\n  bytebuf_push(buf, simd_prefix)\n  leb128_encode_u32(buf, simd_v128_and)\n}\n\nexport fn emit_v128_or(buf: Bytes) -> Unit {\n  bytebuf_push(buf, simd_prefix)\n  leb128_encode_u32(buf, 80)\n}\n\nexport fn emit_v128_not(buf: Bytes) -> Unit {\n  bytebuf_push(buf, simd_prefix)\n  leb128_encode_u32(buf, simd_v128_not)\n}\n\n\nexport fn emit_v128_const(buf: Bytes, lanes: Array[Int]) -> Unit {\n  bytebuf_push(buf, simd_prefix)\n  leb128_encode_u32(buf, simd_v128_const)\n  let n = Array::length(lanes)\n  let mut i = 0\n  while i < 16 {\n    let b = if i < n {\n      Array::get(lanes, i)\n    } else {\n      0\n    }\n    bytebuf_push(buf, b&255)\n    i = i + 1\n  }\n}\n\nexport fn emit_v128_const_zero(buf: Bytes) -> Unit {\n  bytebuf_push(buf, simd_prefix)\n  leb128_encode_u32(buf, simd_v128_const)\n  let mut i = 0\n  while i < 16 {\n    bytebuf_push(buf, 0)\n    i = i + 1\n  }\n}\n\nexport fn emit_v128_const_splat_byte(buf: Bytes, byte_val: Int) -> Unit {\n  bytebuf_push(buf, simd_prefix)\n  leb128_encode_u32(buf, simd_v128_const)\n  let mut i = 0\n  while i < 16 {\n    bytebuf_push(buf, byte_val&255)\n    i = i + 1\n  }\n}\n")
}

let source_78 = () -> (String, String) {
  ("lib/@vibe/compiler/codegen/wasm_emit/simd_patterns.vibe",
"\nimport @vibe/compiler/core {\n  bytebuf_push, leb128_encode_u32\n}\n\n\n\n\n\nexport fn emit_simd_memcmp_16(buf: Bytes) -> Unit {\n  emit_local_get(buf, 0)\n  emit_i32_wrap_i64(buf)\n  emit_v128_load(buf, 0, 0)\n  emit_local_get(buf, 1)\n  emit_i32_wrap_i64(buf)\n  emit_v128_load(buf, 0, 0)\n  emit_i8x16_eq(buf)\n  emit_i8x16_all_true(buf)\n  emit_i64_extend_i32_s(buf)\n}\n\n\nexport fn emit_simd_find_byte_16(buf: Bytes) -> Unit {\n  emit_local_get(buf, 0)\n  emit_i32_wrap_i64(buf)\n  emit_v128_load(buf, 0, 0)\n  emit_local_get(buf, 1)\n  emit_i32_wrap_i64(buf)\n  emit_i8x16_splat(buf)\n  emit_i8x16_eq(buf)\n  emit_i8x16_bitmask(buf)\n  emit_i64_extend_i32_s(buf)\n}\n\n\nexport fn emit_simd_skip_whitespace_16(buf: Bytes) -> Unit {\n  emit_local_get(buf, 0)\n  emit_i32_wrap_i64(buf)\n  emit_v128_load(buf, 0, 0)\n  emit_local_set(buf, 2)\n  emit_local_get(buf, 2)\n  emit_i64_const(buf, 0x20)\n  emit_i32_wrap_i64(buf)\n  emit_i8x16_splat(buf)\n  emit_i8x16_eq(buf)\n  emit_local_get(buf, 2)\n  emit_i64_const(buf, 0x09)\n  emit_i32_wrap_i64(buf)\n  emit_i8x16_splat(buf)\n  emit_i8x16_eq(buf)\n  emit_v128_or(buf)\n  emit_local_get(buf, 2)\n  emit_i64_const(buf, 0x0A)\n  emit_i32_wrap_i64(buf)\n  emit_i8x16_splat(buf)\n  emit_i8x16_eq(buf)\n  emit_v128_or(buf)\n  emit_local_get(buf, 2)\n  emit_i64_const(buf, 0x0D)\n  emit_i32_wrap_i64(buf)\n  emit_i8x16_splat(buf)\n  emit_i8x16_eq(buf)\n  emit_v128_or(buf)\n  emit_v128_not(buf)\n  emit_i8x16_bitmask(buf)\n  emit_i64_extend_i32_s(buf)\n}\n\n\nexport fn emit_simd_is_identifier_char_16(buf: Bytes) -> Unit {\n  emit_local_get(buf, 0)\n  emit_i32_wrap_i64(buf)\n  emit_v128_load(buf, 0, 0)\n  emit_local_set(buf, 1)\n  emit_local_get(buf, 1)\n  emit_i64_const(buf, 0x5F)\n  emit_i32_wrap_i64(buf)\n  emit_i8x16_splat(buf)\n  emit_i8x16_eq(buf)\n  emit_i8x16_bitmask(buf)\n  emit_i64_extend_i32_s(buf)\n}\n\n\nfn emit_i64_load(buf: Bytes, align: Int, offset: Int) -> Unit {\n  bytebuf_push(buf, 41)\n  leb128_encode_u32(buf, align)\n  leb128_encode_u32(buf, offset)\n}\n\n\nexport fn emit_scalar_memcmp_16_unrolled(buf: Bytes) -> Unit {\n  emit_local_get(buf, 0)\n  emit_i32_wrap_i64(buf)\n  emit_i64_load(buf, 0, 0)\n  emit_local_get(buf, 1)\n  emit_i32_wrap_i64(buf)\n  emit_i64_load(buf, 0, 0)\n  emit_i64_eq(buf)\n  emit_if_i64(buf)\n  emit_local_get(buf, 0)\n  emit_i32_wrap_i64(buf)\n  emit_i64_load(buf, 0, 8)\n  emit_local_get(buf, 1)\n  emit_i32_wrap_i64(buf)\n  emit_i64_load(buf, 0, 8)\n  emit_i64_eq(buf)\n  emit_i64_extend_i32_s(buf)\n  emit_else(buf)\n  emit_i64_const(buf, 0)\n  emit_end(buf)\n}\n\n\nexport fn emit_scalar_find_byte_16_unrolled(buf: Bytes) -> Unit {\n  emit_local_get(buf, 0)\n  emit_i32_wrap_i64(buf)\n  emit_i32_load8_u(buf, 0, 0)\n  emit_i64_extend_i32_s(buf)\n  emit_local_get(buf, 1)\n  emit_i64_eq(buf)\n  emit_if_i64(buf)\n  emit_i64_const(buf, 1)\n  emit_return(buf)\n  emit_else(buf)\n  emit_local_get(buf, 0)\n  emit_i32_wrap_i64(buf)\n  emit_i32_load8_u(buf, 0, 1)\n  emit_i64_extend_i32_s(buf)\n  emit_local_get(buf, 1)\n  emit_i64_eq(buf)\n  emit_if_i64(buf)\n  emit_i64_const(buf, 2)\n  emit_return(buf)\n  emit_else(buf)\n  emit_local_get(buf, 0)\n  emit_i32_wrap_i64(buf)\n  emit_i32_load8_u(buf, 0, 2)\n  emit_i64_extend_i32_s(buf)\n  emit_local_get(buf, 1)\n  emit_i64_eq(buf)\n  emit_if_i64(buf)\n  emit_i64_const(buf, 4)\n  emit_return(buf)\n  emit_else(buf)\n  emit_local_get(buf, 0)\n  emit_i32_wrap_i64(buf)\n  emit_i32_load8_u(buf, 0, 3)\n  emit_i64_extend_i32_s(buf)\n  emit_local_get(buf, 1)\n  emit_i64_eq(buf)\n  emit_if_i64(buf)\n  emit_i64_const(buf, 8)\n  emit_return(buf)\n  emit_else(buf)\n  emit_i64_const(buf, 0)\n  emit_end(buf)\n  emit_end(buf)\n  emit_end(buf)\n  emit_end(buf)\n}\n")
}

let source_79 = () -> (String, String) {
  ("lib/@vibe/compiler/codegen/common_base/index.vpkg",
"name = @vibe/compiler/codegen/common_base\nversion = 0.0.1\ndescription =\n  #|@vibe/compiler/codegen/common_base — the shared codegen substrate: the\ndeps = {\n  @vibe/compiler/codegen/wasm_emit : 0.0.1\n  @vibe/compiler/core : 0.0.1\n  @vibe/core : 0.2.0\n}\n\ngenerated_hash =\n\n// @vibe/compiler/codegen/common_base — the shared codegen substrate: the\n// linear-backend CompileCtx / wasm-gc-backend CompileCtxGc compile-context\n// structs plus the func/str/lambda/ctor lookup tables they carry, the branch-\n// coverage CovState, the interior-line-breakpoint DbgProv, and ~80 low-level\n// AST-shape predicates / wasm instruction emit helpers / ctor-table and\n// effect-tag lookups shared across every codegen backend and expr-compile\n// module (ADR-0070 Phase 3, #897, compiler-internal batch). Compiled into\n// the compiler itself via compiler_sources_manifest.tsv (group `codegen`,\n// dual-row: this contract + common_base.vibe).\n//\n// The old index.vibe was not a facade but the whole implementation (the\n// package was originally single-file: no sibling files in this directory),\n// so it moved verbatim to common_base.vibe. Unlike normalize/perceus/\n// common_analysis, this package DOES export real struct types (FuncTable,\n// StrTable, LambdaTable, CtorTable, CovState, LineMapState, CompileCtx,\n// DbgProv, CompileCtxGc) that other codegen packages construct/pattern-match/access\n// fields on directly. Per contract/contract.vibe's conformance checker, a\n// package-owned struct like this is declared as a bodyless (opaque-arity,\n// TRANSPARENT — no `opaque` keyword) `type Name` line: the real field list\n// stays the single source of truth in common_base.vibe, and check_contract\n// only verifies the name + arity match an exported top-level type def\n// there. This is DIFFERENT from @vibe/ast's index.vpkg, where the enums are\n// the only definition (the impl stub never redefines them) so the FULL body\n// lives in the contract; common_base's structs are the opposite shape\n// (impl-owned, contract just attests they exist), so only the bodyless form\n// belongs here. Expr/Pat/Stmt/TypeExpr (../../core) are plain structural\n// signature text, not declared at all (normalize/perceus precedent).\n//\n// Three external files previously imported this package by literal\n// `common_base/index.vibe` path instead of the bare directory form every\n// other consumer already used (`import ../common_base { .. }`):\n// entry/compiler/file_compile/file_compile.vibe, codegen/index.vibe, and\n// codegen/wasi/wasi.vibe. All three were switched to the bare form so every\n// consumer now reaches this package only through its index.vpkg.\n//\n// #897 codegen/ top-level batch UPDATE: this package gained 4 new sibling\n// files -- builtin_registry.vibe, double_to_string_expr.vibe,\n// int_parse_expr.vibe, inline_wat.vibe -- relocated here FROM codegen/'s own\n// top level while migrating codegen/'s own index.vibe to index.vpkg.\n// Reason: codegen/'s subpackages (expr/, gc/, wasi/ -- each already its own\n// index.vpkg from earlier #897 batches) need these 4 files directly\n// (builtin_registry for the func-table registry, double_to_string_expr /\n// int_parse_expr for synthesized-AST builtin lowering, inline_wat for\n// `= wasm \"...\"` bodies), while codegen/codegen.vibe (the top facade) ALSO\n// depends downward on expr/ and wasi/ to forward compile_module/\n// compile_wasi_module*. Leaving these 4 files owned by codegen/index.vpkg\n// itself therefore made codegen/index.vpkg <-> codegen/expr(gc,wasi)/\n// index.vpkg a genuine two-node import cycle the moment expr/gc/wasi's leaf\n// imports of them were switched to boundary-legal package imports\n// (confirmed empirically: `type_db: import cycle detected at\n// codegen/index.vpkg`, only surfaced by scripts/unit_test_runner.sh, not by\n// the build/gate steps that ran earlier in the same verification chain).\n// common_base already plays exactly this \"shared substrate every codegen\n// backend and expr-compile module depends on, with no upward edges of its\n// own\" role, so moving these 4 files here breaks the cycle cleanly: expr/\n// gc/wasi now reach them via an ordinary downward `import ../common_base`,\n// and codegen.vibe re-exports the externally-relevant subset\n// (lookup_registry_builtin, builtin_registry, verify_lane_builtins,\n// compile_inline_wat) via `export ./common_base { .. }` (cross-package\n// SReExport, same form as syntax/syntax.vibe's re-export of @vibe/parser) so\n// codegen/index.vpkg's own external facade surface is unchanged.\n// builtin_registry_typed, double_to_string_expr and int_parse_expr are NOT\n// re-exported by codegen.vibe (nothing outside codegen/expr and codegen/gc\n// consumes them), so they are declared here but not in codegen/index.vpkg.\n\n// Func/string/lambda-table lookups threaded through CompileCtx/CompileCtxGc.\ntype FuncTable\ntype StrTable\ntype LambdaTable\n// #1259 step 7: one user function's codegen output, carried as a value.\n// OPAQUE: nothing outside this package reads the fields -- linked_compile\n// only constructs one and hands it to the recorder. Contrast ModuleJob\n// (compiler/runtime), which is transparent because its field layout IS the\n// worker contract; here the exchange format is not settled yet.\ntype CodegenBodyCache\n\n// Constructor/struct dispatch table threaded through CompileCtx/CompileCtxGc.\ntype CtorTable\n\n// #cov branch coverage state (linear backend only). cov_disabled() when off.\ntype CovState\n\n// #644: static (wasm code offset -> source file/line) recorder for the\n// `vibe.linemap` custom section, threaded through CompileCtx.linemap.\n// linemap_disabled() outside debug-break builds and on every lambda-derived\n// ctx (see common_base.vibe's field doc comment).\ntype LineMapState\n\n// The linear-backend compile context: func/str/lambda/ctor tables, RC\n// (Perceus) bookkeeping, branch-coverage and interior-line-breakpoint state,\n// and per-function shape-tracking logs. See common_base.vibe for the full\n// field list and their extensive per-field doc comments.\ntype CompileCtx\n\n// Interior-line breakpoints (span-arc step5, multi-file): per-file\n// provenance the break codegen needs to emit `vibe::dbg_line(<file_id>,\n// <line>)` and a `vibe.dbgfiles` section. empty_dbg_prov() on non-break\n// builds.\ntype DbgProv\n\n// The wasm-gc-backend twin of CompileCtx (gc_-prefixed fields where a name\n// would otherwise collide with CompileCtx's own field at a different slot\n// index — see common_base.vibe's field-collision comment on gc_ctor_table).\ntype CompileCtxGc\n\nfn cov_disabled() -> CovState\nfn cov_emit_branch(buf: Bytes, cov: CovState) -> Unit\nfn empty_dbg_prov() -> DbgProv\nfn linemap_disabled() -> LineMapState\nfn int_log_reset_above(ctx: CompileCtx, floor: Int) -> Unit\nfn float_log_reset_above(ctx: CompileCtx, floor: Int) -> Unit\nfn gc_slot_log_reset_above(arr: Array[Int], floor: Int) -> Unit\nfn agg_log_reset_above(arr: Array[Int], floor: Int) -> Unit\nfn agg_log_reset_above2(arr: Array[Int], exprs: Array[Expr], floor: Int) -> Unit\nfn agg_slot_lookup(arr: Array[Int], slot: Int) -> Int\nfn agg_expr_lookup(arr: Array[Int], exprs: Array[Expr], slot: Int) -> Expr\nfn agg_info_of_type_name(ct: CtorTable, tname: String) -> Int\nfn agg_info_of_type_expr(ct: CtorTable, te: TypeExpr) -> Int\nfn compute_agg_returning(stmts: Array[Stmt], ct: CtorTable, out_names: Array[String], out_infos: Array[Int]) -> Unit\nfn agg_ret_lookup(names: Array[String], infos: Array[Int], fname: String) -> Int\nfn find_local_slot(names: Array[String], name: String) -> Int\nfn agg_info_of_ident(arr: Array[Int], e: Expr, local_names: Array[String]) -> Int\nfn agg_expr_of_ident(arr: Array[Int], exprs: Array[Expr], e: Expr, local_names: Array[String]) -> Expr\nfn is_efn(expr: Expr) -> Bool\nfn is_pint(p: Pat) -> Bool\nfn is_pfloat(p: Pat) -> Bool\nfn is_slet(stmt: Stmt) -> Bool\nfn expr_tag(expr: Expr) -> Int\nfn is_pbind(p: Pat) -> Bool\nfn is_pbool(p: Pat) -> Bool\nfn is_pctor(p: Pat) -> Bool\nfn is_pwild(p: Pat) -> Bool\nfn is_earray(expr: Expr) -> Bool\nfn is_eident(expr: Expr) -> Bool\nfn is_etuple(expr: Expr) -> Bool\nfn is_ptuple(p: Pat) -> Bool\nfn is_erecord(expr: Expr) -> Bool\nfn is_pstring(p: Pat) -> Bool\nfn emit_i32_eq(buf: Bytes) -> Unit\nfn emit_i32_ne(buf: Bytes) -> Unit\nfn get_arm_pat(arm: (Pat, Expr)) -> Pat\nfn lookup_ctor(ctor_names: Array[String], name: String, i: Int) -> Int\nfn ctor_sorted_index(names: Array[String]) -> (Array[String], Array[Int])\nfn ctor_table_index_of(ct: CtorTable, name: String) -> Int\nfn ctor_field_is_float(ctx: CompileCtx, ctor_idx: Int, field_idx: Int) -> Bool\nfn struct_field_candidates(ct: CtorTable, field: String) -> Array[(Int, Int)]\nfn struct_field_dispatch_cases(cands: Array[(Int, Int)]) -> Array[(Int, Int)]\nfn struct_index_by_field_set(ct: CtorTable, lit_names: Array[String]) -> Int\nfn struct_tag_by_index(ct: CtorTable, si: Int) -> Int\nfn emit_i32_eqz(buf: Bytes) -> Unit\nfn emit_i32_mul(buf: Bytes) -> Unit\nfn emit_i32_sub(buf: Bytes) -> Unit\nfn emit_str_ref(buf: Bytes, offset: Int, length: Int) -> Unit\nfn get_arm_body(arm: (Pat, Expr)) -> Expr\nfn get_efn_body(expr: Expr) -> Expr with { Error }\nfn get_eif_cond(expr: Expr) -> Expr with { Error }\nfn get_eif_else(expr: Expr) -> Expr with { Error }\nfn get_eif_then(expr: Expr) -> Expr with { Error }\nfn get_elet_val(expr: Expr) -> Expr with { Error }\nfn is_ctor_call(value: Expr, ct: CtorTable) -> Bool\nfn resolve_func(ft: FuncTable, name: String) -> (Int, Int, Int) with { Error }\nfn func_table_index_of(ft: FuncTable, name: String) -> Int\nfn emit_binop_op(buf: Bytes, op: String) -> Unit with { Error }\nfn emit_i32_ge_u(buf: Bytes) -> Unit\nfn emit_i32_gt_u(buf: Bytes) -> Unit\nfn emit_i64_load(buf: Bytes, align: Int, offset: Int) -> Unit\nfn get_ebinop_op(expr: Expr) -> String with { Error }\nfn get_elet_body(expr: Expr) -> Expr with { Error }\nfn get_elet_off(expr: Expr) -> Int with { Error }\nfn get_eletmut_off(expr: Expr) -> Int with { Error }\nfn get_elet_name(expr: Expr) -> String with { Error }\nfn get_func_body(stmt: Stmt) -> Expr with { Error }\nfn get_slet_expr(stmt: Stmt) -> Expr with { Error }\nfn get_slet_name(stmt: Stmt) -> String with { Error }\nfn get_slet_type(stmt: Stmt) -> Option[TypeExpr]\nfn resolve_local(names: Array[String], name: String, tag: String) -> Int with { Error }\nfn emit_i64_store(buf: Bytes, align: Int, offset: Int) -> Unit\nfn emit_box_float(buf: Bytes, ctx: CompileCtx, bits_local: Int, box_local: Int) -> Unit\nfn find_func_stmt(stmts: Array[Stmt], name: String) -> Stmt with { Error }\nfn emit_unbox_float(buf: Bytes) -> Unit\nfn emit_index_one(buf: Bytes, ctx: CompileCtx) -> Unit\nfn rc_shadow_base() -> Int\nfn rc_shadow_reserve() -> Int\nfn emit_rc_word_inc_saturating(buf: Bytes, push_addr: () -> Unit) -> Unit\nfn emit_rc_dup_guarded(buf: Bytes, local_idx: Int, rc_shadow: Bool) -> Unit\nfn fn_type_param_types(ty: Option[TypeExpr]) -> Option[Array[TypeExpr]]\nfn is_nullary_ctor_ident(value: Expr, ct: CtorTable) -> Bool\nfn name_has_effect_prefix(full: String, eff: String) -> Bool\nfn effect_name_to_tag(effect_names: Array[String], full: String) -> Int\nfn effect_op_declared_arity(keys: Array[String], arities: Array[Int], full: String) -> Int\nfn effect_op_index(keys: Array[String], full: String) -> Int\nfn emit_heap_grow_after_heap_set(buf: Bytes, ctx: CompileCtx) -> Unit\n\n// --- builtin_registry.vibe (relocated here, see #897 header note above)\nfn builtin_registry_typed() -> Array[(String, Type, Bool, Bool, Bool)]\nfn builtin_registry() -> Array[(String, Int, Int, Bool, Bool)]\nfn lookup_registry_builtin(name: String) -> Option[Type]\nfn verify_lane_builtins(lane: String, names: Array[String], param_counts: Array[Int], returns: Array[Int]) -> Unit with { Error }\n\n// --- double_to_string_expr.vibe (relocated here, see #897 header note above)\nfn double_to_string_expr(arg: Expr) -> Expr\n\n// --- int_parse_expr.vibe (relocated here, see #897 header note above)\nfn int_parse_expr(arg: Expr) -> Expr\n\n// --- double_parse_expr.vibe (#841 item E1)\nfn double_parse_expr(arg: Expr) -> Expr\n\n// --- inline_wat.vibe (relocated here, see #897 header note above)\nfn compile_inline_wat(fn_name: String, wat: String, param_names: Array[String]) -> Bytes with { Error }\nfn compile_inline_wat_full(fn_name: String, wat: String, param_names: Array[String], extra_base: Int) -> (Bytes, Int, Int, Int) with { Error }\n\n// --- builtin_name.vibe (relocated here from compiler/ top level, #897 batch;\n// same rationale as the 4 files above: needed leaf-directly by checker/ and\n// by multiple codegen/ subpackages -- see codegen/index.vpkg for the\n// re-export)\nfn canonical_builtin_name(name: String) -> String\n\n// --- desugar_trait_dict.vibe (relocated here from compiler/ top level,\n// #897 batch; needed leaf-directly by checker/, codegen/wasi/, and entry/ --\n// see codegen/index.vpkg for the subset re-exported further up)\nfn inject_trait_method_generics(stmts: Array[Stmt]) -> Unit\nfn inject_prelude_result(stmts: Array[Stmt]) -> Unit\nfn desugar_railway_binds(stmts: Array[Stmt]) -> Unit\nfn desugar_derives(stmts: Array[Stmt]) -> Unit\nfn desugar_hoist_local_lambdas(stmts: Array[Stmt]) -> Unit\nfn desugar_labeled_args(stmts: Array[Stmt]) -> Unit\nfn desugar_array_spread(stmts: Array[Stmt]) -> Unit\nfn desugar_trait_dicts(stmts: Array[Stmt]) -> Unit with { Error }\n// #1374: the exception-kind side channel. `desugar_trait_dicts` maintains the\n// cell; these two let a pass that runs AFTER it (the entry boundary) read the\n// kind and make sure the cell exists.\nfn exn_kind_read_expr() -> Expr\nfn exn_msg_read_expr() -> Expr\nfn ensure_exn_kind_cell(stmts: Array[Stmt]) -> Unit\n// --- self_tail_call\nfn rewrite_self_tail_calls(stmts: Array[Stmt]) -> Unit\n\n// --- inline_direct_perform\nfn inline_direct_performs(stmts: Array[Stmt]) -> Unit\n\n// --- evidence_dict_pass\nfn evidence_dict_pass(stmts: Array[Stmt], entry_name: String) -> Array[String]\n\n// --- suspend_cps_pass (ADR-0076 Phase 3a, #817)\nfn suspend_cps_pass(stmts: Array[Stmt]) -> Array[String]\n\n// #1259 step 7: one user function's codegen output carried as a VALUE, so a\n// coordinator can hand bodies out per function and collect them back without\n// codegen growing an `Fs` row (that row propagates into the signatures of user\n// programs that call compile_wasi_module). See common_base.vibe.\nfn codegen_body_cache_new() -> CodegenBodyCache\nfn codegen_body_cache_find(cache: CodegenBodyCache, fn_index: Int) -> Int\nfn codegen_body_cache_record(cache: CodegenBodyCache, fn_index: Int, bodies: Array[Bytes], meta_i32: Array[Int], meta_i64: Array[Int], meta_v128: Array[Int], lt: LambdaTable, lam_lo: Int, lam_hi: Int, slots: Array[Int], slot_lo: Int, slot_hi: Int) -> Unit\nfn codegen_body_cache_merge(a: CodegenBodyCache, b: CodegenBodyCache) -> CodegenBodyCache\nfn codegen_body_cache_replay(cache: CodegenBodyCache, at: Int, bodies: Array[Bytes], meta_i32: Array[Int], meta_i64: Array[Int], meta_v128: Array[Int], lt: LambdaTable, slots: Array[Int]) -> Unit\n// --- await_poll_pass (#1230, docs/spec/wasi-p3-async.md M1b-3c;\n// host_future key = ADR-0089 step 4, #1218; waiter_hooks key =\n// resolve -> direct wake, routes poll rounds through the library's\n// __aw_wait when the program can call the @vibex/concurrent hooks)\nfn await_poll_pass(stmts: Array[Stmt], host_future: Bool, waiter_hooks: Bool) -> Unit\n")
}

let source_80 = () -> (String, String) {
  ("lib/@vibe/compiler/codegen/common_base/common_base.vibe",
"\nimport @vibe/compiler/core {\n  Expr, Pat, Stmt, TypeExpr, __to_string, apply_perm_strings, bsearch_leftmost, bytebuf_push, leb128_encode_u32, sort_perm_by_names\n}\n\nimport @vibe/core {\n  array_empty\n}\n\nimport @vibe/compiler/codegen/wasm_emit {\n  emit_call,\n  emit_call_indirect,\n  emit_else,\n  emit_end,\n  emit_i32_add,\n  emit_i32_const,\n  emit_i32_load,\n  emit_i32_load8_u,\n  emit_i32_store,\n  emit_i32_store8,\n  emit_i32_wrap_i64,\n  emit_i64_add,\n  emit_i64_and,\n  emit_i64_const,\n  emit_i64_div_s,\n  emit_i64_eq,\n  emit_i64_eqz,\n  emit_i64_extend_i32_s,\n  emit_i64_ge_s,\n  emit_i64_gt_s,\n  emit_i64_le_s,\n  emit_i64_lt_s,\n  emit_i64_mul,\n  emit_i64_ne,\n  emit_i64_or,\n  emit_i64_rem_s,\n  emit_i64_shl,\n  emit_i64_shr_s,\n  emit_i64_store,\n  emit_i64_sub,\n  emit_i64_xor,\n  emit_if_void,\n  emit_local_get,\n  emit_local_set\n}\n\n\nexport struct FuncTable {\n  names: Array[String];\n  indices: Array[Int];\n  params: Array[Int];\n  returns: Array[Int];\n  needs_env: Array[Bool];\n  names_sorted: Array[String];\n  names_sorted_pos: Array[Int]\n}\n\nexport struct StrTable {\n  strs: Array[String];\n  offsets: Array[Int];\n  lengths: Array[Int]\n}\n\nexport struct LambdaTable {\n  bodies: Array[Bytes];\n  param_counts: Array[Int];\n  captures: Array[Array[String]];\n  meta_i32: Array[Int];\n  meta_i64: Array[Int]\n}\n\nexport struct CodegenBodyCache {\n  fn_indices: Array[Int];\n  fn_bodies: Array[Bytes];\n  fn_meta_i32: Array[Int];\n  fn_meta_i64: Array[Int];\n  fn_meta_v128: Array[Int];\n  lam_owner: Array[Int];\n  lam_indices: Array[Int];\n  lam_bodies: Array[Bytes];\n  lam_param_counts: Array[Int];\n  lam_captures: Array[Array[String]];\n  lam_meta_i32: Array[Int];\n  lam_meta_i64: Array[Int];\n  slot_owner: Array[Int];\n  slot_values: Array[Int]\n}\n\nexport fn codegen_body_cache_new() -> CodegenBodyCache {\n  CodegenBodyCache::{\n    fn_indices: array_empty(),\n    fn_bodies: array_empty(),\n    fn_meta_i32: array_empty(),\n    fn_meta_i64: array_empty(),\n    fn_meta_v128: array_empty(),\n    lam_owner: array_empty(),\n    lam_indices: array_empty(),\n    lam_bodies: array_empty(),\n    lam_param_counts: array_empty(),\n    lam_captures: array_empty(),\n    lam_meta_i32: array_empty(),\n    lam_meta_i64: array_empty(),\n    slot_owner: array_empty(),\n    slot_values: array_empty()\n  }\n}\n\nexport fn codegen_body_cache_find(cache: CodegenBodyCache, fn_index: Int) -> Int {\n  let n = Array::length(cache.fn_indices)\n  let mut i = 0\n  let mut found = 0 - 1\n  while found < 0 && i < n {\n    if Array::get(cache.fn_indices, i) == fn_index {\n      found = i\n    } else {\n      i = i + 1\n    }\n  }\n  found\n}\n\nexport fn codegen_body_cache_record(cache: CodegenBodyCache, fn_index: Int, bodies: Array[Bytes], meta_i32: Array[Int], meta_i64: Array[Int], meta_v128: Array[Int], lt: LambdaTable, lam_lo: Int, lam_hi: Int, slots: Array[Int], slot_lo: Int, slot_hi: Int) -> Unit {\n  let n = Array::length(bodies)\n  if n == 0 {\n    ()\n  } else {\n    Array::push(cache.fn_indices, fn_index)\n    Array::push(cache.fn_bodies, Array::get(bodies, n - 1))\n    Array::push(cache.fn_meta_i32, Array::get(meta_i32, Array::length(meta_i32) - 1))\n    Array::push(cache.fn_meta_i64, Array::get(meta_i64, Array::length(meta_i64) - 1))\n    Array::push(cache.fn_meta_v128, Array::get(meta_v128, Array::length(meta_v128) - 1))\n    let mut li = lam_lo\n    while li < lam_hi {\n      Array::push(cache.lam_owner, fn_index)\n      Array::push(cache.lam_indices, li)\n      Array::push(cache.lam_bodies, Array::get(lt.bodies, li))\n      Array::push(cache.lam_param_counts, Array::get(lt.param_counts, li))\n      Array::push(cache.lam_captures, Array::get(lt.captures, li))\n      Array::push(cache.lam_meta_i32, Array::get(lt.meta_i32, li))\n      Array::push(cache.lam_meta_i64, Array::get(lt.meta_i64, li))\n      li = li + 1\n    }\n    let mut si = slot_lo\n    while si < slot_hi {\n      Array::push(cache.slot_owner, fn_index)\n      Array::push(cache.slot_values, Array::get(slots, si))\n      si = si + 1\n    }\n  }\n}\n\nexport fn codegen_body_cache_merge(a: CodegenBodyCache, b: CodegenBodyCache) -> CodegenBodyCache {\n  let out = codegen_body_cache_new()\n  let mut si = 0\n  while si < 2 {\n    let src = if si == 0 {\n      a\n    } else {\n      b\n    }\n    let fn_n = Array::length(src.fn_indices)\n    let mut i = 0\n    while i < fn_n {\n      Array::push(out.fn_indices, Array::get(src.fn_indices, i))\n      Array::push(out.fn_bodies, Array::get(src.fn_bodies, i))\n      Array::push(out.fn_meta_i32, Array::get(src.fn_meta_i32, i))\n      Array::push(out.fn_meta_i64, Array::get(src.fn_meta_i64, i))\n      Array::push(out.fn_meta_v128, Array::get(src.fn_meta_v128, i))\n      i = i + 1\n    }\n    let lam_n = Array::length(src.lam_owner)\n    let mut j = 0\n    while j < lam_n {\n      Array::push(out.lam_owner, Array::get(src.lam_owner, j))\n      Array::push(out.lam_indices, Array::get(src.lam_indices, j))\n      Array::push(out.lam_bodies, Array::get(src.lam_bodies, j))\n      Array::push(out.lam_param_counts, Array::get(src.lam_param_counts, j))\n      Array::push(out.lam_captures, Array::get(src.lam_captures, j))\n      Array::push(out.lam_meta_i32, Array::get(src.lam_meta_i32, j))\n      Array::push(out.lam_meta_i64, Array::get(src.lam_meta_i64, j))\n      j = j + 1\n    }\n    let slot_n = Array::length(src.slot_owner)\n    let mut k = 0\n    while k < slot_n {\n      Array::push(out.slot_owner, Array::get(src.slot_owner, k))\n      Array::push(out.slot_values, Array::get(src.slot_values, k))\n      k = k + 1\n    }\n    si = si + 1\n  }\n  out\n}\n\nexport fn codegen_body_cache_replay(cache: CodegenBodyCache, at: Int, bodies: Array[Bytes], meta_i32: Array[Int], meta_i64: Array[Int], meta_v128: Array[Int], lt: LambdaTable, slots: Array[Int]) -> Unit {\n  let owner = Array::get(cache.fn_indices, at)\n  Array::push(bodies, Array::get(cache.fn_bodies, at))\n  Array::push(meta_i32, Array::get(cache.fn_meta_i32, at))\n  Array::push(meta_i64, Array::get(cache.fn_meta_i64, at))\n  Array::push(meta_v128, Array::get(cache.fn_meta_v128, at))\n  let n = Array::length(cache.lam_owner)\n  let mut i = 0\n  while i < n {\n    if Array::get(cache.lam_owner, i) == owner {\n      Array::push(lt.bodies, Array::get(cache.lam_bodies, i))\n      Array::push(lt.param_counts, Array::get(cache.lam_param_counts, i))\n      Array::push(lt.captures, Array::get(cache.lam_captures, i))\n      Array::push(lt.meta_i32, Array::get(cache.lam_meta_i32, i))\n      Array::push(lt.meta_i64, Array::get(cache.lam_meta_i64, i))\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  let sn = Array::length(cache.slot_owner)\n  let mut si = 0\n  while si < sn {\n    if Array::get(cache.slot_owner, si) == owner {\n      Array::push(slots, Array::get(cache.slot_values, si))\n    } else {\n      ()\n    }\n    si = si + 1\n  }\n}\n\nexport struct CtorTable {\n  names: Array[String];\n  tags: Array[Int];\n  field_counts: Array[Int];\n  type_names: Array[String];\n  struct_names: Array[String];\n  struct_field_names: Array[Array[String]];\n  names_sorted: Array[String];\n  names_sorted_pos: Array[Int]\n}\n\nexport struct CovState {\n  enabled: Bool;\n  base: Int;\n  cap: Int;\n  next: Array[Int];\n  cur_fn: Array[Int];\n  owners: Array[Int]\n}\n\nexport fn cov_disabled() -> CovState {\n  CovState::{\n    enabled: false,\n    base: 0,\n    cap: 0,\n    next: [\n      0\n    ],\n    cur_fn: [\n      0\n    ],\n    owners: ArrayBuilder::freeze(ArrayBuilder::new())\n  }\n}\n\nexport fn cov_emit_branch(buf: Bytes, cov: CovState) -> Unit {\n  if cov.enabled {\n    let id = Array::get(cov.next, 0)\n    if id < cov.cap {\n      Array::set(cov.next, 0, id + 1)\n      Array::push(cov.owners, Array::get(cov.cur_fn, 0))\n      emit_i32_const(buf, cov.base + id)\n      emit_i32_const(buf, 1)\n      emit_i32_store8(buf, 0, 0)\n    } else {\n      ()\n    }\n  } else {\n    ()\n  }\n}\n\nexport struct CompileCtx {\n  func_table: FuncTable;\n  str_table: StrTable;\n  lambda_table: LambdaTable;\n  num_user_funcs: Int;\n  func_offset: Int;\n  ref_cell_names: Array[String];\n  ctor_table: CtorTable;\n  ctor_float_fields: Array[Int];\n  thunk_names: Array[String];\n  const_int_names: Array[String];\n  const_int_values: Array[Int];\n  enable_rc: Bool;\n  rc_shadow: Bool;\n  rc_drop_names: Array[String];\n  rc_alias_dup_names: Array[String];\n  heap_binding_names: Array[String];\n  rc_drop_func_idx: Int;\n  rc_alloc_func_idx: Int;\n  heap_grow_check_func_idx: Int;\n  map_hash_func_idx: Int;\n  map_cap_func_idx: Int;\n  map_build_index_func_idx: Int;\n  map_probe_func_idx: Int;\n  rc_dup_names: Array[String];\n  capture_name_index: Array[String];\n  float_local_slots: Array[Int];\n  int_local_slots: Array[Int];\n  agg_local_slots: Array[Int];\n  agg_local_exprs: Array[Expr];\n  agg_ret_names: Array[String];\n  agg_ret_infos: Array[Int];\n  heap_ret_names: Array[String];\n  effect_names: Array[String];\n  effect_op_keys: Array[String];\n  effect_op_arities: Array[Int];\n  cov: CovState;\n  dbg_line_idx: Int;\n  dbg_line_nl: Array[Int];\n  dbg_line_file_id: Int;\n  loop_borrowed_names: Array[String];\n  loop_consumed_names: Array[String];\n  reuse_scrutinee_names: Array[String];\n  reuse_flag_locals: Array[Int];\n  borrow_ret_names: Array[String];\n  borrow_param_user: Array[String];\n  borrow_param_mask: Array[Int];\n  borrow_view_ret: Array[String];\n  scalar_ret_names: Array[String];\n  pending_letrec_self_name: Array[String];\n  table_slots_used: Array[Int];\n  lambda_plan_next: Array[Int];\n  linemap: LineMapState\n}\n\nexport struct DbgProv {\n  files: Array[String];\n  file_nls: Array[Array[Int]];\n  stmt_file_id: Array[Int]\n}\n\nexport fn empty_dbg_prov() -> DbgProv {\n  DbgProv::{\n    files: array_empty(),\n    file_nls: array_empty(),\n    stmt_file_id: array_empty()\n  }\n}\n\nexport struct LineMapState {\n  enabled: Bool;\n  cur_fn: Array[Int];\n  funcs: Array[Int];\n  offsets: Array[Int];\n  file_ids: Array[Int];\n  lines: Array[Int]\n}\n\nexport fn linemap_disabled() -> LineMapState {\n  LineMapState::{\n    enabled: false,\n    cur_fn: [\n      0\n    ],\n    funcs: array_empty(),\n    offsets: array_empty(),\n    file_ids: array_empty(),\n    lines: array_empty()\n  }\n}\n\nexport struct CompileCtxGc {\n  func_table: FuncTable;\n  str_table: StrTable;\n  lambda_table: LambdaTable;\n  num_user_funcs: Int;\n  func_offset: Int;\n  ref_cell_names: Array[String];\n  ref_local_indices: Array[Int];\n  refcell_type_idx: Int;\n  closure_type_base: Int;\n  gc_ctor_table: CtorTable;\n  gc_const_names: Array[String];\n  gc_const_kinds: Array[Int];\n  gc_const_ivals: Array[Int];\n  gc_const_svals: Array[String];\n  gc_global_names: Array[String];\n  gc_float_locals: Array[Int];\n  gc_bool_locals: Array[Int];\n  gc_to_string_is_show_wrapper: Bool;\n  gc_agg_local_slots: Array[Int];\n  gc_agg_ret_names: Array[String];\n  gc_agg_ret_infos: Array[Int];\n  table_slots_used: Array[Int]\n}\n\n\nexport fn int_log_reset_above(ctx: CompileCtx, floor: Int) -> Unit {\n  let arr = ctx.int_local_slots\n  let n = Array::length(arr)\n  let mut w = 0\n  let mut i = 0\n  while i < n {\n    let e = Array::get(arr, i)\n    if e / 4 < floor {\n      Array::set(arr, w, e)\n      w = w + 1\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  Array::truncate(arr, w)\n}\n\nexport fn float_log_reset_above(ctx: CompileCtx, floor: Int) -> Unit {\n  let arr = ctx.float_local_slots\n  let n = Array::length(arr)\n  let mut w = 0\n  let mut i = 0\n  while i < n {\n    let e = Array::get(arr, i)\n    if e / 2 < floor {\n      Array::set(arr, w, e)\n      w = w + 1\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  Array::truncate(arr, w)\n}\n\nexport fn agg_log_reset_above(arr: Array[Int], floor: Int) -> Unit {\n  let n = Array::length(arr)\n  let mut w = 0\n  let mut i = 0\n  while i < n {\n    let e = Array::get(arr, i)\n    if e / 256 < floor {\n      Array::set(arr, w, e)\n      w = w + 1\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  Array::truncate(arr, w)\n}\n\nexport fn gc_slot_log_reset_above(arr: Array[Int], floor: Int) -> Unit {\n  let n = Array::length(arr)\n  let mut w = 0\n  let mut i = 0\n  while i < n {\n    let e = Array::get(arr, i)\n    if e < floor {\n      Array::set(arr, w, e)\n      w = w + 1\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  Array::truncate(arr, w)\n}\n\nexport fn agg_log_reset_above2(arr: Array[Int], exprs: Array[Expr], floor: Int) -> Unit {\n  let n = Array::length(arr)\n  let mut w = 0\n  let mut i = 0\n  while i < n {\n    let e = Array::get(arr, i)\n    if e / 256 < floor {\n      Array::set(arr, w, e)\n      Array::set(exprs, w, Array::get(exprs, i))\n      w = w + 1\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  Array::truncate(arr, w)\n  Array::truncate(exprs, w)\n}\n\nexport fn agg_slot_lookup(arr: Array[Int], slot: Int) -> Int {\n  let mut i = Array::length(arr) - 1\n  let mut out = 0 - 1\n  while i >= 0 {\n    let e = Array::get(arr, i)\n    if e / 256 == slot {\n      out = e % 256\n      i = 0 - 1\n    } else {\n      i = i - 1\n    }\n  }\n  if out == 0 {\n    0 - 1\n  } else {\n    out\n  }\n}\n\nexport fn agg_expr_lookup(arr: Array[Int], exprs: Array[Expr], slot: Int) -> Expr {\n  let mut i = Array::length(arr) - 1\n  let mut out = EInt(0)\n  while i >= 0 {\n    let e = Array::get(arr, i)\n    if e / 256 == slot {\n      out = Array::get(exprs, i)\n      i = 0 - 1\n    } else {\n      i = i - 1\n    }\n  }\n  out\n}\n\nexport fn agg_info_of_type_name(ct: CtorTable, tname: String) -> Int {\n  let mut si = 0\n  let mut out = 0\n  while si < Array::length(ct.struct_names) {\n    if Array::get(ct.struct_names, si) == tname {\n      out = 128 + Array::length(Array::get(ct.struct_field_names, si))\n      si = Array::length(ct.struct_names)\n    } else {\n      si = si + 1\n    }\n  }\n  if out > 0 {\n    out\n  } else {\n    let mut ti = 0\n    let mut is_enum = false\n    while ti < Array::length(ct.type_names) {\n      if Array::get(ct.type_names, ti) == tname {\n        is_enum = true\n        ti = Array::length(ct.type_names)\n      } else {\n        ti = ti + 1\n      }\n    }\n    if is_enum {\n      128 + 63\n    } else {\n      0\n    }\n  }\n}\n\nexport fn agg_info_of_type_expr(ct: CtorTable, te: TypeExpr) -> Int {\n  match te {\n    TyTuple(tels) => 64 + Array::length(tels),\n    TyName(tname) => agg_info_of_type_name(ct, tname),\n    TyApp(tname, _) => agg_info_of_type_name(ct, tname),\n    _ => 0\n  }\n}\n\nexport fn compute_agg_returning(stmts: Array[Stmt], ct: CtorTable, out_names: Array[String], out_infos: Array[Int]) -> Unit {\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SLet(_, _, name, ann, value) => match value {\n        EFn(_, _, _, fn_ret, _, _) => {\n          let ret = match ann {\n            Some(at) => match at {\n              TyFn(_, r, _) => Some(r),\n              _ => fn_ret\n            },\n            None => fn_ret\n          }\n          match ret {\n            Some(rte) => {\n              let info = agg_info_of_type_expr(ct, rte)\n              if info > 0 {\n                Array::push(out_names, name)\n                Array::push(out_infos, info)\n              } else {\n                ()\n              }\n            },\n            None => ()\n          }\n        },\n        _ => ()\n      },\n      _ => ()\n    }\n    i = i + 1\n  }\n}\n\nexport fn agg_ret_lookup(names: Array[String], infos: Array[Int], fname: String) -> Int {\n  let mut i = 0\n  let mut out = 0 - 1\n  while i < Array::length(names) {\n    if Array::get(names, i) == fname {\n      out = Array::get(infos, i)\n      i = Array::length(names)\n    } else {\n      i = i + 1\n    }\n  }\n  out\n}\n\nexport fn find_local_slot(names: Array[String], name: String) -> Int {\n  let mut i = Array::length(names) - 1\n  let mut result = 0 - 1\n  while i >= 0 {\n    if Array::get(names, i) == name {\n      result = i\n      i = 0 - 1\n    } else {\n      i = i - 1\n    }\n  }\n  result\n}\n\nexport fn agg_info_of_ident(arr: Array[Int], e: Expr, local_names: Array[String]) -> Int {\n  match e {\n    EIdent(nm, _) => {\n      let slot = find_local_slot(local_names, nm)\n      if slot >= 0 {\n        agg_slot_lookup(arr, slot)\n      } else {\n        0 - 1\n      }\n    },\n    _ => 0 - 1\n  }\n}\n\nexport fn agg_expr_of_ident(arr: Array[Int], exprs: Array[Expr], e: Expr, local_names: Array[String]) -> Expr {\n  match e {\n    EIdent(nm, _) => {\n      let slot = find_local_slot(local_names, nm)\n      if slot >= 0 {\n        agg_expr_lookup(arr, exprs, slot)\n      } else {\n        EInt(0)\n      }\n    },\n    _ => EInt(0)\n  }\n}\n\nexport fn is_efn(expr: Expr) -> Bool {\n  match expr {\n    EFn(_, _, _, _, _, _) => true,\n    _ => false\n  }\n}\n\nexport fn is_pint(p: Pat) -> Bool {\n  match p {\n    PInt(_) => true,\n    _ => false\n  }\n}\n\nexport fn is_pfloat(p: Pat) -> Bool {\n  match p {\n    PFloat(_) => true,\n    _ => false\n  }\n}\n\nexport fn is_slet(stmt: Stmt) -> Bool {\n  match stmt {\n    SLet(_, _, _, _, _) => true,\n    _ => false\n  }\n}\n\nexport fn expr_tag(expr: Expr) -> Int {\n  match expr {\n    EInt(_) => 0,\n    EBool(_) => 1,\n    EFloat(_) => 2,\n    EString(_) => 3,\n    EIdent(_, _) => 4,\n    EBinOp(_, _, _) => 5,\n    EUnaryOp(_, _) => 6,\n    EIf(_, _, _) => 7,\n    ECall(_, _, _) => 8,\n    ELet(_, _, _, _) => 9,\n    ELetRec(_, _, _) => 10,\n    ELetMut(_, _, _, _) => 11,\n    EAssign(_, _, _) => 12,\n    EAssignOp(_, _, _, _) => 13,\n    ESeq(_, _) => 14,\n    ETuple(_) => 15,\n    EMatch(_, _) => 16,\n    EArray(_) => 17,\n    EForIn(_, _, _, _) => 18,\n    EWhile(_, _) => 19,\n    EBreak(_) => 20,\n    EContinue(_) => 21,\n    EUnit => 22,\n    EFn(_, _, _, _, _, _) => 24,\n    ELoop(_, _) => 25,\n    EReturn(_) => 26,\n    _ => -1\n  }\n}\n\nexport fn is_pbind(p: Pat) -> Bool {\n  match p {\n    PBind(_) => true,\n    _ => false\n  }\n}\n\nexport fn is_pbool(p: Pat) -> Bool {\n  match p {\n    PBool(_) => true,\n    _ => false\n  }\n}\n\nexport fn is_pctor(p: Pat) -> Bool {\n  match p {\n    PCtor(_, _) => true,\n    _ => false\n  }\n}\n\nexport fn is_pwild(p: Pat) -> Bool {\n  match p {\n    PWild => true,\n    _ => false\n  }\n}\n\nexport fn is_earray(expr: Expr) -> Bool {\n  match expr {\n    EArray(_) => true,\n    _ => false\n  }\n}\n\nexport fn is_eident(expr: Expr) -> Bool {\n  match expr {\n    EIdent(_, _) => true,\n    _ => false\n  }\n}\n\nexport fn is_etuple(expr: Expr) -> Bool {\n  match expr {\n    ETuple(_) => true,\n    _ => false\n  }\n}\n\nexport fn is_ptuple(p: Pat) -> Bool {\n  match p {\n    PTuple(_) => true,\n    _ => false\n  }\n}\n\nlet op_i32_eq = 70\n\nlet op_i32_ne = 71\n\nexport fn is_erecord(expr: Expr) -> Bool {\n  match expr {\n    ERecord(_, _, _) => true,\n    _ => false\n  }\n}\n\nexport fn is_pstring(p: Pat) -> Bool {\n  match p {\n    PString(_) => true,\n    _ => false\n  }\n}\n\nlet op_i32_eqz = 69\n\nlet op_i32_mul = 108\n\nlet op_i32_sub = 107\n\nexport fn emit_i32_eq(buf: Bytes) -> Unit {\n  bytebuf_push(buf, op_i32_eq)\n}\n\nexport fn emit_i32_ne(buf: Bytes) -> Unit {\n  bytebuf_push(buf, op_i32_ne)\n}\n\nexport fn get_arm_pat(arm: (Pat, Expr)) -> Pat {\n  let (p, _) = arm\n  p\n}\n\nexport fn lookup_ctor(ctor_names: Array[String], name: String, i: Int) -> Int {\n  if i >= Array::length(ctor_names) {\n    -1\n  }\n  else if Array::get(ctor_names, i) == name {\n    i\n  }\n  else lookup_ctor(ctor_names, name, i + 1)\n}\n\nexport fn ctor_sorted_index(names: Array[String]) -> (Array[String], Array[Int]) {\n  let perm = sort_perm_by_names(names)\n  (apply_perm_strings(names, perm), perm)\n}\n\nexport fn ctor_table_index_of(ct: CtorTable, name: String) -> Int {\n  if Array::length(ct.names_sorted) != Array::length(ct.names) {\n    lookup_ctor(ct.names, name, 0)\n  } else {\n    let slot = bsearch_leftmost(ct.names_sorted, name)\n    if slot < 0 {\n      -1\n    } else {\n      Array::get(ct.names_sorted_pos, slot)\n    }\n  }\n}\n\nexport fn ctor_field_is_float(ctx: CompileCtx, ctor_idx: Int, field_idx: Int) -> Bool {\n  let arr = ctx.ctor_float_fields\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(arr) {\n    let e = Array::get(arr, i)\n    if e / 64 == ctor_idx && e % 64 == field_idx {\n      found = true\n      i = Array::length(arr)\n    } else {\n      i = i + 1\n    }\n  }\n  found\n}\n\nexport fn struct_field_candidates(ct: CtorTable, field: String) -> Array[(Int, Int)] {\n  let out = array_empty()\n  let mut si = 0\n  while si < Array::length(ct.struct_names) {\n    let fnames = Array::get(ct.struct_field_names, si)\n    let mut fi = 0\n    while fi < Array::length(fnames) {\n      if Array::get(fnames, fi) == field {\n        let ci = ctor_table_index_of(ct, Array::get(ct.struct_names, si))\n        let tag = if ci >= 0 {\n          Array::get(ct.tags, ci)\n        } else {\n          -1\n        }\n        Array::push(out, (tag, fi))\n        fi = Array::length(fnames)\n      } else {\n        fi = fi + 1\n      }\n    }\n    si = si + 1\n  }\n  out\n}\n\nexport fn struct_field_dispatch_cases(cands: Array[(Int, Int)]) -> Array[(Int, Int)] {\n  let (_, idx0) = Array::get(cands, 0)\n  let out = array_empty()\n  let mut i = 1\n  while i < Array::length(cands) {\n    let (tag_i, idx_i) = Array::get(cands, i)\n    if idx_i != idx0 && tag_i >= 0 {\n      Array::push(out, (tag_i, idx_i))\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  out\n}\n\nexport fn struct_index_by_field_set(ct: CtorTable, lit_names: Array[String]) -> Int {\n  let mut si = 0\n  let mut found = -1\n  while si < Array::length(ct.struct_names) {\n    let fnames = Array::get(ct.struct_field_names, si)\n    if Array::length(fnames) == Array::length(lit_names) {\n      let mut all = true\n      let mut fi = 0\n      while fi < Array::length(fnames) {\n        let dn = Array::get(fnames, fi)\n        let mut present = false\n        let mut li = 0\n        while li < Array::length(lit_names) {\n          if Array::get(lit_names, li) == dn {\n            present = true\n            li = Array::length(lit_names)\n          } else {\n            li = li + 1\n          }\n        }\n        if present {\n          fi = fi + 1\n        } else {\n          all = false\n          fi = Array::length(fnames)\n        }\n      }\n      if all {\n        found = si\n        si = Array::length(ct.struct_names)\n      } else {\n        si = si + 1\n      }\n    } else {\n      si = si + 1\n    }\n  }\n  found\n}\n\nexport fn struct_tag_by_index(ct: CtorTable, si: Int) -> Int {\n  let ci = ctor_table_index_of(ct, Array::get(ct.struct_names, si))\n  if ci >= 0 {\n    Array::get(ct.tags, ci)\n  } else {\n    0\n  }\n}\n\nlet op_i32_ge_u = 79\n\nlet op_i32_gt_u = 75\n\nlet op_i64_load = 41\n\nexport fn emit_i32_eqz(buf: Bytes) -> Unit {\n  bytebuf_push(buf, op_i32_eqz)\n}\n\nexport fn emit_i32_mul(buf: Bytes) -> Unit {\n  bytebuf_push(buf, op_i32_mul)\n}\n\nexport fn emit_i32_sub(buf: Bytes) -> Unit {\n  bytebuf_push(buf, op_i32_sub)\n}\n\nexport fn emit_str_ref(buf: Bytes, offset: Int, length: Int) -> Unit {\n  emit_i64_const(buf, offset)\n  emit_i64_const(buf, 32)\n  emit_i64_shl(buf)\n  emit_i64_const(buf, length)\n  emit_i64_or(buf)\n}\n\nexport fn get_arm_body(arm: (Pat, Expr)) -> Expr {\n  let (_, b) = arm\n  b\n}\n\nexport fn get_efn_body(expr: Expr) -> Expr with { Error } {\n  match expr {\n    EFn(_, _, _, _, _, body) => body,\n    _ => throw(\"not EFn\")\n  }\n}\n\nexport fn get_eif_cond(expr: Expr) -> Expr with { Error } {\n  match expr {\n    EIf(c, _, _) => c,\n    _ => throw(\"not EIf\")\n  }\n}\n\nexport fn get_eif_else(expr: Expr) -> Expr with { Error } {\n  match expr {\n    EIf(_, _, e) => e,\n    _ => throw(\"not EIf\")\n  }\n}\n\nexport fn get_eif_then(expr: Expr) -> Expr with { Error } {\n  match expr {\n    EIf(_, t, _) => t,\n    _ => throw(\"not EIf\")\n  }\n}\n\nexport fn get_elet_val(expr: Expr) -> Expr with { Error } {\n  match expr {\n    ELet(_, val, _, _) => val,\n    _ => throw(\"not ELet\")\n  }\n}\n\nexport fn is_ctor_call(value: Expr, ct: CtorTable) -> Bool {\n  match value {\n    ECall(callee, _, _) => match callee {\n      EIdent(nm, _) => ctor_table_index_of(ct, nm) >= 0,\n      _ => false\n    },\n    _ => false\n  }\n}\n\nlet op_i64_store = 55\n\nexport fn func_table_index_of(ft: FuncTable, name: String) -> Int {\n  if Array::length(ft.names_sorted) != Array::length(ft.names) {\n    let len = Array::length(ft.names)\n    let mut i = 0\n    let mut found = -1\n    while i < len {\n      if Array::get(ft.names, i) == name {\n        found = i\n        i = len\n      } else {\n        i = i + 1\n      }\n    }\n    found\n  } else {\n    let slot = bsearch_leftmost(ft.names_sorted, name)\n    if slot < 0 {\n      -1\n    } else {\n      Array::get(ft.names_sorted_pos, slot)\n    }\n  }\n}\n\nexport fn resolve_func(ft: FuncTable, name: String) -> (Int, Int, Int) with { Error } {\n  let found = func_table_index_of(ft, name)\n  if found < 0 {\n    throw(String::concat(\"undefined function: \", name))\n  };\n  (Array::get(ft.indices, found), Array::get(ft.params, found), Array::get(ft.returns, found))\n}\n\nexport fn emit_binop_op(buf: Bytes, op: String) -> Unit with { Error } {\n  if op == \"+\" {\n    emit_i64_add(buf)\n  }\n  else if op == \"-\" {\n    emit_i64_sub(buf)\n  }\n  else if op == \"*\" {\n    emit_i64_mul(buf)\n  }\n  else if op == \"/\" {\n    emit_i64_div_s(buf)\n  }\n  else if op == \"%\" {\n    emit_i64_rem_s(buf)\n  }\n  else if op == \"&\" {\n    emit_i64_and(buf)\n  }\n  else if op == \"|\" {\n    emit_i64_or(buf)\n  }\n  else if op == \"^\" {\n    emit_i64_xor(buf)\n  }\n  else if op == \"<<\" {\n    emit_i64_shl(buf)\n  }\n  else if op == \">>\" {\n    emit_i64_shr_s(buf)\n  }\n  else if op == \"==\" {\n    emit_i64_eq(buf); emit_i64_extend_i32_s(buf)\n  }\n  else if op == \"!=\" {\n    emit_i64_ne(buf); emit_i64_extend_i32_s(buf)\n  }\n  else if op == \"<\" {\n    emit_i64_lt_s(buf); emit_i64_extend_i32_s(buf)\n  }\n  else if op == \">\" {\n    emit_i64_gt_s(buf); emit_i64_extend_i32_s(buf)\n  }\n  else if op == \"<=\" {\n    emit_i64_le_s(buf); emit_i64_extend_i32_s(buf)\n  }\n  else if op == \">=\" {\n    emit_i64_ge_s(buf); emit_i64_extend_i32_s(buf)\n  }\n  else if op == \"&&\" {\n    emit_i64_and(buf)\n  }\n  else if op == \"||\" {\n    emit_i64_or(buf)\n  }\n  else {\n    throw(String::concat(\"unsupported binop: \", op))\n  }\n}\n\nexport fn emit_i32_ge_u(buf: Bytes) -> Unit {\n  bytebuf_push(buf, op_i32_ge_u)\n}\n\nexport fn emit_i32_gt_u(buf: Bytes) -> Unit {\n  bytebuf_push(buf, op_i32_gt_u)\n}\n\nexport fn emit_i64_load(buf: Bytes, align: Int, offset: Int) -> Unit {\n  bytebuf_push(buf, op_i64_load)\n  leb128_encode_u32(buf, align)\n  leb128_encode_u32(buf, offset)\n}\n\nexport fn get_ebinop_op(expr: Expr) -> String with { Error } {\n  match expr {\n    EBinOp(op, _, _) => op,\n    _ => throw(\"not EBinOp\")\n  }\n}\n\nexport fn get_elet_body(expr: Expr) -> Expr with { Error } {\n  match expr {\n    ELet(_, _, body, _) => body,\n    _ => throw(\"not ELet\")\n  }\n}\n\nexport fn get_elet_off(expr: Expr) -> Int with { Error } {\n  match expr {\n    ELet(_, _, _, soff) => soff,\n    _ => throw(\"not ELet\")\n  }\n}\n\nexport fn get_eletmut_off(expr: Expr) -> Int with { Error } {\n  match expr {\n    ELetMut(_, _, _, soff) => soff,\n    _ => throw(\"not ELetMut\")\n  }\n}\n\nexport fn get_elet_name(expr: Expr) -> String with { Error } {\n  match expr {\n    ELet(name, _, _, _) => name,\n    _ => throw(\"not ELet\")\n  }\n}\n\nexport fn get_func_body(stmt: Stmt) -> Expr with { Error } {\n  match stmt {\n    SLet(_, _, _, _, expr) => match expr {\n      EFn(_, _, _, _, _, body) => body,\n      _ => throw(\"get_func_body: not a function\")\n    },\n    _ => throw(\"get_func_body: not a let statement\")\n  }\n}\n\nexport fn get_slet_expr(stmt: Stmt) -> Expr with { Error } {\n  match stmt {\n    SLet(_, _, _, _, expr) => expr,\n    _ => throw(\"not SLet\")\n  }\n}\n\nexport fn get_slet_name(stmt: Stmt) -> String with { Error } {\n  match stmt {\n    SLet(_, _, name, _, _) => name,\n    _ => throw(\"not SLet\")\n  }\n}\n\nexport fn get_slet_type(stmt: Stmt) -> Option[TypeExpr] {\n  match stmt {\n    SLet(_, _, _, ty, _) => ty,\n    _ => None\n  }\n}\n\nexport fn resolve_local(names: Array[String], name: String, tag: String) -> Int with { Error } {\n  let mut i = Array::length(names) - 1\n  let mut result = -1\n  while i >= 0 {\n    if Array::get(names, i) == name {\n      result = i\n      i = -1\n    } else {\n      i = i - 1\n    }\n  }\n  if result < 0 {\n    throw(String::concat(String::concat(\"undefined variable (local): \", name), String::concat(\" @\", tag)))\n  }\n  result\n}\n\nexport fn emit_i64_store(buf: Bytes, align: Int, offset: Int) -> Unit {\n  bytebuf_push(buf, op_i64_store)\n  leb128_encode_u32(buf, align)\n  leb128_encode_u32(buf, offset)\n}\n\nexport fn emit_box_float(buf: Bytes, ctx: CompileCtx, bits_local: Int, box_local: Int) -> Unit {\n  emit_local_set(buf, bits_local)\n  emit_i64_const(buf, 16)\n  emit_call(buf, ctx.rc_alloc_func_idx)\n  emit_local_set(buf, box_local)\n  emit_local_get(buf, box_local)\n  emit_i32_wrap_i64(buf)\n  emit_i32_const(buf, 16)\n  emit_i32_store(buf, 2, 0)\n  emit_local_get(buf, box_local)\n  emit_i32_wrap_i64(buf)\n  emit_i32_const(buf, 1)\n  emit_i32_store(buf, 2, 4)\n  emit_local_get(buf, box_local)\n  emit_i32_wrap_i64(buf)\n  emit_local_get(buf, bits_local)\n  emit_i64_store(buf, 3, 8)\n  emit_local_get(buf, box_local)\n  emit_i64_const(buf, 8)\n  emit_i64_add(buf)\n  emit_i64_const(buf, 1)\n  emit_i64_or(buf)\n}\n\nexport fn find_func_stmt(stmts: Array[Stmt], name: String) -> Stmt with { Error } {\n  let len = Array::length(stmts)\n  let mut i = 0\n  let mut found = -1\n  while i < len {\n    let stmt = Array::get(stmts, i)\n    match stmt {\n      SLet(_, _, sname, _, _) => if sname == name {\n        found = i\n        i = len\n      },\n      _ => ()\n    }\n    if found < 0 {\n      i = i + 1\n    }\n  }\n  if found < 0 {\n    throw(String::concat(\"function not found: \", name))\n  }\n  Array::get(stmts, found)\n}\n\nexport fn emit_unbox_float(buf: Bytes) -> Unit {\n  emit_i64_const(buf, -2)\n  emit_i64_and(buf)\n  emit_i32_wrap_i64(buf)\n  emit_i64_load(buf, 3, 0)\n}\n\nexport fn emit_index_one(buf: Bytes, ctx: CompileCtx) -> Unit {\n  if ctx.enable_rc {\n    emit_i64_const(buf, 2)\n  } else {\n    emit_i64_const(buf, 1)\n  }\n}\n\nexport fn rc_shadow_base() -> Int {\n  268435456\n}\n\nexport fn rc_shadow_reserve() -> Int {\n  536870912\n}\n\nexport fn emit_rc_word_inc_saturating(buf: Bytes, push_addr: () -> Unit) -> Unit {\n  push_addr()\n  emit_i32_load(buf, 2, 0)\n  emit_i32_const(buf, 16777215)\n  bytebuf_push(buf, 113)\n  emit_i32_const(buf, 16777215)\n  emit_i32_ne(buf)\n  emit_if_void(buf)\n  push_addr()\n  push_addr()\n  emit_i32_load(buf, 2, 0)\n  emit_i32_const(buf, 1)\n  emit_i32_add(buf)\n  emit_i32_store(buf, 2, 0)\n  emit_end(buf)\n}\n\nexport fn emit_rc_dup_guarded(buf: Bytes, local_idx: Int, rc_shadow: Bool) -> Unit {\n  emit_local_get(buf, local_idx)\n  emit_i64_const(buf, 1)\n  emit_i64_and(buf)\n  emit_i32_wrap_i64(buf)\n  emit_if_void(buf)\n  emit_local_get(buf, local_idx)\n  emit_i64_const(buf, 32)\n  emit_i64_shr_s(buf)\n  emit_i64_eqz(buf)\n  emit_if_void(buf)\n  if rc_shadow {\n    emit_local_get(buf, local_idx)\n    emit_i64_const(buf, -2)\n    emit_i64_and(buf)\n    emit_i32_wrap_i64(buf)\n    emit_i32_const(buf, rc_shadow_base())\n    emit_i32_add(buf)\n    emit_i32_load8_u(buf, 0, 0)\n    emit_if_void(buf)\n    bytebuf_push(buf, 0)\n    emit_end(buf)\n  } else {\n    ()\n  }\n  emit_rc_word_inc_saturating(buf, () -> {\n    emit_local_get(buf, local_idx)\n    emit_i64_const(buf, -2)\n    emit_i64_and(buf)\n    emit_i32_wrap_i64(buf)\n    emit_i32_const(buf, 4)\n    emit_i32_sub(buf)\n  })\n  emit_end(buf)\n  emit_end(buf)\n}\n\nexport fn fn_type_param_types(ty: Option[TypeExpr]) -> Option[Array[TypeExpr]] {\n  match ty {\n    Some(t) =>\n    match t {\n      TyFn(args, _, _) => Some(args),\n      _ => None\n    },\n    None => None\n  }\n}\n\nexport fn is_nullary_ctor_ident(value: Expr, ct: CtorTable) -> Bool {\n  match value {\n    EIdent(nm, _) => ctor_table_index_of(ct, nm) >= 0,\n    _ => false\n  }\n}\n\nexport fn name_has_effect_prefix(full: String, eff: String) -> Bool {\n  let el = String::length(eff)\n  let fl = String::length(full)\n  if fl < el + 2 {\n    false\n  } else {\n    let mut ok = true\n    let mut j = 0\n    while j < el {\n      if String::char_code_at(full, j) != String::char_code_at(eff, j) {\n        ok = false\n        j = el\n      } else {\n        j = j + 1\n      }\n    }\n    ok && String::char_code_at(full, el) == 58 && String::char_code_at(full, el + 1) == 58\n  }\n}\n\nexport fn effect_name_to_tag(effect_names: Array[String], full: String) -> Int {\n  let n = Array::length(effect_names)\n  let mut result = 3 + n\n  let mut i = 0\n  while i < n {\n    if name_has_effect_prefix(full, Array::get(effect_names, i)) {\n      result = 3 + i\n      i = n\n    } else {\n      i = i + 1\n    }\n  }\n  result\n}\n\nexport fn effect_op_declared_arity(keys: Array[String], arities: Array[Int], full: String) -> Int {\n  let n = Array::length(keys)\n  let mut result = -1\n  let mut i = 0\n  while i < n {\n    if Array::get(keys, i) == full {\n      result = Array::get(arities, i)\n      i = n\n    } else {\n      i = i + 1\n    }\n  }\n  result\n}\n\nexport fn effect_op_index(keys: Array[String], full: String) -> Int {\n  let n = Array::length(keys)\n  let mut result = 0 - 1\n  let mut i = 0\n  while i < n {\n    if Array::get(keys, i) == full {\n      result = i\n      i = n\n    } else {\n      i = i + 1\n    }\n  }\n  result\n}\n\nexport fn emit_heap_grow_after_heap_set(buf: Bytes, ctx: CompileCtx) -> Unit {\n  if ctx.heap_grow_check_func_idx >= 0 {\n    emit_call(buf, ctx.heap_grow_check_func_idx)\n  } else {\n    ()\n  }\n}\n")
}

let source_81 = () -> (String, String) {
  ("lib/@vibe/compiler/codegen/common_extractors/index.vpkg",
"name = @vibe/compiler/codegen/common_extractors\nversion = 0.0.1\ndescription =\n  #|@vibe/compiler/codegen/common_extractors — bodyless AST field extractors\ndeps = {\n  @vibe/compiler/codegen/wasm_emit : 0.0.1\n  @vibe/compiler/core : 0.0.1\n  @vibe/core : 0.2.0\n}\n\ngenerated_hash =\n\n// @vibe/compiler/codegen/common_extractors — bodyless AST field extractors\n// (get_e*/get_p* accessors) plus a handful of small string/offset/array\n// helpers shared across codegen (ADR-0070 Phase 3, #897, compiler-internal\n// batch). Compiled into the compiler itself via\n// compiler_sources_manifest.tsv (group `codegen`, dual-row: this contract +\n// common_extractors.vibe).\n//\n// The old index.vibe was not a facade but the whole implementation (the\n// package is single-file), so it moved verbatim to common_extractors.vibe.\n// No exported types: every struct/enum this package touches (Expr/Pat/Stmt/\n// TypeExpr from ../../core) is structural signature text resolved against\n// the implementation import when the facade is merged in (normalize/perceus\n// precedent — no re-import needed here). No `version` binding existed\n// (compiler-internal package).\n\nfn first_offset(e: Expr) -> Int\nfn offset_to_line(nl: Array[Int], off: Int) -> Int\nfn build_newline_offsets(src: String) -> Array[Int]\nfn get_ebinop_lhs(expr: Expr) -> Expr with { Error }\nfn get_ebinop_rhs(expr: Expr) -> Expr with { Error }\nfn get_ecall_args(expr: Expr) -> Array[Expr] with { Error }\nfn get_efn_params(expr: Expr) -> Array[(String, Option[TypeExpr])] with { Error }\nfn get_eint_value(expr: Expr) -> Int with { Error }\nfn get_eseq_first(expr: Expr) -> Expr with { Error }\nfn get_match_arms(expr: Expr) -> Array[(Pat, Expr)] with { Error }\nfn get_pbind_name(p: Pat) -> String with { Error }\nfn get_pctor_args(p: Pat) -> Array[Pat] with { Error }\nfn get_pctor_name(p: Pat) -> String with { Error }\nfn get_pint_value(p: Pat) -> Int with { Error }\nfn get_pfloat_value(p: Pat) -> Double with { Error }\nfn get_eassign_val(expr: Expr) -> Expr with { Error }\nfn get_ebool_value(expr: Expr) -> Bool with { Error }\nfn get_eforin_body(expr: Expr) -> Expr with { Error }\nfn get_eforin_iter(expr: Expr) -> Expr with { Error }\nfn get_eforin_name(expr: Expr) -> String with { Error }\nfn get_eforin_index(expr: Expr) -> Option[String] with { Error }\nfn get_eident_name(expr: Expr) -> String with { Error }\nfn get_eletmut_val(expr: Expr) -> Expr with { Error }\nfn get_eletrec_val(expr: Expr) -> Expr with { Error }\nfn get_eseq_second(expr: Expr) -> Expr with { Error }\nfn get_ereturn_expr(expr: Expr) -> Expr with { Error }\nfn get_eunaryop_op(expr: Expr) -> String with { Error }\nfn get_ewhile_body(expr: Expr) -> Expr with { Error }\nfn get_ewhile_cond(expr: Expr) -> Expr with { Error }\nfn get_pbool_value(p: Pat) -> Bool with { Error }\nfn get_ptuple_pats(p: Pat) -> Array[Pat] with { Error }\nfn get_slet_export(stmt: Stmt) -> Bool with { Error }\nfn is_catchall_pat(p: Pat) -> Bool\nfn emit_assignop_op(buf: Bytes, op: String) -> Unit with { Error }\nfn emit_memory_copy(buf: Bytes) -> Unit\nfn emit_memory_fill(buf: Bytes) -> Unit\nfn get_earray_elems(expr: Expr) -> Array[Expr] with { Error }\nfn get_eassign_body(expr: Expr) -> Expr with { Error }\nfn get_eassign_name(expr: Expr) -> String with { Error }\nfn get_eassignop_op(expr: Expr) -> String with { Error }\nfn get_ecall_callee(expr: Expr) -> Expr with { Error }\nfn get_efloat_value(expr: Expr) -> Double with { Error }\nfn get_eletmut_body(expr: Expr) -> Expr with { Error }\nfn get_eletmut_name(expr: Expr) -> String with { Error }\nfn get_eletrec_body(expr: Expr) -> Expr with { Error }\nfn get_eletrec_name(expr: Expr) -> String with { Error }\nfn get_etuple_elems(expr: Expr) -> Array[Expr] with { Error }\nfn str_table_lookup(strs: Array[String], s: String) -> Int with { Error }\nfn find_catchall_idx(arms: Array[(Pat, Expr)]) -> Int\nfn get_eassignop_val(expr: Expr) -> Expr with { Error }\nfn get_estring_value(expr: Expr) -> String with { Error }\nfn get_eunaryop_expr(expr: Expr) -> Expr with { Error }\nfn get_pstring_value(p: Pat) -> String with { Error }\nfn array_contains_str(arr: Array[String], s: String) -> Bool\nfn array_contains_int(arr: Array[Int], v: Int) -> Bool\nfn get_eassignop_body(expr: Expr) -> Expr with { Error }\nfn get_eassignop_name(expr: Expr) -> String with { Error }\nfn get_match_scrutinee(expr: Expr) -> Expr with { Error }\n")
}

let source_82 = () -> (String, String) {
  ("lib/@vibe/compiler/codegen/common_extractors/common_extractors.vibe",
"\nimport @vibe/compiler/core {\n  Expr, Pat, Stmt, TypeExpr, bytebuf_push, leb128_encode_u32\n}\n\nimport @vibe/core {\n  array_empty\n}\n\nimport @vibe/compiler/codegen/wasm_emit {\n  emit_i64_add, emit_i64_div_s, emit_i64_mul, emit_i64_rem_s, emit_i64_sub\n}\n\nlet op_prefix = 252\n\n\nexport fn first_offset(e: Expr) -> Int {\n  match e {\n    EIdent(_, off) => off,\n    ECall(callee, _, off) => if off >= 0 {\n      off\n    } else {\n      first_offset(callee)\n    },\n    EDot(base, _, off, _) => if off >= 0 {\n      off\n    } else {\n      first_offset(base)\n    },\n    EBinOp(_, lhs, _) => first_offset(lhs),\n    EUnaryOp(_, inner) => first_offset(inner),\n    ELet(_, val, _, _) => first_offset(val),\n    ELetRec(_, val, _) => first_offset(val),\n    ELetMut(_, val, _, _) => first_offset(val),\n    EAssign(_, val, _) => first_offset(val),\n    EAssignOp(_, _, val, _) => first_offset(val),\n    ESeq(first, _) => first_offset(first),\n    EIf(cond, _, _) => first_offset(cond),\n    EMatch(scrut, _) => first_offset(scrut),\n    EReturn(inner) => first_offset(inner),\n    _ => -1\n  }\n}\n\nexport fn offset_to_line(nl: Array[Int], off: Int) -> Int {\n  let n = Array::length(nl)\n  let mut i = 0\n  let mut count = 0\n  while i < n {\n    if Array::get(nl, i) < off {\n      count = count + 1\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  count + 1\n}\n\nexport fn build_newline_offsets(src: String) -> Array[Int] {\n  let arr = array_empty()\n  let n = String::length(src)\n  let mut i = 0\n  while i < n {\n    if String::char_code_at(src, i) == 10 {\n      Array::push(arr, i)\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  arr\n}\n\nexport fn get_ebinop_lhs(expr: Expr) -> Expr with { Error } {\n  match expr {\n    EBinOp(_, lhs, _) => lhs,\n    _ => throw(\"not EBinOp\")\n  }\n}\n\nexport fn get_ebinop_rhs(expr: Expr) -> Expr with { Error } {\n  match expr {\n    EBinOp(_, _, rhs) => rhs,\n    _ => throw(\"not EBinOp\")\n  }\n}\n\nexport fn get_ecall_args(expr: Expr) -> Array[Expr] with { Error } {\n  match expr {\n    ECall(_, args, _) => args,\n    _ => throw(\"not ECall\")\n  }\n}\n\nexport fn get_efn_params(expr: Expr) -> Array[(String, Option[TypeExpr])] with { Error } {\n  match expr {\n    EFn(_, _, params, _, _, _) => params,\n    _ => throw(\"not EFn\")\n  }\n}\n\nexport fn get_eint_value(expr: Expr) -> Int with { Error } {\n  match expr {\n    EInt(n) => n,\n    _ => throw(\"not EInt\")\n  }\n}\n\nexport fn get_eseq_first(expr: Expr) -> Expr with { Error } {\n  match expr {\n    ESeq(first, _) => first,\n    _ => throw(\"not ESeq\")\n  }\n}\n\nexport fn get_match_arms(expr: Expr) -> Array[(Pat, Expr)] with { Error } {\n  match expr {\n    EMatch(_, arms) => arms,\n    _ => throw(\"get_match_arms: not an EMatch\")\n  }\n}\n\nexport fn get_pbind_name(p: Pat) -> String with { Error } {\n  match p {\n    PBind(name) => name,\n    _ => throw(\"get_pbind_name: not a PBind\")\n  }\n}\n\nexport fn get_pctor_args(p: Pat) -> Array[Pat] with { Error } {\n  match p {\n    PCtor(_, args) => args,\n    _ => throw(\"get_pctor_args: not a PCtor\")\n  }\n}\n\nexport fn get_pctor_name(p: Pat) -> String with { Error } {\n  match p {\n    PCtor(name, _) => name,\n    _ => throw(\"get_pctor_name: not a PCtor\")\n  }\n}\n\nexport fn get_pint_value(p: Pat) -> Int with { Error } {\n  match p {\n    PInt(n) => n,\n    _ => throw(\"get_pint_value: not a PInt\")\n  }\n}\n\nexport fn get_pfloat_value(p: Pat) -> Double with { Error } {\n  match p {\n    PFloat(v) => v,\n    _ => throw(\"get_pfloat_value: not a PFloat\")\n  }\n}\n\nexport fn get_eassign_val(expr: Expr) -> Expr with { Error } {\n  match expr {\n    EAssign(_, val, _) => val,\n    _ => throw(\"not EAssign\")\n  }\n}\n\nexport fn get_ebool_value(expr: Expr) -> Bool with { Error } {\n  match expr {\n    EBool(b) => b,\n    _ => throw(\"not EBool\")\n  }\n}\n\nexport fn get_eforin_body(expr: Expr) -> Expr with { Error } {\n  match expr {\n    EForIn(_, _, _, body) => body,\n    _ => throw(\"not EForIn\")\n  }\n}\n\nexport fn get_eforin_iter(expr: Expr) -> Expr with { Error } {\n  match expr {\n    EForIn(_, _, iter, _) => iter,\n    _ => throw(\"not EForIn\")\n  }\n}\n\nexport fn get_eforin_name(expr: Expr) -> String with { Error } {\n  match expr {\n    EForIn(name, _, _, _) => name,\n    _ => throw(\"not EForIn\")\n  }\n}\n\nexport fn get_eforin_index(expr: Expr) -> Option[String] with { Error } {\n  match expr {\n    EForIn(_, index_name, _, _) => index_name,\n    _ => throw(\"not EForIn\")\n  }\n}\n\nexport fn get_eident_name(expr: Expr) -> String with { Error } {\n  match expr {\n    EIdent(name, _) => name,\n    _ => throw(\"not EIdent\")\n  }\n}\n\nexport fn get_eletmut_val(expr: Expr) -> Expr with { Error } {\n  match expr {\n    ELetMut(_, val, _, _) => val,\n    _ => throw(\"not ELetMut\")\n  }\n}\n\nexport fn get_eletrec_val(expr: Expr) -> Expr with { Error } {\n  match expr {\n    ELetRec(_, val, _) => val,\n    _ => throw(\"not ELetRec\")\n  }\n}\n\nexport fn get_eseq_second(expr: Expr) -> Expr with { Error } {\n  match expr {\n    ESeq(_, second) => second,\n    _ => throw(\"not ESeq\")\n  }\n}\n\nexport fn get_ereturn_expr(expr: Expr) -> Expr with { Error } {\n  match expr {\n    EReturn(e) => e,\n    _ => throw(\"not EReturn\")\n  }\n}\n\nexport fn get_eunaryop_op(expr: Expr) -> String with { Error } {\n  match expr {\n    EUnaryOp(op, _) => op,\n    _ => throw(\"not EUnaryOp\")\n  }\n}\n\nexport fn get_ewhile_body(expr: Expr) -> Expr with { Error } {\n  match expr {\n    EWhile(_, body) => body,\n    _ => throw(\"not EWhile\")\n  }\n}\n\nexport fn get_ewhile_cond(expr: Expr) -> Expr with { Error } {\n  match expr {\n    EWhile(cond, _) => cond,\n    _ => throw(\"not EWhile\")\n  }\n}\n\nexport fn get_pbool_value(p: Pat) -> Bool with { Error } {\n  match p {\n    PBool(v) => v,\n    _ => throw(\"get_pbool_value: not a PBool\")\n  }\n}\n\nexport fn get_ptuple_pats(p: Pat) -> Array[Pat] with { Error } {\n  match p {\n    PTuple(pats) => pats,\n    _ => throw(\"get_ptuple_pats: not a PTuple\")\n  }\n}\n\nexport fn get_slet_export(stmt: Stmt) -> Bool with { Error } {\n  match stmt {\n    SLet(is_export, _, _, _, _) => is_export,\n    _ => throw(\"not SLet\")\n  }\n}\n\nexport fn is_catchall_pat(p: Pat) -> Bool {\n  match p {\n    PWild => true,\n    PBind(_) => true,\n    PTuple(pats) => {\n      let mut i = 0\n      let mut all_catch = true\n      while i < Array::length(pats) {\n        if !is_catchall_pat(Array::get(pats, i)) {\n          all_catch = false\n        }\n        i = i + 1\n      }\n      all_catch\n    },\n    PStruct(_, fields) => {\n      let mut i = 0\n      let mut all_catch = true\n      while i < Array::length(fields) {\n        let (_, sp) = Array::get(fields, i)\n        if !is_catchall_pat(sp) {\n          all_catch = false\n        }\n        i = i + 1\n      }\n      all_catch\n    },\n    _ => false\n  }\n}\n\nexport fn emit_assignop_op(buf: Bytes, op: String) -> Unit with { Error } {\n  if op == \"+\" {\n    emit_i64_add(buf)\n  }\n  else if op == \"-\" {\n    emit_i64_sub(buf)\n  }\n  else if op == \"*\" {\n    emit_i64_mul(buf)\n  }\n  else if op == \"/\" {\n    emit_i64_div_s(buf)\n  }\n  else if op == \"%\" {\n    emit_i64_rem_s(buf)\n  }\n  else {\n    throw(String::concat(\"unsupported assign op: \", op))\n  }\n}\n\nexport fn emit_memory_copy(buf: Bytes) -> Unit {\n  bytebuf_push(buf, op_prefix)\n  leb128_encode_u32(buf, 10)\n  bytebuf_push(buf, 0)\n  bytebuf_push(buf, 0)\n}\n\nexport fn emit_memory_fill(buf: Bytes) -> Unit {\n  bytebuf_push(buf, op_prefix)\n  leb128_encode_u32(buf, 11)\n  bytebuf_push(buf, 0)\n}\n\nexport fn get_earray_elems(expr: Expr) -> Array[Expr] with { Error } {\n  match expr {\n    EArray(elems) => elems,\n    _ => throw(\"not EArray\")\n  }\n}\n\nexport fn get_eassign_body(expr: Expr) -> Expr with { Error } {\n  match expr {\n    EAssign(_, _, body) => body,\n    _ => throw(\"not EAssign\")\n  }\n}\n\nexport fn get_eassign_name(expr: Expr) -> String with { Error } {\n  match expr {\n    EAssign(name, _, _) => name,\n    _ => throw(\"not EAssign\")\n  }\n}\n\nexport fn get_eassignop_op(expr: Expr) -> String with { Error } {\n  match expr {\n    EAssignOp(_, op, _, _) => op,\n    _ => throw(\"not EAssignOp\")\n  }\n}\n\nexport fn get_ecall_callee(expr: Expr) -> Expr with { Error } {\n  match expr {\n    ECall(callee, _, _) => callee,\n    _ => throw(\"not ECall\")\n  }\n}\n\nexport fn get_efloat_value(expr: Expr) -> Double with { Error } {\n  match expr {\n    EFloat(v) => v,\n    _ => throw(\"not EFloat\")\n  }\n}\n\nexport fn get_eletmut_body(expr: Expr) -> Expr with { Error } {\n  match expr {\n    ELetMut(_, _, body, _) => body,\n    _ => throw(\"not ELetMut\")\n  }\n}\n\nexport fn get_eletmut_name(expr: Expr) -> String with { Error } {\n  match expr {\n    ELetMut(name, _, _, _) => name,\n    _ => throw(\"not ELetMut\")\n  }\n}\n\nexport fn get_eletrec_body(expr: Expr) -> Expr with { Error } {\n  match expr {\n    ELetRec(_, _, body) => body,\n    _ => throw(\"not ELetRec\")\n  }\n}\n\nexport fn get_eletrec_name(expr: Expr) -> String with { Error } {\n  match expr {\n    ELetRec(name, _, _) => name,\n    _ => throw(\"not ELetRec\")\n  }\n}\n\nexport fn get_etuple_elems(expr: Expr) -> Array[Expr] with { Error } {\n  match expr {\n    ETuple(elems) => elems,\n    _ => throw(\"get_etuple_elems: not an ETuple\")\n  }\n}\n\nexport fn str_table_lookup(strs: Array[String], s: String) -> Int with { Error } {\n  let len = Array::length(strs)\n  let mut i = 0\n  let mut found = -1\n  while i < len {\n    if Array::get(strs, i) == s {\n      found = i\n      i = len\n    } else {\n      i = i + 1\n    }\n  }\n  if found < 0 {\n    throw(String::concat(\"string not in table: \", s))\n  }\n  found\n}\n\nexport fn find_catchall_idx(arms: Array[(Pat, Expr)]) -> Int {\n  let num = Array::length(arms)\n  let mut idx = 0\n  let mut result = num\n  while idx < num {\n    let (p, _) = Array::get(arms, idx)\n    if is_catchall_pat(p) {\n      result = idx\n      idx = num\n    } else {\n      idx = idx + 1\n    }\n  }\n  result\n}\n\nexport fn get_eassignop_val(expr: Expr) -> Expr with { Error } {\n  match expr {\n    EAssignOp(_, _, val, _) => val,\n    _ => throw(\"not EAssignOp\")\n  }\n}\n\nexport fn get_estring_value(expr: Expr) -> String with { Error } {\n  match expr {\n    EString(s) => s,\n    _ => throw(\"not EString\")\n  }\n}\n\nexport fn get_eunaryop_expr(expr: Expr) -> Expr with { Error } {\n  match expr {\n    EUnaryOp(_, e) => e,\n    _ => throw(\"not EUnaryOp\")\n  }\n}\n\nexport fn get_pstring_value(p: Pat) -> String with { Error } {\n  match p {\n    PString(s) => s,\n    _ => throw(\"get_pstring_value: not a PString\")\n  }\n}\n\nexport fn array_contains_str(arr: Array[String], s: String) -> Bool {\n  let len = Array::length(arr)\n  let mut i = 0\n  let mut found = false\n  while i < len {\n    if Array::get(arr, i) == s {\n      found = true\n      i = len\n    } else {\n      i = i + 1\n    }\n  }\n  found\n}\n\nexport fn array_contains_int(arr: Array[Int], v: Int) -> Bool {\n  let len = Array::length(arr)\n  let mut i = 0\n  let mut found = false\n  while i < len {\n    if Array::get(arr, i) == v {\n      found = true\n      i = len\n    } else {\n      i = i + 1\n    }\n  }\n  found\n}\n\nexport fn get_eassignop_body(expr: Expr) -> Expr with { Error } {\n  match expr {\n    EAssignOp(_, _, _, body) => body,\n    _ => throw(\"not EAssignOp\")\n  }\n}\n\nexport fn get_eassignop_name(expr: Expr) -> String with { Error } {\n  match expr {\n    EAssignOp(name, _, _, _) => name,\n    _ => throw(\"not EAssignOp\")\n  }\n}\n\nexport fn get_match_scrutinee(expr: Expr) -> Expr with { Error } {\n  match expr {\n    EMatch(scrutinee, _) => scrutinee,\n    _ => throw(\"get_match_scrutinee: not an EMatch\")\n  }\n}\n")
}

let source_83 = () -> (String, String) {
  ("lib/@vibe/compiler/codegen/common_analysis/index.vpkg",
"name = @vibe/compiler/codegen/common_analysis\nversion = 0.0.1\ndescription =\n  #|@vibe/compiler/codegen/common_analysis — free-variable / string-literal /\ndeps = {\n  @vibe/compiler/codegen/common_extractors : 0.0.1\n  @vibe/compiler/codegen/wasm_emit : 0.0.1\n  @vibe/compiler/core : 0.0.1\n  @vibe/core : 0.2.0\n}\n\ngenerated_hash =\n\n// @vibe/compiler/codegen/common_analysis — free-variable / string-literal /\n// exception-reachability AST analyses shared across codegen, plus a few\n// low-level Perceus-adjacent codegen emit helpers (ADR-0070 Phase 3, #897,\n// compiler-internal batch). Compiled into the compiler itself via\n// compiler_sources_manifest.tsv (group `codegen`, dual-row: this contract +\n// common_analysis.vibe).\n//\n// The old index.vibe was not a facade but the whole implementation (the\n// package is single-file), so it moved verbatim to common_analysis.vibe. No\n// exported types: every struct/enum this package touches (Expr/Pat/Stmt from\n// ../../core) is structural signature text resolved against the\n// implementation import when the facade is merged in (normalize/perceus\n// precedent — no re-import needed here). No `version` binding existed\n// (compiler-internal package).\n\nfn collect_strings_expr(expr: Expr, out: Array[String]) -> Int\nfn get_func_param_names(stmt: Stmt) -> Array[String] with { Error }\nfn expr_contains_exceptions(expr: Expr) -> Bool\nfn stmts_contain_exceptions(stmts: Array[Stmt]) -> Bool\nfn collect_strings_stmts(stmts: Array[Stmt]) -> Array[String]\nfn emit_i64_extend_i32_u(buf: Bytes) -> Unit\nfn emit_closure_resolve(buf: Bytes, fn_val_local: Int, slot_local: Int, env_local: Int) -> Unit\nfn emit_closure_call_tail(buf: Bytes, env_local: Int, slot_local: Int, closure_type_base: Int, num_args: Int) -> Unit\nfn collect_free_vars_expr(expr: Expr, bound: Array[String], fn_names: Array[String], out: Array[String]) -> Int\nfn collect_free_vars(body: Expr, param_names: Array[String], fn_names: Array[String]) -> Array[String]\nfn collect_free_vars_indexed(body: Expr, param_names: Array[String], fn_name_index: Array[String]) -> Array[String]\nfn collect_free_vars_used_builtins(body: Expr, param_names: Array[String], fn_name_index: Array[String]) -> Array[String]\nfn collect_free_vars_indexed_self(body: Expr, param_names: Array[String], fn_name_index: Array[String], self_name: String, encl: Array[String]) -> Array[String]\nfn proj_root_ident(e: Expr) -> String\nfn scope_tail_proj_root(e: Expr) -> String\nfn is_mut_captured_in(expr: Expr, name: String) -> Bool\nfn mut_needs_ref_cell(body: Expr, name: String) -> Bool\nfn md_is_borrow_arg0_call(f: String) -> Bool\nfn md_consume_count(e: Expr, name: String) -> Int\nfn md_consume_count_b(e: Expr, name: String, bfns: Array[String], bmasks: Array[Int]) -> Int\nfn md_shadow_zeroed_bmasks(e: Expr, bfns: Array[String], bmasks: Array[Int]) -> Array[Int]\nfn md_consume_count_pre(e: Expr, name: String, bfns: Array[String], bmasks_zeroed: Array[Int]) -> Int\nfn zero_alloc_check(stmts: Array[Stmt]) -> String\nfn compute_borrow_param_user_fns(stmts: Array[Stmt], exclude: Array[String], out_masks: Array[Int]) -> Array[String]\nfn bmask_max_param() -> Int\nfn bmask_has(mask: Int, i: Int) -> Bool\nfn compute_may_return_view_fns(stmts: Array[Stmt]) -> Array[String]\nfn count_lambda_sites_expr(expr: Expr) -> Int\n")
}

let source_84 = () -> (String, String) {
  ("lib/@vibe/compiler/codegen/common_analysis/common_analysis.vibe",
"\nimport @vibe/compiler/core {\n  Expr, Pat, Stmt, TypeExpr, bsearch_leftmost, bytebuf_push, is_exception_throw_operation, sorted_names_of\n}\n\nimport @vibe/core {\n  type HashMap, type HashSet, HashMap::get, HashMap::new_string, HashMap::set, HashSet::add, HashSet::has, HashSet::new_string, array_empty\n}\n\nimport @vibe/compiler/codegen/common_extractors {\n  array_contains_str\n}\n\nimport @vibe/compiler/codegen/wasm_emit {\n  emit_call_indirect,\n  emit_else,\n  emit_end,\n  emit_i32_load,\n  emit_i32_wrap_i64,\n  emit_i64_and,\n  emit_i64_const,\n  emit_i64_eq,\n  emit_i64_or,\n  emit_i64_shl,\n  emit_i64_shr_s,\n  emit_if_void,\n  emit_local_get,\n  emit_local_set\n}\n\nlet op_i64_extend_i32_u = 173\n\n\nfn common_analysis_fresh_string_array() -> Array[String] {\n  ArrayBuilder::freeze(ArrayBuilder::new())\n}\n\nfn collect_strings_pat(pat: Pat, out: Array[String]) -> Int {\n  match pat {\n    PString(s) => {\n      let mut pf = false\n      let mut pi = 0\n      while pi < Array::length(out) {\n        if Array::get(out, pi) == s {\n          pf = true\n        }\n        pi = pi + 1\n      }\n      if !pf {\n        Array::push(out, s)\n      }\n      0\n    },\n    PCtor(_, args) => {\n      let mut i = 0\n      while i < Array::length(args) {\n        let _ = collect_strings_pat(Array::get(args, i), out)\n        i = i + 1\n      }\n      0\n    },\n    PTuple(pats) => {\n      let mut i = 0\n      while i < Array::length(pats) {\n        let _ = collect_strings_pat(Array::get(pats, i), out)\n        i = i + 1\n      }\n      0\n    },\n    POr(l, r) => {\n      let _ = collect_strings_pat(l, out)\n      let _ = collect_strings_pat(r, out)\n      0\n    },\n    PStruct(_, fields) => {\n      let mut i = 0\n      while i < Array::length(fields) {\n        let (_, fp) = Array::get(fields, i)\n        let _ = collect_strings_pat(fp, out)\n        i = i + 1\n      }\n      0\n    },\n    _ => 0\n  }\n}\n\nexport fn collect_strings_expr(expr: Expr, out: Array[String]) -> Int {\n  match expr {\n    EString(s) => {\n      let mut found = false\n      let mut i = 0\n      while i < Array::length(out) {\n        if Array::get(out, i) == s {\n          found = true\n        }\n        i = i + 1\n      }\n      if !found {\n        Array::push(out, s)\n      }\n      0\n    },\n    EBinOp(_, lhs, rhs) => {\n      collect_strings_expr(lhs, out)\n      collect_strings_expr(rhs, out)\n    },\n    EUnaryOp(_, operand) => collect_strings_expr(operand, out),\n    EIf(cond, then_e, else_e) => {\n      collect_strings_expr(cond, out)\n      collect_strings_expr(then_e, out)\n      collect_strings_expr(else_e, out)\n    },\n    ECall(callee, args, _) => {\n      collect_strings_expr(callee, out)\n      match callee {\n        EIdent(nm, _) => if nm == \"__to_string\" {\n          collect_strings_expr(EString(\"true\"), out)\n          collect_strings_expr(EString(\"false\"), out)\n        } else {\n          0\n        },\n        _ => 0\n      }\n      let mut i = 0\n      while i < Array::length(args) {\n        collect_strings_expr(Array::get(args, i), out)\n        i = i + 1\n      }\n      0\n    },\n    ELet(_, value, body, _) => {\n      collect_strings_expr(value, out)\n      collect_strings_expr(body, out)\n    },\n    ELetRec(_, value, body) => {\n      collect_strings_expr(value, out)\n      collect_strings_expr(body, out)\n    },\n    ELetMut(_, value, body, _) => {\n      collect_strings_expr(value, out)\n      collect_strings_expr(body, out)\n    },\n    EAssign(_, value, body) => {\n      collect_strings_expr(value, out)\n      collect_strings_expr(body, out)\n    },\n    EAssignOp(_, _, value, body) => {\n      collect_strings_expr(value, out)\n      collect_strings_expr(body, out)\n    },\n    ESeq(first, second) => {\n      collect_strings_expr(first, out)\n      collect_strings_expr(second, out)\n    },\n    EWhile(cond, body) => {\n      collect_strings_expr(cond, out)\n      collect_strings_expr(body, out)\n    },\n    EForIn(_, _, iter_e, body) => {\n      collect_strings_expr(iter_e, out)\n      collect_strings_expr(body, out)\n    },\n    ETuple(elems) => {\n      let mut i = 0\n      while i < Array::length(elems) {\n        collect_strings_expr(Array::get(elems, i), out)\n        i = i + 1\n      }\n      0\n    },\n    EArray(elems) => {\n      let mut i = 0\n      while i < Array::length(elems) {\n        collect_strings_expr(Array::get(elems, i), out)\n        i = i + 1\n      }\n      0\n    },\n    EMatch(scrutinee, arms) => {\n      collect_strings_expr(scrutinee, out)\n      let mut i = 0\n      while i < Array::length(arms) {\n        let (pat, arm_expr) = Array::get(arms, i)\n        let _ = collect_strings_pat(pat, out)\n        collect_strings_expr(arm_expr, out)\n        i = i + 1\n      }\n      0\n    },\n    EFn(_, _, _, _, _, body) => collect_strings_expr(body, out),\n    EReturn(msg) => collect_strings_expr(msg, out),\n    EStringInterp(parts) => {\n      let mut si_p = 0\n      while si_p < Array::length(parts) {\n        if si_p % 2 == 0 {\n          let part = Array::get(parts, si_p)\n          if String::length(part) > 0 {\n            let mut found = false\n            let mut fi2 = 0\n            while fi2 < Array::length(out) {\n              if Array::get(out, fi2) == part {\n                found = true\n              }\n              fi2 = fi2 + 1\n            }\n            if !found {\n              Array::push(out, part)\n            }\n          }\n        }\n        si_p = si_p + 1\n      }\n      0\n    },\n    EHandle(body, arms) => {\n      collect_strings_expr(body, out)\n      let mut hi = 0\n      while hi < Array::length(arms) {\n        let (_, arm_expr) = Array::get(arms, hi)\n        collect_strings_expr(arm_expr, out)\n        hi = hi + 1\n      }\n      0\n    },\n    EMap(fields) => {\n      let mut mi = 0\n      while mi < Array::length(fields) {\n        let (key, val) = Array::get(fields, mi)\n        let mut kf = false\n        let mut ki = 0\n        while ki < Array::length(out) {\n          if Array::get(out, ki) == key {\n            kf = true\n          }\n          ki = ki + 1\n        }\n        if !kf {\n          Array::push(out, key)\n        }\n        collect_strings_expr(val, out)\n        mi = mi + 1\n      }\n      0\n    },\n    ERecord(_, fields, _) => {\n      let mut ri = 0\n      while ri < Array::length(fields) {\n        let (_, fval) = Array::get(fields, ri)\n        collect_strings_expr(fval, out)\n        ri = ri + 1\n      }\n      0\n    },\n    EDot(obj, _, _, _) => collect_strings_expr(obj, out),\n    ELabeledArg(_, _, val) => collect_strings_expr(val, out),\n    _ => 0\n  }\n}\n\nexport fn get_func_param_names(stmt: Stmt) -> Array[String] with { Error } {\n  match stmt {\n    SLet(_, _, _, _, expr) => match expr {\n      EFn(_, _, params, _, _, _) => {\n        let names = common_analysis_fresh_string_array()\n        let mut i = 0\n        while i < Array::length(params) {\n          let (pname, _) = Array::get(params, i)\n          let plen2 = String::length(pname)\n          let clean_name = if plen2 > 0 {\n            let last_char = String::char_code_at(pname, plen2 - 1)\n            if last_char == '~' || last_char == '?' {\n              pname[0: plen2 - 1]\n            } else pname\n          } else pname\n          Array::push(names, clean_name)\n          i = i + 1\n        }\n        names\n      },\n      _ => throw(\"get_func_param_names: not a function\")\n    },\n    _ => throw(\"get_func_param_names: not a let statement\")\n  }\n}\n\nexport fn expr_contains_exceptions(expr: Expr) -> Bool {\n  match expr {\n    EHandle(_, _) => true,\n    EBinOp(_, lhs, rhs) => expr_contains_exceptions(lhs) || expr_contains_exceptions(rhs),\n    EUnaryOp(_, operand) => expr_contains_exceptions(operand),\n    EIf(cond, then_e, else_e) =>\n    expr_contains_exceptions(cond) || expr_contains_exceptions(then_e) || expr_contains_exceptions(else_e),\n    ECall(callee, args, _) => {\n      let mut found = match callee {\n        EIdent(cname, _) => cname == \"resume\" || cname == \"perform\",\n        _ => expr_contains_exceptions(callee)\n      }\n      let mut i = 0\n      while i < Array::length(args) {\n        if expr_contains_exceptions(Array::get(args, i)) {\n          found = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      found\n    },\n    ELet(_, value, body, _) => expr_contains_exceptions(value) || expr_contains_exceptions(body),\n    ELetRec(_, value, body) => expr_contains_exceptions(value) || expr_contains_exceptions(body),\n    ELetMut(_, value, body, _) => expr_contains_exceptions(value) || expr_contains_exceptions(body),\n    EAssign(_, value, body) => expr_contains_exceptions(value) || expr_contains_exceptions(body),\n    EAssignOp(_, _, value, body) => expr_contains_exceptions(value) || expr_contains_exceptions(body),\n    ESeq(first, second) => expr_contains_exceptions(first) || expr_contains_exceptions(second),\n    EWhile(cond, body) => expr_contains_exceptions(cond) || expr_contains_exceptions(body),\n    EForIn(_, _, iter_e, body) => expr_contains_exceptions(iter_e) || expr_contains_exceptions(body),\n    ELoop(params, body) => {\n      let mut i = 0\n      let mut found = expr_contains_exceptions(body)\n      while i < Array::length(params) {\n        let (_, iv) = Array::get(params, i)\n        if expr_contains_exceptions(iv) {\n          found = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      found\n    },\n    EMatch(scrut, arms) => {\n      let mut i = 0\n      let mut found = expr_contains_exceptions(scrut)\n      while i < Array::length(arms) {\n        let (_, arm_body) = Array::get(arms, i)\n        if expr_contains_exceptions(arm_body) {\n          found = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      found\n    },\n    EFn(_, _, _, _, _, body) => expr_contains_exceptions(body),\n    ETuple(elems) => {\n      let mut i = 0\n      let mut found = false\n      while i < Array::length(elems) {\n        if expr_contains_exceptions(Array::get(elems, i)) {\n          found = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      found\n    },\n    EArray(elems) => {\n      let mut i = 0\n      let mut found = false\n      while i < Array::length(elems) {\n        if expr_contains_exceptions(Array::get(elems, i)) {\n          found = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      found\n    },\n    ERecord(_, fields, _) => {\n      let mut i = 0\n      let mut found = false\n      while i < Array::length(fields) {\n        let (_, fval) = Array::get(fields, i)\n        if expr_contains_exceptions(fval) {\n          found = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      found\n    },\n    EMap(fields) => {\n      let mut i = 0\n      let mut found = false\n      while i < Array::length(fields) {\n        let (_, fval) = Array::get(fields, i)\n        if expr_contains_exceptions(fval) {\n          found = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      found\n    },\n    EDot(obj, _, _, _) => expr_contains_exceptions(obj),\n    ELabeledArg(_, _, inner) => expr_contains_exceptions(inner),\n    EReturn(inner) => expr_contains_exceptions(inner),\n    ESpread(inner) => expr_contains_exceptions(inner),\n    EBreak(opt) => match opt {\n      Some(inner) => expr_contains_exceptions(inner),\n      None => false\n    },\n    EContinue(args) => {\n      let mut i = 0\n      let mut found = false\n      while i < Array::length(args) {\n        if expr_contains_exceptions(Array::get(args, i)) {\n          found = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      found\n    },\n    EInt(_) => false,\n    EFloat(_) => false,\n    EString(_) => false,\n    EBool(_) => false,\n    EIdent(_, _) => false,\n    EStringInterp(_) => false,\n    EUnit => false\n  }\n}\n\nexport fn stmts_contain_exceptions(stmts: Array[Stmt]) -> Bool {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SLet(_, _, _, _, expr) => if expr_contains_exceptions(expr) {\n        found = true\n      } else {\n        ()\n      },\n      SLetMut(_, _, expr) => if expr_contains_exceptions(expr) {\n        found = true\n      } else {\n        ()\n      },\n      SLetPat(_, expr) => if expr_contains_exceptions(expr) {\n        found = true\n      } else {\n        ()\n      },\n      SExpr(expr) => if expr_contains_exceptions(expr) {\n        found = true\n      } else {\n        ()\n      },\n      STest(_, expr) => if expr_contains_exceptions(expr) {\n        found = true\n      } else {\n        ()\n      },\n      SBench(_, expr) => if expr_contains_exceptions(expr) {\n        found = true\n      } else {\n        ()\n      },\n      SModule(_, _, inner) => if stmts_contain_exceptions(inner) {\n        found = true\n      } else {\n        ()\n      },\n      _ => ()\n    }\n    i = i + 1\n  }\n  found\n}\n\nexport fn collect_strings_stmts(stmts: Array[Stmt]) -> Array[String] {\n  let out = common_analysis_fresh_string_array()\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SLet(_, _, _, _, expr) => collect_strings_expr(expr, out),\n      _ => 0\n    }\n    i = i + 1\n  }\n  out\n}\n\nexport fn emit_i64_extend_i32_u(buf: Bytes) -> Unit {\n  bytebuf_push(buf, op_i64_extend_i32_u)\n}\n\nexport fn emit_closure_resolve(buf: Bytes, fn_val_local: Int, slot_local: Int, env_local: Int) -> Unit {\n  emit_local_get(buf, fn_val_local)\n  emit_i64_const(buf, 3)\n  emit_i64_and(buf)\n  emit_i64_const(buf, 2)\n  emit_i64_eq(buf)\n  emit_if_void(buf)\n  emit_local_get(buf, fn_val_local)\n  emit_i64_const(buf, 2)\n  emit_i64_shr_s(buf)\n  emit_local_set(buf, slot_local)\n  emit_i64_const(buf, 0)\n  emit_local_set(buf, env_local)\n  emit_else(buf)\n  emit_local_get(buf, fn_val_local)\n  emit_i64_const(buf, -4)\n  emit_i64_and(buf)\n  emit_local_set(buf, env_local)\n  emit_local_get(buf, env_local)\n  emit_i32_wrap_i64(buf)\n  emit_i32_load(buf, 2, 0)\n  emit_i64_extend_i32_u(buf)\n  emit_local_set(buf, slot_local)\n  emit_end(buf)\n}\n\nexport fn emit_closure_call_tail(buf: Bytes, env_local: Int, slot_local: Int, closure_type_base: Int, num_args: Int) -> Unit {\n  emit_local_get(buf, env_local)\n  emit_local_get(buf, slot_local)\n  emit_i32_wrap_i64(buf)\n  emit_call_indirect(buf, closure_type_base + num_args)\n}\n\nfn collect_pattern_bindings(pat: Pat, bindings: Array[String]) -> Int {\n  match pat {\n    PBind(name) => {\n      Array::push(bindings, name); 0\n    },\n    PTuple(pats) => {\n      let mut i = 0\n      while i < Array::length(pats) {\n        collect_pattern_bindings(Array::get(pats, i), bindings)\n        i = i + 1\n      }\n      0\n    },\n    PCtor(_, args) => {\n      let mut i = 0\n      while i < Array::length(args) {\n        collect_pattern_bindings(Array::get(args, i), bindings)\n        i = i + 1\n      }\n      0\n    },\n    POr(l, r) => {\n      collect_pattern_bindings(l, bindings); collect_pattern_bindings(r, bindings)\n    },\n    PStruct(_, fields) => {\n      let mut i = 0\n      while i < Array::length(fields) {\n        let (_, fpat) = Array::get(fields, i)\n        collect_pattern_bindings(fpat, bindings)\n        i = i + 1\n      }\n      0\n    },\n    _ => 0\n  }\n}\n\nfn is_inlined_async_builtin(name: String) -> Bool {\n  name == \"await\" || name == \"Future::ready\" || name == \"Future::pending\" || name == \"Future::resolve\" || name == \"Stream::empty\" || name == \"Stream::once\" || name == \"Stream::map\" || name == \"Stream::filter\" || name == \"Stream::fold\" || name == \"Stream::next\" || name == \"String::to_bytes\" || name == \"Stream::to_string\" || name == \"Path::to_string\" || name == \"Path::is_absolute\" || name == \"Path::ref\" || name == \"Path::resolve\" || name == \"host_future_get\" || name == \"host_future_named\" || name == \"host_stream_named\" || name == \"host_stream_next\" || name == \"host_stream_close\"\n}\n\nfn is_inlined_scalar_builtin(name: String) -> Bool {\n  name == \"not\" || name == \"add\" || name == \"sub\" || name == \"mul\" || name == \"lt\" || name == \"assert\"\n}\n\nfn is_inlined_simd_builtin(name: String) -> Bool {\n  name == \"v128_load\" || name == \"v128_store\" || name == \"v128_not\" || name == \"v128_and\" || name == \"v128_or\" || name == \"v128_any_true\" || name == \"v128_all_true_i8x16\" || name == \"v128_bitmask_i8x16\" || name == \"v128_splat_i8x16\" || name == \"v128_eq_i8x16\" || name == \"v128_le_u_i8x16\" || name == \"v128_ge_u_i8x16\"\n}\n\nfn ca_perform_error_throw_op_args(args: Array[Expr]) -> Option[Array[Expr]] {\n  if Array::length(args) == 1 {\n    match Array::get(args, 0) {\n      ECall(op_callee, op_args, _) => match op_callee {\n        EIdent(op_name, _) => if is_exception_throw_operation(op_name) {\n          Some(op_args)\n        } else {\n          None\n        },\n        _ => None\n      },\n      _ => None\n    }\n  } else {\n    None\n  }\n}\n\nexport fn collect_free_vars_expr(expr: Expr, bound: Array[String], fn_names: Array[String], out: Array[String]) -> Int {\n  collect_free_vars_expr_sc(expr, bound, fn_names, common_analysis_fresh_string_array(), true, out)\n}\n\nfn collect_free_vars_expr_sc(expr: Expr, bound: Array[String], fn_names: Array[String], encl: Array[String], skip_inlined: Bool, out: Array[String]) -> Int {\n  match expr {\n    EIdent(name, _) => if array_contains_str(bound, name) {\n      0\n    }\n    else if array_contains_str(encl, name) {\n      if array_contains_str(out, name) {\n        0\n      } else {\n        Array::push(out, name)\n        0\n      }\n    }\n    else if bsearch_leftmost(fn_names, name) >= 0 {\n      0\n    }\n    else if array_contains_str(out, name) {\n      0\n    }\n    else {\n      Array::push(out, name)\n      0\n    },\n    EInt(_) => 0,\n    EBool(_) => 0,\n    EFloat(_) => 0,\n    EString(_) => 0,\n    EUnit => 0,\n    EBinOp(_, lhs, rhs) => {\n      collect_free_vars_expr_sc(lhs, bound, fn_names, encl, skip_inlined, out); collect_free_vars_expr_sc(rhs, bound, fn_names, encl, skip_inlined, out)\n    },\n    EUnaryOp(_, operand) => collect_free_vars_expr_sc(operand, bound, fn_names, encl, skip_inlined, out),\n    EIf(cond, then_e, else_e) => {\n      collect_free_vars_expr_sc(cond, bound, fn_names, encl, skip_inlined, out); collect_free_vars_expr_sc(then_e, bound, fn_names, encl, skip_inlined, out); collect_free_vars_expr_sc(else_e, bound, fn_names, encl, skip_inlined, out)\n    },\n    ECall(EIdent(cname, _), args, _) => if cname == \"perform\" {\n      match ca_perform_error_throw_op_args(args) {\n        Some(op_args) => {\n          let mut i = 0\n          while i < Array::length(op_args) {\n            collect_free_vars_expr_sc(Array::get(op_args, i), bound, fn_names, encl, skip_inlined, out)\n            i = i + 1\n          }\n          0\n        },\n        None => {\n          collect_free_vars_expr_sc(EIdent(cname, 0), bound, fn_names, encl, skip_inlined, out)\n          let mut i = 0\n          while i < Array::length(args) {\n            collect_free_vars_expr_sc(Array::get(args, i), bound, fn_names, encl, skip_inlined, out)\n            i = i + 1\n          }\n          0\n        }\n      }\n    } else if skip_inlined && !array_contains_str(bound, cname) && !(bsearch_leftmost(fn_names, cname) >= 0) && !array_contains_str(encl, cname) && (is_inlined_async_builtin(cname) || is_inlined_scalar_builtin(cname) || is_inlined_simd_builtin(cname)) {\n      let mut i = 0\n      while i < Array::length(args) {\n        collect_free_vars_expr_sc(Array::get(args, i), bound, fn_names, encl, skip_inlined, out)\n        i = i + 1\n      }\n      0\n    } else {\n      collect_free_vars_expr_sc(EIdent(cname, 0), bound, fn_names, encl, skip_inlined, out)\n      let mut i = 0\n      while i < Array::length(args) {\n        collect_free_vars_expr_sc(Array::get(args, i), bound, fn_names, encl, skip_inlined, out)\n        i = i + 1\n      }\n      0\n    },\n    ECall(callee, args, _) => {\n      collect_free_vars_expr_sc(callee, bound, fn_names, encl, skip_inlined, out)\n      let mut i = 0\n      while i < Array::length(args) {\n        collect_free_vars_expr_sc(Array::get(args, i), bound, fn_names, encl, skip_inlined, out)\n        i = i + 1\n      }\n      0\n    },\n    ELet(name, value, body, _) => {\n      collect_free_vars_expr_sc(value, bound, fn_names, encl, skip_inlined, out)\n      let saved = Array::length(bound)\n      Array::push(bound, name)\n      collect_free_vars_expr_sc(body, bound, fn_names, encl, skip_inlined, out)\n      Array::truncate(bound, saved)\n      0\n    },\n    ELetRec(name, value, body) => {\n      let saved = Array::length(bound)\n      Array::push(bound, name)\n      collect_free_vars_expr_sc(value, bound, fn_names, encl, skip_inlined, out)\n      collect_free_vars_expr_sc(body, bound, fn_names, encl, skip_inlined, out)\n      Array::truncate(bound, saved)\n      0\n    },\n    ELetMut(name, value, body, _) => {\n      collect_free_vars_expr_sc(value, bound, fn_names, encl, skip_inlined, out)\n      let saved = Array::length(bound)\n      Array::push(bound, name)\n      collect_free_vars_expr_sc(body, bound, fn_names, encl, skip_inlined, out)\n      Array::truncate(bound, saved)\n      0\n    },\n    EAssign(name, value, body) => {\n      if array_contains_str(bound, name) {\n        0\n      } else if array_contains_str(encl, name) {\n        if array_contains_str(out, name) {\n          0\n        } else {\n          Array::push(out, name)\n          0\n        }\n      } else if bsearch_leftmost(fn_names, name) >= 0 || array_contains_str(out, name) {\n        0\n      } else {\n        Array::push(out, name)\n        0\n      }\n      collect_free_vars_expr_sc(value, bound, fn_names, encl, skip_inlined, out); collect_free_vars_expr_sc(body, bound, fn_names, encl, skip_inlined, out)\n    },\n    EAssignOp(name, _, value, body) => {\n      if array_contains_str(bound, name) {\n        0\n      } else if array_contains_str(encl, name) {\n        if array_contains_str(out, name) {\n          0\n        } else {\n          Array::push(out, name)\n          0\n        }\n      } else if bsearch_leftmost(fn_names, name) >= 0 || array_contains_str(out, name) {\n        0\n      } else {\n        Array::push(out, name)\n        0\n      }\n      collect_free_vars_expr_sc(value, bound, fn_names, encl, skip_inlined, out); collect_free_vars_expr_sc(body, bound, fn_names, encl, skip_inlined, out)\n    },\n    ESeq(first, second) => {\n      collect_free_vars_expr_sc(first, bound, fn_names, encl, skip_inlined, out); collect_free_vars_expr_sc(second, bound, fn_names, encl, skip_inlined, out)\n    },\n    EWhile(cond, body) => {\n      collect_free_vars_expr_sc(cond, bound, fn_names, encl, skip_inlined, out); collect_free_vars_expr_sc(body, bound, fn_names, encl, skip_inlined, out)\n    },\n    EForIn(var_name, index_name, iter_e, body) => {\n      collect_free_vars_expr_sc(iter_e, bound, fn_names, encl, skip_inlined, out)\n      let saved = Array::length(bound)\n      Array::push(bound, var_name)\n      match index_name {\n        Some(index_name) => Array::push(bound, index_name),\n        None => ()\n      }\n      collect_free_vars_expr_sc(body, bound, fn_names, encl, skip_inlined, out)\n      Array::truncate(bound, saved)\n      0\n    },\n    ETuple(elems) => {\n      let mut i = 0\n      while i < Array::length(elems) {\n        collect_free_vars_expr_sc(Array::get(elems, i), bound, fn_names, encl, skip_inlined, out)\n        i = i + 1\n      }\n      0\n    },\n    EArray(elems) => {\n      let mut i = 0\n      while i < Array::length(elems) {\n        collect_free_vars_expr_sc(Array::get(elems, i), bound, fn_names, encl, skip_inlined, out)\n        i = i + 1\n      }\n      0\n    },\n    EMatch(scrutinee, arms) => {\n      collect_free_vars_expr_sc(scrutinee, bound, fn_names, encl, skip_inlined, out)\n      let mut i = 0\n      while i < Array::length(arms) {\n        let (arm_pat, arm_expr) = Array::get(arms, i)\n        let saved = Array::length(bound)\n        collect_pattern_bindings(arm_pat, bound)\n        collect_free_vars_expr_sc(arm_expr, bound, fn_names, encl, skip_inlined, out)\n        Array::truncate(bound, saved)\n        i = i + 1\n      }\n      0\n    },\n    EFn(_, _, params, _, _, body) => {\n      let saved = Array::length(bound)\n      let mut pi = 0\n      while pi < Array::length(params) {\n        let (pname_raw, _) = Array::get(params, pi)\n        let pnl = String::length(pname_raw)\n        let pname = if pnl > 0 {\n          let plc = String::char_code_at(pname_raw, pnl - 1)\n          if plc == '~' || plc == '?' {\n            pname_raw[0: pnl - 1]\n          } else pname_raw\n        } else pname_raw\n        Array::push(bound, pname)\n        pi = pi + 1\n      }\n      collect_free_vars_expr_sc(body, bound, fn_names, encl, skip_inlined, out)\n      Array::truncate(bound, saved)\n      0\n    },\n    EBreak(_) => 0,\n    EContinue(_) => 0,\n    EReturn(msg) => collect_free_vars_expr_sc(msg, bound, fn_names, encl, skip_inlined, out),\n    EHandle(body, arms) => {\n      collect_free_vars_expr_sc(body, bound, fn_names, encl, skip_inlined, out)\n      let mut hi = 0\n      while hi < Array::length(arms) {\n        let (_, arm_expr) = Array::get(arms, hi)\n        collect_free_vars_expr_sc(arm_expr, bound, fn_names, encl, skip_inlined, out)\n        hi = hi + 1\n      }\n      0\n    },\n    EDot(obj, _, _, _) => collect_free_vars_expr_sc(obj, bound, fn_names, encl, skip_inlined, out),\n    ERecord(_, fields, _) => {\n      let mut ri = 0\n      while ri < Array::length(fields) {\n        let (_, fval) = Array::get(fields, ri)\n        collect_free_vars_expr_sc(fval, bound, fn_names, encl, skip_inlined, out)\n        ri = ri + 1\n      }\n      0\n    },\n    ELabeledArg(_, _, arg_expr) => collect_free_vars_expr_sc(arg_expr, bound, fn_names, encl, skip_inlined, out),\n    _ => 0\n  }\n}\n\nexport fn collect_free_vars(body: Expr, param_names: Array[String], fn_names: Array[String]) -> Array[String] {\n  collect_free_vars_indexed(body, param_names, sorted_names_of(fn_names))\n}\n\nexport fn collect_free_vars_indexed(body: Expr, param_names: Array[String], fn_name_index: Array[String]) -> Array[String] {\n  collect_free_vars_indexed_sc(body, param_names, fn_name_index, common_analysis_fresh_string_array(), true)\n}\n\nexport fn collect_free_vars_used_builtins(body: Expr, param_names: Array[String], fn_name_index: Array[String]) -> Array[String] {\n  collect_free_vars_indexed_sc(body, param_names, fn_name_index, common_analysis_fresh_string_array(), false)\n}\n\nfn collect_free_vars_indexed_sc(body: Expr, param_names: Array[String], fn_name_index: Array[String], encl: Array[String], skip_inlined: Bool) -> Array[String] {\n  let out = common_analysis_fresh_string_array()\n  let bound = Array::slice(param_names, 0, Array::length(param_names))\n  collect_free_vars_expr_sc(body, bound, fn_name_index, encl, skip_inlined, out)\n  out\n}\n\nexport fn collect_free_vars_indexed_self(body: Expr, param_names: Array[String], fn_name_index: Array[String], self_name: String, encl: Array[String]) -> Array[String] {\n  let captures = collect_free_vars_indexed_sc(body, param_names, fn_name_index, encl, true)\n  if self_name == \"\" || array_contains_str(captures, self_name) {\n    captures\n  } else {\n    let no_globals = common_analysis_fresh_string_array()\n    let unfiltered = collect_free_vars_indexed_sc(body, param_names, no_globals, encl, true)\n    if array_contains_str(unfiltered, self_name) {\n      Array::push(captures, self_name)\n      captures\n    } else {\n      captures\n    }\n  }\n}\n\nexport fn proj_root_ident(e: Expr) -> String {\n  match e {\n    EDot(obj, _, _, _) => proj_root_ident(obj),\n    EIdent(nm, _) => nm,\n    _ => \"\"\n  }\n}\n\nfn borrow_ret_builtin_name(nm: String) -> Bool {\n  nm == \"Array::get\" || nm == \"__index\" || nm == \"Map::get\" || nm == \"__rec_field\"\n}\n\nfn borrow_tail_root(e: Expr) -> String {\n  match e {\n    EIdent(nm, _) => nm,\n    EDot(obj, _, _, _) => borrow_tail_root(obj),\n    ECall(callee, args, _) => match callee {\n      EIdent(nm, _) => if Array::length(args) >= 1 && borrow_ret_builtin_name(nm) {\n        borrow_tail_root(Array::get(args, 0))\n      } else {\n        \"\"\n      },\n      _ => \"\"\n    },\n    _ => \"\"\n  }\n}\n\nfn scope_tail_ident(e: Expr) -> String {\n  match e {\n    ELet(_, _, b, _) => scope_tail_ident(b),\n    ELetMut(_, _, b, _) => scope_tail_ident(b),\n    ELetRec(_, _, b) => scope_tail_ident(b),\n    ESeq(_, b) => scope_tail_ident(b),\n    EAssign(_, _, b) => scope_tail_ident(b),\n    EAssignOp(_, _, _, b) => scope_tail_ident(b),\n    EIdent(nm, _) => nm,\n    _ => \"\"\n  }\n}\n\nfn borrow_call_root(e: Expr) -> String {\n  match e {\n    ECall(callee, args, _) => match callee {\n      EIdent(nm, _) => if Array::length(args) >= 1 && borrow_ret_builtin_name(nm) {\n        borrow_tail_root(Array::get(args, 0))\n      } else {\n        \"\"\n      },\n      _ => \"\"\n    },\n    _ => \"\"\n  }\n}\n\nexport fn scope_tail_proj_root(e: Expr) -> String {\n  match e {\n    ELet(n, v, b, _) => {\n      let inner = scope_tail_proj_root(b)\n      if inner == \"\" && scope_tail_ident(b) == n {\n        borrow_call_root(v)\n      } else {\n        inner\n      }\n    },\n    ELetMut(_, _, b, _) => scope_tail_proj_root(b),\n    ELetRec(_, _, b) => scope_tail_proj_root(b),\n    ESeq(_, b) => scope_tail_proj_root(b),\n    EAssign(_, _, b) => scope_tail_proj_root(b),\n    EAssignOp(_, _, _, b) => scope_tail_proj_root(b),\n    EDot(obj, _, _, _) => proj_root_ident(obj),\n    ECall(callee, args, _) => match callee {\n      EIdent(nm, _) => if Array::length(args) >= 1 && borrow_ret_builtin_name(nm) {\n        borrow_tail_root(Array::get(args, 0))\n      } else {\n        \"\"\n      },\n      _ => \"\"\n    },\n    _ => \"\"\n  }\n}\n\nexport fn is_mut_captured_in(expr: Expr, name: String) -> Bool {\n  match expr {\n    EIdent(_, _) => false,\n    EInt(_) => false,\n    EBool(_) => false,\n    EFloat(_) => false,\n    EString(_) => false,\n    EUnit => false,\n    EBinOp(_, lhs, rhs) => is_mut_captured_in(lhs, name) || is_mut_captured_in(rhs, name),\n    EUnaryOp(_, operand) => is_mut_captured_in(operand, name),\n    EIf(cond, then_e, else_e) => is_mut_captured_in(cond, name) || is_mut_captured_in(then_e, name) || is_mut_captured_in(else_e, name),\n    ECall(callee, args, _) => if is_mut_captured_in(callee, name) {\n      true\n    }\n    else {\n      let mut i = 0\n      let mut found = false\n      while i < Array::length(args) {\n        if is_mut_captured_in(Array::get(args, i), name) {\n          found = true\n        }\n        i = i + 1\n      }\n      found\n    },\n    ELet(n, value, body, _) => if n == name {\n      is_mut_captured_in(value, name)\n    }\n    else {\n      is_mut_captured_in(value, name) || is_mut_captured_in(body, name)\n    },\n    ELetRec(n, value, body) => if n == name {\n      false\n    }\n    else {\n      is_mut_captured_in(value, name) || is_mut_captured_in(body, name)\n    },\n    ELetMut(n, value, body, _) => if n == name {\n      is_mut_captured_in(value, name)\n    }\n    else {\n      is_mut_captured_in(value, name) || is_mut_captured_in(body, name)\n    },\n    EAssign(_, value, body) => is_mut_captured_in(value, name) || is_mut_captured_in(body, name),\n    EAssignOp(_, _, value, body) => is_mut_captured_in(value, name) || is_mut_captured_in(body, name),\n    ESeq(first, second) => is_mut_captured_in(first, name) || is_mut_captured_in(second, name),\n    EWhile(cond, body) => is_mut_captured_in(cond, name) || is_mut_captured_in(body, name),\n    EForIn(_, _, iter_e, body) => is_mut_captured_in(iter_e, name) || is_mut_captured_in(body, name),\n    ETuple(elems) => {\n      let mut i = 0\n      let mut found = false\n      while i < Array::length(elems) {\n        if is_mut_captured_in(Array::get(elems, i), name) {\n          found = true\n        }\n        i = i + 1\n      }\n      found\n    },\n    EArray(elems) => {\n      let mut i = 0\n      let mut found = false\n      while i < Array::length(elems) {\n        if is_mut_captured_in(Array::get(elems, i), name) {\n          found = true\n        }\n        i = i + 1\n      }\n      found\n    },\n    EMatch(scrutinee, arms) => if is_mut_captured_in(scrutinee, name) {\n      true\n    }\n    else {\n      let mut i = 0\n      let mut found = false\n      while i < Array::length(arms) {\n        let (_, arm_expr) = Array::get(arms, i)\n        if is_mut_captured_in(arm_expr, name) {\n          found = true\n        }\n        i = i + 1\n      }\n      found\n    },\n    EFn(_, _, params, _, _, fn_body) => {\n      let mut shadowed = false\n      let mut pi = 0\n      while pi < Array::length(params) {\n        let (pname, _) = Array::get(params, pi)\n        if pname == name {\n          shadowed = true\n        }\n        pi = pi + 1\n      }\n      if shadowed {\n        false\n      }\n      else {\n        let param_names = array_empty()\n        let mut pi2 = 0\n        while pi2 < Array::length(params) {\n          let (pname2, _) = Array::get(params, pi2)\n          Array::push(param_names, pname2)\n          pi2 = pi2 + 1\n        }\n        let fv = collect_free_vars(fn_body, param_names, array_empty())\n        if array_contains_str(fv, name) {\n          true\n        }\n        else {\n          is_mut_captured_in(fn_body, name)\n        }\n      }\n    },\n    EBreak(_) => false,\n    EContinue(_) => false,\n    EReturn(msg) => is_mut_captured_in(msg, name),\n    ERecord(_, fields, _) => {\n      let mut i = 0\n      let mut found = false\n      while i < Array::length(fields) {\n        let (_, fval) = Array::get(fields, i)\n        if is_mut_captured_in(fval, name) {\n          found = true\n        }\n        i = i + 1\n      }\n      found\n    },\n    EMap(entries) => {\n      let mut i = 0\n      let mut found = false\n      while i < Array::length(entries) {\n        let (_, mval) = Array::get(entries, i)\n        if is_mut_captured_in(mval, name) {\n          found = true\n        }\n        i = i + 1\n      }\n      found\n    },\n    EHandle(body, arms) => if is_mut_captured_in(body, name) {\n      true\n    } else {\n      let mut i = 0\n      let mut found = false\n      while i < Array::length(arms) {\n        let (_, arm_expr) = Array::get(arms, i)\n        if is_mut_captured_in(arm_expr, name) {\n          found = true\n        }\n        i = i + 1\n      }\n      found\n    },\n    ELoop(params, body) => if is_mut_captured_in(body, name) {\n      true\n    } else {\n      let mut i = 0\n      let mut found = false\n      while i < Array::length(params) {\n        let (_, init) = Array::get(params, i)\n        if is_mut_captured_in(init, name) {\n          found = true\n        }\n        i = i + 1\n      }\n      found\n    },\n    EDot(obj, _, _, _) => is_mut_captured_in(obj, name),\n    ELabeledArg(_, _, inner) => is_mut_captured_in(inner, name),\n    ESpread(inner) => is_mut_captured_in(inner, name),\n    _ => false\n  }\n}\n\nexport fn mut_needs_ref_cell(body: Expr, name: String) -> Bool {\n  is_mut_captured_in(body, name)\n}\n\nexport fn md_is_borrow_arg0_call(f: String) -> Bool {\n  f == \"__index\" || f == \"Array::get\" || f == \"Array::length\" || f == \"Array::set\" || f == \"Array::push\" || f == \"Array::push_all\" || f == \"ArrayBuilder::push\" || f == \"MutList::push\" || f == \"StringBuilder::push\" || f == \"MapBuilder::set\" || f == \"MapBuilder::has_key\" || f == \"MapBuilder::get\" || f == \"Map::get\" || f == \"Map::keys\" || f == \"Map::has_key\" || f == \"Map::set\" || f == \"Bytes::push\" || f == \"Bytes::set\" || f == \"Bytes::get\" || f == \"Bytes::length\" || f == \"FrozenArray::get\" || f == \"FrozenArray::length\" || f == \"FixedArray::get\" || f == \"FixedArray::set\" || f == \"FixedArray::length\" || f == \"String::join\" || f == \"eq\" || f == \"__rec_field\"\n}\n\nfn md_max(a: Int, b: Int) -> Int {\n  if a > b {\n    a\n  } else {\n    b\n  }\n}\n\nexport fn md_consume_count(e: Expr, name: String) -> Int {\n  let md_no_user_fns: Array[String] = [\n  ]\n  let md_no_user_masks: Array[Int] = [\n  ]\n  md_cc_go(e, name, md_no_user_fns, md_no_user_masks)\n}\n\nfn md_borrow_mask_of(f: String, bfns: Array[String], bmasks: Array[Int]) -> Int {\n  let bi = bsearch_leftmost(bfns, f)\n  let user = if bi >= 0 && bi < Array::length(bmasks) {\n    Array::get(bmasks, bi)\n  } else {\n    0\n  }\n  if md_is_borrow_arg0_call(f) {\n    user|1\n  } else {\n    user\n  }\n}\n\nfn md_collect_shadow_names(e: Expr, out: Array[String]) -> Int {\n  match e {\n    EInt(_) => 0,\n    EFloat(_) => 0,\n    EString(_) => 0,\n    EBool(_) => 0,\n    EUnit => 0,\n    EStringInterp(_) => 0,\n    EIdent(_, _) => 0,\n    ETuple(items) => {\n      let mut i = 0\n      while i < Array::length(items) {\n        md_collect_shadow_names(Array::get(items, i), out)\n        i = i + 1\n      }\n      0\n    },\n    EArray(items) => {\n      let mut i = 0\n      while i < Array::length(items) {\n        md_collect_shadow_names(Array::get(items, i), out)\n        i = i + 1\n      }\n      0\n    },\n    ERecord(_, fields, _) => {\n      let mut i = 0\n      while i < Array::length(fields) {\n        let (_, v) = Array::get(fields, i)\n        md_collect_shadow_names(v, out)\n        i = i + 1\n      }\n      0\n    },\n    EMap(fields) => {\n      let mut i = 0\n      while i < Array::length(fields) {\n        let (_, v) = Array::get(fields, i)\n        md_collect_shadow_names(v, out)\n        i = i + 1\n      }\n      0\n    },\n    EIf(c, t, el) => {\n      md_collect_shadow_names(c, out)\n      md_collect_shadow_names(t, out)\n      md_collect_shadow_names(el, out)\n    },\n    EWhile(c, b) => {\n      md_collect_shadow_names(c, out)\n      md_collect_shadow_names(b, out)\n    },\n    ELet(n, v, b, _) => {\n      Array::push(out, n)\n      md_collect_shadow_names(v, out)\n      md_collect_shadow_names(b, out)\n    },\n    ELetRec(n, v, b) => {\n      Array::push(out, n)\n      md_collect_shadow_names(v, out)\n      md_collect_shadow_names(b, out)\n    },\n    ELetMut(n, v, b, _) => {\n      Array::push(out, n)\n      md_collect_shadow_names(v, out)\n      md_collect_shadow_names(b, out)\n    },\n    EAssign(_, v, b) => {\n      md_collect_shadow_names(v, out)\n      md_collect_shadow_names(b, out)\n    },\n    EAssignOp(_, _, v, b) => {\n      md_collect_shadow_names(v, out)\n      md_collect_shadow_names(b, out)\n    },\n    ESeq(a, b) => {\n      md_collect_shadow_names(a, out)\n      md_collect_shadow_names(b, out)\n    },\n    EMatch(s, arms) => {\n      md_collect_shadow_names(s, out)\n      let mut i = 0\n      while i < Array::length(arms) {\n        let (pt, v) = Array::get(arms, i)\n        collect_pattern_bindings(pt, out)\n        md_collect_shadow_names(v, out)\n        i = i + 1\n      }\n      0\n    },\n    EHandle(s, arms) => {\n      md_collect_shadow_names(s, out)\n      let mut i = 0\n      while i < Array::length(arms) {\n        let (pt, v) = Array::get(arms, i)\n        collect_pattern_bindings(pt, out)\n        md_collect_shadow_names(v, out)\n        i = i + 1\n      }\n      0\n    },\n    ELoop(params, b) => {\n      let mut i = 0\n      while i < Array::length(params) {\n        let pr = Array::get(params, i)\n        Array::push(out, pr.0)\n        md_collect_shadow_names(pr.1, out)\n        i = i + 1\n      }\n      md_collect_shadow_names(b, out)\n    },\n    EForIn(vn, idx, it, b) => {\n      Array::push(out, vn)\n      match idx {\n        Some(ix) => {\n          Array::push(out, ix)\n          ()\n        },\n        None => ()\n      }\n      md_collect_shadow_names(it, out)\n      md_collect_shadow_names(b, out)\n    },\n    ECall(callee, args, _) => {\n      md_collect_shadow_names(callee, out)\n      let mut i = 0\n      while i < Array::length(args) {\n        md_collect_shadow_names(Array::get(args, i), out)\n        i = i + 1\n      }\n      0\n    },\n    EBinOp(_, l, r) => {\n      md_collect_shadow_names(l, out)\n      md_collect_shadow_names(r, out)\n    },\n    EUnaryOp(_, x) => md_collect_shadow_names(x, out),\n    EFn(_, _, params, _, _, body) => {\n      let mut i = 0\n      while i < Array::length(params) {\n        let pr = Array::get(params, i)\n        Array::push(out, pr.0)\n        i = i + 1\n      }\n      md_collect_shadow_names(body, out)\n    },\n    EDot(x, _, _, _) => md_collect_shadow_names(x, out),\n    ELabeledArg(_, _, v) => md_collect_shadow_names(v, out),\n    EReturn(x) => md_collect_shadow_names(x, out),\n    EBreak(opt) => match opt {\n      Some(v) => md_collect_shadow_names(v, out),\n      None => 0\n    },\n    EContinue(args) => {\n      let mut i = 0\n      while i < Array::length(args) {\n        md_collect_shadow_names(Array::get(args, i), out)\n        i = i + 1\n      }\n      0\n    },\n    ESpread(x) => md_collect_shadow_names(x, out)\n  }\n}\n\nexport fn md_shadow_zeroed_bmasks(e: Expr, bfns: Array[String], bmasks: Array[Int]) -> Array[Int] {\n  if Array::length(bfns) == 0 {\n    bmasks\n  } else {\n    let sh: Array[String] = [\n    ]\n    md_collect_shadow_names(e, sh)\n    let mut any_hit = false\n    let mut si = 0\n    while si < Array::length(sh) {\n      if bsearch_leftmost(bfns, Array::get(sh, si)) >= 0 {\n        any_hit = true\n      } else {\n        ()\n      }\n      si = si + 1\n    }\n    if !any_hit {\n      bmasks\n    } else {\n      let bmasks2: Array[Int] = [\n      ]\n      let mut bi = 0\n      while bi < Array::length(bfns) {\n        let bn = Array::get(bfns, bi)\n        let m = if bi < Array::length(bmasks) {\n          Array::get(bmasks, bi)\n        } else {\n          0\n        }\n        Array::push(bmasks2, if array_contains_str(sh, bn) {\n          0\n        } else {\n          m\n        })\n        bi = bi + 1\n      }\n      bmasks2\n    }\n  }\n}\n\nexport fn md_consume_count_pre(e: Expr, name: String, bfns: Array[String], bmasks_zeroed: Array[Int]) -> Int {\n  md_cc_go(e, name, bfns, bmasks_zeroed)\n}\n\nexport fn md_consume_count_b(e: Expr, name: String, bfns: Array[String], bmasks: Array[Int]) -> Int {\n  md_cc_go(e, name, bfns, md_shadow_zeroed_bmasks(e, bfns, bmasks))\n}\n\nfn md_cc_go(e: Expr, name: String, bfns: Array[String], bmasks: Array[Int]) -> Int {\n  match e {\n    EInt(_) => 0,\n    EFloat(_) => 0,\n    EString(_) => 0,\n    EBool(_) => 0,\n    EUnit => 0,\n    EStringInterp(_) => 0,\n    EIdent(n, _) => if n == name {\n      1\n    } else {\n      0\n    },\n    ETuple(items) => {\n      let mut acc = 0\n      let mut i = 0\n      while i < Array::length(items) {\n        acc = acc + md_cc_go(Array::get(items, i), name, bfns, bmasks)\n        i = i + 1\n      }\n      acc\n    },\n    EArray(items) => {\n      let mut acc = 0\n      let mut i = 0\n      while i < Array::length(items) {\n        acc = acc + md_cc_go(Array::get(items, i), name, bfns, bmasks)\n        i = i + 1\n      }\n      acc\n    },\n    ERecord(_, fields, _) => {\n      let mut acc = 0\n      let mut i = 0\n      while i < Array::length(fields) {\n        let (_, v) = Array::get(fields, i)\n        acc = acc + md_cc_go(v, name, bfns, bmasks)\n        i = i + 1\n      }\n      acc\n    },\n    EMap(fields) => {\n      let mut acc = 0\n      let mut i = 0\n      while i < Array::length(fields) {\n        let (_, v) = Array::get(fields, i)\n        acc = acc + md_cc_go(v, name, bfns, bmasks)\n        i = i + 1\n      }\n      acc\n    },\n    EIf(c, t, el) =>\n    md_cc_go(c, name, bfns, bmasks) + md_max(md_cc_go(t, name, bfns, bmasks), md_cc_go(el, name, bfns, bmasks)),\n    ELet(_, v, b, _) => md_cc_go(v, name, bfns, bmasks) + md_cc_go(b, name, bfns, bmasks),\n    ELetRec(_, v, b) => md_cc_go(v, name, bfns, bmasks) + md_cc_go(b, name, bfns, bmasks),\n    ELetMut(_, v, b, _) => md_cc_go(v, name, bfns, bmasks) + md_cc_go(b, name, bfns, bmasks),\n    EAssign(_, v, b) => md_cc_go(v, name, bfns, bmasks) + md_cc_go(b, name, bfns, bmasks),\n    EAssignOp(_, _, v, b) => md_cc_go(v, name, bfns, bmasks) + md_cc_go(b, name, bfns, bmasks),\n    ESeq(a, b) => md_cc_go(a, name, bfns, bmasks) + md_cc_go(b, name, bfns, bmasks),\n    EMatch(s, arms) => {\n      let mut mx = 0\n      let mut i = 0\n      while i < Array::length(arms) {\n        let (_, v) = Array::get(arms, i)\n        mx = md_max(mx, md_cc_go(v, name, bfns, bmasks))\n        i = i + 1\n      }\n      let scr = match s {\n        EIdent(_, _) => 0,\n        _ => md_cc_go(s, name, bfns, bmasks)\n      }\n      scr + mx\n    },\n    EHandle(s, arms) => {\n      let mut mx = 0\n      let mut i = 0\n      while i < Array::length(arms) {\n        let (_, v) = Array::get(arms, i)\n        mx = md_max(mx, md_cc_go(v, name, bfns, bmasks))\n        i = i + 1\n      }\n      let scr = match s {\n        EIdent(_, _) => 0,\n        _ => md_cc_go(s, name, bfns, bmasks)\n      }\n      scr + mx\n    },\n    EWhile(c, b) => md_cc_go(c, name, bfns, bmasks) + md_cc_go(b, name, bfns, bmasks),\n    ELoop(params, b) => {\n      let mut acc = md_cc_go(b, name, bfns, bmasks)\n      let mut i = 0\n      while i < Array::length(params) {\n        let (_, v) = Array::get(params, i)\n        acc = acc + md_cc_go(v, name, bfns, bmasks)\n        i = i + 1\n      }\n      acc\n    },\n    EForIn(_, _, it, b) => md_cc_go(it, name, bfns, bmasks) + md_cc_go(b, name, bfns, bmasks),\n    ECall(callee, args, _) => {\n      let bmask = match callee {\n        EIdent(f, _) => md_borrow_mask_of(f, bfns, bmasks),\n        _ => 0\n      }\n      let callee_c = match callee {\n        EIdent(_, _) => 0,\n        _ => md_cc_go(callee, name, bfns, bmasks)\n      }\n      let mut acc = callee_c\n      let mut ri = 0\n      while ri < Array::length(args) {\n        let a = Array::get(args, ri)\n        acc = acc + (if bmask_has(bmask, ri) {\n          match a {\n            EIdent(_, _) => 0,\n            _ => md_cc_go(a, name, bfns, bmasks)\n          }\n        } else {\n          md_cc_go(a, name, bfns, bmasks)\n        })\n        ri = ri + 1\n      }\n      acc\n    },\n    EBinOp(_, l, r) => md_cc_go(l, name, bfns, bmasks) + md_cc_go(r, name, bfns, bmasks),\n    EUnaryOp(_, x) => md_cc_go(x, name, bfns, bmasks),\n    EFn(_, _, _, _, _, body) => md_cc_go(body, name, bfns, bmasks),\n    EDot(x, _, _, _) => md_cc_go(x, name, bfns, bmasks),\n    ELabeledArg(_, _, v) => md_cc_go(v, name, bfns, bmasks),\n    EReturn(x) => md_cc_go(x, name, bfns, bmasks),\n    EBreak(opt) => match opt {\n      Some(v) => md_cc_go(v, name, bfns, bmasks),\n      None => 0\n    },\n    EContinue(args) => {\n      let mut acc = 0\n      let mut i = 0\n      while i < Array::length(args) {\n        acc = acc + md_cc_go(Array::get(args, i), name, bfns, bmasks)\n        i = i + 1\n      }\n      acc\n    },\n    ESpread(x) => md_cc_go(x, name, bfns, bmasks)\n  }\n}\n\n\nfn za_safe_builtin(f: String) -> Bool {\n  f == \"Array::get\" || f == \"Array::length\" || f == \"Array::set\" || f == \"Bytes::get\" || f == \"Bytes::set\" || f == \"Bytes::length\" || f == \"String::length\" || f == \"String::char_code_at\" || f == \"FrozenArray::get\" || f == \"FrozenArray::length\" || f == \"FixedArray::get\" || f == \"FixedArray::set\" || f == \"FixedArray::length\" || f == \"assert\" || f == \"not\"\n}\n\nfn za_first(a: String, b: String) -> String {\n  if a != \"\" {\n    a\n  } else {\n    b\n  }\n}\n\nfn za_param_names(ps: Array[(String, Option[TypeExpr])]) -> Array[String] {\n  let out = array_empty()\n  let mut pi = 0\n  while pi < Array::length(ps) {\n    let (raw, _) = Array::get(ps, pi)\n    let rl = String::length(raw)\n    let stripped = if rl > 0 {\n      let lc = String::char_code_at(raw, rl - 1)\n      if lc == '~' || lc == '?' {\n        raw[0: rl - 1]\n      } else {\n        raw\n      }\n    } else {\n      raw\n    }\n    Array::push(out, stripped)\n    pi = pi + 1\n  }\n  out\n}\n\nfn za_walk(e: Expr, ctors: Array[String], fn_names: Array[String], fn_bodies: Array[Expr], fn_params: Array[Array[String]], visited: Array[String], bound: Array[String]) -> String {\n  match e {\n    EInt(_) => \"\",\n    EFloat(_) => \"float literal (heap-boxed on the linear backend)\",\n    EString(_) => \"\",\n    EBool(_) => \"\",\n    EIdent(id, _) => if array_contains_str(bound, id) {\n      \"\"\n    } else if array_contains_str(ctors, id) {\n      String::concat(\"constructor '\", String::concat(id, \"'\"))\n    } else {\n      \"\"\n    },\n    ETuple(items) => {\n      let _ = items\n      \"tuple literal\"\n    },\n    EArray(_) => \"array literal\",\n    ERecord(_, _, _) => \"record/struct literal\",\n    EMap(_) => \"map literal\",\n    EStringInterp(_) => \"string interpolation\",\n    EFn(_, _, _, _, _, _) => \"closure literal (allocates its environment)\",\n    EIf(zc, zt, zf) => za_first(za_walk(zc, ctors, fn_names, fn_bodies, fn_params, visited, bound), za_first(za_walk(zt, ctors, fn_names, fn_bodies, fn_params, visited, bound), za_walk(zf, ctors, fn_names, fn_bodies, fn_params, visited, bound))),\n    ELet(zl_name, zv, zb, _) => {\n      Array::push(bound, zl_name)\n      za_first(za_walk(zv, ctors, fn_names, fn_bodies, fn_params, visited, bound), za_walk(zb, ctors, fn_names, fn_bodies, fn_params, visited, bound))\n    },\n    ELetRec(zlr_name, zv, zb) => {\n      Array::push(bound, zlr_name)\n      za_first(za_walk(zv, ctors, fn_names, fn_bodies, fn_params, visited, bound), za_walk(zb, ctors, fn_names, fn_bodies, fn_params, visited, bound))\n    },\n    ELetMut(zlm_name, zv, zb, _) => {\n      Array::push(bound, zlm_name)\n      za_first(za_walk(zv, ctors, fn_names, fn_bodies, fn_params, visited, bound), za_walk(zb, ctors, fn_names, fn_bodies, fn_params, visited, bound))\n    },\n    EAssign(_, zv, zb) => za_first(za_walk(zv, ctors, fn_names, fn_bodies, fn_params, visited, bound), za_walk(zb, ctors, fn_names, fn_bodies, fn_params, visited, bound)),\n    EAssignOp(_, _, zv, zb) => za_first(za_walk(zv, ctors, fn_names, fn_bodies, fn_params, visited, bound), za_walk(zb, ctors, fn_names, fn_bodies, fn_params, visited, bound)),\n    ESeq(za, zb) => za_first(za_walk(za, ctors, fn_names, fn_bodies, fn_params, visited, bound), za_walk(zb, ctors, fn_names, fn_bodies, fn_params, visited, bound)),\n    EMatch(scr, arms) => {\n      let mut r = za_walk(scr, ctors, fn_names, fn_bodies, fn_params, visited, bound)\n      let mut ai = 0\n      while ai < Array::length(arms) {\n        let (arm_pat, arm_body) = Array::get(arms, ai)\n        let _ = collect_pattern_bindings(arm_pat, bound)\n        if r == \"\" {\n          r = za_walk(arm_body, ctors, fn_names, fn_bodies, fn_params, visited, bound)\n        } else {\n          ()\n        }\n        ai = ai + 1\n      }\n      r\n    },\n    EHandle(_, _) => \"effect handler (allocates evidence)\",\n    EWhile(zc, zb) => za_first(za_walk(zc, ctors, fn_names, fn_bodies, fn_params, visited, bound), za_walk(zb, ctors, fn_names, fn_bodies, fn_params, visited, bound)),\n    ELoop(inits, zb) => {\n      let mut r = \"\"\n      let mut li = 0\n      while li < Array::length(inits) {\n        let (zloop_name, init_e) = Array::get(inits, li)\n        Array::push(bound, zloop_name)\n        if r == \"\" {\n          r = za_walk(init_e, ctors, fn_names, fn_bodies, fn_params, visited, bound)\n        } else {\n          ()\n        }\n        li = li + 1\n      }\n      za_first(r, za_walk(zb, ctors, fn_names, fn_bodies, fn_params, visited, bound))\n    },\n    EForIn(zfi_name, zfi_snd, zsrc, zb) => {\n      Array::push(bound, zfi_name)\n      match zfi_snd {\n        Some(zfi_n2) => Array::push(bound, zfi_n2),\n        None => ()\n      }\n      za_first(za_walk(zsrc, ctors, fn_names, fn_bodies, fn_params, visited, bound), za_walk(zb, ctors, fn_names, fn_bodies, fn_params, visited, bound))\n    },\n    ECall(callee, cargs, _) => {\n      let mut r = \"\"\n      let mut ci = 0\n      while ci < Array::length(cargs) {\n        if r == \"\" {\n          r = za_walk(Array::get(cargs, ci), ctors, fn_names, fn_bodies, fn_params, visited, bound)\n        } else {\n          ()\n        }\n        ci = ci + 1\n      }\n      if r != \"\" {\n        r\n      } else {\n        match callee {\n          EIdent(cname, _) => if array_contains_str(bound, cname) {\n            String::concat(\"call through local binding '\", String::concat(cname, \"' (not proven allocation-free)\"))\n          } else if array_contains_str(ctors, cname) {\n            String::concat(\"constructor '\", String::concat(cname, \"'\"))\n          } else if za_safe_builtin(cname) {\n            \"\"\n          } else {\n            let mut fi = 0\n            let mut fidx = 0 - 1\n            while fi < Array::length(fn_names) {\n              if Array::get(fn_names, fi) == cname {\n                fidx = fi\n                fi = Array::length(fn_names)\n              } else {\n                fi = fi + 1\n              }\n            }\n            if fidx >= 0 {\n              if array_contains_str(visited, cname) {\n                \"\"\n              } else {\n                Array::push(visited, cname)\n                let callee_bound = array_empty()\n                let callee_ps = Array::get(fn_params, fidx)\n                let mut cbi = 0\n                while cbi < Array::length(callee_ps) {\n                  Array::push(callee_bound, Array::get(callee_ps, cbi))\n                  cbi = cbi + 1\n                }\n                let inner = za_walk(Array::get(fn_bodies, fidx), ctors, fn_names, fn_bodies, fn_params, visited, callee_bound)\n                if inner == \"\" {\n                  \"\"\n                } else {\n                  String::concat(\"call to '\", String::concat(cname, String::concat(\"' which may allocate: \", inner)))\n                }\n              }\n            } else {\n              String::concat(\"call to '\", String::concat(cname, \"' (not proven allocation-free)\"))\n            }\n          },\n          _ => \"indirect call (not proven allocation-free)\"\n        }\n      }\n    },\n    EBinOp(_, za, zb) => za_first(za_walk(za, ctors, fn_names, fn_bodies, fn_params, visited, bound), za_walk(zb, ctors, fn_names, fn_bodies, fn_params, visited, bound)),\n    EUnaryOp(_, za) => za_walk(za, ctors, fn_names, fn_bodies, fn_params, visited, bound),\n    EDot(zobj, _, _, _) => za_walk(zobj, ctors, fn_names, fn_bodies, fn_params, visited, bound),\n    ELabeledArg(_, _, zv) => za_walk(zv, ctors, fn_names, fn_bodies, fn_params, visited, bound),\n    EReturn(zv) => za_walk(zv, ctors, fn_names, fn_bodies, fn_params, visited, bound),\n    EBreak(zo) => match zo {\n      Some(zv) => za_walk(zv, ctors, fn_names, fn_bodies, fn_params, visited, bound),\n      None => \"\"\n    },\n    EContinue(zvs) => {\n      let mut r = \"\"\n      let mut vi = 0\n      while vi < Array::length(zvs) {\n        if r == \"\" {\n          r = za_walk(Array::get(zvs, vi), ctors, fn_names, fn_bodies, fn_params, visited, bound)\n        } else {\n          ()\n        }\n        vi = vi + 1\n      }\n      r\n    },\n    ESpread(zv) => za_walk(zv, ctors, fn_names, fn_bodies, fn_params, visited, bound),\n    EUnit => \"\"\n  }\n}\n\nexport fn zero_alloc_check(stmts: Array[Stmt]) -> String {\n  let fn_names = array_empty()\n  let fn_bodies = array_empty()\n  let fn_params = array_empty()\n  let ctors = array_empty()\n  let mut si = 0\n  while si < Array::length(stmts) {\n    match Array::get(stmts, si) {\n      SLet(_, _, lname, _, lval) => match lval {\n        EFn(_, _, efn_params, _, _, fb) => {\n          Array::push(fn_names, lname)\n          Array::push(fn_bodies, fb)\n          Array::push(fn_params, za_param_names(efn_params))\n        },\n        _ => ()\n      },\n      SEnum(_, _, _, variants, _) => {\n        let mut vi = 0\n        while vi < Array::length(variants) {\n          let (vname, _) = Array::get(variants, vi)\n          Array::push(ctors, vname)\n          vi = vi + 1\n        }\n      },\n      SSuberror(_, _, sub_variants) => {\n        let mut vi2 = 0\n        while vi2 < Array::length(sub_variants) {\n          let (vname2, _) = Array::get(sub_variants, vi2)\n          Array::push(ctors, vname2)\n          vi2 = vi2 + 1\n        }\n      },\n      SStruct(_, sname, _, _, _, _) => Array::push(ctors, sname),\n      _ => ()\n    }\n    si = si + 1\n  }\n  let mut msg = \"\"\n  let mut mi = 0\n  while mi < Array::length(stmts) {\n    let is_marker = match Array::get(stmts, mi) {\n      SExpr(me) => match me {\n        EIdent(mname, _) => mname == \"@zero_alloc\",\n        _ => false\n      },\n      _ => false\n    }\n    if is_marker && msg == \"\" {\n      let target_name = if mi + 1 < Array::length(stmts) {\n        match Array::get(stmts, mi + 1) {\n          SLet(_, _, tname, _, tval) => match tval {\n            EFn(_, _, _, _, _, _) => tname,\n            _ => \"\"\n          },\n          _ => \"\"\n        }\n      } else {\n        \"\"\n      }\n      if target_name == \"\" {\n        msg = \"zero_alloc: '@zero_alloc' must immediately precede a fn declaration\"\n      } else {\n        let mut fi2 = 0\n        let mut fidx2 = 0 - 1\n        while fi2 < Array::length(fn_names) {\n          if Array::get(fn_names, fi2) == target_name {\n            fidx2 = fi2\n            fi2 = Array::length(fn_names)\n          } else {\n            fi2 = fi2 + 1\n          }\n        }\n        if fidx2 >= 0 {\n          let visited = array_empty()\n          Array::push(visited, target_name)\n          let seed_bound = array_empty()\n          let seed_ps = Array::get(fn_params, fidx2)\n          let mut sbi = 0\n          while sbi < Array::length(seed_ps) {\n            Array::push(seed_bound, Array::get(seed_ps, sbi))\n            sbi = sbi + 1\n          }\n          let r = za_walk(Array::get(fn_bodies, fidx2), ctors, fn_names, fn_bodies, fn_params, visited, seed_bound)\n          if r != \"\" {\n            msg = String::concat(\"zero_alloc: fn '\", String::concat(target_name, String::concat(\"' may allocate: \", r)))\n          } else {\n            ()\n          }\n        } else {\n          ()\n        }\n      }\n    } else {\n      ()\n    }\n    mi = mi + 1\n  }\n  msg\n}\n\n\nfn ca_collect_valued_idents(e: Expr, out: Array[String]) -> Int {\n  match e {\n    EInt(_) => 0,\n    EFloat(_) => 0,\n    EString(_) => 0,\n    EBool(_) => 0,\n    EUnit => 0,\n    EStringInterp(_) => 0,\n    EIdent(vn, _) => {\n      Array::push(out, vn)\n      0\n    },\n    ECall(callee, cargs, _) => {\n      match callee {\n        EIdent(_, _) => 0,\n        _ => ca_collect_valued_idents(callee, out)\n      }\n      let mut ci = 0\n      while ci < Array::length(cargs) {\n        let _ = ca_collect_valued_idents(Array::get(cargs, ci), out)\n        ci = ci + 1\n      }\n      0\n    },\n    ETuple(items) => ca_collect_valued_list(items, out),\n    EArray(items) => ca_collect_valued_list(items, out),\n    ERecord(_, rfields, _) => {\n      let mut ri = 0\n      while ri < Array::length(rfields) {\n        let (_, rv) = Array::get(rfields, ri)\n        let _ = ca_collect_valued_idents(rv, out)\n        ri = ri + 1\n      }\n      0\n    },\n    EMap(mfields) => {\n      let mut mi = 0\n      while mi < Array::length(mfields) {\n        let (_, mv) = Array::get(mfields, mi)\n        let _ = ca_collect_valued_idents(mv, out)\n        mi = mi + 1\n      }\n      0\n    },\n    EIf(c0, t0, f0) => {\n      let _ = ca_collect_valued_idents(c0, out)\n      let _ = ca_collect_valued_idents(t0, out)\n      ca_collect_valued_idents(f0, out)\n    },\n    ELet(_, v0, b0, _) => {\n      let _ = ca_collect_valued_idents(v0, out)\n      ca_collect_valued_idents(b0, out)\n    },\n    ELetRec(_, v0, b0) => {\n      let _ = ca_collect_valued_idents(v0, out)\n      ca_collect_valued_idents(b0, out)\n    },\n    ELetMut(_, v0, b0, _) => {\n      let _ = ca_collect_valued_idents(v0, out)\n      ca_collect_valued_idents(b0, out)\n    },\n    EAssign(_, v0, b0) => {\n      let _ = ca_collect_valued_idents(v0, out)\n      ca_collect_valued_idents(b0, out)\n    },\n    EAssignOp(_, _, v0, b0) => {\n      let _ = ca_collect_valued_idents(v0, out)\n      ca_collect_valued_idents(b0, out)\n    },\n    ESeq(a0, b0) => {\n      let _ = ca_collect_valued_idents(a0, out)\n      ca_collect_valued_idents(b0, out)\n    },\n    EMatch(scr, arms) => {\n      let _ = ca_collect_valued_idents(scr, out)\n      let mut ai = 0\n      while ai < Array::length(arms) {\n        let (_, ab) = Array::get(arms, ai)\n        let _ = ca_collect_valued_idents(ab, out)\n        ai = ai + 1\n      }\n      0\n    },\n    EHandle(hb, harms) => {\n      let _ = ca_collect_valued_idents(hb, out)\n      let mut hi = 0\n      while hi < Array::length(harms) {\n        let (_, hab) = Array::get(harms, hi)\n        let _ = ca_collect_valued_idents(hab, out)\n        hi = hi + 1\n      }\n      0\n    },\n    EWhile(c0, b0) => {\n      let _ = ca_collect_valued_idents(c0, out)\n      ca_collect_valued_idents(b0, out)\n    },\n    ELoop(inits, b0) => {\n      let mut li = 0\n      while li < Array::length(inits) {\n        let (_, iv) = Array::get(inits, li)\n        let _ = ca_collect_valued_idents(iv, out)\n        li = li + 1\n      }\n      ca_collect_valued_idents(b0, out)\n    },\n    EForIn(_, _, s0, b0) => {\n      let _ = ca_collect_valued_idents(s0, out)\n      ca_collect_valued_idents(b0, out)\n    },\n    EBinOp(_, a0, b0) => {\n      let _ = ca_collect_valued_idents(a0, out)\n      ca_collect_valued_idents(b0, out)\n    },\n    EUnaryOp(_, a0) => ca_collect_valued_idents(a0, out),\n    EFn(_, _, _, _, _, fb) => ca_collect_valued_idents(fb, out),\n    EDot(o0, _, _, _) => ca_collect_valued_idents(o0, out),\n    ELabeledArg(_, _, v0) => ca_collect_valued_idents(v0, out),\n    EReturn(v0) => ca_collect_valued_idents(v0, out),\n    EBreak(bo) => match bo {\n      Some(bv) => ca_collect_valued_idents(bv, out),\n      None => 0\n    },\n    EContinue(cvs) => ca_collect_valued_list(cvs, out),\n    ESpread(sv) => ca_collect_valued_idents(sv, out)\n  }\n}\n\nfn ca_collect_valued_list(items: Array[Expr], out: Array[String]) -> Int {\n  let mut i = 0\n  while i < Array::length(items) {\n    let _ = ca_collect_valued_idents(Array::get(items, i), out)\n    i = i + 1\n  }\n  0\n}\n\nfn ca_walk_stmts_valued(stmts: Array[Stmt], out: Array[String]) -> Int {\n  let mut si = 0\n  while si < Array::length(stmts) {\n    match Array::get(stmts, si) {\n      SLet(_, _, _, _, lv) => {\n        let _ = ca_collect_valued_idents(lv, out)\n        0\n      },\n      SLetMut(_, _, lv) => {\n        let _ = ca_collect_valued_idents(lv, out)\n        0\n      },\n      SLetPat(_, lv) => {\n        let _ = ca_collect_valued_idents(lv, out)\n        0\n      },\n      SExpr(se) => {\n        let _ = ca_collect_valued_idents(se, out)\n        0\n      },\n      STest(_, tb) => {\n        let _ = ca_collect_valued_idents(tb, out)\n        0\n      },\n      SBench(_, bb) => {\n        let _ = ca_collect_valued_idents(bb, out)\n        0\n      },\n      SModule(_, _, mb) => ca_walk_stmts_valued(mb, out),\n      _ => 0\n    }\n    si = si + 1\n  }\n  0\n}\n\nfn ca_collect_nonident_args(e: Expr, out: Array[String], out_pos: Array[Int]) -> Int {\n  match e {\n    EInt(_) => 0,\n    EFloat(_) => 0,\n    EString(_) => 0,\n    EBool(_) => 0,\n    EUnit => 0,\n    EStringInterp(_) => 0,\n    EIdent(_, _) => 0,\n    ECall(callee, cargs, _) => {\n      match callee {\n        EIdent(cf, _) => {\n          let mut ni = 0\n          while ni < Array::length(cargs) {\n            match Array::get(cargs, ni) {\n              EIdent(_, _) => (),\n              _ => {\n                Array::push(out, cf)\n                Array::push(out_pos, ni)\n              }\n            }\n            ni = ni + 1\n          }\n          ()\n        },\n        _ => {\n          let _ = ca_collect_nonident_args(callee, out, out_pos)\n          ()\n        }\n      }\n      let mut ci = 0\n      while ci < Array::length(cargs) {\n        let _ = ca_collect_nonident_args(Array::get(cargs, ci), out, out_pos)\n        ci = ci + 1\n      }\n      0\n    },\n    ETuple(items) => ca_collect_nonident_args_list(items, out, out_pos),\n    EArray(items) => ca_collect_nonident_args_list(items, out, out_pos),\n    ERecord(_, rfields, _) => {\n      let mut ri = 0\n      while ri < Array::length(rfields) {\n        let (_, rv) = Array::get(rfields, ri)\n        let _ = ca_collect_nonident_args(rv, out, out_pos)\n        ri = ri + 1\n      }\n      0\n    },\n    EMap(mfields) => {\n      let mut mi = 0\n      while mi < Array::length(mfields) {\n        let (_, mv) = Array::get(mfields, mi)\n        let _ = ca_collect_nonident_args(mv, out, out_pos)\n        mi = mi + 1\n      }\n      0\n    },\n    EIf(c0, t0, f0) => {\n      let _ = ca_collect_nonident_args(c0, out, out_pos)\n      let _ = ca_collect_nonident_args(t0, out, out_pos)\n      ca_collect_nonident_args(f0, out, out_pos)\n    },\n    ELet(_, v0, b0, _) => {\n      let _ = ca_collect_nonident_args(v0, out, out_pos)\n      ca_collect_nonident_args(b0, out, out_pos)\n    },\n    ELetRec(_, v0, b0) => {\n      let _ = ca_collect_nonident_args(v0, out, out_pos)\n      ca_collect_nonident_args(b0, out, out_pos)\n    },\n    ELetMut(_, v0, b0, _) => {\n      let _ = ca_collect_nonident_args(v0, out, out_pos)\n      ca_collect_nonident_args(b0, out, out_pos)\n    },\n    EAssign(_, v0, b0) => {\n      let _ = ca_collect_nonident_args(v0, out, out_pos)\n      ca_collect_nonident_args(b0, out, out_pos)\n    },\n    EAssignOp(_, _, v0, b0) => {\n      let _ = ca_collect_nonident_args(v0, out, out_pos)\n      ca_collect_nonident_args(b0, out, out_pos)\n    },\n    ESeq(a0, b0) => {\n      let _ = ca_collect_nonident_args(a0, out, out_pos)\n      ca_collect_nonident_args(b0, out, out_pos)\n    },\n    EMatch(scr, arms) => {\n      let _ = ca_collect_nonident_args(scr, out, out_pos)\n      let mut ai = 0\n      while ai < Array::length(arms) {\n        let (_, ab) = Array::get(arms, ai)\n        let _ = ca_collect_nonident_args(ab, out, out_pos)\n        ai = ai + 1\n      }\n      0\n    },\n    EHandle(hb, harms) => {\n      let _ = ca_collect_nonident_args(hb, out, out_pos)\n      let mut hi = 0\n      while hi < Array::length(harms) {\n        let (_, hab) = Array::get(harms, hi)\n        let _ = ca_collect_nonident_args(hab, out, out_pos)\n        hi = hi + 1\n      }\n      0\n    },\n    EWhile(c0, b0) => {\n      let _ = ca_collect_nonident_args(c0, out, out_pos)\n      ca_collect_nonident_args(b0, out, out_pos)\n    },\n    ELoop(inits, b0) => {\n      let mut li = 0\n      while li < Array::length(inits) {\n        let (_, iv) = Array::get(inits, li)\n        let _ = ca_collect_nonident_args(iv, out, out_pos)\n        li = li + 1\n      }\n      ca_collect_nonident_args(b0, out, out_pos)\n    },\n    EForIn(_, _, s0, b0) => {\n      let _ = ca_collect_nonident_args(s0, out, out_pos)\n      ca_collect_nonident_args(b0, out, out_pos)\n    },\n    EBinOp(_, a0, b0) => {\n      let _ = ca_collect_nonident_args(a0, out, out_pos)\n      ca_collect_nonident_args(b0, out, out_pos)\n    },\n    EUnaryOp(_, a0) => ca_collect_nonident_args(a0, out, out_pos),\n    EFn(_, _, _, _, _, fb) => ca_collect_nonident_args(fb, out, out_pos),\n    EDot(o0, _, _, _) => ca_collect_nonident_args(o0, out, out_pos),\n    ELabeledArg(_, _, v0) => ca_collect_nonident_args(v0, out, out_pos),\n    EReturn(v0) => ca_collect_nonident_args(v0, out, out_pos),\n    EBreak(bo) => match bo {\n      Some(bv) => ca_collect_nonident_args(bv, out, out_pos),\n      None => 0\n    },\n    EContinue(cvs) => ca_collect_nonident_args_list(cvs, out, out_pos),\n    ESpread(sv) => ca_collect_nonident_args(sv, out, out_pos)\n  }\n}\n\nfn ca_collect_nonident_args_list(items: Array[Expr], out: Array[String], out_pos: Array[Int]) -> Int {\n  let mut i = 0\n  while i < Array::length(items) {\n    let _ = ca_collect_nonident_args(Array::get(items, i), out, out_pos)\n    i = i + 1\n  }\n  0\n}\n\nfn ca_walk_stmts_nonident_args(stmts: Array[Stmt], out: Array[String], out_pos: Array[Int]) -> Int {\n  let mut si = 0\n  while si < Array::length(stmts) {\n    match Array::get(stmts, si) {\n      SLet(_, _, _, _, lv) => {\n        let _ = ca_collect_nonident_args(lv, out, out_pos)\n        0\n      },\n      SLetMut(_, _, lv) => {\n        let _ = ca_collect_nonident_args(lv, out, out_pos)\n        0\n      },\n      SLetPat(_, lv) => {\n        let _ = ca_collect_nonident_args(lv, out, out_pos)\n        0\n      },\n      SExpr(se) => {\n        let _ = ca_collect_nonident_args(se, out, out_pos)\n        0\n      },\n      STest(_, tb) => {\n        let _ = ca_collect_nonident_args(tb, out, out_pos)\n        0\n      },\n      SBench(_, bb) => {\n        let _ = ca_collect_nonident_args(bb, out, out_pos)\n        0\n      },\n      SModule(_, _, mb) => ca_walk_stmts_nonident_args(mb, out, out_pos),\n      _ => 0\n    }\n    si = si + 1\n  }\n  0\n}\n\nexport fn bmask_max_param() -> Int {\n  32\n}\n\nexport fn bmask_has(mask: Int, i: Int) -> Bool {\n  i >= 0 && i < 32 && ((mask>>i)&1) == 1\n}\n\nfn bp_param_base_name(raw: String) -> String {\n  let l = String::length(raw)\n  if l > 0 {\n    let c = String::char_code_at(raw, l - 1)\n    if c == '~' || c == '?' {\n      raw[0: l - 1]\n    } else {\n      raw\n    }\n  } else {\n    raw\n  }\n}\n\nexport fn compute_borrow_param_user_fns(stmts: Array[Stmt], exclude: Array[String], out_masks: Array[Int]) -> Array[String] {\n  let valued = array_empty()\n  let _ = ca_walk_stmts_valued(stmts, valued)\n  let nonident_fns = array_empty()\n  let nonident_pos = array_empty()\n  let _ = ca_walk_stmts_nonident_args(stmts, nonident_fns, nonident_pos)\n  let nonident: HashMap[String, Int] = HashMap::new_string()\n  let mut ni = 0\n  while ni < Array::length(nonident_fns) {\n    let nf = Array::get(nonident_fns, ni)\n    let np = Array::get(nonident_pos, ni)\n    let prev = match HashMap::get(nonident, nf) {\n      Some(m) => m,\n      None => 0\n    }\n    if np >= 0 && np < bmask_max_param() {\n      HashMap::set(nonident, nf, prev|(1<<np))\n    } else {\n      ()\n    }\n    ni = ni + 1\n  }\n  let valued_srt = sorted_names_of(valued)\n  let excluded_srt = sorted_names_of(exclude)\n  let names = array_empty()\n  let masks: HashMap[String, Int] = HashMap::new_string()\n  let mut si = 0\n  while si < Array::length(stmts) {\n    match Array::get(stmts, si) {\n      SLet(_, _, fname, _, fval) => match fval {\n        EFn(_, _, fps, _, _, fbody) => if bsearch_leftmost(valued_srt, fname) < 0 && bsearch_leftmost(excluded_srt, fname) < 0 {\n          let owned_bits = match HashMap::get(nonident, fname) {\n            Some(m) => m,\n            None => 0\n          }\n          let mut mask = 0\n          let mut pi = 0\n          let np = Array::length(fps)\n          let lim = if np < bmask_max_param() {\n            np\n          } else {\n            bmask_max_param()\n          }\n          while pi < lim {\n            let (praw, _) = Array::get(fps, pi)\n            let pn = bp_param_base_name(praw)\n            if pn != \"\" && !bmask_has(owned_bits, pi) && md_consume_count(fbody, pn) == 0 && !is_mut_captured_in(fbody, pn) {\n              mask = mask|(1<<pi)\n            } else {\n              ()\n            }\n            pi = pi + 1\n          }\n          if mask != 0 {\n            Array::push(names, fname)\n            HashMap::set(masks, fname, mask)\n          } else {\n            ()\n          }\n        } else {\n          ()\n        },\n        _ => ()\n      },\n      _ => ()\n    }\n    si = si + 1\n  }\n  let names_srt = sorted_names_of(names)\n  let mut oi = 0\n  while oi < Array::length(names_srt) {\n    Array::push(out_masks, match HashMap::get(masks, Array::get(names_srt, oi)) {\n      Some(m) => m,\n      None => 0\n    })\n    oi = oi + 1\n  }\n  names_srt\n}\n\n\nfn mrv_gen_has(m: HashMap[String, Int], gen: Int, name: String) -> Bool {\n  match HashMap::get(m, name) {\n    Some(g) => g == gen,\n    None => false\n  }\n}\n\nfn mrv_is_fresh_name(fresh_names: HashMap[String, Int], tainted: HashMap[String, Int], gen: Int, name: String) -> Bool {\n  mrv_gen_has(fresh_names, gen, name) && !mrv_gen_has(tainted, gen, name)\n}\n\nfn mrv_fresh(e: Expr, fresh_names: HashMap[String, Int], tainted: HashMap[String, Int], bound: Array[String], gen: Int, user_fns_srt: Array[String], view_set: HashSet[String], ret_view: Array[Int]) -> Bool {\n  match e {\n    EInt(_) => true,\n    EFloat(_) => true,\n    EString(_) => true,\n    EBool(_) => true,\n    EUnit => true,\n    EStringInterp(_) => true,\n    EIdent(n, _) => mrv_is_fresh_name(fresh_names, tainted, gen, n),\n    ETuple(items) => {\n      let mut i = 0\n      while i < Array::length(items) {\n        let _ = mrv_fresh(Array::get(items, i), fresh_names, tainted, bound, gen, user_fns_srt, view_set, ret_view)\n        i = i + 1\n      }\n      true\n    },\n    EArray(items) => {\n      let mut i = 0\n      while i < Array::length(items) {\n        let _ = mrv_fresh(Array::get(items, i), fresh_names, tainted, bound, gen, user_fns_srt, view_set, ret_view)\n        i = i + 1\n      }\n      true\n    },\n    ERecord(_, fields, _) => {\n      let mut i = 0\n      while i < Array::length(fields) {\n        let (_, v) = Array::get(fields, i)\n        let _ = mrv_fresh(v, fresh_names, tainted, bound, gen, user_fns_srt, view_set, ret_view)\n        i = i + 1\n      }\n      true\n    },\n    EMap(fields) => {\n      let mut i = 0\n      while i < Array::length(fields) {\n        let (_, v) = Array::get(fields, i)\n        let _ = mrv_fresh(v, fresh_names, tainted, bound, gen, user_fns_srt, view_set, ret_view)\n        i = i + 1\n      }\n      true\n    },\n    EIf(c, t, el) => {\n      let _ = mrv_fresh(c, fresh_names, tainted, bound, gen, user_fns_srt, view_set, ret_view)\n      let tf = mrv_fresh(t, fresh_names, tainted, bound, gen, user_fns_srt, view_set, ret_view)\n      let ef = mrv_fresh(el, fresh_names, tainted, bound, gen, user_fns_srt, view_set, ret_view)\n      tf && ef\n    },\n    ELet(n, v, b, _) => {\n      let vf = mrv_fresh(v, fresh_names, tainted, bound, gen, user_fns_srt, view_set, ret_view)\n      Array::push(bound, n)\n      if vf {\n        HashMap::set(fresh_names, n, gen)\n      } else {\n        HashMap::set(tainted, n, gen)\n      }\n      mrv_fresh(b, fresh_names, tainted, bound, gen, user_fns_srt, view_set, ret_view)\n    },\n    ELetMut(n, v, b, _) => {\n      let vf = mrv_fresh(v, fresh_names, tainted, bound, gen, user_fns_srt, view_set, ret_view)\n      Array::push(bound, n)\n      if vf {\n        HashMap::set(fresh_names, n, gen)\n      } else {\n        HashMap::set(tainted, n, gen)\n      }\n      mrv_fresh(b, fresh_names, tainted, bound, gen, user_fns_srt, view_set, ret_view)\n    },\n    ELetRec(n, v, b) => {\n      let _ = mrv_fresh(v, fresh_names, tainted, bound, gen, user_fns_srt, view_set, ret_view)\n      Array::push(bound, n)\n      HashMap::set(fresh_names, n, gen)\n      mrv_fresh(b, fresh_names, tainted, bound, gen, user_fns_srt, view_set, ret_view)\n    },\n    EAssign(n, v, b) => {\n      let vf = mrv_fresh(v, fresh_names, tainted, bound, gen, user_fns_srt, view_set, ret_view)\n      if vf {\n        ()\n      } else {\n        HashMap::set(tainted, n, gen)\n      }\n      mrv_fresh(b, fresh_names, tainted, bound, gen, user_fns_srt, view_set, ret_view)\n    },\n    EAssignOp(_, _, v, b) => {\n      let _ = mrv_fresh(v, fresh_names, tainted, bound, gen, user_fns_srt, view_set, ret_view)\n      mrv_fresh(b, fresh_names, tainted, bound, gen, user_fns_srt, view_set, ret_view)\n    },\n    ESeq(a, b) => {\n      let _ = mrv_fresh(a, fresh_names, tainted, bound, gen, user_fns_srt, view_set, ret_view)\n      mrv_fresh(b, fresh_names, tainted, bound, gen, user_fns_srt, view_set, ret_view)\n    },\n    EMatch(s, arms) => {\n      let _ = mrv_fresh(s, fresh_names, tainted, bound, gen, user_fns_srt, view_set, ret_view)\n      let mut all = true\n      let mut i = 0\n      while i < Array::length(arms) {\n        let (p, v) = Array::get(arms, i)\n        let _ = collect_pattern_bindings(p, bound)\n        if mrv_fresh(v, fresh_names, tainted, bound, gen, user_fns_srt, view_set, ret_view) {\n          ()\n        } else {\n          all = false\n        }\n        i = i + 1\n      }\n      all\n    },\n    EHandle(s, arms) => {\n      let _ = mrv_fresh(s, fresh_names, tainted, bound, gen, user_fns_srt, view_set, ret_view)\n      let mut all = true\n      let mut i = 0\n      while i < Array::length(arms) {\n        let (p, v) = Array::get(arms, i)\n        let _ = collect_pattern_bindings(p, bound)\n        if mrv_fresh(v, fresh_names, tainted, bound, gen, user_fns_srt, view_set, ret_view) {\n          ()\n        } else {\n          all = false\n        }\n        i = i + 1\n      }\n      all\n    },\n    EWhile(c, b) => {\n      let _ = mrv_fresh(c, fresh_names, tainted, bound, gen, user_fns_srt, view_set, ret_view)\n      let _ = mrv_fresh(b, fresh_names, tainted, bound, gen, user_fns_srt, view_set, ret_view)\n      true\n    },\n    ELoop(params, b) => {\n      let mut i = 0\n      while i < Array::length(params) {\n        let (pn, pv) = Array::get(params, i)\n        let _ = mrv_fresh(pv, fresh_names, tainted, bound, gen, user_fns_srt, view_set, ret_view)\n        Array::push(bound, pn)\n        i = i + 1\n      }\n      let _ = mrv_fresh(b, fresh_names, tainted, bound, gen, user_fns_srt, view_set, ret_view)\n      false\n    },\n    EForIn(n1, n2, it, b) => {\n      let _ = mrv_fresh(it, fresh_names, tainted, bound, gen, user_fns_srt, view_set, ret_view)\n      Array::push(bound, n1)\n      match n2 {\n        Some(n2s) => Array::push(bound, n2s),\n        None => ()\n      }\n      let _ = mrv_fresh(b, fresh_names, tainted, bound, gen, user_fns_srt, view_set, ret_view)\n      true\n    },\n    ECall(callee, args, _) => {\n      let mut i = 0\n      while i < Array::length(args) {\n        let _ = mrv_fresh(Array::get(args, i), fresh_names, tainted, bound, gen, user_fns_srt, view_set, ret_view)\n        i = i + 1\n      }\n      match callee {\n        EIdent(f, _) => if array_contains_str(bound, f) {\n          false\n        } else if bsearch_leftmost(user_fns_srt, f) >= 0 {\n          !HashSet::has(view_set, f)\n        } else if borrow_ret_builtin_name(f) {\n          false\n        } else {\n          true\n        },\n        _ => {\n          let _ = mrv_fresh(callee, fresh_names, tainted, bound, gen, user_fns_srt, view_set, ret_view)\n          false\n        }\n      }\n    },\n    EBinOp(_, l, r) => {\n      let _ = mrv_fresh(l, fresh_names, tainted, bound, gen, user_fns_srt, view_set, ret_view)\n      let _ = mrv_fresh(r, fresh_names, tainted, bound, gen, user_fns_srt, view_set, ret_view)\n      true\n    },\n    EUnaryOp(_, x) => {\n      let _ = mrv_fresh(x, fresh_names, tainted, bound, gen, user_fns_srt, view_set, ret_view)\n      true\n    },\n    EFn(_, _, fps, _, _, body) => {\n      let mut i = 0\n      while i < Array::length(fps) {\n        let (pn, _) = Array::get(fps, i)\n        Array::push(bound, pn)\n        i = i + 1\n      }\n      let dummy_ret = [\n        0\n      ]\n      let _ = mrv_fresh(body, fresh_names, tainted, bound, gen, user_fns_srt, view_set, dummy_ret)\n      true\n    },\n    EDot(x, _, _, _) => {\n      let _ = mrv_fresh(x, fresh_names, tainted, bound, gen, user_fns_srt, view_set, ret_view)\n      false\n    },\n    ELabeledArg(_, _, v) => mrv_fresh(v, fresh_names, tainted, bound, gen, user_fns_srt, view_set, ret_view),\n    EReturn(x) => {\n      if mrv_fresh(x, fresh_names, tainted, bound, gen, user_fns_srt, view_set, ret_view) {\n        ()\n      } else {\n        Array::set(ret_view, 0, 1)\n      }\n      true\n    },\n    EBreak(opt) => {\n      let _ = match opt {\n        Some(v) => mrv_fresh(v, fresh_names, tainted, bound, gen, user_fns_srt, view_set, ret_view),\n        None => true\n      }\n      true\n    },\n    EContinue(args) => {\n      let mut i = 0\n      while i < Array::length(args) {\n        let _ = mrv_fresh(Array::get(args, i), fresh_names, tainted, bound, gen, user_fns_srt, view_set, ret_view)\n        i = i + 1\n      }\n      true\n    },\n    ESpread(x) => mrv_fresh(x, fresh_names, tainted, bound, gen, user_fns_srt, view_set, ret_view)\n  }\n}\n\nexport fn compute_may_return_view_fns(stmts: Array[Stmt]) -> Array[String] {\n  let user_fns = array_empty()\n  let mut ci = 0\n  while ci < Array::length(stmts) {\n    match Array::get(stmts, ci) {\n      SLet(_, _, fname, _, fval) => match fval {\n        EFn(_, _, _, _, _, _) => Array::push(user_fns, fname),\n        _ => ()\n      },\n      _ => ()\n    }\n    ci = ci + 1\n  }\n  let user_fns_srt = sorted_names_of(user_fns)\n  let view_set = array_empty()\n  let view_seen = HashSet::new_string()\n  let fresh_names: HashMap[String, Int] = HashMap::new_string()\n  let tainted: HashMap[String, Int] = HashMap::new_string()\n  let bound = array_empty()\n  let mut gen = 0\n  let mut changed = true\n  let mut rounds = 0\n  while changed && rounds < 10 {\n    changed = false\n    let mut si = 0\n    while si < Array::length(stmts) {\n      match Array::get(stmts, si) {\n        SLet(_, _, fname, _, fval) => match fval {\n          EFn(_, _, fps, _, _, fbody) => if HashSet::has(view_seen, fname) {\n            ()\n          } else {\n            gen = gen + 1\n            Array::truncate(bound, 0)\n            let mut pi = 0\n            while pi < Array::length(fps) {\n              let (pn, _) = Array::get(fps, pi)\n              Array::push(bound, pn)\n              pi = pi + 1\n            }\n            let ret_view = [\n              0\n            ]\n            let tail_fresh = mrv_fresh(fbody, fresh_names, tainted, bound, gen, user_fns_srt, view_seen, ret_view)\n            if !tail_fresh || Array::get(ret_view, 0) == 1 {\n              Array::push(view_set, fname)\n              HashSet::add(view_seen, fname)\n              changed = true\n            } else {\n              ()\n            }\n          },\n          _ => ()\n        },\n        _ => ()\n      }\n      si = si + 1\n    }\n    rounds = rounds + 1\n  }\n  view_set\n}\n\n\nexport fn count_lambda_sites_expr(expr: Expr) -> Int {\n  match expr {\n    EIdent(_, _) => 0,\n    EInt(_) => 0,\n    EFloat(_) => 0,\n    EString(_) => 0,\n    EBool(_) => 0,\n    EUnit => 0,\n    EStringInterp(_) => 0,\n    EBreak(_) => 0,\n    EContinue(_) => 0,\n    EReturn(e) => count_lambda_sites_expr(e),\n    EUnaryOp(_, e) => count_lambda_sites_expr(e),\n    ESpread(e) => count_lambda_sites_expr(e),\n    EDot(obj, _, _, _) => count_lambda_sites_expr(obj),\n    ELabeledArg(_, _, e) => count_lambda_sites_expr(e),\n    ETuple(items) => count_lambda_sites_exprs(items),\n    EArray(items) => count_lambda_sites_exprs(items),\n    ERecord(_, fields, _) => count_lambda_sites_fields(fields),\n    EMap(fields) => count_lambda_sites_fields(fields),\n    EBinOp(_, l, r) => count_lambda_sites_expr(l) + count_lambda_sites_expr(r),\n    ESeq(l, r) => count_lambda_sites_expr(l) + count_lambda_sites_expr(r),\n    ECall(callee, args, _) => count_lambda_sites_expr(callee) + count_lambda_sites_exprs(args),\n    EIf(cond, then_e, else_e) =>\n    count_lambda_sites_expr(cond) + count_lambda_sites_expr(then_e) + count_lambda_sites_expr(else_e),\n    ELet(_, val, body, _) => count_lambda_sites_expr(val) + count_lambda_sites_expr(body),\n    ELetRec(_, val, body) => count_lambda_sites_expr(val) + count_lambda_sites_expr(body),\n    ELetMut(_, val, body, _) => count_lambda_sites_expr(val) + count_lambda_sites_expr(body),\n    EAssign(_, val, body) => count_lambda_sites_expr(val) + count_lambda_sites_expr(body),\n    EAssignOp(_, _, val, body) => count_lambda_sites_expr(val) + count_lambda_sites_expr(body),\n    EWhile(cond, body) => count_lambda_sites_expr(cond) + count_lambda_sites_expr(body),\n    EForIn(_, _, iter, body) => count_lambda_sites_expr(iter) + count_lambda_sites_expr(body),\n    ELoop(params, body) => count_lambda_sites_fields(params) + count_lambda_sites_expr(body),\n    EMatch(scr, arms) => count_lambda_sites_expr(scr) + count_lambda_sites_arms(arms),\n    EHandle(body_expr, arms) => count_lambda_sites_expr(body_expr) + count_lambda_sites_arms(arms),\n    EFn(_, _, _, _, _, body) => 1 + count_lambda_sites_expr(body)\n  }\n}\n\nfn count_lambda_sites_exprs(items: Array[Expr]) -> Int {\n  let n = Array::length(items)\n  let mut i = 0\n  let mut total = 0\n  while i < n {\n    total = total + count_lambda_sites_expr(Array::get(items, i))\n    i = i + 1\n  }\n  total\n}\n\nfn count_lambda_sites_fields(fields: Array[(String, Expr)]) -> Int {\n  let n = Array::length(fields)\n  let mut i = 0\n  let mut total = 0\n  while i < n {\n    let (_, val) = Array::get(fields, i)\n    total = total + count_lambda_sites_expr(val)\n    i = i + 1\n  }\n  total\n}\n\nfn count_lambda_sites_arms(arms: Array[(Pat, Expr)]) -> Int {\n  let n = Array::length(arms)\n  let mut i = 0\n  let mut total = 0\n  while i < n {\n    let (_, body) = Array::get(arms, i)\n    total = total + count_lambda_sites_expr(body)\n    i = i + 1\n  }\n  total\n}\n")
}

let source_85 = () -> (String, String) {
  ("lib/@vibe/compiler/perceus/index.vpkg",
"name = @vibe/compiler/perceus\nversion = 0.0.1\ndescription =\n  #|@vibe/compiler/perceus — the RC backend's Perceus dup/drop planner\ndeps = {\n  @vibe/compiler/codegen/common_analysis : 0.0.1\n  @vibe/compiler/core : 0.0.1\n  @vibe/core : 0.2.0\n}\n\ngenerated_hash =\n\n// @vibe/compiler/perceus — the RC backend's Perceus dup/drop planner\n// (count + emit passes over a function body), the program-wide\n// borrow-return / scalar-return / heap-return name scans, and the\n// heap-param elaboration rewrite (ADR-0055/#702..#715 lineage). First\n// COMPILER-INTERNAL contract batch (ADR-0070 Phase 3, #897) — compiled\n// into the compiler itself via compiler_sources_manifest.tsv (group\n// `codegen`, dual-row: this contract + perceus.vibe).\n//\n// The old index.vibe was not a facade but the whole implementation (the\n// package is single-file), so it moved verbatim to perceus.vibe.\n//\n// `PerceusAction` is declared TRANSPARENT (defined verbatim here, deleted\n// from the impl): tests/perceus_rc_test.vibe reads `.kind`/`.name`\n// directly, so the field layout is real public API surface (@vibe/process\n// ShResult precedent, PR #920). `PerceusActionKind` stays `opaque` with\n// its `export enum` kept in perceus.vibe: the impl file itself constructs\n// and pattern-matches PaDup/PaDrop/PaAliasDup, and enum VARIANTS do not\n// resolve across units from a facade-only definition (@vibe/json\n// precedent — \"unknown name: JNull\"). Consumers keep full variant\n// visibility through the same #716 re-export machinery as before.\n//\n// `PCtx` (the planner's mutable count/emit state, parameter of\n// pc_emit/pc_count) is intentionally NOT declared: it was never exported\n// by the old index.vibe either — the exported pc_emit/pc_count signatures\n// name it as structural signature text only, and conformance compares\n// signatures textually, so declaring it `opaque` would have forced a new\n// `export struct PCtx` (a surface WIDENING this migration must not make).\n// No `version` binding existed (compiler-internal package).\n\nopaque type PerceusActionKind\n\nstruct PerceusAction {\n  kind: PerceusActionKind;\n  name: String\n}\n\n// --- plan-action predicates\nfn pa_is_dup(a: PerceusAction) -> Bool\nfn pa_is_drop(a: PerceusAction) -> Bool\nfn pa_is_alias_dup(a: PerceusAction) -> Bool\n\n// --- program-wide name scans (threaded into every function's plan)\nfn compute_borrow_returning_names(stmts: Array[Stmt]) -> Array[String]\nfn compute_scalar_returning_names(stmts: Array[Stmt]) -> Array[String]\nfn compute_heap_returning(stmts: Array[Stmt]) -> Array[String]\n\n// --- heap-ness classification\nfn type_expr_is_heap(ot: Option[TypeExpr]) -> Bool\nfn param_is_heap_in_body(name: String, otype: Option[TypeExpr], body: Expr) -> Bool\n\n// --- planner passes and entry points\nfn pc_count(ctx: PCtx, scope: Map[String, Int], expr: Expr) -> Int\nfn pc_emit(ctx: PCtx, scope: Map[String, Int], expr: Expr) -> Int\nfn build_perceus_plan(body: Expr) -> Array[PerceusAction]\nfn build_perceus_plan_with_params(params: Array[(String, Option[TypeExpr])], body: Expr, borrow_ret_names: Array[String], borrow_param_fns: Array[String], borrow_param_masks: Array[Int], view_ret_fns: Array[String]) -> Array[PerceusAction]\n\n// --- heap-param elaboration (run at the head of the RC pipeline)\nfn elaborate_heap_params(stmts: Array[Stmt]) -> Array[Stmt]\n")
}

let source_86 = () -> (String, String) {
  ("lib/@vibe/compiler/perceus/perceus.vibe",
"\nimport @vibe/compiler/codegen/common_analysis {\n  collect_free_vars\n}\n\nimport @vibe/core {\n  array_empty\n}\n\nimport @vibe/compiler/core {\n  Expr, Pat, Stmt, TypeExpr, bsearch_leftmost, is_exception_throw_operation\n}\n\n\nexport enum PerceusActionKind {\n  PaDup;\n  PaDrop;\n  PaAliasDup\n}\n\n\nstruct PCtx {\n  mut next_id: Int;\n  mut seq_id: Int;\n  pctx_names: Array[String];\n  borrow_param_user: Array[String];\n  borrow_param_mask: Array[Int];\n  view_ret_user: Array[String];\n  uses: Array[Int];\n  borrows: Array[Int];\n  scalar: Array[Bool];\n  remaining: Array[Int];\n  view_call_let: Array[Bool];\n  actions: Array[PerceusAction]\n}\n\nstruct HeapInferCtx {\n  ctors: Array[String];\n  heap_fns: Array[String]\n}\n\n\nfn zeros(n: Int) -> Array[Int] {\n  let out: Array[Int] = [\n  ]\n  let mut i = 0\n  while i < n {\n    Array::push(out, 0)\n    i = i + 1\n  }\n  out\n}\n\nfn int_max(a: Int, b: Int) -> Int {\n  if a > b {\n    a\n  } else {\n    b\n  }\n}\n\nfn name_in(arr: Array[String], s: String) -> Bool {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(arr) {\n    if Array::get(arr, i) == s {\n      found = true\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  found\n}\n\nfn pe_push(ctx: PCtx, kind: PerceusActionKind, name: String) -> Int {\n  Array::push(ctx.actions, PerceusAction::{\n    kind: kind, name: name\n  })\n  0\n}\n\nfn pe_use(ctx: PCtx, scope: Map[String, Int], name: String) -> Int {\n  if Map::has_key(scope, name) {\n    let id = Map::get(scope, name)\n    let rem = Array::get(ctx.remaining, id)\n    let last_view_use = rem == 1 && Array::get(ctx.view_call_let, id)\n    if (rem > 1 || last_view_use) && !Array::get(ctx.scalar, id) {\n      pe_push(ctx, PaDup, name)\n    } else {\n      0\n    }\n    if rem > 0 {\n      Array::set(ctx.remaining, id, rem - 1)\n    }\n  }\n  0\n}\n\nfn pctx_new(borrow_ret_names: Array[String], borrow_param_fns: Array[String], borrow_param_masks: Array[Int], view_ret_fns: Array[String]) -> PCtx {\n  PCtx::{\n    next_id: 0,\n    seq_id: 0,\n    pctx_names: Array::slice(borrow_ret_names, 0, Array::length(borrow_ret_names)),\n    borrow_param_user: Array::slice(borrow_param_fns, 0, Array::length(borrow_param_fns)),\n    borrow_param_mask: Array::slice(borrow_param_masks, 0, Array::length(borrow_param_masks)),\n    view_ret_user: Array::slice(view_ret_fns, 0, Array::length(view_ret_fns)),\n    uses: [\n    ],\n    borrows: [\n    ],\n    scalar: [\n    ],\n    remaining: [\n    ],\n    view_call_let: [\n    ],\n    actions: [\n    ],\n  }\n}\n\nfn copy_ints(src: Array[Int]) -> Array[Int] {\n  Array::slice(src, 0, Array::length(src))\n}\n\nexport fn pa_is_dup(a: PerceusAction) -> Bool {\n  match a.kind {\n    PaDup => true,\n    PaDrop => false,\n    PaAliasDup => false\n  }\n}\n\nfn pat_names(pat: Pat, out: Array[String]) -> Int {\n  match pat {\n    PBind(name) => {\n      Array::push(out, name)\n      0\n    },\n    PCtor(_n, args) => {\n      let mut i = 0\n      while i < Array::length(args) {\n        pat_names(Array::get(args, i), out)\n        i = i + 1\n      }\n      0\n    },\n    PTuple(pats) => {\n      let mut i = 0\n      while i < Array::length(pats) {\n        pat_names(Array::get(pats, i), out)\n        i = i + 1\n      }\n      0\n    },\n    POr(l, _r) => pat_names(l, out),\n    PStruct(_n, fields) => {\n      let mut i = 0\n      while i < Array::length(fields) {\n        pat_names((Array::get(fields, i)).1, out)\n        i = i + 1\n      }\n      0\n    },\n    _ => 0\n  }\n}\n\nexport fn pa_is_drop(a: PerceusAction) -> Bool {\n  match a.kind {\n    PaDrop => true,\n    PaDup => false,\n    PaAliasDup => false\n  }\n}\n\nfn pc_declare(ctx: PCtx, _name: String, scalar: Bool) -> Int {\n  let id = ctx.next_id\n  Array::push(ctx.uses, 0)\n  Array::push(ctx.borrows, 0)\n  Array::push(ctx.scalar, scalar)\n  Array::push(ctx.view_call_let, false)\n  ctx.next_id = id + 1\n  id\n}\n\nfn pctx_mark_view_call(ctx: PCtx, scope: Map[String, Int], id: Int, value: Expr) -> Int {\n  match value {\n    ECall(vc, _, _) => match vc {\n      EIdent(vf, _) => if !Map::has_key(scope, vf) && bsearch_leftmost(ctx.view_ret_user, vf) >= 0 {\n        Array::set(ctx.view_call_let, id, true)\n      } else {\n        ()\n      },\n      _ => ()\n    },\n    _ => ()\n  }\n  0\n}\n\nfn pe_declare(ctx: PCtx, _name: String) -> Int {\n  let id = ctx.next_id\n  let owning = Array::get(ctx.uses, id)\n  let init = if owning == 0 {\n    1\n  } else {\n    owning\n  }\n  Array::push(ctx.remaining, init)\n  ctx.next_id = id + 1\n  id\n}\n\nfn pc_count_use(ctx: PCtx, scope: Map[String, Int], name: String) -> Int {\n  if Map::has_key(scope, name) {\n    let id = Map::get(scope, name)\n    Array::set(ctx.uses, id, Array::get(ctx.uses, id) + 1)\n  }\n  0\n}\n\nfn pe_scope_end(ctx: PCtx, id: Int, name: String) -> Int {\n  if Array::get(ctx.remaining, id) > 0 && !Array::get(ctx.scalar, id) {\n    if Array::get(ctx.view_call_let, id) {\n      ()\n    } else {\n      pe_push(ctx, PaDrop, name)\n    }\n    Array::set(ctx.remaining, id, 0)\n  }\n  0\n}\n\nfn next_seq_name(ctx: PCtx) -> String {\n  let nm = \"__seq\" + __to_string(ctx.seq_id)\n  ctx.seq_id = ctx.seq_id + 1\n  nm\n}\n\nfn fn_param_names(params: Array[(String, Option[TypeExpr])]) -> Array[String] {\n  let out: Array[String] = [\n  ]\n  let mut i = 0\n  while i < Array::length(params) {\n    Array::push(out, (Array::get(params, i)).0)\n    i = i + 1\n  }\n  out\n}\n\nfn is_v128_box_call(fname: String) -> Bool {\n  fname == \"v128_load\" || fname == \"v128_splat_i8x16\" || fname == \"v128_eq_i8x16\" || fname == \"v128_le_u_i8x16\" || fname == \"v128_ge_u_i8x16\" || fname == \"v128_and\" || fname == \"v128_or\" || fname == \"v128_not\"\n}\n\nfn array_contains_str_pctx(arr: Array[String], s: String) -> Bool {\n  let n = Array::length(arr)\n  let mut i = 0\n  let mut found = false\n  while !found && i < n {\n    if Array::get(arr, i) == s {\n      found = true\n    } else {\n      i = i + 1\n    }\n  }\n  found\n}\n\nfn is_borrow_ret_fname(ctx: PCtx, fname: String) -> Bool {\n  fname == \"Array::get\" || fname == \"Map::get\" || fname == \"__index\" || fname == \"__rec_field\" || bsearch_leftmost(ctx.pctx_names, fname) >= 0\n}\n\nfn tail_is_borrow_ret_safe(known: Array[String], e0: Expr) -> Bool {\n  let worklist = [\n    e0\n  ]\n  let mut all_safe = true\n  let mut i = 0\n  while i < Array::length(worklist) {\n    match Array::get(worklist, i) {\n      ELet(_, _, b, _) => Array::push(worklist, b),\n      ELetMut(_, _, b, _) => Array::push(worklist, b),\n      ELetRec(_, _, b) => Array::push(worklist, b),\n      ESeq(_, b) => Array::push(worklist, b),\n      EAssign(_, _, b) => Array::push(worklist, b),\n      EAssignOp(_, _, _, b) => Array::push(worklist, b),\n      EIf(_, t, el) => {\n        Array::push(worklist, t)\n        Array::push(worklist, el)\n      },\n      EMatch(_, arms) => {\n        let mut ai = 0\n        while ai < Array::length(arms) {\n          let (_p, ae) = Array::get(arms, ai)\n          Array::push(worklist, ae)\n          ai = ai + 1\n        }\n      },\n      ECall(callee_e, cargs, _) =>\n      match callee_e {\n        EIdent(callee, _) =>\n        if callee == \"perform\" && Array::length(cargs) == 1 {\n          let mut op_is_throw = false\n          match Array::get(cargs, 0) {\n            ECall(op_e, _, _) =>\n            match op_e {\n              EIdent(op_n, _) => if is_exception_throw_operation(op_n) {\n                op_is_throw = true\n              } else {\n                ()\n              },\n              _ => ()\n            },\n            _ => ()\n          }\n          if op_is_throw {\n            ()\n          } else if !array_contains_str_pctx(known, callee) {\n            all_safe = false\n          } else {\n            ()\n          }\n        } else if !array_contains_str_pctx(known, callee) {\n          all_safe = false\n        } else {\n          ()\n        },\n        _ => {\n          all_safe = false\n        }\n      },\n      EIdent(_, _) => (),\n      _ => {\n        all_safe = false\n      }\n    }\n    i = i + 1\n  }\n  all_safe\n}\n\nfn strip_wrappers_for_borrow_ret(e: Expr) -> Expr {\n  match e {\n    ELet(_, _, b, _) => strip_wrappers_for_borrow_ret(b),\n    ELetMut(_, _, b, _) => strip_wrappers_for_borrow_ret(b),\n    ELetRec(_, _, b) => strip_wrappers_for_borrow_ret(b),\n    ESeq(_, b) => strip_wrappers_for_borrow_ret(b),\n    EAssign(_, _, b) => strip_wrappers_for_borrow_ret(b),\n    EAssignOp(_, _, _, b) => strip_wrappers_for_borrow_ret(b),\n    _ => e\n  }\n}\n\nexport fn compute_borrow_returning_names(stmts: Array[Stmt]) -> Array[String] {\n  let known: Array[String] = [\n    \"Array::get\",\n    \"Map::get\",\n    \"__index\",\n    \"__rec_field\"\n  ]\n  let mut changed = true\n  while changed {\n    changed = false\n    let mut i = 0\n    while i < Array::length(stmts) {\n      match Array::get(stmts, i) {\n        SLet(_, _, name, _, value) =>\n        if !array_contains_str_pctx(known, name) {\n          match value {\n            EFn(_, _, _, _, _, body) => {\n              let top = strip_wrappers_for_borrow_ret(body)\n              let eligible_shape = match top {\n                ECall(_, _, _) => true,\n                EIf(_, _, _) => true,\n                EMatch(_, _) => true,\n                _ => false\n              }\n              if eligible_shape && tail_is_borrow_ret_safe(known, top) {\n                Array::push(known, name)\n                changed = true\n              } else {\n                ()\n              }\n            },\n            _ => ()\n          }\n        } else {\n          ()\n        },\n        _ => ()\n      }\n      i = i + 1\n    }\n  }\n  known\n}\n\nfn fn_sig_return_type(ty: Option[TypeExpr]) -> Option[TypeExpr] {\n  match ty {\n    Some(t) =>\n    match t {\n      TyFn(_, ret, _) => Some(ret),\n      _ => None\n    },\n    None => None\n  }\n}\n\nexport fn compute_scalar_returning_names(stmts: Array[Stmt]) -> Array[String] {\n  let out: Array[String] = [\n  ]\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SLet(_, _, name, ty, value) =>\n      match value {\n        EFn(_, _, _, _, _, _) =>\n        match fn_sig_return_type(ty) {\n          Some(ret) =>\n          if !type_expr_is_heap(Some(ret)) {\n            Array::push(out, name)\n          } else {\n            ()\n          },\n          None => ()\n        },\n        _ => ()\n      },\n      _ => ()\n    }\n    i = i + 1\n  }\n  out\n}\n\nfn is_scalar_expr(ctx: PCtx, e: Expr) -> Bool {\n  match e {\n    EInt(_) => true,\n    EBool(_) => true,\n    EFloat(_) => true,\n    EUnit => true,\n    ECall(EIdent(fname, _), _, _) => is_v128_box_call(fname) || is_borrow_ret_fname(ctx, fname),\n    _ => false\n  }\n}\n\nfn pat_shadow_env(pat: Pat, env: Map[String, Bool]) -> Map[String, Bool] {\n  let names: Array[String] = [\n  ]\n  pat_names(pat, names)\n  let mut env2 = env\n  let mut j = 0\n  while j < Array::length(names) {\n    env2 = Map::set(env2, Array::get(names, j), false)\n    j = j + 1\n  }\n  env2\n}\n\nfn restore_prefix(dst: Array[Int], src: Array[Int]) -> Int {\n  let mut i = 0\n  while i < Array::length(src) {\n    Array::set(dst, i, Array::get(src, i))\n    i = i + 1\n  }\n  0\n}\n\nfn is_heap_literal(e: Expr) -> Bool {\n  match e {\n    ETuple(_) => true,\n    EArray(_) => true,\n    ERecord(_, _, _) => true,\n    _ => false\n  }\n}\n\nfn is_heap_value(e: Expr, env: Map[String, Bool], hctx: HeapInferCtx) -> Bool {\n  if is_heap_literal(e) {\n    true\n  } else {\n    match e {\n      ECall(callee, args, _) =>\n      match callee {\n        EIdent(c, _) =>\n        if Map::has_key(env, c) {\n          false\n        } else {\n          (Array::length(args) > 0 && name_in(hctx.ctors, c)) ||\n          name_in(hctx.heap_fns, c)\n        },\n        _ => false\n      },\n      _ => false\n    }\n  }\n}\n\nfn arg_class(arg: Expr, env: Map[String, Bool], hctx: HeapInferCtx) -> Bool {\n  if is_heap_value(arg, env, hctx) {\n    true\n  } else {\n    match arg {\n      EIdent(n, _) => if Map::has_key(env, n) {\n        Map::get(env, n)\n      } else {\n        false\n      },\n      _ => false\n    }\n  }\n}\n\nfn analyze_calls(name: String, e_in: Expr, env_in: Map[String, Bool], calls: Array[Array[Bool]], esc: Array[Bool], hctx: HeapInferCtx) -> Int {\n  let mut e = e_in\n  let mut env = env_in\n  let mut looping = true\n  while looping {\n    looping = false\n    match e {\n      EIdent(n, _) => {\n        if n == name {\n          Array::set(esc, 0, true)\n        } else {\n          ()\n        }\n        0\n      },\n      ECall(callee, args, _) => {\n        let is_self = match callee {\n          EIdent(cn, _) => cn == name,\n          _ => false\n        }\n        if is_self {\n          let cls: Array[Bool] = [\n          ]\n          let mut k = 0\n          while k < Array::length(args) {\n            Array::push(cls, arg_class(Array::get(args, k), env, hctx))\n            k = k + 1\n          }\n          Array::push(calls, cls)\n        } else {\n          let _ = analyze_calls(name, callee, env, calls, esc, hctx)\n          ()\n        }\n        let mut i = 0\n        while i < Array::length(args) {\n          analyze_calls(name, Array::get(args, i), env, calls, esc, hctx)\n          i = i + 1\n        }\n        0\n      },\n      EDot(obj, _, _, _) => analyze_calls(name, obj, env, calls, esc, hctx),\n      ELet(n, v, b, _) => {\n        analyze_calls(name, v, env, calls, esc, hctx)\n        env = Map::set(env, n, is_heap_value(v, env, hctx))\n        e = b\n        looping = true\n      },\n      ELetRec(n, v, b) => {\n        env = Map::set(env, n, false)\n        analyze_calls(name, v, env, calls, esc, hctx)\n        e = b\n        looping = true\n      },\n      ELetMut(n, v, b, _) => {\n        analyze_calls(name, v, env, calls, esc, hctx)\n        env = Map::set(env, n, false)\n        e = b\n        looping = true\n      },\n      EAssign(_, v, c) => {\n        analyze_calls(name, v, env, calls, esc, hctx)\n        e = c\n        looping = true\n      },\n      EAssignOp(_, _, v, c) => {\n        analyze_calls(name, v, env, calls, esc, hctx)\n        e = c\n        looping = true\n      },\n      ESeq(a, b) => {\n        analyze_calls(name, a, env, calls, esc, hctx)\n        e = b\n        looping = true\n      },\n      EIf(c, t, el) => {\n        analyze_calls(name, c, env, calls, esc, hctx)\n        analyze_calls(name, t, env, calls, esc, hctx)\n        analyze_calls(name, el, env, calls, esc, hctx)\n        0\n      },\n      EWhile(c, b) => {\n        analyze_calls(name, c, env, calls, esc, hctx)\n        analyze_calls(name, b, env, calls, esc, hctx)\n        0\n      },\n      EForIn(v0, ix, it, b) => {\n        analyze_calls(name, it, env, calls, esc, hctx)\n        let env1 = Map::set(env, v0, false)\n        let env2 = match ix {\n          Some(ixn) => Map::set(env1, ixn, false),\n          None => env1\n        }\n        analyze_calls(name, b, env2, calls, esc, hctx)\n        0\n      },\n      EBinOp(_, l, r) => {\n        analyze_calls(name, l, env, calls, esc, hctx)\n        analyze_calls(name, r, env, calls, esc, hctx)\n        0\n      },\n      EUnaryOp(_, o) => analyze_calls(name, o, env, calls, esc, hctx),\n      EFn(_, _, params, _, _, b) => {\n        let mut env2 = env\n        let mut pi = 0\n        while pi < Array::length(params) {\n          let (pn, _) = Array::get(params, pi)\n          env2 = Map::set(env2, pn, false)\n          pi = pi + 1\n        }\n        analyze_calls(name, b, env2, calls, esc, hctx)\n        0\n      },\n      ETuple(xs) => {\n        let mut i = 0\n        while i < Array::length(xs) {\n          analyze_calls(name, Array::get(xs, i), env, calls, esc, hctx)\n          i = i + 1\n        }\n        0\n      },\n      EArray(xs) => {\n        let mut i = 0\n        while i < Array::length(xs) {\n          analyze_calls(name, Array::get(xs, i), env, calls, esc, hctx)\n          i = i + 1\n        }\n        0\n      },\n      EMatch(s, arms) => {\n        analyze_calls(name, s, env, calls, esc, hctx)\n        let mut i = 0\n        while i < Array::length(arms) {\n          let (pat, ab) = Array::get(arms, i)\n          analyze_calls(name, ab, pat_shadow_env(pat, env), calls, esc, hctx)\n          i = i + 1\n        }\n        0\n      },\n      EHandle(b, arms) => {\n        analyze_calls(name, b, env, calls, esc, hctx)\n        let mut i = 0\n        while i < Array::length(arms) {\n          let (pat, ab) = Array::get(arms, i)\n          analyze_calls(name, ab, pat_shadow_env(pat, env), calls, esc, hctx)\n          i = i + 1\n        }\n        0\n      },\n      ELoop(ps, b) => {\n        let mut env2 = env\n        let mut i = 0\n        while i < Array::length(ps) {\n          let (pn, iv) = Array::get(ps, i)\n          analyze_calls(name, iv, env2, calls, esc, hctx)\n          env2 = Map::set(env2, pn, false)\n          i = i + 1\n        }\n        analyze_calls(name, b, env2, calls, esc, hctx)\n        0\n      },\n      ERecord(_, fs, _) => {\n        let mut i = 0\n        while i < Array::length(fs) {\n          let (_, fv) = Array::get(fs, i)\n          analyze_calls(name, fv, env, calls, esc, hctx)\n          i = i + 1\n        }\n        0\n      },\n      EMap(fs) => {\n        let mut i = 0\n        while i < Array::length(fs) {\n          let (_, fv) = Array::get(fs, i)\n          analyze_calls(name, fv, env, calls, esc, hctx)\n          i = i + 1\n        }\n        0\n      },\n      ELabeledArg(_, _, x) => analyze_calls(name, x, env, calls, esc, hctx),\n      EReturn(x) => analyze_calls(name, x, env, calls, esc, hctx),\n      ESpread(x) => analyze_calls(name, x, env, calls, esc, hctx),\n      EBreak(o) =>\n      match o {\n        Some(x) => analyze_calls(name, x, env, calls, esc, hctx),\n        None => 0\n      },\n      EContinue(xs) => {\n        let mut i = 0\n        while i < Array::length(xs) {\n          analyze_calls(name, Array::get(xs, i), env, calls, esc, hctx)\n          i = i + 1\n        }\n        0\n      },\n      EInt(_) => 0,\n      EFloat(_) => 0,\n      EString(_) => 0,\n      EBool(_) => 0,\n      EStringInterp(_) => 0,\n      EUnit => 0\n    }\n  }\n  0\n}\n\nexport fn pa_is_alias_dup(a: PerceusAction) -> Bool {\n  match a.kind {\n    PaAliasDup => true,\n    PaDup => false,\n    PaDrop => false\n  }\n}\n\nfn pc_count_borrow(ctx: PCtx, scope: Map[String, Int], name: String) -> Int {\n  if Map::has_key(scope, name) {\n    let id = Map::get(scope, name)\n    Array::set(ctx.borrows, id, Array::get(ctx.borrows, id) + 1)\n  }\n  0\n}\n\nfn type_contains_fn(t: TypeExpr) -> Bool {\n  match t {\n    TyFn(_, _, _) => true,\n    TyTuple(elems) => {\n      let mut i = 0\n      let mut found = false\n      while i < Array::length(elems) {\n        if type_contains_fn(Array::get(elems, i)) {\n          found = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      found\n    },\n    TyApp(_, args) => {\n      let mut i = 0\n      let mut found = false\n      while i < Array::length(args) {\n        if type_contains_fn(Array::get(args, i)) {\n          found = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      found\n    },\n    TyName(_) => false,\n    TyUnit => false\n  }\n}\n\nfn all_calls_heap_at(idx: Int, calls: Array[Array[Bool]]) -> Bool {\n  let mut ci = 0\n  let mut all_heap = true\n  while ci < Array::length(calls) {\n    let cls = Array::get(calls, ci)\n    if idx >= Array::length(cls) {\n      all_heap = false\n    } else if !Array::get(cls, idx) {\n      all_heap = false\n    } else {\n      ()\n    }\n    ci = ci + 1\n  }\n  all_heap\n}\n\nfn type_name_is_heap(n: String) -> Bool {\n  if String::length(n) == 0 {\n    false\n  } else {\n    let c0 = String::char_code_at(n, 0)\n    if c0 < 'A' || c0 > 'Z' {\n      false\n    } else if n == \"Int\" || n == \"Bool\" || n == \"Double\" || n == \"Float\" || n == \"String\" || n == \"Bytes\" || n == \"Char\" || n == \"Unit\" || n == \"V128\" {\n      false\n    } else {\n      true\n    }\n  }\n}\n\nexport fn type_expr_is_heap(ot: Option[TypeExpr]) -> Bool {\n  match ot {\n    None => false,\n    Some(t) =>\n    match t {\n      TyFn(_, _, _) => true,\n      _ =>\n      if type_contains_fn(t) {\n        false\n      } else {\n        match t {\n          TyTuple(_) => true,\n          TyApp(_, _) => true,\n          TyName(n) => type_name_is_heap(n),\n          TyFn(_, _, _) => false,\n          TyUnit => false\n        }\n      }\n    }\n  }\n}\n\nexport fn compute_heap_returning(stmts: Array[Stmt]) -> Array[String] {\n  let out: Array[String] = [\n  ]\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SLet(_, _, name, ann, value) => match value {\n        EFn(_, _, _, fn_ret, _, _) => {\n          let ret = match ann {\n            Some(at) => match at {\n              TyFn(_, r, _) => Some(r),\n              _ => fn_ret\n            },\n            None => fn_ret\n          }\n          if type_expr_is_heap(ret) {\n            Array::push(out, name)\n          } else {\n            ()\n          }\n        },\n        _ => ()\n      },\n      _ => ()\n    }\n    i = i + 1\n  }\n  out\n}\n\nfn collect_ctor_names(stmts: Array[Stmt]) -> Array[String] {\n  let out: Array[String] = [\n  ]\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SEnum(_, _, _, variants, _) => {\n        let mut j = 0\n        while j < Array::length(variants) {\n          let (vn, _) = Array::get(variants, j)\n          Array::push(out, vn)\n          j = j + 1\n        }\n      },\n      SSuberror(_, _, variants) => {\n        let mut j = 0\n        while j < Array::length(variants) {\n          let (vn, _) = Array::get(variants, j)\n          Array::push(out, vn)\n          j = j + 1\n        }\n      },\n      _ => ()\n    }\n    i = i + 1\n  }\n  out\n}\n\nfn inferred_heap_type() -> TypeExpr {\n  TyTuple(array_empty())\n}\n\nfn fill_lambda_params(name: String, efn: Expr, body: Expr, hctx: HeapInferCtx) -> Expr {\n  match efn {\n    EFn(tps, bounds, params, ret, eff, fnbody) => {\n      let calls: Array[Array[Bool]] = [\n      ]\n      let esc = [\n        false\n      ]\n      let env0: Map[String, Bool] = Map::new()\n      analyze_calls(name, body, env0, calls, esc, hctx)\n      if Array::get(esc, 0) || Array::length(calls) == 0 {\n        efn\n      } else {\n        let new_params = Array::slice(params, 0, 0)\n        let mut pi = 0\n        while pi < Array::length(params) {\n          let (pname, pty) = Array::get(params, pi)\n          let filled = match pty {\n            Some(_) => (pname, pty),\n            None =>\n            if all_calls_heap_at(pi, calls) {\n              (pname, Some(inferred_heap_type()))\n            } else {\n              (pname, pty)\n            }\n          }\n          Array::push(new_params, filled)\n          pi = pi + 1\n        }\n        EFn(tps, bounds, new_params, ret, eff, fnbody)\n      }\n    },\n    _ => efn\n  }\n}\n\nfn elaborate_rw(e: Expr, hctx: HeapInferCtx) -> Expr {\n  match e {\n    ELet(n, v, b, soff) => {\n      let v2 = elaborate_rw(v, hctx)\n      let v3 = fill_lambda_params(n, v2, b, hctx)\n      ELet(n, v3, elaborate_rw(b, hctx), soff)\n    },\n    ELetRec(n, v, b) => {\n      let v2 = elaborate_rw(v, hctx)\n      let v3 = fill_lambda_params(n, v2, b, hctx)\n      ELetRec(n, v3, elaborate_rw(b, hctx))\n    },\n    ELetMut(n, v, b, soff) => ELetMut(n, elaborate_rw(v, hctx), elaborate_rw(b, hctx), soff),\n    EAssign(n, v, c) => EAssign(n, elaborate_rw(v, hctx), elaborate_rw(c, hctx)),\n    EAssignOp(n, op, v, c) => EAssignOp(n, op, elaborate_rw(v, hctx), elaborate_rw(c, hctx)),\n    ESeq(a, b) => ESeq(elaborate_rw(a, hctx), elaborate_rw(b, hctx)),\n    EIf(c, t, el) => EIf(elaborate_rw(c, hctx), elaborate_rw(t, hctx), elaborate_rw(el, hctx)),\n    EWhile(c, b) => EWhile(elaborate_rw(c, hctx), elaborate_rw(b, hctx)),\n    EForIn(n, ix, it, b) => EForIn(n, ix, elaborate_rw(it, hctx), elaborate_rw(b, hctx)),\n    EFn(tps, bounds, params, ret, eff, fb) =>\n    EFn(tps, bounds, params, ret, eff, elaborate_rw(fb, hctx)),\n    ECall(callee, args, off) => {\n      let new_args = Array::slice(args, 0, 0)\n      let mut i = 0\n      while i < Array::length(args) {\n        Array::push(new_args, elaborate_rw(Array::get(args, i), hctx))\n        i = i + 1\n      }\n      ECall(elaborate_rw(callee, hctx), new_args, off)\n    },\n    EBinOp(op, l, r) => EBinOp(op, elaborate_rw(l, hctx), elaborate_rw(r, hctx)),\n    EUnaryOp(op, o) => EUnaryOp(op, elaborate_rw(o, hctx)),\n    EDot(o, f, off, fdoff) => EDot(elaborate_rw(o, hctx), f, off, fdoff),\n    ETuple(xs) => {\n      let ys = Array::slice(xs, 0, 0)\n      let mut i = 0\n      while i < Array::length(xs) {\n        Array::push(ys, elaborate_rw(Array::get(xs, i), hctx))\n        i = i + 1\n      }\n      ETuple(ys)\n    },\n    EArray(xs) => {\n      let ys = Array::slice(xs, 0, 0)\n      let mut i = 0\n      while i < Array::length(xs) {\n        Array::push(ys, elaborate_rw(Array::get(xs, i), hctx))\n        i = i + 1\n      }\n      EArray(ys)\n    },\n    EMatch(s, arms) => {\n      let new_arms = Array::slice(arms, 0, 0)\n      let mut i = 0\n      while i < Array::length(arms) {\n        let (p, ab) = Array::get(arms, i)\n        Array::push(new_arms, (p, elaborate_rw(ab, hctx)))\n        i = i + 1\n      }\n      EMatch(elaborate_rw(s, hctx), new_arms)\n    },\n    EHandle(b, arms) => {\n      let new_arms = Array::slice(arms, 0, 0)\n      let mut i = 0\n      while i < Array::length(arms) {\n        let (p, ab) = Array::get(arms, i)\n        Array::push(new_arms, (p, elaborate_rw(ab, hctx)))\n        i = i + 1\n      }\n      EHandle(elaborate_rw(b, hctx), new_arms)\n    },\n    ELoop(ps, b) => {\n      let new_ps = Array::slice(ps, 0, 0)\n      let mut i = 0\n      while i < Array::length(ps) {\n        let (pn, iv) = Array::get(ps, i)\n        Array::push(new_ps, (pn, elaborate_rw(iv, hctx)))\n        i = i + 1\n      }\n      ELoop(new_ps, elaborate_rw(b, hctx))\n    },\n    ERecord(rn, fs, targs) => {\n      let new_fs = Array::slice(fs, 0, 0)\n      let mut i = 0\n      while i < Array::length(fs) {\n        let (fn0, fv) = Array::get(fs, i)\n        Array::push(new_fs, (fn0, elaborate_rw(fv, hctx)))\n        i = i + 1\n      }\n      ERecord(rn, new_fs, targs)\n    },\n    EMap(fs) => {\n      let new_fs = Array::slice(fs, 0, 0)\n      let mut i = 0\n      while i < Array::length(fs) {\n        let (fn0, fv) = Array::get(fs, i)\n        Array::push(new_fs, (fn0, elaborate_rw(fv, hctx)))\n        i = i + 1\n      }\n      EMap(new_fs)\n    },\n    ELabeledArg(l, k, x) => ELabeledArg(l, k, elaborate_rw(x, hctx)),\n    EReturn(x) => EReturn(elaborate_rw(x, hctx)),\n    ESpread(x) => ESpread(elaborate_rw(x, hctx)),\n    EBreak(o) =>\n    match o {\n      Some(x) => EBreak(Some(elaborate_rw(x, hctx))),\n      None => EBreak(None)\n    },\n    EContinue(xs) => {\n      let ys = Array::slice(xs, 0, 0)\n      let mut i = 0\n      while i < Array::length(xs) {\n        Array::push(ys, elaborate_rw(Array::get(xs, i), hctx))\n        i = i + 1\n      }\n      EContinue(ys)\n    },\n    EInt(_) => e,\n    EFloat(_) => e,\n    EString(_) => e,\n    EBool(_) => e,\n    EIdent(_, _) => e,\n    EStringInterp(_) => e,\n    EUnit => e\n  }\n}\n\nfn is_borrow_arg0_call(f: String) -> Bool {\n  f == \"__index\" || f == \"Array::get\" || f == \"Array::length\" || f == \"Array::set\" || f == \"Array::push\" || f == \"Array::push_all\" || f == \"ArrayBuilder::push\" || f == \"MutList::push\" || f == \"StringBuilder::push\" || f == \"MapBuilder::set\" || f == \"MapBuilder::has_key\" || f == \"MapBuilder::get\" || f == \"Map::get\" || f == \"Map::keys\" || f == \"Map::has_key\" || f == \"Map::has\" || f == \"Map::set\" || f == \"Map::size\" || f == \"Map::values\" || f == \"Map::delete\" || f == \"Bytes::push\" || f == \"Bytes::set\" || f == \"Bytes::get\" || f == \"Bytes::length\" || f == \"FrozenArray::get\" || f == \"FrozenArray::length\" || f == \"FixedArray::get\" || f == \"FixedArray::set\" || f == \"FixedArray::length\" || f == \"String::join\" || f == \"eq\" || f == \"__rec_field\"\n}\n\nfn pe_bmask_has(mask: Int, i: Int) -> Bool {\n  i >= 0 && i < 32 && ((mask>>i)&1) == 1\n}\n\nfn pe_borrow_mask(ctx: PCtx, scope: Map[String, Int], callee: Expr) -> Int {\n  match callee {\n    EIdent(f, _) => if Map::has_key(scope, f) {\n      0\n    } else {\n      let bi = bsearch_leftmost(ctx.borrow_param_user, f)\n      let user = if bi >= 0 && bi < Array::length(ctx.borrow_param_mask) {\n        Array::get(ctx.borrow_param_mask, bi)\n      } else {\n        0\n      }\n      if is_borrow_arg0_call(f) {\n        user|1\n      } else {\n        user\n      }\n    },\n    _ => 0\n  }\n}\n\nexport fn pc_emit(ctx: PCtx, scope: Map[String, Int], expr: Expr) -> Int {\n  match expr {\n    EInt(_) => 0,\n    EFloat(_) => 0,\n    EString(_) => 0,\n    EBool(_) => 0,\n    EUnit => 0,\n    EStringInterp(_) => 0,\n    EIdent(x, _) => pe_use(ctx, scope, x),\n    ECall(callee, args, _) => {\n      let bmask = pe_borrow_mask(ctx, scope, callee)\n      match callee {\n        EIdent(_, _) => 0,\n        _ => pc_emit(ctx, scope, callee)\n      }\n      let mut i = 0\n      while i < Array::length(args) {\n        let arg = Array::get(args, i)\n        if pe_bmask_has(bmask, i) {\n          match arg {\n            EIdent(_, _) => 0,\n            _ => pc_emit(ctx, scope, arg)\n          }\n        } else {\n          pc_emit(ctx, scope, arg)\n        }\n        i = i + 1\n      }\n      0\n    },\n    EDot(obj, _field, _, _) => match obj {\n      EIdent(_, _) => 0,\n      _ => pc_emit(ctx, scope, obj)\n    }\n    ,\n    ELet(name, value, body, _) => {\n      let mut elide_dead_alias = false\n      match value {\n        EIdent(src, _) => {\n          if Map::has_key(scope, src) {\n            let sid = Map::get(scope, src)\n            let rem = Array::get(ctx.remaining, sid)\n            let src_last_view = rem == 1 && Array::get(ctx.view_call_let, sid)\n            if (rem > 1 || src_last_view) && !Array::get(ctx.scalar, sid) {\n              if Array::get(ctx.uses, ctx.next_id) == 0 {\n                elide_dead_alias = true\n                0\n              } else {\n                pe_push(ctx, PaAliasDup, name)\n              }\n            } else {\n              0\n            }\n            if rem > 0 {\n              Array::set(ctx.remaining, sid, rem - 1)\n            }\n          } else {\n            ()\n          }\n          0\n        },\n        _ => pc_emit(ctx, scope, value)\n      }\n      let id = pe_declare(ctx, name)\n      if elide_dead_alias {\n        Array::set(ctx.remaining, id, 0)\n      }\n      pc_emit(ctx, Map::set(scope, name, id), body)\n      pe_scope_end(ctx, id, name)\n    },\n    ELetMut(name, value, body, _) => {\n      pc_emit(ctx, scope, value)\n      let id = pe_declare(ctx, name)\n      pc_emit(ctx, Map::set(scope, name, id), body)\n      pe_scope_end(ctx, id, name)\n    },\n    ELetRec(name, value, body) => {\n      let id = pe_declare(ctx, name)\n      let s2 = Map::set(scope, name, id)\n      pc_emit(ctx, s2, value)\n      pc_emit(ctx, s2, body)\n      pe_scope_end(ctx, id, name)\n    },\n    EAssign(_name, value, body) => {\n      pc_emit(ctx, scope, value)\n      pc_emit(ctx, scope, body)\n    },\n    EAssignOp(_op, _name, value, body) => {\n      pc_emit(ctx, scope, value)\n      pc_emit(ctx, scope, body)\n    },\n    ESeq(a, b) => {\n      pc_emit(ctx, scope, a)\n      let nm = next_seq_name(ctx)\n      let id = pe_declare(ctx, nm)\n      pc_emit(ctx, scope, b)\n      pe_scope_end(ctx, id, nm)\n    },\n    EBinOp(_op, l, r) => {\n      pc_emit(ctx, scope, l)\n      pc_emit(ctx, scope, r)\n    },\n    EUnaryOp(_op, e) => pc_emit(ctx, scope, e),\n    ETuple(items) => {\n      let mut i = 0\n      while i < Array::length(items) {\n        pc_emit(ctx, scope, Array::get(items, i))\n        i = i + 1\n      }\n      0\n    },\n    EArray(items) => {\n      let mut i = 0\n      while i < Array::length(items) {\n        pc_emit(ctx, scope, Array::get(items, i))\n        i = i + 1\n      }\n      0\n    },\n    ERecord(_, fields, _) => {\n      let mut i = 0\n      while i < Array::length(fields) {\n        pc_emit(ctx, scope, (Array::get(fields, i)).1)\n        i = i + 1\n      }\n      0\n    },\n    EMap(fields) => {\n      let mut i = 0\n      while i < Array::length(fields) {\n        pc_emit(ctx, scope, (Array::get(fields, i)).1)\n        i = i + 1\n      }\n      0\n    },\n    EIf(cond, then_e, else_e) => {\n      pc_emit(ctx, scope, cond)\n      let snap = copy_ints(ctx.remaining)\n      pc_emit(ctx, scope, then_e)\n      let mut sw = 0\n      while sw < Array::length(snap) {\n        let then_v = Array::get(ctx.remaining, sw)\n        Array::set(ctx.remaining, sw, Array::get(snap, sw))\n        Array::set(snap, sw, then_v)\n        sw = sw + 1\n      }\n      pc_emit(ctx, scope, else_e)\n      let mut i = 0\n      while i < Array::length(snap) {\n        if Array::get(snap, i) < Array::get(ctx.remaining, i) {\n          Array::set(ctx.remaining, i, Array::get(snap, i))\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      0\n    },\n    EWhile(cond, body) => {\n      pc_emit(ctx, scope, cond)\n      pc_emit(ctx, scope, body)\n    },\n    EReturn(e) => pc_emit(ctx, scope, e),\n    ESpread(e) => pc_emit(ctx, scope, e),\n    ELabeledArg(_l, _n, e) => pc_emit(ctx, scope, e),\n    EBreak(opt) => match opt {\n      Some(e) => pc_emit(ctx, scope, e),\n      None => 0\n    }\n    ,\n    EFn(_tp, _tb, params, _ret, _eff, fbody) => {\n      let caps = collect_free_vars(fbody, fn_param_names(params), [\n      ])\n      let mut i = 0\n      while i < Array::length(caps) {\n        pe_use(ctx, scope, Array::get(caps, i))\n        i = i + 1\n      }\n      0\n    },\n    EForIn(value_name, index_opt, iterable, fbody) => {\n      pc_emit(ctx, scope, iterable)\n      let idv = pe_declare(ctx, value_name)\n      let s2 = Map::set(scope, value_name, idv)\n      let s3 = match index_opt {\n        Some(idx) => {\n          let idi = pe_declare(ctx, idx)\n          Map::set(s2, idx, idi)\n        },\n        None => s2\n      }\n      pc_emit(ctx, s3, fbody)\n      pe_scope_end(ctx, idv, value_name)\n    },\n    ELoop(params, lbody) => {\n      let mut s = scope\n      let pids: Array[Int] = [\n      ]\n      let pnames: Array[String] = [\n      ]\n      let mut i = 0\n      while i < Array::length(params) {\n        let p = Array::get(params, i)\n        pc_emit(ctx, scope, p.1)\n        let pid = pe_declare(ctx, p.0)\n        s = Map::set(s, p.0, pid)\n        Array::push(pids, pid)\n        Array::push(pnames, p.0)\n        i = i + 1\n      }\n      pc_emit(ctx, s, lbody)\n      let mut j = 0\n      while j < Array::length(pids) {\n        pe_scope_end(ctx, Array::get(pids, j), Array::get(pnames, j))\n        j = j + 1\n      }\n      0\n    },\n    EMatch(scrut, arms) => {\n      match scrut {\n        EIdent(_, _) => 0,\n        _ => pc_emit(ctx, scope, scrut)\n      }\n      let snap = copy_ints(ctx.remaining)\n      let minrem = copy_ints(snap)\n      let mut a = 0\n      while a < Array::length(arms) {\n        let arm = Array::get(arms, a)\n        restore_prefix(ctx.remaining, snap)\n        let pnames: Array[String] = [\n        ]\n        pat_names(arm.0, pnames)\n        let mut s = scope\n        let pids: Array[Int] = [\n        ]\n        let mut k = 0\n        while k < Array::length(pnames) {\n          let nm = Array::get(pnames, k)\n          let pid = pe_declare(ctx, nm)\n          s = Map::set(s, nm, pid)\n          Array::push(pids, pid)\n          k = k + 1\n        }\n        pc_emit(ctx, s, arm.1)\n        let mut j = 0\n        while j < Array::length(pids) {\n          pe_scope_end(ctx, Array::get(pids, j), Array::get(pnames, j))\n          j = j + 1\n        }\n        let mut mi = 0\n        while mi < Array::length(snap) {\n          if Array::get(ctx.remaining, mi) < Array::get(minrem, mi) {\n            Array::set(minrem, mi, Array::get(ctx.remaining, mi))\n          } else {\n            ()\n          }\n          mi = mi + 1\n        }\n        a = a + 1\n      }\n      restore_prefix(ctx.remaining, minrem)\n      0\n    },\n    EHandle(hbody, arms) => {\n      let snap = copy_ints(ctx.remaining)\n      pc_emit(ctx, scope, hbody)\n      let minrem = copy_ints(ctx.remaining)\n      let mut a = 0\n      while a < Array::length(arms) {\n        let arm = Array::get(arms, a)\n        restore_prefix(ctx.remaining, snap)\n        let pnames: Array[String] = [\n        ]\n        pat_names(arm.0, pnames)\n        let mut s = scope\n        let pids: Array[Int] = [\n        ]\n        let mut k = 0\n        while k < Array::length(pnames) {\n          let nm = Array::get(pnames, k)\n          let pid = pe_declare(ctx, nm)\n          s = Map::set(s, nm, pid)\n          Array::push(pids, pid)\n          k = k + 1\n        }\n        pc_emit(ctx, s, arm.1)\n        let mut j = 0\n        while j < Array::length(pids) {\n          pe_scope_end(ctx, Array::get(pids, j), Array::get(pnames, j))\n          j = j + 1\n        }\n        let mut mi = 0\n        while mi < Array::length(snap) {\n          if Array::get(ctx.remaining, mi) < Array::get(minrem, mi) {\n            Array::set(minrem, mi, Array::get(ctx.remaining, mi))\n          } else {\n            ()\n          }\n          mi = mi + 1\n        }\n        a = a + 1\n      }\n      restore_prefix(ctx.remaining, minrem)\n      0\n    },\n    _ => 0\n  }\n}\n\nexport fn pc_count(ctx: PCtx, scope: Map[String, Int], expr: Expr) -> Int {\n  match expr {\n    EInt(_) => 0,\n    EFloat(_) => 0,\n    EString(_) => 0,\n    EBool(_) => 0,\n    EUnit => 0,\n    EStringInterp(_) => 0,\n    EIdent(x, _) => pc_count_use(ctx, scope, x),\n    ECall(callee, args, _) => {\n      match callee {\n        EIdent(f, _) => pc_count_borrow(ctx, scope, f),\n        _ => pc_count(ctx, scope, callee)\n      }\n      let bmask = pe_borrow_mask(ctx, scope, callee)\n      let mut i = 0\n      while i < Array::length(args) {\n        let arg = Array::get(args, i)\n        if pe_bmask_has(bmask, i) {\n          match arg {\n            EIdent(obj, _) => pc_count_borrow(ctx, scope, obj),\n            _ => pc_count(ctx, scope, arg)\n          }\n        } else {\n          pc_count(ctx, scope, arg)\n        }\n        i = i + 1\n      }\n      0\n    },\n    EDot(obj, _field, _, _) => match obj {\n      EIdent(x, _) => pc_count_borrow(ctx, scope, x),\n      _ => pc_count(ctx, scope, obj)\n    }\n    ,\n    ELet(name, value, body, _) => {\n      pc_count(ctx, scope, value)\n      let id = pc_declare(ctx, name, is_scalar_expr(ctx, value))\n      let _ = pctx_mark_view_call(ctx, scope, id, value)\n      pc_count(ctx, Map::set(scope, name, id), body)\n    },\n    ELetMut(name, value, body, _) => {\n      pc_count(ctx, scope, value)\n      let id = pc_declare(ctx, name, is_scalar_expr(ctx, value))\n      let _ = pctx_mark_view_call(ctx, scope, id, value)\n      pc_count(ctx, Map::set(scope, name, id), body)\n    },\n    ELetRec(name, value, body) => {\n      let id = pc_declare(ctx, name, false)\n      let s2 = Map::set(scope, name, id)\n      pc_count(ctx, s2, value)\n      pc_count(ctx, s2, body)\n    },\n    EAssign(_name, value, body) => {\n      pc_count(ctx, scope, value)\n      pc_count(ctx, scope, body)\n    },\n    EAssignOp(_op, _name, value, body) => {\n      pc_count(ctx, scope, value)\n      pc_count(ctx, scope, body)\n    },\n    ESeq(a, b) => {\n      pc_count(ctx, scope, a)\n      let nm = next_seq_name(ctx)\n      let sq_id = pc_declare(ctx, nm, is_scalar_expr(ctx, a))\n      let _ = pctx_mark_view_call(ctx, scope, sq_id, a)\n      pc_count(ctx, scope, b)\n    },\n    EBinOp(_op, l, r) => {\n      pc_count(ctx, scope, l)\n      pc_count(ctx, scope, r)\n    },\n    EUnaryOp(_op, e) => pc_count(ctx, scope, e),\n    ETuple(items) => {\n      let mut i = 0\n      while i < Array::length(items) {\n        pc_count(ctx, scope, Array::get(items, i))\n        i = i + 1\n      }\n      0\n    },\n    EArray(items) => {\n      let mut i = 0\n      while i < Array::length(items) {\n        pc_count(ctx, scope, Array::get(items, i))\n        i = i + 1\n      }\n      0\n    },\n    ERecord(_, fields, _) => {\n      let mut i = 0\n      while i < Array::length(fields) {\n        pc_count(ctx, scope, (Array::get(fields, i)).1)\n        i = i + 1\n      }\n      0\n    },\n    EMap(fields) => {\n      let mut i = 0\n      while i < Array::length(fields) {\n        pc_count(ctx, scope, (Array::get(fields, i)).1)\n        i = i + 1\n      }\n      0\n    },\n    EIf(cond, then_e, else_e) => {\n      pc_count(ctx, scope, cond)\n      let snap_u = copy_ints(ctx.uses)\n      let snap_b = copy_ints(ctx.borrows)\n      pc_count(ctx, scope, then_e)\n      let mut sw = 0\n      while sw < Array::length(snap_u) {\n        let tu = Array::get(ctx.uses, sw)\n        Array::set(ctx.uses, sw, Array::get(snap_u, sw))\n        Array::set(snap_u, sw, tu)\n        let tb = Array::get(ctx.borrows, sw)\n        Array::set(ctx.borrows, sw, Array::get(snap_b, sw))\n        Array::set(snap_b, sw, tb)\n        sw = sw + 1\n      }\n      pc_count(ctx, scope, else_e)\n      let mut id = 0\n      while id < Array::length(snap_u) {\n        Array::set(ctx.uses, id, int_max(Array::get(snap_u, id), Array::get(ctx.uses, id)))\n        Array::set(ctx.borrows, id, int_max(Array::get(snap_b, id), Array::get(ctx.borrows, id)))\n        id = id + 1\n      }\n      0\n    },\n    EWhile(cond, body) => {\n      pc_count(ctx, scope, cond)\n      pc_count(ctx, scope, body)\n    },\n    EReturn(e) => pc_count(ctx, scope, e),\n    ESpread(e) => pc_count(ctx, scope, e),\n    ELabeledArg(_l, _n, e) => pc_count(ctx, scope, e),\n    EBreak(opt) => match opt {\n      Some(e) => pc_count(ctx, scope, e),\n      None => 0\n    }\n    ,\n    EFn(_tp, _tb, params, _ret, _eff, fbody) => {\n      let caps = collect_free_vars(fbody, fn_param_names(params), [\n      ])\n      let mut i = 0\n      while i < Array::length(caps) {\n        pc_count_use(ctx, scope, Array::get(caps, i))\n        i = i + 1\n      }\n      0\n    },\n    EForIn(value_name, index_opt, iterable, fbody) => {\n      pc_count(ctx, scope, iterable)\n      let idv = pc_declare(ctx, value_name, false)\n      let s2 = Map::set(scope, value_name, idv)\n      let s3 = match index_opt {\n        Some(idx) => {\n          let idi = pc_declare(ctx, idx, true)\n          Map::set(s2, idx, idi)\n        },\n        None => s2\n      }\n      pc_count(ctx, s3, fbody)\n    },\n    ELoop(params, lbody) => {\n      let mut s = scope\n      let mut i = 0\n      while i < Array::length(params) {\n        let p = Array::get(params, i)\n        pc_count(ctx, scope, p.1)\n        let pid = pc_declare(ctx, p.0, is_scalar_expr(ctx, p.1))\n        s = Map::set(s, p.0, pid)\n        i = i + 1\n      }\n      pc_count(ctx, s, lbody)\n    },\n    EMatch(scrut, arms) => {\n      match scrut {\n        EIdent(sx, _) => pc_count_borrow(ctx, scope, sx),\n        _ => pc_count(ctx, scope, scrut)\n      }\n      let snap_u = copy_ints(ctx.uses)\n      let snap_b = copy_ints(ctx.borrows)\n      let max_u = zeros(Array::length(snap_u))\n      let max_b = zeros(Array::length(snap_b))\n      let mut a = 0\n      while a < Array::length(arms) {\n        let arm = Array::get(arms, a)\n        restore_prefix(ctx.uses, snap_u)\n        restore_prefix(ctx.borrows, snap_b)\n        let pnames: Array[String] = [\n        ]\n        pat_names(arm.0, pnames)\n        let mut s = scope\n        let mut k = 0\n        while k < Array::length(pnames) {\n          let nm = Array::get(pnames, k)\n          let pid = pc_declare(ctx, nm, false)\n          s = Map::set(s, nm, pid)\n          k = k + 1\n        }\n        pc_count(ctx, s, arm.1)\n        let mut id = 0\n        while id < Array::length(snap_u) {\n          let du = Array::get(ctx.uses, id) - Array::get(snap_u, id)\n          if du > Array::get(max_u, id) {\n            Array::set(max_u, id, du)\n          }\n          let db = Array::get(ctx.borrows, id) - Array::get(snap_b, id)\n          if db > Array::get(max_b, id) {\n            Array::set(max_b, id, db)\n          }\n          id = id + 1\n        }\n        a = a + 1\n      }\n      restore_prefix(ctx.uses, snap_u)\n      restore_prefix(ctx.borrows, snap_b)\n      let mut id2 = 0\n      while id2 < Array::length(snap_u) {\n        Array::set(ctx.uses, id2, Array::get(snap_u, id2) + Array::get(max_u, id2))\n        Array::set(ctx.borrows, id2, Array::get(snap_b, id2) + Array::get(max_b, id2))\n        id2 = id2 + 1\n      }\n      0\n    },\n    EHandle(hbody, arms) => {\n      let snap_u = copy_ints(ctx.uses)\n      let snap_b = copy_ints(ctx.borrows)\n      let max_u = zeros(Array::length(snap_u))\n      let max_b = zeros(Array::length(snap_b))\n      pc_count(ctx, scope, hbody)\n      let mut id0 = 0\n      while id0 < Array::length(snap_u) {\n        let du = Array::get(ctx.uses, id0) - Array::get(snap_u, id0)\n        if du > Array::get(max_u, id0) {\n          Array::set(max_u, id0, du)\n        }\n        let db = Array::get(ctx.borrows, id0) - Array::get(snap_b, id0)\n        if db > Array::get(max_b, id0) {\n          Array::set(max_b, id0, db)\n        }\n        id0 = id0 + 1\n      }\n      let mut a = 0\n      while a < Array::length(arms) {\n        let arm = Array::get(arms, a)\n        restore_prefix(ctx.uses, snap_u)\n        restore_prefix(ctx.borrows, snap_b)\n        let pnames: Array[String] = [\n        ]\n        pat_names(arm.0, pnames)\n        let mut s = scope\n        let mut k = 0\n        while k < Array::length(pnames) {\n          let nm = Array::get(pnames, k)\n          let pid = pc_declare(ctx, nm, false)\n          s = Map::set(s, nm, pid)\n          k = k + 1\n        }\n        pc_count(ctx, s, arm.1)\n        let mut id = 0\n        while id < Array::length(snap_u) {\n          let du = Array::get(ctx.uses, id) - Array::get(snap_u, id)\n          if du > Array::get(max_u, id) {\n            Array::set(max_u, id, du)\n          }\n          let db = Array::get(ctx.borrows, id) - Array::get(snap_b, id)\n          if db > Array::get(max_b, id) {\n            Array::set(max_b, id, db)\n          }\n          id = id + 1\n        }\n        a = a + 1\n      }\n      restore_prefix(ctx.uses, snap_u)\n      restore_prefix(ctx.borrows, snap_b)\n      let mut id2 = 0\n      while id2 < Array::length(snap_u) {\n        Array::set(ctx.uses, id2, Array::get(snap_u, id2) + Array::get(max_u, id2))\n        Array::set(ctx.borrows, id2, Array::get(snap_b, id2) + Array::get(max_b, id2))\n        id2 = id2 + 1\n      }\n      0\n    },\n    _ => 0\n  }\n}\n\nfn pctx_apply_borrow_retention(ctx: PCtx) -> Int {\n  let mut bid = 0\n  while bid < ctx.next_id {\n    if Array::get(ctx.borrows, bid) > 0 {\n      Array::set(ctx.uses, bid, Array::get(ctx.uses, bid) + 1)\n    } else {\n      ()\n    }\n    bid = bid + 1\n  }\n  0\n}\n\nexport fn build_perceus_plan(body: Expr) -> Array[PerceusAction] {\n  let no_masks: Array[Int] = [\n  ]\n  let ctx = pctx_new([\n  ], [\n  ], no_masks, [\n  ])\n  let empty: Map[String, Int] = Map::new()\n  pc_count(ctx, empty, body)\n  pctx_apply_borrow_retention(ctx)\n  ctx.next_id = 0\n  ctx.seq_id = 0\n  pc_emit(ctx, empty, body)\n  ctx.actions\n}\n\nfn collect_heap_ret_fns(stmts: Array[Stmt]) -> Array[String] {\n  let out: Array[String] = [\n  ]\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SLet(_, _, fname, oty, _) =>\n      match oty {\n        Some(ty) =>\n        match ty {\n          TyFn(_, ret, _) =>\n          if type_expr_is_heap(Some(ret)) {\n            Array::push(out, fname)\n          } else {\n            ()\n          },\n          _ => ()\n        },\n        None => ()\n      },\n      _ => ()\n    }\n    i = i + 1\n  }\n  out\n}\n\nexport fn elaborate_heap_params(stmts: Array[Stmt]) -> Array[Stmt] {\n  let hctx = HeapInferCtx::{\n    ctors: collect_ctor_names(stmts),\n    heap_fns: collect_heap_ret_fns(stmts),\n  }\n  let out = Array::slice(stmts, 0, 0)\n  let mut i = 0\n  while i < Array::length(stmts) {\n    let s = Array::get(stmts, i)\n    let s2 = match s {\n      SLet(a, b, n, t, e) => SLet(a, b, n, t, elaborate_rw(e, hctx)),\n      SExpr(e) => SExpr(elaborate_rw(e, hctx)),\n      _ => s\n    }\n    Array::push(out, s2)\n    i = i + 1\n  }\n  out\n}\n\nfn expr_projects_or_matches(name: String, e: Expr) -> Bool {\n  match e {\n    EDot(obj, _, _, _) =>\n    match obj {\n      EIdent(n, _) => n == name,\n      _ => expr_projects_or_matches(name, obj)\n    },\n    EMatch(scrut, arms) => {\n      let hit = match scrut {\n        EIdent(n, _) => n == name,\n        _ => expr_projects_or_matches(name, scrut)\n      }\n      if hit {\n        true\n      } else {\n        let mut i = 0\n        let mut found = false\n        while i < Array::length(arms) {\n          let (_, arm_body) = Array::get(arms, i)\n          if expr_projects_or_matches(name, arm_body) {\n            found = true\n          } else {\n            ()\n          }\n          i = i + 1\n        }\n        found\n      }\n    },\n    EHandle(body, arms) => {\n      let mut i = 0\n      let mut found = expr_projects_or_matches(name, body)\n      while i < Array::length(arms) {\n        let (_, arm_body) = Array::get(arms, i)\n        if expr_projects_or_matches(name, arm_body) {\n          found = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      found\n    },\n    ELet(_, val, body, _) =>\n    expr_projects_or_matches(name, val) || expr_projects_or_matches(name, body),\n    ELetRec(_, val, body) =>\n    expr_projects_or_matches(name, val) || expr_projects_or_matches(name, body),\n    ELetMut(_, val, body, _) =>\n    expr_projects_or_matches(name, val) || expr_projects_or_matches(name, body),\n    EAssign(_, val, cont) =>\n    expr_projects_or_matches(name, val) || expr_projects_or_matches(name, cont),\n    EAssignOp(_, _, val, cont) =>\n    expr_projects_or_matches(name, val) || expr_projects_or_matches(name, cont),\n    ESeq(a, b) =>\n    expr_projects_or_matches(name, a) || expr_projects_or_matches(name, b),\n    EIf(c, t, el) =>\n    expr_projects_or_matches(name, c) ||\n    expr_projects_or_matches(name, t) ||\n    expr_projects_or_matches(name, el),\n    EWhile(c, b) =>\n    expr_projects_or_matches(name, c) || expr_projects_or_matches(name, b),\n    EForIn(_, _, iter, body) =>\n    expr_projects_or_matches(name, iter) || expr_projects_or_matches(name, body),\n    ECall(callee, args, _) => {\n      let mut i = 0\n      let mut found = expr_projects_or_matches(name, callee)\n      while i < Array::length(args) {\n        if expr_projects_or_matches(name, Array::get(args, i)) {\n          found = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      found\n    },\n    EBinOp(_, l, r) =>\n    expr_projects_or_matches(name, l) || expr_projects_or_matches(name, r),\n    EUnaryOp(_, o) => expr_projects_or_matches(name, o),\n    EFn(_, _, _, _, _, body) => expr_projects_or_matches(name, body),\n    ETuple(elems) => {\n      let mut i = 0\n      let mut found = false\n      while i < Array::length(elems) {\n        if expr_projects_or_matches(name, Array::get(elems, i)) {\n          found = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      found\n    },\n    EArray(elems) => {\n      let mut i = 0\n      let mut found = false\n      while i < Array::length(elems) {\n        if expr_projects_or_matches(name, Array::get(elems, i)) {\n          found = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      found\n    },\n    ELoop(params, body) => {\n      let mut i = 0\n      let mut found = expr_projects_or_matches(name, body)\n      while i < Array::length(params) {\n        let (_, init) = Array::get(params, i)\n        if expr_projects_or_matches(name, init) {\n          found = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      found\n    },\n    ERecord(_, fields, _) => {\n      let mut i = 0\n      let mut found = false\n      while i < Array::length(fields) {\n        let (_, fval) = Array::get(fields, i)\n        if expr_projects_or_matches(name, fval) {\n          found = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      found\n    },\n    EMap(fields) => {\n      let mut i = 0\n      let mut found = false\n      while i < Array::length(fields) {\n        let (_, fval) = Array::get(fields, i)\n        if expr_projects_or_matches(name, fval) {\n          found = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      found\n    },\n    ELabeledArg(_, _, inner) => expr_projects_or_matches(name, inner),\n    EReturn(inner) => expr_projects_or_matches(name, inner),\n    ESpread(inner) => expr_projects_or_matches(name, inner),\n    EBreak(opt) =>\n    match opt {\n      Some(inner) => expr_projects_or_matches(name, inner),\n      None => false\n    },\n    EContinue(args) => {\n      let mut i = 0\n      let mut found = false\n      while i < Array::length(args) {\n        if expr_projects_or_matches(name, Array::get(args, i)) {\n          found = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      found\n    },\n    EInt(_) => false,\n    EFloat(_) => false,\n    EString(_) => false,\n    EBool(_) => false,\n    EIdent(_, _) => false,\n    EStringInterp(_) => false,\n    EUnit => false\n  }\n}\n\nexport fn param_is_heap_in_body(name: String, otype: Option[TypeExpr], body: Expr) -> Bool {\n  if type_expr_is_heap(otype) {\n    true\n  } else {\n    match otype {\n      None => expr_projects_or_matches(name, body),\n      Some(_) => false\n    }\n  }\n}\n\nexport fn build_perceus_plan_with_params(params: Array[(String, Option[TypeExpr])], body: Expr, borrow_ret_names: Array[String], borrow_param_fns: Array[String], borrow_param_masks: Array[Int], view_ret_fns: Array[String]) -> Array[PerceusAction] {\n  let ctx = pctx_new(borrow_ret_names, borrow_param_fns, borrow_param_masks, view_ret_fns)\n  let mut scope: Map[String, Int] = Map::new()\n  let mut pi = 0\n  while pi < Array::length(params) {\n    let (pname, ptype) = Array::get(params, pi)\n    let id = pc_declare(ctx, pname, !param_is_heap_in_body(pname, ptype, body))\n    scope = Map::set(scope, pname, id)\n    pi = pi + 1\n  }\n  pc_count(ctx, scope, body)\n  pctx_apply_borrow_retention(ctx)\n  ctx.next_id = 0\n  ctx.seq_id = 0\n  let mut scope2: Map[String, Int] = Map::new()\n  let param_ids = array_empty()\n  let mut pj = 0\n  while pj < Array::length(params) {\n    let (pname, _) = Array::get(params, pj)\n    let id = pe_declare(ctx, pname)\n    scope2 = Map::set(scope2, pname, id)\n    Array::push(param_ids, id)\n    pj = pj + 1\n  }\n  pc_emit(ctx, scope2, body)\n  let mut pk = 0\n  while pk < Array::length(params) {\n    let (pname, _) = Array::get(params, pk)\n    pe_scope_end(ctx, Array::get(param_ids, pk), pname)\n    pk = pk + 1\n  }\n  ctx.actions\n}\n")
}

let source_87 = () -> (String, String) {
  ("lib/@vibe/compiler/codegen/expr/index.vpkg",
"name = @vibe/compiler/codegen/expr\nversion = 0.0.1\ndescription =\n  #|@vibe/compiler/codegen/expr — ADR-0070 / #897 compiler-internal contract.\ndeps = {\n  @vibe/compiler/codegen/common_analysis : 0.0.1\n  @vibe/compiler/codegen/common_base : 0.0.1\n  @vibe/compiler/codegen/common_extractors : 0.0.1\n  @vibe/compiler/codegen/wasm_emit : 0.0.1\n  @vibe/compiler/core : 0.0.1\n  @vibe/compiler/perceus : 0.0.1\n  @vibe/core : 0.2.0\n}\n\ngenerated_hash =\n\n// @vibe/compiler/codegen/expr — ADR-0070 / #897 compiler-internal contract.\n// Directory-shared-scope package: expr.vibe (facade), core.vibe/support.vibe\n// (re-export shims), compile_call.vibe, compile_expr.vibe,\n// compile_expr_tail{,2..7}.vibe, compile_lambda.vibe, compile_match.vibe,\n// compile_module_expr.vibe.\n\nfn compile_expr(buf: Bytes, expr: Expr, local_names: Array[String], next_local: Int, ctx: CompileCtx, ld: Int) -> Int with { Error }\nfn compile_module_expr(stmts: Array[Stmt]) -> Bytes with { Error }\nfn compile_call(buf: Bytes, callee: Expr, args: Array[Expr], local_names: Array[String], next_local: Int, ctx: CompileCtx, ld: Int, ce: (Bytes, Expr, Array[String], Int, CompileCtx, Int) -> Int with { Error }) -> Int with { Error }\nfn cc_is_borrow_ret_call(e: Expr, ctx: CompileCtx) -> Bool\nfn cc_builtin_call_ret_kind(e: Expr, local_names: Array[String], ctx: CompileCtx) -> Int with { Error }\nfn cc_expr_is_stringish(e: Expr, local_names: Array[String], ctx: CompileCtx) -> Bool with { Error }\nfn cc_is_loop_borrowed_ident(e: Expr, ctx: CompileCtx) -> Bool\n// ADR-0089 (c) (#1218): the raw-builtin name prefix compile_call gives a\n// NAMED host future's handle getter. Exported so linked_compile derives the\n// per-name core import from the same spelling instead of a second literal.\nfn cc_host_future_named_raw_prefix() -> String\n// ADR-0089 Decision 3 (#1218): the stream sibling (`vibe_hs_get_raw$`),\n// same single-spelling contract for `vibe.host_stream_get$<name>`.\nfn cc_host_stream_named_raw_prefix() -> String\nfn expr_is_boolish(e: Expr, local_names: Array[String], ctx: CompileCtx) -> Bool with { Error }\nfn expr_is_floatish(e: Expr, local_names: Array[String], ctx: CompileCtx) -> Bool with { Error }\nfn expr_is_intish(e: Expr, local_names: Array[String], ctx: CompileCtx) -> Bool with { Error }\nfn compile_expr_tail(buf: Bytes, expr: Expr, local_names: Array[String], next_local: Int, ctx: CompileCtx, ld: Int, compile_expr: (Bytes, Expr, Array[String], Int, CompileCtx, Int) -> Int with { Error }) -> Int with { Error }\nfn compile_expr_tail2(buf: Bytes, expr: Expr, local_names: Array[String], next_local: Int, ctx: CompileCtx, ld: Int, compile_expr: (Bytes, Expr, Array[String], Int, CompileCtx, Int) -> Int with { Error }) -> Int with { Error }\nfn compile_expr_tail3(buf: Bytes, expr: Expr, local_names: Array[String], next_local: Int, ctx: CompileCtx, ld: Int, compile_expr: (Bytes, Expr, Array[String], Int, CompileCtx, Int) -> Int with { Error }) -> Int with { Error }\nfn compile_expr_tail4(buf: Bytes, expr: Expr, local_names: Array[String], next_local: Int, ctx: CompileCtx, ld: Int, compile_expr: (Bytes, Expr, Array[String], Int, CompileCtx, Int) -> Int with { Error }) -> Int with { Error }\nfn compile_expr_tail5(buf: Bytes, expr: Expr, local_names: Array[String], next_local: Int, ctx: CompileCtx, ld: Int, compile_expr: (Bytes, Expr, Array[String], Int, CompileCtx, Int) -> Int with { Error }) -> Int with { Error }\nfn compile_expr_tail6(buf: Bytes, body: Expr, arms: Array[(Pat, Expr)], local_names: Array[String], next_local: Int, ctx: CompileCtx, ld: Int, compile_expr: (Bytes, Expr, Array[String], Int, CompileCtx, Int) -> Int with { Error }) -> Int with { Error }\nfn compile_expr_tail7(buf: Bytes, parts: Array[String], local_names: Array[String], next_local: Int, ctx: CompileCtx, ld: Int, compile_expr: (Bytes, Expr, Array[String], Int, CompileCtx, Int) -> Int with { Error }) -> Int with { Error }\nfn compile_lambda(buf: Bytes, params: Array[(String, Option[TypeExpr])], fn_body: Expr, local_names: Array[String], next_local: Int, ctx: CompileCtx, ld: Int, compile_fn: (Bytes, Expr, Array[String], Int, CompileCtx, Int) -> Int with { Error }) -> Int with { Error }\nfn compile_match(buf: Bytes, expr: Expr, local_names: Array[String], next_local: Int, ctx: CompileCtx, ld: Int, ce: (Bytes, Expr, Array[String], Int, CompileCtx, Int) -> Int with { Error }) -> Int with { Error }\n")
}

