let source_125 = () -> (String, String) {
  ("lib/@vibe/compiler/codegen/wasi/index.vpkg",
"name = @vibe/compiler/codegen/wasi\nversion = 0.0.1\ndescription =\n  #|@vibe/compiler/codegen/wasi — WASI-lane WASM module compile entry points\ndeps = {\n  @vibe/compiler/codegen/builtin_bodies : 0.0.1\n  @vibe/compiler/codegen/common_analysis : 0.0.1\n  @vibe/compiler/codegen/common_base : 0.0.1\n  @vibe/compiler/codegen/common_extractors : 0.0.1\n  @vibe/compiler/codegen/expr : 0.0.1\n  @vibe/compiler/codegen/wasm_emit : 0.0.1\n  @vibe/compiler/core : 0.0.1\n  @vibe/compiler/normalize : 0.0.1\n  @vibe/compiler/perceus : 0.0.1\n  @vibe/core : 0.2.0\n}\n\ngenerated_hash =\n\n// @vibe/compiler/codegen/wasi — WASI-lane WASM module compile entry points\n// (ADR-0070 Phase 3, #897, compiler-internal batch). Compiled into the\n// compiler itself via compiler_sources_manifest.tsv (group `codegen`,\n// dual-row: this contract + wasi.vibe).\n//\n// The old index.vibe was not the whole implementation: it defines 4\n// no-sources convenience wrappers directly, then re-exports 7\n// linked/RC-lane entry points from the sibling linked_compile.vibe\n// (`export ./linked_compile.vibe { ... }`, #726 -- straight to the defining\n// file, no chained re-export). Both halves of that surface are declared\n// here; no external file imports linked_compile.vibe/linked_helpers.vibe\n// directly (verified repo-wide), so this directory has no boundary\n// spillover the way entry/source_compile and entry/compiler/fs_compile do.\n// No exported types: Stmt (../../core) and DbgProv (../common_base) are\n// structural signature text resolved against the implementation import when\n// the facade is merged in (normalize/perceus precedent).\n\nfn wasi_memory_min_pages_for_heap(heap_start: Int) -> Int\nfn stmts_use_builtin(stmts: Array[Stmt], fn_names: Array[String], target: String) -> Bool\nfn collect_used_builtin_names_into(stmts: Array[Stmt], fn_names: Array[String], fn_name_index: Array[String], sink: Array[(String, Bool)]) -> Unit\nfn collect_used_builtin_names(stmts: Array[Stmt], fn_names: Array[String]) -> Map[String, Bool]\nfn compile_wasi_module_impl(stmts: Array[Stmt], entry_name: String) -> Bytes with { Error }\nfn compile_wasi_module_coverage_impl(stmts: Array[Stmt], entry_name: String) -> Bytes with { Error }\nfn compile_wasi_module_trace_impl(stmts: Array[Stmt], entry_name: String) -> Bytes with { Error }\nfn compile_wasi_module_break_impl(stmts: Array[Stmt], entry_name: String, prov: DbgProv) -> Bytes with { Error }\nfn compile_wasi_module_with_sources_impl(stmts: Array[Stmt], entry_name: String, srcs: Array[(String, String)]) -> Bytes with { Error }\nfn compile_wasi_module_with_sources_coverage_impl(stmts: Array[Stmt], entry_name: String, srcs: Array[(String, String)]) -> Bytes with { Error }\nfn compile_wasi_module_with_sources_trace_impl(stmts: Array[Stmt], entry_name: String, srcs: Array[(String, String)]) -> Bytes with { Error }\nfn compile_wasi_module_with_sources_break_impl(stmts: Array[Stmt], entry_name: String, srcs: Array[(String, String)], prov: DbgProv) -> Bytes with { Error }\nfn compile_wasi_module_linked_impl(stmts: Array[Stmt], entry_name: String, srcs: Array[(String, String)], linked_imports: Array[(String, String, Int, Int)], library_mode: Bool, enable_rc: Bool, coverage: Bool, debug_trace: Bool, debug_break: Bool, rc_shadow: Bool, prov: DbgProv, body_cache_in: CodegenBodyCache, body_cache_out: CodegenBodyCache, slice_lo: Int, slice_hi: Int) -> Bytes with { Error }\nfn compile_wasi_module_replayed_impl(stmts: Array[Stmt], entry_name: String) -> Bytes with { Error }\nfn compile_wasi_module_sliced_impl(stmts: Array[Stmt], entry_name: String) -> Bytes with { Error }\nfn compile_wasi_module_rc_impl(stmts_in: Array[Stmt], entry_name: String) -> Bytes with { Error }\nfn compile_wasi_module_rc_shadow_impl(stmts_in: Array[Stmt], entry_name: String) -> Bytes with { Error }\n")
}

let source_126 = () -> (String, String) {
  ("lib/@vibe/compiler/codegen/wasi/wasi.vibe",
"import @vibe/compiler/core {\n  Stmt\n}\n\nimport @vibe/core {\n  array_empty\n}\n\nimport @vibe/compiler/codegen/common_base {\n  DbgProv\n}\n\n\nexport fn compile_wasi_module_impl(stmts: Array[Stmt], entry_name: String) -> Bytes with { Error } {\n  compile_wasi_module_with_sources_impl(stmts, entry_name, array_empty())\n}\n\nexport fn compile_wasi_module_coverage_impl(stmts: Array[Stmt], entry_name: String) -> Bytes with { Error } {\n  compile_wasi_module_with_sources_coverage_impl(stmts, entry_name, array_empty())\n}\n\nexport fn compile_wasi_module_trace_impl(stmts: Array[Stmt], entry_name: String) -> Bytes with { Error } {\n  compile_wasi_module_with_sources_trace_impl(stmts, entry_name, array_empty())\n}\n\nexport fn compile_wasi_module_break_impl(stmts: Array[Stmt], entry_name: String, prov: DbgProv) -> Bytes with { Error } {\n  compile_wasi_module_with_sources_break_impl(stmts, entry_name, array_empty(), prov)\n}\n")
}

