let source_186 = () -> (String, String) {
  ("lib/@vibe/core/sha1.vibe",
"\n\nlet k0: Int = 1518500249\n\nlet k1: Int = 1859775393\n\nlet k2: Int = ((36635<<16)|48348)\n\nlet k3: Int = ((51810<<16)|49622)\n\nfn ushr(x: Int, n: Int) -> Int {\n  if n == 0 {\n    x\n  }\n  else if n >= 32 {\n    0\n  }\n  else {\n    (x>>n)&((1<<(32 - n)) - 1)\n  }\n}\n\nlet mask32: Int = ((65535<<16)|65535)\n\nfn rotl(x: Int, n: Int) -> Int {\n  ((x<<n)|ushr(x, 32 - n))&mask32\n}\n\nfn add32(a: Int, b: Int) -> Int {\n  (a + b)&mask32\n}\n\nlet h0_init: Int = 1732584193\n\nlet h1_init: Int = ((61389<<16)|43913)\n\nlet h2_init: Int = ((39098<<16)|56574)\n\nlet h3_init: Int = 271733878\n\nlet h4_init: Int = ((50130<<16)|57840)\n\nlet hex_table: String = \"0123456789abcdef\"\n\nfn read_word(s: String, idx: Int) -> Int {\n  let offset = idx * 4\n  let b0 = s |> String::char_code_at(offset)\n  let b1 = s |> String::char_code_at(offset + 1)\n  let b2 = s |> String::char_code_at(offset + 2)\n  let b3 = s |> String::char_code_at(offset + 3)\n  ((b0<<24)|(b1<<16)|(b2<<8)|b3)&mask32\n}\n\nfn read_word_bytes(b: Bytes, idx: Int) -> Int {\n  let offset = idx * 4\n  let b0 = Bytes::get(b, offset)\n  let b1 = Bytes::get(b, offset + 1)\n  let b2 = Bytes::get(b, offset + 2)\n  let b3 = Bytes::get(b, offset + 3)\n  ((b0<<24)|(b1<<16)|(b2<<8)|b3)&mask32\n}\n\nfn push_word_bytes(b: Bytes, w: Int) -> Unit {\n  Bytes::push(b, ushr(w, 24)&255)\n  Bytes::push(b, ushr(w, 16)&255)\n  Bytes::push(b, ushr(w, 8)&255)\n  Bytes::push(b, w&255)\n}\n\nfn pad_message(msg: String) -> String {\n  let len = msg |> String::length()\n  let bit_len = len * 8\n  let sb = StringBuilder::new()\n  StringBuilder::push(sb, msg)\n  StringBuilder::push(sb, String::from_char_code(128))\n  let mut cur_len = len + 1\n  while cur_len % 64 != 56 {\n    StringBuilder::push(sb, String::from_char_code(0))\n    cur_len = cur_len + 1\n  }\n  StringBuilder::push(sb, String::from_char_code(0))\n  StringBuilder::push(sb, String::from_char_code(0))\n  StringBuilder::push(sb, String::from_char_code(0))\n  StringBuilder::push(sb, String::from_char_code(0))\n  StringBuilder::push(sb, String::from_char_code(ushr(bit_len, 24)&255))\n  StringBuilder::push(sb, String::from_char_code(ushr(bit_len, 16)&255))\n  StringBuilder::push(sb, String::from_char_code(ushr(bit_len, 8)&255))\n  StringBuilder::push(sb, String::from_char_code(bit_len&255))\n  StringBuilder::freeze(sb)\n}\n\nfn to_hex_char(i: Int) -> String {\n  String::substring(hex_table, i, i + 1)\n}\n\nfn byte_to_hex(b: Int) -> String {\n  to_hex_char((b>>4)&15) |> String::concat(to_hex_char(b&15))\n}\n\nfn word_to_hex(w: Int) -> String {\n  let sb = StringBuilder::new()\n  StringBuilder::push(sb, byte_to_hex(ushr(w, 24)&255))\n  StringBuilder::push(sb, byte_to_hex(ushr(w, 16)&255))\n  StringBuilder::push(sb, byte_to_hex(ushr(w, 8)&255))\n  StringBuilder::push(sb, byte_to_hex(w&255))\n  StringBuilder::freeze(sb)\n}\n\nfn build_schedule(msg: String, block_start: Int) -> Bytes {\n  let arr = Bytes::new()\n  let mut i = 0\n  while i < 16 {\n    let w = read_word(msg, block_start / 4 + i)\n    push_word_bytes(arr, w)\n    i = i + 1\n  }\n  while i < 80 {\n    let w = rotl(read_word_bytes(arr, i - 3)^read_word_bytes(arr, i - 8)^read_word_bytes(arr, i - 14)^read_word_bytes(arr, i - 16), 1)\n    push_word_bytes(arr, w)\n    i = i + 1\n  }\n  arr\n}\n\nfn process_rounds(i: Int, a: Int, b: Int, c: Int, d: Int, e: Int, w: Bytes) -> Bytes {\n  if i >= 80 {\n    let out = Bytes::new()\n    push_word_bytes(out, a)\n    push_word_bytes(out, b)\n    push_word_bytes(out, c)\n    push_word_bytes(out, d)\n    push_word_bytes(out, e)\n    out\n  } else {\n    let f = if i < 20 {\n      (b&c)^((b^mask32)&d)\n    } else if i < 40 {\n      b^c^d\n    } else if i < 60 {\n      (b&c)^(b&d)^(c&d)\n    } else {\n      b^c^d\n    }\n    let k = if i < 20 {\n      k0\n    }\n    else if i < 40 {\n      k1\n    }\n    else if i < 60 {\n      k2\n    }\n    else {\n      k3\n    }\n    let temp = add32(add32(add32(add32(rotl(a, 5), f), e), k), read_word_bytes(w, i))\n    process_rounds(i + 1, temp, a, rotl(b, 30), c, d, w)\n  }\n}\n\nfn process_blocks(msg: String, block_idx: Int, num_blocks: Int, h0: Int, h1: Int, h2: Int, h3: Int, h4: Int) -> String {\n  if block_idx >= num_blocks {\n    let sb = StringBuilder::new()\n    StringBuilder::push(sb, word_to_hex(h0))\n    StringBuilder::push(sb, word_to_hex(h1))\n    StringBuilder::push(sb, word_to_hex(h2))\n    StringBuilder::push(sb, word_to_hex(h3))\n    StringBuilder::push(sb, word_to_hex(h4))\n    StringBuilder::freeze(sb)\n  } else {\n    let w = build_schedule(msg, block_idx * 64)\n    let result = process_rounds(0, h0, h1, h2, h3, h4, w)\n    let new_h0 = add32(h0, read_word_bytes(result, 0))\n    let new_h1 = add32(h1, read_word_bytes(result, 1))\n    let new_h2 = add32(h2, read_word_bytes(result, 2))\n    let new_h3 = add32(h3, read_word_bytes(result, 3))\n    let new_h4 = add32(h4, read_word_bytes(result, 4))\n    process_blocks(msg, block_idx + 1, num_blocks, new_h0, new_h1, new_h2, new_h3, new_h4)\n  }\n}\n\nexport fn sha1(msg: String) -> String {\n  let padded = pad_message(msg)\n  let num_blocks = (padded |> String::length()) / 64\n  process_blocks(padded, 0, num_blocks, h0_init, h1_init, h2_init, h3_init, h4_init)\n}\n")
}

let source_187 = () -> (String, String) {
  ("lib/@vibe/core/hex.vibe",
"\n\nlet hex_chars: String = \"0123456789abcdef\"\n\nexport fn hex_encode(s: String) -> String {\n  let len = String::length(s)\n  let sb = StringBuilder::new()\n  let mut i = 0\n  while i < len {\n    let b = String::char_code_at(s, i)&255\n    let hi = (b>>4)&15\n    let lo = b&15\n    StringBuilder::push(sb, String::substring(hex_chars, hi, hi + 1))\n    StringBuilder::push(sb, String::substring(hex_chars, lo, lo + 1))\n    i = i + 1\n  }\n  StringBuilder::freeze(sb)\n}\n\nfn hex_digit_value(c: Int) -> Int with { Error } {\n  if c >= '0' && c <= '9' {\n    c - '0'\n  } else if c >= 'a' && c <= 'f' {\n    c - 'a' + 10\n  } else if c >= 'A' && c <= 'F' {\n    c - 'A' + 10\n  } else {\n    throw(\"invalid hex digit\")\n  }\n}\n\nexport fn hex_decode(hex: String) -> String with { Error } {\n  let len = String::length(hex)\n  if len % 2 != 0 {\n    throw(\"odd-length hex string\")\n  } else {\n    let sb = StringBuilder::new()\n    let mut i = 0\n    while i < len {\n      let hi = hex_digit_value(String::char_code_at(hex, i))\n      let lo = hex_digit_value(String::char_code_at(hex, i + 1))\n      StringBuilder::push(sb, String::from_char_code((hi<<4)|lo))\n      i = i + 2\n    }\n    StringBuilder::freeze(sb)\n  }\n}\n")
}

let source_188 = () -> (String, String) {
  ("lib/@vibe/core/leb128.vibe",
"\nexport fn read_sleb128(buf: Bytes, offset: Int) -> (Int, Int) {\n  let len = Bytes::length(buf)\n  let rec go = (i: Int, result: Int, shift: Int) -> (Int, Int) {\n    if i >= len {\n      (result, i)\n    } else {\n      let byte = buf[i]\n      let value = result|((byte&0x7F)<<shift)\n      let next_shift = shift + 7\n      if eq(byte&0x80, 0) {\n        if (byte&0x40) > 0 {\n          let sign_extend = value|((-1)<<next_shift)\n          (sign_extend, i + 1)\n        } else {\n          (value, i + 1)\n        }\n      } else {\n        go(i + 1, value, next_shift)\n      }\n    }\n  }\n  go(offset, 0, 0)\n}\n\nexport fn read_uleb128(buf: Bytes, offset: Int) -> (Int, Int) {\n  let len = Bytes::length(buf)\n  let rec go = (i: Int, result: Int, shift: Int) -> (Int, Int) {\n    if i >= len {\n      (result, i)\n    } else {\n      let byte = buf[i]\n      let value = result|((byte&0x7F)<<shift)\n      if eq(byte&0x80, 0) {\n        (value, i + 1)\n      } else {\n        go(i + 1, value, shift + 7)\n      }\n    }\n  }\n  go(offset, 0, 0)\n}\n\nexport fn sleb128_size(n: Int) -> Int {\n  let rec go = (val: Int, count: Int) -> Int {\n    let byte = val&0x7F\n    let next = val>>7\n    if (eq(next, 0) && eq(byte&0x40, 0)) || (eq(next, -1) && (byte&0x40) > 0) {\n      count\n    } else go(next, count + 1)\n  }\n  go(n, 1)\n}\n\nexport fn uleb128_size(n: Int) -> Int {\n  let rec go = (val: Int, count: Int) -> Int {\n    let next = (val>>7)&((1<<25) - 1)\n    if eq(next, 0) {\n      count\n    }\n    else go(next, count + 1)\n  }\n  go(n, 1)\n}\n\nexport fn write_sleb128(buf: Bytes, n: Int) -> Unit {\n  let mut val = n\n  let mut more = true\n  while more {\n    let byte = val&0x7F\n    val = val>>7\n    if (eq(val, 0) && eq(byte&0x40, 0)) || (eq(val, -1) && (byte&0x40) > 0) {\n      Bytes::push(buf, byte)\n      more = false\n    } else {\n      Bytes::push(buf, byte|0x80)\n    }\n  }\n}\n\nexport fn write_uleb128(buf: Bytes, n: Int) -> Unit {\n  let mut val = n\n  while true {\n    let byte = val&0x7F\n    val = (val>>7)&((1<<25) - 1)\n    if eq(val, 0) {\n      Bytes::push(buf, byte)\n      break\n    } else {\n      Bytes::push(buf, byte|0x80)\n    }\n  }\n}\n\nexport fn encode_sleb128(n: Int) -> Bytes {\n  let buf = Bytes::new()\n  write_sleb128(buf, n)\n  buf\n}\n\nexport fn encode_uleb128(n: Int) -> Bytes {\n  let buf = Bytes::new()\n  write_uleb128(buf, n)\n  buf\n}\n")
}

