let source_34 = () -> (String, String) {
  ("lib/@vibe/compiler/checker/builtins.vibe",
"\nimport @vibe/compiler/codegen {\n  lookup_registry_builtin, canonical_builtin_name\n}\n\nimport @vibe/compiler/core {\n  Type\n}\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\nexport fn lookup_builtin(name: String) -> Option[Type] {\n  let normalized = canonical_builtin_name(name)\n  match lookup_registry_builtin(normalized) {\n    Some(t) => Some(t),\n    None => match lookup_array(normalized) {\n    Some(t) => Some(t),\n    None => match lookup_fixed_array(normalized) {\n      Some(t) => Some(t),\n      None => match lookup_array_builder(normalized) {\n        Some(t) => Some(t),\n        None => match lookup_string1(normalized) {\n          Some(t) => Some(t),\n          None => match lookup_string2(normalized) {\n            Some(t) => Some(t),\n            None => match lookup_string_builder(normalized) {\n              Some(t) => Some(t),\n              None => match lookup_bytes(normalized) {\n                Some(t) => Some(t),\n                None => match lookup_simd(normalized) {\n                Some(t) => Some(t),\n                None => match lookup_map(normalized) {\n                  Some(t) => Some(t),\n                  None => match lookup_io(normalized) {\n                    Some(t) => Some(t),\n                    None => match lookup_fs(normalized) {\n                      Some(t) => Some(t),\n                      None => match lookup_net(normalized) {\n                        Some(t) => Some(t),\n                        None => match lookup_misc(normalized) {\n                          Some(t) => Some(t),\n                          None => lookup_async(normalized)\n                        }\n                      }\n                    }\n                  }\n                }\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n  }\n}\n")
}

let source_35 = () -> (String, String) {
  ("lib/@vibe/compiler/checker/builtins_fs.vibe",
"\nimport @vibe/compiler/core {\n  Type\n}\n\nimport @vibe/core {\n  array_empty\n}\n\n\n\nfn fs_no_params() -> Array[Type] {\n  array_empty()\n}\n\nfn fs_one_param(a: Type) -> Array[Type] {\n  let arr = fs_no_params()\n  Array::push(arr, a)\n  arr\n}\n\nexport fn lookup_fs(name: String) -> Option[Type] {\n  if name == \"Fs::readdir\" {\n    Some(CtFn(fs_one_param(CtString), CtArray(CtString), Some(\"Fs\")))\n  }\n  else None\n}\n")
}

let source_36 = () -> (String, String) {
  ("lib/@vibe/compiler/checker/builtins_system.vibe",
"\nimport @vibe/compiler/core {\n  Type\n}\n\nimport @vibe/core {\n  array_empty\n}\n\n\nfn system_no_params() -> Array[Type] {\n  array_empty()\n}\n\nfn lookup_io_a(name: String) -> Option[Type] {\n  if name == \"sh\" {\n    Some(CtFn([\n      CtString\n    ], CtString, Some(\"Process\")))\n  } else if name == \"sh_lines\" {\n    Some(CtFn([\n      CtString\n    ], CtArray(CtString), Some(\"Process\")))\n  } else if name == \"path\" {\n    Some(CtFn([\n      CtString\n    ], CtUnknown, None))\n  } else if name == \"Path::ref\" {\n    Some(CtFn([\n      CtString\n    ], CtString, None))\n  } else if name == \"Path::to_string\" {\n    Some(CtFn([\n      CtUnknown\n    ], CtString, None))\n  } else if name == \"Path::is_absolute\" {\n    Some(CtFn([\n      CtString\n    ], CtBool, None))\n  } else if name == \"PromptText::new\" {\n    Some(CtFn([\n      CtString\n    ], CtString, None))\n  } else if name == \"Stdin::read_char\" {\n    Some(CtFn(system_no_params(), CtInt, Some(\"Stdin\")))\n  } else if name == \"Stdin::read_stream\" {\n    Some(CtFn([\n      CtInt\n    ], CtString, Some(\"Stdin\")))\n  } else {\n    None\n  }\n}\n\nfn lookup_io_b(name: String) -> Option[Type] {\n  if name == \"Stdout::write_char\" {\n    Some(CtFn([\n      CtInt\n    ], CtUnit, Some(\"Stdout\")))\n  } else if name == \"Stdout::write_stream\" {\n    Some(CtFn([\n      CtString\n    ], CtUnit, Some(\"Stdout\")))\n  } else if name == \"Env::get\" {\n    Some(CtFn([\n      CtString\n    ], CtString, Some(\"Env\")))\n  } else if name == \"Env::args_len\" {\n    Some(CtFn(system_no_params(), CtInt, Some(\"Env\")))\n  } else if name == \"Env::args_get\" {\n    Some(CtFn([\n      CtInt\n    ], CtString, Some(\"Env\")))\n  } else if name == \"Profiler::now_us\" {\n    Some(CtFn(system_no_params(), CtInt, Some(\"Profiler\")))\n  } else if name == \"sleep\" {\n    Some(CtFn([\n      CtInt\n    ], CtUnit, Some(\"Async\")))\n  } else if name == \"Path::resolve\" {\n    Some(CtFn([\n      CtString\n    ], CtString, None))\n  } else {\n    None\n  }\n}\n\nfn lookup_io_c(name: String) -> Option[Type] {\n  if name == \"Lines::parse\" {\n    Some(CtFn([\n      CtString\n    ], CtArray(CtString), None))\n  } else if name == \"Lines::stringify\" {\n    Some(CtFn([\n      CtArray(CtString)\n    ], CtString, None))\n  } else if name == \"Llm::complete\" {\n    Some(CtFn([\n      CtString,\n      CtString\n    ], CtString, Some(\"Llm\")))\n  } else if name == \"Rlm::run\" {\n    Some(CtFn([\n      CtString,\n      CtString\n    ], CtString, Some(\"Llm\")))\n  } else if name == \"Rlm::finalize\" {\n    Some(CtFn([\n      CtString\n    ], CtString, None))\n  } else {\n    None\n  }\n}\n\nexport fn lookup_io(name: String) -> Option[Type] {\n  match lookup_io_a(name) {\n    Some(t) => Some(t),\n    None => match lookup_io_b(name) {\n      Some(t) => Some(t),\n      None => lookup_io_c(name)\n    }\n  }\n}\n")
}

let source_37 = () -> (String, String) {
  ("lib/@vibe/compiler/checker/builtins_map.vibe",
"\nimport @vibe/compiler/core {\n  Type\n}\n\nimport @vibe/core {\n  array_empty\n}\n\n\nfn map_no_params() -> Array[Type] {\n  array_empty()\n}\n\nfn map_one_param(a: Type) -> Array[Type] {\n  let arr = map_no_params()\n  Array::push(arr, a)\n  arr\n}\n\nfn map_two_params(a: Type, b: Type) -> Array[Type] {\n  let arr = map_no_params()\n  Array::push(arr, a)\n  Array::push(arr, b)\n  arr\n}\n\nfn map_three_params(a: Type, b: Type, c: Type) -> Array[Type] {\n  let arr = map_no_params()\n  Array::push(arr, a)\n  Array::push(arr, b)\n  Array::push(arr, c)\n  arr\n}\n\nfn lookup_map_get(name: String) -> Option[Type] {\n  if name == \"Map::get\" {\n    Some(CtFn(map_two_params(CtUnknown, CtString), CtUnknown, None))\n  }\n  else None\n}\n\nfn lookup_map_has(name: String) -> Option[Type] {\n  if name == \"map_has\" {\n    Some(CtFn(map_two_params(CtUnknown, CtString), CtBool, None))\n  }\n  else None\n}\n\nfn lookup_map_set(name: String) -> Option[Type] {\n  if name == \"Map::set\" {\n    Some(CtFn(map_three_params(CtUnknown, CtString, CtUnknown), CtNamed(\"Map\", [\n      CtString,\n      CtUnknown\n    ]), None))\n  }\n  else None\n}\n\nfn lookup_map_keys(name: String) -> Option[Type] {\n  if name == \"Map::keys\" {\n    Some(CtFn(map_one_param(CtUnknown), CtArray(CtString), None))\n  }\n  else None\n}\n\nfn lookup_map_has_key(name: String) -> Option[Type] {\n  if name == \"Map::has_key\" || name == \"Map::has\" {\n    Some(CtFn(map_two_params(CtUnknown, CtString), CtBool, None))\n  }\n  else None\n}\n\nfn lookup_map_size(name: String) -> Option[Type] {\n  if name == \"Map::size\" {\n    Some(CtFn(map_one_param(CtUnknown), CtInt, None))\n  }\n  else None\n}\n\nfn lookup_map_values(name: String) -> Option[Type] {\n  if name == \"Map::values\" {\n    Some(CtFn(map_one_param(CtUnknown), CtArray(CtUnknown), None))\n  }\n  else None\n}\n\nfn lookup_map_delete(name: String) -> Option[Type] {\n  if name == \"Map::delete\" {\n    Some(CtFn(map_two_params(CtUnknown, CtString), CtNamed(\"Map\", [\n      CtString,\n      CtUnknown\n    ]), None))\n  }\n  else None\n}\n\nfn lookup_map_group_c(name: String) -> Option[Type] {\n  match lookup_map_size(name) {\n    Some(t) => Some(t),\n    None => match lookup_map_values(name) {\n      Some(t) => Some(t),\n      None => lookup_map_delete(name)\n    }\n  }\n}\n\nfn lookup_map_group_b(name: String) -> Option[Type] {\n  match lookup_map_has(name) {\n    Some(t) => Some(t),\n    None => match lookup_map_keys(name) {\n      Some(t) => Some(t),\n      None => match lookup_map_has_key(name) {\n        Some(t) => Some(t),\n        None => match lookup_map_set(name) {\n          Some(t) => Some(t),\n          None => lookup_map_group_c(name)\n        }\n      }\n    }\n  }\n}\n\nfn lookup_mapbuilder_new(name: String) -> Option[Type] {\n  if name == \"MapBuilder::new\" {\n    Some(CtFn(map_no_params(), CtUnknown, None))\n  }\n  else None\n}\n\nfn lookup_mapbuilder_set(name: String) -> Option[Type] {\n  if name == \"MapBuilder::set\" {\n    Some(CtFn(map_three_params(CtUnknown, CtString, CtUnknown), CtUnit, None))\n  }\n  else None\n}\n\nfn lookup_mapbuilder_freeze(name: String) -> Option[Type] {\n  if name == \"MapBuilder::freeze\" {\n    Some(CtFn(map_one_param(CtUnknown), CtUnknown, None))\n  }\n  else None\n}\n\nfn lookup_map_group_a(name: String) -> Option[Type] {\n  match lookup_mapbuilder_new(name) {\n    Some(t) => Some(t),\n    None => match lookup_mapbuilder_set(name) {\n      Some(t) => Some(t),\n      None => match lookup_mapbuilder_freeze(name) {\n        Some(t) => Some(t),\n        None => lookup_map_get(name)\n      }\n    }\n  }\n}\n\nexport fn lookup_map(name: String) -> Option[Type] {\n  match lookup_map_group_a(name) {\n    Some(t) => Some(t),\n    None => lookup_map_group_b(name)\n  }\n}\n")
}

