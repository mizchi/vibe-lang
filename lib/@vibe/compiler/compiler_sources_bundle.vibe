let source_155 = () -> (String, String) {
  ("lib/@vibe/compiler/codegen/gc/backend_lambda_body.vibe",
"\nimport @vibe/compiler/core {\n  Expr, TypeExpr\n}\n\nimport @vibe/compiler/codegen/common_base {\n  CompileCtxGc\n}\n\n\n\n\n\n\n\nexport fn compile_lambda_gc(buf: Bytes, params: Array[(String, Option[TypeExpr])], fn_body: Expr, local_names: Array[String], next_local: Int, ctx: CompileCtxGc, ld: Int, compile_fn: CompileLambdaGcFn) -> Int with { Error } {\n  let (captures, num_captures, user_params) = collect_lambda_captures_gc(params, fn_body, ctx)\n  let (lam_buf, final_lam_nl) = compile_lambda_inner_gc(params, fn_body, captures, user_params, ctx, compile_fn, ld)\n  let lambda_idx = record_lambda_meta_gc(ctx, lam_buf, user_params, captures, final_lam_nl)\n  let table_slot = ctx.num_user_funcs + lambda_idx\n  Array::push(ctx.table_slots_used, table_slot)\n  emit_lambda_closure_gc(buf, captures, num_captures, local_names, next_local, table_slot)\n}\n")
}

let source_156 = () -> (String, String) {
  ("lib/@vibe/compiler/codegen/gc/backend_lambda_collect.vibe",
"\nimport @vibe/compiler/core {\n  Expr, TypeExpr\n}\n\nimport @vibe/core {\n  array_empty\n}\n\nimport @vibe/compiler/codegen/common_analysis {\n  collect_free_vars\n}\n\nimport @vibe/compiler/codegen/common_base {\n  CompileCtxGc, CtorTable, FuncTable\n}\n\n\nexport fn collect_lambda_captures_gc(params: Array[(String, Option[TypeExpr])], fn_body: Expr, ctx: CompileCtxGc) -> (Array[String], Int, Int) {\n  let param_names_arr = array_empty()\n  let func_table = ctx.func_table\n  let ctor_table = ctx.gc_ctor_table\n  let mut pi = 0\n  while pi < Array::length(params) {\n    let (pname, _) = Array::get(params, pi)\n    Array::push(param_names_arr, pname)\n    pi = pi + 1\n  }\n  let mut globals = Array::concat(func_table.names, ctor_table.names)\n  globals = Array::concat(globals, ctx.gc_const_names)\n  globals = Array::concat(globals, ctx.gc_global_names)\n  globals = Array::concat(globals, [\n    \"__index\",\n    \"__len\",\n    \"__set_field\",\n    \"__set_index\",\n    \"__slice\",\n    \"__rec_field\"\n  ])\n  let captures = collect_free_vars(fn_body, param_names_arr, globals)\n  let num_captures = Array::length(captures)\n  let user_params = Array::length(params)\n  (captures, num_captures, user_params)\n}\n")
}

let source_157 = () -> (String, String) {
  ("lib/@vibe/compiler/codegen/gc/backend_lambda_inner.vibe",
"\nimport @vibe/compiler/core {\n  Expr, TypeExpr, bytebuf_new\n}\n\nimport @vibe/core {\n  array_empty\n}\n\nimport @vibe/compiler/codegen/common_base {\n  CompileCtxGc, emit_i64_load\n}\n\nimport @vibe/compiler/codegen/common_extractors {\n  array_contains_str\n}\n\nimport @vibe/compiler/codegen/wasm_emit {\n  emit_i32_wrap_i64, emit_local_get, emit_local_set\n}\n\n\n\n\nexport fn compile_lambda_inner_gc(params: Array[(String, Option[TypeExpr])], fn_body: Expr, captures: Array[String], user_params: Int, ctx: CompileCtxGc, compile_fn: CompileLambdaGcFn, ld: Int) -> (Bytes, Int) with { Error } {\n  let lam_buf = bytebuf_new()\n  let lam_locals = array_empty()\n  let mut lpi = 0\n  while lpi < user_params {\n    let (lpname, _) = Array::get(params, lpi)\n    Array::push(lam_locals, lpname)\n    lpi = lpi + 1\n  }\n  Array::push(lam_locals, \"__env\")\n  let env_param_idx = user_params\n  let lam_nl_start = user_params + 1\n  let lam_ref_cells = array_empty()\n  let lam_ref_local_indices = array_empty()\n  let num_captures = Array::length(captures)\n  let mut ci3 = 0\n  let mut lam_nl = lam_nl_start\n  while ci3 < num_captures {\n    let cap_local = lam_nl\n    let cap_name = Array::get(captures, ci3)\n    emit_local_get(lam_buf, env_param_idx)\n    emit_i32_wrap_i64(lam_buf)\n    emit_i64_load(lam_buf, 3, 8 + ci3 * 8)\n    emit_local_set(lam_buf, cap_local)\n    Array::push(lam_locals, cap_name)\n    if array_contains_str(ctx.ref_cell_names, cap_name) {\n      Array::push(lam_ref_cells, cap_name)\n    }\n    lam_nl = lam_nl + 1\n    ci3 = ci3 + 1\n  }\n  let lam_ctx = make_lambda_ctx_gc(ctx, lam_ref_cells, lam_ref_local_indices)\n  let mut lfs_i = 0\n  while lfs_i < user_params {\n    let (_, lfs_ann) = Array::get(params, lfs_i)\n    match lfs_ann {\n      Some(lfs_ty) => match lfs_ty {\n        TyName(lfs_tn) => if lfs_tn == \"Float\" || lfs_tn == \"Double\" {\n          Array::push(lam_ctx.gc_float_locals, lfs_i)\n        } else if lfs_tn == \"Bool\" {\n          Array::push(lam_ctx.gc_bool_locals, lfs_i)\n        } else {\n          ()\n        },\n        _ => ()\n      },\n      None => ()\n    }\n    lfs_i = lfs_i + 1\n  }\n  let final_lam_nl = compile_fn(lam_buf, fn_body, lam_locals, lam_nl, lam_ctx, ld)\n  (lam_buf, final_lam_nl)\n}\n")
}

let source_158 = () -> (String, String) {
  ("lib/@vibe/compiler/codegen/gc/backend_lambda_record.vibe",
"\nimport @vibe/compiler/codegen/common_base {\n  CompileCtxGc, LambdaTable\n}\n\n\nexport fn record_lambda_meta_gc(ctx: CompileCtxGc, lam_buf: Bytes, user_params: Int, captures: Array[String], final_lam_nl: Int) -> Int {\n  let lambda_table = ctx.lambda_table\n  let lambda_idx = Array::length(lambda_table.bodies)\n  Array::push(lambda_table.bodies, lam_buf)\n  Array::push(lambda_table.param_counts, user_params + 1)\n  Array::push(lambda_table.captures, captures)\n  let mut extra_lam = 0\n  let min_lam_nl = user_params + 1\n  if final_lam_nl > min_lam_nl {\n    extra_lam = final_lam_nl - min_lam_nl\n  }\n  Array::push(lambda_table.meta_i32, 0)\n  Array::push(lambda_table.meta_i64, extra_lam)\n  lambda_idx\n}\n")
}

let source_159 = () -> (String, String) {
  ("lib/@vibe/compiler/codegen/index.vpkg",
"name = @vibe/compiler/codegen\nversion = 0.0.1\ndescription =\n  #|@vibe/compiler/codegen — ADR-0070 / #897 compiler-internal contract for\ndeps = {\n  @vibe/compiler/codegen/common_base : 0.0.1\n  @vibe/compiler/codegen/expr : 0.0.1\n  @vibe/compiler/codegen/wasi : 0.0.1\n  @vibe/compiler/core : 0.0.1\n}\n\ngenerated_hash =\n\n// @vibe/compiler/codegen — ADR-0070 / #897 compiler-internal contract for\n// this directory's own top-level files ONLY. The 8 subdirectories\n// (builtin_bodies/, common_analysis/, common_base/, common_extractors/,\n// expr/, gc/, wasi/, wasm_emit/) are each already separate, already-migrated\n// index.vpkg packages in their own right (earlier batches of this same\n// #897 series) and are NOT covered by this contract — this package imports\n// them as ordinary sibling packages, same as any other outside consumer.\n//\n// Single-file package: codegen.vibe (the old index.vibe, renamed — see\n// naming note below) is the ENTIRE directory-owned surface. It is a thin\n// public facade, forwarding compile_module/compile_wasi_module* to the\n// expr/ and wasi/ subpackages, and re-exporting a subset of\n// codegen/common_base's surface (lookup_registry_builtin, builtin_registry,\n// verify_lane_builtins, compile_inline_wat) via the `export ./common_base\n// { names }` cross-package SReExport form (#847 Phase C; same shape as\n// syntax/syntax.vibe's re-export of @vibe/parser).\n//\n// Structural wrinkle (found only via the full verification chain, not by\n// static reading — scripts/unit_test_runner.sh, not the earlier build/gate\n// steps, is what caught it): builtin_registry.vibe, double_to_string_expr.\n// vibe, int_parse_expr.vibe and inline_wat.vibe used to live at this\n// directory's top level too (siblings of codegen.vibe). But codegen/'s own\n// subpackages (expr/, gc/, wasi/) need those 4 files directly, while\n// codegen.vibe (this package's facade) ALSO depends downward on expr/ and\n// wasi/ to forward compile_module/compile_wasi_module*. Owning those 4\n// files here therefore made codegen/index.vpkg <-> codegen/expr(gc,wasi)/\n// index.vpkg a genuine two-node import cycle the moment expr/gc/wasi's leaf\n// imports of them were switched from raw file paths (rejected by\n// enforce_incoming_boundary_fs, #729, once this directory became a package\n// boundary) to boundary-legal package imports (`type_db: import cycle\n// detected at codegen/index.vpkg`). Resolved by relocating all 4 files into\n// codegen/common_base/ — see that package's index.vpkg header for the full\n// story — which already plays the \"shared substrate every codegen backend\n// and expr-compile module depends on, with no upward edges of its own\"\n// role. This package therefore ends up back to a single file, same shape as\n// common_base/ was before this same batch added those 4 files to it.\n//\n// Naming note: the established rename convention for this migration batch\n// is `git mv index.vibe <dirname>.vibe` (codegen/expr/expr.vibe,\n// codegen/gc/gc.vibe, syntax/syntax.vibe, checker/checker_facade.vibe when\n// dirname collided). For this directory the dirname is \"codegen\" and no\n// `codegen/codegen.vibe` previously existed, so the plain rename applies\n// with no collision.\n//\n// Compiled into the compiler itself via compiler_sources_manifest.tsv\n// (group `codegen`): the old single `codegen/index.vibe` row becomes a dual\n// row (this contract + codegen.vibe); builtin_registry.vibe /\n// double_to_string_expr.vibe / int_parse_expr.vibe / inline_wat.vibe's rows\n// are repointed to their new codegen/common_base/ paths (see that\n// package's manifest rows) as part of this same batch.\n\n// --- codegen.vibe\nfn compile_module(stmts: Array[Stmt]) -> Bytes with { Error }\nfn compile_wasi_module_with_sources(stmts: Array[Stmt], entry_name: String, srcs: Array[(String, String)]) -> Bytes with { Error }\nfn compile_wasi_module(stmts: Array[Stmt], entry_name: String) -> Bytes with { Error }\nfn compile_wasi_module_replayed(stmts: Array[Stmt], entry_name: String) -> Bytes with { Error }\nfn compile_wasi_module_sliced(stmts: Array[Stmt], entry_name: String) -> Bytes with { Error }\nfn compile_wasi_module_rc(stmts: Array[Stmt], entry_name: String) -> Bytes with { Error }\nfn compile_wasi_module_rc_shadow(stmts: Array[Stmt], entry_name: String) -> Bytes with { Error }\nfn compile_wasi_module_coverage(stmts: Array[Stmt], entry_name: String) -> Bytes with { Error }\nfn compile_wasi_module_trace(stmts: Array[Stmt], entry_name: String) -> Bytes with { Error }\nfn compile_wasi_module_break(stmts: Array[Stmt], entry_name: String, prov: DbgProv) -> Bytes with { Error }\n\n// --- re-exported from codegen/common_base (cross-package SReExport, see\n// header note above); NOT declared here: builtin_registry_typed,\n// double_to_string_expr, int_parse_expr, desugar_derives,\n// desugar_hoist_local_lambdas, desugar_array_spread, which codegen.vibe does\n// not re-export (nothing outside codegen/common_base itself consumes them) —\n// see codegen/common_base/index.vpkg for their declarations.\nfn lookup_registry_builtin(name: String) -> Option[Type]\nfn builtin_registry() -> Array[(String, Int, Int, Bool, Bool)]\nfn verify_lane_builtins(lane: String, names: Array[String], param_counts: Array[Int], returns: Array[Int]) -> Unit with { Error }\nfn compile_inline_wat(fn_name: String, wat: String, param_names: Array[String]) -> Bytes with { Error }\nfn compile_inline_wat_full(fn_name: String, wat: String, param_names: Array[String], extra_base: Int) -> (Bytes, Int, Int, Int) with { Error }\n\n// --- builtin_name.vibe / desugar_trait_dict.vibe (relocated into\n// codegen/common_base, #897 batch; see that package's index.vpkg header)\nfn canonical_builtin_name(name: String) -> String\nfn desugar_labeled_args(stmts: Array[Stmt]) -> Unit\nfn desugar_railway_binds(stmts: Array[Stmt]) -> Unit\nfn inject_prelude_result(stmts: Array[Stmt]) -> Unit\nfn inject_trait_method_generics(stmts: Array[Stmt]) -> Unit\nfn desugar_trait_dicts(stmts: Array[Stmt]) -> Unit\n// #1374: the exception-kind side channel. `desugar_trait_dicts` maintains the\n// cell; these two let a pass that runs AFTER it (the entry boundary) read the\n// kind and make sure the cell exists.\nfn exn_kind_read_expr() -> Expr\nfn exn_msg_read_expr() -> Expr\nfn ensure_exn_kind_cell(stmts: Array[Stmt]) -> Unit\n")
}

let source_160 = () -> (String, String) {
  ("lib/@vibe/compiler/codegen/codegen.vibe",
"\nimport @vibe/compiler/core {\n  Stmt\n}\n\nimport @vibe/compiler/codegen/common_base {\n  DbgProv\n}\n\nimport @vibe/compiler/codegen/expr {\n  compile_module_expr\n}\n\nimport @vibe/compiler/codegen/wasi {\n  compile_wasi_module_break_impl,\n  compile_wasi_module_coverage_impl,\n  compile_wasi_module_impl,\n  compile_wasi_module_rc_impl,\n  compile_wasi_module_rc_shadow_impl,\n  compile_wasi_module_replayed_impl,\n  compile_wasi_module_sliced_impl,\n  compile_wasi_module_trace_impl,\n  compile_wasi_module_with_sources_impl\n}\n\n\n\nexport fn compile_module(stmts: Array[Stmt]) -> Bytes with { Error } {\n  compile_module_expr(stmts)\n}\n\nexport fn compile_wasi_module_with_sources(stmts: Array[Stmt], entry_name: String, srcs: Array[(String, String)]) -> Bytes with { Error } {\n  compile_wasi_module_with_sources_impl(stmts, entry_name, srcs)\n}\n\nexport fn compile_wasi_module(stmts: Array[Stmt], entry_name: String) -> Bytes with { Error } {\n  compile_wasi_module_impl(stmts, entry_name)\n}\n\nexport fn compile_wasi_module_replayed(stmts: Array[Stmt], entry_name: String) -> Bytes with { Error } {\n  compile_wasi_module_replayed_impl(stmts, entry_name)\n}\n\nexport fn compile_wasi_module_sliced(stmts: Array[Stmt], entry_name: String) -> Bytes with { Error } {\n  compile_wasi_module_sliced_impl(stmts, entry_name)\n}\n\nexport fn compile_wasi_module_rc(stmts: Array[Stmt], entry_name: String) -> Bytes with { Error } {\n  compile_wasi_module_rc_impl(stmts, entry_name)\n}\n\nexport fn compile_wasi_module_rc_shadow(stmts: Array[Stmt], entry_name: String) -> Bytes with { Error } {\n  compile_wasi_module_rc_shadow_impl(stmts, entry_name)\n}\n\nexport fn compile_wasi_module_coverage(stmts: Array[Stmt], entry_name: String) -> Bytes with { Error } {\n  compile_wasi_module_coverage_impl(stmts, entry_name)\n}\n\nexport fn compile_wasi_module_trace(stmts: Array[Stmt], entry_name: String) -> Bytes with { Error } {\n  compile_wasi_module_trace_impl(stmts, entry_name)\n}\n\nexport fn compile_wasi_module_break(stmts: Array[Stmt], entry_name: String, prov: DbgProv) -> Bytes with { Error } {\n  compile_wasi_module_break_impl(stmts, entry_name, prov)\n}\n\n")
}

let source_161 = () -> (String, String) {
  ("lib/@vibe/compiler/runtime/eval_loader/index.vpkg",
"name = @vibe/compiler/runtime/eval_loader\nversion = 0.0.1\ndescription =\n  #|@vibe/compiler/runtime/eval_loader — small helpers for the shell/REPL's\ndeps = {\n  @vibe/compiler/core : 0.0.1\n  @vibe/compiler/syntax : 0.0.1\n  @vibe/core : 0.2.0\n}\n\ngenerated_hash =\n\n// @vibe/compiler/runtime/eval_loader — small helpers for the shell/REPL's\n// incremental source-buffer evaluation: source lookup by path key, parse +\n// export-name collection for the eval loop (ADR-0070 Phase 3, #897,\n// compiler-internal batch). Compiled into the compiler itself via\n// compiler_sources_manifest.tsv (group `runtime`, dual-row: this contract +\n// eval_loader.vibe).\n//\n// The old index.vibe was not a facade but the whole implementation (the\n// package is single-file), so it moved verbatim to eval_loader.vibe. No\n// exported types: `Stmt` (from ../../core) arrives as structural signature\n// text resolved against the implementation import when the facade is\n// merged in (normalize/perceus precedent — no re-import needed here). No\n// `version` binding existed (compiler-internal package).\n\nfn contains_str(arr: Array[String], target: String) -> Bool\nfn source_lookup(sources: Array[(String, String)], path_key: String) -> Option[String]\nfn load_and_parse(source: String) -> Array[Stmt] with { Error }\nfn collect_exports(stmts: Array[Stmt]) -> Array[String]\n")
}

let source_162 = () -> (String, String) {
  ("lib/@vibe/compiler/runtime/eval_loader/eval_loader.vibe",
"\nimport @vibe/compiler/syntax {\n  lex, parse, parse_program\n}\n\nimport @vibe/core {\n  array_empty\n}\n\nimport @vibe/compiler/core {\n  Expr, Pat, Stmt, TypeExpr\n}\n\n\nfn resolve_interp_expr(expr: Expr) -> Expr with { Error } {\n  match expr {\n    EStringInterp(parts) => {\n      let plen = Array::length(parts)\n      let exprs = ArrayBuilder::new()\n      let mut i = 0\n      while i < plen {\n        let lit = Array::get(parts, i)\n        if String::length(lit) > 0 {\n          ArrayBuilder::push(exprs, EString(lit))\n        }\n        if i + 1 < plen {\n          let expr_src = Array::get(parts, i + 1)\n          let resolved = resolve_interp_expr(parse(lex(expr_src)))\n          ArrayBuilder::push(exprs, ECall(EIdent(\"__to_string\", -1), [\n            resolved\n          ], -1))\n        }\n        i = i + 2\n      }\n      let out = ArrayBuilder::freeze(exprs)\n      let len = Array::length(out)\n      if len == 0 {\n        EString(\"\")\n      }\n      else {\n        let mut acc = Array::get(out, 0)\n        let mut j = 1\n        while j < len {\n          acc = ECall(EIdent(\"String::concat\", -1), [\n            acc,\n            Array::get(out, j)\n          ], -1)\n          j = j + 1\n        }\n        acc\n      }\n    },\n    EInt(_) => expr,\n    EFloat(_) => expr,\n    EString(_) => expr,\n    EBool(_) => expr,\n    EUnit => expr,\n    EIdent(_, _) => expr,\n    ETuple(elems) => ETuple(for elem in elems {\n      resolve_interp_expr(elem)\n    }),\n    EArray(elems) => EArray(for elem in elems {\n      resolve_interp_expr(elem)\n    }),\n    ERecord(rn, fields, targs) => ERecord(rn, for field in fields {\n      let (name, value) = field; (name, resolve_interp_expr(value))\n    }, targs),\n    EMap(fields) => EMap(for field in fields {\n      let (name, value) = field; (name, resolve_interp_expr(value))\n    }),\n    EIf(cond, then_expr, else_expr) => EIf(resolve_interp_expr(cond), resolve_interp_expr(then_expr), resolve_interp_expr(else_expr)),\n    ELet(name, value, body, soff) => ELet(name, resolve_interp_expr(value), resolve_interp_expr(body), soff),\n    ELetRec(name, value, body) => ELetRec(name, resolve_interp_expr(value), resolve_interp_expr(body)),\n    ELetMut(name, value, body, soff) => ELetMut(name, resolve_interp_expr(value), resolve_interp_expr(body), soff),\n    EAssign(name, value, body) => EAssign(name, resolve_interp_expr(value), resolve_interp_expr(body)),\n    EAssignOp(name, op, value, body) => EAssignOp(name, op, resolve_interp_expr(value), resolve_interp_expr(body)),\n    ESeq(left, right) => ESeq(resolve_interp_expr(left), resolve_interp_expr(right)),\n    EMatch(scrutinee, arms) => EMatch(resolve_interp_expr(scrutinee), for arm in arms {\n      let (pat, body) = arm; (pat, resolve_interp_expr(body))\n    }),\n    EHandle(scrutinee, arms) => EHandle(resolve_interp_expr(scrutinee), for arm in arms {\n      let (pat, body) = arm; (pat, resolve_interp_expr(body))\n    }),\n    EWhile(cond, body) => EWhile(resolve_interp_expr(cond), resolve_interp_expr(body)),\n    ELoop(params, body) => ELoop(for param in params {\n      let (name, init) = param; (name, resolve_interp_expr(init))\n    }, resolve_interp_expr(body)),\n    EForIn(name, index_name, iter, body) => EForIn(name, index_name, resolve_interp_expr(iter), resolve_interp_expr(body)),\n    ECall(callee, args, off) => ECall(resolve_interp_expr(callee), for arg in args {\n      resolve_interp_expr(arg)\n    }, off),\n    EBinOp(op, left, right) => EBinOp(op, resolve_interp_expr(left), resolve_interp_expr(right)),\n    EUnaryOp(op, inner) => EUnaryOp(op, resolve_interp_expr(inner)),\n    EFn(type_params, bounds, params, ret_ty, effect, body) => EFn(type_params, bounds, params, ret_ty, effect, resolve_interp_expr(body)),\n    EDot(inner, field, off, fdoff) => EDot(resolve_interp_expr(inner), field, off, fdoff),\n    EReturn(inner) => EReturn(resolve_interp_expr(inner)),\n    EBreak(opt) => match opt {\n      None => expr,\n      Some(value) => EBreak(Some(resolve_interp_expr(value)))\n    },\n    EContinue(args) => EContinue(for arg in args {\n      resolve_interp_expr(arg)\n    }),\n    ELabeledArg(label, name, value) => ELabeledArg(label, name, resolve_interp_expr(value)),\n    ESpread(inner) => ESpread(resolve_interp_expr(inner))\n  }\n}\n\nfn resolve_interp_stmt(stmt: Stmt) -> Stmt with { Error } {\n  match stmt {\n    SLet(exported, is_rec, name, ty, value) => SLet(exported, is_rec, name, ty, resolve_interp_expr(value)),\n    SLetMut(name, ty, value) => SLetMut(name, ty, resolve_interp_expr(value)),\n    STest(name, body) => STest(name, resolve_interp_expr(body)),\n    SBench(name, body) => SBench(name, resolve_interp_expr(body)),\n    SExpr(expr) => SExpr(resolve_interp_expr(expr)),\n    _ => stmt\n  }\n}\n\nexport fn contains_str(arr: Array[String], target: String) -> Bool {\n  let rec go: (Int) -> Bool = (i) -> {\n    if i >= Array::length(arr) {\n      false\n    }\n    else {\n      if Array::get(arr, i) == target {\n        true\n      }\n      else {\n        go(i + 1)\n      }\n    }\n  }\n  go(0)\n}\n\nexport fn source_lookup(sources: Array[(String, String)], path_key: String) -> Option[String] {\n  let rec go: (Int) -> Option[String] = (i) -> {\n    if i >= Array::length(sources) {\n      None\n    }\n    else {\n      let (p, src) = Array::get(sources, i)\n      if p == path_key {\n        Some(src)\n      }\n      else {\n        go(i + 1)\n      }\n    }\n  }\n  go(0)\n}\n\nexport fn load_and_parse(source: String) -> Array[Stmt] with { Error } {\n  let tokens = lex(source)\n  for stmt in parse_program(tokens) {\n    resolve_interp_stmt(stmt)\n  }\n}\n\nexport fn collect_exports(stmts: Array[Stmt]) -> Array[String] {\n  let out = array_empty()\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SLet(true, _, name, _, _) => Array::push(out, name),\n      SEnum(true, _, _, variants, _) => {\n        let mut j = 0\n        while j < Array::length(variants) {\n          let (cname, _) = Array::get(variants, j)\n          Array::push(out, cname)\n          j = j + 1\n        }\n      },\n      SExport(names) => {\n        let mut j = 0\n        while j < Array::length(names) {\n          Array::push(out, Array::get(names, j))\n          j = j + 1\n        }\n      },\n      SReExport(_, names) => {\n        let mut j = 0\n        while j < Array::length(names) {\n          let (name, _) = Array::get(names, j)\n          Array::push(out, name)\n          j = j + 1\n        }\n      },\n      _ => ()\n    }\n    i = i + 1\n  }\n  out\n}\n")
}

let source_163 = () -> (String, String) {
  ("lib/@vibe/graph/index.vpkg",
"name = @vibe/graph\nversion = 0.0.1\ndescription =\n  #|@vibe/graph — the selfhost compiler's incremental module DB (ADR-0070\ndeps = {}\n\ngenerated_hash =\n\n// @vibe/graph — the selfhost compiler's incremental module DB (ADR-0070\n// Phase 3, #897): maps module path -> source, path -> fingerprint, path ->\n// dependency list, plus an eval counter, as one fixed-bucket hash-map-backed\n// linear value (callers must thread the returned db, not reuse a stale one\n// -- see graph.vibe's header comment). `RippleDb` is declared `opaque`: no\n// consumer (in-repo, including the compiler's own runtime/index.vibe,\n// confirmed via repo-wide grep) ever constructs or pattern-matches it\n// directly, only through ripple_new/ripple_get_*/ripple_set_source/\n// ripple_record_eval. `StrMap`/`DepsMap` (graph.vibe's internal bucket-map\n// representation, used only inside RippleDb's own variant payload) are\n// likewise never referenced outside graph.vibe -- but `check_contract`\n// still requires every exported type declared regardless of external\n// usage (same rule as fns; confirmed by a real conformance-check failure\n// when they were first left undeclared), so they're declared `opaque`\n// here too. `version` was `export let\n// version = \"0.0.1\"` directly in the old index.vibe facade -- a real\n// importable binding, not just contract metadata -- so it is preserved\n// verbatim as an implementation-file value (graph.vibe) with a matching\n// bodyless declaration here (Codex review precedent, PR #914).\n\nopaque type StrMap\nopaque type DepsMap\nopaque type RippleDb\n\nfn ripple_new() -> RippleDb\nfn ripple_set_source(db: RippleDb, path: String, source: String) -> RippleDb\nfn ripple_get_source(db: RippleDb, path: String) -> Option[String]\nfn ripple_get_fingerprint(db: RippleDb, path: String) -> Option[String]\nfn ripple_get_deps(db: RippleDb, path: String) -> Option[Array[String]]\nfn ripple_record_eval(db: RippleDb, path: String, fingerprint: String, deps: Array[String]) -> RippleDb\nfn ripple_eval_count(db: RippleDb) -> Int\n\n// #1239 step 4A: the coordinator-side upfront import-DAG pass (cycle\n// rejection + rank/topological order). Pure apart from `Error` -- dependency\n// resolution needs `Fs`, ordering does not -- so it is testable, and Lean-\n// modellable, without a filesystem. See graph.vibe for why the split matters\n// and what stays blocked on #906 step 4(D).\nfn plan_module_order(edges: Array[(String, Array[String])], root: String) -> (Array[String], Array[Int]) with { Error }\n")
}

let source_164 = () -> (String, String) {
  ("lib/@vibe/graph/graph.vibe",
"\n\n\n\nexport enum StrMap {\n  StrMap(Array[Array[(String, String)]])\n}\n\nexport enum DepsMap {\n  DepsMap(Array[Array[(String, Array[String])]])\n}\n\nexport enum RippleDb {\n  RippleDb(StrMap, StrMap, DepsMap, Array[Int])\n}\n\n\nfn nbuckets() -> Int {\n  256\n}\n\nfn bucket_mask() -> Int {\n  255\n}\n\nfn hash_bucket(key: String) -> Int {\n  let len = String::length(key)\n  let rec go: (Int, Int) -> Int = (i, acc) -> {\n    if i >= len {\n      acc\n    } else {\n      let c = String::char_code_at(key, i)\n      let mixed = (acc^c) * 16777619\n      let bounded = mixed&1073741823\n      go(i + 1, bounded)\n    }\n  }\n  let h = go(0, 2166136261&1073741823)\n  h&bucket_mask()\n}\n\nfn empty_strings() -> Array[String] {\n  Array::slice([\n    \"\"\n  ], 0, 0)\n}\n\nfn empty_string_pairs() -> Array[(String, String)] {\n  Array::slice([\n    (\"\", \"\")\n  ], 0, 0)\n}\n\nfn empty_deps_pairs() -> Array[(String, Array[String])] {\n  Array::slice([\n    (\"\", empty_strings())\n  ], 0, 0)\n}\n\nfn new_string_buckets() -> Array[Array[(String, String)]] {\n  let n = nbuckets()\n  let b = ArrayBuilder::new()\n  let rec go: (Int) -> Unit = (i) -> {\n    if i >= n {\n      ()\n    } else {\n      ArrayBuilder::push(b, empty_string_pairs())\n      go(i + 1)\n    }\n  }\n  go(0)\n  ArrayBuilder::freeze(b)\n}\n\nfn new_deps_buckets() -> Array[Array[(String, Array[String])]] {\n  let n = nbuckets()\n  let b = ArrayBuilder::new()\n  let rec go: (Int) -> Unit = (i) -> {\n    if i >= n {\n      ()\n    } else {\n      ArrayBuilder::push(b, empty_deps_pairs())\n      go(i + 1)\n    }\n  }\n  go(0)\n  ArrayBuilder::freeze(b)\n}\n\nfn strmap_new() -> StrMap {\n  StrMap(new_string_buckets())\n}\n\nfn assoc_get_string(bucket: Array[(String, String)], key: String, i: Int) -> Option[String] {\n  if i >= Array::length(bucket) {\n    None\n  } else {\n    let (k, v) = Array::get(bucket, i)\n    if k == key {\n      Some(v)\n    } else {\n      assoc_get_string(bucket, key, i + 1)\n    }\n  }\n}\n\nfn strmap_get(m: StrMap, key: String) -> Option[String] {\n  match m {\n    StrMap(buckets) => {\n      let idx = hash_bucket(key)\n      let bucket = Array::get(buckets, idx)\n      assoc_get_string(bucket, key, 0)\n    }\n  }\n}\n\nfn strmap_set(m: StrMap, key: String, value: String) -> Unit {\n  match m {\n    StrMap(buckets) => {\n      let idx = hash_bucket(key)\n      let bucket = Array::get(buckets, idx)\n      let len = Array::length(bucket)\n      let rec go: (Int) -> Unit = (i) -> {\n        if i >= len {\n          Array::push(bucket, (key, value))\n        } else {\n          let (k, _) = Array::get(bucket, i)\n          if k == key {\n            Array::set(bucket, i, (key, value))\n          } else {\n            go(i + 1)\n          }\n        }\n      }\n      go(0)\n    }\n  }\n}\n\nfn depsmap_new() -> DepsMap {\n  DepsMap(new_deps_buckets())\n}\n\nfn assoc_get_deps(bucket: Array[(String, Array[String])], key: String, i: Int) -> Option[Array[String]] {\n  if i >= Array::length(bucket) {\n    None\n  } else {\n    let (k, v) = Array::get(bucket, i)\n    if k == key {\n      Some(v)\n    } else {\n      assoc_get_deps(bucket, key, i + 1)\n    }\n  }\n}\n\nfn depsmap_get(m: DepsMap, key: String) -> Option[Array[String]] {\n  match m {\n    DepsMap(buckets) => {\n      let idx = hash_bucket(key)\n      let bucket = Array::get(buckets, idx)\n      assoc_get_deps(bucket, key, 0)\n    }\n  }\n}\n\nfn depsmap_set(m: DepsMap, key: String, deps: Array[String]) -> Unit {\n  match m {\n    DepsMap(buckets) => {\n      let idx = hash_bucket(key)\n      let bucket = Array::get(buckets, idx)\n      let len = Array::length(bucket)\n      let rec go: (Int) -> Unit = (i) -> {\n        if i >= len {\n          Array::push(bucket, (key, deps))\n        } else {\n          let (k, _) = Array::get(bucket, i)\n          if k == key {\n            Array::set(bucket, i, (key, deps))\n          } else {\n            go(i + 1)\n          }\n        }\n      }\n      go(0)\n    }\n  }\n}\n\nexport fn ripple_new() -> RippleDb {\n  let count = ArrayBuilder::new()\n  ArrayBuilder::push(count, 0)\n  RippleDb(strmap_new(), strmap_new(), depsmap_new(), ArrayBuilder::freeze(count))\n}\n\nexport fn ripple_get_source(db: RippleDb, path: String) -> Option[String] {\n  match db {\n    RippleDb(sources, _, _, _) => strmap_get(sources, path)\n  }\n}\n\nexport fn ripple_get_fingerprint(db: RippleDb, path: String) -> Option[String] {\n  match db {\n    RippleDb(_, fingerprints, _, _) => strmap_get(fingerprints, path)\n  }\n}\n\nexport fn ripple_get_deps(db: RippleDb, path: String) -> Option[Array[String]] {\n  match db {\n    RippleDb(_, _, deps_map, _) => depsmap_get(deps_map, path)\n  }\n}\n\nexport fn ripple_eval_count(db: RippleDb) -> Int {\n  match db {\n    RippleDb(_, _, _, count) => Array::get(count, 0)\n  }\n}\n\nexport fn ripple_set_source(db: RippleDb, path: String, source: String) -> RippleDb {\n  match db {\n    RippleDb(sources, _, _, _) => {\n      strmap_set(sources, path, source)\n      db\n    }\n  }\n}\n\nexport fn ripple_record_eval(db: RippleDb, path: String, fingerprint: String, deps: Array[String]) -> RippleDb {\n  match db {\n    RippleDb(_, fingerprints, deps_map, count) => match strmap_get(fingerprints, path) {\n      Some(prev_fp) => if prev_fp == fingerprint {\n        db\n      } else {\n        strmap_set(fingerprints, path, fingerprint)\n        depsmap_set(deps_map, path, deps)\n        Array::set(count, 0, Array::get(count, 0) + 1)\n        db\n      },\n      None => {\n        strmap_set(fingerprints, path, fingerprint)\n        depsmap_set(deps_map, path, deps)\n        Array::set(count, 0, Array::get(count, 0) + 1)\n        db\n      }\n    }\n  }\n}\n\n\nfn mo_str_lt(a: String, b: String) -> Bool {\n  let la = String::length(a)\n  let lb = String::length(b)\n  let lim = if la < lb {\n    la\n  } else {\n    lb\n  }\n  let mut i = 0\n  let mut res = la < lb\n  let mut done = false\n  while i < lim && !done {\n    let ca = String::char_code_at(a, i)\n    let cb = String::char_code_at(b, i)\n    if ca < cb {\n      res = true\n      done = true\n    } else if ca > cb {\n      res = false\n      done = true\n    } else {\n      i = i + 1\n    }\n  }\n  res\n}\n\nfn mo_index_of(names: Array[String], p: String) -> Int {\n  let n = Array::length(names)\n  let mut i = 0\n  let mut found = -1\n  while found < 0 && i < n {\n    if Array::get(names, i) == p {\n      found = i\n    } else {\n      i = i + 1\n    }\n  }\n  found\n}\n\nfn mo_deps_of(edges: Array[(String, Array[String])], p: String) -> Array[String] {\n  let n = Array::length(edges)\n  let mut i = 0\n  let out: Array[String] = [\n  ]\n  let mut done = false\n  while !done && i < n {\n    let e = Array::get(edges, i)\n    if e.0 == p {\n      let deps = e.1\n      let dn = Array::length(deps)\n      let mut j = 0\n      while j < dn {\n        Array::push(out, Array::get(deps, j))\n        j = j + 1\n      }\n      done = true\n    } else {\n      i = i + 1\n    }\n  }\n  out\n}\n\nfn mo_intern(names: Array[String], color: Array[Int], rank: Array[Int], p: String) -> Int {\n  let existing = mo_index_of(names, p)\n  if existing >= 0 {\n    existing\n  } else {\n    Array::push(names, p)\n    Array::push(color, 0)\n    Array::push(rank, 0)\n    Array::length(names) - 1\n  }\n}\n\nexport fn plan_module_order(edges: Array[(String, Array[String])], root: String) -> (Array[String], Array[Int]) with { Error } {\n  let names: Array[String] = [\n  ]\n  let color: Array[Int] = [\n  ]\n  let rank: Array[Int] = [\n  ]\n  let st_node: Array[Int] = [\n  ]\n  let st_cursor: Array[Int] = [\n  ]\n  let root_id = mo_intern(names, color, rank, root)\n  Array::set(color, root_id, 1)\n  Array::push(st_node, root_id)\n  Array::push(st_cursor, 0)\n  while Array::length(st_node) > 0 {\n    let top = Array::length(st_node) - 1\n    let nid = Array::get(st_node, top)\n    let cursor = Array::get(st_cursor, top)\n    let deps = mo_deps_of(edges, Array::get(names, nid))\n    if cursor < Array::length(deps) {\n      Array::set(st_cursor, top, cursor + 1)\n      let dep = Array::get(deps, cursor)\n      let did = mo_intern(names, color, rank, dep)\n      let dcolor = Array::get(color, did)\n      if dcolor == 1 {\n        throw(String::concat(\"type_db: import cycle detected at \", dep))\n      } else if dcolor == 0 {\n        Array::set(color, did, 1)\n        Array::push(st_node, did)\n        Array::push(st_cursor, 0)\n      } else {\n        ()\n      }\n    } else {\n      let mut r = 0\n      let mut i = 0\n      while i < Array::length(deps) {\n        let did = mo_index_of(names, Array::get(deps, i))\n        if did >= 0 {\n          let dr = Array::get(rank, did) + 1\n          if dr > r {\n            r = dr\n          } else {\n            ()\n          }\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      Array::set(rank, nid, r)\n      Array::set(color, nid, 2)\n      Array::truncate(st_node, top)\n      Array::truncate(st_cursor, top)\n    }\n  }\n  let out_paths: Array[String] = [\n  ]\n  let out_ranks: Array[Int] = [\n  ]\n  let total = Array::length(names)\n  let mut k = 0\n  while k < total {\n    let nm = Array::get(names, k)\n    let rk = Array::get(rank, k)\n    let placed = Array::length(out_paths)\n    let mut pos = 0\n    let mut settled = false\n    while !settled && pos < placed {\n      let ork = Array::get(out_ranks, pos)\n      if rk < ork || (rk == ork && mo_str_lt(nm, Array::get(out_paths, pos))) {\n        settled = true\n      } else {\n        pos = pos + 1\n      }\n    }\n    Array::push(out_paths, \"\")\n    Array::push(out_ranks, 0)\n    let mut shift = Array::length(out_paths) - 1\n    while shift > pos {\n      Array::set(out_paths, shift, Array::get(out_paths, shift - 1))\n      Array::set(out_ranks, shift, Array::get(out_ranks, shift - 1))\n      shift = shift - 1\n    }\n    Array::set(out_paths, pos, nm)\n    Array::set(out_ranks, pos, rk)\n    k = k + 1\n  }\n  (out_paths, out_ranks)\n}\n")
}

let source_165 = () -> (String, String) {
  ("lib/@vibe/compiler/runtime/typecheck_fs.vibe",
"\nimport @vibe/compiler/cache {\n  compact_string_fingerprint,\n  normalize_persistent_cache_text,\n  persistent_dep_list_cache_path,\n  persistent_leaf_fingerprint_cache_path,\n  persistent_type_env_cache_path,\n  persistent_typing_dependency_env_reuse_eligibility_path,\n  persistent_typing_dependency_env_reuse_sidecar_path\n}\n\nimport @vibe/core {\n  array_empty\n}\n\nimport @vibe/compiler/checker {\n  check_program, check_program_type_table, check_program_with_env, detect_unbound_nonunit_returns, detect_unused_imports\n}\n\nimport @vibe/compiler/core {\n  Expr,\n  Stmt,\n  Type,\n  TypeEnv,\n  dir_of_path,\n  env_bind,\n  env_flat_bindings,\n  env_lookup_flat,\n  resolve_import_path,\n  resolve_import_path_candidates,\n  str_lt\n}\n\nimport @vibe/compiler/codegen {\n  compile_inline_wat\n}\n\nimport @vibe/compiler/loader {\n  ingest_source_text_fs, load_or_parse_module_header_fs\n}\n\nimport @vibe/graph {\n  RippleDb, plan_module_order, ripple_get_deps, ripple_get_fingerprint, ripple_get_source, ripple_record_eval\n}\n\nimport @vibe/compiler/syntax {\n  lex_with_offsets, lex_with_offsets_recovering, offset_to_line_col, parse_program_located, parse_program_recovering, token_to_string\n}\n\nimport @vibe/compiler/runtime/eval_loader {\n  contains_str\n}\n\n\n\nfn empty_stack() -> Array[String] {\n  array_empty()\n}\n\nfn empty_dep_fps() -> Array[(String, String)] {\n  array_empty()\n}\n\nfn lookup_env_cache(cache: Array[(String, TypeEnv)], path: String) -> Option[TypeEnv] {\n  let len = Array::length(cache)\n  let mut i = 0\n  let mut result = None\n  let mut done = false\n  while !done {\n    if i >= len {\n      done = true\n    } else {\n      let (p, env) = Array::get(cache, i)\n      if p == path {\n        result = Some(env)\n        done = true\n      } else {\n        i = i + 1\n      }\n    }\n  }\n  result\n}\n\nfn resolve_cached_import_path(base_dir: String, raw_path: String, cache: Array[(String, TypeEnv)]) -> String {\n  let candidates = resolve_import_path_candidates(base_dir, raw_path)\n  let mut selected = \"\"\n  let mut i = 0\n  while i < Array::length(candidates) && selected == \"\" {\n    let candidate = Array::get(candidates, i)\n    match lookup_env_cache(cache, candidate) {\n      Some(_) => {\n        selected = candidate\n      },\n      None => ()\n    }\n    i = i + 1\n  }\n  if selected == \"\" {\n    resolve_import_path(base_dir, raw_path)\n  } else {\n    selected\n  }\n}\n\nfn starts_with_upper(name: String) -> Bool {\n  if String::length(name) == 0 {\n    false\n  } else {\n    let c = String::char_code_at(name, 0)\n    c >= 65 && c <= 90\n  }\n}\n\nfn type_returns_name(ty: Type, type_name: String) -> Bool {\n  match ty {\n    CtEnum(name) => name == type_name,\n    CtNamed(name, _) => name == type_name,\n    CtFn(_, ret, _) => type_returns_name(ret, type_name),\n    CtForAll(_, _, body) => type_returns_name(body, type_name),\n    _ => false\n  }\n}\n\nfn bind_enum_constructor_companions(acc: TypeEnv, dep_bindings: Array[(String, Type)], enum_name: String) -> TypeEnv {\n  let qual_prefix = String::concat(enum_name, \"::\")\n  let mut out = acc\n  let mut i = 0\n  while i < Array::length(dep_bindings) {\n    let (candidate_name, candidate_ty) = Array::get(dep_bindings, i)\n    if candidate_name != enum_name && starts_with_upper(candidate_name) && (type_returns_name(candidate_ty, enum_name) || String::starts_with(candidate_name, qual_prefix)) {\n      out = env_bind(out, candidate_name, candidate_ty)\n    }\n    i = i + 1\n  }\n  out\n}\n\nfn bind_import_names_from_cache(acc: TypeEnv, resolved: String, names: Array[(String, Option[String])], cache: Array[(String, TypeEnv)]) -> TypeEnv {\n  let dep_env = match lookup_env_cache(cache, resolved) {\n    Some(e) => e,\n    None => EnvEmpty\n  }\n  let dep_bindings = env_flat_bindings(dep_env)\n  let nlen = Array::length(names)\n  let rec bind_names: (Int, TypeEnv) -> TypeEnv = (j, nacc) -> {\n    if j >= nlen {\n      nacc\n    } else {\n      let (name, alias) = Array::get(names, j)\n      let bound_name = match alias {\n        Some(a) => a,\n        None => name\n      }\n      let ty = match env_lookup_flat(dep_bindings, name) {\n        Some(t) => t,\n        None => CtUnknown\n      }\n      let with_name = env_bind(nacc, bound_name, ty)\n      let with_companions = match ty {\n        CtEnum(enum_name) => bind_enum_constructor_companions(with_name, dep_bindings, enum_name),\n        _ => if starts_with_upper(name) {\n          bind_enum_constructor_companions(with_name, dep_bindings, name)\n        } else {\n          with_name\n        }\n      }\n      bind_names(j + 1, with_companions)\n    }\n  }\n  bind_names(0, acc)\n}\n\nfn build_import_env(stmts: Array[Stmt], base_dir: String, cache: Array[(String, TypeEnv)]) -> TypeEnv {\n  let len = Array::length(stmts)\n  let rec go: (Int, TypeEnv) -> TypeEnv = (i, acc) -> {\n    if i >= len {\n      acc\n    } else {\n      let next = match Array::get(stmts, i) {\n        SImport(raw_path, names) => {\n          let resolved = resolve_cached_import_path(base_dir, raw_path, cache)\n          bind_import_names_from_cache(acc, resolved, names, cache)\n        },\n        SReExport(raw_path, names) => {\n          let resolved = resolve_cached_import_path(base_dir, raw_path, cache)\n          bind_import_names_from_cache(acc, resolved, names, cache)\n        },\n        _ => acc\n      }\n      go(i + 1, next)\n    }\n  }\n  go(0, EnvEmpty)\n}\n\nfn upsert_env_cache(cache: Array[(String, TypeEnv)], path: String, env: TypeEnv) -> Array[(String, TypeEnv)] {\n  let len = Array::length(cache)\n  let mut i = 0\n  let mut found = false\n  while i < len && !found {\n    let (p, _) = Array::get(cache, i)\n    if p == path {\n      Array::set(cache, i, (path, env))\n      found = true\n    } else {\n      i = i + 1\n    }\n  }\n  if !found {\n    Array::push(cache, (path, env))\n  }\n  cache\n}\n\nfn ensure_env_cache_for_path(rdb: RippleDb, env_cache: Array[(String, TypeEnv)], path: String) -> Array[(String, TypeEnv)] with { Error, Fs } {\n  match lookup_env_cache(env_cache, path) {\n    Some(_) => env_cache,\n    None =>\n    match ripple_get_fingerprint(rdb, path) {\n      Some(fingerprint) =>\n      match load_persistent_type_env(fingerprint) {\n        Some(cached_env) => upsert_env_cache(env_cache, path, cached_env),\n        None => env_cache\n      },\n      None => env_cache\n    }\n  }\n}\n\nfn ensure_env_cache_for_paths(rdb: RippleDb, env_cache: Array[(String, TypeEnv)], paths: Array[String]) -> Array[(String, TypeEnv)] with { Error, Fs } {\n  let mut cache = env_cache\n  let mut i = 0\n  while i < Array::length(paths) {\n    cache = ensure_env_cache_for_path(rdb, cache, Array::get(paths, i))\n    i = i + 1\n  }\n  cache\n}\n\nfn build_fingerprint(source: String, dep_fps: Array[(String, String)]) -> String {\n  let mut acc = compact_string_fingerprint(source)\n  let mut i = 0\n  while i < Array::length(dep_fps) {\n    let dep_pair = Array::get(dep_fps, i)\n    let dep_path = dep_pair.0\n    let dep_fp = dep_pair.1\n    let next = String::concat(acc, String::concat(\"|\", String::concat(dep_path, String::concat(\"=\", dep_fp))))\n    acc = compact_string_fingerprint(next)\n    i = i + 1\n  }\n  acc\n}\n\nfn copy_string_array(items: Array[String]) -> Array[String] {\n  let out = empty_stack()\n  let mut i = 0\n  let len = Array::length(items)\n  while i < len {\n    Array::push(out, Array::get(items, i))\n    i = i + 1\n  }\n  out\n}\n\nfn copy_string_pairs(pairs: Array[(String, String)]) -> Array[(String, String)] {\n  let out = empty_dep_fps()\n  let mut i = 0\n  let len = Array::length(pairs)\n  while i < len {\n    Array::push(out, Array::get(pairs, i))\n    i = i + 1\n  }\n  out\n}\n\nfn lookup_string_pair(pairs: Array[(String, String)], key: String) -> Option[String] {\n  let len = Array::length(pairs)\n  let mut i = 0\n  let mut result = None\n  let mut done = false\n  while !done {\n    if i >= len {\n      done = true\n    } else {\n      let (k, v) = Array::get(pairs, i)\n      if k == key {\n        result = Some(v)\n        done = true\n      } else {\n        i = i + 1\n      }\n    }\n  }\n  result\n}\n\nfn upsert_string_pair(pairs: Array[(String, String)], key: String, value: String) -> Array[(String, String)] {\n  let len = Array::length(pairs)\n  let mut i = 0\n  let mut found = false\n  while i < len && !found {\n    let (k, _) = Array::get(pairs, i)\n    if k == key {\n      Array::set(pairs, i, (key, value))\n      found = true\n    } else {\n      i = i + 1\n    }\n  }\n  if !found {\n    Array::push(pairs, (key, value))\n  }\n  pairs\n}\n\nlet dep_order_seed_cell = array_empty()\n\nexport fn set_dep_order_seed(seed: Int) -> Unit {\n  Array::truncate(dep_order_seed_cell, 0)\n  Array::push(dep_order_seed_cell, seed)\n}\n\nfn dep_order_seed() -> Int {\n  if Array::length(dep_order_seed_cell) > 0 {\n    Array::get(dep_order_seed_cell, 0)\n  } else {\n    0\n  }\n}\n\nlet scheduler_trace_cell = array_empty()\n\nexport fn set_scheduler_trace_path(path: String) -> Unit {\n  Array::truncate(scheduler_trace_cell, 0)\n  Array::push(scheduler_trace_cell, path)\n}\n\nfn scheduler_trace_path() -> String {\n  if Array::length(scheduler_trace_cell) > 0 {\n    Array::get(scheduler_trace_cell, 0)\n  } else {\n    \"\"\n  }\n}\n\nlet collect_diagnostics_cell = array_empty()\n\nexport fn set_collect_module_diagnostics(on: Bool) -> Unit {\n  Array::truncate(collect_diagnostics_cell, 0)\n  Array::push(collect_diagnostics_cell, on)\n}\n\nfn collect_module_diagnostics() -> Bool {\n  if Array::length(collect_diagnostics_cell) > 0 {\n    Array::get(collect_diagnostics_cell, 0)\n  } else {\n    false\n  }\n}\n\nlet incremental_typecheck_telemetry_enabled_cell = array_empty()\n\nlet incremental_typecheck_telemetry_counters = array_empty()\n\nlet incremental_typecheck_telemetry_decisions: Array[(String, String)] = [\n]\n\nlet incremental_interface_trace_enabled_cell = array_empty()\nlet incremental_interface_trace_observations: Array[(String, String)] = [\n]\nlet incremental_checked_env_trace_observations: Array[(String, String)] = [\n]\n\nlet experimental_typing_dependency_env_reuse_enabled_cell = array_empty()\n\nexport fn set_experimental_typing_dependency_env_reuse_enabled(enabled: Bool) -> Unit {\n  Array::truncate(experimental_typing_dependency_env_reuse_enabled_cell, 0)\n  Array::push(experimental_typing_dependency_env_reuse_enabled_cell, enabled)\n}\n\nfn experimental_typing_dependency_env_reuse_enabled() -> Bool {\n  if Array::length(experimental_typing_dependency_env_reuse_enabled_cell) > 0 {\n    Array::get(experimental_typing_dependency_env_reuse_enabled_cell, 0)\n  } else {\n    false\n  }\n}\n\nfn incremental_typecheck_telemetry_enabled() -> Bool {\n  if Array::length(incremental_typecheck_telemetry_enabled_cell) > 0 {\n    Array::get(incremental_typecheck_telemetry_enabled_cell, 0)\n  } else {\n    false\n  }\n}\n\nexport fn set_incremental_typecheck_telemetry_enabled(enabled: Bool) -> Unit {\n  Array::truncate(incremental_typecheck_telemetry_enabled_cell, 0)\n  Array::push(incremental_typecheck_telemetry_enabled_cell, enabled)\n  Array::truncate(incremental_typecheck_telemetry_counters, 0)\n  Array::truncate(incremental_typecheck_telemetry_decisions, 0)\n  let mut i = 0\n  while i < 5 {\n    Array::push(incremental_typecheck_telemetry_counters, 0)\n    i = i + 1\n  }\n}\n\nexport fn set_incremental_interface_trace_enabled(enabled: Bool) -> Unit {\n  Array::truncate(incremental_interface_trace_enabled_cell, 0)\n  Array::push(incremental_interface_trace_enabled_cell, enabled)\n  Array::truncate(incremental_interface_trace_observations, 0)\n  Array::truncate(incremental_checked_env_trace_observations, 0)\n}\n\nfn incremental_interface_trace_enabled() -> Bool {\n  if Array::length(incremental_interface_trace_enabled_cell) > 0 {\n    Array::get(incremental_interface_trace_enabled_cell, 0)\n  } else {\n    false\n  }\n}\n\nfn incremental_typecheck_telemetry_add(index: Int, amount: Int) -> Unit {\n  if incremental_typecheck_telemetry_enabled() {\n    Array::set(incremental_typecheck_telemetry_counters, index, Array::get(incremental_typecheck_telemetry_counters, index) + amount)\n  } else {\n    ()\n  }\n}\n\nfn incremental_typecheck_telemetry_decide(path: String, decision: String) -> Unit {\n  if incremental_typecheck_telemetry_enabled() {\n    Array::push(incremental_typecheck_telemetry_decisions, (path, decision))\n  } else {\n    ()\n  }\n}\n\nfn incremental_interface_trace_observe(path: String, interface_identity: String, checked_env_identity: String) -> Unit {\n  if incremental_interface_trace_enabled() {\n    upsert_string_pair(incremental_interface_trace_observations, path, interface_identity)\n    upsert_string_pair(incremental_checked_env_trace_observations, path, checked_env_identity)\n    ()\n  } else {\n    ()\n  }\n}\n\nfn incremental_interface_trace_observation_of(path: String) -> Option[String] {\n  lookup_string_pair(incremental_interface_trace_observations, path)\n}\n\nfn incremental_checked_env_trace_observation_of(path: String) -> Option[String] {\n  lookup_string_pair(incremental_checked_env_trace_observations, path)\n}\n\nfn incremental_typecheck_telemetry_decision_of(path: String) -> Option[String] {\n  let mut i = 0\n  let mut result = None\n  while i < Array::length(incremental_typecheck_telemetry_decisions) {\n    let (candidate, decision) = Array::get(incremental_typecheck_telemetry_decisions, i)\n    if candidate == path {\n      result = Some(decision)\n      i = Array::length(incremental_typecheck_telemetry_decisions)\n    } else {\n      i = i + 1\n    }\n  }\n  result\n}\n\nfn incremental_typecheck_telemetry_counter(index: Int) -> Int {\n  if incremental_typecheck_telemetry_enabled() {\n    Array::get(incremental_typecheck_telemetry_counters, index)\n  } else {\n    0\n  }\n}\n\nexport fn incremental_typecheck_telemetry_json() -> String {\n  let out = StringBuilder::new()\n  StringBuilder::push(out, \"{\\\"schema\\\":1,\\\"modules_planned\\\":\")\n  StringBuilder::push(out, __to_string(incremental_typecheck_telemetry_counter(0)))\n  StringBuilder::push(out, \",\\\"modules_rechecked\\\":\")\n  StringBuilder::push(out, __to_string(incremental_typecheck_telemetry_counter(1)))\n  StringBuilder::push(out, \",\\\"modules_reused\\\":\")\n  StringBuilder::push(out, __to_string(incremental_typecheck_telemetry_counter(2)))\n  StringBuilder::push(out, \",\\\"parse_operations\\\":\")\n  StringBuilder::push(out, __to_string(incremental_typecheck_telemetry_counter(3)))\n  StringBuilder::push(out, \",\\\"modules_failed_or_blocked\\\":\")\n  StringBuilder::push(out, __to_string(incremental_typecheck_telemetry_counter(4)))\n  StringBuilder::push(out, \"}\")\n  StringBuilder::freeze(out)\n}\n\nfn interface_segment(text: String) -> String {\n  String::concat(__to_string(String::length(text)), String::concat(\":\", text))\n}\n\nfn interface_sorted_unique(items: Array[String]) -> Array[String] {\n  let out = Array::slice(items, 0, Array::length(items))\n  let mut i = 1\n  while i < Array::length(out) {\n    let key = Array::get(out, i)\n    let mut j = i\n    while j > 0 && str_lt(key, Array::get(out, j - 1)) {\n      Array::set(out, j, Array::get(out, j - 1))\n      j = j - 1\n    }\n    Array::set(out, j, key)\n    i = i + 1\n  }\n  let unique = array_empty()\n  let mut k = 0\n  while k < Array::length(out) {\n    if k == 0 || Array::get(out, k) != Array::get(out, k - 1) {\n      Array::push(unique, Array::get(out, k))\n    } else {\n      ()\n    }\n    k = k + 1\n  }\n  unique\n}\n\nfn interface_effect_set(effect_name: Option[String]) -> String {\n  match effect_name {\n    None => \"[]\",\n    Some(raw) => {\n      let labels = array_empty()\n      let pieces = String::split(raw, \",\")\n      let mut i = 0\n      while i < Array::length(pieces) {\n        let label = String::trim(Array::get(pieces, i))\n        if String::length(label) > 0 {\n          Array::push(labels, label)\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      String::concat(\"[\", String::concat(String::join(interface_sorted_unique(labels), \",\"), \"]\"))\n    }\n  }\n}\n\nfn interface_lookup_var(ids: Array[Int], names: Array[String], id: Int) -> String {\n  let mut i = 0\n  let mut result = String::concat(\"free\", __to_string(id))\n  let mut found = false\n  while i < Array::length(ids) && !found {\n    if Array::get(ids, i) == id {\n      result = Array::get(names, i)\n      found = true\n    } else {\n      i = i + 1\n    }\n  }\n  result\n}\n\nfn interface_canonical_type(ty: Type, ids: Array[Int], names: Array[String]) -> String {\n  let rec types: (Array[Type], Array[Int], Array[String]) -> String = (items, vars, labels) -> {\n    let out = StringBuilder::new()\n    StringBuilder::push(out, \"[\")\n    let mut i = 0\n    while i < Array::length(items) {\n      StringBuilder::push(out, interface_segment(interface_canonical_type(Array::get(items, i), vars, labels)))\n      i = i + 1\n    }\n    StringBuilder::push(out, \"]\")\n    StringBuilder::freeze(out)\n  }\n  match ty {\n    CtInt => \"int\",\n    CtDouble => \"double\",\n    CtBool => \"bool\",\n    CtString => \"string\",\n    CtChar => \"char\",\n    CtUnit => \"unit\",\n    CtBytes => \"bytes\",\n    CtUnknown => \"unknown\",\n    CtVar(id) => String::concat(\"var:\", interface_lookup_var(ids, names, id)),\n    CtEnum(name) => String::concat(\"enum:\", interface_segment(name)),\n    CtStruct(name) => String::concat(\"struct:\", interface_segment(name)),\n    CtArray(elem) => String::concat(\"array:\", interface_segment(interface_canonical_type(elem, ids, names))),\n    CtOption(elem) => String::concat(\"option:\", interface_segment(interface_canonical_type(elem, ids, names))),\n    CtTuple(items) => String::concat(\"tuple:\", types(items, ids, names)),\n    CtNamed(name, args) => String::concat(\"named:\", String::concat(interface_segment(name), types(args, ids, names))),\n    CtFn(params, ret, effects) => String::concat(\"fn:\", String::concat(types(params, ids, names), String::concat(interface_segment(interface_canonical_type(ret, ids, names)), interface_effect_set(effects)))),\n    CtForAll(vars, bounds, body) => {\n      let all_ids = Array::slice(ids, 0, Array::length(ids))\n      let all_names = Array::slice(names, 0, Array::length(names))\n      let mut i = 0\n      while i < Array::length(vars) {\n        Array::push(all_ids, Array::get(vars, i))\n        Array::push(all_names, String::concat(\"q\", __to_string(Array::length(all_names))))\n        i = i + 1\n      }\n      let bound_rows = array_empty()\n      let mut b = 0\n      while b < Array::length(vars) {\n        let id = Array::get(vars, b)\n        let labels = array_empty()\n        let mut j = 0\n        while j < Array::length(bounds) {\n          let (bound_id, raw_labels) = Array::get(bounds, j)\n          if bound_id == id {\n            let mut k = 0\n            while k < Array::length(raw_labels) {\n              Array::push(labels, Array::get(raw_labels, k))\n              k = k + 1\n            }\n          } else {\n            ()\n          }\n          j = j + 1\n        }\n        Array::push(bound_rows, String::concat(interface_lookup_var(all_ids, all_names, id), String::concat(\"=\", String::join(interface_sorted_unique(labels), \",\"))))\n        b = b + 1\n      }\n      String::concat(\"forall:\", String::concat(\"[\", String::concat(String::join(bound_rows, \";\"), String::concat(\"]\", interface_segment(interface_canonical_type(body, all_ids, all_names))))))\n    }\n  }\n}\n\nfn interface_lookup_type_param(params: Array[String], name: String) -> String {\n  let mut i = 0\n  let mut result = name\n  let mut found = false\n  while i < Array::length(params) && !found {\n    if Array::get(params, i) == name {\n      result = String::concat(\"p\", __to_string(i))\n      found = true\n    } else {\n      i = i + 1\n    }\n  }\n  result\n}\n\nfn interface_canonical_type_expr(ty: TypeExpr, params: Array[String]) -> String {\n  let rec exprs: (Array[TypeExpr], Array[String]) -> String = (items, type_params) -> {\n    let out = StringBuilder::new()\n    StringBuilder::push(out, \"[\")\n    let mut i = 0\n    while i < Array::length(items) {\n      StringBuilder::push(out, interface_segment(interface_canonical_type_expr(Array::get(items, i), type_params)))\n      i = i + 1\n    }\n    StringBuilder::push(out, \"]\")\n    StringBuilder::freeze(out)\n  }\n  match ty {\n    TyName(name) => String::concat(\"name:\", interface_segment(interface_lookup_type_param(params, name))),\n    TyApp(name, args) => String::concat(\"app:\", String::concat(interface_segment(interface_lookup_type_param(params, name)), exprs(args, params))),\n    TyFn(args, ret, effects) => String::concat(\"fn:\", String::concat(exprs(args, params), String::concat(interface_segment(interface_canonical_type_expr(ret, params)), interface_effect_set(effects)))),\n    TyTuple(items) => String::concat(\"tuple:\", exprs(items, params)),\n    TyUnit => \"unit\"\n  }\n}\n\nfn interface_public_value_names(stmts: Array[Stmt]) -> Array[String] {\n  let names = array_empty()\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SLet(exported, _, name, _, _) => if exported {\n        Array::push(names, name)\n      } else {\n        ()\n      },\n      SFnDecl(exported, name, _, _, _) => if exported {\n        Array::push(names, name)\n      } else {\n        ()\n      },\n      SExport(exported_names) => {\n        let mut j = 0\n        while j < Array::length(exported_names) {\n          Array::push(names, Array::get(exported_names, j))\n          j = j + 1\n        }\n      },\n      SReExport(_, reexports) => {\n        let mut j = 0\n        while j < Array::length(reexports) {\n          let (name, alias) = Array::get(reexports, j)\n          Array::push(names, match alias {\n            Some(value) => value,\n            None => name\n          })\n          j = j + 1\n        }\n      },\n      _ => ()\n    }\n    i = i + 1\n  }\n  interface_sorted_unique(names)\n}\n\nfn interface_decl_line(prefix: String, name: String, body: String) -> String {\n  let out = StringBuilder::new()\n  StringBuilder::push(out, prefix)\n  StringBuilder::push(out, interface_segment(name))\n  StringBuilder::push(out, body)\n  StringBuilder::freeze(out)\n}\n\nfn interface_bracketed(items: Array[String], separator: String) -> String {\n  let out = StringBuilder::new()\n  StringBuilder::push(out, \"[\")\n  StringBuilder::push(out, String::join(items, separator))\n  StringBuilder::push(out, \"]\")\n  StringBuilder::freeze(out)\n}\n\nfn interface_public_decl_lines(stmts: Array[Stmt]) -> Array[String] {\n  let lines = array_empty()\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SEnum(exported, name, params, variants, derives) => if exported {\n        let vs = array_empty()\n        let mut j = 0\n        while j < Array::length(variants) {\n          let (vname, fields) = Array::get(variants, j)\n          let fs = array_empty()\n          let mut k = 0\n          while k < Array::length(fields) {\n            Array::push(fs, interface_canonical_type_expr(Array::get(fields, k), params))\n            k = k + 1\n          }\n          Array::push(vs, String::concat(interface_segment(vname), String::concat(\"[\", String::concat(String::join(fs, \";\"), \"]\"))))\n          j = j + 1\n        }\n        let enum_body = StringBuilder::new()\n        StringBuilder::push(enum_body, interface_bracketed(vs, \";\"))\n        StringBuilder::push(enum_body, \"derive\")\n        StringBuilder::push(enum_body, interface_bracketed(interface_sorted_unique(derives), \",\"))\n        Array::push(lines, interface_decl_line(\"enum:\", name, StringBuilder::freeze(enum_body)))\n      } else {\n        ()\n      },\n      SSuberror(exported, name, variants) => if exported {\n        let vs = array_empty()\n        let mut j = 0\n        while j < Array::length(variants) {\n          let (vname, fields) = Array::get(variants, j)\n          let fs = array_empty()\n          let mut k = 0\n          while k < Array::length(fields) {\n            Array::push(fs, interface_canonical_type_expr(Array::get(fields, k), array_empty()))\n            k = k + 1\n          }\n          Array::push(vs, String::concat(interface_segment(vname), String::concat(\"[\", String::concat(String::join(fs, \";\"), \"]\"))))\n          j = j + 1\n        }\n        Array::push(lines, interface_decl_line(\"suberror:\", name, interface_bracketed(vs, \";\")))\n      } else {\n        ()\n      },\n      SStruct(exported, name, fields, derives, mut_fields, params) => if exported {\n        let fs = array_empty()\n        let mut j = 0\n        while j < Array::length(fields) {\n          let (fname, ftype) = Array::get(fields, j)\n          let field_mutability = if contains_str(mut_fields, fname) {\n            \"mut\"\n          } else {\n            \"imm\"\n          }\n          Array::push(fs, String::concat(interface_segment(fname), String::concat(\":\", String::concat(field_mutability, String::concat(\":\", interface_canonical_type_expr(ftype, params))))))\n          j = j + 1\n        }\n        let struct_body = StringBuilder::new()\n        StringBuilder::push(struct_body, interface_bracketed(fs, \";\"))\n        StringBuilder::push(struct_body, \"derive\")\n        StringBuilder::push(struct_body, interface_bracketed(interface_sorted_unique(derives), \",\"))\n        Array::push(lines, interface_decl_line(\"struct:\", name, StringBuilder::freeze(struct_body)))\n      } else {\n        ()\n      },\n      STypeAlias(exported, name, params, body) => if exported {\n        Array::push(lines, String::concat(\"alias:\", String::concat(interface_segment(name), interface_canonical_type_expr(body, params))))\n      } else {\n        ()\n      },\n      STrait(exported, name, supers, methods, method_gens, _) => if exported {\n        let ms = array_empty()\n        let mut j = 0\n        while j < Array::length(methods) {\n          let (mname, args, ret) = Array::get(methods, j)\n          let type_params = array_empty()\n          let generic_bounds: Array[(String, Array[String])] = [\n          ]\n          let mut g = 0\n          while g < Array::length(method_gens) {\n            let (generic_method, params, bounds) = Array::get(method_gens, g)\n            if generic_method == mname {\n              let mut p = 0\n              while p < Array::length(params) {\n                Array::push(type_params, Array::get(params, p))\n                p = p + 1\n              }\n              let mut b = 0\n              while b < Array::length(bounds) {\n                Array::push(generic_bounds, Array::get(bounds, b))\n                b = b + 1\n              }\n            } else {\n              ()\n            }\n            g = g + 1\n          }\n          let bound_rows = array_empty()\n          let mut p = 0\n          while p < Array::length(type_params) {\n            let param_name = Array::get(type_params, p)\n            let labels = array_empty()\n            let mut b = 0\n            while b < Array::length(generic_bounds) {\n              let (bound_name, bound_labels) = Array::get(generic_bounds, b)\n              if bound_name == param_name {\n                let mut q = 0\n                while q < Array::length(bound_labels) {\n                  Array::push(labels, Array::get(bound_labels, q))\n                  q = q + 1\n                }\n              } else {\n                ()\n              }\n              b = b + 1\n            }\n            Array::push(bound_rows, String::concat(String::concat(\"p\", __to_string(p)), String::concat(\"=\", String::join(interface_sorted_unique(labels), \",\"))))\n            p = p + 1\n          }\n          let arg_lines = array_empty()\n          let mut k = 0\n          while k < Array::length(args) {\n            Array::push(arg_lines, interface_canonical_type_expr(Array::get(args, k), type_params))\n            k = k + 1\n          }\n          let method_body = StringBuilder::new()\n          StringBuilder::push(method_body, \"gens\")\n          StringBuilder::push(method_body, interface_bracketed(bound_rows, \";\"))\n          StringBuilder::push(method_body, \"args\")\n          StringBuilder::push(method_body, interface_bracketed(arg_lines, \";\"))\n          StringBuilder::push(method_body, \"ret\")\n          StringBuilder::push(method_body, interface_segment(interface_canonical_type_expr(ret, type_params)))\n          Array::push(ms, String::concat(interface_segment(mname), StringBuilder::freeze(method_body)))\n          j = j + 1\n        }\n        let trait_body = StringBuilder::new()\n        StringBuilder::push(trait_body, \"super\")\n        StringBuilder::push(trait_body, interface_bracketed(interface_sorted_unique(supers), \",\"))\n        StringBuilder::push(trait_body, \"methods\")\n        StringBuilder::push(trait_body, interface_bracketed(ms, \";\"))\n        Array::push(lines, interface_decl_line(\"trait:\", name, StringBuilder::freeze(trait_body)))\n      } else {\n        ()\n      },\n      SEffectDef(exported, name, params, ops) => if exported {\n        let os = array_empty()\n        let mut j = 0\n        while j < Array::length(ops) {\n          let (opname, args, ret) = Array::get(ops, j)\n          let arg_lines = array_empty()\n          let mut k = 0\n          while k < Array::length(args) {\n            Array::push(arg_lines, interface_canonical_type_expr(Array::get(args, k), params))\n            k = k + 1\n          }\n          Array::push(os, String::concat(interface_segment(opname), String::concat(\"[\", String::concat(String::join(arg_lines, \";\"), String::concat(\"]\", interface_canonical_type_expr(ret, params))))))\n          j = j + 1\n        }\n        Array::push(lines, interface_decl_line(\"effect:\", name, interface_bracketed(os, \";\")))\n      } else {\n        ()\n      },\n      SEffectSet(exported, name, members) => if exported {\n        Array::push(lines, interface_decl_line(\"effectset:\", name, interface_bracketed(interface_sorted_unique(members), \",\")))\n      } else {\n        ()\n      },\n      _ => ()\n    }\n    i = i + 1\n  }\n  interface_sorted_unique(lines)\n}\n\nfn incremental_implementation_identity(source: String) -> String with { Error } {\n  let (tokens, starts, ends) = lex_with_offsets(source)\n  let _ = parse_program_located(tokens, starts, source)\n  let out = StringBuilder::new()\n  StringBuilder::push(out, \"vibe-module-token-stream:v1\\n\")\n  let mut i = 0\n  while i < Array::length(tokens) {\n    StringBuilder::push(out, interface_segment(token_to_string(Array::get(tokens, i))))\n    let start = Array::get(starts, i)\n    let end = Array::get(ends, i)\n    StringBuilder::push(out, interface_segment(source[start: end]))\n    i = i + 1\n  }\n  compact_string_fingerprint(StringBuilder::freeze(out))\n}\n\nfn incremental_interface_identity(source: String, env: TypeEnv) -> String with { Error } {\n  let stmts = parse_program_with_path(\"<incremental-interface-observation>\", source)\n  let out = StringBuilder::new()\n  StringBuilder::push(out, \"vibe-module-interface:v1\\n\")\n  let names = interface_public_value_names(stmts)\n  let mut i = 0\n  while i < Array::length(names) {\n    let name = Array::get(names, i)\n    match env_lookup_flat(env_flat_bindings(env), name) {\n      Some(ty) => StringBuilder::push(out, String::concat(\"value:\", String::concat(interface_segment(name), String::concat(\":\", interface_canonical_type(ty, array_empty(), array_empty()))))),\n      None => throw(String::concat(\"incremental interface observation: exported name missing from checked environment: \", name))\n    }\n    StringBuilder::push(out, \"\\n\")\n    i = i + 1\n  }\n  let decls = interface_public_decl_lines(stmts)\n  let mut d = 0\n  while d < Array::length(decls) {\n    StringBuilder::push(out, Array::get(decls, d))\n    StringBuilder::push(out, \"\\n\")\n    d = d + 1\n  }\n  compact_string_fingerprint(StringBuilder::freeze(out))\n}\n\nfn incremental_checked_env_identity(env: TypeEnv) -> String with { Error } {\n  let bindings = env_flat_bindings(env)\n  let raw_names = array_empty()\n  let mut b = 0\n  while b < Array::length(bindings) {\n    let (name, _) = Array::get(bindings, b)\n    if !String::starts_with(name, \"__fn_ret__:\") {\n      Array::push(raw_names, name)\n    } else {\n      ()\n    }\n    b = b + 1\n  }\n  let names = interface_sorted_unique(raw_names)\n  let out = StringBuilder::new()\n  StringBuilder::push(out, \"vibe-module-checked-env:v1\\n\")\n  let mut i = 0\n  while i < Array::length(names) {\n    let name = Array::get(names, i)\n    match env_lookup_flat(bindings, name) {\n      Some(ty) => {\n        StringBuilder::push(out, \"value:\")\n        StringBuilder::push(out, interface_segment(name))\n        StringBuilder::push(out, interface_segment(interface_canonical_type(ty, array_empty(), array_empty())))\n        StringBuilder::push(out, \"\\n\")\n      },\n      None => throw(String::concat(\"incremental checked environment observation: effective value missing from flattened environment: \", name))\n    }\n    i = i + 1\n  }\n  compact_string_fingerprint(StringBuilder::freeze(out))\n}\n\nfn incremental_trace_observe_checked_env(path: String, source: String, env: TypeEnv) -> Unit with { Error } {\n  incremental_interface_trace_observe(path, incremental_interface_identity(source, env), incremental_checked_env_identity(env))\n}\n\nfn incremental_trace_hex_digit(value: Int) -> String {\n  if value < 10 {\n    String::from_char_code('0' + value)\n  } else {\n    String::from_char_code('a' + value - 10)\n  }\n}\n\nfn incremental_trace_json_string(text: String) -> String {\n  let out = StringBuilder::new()\n  StringBuilder::push(out, \"\\\"\")\n  let mut i = 0\n  while i < String::length(text) {\n    let c = String::char_code_at(text, i)\n    if c == '\"' {\n      StringBuilder::push(out, \"\\\\\\\"\")\n    } else if c == '\\\\' {\n      StringBuilder::push(out, \"\\\\\\\\\")\n    } else if c == '\\n' {\n      StringBuilder::push(out, \"\\\\n\")\n    } else if c == '\\r' {\n      StringBuilder::push(out, \"\\\\r\")\n    } else if c == '\\t' {\n      StringBuilder::push(out, \"\\\\t\")\n    } else if c < 32 {\n      StringBuilder::push(out, \"\\\\u00\")\n      StringBuilder::push(out, incremental_trace_hex_digit(c / 16))\n      StringBuilder::push(out, incremental_trace_hex_digit(c % 16))\n    } else {\n      StringBuilder::push(out, String::from_char_code(c))\n    }\n    i = i + 1\n  }\n  StringBuilder::push(out, \"\\\"\")\n  StringBuilder::freeze(out)\n}\nexport fn incremental_invalidation_trace_json(entry_path: String, run_nonce: String) -> String with { Error, Fs } {\n  if String::length(run_nonce) == 0 {\n    throw(\"incremental invalidation trace requires a non-empty run nonce\")\n  } else {\n    ()\n  }\n  let (paths, _ranks, deps_by_module, sources) = module_plan_data_fs(entry_path)\n  let out = StringBuilder::new()\n  StringBuilder::push(out, \"{\\\"schema\\\":4,\\\"run_nonce\\\":\")\n  StringBuilder::push(out, incremental_trace_json_string(run_nonce))\n  StringBuilder::push(out, \",\\\"fingerprint_note\\\":\\\"source_fingerprint is ingestion telemetry; implementation_fingerprint remains the provisional canonical token-stream identity; interface_fingerprint and checked_env_fingerprint are observation only; none is a production cache key\\\",\\\"modules\\\":[\")\n  let mut i = 0\n  while i < Array::length(paths) {\n    if i > 0 {\n      StringBuilder::push(out, \",\")\n    } else {\n      ()\n    }\n    let path = Array::get(paths, i)\n    let decision = match incremental_typecheck_telemetry_decision_of(path) {\n      Some(value) => value,\n      None => throw(String::concat(\"incremental invalidation trace: missing decision for \", path))\n    }\n    StringBuilder::push(out, \"{\\\"path\\\":\")\n    StringBuilder::push(out, incremental_trace_json_string(path))\n    StringBuilder::push(out, \",\\\"direct_dependencies\\\":[\")\n    let deps = Array::get(deps_by_module, i)\n    let mut d = 0\n    while d < Array::length(deps) {\n      if d > 0 {\n        StringBuilder::push(out, \",\")\n      } else {\n        ()\n      }\n      StringBuilder::push(out, incremental_trace_json_string(Array::get(deps, d)))\n      d = d + 1\n    }\n    StringBuilder::push(out, \"],\\\"source_fingerprint\\\":\")\n    let source = Array::get(sources, i)\n    StringBuilder::push(out, incremental_trace_json_string(compact_string_fingerprint(source)))\n    StringBuilder::push(out, \",\\\"source_fingerprint_kind\\\":\\\"compact_string_fingerprint(ingested_source)\\\",\\\"implementation_fingerprint\\\":\")\n    StringBuilder::push(out, incremental_trace_json_string(incremental_implementation_identity(source)))\n    StringBuilder::push(out, \",\\\"implementation_fingerprint_kind\\\":\\\"compact_string_fingerprint(vibe-module-token-stream:v1 length_delimited(token_kind,source_lexeme))\\\",\\\"interface_fingerprint\\\":\")\n    let interface_fingerprint = match incremental_interface_trace_observation_of(path) {\n      Some(value) => value,\n      None => throw(String::concat(\"incremental invalidation trace: missing complete interface observation for \", path))\n    }\n    StringBuilder::push(out, incremental_trace_json_string(interface_fingerprint))\n    StringBuilder::push(out, \",\\\"interface_fingerprint_kind\\\":\\\"compact_string_fingerprint(vibe-module-interface:v1 canonical exported surface)\\\",\\\"checked_env_fingerprint\\\":\")\n    let checked_env_fingerprint = match incremental_checked_env_trace_observation_of(path) {\n      Some(value) => value,\n      None => throw(String::concat(\"incremental invalidation trace: missing complete checked environment observation for \", path))\n    }\n    StringBuilder::push(out, incremental_trace_json_string(checked_env_fingerprint))\n    StringBuilder::push(out, \",\\\"checked_env_fingerprint_kind\\\":\\\"compact_string_fingerprint(vibe-module-checked-env:v1 canonical effective TypeEnv value bindings)\\\",\\\"decision\\\":\")\n    StringBuilder::push(out, incremental_trace_json_string(decision))\n    StringBuilder::push(out, \"}\")\n    i = i + 1\n  }\n  StringBuilder::push(out, \"],\\\"aggregate_telemetry\\\":\")\n  StringBuilder::push(out, incremental_typecheck_telemetry_json())\n  StringBuilder::push(out, \"}\")\n  StringBuilder::freeze(out)\n}\nfn dep_visit_order(n: Int) -> Array[Int] {\n  let order = array_empty()\n  let mut i = 0\n  while i < n {\n    Array::push(order, i)\n    i = i + 1\n  }\n  let seed = dep_order_seed()\n  if seed == 0 || n < 2 {\n    order\n  } else {\n    let mut state = seed\n    let mut j = n - 1\n    while j > 0 {\n      state = (state * 1664525 + 1013904223)&2147483647\n      let k = state % (j + 1)\n      let tmp = Array::get(order, j)\n      Array::set(order, j, Array::get(order, k))\n      Array::set(order, k, tmp)\n      j = j - 1\n    }\n    order\n  }\n}\nlet parse_memo_paths: Array[String] = [\n] let parse_memo_sources: Array[String] = [\n] let parse_memo_stmts: Array[Array[Stmt]] = [\n] export fn parse_program_with_path(path: String, source: String) -> Array[Stmt] with { Error } {\n  let n = Array::length(parse_memo_paths)\n  let mut i = 0\n  let mut hit = -1\n  while i < n && hit < 0 {\n    if Array::get(parse_memo_paths, i) == path && Array::get(parse_memo_sources, i) == source {\n      hit = i\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  if hit >= 0 {\n    let cached = Array::get(parse_memo_stmts, hit)\n    Array::slice(cached, 0, Array::length(cached))\n  } else {\n    let parsed = handle {\n      let (tokens, starts, _ends) = lex_with_offsets(source)\n      parse_program_located(tokens, starts, source)\n    } with Error {\n      Throw(msg) => throw(String::concat(String::concat(path, \": \"), msg))\n    }\n    if Array::length(parse_memo_paths) >= 1024 {\n      Array::truncate(parse_memo_paths, 0)\n      Array::truncate(parse_memo_sources, 0)\n      Array::truncate(parse_memo_stmts, 0)\n    } else {\n      ()\n    }\n    Array::push(parse_memo_paths, path)\n    Array::push(parse_memo_sources, source)\n    Array::push(parse_memo_stmts, parsed)\n    Array::slice(parsed, 0, Array::length(parsed))\n  }\n} fn store_persistent_type_env(fingerprint: String, env: TypeEnv) -> Unit with { Error, Fs } {\n  Fs::write_file(persistent_type_env_cache_path(fingerprint), persistent_type_env_cache_text(env))\n}\n\nlet typing_dependency_env_reuse_eligibility_v1_text = \"TDRE-ELIGIBILITY-1\"\n\nfn typing_dependency_env_reuse_eligibility_is_valid(fingerprint: String) -> Bool with { Fs } {\n  let marker_path = persistent_typing_dependency_env_reuse_eligibility_path(fingerprint)\n  if Fs::exists(marker_path) {\n    Fs::read_file(marker_path) == typing_dependency_env_reuse_eligibility_v1_text\n  } else {\n    false\n  }\n}\n\nfn stmts_have_trait_or_impl_deep(stmts: Array[Stmt]) -> Bool {\n  let mut i = 0\n  let mut found = false\n  while !found && i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      STrait(_, _, _, _, _, _) => {\n        found = true\n      },\n      SImpl(_, _, _, _) => {\n        found = true\n      },\n      SModule(_, _, inner) => if stmts_have_trait_or_impl_deep(inner) {\n        found = true\n      } else {\n        ()\n      },\n      _ => ()\n    }\n    i = i + 1\n  }\n  found\n}\n\nfn typing_dependency_env_reuse_is_eligible(path: String, source: String, dep_fps: Array[(String, String)]) -> Bool with { Error, Fs } {\n  let own_stmts = parse_program_with_path(path, source)\n  if stmts_have_trait_or_impl_deep(own_stmts) {\n    false\n  } else {\n    let mut i = 0\n    let mut deps_eligible = true\n    while deps_eligible && i < Array::length(dep_fps) {\n      let (_dep_path, dep_fingerprint) = Array::get(dep_fps, i)\n      if typing_dependency_env_reuse_eligibility_is_valid(dep_fingerprint) {\n        ()\n      } else {\n        deps_eligible = false\n      }\n      i = i + 1\n    }\n    deps_eligible\n  }\n}\n\nfn publish_typing_dependency_env_reuse_eligibility(fingerprint: String) -> Unit with { Fs } {\n  Fs::write_file(persistent_typing_dependency_env_reuse_eligibility_path(fingerprint), typing_dependency_env_reuse_eligibility_v1_text)\n}\n\nfn typing_reuse_segment(text: String) -> String {\n  String::concat(__to_string(String::length(text)), String::concat(\":\", text))\n}\n\nfn parse_typing_reuse_segment(text: String, pos: Int) -> Option[(String, Int)] {\n  let total = String::length(text)\n  let mut cursor = pos\n  let mut n = 0\n  let mut saw_digit = false\n  let mut valid = pos >= 0 && pos < total\n  while valid && cursor < total && String::char_code_at(text, cursor) != ':' {\n    let code = String::char_code_at(text, cursor)\n    if code < '0' || code > '9' || n > total / 10 {\n      valid = false\n    } else {\n      n = n * 10 + (code - '0')\n      saw_digit = true\n      cursor = cursor + 1\n    }\n  }\n  if !valid || !saw_digit || cursor >= total || String::char_code_at(text, cursor) != ':' {\n    None\n  } else {\n    let start = cursor + 1\n    let end = start + n\n    if end < start || end > total {\n      None\n    } else {\n      Some((String::substring(text, start, end), end))\n    }\n  }\n}\n\nfn typing_dependency_transport_input_key(source: String, deps: Array[String], env_cache: Array[(String, TypeEnv)]) -> Option[String] {\n  let out = StringBuilder::new()\n  StringBuilder::push(out, \"vibe-typing-dependency-transport-env:v1\")\n  StringBuilder::push(out, typing_reuse_segment(source))\n  StringBuilder::push(out, typing_reuse_segment(__to_string(Array::length(deps))))\n  let mut i = 0\n  let mut complete = true\n  while complete && i < Array::length(deps) {\n    let dep_path = Array::get(deps, i)\n    match lookup_env_cache(env_cache, dep_path) {\n      Some(dep_env) => {\n        let transport_env_fingerprint = compact_string_fingerprint(persistent_type_env_cache_text(dep_env))\n        StringBuilder::push(out, typing_reuse_segment(dep_path))\n        StringBuilder::push(out, typing_reuse_segment(transport_env_fingerprint))\n      },\n      None => {\n        complete = false\n      }\n    }\n    i = i + 1\n  }\n  if complete {\n    Some(StringBuilder::freeze(out))\n  } else {\n    None\n  }\n}\n\nfn typing_dependency_env_reuse_sidecar_text(input_key: String, target_fingerprint: String) -> String {\n  String::concat(\"TDRE1\", String::concat(typing_reuse_segment(input_key), typing_reuse_segment(target_fingerprint)))\n}\n\nfn parse_typing_dependency_env_reuse_sidecar(text: String, expected_input_key: String) -> Option[String] {\n  if !String::starts_with(text, \"TDRE1\") {\n    None\n  } else {\n    match parse_typing_reuse_segment(text, 5) {\n      Some((input_key, after_input)) =>\n      match parse_typing_reuse_segment(text, after_input) {\n        Some((target_fingerprint, end)) =>\n        if input_key == expected_input_key && end == String::length(text) && String::length(target_fingerprint) > 0 {\n          Some(target_fingerprint)\n        } else {\n          None\n        },\n        None => None\n      },\n      None => None\n    }\n  }\n}\n\nfn load_typing_dependency_env_reuse_target(input_key: String) -> Option[(String, TypeEnv)] with { Error, Fs } {\n  let sidecar_path = persistent_typing_dependency_env_reuse_sidecar_path(input_key)\n  if !Fs::exists(sidecar_path) {\n    None\n  } else {\n    match parse_typing_dependency_env_reuse_sidecar(Fs::read_file(sidecar_path), input_key) {\n      Some(target_fingerprint) =>\n      if typing_dependency_env_reuse_eligibility_is_valid(target_fingerprint) {\n        let loaded = handle {\n          load_persistent_type_env(target_fingerprint)\n        } with Error {\n          Throw(_) => None\n        }\n        match loaded {\n          Some(target_env) => Some((target_fingerprint, target_env)),\n          None => None\n        }\n      } else {\n        None\n      },\n      None => None\n    }\n  }\n}\n\nfn write_typing_dependency_env_reuse_sidecar(source: String, deps: Array[String], env_cache: Array[(String, TypeEnv)], target_fingerprint: String) -> Unit with { Fs } {\n  match typing_dependency_transport_input_key(source, deps, env_cache) {\n    Some(input_key) => Fs::write_file(persistent_typing_dependency_env_reuse_sidecar_path(input_key), typing_dependency_env_reuse_sidecar_text(input_key, target_fingerprint)),\n    None => ()\n  }\n}\n\nfn write_persistent_dep_list_if_missing(path: String, source: String, deps: Array[String]) -> Unit with { Fs } {\n  let dep_cache_path = persistent_dep_list_cache_path(path, compact_string_fingerprint(source))\n  if !(Fs::exists(dep_cache_path)) {\n    Fs::write_file(dep_cache_path, persistent_dep_list_text(deps))\n  } else {\n    ()\n  }\n}\nfn typecheck_ident_run(s: String, start: Int) -> Int {\n  let len = String::length(s)\n  let mut e = start\n  let mut go = true\n  while go && e < len {\n    let c = String::char_code_at(s, e)\n    let is_id = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_'\n    if is_id {\n      e = e + 1\n    } else {\n      go = false\n    }\n  }\n  e\n}\nfn locate_by_marker(source: String, msg: String, marker: String) -> String {\n  let mi = String::index_of(msg, marker)\n  if mi < 0 {\n    msg\n  } else {\n    let sstart = mi + String::length(marker)\n    let send = typecheck_ident_run(msg, sstart)\n    if send <= sstart {\n      msg\n    } else {\n      let sym = String::substring(msg, sstart, send)\n      let off = String::index_of(source, sym)\n      if off < 0 {\n        msg\n      } else {\n        let (line, col) = offset_to_line_col(source, off)\n        let loc = String::concat(\"line \", String::concat(__to_string(line), String::concat(\":\", String::concat(__to_string(col), \": \"))))\n        String::concat(loc, msg)\n      }\n    }\n  }\n}\nfn extract_quoted_after(msg: String, marker: String) -> String {\n  let mi = String::index_of(msg, marker)\n  if mi < 0 {\n    \"\"\n  } else {\n    let rest = String::substring(msg, mi + String::length(marker), String::length(msg))\n    let rel_end = String::index_of(rest, \"'\")\n    if rel_end < 0 {\n      \"\"\n    } else {\n      String::substring(rest, 0, rel_end)\n    }\n  }\n}\nfn index_of_after(source: String, sym: String, from: Int) -> Int {\n  if String::length(sym) == 0 {\n    0 - 1\n  } else {\n    let start = if from < 0 {\n      0\n    } else if from > String::length(source) {\n      String::length(source)\n    } else {\n      from\n    }\n    let rel = String::index_of(String::substring(source, start, String::length(source)), sym)\n    if rel < 0 {\n      0 - 1\n    } else {\n      start + rel\n    }\n  }\n}\nfn locate_unused_import_msg(source: String, msg: String) -> String {\n  let name_marker = \"imported name '\"\n  let alias_marker = \"import alias '\"\n  let is_alias = String::index_of(msg, alias_marker) >= 0\n  if not(is_alias) && String::index_of(msg, name_marker) < 0 {\n    msg\n  } else {\n    let sym = if is_alias {\n      extract_quoted_after(msg, alias_marker)\n    } else {\n      extract_quoted_after(msg, name_marker)\n    }\n    let path = if is_alias {\n      extract_quoted_after(msg, \"' for '\")\n    } else {\n      extract_quoted_after(msg, \"' from '\")\n    }\n    if sym == \"\" {\n      msg\n    } else {\n      let anchor = if path == \"\" {\n        0\n      } else {\n        let p = String::index_of(source, path)\n        if p < 0 {\n          0\n        } else {\n          p\n        }\n      }\n      let off = index_of_after(source, sym, anchor)\n      if off < 0 {\n        msg\n      } else {\n        String::concat(offset_line_col_prefix(source, off), msg)\n      }\n    }\n  }\n}\nfn locate_type_error_heuristic(source: String, msg: String) -> String {\n  if String::index_of(msg, \"line \") == 0 {\n    msg\n  } else {\n    let with_name = locate_by_marker(source, msg, \"unknown name: \")\n    if with_name != msg {\n      with_name\n    } else {\n      let with_arity = locate_by_marker(source, msg, \"function arity mismatch for \")\n      if with_arity != msg {\n        with_arity\n      } else {\n        let with_field = locate_by_marker(source, msg, \"unknown field \")\n        if with_field != msg {\n          with_field\n        } else {\n          let with_ctor = locate_by_marker(source, msg, \"unknown constructor \")\n          if with_ctor != msg {\n            with_ctor\n          } else {\n            let with_import = locate_unused_import_msg(source, msg)\n            if with_import != msg {\n              with_import\n            } else {\n              locate_by_marker(source, msg, \"inline wasm (fn \")\n            }\n          }\n        }\n      }\n    }\n  }\n}\nfn offset_line_col_prefix(source: String, off: Int) -> String {\n  let (line, col) = offset_to_line_col(source, off)\n  String::concat(\"line \", String::concat(__to_string(line), String::concat(\":\", String::concat(__to_string(col), \": \"))))\n}\nfn offset_line_col_range_prefix(source: String, start: Int, endo: Int) -> String {\n  let (l1, c1) = offset_to_line_col(source, start)\n  let (l2, c2) = offset_to_line_col(source, endo)\n  if l1 == l2 && endo > start {\n    String::concat(\"line \", String::concat(__to_string(l1), String::concat(\":\", String::concat(__to_string(c1), String::concat(\"-\", String::concat(__to_string(c2), \": \"))))))\n  } else {\n    offset_line_col_prefix(source, start)\n  }\n}\nfn parse_offset_digits(msg: String, start: Int, end: Int) -> Int {\n  if end <= start {\n    -1\n  } else {\n    let mut i = start\n    let mut acc = 0\n    let mut ok = true\n    while ok && i < end {\n      let c = String::char_code_at(msg, i)\n      if c >= '0' && c <= '9' {\n        acc = acc * 10 + (c - '0')\n        i = i + 1\n      } else {\n        ok = false\n      }\n    }\n    if ok {\n      acc\n    } else {\n      -1\n    }\n  }\n}\nexport fn locate_type_error(source: String, msg: String) -> String {\n  let marker = \" [@off=\"\n  let mi = String::index_of(msg, marker)\n  if mi < 0 {\n    locate_type_error_heuristic(source, msg)\n  } else {\n    let inner_start = mi + String::length(marker)\n    let rel_end = String::index_of(String::substring(msg, inner_start, String::length(msg)), \"]\")\n    if rel_end < 0 {\n      locate_type_error_heuristic(source, String::substring(msg, 0, mi))\n    } else {\n      let close = inner_start + rel_end\n      let inner = String::substring(msg, inner_start, close)\n      let colon = String::index_of(inner, \":\")\n      let n = if colon < 0 {\n        parse_offset_digits(inner, 0, String::length(inner))\n      } else {\n        parse_offset_digits(inner, 0, colon)\n      }\n      let m = if colon < 0 {\n        -1\n      } else {\n        parse_offset_digits(inner, colon + 1, String::length(inner))\n      }\n      let stripped = String::concat(String::substring(msg, 0, mi), String::substring(msg, close + 1, String::length(msg)))\n      let slen = String::length(source)\n      if n >= 0 && n < slen {\n        if m > n && m <= slen {\n          String::concat(offset_line_col_range_prefix(source, n, m), stripped)\n        } else {\n          String::concat(offset_line_col_prefix(source, n), stripped)\n        }\n      } else {\n        locate_type_error_heuristic(source, stripped)\n      }\n    }\n  }\n}\nexport enum ModuleOutcome {\n  Checked(String, String, TypeEnv, String, String);\n  Diagnosed(String, Array[String])\n}\nexport fn check_module(job: ModuleJob) -> ModuleOutcome with { Error } {\n  let stmts = parse_program_with_path(job.path, job.source)\n  let import_env = build_import_env(stmts, dir_of_path(job.path), job.dep_envs)\n  let fingerprint = build_fingerprint(job.source, job.dep_fps)\n  handle {\n    let checked_env = match import_env {\n      EnvEmpty => check_program(stmts),\n      _ => check_program_with_env(stmts, import_env)\n    }\n    let interface_identity = if incremental_interface_trace_enabled() {\n      incremental_interface_identity(job.source, checked_env)\n    } else {\n      \"\"\n    }\n    let checked_env_identity = if incremental_interface_trace_enabled() {\n      incremental_checked_env_identity(checked_env)\n    } else {\n      \"\"\n    }\n    Checked(job.path, fingerprint, checked_env, interface_identity, checked_env_identity)\n  } with Error {\n    Throw(msg) => Diagnosed(job.path, [\n      String::concat(String::concat(job.path, \": \"), locate_type_error(job.source, msg))\n    ])\n  }\n}\nfn commit_module_outcome(rdb: RippleDb, env_cache: Array[(String, TypeEnv)], dep_source_cache: Array[(String, String)], parse_count: Int, job: ModuleJob, outcome: ModuleOutcome) -> (String, RippleDb, Array[(String, TypeEnv)], Array[(String, String)], Int) with { Error, Fs } {\n  match outcome {\n    Diagnosed(_, diags) => if Array::length(diags) > 0 {\n      throw(Array::get(diags, 0))\n    } else {\n      throw(String::concat(job.path, \": type error\"))\n    },\n    Checked(path, fingerprint, checked_env, interface_identity, checked_env_identity) => {\n      store_persistent_type_env(fingerprint, checked_env)\n      if experimental_typing_dependency_env_reuse_enabled() && typing_dependency_env_reuse_is_eligible(path, job.source, job.dep_fps) {\n        publish_typing_dependency_env_reuse_eligibility(fingerprint)\n        write_typing_dependency_env_reuse_sidecar(job.source, job.deps, job.dep_envs, fingerprint)\n      } else {\n        ()\n      }\n      if incremental_interface_trace_enabled() {\n        if String::length(interface_identity) == 0 || String::length(checked_env_identity) == 0 {\n          throw(String::concat(\"incremental trace observation: missing checked identity for \", path))\n        } else {\n          incremental_interface_trace_observe(path, interface_identity, checked_env_identity)\n        }\n      } else {\n        ()\n      }\n      if Array::length(job.deps) == 0 {\n        Fs::write_file(persistent_leaf_fingerprint_cache_path(path, compact_string_fingerprint(job.source)), persistent_leaf_fingerprint_text(fingerprint))\n      } else {\n        ()\n      }\n      let next_env_cache = upsert_env_cache(env_cache, path, checked_env)\n      let next_db = ripple_record_eval(rdb, path, fingerprint, job.deps)\n      (fingerprint, next_db, next_env_cache, dep_source_cache, parse_count)\n    }\n  }\n}\nfn job_dir_path(dir: String, name: String) -> String {\n  String::concat(String::concat(dir, \"/\"), name)\n}\nfn parse_job_rows(job_text: String) -> (String, Array[String], Array[String]) with { Error } {\n  let lines = String::split(normalize_persistent_cache_text(job_text), \"\\n\")\n  let len = Array::length(lines)\n  let deps = empty_stack()\n  let dep_fps = empty_stack()\n  let mut path = \"\"\n  let mut version_ok = false\n  let mut i = 0\n  while i < len {\n    let line = Array::get(lines, i)\n    if String::length(line) == 0 {\n      ()\n    } else {\n      let parts = String::split(line, \"\\t\")\n      let plen = Array::length(parts)\n      let key = if plen > 0 {\n        Array::get(parts, 0)\n      } else {\n        \"\"\n      }\n      if key == \"dep\" {\n        let dep_path = Array::get(parts, 1)\n        let dep_fp = Array::get(parts, 2)\n        if plen != 3 {\n          throw(String::concat(\"invalid module job dep row (want path + fingerprint): \", line))\n        } else if String::length(dep_path) == 0 || String::length(dep_fp) == 0 {\n          throw(String::concat(\"invalid module job dep row (empty path or fingerprint): \", line))\n        } else {\n          Array::push(deps, dep_path)\n          Array::push(dep_fps, dep_fp)\n        }\n      } else if plen != 2 {\n        throw(String::concat(\"invalid module job row: \", line))\n      } else {\n        let value = Array::get(parts, 1)\n        if key == \"version\" {\n          if value == \"1\" {\n            version_ok = true\n          } else {\n            throw(String::concat(\"unsupported module job version: \", value))\n          }\n        } else if key == \"path\" {\n          path = value\n        } else {\n          throw(String::concat(\"unknown module job row: \", line))\n        }\n      }\n    }\n    i = i + 1\n  }\n  if !version_ok {\n    throw(\"module job is missing its version row\")\n  } else if String::length(path) == 0 {\n    throw(\"module job is missing its path row\")\n  } else {\n    (path, deps, dep_fps)\n  }\n} export fn run_module_job_dir(dir: String) -> Unit with { Error, Fs } {\n  let (path, deps, dep_fps) = parse_job_rows(Fs::read_file(job_dir_path(dir, \"job.txt\")))\n  let source = Fs::read_file(job_dir_path(dir, \"source.vibe\"))\n  let dep_envs = array_empty()\n  let job_dep_fps = array_empty()\n  let mut i = 0\n  let dlen = Array::length(deps)\n  while i < dlen {\n    let dep_path = Array::get(deps, i)\n    Array::push(job_dep_fps, (dep_path, Array::get(dep_fps, i)))\n    let env_file = job_dir_path(dir, String::concat(String::concat(\"dep\", __to_string(i)), \".env\"))\n    if Fs::exists(env_file) {\n      match parse_persistent_type_env(Fs::read_file(env_file)) {\n        Some(env) => Array::push(dep_envs, (dep_path, env)),\n        None => throw(String::concat(\"module job: unreadable dependency environment: \", env_file))\n      }\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  let job = ModuleJob::{\n    path: path,\n    source: source,\n    deps: deps,\n    dep_fps: job_dep_fps,\n    dep_envs: dep_envs\n  }\n  let outcome = handle {\n    check_module(job)\n  } with Error {\n    Throw(msg) => Diagnosed(path, [\n      msg\n    ])\n  }\n  match outcome {\n    Checked(_, fingerprint, env, _, _) => {\n      Fs::write_file(job_dir_path(dir, \"env.out\"), persistent_type_env_cache_text(env))\n      Fs::write_file(job_dir_path(dir, \"fingerprint.out\"), fingerprint)\n      Fs::write_file(job_dir_path(dir, \"outcome.txt\"), \"ok\")\n    },\n    Diagnosed(_, diags) => {\n      Fs::write_file(job_dir_path(dir, \"diag.txt\"), String::join(diags, \"\\n\"))\n      Fs::write_file(job_dir_path(dir, \"outcome.txt\"), \"diag\")\n    }\n  }\n}\nfn parse_publish_manifest_rows(text: String) -> Array[(String, String)] with { Error } {\n  let lines = String::split(normalize_persistent_cache_text(text), \"\\n\")\n  let rows = array_empty()\n  let mut i = 0\n  let len = Array::length(lines)\n  while i < len {\n    let line = Array::get(lines, i)\n    if String::length(line) == 0 {\n      ()\n    } else {\n      let parts = String::split(line, \"\\t\")\n      if Array::length(parts) != 2 {\n        throw(String::concat(\"invalid publish manifest row (want fingerprint + envfile): \", line))\n      } else {\n        let fingerprint = Array::get(parts, 0)\n        let env_file = Array::get(parts, 1)\n        if String::length(fingerprint) == 0 || String::length(env_file) == 0 {\n          throw(String::concat(\"invalid publish manifest row (empty fingerprint or envfile): \", line))\n        } else {\n          Array::push(rows, (fingerprint, env_file))\n        }\n      }\n    }\n    i = i + 1\n  }\n  rows\n} export fn run_publish_env_cache_dir(dir: String) -> Unit with { Error, Fs } {\n  let rows = parse_publish_manifest_rows(Fs::read_file(job_dir_path(dir, \"manifest.txt\")))\n  let mut i = 0\n  let len = Array::length(rows)\n  while i < len {\n    let (fingerprint, env_file) = Array::get(rows, i)\n    let env_text = Fs::read_file(job_dir_path(dir, env_file))\n    Fs::write_file(persistent_type_env_cache_path(fingerprint), env_text)\n    i = i + 1\n  }\n}\nfn finish_typecheck_fs_impl(rdb: RippleDb, env_cache: Array[(String, TypeEnv)], dep_source_cache: Array[(String, String)], parse_count: Int, path: String, source: String, deps: Array[String], dep_fps: Array[(String, String)], fingerprint: String) -> (String, RippleDb, Array[(String, TypeEnv)], Array[(String, String)], Int) with { Error, Fs } {\n  if Fs::exists(persistent_type_env_cache_path(fingerprint)) {\n    if incremental_interface_trace_enabled() {\n      match load_persistent_type_env(fingerprint) {\n        Some(cached_env) => incremental_trace_observe_checked_env(path, source, cached_env),\n        None => throw(String::concat(\"incremental trace observation: unreadable reused environment for \", path))\n      }\n    } else {\n      ()\n    }\n    let next_db = ripple_record_eval(rdb, path, fingerprint, deps)\n    (fingerprint, next_db, env_cache, dep_source_cache, parse_count)\n  } else {\n    let import_env_cache = ensure_env_cache_for_paths(rdb, env_cache, deps)\n    let reused_env = if experimental_typing_dependency_env_reuse_enabled() && typing_dependency_env_reuse_is_eligible(path, source, dep_fps) {\n      match typing_dependency_transport_input_key(source, deps, import_env_cache) {\n        Some(input_key) => load_typing_dependency_env_reuse_target(input_key),\n        None => None\n      }\n    } else {\n      None\n    }\n    match reused_env {\n      Some((_target_fingerprint, target_env)) => {\n        store_persistent_type_env(fingerprint, target_env)\n        publish_typing_dependency_env_reuse_eligibility(fingerprint)\n        write_typing_dependency_env_reuse_sidecar(source, deps, import_env_cache, fingerprint)\n        let next_env_cache = upsert_env_cache(import_env_cache, path, target_env)\n        let next_db = ripple_record_eval(rdb, path, fingerprint, deps)\n        (fingerprint, next_db, next_env_cache, dep_source_cache, parse_count)\n      },\n      None => {\n        let job = ModuleJob::{\n          path: path,\n          source: source,\n          deps: deps,\n          dep_fps: dep_fps,\n          dep_envs: import_env_cache\n        }\n        let outcome = check_module(job)\n        commit_module_outcome(rdb, import_env_cache, dep_source_cache, parse_count + 1, job, outcome)\n      }\n    }\n  }\n} fn collect_import_deps_from_stmts(stmts: Array[Stmt], base_dir: String) -> Array[String] {\n  let out = empty_stack()\n  let mut i = 0\n  let len = Array::length(stmts)\n  while i < len {\n    match Array::get(stmts, i) {\n      SImport(raw_path, _) => if String::length(raw_path) > 0 {\n        let resolved = resolve_import_path(base_dir, raw_path)\n        if !contains_str(out, resolved) {\n          Array::push(out, resolved)\n        }\n      },\n      SReExport(raw_path, _) => if String::length(raw_path) > 0 {\n        let resolved = resolve_import_path(base_dir, raw_path)\n        if !contains_str(out, resolved) {\n          Array::push(out, resolved)\n        }\n      },\n      _ => ()\n    }\n    i = i + 1\n  }\n  out\n} fn load_or_parse_deps_for_source_fs(dep_source_cache: Array[(String, String)], path: String, source: String, parse_count: Int) -> (Array[String], Array[(String, String)], Int) with { Error, Fs } {\n  match load_persistent_dep_list(path, source) {\n    Some(deps) => (deps, upsert_string_pair(dep_source_cache, path, source), parse_count),\n    None => {\n      let (deps, _, next_parse_count) = load_or_parse_module_header_fs(path, source, parse_count)\n      (deps, upsert_string_pair(dep_source_cache, path, source), next_parse_count)\n    }\n  }\n} fn resolve_deps_for_source_fs(rdb: RippleDb, dep_source_cache: Array[(String, String)], path: String, source: String, parse_count: Int) -> (Array[String], Array[(String, String)], Int) with { Error, Fs } {\n  match lookup_string_pair(dep_source_cache, path) {\n    Some(cached_source) =>\n    if cached_source == source {\n      match ripple_get_deps(rdb, path) {\n        Some(deps) => (deps, dep_source_cache, parse_count),\n        None => load_or_parse_deps_for_source_fs(dep_source_cache, path, source, parse_count)\n      }\n    } else {\n      load_or_parse_deps_for_source_fs(dep_source_cache, path, source, parse_count)\n    },\n    None => load_or_parse_deps_for_source_fs(dep_source_cache, path, source, parse_count)\n  }\n}\nfn plan_import_graph_fs(rdb: RippleDb, dep_source_cache: Array[(String, String)], parse_count: Int, root: String) -> (Array[(String, String)], Array[(String, Array[String])], Int, Array[(String, String)]) with { Error, Fs } {\n  let leaf_fps = empty_dep_fps()\n  let plan_diags: Array[(String, String)] = [\n  ]\n  let edges: Array[(String, Array[String])] = [\n  ]\n  let seen = empty_stack()\n  let queue = empty_stack()\n  let scratch_cache = copy_string_pairs(dep_source_cache)\n  let mut pc = parse_count\n  Array::push(seen, root)\n  Array::push(queue, root)\n  let mut qi = 0\n  while qi < Array::length(queue) {\n    let path = Array::get(queue, qi)\n    qi = qi + 1\n    match ripple_get_source(rdb, path) {\n      None => (),\n      Some(source) => {\n        let reusable = if dep_source_cache_is_current(dep_source_cache, path, source) {\n          match ripple_get_fingerprint(rdb, path) {\n            Some(_) => true,\n            None => false\n          }\n        } else {\n          false\n        }\n        if reusable {\n          ()\n        } else {\n          match load_persistent_leaf_fingerprint(path, source) {\n            Some(leaf_fingerprint) => Array::push(leaf_fps, (path, leaf_fingerprint)),\n            None => {\n              let plan_raised = empty_stack()\n              let (deps_raw, _, next_pc) = handle {\n                resolve_deps_for_source_fs(rdb, scratch_cache, path, source, pc)\n              } with Error {\n                Throw(msg) => {\n                  Array::push(plan_raised, msg)\n                  (empty_stack(), scratch_cache, pc)\n                }\n              }\n              if Array::length(plan_raised) > 0 {\n                let msg = Array::get(plan_raised, 0)\n                if !collect_module_diagnostics() || String::starts_with(msg, \"type_db: \") {\n                  throw(msg)\n                } else {\n                  Array::push(plan_diags, (path, msg))\n                }\n              } else {\n                ()\n              }\n              let deps = copy_string_array(deps_raw)\n              pc = next_pc\n              if Array::length(plan_raised) > 0 {\n                ()\n              } else {\n                Array::push(edges, (path, deps))\n              }\n              let dlen = Array::length(deps)\n              let mut i = 0\n              while i < dlen {\n                let dep = Array::get(deps, i)\n                if contains_str(seen, dep) {\n                  ()\n                } else {\n                  Array::push(seen, dep)\n                  Array::push(queue, dep)\n                }\n                i = i + 1\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n  (leaf_fps, edges, pc, plan_diags)\n}\nfn plan_deps_of(plan_edges: Array[(String, Array[String])], path: String) -> Option[Array[String]] {\n  let n = Array::length(plan_edges)\n  let mut i = 0\n  let mut found: Option[Array[String]] = None\n  while i < n {\n    let e = Array::get(plan_edges, i)\n    if e.0 == path {\n      found = Some(copy_string_array(e.1))\n      i = n\n    } else {\n      i = i + 1\n    }\n  }\n  found\n}\nfn commit_leaf_fingerprint_fs(rdb: RippleDb, env_cache: Array[(String, TypeEnv)], dep_source_cache: Array[(String, String)], parse_count: Int, path: String, source: String, leaf_fingerprint: String) -> (String, RippleDb, Array[(String, TypeEnv)], Array[(String, String)], Int) with { Error, Fs } {\n  if incremental_interface_trace_enabled() {\n    match load_persistent_type_env(leaf_fingerprint) {\n      Some(cached_env) => incremental_trace_observe_checked_env(path, source, cached_env),\n      None => throw(String::concat(\"incremental trace observation: unreadable reused leaf environment for \", path))\n    }\n  } else {\n    ()\n  }\n  write_persistent_dep_list_if_missing(path, source, empty_stack())\n  let next_dep_source_cache = upsert_string_pair(dep_source_cache, path, source)\n  let next_db = ripple_record_eval(rdb, path, leaf_fingerprint, empty_stack())\n  (leaf_fingerprint, next_db, env_cache, next_dep_source_cache, parse_count)\n}\nfn commit_with_deps_fs(fps: Array[(String, String)], rdb: RippleDb, env_cache: Array[(String, TypeEnv)], dep_source_cache: Array[(String, String)], parse_count: Int, path: String, source: String, deps: Array[String]) -> (String, RippleDb, Array[(String, TypeEnv)], Array[(String, String)], Int) with { Error, Fs } {\n  write_persistent_dep_list_if_missing(path, source, deps)\n  let dlen = Array::length(deps)\n  let dep_fps = empty_dep_fps()\n  let mut i = 0\n  while i < dlen {\n    let dep_path = Array::get(deps, i)\n    match lookup_string_pair(fps, dep_path) {\n      Some(dep_fp) => Array::push(dep_fps, (dep_path, dep_fp)),\n      None => throw(String::concat(\"type_db: dependency stepped out of rank order: \", dep_path))\n    }\n    i = i + 1\n  }\n  let fingerprint = build_fingerprint(source, dep_fps)\n  match ripple_get_fingerprint(rdb, path) {\n    Some(cached_fp) =>\n    if cached_fp == fingerprint {\n      (fingerprint, rdb, env_cache, dep_source_cache, parse_count)\n    } else {\n      finish_typecheck_fs_impl(rdb, env_cache, dep_source_cache, parse_count, path, source, deps, dep_fps, fingerprint)\n    },\n    None =>\n    finish_typecheck_fs_impl(rdb, env_cache, dep_source_cache, parse_count, path, source, deps, dep_fps, fingerprint)\n  }\n}\nfn dep_source_cache_is_current(dep_source_cache: Array[(String, String)], path: String, source: String) -> Bool {\n  match lookup_string_pair(dep_source_cache, path) {\n    Some(cached_source) => cached_source == source,\n    None => false\n  }\n}\nfn step_module_fs(plan_leaf_fps: Array[(String, String)], plan_edges: Array[(String, Array[String])], fps: Array[(String, String)], rdb: RippleDb, env_cache: Array[(String, TypeEnv)], dep_source_cache: Array[(String, String)], parse_count: Int, path: String) -> (String, RippleDb, Array[(String, TypeEnv)], Array[(String, String)], Int) with { Error, Fs } {\n  match ripple_get_source(rdb, path) {\n    None => (String::concat(\"missing:\", path), rdb, env_cache, dep_source_cache, parse_count),\n    Some(source) => {\n      let reusable = if dep_source_cache_is_current(dep_source_cache, path, source) {\n        ripple_get_fingerprint(rdb, path)\n      } else {\n        None\n      }\n      match reusable {\n        Some(cached_fingerprint) => {\n          if incremental_interface_trace_enabled() {\n            let observed_env = match lookup_env_cache(env_cache, path) {\n              Some(value) => value,\n              None => match load_persistent_type_env(cached_fingerprint) {\n                Some(value) => value,\n                None => throw(String::concat(\"incremental trace observation: unreadable in-memory reused environment for \", path))\n              }\n            }\n            incremental_trace_observe_checked_env(path, source, observed_env)\n          } else {\n            ()\n          }\n          (cached_fingerprint, rdb, env_cache, dep_source_cache, parse_count)\n        }\n        None =>\n        match lookup_string_pair(plan_leaf_fps, path) {\n          Some(leaf_fingerprint) =>\n          commit_leaf_fingerprint_fs(rdb, env_cache, dep_source_cache, parse_count, path, source, leaf_fingerprint),\n          None =>\n          match plan_deps_of(plan_edges, path) {\n            Some(planned_deps) =>\n            commit_with_deps_fs(fps, rdb, env_cache, upsert_string_pair(dep_source_cache, path, source), parse_count, path, source, planned_deps),\n            None => throw(String::concat(\"type_db: module missing from the import plan: \", path))\n          }\n        }\n      }\n    }\n  }\n}\nfn module_plan_index_of(items: Array[String], p: String) -> Int {\n  let n = Array::length(items)\n  let mut i = 0\n  let mut found = 0 - 1\n  while found < 0 && i < n {\n    if Array::get(items, i) == p {\n      found = i\n    } else {\n      i = i + 1\n    }\n  }\n  found\n}\nfn module_plan_data_fs(entry_path: String) -> (Array[String], Array[Int], Array[Array[String]], Array[String]) with { Error, Fs } {\n  let paths: Array[String] = [\n  ]\n  let deps_of: Array[Array[String]] = [\n  ]\n  let sources: Array[String] = [\n  ]\n  Array::push(paths, entry_path)\n  let mut qi = 0\n  while qi < Array::length(paths) {\n    let p = Array::get(paths, qi)\n    qi = qi + 1\n    if !Fs::exists(p) {\n      throw(String::concat(\"module plan: cannot read module: \", p))\n    } else {\n      ()\n    }\n    let ingested = ingest_source_text_fs(p, Fs::read_file(p))\n    let (deps, _exports, _parse_count) = load_or_parse_module_header_fs(p, ingested, 0)\n    Array::push(sources, ingested)\n    Array::push(deps_of, deps)\n    let dlen = Array::length(deps)\n    let mut i = 0\n    while i < dlen {\n      let d = Array::get(deps, i)\n      if module_plan_index_of(paths, d) >= 0 {\n        ()\n      } else {\n        Array::push(paths, d)\n      }\n      i = i + 1\n    }\n  }\n  let edges: Array[(String, Array[String])] = [\n  ]\n  let mut e = 0\n  while e < Array::length(paths) {\n    Array::push(edges, (Array::get(paths, e), Array::get(deps_of, e)))\n    e = e + 1\n  }\n  let (order, ranks) = plan_module_order(edges, entry_path)\n  let ordered_deps: Array[Array[String]] = [\n  ]\n  let ordered_sources: Array[String] = [\n  ]\n  let mut k = 0\n  while k < Array::length(order) {\n    let src_index = module_plan_index_of(paths, Array::get(order, k))\n    Array::push(ordered_deps, Array::get(deps_of, src_index))\n    Array::push(ordered_sources, Array::get(sources, src_index))\n    k = k + 1\n  }\n  (order, ranks, ordered_deps, ordered_sources)\n} export fn module_plan_manifest_fs(entry_path: String) -> (String, Array[String]) with { Error, Fs } {\n  let (order, ranks, ordered_deps, ordered_sources) = module_plan_data_fs(entry_path)\n  let buf = StringBuilder::new()\n  StringBuilder::push(buf, \"version\\t1\\n\")\n  let n = Array::length(order)\n  let mut k = 0\n  while k < n {\n    let p = Array::get(order, k)\n    let index_text = __to_string(k)\n    StringBuilder::push(buf, \"module\\t\")\n    StringBuilder::push(buf, index_text)\n    StringBuilder::push(buf, \"\\t\")\n    StringBuilder::push(buf, __to_string(Array::get(ranks, k)))\n    StringBuilder::push(buf, \"\\t\")\n    StringBuilder::push(buf, p)\n    StringBuilder::push(buf, \"\\n\")\n    let deps = Array::get(ordered_deps, k)\n    let dlen = Array::length(deps)\n    let mut i = 0\n    while i < dlen {\n      StringBuilder::push(buf, \"dep\\t\")\n      StringBuilder::push(buf, index_text)\n      StringBuilder::push(buf, \"\\t\")\n      StringBuilder::push(buf, Array::get(deps, i))\n      StringBuilder::push(buf, \"\\n\")\n      i = i + 1\n    }\n    k = k + 1\n  }\n  (StringBuilder::freeze(buf), ordered_sources)\n}\nfn module_is_blocked(plan_edges: Array[(String, Array[String])], failed: Array[String], path: String) -> Bool {\n  if Array::length(failed) == 0 {\n    false\n  } else {\n    match plan_deps_of(plan_edges, path) {\n      None => false,\n      Some(deps) => {\n        let n = Array::length(deps)\n        let mut i = 0\n        let mut blocked = false\n        while i < n && !blocked {\n          if contains_str(failed, Array::get(deps, i)) {\n            blocked = true\n          } else {\n            i = i + 1\n          }\n        }\n        blocked\n      }\n    }\n  }\n}\nfn module_diag_lt(a: (String, String), b: (String, String)) -> Bool {\n  if a.0 == b.0 {\n    str_lt(a.1, b.1)\n  } else {\n    str_lt(a.0, b.0)\n  }\n}\nfn sort_module_diagnostics(diags: Array[(String, String)]) -> Array[(String, String)] {\n  let out: Array[(String, String)] = [\n  ]\n  let n = Array::length(diags)\n  let mut i = 0\n  while i < n {\n    let entry = Array::get(diags, i)\n    Array::push(out, entry)\n    let mut j = Array::length(out) - 1\n    while j > 0 && module_diag_lt(entry, Array::get(out, j - 1)) {\n      Array::set(out, j, Array::get(out, j - 1))\n      Array::set(out, j - 1, entry)\n      j = j - 1\n    }\n    i = i + 1\n  }\n  out\n}\nfn scheduler_trace_project(buf: StringBuilder, order: Array[String], ranks: Array[Int], plan_edges: Array[(String, Array[String])]) -> Unit {\n  let n = Array::length(order)\n  let mut i = 0\n  while i < n {\n    let p = Array::get(order, i)\n    StringBuilder::push(buf, \"project\\t\")\n    StringBuilder::push(buf, p)\n    StringBuilder::push(buf, \"\\t\")\n    StringBuilder::push(buf, __to_string(Array::get(ranks, i)))\n    match plan_deps_of(plan_edges, p) {\n      None => (),\n      Some(deps) => {\n        let dlen = Array::length(deps)\n        let mut d = 0\n        while d < dlen {\n          StringBuilder::push(buf, \"\\t\")\n          StringBuilder::push(buf, Array::get(deps, d))\n          d = d + 1\n        }\n      }\n    }\n    StringBuilder::push(buf, \"\\n\")\n    i = i + 1\n  }\n} fn join_module_diagnostics(diags: Array[(String, String)]) -> String {\n  let sorted = sort_module_diagnostics(diags)\n  let msgs = array_empty()\n  let n = Array::length(sorted)\n  let mut i = 0\n  while i < n {\n    let entry = Array::get(sorted, i)\n    Array::push(msgs, entry.1)\n    i = i + 1\n  }\n  String::join(dedupe_diagnostics(msgs), \"\\n\")\n}\nexport fn ensure_fingerprint_fs_impl(rdb: RippleDb, env_cache: Array[(String, TypeEnv)], dep_source_cache: Array[(String, String)], parse_count: Int, path: String) -> (String, RippleDb, Array[(String, TypeEnv)], Array[(String, String)], Int) with { Error, Fs } {\n  let (plan_leaf_fps, plan_edges, planned_parse_count, plan_diags) = plan_import_graph_fs(rdb, dep_source_cache, parse_count, path)\n  let (order, ranks) = plan_module_order(plan_edges, path)\n  incremental_typecheck_telemetry_add(0, Array::length(order))\n  let fps = empty_dep_fps()\n  let mut db = rdb\n  let mut envc = env_cache\n  let mut dsc = dep_source_cache\n  let mut pc = planned_parse_count\n  let failed = empty_stack()\n  let diags: Array[(String, String)] = [\n  ]\n  let mut pdi = 0\n  while pdi < Array::length(plan_diags) {\n    let entry = Array::get(plan_diags, pdi)\n    Array::push(failed, entry.0)\n    Array::push(diags, entry)\n    pdi = pdi + 1\n  }\n  let trace_path = scheduler_trace_path()\n  let tracing = String::length(trace_path) > 0\n  let trace = StringBuilder::new()\n  if tracing {\n    scheduler_trace_project(trace, order, ranks, plan_edges)\n  } else {\n    ()\n  }\n  let n = Array::length(order)\n  let mut i = 0\n  while i < n {\n    let r = Array::get(ranks, i)\n    let mut j = i\n    while j < n && Array::get(ranks, j) == r {\n      j = j + 1\n    }\n    let wave = j - i\n    let visit = dep_visit_order(wave)\n    let mut k = 0\n    while k < wave {\n      let m = Array::get(order, i + Array::get(visit, k))\n      if contains_str(failed, m) || module_is_blocked(plan_edges, failed, m) {\n        incremental_typecheck_telemetry_add(4, 1)\n        Array::push(failed, m)\n      } else {\n        let cur_db = db\n        let cur_envc = envc\n        let cur_dsc = dsc\n        let cur_pc = pc\n        let raised = empty_stack()\n        let (fp, next_db, next_envc, next_dsc, next_pc) = handle {\n          step_module_fs(plan_leaf_fps, plan_edges, fps, cur_db, cur_envc, cur_dsc, cur_pc, m)\n        } with Error {\n          Throw(msg) => {\n            Array::push(raised, msg)\n            (String::concat(\"diagnosed:\", m), cur_db, cur_envc, cur_dsc, cur_pc)\n          }\n        }\n        if Array::length(raised) > 0 {\n          let msg = Array::get(raised, 0)\n          if !collect_module_diagnostics() || String::starts_with(msg, \"type_db: \") {\n            throw(msg)\n          } else {\n            incremental_typecheck_telemetry_add(4, 1)\n            Array::push(failed, m)\n            Array::push(diags, (m, msg))\n          }\n        } else {\n          if next_pc > cur_pc {\n            incremental_typecheck_telemetry_add(1, 1)\n            incremental_typecheck_telemetry_decide(m, \"rechecked\")\n          } else {\n            incremental_typecheck_telemetry_add(2, 1)\n            incremental_typecheck_telemetry_decide(m, \"reused\")\n          }\n          db = next_db\n          envc = next_envc\n          dsc = next_dsc\n          pc = next_pc\n          Array::push(fps, (m, fp))\n          if tracing {\n            let env_hash = match lookup_env_cache(next_envc, m) {\n              Some(env) => compact_string_fingerprint(persistent_type_env_cache_text(env)),\n              None => \"-\"\n            }\n            StringBuilder::push(trace, \"step\\t\")\n            StringBuilder::push(trace, m)\n            StringBuilder::push(trace, \"\\t\")\n            StringBuilder::push(trace, fp)\n            StringBuilder::push(trace, \"\\t\")\n            StringBuilder::push(trace, env_hash)\n            StringBuilder::push(trace, \"\\n\")\n          } else {\n            ()\n          }\n        }\n      }\n      k = k + 1\n    }\n    i = j\n  }\n  if tracing {\n    Fs::write_file(trace_path, StringBuilder::freeze(trace))\n  } else {\n    ()\n  }\n  if Array::length(diags) > 0 {\n    throw(join_module_diagnostics(diags))\n  } else {\n    ()\n  }\n  let root_fingerprint = match lookup_string_pair(fps, path) {\n    Some(f) => f,\n    None => String::concat(\"missing:\", path)\n  }\n  let final_env_cache = ensure_env_cache_for_path(db, envc, path)\n  incremental_typecheck_telemetry_add(3, pc - parse_count)\n  (root_fingerprint, db, final_env_cache, dsc, pc)\n}\nfn dedupe_diagnostics(diags: Array[String]) -> Array[String] {\n  let out = array_empty()\n  let mut i = 0\n  while i < Array::length(diags) {\n    let d = Array::get(diags, i)\n    if contains_str(out, d) {\n      ()\n    } else {\n      Array::push(out, d)\n    }\n    i = i + 1\n  }\n  out\n}\nfn collect_inline_wasm_fns(stmts: Array[Stmt]) -> Array[(String, String, Array[String])] {\n  let out = array_empty()\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SLet(_, _, iw_name, _, iw_expr) => match iw_expr {\n        EFn(_, _, iw_params, _, _, iw_body) => match iw_body {\n          ECall(iw_cal, iw_args, _) => match iw_cal {\n            EIdent(iw_cn, _) => if iw_cn == \"%wasm\" && Array::length(iw_args) == 1 {\n              match Array::get(iw_args, 0) {\n                EString(iw_wat) => {\n                  let pnames = array_empty()\n                  let mut pi = 0\n                  while pi < Array::length(iw_params) {\n                    let (pn, _) = Array::get(iw_params, pi)\n                    Array::push(pnames, pn)\n                    pi = pi + 1\n                  }\n                  Array::push(out, (iw_name, iw_wat, pnames))\n                },\n                _ => ()\n              }\n            } else {\n              ()\n            },\n            _ => ()\n          },\n          _ => ()\n        },\n        _ => ()\n      },\n      _ => ()\n    }\n    i = i + 1\n  }\n  out\n}\nexport fn check_inline_wasm_fns(stmts: Array[Stmt]) -> Option[String] {\n  let fns = collect_inline_wasm_fns(stmts)\n  let n = Array::length(fns)\n  let mut i = 0\n  let mut result = None\n  let mut done = false\n  while !done {\n    if i >= n {\n      done = true\n    } else {\n      let (fn_name, wat, pnames) = Array::get(fns, i)\n      let outcome = handle {\n        let _ = compile_inline_wat(fn_name, wat, pnames)\n        None\n      } with Error {\n        Throw(msg) => Some(msg)\n      }\n      match outcome {\n        Some(msg) => {\n          result = Some(msg)\n          done = true\n        },\n        None => {\n          i = i + 1\n        }\n      }\n    }\n  }\n  result\n}\nexport fn collect_all_diagnostics(source: String) -> Array[String] with { Error } {\n  let (tokens, starts, _ends, lex_err_offsets, lex_err_msgs) = lex_with_offsets_recovering(source)\n  if Array::length(lex_err_msgs) > 0 {\n    let located = array_empty()\n    let mut i = 0\n    while i < Array::length(lex_err_msgs) {\n      let msg = Array::get(lex_err_msgs, i)\n      let entry = if String::starts_with(msg, \"line \") {\n        msg\n      } else {\n        let off = Array::get(lex_err_offsets, i)\n        let (line, col) = offset_to_line_col(source, off)\n        let loc = String::concat(\"line \", String::concat(__to_string(line), String::concat(\":\", String::concat(__to_string(col), \": \"))))\n        String::concat(loc, msg)\n      }\n      Array::push(located, entry)\n      i = i + 1\n    }\n    dedupe_diagnostics(located)\n  } else {\n    let (stmts, parse_diags) = parse_program_recovering(tokens, starts, source)\n    if Array::length(parse_diags) > 0 {\n      dedupe_diagnostics(parse_diags)\n    } else {\n      handle {\n        let _env = check_program(stmts)\n        match check_inline_wasm_fns(stmts) {\n          Some(msg) => [\n            locate_type_error(source, msg)\n          ],\n          None => {\n            let extra = array_empty()\n            let import_warns = detect_unused_imports(stmts)\n            let mut wi = 0\n            while wi < Array::length(import_warns) {\n              let (_, _, wmsg) = Array::get(import_warns, wi)\n              Array::push(extra, locate_type_error(source, String::concat(\"warning: \", wmsg)))\n              wi = wi + 1\n            }\n            let (warn_tytab, warn_subst) = check_program_type_table(stmts)\n            let return_warns = detect_unbound_nonunit_returns(stmts, warn_tytab, warn_subst)\n            let mut ri = 0\n            while ri < Array::length(return_warns) {\n              Array::push(extra, locate_type_error(source, String::concat(\"warning: \", Array::get(return_warns, ri))))\n              ri = ri + 1\n            }\n            extra\n          }\n        }\n      } with Error {\n        Throw(msg) => [\n          locate_type_error(source, msg)\n        ]\n      }\n    }\n  }\n}")
}

let source_166 = () -> (String, String) {
  ("lib/@vibe/compiler/runtime/type_at.vibe",
"\n\nimport @vibe/compiler/core {\n  Expr, Pat, Stmt, Subst, Type, TypeEnv, env_lookup, subst_apply, type_to_string\n}\n\nimport @vibe/core {\n  array_empty\n}\n\nimport @vibe/compiler/checker {\n  check_program, check_program_type_table\n}\n\nimport @vibe/compiler/syntax {\n  lex_with_offsets, offset_to_line_col, parse_program_located, parse_program_spans\n}\n\n\nfn line_col_to_offset(source: String, line: Int, col: Int) -> Int {\n  if line < 1 || col < 1 {\n    -1\n  } else {\n    let len = String::length(source)\n    let mut i = 0\n    let mut cur_line = 1\n    while cur_line < line && i < len {\n      if String::char_code_at(source, i) == 10 {\n        cur_line = cur_line + 1\n      } else {\n        ()\n      }\n      i = i + 1\n    }\n    if cur_line < line {\n      -1\n    } else {\n      let mut line_end = i\n      while line_end < len && String::char_code_at(source, line_end) != 10 {\n        line_end = line_end + 1\n      }\n      let content_end = if line_end > i && String::char_code_at(source, line_end - 1) == 13 {\n        line_end - 1\n      } else {\n        line_end\n      }\n      let off = i + (col - 1)\n      if off > content_end {\n        -1\n      } else {\n        off\n      }\n    }\n  }\n}\n\nenum IdentHit {\n  IdentHit(String, Int)\n}\n\nfn empty_hits() -> Array[IdentHit] {\n  array_empty()\n}\n\nfn collect_expr(expr: Expr, acc: Array[IdentHit]) -> Unit {\n  match expr {\n    EInt(_) => (),\n    EFloat(_) => (),\n    EString(_) => (),\n    EBool(_) => (),\n    EIdent(name, off) => {\n      if off >= 0 {\n        Array::push(acc, IdentHit(name, off))\n      } else {\n        ()\n      }\n    },\n    EUnit => (),\n    EStringInterp(_) => (),\n    ETuple(items) => collect_exprs(items, acc),\n    EArray(items) => collect_exprs(items, acc),\n    ERecord(_, fields, _) => collect_field_exprs(fields, acc),\n    EIf(c, t, e) => {\n      collect_expr(c, acc)\n      collect_expr(t, acc)\n      collect_expr(e, acc)\n    },\n    ELet(_, v, b, _) => {\n      collect_expr(v, acc)\n      collect_expr(b, acc)\n    },\n    ELetRec(_, v, b) => {\n      collect_expr(v, acc)\n      collect_expr(b, acc)\n    },\n    ELetMut(_, v, b, _) => {\n      collect_expr(v, acc)\n      collect_expr(b, acc)\n    },\n    EAssign(_, v, b) => {\n      collect_expr(v, acc)\n      collect_expr(b, acc)\n    },\n    EAssignOp(_, _, v, b) => {\n      collect_expr(v, acc)\n      collect_expr(b, acc)\n    },\n    ESeq(a, b) => {\n      collect_expr(a, acc)\n      collect_expr(b, acc)\n    },\n    EMatch(s, arms) => {\n      collect_expr(s, acc)\n      collect_arm_exprs(arms, acc)\n    },\n    EHandle(s, arms) => {\n      collect_expr(s, acc)\n      collect_arm_exprs(arms, acc)\n    },\n    EWhile(c, b) => {\n      collect_expr(c, acc)\n      collect_expr(b, acc)\n    },\n    ELoop(params, b) => {\n      collect_loop_param_exprs(params, acc)\n      collect_expr(b, acc)\n    },\n    EForIn(_, _, it, b) => {\n      collect_expr(it, acc)\n      collect_expr(b, acc)\n    },\n    ECall(callee, args, _) => {\n      collect_expr(callee, acc)\n      collect_exprs(args, acc)\n    },\n    EBinOp(_, l, r) => {\n      collect_expr(l, acc)\n      collect_expr(r, acc)\n    },\n    EUnaryOp(_, e) => collect_expr(e, acc),\n    EFn(_, _, _, _, _, body) => collect_expr(body, acc),\n    EDot(e, field, _, field_off) => {\n      if field_off >= 0 {\n        Array::push(acc, IdentHit(field, field_off))\n      } else {\n        ()\n      }\n      collect_expr(e, acc)\n    },\n    ELabeledArg(_, _, v) => collect_expr(v, acc),\n    EReturn(e) => collect_expr(e, acc),\n    EBreak(opt) => match opt {\n      Some(v) => collect_expr(v, acc),\n      None => ()\n    },\n    EContinue(args) => collect_exprs(args, acc),\n    EMap(fields) => collect_field_exprs(fields, acc),\n    ESpread(e) => collect_expr(e, acc)\n  }\n}\n\nfn collect_exprs(items: Array[Expr], acc: Array[IdentHit]) -> Unit {\n  let mut i = 0\n  while i < Array::length(items) {\n    collect_expr(Array::get(items, i), acc)\n    i = i + 1\n  }\n}\n\nfn collect_field_exprs(fields: Array[(String, Expr)], acc: Array[IdentHit]) -> Unit {\n  let mut i = 0\n  while i < Array::length(fields) {\n    let (_, v) = Array::get(fields, i)\n    collect_expr(v, acc)\n    i = i + 1\n  }\n}\n\nfn collect_arm_exprs(arms: Array[(Pat, Expr)], acc: Array[IdentHit]) -> Unit {\n  let mut i = 0\n  while i < Array::length(arms) {\n    let (_, e) = Array::get(arms, i)\n    collect_expr(e, acc)\n    i = i + 1\n  }\n}\n\nfn collect_loop_param_exprs(params: Array[(String, Expr)], acc: Array[IdentHit]) -> Unit {\n  let mut i = 0\n  while i < Array::length(params) {\n    let (_, init) = Array::get(params, i)\n    collect_expr(init, acc)\n    i = i + 1\n  }\n}\n\nfn collect_stmt(stmt: Stmt, acc: Array[IdentHit]) -> Unit {\n  match stmt {\n    SLet(_, _, _, _, body) => collect_expr(body, acc),\n    SLetMut(_, _, body) => collect_expr(body, acc),\n    STest(_, body) => collect_expr(body, acc),\n    SBench(_, body) => collect_expr(body, acc),\n    SExpr(e) => collect_expr(e, acc),\n    SLetPat(_, body) => collect_expr(body, acc),\n    SModule(_, _, body) => collect_stmts(body, acc),\n    _ => ()\n  }\n}\n\nfn collect_stmts(stmts: Array[Stmt], acc: Array[IdentHit]) -> Unit {\n  let mut i = 0\n  while i < Array::length(stmts) {\n    collect_stmt(Array::get(stmts, i), acc)\n    i = i + 1\n  }\n}\n\nfn is_boundary_at(source: String, off: Int) -> Bool {\n  if off < 0 || off >= String::length(source) {\n    true\n  } else {\n    let c = String::char_code_at(source, off)\n    let is_id = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_'\n    !is_id\n  }\n}\n\nfn push_binding_name_hit(source: String, start: Int, end: Int, name: String, acc: Array[IdentHit]) -> Unit {\n  let nlen = String::length(name)\n  if nlen == 0 {\n    ()\n  } else {\n    let limit = if end > String::length(source) {\n      String::length(source)\n    } else {\n      end\n    }\n    let mut i = if start < 0 {\n      0\n    } else {\n      start\n    }\n    let mut found = false\n    while !found && i + nlen <= limit {\n      if String::substring(source, i, i + nlen) == name && is_boundary_at(source, i - 1) && is_boundary_at(source, i + nlen) {\n        Array::push(acc, IdentHit(name, i))\n        found = true\n      } else {\n        i = i + 1\n      }\n    }\n  }\n}\n\nfn collect_binding_name_hits(stmts: Array[Stmt], span_start: Array[Int], span_end: Array[Int], source: String, acc: Array[IdentHit]) -> Unit {\n  let mut i = 0\n  while i < Array::length(stmts) {\n    let start = if i < Array::length(span_start) {\n      Array::get(span_start, i)\n    } else {\n      0\n    }\n    let end = if i < Array::length(span_end) {\n      Array::get(span_end, i)\n    } else {\n      String::length(source)\n    }\n    match Array::get(stmts, i) {\n      SLet(_, _, name, _, _) => push_binding_name_hit(source, start, end, name, acc),\n      SLetMut(name, _, _) => push_binding_name_hit(source, start, end, name, acc),\n      _ => ()\n    }\n    i = i + 1\n  }\n}\n\nfn pick_ident_at(hits: Array[IdentHit], tgt: Int) -> String {\n  let mut best_name = \"\"\n  let mut best_off = -1\n  let mut i = 0\n  while i < Array::length(hits) {\n    match Array::get(hits, i) {\n      IdentHit(name, off) => {\n        let span_end = off + String::length(name)\n        if off <= tgt && tgt < span_end && off > best_off {\n          best_name = name\n          best_off = off\n        } else {\n          ()\n        }\n      }\n    }\n    i = i + 1\n  }\n  best_name\n}\n\nfn pick_ident_off(hits: Array[IdentHit], tgt: Int) -> Int {\n  let mut best_off = -1\n  let mut i = 0\n  while i < Array::length(hits) {\n    match Array::get(hits, i) {\n      IdentHit(name, off) => {\n        let span_end = off + String::length(name)\n        if off <= tgt && tgt < span_end && off > best_off {\n          best_off = off\n        } else {\n          ()\n        }\n      }\n    }\n    i = i + 1\n  }\n  best_off\n}\n\nfn tytab_lookup(table: Array[(Int, Type)], off: Int) -> Option[Type] {\n  let mut found = None\n  let mut i = 0\n  while i < Array::length(table) {\n    let (toff, tty) = Array::get(table, i)\n    if toff == off {\n      found = Some(tty)\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  found\n}\n\nexport fn type_at_source(source: String, line: Int, col: Int) -> String {\n  handle {\n    let tgt = line_col_to_offset(source, line, col)\n    if tgt < 0 {\n      \"\"\n    } else {\n      let (tokens, starts, ends) = lex_with_offsets(source)\n      let stmts = parse_program_located(tokens, starts, source)\n      let hits = empty_hits()\n      collect_stmts(stmts, hits)\n      let (span_stmts, span_start, span_end) = parse_program_spans(tokens, starts, ends)\n      collect_binding_name_hits(span_stmts, span_start, span_end, source, hits)\n      let name = pick_ident_at(hits, tgt)\n      if name == \"\" {\n        \"\"\n      } else {\n        let chosen_off = pick_ident_off(hits, tgt)\n        let (table, final_s) = check_program_type_table(stmts)\n        let table_hit = if chosen_off >= 0 {\n          tytab_lookup(table, chosen_off)\n        } else {\n          None\n        }\n        match table_hit {\n          Some(rec_ty) => type_to_string(subst_apply(final_s, rec_ty)),\n          None => {\n            let env = check_program(stmts)\n            match env_lookup(env, name) {\n              Some(t) => type_to_string(t),\n              None => \"\"\n            }\n          }\n        }\n      }\n    }\n  } with Error {\n    Throw(_) => \"\"\n  }\n}\n")
}

let source_167 = () -> (String, String) {
  ("lib/@vibe/compiler/runtime/binding_at.vibe",
"\n\nimport @vibe/compiler/core {\n  Expr, Pat, Stmt\n}\n\nimport @vibe/core {\n  array_empty\n}\n\nimport @vibe/compiler/syntax {\n  lex_with_offsets, parse_program_located\n}\n\n\nfn bind_line_col_to_offset(source: String, line: Int, col: Int) -> Int {\n  if line < 1 || col < 1 {\n    -1\n  } else {\n    let len = String::length(source)\n    let mut i = 0\n    let mut cur_line = 1\n    while cur_line < line && i < len {\n      if String::char_code_at(source, i) == 10 {\n        cur_line = cur_line + 1\n      } else {\n        ()\n      }\n      i = i + 1\n    }\n    if cur_line < line {\n      -1\n    } else {\n      let mut line_end = i\n      while line_end < len && String::char_code_at(source, line_end) != 10 {\n        line_end = line_end + 1\n      }\n      let content_end = if line_end > i && String::char_code_at(source, line_end - 1) == 13 {\n        line_end - 1\n      } else {\n        line_end\n      }\n      let off = i + (col - 1)\n      if off > content_end {\n        -1\n      } else {\n        off\n      }\n    }\n  }\n}\n\nenum BindHit {\n  BindHit(String, Int, Int)\n}\n\nfn bind_empty_hits() -> Array[BindHit] {\n  array_empty()\n}\n\nfn bind_is_boundary_at(source: String, off: Int) -> Bool {\n  if off < 0 || off >= String::length(source) {\n    true\n  } else {\n    let c = String::char_code_at(source, off)\n    let is_id = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_'\n    !is_id\n  }\n}\n\nfn bind_find_word(source: String, name: String, from: Int) -> Int {\n  let nlen = String::length(name)\n  if nlen == 0 {\n    -1\n  } else {\n    let limit = String::length(source)\n    let mut i = if from < 0 {\n      0\n    } else {\n      from\n    }\n    let mut found = -1\n    while found < 0 && i + nlen <= limit {\n      if String::substring(source, i, i + nlen) == name && bind_is_boundary_at(source, i - 1) && bind_is_boundary_at(source, i + nlen) {\n        found = i\n      } else {\n        i = i + 1\n      }\n    }\n    found\n  }\n}\n\nstruct BindState {\n  hits: Array[BindHit];\n  scope_names: Array[String];\n  scope_ids: Array[Int];\n  floor: Array[Int];\n  source: String\n}\n\nfn bind_box_int(v: Int) -> Array[Int] {\n  let arr = array_empty()\n  Array::push(arr, v)\n  arr\n}\n\nfn bind_new_state(source: String) -> BindState {\n  BindState::{\n    hits: bind_empty_hits(),\n    scope_names: array_empty(),\n    scope_ids: array_empty(),\n    floor: bind_box_int(0),\n    source: source\n  }\n}\n\nfn bind_resolve(st: BindState, name: String) -> Int {\n  let n = Array::length(st.scope_names)\n  let mut i = n - 1\n  let mut found = 0\n  while i >= 0 && found == 0 {\n    if Array::get(st.scope_names, i) == name {\n      found = Array::get(st.scope_ids, i)\n    } else {\n      ()\n    }\n    i = i - 1\n  }\n  found\n}\n\nfn bind_pop_scope(st: BindState, mark: Int) -> Unit {\n  Array::truncate(st.scope_names, mark)\n  Array::truncate(st.scope_ids, mark)\n}\n\nfn bind_recover_binder(st: BindState, name: String) -> Int {\n  let from = Array::get(st.floor, 0)\n  let off = bind_find_word(st.source, name, from)\n  let id = if off >= 0 {\n    off + 1\n  } else {\n    0\n  }\n  if off >= 0 {\n    Array::push(st.hits, BindHit(name, off, id))\n    Array::set(st.floor, 0, off + String::length(name))\n  } else {\n    ()\n  }\n  id\n}\n\nfn bind_push_binder(st: BindState, name: String, id: Int) -> Unit {\n  Array::push(st.scope_names, name)\n  Array::push(st.scope_ids, id)\n}\n\nfn bind_introduce(st: BindState, name: String) -> Unit {\n  let id = bind_recover_binder(st, name)\n  bind_push_binder(st, name, id)\n}\n\nfn bind_record_ref(st: BindState, name: String, off: Int) -> Unit {\n  if off >= 0 {\n    let key = bind_resolve(st, name)\n    Array::push(st.hits, BindHit(name, off, key))\n    if off >= Array::get(st.floor, 0) {\n      Array::set(st.floor, 0, off + String::length(name))\n    } else {\n      ()\n    }\n  } else {\n    ()\n  }\n}\n\nfn bind_record_assign_target(st: BindState, name: String) -> Unit {\n  let key = bind_resolve(st, name)\n  let from = Array::get(st.floor, 0)\n  let off = bind_find_word(st.source, name, from)\n  if off >= 0 {\n    Array::push(st.hits, BindHit(name, off, key))\n    Array::set(st.floor, 0, off + String::length(name))\n  } else {\n    ()\n  }\n}\n\nfn bind_introduce_pat(st: BindState, pat: Pat) -> Unit {\n  match pat {\n    PWild => (),\n    PBind(name) => bind_introduce(st, name),\n    PInt(_) => (),\n    PFloat(_) => (),\n    PString(_) => (),\n    PBool(_) => (),\n    PCtor(_, sub) => bind_introduce_pats(st, sub),\n    PTuple(sub) => bind_introduce_pats(st, sub),\n    POr(a, b) => {\n      bind_introduce_pat(st, a)\n      bind_introduce_pat(st, b)\n    },\n    PStruct(_, fields) => {\n      let mut i = 0\n      while i < Array::length(fields) {\n        let (_, fp) = Array::get(fields, i)\n        bind_introduce_pat(st, fp)\n        i = i + 1\n      }\n    }\n  }\n}\n\nfn bind_introduce_pats(st: BindState, sub: Array[Pat]) -> Unit {\n  let mut i = 0\n  while i < Array::length(sub) {\n    bind_introduce_pat(st, Array::get(sub, i))\n    i = i + 1\n  }\n}\n\nfn bind_walk_expr(st: BindState, expr: Expr) -> Unit {\n  match expr {\n    EInt(_) => (),\n    EFloat(_) => (),\n    EString(_) => (),\n    EBool(_) => (),\n    EIdent(name, off) => bind_record_ref(st, name, off),\n    EUnit => (),\n    EStringInterp(_) => (),\n    ETuple(items) => bind_walk_exprs(st, items),\n    EArray(items) => bind_walk_exprs(st, items),\n    ERecord(_, fields, _) => bind_walk_field_exprs(st, fields),\n    EIf(c, t, e) => {\n      bind_walk_expr(st, c)\n      bind_walk_expr(st, t)\n      bind_walk_expr(st, e)\n    },\n    ELet(name, v, b, _) => {\n      let id = bind_recover_binder(st, name)\n      bind_walk_expr(st, v)\n      let mark = Array::length(st.scope_names)\n      bind_push_binder(st, name, id)\n      bind_walk_expr(st, b)\n      bind_pop_scope(st, mark)\n    },\n    ELetRec(name, v, b) => {\n      let mark = Array::length(st.scope_names)\n      bind_introduce(st, name)\n      bind_walk_expr(st, v)\n      bind_walk_expr(st, b)\n      bind_pop_scope(st, mark)\n    },\n    ELetMut(name, v, b, _) => {\n      let id = bind_recover_binder(st, name)\n      bind_walk_expr(st, v)\n      let mark = Array::length(st.scope_names)\n      bind_push_binder(st, name, id)\n      bind_walk_expr(st, b)\n      bind_pop_scope(st, mark)\n    },\n    EAssign(name, v, b) => {\n      bind_record_assign_target(st, name)\n      bind_walk_expr(st, v)\n      bind_walk_expr(st, b)\n    },\n    EAssignOp(name, _, v, b) => {\n      bind_record_assign_target(st, name)\n      bind_walk_expr(st, v)\n      bind_walk_expr(st, b)\n    },\n    ESeq(a, b) => {\n      bind_walk_expr(st, a)\n      bind_walk_expr(st, b)\n    },\n    EMatch(s, arms) => {\n      bind_walk_expr(st, s)\n      bind_walk_arms(st, arms)\n    },\n    EHandle(s, arms) => {\n      bind_walk_expr(st, s)\n      bind_walk_arms(st, arms)\n    },\n    EWhile(c, b) => {\n      bind_walk_expr(st, c)\n      bind_walk_expr(st, b)\n    },\n    ELoop(params, b) => {\n      let mark = Array::length(st.scope_names)\n      let mut i = 0\n      while i < Array::length(params) {\n        let (pname, init) = Array::get(params, i)\n        bind_walk_expr(st, init)\n        bind_introduce(st, pname)\n        i = i + 1\n      }\n      bind_walk_expr(st, b)\n      bind_pop_scope(st, mark)\n    },\n    EForIn(name, idx_opt, it, b) => {\n      bind_walk_expr(st, it)\n      let mark = Array::length(st.scope_names)\n      bind_introduce(st, name)\n      match idx_opt {\n        Some(idx) => bind_introduce(st, idx),\n        None => ()\n      }\n      bind_walk_expr(st, b)\n      bind_pop_scope(st, mark)\n    },\n    ECall(callee, args, _) => {\n      bind_walk_expr(st, callee)\n      bind_walk_exprs(st, args)\n    },\n    EBinOp(_, l, r) => {\n      bind_walk_expr(st, l)\n      bind_walk_expr(st, r)\n    },\n    EUnaryOp(_, e) => bind_walk_expr(st, e),\n    EFn(_, _, params, _, _, body) => {\n      let mark = Array::length(st.scope_names)\n      let mut i = 0\n      while i < Array::length(params) {\n        let (pname, _) = Array::get(params, i)\n        bind_introduce(st, pname)\n        i = i + 1\n      }\n      bind_walk_expr(st, body)\n      bind_pop_scope(st, mark)\n    },\n    EDot(e, _, _, _) => bind_walk_expr(st, e),\n    ELabeledArg(_, _, v) => bind_walk_expr(st, v),\n    EReturn(e) => bind_walk_expr(st, e),\n    EBreak(opt) => match opt {\n      Some(v) => bind_walk_expr(st, v),\n      None => ()\n    },\n    EContinue(args) => bind_walk_exprs(st, args),\n    EMap(fields) => bind_walk_field_exprs(st, fields),\n    ESpread(e) => bind_walk_expr(st, e)\n  }\n}\n\nfn bind_walk_exprs(st: BindState, items: Array[Expr]) -> Unit {\n  let mut i = 0\n  while i < Array::length(items) {\n    bind_walk_expr(st, Array::get(items, i))\n    i = i + 1\n  }\n}\n\nfn bind_walk_field_exprs(st: BindState, fields: Array[(String, Expr)]) -> Unit {\n  let mut i = 0\n  while i < Array::length(fields) {\n    let (_, v) = Array::get(fields, i)\n    bind_walk_expr(st, v)\n    i = i + 1\n  }\n}\n\nfn bind_walk_arms(st: BindState, arms: Array[(Pat, Expr)]) -> Unit {\n  let mut i = 0\n  while i < Array::length(arms) {\n    let (pat, e) = Array::get(arms, i)\n    let mark = Array::length(st.scope_names)\n    bind_introduce_pat(st, pat)\n    bind_walk_expr(st, e)\n    bind_pop_scope(st, mark)\n    i = i + 1\n  }\n}\n\nfn bind_record_module_binder(st: BindState, name: String) -> Unit {\n  let from = Array::get(st.floor, 0)\n  let off = bind_find_word(st.source, name, from)\n  if off >= 0 {\n    Array::push(st.hits, BindHit(name, off, 0))\n    Array::set(st.floor, 0, off + String::length(name))\n  } else {\n    ()\n  }\n}\n\nfn bind_walk_stmt(st: BindState, stmt: Stmt) -> Unit {\n  match stmt {\n    SLet(_, _, name, _, body) => {\n      bind_record_module_binder(st, name)\n      bind_walk_expr(st, body)\n    },\n    SLetMut(name, _, body) => {\n      bind_record_module_binder(st, name)\n      bind_walk_expr(st, body)\n    },\n    STest(_, body) => bind_walk_expr(st, body),\n    SBench(_, body) => bind_walk_expr(st, body),\n    SExpr(e) => bind_walk_expr(st, e),\n    SLetPat(_, body) => bind_walk_expr(st, body),\n    SModule(_, _, body) => bind_walk_stmts(st, body),\n    _ => ()\n  }\n}\n\nfn bind_walk_stmts(st: BindState, stmts: Array[Stmt]) -> Unit {\n  let mut i = 0\n  while i < Array::length(stmts) {\n    bind_walk_stmt(st, Array::get(stmts, i))\n    i = i + 1\n  }\n}\n\nfn bind_pick_at(hits: Array[BindHit], tgt: Int) -> (String, Int) {\n  let mut best_name = \"\"\n  let mut best_key = 0\n  let mut best_off = -1\n  let mut i = 0\n  while i < Array::length(hits) {\n    match Array::get(hits, i) {\n      BindHit(name, off, key) => {\n        let span_end = off + String::length(name)\n        if off >= 0 && off <= tgt && tgt < span_end && off > best_off {\n          best_name = name\n          best_key = key\n          best_off = off\n        } else {\n          ()\n        }\n      }\n    }\n    i = i + 1\n  }\n  (best_name, best_key)\n}\n\nfn bind_insert_sorted_unique(out: Array[(Int, Int)], start: Int, end: Int) -> Unit {\n  let n = Array::length(out)\n  let mut dup = false\n  let mut idx = n\n  let mut j = 0\n  while j < n {\n    let (s, _) = Array::get(out, j)\n    if s == start {\n      dup = true\n    } else {\n      ()\n    }\n    if s > start && idx == n {\n      idx = j\n    } else {\n      ()\n    }\n    j = j + 1\n  }\n  if dup {\n    ()\n  } else if idx == n {\n    Array::push(out, (start, end))\n  } else {\n    Array::push(out, Array::get(out, n - 1))\n    let mut k = n - 1\n    while k > idx {\n      Array::set(out, k, Array::get(out, k - 1))\n      k = k - 1\n    }\n    Array::set(out, idx, (start, end))\n  }\n}\n\nfn binding_occurrences_impl(source: String, line: Int, col: Int) -> Array[(Int, Int)] with { Error } {\n  {\n    let tgt = bind_line_col_to_offset(source, line, col)\n    let empty_out = array_empty()\n    if tgt < 0 {\n      empty_out\n    } else {\n      let (tokens, starts, _ends) = lex_with_offsets(source)\n      let stmts = parse_program_located(tokens, starts, source)\n      let st = bind_new_state(source)\n      bind_walk_stmts(st, stmts)\n      let hits = st.hits\n      let (name, key) = bind_pick_at(hits, tgt)\n      let out = array_empty()\n      if name == \"\" {\n        out\n      } else {\n        let mut i = 0\n        while i < Array::length(hits) {\n          match Array::get(hits, i) {\n            BindHit(hname, hoff, hkey) => {\n              if hname == name && hkey == key && hoff >= 0 {\n                bind_insert_sorted_unique(out, hoff, hoff + String::length(hname))\n              } else {\n                ()\n              }\n            }\n          }\n          i = i + 1\n        }\n        out\n      }\n    }\n  }\n}\n\nexport fn binding_occurrences(source: String, line: Int, col: Int) -> Array[(Int, Int)] {\n  handle {\n    binding_occurrences_impl(source, line, col)\n  } with Error {\n    Throw(_) => array_empty()\n  }\n}\n")
}

let source_168 = () -> (String, String) {
  ("lib/@vibe/compiler/runtime/doc_at.vibe",
"\n\nimport @vibe/compiler/syntax {\n  collect_doc_comments, offset_to_line_col\n}\n\n\n\nfn doc_lookup(docs: Array[(Int, String)], line: Int) -> String {\n  let mut i = 0\n  let mut found = \"\"\n  while i < Array::length(docs) {\n    let (doc_line, text) = Array::get(docs, i)\n    if doc_line == line {\n      found = text\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  found\n}\n\nexport fn doc_at_source(source: String, line: Int, col: Int) -> String {\n  let occ = binding_occurrences(source, line, col)\n  if Array::length(occ) == 0 {\n    \"\"\n  } else {\n    let (def_off, _def_end) = Array::get(occ, 0)\n    let (def_line, _def_col) = offset_to_line_col(source, def_off)\n    let docs = collect_doc_comments(source)\n    doc_lookup(docs, def_line)\n  }\n}\n")
}

let source_169 = () -> (String, String) {
  ("lib/@vibe/compiler/runtime/symbol_spans.vibe",
"\n\nimport @vibe/compiler/core {\n  Expr, Stmt\n}\n\nimport @vibe/core {\n  array_empty\n}\n\nimport @vibe/compiler/syntax {\n  lex_with_offsets, parse_program_spans\n}\n\n\nfn sym_is_boundary_at(source: String, off: Int) -> Bool {\n  if off < 0 || off >= String::length(source) {\n    true\n  } else {\n    let c = String::char_code_at(source, off)\n    let is_id = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_'\n    !is_id\n  }\n}\n\nfn sym_box_int(v: Int) -> Array[Int] {\n  let arr = array_empty()\n  Array::push(arr, v)\n  arr\n}\n\nfn sym_empty_items() -> Array[(String, Int, Int, Int)] {\n  array_empty()\n}\n\nfn sym_emit(out: Array[(String, Int, Int, Int)], source: String, name: String, kind: Int, floor: Array[Int], hi: Int) -> Unit {\n  let nlen = String::length(name)\n  if nlen == 0 {\n    ()\n  } else {\n    let limit = if hi > String::length(source) {\n      String::length(source)\n    } else {\n      hi\n    }\n    let mut i = Array::get(floor, 0)\n    if i < 0 {\n      i = 0\n    } else {\n      ()\n    }\n    let mut found = false\n    while !found && i + nlen <= limit {\n      if String::substring(source, i, i + nlen) == name && sym_is_boundary_at(source, i - 1) && sym_is_boundary_at(source, i + nlen) {\n        Array::push(out, (name, kind, i, i + nlen))\n        Array::set(floor, 0, i + nlen)\n        found = true\n      } else {\n        i = i + 1\n      }\n    }\n  }\n}\n\nfn sym_let_kind(body: Expr) -> Int {\n  match body {\n    EFn(_, _, _, _, _, _) => 12,\n    _ => 13\n  }\n}\n\nfn sym_walk_stmt(out: Array[(String, Int, Int, Int)], source: String, stmt: Stmt, floor: Array[Int], hi: Int) -> Unit {\n  match stmt {\n    SLet(_, _, name, _, body) => sym_emit(out, source, name, sym_let_kind(body), floor, hi),\n    SLetMut(name, _, _) => sym_emit(out, source, name, 13, floor, hi),\n    SEnum(_, name, _, _, _) => sym_emit(out, source, name, 10, floor, hi),\n    SSuberror(_, name, _) => sym_emit(out, source, name, 10, floor, hi),\n    SStruct(_, name, _, _, _, _) => sym_emit(out, source, name, 23, floor, hi),\n    STypeAlias(_, name, _, _) => sym_emit(out, source, name, 26, floor, hi),\n    STrait(_, name, _, _, _, _) => sym_emit(out, source, name, 11, floor, hi),\n    SEffectDef(_, name, _, _) => sym_emit(out, source, name, 24, floor, hi),\n    SModule(_, name, body) => {\n      sym_emit(out, source, name, 2, floor, hi)\n      let mut j = 0\n      while j < Array::length(body) {\n        sym_walk_stmt(out, source, Array::get(body, j), floor, hi)\n        j = j + 1\n      }\n    },\n    _ => ()\n  }\n}\n\nfn symbol_spans_impl(source: String) -> Array[(String, Int, Int, Int)] with { Error } {\n  {\n    let (tokens, starts, ends) = lex_with_offsets(source)\n    let (span_stmts, span_start, span_end) = parse_program_spans(tokens, starts, ends)\n    let out = sym_empty_items()\n    let mut i = 0\n    while i < Array::length(span_stmts) {\n      let lo = if i < Array::length(span_start) {\n        Array::get(span_start, i)\n      } else {\n        0\n      }\n      let hi = if i < Array::length(span_end) {\n        Array::get(span_end, i)\n      } else {\n        String::length(source)\n      }\n      let floor = sym_box_int(lo)\n      sym_walk_stmt(out, source, Array::get(span_stmts, i), floor, hi)\n      i = i + 1\n    }\n    out\n  }\n}\n\nexport fn symbol_spans(source: String) -> Array[(String, Int, Int, Int)] with { Error } {\n  symbol_spans_impl(source)\n}\n")
}

let source_170 = () -> (String, String) {
  ("lib/@vibe/compiler/runtime/persistent_env_codec.vibe",
"\nimport @vibe/compiler/cache {\n  compact_string_fingerprint,\n  normalize_persistent_cache_text,\n  package_index_deps_are_current,\n  persistent_dep_list_cache_path,\n  persistent_leaf_fingerprint_cache_path,\n  persistent_type_env_cache_path\n}\n\nimport @vibe/core {\n  array_empty\n}\n\nimport @vibe/compiler/core {\n  Type, TypeEnv, env_flat_bindings\n}\n\n\nfn parse_int_unwrap(raw: String, fallback: Int) -> Int {\n  let len = String::length(raw)\n  let mut result = 0\n  let mut i = 0\n  let mut neg = false\n  let mut valid = true\n  if len == 0 {\n    valid = false\n  }\n  if valid {\n    if String::char_code_at(raw, 0) == 45 {\n      neg = true; i = 1\n    }\n  }\n  while valid {\n    if i >= len {\n      break\n    }\n    let c = String::char_code_at(raw, i)\n    if c < 48 {\n      valid = false\n    }\n    else if c > 57 {\n      valid = false\n    }\n    else {\n      result = result * 10 + (c - 48)\n      i = i + 1\n    }\n  }\n  if valid {\n    if neg {\n      0 - result\n    } else result\n  } else fallback\n}\n\nfn serialize_segment(text: String) -> String {\n  let len = String::length(text)\n  let len_str = __to_string(len)\n  let colon_text = String::concat(\":\", text)\n  String::concat(len_str, colon_text)\n}\n\nfn decode_effect_name(raw: String) -> String {\n  if raw == \"\" || raw == \"0\" {\n    \"\"\n  } else if raw == \"1\" {\n    \"Error\"\n  } else {\n    raw\n  }\n}\n\nfn parse_count_header(text: String, pos: Int, terminator: Int) -> (Int, Int) with { Error } {\n  let len = String::length(text)\n  let mut i = pos\n  while i < len && String::char_code_at(text, i) != terminator {\n    i = i + 1\n  }\n  if i >= len {\n    throw(\"invalid persistent type env payload\")\n  } else {\n    let parsed = parse_int_unwrap(text[pos: i], 0)\n    (parsed, i + 1)\n  }\n}\n\nfn parse_segment(text: String, pos: Int) -> (String, Int) with { Error } {\n  let (seg_len, start) = parse_count_header(text, pos, 58)\n  let end = start + seg_len\n  if end > String::length(text) {\n    throw(\"invalid persistent type env segment\")\n  } else {\n    (text[start: end], end)\n  }\n}\n\nfn parse_int_array(text: String, pos: Int) -> (Array[Int], Int) with { Error } {\n  let (count, start) = parse_count_header(text, pos, 91)\n  let items = array_empty()\n  let mut i = 0\n  let mut cursor = start\n  while i < count {\n    let (raw, next_cursor) = parse_segment(text, cursor)\n    let parsed_val = parse_int_unwrap(raw, 0)\n    Array::push(items, parsed_val)\n    cursor = next_cursor\n    i = i + 1\n  }\n  if cursor >= String::length(text) || String::char_code_at(text, cursor) != 93 {\n    throw(\"invalid persistent type env int array\")\n  } else {\n    (items, cursor + 1)\n  }\n}\n\nfn parse_string_array(text: String, pos: Int) -> (Array[String], Int) with { Error } {\n  let (count, start) = parse_count_header(text, pos, 91)\n  let items = array_empty()\n  let mut i = 0\n  let mut cursor = start\n  while i < count {\n    let (item, next_cursor) = parse_segment(text, cursor)\n    Array::push(items, item)\n    cursor = next_cursor\n    i = i + 1\n  }\n  if cursor >= String::length(text) || String::char_code_at(text, cursor) != 93 {\n    throw(\"invalid persistent type env string array\")\n  } else {\n    (items, cursor + 1)\n  }\n}\n\nfn parse_bounds_array(text: String, pos: Int) -> (Array[(Int, Array[String])], Int) with { Error } {\n  let (count, start) = parse_count_header(text, pos, 91)\n  let items = array_empty()\n  let mut i = 0\n  let mut cursor = start\n  while i < count {\n    let (raw_id, next_cursor) = parse_segment(text, cursor)\n    let (bounds, next_cursor2) = parse_string_array(text, next_cursor)\n    let parsed_id = parse_int_unwrap(raw_id, 0)\n    Array::push(items, (parsed_id, bounds))\n    cursor = next_cursor2\n    i = i + 1\n  }\n  if cursor >= String::length(text) || String::char_code_at(text, cursor) != 93 {\n    throw(\"invalid persistent type env bounds array\")\n  } else {\n    (items, cursor + 1)\n  }\n}\n\nfn parse_cached_type(source: String, pos: Int) -> (Type, Int) with { Error } {\n  let rec parse_type_array: (String, Int) -> (Array[Type], Int) with { Error } = (text, pos) -> {\n    let (count, start) = parse_count_header(text, pos, 91)\n    let items = array_empty()\n    let mut i = 0\n    let mut cursor = start\n    while i < count {\n      let (raw, next_cursor) = parse_segment(text, cursor)\n      let (item, end_cursor) = parse_cached_type(raw, 0)\n      if end_cursor != String::length(raw) {\n        throw(\"invalid persistent type env nested type\")\n      } else {\n        Array::push(items, item)\n        cursor = next_cursor\n        i = i + 1\n      }\n    }\n    if cursor >= String::length(text) || String::char_code_at(text, cursor) != 93 {\n      throw(\"invalid persistent type env type array\")\n    } else {\n      (items, cursor + 1)\n    }\n  }\n  if pos >= String::length(source) {\n    throw(\"invalid persistent type env type\")\n  } else {\n    let tag = String::char_code_at(source, pos)\n    match tag {\n      73 => (CtInt, pos + 1),\n      68 => (CtDouble, pos + 1),\n      66 => (CtBool, pos + 1),\n      71 => (CtString, pos + 1),\n      72 => (CtChar, pos + 1),\n      85 => (CtUnit, pos + 1),\n      89 => (CtBytes, pos + 1),\n      88 => (CtUnknown, pos + 1),\n      86 => {\n        let (raw, next_pos) = parse_segment(source, pos + 1)\n        let var_id = parse_int_unwrap(raw, 0)\n        (CtVar(var_id), next_pos)\n      },\n      69 => {\n        let (name, next_pos) = parse_segment(source, pos + 1)\n        (CtEnum(name), next_pos)\n      },\n      82 => {\n        let (name, next_pos) = parse_segment(source, pos + 1)\n        (CtStruct(name), next_pos)\n      },\n      65 => {\n        let (elem, next_pos) = parse_cached_type(source, pos + 1)\n        (CtArray(elem), next_pos)\n      },\n      79 => {\n        let (elem, next_pos) = parse_cached_type(source, pos + 1)\n        (CtOption(elem), next_pos)\n      },\n      84 => {\n        let (elems, next_pos) = parse_type_array(source, pos + 1)\n        (CtTuple(elems), next_pos)\n      },\n      70 => {\n        let (raw_effect, next_pos1) = parse_segment(source, pos + 1)\n        let (params, next_pos2) = parse_type_array(source, next_pos1)\n        let (ret, next_pos3) = parse_cached_type(source, next_pos2)\n        let eff_raw = decode_effect_name(raw_effect)\n        let eff_name = if String::length(eff_raw) > 0 {\n          Some(eff_raw)\n        } else {\n          None\n        }\n        (CtFn(params, ret, eff_name), next_pos3)\n      },\n      78 => {\n        let (name, next_pos1) = parse_segment(source, pos + 1)\n        let (args, next_pos2) = parse_type_array(source, next_pos1)\n        (CtNamed(name, args), next_pos2)\n      },\n      81 => {\n        let (vars, next_pos1) = parse_int_array(source, pos + 1)\n        let (bounds, next_pos2) = parse_bounds_array(source, next_pos1)\n        let (body, next_pos3) = parse_cached_type(source, next_pos2)\n        (CtForAll(vars, bounds, body), next_pos3)\n      },\n      _ => throw(\"invalid persistent type env type tag\")\n    }\n  }\n}\n\nfn serialize_int_array(items: Array[Int]) -> String {\n  let buf = StringBuilder::new()\n  StringBuilder::push(buf, __to_string(Array::length(items)))\n  StringBuilder::push(buf, \"[\")\n  let mut i = 0\n  while i < Array::length(items) {\n    StringBuilder::push(buf, serialize_segment(__to_string(Array::get(items, i))))\n    i = i + 1\n  }\n  StringBuilder::push(buf, \"]\")\n  StringBuilder::freeze(buf)\n}\n\nfn serialize_effect_name_str(effect_name: String) -> String {\n  effect_name\n}\n\nfn serialize_string_array(items: Array[String]) -> String {\n  let buf = StringBuilder::new()\n  StringBuilder::push(buf, __to_string(Array::length(items)))\n  StringBuilder::push(buf, \"[\")\n  let mut i = 0\n  while i < Array::length(items) {\n    StringBuilder::push(buf, serialize_segment(Array::get(items, i)))\n    i = i + 1\n  }\n  StringBuilder::push(buf, \"]\")\n  StringBuilder::freeze(buf)\n}\n\nfn serialize_bounds_array(items: Array[(Int, Array[String])]) -> String {\n  let buf = StringBuilder::new()\n  StringBuilder::push(buf, __to_string(Array::length(items)))\n  StringBuilder::push(buf, \"[\")\n  let mut i = 0\n  while i < Array::length(items) {\n    let (id, bounds) = Array::get(items, i)\n    StringBuilder::push(buf, serialize_segment(__to_string(id)))\n    StringBuilder::push(buf, serialize_string_array(bounds))\n    i = i + 1\n  }\n  StringBuilder::push(buf, \"]\")\n  StringBuilder::freeze(buf)\n}\n\nfn serialize_type(ty: Type) -> String {\n  let rec serialize_type_array: (Array[Type]) -> String = (items) -> {\n    let buf = StringBuilder::new()\n    StringBuilder::push(buf, __to_string(Array::length(items)))\n    StringBuilder::push(buf, \"[\")\n    let mut i = 0\n    while i < Array::length(items) {\n      StringBuilder::push(buf, serialize_segment(serialize_type(Array::get(items, i))))\n      i = i + 1\n    }\n    StringBuilder::push(buf, \"]\")\n    StringBuilder::freeze(buf)\n  }\n  match ty {\n    CtInt => \"I\",\n    CtDouble => \"D\",\n    CtBool => \"B\",\n    CtString => \"G\",\n    CtChar => \"H\",\n    CtUnit => \"U\",\n    CtBytes => \"Y\",\n    CtUnknown => \"X\",\n    CtVar(id) => String::concat(\"V\", serialize_segment(__to_string(id))),\n    CtEnum(name) => String::concat(\"E\", serialize_segment(name)),\n    CtStruct(name) => String::concat(\"R\", serialize_segment(name)),\n    CtArray(elem) => String::concat(\"A\", serialize_type(elem)),\n    CtOption(elem) => String::concat(\"O\", serialize_type(elem)),\n    CtTuple(elems) => String::concat(\"T\", serialize_type_array(elems)),\n    CtFn(params, ret, effect_name) => {\n      let eff_str = if effect_name is Some(n) {\n        n\n      } else {\n        \"\"\n      }\n      String::concat(\"F\", String::concat(serialize_segment(eff_str), String::concat(serialize_type_array(params), serialize_type(ret))))\n    },\n    CtNamed(name, args) =>\n    String::concat(\"N\", String::concat(serialize_segment(name), serialize_type_array(args))),\n    CtForAll(vars, bounds, body) =>\n    String::concat(\"Q\", String::concat(serialize_int_array(vars), String::concat(serialize_bounds_array(bounds), serialize_type(body))))\n  }\n}\n\nexport fn persistent_dep_list_text(deps: Array[String]) -> String {\n  if Array::length(deps) == 0 {\n    \"\"\n  } else if Array::length(deps) == 1 {\n    String::concat(\"version\\t3\\n\", Array::get(deps, 0))\n  } else {\n    String::concat(\"version\\t2\\n\", serialize_string_array(deps))\n  }\n}\n\nexport fn load_persistent_dep_list(path: String, source: String) -> Option[Array[String]] with { Error, Fs } {\n  let cache_path = persistent_dep_list_cache_path(path, compact_string_fingerprint(source))\n  if !(Fs::exists(cache_path)) {\n    None\n  } else {\n    let text = normalize_persistent_cache_text(Fs::read_file(cache_path))\n    if String::length(text) == 0 {\n      Some(array_empty())\n    } else {\n      let v2_prefix = \"version\\t2\\n\"\n      let v3_prefix = \"version\\t3\\n\"\n      let text_len = String::length(text)\n      let v2_len = String::length(v2_prefix)\n      let v3_len = String::length(v3_prefix)\n      if text_len >= v2_len &&\n      text[0: v2_len] == v2_prefix {\n        let body = text[v2_len: text_len]\n        let (deps, end_pos) = parse_string_array(body, 0)\n        if end_pos == String::length(body) {\n          if package_index_deps_are_current(deps) {\n            Some(deps)\n          } else {\n            None\n          }\n        } else {\n          throw(String::concat(\"invalid persistent dep list body: \", cache_path))\n        }\n      } else if text_len >= v3_len &&\n      text[0: v3_len] == v3_prefix {\n        let dep = text[v3_len: text_len]\n        if String::length(dep) == 0 {\n          Some(array_empty())\n        } else {\n          if package_index_deps_are_current([\n            dep\n          ]) {\n            Some([\n              dep\n            ])\n          } else {\n            None\n          }\n        }\n      } else {\n        throw(String::concat(\"invalid persistent dep list header: \", cache_path))\n      }\n    }\n  }\n}\n\nfn rebuild_persistent_type_env(bindings: Array[(String, Type)]) -> TypeEnv {\n  EnvFlat(bindings)\n}\n\nexport fn parse_persistent_type_env(text: String) -> Option[TypeEnv] with { Error } {\n  let lines = String::split(normalize_persistent_cache_text(text), \"\\n\")\n  let len = Array::length(lines)\n  let rec go: (Int, Bool, Array[(String, Type)]) -> Option[TypeEnv] with { Error } = (index, version_ok, bindings) -> {\n    if index >= len {\n      if version_ok {\n        Some(rebuild_persistent_type_env(bindings))\n      } else {\n        None\n      }\n    } else {\n      let line = Array::get(lines, index)\n      if String::length(line) == 0 {\n        go(index + 1, version_ok, bindings)\n      } else {\n        let parts = String::split(line, \"\\t\")\n        if !version_ok {\n          if Array::length(parts) == 2 &&\n          Array::get(parts, 0) == \"version\" &&\n          Array::get(parts, 1) == \"1\" {\n            go(index + 1, true, bindings)\n          } else {\n            throw(String::concat(\"invalid persistent type env header: \", line))\n          }\n        } else if Array::length(parts) == 3 && Array::get(parts, 0) == \"bind\" {\n          let raw_type = Array::get(parts, 2)\n          let (ty, end_pos) = parse_cached_type(raw_type, 0)\n          if end_pos != String::length(raw_type) {\n            throw(String::concat(\"invalid persistent type env bind row: \", line))\n          } else {\n            Array::push(bindings, (Array::get(parts, 1), ty))\n            go(index + 1, true, bindings)\n          }\n        } else {\n          throw(String::concat(\"invalid persistent type env row: \", line))\n        }\n      }\n    }\n  }\n  go(0, false, array_empty())\n}\n\nexport fn load_persistent_type_env(fingerprint: String) -> Option[TypeEnv] with { Error, Fs } {\n  let path = persistent_type_env_cache_path(fingerprint)\n  if !(Fs::exists(path)) {\n    None\n  } else {\n    parse_persistent_type_env(Fs::read_file(path))\n  }\n}\n\nexport fn persistent_type_env_cache_text(env: TypeEnv) -> String {\n  let bindings = env_flat_bindings(env)\n  let buf = StringBuilder::new()\n  StringBuilder::push(buf, \"version\\t1\\n\")\n  let mut i = 0\n  while i < Array::length(bindings) {\n    let (name, ty) = Array::get(bindings, i)\n    StringBuilder::push(buf, \"bind\\t\")\n    StringBuilder::push(buf, name)\n    StringBuilder::push(buf, \"\\t\")\n    StringBuilder::push(buf, serialize_type(ty))\n    StringBuilder::push(buf, \"\\n\")\n    i = i + 1\n  }\n  StringBuilder::freeze(buf)\n}\n\nexport fn load_persistent_leaf_fingerprint(path: String, source: String) -> Option[String] with { Error, Fs } {\n  let cache_path = persistent_leaf_fingerprint_cache_path(path, compact_string_fingerprint(source))\n  if !(Fs::exists(cache_path)) {\n    None\n  } else {\n    let text = normalize_persistent_cache_text(Fs::read_file(cache_path))\n    let prefix = \"version\\t1\\n\"\n    if String::length(text) > String::length(prefix) &&\n    text[0: String::length(prefix)] == prefix {\n      Some(String::substring(text, String::length(prefix), String::length(text) - 1))\n    } else {\n      None\n    }\n  }\n}\n\nexport fn persistent_leaf_fingerprint_text(fingerprint: String) -> String {\n  String::concat(\"version\\t1\\n\", String::concat(fingerprint, \"\\n\"))\n}\n")
}

let source_171 = () -> (String, String) {
  ("lib/@vibe/compiler/runtime/module_source.vibe",
"\nimport @vibe/compiler/core {\n  Expr, Stmt, dce_keep_flags\n}\n\nimport @vibe/compiler/syntax {\n  lex_with_offsets, offset_to_line_col, parse_program_spans\n}\n\n\nexport let build_module_source_from_source: (String, String) -> String with { Error } = (source, entry_name) -> {\n  let lexed = lex_with_offsets(source)\n  let tokens = lexed.0\n  let starts = lexed.1\n  let ends = lexed.2\n  let parsed = parse_program_spans(tokens, starts, ends)\n  let stmts = parsed.0\n  let span_start = parsed.1\n  let span_end = parsed.2\n  let keep = dce_keep_flags(stmts, [\n    entry_name\n  ])\n  let buf = StringBuilder::new()\n  let mut i = 0\n  while i < Array::length(stmts) {\n    if Array::get(keep, i) {\n      let s = Array::get(span_start, i)\n      let e = Array::get(span_end, i)\n      if e > s {\n        let snippet = String::substring(source, s, e)\n        StringBuilder::push(buf, snippet)\n        let n = String::length(snippet)\n        if n == 0 || String::char_code_at(snippet, n - 1) != '\\n' {\n          StringBuilder::push(buf, \"\\n\")\n        }\n      }\n    }\n    i = i + 1\n  }\n  StringBuilder::freeze(buf)\n}\n\nexport let build_funcmap_from_source: (String) -> String with { Error } = (source) -> {\n  let lexed = lex_with_offsets(source)\n  let tokens = lexed.0\n  let starts = lexed.1\n  let ends = lexed.2\n  let parsed = parse_program_spans(tokens, starts, ends)\n  let stmts = parsed.0\n  let span_start = parsed.1\n  let buf = StringBuilder::new()\n  let mut i = 0\n  while i < Array::length(stmts) {\n    let stmt = Array::get(stmts, i)\n    let entry = match stmt {\n      SLet(_, _, name, _, expr) => match expr {\n        EFn(_, _, _, _, _, _) => {\n          let off = Array::get(span_start, i)\n          let lc = offset_to_line_col(source, off)\n          let line = lc.0\n          String::concat(name, String::concat(\"\\t\", String::concat(__to_string(line), \"\\n\")))\n        },\n        _ => \"\"\n      },\n      _ => \"\"\n    }\n    StringBuilder::push(buf, entry)\n    i = i + 1\n  }\n  StringBuilder::freeze(buf)\n}\n")
}

let source_172 = () -> (String, String) {
  ("lib/@vibe/compiler/runtime/index.vpkg",
"name = @vibe/compiler/runtime\nversion = 0.0.1\ndescription =\n  #|@vibe/compiler/runtime — ADR-0070 / #897 compiler-internal contract,\ndeps = {\n  @vibe/compiler/cache : 0.0.1\n  @vibe/compiler/checker : 0.0.1\n  @vibe/compiler/codegen : 0.0.1\n  @vibe/compiler/core : 0.0.1\n  @vibe/compiler/loader : 0.0.1\n  @vibe/compiler/runtime/eval_loader : 0.0.1\n  @vibe/compiler/syntax : 0.0.1\n  @vibe/core : 0.2.0\n  @vibe/graph : 0.0.1\n}\n\ngenerated_hash =\n\n// @vibe/compiler/runtime — ADR-0070 / #897 compiler-internal contract,\n// compiler-internal batch 8. Directory-shared-scope package (originally 7\n// impl files, ~4275 lines; doc_at.vibe added under #854): the incremental\n// type-check database (`TypeDb` + the\n// db_new/db_set_source/db_check_env/db_typecheck*/db_merged_source/\n// db_module_source/db_load_artifact/db_store_artifact family, runtime.vibe),\n// module-source reconstruction for the debugger funcmap sidecar\n// (module_source.vibe), editor-query primitives backing `vibe type-at` /\n// `vibe binding-at` / `vibe symbols` / `vibe doc-at` (type_at.vibe,\n// binding_at.vibe, symbol_spans.vibe, doc_at.vibe), filesystem-driven\n// typecheck + diagnostics collection (typecheck_fs.vibe), and the\n// persistent dep-list / type-env / leaf-fingerprint cache codec\n// (persistent_env_codec.vibe).\n//\n// Naming: no collision on the established `git mv index.vibe <dirname>.vibe`\n// convention (runtime/runtime.vibe didn't exist), same as loader/'s batch —\n// the old index.vibe moved verbatim to runtime.vibe.\n//\n// runtime.vibe is NOT a pure facade — like loader.vibe's and\n// checker_facade.vibe's siblings, it carries substantial real implementation\n// of its own (the whole `TypeDb` incremental-cache state machine) in\n// addition to importing and re-exporting a hand-picked subset of its\n// siblings' surfaces via existing `export ./file.vibe { .. }` SReExport\n// blocks (module_source.vibe, type_at.vibe, binding_at.vibe,\n// symbol_spans.vibe, typecheck_fs.vibe — added under #847). Those blocks\n// stay untouched: this contract is now the actual source of truth for the\n// package's full export surface (all names below, across all 7 files), so\n// runtime.vibe's partial, hand-picked re-export list is no longer\n// load-bearing for outside callers — they reach every name here through\n// this contract regardless of what runtime.vibe itself re-exports, exactly\n// like checker_facade.vibe's and loader.vibe's partial lists after their\n// own batches.\n//\n// Two-level SReExport nesting wrinkle: typecheck_fs.vibe is itself a\n// substantial-impl file (933 lines: locate_type_error,\n// ensure_fingerprint_fs_impl, check_inline_wasm_fns,\n// collect_all_diagnostics) carrying its OWN `export ./persistent_env_codec.vibe\n// { .. }` SReExport block — one level deeper than loader/'s shape, where\n// only the top-level facade had the SReExport pattern, not a sibling too.\n// This turned out not to matter for the contract: `contract_sibling_impl_raws`\n// directory auto-discovery reaches persistent_env_codec.vibe directly\n// regardless of what re-exports what, so its 6 exports below are declared\n// straight from its own file grouping, exactly as if typecheck_fs.vibe's\n// SReExport didn't exist. Verified empirically via\n// scripts/unit_test_runner.sh (full run), not just assumed.\n//\n// `export let`-bound functions: module_source.vibe's two exports are\n// `export let name: (Params) -> Ret with { Error } = (params) -> { .. }`\n// bindings, not `export fn`. No other already-migrated vpkg contract had\n// this exact shape (checked via `grep -rn '^export let .*-> .* with {'`\n// across every migrated directory — no hits besides this one). Confirmed\n// this still fingerprints as an ordinary fn signature for\n// `collect_impl_fn_defs`/`check_contract`: the parser's\n// `apply_generic_fn_annotation` (lib/@vibe/parser/parser_expr.vibe) injects\n// the let annotation's declared return type and effect row into the\n// lambda's own `EFn` node when the lambda itself doesn't specify them, so\n// the contract can declare both plain `fn name(params) -> Ret with { Error }`\n// below exactly like every `export fn` — no special contract syntax needed.\n//\n// No exported types besides `TypeDb`: TypeEnv/Stmt/Type/Expr (../core) are\n// plain structural signature text here, not declared at all (checker/\n// loader/ precedent — ../core itself is not yet migrated to vpkg, out of\n// scope for this batch); RippleDb (../../../../lib/@vibe/graph) is likewise\n// left undeclared, already covered by graph's own contract. `TypeDb` itself\n// is declared `opaque`: its real definition wraps a private `TypeDbState`\n// payload (itself wrapping private `StringTriple` — neither is `export`ed\n// in runtime.vibe, so neither needs a contract entry at all), and no\n// consumer (in-repo, confirmed via repo-wide grep) ever constructs or\n// pattern-matches a `TypeDb` directly, only through db_new/db_set_source/\n// db_check_env/... — same precedent as graph.vpkg's opaque `RippleDb`.\n//\n// External-caller fixes (literal `runtime/index.vibe` /\n// `runtime/typecheck_fs.vibe` paths → bare `../runtime` / `./runtime`\n// package form, now that leaf-file imports from outside the package are\n// rejected by enforce_incoming_boundary_fs): cli_adapter.vibe,\n// cli_support.vibe (was importing check_inline_wasm_fns/locate_type_error\n// straight from typecheck_fs.vibe — neither is re-exported by runtime.vibe's\n// own facade block, but both are covered here so the package-form import\n// still resolves), entry/compiler/fs_compile/index.vibe,\n// entry/compiler/file_compile/file_compile.vibe,\n// entry/cli_cache/cli_cache.vibe. No import cycle found: none of runtime/'s\n// own dependencies (checker/, codegen/, loader/, syntax/, cache/\n// persistent_cache.vibe, ../../../../lib/@vibe/graph — all already vpkg or\n// plain leaf imports of non-vpkg directories) import back into runtime/;\n// loader/ imports `../runtime/eval_loader` (a distinct, already-migrated\n// subpackage), never this directory's own index.vpkg/runtime.vibe.\n//\n// Compiled into the compiler itself via compiler_sources_manifest.tsv\n// (group `runtime`): the old single `runtime/index.vibe` row becomes a\n// dual row (this contract + runtime/runtime.vibe); typecheck_fs.vibe,\n// type_at.vibe, binding_at.vibe, symbol_spans.vibe,\n// persistent_env_codec.vibe, module_source.vibe already had their own rows\n// and are unchanged.\n\n// --- runtime.vibe\nopaque type TypeDb\n\nfn db_new() -> TypeDb\nfn db_set_source(db: TypeDb, path: String, source: String) -> TypeDb\nfn db_check_env(db: TypeDb, path: String) -> Option[TypeEnv]\nfn db_typecheck_count(db: TypeDb) -> Int\nfn db_parse_count(db: TypeDb) -> Int\nfn db_merge_count(db: TypeDb) -> Int\nfn db_module_source_count(db: TypeDb) -> Int\nfn db_codegen_count(db: TypeDb) -> Int\nfn db_typecheck(db: TypeDb, path: String) -> TypeDb with { Error }\nfn db_typecheck_fs(db: TypeDb, path: String) -> TypeDb with { Error, Fs }\nfn db_program_source(db: TypeDb, path: String) -> (String, String, TypeDb) with { Error }\nfn db_merged_source(db: TypeDb, _entry_path: String, sources: Array[(String, String)]) -> (String, String, TypeDb) with { Error }\nfn db_grouped_merged_source(db: TypeDb, groups: Array[(String, Array[(String, String)])]) -> (String, String, TypeDb) with { Error }\nfn db_module_source(db: TypeDb, fingerprint: String, source: String) -> (String, TypeDb) with { Error }\nfn db_load_artifact(db: TypeDb, _path: String, kind: String, entry_name: String, fingerprint: String) -> Option[Bytes] with { Error }\nfn db_store_artifact(db: TypeDb, _path: String, kind: String, entry_name: String, fingerprint: String, bytes: Bytes) -> TypeDb\n\n// --- module_source.vibe\nfn build_module_source_from_source(source: String, entry_name: String) -> String with { Error }\nfn build_funcmap_from_source(source: String) -> String with { Error }\n\n// --- type_at.vibe\nfn type_at_source(source: String, line: Int, col: Int) -> String\n\n// --- binding_at.vibe\nfn binding_occurrences(source: String, line: Int, col: Int) -> Array[(Int, Int)]\n\n// --- doc_at.vibe (#854): `///` doc comment lookup, same single-file-scope\n// limitation as type_at.vibe/binding_at.vibe above.\nfn doc_at_source(source: String, line: Int, col: Int) -> String\n\n// --- symbol_spans.vibe\nfn symbol_spans(source: String) -> Array[(String, Int, Int, Int)] with { Error }\n\n// --- typecheck_fs.vibe\nfn locate_type_error(source: String, msg: String) -> String\nfn ensure_fingerprint_fs_impl(rdb: RippleDb, env_cache: Array[(String, TypeEnv)], dep_source_cache: Array[(String, String)], parse_count: Int, path: String) -> (String, RippleDb, Array[(String, TypeEnv)], Array[(String, String)], Int) with { Error, Fs }\n// #1100: memoized located lex+parse shared by the typecheck walk and the\n// merge (see typecheck_fs.vibe). Returns a fresh top-level statement array\n// on every call -- check_program mutates its argument in place.\nfn parse_program_with_path(path: String, source: String) -> Array[Stmt] with { Error }\n// #1239 step 4(D): the whole import graph, and its canonical rank order,\n// from ONE compiler process -- the host-side parallel pre-warm used to spawn\n// a VIBE_LIST_DEPS call per module to build the same DAG. Returns the\n// manifest text plus each planned module's INGESTED source, positionally in\n// the manifest's order. See typecheck_fs.vibe for the format and for why\n// both come off the same ingest step.\nfn module_plan_manifest_fs(entry_path: String) -> (String, Array[String]) with { Error, Fs }\n// #906 Phase 0: permute each node's dependency VISIT order (0 = identity,\n// the production default). Makes \"visit order cannot change the output\"\n// testable before any real parallelism exists -- see typecheck_fs.vibe.\nfn set_dep_order_seed(seed: Int) -> Unit\n// #1259 (#1239 step 5's prerequisite): collect one diagnostic per failing\n// module and raise them together in canonical order, instead of failing fast\n// on the first. Off by default -- off is byte-for-byte the previous walk.\n// See typecheck_fs.vibe for why the default stays off.\nfn set_collect_module_diagnostics(on: Bool) -> Unit\n// #1259 (#1239 step 8): record the walk's planned graph and its actual step\n// sequence to `path`, so the REAL compile path can be checked against\n// formal/VibeFormal/Compiler/Scheduler.lean instead of only a synthetic\n// worker. \"\" (the default) disables it entirely. See typecheck_fs.vibe for\n// the row format and scripts/scheduler_trace_oracle.sh for the checks.\nfn set_scheduler_trace_path(path: String) -> Unit\n// Incremental typecheck work counters and successful-check observation sidecar.\n// Disabled by default; these do not change or persist production cache keys.\nfn set_incremental_typecheck_telemetry_enabled(enabled: Bool) -> Unit\nfn set_incremental_interface_trace_enabled(enabled: Bool) -> Unit\nfn set_experimental_typing_dependency_env_reuse_enabled(enabled: Bool) -> Unit\nfn incremental_typecheck_telemetry_json() -> String\nfn incremental_invalidation_trace_json(entry_path: String, run_nonce: String) -> String with { Error, Fs }\n// #906 Phase 1: the module job / outcome seam. `check_module` is the unit a\n// Phase 2 worker will receive; it takes no `Fs` row because every\n// dependency environment it needs is already a value inside the job, and\n// the driver performs all writes (commit_module_outcome, private). These\n// are exported with no cross-file caller yet on purpose -- the bootstrap\n// flatten drops a brand-new cross-file export and its first cross-file\n// caller when they land in the same commit.\n// Defined transparently here rather than as an opaque handle (perceus/\n// PerceusAction precedent): the field layout IS the worker contract.\n// dep_envs is the driver's resolved environment table -- the doc's\n// contract is \"ordered direct-dependency interfaces\", and this is a\n// superset (the whole cache), because build_import_env resolves import\n// paths against it and narrowing changes which entry an import binds to.\n// Narrowing to the direct deps is a prerequisite for real worker\n// isolation, not for this seam.\n// `fingerprint` is deliberately NOT a field here. An earlier cut had the\n// caller supply one, which check_module simply echoed back into `Checked`\n// without ever consulting it -- a purely decorative field that made every\n// worker-computed cache key caller-chosen rather than derived, so nothing\n// a worker published could ever land at the same persistent-cache path the\n// serial walk (build_fingerprint in typecheck_fs.vibe) would look under.\n// `dep_fps` carries each dependency's OWN correctly-computed fingerprint,\n// in the same declaration order as `deps`/`dep_envs` (build_fingerprint\n// folds it as an ordered sequence, not a set), so check_module can compute\n// the canonical fingerprint itself via build_fingerprint(source, dep_fps)\n// -- an OUTPUT of the job, not an input to it.\nstruct ModuleJob {\n  path: String;\n  source: String;\n  deps: Array[String];\n  dep_fps: Array[(String, String)];\n  dep_envs: Array[(String, TypeEnv)]\n}\n// Declared opaque like graph's RippleDb / json's RpcMessage: nothing\n// outside the package inspects it yet. Phase 2's driver will need either\n// accessors or a real variant declaration here.\nopaque type ModuleOutcome\nfn check_module(job: ModuleJob) -> ModuleOutcome with { Error }\n// #906 Phase 2: the worker transport entry. `dir` is a job directory and\n// is the worker's ENTIRE filesystem sandbox -- see typecheck_fs.vibe for\n// its layout and for why the job's `path` row must be the module's logical\n// path rather than the materialized temp file.\nfn run_module_job_dir(dir: String) -> Unit with { Error, Fs }\n// #906 Phase 2 (real-build wiring): the batch counterpart to\n// run_module_job_dir. A host-side parallel pre-warm driver runs many workers\n// against private job-dir sandboxes, then makes ONE call here with a\n// directory holding `manifest.txt` (one `<fingerprint>\\t<envfile>` row per\n// successfully-checked module) plus each row's env file, verbatim from that\n// job's `env.out`. This writes each env to the REAL persistent-cache path\n// a serial compile would look under -- not the job-dir sandbox -- so the\n// driver never re-derives persistent_type_env_cache_path itself (that path\n// folds in this build's own codegen_fingerprint, which a host process has\n// no way to reproduce without risking the exact drift #906's dep_fps fix\n// closed for cache keys, applied to paths instead). Diagnosed modules are\n// simply absent from the manifest; the always-run serial fallback rechecks\n// them and produces the identical diagnostic, so correctness never depends\n// on this call succeeding.\nfn run_publish_env_cache_dir(dir: String) -> Unit with { Error, Fs }\nfn check_inline_wasm_fns(stmts: Array[Stmt]) -> Option[String]\nfn collect_all_diagnostics(source: String) -> Array[String] with { Error }\n\n// --- persistent_env_codec.vibe\nfn persistent_dep_list_text(deps: Array[String]) -> String\nfn load_persistent_dep_list(path: String, source: String) -> Option[Array[String]] with { Error, Fs }\nfn load_persistent_type_env(fingerprint: String) -> Option[TypeEnv] with { Error, Fs }\n// #906 Phase 2: the decode half of the above, split out so a dependency's\n// environment can be reconstituted from TEXT. A worker cannot look its own\n// dependencies up in the cache -- the key derives from the whole\n// transitive source snapshot -- so the driver hands them over as values.\nfn parse_persistent_type_env(text: String) -> Option[TypeEnv] with { Error }\nfn persistent_type_env_cache_text(env: TypeEnv) -> String\nfn load_persistent_leaf_fingerprint(path: String, source: String) -> Option[String] with { Error, Fs }\nfn persistent_leaf_fingerprint_text(fingerprint: String) -> String\n")
}

let source_173 = () -> (String, String) {
  ("lib/@vibe/compiler/runtime/runtime.vibe",
"\nimport @vibe/compiler/core {\n  ExportRenamePlan,\n  Stmt,\n  Type,\n  TypeEnv,\n  append_import_alias_rewritten_non_import_stmts_with_renames,\n  append_non_import_stmts_without_alias_rewrite,\n  apply_export_renames_stmts,\n  build_export_rename_plan,\n  collect_import_alias_collision_locals,\n  collect_import_alias_collision_refs,\n  collect_import_value_renames,\n  dir_of_path,\n  env_bind,\n  env_flat_bindings,\n  env_lookup_flat,\n  export_plan_fingerprint_text,\n  export_plan_renames_for,\n  import_value_rename_locals,\n  namespace_private_value_stmts,\n  resolve_import_path,\n  resolve_import_path_candidates,\n  rewrite_imported_value_stmt_to_local,\n  stmts_have_import_deep\n}\n\nimport @vibe/core {\n  array_empty\n}\n\nimport @vibe/compiler/checker {\n  check_program_with_env\n}\n\nimport @vibe/compiler/runtime/eval_loader {\n  contains_str\n}\n\n\nimport @vibe/compiler/syntax {\n  lex, parse_program, print_program\n}\n\nimport @vibe/compiler/loader {\n  load_or_parse_module_header_fs\n}\n\nimport @vibe/compiler/cache {\n  compilation_input_fingerprint, persistent_dep_list_cache_path, persistent_leaf_fingerprint_cache_path, persistent_type_env_cache_path\n}\n\nimport @vibe/graph {\n  RippleDb, ripple_eval_count, ripple_get_deps, ripple_get_fingerprint, ripple_get_source, ripple_new, ripple_record_eval, ripple_set_source\n}\n\n\n\n\n\n\n\n\nenum StringTriple {\n  StringTriple(String, String, String)\n}\n\nenum TypeDbState {\n  TypeDbState(RippleDb, Array[(String, TypeEnv)], Array[(String, String)], Array[StringTriple], Array[StringTriple], Array[StringTriple], Int, Int, Int, Int)\n}\n\nexport enum TypeDb {\n  TypeDb(TypeDbState)\n}\n\n\nfn unwrap_db(db: TypeDb) -> TypeDbState {\n  match db {\n    TypeDb(state) => state\n  }\n}\n\nfn wrap_db(state: TypeDbState) -> TypeDb {\n  TypeDb(state)\n}\n\nfn parse_program_with_path(path: String, source: String) -> Array[Stmt] with { Error } {\n  handle {\n    parse_program(lex(source))\n  } with Error {\n    Throw(msg) => throw(String::concat(String::concat(path, \": \"), msg))\n  }\n}\n\nfn add_dep(acc: Array[String], raw_path: String, base_dir: String) -> Array[String] {\n  if String::length(raw_path) == 0 {\n    acc\n  } else {\n    let resolved = resolve_import_path(base_dir, raw_path)\n    if contains_str(acc, resolved) {\n      acc\n    } else {\n      Array::push(acc, resolved)\n      acc\n    }\n  }\n}\n\nfn empty_strings() -> Array[String] {\n  array_empty()\n}\n\nfn empty_dep_fps() -> Array[(String, String)] {\n  array_empty()\n}\n\nfn empty_env_cache() -> Array[(String, TypeEnv)] {\n  array_empty()\n}\n\nfn empty_string_pairs() -> Array[(String, String)] {\n  array_empty()\n}\n\nfn empty_string_triples() -> Array[StringTriple] {\n  array_empty()\n}\n\nfn empty_stmt_array() -> Array[Stmt] {\n  array_empty()\n}\n\nexport fn db_new() -> TypeDb {\n  wrap_db(TypeDbState(ripple_new(), empty_env_cache(), empty_string_pairs(), empty_string_triples(), empty_string_triples(), empty_string_triples(), 0, 0, 0, 0))\n}\n\nfn lookup_string_pair(pairs: Array[(String, String)], key: String) -> Option[String] {\n  let len = Array::length(pairs)\n  let rec go: (Int) -> Option[String] = (i) -> {\n    if i >= len {\n      None\n    } else {\n      let (k, v) = Array::get(pairs, i)\n      if k == key {\n        Some(v)\n      } else {\n        go(i + 1)\n      }\n    }\n  }\n  go(0)\n}\n\nfn upsert_string_pair(pairs: Array[(String, String)], key: String, value: String) -> Array[(String, String)] {\n  let len = Array::length(pairs)\n  let b = ArrayBuilder::new()\n  let rec build: (Int) -> Array[(String, String)] = (i) -> {\n    if i >= len {\n      ArrayBuilder::push(b, (key, value))\n      ArrayBuilder::freeze(b)\n    } else {\n      let (k, v) = Array::get(pairs, i)\n      if k == key {\n        build(i + 1)\n      } else {\n        ArrayBuilder::push(b, (k, v))\n        build(i + 1)\n      }\n    }\n  }\n  build(0)\n}\n\nfn lookup_source_cache(cache: Array[StringTriple], path: String, fingerprint: String) -> Option[String] {\n  let len = Array::length(cache)\n  let rec go: (Int) -> Option[String] = (i) -> {\n    if i >= len {\n      None\n    } else {\n      match Array::get(cache, i) {\n        StringTriple(p, fp, source) =>\n        if p == path && fp == fingerprint {\n          Some(source)\n        } else {\n          go(i + 1)\n        }\n      }\n    }\n  }\n  go(0)\n}\n\nfn upsert_source_cache(cache: Array[StringTriple], path: String, fingerprint: String, source: String) -> Array[StringTriple] {\n  let out = empty_string_triples()\n  let mut i = 0\n  let len = Array::length(cache)\n  while i < len {\n    match Array::get(cache, i) {\n      StringTriple(p, fp, existing) =>\n      if p == path && fp == fingerprint {\n        ()\n      } else {\n        Array::push(out, StringTriple(p, fp, existing))\n      }\n    }\n    i = i + 1\n  }\n  Array::push(out, StringTriple(path, fingerprint, source))\n  out\n}\n\nfn append_source_cache_entries(cache: Array[StringTriple], entries: Array[StringTriple]) -> Array[StringTriple] {\n  if Array::length(entries) == 0 {\n    cache\n  } else {\n    let out = empty_string_triples()\n    let mut i = 0\n    while i < Array::length(cache) {\n      Array::push(out, Array::get(cache, i))\n      i = i + 1\n    }\n    let mut j = 0\n    while j < Array::length(entries) {\n      Array::push(out, Array::get(entries, j))\n      j = j + 1\n    }\n    out\n  }\n}\n\nexport fn db_set_source(db: TypeDb, path: String, source: String) -> TypeDb {\n  match unwrap_db(db) {\n    TypeDbState(rdb, env_cache, dep_source_cache, merged_cache, module_source_cache, artifact_cache, parse_count, merge_count, module_source_count, codegen_count) =>\n    wrap_db(TypeDbState(ripple_set_source(rdb, path, source), env_cache, dep_source_cache, merged_cache, module_source_cache, artifact_cache, parse_count, merge_count, module_source_count, codegen_count))\n  }\n}\n\nfn lookup_env_cache(cache: Array[(String, TypeEnv)], path: String) -> Option[TypeEnv] {\n  let len = Array::length(cache)\n  let rec go: (Int) -> Option[TypeEnv] = (i) -> {\n    if i >= len {\n      None\n    } else {\n      let (p, env) = Array::get(cache, i)\n      if p == path {\n        Some(env)\n      } else {\n        go(i + 1)\n      }\n    }\n  }\n  go(0)\n}\n\nfn resolve_cached_import_path(base_dir: String, raw_path: String, cache: Array[(String, TypeEnv)]) -> String {\n  let candidates = resolve_import_path_candidates(base_dir, raw_path)\n  let mut selected = \"\"\n  let mut i = 0\n  while i < Array::length(candidates) && selected == \"\" {\n    let candidate = Array::get(candidates, i)\n    match lookup_env_cache(cache, candidate) {\n      Some(_) => {\n        selected = candidate\n      },\n      None => ()\n    }\n    i = i + 1\n  }\n  if selected == \"\" {\n    resolve_import_path(base_dir, raw_path)\n  } else {\n    selected\n  }\n}\n\nexport fn db_check_env(db: TypeDb, path: String) -> Option[TypeEnv] {\n  match unwrap_db(db) {\n    TypeDbState(_, cache, _, _, _, _, _, _, _, _) => lookup_env_cache(cache, path)\n  }\n}\n\nfn starts_with_upper(name: String) -> Bool {\n  if String::length(name) == 0 {\n    false\n  } else {\n    let c = String::char_code_at(name, 0)\n    c >= 65 && c <= 90\n  }\n}\n\nfn type_returns_name(ty: Type, type_name: String) -> Bool {\n  match ty {\n    CtEnum(name) => name == type_name,\n    CtNamed(name, _) => name == type_name,\n    CtFn(_, ret, _) => type_returns_name(ret, type_name),\n    CtForAll(_, _, body) => type_returns_name(body, type_name),\n    _ => false\n  }\n}\n\nfn bind_enum_constructor_companions(acc: TypeEnv, dep_bindings: Array[(String, Type)], enum_name: String) -> TypeEnv {\n  let mut out = acc\n  let mut i = 0\n  while i < Array::length(dep_bindings) {\n    let (candidate_name, candidate_ty) = Array::get(dep_bindings, i)\n    if candidate_name != enum_name && starts_with_upper(candidate_name) && type_returns_name(candidate_ty, enum_name) {\n      out = env_bind(out, candidate_name, candidate_ty)\n    }\n    i = i + 1\n  }\n  out\n}\n\nfn bind_import_names_from_cache(acc: TypeEnv, resolved: String, names: Array[(String, Option[String])], cache: Array[(String, TypeEnv)]) -> TypeEnv {\n  let dep_env = match lookup_env_cache(cache, resolved) {\n    Some(e) => e,\n    None => EnvEmpty\n  }\n  let dep_bindings = env_flat_bindings(dep_env)\n  let nlen = Array::length(names)\n  let rec bind_names: (Int, TypeEnv) -> TypeEnv = (j, nacc) -> {\n    if j >= nlen {\n      nacc\n    } else {\n      let (name, alias) = Array::get(names, j)\n      let bound_name = match alias {\n        Some(a) => a,\n        None => name\n      }\n      let ty = match env_lookup_flat(dep_bindings, name) {\n        Some(t) => t,\n        None => CtUnknown\n      }\n      let with_name = env_bind(nacc, bound_name, ty)\n      let with_companions = match ty {\n        CtEnum(enum_name) => bind_enum_constructor_companions(with_name, dep_bindings, enum_name),\n        _ => if starts_with_upper(name) {\n          bind_enum_constructor_companions(with_name, dep_bindings, name)\n        } else {\n          with_name\n        }\n      }\n      bind_names(j + 1, with_companions)\n    }\n  }\n  bind_names(0, acc)\n}\n\nfn build_import_env(stmts: Array[Stmt], base_dir: String, cache: Array[(String, TypeEnv)]) -> TypeEnv {\n  let len = Array::length(stmts)\n  let rec go: (Int, TypeEnv) -> TypeEnv = (i, acc) -> {\n    if i >= len {\n      acc\n    } else {\n      let next = match Array::get(stmts, i) {\n        SImport(raw_path, names) => {\n          let resolved = resolve_cached_import_path(base_dir, raw_path, cache)\n          bind_import_names_from_cache(acc, resolved, names, cache)\n        },\n        SReExport(raw_path, names) => {\n          let resolved = resolve_cached_import_path(base_dir, raw_path, cache)\n          bind_import_names_from_cache(acc, resolved, names, cache)\n        },\n        _ => acc\n      }\n      go(i + 1, next)\n    }\n  }\n  go(0, EnvEmpty)\n}\n\nfn upsert_env_cache(cache: Array[(String, TypeEnv)], path: String, env: TypeEnv) -> Array[(String, TypeEnv)] {\n  let len = Array::length(cache)\n  let b = ArrayBuilder::new()\n  let rec build: (Int) -> Array[(String, TypeEnv)] = (i) -> {\n    if i >= len {\n      ArrayBuilder::push(b, (path, env))\n      ArrayBuilder::freeze(b)\n    } else {\n      let (p, e) = Array::get(cache, i)\n      if p == path {\n        build(i + 1)\n      } else {\n        ArrayBuilder::push(b, (p, e))\n        build(i + 1)\n      }\n    }\n  }\n  build(0)\n}\n\nfn compact_string_fingerprint(source: String) -> String {\n  let mod1 = 2147483647\n  let mod2 = 2147483629\n  let step1 = 131\n  let step2 = 65599\n  let len = String::length(source)\n  let mut h1 = 17\n  let mut h2 = 29\n  let mut i = 0\n  while i < len {\n    let c = String::char_code_at(source, i)\n    h1 = (h1 * step1 + c + 1) % mod1\n    h2 = (h2 * step2 + c + i + 1) % mod2\n    i = i + 1\n  }\n  String::concat(__to_string(len), String::concat(\":\", String::concat(__to_string(h1), String::concat(\":\", __to_string(h2)))))\n}\n\nfn store_persistent_type_env(fingerprint: String, env: TypeEnv) -> Unit with { Error, Fs } {\n  Fs::write_file(persistent_type_env_cache_path(fingerprint), persistent_type_env_cache_text(env))\n}\n\nfn build_fingerprint(source: String, dep_fps: Array[(String, String)]) -> String {\n  let mut acc = compact_string_fingerprint(source)\n  let mut i = 0\n  while i < Array::length(dep_fps) {\n    let dep_pair = Array::get(dep_fps, i)\n    let dep_path = dep_pair.0\n    let dep_fp = dep_pair.1\n    let next = String::concat(acc, String::concat(\"|\", String::concat(dep_path, String::concat(\"=\", dep_fp))))\n    acc = compact_string_fingerprint(next)\n    i = i + 1\n  }\n  acc\n}\n\nexport fn db_typecheck_count(db: TypeDb) -> Int {\n  match unwrap_db(db) {\n    TypeDbState(rdb, _, _, _, _, _, _, _, _, _) => ripple_eval_count(rdb)\n  }\n}\n\nexport fn db_parse_count(db: TypeDb) -> Int {\n  match unwrap_db(db) {\n    TypeDbState(_, _, _, _, _, _, parse_count, _, _, _) => parse_count\n  }\n}\n\nexport fn db_merge_count(db: TypeDb) -> Int {\n  match unwrap_db(db) {\n    TypeDbState(_, _, _, _, _, _, _, merge_count, _, _) => merge_count\n  }\n}\n\nexport fn db_module_source_count(db: TypeDb) -> Int {\n  match unwrap_db(db) {\n    TypeDbState(_, _, _, _, _, _, _, _, module_source_count, _) => module_source_count\n  }\n}\n\nexport fn db_codegen_count(db: TypeDb) -> Int {\n  match unwrap_db(db) {\n    TypeDbState(_, _, _, _, _, _, _, _, _, codegen_count) => codegen_count\n  }\n}\n\nfn collect_import_deps_from_stmts(stmts: Array[Stmt], base_dir: String) -> Array[String] {\n  let len = Array::length(stmts)\n  let rec go: (Int, Array[String]) -> Array[String] = (i, acc) -> {\n    if i >= len {\n      acc\n    } else {\n      let next = match Array::get(stmts, i) {\n        SImport(raw_path, _) => add_dep(acc, raw_path, base_dir),\n        SReExport(raw_path, _) => add_dep(acc, raw_path, base_dir),\n        _ => acc\n      }\n      go(i + 1, next)\n    }\n  }\n  go(0, empty_strings())\n}\n\nfn resolve_deps_for_source(rdb: RippleDb, dep_source_cache: Array[(String, String)], path: String, source: String, parse_count: Int) -> (Array[String], Array[(String, String)], Int) with { Error } {\n  match lookup_string_pair(dep_source_cache, path) {\n    Some(cached_source) =>\n    if cached_source == source {\n      match ripple_get_deps(rdb, path) {\n        Some(deps) => (deps, dep_source_cache, parse_count),\n        None => {\n          let stmts = parse_program_with_path(path, source)\n          let deps = collect_import_deps_from_stmts(stmts, dir_of_path(path))\n          (deps, upsert_string_pair(dep_source_cache, path, source), parse_count + 1)\n        }\n      }\n    } else {\n      let stmts = parse_program_with_path(path, source)\n      let deps = collect_import_deps_from_stmts(stmts, dir_of_path(path))\n      (deps, upsert_string_pair(dep_source_cache, path, source), parse_count + 1)\n    },\n    None => {\n      let stmts = parse_program_with_path(path, source)\n      let deps = collect_import_deps_from_stmts(stmts, dir_of_path(path))\n      (deps, upsert_string_pair(dep_source_cache, path, source), parse_count + 1)\n    }\n  }\n}\n\nfn load_or_parse_deps_for_source_fs(dep_source_cache: Array[(String, String)], path: String, source: String, parse_count: Int) -> (Array[String], Array[(String, String)], Int) with { Error, Fs } {\n  match load_persistent_dep_list(path, source) {\n    Some(deps) => (deps, upsert_string_pair(dep_source_cache, path, source), parse_count),\n    None => {\n      let (deps, _, next_parse_count) = load_or_parse_module_header_fs(path, source, parse_count)\n      (deps, upsert_string_pair(dep_source_cache, path, source), next_parse_count)\n    }\n  }\n}\n\nfn resolve_deps_for_source_fs(rdb: RippleDb, dep_source_cache: Array[(String, String)], path: String, source: String, parse_count: Int) -> (Array[String], Array[(String, String)], Int) with { Error, Fs } {\n  match lookup_string_pair(dep_source_cache, path) {\n    Some(cached_source) =>\n    if cached_source == source {\n      match ripple_get_deps(rdb, path) {\n        Some(deps) => (deps, dep_source_cache, parse_count),\n        None => load_or_parse_deps_for_source_fs(dep_source_cache, path, source, parse_count)\n      }\n    } else {\n      load_or_parse_deps_for_source_fs(dep_source_cache, path, source, parse_count)\n    },\n    None => load_or_parse_deps_for_source_fs(dep_source_cache, path, source, parse_count)\n  }\n}\n\nfn ensure_fingerprint(rdb: RippleDb, env_cache: Array[(String, TypeEnv)], dep_source_cache: Array[(String, String)], parse_count: Int, path: String, stack: Array[String]) -> (String, RippleDb, Array[(String, TypeEnv)], Array[(String, String)], Int) with { Error } {\n  if contains_str(stack, path) {\n    throw(String::concat(\"type_db: import cycle detected at \", path))\n  } else {\n    match ripple_get_source(rdb, path) {\n      None => (String::concat(\"missing:\", path), rdb, env_cache, dep_source_cache, parse_count),\n      Some(source) => {\n        let (deps, next_dep_source_cache, initial_parse_count) = resolve_deps_for_source(rdb, dep_source_cache, path, source, parse_count)\n        let dlen = Array::length(deps)\n        let saved_stack_len = Array::length(stack)\n        Array::push(stack, path)\n        let rec resolve_nested: (Int, Array[(String, String)], RippleDb, Array[(String, TypeEnv)], Array[(String, String)], Int) -> (Array[(String, String)], RippleDb, Array[(String, TypeEnv)], Array[(String, String)], Int) with { Error } = (i, dep_acc, dep_db, dep_env_cache, dep_source_cache2, dep_parse_count) -> {\n          if i >= dlen {\n            (dep_acc, dep_db, dep_env_cache, dep_source_cache2, dep_parse_count)\n          } else {\n            let dep_path = Array::get(deps, i)\n            let (dep_fp, next_db, next_env_cache, next_dep_source_cache2, next_parse_count) = ensure_fingerprint(dep_db, dep_env_cache, dep_source_cache2, dep_parse_count, dep_path, stack)\n            Array::push(dep_acc, (dep_path, dep_fp))\n            resolve_nested(i + 1, dep_acc, next_db, next_env_cache, next_dep_source_cache2, next_parse_count)\n          }\n        }\n        let resolved_nested = resolve_nested(0, empty_dep_fps(), rdb, env_cache, next_dep_source_cache, initial_parse_count)\n        Array::truncate(stack, saved_stack_len)\n        let dep_fps = resolved_nested.0\n        let db_after_deps = resolved_nested.1\n        let env_cache_after_deps = resolved_nested.2\n        let dep_source_cache_after_deps = resolved_nested.3\n        let parse_count_after_deps = resolved_nested.4\n        let fingerprint = build_fingerprint(source, dep_fps)\n        match ripple_get_fingerprint(db_after_deps, path) {\n          Some(cached_fp) =>\n          if cached_fp == fingerprint {\n            (fingerprint, db_after_deps, env_cache_after_deps, dep_source_cache_after_deps, parse_count_after_deps)\n          } else {\n            let stmts = parse_program_with_path(path, source)\n            let final_parse_count = parse_count_after_deps + 1\n            let import_env = build_import_env(stmts, dir_of_path(path), env_cache_after_deps)\n            let checked_env = check_program_with_env(stmts, import_env)\n            let next_env_cache = upsert_env_cache(env_cache_after_deps, path, checked_env)\n            let next_db = ripple_record_eval(db_after_deps, path, fingerprint, deps)\n            (fingerprint, next_db, next_env_cache, dep_source_cache_after_deps, final_parse_count)\n          },\n          None => {\n            let stmts = parse_program_with_path(path, source)\n            let final_parse_count = parse_count_after_deps + 1\n            let import_env = build_import_env(stmts, dir_of_path(path), env_cache_after_deps)\n            let checked_env = check_program_with_env(stmts, import_env)\n            let next_env_cache = upsert_env_cache(env_cache_after_deps, path, checked_env)\n            let next_db = ripple_record_eval(db_after_deps, path, fingerprint, deps)\n            (fingerprint, next_db, next_env_cache, dep_source_cache_after_deps, final_parse_count)\n          }\n        }\n      }\n    }\n  }\n}\n\nexport fn db_typecheck(db: TypeDb, path: String) -> TypeDb with { Error } {\n  match unwrap_db(db) {\n    TypeDbState(rdb, env_cache, dep_source_cache, merged_cache, module_source_cache, artifact_cache, parse_count, merge_count, module_source_count, codegen_count) => {\n      let (_, next_rdb, next_env_cache, next_dep_source_cache, next_parse_count) = ensure_fingerprint(rdb, env_cache, dep_source_cache, parse_count, path, empty_strings())\n      wrap_db(TypeDbState(next_rdb, next_env_cache, next_dep_source_cache, merged_cache, module_source_cache, artifact_cache, next_parse_count, merge_count, module_source_count, codegen_count))\n    }\n  }\n}\n\nexport fn db_typecheck_fs(db: TypeDb, path: String) -> TypeDb with { Error, Fs } {\n  match unwrap_db(db) {\n    TypeDbState(rdb, env_cache, dep_source_cache, merged_cache, module_source_cache, artifact_cache, parse_count, merge_count, module_source_count, codegen_count) => {\n      let (_, next_rdb, next_env_cache, next_dep_source_cache, next_parse_count) = ensure_fingerprint_fs_impl(rdb, env_cache, dep_source_cache, parse_count, path)\n      wrap_db(TypeDbState(next_rdb, next_env_cache, next_dep_source_cache, merged_cache, module_source_cache, artifact_cache, next_parse_count, merge_count, module_source_count, codegen_count))\n    }\n  }\n}\n\nexport fn db_program_source(db: TypeDb, path: String) -> (String, String, TypeDb) with { Error } {\n  let checked = db_typecheck(db, path)\n  match unwrap_db(checked) {\n    TypeDbState(rdb, _, _, _, _, _, _, _, _, _) =>\n    match ripple_get_source(rdb, path) {\n      None => throw(String::concat(\"missing:\", path)),\n      Some(source) =>\n      match ripple_get_fingerprint(rdb, path) {\n        Some(fingerprint) => (source, fingerprint, checked),\n        None => (source, source, checked)\n      }\n    }\n  }\n}\n\nfn build_merge_fingerprint(entry_path: String, sources: Array[(String, String)]) -> String {\n  compilation_input_fingerprint(sources, entry_path)\n}\n\nfn lookup_source_by_path(sources: Array[(String, String)], target_path: String) -> Option[String] {\n  let mut i = 0\n  let mut found = None\n  while i < Array::length(sources) {\n    let (path, source) = Array::get(sources, i)\n    if path == target_path {\n      found = Some(source)\n      i = Array::length(sources)\n    } else {\n      i = i + 1\n    }\n  }\n  found\n}\n\nfn append_import_alias_collision_defs_from_sources(merged: Array[Stmt], current_path: String, stmts: Array[Stmt], sources: Array[(String, String)], plan: ExportRenamePlan, excluded_locals: Array[String]) -> Unit with { Error } {\n  let refs = collect_import_alias_collision_refs(stmts)\n  let emitted = array_empty()\n  let base_dir = dir_of_path(current_path)\n  let mut i = 0\n  while i < Array::length(refs) {\n    let (raw_path, original, local) = Array::get(refs, i)\n    if !contains_str(emitted, local) && !contains_str(excluded_locals, local) {\n      let resolved = resolve_import_path(base_dir, raw_path)\n      match lookup_source_by_path(sources, resolved) {\n        Some(source) => {\n          let source_stmts = namespace_private_value_stmts(resolved, apply_export_renames_stmts(parse_program_with_path(resolved, source), export_plan_renames_for(plan, resolved)))\n          let mut j = 0\n          let mut done = false\n          while j < Array::length(source_stmts) && !done {\n            match rewrite_imported_value_stmt_to_local(Array::get(source_stmts, j), original, local) {\n              Some(local_stmt) => {\n                Array::push(merged, local_stmt)\n                Array::push(emitted, local)\n                done = true\n              },\n              None => ()\n            }\n            j = j + 1\n          }\n        },\n        None => ()\n      }\n    }\n    i = i + 1\n  }\n}\n\nfn parse_merge_sources(sources: Array[(String, String)]) -> (Array[String], Array[Array[Stmt]]) with { Error } {\n  let file_paths = array_empty()\n  let file_stmts = array_empty()\n  let mut si = 0\n  while si < Array::length(sources) {\n    let (path, source) = Array::get(sources, si)\n    Array::push(file_paths, path)\n    Array::push(file_stmts, parse_program_with_path(path, source))\n    si = si + 1\n  }\n  (file_paths, file_stmts)\n}\n\nfn build_merged_source_with_plan(entry_path: String, sources: Array[(String, String)], file_paths: Array[String], file_stmts: Array[Array[Stmt]], plan: ExportRenamePlan, collision_sources: Array[(String, String)]) -> String with { Error } {\n  let merged = empty_stmt_array()\n  let source_count = Array::length(sources)\n  let mut si = 0\n  while si < source_count {\n    let path = Array::get(file_paths, si)\n    let stmts = Array::get(file_stmts, si)\n    let is_entry_source = if entry_path == \"\" {\n      si == source_count - 1\n    } else {\n      path == entry_path\n    }\n    let export_renamed = if is_entry_source {\n      stmts\n    } else {\n      apply_export_renames_stmts(stmts, export_plan_renames_for(plan, path))\n    }\n    let namespaced_stmts = if is_entry_source {\n      export_renamed\n    } else {\n      namespace_private_value_stmts(path, export_renamed)\n    }\n    if stmts_have_import_deep(stmts) {\n      let import_renames = collect_import_value_renames(plan, path, stmts)\n      let skipped_locals = collect_import_alias_collision_locals(stmts)\n      append_import_alias_collision_defs_from_sources(merged, path, stmts, collision_sources, plan, import_value_rename_locals(import_renames))\n      append_import_alias_rewritten_non_import_stmts_with_renames(merged, namespaced_stmts, skipped_locals, import_renames)\n    } else {\n      append_non_import_stmts_without_alias_rewrite(merged, namespaced_stmts)\n    }\n    si = si + 1\n  }\n  print_program(merged)\n}\n\nfn build_merged_source(entry_path: String, sources: Array[(String, String)]) -> String with { Error } {\n  let (file_paths, file_stmts) = parse_merge_sources(sources)\n  let plan_entry = if entry_path == \"\" {\n    if Array::length(file_paths) > 0 {\n      Array::get(file_paths, Array::length(file_paths) - 1)\n    } else {\n      \"\"\n    }\n  } else {\n    entry_path\n  }\n  let plan = build_export_rename_plan(file_paths, file_stmts, plan_entry)\n  build_merged_source_with_plan(entry_path, sources, file_paths, file_stmts, plan, sources)\n}\n\nfn join_group_sources(group_sources: Array[String]) -> String {\n  let len = Array::length(group_sources)\n  let buf = StringBuilder::new()\n  let mut i = 0\n  while i < len {\n    let source = Array::get(group_sources, i)\n    if i > 0 {\n      StringBuilder::push(buf, \"\\n\")\n    }\n    StringBuilder::push(buf, source)\n    i = i + 1\n  }\n  StringBuilder::freeze(buf)\n}\n\nexport fn db_merged_source(db: TypeDb, _entry_path: String, sources: Array[(String, String)]) -> (String, String, TypeDb) with { Error } {\n  match unwrap_db(db) {\n    TypeDbState(rdb, env_cache, dep_source_cache, merged_cache, module_source_cache, artifact_cache, parse_count, merge_count, module_source_count, codegen_count) => {\n      let merge_fingerprint = build_merge_fingerprint(_entry_path, sources)\n      let merge_cache_key = \"merged\"\n      match lookup_source_cache(merged_cache, merge_cache_key, merge_fingerprint) {\n        Some(merged_source) => (merged_source, merge_fingerprint, db),\n        None => {\n          let merged_source = build_merged_source(_entry_path, sources)\n          let next_merged_cache = upsert_source_cache(merged_cache, merge_cache_key, merge_fingerprint, merged_source)\n          (merged_source, merge_fingerprint, wrap_db(TypeDbState(rdb, env_cache, dep_source_cache, next_merged_cache, module_source_cache, artifact_cache, parse_count, merge_count + 1, module_source_count, codegen_count)))\n        }\n      }\n    }\n  }\n}\n\nexport fn db_grouped_merged_source(db: TypeDb, groups: Array[(String, Array[(String, String)])]) -> (String, String, TypeDb) with { Error } {\n  match unwrap_db(db) {\n    TypeDbState(rdb, env_cache, dep_source_cache, merged_cache, module_source_cache, artifact_cache, parse_count, merge_count, module_source_count, codegen_count) => {\n      let group_sources = empty_strings()\n      let mut grouped_fingerprint = \"merged-groups\"\n      let new_group_cache_entries = empty_string_triples()\n      let mut merge_count_acc = merge_count\n      let flat_sources = array_empty()\n      let mut fgi = 0\n      while fgi < Array::length(groups) {\n        let (_, gsources) = Array::get(groups, fgi)\n        let mut fsi = 0\n        while fsi < Array::length(gsources) {\n          Array::push(flat_sources, Array::get(gsources, fsi))\n          fsi = fsi + 1\n        }\n        fgi = fgi + 1\n      }\n      let (flat_paths, flat_stmts) = parse_merge_sources(flat_sources)\n      let plan_entry = if Array::length(flat_paths) > 0 {\n        Array::get(flat_paths, Array::length(flat_paths) - 1)\n      } else {\n        \"\"\n      }\n      let plan = build_export_rename_plan(flat_paths, flat_stmts, plan_entry)\n      let plan_fp = compact_string_fingerprint(export_plan_fingerprint_text(plan))\n      let mut flat_idx = 0\n      let mut i = 0\n      while i < Array::length(groups) {\n        let (group_name, sources) = Array::get(groups, i)\n        let group_start = flat_idx\n        flat_idx = flat_idx + Array::length(sources)\n        let fingerprint = compact_string_fingerprint(String::concat(build_merge_fingerprint(plan_entry, sources), String::concat(\"#\", plan_fp)))\n        let grouped_next = String::concat(grouped_fingerprint, String::concat(\"|\", String::concat(group_name, String::concat(\"=\", fingerprint))))\n        grouped_fingerprint = compact_string_fingerprint(grouped_next)\n        let cache_key = String::concat(\"merged-group|\", group_name)\n        match lookup_source_cache(merged_cache, cache_key, fingerprint) {\n          Some(source) => {\n            Array::push(group_sources, source)\n          },\n          None =>\n          match lookup_source_cache(new_group_cache_entries, cache_key, fingerprint) {\n            Some(source) => {\n              Array::push(group_sources, source)\n            },\n            None => {\n              let group_paths = Array::slice(flat_paths, group_start, group_start + Array::length(sources))\n              let group_stmts = Array::slice(flat_stmts, group_start, group_start + Array::length(sources))\n              let source = build_merged_source_with_plan(plan_entry, sources, group_paths, group_stmts, plan, flat_sources)\n              Array::push(new_group_cache_entries, StringTriple(cache_key, fingerprint, source))\n              merge_count_acc = merge_count_acc + 1\n              Array::push(group_sources, source)\n            }\n          }\n        }\n        i = i + 1\n      }\n      let next_merged_cache = append_source_cache_entries(merged_cache, new_group_cache_entries)\n      let next_merge_count = merge_count_acc\n      let grouped_cache_key = \"merged-groups\"\n      match lookup_source_cache(next_merged_cache, grouped_cache_key, grouped_fingerprint) {\n        Some(source) =>\n        (source, grouped_fingerprint, wrap_db(TypeDbState(rdb, env_cache, dep_source_cache, next_merged_cache, module_source_cache, artifact_cache, parse_count, next_merge_count, module_source_count, codegen_count))),\n        None => {\n          let source = join_group_sources(group_sources)\n          let final_merged_cache = upsert_source_cache(next_merged_cache, grouped_cache_key, grouped_fingerprint, source)\n          (source, grouped_fingerprint, wrap_db(TypeDbState(rdb, env_cache, dep_source_cache, final_merged_cache, module_source_cache, artifact_cache, parse_count, next_merge_count + 1, module_source_count, codegen_count)))\n        }\n      }\n    }\n  }\n}\n\nfn build_module_source(source: String) -> String with { Error } {\n  let stmts = parse_program(lex(source))\n  let filtered = empty_stmt_array()\n  let mut i = 0\n  while i < Array::length(stmts) {\n    let stmt = Array::get(stmts, i)\n    let keep = match stmt {\n      SLet(_, _, _, _, expr) => {\n        match expr {\n          EFn(_, _, _, _, _, _) => true,\n          _ => false\n        }\n      },\n      _ => false\n    }\n    if keep {\n      Array::push(filtered, stmt)\n    }\n    i = i + 1\n  }\n  print_program(filtered)\n}\n\nexport fn db_module_source(db: TypeDb, fingerprint: String, source: String) -> (String, TypeDb) with { Error } {\n  match unwrap_db(db) {\n    TypeDbState(rdb, env_cache, dep_source_cache, merged_cache, module_source_cache, artifact_cache, parse_count, merge_count, module_source_count, codegen_count) => {\n      let module_cache_key = \"module-source\"\n      match lookup_source_cache(module_source_cache, module_cache_key, fingerprint) {\n        Some(module_source) => (module_source, db),\n        None => {\n          let module_source = build_module_source(source)\n          let next_module_source_cache = upsert_source_cache(module_source_cache, module_cache_key, fingerprint, module_source)\n          (module_source, wrap_db(TypeDbState(rdb, env_cache, dep_source_cache, merged_cache, next_module_source_cache, artifact_cache, parse_count, merge_count, module_source_count + 1, codegen_count)))\n        }\n      }\n    }\n  }\n}\n\nfn artifact_cache_key(kind: String, entry_name: String) -> String {\n  String::concat(kind, String::concat(\"|\", entry_name))\n}\n\nfn bytes_to_hex_digit(n: Int) -> String {\n  if n < 10 {\n    __to_string(n)\n  } else if n == 10 {\n    \"a\"\n  } else if n == 11 {\n    \"b\"\n  } else if n == 12 {\n    \"c\"\n  } else if n == 13 {\n    \"d\"\n  } else if n == 14 {\n    \"e\"\n  } else {\n    \"f\"\n  }\n}\n\nfn nibble_from_hex_char(c: Int) -> Int with { Error } {\n  if c >= 48 && c <= 57 {\n    c - 48\n  } else if c >= 97 && c <= 102 {\n    c - 87\n  } else if c >= 65 && c <= 70 {\n    c - 55\n  } else {\n    throw(\"invalid hex digit\")\n  }\n}\n\nfn bytes_to_hex(bytes: Bytes) -> String {\n  let len = Bytes::length(bytes)\n  let mut i = 0\n  let buf = StringBuilder::new()\n  while i < len {\n    let byte = Bytes::get(bytes, i)\n    let hi = byte / 16\n    let lo = byte % 16\n    StringBuilder::push(buf, bytes_to_hex_digit(hi))\n    StringBuilder::push(buf, bytes_to_hex_digit(lo))\n    i = i + 1\n  }\n  StringBuilder::freeze(buf)\n}\n\nfn hex_to_bytes(hex: String) -> Bytes with { Error } {\n  let len = String::length(hex)\n  if len % 2 != 0 {\n    throw(\"invalid hex length\")\n  } else {\n    let out = Bytes::new()\n    let mut i = 0\n    while i < len {\n      let hi = nibble_from_hex_char(String::char_code_at(hex, i))\n      let lo = nibble_from_hex_char(String::char_code_at(hex, i + 1))\n      Bytes::push(out, hi * 16 + lo)\n      i = i + 2\n    }\n    out\n  }\n}\n\nexport fn db_load_artifact(db: TypeDb, _path: String, kind: String, entry_name: String, fingerprint: String) -> Option[Bytes] with { Error } {\n  match unwrap_db(db) {\n    TypeDbState(_, _, _, _, _, artifact_cache, _, _, _, _) =>\n    match lookup_source_cache(artifact_cache, artifact_cache_key(kind, entry_name), fingerprint) {\n      Some(hex) => Some(hex_to_bytes(hex)),\n      None => None\n    }\n  }\n}\n\nexport fn db_store_artifact(db: TypeDb, _path: String, kind: String, entry_name: String, fingerprint: String, bytes: Bytes) -> TypeDb {\n  match unwrap_db(db) {\n    TypeDbState(rdb, env_cache, dep_source_cache, merged_cache, module_source_cache, artifact_cache, parse_count, merge_count, module_source_count, codegen_count) =>\n    wrap_db(TypeDbState(rdb, env_cache, dep_source_cache, merged_cache, module_source_cache, upsert_source_cache(artifact_cache, artifact_cache_key(kind, entry_name), fingerprint, bytes_to_hex(bytes)), parse_count, merge_count, module_source_count, codegen_count + 1))\n  }\n}\n")
}

