ilder::push(b, \"1\")\n  let mut i = 0\n  while i < 309 {\n    ArrayBuilder::push(b, \"0\")\n    i = i + 1\n  }\n  String::join(ArrayBuilder::freeze(b), \"\")\n}\n\nfn zero_pad_6(n: Int) -> String {\n  let s = __to_string(n)\n  let len = String::length(s)\n  if len >= 6 {\n    s\n  } else {\n    let mut out = \"\"\n    let mut i = len\n    while i < 6 {\n      out = String::concat(out, \"0\")\n      i = i + 1\n    }\n    String::concat(out, s)\n  }\n}\n\nfn trim_trailing_zeros(s: String) -> String {\n  let mut end = String::length(s)\n  while end > 0 && String::char_code_at(s, end - 1) == 48 {\n    end = end - 1\n  }\n  if end <= 0 {\n    \"\"\n  } else {\n    s[0: end]\n  }\n}\n\nexport fn double_to_string_compiler(d: Double) -> String {\n  if d != d {\n    \"nan\"\n  } else {\n    let neg = d < 0.0\n    let abs_d = if neg {\n      0.0 - d\n    } else {\n      d\n    }\n    let mut two_61 = 1.0\n    let mut t61i = 0\n    while t61i < 61 {\n      two_61 = two_61 * 2.0\n      t61i = t61i + 1\n    }\n    if abs_d >= two_61 * 1.0 {\n      let body = if abs_d * 0.5 == abs_d {\n        pos_inf_decimal_string()\n      } else {\n        big_double_exact_int_decimal(abs_d)\n      }\n      if neg {\n        String::concat(\"-\", body)\n      } else {\n        body\n      }\n    } else {\n    let int_part = Double::to_int(abs_d)\n    let frac = abs_d - Int::to_double(int_part)\n    let scaled_raw = Double::to_int(frac * 1000000.0 + 0.5)\n    let int_norm = if scaled_raw == 1000000 {\n      int_part + 1\n    } else {\n      int_part\n    }\n    let frac_norm = if scaled_raw == 1000000 {\n      0\n    } else {\n      scaled_raw\n    }\n    let int_s = __to_string(int_norm)\n    let frac_s = if frac_norm == 0 {\n      \"\"\n    } else {\n      trim_trailing_zeros(zero_pad_6(frac_norm))\n    }\n    let body = if String::length(frac_s) == 0 {\n      int_s\n    } else {\n      String::concat(int_s, String::concat(\".\", frac_s))\n    }\n    if neg {\n      String::concat(\"-\", body)\n    } else {\n      body\n    }\n    }\n  }\n}\n")
