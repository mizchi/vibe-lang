tUnknown, CtString), CtUnknown, None), false, true, true),\n    (\"Map::keys\", CtFn(reg_p1(CtUnknown), CtArray(CtString), None), false, true, true),\n    (\"MapBuilder::new\", CtFn(reg_p0(), CtUnknown, None), false, true, true),\n    (\"MapBuilder::set\", CtFn(reg_p3(CtUnknown, CtString, CtUnknown), CtUnit, None), false, true, true),\n    (\"MapBuilder::freeze\", CtFn(reg_p1(CtUnknown), CtUnknown, None), false, true, true),\n    (\"assert\", CtFn(reg_p1(CtBool), CtUnit, None), false, true, true),\n    (\"assert_true\", CtFn(reg_p1(CtBool), CtUnit, None), false, true, true),\n    (\"assert_eq\", CtFn(reg_p2(CtUnknown, CtUnknown), CtUnit, None), false, true, true),\n    (\"println\", CtFn(reg_p1(CtString), CtUnit, None), false, true, true),\n    (\"print\", CtFn(reg_p1(CtString), CtUnit, None), false, true, true),\n    (\"map_has\", CtFn(reg_p2(CtUnknown, CtString), CtBool, None), false, true, true)\n  ]\n\nexport fn builtin_registry_typed() -> Array[(String, Type, Bool, Bool, Bool)] {\n  registry_typed_rows\n}\n\nexport fn builtin_registry() -> Array[(String, Int, Int, Bool, Bool)] {\n  let rows = builtin_registry_typed()\n  let out = Array::slice([\n    (\"\", 0, 0, false, false)\n  ], 0, 0)\n  let mut i = 0\n  while i < Array::length(rows) {\n    let (name, ty, in_linear, in_gc, _) = Array::get(rows, i)\n    let (pc, ret) = match ty {\n      CtFn(params, ret_ty, _) => {\n        let r = match ret_ty {\n          CtUnit => 0,\n          _ => 1\n        }\n        (Array::length(params), r)\n      },\n      _ => (0, 1)\n    }\n    Array::push(out, (name, pc, ret, in_linear, in_gc))\n    i = i + 1\n  }\n  out\n}\n\nexport fn lookup_registry_builtin(name: String) -> Option[Type] {\n  let rows = builtin_registry_typed()\n  let mut i = 0\n  let mut found = None\n  while i < Array::length(rows) {\n    let (rname, ty, _, _, visible) = Array::get(rows, i)\n    if rname == name && visible {\n      found = Some(ty)\n      i = Array::length(rows)\n    } else {\n      i = i + 1\n    }\n  }\n  found\n}\n\nexport fn verify_lane_builtins(lane: String, names: Array[String], param_counts: Array[Int], returns: Array[Int]) -> Unit with { Error } {\n  let is_gc = lane == \"gc\"\n  let reg = builtin_registry()\n  let mut i = 0\n  while i < Array::length(names) {\n    let n = Array::get(names, i)\n    let mut found = false\n    let mut ri = 0\n    while ri < Array::length(reg) {\n      let (rn, rp, rr, rlin, rgc) = Array::get(reg, ri)\n      if rn == n {\n        found = true\n        let claimed = if is_gc { rgc } else { rlin }\n        if claimed {\n          ()\n        } else {\n          throw(\"builtin registry drift: '\\{n}' is registered by the \\{lane} lane but the registry says it is not in that lane's table (lib/@vibe/compiler/codegen/builtin_registry.vibe, #415)\")\n        }\n        if rp == Array::get(param_counts, i) && rr == Array::get(returns, i) {\n          ()\n        } else {\n          throw(\"builtin registry drift: '\\{n}' signature mismatch in the \\{lane} lane — registry says (params=\\{rp}, returns=\\{rr}), lane registered (params=\\{Array::get(param_counts, i)}, returns=\\{Array::get(returns, i)}) (#415)\")\n        }\n        ri = Array::length(reg)\n      } else {\n        ri = ri + 1\n      }\n    }\n    if found {\n      ()\n    } else {\n      throw(\"builtin registry drift: '\\{n}' is registered by the \\{lane} lane but has no row in lib/@vibe/compiler/codegen/builtin_registry.vibe (#415) — add one (and decide the other lane explicitly)\")\n    }\n    i = i + 1\n  }\n  let mut ri2 = 0\n  while ri2 < Array::length(reg) {\n    let (rn2, _, _, rlin2, rgc2) = Array::get(reg, ri2)\n    let claimed2 = (if is_gc { rgc2 } else { rlin2 }) && not(String::starts_with(rn2, \"vibe_rc_\"))\n    if claimed2 {\n      let mut found2 = false\n      let mut i2 = 0\n      while i2 < Array::length(names) {\n        if Array::get(names, i2) == rn2 {\n          found2 = true\n          i2 = Array::length(names)\n        } else {\n          i2 = i2 + 1\n        }\n      }\n      if found2 {\n        ()\n      } else {\n        throw(\"builtin registry drift: registry claims '\\{rn2}' is in the \\{lane} lane's table but the lane did not register it (#415)\")\n      }\n    } else {\n      ()\n    }\n    ri2 = ri2 + 1\n  }\n}\n")
}

