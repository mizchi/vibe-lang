  ("lib/@vibe/compiler/codegen/gc/backend_lambda_body.vibe",
"\n\n\n\n\n\n\n\n\nexport fn compile_lambda_gc(buf: Bytes, params: Array[(String, Option[TypeExpr])], fn_body: Expr, local_names: Array[String], next_local: Int, ctx: CompileCtxGc, ld: Int, compile_fn: CompileLambdaGcFn) -> Int with { Error } {\n  let (captures, num_captures, user_params) = collect_lambda_captures_gc(params, fn_body, ctx)\n  let (lam_buf, final_lam_nl) = compile_lambda_inner_gc(params, fn_body, captures, user_params, ctx, compile_fn, ld)\n  let lambda_idx = record_lambda_meta_gc(ctx, lam_buf, user_params, captures, final_lam_nl)\n  let table_slot = ctx.num_user_funcs + lambda_idx\n  emit_lambda_closure_gc(buf, captures, num_captures, local_names, next_local, table_slot)\n}\n")
