let selfhost_source_77 = () -> (String, String) {
  ("lib/@vibe/compiler/codegen/expr/compile_call.vibe",
"\n\n\n\n\n\n\n\n\n\n\n\nfn cc_ft_has(ft: FuncTable, name: String) -> Bool {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(ft.names) {\n    if Array::get(ft.names, i) == name {\n      found = true\n      i = Array::length(ft.names)\n    } else {\n      i = i + 1\n    }\n  }\n  found\n}\n\nfn cc_is_projection(e: Expr) -> Bool {\n  match e {\n    EDot(_, _, _, _) => true,\n    _ => false\n  }\n}\n\nexport fn cc_is_borrow_ret_call(e: Expr, ctx: CompileCtx) -> Bool {\n  match e {\n    ECall(callee, _, _) =>\n    match callee {\n      EIdent(f, _) => f == \"Array::get\" || f == \"Map::get\" || f == \"__index\" || f == \"__rec_field\" || array_contains_str(ctx.borrow_ret_names, f),\n      _ => false\n    },\n    _ => false\n  }\n}\n\nfn cc_arg_is_scalarish(e: Expr) -> Bool with { Error } {\n  let t = expr_tag(e)\n  if t == 0 || t == 1 {\n    true\n  } else if t == 5 {\n    let op = get_ebinop_op(e)\n    op == \"&\" || op == \"|\" || op == \"^\" || op == \"<<\" || op == \">>\" || op == \"%\" || op == \"<\" || op == \">\" || op == \"<=\" || op == \">=\" || op == \"==\" || op == \"!=\" || op == \"&&\" || op == \"||\"\n  } else if t == 6 {\n    let uop = get_eunaryop_op(e)\n    uop == \"!\" || (uop == \"-\" && cc_arg_is_scalarish(get_eunaryop_expr(e)))\n  } else {\n    false\n  }\n}\n\nfn cc_slot_is_floatish(ctx: CompileCtx, slot: Int) -> Bool {\n  let arr = ctx.float_local_slots\n  let mut j = Array::length(arr) - 1\n  let mut result = false\n  while j >= 0 {\n    let entry = Array::get(arr, j)\n    if entry / 2 == slot {\n      result = (entry % 2) == 1\n      j = -1\n    } else {\n      j = j - 1\n    }\n  }\n  result\n}\n\nfn cc_expr_is_floatish(e: Expr, local_names: Array[String], ctx: CompileCtx) -> Bool with { Error } {\n  let dot_float = match e {\n    EDot(dobj, dfield, _, _) => {\n      let fc = String::char_code_at(dfield, 0)\n      if fc >= 48 && fc <= 57 && is_eident(dobj) {\n        let slot = find_local_slot(local_names, get_eident_name(dobj))\n        if slot >= 0 {\n          let info = agg_slot_lookup(ctx.agg_local_slots, slot)\n          if info >= 0 && info / 64 == 1 {\n            let backing = agg_expr_lookup(ctx.agg_local_slots, ctx.agg_local_exprs, slot)\n            if is_etuple(backing) {\n              let elems = get_etuple_elems(backing)\n              let mut k = 0\n              let mut fp = 0\n              while fp < String::length(dfield) {\n                k = k * 10 + (String::char_code_at(dfield, fp) - 48)\n                fp = fp + 1\n              }\n              if k >= 0 && k < Array::length(elems) {\n                cc_expr_is_floatish(Array::get(elems, k), local_names, ctx)\n              } else {\n                false\n              }\n            } else {\n              false\n            }\n          } else {\n            false\n          }\n        } else {\n          false\n        }\n      } else {\n        false\n      }\n    },\n    _ => false\n  }\n  let tag = expr_tag(e)\n  if dot_float {\n    true\n  } else if tag == 2 {\n    true\n  } else if tag == 4 {\n    let nm = get_eident_name(e)\n    let len = Array::length(local_names)\n    let mut i = len - 1\n    let mut slot = -1\n    while i >= 0 {\n      if Array::get(local_names, i) == nm {\n        slot = i\n        i = -1\n      } else {\n        i = i - 1\n      }\n    }\n    if slot >= 0 {\n      cc_slot_is_floatish(ctx, slot)\n    } else {\n      false\n    }\n  } else if tag == 5 {\n    let op = get_ebinop_op(e)\n    if op == \"+\" || op == \"-\" || op == \"*\" || op == \"/\" {\n      cc_expr_is_floatish(get_ebinop_lhs(e), local_names, ctx) || cc_expr_is_floatish(get_ebinop_rhs(e), local_names, ctx)\n    } else {\n      false\n    }\n  } else if tag == 6 {\n    let op = get_eunaryop_op(e)\n    if op == \"-\" {\n      cc_expr_is_floatish(get_eunaryop_expr(e), local_names, ctx)\n    } else {\n      false\n    }\n  } else if tag == 8 {\n    let callee = get_ecall_callee(e)\n    if is_eident(callee) {\n      let fname = get_eident_name(callee)\n      if fname == \"Int::to_double\" || fname == \"Int::to_float\" || fname == \"Float::to_double\" || fname == \"Double::to_float\" || fname == \"Double::from_i64_bits\" {\n        true\n      } else if fname == \"__rec_field\" {\n        let args = get_ecall_args(e)\n        if Array::length(args) == 2 && is_eident(Array::get(args, 0)) && expr_tag(Array::get(args, 1)) == 0 {\n          let slot = find_local_slot(local_names, get_eident_name(Array::get(args, 0)))\n          if slot >= 0 {\n            let info = agg_slot_lookup(ctx.agg_local_slots, slot)\n            if info >= 0 && info / 64 == 1 {\n              let backing = agg_expr_lookup(ctx.agg_local_slots, ctx.agg_local_exprs, slot)\n              if is_etuple(backing) {\n                let elems = get_etuple_elems(backing)\n                let k = get_eint_value(Array::get(args, 1))\n                if k >= 0 && k < Array::length(elems) {\n                  cc_expr_is_floatish(Array::get(elems, k), local_names, ctx)\n                } else {\n                  false\n                }\n              } else {\n                false\n              }\n            } else {\n              false\n            }\n          } else {\n            false\n          }\n        } else {\n          false\n        }\n      } else {\n        false\n      }\n    } else {\n      false\n    }\n  } else {\n    false\n  }\n}\n\nfn cc_ft_first_idx(ft: FuncTable, name: String) -> Int {\n  let len = Array::length(ft.names)\n  let mut i = 0\n  let mut found = -1\n  while i < len {\n    if Array::get(ft.names, i) == name {\n      found = i\n      i = len\n    } else {\n      i = i + 1\n    }\n  }\n  found\n}\n\nexport fn cc_builtin_call_ret_kind(e: Expr, local_names: Array[String], ctx: CompileCtx) -> Int with { Error } {\n  if expr_tag(e) == 8 {\n    let bcallee = get_ecall_callee(e)\n    if is_eident(bcallee) {\n      let bn = canonical_builtin_name(get_eident_name(bcallee))\n      let kind = if bn == \"eq\" || bn == \"not\" || bn == \"String::equals\" || bn == \"String::contains\" || bn == \"String::starts_with\" || bn == \"String::ends_with\" || bn == \"Array::contains\" || bn == \"Array::any\" || bn == \"Array::all\" || bn == \"Map::has_key\" || bn == \"Map::has\" || bn == \"map_has\" || bn == \"Path::is_absolute\" || bn == \"Fs::exists\" || bn == \"Fs::is_dir\" || bn == \"Fs::is_file\" {\n        1\n      } else if bn == \"__to_string\" || bn == \"Int::to_string\" || bn == \"Double::to_string\" || bn == \"Float::to_string\" || bn == \"String::concat\" || bn == \"String::substring\" || bn == \"String::trim\" || bn == \"String::from_char_code\" || bn == \"String::join\" || bn == \"Env::get\" || bn == \"Env::args_get\" || bn == \"Fs::read_file\" || bn == \"Fs::getcwd\" || bn == \"sh\" {\n        2\n      } else {\n        0\n      }\n      if kind == 0 {\n        0\n      } else if find_local_slot(local_names, bn) >= 0 {\n        0\n      } else {\n        let fi = cc_ft_first_idx(ctx.func_table, bn)\n        if fi >= 0 && fi < ctx.num_user_funcs {\n          0\n        } else {\n          kind\n        }\n      }\n    } else {\n      0\n    }\n  } else {\n    0\n  }\n}\n\nexport fn cc_expr_is_stringish(e: Expr, local_names: Array[String], ctx: CompileCtx) -> Bool with { Error } {\n  let tag = expr_tag(e)\n  if tag == 3 {\n    true\n  } else if tag == 4 {\n    let nm = get_eident_name(e)\n    let mut i = Array::length(local_names) - 1\n    let mut slot = -1\n    while i >= 0 {\n      if Array::get(local_names, i) == nm {\n        slot = i\n        i = -1\n      } else {\n        i = i - 1\n      }\n    }\n    if slot >= 0 {\n      let arr = ctx.int_local_slots\n      let mut j = Array::length(arr) - 1\n      let mut result = false\n      while j >= 0 {\n        let entry = Array::get(arr, j)\n        if entry / 4 == slot {\n          result = (entry % 4) == 2\n          j = -1\n        } else {\n          j = j - 1\n        }\n      }\n      result\n    } else {\n      false\n    }\n  } else if tag == 9 {\n    cc_expr_is_stringish(get_elet_body(e), local_names, ctx)\n  } else if tag == 10 {\n    cc_expr_is_stringish(get_eletrec_body(e), local_names, ctx)\n  } else if tag == 11 {\n    cc_expr_is_stringish(get_eletmut_body(e), local_names, ctx)\n  } else if tag == 14 {\n    cc_expr_is_stringish(get_eseq_second(e), local_names, ctx)\n  } else if tag == 7 {\n    cc_expr_is_stringish(get_eif_then(e), local_names, ctx) && cc_expr_is_stringish(get_eif_else(e), local_names, ctx)\n  } else if tag == 16 {\n    let arms = get_match_arms(e)\n    let alen2 = Array::length(arms)\n    if alen2 == 0 {\n      false\n    } else {\n      let mut all_str = true\n      let mut si2 = 0\n      while si2 < alen2 {\n        if !cc_expr_is_stringish(get_arm_body(Array::get(arms, si2)), local_names, ctx) {\n          all_str = false\n        } else {\n          ()\n        }\n        si2 = si2 + 1\n      }\n      all_str\n    }\n  } else if tag == 8 {\n    let bcallee = get_ecall_callee(e)\n    if is_efn(bcallee) && Array::length(get_ecall_args(e)) == 1 {\n      let fparams = get_efn_params(bcallee)\n      if Array::length(fparams) == 1 {\n        let (asc_name, asc_ty) = Array::get(fparams, 0)\n        (asc_name == \"__asc\" || (String::starts_with(asc_name, \"__shadow_\") && String::ends_with(asc_name, \"___asc\"))) && (match asc_ty {\n          Some(TyName(tn)) => tn == \"String\",\n          _ => false\n        })\n      } else {\n        false\n      }\n    } else {\n      cc_builtin_call_ret_kind(e, local_names, ctx) == 2\n    }\n  } else {\n    false\n  }\n}\n\nfn cc_expr_is_boolish(e: Expr, local_names: Array[String], ctx: CompileCtx) -> Bool with { Error } {\n  let tag = expr_tag(e)\n  if tag == 1 {\n    true\n  } else if tag == 4 {\n    let nm = get_eident_name(e)\n    let mut i = Array::length(local_names) - 1\n    let mut slot = -1\n    while i >= 0 {\n      if Array::get(local_names, i) == nm {\n        slot = i\n        i = -1\n      } else {\n        i = i - 1\n      }\n    }\n    if slot >= 0 {\n      let arr = ctx.int_local_slots\n      let mut j = Array::length(arr) - 1\n      let mut result = false\n      while j >= 0 {\n        let entry = Array::get(arr, j)\n        if entry / 4 == slot {\n          result = (entry % 4) == 3\n          j = -1\n        } else {\n          j = j - 1\n        }\n      }\n      result\n    } else {\n      false\n    }\n  } else if tag == 5 {\n    let op = get_ebinop_op(e)\n    op == \"==\" || op == \"!=\" || op == \"<\" || op == \">\" || op == \"<=\" || op == \">=\" || op == \"&&\" || op == \"||\"\n  } else if tag == 6 {\n    get_eunaryop_op(e) == \"!\"\n  } else if tag == 16 {\n    let arms = get_match_arms(e)\n    let alen2 = Array::length(arms)\n    if alen2 == 0 {\n      false\n    } else {\n      let mut all_bool = true\n      let mut bi2 = 0\n      while bi2 < alen2 {\n        if !cc_expr_is_boolish(get_arm_body(Array::get(arms, bi2)), local_names, ctx) {\n          all_bool = false\n        } else {\n          ()\n        }\n        bi2 = bi2 + 1\n      }\n      all_bool\n    }\n  } else if tag == 9 {\n    cc_expr_is_boolish(get_elet_body(e), local_names, ctx)\n  } else if tag == 10 {\n    cc_expr_is_boolish(get_eletrec_body(e), local_names, ctx)\n  } else if tag == 11 {\n    cc_expr_is_boolish(get_eletmut_body(e), local_names, ctx)\n  } else if tag == 14 {\n    cc_expr_is_boolish(get_eseq_second(e), local_names, ctx)\n  } else if tag == 7 {\n    cc_expr_is_boolish(get_eif_then(e), local_names, ctx) && cc_expr_is_boolish(get_eif_else(e), local_names, ctx)\n  } else if tag == 8 {\n    let bcallee = get_ecall_callee(e)\n    if is_eident(bcallee) {\n      let bcn = get_eident_name(bcallee)\n      String::starts_with(bcn, \"__arr_equals__\") || (String::ends_with(bcn, \"::equals\") && Array::length(get_ecall_args(e)) == 2) || (bcn == \"not\" && Array::length(get_ecall_args(e)) == 1 && find_local_slot(local_names, \"not\") < 0 && cc_expr_is_boolish(Array::get(get_ecall_args(e), 0), local_names, ctx)) || cc_builtin_call_ret_kind(e, local_names, ctx) == 1\n    } else if is_efn(bcallee) && Array::length(get_ecall_args(e)) == 1 {\n      let fparams = get_efn_params(bcallee)\n      if Array::length(fparams) == 1 {\n        let (asc_name, asc_ty) = Array::get(fparams, 0)\n        (asc_name == \"__asc\" || (String::starts_with(asc_name, \"__shadow_\") && String::ends_with(asc_name, \"___asc\"))) && (match asc_ty {\n          Some(TyName(tn)) => tn == \"Bool\",\n          _ => false\n        })\n      } else {\n        false\n      }\n    } else {\n      false\n    }\n  } else {\n    false\n  }\n}\n\nexport fn cc_is_loop_borrowed_ident(e: Expr, ctx: CompileCtx) -> Bool {\n  match e {\n    EIdent(name, _) =>\n    array_contains_str(ctx.loop_borrowed_names, name) && !array_contains_str(ctx.ref_cell_names, name),\n    _ => false\n  }\n}\n\nfn cc_is_borrow_arg0_call(f: String) -> Bool {\n  f == \"__index\" || f == \"Array::get\" || f == \"Array::length\" || f == \"Array::set\" || f == \"Array::push\" || f == \"ArrayBuilder::push\" || f == \"StringBuilder::push\" || f == \"MapBuilder::set\" || f == \"Map::get\" || f == \"Map::keys\" || f == \"Map::has_key\" || f == \"Map::has\" || f == \"Map::set\" || f == \"Map::size\" || f == \"Map::values\" || f == \"Map::delete\" || f == \"Bytes::push\" || f == \"Bytes::set\" || f == \"Bytes::get\" || f == \"Bytes::length\" || f == \"__rec_field\"\n}\n\nfn cc_retain_stored_arg(buf: Bytes, carg: Expr, local_names: Array[String], nl: Int, ctx: CompileCtx) -> Int with { Error } {\n  let is_loop_borrow = ctx.enable_rc && cc_is_loop_borrowed_ident(carg, ctx)\n  if ctx.enable_rc && (cc_is_projection(carg) || cc_is_borrow_ret_call(carg, ctx) || is_loop_borrow) {\n    if is_loop_borrow {\n      Array::push(ctx.loop_consumed_names, get_eident_name(carg))\n    } else {\n      ()\n    }\n    Array::push(local_names, \"__argdup\")\n    emit_local_tee(buf, nl)\n    emit_rc_dup_guarded(buf, nl, ctx.rc_shadow)\n    nl + 1\n  } else {\n    nl\n  }\n}\n\nfn ts_known_int(e: Expr, local_names: Array[String], ctx: CompileCtx) -> Bool {\n  let tag = expr_tag(e)\n  if tag == 0 {\n    true\n  } else if tag == 5 {\n    let op = get_ebinop_op(e)\n    op == \"&\" || op == \"|\" || op == \"^\" || op == \"<<\" || op == \">>\" || op == \"%\"\n  } else if tag == 8 {\n    match get_ecall_callee(e) {\n      EIdent(cn, _) => cn == \"Fs::stat_token\" || cn == \"vibe_fs_stat_token_raw\" || cn == \"Profiler::now_us\" || cn == \"Profiler::heap_bytes\" || cn == \"Env::args_len\" || cn == \"String::length\" || cn == \"Array::length\" || cn == \"Bytes::length\" || cn == \"String::char_code_at\" || cn == \"String::index_of\" || cn == \"String::last_index_of\" || cn == \"Stdin::read_char\",\n      _ => false\n    }\n  } else {\n    false\n  }\n}\n\nfn uninterned_string_expr(s: String, i: Int) -> Expr {\n  let ch = ECall(EIdent(\"String::from_char_code\", -1), [\n    EInt(String::char_code_at(s, i))\n  ], -1)\n  if i >= String::length(s) - 1 {\n    ch\n  } else {\n    ECall(EIdent(\"String::concat\", -1), [\n      ch,\n      uninterned_string_expr(s, i + 1)\n    ], -1)\n  }\n}\n\nfn sh_lines_flag_cmd(acc: Expr, args: Array[Expr], i: Int) -> Expr {\n  if i >= Array::length(args) {\n    acc\n  } else {\n    let next_acc = match Array::get(args, i) {\n      ELabeledArg(label, _, cond) => EIf(cond, ECall(EIdent(\"String::concat\", -1), [\n        acc,\n        uninterned_string_expr(String::concat(\" -\", label), 0)\n      ], -1), acc),\n      _ => acc\n    }\n    sh_lines_flag_cmd(next_acc, args, i + 1)\n  }\n}\n\nexport fn compile_call(buf: Bytes, callee: Expr, args: Array[Expr], local_names: Array[String], next_local: Int, ctx: CompileCtx, ld: Int, ce: (Bytes, Expr, Array[String], Int, CompileCtx, Int) -> Int with { Error }) -> Int with { Error } {\n  if is_eident(callee) {\n    let fname0 = canonical_builtin_name(get_eident_name(callee))\n    let fname = if fname0 == \"Stream::map\" {\n      \"Array::map\"\n    } else if fname0 == \"Stream::fold\" {\n      \"Array::fold\"\n    } else {\n      fname0\n    }\n    let fn_len2 = Array::length(ctx.func_table.names)\n    let mut fn_idx_in_list = -1\n    let mut __tr_j = 0\n    while __tr_j < fn_len2 {\n      if Array::get(ctx.func_table.names, __tr_j) == fname {\n        fn_idx_in_list = __tr_j\n        __tr_j = fn_len2\n      } else {\n        __tr_j = __tr_j + 1\n      }\n    }\n    let mut local_idx_hint = -1\n    let mut li = Array::length(local_names) - 1\n    while li >= 0 {\n      if Array::get(local_names, li) == fname {\n        local_idx_hint = li\n        li = -1\n      } else {\n        li = li - 1\n      }\n    }\n    let prefer_bound_call = fn_idx_in_list >= 0 || local_idx_hint >= 0\n    let ctor_lookup_idx = ctor_table_index_of(ctx.ctor_table, fname)\n    if ctor_lookup_idx >= 0 {\n      let tag = Array::get(ctx.ctor_table.tags, ctor_lookup_idx)\n      let fc = Array::get(ctx.ctor_table.field_counts, ctor_lookup_idx)\n      let ptr_local = next_local\n      Array::push(local_names, \"__ctor_ptr\")\n      let actual_args = if Array::length(args) == 1 {\n        match Array::get(args, 0) {\n          ERecord(_, rec_fields, _) => {\n            let mut si2 = 0\n            let mut sn_idx = -1\n            while si2 < Array::length(ctx.ctor_table.struct_names) {\n              if Array::get(ctx.ctor_table.struct_names, si2) == fname {\n                sn_idx = si2\n                si2 = Array::length(ctx.ctor_table.struct_names)\n              } else {\n                si2 = si2 + 1\n              }\n            }\n            if sn_idx >= 0 {\n              let def_fnames = Array::get(ctx.ctor_table.struct_field_names, sn_idx)\n              let ordered = Array::slice([\n                EUnit\n              ], 0, 0)\n              let mut oi = 0\n              while oi < Array::length(def_fnames) {\n                let target_name = Array::get(def_fnames, oi)\n                let mut ri = 0\n 