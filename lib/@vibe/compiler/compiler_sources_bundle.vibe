  agg_log_reset_above(ctx.gc_agg_local_slots, names_before_h)\\n        if nl_h2 > nl_h {\\n          nl_h = nl_h2\\n        }\\n        nl_h\\n      }\\n    },\\n    ELabeledArg(_, _, lval) => ce(buf, lval, local_names, next_local, ld),\\n    EMap(mfields) => {\\n      // #538: map literal -> the gc Map block layout used by MapBuilder/Map::*\\n      // ([count@0][cap@4][key@8+i*16][val@16+i*16]); keys are string literals.\\n      let mflen = Array::length(mfields)\\n      let mcap = if mflen > 32 {\\n        mflen\\n      } else {\\n        32\\n      }\\n      let malloc_size = 8 + mcap * 16\\n      let mptr = next_local\\n      Array::push(local_names, \\\"__maplit_ptr\\\")\\n      emit_global_get(buf, 0)\\n      emit_i64_extend_i32_u(buf)\\n      emit_local_set(buf, mptr)\\n      emit_global_get(buf, 0)\\n      emit_i32_const(buf, malloc_size)\\n      emit_i32_add(buf)\\n      emit_global_set(buf, 0)\\n      emit_heap_memory_grow_check(buf)\\n      emit_local_get(buf, mptr)\\n      emit_i32_wrap_i64(buf)\\n      emit_i32_const(buf, mflen)\\n      emit_i32_store(buf, 2, 0)\\n      emit_local_get(buf, mptr)\\n      emit_i32_wrap_i64(buf)\\n      emit_i32_const(buf, mcap)\\n      emit_i32_store(buf, 2, 4)\\n      let mut mnl = next_local + 1\\n      let mut mi = 0\\n      while mi < mflen {\\n        let (mkey, mval) = Array::get(mfields, mi)\\n        let mk_idx = str_table_lookup(ctx.str_table.strs, mkey)\\n        emit_local_get(buf, mptr)\\n        emit_i32_wrap_i64(buf)\\n        emit_str_ref(buf, Array::get(ctx.str_table.offsets, mk_idx), Array::get(ctx.str_table.lengths, mk_idx))\\n        emit_i64_store(buf, 3, 8 + mi * 16)\\n        emit_local_get(buf, mptr)\\n        emit_i32_wrap_i64(buf)\\n        mnl = ce(buf, mval, local_names, mnl, ld)\\n        emit_i64_store(buf, 3, 16 + mi * 16)\\n        mi = mi + 1\\n      }\\n      emit_local_get(buf, mptr)\\n      mnl\\n    },\\n    EStringInterp(_) => throw(\\\"GC codegen: EStringInterp must be resolved before codegen (call resolve_interp_stmts first)\\\"),\\n    _ => throw(String::concat(\\\"unsupported expression in gc codegen: tag \\\", __to_string(expr_tag(expr))))\\n  }\\n}\\n\\n//# Misc\\n\\nexport {\\n  compile_expr_gc\\n}\\n\")\n}\n\nlet cli_adapter_source_116 = () -> (String, String) {\n  (\"lib/@vibe/compiler/codegen/gc/backend_call.vibe\",\n\"//# Imports\\n\\nimport ../../core {\\n  Expr, Pat, Stmt, TypeExpr, bytebuf_length, bytebuf_new, bytebuf_push, bytebuf_push_section, bytebuf_push_vec_header, bytebuf_to_bytes, leb128_encode_s64, leb128_encode_u32\\n}\\n\\nimport ../common_analysis {\\n  collect_free_vars, collect_strings_stmts, emit_closure_call_tail, emit_closure_resolve, emit_i64_extend_i32_u, is_mut_captured_in\\n}\\n\\nimport ../common_base {\\n  CompileCtxGc, CtorTable, FuncTable, LambdaTable, StrTable, emit_binop_op, emit_i32_eq, emit_i32_eqz, emit_i32_ge_u, emit_i32_gt_u, emit_i32_mul, emit_i32_ne, emit_i32_sub, emit_i64_load, emit_i64_store, emit_str_ref, expr_tag, find_func_stmt, is_eident, ctor_table_index_of, resolve_func, resolve_local, struct_field_candidates, struct_field_dispatch_cases\\n}\\n\\nimport ../../builtin_name.vibe {\\n  canonical_builtin_name\\n}\\n\\nimport ../double_to_string_expr.vibe {\\n  double_to_string_expr\\n}\\n\\nimport ../common_extractors {\\n  array_contains_str, emit_assignop_op, emit_memory_copy, find_catchall_idx, get_ecall_args, get_ecall_callee, get_eident_name, get_estring_value, str_table_lookup\\n}\\n\\nimport ../wasm_emit {\\n  emit_heap_memory_grow_check, emit_block_i64, emit_block_void, emit_br, emit_br_if, emit_call, emit_call_indirect, emit_code_section, emit_code_section_with_locals, emit_data_section, emit_data_section_multi, emit_drop, emit_element_section_active, emit_else, emit_end, emit_export_section, emit_export_section_multi, emit_exports_with_memory, emit_f64_add, emit_f64_const_bits, emit_f64_convert_i64_s, emit_f64_div, emit_f64_eq, emit_f64_ge, emit_f64_gt, emit_f64_le, emit_f64_lt, emit_f64_mul, emit_f64_ne, emit_f64_neg, emit_f64_reinterpret_i64, emit_f64_sub, emit_func_type_raw, emit_function_section, emit_global_get, emit_global_section_i32_mut, emit_global_set, emit_header, emit_i32_add, emit_i32_const, emit_i32_load, emit_i32_load8_u, emit_i32_store, emit_i32_store8, emit_i32_wrap_i64, emit_i64_add, emit_i64_and, emit_i64_const, emit_i64_div_s, emit_i64_eq, emit_i64_eqz, emit_i64_extend_i32_s, emit_i64_ge_s, emit_i64_gt_s, emit_i64_le_s, emit_i64_lt_s, emit_i64_mul, emit_i64_ne, emit_i64_or, emit_i64_reinterpret_f64, emit_i64_rem_s, emit_i64_shl, emit_i64_shr_s, emit_i64_sub, emit_i64_trunc_f64_s, emit_i64_xor, emit_if_i64, emit_if_void, emit_import_section_func, emit_local_get, emit_local_set, emit_local_tee, emit_loop_void, emit_memory_section, emit_name, emit_return, emit_struct_get, emit_struct_new, emit_struct_set, emit_struct_type_raw, emit_table_section_funcref, emit_type_section, emit_type_section_multi, string_to_data\\n}\\n\\nimport ./backend_builtins_array_alloc.vibe {\\n  gc_gen_arr_len_body, gc_gen_arr_new_body\\n}\\n\\nimport ./backend_builtins_array_get.vibe {\\n  gc_gen_arr_get_body\\n}\\n\\nimport ./backend_builtins_array_push.vibe {\\n  gc_gen_arr_push_body\\n}\\n\\nimport ./backend_builtins_array_set.vibe {\\n  gc_gen_arr_set_body\\n}\\n\\nimport ./backend_builtins_numeric.vibe {\\n  gc_gen_double_to_int_body, gc_gen_identity_body, gc_gen_int_to_double_body\\n}\\n\\nimport ./backend_builtins_print.vibe {\\n  gc_gen_print_i64_body, gc_gen_print_str_body\\n}\\n\\nimport ./backend_builtins_string.vibe {\\n  gc_gen_str_concat_body, gc_gen_str_eq_body, gc_gen_str_len_body\\n}\\n\\nimport ./backend_builtins_string_extra.vibe {\\n  gc_gen_str_char_code_at_body, gc_gen_str_from_char_code_body, gc_gen_str_substring_body\\n}\\n\\n//# Functions\\n\\n// #538: call a func-table-RESOLVED index. User functions (>= func_offset)\\n// take a trailing closure-env i64 (callers pass 0); builtins/imports do not.\\n// The flat bundle defines its own __to_string / String::join / eq etc., so a\\n// resolve_func hit is NOT guaranteed to be a builtin -- every resolved call\\n// must go through here or a user-shadowed builtin miscompiles with a missing\\n// env argument (invalid wasm, \\\"expected i64 but nothing on stack\\\").\\nfn emit_call_resolved(buf: Bytes, ctx: CompileCtxGc, fidx: Int) -> Unit {\\n  if ctx.func_offset > 0 && fidx >= ctx.func_offset {\\n    emit_i64_const(buf, 0)\\n  } else {\\n    ()\\n  }\\n  emit_call(buf, fidx)\\n}\\n\\n// #538 P4.5: resolve to the BUILTIN entry even when the compiled program\\n// defines a top-level function of the same name (the compiler bundle has its\\n// own `__to_string(Int)`). Builtins are appended AFTER user functions in the\\n// func table, so the LAST match is the builtin. Interpolation's `__to_string`\\n// must always hit the runtime string-vs-int dispatch body — routing it to the\\n// program's decimal-only version rendered interpolated Strings as numbers.\\nfn gc_resolve_builtin_last(ft: FuncTable, name: String) -> Int {\\n  let mut i = Array::length(ft.names) - 1\\n  let mut found = -1\\n  while i >= 0 {\\n    if found < 0 && Array::get(ft.names, i) == name {\\n      found = Array::get(ft.indices, i)\\n      i = -1\\n    } else {\\n      i = i - 1\\n    }\\n  }\\n  found\\n}\\n\\n// Local mirror of backend_expr's gc_expr_is_floatish (backend_expr imports\\n// this file, so importing it back would cycle — same precedent as the linear\\n// lane's cc_expr_is_floatish mirror in expr/compile_call.vibe).\\nfn bc_expr_is_floatish(e: Expr, ctx: CompileCtxGc) -> Bool {\\n  match e {\\n    EFloat(_) => true,\\n    EIdent(fname, _) => array_contains_str(ctx.gc_float_locals, fname),\\n    EBinOp(op, l, r) => (op == \\\"+\\\" || op == \\\"-\\\" || op == \\\"*\\\" || op == \\\"/\\\") && (bc_expr_is_floatish(l, ctx) || bc_expr_is_floatish(r, ctx)),\\n    EUnaryOp(op, x) => op == \\\"-\\\" && bc_expr_is_floatish(x, ctx),\\n    ECall(fcallee, _, _) => match fcallee {\\n      EIdent(cn, _) => cn == \\\"Int::to_double\\\" || cn == \\\"Double::from_i64_bits\\\" || cn == \\\"Float::to_double\\\" || cn == \\\"Double::to_float\\\" || cn == \\\"Int::to_float\\\",\\n      _ => false\\n    },\\n    _ => false\\n  }\\n}\\n\\nfn compile_call_gc(buf: Bytes, callee: Expr, args: Array[Expr], local_names: Array[String], next_local: Int, ctx: CompileCtxGc, ld: Int, ce: (Bytes, Expr, Array[String], Int, Int) -> Int with { Error }) -> Int with { Error } {\\n  match callee {\\n    EIdent(fname, _) => {\\n      let ctor_lookup_idx = ctor_table_index_of(ctx.gc_ctor_table, fname)\\n      if ctor_lookup_idx >= 0 {\\n        let tag = Array::get(ctx.gc_ctor_table.tags, ctor_lookup_idx)\\n        let fc = Array::get(ctx.gc_ctor_table.field_counts, ctor_lookup_idx)\\n        let obj_size = 8 + fc * 8\\n        let ptr_local = next_local\\n        Array::push(local_names, \\\"__ctor_ptr\\\")\\n        emit_global_get(buf, 0)\\n        emit_i64_extend_i32_u(buf)\\n        emit_local_set(buf, ptr_local)\\n        emit_global_get(buf, 0)\\n        emit_i32_const(buf, obj_size)\\n        emit_i32_add(buf)\\n        emit_global_set(buf, 0)\\n        // #415: gc-lane heap bump must grow linear memory like the linear\\n        // backend does -- without this any allocation past the initial page\\n        // traps OOB (the gc smoke fixture only ever allocated a few bytes).\\n        emit_heap_memory_grow_check(buf)\\n        emit_local_get(buf, ptr_local)\\n        emit_i32_wrap_i64(buf)\\n        emit_i32_const(buf, tag)\\n        emit_i32_store(buf, 2, 0)\\n        emit_local_get(buf, ptr_local)\\n        emit_i32_wrap_i64(buf)\\n        emit_i32_const(buf, fc)\\n        emit_i32_store(buf, 2, 4)\\n        let actual_args = if Array::length(args) == 1 {\\n          match Array::get(args, 0) {\\n            ERecord(_, rec_fields, _) => {\\n              let rec find_sn: (Int) -> Int = (sni) -> {\\n                if sni >= Array::length(ctx.gc_ctor_table.struct_names) {\\n                  -1\\n                }\\n                else if Array::get(ctx.gc_ctor_table.struct_names, sni) == fname {\\n                  sni\\n                }\\n                else find_sn(sni + 1)\\n              }\\n              let sn_idx = find_sn(0)\\n              if sn_idx >= 0 {\\n                let def_fnames = Array::get(ctx.gc_ctor_table.struct_field_names, sn_idx)\\n                let ordered = Array::slice([\\n                  EUnit\\n                ], 0, 0)\\n                let mut oi = 0\\n                while oi < Array::length(def_fnames) {\\n                  let target_name = Array::get(def_fnames, oi)\\n                  let rec find_rf: (Int) -> Expr = (ri) -> {\\n                    if ri >= Array::length(rec_fields) {\\n                      EUnit\\n                    }\\n                    else {\\n                      let (rfn, rfv) = Array::get(rec_fields, ri)\\n                      if rfn == target_name {\\n                        rfv\\n                      }\\n                      else find_rf(ri + 1)\\n                    }\\n                  }\\n                  Array::push(ordered, find_rf(0))\\n                  oi = oi + 1\\n                }\\n                ordered\\n              } else {\\n                args\\n              }\\n            },\\n            _ => args\\n          }\\n        } else {\\n          args\\n        }\\n        let mut nl_c = next_local + 1\\n        let mut fi_c = 0\\n        while fi_c < Array::length(actual_args) {\\n          nl_c = ce(buf, Array::get(actual_args, fi_c), local_names, nl_c, ld)\\n          let val_local = nl_c\\n          Array::push(local_names, \\\"__ctor_val\\\")\\n          emit_local_set(buf, val_local)\\n          nl_c = nl_c + 1\\n          emit_local_get(buf, ptr_local)\\n          emit_i32_wrap_i64(buf)\\n          emit_local_get(buf, val_local)\\n          emit_i64_store(buf, 3, 8 + fi_c * 8)\\n          fi_c = fi_c + 1\\n        }\\n        emit_local_get(buf, ptr_local)\\n        emit_i64_const(buf, 1)\\n        emit_i64_or(buf)\\n        nl_c\\n      }\\n      else if fname == \\\"__slice\\\" {\\n        let (ss_idx, _, _) = resolve_func(ctx.func_table, \\\"String::substring\\\")\\n        let (bs_idx, _, _) = resolve_func(ctx.func_table, \\\"Bytes::slice\\\")\\n        let (as_idx, _, _) = resolve_func(ctx.func_table, \\\"Array::slice\\\")\\n        let obj_local = next_local\\n        let start_local = next_local + 1\\n        let end_local = next_local + 2\\n        let ptr_local = next_local + 3\\n        let cap_local = next_local + 4\\n        Array::push(local_names, \\\"__slice_obj\\\")\\n        Array::push(local_names, \\\"__slice_start\\\")\\n        Array::push(local_names, \\\"__slice_end\\\")\\n        Array::push(local_names, \\\"__slice_ptr\\\")\\n        Array::push(local_names, \\\"__slice_cap\\\")\\n        let mut nl = next_local + 5\\n        nl = ce(buf, Array::get(args, 0), local_names, nl, ld)\\n        emit_local_set(buf, obj_local)\\n        nl = ce(buf, Array::get(args, 1), local_names, nl, ld)\\n        emit_local_set(buf, start_local)\\n        nl = ce(buf, Array::get(args, 2), local_names, nl, ld)\\n        emit_local_set(buf, end_local)\\n        emit_local_get(buf, obj_local)\\n        emit_i64_const(buf, 32)\\n        emit_i64_shr_s(buf)\\n        emit_i64_eqz(buf)\\n        emit_if_i64(buf)\\n        emit_local_get(buf, obj_local)\\n        emit_local_set(buf, ptr_local)\\n        emit_local_get(buf, ptr_local)\\n        emit_i32_wrap_i64(buf)\\n        emit_i32_load(buf, 2, 0)\\n        emit_i64_extend_i32_u(buf)\\n        emit_local_set(buf, cap_local)\\n        emit_local_get(buf, cap_local)\\n        emit_i32_wrap_i64(buf)\\n        emit_i32_const(buf, 2147483647)\\n        emit_i32_gt_u(buf)\\n        emit_if_i64(buf)\\n        emit_local_get(buf, obj_local)\\n        emit_local_get(buf, start_local)\\n        emit_local_get(buf, end_local)\\n        emit_call_resolved(buf, ctx, bs_idx)\\n        emit_else(buf)\\n        emit_local_get(buf, obj_local)\\n        emit_local_get(buf, start_local)\\n        emit_local_get(buf, end_local)\\n        emit_call_resolved(buf, ctx, as_idx)\\n        emit_end(buf)\\n        emit_else(buf)\\n        emit_local_get(buf, obj_local)\\n        emit_local_get(buf, start_local)\\n        emit_local_get(buf, end_local)\\n        emit_call_resolved(buf, ctx, ss_idx)\\n        emit_end(buf)\\n        nl\\n      }\\n      else if fname == \\\"__index\\\" {\\n        let (sg_idx, _, _) = resolve_func(ctx.func_table, \\\"String::char_code_at\\\")\\n        let (bg_idx, _, _) = resolve_func(ctx.func_table, \\\"Bytes::get\\\")\\n        let (ag_idx, _, _) = resolve_func(ctx.func_table, \\\"Array::get\\\")\\n        let obj_local = next_local\\n        let idx_local = next_local + 1\\n        let ptr_local = next_local + 2\\n        let cap_local = next_local + 3\\n        Array::push(local_names, \\\"__index_obj\\\")\\n        Array::push(local_names, \\\"__index_idx\\\")\\n        Array::push(local_names, \\\"__index_ptr\\\")\\n        Array::push(local_names, \\\"__index_cap\\\")\\n        let mut nl = next_local + 4\\n        nl = ce(buf, Array::get(args, 0), local_names, nl, ld)\\n        emit_local_set(buf, obj_local)\\n        nl = ce(buf, Array::get(args, 1), local_names, nl, ld)\\n        emit_local_set(buf, idx_local)\\n        emit_local_get(buf, obj_local)\\n        emit_i64_const(buf, 32)\\n        emit_i64_shr_s(buf)\\n        emit_i64_eqz(buf)\\n        emit_if_i64(buf)\\n        emit_local_get(buf, obj_local)\\n        emit_local_set(buf, ptr_local)\\n        emit_local_get(buf, ptr_local)\\n        emit_i32_wrap_i64(buf)\\n        emit_i32_load(buf, 2, 0)\\n        emit_i64_extend_i32_u(buf)\\n        emit_local_set(buf, cap_local)\\n        emit_local_get(buf, cap_local)\\n        emit_i32_wrap_i64(buf)\\n        emit_i32_const(buf, 2147483647)\\n        emit_i32_gt_u(buf)\\n        emit_if_i64(buf)\\n        emit_local_get(buf, obj_local)\\n        emit_local_get(buf, idx_local)\\n        emit_call_resolved(buf, ctx, bg_idx)\\n        emit_else(buf)\\n        emit_local_get(buf, obj_local)\\n        emit_local_get(buf, idx_local)\\n        emit_call_resolved(buf, ctx, ag_idx)\\n        emit_end(buf)\\n        emit_else(buf)\\n        emit_local_get(buf, obj_local)\\n        emit_local_get(buf, idx_local)\\n        emit_call_resolved(buf, ctx, sg_idx)\\n        emit_end(buf)\\n        nl\\n      }\\n      else if fname == \\\"__set_field\\\" {\\n        let field = get_estring_value(Array::get(args, 1))\\n        let fc = String::char_code_at(field, 0)\\n        let is_numeric = fc >= 48 && fc <= 57\\n        if is_numeric {\\n          let mut vi = 0\\n          let mut vp = 0\\n          while vp < String::length(field) {\\n            vi = vi * 10 + (String::char_code_at(field, vp) - 48)\\n            vp = vp + 1\\n          }\\n          let mut nl = next_local\\n          nl = ce(buf, Array::get(args, 0), local_names, nl, ld)\\n          emit_i64_const(buf, -2)\\n          emit_i64_and(buf)\\n          emit_i32_wrap_i64(buf)\\n          nl = ce(buf, Array::get(args, 2), local_names, nl, ld)\\n          emit_i64_store(buf, 3, vi * 8)\\n          emit_i64_const(buf, 1)\\n          nl\\n        } else {\\n          // #722: same struct-tag dispatch as the linear __set_field — a\\n          // same-named `mut` field can live at a different slot in another\\n          // struct, and the static first-match store would corrupt it.\\n          let cands = struct_field_candidates(ctx.gc_ctor_table, field)\\n          if Array::length(cands) == 0 {\\n            throw(String::concat(\\\"unknown struct field: \\\", field))\\n          }\\n          let (_, idx0) = Array::get(cands, 0)\\n          let dispatch = struct_field_dispatch_cases(cands)\\n          if Array::length(dispatch) == 0 {\\n            let mut nl = next_local\\n            nl = ce(buf, Array::get(args, 0), local_names, nl, ld)\\n            emit_i64_const(buf, -2)\\n            emit_i64_and(buf)\\n            emit_i32_wrap_i64(buf)\\n            nl = ce(buf, Array::get(args, 2), local_names, nl, ld)\\n            emit_i64_store(buf, 3, 8 + idx0 * 8)\\n            emit_i64_const(buf, 1)\\n            nl\\n          } else {\\n            let mut nl = next_local\\n            nl = ce(buf, Array::get(args, 0), local_names, nl, ld)\\n            emit_i64_const(buf, -2)\\n            emit_i64_and(buf)\\n            let obj_l = nl\\n            Array::push(local_names, \\\"__setf_obj\\\")\\n            emit_local_set(buf, obj_l)\\n            nl = ce(buf, Array::get(args, 2), local_names, nl + 1, ld)\\n            let val_l = nl\\n            Array::push(local_names, \\\"__setf_val\\\")\\n            emit_local_set(buf, val_l)\\n            let mut di = 0\\n            while di < Array::length(dispatch) {\\n              let (dtag, didx) = Array::get(dispatch, di)\\n              emit_local_get(buf, obj_l)\\n              emit_i32_wrap_i64(buf)\\n              emit_i32_load(buf, 2, 0)\\n              emit_i32_const(buf, dtag)\\n              emit_i32_eq(buf)\\n              emit_if_void(buf)\\n              emit_local_get(buf, obj_l)\\n              emit_i32_wrap_i64(buf)\\n              emit_local_get(buf, val_l)\\n              emit_i64_store(buf, 3, 8 + didx * 8)\\n              emit_else(buf)\\n              di = di + 1\\n            }\\n            emit_local_get(buf, obj_l)\\n            emit_i32_wrap_i64(buf)\\n            emit_local_get(buf, val_l)\\n            emit_i64_store(buf, 3, 8 + idx0 * 8)\\n            let mut de = 0\\n            while de < Array::length(dispatch) {\\n              emit_end(buf)\\n              de = de + 1\\n            }\\n            emit_i64_const(buf, 1)\\n            nl + 1\\n          }\\n        }\\n      }\\n      else if fname == \\\"__rec_field\\\" {\\n        // #760(4): positional record field read `__rec_field(rec, i)` — emitted\\n        // by the record-pattern destructure (parser) and the anonymous-record\\n        // dot-access lowering (desugar_trait_dict). gc records are\\n        // [tag@0][len@4][fields@8+i*8], the same shape as the linear backend, so\\n        // the field load is `8 + i*8` after untagging the pointer. Mirrors the\\n        // linear __rec_field in compile_call.vibe.\\n        let field_idx = match Array::get(args, 1) {\\n          EInt(n) => n,\\n          _ => throw(\\\"__rec_field: index must be an int literal\\\")\\n        }\\n        let nl = ce(buf, Array::get(args, 0), local_names, next_local, ld)\\n        emit_i64_const(buf, -2)\\n        emit_i64_and(buf)\\n        emit_i32_wrap_i64(buf)\\n        emit_i64_load(buf, 3, 8 + field_idx * 8)\\n        nl\\n      }\\n      else if fname == \\\"__len\\\" {\\n        let (sl_idx, _, _) = resolve_func(ctx.func_table, \\\"String::length\\\")\\n        let (bl_idx, _, _) = resolve_func(ctx.func_table, \\\"Bytes::length\\\")\\n        let (al_idx, _, _) = resolve_func(ctx.func_table, \\\"Array::length\\\")\\n        let obj_local = next_local\\n        let ptr_local = next_local + 1\\n        let cap_local = next_local + 2\\n        Array::push(local_names, \\\"__len_obj\\\")\\n        Array::push(local_names, \\\"__len_ptr\\\")\\n        Array::push(local_names, \\\"__len_cap\\\")\\n        let mut nl = next_local + 3\\n        nl = ce(buf, Array::get(args, 0), local_names, nl, ld)\\n        emit_local_set(buf, obj_local)\\n        emit_local_get(buf, obj_local)\\n        emit_i64_const(buf, 32)\\n        emit_i64_shr_s(buf)\\n        emit_i64_eqz(buf)\\n        emit_if_i64(buf)\\n        emit_local_get(buf, obj_local)\\n        emit_local_set(buf, ptr_local)\\n        emit_local_get(buf, ptr_local)\\n        emit_i32_wrap_i64(buf)\\n        emit_i32_load(buf, 2, 0)\\n        emit_i64_extend_i32_u(buf)\\n        emit_local_set(buf, cap_local)\\n        emit_local_get(buf, cap_loca