let source_229 = () -> (String, String) {
  ("lib/@vibe/compiler/entry/source_compile/gc_only/index.vpkg",
"name = @vibe/compiler/entry/source_compile/gc_only\nversion = 0.0.1\ndescription =\n  #|@vibe/compiler/entry/source_compile/gc_only — the wasm-gc backend's\ndeps = {\n  @vibe/ast : 0.1.0\n  @vibe/compiler/checker : 0.0.1\n  @vibe/compiler/codegen : 0.0.1\n  @vibe/compiler/codegen/gc : 0.0.1\n  @vibe/compiler/syntax : 0.0.1\n  @vibe/core : 0.2.0\n}\n\ngenerated_hash =\n\n// @vibe/compiler/entry/source_compile/gc_only — the wasm-gc backend's\n// single-source compile driver (lex+parse+check+compile via\n// compile_wasi_module_gc, mirroring ../source_compile's linear-backend\n// compile_source_wasi) (ADR-0070 Phase 3, #897, compiler-internal batch).\n// Compiled into the compiler itself via compiler_sources_manifest.tsv\n// (group `entry`, dual-row: this contract + gc_only.vibe).\n//\n// The old index.vibe was not a facade but the whole implementation (the\n// package is single-file), so it moved verbatim to gc_only.vibe. No\n// exported types: no struct/enum this package touches. No `version`\n// binding existed (compiler-internal package).\n\nfn compile_source_gc_only(source: String, entry_name: String) -> Bytes with { Error }\n")
}

let source_230 = () -> (String, String) {
  ("lib/@vibe/compiler/entry/source_compile/gc_only/gc_only.vibe",
"\nimport @vibe/compiler/syntax {\n  Token, lex, parse_program, parse_stmt\n}\n\nimport @vibe/core {\n  array_empty\n}\nimport @vibe/compiler/checker {\n  check_program\n}\n\nimport @vibe/compiler/codegen {\n  desugar_trait_dicts\n}\n\nimport @vibe/compiler/codegen/gc {\n  compile_wasi_module_gc, gc_to_string_resolves_to_show_wrapper\n}\n\nimport @vibe/ast {\n  Expr, Stmt\n}\n\n\n\nfn gc_concat_exprs(lhs: Expr, rhs: Expr) -> Expr {\n  let b = ArrayBuilder::new()\n  ArrayBuilder::push(b, lhs)\n  ArrayBuilder::push(b, rhs)\n  let args = ArrayBuilder::freeze(b)\n  ECall(EIdent(\"String::concat\", -1), args, -1)\n}\n\nfn gc_fold_interp_exprs_loop(result_arr: Array[Expr], result_len: Int, result0: Expr, j0: Int) -> Expr {\n  let mut result = result0\n  let mut j = j0\n  while j < result_len {\n    let rhs = Array::get(result_arr, j)\n    result = gc_concat_exprs(result, rhs)\n    j = j + 1\n  }\n  result\n}\n\nfn gc_fold_interp_exprs_nonempty(result_arr: Array[Expr], result_len: Int) -> Expr {\n  let first = Array::get(result_arr, 0)\n  gc_fold_interp_exprs_loop(result_arr, result_len, first, 1)\n}\n\nfn gc_fold_interp_exprs(result_arr: Array[Expr]) -> Expr {\n  let result_len = Array::length(result_arr)\n  if result_len == 0 {\n    EString(\"\")\n  } else {\n    gc_fold_interp_exprs_nonempty(result_arr, result_len)\n  }\n}\n\nfn gc_parse_interp_expr(tokens: Array[Token]) -> Expr with { Error } {\n  let (stmt, _) = parse_stmt(tokens, [\n  ], 0)\n  match stmt {\n    SExpr(expr) => expr,\n    _ => throw(\"expected interpolation expression\")\n  }\n}\n\nfn gc_collect_interp_exprs(parts: Array[String]) -> Array[Expr] with { Error } {\n  let plen = Array::length(parts)\n  let exprs = ArrayBuilder::new()\n  let mut i = 0\n  while i < plen {\n    let lit = Array::get(parts, i)\n    if String::length(lit) > 0 {\n      ArrayBuilder::push(exprs, EString(lit))\n    }\n    if i + 1 < plen {\n      let expr_src = Array::get(parts, i + 1)\n      let part_tokens = lex(expr_src)\n      let part_expr = gc_parse_interp_expr(part_tokens)\n      ArrayBuilder::push(exprs, ECall(EIdent(\"__to_string\", -1), [\n        part_expr\n      ], -1))\n    }\n    i = i + 2\n  }\n  ArrayBuilder::freeze(exprs)\n}\n\nfn gc_rewrite_interp_string(parts: Array[String]) -> Expr with { Error } {\n  let result_arr = gc_collect_interp_exprs(parts)\n  gc_fold_interp_exprs(result_arr)\n}\n\nfn gc_rewrite_interp(e: Expr) -> Expr with { Error } {\n  match e {\n    EStringInterp(parts) => gc_rewrite_interp_string(parts),\n    ELet(name, val, body, soff) => ELet(name, gc_rewrite_interp(val), gc_rewrite_interp(body), soff),\n    ELetMut(name, val, body, soff) => ELetMut(name, gc_rewrite_interp(val), gc_rewrite_interp(body), soff),\n    ELetRec(name, val, body) => ELetRec(name, gc_rewrite_interp(val), gc_rewrite_interp(body)),\n    ESeq(a, b) => ESeq(gc_rewrite_interp(a), gc_rewrite_interp(b)),\n    ECall(callee, args, off) => ECall(gc_rewrite_interp(callee), for arg in args {\n      gc_rewrite_interp(arg)\n    }, off),\n    EIf(c, t, e2) => EIf(gc_rewrite_interp(c), gc_rewrite_interp(t), gc_rewrite_interp(e2)),\n    EFn(tp, tb, params, ret, eff, body) => EFn(tp, tb, params, ret, eff, gc_rewrite_interp(body)),\n    EMatch(scrut, arms) => EMatch(gc_rewrite_interp(scrut), for arm in arms {\n      let (pat, body) = arm; (pat, gc_rewrite_interp(body))\n    }),\n    _ => e\n  }\n}\n\nfn expand_interp_stmts(stmts: Array[Stmt]) -> Unit with { Error } {\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SLet(exp, is_rec, name, ann, expr) => Array::set(stmts, i, SLet(exp, is_rec, name, ann, gc_rewrite_interp(expr)))\n      ,\n      STest(name, expr) => Array::set(stmts, i, STest(name, gc_rewrite_interp(expr)))\n      ,\n      SBench(name, expr) => Array::set(stmts, i, SBench(name, gc_rewrite_interp(expr)))\n      ,\n      _ => ()\n    }\n    i = i + 1\n  }\n  desugar_trait_dicts(stmts)\n}\n\nfn strip_generic_type_params(stmts: Array[Stmt]) -> Unit {\n  let empty_tp = array_empty()\n  let empty_bounds = array_empty()\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SLet(sl_exp, sl_rec, sl_name, sl_ann, sl_expr) => match sl_expr {\n        EFn(tparams, _, params, ret, eff, body) => if Array::length(tparams) > 0 {\n          Array::set(stmts, i, SLet(sl_exp, sl_rec, sl_name, sl_ann, EFn(empty_tp, empty_bounds, params, ret, eff, body)))\n        }\n        ,\n        _ => ()\n      },\n      _ => ()\n    }\n    i = i + 1\n  }\n}\n\nfn lower_test_blocks_gc(stmts: Array[Stmt], entry_name: String) -> String with { Error } {\n  let empty_tp = array_empty()\n  let empty_bounds = array_empty()\n  let empty_params = array_empty()\n  let test_fn_names = array_empty()\n  let mut has_entry = false\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      STest(tname, tbody) => {\n        let test_fn = String::concat(\"__test_\", tname)\n        Array::push(test_fn_names, test_fn)\n        Array::set(stmts, i, SLet(false, false, test_fn, None, EFn(empty_tp, empty_bounds, empty_params, None, None, ESeq(tbody, EInt(0)))))\n      },\n      SBench(bname, bbody) => {\n        let bench_fn = String::concat(\"__bench_\", bname)\n        Array::push(test_fn_names, bench_fn)\n        Array::set(stmts, i, SLet(false, false, bench_fn, None, EFn(empty_tp, empty_bounds, empty_params, None, None, ESeq(bbody, EInt(0)))))\n      },\n      SLet(_, _, name, _, _) => if name == entry_name {\n        has_entry = true\n      },\n      _ => ()\n    }\n    i = i + 1\n  }\n  if has_entry || Array::length(test_fn_names) == 0 {\n    entry_name\n  } else {\n    let mut body = EInt(0)\n    let mut ti = Array::length(test_fn_names) - 1\n    while ti >= 0 {\n      body = ESeq(ECall(EIdent(Array::get(test_fn_names, ti), 0 - 1), array_empty(), 0 - 1), body)\n      ti = ti - 1\n    }\n    Array::push(stmts, SLet(true, false, \"_start\", None, EFn(empty_tp, empty_bounds, empty_params, None, None, body)))\n    \"_start\"\n  }\n}\n\nexport fn compile_source_gc_only(source: String, entry_name: String) -> Bytes with { Error } {\n  let tokens = lex(source)\n  let stmts = parse_program(tokens)\n  expand_interp_stmts(stmts)\n  let effective_entry = lower_test_blocks_gc(stmts, entry_name)\n  let _ = check_program(stmts)\n  let gc_to_string_is_wrapper = gc_to_string_resolves_to_show_wrapper(stmts)\n  strip_generic_type_params(stmts)\n  desugar_trait_dicts(stmts)\n  compile_wasi_module_gc(stmts, effective_entry, gc_to_string_is_wrapper)\n}\n")
}

