let source_176 = () -> (String, String) {
  ("lib/@vibe/compiler/cache/cache_underlying.vibe",
"\nimport @vibe/cache {\n  compact_string_fingerprint,\n  load_artifact_envelope_at,\n  persistent_artifact_cache_path,\n  persistent_dep_list_cache_path,\n  persistent_leaf_fingerprint_cache_path,\n  persistent_manifest_header_cache_path,\n  persistent_module_header_cache_path,\n  persistent_source_group_cache_path,\n  persistent_source_list_cache_path,\n  persistent_type_env_cache_path,\n  stable_cache_path,\n  store_artifact_envelope_at\n}\n\n\neffect Env {\n  Get(String) -> String\n}\n\nfn env_get_raw(name: String) -> String with { Env } {\n  Env::get(name)\n}\n\nfn read_env_discharged(name: String) -> String {\n  handle {\n    env_get_raw(name)\n  } with Env {\n    Get(_n) => resume(\"\")\n  }\n}\n\nfn rebase_cache_path(path: String) -> String {\n  let override_root = read_env_discharged(\"VIBE_BUILD_CACHE_DIR\")\n  let default_prefix = \"_build/vibe_\"\n  if String::length(override_root) == 0 {\n    path\n  } else if !(String::starts_with(path, default_prefix)) {\n    path\n  } else {\n    let override_len = String::length(override_root)\n    let override_prefix = if String::char_code_at(override_root, override_len - 1) == 47 {\n      String::concat(override_root, \"vibe_\")\n    } else {\n      String::concat(override_root, \"/vibe_\")\n    }\n    String::concat(override_prefix, path[String::length(default_prefix): String::length(path)])\n  }\n}\n\nexport fn cache_persistent_artifact_cache_path(version_tag: String, kind: String, entry_name: String, fingerprint: String) -> String {\n  rebase_cache_path(persistent_artifact_cache_path(version_tag, kind, entry_name, fingerprint))\n}\n\nexport fn cache_store_persistent_artifact(version_tag: String, kind: String, entry_name: String, fingerprint: String, bytes: Bytes) -> Unit with { Error, Fs } {\n  store_artifact_envelope_at(cache_persistent_artifact_cache_path(version_tag, kind, entry_name, fingerprint), bytes)\n}\n\nexport fn cache_load_persistent_artifact(version_tag: String, kind: String, entry_name: String, fingerprint: String) -> Option[Bytes] with { Error, Fs } {\n  load_artifact_envelope_at(cache_persistent_artifact_cache_path(version_tag, kind, entry_name, fingerprint))\n}\n\nexport fn cache_persistent_dep_list_cache_path(version_tag: String, path: String, source_fingerprint: String, resolution_seed: String) -> String {\n  rebase_cache_path(persistent_dep_list_cache_path(version_tag, path, source_fingerprint, resolution_seed))\n}\n\nexport fn cache_persistent_type_env_cache_path(version_tag: String, fingerprint: String) -> String {\n  rebase_cache_path(persistent_type_env_cache_path(version_tag, fingerprint))\n}\n\nexport fn cache_persistent_source_list_cache_path(version_tag: String, entry_path: String, resolution_seed: String) -> String {\n  rebase_cache_path(persistent_source_list_cache_path(version_tag, entry_path, resolution_seed))\n}\n\nexport fn cache_persistent_source_group_cache_path(version_tag: String, entry_path: String, resolution_seed: String) -> String {\n  rebase_cache_path(persistent_source_group_cache_path(version_tag, entry_path, resolution_seed))\n}\n\nexport fn cache_persistent_module_header_cache_path(version_tag: String, path: String, source_fingerprint: String, resolution_seed: String) -> String {\n  rebase_cache_path(persistent_module_header_cache_path(version_tag, path, source_fingerprint, resolution_seed))\n}\n\nexport fn cache_persistent_manifest_header_cache_path(version_tag: String, entry_path: String) -> String {\n  rebase_cache_path(persistent_manifest_header_cache_path(version_tag, entry_path))\n}\n\nexport fn cache_persistent_leaf_fingerprint_cache_path(version_tag: String, path: String, source_fingerprint: String) -> String {\n  rebase_cache_path(persistent_leaf_fingerprint_cache_path(version_tag, path, source_fingerprint))\n}\n\nexport fn cache_stable_text_cache_path(version_tag: String, prefix: String, seed: String) -> String {\n  rebase_cache_path(stable_cache_path(version_tag, prefix, seed, \".txt\"))\n}\n\nlet fingerprint_file_memo_paths = [\n]\n\nlet fingerprint_file_memo_tokens = [\n]\n\nlet fingerprint_file_memo_fps = [\n]\n\nlet ingestion_telemetry_enabled_cell = [\n]\n\nlet ingestion_telemetry_counters = [\n]\n\nlet ingestion_stamp_enabled_cell = [\n]\n\nfn ingestion_telemetry_enabled() -> Bool {\n  Array::length(ingestion_telemetry_enabled_cell) > 0 && Array::get(ingestion_telemetry_enabled_cell, 0)\n}\n\nexport fn cache_set_ingestion_fingerprint_telemetry_enabled(enabled: Bool) -> Unit {\n  Array::truncate(ingestion_telemetry_enabled_cell, 0)\n  Array::push(ingestion_telemetry_enabled_cell, enabled)\n  Array::truncate(ingestion_telemetry_counters, 0)\n  let mut i = 0\n  while i < 10 {\n    Array::push(ingestion_telemetry_counters, 0)\n    i = i + 1\n  }\n}\n\nfn ingestion_telemetry_add(index: Int, amount: Int) -> Unit {\n  if ingestion_telemetry_enabled() {\n    Array::set(ingestion_telemetry_counters, index, Array::get(ingestion_telemetry_counters, index) + amount)\n  } else {\n    ()\n  }\n}\n\nfn ingestion_telemetry_counter(index: Int) -> Int {\n  if ingestion_telemetry_enabled() {\n    Array::get(ingestion_telemetry_counters, index)\n  } else {\n    0\n  }\n}\n\nfn decimal_string_is_nonnegative(s: String) -> Bool {\n  let n = String::length(s)\n  if n == 0 {\n    false\n  } else {\n    let mut i = 0\n    let mut ok = true\n    while i < n {\n      let c = String::char_code_at(s, i)\n      if c < 48 || c > 57 {\n        ok = false\n      } else {\n        ()\n      }\n      i = i + 1\n    }\n    ok\n  }\n}\n\nexport fn cache_ingestion_compact_fingerprint_is_valid(fingerprint: String) -> Bool {\n  let parts = String::split(fingerprint, \":\")\n  Array::length(parts) == 3\n  && decimal_string_is_nonnegative(Array::get(parts, 0))\n  && decimal_string_is_nonnegative(Array::get(parts, 1))\n  && decimal_string_is_nonnegative(Array::get(parts, 2))\n}\n\nexport fn cache_ingestion_stamp_v1_text(stat_token_text: String, fingerprint: String) -> String {\n  String::concat(\"v1\\t\", String::concat(__to_string(String::length(stat_token_text)), String::concat(\"\\t\", String::concat(__to_string(String::length(fingerprint)), String::concat(\"\\t\", String::concat(stat_token_text, fingerprint))))))\n}\n\nfn parse_bounded_decimal(text: String, start: Int, end: Int, bound: Int) -> Option[Int] {\n  if start >= end {\n    None\n  } else {\n    let mut i = start\n    let mut value = 0\n    let mut ok = true\n    while i < end {\n      let c = String::char_code_at(text, i)\n      if c < 48 || c > 57 || value > (bound - (c - 48)) / 10 {\n        ok = false\n      } else {\n        value = value * 10 + (c - 48)\n      }\n      i = i + 1\n    }\n    if ok {\n      Some(value)\n    } else {\n      None\n    }\n  }\n}\n\nexport fn cache_parse_ingestion_stamp_v1_text(text: String) -> Option[(String, String)] {\n  let n = String::length(text)\n  if n < 7 || text[0: 3] != \"v1\\t\" {\n    None\n  } else {\n    let mut token_len_end = 3\n    while token_len_end < n && String::char_code_at(text, token_len_end) != 9 {\n      token_len_end = token_len_end + 1\n    }\n    let mut fingerprint_len_end = token_len_end + 1\n    while fingerprint_len_end < n && String::char_code_at(text, fingerprint_len_end) != 9 {\n      fingerprint_len_end = fingerprint_len_end + 1\n    }\n    if token_len_end >= n || fingerprint_len_end >= n {\n      None\n    } else {\n      let payload_start = fingerprint_len_end + 1\n      match (parse_bounded_decimal(text, 3, token_len_end, n - payload_start), parse_bounded_decimal(text, token_len_end + 1, fingerprint_len_end, n - payload_start)) {\n        (Some(token_len), Some(fingerprint_len)) => {\n          let fingerprint_start = payload_start + token_len\n          let payload_end = fingerprint_start + fingerprint_len\n          if token_len == 0 || fingerprint_len == 0 || fingerprint_start > n || payload_end != n {\n            None\n          } else {\n            let token = text[payload_start: fingerprint_start]\n            let fingerprint = text[fingerprint_start: payload_end]\n            if cache_ingestion_compact_fingerprint_is_valid(fingerprint) {\n              Some((token, fingerprint))\n            } else {\n              None\n            }\n          }\n        },\n        _ => None\n      }\n    }\n  }\n}\n\nfn fingerprint_source(path: String) -> String with { Fs } {\n  let source = Fs::read_file(path)\n  ingestion_telemetry_add(0, 1)\n  ingestion_telemetry_add(1, String::length(source))\n  let fingerprint = compact_string_fingerprint(source)\n  ingestion_telemetry_add(2, 1)\n  ingestion_telemetry_add(3, String::length(source))\n  fingerprint\n}\n\nfn try_load_ingestion_stamp(stamp_path: String, stat_token_text: String) -> Option[String] with { Fs } {\n  ingestion_telemetry_add(4, 1)\n  if !Fs::exists(stamp_path) {\n    ingestion_telemetry_add(6, 1)\n    None\n  } else {\n    let text = Fs::read_file(stamp_path)\n    ingestion_telemetry_add(8, String::length(text))\n    match cache_parse_ingestion_stamp_v1_text(text) {\n      None => {\n        ingestion_telemetry_add(7, 1)\n        None\n      },\n      Some((stored_token, fingerprint)) => {\n        if stored_token == stat_token_text {\n          ingestion_telemetry_add(5, 1)\n          Some(fingerprint)\n        } else {\n          ingestion_telemetry_add(6, 1)\n          None\n        }\n      }\n    }\n  }\n}\n\nfn publish_ingestion_stamp(stamp_path: String, stat_token_text: String, fingerprint: String) -> Unit with { Fs } {\n  Fs::write_file(stamp_path, cache_ingestion_stamp_v1_text(stat_token_text, fingerprint))\n  ingestion_telemetry_add(9, 1)\n}\n\nexport fn cache_ingestion_stamp_enabled() -> Bool {\n  if Array::length(ingestion_stamp_enabled_cell) == 0 {\n    Array::push(ingestion_stamp_enabled_cell, read_env_discharged(\"VIBE_EXPERIMENTAL_PERSISTENT_INGESTION_STAMP\") == \"1\")\n  } else {\n    ()\n  }\n  Array::get(ingestion_stamp_enabled_cell, 0)\n}\n\nexport fn cache_fingerprint_file_fs_with_ingestion_stamp(path: String, stamp_path: String) -> String with { Fs } {\n  let token = Fs::stat_token(path)\n  let token_text = __to_string(token)\n  let n = Array::length(fingerprint_file_memo_paths)\n  let mut i = 0\n  while i < n {\n    if Array::get(fingerprint_file_memo_paths, i) == path {\n      if Array::get(fingerprint_file_memo_tokens, i) == token {\n        return Array::get(fingerprint_file_memo_fps, i)\n      } else {\n        let fingerprint = match try_load_ingestion_stamp(stamp_path, token_text) {\n          Some(hit) => hit,\n          None => {\n            let fresh = fingerprint_source(path)\n            publish_ingestion_stamp(stamp_path, token_text, fresh)\n            fresh\n          }\n        }\n        Array::set(fingerprint_file_memo_tokens, i, token)\n        Array::set(fingerprint_file_memo_fps, i, fingerprint)\n        return fingerprint\n      }\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  let fingerprint = match try_load_ingestion_stamp(stamp_path, token_text) {\n    Some(hit) => hit,\n    None => {\n      let fresh = fingerprint_source(path)\n      publish_ingestion_stamp(stamp_path, token_text, fresh)\n      fresh\n    }\n  }\n  Array::push(fingerprint_file_memo_paths, path)\n  Array::push(fingerprint_file_memo_tokens, token)\n  Array::push(fingerprint_file_memo_fps, fingerprint)\n  fingerprint\n}\n\nexport fn cache_fingerprint_file_fs(path: String) -> String with { Fs } {\n  let token = Fs::stat_token(path)\n  let n = Array::length(fingerprint_file_memo_paths)\n  let mut i = 0\n  while i < n {\n    if Array::get(fingerprint_file_memo_paths, i) == path {\n      if Array::get(fingerprint_file_memo_tokens, i) == token {\n        return Array::get(fingerprint_file_memo_fps, i)\n      } else {\n        let fingerprint = fingerprint_source(path)\n        Array::set(fingerprint_file_memo_tokens, i, token)\n        Array::set(fingerprint_file_memo_fps, i, fingerprint)\n        return fingerprint\n      }\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  let fingerprint = fingerprint_source(path)\n  Array::push(fingerprint_file_memo_paths, path)\n  Array::push(fingerprint_file_memo_tokens, token)\n  Array::push(fingerprint_file_memo_fps, fingerprint)\n  fingerprint\n}\n\nfn json_escape_string(value: String) -> String {\n  let out = StringBuilder::new()\n  let mut i = 0\n  while i < String::length(value) {\n    let c = String::char_code_at(value, i)\n    if c == 34 {\n      StringBuilder::push(out, \"\\\\\\\"\")\n    }\n    else if c == 92 {\n      StringBuilder::push(out, \"\\\\\\\\\")\n    }\n    else if c == 8 {\n      StringBuilder::push(out, \"\\\\b\")\n    }\n    else if c == 9 {\n      StringBuilder::push(out, \"\\\\t\")\n    }\n    else if c == 10 {\n      StringBuilder::push(out, \"\\\\n\")\n    }\n    else if c == 12 {\n      StringBuilder::push(out, \"\\\\f\")\n    }\n    else if c == 13 {\n      StringBuilder::push(out, \"\\\\r\")\n    }\n    else if c >= 0 && c <= 31 {\n      let hex = \"0123456789abcdef\"\n      StringBuilder::push(out, \"\\\\u00\")\n      StringBuilder::push(out, hex[(c>>4): (c>>4) + 1])\n      StringBuilder::push(out, hex[(c&15): (c&15) + 1])\n    } else {\n      StringBuilder::push(out, String::from_char_code(c))\n    }\n    i = i + 1\n  }\n  StringBuilder::freeze(out)\n}\n\nexport fn cache_ingestion_fingerprint_telemetry_json(nonce: String) -> String {\n  let out = StringBuilder::new()\n  StringBuilder::push(out, \"{\\\"schema\\\":\\\"ingestion_fingerprint\\\",\\\"version\\\":1,\\\"nonce\\\":\\\"\")\n  StringBuilder::push(out, json_escape_string(nonce))\n  StringBuilder::push(out, \"\\\",\\\"source_read_calls\\\":\")\n  StringBuilder::push(out, __to_string(ingestion_telemetry_counter(0)))\n  StringBuilder::push(out, \",\\\"source_read_string_units\\\":\")\n  StringBuilder::push(out, __to_string(ingestion_telemetry_counter(1)))\n  StringBuilder::push(out, \",\\\"hash_calls\\\":\")\n  StringBuilder::push(out, __to_string(ingestion_telemetry_counter(2)))\n  StringBuilder::push(out, \",\\\"hash_input_string_units\\\":\")\n  StringBuilder::push(out, __to_string(ingestion_telemetry_counter(3)))\n  StringBuilder::push(out, \",\\\"stamp_probes\\\":\")\n  StringBuilder::push(out, __to_string(ingestion_telemetry_counter(4)))\n  StringBuilder::push(out, \",\\\"stamp_hits\\\":\")\n  StringBuilder::push(out, __to_string(ingestion_telemetry_counter(5)))\n  StringBuilder::push(out, \",\\\"stamp_misses\\\":\")\n  StringBuilder::push(out, __to_string(ingestion_telemetry_counter(6)))\n  StringBuilder::push(out, \",\\\"stamp_malformed\\\":\")\n  StringBuilder::push(out, __to_string(ingestion_telemetry_counter(7)))\n  StringBuilder::push(out, \",\\\"stamp_text_units_read\\\":\")\n  StringBuilder::push(out, __to_string(ingestion_telemetry_counter(8)))\n  StringBuilder::push(out, \",\\\"stamp_publications\\\":\")\n  StringBuilder::push(out, __to_string(ingestion_telemetry_counter(9)))\n  StringBuilder::push(out, \"}\")\n  StringBuilder::freeze(out)\n}")
}

let source_177 = () -> (String, String) {
  ("lib/@vibe/compiler/cache/persistent_cache.vibe",
"\n\n\nimport @vibe/compiler/core {\n  is_contract_ext, resolution_env_seed, resolve_import_path_candidates\n}\n\n\n\n\nfn persistent_cache_version_tag() -> String {\n  String::concat(\"v14|cg-\", codegen_fingerprint())\n}\n\nexport fn persistent_artifact_cache_path(kind: String, entry_name: String, fingerprint: String) -> String {\n  cache_persistent_artifact_cache_path(persistent_cache_version_tag(), kind, entry_name, fingerprint)\n}\n\nexport fn store_persistent_artifact(kind: String, entry_name: String, fingerprint: String, bytes: Bytes) -> Unit with { Error, Fs } {\n  cache_store_persistent_artifact(persistent_cache_version_tag(), kind, entry_name, fingerprint, bytes)\n}\n\nexport fn load_persistent_artifact(kind: String, entry_name: String, fingerprint: String) -> Option[Bytes] with { Error, Fs } {\n  cache_load_persistent_artifact(persistent_cache_version_tag(), kind, entry_name, fingerprint)\n}\n\nexport fn persistent_dep_list_cache_path(path: String, source_fingerprint: String) -> String {\n  cache_persistent_dep_list_cache_path(persistent_cache_version_tag(), path, source_fingerprint, resolution_env_seed())\n}\n\nexport fn persistent_type_env_cache_path(fingerprint: String) -> String {\n  cache_persistent_type_env_cache_path(persistent_cache_version_tag(), fingerprint)\n}\n\nexport fn persistent_typing_dependency_env_reuse_sidecar_path(typing_input_key: String) -> String {\n  cache_stable_text_cache_path(persistent_cache_version_tag(), \"selfhost_typing_dependency_env_reuse_v1\", typing_input_key)\n}\n\nexport fn persistent_typing_dependency_env_reuse_eligibility_path(fingerprint: String) -> String {\n  cache_stable_text_cache_path(persistent_cache_version_tag(), \"selfhost_typing_dependency_env_reuse_eligibility_v1\", fingerprint)\n}\n\nexport fn persistent_source_list_cache_path(entry_path: String) -> String {\n  cache_persistent_source_list_cache_path(persistent_cache_version_tag(), entry_path, resolution_env_seed())\n}\n\nexport fn persistent_source_group_cache_path(entry_path: String) -> String {\n  cache_persistent_source_group_cache_path(persistent_cache_version_tag(), entry_path, resolution_env_seed())\n}\n\nexport fn persistent_module_header_cache_path(path: String, source_fingerprint: String) -> String {\n  cache_persistent_module_header_cache_path(persistent_cache_version_tag(), path, source_fingerprint, resolution_env_seed())\n}\n\nexport fn persistent_manifest_header_cache_path(entry_path: String) -> String {\n  cache_persistent_manifest_header_cache_path(persistent_cache_version_tag(), entry_path)\n}\n\nexport fn persistent_leaf_fingerprint_cache_path(path: String, source_fingerprint: String) -> String {\n  cache_persistent_leaf_fingerprint_cache_path(persistent_cache_version_tag(), path, source_fingerprint)\n}\n\nexport fn persistent_ingestion_stamp_cache_path(path: String) -> String {\n  let resolution_seed = resolution_env_seed()\n  let logical_path_seed = String::concat(\"res:\", String::concat(__to_string(String::length(resolution_seed)), String::concat(\":\", String::concat(resolution_seed, String::concat(\"|path:\", String::concat(__to_string(String::length(path)), String::concat(\":\", path)))))))\n  cache_stable_text_cache_path(persistent_cache_version_tag(), \"selfhost_ingestion_stamp_v1\", logical_path_seed)\n}\n\nexport fn fingerprint_file_fs(path: String) -> String with { Fs } {\n  if cache_ingestion_stamp_enabled() {\n    cache_fingerprint_file_fs_with_ingestion_stamp(path, persistent_ingestion_stamp_cache_path(path))\n  } else {\n    cache_fingerprint_file_fs(path)\n  }\n}\n\nexport fn set_ingestion_fingerprint_telemetry_enabled(enabled: Bool) -> Unit {\n  cache_set_ingestion_fingerprint_telemetry_enabled(enabled)\n}\n\nexport fn ingestion_fingerprint_telemetry_json(nonce: String) -> String {\n  cache_ingestion_fingerprint_telemetry_json(nonce)\n}\n\nexport fn ingestion_stamp_v1_text_for_test(stat_token_text: String, fingerprint: String) -> String {\n  cache_ingestion_stamp_v1_text(stat_token_text, fingerprint)\n}\n\nexport fn parse_ingestion_stamp_v1_text_for_test(text: String) -> Option[(String, String)] {\n  cache_parse_ingestion_stamp_v1_text(text)\n}\n\nexport fn ingestion_compact_fingerprint_is_valid_for_test(fingerprint: String) -> Bool {\n  cache_ingestion_compact_fingerprint_is_valid(fingerprint)\n}\n\nexport fn persistent_vpkg_prefix_cache_path(path: String, source_fingerprint: String) -> String {\n  cache_stable_text_cache_path(persistent_cache_version_tag(), \"selfhost_vpkg_prefix\", String::concat(path, String::concat(\"|\", String::concat(source_fingerprint, resolution_env_seed()))))\n}\n\nexport fn persistent_contract_facade_cache_path(path: String, closure_fingerprint: String) -> String {\n  cache_stable_text_cache_path(persistent_cache_version_tag(), \"selfhost_contract_facade\", String::concat(path, String::concat(\"|\", String::concat(closure_fingerprint, resolution_env_seed()))))\n}\n\nfn package_ref_of_index_dep(dep: String) -> Option[String] {\n  if is_contract_ext(dep) {\n    let parts = String::split(dep, \"/\")\n    let n = Array::length(parts)\n    if n >= 3 && String::starts_with(Array::get(parts, n - 3), \"@\") {\n      Some(String::concat(Array::get(parts, n - 3), String::concat(\"/\", Array::get(parts, n - 2))))\n    } else {\n      None\n    }\n  } else {\n    None\n  }\n}\n\nexport fn package_index_dep_is_current(dep: String) -> Bool with { Fs } {\n  match package_ref_of_index_dep(dep) {\n    None => true,\n    Some(pkg_ref) => {\n      let candidates = resolve_import_path_candidates(\"\", pkg_ref)\n      let mut i = 0\n      let mut winner = \"\"\n      while i < Array::length(candidates) {\n        if winner == \"\" {\n          let candidate = Array::get(candidates, i)\n          if Fs::exists(candidate) {\n            winner = candidate\n          } else {\n            ()\n          }\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      if winner == \"\" {\n        Array::get(candidates, 0) == dep\n      } else {\n        winner == dep\n      }\n    }\n  }\n}\n\nexport fn package_index_deps_are_current(deps: Array[String]) -> Bool with { Fs } {\n  let mut i = 0\n  let mut ok = true\n  while i < Array::length(deps) {\n    if ok && !(package_index_dep_is_current(Array::get(deps, i))) {\n      ok = false\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  ok\n}\n")
}

let source_178 = () -> (String, String) {
  ("lib/@vibe/compiler/cache/index.vpkg",
"name = @vibe/compiler/cache\nversion = 0.0.1\ndescription =\n  #|@vibe/compiler/cache — ADR-0070 / #897 compiler-internal contract. This\ndeps = {\n  @vibe/cache : 0.0.1\n  @vibe/compiler/core : 0.0.1\n}\n\ngenerated_hash =\n\n// @vibe/compiler/cache — ADR-0070 / #897 compiler-internal contract. This\n// directory is the second-to-last plain directory under\n// lib/@vibe/compiler/ (the top-level directory itself is the true last\n// one, and depends on this batch + a sibling module_graph_path.vibe\n// relocation batch landing first, #897 tracking issue). Three impl files,\n// no facade rename (none of them was the old index.vibe, so no\n// `git mv index.vibe <dirname>.vibe` was needed):\n//\n//   - codegen_fingerprint.vibe: AUTO-GENERATED by scripts/generate_bundle.sh\n//     (#630). A single `export let codegen_fingerprint: () -> String = ...`\n//     zero-arg thunk, no imports.\n//   - cache_underlying.vibe: `cache_`-prefixed forwarding wrappers around\n//     the EXTERNAL @vibe/cache package's generic disk-cache primitives\n//     (#769 -- real wrapper fns, not `x as cache_x` import aliases, because\n//     generate_bundle.sh's bundle-merge lane resolves references by name\n//     and strips relative import lines, so an alias-only rename has no\n//     surviving definition). Also owns the VIBE_BUILD_CACHE_DIR override\n//     (#849) via a private, non-exported `effect Env` + checker-only\n//     discharge (mirrors module_graph_path.vibe's ADR-0065 pattern) so the\n//     8 path-returning wrappers don't need an `Env` row on their own\n//     signatures.\n//   - persistent_cache.vibe: the compiler-specific adapter over\n//     cache_underlying.vibe -- supplies the two identity components a\n//     generic cache can't know (the codegen fingerprint, #630, and\n//     VIBE_LIB's module-resolution env seed, #758) and re-exports the\n//     ORIGINAL @vibe/cache wrapper names/signatures so every existing\n//     compiler call site keeps working unchanged. Also owns the\n//     package-index-dep staleness check (package_index_dep_is_current /\n//     package_index_deps_are_current, #897) used to detect a cached\n//     module-header/dep-list row naming a `@scope/name` package-index dep\n//     that no longer resolves to the same on-disk root.\n//\n// `export ../../../../lib/@vibe/cache { .. }` SReExport (see\n// persistent_cache.vibe's own header comment): rewritten from the old bare\n// `import ../../../../lib/@vibe/cache {...}` + separate `export {...}`\n// two-step, which does NOT satisfy check_contract as an implementation for\n// a declared contract name (only a real local `export fn`/`export type`\n// body, or an SReExport, counts) -- same fix as core/ast.vibe's identical\n// rewrite for @vibe/ast's Expr/Pat/Stmt/TypeExpr. The 12 fn declarations\n// below for those re-exported names are satisfied by this SReExport at\n// face value; lib/@vibe/cache/index.vpkg is what actually pins their\n// shape.\n//\n// No bare-name collision across the three files: cache_underlying.vibe's\n// exports are ALL `cache_`-prefixed (cache_persistent_artifact_cache_path,\n// ...) while persistent_cache.vibe's own wrappers use the un-prefixed\n// `persistent_*` names -- distinct from the prelude/ batch's mid-session\n// collision precedent (two files exporting the identical bare name), which\n// does not recur here.\n//\n// No import cycle: persistent_cache.vibe's only compiler-internal\n// dependency outside this directory is ../module_graph_path.vibe (a\n// top-level compiler file, not yet relocated as of this batch -- see the\n// tracking-issue note above), which itself only imports the external\n// @vibe/core package -- it does not import cache/ back.\n\n// --- codegen_fingerprint\nfn codegen_fingerprint() -> String\n\n// --- cache_underlying\nfn cache_persistent_artifact_cache_path(version_tag: String, kind: String, entry_name: String, fingerprint: String) -> String\nfn cache_store_persistent_artifact(version_tag: String, kind: String, entry_name: String, fingerprint: String, bytes: Bytes) -> Unit with { Error, Fs }\nfn cache_load_persistent_artifact(version_tag: String, kind: String, entry_name: String, fingerprint: String) -> Option[Bytes] with { Error, Fs }\nfn cache_persistent_dep_list_cache_path(version_tag: String, path: String, source_fingerprint: String, resolution_seed: String) -> String\nfn cache_persistent_type_env_cache_path(version_tag: String, fingerprint: String) -> String\nfn cache_persistent_source_list_cache_path(version_tag: String, entry_path: String, resolution_seed: String) -> String\nfn cache_persistent_source_group_cache_path(version_tag: String, entry_path: String, resolution_seed: String) -> String\nfn cache_persistent_module_header_cache_path(version_tag: String, path: String, source_fingerprint: String, resolution_seed: String) -> String\nfn cache_persistent_manifest_header_cache_path(version_tag: String, entry_path: String) -> String\nfn cache_persistent_leaf_fingerprint_cache_path(version_tag: String, path: String, source_fingerprint: String) -> String\nfn cache_fingerprint_file_fs(path: String) -> String with { Fs }\nfn cache_fingerprint_file_fs_with_ingestion_stamp(path: String, stamp_path: String) -> String with { Fs }\nfn cache_ingestion_compact_fingerprint_is_valid(fingerprint: String) -> Bool\nfn cache_ingestion_stamp_enabled() -> Bool\nfn cache_ingestion_stamp_v1_text(stat_token_text: String, fingerprint: String) -> String\nfn cache_parse_ingestion_stamp_v1_text(text: String) -> Option[(String, String)]\nfn cache_set_ingestion_fingerprint_telemetry_enabled(enabled: Bool) -> Unit\nfn cache_ingestion_fingerprint_telemetry_json(nonce: String) -> String\nfn cache_stable_text_cache_path(version_tag: String, prefix: String, seed: String) -> String\n\n// --- persistent_cache (own wrappers)\nfn persistent_artifact_cache_path(kind: String, entry_name: String, fingerprint: String) -> String\nfn store_persistent_artifact(kind: String, entry_name: String, fingerprint: String, bytes: Bytes) -> Unit with { Error, Fs }\nfn load_persistent_artifact(kind: String, entry_name: String, fingerprint: String) -> Option[Bytes] with { Error, Fs }\nfn persistent_dep_list_cache_path(path: String, source_fingerprint: String) -> String\nfn persistent_type_env_cache_path(fingerprint: String) -> String\nfn persistent_typing_dependency_env_reuse_sidecar_path(typing_input_key: String) -> String\nfn persistent_typing_dependency_env_reuse_eligibility_path(fingerprint: String) -> String\nfn persistent_source_list_cache_path(entry_path: String) -> String\nfn persistent_source_group_cache_path(entry_path: String) -> String\nfn persistent_module_header_cache_path(path: String, source_fingerprint: String) -> String\nfn persistent_manifest_header_cache_path(entry_path: String) -> String\nfn persistent_leaf_fingerprint_cache_path(path: String, source_fingerprint: String) -> String\nfn persistent_vpkg_prefix_cache_path(path: String, source_fingerprint: String) -> String\nfn persistent_contract_facade_cache_path(path: String, closure_fingerprint: String) -> String\nfn package_index_dep_is_current(dep: String) -> Bool with { Fs }\nfn package_index_deps_are_current(deps: Array[String]) -> Bool with { Fs }\nfn fingerprint_file_fs(path: String) -> String with { Fs }\nfn persistent_ingestion_stamp_cache_path(path: String) -> String\nfn set_ingestion_fingerprint_telemetry_enabled(enabled: Bool) -> Unit\nfn ingestion_fingerprint_telemetry_json(nonce: String) -> String\nfn ingestion_stamp_v1_text_for_test(stat_token_text: String, fingerprint: String) -> String\nfn parse_ingestion_stamp_v1_text_for_test(text: String) -> Option[(String, String)]\nfn ingestion_compact_fingerprint_is_valid_for_test(fingerprint: String) -> Bool\n\n// --- persistent_cache (SReExport of lib/@vibe/cache, see header; exact\n// signatures copied from lib/@vibe/cache/index.vpkg -- that contract is\n// what actually pins these names' shape)\nfn compact_string_fingerprint(source: String) -> String\nfn compilation_input_fingerprint(sources: Array[(String, String)], entry_path: String) -> String\nfn build_source_groups_fingerprint(groups: Array[(String, Array[(String, String)])]) -> String\nfn normalize_persistent_cache_text(text: String) -> String\nfn build_source_groups_fingerprint_from_compact_fingerprints(groups: Array[(String, Array[(String, String)])]) -> String\nfn build_fs_compile_wasi_artifact_fingerprint_from_group_fingerprint(source_groups_fingerprint: String, entry_name: String) -> String\nfn build_fs_compile_wasi_artifact_fingerprint(source_groups: Array[(String, Array[(String, String)])], entry_name: String) -> String\nfn build_fs_compile_wasi_artifact_fingerprint_for_entry_path(source_groups: Array[(String, Array[(String, String)])], entry_path: String, entry_name: String) -> String\nfn build_fs_compile_wasi_artifact_fingerprint_from_group_fingerprint_for_entry_path(source_groups_fingerprint: String, entry_path: String, entry_name: String) -> String\nfn build_file_compile_wasi_artifact_fingerprint_from_group_fingerprint(source_groups_fingerprint: String, entry_name: String, mode: String) -> String\nfn build_file_compile_wasi_artifact_fingerprint(source_groups: Array[(String, Array[(String, String)])], entry_name: String, mode: String) -> String\nfn build_file_compile_wasi_artifact_fingerprint_for_entry_path(source_groups: Array[(String, Array[(String, String)])], entry_path: String, entry_name: String, mode: String) -> String\nfn build_file_compile_wasi_artifact_fingerprint_from_group_fingerprint_for_entry_path(source_groups_fingerprint: String, entry_path: String, entry_name: String, mode: String) -> String\nfn build_fs_compile_module_artifact_fingerprint_from_group_fingerprint(source_groups_fingerprint: String) -> String\nfn build_fs_compile_module_artifact_fingerprint(source_groups: Array[(String, Array[(String, String)])]) -> String\nfn build_fs_compile_module_artifact_fingerprint_for_entry_path(source_groups: Array[(String, Array[(String, String)])], entry_path: String) -> String\nfn build_fs_compile_module_artifact_fingerprint_from_group_fingerprint_for_entry_path(source_groups_fingerprint: String, entry_path: String) -> String\nfn build_file_compile_module_artifact_fingerprint_from_group_fingerprint(source_groups_fingerprint: String) -> String\nfn build_file_compile_module_artifact_fingerprint(source_groups: Array[(String, Array[(String, String)])]) -> String\nfn build_file_compile_module_artifact_fingerprint_for_entry_path(source_groups: Array[(String, Array[(String, String)])], entry_path: String) -> String\nfn build_file_compile_module_artifact_fingerprint_from_group_fingerprint_for_entry_path(source_groups_fingerprint: String, entry_path: String) -> String\n")
}

let source_179 = () -> (String, String) {
  ("lib/@vibe/compiler/core/module_graph_path.vibe",
"import @vibe/core {\n  array_empty\n}\n\n\nexport fn is_contract_ext(path: String) -> Bool {\n  String::ends_with(path, \".vibei\") || String::ends_with(path, \".vpkg\")\n}\n\nexport fn dir_of_path(file_path: String) -> String {\n  let idx = String::last_index_of(file_path, \"/\")\n  if idx < 0 {\n    \"\"\n  } else if idx == 0 {\n    \"/\"\n  } else {\n    file_path[0: idx]\n  }\n}\n\nexport fn ensure_regular_source_fs(path: String) -> Unit with { Error, Fs } {\n  if Fs::stat_token(path) == -1 {\n    throw(\"symlink module source is not allowed: \\{path}\")\n  } else {\n    ()\n  }\n}\n\nexport fn path_in_dir(dir: String, basename: String) -> String {\n  if dir == \"\" {\n    basename\n  } else if dir == \"/\" {\n    String::concat(\"/\", basename)\n  } else {\n    String::concat(String::concat(dir, \"/\"), basename)\n  }\n}\n\nexport fn vpkg_path_in_dir(dir: String) -> String {\n  path_in_dir(dir, \"index.vpkg\")\n}\n\nexport fn nearest_vpkg_path_fs(path: String) -> String with { Error, Fs } {\n  let mut current = dir_of_path(path)\n  let mut found = \"\"\n  let mut searching = true\n  while searching {\n    let candidate = vpkg_path_in_dir(current)\n    if Fs::exists(candidate) {\n      ensure_regular_source_fs(candidate)\n      found = candidate\n      searching = false\n    } else {\n      let parent = dir_of_path(current)\n      if parent == current {\n        searching = false\n      } else {\n        current = parent\n      }\n    }\n  }\n  found\n}\n\nexport fn contains_name(items: Array[String], name: String) -> Bool {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(items) && !found {\n    if Array::get(items, i) == name {\n      found = true\n    } else {\n      i = i + 1\n    }\n  }\n  found\n}\n\nexport fn contains_path(visited: Array[String], path: String) -> Bool {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(visited) && !found {\n    if Array::get(visited, i) == path {\n      found = true\n    } else {\n      i = i + 1\n    }\n  }\n  found\n}\n\nlet path_set_bucket_count = 64\n\nfn path_set_hash(s: String) -> Int {\n  let len = String::length(s)\n  let mut h = 5381\n  let mut i = 0\n  while i < len {\n    h = ((h * 33)^String::char_code_at(s, i))&0x3FFFFFFF\n    i = i + 1\n  }\n  h\n}\n\nexport fn path_set_new() -> Array[Array[String]] {\n  let buckets = array_empty()\n  let mut i = 0\n  while i < path_set_bucket_count {\n    Array::push(buckets, array_empty())\n    i = i + 1\n  }\n  buckets\n}\n\nexport fn path_set_contains(set: Array[Array[String]], path: String) -> Bool {\n  let bucket = Array::get(set, path_set_hash(path)&(path_set_bucket_count - 1))\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(bucket) && !found {\n    if Array::get(bucket, i) == path {\n      found = true\n    } else {\n      i = i + 1\n    }\n  }\n  found\n}\n\nexport fn path_set_add(set: Array[Array[String]], path: String) -> Unit {\n  Array::push(Array::get(set, path_set_hash(path)&(path_set_bucket_count - 1)), path)\n}\n\nexport fn normalize_path(path: String) -> String {\n  let is_absolute = String::length(path) > 0 && String::char_code_at(path, 0) == 47\n  let mut parts = array_empty()\n  let len = String::length(path)\n  let mut start = 0\n  let mut i = 0\n  while i <= len {\n    let at_sep = if i == len {\n      true\n    } else {\n      String::char_code_at(path, i) == 47\n    }\n    if at_sep {\n      let part = path[start: i]\n      let skip_part = if String::length(part) == 0 {\n        true\n      } else {\n        part == \".\"\n      }\n      if skip_part {\n        ()\n      } else if part == \"..\" {\n        if Array::length(parts) > 0 {\n          Array::truncate(parts, Array::length(parts) - 1)\n        }\n      } else {\n        Array::push(parts, part)\n      }\n      start = i + 1\n    }\n    i = i + 1\n  }\n  let buf = StringBuilder::new()\n  if is_absolute {\n    StringBuilder::push(buf, \"/\")\n  }\n  let mut pi = 0\n  while pi < Array::length(parts) {\n    if pi > 0 {\n      StringBuilder::push(buf, \"/\")\n    }\n    StringBuilder::push(buf, Array::get(parts, pi))\n    pi = pi + 1\n  }\n  StringBuilder::freeze(buf)\n}\n\nexport fn get_export_name(items: Array[(String, Option[String])], name: String) -> String {\n  let mut result = name\n  let mut i = 0\n  while i < Array::length(items) {\n    let (iname, irename) = Array::get(items, i)\n    if iname == name {\n      match irename {\n        Some(alias) => {\n          result = alias\n        },\n        None => ()\n      }\n    }\n    i = i + 1\n  }\n  result\n}\n\nfn join_relative_path(base_dir: String, raw_path: String) -> String {\n  if base_dir == \"\" || base_dir == \"/\" {\n    String::concat(base_dir, raw_path)\n  } else {\n    String::concat(base_dir, String::concat(\"/\", raw_path))\n  }\n}\n\nexport fn path_to_module_name(path: String) -> String {\n  let len = String::length(path)\n  let mut last_slash = -1\n  let mut i = 0\n  while i < len {\n    if String::char_code_at(path, i) == 47 {\n      last_slash = i\n    }\n    i = i + 1\n  }\n  let base = if last_slash >= 0 {\n    path[last_slash + 1: len]\n  } else {\n    path\n  }\n  let base_len = String::length(base)\n  if String::ends_with(base, \".vibe\") {\n    base[0: base_len - 5]\n  } else {\n    base\n  }\n}\n\nexport fn path_has_relative_prefix(raw_path: String, len: Int) -> Bool {\n  if raw_path == \".\" || raw_path == \"..\" {\n    true\n  } else if len >= 2 {\n    if raw_path[0: 2] == \"./\" {\n      true\n    } else if len >= 3 {\n      raw_path[0: 3] == \"../\"\n    } else {\n      false\n    }\n  } else {\n    false\n  }\n}\n\nexport fn resolve_import_path(base_dir: String, raw_path: String) -> String {\n  let len = String::length(raw_path)\n  let joined = if path_has_relative_prefix(raw_path, len) {\n    join_relative_path(base_dir, raw_path)\n  } else {\n    raw_path\n  }\n  let normalized = normalize_path(joined)\n  if String::ends_with(normalized, \".vibe\") {\n    normalized\n  } else {\n    String::concat(normalized, \".vibe\")\n  }\n}\n\neffect Env {\n  Get(String) -> String\n}\n\nfn env_get_raw(name: String) -> String with { Env } {\n  Env::get(name)\n}\n\nfn read_env_discharged(name: String) -> String {\n  handle {\n    env_get_raw(name)\n  } with Env {\n    Get(_n) => resume(\"\")\n  }\n}\n\nfn strip_trailing_slash(p: String) -> String {\n  let len = String::length(p)\n  if len > 1 && String::ends_with(p, \"/\") {\n    p[0: len - 1]\n  } else {\n    p\n  }\n}\n\nexport fn parse_vibe_lib_roots(vibe_lib: String, vibe_home: String, home: String) -> Array[String] {\n  let roots = array_empty()\n  if String::length(vibe_lib) > 0 {\n    let parts = String::split(vibe_lib, \":\")\n    let mut i = 0\n    while i < Array::length(parts) {\n      let part = Array::get(parts, i)\n      if String::length(part) > 0 {\n        Array::push(roots, strip_trailing_slash(part))\n      } else {\n        ()\n      }\n      i = i + 1\n    }\n  } else if String::length(vibe_home) > 0 {\n    Array::push(roots, String::concat(strip_trailing_slash(vibe_home), \"/lib\"))\n  } else if String::length(home) > 0 {\n    Array::push(roots, String::concat(strip_trailing_slash(home), \"/.vibe/lib\"))\n  } else {\n    ()\n  }\n  roots\n}\n\nexport fn external_lib_roots() -> Array[String] {\n  parse_vibe_lib_roots(read_env_discharged(\"VIBE_LIB\"), read_env_discharged(\"VIBE_HOME\"), read_env_discharged(\"HOME\"))\n}\n\nexport fn vibe_env_flag(name: String) -> Bool {\n  read_env_discharged(name) == \"1\"\n}\n\nexport fn resolution_env_seed() -> String {\n  let roots = external_lib_roots()\n  let pins = if vibe_env_flag(\"VIBE_REQUIRE_PINS\") {\n    \"1\"\n  } else {\n    \"0\"\n  }\n  String::concat(\"|roots=\", String::concat(String::join(roots, \":\"), String::concat(\"|pins=\", pins)))\n}\n\nexport fn resolve_import_path_candidates(base_dir: String, raw_path: String) -> Array[String] {\n  if String::starts_with(raw_path, \"@\") {\n    let candidates = array_empty()\n    Array::push(candidates, String::concat(\".vibe/store/\", String::concat(raw_path, \"/index.vpkg\")))\n    Array::push(candidates, String::concat(\".vibe/store/\", String::concat(raw_path, \"/index.vibei\")))\n    Array::push(candidates, String::concat(\"lib/\", String::concat(raw_path, \"/index.vpkg\")))\n    Array::push(candidates, String::concat(\"lib/\", String::concat(raw_path, \"/index.vibei\")))\n    let roots = external_lib_roots()\n    let mut ri = 0\n    while ri < Array::length(roots) {\n      Array::push(candidates, String::concat(Array::get(roots, ri), String::concat(\"/\", String::concat(raw_path, \"/index.vpkg\"))))\n      Array::push(candidates, String::concat(Array::get(roots, ri), String::concat(\"/\", String::concat(raw_path, \"/index.vibei\"))))\n      ri = ri + 1\n    }\n    return candidates\n  } else ()\n  let len = String::length(raw_path)\n  let joined = if path_has_relative_prefix(raw_path, len) {\n    join_relative_path(base_dir, raw_path)\n  } else {\n    raw_path\n  }\n  let normalized = normalize_path(joined)\n  if String::ends_with(normalized, \".vibe\") {\n    [\n      normalized\n    ]\n  } else {\n    [\n      String::concat(normalized, \".vibe\"),\n      String::concat(normalized, \"/index.vpkg\"),\n      String::concat(normalized, \"/index.vibei\"),\n      String::concat(normalized, \"/index.vibe\")\n    ]\n  }\n}\n")
}

let source_180 = () -> (String, String) {
  ("lib/@vibe/compiler/loader/header_cache.vibe",
"\nimport @vibe/cache {\n  parse_persistent_module_header_text, persistent_module_header_text\n}\n\nimport @vibe/core {\n  array_empty\n}\n\nimport @vibe/compiler/cache {\n  compact_string_fingerprint,\n  fingerprint_file_fs,\n  normalize_persistent_cache_text,\n  package_index_deps_are_current,\n  persistent_module_header_cache_path\n}\n\nimport @vibe/compiler/core {\n  Stmt,\n  dir_of_path,\n  ensure_regular_source_fs,\n  is_contract_ext,\n  nearest_vpkg_path_fs,\n  path_has_relative_prefix,\n  resolve_import_path_candidates\n}\n\nimport @vibe/compiler/runtime/eval_loader {\n  collect_exports\n}\n\nimport @vibe/compiler/syntax {\n  lex, lex_with_offsets, offset_to_line_col, parse_program, parse_program_located\n}\nimport @vibe/compiler/contract {\n  classify_contract_stmts, contract_facade_marker, extract_package_version, extract_require_pins, parse_contract_program\n}\n\n\nfn resolve_path_fs(base_dir: String, raw_path: String, self_path: String) -> String with { Fs } {\n  let candidates = resolve_import_path_candidates(base_dir, raw_path)\n  let mut i = 0\n  let mut found = \"\"\n  let mut fallback = \"\"\n  while i < Array::length(candidates) {\n    let candidate = Array::get(candidates, i)\n    if candidate == self_path {\n      ()\n    } else {\n      if fallback == \"\" {\n        fallback = candidate\n      } else {\n        ()\n      }\n      if found == \"\" && Fs::exists(candidate) {\n        found = candidate\n      } else {\n        ()\n      }\n    }\n    i = i + 1\n  }\n  if found == \"\" {\n    if fallback == \"\" {\n      Array::get(candidates, 0)\n    } else {\n      fallback\n    }\n  } else {\n    found\n  }\n}\n\nfn is_special_bundle_path(path: String) -> Bool {\n  String::ends_with(path, \"compiler_sources_bundle.vibe\") || String::ends_with(path, \"cli_adapter_bundle.vibe\") || String::ends_with(path, \"selfbuild_runtime_entry_bundle.vibe\")\n}\n\nfn special_bundle_header(path: String) -> Option[(Array[String], Array[String])] {\n  if String::ends_with(path, \"compiler_sources_bundle.vibe\") {\n    Some((array_empty(), [\n      \"compiler_sources\",\n      \"compiler_source_groups\"\n    ]))\n  } else if String::ends_with(path, \"cli_adapter_bundle.vibe\") {\n    Some((array_empty(), [\n      \"cli_adapter_sources\",\n      \"cli_adapter_source_groups\",\n      \"cli_adapter_ordered_sources\",\n      \"cli_adapter_merged_source\",\n      \"cli_adapter_module_source\"\n    ]))\n  } else if String::ends_with(path, \"selfbuild_runtime_entry_bundle.vibe\") {\n    Some((array_empty(), [\n      \"selfbuild_runtime_entry_source\"\n    ]))\n  } else {\n    None\n  }\n}\n\nfn located_missing_import_error(source: String, keyword: String, raw_path: String, resolved: String) -> String {\n  let base_msg = String::concat(\"cannot resolve import '\", String::concat(raw_path, String::concat(\"' (resolved to \", String::concat(resolved, \")\"))))\n  let needle = String::concat(keyword, String::concat(\" \", raw_path))\n  let needle_off = String::index_of(source, needle)\n  let off = if needle_off >= 0 {\n    needle_off + String::length(keyword) + 1\n  } else {\n    String::index_of(source, raw_path)\n  }\n  if off < 0 {\n    base_msg\n  } else {\n    let (line, col) = offset_to_line_col(source, off)\n    String::concat(\"line \", String::concat(__to_string(line), String::concat(\":\", String::concat(__to_string(col), String::concat(\": \", base_msg)))))\n  }\n}\n\nfn qualified_package_name_from_owner(owner: String) -> String {\n  let without_suffix = if String::ends_with(owner, \"/index.vpkg\") {\n    owner[0: String::length(owner) - String::length(\"/index.vpkg\")]\n  } else if String::ends_with(owner, \"/index.vibei\") {\n    owner[0: String::length(owner) - String::length(\"/index.vibei\")]\n  } else {\n    owner\n  }\n  if String::starts_with(without_suffix, \"lib/\") {\n    without_suffix[String::length(\"lib/\"): String::length(without_suffix)]\n  } else if String::starts_with(without_suffix, \".vibe/store/\") {\n    without_suffix[String::length(\".vibe/store/\"): String::length(without_suffix)]\n  } else {\n    without_suffix\n  }\n}\n\nfn located_package_boundary_error(source: String, keyword: String, raw_path: String, suggestion: String) -> String {\n  let base_msg = String::concat(\"relative \", String::concat(keyword, String::concat(\" '\", String::concat(raw_path, String::concat(\"' crosses a package boundary; use `\", String::concat(keyword, String::concat(\" \", String::concat(suggestion, \"` instead\"))))))))\n  let needle = String::concat(keyword, String::concat(\" \", raw_path))\n  let needle_off = String::index_of(source, needle)\n  let off = if needle_off >= 0 {\n    needle_off + String::length(keyword) + 1\n  } else {\n    String::index_of(source, raw_path)\n  }\n  if off < 0 {\n    base_msg\n  } else {\n    let (line, col) = offset_to_line_col(source, off)\n    String::concat(\"line \", String::concat(__to_string(line), String::concat(\":\", String::concat(__to_string(col), String::concat(\": \", base_msg)))))\n  }\n}\n\nfn enforce_relative_import_package_boundary_fs(raw_path: String, self_path: String, resolved: String, source: String, keyword: String) -> Unit with { Error, Fs } {\n  if keyword == \"import\" && path_has_relative_prefix(raw_path, String::length(raw_path)) {\n    let importer_owner = nearest_vpkg_path_fs(self_path)\n    let target_owner = nearest_vpkg_path_fs(resolved)\n    if importer_owner == \"\" || target_owner == \"\" || importer_owner == target_owner {\n      ()\n    } else {\n      throw(located_package_boundary_error(source, keyword, raw_path, qualified_package_name_from_owner(target_owner)))\n    }\n  } else ()\n}\n\nfn resolve_checked_path_fs(base_dir: String, raw_path: String, self_path: String, source: String, keyword: String) -> String with { Error, Fs } {\n  let resolved = resolve_path_fs(base_dir, raw_path, self_path)\n  if String::starts_with(raw_path, \"@\") || Fs::exists(resolved) {\n    enforce_relative_import_package_boundary_fs(raw_path, self_path, resolved, source, keyword)\n    resolved\n  } else {\n    throw(located_missing_import_error(source, keyword, raw_path, resolved))\n  }\n}\n\nfn is_contract_boundary_path(path: String) -> Bool {\n  String::ends_with(path, \"/index.vibei\") || String::ends_with(path, \"/index.vpkg\")\n}\n\nfn is_lowercase_leading_plain_ident(name: String) -> Bool {\n  if String::length(name) == 0 {\n    false\n  } else if String::index_of(name, \"::\") >= 0 {\n    false\n  } else {\n    let c = String::char_code_at(name, 0)\n    c >= 97 && c <= 122\n  }\n}\n\nfn string_array_contains_hc(items: Array[String], target: String) -> Bool {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(items) && !found {\n    if Array::get(items, i) == target {\n      found = true\n    } else {\n      i = i + 1\n    }\n  }\n  found\n}\n\nfn resolved_export_names_fs(resolved: String) -> Array[String] with { Error, Fs } {\n  let source = Fs::read_file(resolved)\n  if is_contract_ext(resolved) && !String::starts_with(source, contract_facade_marker) {\n    let (_, pin_blanked) = extract_require_pins(source)\n    let (cdecls, copaques, cextra) = parse_contract_program(lex(pin_blanked))\n    let names = collect_exports(cextra)\n    let mut cdi = 0\n    while cdi < Array::length(cdecls) {\n      let (cdname, _) = Array::get(cdecls, cdi)\n      Array::push(names, cdname)\n      cdi = cdi + 1\n    }\n    let mut coi = 0\n    while coi < Array::length(copaques) {\n      let (coname, _) = Array::get(copaques, coi)\n      Array::push(names, coname)\n      coi = coi + 1\n    }\n    if extract_package_version(source) == \"\" || string_array_contains_hc(names, \"version\") {\n      ()\n    } else {\n      Array::push(names, \"version\")\n    }\n    names\n  } else {\n    collect_exports(parse_program(lex(source)))\n  }\n}\n\nfn located_import_name_error(source: String, keyword: String, raw_path: String, name: String, display: String) -> String {\n  let base_msg = String::concat(\"\\\"\", String::concat(name, String::concat(\"\\\" is not exported by \", display)))\n  let needle = String::concat(keyword, String::concat(\" \", raw_path))\n  let needle_off = String::index_of(source, needle)\n  let off = if needle_off >= 0 {\n    needle_off + String::length(keyword) + 1\n  } else {\n    String::index_of(source, raw_path)\n  }\n  if off < 0 {\n    base_msg\n  } else {\n    let (line, col) = offset_to_line_col(source, off)\n    String::concat(\"line \", String::concat(__to_string(line), String::concat(\":\", String::concat(__to_string(col), String::concat(\": \", base_msg)))))\n  }\n}\n\nfn import_display_name(raw_path: String, resolved: String) -> String {\n  if String::starts_with(raw_path, \"@\") {\n    raw_path\n  } else {\n    let at = String::last_index_of(resolved, \"@\")\n    if at < 0 {\n      raw_path\n    } else {\n      let rest = String::substring(resolved, at, String::length(resolved))\n      let slash1 = String::index_of(rest, \"/\")\n      if slash1 < 0 {\n        raw_path\n      } else {\n        let after_scope = String::substring(rest, slash1 + 1, String::length(rest))\n        let slash2 = String::index_of(after_scope, \"/\")\n        if slash2 < 0 {\n          rest\n        } else {\n          String::substring(rest, 0, slash1 + 1 + slash2)\n        }\n      }\n    }\n  }\n}\n\nfn validate_import_names_fs(source: String, keyword: String, raw_path: String, resolved: String, names: Array[(String, Option[String])]) -> Unit with { Error, Fs } {\n  if is_contract_boundary_path(resolved) && Fs::exists(resolved) {\n    let mut dep_exports = array_empty()\n    let mut loaded = false\n    let mut i = 0\n    while i < Array::length(names) {\n      let (name, _alias) = Array::get(names, i)\n      if is_lowercase_leading_plain_ident(name) {\n        if !loaded {\n          dep_exports = resolved_export_names_fs(resolved)\n          loaded = true\n        } else ()\n        if string_array_contains_hc(dep_exports, name) {\n          ()\n        } else {\n          throw(located_import_name_error(source, keyword, raw_path, name, import_display_name(raw_path, resolved)))\n        }\n      } else ()\n      i = i + 1\n    }\n  } else ()\n}\n\nfn collect_import_deps_from_stmts(stmts: Array[Stmt], base_dir: String, self_path: String, source: String) -> Array[String] with { Error, Fs } {\n  let deps = array_empty()\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SImport(raw_path, names) => {\n        let resolved = resolve_checked_path_fs(base_dir, raw_path, self_path, source, \"import\")\n        validate_import_names_fs(source, \"import\", raw_path, resolved, names)\n        Array::push(deps, resolved)\n      },\n      SReExport(raw_path, names) => {\n        let resolved = resolve_checked_path_fs(base_dir, raw_path, self_path, source, \"export\")\n        validate_import_names_fs(source, \"export\", raw_path, resolved, names)\n        Array::push(deps, resolved)\n      },\n      _ => ()\n    }\n    i = i + 1\n  }\n  deps\n}\n\nfn directory_entry_path(dir: String, name: String) -> String {\n  if dir == \"\" {\n    name\n  } else if dir == \"/\" {\n    String::concat(\"/\", name)\n  } else {\n    String::concat(dir, String::concat(\"/\", name))\n  }\n}\n\nexport fn contract_sibling_impl_raws(dir: String) -> Array[String] with { Error, Fs } {\n  let out = array_empty()\n  let scan_dir = if dir == \"\" {\n    \".\"\n  } else {\n    dir\n  }\n  let names = Fs::readdir(scan_dir)\n  let mut i = 0\n  while i < Array::length(names) {\n    let name = Array::get(names, i)\n    if name != \"index.vibei\" && name != \"index.vibe\" && name != \"index.vpkg\" && String::ends_with(name, \".vibe\") && !String::ends_with(name, \"_test.vibe\") && !String::ends_with(name, \"_bench.vibe\") && !String::ends_with(name, \".draft.vibe\") && !String::starts_with(name, \"_\") {\n      let full = directory_entry_path(dir, name)\n      ensure_regular_source_fs(full)\n      Array::push(out, String::concat(\"./\", name))\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  out\n}\n\nexport fn merge_impl_raws_dedupe(explicit: Array[String], discovered: Array[String]) -> Array[String] {\n  let out = array_empty()\n  let mut i = 0\n  while i < Array::length(explicit) {\n    Array::push(out, Array::get(explicit, i))\n    i = i + 1\n  }\n  let mut j = 0\n  while j < Array::length(discovered) {\n    let d = Array::get(discovered, j)\n    let mut k = 0\n    let mut found = false\n    while k < Array::length(out) && !found {\n      if Array::get(out, k) == d {\n        found = true\n      } else {\n        k = k + 1\n      }\n    }\n    if !found {\n      Array::push(out, d)\n    } else {\n      ()\n    }\n    j = j + 1\n  }\n  out\n}\n\nexport fn load_or_parse_module_header_fs_impl(path: String, source: String, parse_count: Int) -> (Array[String], Array[String], Int) with { Error, Fs } {\n  let cache_path = persistent_module_header_cache_path(path, compact_string_fingerprint(source))\n  let mut warm_deps = array_empty()\n  let mut warm_exports = array_empty()\n  let mut warm_ok = false\n  if Fs::exists(cache_path) {\n    let parsed = parse_persistent_module_header_text(normalize_persistent_cache_text(Fs::read_file(cache_path)))\n    if parsed.3 && package_index_deps_are_current(parsed.0) && contract_dep_fingerprints_current(parsed.2) {\n      warm_deps = parsed.0\n      warm_exports = parsed.1\n      warm_ok = true\n    } else {\n      ()\n    }\n  } else {\n    ()\n  }\n  if warm_ok {\n    (warm_deps, warm_exports, parse_count)\n  } else {\n    let is_contract_source = is_contract_ext(path) && !String::starts_with(source, contract_facade_marker)\n    let header_result = if is_contract_source {\n      let (_, pin_blanked) = extract_require_pins(source)\n      let (cdecls, copaques, cextra) = parse_contract_program(lex(pin_blanked))\n      let cexports = collect_exports(cextra)\n      let mut cdi = 0\n      while cdi < Array::length(cdecls) {\n        let (cdname, _) = Array::get(cdecls, cdi)\n        Array::push(cexports, cdname)\n        cdi = cdi + 1\n      }\n      let mut coi = 0\n      while coi < Array::length(copaques) {\n        let (coname, _) = Array::get(copaques, coi)\n        Array::push(cexports, coname)\n        coi = coi + 1\n      }\n      if extract_package_version(source) == \"\" || string_array_contains_hc(cexports, \"version\") {\n        ()\n      } else {\n        Array::push(cexports, \"version\")\n      }\n      let cdeps = collect_import_deps_from_stmts(cextra, dir_of_path(path), path, pin_blanked)\n      let is_vpkg_contract = String::ends_with(path, \".vpkg\")\n      let cdeps2 = if is_vpkg_contract || Array::length(cdeps) == 0 {\n        let craws = if is_vpkg_contract {\n          let (craws0, _) = classify_contract_stmts(cextra)\n          merge_impl_raws_dedupe(craws0, contract_sibling_impl_raws(dir_of_path(path)))\n        } else {\n          contract_sibling_impl_raws(dir_of_path(path))\n        }\n        let resolved = array_empty()\n        let mut cri = 0\n        while cri < Array::length(craws) {\n          Array::push(resolved, resolve_path_fs(dir_of_path(path), Array::get(craws, cri), path))\n          cri = cri + 1\n        }\n        resolved\n      } else {\n        cdeps\n      }\n      (cdeps2, cexports, parse_count + 1)\n    } else if is_special_bundle_path(path) {\n      match special_bundle_header(path) {\n        Some(pair) => {\n          let deps = pair.0\n          let exports = pair.1\n          (deps, exports, parse_count)\n        },\n        None => (array_empty(), array_empty(), parse_count)\n      }\n    } else {\n      let (tokens, starts, _ends) = lex_with_offsets(source)\n      let stmts = handle {\n        parse_program_located(tokens, starts, source)\n      } with Error {\n        Throw(msg) => throw(String::concat(path, String::concat(\": \", msg)))\n      }\n      (collect_import_deps_from_stmts(stmts, dir_of_path(path), path, source), collect_exports(stmts), parse_count + 1)\n    }\n    let deps = header_result.0\n    let exports = header_result.1\n    let next_parse_count = header_result.2\n    Fs::write_file(cache_path, persistent_module_header_text(deps, exports, contract_dep_fingerprints_now(deps)))\n    (deps, exports, next_parse_count)\n  }\n}\n\nfn contract_dep_fingerprints_now(deps: Array[String]) -> Array[(String, String)] with { Fs } {\n  let out = array_empty()\n  let mut i = 0\n  while i < Array::length(deps) {\n    let d = Array::get(deps, i)\n    if is_contract_boundary_path(d) && Fs::exists(d) {\n      Array::push(out, (d, fingerprint_file_fs(d)))\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  out\n}\n\nfn contract_dep_fingerprints_current(cdeps: Array[(String, String)]) -> Bool with { Fs } {\n  let mut i = 0\n  let mut ok = true\n  while i < Array::length(cdeps) {\n    let (cpath, cfp) = Array::get(cdeps, i)\n    if ok {\n      if Fs::exists(cpath) {\n        ok = fingerprint_file_fs(cpath) == cfp\n      } else {\n        ok = false\n      }\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  ok\n}\n")
}

let source_181 = () -> (String, String) {
  ("lib/@vibe/compiler/loader/manifest_sources.vibe",
"\n\nimport @vibe/core {\n  array_empty\n}\n\nimport @vibe/compiler/cache {\n  compact_string_fingerprint, fingerprint_file_fs, normalize_persistent_cache_text, persistent_manifest_header_cache_path\n}\n\nimport @vibe/compiler/core {\n  contains_path, dir_of_path, is_contract_ext, normalize_path, path_set_add, path_set_contains, path_set_new, resolve_import_path_candidates\n}\n\nimport @vibe/compiler/syntax {\n  Token, collect_import_path, lex, peek, skip_semi\n}\n\nimport @vibe/compiler/contract {\n  extract_require_pins\n}\n\n\nexport fn join_path(base_dir: String, rel_path: String) -> String {\n  if base_dir == \"\" {\n    normalize_path(rel_path)\n  } else {\n    normalize_path(String::concat(base_dir, String::concat(\"/\", rel_path)))\n  }\n}\n\nfn resolve_manifest_dep_path(base_dir: String, raw_path: String, manifest_path_index: Map[String, Bool]) -> String with { Error, Fs } {\n  if String::length(raw_path) > 0 && String::char_code_at(raw_path, 0) == 64 {\n    let candidates = resolve_import_path_candidates(base_dir, raw_path)\n    let mut i = 0\n    let mut found = \"\"\n    while i < Array::length(candidates) {\n      if found == \"\" {\n        let candidate = Array::get(candidates, i)\n        if Map::has_key(manifest_path_index, candidate) || Fs::exists(candidate) {\n          found = candidate\n        } else ()\n      } else ()\n      i = i + 1\n    }\n    if found == \"\" {\n      raw_path\n    } else {\n      found\n    }\n  } else {\n    let candidates = resolve_import_path_candidates(base_dir, raw_path)\n    let mut i = 0\n    let mut found = \"\"\n    while i < Array::length(candidates) {\n      if found == \"\" {\n        let candidate = Array::get(candidates, i)\n        if Map::has_key(manifest_path_index, candidate) || Fs::exists(candidate) {\n          found = candidate\n        }\n      }\n      i = i + 1\n    }\n    if found == \"\" {\n      Array::get(candidates, 0)\n    } else {\n      found\n    }\n  }\n}\n\nfn starts_with_reexport_path_token(tok: Token) -> Bool {\n  match tok {\n    TDot => true,\n    TDotDot => true,\n    _ => false\n  }\n}\n\nfn is_ident_char(c: Int) -> Bool {\n  (c >= 'a' && c <= 'z') ||\n  (c >= 'A' && c <= 'Z') ||\n  (c >= '0' && c <= '9') ||\n  c == '_'\n}\n\nfn slice_eq_text(s: String, start: Int, text: String) -> Bool {\n  let text_len = String::length(text)\n  if start + text_len > String::length(s) {\n    false\n  } else {\n    let mut i = 0\n    let mut ok = true\n    while ok && i < text_len {\n      ok = String::char_code_at(s, start + i) == String::char_code_at(text, i)\n      i = i + 1\n    }\n    ok\n  }\n}\n\nfn starts_with_keyword_at(s: String, pos: Int, keyword: String) -> Bool {\n  let keyword_len = String::length(keyword)\n  if !(slice_eq_text(s, pos, keyword)) {\n    false\n  } else {\n    let before_ok = if pos == 0 {\n      true\n    } else {\n      !(is_ident_char(String::char_code_at(s, pos - 1)))\n    }\n    let after_pos = pos + keyword_len\n    let after_ok = if after_pos >= String::length(s) {\n      true\n    } else {\n      !(is_ident_char(String::char_code_at(s, after_pos)))\n    }\n    before_ok && after_ok\n  }\n}\n\nfn skip_header_ws_and_comments(s: String, len: Int, start: Int) -> Int {\n  let mut pos = start\n  let mut done = false\n  while !done && pos < len {\n    let c = String::char_code_at(s, pos)\n    if c == ' ' || c == '\\n' || c == '\\t' || c == '\\r' || c == ';' {\n      pos = pos + 1\n    } else if c == '/' && pos + 1 < len && String::char_code_at(s, pos + 1) == '/' {\n      pos = pos + 2\n      while pos < len && String::char_code_at(s, pos) != '\\n' {\n        pos = pos + 1\n      }\n    } else {\n      done = true\n    }\n  }\n  pos\n}\n\nfn scan_header_stmt_end(s: String, len: Int, start: Int) -> Int with { Error } {\n  let mut pos = start\n  let mut brace_depth = 0\n  let mut in_string = false\n  let mut string_quote = 0\n  let mut escape = false\n  let mut done = false\n  while pos < len && !done {\n    let c = String::char_code_at(s, pos)\n    if in_string {\n      if escape {\n        escape = false\n      } else if c == '\\\\' {\n        escape = true\n      } else if c == string_quote {\n        in_string = false\n      }\n      pos = pos + 1\n    } else if c == '\"' || c == '\\'' {\n      in_string = true\n      string_quote = c\n      pos = pos + 1\n    } else if c == '/' && pos + 1 < len && String::char_code_at(s, pos + 1) == '/' {\n      while pos < len && String::char_code_at(s, pos) != '\\n' {\n        pos = pos + 1\n      }\n    } else if c == '{' {\n      brace_depth = brace_depth + 1\n      pos = pos + 1\n    } else if c == '}' {\n      if brace_depth > 0 {\n        brace_depth = brace_depth - 1\n      }\n      pos = pos + 1\n    } else if brace_depth == 0 && (c == '\\n' || c == ';') {\n      done = true\n    } else {\n      pos = pos + 1\n    }\n  }\n  pos\n}\n\nfn skip_brace_list(tokens: Array[Token], pos: Int) -> Int with { Error } {\n  match peek(tokens, pos) {\n    TLBrace => {\n      let mut depth = 1\n      let mut i = pos + 1\n      while depth > 0 {\n        match peek(tokens, i) {\n          TLBrace => {\n            depth = depth + 1\n          },\n          TRBrace => {\n            depth = depth - 1\n          },\n          TEof => throw(\"unterminated brace list in manifest import scanner\"),\n          _ => ()\n        }\n        i = i + 1\n      }\n      i\n    }\n    _ => throw(\"expected '{' in manifest import scanner\")\n  }\n}\n\nfn scan_header_import_dep(tokens: Array[Token], pos: Int, base_dir: String, manifest_path_index: Map[String, Bool]) -> (String, Int) with { Error, Fs } {\n  let (raw_path, next_pos) = match peek(tokens, pos) {\n    TIdent(name) =>\n    if String::length(name) > 1 && String::char_code_at(name, 0) == 64 {\n      (name, pos + 1)\n    } else {\n      collect_import_path(tokens, pos, \"\")\n    },\n    _ => collect_import_path(tokens, pos, \"\")\n  }\n  let after_path = match peek(tokens, next_pos) {\n    TIdent(alias_name) =>\n    if String::length(alias_name) > 1 && String::char_code_at(alias_name, 0) == 64 {\n      next_pos + 1\n    } else {\n      next_pos\n    },\n    _ => next_pos\n  }\n  let end_pos = match peek(tokens, after_path) {\n    TLBrace => skip_brace_list(tokens, after_path),\n    _ => after_path\n  }\n  (resolve_manifest_dep_path(base_dir, raw_path, manifest_path_index), end_pos)\n}\n\nfn manifest_header_scan_source(path: String, source: String) -> String with { Error } {\n  if is_contract_ext(path) {\n    let (_, blanked) = extract_require_pins(source)\n    blanked\n  } else {\n    source\n  }\n}\n\nfn collect_manifest_header_deps_from_source(path: String, raw_source: String, manifest_path_index: Map[String, Bool]) -> Array[String] with { Error, Fs } {\n  let deps = array_empty()\n  let base_dir = dir_of_path(path)\n  let source = manifest_header_scan_source(path, raw_source)\n  let len = String::length(source)\n  let mut pos = 0\n  let mut done = false\n  while !done {\n    pos = skip_header_ws_and_comments(source, len, pos)\n    if pos >= len {\n      done = true\n    } else {\n      let is_import = starts_with_keyword_at(source, pos, \"import\")\n      let is_export = starts_with_keyword_at(source, pos, \"export\")\n      if !(is_import || is_export) {\n        done = true\n      } else {\n        let stmt_end = scan_header_stmt_end(source, len, pos)\n        let stmt_source = source[pos: stmt_end]\n        let tokens = lex(stmt_source)\n        let stmt_pos = skip_semi(tokens, 0)\n        match peek(tokens, stmt_pos) {\n          TImport => {\n            let (dep_path, _) = scan_header_import_dep(tokens, stmt_pos + 1, base_dir, manifest_path_index)\n            Array::push(deps, dep_path)\n          },\n          TExport => {\n            if starts_with_reexport_path_token(peek(tokens, stmt_pos + 1)) {\n              let (dep_path, _) = scan_header_import_dep(tokens, stmt_pos + 1, base_dir, manifest_path_index)\n              Array::push(deps, dep_path)\n            }\n          },\n          _ => {\n            done = true\n          }\n        }\n        pos = stmt_end\n      }\n    }\n  }\n  if String::ends_with(path, \".vpkg\") {\n    let discovered_raws = contract_sibling_impl_raws(base_dir)\n    let mut di = 0\n    let discovered_deps = array_empty()\n    while di < Array::length(discovered_raws) {\n      Array::push(discovered_deps, resolve_manifest_dep_path(base_dir, Array::get(discovered_raws, di), manifest_path_index))\n      di = di + 1\n    }\n    merge_impl_raws_dedupe(deps, discovered_deps)\n  } else {\n    deps\n  }\n}\n\nfn collect_manifest_header_deps_from_source_with_context(path: String, source: String, manifest_path_index: Map[String, Bool]) -> Array[String] with { Error, Fs } {\n  handle {\n    collect_manifest_header_deps_from_source(path, source, manifest_path_index)\n  } with Error {\n    Throw(err) => throw(\"manifest header scan failed for \" + path + \": \" + err)\n  }\n}\n\nfn is_manifest_external_terminal_dep(path: String) -> Bool {\n  String::ends_with(path, \"compiler_sources_bundle.vibe\")\n}\n\nfn should_schedule_manifest_dep(dep_path: String, manifest_path_index: Map[String, Bool]) -> Bool {\n  if Map::has_key(manifest_path_index, dep_path) {\n    true\n  } else {\n    !(is_manifest_external_terminal_dep(dep_path))\n  }\n}\n\nfn load_or_parse_module_header_deps_with_context(path: String, source: String) -> Array[String] with { Error, Fs } {\n  handle {\n    let (deps, _, _) = load_or_parse_module_header_fs_impl(path, source, 0)\n    deps\n  } with Error {\n    Throw(err) => throw(\"module header parse failed for \" + path + \": \" + err)\n  }\n}\n\nexport fn build_manifest_source_index(sources: Array[(String, String)]) -> Map[String, String] {\n  let builder = MapBuilder::new()\n  let mut i = 0\n  while i < Array::length(sources) {\n    let (path, source) = Array::get(sources, i)\n    MapBuilder::set(builder, path, source)\n    i = i + 1\n  }\n  MapBuilder::freeze(builder)\n}\n\nfn source_lookup_in_index(source_index: Map[String, String], path_key: String) -> Option[String] {\n  if Map::has_key(source_index, path_key) {\n    Some(Map::get(source_index, path_key))\n  } else {\n    None\n  }\n}\n\nexport fn build_manifest_path_index(paths: Array[String]) -> Map[String, Bool] {\n  let builder = MapBuilder::new()\n  let mut i = 0\n  while i < Array::length(paths) {\n    MapBuilder::set(builder, Array::get(paths, i), true)\n    i = i + 1\n  }\n  MapBuilder::freeze(builder)\n}\n\nfn empty_path_index() -> Map[String, Bool] {\n  let builder = MapBuilder::new()\n  MapBuilder::freeze(builder)\n}\n\nfn build_manifest_path_index_from_rows(base_dir: String, rows: Array[(String, String)]) -> Map[String, Bool] {\n  let builder = MapBuilder::new()\n  let mut i = 0\n  while i < Array::length(rows) {\n    let (_, rel_path) = Array::get(rows, i)\n    MapBuilder::set(builder, join_path(base_dir, rel_path), true)\n    i = i + 1\n  }\n  MapBuilder::freeze(builder)\n}\n\nfn find_manifest_base_dir(entry_path: String) -> Option[String] with { Fs } {\n  let mut base_dir = dir_of_path(entry_path)\n  let mut found = None\n  let mut done = false\n  loop {\n    if done {\n      break\n    }\n    let manifest_path = join_path(base_dir, \"compiler_sources_manifest.tsv\")\n    if Fs::exists(manifest_path) {\n      found = Some(base_dir)\n      done = true\n    } else if base_dir == \"\" {\n      done = true\n    } else {\n      let parent = dir_of_path(base_dir)\n      if parent == base_dir {\n        done = true\n      } else {\n        base_dir = parent\n      }\n    }\n  }\n  found\n}\n\nfn strip_trailing_cr(line: String) -> String {\n  let len = String::length(line)\n  if len > 0 {\n    if String::char_code_at(line, len - 1) == 13 {\n      line[0: len - 1]\n    } else {\n      line\n    }\n  } else {\n    line\n  }\n}\n\nfn find_char(s: String, target: Int) -> Int {\n  let len = String::length(s)\n  let mut i = 0\n  let mut result = -1\n  while i < len {\n    if String::char_code_at(s, i) == target {\n      result = i\n      i = len\n    } else {\n      i = i + 1\n    }\n  }\n  result\n}\n\nfn split_tsv_fields(line: String) -> Array[String] {\n  let fields = array_empty()\n  let len = String::length(line)\n  let mut start = 0\n  let mut i = 0\n  while i <= len {\n    let at_field_end = if i == len {\n      true\n    } else {\n      String::char_code_at(line, i) == 9\n    }\n    if at_field_end {\n      Array::push(fields, line[start: i])\n      start = i + 1\n    }\n    i = i + 1\n  }\n  fields\n}\n\nlet header_value_separator = String::from_char_code(31)\n\nfn join_header_values(values: Array[String]) -> String {\n  let out = StringBuilder::new()\n  let mut i = 0\n  while i < Array::length(values) {\n    if i > 0 {\n      StringBuilder::push(out, header_value_separator)\n    }\n    StringBuilder::push(out, Array::get(values, i))\n    i = i + 1\n  }\n  StringBuilder::freeze(out)\n}\n\nfn split_header_values(text: String) -> Array[String] {\n  let values = array_empty()\n  if String::length(text) == 0 {\n    values\n  } else {\n    let sep = String::char_code_at(header_value_separator, 0)\n    let len = String::length(text)\n    let mut start = 0\n    let mut i = 0\n    while i <= len {\n      let at_value_end = if i == len {\n        true\n      } else {\n        String::char_code_at(text, i) == sep\n      }\n      if at_value_end {\n        Array::push(values, text[start: i])\n        start = i + 1\n      }\n      i = i + 1\n    }\n    values\n  }\n}\n\nfn empty_manifest_header_cache_rows() -> Array[(String, String, String, String)] {\n  array_empty()\n}\n\nfn empty_grouped_sources() -> Array[(String, Array[(String, String)])] {\n  array_empty()\n}\n\nfn ensure_grouped_source_bucket_seeded(groups: Array[(String, Array[(String, String)])], group_name: String, path: String, value: String) -> Array[(String, String)] {\n  let mut i = 0\n  let mut found = None\n  while i < Array::length(groups) {\n    let (name, sources) = Array::get(groups, i)\n    if name == group_name {\n      found = Some(sources)\n      i = Array::length(groups)\n    } else {\n      i = i + 1\n    }\n  }\n  match found {\n    Some(sources) => {\n      Array::push(sources, (path, value))\n      sources\n    },\n    None => {\n      let sources = array_empty()\n      Array::push(sources, (path, value))\n      Array::push(groups, (group_name, sources))\n      sources\n    }\n  }\n}\n\nfn build_grouped_sources_from_manifest_rows_with_lookup(base_dir: String, rows: Array[(String, String)], on_path: (String) -> Option[String]) -> Array[(String, Array[(String, String)])] {\n  let groups = empty_grouped_sources()\n  let mut last_group_name = \"\"\n  let mut last_group_sources = array_empty()\n  let mut has_last_group = false\n  let mut i = 0\n  while i < Array::length(rows) {\n    let (group_name, rel_path) = Array::get(rows, i)\n    let path = join_path(base_dir, rel_path)\n    match on_path(path) {\n      Some(source) => {\n        if has_last_group && last_group_name == group_name {\n          Array::push(last_group_sources, (path, source))\n        } else {\n          let ensured = ensure_grouped_source_bucket_seeded(groups, group_name, path, source)\n          last_group_name = group_name\n          last_group_sources = ensured\n          has_last_group = true\n        }\n      },\n      None => ()\n    }\n    i = i + 1\n  }\n  groups\n}\n\n\nfn parse_source_manifest_rows(manifest_source: String) -> Array[(String, String)] with { Error } {\n  let rows = array_empty()\n  let len = String::length(manifest_source)\n  let mut line_start = 0\n  let mut i = 0\n  while i <= len {\n    let at_line_end = if i == len {\n      true\n    } else {\n      String::char_code_at(manifest_source, i) == 10\n    }\n    if at_line_end {\n      let raw_line = strip_trailing_cr(manifest_source[line_start: i])\n      let line_len = String::length(raw_line)\n      let has_content = line_len > 0\n      let is_comment = if has_content {\n        String::char_code_at(raw_line, 0) == 35\n      } else {\n        false\n      }\n      if has_content {\n        if is_comment {\n          ()\n        } else {\n          let tab_idx = find_char(raw_line, 9)\n          let invalid_row = if tab_idx < 0 {\n            true\n          } else {\n            tab_idx + 1 >= line_len\n          }\n          if invalid_row {\n            throw(String::concat(\"invalid source manifest row: \", raw_line))\n          }\n          let group = raw_line[0: tab_idx]\n          let path = raw_line[tab_idx + 1: line_len]\n          Array::push(rows, (group, path))\n        }\n      }\n      line_start = i + 1\n    }\n    i = i + 1\n  }\n  rows\n}\n\nexport fn try_load_manifest_rows(entry_path: String) -> Option[(String, Array[(String, String)])] with { Error, Fs } {\n  match find_manifest_base_dir(entry_path) {\n    Some(base_dir) => {\n      let manifest_path = join_path(base_dir, \"compiler_sources_manifest.tsv\")\n      let rows = parse_source_manifest_rows(Fs::read_file(manifest_path))\n      let mut has_entry = false\n      let mut i = 0\n      while i < Array::length(rows) {\n        let (_, rel_path) = Array::get(rows, i)\n        let path = join_path(base_dir, rel_path)\n        if path == entry_path {\n          has_entry = true\n        }\n        i = i + 1\n      }\n      if has_entry {\n        Some((base_dir, rows))\n      } else {\n        None\n      }\n    },\n    None => None\n  }\n}\n\nexport fn load_manifest_full_sources(base_dir: String, rows: Array[(String, String)]) -> Array[(String, String)] with { Error, Fs } {\n  let full_sources = array_empty()\n  let mut i = 0\n  while i < Array::length(rows) {\n    let (_, rel_path) = Array::get(rows, i)\n    let path = join_path(base_dir, rel_path)\n    Array::push(full_sources, (path, Fs::read_file(path)))\n    i = i + 1\n  }\n  full_sources\n}\n\nfn load_manifest_sources_by_path_index(base_dir: String, rows: Array[(String, String)], needed_path_index: Map[String, Bool]) -> Array[(String, String)] with { Error, Fs } {\n  let sources = array_empty()\n  let mut i = 0\n  while i < Array::length(rows) {\n    let (_, rel_path) = Array::get(rows, i)\n    let path = join_path(base_dir, rel_path)\n    if Map::has_key(needed_path_index, path) {\n      Array::push(sources, (path, Fs::read_file(path)))\n    }\n    i = i + 1\n  }\n  sources\n}\n\nfn load_manifest_source_groups_by_path_index(base_dir: String, rows: Array[(String, String)], needed_path_index: Map[String, Bool]) -> Array[(String, Array[(String, String)])] with { Error, Fs } {\n  let groups = empty_grouped_sources()\n  let mut last_group_name = \"\"\n  let mut last_group_sources = array_empty()\n  let mut has_last_group = false\n  let mut i = 0\n  while i < Array::length(rows) {\n    let (group_name, rel_path) = Array::get(rows, i)\n    let path = join_path(base_dir, rel_path)\n    if Map::has_key(needed_path_index, path) {\n      if has_last_group && last_group_name == group_name {\n        Array::push(last_group_sources, (path, Fs::read_file(path)))\n      } else {\n        let ensured = ensure_grouped_source_bucket_seeded(groups, group_name, path, Fs::read_file(path))\n        last_group_name = group_name\n        last_group_sources = ensured\n        has_last_group = true\n      }\n    }\n    i = i + 1\n  }\n  groups\n}\n\nexport fn build_grouped_sources_from_manifest_row_source_index(base_dir: String, rows: Array[(String, String)], source_index: Map[String, String]) -> Array[(String, Array[(String, String)])] {\n  build_grouped_sources_from_manifest_rows_with_lookup(base_dir, rows, (path: String) -> Option[String] {\n    source_lookup_in_index(source_index, path)\n  })\n}\n\nexport fn build_grouped_sources_from_manifest_rows(base_dir: String, rows: Array[(String, String)], sources: Array[(String, String)]) -> Array[(String, Array[(String, String)])] {\n  let source_index = build_manifest_source_index(sources)\n  build_grouped_sources_from_manifest_row_source_index(base_dir, rows, source_index)\n}\n\nexport fn filter_manifest_sources_by_path_index(preloaded_sources: Array[(String, String)], needed_path_index: Map[String, Bool]) -> Array[(String, String)] {\n  let filtered_sources = array_empty()\n  let mut i = 0\n  while i < Array::length(preloaded_sources) {\n    let (path, source) = Array::get(preloaded_sources, i)\n    if Map::has_key(needed_path_index, path) {\n      Array::push(filtered_sources, (path, source))\n    }\n    i = i + 1\n  }\n  filtered_sources\n}\n\nexport fn filter_manifest_sources_by_paths(preloaded_sources: Array[(String, String)], needed_paths: Array[String]) -> Array[(String, String)] {\n  let needed_path_index = build_manifest_path_index(needed_paths)\n  filter_manifest_sources_by_path_index(preloaded_sources, needed_path_index)\n}\n\nexport fn filter_manifest_sources_by_paths_linear(preloaded_sources: Array[(String, String)], needed_paths: Array[String]) -> Array[(String, String)] {\n  let filtered_sources = array_empty()\n  let mut i = 0\n  while i < Array::length(preloaded_sources) {\n    let (path, source) = Array::get(preloaded_sources, i)\n    if contains_path(needed_paths, path) {\n      Array::push(filtered_sources, (path, source))\n    }\n    i = i + 1\n  }\n  filtered_sources\n}\n\nexport fn filter_manifest_sources_by_source_index(needed_paths: Array[String], preloaded_source_index: Map[String, String]) -> Array[(String, String)] {\n  let filtered_sources = array_empty()\n  let mut i = 0\n  while i < Array::length(needed_paths) {\n    let path = Array::get(needed_paths, i)\n    match source_lookup_in_index(preloaded_source_index, path) {\n      Some(source) => Array::push(filtered_sources, (path, source)),\n      None => ()\n    }\n    i = i + 1\n  }\n  filtered_sources\n}\n\n\nfn parse_persistent_manifest_header_cache(raw: String) -> (Int, Option[(String, String, String)], Array[(String, String, String, String)]) with { Error } {\n  let len = String::length(raw)\n  let mut line_start = 0\n  let mut i = 0\n  let mut version = 0\n  let mut manifest = None\n  let rows = empty_manifest_header_cache_rows()\n  while i <= len {\n    let at_line_end = if i == len {\n      true\n    } else {\n      String::char_code_at(raw, i) == 10\n    }\n    if at_line_end {\n      let line = strip_trailing_cr(raw[line_start: i])\n      if String::length(line) > 0 {\n        let fields = split_tsv_fields(line)\n        let tag = Array::get(fields, 0)\n        if tag == \"version\" {\n          if Array::length(fields) != 2 {\n            throw(\"invalid persistent manifest header cache version\")\n          }\n          let version_text = Array::get(fields, 1)\n          if version_text == \"1\" {\n            version = 1\n          } else if version_text == \"2\" {\n            version = 2\n          } else {\n            throw(\"invalid persistent manifest header cache version\")\n          }\n        } else if tag == \"manifest\" {\n          if Array::length(fields) != 4 {\n            throw(\"invalid persistent manifest header cache manifest row\")\n          }\n          manifest = Some((Array::get(fields, 1), Array::get(fields, 2), Array::get(fields, 3)))\n        } else if tag == \"header\" {\n          if version == 1 {\n            if Array::length(fields) != 6 {\n              throw(\"invalid persistent manifest header cache header row\")\n            }\n            Array::push(rows, (Array::get(fields, 1), Array::get(fields, 2), Array::get(fields, 3), Array::get(fields, 4)))\n          } else {\n            if Array::length(fields) != 5 {\n              throw(\"invalid persistent manifest header cache header row\")\n            }\n            Array::push(rows, (Array::get(fields, 1), Array::get(fields, 2), Array::get(fields, 3), Array::get(fields, 4)))\n          }\n        } else {\n          throw(String::concat(\"invalid persistent manifest header cache row: \", line))\n        }\n      }\n      line_start = i + 1\n    }\n    i = i + 1\n  }\n  (version, manifest, rows)\n}\n\nfn matches_cached_file_spec(path: String, stat_token_text: String, source_fingerprint: String) -> Bool with { Error, Fs } {\n  if !(Fs::exists(path)) {\n    false\n  } else {\n    let has_stat_token = String::length(stat_token_text) > 0\n    if has_stat_token {\n      if __to_string(Fs::stat_token(path)) == stat_token_text {\n        true\n      } else if String::length(source_fingerprint) > 0 {\n        fingerprint_file_fs(path) == source_fingerprint\n      } else {\n        false\n      }\n    } else if String::length(source_fingerprint) > 0 {\n      fingerprint_file_fs(path) == source_fingerprint\n    } else {\n      false\n    }\n  }\n}\n\nfn load_persistent_manifest_header_cache_if_valid(entry_path: String, manifest_path: String, manifest_path_index: Map[String, Bool]) -> Option[Array[(String, String, String, String)]] with { Error, Fs } {\n  let cache_path = persistent_manifest_header_cache_path(entry_path)\n  if !(Fs::exists(cache_path)) {\n    None\n  } else {\n    let (_, manifest, rows) = parse_persistent_manifest_header_cache(normalize_persistent_cache_text(Fs::read_file(cache_path)))\n    let manifest_ok = match manifest {\n      Some((cached_path, stat_token_text, source_fingerprint)) =>\n      cached_path == manifest_path &&\n      matches_cached_file_spec(manifest_path, stat_token_text, source_fingerprint),\n      None => false\n    }\n    if !manifest_ok {\n      None\n    } else {\n      let mut valid = true\n      let mut i = 0\n      while i < Array::length(rows) {\n        if valid {\n          let (path, stat_token_text, source_fingerprint, _) = Array::get(rows, i)\n          if !(Map::has_key(manifest_path_index, path)) {\n            valid = false\n          } else if !(matches_cached_file_spec(path, stat_token_text, source_fingerprint)) {\n            valid = false\n          }\n        }\n        i = i + 1\n      }\n      if valid {\n        Some(rows)\n      } else {\n        None\n      }\n    }\n  }\n}\n\nfn build_persistent_manifest_header_cache_text(manifest_path: String, rows: Array[(String, String, String, String)]) -> String with { Error, Fs } {\n  let mut out = \"version\\t2\\n\"\n  out = String::concat(out, String::concat(\"manifest\\t\", String::concat(manifest_path, String::concat(\"\\t\", String::concat(__to_string(Fs::stat_token(manifest_path)), String::concat(\"\\t\", String::concat(fingerprint_file_fs(manifest_path), \"\\n\")))))))\n  let mut i = 0\n  while i < Array::length(rows) {\n    let (path, stat_token_text, source_fingerprint, deps_text) = Array::get(rows, i)\n    out = String::concat(out, String::concat(\"header\\t\", String::concat(path, String::concat(\"\\t\", String::concat(stat_token_text, String::concat(\"\\t\", String::concat(source_fingerprint, String::concat(\"\\t\", String::concat(deps_text, \"\\n\")))))))))\n    i = i + 1\n  }\n  out\n}\n\nfn store_persistent_manifest_header_cache(entry_path: String, manifest_path: String, rows: Array[(String, String, String, String)]) -> Unit with { Error, Fs } {\n  Fs::write_file(persistent_manifest_header_cache_path(entry_path), build_persistent_manifest_header_cache_text(manifest_path, rows))\n}\n\nfn manifest_header_deps_lookup(rows: Array[(String, String, String, String)], path: String) -> Option[Array[String]] {\n  let mut i = 0\n  let mut found = None\n  while i < Array::length(rows) {\n    let (row_path, _, _, deps_text) = Array::get(rows, i)\n    if row_path == path {\n      found = Some(split_header_values(deps_text))\n      i = Array::length(rows)\n    } else {\n      i = i + 1\n    }\n  }\n  found\n}\n\nfn collect_needed_paths_from_manifest_headers(path: String, manifest_path_index: Map[String, Bool], rows: Array[(String, String, String, String)]) -> Array[String] with { Error, Fs } {\n  let visited = array_empty()\n  let worklist = array_empty()\n  let scheduled = path_set_new()\n  Array::push(worklist, path)\n  path_set_add(scheduled, path)\n  let mut work_len = 1\n  let mut work_i = 0\n  loop {\n    if work_i >= work_len {\n      break\n    }\n    let current = Array::get(worklist, work_i)\n    Array::push(visited, current)\n    let deps = match manifest_header_deps_lookup(rows, current) {\n      Some(found) => found,\n      None => {\n        let source = Fs::read_file(current)\n        if Map::has_key(manifest_path_index, current) {\n          collect_manifest_header_deps_from_source_with_context(current, source, manifest_path_index)\n        } else {\n          load_or_parse_module_header_deps_with_context(current, source)\n        }\n      }\n    }\n    let mut dep_i = 0\n    while dep_i < Array::length(deps) {\n      let dep_path = Array::get(deps, dep_i)\n      if should_schedule_manifest_dep(dep_path, manifest_path_index) &&\n      !(path_set_contains(scheduled, dep_path)) {\n        Array::push(worklist, dep_path)\n        path_set_add(scheduled, dep_path)\n        work_len = work_len + 1\n      }\n      dep_i = dep_i + 1\n    }\n    work_i = work_i + 1\n  }\n  visited\n}\n\nfn collect_needed_paths_and_manifest_headers(path: String, manifest_path_index: Map[String, Bool]) -> (Array[(String, String, String, String)], Array[String]) with { Error, Fs } {\n  let rows = empty_manifest_header_cache_rows()\n  let visited = array_empty()\n  let worklist = array_empty()\n  let scheduled = path_set_new()\n  Array::push(worklist, path)\n  path_set_add(scheduled, path)\n  let mut work_len = 1\n  let mut work_i = 0\n  loop {\n    if work_i >= work_len {\n      break\n    }\n    let current = Array::get(worklist, work_i)\n    Array::push(visited, current)\n    let source = Fs::read_file(current)\n    let deps = match manifest_header_deps_lookup(rows, current) {\n      Some(found) => found,\n      None => {\n        let parsed_deps = if Map::has_key(manifest_path_index, current) {\n          collect_manifest_header_deps_from_source_with_context(current, source, manifest_path_index)\n        } else {\n          load_or_parse_module_header_deps_with_context(current, source)\n        }\n        Array::push(rows, (current, __to_string(Fs::stat_token(current)), compact_string_fingerprint(source), join_header_values(parsed_deps)))\n        parsed_deps\n      }\n    }\n    let mut dep_i = 0\n    while dep_i < Array::length(deps) {\n      let dep_path = Array::get(deps, dep_i)\n      if should_schedule_manifest_dep(dep_path, manifest_path_index) &&\n      !(path_set_contains(scheduled, dep_path)) {\n        Array::push(worklist, dep_path)\n        path_set_add(scheduled, dep_path)\n        work_len = work_len + 1\n      }\n      dep_i = dep_i + 1\n    }\n    work_i = work_i + 1\n  }\n  (rows, visited)\n}\n\nfn collect_needed_paths_from_manifest_scan(path: String, manifest_path_index: Map[String, Bool]) -> Array[String] with { Error, Fs } {\n  let visited = array_empty()\n  let worklist = array_empty()\n  let scheduled = path_set_new()\n  Array::push(worklist, path)\n  path_set_add(scheduled, path)\n  let mut work_len = 1\n  let mut work_i = 0\n  loop {\n    if work_i >= work_len {\n      break\n    }\n    let current = Array::get(worklist, work_i)\n    Array::push(visited, current)\n    let source = Fs::read_file(current)\n    let deps = if Map::has_key(manifest_path_index, current) {\n      collect_manifest_header_deps_from_source_with_context(current, source, manifest_path_index)\n    } else {\n      load_or_parse_module_header_deps_with_context(current, source)\n    }\n    let mut dep_i = 0\n    while dep_i < Array::length(deps) {\n      let dep_path = Array::get(deps, dep_i)\n      if should_schedule_manifest_dep(dep_path, manifest_path_index) &&\n      !(path_set_contains(scheduled, dep_path)) {\n        Array::push(worklist, dep_path)\n        path_set_add(scheduled, dep_path)\n        work_len = work_len + 1\n      }\n      dep_i = dep_i + 1\n    }\n    work_i = work_i + 1\n  }\n  visited\n}\n\nfn load_or_collect_manifest_header_rows(entry_path: String, manifest_path: String, manifest_path_index: Map[String, Bool]) -> Array[(String, String, String, String)] with { Error, Fs } {\n  match load_persistent_manifest_header_cache_if_valid(entry_path, manifest_path, manifest_path_index) {\n    Some(cached_rows) => cached_rows,\n    None => {\n      let (built_rows, _) = collect_needed_paths_and_manifest_headers(entry_path, manifest_path_index)\n      store_persistent_manifest_header_cache(entry_path, manifest_path, built_rows)\n      built_rows\n    }\n  }\n}\n\nexport fn probe_manifest_header_rows_count(entry_path: String) -> Int with { Error, Fs } {\n  match try_load_manifest_rows(entry_path) {\n    Some((base_dir, rows)) => {\n      let manifest_path = join_path(base_dir, \"compiler_sources_manifest.tsv\")\n      let manifest_path_index = build_manifest_path_index_from_rows(base_dir, rows)\n      let header_rows = load_or_collect_manifest_header_rows(entry_path, manifest_path, manifest_path_index)\n      Array::length(header_rows)\n    },\n    None => throw(\"manifest rows unavailable\")\n  }\n}\n\nexport fn probe_manifest_header_rows_uncached_count(entry_path: String) -> Int with { Error, Fs } {\n  match try_load_manifest_rows(entry_path) {\n    Some((base_dir, rows)) => {\n      let manifest_path_index = build_manifest_path_index_from_rows(base_dir, rows)\n      let (header_rows, _) = collect_needed_paths_and_manifest_headers(entry_path, manifest_path_index)\n      Array::length(header_rows)\n    },\n    None => throw(\"manifest rows unavailable\")\n  }\n}\n\nexport fn probe_manifest_needed_paths_count(entry_path: String) -> Int with { Error, Fs } {\n  match try_load_manifest_rows(entry_path) {\n    Some((base_dir, rows)) => {\n      let manifest_path = join_path(base_dir, \"compiler_sources_manifest.tsv\")\n      let manifest_path_index = build_manifest_path_index_from_rows(base_dir, rows)\n      let header_rows = load_or_collect_manifest_header_rows(entry_path, manifest_path, manifest_path_index)\n      let needed_paths = collect_needed_paths_from_manifest_headers(entry_path, manifest_path_index, header_rows)\n      Array::length(needed_paths)\n    },\n    None => throw(\"manifest rows unavailable\")\n  }\n}\n\nexport fn probe_manifest_scan_paths_count(entry_path: String) -> Int with { Error, Fs } {\n  match try_load_manifest_rows(entry_path) {\n    Some((base_dir, rows)) => {\n      let manifest_path_index = build_manifest_path_index_from_rows(base_dir, rows)\n      let needed_paths = collect_needed_paths_from_manifest_scan(entry_path, manifest_path_index)\n      Array::length(needed_paths)\n    },\n    None => throw(\"manifest rows unavailable\")\n  }\n}\n\n\nexport fn try_collect_manifest_sources_fs(entry_path: String) -> Option[(String, Array[(String, String)])] with { Error, Fs } {\n  match try_load_manifest_rows(entry_path) {\n    Some((base_dir, rows)) => {\n      let manifest_path = join_path(base_dir, \"compiler_sources_manifest.tsv\")\n      let manifest_path_index = build_manifest_path_index_from_rows(base_dir, rows)\n      let header_rows = load_or_collect_manifest_header_rows(entry_path, manifest_path, manifest_path_index)\n      let needed_paths = collect_needed_paths_from_manifest_headers(entry_path, manifest_path_index, header_rows)\n      let needed_path_index = build_manifest_path_index(needed_paths)\n      let sources = load_manifest_sources_by_path_index(base_dir, rows, needed_path_index)\n      Some((manifest_path, sources))\n    },\n    None => None\n  }\n}\n\nexport fn try_collect_manifest_source_groups_fs(entry_path: String) -> Option[(String, Array[(String, Array[(String, String)])])] with { Error, Fs } {\n  match try_load_manifest_rows(entry_path) {\n    Some((base_dir, rows)) => {\n      let manifest_path = join_path(base_dir, \"compiler_sources_manifest.tsv\")\n      let manifest_path_index = build_manifest_path_index_from_rows(base_dir, rows)\n      let header_rows = load_or_collect_manifest_header_rows(entry_path, manifest_path, manifest_path_index)\n      let needed_paths = collect_needed_paths_from_manifest_headers(entry_path, manifest_path_index, header_rows)\n      let needed_path_index = build_manifest_path_index(needed_paths)\n      let groups = load_manifest_source_groups_by_path_index(base_dir, rows, needed_path_index)\n      Some((manifest_path, groups))\n    },\n    None => None\n  }\n}\n")
}

let source_182 = () -> (String, String) {
  ("lib/@vibe/cache/index.vpkg",
"name = @vibe/cache\nversion = 0.0.1\ndescription =\n  #|@vibe/cache — content-addressed persistent build/artifact cache path\ndeps = {}\n\ngenerated_hash =\n\n// @vibe/cache — content-addressed persistent build/artifact cache path\n// derivation + fingerprinting, and the module-header text codec (ADR-0070\n// Phase 3, #897). No opaque/transparent types: every declared name is a\n// pure fn over String/Bytes/Array/tuple primitives, never a struct/enum.\n// `version` was `export let version = \"0.0.1\"` directly in the old\n// index.vibe facade -- a real importable binding, not just contract\n// metadata -- so it is preserved verbatim as an implementation-file value\n// (cache.vibe) with a matching bodyless declaration here (Codex review\n// precedent, PR #914).\n\n// --- cache\nfn compact_string_fingerprint(source: String) -> String\nfn compilation_input_fingerprint(sources: Array[(String, String)], entry_path: String) -> String\nfn stable_cache_path(version_tag: String, prefix: String, seed: String, suffix: String) -> String\nfn persistent_artifact_cache_path(version_tag: String, kind: String, entry_name: String, fingerprint: String) -> String\nfn store_persistent_artifact(version_tag: String, kind: String, entry_name: String, fingerprint: String, bytes: Bytes) -> Unit with { Error, Fs }\nfn encode_persistent_artifact(bytes: Bytes) -> Bytes\nfn decode_persistent_artifact(env: Bytes) -> Option[Bytes]\nfn store_artifact_envelope_at(path: String, bytes: Bytes) -> Unit with { Error, Fs }\nfn load_artifact_envelope_at(path: String) -> Option[Bytes] with { Error, Fs }\nfn persistent_dep_list_cache_path(version_tag: String, path: String, source_fingerprint: String, resolution_seed: String) -> String\nfn persistent_type_env_cache_path(version_tag: String, fingerprint: String) -> String\nfn build_source_groups_fingerprint(groups: Array[(String, Array[(String, String)])]) -> String\nfn normalize_persistent_cache_text(text: String) -> String\nfn load_persistent_artifact(version_tag: String, kind: String, entry_name: String, fingerprint: String) -> Option[Bytes] with { Error, Fs }\nfn persistent_source_list_cache_path(version_tag: String, entry_path: String, resolution_seed: String) -> String\nfn persistent_source_group_cache_path(version_tag: String, entry_path: String, resolution_seed: String) -> String\nfn persistent_module_header_cache_path(version_tag: String, path: String, source_fingerprint: String, resolution_seed: String) -> String\nfn persistent_manifest_header_cache_path(version_tag: String, entry_path: String) -> String\nfn persistent_leaf_fingerprint_cache_path(version_tag: String, path: String, source_fingerprint: String) -> String\nfn build_source_groups_fingerprint_from_compact_fingerprints(groups: Array[(String, Array[(String, String)])]) -> String\nfn build_fs_compile_wasi_artifact_fingerprint_from_group_fingerprint(source_groups_fingerprint: String, entry_name: String) -> String\nfn build_fs_compile_wasi_artifact_fingerprint(source_groups: Array[(String, Array[(String, String)])], entry_name: String) -> String\nfn build_fs_compile_wasi_artifact_fingerprint_for_entry_path(source_groups: Array[(String, Array[(String, String)])], entry_path: String, entry_name: String) -> String\nfn build_fs_compile_wasi_artifact_fingerprint_from_group_fingerprint_for_entry_path(source_groups_fingerprint: String, entry_path: String, entry_name: String) -> String\nfn build_file_compile_wasi_artifact_fingerprint_from_group_fingerprint(source_groups_fingerprint: String, entry_name: String, mode: String) -> String\nfn build_file_compile_wasi_artifact_fingerprint(source_groups: Array[(String, Array[(String, String)])], entry_name: String, mode: String) -> String\nfn build_file_compile_wasi_artifact_fingerprint_for_entry_path(source_groups: Array[(String, Array[(String, String)])], entry_path: String, entry_name: String, mode: String) -> String\nfn build_file_compile_wasi_artifact_fingerprint_from_group_fingerprint_for_entry_path(source_groups_fingerprint: String, entry_path: String, entry_name: String, mode: String) -> String\nfn build_fs_compile_module_artifact_fingerprint_from_group_fingerprint(source_groups_fingerprint: String) -> String\nfn build_fs_compile_module_artifact_fingerprint(source_groups: Array[(String, Array[(String, String)])]) -> String\nfn build_fs_compile_module_artifact_fingerprint_for_entry_path(source_groups: Array[(String, Array[(String, String)])], entry_path: String) -> String\nfn build_fs_compile_module_artifact_fingerprint_from_group_fingerprint_for_entry_path(source_groups_fingerprint: String, entry_path: String) -> String\nfn build_file_compile_module_artifact_fingerprint_from_group_fingerprint(source_groups_fingerprint: String) -> String\nfn build_file_compile_module_artifact_fingerprint(source_groups: Array[(String, Array[(String, String)])]) -> String\nfn build_file_compile_module_artifact_fingerprint_for_entry_path(source_groups: Array[(String, Array[(String, String)])], entry_path: String) -> String\nfn build_file_compile_module_artifact_fingerprint_from_group_fingerprint_for_entry_path(source_groups_fingerprint: String, entry_path: String) -> String\n\n// --- header_codec\nfn persistent_module_header_text(deps: Array[String], exports: Array[String], contract_fps: Array[(String, String)]) -> String\nfn parse_persistent_module_header_text(raw: String) -> (Array[String], Array[String], Array[(String, String)], Bool) with { Error }\n")
}

let source_183 = () -> (String, String) {
  ("lib/@vibe/cache/cache.vibe",
"\nfn cache_root_prefix() -> String {\n  \"_build/vibe_\"\n}\n\nexport fn compact_string_fingerprint(source: String) -> String {\n  let mod1 = 2147483647\n  let mod2 = 2147483629\n  let step1 = 131\n  let step2 = 65599\n  let len = String::length(source)\n  let mut h1 = 17\n  let mut h2 = 29\n  let mut i = 0\n  while i < len {\n    let c = String::char_code_at(source, i)\n    h1 = (h1 * step1 + c + 1) % mod1\n    h2 = (h2 * step2 + c + i + 1) % mod2\n    i = i + 1\n  }\n  String::concat(__to_string(len), String::concat(\":\", String::concat(__to_string(h1), String::concat(\":\", __to_string(h2)))))\n}\n\nexport fn stable_cache_path(version_tag: String, prefix: String, seed: String, suffix: String) -> String {\n  let raw = compact_string_fingerprint(String::concat(\"persistent-cache-\", String::concat(version_tag, String::concat(\"|\", seed))))\n  let token_sb = StringBuilder::new()\n  let mut i = 0\n  while i < String::length(raw) {\n    let c = String::char_code_at(raw, i)\n    let piece = if c == 58 {\n      \"_\"\n    } else {\n      String::from_char_code(c)\n    }\n    StringBuilder::push(token_sb, piece)\n    i = i + 1\n  }\n  let token = StringBuilder::freeze(token_sb)\n  String::concat(cache_root_prefix(), String::concat(prefix, String::concat(\"_\", String::concat(token, suffix))))\n}\n\nexport fn compilation_input_fingerprint(sources: Array[(String, String)], entry_path: String) -> String {\n  let mut acc = String::concat(\"compilation-input|entry=\", entry_path)\n  let mut i = 0\n  while i < Array::length(sources) {\n    let (path, source) = Array::get(sources, i)\n    let pair = String::concat(path, String::concat(\"=\", compact_string_fingerprint(source)))\n    acc = compact_string_fingerprint(String::concat(acc, String::concat(\"|\", pair)))\n    i = i + 1\n  }\n  acc\n}\n\nfn build_sources_fingerprint(sources: Array[(String, String)]) -> String {\n  compilation_input_fingerprint(sources, \"\")\n}\n\nexport fn persistent_artifact_cache_path(version_tag: String, kind: String, entry_name: String, fingerprint: String) -> String {\n  stable_cache_path(version_tag, \"selfhost_artifact\", String::concat(kind, String::concat(\"|\", String::concat(entry_name, String::concat(\"|\", fingerprint)))), \".bin\")\n}\n\nexport fn encode_persistent_artifact(bytes: Bytes) -> Bytes {\n  let n = Bytes::length(bytes)\n  let env = Bytes::new()\n  Bytes::push(env, 'V')\n  Bytes::push(env, 'A')\n  Bytes::push(env, 'R')\n  Bytes::push(env, 'T')\n  Bytes::push(env, '1')\n  Bytes::push(env, n&0xFF)\n  Bytes::push(env, (n>>8)&0xFF)\n  Bytes::push(env, (n>>16)&0xFF)\n  Bytes::push(env, (n>>24)&0xFF)\n  Bytes::blit(env, bytes, 0, n)\n  env\n}\n\nexport fn decode_persistent_artifact(env: Bytes) -> Option[Bytes] {\n  let total = Bytes::length(env)\n  if total < 9 {\n    None\n  } else if Bytes::get(env, 0) != 'V' || Bytes::get(env, 1) != 'A' || Bytes::get(env, 2) != 'R' || Bytes::get(env, 3) != 'T' || Bytes::get(env, 4) != '1' {\n    None\n  } else {\n    let n = Bytes::get(env, 5)|(Bytes::get(env, 6)<<8)|(Bytes::get(env, 7)<<16)|(Bytes::get(env, 8)<<24)\n    if total != 9 + n {\n      None\n    } else {\n      let out = Bytes::new()\n      Bytes::blit(out, env, 9, total)\n      Some(out)\n    }\n  }\n}\n\nexport fn store_persistent_artifact(version_tag: String, kind: String, entry_name: String, fingerprint: String, bytes: Bytes) -> Unit with { Error, Fs } {\n  let path = persistent_artifact_cache_path(version_tag, kind, entry_name, fingerprint)\n  store_artifact_envelope_at(path, bytes)\n}\n\nexport fn store_artifact_envelope_at(path: String, bytes: Bytes) -> Unit with { Error, Fs } {\n  let tmp = String::concat(path, \".tmp\")\n  Fs::write_bytes(tmp, encode_persistent_artifact(bytes))\n  Fs::rename(tmp, path)\n}\n\nexport fn load_artifact_envelope_at(path: String) -> Option[Bytes] with { Error, Fs } {\n  if !(Fs::exists(path)) {\n    None\n  } else {\n    decode_persistent_artifact(Fs::read_bytes(path))\n  }\n}\n\nexport fn persistent_dep_list_cache_path(version_tag: String, path: String, source_fingerprint: String, resolution_seed: String) -> String {\n  stable_cache_path(version_tag, \"selfhost_dep_list\", String::concat(path, String::concat(\"|\", String::concat(source_fingerprint, resolution_seed))), \".tsv\")\n}\n\nexport fn persistent_type_env_cache_path(version_tag: String, fingerprint: String) -> String {\n  stable_cache_path(version_tag, \"selfhost_type_env_v2\", fingerprint, \".tsv\")\n}\n\nexport fn build_source_groups_fingerprint(groups: Array[(String, Array[(String, String)])]) -> String {\n  let mut acc = \"merged-groups\"\n  let mut i = 0\n  while i < Array::length(groups) {\n    let (group_name, sources) = Array::get(groups, i)\n    let fingerprint = build_sources_fingerprint(sources)\n    let next = String::concat(acc, String::concat(\"|\", String::concat(group_name, String::concat(\"=\", fingerprint))))\n    acc = compact_string_fingerprint(next)\n    i = i + 1\n  }\n  acc\n}\n\nexport fn normalize_persistent_cache_text(text: String) -> String {\n  let len = String::length(text)\n  let mut start = 0\n  while start < len && String::char_code_at(text, start) == 0 {\n    start = start + 1\n  }\n  if start == 0 {\n    text\n  } else {\n    text[start: len]\n  }\n}\n\nexport fn load_persistent_artifact(version_tag: String, kind: String, entry_name: String, fingerprint: String) -> Option[Bytes] with { Error, Fs } {\n  load_artifact_envelope_at(persistent_artifact_cache_path(version_tag, kind, entry_name, fingerprint))\n}\n\nexport fn persistent_source_list_cache_path(version_tag: String, entry_path: String, resolution_seed: String) -> String {\n  stable_cache_path(version_tag, \"selfhost_source_list\", String::concat(entry_path, resolution_seed), \".tsv\")\n}\n\nexport fn persistent_source_group_cache_path(version_tag: String, entry_path: String, resolution_seed: String) -> String {\n  stable_cache_path(version_tag, \"selfhost_source_groups\", String::concat(entry_path, resolution_seed), \".tsv\")\n}\n\nexport fn persistent_module_header_cache_path(version_tag: String, path: String, source_fingerprint: String, resolution_seed: String) -> String {\n  stable_cache_path(version_tag, \"selfhost_module_header_v2\", String::concat(path, String::concat(\"|\", String::concat(source_fingerprint, resolution_seed))), \".tsv\")\n}\n\nexport fn persistent_manifest_header_cache_path(version_tag: String, entry_path: String) -> String {\n  stable_cache_path(version_tag, \"selfhost_manifest_headers\", entry_path, \".tsv\")\n}\n\nexport fn persistent_leaf_fingerprint_cache_path(version_tag: String, path: String, source_fingerprint: String) -> String {\n  stable_cache_path(version_tag, \"selfhost_leaf_fp_v2\", String::concat(path, String::concat(\"|\", source_fingerprint)), \".tsv\")\n}\n\nfn build_sources_fingerprint_from_compact_fingerprints(sources: Array[(String, String)]) -> String {\n  let mut acc = \"compilation-input|entry=\"\n  let mut i = 0\n  while i < Array::length(sources) {\n    let (path, source_fingerprint) = Array::get(sources, i)\n    let pair = String::concat(path, String::concat(\"=\", source_fingerprint))\n    acc = compact_string_fingerprint(String::concat(acc, String::concat(\"|\", pair)))\n    i = i + 1\n  }\n  acc\n}\n\nexport fn build_source_groups_fingerprint_from_compact_fingerprints(groups: Array[(String, Array[(String, String)])]) -> String {\n  let mut acc = \"merged-groups\"\n  let mut i = 0\n  while i < Array::length(groups) {\n    let (group_name, specs) = Array::get(groups, i)\n    let fingerprint = build_sources_fingerprint_from_compact_fingerprints(specs)\n    let next = String::concat(acc, String::concat(\"|\", String::concat(group_name, String::concat(\"=\", fingerprint))))\n    acc = compact_string_fingerprint(next)\n    i = i + 1\n  }\n  acc\n}\n\nexport fn build_fs_compile_wasi_artifact_fingerprint_from_group_fingerprint(source_groups_fingerprint: String, entry_name: String) -> String {\n  compact_string_fingerprint(String::concat(\"fs-compile|\", String::concat(source_groups_fingerprint, String::concat(\"|\", entry_name))))\n}\n\nexport fn build_fs_compile_wasi_artifact_fingerprint(source_groups: Array[(String, Array[(String, String)])], entry_name: String) -> String {\n  build_fs_compile_wasi_artifact_fingerprint_from_group_fingerprint(build_source_groups_fingerprint(source_groups), entry_name)\n}\n\nexport fn build_fs_compile_wasi_artifact_fingerprint_for_entry_path(source_groups: Array[(String, Array[(String, String)])], entry_path: String, entry_name: String) -> String {\n  build_fs_compile_wasi_artifact_fingerprint_from_group_fingerprint_for_entry_path(build_source_groups_fingerprint(source_groups), entry_path, entry_name)\n}\n\nexport fn build_fs_compile_wasi_artifact_fingerprint_from_group_fingerprint_for_entry_path(source_groups_fingerprint: String, entry_path: String, entry_name: String) -> String {\n  compact_string_fingerprint(String::concat(\"fs-compile|\", String::concat(source_groups_fingerprint, String::concat(\"|\", String::concat(entry_path, String::concat(\"|\", entry_name))))))\n}\n\nexport fn build_file_compile_wasi_artifact_fingerprint_from_group_fingerprint(source_groups_fingerprint: String, entry_name: String, mode: String) -> String {\n  compact_string_fingerprint(String::concat(\"file-compile|\", String::concat(source_groups_fingerprint, String::concat(\"|\", String::concat(entry_name, String::concat(\"|\", mode))))))\n}\n\nexport fn build_file_compile_wasi_artifact_fingerprint(source_groups: Array[(String, Array[(String, String)])], entry_name: String, mode: String) -> String {\n  build_file_compile_wasi_artifact_fingerprint_from_group_fingerprint(build_source_groups_fingerprint(source_groups), entry_name, mode)\n}\n\nexport fn build_file_compile_wasi_artifact_fingerprint_for_entry_path(source_groups: Array[(String, Array[(String, String)])], entry_path: String, entry_name: String, mode: String) -> String {\n  build_file_compile_wasi_artifact_fingerprint_from_group_fingerprint_for_entry_path(build_source_groups_fingerprint(source_groups), entry_path, entry_name, mode)\n}\n\nexport fn build_file_compile_wasi_artifact_fingerprint_from_group_fingerprint_for_entry_path(source_groups_fingerprint: String, entry_path: String, entry_name: String, mode: String) -> String {\n  compact_string_fingerprint(String::concat(\"file-compile|\", String::concat(source_groups_fingerprint, String::concat(\"|\", String::concat(entry_path, String::concat(\"|\", String::concat(entry_name, String::concat(\"|\", mode))))))))\n}\n\nexport fn build_fs_compile_module_artifact_fingerprint_from_group_fingerprint(source_groups_fingerprint: String) -> String {\n  compact_string_fingerprint(String::concat(\"fs-compile-module|\", source_groups_fingerprint))\n}\n\nexport fn build_fs_compile_module_artifact_fingerprint(source_groups: Array[(String, Array[(String, String)])]) -> String {\n  build_fs_compile_module_artifact_fingerprint_from_group_fingerprint(build_source_groups_fingerprint(source_groups))\n}\n\nexport fn build_fs_compile_module_artifact_fingerprint_for_entry_path(source_groups: Array[(String, Array[(String, String)])], entry_path: String) -> String {\n  build_fs_compile_module_artifact_fingerprint_from_group_fingerprint_for_entry_path(build_source_groups_fingerprint(source_groups), entry_path)\n}\n\nexport fn build_fs_compile_module_artifact_fingerprint_from_group_fingerprint_for_entry_path(source_groups_fingerprint: String, entry_path: String) -> String {\n  compact_string_fingerprint(String::concat(\"fs-compile-module|\", String::concat(source_groups_fingerprint, String::concat(\"|\", entry_path))))\n}\n\nexport fn build_file_compile_module_artifact_fingerprint_from_group_fingerprint(source_groups_fingerprint: String) -> String {\n  compact_string_fingerprint(String::concat(\"file-compile-module|\", source_groups_fingerprint))\n}\n\nexport fn build_file_compile_module_artifact_fingerprint(source_groups: Array[(String, Array[(String, String)])]) -> String {\n  build_file_compile_module_artifact_fingerprint_from_group_fingerprint(build_source_groups_fingerprint(source_groups))\n}\n\nexport fn build_file_compile_module_artifact_fingerprint_for_entry_path(source_groups: Array[(String, Array[(String, String)])], entry_path: String) -> String {\n  compact_string_fingerprint(String::concat(\"file-compile-module|\", String::concat(build_source_groups_fingerprint(source_groups), String::concat(\"|\", entry_path))))\n}\n\nexport fn build_file_compile_module_artifact_fingerprint_from_group_fingerprint_for_entry_path(source_groups_fingerprint: String, entry_path: String) -> String {\n  compact_string_fingerprint(String::concat(\"file-compile-module|\", String::concat(source_groups_fingerprint, String::concat(\"|\", entry_path))))\n}\n")
}

let source_184 = () -> (String, String) {
  ("lib/@vibe/cache/header_codec.vibe",
"\nfn has_prefix(line: String, prefix: String) -> Bool {\n  let prefix_len = String::length(prefix)\n  if String::length(line) < prefix_len {\n    false\n  } else {\n    let mut ok = true\n    let mut i = 0\n    while ok && i < prefix_len {\n      ok = String::char_code_at(line, i) == String::char_code_at(prefix, i)\n      i = i + 1\n    }\n    ok\n  }\n}\n\nfn strip_trailing_cr(line: String) -> String {\n  let len = String::length(line)\n  if len > 0 {\n    if String::char_code_at(line, len - 1) == 13 {\n      line[0: len - 1]\n    } else {\n      line\n    }\n  } else {\n    line\n  }\n}\n\nfn parse_persistent_module_header_line(deps: Array[String], exports: Array[String], cdeps: Array[(String, String)], line: String, ver: Int) -> Int with { Error } {\n  if String::length(line) == 0 {\n    ver\n  } else if has_prefix(line, \"version\\t\") {\n    let value = line[8: String::length(line)]\n    if value == \"1\" {\n      1\n    } else if value == \"2\" {\n      2\n    } else {\n      throw(\"invalid persistent module header version\")\n    }\n  } else if has_prefix(line, \"dep\\t\") {\n    let value = line[4: String::length(line)]\n    if String::length(value) == 0 {\n      throw(\"invalid persistent module header dep row\")\n    } else {\n      Array::push(deps, value)\n      ver\n    }\n  } else if has_prefix(line, \"cdep\\t\") {\n    let value = line[5: String::length(line)]\n    let tab = String::index_of(value, \"\\t\")\n    if tab <= 0 || tab >= String::length(value) - 1 {\n      throw(\"invalid persistent module header cdep row\")\n    } else {\n      Array::push(cdeps, (value[0: tab], value[tab + 1: String::length(value)]))\n      ver\n    }\n  } else if has_prefix(line, \"export\\t\") {\n    let value = line[7: String::length(line)]\n    if String::length(value) == 0 {\n      throw(\"invalid persistent module header export row\")\n    } else {\n      Array::push(exports, value)\n      ver\n    }\n  } else {\n    throw(String::concat(\"invalid persistent module header row: \", line))\n  }\n}\n\nexport fn persistent_module_header_text(deps: Array[String], exports: Array[String], contract_fps: Array[(String, String)]) -> String {\n  let buf = StringBuilder::new()\n  StringBuilder::push(buf, \"version\\t2\\n\")\n  let mut i = 0\n  while i < Array::length(deps) {\n    StringBuilder::push(buf, \"dep\\t\")\n    StringBuilder::push(buf, Array::get(deps, i))\n    StringBuilder::push(buf, \"\\n\")\n    i = i + 1\n  }\n  let mut c = 0\n  while c < Array::length(contract_fps) {\n    let (cpath, cfp) = Array::get(contract_fps, c)\n    StringBuilder::push(buf, \"cdep\\t\")\n    StringBuilder::push(buf, cpath)\n    StringBuilder::push(buf, \"\\t\")\n    StringBuilder::push(buf, cfp)\n    StringBuilder::push(buf, \"\\n\")\n    c = c + 1\n  }\n  let mut j = 0\n  while j < Array::length(exports) {\n    StringBuilder::push(buf, \"export\\t\")\n    StringBuilder::push(buf, Array::get(exports, j))\n    StringBuilder::push(buf, \"\\n\")\n    j = j + 1\n  }\n  StringBuilder::freeze(buf)\n}\n\nexport fn parse_persistent_module_header_text(raw: String) -> (Array[String], Array[String], Array[(String, String)], Bool) with { Error } {\n  let deps = Array::slice([\n    \"\"\n  ], 0, 0)\n  let exports = Array::slice([\n    \"\"\n  ], 0, 0)\n  let cdeps = Array::slice([\n    (\"\", \"\")\n  ], 0, 0)\n  let mut ver = 0\n  let len = String::length(raw)\n  let mut line_start = 0\n  let mut i = 0\n  while i < len {\n    if String::char_code_at(raw, i) == 10 {\n      let line = strip_trailing_cr(raw[line_start: i])\n      ver = parse_persistent_module_header_line(deps, exports, cdeps, line, ver)\n      line_start = i + 1\n    }\n    i = i + 1\n  }\n  let line = strip_trailing_cr(raw[line_start: len])\n  ver = parse_persistent_module_header_line(deps, exports, cdeps, line, ver)\n  if ver == 0 {\n    throw(\"missing persistent module header version\")\n  } else {\n    (deps, exports, cdeps, ver == 2)\n  }\n}\n")
}

let source_185 = () -> (String, String) {
  ("lib/@vibe/core/index.vpkg",
"name = @vibe/core\nversion = 0.2.0\ndescription =\n  #|@vibe/core — vibe standard core library (ADR-0063 contract package).\ndeps = {}\n\ngenerated_hash =\n\n// @vibe/core — vibe standard core library (ADR-0063 contract package).\n// Modeled on moonbitlang/core's per-domain organization. The top level of\n// this contract IS the public API: transparent type definitions + fn\n// declarations, implemented by the sibling .vibe files. Consumed in-repo\n// via a bare directory import (`import ../lib/@vibe/core { ... }`) and\n// externally via the content-addressed store (`require @vibe/core ...` +\n// `import @vibe/core { ... }`; install with scripts/vibe_core_install.sh).\n//\n// v1 contents: sha1, leb128, list, set, hex, maps. map.vibe's `[K: Hash]`\n// generic-key family is now declared below (#897/#912): trait-bounded\n// bodyless fn declarations parse and fingerprint through the same\n// parse_fn_signature/fn_sig_text path as unbounded ones (verified\n// empirically — the \".vibei grammar cannot express a trait\" note that\n// used to live here was stale). `Hash` itself is declared `opaque type\n// Hash` — a trait has no SStruct/SEnum implementation for conformance to\n// find, but maps.vibe's `export ./r#map.vibe { ..., trait Hash }`\n// re-export discharges the declaration at face value (#847's re-export\n// trust), and the trait rides the merged program globally, so consumers\n// can `import @vibe/core { Hash }` and `impl Hash for TheirType`.\n//\n// map.vibe's `length`/`is_empty` (Map[String, V]) and math_extra.vibe's\n// `sum` (Array[Int]) stay UNDECLARED: each collides with a same-named\n// declaration for a different type below (List's length/sum, StringSet's\n// is_empty), and the facade can only allocate a declared name to one\n// definer. The exported-but-undeclared conformance sweep matches by NAME,\n// so these exports are legal — they remain reachable only from files\n// inside this package (map_test.vibe / math_prop_test.vibe import the\n// impl files directly), exactly the pre-.vpkg status quo.\n//\n// v2 (#766): base64, math (+ math_double), diff, uuid folded in from\n// @vibex (pure algorithms, zero prior consumers).\n//\n// v3 (#841): bigint (arbitrary-precision signed integers) and rational\n// (arbitrary-precision rationals, built directly on bigint — both now\n// live in this same package so rational's `import ./bigint.vibe` needs no\n// cross-package directory import). Both promoted straight from @vibex with\n// no @vibex stop (moved in during #841's data-structure sweep).\n//\n// v4: HashMap/HashSet (open-addressing) and SortedMap/SortedSet (AVL),\n// promoted from @vibex/collections (no prior consumers, same no-@vibex-stop\n// promotion as v3). Key hashing/equality/ordering is explicit-dict style\n// (functions passed as arguments) — see key.vibe's hash_int/eq_int/\n// compare_int/hash_string/eq_string/compare_string. keys/values/to_array\n// order is unspecified for HashMap/HashSet, ascending for SortedMap/\n// SortedSet; SortedMap::range/SortedSet::range are inclusive on both ends.\n\ntype List[T]\ntype StringSet\ntype Set[T]\ntype BigInt\ntype Rational\ntype HashMap[K, V]\ntype HashSet[T]\ntype SortedMap[K, V]\ntype SortedSet[T]\n\n// --- map (the [K: Hash] generic-key family; see header comment)\nopaque type Hash\n\nfn map_key_to_string[K: Hash](key: K) -> String\nfn get_by[K: Hash, V](m: Map[String, V], key: K) -> Option[V]\nfn has_by[K: Hash, V](m: Map[String, V], key: K) -> Bool\nfn get_or_by[K: Hash, V](m: Map[String, V], key: K, default: V) -> V\nfn get_or_else_by[K: Hash, V](m: Map[String, V], key: K, default: () -> V) -> V\nfn set_by[K: Hash, V](m: Map[String, V], key: K, value: V) -> Map[String, V]\nfn delete_by[K: Hash, V](m: Map[String, V], key: K) -> Map[String, V]\n\n// --- sha1\nfn sha1(msg: String) -> String\n\n// --- hex\nfn hex_encode(s: String) -> String\nfn hex_decode(hex: String) -> String with { Error }\n\n// --- leb128\nfn read_sleb128(buf: Bytes, offset: Int) -> (Int, Int)\nfn read_uleb128(buf: Bytes, offset: Int) -> (Int, Int)\nfn sleb128_size(n: Int) -> Int\nfn uleb128_size(n: Int) -> Int\nfn write_sleb128(buf: Bytes, n: Int) -> Unit\nfn write_uleb128(buf: Bytes, n: Int) -> Unit\nfn encode_sleb128(n: Int) -> Bytes\nfn encode_uleb128(n: Int) -> Bytes\n\n// --- array\nfn array_empty[T]() -> Array[T]\n\n// --- list\nfn list_nth[T](xs: List[T], n: Int) -> Option[T]\nfn nth[T](xs: List[T], n: Int) -> Option[T]\nfn list_of3[T](a: T, b: T, c: T) -> List[T]\nfn of3[T](a: T, b: T, c: T) -> List[T]\nfn list_of5[T](a: T, b: T, c: T, d: T, e: T) -> List[T]\nfn of5[T](a: T, b: T, c: T, d: T, e: T) -> List[T]\nfn list_cons[T](x: T, xs: List[T]) -> List[T]\nfn list_drop[T](n: Int, xs: List[T]) -> List[T]\nfn drop[T](xs: List[T], n: Int) -> List[T]\nfn list_fold[A, B](f: (B, A) -> B, init: B, xs: List[A]) -> B\nfn list_sum(xs: List[Int]) -> Int\nfn sum(xs: List[Int]) -> Int\nfn list_head[T](xs: List[T]) -> Option[T]\nfn head[T](xs: List[T]) -> Option[T]\nfn list_iter[T, R](f: (T) -> R, xs: List[T]) -> Int\nfn iter[T, R](xs: List[T], f: (T) -> R) -> Int\nfn list_tail[T](xs: List[T]) -> List[T]\nfn tail[T](xs: List[T]) -> List[T]\nfn list_empty[T]() -> List[T]\nfn list_length[T](xs: List[T]) -> Int\nfn length[T](xs: List[T]) -> Int\nfn iter_length[T](xs: List[T]) -> Int\nfn list_reverse[T](xs: List[T]) -> List[T]\nfn reverse[T](xs: List[T]) -> List[T]\nfn list_map[A, B](f: (A) -> B, xs: List[A]) -> List[B]\nfn list_zip[A, B](xs: List[A], ys: List[B]) -> List[(A, B)]\nfn zip[A, B](xs: List[A], ys: List[B]) -> List[(A, B)]\nfn list_take[T](n: Int, xs: List[T]) -> List[T]\nfn take[T](xs: List[T], n: Int) -> List[T]\nfn list_append[T](xs: List[T], ys: List[T]) -> List[T]\nfn append[T](xs: List[T], ys: List[T]) -> List[T]\nfn list_filter[T](pred: (T) -> Bool, xs: List[T]) -> List[T]\nfn filter[T](xs: List[T], pred: (T) -> Bool) -> List[T]\nfn list_flatmap[A, B](f: (A) -> List[B], xs: List[A]) -> List[B]\nfn flatmap[A, B](xs: List[A], f: (A) -> List[B]) -> List[B]\nfn list_is_empty[T](xs: List[T]) -> Bool\nfn list_iter_get[T](xs: List[T], index: Int) -> T\nfn iter_get[T](xs: List[T], index: Int) -> T\nfn list_singleton[T](x: T) -> List[T]\nfn singleton[T](x: T) -> List[T]\nfn list_contains_by[T](eq: (T, T) -> Bool, value: T, xs: List[T]) -> Bool\nfn List::nth[T](xs: List[T], n: Int) -> Option[T]\nfn List::sum(xs: List[Int]) -> Int\nfn List::zip[A, B](xs: List[A], ys: List[B]) -> List[(A, B)]\nfn List::drop[T](xs: List[T], n: Int) -> List[T]\nfn List::head[T](xs: List[T]) -> Option[T]\nfn List::iter[T, R](xs: List[T], f: (T) -> R) -> Int\nfn List::tail[T](xs: List[T]) -> List[T]\nfn List::take[T](xs: List[T], n: Int) -> List[T]\nfn List::append[T](xs: List[T], ys: List[T]) -> List[T]\nfn List::filter[T](xs: List[T], pred: (T) -> Bool) -> List[T]\nfn List::length[T](xs: List[T]) -> Int\nfn List::flatmap[A, B](xs: List[A], f: (A) -> List[B]) -> List[B]\nfn List::reverse[T](xs: List[T]) -> List[T]\nfn List::is_empty[T](xs: List[T]) -> Bool\nfn List::iter_get[T](xs: List[T], index: Int) -> T\nfn List::contains_by[T](xs: List[T], eq: (T, T) -> Bool, value: T) -> Bool\nfn List::iter_length[T](xs: List[T]) -> Int\n\n// --- set\nfn size(s: StringSet) -> Int\nfn empty() -> StringSet\nfn remove(s: StringSet, value: String) -> StringSet\nfn contains(s: StringSet, value: String) -> Bool\nfn add(s: StringSet, value: String) -> StringSet\nfn is_empty(s: StringSet) -> Bool\nfn set_union(a: StringSet, b: StringSet) -> StringSet\nfn from_array(values: Array[String]) -> StringSet\nfn set_intersect(a: StringSet, b: StringSet) -> StringSet\nfn set_difference(a: StringSet, b: StringSet) -> StringSet\nfn set_value_to_string[T](value: T) -> String\nfn add_by[T](s: StringSet, value: T) -> StringSet\nfn remove_by[T](s: StringSet, value: T) -> StringSet\nfn contains_by[T](s: StringSet, value: T) -> Bool\nfn from_array_by[T](values: Array[T]) -> StringSet\n\n// --- set (method-style #1189/#1194 qualified companions)\nfn StringSet::size(s: StringSet) -> Int\nfn StringSet::contains(s: StringSet, value: String) -> Bool\nfn StringSet::add(s: StringSet, value: String) -> StringSet\nfn StringSet::remove(s: StringSet, value: String) -> StringSet\nfn StringSet::is_empty(s: StringSet) -> Bool\nfn StringSet::union(a: StringSet, b: StringSet) -> StringSet\nfn StringSet::intersect(a: StringSet, b: StringSet) -> StringSet\nfn StringSet::difference(a: StringSet, b: StringSet) -> StringSet\nfn StringSet::add_by[T](s: StringSet, value: T) -> StringSet\nfn StringSet::remove_by[T](s: StringSet, value: T) -> StringSet\nfn StringSet::contains_by[T](s: StringSet, value: T) -> Bool\n\n// --- generic Set[T] (#1140, ADR-0082)\nfn Set::new[T]() -> Set[T]\nfn Set::size[T](s: Set[T]) -> Int\nfn Set::is_empty[T](s: Set[T]) -> Bool\nfn Set::contains[T: Hash](s: Set[T], value: T) -> Bool\nfn Set::add[T: Hash](s: Set[T], value: T) -> Set[T]\nfn Set::remove[T: Hash](s: Set[T], value: T) -> Set[T]\nfn Set::to_array[T](s: Set[T]) -> Array[T]\nfn Set::from_array[T: Hash](values: Array[T]) -> Set[T]\nfn Set::union[T](a: Set[T], b: Set[T]) -> Set[T]\nfn Set::intersect[T](a: Set[T], b: Set[T]) -> Set[T]\nfn Set::difference[T](a: Set[T], b: Set[T]) -> Set[T]\n\n// --- maps (plain Map[String, V] helpers; the `[K: Hash]` generic-key\n// variants and the Hash trait itself are not part of this contract yet)\nfn get[V](m: Map[String, V], key: String) -> Option[V]\nfn get_or[V](m: Map[String, V], key: String, default: V) -> V\nfn get_or_else[V](m: Map[String, V], key: String, default: () -> V) -> V\nfn has_key[V](m: Map[String, V], key: String) -> Bool\nfn keys[V](m: Map[String, V]) -> Array[String]\nfn values[V](m: Map[String, V]) -> Array[V]\n\n// --- base64\nfn decode(input: String) -> String\nfn encode(input: String) -> String\nfn encode_url_safe(input: String) -> String\n\n// --- diff\ntype DiffOp\nfn diff_lines(old_text: String, new_text: String) -> Array[DiffOp]\nfn format_unified(ops: Array[DiffOp]) -> String\nfn has_changes(ops: Array[DiffOp]) -> Bool\nfn count_additions(ops: Array[DiffOp]) -> Int\nfn count_deletions(ops: Array[DiffOp]) -> Int\n\n// --- uuid\nfn v4(seed_state: Int) -> (String, Int)\nfn is_valid_v4(s: String) -> Bool\n\n// --- math (Int)\nfn abs(n: Int) -> Int\nfn gcd(a: Int, b: Int) -> Int\nfn lcm(a: Int, b: Int) -> Int\nfn max(a: Int, b: Int) -> Int\nfn min(a: Int, b: Int) -> Int\nfn pow(base: Int, exp: Int) -> Int\nfn comb(n: Int, k: Int) -> Int\nfn log2(n: Int) -> Int\nfn perm(n: Int, k: Int) -> Int\nfn sign(n: Int) -> Int\nfn clamp(n: Int, lo: Int, hi: Int) -> Int\nfn divmod(a: Int, d: Int) -> (Int, Int)\nfn is_odd(n: Int) -> Bool\nfn is_even(n: Int) -> Bool\nfn product(arr: Array[Int]) -> Int\nfn sqrt_int(n: Int) -> Int\nfn max_array(arr: Array[Int]) -> Int\nfn min_array(arr: Array[Int]) -> Int\nfn is_power_of_two(n: Int) -> Bool\n\n// --- math (Double)\nfn ln(x: Double) -> Double\nfn sqrt(x: Double) -> Double\nfn hypot(x: Double, y: Double) -> Double\nfn log10(x: Double) -> Double\nfn degrees(rad: Double) -> Double\nfn radians(deg: Double) -> Double\nfn atan(x: Double) -> Double\nfn asin(x: Double) -> Double\nfn acos(x: Double) -> Double\nfn atan2(y: Double, x: Double) -> Double\nfn exp_double(x: Double) -> Double\nfn pow_double(base: Double, exponent: Double) -> Double\nfn log2_double(x: Double) -> Double\nfn sin(x: Double) -> Double\nfn cos(x: Double) -> Double\nfn tan(x: Double) -> Double\nlet pi: Double\nlet tau: Double\nlet e_const: Double\n\n// --- bigint (arbitrary-precision signed integers)\nfn BigInt::from_int(n: Int) -> BigInt\nfn BigInt::to_int(a: BigInt) -> Option[Int]\nfn BigInt::parse(s: String) -> Option[BigInt]\nfn BigInt::to_string(a: BigInt) -> String\nfn BigInt::add(a: BigInt, b: BigInt) -> BigInt\nfn BigInt::sub(a: BigInt, b: BigInt) -> BigInt\nfn BigInt::mul(a: BigInt, b: BigInt) -> BigInt\nfn BigInt::divmod(a: BigInt, b: BigInt) -> Option[(BigInt, BigInt)]\nfn BigInt::div(a: BigInt, b: BigInt) -> Option[BigInt]\nfn BigInt::mod(a: BigInt, b: BigInt) -> Option[BigInt]\nfn BigInt::cmp(a: BigInt, b: BigInt) -> Int\nfn BigInt::equals(a: BigInt, b: BigInt) -> Bool\nfn BigInt::neg(a: BigInt) -> BigInt\nfn BigInt::abs(a: BigInt) -> BigInt\nfn BigInt::is_zero(a: BigInt) -> Bool\nfn BigInt::pow(base_v: BigInt, exp: Int) -> BigInt\n\n// --- rational (arbitrary-precision rationals, built on bigint)\nfn Rational::from_int(n: Int) -> Rational\nfn Rational::from_ints(num: Int, den: Int) -> Option[Rational]\nfn Rational::from_bigints(num: BigInt, den: BigInt) -> Option[Rational]\nfn Rational::parse(s: String) -> Option[Rational]\nfn Rational::to_string(a: Rational) -> String\nfn Rational::add(a: Rational, b: Rational) -> Rational\nfn Rational::sub(a: Rational, b: Rational) -> Rational\nfn Rational::mul(a: Rational, b: Rational) -> Rational\nfn Rational::div(a: Rational, b: Rational) -> Option[Rational]\nfn Rational::cmp(a: Rational, b: Rational) -> Int\nfn Rational::equals(a: Rational, b: Rational) -> Bool\nfn Rational::neg(a: Rational) -> Rational\nfn Rational::abs(a: Rational) -> Rational\nfn Rational::is_zero(a: Rational) -> Bool\n\n// --- collections: key dictionaries (Int / String)\nfn hash_int(x: Int) -> Int\nfn eq_int(a: Int, b: Int) -> Bool\nfn compare_int(a: Int, b: Int) -> Int\nfn hash_string(s: String) -> Int\nfn eq_string(a: String, b: String) -> Bool\nfn compare_string(a: String, b: String) -> Int\n\n// --- collections: HashMap\nfn HashMap::new[K, V](hash_fn: (K) -> Int, eq_fn: (K, K) -> Bool) -> HashMap[K, V]\nfn HashMap::with_capacity[K, V](hash_fn: (K) -> Int, eq_fn: (K, K) -> Bool, capacity: Int) -> HashMap[K, V]\nfn HashMap::new_int[V]() -> HashMap[Int, V]\nfn HashMap::new_string[V]() -> HashMap[String, V]\nfn HashMap::with_capacity_int[V](capacity: Int) -> HashMap[Int, V]\nfn HashMap::with_capacity_string[V](capacity: Int) -> HashMap[String, V]\nfn HashMap::set[K, V](m: HashMap[K, V], k: K, v: V) -> Unit\nfn HashMap::get[K, V](m: HashMap[K, V], k: K) -> Option[V]\nfn HashMap::has[K, V](m: HashMap[K, V], k: K) -> Bool\nfn HashMap::delete[K, V](m: HashMap[K, V], k: K) -> Bool\nfn HashMap::size[K, V](m: HashMap[K, V]) -> Int\nfn HashMap::keys[K, V](m: HashMap[K, V]) -> Array[K]\nfn HashMap::values[K, V](m: HashMap[K, V]) -> Array[V]\nfn HashMap::to_array[K, V](m: HashMap[K, V]) -> Array[(K, V)]\n\n// --- collections: HashSet\nfn HashSet::new[T](hash_fn: (T) -> Int, eq_fn: (T, T) -> Bool) -> HashSet[T]\nfn HashSet::with_capacity[T](hash_fn: (T) -> Int, eq_fn: (T, T) -> Bool, capacity: Int) -> HashSet[T]\nfn HashSet::new_int() -> HashSet[Int]\nfn HashSet::new_string() -> HashSet[String]\nfn HashSet::add[T](s: HashSet[T], x: T) -> Unit\nfn HashSet::has[T](s: HashSet[T], x: T) -> Bool\nfn HashSet::delete[T](s: HashSet[T], x: T) -> Bool\nfn HashSet::size[T](s: HashSet[T]) -> Int\nfn HashSet::to_array[T](s: HashSet[T]) -> Array[T]\nfn HashSet::union[T](a: HashSet[T], b: HashSet[T]) -> HashSet[T]\nfn HashSet::intersect[T](a: HashSet[T], b: HashSet[T]) -> HashSet[T]\nfn HashSet::difference[T](a: HashSet[T], b: HashSet[T]) -> HashSet[T]\n\n// --- collections: SortedMap\nfn SortedMap::new[K, V](cmp: (K, K) -> Int) -> SortedMap[K, V]\nfn SortedMap::new_int[V]() -> SortedMap[Int, V]\nfn SortedMap::new_string[V]() -> SortedMap[String, V]\nfn SortedMap::set[K, V](m: SortedMap[K, V], k: K, v: V) -> Unit\nfn SortedMap::get[K, V](m: SortedMap[K, V], k: K) -> Option[V]\nfn SortedMap::has[K, V](m: SortedMap[K, V], k: K) -> Bool\nfn SortedMap::delete[K, V](m: SortedMap[K, V], k: K) -> Bool\nfn SortedMap::size[K, V](m: SortedMap[K, V]) -> Int\nfn SortedMap::min[K, V](m: SortedMap[K, V]) -> Option[(K, V)]\nfn SortedMap::max[K, V](m: SortedMap[K, V]) -> Option[(K, V)]\nfn SortedMap::keys[K, V](m: SortedMap[K, V]) -> Array[K]\nfn SortedMap::values[K, V](m: SortedMap[K, V]) -> Array[V]\nfn SortedMap::to_array[K, V](m: SortedMap[K, V]) -> Array[(K, V)]\nfn SortedMap::range[K, V](m: SortedMap[K, V], lo: K, hi: K) -> Array[(K, V)]\n\n// --- collections: SortedSet\nfn SortedSet::new[T](cmp: (T, T) -> Int) -> SortedSet[T]\nfn SortedSet::new_int() -> SortedSet[Int]\nfn SortedSet::new_string() -> SortedSet[String]\nfn SortedSet::add[T](s: SortedSet[T], x: T) -> Unit\nfn SortedSet::has[T](s: SortedSet[T], x: T) -> Bool\nfn SortedSet::delete[T](s: SortedSet[T], x: T) -> Bool\nfn SortedSet::size[T](s: SortedSet[T]) -> Int\nfn SortedSet::min[T](s: SortedSet[T]) -> Option[T]\nfn SortedSet::max[T](s: SortedSet[T]) -> Option[T]\nfn SortedSet::to_array[T](s: SortedSet[T]) -> Array[T]\nfn SortedSet::range[T](s: SortedSet[T], lo: T, hi: T) -> Array[T]\nfn SortedSet::union[T](a: SortedSet[T], b: SortedSet[T]) -> SortedSet[T]\nfn SortedSet::intersect[T](a: SortedSet[T], b: SortedSet[T]) -> SortedSet[T]\nfn SortedSet::difference[T](a: SortedSet[T], b: SortedSet[T]) -> SortedSet[T]\n\n// --- assert (#1061)\nfn assert_false(b: Bool) -> Unit\nfn inspect[T](value: T, content: String) -> Unit\n")
