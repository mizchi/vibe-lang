    let wnl = compile_expr(buf, cond, local_names, next_local, ctx, w_ld_in)\\n      emit_i64_eqz(buf)\\n      wnl\\n    }\\n    emit_br_if(buf, 1)\\n    let nl2 = compile_expr(buf, body, local_names, nl1, ctx, w_ld_in)\\n    emit_drop(buf)\\n    emit_br(buf, 0)\\n    emit_end(buf)\\n    emit_end(buf)\\n    Array::truncate(ctx.loop_borrowed_names, lb_base)\\n    emit_i64_const(buf, 0)\\n    nl2\\n  } else if __tag == 20 {\\n    emit_br(buf, ld + 1)\\n    emit_i64_const(buf, 0)\\n    next_local\\n  } else if __tag == 21 {\\n    emit_br(buf, ld)\\n    emit_i64_const(buf, 0)\\n    next_local\\n  } else if __tag == 22 {\\n    emit_i64_const(buf, 0)\\n    next_local\\n  } else if __tag == 24 {\\n    compile_lambda(buf, get_efn_params(expr), get_efn_body(expr), local_names, next_local, ctx, ld, compile_expr)\\n  } else if __tag == 26 {\\n    let ret_expr = get_ereturn_expr(expr)\\n    let nl = compile_expr(buf, ret_expr, local_names, next_local, ctx, ld)\\n    emit_return(buf)\\n    nl\\n  } else {\\n    compile_expr_tail4(buf, expr, local_names, next_local, ctx, ld, compile_expr)\\n  }\\n}\\n\")\n}\n\nlet cli_adapter_source_82 = () -> (String, String) {\n  (\"lib/@vibe/compiler/codegen/expr/compile_expr_tail2.vibe\",\n\"//# Imports\\n\\nimport ../../core {\\n  Expr, Pat, Stmt, TypeExpr, bytebuf_length, bytebuf_new, bytebuf_push, bytebuf_push_section, bytebuf_push_vec_header, bytebuf_to_bytes, leb128_encode_s64, leb128_encode_u32\\n}\\n\\nimport ../common_analysis {\\n  collect_free_vars, collect_strings_stmts, emit_closure_call_tail, emit_closure_resolve, emit_i64_extend_i32_u, is_mut_captured_in\\n}\\n\\nimport ../common_base {\\n  CompileCtx, CtorTable, FuncTable, LambdaTable, StrTable, emit_binop_op, emit_heap_grow_after_heap_set, emit_i32_eq, emit_i32_eqz, emit_i32_ge_u, emit_i32_mul, emit_i32_ne, emit_i32_sub, emit_i64_load, emit_i64_store, emit_rc_dup_guarded, emit_str_ref, expr_tag, get_arm_body, get_arm_pat, get_ebinop_op, get_efn_body, get_eif_cond, get_eif_else