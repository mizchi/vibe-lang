let source_248 = () -> (String, String) {
  ("lib/@vibe/compiler/entry/source_compile/wasi_only/merge_sources.vibe",
"\nimport @vibe/compiler/checker {\n  check_program\n}\n\nimport @vibe/core {\n  array_empty\n}\n\nimport @vibe/compiler/codegen/wasi {\n  compile_wasi_module_impl\n}\n\nimport @vibe/compiler/syntax {\n  lex, parse_program, print_program\n}\n\nimport @vibe/compiler/core {\n  ExportRenamePlan,\n  Expr,\n  Stmt,\n  append_import_alias_rewritten_non_import_stmts_with_renames,\n  append_non_import_stmts_without_alias_rewrite,\n  apply_export_renames_stmts,\n  build_export_rename_plan,\n  collect_import_alias_collision_locals,\n  collect_import_alias_collision_refs,\n  collect_import_value_renames,\n  dir_of_path,\n  export_plan_renames_for,\n  import_value_rename_locals,\n  namespace_private_value_stmts,\n  path_set_add,\n  path_set_contains,\n  path_set_new,\n  resolve_import_path,\n  resolve_import_path_candidates,\n  rewrite_imported_value_stmt_to_local,\n  stmts_have_import_deep\n}\n\n\n\nimport @vibe/compiler/loader {\n  ingest_source_text_fs\n}\n\n\nfn string_array_contains_local(items: Array[String], target: String) -> Bool {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(items) && !found {\n    if Array::get(items, i) == target {\n      found = true\n    } else {\n      i = i + 1\n    }\n  }\n  found\n}\n\nfn resolve_existing_import_path(base_dir: String, raw_path: String, self_path: String) -> String with { Fs } {\n  let candidates = resolve_import_path_candidates(base_dir, raw_path)\n  let mut i = 0\n  let mut found = \"\"\n  let mut fallback = \"\"\n  while i < Array::length(candidates) {\n    let candidate = Array::get(candidates, i)\n    if candidate == self_path {\n      i = i + 1\n    } else if Fs::exists(candidate) {\n      found = candidate\n      i = Array::length(candidates)\n    } else {\n      if fallback == \"\" {\n        fallback = candidate\n      } else {\n        ()\n      }\n      i = i + 1\n    }\n  }\n  if found == \"\" {\n    if fallback == \"\" {\n      Array::get(candidates, 0)\n    } else {\n      fallback\n    }\n  } else {\n    found\n  }\n}\n\nfn append_fs_import_alias_collision_defs(merged: Array[Stmt], current_path: String, stmts: Array[Stmt], plan: ExportRenamePlan, excluded_locals: Array[String]) -> Unit with { Error, Fs } {\n  let refs = collect_import_alias_collision_refs(stmts)\n  let emitted = array_empty()\n  let base_dir = dir_of_path(current_path)\n  let mut i = 0\n  while i < Array::length(refs) {\n    let (raw_path, original, local) = Array::get(refs, i)\n    if !string_array_contains_local(emitted, local) && !string_array_contains_local(excluded_locals, local) {\n      let resolved = resolve_existing_import_path(base_dir, raw_path, current_path)\n      let source = ingest_source_text_fs(resolved, Fs::read_file(resolved))\n      let source_stmts = namespace_private_value_stmts(resolved, apply_export_renames_stmts(parse_program(lex(source)), export_plan_renames_for(plan, resolved)))\n      let mut j = 0\n      let mut done = false\n      while j < Array::length(source_stmts) && !done {\n        match rewrite_imported_value_stmt_to_local(Array::get(source_stmts, j), original, local) {\n          Some(local_stmt) => {\n            Array::push(merged, local_stmt)\n            Array::push(emitted, local)\n            done = true\n          },\n          None => ()\n        }\n        j = j + 1\n      }\n    }\n    i = i + 1\n  }\n}\n\nfn collect_parsed_sources_recursive(path: String, file_paths: Array[String], file_stmts: Array[Array[Stmt]], visited: Array[Array[String]]) -> Unit with { Error, Fs } {\n  if path_set_contains(visited, path) {\n    ()\n  }\n  else {\n    path_set_add(visited, path)\n    let source = ingest_source_text_fs(path, Fs::read_file(path))\n    let stmts = parse_program(lex(source))\n    let base_dir = dir_of_path(path)\n    let mut i = 0\n    while i < Array::length(stmts) {\n      match Array::get(stmts, i) {\n        SImport(raw_path, _) => {\n          let resolved = resolve_existing_import_path(base_dir, raw_path, path)\n          collect_parsed_sources_recursive(resolved, file_paths, file_stmts, visited)\n        },\n        SReExport(raw_path, _) => {\n          let resolved = resolve_existing_import_path(base_dir, raw_path, path)\n          collect_parsed_sources_recursive(resolved, file_paths, file_stmts, visited)\n        },\n        _ => ()\n      }\n      i = i + 1\n    }\n    Array::push(file_paths, path)\n    Array::push(file_stmts, stmts)\n  }\n}\n\nfn collect_merged_stmts_recursive(entry_path: String, merged: Array[Stmt], visited: Array[Array[String]]) -> Unit with { Error, Fs } {\n  let file_paths = array_empty()\n  let file_stmts = array_empty()\n  collect_parsed_sources_recursive(entry_path, file_paths, file_stmts, visited)\n  let plan = build_export_rename_plan(file_paths, file_stmts, entry_path)\n  let mut fi = 0\n  while fi < Array::length(file_paths) {\n    let path = Array::get(file_paths, fi)\n    let stmts = Array::get(file_stmts, fi)\n    let export_renamed = if path == entry_path {\n      stmts\n    } else {\n      apply_export_renames_stmts(stmts, export_plan_renames_for(plan, path))\n    }\n    let namespaced_stmts = if path == entry_path {\n      export_renamed\n    } else {\n      namespace_private_value_stmts(path, export_renamed)\n    }\n    if stmts_have_import_deep(stmts) {\n      let import_renames = collect_import_value_renames(plan, path, stmts)\n      let skipped_locals = collect_import_alias_collision_locals(stmts)\n      append_fs_import_alias_collision_defs(merged, path, stmts, plan, import_value_rename_locals(import_renames))\n      append_import_alias_rewritten_non_import_stmts_with_renames(merged, namespaced_stmts, skipped_locals, import_renames)\n    } else {\n      append_non_import_stmts_without_alias_rewrite(merged, namespaced_stmts)\n    }\n    fi = fi + 1\n  }\n}\n\nexport fn merged_program_source_fs(entry_path: String) -> String with { Error, Fs } {\n  let stmts = empty_stmt_array()\n  let visited = path_set_new()\n  collect_merged_stmts_recursive(entry_path, stmts, visited)\n  print_program(stmts)\n}\n\nexport fn compile_file_wasi_only(entry_path: String, entry_name: String) -> Bytes with { Error, Fs } {\n  let stmts = empty_stmt_array()\n  let visited = path_set_new()\n  collect_merged_stmts_recursive(entry_path, stmts, visited)\n  expand_interp_stmts(stmts)\n  let _ = check_program(stmts)\n  strip_generic_type_params(stmts)\n  compile_wasi_module_impl(stmts, entry_name)\n}\n\n\nexport {\n  collect_merged_stmts_recursive\n}\n\nexport {\n  collect_merged_stmts_recursive, compile_file_wasi_only\n}\n")
}

let source_249 = () -> (String, String) {
  ("lib/@vibe/compiler/entry/source_compile/wasi_only/linked.vibe",
"\n\n\n\nexport {\n  compile_file_wasi_library, compile_file_wasi_linked, compile_file_wasi_linked_artifacts\n}\n")
}

let source_250 = () -> (String, String) {
  ("lib/@vibe/compiler/entry/source_compile/wasi_only/linked_helpers.vibe",
"\nimport @vibe/compiler/checker {\n  check_program\n}\n\nimport @vibe/core {\n  array_empty\n}\n\nimport @vibe/compiler/codegen/wasi {\n  compile_wasi_module_linked_impl\n}\n\nimport @vibe/compiler/core {\n  Expr, Stmt, contains_name, dir_of_path, get_export_name, path_to_module_name, resolve_import_path\n}\n\nimport @vibe/compiler/syntax {\n  lex, parse_program\n}\n\n\nfn efn_param_count(expr: Expr) -> Int {\n  match expr {\n    EFn(_, _, params, _, _, _) => Array::length(params),\n    _ => -1\n  }\n}\n\nfn resolve_reexport_chain(source_path: String, items: Array[(String, Option[String])], module_name: String, linked_imports: Array[(String, String, Int, Int)], type_stmts: Array[Stmt], depth: Int) -> Unit with { Error, Fs } {\n  if depth > 10 {\n    ()\n  }\n  else {\n    let source = Fs::read_file(source_path)\n    let stmts = parse_program(lex(source))\n    let source_dir = dir_of_path(source_path)\n    let wanted_names = array_empty()\n    let mut wi = 0\n    while wi < Array::length(items) {\n      let (name, _) = Array::get(items, wi)\n      Array::push(wanted_names, name)\n      wi = wi + 1\n    }\n    let mut si = 0\n    while si < Array::length(stmts) {\n      match Array::get(stmts, si) {\n        SLet(true, _, name, _, expr) => if contains_name(wanted_names, name) {\n          let param_count = efn_param_count(expr)\n          if param_count >= 0 {\n            let export_name = get_export_name(items, name)\n            Array::push(linked_imports, (module_name, export_name, param_count, 1))\n          }\n        }\n        ,\n        SEnum(true, name, _, _, _) => if contains_name(wanted_names, name) {\n          Array::push(type_stmts, Array::get(stmts, si))\n        }\n        ,\n        SReExport(raw_path, inner_items) => {\n          let filtered = array_empty()\n          let mut fi = 0\n          while fi < Array::length(inner_items) {\n            let (iname, irename) = Array::get(inner_items, fi)\n            if contains_name(wanted_names, iname) {\n              Array::push(filtered, (iname, irename))\n            }\n            fi = fi + 1\n          }\n          if Array::length(filtered) > 0 {\n            let resolved = resolve_import_path(source_dir, raw_path)\n            resolve_reexport_chain(resolved, filtered, module_name, linked_imports, type_stmts, depth + 1)\n          }\n        },\n        _ => ()\n      }\n      si = si + 1\n    }\n  }\n}\n\n\nexport {\n  path_to_module_name, resolve_reexport_chain\n}\n")
}

let source_251 = () -> (String, String) {
  ("lib/@vibe/compiler/entry/source_compile/wasi_only/linked_artifacts.vibe",
"\nimport @vibe/compiler/checker {\n  check_program\n}\n\nimport @vibe/core {\n  array_empty\n}\n\nimport @vibe/compiler/codegen/wasi {\n  compile_wasi_module_linked_impl\n}\n\nimport @vibe/compiler/codegen/common_base {\n  codegen_body_cache_new, empty_dbg_prov\n}\n\nimport @vibe/compiler/core {\n  Expr, Stmt, contains_name, dir_of_path, path_to_module_name, resolve_import_path\n}\n\nimport @vibe/compiler/syntax {\n  lex, parse_program\n}\n\n\n\n\nfn efn_param_count(expr: Expr) -> Int {\n  match expr {\n    EFn(_, _, params, _, _, _) => Array::length(params),\n    _ => -1\n  }\n}\n\nfn read_program(path: String) -> Array[Stmt] with { Error, Fs } {\n  let source = Fs::read_file(path)\n  parse_program(lex(source))\n}\n\nfn append_stmt_array(dst: Array[Stmt], src: Array[Stmt]) -> Unit {\n  let mut i = 0\n  while i < Array::length(src) {\n    Array::push(dst, Array::get(src, i))\n    i = i + 1\n  }\n}\n\nfn collect_direct_dep_paths(entry_stmts: Array[Stmt], entry_dir: String) -> (Array[String], Array[Array[String]]) {\n  let dep_paths = array_empty()\n  let dep_wanted_names = array_empty()\n  let dep_path_names_for: (String) -> Array[String] = (resolved) -> {\n    let mut fi = 0\n    let mut idx = -1\n    while fi < Array::length(dep_paths) {\n      if Array::get(dep_paths, fi) == resolved {\n        idx = fi\n        fi = Array::length(dep_paths)\n      } else {\n        fi = fi + 1\n      }\n    }\n    if idx < 0 {\n      let fresh = array_empty()\n      Array::push(dep_paths, resolved)\n      Array::push(dep_wanted_names, fresh)\n      fresh\n    } else {\n      Array::get(dep_wanted_names, idx)\n    }\n  }\n  let mut ei = 0\n  while ei < Array::length(entry_stmts) {\n    match Array::get(entry_stmts, ei) {\n      SImport(raw_path, items) => if Array::length(items) > 0 {\n        let resolved = resolve_import_path(entry_dir, raw_path)\n        let names = dep_path_names_for(resolved)\n        let mut ii = 0\n        while ii < Array::length(items) {\n          let (iname, _) = Array::get(items, ii)\n          Array::push(names, iname)\n          ii = ii + 1\n        }\n      }\n      ,\n      SReExport(raw_path, items) => {\n        let resolved = resolve_import_path(entry_dir, raw_path)\n        let names = dep_path_names_for(resolved)\n        let mut ii = 0\n        while ii < Array::length(items) {\n          let (iname, _) = Array::get(items, ii)\n          Array::push(names, iname)\n          ii = ii + 1\n        }\n      },\n      _ => ()\n    }\n    ei = ei + 1\n  }\n  (dep_paths, dep_wanted_names)\n}\n\nfn collect_linked_dep_artifacts(dep_paths: Array[String], wanted_names: Array[Array[String]]) -> (Array[Stmt], Array[(String, String, Int, Int)], Array[(String, String)]) with { Error, Fs } {\n  let linked_imports = array_empty()\n  let linked_dep_specs = array_empty()\n  let resolved_type_stmts = array_empty()\n  let mut di = 0\n  while di < Array::length(dep_paths) {\n    let dep_path = Array::get(dep_paths, di)\n    let dep_stmts = read_program(dep_path)\n    let module_name = path_to_module_name(dep_path)\n    let dep_dir = dir_of_path(dep_path)\n    let wanted = Array::get(wanted_names, di)\n    let mut has_linked = false\n    let mut dsi = 0\n    while dsi < Array::length(dep_stmts) {\n      match Array::get(dep_stmts, dsi) {\n        SLet(true, _, name, _, expr) => {\n          let param_count = efn_param_count(expr)\n          let aw_hook = name == \"__aw_wait\" || name == \"__aw_notify_resolve\"\n          if param_count >= 0 && (contains_name(wanted, name) || aw_hook) {\n            Array::push(linked_imports, (module_name, name, param_count, 1))\n            has_linked = true\n          }\n        },\n        SReExport(raw_path, items) => {\n          let filtered = array_empty()\n          let mut fi2 = 0\n          while fi2 < Array::length(items) {\n            let (iname, irename) = Array::get(items, fi2)\n            let public_name = match irename {\n              Some(alias) => alias,\n              None => iname\n            }\n            if contains_name(wanted, public_name) {\n              Array::push(filtered, (iname, irename))\n            }\n            fi2 = fi2 + 1\n          }\n          if Array::length(filtered) > 0 {\n            let resolved = resolve_import_path(dep_dir, raw_path)\n            resolve_reexport_chain(resolved, filtered, module_name, linked_imports, resolved_type_stmts, 0)\n            has_linked = true\n          }\n        },\n        SEnum(true, _, _, _, _) => Array::push(resolved_type_stmts, Array::get(dep_stmts, dsi))\n        ,\n        _ => ()\n      }\n      dsi = dsi + 1\n    }\n    if has_linked {\n      Array::push(linked_dep_specs, (module_name, dep_path))\n    }\n    di = di + 1\n  }\n  (resolved_type_stmts, linked_imports, linked_dep_specs)\n}\n\nexport fn collect_linked_dep_inputs_for_stmts(entry_path: String, entry_stmts: Array[Stmt]) -> (Array[Stmt], Array[(String, String, Int, Int)], Array[(String, String)]) with { Error, Fs } {\n  let (dep_paths, dep_wanted_names) = collect_direct_dep_paths(entry_stmts, dir_of_path(entry_path))\n  collect_linked_dep_artifacts(dep_paths, dep_wanted_names)\n}\n\nexport fn collect_linked_compile_inputs(entry_path: String) -> (Array[Stmt], Array[Stmt], Array[(String, String, Int, Int)], Array[(String, String)]) with { Error, Fs } {\n  let entry_stmts = read_program(entry_path)\n  let (resolved_type_stmts, linked_imports, linked_dep_specs) = collect_linked_dep_inputs_for_stmts(entry_path, entry_stmts)\n  (entry_stmts, resolved_type_stmts, linked_imports, linked_dep_specs)\n}\n\nexport fn compile_file_wasi_linked_artifacts(entry_path: String, entry_name: String) -> (Bytes, Array[(String, String, Int, Int)], Array[(String, String)]) with { Error, Fs } {\n  let (entry_stmts, resolved_type_stmts, linked_imports, linked_dep_specs) = collect_linked_compile_inputs(entry_path)\n  let stmts = empty_stmt_array()\n  append_stmt_array(stmts, resolved_type_stmts)\n  append_stmt_array(stmts, entry_stmts)\n  expand_interp_stmts(stmts)\n  let _ = check_program(stmts)\n  strip_generic_type_params(stmts)\n  let wasm = compile_wasi_module_linked_impl(stmts, entry_name, array_empty(), linked_imports, false, false, false, false, false, false, empty_dbg_prov(), codegen_body_cache_new(), codegen_body_cache_new(), 0, 0 - 1)\n  (wasm, linked_imports, linked_dep_specs)\n}\n\nexport fn compile_file_wasi_linked(entry_path: String, entry_name: String) -> (Bytes, Array[(String, String, Int, Int)]) with { Error, Fs } {\n  let (wasm, linked_imports, _) = compile_file_wasi_linked_artifacts(entry_path, entry_name)\n  (wasm, linked_imports)\n}\n")
}

let source_252 = () -> (String, String) {
  ("lib/@vibe/compiler/entry/source_compile/wasi_only/linked_library.vibe",
"\nimport @vibe/compiler/checker {\n  check_program\n}\n\nimport @vibe/core {\n  array_empty\n}\n\nimport @vibe/compiler/codegen/wasi {\n  compile_wasi_module_linked_impl\n}\n\nimport @vibe/compiler/codegen/common_base {\n  codegen_body_cache_new, empty_dbg_prov\n}\n\nimport @vibe/compiler/core {\n  Expr, Stmt, path_set_new\n}\n\nimport @vibe/compiler/syntax {\n  lex, parse_program\n}\n\n\n\n\n\nexport fn compile_file_wasi_library(dep_path: String) -> Bytes with { Error, Fs } {\n  let stmts = empty_stmt_array()\n  let visited = path_set_new()\n  collect_merged_stmts_recursive(dep_path, stmts, visited)\n  expand_interp_stmts(stmts)\n  let _ = check_program(stmts)\n  strip_generic_type_params(stmts)\n  compile_wasi_module_linked_impl(stmts, \"_start\", array_empty(), array_empty(), true, false, false, false, false, false, empty_dbg_prov(), codegen_body_cache_new(), codegen_body_cache_new(), 0, 0 - 1)\n}\n")
}

let source_253 = () -> (String, String) {
  ("lib/@vibe/compiler/entry/compiler/file_compile/index.vpkg",
"name = @vibe/compiler/entry/compiler/file_compile\nversion = 0.0.1\ndescription =\n  #|@vibe/compiler/entry/compiler/file_compile — the single-file (fs-rooted,\ndeps = {\n  @vibe/compiler/cache : 0.0.1\n  @vibe/compiler/checker : 0.0.1\n  @vibe/compiler/codegen : 0.0.1\n  @vibe/compiler/codegen/common_base : 0.0.1\n  @vibe/compiler/codegen/wasi : 0.0.1\n  @vibe/compiler/core : 0.0.1\n  @vibe/compiler/loader : 0.0.1\n  @vibe/compiler/runtime : 0.0.1\n  @vibe/compiler/syntax : 0.0.1\n  @vibe/core : 0.2.0\n}\n\ngenerated_hash =\n\n// @vibe/compiler/entry/compiler/file_compile — the single-file (fs-rooted,\n// no external module closure) compile drivers: every `compile_file_fs_*`\n// mode variant (mvp/rc/coverage/trace/break/profiled) plus their cached\n// twins threaded through a TypeDb (ADR-0070 Phase 3, #897, compiler-internal\n// batch). Compiled into the compiler itself via compiler_sources_manifest.tsv\n// (group `entry`, dual-row: this contract + file_compile.vibe).\n//\n// The old index.vibe was not a facade but the whole implementation (the\n// package is single-file), so it moved verbatim to file_compile.vibe. No\n// exported types: `TypeDb` (from ../../../runtime) arrives as structural\n// signature text resolved against the implementation import when the facade\n// is merged in (normalize/perceus precedent — no re-import needed here). No\n// `version` binding existed (compiler-internal package).\n\nfn prepare_file_fs_cached(db: TypeDb, entry_path: String) -> TypeDb with { Error, Fs }\nfn check_file_fs_mode(entry_path: String) -> Int with { Error, Fs }\nfn compile_file_fs_mode(entry_path: String, entry_name: String, mode: String) -> Bytes with { Error, Fs }\nfn compile_file_fs_mode_rc(entry_path: String, entry_name: String) -> Bytes with { Error, Fs }\nfn compile_file_fs_mode_rc_shadow(entry_path: String, entry_name: String) -> Bytes with { Error, Fs }\nfn compile_file_fs_mode_testmeta(entry_path: String, entry_name: String, mode: String, meta_out: String) -> Bytes with { Error, Fs }\nfn entry_cacheable_for_fs(entry_path: String, entry_name: String) -> Bool with { Error, Fs }\nfn compile_file_fs_mode_coverage(entry_path: String, entry_name: String) -> Bytes with { Error, Fs }\nfn compile_file_fs_mode_trace(entry_path: String, entry_name: String) -> Bytes with { Error, Fs }\nfn compile_file_fs_mode_break(entry_path: String, entry_name: String) -> Bytes with { Error, Fs }\nfn compile_file_fs_mode_profiled(entry_path: String, entry_name: String, mode: String) -> (Bytes, Int, Int, Int, Int, Int, Int) with { Error, Fs, Profiler }\nfn compile_file_fs_mode_cached(db: TypeDb, entry_path: String, entry_name: String, mode: String) -> (Bytes, TypeDb) with { Error, Fs }\nfn compile_file_fs_cached(db: TypeDb, entry_path: String, entry_name: String) -> (Bytes, TypeDb) with { Error, Fs }\nfn compile_file_fs_mode_cached_artifact_input_trace(entry_path: String, entry_name: String, mode: String, run_nonce: String) -> (Bytes, String) with { Error, Fs }\nfn compile_file_fs(entry_path: String, entry_name: String) -> Bytes with { Error, Fs }\nfn compile_file_fs_mode_cached_profiled(db: TypeDb, entry_path: String, entry_name: String, mode: String) -> (Bytes, TypeDb, Int, Int, Int, Int, Int, Int) with { Error, Fs, Profiler }\nfn compile_file_fs_module_cached(db: TypeDb, entry_path: String) -> (Bytes, TypeDb) with { Error, Fs }\nfn compile_file_fs_module(entry_path: String) -> Bytes with { Error, Fs }\n")
}

let source_254 = () -> (String, String) {
  ("lib/@vibe/compiler/entry/compiler/file_compile/file_compile.vibe",
"\nimport @vibe/compiler/syntax {\n  lex, lex_with_offsets, parse_program, parse_program_located\n}\n\nimport @vibe/core {\n  array_empty\n}\n\nimport @vibe/compiler/core {\n  ExportRenamePlan,\n  append_import_alias_rewritten_non_import_stmts_with_renames,\n  append_non_import_stmts_without_alias_rewrite,\n  apply_export_renames_stmts,\n  build_export_rename_plan,\n  collect_import_alias_collision_locals,\n  collect_import_alias_collision_refs,\n  collect_import_value_renames,\n  dce_stmts,\n  dir_of_path,\n  export_plan_renames_for,\n  import_value_rename_locals,\n  namespace_private_value_stmts,\n  resolve_import_path,\n  rewrite_imported_value_stmt_to_local,\n  stmts_have_import_deep\n}\n\nimport @vibe/compiler/codegen {\n  compile_module,\n  compile_wasi_module,\n  compile_wasi_module_break,\n  compile_wasi_module_coverage,\n  compile_wasi_module_rc,\n  compile_wasi_module_rc_shadow,\n  compile_wasi_module_trace\n}\n\nimport @vibe/compiler/codegen/common_base {\n  DbgProv\n}\n\nimport @vibe/compiler/codegen/wasi {\n  compile_wasi_module_impl\n}\n\nimport @vibe/compiler/loader {\n  collect_source_groups_fs, load_persistent_source_group_fingerprint_if_valid\n}\n\nimport @vibe/compiler/checker {\n  file_entry_cacheable, file_tests_cacheable\n}\n\nimport @vibe/compiler/runtime {\n  TypeDb,\n  db_grouped_merged_source,\n  db_load_artifact,\n  db_module_source,\n  db_new,\n  db_set_source,\n  db_store_artifact,\n  db_typecheck,\n  db_typecheck_fs,\n  parse_program_with_path\n}\n\nimport @vibe/compiler/cache {\n  build_file_compile_module_artifact_fingerprint_for_entry_path,\n  build_file_compile_module_artifact_fingerprint_from_group_fingerprint_for_entry_path,\n  build_file_compile_wasi_artifact_fingerprint_for_entry_path,\n  build_file_compile_wasi_artifact_fingerprint_from_group_fingerprint_for_entry_path,\n  build_source_groups_fingerprint,\n  load_persistent_artifact,\n  store_persistent_artifact\n}\n\n\nexport effect Profiler {\n  NowUs -> Int\n}\n\n\nfn profiler_now_us() -> Int with { Profiler } {\n  Profiler::now_us()\n}\n\nfn elapsed_us_since(start_us: Int) -> Int with { Profiler } {\n  let elapsed = profiler_now_us() - start_us\n  if elapsed < 0 {\n    0\n  } else {\n    elapsed\n  }\n}\n\nfn artifact_fingerprint_from_source(source: String) -> String {\n  let mod1 = 2147483647\n  let mod2 = 2147483629\n  let step1 = 131\n  let step2 = 65599\n  let len = String::length(source)\n  let mut h1 = 17\n  let mut h2 = 29\n  let mut i = 0\n  while i < len {\n    let c = String::char_code_at(source, i)\n    h1 = (h1 * step1 + c + 1) % mod1\n    h2 = (h2 * step2 + c + i + 1) % mod2\n    i = i + 1\n  }\n  String::concat(__to_string(len), String::concat(\":\", String::concat(__to_string(h1), String::concat(\":\", __to_string(h2)))))\n}\n\nfn seed_type_db_from_source_groups(db: TypeDb, source_groups: Array[(String, Array[(String, String)])]) -> TypeDb {\n  let mut seeded = db\n  let mut gi = 0\n  while gi < Array::length(source_groups) {\n    let (_, sources) = Array::get(source_groups, gi)\n    let mut si = 0\n    while si < Array::length(sources) {\n      let (path, source) = Array::get(sources, si)\n      seeded = db_set_source(seeded, path, source)\n      si = si + 1\n    }\n    gi = gi + 1\n  }\n  seeded\n}\n\nfn append_stmt_array(dst: Array[Stmt], src: Array[Stmt]) -> Unit {\n  let mut i = 0\n  while i < Array::length(src) {\n    Array::push(dst, Array::get(src, i))\n    i = i + 1\n  }\n}\n\nfn flatten_source_groups_local(source_groups: Array[(String, Array[(String, String)])]) -> Array[(String, String)] {\n  let flat = array_empty()\n  let mut gi = 0\n  while gi < Array::length(source_groups) {\n    let (_, sources) = Array::get(source_groups, gi)\n    let mut si = 0\n    while si < Array::length(sources) {\n      Array::push(flat, Array::get(sources, si))\n      si = si + 1\n    }\n    gi = gi + 1\n  }\n  flat\n}\n\nfn string_array_contains(items: Array[String], target: String) -> Bool {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(items) && !found {\n    if Array::get(items, i) == target {\n      found = true\n    } else {\n      i = i + 1\n    }\n  }\n  found\n}\n\nfn lookup_source_by_path(sources: Array[(String, String)], target_path: String) -> Option[String] {\n  let mut i = 0\n  let mut found = None\n  while i < Array::length(sources) {\n    let (path, source) = Array::get(sources, i)\n    if path == target_path {\n      found = Some(source)\n      i = Array::length(sources)\n    } else {\n      i = i + 1\n    }\n  }\n  found\n}\n\nfn parse_program_for_path(path: String, source: String) -> Array[Stmt] with { Error } {\n  parse_program_with_path(path, source)\n}\n\nfn append_import_alias_collision_defs_from_sources(merged: Array[Stmt], current_path: String, stmts: Array[Stmt], sources: Array[(String, String)], plan: ExportRenamePlan, excluded_locals: Array[String]) -> Unit with { Error } {\n  let refs = collect_import_alias_collision_refs(stmts)\n  let emitted = array_empty()\n  let base_dir = dir_of_path(current_path)\n  let mut i = 0\n  while i < Array::length(refs) {\n    let (raw_path, original, local) = Array::get(refs, i)\n    if !string_array_contains(emitted, local) && !string_array_contains(excluded_locals, local) {\n      let resolved = resolve_import_path(base_dir, raw_path)\n      match lookup_source_by_path(sources, resolved) {\n        Some(source) => {\n          let source_stmts = namespace_private_value_stmts(resolved, apply_export_renames_stmts(parse_program_for_path(resolved, source), export_plan_renames_for(plan, resolved)))\n          let mut j = 0\n          let mut done = false\n          while j < Array::length(source_stmts) && !done {\n            match rewrite_imported_value_stmt_to_local(Array::get(source_stmts, j), original, local) {\n              Some(local_stmt) => {\n                Array::push(merged, local_stmt)\n                Array::push(emitted, local)\n                done = true\n              },\n              None => ()\n            }\n            j = j + 1\n          }\n        },\n        None => ()\n      }\n    }\n    i = i + 1\n  }\n}\n\nfn parse_sources_for_merge(sources: Array[(String, String)]) -> (Array[String], Array[Array[Stmt]]) with { Error } {\n  let file_paths = array_empty()\n  let file_stmts = array_empty()\n  let mut si = 0\n  while si < Array::length(sources) {\n    let (path, source) = Array::get(sources, si)\n    Array::push(file_paths, path)\n    Array::push(file_stmts, parse_program_for_path(path, source))\n    si = si + 1\n  }\n  (file_paths, file_stmts)\n}\n\nfn append_merged_stmts_for_file(merged: Array[Stmt], path: String, stmts: Array[Stmt], is_entry_source: Bool, plan: ExportRenamePlan, sources: Array[(String, String)]) -> Unit with { Error } {\n  let export_renamed = if is_entry_source {\n    stmts\n  } else {\n    apply_export_renames_stmts(stmts, export_plan_renames_for(plan, path))\n  }\n  let namespaced_stmts = if is_entry_source {\n    export_renamed\n  } else {\n    namespace_private_value_stmts(path, export_renamed)\n  }\n  if stmts_have_import_deep(stmts) {\n    let import_renames = collect_import_value_renames(plan, path, stmts)\n    let skipped_locals = collect_import_alias_collision_locals(stmts)\n    append_import_alias_collision_defs_from_sources(merged, path, stmts, sources, plan, import_value_rename_locals(import_renames))\n    append_import_alias_rewritten_non_import_stmts_with_renames(merged, namespaced_stmts, skipped_locals, import_renames)\n  } else {\n    append_non_import_stmts_without_alias_rewrite(merged, namespaced_stmts)\n  }\n}\n\nfn build_merged_stmts_from_sources(entry_path: String, sources: Array[(String, String)]) -> Array[Stmt] with { Error } {\n  let merged = array_empty()\n  let source_count = Array::length(sources)\n  let (file_paths, file_stmts) = parse_sources_for_merge(sources)\n  let plan_entry = if entry_path == \"\" {\n    if source_count > 0 {\n      Array::get(file_paths, source_count - 1)\n    } else {\n      \"\"\n    }\n  } else {\n    entry_path\n  }\n  let plan = build_export_rename_plan(file_paths, file_stmts, plan_entry)\n  let mut si = 0\n  while si < source_count {\n    let path = Array::get(file_paths, si)\n    let is_entry_source = if entry_path == \"\" {\n      si == source_count - 1\n    } else {\n      path == entry_path\n    }\n    append_merged_stmts_for_file(merged, path, Array::get(file_stmts, si), is_entry_source, plan, sources)\n    si = si + 1\n  }\n  merged\n}\n\nfn build_grouped_merged_stmts(source_groups: Array[(String, Array[(String, String)])]) -> Array[Stmt] with { Error } {\n  let merged = array_empty()\n  let flat_sources = flatten_source_groups_local(source_groups)\n  let (file_paths, file_stmts) = parse_sources_for_merge(flat_sources)\n  let plan_entry = if Array::length(file_paths) > 0 {\n    Array::get(file_paths, Array::length(file_paths) - 1)\n  } else {\n    \"\"\n  }\n  let plan = build_export_rename_plan(file_paths, file_stmts, plan_entry)\n  let flat_total = Array::length(file_paths)\n  let mut flat_idx = 0\n  let mut gi = 0\n  while gi < Array::length(source_groups) {\n    let (_, sources) = Array::get(source_groups, gi)\n    let source_count = Array::length(sources)\n    let mut si = 0\n    while si < source_count {\n      let path = Array::get(file_paths, flat_idx)\n      let stmts = Array::get(file_stmts, flat_idx)\n      append_merged_stmts_for_file(merged, path, stmts, flat_idx == flat_total - 1, plan, flat_sources)\n      flat_idx = flat_idx + 1\n      si = si + 1\n    }\n    gi = gi + 1\n  }\n  merged\n}\n\nfn path_basename(p: String) -> String {\n  let n = String::length(p)\n  let mut last = 0 - 1\n  let mut i = 0\n  while i < n {\n    if String::char_code_at(p, i) == 47 {\n      last = i\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  String::substring(p, last + 1, n)\n}\n\nfn file_newline_offsets(src: String) -> Array[Int] {\n  let arr = array_empty()\n  let n = String::length(src)\n  let mut i = 0\n  while i < n {\n    if String::char_code_at(src, i) == 10 {\n      Array::push(arr, i)\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  arr\n}\n\nfn build_grouped_merged_stmts_prov(source_groups: Array[(String, Array[(String, String)])]) -> (Array[Stmt], Array[String], Array[Array[Int]], Array[Int]) with { Error } {\n  let merged = array_empty()\n  let files = array_empty()\n  let file_nls = array_empty()\n  let stmt_file_id = array_empty()\n  let flat_sources = flatten_source_groups_local(source_groups)\n  let (file_paths, file_stmts) = parse_sources_for_merge(flat_sources)\n  let plan_entry = if Array::length(file_paths) > 0 {\n    Array::get(file_paths, Array::length(file_paths) - 1)\n  } else {\n    \"\"\n  }\n  let plan = build_export_rename_plan(file_paths, file_stmts, plan_entry)\n  let mut flat_idx = 0\n  let mut gi = 0\n  while gi < Array::length(source_groups) {\n    let (_, sources) = Array::get(source_groups, gi)\n    let source_count = Array::length(sources)\n    let mut si = 0\n    while si < source_count {\n      let (path, source) = Array::get(sources, si)\n      let file_id = Array::length(files)\n      Array::push(files, path_basename(path))\n      Array::push(file_nls, file_newline_offsets(source))\n      let before = Array::length(merged)\n      append_merged_stmts_for_file(merged, path, Array::get(file_stmts, flat_idx), flat_idx == Array::length(file_paths) - 1, plan, flat_sources)\n      let after = Array::length(merged)\n      let mut k = before\n      while k < after {\n        Array::push(stmt_file_id, file_id)\n        k = k + 1\n      }\n      flat_idx = flat_idx + 1\n      si = si + 1\n    }\n    gi = gi + 1\n  }\n  (merged, files, file_nls, stmt_file_id)\n}\n\nfn prepare_file_fs_from_source_groups_cached(db: TypeDb, entry_path: String, source_groups: Array[(String, Array[(String, String)])]) -> TypeDb with { Error } {\n  let seeded = seed_type_db_from_source_groups(db, source_groups)\n  db_typecheck(seeded, entry_path)\n}\n\nfn prepare_file_fs_from_source_groups_persistent_cached(db: TypeDb, entry_path: String, source_groups: Array[(String, Array[(String, String)])]) -> TypeDb with { Error, Fs } {\n  let seeded = seed_type_db_from_source_groups(db, source_groups)\n  db_typecheck_fs(seeded, entry_path)\n}\n\nexport fn prepare_file_fs_cached(db: TypeDb, entry_path: String) -> TypeDb with { Error, Fs } {\n  let source_groups = collect_source_groups_fs(entry_path)\n  prepare_file_fs_from_source_groups_persistent_cached(db, entry_path, source_groups)\n}\n\nexport fn check_file_fs_mode(entry_path: String) -> Int with { Error, Fs } {\n  let _ = prepare_file_fs_cached(db_new(), entry_path)\n  0\n}\n\nexport fn compile_file_fs_mode(entry_path: String, entry_name: String, mode: String) -> Bytes with { Error, Fs } {\n  let source_groups = collect_source_groups_fs(entry_path)\n  let next_db = prepare_file_fs_from_source_groups_persistent_cached(db_new(), entry_path, source_groups)\n  let _ = next_db\n  let merged_stmts = build_grouped_merged_stmts(source_groups)\n  if mode == \"mvp\" {\n    let pruned_stmts = dce_stmts(merged_stmts, [\n      entry_name\n    ])\n    compile_wasi_module_impl(pruned_stmts, entry_name)\n  } else if mode == \"no-dce\" {\n    compile_wasi_module(merged_stmts, entry_name)\n  } else {\n    throw(String::concat(\"unsupported compile mode: \", mode))\n  }\n}\n\nexport fn compile_file_fs_mode_rc(entry_path: String, entry_name: String) -> Bytes with { Error, Fs } {\n  let source_groups = collect_source_groups_fs(entry_path)\n  let next_db = prepare_file_fs_from_source_groups_persistent_cached(db_new(), entry_path, source_groups)\n  let _ = next_db\n  let merged_stmts = build_grouped_merged_stmts(source_groups)\n  compile_wasi_module_rc(merged_stmts, entry_name)\n}\n\nexport fn compile_file_fs_mode_rc_shadow(entry_path: String, entry_name: String) -> Bytes with { Error, Fs } {\n  let source_groups = collect_source_groups_fs(entry_path)\n  let next_db = prepare_file_fs_from_source_groups_persistent_cached(db_new(), entry_path, source_groups)\n  let _ = next_db\n  let merged_stmts = build_grouped_merged_stmts(source_groups)\n  compile_wasi_module_rc_shadow(merged_stmts, entry_name)\n}\n\nexport fn compile_file_fs_mode_testmeta(entry_path: String, entry_name: String, mode: String, meta_out: String) -> Bytes with { Error, Fs } {\n  let source_groups = collect_source_groups_fs(entry_path)\n  let next_db = prepare_file_fs_from_source_groups_persistent_cached(db_new(), entry_path, source_groups)\n  let _ = next_db\n  let merged_stmts = build_grouped_merged_stmts(source_groups)\n  let cacheable = if meta_out != \"\" {\n    file_tests_cacheable(merged_stmts)\n  } else {\n    false\n  }\n  let bytes = if mode == \"mvp\" {\n    let pruned_stmts = dce_stmts(merged_stmts, [\n      entry_name\n    ])\n    compile_wasi_module_impl(pruned_stmts, entry_name)\n  } else if mode == \"no-dce\" {\n    compile_wasi_module(merged_stmts, entry_name)\n  } else {\n    throw(String::concat(\"unsupported compile mode: \", mode))\n  }\n  if meta_out != \"\" {\n    Fs::write_file(meta_out, if cacheable {\n      \"1\"\n    } else {\n      \"0\"\n    })\n  } else {\n    ()\n  }\n  bytes\n}\n\nexport fn entry_cacheable_for_fs(entry_path: String, entry_name: String) -> Bool with { Error, Fs } {\n  let source_groups = collect_source_groups_fs(entry_path)\n  let next_db = prepare_file_fs_from_source_groups_persistent_cached(db_new(), entry_path, source_groups)\n  let _ = next_db\n  let merged_stmts = build_grouped_merged_stmts(source_groups)\n  file_entry_cacheable(merged_stmts, entry_name)\n}\n\nexport fn compile_file_fs_mode_coverage(entry_path: String, entry_name: String) -> Bytes with { Error, Fs } {\n  let source_groups = collect_source_groups_fs(entry_path)\n  let next_db = prepare_file_fs_from_source_groups_persistent_cached(db_new(), entry_path, source_groups)\n  let _ = next_db\n  let merged_stmts = build_grouped_merged_stmts(source_groups)\n  compile_wasi_module_coverage(merged_stmts, entry_name)\n}\n\nexport fn compile_file_fs_mode_trace(entry_path: String, entry_name: String) -> Bytes with { Error, Fs } {\n  let source_groups = collect_source_groups_fs(entry_path)\n  let next_db = prepare_file_fs_from_source_groups_persistent_cached(db_new(), entry_path, source_groups)\n  let _ = next_db\n  let merged_stmts = build_grouped_merged_stmts(source_groups)\n  compile_wasi_module_trace(merged_stmts, entry_name)\n}\n\nexport fn compile_file_fs_mode_break(entry_path: String, entry_name: String) -> Bytes with { Error, Fs } {\n  let source_groups = collect_source_groups_fs(entry_path)\n  let next_db = prepare_file_fs_from_source_groups_persistent_cached(db_new(), entry_path, source_groups)\n  let _ = next_db\n  let (merged_stmts, dbg_files, dbg_file_nls, dbg_stmt_file_id) = build_grouped_merged_stmts_prov(source_groups)\n  compile_wasi_module_break(merged_stmts, entry_name, DbgProv::{\n    files: dbg_files,\n    file_nls: dbg_file_nls,\n    stmt_file_id: dbg_stmt_file_id\n  })\n}\n\nexport fn compile_file_fs_mode_profiled(entry_path: String, entry_name: String, mode: String) -> (Bytes, Int, Int, Int, Int, Int, Int) with { Error, Fs, Profiler } {\n  let total_start = profiler_now_us()\n  let load_start = profiler_now_us()\n  let source_groups = collect_source_groups_fs(entry_path)\n  let load_us = elapsed_us_since(load_start)\n  let type_start = profiler_now_us()\n  let next_db = prepare_file_fs_from_source_groups_persistent_cached(db_new(), entry_path, source_groups)\n  let _ = next_db\n  let type_us = elapsed_us_since(type_start)\n  let bundle_start = profiler_now_us()\n  let _ = build_source_groups_fingerprint(source_groups)\n  let bundle_us = elapsed_us_since(bundle_start)\n  let parse_start = profiler_now_us()\n  let merged_stmts = build_grouped_merged_stmts(source_groups)\n  let parse_us = elapsed_us_since(parse_start)\n  let compile_start = profiler_now_us()\n  let bytes = if mode == \"mvp\" {\n    let pruned_stmts = dce_stmts(merged_stmts, [\n      entry_name\n    ])\n    compile_wasi_module_impl(pruned_stmts, entry_name)\n  } else if mode == \"no-dce\" {\n    compile_wasi_module(merged_stmts, entry_name)\n  } else {\n    throw(String::concat(\"unsupported compile mode: \", mode))\n  }\n  let compile_us = elapsed_us_since(compile_start)\n  (bytes, load_us, type_us, bundle_us, parse_us, compile_us, elapsed_us_since(total_start))\n}\n\nfn compile_file_fs_mode_cached_slow_profiled(db: TypeDb, entry_path: String, entry_name: String, mode: String, persistent_artifact_kind: String) -> (Bytes, TypeDb, Int, Int, Int, Int, Int) with { Error, Fs, Profiler } {\n  let load_start = profiler_now_us()\n  let source_groups = collect_source_groups_fs(entry_path)\n  let persistent_artifact_fingerprint = build_file_compile_wasi_artifact_fingerprint_for_entry_path(source_groups, entry_path, entry_name, mode)\n  match load_persistent_artifact(persistent_artifact_kind, entry_name, persistent_artifact_fingerprint) {\n    Some(bytes) => (bytes, db, elapsed_us_since(load_start), 0, 0, 0, 0),\n    None => {\n      let load_us = elapsed_us_since(load_start)\n      let type_start = profiler_now_us()\n      let next_db = prepare_file_fs_from_source_groups_persistent_cached(db, entry_path, source_groups)\n      let type_us = elapsed_us_since(type_start)\n      let bundle_start = profiler_now_us()\n      let merge_fingerprint = build_source_groups_fingerprint(source_groups)\n      let bundle_us = elapsed_us_since(bundle_start)\n      let artifact_fingerprint = merge_fingerprint\n      let artifact_kind = if mode == \"mvp\" {\n        \"wasi-mvp\"\n      } else if mode == \"no-dce\" {\n        \"wasi\"\n      } else {\n        throw(String::concat(\"unsupported compile mode: \", mode))\n      }\n      match db_load_artifact(next_db, entry_path, artifact_kind, entry_name, artifact_fingerprint) {\n        Some(bytes) => (bytes, next_db, load_us, type_us, bundle_us, 0, 0),\n        None => {\n          let parse_start = profiler_now_us()\n          let merged_stmts = build_grouped_merged_stmts(source_groups)\n          let parse_us = elapsed_us_since(parse_start)\n          let compile_start = profiler_now_us()\n          let bytes = if mode == \"mvp\" {\n            let pruned_stmts = dce_stmts(merged_stmts, [\n              entry_name\n            ])\n            compile_wasi_module_impl(pruned_stmts, entry_name)\n          } else {\n            compile_wasi_module(merged_stmts, entry_name)\n          }\n          store_persistent_artifact(persistent_artifact_kind, entry_name, persistent_artifact_fingerprint, bytes)\n          let compile_us = elapsed_us_since(compile_start)\n          (bytes, db_store_artifact(next_db, entry_path, artifact_kind, entry_name, artifact_fingerprint, bytes), load_us, type_us, bundle_us, parse_us, compile_us)\n        }\n      }\n    }\n  }\n}\n\nfn compile_file_fs_mode_cached_slow_observed(db: TypeDb, entry_path: String, entry_name: String, mode: String, persistent_artifact_kind: String) -> (Bytes, TypeDb, String, String, String) with { Error, Fs } {\n  let source_groups = collect_source_groups_fs(entry_path)\n  let source_groups_fingerprint = build_source_groups_fingerprint(source_groups)\n  let persistent_artifact_fingerprint = build_file_compile_wasi_artifact_fingerprint_from_group_fingerprint_for_entry_path(source_groups_fingerprint, entry_path, entry_name, mode)\n  match load_persistent_artifact(persistent_artifact_kind, entry_name, persistent_artifact_fingerprint) {\n    Some(bytes) => (bytes, db, source_groups_fingerprint, persistent_artifact_fingerprint, \"hit\"),\n    None => {\n      let next_db = prepare_file_fs_from_source_groups_persistent_cached(db, entry_path, source_groups)\n      let artifact_fingerprint = source_groups_fingerprint\n      let artifact_kind = if mode == \"mvp\" {\n        \"wasi-mvp\"\n      } else if mode == \"no-dce\" {\n        \"wasi\"\n      } else {\n        throw(String::concat(\"unsupported compile mode: \", mode))\n      }\n      match db_load_artifact(next_db, entry_path, artifact_kind, entry_name, artifact_fingerprint) {\n        Some(bytes) => (bytes, next_db, source_groups_fingerprint, persistent_artifact_fingerprint, \"miss\"),\n        None => {\n          let merged_stmts = build_grouped_merged_stmts(source_groups)\n          let bytes = if mode == \"mvp\" {\n            let pruned_stmts = dce_stmts(merged_stmts, [\n              entry_name\n            ])\n            compile_wasi_module_impl(pruned_stmts, entry_name)\n          } else {\n            compile_wasi_module(merged_stmts, entry_name)\n          }\n          store_persistent_artifact(persistent_artifact_kind, entry_name, persistent_artifact_fingerprint, bytes)\n          (bytes, db_store_artifact(next_db, entry_path, artifact_kind, entry_name, artifact_fingerprint, bytes), source_groups_fingerprint, persistent_artifact_fingerprint, \"miss\")\n        }\n      }\n    }\n  }\n}\n\nfn compile_file_fs_mode_cached_observed(db: TypeDb, entry_path: String, entry_name: String, mode: String) -> (Bytes, TypeDb, String, String, String) with { Error, Fs } {\n  let persistent_artifact_kind = if mode == \"mvp\" {\n    \"file-compile-wasi-mvp\"\n  } else if mode == \"no-dce\" {\n    \"file-compile-wasi\"\n  } else {\n    throw(String::concat(\"unsupported compile mode: \", mode))\n  }\n  match load_persistent_source_group_fingerprint_if_valid(entry_path) {\n    Some(source_groups_fingerprint) => {\n      let persistent_artifact_fingerprint = build_file_compile_wasi_artifact_fingerprint_from_group_fingerprint_for_entry_path(source_groups_fingerprint, entry_path, entry_name, mode)\n      match load_persistent_artifact(persistent_artifact_kind, entry_name, persistent_artifact_fingerprint) {\n        Some(bytes) => (bytes, db, source_groups_fingerprint, persistent_artifact_fingerprint, \"hit\"),\n        None => compile_file_fs_mode_cached_slow_observed(db, entry_path, entry_name, mode, persistent_artifact_kind)\n      }\n    },\n    None => compile_file_fs_mode_cached_slow_observed(db, entry_path, entry_name, mode, persistent_artifact_kind)\n  }\n}\n\nexport fn compile_file_fs_mode_cached(db: TypeDb, entry_path: String, entry_name: String, mode: String) -> (Bytes, TypeDb) with { Error, Fs } {\n  let (bytes, next_db, _, _, _) = compile_file_fs_mode_cached_observed(db, entry_path, entry_name, mode)\n  (bytes, next_db)\n}\n\nexport fn compile_file_fs_cached(db: TypeDb, entry_path: String, entry_name: String) -> (Bytes, TypeDb) with { Error, Fs } {\n  compile_file_fs_mode_cached(db, entry_path, entry_name, \"no-dce\")\n}\n\nfn artifact_input_trace_json_string(text: String) -> String {\n  let out = StringBuilder::new()\n  StringBuilder::push(out, \"\\\"\")\n  let mut i = 0\n  while i < String::length(text) {\n    let c = String::char_code_at(text, i)\n    if c == '\"' {\n      StringBuilder::push(out, \"\\\\\\\"\")\n    } else if c == '\\\\' {\n      StringBuilder::push(out, \"\\\\\\\\\")\n    } else if c == '\\n' {\n      StringBuilder::push(out, \"\\\\n\")\n    } else if c == '\\r' {\n      StringBuilder::push(out, \"\\\\r\")\n    } else if c == '\\t' {\n      StringBuilder::push(out, \"\\\\t\")\n    } else if c < 32 {\n      let hex = \"0123456789abcdef\"\n      StringBuilder::push(out, \"\\\\u00\")\n      StringBuilder::push(out, String::substring(hex, c / 16, c / 16 + 1))\n      StringBuilder::push(out, String::substring(hex, c % 16, c % 16 + 1))\n    } else {\n      StringBuilder::push(out, String::from_char_code(c))\n    }\n    i = i + 1\n  }\n  StringBuilder::push(out, \"\\\"\")\n  StringBuilder::freeze(out)\n}\n\nexport fn compile_file_fs_mode_cached_artifact_input_trace(entry_path: String, entry_name: String, mode: String, run_nonce: String) -> (Bytes, String) with { Error, Fs } {\n  if mode != \"no-dce\" {\n    throw(\"artifact-input trace only supports file_compile WASI no-dce\")\n  } else if run_nonce == \"\" {\n    throw(\"artifact-input trace requires a non-empty run nonce\")\n  } else {\n    let persistent_artifact_kind = \"file-compile-wasi\"\n    let (bytes, _, source_groups_fingerprint, artifact_input_fingerprint, persistent_lookup) = compile_file_fs_mode_cached_observed(db_new(), entry_path, entry_name, mode)\n    let out = StringBuilder::new()\n    StringBuilder::push(out, \"{\\\"schema\\\":1,\\\"run_nonce\\\":\")\n    StringBuilder::push(out, artifact_input_trace_json_string(run_nonce))\n    StringBuilder::push(out, \",\\\"scope_disclaimer\\\":\\\"observation-only file_compile persistent pre-strip WASI bump lane; not a production cache key, format, or reuse decision\\\",\\\"compile_lane\\\":\\\"file_compile.persistent_pre_strip_wasi_cached_bump\\\",\\\"persistent_artifact_kind\\\":\")\n    StringBuilder::push(out, artifact_input_trace_json_string(persistent_artifact_kind))\n    StringBuilder::push(out, \",\\\"entry\\\":{\\\"path\\\":\")\n    StringBuilder::push(out, artifact_input_trace_json_string(entry_path))\n    StringBuilder::push(out, \",\\\"name\\\":\")\n    StringBuilder::push(out, artifact_input_trace_json_string(entry_name))\n    StringBuilder::push(out, \",\\\"mode\\\":\")\n    StringBuilder::push(out, artifact_input_trace_json_string(mode))\n    StringBuilder::push(out, \"},\\\"source_groups_fingerprint\\\":\")\n    StringBuilder::push(out, artifact_input_trace_json_string(source_groups_fingerprint))\n    StringBuilder::push(out, \",\\\"source_groups_fingerprint_kind\\\":\\\"build_source_groups_fingerprint(source_groups)\\\",\\\"artifact_input_fingerprint\\\":\")\n    StringBuilder::push(out, artifact_input_trace_json_string(artifact_input_fingerprint))\n    StringBuilder::push(out, \",\\\"artifact_input_fingerprint_kind\\\":\\\"build_file_compile_wasi_artifact_fingerprint_from_group_fingerprint_for_entry_path(source_groups_fingerprint, entry_path, entry_name, mode)\\\",\\\"persistent_lookup\\\":\")\n    StringBuilder::push(out, artifact_input_trace_json_string(persistent_lookup))\n    StringBuilder::push(out, \"}\")\n    (bytes, StringBuilder::freeze(out))\n  }\n}\n\nexport fn compile_file_fs(entry_path: String, entry_name: String) -> Bytes with { Error, Fs } {\n  let (bytes, _) = compile_file_fs_cached(db_new(), entry_path, entry_name)\n  bytes\n}\n\nexport fn compile_file_fs_mode_cached_profiled(db: TypeDb, entry_path: String, entry_name: String, mode: String) -> (Bytes, TypeDb, Int, Int, Int, Int, Int, Int) with { Error, Fs, Profiler } {\n  let total_start = profiler_now_us()\n  let persistent_artifact_kind = if mode == \"mvp\" {\n    \"file-compile-wasi-mvp\"\n  } else if mode == \"no-dce\" {\n    \"file-compile-wasi\"\n  } else {\n    throw(String::concat(\"unsupported compile mode: \", mode))\n  }\n  let load_start = profiler_now_us()\n  match load_persistent_source_group_fingerprint_if_valid(entry_path) {\n    Some(source_groups_fingerprint) =>\n    match load_persistent_artifact(persistent_artifact_kind, entry_name, build_file_compile_wasi_artifact_fingerprint_from_group_fingerprint_for_entry_path(source_groups_fingerprint, entry_path, entry_name, mode)) {\n      Some(bytes) => (bytes, db, elapsed_us_since(load_start), 0, 0, 0, 0, elapsed_us_since(total_start)),\n      None => {\n        let prefix_load_us = elapsed_us_since(load_start)\n        let (bytes, next_db, load_us, type_us, bundle_us, parse_us, compile_us) = compile_file_fs_mode_cached_slow_profiled(db, entry_path, entry_name, mode, persistent_artifact_kind)\n        (bytes, next_db, prefix_load_us + load_us, type_us, bundle_us, parse_us, compile_us, elapsed_us_since(total_start))\n      }\n    },\n    None => {\n      let prefix_load_us = elapsed_us_since(load_start)\n      let (bytes, next_db, load_us, type_us, bundle_us, parse_us, compile_us) = compile_file_fs_mode_cached_slow_profiled(db, entry_path, entry_name, mode, persistent_artifact_kind)\n      (bytes, next_db, prefix_load_us + load_us, type_us, bundle_us, parse_us, compile_us, elapsed_us_since(total_start))\n    }\n  }\n}\n\nfn compile_file_fs_module_cached_slow(db: TypeDb, entry_path: String) -> (Bytes, TypeDb) with { Error, Fs } {\n  let source_groups = collect_source_groups_fs(entry_path)\n  let persistent_artifact_fingerprint = build_file_compile_module_artifact_fingerprint_for_entry_path(source_groups, entry_path)\n  match load_persistent_artifact(\"file-compile-module\", \"\", persistent_artifact_fingerprint) {\n    Some(bytes) => (bytes, db),\n    None => {\n      let next_db = prepare_file_fs_from_source_groups_persistent_cached(db, entry_path, source_groups)\n      let (merged_source, merge_fingerprint, module_db) = db_grouped_merged_source(next_db, source_groups)\n      let (module_source, codegen_db) = db_module_source(module_db, merge_fingerprint, merged_source)\n      let artifact_fingerprint = artifact_fingerprint_from_source(module_source)\n      match db_load_artifact(codegen_db, entry_path, \"module\", \"\", artifact_fingerprint) {\n        Some(bytes) => (bytes, codegen_db),\n        None => {\n          let merged_stmts = parse_program(lex(module_source))\n          let bytes = compile_module(merged_stmts)\n          store_persistent_artifact(\"file-compile-module\", \"\", persistent_artifact_fingerprint, bytes)\n          (bytes, db_store_artifact(codegen_db, entry_path, \"module\", \"\", artifact_fingerprint, bytes))\n        }\n      }\n    }\n  }\n}\n\nexport fn compile_file_fs_module_cached(db: TypeDb, entry_path: String) -> (Bytes, TypeDb) with { Error, Fs } {\n  match load_persistent_source_group_fingerprint_if_valid(entry_path) {\n    Some(source_groups_fingerprint) =>\n    match load_persistent_artifact(\"file-compile-module\", \"\", build_file_compile_module_artifact_fingerprint_from_group_fingerprint_for_entry_path(source_groups_fingerprint, entry_path)) {\n      Some(bytes) => (bytes, db),\n      None => compile_file_fs_module_cached_slow(db, entry_path)\n    },\n    None => compile_file_fs_module_cached_slow(db, entry_path)\n  }\n}\n\nexport fn compile_file_fs_module(entry_path: String) -> Bytes with { Error, Fs } {\n  let (bytes, _) = compile_file_fs_module_cached(db_new(), entry_path)\n  bytes\n}\n")
}

let source_255 = () -> (String, String) {
  ("lib/@vibe/compiler/cli_support.vibe",
"\nimport @vibe/compiler/codegen/wasi {\n  compile_wasi_module_linked_impl\n}\n\nimport @vibe/core {\n  array_empty\n}\n\nimport @vibe/compiler/codegen/common_base {\n  codegen_body_cache_new, empty_dbg_prov\n}\n\nimport @vibe/compiler/core {\n  Stmt\n}\n\nimport @vibe/compiler/entry/compiler/file_compile {\n  check_file_fs_mode, compile_file_fs_mode, compile_file_fs_mode_cached, compile_file_fs_mode_cached_profiled, compile_file_fs_mode_profiled\n}\n\nimport @vibe/compiler/entry/source_compile/wasi_only {\n  collect_linked_compile_inputs, collect_linked_dep_inputs_for_stmts, compile_file_wasi_library, expand_interp_stmts\n}\n\n\nimport @vibe/compiler/runtime {\n  check_inline_wasm_fns, locate_type_error\n}\n\nimport @vibe/compiler/syntax {\n  lex_with_offsets, parse_program_recovering\n}\n\n\nfn append_stmt_array(dst: Array[Stmt], src: Array[Stmt]) -> Unit {\n  let mut i = 0\n  while i < Array::length(src) {\n    Array::push(dst, Array::get(src, i))\n    i = i + 1\n  }\n}\n\nfn linked_output_dir(output_path: String) -> String {\n  let len = String::length(output_path)\n  if len >= 5 && output_path[len - 5: len] == \".wasm\" {\n    String::concat(output_path[0: len - 5], \".debug\")\n  } else {\n    String::concat(output_path, \".debug\")\n  }\n}\n\nfn empty_source_pairs() -> Array[(String, String)] {\n  array_empty()\n}\n\nfn normalize_release_mode(mode: String) -> String with { Error } {\n  if mode == \"\" || mode == \"release\" || mode == \"no-dce\" {\n    \"no-dce\"\n  } else if mode == \"mvp\" {\n    \"mvp\"\n  } else {\n    throw(String::concat(\"unsupported release mode: \", mode))\n  }\n}\n\nexport fn compile_release_file_mode(input_path: String, entry_name: String, mode: String) -> Bytes with { Error, Fs } {\n  let compile_mode = normalize_release_mode(mode)\n  let (bytes, _) = compile_file_fs_mode_cached(db_new(), input_path, entry_name, compile_mode)\n  bytes\n}\n\nexport fn compile_release_file_mode_uncached(input_path: String, entry_name: String, mode: String) -> Bytes with { Error, Fs } {\n  let compile_mode = normalize_release_mode(mode)\n  compile_file_fs_mode(input_path, entry_name, compile_mode)\n}\n\nexport fn compile_release_file_mode_profiled(input_path: String, entry_name: String, mode: String) -> (Bytes, Int, Int, Int, Int, Int, Int) with { Error, Fs, Profiler } {\n  let compile_mode = normalize_release_mode(mode)\n  let (bytes, _, load_us, type_us, bundle_us, parse_us, compile_us, total_us) = compile_file_fs_mode_cached_profiled(db_new(), input_path, entry_name, compile_mode)\n  (bytes, load_us, type_us, bundle_us, parse_us, compile_us, total_us)\n}\n\nexport fn compile_release_file_mode_uncached_profiled(input_path: String, entry_name: String, mode: String) -> (Bytes, Int, Int, Int, Int, Int, Int) with { Error, Fs, Profiler } {\n  let compile_mode = normalize_release_mode(mode)\n  compile_file_fs_mode_profiled(input_path, entry_name, compile_mode)\n}\n\nexport fn compile_release_file(input_path: String, entry_name: String) -> Bytes with { Error, Fs } {\n  compile_release_file_mode(input_path, entry_name, \"no-dce\")\n}\n\nexport fn compile_debug_library(dep_path: String) -> Bytes with { Error, Fs } {\n  compile_file_wasi_library(dep_path)\n}\n\nfn append_non_import_stmts(dst: Array[Stmt], src: Array[Stmt]) -> Unit {\n  let mut i = 0\n  while i < Array::length(src) {\n    match Array::get(src, i) {\n      SImport(_, _) => (),\n      SReExport(_, _) => (),\n      SAliasDecl(_, _) => (),\n      _ => Array::push(dst, Array::get(src, i))\n    }\n    i = i + 1\n  }\n}\n\nexport fn build_linked_debug_entry(input_path: String, entry_name: String) -> (Bytes, Array[(String, String)]) with { Error, Fs } {\n  let (entry_stmts, resolved_type_stmts, linked_imports, linked_dep_specs) = collect_linked_compile_inputs(input_path)\n  let main_stmts = array_empty()\n  append_stmt_array(main_stmts, resolved_type_stmts)\n  append_non_import_stmts(main_stmts, entry_stmts)\n  let bytes = compile_wasi_module_linked_impl(main_stmts, entry_name, empty_source_pairs(), linked_imports, false, false, false, false, false, false, empty_dbg_prov(), codegen_body_cache_new(), codegen_body_cache_new(), 0, 0 - 1)\n  (bytes, linked_dep_specs)\n}\n\nexport fn check_linked_file(input_path: String) -> Int with { Error, Fs } {\n  let entry_source = Fs::read_file(input_path)\n  let (tokens, starts, _ends) = lex_with_offsets(entry_source)\n  let (entry_stmts, parse_diags) = parse_program_recovering(tokens, starts, entry_source)\n  if Array::length(parse_diags) > 0 {\n    throw(Array::get(parse_diags, 0))\n  } else {\n    ()\n  }\n  handle {\n    let _ = check_file_fs_mode(input_path)\n    let (resolved_type_stmts, _linked_imports, _linked_dep_specs) = collect_linked_dep_inputs_for_stmts(input_path, entry_stmts)\n    let stmts = array_empty()\n    append_stmt_array(stmts, resolved_type_stmts)\n    append_stmt_array(stmts, entry_stmts)\n    expand_interp_stmts(stmts)\n    match check_inline_wasm_fns(stmts) {\n      Some(msg) => throw(locate_type_error(entry_source, msg)),\n      None => ()\n    }\n  } with Error {\n    Throw(msg) => throw(locate_type_error(entry_source, msg))\n  }\n  0\n}\n\n\nfn strip_read_uleb(wasm: Bytes, start: Int, end: Int) -> (Int, Int) {\n  let mut i = start\n  let mut v = 0\n  let mut shift = 0\n  while i < end && shift < 35 {\n    let b = Bytes::get(wasm, i)\n    v = v|((b&127)<<shift)\n    i = i + 1\n    if (b&128) == 0 {\n      return (v, i)\n    } else {\n      shift = shift + 7\n    }\n  }\n  (0 - 1, end)\n}\n\nfn strip_bytes_range_eq_str(wasm: Bytes, start: Int, n: Int, s: String) -> Bool {\n  if n != String::length(s) {\n    false\n  } else {\n    let mut i = 0\n    let mut same = true\n    while same && i < n {\n      if Bytes::get(wasm, start + i) != String::char_code_at(s, i) {\n        same = false\n      } else {\n        i = i + 1\n      }\n    }\n    same\n  }\n}\n\nfn strip_bytes_range_starts_with(wasm: Bytes, start: Int, n: Int, prefix: String) -> Bool {\n  let plen = String::length(prefix)\n  if n < plen {\n    false\n  } else {\n    strip_bytes_range_eq_str(wasm, start, plen, prefix)\n  }\n}\n\nfn strip_push_range(out: Bytes, wasm: Bytes, start: Int, end: Int) -> Unit {\n  let mut i = start\n  while i < end {\n    Bytes::push(out, Bytes::get(wasm, i))\n    i = i + 1\n  }\n}\n\nfn strip_push_uleb(out: Bytes, value: Int) -> Unit {\n  let mut v = value\n  let mut more = true\n  while more {\n    let b = v&127\n    v = v>>7\n    if v == 0 {\n      Bytes::push(out, b)\n      more = false\n    } else {\n      Bytes::push(out, b|128)\n    }\n  }\n}\n\nexport fn strip_executable_wasm(wasm: Bytes, entry_name: String, strip_names: Bool, filter_exports: Bool) -> Bytes {\n  if !strip_names && !filter_exports {\n    return wasm\n  } else {\n    ()\n  }\n  let len = Bytes::length(wasm)\n  if len < 8 {\n    return wasm\n  } else {\n    ()\n  }\n  let out = Bytes::new()\n  strip_push_range(out, wasm, 0, 8)\n  let mut i = 8\n  let mut ok = true\n  while ok && i < len {\n    let sid = Bytes::get(wasm, i)\n    let (ssz, payload_start) = strip_read_uleb(wasm, i + 1, len)\n    if ssz < 0 || payload_start + ssz > len {\n      ok = false\n    } else {\n      let payload_end = payload_start + ssz\n      let mut handled = false\n      if sid == 0 && strip_names {\n        let (cn_len, cn_start) = strip_read_uleb(wasm, payload_start, payload_end)\n        if cn_len >= 0 && cn_start + cn_len <= payload_end {\n          if strip_bytes_range_eq_str(wasm, cn_start, cn_len, \"name\") {\n            handled = true\n          } else {\n            ()\n          }\n        } else {\n          ()\n        }\n      } else {\n        ()\n      }\n      if !handled && sid == 7 && filter_exports {\n        let (exp_count, cur0) = strip_read_uleb(wasm, payload_start, payload_end)\n        if exp_count >= 0 {\n          let kept = Bytes::new()\n          let mut kept_count = 0\n          let mut cur = cur0\n          let mut ei = 0\n          let mut parse_ok = true\n          while parse_ok && ei < exp_count {\n            let entry_start = cur\n            let (nlen, nstart) = strip_read_uleb(wasm, cur, payload_end)\n            if nlen < 0 || nstart + nlen + 1 > payload_end {\n              parse_ok = false\n            } else {\n              let kind = Bytes::get(wasm, nstart + nlen)\n              let (_eidx, entry_end) = strip_read_uleb(wasm, nstart + nlen + 1, payload_end)\n              if entry_end > payload_end {\n                parse_ok = false\n              } else {\n                let keep = kind != 0 || strip_bytes_range_eq_str(wasm, nstart, nlen, entry_name) || strip_bytes_range_eq_str(wasm, nstart, nlen, \"_start\") || strip_bytes_range_eq_str(wasm, nstart, nlen, \"cli_main\") || strip_bytes_range_starts_with(wasm, nstart, nlen, \"__bench_\") || strip_bytes_range_starts_with(wasm, nstart, nlen, \"__test_\")\n                if keep {\n                  strip_push_range(kept, wasm, entry_start, entry_end)\n                  kept_count = kept_count + 1\n                } else {\n                  ()\n                }\n                cur = entry_end\n                ei = ei + 1\n              }\n            }\n          }\n          if parse_ok {\n            Bytes::push(out, 7)\n            let sec_content = Bytes::new()\n            strip_push_uleb(sec_content, kept_count)\n            Bytes::append(sec_content, kept)\n            strip_push_uleb(out, Bytes::length(sec_content))\n            Bytes::append(out, sec_content)\n            handled = true\n          } else {\n            ok = false\n          }\n        } else {\n          ok = false\n        }\n      } else {\n        ()\n      }\n      if ok && !handled {\n        strip_push_range(out, wasm, i, payload_end)\n      } else {\n        ()\n      }\n      i = payload_end\n    }\n  }\n  if ok {\n    out\n  } else {\n    wasm\n  }\n}\n\nexport fn strip_executable_wasm_env(wasm: Bytes, entry_name: String) -> Bytes with { Env } {\n  if entry_name == \"__no_entry__\" {\n    wasm\n  } else {\n    strip_executable_wasm(wasm, entry_name, Env::get(\"VIBE_WASM_NAMES\") != \"1\", Env::get(\"VIBE_WASM_KEEP_EXPORTS\") != \"1\")\n  }\n}\n\nexport fn write_linked_debug_build(input_path: String, output_path: String, entry_name: String) -> Unit with { Error, Fs } {\n  let (entry_bytes, linked_dep_specs) = build_linked_debug_entry(input_path, entry_name)\n  Fs::write_bytes(output_path, entry_bytes)\n  let output_dir = linked_output_dir(output_path)\n  let mut i = 0\n  while i < Array::length(linked_dep_specs) {\n    let (module_name, dep_path) = Array::get(linked_dep_specs, i)\n    let lib_output_path = String::concat(output_dir, String::concat(\"/\", String::concat(module_name, \".wasm\")))\n    let lib_bytes = compile_debug_library(dep_path)\n    Fs::write_bytes(lib_output_path, lib_bytes)\n    i = i + 1\n  }\n}\n")
}

let source_256 = () -> (String, String) {
  ("lib/@vibe/compiler/inspect_update.vibe",
"\n\nfn escape_inspect_char(c: Int) -> String {\n  if c == '\\n' {\n    \"\\\\n\"\n  } else if c == '\\t' {\n    \"\\\\t\"\n  } else if c == '\\r' {\n    \"\\\\r\"\n  } else if c == '\\\\' {\n    \"\\\\\\\\\"\n  } else if c == '\"' {\n    \"\\\\\\\"\"\n  } else {\n    String::from_char_code(c)\n  }\n}\n\nfn quote_inspect_literal(text: String) -> String {\n  let sb = StringBuilder::new()\n  StringBuilder::push(sb, \"\\\"\")\n  let n = String::length(text)\n  let mut i = 0\n  while i < n {\n    StringBuilder::push(sb, escape_inspect_char(String::char_code_at(text, i)))\n    i = i + 1\n  }\n  StringBuilder::push(sb, \"\\\"\")\n  StringBuilder::freeze(sb)\n}\n\n\nfn strip_one_trailing_newline(s: String) -> String {\n  let n = String::length(s)\n  if n > 0 && s[n - 1: n] == \"\\n\" {\n    s[0: n - 1]\n  } else {\n    s\n  }\n}\n\nfn parse_inspect_mismatch(captured_in: String) -> Option[(String, String)] {\n  let captured = strip_one_trailing_newline(captured_in)\n  let marker = \"inspect mismatch:\\n  actual:   \"\n  let start = String::index_of(captured, marker)\n  if start < 0 {\n    None\n  } else {\n    let after_marker = start + String::length(marker)\n    let sep = \"\\n  expected: \"\n    let tail = captured[after_marker: String::length(captured)]\n    let sep_idx = String::index_of(tail, sep)\n    if sep_idx < 0 {\n      None\n    } else {\n      let actual_end = after_marker + sep_idx\n      let actual = captured[after_marker: actual_end]\n      let expected_start = actual_end + String::length(sep)\n      let expected = captured[expected_start: String::length(captured)]\n      Some((actual, expected))\n    }\n  }\n}\n\n\nfn is_ident_char(c: Int) -> Bool {\n  (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_'\n}\n\nfn find_matching_close_paren(src: String, open_idx: Int) -> Int {\n  let n = String::length(src)\n  let mut i = open_idx\n  let mut depth = 0\n  let mut result = -1\n  while result < 0 && i < n {\n    let c = String::char_code_at(src, i)\n    if c == '\"' {\n      i = i + 1\n      let mut in_str = true\n      while in_str && i < n {\n        let sc = String::char_code_at(src, i)\n        if sc == '\\\\' {\n          i = i + 2\n        } else if sc == '\"' {\n          i = i + 1\n          in_str = false\n        } else {\n          i = i + 1\n        }\n      }\n    } else if c == '(' {\n      depth = depth + 1\n      i = i + 1\n    } else if c == ')' {\n      depth = depth - 1\n      if depth == 0 {\n        result = i + 1\n      } else {\n        i = i + 1\n      }\n    } else {\n      i = i + 1\n    }\n  }\n  result\n}\n\nfn is_whitespace_then_close_paren(s: String) -> Bool {\n  let n = String::length(s)\n  if n == 0 {\n    false\n  } else if s[n - 1: n] != \")\" {\n    false\n  } else {\n    let mut i = 0\n    let mut ok = true\n    while ok && i < n - 1 {\n      let c = String::char_code_at(s, i)\n      if c == ' ' || c == '\\t' || c == '\\n' || c == '\\r' {\n        i = i + 1\n      } else {\n        ok = false\n      }\n    }\n    ok\n  }\n}\n\nfn find_content_arg_span(src: String, old_lit: String) -> Option[(Int, Int)] {\n  let n = String::length(src)\n  let needle = \"inspect(\"\n  let needle_len = String::length(needle)\n  let old_len = String::length(old_lit)\n  let mut from = 0\n  let mut result: Option[(Int, Int)] = None\n  let mut done = false\n  while !done {\n    if from > n - needle_len {\n      done = true\n    } else {\n      let rel = String::index_of(src[from: n], needle)\n      if rel < 0 {\n        done = true\n      } else {\n        let m_start = from + rel\n        let boundary_ok = m_start == 0 || !is_ident_char(String::char_code_at(src, m_start - 1))\n        if !boundary_ok {\n          from = m_start + 1\n        } else {\n          let open_idx = m_start + needle_len - 1\n          let call_end = find_matching_close_paren(src, open_idx)\n          if call_end < 0 {\n            from = m_start + 1\n          } else {\n            let call_text = src[open_idx: call_end]\n            let pos = String::last_index_of(call_text, old_lit)\n            if pos >= 0 && is_whitespace_then_close_paren(call_text[pos + old_len: String::length(call_text)]) {\n              let abs_start = open_idx + pos\n              result = Some((abs_start, abs_start + old_len))\n              done = true\n            } else {\n              from = m_start + 1\n            }\n          }\n        }\n      }\n    }\n  }\n  result\n}\n\n\nexport fn compute_updated_source(src: String, captured: String) -> Option[String] {\n  match parse_inspect_mismatch(captured) {\n    None => None,\n    Some((actual, expected)) => {\n      let old_lit = quote_inspect_literal(expected)\n      match find_content_arg_span(src, old_lit) {\n        None => None,\n        Some((start, end)) => {\n          let new_lit = quote_inspect_literal(actual)\n          Some(String::concat(src[0: start], String::concat(new_lit, src[end: String::length(src)])))\n        }\n      }\n    }\n  }\n}\n")
}

let source_257 = () -> (String, String) {
  ("lib/@vibe/compiler/cli_adapter.vibe",
"\nimport @vibe/compiler/entry/source_compile/wasi_only {\n  comp_emit_component_wasm_string_handler,\n  compile_source_wasi_only,\n  compile_source_wasi_only_coverage,\n  compile_source_wasi_only_rc,\n  compile_source_wasi_only_rc_shadow,\n  merged_program_source_fs\n}\n\nimport @vibe/compiler/entry/source_compile/gc_only {\n  compile_source_gc_only\n}\n\nimport @vibe/compiler/runtime {\n  binding_occurrences,\n  build_funcmap_from_source,\n  build_module_source_from_source,\n  collect_all_diagnostics,\n  doc_at_source,\n  incremental_invalidation_trace_json,\n  incremental_typecheck_telemetry_json,\n  module_plan_manifest_fs,\n  run_module_job_dir,\n  run_publish_env_cache_dir,\n  set_collect_module_diagnostics,\n  set_dep_order_seed,\n  set_experimental_typing_dependency_env_reuse_enabled,\n  set_incremental_interface_trace_enabled,\n  set_incremental_typecheck_telemetry_enabled,\n  set_scheduler_trace_path,\n  symbol_spans,\n  type_at_source\n}\n\nimport @vibe/compiler/cache {\n  ingestion_fingerprint_telemetry_json, set_ingestion_fingerprint_telemetry_enabled\n}\n\nimport @vibe/compiler/loader {\n  contract_package_hashes_fs,\n  fill_require_pins_fs_mode,\n  find_deps_missing,\n  find_missing_vpkg_dirs,\n  ingest_source_text_fs,\n  load_or_parse_module_header_fs,\n  publish_check_fs,\n  write_generated_hash_fs\n}\n\nimport @vibe/compiler/entry/compiler/file_compile {\n  compile_file_fs_mode,\n  compile_file_fs_mode_break,\n  compile_file_fs_mode_cached_artifact_input_trace,\n  compile_file_fs_mode_coverage,\n  compile_file_fs_mode_rc,\n  compile_file_fs_mode_rc_shadow,\n  compile_file_fs_mode_testmeta,\n  compile_file_fs_mode_trace,\n  entry_cacheable_for_fs\n}\n\nimport @vibe/compiler/normalize {\n  normalize_source\n}\n\n\n\nimport @vibe/compiler/syntax {\n  lex, parse_program\n}\n\n\nimport @vibe/lsp {\n  lsp_diagnostics_json_string, lsp_main\n}\n\nimport @vibe/compiler/checker {\n  set_error_row_checked\n}\n\n\nfn adapter_basename_no_vibe(path: String) -> String {\n  let len = String::length(path)\n  let mut last_slash = 0 - 1\n  let mut i = 0\n  while i < len {\n    if String::char_code_at(path, i) == 47 {\n      last_slash = i\n    }\n    i = i + 1\n  }\n  let base = path[last_slash + 1: len]\n  let blen = String::length(base)\n  if blen >= 5 && base[blen - 5: blen] == \".vibe\" {\n    base[0: blen - 5]\n  } else {\n    base\n  }\n}\n\nfn join_lines(items: Array[String]) -> String {\n  let n = Array::length(items)\n  if n == 0 {\n    \"\"\n  } else {\n    let acc = StringBuilder::new()\n    StringBuilder::push(acc, Array::get(items, 0))\n    let mut i = 1\n    while i < n {\n      StringBuilder::push(acc, \"\\n\")\n      StringBuilder::push(acc, Array::get(items, i))\n      i = i + 1\n    }\n    StringBuilder::freeze(acc)\n  }\n}\n\nfn join_symbol_spans(syms: Array[(String, Int, Int, Int)]) -> String {\n  let n = Array::length(syms)\n  let acc = StringBuilder::new()\n  let mut first = true\n  let mut i = 0\n  while i < n {\n    let (name, kind, s, e) = Array::get(syms, i)\n    if String::length(name) == 0 {\n      ()\n    } else {\n      let line = String::concat(name, String::concat(\" \", String::concat(__to_string(kind), String::concat(\" \", String::concat(__to_string(s), String::concat(\" \", __to_string(e)))))))\n      if first {\n        StringBuilder::push(acc, line)\n        first = false\n      } else {\n        StringBuilder::push(acc, \"\\n\")\n        StringBuilder::push(acc, line)\n      }\n    }\n    i = i + 1\n  }\n  StringBuilder::freeze(acc)\n}\n\nfn join_binding_occurrences(occ: Array[(Int, Int)]) -> String {\n  let n = Array::length(occ)\n  if n == 0 {\n    \"\"\n  } else {\n    let (s0, e0) = Array::get(occ, 0)\n    let acc = StringBuilder::new()\n    StringBuilder::push(acc, String::concat(__to_string(s0), String::concat(\" \", __to_string(e0))))\n    let mut i = 1\n    while i < n {\n      let (s, e) = Array::get(occ, i)\n      let line = String::concat(__to_string(s), String::concat(\" \", __to_string(e)))\n      StringBuilder::push(acc, \"\\n\")\n      StringBuilder::push(acc, line)\n      i = i + 1\n    }\n    StringBuilder::freeze(acc)\n  }\n}\n\nfn parse_int_or(s: String, default: Int) -> Int {\n  let len = String::length(s)\n  if len == 0 {\n    default\n  } else {\n    let mut i = 0\n    let mut acc = 0\n    let mut ok = true\n    while ok && i < len {\n      let c = String::char_code_at(s, i)\n      if c >= '0' && c <= '9' {\n        acc = acc * 10 + (c - '0')\n        i = i + 1\n      } else {\n        ok = false\n      }\n    }\n    if ok {\n      acc\n    } else {\n      default\n    }\n  }\n}\n\nfn adapter_string_to_bytes(s: String) -> Bytes {\n  let out = Array::slice([\n    0\n  ], 0, 0)\n  let len = String::length(s)\n  let mut i = 0\n  while i < len {\n    Array::push(out, String::char_code_at(s, i))\n    i = i + 1\n  }\n  Bytes::from_array(out)\n}\n\nfn read_arg_or_env(index: Int, env_name: String) -> String with { Env } {\n  let value = Env::args_get(index)\n  if value != \"\" {\n    value\n  } else {\n    Env::get(env_name)\n  }\n}\n\nfn own_host_string(value: String) -> String {\n  String::concat(\"\", value)\n}\n\nfn has_control_character(value: String) -> Bool {\n  let mut i = 0\n  let mut found = false\n  while i < String::length(value) {\n    let c = String::char_code_at(value, i)\n    if (c >= 0 && c <= 31) || (c >= 127 && c <= 159) {\n      found = true\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  found\n}\n\nfn profile_memory_mark(enabled: Bool) -> Unit with { Env } {\n  if enabled {\n    let _ = Env::get(\"VIBE_PROFILE_MEMORY_MARK\")\n    ()\n  } else {\n    ()\n  }\n}\n\nfn apply_cfg_env(source: String, cfg_csv: String) -> String {\n  if cfg_csv == \"\" {\n    source\n  } else {\n    let parts = String::split(cfg_csv, \",\")\n    let mut out = source\n    let mut i = 0\n    while i < Array::length(parts) {\n      let flag = String::trim(Array::get(parts, i))\n      if String::length(flag) > 0 {\n        out = String::concat(out, String::concat(\"\\n#cfg_enable(\", String::concat(flag, \")\")))\n      } else {\n        ()\n      }\n      i = i + 1\n    }\n    out\n  }\n}\n\nfn compile_source_for_rc_flag(source: String, entry_name: String, rc_flag: String) -> Bytes with { Error } {\n  if rc_flag == \"shadow\" {\n    compile_source_wasi_only_rc_shadow(source, entry_name)\n  } else if rc_flag != \"0\" {\n    compile_source_wasi_only_rc(source, entry_name)\n  } else {\n    compile_source_wasi_only(source, entry_name)\n  }\n}\n\nfn emit_compile_diag(output_path: String, msg: String) -> Int with { Fs } {\n  Fs::write_file(String::concat(output_path, \".diag\"), msg)\n  1\n}\n\nfn write_funcmap_sidecar(input_path: String, output_path: String) -> Int with { Fs, Error } {\n  let src = Fs::read_file(input_path)\n  let text = build_funcmap_from_source(src)\n  Fs::write_bytes(String::concat(output_path, \".funcmap\"), adapter_string_to_bytes(text))\n  0\n}\n\nfn adapter_emit_wit(input_path: String, output_path: String) -> Int with { Fs, Env } {\n  handle {\n    let entry_stmts = parse_program(lex(Fs::read_file(input_path)))\n    let wit = wit_from_program(entry_stmts, entry_stmts, adapter_basename_no_vibe(input_path))\n    Fs::write_bytes(output_path, adapter_string_to_bytes(wit))\n    0\n  } with Error {\n    Throw(msg) => emit_compile_diag(output_path, msg)\n  }\n}\n\nfn adapter_serve_component(input_path: String, output_path: String) -> Int with { Fs, Env } {\n  handle {\n    let entry_stmts = parse_program(lex(Fs::read_file(input_path)))\n    validate_serve_handler(entry_stmts)\n    let core = compile_file_fs_mode(input_path, \"__no_entry__\", \"no-dce\")\n    let component = comp_emit_component_wasm_string_handler(core, \"handler\", \"handler\", serve_handler_param_names())\n    Fs::write_bytes(output_path, component)\n    let wit_out = Env::get(\"VIBE_SERVE_WIT_OUT\")\n    if wit_out != \"\" {\n      Fs::write_bytes(wit_out, adapter_string_to_bytes(wit_from_program(entry_stmts, entry_stmts, adapter_basename_no_vibe(input_path))))\n    } else {\n      ()\n    }\n    0\n  } with Error {\n    Throw(msg) => emit_compile_diag(output_path, msg)\n  }\n}\n\nexport fn cli_main() -> Int with { Error, Fs, Env, Stdin, Stdout } {\n  if Env::get(\"VIBE_CHECK_ERROR_ROW\") == \"0\" {\n    ()\n  } else {\n    set_error_row_checked(true)\n  }\n  let dep_seed_text = Env::get(\"VIBE_DEP_ORDER_SEED\")\n  if dep_seed_text == \"\" {\n    ()\n  } else {\n    match Int::parse(dep_seed_text) {\n      Some(dep_seed) => set_dep_order_seed(dep_seed),\n      None => ()\n    }\n  }\n  if Env::get(\"VIBE_DIAGNOSTICS_ALL\") == \"1\" {\n    set_collect_module_diagnostics(true)\n  } else {\n    ()\n  }\n  let scheduler_trace = Env::get(\"VIBE_SCHEDULER_TRACE\")\n  if scheduler_trace == \"\" {\n    ()\n  } else {\n    set_scheduler_trace_path(scheduler_trace)\n  }\n  let artifact_input_trace_out = Env::get(\"VIBE_ARTIFACT_INPUT_TRACE_OUT\")\n  if artifact_input_trace_out != \"\" {\n    if Fs::exists(artifact_input_trace_out) {\n      Fs::remove(artifact_input_trace_out)\n    } else {\n      ()\n    }\n    if Env::get(\"VIBE_ARTIFACT_INPUT_TRACE_NONCE\") == \"\" {\n      throw(\"VIBE_ARTIFACT_INPUT_TRACE_OUT requires VIBE_ARTIFACT_INPUT_TRACE_NONCE\")\n    } else if Env::get(\"VIBE_FS_COMPILE\") != \"1\" || Env::get(\"VIBE_RC\") != \"0\" || Env::get(\"VIBE_LSP\") == \"1\" || Env::get(\"VIBE_CHECK_ONLY\") == \"1\" || Env::get(\"VIBE_COVERAGE\") == \"1\" || Env::get(\"VIBE_DEBUG_BREAK\") == \"1\" || Env::get(\"VIBE_DEBUG\") == \"1\" || Env::get(\"VIBE_TESTMETA_OUT\") != \"\" || Env::get(\"VIBE_HASH\") == \"1\" || Env::get(\"VIBE_HASH_WRITE\") == \"1\" || Env::get(\"VIBE_MISSING_VPKG_SCAN\") == \"1\" || Env::get(\"VIBE_DEPS_MISSING_SCAN\") == \"1\" || Env::get(\"VIBE_FILL_PINS\") == \"1\" || Env::get(\"VIBE_PUBLISH_CHECK\") == \"1\" || Env::get(\"VIBE_MODULE_JOB_DIR\") == \"1\" || Env::get(\"VIBE_PUBLISH_ENV_CACHE\") == \"1\" || Env::get(\"VIBE_LIST_DEPS\") == \"1\" || Env::get(\"VIBE_MODULE_PLAN\") == \"1\" {\n      throw(\"artifact-input trace requires the exact uninstrumented VIBE_FS_COMPILE=1, VIBE_RC=0 file_compile cached bump lane\")\n    } else {\n      ()\n    }\n  } else {\n    ()\n  }\n  let ingestion_telemetry_out = Env::get(\"VIBE_INGESTION_TELEMETRY_OUT\")\n  let ingestion_telemetry_nonce = Env::get(\"VIBE_INGESTION_TELEMETRY_NONCE\")\n  if ingestion_telemetry_out != \"\" {\n    if Fs::exists(ingestion_telemetry_out) {\n      Fs::remove(ingestion_telemetry_out)\n    } else {\n      ()\n    }\n    if Env::get(\"VIBE_CHECK_ONLY\") != \"1\" {\n      throw(\"VIBE_INGESTION_TELEMETRY_OUT requires VIBE_CHECK_ONLY=1\")\n    } else if ingestion_telemetry_nonce == \"\" || has_control_character(ingestion_telemetry_nonce) {\n      throw(\"VIBE_INGESTION_TELEMETRY_OUT requires a non-empty control-free VIBE_INGESTION_TELEMETRY_NONCE\")\n    } else {\n      ()\n    }\n  } else {\n    ()\n  }\n  if Env::get(\"VIBE_LSP\") == \"1\" {\n    return lsp_main()\n  }\n  let input_path = own_host_string(read_arg_or_env(0, \"VIBE_INPUT\"))\n  let output_path = own_host_string(read_arg_or_env(1, \"VIBE_OUTPUT\"))\n  let entry_name = own_host_string(read_arg_or_env(2, \"VIBE_ENTRY\"))\n  let mark_memory = Env::get(\"VIBE_PROFILE_MEMORY_MARKS\") == \"1\"\n  if Env::get(\"VIBE_HASH\") == \"1\" {\n    return handle {\n      let (pkg_hash, ct_hash) = contract_package_hashes_fs(input_path)\n      Fs::write_file(output_path, \"package #\\{pkg_hash}\\ncontract \\{ct_hash}\\n\")\n      0\n    } with Error {\n      Throw(msg) => emit_compile_diag(output_path, msg)\n    }\n  } else ()\n  if Env::get(\"VIBE_HASH_WRITE\") == \"1\" {\n    return handle {\n      let rewritten = write_generated_hash_fs(input_path)\n      Fs::write_file(output_path, rewritten)\n      0\n    } with Error {\n      Throw(msg) => emit_compile_diag(output_path, msg)\n    }\n  } else ()\n  if Env::get(\"VIBE_MISSING_VPKG_SCAN\") == \"1\" {\n    return handle {\n      let missing = find_missing_vpkg_dirs(input_path)\n      if Array::length(missing) == 0 {\n        Fs::write_file(output_path, \"ok: no directories missing index.vpkg under \\{input_path}\\n\")\n      } else {\n        Fs::write_file(output_path, String::concat(String::join(missing, \"\\n\"), \"\\n\"))\n      }\n      0\n    } with Error {\n      Throw(msg) => emit_compile_diag(output_path, msg)\n    }\n  } else ()\n  if Env::get(\"VIBE_DEPS_MISSING_SCAN\") == \"1\" {\n    return handle {\n      let missing = find_deps_missing(input_path)\n      if Array::length(missing) == 0 {\n        Fs::write_file(output_path, \"ok: no missing deps declarations under \\{input_path}\\n\")\n      } else {\n        Fs::write_file(output_path, String::concat(String::join(missing, \"\\n\"), \"\\n\"))\n      }\n      0\n    } with Error {\n      Throw(msg) => emit_compile_diag(output_path, msg)\n    }\n  } else ()\n  if Env::get(\"VIBE_FILL_PINS\") == \"1\" {\n    return handle {\n      let filled = fill_require_pins_fs_mode(Fs::read_file(input_path), Env::get(\"VIBE_REPIN\") == \"1\")\n      Fs::write_file(output_path, filled)\n      0\n    } with Error {\n      Throw(msg) => emit_compile_diag(output_path, msg)\n    }\n  } else ()\n  if Env::get(\"VIBE_PUBLISH_CHECK\") == \"1\" {\n    return handle {\n      let perrors = publish_check_fs(Env::get(\"VIBE_PUBLISH_PREV\"), input_path, Env::get(\"VIBE_PUBLISH_PREV_VERSION\"), Env::get(\"VIBE_PUBLISH_VERSION\"))\n      if Array::length(perrors) > 0 {\n        throw(String::join(perrors, \"; \"))\n      } else ()\n      Fs::write_file(output_path, \"ok\\n\")\n      0\n    } with Error {\n      Throw(msg) => emit_compile_diag(output_path, msg)\n    }\n  } else ()\n  if Env::get(\"VIBE_MODULE_JOB_DIR\") == \"1\" {\n    return handle {\n      run_module_job_dir(input_path)\n      0\n    } with Error {\n      Throw(msg) => emit_compile_diag(output_path, msg)\n    }\n  } else ()\n  if Env::get(\"VIBE_PUBLISH_ENV_CACHE\") == \"1\" {\n    return handle {\n      run_publish_env_cache_dir(input_path)\n      Fs::write_file(output_path, \"ok\\n\")\n      0\n    } with Error {\n      Throw(msg) => emit_compile_diag(output_path, msg)\n    }\n  } else ()\n  if Env::get(\"VIBE_LIST_DEPS\") == \"1\" {\n    return handle {\n      let source = Fs::read_file(input_path)\n      let ingested = ingest_source_text_fs(input_path, source)\n      let (deps, _exports, _parse_count) = load_or_parse_module_header_fs(input_path, ingested, 0)\n      Fs::write_file(output_path, String::concat(String::join(deps, \"\\n\"), \"\\n\"))\n      Fs::write_file(String::concat(output_path, \".src\"), ingested)\n      0\n    } with Error {\n      Throw(msg) => emit_compile_diag(output_path, msg)\n    }\n  } else ()\n  if Env::get(\"VIBE_MODULE_PLAN\") == \"1\" {\n    return handle {\n      let (manifest, sources) = module_plan_manifest_fs(input_path)\n      let mut i = 0\n      while i < Array::length(sources) {\n        Fs::write_file(String::concat(output_path, String::concat(\".\", String::concat(__to_string(i), \".src\"))), Array::get(sources, i))\n        i = i + 1\n      }\n      Fs::write_file(output_path, manifest)\n      0\n    } with Error {\n      Throw(msg) => emit_compile_diag(output_path, msg)\n    }\n  } else ()\n  if Env::get(\"VIBE_CHECK_ONLY\") == \"1\" {\n    return handle {\n      let telemetry_out = Env::get(\"VIBE_INCREMENTAL_TELEMETRY_OUT\")\n      let invalidation_trace_out = Env::get(\"VIBE_INCREMENTAL_INVALIDATION_TRACE_OUT\")\n      let invalidation_trace_nonce = Env::get(\"VIBE_INCREMENTAL_INVALIDATION_TRACE_NONCE\")\n      let experimental_typing_dependency_env_reuse = Env::get(\"VIBE_EXPERIMENTAL_TYPING_DEPENDENCY_ENV_REUSE\")\n      if experimental_typing_dependency_env_reuse != \"\" && experimental_typing_dependency_env_reuse != \"1\" {\n        throw(\"VIBE_EXPERIMENTAL_TYPING_DEPENDENCY_ENV_REUSE must be exactly 1 when enabled\")\n      } else {\n        ()\n      }\n      if experimental_typing_dependency_env_reuse == \"1\" && invalidation_trace_out != \"\" {\n        throw(\"VIBE_EXPERIMENTAL_TYPING_DEPENDENCY_ENV_REUSE does not support VIBE_INCREMENTAL_INVALIDATION_TRACE_OUT\")\n      } else {\n        ()\n      }\n      if telemetry_out != \"\" {\n        if Fs::exists(telemetry_out) {\n          Fs::remove(telemetry_out)\n        } else {\n          ()\n        }\n      } else {\n        ()\n      }\n      if invalidation_trace_out != \"\" {\n        if Fs::exists(invalidation_trace_out) {\n          Fs::remove(invalidation_trace_out)\n        } else {\n          ()\n        }\n        if invalidation_trace_nonce == \"\" {\n          throw(\"VIBE_INCREMENTAL_INVALIDATION_TRACE_OUT requires VIBE_INCREMENTAL_INVALIDATION_TRACE_NONCE\")\n        } else {\n          ()\n        }\n      } else {\n        ()\n      }\n      if telemetry_out != \"\" || invalidation_trace_out != \"\" {\n        set_incremental_typecheck_telemetry_enabled(true)\n      } else {\n        ()\n      }\n      set_ingestion_fingerprint_telemetry_enabled(ingestion_telemetry_out != \"\")\n      set_incremental_interface_trace_enabled(invalidation_trace_out != \"\")\n      set_experimental_typing_dependency_env_reuse_enabled(experimental_typing_dependency_env_reuse == \"1\")\n      let _ = check_linked_file(input_path)\n      if telemetry_out != \"\" {\n        Fs::write_file(telemetry_out, incremental_typecheck_telemetry_json())\n      } else {\n        ()\n      }\n      if invalidation_trace_out != \"\" {\n        Fs::write_file(invalidation_trace_out, incremental_invalidation_trace_json(input_path, invalidation_trace_nonce))\n      } else {\n        ()\n      }\n      if ingestion_telemetry_out != \"\" {\n        Fs::write_file(ingestion_telemetry_out, ingestion_fingerprint_telemetry_json(ingestion_telemetry_nonce))\n      } else {\n        ()\n      }\n      Fs::write_file(output_path, \"ok\\n\")\n      0\n    } with Error {\n      Throw(msg) => emit_compile_diag(output_path, msg)\n    }\n  } else ()\n  if Env::get(\"VIBE_FS_COMPILE\") == \"1\" {\n    return handle {\n      let artifact_input_trace_nonce = Env::get(\"VIBE_ARTIFACT_INPUT_TRACE_NONCE\")\n      let (bytes, artifact_input_trace) = if Env::get(\"VIBE_COVERAGE\") == \"1\" {\n        (compile_file_fs_mode_coverage(input_path, entry_name), \"\")\n      } else if Env::get(\"VIBE_DEBUG_BREAK\") == \"1\" {\n        (compile_file_fs_mode_break(input_path, entry_name), \"\")\n      } else if Env::get(\"VIBE_DEBUG\") == \"1\" {\n        (compile_file_fs_mode_trace(input_path, entry_name), \"\")\n      } else if Env::get(\"VIBE_RC\") == \"shadow\" {\n        (compile_file_fs_mode_rc_shadow(input_path, entry_name), \"\")\n      } else if Env::get(\"VIBE_RC\") != \"0\" {\n        (compile_file_fs_mode_rc(input_path, entry_name), \"\")\n      } else {\n        let testmeta_out = Env::get(\"VIBE_TESTMETA_OUT\")\n        if artifact_input_trace_out != \"\" {\n          compile_file_fs_mode_cached_artifact_input_trace(input_path, entry_name, \"no-dce\", artifact_input_trace_nonce)\n        } else if testmeta_out != \"\" {\n          (compile_file_fs_mode_testmeta(input_path, entry_name, \"no-dce\", testmeta_out), \"\")\n        } else {\n          (compile_file_fs_mode(input_path, entry_name, \"no-dce\"), \"\")\n        }\n      }\n      let fs_instrumented = Env::get(\"VIBE_COVERAGE\") == \"1\" || Env::get(\"VIBE_DEBUG_BREAK\") == \"1\" || Env::get(\"VIBE_DEBUG\") == \"1\" || Env::get(\"VIBE_RC\") == \"shadow\"\n      let out_bytes = if fs_instrumented {\n        bytes\n      } else {\n        strip_executable_wasm_env(bytes, entry_name)\n      }\n      Fs::write_bytes(output_path, out_bytes)\n      let _funcmap_rc = handle {\n        write_funcmap_sidecar(input_path, output_path)\n      } with Error {\n        Throw(_) => 0\n      }\n      let entry_testmeta_out = Env::get(\"VIBE_ENTRY_TESTMETA_OUT\")\n      let _entry_meta_rc = if entry_testmeta_out != \"\" {\n        handle {\n          let cacheable = entry_cacheable_for_fs(input_path, entry_name)\n          Fs::write_file(entry_testmeta_out, if cacheable {\n            \"1\"\n          } else {\n            \"0\"\n          })\n          0\n        } with Error {\n          Throw(_) => 0\n        }\n      } else {\n        0\n      }\n      if artifact_input_trace_out != \"\" {\n        Fs::write_file(artifact_input_trace_out, artifact_input_trace)\n      } else {\n        ()\n      }\n      0\n    } with Error {\n      Throw(msg) => emit_compile_diag(output_path, msg)\n    }\n  }\n  if Env::get(\"VIBE_NORMALIZE\") == \"1\" {\n    let normalized = normalize_source(Fs::read_file(input_path))\n    Fs::write_bytes(output_path, adapter_string_to_bytes(normalized))\n    return 0\n  }\n  if Env::get(\"VIBE_INSPECT_UPDATE\") == \"1\" {\n    let src = Fs::read_file(input_path)\n    let captured = Fs::read_file(Env::get(\"VIBE_INSPECT_UPDATE_STDOUT\"))\n    let patched = match compute_updated_source(src, captured) {\n      Some(new_src) => new_src,\n      None => src\n    }\n    Fs::write_bytes(output_path, adapter_string_to_bytes(patched))\n    return 0\n  }\n  if Env::get(\"VIBE_TYPE_AT\") == \"1\" {\n    let src = Fs::read_file(input_path)\n    let line = parse_int_or(Env::get(\"VIBE_TYPE_LINE\"), 1)\n    let col = parse_int_or(Env::get(\"VIBE_TYPE_COL\"), 1)\n    let ty = type_at_source(src, line, col)\n    Fs::write_bytes(output_path, adapter_string_to_bytes(ty))\n    return 0\n  }\n  if Env::get(\"VIBE_DOC_AT\") == \"1\" {\n    let src = Fs::read_file(input_path)\n    let line = parse_int_or(Env::get(\"VIBE_TYPE_LINE\"), 1)\n    let col = parse_int_or(Env::get(\"VIBE_TYPE_COL\"), 1)\n    let doc = doc_at_source(src, line, col)\n    Fs::write_bytes(output_path, adapter_string_to_bytes(doc))\n    return 0\n  }\n  if Env::get(\"VIBE_BINDING_AT\") == \"1\" {\n    let src = Fs::read_file(input_path)\n    let line = parse_int_or(Env::get(\"VIBE_TYPE_LINE\"), 1)\n    let col = parse_int_or(Env::get(\"VIBE_TYPE_COL\"), 1)\n    let occ = binding_occurrences(src, line, col)\n    Fs::write_bytes(output_path, adapter_string_to_bytes(join_binding_occurrences(occ)))\n    return 0\n  }\n  if Env::get(\"VIBE_SYMBOLS\") == \"1\" {\n    return handle {\n      let src = Fs::read_file(input_path)\n      let syms = symbol_spans(src)\n      Fs::write_bytes(output_path, adapter_string_to_bytes(join_symbol_spans(syms)))\n      0\n    } with Error {\n      Throw(msg) => emit_compile_diag(output_path, msg)\n    }\n  }\n  if Env::get(\"VIBE_DIAGNOSTICS\") == \"1\" {\n    let src = Fs::read_file(input_path)\n    if Env::get(\"VIBE_DIAGNOSTICS_JSON\") == \"1\" {\n      Fs::write_bytes(output_path, adapter_string_to_bytes(lsp_diagnostics_json_string(src)))\n    } else {\n      let diags = collect_all_diagnostics(src)\n      Fs::write_bytes(output_path, adapter_string_to_bytes(join_lines(diags)))\n    }\n    return 0\n  }\n  if Env::get(\"VIBE_EMIT_MERGED_SOURCE\") == \"1\" {\n    return handle {\n      let merged_src = merged_program_source_fs(input_path)\n      Fs::write_file(output_path, merged_src)\n      0\n    } with Error {\n      Throw(msg) => emit_compile_diag(output_path, msg)\n    }\n  }\n  if Env::get(\"VIBE_EMIT_WIT\") == \"1\" {\n    return adapter_emit_wit(input_path, output_path)\n  }\n  if Env::get(\"VIBE_SERVE_COMPONENT\") == \"1\" {\n    return adapter_serve_component(input_path, output_path)\n  }\n  let source = Fs::read_file(input_path)\n  profile_memory_mark(mark_memory)\n  if Env::get(\"VIBE_EMIT_MODULE_SOURCE\") == \"1\" {\n    let module_source = build_module_source_from_source(source, entry_name)\n    Fs::write_bytes(output_path, adapter_string_to_bytes(module_source))\n    profile_memory_mark(mark_memory)\n    0\n  } else {\n    handle {\n      let rc_flag = Env::get(\"VIBE_RC\")\n      let source_cfg = apply_cfg_env(source, Env::get(\"VIBE_CFG\"))\n      let bytes = if Env::get(\"VIBE_COVERAGE\") == \"1\" {\n        compile_source_wasi_only_coverage(source_cfg, entry_name)\n      } else if Env::get(\"VIBE_BACKEND\") == \"gc\" {\n        compile_source_gc_only(source_cfg, entry_name)\n      } else {\n        compile_source_for_rc_flag(source_cfg, entry_name, rc_flag)\n      }\n      profile_memory_mark(mark_memory)\n      let ss_instrumented = Env::get(\"VIBE_COVERAGE\") == \"1\" || Env::get(\"VIBE_BACKEND\") == \"gc\" || rc_flag == \"shadow\"\n      let ss_out_bytes = if ss_instrumented {\n        bytes\n      } else {\n        strip_executable_wasm_env(bytes, entry_name)\n      }\n      Fs::write_bytes(output_path, ss_out_bytes)\n      profile_memory_mark(mark_memory)\n      0\n    } with Error {\n      Throw(msg) => emit_compile_diag(output_path, msg)\n    }\n  }\n}\n\nexport fn main() -> Unit with { Error, Fs, Env, Stdin, Stdout, Process } {\n  let code = cli_main()\n  if code != 0 {\n    vibe_process_exit_raw(code)\n  } else {\n    ()\n  }\n}\n")
}

