             _ => check_assignable(result_ty, r2, si, errors, \"match arms have incompatible types\", 0 - 1)\n                }\n              }\n            } else if railway_arms {\n              if arm_body_diverges(body) {\n                ()\n              } else {\n                let rr0 = subst_apply(si, result_ty)\n                let rr2 = subst_apply(si, arm_ty)\n                if railway_heads_conflict(rr0, rr2) {\n                  Array::push(errors, String::concat(\"match arms have incompatible types\", String::concat(\": expected \", String::concat(type_to_string(rr0), String::concat(\", got \", String::concat(type_to_string(rr2), off_marker(railway_expr_off(scrutinee))))))))\n                } else {\n                  ()\n                }\n              }\n            } else {\n              ()\n            }\n          }\n          ai = ai + 1\n        }\n        let enum_name_opt = match subst_apply(si, scr_ty) {\n          CtEnum(en) => Some(en),\n          CtNamed(en, _) => Some(en),\n          _ => None\n        }\n        match enum_name_opt {\n          Some(en) => match find_typedef(defs, en) {\n            Some(TDEnum(_, _, variants)) => {\n              let mut has_catchall = false\n              let covered = array_empty()\n              let mut ax = 0\n              while ax < Array::length(arms) {\n                let (apat, _) = Array::get(arms, ax)\n                if pat_is_catchall(apat) {\n                  has_catchall = true\n                } else {\n                  ()\n                }\n                collect_ctor_names_into(apat, covered)\n                ax = ax + 1\n              }\n              if has_catchall {\n                ()\n              } else {\n                let mut vi = 0\n                while vi < Array::length(variants) {\n                  let (vname, _) = Array::get(variants, vi)\n                  let mut found = false\n                  let mut ci2 = 0\n                  while ci2 < Array::length(covered) {\n                    if Array::get(covered, ci2) == vname {\n                      found = true\n                    } else {\n                      ()\n                    }\n                    ci2 = ci2 + 1\n                  }\n                  if found {\n                    ()\n                  } else {\n                    Array::push(errors, String::concat(\"non-exhaustive match: variant `\", String::concat(vname, String::concat(\"` of enum \", String::concat(en, \" is not handled (add it or a `_` arm)\")))))\n                  }\n                  vi = vi + 1\n                }\n              }\n            },\n            _ => ()\n          },\n          None => ()\n        }\n        let flat_guard_residual = match scrutinee {\n          EIdent(sn, _) => sn == \"__mg\",\n          _ => false\n        }\n        if alen >= 2 || flat_guard_residual {\n          match subst_apply(si, scr_ty) {\n            CtOption(_) => {\n              let mut opt_catchall = false\n              let opt_covered = array_empty()\n              let mut oax = 0\n              while oax < Array::length(arms) {\n                let (oapat, _) = Array::get(arms, oax)\n                if pat_is_catchall(oapat) {\n                  opt_catchall = true\n                } else {\n                  ()\n                }\n                collect_ctor_names_into(oapat, opt_covered)\n                oax = oax + 1\n              }\n              if opt_catchall {\n                ()\n              } else {\n                if !flat_names_contain(opt_covered, \"Some\") {\n                  Array::push(errors, \"non-exhaustive match: variant `Some` of Option is not handled (add it or a `_` arm)\")\n                } else {\n                  ()\n                }\n                if !flat_names_contain(opt_covered, \"None\") {\n                  Array::push(errors, \"non-exhaustive match: variant `None` of Option is not handled (add it or a `_` arm)\")\n                } els