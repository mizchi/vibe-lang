 CtString), CtBool, None))\\n  }\\n  else None\\n}\\n\\nfn lookup_string_index_of(name: String) -> Option[Type] {\\n  if name == \\\"String::index_of\\\" {\\n    Some(CtFn(string2_two_params(CtString, CtString), CtInt, None))\\n  }\\n  else None\\n}\\n\\nfn lookup_string_to_lower(name: String) -> Option[Type] {\\n  if name == \\\"String::to_lower\\\" {\\n    Some(CtFn(string2_one_param(CtString), CtString, None))\\n  }\\n  else None\\n}\\n\\nfn lookup_string_to_upper(name: String) -> Option[Type] {\\n  if name == \\\"String::to_upper\\\" {\\n    Some(CtFn(string2_one_param(CtString), CtString, None))\\n  }\\n  else None\\n}\\n\\nfn lookup_string_group_c(name: String) -> Option[Type] {\\n  match lookup_string_trim(name) {\\n    Some(t) => Some(t),\\n    None => match lookup_string_to_upper(name) {\\n      Some(t) => Some(t),\\n      None => lookup_string_to_lower(name)\\n    }\\n  }\\n}\\n\\nfn lookup_string_ends_with(name: String) -> Option[Type] {\\n  if name == \\\"String::ends_with\\\" {\\n    Some(CtFn(string2_two_params(CtString, CtString), CtBool, None))\\n  }\\n  else None\\n}\\n\\nfn lookup_string_starts_with(name: String) -> Option[Type] {\\n  if name == \\\"String::starts_with\\\" {\\n    Some(CtFn(string2_two_params(CtString, CtString), CtBool, None))\\n  }\\n  else None\\n}\\n\\nfn lookup_string2_group_a(name: String) -> Option[Type] {\\n  match lookup_string_index_of(name) {\\n    Some(t) => Some(t),\\n    None => match lookup_string_contains(name) {\\n      Some(t) => Some(t),\\n      None => match lookup_string_starts_with(name) {\\n        Some(t) => Some(t),\\n        None => lookup_string_ends_with(name)\\n      }\\n    }\\n  }\\n}\\n\\nfn lookup_string_char_code_at(name: String) -> Option[Type] {\\n  if name == \\\"String::char_code_at\\\" {\\n    Some(CtFn(string2_two_params(CtString, CtInt), CtInt, None))\\n  }\\n  else None\\n}\\n\\nfn lookup_string_last_index_of(name: String) -> Option[Type] {\\n  if name == \\\"String::last_index_of\\\" {\\n    Some(CtFn(string2_two_params(CtString, CtString), CtInt, None))\\n  }\\n  else None\\n}\\n\\nfn lookup_string_from_char_code(name: String) -> Option[Type] {\\n  if name == \\\"String::from_char_code\\\" {\\n    Some(CtFn(string2_one_param(CtInt), CtString, None))\\n  }\\n  else None\\n}\\n\\nfn lookup_string2_group_b(name: String) -> Option[Type] {\\n  match lookup_string_from_char_code(name) {\\n    Some(t) => Some(t),\\n    None => match lookup_string_char_code_at(name) {\\n      Some(t) => Some(t),\\n      None => match lookup_string_last_index_of(name) {\\n        Some(t) => Some(t),\\n        None => lookup_string_split(name)\\n      }\\n    }\\n  }\\n}\\n\\nexport fn lookup_string2(name: String) -> Option[Type] {\\n  match lookup_string2_group_a(name) {\\n    Some(t) => Some(t),\\n    None => match lookup_string2_group_b(name) {\\n      Some(t) => Some(t),\\n      None => lookup_string_group_c(name)\\n    }\\n  }\\n}\\n\")\n}\n\nlet cli_adapter_source_39 = () -> (String, String) {\n  (\"lib/@vibe/compiler/checker/builtins_builders.vibe\",\n\"//# Imports\\n\\nimport ../core/index.vibe {\\n  Type\\n}\\n\\n//# Functions\\n\\nfn builders_no_params() -> Array[Type] {\\n  Array::slice([\\n    CtUnknown\\n  ], 0, 0)\\n}\\n\\nfn builders_one_param(a: Type) -> Array[Type] {\\n  let arr = builders_no_params()\\n  Array::push(arr, a)\\n  arr\\n}\\n\\nfn builders_two_params(a: Type, b: Type) -> Array[Type] {\\n  let arr = builders_no_params()\\n  Array::push(arr, a)\\n  Array::push(arr, b)\\n  arr\\n}\\n\\nfn lookup_array_builder_new(name: String) -> Option[Type] {\\n  if name == \\\"ArrayBuilder::new\\\" {\\n    Some(CtFn(builders_no_params(), CtUnknown, None))\\n  }\\n  else None\\n}\\n\\nfn lookup_array_builder_push(name: String) -> Option[Type] {\\n  if name == \\\"ArrayBuilder::push\\\" {\\n    Some(CtFn(builders_two_params(CtUnknown, CtUnknown), CtUnit, None))\\n  }\\n  else None\\n}\\n\\nfn lookup_string_builder_new(name: String) -> Option[Type] {\\n  if name == \\\"StringBuilder::new\\\" {\\n    Some(CtFn(builders_no_params(), CtUnknown, None))\\n  }\\n  else None\\n}\\n\\nfn lookup_string_builder_push(name: String) -> Option[Type] {\\n  if name == \\\"StringBuilder::push\\\" {\\n    Some(CtFn(builders_two_params(CtUnknown, CtString), CtUnit, None))\\n  }\\n  else None\\n}\\n\\nfn lookup_array_builder_freeze(name: String) -> Option[Type] {\\n  if name == \\\"ArrayBuilder::freeze\\\" {\\n    Some(CtFn(builders_one_param(CtUnknown), CtArray(CtUnknown), None))\\n  }\\n  else None\\n}\\n\\nexport fn lookup_array_builder(name: String) -> Option[Type] {\\n  match lookup_array_builder_new(name) {\\n    Some(t) => Some(t),\\n    None => match lookup_array_builder_push(name) {\\n      Some(t) => Some(t),\\n      None => lookup_array_builder_freeze(name)\\n    }\\n  }\\n}\\n\\nfn lookup_string_builder_freeze(name: String) -> Option[Type] {\\n  if name == \\\"StringBuilder::freeze\\\" {\\n    Some(CtFn(builders_one_param(CtUnknown), CtString, None))\\n  }\\n  else None\\n}\\n\\nexport fn lookup_string_builder(name: String) -> Option[Type] {\\n  match lookup_string_builder_new(name) {\\n    Some(t) => Some(t),\\n    None => match lookup_string_builder_push(name) {\\n      Some(t) => Some(t),\\n      None => lookup_string_builder_freeze(name)\\n    }\\n  }\\n}\\n\")\n}\n\nlet cli_adapter_source_40 = () -> (String, String) {\n  (\"lib/@vibe/compiler/checker/builtins_async.vibe\",\n\"//# Imports\\n\\nimport ../core/index.vibe {\\n  Type\\n}\\n\\n//# Functions\\n\\n// WASI 0.3 async front-end (M1a/M2/M-conc). See docs/spec/wasi-p3-async.md,\\n// ADR-0012.\\n//\\n// These are type-level / front-end only (no codegen yet): `Future[T]`,\\n// `Stream[T]`, `Task[T]` are represented structurally as CtNamed(name, _) so no\\n// core `Type` enum change is needed, and element/result types use CtUnknown\\n// (gradual), consistent with the rest of the builtin table. Operations that\\n// suspend or touch the async runtime carry the open-string `Async` effect, so\\n// the existing effect-escape check (checker_effects.vibe) requires them to be\\n// used inside `with { Async }` (or a handle body) — exactly like `throw`/`Error`.\\n\\nfn async_no_params() -> Array[Type] {\\n  Array::slice([\\n    CtUnknown\\n  ], 0, 0)\\n}\\n\\n// Future[T] + await (M1a).\\nfn lookup_future(name: String) -> Option[Type] {\\n  if name == \\\"await\\\" {\\n    // await: (Future[T]) -> T with { Async }\\n    Some(CtFn([\\n      CtNamed(\\\"Future\\\", [\\n        CtUnknown\\n      ])\\n    ], CtUnknown, Some(\\\"Async\\\")))\\n  } else if name == \\\"Future::ready\\\" {\\n    // Future::ready: (T) -> Future[T]   (pure; an already-resolved future)\\n    Some(CtFn([\\n      CtUnknown\\n    ], CtNamed(\\\"Future\\\", [\\n      CtUnknown\\n    ]), None))\\n  } else {\\n    None\\n  }\\n}\\n\\n// Stream[T] — a pull-based async iterator (WASI 0.3 stream<T>), the async\\n// sibling of Iterator (ADR-0044): the same combinator shape (map/filter/fold)\\n// as the sync Iterator, but `next` yields a Future and `fold` is Async.\\nfn lookup_stream(name: String) -> Option[Type] {\\n  if name == \\\"Stream::empty\\\" {\\n    // Stream::empty: () -> Stream[T]   (pure)\\n    Some(CtFn(async_no_params(), CtNamed(\\\"Stream\\\", [\\n      CtUnknown\\n    ]), None))\\n  } else if name == \\\"Stream::once\\\" {\\n    // Stream::once: (T) -> Stream[T]   (pure; single-element stream)\\n    Some(CtFn([\\n      CtUnknown\\n    ], CtNamed(\\\"Stream\\\", [\\n      CtUnknown\\n    ]), None))\\n  } else if name == \\\"Stream::next\\\" {\\n    // Stream::next: (Stream[T]) -> Future[Option[T]] with { Async }\\n    // None terminates the stream.\\n    Some(CtFn([\\n      CtNamed(\\\"Stream\\\", [\\n        CtUnknown\\n      ])\\n    ], CtNamed(\\\"Future\\\", [\\n      CtOption(CtUnknown)\\n    ]), Some(\\\"Async\\\")))\\n  } else if name == \\\"Stream::map\\\" {\\n    // Stream::map: (Stream[T], (T) -> U) -> Stream[U]   (lazy)\\n    Some(CtFn([\\n      CtNamed(\\\"Stream\\\", [\\n        CtUnknown\\n      ]),\\n      CtUnknown\\n    ], CtNamed(\\\"Stream\\\", [\\n      CtUnknown\\n    ]), None))\\n  } else if name == \\\"Stream::filter\\\" {\\n    // Stream::filter: (Stream[T], (T) -> Bool) -> Stream[T]   (lazy)\\n    Some(CtFn([\\n      CtNamed(\\\"Stream\\\", [\\n        CtUnknown\\n      ]),\\n      CtUnknown\\n    ], CtNamed(\\\"Stream\\\", [\\n      CtUnknown\\n    ]), None))\\n  } else if name == \\\"Stream::fold\\\" {\\n    // Stream::fold: (Stream[T], A, (A, T) -> A) -> Future[A] with { Async }\\n    Some(CtFn([\\n      CtNamed(\\\"Stream\\\", [\\n        CtUnknown\\n      ]),\\n      CtUnknown,\\n      CtUnknown\\n    ], CtNamed(\\\"Future\\\", [\\n      CtUnknown\\n    ]), Some(\\\"Async\\\")))\\n  } else {\\n    None\\n  }\\n}\\n\\n// Task[T] — structured concurrency + cancellation (WASI 0.3 task / waitable-set\\n// / future.cancel-*). spawn creates a child task bound to the enclosing async\\n// scope; join awaits it; cancel requests cancellation; race/timeout combine.\\nfn lookup_concurrency(name: String) -> Option[Type] {\\n  if name == \\\"Task::spawn\\\" {\\n    // Task::spawn: (() -> T with { Async }) -> Task[T] with { Async }\\n    Some(CtFn([\\n      CtUnknown\\n    ], CtNamed(\\\"Task\\\", [\\n      CtUnknown\\n    ]), Some(\\\"Async\\\")))\\n  } else if name == \\\"Task::join\\\" {\\n    // Task::join: (Task[T]) -> T with { Async }\\n    Some(CtFn([\\n      CtNamed(\\\"Task\\\", [\\n        CtUnknown\\n      ])\\n    ], CtUnknown, Some(\\\"Async\\\")))\\n  } else if name == \\\"Task::cancel\\\" {\\n    // Task::cancel: (Task[T]) -> Unit with { Async }\\n    Some(CtFn([\\n      CtNamed(\\\"Task\\\", [\\n        CtUnknown\\n      ])\\n    ], CtUnit, Some(\\\"Async\\\")))\\n  } else if name == \\\"Task::race\\\" {\\n    // Task::race: (Task[T], Task[T]) -> T with { Async }  (loser is cancelled)\\n    Some(CtFn([\\n      CtNamed(\\\"Task\\\", [\\n        CtUnknown\\n      ]),\\n      CtNamed(\\\"Task\\\", [\\n        CtUnknown\\n      ])\\n    ], CtUnknown, Some(\\\"Async\\\")))\\n  } else if name == \\\"Task::timeout\\\" {\\n    // Task::timeout: (Int, () -> T with { Async }) -> Option[T] with { Async }\\n    // None on deadline (the inner task is cancelled).\\n    Some(CtFn([\\n      CtInt,\\n      CtUnknown\\n    ], CtOption(CtUnknown), Some(\\\"Async\\\")))\\n  } else {\\n    None\\n  }\\n}\\n\\n// ByteStream = Stream[Int] — WASI 0.3 stream<u8> / HTTP body bridge (M2c).\\n// `String::to_bytes` exposes a String's bytes as a ByteStream so request/response\\n// bodies can be consumed with the Stream combinators (map/filter/fold/next). It\\n// is pure & eager on the linear backend (the bytes are already in memory).\\nfn lookup_bytestream(name: String) -> Option[Type] {\\n  if name == \\\"String::to_bytes\\\" {\\n    // String::to_bytes: (String) -> Stream[Int]   (ByteStream)\\n    Some(CtFn([\\n      CtString\\n    ], CtNamed(\\\"Stream\\\", [\\n      CtInt\\n    ]), None))\\n  } else if name == \\\"Stream::to_string\\\" {\\n    // Stream::to_string: (Stream[Int]) -> String   (ByteStream -> String;\\n    // collect a byte stream into a response body)\\n    Some(CtFn([\\n      CtNamed(\\\"Stream\\\", [\\n        CtInt\\n      ])\\n    ], CtString, None))\\n  } else {\\n    None\\n  }\\n}\\n\\nexport fn lookup_async(name: String) -> Option[Type] {\\n  match lookup_future(name) {\\n    Some(t) => Some(t),\\n    None => match lookup_stream(name) {\\n      Some(t) => Some(t),\\n      None => match lookup_concurrency(name) {\\n        Some(t) => Some(t),\\n        None => lookup_bytestream(name)\\n      }\\n    }\\n  }\\n}\\n\")\n}\n\nlet cli_adapter_source_41 = () -> (String, String) {\n  (\"lib/@vibe/compiler/checker/checker_resolve.vibe\",\n\"//# Imports\\n\\nimport ../core/index.vibe {\\n  TypeExpr, Type, TypeDef, find_typedef, resolve_builtin\\n}\\n\\n//# Functions\\n\\n// Substitute a parameterized type alias's formal params with actual type args.\\n// The alias body was resolved with its params as free `CtNamed(<param>, _)`\\n// names; replace each by the corresponding actual argument (recursively).\\nexport fn subst_type_params(ty: Type, params: Array[String], args: Array[Type]) -> Type {\\n  match ty {\\n    CtNamed(name, targs) => {\\n      let mut idx = 0 - 1\\n      let mut i = 0\\n      while i < Array::length(params) {\\n        if Array::get(params, i) == name {\\n          idx = i\\n        }\\n        i = i + 1\\n      }\\n      if idx >= 0 && idx < Array::length(args) {\\n        Array::get(args, idx)\\n      } else {\\n        CtNamed(name, for a in targs {\\n          subst_type_params(a, params, args)\\n        })\\n      }\\n    },\\n    CtArray(e) => CtArray(subst_type_params(e, params, args)),\\n    CtOption(e) => CtOption(subst_type_params(e, params, args)),\\n    CtTuple(es) => CtTuple(for e in es {\\n      subst_type_params(e, params, args)\\n    }),\\n    CtFn(ps, ret, eff) => {\\n      let subst_params: (Array[Type]) -> Array[Type] = (types) -> {\\n        let out = Array::slice([\\n          CtUnknown\\n        ], 0, 0)\\n        let mut i = 0\\n        while i < Array::length(types) {\\n          Array::push(out, subst_type_params(Array::get(types, i), params, args))\\n          i = i + 1\\n        }\\n        out\\n      }\\n      CtFn(subst_params(ps), subst_type_params(ret, params, args), eff)\\n    },\\n    _ => ty\\n  }\\n}\\n\\nexport fn resolve_type_expr(te: TypeExpr, defs: Array[TypeDef]) -> Type {\\n  match te {\\n    TyUnit => CtUnit,\\n    TyName(name) => match resolve_builtin(name) {\\n      Some(t) => t,\\n      None => match find_typedef(defs, name) {\\n        Some(td) => match td {\\n          TDEnum(n, _, _) => CtEnum(n),\\n          TDStruct(n, _, _, _) => CtStruct(n),\\n          TDAlias(_, _, t) => t,\\n          TDEffect(_, _) => CtNamed(name, Array::slice([\\n            CtUnknown\\n          ], 0, 0))\\n        },\\n        None => CtNamed(name, Array::slice([\\n          CtUnknown\\n        ], 0, 0))\\n      }\\n    },\\n    TyApp(name, args) => {\\n      let ra = for a in args {\\n        resolve_type_expr(a, defs)\\n      }\\n      if name == \\\"Array\\\" {\\n        if Array::length(ra) == 1 {\\n          CtArray(Array::get(ra, 0))\\n        }\\n        else CtNamed(name, ra)\\n      } else if name == \\\"Option\\\" {\\n        if Array::length(ra) == 1 {\\n          CtOption(Array::get(ra, 0))\\n        }\\n        else CtNamed(name, ra)\\n      } else {\\n        // Expand a parameterized type alias `Foo[A] = Body` applied as `Foo[X]`\\n        // by substituting its formal params; otherwise it stays nominal.\\n        match find_typedef(defs, name) {\\n          Some(td) => match td {\\n            TDAlias(_, params, body) => subst_type_params(body, params, ra),\\n            _ => CtNamed(name, ra)\\n          },\\n          None => CtNamed(name, ra)\\n        }\\n      }\\n    },\\n    TyTuple(elems) => {\\n      let r = for e in elems {\\n        resolve_type_expr(e, defs)\\n      }\\n      CtTuple(r)\\n    },\\n    TyFn(params, ret, effect_name) => {\\n      let ret_box = Array::slice([\\n        ret\\n      ], 0, 1)\\n      let rp = for p in params {\\n        resolve_type_expr(p, defs)\\n      }\\n      CtFn(rp, resolve_type_expr(Array::get(ret_box, 0), defs), effect_name)\\n    }\\n  }\\n}\\n\")\n}\n\nlet cli_adapter_source_42 = () -> (String, String) {\n  (\"lib/@vibe/compiler/checker/checker_pattern.vibe\",\n\"//# Imports\\n\\nimport ../core {\\n  Pat, Type, TypeDef, TypeEnv, env_bind, find_typedef\\n}\\n\\nimport ./checker_resolve.vibe {\\n  subst_type_params\\n}\\n\\n//# Functions\\n\\nfn find_ctor_in_defs(defs: Array[TypeDef], ctor_name: String) -> Option[(String, Array[Type])] {\\n  let dlen = Array::length(defs)\\n  let rec go_defs: (Int) -> Option[(String, Array[Type])] = (di) -> {\\n    if di >= dlen {\\n      None\\n    } else {\\n      let d = Array::get(defs, di)\\n      match d {\\n        TDEnum(enum_name, _, variants) => {\\n          let vlen = Array::length(variants)\\n          let rec go_variants: (Int) -> Option[(String, Array[Type])] = (vi) -> {\\n            if vi >= vlen {\\n              go_defs(di + 1)\\n            } else {\\n              let (vname, vtypes) = Array::get(variants, vi)\\n              if vname == ctor_name {\\n                Some((enum_name, vtypes))\\n              } else {\\n                go_variants(vi + 1)\\n              }\\n            }\\n          }\\n          go_variants(0)\\n        },\\n        _ => go_defs(di + 1)\\n      }\\n    }\\n  }\\n  go_defs(0)\\n}\\n\\n// True if `pat` binds at least one variable, at any nesting depth (through\\n// PCtor/PTuple/PStruct/POr).\\nfn pat_binds_any(pat: Pat) -> Bool {\\n  match pat {\\n    PBind(_) => true,\\n    PCtor(_, pats) => {\\n      let mut i = 0\\n      let mut found = false\\n      while i < Array::length(pats) {\\n        if pat_binds_any(Array::get(pats, i)) {\\n          found = true\\n        } else {\\n          ()\\n        }\\n        i = i + 1\\n      }\\n      found\\n    },\\n    PTuple(pats) => {\\n      let mut i = 0\\n      let mut found = false\\n      while i < Array::length(pats) {\\n        if pat_binds_any(Array::get(pats, i)) {\\n          found = true\\n        } else {\\n          ()\\n        }\\n        i = i + 1\\n      }\\n      found\\n    },\\n    POr(a, b) => pat_binds_any(a) || pat_binds_any(b),\\n    PStruct(_, fields) => {\\n      let mut i = 0\\n      let mut found = false\\n      while i < Array::length(fields) {\\n        let (_, fpat) = Array::get(fields, i)\\n        if pat_binds_any(fpat) {\\n          found = true\\n        } else {\\n          ()\\n        }\\n        i = i + 1\\n      }\\n      found\\n    },\\n    _ => false\\n  }\\n}\\n\\n// #951: codegen's or-pattern lowering (`emit_or_check` in\\n// codegen/expr/compile_match.vibe) only emits the tag/literal DISCRIMINATION\\n// test for an or-pattern (`A(v) | B(v) => ..`); it never emits a binding\\n// EXTRACTION for either branch, since which branch actually matched is not\\n// known at the point the arm body binds its locals. A binding or-pattern\\n// (even one where both branches use the same name/type, e.g. `A(v) | B(v)`)\\n// therefore passes `check_pattern` below — which only walks the LEFT branch —\\n// and then crashes codegen with an unlocated \\\"undefined variable\\\" internal\\n// error when the arm body reads the binding. Detect ANY or-pattern that binds\\n// a variable in either branch, at any nesting depth, so the checker can\\n// reject it with a normal, located diagnostic instead of letting it reach\\n// codegen at all.\\nexport fn pat_has_unsupported_or_binding(pat: Pat) -> Bool {\\n  match pat {\\n    POr(a, b) => pat_binds_any(a) || pat_binds_any(b) || pat_has_unsupported_or_binding(a) || pat_has_unsupported_or_binding(b),\\n    PCtor(_, pats) => {\\n      let mut i = 0\\n      let mut found = false\\n      while i < Array::length(pats) {\\n        if pat_has_unsupported_or_binding(Array::get(pats, i)) {\\n          found = true\\n        } else {\\n          ()\\n        }\\n        i = i + 1\\n      }\\n      found\\n    },\\n    PTuple(pats) => {\\n      let mut i = 0\\n      let mut found = false\\n      while i < Array::length(pats) {\\n        if pat_has_unsupported_or_binding(Array::get(pats, i)) {\\n          found = true\\n        } else {\\n          ()\\n        }\\n        i = i + 1\\n      }\\n      found\\n    },\\n    PStruct(_, fields) => {\\n      let mut i = 0\\n      let mut found = false\\n      while i < Array::length(fields) {\\n        let (_, fpat) = Array::get(fields, i)\\n        if pat_has_unsupported_or_binding(fpat) {\\n          found = true\\n        } else {\\n          ()\\n        }\\n        i = i + 1\\n      }\\n      found\\n    },\\n    _ => false\\n  }\\n}\\n\\nexport fn check_pattern(pat: Pat, scrutinee_ty: Type, env: TypeEnv, defs: Array[TypeDef], errors: Array[String]) -> TypeEnv {\\n  match pat {\\n    PWild => env,\\n    PBind(name) => env_bind(env, name, scrutinee_ty),\\n    // A literal pattern can only match a scrutinee of its own type. When the\\n    // scrutinee resolves to a concrete type that is NOT that literal's type\\n    // (`match 5 { \\\"x\\\" => .. }`, or a nested `Some(true)` over `Option[Int]`),\\n    // it is a type error. Type variables / unknown / named (generic) scrutinees\\n    // are tolerated.\\n    PInt(_) => {\\n      match scrutinee_ty {\\n        CtInt => (),\\n        // Char is a transparent alias of Int (char literals lex to TInt), so an\\n        // integer/char literal pattern matches a Char scrutinee too (char_test).\\n        CtChar => (),\\n        CtVar(_) => (),\\n        CtUnknown => (),\\n        CtNamed(_, _) => (),\\n        _ => Array::push(errors, \\\"integer literal pattern cannot match a non-Int scrutinee\\\")\\n      }\\n      env\\n    },\\n    PFloat(_) => {\\n      match scrutinee_ty {\\n        CtDouble => (),\\n        CtVar(_) => (),\\n        CtUnknown => (),\\n        CtNamed(_, _) => (),\\n        _ => Array::push(errors, \\\"float literal pattern cannot match a non-Double scrutinee\\\")\\n      }\\n      env\\n    },\\n    PString(_) => {\\n      match scrutinee_ty {\\n        CtString => (),\\n        CtVar(_) => (),\\n        CtUnknown => (),\\n        CtNamed(_, _) => (),\\n        _ => Array::push(errors, \\\"string literal pattern cannot match a non-String scrutinee\\\")\\n      }\\n      env\\n    },\\n    PBool(_) => {\\n      match scrutinee_ty {\\n        CtBool => (),\\n        CtVar(_) => (),\\n        CtUnknown => (),\\n        CtNamed(_, _) => (),\\n        _ => Array::push(errors, \\\"boolean literal pattern cannot match a non-Bool scrutinee\\\")\\n      }\\n      env\\n    },\\n    PCtor(name, sub_pats) => {\\n      let builtin_payload = match scrutinee_ty {\\n        CtOption(elem) => if name == \\\"Some\\\" {\\n          Some([\\n            elem\\n          ])\\n        } else if name == \\\"None\\\" {\\n          Some(Array::slice([\\n            CtUnknown\\n          ], 0, 0))\\n        } else {\\n          None\\n        },\\n        _ => None\\n      }\\n      let ctor_payload = match builtin_payload {\\n        Some(types) => Some((\\\"Option\\\", types)),\\n        None => find_ctor_in_defs(defs, name)\\n      }\\n      match ctor_payload {\\n        Some(info) => {\\n          let (enum_name, raw_payload) = info\\n          // Instantiate the variant's field types for a parameterized enum:\\n          // substitute the enum's formal params with the scrutinee's actual type\\n          // args (e.g. matching `Ok(inner)` on `Result[Result[T,E], E]` types\\n          // `inner` as `Result[T,E]`, not the bare enum param).\\n          let payload_types = match scrutinee_ty {\\n            CtNamed(_, sargs) => match find_typedef(defs, enum_name) {\\n              Some(td) => match td {\\n                TDEnum(_, eparams, _) => if Array::length(eparams) > 0 && Array::length(sargs) > 0 {\\n                  for pt in raw_payload {\\n                    subst_type_params(pt, eparams, sargs)\\n                  }\\n                } else {\\n                  raw_payload\\n                },\\n                _ => raw_payload\\n              },\\n              None => raw_payload\\n            },\\n            _ => raw_payload\\n          }\\n          let splen = Array::length(sub_pats)\\n          let ptlen = Array::length(payload_types)\\n          // A constructor pattern can only match a value whose type is the\\n          // corresponding enum (or builtin Option). A concrete NON-enum type —\\n          // a scalar (`match 5 { Red => .. }`), a function (`match N { N(a) =>\\n          // .. }` where the bare ctor `N` is the `(Int) -> E` partial\\n          // application), an Array or a Tuple — can never be that enum.\\n          // Type vars / unknown / named / enum / option scrutinees are tolerated.\\n          let non_enum_scrutinee = match scrutinee_ty {\\n            CtInt => true,\\n            CtDouble => true,\\n            CtBool => true,\\n            CtString => true,\\n            CtChar => true,\\n            CtUnit => true,\\n            CtBytes => true,\\n            CtFn(_, _, _) => true,\\n            CtArray(_) => true,\\n            CtTuple(_) => true,\\n            _ => false\\n          }\\n          if non_enum_scrutinee {\\n            Array::push(errors, String::concat(\\\"constructor pattern `\\\", String::concat(name, String::concat(\\\"` (of \\\", String::concat(enum_name, \\\") cannot match this scrutinee type\\\")))))\\n          } else {\\n            ()\\n          }\\n          // The pattern must bind exactly the variant's payload arity —\\n          // `Pair(a)` for `Pair(Int, Int)` binds a garbage/oob 2nd field, and\\n          // binding MORE than exists is likewise wrong. Skip the builtin\\n          // `Option` (its `None` carries a synthetic 1-element payload).\\n          if enum_name != \\\"Option\\\" && splen != ptlen {\\n            Array::push(errors, String::concat(\\\"constructor pattern `\\\", String::concat(name, String::concat(\\\"` expects \\\", String::concat(__to_string(ptlen), String::concat(\\\" field(s) but binds \\\", __to_string(splen)))))))\\n          } else {\\n            ()\\n          }\\n          let rec bind_subs: (Int, TypeEnv) -> TypeEnv = (i, acc_env) -> {\\n            if i >= splen {\\n              acc_env\\n            } else {\\n              let sub_ty = if i < ptlen {\\n                Array::get(payload_types, i)\\n              } else {\\n                CtUnknown\\n              }\\n              let next_env = check_pattern(Array::get(sub_pats, i), sub_ty, acc_env, defs, errors)\\n              bind_subs(i + 1, next_env)\\n            }\\n          }\\n          bind_subs(0, env)\\n        },\\n        None => {\\n          let splen = Array::length(sub_pats)\\n          let rec bind_unknown: (Int, TypeEnv) -> TypeEnv = (i, acc_env) -> {\\n            if i >= splen {\\n              acc_env\\n            } else {\\n              let next_env = check_pattern(Array::get(sub_pats, i), CtUnknown, acc_env, defs, errors)\\n              bind_unknown(i + 1, next_env)\\n            }\\n          }\\n          bind_unknown(0, env)\\n        }\\n      }\\n    },\\n    PTuple(pats) => {\\n      let plen = Array::length(pats)\\n      match scrutinee_ty {\\n        CtTuple(elem_tys) => {\\n          let elen = Array::length(elem_tys)\\n          // A tuple pattern must bind exactly the scrutinee tuple's arity —\\n          // `let (a, b, c) = (1, 2)` was accepted and would read past the\\n          // tuple (binding `c` to garbage). Tuples have a fixed, fully known\\n          // arity, so this is always a real error.\\n          if plen != elen {\\n            Array::push(errors, String::concat(\\\"tuple pattern binds \\\", String::concat(__to_string(plen), String::concat(\\\" elements but the value is a \\\", String::concat(__to_string(elen), \\\"-tuple\\\")))))\\n          } else {\\n            ()\\n          }\\n          let rec bind_tuple: (Int, TypeEnv) -> TypeEnv = (i, acc_env) -> {\\n            if i >= plen {\\n              acc_env\\n            } else {\\n              let et = if i < elen {\\n                Array::get(elem_tys, i)\\n              } else {\\n                CtUnknown\\n              }\\n              let next_env = check_pattern(Array::get(pats, i), et, acc_env, defs, errors)\\n              bind_tuple(i + 1, next_env)\\n            }\\n          }\\n          bind_tuple(0, env)\\n        },\\n        _ => {\\n          // A tuple pattern can only match a tuple value. `let (a, b) = 5`\\n          // (desugared to `match 5 { (a, b) => .. }`) was accepted and bound\\n          // `a`/`b` to garbage. When the scrutinee resolves to a concrete\\n          // NON-tuple type (a scalar, array, option, fn, struct, enum), this is\\n          // a real error. Type vars / unknown / named (generic) scrutinees stay\\n          // tolerated.\\n          let concrete_non_tuple = match scrutinee_ty {\\n            CtInt => true,\\n            CtDouble => true,\\n            CtBool => true,\\n            CtString => true,\\n            CtChar => true,\\n            CtUnit => true,\\n            CtBytes => true,\\n            CtArray(_) => true,\\n            CtOption(_) => true,\\n            CtFn(_, _, _) => true,\\n            CtStruct(_) => true,\\n            CtEnum(_) => true,\\n            _ => false\\n          }\\n          if concrete_non_tuple {\\n            Array::push(errors, String::concat(\\\"tuple pattern binds \\\", String::concat(__to_string(plen), \\\" elements but the value is not a tuple\\\")))\\n          } else {\\n            ()\\n          }\\n          let rec bind_unk: (Int, TypeEnv) -> TypeEnv = (i, acc_env) -> {\\n            if i >= plen {\\n              acc_env\\n            } else {\\n              let next_env = check_pattern(Array::get(pats, i), CtUnknown, acc_env, defs, errors)\\n              bind_unk(i + 1, next_env)\\n            }\\n          }\\n          bind_unk(0, env)\\n        }\\n      }\\n    },\\n    POr(left, _right) => check_pattern(left, scrutinee_ty, env, defs, errors),\\n    PStruct(_, fields) => {\\n      let flen = Array::length(fields)\\n      let rec bind_fields: (Int, TypeEnv) -> TypeEnv = (i, acc_env) -> {\\n        if i >= flen {\\n          acc_env\\n        } else {\\n          let (_, fpat) = Array::get(fields, i)\\n          let next_env = check_pattern(fpat, CtUnknown, acc_env, defs, errors)\\n          bind_fields(i + 1, next_env)\\n        }\\n      }\\n      bind_fields(0, env)\\n    }\\n  }\\n}\\n\")\n}\n\nlet cli_adapter_source_43 = () -> (String, String) {\n  (\"lib/@vibe/compiler/checker/checker_exhaustive.vibe\",\n\"//# Imports\\n\\nimport ../core/index.vibe {\\n  Pat, Type, TypeDef, find_typedef\\n}\\n\\nimport ./checker_resolve.vibe {\\n  subst_type_params\\n}\\n\\n//# Functions\\n\\n// #940 Phase 2: Maranget-style usefulness check for NESTED match\\n// exhaustiveness. Phase 1 (checker.vibe) only covers the FLAT ctor layer\\n// (user enums, builtin Option, Bool); nested tuples, ctor payloads and\\n// literal patterns compiled clean and trapped on codegen's terminal\\n// `unreachable`. This module answers one question: is the all-wildcard row\\n// USEFUL w.r.t. the pattern matrix built from the match arms? If it is,\\n// the match is non-exhaustive and a concrete uncovered witness pattern is\\n// reconstructed for the diagnostic.\\n//\\n// Deliberate conservatisms (accept = stay silent), all to avoid false\\n// positives on the compiler's own ~3,400 match sites:\\n//   - ground gate: only a fully concrete scrutinee type is checked\\n//     (type vars / unresolved named params are tolerated);\\n//   - open scalars (Int / Char / String / Double): literals alone never\\n//     count as covering — but a column full of wildcards is fine;\\n//   - opaque columns (structs, arrays, fns, unknown): only accepted head\\n//     patterns are irrefutable ones; any refutable head makes the whole\\n//     check abstain;\\n//   - budget cap: the recursion pays rows*cols per call from a fixed\\n//     budget; running out silently accepts (no witness).\\n\\nfn exh_empty_pats() -> Array[Pat] {\\n  Array::slice([\\n    PWild\\n  ], 0, 0)\\n}\\n\\nfn exh_empty_strs() -> Array[String] {\\n  Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n}\\n\\nfn exh_empty_tys() -> Array[Type] {\\n  Array::slice([\\n    CtUnknown\\n  ], 0, 0)\\n}\\n\\nfn exh_empty_ctors() -> Array[(String, Array[Type], Int)] {\\n  Array::slice([\\n    (\\\"\\\", exh_empty_tys(), 0)\\n  ], 0, 0)\\n}\\n\\nfn exh_empty_rows() -> Array[Array[Pat]] {\\n  Array::slice([\\n    exh_empty_pats()\\n  ], 0, 0)\\n}\\n\\nfn exh_names_contain(names: Array[String], target: String) -> Bool {\\n  let mut i = 0\\n  let mut found = false\\n  while i < Array::length(names) && !found {\\n    if Array::get(names, i) == target {\\n      found = true\\n    } else {\\n      i = i + 1\\n    }\\n  }\\n  found\\n}\\n\\n// Top-level catch-all: `_` / a bare binding, or an or-pattern with a\\n// catch-all side.\\nfn exh_pat_catchall(p: Pat) -> Bool {\\n  match p {\\n    PWild => true,\\n    PBind(_) => true,\\n    POr(l, r) => exh_pat_catchall(l) || exh_pat_catchall(r),\\n    _ => false\\n  }\\n}\\n\\n// Wildcard HEAD for the matrix operations (matches every ctor of the column).\\nfn exh_pat_is_wild(p: Pat) -> Bool {\\n  match p {\\n    PWild => true,\\n    PBind(_) => true,\\n    _ => false\\n  }\\n}\\n\\n// Irrefutable at every depth: matches ANY well-typed value of the column.\\n// PCtor stays refutable (a single-variant enum would be irrefutable, but\\n// abstaining is the safe direction here).\\nfn exh_pat_irrefutable(p: Pat) -> Bool {\\n  match p {\\n    PWild => true,\\n    PBind(_) => true,\\n    PTuple(subs) => {\\n      let mut ok = true\\n      let mut i = 0\\n      while i < Array::length(subs) {\\n        if !exh_pat_irrefutable(Array::get(subs, i)) {\\n          ok = false\\n        } else {\\n          ()\\n        }\\n        i = i + 1\\n      }\\n      ok\\n    },\\n    PStruct(_, fields) => {\\n      let mut ok = true\\n      let mut i = 0\\n      while i < Array::length(fields) {\\n        let (_, fp) = Array::get(fields, i)\\n        if !exh_pat_irrefutable(fp) {\\n          ok = false\\n        } else {\\n          ()\\n        }\\n        i = i + 1\\n      }\\n      ok\\n    },\\n    POr(l, r) => exh_pat_irrefutable(l) || exh_pat_irrefutable(r),\\n    _ => false\\n  }\\n}\\n\\n// Or-pattern expansion: POr rows are duplicated per branch (binding\\n// or-patterns are already rejected by #951, so no binding is lost).\\nfn exh_flatten_or(p: Pat, out: Array[Pat]) -> Unit {\\n  match p {\\n    POr(l, r) => {\\n      exh_flatten_or(l, out)\\n      exh_flatten_or(r, out)\\n    },\\n    _ => Array::push(out, p)\\n  }\\n}\\n\\nfn exh_all_ground(ts: Array[Type], defs: Array[TypeDef]) -> Bool {\\n  let mut ok = true\\n  let mut i = 0\\n  while i < Array::length(ts) {\\n    if !exh_type_ground(Array::get(ts, i), defs) {\\n      ok = false\\n    } else {\\n      ()\\n    }\\n    i = i + 1\\n  }\\n  ok\\n}\\n\\n// Ground gate: no inference variable / rigid param anywhere. `CtNamed` is\\n// only accepted as a REAL instantiated generic (all args concrete) or as a\\n// bare reference that resolves to a known zero-param enum; the resolver's\\n// unresolved sentinel `CtNamed(name, [CtUnknown])` and a bare unknown name\\n// both fail the gate (see type_fully_concrete in checker.vibe, #844).\\nfn exh_type_ground(t: Type, defs: Array[TypeDef]) -> Bool {\\n  match t {\\n    CtVar(_) => false,\\n    CtUnknown => false,\\n    CtForAll(_, _, _) => false,\\n    CtNamed(n, args) => {\\n      if Array::length(args) == 0 {\\n        match find_typedef(defs, n) {\\n          Some(TDEnum(_, eparams, _)) => Array::length(eparams) == 0,\\n          _ => false\\n        }\\n      } else {\\n        exh_all_ground(args, defs)\\n      }\\n    },\\n    CtTuple(items) => exh_all_ground(items, defs),\\n    CtArray(e) => exh_type_ground(e, defs),\\n    CtOption(e) => exh_type_ground(e, defs),\\n    CtFn(ps, r, _) => exh_all_ground(ps, defs) && exh_type_ground(r, defs),\\n    _ => true\\n  }\\n}\\n\\n// Collect the distinct CtVar ids occurring anywhere in `t` into `acc`.\\nfn exh_collect_vids(t: Type, acc: Array[Int]) -> Unit {\\n  match t {\\n    CtVar(v) => {\\n      let mut i = 0\\n      let mut seen = false\\n      while i < Array::length(acc) {\\n        if Array::get(acc, i) == v {\\n          seen = true\\n        } else {\\n          ()\\n        }\\n        i = i + 1\\n      }\\n      if seen {\\n        ()\\n      } else {\\n        Array::push(acc, v)\\n      }\\n    },\\n    CtTuple(items) => {\\n      let mut i = 0\\n      while i < Array::length(items) {\\n        exh_collect_vids(Array::get(items, i), acc)\\n        i = i + 1\\n      }\\n    },\\n    CtArray(e) => exh_collect_vids(e, acc),\\n    CtOption(e) => exh_collect_vids(e, acc),\\n    CtNamed(_, nargs) => {\\n      let mut i = 0\\n      while i < Array::length(nargs) {\\n        exh_collect_vids(Array::get(nargs, i), acc)\\n        i = i + 1\\n      }\\n    },\\n    CtFn(ps, r, _) => {\\n      let mut i = 0\\n      while i < Array::length(ps) {\\n        exh_collect_vids(Array::get(ps, i), acc)\\n        i = i + 1\\n      }\\n      exh_collect_vids(r, acc)\\n    },\\n    _ => ()\\n  }\\n}\\n\\n// Replace CtVar(vids[i]) by args[i] (positional), recursively.\\nfn exh_subst_vids(t: Type, vids: Array[Int], args: Array[Type]) -> Type {\\n  match t {\\n    CtVar(v) => {\\n      let mut idx = 0 - 1\\n      let mut i = 0\\n      while i < Array::length(vids) {\\n        if Array::get(vids, i) == v {\\n          idx = i\\n        } else {\\n          ()\\n        }\\n        i = i + 1\\n      }\\n      if idx >= 0 && idx < Array::length(args) {\\n        Array::get(args, idx)\\n      } else {\\n        t\\n      }\\n    },\\n    CtTuple(items) => {\\n      let acc = exh_empty_tys()\\n      let mut i = 0\\n      while i < Array::length(items) {\\n        Array::push(acc, exh_subst_vids(Array::get(items, i), vids, args))\\n        i = i + 1\\n      }\\n      CtTuple(acc)\\n    },\\n    CtArray(e) => CtArray(exh_subst_vids(e, vids, args)),\\n    CtOption(e) => CtOption(exh_subst_vids(e, vids, args)),\\n    CtNamed(n, nargs) => {\\n      let acc = exh_empty_tys()\\n      let mut i = 0\\n      while i < Array::length(nargs) {\\n        Array::push(acc, exh_subst_vids(Array::get(nargs, i), vids, args))\\n        i = i + 1\\n      }\\n      CtNamed(n, acc)\\n    },\\n    CtFn(ps, r, eff) => {\\n      let acc = exh_empty_tys()\\n      let mut i = 0\\n      while i < Array::length(ps) {\\n        Array::push(acc, exh_subst_vids(Array::get(ps, i), vids, args))\\n        i = i + 1\\n      }\\n      CtFn(acc, exh_subst_vids(r, vids, args), eff)\\n    },\\n    _ => t\\n  }\\n}\\n\\n// Ctor universe of a user enum column: variant payload types instantiated\\n// against the scrutinee's actual type args. A non-enum name classifies the\\n// column opaque (kind 2).\\n//\\n// TDEnum stores a generic enum's payload types with the declared params\\n// ALREADY substituted to fresh `CtVar(vid)`s (checker_stmt.vibe, SEnum) —\\n// the name-based subst_type_params never fires on them. Those vids are\\n// CONSECUTIVE per declaration (vid = c + param_index), so when the payloads\\n// mention exactly `param_len` distinct vids, the sorted vids are provably\\n// the full c..c+n-1 range in declaration order and can be mapped\\n// positionally onto the scrutinee's actual args. When some param never\\n// occurs in any payload the offset is ambiguous — the CtVars are left in\\n// place and those columns abstain (opaque) downstream.\\nfn exh_enum_ctors(en: String, args: Array[Type], defs: Array[TypeDef]) -> (Int, Array[(String, Array[Type], Int)]) {\\n  match find_typedef(defs, en) {\\n    Some(TDEnum(_, eparams, variants)) => {\\n      let can_subst = Array::length(eparams) > 0 && Array::length(args) == Array::length(eparams)\\n      let vids = Array::slice([\\n        0\\n      ], 0, 0)\\n      if can_subst {\\n        let mut ci = 0\\n        while ci < Array::length(variants) {\\n          let (_, cptys) = Array::get(variants, ci)\\n          let mut cj = 0\\n          while cj < Array::length(cptys) {\\n            exh_collect_vids(Array::get(cptys, cj), vids)\\n            cj = cj + 1\\n          }\\n          ci = ci + 1\\n        }\\n        // insertion sort (ascending) — tiny arrays\\n        let mut si = 1\\n        while si < Array::length(vids) {\\n          let v = Array::get(vids, si)\\n          let mut sj = si\\n          let mut moving = true\\n          while sj > 0 && moving {\\n            if Array::get(vids, sj - 1) > v {\\n              Array::set(vids, sj, Array::get(vids, sj - 1))\\n              sj = sj - 1\\n            } else {\\n              moving = false\\n            }\\n          }\\n          Array::set(vids, sj, v)\\n          si = si + 1\\n        }\\n      } else {\\n        ()\\n      }\\n      let vid_subst = can_subst && Array::length(vids) == Array::length(eparams)\\n      let out = exh_empty_ctors()\\n      let mut i = 0\\n      while i < Array::length(variants) {\\n        let (vn, ptys) = Array::get(variants, i)\\n        let inst = if can_subst {\\n          let acc = exh_empty_tys()\\n          let mut j = 0\\n          while j < Array::length(ptys) {\\n            let named_done = subst_type_params(Array::get(ptys, j), eparams, args)\\n            let vt = if vid_subst {\\n              exh_subst_vids(named_done, vids, args)\\n            } else {\\n              named_done\\n            }\\n            Array::push(acc, vt)\\n            j = j + 1\\n          }\\n          acc\\n        } else {\\n          ptys\\n        }\\n        Array::push(out, (vn, inst, 0))\\n        i = i + 1\\n      }\\n      (0, out)\\n    },\\n    _ => (2, exh_empty_ctors())\\n  }\\n}\\n\\n// Column classification.\\n// kind 0 = closed universe (ctors listed), kind 1 = open scalar\\n// (Int/Char/String/Double — literals never cover), kind 2 = opaque.\\n// Ctor entry = (name, payload types, ctor kind: 0 enum-like ctor /\\n// 1 tuple / 2 bool literal).\\nfn exh_column_ctors(t: Type, defs: Array[TypeDef]) -> (Int, Array[(String, Array[Type], Int)]) {\\n  match t {\\n    CtBool => (0, [\\n      (\\\"true\\\", exh_empty_tys(), 2),\\n      (\\\"false\\\", exh_empty_tys(), 2)\\n    ]),\\n    CtOption(e) => (0, [\\n      (\\\"Some\\\", [\\n        e\\n      ], 0),\\n      (\\\"None\\\", exh_empty_tys(), 0)\\n    ]),\\n    CtTuple(items) => (0, [\\n      (\\\"\\\", items, 1)\\n    ]),\\n    CtEnum(en) => exh_enum_ctors(en, exh_empty_tys(), defs),\\n    CtNamed(en, args) => exh_enum_ctors(en, args, defs),\\n    CtInt => (1, exh_empty_ctors()),\\n    CtChar => (1, exh_empty_ctors()),\\n    CtString => (1, exh_empty_ctors()),\\n    CtDouble => (1, exh_empty_ctors()),\\n    _ => (2, exh_empty_ctors())\\n  }\\n}\\n\\n// Does this head pattern match ctor `cname` of kind `ckind`? Returns its\\n// sub-patterns when it does (wildcard heads are handled by the caller).\\nfn exh_head_subpats(p: Pat, cname: String, ckind: Int) -> Option[Array[Pat]] {\\n  match p {\\n    PCtor(n, subs) => if ckind == 0 && n == cname {\\n      Some(subs)\\n    } else {\\n      None\\n    },\\n    PTuple(subs) => if ckind == 1 {\\n      Some(subs)\\n    } else {\\n      None\\n    },\\n    PBool(b) => if ckind == 2 {\\n      let bn = if b {\\n        \\\"true\\\"\\n      } else {\\n        \\\"false\\\"\\n      }\\n      if bn == cname {\\n        Some(exh_empty_pats())\\n      } else {\\n        None\\n      }\\n    } else {\\n      None\\n    },\\n    _ => None\\n  }\\n}\\n\\n// Pad / truncate sub-patterns to the ctor's declared arity (arity errors are\\n// reported by check_pattern; here we just stay well-formed).\\nfn exh_pad_subs(subs: Array[Pat], arity: Int) -> Array[Pat] {\\n  let out = exh_empty_pats()\\n  let mut i = 0\\n  while i < arity {\\n    if i < Array::length(subs) {\\n      Array::push(out, Array::get(subs, i))\\n    } else {\\n      Array::push(out, PWild)\\n    }\\n    i = i + 1\\n  }\\n  out\\n}\\n\\n// New row = prefix pats ++ old row's columns 1.. (drop the head).\\nfn exh_row_with_tail(prefix: Array[Pat], row: Array[Pat]) -> Array[Pat] {\\n  let out = exh_empty_pats()\\n  let mut i = 0\\n  while i < Array::length(prefix) {\\n    Array::push(out, Array::get(prefix, i))\\n    i = i + 1\\n  }\\n  let mut j = 1\\n  while j < Array::length(row) {\\n    Array::push(out, Array::get(row, j))\\n    j = j + 1\\n  }\\n  out\\n}\\n\\n// Default matrix D(P): tails of the wildcard-headed rows.\\nfn exh_default_rows(xrows: Array[Array[Pat]]) -> Array[Array[Pat]] {\\n  let out = exh_empty_rows()\\n  let mut i = 0\\n  while i < Array::length(xrows) {\\n    let row = Array::get(xrows, i)\\n    if exh_pat_is_wild(Array::get(row, 0)) {\\n      Array::push(out, exh_row_with_tail(exh_empty_pats(), row))\\n    } else {\\n      ()\\n    }\\n    i = i + 1\\n  }\\n  out\\n}\\n\\n// Tails of ALL rows (used for opaque columns whose heads are all\\n// irrefutable — every head matches, so no row is dropped).\\nfn exh_tail_rows(xrows: Array[Array[Pat]]) -> Array[Array[Pat]] {\\n  let out = exh_empty_rows()\\n  let mut i = 0\\n  while i < Array::length(xrows) {\\n    Array::push(out, exh_row_with_tail(exh_empty_pats(), Array::get(xrows, i)))\\n    i = i + 1\\n  }\\n  out\\n}\\n\\nfn exh_prepend(head: String, rest: Array[String]) -> Array[String] {\\n  let out = exh_empty_strs()\\n  Array::push(out, head)\\n  let mut i = 0\\n  while i < Array::length(rest) {\\n    Array::push(out, Array::get(rest, i))\\n    i = i + 1\\n  }\\n  out\\n}\\n\\nfn exh_join(parts: Array[String], sep: String) -> String {\\n  let mut out = \\\"\\\"\\n  let mut i = 0\\n  while i < Array::length(parts) {\\n    if i > 0 {\\n      out = String::concat(out, sep)\\n    } else {\\n      ()\\n    }\\n    out = String::concat(out, Array::get(parts, i))\\n    i = i + 1\\n  }\\n  out\\n}\\n\\nfn exh_format_ctor(cname: String, ckind: Int, args: Array[String]) -> String {\\n  if ckind == 1 {\\n    String::concat(\\\"(\\\", String::concat(exh_join(args, \\\", \\\"), \\\")\\\"))\\n  } else if Array::length(args) == 0 {\\n    cname\\n  } else {\\n    String::concat(cname, String::concat(\\\"(\\\", String::concat(exh_join(args, \\\", \\\"), \\\")\\\")))\\n  }\\n}\\n\\nfn exh_wild_strs(arity: Int) -> Array[String] {\\n  let out = exh_empty_strs()\\n  let mut i = 0\\n  while i < arity {\\n    Array::push(out, \\\"_\\\")\\n    i = i + 1\\n  }\\n  out\\n}\\n\\n// Usefulness of the all-wildcard row w.r.t. `rows` over column types `tys`.\\n// Some(witness-per-column) = an uncovered value shape exists (non-exhaustive);\\n// None = covered (or the check abstained / ran out of budget).\\nfn exh_find(rows: Array[Array[Pat]], tys: Array[Type], defs: Array[TypeDef], budget: Array[Int]) -> Option[Array[String]] {\\n  let ncols = Array::length(tys)\\n  if ncols == 0 {\\n    if Array::length(rows) == 0 {\\n      Some(exh_empty_strs())\\n    } else {\\n      None\\n    }\\n  } else {\\n    let cost = Array::length(rows) * ncols + 1\\n    let remaining = Array::get(budget, 0)\\n    if remaining < cost {\\n      None\\n    } else {\\n      Array::set(budget, 0, remaining - cost)\\n      let xrows = exh_empty_rows()\\n      let mut ri = 0\\n      while ri < Array::length(rows) {\\n        let row = Array::get(rows, ri)\\n        let heads = exh_empty_pats()\\n        exh_flatten_or(Array::get(row, 0), heads)\\n        let mut hi = 0\\n        while hi < Array::length(heads) {\\n          let pref = exh_empty_pats()\\n          Array::push(pref, Array::get(heads, hi))\\n          Array::push(xrows, exh_row_with_tail(pref, row))\\n          hi = hi + 1\\n        }\\n        ri = ri + 1\\n      }\\n      let rest_tys = Array::slice(tys, 1, ncols)\\n      let (kind, ctors) = exh_column_ctors(Array::get(tys, 0), defs)\\n      if kind == 0 {\\n        // Head ctor names actually used in this column.\\n        let used = exh_empty_strs()\\n        let mut ui = 0\\n        while ui < Array::length(xrows) {\\n          match Array::get(Array::get(xrows, ui), 0) {\\n            PCtor(n, _) => Array::push(used, n),\\n            PBool(b) => if b {\\n              Array::push(used, \\\"true\\\")\\n            } else {\\n              Array::push(used, \\\"false\\\")\\n            },\\n            PTuple(_) => Array::push(used, \\\"\\\"),\\n            _ => ()\\n          }\\n          ui = ui + 1\\n        }\\n        let mut complete = true\\n        let mut ki = 0\\n        while ki < Array::length(ctors) {\\n          let (cn0, _, _) = Array::get(ctors, ki)\\n          if !exh_names_contain(used, cn0) {\\n            complete = false\\n          } else {\\n            ()\\n          }\\n          ki = ki + 1\\n        }\\n        if complete {\\n          // Complete signature: specialize on every ctor; the first one with\\n          // an uncovered sub-shape yields the witness.\\n          let mut result: Option[Array[String]] = None\\n          let mut done = false\\n          let mut ci = 0\\n          while ci < Array::length(ctors) && !done {\\n            let (cn, ptys, ck) = Array::get(ctors, ci)\\n            let arity = Array::length(ptys)\\n            let srows = exh_empty_rows()\\n            let mut si = 0\\n            while si < Array::length(xrows) {\\n              let srow = Array::get(xrows, si)\\n              let head = Array::get(srow, 0)\\n              if exh_pat_is_wild(head) {\\n                Array::push(srows, exh_row_with_tail(exh_pad_subs(exh_empty_pats(), arity), srow))\\n              } else {\\n                match exh_head_subpats(head, cn, ck) {\\n                  Some(subs) => Array::push(srows, exh_row_with_tail(exh_pad_subs(subs, arity), srow)),\\n                  None => ()\\n                }\\n              }\\n              si = si + 1\\n            }\\n            let stys = exh_empty_tys()\\n            let mut ti = 0\\n            while ti < arity {\\n              Array::push(stys, Array::get(ptys, ti))\\n              ti = ti + 1\\n            }\\n            let mut ti2 = 0\\n            while ti2 < Array::length(rest_tys) {\\n              Array::push(stys, Array::get(rest_tys, ti2))\\n              ti2 = ti2 + 1\\n            }\\n            match exh_find(srows, stys, defs, budget) {\\n              Some(w) => {\\n                let args = Array::slice(w, 0, arity)\\n                let restw = Array::slice(w, arity, Array::length(w))\\n                result = Some(exh_prepend(exh_format_ctor(cn, ck, args), restw))\\n                done = true\\n              },\\n              None => ()\\n            }\\n            ci = ci + 1\\n          }\\n          result\\n        } else {\\n          // Incomplete signature: a missing ctor is the witness head when the\\n          // tails are (or become) uncovered.\\n          match exh_find(exh_default_rows(xrows), rest_tys, defs, budget) {\\n            Some(w) => {\\n              let mut head_str = \\\"_\\\"\\n              let mut found_missing = false\\n              let mut mi = 0\\n              while mi < Array::length(ctors) && !found_missing {\\n                let (mn, mptys, mk) = Array::get(ctors, mi)\\n                if !exh_names_contain(used, mn) {\\n                  head_str = exh_format_ctor(mn, mk, exh_wild_strs(Array::length(mptys)))\\n                  found_missing = true\\n                } else {\\n                  mi = mi + 1\\n                }\\n              }\\n              Some(exh_prepend(head_str, w))\\n            },\\n            None => None\\n          }\\n        }\\n      } else if kind == 1 {\\n        // Open scalar: literal heads never complete the column, so only the\\n        // wildcard-headed rows can cover the rest.\\n        match exh_find(exh_default_rows(xrows), rest_tys, defs, budget) {\\n          Some(w) => Some(exh_prepend(\\\"_\\\", w)),\\n          None => None\\n        }\\n      } else {\\n        // Opaque: safe only when every head always matches; a refutable head\\n        // over a type we cannot enumerate makes the whole check abstain.\\n        let mut all_irr = true\\n        let mut oi = 0\\n        while oi < Array::length(xrows) {\\n          if !exh_pat_irrefutable(Array::get(Array::get(xrows, oi), 0)) {\\n            all_irr = false\\n          } else {\\n            ()\\n          }\\n          oi = oi + 1\\n        }\\n        if all_irr {\\n          match exh_find(exh_tail_rows(xrows), rest_tys, defs, budget) {\\n            Some(w) => Some(exh_prepend(\\\"_\\\", w)),\\n            None => None\\n          }\\n        } else {\\n          None\\n        }\\n      }\\n    }\\n  }\\n}\\n\\n// #940 Phase 2 entry. Some(witness) = the arms do not cover every value of\\n// `scr_ty` and `witness` is one uncovered pattern; None = covered, or the\\n// check abstained (catch-all arm / non-ground scrutinee / budget).\\nexport fn match_nonexhaustive_witness(scr_ty: Type, pats: Array[Pat], defs: Array[TypeDef]) -> Option[String] {\\n  let mut has_catchall = false\\n  let mut i = 0\\n  while i < Array::length(pats) {\\n    if exh_pat_catchall(Array::get(pats, i)) {\\n      has_catchall = true\\n    } else {\\n      ()\\n    }\\n    i = i + 1\\n  }\\n  if has_catchall {\\n    None\\n  } else if !exh_type_ground(scr_ty, defs) {\\n    None\\n  } else {\\n    let rows = exh_empty_rows()\\n    let mut j = 0\\n    while j < Array::length(pats) {\\n      let row = exh_empty_pats()\\n      Array::push(row, Array::get(pats, j))\\n      Array::push(rows, row)\\n      j = j + 1\\n    }\\n    let budget = [\\n      4096\\n    ]\\n    match exh_find(rows, [\\n      scr_ty\\n    ], defs, budget) {\\n      Some(w) => if Array::length(w) > 0 {\\n        Some(Array::get(w, 0))\\n      } else {\\n        None\\n      },\\n      None => None\\n    }\\n  }\\n}\\n\")\n}\n\nlet cli_adapter_source_44 = () -> (String, String) {\n  (\"lib/@vibe/compiler/checker_trait.vibe\",\n\"//# Imports\\n\\nimport ./types.vibe {\\n  Subst, Type, TypeEnv, impls_overlap_for, trait_defined, type_implements_trait\\n}\\n\\nimport ./core {\\n  TypeExpr\\n}\\n\\n//# Functions\\n\\nfn one_super(name: String) -> Array[String] {\\n  [\\n    name\\n  ]\\n}\\n\\nfn no_trait_methods() -> Array[(String, Array[TypeExpr], TypeExpr)] {\\n  ArrayBuilder::freeze(ArrayBuilder::new())\\n}\\n\\nfn no_type_args() -> Array[Type] {\\n  Array::slice([\\n    CtUnknown\\n  ], 0, 0)\\n}\\n\\nfn empty_strings() -> Array[String] {\\n  Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n}\\n\\nexport fn satisfies_bound(env: TypeEnv, s: Subst, ty: Type, bound: String) -> Bool {\\n  type_implements_trait(env, s, ty, bound)\\n}\\n\\nexport fn check_bounds_satisfied(env: TypeEnv, s: Subst, ty: Type, bounds: Array[String]) -> Array[String] {\\n  let result = empty_strings()\\n  let len = Array::length(bounds)\\n  let rec go: (Int) -> Int = (i) -> {\\n    if i >= len {\\n      0\\n    } else {\\n      let bound = Array::get(bounds, i)\\n      if not(satisfies_bound(env, s, ty, bound)) {\\n        Array::push(result, bound)\\n      }\\n      go(i + 1)\\n    }\\n  }\\n  let _ = go(0)\\n  result\\n}\\n\\nexport fn register_builtin_traits(env: TypeEnv) -> TypeEnv {\\n  let no_supers = empty_strings()\\n  let eq_supers = one_super(\\\"Eq\\\")\\n  let i64_type = CtNamed(\\\"i64\\\", no_type_args())\\n  let u8_type = CtNamed(\\\"u8\\\", no_type_args())\\n  let u16_type = CtNamed(\\\"u16\\\", no_type_args())\\n  let u32_type = CtNamed(\\\"u32\\\", no_type_args())\\n  let u64_type = CtNamed(\\\"u64\\\", no_type_args())\\n  let i16_type = CtNamed(\\\"i16\\\", no_type_args())\\n  let nm = no_trait_methods()\\n  let e1 = EnvTraitDef(\\\"Eq\\\", no_supers, false, nm, env)\\n  let e2 = EnvTraitDef(\\\"Ord\\\", eq_supers, false, nm, e1)\\n  let e3 = EnvTraitDef(\\\"Add\\\", no_supers, false, nm, e2)\\n  let e4 = EnvTraitDef(\\\"Sub\\\", no_supers, false, nm, e3)\\n  let e5 = EnvTraitDef(\\\"Mul\\\", no_supers, false, nm, e4)\\n  let e6 = EnvTraitDef(\\\"Div\\\", no_supers, false, nm, e5)\\n  let e7 = EnvTraitImpl(\\\"Eq\\\", CtInt, e6)\\n  let e8 = EnvTraitImpl(\\\"Eq\\\", CtDouble, e7)\\n  let e9 = EnvTraitImpl(\\\"Eq\\\", CtString, e8)\\n  let e10 = EnvTraitImpl(\\\"Eq\\\", CtBool, e9)\\n  let e11 = EnvTraitImpl(\\\"Ord\\\", CtInt, e10)\\n  let e12 = EnvTraitImpl(\\\"Ord\\\", CtDouble, e11)\\n  let e13 = EnvTraitImpl(\\\"Ord\\\", CtString, e12)\\n  let e14 = EnvTraitImpl(\\\"Add\\\", CtInt, e13)\\n  let e15 = EnvTraitImpl(\\\"Add\\\", CtDouble, e14)\\n  let e16 = EnvTraitImpl(\\\"Sub\\\", CtInt, e15)\\n  let e17 = EnvTraitImpl(\\\"Sub\\\", CtDouble, e16)\\n  let e18 = EnvTraitImpl(\\\"Mul\\\", CtInt, e17)\\n  let e19 = EnvTraitImpl(\\\"Mul\\\", CtDouble, e18)\\n  let e20 = EnvTraitImpl(\\\"Div\\\", CtInt, e19)\\n  let e21 = EnvTraitImpl(\\\"Div\\\", CtDouble, e20)\\n  let e22 = EnvTraitImpl(\\\"Eq\\\", i64_type, e21)\\n  let e23 = EnvTraitImpl(\\\"Eq\\\", u8_type, e22)\\n  let e24 = EnvTraitImpl(\\\"Eq\\\", u16_type, e23)\\n  let e25 = EnvTraitImpl(\\\"Eq\\\", u32_type, e24)\\n  let e26 = EnvTraitImpl(\\\"Eq\\\", u64_type, e25)\\n  let e27 = EnvTraitImpl(\\\"Eq\\\", i16_type, e26)\\n  let e28 = EnvTraitImpl(\\\"Ord\\\", i64_type, e27)\\n  let e29 = EnvTraitImpl(\\\"Ord\\\", u8_type, e28)\\n  let e30 = EnvTraitImpl(\\\"Ord\\\", u16_type, e29)\\n  let e31 = EnvTraitImpl(\\\"Ord\\\", u32_type, e30)\\n  let e32 = EnvTraitImpl(\\\"Ord\\\", u64_type, e31)\\n  let e33 = EnvTraitImpl(\\\"Ord\\\", i16_type, e32)\\n  let e34 = EnvTraitImpl(\\\"Add\\\", i64_type, e33)\\n  let e35 = EnvTraitImpl(\\\"Add\\\", u8_type, e34)\\n  let e36 = EnvTraitImpl(\\\"Add\\\", u16_type, e35)\\n  let e37 = EnvTraitImpl(\\\"Add\\\", u32_type, e36)\\n  let e38 = EnvTraitImpl(\\\"Add\\\", u64_type, e37)\\n  let e39 = EnvTraitImpl(\\\"Add\\\", i16_type, e38)\\n  let e40 = EnvTraitImpl(\\\"Sub\\\", i64_type, e39)\\n  let e41 = EnvTraitImpl(\\\"Sub\\\", u8_type, e40)\\n  let e42 = EnvTraitImpl(\\\"Sub\\\", u16_type, e41)\\n  let e43 = EnvTraitImpl(\\\"Sub\\\", u32_type, e42)\\n  let e44 = EnvTraitImpl(\\\"Sub\\\", u64_type, e43)\\n  let e45 = EnvTraitImpl(\\\"Sub\\\", i16_type, e44)\\n  let e46 = EnvTraitImpl(\\\"Mul\\\", i64_type, e45)\\n  let e47 = EnvTraitImpl(\\\"Mul\\\", u8_type, e46)\\n  let e48 = EnvTraitImpl(\\\"Mul\\\", u16_type, e47)\\n  let e49 = EnvTraitImpl(\\\"Mul\\\", u32_type, e48)\\n  let e50 = EnvTraitImpl(\\\"Mul\\\", u64_type, e49)\\n  let e51 = EnvTraitImpl(\\\"Mul\\\", i16_type, e50)\\n  let e52 = EnvTraitImpl(\\\"Div\\\", i64_type, e51)\\n  let e53 = EnvTraitImpl(\\\"Div\\\", u8_type, e52)\\n  let e54 = EnvTraitImpl(\\\"Div\\\", u16_type, e53)\\n  let e55 = EnvTraitImpl(\\\"Div\\\", u32_type, e54)\\n  let e56 = EnvTraitImpl(\\\"Div\\\", u64_type, e55)\\n  let e57 = EnvTraitImpl(\\\"Div\\\", i16_type, e56)\\n  e57\\n}\\n\\nexport fn validate_supers_defined(env: TypeEnv, supers: Array[String]) -> Array[String] {\\n  let result = empty_strings()\\n  let len = Array::length(supers)\\n  let rec go: (Int) -> Int = (i) -> {\\n    if i >= len {\\n      0\\n    } else {\\n      let name = Array::get(supers, i)\\n      if not(trait_defined(env, name)) {\\n        Array::push(result, name)\\n      }\\n      go(i + 1)\\n    }\\n  }\\n  let _ = go(0)\\n  result\\n}\\n\\nexport fn validate_impl_no_overlap(env: TypeEnv, trait_name: String, target: Type) -> Bool {\\n  not(impls_overlap_for(env, trait_name, target))\\n}\\n\")\n}\n\nlet cli_adapter_source_45 = () -> (String, String) {\n  (\"lib/@vibe/compiler/checker_effects.vibe\",\n\"//# Imports\\n\\nimport ./core {\\n  Expr,\\n  Pat,\\n  Stmt,\\n  TypeExpr\\n}\\n\\nimport ./builtin_name.vibe {\\n  canonical_builtin_name\\n}\\n\\n// #847 Phase C exception: this is a permanent, structural exception, not\\n// just a risk-avoidance choice. `checker/checker_stmt.vibe` imports this\\n// file, and `checker/index.vibe` re-exports `checker_stmt.vibe`'s surface —\\n// so routing this import through `checker/index.vibe` would close a real\\n// cycle: checker/index.vibe -> checker_stmt.vibe -> checker_effects.vibe ->\\n// checker/index.vibe. Must stay a direct leaf import.\\nimport ./checker/builtins.vibe {\\n  lookup_builtin\\n}\\n\\nimport ./types.vibe {\\n  Type, TypeEnv, env_lookup\\n}\\n\\n//# Types\\n\\nexport enum EffectError {\\n  EEThrowOutsideEffect(String);\\n  EEEffectfulCallOutsideEffect(String);\\n  EEPerformUndeclaredEffect(String, String);\\n  // #639: effect-row mismatch with the EXPECTED vs ACTUAL rows rendered as a\\n  // set difference plus a fix-it hint for the `with { ... }` annotation.\\n  // Fields (all pre-rendered \\\", \\\"-joined label lists, deterministic order):\\n  // (enclosing fn name or \\\"\\\" when unnamed, missing labels (sorted),\\n  //  declared row (source order, \\\"\\\" when no row), required row (sorted union)).\\n  EEEffectRowMismatch(String, String, String, String);\\n  EEAssignImmutable(String)\\n}\\n\\n//# Functions\\n\\nfn is_effectful_type(ty: Type) -> Bool {\\n  match ty {\\n    CtFn(_, _, Some(_)) => true,\\n    _ => false\\n  }\\n}\\n\\nfn is_effectful_name(name: String, env: TypeEnv) -> Bool {\\n  match env_lookup(env, name) {\\n    Some(ty) => is_effectful_type(ty),\\n    None => {\\n      let normalized = canonical_builtin_name(name)\\n      match lookup_builtin(normalized) {\\n        Some(ty) => is_effectful_type(ty),\\n        None => false\\n      }\\n    }\\n  }\\n}\\n\\nexport fn check_effects_expr(expr: Expr, env: TypeEnv, in_effect: Bool) -> Array[EffectError] {\\n  let errors = Array::slice([\\n    EEThrowOutsideEffect(\\\"\\\")\\n  ], 0, 0)\\n  match expr {\\n    EHandle(body, arms) => {\\n      let body_errs = check_effects_expr(body, env, true)\\n      let mut i = 0\\n      while i < Array::length(body_errs) {\\n        Array::push(errors, Array::get(body_errs, i))\\n        i = i + 1\\n      }\\n      let mut ai = 0\\n      while ai < Array::length(arms) {\\n        let (_, arm_body) = Array::get(arms, ai)\\n        let arm_errs = check_effects_expr(arm_body, env, in_effect)\\n        let mut j = 0\\n        while j < Array::length(arm_errs) {\\n          Array::push(errors, Array::get(arm_errs, j))\\n          j = j + 1\\n        }\\n        ai = ai + 1\\n      }\\n      errors\\n    },\\n    ECall(callee, args, _) => {\\n      match callee {\\n        EIdent(name, _) => if !in_effect && is_effectful_name(name, env) {\\n          Array::push(errors, EEEffectfulCallOutsideEffect(name))\\n        }\\n        ,\\n        _ => ()\\n      }\\n      let ce = check_effects_expr(callee, env, in_effect)\\n      let mut i = 0\\n      while i < Array::length(ce) {\\n        Array::push(errors, Array::get(ce, i))\\n        i = i + 1\\n      }\\n      let mut ai = 0\\n      while ai < Array::length(args) {\\n        let ae = check_effects_expr(Array::get(args, ai), env, in_effect)\\n        let mut j = 0\\n        while j < Array::length(ae) {\\n          Array::push(errors, Array::get(ae, j))\\n          j = j + 1\\n        }\\n        ai = ai + 1\\n      }\\n      errors\\n    },\\n    EFn(_, _, _, _, effect, body) => {\\n      let fn_in_effect = match effect {\\n        Some(_) => true,\\n        None => false\\n      }\\n      let body_errs = check_effects_expr(body, env, fn_in_effect)\\n      let mut i = 0\\n      while i < Array::length(body_errs) {\\n        Array::push(errors, Array::get(body_errs, i))\\n        i = i + 1\\n      }\\n      errors\\n    },\\n    ELet(_, val, body, _) => {\\n      let ve = check_effects_expr(val, env, in_effect)\\n      let be = check_effects_expr(body, env, in_effect)\\n      let mut i = 0\\n      while i < Array::length(ve) {\\n        Array::push(errors, Array::get(ve, i))\\n        i = i + 1\\n      }\\n      i = 0\\n      while i < Array::length(be) {\\n        Array::push(errors, Array::get(be, i))\\n        i = i + 1\\n      }\\n      errors\\n    },\\n    ELetRec(_, val, body) => {\\n      let ve = check_effects_expr(val, env, in_effect)\\n      let be = check_effects_expr(body, env, in_effect)\\n      let mut i = 0\\n      while i < Array::length(ve) {\\n        Array::push(errors, Array::get(ve, i))\\n        i = i + 1\\n      }\\n      i = 0\\n      while i < Array::length(be) {\\n        Array::push(errors, Array::get(be, i))\\n        i = i + 1\\n      }\\n      errors\\n    },\\n    ELetMut(_, val, body, _) => {\\n      let ve = check_effects_expr(val, env, in_effect)\\n      let be = check_effects_expr(body, env, in_effect)\\n      let mut i = 0\\n      while i < Array::length(ve) {\\n        Array::push(errors, Array::get(ve, i))\\n        i = i + 1\\n      }\\n      i = 0\\n      while i < Array::length(be) {\\n        Array::push(errors, Array::get(be, i))\\n        i = i + 1\\n      }\\n      errors\\n    },\\n    ESeq(a, b) => {\\n      let ae = check_effects_expr(a, env, in_effect)\\n      let be = check_effects_expr(b, env, in_effect)\\n      let mut i = 0\\n      while i < Array::length(ae) {\\n        Array::push(errors, Array::get(ae, i))\\n        i = i + 1\\n      }\\n      i = 0\\n      while i < Array::length(be) {\\n        Array::push(errors, Array::get(be, i))\\n        i = i + 1\\n      }\\n      errors\\n    },\\n    EIf(cond, then_e, else_e) => {\\n      let ce = check_effects_expr(cond, env, in_effect)\\n      let te = check_effects_expr(then_e, env, in_effect)\\n      let ee = check_effects_expr(else_e, env, in_effect)\\n      let mut i = 0\\n      while i < Array::length(ce) {\\n        Array::push(errors, Array::get(ce, i))\\n        i = i + 1\\n      }\\n      i = 0\\n      while i < Array::length(te) {\\n        Array::push(errors, Array::get(te, i))\\n        i = i + 1\\n      }\\n      i = 0\\n      while i < Array::length(ee) {\\n        Array::push(errors, Array::get(ee, i))\\n        i = i + 1\\n      }\\n      errors\\n    },\\n    EMatch(scrutinee, arms) => {\\n      let se = check_effects_expr(scrutinee, env, in_effect)\\n      let mut i = 0\\n      while i < Array::length(se) {\\n        Array::push(errors, Array::get(se, i))\\n        i = i + 1\\n      }\\n      let mut ai = 0\\n      while ai < Array::length(arms) {\\n        let (_, arm_body) = Array::get(arms, ai)\\n        let ae = check_effects_expr(arm_body, env, in_effect)\\n        let mut j = 0\\n        while j < Array::length(ae) {\\n          Array::push(errors, Array::get(ae, j))\\n          j = j + 1\\n        }\\n        ai = ai + 1\\n      }\\n      errors\\n    },\\n    EWhile(cond, body) => {\\n      let ce = check_effects_expr(cond, env, in_effect)\\n      let be = check_effects_expr(body, env, in_effect)\\n      let mut i = 0\\n      while i < Array::length(ce) {\\n        Array::push(errors, Array::get(ce, i))\\n        i = i + 1\\n      }\\n      i = 0\\n      while i < Array::length(be) {\\n        Array::push(errors, Array::get(be, i))\\n        i = i + 1\\n      }\\n      errors\\n    },\\n    ELoop(params, body) => {\\n      let mut i = 0\\n      while i < Array::length(params) {\\n        let (_, init) = Array::get(params, i)\\n        let pe = check_effects_expr(init, env, in_effect)\\n        let mut j = 0\\n        while j < Array::length(pe) {\\n          Array::push(errors, Array::get(pe, j))\\n          j = j + 1\\n        }\\n        i = i + 1\\n      }\\n      let be = check_effects_expr(body, env, in_effect)\\n      i = 0\\n      while i < Array::length(be) {\\n        Array::push(errors, Array::get(be, i))\\n        i = i + 1\\n      }\\n      errors\\n    },\\n    EForIn(_, _, iter, body) => {\\n      let ie = check_effects_expr(iter, env, in_effect)\\n      let be = check_effects_expr(body, env, in_effect)\\n      let mut i = 0\\n      while i < Array::length(ie) {\\n        Array::push(errors, Array::get(ie, i))\\n        i = i + 1\\n      }\\n      i = 0\\n      while i < Array::length(be) {\\n        Array::push(errors, Array::get(be, i))\\n        i = i + 1\\n      }\\n      errors\\n    },\\n    EBinOp(_, left, right) => {\\n      let le = check_effects_expr(left, env, in_effect)\\n      let re = check_effects_expr(right, env, in_effect)\\n      let mut i = 0\\n      while i < Array::length(le) {\\n        Array::push(errors, Array::get(le, i))\\n        i = i + 1\\n      }\\n      i = 0\\n      while i < Array::length(re) {\\n        Array::push(errors, Array::get(re, i))\\n        i = i + 1\\n      }\\n      errors\\n    },\\n    EReturn(e) => check_effects_expr(e, env, in_effect),\\n    EUnaryOp(_, operand) => check_effects_expr(operand, env, in_effect),\\n    EAssign(_, val, cont) => {\\n      let ve = check_effects_expr(val, env, in_effect)\\n      let ce = check_effects_expr(cont, env, in_effect)\\n      let mut i = 0\\n      while i < Array::length(ve) {\\n        Array::push(errors, Array::get(ve, i))\\n        i = i + 1\\n      }\\n      i = 0\\n      while i < Array::length(ce) {\\n        Array::push(errors, Array::get(ce, i))\\n        i = i + 1\\n      }\\n      errors\\n    },\\n    EAssignOp(_, _, val, cont) => {\\n      let ve = check_effects_expr(val, env, in_effect)\\n      let ce = check_effects_expr(cont, env, in_effect)\\n      let mut i = 0\\n      while i < Array::length(ve) {\\n        Array::push(errors, Array::get(ve, i))\\n        i = i + 1\\n      }\\n      i = 0\\n      while i < Array::length(ce) {\\n        Array::push(errors, Array::get(ce, i))\\n        i = i + 1\\n      }\\n      errors\\n    },\\n    EDot(obj, _, _, _) => check_effects_expr(obj, env, in_effect),\\n    ETuple(elems) => {\\n      let mut ei = 0\\n      while ei < Array::length(elems) {\\n        let ee = check_effects_expr(Array::get(elems, ei), env, in_effect)\\n        let mut j = 0\\n        while j < Array::length(ee) {\\n          Array::push(errors, Array::get(ee, j))\\n          j = j + 1\\n        }\\n        ei = ei + 1\\n      }\\n      errors\\n    },\\n    EArray(elems) => {\\n      let mut ei = 0\\n      while ei < Array::length(elems) {\\n        let ee = check_effects_expr(Array::get(elems, ei), env, in_effect)\\n        let mut j = 0\\n        while j < Array::length(ee) {\\n          Array::push(errors, Array::get(ee, j))\\n          j = j + 1\\n        }\\n        ei = ei + 1\\n      }\\n      errors\\n    },\\n    ERecord(_, fields, _) => {\\n      let mut fi = 0\\n      while fi < Array::length(fields) {\\n        let (_, fval) = Array::get(fields, fi)\\n        let fe = check_effects_expr(fval, env, in_effect)\\n        let mut j = 0\\n        while j < Array::length(fe) {\\n          Array::push(errors, Array::get(fe, j))\\n          j = j + 1\\n        }\\n        fi = fi + 1\\n      }\\n      errors\\n    },\\n    _ => errors\\n  }\\n}\\n\\nexport fn check_effects_stmt(stmt: Stmt, env: TypeEnv) -> Array[EffectError] {\\n  match stmt {\\n    SLet(_, _, _, _, body) => check_effects_expr(body, env, false),\\n    SLetMut(_, _, body) => check_effects_expr(body, env, false),\\n    STest(_, body) => check_effects_expr(body, env, false),\\n    SBench(_, body) => check_effects_expr(body, env, false),\\n    SExpr(e) => check_effects_expr(e, env, false),\\n    _ => Array::slice([\\n      EEThrowOutsideEffect(\\\"\\\")\\n    ], 0, 0)\\n  }\\n}\\n\\nexport fn check_effects_stmts(stmts: Array[Stmt], env: TypeEnv) -> Array[EffectError] {\\n  let errors = Array::slice([\\n    EEThrowOutsideEffect(\\\"\\\")\\n  ], 0, 0)\\n  let mut i = 0\\n  while i < Array::length(stmts) {\\n    let se = check_effects_stmt(Array::get(stmts, i), env)\\n    let mut j = 0\\n    while j < Array::length(se) {\\n      Array::push(errors, Array::get(se, j))\\n      j = j + 1\\n    }\\n    i = i + 1\\n  }\\n  errors\\n}\\n\\nexport fn effect_error_to_string(err: EffectError) -> String {\\n  match err {\\n    EEThrowOutsideEffect(msg) => String::concat(\\\"throw outside effectful context: \\\", msg),\\n    EEEffectfulCallOutsideEffect(name) => String::concat(\\\"effectful call outside effectful context: \\\", name),\\n    EEPerformUndeclaredEffect(op, eff) => String::concat(\\\"use of undeclared effect `\\\", String::concat(eff, String::concat(\\\"` (\\\", String::concat(op, \\\"); add it to the function's `with { ... }` or wrap in a `handle`\\\")))),\\n    // #639: expected-vs-actual effect rows as a set difference, then ONE\\n    // deterministic fix-it hint line targeting the enclosing declaration\\n    // (for a call-site leak that is the CALLER, not the callee).\\n    EEEffectRowMismatch(fname, missing, declared, required) => {\\n      let head = if String::length(fname) > 0 {\\n        String::concat(\\\"effect row mismatch for '\\\", String::concat(fname, \\\"'\\\"))\\n      } else {\\n        \\\"effect row mismatch\\\"\\n      }\\n      let detail = if String::length(declared) > 0 {\\n        String::concat(\\\" (declared with { \\\", String::concat(declared, String::concat(\\\" }, requires { \\\", String::concat(required, \\\" })\\\"))))\\n      } else {\\n        String::concat(\\\" (no 'with' clause, requires { \\\", String::concat(required, \\\" })\\\"))\\n      }\\n      let hint = if String::length(fname) == 0 {\\n        String::concat(\\\"\\\\nhint: add 'with { \\\", String::concat(required, \\\" }' to the enclosing function\\\"))\\n      } else if String::length(declared) == 0 {\\n        String::concat(\\\"\\\\nhint: declare 'fn \\\", String::concat(fname, String::concat(\\\"(...) -> T with { \\\", String::concat(required, \\\" }'\\\"))))\\n      } else {\\n        String::concat(\\\"\\\\nhint: add 'with { \\\", String::concat(required, String::concat(\\\" }' to '\\\", String::concat(fname, \\\"'\\\"))))\\n      }\\n      String::concat(head, String::concat(\\\": missing { \\\", String::concat(missing, String::concat(\\\" }\\\", String::concat(detail, hint)))))\\n    },\\n    EEAssignImmutable(name) => String::concat(\\\"cannot assign to immutable binding `\\\", String::concat(name, \\\"` (declare it with `let mut`)\\\"))\\n  }\\n}\\n\\n//# Async-scoped effect enforcement (the pass wired into `check_program`)\\n//\\n// The general `check_effects_expr` above treats every effect identically and is\\n// far too strict to enable across the un-annotated selfhost source (441 `throw`\\n// sites alone would fail). This pass enforces ONLY the `Async` effect, and only\\n// for async PRIMITIVES — the builtins `await(..)` / `sleep(..)` / `Stream::next`\\n// whose type carries `with { Async }`, including the `await(..)` the `for await`\\n// desugar injects over a Future-returning iterator. A primitive must appear\\n// inside a function/lambda annotated `with { Async }`.\\n//\\n// Crucially it does NOT propagate to user functions that merely COMPOSE async\\n// work: calling a `with { Async }` helper (e.g. `async_iter_collect`) from a\\n// sync context is allowed (await is the identity on the synchronous backend,\\n// and on a real async backend the value/Future mismatch is a separate type\\n// error). Only env-absent BUILTIN primitives are checked, so the compiler /\\n// prelude — which use `Async` only in the disciplined async_iter terminals —\\n// stay green while `for await` over an async stream becomes sound (#2+#3).\\n\\nfn effect_opt_is_async(eff: Option[String]) -> Bool {\\n  match eff {\\n    Some(s) => String::contains(s, \\\"Async\\\"),\\n    None => false\\n  }\\n}\\n\\n// True only for async-effect BUILTIN primitives (await/sleep/Stream::next/...).\\n// A name bound in `env` (a user/prelude function) is intentionally NOT treated\\n// as a primitive even if its type is `with { Async }`.\\nfn is_async_primitive(name: String, env: TypeEnv) -> Bool {\\n  match env_lookup(env, name) {\\n    Some(_) => false,\\n    None => {\\n      let normalized = canonical_builtin_name(name)\\n      match lookup_builtin(normalized) {\\n        Some(ty) => match ty {\\n          CtFn(_, _, eff) => effect_opt_is_async(eff),\\n          _ => false\\n        },\\n        None => false\\n      }\\n    }\\n  }\\n}\\n\\nfn append_eff_errs(dst: Array[EffectError], src: Array[EffectError]) -> Unit {\\n  let mut i = 0\\n  while i < Array::length(src) {\\n    Array::push(dst, Array::get(src, i))\\n    i = i + 1\\n  }\\n}\\n\\nexport fn check_async_effects_expr(expr: Expr, env: TypeEnv, in_async: Bool) -> Array[EffectError] {\\n  let errors = Array::slice([\\n    EEThrowOutsideEffect(\\\"\\\")\\n  ], 0, 0)\\n  match expr {\\n    ECall(callee, args, _) => {\\n      match callee {\\n        EIdent(name, _) => if !in_async && is_async_primitive(name, env) {\\n          Array::push(errors, EEEffectfulCallOutsideEffect(name))\\n        }\\n        ,\\n        _ => ()\\n      }\\n      append_eff_errs(errors, check_async_effects_expr(callee, env, in_async))\\n      let mut ai = 0\\n      while ai < Array::length(args) {\\n        append_eff_errs(errors, check_async_effects_expr(Array::get(args, ai), env, in_async))\\n        ai = ai + 1\\n      }\\n      errors\\n    },\\n    EFn(_, _, _, _, effect, body) => {\\n      append_eff_errs(errors, check_async_effects_expr(body, env, effect_opt_is_async(effect)))\\n      errors\\n    },\\n    EHandle(body, arms) => {\\n      append_eff_errs(errors, check_async_effects_expr(body, env, in_async))\\n      let mut ai = 0\\n      while ai < Array::length(arms) {\\n        let (_, arm_body) = Array::get(arms, ai)\\n        append_eff_errs(errors, check_async_effects_expr(arm_body, env, in_async))\\n        ai = ai + 1\\n      }\\n      errors\\n    },\\n    ELet(_, val, body, _) => {\\n      append_eff_errs(errors, check_async_effects_expr(val, env, in_async))\\n      append_eff_errs(errors, check_async_effects_expr(body, env, in_async))\\n      errors\\n    },\\n    ELetRec(_, val, body) => {\\n      append_eff_errs(errors, check_async_effects_expr(val, env, in_async))\\n      append_eff_errs(errors, check_async_effects_expr(body, env, in_async))\\n      errors\\n    },\\n    ELetMut(_, val, body, _) => {\\n      append_eff_errs(errors, check_async_effects_expr(val, env, in_async))\\n      append_eff_errs(errors, check_async_effects_expr(body, env, in_async))\\n      errors\\n    },\\n    ESeq(a, b) => {\\n      append_eff_errs(errors, check_async_effects_expr(a, env, in_async))\\n      append_eff_errs(errors, check_async_effects_expr(b, env, in_async))\\n      errors\\n    },\\n    EIf(cond, then_e, else_e) => {\\n      append_eff_errs(errors, check_async_effects_expr(cond, env, in_async))\\n      append_eff_errs(errors, check_async_effects_expr(then_e, env, in_async))\\n      append_eff_errs(errors, check_async_effects_expr(else_e, env, in_async))\\n      errors\\n    },\\n    EMatch(scrutinee, arms) => {\\n      append_eff_errs(errors, check_async_effects_expr(scrutinee, env, in_async))\\n      let mut ai = 0\\n      while ai < Array::length(arms) {\\n        let (_, arm_body) = Array::get(arms, ai)\\n        append_eff_errs(errors, check_async_effects_expr(arm_body, env, in_async))\\n        ai = ai + 1\\n      }\\n      errors\\n    },\\n    EWhile(cond, body) => {\\n      append_eff_errs(errors, check_async_effects_expr(cond, env, in_async))\\n      append_eff_errs(errors, check_async_effects_expr(body, env, in_async))\\n      errors\\n    },\\n    ELoop(params, body) => {\\n      let mut i = 0\\n      while i < Array::length(params) {\\n        let (_, init) = Array::get(params, i)\\n        append_eff_errs(errors, check_async_effects_expr(init, env, in_async))\\n        i = i + 1\\n      }\\n      append_eff_errs(errors, check_async_effects_expr(body, env, in_async))\\n      errors\\n    },\\n    EForIn(_, _, iter, body) => {\\n      append_eff_errs(errors, check_async_effects_expr(iter, env, in_async))\\n      append_eff_errs(errors, check_async_effects_expr(body, env, in_async))\\n      errors\\n    },\\n    EBinOp(_, left, right) => {\\n      append_eff_errs(errors, check_async_effects_expr(left, env, in_async))\\n      append_eff_errs(errors, check_async_effects_expr(right, env, in_async))\\n      errors\\n    },\\n    EReturn(e) => check_async_effects_expr(e, env, in_async),\\n    EUnaryOp(_, operand) => check_async_effects_expr(operand, env, in_async),\\n    EAssign(_, val, cont) => {\\n      append_eff_errs(errors, check_async_effects_expr(val, env, in_async))\\n      append_eff_errs(errors, check_async_effects_expr(cont, env, in_async))\\n      errors\\n    },\\n    EAssignOp(_, _, val, cont) => {\\n      append_eff_errs(errors, check_async_effects_expr(val, env, in_async))\\n      append_eff_errs(errors, check_async_effects_expr(cont, env, in_async))\\n      errors\\n    },\\n    EDot(obj, _, _, _) => check_async_effects_expr(obj, env, in_async),\\n    ETuple(elems) => {\\n      let mut ei = 0\\n      while ei < Array::length(elems) {\\n        append_eff_errs(errors, check_async_effects_expr(Array::get(elems, ei), env, in_async))\\n        ei = ei + 1\\n      }\\n      errors\\n    },\\n    EArray(elems) => {\\n      let mut ei = 0\\n      while ei < Array::length(elems) {\\n        append_eff_errs(errors, check_async_effects_expr(Array::get(elems, ei), env, in_async))\\n        ei = ei + 1\\n      }\\n      errors\\n    },\\n    ERecord(_, fields, _) => {\\n      let mut fi = 0\\n      while fi < Array::length(fields) {\\n        let (_, fval) = Array::get(fields, fi)\\n        append_eff_errs(errors, check_async_effects_expr(fval, env, in_async))\\n        fi = fi + 1\\n      }\\n      errors\\n    },\\n    _ => errors\\n  }\\n}\\n\\n// A function body runs in an `{Async}` context if EITHER the lambda's inline\\n// effect OR the binding's declared signature type carries `Async`.\\nfn sig_type_is_async(topt: Option[TypeExpr]) -> Bool {\\n  match topt {\\n    Some(TyFn(_, _, eff)) => effect_opt_is_async(eff),\\n    _ => false\\n  }\\n}\\n\\nfn check_async_effects_binding(ty: Option[TypeExpr], body: Expr, env: TypeEnv) -> Array[EffectError] {\\n  let sig_async = sig_type_is_async(ty)\\n  match body {\\n    EFn(_, _, _, _, eff, fbody) => check_async_effects_expr(fbody, env, sig_async || effect_opt_is_async(eff)),\\n    _ => check_async_effects_expr(body, env, sig_async)\\n  }\\n}\\n\\nexport fn check_async_effects_stmt(stmt: Stmt, env: TypeEnv) -> Array[EffectError] {\\n  match stmt {\\n    SLet(_, _, _, ty, body) => check_async_effects_binding(ty, body, env),\\n    SLetMut(_, ty, body) => check_async_effects_binding(ty, body, env),\\n    STest(_, body) => check_async_effects_expr(body, env, false),\\n    SBench(_, body) => check_async_effects_expr(body, env, false),\\n    SExpr(e) => check_async_effects_expr(e, env, false),\\n    _ => Array::slice([\\n      EEThrowOutsideEffect(\\\"\\\")\\n    ], 0, 0)\\n  }\\n}\\n\\nexport fn check_async_effects_stmts(stmts: Array[Stmt], env: TypeEnv) -> Array[EffectError] {\\n  let errors = Array::slice([\\n    EEThrowOutsideEffect(\\\"\\\")\\n  ], 0, 0)\\n  let mut i = 0\\n  while i < Array::length(stmts) {\\n    append_eff_errs(errors, check_async_effects_stmt(Array::get(stmts, i), env))\\n    i = i + 1\\n  }\\n  errors\\n}\\n\\n//# perform-discipline enforcement (#626 criterion 1)\\n//\\n// `perform EffName::Op(..)` may only occur where `EffName` is in scope: either\\n// the enclosing function/lambda declares it in `with { ... }`, or the perform\\n// is inside a `handle` (which discharges it). Otherwise it is a type error —\\n// \\\"performing an undeclared effect\\\". This realizes the first acceptance\\n// criterion of #626 (the checker formerly accepted undeclared performs because\\n// it never resolved which effect an op belongs to).\\n//\\n// A `handle` is treated CONSERVATIVELY as discharging any effect for its body\\n// (we do not yet read which specific effect its arms handle), so a perform\\n// inside any handle is allowed — this never rejects a valid program; it only\\n// declines to flag the (rarer) perform-of-a-different-effect-inside-a-handle\\n// case, which full row tracking (#626 criteria 2/4) will cover.\\n\\n// Split a `with { A, B }` annotation into trimmed, deduped effect labels.\\nfn effect_decl_labels(eff: Option[String]) -> Array[String] {\\n  let out = Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n  match eff {\\n    None => out,\\n    Some(s) => {\\n      let raw = String::split(s, \\\",\\\")\\n      let mut i = 0\\n      while i < Array::length(raw) {\\n        let label = String::trim(Array::get(raw, i))\\n        if String::length(label) > 0 {\\n          let mut seen = false\\n          let mut j = 0\\n          while j < Array::length(out) {\\n            if Array::get(out, j) == label {\\n              seen = true\\n            }\\n            j = j + 1\\n          }\\n          if !seen {\\n            Array::push(out, label)\\n          }\\n        }\\n        i = i + 1\\n      }\\n      out\\n    }\\n  }\\n}\\n\\n// A single lowercase letter is an effect VARIABLE (polymorphic row tail in the\\n// current representation): a function declaring `with { e }` may perform any\\n// effect, so treat such a declaration as authorizing everything.\\nfn label_is_effect_var(name: String) -> Bool {\\n  String::length(name) == 1 && String::char_code_at(name, 0) >= 97 && String::char_code_at(name, 0) <= 122\\n}\\n\\nfn decl_authorizes_effect(labels: Array[String], eff_name: String) -> Bool {\\n  let mut i = 0\\n  let mut ok = false\\n  while i < Array::length(labels) {\\n    let l = Array::get(labels, i)\\n    if l == eff_name {\\n      ok = true\\n    } else if label_is_effect_var(l) {\\n      ok = true\\n    }\\n    i = i + 1\\n  }\\n  ok\\n}\\n\\n// `perform EffName::Op` — the op identifier is `EffName::Op`; the effect is the\\n// segment before `::`.\\nfn effect_name_of_op(op_name: String) -> String {\\n  let idx = String::index_of(op_name, \\\"::\\\")\\n  if idx > 0 {\\n    op_name[0:idx]\\n  } else {\\n    op_name\\n  }\\n}\\n\\n// #626 criterion 3 (call-site propagation, builtin slice): calling an effectful\\n// BUILTIN (e.g. `Fs::read_file`, `Env::args_len`) requires the enclosing\\n// function to declare that effect, exactly like `perform`. Returns the required\\n// effect, or None for pure builtins / non-builtins. `Error` (the 441-site throw\\n// discipline) and `Async` (composition-allowed; handled by the async pass) are\\n// deliberately excluded from this slice.\\nfn builtin_call_effect(name: String) -> Option[String] {\\n  // `sh`/`sh_lines` and the checker_visible `vibe_*_raw` dunder builtins\\n  // (Codex review, PR #909) are the only UNQUALIFIED effectful builtins:\\n  // they lower to real `vibe.*` host imports that execute shell commands or\\n  // terminate the process, so calling them directly must require\\n  // `{ Process }` just like a qualified builtin -- otherwise they could run\\n  // from a pure function or a bare top-level expression undeclared. Every\\n  // name here is checker_visible=true in builtin_registry.vibe (directly\\n  // callable from source); vibe_sh_lines_raw is checker_visible=false (only\\n  // synthesized internally, never typed by user source) so it needs no\\n  // entry. Checked before the `::` fast path below.\\n  if name == \\\"sh\\\" || name == \\\"sh_lines\\\"\\n  || name == \\\"vibe_sh_capture_raw\\\"\\n  || name == \\\"vibe_sh_capture_exit_code_raw\\\"\\n  || name == \\\"vibe_sh_capture_stdout_raw\\\"\\n  || name == \\\"vibe_sh_capture_stderr_raw\\\"\\n  || name == \\\"vibe_sh_capture_close_raw\\\"\\n  || name == \\\"vibe_process_exit_raw\\\" {\\n    Some(\\\"Process\\\")\\n  } else if String::index_of(name, \\\"::\\\") < 0 {\\n    // Fast path: every OTHER effectful builtin in this slice is a QUALIFIED name\\n    // (`Fs::read_file`, `Env::args_len`, `Stdin::...`, `Stdout::...`, ...), so a\\n    // callee with no `::` can never be one. Skipping `lookup_builtin` for the\\n    // (vastly more common) unqualified calls keeps the pass cheap enough to run\\n    // over the whole compiler source within the seed's heap during self-build.\\n    None\\n  } else {\\n    let normalized = canonical_builtin_name(name)\\n    match lookup_builtin(normalized) {\\n      Some(ty) => match ty {\\n        CtFn(_, _, Some(eff)) => if eff == \\\"Error\\\" {\\n          None\\n        } else if eff == \\\"Async\\\" {\\n          None\\n        } else {\\n          Some(eff)\\n        },\\n        _ => None\\n      },\\n      None => None\\n    }\\n  }\\n}\\n\\nfn labels_union(a: Array[String], b: Array[String]) -> Array[String] {\\n  let out = Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n  let mut i = 0\\n  while i < Array::length(a) {\\n    Array::push(out, Array::get(a, i))\\n    i = i + 1\\n  }\\n  let mut j = 0\\n  while j < Array::length(b) {\\n    let l = Array::get(b, j)\\n    let mut seen = false\\n    let mut k = 0\\n    while k < Array::length(out) {\\n      if Array::get(out, k) == l {\\n        seen = true\\n      }\\n      k = k + 1\\n    }\\n    if !seen {\\n      Array::push(out, l)\\n    }\\n    j = j + 1\\n  }\\n  out\\n}\\n\\n// #639: deterministic label ordering for effect-row diagnostics. Char-by-char\\n// lexicographic compare, shorter-prefix-first on a tie — written out by hand\\n// (see CLAUDE.md's length-first `String <` gotcha) so `{ Env, Fs }` always\\n// renders in the same order.\\nfn label_lt(a: String, b: String) -> Bool {\\n  let la = String::length(a)\\n  let lb = String::length(b)\\n  let n = if la < lb {\\n    la\\n  } else {\\n    lb\\n  }\\n  let mut i = 0\\n  let mut decided = 0\\n  while i < n && decided == 0 {\\n    let ca = String::char_code_at(a, i)\\n    let cb = String::char_code_at(b, i)\\n    if ca < cb {\\n      decided = 1\\n    } else if ca > cb {\\n      decided = 2\\n    } else {\\n      ()\\n    }\\n    i = i + 1\\n  }\\n  if decided == 1 {\\n    true\\n  } else if decided == 2 {\\n    false\\n  } else {\\n    la < lb\\n  }\\n}\\n\\n// Copying insertion sort (rows are tiny — a handful of labels at most).\\nfn sort_labels(xs: Array[String]) -> Array[String] {\\n  let out = Array::slice(xs, 0, Array::length(xs))\\n  let mut i = 1\\n  while i < Array::length(out) {\\n    let key = Array::get(out, i)\\n    let mut j = i\\n    while j > 0 && label_lt(key, Array::get(out, j - 1)) {\\n      Array::set(out, j, Array::get(out, j - 1))\\n      j = j - 1\\n    }\\n    Array::set(out, j, key)\\n    i = i + 1\\n  }\\n  out\\n}\\n\\nfn join_labels(xs: Array[String]) -> String {\\n  let mut out = \\\"\\\"\\n  let mut i = 0\\n  while i < Array::length(xs) {\\n    if i == 0 {\\n      out = Array::get(xs, i)\\n    } else {\\n      out = String::concat(out, String::concat(\\\", \\\", Array::get(xs, i)))\\n    }\\n    i = i + 1\\n  }\\n  out\\n}\\n\\n// #639: build the effect-row mismatch diagnostic for a perform/call whose\\n// required effects are absent from the enclosing declaration's row. `missing`\\n// is the set difference (callee requires minus caller declares), rendered\\n// sorted; `required` is the sorted union the fix-it hint suggests declaring.\\nfn make_row_mismatch(fn_name: String, declared: Array[String], missing: Array[String]) -> EffectError {\\n  let missing_sorted = sort_labels(labels_union(no_str_labels(), missing))\\n  let required = sort_labels(labels_union(declared, missing))\\n  EEEffectRowMismatch(fn_name, join_labels(missing_sorted), join_labels(declared), join_labels(required))\\n}\\n\\n// #626 criterion 2: a `handle ... with E` DISCHARGES E for its body — after\\n// handling E the body need not declare it. The parser qualifies each handler\\n// arm pattern as `E::Op`, so the discharged effect names are recoverable as the\\n// `::`-prefixes of the arm constructor patterns. Returns the distinct effects a\\n// handle discharges (empty if none could be determined — then the body stays\\n// conservatively permissive, never over-strict).\\nfn collect_handle_effects(arms: Array[(Pat, Expr)]) -> Array[String] {\\n  let out = Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n  let mut i = 0\\n  while i < Array::length(arms) {\\n    let (pat, _) = Array::get(arms, i)\\n    match pat {\\n      PCtor(name, _) => {\\n        let idx = String::index_of(name, \\\"::\\\")\\n        if idx > 0 {\\n          let eff = name[0:idx]\\n          let mut seen = false\\n          let mut j = 0\\n          while j < Array::length(out) {\\n            if Array::get(out, j) == eff {\\n              seen = true\\n            }\\n            j = j + 1\\n          }\\n          if !seen {\\n            Array::push(out, eff)\\n          }\\n        }\\n      },\\n      _ => ()\\n    }\\n    i = i + 1\\n  }\\n  out\\n}\\n\\n// Walk an expression's effect discipline with an EXPLICIT WORK STACK instead of\\n// recursion, so the pass never exhausts the wasm call stack however deeply the\\n// compiler's own source nests (long `let`/`seq` spines AND nested\\n// if/match/call forms). Each stack item carries its (expr, declared, in_handle)\\n// context: `EFn` resets `declared` to its own effect row, `EHandle` augments it\\n// with the discharged effects (criterion 2). Order of traversal differs from a\\n// recursive pre-order walk, but the SET of effect errors found is identical, so\\n// the accept/reject decision is unchanged.\\n// The declared effect row of a top-level binding: the signature's `with { ... }`\\n// unioned with an EFn body's own effect annotation (`let f = (x) -> { .. } with\\n// { E }`). Used to build the call-graph effect map for transitive enforcement.\\nfn fn_binding_effects(ty: Option[TypeExpr], body: Expr) -> Array[String] {\\n  let sig = sig_type_effect_labels(ty)\\n  match body {\\n    EFn(_, _, _, _, eff, _) => labels_union(sig, effect_decl_labels(eff)),\\n    _ => sig\\n  }\\n}\\n\\n// Look up a called function's declared effect row by linear scan over PARALLEL\\n// arrays (names[i] <-> effs[i]). A `Map` here allocates per lookup and, across\\n// the compiler's tens of thousands of call sites, exhausts the GC-less bump heap\\n// (#626 OOM); the linear scan allocates nothing.\\nfn lookup_fn_effs(names: Array[String], effs: Array[Array[String]], name: String) -> Option[Array[String]] {\\n  let mut i = 0\\n  let mut found = None\\n  while i < Array::length(names) {\\n    match found {\\n      None => if Array::get(names, i) == name {\\n        found = Some(Array::get(effs, i))\\n      } else {\\n        ()\\n      },\\n      Some(_) => ()\\n    }\\n    i = i + 1\\n  }\\n  found\\n}\\n\\n// #885 review (Codex): a `let`/`let rec`/`let mut` binding can reuse the NAME\\n// of an in-scope callback-parameter overlay entry (e.g. rebinding `f` to an\\n// unrelated local pure closure). Without this, `lookup_fn_effs`'s first-match\\n// scan would still find the SHADOWED outer entry and reject a call to the\\n// new, unrelated binding as if it were the original effectful callback --\\n// a false positive on valid shadowing. Removes every overlay entry matching\\n// `name` before the shadowing binding's scope is pushed onto the stack.\\n// #885 review (Codex): shadow the overlay by EVERY name in `params`, in one\\n// pass — used at an EFn boundary where all of the lambda's own parameter\\n// names (not just the ones that become new overlay entries) must block a\\n// same-named inherited entry.\\nfn shadow_overlay_names(names: Array[String], effs: Array[Array[String]], params: Array[(String, Option[TypeExpr])]) -> (Array[String], Array[Array[String]]) {\\n  let mut cur_names = names\\n  let mut cur_effs = effs\\n  let mut i = 0\\n  while i < Array::length(params) {\\n    let (pname, _) = Array::get(params, i)\\n    let shadowed = shadow_overlay(cur_names, cur_effs, pname)\\n    cur_names = shadowed.0\\n    cur_effs = shadowed.1\\n    i = i + 1\\n  }\\n  (cur_names, cur_effs)\\n}\\n\\nfn shadow_overlay(names: Array[String], effs: Array[Array[String]], name: String) -> (Array[String], Array[Array[String]]) {\\n  let out_names = Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n  let out_effs = Array::slice([\\n    Array::slice([\\n      \\\"\\\"\\n    ], 0, 0)\\n  ], 0, 0)\\n  let mut i = 0\\n  while i < Array::length(names) {\\n    if Array::get(names, i) != name {\\n      Array::push(out_names, Array::get(names, i))\\n      Array::push(out_effs, Array::get(effs, i))\\n    } else {\\n      ()\\n    }\\n    i = i + 1\\n  }\\n  (out_names, out_effs)\\n}\\n\\n// #885 (split off from #838, originally scoped out at #626): a function-typed\\n// PARAMETER (a callback, e.g. `f: (T) -> T with { e }`) is a call-graph leaf\\n// exactly like a named top-level function, but `fn_names`/`fn_effs` above is\\n// built ONLY from top-level `SLet`/`SLetMut` bindings, so invoking a callback\\n// PARAMETER directly (`f(x)` inside the wrapper that owns `f`) was invisible to\\n// the transitive check — no lookup ever matched `f`'s name, so nothing was\\n// required. This is a SEPARATE parallel-array \\\"overlay\\\" (ov_names/ov_effs),\\n// scoped to the function body currently being walked (extended when the walk\\n// descends into an `EFn`, carried unchanged through every other node), that\\n// records each in-scope function-typed parameter's declared effect labels.\\n//\\n// Deliberately narrower than the general transitive check: callback-parameter\\n// labels are checked via `decl_authorizes_effect` WITHOUT the\\n// `label_is_effect_var` exemption used below for calls to NAMED top-level\\n// functions. That exemption exists to prevent a real unsoundness of its own —\\n// naively requiring the LITERAL row-variable token (e.g. `\\\"e\\\"`) to appear in\\n// the CALLER's declared row at a call site like `apply(inc, 41)` — since the\\n// caller has no way to know the row variable resolves to nothing without\\n// call-site effect-row UNIFICATION (matching the argument actually passed\\n// against the callee's parameter type), which this pass does not perform. This\\n// is exactly the naive fix rejected during #885's investigation: dropping the\\n// exemption globally broke `generic_effect_matrix_ok_passthrough_pure.vibe`.\\n// The callback-parameter case is different in kind: the row variable and the\\n// declared effect being compared live in the SAME function signature (the\\n// parameter's `with { e }` and the enclosing function's own `with { e }` are\\n// the identical token by construction — no cross-call-site instantiation is\\n// involved), so a literal-name check here is sound, not a naive shortcut.\\nfn build_param_overlay(params: Array[(String, Option[TypeExpr])]) -> (Array[String], Array[Array[String]]) {\\n  let names = Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n  let effs = Array::slice([\\n    Array::slice([\\n      \\\"\\\"\\n    ], 0, 0)\\n  ], 0, 0)\\n  let mut i = 0\\n  while i < Array::length(params) {\\n    let (pname, ptype) = Array::get(params, i)\\n    match ptype {\\n      Some(TyFn(_, _, eff)) => {\\n        let labels = effect_decl_labels(eff)\\n        if Array::length(labels) > 0 {\\n          Array::push(names, pname)\\n          Array::push(effs, labels)\\n        } else {\\n          ()\\n        }\\n      },\\n      _ => ()\\n    }\\n    i = i + 1\\n  }\\n  (names, effs)\\n}\\n\\n// A `let apply: [T](f: (T) -> T with { e }, x: T) -> T = (f, x) -> { f(x) }`\\n// binding (separate top-level type annotation + untyped lambda) parses to an\\n// `EFn` whose OWN `params` carry no per-parameter `TypeExpr` at all (the types\\n// live only on the `SLet`'s `ty` field). `build_param_overlay` needs real\\n// per-parameter types to find a callback parameter's declared effect, so this\\n// fills in each untyped `EFn` parameter from `ty`'s `TyFn` parameter list at\\n// the SAME position — the two lists describe the same signature, so positional\\n// pairing is exact. An `EFn` parameter that already carries its own inline\\n// type (the `[T](f: (T) -> T with { e }, ...)` generic-literal spelling used\\n// elsewhere in this file) is left untouched; `ty` is consulted only to fill\\n// gaps, never to override.\\nfn merge_param_types_with_sig(ty: Option[TypeExpr], params: Array[(String, Option[TypeExpr])]) -> Array[(String, Option[TypeExpr])] {\\n  match ty {\\n    Some(TyFn(sig_params, _, _)) => {\\n      let out = Array::slice([\\n        (\\\"\\\", None)\\n      ], 0, 0)\\n      let mut i = 0\\n      while i < Array::length(params) {\\n        let (pname, ptype) = Array::get(params, i)\\n        let effective = match ptype {\\n          Some(_) => ptype,\\n          None => if i < Array::length(sig_params) {\\n            Some(Array::get(sig_params, i))\\n          } else {\\n            None\\n          }\\n        }\\n        Array::push(out, (pname, effective))\\n        i = i + 1\\n      }\\n      out\\n    },\\n    _ => params\\n  }\\n}\\n\\n// Transitive effect enforcement (#626): a call to a user function `G` that\\n// declares `with { E }` leaks E into the caller unless the caller declares E or\\n// the call is under a `handle ... with E`. Combined with the DIRECT discipline\\n// (every function that itself performs/invokes an effectful builtin must declare\\n// it — already enforced), this propagates effect requirements up the call graph\\n// level by level: every effectful leaf is annotated, so a one-level check at\\n// each call site is complete. `fn_names`/`fn_effs` is the call-graph map (empty\\n// => transitive check disabled, preserving the direct-only behavior).\\n//\\n// `ov_names`/`ov_effs` (#885) is the SEPARATE callback-parameter overlay\\n// described above, scoped to the function body currently in view (empty at the\\n// program's top level and at any call site with no enclosing function-typed\\n// parameters in scope).\\nexport fn check_perform_effects_expr_tx(root: Expr, root_declared: Array[String], root_in_handle: Bool, fn_names: Array[String], fn_effs: Array[Array[String]], root_ov_names: Array[String], root_ov_effs: Array[Array[String]]) -> Array[EffectError] {\\n  check_perform_effects_expr_tx_in(\\\"\\\", root, root_declared, root_in_handle, fn_names, fn_effs, root_ov_names, root_ov_effs)\\n}\\n\\n// #639: the same walk with the enclosing top-level binding's NAME threaded in\\n// so row-mismatch diagnostics can blame the caller's declaration in the fix-it\\n// hint. The name is constant per walk (lambdas are anonymous), so it rides as\\n// a plain parameter, not on the work stack.\\nfn check_perform_effects_expr_tx_in(fn_name: String, root: Expr, root_declared: Array[String], root_in_handle: Bool, fn_names: Array[String], fn_effs: Array[Array[String]], root_ov_names: Array[String], root_ov_effs: Array[Array[String]]) -> Array[EffectError] {\\n  let errors = Array::slice([\\n    EEThrowOutsideEffect(\\\"\\\")\\n  ], 0, 0)\\n  let stack = Array::slice([\\n    (root, root_declared, root_in_handle, root_ov_names, root_ov_effs)\\n  ], 0, 1)\\n  while Array::length(stack) > 0 {\\n    let n = Array::length(stack)\\n    let (expr, declared, in_handle, ov_names, ov_effs) = Array::get(stack, n - 1)\\n    Array::truncate(stack, n - 1)\\n    match expr {\\n      ECall(callee, args, _) => {\\n        match callee {\\n          EIdent(name, _) => {\\n            if name == \\\"perform\\\" && Array::length(args) == 1 {\\n              match Array::get(args, 0) {\\n                ECall(op_callee, _, _) => match op_callee {\\n                  EIdent(op_name, _) => {\\n                    let eff = effect_name_of_op(op_name)\\n                    // #640 Stage 2: `Error` is exempt from the DIRECT\\n                    // discipline, exactly like the transitive slice below\\n                    // (`teff != \\\"Error\\\"`) and builtin_call_effect's Error\\n                    // carve-out — the throw row is pervasive (~970\\n                    // un-annotated throw sites). `throw(x)` now parses to\\n                    // `perform Error::Throw(x)`, so without this exemption\\n                    // every one of those sites would newly require\\n                    // `with { Error }`.\\n                    if eff != \\\"Error\\\" && !in_handle && !decl_authorizes_effect(declared, eff) {\\n                      Array::push(errors, make_row_mismatch(fn_name, declared, [\\n                        eff\\n                      ]))\\n                    } else {\\n                      ()\\n                    }\\n                  },\\n                  _ => ()\\n                },\\n                _ => ()\\n              }\\n            } else {\\n              match builtin_call_effect(name) {\\n                Some(eff) => if !in_handle && !decl_authorizes_effect(declared, eff) {\\n                  Array::push(errors, make_row_mismatch(fn_name, declared, [\\n                    eff\\n                  ]))\\n                } else {\\n                  ()\\n                },\\n                None => ()\\n              }\\n            }\\n            // Transitive (#626): calling a user function leaks its declared\\n            // effects into this context unless declared here or under a handle.\\n            // Scope = concrete RESOURCE effects (Fs/Env/Stdin/Stdout/...): the\\n            // DIRECT discipline already excludes `Error` (the throw row is\\n            // pervasive — nearly every function can throw) and `Async`\\n            // (composition is allowed; the async pass governs it), so the\\n            // transitive pass mirrors that exclusion. Effect-variable rows\\n            // (polymorphic) impose nothing HERE — call-site resolution of what\\n            // a row variable is instantiated to would need real effect-row\\n            // unification (#885 tracks that separately); naively requiring the\\n            // row-variable TOKEN itself in the caller's declared row produces\\n            // false positives (see `generic_effect_matrix_ok_passthrough_pure`).\\n            match lookup_fn_effs(fn_names, fn_effs, name) {\\n              Some(callee_effs) => {\\n                // #639: aggregate every effect this call site leaks into ONE\\n                // set-difference diagnostic (\\\"missing { Env, Fs }\\\") instead of\\n                // one error per label.\\n                let missing = no_str_labels()\\n                let mut ti = 0\\n                while ti < Array::length(callee_effs) {\\n                  let teff = Array::get(callee_effs, ti)\\n                  if String::length(teff) > 0 && teff != \\\"Error\\\" && teff != \\\"Async\\\" && !label_is_effect_var(teff) && !in_handle && !decl_authorizes_effect(declared, teff) {\\n                    Array::push(missing, teff)\\n                  } else {\\n                    ()\\n                  }\\n                  ti = ti + 1\\n                }\\n                if Array::length(missing) > 0 {\\n                  Array::push(errors, make_row_mismatch(fn_name, declared, missing))\\n                } else {\\n                  ()\\n                }\\n              },\\n              None => ()\\n            }\\n            // #885: calling a function-typed PARAMETER (a callback) directly —\\n            // e.g. `f(x)` inside the wrapper that declares `f: (T) -> T with\\n            // { e }` — leaks `f`'s declared row into this context exactly like\\n            // a named function call above, but UNLIKE that case a row-variable\\n            // label here is NOT exempted: the parameter's `with { e }` and the\\n            // enclosing function's own declared row live in the SAME\\n            // signature, so the token `e` denotes the identical variable in\\n            // both places (no cross-call-site instantiation to resolve), and\\n            // literal-name membership is a sound check.\\n            match lookup_fn_effs(ov_names, ov_effs, name) {\\n              Some(param_effs) => {\\n                // #639: aggregated exactly like the named-callee case above.\\n                let missing = no_str_labels()\\n                let mut pi = 0\\n                while pi < Array::length(param_effs) {\\n                  let peff = Array::get(param_effs, pi)\\n                  if String::length(peff) > 0 && peff != \\\"Error\\\" && peff != \\\"Async\\\" && !in_handle && !decl_authorizes_effect(declared, peff) {\\n                    Array::push(missing, peff)\\n                  } else {\\n                    ()\\n                  }\\n                  pi = pi + 1\\n                }\\n                if Array::length(missing) > 0 {\\n                  Array::push(errors, make_row_mismatch(fn_name, declared, missing))\\n                } else {\\n                  ()\\n                }\\n              },\\n              None => ()\\n            }\\n          },\\n          _ => ()\\n        }\\n        Array::push(stack, (callee, declared, in_handle, ov_names, ov_effs))\\n        let mut ai = 0\\n        while ai < Array::length(args) {\\n          Array::push(stack, (Array::get(args, ai), declared, in_handle, ov_names, ov_effs))\\n          ai = ai + 1\\n        }\\n      },\\n      EFn(_, _, params, _, effect, body) => {\\n        // #761: an EXPLICITLY-annotated lambda (`(x) -> { .. } with { E }`) is\\n        // checked against its own row E. An UN-annotated lambda's effect row is\\n        // INFERRED, not declared, so checking its body against an empty row is\\n        // wrong — it wrongly rejected an inline effectful lambda passed to a HOF\\n        // param whose type declares the effect (bidirectional effect checking,\\n        // e.g. `call_twice((c) -> { write_char(c) })`). Inherit the enclosing\\n        // declared context instead: the lambda may use any effect available\\n        // where it is written (its inferred row is surfaced in its type and\\n        // re-checked at the call/handle site). Conservative — like the\\n        // mutability pass, this can only miss errors, never invent them.\\n        let lam_labels = effect_decl_labels(effect)\\n        let body_declared = if Array::length(lam_labels) == 0 {\\n          declared\\n        } else {\\n          lam_labels\\n        }\\n        // #885: extend the callback-parameter overlay with THIS function's own\\n        // function-typed parameters (if any carry a declared effect), scoped to\\n        // its body. New entries are appended AHEAD of the inherited overlay so\\n        // `lookup_fn_effs` (first-match) has a same-named inner parameter\\n        // shadow an outer one.\\n        //\\n        // #885 review (Codex): shadowing must apply to EVERY one of this\\n        // lambda's own parameter names, not just the ones that end up in\\n        // local_names/local_effs (function-typed with a declared effect) --\\n        // a parameter reusing an outer callback's name with a DIFFERENT type\\n        // (e.g. plain `Int`, or a function type with no declared effect) must\\n        // still block the inherited entry, or a call to the new, unrelated\\n        // parameter is wrongly checked against the shadowed outer callback's\\n        // effect row.\\n        let shadowed = shadow_overlay_names(ov_names, ov_effs, params)\\n        let (shadowed_ov_names, shadowed_ov_effs) = shadowed\\n        let (local_names, local_effs) = build_param_overlay(params)\\n        let body_ov_names = if Array::length(local_names) == 0 {\\n          shadowed_ov_names\\n        } else {\\n          let merged = Array::slice(local_names, 0, Array::length(local_names))\\n          let mut oi = 0\\n          while oi < Array::length(shadowed_ov_names) {\\n            Array::push(merged, Array::get(shadowed_ov_names, oi))\\n            oi = oi + 1\\n          }\\n          merged\\n        }\\n        let body_ov_effs = if Array::length(local_effs) == 0 {\\n          shadowed_ov_effs\\n        } else {\\n          let merged = Array::slice(local_effs, 0, Array::length(local_effs))\\n          let mut oi = 0\\n          while oi < Array::length(shadowed_ov_effs) {\\n            Array::push(merged, Array::get(shadowed_ov_effs, oi))\\n            oi = oi + 1\\n          }\\n          merged\\n        }\\n        Array::push(stack, (body, body_declared, in_handle, body_ov_names, body_ov_effs))\\n      },\\n      EHandle(body, arms) => {\\n        let discharged = collect_handle_effects(arms)\\n        let body_declared = labels_union(declared, discharged)\\n        let body_in_handle = if Array::length(discharged) == 0 {\\n          true\\n        } else {\\n          in_handle\\n        }\\n        Array::push(stack, (body, body_declared, body_in_handle, ov_names, ov_effs))\\n        let mut ai = 0\\n        while ai < Array::length(arms) {\\n          let (_, arm_body) = Array::get(arms, ai)\\n          Array::push(stack, (arm_body, declared, in_handle, ov_names, ov_effs))\\n          ai = ai + 1\\n        }\\n      },\\n      ELet(name, val, body, _) => {\\n        // #885 review (Codex): `val` is evaluated in the OUTER scope (ELet is\\n        // non-recursive), so only the body's overlay needs the new binding\\n        // shadowed out.\\n        let (body_ov_names, body_ov_effs) = shadow_overlay(ov_names, ov_effs, name)\\n        Array::push(stack, (val, declared, in_handle, ov_names, ov_effs))\\n        Array::push(stack, (body, declared, in_handle, body_ov_names, body_ov_effs))\\n      },\\n      ELetRec(name, val, body) => {\\n        // #885 review (Codex): unlike ELet, `let rec` allows `val` itself to\\n        // reference `name` (self-recursion), so both val and body need the\\n        // shadow applied.\\n        let (rec_ov_names, rec_ov_effs) = shadow_overlay(ov_names, ov_effs, name)\\n        Array::push(stack, (val, declared, in_handle, rec_ov_names, rec_ov_effs))\\n        Array::push(stack, (body, declared, in_handle, rec_ov_names, rec_ov_effs))\\n      },\\n      ELetMut(name, val, body, _) => {\\n        // #885 review (Codex): same as ELet -- non-recursive, only body shadows.\\n        let (body_ov_names, body_ov_effs) = shadow_overlay(ov_names, ov_effs, name)\\n        Array::push(stack, (val, declared, in_handle, ov_names, ov_effs))\\n        Array::push(stack, (body, declared, in_handle, body_ov_names, body_ov_effs))\\n      },\\n      ESeq(a, b) => {\\n        Array::push(stack, (a, declared, in_handle, ov_names, ov_effs))\\n        Array::push(stack, (b, declared, in_handle, ov_names, ov_effs))\\n      },\\n      EIf(cond, then_e, else_e) => {\\n        Array::push(stack, (cond, declared, in_handle, ov_names, ov_effs))\\n        Array::push(stack, (then_e, declared, in_handle, ov_names, ov_effs))\\n        Array::push(stack, (else_e, declared, in_handle, ov_names, ov_effs))\\n      },\\n      EMatch(scrutinee, arms) => {\\n        Array::push(stack, (scrutinee, declared, in_handle, ov_names, ov_effs))\\n        let mut ai = 0\\n        while ai < Array::length(arms) {\\n          let (_, arm_body) = Array::get(arms, ai)\\n          Array::push(stack, (arm_body, declared, in_handle, ov_names, ov_effs))\\n          ai = ai + 1\\n        }\\n      },\\n      EWhile(cond, body) => {\\n        Array::push(stack, (cond, declared, in_handle, ov_names, ov_effs))\\n        Array::push(stack, (body, declared, in_handle, ov_names, ov_effs))\\n      },\\n      ELoop(params, body) => {\\n        let mut i = 0\\n        while i < Array::length(params) {\\n          let (_, init) = Array::get(params, i)\\n          Array::push(stack, (init, declared, in_handle, ov_names, ov_effs))\\n          i = i + 1\\n        }\\n        Array::push(stack, (body, declared, in_handle, ov_names, ov_effs))\\n      },\\n      EForIn(_, _, iter, body) => {\\n        Array::push(stack, (iter, declared, in_handle, ov_names, ov_effs))\\n        Array::push(stack, (body, declared, in_handle, ov_names, ov_effs))\\n      },\\n      EBinOp(_, left, right) => {\\n        Array::push(stack, (left, declared, in_handle, ov_names, ov_effs))\\n        Array::push(stack, (right, declared, in_handle, ov_names, ov_effs))\\n      },\\n      EReturn(e) => Array::push(stack, (e, declared, in_handle, ov_names, ov_effs)),\\n      EUnaryOp(_, operand) => Array::push(stack, (operand, declared, in_handle, ov_names, ov_effs)),\\n      EAssign(_, val, cont) => {\\n        Array::push(stack, (val, declared, in_handle, ov_names, ov_effs))\\n        Array::push(stack, (cont, declared, in_handle, ov_names, ov_effs))\\n      },\\n      EAssignOp(_, _, val, cont) => {\\n        Array::push(stack, (val, declared, in_handle, ov_names, ov_effs))\\n        Array::push(stack, (cont, declared, in_handle, ov_names, ov_effs))\\n      },\\n      EDot(obj, _, _, _) => Array::push(stack, (obj, declared, in_handle, ov_names, ov_effs)),\\n      ETuple(elems) => {\\n        let mut ei = 0\\n        while ei < Array::length(elems) {\\n          Array::push(stack, (Array::get(elems, ei), declared, in_handle, ov_names, ov_effs))\\n          ei = ei + 1\\n        }\\n      },\\n      EArray(elems) => {\\n        let mut ei = 0\\n        while ei < Array::length(elems) {\\n          Array::push(stack, (Array::get(elems, ei), declared, in_handle, ov_names, ov_effs))\\n          ei = ei + 1\\n        }\\n      },\\n      ERecord(_, fields, _) => {\\n        let mut fi = 0\\n        while fi < Array::length(fields) {\\n          let (_, fval) = Array::get(fields, fi)\\n          Array::push(stack, (fval, declared, in_handle, ov_names, ov_effs))\\n          fi = fi + 1\\n        }\\n      },\\n      _ => ()\\n    }\\n  }\\n  errors\\n}\\n\\nfn sig_type_effect_labels(topt: Option[TypeExpr]) -> Array[String] {\\n  match topt {\\n    Some(TyFn(_, _, eff)) => effect_decl_labels(eff),\\n    _ => effect_decl_labels(None)\\n  }\\n}\\n\\nfn no_str_labels() -> Array[String] {\\n  Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n}\\n\\nfn no_ov_effs() -> Array[Array[String]] {\\n  Array::slice([\\n    Array::slice([\\n      \\\"\\\"\\n    ], 0, 0)\\n  ], 0, 0)\\n}\\n\\n// Public 3-arg entry: the direct-only check (no call-graph map), preserving the\\n// pre-transitive behavior for unit tests and any non-stmts caller.\\nexport fn check_perform_effects_expr(root: Expr, root_declared: Array[String], root_in_handle: Bool) -> Array[EffectError] {\\n  check_perform_effects_expr_tx(root, root_declared, root_in_handle, no_str_labels(), no_ov_effs(), no_str_labels(), no_ov_effs())\\n}\\n\\nfn check_perform_effects_binding_tx(fn_name: String, ty: Option[TypeExpr], body: Expr, fn_names: Array[String], fn_effs: Array[Array[String]]) -> Array[EffectError] {\\n  let sig_labels = sig_type_effect_labels(ty)\\n  match body {\\n    // #885: build the callback-parameter overlay for THIS binding's own\\n    // function value from its (possibly untyped, see merge_param_types_with_sig)\\n    // parameters, so a direct call to one of them inside the body is checked\\n    // from the very first stack frame — not just once the walk happens to\\n    // redescend through a nested `EFn` node.\\n    EFn(_, _, params, _, eff, fbody) => {\\n      let (ov_names, ov_effs) = build_param_overlay(merge_param_types_with_sig(ty, params))\\n      check_perform_effects_expr_tx_in(fn_name, fbody, labels_union(sig_labels, effect_decl_labels(eff)), false, fn_names, fn_effs, ov_names, ov_effs)\\n    },\\n    _ => check_perform_effects_expr_tx_in(fn_name, body, sig_labels, false, fn_names, fn_effs, no_str_labels(), no_ov_effs())\\n  }\\n}\\n\\n// #761: a `test {}` / `bench {}` block is a program entry point — it runs under\\n// the runtime host, which is the ambient handler for the HOST resource effects\\n// (Fs/Env/Stdin/Stdout/Process/Profiler). So a test may invoke a host-effectful\\n// function (directly, transitively, or as an unqualified builtin) without a\\n// `handle`, exactly as `main` does. This grant was already de-facto true for\\n// IMPORTED effectful functions (they are absent from the transitive fn_effs map,\\n// so calling them never flagged), but LOCALLY-defined ones (in fn_effs) and\\n// direct builtin/perform host effects were wrongly rejected — an asymmetry.\\n// Seeding the test/bench declared row with the host set removes it. NON-host\\n// (user-defined) effects still require a handler: performing one at runtime with\\n// no host handler would trap, so leaving it flagged is correct. Purity/caching\\n// is judged separately by file_tests_cacheable (empty declared row), so a test\\n// that reaches a host effect still correctly counts as impure/non-cacheable.\\nfn test_bench_ambient_effects() -> Array[String] {\\n  [\\n    // #865: \\\"Stderr\\\" added alongside \\\"Stdout\\\" -- same ambient-host-handler\\n    // reasoning (a test/bench block runs under the runtime host, which\\n    // implements Stderr::write_stream/write_char just like Stdout's).\\n    \\\"Fs\\\", \\\"Env\\\", \\\"Stdin\\\", \\\"Stdout\\\", \\\"Stderr\\\", \\\"Process\\\", \\\"Profiler\\\"\\n  ]\\n}\\n\\nfn check_perform_effects_stmt_tx(stmt: Stmt, fn_names: Array[String], fn_effs: Array[Array[String]]) -> Array[EffectError] {\\n  match stmt {\\n    SLet(_, _, name, ty, body) => check_perform_effects_binding_tx(name, ty, body, fn_names, fn_effs),\\n    SLetMut(name, ty, body) => check_perform_effects_binding_tx(name, ty, body, fn_names, fn_effs),\\n    STest(_, body) => check_perform_effects_expr_tx(body, test_bench_ambient_effects(), false, fn_names, fn_effs, no_str_labels(), no_ov_effs()),\\n    SBench(_, body) => check_perform_effects_expr_tx(body, test_bench_ambient_effects(), false, fn_names, fn_effs, no_str_labels(), no_ov_effs()),\\n    SExpr(e) => check_perform_effects_expr_tx(e, effect_decl_labels(None), false, fn_names, fn_effs, no_str_labels(), no_ov_effs()),\\n    _ => Array::slice([\\n      EEThrowOutsideEffect(\\\"\\\")\\n    ], 0, 0)\\n  }\\n}\\n\\n// Public 1-arg entry: direct-only (empty map). Kept for unit tests.\\nexport fn check_perform_effects_stmt(stmt: Stmt) -> Array[EffectError] {\\n  check_perform_effects_stmt_tx(stmt, no_str_labels(), no_ov_effs())\\n}\\n\\n// #812: seed the transitive call-graph map with the checker ENV's bindings.\\n// fn_names/fn_effs was built from the CURRENT module's top-level statements\\n// only, so a caller could invoke an IMPORTED `with { Fs }` function without\\n// declaring Fs and reach the filesystem at runtime — while the identical\\n// shape with a local callee was rejected. An imported binding's CtFn carries\\n// its declared effect row in the env; add every effect-bearing env binding\\n// AFTER the local rows (lookup_fn_effs is first-match, so a same-name local\\n// row still shadows the env row). Effect-free bindings are skipped — an\\n// absent row and an empty row enforce the same (nothing).\\nfn push_env_fn_eff(name: String, ty: Type, fn_names: Array[String], fn_effs: Array[Array[String]]) -> Unit {\\n  let fnty = match ty {\\n    CtForAll(_, _, body) => body,\\n    _ => ty\\n  }\\n  match fnty {\\n    CtFn(_, _, eff) => {\\n      let labels = effect_decl_labels(eff)\\n      if Array::length(labels) > 0 {\\n        Array::push(fn_names, name)\\n        Array::push(fn_effs, labels)\\n      } else {\\n        ()\\n      }\\n    },\\n    _ => ()\\n  }\\n}\\n\\nfn seed_env_fn_effs(env: TypeEnv, fn_names: Array[String], fn_effs: Array[Array[String]]) -> Unit {\\n  let mut cur = env\\n  let mut looping = true\\n  while looping {\\n    match cur {\\n      EnvBind(name, ty, rest) => {\\n        push_env_fn_eff(name, ty, fn_names, fn_effs)\\n        cur = rest\\n      },\\n      EnvTraitDef(_, _, _, _, rest) => {\\n        cur = rest\\n      },\\n      EnvTraitImpl(_, _, rest) => {\\n        cur = rest\\n      },\\n      EnvTraitImplGen(_, _, _, _, rest) => {\\n        cur = rest\\n      },\\n      EnvCached(_, rest) => {\\n        cur = rest\\n      },\\n      EnvFlat(entries) => {\\n        let mut ei = 0\\n        while ei < Array::length(entries) {\\n          let (ename, ety) = Array::get(entries, ei)\\n          push_env_fn_eff(ename, ety, fn_names, fn_effs)\\n          ei = ei + 1\\n        }\\n        looping = false\\n      },\\n      EnvEmpty => {\\n        looping = false\\n      }\\n    }\\n  }\\n}\\n\\nfn build_perform_fn_effs(stmts: Array[Stmt], fn_names: Array[String], fn_effs: Array[Array[String]]) -> Unit {\\n  let mut m = 0\\n  while m < Array::length(stmts) {\\n    match Array::get(stmts, m) {\\n      SLet(_, _, name, ty, body) => {\\n        Array::push(fn_names, name)\\n        Array::push(fn_effs, fn_binding_effects(ty, body))\\n      },\\n      SLetMut(name, ty, body) => {\\n        Array::push(fn_names, name)\\n        Array::push(fn_effs, fn_binding_effects(ty, body))\\n      },\\n      _ => ()\\n    }\\n    m = m + 1\\n  }\\n}\\n\\nexport fn check_perform_effects_stmts(stmts: Array[Stmt]) -> Array[EffectError] {\\n  check_perform_effects_stmts_env(stmts, EnvEmpty)\\n}\\n\\nexport fn check_perform_effects_stmts_env(stmts: Array[Stmt], env: TypeEnv) -> Array[EffectError] {\\n  // Build the call-graph effect map (parallel arrays) from every top-level\\n  // binding's declared row — locals first, then the env's (imported)\\n  // bindings (#812) — then run the per-stmt check WITH transitive\\n  // enforcement so a caller must declare (or handle) the effects of the\\n  // functions it invokes.\\n  let fn_names = Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n  let fn_effs = Array::slice([\\n    Array::slice([\\n      \\\"\\\"\\n    ], 0, 0)\\n  ], 0, 0)\\n  build_perform_fn_effs(stmts, fn_names, fn_effs)\\n  seed_env_fn_effs(env, fn_names, fn_effs)\\n  let errors = Array::slice([\\n    EEThrowOutsideEffect(\\\"\\\")\\n  ], 0, 0)\\n  let mut i = 0\\n  while i < Array::length(stmts) {\\n    append_eff_errs(errors, check_perform_effects_stmt_tx(Array::get(stmts, i), fn_names, fn_effs))\\n    i = i + 1\\n  }\\n  errors\\n}\\n\\n// #634 (ADR-0026): pure-test result cache verdict. A `test {}` block's result\\n// is safe to cache/skip only when running it depends on nothing external — no\\n// I/O, no non-determinism — so it is a deterministic function of source + deps +\\n// compiler version. file_tests_cacheable is true iff the file has at least one\\n// `test {}` block and EVERY test block is transitively effect-free.\\n//\\n// Reuses the transitive effect walk: a test body checked with an EMPTY declared\\n// row reports an error for ANY effect it reaches that a `handle` does not\\n// discharge — Fs/Http/Env/custom effects and `perform`, propagated through the\\n// call-graph effect map (fn_names/fn_effs). `Error` (assert/throw) and `Async`\\n// are excluded by that pass, so they stay cacheable; a `handle` that fully\\n// discharges its effects (e.g. a fixed-seed Rng handler) also stays cacheable.\\n// Zero errors => cacheable.\\n//\\n// A direct `sh`/`sh_lines` call IS surfaced: builtin_call_effect special-cases\\n// these two unqualified builtins to `Process` (they lower to real host imports),\\n// so a test that shells out is correctly treated as impure/non-cacheable, the\\n// same as `sh` reached through a user function declaring `with { Process }`.\\n// Conservative otherwise: an effect the type system does not surface here stays\\n// invisible, but it never marks a genuinely-impure test cacheable.\\nexport fn file_tests_cacheable(stmts: Array[Stmt]) -> Bool {\\n  let fn_names = Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n  let fn_effs = Array::slice([\\n    Array::slice([\\n      \\\"\\\"\\n    ], 0, 0)\\n  ], 0, 0)\\n  let mut m = 0\\n  while m < Array::length(stmts) {\\n    match Array::get(stmts, m) {\\n      SLet(_, _, name, ty, body) => {\\n        Array::push(fn_names, name)\\n        Array::push(fn_effs, fn_binding_effects(ty, body))\\n      },\\n      SLetMut(name, ty, body) => {\\n        Array::push(fn_names, name)\\n        Array::push(fn_effs, fn_binding_effects(ty, body))\\n      },\\n      _ => ()\\n    }\\n    m = m + 1\\n  }\\n  let empty_decl = Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n  let mut any_test = false\\n  let mut all_ok = true\\n  let mut i = 0\\n  while i < Array::length(stmts) {\\n    match Array::get(stmts, i) {\\n      STest(_, body) => {\\n        any_test = true\\n        let errs = check_perform_effects_expr_tx(body, empty_decl, false, fn_names, fn_effs, no_str_labels(), no_ov_effs())\\n        if Array::length(errs) != 0 {\\n          all_ok = false\\n        } else {\\n          ()\\n        }\\n      },\\n      _ => ()\\n    }\\n    i = i + 1\\n  }\\n  any_test && all_ok\\n}\\n\\n//# Mutability discipline: reassignment requires a `let mut` binding.\\n//\\n// `let x = ...` is immutable (docs/cheatsheet.md); only `let mut x` may be\\n// reassigned. The checker previously accepted `let x = 1; x = 2`. This pass\\n// walks expressions carrying the SET of names that are reassignable in scope\\n// and reports an `x = e` / `x op= e` whose target is not in that set.\\n//\\n// The set only ever GROWS down a scope (never shrinks), so the pass can only\\n// produce false NEGATIVES, never false positives: every form that introduces a\\n// reassignable or freshly-rebindable name — `let mut`, function parameters,\\n// loop accumulators, `for` variables, and pattern binds — is added, so the\\n// only thing flagged is reassignment of a plain immutable `let`. Nested\\n// functions INHERIT the outer set (a closure may mutate a captured `let mut`).\\n\\nfn mut_has(xs: Array[String], n: String) -> Bool {\\n  let mut i = 0\\n  let mut found = false\\n  while i < Array::length(xs) {\\n    if Array::get(xs, i) == n {\\n      found = true\\n    } else {\\n      ()\\n    }\\n    i = i + 1\\n  }\\n  found\\n}\\n\\nfn mut_with(base: Array[String], name: String) -> Array[String] {\\n  let out = Array::slice(base, 0, Array::length(base))\\n  Array::push(out, name)\\n  out\\n}\\n\\nfn collect_pat_binds_into(pat: Pat, acc: Array[String]) -> Unit {\\n  match pat {\\n    PBind(name) => Array::push(acc, name),\\n    PCtor(_, subs) => {\\n      let mut i = 0\\n      while i < Array::length(subs) {\\n        collect_pat_binds_into(Array::get(subs, i), acc)\\n        i = i + 1\\n      }\\n    },\\n    PTuple(subs) => {\\n      let mut i = 0\\n      while i < Array::length(subs) {\\n        collect_pat_binds_into(Array::get(subs, i), acc)\\n        i = i + 1\\n      }\\n    },\\n    POr(l, r) => {\\n      collect_pat_binds_into(l, acc)\\n      collect_pat_binds_into(r, acc)\\n    },\\n    PStruct(_, fields) => {\\n      let mut i = 0\\n      while i < Array::length(fields) {\\n        let (_, fp) = Array::get(fields, i)\\n        collect_pat_binds_into(fp, acc)\\n        i = i + 1\\n      }\\n    },\\n    _ => ()\\n  }\\n}\\n\\nfn mut_with_pat(base: Array[String], pat: Pat) -> Array[String] {\\n  let out = Array::slice(base, 0, Array::length(base))\\n  collect_pat_binds_into(pat, out)\\n  out\\n}\\n\\nfn mut_with_params(base: Array[String], params: Array[(String, Option[TypeExpr])]) -> Array[String] {\\n  let out = Array::slice(base, 0, Array::length(base))\\n  let mut i = 0\\n  while i < Array::length(params) {\\n    let (pname, _) = Array::get(params, i)\\n    Array::push(out, pname)\\n    i = i + 1\\n  }\\n  out\\n}\\n\\nexport fn check_mutability_expr(expr: Expr, mutable: Array[String]) -> Array[EffectError] {\\n  let errors = Array::slice([\\n    EEThrowOutsideEffect(\\\"\\\")\\n  ], 0, 0)\\n  match expr {\\n    ECall(callee, args, _) => {\\n      append_eff_errs(errors, check_mutability_expr(callee, mutable))\\n      let mut ai = 0\\n      while ai < Array::length(args) {\\n        append_eff_errs(errors, check_mutability_expr(Array::get(args, ai), mutable))\\n        ai = ai + 1\\n      }\\n      errors\\n    },\\n    EFn(_, _, params, _, _, body) => {\\n      append_eff_errs(errors, check_mutability_expr(body, mut_with_params(mutable, params)))\\n      errors\\n    },\\n    EHandle(body, arms) => {\\n      append_eff_errs(errors, check_mutability_expr(body, mutable))\\n      let mut ai = 0\\n      while ai < Array::length(arms) {\\n        let (pat, arm_body) = Array::get(arms, ai)\\n        append_eff_errs(errors, check_mutability_expr(arm_body, mut_with_pat(mutable, pat)))\\n        ai = ai + 1\\n      }\\n      errors\\n    },\\n    ELet(_, val, body, _) => {\\n      append_eff_errs(errors, check_mutability_expr(val, mutable))\\n      append_eff_errs(errors, check_mutability_expr(body, mutable))\\n      errors\\n    },\\n    ELetRec(_, val, body) => {\\n      append_eff_errs(errors, check_mutability_expr(val, mutable))\\n      append_eff_errs(errors, check_mutability_expr(body, mutable))\\n      errors\\n    },\\n    ELetMut(name, val, body, _) => {\\n      append_eff_errs(errors, check_mutability_expr(val, mutable))\\n      append_eff_errs(errors, check_mutability_expr(body, mut_with(mutable, name)))\\n      errors\\n    },\\n    ESeq(a, b) => {\\n      append_eff_errs(errors, check_mutability_expr(a, mutable))\\n      append_eff_errs(errors, check_mutability_expr(b, mutable))\\n      errors\\n    },\\n    EIf(cond, then_e, else_e) => {\\n      append_eff_errs(errors, check_mutability_expr(cond, mutable))\\n      append_eff_errs(errors, check_mutability_expr(then_e, mutable))\\n      append_eff_errs(errors, check_mutability_expr(else_e, mutable))\\n      errors\\n    },\\n    EMatch(scrutinee, arms) => {\\n      append_eff_errs(errors, check_mutability_expr(scrutinee, mutable))\\n      let mut ai = 0\\n      while ai < Array::length(arms) {\\n        let (pat, arm_body) = Array::get(arms, ai)\\n        append_eff_errs(errors, check_mutability_expr(arm_body, mut_with_pat(mutable, pat)))\\n        ai = ai + 1\\n      }\\n      errors\\n    },\\n    EWhile(cond, body) => {\\n      append_eff_errs(errors, check_mutability_expr(cond, mutable))\\n      append_eff_errs(errors, check_mutability_expr(body, mutable))\\n      errors\\n    },\\n    ELoop(params, body) => {\\n      let loopmut = Array::slice(mutable, 0, Array::length(mutable))\\n      let mut i = 0\\n      while i < Array::length(params) {\\n        let (pname, init) = Array::get(params, i)\\n        append_eff_errs(errors, check_mutability_expr(init, mutable))\\n        Array::push(loopmut, pname)\\n        i = i + 1\\n      }\\n      append_eff_errs(errors, check_mutability_expr(body, loopmut))\\n      errors\\n    },\\n    EForIn(name, index_name, iter, body) => {\\n      append_eff_errs(errors, check_mutability_expr(iter, mutable))\\n      let base = mut_with(mutable, name)\\n      let formut = match index_name {\\n        Some(idx) => mut_with(base, idx),\\n        None => base\\n      }\\n      append_eff_errs(errors, check_mutability_expr(body, formut))\\n      errors\\n    },\\n    EBinOp(_, left, right) => {\\n      append_eff_errs(errors, check_mutability_expr(left, mutable))\\n      append_eff_errs(errors, check_mutability_expr(right, mutable))\\n      errors\\n    },\\n    EReturn(e) => check_mutability_expr(e, mutable),\\n    EUnaryOp(_, operand) => check_mutability_expr(operand, mutable),\\n    EAssign(name, val, cont) => {\\n      if !mut_has(mutable, name) {\\n        Array::push(errors, EEAssignImmutable(name))\\n      } else {\\n        ()\\n      }\\n      append_eff_errs(errors, check_mutability_expr(val, mutable))\\n      append_eff_errs(errors, check_mutability_expr(cont, mutable))\\n      errors\\n    },\\n    EAssignOp(name, _, val, cont) => {\\n      if !mut_has(mutable, name) {\\n        Array::push(errors, EEAssignImmutable(name))\\n      } else {\\n        ()\\n      }\\n      append_eff_errs(errors, check_mutability_expr(val, mutable))\\n      append_eff_errs(errors, check_mutability_expr(cont, mutable))\\n      errors\\n    },\\n    EDot(obj, _, _, _) => check_mutability_expr(obj, mutable),\\n    ETuple(elems) => {\\n      let mut ei = 0\\n      while ei < Array::length(elems) {\\n        append_eff_errs(errors, check_mutability_expr(Array::get(elems, ei), mutable))\\n        ei = ei + 1\\n      }\\n      errors\\n    },\\n    EArray(elems) => {\\n      let mut ei = 0\\n      while ei < Array::length(elems) {\\n        append_eff_errs(errors, check_mutability_expr(Array::get(elems, ei), mutable))\\n        ei = ei + 1\\n      }\\n      errors\\n    },\\n    ERecord(_, fields, _) => {\\n      let mut fi = 0\\n      while fi < Array::length(fields) {\\n        let (_, fval) = Array::get(fields, fi)\\n        append_eff_errs(errors, check_mutability_expr(fval, mutable))\\n        fi = fi + 1\\n      }\\n      errors\\n    },\\n    // #629 step 3-2: forms previously dropped to `_ => errors`, so an illegal\\n    // reassignment (`x = e` where x is an immutable `let`) sitting inside a map\\n    // literal, labeled argument, spread, break value, or continue argument went\\n    // unflagged. Recurse with the SAME mutable set (these forms introduce no new\\n    // bindings), keeping the pass sound: still no false positives, just fewer\\n    // false negatives.\\n    EMap(entries) => {\\n      let mut mi = 0\\n      while mi < Array::length(entries) {\\n        let (_, mval) = Array::get(entries, mi)\\n        append_eff_errs(errors, check_mutability_expr(mval, mutable))\\n        mi = mi + 1\\n      }\\n      errors\\n    },\\n    ELabeledArg(_, _, inner) => check_mutability_expr(inner, mutable),\\n    ESpread(inner) => check_mutability_expr(inner, mutable),\\n    EBreak(opt) => match opt {\\n      Some(e) => check_mutability_expr(e, mutable),\\n      None => errors\\n    },\\n    EContinue(cargs) => {\\n      let mut ci = 0\\n      while ci < Array::length(cargs) {\\n        append_eff_errs(errors, check_mutability_expr(Array::get(cargs, ci), mutable))\\n        ci = ci + 1\\n      }\\n      errors\\n    },\\n    _ => errors\\n  }\\n}\\n\\n// #770: `outer` carries the top-level `let mut` names already in scope from\\n// earlier sibling statements (see check_mutability_stmts below) so a later\\n// top-level statement's assignment to an earlier top-level `mut` binding\\n// (directly, or via a closure capturing it) is recognized as mutable instead\\n// of being misreported as `cannot assign to immutable binding`.\\nfn check_mutability_binding(body: Expr, outer: Array[String]) -> Array[EffectError] {\\n  match body {\\n    EFn(_, _, params, _, _, fbody) => check_mutability_expr(fbody, mut_with_params(outer, params)),\\n    _ => check_mutability_expr(body, outer)\\n  }\\n}\\n\\n// #770: top-level program statements are a flat `Array[Stmt]` sequence (not\\n// nested `ELetMut` continuations like a function/test body), so a top-level\\n// `let mut x = ...` must thread `x` forward into the mutability check of\\n// every later sibling statement by accumulating `mutable` across the loop —\\n// mirroring how `check_stmts` threads `env` across the same array. Before\\n// this fix each statement was checked in isolation starting from an empty\\n// mutable set, so any top-level `let mut` followed by an assignment in a\\n// later top-level statement (e.g. a top-level `while` loop mutating a\\n// counter) was rejected with a bogus `cannot assign to immutable binding`\\n// error even though the program is valid.\\nexport fn check_mutability_stmts(stmts: Array[Stmt]) -> Array[EffectError] {\\n  let errors = Array::slice([\\n    EEThrowOutsideEffect(\\\"\\\")\\n  ], 0, 0)\\n  let mut mutable = Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n  let mut i = 0\\n  while i < Array::length(stmts) {\\n    match Array::get(stmts, i) {\\n      SLet(_, _, _, _, body) => append_eff_errs(errors, check_mutability_binding(body, mutable)),\\n      SLetMut(name, _, body) => {\\n        append_eff_errs(errors, check_mutability_binding(body, mutable))\\n        mutable = mut_with(mutable, name)\\n      },\\n      STest(_, body) => append_eff_errs(errors, check_mutability_expr(body, Array::slice([\\n        \\\"\\\"\\n      ], 0, 0))),\\n      SBench(_, body) => append_eff_errs(errors, check_mutability_expr(body, Array::slice([\\n        \\\"\\\"\\n      ], 0, 0))),\\n      SExpr(e) => append_eff_errs(errors, check_mutability_expr(e, mutable)),\\n      _ => ()\\n    }\\n    i = i + 1\\n  }\\n  errors\\n}\\n\")\n}\n\nlet cli_adapter_source_46 = () -> (String, String) {\n  (\"lib/@vibe/compiler/checker/checker.vibe\",\n\"//# Imports\\n\\nimport ../core/index.vibe {\\n  Expr, Pat, TypeExpr, Subst, Type, TypeDef, TypeEnv, env_bind, env_lookup, find_typedef, fresh_var, generalize, instantiate, resolve_builtin, subst_add_bound, subst_apply, subst_bounds_for, trait_method_sig_deep, type_implements_trait, type_name_has_iterator_impl, type_to_string, unify\\n}\\n\\nimport ./builtins.vibe {\\n  lookup_builtin\\n}\\n\\nimport ./checker_exhaustive.vibe {\\n  match_nonexhaustive_witness\\n}\\n\\nimport ./checker_pattern.vibe {\\n  check_pattern, pat_has_unsupported_or_binding\\n}\\n\\nimport ./checker_resolve.vibe {\\n  resolve_type_expr, subst_type_params\\n}\\n\\n//# Functions\\n\\nfn min_int(a: Int, b: Int) -> Int {\\n  if a < b {\\n    a\\n  } else {\\n    b\\n  }\\n}\\n\\n// Encode a real AST char offset into a strippable diagnostic marker so the\\n// located-diagnostics layer (typecheck_fs.vibe::locate_type_error) can decode\\n// the exact line:col instead of falling back to a first-occurrence text scan.\\n// String::concat only (never `+` / interpolation — both mis-codegen to NUL in\\n// selfhost). off < 0 => no marker (heuristic fallback retained).\\nfn off_marker(off: Int) -> String {\\n  if off >= 0 {\\n    String::concat(\\\" [@off=\\\", String::concat(__to_string(off), \\\"]\\\"))\\n  } else {\\n    \\\"\\\"\\n  }\\n}\\n\\n// Like off_marker but also encodes the offending token's END offset as\\n// `[@off=N:M]` (M = off + len), so the located-diagnostics layer can emit an\\n// EXACT source range (line:colC-E) instead of the LSP guessing the token end\\n// with a word-scan — which mis-handles qualified names like `Mod.foo` (the scan\\n// stops at the dot). Falls back to the start-only marker when len <= 0. Use this\\n// where `off` is the START of a known-length named token (the symbol whose\\n// length matches the source span); keep plain off_marker where the offset is an\\n// anchor rather than the token start (e.g. a field error whose offset is the\\n// base expr). String::concat only (NUL-miscodegen hazard for `+`/interpolation).\\nfn off_marker_len(off: Int, len: Int) -> String {\\n  if off >= 0 && len > 0 {\\n    String::concat(\\\" [@off=\\\", String::concat(__to_string(off), String::concat(\\\":\\\", String::concat(__to_string(off + len), \\\"]\\\"))))\\n  } else {\\n    off_marker(off)\\n  }\\n}\\n\\nfn prepend_expr(first: Expr, rest: Array[Expr]) -> Array[Expr] {\\n  let out = Array::slice([\\n    EUnit\\n  ], 0, 0)\\n  Array::push(out, first)\\n  let mut i = 0\\n  while i < Array::length(rest) {\\n    Array::push(out, Array::get(rest, i))\\n    i = i + 1\\n  }\\n  out\\n}\\n\\n// Replace the abstract `Self` type (resolved as `CtNamed(\\\"Self\\\", _)`) inside a\\n// trait-method signature with the concrete receiver type, when typing a\\n// `T::method` call against a bounded generic parameter T.\\nfn subst_self_in_type(ty: Type, self_ty: Type) -> Type {\\n  match ty {\\n    CtNamed(n, args) => if n == \\\"Self\\\" {\\n      self_ty\\n    } else {\\n      let ra = for a in args {\\n        subst_self_in_type(a, self_ty)\\n      }\\n      CtNamed(n, ra)\\n    },\\n    CtArray(e) => CtArray(subst_self_in_type(e, self_ty)),\\n    CtOption(e) => CtOption(subst_self_in_type(e, self_ty)),\\n    CtTuple(elems) => CtTuple(for e in elems {\\n      subst_self_in_type(e, self_ty)\\n    }),\\n    CtFn(ps, ret, eff) => CtFn(for p in ps {\\n      subst_self_in_type(p, self_ty)\\n    }, subst_self_in_type(ret, self_ty), eff),\\n    _ => ty\\n  }\\n}\\n\\n// Relax a trait type parameter (e.g. the `T` in `Iterator[T] { next(Self) ->\\n// Option[T] }`) to `CtUnknown` so it unifies at the call site. A name that\\n// resolves to a real type (primitive or declared) is kept; only truly-unknown\\n// named types — the trait's own element type params, which the uniform\\n// representation erases — are relaxed. (#636.)\\nfn relax_unknown_named(ty: Type, defs: Array[TypeDef]) -> Type {\\n  match ty {\\n    CtNamed(n, args) => {\\n      let known = match find_typedef(defs, n) {\\n        Some(_) => true,\\n        None => match resolve_builtin(n) {\\n          Some(_) => true,\\n          None => false\\n        }\\n      }\\n      if known {\\n        CtNamed(n, for a in args {\\n          relax_unknown_named(a, defs)\\n        })\\n      } else {\\n        CtUnknown\\n      }\\n    },\\n    CtArray(e) => CtArray(relax_unknown_named(e, defs)),\\n    CtOption(e) => CtOption(relax_unknown_named(e, defs)),\\n    CtTuple(es) => CtTuple(for e in es {\\n      relax_unknown_named(e, defs)\\n    }),\\n    CtFn(ps, r, eff) => CtFn(for p in ps {\\n      relax_unknown_named(p, defs)\\n    }, relax_unknown_named(r, defs), eff),\\n    _ => ty\\n  }\\n}\\n\\n// Resolve a qualified identifier `T::method` where `T` is a bounded generic\\n// type parameter (`[T: Trait]`). If the head resolves to a type variable whose\\n// recorded bounds include a trait declaring `method`, return that method's\\n// signature with `Self` substituted by T. Returns None for any other qualified\\n// name (concrete `Type::method`, module-qualified names, etc.) so the existing\\n// resolution paths are untouched. (PR-3 component 2.)\\nfn resolve_trait_method_ident(name: String, env: TypeEnv, defs: Array[TypeDef], s: Subst) -> Option[Type] {\\n  let idx = String::index_of(name, \\\"::\\\")\\n  if idx < 0 {\\n    None\\n  } else {\\n    let head = String::substring(name, 0, idx)\\n    let method = String::substring(name, idx + 2, String::length(name))\\n    match env_lookup(env, head) {\\n      Some(head_ty) => match head_ty {\\n        CtVar(vid) => {\\n          let bounds = subst_bounds_for(s, vid)\\n          let self_ty = CtVar(vid)\\n          let mut result = None\\n          let mut bi = 0\\n          while bi < Array::length(bounds) {\\n            let pending = match result {\\n              None => true,\\n              _ => false\\n            }\\n            if pending {\\n              let trait_name = Array::get(bounds, bi)\\n              match trait_method_sig_deep(env, trait_name, method) {\\n                Some(sig) => {\\n                  let (params_te, ret_te) = sig\\n                  let resolved_params = for pte in params_te {\\n                    relax_unknown_named(subst_self_in_type(resolve_type_expr(pte, defs), self_ty), defs)\\n                  }\\n                  let resolved_ret = relax_unknown_named(subst_self_in_type(resolve_type_expr(ret_te, defs), self_ty), defs)\\n                  result = Some(CtFn(resolved_params, resolved_ret, None))\\n                },\\n                None => ()\\n              }\\n            } else {\\n              ()\\n            }\\n            bi = bi + 1\\n          }\\n          result\\n        },\\n        _ => None\\n      },\\n      None => None\\n    }\\n  }\\n}\\n\\n// Resolve a qualified constructor reference `Enum::Variant` (e.g. `Color::Red`,\\n// `Sh::Circle`) to the bare variant's constructor type. The bare variant name\\n// is already bound in `env` by the SEnum case; we only confirm `head` names a\\n// known enum that actually owns `member` (so unrelated `T::method` names fall\\n// through to the `unknown name` path). Returns the polymorphic env type as-is;\\n// callers instantiate it exactly like a bare ident. (#672 qualified ctors.)\\nfn resolve_qualified_ctor_ident(name: String, env: TypeEnv, defs: Array[TypeDef]) -> Option[Type] {\\n  let idx = String::index_of(name, \\\"::\\\")\\n  if idx < 0 {\\n    None\\n  } else {\\n    let head = String::substring(name, 0, idx)\\n    let member = String::substring(name, idx + 2, String::length(name))\\n    match find_typedef(defs, head) {\\n      Some(TDEnum(_, _, variants)) => {\\n        let mut found = false\\n        let mut vi = 0\\n        while vi < Array::length(variants) {\\n          let (vname, _) = Array::get(variants, vi)\\n          if vname == member {\\n            found = true\\n          } else {\\n            ()\\n          }\\n          vi = vi + 1\\n        }\\n        if found {\\n          env_lookup(env, member)\\n        } else {\\n          None\\n        }\\n      },\\n      _ => None\\n    }\\n  }\\n}\\n\\nfn expr_ident_name_or_empty(expr: Expr) -> String {\\n  match expr {\\n    EIdent(name, _) => name,\\n    _ => \\\"\\\"\\n  }\\n}\\n\\n// Erase every effect annotation in a type (recursively), so an argument can be\\n// checked for STRUCTURAL compatibility independent of effects. Effects on\\n// function VALUES are inferred imprecisely (a `with { Error }` callback often\\n// arrives typed with no effect), so an effect-only difference must not be\\n// reported as a type error — only the structural shape is enforced here.\\nfn strip_effects(ty: Type) -> Type {\\n  match ty {\\n    CtFn(params, ret, _) => {\\n      let out = Array::slice([\\n        CtUnknown\\n      ], 0, 0)\\n      let mut i = 0\\n      while i < Array::length(params) {\\n        Array::push(out, strip_effects(Array::get(params, i)))\\n        i = i + 1\\n      }\\n      CtFn(out, strip_effects(ret), None)\\n    },\\n    CtArray(elem) => CtArray(strip_effects(elem)),\\n    CtOption(elem) => CtOption(strip_effects(elem)),\\n    CtTuple(elems) => {\\n      let out = Array::slice([\\n        CtUnknown\\n      ], 0, 0)\\n      let mut i = 0\\n      while i < Array::length(elems) {\\n        Array::push(out, strip_effects(Array::get(elems, i)))\\n        i = i + 1\\n      }\\n      CtTuple(out)\\n    },\\n    CtNamed(name, args) => {\\n      let out = Array::slice([\\n        CtUnknown\\n      ], 0, 0)\\n      let mut i = 0\\n      while i < Array::length(args) {\\n        Array::push(out, strip_effects(Array::get(args, i)))\\n        i = i + 1\\n      }\\n      CtNamed(name, out)\\n    },\\n    _ => ty\\n  }\\n}\\n\\n// True when a type is fully ground (mentions no type parameter / type\\n// variable). An unresolved type name resolves to `CtNamed(_, _)` (see\\n// resolve_type_expr), which for a struct field or function parameter means a\\n// generic parameter like `T`; `CtVar`/`CtForAll` are likewise non-ground. Used\\n// both to restrict record struct-identity recovery to MONOMORPHIC structs (a\\n// bare `CtStruct(LazyIter)` would erase the element type that `for x in it`\\n// relies on) and to gate structural-mismatch reporting to concrete types.\\n// #635: does a match-arm body DIVERGE (early-`return`), yielding no value to the\\n// match? The `?`-operator desugar lowers `val?` to\\n//   match val { Some(v) => v, None => return None }\\n// whose `None` arm is `return None` — it must not force the match's result type\\n// (else `T` vs `Option[T]` clashes). A diverging arm is a bare `return`, or a\\n// block (`ESeq`) whose final expr diverges.\\nfn arm_body_diverges(body: Expr) -> Bool {\\n  match body {\\n    EReturn(_) => true,\\n    ESeq(_, rest) => arm_body_diverges(rest),\\n    _ => false\\n  }\\n}\\n\\n// #941: the railway monad HEAD of a type — 1 for Option, 2 for Result, 0 for\\n// anything else. `Option[T]` is the builtin `CtOption`; the prelude `Result`\\n// is an injected user-level enum, so a constructed value surfaces as\\n// `CtNamed(\\\"Result\\\", args)` (or bare `CtEnum(\\\"Result\\\")`). Mixing the two\\n// monads on one railway (`?` / `let*` — docs/cheatsheet.md #635) is documented\\n// as a type error, but `check_assignable` tolerates the pair silently: a\\n// `CtNamed` head is kind 0 in `head_kind` (it may be a rigid type parameter)\\n// and makes `type_no_named` false, so NEITHER report gate fires and the\\n// mismatch sailed through to a runtime `unreachable` trap. The name-based\\n// check below is safe precisely because \\\"Result\\\"/\\\"Option\\\" as heads are the\\n// prelude monads — a rigid type parameter never carries those names.\\nfn railway_head(t: Type) -> Int {\\n  match t {\\n    CtOption(_) => 1,\\n    CtEnum(n) => if n == \\\"Result\\\" {\\n      2\\n    } else if n == \\\"Option\\\" {\\n      1\\n    } else {\\n      0\\n    },\\n    CtNamed(n, _) => if n == \\\"Result\\\" {\\n      2\\n    } else if n == \\\"Option\\\" {\\n      1\\n    } else {\\n      0\\n    },\\n    _ => 0\\n  }\\n}\\n\\n// #941: true when `expected` and `actual` sit on DIFFERENT railway monads\\n// (one Option-headed, the other Result-headed). No instantiation of inner\\n// type parameters can ever reconcile the two heads, so this is a genuine\\n// mismatch even though both types mention type variables / named params.\\nfn railway_heads_conflict(expected: Type, actual: Type) -> Bool {\\n  let he = railway_head(expected)\\n  let ha = railway_head(actual)\\n  he != 0 && ha != 0 && he != ha\\n}\\n\\n// #941: best-effort source anchor for a (possibly desugar-generated) expr —\\n// the first real char offset found walking into the value position, or -1.\\n// The railway desugar (#635) threads the `?`/`let*` operand's offset into its\\n// generated `Err(..)`/`None` failure-track nodes, so the mixing diagnostics\\n// below locate at the offending operand.\\nfn railway_expr_off(e: Expr) -> Int {\\n  match e {\\n    EIdent(_, off) => off,\\n    ECall(callee, _, off) => if off >= 0 {\\n      off\\n    } else {\\n      railway_expr_off(callee)\\n    },\\n    EDot(base, _, off, _) => if off >= 0 {\\n      off\\n    } else {\\n      railway_expr_off(base)\\n    },\\n    EBinOp(_, lhs, _) => railway_expr_off(lhs),\\n    EMatch(scrut, _) => railway_expr_off(scrut),\\n    ESeq(first, _) => railway_expr_off(first),\\n    _ => 0 - 1\\n  }\\n}\\n\\nfn type_is_ground(t: Type) -> Bool {\\n  match t {\\n    CtNamed(_, _) => false,\\n    CtVar(_) => false,\\n    CtForAll(_, _, _) => false,\\n    CtTuple(items) => {\\n      let mut ok = true\\n      let mut i = 0\\n      while i < Array::length(items) {\\n        if !type_is_ground(Array::get(items, i)) {\\n          ok = false\\n        }\\n        i = i + 1\\n      }\\n      ok\\n    },\\n    CtArray(e) => type_is_ground(e),\\n    CtOption(e) => type_is_ground(e),\\n    CtFn(ps, r, _) => {\\n      let mut ok = type_is_ground(r)\\n      let mut i = 0\\n      while i < Array::length(ps) {\\n        if !type_is_ground(Array::get(ps, i)) {\\n          ok = false\\n        }\\n        i = i + 1\\n      }\\n      ok\\n    },\\n    _ => true\\n  }\\n}\\n\\n// True when a type mentions no RIGID type parameter (`CtNamed` / `CtForAll`) but\\n// MAY contain inference variables (`CtVar`). Used to recognise an `actual` type\\n// whose only flexibility is unification variables: if such a type fails to unify\\n// against a fully GROUND expected type, no instantiation of its variables can\\n// make it match, so the mismatch is real (unlike an un-instantiated generic\\n// param `CtNamed(T)`, which the checker simply has not substituted yet).\\nfn type_no_named(t: Type) -> Bool {\\n  match t {\\n    CtNamed(_, _) => false,\\n    CtForAll(_, _, _) => false,\\n    CtTuple(items) => {\\n      let mut ok = true\\n      let mut i = 0\\n      while i < Array::length(items) {\\n        if !type_no_named(Array::get(items, i)) {\\n          ok = false\\n        }\\n        i = i + 1\\n      }\\n      ok\\n    },\\n    CtArray(e) => type_no_named(e),\\n    CtOption(e) => type_no_named(e),\\n    CtFn(ps, r, _) => {\\n      let mut ok = type_no_named(r)\\n      let mut i = 0\\n      while i < Array::length(ps) {\\n        if !type_no_named(Array::get(ps, i)) {\\n          ok = false\\n        }\\n        i = i + 1\\n      }\\n      ok\\n    },\\n    _ => true\\n  }\\n}\\n\\n// A small tag for a type's TOP-LEVEL constructor, or 0 for a type whose head is\\n// not concrete (a type variable / unresolved named param / unknown / forall).\\n// Two types with DIFFERENT non-zero heads can never be made equal by any\\n// instantiation of their inner type parameters (an `Int` is never an `Array[T]`\\n// for any `T`), so such a unify failure is a real mismatch even when the inner\\n// parts are generic — which the whole-type groundness gate misses.\\nfn head_kind(t: Type) -> Int {\\n  match t {\\n    CtInt => 1,\\n    CtDouble => 2,\\n    CtBool => 3,\\n    CtString => 4,\\n    CtChar => 5,\\n    CtUnit => 6,\\n    CtBytes => 7,\\n    CtTuple(_) => 8,\\n    CtArray(_) => 9,\\n    CtOption(_) => 10,\\n    CtStruct(_) => 11,\\n    CtEnum(_) => 12,\\n    CtFn(_, _, _) => 13,\\n    _ => 0\\n  }\\n}\\n\\n// #827: `Stream[T]` is `CtNamed` (head_kind 0 = tolerated), so the Array\\n// builtins' receiver head check let `Array::length(stream)` / `Array::get(s,\\n// 0)` through — observably leaking the eager Array-backed representation\\n// (ADR-0012) into user programs. Recognise a Stream receiver so the Array\\n// head-check sites can reject it explicitly; head_kind itself is unchanged\\n// (other CtNamed heads stay tolerated, the #826 discipline).\\nfn is_stream_named_type(t: Type) -> Bool {\\n  match t {\\n    CtNamed(n, _) => n == \\\"Stream\\\",\\n    _ => false\\n  }\\n}\\n\\n// True when every declared field type of a struct is ground (the struct is not\\n// generic). `S::{ ... }` for such a struct can safely be typed `CtStruct(S)`.\\nfn struct_fields_ground(dfields: Array[(String, Type)]) -> Bool {\\n  let mut ok = true\\n  let mut i = 0\\n  while i < Array::length(dfields) {\\n    let (_, ft) = Array::get(dfields, i)\\n    if !type_is_ground(ft) {\\n      ok = false\\n    }\\n    i = i + 1\\n  }\\n  ok\\n}\\n\\n// #939 helpers: detect a function VALUE laundering a concrete effect row away\\n// through a pure-typed slot (HOF argument, let/struct-field/array annotation).\\n// The strip_effects fallback below deliberately tolerates effect-only\\n// differences — but for CONCRETE, non-exempt labels flowing in a COVARIANT\\n// position that tolerance is the #939 soundness hole: the value's perform\\n// executes with no handler and the program dies with an unhandled wasm\\n// exception at runtime. Exemptions mirror checker_effects' transitive pass:\\n// `Error` (pervasive un-annotated throw sites, #640), `Async`\\n// (composition-allowed), and effect VARIABLES (single lowercase letter /\\n// `$N` fresh vars — not decidable without call-site row unification, #885).\\nfn effect_label_is_exempt(lbl: String) -> Bool {\\n  let len = String::length(lbl)\\n  if lbl == \\\"Error\\\" || lbl == \\\"Async\\\" {\\n    true\\n  } else if len == 1 {\\n    String::char_code_at(lbl, 0) >= 97 && String::char_code_at(lbl, 0) <= 122\\n  } else if len >= 2 {\\n    String::char_code_at(lbl, 0) == 36\\n  } else {\\n    true\\n  }\\n}\\n\\nfn row_labels(row: Option[String]) -> Array[String] {\\n  match row {\\n    Some(r) => {\\n      let parts = String::split(r, \\\",\\\")\\n      let out = Array::slice([\\n        \\\"\\\"\\n      ], 0, 0)\\n      let mut i = 0\\n      while i < Array::length(parts) {\\n        let t = String::trim(Array::get(parts, i))\\n        if String::length(t) > 0 {\\n          Array::push(out, t)\\n        } else {\\n          ()\\n        }\\n        i = i + 1\\n      }\\n      out\\n    },\\n    None => Array::slice([\\n      \\\"\\\"\\n    ], 0, 0)\\n  }\\n}\\n\\nfn row_contains_label(row: Option[String], lbl: String) -> Bool {\\n  let labels = row_labels(row)\\n  let mut i = 0\\n  let mut found = false\\n  while i < Array::length(labels) && !found {\\n    if Array::get(labels, i) == lbl {\\n      found = true\\n    } else {\\n      i = i + 1\\n    }\\n  }\\n  found\\n}\\n\\n// First concrete, non-exempt effect label whose drop would let a perform run\\n// with no handler. At each CtFn the ACTUAL side's own row must not carry a\\n// label the EXPECTED side's row lacks; the return type recurses covariantly;\\n// PARAMETER positions recurse with expected/actual SWAPPED (contravariance —\\n// Codex P1 on #978: an `((Int) -> Int with { Logger }, Int) -> Int` slot\\n// holding a pure-callback fn lets `h(eff, 1)` type-check while the callee\\n// invokes the effectful callback with no handler, so at parameter positions\\n// it is the EXPECTED param's concrete labels that must be tolerated by the\\n// ACTUAL param). pure→effectful still passes in both directions by\\n// construction, and an effectful parameter slot accepting a pure function\\n// stays legal (the swap makes that the label-free side).\\nfn effect_row_dropped(expected: Type, actual: Type) -> Option[String] {\\n  match expected {\\n    CtFn(eparams, eret, eeff) => match actual {\\n      CtFn(aparams, aret, aeff) => {\\n        let alabels = row_labels(aeff)\\n        let mut i = 0\\n        let mut dropped = None\\n        let mut done = false\\n        while i < Array::length(alabels) && !done {\\n          let lbl = Array::get(alabels, i)\\n          if !effect_label_is_exempt(lbl) && !row_contains_label(eeff, lbl) {\\n            dropped = Some(lbl)\\n            done = true\\n          } else {\\n            ()\\n          }\\n          i = i + 1\\n        }\\n        if !done && Array::length(eparams) == Array::length(aparams) {\\n          let mut pi = 0\\n          while pi < Array::length(eparams) && !done {\\n            match effect_row_dropped(Array::get(aparams, pi), Array::get(eparams, pi)) {\\n              Some(pl) => {\\n                dropped = Some(pl)\\n                done = true\\n              },\\n              None => ()\\n            }\\n            pi = pi + 1\\n          }\\n        } else {\\n          ()\\n        }\\n        match dropped {\\n          Some(l) => Some(l),\\n          None => effect_row_dropped(eret, aret)\\n        }\\n      },\\n      _ => None\\n    },\\n    CtArray(ee) => match actual {\\n      CtArray(ae) => effect_row_dropped(ee, ae),\\n      _ => None\\n    },\\n    CtOption(ee) => match actual {\\n      CtOption(ae) => effect_row_dropped(ee, ae),\\n      _ => None\\n    },\\n    CtTuple(ees) => match actual {\\n      CtTuple(aes) => if Array::length(ees) == Array::length(aes) {\\n        let mut i = 0\\n        let mut dropped = None\\n        let mut done = false\\n        while i < Array::length(ees) && !done {\\n          match effect_row_dropped(Array::get(ees, i), Array::get(aes, i)) {\\n            Some(d) => {\\n              dropped = Some(d)\\n              done = true\\n            },\\n            None => ()\\n          }\\n          i = i + 1\\n        }\\n        dropped\\n      } else {\\n        None\\n      },\\n      _ => None\\n    },\\n    CtNamed(en, eargs) => match actual {\\n      CtNamed(an, aargs) => if en == an && Array::length(eargs) == Array::length(aargs) {\\n        let mut i = 0\\n        let mut dropped = None\\n        let mut done = false\\n        while i < Array::length(eargs) && !done {\\n          match effect_row_dropped(Array::get(eargs, i), Array::get(aargs, i)) {\\n            Some(d) => {\\n              dropped = Some(d)\\n              done = true\\n            },\\n            None => ()\\n          }\\n          i = i + 1\\n        }\\n        dropped\\n      } else {\\n        None\\n      },\\n      _ => None\\n    },\\n    _ => None\\n  }\\n}\\n\\n// Unify `expected` with `actual`, REPORTING only a genuine STRUCTURAL mismatch\\n// (the checker historically swallowed these, accepting ill-typed programs).\\n// `unify` already accepts `CtUnknown`/`CtVar` freely; on failure we retry with\\n// effects erased, and tolerate the difference if the structure matches — effect\\n// inference on function values is imprecise, so effect-only differences must not\\n// be reported here (EXCEPT a concrete covariant row drop — see\\n// `effect_row_dropped` above, #939). Returns the (possibly extended)\\n// substitution.\\nexport fn check_assignable(expected: Type, actual: Type, s: Subst, errors: Array[String], what: String, off: Int) -> Subst {\\n  match unify(expected, actual, s) {\\n    Some(su) => su,\\n    None => {\\n      let structural = match unify(strip_effects(expected), strip_effects(actual), s) {\\n        Some(_) => true,\\n        None => false\\n      }\\n      // Only report when BOTH sides are fully ground (mention no type parameter\\n      // / type variable). The selfhost checker does not instantiate a generic\\n      // struct field's or function parameter's type params — they surface as\\n      // rigid `CtNamed(T, _)` — so a unify failure against a concrete\\n      // instantiation there is NOT a real mismatch (e.g. a `pull: (Int) ->\\n      // Option[(T, Int)]` field vs a concrete closure). Reporting only on\\n      // ground/ground keeps the genuine concrete-type mismatches (Int vs\\n      // String, struct field of the wrong concrete type) while not\\n      // over-rejecting polymorphic code.\\n      // Report when the EXPECTED type is fully ground and the ACTUAL type\\n      // mentions no rigid type parameter (inference variables are fine). A\\n      // unify failure under those conditions is genuine: no instantiation of\\n      // the actual's variables can satisfy the concrete expected type (this is\\n      // what catches `let g: (Int) -> String = (n) -> { n }`). A non-ground\\n      // expected, or an actual carrying an un-instantiated generic `CtNamed`,\\n      // is still tolerated to avoid over-rejecting polymorphic code.\\n      let reportable = type_is_ground(subst_apply(s, expected)) && type_no_named(subst_apply(s, actual))\\n      // Also report when the two types have DIFFERENT concrete top-level\\n      // constructors (e.g. `Array[T]` vs `Int` from `Array::length(5)`): no\\n      // instantiation of inner type parameters can reconcile them, so it is a\\n      // real mismatch even though the expected type is non-ground. A\\n      // var/named/unknown head (kind 0) on either side stays tolerated.\\n      let eh = head_kind(subst_apply(s, expected))\\n      let ah = head_kind(subst_apply(s, actual))\\n      let head_differ = eh != 0 && ah != 0 && eh != ah\\n      if structural {\\n        // #939: the structural retry tolerated EVERY effect-only difference,\\n        // including a function value whose CONCRETE row silently vanishes\\n        // into a pure-typed slot (HOF argument, let / struct field / array\\n        // annotation) — the perform then runs with no handler and dies as an\\n        // unhandled wasm exception at runtime. Report exactly that shape;\\n        // pure→effectful subsumption and Error/Async/effect-var differences\\n        // stay tolerated (see effect_row_dropped).\\n        match effect_row_dropped(subst_apply(s, expected), subst_apply(s, actual)) {\\n          Some(lbl) => {\\n            Array::push(errors, String::concat(what, String::concat(\\\": effect row mismatch: a value of type \\\", String::concat(type_to_string(subst_apply(s, actual)), String::concat(\\\" cannot be used where \\\", String::concat(type_to_string(subst_apply(s, expected)), String::concat(\\\" is expected (the { \\\", String::concat(lbl, String::concat(\\\" } effect would be dropped — no handler could ever run)\\\", off_marker(off))))))))))\\n            s\\n          },\\n          None => s\\n        }\\n      } else if !(reportable || head_differ) {\\n        // #981: a user generic type's ARGUMENTS were never compared here — a\\n        // `CtNamed` head is kind 0 (tolerated by `head_differ`) and makes\\n        // `type_no_named(actual)` false, so `get_int(b)` with\\n        // `b: Box[String]` against `Box[Int]` sailed through this branch\\n        // silently (compile clean, heap-pointer garbage at runtime), while\\n        // the symmetric builtin (`Array[String]` vs `Array[Int]`) and the\\n        // RETURN position were both rejected. Close exactly that hole with\\n        // the proven #844 predicate (`detect_narrowed_generic_mismatch`):\\n        // report ONLY a same-name, same-arity (> 0), fully-concrete `CtNamed`\\n        // pair whose arguments fail to unify — a rigid/uninstantiated type\\n        // parameter surfaces as `CtNamed(T, [])` / the `[CtUnknown]` sentinel\\n        // and stays tolerated, so polymorphic code is not over-rejected.\\n        // Additionally gate on the RAW expected type (BEFORE subst) being\\n        // fully concrete: an expected that only became concrete through this\\n        // call's own unification is not trustworthy — an IMPORTED generic\\n        // fn's signature can cross-talk its type params through the flat\\n        // import env (measured: `list_zip[A, B]` imported from\\n        // lib/@vibe/core/list.vibe reported `expected List[String], got\\n        // List[Int]` on its second argument — A's binding leaked into B's\\n        // slot), and reporting that shape would reject valid polymorphic\\n        // calls. A monomorphic signature (the #981 hole) is concrete without\\n        // any substitution, so the genuine cases all keep reporting.\\n        if type_fully_concrete(expected) {\\n          detect_narrowed_generic_mismatch(expected, actual, s, errors, what, off)\\n        } else {\\n          s\\n        }\\n      } else {\\n        Array::push(errors, String::concat(what, String::concat(\\\": expected \\\", String::concat(type_to_string(subst_apply(s, expected)), String::concat(\\\", got \\\", String::concat(type_to_string(subst_apply(s, actual)), off_marker(off)))))))\\n        s\\n      }\\n    }\\n  }\\n}\\n\\n// #844: true when `t` mentions no unresolved/rigid type-parameter placeholder\\n// and no unbound unification variable ANYWHERE in its structure -- i.e. it is\\n// a genuinely CONCRETE type. Unlike the more conservative shared\\n// `type_is_ground` (which treats EVERY `CtNamed` as non-ground, to stay safe\\n// for the many call sites that must still tolerate a rigid/uninstantiated\\n// type parameter such as a trait method's `CtNamed(\\\"T\\\", _)` field type), this\\n// recurses into `CtNamed`'s own type arguments. Used ONLY by\\n// `detect_narrowed_generic_mismatch` below (a narrowly-scoped, additive check\\n// for the `let`-annotation erasure hole -- see #844) so this refinement's\\n// blast radius stays contained to that one new check instead of the many\\n// existing `type_is_ground` call sites.\\n//\\n// The sentinel shape `CtNamed(name, [CtUnknown])` is what `resolve_type_expr`\\n// (checker_resolve.vibe) emits for an unresolved rigid single-name type\\n// parameter reference AND for an unresolved/unknown type name alike -- treat\\n// that shape as non-concrete. A REAL instantiated generic type (e.g. #829's\\n// `Box::{v:1}` -> `CtNamed(\\\"Box\\\", [CtInt])`) never carries the bare\\n// `CtUnknown` sentinel as its own argument.\\nfn type_fully_concrete(t: Type) -> Bool {\\n  match t {\\n    CtVar(_) => false,\\n    CtForAll(_, _, _) => false,\\n    CtUnknown => false,\\n    // A `CtNamed` with an EMPTY argument list is ALSO treated as non-concrete\\n    // (not just the `[CtUnknown]` singlet sentinel above): a rigid/uninstantiated\\n    // generic function's own type parameter can leak through, unsubstituted,\\n    // as a bare `CtNamed(pname, [])` when it only appears NESTED inside another\\n    // type's argument list (e.g. `HashMap::new_int[V]() -> HashMap[Int, V]`\\n    // called as `HashMap::new_int()` -- `instantiate` does not always rewrite\\n    // an occurrence of `V` buried inside a struct's own field/return-type\\n    // representation to a fresh `CtVar`, so it can surface literally as\\n    // `CtNamed(\\\"V\\\", [])` instead -- lib/@vibex/collections/hashmap_test.vibe\\n    // hit exactly this via `let m: HashMap[Int, String] = HashMap::new_int()`\\n    // during development of this check). Both shapes are the SAME underlying\\n    // ambiguity (a name with no way to tell \\\"resolved zero-arg nominal type\\\"\\n    // from \\\"unresolved rigid reference\\\" apart) that the shared `type_is_ground`\\n    // sidesteps by always tolerating `CtNamed`; treat both as non-concrete here\\n    // too so this narrowly-scoped check only ever fires when it is SURE both\\n    // sides are fully resolved.\\n    CtNamed(_, args) => {\\n      let is_sentinel = Array::length(args) == 0 || (Array::length(args) == 1 && match Array::get(args, 0) {\\n        CtUnknown => true,\\n        _ => false\\n      })\\n      if is_sentinel {\\n        false\\n      } else {\\n        let mut ok = true\\n        let mut i = 0\\n        while i < Array::length(args) {\\n          if !type_fully_concrete(Array::get(args, i)) {\\n            ok = false\\n          }\\n          i = i + 1\\n        }\\n        ok\\n      }\\n    },\\n    CtTuple(items) => {\\n      let mut ok = true\\n      let mut i = 0\\n      while i < Array::length(items) {\\n        if !type_fully_concrete(Array::get(items, i)) {\\n          ok = false\\n        }\\n        i = i + 1\\n      }\\n      ok\\n    },\\n    CtArray(e) => type_fully_concrete(e),\\n    CtOption(e) => type_fully_concrete(e),\\n    CtFn(ps, r, _) => {\\n      let mut ok = type_fully_concrete(r)\\n      let mut i = 0\\n      while i < Array::length(ps) {\\n        if !type_fully_concrete(Array::get(ps, i)) {\\n          ok = false\\n        }\\n        i = i + 1\\n      }\\n      ok\\n    },\\n    _ => true\\n  }\\n}\\n\\n// #844: `resolve_type_expr` types a BARE (unparameterized) reference to a\\n// generic struct annotation (`let x: Box = ...`) as bare `CtStruct(\\\"Box\\\")`,\\n// discarding the struct's real type arguments -- and `unify`'s\\n// `CtStruct`/`CtNamed` bridge (core/types.vibe, #829/#843) then lets that bare\\n// annotation re-unify by NAME ALONE with any later, unrelated instantiation\\n// (`let y: Box[String] = x`), silently re-narrowing a laundered value. Fixing\\n// that erasure at its source (threading fresh type variables through\\n// `resolve_type_expr`) touches its ~20 call sites across the whole checker\\n// and was judged too wide-blast-radius to land in one pass (#844); this is\\n// the narrower, additive half of the fix that IS safe to land: when BOTH the\\n// expected annotation and the actual value are already a fully concrete,\\n// SAME-NAME `CtNamed` instantiation (arity > 0) and their arguments do not\\n// unify, report the mismatch directly -- bypassing `check_assignable`'s\\n// `type_is_ground` gate, which (deliberately, to stay lenient for genuinely\\n// rigid/uninstantiated type parameters elsewhere) treats every `CtNamed` as\\n// non-ground and so never reports this shape at all. Gated on\\n// `type_fully_concrete` on BOTH sides so a still-polymorphic case (either\\n// side embedding an unresolved rigid parameter or unbound type variable, e.g.\\n// a trait-generic `LazyIter[T]` return before `T` is resolved) is never\\n// flagged -- only a same-name mismatch where both sides are already fully\\n// resolved concrete types.\\nexport fn detect_narrowed_generic_mismatch(expected: Type, actual: Type, s: Subst, errors: Array[String], what: String, off: Int) -> Subst {\\n  let e2 = subst_apply(s, expected)\\n  let a2 = subst_apply(s, actual)\\n  match e2 {\\n    CtNamed(ename, eargs) => match a2 {\\n      CtNamed(aname, aargs) => if ename == aname && Array::length(eargs) == Array::length(aargs) && Array::length(eargs) > 0 && type_fully_concrete(e2) && type_fully_concrete(a2) {\\n        match unify(e2, a2, s) {\\n          Some(_) => s,\\n          None => {\\n            Array::push(errors, String::concat(what, String::concat(\\\": expected \\\", String::concat(type_to_string(e2), String::concat(\\\", got \\\", String::concat(type_to_string(a2), off_marker(off)))))))\\n            s\\n          }\\n        }\\n      } else s,\\n      _ => s\\n    },\\n    _ => s\\n  }\\n}\\n\\n// #844: when a `let`-style annotation is a BARE (unparameterized) reference to\\n// a generic struct (`resolve_type_expr` resolves it to bare `CtStruct(name)`,\\n// discarding type args) and the RHS's ACTUAL inferred type is already a\\n// concrete instantiation of that SAME struct (`CtNamed(name, args)`, arity >\\n// 0, from #829's struct-literal instantiation), prefer recording the RHS's\\n// real instantiated type for the binding instead of the erasing bare\\n// annotation. This does not change what the CURRENT statement accepts (the\\n// bare annotation already tolerates any instantiation via the unify bridge,\\n// unchanged here) -- it only changes what a LATER statement observes when it\\n// looks the binding up, so a subsequent re-narrowing annotation\\n// (`detect_narrowed_generic_mismatch` above) has real type information to\\n// compare against instead of an erased placeholder.\\nexport fn preserve_generic_instantiation(resolved: Type, actual: Type) -> Type {\\n  match resolved {\\n    CtStruct(rname) => match actual {\\n      CtNamed(aname, aargs) => if rname == aname && Array::length(aargs) > 0 {\\n        actual\\n      } else {\\n        resolved\\n      },\\n      _ => resolved\\n    },\\n    _ => resolved\\n  }\\n}\\n\\n// Struct construction `S::{ ... }` drops the name `S` at parse time (becomes a\\n// bare ERecord), so the struct is resolved by matching the field-name SET. True\\n// when `declared` and `actual` have the same field names.\\nfn struct_field_names_match(declared: Array[(String, Type)], actual: Array[(String, Type)]) -> Bool {\\n  if Array::length(declared) != Array::length(actual) {\\n    false\\n  } else {\\n    let mut i = 0\\n    let mut ok = true\\n    while i < Array::length(declared) {\\n      let (dn, _) = Array::get(declared, i)\\n      let mut found = false\\n      let mut j = 0\\n      while j < Array::length(actual) {\\n        let (an, _) = Array::get(actual, j)\\n        if an == dn {\\n          found = true\\n        }\\n        j = j + 1\\n      }\\n      if !found {\\n        ok = false\\n      }\\n      i = i + 1\\n    }\\n    ok\\n  }\\n}\\n\\n// #813: look up a qualified operation name (\\\"Eff::Op\\\") in the declared-effect\\n// registry (TDEffect defs). None when the name is unqualified, the effect is\\n// undeclared/builtin/generic, or the op is unknown WITHIN a declared effect is\\n// reported separately by the callers — this returns None only when there is\\n// nothing to validate against (pre-#813 behavior).\\nfn effect_op_sig(defs: Array[TypeDef], qname: String) -> Option[(Array[Type], Type)] {\\n  let ci = String::index_of(qname, \\\"::\\\")\\n  if ci < 0 {\\n    None\\n  } else {\\n    let eff = String::substring(qname, 0, ci)\\n    let op = String::substring(qname, ci + 2, String::length(qname))\\n    match find_typedef(defs, eff) {\\n      Some(td) => match td {\\n        TDEffect(_, ops) => {\\n          let mut oi = 0\\n          let mut found = None\\n          while oi < Array::length(ops) {\\n            let (oname, oparams, oret) = Array::get(ops, oi)\\n            if oname == op {\\n              found = Some((oparams, oret))\\n            } else {\\n              ()\\n            }\\n            oi = oi + 1\\n          }\\n          found\\n        },\\n        _ => None\\n      },\\n      None => None\\n    }\\n  }\\n}\\n\\n// #813: is `eff` a DECLARED effect (TDEffect) in this module? Distinguishes\\n// \\\"unknown op of a declared effect\\\" (reportable) from builtin/imported\\n// effects the registry cannot see (skip).\\nfn effect_is_declared(defs: Array[TypeDef], eff: String) -> Bool {\\n  match find_typedef(defs, eff) {\\n    Some(td) => match td {\\n      TDEffect(_, _) => true,\\n      _ => false\\n    },\\n    None => false\\n  }\\n}\\n\\nfn lookup_actual_field_ty(actual: Array[(String, Type)], name: String) -> Option[Type] {\\n  let mut i = 0\\n  let mut out = None\\n  while i < Array::length(actual) {\\n    let (an, at) = Array::get(actual, i)\\n    if an == name {\\n      out = Some(at)\\n    }\\n    i = i + 1\\n  }\\n  out\\n}\\n\\n// True when `dfields` (a struct's declared fields) is a STRICT superset of the\\n// record literal's `actual` fields: every provided field name appears in the\\n// struct, and the struct declares strictly more fields. Used to flag a record\\n// that omits required fields.\\nfn struct_is_strict_superset(dfields: Array[(String, Type)], actual: Array[(String, Type)]) -> Bool {\\n  if Array::length(dfields) <= Array::length(actual) {\\n    false\\n  } else {\\n    let mut i = 0\\n    let mut all_in = true\\n    while i < Array::length(actual) {\\n      let (an, _) = Array::get(actual, i)\\n      let mut found = false\\n      let mut j = 0\\n      while j < Array::length(dfields) {\\n        let (dn, _) = Array::get(dfields, j)\\n        if dn == an {\\n          found = true\\n        } else {\\n          ()\\n        }\\n        j = j + 1\\n      }\\n      if !found {\\n        all_in = false\\n      } else {\\n        ()\\n      }\\n      i = i + 1\\n    }\\n    all_in\\n  }\\n}\\n\\n// Check a record literal's field VALUES against the declared field types of the\\n// (uniquely) matching struct definition — previously unchecked, so\\n// `S::{ x: \\\"oops\\\" }` for `struct S { x: Int }` was accepted. Conservative: if 0\\n// or >1 structs share the field-name set, skip (no struct could be determined).\\nfn check_record_fields(defs: Array[TypeDef], actual: Array[(String, Type)], s: Subst, errors: Array[String]) -> Subst {\\n  let mut matchct = 0\\n  let mut matched_fields = Array::slice([\\n    (\\\"\\\", CtUnknown)\\n  ], 0, 0)\\n  let mut di = 0\\n  while di < Array::length(defs) {\\n    match Array::get(defs, di) {\\n      TDStruct(_, dfields, _, _) => if struct_field_names_match(dfields, actual) {\\n        matchct = matchct + 1\\n        matched_fields = dfields\\n      },\\n      _ => ()\\n    }\\n    di = di + 1\\n  }\\n  if matchct == 1 {\\n    let mut out = s\\n    let mut i = 0\\n    while i < Array::length(matched_fields) {\\n      let (fname, declared_ty) = Array::get(matched_fields, i)\\n      match lookup_actual_field_ty(actual, fname) {\\n        Some(actual_ty) => {\\n          out = check_assignable(declared_ty, subst_apply(out, actual_ty), out, errors, String::concat(\\\"struct field type mismatch for \\\", fname), 0 - 1)\\n        },\\n        None => ()\\n      }\\n      i = i + 1\\n    }\\n    out\\n  } else if matchct > 1 {\\n    // Ambiguous: MORE than one struct declares exactly this field-name set\\n    // (e.g. `S2 { name: Int; y: String }` vs `S3 { y: String; name: String }`).\\n    // The literal is a valid construction of one of them, we just cannot tell\\n    // which — skip value checking, and in particular do NOT fall through to\\n    // the missing-field superset heuristic below: it used to fire here and\\n    // report a bogus \\\"missing field\\\" against some unrelated superset struct\\n    // (found by fuzz/run_fuzz.sh, seeds 68/282).\\n    s\\n  } else {\\n    // No struct has EXACTLY this field set. If exactly one struct is a strict\\n    // SUPERSET (contains every provided field and at least one more), the record\\n    // is that struct with fields MISSING — a real soundness hole, since the\\n    // omitted fields would be left uninitialized. Reported only when the\\n    // superset is unique (otherwise the intended struct is ambiguous → skip).\\n    let mut supct = 0\\n    let mut sup_name = \\\"\\\"\\n    let mut sup_fields = Array::slice([\\n      (\\\"\\\", CtUnknown)\\n    ], 0, 0)\\n    let mut dj = 0\\n    while dj < Array::length(defs) {\\n      match Array::get(defs, dj) {\\n        TDStruct(sname, dfields, _, _) => if struct_is_strict_superset(dfields, actual) {\\n          supct = supct + 1\\n          sup_name = sname\\n          sup_fields = dfields\\n        },\\n        _ => ()\\n      }\\n      dj = dj + 1\\n    }\\n    if supct == 1 {\\n      let mut fi = 0\\n      while fi < Array::length(sup_fields) {\\n        let (dn, _) = Array::get(sup_fields, fi)\\n        match lookup_actual_field_ty(actual, dn) {\\n          Some(_) => (),\\n          None => Array::push(errors, String::concat(\\\"missing field `\\\", String::concat(dn, String::concat(\\\"` in construction of struct \\\", sup_name))))\\n        }\\n        fi = fi + 1\\n      }\\n      s\\n    } else {\\n      s\\n    }\\n  }\\n}\\n\\n// Resolve the (uniquely) matching struct name for a record literal's field-name\\n// set. Returns None when 0 or >1 structs share that field set (ambiguous), or\\n// when the matching struct is GENERIC (non-ground fields) — so a record's\\n// struct identity is only recovered for an unambiguous MONOMORPHIC struct. Used\\n// to give a bare `S::{ ... }` literal the type `CtStruct(S)` instead of\\n// CtUnknown, which in turn lets `mut`-field write checking see the struct\\n// without disturbing generic-struct inference.\\nfn resolve_record_struct_name(defs: Array[TypeDef], actual: Array[(String, Type)]) -> Option[String] {\\n  let mut matchct = 0\\n  let mut out = None\\n  let mut ground = false\\n  let mut di = 0\\n  while di < Array::length(defs) {\\n    match Array::get(defs, di) {\\n      TDStruct(sname, dfields, _, _) => if struct_field_names_match(dfields, actual) {\\n        matchct = matchct + 1\\n        out = Some(sname)\\n        ground = struct_fields_ground(dfields)\\n      },\\n      _ => ()\\n    }\\n    di = di + 1\\n  }\\n  if matchct == 1 && ground {\\n    out\\n  } else {\\n    None\\n  }\\n}\\n\\n// Unify each argument against its parameter, REPORTING a type mismatch instead\\n// of silently swallowing it. `__to_string` (the polymorphic interpolation\\n// stringifier: `\\\"\\\\{x}\\\"` -> `__to_string(x)` wraps values of any type, but the\\n// polyfill annotates it `(Int) -> String`) is exempt.\\nfn unify_call_args(param_tys: Array[Type], arg_tys: Array[Type], s: Subst, errors: Array[String], label: String, off: Int) -> Subst {\\n  let mut out = s\\n  let mut ui = 0\\n  let ul = min_int(Array::length(arg_tys), Array::length(param_tys))\\n  while ui < ul {\\n    let pty = Array::get(param_tys, ui)\\n    let aty = Array::get(arg_tys, ui)\\n    out = if label == \\\"__to_string\\\" {\\n      match unify(pty, aty, out) {\\n        Some(su) => su,\\n        None => out\\n      }\\n    } else {\\n      check_assignable(pty, aty, out, errors, String::concat(\\\"argument type mismatch for \\\", label), off)\\n    }\\n    ui = ui + 1\\n  }\\n  out\\n}\\n\\n// #844: recognize the EXACT synthetic call shape `parser_expr_dispatch.vibe`'s\\n// `ascribe_wrap` builds for a LOCAL `let x: T = val` --\\n// `((__asc: T) -> __asc)(val)` -- and return its annotation `T`. `\\\"__asc\\\"` is\\n// a dedicated internal marker name (parallel to `\\\"__return__\\\"` /\\n// `\\\"__in_loop__\\\"` used elsewhere in this file), never written by real user\\n// code, so this match is precise: an ordinary lambda call (a real user IIFE)\\n// will not have a single param literally named `__asc` whose body is exactly\\n// `EIdent(\\\"__asc\\\", _)`. Used to run a dedicated, narrowly-scoped check for\\n// this one call shape (see the `ECall` fallback arm below) instead of\\n// changing the general call-argument checking (`unify_call_args`) that every\\n// other call in the language goes through.\\nfn ascription_lambda_ann(callee: Expr) -> Option[TypeExpr] {\\n  match callee {\\n    EFn(tparams, _tbounds, params, ret_ty, effect, body) => if Array::length(tparams) == 0 && Array::length(params) == 1 {\\n      match ret_ty {\\n        Some(_) => None,\\n        None => match effect {\\n          Some(_) => None,\\n          None => {\\n            let (pname, pann) = Array::get(params, 0)\\n            if pname == \\\"__asc\\\" {\\n              match body {\\n                EIdent(bname, _) => if bname == \\\"__asc\\\" {\\n                  pann\\n                } else {\\n                  None\\n                },\\n                _ => None\\n              }\\n            } else {\\n              None\\n            }\\n          }\\n        }\\n      }\\n    } else {\\n      None\\n    },\\n    _ => None\\n  }\\n}\\n\\nexport fn fn_return_env_name(name: String) -> String {\\n  String::concat(\\\"__fn_ret__:\\\", name)\\n}\\n\\n// #938: the ArrayBuilder container type — `CtNamed(\\\"ArrayBuilder\\\", [elem])`,\\n// the same shape `b: ArrayBuilder[T]` annotations resolve to. Used by the\\n// builder call branches below. #983/#996 (Codex P2): `Map` is deliberately\\n// NOT listed here — `Map::set` is a FUNCTIONAL update (the linear codegen\\n// allocates a fresh count+1 map and leaves the receiver untouched; measured:\\n// `Map::has_key(m, \\\"a\\\")` is false after `let m2 = Map::set(m, \\\"a\\\", 1)`), so\\n// aliases of one empty `Map::new()` binding do NOT share a live value slot.\\n// Value-restricting Map would mis-reject\\n// `let e = Map::new(); Map::set(e, \\\"i\\\", 1); Map::set(e, \\\"s\\\", \\\"x\\\")` (two\\n// independent derived maps). Generalizing the empty literal's fresh slot is\\n// therefore sound; maps whose slot is already CONCRETE (from_pairs values,\\n// annotations, a set-chain's returned type) keep the #983 value check.\\nfn is_array_builder_head(t: Type) -> Bool {\\n  match t {\\n    CtNamed(n, targs) => n == \\\"ArrayBuilder\\\" && Array::length(targs) == 1,\\n    _ => false\\n  }\\n}\\n\\n// #938 value-restriction predicate (Codex P1 on #977): true when a builder\\n// occurs ANYWHERE in the value's type reachable without crossing a function\\n// boundary — `(ArrayBuilder::new(), 0)`, `[ArrayBuilder::new()]`,\\n// `Some(ArrayBuilder::new())` all alias ONE live builder, so their element\\n// vars must stay un-quantified exactly like a bare builder's (a root-only\\n// check let each lookup of the tuple re-instantiate a fresh element slot and\\n// mixed pushes type-checked again). CtFn is deliberately NOT descended:\\n// a function value creates a NEW builder per call, so generalizing\\n// `() -> ArrayBuilder[v]` is sound and useful.\\nexport fn is_array_builder_ty(t: Type) -> Bool {\\n  if is_array_builder_head(t) {\\n    true\\n  } else {\\n    match t {\\n      CtArray(e) => is_array_builder_ty(e),\\n      CtOption(e) => is_array_builder_ty(e),\\n      CtTuple(elems) => {\\n        let mut i = 0\\n        let mut found = false\\n        while i < Array::length(elems) && !found {\\n          found = is_array_builder_ty(Array::get(elems, i))\\n          i = i + 1\\n        }\\n        found\\n      },\\n      CtNamed(_, targs) => {\\n        let mut i = 0\\n        let mut found = false\\n        while i < Array::length(targs) && !found {\\n          found = is_array_builder_ty(Array::get(targs, i))\\n          i = i + 1\\n        }\\n        found\\n      },\\n      _ => false\\n    }\\n  }\\n}\\n\\nfn direct_builtin_return(name: String) -> Option[Type] {\\n  if name == \\\"Bytes::length\\\" {\\n    Some(CtInt)\\n  }\\n  else if name == \\\"iter_length\\\" || name == \\\"String::iter_length\\\" || name == \\\"Map::iter_length\\\" {\\n    Some(CtInt)\\n  }\\n  else if name == \\\"Array::length\\\" {\\n    Some(CtInt)\\n  }\\n  else if name == \\\"FixedArray::length\\\" || name == \\\"Int64Array::length\\\" {\\n    Some(CtInt)\\n  }\\n  else if name == \\\"String::length\\\" {\\n    Some(CtInt)\\n  }\\n  else if name == \\\"Bytes::get\\\" || name == \\\"String::index_of\\\" || name == \\\"String::char_code_at\\\" || name == \\\"String::last_index_of\\\" || name == \\\"Char::to_int\\\" || name == \\\"Double::to_int\\\" || name == \\\"Double::to_i64_bits\\\" || name == \\\"Double::to_i64_bits_lo\\\" || name == \\\"Double::to_i64_bits_hi\\\" || name == \\\"Env::args_len\\\" || name == \\\"Stdin::read_char\\\" || name == \\\"Int64Array::get\\\" {\\n    Some(CtInt)\\n  }\\n  else if name == \\\"String::equals\\\" || name == \\\"String::contains\\\" || name == \\\"String::starts_with\\\" || name == \\\"String::ends_with\\\" || name == \\\"Array::any\\\" || name == \\\"Array::all\\\" || name == \\\"Array::contains\\\" || name == \\\"Map::has_key\\\" || name == \\\"map_has\\\" || name == \\\"Path::is_absolute\\\" || name == \\\"Fs::exists\\\" || name == \\\"Fs::is_dir\\\" || name == \\\"Fs::is_file\\\" || name == \\\"eq\\\" || name == \\\"not\\\" {\\n    Some(CtBool)\\n  }\\n  else if name == \\\"String::concat\\\" || name == \\\"String::substring\\\" || name == \\\"String::trim\\\" || name == \\\"String::to_lower\\\" || name == \\\"String::to_upper\\\" || name == \\\"String::from_char_code\\\" || name == \\\"String::join\\\" || name == \\\"Array::join\\\" || name == \\\"Path::to_string\\\" || name == \\\"Path::resolve\\\" || name == \\\"PromptText::new\\\" || name == \\\"Stdin::read_stream\\\" || name == \\\"Env::get\\\" || name == \\\"Env::args_get\\\" || name == \\\"Fs::read_file\\\" || name == \\\"Fs::getcwd\\\" || name == \\\"sh\\\" || name == \\\"Lines::stringify\\\" || name == \\\"Llm::complete\\\" || name == \\\"Rlm::run\\\" || name == \\\"Rlm::finalize\\\" || name == \\\"__to_string\\\" {\\n    Some(CtString)\\n  }\\n  else if name == \\\"__len\\\" {\\n    Some(CtInt)\\n  }\\n  else if name == \\\"String::iter_get\\\" {\\n    Some(CtInt)\\n  }\\n  else if name == \\\"iter_get\\\" || name == \\\"Map::iter_get\\\" || name == \\\"iter_require\\\" || name == \\\"__neg\\\" {\\n    Some(CtUnknown)\\n  }\\n  else if name == \\\"Bytes::new\\\" || name == \\\"Bytes::concat\\\" || name == \\\"Bytes::slice\\\" || name == \\\"Bytes::from_array\\\" || name == \\\"Fs::read_bytes\\\" {\\n    Some(CtBytes)\\n  }\\n  else if name == \\\"Array::set\\\" || name == \\\"Array::push\\\" || name == \\\"Array::push_all\\\" || name == \\\"Array::truncate\\\" || name == \\\"Array::foreach\\\" || name == \\\"FixedArray::set\\\" || name == \\\"FixedArray::blit\\\" || name == \\\"FixedArray::unsafe_set\\\" || name == \\\"Int64Array::set\\\" || name == \\\"Bytes::set\\\" || name == \\\"Bytes::push\\\" || name == \\\"Bytes::append\\\" || name == \\\"Bytes::blit\\\" || name == \\\"Bytes::fill\\\" || name == \\\"MapBuilder::set\\\" || name == \\\"Stdout::write_char\\\" || name == \\\"Stdout::write_stream\\\" || name == \\\"sleep\\\" || name == \\\"Fs::copy\\\" || name == \\\"Fs::chdir\\\" || name == \\\"Fs::mkdir\\\" || name == \\\"Fs::mkdir_p\\\" || name == \\\"Fs::append\\\" || name == \\\"Fs::remove\\\" || name == \\\"Fs::rename\\\" || name == \\\"Fs::write_file\\\" || name == \\\"Fs::write_bytes\\\" || name == \\\"print\\\" || name == \\\"println\\\" || name == \\\"assert\\\" || name == \\\"assert_true\\\" || name == \\\"assert_eq\\\" || name == \\\"__set_field\\\" {\\n    Some(CtUnit)\\n  }\\n  else if name == \\\"Double::from_i64_bits\\\" || name == \\\"Int::to_double\\\" || name == \\\"Double::to_float\\\" || name == \\\"Float::to_double\\\" {\\n    Some(CtDouble)\\n  }\\n  else if name == \\\"Char::from_int\\\" {\\n    Some(CtChar)\\n  }\\n  else if name == \\\"Bytes::to_array\\\" || name == \\\"Int64Array::make\\\" {\\n    Some(CtArray(CtInt))\\n  }\\n  else if name == \\\"Map::keys\\\" || name == \\\"sh_lines\\\" || name == \\\"Lines::parse\\\" {\\n    Some(CtArray(CtString))\\n  }\\n  else if name == \\\"Array::slice\\\" || name == \\\"Array::concat\\\" || name == \\\"Array::filter\\\" || name == \\\"Array::reverse\\\" || name == \\\"Array::sort\\\" || name == \\\"FixedArray::make\\\" {\\n    Some(CtArray(CtUnknown))\\n  }\\n  else if name == \\\"Some\\\" || name == \\\"Array::find\\\" {\\n    Some(CtOption(CtUnknown))\\n  }\\n  else {\\n    None\\n  }\\n}\\n\\nfn direct_call_return(env: TypeEnv, name: String) -> Option[Type] {\\n  match env_lookup(env, name) {\\n    Some(_) => None,\\n    None => direct_builtin_return(name)\\n  }\\n}\\n\\n// Expected TOP-LEVEL head-kind (see `head_kind`) of a builtin's FIRST argument,\\n// for the container/string builtins whose receiver head is unambiguous. 0 means\\n// \\\"unchecked\\\". Used to catch `Array::length(5)` / `String::length(5)` etc. on\\n// the direct-call fast path WITHOUT a per-call `lookup_builtin` (the #626\\n// seed-heap OOM constraint). Only entries whose first-arg head is certain are\\n// listed; anything else returns 0 (tolerated).\\nfn builtin_first_arg_head(name: String) -> Int {\\n  if name == \\\"Array::length\\\" || name == \\\"Array::get\\\" || name == \\\"Array::set\\\" || name == \\\"Array::push\\\" || name == \\\"Array::push_all\\\" || name == \\\"Array::slice\\\" || name == \\\"Array::concat\\\" || name == \\\"Array::reverse\\\" || name == \\\"Array::truncate\\\" || name == \\\"Array::foreach\\\" || name == \\\"Array::contains\\\" || name == \\\"Array::any\\\" || name == \\\"Array::all\\\" || name == \\\"Array::find\\\" || name == \\\"Array::filter\\\" {\\n    9\\n  } else if name == \\\"String::length\\\" || name == \\\"String::substring\\\" || name == \\\"String::trim\\\" || name == \\\"String::to_lower\\\" || name == \\\"String::to_upper\\\" || name == \\\"String::index_of\\\" || name == \\\"String::last_index_of\\\" || name == \\\"String::char_code_at\\\" || name == \\\"String::contains\\\" || name == \\\"String::starts_with\\\" || name == \\\"String::ends_with\\\" || name == \\\"String::split\\\" || name == \\\"String::concat\\\" {\\n    4\\n  } else if name == \\\"Bytes::length\\\" || name == \\\"Bytes::get\\\" || name == \\\"Bytes::set\\\" || name == \\\"Bytes::slice\\\" || name == \\\"Bytes::to_array\\\" || name == \\\"Bytes::push\\\" || name == \\\"Bytes::append\\\" || name == \\\"Bytes::blit\\\" || name == \\\"Bytes::fill\\\" {\\n    7\\n  } else if name == \\\"Int64Array::make\\\" || name == \\\"FixedArray::make\\\" {\\n    // #989 review: the make length is arg 0, so the rest-position table\\n    // never sees it — `Int64Array::make(\\\"4\\\", 0)` compiled with the String\\n    // as the loop bound. Both makes take a certain Int first.\\n    1\\n  } else {\\n    0\\n  }\\n}\\n\\n// Expected head-kind for argument position `i` (i >= 1) of fixed-signature\\n// builtins, mirroring `builtin_first_arg_head` for the non-receiver args.\\n// `direct_call_return` types these polymorphically, so passing e.g. an Int as\\n// the second arg of `String::concat`, or a String as the index of\\n// `String::substring`, slipped through. 0 = tolerate (no certain head). Only\\n// monomorphic, non-callback positions are listed (so HOF args like Array::map's\\n// function stay untouched — those need real signature inference, not a head).\\nfn builtin_arg_head_rest(name: String, i: Int) -> Int {\\n  // String head = 4, Int head = 1, Bytes head = 7 (see head_kind).\\n  if name == \\\"String::concat\\\" {\\n    if i == 1 { 4 } else { 0 }\\n  } else if name == \\\"String::index_of\\\" || name == \\\"String::last_index_of\\\" || name == \\\"String::contains\\\" || name == \\\"String::starts_with\\\" || name == \\\"String::ends_with\\\" || name == \\\"String::split\\\" {\\n    if i == 1 { 4 } else { 0 }\\n  } else if name == \\\"String::substring\\\" {\\n    if i == 1 || i == 2 { 1 } else { 0 }\\n  } else if name == \\\"String::char_code_at\\\" {\\n    if i == 1 { 1 } else { 0 }\\n  } else if name == \\\"Bytes::get\\\" || name == \\\"Bytes::push\\\" {\\n    // #985: Bytes::push's pushed byte (Int) was unlisted, so\\n    // `Bytes::push(b, \\\"hello\\\")` compiled clean and wrote a garbage byte.\\n    if i == 1 { 1 } else { 0 }\\n  } else if name == \\\"Bytes::set\\\" || name == \\\"Bytes::slice\\\" || name == \\\"Bytes::fill\\\" {\\n    if i == 1 || i == 2 { 1 } else { 0 }\\n  } else if name == \\\"Bytes::blit\\\" {\\n    // blit(dst: Bytes, src: Bytes, src_off: Int, len: Int)\\n    if i == 1 { 7 } else if i == 2 || i == 3 { 1 } else { 0 }\\n  } else if name == \\\"Int64Array::get\\\" {\\n    // #985: the Int64Array positions were never listed —\\n    // `Int64Array::set(w, 0, \\\"hi\\\")` wrote a String pointer into an i64 slot.\\n    if i == 1 { 1 } else { 0 }\\n  } else if name == \\\"Int64Array::set\\\" {\\n    if i == 1 || i == 2 { 1 } else { 0 }\\n  } else if name == \\\"Int64Array::make\\\" {\\n    if i == 1 { 1 } else { 0 }\\n  } else {\\n    0\\n  }\\n}\\n\\n// Fixed argument COUNT for direct-path builtins (-1 = unchecked). The direct\\n// fast path types the call by name alone (the #626 seed-heap constraint rules\\n// out a per-call `lookup_builtin`), so a wrong argument count was silently\\n// accepted — and the linear backend then emitted the surplus operands straight\\n// into the wasm body (`Bytes::new(3)` left a value stranded on the stack and\\n// the module failed validation only at instantiation). Only builtins whose\\n// arity is certain are listed; anything variadic-ish or unsure stays -1.\\n// `Bytes::new` is handled separately (0 or 1 capacity arg).\\nfn builtin_fixed_arity(name: String) -> Int {\\n  if name == \\\"Array::length\\\" || name == \\\"Array::reverse\\\" || name == \\\"String::length\\\" || name == \\\"String::trim\\\" || name == \\\"String::to_lower\\\" || name == \\\"String::to_upper\\\" || name == \\\"String::from_char_code\\\" || name == \\\"String::iter_length\\\" || name == \\\"Bytes::length\\\" || name == \\\"Bytes::to_array\\\" || name == \\\"Bytes::from_array\\\" || name == \\\"Map::keys\\\" || name == \\\"Map::iter_length\\\" || name == \\\"Char::to_int\\\" || name == \\\"Char::from_int\\\" || name == \\\"Double::to_int\\\" || name == \\\"Double::to_i64_bits\\\" || name == \\\"Double::from_i64_bits\\\" || name == \\\"Int::to_double\\\" || name == \\\"not\\\" || name == \\\"print\\\" || name == \\\"println\\\" || name == \\\"assert\\\" || name == \\\"assert_true\\\" || name == \\\"__to_string\\\" || name == \\\"FixedArray::length\\\" || name == \\\"Int64Array::length\\\" {\\n    1\\n  } else if name == \\\"Array::get\\\" || name == \\\"Array::push\\\" || name == \\\"Array::push_all\\\" || name == \\\"Array::truncate\\\" || name == \\\"Array::concat\\\" || name == \\\"Array::contains\\\" || name == \\\"Array::any\\\" || name == \\\"Array::all\\\" || name == \\\"Array::find\\\" || name == \\\"Array::filter\\\" || name == \\\"Array::join\\\" || name == \\\"Array::foreach\\\" || name == \\\"String::equals\\\" || name == \\\"String::concat\\\" || name == \\\"String::char_code_at\\\" || name == \\\"String::index_of\\\" || name == \\\"String::last_index_of\\\" || name == \\\"String::contains\\\" || name == \\\"String::starts_with\\\" || name == \\\"String::ends_with\\\" || name == \\\"String::split\\\" || name == \\\"String::join\\\" || name == \\\"String::iter_get\\\" || name == \\\"Bytes::get\\\" || name == \\\"Bytes::push\\\" || name == \\\"Bytes::append\\\" || name == \\\"Bytes::concat\\\" || name == \\\"Map::has_key\\\" || name == \\\"map_has\\\" || name == \\\"eq\\\" || name == \\\"assert_eq\\\" || name == \\\"FixedArray::get\\\" || name == \\\"FixedArray::make\\\" || name == \\\"Int64Array::get\\\" || name == \\\"Int64Array::make\\\" {\\n    2\\n  } else if name == \\\"Array::set\\\" || name == \\\"Array::slice\\\" || name == \\\"String::substring\\\" || name == \\\"Bytes::set\\\" || name == \\\"Bytes::slice\\\" || name == \\\"Bytes::fill\\\" || name == \\\"MapBuilder::set\\\" || name == \\\"FixedArray::set\\\" || name == \\\"FixedArray::unsafe_set\\\" || name == \\\"Int64Array::set\\\" {\\n    3\\n  } else if name == \\\"Bytes::blit\\\" {\\n    4\\n  } else if name == \\\"FixedArray::blit\\\" {\\n    5\\n  } else {\\n    0 - 1\\n  }\\n}\\n\\n// Check a higher-order builtin's callback parameter against the type it will be\\n// fed. `recv_ty` / `fn_ty` are already subst-applied; when the receiver is a\\n// concrete `CtArray(elem)` and the callback is a `CtFn` with a parameter at\\n// `pidx`, require `elem` to be assignable to that parameter type. Ground-gated\\n// via check_assignable, so an unannotated callback param (a fresh CtVar that\\n// the body never pins to a concrete type) stays tolerant — only an explicit\\n// wrong annotation (or a body that pins the param to a mismatching concrete\\n// type) is rejected. `expected_ty` is the param (the slot), `elem` the value.\\nfn check_hof_param_vs_elem(recv_ty: Type, fn_ty: Type, pidx: Int, s: Subst, errors: Array[String], msg: String) -> Subst {\\n  match recv_ty {\\n    CtArray(elem) => match fn_ty {\\n      CtFn(ptys, _, _) => if Array::length(ptys) > pidx {\\n        check_assignable(subst_apply(s, Array::get(ptys, pidx)), subst_apply(s, elem), s, errors, msg, 0 - 1)\\n      } else {\\n        s\\n      },\\n      _ => s\\n    },\\n    _ => s\\n  }\\n}\\n\\n// Require two array operands to share an element type (Array::concat /\\n// Array::push_all). `a_app` / `b_app` are already subst-applied; when both are\\n// concrete `CtArray`, ground-gated check_assignable compares their element\\n// types (generic / var operands stay tolerant).\\nfn check_two_array_elems(a_app: Type, b_app: Type, s: Subst, errors: Array[String], msg: String) -> Subst {\\n  match a_app {\\n    CtArray(ea) => match b_app {\\n      CtArray(eb) => check_assignable(subst_apply(s, ea), subst_apply(s, eb), s, errors, msg, 0 - 1),\\n      _ => s\\n    },\\n    _ => s\\n  }\\n}\\n\\n// Declared type of a (monomorphic) struct field by name, or None if the struct\\n// or field is unknown. Used to recognise a field-stored-function call\\n// `b.f(args)` when no method/builtin `T::f` exists.\\nfn struct_field_type(defs: Array[TypeDef], sname: String, field: String) -> Option[Type] {\\n  match find_typedef(defs, sname) {\\n    Some(td) => match td {\\n      TDStruct(_, fields, _, _) => {\\n        let rec go: (Int) -> Option[Type] = (i) -> {\\n          if i >= Array::length(fields) {\\n            None\\n          } else {\\n            let (fname, ftype) = Array::get(fields, i)\\n            if fname == field { Some(ftype) } else { go(i + 1) }\\n          }\\n        }\\n        go(0)\\n      },\\n      _ => None\\n    },\\n    None => None\\n  }\\n}\\n\\n// #829: instantiate a declared field type against the receiver's actual type\\n// arguments (`CtNamed(S, targs)`). Substitutes only when the declared param\\n// list and the argument list line up; otherwise the raw (rigid) type is kept,\\n// which downstream checks tolerate exactly as before.\\nfn inst_struct_field_ty(ft: Type, tparams: Array[String], targs: Array[Type]) -> Type {\\n  if Array::length(tparams) > 0 && Array::length(tparams) == Array::length(targs) {\\n    subst_type_params(ft, tparams, targs)\\n  } else {\\n    ft\\n  }\\n}\\n\\n// #829: field type of a struct-typed receiver, instantiated when the receiver\\n// is an applied generic struct. `CtStruct` receivers keep the raw field type\\n// (monomorphic structs have no params to substitute). None when the receiver\\n// is not a known struct or the field does not exist.\\nfn receiver_struct_field_type(defs: Array[TypeDef], recv: Type, field: String) -> Option[Type] {\\n  match recv {\\n    CtStruct(sname) => struct_field_type(defs, sname, field),\\n    CtNamed(sname, targs) => match find_typedef(defs, sname) {\\n      Some(td) => match td {\\n        TDStruct(_, _, _, tparams) => match struct_field_type(defs, sname, field) {\\n          Some(ft) => Some(inst_struct_field_ty(ft, tparams, targs)),\\n          None => None\\n        },\\n        _ => None\\n      },\\n      None => None\\n    },\\n    _ => None\\n  }\\n}\\n\\nfn is_logic_binop(op: String) -> Bool {\\n  op == \\\"&&\\\"\\n  || op == \\\"||\\\"\\n}\\n\\nfn is_order_binop(op: String) -> Bool {\\n  op == \\\"<\\\"\\n  || op == \\\">\\\"\\n  || op == \\\"<=\\\"\\n  || op == \\\">=\\\"\\n}\\n\\nfn type_name_prefix(ty: Type) -> String {\\n  match ty {\\n    CtInt => \\\"Int\\\",\\n    CtDouble => \\\"Double\\\",\\n    CtBool => \\\"Bool\\\",\\n    CtString => \\\"String\\\",\\n    CtChar => \\\"Char\\\",\\n    CtUnit => \\\"Unit\\\",\\n    CtBytes => \\\"Bytes\\\",\\n    CtArray(_) => \\\"Array\\\",\\n    CtOption(_) => \\\"Option\\\",\\n    CtEnum(name) => name,\\n    CtStruct(name) => name,\\n    CtNamed(name, _) => name,\\n    _ => \\\"\\\"\\n  }\\n}\\n\\n// #994: builtin data types that can appear as a dot-call RECEIVER's checked\\n// type (via `type_name_prefix` or a `CtNamed` head). An unresolved method on\\n// one of these is definitely bogus -- there is no \\\"it might be an imported\\n// user type with the method defined elsewhere\\\" escape hatch for a builtin.\\n// Deliberately excludes namespace-only builtins (Fs, Http, Socket, Stdout,\\n// ...) that are never a receiver VALUE's type, only ever called by\\n// `Module::fn` name -- including them here would risk false positives on\\n// legitimate qualified-import shortcut calls that happen to share a method\\n// name.\\n// #994 review: `Bool`/`Option`/`Result` are excluded even though they are\\n// builtin heads. lib/@vibe/prelude/{bool,option,result}.vibe extend them\\n// with real top-level `fn Bool::to_int` etc., and the *_type_import_test.vibe\\n// fixtures use the \\\"import just the type, dot-call resolves the method via\\n// the merged program\\\" idiom the #953 comment documents -- in an isolated\\n// per-file check (as these unit tests exercise) the extension fn isn't in\\n// `env` yet, so gating on this prefix here regressed 4 passing tests\\n// (`no method ... on Bool/Option/Result`) that only compile correctly once\\n// merged. No equivalent extension-via-type-import convention exists for the\\n// container types below (grep confirms no prelude file extends Array/Bytes/\\n// Map/...), so they keep the stricter check.\\n// #994 follow-up (Codex P1): `Int`/`Double`/`Char` were missing here even\\n// though `lib/@vibe/prelude/{int,double}.vibe` extend them with real fns\\n// (`Int::abs`, `Double::ceil`, ...) the same way Bool/Option/Result do.\\n// Unlike Bool/Option/Result, no test anywhere dot-calls one of those\\n// extension fns (grep across the repo for `.abs(`/`.gcd(`/`.ceil(`/... on a\\n// bare int/double/char value found zero hits), so there is no \\\"import type\\n// only, resolve via merge\\\" idiom to protect for these three -- adding them\\n// carries none of the regression risk that excluded Bool/Option/Result.\\n// Confirmed the gap empirically: `n.to_string()` for `n: Int` checks and\\n// \\\"succeeds\\\" (no parsed `fn Int::to_string` exists anywhere, only a\\n// checker-only `lookup_builtin` signature), then codegen dies with\\n// \\\"unknown struct field: to_string\\\" -- the exact class of bug #994 exists\\n// to catch.\\nfn is_known_builtin_receiver_prefix(prefix: String) -> Bool {\\n  prefix == \\\"String\\\"\\n  || prefix == \\\"Bytes\\\"\\n  || prefix == \\\"Array\\\"\\n  || prefix == \\\"Map\\\"\\n  || prefix == \\\"MapBuilder\\\"\\n  || prefix == \\\"Int64Array\\\"\\n  || prefix == \\\"FixedArray\\\"\\n  || prefix == \\\"ArrayBuilder\\\"\\n  || prefix == \\\"StringBuilder\\\"\\n  || prefix == \\\"Int\\\"\\n  || prefix == \\\"Double\\\"\\n  || prefix == \\\"Char\\\"\\n}\\n\\nfn is_equality_binop(op: String) -> Bool {\\n  op == \\\"==\\\"\\n  || op == \\\"!=\\\"\\n}\\n\\nfn unify_binop_candidate(left_ty: Type, right_ty: Type, target_ty: Type, s: Subst) -> Option[Subst] {\\n  match unify(left_ty, target_ty, s) {\\n    Some(s1) => unify(right_ty, target_ty, s1),\\n    None => None\\n  }\\n}\\n\\nfn unify_same_binop_operands(left_ty: Type, right_ty: Type, s: Subst) -> Option[(Type, Subst)] {\\n  match unify(left_ty, right_ty, s) {\\n    Some(s1) => Some((subst_apply(s1, left_ty), s1)),\\n    None => None\\n  }\\n}\\n\\nfn infer_named_trait_binop(env: TypeEnv, left_ty: Type, right_ty: Type, trait_name: String, s: Subst) -> Option[(Type, Subst)] {\\n  match unify_same_binop_operands(left_ty, right_ty, s) {\\n    Some((resolved, s1)) => if type_implements_trait(env, s1, resolved, trait_name) {\\n      Some((resolved, s1))\\n    } else {\\n      None\\n    },\\n    None => None\\n  }\\n}\\n\\nfn binop_str_arr_contains(arr: Array[String], val: String) -> Bool {\\n  let mut i = 0\\n  let mut found = false\\n  while i < Array::length(arr) {\\n    if Array::get(arr, i) == val {\\n      found = true\\n      i = Array::length(arr)\\n    } else {\\n      i = i + 1\\n    }\\n  }\\n  found\\n}\\n\\n// #952: a bound generic type parameter (`[T: Ord]` / `[T: Add]`) is checked\\n// as a plain `CtVar(id)` carrying its trait bounds in the current `Subst`\\n// (recorded by `subst_add_bound` when the `EFn` type-param header is\\n// processed, read back via `subst_bounds_for`). The order/`+` binop paths\\n// below try `unify_binop_candidate(_, _, CtInt, s)` FIRST as a fast path for\\n// ordinary (unbound) local-var inference -- but `unify` treats ANY unbound\\n// `CtVar` as freely unifiable with `CtInt` (no bound check), so that fast\\n// path silently binds T := Int the first time `<`/`>`/`+` appears in a bound\\n// generic function's OWN body, before any call site is even seen. That\\n// poisons the substitution used to `generalize` the function's signature,\\n// turning `fn my_lt[T: Ord](a: T, b: T) -> Bool { a < b }` into a\\n// monomorphic `(Int, Int) -> Bool` -- so calling it with String args later\\n// fails with \\\"expected Int, got String\\\" even though `impl Ord for String`\\n// exists. `==`/`!=` never hit this because `is_equality_binop` only unifies\\n// the two operands against EACH OTHER (never against a concrete target\\n// type), so a bound CtVar is never concretized there.\\n//\\n// Fix: when either operand resolves (post-subst) to a CtVar whose recorded\\n// bounds already include the needed trait, dispatch directly here -- unify\\n// the operands against EACH OTHER only (mirroring the Eq path) and skip the\\n// CtInt/CtDouble fast paths entirely, so the type parameter stays\\n// rigid/polymorphic through the rest of the definition check. An ordinary\\n// unbound CtVar (no recorded bounds -- the common unannotated-local-var\\n// inference case, e.g. `fn f(x) { x < 5 }`) is untouched: `rigid_bound_operand`\\n// returns false for it, so it still takes the existing\\n// CtInt/CtDouble/struct-Ord(Add) fast path exactly as before.\\nfn rigid_bound_operand(ty: Type, s: Subst, trait_name: String) -> Bool {\\n  match subst_apply(s, ty) {\\n    CtVar(id) => binop_str_arr_contains(subst_bounds_for(s, id), trait_name),\\n    _ => false\\n  }\\n}\\n\\n// Bounds recorded on a var the operand-vs-operand unify just eliminated\\n// (post-subst it is no longer a CtVar) would otherwise be dropped: in\\n// `fn bad[T: Ord, U](a: T, b: U) { a < b }` unify may bind T := U, leaving\\n// the surviving U with NO recorded Ord bound, so generalize exports an\\n// unbounded (U, U) -> Bool and `bad(true, false)` sails through the\\n// call-site bound check. Collect each operand's pre-unify var bounds so\\n// they can be re-recorded on whatever survives.\\nfn operand_var_bounds(ty: Type, s: Subst) -> Array[String] {\\n  match subst_apply(s, ty) {\\n    CtVar(id) => subst_bounds_for(s, id),\\n    _ => Array::slice([\\\"\\\"], 0, 0)\\n  }\\n}\\n\\nfn rigid_trait_bound_binop(env: TypeEnv, left_ty: Type, right_ty: Type, trait_name: String, s: Subst) -> Option[(Type, Subst)] {\\n  if rigid_bound_operand(left_ty, s, trait_name) || rigid_bound_operand(right_ty, s, trait_name) {\\n    let lb = operand_var_bounds(left_ty, s)\\n    let rb = operand_var_bounds(right_ty, s)\\n    match unify_same_binop_operands(left_ty, right_ty, s) {\\n      Some((resolved, s1)) => match subst_apply(s1, resolved) {\\n        CtVar(id) => {\\n          // Var survivor: transfer every bound either operand carried that\\n          // the survivor does not already record, so generalize keeps them.\\n          let have = subst_bounds_for(s1, id)\\n          let missing = ArrayBuilder::new()\\n          let mut i = 0\\n          while i < Array::length(lb) + Array::length(rb) {\\n            let cand = if i < Array::length(lb) {\\n              Array::get(lb, i)\\n            } else {\\n              Array::get(rb, i - Array::length(lb))\\n            }\\n            if !binop_str_arr_contains(have, cand) {\\n              // (duplicates between lb and rb are harmless -- bound lookups\\n              // only ever ask \\\"contains\\\", never count)\\n              ArrayBuilder::push(missing, cand)\\n            } else {\\n              ()\\n            }\\n            i = i + 1\\n          }\\n          let missing_arr = ArrayBuilder::freeze(missing)\\n          if Array::length(missing_arr) > 0 {\\n            Some((resolved, subst_add_bound(s1, id, missing_arr)))\\n          } else {\\n            Some((resolved, s1))\\n          }\\n        },\\n        other => if type_implements_trait(env, s1, other, trait_name) {\\n          // Concrete survivor (e.g. `a < \\\"x\\\"` forcing T := String): only\\n          // accept when it actually implements the required trait --\\n          // mirroring infer_named_trait_binop, which handled this shape\\n          // before the rigid pre-step existed.\\n          Some((resolved, s1))\\n        } else {\\n          None\\n        }\\n      },\\n      None => None\\n    }\\n  } else {\\n    None\\n  }\\n}\\n\\nfn infer_binop_type(op: String, left_ty: Type, right_ty: Type, env: TypeEnv, s: Subst, errors: Array[String], tytab: Array[(Int, Type)]) -> (Type, Subst) {\\n  if is_logic_binop(op) {\\n    match unify_binop_candidate(left_ty, right_ty, CtBool, s) {\\n      Some(s1) => (CtBool, s1),\\n      None => {\\n        Array::push(errors, String::concat(\\\"type mismatch in '\\\", String::concat(op, \\\"': operands must be Bool\\\")))\\n        (CtUnknown, s)\\n      }\\n    }\\n  }\\n  else if is_equality_binop(op) {\\n    match unify(left_ty, right_ty, s) {\\n      Some(s1) => (CtBool, s1),\\n      None => {\\n        // Tolerate unresolved NOMINAL operands: a generic `[T]` callee's\\n        // result reaches here as a rigid CtNamed type param when call-site\\n        // instantiation can't ground it (#829) — e.g.\\n        // `Array::get(ArrayView::to_array(v), 0) == 20`. Pre-fn-migration\\n        // these positions were CtUnknown, so erroring regressed working\\n        // code. Fully concrete mismatches still error.\\n        let eq_l = subst_apply(s, left_ty)\\n        let eq_r = subst_apply(s, right_ty)\\n        let eq_has_named = match eq_l {\\n          CtNamed(_, _) => true,\\n          _ => match eq_r {\\n            CtNamed(_, _) => true,\\n            _ => false\\n          }\\n        }\\n        if eq_has_named {\\n          (CtBool, s)\\n        } else {\\n          Array::push(errors, String::concat(\\\"type mismatch in '\\\", String::concat(op, \\\"': operands must have same type\\\")))\\n          (CtUnknown, s)\\n        }\\n      }\\n    }\\n  }\\n  else if is_order_binop(op) {\\n    match rigid_trait_bound_binop(env, left_ty, right_ty, \\\"Ord\\\", s) {\\n      Some((_, s1)) => (CtBool, s1),\\n      None => match unify_binop_candidate(left_ty, right_ty, CtInt, s) {\\n        Some(s1) => (CtBool, s1),\\n        None => match unify_binop_candidate(left_ty, right_ty, CtDouble, s) {\\n          Some(s1) => (CtBool, s1),\\n          None => match infer_named_trait_binop(env, left_ty, right_ty, \\\"Ord\\\", s) {\\n            Some((_, s1)) => (CtBool, s1),\\n            None => {\\n              Array::push(errors, String::concat(\\\"type mismatch in '\\\", String::concat(op, \\\"': operands must be Int or Double\\\")))\\n              (CtUnknown, s)\\n            }\\n          }\\n        }\\n      }\\n    }\\n  }\\n  else if op == \\\"+\\\" {\\n    match rigid_trait_bound_binop(env, left_ty, right_ty, \\\"Add\\\", s) {\\n      Some((resolved, s1)) => (resolved, s1),\\n      None => match unify_binop_candidate(left_ty, right_ty, CtInt, s) {\\n        Some(s1) => (CtInt, s1),\\n        None => match unify_binop_candidate(left_ty, right_ty, CtDouble, s) {\\n          Some(s1) => (CtDouble, s1),\\n          None => match unify_binop_candidate(left_ty, right_ty, CtString, s) {\\n            Some(s1) => (CtString, s1),\\n            None => match infer_named_trait_binop(env, left_ty, right_ty, \\\"Add\\\", s) {\\n              Some((resolved, s1)) => (resolved, s1),\\n              None => {\\n                Array::push(errors, \\\"type mismatch in '+': operands must be Int, Double, or String\\\")\\n                (CtUnknown, s)\\n              }\\n            }\\n          }\\n        }\\n      }\\n    }\\n  }\\n  else if op == \\\"-\\\"\\n  || op == \\\"*\\\"\\n  || op == \\\"/\\\" {\\n    let trait_name = if op == \\\"-\\\" {\\n      \\\"Sub\\\"\\n    } else if op == \\\"*\\\" {\\n      \\\"Mul\\\"\\n    } else {\\n      \\\"Div\\\"\\n    }\\n    match unify_binop_candidate(left_ty, right_ty, CtInt, s) {\\n      Some(s1) => (CtInt, s1),\\n      None => match unify_binop_candidate(left_ty, right_ty, CtDouble, s) {\\n        Some(s1) => (CtDouble, s1),\\n        None => match infer_named_trait_binop(env, left_ty, right_ty, trait_name, s) {\\n          Some((resolved, s1)) => (resolved, s1),\\n          None => {\\n            Array::push(errors, String::concat(\\\"type mismatch in '\\\", String::concat(op, \\\"': operands must be Int or Double\\\")))\\n            (CtUnknown, s)\\n          }\\n        }\\n      }\\n    }\\n  }\\n  else if op == \\\"%\\\" {\\n    match unify_binop_candidate(left_ty, right_ty, CtInt, s) {\\n      Some(s1) => (CtInt, s1),\\n      None => {\\n        Array::push(errors, \\\"type mismatch in '%': operands must be Int\\\")\\n        (CtUnknown, s)\\n      }\\n    }\\n  }\\n  else if op == \\\"&\\\" || op == \\\"|\\\" || op == \\\"^\\\" || op == \\\"<<\\\" || op == \\\">>\\\" {\\n    match unify_binop_candidate(left_ty, right_ty, CtInt, s) {\\n      Some(s1) => (CtInt, s1),\\n      None => {\\n        Array::push(errors, String::concat(\\\"type mismatch in '\\\", String::concat(op, \\\"': operands must be Int\\\")))\\n        (CtUnknown, s)\\n      }\\n    }\\n  }\\n  else {\\n    Array::push(errors, String::concat(\\\"unknown operator: \\\", op))\\n    (CtUnknown, s)\\n  }\\n}\\n\\n// Recursively replace type-parameter names (those bound to a CtVar in `env`)\\n// with that CtVar, including ones nested inside Array/Option/Tuple/Fn/Named type\\n// args. Type constructors (enum/struct names, not bound to a CtVar) are kept and\\n// their args recursed. This lets a generic annotation like `Map[String, V]`\\n// resolve its inner `V` to the function's quantified var, so call sites can\\n// instantiate it (the previous shallow lookup only handled the outermost name).\\nfn resolve_tparams_in(ty: Type, env: TypeEnv) -> Type {\\n  match ty {\\n    CtNamed(name, args) => {\\n      let ra = for a in args {\\n        resolve_tparams_in(a, env)\\n      }\\n      match env_lookup(env, name) {\\n        Some(t) => match t {\\n          CtVar(_) => t,\\n          _ => CtNamed(name, ra)\\n        },\\n        None => CtNamed(name, ra)\\n      }\\n    },\\n    CtArray(e) => CtArray(resolve_tparams_in(e, env)),\\n    CtOption(e) => CtOption(resolve_tparams_in(e, env)),\\n    CtTuple(es) => CtTuple(for e in es {\\n      resolve_tparams_in(e, env)\\n    }),\\n    CtFn(ps, ret, eff) => {\\n      let resolve_params: (Array[Type]) -> Array[Type] = (types) -> {\\n        let out = Array::slice([\\n          CtUnknown\\n        ], 0, 0)\\n        let mut i = 0\\n        while i < Array::length(types) {\\n          Array::push(out, resolve_tparams_in(Array::get(types, i), env))\\n          i = i + 1\\n        }\\n        out\\n      }\\n      CtFn(resolve_params(ps), resolve_tparams_in(ret, env), eff)\\n    },\\n    _ => ty\\n  }\\n}\\n\\n// Record a call-site node's (raw, pre-final-subst) result type `ty` keyed by\\n// its real source char offset `call_off`, for typed-hover (vibe type-at) on\\n// `foo(x)` / `obj.method(x)`, then return `ty` unchanged so it can be dropped\\n// into the call-result tuple in place. Synthetic calls (call_off < 0) skip the\\n// push. Used at the ECall result sites (NOT by wrapping the giant ECall match,\\n// which the bootstrap seed parser cannot reparse when that match is nested one\\n// level deeper — only the interior result types are tagged).\\nfn tab_call_ty(tytab: Array[(Int, Type)], call_off: Int, ty: Type) -> Type {\\n  if call_off >= 0 {\\n    Array::push(tytab, (call_off, ty))\\n  } else {\\n    ()\\n  }\\n  ty\\n}\\n\\n// Iteratively check a sequence/let SPINE (`ESeq` and `ELet`/`ELetMut`/`ELetRec`\\n// chains) instead of recursing into each `body`, so a long function body — a\\n// deep right-nested `let` chain — does not exhaust the wasm call stack during\\n// self-compile. `ce` is `check_expr` itself (threaded as a value to avoid a\\n// forward reference). Semantics are identical to the recursive arms: each `let`\\n// binds its (generalized, or raw for `mut`) value type into the env seen by the\\n// rest of the spine, and the final non-spine expression's result is returned.\\nfn check_seq_spine(expr: Expr, env: TypeEnv, defs: Array[TypeDef], s: Subst, c: Int, errors: Array[String], tytab: Array[(Int, Type)], ce: (Expr, TypeEnv, Array[TypeDef], Subst, Int, Array[String], Array[(Int, Type)]) -> (Type, Subst, Int)) -> (Type, Subst, Int) {\\n  let mut cur = expr\\n  let mut cenv = env\\n  let mut s1 = s\\n  let mut c1 = c\\n  let mut done = false\\n  let mut result = (CtUnit, s, c)\\n  while !done {\\n    match cur {\\n      ESeq(left, right) => {\\n        let (_, ns, nc) = ce(left, cenv, defs, s1, c1, errors, tytab)\\n        s1 = ns\\n        c1 = nc\\n        cur = right\\n      },\\n      ELet(name, val, body, _) => {\\n        let (vt, ns, nc) = ce(val, cenv, defs, s1, c1, errors, tytab)\\n        // #938 value restriction: a builder is a MUTABLE container, so its\\n        // element var must stay un-quantified — generalizing\\n        // `CtNamed(\\\"ArrayBuilder\\\", [v])` would re-instantiate a fresh v at\\n        // every use and pushes could never constrain each other (the exact\\n        // hole this issue is about). Bind the monotype instead.\\n        let gen = if is_array_builder_ty(subst_apply(ns, vt)) {\\n          vt\\n        } else {\\n          generalize(ns, vt)\\n        }\\n        cenv = env_bind(cenv, name, gen)\\n        s1 = ns\\n        c1 = nc\\n        cur = body\\n      },\\n      ELetMut(name, val, body, _) => {\\n        let (vt, ns, nc) = ce(val, cenv, defs, s1, c1, errors, tytab)\\n        // `loop` desugars to `let mut __loop_result = 0; while true { ...\\n        // __loop_result = <break value> ... }` (parser_expr_primary.vibe) —\\n        // the 0 is only a slot placeholder, but binding its CtInt here pinned\\n        // every loop's result to Int, so `break((a, b))` / `break(acc)` with a\\n        // tuple/String errored \\\"assignment type mismatch for __loop_result\\\".\\n        // Bind the marker to a fresh var instead; the first assignment (break)\\n        // instantiates it via check_assignable's unify.\\n        if name == \\\"__loop_result\\\" {\\n          let (lr_tv, nc2) = fresh_var(nc)\\n          cenv = env_bind(cenv, name, lr_tv)\\n          c1 = nc2\\n        } else {\\n          cenv = env_bind(cenv, name, vt)\\n          c1 = nc\\n        }\\n        s1 = ns\\n        cur = body\\n      },\\n      ELetRec(name, val, body) => {\\n        let (tv, c1b) = fresh_var(c1)\\n        let (vt, ns, nc) = ce(val, env_bind(cenv, name, tv), defs, s1, c1b, errors, tytab)\\n        let s2 = match unify(tv, vt, ns) {\\n          Some(su) => su,\\n          None => ns\\n        }\\n        let gen = generalize(s2, tv)\\n        cenv = env_bind(cenv, name, gen)\\n        s1 = s2\\n        c1 = nc\\n        cur = body\\n      },\\n      _ => {\\n        result = ce(cur, cenv, defs, s1, c1, errors, tytab)\\n        done = true\\n      }\\n    }\\n  }\\n  result\\n}\\n\\n// #418: enforce that `obj.field = x` (which desugars to\\n// `__set_field(obj, \\\"field\\\", x)`) only targets a `mut`-declared struct field.\\n// Runs as a pure side-effect over a *throwaway* errors/tytab so it never\\n// perturbs the main type/subst flow — it only type-checks `obj` to learn its\\n// struct name, looks up that struct's `mut` field set, and pushes a single\\n// diagnostic to the real `errors` when the written field is not `mut`.\\nfn field_write_mut_check(name: String, args: Array[Expr], env: TypeEnv, defs: Array[TypeDef], s: Subst, c: Int, errors: Array[String], tytab: Array[(Int, Type)], ce: (Expr, TypeEnv, Array[TypeDef], Subst, Int, Array[String], Array[(Int, Type)]) -> (Type, Subst, Int)) -> Unit {\\n  if name == \\\"__set_field\\\" && Array::length(args) == 3 {\\n    match Array::get(args, 1) {\\n      EString(field) => {\\n        let throwaway = Array::slice([\\\"\\\"], 0, 0)\\n        let throwtab = Array::slice([(0, CtUnit)], 0, 0)\\n        let (obj_ty, _, _) = ce(Array::get(args, 0), env, defs, s, c, throwaway, throwtab)\\n        // #829: also recognise an INSTANTIATED generic struct receiver\\n        // (`CtNamed(S, targs)`), so `mut`-field enforcement and the written-\\n        // value type check cover generic structs too.\\n        let recv_struct = match subst_apply(s, obj_ty) {\\n          CtStruct(sn) => Some((sn, Array::slice([\\n            CtUnknown\\n          ], 0, 0))),\\n          CtNamed(sn, sargs) => Some((sn, sargs)),\\n          _ => None\\n        }\\n        match recv_struct {\\n          Some(recv_info) => {\\n            let (sname, recv_targs) = recv_info\\n            match find_typedef(defs, sname) {\\n            Some(TDStruct(_, dfields, mut_names, s_tparams)) => {\\n              let mut found = false\\n              let mut i = 0\\n              while i < Array::length(mut_names) {\\n                if Array::get(mut_names, i) == field {\\n                  found = true\\n                } else {\\n                  ()\\n                }\\n                i = i + 1\\n              }\\n              if found {\\n                ()\\n              } else {\\n                Array::push(errors, String::concat(\\\"cannot assign to non-`mut` field `\\\", String::concat(field, String::concat(\\\"` of struct \\\", sname))))\\n              }\\n              // The written value must match the field's declared type\\n              // (`p.x = \\\"s\\\"` for `x: Int` was accepted). Ground-gated via\\n              // check_assignable so a generic field type is not over-rejected.\\n              let mut fty = CtUnknown\\n              let mut has_field = false\\n              let mut fi = 0\\n              while fi < Array::length(dfields) {\\n                let (fn2, ft) = Array::get(dfields, fi)\\n                if fn2 == field {\\n                  fty = ft\\n                  has_field = true\\n                } else {\\n                  ()\\n                }\\n                fi = fi + 1\\n              }\\n              if has_field {\\n                let (val_ty, _, _) = ce(Array::get(args, 2), env, defs, s, c, throwaway, throwtab)\\n                // #829: instantiate a generic field's declared type from the\\n                // receiver's type args so the written value is checked against\\n                // the CONCRETE field type; a non-applied receiver keeps the\\n                // raw (rigid) type, which check_assignable tolerates.\\n                let inst_fty = inst_struct_field_ty(fty, s_tparams, recv_targs)\\n                let _ = check_assignable(subst_apply(s, inst_fty), subst_apply(s, val_ty), s, errors, String::concat(\\\"type mismatch writing field `\\\", String::concat(field, \\\"`\\\")), 0 - 1)\\n                ()\\n              } else {\\n                ()\\n              }\\n            },\\n            _ => ()\\n            }\\n          },\\n          None => ()\\n        }\\n      },\\n      _ => ()\\n    }\\n  } else {\\n    ()\\n  }\\n}\\n\\n// `obj[i]` desugars to `__index(obj, i)`, typed fully polymorphically, so\\n// indexing a non-indexable scalar (`let n = 5; n[0]`) was accepted silently.\\n// Report when `obj` resolves to a concrete scalar that cannot be indexed\\n// (Array/String/Bytes ARE indexable; type vars / unknown / named stay\\n// tolerated). Pure side-effect over a throwaway error/type table.\\nfn index_target_check(name: String, args: Array[Expr], env: TypeEnv, defs: Array[TypeDef], s: Subst, c: Int, errors: Array[String], ce: (Expr, TypeEnv, Array[TypeDef], Subst, Int, Array[String], Array[(Int, Type)]) -> (Type, Subst, Int)) -> Unit {\\n  if name == \\\"__index\\\" && Array::length(args) == 2 {\\n    let throwaway = Array::slice([\\\"\\\"], 0, 0)\\n    let throwtab = Array::slice([(0, CtUnit)], 0, 0)\\n    let (obj_ty, _, _) = ce(Array::get(args, 0), env, defs, s, c, throwaway, throwtab)\\n    let resolved_obj = subst_apply(s, obj_ty)\\n    let not_indexable = match resolved_obj {\\n      CtInt => true,\\n      CtDouble => true,\\n      CtBool => true,\\n      CtChar => true,\\n      CtUnit => true,\\n      _ => false\\n    }\\n    if not_indexable {\\n      Array::push(errors, \\\"cannot index a non-indexable value (expected Array, String, or Bytes)\\\")\\n    } else {\\n      // For an indexable receiver (Array/String/Bytes), the subscript must be an\\n      // Int — `a[\\\"x\\\"]` was accepted silently. Only flag a concrete non-Int index;\\n      // type vars / unknown / named stay tolerated.\\n      let indexable = match resolved_obj {\\n        CtArray(_) => true,\\n        CtString => true,\\n        CtBytes => true,\\n        _ => false\\n      }\\n      if indexable {\\n        let throwaway2 = Array::slice([\\\"\\\"], 0, 0)\\n        let throwtab2 = Array::slice([(0, CtUnit)], 0, 0)\\n        let (idx_ty, _, _) = ce(Array::get(args, 1), env, defs, s, c, throwaway2, throwtab2)\\n        let bad_index = match subst_apply(s, idx_ty) {\\n          CtInt => false,\\n          _ => type_is_ground(subst_apply(s, idx_ty))\\n        }\\n        if bad_index {\\n          Array::push(errors, \\\"index must be an Int\\\")\\n        } else {\\n          ()\\n        }\\n      } else {\\n        ()\\n      }\\n    }\\n  } else {\\n    ()\\n  }\\n}\\n\\n// An arm pattern is a CATCH-ALL (makes a match exhaustive regardless of which\\n// constructors precede it) when it is a wildcard or a bare binding. `POr` is a\\n// catch-all if either side is.\\nfn pat_is_catchall(pat: Pat) -> Bool {\\n  match pat {\\n    PWild => true,\\n    PBind(_) => true,\\n    POr(l, r) => pat_is_catchall(l) || pat_is_catchall(r),\\n    _ => false\\n  }\\n}\\n\\n// Collect the constructor names a pattern matches at the TOP level (for enum\\n// exhaustiveness). `POr` contributes from both sides; other patterns none.\\n// #940 Phase 1: Bool-literal coverage names (`\\\"true\\\"` / `\\\"false\\\"`) for the\\n// flat Bool exhaustiveness check, walking or-patterns like\\n// collect_ctor_names_into does for ctor names.\\nfn collect_bool_pats_into(pat: Pat, acc: Array[String]) -> Unit {\\n  match pat {\\n    PBool(b) => if b {\\n      Array::push(acc, \\\"true\\\")\\n    } else {\\n      Array::push(acc, \\\"false\\\")\\n    },\\n    POr(l, r) => {\\n      collect_bool_pats_into(l, acc)\\n      collect_bool_pats_into(r, acc)\\n    },\\n    _ => ()\\n  }\\n}\\n\\nfn flat_names_contain(names: Array[String], target: String) -> Bool {\\n  let mut i = 0\\n  let mut found = false\\n  while i < Array::length(names) && !found {\\n    if Array::get(names, i) == target {\\n      found = true\\n    } else {\\n      i = i + 1\\n    }\\n  }\\n  found\\n}\\n\\nfn collect_ctor_names_into(pat: Pat, acc: Array[String]) -> Unit {\\n  match pat {\\n    PCtor(name, _) => Array::push(acc, name),\\n    POr(l, r) => {\\n      collect_ctor_names_into(l, acc)\\n      collect_ctor_names_into(r, acc)\\n    },\\n    _ => ()\\n  }\\n}\\n\\n// Parse a tuple projection field (`t.0`, `t.5`) — the field is the all-digit\\n// index string. Returns None for a non-numeric field (a real `.method`/.field)\\n// so only genuine tuple projections are bounds-checked.\\nfn parse_tuple_index(s: String) -> Option[Int] {\\n  let len = String::length(s)\\n  if len == 0 {\\n    None\\n  } else {\\n    let mut i = 0\\n    let mut val = 0\\n    let mut ok = true\\n    while i < len {\\n      let cc = String::char_code_at(s, i)\\n      if cc >= 48 && cc <= 57 {\\n        val = val * 10 + (cc - 48)\\n      } else {\\n        ok = false\\n      }\\n      i = i + 1\\n    }\\n    if ok {\\n      Some(val)\\n    } else {\\n      None\\n    }\\n  }\\n}\\n\\n// #813: bind a pattern's binders to CtUnknown for the resume-value walk —\\n// the walker re-checks resume arguments outside the main inference flow, so\\n// locally-bound names (match arms, lets) must be in scope or a legitimate\\n// `Read() => { let v = ...; resume(v) }` reports a false `unknown name: v`.\\n// CtUnknown keeps the value check ground-gated (tolerant) for such names.\\nfn resume_walk_bind_pat(p: Pat, env: TypeEnv) -> TypeEnv {\\n  match p {\\n    PBind(n) => env_bind(env, n, CtUnknown),\\n    PCtor(_, ps) => {\\n      let mut env1 = env\\n      let mut pi = 0\\n      while pi < Array::length(ps) {\\n        env1 = resume_walk_bind_pat(Array::get(ps, pi), env1)\\n        pi = pi + 1\\n      }\\n      env1\\n    },\\n    PTuple(ps) => {\\n      let mut env1 = env\\n      let mut pi = 0\\n      while pi < Array::length(ps) {\\n        env1 = resume_walk_bind_pat(Array::get(ps, pi), env1)\\n        pi = pi + 1\\n      }\\n      env1\\n    },\\n    POr(a, b) => resume_walk_bind_pat(b, resume_walk_bind_pat(a, env)),\\n    PStruct(_, fields) => {\\n      let mut env1 = env\\n      let mut pi = 0\\n      while pi < Array::length(fields) {\\n        let (_, fp) = Array::get(fields, pi)\\n        env1 = resume_walk_bind_pat(fp, env1)\\n        pi = pi + 1\\n      }\\n      env1\\n    },\\n    _ => env\\n  }\\n}\\n\\n// #813: walk a handler arm body for `resume(x)` calls and check x against the\\n// op's declared return type (ground-gated via check_assignable). Nested\\n// EHandle subtrees are skipped entirely — their resumes belong to the inner\\n// handler's own arms. Runs on a throwaway lane after the arm body was checked,\\n// so it only ADDS diagnostics (main inference flow untouched). Local binders\\n// (let / let mut / let rec / match arms / for-in vars) are bound to CtUnknown\\n// while descending so resume(local) doesn't report a false `unknown name`.\\n// #640: walk a `with Error` handler arm body and reject any `resume(...)`\\n// call. `Error` is non-resumable — `throw` / `perform Error::Throw` unwind\\n// the stack for good (no perform-counter/memo replay machinery runs for tag\\n// 2), so a resume in an Error arm never resumed anything; it was silently\\n// meaningless. Nested EHandle subtrees are skipped (their resumes belong to\\n// the inner handler's own arms, which may be resumable effects).\\nfn reject_resume_in_error_arm(e: Expr, errors: Array[String]) -> Unit {\\n  match e {\\n    ECall(callee, args, _) => {\\n      match callee {\\n        EIdent(nm, off) => if nm == \\\"resume\\\" {\\n          Array::push(errors, String::concat(\\\"Error is a non-resumable effect (#640); an Error arm's value IS the handle result — remove resume(...)\\\", off_marker(off)))\\n        } else {\\n          ()\\n        },\\n        _ => reject_resume_in_error_arm(callee, errors)\\n      }\\n      let mut ri = 0\\n      while ri < Array::length(args) {\\n        reject_resume_in_error_arm(Array::get(args, ri), errors)\\n        ri = ri + 1\\n      }\\n    },\\n    EHandle(_, _) => (),\\n    ELet(_, v, b, _) => {\\n      reject_resume_in_error_arm(v, errors)\\n      reject_resume_in_error_arm(b, errors)\\n    },\\n    ELetMut(_, v, b, _) => {\\n      reject_resume_in_error_arm(v, errors)\\n      reject_resume_in_error_arm(b, errors)\\n    },\\n    ELetRec(_, v, b) => {\\n      reject_resume_in_error_arm(v, errors)\\n      reject_resume_in_error_arm(b, errors)\\n    },\\n    ESeq(a, b) => {\\n      reject_resume_in_error_arm(a, errors)\\n      reject_resume_in_error_arm(b, errors)\\n    },\\n    EIf(cnd, t, el) => {\\n      reject_resume_in_error_arm(cnd, errors)\\n      reject_resume_in_error_arm(t, errors)\\n      reject_resume_in_error_arm(el, errors)\\n    },\\n    EMatch(scr, marms) => {\\n      reject_resume_in_error_arm(scr, errors)\\n      let mut mi = 0\\n      while mi < Array::length(marms) {\\n        let (_, mb) = Array::get(marms, mi)\\n        reject_resume_in_error_arm(mb, errors)\\n        mi = mi + 1\\n      }\\n    },\\n    EWhile(cnd, b) => {\\n      reject_resume_in_error_arm(cnd, errors)\\n      reject_resume_in_error_arm(b, errors)\\n    },\\n    EForIn(_, _, it, b) => {\\n      reject_resume_in_error_arm(it, errors)\\n      reject_resume_in_error_arm(b, errors)\\n    },\\n    EBinOp(_, l, r) => {\\n      reject_resume_in_error_arm(l, errors)\\n      reject_resume_in_error_arm(r, errors)\\n    },\\n    EUnaryOp(_, inner) => reject_resume_in_error_arm(inner, errors),\\n    EAssign(_, v, b) => {\\n      reject_resume_in_error_arm(v, errors)\\n      reject_resume_in_error_arm(b, errors)\\n    },\\n    EAssignOp(_, _, v, b) => {\\n      reject_resume_in_error_arm(v, errors)\\n      reject_resume_in_error_arm(b, errors)\\n    },\\n    EFn(_, _, _, _, _, fb) => reject_resume_in_error_arm(fb, errors),\\n    EReturn(inner) => reject_resume_in_error_arm(inner, errors),\\n    EDot(obj, _, _, _) => reject_resume_in_error_arm(obj, errors),\\n    ETuple(items) => {\\n      let mut ti = 0\\n      while ti < Array::length(items) {\\n        reject_resume_in_error_arm(Array::get(items, ti), errors)\\n        ti = ti + 1\\n      }\\n    },\\n    EArray(items) => {\\n      let mut ti = 0\\n      while ti < Array::length(items) {\\n        reject_resume_in_error_arm(Array::get(items, ti), errors)\\n        ti = ti + 1\\n      }\\n    },\\n    // Codex P2 on #933: the catch-all silently ended the walk for these\\n    // recursive forms, so e.g. `Throw(_) => loop { break resume(0) }` or a\\n    // resume tucked into a record/map literal escaped the non-resumable\\n    // rejection and reached codegen's meaningless tag-1 path.\\n    ERecord(_, fields, _) => {\\n      let mut ti = 0\\n      while ti < Array::length(fields) {\\n        let (_, fe) = Array::get(fields, ti)\\n        reject_resume_in_error_arm(fe, errors)\\n        ti = ti + 1\\n      }\\n    },\\n    ELoop(binds, b) => {\\n      let mut ti = 0\\n      while ti < Array::length(binds) {\\n        let (_, be) = Array::get(binds, ti)\\n        reject_resume_in_error_arm(be, errors)\\n        ti = ti + 1\\n      }\\n      reject_resume_in_error_arm(b, errors)\\n    },\\n    ELabeledArg(_, _, inner) => reject_resume_in_error_arm(inner, errors),\\n    EBreak(opt) => match opt {\\n      Some(inner) => reject_resume_in_error_arm(inner, errors),\\n      None => ()\\n    },\\n    EContinue(items) => {\\n      let mut ti = 0\\n      while ti < Array::length(items) {\\n        reject_resume_in_error_arm(Array::get(items, ti), errors)\\n        ti = ti + 1\\n      }\\n    },\\n    EMap(pairs) => {\\n      let mut ti = 0\\n      while ti < Array::length(pairs) {\\n        let (_, pe) = Array::get(pairs, ti)\\n        reject_resume_in_error_arm(pe, errors)\\n        ti = ti + 1\\n      }\\n    },\\n    ESpread(inner) => reject_resume_in_error_arm(inner, errors),\\n    _ => ()\\n  }\\n}\\n\\n// #942 (ADR-0050): is this handler-arm pattern an `Error` arm? Error arms are\\n// owned by reject_resume_in_error_arm (#640), so the general resume-misuse\\n// walks below leave them alone (no double report).\\nfn handler_arm_pat_is_error(p: Pat) -> Bool {\\n  match p {\\n    PCtor(q, _) => {\\n      let ci = String::index_of(q, \\\"::\\\")\\n      ci > 0 && String::substring(q, 0, ci) == \\\"Error\\\"\\n    },\\n    _ => false\\n  }\\n}\\n\\n// #942 (Codex P2 on #969): does this pattern bind the name `resume`? Codegen's\\n// prefer_bound_call (codegen/expr/compile_call.vibe) sends `resume(x)` to the\\n// BOUND function whenever any top-level fn / local binding / binder named\\n// `resume` is in scope — such calls never touch the continuation machinery,\\n// so the #942 misuse walks must skip them (they ran fine pre-#942).\\nexport fn pat_binds_resume(p: Pat) -> Bool {\\n  match p {\\n    PBind(n) => n == \\\"resume\\\",\\n    PCtor(_, ps) => {\\n      let mut i = 0\\n      let mut found = false\\n      while i < Array::length(ps) {\\n        if pat_binds_resume(Array::get(ps, i)) {\\n          found = true\\n        } else {\\n          ()\\n        }\\n        i = i + 1\\n      }\\n      found\\n    },\\n    PTuple(ps) => {\\n      let mut i = 0\\n      let mut found = false\\n      while i < Array::length(ps) {\\n        if pat_binds_resume(Array::get(ps, i)) {\\n          found = true\\n        } else {\\n          ()\\n        }\\n        i = i + 1\\n      }\\n      found\\n    },\\n    POr(a, b) => pat_binds_resume(a) || pat_binds_resume(b),\\n    PStruct(_, fps) => {\\n      let mut i = 0\\n      let mut found = false\\n      while i < Array::length(fps) {\\n        let (_, fp) = Array::get(fps, i)\\n        if pat_binds_resume(fp) {\\n          found = true\\n        } else {\\n          ()\\n        }\\n        i = i + 1\\n      }\\n      found\\n    },\\n    _ => false\\n  }\\n}\\n\\n// #942 (Codex P2): does an EFn's parameter list bind `resume`? Labeled/\\n// optional params keep a trailing `~`/`?` in the raw AST name (stripped by\\n// the checker/codegen before binding, same as the labeled-param handling in\\n// check_expr's EFn arm above) — strip it here too so `fn f(resume~: ...)`\\n// is recognized as shadowing.\\nfn param_base_name(raw_name: String) -> String {\\n  let nlen = String::length(raw_name)\\n  if nlen > 0 {\\n    let lc = String::char_code_at(raw_name, nlen - 1)\\n    if lc == '~' || lc == '?' {\\n      raw_name[0: nlen - 1]\\n    } else raw_name\\n  } else raw_name\\n}\\n\\nfn fn_params_bind_resume(params: Array[(String, Option[TypeExpr])]) -> Bool {\\n  let mut i = 0\\n  let mut found = false\\n  while i < Array::length(params) {\\n    let (pn, _) = Array::get(params, i)\\n    if param_base_name(pn) == \\\"resume\\\" {\\n      found = true\\n    } else {\\n      ()\\n    }\\n    i = i + 1\\n  }\\n  found\\n}\\n\\n// #942 (ADR-0050): inside a handler arm, `resume(...)` is one-shot and must be\\n// the LAST thing the arm does. Codegen compiles resume as a continuation\\n// throw, so any code after it silently never runs — `let a = resume(1);\\n// resume(2)` returned the first resume's flow and dropped the second on the\\n// floor. Reject non-tail resume calls, mirroring the #814 rejection of the\\n// k-convention non-tail continuation binder. Tail position distributes\\n// through let/seq continuations and if/match branches (only one branch runs),\\n// so `if c { resume(1) } else { resume(2) }` and multi-statement arms ending\\n// in resume stay legal. `return resume(v)` inherits the tail flag (Codex P2\\n// on #969 — return exits before anything else runs; pre-#942 it behaved\\n// exactly like a plain tail resume at runtime). Loop bodies are never tail\\n// (a resume there would run per iteration). EFn subtrees are skipped\\n// wholesale — a resume inside a nested lambda keeps its pre-#942 acceptance.\\n// A nested EHandle's handled body inherits the current tail flag (its value\\n// IS the handle's value, and a lexical resume there still targets THIS arm's\\n// continuation); its non-Error arms restart a fresh tail walk of their own.\\n// `sh` = `resume` is shadowed by an enclosing binder (top-level fn/let,\\n// local let/let-mut/let-rec, match/for/loop binders, arm payload binders):\\n// codegen's prefer_bound_call routes such calls to the bound function, so\\n// the tail discipline does not apply to them (Codex P2 on #969).\\nfn check_arm_resume_tail(e: Expr, tail: Bool, sh: Bool, errors: Array[String]) -> Unit {\\n  match e {\\n    ECall(callee, args, _) => {\\n      match callee {\\n        EIdent(nm, off) => if nm == \\\"resume\\\" && !tail && !sh {\\n          Array::push(errors, String::concat(\\\"resume(...) must be the last expression of the handler arm (tail position) — code after a resume never runs, so a bound or repeated resume is silently dropped (#942, ADR-0050)\\\", off_marker(off)))\\n        } else {\\n          ()\\n        },\\n        _ => check_arm_resume_tail(callee, false, sh, errors)\\n      }\\n      let mut ri = 0\\n      while ri < Array::length(args) {\\n        check_arm_resume_tail(Array::get(args, ri), false, sh, errors)\\n        ri = ri + 1\\n      }\\n    },\\n    EHandle(body, harms) => {\\n      check_arm_resume_tail(body, tail, sh, errors)\\n      let mut hi = 0\\n      while hi < Array::length(harms) {\\n        let (hpat, hbody) = Array::get(harms, hi)\\n        if handler_arm_pat_is_error(hpat) {\\n          ()\\n        } else {\\n          check_arm_resume_tail(hbody, true, sh || pat_binds_resume(hpat), errors)\\n        }\\n        hi = hi + 1\\n      }\\n    },\\n    ELet(ln, v, b, _) => {\\n      check_arm_resume_tail(v, false, sh, errors)\\n      check_arm_resume_tail(b, tail, sh || ln == \\\"resume\\\", errors)\\n    },\\n    ELetMut(ln, v, b, _) => {\\n      check_arm_resume_tail(v, false, sh, errors)\\n      check_arm_resume_tail(b, tail, sh || ln == \\\"resume\\\", errors)\\n    },\\n    ELetRec(ln, v, b) => {\\n      check_arm_resume_tail(v, false, sh || ln == \\\"resume\\\", errors)\\n      check_arm_resume_tail(b, tail, sh || ln == \\\"resume\\\", errors)\\n    },\\n    ESeq(a, b) => {\\n      check_arm_resume_tail(a, false, sh, errors)\\n      check_arm_resume_tail(b, tail, sh, errors)\\n    },\\n    EIf(cnd, t, el) => {\\n      check_arm_resume_tail(cnd, false, sh, errors)\\n      check_arm_resume_tail(t, tail, sh, errors)\\n      check_arm_resume_tail(el, tail, sh, errors)\\n    },\\n    EMatch(scr, marms) => {\\n      check_arm_resume_tail(scr, false, sh, errors)\\n      let mut mi = 0\\n      while mi < Array::length(marms) {\\n        let (mp, mb) = Array::get(marms, mi)\\n        check_arm_resume_tail(mb, tail, sh || pat_binds_resume(mp), errors)\\n        mi = mi + 1\\n      }\\n    },\\n    EWhile(cnd, b) => {\\n      check_arm_resume_tail(cnd, false, sh, errors)\\n      check_arm_resume_tail(b, false, sh, errors)\\n    },\\n    EForIn(v1, v2, it, b) => {\\n      check_arm_resume_tail(it, false, sh, errors)\\n      let for_sh = v1 == \\\"resume\\\" || (match v2 {\\n        Some(v2n) => v2n == \\\"resume\\\",\\n        None => false\\n      })\\n      check_arm_resume_tail(b, false, sh || for_sh, errors)\\n    },\\n    EBinOp(_, l, r) => {\\n      check_arm_resume_tail(l, false, sh, errors)\\n      check_arm_resume_tail(r, false, sh, errors)\\n    },\\n    EUnaryOp(_, inner) => check_arm_resume_tail(inner, false, sh, errors),\\n    EAssign(_, v, b) => {\\n      check_arm_resume_tail(v, false, sh, errors)\\n      check_arm_resume_tail(b, tail, sh, errors)\\n    },\\n    EAssignOp(_, _, v, b) => {\\n      check_arm_resume_tail(v, false, sh, errors)\\n      check_arm_resume_tail(b, tail, sh, errors)\\n    },\\n    EFn(_, _, _, _, _, _) => (),\\n    EReturn(inner) => check_arm_resume_tail(inner, tail, sh, errors),\\n    EDot(obj, _, _, _) => check_arm_resume_tail(obj, false, sh, errors),\\n    ETuple(items) => {\\n      let mut ti = 0\\n      while ti < Array::length(items) {\\n        check_arm_resume_tail(Array::get(items, ti), false, sh, errors)\\n        ti = ti + 1\\n      }\\n    },\\n    EArray(items) => {\\n      let mut ti = 0\\n      while ti < Array::length(items) {\\n        check_arm_resume_tail(Array::get(items, ti), false, sh, errors)\\n        ti = ti + 1\\n      }\\n    },\\n    ERecord(_, fields, _) => {\\n      let mut ti = 0\\n      while ti < Array::length(fields) {\\n        let (_, fe) = Array::get(fields, ti)\\n        check_arm_resume_tail(fe, false, sh, errors)\\n        ti = ti + 1\\n      }\\n    },\\n    ELoop(binds, b) => {\\n      let mut ti = 0\\n      let mut loop_sh = false\\n      while ti < Array::length(binds) {\\n        let (bn, be) = Array::get(binds, ti)\\n        if bn == \\\"resume\\\" {\\n          loop_sh = true\\n        } else {\\n          ()\\n        }\\n        check_arm_resume_tail(be, false, sh, errors)\\n        ti = ti + 1\\n      }\\n      check_arm_resume_tail(b, false, sh || loop_sh, errors)\\n    },\\n    ELabeledArg(_, _, inner) => check_arm_resume_tail(inner, false, sh, errors),\\n    EBreak(opt) => match opt {\\n      Some(inner) => check_arm_resume_tail(inner, false, sh, errors),\\n      None => ()\\n    },\\n    EContinue(items) => {\\n      let mut ti = 0\\n      while ti < Array::length(items) {\\n        check_arm_resume_tail(Array::get(items, ti), false, sh, errors)\\n        ti = ti + 1\\n      }\\n    },\\n    EMap(pairs) => {\\n      let mut ti = 0\\n      while ti < Array::length(pairs) {\\n        let (_, pe) = Array::get(pairs, ti)\\n        check_arm_resume_tail(pe, false, sh, errors)\\n        ti = ti + 1\\n      }\\n    },\\n    ESpread(inner) => check_arm_resume_tail(inner, false, sh, errors),\\n    _ => ()\\n  }\\n}\\n\\n// #942 (ADR-0050): a call-position `resume(...)` OUTSIDE any handler arm has\\n// no continuation to resume. Codegen emits the tag-1 continuation throw\\n// unconditionally (see codegen/common_analysis — the module must stay valid),\\n// so `fn f() -> Int { resume(1); 2 }` compiled and then died at runtime with\\n// an unhandled wasm exception. Walk every top-level statement expression and\\n// reject it in the checker instead. Only CALLS are rejected — `resume` as an\\n// ordinary binding name (e.g. lib/@vibe/parser/lexer.vibe's `let resume =\\n// ...`, which is passed around but never called) stays legal. On reaching an\\n// EHandle, the handled body is still \\\"outside\\\" (a resume there is not in any\\n// arm); non-Error arm bodies switch to the check_arm_resume_tail walk above,\\n// and Error arms are left to reject_resume_in_error_arm (#640).\\n// `sh` = `resume` is shadowed by an enclosing binder (Codex P2 on #969):\\n// codegen's prefer_bound_call routes `resume(x)` to the BOUND function\\n// whenever a top-level fn/let named resume, a local binding, a lambda param,\\n// or a match/for/loop binder named resume is in scope — such calls ran fine\\n// pre-#942 and must stay accepted. check_stmts seeds `sh` from the top-level\\n// declarations (fn resume / let resume / extern / imports).\\nexport fn reject_resume_outside_handler(e: Expr, sh: Bool, errors: Array[String]) -> Unit {\\n  match e {\\n    ECall(callee, args, _) => {\\n      match callee {\\n        EIdent(nm, off) => if nm == \\\"resume\\\" && !sh {\\n          Array::push(errors, String::concat(\\\"resume(...) is only valid inside a handler arm of `handle ... with` — outside one there is no continuation to resume (#942, ADR-0050)\\\", off_marker(off)))\\n        } else {\\n          ()\\n        },\\n        _ => reject_resume_outside_handler(callee, sh, errors)\\n      }\\n      let mut ri = 0\\n      while ri < Array::length(args) {\\n        reject_resume_outside_handler(Array::get(args, ri), sh, errors)\\n        ri = ri + 1\\n      }\\n    },\\n    EHandle(body, harms) => {\\n      reject_resume_outside_handler(body, sh, errors)\\n      let mut hi = 0\\n      while hi < Array::length(harms) {\\n        let (hpat, hbody) = Array::get(harms, hi)\\n        if handler_arm_pat_is_error(hpat) {\\n          ()\\n        } else {\\n          check_arm_resume_tail(hbody, true, sh || pat_binds_resume(hpat), errors)\\n        }\\n        hi = hi + 1\\n      }\\n    },\\n    ELet(ln, v, b, _) => {\\n      reject_resume_outside_handler(v, sh, errors)\\n      reject_resume_outside_handler(b, sh || ln == \\\"resume\\\", errors)\\n    },\\n    ELetMut(ln, v, b, _) => {\\n      reject_resume_outside_handler(v, sh, errors)\\n      reject_resume_outside_handler(b, sh || ln == \\\"resume\\\", errors)\\n    },\\n    ELetRec(ln, v, b) => {\\n      reject_resume_outside_handler(v, sh || ln == \\\"resume\\\", errors)\\n      reject_resume_outside_handler(b, sh || ln == \\\"resume\\\", errors)\\n    },\\n    ESeq(a, b) => {\\n      reject_resume_outside_handler(a, sh, errors)\\n      reject_resume_outside_handler(b, sh, errors)\\n    },\\n    EIf(cnd, t, el) => {\\n      reject_resume_outside_handler(cnd, sh, errors)\\n      reject_resume_outside_handler(t, sh, errors)\\n      reject_resume_outside_handler(el, sh, errors)\\n    },\\n    EMatch(scr, marms) => {\\n      reject_resume_outside_handler(scr, sh, errors)\\n      let mut mi = 0\\n      while mi < Array::length(marms) {\\n        let (mp, mb) = Array::get(marms, mi)\\n        reject_resume_outside_handler(mb, sh || pat_binds_resume(mp), errors)\\n        mi = mi + 1\\n      }\\n    },\\n    EWhile(cnd, b) => {\\n      reject_resume_outside_handler(cnd, sh, errors)\\n      reject_resume_outside_handler(b, sh, errors)\\n    },\\n    EForIn(v1, v2, it, b) => {\\n      reject_resume_outside_handler(it, sh, errors)\\n      let for_sh = v1 == \\\"resume\\\" || (match v2 {\\n        Some(v2n) => v2n == \\\"resume\\\",\\n        None => false\\n      })\\n      reject_resume_outside_handler(b, sh || for_sh, errors)\\n    },\\n    EBinOp(_, l, r) => {\\n      reject_resume_outside_handler(l, sh, errors)\\n      reject_resume_outside_handler(r, sh, errors)\\n    },\\n    EUnaryOp(_, inner) => reject_resume_outside_handler(inner, sh, errors),\\n    EAssign(_, v, b) => {\\n      reject_resume_outside_handler(v, sh, errors)\\n      reject_resume_outside_handler(b, sh, errors)\\n    },\\n    EAssignOp(_, _, v, b) => {\\n      reject_resume_outside_handler(v, sh, errors)\\n      reject_resume_outside_handler(b, sh, errors)\\n    },\\n    EFn(_, _, fparams, _, _, fb) => reject_resume_outside_handler(fb, sh || fn_params_bind_resume(fparams), errors),\\n    EReturn(inner) => reject_resume_outside_handler(inner, sh, errors),\\n    EDot(obj, _, _, _) => reject_resume_outside_handler(obj, sh, errors),\\n    ETuple(items) => {\\n      let mut ti = 0\\n      while ti < Array::length(items) {\\n        reject_resume_outside_handler(Array::get(items, ti), sh, errors)\\n        ti = ti + 1\\n      }\\n    },\\n    EArray(items) => {\\n      let mut ti = 0\\n      while ti < Array::length(items) {\\n        reject_resume_outside_handler(Array::get(items, ti), sh, errors)\\n        ti = ti + 1\\n      }\\n    },\\n    ERecord(_, fields, _) => {\\n      let mut ti = 0\\n      while ti < Array::length(fields) {\\n        let (_, fe) = Array::get(fields, ti)\\n        reject_resume_outside_handler(fe, sh, errors)\\n        ti = ti + 1\\n      }\\n    },\\n    ELoop(binds, b) => {\\n      let mut ti = 0\\n      let mut loop_sh = false\\n      while ti < Array::length(binds) {\\n        let (bn, be) = Array::get(binds, ti)\\n        if bn == \\\"resume\\\" {\\n          loop_sh = true\\n        } else {\\n          ()\\n        }\\n        reject_resume_outside_handler(be, sh, errors)\\n        ti = ti + 1\\n      }\\n      reject_resume_outside_handler(b, sh || loop_sh, errors)\\n    },\\n    ELabeledArg(_, _, inner) => reject_resume_outside_handler(inner, sh, errors),\\n    EBreak(opt) => match opt {\\n      Some(inner) => reject_resume_outside_handler(inner, sh, errors),\\n      None => ()\\n    },\\n    EContinue(items) => {\\n      let mut ti = 0\\n      while ti < Array::length(items) {\\n        reject_resume_outside_handler(Array::get(items, ti), sh, errors)\\n        ti = ti + 1\\n      }\\n    },\\n    EMap(pairs) => {\\n      let mut ti = 0\\n      while ti < Array::length(pairs) {\\n        let (_, pe) = Array::get(pairs, ti)\\n        reject_resume_outside_handler(pe, sh, errors)\\n        ti = ti + 1\\n      }\\n    },\\n    ESpread(inner) => reject_resume_outside_handler(inner, sh, errors),\\n    _ => ()\\n  }\\n}\\n\\nfn check_resume_values(e: Expr, ret_ty: Type, env: TypeEnv, defs: Array[TypeDef], s: Subst, c: Int, errors: Array[String], tytab: Array[(Int, Type)]) -> Subst {\\n  match e {\\n    ECall(callee, args, _) => {\\n      let mut s1 = s\\n      // #942 (Codex P2 on #970): `env` is the normal lexical TypeEnv threaded\\n      // through check_expr, already containing every enclosing binder (the\\n      // top-level fn/let hoist, the arm's own payload binders via henv, and\\n      // any local let/let-mut/let-rec/match-arm binder this walk itself adds\\n      // below) — so a `resume` name already bound here is a real callable\\n      // binding codegen's prefer_bound_call routes to, not the builtin.\\n      let resume_shadowed = env_lookup(env, \\\"resume\\\") is Some(_)\\n      match callee {\\n        EIdent(nm, _) => {\\n          // A Unit-returning op discards the resumed value at the perform\\n          // site, so any resume argument is tolerated there (mirrors the\\n          // statement-position Unit tolerance elsewhere; the existing idiom\\n          // `Print(s) => resume(0)` for `Print(String) -> Unit` stays legal).\\n          if nm == \\\"resume\\\" && !resume_shadowed && Array::length(args) == 1 && !(ret_ty is CtUnit) {\\n            let (aty, ns, _) = check_expr(Array::get(args, 0), env, defs, s1, c, errors, tytab)\\n            s1 = check_assignable(ret_ty, subst_apply(ns, aty), ns, errors, \\\"resume value type mismatch\\\", 0 - 1)\\n          } else if nm == \\\"resume\\\" && !resume_shadowed && Array::length(args) == 0 && !(ret_ty is CtUnit) {\\n            // #828: `resume()` on a value-returning op used to reach codegen,\\n            // which indexes resume args[0] unconditionally — a compiler ICE\\n            // with no diagnostic. Reject it here instead.\\n            Array::push(errors, \\\"resume expects a value (the operation returns a non-Unit type); resume() with no argument is only valid for Unit-returning operations\\\")\\n          } else {\\n            ()\\n          }\\n        },\\n        _ => {\\n          s1 = check_resume_values(callee, ret_ty, env, defs, s1, c, errors, tytab)\\n        }\\n      }\\n      let mut ri = 0\\n      while ri < Array::length(args) {\\n        s1 = check_resume_values(Array::get(args, ri), ret_ty, env, defs, s1, c, errors, tytab)\\n        ri = ri + 1\\n      }\\n      s1\\n    },\\n    EHandle(_, _) => s,\\n    ELet(ln, v, b, _) => check_resume_values(b, ret_ty, env_bind(env, ln, CtUnknown), defs, check_resume_values(v, ret_ty, env, defs, s, c, errors, tytab), c, errors, tytab),\\n    ELetMut(ln, v, b, _) => check_resume_values(b, ret_ty, env_bind(env, ln, CtUnknown), defs, check_resume_values(v, ret_ty, env, defs, s, c, errors, tytab), c, errors, tytab),\\n    ELetRec(ln, v, b) => check_resume_values(b, ret_ty, env_bind(env, ln, CtUnknown), defs, check_resume_values(v, ret_ty, env_bind(env, ln, CtUnknown), defs, s, c, errors, tytab), c, errors, tytab),\\n    ESeq(a, b) => check_resume_values(b, ret_ty, env, defs, check_resume_values(a, ret_ty, env, defs, s, c, errors, tytab), c, errors, tytab),\\n    EIf(cnd, t, el) => check_resume_values(el, ret_ty, env, defs, check_resume_values(t, ret_ty, env, defs, check_resume_values(cnd, ret_ty, env, defs, s, c, errors, tytab), c, errors, tytab), c, errors, tytab),\\n    EMatch(scr, marms) => {\\n      let mut s1 = check_resume_values(scr, ret_ty, env, defs, s, c, errors, tytab)\\n      let mut mi = 0\\n      while mi < Array::length(marms) {\\n        let (mp, mb) = Array::get(marms, mi)\\n        s1 = check_resume_values(mb, ret_ty, resume_walk_bind_pat(mp, env), defs, s1, c, errors, tytab)\\n        mi = mi + 1\\n      }\\n      s1\\n    },\\n    EWhile(cnd, b) => check_resume_values(b, ret_ty, env, defs, check_resume_values(cnd, ret_ty, env, defs, s, c, errors, tytab), c, errors, tytab),\\n    EForIn(fname, fidx, it, b) => {\\n      let fenv = match fidx {\\n        Some(fi) => env_bind(env_bind(env, fname, CtUnknown), fi, CtUnknown),\\n        None => env_bind(env, fname, CtUnknown)\\n      }\\n      check_resume_values(b, ret_ty, fenv, defs, check_resume_values(it, ret_ty, env, defs, s, c, errors, tytab), c, errors, tytab)\\n    },\\n    EBinOp(_, l, r) => check_resume_values(r, ret_ty, env, defs, check_resume_values(l, ret_ty, env, defs, s, c, errors, tytab), c, errors, tytab),\\n    EUnaryOp(_, inner) => check_resume_values(inner, ret_ty, env, defs, s, c, errors, tytab),\\n    EAssign(_, v, b) => check_resume_values(b, ret_ty, env, defs, check_resume_values(v, ret_ty, env, defs, s, c, errors, tytab), c, errors, tytab),\\n    EAssignOp(_, _, v, b) => check_resume_values(b, ret_ty, env, defs, check_resume_values(v, ret_ty, env, defs, s, c, errors, tytab), c, errors, tytab),\\n    EFn(_, _, _, _, _, fb) => check_resume_values(fb, ret_ty, env, defs, s, c, errors, tytab),\\n    EReturn(inner) => check_resume_values(inner, ret_ty, env, defs, s, c, errors, tytab),\\n    EDot(obj, _, _, _) => check_resume_values(obj, ret_ty, env, defs, s, c, errors, tytab),\\n    ETuple(items) => {\\n      let mut s1 = s\\n      let mut ti = 0\\n      while ti < Array::length(items) {\\n        s1 = check_resume_values(Array::get(items, ti), ret_ty, env, defs, s1, c, errors, tytab)\\n        ti = ti + 1\\n      }\\n      s1\\n    },\\n    EArray(items) => {\\n      let mut s1 = s\\n      let mut ti = 0\\n      while ti < Array::length(items) {\\n        s1 = check_resume_values(Array::get(items, ti), ret_ty, env, defs, s1, c, errors, tytab)\\n        ti = ti + 1\\n      }\\n      s1\\n    },\\n    _ => s\\n  }\\n}\\n\\nexport fn check_expr(expr: Expr, env: TypeEnv, defs: Array[TypeDef], s: Subst, c: Int, errors: Array[String], tytab: Array[(Int, Type)]) -> (Type, Subst, Int) {\\n  match expr {\\n    EInt(_) => (CtInt, s, c),\\n    EFloat(_) => (CtDouble, s, c),\\n    EString(_) => (CtString, s, c),\\n    EBool(_) => (CtBool, s, c),\\n    EUnit => (CtUnit, s, c),\\n    EIdent(name, ident_off) => match env_lookup(env, name) {\\n      Some(t) => {\\n        let (ti, c1, new_bounds) = instantiate(t, c)\\n        let nblen = Array::length(new_bounds)\\n        let mut s1 = s\\n        let mut bi = 0\\n        while bi < nblen {\\n          let (vid, bounds) = Array::get(new_bounds, bi)\\n          if Array::length(bounds) != 0 {\\n            s1 = subst_add_bound(s1, vid, bounds)\\n          }\\n          bi = bi + 1\\n        }\\n        // Record this user identifier's inferred (raw, pre-final-subst) type\\n        // keyed by its real source offset, for typed-hover (vibe type-at) on\\n        // locals and parameters. Synthetic idents (off < 0) are skipped.\\n        if ident_off >= 0 {\\n          Array::push(tytab, (ident_off, ti))\\n        } else {\\n          ()\\n        }\\n        (ti, s1, c1)\\n      },\\n      None => match lookup_builtin(name) {\\n        Some(t) => {\\n          if ident_off >= 0 {\\n            Array::push(tytab, (ident_off, t))\\n          } else {\\n            ()\\n          }\\n          (t, s, c)\\n        },\\n        None => match resolve_trait_method_ident(name, env, defs, s) {\\n          Some(mty) => {\\n            if ident_off >= 0 {\\n              Array::push(tytab, (ident_off, mty))\\n            } else {\\n              ()\\n            }\\n            (mty, s, c)\\n          },\\n          None => match resolve_qualified_ctor_ident(name, env, defs) {\\n            Some(ct) => {\\n              let (ti, c1, new_bounds) = instantiate(ct, c)\\n              let nblen = Array::length(new_bounds)\\n              let mut s1 = s\\n              let mut bi = 0\\n              while bi < nblen {\\n                let (vid, bounds) = Array::get(new_bounds, bi)\\n                if Array::length(bounds) != 0 {\\n                  s1 = subst_add_bound(s1, vid, bounds)\\n                } else {\\n                  ()\\n                }\\n                bi = bi + 1\\n              }\\n              if ident_off >= 0 {\\n                Array::push(tytab, (ident_off, ti))\\n              } else {\\n                ()\\n              }\\n              (ti, s1, c1)\\n            },\\n            None => {\\n              Array::push(errors, String::concat(String::concat(\\\"unknown name: \\\", name), off_marker_len(ident_off, String::length(name))))\\n              (CtUnknown, s, c)\\n            }\\n          }\\n        }\\n      }\\n    },\\n    ESeq(_, _) => check_seq_spine(expr, env, defs, s, c, errors, tytab, check_expr),\\n    ELet(_, _, _, _) => check_seq_spine(expr, env, defs, s, c, errors, tytab, check_expr),\\n    ELetRec(_, _, _) => check_seq_spine(expr, env, defs, s, c, errors, tytab, check_expr),\\n    ELetMut(_, _, _, _) => check_seq_spine(expr, env, defs, s, c, errors, tytab, check_expr),\\n    EIf(cond, then_e, else_e) => {\\n      let (ct, s1, c1) = check_expr(cond, env, defs, s, c, errors, tytab)\\n      let resolved_ct = subst_apply(s1, ct)\\n      match resolved_ct {\\n        CtBool => (),\\n        CtUnknown => (),\\n        CtVar(_) => (),\\n        _ => Array::push(errors, \\\"if condition must be Bool\\\")\\n      }\\n      let (tt, s2, c2) = check_expr(then_e, env, defs, s1, c1, errors, tytab)\\n      let (et, s3, c3) = check_expr(else_e, env, defs, s2, c2, errors, tytab)\\n      // The two branches must agree when both yield a real value (previously\\n      // unchecked — `if c { 1 } else { \\\"x\\\" }` was accepted). A `CtUnit` branch\\n      // is tolerated: `if c { stmt }` desugars to an `else ()` whose value is\\n      // discarded, and a statement-position `if` need not have matching arms.\\n      let rtt = subst_apply(s3, tt)\\n      let ret = subst_apply(s3, et)\\n      // When one branch yields Unit (an else-less `if`, whose missing else is\\n      // `()`, or an explicit `()` branch), the branches need not agree and the\\n      // expression yields Unit as a VALUE — so `let x: Int = if c { 1 }` is\\n      // rejected (it returns Unit when c is false) while a statement-position\\n      // `if` is harmless (its value is discarded). Only when BOTH branches yield\\n      // a real (non-Unit) value must they agree, and the result is that type.\\n      let (s3b, if_ty) = match rtt {\\n        CtUnit => (s3, CtUnit),\\n        _ => match ret {\\n          CtUnit => (s3, CtUnit),\\n          _ => (check_assignable(rtt, ret, s3, errors, \\\"if branches have incompatible types\\\", 0 - 1), tt)\\n        }\\n      }\\n      (if_ty, s3b, c3)\\n    },\\n    ECall(callee, args, call_off) => match callee {\\n      // `perform EffName::Op(opargs)` parses as ECall(EIdent(\\\"perform\\\"),\\n      // [ECall(EIdent(\\\"EffName::Op\\\"), opargs)]). The op name may be a builtin\\n      // effect (Stdin/Stdout/...) not registered in the checker env, so check\\n      // only the op ARGUMENTS (not the op callee) and yield a fresh result type.\\n      // `resume(v)` likewise yields the continuation result (a fresh var;\\n      // handler arms are otherwise unchecked).\\n      EIdent(name, callee_off) => {\\n        field_write_mut_check(name, args, env, defs, s, c, errors, tytab, check_expr)\\n        index_target_check(name, args, env, defs, s, c, errors, check_expr)\\n        if name == \\\"perform\\\" {\\n        if Array::length(args) == 1 {\\n          match Array::get(args, 0) {\\n            ECall(op_callee, opargs, _) => {\\n              // #640 Stage 2: `throw(x)` now parses to this exact shape\\n              // (perform Error::Throw(x)). Preserve EThrow's historical\\n              // typing verbatim: the payload is NOT type-checked (EThrow fell\\n              // to check_expr's catch-all) and the value is CtUnknown (a\\n              // wildcard — `throw` sits in any expression position). Running\\n              // the generic perform path instead would newly check the ~970\\n              // existing throw payloads and yield a fresh var, changing\\n              // pinned checker behavior.\\n              let is_error_throw = match op_callee {\\n                EIdent(op_qname0, _) => op_qname0 == \\\"Error::Throw\\\",\\n                _ => false\\n              }\\n              if is_error_throw {\\n                (CtUnknown, s, c)\\n              } else {\\n              let oalen = Array::length(opargs)\\n              let mut s1 = s\\n              let mut c1 = c\\n              let oparg_tys = Array::slice([\\n                CtUnknown\\n              ], 0, 0)\\n              let mut ai = 0\\n              while ai < oalen {\\n                let (oat, ns, nc) = check_expr(Array::get(opargs, ai), env, defs, s1, c1, errors, tytab)\\n                Array::push(oparg_tys, oat)\\n                s1 = ns\\n                c1 = nc\\n                ai = ai + 1\\n              }\\n              // #813: when the op belongs to a DECLARED effect, validate the\\n              // perform against its signature — arity and (ground-gated)\\n              // argument types were previously unchecked, so\\n              // `perform R::Take(\\\"str\\\")` against `Take(Int)` compiled and\\n              // produced garbage. Builtin/imported effects (no TDEffect) skip.\\n              match op_callee {\\n                EIdent(op_qname, op_off) => match effect_op_sig(defs, op_qname) {\\n                  Some(sig) => {\\n                    let (sig_params, sig_ret) = sig\\n                    if Array::length(sig_params) != oalen {\\n                      Array::push(errors, String::concat(\\\"perform \\\", String::concat(op_qname, String::concat(\\\" expects \\\", String::concat(__to_string(Array::length(sig_params)), String::concat(\\\" argument(s), got \\\", String::concat(__to_string(oalen), off_marker(op_off))))))))\\n                    } else {\\n                      let mut vi = 0\\n                      while vi < oalen {\\n                        s1 = check_assignable(Array::get(sig_params, vi), subst_apply(s1, Array::get(oparg_tys, vi)), s1, errors, String::concat(\\\"perform argument type mismatch for \\\", op_qname), op_off)\\n                        vi = vi + 1\\n                      }\\n                    }\\n                    // The perform's value is the op's declared return type —\\n                    // typing it (instead of a fresh var) also lets resume/arm\\n                    // consumers see the concrete type. Non-ground returns keep\\n                    // the fresh var (generic inference untouched).\\n                    if type_is_ground(sig_ret) {\\n                      (sig_ret, s1, c1)\\n                    } else {\\n                      let (tv, c2) = fresh_var(c1)\\n                      (tv, s1, c2)\\n                    }\\n                  },\\n                  None => {\\n                    // Unknown op of a DECLARED effect: the typo'd op would\\n                    // never be matched by any handler arm — report it.\\n                    let ci2 = String::index_of(op_qname, \\\"::\\\")\\n                    if ci2 > 0 && effect_is_declared(defs, String::substring(op_qname, 0, ci2)) {\\n                      Array::push(errors, String::concat(\\\"unknown operation `\\\", String::concat(String::substring(op_qname, ci2 + 2, String::length(op_qname)), String::concat(\\\"` of effect \\\", String::concat(String::substring(op_qname, 0, ci2), off_marker(op_off))))))\\n                    } else {\\n                      ()\\n                    }\\n                    let (tv, c2) = fresh_var(c1)\\n                    (tv, s1, c2)\\n                  }\\n                },\\n                _ => {\\n                  let (tv, c2) = fresh_var(c1)\\n                  (tv, s1, c2)\\n                }\\n              }\\n              }\\n            },\\n            EIdent(_, _) => {\\n              let (tv, c2) = fresh_var(c)\\n              (tv, s, c2)\\n            },\\n            other => check_expr(other, env, defs, s, c, errors, tytab)\\n          }\\n        } else {\\n          (CtUnknown, s, c)\\n        }\\n      } else if name == \\\"resume\\\" {\\n        let alen = Array::length(args)\\n        let mut s1 = s\\n        let mut c1 = c\\n        let mut ai = 0\\n        while ai < alen {\\n          let (_, ns, nc) = check_expr(Array::get(args, ai), env, defs, s1, c1, errors, tytab)\\n          s1 = ns\\n          c1 = nc\\n          ai = ai + 1\\n        }\\n        let (tv, c2) = fresh_var(c1)\\n        (tv, s1, c2)\\n      } else if name == \\\"%wasm\\\" {\\n        // #805 (ADR-0072) inline wasm marker: only producible by the parser's\\n        // `fn f(a: Int, ..) -> Int = wasm \\\"...\\\"` form (a `%`-ident cannot be\\n        // parsed in expression position, so user source cannot forge it).\\n        // The declared signature is trusted extern-let style; the call's\\n        // value is a fresh var that unifies with the declared Int return.\\n        // The single arg is the WAT text literal — shape-checked here\\n        // defensively, never evaluated.\\n        let wasm_shape_ok = if Array::length(args) == 1 {\\n          match Array::get(args, 0) {\\n            EString(_) => true,\\n            _ => false\\n          }\\n        } else {\\n          false\\n        }\\n        if !wasm_shape_ok {\\n          Array::push(errors, \\\"malformed inline wasm marker (expected a single WAT string literal)\\\")\\n        } else {\\n          ()\\n        }\\n        let (tv, c2) = fresh_var(c)\\n        (tv, s, c2)\\n      } else if name == \\\"Some\\\" {\\n        if Array::length(args) == 1 {\\n          let (at, s1, c1) = check_expr(Array::get(args, 0), env, defs, s, c, errors, tytab)\\n          (tab_call_ty(tytab, call_off, CtOption(subst_apply(s1, at))), s1, c1)\\n        } else {\\n          // `Some` takes exactly one payload — `Some(1, 2)` was accepted.\\n          Array::push(errors, String::concat(String::concat(\\\"Some expects 1 argument, got \\\", __to_string(Array::length(args))), off_marker_len(callee_off, 4)))\\n          (tab_call_ty(tytab, call_off, CtOption(CtUnknown)), s, c)\\n        }\\n      } else if name == \\\"__index\\\" && Array::length(args) == 2 {\\n        // `obj[i]` (`__index(obj, i)`) is typed polymorphically by the builtin\\n        // table, losing the result type — `let s: String = a[0]` over an\\n        // `Array[Int]` slipped through. When the receiver resolves to\\n        // `CtArray(elem)`, refine the result to `elem`; String/Bytes indexing\\n        // yields the char/byte code (`Int`) so `let s: String = \\\"abc\\\"[0]`\\n        // (which returns 97) must be rejected. Var / unknown / named receivers\\n        // keep the conservative CtUnknown. (index_target_check above still\\n        // validates the receiver/subscript shapes on a throwaway channel.)\\n        let (obj_ty, s1, c1) = check_expr(Array::get(args, 0), env, defs, s, c, errors, tytab)\\n        let (_, s2, c2) = check_expr(Array::get(args, 1), env, defs, s1, c1, errors, tytab)\\n        let result = match subst_apply(s2, obj_ty) {\\n          CtArray(elem) => elem,\\n          CtString => CtInt,\\n          CtBytes => CtInt,\\n          _ => CtUnknown\\n        }\\n        (tab_call_ty(tytab, call_off, result), s2, c2)\\n      } else if name == \\\"ArrayBuilder::new\\\" && Array::length(args) == 0 {\\n        // #938: the builder ops were typed all-CtUnknown, so\\n        // `ArrayBuilder::push(b, 1); ArrayBuilder::push(b, \\\"two\\\")` compiled\\n        // clean and the frozen array leaked a raw String pointer through an\\n        // `Array[Int]` annotation. Give the builder a REAL element slot:\\n        // `CtNamed(\\\"ArrayBuilder\\\", [fresh])` — the same shape an explicit\\n        // `b: ArrayBuilder[String]` annotation already resolves to\\n        // (checker_resolve TyApp fallback), so annotated params get checked\\n        // by the same push/freeze rules for free. The fresh var is bound by\\n        // the FIRST push and every later push must unify with it. (ELet's\\n        // generalize deliberately skips this shape — see the value-restriction\\n        // note at the ELet arm — or each use would re-instantiate the var and\\n        // the pushes could never disagree.)\\n        let (ev, c1) = fresh_var(c)\\n        (tab_call_ty(tytab, call_off, CtNamed(\\\"ArrayBuilder\\\", Array::slice([\\n          ev\\n        ], 0, 1))), s, c1)\\n      } else if name == \\\"ArrayBuilder::push\\\" && Array::length(args) == 2 {\\n        // #938: unify the pushed value with the builder's element slot. A\\n        // builder that reaches here untyped (CtUnknown / var receiver from an\\n        // un-annotated param) stays tolerant, exactly like Array::push's\\n        // ground gate.\\n        let (b_ty, s1, c1) = check_expr(Array::get(args, 0), env, defs, s, c, errors, tytab)\\n        let (v_ty, s2, c2) = check_expr(Array::get(args, 1), env, defs, s1, c1, errors, tytab)\\n        let s3 = match subst_apply(s2, b_ty) {\\n          CtNamed(bn, bargs) => if bn == \\\"ArrayBuilder\\\" && Array::length(bargs) == 1 {\\n            match unify(Array::get(bargs, 0), v_ty, s2) {\\n              Some(su) => su,\\n              None => {\\n                Array::push(errors, String::concat(\\\"ArrayBuilder::push element type mismatch: builder holds \\\", String::concat(type_to_string(subst_apply(s2, Array::get(bargs, 0))), String::concat(\\\", got \\\", String::concat(type_to_string(subst_apply(s2, v_ty)), off_marker_len(callee_off, String::length(name)))))))\\n                s2\\n              }\\n            }\\n          } else {\\n            s2\\n          },\\n          _ => s2\\n        }\\n        (tab_call_ty(tytab, call_off, CtUnit), s3, c2)\\n      } else if name == \\\"ArrayBuilder::freeze\\\" && Array::length(args) == 1 {\\n        // #938: freeze returns an array of the builder's (now tracked) element\\n        // type, so a wrong return/let annotation is caught by the ordinary\\n        // unify instead of vanishing into CtArray(CtUnknown).\\n        let (b_ty, s1, c1) = check_expr(Array::get(args, 0), env, defs, s, c, errors, tytab)\\n        let result = match subst_apply(s1, b_ty) {\\n          CtNamed(bn, bargs) => if bn == \\\"ArrayBuilder\\\" && Array::length(bargs) == 1 {\\n            CtArray(subst_apply(s1, Array::get(bargs, 0)))\\n          } else {\\n            CtArray(CtUnknown)\\n          },\\n          _ => CtArray(CtUnknown)\\n        }\\n        (tab_call_ty(tytab, call_off, result), s1, c1)\\n      } else if name == \\\"Map::set\\\" && Array::length(args) == 3 {\\n        // #983: every Map API's VALUE position was `CtUnknown` (the static\\n        // builtin table cannot mint per-call vars), so\\n        // `Map::set(m, \\\"b\\\", \\\"str\\\")` into a `Map[String, Int]` compiled clean\\n        // and trapped at the consumer. Map literals now carry a real value\\n        // slot (`CtNamed(\\\"Map\\\", [CtString, v])` — the shape a\\n        // `Map[String, V]` annotation already resolves to), and set checks\\n        // the written value against it, ground-gated via `check_assignable`\\n        // (same tolerate discipline as Array::push — untyped/var receivers\\n        // stay tolerant). The key check replicates the CtString param the\\n        // bypassed table signature enforced.\\n        let (m_ty, s1, c1) = check_expr(Array::get(args, 0), env, defs, s, c, errors, tytab)\\n        let (k_ty, s2, c2) = check_expr(Array::get(args, 1), env, defs, s1, c1, errors, tytab)\\n        let (v_ty, s3, c3) = check_expr(Array::get(args, 2), env, defs, s2, c2, errors, tytab)\\n        let s4 = check_assignable(CtString, subst_apply(s3, k_ty), s3, errors, \\\"argument type mismatch for Map::set\\\", call_off)\\n        let s5 = match subst_apply(s4, m_ty) {\\n          CtNamed(mn, margs) => if mn == \\\"Map\\\" && Array::length(margs) == 2 {\\n            check_assignable(subst_apply(s4, Array::get(margs, 1)), subst_apply(s4, v_ty), s4, errors, \\\"Map::set value type mismatch\\\", call_off)\\n          } else {\\n            s4\\n          },\\n          _ => s4\\n        }\\n        let mret = match subst_apply(s5, m_ty) {\\n          CtNamed(mn2, margs2) => if mn2 == \\\"Map\\\" && Array::length(margs2) == 2 {\\n            subst_apply(s5, m_ty)\\n          } else {\\n            CtNamed(\\\"Map\\\", [CtString, CtUnknown])\\n          },\\n          _ => CtNamed(\\\"Map\\\", [CtString, CtUnknown])\\n        }\\n        (tab_call_ty(tytab, call_off, mret), s5, c3)\\n      } else if name == \\\"Map::get\\\" && Array::length(args) == 2 {\\n        // #983: refine the result from bare CtUnknown to the receiver's value\\n        // slot, so a wrongly-typed consume of the looked-up value is caught\\n        // by the ordinary unify. NOTE: `Map::get` returns the RAW stored\\n        // value (0 on a miss) — `declare Map::get(Map[T, U], T) -> U` in\\n        // builtins/declarations.vibe and the linear codegen agree — NOT an\\n        // Option. Untyped receivers keep the conservative CtUnknown.\\n        let (m_ty, s1, c1) = check_expr(Array::get(args, 0), env, defs, s, c, errors, tytab)\\n        let (k_ty, s2, c2) = check_expr(Array::get(args, 1), env, defs, s1, c1, errors, tytab)\\n        let s3 = check_assignable(CtString, subst_apply(s2, k_ty), s2, errors, \\\"argument type mismatch for Map::get\\\", call_off)\\n        let result = match subst_apply(s3, m_ty) {\\n          CtNamed(mn, margs) => if mn == \\\"Map\\\" && Array::length(margs) == 2 {\\n            subst_apply(s3, Array::get(margs, 1))\\n          } else {\\n            CtUnknown\\n          },\\n          _ => CtUnknown\\n        }\\n        (tab_call_ty(tytab, call_off, result), s3, c2)\\n      } else if name == \\\"Map::values\\\" && Array::length(args) == 1 {\\n        // #983: values() of a value-slotted map is `Array[v]`, not\\n        // `Array[CtUnknown]`.\\n        let (m_ty, s1, c1) = check_expr(Array::get(args, 0), env, defs, s, c, errors, tytab)\\n        let result = match subst_apply(s1, m_ty) {\\n          CtNamed(mn, margs) => if mn == \\\"Map\\\" && Array::length(margs) == 2 {\\n            CtArray(subst_apply(s1, Array::get(margs, 1)))\\n          } else {\\n            CtArray(CtUnknown)\\n          },\\n          _ => CtArray(CtUnknown)\\n        }\\n        (tab_call_ty(tytab, call_off, result), s1, c1)\\n      } else if name == \\\"Map::delete\\\" && Array::length(args) == 2 {\\n        // #983: delete preserves the receiver's map type (value slot\\n        // included) instead of collapsing it to `Map[String, CtUnknown]`.\\n        let (m_ty, s1, c1) = check_expr(Array::get(args, 0), env, defs, s, c, errors, tytab)\\n        let (k_ty, s2, c2) = check_expr(Array::get(args, 1), env, defs, s1, c1, errors, tytab)\\n        let s3 = check_assignable(CtString, subst_apply(s2, k_ty), s2, errors, \\\"argument type mismatch for Map::delete\\\", call_off)\\n        let mret = match subst_apply(s3, m_ty) {\\n          CtNamed(mn, margs) => if mn == \\\"Map\\\" && Array::length(margs) == 2 {\\n            subst_apply(s3, m_ty)\\n          } else {\\n            CtNamed(\\\"Map\\\", [CtString, CtUnknown])\\n          },\\n          _ => CtNamed(\\\"Map\\\", [CtString, CtUnknown])\\n        }\\n        (tab_call_ty(tytab, call_off, mret), s3, c2)\\n      } else if name == \\\"Array::push\\\" && Array::length(args) == 2 {\\n        // `Array::push(a, v)` requires `v` to match `a`'s element type — pushing\\n        // a String into an `Array[Int]` was accepted (direct_call_return only\\n        // checks arg-0 head). Check the value against a concrete element type;\\n        // generic / var element types stay tolerant (check_assignable is ground-\\n        // gated).\\n        let (obj_ty, s1, c1) = check_expr(Array::get(args, 0), env, defs, s, c, errors, tytab)\\n        let (val_ty, s2, c2) = check_expr(Array::get(args, 1), env, defs, s1, c1, errors, tytab)\\n        let s3 = match subst_apply(s2, obj_ty) {\\n          CtArray(elem) => check_assignable(subst_apply(s2, elem), subst_apply(s2, val_ty), s2, errors, \\\"Array::push value type mismatch\\\", 0 - 1),\\n          _ => s2\\n        }\\n        (tab_call_ty(tytab, call_off, CtUnit), s3, c2)\\n      } else if name == \\\"Array::set\\\" && Array::length(args) == 3 {\\n        // `Array::set(a, i, v)` requires `v` to match `a`'s element type (the 3rd\\n        // arg was unchecked). Same ground-gated discipline as Array::push.\\n        let (obj_ty, s1, c1) = check_expr(Array::get(args, 0), env, defs, s, c, errors, tytab)\\n        let (set_idx_ty, s2, c2) = check_expr(Array::get(args, 1), env, defs, s1, c1, errors, tytab)\\n        let (val_ty, s3, c3) = check_expr(Array::get(args, 2), env, defs, s2, c2, errors, tytab)\\n        // #826: same head checks as Array::get (this branch also bypasses the\\n        // direct fast path).\\n        let as_recv_head = head_kind(subst_apply(s3, obj_ty))\\n        if as_recv_head != 0 && as_recv_head != 9 {\\n          Array::push(errors, String::concat(\\\"argument type mismatch for Array::set: receiver type \\\", String::concat(type_to_string(subst_apply(s3, obj_ty)), off_marker_len(callee_off, String::length(name)))))\\n        } else if is_stream_named_type(subst_apply(s3, obj_ty)) {\\n          // #827: Stream is CtNamed (head 0 = tolerated) but is NOT an Array.\\n          Array::push(errors, String::concat(\\\"argument type mismatch for Array::set: receiver type \\\", String::concat(type_to_string(subst_apply(s3, obj_ty)), String::concat(\\\" is a Stream, not an Array (use `for await` / Stream::*)\\\", off_marker_len(callee_off, String::length(name))))))\\n        } else {\\n          ()\\n        }\\n        let as_idx_head = head_kind(subst_apply(s3, set_idx_ty))\\n        if as_idx_head != 0 && as_idx_head != 1 {\\n          Array::push(errors, String::concat(\\\"argument type mismatch for Array::set (arg 1): \\\", String::concat(type_to_string(subst_apply(s3, set_idx_ty)), off_marker_len(callee_off, String::length(name)))))\\n        } else {\\n          ()\\n        }\\n        let s4 = match subst_apply(s3, obj_ty) {\\n          CtArray(elem) => check_assignable(subst_apply(s3, elem), subst_apply(s3, val_ty), s3, errors, \\\"Array::set value type mismatch\\\", 0 - 1),\\n          _ => s3\\n        }\\n        (tab_call_ty(tytab, call_off, CtUnit), s4, c3)\\n      } else if name == \\\"Array::push_all\\\" && Array::length(args) == 2 {\\n        // `Array::push_all(a, b)` appends every element of `b` into `a`, so the\\n        // two arrays must share an element type — `Array::push_all([1], [\\\"x\\\"])`\\n        // merged Int and String elements and slipped through (push_all had no\\n        // value/element check, only the arg-0 head). Same ground-gated discipline\\n        // as Array::concat.\\n        let (a_ty, s1, c1) = check_expr(Array::get(args, 0), env, defs, s, c, errors, tytab)\\n        let (b_ty, s2, c2) = check_expr(Array::get(args, 1), env, defs, s1, c1, errors, tytab)\\n        let s3 = check_two_array_elems(subst_apply(s2, a_ty), subst_apply(s2, b_ty), s2, errors, \\\"Array::push_all element type mismatch\\\")\\n        (tab_call_ty(tytab, call_off, CtUnit), s3, c2)\\n      } else if name == \\\"Array::get\\\" && Array::length(args) == 2 {\\n        // `Array::get(a, i)` returns the element type, but `direct_call_return`\\n        // types it CtUnknown — `let s: String = Array::get(intArr, 0)` slipped\\n        // through. Refine the result to the element type from a concrete\\n        // `CtArray(elem)` receiver (var / generic receivers stay CtUnknown).\\n        let (obj_ty, s1, c1) = check_expr(Array::get(args, 0), env, defs, s, c, errors, tytab)\\n        let (idx_ty, s2, c2) = check_expr(Array::get(args, 1), env, defs, s1, c1, errors, tytab)\\n        // #826: this special branch bypasses the direct fast path, so the\\n        // head checks never ran — `Array::get(\\\"str\\\", 0)` trapped at runtime\\n        // and `Array::get(a, \\\"x\\\")` returned silent garbage. Same ground-gated\\n        // discipline as builtin_first_arg_head (0 = tolerate).\\n        let ag_recv_head = head_kind(subst_apply(s2, obj_ty))\\n        if ag_recv_head != 0 && ag_recv_head != 9 {\\n          Array::push(errors, String::concat(\\\"argument type mismatch for Array::get: receiver type \\\", String::concat(type_to_string(subst_apply(s2, obj_ty)), off_marker_len(callee_off, String::length(name)))))\\n        } else if is_stream_named_type(subst_apply(s2, obj_ty)) {\\n          // #827: Stream is CtNamed (head 0 = tolerated) but is NOT an Array.\\n          Array::push(errors, String::concat(\\\"argument type mismatch for Array::get: receiver type \\\", String::concat(type_to_string(subst_apply(s2, obj_ty)), String::concat(\\\" is a Stream, not an Array (use `for await` / Stream::*)\\\", off_marker_len(callee_off, String::length(name))))))\\n        } else {\\n          ()\\n        }\\n        let ag_idx_head = head_kind(subst_apply(s2, idx_ty))\\n        if ag_idx_head != 0 && ag_idx_head != 1 {\\n          Array::push(errors, String::concat(\\\"argument type mismatch for Array::get (arg 1): \\\", String::concat(type_to_string(subst_apply(s2, idx_ty)), off_marker_len(callee_off, String::length(name)))))\\n        } else {\\n          ()\\n        }\\n        let result = match subst_apply(s2, obj_ty) {\\n          CtArray(elem) => elem,\\n          _ => CtUnknown\\n        }\\n        (tab_call_ty(tytab, call_off, result), s2, c2)\\n      } else if name == \\\"Array::reverse\\\" && Array::length(args) == 1 {\\n        // Returns an array of the same element type (was CtUnknown).\\n        let (obj_ty, s1, c1) = check_expr(Array::get(args, 0), env, defs, s, c, errors, tytab)\\n        let result = match subst_apply(s1, obj_ty) {\\n          CtArray(elem) => CtArray(elem),\\n          _ => CtUnknown\\n        }\\n        (tab_call_ty(tytab, call_off, result), s1, c1)\\n      } else if name == \\\"Array::concat\\\" && Array::length(args) == 2 {\\n        // Returns an array of the receivers' element type (was CtUnknown). Refine\\n        // from the first concrete `CtArray(elem)` operand, and require the two\\n        // operands' element types to agree — `Array::concat([1], [\\\"x\\\"])` mixed\\n        // `Array[Int]` with `Array[String]` and slipped through (the result was\\n        // refined to the first operand but the second was never checked).\\n        let (a_ty, s1, c1) = check_expr(Array::get(args, 0), env, defs, s, c, errors, tytab)\\n        let (b_ty, s2, c2) = check_expr(Array::get(args, 1), env, defs, s1, c1, errors, tytab)\\n        let a_app = subst_apply(s2, a_ty)\\n        let b_app = subst_apply(s2, b_ty)\\n        let s3 = check_two_array_elems(a_app, b_app, s2, errors, \\\"Array::concat element type mismatch\\\")\\n        let result = match a_app {\\n          CtArray(elem) => CtArray(elem),\\n          _ => match b_app {\\n            CtArray(elem) => CtArray(elem),\\n            _ => CtUnknown\\n          }\\n        }\\n        (tab_call_ty(tytab, call_off, result), s3, c2)\\n      } else if name == \\\"Array::slice\\\" && Array::length(args) == 3 {\\n        // `Array::slice(a, lo, hi)` returns an array of the SAME element type,\\n        // typed CtUnknown by the builtin table (`let s: String =\\n        // Array::get(Array::slice(ints, 0, 1), 0)` slipped through). Refine to\\n        // `CtArray(elem)` from a concrete receiver.\\n        let (obj_ty, s1, c1) = check_expr(Array::get(args, 0), env, defs, s, c, errors, tytab)\\n        let (_, s2, c2) = check_expr(Array::get(args, 1), env, defs, s1, c1, errors, tytab)\\n        let (_, s3, c3) = check_expr(Array::get(args, 2), env, defs, s2, c2, errors, tytab)\\n        let result = match subst_apply(s3, obj_ty) {\\n          CtArray(elem) => CtArray(elem),\\n          _ => CtUnknown\\n        }\\n        (tab_call_ty(tytab, call_off, result), s3, c3)\\n      } else if name == \\\"Array::fold\\\" && Array::length(args) == 3 {\\n        // `Array::fold(a, init, f)` returns the accumulator type — i.e. `init`'s\\n        // type — but was typed CtUnknown, so `let s: String = Array::fold(ints,\\n        // 0, add)` slipped through. Refine the result to the init value's type.\\n        // Also check the callback `(acc, x)` params: `acc` against `init`'s type\\n        // and `x` against the array element type (`Array::fold([1,2], 0, (acc:\\n        // String, x) -> ...)` slipped through). Ground-gated.\\n        let (recv_ty, s1, c1) = check_expr(Array::get(args, 0), env, defs, s, c, errors, tytab)\\n        let (init_ty, s2, c2) = check_expr(Array::get(args, 1), env, defs, s1, c1, errors, tytab)\\n        let (fn_ty, s3, c3) = check_expr(Array::get(args, 2), env, defs, s2, c2, errors, tytab)\\n        let s4 = match subst_apply(s3, fn_ty) {\\n          CtFn(ptys, _, _) => if Array::length(ptys) >= 1 {\\n            check_assignable(subst_apply(s3, Array::get(ptys, 0)), subst_apply(s3, init_ty), s3, errors, \\\"Array::fold accumulator type mismatch\\\", 0 - 1)\\n          } else {\\n            s3\\n          },\\n          _ => s3\\n        }\\n        let s5 = check_hof_param_vs_elem(subst_apply(s4, recv_ty), subst_apply(s4, fn_ty), 1, s4, errors, \\\"Array::fold element parameter type mismatch\\\")\\n        (tab_call_ty(tytab, call_off, subst_apply(s5, init_ty)), s5, c3)\\n      } else if name == \\\"Array::map\\\" && Array::length(args) == 2 {\\n        // `Array::map(a, f)` returns `Array[R]` where R is f's return type —\\n        // typed CtUnknown by the builtin table, so the mapped element type was\\n        // lost (`let s: String = Array::get(Array::map(ints, inc), 0)`). Refine\\n        // the result element to the mapping function's concrete return type; a\\n        // non-function / var f stays CtUnknown. Also check the callback's first\\n        // parameter type against the array element type — `Array::map([1,2],\\n        // (s: String) -> ...)` applied a `(String)->_` over `Array[Int]` and\\n        // slipped through. Ground-gated, so an unannotated `(x) -> ...` param\\n        // (CtVar) stays tolerant.\\n        let (recv_ty, s1, c1) = check_expr(Array::get(args, 0), env, defs, s, c, errors, tytab)\\n        let (fn_ty, s2, c2) = check_expr(Array::get(args, 1), env, defs, s1, c1, errors, tytab)\\n        let s3 = check_hof_param_vs_elem(subst_apply(s2, recv_ty), subst_apply(s2, fn_ty), 0, s2, errors, \\\"Array::map function parameter type mismatch\\\")\\n        let result = match subst_apply(s3, fn_ty) {\\n          CtFn(_, ret, _) => CtArray(ret),\\n          _ => CtUnknown\\n        }\\n        (tab_call_ty(tytab, call_off, result), s3, c2)\\n      } else {\\n        match direct_call_return(env, name) {\\n          Some(ret_ty) => {\\n            let alen = Array::length(args)\\n            let want_head = builtin_first_arg_head(name)\\n            // Argument-count check (see `builtin_fixed_arity`). `Bytes::new`\\n            // is special-cased: 0 args = empty growable buffer, 1 arg =\\n            // length-n zero-filled (MoonBit semantics, linear backend synth).\\n            if name == \\\"Bytes::new\\\" {\\n              if alen > 1 {\\n                Array::push(errors, String::concat(String::concat(\\\"function arity mismatch for \\\", String::concat(name, String::concat(\\\": expected 0 or 1 args, got \\\", __to_string(alen)))), off_marker_len(callee_off, String::length(name))))\\n              } else {\\n                ()\\n              }\\n            } else {\\n              let want_arity = builtin_fixed_arity(name)\\n              if want_arity >= 0 && alen != want_arity {\\n                Array::push(errors, String::concat(String::concat(\\\"function arity mismatch for \\\", String::concat(name, String::concat(\\\": expected \\\", String::concat(__to_string(want_arity), String::concat(\\\" args, got \\\", __to_string(alen)))))), off_marker_len(callee_off, String::length(name))))\\n              } else {\\n                ()\\n              }\\n            }\\n            let mut ai = 0\\n            let mut s2 = s\\n            let mut c2 = c\\n            while ai < alen {\\n              let (at, ns, nc) = check_expr(Array::get(args, ai), env, defs, s2, c2, errors, tytab)\\n              // First-argument head check for container/string builtins: the\\n              // receiver's top-level constructor must match (`Array::length(5)`\\n              // passes an Int where an Array is required). A non-concrete head\\n              // (var / generic / unknown) is tolerated.\\n              if ai == 0 && want_head != 0 {\\n                let got_head = head_kind(subst_apply(s2, at))\\n                if got_head != 0 && got_head != want_head {\\n                  Array::push(errors, String::concat(String::concat(\\\"argument type mismatch for \\\", String::concat(name, \\\": receiver type \\\")), String::concat(type_to_string(subst_apply(s2, at)), off_marker_len(callee_off, String::length(name)))))\\n                } else if want_head == 9 && is_stream_named_type(subst_apply(s2, at)) {\\n                  // #827: Stream is CtNamed (head 0 = tolerated), so the eager\\n                  // Array-backed representation leaked through every Array\\n                  // builtin (`Array::length(stream)` compiled and ran).\\n                  Array::push(errors, String::concat(String::concat(\\\"argument type mismatch for \\\", String::concat(name, \\\": receiver type \\\")), String::concat(type_to_string(subst_apply(s2, at)), String::concat(\\\" is a Stream, not an Array (use `for await` / Stream::*)\\\", off_marker_len(callee_off, String::length(name))))))\\n                } else {\\n                  ()\\n                }\\n              } else if ai >= 1 {\\n                // Non-receiver argument head check for fixed-signature builtins\\n                // (`String::concat(\\\"a\\\", 1)`, `String::substring(s, \\\"x\\\", 2)`).\\n                let want_rest = builtin_arg_head_rest(name, ai)\\n                if want_rest != 0 {\\n                  let got_head = head_kind(subst_apply(s2, at))\\n                  if got_head != 0 && got_head != want_rest {\\n                    Array::push(errors, String::concat(String::concat(\\\"argument type mismatch for \\\", String::concat(name, String::concat(\\\" (arg \\\", String::concat(__to_string(ai), \\\"): \\\")))), String::concat(type_to_string(subst_apply(s2, at)), off_marker_len(callee_off, String::length(name)))))\\n                  } else {\\n                    ()\\n                  }\\n                } else {\\n                  ()\\n                }\\n              } else {\\n                ()\\n              }\\n              s2 = ns\\n              c2 = nc\\n              ai = ai + 1\\n            }\\n            (tab_call_ty(tytab, call_off, subst_apply(s2, ret_ty)), s2, c2)\\n          },\\n          None => {\\n            // #736 residual: method-style call with a bare UNRESOLVED callee —\\n            // `xs |> length` is `length(xs)`, and with only the receiver TYPE\\n            // imported there is no lexical `length`. Retry as\\n            // `<type-of-arg0>::length`, the same resolution as `xs.length()`\\n            // (the EDot arm below), by re-checking in EDot form. Gated on the\\n            // bare name resolving to nothing (env/builtin) AND the qualified\\n            // name actually resolving, so a genuinely unknown callee still\\n            // reports `unknown name` from the normal path below.\\n            let method_form = if String::index_of(name, \\\"::\\\") < 0 && Array::length(args) >= 1 {\\n              match env_lookup(env, name) {\\n                Some(_) => false,\\n                None => match lookup_builtin(name) {\\n                  Some(_) => false,\\n                  None => true\\n                }\\n              }\\n            } else {\\n              false\\n            }\\n            let recv_method = if method_form {\\n              let (a0_ty, sa, ca) = check_expr(Array::get(args, 0), env, defs, s, c, errors, tytab)\\n              let recv_ty = subst_apply(sa, a0_ty)\\n              let qual = String::concat(type_name_prefix(recv_ty), String::concat(\\\"::\\\", name))\\n              let has_qual = match env_lookup(env, qual) {\\n                Some(_) => true,\\n                None => match lookup_builtin(qual) {\\n                  Some(_) => true,\\n                  None => false\\n                }\\n              }\\n              // A USER-typed receiver takes the (tolerant) EDot path even when\\n              // the qualified method is not in THIS module's env: with only the\\n              // type imported (`import ./list.vibe { List }`), `List::length`\\n              // lives in the imported module and is resolved by the merged\\n              // codegen — the per-module checker can't see it, exactly like\\n              // `xs.length()` (EDot), which types such calls CtUnknown. A\\n              // non-user receiver (Int/String/...) keeps the strict path so a\\n              // typo'd `foo(42)` still reports `unknown name`.\\n              let user_recv = match recv_ty {\\n                CtEnum(_) => true,\\n                CtStruct(_) => true,\\n                CtNamed(_, _) => true,\\n                _ => false\\n              }\\n              if has_qual || user_recv {\\n                Some(check_expr(ECall(EDot(Array::get(args, 0), name, callee_off, callee_off), Array::slice(args, 1, Array::length(args)), call_off), env, defs, sa, ca, errors, tytab))\\n              } else {\\n                None\\n              }\\n            } else {\\n              None\\n            }\\n            match recv_method {\\n            Some(rm) => rm,\\n            None => {\\n            let (ct, s1, c1) = check_expr(EIdent(name, -1), env, defs, s, c, errors, tytab)\\n            let alen = Array::length(args)\\n            let arg_tys = Array::slice([\\n              CtUnknown\\n            ], 0, 0)\\n            let mut ai = 0\\n            let mut s2 = s1\\n            let mut c2 = c1\\n            while ai < alen {\\n              let (at, ns, nc) = check_expr(Array::get(args, ai), env, defs, s2, c2, errors, tytab)\\n              Array::push(arg_tys, at)\\n              s2 = ns\\n              c2 = nc\\n              ai = ai + 1\\n            }\\n            let applied_callee_ty = match ct {\\n              CtFn(_, _, _) => ct,\\n              _ => subst_apply(s2, ct)\\n            }\\n            match applied_callee_ty {\\n              CtFn(param_tys, ret, _) => {\\n                let ret_box = Array::slice([\\n                  ret\\n                ], 0, 1)\\n                let call_param_tys = param_tys\\n                let plen2 = Array::length(param_tys)\\n                let alen3 = Array::length(arg_tys)\\n                if alen3 != plen2 {\\n                  Array::push(errors, String::concat(String::concat(\\\"function arity mismatch for \\\", String::concat(name, String::concat(\\\": expected \\\", String::concat(__to_string(plen2), String::concat(\\\" args, got \\\", __to_string(alen3)))))), off_marker_len(callee_off, String::length(name))))\\n                }\\n                let s3 = unify_call_args(call_param_tys, arg_tys, s2, errors, name, callee_off)\\n                let call_ret = Array::get(ret_box, 0)\\n                (tab_call_ty(tytab, call_off, subst_apply(s3, call_ret)), s3, c2)\\n              },\\n              CtStruct(sname) => (tab_call_ty(tytab, call_off, CtStruct(sname)), s2, c2),\\n              other => {\\n                // Calling a value whose type is a concrete NON-callable scalar /\\n                // aggregate (e.g. `let x = 5; x(3)`) was previously accepted\\n                // silently. A type variable / unknown / named (generic) callee\\n                // is tolerated — it may yet resolve to a function.\\n                let not_callable = match other {\\n                  CtInt => true,\\n                  CtDouble => true,\\n                  CtBool => true,\\n                  CtString => true,\\n                  CtChar => true,\\n                  CtUnit => true,\\n                  CtBytes => true,\\n                  CtTuple(_) => true,\\n                  CtArray(_) => true,\\n                  // A constructed `Option`/enum value (`let o = Some(1); o(2)`)\\n                  // is not callable — constructors themselves are typed `CtFn`,\\n                  // so a `CtOption`/`CtEnum` callee is always a built value.\\n                  CtOption(_) => true,\\n                  CtEnum(_) => true,\\n                  _ => false\\n                }\\n                if not_callable {\\n                  Array::push(errors, String::concat(String::concat(\\\"calling a non-function value: \\\", name), off_marker_len(callee_off, String::length(name))))\\n                } else {\\n                  ()\\n                }\\n                (tab_call_ty(tytab, call_off, CtUnknown), s2, c2)\\n              }\\n            }\\n            }\\n            }\\n          }\\n        }\\n        }\\n      },\\n      // #897: `mod.x(args)` through a qualified-import namespace parses as\\n      // ECall(EDot(EIdent(mod), x), args) -- a call whose callee is EDot goes\\n      // through THIS UFCS/method-call arm, not the standalone EDot arm below,\\n      // so the same qualified-namespace shortcut is needed here too (see the\\n      // comment on the standalone `EDot` check_expr arm for the full\\n      // rationale).\\n      EDot(obj, method, _, qcall_field_off) => {\\n        // #897/Codex P2: only take the qualified-import shortcut when `ns`\\n        // is NOT independently bound -- a real local/param named the same\\n        // as a qualified-import namespace must shadow it (normal field\\n        // access on that local's own value), matching how import_alias_\\n        // rewrite.vibe's alias map is pruned at every binder.\\n        let qualified_key = match obj {\\n          EIdent(ns, _) => match env_lookup(env, ns) {\\n            Some(_) => None,\\n            None => Some(String::concat(ns, String::concat(\\\".\\\", method)))\\n          },\\n          _ => None\\n        }\\n        let qualified_hit = match qualified_key {\\n          Some(k) => env_lookup(env, k),\\n          None => None\\n        }\\n        match qualified_hit {\\n        Some(_) => match qualified_key {\\n          Some(k) => check_expr(ECall(EIdent(k, qcall_field_off), args, call_off), env, defs, s, c, errors, tytab),\\n          None => (CtUnknown, s, c)\\n        },\\n        None => {\\n        let (obj_ty, s1, c1) = check_expr(obj, env, defs, s, c, errors, tytab)\\n        let resolved = subst_apply(s1, obj_ty)\\n        let type_prefix = type_name_prefix(resolved)\\n        let qualified = String::concat(type_prefix, String::concat(\\\"::\\\", method))\\n        let has_real_fn_binding = match env_lookup(env, qualified) {\\n          Some(_) => true,\\n          None => false\\n        }\\n        // #994: `desugar_trait_dict.vibe`'s dot-call lowering (the\\n        // `EDot(obj, m, ...)` arm, `as_recv_method`) only rewrites a\\n        // `.method(...)` call into a working `Type::method(...)` call when\\n        // `fn_exists(fn_returns, qual)` -- i.e. `qual` is a REAL parsed\\n        // top-level `fn` declaration. `env_lookup` reflects that exact same\\n        // set of declarations. A `lookup_builtin` hit with NO `env_lookup`\\n        // hit is a checker-only hardcoded signature (`Array::set`,\\n        // `String::length`, ...) that has no corresponding parsed fn --\\n        // codegen's EDot fallback then compiles the call as a struct-field\\n        // READ and dies with an unlocated \\\"unknown struct field: <method>\\\"\\n        // regardless of argument types (confirmed by probing EVERY builtin\\n        // dot-call, well-typed or not: `a.set(0, 42)` fails identically to\\n        // `a.set(0, \\\"bad\\\")`). Reject these HERE instead of silently\\n        // accepting a call that can never compile.\\n        if !has_real_fn_binding && is_known_builtin_receiver_prefix(type_prefix) {\\n        match lookup_builtin(qualified) {\\n          Some(_) => {\\n            Array::push(errors, String::concat(\\\"dot-call syntax is not supported for the builtin method `\\\", String::concat(qualified, String::concat(\\\"` -- call it as `\\\", String::concat(qualified, String::concat(\\\"(...)`\\\", off_marker_len(qcall_field_off, String::length(method))))))))\\n            (tab_call_ty(tytab, call_off, CtUnknown), s1, c1)\\n          },\\n          None => {\\n            let bare_hint = match env_lookup(env, method) {\\n              Some(_) => String::concat(String::concat(\\\"(...)` (a bare `fn \\\", method), String::concat(\\\"` is only callable as `\\\", String::concat(method, String::concat(\\\"(x)` or `x |> \\\", String::concat(method, \\\"`)\\\"))))),\\n              None => \\\"(...)`\\\"\\n            }\\n            Array::push(errors, String::concat(String::concat(\\\"no method `\\\", String::concat(method, String::concat(\\\"` on `\\\", String::concat(type_prefix, \\\"`: declare a top-level `fn \\\")))), String::concat(qualified, String::concat(bare_hint, off_marker_len(qcall_field_off, String::length(method))))))\\n            (tab_call_ty(tytab, call_off, CtUnknown), s1, c1)\\n          }\\n        }\\n        } else {\\n        let direct_ret = direct_call_return(env, qualified)\\n        let method_ty = match env_lookup(env, qualified) {\\n          Some(t) => {\\n            let (ti, c2, _) = instantiate(t, c1)\\n            (ti, s1, c2)\\n          },\\n          None => match lookup_builtin(qualified) {\\n            Some(t) => (t, s1, c1),\\n            None => (CtUnknown, s1, c1)\\n          }\\n        }\\n        let (mt, s2, c2) = method_ty\\n        let all_args = prepend_expr(obj, args)\\n        let alen = Array::length(all_args)\\n        let arg_tys = Array::slice([\\n          CtUnknown\\n        ], 0, 0)\\n        Array::push(arg_tys, obj_ty)\\n        let mut ai = 1\\n        let mut s3 = s2\\n        let mut c3 = c2\\n        while ai < alen {\\n          let (at, ns, nc) = check_expr(Array::get(all_args, ai), env, defs, s3, c3, errors, tytab)\\n          Array::push(arg_tys, at)\\n          s3 = ns\\n          c3 = nc\\n          ai = ai + 1\\n        }\\n        let applied_method_ty = match mt {\\n          CtFn(_, _, _) => mt,\\n          _ => subst_apply(s3, mt)\\n        }\\n        match applied_method_ty {\\n          CtFn(param_tys, ret, _) => {\\n            let ret_box = Array::slice([\\n              ret\\n            ], 0, 1)\\n            let call_param_tys = param_tys\\n            let plen = Array::length(param_tys)\\n            let alen2 = Array::length(arg_tys)\\n            if alen2 != plen {\\n              Array::push(errors, String::concat(String::concat(\\\"function arity mismatch for \\\", String::concat(qualified, String::concat(\\\": expected \\\", String::concat(__to_string(plen), String::concat(\\\" args, got \\\", __to_string(alen2)))))), off_marker_len(call_off, String::length(qualified))))\\n            }\\n            let s4 = unify_call_args(call_param_tys, arg_tys, s3, errors, qualified, call_off)\\n            let call_ret = Array::get(ret_box, 0)\\n            let selected_ret = match direct_ret {\\n              Some(t) => t,\\n              None => call_ret\\n            }\\n            (tab_call_ty(tytab, call_off, subst_apply(s4, selected_ret)), s4, c3)\\n          },\\n          _ => {\\n            // No method/builtin `T::method` resolved. If the receiver is a\\n            // concrete struct whose field `method` holds a FUNCTION, this is a\\n            // field-stored-function call `b.f(args)` (the receiver is NOT an\\n            // argument). Arg-check the explicit args against the field's\\n            // parameter types and use its return type — `(b.f)(\\\"s\\\")` with `f:\\n            // (Int) -> Int` was otherwise unchecked. Ground-gated via\\n            // unify_call_args; generic-struct receivers stay CtUnknown so no\\n            // over-rejection.\\n            // #829: also resolve the field through an INSTANTIATED generic\\n            // struct receiver (`CtNamed(S, targs)`), so `it.pull(x)` on\\n            // `LazyIter[Int]` checks against the concrete field signature.\\n            let field_fn = receiver_struct_field_type(defs, subst_apply(s3, obj_ty), method)\\n            match field_fn {\\n              Some(CtFn(fpts, fret, _)) => {\\n                let explicit = Array::slice(arg_tys, 1, Array::length(arg_tys))\\n                if Array::length(fpts) != Array::length(explicit) {\\n                  Array::push(errors, String::concat(String::concat(\\\"function arity mismatch for \\\", String::concat(qualified, String::concat(\\\": expected \\\", String::concat(__to_string(Array::length(fpts)), String::concat(\\\" args, got \\\", __to_string(Array::length(explicit))))))), off_marker_len(call_off, String::length(qualified))))\\n                }\\n                let s4 = unify_call_args(fpts, explicit, s3, errors, qualified, call_off)\\n                (tab_call_ty(tytab, call_off, subst_apply(s4, fret)), s4, c3)\\n              },\\n              _ => match direct_ret {\\n                Some(t) => (tab_call_ty(tytab, call_off, t), s3, c3),\\n                None => {\\n                  // #953: method-style call `x.m()` on a receiver whose checked\\n                  // type is a USER type DECLARED IN THIS CHECK'S defs, with no\\n                  // `T::m` binding anywhere (env covers the whole program on the\\n                  // merged FS-compile path, and check_stmts hoists every\\n                  // top-level SLet — including `fn T::m` declared later — so an\\n                  // absent binding means the method truly does not exist), no\\n                  // builtin, and no struct field `m`. Codegen compiles a called\\n                  // EDot as a struct-field read, so this previously escaped the\\n                  // checker and died in codegen with an unlocated \\\"unknown\\n                  // struct field: m\\\". Report it HERE, located at the method\\n                  // token, with the #736 contract spelled out: dot-calls\\n                  // resolve `T::m` top-level fns (a BARE `fn m(x: T)` is only\\n                  // callable as `m(x)` / `x |> m`). Receivers of IMPORTED types\\n                  // (no local typedef) keep the tolerant CtUnknown path — with\\n                  // only the type imported, the method lives in the source\\n                  // module and is resolved by the merged codegen (see the #736\\n                  // comment on the bare-callee arm above).\\n                  let no_field = match field_fn {\\n                    None => true,\\n                    _ => false\\n                  }\\n                  let local_user_ty = if type_prefix == \\\"\\\" {\\n                    false\\n                  } else {\\n                    match find_typedef(defs, type_prefix) {\\n                      Some(_) => true,\\n                      None => false\\n                    }\\n                  }\\n                  let has_method_binding = match env_lookup(env, qualified) {\\n                    Some(_) => true,\\n                    None => match lookup_builtin(qualified) {\\n                      Some(_) => true,\\n                      None => false\\n                    }\\n                  }\\n                  // #994: known builtin receiver prefixes (String/Array/...)\\n                  // never reach this branch anymore -- they're intercepted\\n                  // earlier (before `direct_ret`/`method_ty` are computed) so\\n                  // codegen-unlowerable builtin dot-calls get a located error\\n                  // instead of silently unifying against a tolerant\\n                  // `CtUnknown` builtin signature. This diagnostic now only\\n                  // covers genuinely LOCAL user types.\\n                  if no_field && local_user_ty && !has_method_binding {\\n                    let bare_hint = match env_lookup(env, method) {\\n                      Some(_) => String::concat(String::concat(\\\"(...)` (a bare `fn \\\", method), String::concat(\\\"` is only callable as `\\\", String::concat(method, String::concat(\\\"(x)` or `x |> \\\", String::concat(method, \\\"`)\\\"))))),\\n                      // Codex P2 on #961: with no bare binding of this name,\\n                      // suggesting `x |> method` re-enters the same fallback\\n                      // and reproduces this diagnostic — only suggest the\\n                      // Type::method declaration.\\n                      None => \\\"(...)`\\\"\\n                    }\\n                    Array::push(errors, String::concat(String::concat(\\\"no method `\\\", String::concat(method, String::concat(\\\"` on `\\\", String::concat(type_prefix, \\\"`: declare a top-level `fn \\\")))), String::concat(qualified, String::concat(bare_hint, off_marker_len(qcall_field_off, String::length(method))))))\\n                  } else {\\n                    ()\\n                  }\\n                  (tab_call_ty(tytab, call_off, CtUnknown), s3, c3)\\n                }\\n              }\\n            }\\n          }\\n        }\\n        }\\n        }\\n        }\\n      },\\n      _ => {\\n        // #844: intercept the synthetic ascription-lambda call shape\\n        // `((__asc: T) -> __asc)(val)` that a LOCAL `let x: T = val` desugars\\n        // to (parser_expr_dispatch.vibe's ascribe_wrap) BEFORE the general\\n        // callee-dispatch logic below, so its annotation-vs-value check can\\n        // additionally run `detect_narrowed_generic_mismatch` (closing the\\n        // #844 same-name generic-struct re-narrowing hole) and\\n        // `preserve_generic_instantiation` (so the bound local variable keeps\\n        // its real instantiated type instead of an erased bare one) without\\n        // touching `unify_call_args` / `check_assignable`, which every OTHER\\n        // call in the language also goes through.\\n        let asc_ann = if Array::length(args) == 1 {\\n          ascription_lambda_ann(callee)\\n        } else {\\n          None\\n        }\\n        match asc_ann {\\n          Some(ann_te) => {\\n            let (at, ns0, nc0) = check_expr(Array::get(args, 0), env, defs, s, c, errors, tytab)\\n            let resolved = resolve_type_expr(ann_te, defs)\\n            let actual = subst_apply(ns0, at)\\n            // #981: `check_assignable` now runs the #844 same-name concrete\\n            // `CtNamed` check itself (its tolerate branch calls\\n            // `detect_narrowed_generic_mismatch`), so the explicit second\\n            // call this site used to make would double-report — dropped.\\n            let ns2 = check_assignable(resolved, actual, ns0, errors, \\\"binding type mismatch for a local let\\\", call_off)\\n            let bound_ty = preserve_generic_instantiation(resolved, subst_apply(ns2, actual))\\n            (tab_call_ty(tytab, call_off, bound_ty), ns2, nc0)\\n          },\\n          None => {\\n        let callee_name0 = expr_ident_name_or_empty(callee)\\n        if callee_name0 != \\\"\\\" {\\n          match direct_call_return(env, callee_name0) {\\n            Some(ret_ty) => {\\n              let alen = Array::length(args)\\n              let mut ai = 0\\n              let mut s2 = s\\n              let mut c2 = c\\n              while ai < alen {\\n                let (_, ns, nc) = check_expr(Array::get(args, ai), env, defs, s2, c2, errors, tytab)\\n                s2 = ns\\n                c2 = nc\\n                ai = ai + 1\\n              }\\n              (tab_call_ty(tytab, call_off, subst_apply(s2, ret_ty)), s2, c2)\\n            },\\n            None => {\\n              let (ct, s1, c1) = check_expr(callee, env, defs, s, c, errors, tytab)\\n              let alen = Array::length(args)\\n              let arg_tys = Array::slice([\\n                CtUnknown\\n              ], 0, 0)\\n              let mut ai = 0\\n              let mut s2 = s1\\n              let mut c2 = c1\\n              while ai < alen {\\n                let (at, ns, nc) = check_expr(Array::get(args, ai), env, defs, s2, c2, errors, tytab)\\n                Array::push(arg_tys, at)\\n                s2 = ns\\n                c2 = nc\\n                ai = ai + 1\\n              }\\n            let applied_callee_ty = match ct {\\n              CtFn(_, _, _) => ct,\\n              _ => subst_apply(s2, ct)\\n            }\\n            match applied_callee_ty {\\n              CtFn(param_tys, ret, _) => {\\n                let ret_box = Array::slice([\\n                  ret\\n                ], 0, 1)\\n                let call_param_tys = param_tys\\n                let plen2 = Array::length(param_tys)\\n                let alen3 = Array::length(arg_tys)\\n                if alen3 != plen2 {\\n                  Array::push(errors, String::concat(String::concat(\\\"function arity mismatch for \\\", String::concat(callee_name0, String::concat(\\\": expected \\\", String::concat(__to_string(plen2), String::concat(\\\" args, got \\\", __to_string(alen3)))))), off_marker_len(call_off, String::length(callee_name0))))\\n                }\\n                let s3 = unify_call_args(call_param_tys, arg_tys, s2, errors, callee_name0, call_off)\\n                let call_ret = Array::get(ret_box, 0)\\n                (tab_call_ty(tytab, call_off, subst_apply(s3, call_ret)), s3, c2)\\n              },\\n              CtStruct(sname) => (tab_call_ty(tytab, call_off, CtStruct(sname)), s2, c2),\\n              _ => (tab_call_ty(tytab, call_off, CtUnknown), s2, c2)\\n            }\\n            }\\n          }\\n        } else {\\n            let (ct, s1, c1) = check_expr(callee, env, defs, s, c, errors, tytab)\\n            let alen = Array::length(args)\\n            let arg_tys = Array::slice([\\n              CtUnknown\\n            ], 0, 0)\\n            let mut ai = 0\\n            let mut s2 = s1\\n            let mut c2 = c1\\n            while ai < alen {\\n              let (at, ns, nc) = check_expr(Array::get(args, ai), env, defs, s2, c2, errors, tytab)\\n              Array::push(arg_tys, at)\\n              s2 = ns\\n              c2 = nc\\n              ai = ai + 1\\n            }\\n            let applied_callee_ty = match ct {\\n              CtFn(_, _, _) => ct,\\n              _ => subst_apply(s2, ct)\\n            }\\n            match applied_callee_ty {\\n              CtFn(param_tys, ret, _) => {\\n                let ret_box = Array::slice([\\n                  ret\\n                ], 0, 1)\\n                let call_param_tys = param_tys\\n                let plen2 = Array::length(param_tys)\\n                let alen3 = Array::length(arg_tys)\\n                if alen3 != plen2 {\\n                  Array::push(errors, String::concat(String::concat(\\\"function arity mismatch for <expr>: expected \\\", String::concat(__to_string(plen2), String::concat(\\\" args, got \\\", __to_string(alen3)))), off_marker(call_off)))\\n                }\\n                let s3 = unify_call_args(call_param_tys, arg_tys, s2, errors, \\\"<expr>\\\", call_off)\\n                let call_ret = Array::get(ret_box, 0)\\n                (tab_call_ty(tytab, call_off, subst_apply(s3, call_ret)), s3, c2)\\n              },\\n              CtStruct(sname) => (tab_call_ty(tytab, call_off, CtStruct(sname)), s2, c2),\\n              _ => (tab_call_ty(tytab, call_off, CtUnknown), s2, c2)\\n            }\\n        }\\n          }\\n        }\\n      }\\n    },\\n    EBinOp(op, left, right) => {\\n      let (left_ty, s1, c1) = check_expr(left, env, defs, s, c, errors, tytab)\\n      let (right_ty, s2, c2) = check_expr(right, env, defs, s1, c1, errors, tytab)\\n      let (result_ty, s3) = infer_binop_type(op, subst_apply(s2, left_ty), subst_apply(s2, right_ty), env, s2, errors, tytab)\\n      (subst_apply(s3, result_ty), s3, c2)\\n    },\\n    EUnaryOp(op, operand) => {\\n      let (operand_ty, s1, c1) = check_expr(operand, env, defs, s, c, errors, tytab)\\n      if op == \\\"!\\\" {\\n        match subst_apply(s1, operand_ty) {\\n          CtBool => (CtBool, s1, c1),\\n          CtVar(_) => match unify(operand_ty, CtBool, s1) {\\n            Some(s2) => (CtBool, s2, c1),\\n            None => (CtUnknown, s1, c1)\\n          },\\n          other => {\\n            // `!x` on a concrete non-Bool operand (`!5`) was accepted silently.\\n            // A non-ground/Unknown operand is tolerated (may resolve to Bool).\\n            let flag = match other {\\n              CtUnknown => false,\\n              _ => type_is_ground(other)\\n            }\\n            if flag {\\n              Array::push(errors, \\\"operand of `!` must be Bool\\\")\\n            } else {\\n              ()\\n            }\\n            (CtUnknown, s1, c1)\\n          }\\n        }\\n      } else if op == \\\"-\\\" {\\n        match subst_apply(s1, operand_ty) {\\n          CtDouble => (CtDouble, s1, c1),\\n          CtInt => (CtInt, s1, c1),\\n          CtVar(_) => match unify(operand_ty, CtInt, s1) {\\n            Some(s2) => (CtInt, s2, c1),\\n            None => (CtUnknown, s1, c1)\\n          },\\n          other => {\\n            // Unary `-` on a concrete non-numeric operand (`-\\\"hi\\\"`) was accepted\\n            // silently. A non-ground / Unknown operand is tolerated.\\n            let flag = match other {\\n              CtUnknown => false,\\n              _ => type_is_ground(other)\\n            }\\n            if flag {\\n              Array::push(errors, \\\"operand of unary `-` must be Int or Double\\\")\\n            } else {\\n              ()\\n            }\\n            (CtUnknown, s1, c1)\\n          }\\n        }\\n      } else (CtUnknown, s1, c1)\\n    },\\n    EAssign(name, val, body) => {\\n      let (vt, s1, c1) = check_expr(val, env, defs, s, c, errors, tytab)\\n      // The assigned value must be assignable to the variable's type\\n      // (previously unchecked — `y = \\\"s\\\"` for `let mut y = 1` was accepted).\\n      let s1b = match env_lookup(env, name) {\\n        Some(var_ty) => check_assignable(var_ty, subst_apply(s1, vt), s1, errors, String::concat(\\\"assignment type mismatch for \\\", name), 0 - 1),\\n        None => s1\\n      }\\n      check_expr(body, env, defs, s1b, c1, errors, tytab)\\n    },\\n    EAssignOp(_, _, val, body) => {\\n      let (_, s1, c1) = check_expr(val, env, defs, s, c, errors, tytab)\\n      check_expr(body, env, defs, s1, c1, errors, tytab)\\n    },\\n    EMatch(scrutinee, arms) => {\\n      let (scr_ty, s1, c1) = check_expr(scrutinee, env, defs, s, c, errors, tytab)\\n      let alen = Array::length(arms)\\n      if alen == 0 {\\n        // #809: a match with ZERO arms is only produced by the guard desugar\\n        // (#666) — `pat if g => body` chains end in `match __mg { }` when NO\\n        // unguarded arm exists — or by a literal empty `match x { }`. Both\\n        // reach codegen as an unconditional `unreachable`: every guard failing\\n        // at runtime trapped with no source location. Reject at compile time.\\n        Array::push(errors, \\\"non-exhaustive match: no unguarded arm covers the scrutinee (all guards may fail — add an unguarded arm or `_`)\\\")\\n        (CtUnknown, s1, c1)\\n      }\\n      else {\\n        // #940 Phase 2 baseline: the nested usefulness check below only runs\\n        // when THIS match produced no other diagnostics (pattern shape / arm\\n        // type / flat exhaustiveness errors all suppress it — an ill-typed\\n        // matrix would only yield a garbage witness on top of the real error).\\n        let exh_base = Array::length(errors)\\n        let mut result_ty = CtUnknown\\n        // Whether to cross-check arm types. Enabled only when the first arm's\\n        // type resolves to a SIMPLE scalar (Int/Double/Bool/String/Char) — that\\n        // covers the real bug (`match x { 0 => 1, _ => \\\"s\\\" }`) while skipping\\n        // the per-arm `subst_apply` for matches whose arms yield large tuple /\\n        // struct / function types (e.g. the compiler's own `(Type, Subst, Int)`\\n        // returning matches), which would otherwise balloon the self-compile\\n        // heap. CtUnknown/CtVar/aggregate first arms are left unchecked.\\n        let mut check_arms = false\\n        // #941: cross-check arms for Option⇔Result railway-head conflicts\\n        // when the first arm's type is railway-headed. The full aggregate\\n        // cross-check stays off (heap cost, see `check_arms` above), but this\\n        // one conflict is both cheap (head-only) and always genuine — it is\\n        // exactly the `let*` desugar's failure track (`Err(e)` / `None`)\\n        // yielding the WRONG monad into a match whose other arms yield the\\n        // function's annotated one (docs/cheatsheet.md #635).\\n        let mut railway_arms = false\\n        let mut si = s1\\n        let mut ci = c1\\n        let mut ai = 0\\n        while ai < alen {\\n          let (pat, body) = Array::get(arms, ai)\\n          // #951: `A(v) | B(v) => v` (or any or-pattern binding a variable in\\n          // either branch) passes `check_pattern` (which only walks the LEFT\\n          // branch) but codegen has no per-branch binding-extraction path for\\n          // or-patterns and crashes with an unlocated internal error. Reject\\n          // it here instead, as a normal located diagnostic.\\n          if pat_has_unsupported_or_binding(pat) {\\n            // Anchor on the arm body when it has a usable offset; block /\\n            // let / literal bodies have none (railway_expr_off => -1), so\\n            // fall back to the match scrutinee — patterns carry no offsets,\\n            // and an unlocated reject would defeat the point of this check.\\n            let body_off = railway_expr_off(body)\\n            let or_off = if body_off >= 0 {\\n              body_off\\n            } else {\\n              railway_expr_off(scrutinee)\\n            }\\n            Array::push(errors, String::concat(\\\"or-pattern bindings are not supported yet: `A(v) | B(v)`-style patterns cannot bind variables in an or-branch (rewrite without a shared binding, e.g. separate arms with the same body, or bind after matching)\\\", off_marker(or_off)))\\n          } else {\\n            ()\\n          }\\n          let arm_env = check_pattern(pat, scr_ty, env, defs, errors)\\n          let (arm_ty, ns, nc) = check_expr(body, arm_env, defs, si, ci, errors, tytab)\\n          si = ns\\n          ci = nc\\n          if ai == 0 {\\n            result_ty = arm_ty\\n            let r0 = subst_apply(si, arm_ty)\\n            check_arms = match r0 {\\n              CtInt => true,\\n              CtDouble => true,\\n              CtBool => true,\\n              CtString => true,\\n              CtChar => true,\\n              _ => false\\n            }\\n            railway_arms = railway_head(r0) != 0\\n          } else {\\n            if check_arms {\\n              // Tolerate a `CtUnit` arm (statement-position match); rely on\\n              // check_assignable's ground/ground gate otherwise. Also tolerate a\\n              // DIVERGING arm whose body is an early `return` (#635): `val?`\\n              // lowers to `match val { Some(v) => v, None => return None }` — the\\n              // `return` arm yields no value to the match, so it must not force\\n              // the match's result type (it would clash `T` vs `Option[T]`).\\n              let r2 = subst_apply(si, arm_ty)\\n              si = if arm_body_diverges(body) {\\n                si\\n              } else {\\n                match r2 {\\n                  CtUnit => si,\\n                  _ => check_assignable(result_ty, r2, si, errors, \\\"match arms have incompatible types\\\", 0 - 1)\\n                }\\n              }\\n            } else if railway_arms {\\n              // #941: report ONLY the Option⇔Result head conflict; every\\n              // other shape keeps the historical no-cross-check tolerance.\\n              // Diverging (early-`return`) arms yield no value to the match\\n              // and are checked at their own EReturn instead.\\n              if arm_body_diverges(body) {\\n                ()\\n              } else {\\n                let rr0 = subst_apply(si, result_ty)\\n                let rr2 = subst_apply(si, arm_ty)\\n                if railway_heads_conflict(rr0, rr2) {\\n                  Array::push(errors, String::concat(\\\"match arms have incompatible types\\\", String::concat(\\\": expected \\\", String::concat(type_to_string(rr0), String::concat(\\\", got \\\", String::concat(type_to_string(rr2), off_marker(railway_expr_off(scrutinee))))))))\\n                } else {\\n                  ()\\n                }\\n              }\\n            } else {\\n              ()\\n            }\\n          }\\n          ai = ai + 1\\n        }\\n        // Exhaustiveness: when the scrutinee is a concrete user enum, the arms\\n        // must either include a catch-all (`_` / bind) or cover EVERY variant —\\n        // otherwise an unhandled variant traps at runtime. Conservative: only a\\n        // concrete enum whose definition is known is checked; anything else\\n        // (builtin Option/bool, type vars, non-enum) is left alone.\\n        let enum_name_opt = match subst_apply(si, scr_ty) {\\n          CtEnum(en) => Some(en),\\n          CtNamed(en, _) => Some(en),\\n          _ => None\\n        }\\n        match enum_name_opt {\\n          Some(en) => match find_typedef(defs, en) {\\n            Some(TDEnum(_, _, variants)) => {\\n              let mut has_catchall = false\\n              let covered = Array::slice([\\n                \\\"\\\"\\n              ], 0, 0)\\n              let mut ax = 0\\n              while ax < Array::length(arms) {\\n                let (apat, _) = Array::get(arms, ax)\\n                if pat_is_catchall(apat) {\\n                  has_catchall = true\\n                } else {\\n                  ()\\n                }\\n                collect_ctor_names_into(apat, covered)\\n                ax = ax + 1\\n              }\\n              if has_catchall {\\n                ()\\n              } else {\\n                let mut vi = 0\\n                while vi < Array::length(variants) {\\n                  let (vname, _) = Array::get(variants, vi)\\n                  let mut found = false\\n                  let mut ci2 = 0\\n                  while ci2 < Array::length(covered) {\\n                    if Array::get(covered, ci2) == vname {\\n                      found = true\\n                    } else {\\n                      ()\\n                    }\\n                    ci2 = ci2 + 1\\n                  }\\n                  if found {\\n                    ()\\n                  } else {\\n                    Array::push(errors, String::concat(\\\"non-exhaustive match: variant `\\\", String::concat(vname, String::concat(\\\"` of enum \\\", String::concat(en, \\\" is not handled (add it or a `_` arm)\\\")))))\\n                  }\\n                  vi = vi + 1\\n                }\\n              }\\n            },\\n            _ => ()\\n          },\\n          None => ()\\n        }\\n        // #940 Phase 1: builtin `Option` and `Bool` scrutinees were not\\n        // covered by the flat exhaustiveness check AT ALL (the comment above\\n        // even said so) — `match o { Some(v) => v, Some-only arms }` or a\\n        // Bool match missing `false` compiled clean and trapped at runtime\\n        // (codegen's test chain ends in `unreachable`). Checked for\\n        // MULTI-arm matches, plus (Codex P2 on #980) for ANY match whose\\n        // scrutinee is the guard desugar's synthesized `__mg` temp: a failed\\n        // guard falls through to `EMatch(__mg, rest)` (#666), and that\\n        // residual can have a single arm (`match b { true if g => 1,\\n        // false => 0 }` leaves `match __mg { false => 0 }` — `b == true &&\\n        // !g` trapped). A single-arm match over anything else stays\\n        // tolerated: it is syntactically indistinguishable from the\\n        // partial-let desugar (`let Some(v) = o`, the cheatsheet's\\n        // documented idiom), whose scrutinee is the user's own expression,\\n        // never `__mg`. Nested-pattern completeness (tuples, ctor payloads,\\n        // literals) is the Phase 2 usefulness algorithm — this closes only\\n        // the flat gap.\\n        let flat_guard_residual = match scrutinee {\\n          EIdent(sn, _) => sn == \\\"__mg\\\",\\n          _ => false\\n        }\\n        if alen >= 2 || flat_guard_residual {\\n          match subst_apply(si, scr_ty) {\\n            CtOption(_) => {\\n              let mut opt_catchall = false\\n              let opt_covered = Array::slice([\\n                \\\"\\\"\\n              ], 0, 0)\\n              let mut oax = 0\\n              while oax < Array::length(arms) {\\n                let (oapat, _) = Array::get(arms, oax)\\n                if pat_is_catchall(oapat) {\\n                  opt_catchall = true\\n                } else {\\n                  ()\\n                }\\n                collect_ctor_names_into(oapat, opt_covered)\\n                oax = oax + 1\\n              }\\n              if opt_catchall {\\n                ()\\n              } else {\\n                if !flat_names_contain(opt_covered, \\\"Some\\\") {\\n                  Array::push(errors, \\\"non-exhaustive match: variant `Some` of Option is not handled (add it or a `_` arm)\\\")\\n                } else {\\n                  ()\\n                }\\n                if !flat_names_contain(opt_covered, \\\"None\\\") {\\n                  Array::push(errors, \\\"non-exhaustive match: variant `None` of Option is not handled (add it or a `_` arm)\\\")\\n                } else {\\n                  ()\\n                }\\n              }\\n            },\\n            CtBool => {\\n              let mut bool_catchall = false\\n              let bool_covered = Array::slice([\\n                \\\"\\\"\\n              ], 0, 0)\\n              let mut bax = 0\\n              while bax < Array::length(arms) {\\n                let (bapat, _) = Array::get(arms, bax)\\n                if pat_is_catchall(bapat) {\\n                  bool_catchall = true\\n                } else {\\n                  ()\\n                }\\n                collect_bool_pats_into(bapat, bool_covered)\\n                bax = bax + 1\\n              }\\n              if bool_catchall {\\n                ()\\n              } else {\\n                if !flat_names_contain(bool_covered, \\\"true\\\") {\\n                  Array::push(errors, \\\"non-exhaustive match: `true` is not handled for a Bool scrutinee (add it or a `_` arm)\\\")\\n                } else {\\n                  ()\\n                }\\n                if !flat_names_contain(bool_covered, \\\"false\\\") {\\n                  Array::push(errors, \\\"non-exhaustive match: `false` is not handled for a Bool scrutinee (add it or a `_` arm)\\\")\\n                } else {\\n                  ()\\n                }\\n              }\\n            },\\n            _ => ()\\n          }\\n        } else {\\n          ()\\n        }\\n        // #940 Phase 2: nested usefulness (Maranget). Same arity gate as the\\n        // flat checks above; additionally skipped when this match already has\\n        // any diagnostic (no duplicate/garbage reports on top of a flat\\n        // non-exhaustiveness or an ill-typed pattern). The ground gate,\\n        // catch-all fast path and budget cap live inside\\n        // match_nonexhaustive_witness (checker_exhaustive.vibe).\\n        if (alen >= 2 || flat_guard_residual) && Array::length(errors) == exh_base {\\n          let exh_pats = Array::slice([\\n            PWild\\n          ], 0, 0)\\n          let mut exh_i = 0\\n          while exh_i < alen {\\n            let (exh_p, _) = Array::get(arms, exh_i)\\n            Array::push(exh_pats, exh_p)\\n            exh_i = exh_i + 1\\n          }\\n          match match_nonexhaustive_witness(subst_apply(si, scr_ty), exh_pats, defs) {\\n            Some(exh_wit) => Array::push(errors, String::concat(\\\"non-exhaustive match: pattern `\\\", String::concat(exh_wit, String::concat(\\\"` is not handled (add it or a `_` arm)\\\", off_marker(railway_expr_off(scrutinee)))))),\\n            None => ()\\n          }\\n        } else {\\n          ()\\n        }\\n        (result_ty, si, ci)\\n      }\\n    },\\n    EHandle(body, harms) => {\\n      let (hty, hs, hc) = check_expr(body, env, defs, s, c, errors, tytab)\\n      // #813: validate handler arms against DECLARED effects (TDEffect).\\n      // Previously arms were never checked at all: a typo'd op name silently\\n      // handled a different op, payload binds carried garbage types, and\\n      // `resume(\\\"oops\\\")` into an Int-returning op compiled. Scope is limited\\n      // to declared effects — arms for builtin/imported effects (Error etc.)\\n      // keep the pre-#813 behavior (unchecked) so the compiler's ~4k\\n      // `with Error` arms are untouched.\\n      let mut hs1 = hs\\n      let mut hc1 = hc\\n      // #954 (Codex P1): when the body's type is unknown (e.g. a bare\\n      // `throw`), adopt the first ground arm value type as the handle\\n      // result instead of staying CtUnknown — otherwise\\n      // `let n: Int = handle { throw(\\\"x\\\") } with Error { Throw(_) => \\\"s\\\" }`\\n      // sailed through and did Int arithmetic on a String.\\n      let mut hres: Type = hty\\n      let mut hai = 0\\n      while hai < Array::length(harms) {\\n        let (hpat, hbody) = Array::get(harms, hai)\\n        match hpat {\\n          PCtor(hqname, hbinds) => {\\n            let hci = String::index_of(hqname, \\\"::\\\")\\n            if hci > 0 && effect_is_declared(defs, String::substring(hqname, 0, hci)) {\\n              match effect_op_sig(defs, hqname) {\\n                Some(hsig) => {\\n                  let (hparams, hret) = hsig\\n                  let hplen = Array::length(hparams)\\n                  let hblen = Array::length(hbinds)\\n                  // The op's declared arity, plus optionally one trailing\\n                  // continuation binder (`Op(v, k)` — the #627 k-convention).\\n                  // #814: the k-convention only ever ran on the retired\\n                  // MoonBit fixture runner; the selfhost build path compiles\\n                  // the binder but codegen dies with an internal `undefined\\n                  // variable (local): k`. Reject it HERE with a located\\n                  // message until evidence-passing handlers (#817) land.\\n                  if hblen == hplen + 1 {\\n                    // #828: this shape is EITHER a payload-arity typo or an\\n                    // intended k-convention continuation — say both, since a\\n                    // plain extra binder was misdiagnosed as k-convention.\\n                    Array::push(errors, String::concat(\\\"handler arm \\\", String::concat(hqname, String::concat(String::concat(\\\" expects \\\", String::concat(__to_string(hplen), \\\" payload binding(s), got \\\")), String::concat(__to_string(hblen), \\\" — either drop the extra binder, or if it was meant as a non-tail continuation (k-convention): that is not supported by the build path; use resume(v) (#814, evidence-passing handlers #817)\\\")))))\\n                  } else if hblen != hplen {\\n                    Array::push(errors, String::concat(\\\"handler arm \\\", String::concat(hqname, String::concat(\\\" expects \\\", String::concat(__to_string(hplen), \\\" payload binding(s)\\\")))))\\n                  } else {\\n                    ()\\n                  }\\n                  // Bind payload names to the op's param types and check the\\n                  // arm body (the trailing k binder stays CtUnknown).\\n                  let mut henv = env\\n                  let mut hbi = 0\\n                  while hbi < hblen {\\n                    match Array::get(hbinds, hbi) {\\n                      PBind(hbname) => {\\n                        henv = env_bind(henv, hbname, if hbi < hplen {\\n                          Array::get(hparams, hbi)\\n                        } else {\\n                          CtUnknown\\n                        })\\n                      },\\n                      _ => ()\\n                    }\\n                    hbi = hbi + 1\\n                  }\\n                  let (harm_ty, hns, hnc) = check_expr(hbody, henv, defs, hs1, hc1, errors, tytab)\\n                  hs1 = hns\\n                  hc1 = hnc\\n                  // #938: a non-resuming arm's value IS the handle result, so\\n                  // it must unify with the body's type. Resume-tailed arms\\n                  // type as CtUnknown (builtin resume), which the ground gate\\n                  // in check_assignable waves through, so only arms returning\\n                  // a concrete mismatching value are rejected.\\n                  let hres_now = subst_apply(hs1, hres)\\n                  let harm_now = subst_apply(hs1, harm_ty)\\n                  if hres_now is CtUnknown {\\n                    hres = harm_now\\n                  } else {\\n                    hs1 = check_assignable(hres_now, harm_now, hs1, errors, \\\"handler arm value type mismatch with the handle body's type\\\", 0 - 1)\\n                  }\\n                  // resume(x): x must be assignable to the op's declared\\n                  // return type (ground-gated). Throwaway walk — nested\\n                  // handles are skipped (their resumes belong to inner arms).\\n                  hs1 = check_resume_values(hbody, hret, henv, defs, hs1, hc1, errors, tytab)\\n                },\\n                None => Array::push(errors, String::concat(\\\"handler arm `\\\", String::concat(String::substring(hqname, hci + 2, String::length(hqname)), String::concat(\\\"` is not an operation of effect \\\", String::substring(hqname, 0, hci)))))\\n              }\\n            } else if hci > 0 && String::substring(hqname, 0, hci) == \\\"Error\\\" {\\n              // #640 Stage 1: Error arms stay OUT of the #813 arm validation\\n              // above (payload/arity/exhaustiveness unchanged), but a\\n              // resume(...) inside one is rejected — Error is non-resumable\\n              // (`throw` / `perform Error::Throw` unwind for good; the arm's\\n              // value IS the handle result, so the resume never ran).\\n              reject_resume_in_error_arm(hbody, errors)\\n              // #938: an Error arm never resumes, so its value IS the handle\\n              // result — type the body (Throw's payload binds as String) and\\n              // unify with the handle body's type. Ground-gated, so arms\\n              // whose value involves unknowns (throw/rethrow etc.) pass.\\n              let mut eaenv = env\\n              if Array::length(hbinds) == 1 {\\n                match Array::get(hbinds, 0) {\\n                  PBind(eabname) => {\\n                    // The payload stays CtUnknown: `throw` accepts any value\\n                    // (#786 — suberror payloads like `throw(AppError(\\\"x\\\"))`\\n                    // are legal), so pinning String would newly reject valid\\n                    // `Throw(e) => inspect(e)` handlers (Codex P1 on #954).\\n                    eaenv = env_bind(eaenv, eabname, CtUnknown)\\n                  },\\n                  _ => ()\\n                }\\n              } else {\\n                ()\\n              }\\n              let (earm_ty, eans, eanc) = check_expr(hbody, eaenv, defs, hs1, hc1, errors, tytab)\\n              hs1 = eans\\n              hc1 = eanc\\n              let eres_now = subst_apply(hs1, hres)\\n              let earm_now = subst_apply(hs1, earm_ty)\\n              if eres_now is CtUnknown {\\n                hres = earm_now\\n              } else {\\n                hs1 = check_assignable(eres_now, earm_now, hs1, errors, \\\"handler arm value type mismatch with the handle body's type\\\", 0 - 1)\\n              }\\n            } else {\\n              ()\\n            }\\n          },\\n          _ => ()\\n        }\\n        hai = hai + 1\\n      }\\n      // #828: op-arm exhaustiveness for DECLARED effects — a handler covering\\n      // only some ops compiled and the unhandled perform trapped unreachable\\n      // at runtime with no message. The checker knows the op set (it already\\n      // rejects unknown arm names), so require every op to have an arm.\\n      let hx_eff = Array::slice([\\n        \\\"\\\"\\n      ], 0, 0)\\n      let hx_ops = Array::slice([\\n        \\\"\\\"\\n      ], 0, 0)\\n      let mut hxi = 0\\n      while hxi < Array::length(harms) {\\n        let (hxpat, _) = Array::get(harms, hxi)\\n        match hxpat {\\n          PCtor(hxq, _) => {\\n            let hxci = String::index_of(hxq, \\\"::\\\")\\n            if hxci > 0 && effect_is_declared(defs, String::substring(hxq, 0, hxci)) {\\n              Array::push(hx_eff, String::substring(hxq, 0, hxci))\\n              Array::push(hx_ops, String::substring(hxq, hxci + 2, String::length(hxq)))\\n            } else {\\n              ()\\n            }\\n          },\\n          _ => ()\\n        }\\n        hxi = hxi + 1\\n      }\\n      if Array::length(hx_eff) > 0 {\\n        match find_typedef(defs, Array::get(hx_eff, 0)) {\\n          Some(TDEffect(_, hx_decl_ops)) => {\\n            let mut hoi = 0\\n            while hoi < Array::length(hx_decl_ops) {\\n              let (hx_op_name, _, _) = Array::get(hx_decl_ops, hoi)\\n              let mut hx_found = false\\n              let mut hoj = 0\\n              while hoj < Array::length(hx_ops) {\\n                if Array::get(hx_ops, hoj) == hx_op_name {\\n                  hx_found = true\\n                } else {\\n                  ()\\n                }\\n                hoj = hoj + 1\\n              }\\n              if hx_found {\\n                ()\\n              } else {\\n                Array::push(errors, String::concat(\\\"non-exhaustive handler: operation `\\\", String::concat(hx_op_name, String::concat(\\\"` of effect \\\", String::concat(Array::get(hx_eff, 0), \\\" has no arm — performing it would trap at runtime; add an arm for it\\\")))))\\n              }\\n              hoi = hoi + 1\\n            }\\n          },\\n          _ => ()\\n        }\\n      } else {\\n        ()\\n      }\\n      (hres, hs1, hc1)\\n    },\\n    EWhile(cond, body) => {\\n      let (ct, s1, c1) = check_expr(cond, env, defs, s, c, errors, tytab)\\n      let resolved_ct = subst_apply(s1, ct)\\n      match resolved_ct {\\n        CtBool => (),\\n        CtUnknown => (),\\n        CtVar(_) => (),\\n        _ => Array::push(errors, \\\"while condition must be Bool\\\")\\n      }\\n      let (_, s2, c2) = check_expr(body, env_bind(env, \\\"__in_loop__\\\", CtUnit), defs, s1, c1, errors, tytab)\\n      (CtUnit, s2, c2)\\n    },\\n    ELoop(params, body) => {\\n      let mut env1 = env\\n      let mut s1 = s\\n      let mut c1 = c\\n      let mut i = 0\\n      while i < Array::length(params) {\\n        let (name, init) = Array::get(params, i)\\n        let (pt, ns, nc) = check_expr(init, env1, defs, s1, c1, errors, tytab)\\n        env1 = env_bind(env1, name, pt)\\n        s1 = ns\\n        c1 = nc\\n        i = i + 1\\n      }\\n      let (_, s2, c2) = check_expr(body, env_bind(env1, \\\"__in_loop__\\\", CtUnit), defs, s1, c1, errors, tytab)\\n      (CtUnit, s2, c2)\\n    },\\n    EForIn(name, index_name, iterable, body) => {\\n      // `for await x in s` reaches the checker as `for x in __await_iter(s)`\\n      // (the parser's marker; the dict-passing desugar strips it for codegen).\\n      // The marker is not a real function, so check the inner iterable directly.\\n      let real_iterable = match iterable {\\n        ECall(callee, args, _) => match callee {\\n          EIdent(nm, _) => if nm == \\\"__await_iter\\\" && Array::length(args) == 1 {\\n            Array::get(args, 0)\\n          } else iterable,\\n          _ => iterable\\n        },\\n        _ => iterable\\n      }\\n      let (it, s1, c1) = check_expr(real_iterable, env, defs, s, c, errors, tytab)\\n      // Element type bound by `for x in it`:\\n      //   - `Array[T]`                       -> T\\n      //   - a parameterized iterator type\\n      //     `C[T, ..]` (`LazyIter[T]`, async `Stream[T]`, `for await`'s\\n      //     desugared iterator, …) -> its FIRST type argument `T`. By the\\n      //     iterator convention `next(Self) -> Option[(T, Self)]` the element is\\n      //     the struct's first type parameter, so it is recoverable from the\\n      //     iterable's type alone — which matters across modules, where the\\n      //     `impl Iterator for C` lives in a dependency and is not in this file's\\n      //     import env (the dict-passing desugar drives codegen off the merged\\n      //     sources separately). Only `for` loops over a real iterable reach\\n      //     codegen, so a non-iterator never lands here in a valid program.\\n      //   - an iterator type with NO type argument (a bare struct value, or\\n      //     `Stream` in the eager Array-backed model, docs/spec §M2c-3) -> a\\n      //     fresh unification var, so the loop body's usage constrains the\\n      //     element instead of `CtUnknown` silently accepting any element use and\\n      //     dropping element-type safety.\\n      let it_resolved = subst_apply(s1, it)\\n      let (et, c1b) = match it_resolved {\\n        CtArray(elem) => (elem, c1),\\n        CtNamed(nm, args) => if Array::length(args) > 0 {\\n          (Array::get(args, 0), c1)\\n        } else if nm == \\\"Stream\\\" || type_name_has_iterator_impl(env, nm) {\\n          fresh_var(c1)\\n        } else (CtUnknown, c1),\\n        CtStruct(nm) => if type_name_has_iterator_impl(env, nm) {\\n          fresh_var(c1)\\n        } else (CtUnknown, c1),\\n        other => {\\n          // `for x in 5` over a primitive scalar can never be an iterable and\\n          // was accepted silently. Only flag the unambiguously non-iterable\\n          // primitives — a struct/named type may have an Iterator impl in\\n          // another module (see above), so those stay tolerated.\\n          let flag = match other {\\n            CtInt => true,\\n            CtDouble => true,\\n            CtBool => true,\\n            CtUnit => true,\\n            CtChar => true,\\n            _ => false\\n          }\\n          if flag {\\n            Array::push(errors, \\\"for loop requires an iterable (Array or iterator)\\\")\\n          } else {\\n            ()\\n          }\\n          (CtUnknown, c1)\\n        }\\n      }\\n      let env2 = env_bind(env, name, et)\\n      let env3 = match index_name {\\n        Some(index_name) => env_bind(env2, index_name, CtInt),\\n        None => env2\\n      }\\n      let (bt, s2, c2) = check_expr(body, env_bind(env3, \\\"__in_loop__\\\", CtUnit), defs, s1, c1b, errors, tytab)\\n      (CtArray(bt), s2, c2)\\n    },\\n    // #897: `mod.x` against a qualified-import namespace (`import ... as mod\\n    // only { x }`) is bound directly as \\\"mod.x\\\" in env (see\\n    // qualify_import_items in lib/@vibe/parser/parser.vibe -- bare `mod` is\\n    // deliberately never bound, so a real identifier can never collide with\\n    // this key). Whole-program merge later rewrites `EDot(EIdent(mod), x)`\\n    // straight to the merged/renamed `x` (import_alias_rewrite.vibe), but\\n    // some lanes (incremental fs_compile) type-check per-file BEFORE that\\n    // merge runs, so this same shortcut is needed here too: resolve through\\n    // the qualified binding directly instead of ever checking `mod` alone.\\n    EDot(obj, field, dot_off, field_off) => {\\n      // #897/Codex P2: only take the qualified-import shortcut when `ns` is\\n      // NOT independently bound -- see the matching comment on the ECall\\n      // callee-is-EDot arm above for the full rationale.\\n      let qualified_key = match obj {\\n        EIdent(ns, _) => match env_lookup(env, ns) {\\n          Some(_) => None,\\n          None => Some(String::concat(ns, String::concat(\\\".\\\", field)))\\n        },\\n        _ => None\\n      }\\n      let qualified_hit = match qualified_key {\\n        Some(k) => env_lookup(env, k),\\n        None => None\\n      }\\n      match qualified_hit {\\n        Some(_) => match qualified_key {\\n          Some(k) => check_expr(EIdent(k, field_off), env, defs, s, c, errors, tytab),\\n          None => (CtUnknown, s, c)\\n        },\\n        None => {\\n          let (obj_ty, s1, c1) = check_expr(obj, env, defs, s, c, errors, tytab)\\n          let resolved = subst_apply(s1, obj_ty)\\n      let field_ty = match resolved {\\n        CtStruct(sname) => match find_typedef(defs, sname) {\\n          Some(td) => match td {\\n            TDStruct(_, fields, _, _) => {\\n              let rec find_field: (Int) -> Option[Type] = (i) -> {\\n                if i >= Array::length(fields) {\\n                  None\\n                } else {\\n                  let (fname, ftype) = Array::get(fields, i)\\n                  if fname == field {\\n                    Some(ftype)\\n                  } else find_field(i + 1)\\n                }\\n              }\\n              match find_field(0) {\\n                Some(ft) => ft,\\n                None => {\\n                  Array::push(errors, String::concat(String::concat(\\\"unknown field '\\\", String::concat(field, String::concat(\\\"' on struct \\\", sname))), if field_off >= 0 { off_marker_len(field_off, String::length(field)) } else { off_marker(dot_off) }))\\n                  CtUnknown\\n                }\\n              }\\n            },\\n            _ => CtUnknown\\n          },\\n          None => CtUnknown\\n        },\\n        // #829: field read through an INSTANTIATED generic struct value —\\n        // substitute the declared type params with the receiver's type args so\\n        // `b.v` on `Box[Int]` is `Int` (previously the whole read was\\n        // CtUnknown, letting `String::length(b.v)` compile to silent garbage).\\n        // A CtNamed head that is not a known struct (Stream/i64/unresolved\\n        // type params, cross-module names) stays tolerated as before.\\n        CtNamed(gname, gargs) => match find_typedef(defs, gname) {\\n          Some(td) => match td {\\n            TDStruct(_, gfields, _, gtparams) => {\\n              let rec find_field_g: (Int) -> Option[Type] = (i) -> {\\n                if i >= Array::length(gfields) {\\n                  None\\n                } else {\\n                  let (fname, ftype) = Array::get(gfields, i)\\n                  if fname == field {\\n                    Some(ftype)\\n                  } else find_field_g(i + 1)\\n                }\\n              }\\n              match find_field_g(0) {\\n                Some(ft) => inst_struct_field_ty(ft, gtparams, gargs),\\n                None => {\\n                  Array::push(errors, String::concat(String::concat(\\\"unknown field '\\\", String::concat(field, String::concat(\\\"' on struct \\\", gname))), if field_off >= 0 { off_marker_len(field_off, String::length(field)) } else { off_marker(dot_off) }))\\n                  CtUnknown\\n                }\\n              }\\n            },\\n            _ => CtUnknown\\n          },\\n          None => CtUnknown\\n        },\\n        // `t.N` tuple projection: the index must be in range, else it reads an\\n        // out-of-bounds slot (`(1, 2).5` was accepted). When `field` is a\\n        // numeric index and the tuple arity is known, bounds-check it.\\n        CtTuple(elems) => match parse_tuple_index(field) {\\n          Some(idx) => if idx >= 0 && idx < Array::length(elems) {\\n            Array::get(elems, idx)\\n          } else {\\n            Array::push(errors, String::concat(String::concat(\\\"tuple index \\\", String::concat(field, String::concat(\\\" out of range for a \\\", String::concat(__to_string(Array::length(elems)), \\\"-tuple\\\")))), if field_off >= 0 { off_marker_len(field_off, String::length(field)) } else { off_marker(dot_off) }))\\n            CtUnknown\\n          },\\n          None => CtUnknown\\n        },\\n        // Field access on a concrete NON-struct value (`o.x` where `o :\\n        // Option[P]`, or a scalar / function) is a type error — only structs\\n        // (and tuple `.N`) have fields. Type vars / unknown / named scrutinees\\n        // are tolerated; CtString/CtBytes/CtArray are NOT flagged because `.m`\\n        // on them parses as a method call elsewhere, not a value-position EDot.\\n        other => {\\n          let not_struct = match other {\\n            CtInt => true,\\n            CtDouble => true,\\n            CtBool => true,\\n            CtChar => true,\\n            CtUnit => true,\\n            CtOption(_) => true,\\n            CtFn(_, _, _) => true,\\n            _ => false\\n          }\\n          if not_struct {\\n            Array::push(errors, String::concat(String::concat(\\\"field access `.\\\", String::concat(field, \\\"` on a non-struct value\\\")), if field_off >= 0 { off_marker_len(field_off, String::length(field)) } else { off_marker(dot_off) }))\\n          } else {\\n            ()\\n          }\\n          CtUnknown\\n        }\\n      }\\n      // Record this field-access node's (raw, pre-final-subst) projection type\\n      // keyed by its real source offset, for typed-hover on `obj.field`.\\n      // Synthetic accesses (dot_off < 0) are skipped. #645: the field token's\\n      // own offset gets the same entry, so hovering the field NAME (not just\\n      // the base) resolves the projection type.\\n      if dot_off >= 0 {\\n        Array::push(tytab, (dot_off, field_ty))\\n      } else {\\n        ()\\n      }\\n      if field_off >= 0 && field_off != dot_off {\\n        Array::push(tytab, (field_off, field_ty))\\n      } else {\\n        ()\\n      }\\n          (field_ty, s1, c1)\\n        }\\n      }\\n    },\\n    EFn(tparams, tbounds, params, ret_ty, effect, body) => {\\n      let tplen = Array::length(tparams)\\n      let mut tp_env = env\\n      let mut s0 = s\\n      let mut c0 = c\\n      let mut tpi = 0\\n      while tpi < tplen {\\n        let tpname = Array::get(tparams, tpi)\\n        match fresh_var(c0) {\\n          (tv, nc) => {\\n            let vid = nc - 1\\n            let tblen = Array::length(tbounds)\\n            let mut bounds = Array::slice([\\n              \\\"\\\"\\n            ], 0, 0)\\n            let mut tbi = 0\\n            let mut found_bounds = false\\n            while tbi < tblen {\\n              let (bname, blist) = Array::get(tbounds, tbi)\\n              if !found_bounds && bname == tpname {\\n                bounds = blist\\n                found_bounds = true\\n              }\\n              tbi = tbi + 1\\n            }\\n            s0 = if Array::length(bounds) == 0 {\\n              s0\\n            } else subst_add_bound(s0, vid, bounds)\\n            tp_env = env_bind(tp_env, tpname, tv)\\n            c0 = nc\\n          },\\n          _ => ()\\n        }\\n        tpi = tpi + 1\\n      }\\n      let plen = Array::length(params)\\n      let mut fn_env = tp_env\\n      let mut s1 = s0\\n      let mut c1 = c0\\n      let param_types = Array::slice([\\n        CtUnknown\\n      ], 0, 0)\\n      let mut pi = 0\\n      while pi < plen {\\n        let (raw_name, ann) = Array::get(params, pi)\\n        let nlen = String::length(raw_name)\\n        let name = if nlen > 0 {\\n          let lc = String::char_code_at(raw_name, nlen - 1)\\n          if lc == '~' || lc == '?' {\\n            raw_name[0: nlen - 1]\\n          } else raw_name\\n        } else raw_name\\n        let (pt, ns, nc) = match ann {\\n          Some(te) => {\\n            let resolved = resolve_type_expr(te, defs)\\n            let pt2 = resolve_tparams_in(resolved, fn_env)\\n            (pt2, s1, c1)\\n          },\\n          None => {\\n            let (tv, nc2) = fresh_var(c1)\\n            (tv, s1, nc2)\\n          }\\n        }\\n        fn_env = env_bind(fn_env, name, pt)\\n        Array::push(param_types, pt)\\n        s1 = ns\\n        c1 = nc\\n        pi = pi + 1\\n      }\\n      // Bind the function's annotated return type under a sentinel so an\\n      // explicit `return e` inside the body can be checked against it (the body\\n      // value is checked below, but `return` short-circuits and was otherwise\\n      // unchecked — `() -> Int { return \\\"x\\\" }` was accepted). Nested functions\\n      // rebind the sentinel, so `return` always targets the nearest enclosing\\n      // function's type.\\n      // #964 (Codex P2 on #941): an UNANNOTATED function must SHADOW the\\n      // sentinel too (bind CtUnknown), not inherit the enclosing function's.\\n      // `return` targets the nearest enclosing function, so a `return Ok(1)`\\n      // inside an unannotated lambda nested in a `-> Option[Int]` fn belongs\\n      // to the LAMBDA — checking it against the OUTER annotation wrongly\\n      // rejected it once the #941 railway-conflict report landed. CtUnknown\\n      // unifies with anything, so the EReturn check is inert for it.\\n      let body_env = match ret_ty {\\n        Some(rte) => env_bind(fn_env, \\\"__return__\\\", resolve_tparams_in(resolve_type_expr(rte, defs), fn_env)),\\n        None => env_bind(fn_env, \\\"__return__\\\", CtUnknown)\\n      }\\n      let (bt, s2, c2) = check_expr(body, body_env, defs, s1, c1, errors, tytab)\\n      let (final_ret, s3) = match ret_ty {\\n        Some(te) => {\\n          let resolved = resolve_type_expr(te, defs)\\n          let resolved_ret = resolve_tparams_in(resolved, fn_env)\\n          match unify(bt, resolved_ret, s2) {\\n            Some(ns) => (subst_apply(ns, resolved_ret), ns),\\n            None => {\\n              Array::push(errors, String::concat(\\\"return type mismatch: expected \\\", String::concat(type_to_string(resolved_ret), String::concat(\\\", got \\\", type_to_string(bt)))))\\n              (CtUnknown, s2)\\n            }\\n          }\\n        },\\n        None => (subst_apply(s2, bt), s2)\\n      }\\n      (CtFn(param_types, final_ret, effect), s3, c2)\\n    },\\n    EBreak(opt) => {\\n      // `break` is only meaningful inside a loop. Loop bodies bind the\\n      // `__in_loop__` sentinel; its absence means this `break` is outside any\\n      // loop (`() -> { break }`). Threaded through env, so if/match/let/seq\\n      // inside a loop still see it; a nested function does not introduce one, so\\n      // a `break` there is (conservatively) left unchecked rather than flagged.\\n      match env_lookup(env, \\\"__in_loop__\\\") {\\n        Some(_) => (),\\n        None => Array::push(errors, \\\"`break` outside a loop\\\")\\n      }\\n      match opt {\\n        Some(e) => {\\n          let (_, s1, c1) = check_expr(e, env, defs, s, c, errors, tytab)\\n          (CtUnit, s1, c1)\\n        },\\n        None => (CtUnit, s, c)\\n      }\\n    },\\n    EContinue(args) => {\\n      match env_lookup(env, \\\"__in_loop__\\\") {\\n        Some(_) => (),\\n        None => Array::push(errors, \\\"`continue` outside a loop\\\")\\n      }\\n      let alen = Array::length(args)\\n      let mut s1 = s\\n      let mut c1 = c\\n      let mut ai = 0\\n      while ai < alen {\\n        let (_, ns, nc) = check_expr(Array::get(args, ai), env, defs, s1, c1, errors, tytab)\\n        s1 = ns\\n        c1 = nc\\n        ai = ai + 1\\n      }\\n      (CtUnit, s1, c1)\\n    },\\n    ERecord(rn, fields, targs) => {\\n      let flen = Array::length(fields)\\n      let mut s1 = s\\n      let mut c1 = c\\n      let field_tys = Array::slice([\\n        (\\\"\\\", CtUnknown)\\n      ], 0, 0)\\n      let mut fi = 0\\n      while fi < flen {\\n        let (fname, fval) = Array::get(fields, fi)\\n        // A field may be given only once in a record literal (`P::{ x: 1, x: 2 }`\\n        // silently kept the last). Report a duplicate by scanning the names\\n        // already collected.\\n        let mut dj = 0\\n        let mut dup = false\\n        while dj < Array::length(field_tys) {\\n          let (pn, _) = Array::get(field_tys, dj)\\n          if pn == fname {\\n            dup = true\\n          } else {\\n            ()\\n          }\\n          dj = dj + 1\\n        }\\n        if dup {\\n          Array::push(errors, String::concat(\\\"duplicate field `\\\", String::concat(fname, \\\"` in record literal\\\")))\\n        } else {\\n          ()\\n        }\\n        let (ft, ns, nc) = check_expr(fval, env, defs, s1, c1, errors, tytab)\\n        Array::push(field_tys, (fname, ft))\\n        s1 = ns\\n        c1 = nc\\n        fi = fi + 1\\n      }\\n      // #810: a NAMED struct literal `S::{ ... }` (rn carries the parsed\\n      // struct name since the ERecord arity bump) is validated against S's\\n      // declaration by NAME — the field-set heuristics below cannot tell a\\n      // typo'd `Point::{ x, z }` from an intentional anonymous\\n      // `record { x, z }`, so before this check a same-count wrong-name\\n      // field silently landed in another field's slot. Anonymous literals\\n      // (rn == \\\"\\\") keep the field-set path unchanged.\\n      if rn != \\\"\\\" {\\n        match find_typedef(defs, rn) {\\n          Some(td) => match td {\\n            TDStruct(_, dfields, _, s_tparams) => {\\n              // Unknown literal fields (present in the literal, absent from\\n              // the declaration).\\n              let mut ui = 0\\n              while ui < Array::length(field_tys) {\\n                let (an, _) = Array::get(field_tys, ui)\\n                let mut known = false\\n                let mut uj = 0\\n                while uj < Array::length(dfields) {\\n                  let (dn, _) = Array::get(dfields, uj)\\n                  if dn == an {\\n                    known = true\\n                  } else {\\n                    ()\\n                  }\\n                  uj = uj + 1\\n                }\\n                if !known {\\n                  Array::push(errors, String::concat(\\\"unknown field `\\\", String::concat(an, String::concat(\\\"` for struct \\\", rn))))\\n                } else {\\n                  ()\\n                }\\n                ui = ui + 1\\n              }\\n              // #829: instantiate a GENERIC struct's declared type params with\\n              // fresh inference vars, so the field values determine the\\n              // construction's concrete type arguments (`Box::{ v: 1 }` is\\n              // `Box[Int]`, not CtUnknown → its field reads become checkable).\\n              //\\n              // #886: EXPLICIT type arguments (`Pair[Int]::{ .. }`) pin the\\n              // instantiation instead: each declared param is substituted by\\n              // the resolved explicit argument (no fresh var), so field values\\n              // are checked against the pinned types (mismatches surface as\\n              // `struct field type mismatch for <f>`) and the construction's\\n              // type is exactly `CtNamed(rn, <explicit args>)` even when the\\n              // field values alone could not determine a param (e.g. an\\n              // empty-array field). An arity mismatch reports an error and\\n              // falls back to #829's inference to avoid cascading errors.\\n              let tplen = Array::length(s_tparams)\\n              let ntargs = Array::length(targs)\\n              if ntargs > 0 && ntargs != tplen {\\n                Array::push(errors, \\\"struct \\\\{rn} expects \\\\{tplen} type argument(s), got \\\\{ntargs} in `\\\\{rn}[...]::{ ... }` (#886 explicit struct type arguments)\\\")\\n              }\\n              let use_explicit = ntargs > 0 && ntargs == tplen\\n              let fresh_targs = Array::slice([\\n                CtUnknown\\n              ], 0, 0)\\n              let mut c2 = c1\\n              let mut tpi = 0\\n              while tpi < tplen {\\n                if use_explicit {\\n                  // Resolve through the generic environment (same as param /\\n                  // return annotations, ~line 3252): an explicit argument\\n                  // naming an ENCLOSING fn's type parameter (`fn make[T](x:\\n                  // T) -> Box[T] { Box[T]::{ v: x } }`) must become the\\n                  // env-bound CtVar, not a rigid CtNamed(\\\"T\\\") — otherwise the\\n                  // construction's type loses its link to the quantified\\n                  // param and `make(42).v` fails as `expected Int, got T`\\n                  // (Codex review, PR #926).\\n                  Array::push(fresh_targs, resolve_tparams_in(resolve_type_expr(Array::get(targs, tpi), defs), env))\\n                } else {\\n                  match fresh_var(c2) {\\n                    (tv, nc) => {\\n                      Array::push(fresh_targs, tv)\\n                      c2 = nc\\n                    },\\n                    _ => ()\\n                  }\\n                }\\n                tpi = tpi + 1\\n              }\\n              // Missing declared fields (absent from the literal).\\n              let mut mi = 0\\n              while mi < Array::length(dfields) {\\n                let (dn, dty0) = Array::get(dfields, mi)\\n                // Check field values against the INSTANTIATED declared type\\n                // (rigid params substituted by the fresh vars above); a\\n                // non-generic struct keeps the raw declared type as before.\\n                let dty = if tplen > 0 {\\n                  subst_type_params(dty0, s_tparams, fresh_targs)\\n                } else {\\n                  dty0\\n                }\\n                match lookup_actual_field_ty(field_tys, dn) {\\n                  Some(aty) => {\\n                    // Value type check (ground-gated like check_record_fields).\\n                    s1 = check_assignable(dty, subst_apply(s1, aty), s1, errors, String::concat(\\\"struct field type mismatch for \\\", dn), 0 - 1)\\n                  },\\n                  None => Array::push(errors, String::concat(\\\"missing field `\\\", String::concat(dn, String::concat(\\\"` in construction of struct \\\", rn))))\\n                }\\n                mi = mi + 1\\n              }\\n              // Struct identity: a monomorphic struct keeps `CtStruct(rn)`;\\n              // a GENERIC struct now gets its instantiated nominal type\\n              // `CtNamed(rn, args)` (#829 — previously CtUnknown, which made\\n              // every downstream use of the value unchecked). A non-ground\\n              // struct WITHOUT declared params (unresolved field type names)\\n              // keeps the old CtUnknown tolerance.\\n              if struct_fields_ground(dfields) {\\n                (CtStruct(rn), s1, c2)\\n              } else if tplen > 0 {\\n                let inst_targs = for ta in fresh_targs {\\n                  subst_apply(s1, ta)\\n                }\\n                (CtNamed(rn, inst_targs), s1, c2)\\n              } else {\\n                (CtUnknown, s1, c2)\\n              }\\n            },\\n            _ => {\\n              Array::push(errors, String::concat(\\\"`\\\", String::concat(rn, \\\"` is not a struct (struct literal)\\\")))\\n              (CtUnknown, s1, c1)\\n            }\\n          },\\n          // Unknown name: fall back to the anonymous field-set path instead\\n          // of erroring — the merge layer's private-struct rename and alias\\n          // imports can leave rn referring to a pre-rename spelling that the\\n          // merged defs no longer contain. The typo detection above still\\n          // fires for the common case (the struct EXISTS and a field name is\\n          // wrong).\\n          None => {\\n            let s2f = check_record_fields(defs, field_tys, s1, errors)\\n            let rec_tyf = match resolve_record_struct_name(defs, field_tys) {\\n              Some(sname) => CtStruct(sname),\\n              None => CtUnknown\\n            }\\n            (rec_tyf, s2f, c1)\\n          }\\n        }\\n      } else {\\n        // Check the field values against the matching struct's declared types.\\n        let s2 = check_record_fields(defs, field_tys, s1, errors)\\n        // Recover the struct identity (when unambiguous) so downstream uses — in\\n        // particular `mut`-field write checking — see a concrete `CtStruct`.\\n        let rec_ty = match resolve_record_struct_name(defs, field_tys) {\\n          Some(sname) => CtStruct(sname),\\n          None => CtUnknown\\n        }\\n        (rec_ty, s2, c1)\\n      }\\n    },\\n    ETuple(items) => {\\n      let ilen = Array::length(items)\\n      let mut s1 = s\\n      let mut c1 = c\\n      let tys = Array::slice([\\n        CtUnknown\\n      ], 0, 0)\\n      let mut ti = 0\\n      while ti < ilen {\\n        let (it, ns, nc) = check_expr(Array::get(items, ti), env, defs, s1, c1, errors, tytab)\\n        Array::push(tys, it)\\n        s1 = ns\\n        c1 = nc\\n        ti = ti + 1\\n      }\\n      (CtTuple(tys), s1, c1)\\n    },\\n    EArray(items) => {\\n      let ilen = Array::length(items)\\n      let mut s1 = s\\n      let mut c1 = c\\n      let mut elem_ty = CtUnknown\\n      // Cross-check elements only when the first element is a simple scalar, or\\n      // a one-level array of scalars (`[[1], [\\\"x\\\"]]` — `Array[Int]` vs\\n      // `Array[String]`) — see EMatch: this catches the cheap, bounded cases\\n      // while skipping the per-element `subst_apply` for arrays of large\\n      // struct/tuple values that pressure the self-compile heap.\\n      let mut check_elems = false\\n      let mut ai = 0\\n      while ai < ilen {\\n        let (it, ns, nc) = check_expr(Array::get(items, ai), env, defs, s1, c1, errors, tytab)\\n        s1 = ns\\n        c1 = nc\\n        if ai == 0 {\\n          elem_ty = it\\n          check_elems = match subst_apply(s1, it) {\\n            CtInt => true,\\n            CtDouble => true,\\n            CtBool => true,\\n            CtString => true,\\n            CtChar => true,\\n            CtArray(inner) => match inner {\\n              CtInt => true,\\n              CtDouble => true,\\n              CtBool => true,\\n              CtString => true,\\n              CtChar => true,\\n              _ => false\\n            },\\n            _ => false\\n          }\\n        } else {\\n          if check_elems {\\n            s1 = check_assignable(elem_ty, subst_apply(s1, it), s1, errors, \\\"array elements have incompatible types\\\", 0 - 1)\\n          } else {\\n            ()\\n          }\\n        }\\n        ai = ai + 1\\n      }\\n      (CtArray(elem_ty), s1, c1)\\n    },\\n    EReturn(e) => {\\n      let (et, s1, c1) = check_expr(e, env, defs, s, c, errors, tytab)\\n      // Check the returned value against the enclosing function's annotated\\n      // return type (bound as `__return__` by the EFn arm). Ground-gated via\\n      // check_assignable, so a generic return type is not over-rejected.\\n      match env_lookup(env, \\\"__return__\\\") {\\n        Some(rt) => {\\n          let rte = subst_apply(s1, rt)\\n          let ate = subst_apply(s1, et)\\n          // #941: an Option⇔Result railway-head conflict is a genuine\\n          // mismatch, but check_assignable tolerates it (a `CtNamed` head is\\n          // neither reportable nor a differing head_kind). Report it directly\\n          // — this is exactly the `?`-desugar's early `return Err(e)` /\\n          // `return None` escaping a function annotated with the OTHER monad\\n          // (docs/cheatsheet.md #635: mixing is a type error).\\n          if railway_heads_conflict(rte, ate) {\\n            Array::push(errors, String::concat(\\\"return type mismatch\\\", String::concat(\\\": expected \\\", String::concat(type_to_string(rte), String::concat(\\\", got \\\", String::concat(type_to_string(ate), off_marker(railway_expr_off(e))))))))\\n          } else {\\n            let _ = check_assignable(rte, ate, s1, errors, \\\"return type mismatch\\\", 0 - 1)\\n            ()\\n          }\\n        },\\n        None => ()\\n      }\\n      // The expression value of `return e` is `e`'s type, not CtUnknown. A lambda\\n      // whose body is a bare `return e` (`(n) -> { return n }`) otherwise inferred\\n      // a CtUnknown return type, so when its type came from OUTER unification\\n      // (`let g: (Int) -> String = (n) -> { return n }`) the return/result\\n      // mismatch was hidden — the no-`return` form `(n) -> { n }` is rejected, so\\n      // the `return` form must be too. Propagating `et` makes them identical.\\n      (et, s1, c1)\\n    },\\n    EMap(mpairs) => {\\n      // #938: map literals were entirely untyped (fell through to CtUnknown),\\n      // so `map { \\\"a\\\": 1, \\\"b\\\": \\\"two\\\" }` compiled and the stray String read\\n      // back as a garbage Int. Check each entry and require pairwise\\n      // homogeneous keys/values, ground-gated exactly like array literals\\n      // (only when the first key/value type is a simple ground type).\\n      let mut ms1 = s\\n      let mut mc1 = c\\n      let mut mvty: Type = CtUnknown\\n      let mut mchk_v = false\\n      let mut mi = 0\\n      while mi < Array::length(mpairs) {\\n        let (_, mve) = Array::get(mpairs, mi)\\n        let (mvt, mvs, mvc) = check_expr(mve, env, defs, ms1, mc1, errors, tytab)\\n        ms1 = mvs\\n        mc1 = mvc\\n        if mi == 0 {\\n          mvty = mvt\\n          mchk_v = map_literal_ground(subst_apply(ms1, mvt))\\n        } else {\\n          if mchk_v {\\n            ms1 = check_assignable(mvty, subst_apply(ms1, mvt), ms1, errors, \\\"map literal values have incompatible types\\\", 0 - 1)\\n          } else {\\n            ()\\n          }\\n        }\\n        mi = mi + 1\\n      }\\n      // #983: surface the literal's value type as a REAL slot —\\n      // `CtNamed(\\\"Map\\\", [CtString, v])`, the exact shape a `Map[String, V]`\\n      // annotation resolves to (checker_resolve's TyApp fallback) — so\\n      // `Map::set`/`Map::get` can check against it. An empty literal\\n      // (`Map::new()`) gets a fresh var; a let-bound empty map GENERALIZES\\n      // (#996 Codex P2: `Map::set` is a functional update, so aliases of the\\n      // empty binding build independent maps — no value restriction; each\\n      // use re-instantiates a fresh slot, bound by that use's own flow).\\n      if Array::length(mpairs) == 0 {\\n        let (mv0, mc2) = fresh_var(mc1)\\n        (CtNamed(\\\"Map\\\", [CtString, mv0]), ms1, mc2)\\n      } else {\\n        (CtNamed(\\\"Map\\\", [CtString, subst_apply(ms1, mvty)]), ms1, mc1)\\n      }\\n    },\\n    ELabeledArg(_, _, la_val) => {\\n      // #986: desugar_labeled_args (run before checking — see check_program)\\n      // RESOLVES labeled args whose callee's parameter names are known in this\\n      // module: it reorders fully-labeled calls into declared order and strips\\n      // the ELabeledArg wrappers, so those values reach the strict positional\\n      // unification as plain args. An ELabeledArg that SURVIVES to this arm\\n      // therefore has no label→position resolution available here — the\\n      // callee is import-resolved (its param names live in another module,\\n      // Codex P2-1 on #993), locally shadowed, a builtin with decorative flag\\n      // labels (`sh_lines(\\\"ls\\\", a = true)`), or an erroneous local shape that\\n      // check_labeled_arg_names_stmts reports by name. Check the value for\\n      // nested diagnostics but type the arg CtUnknown, so an unresolvable\\n      // label is never falsely rejected by position.\\n      let (_, la_s, la_c) = check_expr(la_val, env, defs, s, c, errors, tytab)\\n      (CtUnknown, la_s, la_c)\\n    },\\n    _ => (CtUnknown, s, c)\\n  }\\n}\\n\\nfn map_literal_ground(t: Type) -> Bool {\\n  match t {\\n    CtInt => true,\\n    CtDouble => true,\\n    CtBool => true,\\n    CtString => true,\\n    CtChar => true,\\n    _ => false\\n  }\\n}\\n\")\n}\n\nlet cli_adapter_source_47 = () -> (String, String) {\n  (\"lib/@vibe/compiler/checker/checker_stmt.vibe\",\n\"//# Imports\\n\\nimport ../checker_trait.vibe {\\n  register_builtin_traits\\n}\\n\\nimport ../checker_effects.vibe {\\n  check_async_effects_stmts, check_mutability_stmts, check_perform_effects_stmts_env, effect_error_to_string\\n}\\n\\nimport ../core/index.vibe {\\n  Expr, Pat, Stmt, TypeExpr, Subst, Type, TypeDef, TypeEnv, collect_subst_bounds_pairs, env_bind, env_cache, env_flat_bindings, env_lookup_flat, generalize, resolve_builtin, subst_apply, trait_defined, type_implements_trait, type_to_string\\n}\\n\\nimport ./checker.vibe {\\n  check_assignable, check_expr, fn_return_env_name, is_array_builder_ty, pat_binds_resume, preserve_generic_instantiation, reject_resume_outside_handler\\n}\\n\\nimport ./checker_resolve.vibe {\\n  resolve_type_expr, subst_type_params\\n}\\n\\nimport ../desugar_trait_dict.vibe {\\n  desugar_labeled_args, desugar_railway_binds, inject_prelude_result, inject_trait_method_generics\\n}\\n\\n//# Functions\\n\\n// ADR-0069 Phase 1: locate a top-level statement for the reject diagnostics\\n// below — first available source char-offset of the statement's value\\n// expression (same walk as codegen's first_offset; duplicated locally to keep\\n// checker → codegen imports out). -1 when no offset-carrying node exists; the\\n// `[@off=N]` marker convention (see checker.vibe off_marker) then simply\\n// stays off the message.\\nfn top_stmt_expr_off(e: Expr) -> Int {\\n  match e {\\n    EIdent(_, off) => off,\\n    ECall(callee, _, off) => if off >= 0 {\\n      off\\n    } else {\\n      top_stmt_expr_off(callee)\\n    },\\n    EDot(base, _, off, _) => if off >= 0 {\\n      off\\n    } else {\\n      top_stmt_expr_off(base)\\n    },\\n    EBinOp(_, lhs, _) => top_stmt_expr_off(lhs),\\n    EUnaryOp(_, inner) => top_stmt_expr_off(inner),\\n    ELet(_, val, _, _) => top_stmt_expr_off(val),\\n    ELetRec(_, val, _) => top_stmt_expr_off(val),\\n    ELetMut(_, val, _, _) => top_stmt_expr_off(val),\\n    EAssign(_, val, _) => top_stmt_expr_off(val),\\n    EAssignOp(_, _, val, _) => top_stmt_expr_off(val),\\n    ESeq(first, _) => top_stmt_expr_off(first),\\n    EIf(cond, _, _) => top_stmt_expr_off(cond),\\n    EMatch(scrut, _) => top_stmt_expr_off(scrut),\\n    EReturn(inner) => top_stmt_expr_off(inner),\\n    _ => 0 - 1\\n  }\\n}\\n\\n// String::concat only (never `+` / interpolation — NUL-miscodegen hazard in\\n// selfhost, same rule as checker.vibe off_marker).\\nfn top_level_reject_msg(what: String, e: Expr) -> String {\\n  let base = String::concat(what, \\\" (ADR-0069)\\\")\\n  let off = top_stmt_expr_off(e)\\n  if off >= 0 {\\n    String::concat(base, String::concat(\\\" [@off=\\\", String::concat(__to_string(off), \\\"]\\\")))\\n  } else {\\n    base\\n  }\\n}\\n\\nfn import_cache_lookup(cache: Array[(String, Type)], name: String, i: Int) -> Option[Type] {\\n  if i >= Array::length(cache) {\\n    None\\n  }\\n  else {\\n    let (cached_name, cached_ty) = Array::get(cache, i)\\n    if cached_name == name {\\n      Some(cached_ty)\\n    }\\n    else import_cache_lookup(cache, name, i + 1)\\n  }\\n}\\n\\nfn bind_stmt_imports(env: TypeEnv, names: Array[(String, Option[String])]) -> TypeEnv {\\n  let env_bindings = env_flat_bindings(env)\\n  let import_cache = Array::slice([\\n    (\\\"\\\", CtUnknown)\\n  ], 0, 0)\\n  let nlen = Array::length(names)\\n  let mut i = 0\\n  let mut acc = env\\n  while i < nlen {\\n    let (name, alias) = Array::get(names, i)\\n    let bound_name = match alias {\\n      Some(a) => a,\\n      None => name\\n    }\\n    let ty = match import_cache_lookup(import_cache, name, 0) {\\n      Some(t) => t,\\n      None => {\\n        let resolved = match env_lookup_flat(env_bindings, name) {\\n          Some(t) => t,\\n          None => CtUnknown\\n        }\\n        Array::push(import_cache, (name, resolved))\\n        resolved\\n      }\\n    }\\n    let acc_with_name = env_bind(acc, bound_name, ty)\\n    acc = match env_lookup_flat(env_bindings, fn_return_env_name(name)) {\\n      Some(ret_ty) => env_bind(acc_with_name, fn_return_env_name(bound_name), ret_ty),\\n      None => acc_with_name\\n    }\\n    i = i + 1\\n  }\\n  acc\\n}\\n\\nfn annotation_return_type(ann: Option[TypeExpr], defs: Array[TypeDef]) -> Option[Type] {\\n  match ann {\\n    Some(te) => match te {\\n      TyFn(params, ret, _) => {\\n        let ret_box = Array::slice([\\n          ret\\n        ], 0, 1)\\n        let _ = Array::length(params)\\n        Some(resolve_type_expr(Array::get(ret_box, 0), defs))\\n      },\\n      _ => None\\n    },\\n    None => None\\n  }\\n}\\n\\nfn fn_expr_return_type(expr: Expr, defs: Array[TypeDef]) -> Option[Type] {\\n  match expr {\\n    EFn(_, _, _, ret_ty, _, _) => match ret_ty {\\n      Some(te) => Some(resolve_type_expr(te, defs)),\\n      None => None\\n    },\\n    _ => None\\n  }\\n}\\n\\nfn bind_fn_return(env: TypeEnv, name: String, ret_ty: Type) -> TypeEnv {\\n  env_bind(env, fn_return_env_name(name), ret_ty)\\n}\\n\\nfn bind_annotation_return(env: TypeEnv, name: String, ann: Option[TypeExpr], defs: Array[TypeDef]) -> TypeEnv {\\n  match annotation_return_type(ann, defs) {\\n    Some(ret_ty) => bind_fn_return(env, name, ret_ty),\\n    None => env\\n  }\\n}\\n\\nfn bind_value_or_annotation_return(env: TypeEnv, name: String, val: Expr, ann: Option[TypeExpr], defs: Array[TypeDef]) -> TypeEnv {\\n  match fn_expr_return_type(val, defs) {\\n    Some(ret_ty) => bind_fn_return(env, name, ret_ty),\\n    None => bind_annotation_return(env, name, ann, defs)\\n  }\\n}\\n\\nfn struct_derives_has(derives: Array[String], name: String) -> Bool {\\n  let mut i = 0\\n  let mut found = false\\n  while i < Array::length(derives) {\\n    if Array::get(derives, i) == name {\\n      found = true\\n      i = Array::length(derives)\\n    } else {\\n      i = i + 1\\n    }\\n  }\\n  found\\n}\\n\\n// The derivable traits the structural `derive(...)` desugar understands. Any\\n// other name in a `derive(...)` clause is rejected with `unknown trait: <name>`\\n// (#638) so a typo / unsupported trait fails the compile instead of silently\\n// generating nothing.\\nfn derive_name_is_known(name: String) -> Bool {\\n  name == \\\"Eq\\\" || name == \\\"Ord\\\" || name == \\\"Show\\\" || name == \\\"Hash\\\" || name == \\\"Default\\\"\\n}\\n\\nfn validate_derives(derives: Array[String], errors: Array[String]) -> Unit {\\n  let mut i = 0\\n  while i < Array::length(derives) {\\n    let name = Array::get(derives, i)\\n    if name != \\\"\\\" && !derive_name_is_known(name) {\\n      Array::push(errors, String::concat(\\\"unknown trait: \\\", name))\\n    } else {\\n      ()\\n    }\\n    i = i + 1\\n  }\\n}\\n\\nfn stmt_is_type_decl(stmt: Stmt) -> Bool {\\n  match stmt {\\n    SEnum(_, _, _, _, _) => true,\\n    SSuberror(_, _, _) => true,\\n    SStruct(_, _, _, _, _, _) => true,\\n    STypeAlias(_, _, _, _) => true,\\n    _ => false\\n  }\\n}\\n\\n// #613: process type declarations (enum / struct / type-alias / suberror) before\\n// value definitions so a `let` may construct or reference a type or constructor\\n// declared LATER in the same statement list (a forward reference). check_stmts\\n// records each type into `defs` and binds its constructors into `env` only when\\n// the declaration statement is reached, so without this a value defined before\\n// its enum saw neither the type nor its constructors and aborted the compile\\n// with an opaque trap (e.g. an imported module whose function constructs an enum\\n// value lands before the enum in the merged statement list). Codegen is already\\n// order-independent (the ctor table scans every statement up front), so this\\n// check-side reorder is sufficient. The partition is STABLE, so already-ordered\\n// (type-before-value) code is processed exactly as before, and relative order\\n// within each group is preserved.\\nfn reorder_type_decls_first(stmts: Array[Stmt], start: Int) -> Array[Stmt] {\\n  let out = Array::slice(stmts, 0, start)\\n  let n = Array::length(stmts)\\n  let mut i = start\\n  while i < n {\\n    let st = Array::get(stmts, i)\\n    if stmt_is_type_decl(st) {\\n      Array::push(out, st)\\n    }\\n    i = i + 1\\n  }\\n  let mut j = start\\n  while j < n {\\n    let st = Array::get(stmts, j)\\n    if !stmt_is_type_decl(st) {\\n      Array::push(out, st)\\n    }\\n    j = j + 1\\n  }\\n  out\\n}\\n\\nexport fn check_stmts(raw_stmts: Array[Stmt], i: Int, env: TypeEnv, defs: Array[TypeDef], s: Subst, c: Int, errors: Array[String], tytab: Array[(Int, Type)]) -> (TypeEnv, Subst, Int) {\\n  let stmts = reorder_type_decls_first(raw_stmts, i)\\n  let mut idx = i\\n  let mut cur_env = env\\n  let mut cur_s = s\\n  let mut cur_c = c\\n  // #602: hoist top-level binding signatures so a `let` may reference another\\n  // top-level `let` defined later in the same statement list (a forward\\n  // reference). Without this, checking the earlier binding's body raised\\n  // \\\"unknown name\\\" and aborted the whole compile with an opaque trap.\\n  // check_stmts is only used for program / module statement lists — local\\n  // `let`s are ELet expressions checked in check_expr — so this does not affect\\n  // block scoping. An annotated binding hoists its declared type; an\\n  // un-annotated one hoists as CtUnknown (its precise type is filled in when its\\n  // own statement is reached, which shadows this pre-binding). Pre-binding only\\n  // adds names, and a later real binding shadows it, so ordered\\n  // (backward-reference) code is checked exactly as before.\\n  let mut hoist_i = idx\\n  while hoist_i < Array::length(stmts) {\\n    match Array::get(stmts, hoist_i) {\\n      SLet(_, _, hname, hann, _) => {\\n        let ht = match hann {\\n          Some(hte) => resolve_type_expr(hte, defs),\\n          None => CtUnknown\\n        }\\n        cur_env = env_bind(cur_env, hname, ht)\\n      },\\n      _ => ()\\n    }\\n    hoist_i = hoist_i + 1\\n  }\\n  // #942 (Codex P2 on #969): if any top-level declaration in this statement\\n  // list binds the name `resume` (fn/let — fn decls are lowered to SLet\\n  // before the checker — let-pattern, extern let, or an import), codegen's\\n  // prefer_bound_call routes every `resume(x)` in the file to that BOUND\\n  // function (a global name match, see codegen/expr/compile_call.vibe), so\\n  // the #942 misuse walks must stand down for the whole list.\\n  let mut resume_shadowed_top = false\\n  let mut rst_i = idx\\n  while rst_i < Array::length(stmts) {\\n    match Array::get(stmts, rst_i) {\\n      SLet(_, _, rstname, _, _) => if rstname == \\\"resume\\\" {\\n        resume_shadowed_top = true\\n      } else {\\n        ()\\n      },\\n      SLetMut(rstname, _, _) => if rstname == \\\"resume\\\" {\\n        resume_shadowed_top = true\\n      } else {\\n        ()\\n      },\\n      SExternLet(rstname, _) => if rstname == \\\"resume\\\" {\\n        resume_shadowed_top = true\\n      } else {\\n        ()\\n      },\\n      SLetPat(rstpat, _) => if pat_binds_resume(rstpat) {\\n        resume_shadowed_top = true\\n      } else {\\n        ()\\n      },\\n      SImport(_, rstnames) => {\\n        let mut rn_i = 0\\n        while rn_i < Array::length(rstnames) {\\n          let (rn_name, rn_alias) = Array::get(rstnames, rn_i)\\n          let rn_bound = match rn_alias {\\n            Some(a) => a,\\n            None => rn_name\\n          }\\n          if rn_bound == \\\"resume\\\" {\\n            resume_shadowed_top = true\\n          } else {\\n            ()\\n          }\\n          rn_i = rn_i + 1\\n        }\\n      },\\n      SReExport(_, rstnames) => {\\n        let mut rn_i = 0\\n        while rn_i < Array::length(rstnames) {\\n          let (rn_name, rn_alias) = Array::get(rstnames, rn_i)\\n          let rn_bound = match rn_alias {\\n            Some(a) => a,\\n            None => rn_name\\n          }\\n          if rn_bound == \\\"resume\\\" {\\n            resume_shadowed_top = true\\n          } else {\\n            ()\\n          }\\n          rn_i = rn_i + 1\\n        }\\n      },\\n      _ => ()\\n    }\\n    rst_i = rst_i + 1\\n  }\\n  while idx < Array::length(stmts) {\\n    let env = cur_env\\n    let s = cur_s\\n    let c = cur_c\\n    let stmt = Array::get(stmts, idx)\\n    // #942 (ADR-0050): resume-misuse walk — a call-position `resume(...)`\\n    // outside any handler arm is rejected, and inside a (non-Error) arm it\\n    // must sit in tail position. Runs on a throwaway lane per statement\\n    // (only ADDS diagnostics; inference flow untouched). SModule bodies are\\n    // covered by the recursive check_stmts call below. `resume_shadowed_top`\\n    // (computed above): when a top-level declaration binds the name `resume`,\\n    // codegen's prefer_bound_call routes every `resume(x)` to the bound\\n    // function, so the misuse walk stands down (Codex P2 on #969).\\n    match stmt {\\n      SLet(_, _, _, _, rv) => reject_resume_outside_handler(rv, resume_shadowed_top, errors),\\n      SLetMut(_, _, rv) => reject_resume_outside_handler(rv, resume_shadowed_top, errors),\\n      SLetPat(_, rv) => reject_resume_outside_handler(rv, resume_shadowed_top, errors),\\n      STest(_, rb) => reject_resume_outside_handler(rb, resume_shadowed_top, errors),\\n      SBench(_, rb) => reject_resume_outside_handler(rb, resume_shadowed_top, errors),\\n      SExpr(re) => reject_resume_outside_handler(re, resume_shadowed_top, errors),\\n      _ => ()\\n    }\\n    let (new_env, s1, c1) = match stmt {\\n      SLet(_, is_rec, name, ann, val) => {\\n        let (vt, ns0, nc) = if is_rec {\\n          check_expr(val, env_bind(env, name, CtUnknown), defs, s, c, errors, tytab)\\n        } else {\\n          check_expr(val, env, defs, s, c, errors, tytab)\\n        }\\n        // The value must be assignable to a declared annotation (previously\\n        // unchecked — `let x: Int = \\\"s\\\"` was accepted).\\n        let (ns, t) = match ann {\\n          Some(te) => {\\n            let resolved_te = resolve_type_expr(te, defs)\\n            let actual_v = subst_apply(ns0, vt)\\n            // #844/#981: `check_assignable` itself now reports the same-name\\n            // concrete generic instantiation mismatch (its tolerate branch\\n            // calls `detect_narrowed_generic_mismatch` — see checker.vibe),\\n            // so the explicit second call this site used to make would\\n            // double-report the same diagnostic — dropped.\\n            let ns_b = check_assignable(resolved_te, actual_v, ns0, errors, String::concat(\\\"binding type mismatch for \\\", name), 0 - 1)\\n            // Prefer the RHS's real instantiated type over the erasing bare\\n            // annotation when `resolved_te` is a bare generic-struct\\n            // reference that `actual_v` already concretely instantiates, so a\\n            // LATER statement's lookup of this binding sees real type args\\n            // instead of an erased placeholder (see\\n            // `preserve_generic_instantiation`'s doc comment in checker.vibe).\\n            (ns_b, preserve_generic_instantiation(resolved_te, subst_apply(ns_b, vt)))\\n          },\\n          None => if is_array_builder_ty(subst_apply(ns0, vt)) {\\n            // #938 value restriction: keep a builder's element var\\n            // un-quantified so pushes constrain each other (see the ELet arm\\n            // in checker.vibe).\\n            (ns0, vt)\\n          } else {\\n            (ns0, generalize(ns0, vt))\\n          }\\n        }\\n        let env1 = env_bind(env, name, t)\\n        (bind_value_or_annotation_return(env1, name, val, ann, defs), ns, nc)\\n      },\\n      SLetMut(name, ann, val) => {\\n        // ADR-0069 Phase 1: top level is declarations only. A top-level\\n        // `let mut` was never soundly implemented (the linear backend\\n        // miscompiles cross-function references); reject it, but keep\\n        // checking/binding below for error recovery.\\n        Array::push(errors, top_level_reject_msg(\\\"top-level `let mut` bindings are not allowed; move it into fn main\\\", val))\\n        let (vt, ns0, nc) = check_expr(val, env, defs, s, c, errors, tytab)\\n        let ns = match ann {\\n          Some(te) => check_assignable(resolve_type_expr(te, defs), subst_apply(ns0, vt), ns0, errors, String::concat(\\\"binding type mismatch for \\\", name), 0 - 1),\\n          None => ns0\\n        }\\n        let t = match ann {\\n          Some(te) => resolve_type_expr(te, defs),\\n          None => vt\\n        }\\n        let env1 = env_bind(env, name, t)\\n        (bind_value_or_annotation_return(env1, name, val, ann, defs), ns, nc)\\n      },\\n      SLetPat(pat, val) => {\\n        let (vt, ns, nc) = check_expr(val, env, defs, s, c, errors, tytab)\\n        let new_env = match pat {\\n          PTuple(pats) => match vt {\\n            CtTuple(types) => {\\n              let mut e = env\\n              let mut pi = 0\\n              while pi < Array::length(pats) {\\n                match Array::get(pats, pi) {\\n                  PBind(name) => if pi < Array::length(types) {\\n                    e = env_bind(e, name, Array::get(types, pi))\\n                  } else {\\n                    e = env_bind(e, name, CtUnknown)\\n                  },\\n                  _ => ()\\n                }\\n                pi = pi + 1\\n              }\\n              e\\n            },\\n            _ => {\\n              // A tuple pattern can only destructure a tuple value. `let (a, b) =\\n              // 5` was accepted and bound `a`/`b` to garbage. When the value\\n              // resolves to a concrete NON-tuple type (a scalar, array, option,\\n              // fn, struct, enum), this is a real error. Type vars / unknown /\\n              // named (generic) values stay tolerated.\\n              let concrete_non_tuple = match subst_apply(ns, vt) {\\n                CtInt => true,\\n                CtDouble => true,\\n                CtBool => true,\\n                CtString => true,\\n                CtChar => true,\\n                CtUnit => true,\\n                CtBytes => true,\\n                CtArray(_) => true,\\n                CtOption(_) => true,\\n                CtFn(_, _, _) => true,\\n                CtStruct(_) => true,\\n                CtEnum(_) => true,\\n                _ => false\\n              }\\n              if concrete_non_tuple {\\n                Array::push(errors, \\\"tuple pattern cannot destructure a non-tuple value\\\")\\n              } else {\\n                ()\\n              }\\n              let mut e = env\\n              let mut pi = 0\\n              while pi < Array::length(pats) {\\n                match Array::get(pats, pi) {\\n                  PBind(name) => {\\n                    e = env_bind(e, name, CtUnknown)\\n                  },\\n                  _ => ()\\n                }\\n                pi = pi + 1\\n              }\\n              e\\n            }\\n          },\\n          PBind(name) => env_bind(env, name, vt),\\n          PStruct(_, fields) => {\\n            let mut e = env\\n            let mut fi = 0\\n            while fi < Array::length(fields) {\\n              let (_, fpat) = Array::get(fields, fi)\\n              match fpat {\\n                PBind(name) => {\\n                  e = env_bind(e, name, CtUnknown)\\n                },\\n                _ => ()\\n              }\\n              fi = fi + 1\\n            }\\n            e\\n          },\\n          _ => env\\n        }\\n        (new_env, ns, nc)\\n      },\\n      SEnum(_, name, params, variants, enum_derives) => {\\n        validate_derives(enum_derives, errors)\\n        let param_len = Array::length(params)\\n        let param_var_ids = Array::slice([\\n          0\\n        ], 0, 0)\\n        let param_var_types = Array::slice([\\n          CtUnknown\\n        ], 0, 0)\\n        let mut pi = 0\\n        while pi < param_len {\\n          let vid = c + pi\\n          Array::push(param_var_ids, vid)\\n          Array::push(param_var_types, CtVar(vid))\\n          pi = pi + 1\\n        }\\n        let ctor_result_type = if param_len == 0 {\\n          CtEnum(name)\\n        } else {\\n          CtNamed(name, param_var_types)\\n        }\\n        let ctor_bounds = Array::slice([\\n          (0, Array::slice([\\n            \\\"\\\"\\n          ], 0, 0))\\n        ], 0, 0)\\n        let resolved_variants = Array::slice([\\n          (\\\"\\\", Array::slice([\\n            CtUnknown\\n          ], 0, 0))\\n        ], 0, 0)\\n        let mut vi = 0\\n        while vi < Array::length(variants) {\\n          let (vname, vtypes) = Array::get(variants, vi)\\n          let resolved_vtypes = Array::slice([\\n            CtUnknown\\n          ], 0, 0)\\n          let mut ti = 0\\n          while ti < Array::length(vtypes) {\\n            let vt = subst_type_params(resolve_type_expr(Array::get(vtypes, ti), defs), params, param_var_types)\\n            Array::push(resolved_vtypes, vt)\\n            ti = ti + 1\\n          }\\n          Array::push(resolved_variants, (vname, resolved_vtypes))\\n          vi = vi + 1\\n        }\\n        Array::push(defs, TDEnum(name, params, resolved_variants))\\n        let mut env1 = env_bind(env, name, CtEnum(name))\\n        let mut ci2 = 0\\n        while ci2 < Array::length(variants) {\\n          let (vname, vtypes) = Array::get(variants, ci2)\\n          let ctor_ty = if Array::length(vtypes) == 0 {\\n            ctor_result_type\\n          } else {\\n            let resolved_args = Array::slice([\\n              CtUnknown\\n            ], 0, 0)\\n            let mut ai = 0\\n            while ai < Array::length(vtypes) {\\n              let arg_ty = subst_type_params(resolve_type_expr(Array::get(vtypes, ai), defs), params, param_var_types)\\n              Array::push(resolved_args, arg_ty)\\n              ai = ai + 1\\n            }\\n            CtFn(resolved_args, ctor_result_type, None)\\n          }\\n          let exported_ctor_ty = if param_len == 0 {\\n            ctor_ty\\n          } else {\\n            CtForAll(param_var_ids, ctor_bounds, ctor_ty)\\n          }\\n          env1 = env_bind(env1, vname, exported_ctor_ty)\\n          match ctor_ty {\\n            CtFn(_, ret, _) => {\\n              let exported_ret_ty = if param_len == 0 {\\n                ret\\n              } else {\\n                CtForAll(param_var_ids, ctor_bounds, ret)\\n              }\\n              env1 = bind_fn_return(env1, vname, exported_ret_ty)\\n            },\\n            _ => ()\\n          }\\n          ci2 = ci2 + 1\\n        }\\n        // #672: pre-bind the generated structural `E::equals` (every enum gets\\n        // one) so `==` dispatch call sites resolve at check time.\\n        let env_eq = env_bind(env1, String::concat(name, \\\"::equals\\\"), CtFn([\\n          ctor_result_type,\\n          ctor_result_type\\n        ], CtBool, None))\\n        // #638: pre-bind the signatures the enum-derive desugar will generate, so\\n        // `E::compare` / `E::to_string` / `E::default` resolve at check time (the\\n        // FS-compile path checks before the codegen-time desugar runs).\\n        let env_ord = if struct_derives_has(enum_derives, \\\"Ord\\\") {\\n          env_bind(env_eq, String::concat(name, \\\"::compare\\\"), CtFn([\\n            ctor_result_type,\\n            ctor_result_type\\n          ], CtInt, None))\\n        } else {\\n          env_eq\\n        }\\n        let env_show = if struct_derives_has(enum_derives, \\\"Show\\\") || struct_derives_has(enum_derives, \\\"Hash\\\") {\\n          env_bind(env_ord, String::concat(name, \\\"::to_string\\\"), CtFn([\\n            ctor_result_type\\n          ], CtString, None))\\n        } else {\\n          env_ord\\n        }\\n        // #694: `derive(Hash)` generates `E::hash_key(Self) -> String` (the\\n        // structural Map key), so pre-bind its signature at check time too, AND\\n        // register `impl Hash for E` so a `[K: Hash]` bound is satisfied by the\\n        // derived enum.\\n        let env_hash = if struct_derives_has(enum_derives, \\\"Hash\\\") {\\n          let env_h = EnvTraitImpl(\\\"Hash\\\", ctor_result_type, env_show)\\n          env_bind(env_h, String::concat(name, \\\"::hash_key\\\"), CtFn([\\n            ctor_result_type\\n          ], CtString, None))\\n        } else {\\n          env_show\\n        }\\n        let env_default = if struct_derives_has(enum_derives, \\\"Default\\\") {\\n          env_bind(env_hash, String::concat(name, \\\"::default\\\"), CtFn(Array::slice([\\n            CtUnit\\n          ], 0, 0), ctor_result_type, None))\\n        } else {\\n          env_hash\\n        }\\n        (env_default, s, c + param_len)\\n      },\\n      SSuberror(_, name, variants) => {\\n        // #786: a `suberror Name(payload...)` declaration is structurally a\\n        // single-typed enum whose constructors produce a throwable value. It\\n        // was parsed (SSuberror) but never bound, so `KeyInvalid(\\\"x\\\")` was an\\n        // \\\"unknown name\\\". Register it exactly like a no-type-param enum: record\\n        // a TDEnum def (so `match` + type resolution work) and bind each\\n        // constructor name as `CtFn(payload, CtEnum(name))`. `throw` accepts the\\n        // resulting value (its param is CtUnknown, see builtins_misc).\\n        let ctor_result_type = CtEnum(name)\\n        let resolved_variants = Array::slice([\\n          (\\\"\\\", Array::slice([\\n            CtUnknown\\n          ], 0, 0))\\n        ], 0, 0)\\n        let mut vi = 0\\n        while vi < Array::length(variants) {\\n          let (vname, vtypes) = Array::get(variants, vi)\\n          let resolved_vtypes = Array::slice([\\n            CtUnknown\\n          ], 0, 0)\\n          let mut ti = 0\\n          while ti < Array::length(vtypes) {\\n            Array::push(resolved_vtypes, resolve_type_expr(Array::get(vtypes, ti), defs))\\n            ti = ti + 1\\n          }\\n          Array::push(resolved_variants, (vname, resolved_vtypes))\\n          vi = vi + 1\\n        }\\n        Array::push(defs, TDEnum(name, Array::slice([\\n          \\\"\\\"\\n        ], 0, 0), resolved_variants))\\n        let mut env1 = env_bind(env, name, CtEnum(name))\\n        let mut ci2 = 0\\n        while ci2 < Array::length(variants) {\\n          let (vname, vtypes) = Array::get(variants, ci2)\\n          let ctor_ty = if Array::length(vtypes) == 0 {\\n            ctor_result_type\\n          } else {\\n            let resolved_args = Array::slice([\\n              CtUnknown\\n            ], 0, 0)\\n            let mut ai = 0\\n            while ai < Array::length(vtypes) {\\n              Array::push(resolved_args, resolve_type_expr(Array::get(vtypes, ai), defs))\\n              ai = ai + 1\\n            }\\n            CtFn(resolved_args, ctor_result_type, None)\\n          }\\n          env1 = env_bind(env1, vname, ctor_ty)\\n          match ctor_ty {\\n            CtFn(_, ret, _) => {\\n              env1 = bind_fn_return(env1, vname, ret)\\n            },\\n            _ => ()\\n          }\\n          ci2 = ci2 + 1\\n        }\\n        let env_eq = env_bind(env1, String::concat(name, \\\"::equals\\\"), CtFn([\\n          ctor_result_type,\\n          ctor_result_type\\n        ], CtBool, None))\\n        (env_eq, s, c)\\n      },\\n      SStruct(_, name, field_defs, derives, mut_fields, tparams) => {\\n        validate_derives(derives, errors)\\n        let resolved_fields = Array::slice([\\n          (\\\"\\\", CtUnit)\\n        ], 0, 0)\\n        let mut fi = 0\\n        while fi < Array::length(field_defs) {\\n          let (fname, ftype_expr) = Array::get(field_defs, fi)\\n          let ftype = resolve_type_expr(ftype_expr, defs)\\n          Array::push(resolved_fields, (fname, ftype))\\n          fi = fi + 1\\n        }\\n        // #829: record the declared type params — a param name resolves above\\n        // to a rigid `CtNamed(param, [])` (no such typedef/builtin), which is\\n        // exactly what the checker's literal instantiation substitutes.\\n        Array::push(defs, TDStruct(name, resolved_fields, mut_fields, tparams))\\n        let field_types = Array::slice([\\n          CtUnknown\\n        ], 0, 0)\\n        let mut fj = 0\\n        while fj < Array::length(resolved_fields) {\\n          let (_, fty) = Array::get(resolved_fields, fj)\\n          Array::push(field_types, fty)\\n          fj = fj + 1\\n        }\\n        let env1 = env_bind(env, name, CtFn(field_types, CtStruct(name), None))\\n        // #638: pre-bind the signatures of the structural functions that the\\n        // derive desugar will generate, so `Type::compare` / `Type::to_string`\\n        // resolve at check time (the FS-compile path checks before the\\n        // codegen-time desugar runs).\\n        let env2 = if struct_derives_has(derives, \\\"Ord\\\") {\\n          env_bind(env1, String::concat(name, \\\"::compare\\\"), CtFn([\\n            CtStruct(name),\\n            CtStruct(name)\\n          ], CtInt, None))\\n        } else {\\n          env1\\n        }\\n        let env3 = if struct_derives_has(derives, \\\"Show\\\") || struct_derives_has(derives, \\\"Hash\\\") {\\n          env_bind(env2, String::concat(name, \\\"::to_string\\\"), CtFn([\\n            CtStruct(name)\\n          ], CtString, None))\\n        } else {\\n          env2\\n        }\\n        // #672: every struct gets a generated structural `T::equals` (the `==`\\n        // dispatch relies on it), so pre-bind its signature unconditionally.\\n        let env4 = env_bind(env3, String::concat(name, \\\"::equals\\\"), CtFn([\\n          CtStruct(name),\\n          CtStruct(name)\\n        ], CtBool, None))\\n        // #694: `derive(Hash)` generates `T::hash_key(Self) -> String` (the\\n        // structural Map key), so pre-bind its signature at check time too, AND\\n        // register `impl Hash for T` so a `[K: Hash]` bound (e.g. `get_by`) is\\n        // satisfied by the derived type.\\n        let env_hash = if struct_derives_has(derives, \\\"Hash\\\") {\\n          let env_h = EnvTraitImpl(\\\"Hash\\\", CtStruct(name), env4)\\n          env_bind(env_h, String::concat(name, \\\"::hash_key\\\"), CtFn([\\n            CtStruct(name)\\n          ], CtString, None))\\n        } else {\\n          env4\\n        }\\n        // #638: `derive(Default)` generates `T::default() -> T` (a zero-arg fn,\\n        // so the CtFn parameter list is empty).\\n        let env5 = if struct_derives_has(derives, \\\"Default\\\") {\\n          env_bind(env_hash, String::concat(name, \\\"::default\\\"), CtFn(Array::slice([\\n            CtUnit\\n          ], 0, 0), CtStruct(name), None))\\n        } else {\\n          env_hash\\n        }\\n        (bind_fn_return(env5, name, CtStruct(name)), s, c)\\n      },\\n      STypeAlias(_, name, params, te) => {\\n        let t = resolve_type_expr(te, defs)\\n        // Record the alias (with its formal params) so an applied use\\n        // `Name[Arg]` expands via subst in resolve_type_expr's TyApp case.\\n        Array::push(defs, TDAlias(name, params, t))\\n        (env_bind(env, name, t), s, c)\\n      },\\n      SExternLet(name, te) => {\\n        let t = resolve_type_expr(te, defs)\\n        let env1 = env_bind(env, name, t)\\n        (bind_annotation_return(env1, name, Some(te), defs), s, c)\\n      },\\n      STest(_, body) => {\\n        let (_, ns, nc) = check_expr(body, env, defs, s, c, errors, tytab)\\n        (env, ns, nc)\\n      },\\n      SBench(_, body) => {\\n        let (_, ns, nc) = check_expr(body, env, defs, s, c, errors, tytab)\\n        (env, ns, nc)\\n      },\\n      SExpr(expr) => {\\n        // ADR-0069 Phase 1: top level is declarations only. A top-level\\n        // expression statement was silently DROPPED by the linear backend;\\n        // reject it (still type-check the expression for error recovery).\\n        Array::push(errors, top_level_reject_msg(\\\"top-level expressions are not allowed; move it into fn main\\\", expr))\\n        let (_, ns, nc) = check_expr(expr, env, defs, s, c, errors, tytab)\\n        (env, ns, nc)\\n      },\\n      SModule(_, _, body) => {\\n        let _ = check_stmts(body, 0, env, defs, s, c, errors, tytab)\\n        (env, s, c)\\n      },\\n      SImport(_, names) => (bind_stmt_imports(env, names), s, c)\\n      ,\\n      SReExport(_, names) => (bind_stmt_imports(env, names), s, c)\\n      ,\\n      SAliasDecl(_, _) => (env, s, c)\\n      ,\\n      STrait(_, name, supers, methods, _) => {\\n        let is_open = false\\n        (EnvTraitDef(name, supers, is_open, methods, env), s, c)\\n      },\\n      SImpl(tparams, tbounds, trait_name, type_name) => {\\n        let target = match resolve_builtin(type_name) {\\n          Some(t) => t,\\n          None => CtNamed(type_name, Array::slice([\\n            CtUnknown\\n          ], 0, 0))\\n        }\\n        // A generic impl `impl [T] Trait for C` (type parameters present) is\\n        // registered as `EnvTraitImplGen` so trait resolution can match the\\n        // family `C[..]` against a concrete `C[K]` by constructor (the target's\\n        // type args are erased). A plain `impl Trait for C` stays a nominal\\n        // `EnvTraitImpl`. (#5 generic impls, Increment A.)\\n        let new_env = if Array::length(tparams) > 0 {\\n          EnvTraitImplGen(trait_name, tparams, tbounds, target, env)\\n        } else {\\n          EnvTraitImpl(trait_name, target, env)\\n        }\\n        (new_env, s, c)\\n      },\\n      SEffectDef(_, ename, eparams, ops) => {\\n        // #813: register the effect's operation signatures (resolved to\\n        // checker Types) so perform arguments, handler arm names/arity/\\n        // payload binds, and resume values can be validated. Generic effects\\n        // (type params) are not registered — every consumer ground-gates on\\n        // the registry, so an absent entry means \\\"no signature checking\\\",\\n        // exactly the pre-#813 behavior.\\n        if Array::length(eparams) == 0 {\\n          let resolved_ops = Array::slice([\\n            (\\\"\\\", Array::slice([\\n              CtUnknown\\n            ], 0, 0), CtUnknown)\\n          ], 0, 0)\\n          let mut oi = 0\\n          while oi < Array::length(ops) {\\n            let (opname, opparams, opret) = Array::get(ops, oi)\\n            let rp = Array::slice([\\n              CtUnknown\\n            ], 0, 0)\\n            let mut pi = 0\\n            while pi < Array::length(opparams) {\\n              Array::push(rp, resolve_type_expr(Array::get(opparams, pi), defs))\\n              pi = pi + 1\\n            }\\n            Array::push(resolved_ops, (opname, rp, resolve_type_expr(opret, defs)))\\n            oi = oi + 1\\n          }\\n          Array::push(defs, TDEffect(ename, resolved_ops))\\n        } else {\\n          ()\\n        }\\n        (env, s, c)\\n      },\\n      _ => (env, s, c)\\n    }\\n    cur_env = new_env\\n    cur_s = s1\\n    cur_c = c1\\n    idx = idx + 1\\n  }\\n  (cur_env, cur_s, cur_c)\\n}\\n\\n// #641 PR-2: enforce trait bounds. After inference, every bounded type variable\\n// recorded in the final substitution that resolved to a CONCRETE type must\\n// satisfy its bounds. Unresolved (still-polymorphic) vars are inherited by the\\n// caller, not violated, so they are skipped. One `no impl `Trait` for `Type``\\n// error per unsatisfied bound (matches fixtures/err_type_trait_*bound* messages).\\nfn check_program_bounds(env: TypeEnv, s: Subst, errors: Array[String]) -> Unit {\\n  let pairs = collect_subst_bounds_pairs(s)\\n  let n = Array::length(pairs)\\n  let mut i = 0\\n  while i < n {\\n    let (vid, bounds) = Array::get(pairs, i)\\n    let resolved = subst_apply(s, CtVar(vid))\\n    match resolved {\\n      CtVar(_) => (),\\n      CtUnknown => (),\\n      _ => {\\n        let bn = Array::length(bounds)\\n        let mut bi = 0\\n        while bi < bn {\\n          let b = Array::get(bounds, bi)\\n          if b != \\\"\\\" && not(type_implements_trait(env, s, resolved, b)) {\\n            Array::push(errors, String::concat(\\\"no impl `\\\", String::concat(b, String::concat(\\\"` for `\\\", String::concat(type_to_string(resolved), \\\"`\\\")))))\\n          }\\n          bi = bi + 1\\n        }\\n      }\\n    }\\n    i = i + 1\\n  }\\n}\\n\\n// Append `Async`-escape diagnostics (an async primitive used outside an\\n// `{Async}` context) to the type-error list, but only when type checking is\\n// otherwise clean so we surface the real error first.\\nfn collect_async_effect_errors(stmts: Array[Stmt], env: TypeEnv, frozen_errors: Array[String]) -> Unit {\\n  if Array::length(frozen_errors) == 0 {\\n    let eff_errs = check_async_effects_stmts(stmts, env)\\n    let mut i = 0\\n    while i < Array::length(eff_errs) {\\n      Array::push(frozen_errors, effect_error_to_string(Array::get(eff_errs, i)))\\n      i = i + 1\\n    }\\n    if Array::length(frozen_errors) == 0 {\\n      let perform_errs = check_perform_effects_stmts_env(stmts, env)\\n      let mut j = 0\\n      while j < Array::length(perform_errs) {\\n        Array::push(frozen_errors, effect_error_to_string(Array::get(perform_errs, j)))\\n        j = j + 1\\n      }\\n    }\\n    if Array::length(frozen_errors) == 0 {\\n      let mut_errs = check_mutability_stmts(stmts)\\n      let mut k = 0\\n      while k < Array::length(mut_errs) {\\n        Array::push(frozen_errors, effect_error_to_string(Array::get(mut_errs, k)))\\n        k = k + 1\\n      }\\n    }\\n  }\\n}\\n\\n// #986: labeled-argument NAME validation. Codegen binds call arguments\\n// positionally after desugar_labeled_args has reordered fully-labeled calls\\n// into declared parameter order, so any labeled argument that survives to a\\n// position whose parameter has a DIFFERENT base name would silently bind the\\n// wrong parameter (or, for a label naming no parameter at all, is a typo the\\n// user meant to be caught). This walk runs AFTER desugar_labeled_args (see\\n// check_program) and rejects both shapes with a located error. Resolution\\n// scope deliberately mirrors collect_fn_param_labels / relabel_expr in\\n// desugar_trait_dict.vibe: only calls whose callee is an EIdent naming a\\n// top-level `let`-bound function are validated — builtins with decorative\\n// flag labels (`sh_lines(\\\"ls\\\", a = true)`), local closures, and method calls\\n// are left untouched, exactly like the reorder pass leaves them untouched.\\nfn labeled_name_marker(off: Int, len: Int) -> String {\\n  if off >= 0 && len > 0 {\\n    String::concat(\\\" [@off=\\\", String::concat(__to_string(off), String::concat(\\\":\\\", String::concat(__to_string(off + len), \\\"]\\\"))))\\n  } else if off >= 0 {\\n    String::concat(\\\" [@off=\\\", String::concat(__to_string(off), \\\"]\\\"))\\n  } else {\\n    \\\"\\\"\\n  }\\n}\\n\\n// Strip a trailing `~` (labeled) / `?` (optional) marker off a raw parameter\\n// name — same convention as the EFn arm in checker.vibe.\\nfn labeled_param_base_name(n: String) -> String {\\n  let ln = String::length(n)\\n  if ln > 0 {\\n    let last = n[ln - 1: ln]\\n    if last == \\\"~\\\" || last == \\\"?\\\" {\\n      n[0: ln - 1]\\n    } else {\\n      n\\n    }\\n  } else {\\n    n\\n  }\\n}\\n\\n// fname -> ordered parameter base names for EVERY top-level `let f = (..) -> ..`\\n// (labeled or not — a labeled call against an unlabeled fn still binds\\n// positionally, so its labels must line up too).\\nfn collect_labeled_check_fns(stmts: Array[Stmt]) -> Array[(String, Array[String])] {\\n  let out = Array::slice([\\n    (\\\"\\\", Array::slice([\\n      \\\"\\\"\\n    ], 0, 0))\\n  ], 0, 0)\\n  let mut i = 0\\n  while i < Array::length(stmts) {\\n    match Array::get(stmts, i) {\\n      SLet(_, _, fname, _, body) => match body {\\n        EFn(_, _, params, _, _, _) => {\\n          let names = Array::slice([\\n            \\\"\\\"\\n          ], 0, 0)\\n          let mut pi = 0\\n          while pi < Array::length(params) {\\n            let (pn, _) = Array::get(params, pi)\\n            Array::push(names, labeled_param_base_name(pn))\\n            pi = pi + 1\\n          }\\n          Array::push(out, (fname, names))\\n        },\\n        _ => ()\\n      },\\n      _ => ()\\n    }\\n    i = i + 1\\n  }\\n  out\\n}\\n\\nfn lookup_labeled_check_fn(tbl: Array[(String, Array[String])], fname: String) -> Option[Array[String]] {\\n  let mut i = 0\\n  let mut found = None\\n  while i < Array::length(tbl) {\\n    let (n, names) = Array::get(tbl, i)\\n    if n == fname {\\n      found = Some(names)\\n      i = Array::length(tbl)\\n    } else {\\n      i = i + 1\\n    }\\n  }\\n  found\\n}\\n\\nfn labeled_name_check_call(fname: String, fname_off: Int, args: Array[Expr], pnames: Array[String], errors: Array[String]) -> Unit {\\n  let mut ai = 0\\n  while ai < Array::length(args) {\\n    match Array::get(args, ai) {\\n      ELabeledArg(lbl, _, _) => {\\n        let in_position = if ai < Array::length(pnames) {\\n          Array::get(pnames, ai) == lbl\\n        } else {\\n          false\\n        }\\n        if in_position {\\n          ()\\n        } else {\\n          let mut known = false\\n          let mut pi = 0\\n          while pi < Array::length(pnames) {\\n            if Array::get(pnames, pi) == lbl {\\n              known = true\\n            } else {\\n              ()\\n            }\\n            pi = pi + 1\\n          }\\n          let marker = labeled_name_marker(fname_off, String::length(fname))\\n          if known {\\n            Array::push(errors, String::concat(\\\"labeled argument `\\\", String::concat(lbl, String::concat(\\\"` for \\\", String::concat(fname, String::concat(\\\" is out of declared parameter order\\\", marker))))))\\n          } else {\\n            Array::push(errors, String::concat(\\\"unknown labeled argument `\\\", String::concat(lbl, String::concat(\\\"` for \\\", String::concat(fname, marker)))))\\n          }\\n        }\\n      },\\n      _ => ()\\n    }\\n    ai = ai + 1\\n  }\\n}\\n\\n// #986 (Codex P2-2 on #993): the walk tracks lexical shadowing — a local\\n// binding (`let f = ..`, fn param, pattern bind, loop var) of a table name\\n// suppresses validation for calls in its scope, since those calls resolve to\\n// the local value whose parameter names the top-level table does not describe.\\n// Same discipline as relabel_expr's `shadows` stack in desugar_trait_dict.vibe.\\nfn labeled_walk_shadowed(shadows: Array[String], name: String) -> Bool {\\n  let mut i = 0\\n  let mut found = false\\n  while i < Array::length(shadows) {\\n    if Array::get(shadows, i) == name {\\n      found = true\\n      i = Array::length(shadows)\\n    } else {\\n      i = i + 1\\n    }\\n  }\\n  found\\n}\\n\\nfn labeled_walk_pat_binds(pat: Pat, shadows: Array[String]) -> Unit {\\n  match pat {\\n    PBind(n) => Array::push(shadows, n),\\n    PCtor(_, ps) => {\\n      let mut i = 0\\n      while i < Array::length(ps) {\\n        labeled_walk_pat_binds(Array::get(ps, i), shadows)\\n        i = i + 1\\n      }\\n    },\\n    PTuple(ps) => {\\n      let mut i = 0\\n      while i < Array::length(ps) {\\n        labeled_walk_pat_binds(Array::get(ps, i), shadows)\\n        i = i + 1\\n      }\\n    },\\n    POr(a, b) => {\\n      labeled_walk_pat_binds(a, shadows)\\n      labeled_walk_pat_binds(b, shadows)\\n    },\\n    PStruct(_, fields) => {\\n      let mut i = 0\\n      while i < Array::length(fields) {\\n        let (_, fp) = Array::get(fields, i)\\n        labeled_walk_pat_binds(fp, shadows)\\n        i = i + 1\\n      }\\n    },\\n    _ => ()\\n  }\\n}\\n\\nfn labeled_name_check_expr(e: Expr, tbl: Array[(String, Array[String])], shadows: Array[String], errors: Array[String]) -> Unit {\\n  match e {\\n    ECall(callee, args, _) => {\\n      labeled_name_check_expr(callee, tbl, shadows, errors)\\n      let mut i = 0\\n      while i < Array::length(args) {\\n        labeled_name_check_expr(Array::get(args, i), tbl, shadows, errors)\\n        i = i + 1\\n      }\\n      match callee {\\n        EIdent(fname, fname_off) => {\\n          let mut has_labeled = false\\n          let mut li = 0\\n          while li < Array::length(args) {\\n            match Array::get(args, li) {\\n              ELabeledArg(_, _, _) => {\\n                has_labeled = true\\n              },\\n              _ => ()\\n            }\\n            li = li + 1\\n          }\\n          if has_labeled && !labeled_walk_shadowed(shadows, fname) {\\n            match lookup_labeled_check_fn(tbl, fname) {\\n              Some(pnames) => labeled_name_check_call(fname, fname_off, args, pnames, errors),\\n              None => ()\\n            }\\n          } else {\\n            ()\\n          }\\n        },\\n        _ => ()\\n      }\\n    },\\n    ELabeledArg(_, _, v) => labeled_name_check_expr(v, tbl, shadows, errors),\\n    EBinOp(_, l, r) => {\\n      labeled_name_check_expr(l, tbl, shadows, errors)\\n      labeled_name_check_expr(r, tbl, shadows, errors)\\n    },\\n    EUnaryOp(_, inner) => labeled_name_check_expr(inner, tbl, shadows, errors),\\n    ETuple(items) => {\\n      let mut i = 0\\n      while i < Array::length(items) {\\n        labeled_name_check_expr(Array::get(items, i), tbl, shadows, errors)\\n        i = i + 1\\n      }\\n    },\\n    EArray(items) => {\\n      let mut i = 0\\n      while i < Array::length(items) {\\n        labeled_name_check_expr(Array::get(items, i), tbl, shadows, errors)\\n        i = i + 1\\n      }\\n    },\\n    ESpread(inner) => labeled_name_check_expr(inner, tbl, shadows, errors),\\n    ERecord(_, fields, _) => {\\n      let mut i = 0\\n      while i < Array::length(fields) {\\n        let (_, fv) = Array::get(fields, i)\\n        labeled_name_check_expr(fv, tbl, shadows, errors)\\n        i = i + 1\\n      }\\n    },\\n    EMap(pairs) => {\\n      let mut i = 0\\n      while i < Array::length(pairs) {\\n        let (_, pv) = Array::get(pairs, i)\\n        labeled_name_check_expr(pv, tbl, shadows, errors)\\n        i = i + 1\\n      }\\n    },\\n    EIf(cnd, thn, els) => {\\n      labeled_name_check_expr(cnd, tbl, shadows, errors)\\n      labeled_name_check_expr(thn, tbl, shadows, errors)\\n      labeled_name_check_expr(els, tbl, shadows, errors)\\n    },\\n    ELet(name, v, b, _) => {\\n      labeled_name_check_expr(v, tbl, shadows, errors)\\n      let mark = Array::length(shadows)\\n      Array::push(shadows, name)\\n      labeled_name_check_expr(b, tbl, shadows, errors)\\n      Array::truncate(shadows, mark)\\n    },\\n    ELetRec(name, v, b) => {\\n      let mark = Array::length(shadows)\\n      Array::push(shadows, name)\\n      labeled_name_check_expr(v, tbl, shadows, errors)\\n      labeled_name_check_expr(b, tbl, shadows, errors)\\n      Array::truncate(shadows, mark)\\n    },\\n    ELetMut(name, v, b, _) => {\\n      labeled_name_check_expr(v, tbl, shadows, errors)\\n      let mark = Array::length(shadows)\\n      Array::push(shadows, name)\\n      labeled_name_check_expr(b, tbl, shadows, errors)\\n      Array::truncate(shadows, mark)\\n    },\\n    EAssign(_, v, k) => {\\n      labeled_name_check_expr(v, tbl, shadows, errors)\\n      labeled_name_check_expr(k, tbl, shadows, errors)\\n    },\\n    EAssignOp(_, _, v, k) => {\\n      labeled_name_check_expr(v, tbl, shadows, errors)\\n      labeled_name_check_expr(k, tbl, shadows, errors)\\n    },\\n    ESeq(a, b) => {\\n      labeled_name_check_expr(a, tbl, shadows, errors)\\n      labeled_name_check_expr(b, tbl, shadows, errors)\\n    },\\n    EMatch(scrut, arms) => {\\n      labeled_name_check_expr(scrut, tbl, shadows, errors)\\n      let mut i = 0\\n      while i < Array::length(arms) {\\n        let (ap, ab) = Array::get(arms, i)\\n        let mark = Array::length(shadows)\\n        labeled_walk_pat_binds(ap, shadows)\\n        labeled_name_check_expr(ab, tbl, shadows, errors)\\n        Array::truncate(shadows, mark)\\n        i = i + 1\\n      }\\n    },\\n    EHandle(scrut, arms) => {\\n      labeled_name_check_expr(scrut, tbl, shadows, errors)\\n      let mut i = 0\\n      while i < Array::length(arms) {\\n        let (ap, ab) = Array::get(arms, i)\\n        let mark = Array::length(shadows)\\n        labeled_walk_pat_binds(ap, shadows)\\n        labeled_name_check_expr(ab, tbl, shadows, errors)\\n        Array::truncate(shadows, mark)\\n        i = i + 1\\n      }\\n    },\\n    EWhile(cnd, body) => {\\n      labeled_name_check_expr(cnd, tbl, shadows, errors)\\n      labeled_name_check_expr(body, tbl, shadows, errors)\\n    },\\n    ELoop(inits, body) => {\\n      let mut i = 0\\n      while i < Array::length(inits) {\\n        let (_, iv) = Array::get(inits, i)\\n        labeled_name_check_expr(iv, tbl, shadows, errors)\\n        i = i + 1\\n      }\\n      let mark = Array::length(shadows)\\n      let mut pi = 0\\n      while pi < Array::length(inits) {\\n        let (pname, _) = Array::get(inits, pi)\\n        Array::push(shadows, pname)\\n        pi = pi + 1\\n      }\\n      labeled_name_check_expr(body, tbl, shadows, errors)\\n      Array::truncate(shadows, mark)\\n    },\\n    EForIn(name, idx, iter, body) => {\\n      labeled_name_check_expr(iter, tbl, shadows, errors)\\n      let mark = Array::length(shadows)\\n      Array::push(shadows, name)\\n      match idx {\\n        Some(ix) => Array::push(shadows, ix),\\n        None => ()\\n      }\\n      labeled_name_check_expr(body, tbl, shadows, errors)\\n      Array::truncate(shadows, mark)\\n    },\\n    EFn(_, _, fparams, _, _, body) => {\\n      let mark = Array::length(shadows)\\n      let mut pi = 0\\n      while pi < Array::length(fparams) {\\n        let (pn, _) = Array::get(fparams, pi)\\n        Array::push(shadows, labeled_param_base_name(pn))\\n        pi = pi + 1\\n      }\\n      labeled_name_check_expr(body, tbl, shadows, errors)\\n      Array::truncate(shadows, mark)\\n    },\\n    EDot(obj, _, _, _) => labeled_name_check_expr(obj, tbl, shadows, errors),\\n    EReturn(inner) => labeled_name_check_expr(inner, tbl, shadows, errors),\\n    EBreak(opt) => match opt {\\n      Some(inner) => labeled_name_check_expr(inner, tbl, shadows, errors),\\n      None => ()\\n    },\\n    EContinue(exprs) => {\\n      let mut i = 0\\n      while i < Array::length(exprs) {\\n        labeled_name_check_expr(Array::get(exprs, i), tbl, shadows, errors)\\n        i = i + 1\\n      }\\n    },\\n    _ => ()\\n  }\\n}\\n\\nfn labeled_name_check_stmt(stmt: Stmt, tbl: Array[(String, Array[String])], errors: Array[String]) -> Unit {\\n  match stmt {\\n    SLet(_, _, _, _, body) => labeled_name_check_expr(body, tbl, Array::slice([\\n      \\\"\\\"\\n    ], 0, 0), errors),\\n    SLetMut(_, _, body) => labeled_name_check_expr(body, tbl, Array::slice([\\n      \\\"\\\"\\n    ], 0, 0), errors),\\n    STest(_, body) => labeled_name_check_expr(body, tbl, Array::slice([\\n      \\\"\\\"\\n    ], 0, 0), errors),\\n    SBench(_, body) => labeled_name_check_expr(body, tbl, Array::slice([\\n      \\\"\\\"\\n    ], 0, 0), errors),\\n    SExpr(e) => labeled_name_check_expr(e, tbl, Array::slice([\\n      \\\"\\\"\\n    ], 0, 0), errors),\\n    SLetPat(_, e) => labeled_name_check_expr(e, tbl, Array::slice([\\n      \\\"\\\"\\n    ], 0, 0), errors),\\n    SModule(_, _, ms) => {\\n      let mut i = 0\\n      while i < Array::length(ms) {\\n        labeled_name_check_stmt(Array::get(ms, i), tbl, errors)\\n        i = i + 1\\n      }\\n    },\\n    _ => ()\\n  }\\n}\\n\\nfn check_labeled_arg_names_stmts(stmts: Array[Stmt], errors: Array[String]) -> Unit {\\n  let tbl = collect_labeled_check_fns(stmts)\\n  if Array::length(tbl) == 0 {\\n    ()\\n  } else {\\n    let mut i = 0\\n    while i < Array::length(stmts) {\\n      labeled_name_check_stmt(Array::get(stmts, i), tbl, errors)\\n      i = i + 1\\n    }\\n  }\\n}\\n\\nexport fn check_program(stmts: Array[Stmt]) -> TypeEnv with { Error } {\\n  // #760(2): make `Result` (Ok/Err) resolvable standalone — append its enum\\n  // declaration unless already declared/imported. Must run before checking so\\n  // `Result::Ok` / bare `Ok` / `Result[T, E]` annotations resolve on the\\n  // FS-compile path (which type-checks before the codegen desugar runs).\\n  inject_prelude_result(stmts)\\n  // Rank-1 method generics (#684): re-attach trait-method `[X: Bound]` binders\\n  // to impl free functions before checking, so `X::method` in an impl body\\n  // resolves on every path (the FS-compile path type-checks before the codegen\\n  // desugar runs). In-place + idempotent + inert without a method-level binder.\\n  inject_trait_method_generics(stmts)\\n  // #635: lower `let*`/`?` railway sentinels (`__try_bind`/`__try_op`) by the\\n  // operand's head type BEFORE checking, so the checker never sees the\\n  // sentinels (the codegen-time desugar runs later, but the FS-compile path\\n  // type-checks first). In-place, idempotent, inert without `let*`/`?`.\\n  desugar_railway_binds(stmts)\\n  // #986: reorder fully-labeled calls into declared parameter order BEFORE\\n  // checking, so the checker unifies each labeled argument against the same\\n  // parameter position codegen will bind it to (the codegen-time desugar runs\\n  // this pass again later — it is in-place and idempotent). Without this the\\n  // checker would see `add(y=2, x=1)` in call order while codegen binds the\\n  // reordered form.\\n  desugar_labeled_args(stmts)\\n  let empty_defs = Array::slice([\\n    TDAlias(\\\"_dummy\\\", Array::slice([\\n      \\\"\\\"\\n    ], 0, 0), CtUnit)\\n  ], 0, 0)\\n  let seeded_raw_env = if trait_defined(EnvEmpty, \\\"Eq\\\") {\\n    EnvEmpty\\n  } else {\\n    register_builtin_traits(EnvEmpty)\\n  }\\n  let seeded_env = env_cache(seeded_raw_env)\\n  let errors = ArrayBuilder::new()\\n  let frozen_errors = ArrayBuilder::freeze(errors)\\n  let tytab = Array::slice([\\n    (0, CtUnit)\\n  ], 0, 0)\\n  // #986: labeled-argument name validation (unknown / out-of-order labels).\\n  // Must run after desugar_labeled_args above.\\n  check_labeled_arg_names_stmts(stmts, frozen_errors)\\n  let (env, final_s, _) = check_stmts(stmts, 0, seeded_env, empty_defs, SubstEmpty, 0, frozen_errors, tytab)\\n  check_program_bounds(env, final_s, frozen_errors)\\n  collect_async_effect_errors(stmts, env, frozen_errors)\\n  if Array::length(frozen_errors) > 0 {\\n    throw(Array::get(frozen_errors, 0))\\n  }\\n  env\\n}\\n\\n// Collecting variant of check_program for typed hover (vibe type-at): runs the\\n// same inference but RETURNS the recorded (offset, Type) table plus the FINAL\\n// substitution (check_stmts' 2nd value), instead of the TypeEnv. It degrades\\n// gracefully: any type error is swallowed and whatever table was collected so\\n// far is returned, so hovering inside a partially-bad file still resolves the\\n// names that were checked before the error. The table holds RAW (pre-final\\n// subst) types; callers resolve via subst_apply(finalSubst, ty).\\nexport fn check_program_type_table(stmts: Array[Stmt]) -> (Array[(Int, Type)], Subst) with { Error } {\\n  let empty_defs = Array::slice([\\n    TDAlias(\\\"_dummy\\\", Array::slice([\\n      \\\"\\\"\\n    ], 0, 0), CtUnit)\\n  ], 0, 0)\\n  let seeded_raw_env = if trait_defined(EnvEmpty, \\\"Eq\\\") {\\n    EnvEmpty\\n  } else {\\n    register_builtin_traits(EnvEmpty)\\n  }\\n  let seeded_env = env_cache(seeded_raw_env)\\n  let errors = ArrayBuilder::new()\\n  let frozen_errors = ArrayBuilder::freeze(errors)\\n  let tytab = Array::slice([\\n    (0, CtUnit)\\n  ], 0, 0)\\n  handle {\\n    let (_, final_s, _) = check_stmts(stmts, 0, seeded_env, empty_defs, SubstEmpty, 0, frozen_errors, tytab)\\n    (tytab, final_s)\\n  } with Error {\\n    Throw(_) => (tytab, SubstEmpty)\\n  }\\n}\\n\\nexport fn check_program_with_env(stmts: Array[Stmt], initial_env: TypeEnv) -> TypeEnv with { Error } {\\n  match initial_env {\\n    EnvEmpty => check_program(stmts),\\n    _ => {\\n      inject_prelude_result(stmts)\\n      inject_trait_method_generics(stmts)\\n      // #635: lower `let*`/`?` railway sentinels before checking (see\\n      // check_program). This path checks each imported/entry file pre-codegen.\\n      desugar_railway_binds(stmts)\\n      // #986: reorder fully-labeled calls before checking (see check_program).\\n      desugar_labeled_args(stmts)\\n      let empty_defs = Array::slice([\\n        TDAlias(\\\"_dummy\\\", Array::slice([\\n      \\\"\\\"\\n    ], 0, 0), CtUnit)\\n      ], 0, 0)\\n      let cached_env = env_cache(initial_env)\\n      let seeded_raw_env = if trait_defined(cached_env, \\\"Eq\\\") {\\n        cached_env\\n      } else {\\n        register_builtin_traits(cached_env)\\n      }\\n      let seeded_env = env_cache(seeded_raw_env)\\n      let errors = ArrayBuilder::new()\\n      let frozen_errors = ArrayBuilder::freeze(errors)\\n      let tytab = Array::slice([\\n        (0, CtUnit)\\n      ], 0, 0)\\n      // #986: labeled-argument name validation (see check_program).\\n      check_labeled_arg_names_stmts(stmts, frozen_errors)\\n      let (env, _, _) = check_stmts(stmts, 0, seeded_env, empty_defs, SubstEmpty, 0, frozen_errors, tytab)\\n      collect_async_effect_errors(stmts, env, frozen_errors)\\n      if Array::length(frozen_errors) > 0 {\\n        throw(Array::get(frozen_errors, 0))\\n      }\\n      env\\n    }\\n  }\\n}\\n\")\n}\n\nlet cli_adapter_source_48 = () -> (String, String) {\n  (\"lib/@vibe/compiler/checker/index.vibe\",\n\"//# Imports\\n\\n// Pure re-export facade. (This file used to ALSO import check_* and then\\n// re-declare everything in bare `export { ... }` blocks; a bare export of a\\n// name with no local def resolves to \\\"undefined variable (local)\\\" under the\\n// FS merge — the flat bundle's first-match hid it. #726.)\\n\\nexport ./builtins.vibe {\\n  lookup_builtin\\n}\\n\\nexport ./checker.vibe {\\n  check_expr\\n}\\n\\nexport ./checker_pattern.vibe {\\n  check_pattern, pat_has_unsupported_or_binding\\n}\\n\\nexport ./checker_resolve.vibe {\\n  resolve_type_expr\\n}\\n\\nexport ./checker_stmt.vibe {\\n  check_program, check_program_type_table, check_program_with_env, check_stmts\\n}\\n\")\n}\n\nlet cli_adapter_source_49 = () -> (String, String) {\n  (\"lib/@vibe/compiler/builtin_name.vibe\",\n\"//# Functions\\n\\nexport fn canonical_builtin_name(name: String) -> String {\\n  match name {\\n    \\\"Fs::ReadFile\\\" => \\\"Fs::read_file\\\",\\n    \\\"Fs::WriteFile\\\" => \\\"Fs::write_file\\\",\\n    \\\"Fs::ReadBytes\\\" => \\\"Fs::read_bytes\\\",\\n    \\\"Fs::WriteBytes\\\" => \\\"Fs::write_bytes\\\",\\n    \\\"Fs::Exists\\\" => \\\"Fs::exists\\\",\\n    \\\"Fs::StatToken\\\" => \\\"Fs::stat_token\\\",\\n    \\\"Fs::ReadDir\\\" => \\\"Fs::readdir\\\",\\n    \\\"Fs::IsDir\\\" => \\\"Fs::is_dir\\\",\\n    \\\"Fs::IsFile\\\" => \\\"Fs::is_file\\\",\\n    \\\"Fs::Mkdir\\\" => \\\"Fs::mkdir\\\",\\n    \\\"Fs::MkdirP\\\" => \\\"Fs::mkdir_p\\\",\\n    \\\"Fs::Getcwd\\\" => \\\"Fs::getcwd\\\",\\n    \\\"Fs::Chdir\\\" => \\\"Fs::chdir\\\",\\n    \\\"Fs::Remove\\\" => \\\"Fs::remove\\\",\\n    \\\"Fs::Copy\\\" => \\\"Fs::copy\\\",\\n    \\\"Fs::Append\\\" => \\\"Fs::append\\\",\\n    \\\"Fs::Rename\\\" => \\\"Fs::rename\\\",\\n    \\\"Env::Get\\\" => \\\"Env::get\\\",\\n    \\\"Env::ArgsLen\\\" => \\\"Env::args_len\\\",\\n    \\\"Env::ArgsGet\\\" => \\\"Env::args_get\\\",\\n    \\\"Profiler::NowUs\\\" => \\\"Profiler::now_us\\\",\\n    \\\"Profiler::HeapBytes\\\" => \\\"Profiler::heap_bytes\\\",\\n    _ => name\\n  }\\n}\\n\")\n}\n\nlet cli_adapter_source_50 = () -> (String, String) {\n  (\"lib/@vibe/compiler/codegen/wasm_emit/index.vibe\",\n\"export ./sections.vibe {\\n  emit_header, emit_func_type, emit_type_section_multi, emit_type_section,\\n  emit_function_section, emit_name, emit_export_section_multi, emit_export_section,\\n  emit_memory_section, emit_code_section, emit_code_section_with_locals,\\n  emit_i32_const, emit_end, emit_func_type_raw, emit_import_section_func,\\n  emit_data_section, emit_global_section_i32_mut, emit_global_get, emit_global_set,\\n  emit_heap_memory_grow_check, emit_export_memory, emit_exports_with_memory, emit_exports_full,\\n  emit_vibe_abi_custom_section, emit_function_name_section\\n}\\n\\nexport ./instructions.vibe {\\n  emit_local_get, emit_local_set, emit_local_tee,\\n  emit_i64_const, emit_i64_add, emit_i64_sub, emit_i64_mul, emit_i64_div_s,\\n  emit_i64_rem_s, emit_i64_and, emit_i64_or, emit_i64_xor, emit_i64_shl,\\n  emit_i64_shr_s, emit_i64_eq, emit_i64_ne, emit_i64_lt_s, emit_i64_gt_s,\\n  emit_i64_le_s, emit_i64_ge_s, emit_i64_eqz, emit_call, emit_drop,\\n  emit_return, emit_block_void, emit_block_i64, emit_loop_void, emit_if_void,\\n  emit_if_i64, emit_else, emit_br, emit_br_if, emit_i64_extend_i32_s,\\n  emit_i32_wrap_i64, emit_i32_add, emit_i32_store, emit_i64_store, emit_i32_load,\\n  emit_i32_store8, emit_i32_load8_u, emit_f64_const_bits, emit_f64_const_lohi, emit_f64_add,\\n  emit_f64_sub, emit_f64_mul, emit_f64_div, emit_f64_eq, emit_f64_ne,\\n  emit_f64_lt, emit_f64_gt, emit_f64_le, emit_f64_ge, emit_f64_neg,\\n  emit_f64_abs, emit_f64_ceil, emit_f64_floor, emit_f64_max, emit_f64_min,\\n  emit_i64_reinterpret_f64, emit_f64_reinterpret_i64, emit_i64_trunc_f64_s,\\n  emit_f64_convert_i64_s, emit_call_indirect, emit_table_section_funcref,\\n  emit_element_section_active, emit_struct_type_raw, emit_struct_new,\\n  emit_struct_get, emit_struct_set, emit_ref_func, emit_call_ref, emit_ref_null\\n}\\n\\nexport ./builders.vibe {\\n  build_add_module, build_call_module, build_arithmetic_module,\\n  build_fibonacci_module, build_factorial_module, build_hello_module,\\n  string_to_data, emit_data_section_multi, build_print_string_module\\n}\\n\\nexport ./simd.vibe {\\n  emit_v128_load, emit_v128_store, emit_i8x16_splat, emit_i8x16_eq,\\n  emit_i8x16_le_u, emit_i8x16_ge_u, emit_i8x16_swizzle,\\n  emit_i8x16_sub, emit_i8x16_min_u,\\n  emit_v128_any_true, emit_i8x16_all_true, emit_i8x16_bitmask,\\n  emit_v128_and, emit_v128_or, emit_v128_not,\\n  emit_v128_const, emit_v128_const_zero, emit_v128_const_splat_byte\\n}\\n\\nexport ./simd_patterns.vibe {\\n  emit_simd_memcmp_16, emit_simd_find_byte_16,\\n  emit_scalar_memcmp_16_unrolled, emit_scalar_find_byte_16_unrolled\\n}\\n\")\n}\n\nlet cli_adapter_source_51 = () -> (String, String) {\n  (\"lib/@vibe/compiler/codegen/wasm_emit/sections.vibe\",\n\"//# Imports\\n\\nexport ./base.vibe {\\n  emit_code_section, emit_code_section_with_locals, emit_end, emit_export_section, emit_export_section_multi, emit_func_type, emit_function_section, emit_header, emit_i32_const, emit_memory_section, emit_name, emit_type_section, emit_type_section_multi\\n}\\n\\nexport ./extra.vibe {\\n  emit_data_section, emit_export_memory, emit_exports_full, emit_exports_with_memory, emit_func_type_raw, emit_global_get, emit_global_section_i32_mut, emit_global_set, emit_heap_memory_grow_check, emit_import_section_func\\n}\\n\\nexport ./metadata.vibe {\\n  emit_vibe_abi_custom_section, emit_function_name_section\\n}\\n\\n//# Misc\\n\\nexport {\\n  emit_end, emit_name, emit_header, emit_func_type, emit_i32_const, emit_global_get, emit_global_set, emit_heap_memory_grow_check, emit_code_section, emit_data_section, emit_exports_full, emit_type_section, emit_export_memory, emit_func_type_raw, emit_export_section, emit_memory_section, emit_function_section, emit_type_section_multi, emit_exports_with_memory, emit_import_section_func, emit_export_section_multi, emit_global_section_i32_mut, emit_code_section_with_locals, emit_vibe_abi_custom_section, emit_function_name_section\\n}\\n\")\n}\n\nlet cli_adapter_source_52 = () -> (String, String) {\n  (\"lib/@vibe/compiler/codegen/wasm_emit/metadata.vibe\",\n\"//# Imports\\n\\nimport ../../core {\\n  bytebuf_new, bytebuf_push, bytebuf_push_section, bytebuf_push_string, leb128_encode_u32\\n}\\n\\n//# Functions\\n\\n// Emit the standard WebAssembly \\\"name\\\" custom section with a function-names\\n// subsection (id 1) naming `count` consecutive functions starting at\\n// `base_index`. Custom sections are ignored at execution time, so this only\\n// improves tooling/trace readability (e.g. wasm backtraces show `main` instead\\n// of `<wasm function N>`). This is debugger P0 groundwork (ADR-0035 /\\n// docs/release-roadmap.md テーマ3): a source-line map can be layered on later.\\nexport fn emit_function_name_section(out: Bytes, names: Array[String], base_index: Int) -> Unit {\\n  let count = Array::length(names)\\n  if count == 0 {\\n    ()\\n  } else {\\n    let content = bytebuf_new()\\n    bytebuf_push_string(content, \\\"name\\\")\\n    // function-names subsection: vec of (funcidx, name), funcidx ascending.\\n    let namemap = bytebuf_new()\\n    leb128_encode_u32(namemap, count)\\n    let mut i = 0\\n    while i < count {\\n      leb128_encode_u32(namemap, base_index + i)\\n      bytebuf_push_string(namemap, Array::get(names, i))\\n      i = i + 1\\n    }\\n    bytebuf_push_section(content, 1, namemap)\\n    bytebuf_push_section(out, 0, content)\\n  }\\n}\\n\\nfn emit_ascii_payload(buf: Bytes, text: String) -> Unit {\\n  let len = String::length(text)\\n  let mut i = 0\\n  while i < len {\\n    bytebuf_push(buf, String::char_code_at(text, i))\\n    i = i + 1\\n  }\\n}\\n\\nexport fn emit_vibe_abi_custom_section(out: Bytes, host_import_abi: String) -> Unit {\\n  let content = bytebuf_new()\\n  bytebuf_push_string(content, \\\"vibe.abi\\\")\\n  emit_ascii_payload(content, \\\"version=1\\\\n\\\")\\n  emit_ascii_payload(content, String::concat(\\\"host_import_abi=\\\", host_import_abi))\\n  emit_ascii_payload(content, \\\"\\\\n\\\")\\n  bytebuf_push_section(out, 0, content)\\n}\\n\")\n}\n\nlet cli_adapter_source_53 = () -> (String, String) {\n  (\"lib/@vibe/compiler/codegen/wasm_emit/base.vibe\",\n\"//# Imports\\n\\nexport ./code_helpers.vibe {\\n  emit_code_section, emit_code_section_with_locals, emit_end, emit_i32_const, emit_memory_section\\n}\\n\\nexport ./header_types.vibe {\\n  emit_export_section, emit_export_section_multi, emit_func_type, emit_function_section, emit_header, emit_name, emit_type_section, emit_type_section_multi\\n}\\n\\n//# Misc\\n\\nexport {\\n  emit_end, emit_name, emit_header, emit_func_type, emit_i32_const, emit_code_section, emit_type_section, emit_export_section, emit_memory_section, emit_function_section, emit_type_section_multi, emit_export_section_multi, emit_code_section_with_locals\\n}\\n\")\n}\n\nlet cli_adapter_source_54 = () -> (String, String) {\n  (\"lib/@vibe/compiler/codegen/wasm_emit/header_types.vibe\",\n\"//# Imports\\n\\nexport ./header_core.vibe {\\n  emit_func_type, emit_header, emit_type_section, emit_type_section_multi\\n}\\n\\nexport ./header_exports.vibe {\\n  emit_export_section, emit_export_section_multi, emit_function_section, emit_name\\n}\\n\\n//# Misc\\n\\nexport {\\n  emit_name, emit_header, emit_func_type, emit_type_section, emit_export_section, emit_function_section, emit_type_section_multi, emit_export_section_multi\\n}\\n\")\n}\n\nlet cli_adapter_source_55 = () -> (String, String) {\n  (\"lib/@vibe/compiler/codegen/wasm_emit/header_core.vibe\",\n\"//# Imports\\n\\nexport ./header_magic.vibe {\\n  emit_header\\n}\\n\\nexport ./header_type_sections.vibe {\\n  emit_func_type, emit_type_section, emit_type_section_multi\\n}\\n\\n//# Misc\\n\\nexport {\\n  emit_header, emit_func_type, emit_type_section, emit_type_section_multi\\n}\\n\")\n}\n\nlet cli_adapter_source_56 = () -> (String, String) {\n  (\"lib/@vibe/compiler/codegen/wasm_emit/header_magic.vibe\",\n\"//# Imports\\n\\nimport ../../core {\\n  bytebuf_push, bytebuf_push3\\n}\\n\\n//# Functions\\n\\nexport fn emit_header(buf: Bytes) -> Unit {\\n  bytebuf_push3(buf, 0, 97, 115)\\n  bytebuf_push3(buf, 109, 1, 0)\\n  bytebuf_push(buf, 0)\\n  bytebuf_push(buf, 0)\\n}\\n\")\n}\n\nlet cli_adapter_source_57 = () -> (String, String) {\n  (\"lib/@vibe/compiler/codegen/wasm_emit/header_type_sections.vibe\",\n\"//# Imports\\n\\nimport ../../core {\\n  bytebuf_new, bytebuf_push, bytebuf_push_section, bytebuf_push_vec_header, leb128_encode_u32\\n}\\n\\n//# Functions\\n\\nexport fn emit_func_type(buf: Bytes, param_count: Int, result_count: Int) -> Unit {\\n  bytebuf_push(buf, 96)\\n  leb128_encode_u32(buf, param_count)\\n  let mut i = 0\\n  while i < param_count {\\n    bytebuf_push(buf, 126)\\n    i = i + 1\\n  }\\n  leb128_encode_u32(buf, result_count)\\n  let mut j = 0\\n  while j < result_count {\\n    bytebuf_push(buf, 126)\\n    j = j + 1\\n  }\\n}\\n\\nexport fn emit_type_section_multi(out: Bytes, type_defs: Array[Int]) -> Unit {\\n  let count = Array::length(type_defs) / 2\\n  let content = bytebuf_new()\\n  bytebuf_push_vec_header(content, count)\\n  let mut i = 0\\n  while i < count {\\n    emit_func_type(content, Array::get(type_defs, i * 2), Array::get(type_defs, (i * 2) + 1))\\n    i = i + 1\\n  }\\n  bytebuf_push_section(out, 1, content)\\n}\\n\\nexport fn emit_type_section(out: Bytes, param_count: Int, result_count: Int) -> Unit {\\n  let type_defs = Array::slice([\\n    0\\n  ], 0, 0)\\n  Array::push(type_defs, param_count)\\n  Array::push(type_defs, result_count)\\n  emit_type_section_multi(out, type_defs)\\n}\\n\")\n}\n\nlet cli_adapter_source_58 = () -> (String, String) {\n  (\"lib/@vibe/compiler/codegen/wasm_emit/header_exports.vibe\",\n\"//# Imports\\n\\nimport ../../core {\\n  bytebuf_new, bytebuf_push, bytebuf_push_section, bytebuf_push_string, bytebuf_push_vec_header, leb128_encode_u32\\n}\\n\\n//# Functions\\n\\nexport fn emit_name(buf: Bytes, name: String) -> Unit {\\n  bytebuf_push_string(buf, name)\\n}\\n\\nexport fn emit_function_section(out: Bytes, type_indices: Array[Int]) -> Unit {\\n  let content = bytebuf_new()\\n  bytebuf_push_vec_header(content, Array::length(type_indices))\\n  let mut i = 0\\n  while i < Array::length(type_indices) {\\n    leb128_encode_u32(content, Array::get(type_indices, i))\\n    i = i + 1\\n  }\\n  bytebuf_push_section(out, 3, content)\\n}\\n\\nexport fn emit_export_section_multi(out: Bytes, names: Array[String], func_indices: Array[Int]) -> Unit {\\n  let count = Array::length(names)\\n  let content = bytebuf_new()\\n  bytebuf_push_vec_header(content, count)\\n  let mut i = 0\\n  while i < count {\\n    emit_name(content, Array::get(names, i))\\n    bytebuf_push(content, 0)\\n    leb128_encode_u32(content, Array::get(func_indices, i))\\n    i = i + 1\\n  }\\n  bytebuf_push_section(out, 7, content)\\n}\\n\\nexport fn emit_export_section(out: Bytes, name: String, func_idx: Int) -> Unit {\\n  emit_export_section_multi(out, [\\n    name\\n  ], [\\n    func_idx\\n  ])\\n}\\n\")\n}\n\nlet cli_adapter_source_59 = () -> (String, String) {\n  (\"lib/@vibe/compiler/codegen/wasm_emit/code_helpers.vibe\",\n\"//# Imports\\n\\nimport ../../core {\\n  bytebuf_length, bytebuf_new, bytebuf_push, bytebuf_push_buf, bytebuf_push_opcode_s64, bytebuf_push_section, bytebuf_push_vec_header, leb128_encode_u32\\n}\\n\\n//# Functions\\n\\nexport fn emit_end(buf: Bytes) -> Unit {\\n  bytebuf_push(buf, 11)\\n}\\n\\nexport fn emit_i32_const(buf: Bytes, value: Int) -> Unit {\\n  bytebuf_push_opcode_s64(buf, 65, value)\\n}\\n\\nexport fn emit_code_section(out: Bytes, bodies: Array[Bytes]) -> Unit {\\n  let content = bytebuf_new()\\n  bytebuf_push_vec_header(content, Array::length(bodies))\\n  let mut i = 0\\n  while i < Array::length(bodies) {\\n    let body = Array::get(bodies, i)\\n    let func_buf = bytebuf_new()\\n    leb128_encode_u32(func_buf, 0)\\n    bytebuf_push_buf(func_buf, body)\\n    bytebuf_push(func_buf, 11)\\n    leb128_encode_u32(content, bytebuf_length(func_buf))\\n    bytebuf_push_buf(content, func_buf)\\n    i = i + 1\\n  }\\n  bytebuf_push_section(out, 10, content)\\n}\\n\\nexport fn emit_memory_section(out: Bytes, min_pages: Int) -> Unit {\\n  let content = bytebuf_new()\\n  bytebuf_push_vec_header(content, 1)\\n  bytebuf_push(content, 0)\\n  leb128_encode_u32(content, min_pages)\\n  bytebuf_push_section(out, 5, content)\\n}\\n\\nexport fn emit_code_section_with_locals(out: Bytes, bodies: Array[Bytes], local_counts: Array[Int]) -> Unit {\\n  let content = bytebuf_new()\\n  bytebuf_push_vec_header(content, Array::length(bodies))\\n  let mut i = 0\\n  while i < Array::length(bodies) {\\n    let body = Array::get(bodies, i)\\n    let num_locals = Array::get(local_counts, i)\\n    let func_buf = bytebuf_new()\\n    if num_locals == 0 {\\n      leb128_encode_u32(func_buf, 0)\\n    } else {\\n      leb128_encode_u32(func_buf, 1)\\n      leb128_encode_u32(func_buf, num_locals)\\n      bytebuf_push(func_buf, 126)\\n    }\\n    bytebuf_push_buf(func_buf, body)\\n    bytebuf_push(func_buf, 11)\\n    leb128_encode_u32(content, bytebuf_length(func_buf))\\n    bytebuf_push_buf(content, func_buf)\\n    i = i + 1\\n  }\\n  bytebuf_push_section(out, 10, content)\\n}\\n\")\n}\n\nlet cli_adapter_source_60 = () -> (String, String) {\n  (\"lib/@vibe/compiler/codegen/wasm_emit/extra.vibe\",\n\"//# Imports\\n\\nimport ../../core {\\n  bytebuf_new, bytebuf_push, bytebuf_push2, bytebuf_push_buf, bytebuf_push_opcode_u32, bytebuf_push_section, bytebuf_push_vec_header, leb128_encode_u32\\n}\\n\\nimport ./base.vibe {\\n  emit_end, emit_i32_const, emit_name\\n}\\n\\n//# Functions\\n\\nlet vt_i32 = 127\\n\\nlet sec_data = 11\\n\\nlet type_func = 96\\n\\nlet sec_export = 7\\n\\nlet sec_global = 6\\n\\nlet sec_import = 2\\n\\nlet export_func = 0\\n\\nlet export_memory = 2\\n\\nlet op_global_get = 35\\n\\nlet op_global_set = 36\\n\\nlet op_i32_add = 106\\n\\nlet op_i32_sub = 107\\n\\nlet op_i32_shr_u = 118\\n\\nlet op_i32_gt_u = 75\\n\\nlet op_memory_size = 63\\n\\nlet op_memory_grow = 64\\n\\nlet op_drop = 26\\n\\nlet op_if = 4\\n\\nlet bt_void = 64\\n\\nexport fn emit_global_get(buf: Bytes, idx: Int) -> Unit {\\n  bytebuf_push_opcode_u32(buf, op_global_get, idx)\\n}\\n\\nexport fn emit_heap_memory_grow_check(buf: Bytes) -> Unit {\\n  // Grow memory to `(heap_ptr + 65536) >> 16` pages — i.e. ALWAYS at least one\\n  // page past `heap_ptr`. The previous `+ 65535` rounded to `ceil(heap_ptr /\\n  // 65536)`, which holds only `[0, heap_ptr)`; when `heap_ptr` lands exactly on\\n  // a page boundary that leaves `memory_size == heap_ptr`, and an access at\\n  // `heap_ptr` (the next slot the bump allocator hands out) traps with\\n  // \\\"memory access out of bounds\\\". The `+ 65536` reserves a guard page so\\n  // `heap_ptr` itself is always addressable. Monotonic: never grows LESS than\\n  // before, so it cannot under-allocate.\\n  emit_global_get(buf, 0)\\n  emit_i32_const(buf, 65536)\\n  bytebuf_push(buf, op_i32_add)\\n  emit_i32_const(buf, 16)\\n  bytebuf_push(buf, op_i32_shr_u)\\n  bytebuf_push2(buf, op_memory_size, 0)\\n  bytebuf_push(buf, op_i32_gt_u)\\n  bytebuf_push2(buf, op_if, bt_void)\\n  emit_global_get(buf, 0)\\n  emit_i32_const(buf, 65536)\\n  bytebuf_push(buf, op_i32_add)\\n  emit_i32_const(buf, 16)\\n  bytebuf_push(buf, op_i32_shr_u)\\n  bytebuf_push2(buf, op_memory_size, 0)\\n  bytebuf_push(buf, op_i32_sub)\\n  bytebuf_push2(buf, op_memory_grow, 0)\\n  bytebuf_push(buf, op_drop)\\n  emit_end(buf)\\n}\\n\\nexport fn emit_global_set(buf: Bytes, idx: Int) -> Unit {\\n  bytebuf_push_opcode_u32(buf, op_global_set, idx)\\n}\\n\\nexport fn emit_data_section(out: Bytes, offset: Int, data: Bytes) -> Unit {\\n  let content = bytebuf_new()\\n  bytebuf_push_vec_header(content, 1)\\n  bytebuf_push(content, 0)\\n  emit_i32_const(content, offset)\\n  emit_end(content)\\n  leb128_encode_u32(content, Bytes::length(data))\\n  bytebuf_push_buf(content, data)\\n  bytebuf_push_section(out, sec_data, content)\\n}\\n\\nexport fn emit_exports_full(out: Bytes, fn_names: Array[String], fn_indices: Array[Int], mem_name: String, mem_idx: Int, global_names: Array[String], global_indices: Array[Int]) -> Unit {\\n  let count = Array::length(fn_names) + 1 + Array::length(global_names)\\n  let content = bytebuf_new()\\n  bytebuf_push_vec_header(content, count)\\n  let mut i = 0\\n  while i < Array::length(fn_names) {\\n    emit_name(content, Array::get(fn_names, i))\\n    bytebuf_push(content, export_func)\\n    leb128_encode_u32(content, Array::get(fn_indices, i))\\n    i = i + 1\\n  }\\n  emit_name(content, mem_name)\\n  bytebuf_push(content, export_memory)\\n  leb128_encode_u32(content, mem_idx)\\n  let mut gi = 0\\n  while gi < Array::length(global_names) {\\n    emit_name(content, Array::get(global_names, gi))\\n    bytebuf_push(content, 3)\\n    leb128_encode_u32(content, Array::get(global_indices, gi))\\n    gi = gi + 1\\n  }\\n  bytebuf_push_section(out, sec_export, content)\\n}\\n\\nexport fn emit_export_memory(out: Bytes, name: String, mem_idx: Int) -> Unit {\\n  let content = bytebuf_new()\\n  bytebuf_push_vec_header(content, 1)\\n  emit_name(content, name)\\n  bytebuf_push(content, export_memory)\\n  leb128_encode_u32(content, mem_idx)\\n  bytebuf_push_section(out, sec_export, content)\\n}\\n\\nexport fn emit_func_type_raw(buf: Bytes, param_types: Array[Int], result_types: Array[Int]) -> Unit {\\n  bytebuf_push(buf, type_func)\\n  leb128_encode_u32(buf, Array::length(param_types))\\n  let mut i = 0\\n  while i < Array::length(param_types) {\\n    bytebuf_push(buf, Array::get(param_types, i))\\n    i = i + 1\\n  }\\n  leb128_encode_u32(buf, Array::length(result_types))\\n  let mut j = 0\\n  while j < Array::length(result_types) {\\n    bytebuf_push(buf, Array::get(result_types, j))\\n    j = j + 1\\n  }\\n}\\n\\nexport fn emit_exports_with_memory(out: Bytes, fn_names: Array[String], fn_indices: Array[Int], mem_name: String, mem_idx: Int) -> Unit {\\n  let count = Array::length(fn_names) + 1\\n  let content = bytebuf_new()\\n  bytebuf_push_vec_header(content, count)\\n  let mut i = 0\\n  while i < Array::length(fn_names) {\\n    emit_name(content, Array::get(fn_names, i))\\n    bytebuf_push(content, export_func)\\n    leb128_encode_u32(content, Array::get(fn_indices, i))\\n    i = i + 1\\n  }\\n  emit_name(content, mem_name)\\n  bytebuf_push(content, export_memory)\\n  leb128_encode_u32(content, mem_idx)\\n  bytebuf_push_section(out, sec_export, content)\\n}\\n\\nexport fn emit_import_section_func(out: Bytes, module_name: String, field_name: String, type_idx: Int) -> Unit {\\n  let content = bytebuf_new()\\n  bytebuf_push_vec_header(content, 1)\\n  emit_name(content, module_name)\\n  emit_name(content, field_name)\\n  bytebuf_push(content, export_func)\\n  leb128_encode_u32(content, type_idx)\\n  bytebuf_push_section(out, sec_import, content)\\n}\\n\\nexport fn emit_global_section_i32_mut(out: Bytes, init_value: Int) -> Unit {\\n  let content = bytebuf_new()\\n  bytebuf_push_vec_header(content, 1)\\n  bytebuf_push2(content, vt_i32, 1)\\n  emit_i32_const(content, init_value)\\n  emit_end(content)\\n  bytebuf_push_section(out, sec_global, content)\\n}\\n\")\n}\n\nlet cli_adapter_source_61 = () -> (String, String) {\n  (\"lib/@vibe/compiler/codegen/wasm_emit/instructions.vibe\",\n\"//# Imports\\n\\nimport ../../core {\\n  bytebuf_new, bytebuf_push, bytebuf_push2, bytebuf_push9, bytebuf_push_opcode_s64, bytebuf_push_opcode_u32, bytebuf_push_opcode_u32_u32, bytebuf_push_section, bytebuf_push_vec_header, leb128_encode_u32\\n}\\n\\nimport ./sections.vibe {\\n  emit_end, emit_i32_const\\n}\\n\\n//# Functions\\n\\nlet op_br = 12\\n\\nlet op_if = 4\\n\\nlet bt_i64 = 126\\n\\nlet bt_void = 64\\n\\nexport fn emit_br(buf: Bytes, label: Int) -> Unit {\\n  bytebuf_push_opcode_u32(buf, op_br, label)\\n}\\n\\nlet op_call = 16\\n\\nlet op_drop = 26\\n\\nlet op_else = 5\\n\\nlet op_loop = 3\\n\\nlet op_block = 2\\n\\nlet op_br_if = 13\\n\\nexport fn emit_call(buf: Bytes, func_idx: Int) -> Unit {\\n  bytebuf_push_opcode_u32(buf, op_call, func_idx)\\n}\\n\\nexport fn emit_drop(buf: Bytes) -> Unit {\\n  bytebuf_push(buf, op_drop)\\n}\\n\\nexport fn emit_else(buf: Bytes) -> Unit {\\n  bytebuf_push(buf, op_else)\\n}\\n\\nlet op_f64_eq = 97\\n\\nlet op_f64_ge = 102\\n\\nlet op_f64_gt = 100\\n\\nlet op_f64_le = 101\\n\\nlet op_f64_lt = 99\\n\\nlet op_f64_ne = 98\\n\\nlet op_i64_eq = 81\\n\\nlet op_i64_ne = 82\\n\\nlet op_i64_or = 132\\n\\nlet op_return = 15\\n\\nlet sec_table = 4\\n\\nexport fn emit_br_if(buf: Bytes, label: Int) -> Unit {\\n  bytebuf_push_opcode_u32(buf, op_br_if, label)\\n}\\n\\nlet op_f64_abs = 153\\n\\nlet op_f64_ceil = 155\\n\\nlet op_f64_floor = 156\\n\\nlet op_f64_add = 160\\n\\nlet op_f64_div = 163\\n\\nlet op_f64_max = 165\\n\\nlet op_f64_min = 164\\n\\nlet op_f64_mul = 162\\n\\nlet op_f64_neg = 154\\n\\nlet op_f64_sub = 161\\n\\nlet op_i32_add = 106\\n\\nlet op_i64_add = 124\\n\\nlet op_i64_and = 131\\n\\nlet op_i64_eqz = 80\\n\\nlet op_i64_mul = 126\\n\\nlet op_i64_shl = 134\\n\\nlet op_i64_sub = 125\\n\\nlet op_i64_xor = 133\\n\\nexport fn emit_f64_eq(buf: Bytes) -> Unit {\\n  bytebuf_push(buf, op_f64_eq)\\n}\\n\\nexport fn emit_f64_ge(buf: Bytes) -> Unit {\\n  bytebuf_push(buf, op_f64_ge)\\n}\\n\\nexport fn emit_f64_gt(buf: Bytes) -> Unit {\\n  bytebuf_push(buf, op_f64_gt)\\n}\\n\\nexport fn emit_f64_le(buf: Bytes) -> Unit {\\n  bytebuf_push(buf, op_f64_le)\\n}\\n\\nexport fn emit_f64_lt(buf: Bytes) -> Unit {\\n  bytebuf_push(buf, op_f64_lt)\\n}\\n\\nexport fn emit_f64_ne(buf: Bytes) -> Unit {\\n  bytebuf_push(buf, op_f64_ne)\\n}\\n\\nexport fn emit_i64_eq(buf: Bytes) -> Unit {\\n  bytebuf_push(buf, op_i64_eq)\\n}\\n\\nexport fn emit_i64_ne(buf: Bytes) -> Unit {\\n  bytebuf_push(buf, op_i64_ne)\\n}\\n\\nexport fn emit_i64_or(buf: Bytes) -> Unit {\\n  bytebuf_push(buf, op_i64_or)\\n}\\n\\nexport fn emit_if_i64(buf: Bytes) -> Unit {\\n  bytebuf_push2(buf, op_if, bt_i64)\\n}\\n\\nexport fn emit_return(buf: Bytes) -> Unit {\\n  bytebuf_push(buf, op_return)\\n}\\n\\nlet op_i32_load = 40\\n\\nlet op_i64_ge_s = 89\\n\\nlet op_i64_gt_s = 85\\n\\nlet op_i64_le_s = 87\\n\\nlet op_i64_lt_s = 83\\n\\nlet sec_element = 9\\n\\nexport fn emit_f64_add(buf: Bytes) -> Unit {\\n  bytebuf_push(buf, op_f64_add)\\n}\\n\\nexport fn emit_f64_div(buf: Bytes) -> Unit {\\n  bytebuf_push(buf, op_f64_div)\\n}\\n\\nexport fn emit_f64_mul(buf: Bytes) -> Unit {\\n  bytebuf_push(buf, op_f64_mul)\\n}\\n\\nexport fn emit_f64_neg(buf: Bytes) -> Unit {\\n  bytebuf_push(buf, op_f64_neg)\\n}\\n\\nexport fn emit_f64_sub(buf: Bytes) -> Unit {\\n  bytebuf_push(buf, op_f64_sub)\\n}\\n\\nexport fn emit_f64_abs(buf: Bytes) -> Unit {\\n  bytebuf_push(buf, op_f64_abs)\\n}\\n\\nexport fn emit_f64_ceil(buf: Bytes) -> Unit {\\n  bytebuf_push(buf, op_f64_ceil)\\n}\\n\\nexport fn emit_f64_floor(buf: Bytes) -> Unit {\\n  bytebuf_push(buf, op_f64_floor)\\n}\\n\\nexport fn emit_f64_max(buf: Bytes) -> Unit {\\n  bytebuf_push(buf, op_f64_max)\\n}\\n\\nexport fn emit_f64_min(buf: Bytes) -> Unit {\\n  bytebuf_push(buf, op_f64_min)\\n}\\n\\nexport fn emit_i32_add(buf: Bytes) -> Unit {\\n  bytebuf_push(buf, op_i32_add)\\n}\\n\\nexport fn emit_i64_add(buf: Bytes) -> Unit {\\n  bytebuf_push(buf, op_i64_add)\\n}\\n\\nexport fn emit_i64_and(buf: Bytes) -> Unit {\\n  bytebuf_push(buf, op_i64_and)\\n}\\n\\nexport fn emit_i64_eqz(buf: Bytes) -> Unit {\\n  bytebuf_push(buf, op_i64_eqz)\\n}\\n\\nexport fn emit_i64_mul(buf: Bytes) -> Unit {\\n  bytebuf_push(buf, op_i64_mul)\\n}\\n\\nexport fn emit_i64_shl(buf: Bytes) -> Unit {\\n  bytebuf_push(buf, op_i64_shl)\\n}\\n\\nexport fn emit_i64_sub(buf: Bytes) -> Unit {\\n  bytebuf_push(buf, op_i64_sub)\\n}\\n\\nexport fn emit_i64_xor(buf: Bytes) -> Unit {\\n  bytebuf_push(buf, op_i64_xor)\\n}\\n\\nexport fn emit_if_void(buf: Bytes) -> Unit {\\n  bytebuf_push2(buf, op_if, bt_void)\\n}\\n\\nlet op_i32_store = 54\\n\\nlet op_i64_const = 66\\n\\nlet op_i64_div_s = 127\\n\\nlet op_i64_rem_s = 129\\n\\nlet op_i64_shr_s = 135\\n\\nlet op_local_get = 32\\n\\nlet op_local_set = 33\\n\\nlet op_local_tee = 34\\n\\nlet type_funcref = 112\\n\\nexport fn emit_call_ref(buf: Bytes, type_idx: Int) -> Unit {\\n  bytebuf_push_opcode_u32(buf, 20, type_idx)\\n}\\n\\nexport fn emit_i32_load(buf: Bytes, align: Int, offset: Int) -> Unit {\\n  bytebuf_push_opcode_u32_u32(buf, op_i32_load, align, offset)\\n}\\n\\nexport fn emit_i64_ge_s(buf: Bytes) -> Unit {\\n  bytebuf_push(buf, op_i64_ge_s)\\n}\\n\\nexport fn emit_i64_gt_s(buf: Bytes) -> Unit {\\n  bytebuf_push(buf, op_i64_gt_s)\\n}\\n\\nexport fn emit_i64_le_s(buf: Bytes) -> Unit {\\n  bytebuf_push(buf, op_i64_le_s)\\n}\\n\\nexport fn emit_i64_lt_s(buf: Bytes) -> Unit {\\n  bytebuf_push(buf, op_i64_lt_s)\\n}\\n\\nexport fn emit_ref_func(buf: Bytes, func_idx: Int) -> Unit {\\n  bytebuf_push_opcode_u32(buf, 210, func_idx)\\n}\\n\\nexport fn emit_ref_null(buf: Bytes, heap_type_byte: Int) -> Unit {\\n  bytebuf_push2(buf, 208, heap_type_byte)\\n}\\n\\nlet op_i32_store8 = 58\\n\\nexport fn emit_block_i64(buf: Bytes) -> Unit {\\n  bytebuf_push2(buf, op_block, bt_i64)\\n}\\n\\nexport fn emit_i32_store(buf: Bytes, align: Int, offset: Int) -> Unit {\\n  bytebuf_push_opcode_u32_u32(buf, op_i32_store, align, offset)\\n}\\n\\nexport fn emit_i64_store(buf: Bytes, align: Int, offset: Int) -> Unit {\\n  bytebuf_push_opcode_u32_u32(buf, 55, align, offset)\\n}\\n\\nexport fn emit_i64_const(buf: Bytes, value: Int) -> Unit {\\n  bytebuf_push_opcode_s64(buf, op_i64_const, value)\\n}\\n\\nexport fn emit_i64_div_s(buf: Bytes) -> Unit {\\n  bytebuf_push(buf, op_i64_div_s)\\n}\\n\\nexport fn emit_i64_rem_s(buf: Bytes) -> Unit {\\n  bytebuf_push(buf, op_i64_rem_s)\\n}\\n\\nexport fn emit_i64_shr_s(buf: Bytes) -> Unit {\\n  bytebuf_push(buf, op_i64_shr_s)\\n}\\n\\nexport fn emit_local_get(buf: Bytes, idx: Int) -> Unit {\\n  bytebuf_push_opcode_u32(buf, op_local_get, idx)\\n}\\n\\nexport fn emit_local_set(buf: Bytes, idx: Int) -> Unit {\\n  bytebuf_push_opcode_u32(buf, op_local_set, idx)\\n}\\n\\nexport fn emit_local_tee(buf: Bytes, idx: Int) -> Unit {\\n  bytebuf_push_opcode_u32(buf, op_local_tee, idx)\\n}\\n\\nexport fn emit_loop_void(buf: Bytes) -> Unit {\\n  bytebuf_push2(buf, op_loop, bt_void)\\n}\\n\\nlet op_i32_load8_u = 45\\n\\nexport fn emit_block_void(buf: Bytes) -> Unit {\\n  bytebuf_push2(buf, op_block, bt_void)\\n}\\n\\nexport fn emit_i32_store8(buf: Bytes, align: Int, offset: Int) -> Unit {\\n  bytebuf_push_opcode_u32_u32(buf, op_i32_store8, align, offset)\\n}\\n\\nexport fn emit_struct_get(buf: Bytes, type_idx: Int, field_idx: Int) -> Unit {\\n  bytebuf_push_opcode_u32_u32(buf, 251, 2, type_idx)\\n  leb128_encode_u32(buf, field_idx)\\n}\\n\\nexport fn emit_struct_new(buf: Bytes, type_idx: Int) -> Unit {\\n  bytebuf_push_opcode_u32_u32(buf, 251, 0, type_idx)\\n}\\n\\nexport fn emit_struct_set(buf: Bytes, type_idx: Int, field_idx: Int) -> Unit {\\n  bytebuf_push_opcode_u32_u32(buf, 251, 5, type_idx)\\n  leb128_encode_u32(buf, field_idx)\\n}\\n\\nlet op_i32_wrap_i64 = 167\\n\\nexport fn emit_i32_load8_u(buf: Bytes, align: Int, offset: Int) -> Unit {\\n  bytebuf_push_opcode_u32_u32(buf, op_i32_load8_u, align, offset)\\n}\\n\\nlet op_call_indirect = 17\\n\\nexport fn emit_i32_wrap_i64(buf: Bytes) -> Unit {\\n  bytebuf_push(buf, op_i32_wrap_i64)\\n}\\n\\nexport fn emit_call_indirect(buf: Bytes, type_idx: Int) -> Unit {\\n  bytebuf_push_opcode_u32(buf, op_call_indirect, type_idx)\\n  bytebuf_push(buf, 0)\\n}\\n\\nlet op_i64_trunc_f64_s = 176\\n\\nexport fn emit_f64_const_bits(buf: Bytes, bits: Int) -> Unit {\\n  bytebuf_push9(buf, 68, bits&255, (bits>>8)&255, (bits>>16)&255, (bits>>24)&255, (bits>>32)&255, (bits>>40)&255, (bits>>48)&255, (bits>>56)&255)\\n}\\n\\n// Emit f64.const from the f64 pattern split into its low / high 32 bits\\n// (little-endian: 4 bytes of lo, then 4 bytes of hi). Each half is 0..2^32-1,\\n// so it fits the 62-bit Int — unlike the full pattern, which overflows it\\n// (Blocker-2, ADR-0055). Callers obtain lo/hi via Double::to_i64_bits_lo/_hi.\\nexport fn emit_f64_const_lohi(buf: Bytes, lo: Int, hi: Int) -> Unit {\\n  bytebuf_push9(buf, 68, lo&255, (lo>>8)&255, (lo>>16)&255, (lo>>24)&255, hi&255, (hi>>8)&255, (hi>>16)&255, (hi>>24)&255)\\n}\\n\\nlet op_i64_extend_i32_s = 172\\n\\nexport fn emit_i64_trunc_f64_s(buf: Bytes) -> Unit {\\n  bytebuf_push(buf, op_i64_trunc_f64_s)\\n}\\n\\nexport fn emit_struct_type_raw(buf: Bytes, field_types: Array[Int], field_muts: Array[Int]) -> Unit {\\n  bytebuf_push_opcode_u32(buf, 95, Array::length(field_types))\\n  let mut i = 0\\n  while i < Array::length(field_types) {\\n    bytebuf_push2(buf, Array::get(field_types, i), Array::get(field_muts, i))\\n    i = i + 1\\n  }\\n}\\n\\nlet op_f64_convert_i64_s = 185\\n\\nexport fn emit_i64_extend_i32_s(buf: Bytes) -> Unit {\\n  bytebuf_push(buf, op_i64_extend_i32_s)\\n}\\n\\nexport fn emit_f64_convert_i64_s(buf: Bytes) -> Unit {\\n  bytebuf_push(buf, op_f64_convert_i64_s)\\n}\\n\\nlet op_f64_reinterpret_i64 = 191\\n\\nlet op_i64_reinterpret_f64 = 189\\n\\nexport fn emit_f64_reinterpret_i64(buf: Bytes) -> Unit {\\n  bytebuf_push(buf, op_f64_reinterpret_i64)\\n}\\n\\nexport fn emit_i64_reinterpret_f64(buf: Bytes) -> Unit {\\n  bytebuf_push(buf, op_i64_reinterpret_f64)\\n}\\n\\nexport fn emit_table_section_funcref(out: Bytes, num_entries: Int) -> Unit {\\n  let content = bytebuf_new()\\n  bytebuf_push_vec_header(content, 1)\\n  bytebuf_push2(content, type_funcref, 0)\\n  leb128_encode_u32(content, num_entries)\\n  bytebuf_push_section(out, sec_table, content)\\n}\\n\\nexport fn emit_element_section_active(out: Bytes, func_indices: Array[In