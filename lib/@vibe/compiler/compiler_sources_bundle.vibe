ection_func,\n  emit_local_get,\n  emit_local_set,\n  emit_local_tee,\n  emit_loop_void,\n  emit_memory_section,\n  emit_name,\n  emit_return,\n  emit_table_section_funcref,\n  emit_type_section,\n  emit_type_section_multi,\n  string_to_data\n}\n\n\n\n\n\n\nfn emit_tuple_struct_eq(buf: Bytes, lhs: Expr, rhs: Expr, num: Int, local_names: Array[String], next_local: Int, ctx: CompileCtx, ld: Int, compile_expr_fn: (Bytes, Expr, Array[String], Int, CompileCtx, Int) -> Int with { Error }) -> Int with { Error } {\n  let aptr = next_local\n  Array::push(local_names, \"__eqa\")\n  let bptr = next_local + 1\n  Array::push(local_names, \"__eqb\")\n  let nl1 = compile_expr_fn(buf, lhs, local_names, next_local + 2, ctx, ld)\n  if ctx.enable_rc {\n    emit_i64_const(buf, -2)\n    emit_i64_and(buf)\n  } else {\n    ()\n  }\n  emit_local_set(buf, aptr)\n  let nl2 = compile_expr_fn(buf, rhs, local_names, nl1, ctx, ld)\n  if ctx.enable_rc {\n    emit_i64_const(buf, -2)\n    emit_i64_and(buf)\n  } else {\n    ()\n  }\n  emit_local_set(buf, bptr)\n  let field_off = if ctx.enable_rc {\n    8\n  } else {\n    0\n  }\n  let (eq_fidx, _, _) = resolve_func(ctx.func_table, \"eq\")\n  emit_i64_const(buf, 1)\n  let mut i = 0\n  while i < num {\n    emit_local_get(buf, aptr)\n    emit_i32_wrap_i64(buf)\n    emit_i64_load(buf, 3, field_off + i * 8)\n    emit_local_get(buf, bptr)\n    emit_i32_wrap_i64(buf)\n    emit_i64_load(buf, 3, field_off + i * 8)\n    emit_call(buf, eq_fidx)\n    emit_i64_and(buf)\n    i = i + 1\n  }\n  nl2\n}\n\nfn emit_ctor_struct_eq(buf: Bytes, lhs: Expr, rhs: Expr, fc: Int, local_names: Array[String], next_local: Int, ctx: CompileCtx, ld: Int, compile_expr_fn: (Bytes, Expr, Array[String], Int, CompileCtx, Int) -> Int with { Error }) -> Int with { Error } {\n  let aptr = next_local\n  Array::push(local_names, \"__ceqa\")\n  let bptr = next_local + 1\n  Array::push(local_names, \"__ceqb\")\n  let nl1 = compile_expr_fn(buf, lhs, local_names, next_local + 2, ctx, ld)\n  emit_i64_const(buf, -2)\n  emit_i64_and(buf)\n  emit_local_set(buf, aptr)\n  let nl2 = compile_expr_fn(buf, rhs, local_names, nl1, ctx, ld)\n  emit_i64_const(buf, -2)\n  emit_i64_and(buf)\n  emit_local_set(buf, bptr)\n  emit_local_get(buf, aptr)\n  emit_i32_wrap_i64(buf)\n  emit_i32_load(buf, 2, 0)\n  emit_local_get(buf, bptr)\n  emit_i32_wrap_i64(buf)\n  emit_i32_load(buf, 2, 0)\n  emit_i32_eq(buf)\n  emit_if_i64(buf)\n  let (eq_fidx, _, _) = resolve_func(ctx.func_table, \"eq\")\n  if fc == 63 {\n    let res_l = nl2\n    let cnt_l = nl2 + 1\n    let ii_l = nl2 + 2\n    Array::push(local_names, \"__ceq_res\")\n    Array::push(local_names, \"__ceq_cnt\")\n    Array::push(local_names, \"__ceq_i\")\n    emit_i64_const(buf, 1)\n    emit_local_set(buf, res_l)\n    emit_local_get(buf, aptr)\n    emit_i32_wrap_i64(buf)\n    emit_i32_load(buf, 2, 4)\n    emit_i64_extend_i32_u(buf)\n    emit_local_set(buf, cnt_l)\n    emit_i64_const(buf, 0)\n    emit_local_set(buf, ii_l)\n    emit_block_void(buf)\n    emit_loop_void(buf)\n    emit_local_get(buf, ii_l)\n    emit_local_get(buf, cnt_l)\n    emit_i64_ge_s(buf)\n    emit_br_if(buf, 1)\n    emit_local_get(buf, res_l)\n    emit_local_get(buf, aptr)\n    emit_i32_wrap_i64(buf)\n    emit_local_get(buf, ii_l)\n    emit_i32_wrap_i64(buf)\n    emit_i32_const(buf, 8)\n    emit_i32_mul(buf)\n    emit_i32_add(buf)\n    emit_i64_load(buf, 3, 8)\n    emit_local_get(buf, bptr)\n    emit_i32_wrap_i64(buf)\n    emit_local_get(buf, ii_l)\n    emit_i32_wrap_i64(buf)\n    emit_i32_const(buf, 8)\n    emit_i32_mul(buf)\n    emit_i32_add(buf)\n    emit_i64_load(buf, 3, 8)\n    emit_call(buf, eq_fidx)\n    emit_i64_and(buf)\n    emit_local_set(buf, res_l)\n    emit_local_get(buf, ii_l)\n    emit_i64_const(buf, 1)\n    emit_i64_add(buf)\n    emit_local_set(buf, ii_l)\n    emit_br(buf, 0)\n    emit_end(buf)\n    emit_end(buf)\n    emit_local_get(buf, res_l)\n    emit_else(buf)\n    emit_i64_const(buf, 0)\n    emit_end(buf)\n    nl2 + 3\n  } else {\n    emit_i64_const(buf, 1)\n    let mut i = 0\n    while i < fc {\n      emit_local_get(buf, aptr)\n      emit_i32_wrap_i64(buf)\n      emit_i64_load(buf, 3, 8 + i * 8)\n      emit_local_get(buf, bptr)\n      emit_i32_wrap_i64(buf)\n      emit_i64_load(buf, 3, 8 + i * 8)\n      emit_call(buf, eq_fidx)\n      emit_i64_and(buf)\n      i = i + 1\n    }\n    emit_else(buf)\n    emit_i64_const(buf, 0)\n    emit_end(buf)\n    nl2\n  }\n}\n\nfn is_agg_shape(e: Expr, ct: CtorTable) -> Bool {\n  is_etuple(e) || is_ctor_call(e, ct) || is_nullary_ctor_ident(e, ct) || is_erecord(e)\n}\n\nfn resolved_element_shape(el: Expr, ctx: CompileCtx, local_names: Array[String]) -> Expr {\n  if is_agg_shape(el, ctx.ctor_table) {\n    el\n  } else if is_eident(el) {\n    let s = agg_expr_of_ident(ctx.agg_local_slots, ctx.agg_local_exprs, el, local_names)\n    if is_agg_shape(s, ctx.ctor_table) {\n      s\n    } else {\n      EInt(0)\n    }\n  } else {\n    EInt(0)\n  }\n}\n\nfn ctor_shape_field_exprs(shape: Expr, ct: CtorTable) -> Array[Expr] with { Error } {\n  if is_ctor_call(shape, ct) {\n    let cargs = get_ecall_args(shape)\n    if Array::length(cargs) == 1 {\n      match Array::get(cargs, 0) {\n        ERecord(_, rfields, _) => {\n          let out = array_empty()\n          let mut i = 0\n          while i < Array::length(rfields) {\n            let (_, fv) = Array::get(rfields, i)\n            Array::push(out, fv)\n            i = i + 1\n          }\n          out\n        },\n        _ => cargs\n      }\n    } else {\n      cargs\n    }\n  } else {\n    match shape {\n      ERecord(_, rfields, _) => {\n        let out = array_empty()\n        let mut i = 0\n        while i < Array::length(rfields) {\n          let (_, fv) = Array::get(rfields, i)\n          Array::push(out, fv)\n          i = i + 1\n        }\n        out\n      },\n      _ => array_empty()\n    }\n  }\n}\n\nfn emit_eq_shape_slots(buf: Bytes, shape: Expr, asl: Int, bsl: Int, local_names: Array[String], nl0: Int, ctx: CompileCtx, ld: Int, ce: (Bytes, Expr, Array[String], Int, CompileCtx, Int) -> Int with { Error }) -> Int with { Error } {\n  let (eq_fidx, _, _) = resolve_func(ctx.func_table, \"eq\")\n  if is_etuple(shape) {\n    let elems = get_etuple_elems(shape)\n    let num = Array::length(elems)\n    let ap = nl0\n    Array::push(local_names, \"__seqta\")\n    let bp = nl0 + 1\n    Array::push(local_names, \"__seqtb\")\n    emit_local_get(buf, asl)\n    if ctx.enable_rc {\n      emit_i64_const(buf, -2)\n      emit_i64_and(buf)\n    } else {\n      ()\n    }\n    emit_local_set(buf, ap)\n    emit_local_get(buf, bsl)\n    if ctx.enable_rc {\n      emit_i64_const(buf, -2)\n      emit_i64_and(buf)\n    } else {\n      ()\n    }\n    emit_local_set(buf, bp)\n    let field_off = if ctx.enable_rc {\n      8\n    } else {\n      0\n    }\n    emit_i64_const(buf, 1)\n    let mut nl = nl0 + 2\n    let mut i = 0\n    while i < num {\n      let el = Array::get(elems, i)\n      let el_shape = resolved_element_shape(el, ctx, local_names)\n      if is_agg_shape(el_shape, ctx.ctor_table) {\n        let na = nl\n        Array::push(local_names, \"__seqea\")\n        let nb = nl + 1\n        Array::push(local_names, \"__seqeb\")\n        emit_local_get(buf, ap)\n        emit_i32_wrap_i64(buf)\n        emit_i64_load(buf, 3, field_off + i * 8)\n        emit_local_set(buf, na)\n        emit_local_get(buf, bp)\n        emit_i32_wrap_i64(buf)\n        emit_i64_load(buf, 3, field_off + i * 8)\n        emit_local_set(buf, nb)\n        nl = emit_eq_shape_slots(buf, el_shape, na, nb, local_names, nl + 2, ctx, ld, ce)\n        emit_i64_and(buf)\n      } else {\n        emit_local_get(buf, ap)\n        emit_i32_wrap_i64(buf)\n        emit_i64_load(buf, 3, field_off + i * 8)\n        emit_local_get(buf, bp)\n        emit_i32_wrap_i64(buf)\n        emit_i64_load(buf, 3, field_off + i * 8)\n        emit_call(buf, eq_fidx)\n        emit_i64_and(buf)\n      }\n      i = i + 1\n    }\n    nl\n  } else if is_ctor_call(shape, ctx.ctor_table) || is_nullary_ctor_ident(shape, ctx.ctor_table) || is_erecord(shape) {\n    let field_exprs = ctor_shape_field_exprs(shape, ctx.ctor_table)\n    let fc = Array::length(field_exprs)\n    let ap = nl0\n    Array::push(local_names, \"__seqca\")\n    let bp = nl0 + 1\n    Array::push(local_names, \"__seqcb\")\n    emit_local_get(buf, asl)\n    emit_i64_const(buf, -2)\n    emit_i64_and(buf)\n    emit_local_set(buf, ap)\n    emit_local_get(buf, bsl)\n    emit_i64_const(buf, -2)\n    emit_i64_and(buf)\n    emit_local_set(buf, bp)\n    emit_local_get(buf, ap)\n    emit_i32_wrap_i64(buf)\n    emit_i32_load(buf, 2, 0)\n    emit_local_get(buf, bp)\n    emit_i32_wrap_i64(buf)\n    emit_i32_load(buf, 2, 0)\n    emit_i32_eq(buf)\n    emit_if_i64(buf)\n    emit_i64_const(buf, 1)\n    let mut nl = nl0 + 2\n    let mut i = 0\n    while i < fc {\n      let el = Array::get(field_exprs, i)\n      let el_shape = resolved_element_shape(el, ctx, local_names)\n      if is_agg_shape(el_shape, ctx.ctor_table) {\n        let na = nl\n        Array::push(local_names, \"__seqfa\")\n        let nb = nl + 1\n        Array::push(local_names, \"__seqfb\")\n        emit_local_get(buf, ap)\n        emit_i32_wrap_i64(buf)\n        emit_i64_load(buf, 3, 8 + i * 8)\n        emit_local_set(buf, na)\n        emit_local_get(buf, bp)\n        emit_i32_wrap_i64(buf)\n        emit_i64_load(buf, 3, 8 + i * 8)\n        emit_local_set(buf, nb)\n        nl = emit_eq_shape_slots(buf, el_shape, na, nb, local_names, nl + 2, ctx, ld, ce)\n        emit_i64_and(buf)\n      } else {\n        emit_local_get(buf, ap)\n        emit_i32_wrap_i64(buf)\n        emit_i64_load(buf, 3, 8 + i * 8)\n        emit_local_get(buf, bp)\n        emit_i32_wrap_i64(buf)\n        emit_i64_load(buf, 3, 8 + i * 8)\n        emit_call(buf, eq_fidx)\n        emit_i64_and(buf)\n      }\n      i = i + 1\n    }\n    emit_else(buf)\n    emit_i64_const(buf, 0)\n    emit_end(buf)\n    nl\n  } else {\n    emit_local_get(buf, asl)\n    emit_local_get(buf, bsl)\n    emit_call(buf, eq_fidx)\n    nl0\n  }\n}\n\nfn emit_eq_shape_top(buf: Bytes, shape: Expr, lhs: Expr, rhs: Expr, local_names: Array[String], next_local: Int, ctx: CompileCtx, ld: Int, ce: (Bytes, Expr, Array[String], Int, CompileCtx, Int) -> Int with { Error }) -> Int with { Error } {\n  let aptr = next_local\n  Array::push(local_names, \"__seqa\")\n  let bptr = next_local + 1\n  Array::push(local_names, \"__seqb\")\n  let nl1 = ce(buf, lhs, local_names, next_local + 2, ctx, ld)\n  emit_local_set(buf, aptr)\n  let nl2 = ce(buf, rhs, local_names, nl1, ctx, ld)\n  emit_local_set(buf, bptr)\n  emit_eq_shape_slots(buf, shape, aptr, bptr, local_names, nl2, ctx, ld, ce)\n}\n\nfn emit_eq_value(buf: Bytes, lhs: Expr, rhs: Expr, local_names: Array[String], next_local: Int, ctx: CompileCtx, ld: Int, ce: (Bytes, Expr, Array[String], Int, CompileCtx, Int) -> Int with { Error }) -> Int with { Error } {\n  let lhs_agg = agg_info_of_ident(ctx.agg_local_slots, lhs, local_names)\n  let rhs_agg = agg_info_of_ident(ctx.agg_local_slots, rhs, local_names)\n  if is_etuple(lhs) || is_etuple(rhs) {\n    let lit = if is_etuple(lhs) {\n      lhs\n    } else {\n      rhs\n    }\n    emit_eq_shape_top(buf, lit, lhs, rhs, local_names, next_local, ctx, ld, ce)\n  } else if lhs_agg / 64 == 1 || rhs_agg / 64 == 1 {\n    let tshape = if lhs_agg / 64 == 1 {\n      agg_expr_of_ident(ctx.agg_local_slots, ctx.agg_local_exprs, lhs, local_names)\n    } else {\n      agg_expr_of_ident(ctx.agg_local_slots, ctx.agg_local_exprs, rhs, local_names)\n    }\n    if is_etuple(tshape) {\n      emit_eq_shape_top(buf, tshape, lhs, rhs, local_names, next_local, ctx, ld, ce)\n    } else {\n      let tn = if lhs_agg / 64 == 1 {\n        lhs_agg % 64\n      } else {\n        rhs_agg % 64\n      }\n      emit_tuple_struct_eq(buf, lhs, rhs, tn, local_names, next_local, ctx, ld, ce)\n    }\n  } else if is_ctor_call(lhs, ctx.ctor_table) || is_nullary_ctor_ident(lhs, ctx.ctor_table) || is_ctor_call(rhs, ctx.ctor_table) || is_nullary_ctor_ident(rhs, ctx.ctor_table) {\n    let clit = if is_ctor_call(lhs, ctx.ctor_table) || is_nullary_ctor_ident(lhs, ctx.ctor_table) {\n      lhs\n    } else {\n      rhs\n    }\n    emit_eq_shape_top(buf, clit, lhs, rhs, local_names, next_local, ctx, ld, ce)\n  } else if lhs_agg / 64 == 2 || rhs_agg / 64 == 2 {\n    let cshape = if lhs_agg / 64 == 2 {\n      agg_expr_of_ident(ctx.agg_local_slots, ctx.agg_local_exprs, lhs, local_names)\n    } else {\n      agg_expr_of_ident(ctx.agg_local_slots, ctx.agg_local_exprs, rhs, local_names)\n    }\n    if is_agg_shape(cshape, ctx.ctor_table) {\n      emit_eq_shape_top(buf, cshape, lhs, rhs, local_names, next_local, ctx, ld, ce)\n    } else {\n      let lfc = if lhs_agg / 64 == 2 {\n        lhs_agg % 64\n      } else {\n        0\n      }\n      let rfc = if rhs_agg / 64 == 2 {\n        rhs_agg % 64\n      } else {\n        0\n      }\n      let cfc = if lfc > rfc {\n        lfc\n      } else {\n        rfc\n      }\n      emit_ctor_struct_eq(buf, lhs, rhs, cfc, local_names, next_local, ctx, ld, ce)\n    }\n  } else if expr_is_intish(lhs, local_names, ctx) || expr_is_intish(rhs, local_names, ctx) {\n    let nl1 = ce(buf, lhs, local_names, next_local, ctx, ld)\n    let nl2 = ce(buf, rhs, local_names, nl1, ctx, ld)\n    emit_i64_eq(buf)\n    emit_i64_extend_i32_s(buf)\n    nl2\n  } else {\n    let nl1 = ce(buf, lhs, local_names, next_local, ctx, ld)\n    let nl2 = ce(buf, rhs, local_names, nl1, ctx, ld)\n    let (eq_fidx, _, _) = resolve_func(ctx.func_table, \"eq\")\n    emit_call(buf, eq_fidx)\n    nl2\n  }\n}\n\nexport fn compile_expr(buf: Bytes, expr: Expr, local_names: Array[String], next_local: Int, ctx: CompileCtx, ld: Int) -> Int with { Error } {\n  let __tag = expr_tag(expr)\n  if __tag == 0 {\n    let n = get_eint_value(expr)\n    emit_i64_const(buf, n)\n    if ctx.enable_rc {\n      emit_i64_const(buf, 1)\n      emit_i64_shl(buf)\n    }\n    next_local\n  } else if __tag == 1 {\n    let b_val = get_ebool_value(expr)\n    emit_i64_const(buf, if b_val {\n      if ctx.enable_rc {\n        2\n      } else {\n        1\n      }\n    } else {\n      0\n    })\n    next_local\n  } else if __tag == 2 {\n    let v = get_efloat_value(expr)\n    let lo = Double::to_i64_bits_lo(v)\n    let hi = Double::to_i64_bits_hi(v)\n    emit_f64_const_lohi(buf, lo, hi)\n    emit_i64_reinterpret_f64(buf)\n    if ctx.enable_rc {\n      Array::push(local_names, \"__fbits\")\n      Array::push(local_names, \"__fbox\")\n      emit_box_float(buf, ctx, next_local, next_local + 1)\n      next_local + 2\n    } else {\n      next_local\n    }\n  } else if __tag == 3 {\n    let s = get_estring_value(expr)\n    let idx = str_table_lookup(ctx.str_table.strs, s)\n    emit_str_ref(buf, Array::get(ctx.str_table.offsets, idx), Array::get(ctx.str_table.lengths, idx))\n    next_local\n  } else if __tag == 4 {\n    let name = get_eident_name(expr)\n    let len = Array::length(local_names)\n    let mut __tl_i = len - 1\n    let mut __tl_result = -1\n    while __tl_i >= 0 {\n      if Array::get(local_names, __tl_i) == name {\n        __tl_result = __tl_i\n        __tl_i = -1\n      } else {\n        __tl_i = __tl_i - 1\n      }\n    }\n    let local_idx = __tl_result\n    if local_idx >= 0 {\n      if array_contains_str(ctx.ref_cell_names, name) {\n        emit_local_get(buf, local_idx)\n        emit_i32_wrap_i64(buf)\n        emit_i64_load(buf, 3, 0)\n      } else {\n        emit_local_get(buf, local_idx)\n      }\n      next_local\n    } else {\n      let mut __ci_idx = -1\n      let __ci_len = Array::length(ctx.const_int_names)\n      let mut __ci_j = 0\n      while __ci_j < __ci_len {\n        if Array::get(ctx.const_int_names, __ci_j) == name {\n          __ci_idx = __ci_j\n          __ci_j = __ci_len\n        } else {\n          __ci_j = __ci_j + 1\n        }\n      }\n      if __ci_idx >= 0 {\n        emit_i64_const(buf, Array::get(ctx.const_int_values, __ci_idx))\n        if ctx.enable_rc {\n          emit_i64_const(buf, 1)\n          emit_i64_shl(buf)\n        }\n        next_local\n      } else {\n        let ctor_idx = ctor_table_index_of(ctx.ctor_table, name)\n        if ctor_idx >= 0 {\n          let tag_c = Array::get(ctx.ctor_table.tags, ctor_idx)\n          let ptr_l = next_local\n          Array::push(local_names, \"__ctor_ptr\")\n          if ctx.enable_rc {\n            emit_i64_const(buf, 16)\n            emit_call(buf, ctx.rc_alloc_func_idx)\n            emit_local_set(buf, ptr_l)\n            emit_local_get(buf, ptr_l)\n            emit_i32_wrap_i64(buf)\n            emit_i32_const(buf, 16)\n            emit_i32_store(buf, 2, 0)\n            emit_local_get(buf, ptr_l)\n            emit_i32_wrap_i64(buf)\n            emit_i32_const(buf, 1)\n            emit_i32_store(buf, 2, 4)\n            emit_local_get(buf, ptr_l)\n            emit_i32_wrap_i64(buf)\n            emit_i32_const(buf, 1)\n            emit_i32_store8(buf, 0, 7)\n            emit_local_get(buf, ptr_l)\n            emit_i32_wrap_i64(buf)\n            emit_i32_const(buf, tag_c)\n            emit_i32_store(buf, 2, 8)\n            emit_local_get(buf, ptr_l)\n            emit_i32_wrap_i64(buf)\n            emit_i32_const(buf, 0)\n            emit_i32_store(buf, 2, 12)\n            emit_local_get(buf, ptr_l)\n            emit_i64_const(buf, 8)\n            emit_i64_add(buf)\n            emit_i64_const(buf, 1)\n            emit_i64_or(buf)\n            next_local + 1\n          } else {\n            emit_global_get(buf, 0)\n            emit_i64_extend_i32_u(buf)\n            emit_local_set(buf, ptr_l)\n            emit_global_get(buf, 0)\n            emit_i32_const(buf, 8)\n            emit_i32_add(buf)\n            emit_global_set(buf, 0)\n            emit_heap_grow_after_heap_set(buf, ctx)\n            emit_local_get(buf, ptr_l)\n            emit_i32_wrap_i64(buf)\n            emit_i32_const(buf, tag_c)\n            emit_i32_store(buf, 2, 0)\n            emit_local_get(buf, ptr_l)\n            emit_i32_wrap_i64(buf)\n            emit_i32_const(buf, 0)\n            emit_i32_store(buf, 2, 4)\n            emit_local_get(buf, ptr_l)\n            emit_i64_const(buf, 1)\n            emit_i64_or(buf)\n            next_local + 1\n          }\n        } else {\n          let __tf_result = func_table_index_of(ctx.func_table, name)\n          if __tf_result < 0 {\n            let mut diag = String::concat(\"undefined variable (ident): \", name)\n            diag = String::concat(diag, \" | locals=[\")\n            let mut di = 0\n            while di < len {\n              if di > 0 {\n                diag = String::concat(diag, \",\")\n              }\n              diag = String::concat(diag, Array::get(local_names, di))\n              di = di + 1\n            }\n            diag = String::concat(diag, \"]\")\n            throw(diag)\n          }\n          let fni = __tf_result\n          let fidx = Array::get(ctx.func_table.indices, fni)\n          if bsearch_leftmost(ctx.thunk_names, name) >= 0 {\n            emit_i64_const(buf, 0)\n            emit_call(buf, fidx)\n            next_local\n          } else {\n            let table_slot = fidx - ctx.func_offset\n            Array::push(ctx.table_slots_used, table_slot)\n            emit_i64_const(buf, (table_slot<<2)|2)\n            next_local\n          }\n        }\n      }\n    }\n  } else if __tag == 5 {\n    let op = get_ebinop_op(expr)\n    let lhs = get_ebinop_lhs(expr)\n    let rhs = get_ebinop_rhs(expr)\n    if op == \"&&\" || op == \"||\" {\n      let nl1 = compile_expr(buf, lhs, local_names, next_local, ctx, ld)\n      emit_i64_eqz(buf)\n      if op == \"&&\" {\n        emit_if_i64(buf)\n        emit_i64_const(buf, 0)\n        emit_else(buf)\n        let nl2 = compile_expr(buf, rhs, local_names, nl1, ctx, ld)\n        emit_end(buf)\n        nl2\n      } else {\n        emit_if_i64(buf)\n        let nl2 = compile_expr(buf, rhs, local_names, nl1, ctx, ld)\n        emit_else(buf)\n        emit_i64_const(buf, if ctx.enable_rc {\n          2\n        } else {\n          1\n        })\n        emit_end(buf)\n        nl2\n      }\n    } else if op == \"==\" && !(ctx.enable_rc && (expr_is_floatish(lhs, local_names, ctx) || expr_is_floatish(rhs, local_names, ctx))) {\n      let nle = emit_eq_value(buf, lhs, rhs, local_names, next_local, ctx, ld, compile_expr)\n      if ctx.enable_rc {\n        emit_i64_const(buf, 1)\n        emit_i64_shl(buf)\n      }\n      nle\n    } else if op == \"!=\" && !(ctx.enable_rc && (expr_is_floatish(lhs, local_names, ctx) || expr_is_floatish(rhs, local_names, ctx))) {\n      let nle = emit_eq_value(buf, lhs, rhs, local_names, next_local, ctx, ld, compile_expr)\n      emit_i64_eqz(buf)\n      emit_i64_extend_i32_s(buf)\n      if ctx.enable_rc {\n        emit_i64_const(buf, 1)\n        emit_i64_shl(buf)\n      }\n      nle\n    } else if expr_is_floatish(lhs, local_names, ctx) || expr_is_floatish(rhs, local_names, ctx) {\n      let nl1 = compile_expr(buf, lhs, local_names, next_local, ctx, ld)\n      if ctx.enable_rc {\n        emit_unbox_float(buf)\n      }\n      emit_f64_reinterpret_i64(buf)\n      let nl2 = compile_expr(buf, rhs, local_names, nl1, ctx, ld)\n      if ctx.enable_rc {\n        emit_unbox_float(buf)\n      }\n      emit_f64_reinterpret_i64(buf)\n      if op == \"+\" || op == \"-\" || op == \"*\" || op == \"/\" {\n        if op == \"+\" {\n          emit_f64_add(buf)\n        } else if op == \"-\" {\n          emit_f64_sub(buf)\n        } else if op == \"*\" {\n          emit_f64_mul(buf)\n        } else {\n          emit_f64_div(buf)\n        }\n        emit_i64_reinterpret_f64(buf)\n        if ctx.enable_rc {\n          Array::push(local_names, \"__fbits\")\n          Array::push(local_names, \"__fbox\")\n          emit_box_float(buf, ctx, nl2, nl2 + 1)\n          nl2 + 2\n        } else {\n          nl2\n        }\n      } else {\n        if op == \"==\" {\n          emit_f64_eq(buf)\n        } else if op == \"!=\" {\n          emit_f64_ne(buf)\n        } else if op == \"<\" {\n          emit_f64_lt(buf)\n        } else if op == \">\" {\n          emit_f64_gt(buf)\n        } else if op == \"<=\" {\n          emit_f64_le(buf)\n        } else if op == \">=\" {\n          emit_f64_ge(buf)\n        } else {\n          throw(String::concat(\"unsupported float binop: \", op))\n        }\n        emit_i64_extend_i32_s(buf)\n        if ctx.enable_rc {\n          emit_i64_const(buf, 1)\n          emit_i64_shl(buf)\n        }\n        nl2\n      }\n    } else if ctx.enable_rc {\n      if op == \"<<\" {\n        let nl1 = compile_expr(buf, lhs, local_names, next_local, ctx, ld)\n        let nl2 = compile_expr(buf, rhs, local_names, nl1, ctx, ld)\n        emit_i64_const(buf, 1)\n        emit_i64_shr_s(buf)\n        emit_i64_shl(buf)\n        nl2\n      } else if op == \">>\" {\n        let nl1 = compile_expr(buf, lhs, local_names, next_local, ctx, ld)\n        emit_i64_const(buf, 1)\n        emit_i64_shr_s(buf)\n        let nl2 = compile_expr(buf, rhs, local_names, nl1, ctx, ld)\n        emit_i64_const(buf, 1)\n        emit_i64_shr_s(buf)\n        emit_i64_shr_s(buf)\n        emit_i64_const(buf, 1)\n        emit_i64_shl(buf)\n        nl2\n      } else {\n        let nl1 = compile_expr(buf, lhs, local_names, next_local, ctx, ld)\n        let nl2 = compile_expr(buf, rhs, local_names, nl1, ctx, ld)\n        emit_binop_op(buf, op)\n        if op == \"*\" {\n          emit_i64_const(buf, 1)\n          emit_i64_shr_s(buf)\n        } else if op == \"/\" {\n          emit_i64_const(buf, 1)\n          emit_i64_shl(buf)\n        } else if op == \"<\" || op == \">\" || op == \"<=\" || op == \">=\" {\n          emit_i64_const(buf, 1)\n          emit_i64_shl(buf)\n        } else {\n          ()\n        }\n        nl2\n      }\n    } else {\n      let nl1 = compile_expr(buf, lhs, local_names, next_local, ctx, ld)\n      let nl2 = compile_expr(buf, rhs, local_names, nl1, ctx, ld)\n      emit_binop_op(buf, op)\n      nl2\n    }\n  } else if __tag == 6 {\n    let op = get_eunaryop_op(expr)\n    let operand = get_eunaryop_expr(expr)\n    if op == \"-\" {\n      if expr_is_floatish(operand, local_names, ctx) {\n        let nl = compile_expr(buf, operand, local_names, next_local, ctx, ld)\n        if ctx.enable_rc {\n          emit_unbox_float(buf)\n        }\n        emit_f64_reinterpret_i64(buf)\n        emit_f64_neg(buf)\n        emit_i64_reinterpret_f64(buf)\n        if ctx.enable_rc {\n          Array::push(local_names, \"__fbits\")\n          Array::push(local_names, \"__fbox\")\n          emit_box_float(buf, ctx, nl, nl + 1)\n          nl + 2\n        } else {\n          nl\n        }\n      } else {\n        emit_i64_const(buf, 0)\n        let nl = compile_expr(buf, operand, local_names, next_local, ctx, ld)\n        emit_i64_sub(buf)\n        nl\n      }\n    } else if op == \"!\" {\n      let nl = compile_expr(buf, operand, local_names, next_local, ctx, ld)\n      emit_i64_eqz(buf)\n      emit_i64_extend_i32_s(buf)\n      if ctx.enable_rc {\n        emit_i64_const(buf, 1)\n        emit_i64_shl(buf)\n      }\n      nl\n    } else {\n      throw(String::concat(\"unsupported unary op: \", op))\n    }\n  } else if __tag == 7 {\n    let cond = get_eif_cond(expr)\n    let then_e = get_eif_then(expr)\n    let else_e = get_eif_else(expr)\n    let cond_tag = expr_tag(cond)\n    let nl1 = if cond_tag == 5 {\n      let cop = get_ebinop_op(cond)\n      if cop == \"==\" || cop == \"!=\" || cop == \"<\" || cop == \">\" || cop == \"<=\" || cop == \">=\" {\n        let clhs = get_ebinop_lhs(cond)\n        let crhs = get_ebinop_rhs(cond)\n        if cop == \"==\" && !(ctx.enable_rc && (expr_is_floatish(clhs, local_names, ctx) || expr_is_floatish(crhs, local_names, ctx))) {\n          let cnl2 = emit_eq_value(buf, clhs, crhs, local_names, next_local, ctx, ld, compile_expr)\n          emit_i32_wrap_i64(buf)\n          cnl2\n        } else if cop == \"!=\" && !(ctx.enable_rc && (expr_is_floatish(clhs, local_names, ctx) || expr_is_floatish(crhs, local_names, ctx))) {\n          let cnl2 = emit_eq_value(buf, clhs, crhs, local_names, next_local, ctx, ld, compile_expr)\n          emit_i32_wrap_i64(buf)\n          emit_i32_eqz(buf)\n          cnl2\n        } else if expr_is_floatish(clhs, local_names, ctx) || expr_is_floatish(crhs, local_names, ctx) {\n          let cnl1 = compile_expr(buf, clhs, local_names, next_local, ctx, ld)\n          if ctx.enable_rc {\n            emit_unbox_float(buf)\n          } else {\n            ()\n          }\n          emit_f64_reinterpret_i64(buf)\n          let cnl2 = compile_expr(buf, crhs, local_names, cnl1, ctx, ld)\n          if ctx.enable_rc {\n            emit_unbox_float(buf)\n          } else {\n            ()\n          }\n          emit_f64_reinterpret_i64(buf)\n          if cop == \"==\" {\n            emit_f64_eq(buf)\n          }\n          else if cop == \"!=\" {\n            emit_f64_ne(buf)\n          }\n          else if cop == \"<\" {\n            emit_f64_lt(buf)\n          }\n          else if cop == \">\" {\n            emit_f64_gt(buf)\n          }\n          else if cop == \"<=\" {\n            emit_f64_le(buf)\n          }\n          else {\n            emit_f64_ge(buf)\n          }\n          cnl2\n        } else {\n          let cnl1 = compile_expr(buf, clhs, local_names, next_local, ctx, ld)\n          let cnl2 = compile_expr(buf, crhs, local_names, cnl1, ctx, ld)\n          if cop == \"<\" {\n            emit_i64_lt_s(buf)\n          }\n          else if cop == \">\" {\n            emit_i64_gt_s(buf)\n          }\n          else if cop == \"<=\" {\n            emit_i64_le_s(buf)\n          }\n          else {\n            emit_i64_ge_s(buf)\n          }\n          cnl2\n        }\n      } else {\n        let cnl = compile_expr(buf, cond, local_names, next_local, ctx, ld)\n        emit_i32_wrap_i64(buf)\n        cnl\n      }\n    } else if cond_tag == 1 {\n      let b_val = get_ebool_value(cond)\n      emit_i32_const(buf, if b_val {\n        1\n      } else {\n        0\n      })\n      next_local\n    } else if cond_tag == 6 {\n      let uop = get_eunaryop_op(cond)\n      let uoperand = get_eunaryop_expr(cond)\n      if uop == \"!\" {\n        let inner_tag = expr_tag(uoperand)\n        if inner_tag == 5 {\n          let iop = get_ebinop_op(uoperand)\n          if iop == \"==\" || iop == \"!=\" || iop == \"<\" || iop == \">\" || iop == \"<=\" || iop == \">=\" {\n            let ilhs = get_ebinop_lhs(uoperand)\n            let irhs = get_ebinop_rhs(uoperand)\n            if iop == \"==\" && !(ctx.enable_rc && (expr_is_floatish(ilhs, local_names, ctx) || expr_is_floatish(irhs, local_names, ctx))) {\n              let inl2 = emit_eq_value(buf, ilhs, irhs, local_names, next_local, ctx, ld, compile_expr)\n              emit_i32_wrap_i64(buf)\n              emit_i32_eqz(buf)\n              inl2\n            } else if iop == \"!=\" && !(ctx.enable_rc && (expr_is_floatish(ilhs, local_names, ctx) || expr_is_floatish(irhs, local_names, ctx))) {\n              let inl2 = emit_eq_value(buf, ilhs, irhs, local_names, next_local, ctx, ld, compile_expr)\n              emit_i32_wrap_i64(buf)\n              emit_i32_eqz(buf)\n              emit_i32_eqz(buf)\n              inl2\n            } else if expr_is_floatish(ilhs, local_names, ctx) || expr_is_floatish(irhs, local_names, ctx) {\n              let inl1 = compile_expr(buf, ilhs, local_names, next_local, ctx, ld)\n              if ctx.enable_rc {\n                emit_unbox_float(buf)\n              } else {\n                ()\n              }\n              emit_f64_reinterpret_i64(buf)\n              let inl2 = compile_expr(buf, irhs, local_names, inl1, ctx, ld)\n              if ctx.enable_rc {\n                emit_unbox_float(buf)\n              } else {\n                ()\n              }\n              emit_f64_reinterpret_i64(buf)\n              if iop == \"==\" {\n                emit_f64_eq(buf)\n              }\n              else if iop == \"!=\" {\n                emit_f64_ne(buf)\n              }\n              else if iop == \"<\" {\n                emit_f64_lt(buf)\n              }\n              else if iop == \">\" {\n                emit_f64_gt(buf)\n              }\n              else if iop == \"<=\" {\n                emit_f64_le(buf)\n              }\n              else {\n                emit_f64_ge(buf)\n              }\n              emit_i32_eqz(buf)\n              inl2\n            } else {\n              let inl1 = compile_expr(buf, ilhs, local_names, next_local, ctx, ld)\n              let inl2 = compile_expr(buf, irhs, local_names, inl1, ctx, ld)\n              if iop == \"<\" {\n                emit_i64_lt_s(buf)\n              }\n              else if iop == \">\" {\n                emit_i64_gt_s(buf)\n              }\n              else if iop == \"<=\" {\n                emit_i64_le_s(buf)\n              }\n              else {\n                emit_i64_ge_s(buf)\n              }\n              emit_i32_eqz(buf)\n              inl2\n            }\n          } else {\n            let cnl = compile_expr(buf, cond, local_names, next_local, ctx, ld)\n            emit_i32_wrap_i64(buf)\n            cnl\n          }\n        } else {\n          let cnl = compile_expr(buf, cond, local_names, next_local, ctx, ld)\n          emit_i32_wrap_i64(buf)\n          cnl\n        }\n      } else {\n        let cnl = compile_expr(buf, cond, local_names, next_local, ctx, ld)\n        emit_i32_wrap_i64(buf)\n        cnl\n      }\n    } else {\n      let cnl = compile_expr(buf, cond, local_names, next_local, ctx, ld)\n      emit_i32_wrap_i64(buf)\n      cnl\n    }\n    emit_if_i64(buf)\n    let ld_inner = if ld >= 0 {\n      ld + 1\n    } else {\n      -1\n    }\n    let names_len_before = Array::length(local_names)\n    cov_emit_branch(buf, ctx.cov)\n    let nl2 = compile_expr(buf, then_e, local_names, nl1, ctx, ld_inner)\n    emit_else(buf)\n    Array::truncate(local_names, names_len_before)\n    int_log_reset_above(ctx, names_len_before)\n    agg_log_reset_above2(ctx.agg_local_slots, ctx.agg_local_exprs, names_len_before)\n    float_log_reset_above(ctx, names_len_before)\n    cov_emit_branch(buf, ctx.cov)\n    let nl3 = compile_expr(buf, else_e, local_names, nl1, ctx, ld_inner)\n    emit_end(buf)\n    let max_nl_if = if nl2 > nl3 {\n      nl2\n    } else {\n      nl3\n    }\n    while Array::length(local_names) < max_nl_if {\n      Array::push(local_names, \"\")\n    }\n    max_nl_if\n  } else if __tag == 8 {\n    compile_call(buf, get_ecall_callee(expr), get_ecall_args(expr), local_names, next_local, ctx, ld, compile_expr)\n  } else {\n    compile_expr_tail(buf, expr, local_names, next_local, ctx, ld, compile_expr)\n  }\n}\n")
}

let source_104 = () -> (String, String) {
  ("lib/@vibe/compiler/codegen/expr/compile_module_expr.vibe",
"\nimport @vibe/compiler/core {\n  Expr, Stmt, bytebuf_new, bytebuf_to_bytes, sorted_names_of\n}\n\nimport @vibe/compiler/codegen/common_base {\n  CompileCtx, CtorTable, FuncTable, LambdaTable, StrTable, cov_disabled, linemap_disabled\n}\n\nimport @vibe/compiler/codegen/wasm_emit {\n  emit_code_section_with_locals, emit_export_section_multi, emit_function_section, emit_header, emit_type_section_multi\n}\n\n\n\nexport fn compile_module_expr(stmts: Array[Stmt]) -> Bytes with { Error } {\n  let fresh_int_array: () -> Array[Int] = () -> {\n    ArrayBuilder::freeze(ArrayBuilder::new())\n  }\n  let fresh_string_array: () -> Array[String] = () -> {\n    ArrayBuilder::freeze(ArrayBuilder::new())\n  }\n  let fresh_expr_array: () -> Array[Expr] = () -> {\n    ArrayBuilder::freeze(ArrayBuilder::new())\n  }\n  let fresh_bytes_matrix: () -> Array[Bytes] = () -> {\n    ArrayBuilder::freeze(ArrayBuilder::new())\n  }\n  let fresh_string_matrix: () -> Array[Array[String]] = () -> {\n    ArrayBuilder::freeze(ArrayBuilder::new())\n  }\n  let fn_names_list = fresh_string_array()\n  let fn_param_counts = fresh_int_array()\n  let export_names = fresh_string_array()\n  let export_indices = fresh_int_array()\n  let fn_bodies_list = fresh_expr_array()\n  let fn_param_names_list = fresh_string_matrix()\n  let mut i = 0\n  while i < Array::length(stmts) {\n    let stmt = Array::get(stmts, i)\n    match stmt {\n      SLet(is_export, _, name, _, expr) => match expr {\n        EFn(_, _, params, _, _, body) => {\n          let cur_idx = Array::length(fn_names_list)\n          Array::push(fn_names_list, name)\n          Array::push(fn_param_counts, Array::length(params))\n          Array::push(fn_bodies_list, body)\n          let pnames = fresh_string_array()\n          let mut pi = 0\n          while pi < Array::length(params) {\n            let (pname, _) = Array::get(params, pi)\n            Array::push(pnames, pname)\n            pi = pi + 1\n          }\n          Array::push(fn_param_names_list, pnames)\n          if is_export {\n            Array::push(export_names, name)\n            Array::push(export_indices, cur_idx)\n          }\n          0\n        },\n        _ => 0\n      },\n      _ => 0\n    }\n    i = i + 1\n  }\n  let num_funcs = Array::length(fn_names_list)\n  if num_funcs == 0 {\n    let out = bytebuf_new()\n    let empty_type_defs = fresh_int_array()\n    let empty_type_indices = fresh_int_array()\n    let empty_body = bytebuf_new()\n    let empty_bodies = fresh_bytes_matrix()\n    Array::push(empty_bodies, empty_body)\n    let empty_local_counts = fresh_int_array()\n    Array::push(empty_local_counts, 0)\n    emit_header(out)\n    emit_type_section_multi(out, empty_type_defs)\n    emit_function_section(out, empty_type_indices)\n    emit_code_section_with_locals(out, empty_bodies, empty_local_counts)\n    bytebuf_to_bytes(out)\n  } else {\n    let fn_indices_list = fresh_int_array()\n    let fn_returns_list = fresh_int_array()\n    let fn_needs_env_list = ArrayBuilder::freeze(ArrayBuilder::new())\n    let mut fi = 0\n    while fi < num_funcs {\n      Array::push(fn_indices_list, fi)\n      Array::push(fn_returns_list, 1)\n      Array::push(fn_needs_env_list, false)\n      fi = fi + 1\n    }\n    let type_defs = fresh_int_array()\n    let mut ti = 0\n    while ti < num_funcs {\n      Array::push(type_defs, Array::get(fn_param_counts, ti))\n      Array::push(type_defs, 1)\n      ti = ti + 1\n    }\n    let type_indices = fresh_int_array()\n    let mut tii = 0\n    while tii < num_funcs {\n      Array::push(type_indices, tii)\n      tii = tii + 1\n    }\n    let lt_m = LambdaTable::{\n      bodies: fresh_bytes_matrix(),\n      param_counts: fresh_int_array(),\n      captures: fresh_string_matrix(),\n      meta_i32: fresh_int_array(),\n      meta_i64: fresh_int_array()\n    }\n    let empty_str_table = StrTable::{\n      strs: fresh_string_array(),\n      offsets: fresh_int_array(),\n      lengths: fresh_int_array()\n    }\n    let empty_ctor_table = CtorTable::{\n      names: fresh_string_array(),\n      tags: fresh_int_array(),\n      field_counts: fresh_int_array(),\n      type_names: fresh_string_array(),\n      struct_names: fresh_string_array(),\n      struct_field_names: fresh_string_matrix(),\n      names_sorted: fresh_string_array(),\n      names_sorted_pos: fresh_int_array()\n    }\n    let empty_thunk_names = fresh_string_array()\n    let empty_const_int_names = fresh_string_array()\n    let empty_const_int_values = fresh_int_array()\n    let empty_rc_drop_names = fresh_string_array()\n    let empty_rc_alias_dup_names = fresh_string_array()\n    let empty_rc_dup_names = fresh_string_array()\n    let bodies = fresh_bytes_matrix()\n    let local_counts = fresh_int_array()\n    let cni_sorted = sorted_names_of(fn_names_list)\n    let mut bi = 0\n    while bi < num_funcs {\n      let body = Array::get(fn_bodies_list, bi)\n      let param_names = Array::get(fn_param_names_list, bi)\n      let body_buf = bytebuf_new()\n      let local_names = fresh_string_array()\n      let mut pi = 0\n      while pi < Array::length(param_names) {\n        Array::push(local_names, Array::get(param_names, pi))\n        pi = pi + 1\n      }\n      let param_count = Array::length(param_names)\n      let empty_ref_cells = fresh_string_array()\n      let compile_ctx = CompileCtx::{\n        func_table: FuncTable::{\n          names: fn_names_list,\n          indices: fn_indices_list,\n          params: fn_param_counts,\n          returns: fn_returns_list,\n          needs_env: fn_needs_env_list,\n          names_sorted: fresh_string_array(),\n          names_sorted_pos: fresh_int_array()\n        },\n        str_table: empty_str_table,\n        lambda_table: lt_m,\n        num_user_funcs: num_funcs, func_offset: 0,\n        ref_cell_names: empty_ref_cells,\n        ctor_table: empty_ctor_table,\n        ctor_float_fields: fresh_int_array(),\n        thunk_names: empty_thunk_names,\n        const_int_names: empty_const_int_names,\n        const_int_values: empty_const_int_values,\n        enable_rc: false,\n        rc_shadow: false,\n        rc_drop_names: empty_rc_drop_names,\n        rc_alias_dup_names: empty_rc_alias_dup_names,\n        heap_binding_names: fresh_string_array(),\n        rc_drop_func_idx: -1,\n        rc_alloc_func_idx: -1,\n        heap_grow_check_func_idx: -1,\n        map_hash_func_idx: -1,\n        map_cap_func_idx: -1,\n        map_build_index_func_idx: -1,\n        map_probe_func_idx: -1,\n        rc_dup_names: empty_rc_dup_names,\n        capture_name_index: cni_sorted,\n        float_local_slots: fresh_int_array(),\n        int_local_slots: fresh_int_array(),\n        agg_local_slots: fresh_int_array(),\n        agg_local_exprs: fresh_expr_array(),\n        agg_ret_names: fresh_string_array(),\n        agg_ret_infos: fresh_int_array(),\n        heap_ret_names: fresh_string_array(),\n        effect_names: fresh_string_array(),\n        effect_op_keys: fresh_string_array(),\n        effect_op_arities: fresh_int_array(),\n        cov: cov_disabled(),\n        dbg_line_idx: -1,\n        dbg_line_nl: fresh_int_array(),\n        dbg_line_file_id: 0,\n        loop_borrowed_names: fresh_string_array(),\n        loop_consumed_names: fresh_string_array(),\n        reuse_scrutinee_names: fresh_string_array(),\n        reuse_flag_locals: fresh_int_array(),\n        borrow_ret_names: fresh_string_array(),\n        borrow_param_user: fresh_string_array(),\n        borrow_param_mask: fresh_int_array(),\n        borrow_view_ret: fresh_string_array(),\n        scalar_ret_names: fresh_string_array(),\n        pending_letrec_self_name: fresh_string_array(),\n        table_slots_used: fresh_int_array(),\n        lambda_plan_next: fresh_int_array(),\n        linemap: linemap_disabled()\n      }\n      let final_nl = compile_expr(body_buf, body, local_names, param_count, compile_ctx, -1)\n      Array::push(bodies, body_buf)\n      let extra = if final_nl > param_count {\n        final_nl - param_count\n      } else {\n        0\n      }\n      Array::push(local_counts, extra)\n      bi = bi + 1\n    }\n    let out = bytebuf_new()\n    emit_header(out)\n    emit_type_section_multi(out, type_defs)\n    emit_function_section(out, type_indices)\n    if Array::length(export_names) > 0 {\n      emit_export_section_multi(out, export_names, export_indices)\n    }\n    emit_code_section_with_locals(out, bodies, local_counts)\n    bytebuf_to_bytes(out)\n  }\n}\n")
}

