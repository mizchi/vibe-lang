known\n          }\n          (tab_call_ty(tytab, call_off, result), s3, c2)\n        } else if name == \"MapBuilder::get\" && Array::length(args) == 2 {\n          let (mb_ty, s1, c1) = check_expr(Array::get(args, 0), env, defs, s, c, errors, tytab)\n          let (mbk_ty, s2, c2) = check_expr(Array::get(args, 1), env, defs, s1, c1, errors, tytab)\n          let s3 = check_assignable(CtString, subst_apply(s2, mbk_ty), s2, errors, \"argument type mismatch for MapBuilder::get\", call_off)\n          let mbresult = match subst_apply(s3, mb_ty) {\n            CtNamed(mn, margs) => if mn == \"MapBuilder\" && Array::length(margs) == 2 {\n              CtOption(subst_apply(s3, Array::get(margs, 1)))\n            } else {\n              CtOption(CtUnknown)\n            },\n            _ => CtOption(CtUnknown)\n          }\n          (tab_call_ty(tytab, call_off, mbresult), s3, c2)\n        } else if name == \"Map::values\" && Array::length(args) == 1 {\n          let (m_ty, s1, c1) = check_expr(Array::get(args, 0), env, defs, s, c, errors, tytab)\n          let result = match subst_apply(s1, m_ty) {\n            CtNamed(mn, margs) => if mn == \"Map\" && Array::length(margs) == 2 {\n              CtArray(subst_apply(s1, Array::get(margs, 1)))\n            } else {\n              CtArray(CtUnknown)\n            },\n            _ => CtArray(CtUnknown)\n          }\n          (tab_call_ty(tytab, call_off, result), s1, c1)\n        } else if name == \"Map::delete\" && Array::length(args) == 2 {\n          let (m_ty, s1, c1) = check_expr(Array::get(args, 0), env, defs, s, c, errors, tytab)\n          let (k_ty, s2, c2) = check_expr(Array::get(args, 1), env, defs, s1, c1, errors, tytab)\n          let s3 = check_assignable(CtString, subst_apply(s2, k_ty), s2, errors, \"argument type mismatch for Map::delete\", call_off)\n          let mret = match subst_apply(s3, m_ty) {\n            CtNamed(mn, margs) => if mn == \"Map\" && Array::length(margs) == 2 {\n              subst_apply(s3, m_ty)\n            } else {\n              CtNamed(\"Map\", [\n                CtString,\n                CtUnknown\n              ])\n            },\n            _ => CtNamed(\"Map\", [\n              CtString,\n              CtUnknown\n            ])\n          }\n          (tab_call_ty(tytab, call_off, mret), s3, c2)\n        } else if name == \"Array::push\" && Array::length(args) == 2 {\n          let (obj_ty, s1, c1) = check_expr(Array::get(args, 0), env, defs, s, c, errors, tytab)\n          let (val_ty, s2, c2) = check_expr(Array::get(args, 1), env, defs, s1, c1, errors, tytab)\n          let s3 = match subst_apply(s2, obj_ty) {\n            CtArray(elem) => check_assignable(subst_apply(s2, elem), subst_apply(s2, val_ty), s2, errors, \"Array::push value type mismatch\", 0 - 1),\n            _ => s2\n          }\n          (tab_call_ty(tytab, call_off, CtUnit), s3, c2)\n        } else if name == \"Array::set\" && Array::length(args) == 3 {\n          let (obj_ty, s1, c1) = check_expr(Array::get(args, 0), env, defs, s, c, errors, tytab)\n          let (set_idx_ty, s2, c2) = check_expr(Array::get(args, 1), env, defs, s1, c1, errors, tytab)\n          let (val_ty, s3, c3) = check_expr(Array::get(args, 2), env, defs, s2, c2, errors, tytab)\n          let as_recv_head = head_kind(subst_apply(s3, obj_ty))\n          if as_recv_head != 0 && as_recv_head != 9 {\n            Array::push(errors, String::concat(\"argument type mismatch for Array::set: receiver type \", String::concat(type_to_string(subst_apply(s3, obj_ty)), off_marker_len(callee_off, String::length(name)))))\n          } else if is_stream_named_type(subst_apply(s3, obj_ty)) {\n            Array::push(errors, String::concat(\"argument type mismatch for Array::set: receiver type \", String::concat(type_to_string(subst_apply(s3, obj_ty)), String::concat(\" is a Stream, not an Array (iterate it with `for` / Stream::*)\", off_marker_len(callee_off, String::length(name))))))\n          } else {\n            ()\n          }\n          let as_idx_head = head_kind(subst_apply(s3, set_idx_ty))\n          if as_idx_head != 0 && as_idx_head != 1 {\n            Array::push(errors, String::concat(\"argument type mismatch for Array::set (arg 1): \", String::concat(type_to_string(subst_apply(s3, set_idx_ty)), off_marker_len(callee_off, String::length(name)))))\n          } else {\n            ()\n          }\n          let s4 = match subst_apply(s3, obj_ty) {\n            CtArray(elem) => check_assignable(subst_apply(s3, elem), subst_apply(s3, val_ty), s3, errors, \"Array::set value type mismatch\", 0 - 1),\n            _ => s3\n          }\n          (tab_call_ty(tytab, call_off, CtUnit), s4, c3)\n        } else if name == \"Array::push_all\" && Array::length(args) == 2 {\n          let (a_ty, s1, c1) = check_expr(Array::get(args, 0), env, defs, s, c, errors, tytab)\n          let (b_ty, s2, c2) = check_expr(Array::get(args, 1), env, defs, s1, c1, errors, tytab)\n          let s3 = check_two_array_elems(subst_apply(s2, a_ty), subst_apply(s2, b_ty), s2, errors, \"Array::push_all element type mismatch\")\n          (tab_call_ty(tytab, call_off, CtUnit), s3, c2)\n        } else if name == \"Array::get\" && Array::length(args) == 2 {\n          let (obj_ty, s1, c1) = check_expr(Array::get(args, 0), env, defs, s, c, errors, tytab)\n          let (idx_ty, s2, c2) = check_expr(Array::get(args, 1), env, defs, s1, c1, errors, tytab)\n          let ag_recv_head = head_kind(subst_apply(s2, obj_ty))\n          if ag_recv_head != 0 && ag_recv_head != 9 {\n            Array::push(errors, String::concat(\"argument type mismatch for Array::get: receiver type \", String::concat(type_to_string(subst_apply(s2, obj_ty)), off_marker_len(callee_off, String::length(name)))))\n          } else if is_stream_named_type(subst_apply(s2, obj_ty)) {\n            Array::push(errors, String::concat(\"argument type mismatch for Array::get: receiver type \", String::concat(type_to_string(subst_apply(s2, obj_ty)), String::concat(\" is a Stream, not an Array (iterate it with `for` / Stream::*)\", off_marker_len(callee_off, String::length(name))))))\n          } else {\n            ()\n          }\n          let ag_idx_head = head_kind(subst_apply(s2, idx_ty))\n          if ag_idx_head != 0 && ag_idx_head != 1 {\n            Array::push(errors, String::concat(\"argument type mismatch for Array::get (arg 1): \", String::concat(type_to_string(subst_apply(s2, idx_ty)), off_marker_len(callee_off, String::length(name)))))\n          } else {\n            ()\n          }\n          let result = match subst_apply(s2, obj_ty) {\n            CtArray(elem) => elem,\n            _ => CtUnknown\n          }\n          (tab_call_ty(tytab, call_off, result), s2, c2)\n        } else if name == \"Array::reverse\" && Array::length(args) == 1 {\n          let (obj_ty, s1, c1) = check_expr(Array::get(args, 0), env, defs, s, c, errors, tytab)\n          let result = match subst_apply(s1, obj_ty) {\n            CtArray(elem) => CtArray(elem),\n            _ => CtUnknown\n          }\n          (tab_call_ty(tytab, call_off, result), s1, c1)\n        } else if name == \"Array::concat\" && Array::length(args) == 2 {\n          let (a_ty, s1, c1) = check_expr(Array::get(args, 0), env, defs, s, c, errors, tytab)\n          let (b_ty, s2, c2) = check_expr(Array::get(args, 1), env, defs, s1, c1, errors, tytab)\n          let a_app = subst_apply(s2, a_ty)\n          let b_app = subst_apply(s2, b_ty)\n          let s3 = check_two_array_elems(a_app, b_app, s2, errors, \"Array::concat element type mismatch\")\n          let result = match a_app {\n            CtArray(elem) => CtArray(elem),\n            _ => match b_app {\n              CtArray(elem) => CtArray(elem),\n              _ => CtUnknown\n            }\n          }\n          (tab_call_ty(tytab, call_off, result), s3, c2)\n        } else if name == \"Array::slice\" && Array::length(args) == 3 {\n          let (obj_ty, s1, c1) = check_expr(Array::get(args, 0), env, defs, s, c, errors, tytab)\n          let (_, s2, c2) = check_expr(Array::get(args, 1), env, defs, s1, c1, errors, tytab)\n          let (_, s3, c3) = check_expr(Array::get(args, 2), env, defs, s2, c2, errors, tytab)\n          let result = match subst_apply(s3, obj_ty) {\n            CtArray(elem) => CtArray(elem),\n            _ => CtUnknown\n          }\n          (tab_call_ty(tytab, call_off, result), s3, c3)\n        } else if name == \"Array::fold\" && Array::length(args) == 3 {\n          let (recv_ty, s1, c1) = check_expr(Array::get(args, 0), env, defs, s, c, errors, tytab)\n          let (init_ty, s2, c2) = check_expr(Array::get(args, 1), env, defs, s1, c1, errors, tytab)\n          let (fn_ty, s3, c3) = check_expr(Array::get(args, 2), env, defs, s2, c2, errors, tytab)\n          let s4 = match subst_apply(s3, fn_ty) {\n            CtFn(ptys, _, _) => if Array::length(ptys) >= 1 {\n              check_assignable(subst_apply(s3, Array::get(ptys, 0)), subst_apply(s3, init_ty), s3, errors, \"Array::fold accumulator type mismatch\", 0 - 1)\n            } else {\n              s3\n            },\n            _ => s3\n          }\n          let s5 = check_hof_param_vs_elem(subst_apply(s4, recv_ty), subst_apply(s4, fn_ty), 1, s4, errors, \"Array::fold element parameter type mismatch\")\n          (tab_call_ty(tytab, call_off, subst_apply(s5, init_ty)), s5, c3)\n        } else if name == \"Array::map\" && Array::length(args) == 2 {\n          let (recv_ty, s1, c1) = check_expr(Array::get(args, 0), env, defs, s, c, errors, tytab)\n          let (fn_ty, s2, c2) = check_expr(Array::get(args, 1), env, defs, s1, c1, errors, tytab)\n          let s3 = check_hof_param_vs_elem(subst_apply(s2, recv_ty), subst_apply(s2, fn_ty), 0, s2, errors, \"Array::map function parameter type mismatch\")\n          let result = match subst_apply(s3, fn_ty) {\n            CtFn(_, ret, _) => CtArray(ret),\n            _ => CtUnknown\n          }\n          (tab_call_ty(tytab, call_off, result), s3, c2)\n        } else if name == \"TaskGroup::run\" && Array::length(args) == 1 {\n          match env_lookup(env, \"TaskGroup::run\") {\n            Some(scheme) => {\n              let (ti, c1, new_bounds) = instantiate(scheme, c)\n              let mut s0 = s\n              let mut bi = 0\n              while bi < Array::length(new_bounds) {\n                let (vid, bounds) = Array::get(new_bounds, bi)\n                if Array::length(bounds) != 0 {\n                  s0 = subst_add_bound(s0, vid, bounds)\n                } else {\n                  ()\n                }\n                bi = bi + 1\n              }\n              match ti {\n                CtFn(run_params, run_ret, _) => match Array::get(run_params, 0) {\n                  CtFn(body_params, body_ret, body_eff) => match Array::get(body_params, 0) {\n                    CtNamed(tg_name, tg_args) => if tg_name == \"TaskGroup\" && Array::length(tg_args) == 2 {\n                      match Array::get(tg_args, 0) {\n                        CtVar(rv_id) => {\n                          let skolem_name = String::concat(\"#region_\", __to_string(c1))\n                          let s_skolem = SubstBind(rv_id, CtNamed(skolem_name, [\n                          ]), s0)\n                          let (bt, s_body, c_body) = check_expr(Array::get(args, 0), env, defs, s_skolem, c1 + 1, errors, tytab)\n                          match unify(CtFn(body_params, body_ret, body_eff), bt, s_body) {\n                            Some(s_unified) => {\n                              let zonked_ret = subst_apply(s_unified, body_ret)\n                              if type_mentions_named(zonked_ret, skolem_name) {\n                                Array::push(errors, String::concat(\"region escapes its nursery scope: the value returned from this TaskGroup::run body still depends on its own Nursery/Task/Sender/Receiver token\", off_marker_len(callee_off, String::length(name))))\n                              } else {\n                                ()\n                              }\n                              let outer_bindings = array_empty()\n                              collect_env_bindings(env, outer_bindings)\n                              let mut oi = 0\n                              let mut leaked = false\n                              while oi < Array::length(outer_bindings) {\n                                let (_, oty) = Array::get(outer_bindings, oi)\n                                if !leaked && type_mentions_named(subst_apply(s_unified, oty), skolem_name) {\n                                  leaked = true\n                                } else {\n                                  ()\n                                }\n                                oi = oi + 1\n                              }\n                              if leaked {\n                                Array::push(errors, String::concat(\"region escapes its nursery scope: an outer binding now depends on this TaskGroup::run call's own Nursery/Task/Sender/Receiver token\", off_marker_len(callee_off, String::length(name))))\n                              } else {\n                                ()\n                              }\n                              (tab_call_ty(tytab, call_off, subst_apply(s_unified, run_ret)), s_unified, c_body)\n                            },\n                            None => {\n                              Array::push(errors, String::concat(\"argument type mismatch for TaskGroup::run\", off_marker_len(callee_off, String::length(name))))\n                              (tab_call_ty(tytab, call_off, CtUnknown), s_body, c_body)\n                            }\n                          }\n                        },\n                        _ => (tab_call_ty(tytab, call_off, CtUnknown), s0, c1)\n                      }\n                    } else {\n                      (tab_call_ty(tytab, call_off, CtUnknown), s0, c1)\n                    },\n                    _ => (tab_call_ty(tytab, call_off, CtUnknown), s0, c1)\n                  },\n                  _ => (tab_call_ty(tytab, call_off, CtUnknown), s0, c1)\n                },\n                _ => (tab_call_ty(tytab, call_off, CtUnknown), s0, c1)\n              }\n            },\n            None => {\n              Array::push(errors, String::concat(\"unknown name: \", name))\n              (tab_call_ty(tytab, call_off, CtUnknown), s, c)\n            }\n          }\n        } else if name == \"__region_run\" && Array::length(args) == 1 {\n          let skolem_name = String::concat(\"#region_\", __to_string(c))\n          match Array::get(args, 0) {\n            EFn(_, _, fn_params, _, _, fn_body) => if Array::length(fn_params) == 1 {\n              let (binder_name, _) = Array::get(fn_params, 0)\n              let env_body = env_bind(env, binder_name, CtNamed(skolem_name, [\n              ]))\n              let (body_ty, s1, c1) = check_expr(fn_body, env_body, defs, s, c + 1, errors, tytab)\n              let zonked_ret = subst_apply(s1, body_ty)\n              if type_mentions_named(zonked_ret, skolem_name) {\n                Array::push(errors, String::concat(\"region escapes its scope: the value returned from this region body still depends on the region's own token\", off_marker_len(callee_off, String::length(name))))\n              } else {\n                ()\n              }\n              let outer_bindings = array_empty()\n              collect_env_bindings(env, outer_bindings)\n              let mut oi = 0\n              let mut leaked = false\n              while oi < Array::length(outer_bindings) {\n                let (_, oty) = Array::get(outer_bindings, oi)\n                if !leaked && type_mentions_named(subst_apply(s1, oty), skolem_name) {\n                  leaked = true\n                } else {\n                  ()\n                }\n                oi = oi + 1\n              }\n              if leaked {\n                Array::push(errors, String::concat(\"region escapes its scope: an outer binding now depends on this region's own token\", off_marker_len(callee_off, String::length(name))))\n              } else {\n                ()\n              }\n              (tab_call_ty(tytab, call_off, zonked_ret), s1, c1)\n            } else {\n              (tab_call_ty(tytab, call_off, CtUnknown), s, c + 1)\n            },\n            _ => {\n              let (bt, s_body, c_body) = check_expr(Array::get(args, 0), env, defs, s, c + 1, errors, tytab)\n              match subst_apply(s_body, bt) {\n                CtFn(body_params, body_ret, _) => if Array::length(body_params) == 1 {\n                  match unify(Array::get(body_params, 0), CtNamed(skolem_name, [\n                  ]), s_body) {\n                    Some(s_unified) => {\n                      let zonked_ret = subst_apply(s_unified, body_ret)\n                      if type_mentions_named(zonked_ret, skolem_name) {\n                        Array::push(errors, String::concat(\"region escapes its scope: the value returned from this region body still depends on the region's own token\", off_marker_len(callee_off, String::length(name))))\n                      } else {\n                        ()\n                      }\n                      (tab_call_ty(tytab, call_off, zonked_ret), s_unified, c_body)\n                    },\n                    None => {\n                      Array::push(errors, String::concat(\"region body parameter type mismatch for __region_run\", off_marker_len(callee_off, String::length(name))))\n                      (tab_call_ty(tytab, call_off, CtUnknown), s_body, c_body)\n                    }\n                  }\n                } else {\n                  (tab_call_ty(tytab, call_off, CtUnknown), s_body, c_body)\n                },\n                _ => (tab_call_ty(tytab, call_off, CtUnknown), s_body, c_body)\n              }\n            }\n          }\n        } else if (name == \"TaskGroup::spawn\" || name == \"TaskGroup::spawn_suspend\") && Array::length(args) == 2 {\n          match env_lookup(env, name) {\n            Some(scheme) => {\n              let (ti, c1, new_bounds) = instantiate(scheme, c)\n              let mut s0 = s\n              let mut bi = 0\n              while bi < Array::length(new_bounds) {\n                let (vid, bounds) = Array::get(new_bounds, bi)\n                if Array::length(bounds) != 0 {\n                  s0 = subst_add_bound(s0, vid, bounds)\n                } else {\n                  ()\n                }\n                bi = bi + 1\n              }\n              match ti {\n                CtFn(param_tys, ret_ty, _) => {\n                  let (a0_ty, s1, c2) = check_expr(Array::get(args, 0), env, defs, s0, c1, errors, tytab)\n                  let (a1_ty, s2, c3) = check_expr(Array::get(args, 1), env, defs, s1, c2, errors, tytab)\n                  let arg_tys = [\n                    a0_ty,\n                    a1_ty\n                  ]\n                  let s3 = unify_call_args(param_tys, arg_tys, s2, errors, name, callee_off)\n                  match subst_apply(s3, a0_ty) {\n                    CtNamed(tg_name, tg_args) => if tg_name == \"TaskGroup\" && Array::length(tg_args) == 2 {\n                      let violations = check_spawnable_captures(env, s3, defs, Array::get(args, 1), Array::get(tg_args, 0))\n                      let mut vi = 0\n                      while vi < Array::length(violations) {\n                        Array::push(errors, String::concat(Array::get(violations, vi), off_marker_len(callee_off, String::length(name))))\n                        vi = vi + 1\n                      }\n                    } else {\n                      ()\n                    },\n                    _ => ()\n                  }\n                  (tab_call_ty(tytab, call_off, subst_apply(s3, ret_ty)), s3, c3)\n                },\n                _ => (tab_call_ty(tytab, call_off, CtUnknown), s0, c1)\n              }\n            },\n            None => {\n              Array::push(errors, String::concat(\"unknown name: \", name))\n              (tab_call_ty(tytab, call_off, CtUnknown), s, c)\n            }\n          }\n        } else {\n          match direct_call_return(env, name) {\n            Some(ret_ty) => {\n              let alen = Array::length(args)\n              let want_head = builtin_first_arg_head(name)\n              if name == \"Bytes::new\" {\n                if alen > 1 {\n                  Array::push(errors, String::concat(String::concat(\"function arity mismatch for \", String::concat(name, String::concat(\": expected 0 or 1 args, got \", __to_string(alen)))), off_marker_len(callee_off, String::length(name))))\n                } else {\n                  ()\n                }\n              } else {\n                let want_arity = builtin_fixed_arity(name)\n                if want_arity >= 0 && alen != want_arity {\n                  Array::push(errors, String::concat(String::concat(\"function arity mismatch for \", String::concat(name, String::concat(\": expected \", String::concat(__to_string(want_arity), String::concat(\" args, got \", __to_string(alen)))))), off_marker_len(callee_off, String::length(name))))\n                } else {\n                  ()\n                }\n              }\n              let mut ai = 0\n              let mut s2 = s\n              let mut c2 = c\n              while ai < alen {\n                let (at, ns, nc) = check_expr(Array::get(args, ai), env, defs, s2, c2, errors, tytab)\n                if ai == 0 && want_head != 0 {\n                  let got_head = head_kind(subst_apply(s2, at))\n                  if got_head != 0 && got_head != want_head {\n                    Array::push(errors, String::concat(String::concat(\"argument type mismatch for \", String::concat(name, \": receiver type \")), String::concat(type_to_string(subst_apply(s2, at)), off_marker_len(callee_off, String::length(name)))))\n                  } else if want_head == 9 && is_stream_named_type(subst_apply(s2, at)) {\n                    Array::push(errors, String::concat(String::concat(\"argument type mismatch for \", String::concat(name, \": receiver type \")), String::concat(type_to_string(subst_apply(s2, at)), String::concat(\" is a Stream, not an Array (iterate it with `for` / Stream::*)\", off_marker_len(callee_off, String::length(name))))))\n                  } else {\n                    ()\n                  }\n                } else if ai >= 1 {\n                  let want_rest = builtin_arg_head_rest(name, ai)\n                  if want_rest != 0 {\n                    let got_head = head_kind(subst_apply(s2, at))\n                    if got_head != 0 && got_head != want_rest {\n                      Array::push(errors, String::concat(String::concat(\"argument type mismatch for \", String::concat(name, String::concat(\" (arg \", String::concat(__to_string(ai), \"): \")))), String::concat(type_to_string(subst_apply(s2, at)), off_marker_len(callee_off, String::length(name)))))\n                    } else {\n                      ()\n                    }\n                  } else {\n                    ()\n                  }\n                } else {\n                  ()\n                }\n                s2 = ns\n                c2 = nc\n                ai = ai + 1\n              }\n              (tab_call_ty(tytab, call_off, subst_apply(s2, ret_ty)), s2, c2)\n            },\n            None => {\n              let method_form = if String::index_of(name, \"::\") < 0 && Array::length(args) >= 1 {\n                match env_lookup(env, name) {\n                  Some(_) => false,\n                  None => match lookup_builtin(name) {\n                    Some(_) => false,\n                    None => true\n                  }\n                }\n              } else {\n                false\n              }\n              let recv_method = if method_form {\n                let (a0_ty, sa, ca) = check_expr(Array::get(args, 0), env, defs, s, c, errors, tytab)\n                let recv_ty = subst_apply(sa, a0_ty)\n                let qual = String::concat(type_name_prefix(recv_ty), String::concat(\"::\", name))\n                let has_qual = match env_lookup(env, qual) {\n                  Some(_) => true,\n                  None => match lookup_builtin(qual) {\n                    Some(_) => true,\n                    None => false\n                  }\n                }\n                let user_recv = match recv_ty {\n                  CtEnum(_) => true,\n                  CtStruct(_) => true,\n                  CtNamed(_, _) => true,\n                  _ => false\n                }\n                if has_qual || user_recv {\n                  Some(check_expr(ECall(EDot(Array::get(args, 0), name, callee_off, callee_off), Array::slice(args, 1, Array::length(args)), call_off), env, defs, sa, ca, errors, tytab))\n                } else {\n                  None\n                }\n              } else {\n                None\n              }\n              match recv_method {\n                Some(rm) => rm,\n                None => {\n                  let (ct, s1, c1) = check_expr(EIdent(name, -1), env, defs, s, c, errors, tytab)\n                  let alen = Array::length(args)\n                  let arg_tys = array_empty()\n                  let mut ai = 0\n                  let mut s2 = s1\n                  let mut c2 = c1\n                  while ai < alen {\n                    let (at, ns, nc) = check_expr(Array::get(args, ai), env, defs, s2, c2, errors, tytab)\n                    Array::push(arg_tys, at)\n                    s2 = ns\n                    c2 = nc\n                    ai = ai + 1\n                  }\n                  let applied_callee_ty = match ct {\n                    CtFn(_, _, _) => ct,\n                    _ => subst_apply(s2, ct)\n                  }\n                  match applied_callee_ty {\n                    CtFn(param_tys, ret, _) => {\n                      let ret_box = Array::slice([\n                        ret\n                      ], 0, 1)\n                      let call_param_tys = param_tys\n                      let plen2 = Array::length(param_tys)\n                      let alen3 = Array::length(arg_tys)\n                      if alen3 != plen2 {\n                        Array::push(errors, String::concat(String::concat(\"function arity mismatch for \", String::concat(name, String::concat(\": expected \", String::concat(__to_string(plen2), String::concat(\" args, got \", __to_string(alen3)))))), off_marker_len(callee_off, String::length(name))))\n                      }\n                      let s3 = unify_call_args(call_param_tys, arg_tys, s2, errors, name, callee_off)\n                      let call_ret = Array::get(ret_box, 0)\n                      (tab_call_ty(tytab, call_off, subst_apply(s3, call_ret)), s3, c2)\n                    },\n                    CtStruct(sname) => (tab_call_ty(tytab, call_off, CtStruct(sname)), s2, c2),\n                    other => {\n                      let not_callable = match other {\n                        CtInt => true,\n                        CtDouble => true,\n                        CtBool => true,\n                        CtString => true,\n                        CtChar => true,\n                        CtUnit => true,\n                        CtBytes => true,\n                        CtTuple(_) => true,\n                        CtArray(_) => true,\n                        CtOption(_) => true,\n                        CtEnum(_) => true,\n                        _ => false\n                      }\n                      if not_callable {\n                        Array::push(errors, String::concat(String::concat(\"calling a non-function value: \", name), off_marker_len(callee_off, String::length(name))))\n                      } else {\n                        ()\n                      }\n                      (tab_call_ty(tytab, call_off, CtUnknown), s2, c2)\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      },\n      EDot(obj, method, _, qcall_field_off) => {\n        let qualified_key = match obj {\n          EIdent(ns, _) => match env_lookup(env, ns) {\n            Some(_) => None,\n            None => Some(String::concat(ns, String::concat(\".\", method)))\n          },\n          _ => None\n        }\n        let qualified_hit = match qualified_key {\n          Some(k) => env_lookup(env, k),\n          None => None\n        }\n        match qualified_hit {\n          Some(_) => match qualified_key {\n            Some(k) => check_expr(ECall(EIdent(k, qcall_field_off), args, call_off), env, defs, s, c, errors, tytab),\n            None => (CtUnknown, s, c)\n          },\n          None => {\n            let (obj_ty, s1, c1) = check_expr(obj, env, defs, s, c, errors, tytab)\n            let resolved = subst_apply(s1, obj_ty)\n            let type_prefix = type_name_prefix(resolved)\n            let qualified = String::concat(type_prefix, String::concat(\"::\", method))\n            let has_real_fn_binding = match env_lookup(env, qualified) {\n              Some(_) => true,\n              None => false\n            }\n            if !has_real_fn_binding && is_known_builtin_receiver_prefix(type_prefix) {\n              match lookup_builtin(qualified) {\n                Some(_) => {\n                  Array::push(errors, String::concat(\"dot-call syntax is not supported for the builtin method `\", String::concat(qualified, String::concat(\"` -- call it as `\", String::concat(qualified, String::concat(\"(...)`\", off_marker_len(qcall_field_off, String::length(method))))))))\n                  (tab_call_ty(tytab, call_off, CtUnknown), s1, c1)\n                },\n                None => {\n                  let bare_hint = match env_lookup(env, method) {\n                    Some(_) => String::concat(String::concat(\"(...)` (a bare `fn \", method), String::concat(\"` is only callable as `\", String::concat(method, String::concat(\"(x)` or `x |> \", String::concat(method, \"`)\"))))),\n                    None => \"(...)`\"\n                  }\n                  Array::push(errors, String::concat(String::concat(\"no method `\", String::concat(method, String::concat(\"` on `\", String::concat(type_prefix, \"`: declare a top-level `fn \")))), String::concat(qualified, String::concat(bare_hint, off_marker_len(qcall_field_off, String::length(method))))))\n                  (tab_call_ty(tytab, call_off, CtUnknown), s1, c1)\n                }\n              }\n            } else {\n              let direct_ret = direct_call_return(env, qualified)\n              let method_ty = match env_lookup(env, qualified) {\n                Some(t) => {\n                  let (ti, c2, _) = instantiate(t, c1)\n                  (ti, s1, c2)\n                },\n                None => match lookup_builtin(qualified) {\n                  Some(t) => (t, s1, c1),\n                  None => (CtUnknown, s1, c1)\n                }\n              }\n              let (mt, s2, c2) = method_ty\n              let all_args = prepend_expr(obj, args)\n              let alen = Array::length(all_args)\n              let arg_tys = array_empty()\n              Array::push(arg_tys, obj_ty)\n              let mut ai = 1\n              let mut s3 = s2\n              let mut c3 = c2\n              while ai < alen {\n                let (at, ns, nc) = check_expr(Array::get(all_args, ai), env, defs, s3, c3, errors, tytab)\n                Array::push(arg_tys, at)\n                s3 = ns\n                c3 = nc\n                ai = ai + 1\n              }\n              let applied_method_ty = match mt {\n                CtFn(_, _, _) => mt,\n                _ => subst_apply(s3, mt)\n              }\n              match applied_method_ty {\n                CtFn(param_tys, ret, _) => {\n                  let ret_box = Array::slice([\n                    ret\n                  ], 0, 1)\n                  let call_param_tys = param_tys\n                  let plen = Array::length(param_tys)\n                  let alen2 = Array::length(arg_tys)\n                  if alen2 != plen {\n                    Array::push(errors, String::concat(String::concat(\"function arity mismatch for \", String::concat(qualified, String::concat(\": expected \", String::concat(__to_string(plen), String::concat(\" args, got \", __to_string(alen2)))))), off_marker_len(call_off, String::length(qualified))))\n                  }\n                  let s4 = unify_call_args(call_param_tys, arg_tys, s3, errors, qualified, call_off)\n                  let call_ret = Array::get(ret_box, 0)\n                  let selected_ret = match direct_ret {\n                    Some(t) => t,\n                    None => call_ret\n                  }\n                  (tab_call_ty(tytab, call_off, subst_apply(s4, selected_ret)), s4, c3)\n                },\n                _ => {\n                  let field_fn = receiver_struct_field_type(defs, subst_apply(s3, obj_ty), method)\n                  match field_fn {\n                    Some(CtFn(fpts, fret, _)) => {\n                      let explicit = Array::slice(arg_tys, 1, Array::length(arg_tys))\n                      if Array::length(fpts) != Array::length(explicit) {\n                        Array::push(errors, String::concat(String::concat(\"function arity mismatch for \", String::concat(qualified, String::concat(\": expected \", String::concat(__to_string(Array::length(fpts)), String::concat(\" args, got \", __to_string(Array::length(explicit))))))), off_marker_len(call_off, String::length(qualified))))\n                      }\n                      let s4 = unify_call_args(fpts, explicit, s3, errors, qualified, call_off)\n                      (tab_call_ty(tytab, call_off, subst_apply(s4, fret)), s4, c3)\n                    },\n                    _ => match direct_ret {\n                      Some(t) => (tab_call_ty(tytab, call_off, t), s3, c3),\n                      None => {\n                        let no_field = match field_fn {\n                          None => true,\n                          _ => false\n                        }\n                        let local_user_ty = if type_prefix == \"\" {\n                          false\n                        } else {\n                          match find_typedef(defs, type_prefix) {\n                            Some(_) => true,\n                            None => false\n                          }\n                        }\n                        let has_method_binding = match env_lookup(env, qualified) {\n                          Some(_) => true,\n                          None => match lookup_builtin(qualified) {\n                            Some(_) => true,\n                            None => false\n                          }\n                        }\n                        if no_field && local_user_ty && !has_method_binding {\n                          let bare_hint = match env_lookup(env, method) {\n                            Some(_) => String::concat(String::concat(\"(...)` (a bare `fn \", method), String::concat(\"` is only callable as `\", String::concat(method, String::concat(\"(x)` or `x |> \", String::concat(method, \"`)\"))))),\n                            None => \"(...)`\"\n                          }\n                          Array::push(errors, String::concat(String::concat(\"no method `\", String::concat(method, String::concat(\"` on `\", String::concat(type_prefix, \"`: declare a top-level `fn \")))), String::concat(qualified, String::concat(bare_hint, off_marker_len(qcall_field_off, String::length(method))))))\n                        } else {\n                          ()\n                        }\n                        (tab_call_ty(tytab, call_off, CtUnknown), s3, c3)\n                      }\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      },\n      _ => {\n        let asc_ann = if Array::length(args) == 1 {\n          ascription_lambda_ann(callee)\n        } else {\n          None\n        }\n        match asc_ann {\n          Some(ann_te) => {\n            let (at, ns0, nc0) = check_expr(Array::get(args, 0), env, defs, s, c, errors, tytab)\n            let resolved = resolve_type_expr(ann_te, defs)\n            let actual = subst_apply(ns0, at)\n            let ns2 = check_assignable(resolved, actual, ns0, errors, \"binding type mismatch for a local let\", call_off)\n            let bound_ty = preserve_generic_instantiation(resolved, subst_apply(ns2, actual))\n            (tab_call_ty(tytab, call_off, bound_ty), ns2, nc0)\n          },\n          None => {\n            let callee_name0 = expr_ident_name_or_empty(callee)\n            if callee_name0 != \"\" {\n              match direct_call_return(env, callee_name0) {\n                Some(ret_ty) => {\n                  let alen = Array::length(args)\n                  let mut ai = 0\n                  let mut s2 = s\n                  let mut c2 = c\n                  while ai < alen {\n                    let (_, ns, nc) = check_expr(Array::get(args, ai), env, defs, s2, c2, errors, tytab)\n                    s2 = ns\n                    c2 = nc\n                    ai = ai + 1\n                  }\n                  (tab_call_ty(tytab, call_off, subst_apply(s2, ret_ty)), s2, c2)\n                },\n                None => {\n                  let (ct, s1, c1) = check_expr(callee, env, defs, s, c, errors, tytab)\n                  let alen = Array::length(args)\n                  let arg_tys = array_empty()\n                  let mut ai = 0\n                  let mut s2 = s1\n                  let mut c2 = c1\n                  while ai < alen {\n                    let (at, ns, nc) = check_expr(Array::get(args, ai), env, defs, s2, c2, errors, tytab)\n                    Array::push(arg_tys, at)\n                    s2 = ns\n                    c2 = nc\n                    ai = ai + 1\n                  }\n                  let applied_callee_ty = match ct {\n                    CtFn(_, _, _) => ct,\n                    _ => subst_apply(s2, ct)\n                  }\n                  match applied_callee_ty {\n                    CtFn(param_tys, ret, _) => {\n                      let ret_box = Array::slice([\n                        ret\n                      ], 0, 1)\n                      let call_param_tys = param_tys\n                      let plen2 = Array::length(param_tys)\n                      let alen3 = Array::length(arg_tys)\n                      if alen3 != plen2 {\n                        Array::push(errors, String::concat(String::concat(\"function arity mismatch for \", String::concat(callee_name0, String::concat(\": expected \", String::concat(__to_string(plen2), String::concat(\" args, got \", __to_string(alen3)))))), off_marker_len(call_off, String::length(callee_name0))))\n                      }\n                      let s3 = unify_call_args(call_param_tys, arg_tys, s2, errors, callee_name0, call_off)\n                      let call_ret = Array::get(ret_box, 0)\n                      (tab_call_ty(tytab, call_off, subst_apply(s3, call_ret)), s3, c2)\n                    },\n                    CtStruct(sname) => (tab_call_ty(tytab, call_off, CtStruct(sname)), s2, c2),\n                    _ => (tab_call_ty(tytab, call_off, CtUnknown), s2, c2)\n                  }\n                }\n              }\n            } else {\n              let (ct, s1, c1) = check_expr(callee, env, defs, s, c, errors, tytab)\n              let alen = Array::length(args)\n              let arg_tys = array_empty()\n              let mut ai = 0\n              let mut s2 = s1\n              let mut c2 = c1\n              while ai < alen {\n                let (at, ns, nc) = check_expr(Array::get(args, ai), env, defs, s2, c2, errors, tytab)\n                Array::push(arg_tys, at)\n                s2 = ns\n                c2 = nc\n                ai = ai + 1\n              }\n              let applied_callee_ty = match ct {\n                CtFn(_, _, _) => ct,\n                _ => subst_apply(s2, ct)\n              }\n              match applied_callee_ty {\n                CtFn(param_tys, ret, _) => {\n                  let ret_box = Array::slice([\n                    ret\n                  ], 0, 1)\n                  let call_param_tys = param_tys\n                  let plen2 = Array::length(param_tys)\n                  let alen3 = Array::length(arg_tys)\n                  if alen3 != plen2 {\n                    Array::push(errors, String::concat(String::concat(\"function arity mismatch for <expr>: expected \", String::concat(__to_string(plen2), String::concat(\" args, got \", __to_string(alen3)))), off_marker(call_off)))\n                  }\n                  let s3 = unify_call_args(call_param_tys, arg_tys, s2, errors, \"<expr>\", call_off)\n                  let call_ret = Array::get(ret_box, 0)\n                  (tab_call_ty(tytab, call_off, subst_apply(s3, call_ret)), s3, c2)\n                },\n                CtStruct(sname) => (tab_call_ty(tytab, call_off, CtStruct(sname)), s2, c2),\n                _ => (tab_call_ty(tytab, call_off, CtUnknown), s2, c2)\n              }\n            }\n          }\n        }\n      }\n    },\n    EBinOp(op, left, right) => {\n      let (left_ty, s1, c1) = check_expr(left, env, defs, s, c, errors, tytab)\n      let (right_ty, s2, c2) = check_expr(right, env, defs, s1, c1, errors, tytab)\n      let (result_ty, s3) = infer_binop_type(op, subst_apply(s2, left_ty), subst_apply(s2, right_ty), env, s2, errors, tytab)\n      (subst_apply(s3, result_ty), s3, c2)\n    },\n    EUnaryOp(op, operand) => {\n      let (operand_ty, s1, c1) = check_expr(operand, env, defs, s, c, errors, tytab)\n      if op == \"!\" {\n        match subst_apply(s1, operand_ty) {\n          CtBool => (CtBool, s1, c1),\n          CtVar(_) => match unify(operand_ty, CtBool, s1) {\n            Some(s2) => (CtBool, s2, c1),\n            None => (CtUnknown, s1, c1)\n          },\n          other => {\n            let flag = match other {\n              CtUnknown => false,\n              _ => type_is_ground(other)\n            }\n            if flag {\n              Array::push(errors, \"operand of `!` must be Bool\")\n            } else {\n              ()\n            }\n            (CtUnknown, s1, c1)\n          }\n        }\n      } else if op == \"-\" {\n        match subst_apply(s1, operand_ty) {\n          CtDouble => (CtDouble, s1, c1),\n          CtInt => (CtInt, s1, c1),\n          CtVar(_) => match unify(operand_ty, CtInt, s1) {\n            Some(s2) => (CtInt, s2, c1),\n            None => (CtUnknown, s1, c1)\n          },\n          other => {\n            let flag = match other {\n              CtUnknown => false,\n              _ => type_is_ground(other)\n            }\n            if flag {\n              Array::push(errors, \"operand of unary `-` must be Int or Double\")\n            } else {\n              ()\n            }\n            (CtUnknown, s1, c1)\n          }\n        }\n      } else (CtUnknown, s1, c1)\n    },\n    EAssign(name, val, body) => {\n      let (vt, s1, c1) = check_expr(val, env, defs, s, c, errors, tytab)\n      let s1b = match env_lookup(env, name) {\n        Some(var_ty) => check_assignable(var_ty, subst_apply(s1, vt), s1, errors, String::concat(\"assignment type mismatch for \", name), 0 - 1),\n        None => s1\n      }\n      check_expr(body, env, defs, s1b, c1, errors, tytab)\n    },\n    EAssignOp(_, _, val, body) => {\n      let (_, s1, c1) = check_expr(val, env, defs, s, c, errors, tytab)\n      check_expr(body, env, defs, s1, c1, errors, tytab)\n    },\n    EMatch(scrutinee, arms) => {\n      let (scr_ty, s1, c1) = check_expr(scrutinee, env, defs, s, c, errors, t