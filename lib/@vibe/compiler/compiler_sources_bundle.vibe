)\n  bytebuf_push(table_sec, 0)\n  leb128_encode_u32(table_sec, 4)\n  bytebuf_push_section(out, 4, table_sec)\n  let export_sec = bytebuf_new()\n  leb128_encode_u32(export_sec, 5)\n  emit_name(export_sec, \"fs_read_file\")\n  bytebuf_push(export_sec, 0)\n  leb128_encode_u32(export_sec, 0)\n  emit_name(export_sec, \"fs_exists\")\n  bytebuf_push(export_sec, 0)\n  leb128_encode_u32(export_sec, 1)\n  emit_name(export_sec, \"fs_read_dir\")\n  bytebuf_push(export_sec, 0)\n  leb128_encode_u32(export_sec, 2)\n  emit_name(export_sec, \"fs_stat_token\")\n  bytebuf_push(export_sec, 0)\n  leb128_encode_u32(export_sec, 3)\n  emit_name(export_sec, \"t\")\n  bytebuf_push(export_sec, 1)\n  leb128_encode_u32(export_sec, 0)\n  bytebuf_push_section(out, 7, export_sec)\n  let code_sec = bytebuf_new()\n  leb128_encode_u32(code_sec, 4)\n  let mut slot = 0\n  while slot < 4 {\n    let body = bytebuf_new()\n    leb128_encode_u32(body, 0)\n    emit_local_get(body, 0)\n    emit_i32_const(body, slot)\n    bytebuf_push(body, 17)\n    leb128_encode_u32(body, 0)\n    leb128_encode_u32(body, 0)\n    bytebuf_push(body, 11)\n    leb128_encode_u32(code_sec, Bytes::length(body))\n    bytebuf_push_buf(code_sec, body)\n    slot = slot + 1\n  }\n  bytebuf_push_section(out, 10, code_sec)\n  bytebuf_to_bytes(out)\n}\n\nfn comp_generate_vfs_realloc() -> Bytes {\n  let out = bytebuf_new()\n  emit_header(out)\n  let tc = bytebuf_new()\n  bytebuf_push_vec_header(tc, 1)\n  emit_func_type_raw(tc, [\n    127,\n    127,\n    127,\n    127\n  ], [\n    127\n  ])\n  bytebuf_push_section(out, 1, tc)\n  let import_sec = bytebuf_new()\n  leb128_encode_u32(import_sec, 2)\n  emit_name(import_sec, \"env\")\n  emit_name(import_sec, \"__heap_ptr\")\n  bytebuf_push(import_sec, 3)\n  bytebuf_push(import_sec, 127)\n  bytebuf_push(import_sec, 1)\n  emit_name(import_sec, \"env\")\n  emit_name(import_sec, \"memory\")\n  bytebuf_push(import_sec, 2)\n  bytebuf_push(import_sec, 0)\n  leb128_encode_u32(import_sec, 0)\n  bytebuf_push