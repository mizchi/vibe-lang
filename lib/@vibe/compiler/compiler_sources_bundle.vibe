  ("lib/@vibe/compiler/codegen/expr/compile_expr_tail6.vibe",
"\nimport @vibe/compiler/core {\n  Expr,\n  Pat,\n  Stmt,\n  TypeExpr,\n  bytebuf_length,\n  bytebuf_new,\n  bytebuf_push,\n  bytebuf_push_section,\n  bytebuf_push_vec_header,\n  bytebuf_to_bytes,\n  is_exception_throw_handler_name,\n  leb128_encode_s64,\n  leb128_encode_u32\n}\n\nimport @vibe/compiler/codegen/common_analysis {\n  collect_free_vars, collect_strings_stmts, emit_closure_call_tail, emit_closure_resolve, emit_i64_extend_i32_u, is_mut_captured_in\n}\n\nimport @vibe/compiler/codegen/common_base {\n  CompileCtx,\n  CtorTable,\n  FuncTable,\n  LambdaTable,\n  StrTable,\n  effect_name_to_tag,\n  effect_op_declared_arity,\n  effect_op_index,\n  emit_binop_op,\n  emit_i32_eq,\n  emit_i32_eqz,\n  emit_i32_ge_u,\n  emit_i32_mul,\n  emit_i32_ne,\n  emit_i32_sub,\n  emit_i64_load,\n  emit_i64_store,\n  emit_rc_dup_guarded,\n  emit_str_ref,\n  expr_tag,\n  get_arm_body,\n  get_arm_pat,\n  get_ebinop_op,\n  get_efn_body,\n  get_eif_cond,\n  get_eif_else,\n  get_eif_then,\n  get_elet_body,\n  get_elet_name,\n  get_elet_val,\n  get_slet_expr,\n  get_slet_name,\n  is_efn,\n  is_eident,\n  is_etuple,\n  is_pbind,\n  is_pbool,\n  is_pctor,\n  is_pint,\n  is_pstring,\n  is_ptuple,\n  is_pwild,\n  is_slet,\n  lookup_ctor,\n  resolve_func,\n  resolve_local\n}\n\nimport @vibe/compiler/codegen/common_extractors {\n  array_contains_str,\n  emit_assignop_op,\n  emit_memory_copy,\n  find_catchall_idx,\n  get_earray_elems,\n  get_eassign_body,\n  get_eassign_name,\n  get_eassign_val,\n  get_eassignop_body,\n  get_eassignop_name,\n  get_eassignop_op,\n  get_eassignop_val,\n  get_ebinop_lhs,\n  get_ebinop_rhs,\n  get_ebool_value,\n  get_ecall_args,\n  get_ecall_callee,\n  get_efloat_value,\n  get_efn_params,\n  get_eforin_body,\n  get_eforin_iter,\n  get_eforin_name,\n  get_eident_name,\n  get_eint_value,\n  get_eletmut_body,\n  get_eletmut_name,\n  get_eletmut_val,\n  get_eletrec_body,\n  get_eletrec_name,\n  get_eletrec_val,\n  get_eseq_first,\n  get_eseq_second,\n  get_estring_value,\n  get_etuple_elems,\n  get_eunaryop_expr,\n  get_eunaryop_op,\n  get_ewhile_body,\n  get_ewhile_cond,\n  get_match_arms,\n  get_match_scrutinee,\n  get_pbind_name,\n  get_pbool_value,\n  get_pctor_args,\n  get_pctor_name,\n  get_pint_value,\n  get_pstring_value,\n  get_ptuple_pats,\n  get_slet_export,\n  str_table_lookup\n}\n\nimport @vibe/compiler/codegen/wasm_emit {\n  emit_block_i64,\n  emit_block_void,\n  emit_br,\n  emit_br_if,\n  emit_call,\n  emit_call_indirect,\n  emit_code_section,\n  emit_code_section_with_locals,\n  emit_data_section,\n  emit_data_section_multi,\n  emit_drop,\n  emit_element_section_active,\n  emit_else,\n  emit_end,\n  emit_export_section,\n  emit_export_section_multi,\n  emit_exports_full,\n  emit_exports_with_memory,\n  emit_f64_add,\n  emit_f64_const_bits,\n  emit_f64_convert_i64_s,\n  emit_f64_div,\n  emit_f64_eq,\n  emit_f64_ge,\n  emit_f64_gt,\n  emit_f64_le,\n  emit_f64_lt,\n  emit_f64_mul,\n  emit_f64_ne,\n  emit_f64_neg,\n  emit_f64_reinterpret_i64,\n  emit_f64_sub,\n  emit_func_type_raw,\n  emit_function_section,\n  emit_global_get,\n  emit_global_section_i32_mut,\n  emit_global_set,\n  emit_header,\n  emit_i32_add,\n  emit_i32_const,\n  emit_i32_load,\n  emit_i32_load8_u,\n  emit_i32_store,\n  emit_i32_store8,\n  emit_i32_wrap_i64,\n  emit_i64_add,\n  emit_i64_and,\n  emit_i64_const,\n  emit_i64_div_s,\n  emit_i64_eq,\n  emit_i64_eqz,\n  emit_i64_extend_i32_s,\n  emit_i64_ge_s,\n  emit_i64_gt_s,\n  emit_i64_le_s,\n  emit_i64_lt_s,\n  emit_i64_mul,\n  emit_i64_ne,\n  emit_i64_or,\n  emit_i64_reinterpret_f64,\n  emit_i64_rem_s,\n  emit_i64_shl,\n  emit_i64_shr_s,\n  emit_i64_sub,\n  emit_i64_trunc_f64_s,\n  emit_i64_xor,\n  emit_if_i64,\n  emit_if_void,\n  emit_import_section_func,\n  emit_local_get,\n  emit_local_set,\n  emit_local_tee,\n  emit_loop_void,\n  emit_memory_section,\n  emit_name,\n  emit_return,\n  emit_table_section_funcref,\n  emit_type_section,\n  emit_type_section_multi,\n  string_to_data\n}\n\n\n\n\n\nexport fn compile_expr_tail6(buf: Bytes, body: Expr, arms: Array[(Pat, Expr)], local_names: Array[String], next_local: Int, ctx: CompileCtx, ld: Int, compile_expr: (Bytes, Expr, Array[String], Int, CompileCtx, Int) -> Int with { Error }) -> Int with { Error } {\n  if Array::length(arms) > 0 {\n    let (catch_pat, fallback_expr) = Array::get(arms, 0)\n    let is_error = is_pctor(catch_pat) && is_exception_throw_handler_name(get_pctor_name(catch_pat))\n    if !is_error {\n      bytebuf_push(buf, 0)\n      next_local\n    } else {\n      let catch_tag = 2\n      emit_block_i64(buf)\n      emit_loop_void(buf)\n      emit_block_i64(buf)\n      bytebuf_push(buf, 31)\n      bytebuf_push(buf, 126)\n      bytebuf_push(buf, 1)\n      bytebuf_push(buf, 0)\n      bytebuf_push(buf, catch_tag)\n      bytebuf_push(buf, 0)\n      let body_names_start = Array::length(local_names)\n      let body_ref_cells_start = Array::length(ctx.ref_cell_names)\n      let _nl1 = compile_expr(buf, body, local_names, next_local, ctx, ld)\n      let mut mask_i = body_names_start\n      while mask_i < Array::length(local_names) {\n        Array::set(local_names, mask_i, \"\")\n        mask_i = mask_i + 1\n      }\n      Array::truncate(ctx.ref_cell_names, body_ref_cells_start)\n      emit_end(buf)\n      emit_br(buf, 2)\n      emit_end(buf)\n      if is_pctor(catch_pat) {\n        let cargs = get_pctor_args(catch_pat)\n        let decl_arity = effect_op_declared_arity(ctx.effect_op_keys, ctx.effect_op_arities, get_pctor_name(catch_pat))\n        if decl_arity > 1 {\n          let ptr_l = Array::length(local_names)\n          emit_local_set(buf, ptr_l)\n          Array::push(local_names, \"__eff_payload\")\n          let ncargs = Array::length(cargs)\n          let mut ci = 0\n          while ci < decl_arity {\n            if ci < ncargs {\n              let cp = Array::get(cargs, ci)\n              if is_pbind(cp) {\n                let pname = get_pbind_name(cp)\n                let fl = Array::length(local_names)\n                emit_local_get(buf, ptr_l)\n                if ctx.enable_rc {\n                  emit_i64_const(buf, -2)\n                  emit_i64_and(buf)\n                } else {\n                  ()\n                }\n                emit_i32_wrap_i64(buf)\n                emit_i64_load(buf, 3, if ctx.enable_rc {\n                  8 + ci * 8\n                } else {\n                  ci * 8\n                })\n                emit_local_set(buf, fl)\n                Array::push(local_names, pname)\n                if ctx.enable_rc {\n                  emit_rc_dup_guarded(buf, fl, ctx.rc_shadow)\n                } else {\n                  ()\n                }\n              } else if is_pwild(cp) {\n                ()\n              } else {\n                throw(\"handle: only simple bindings or '_' are supported in multi-argument effect op patterns (see #548)\")\n              }\n            } else {\n              ()\n            }\n            ci = ci + 1\n          }\n          if ctx.enable_rc && ctx.rc_drop_func_idx >= 0 {\n            emit_local_get(buf, ptr_l)\n            emit_call(buf, ctx.rc_drop_func_idx)\n          } else {\n            ()\n          }\n        } else if Array::length(cargs) > 0 && is_pbind(Array::get(cargs, 0)) {\n          let pname = get_pbind_name(Array::get(cargs, 0))\n          let bl = Array::length(local_names)\n          emit_local_set(buf, bl)\n          Array::push(local_names, pname)\n        } else {\n          emit_drop(buf)\n        }\n      } else if is_pbind(catch_pat) {\n        let pname = get_pbind_name(catch_pat)\n        let bl = Array::length(local_names)\n        emit_local_set(buf, bl)\n        Array::push(local_names, pname)\n      } else {\n        emit_drop(buf)\n      }\n      emit_block_i64(buf)\n      bytebuf_push(buf, 31)\n      bytebuf_push(buf, 126)\n      bytebuf_push(buf, 1)\n      bytebuf_push(buf, 0)\n      bytebuf_push(buf, 1)\n      bytebuf_push(buf, 0)\n      let nl2 = compile_expr(buf, fallback_expr, local_names, Array::length(local_names), ctx, ld)\n      emit_end(buf)\n      emit_br(buf, 2)\n      emit_end(buf)\n      emit_drop(buf)\n      emit_br(buf, 0)\n      emit_end(buf)\n      bytebuf_push(buf, 0)\n      emit_end(buf)\n      let mut post_mask_i = body_names_start\n      while post_mask_i < Array::length(local_names) {\n        Array::set(local_names, post_mask_i, \"\")\n        post_mask_i = post_mask_i + 1\n      }\n      Array::truncate(ctx.ref_cell_names, body_ref_cells_start)\n      nl2\n    }\n  } else {\n    compile_expr(buf, body, local_names, next_local, ctx, ld)\n  }\n}\n")
}

