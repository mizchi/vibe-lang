  } else {\n          ()\n        }\n        (result_ty, si, ci)\n      }\n    },\n    EHandle(body, harms) => {\n      let hinst_seen = array_empty()\n      let mut hc0 = c\n      let mut henv_shared = env\n      let mut hpi = 0\n      while hpi < Array::length(harms) {\n        let (hppat, _) = Array::get(harms, hpi)\n        match hppat {\n          PCtor(hpq, _) => {\n            let hpci = String::index_of(hpq, \"::\")\n            if hpci > 0 {\n              let hpeff = String::substring(hpq, 0, hpci)\n              if effect_is_declared(defs, hpeff) && !flat_names_contain(hinst_seen, hpeff) {\n                let hpetps = effect_tparams(defs, hpeff)\n                if Array::length(hpetps) > 0 {\n                  let (hptargs, hpnc) = effect_fresh_targs(hpetps, hc0)\n                  hc0 = hpnc\n                  Array::push(hinst_seen, hpeff)\n                  henv_shared = env_bind(henv_shared, effect_inst_env_key(hpeff), CtTuple(hptargs))\n                } else {\n                  ()\n                }\n              } else {\n                ()\n              }\n            } else {\n              ()\n            }\n          },\n          _ => ()\n        }\n        hpi = hpi + 1\n      }\n      let (hty, hs, hc) = check_expr(body, henv_shared, defs, s, hc0, errors, tytab)\n      let mut hs1 = hs\n      let mut hc1 = hc\n      let mut hres: Type = hty\n      let mut hai = 0\n      while hai < Array::length(harms) {\n        let (hpat, hbody) = Array::get(harms, hai)\n        match hpat {\n          PCtor(hqname, hbinds) => {\n            let hci = String::index_of(hqname, \"::\")\n            if hci > 0 && effect_is_declared(defs, String::substring(hqname, 0, hci)) {\n              match effect_op_sig(defs, hqname) {\n                Some(hsig) => {\n                  let (hparams_decl, hret_decl) = hsig\n                  let heff_name = String::substring(hqname, 0, hci)\n                  let hetps = effect_tparams(defs, heff_name)\n            