"\nimport @vibe/compiler/core {\n  Expr, Pat, Stmt, TypeExpr\n}\n\nimport @vibe/core {\n  array_empty\n}\n\n\nexport fn strip_generic_type_params(stmts: Array[Stmt]) -> Unit {\n  let empty_tp = array_empty()\n  let empty_bounds = array_empty()\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SLet(sl_exp, sl_rec, sl_name, sl_ann, sl_expr) => match sl_expr {\n        EFn(tparams, _, params, ret, eff, body) => if Array::length(tparams) > 0 {\n          Array::set(stmts, i, SLet(sl_exp, sl_rec, sl_name, sl_ann, EFn(empty_tp, empty_bounds, params, ret, eff, body)))\n        }\n        ,\n        _ => ()\n      },\n      _ => ()\n    }\n    i = i + 1\n  }\n}\n")
}

let source_233 = () -> (String, String) {
  ("lib/@vibe/compiler/entry/source_compile/wasi_only/preprocess_interp.vibe",
"\nimport @vibe/compiler/core {\n  Stmt\n}\n\n\nimport @vibe/compiler/codegen {\n  desugar_trait_dicts\n}\n\n\nexport fn expand_interp_stmts(stmts: Array[Stmt]) -> Unit with { Error } {\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SLet(exp, is_rec, name, ann, expr) => Array::set(stmts, i, SLet(exp, is_rec, name, ann, rewrite_interp(expr)))\n      ,\n      STest(name, expr) => Array::set(stmts, i, STest(name, rewrite_interp(expr)))\n      ,\n      SBench(name, expr) => Array::set(stmts, i, SBench(name, rewrite_interp(expr)))\n      ,\n      _ => ()\n    }\n    i = i + 1\n  }\n  desugar_trait_dicts(stmts)\n}\n")
}

