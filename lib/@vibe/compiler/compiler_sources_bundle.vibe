comp_core_host_stream_names(core_wasm: Bytes) -> Array[String] {\n  let imp_modules = array_empty()\n  let imp_names = array_empty()\n  let imp_type_indices = new_int_array()\n  let imp_type_sigs = array_empty()\n  let import_count = parse_core_imports(core_wasm, imp_modules, imp_names, imp_type_indices, imp_type_sigs)\n  let out = array_empty()\n  let mut i = 0\n  while i < import_count {\n    let nm = Array::get(imp_names, i)\n    if Array::get(imp_modules, i) == \"vibe\" && comp_is_host_stream_get_import(nm) {\n      Array::push(out, nm)\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  out\n}\n\nfn comp_hoststream_import_label(core_name: String) -> String {\n  String::substring(core_name, String::length(\"host_stream_get$\"), String::length(core_name))\n}\n\nfn comp_is_host_future_get_import(nm: String) -> Bool {\n  nm == \"host_future_get\" || String::starts_with(nm, \"host_future_get$\")\n}\n\nexport fn comp_core_host_future_names(core_wasm: Bytes) -> Array[String] {\n  let imp_modules = array_empty()\n  let imp_names = array_empty()\n  let imp_type_indices = new_int_array()\n  let imp_type_sigs = array_empty()\n  let import_count = parse_core_imports(core_wasm, imp_modules, imp_names, imp_type_indices, imp_type_sigs)\n  let out = array_empty()\n  let mut i = 0\n  while i < import_count {\n    let nm = Array::get(imp_names, i)\n    if Array::get(imp_modules, i) == \"vibe\" && comp_is_host_future_get_import(nm) {\n      Array::push(out, nm)\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  out\n}\n\nfn comp_hf_value_base() -> Int {\n  4096\n}\n\nfn comp_hf_state_base() -> Int {\n  8192\n}\n\nfn comp_hs_value_base() -> Int {\n  12288\n}\n\nfn comp_hs_closed_base() -> Int {\n  16384\n}\n\nfn comp_hf_max_handles() -> Int {\n  1023\n}\n\nfn comp_hostfuture_import_label(core_name: String) -> String {\n  if core_name == \"host_future_get\" {\n    \"get-future\"\n  } else {\n    String::substring(core_name, String::length(\"host_future_get$\"), String::length(core_name))\n  }\n}\n\nfn comp_generate_hostfuture_adapter_core_module(core_names: Array[String], stream_core_names: Array[String], want_stream_close: Bool) -> Bytes {\n  let nnames = Array::length(core_names)\n  let nstreams = Array::length(stream_core_names)\n  let read_idx = nnames\n  let drop_idx = nnames + 1\n  let ws_base = if nnames > 0 {\n    nnames + 2\n  } else {\n    0\n  }\n  let ws_new_idx = ws_base\n  let join_idx = ws_base + 1\n  let ws_wait_idx = ws_base + 2\n  let ws_drop_idx = ws_base + 3\n  let sget_base = ws_base + 4\n  let sread_idx = sget_base + nstreams\n  let sdrop_idx = sget_base + nstreams + 1\n  let nfunc_imports = if nstreams > 0 {\n    sget_base + nstreams + 2\n  } else {\n    ws_base + 4\n  }\n  let out = bytebuf_new()\n  emit_header(out)\n  let tc = bytebuf_new()\n  bytebuf_push_vec_header(tc, if nstreams > 0 {\n    8\n  } else {\n    7\n  })\n  emit_func_type_raw(tc, [\n    127\n  ], [\n    127\n  ])\n  emit_func_type_raw(tc, [\n    127,\n    127\n  ], [\n    127\n  ])\n  emit_func_type_raw(tc, [\n    127\n  ], array_empty())\n  emit_func_type_raw(tc, array_empty(), [\n    127\n  ])\n  emit_func_type_raw(tc, [\n    127,\n    127\n  ], array_empty())\n  emit_func_type_raw(tc, array_empty(), [\n    126\n  ])\n  emit_func_type_raw(tc, [\n    126\n  ], [\n    126\n  ])\n  if nstreams > 0 {\n    emit_func_type_raw(tc, [\n      127,\n      127,\n      127\n    ], [\n      127\n    ])\n  } else {\n    ()\n  }\n  bytebuf_push_section(out, 1, tc)\n  let ic = bytebuf_new()\n  bytebuf_push_vec_header(ic, nfunc_imports + 1)\n  let mut imp_i = 0\n  while imp_i < nnames {\n    emit_name(ic, \"$root\")\n    emit_name(ic, String::concat(\"[async-lower]\", comp_hostfuture_import_label(Array::get(core_names, imp_i))))\n    bytebuf_push(ic, 0)\n    bytebuf_push(ic, 0)\n    imp_i = imp_i + 1\n  }\n  if nnames > 0 {\n    let first_label = comp_hostfuture_import_label(Array::get(core_names, 0))\n    emit_name(ic, \"$root\")\n    emit_name(ic, String::concat(\"[async-lower][future-read-0]\", first_label))\n    bytebuf_push(ic, 0)\n    bytebuf_push(ic, 1)\n    emit_name(ic, \"$root\")\n    emit_name(ic, String::concat(\"[future-drop-readable-0]\", first_label))\n    bytebuf_push(ic, 0)\n    bytebuf_push(ic, 2)\n  } else {\n    ()\n  }\n  emit_name(ic, \"$root\")\n  emit_name(ic, \"[waitable-set-new]\")\n  bytebuf_push(ic, 0)\n  bytebuf_push(ic, 3)\n  emit_name(ic, \"$root\")\n  emit_name(ic, \"[waitable-join]\")\n  bytebuf_push(ic, 0)\n  bytebuf_push(ic, 4)\n  emit_name(ic, \"$root\")\n  emit_name(ic, \"[waitable-set-wait]\")\n  bytebuf_push(ic, 0)\n  bytebuf_push(ic, 1)\n  emit_name(ic, \"$root\")\n  emit_name(ic, \"[waitable-set-drop]\")\n  bytebuf_push(ic, 0)\n  bytebuf_push(ic, 2)\n  if nstreams > 0 {\n    let mut simp_i = 0\n    while simp_i < nstreams {\n      emit_name(ic, \"$root\")\n      emit_name(ic, String::concat(\"[async-lower]\", comp_hoststream_import_label(Array::get(stream_core_names, simp_i))))\n      bytebuf_push(ic, 0)\n      bytebuf_push(ic, 0)\n      simp_i = simp_i + 1\n    }\n    let s_first_label = comp_hoststream_import_label(Array::get(stream_core_names, 0))\n    emit_name(ic, \"$root\")\n    emit_name(ic, String::concat(\"[async-lower][stream-read-0]\", s_first_label))\n    bytebuf_push(ic, 0)\n    bytebuf_push(ic, 7)\n    emit_name(ic, \"$root\")\n    emit_name(ic, String::concat(\"[stream-drop-readable-0]\", s_first_label))\n    bytebuf_push(ic, 0)\n    bytebuf_push(ic, 2)\n  } else {\n    ()\n  }\n  emit_name(ic, \"env\")\n  emit_name(ic, \"memory\")\n  bytebuf_push(ic, 2)\n  bytebuf_push(ic, 0)\n  leb128_encode_u32(ic, 1)\n  bytebuf_push_section(out, 2, ic)\n  let fn_types = new_int_array()\n  let export_names = array_empty()\n  let export_indices = new_int_array()\n  let mut fs_i = 0\n  while fs_i < nnames {\n    Array::push(fn_types, 5)\n    Array::push(export_names, Array::get(core_names, fs_i))\n    Array::push(export_indices, nfunc_imports + fs_i)\n    fs_i = fs_i + 1\n  }\n  if nnames > 0 {\n    Array::push(fn_types, 6)\n    Array::push(export_names, \"host_future_wait\")\n    Array::push(export_indices, nfunc_imports + nnames)\n  } else {\n    ()\n  }\n  let s_local_base = if nnames > 0 {\n    nfunc_imports + nnames + 1\n  } else {\n    nfunc_imports\n  }\n  let mut sfs_i = 0\n  while sfs_i < nstreams {\n    Array::push(fn_types, 5)\n    Array::push(export_names, Array::get(stream_core_names, sfs_i))\n    Array::push(export_indices, s_local_base + sfs_i)\n    sfs_i = sfs_i + 1\n  }\n  if nstreams > 0 {\n    Array::push(fn_types, 6)\n    Array::push(export_names, \"host_stream_read\")\n    Array::push(export_indices, s_local_base + nstreams)\n  } else {\n    ()\n  }\n  if nstreams > 0 && want_stream_close {\n    Array::push(fn_types, 6)\n    Array::push(export_names, \"host_stream_close\")\n    Array::push(export_indices, s_local_base + nstreams + 1)\n  } else {\n    ()\n  }\n  emit_function_section(out, fn_types)\n  emit_export_section_multi(out, export_names, export_indices)\n  let code_sec = bytebuf_new()\n  leb128_encode_u32(code_sec, Array::length(fn_types))\n  let mut get_i = 0\n  while get_i < nnames {\n    let get_body = bytebuf_new()\n    leb128_encode_u32(get_body, 1)\n    leb128_encode_u32(get_body, 3)\n    bytebuf_push(get_body, 127)\n    emit_i32_const(get_body, 8)\n    emit_call(get_body, get_i)\n    emit_local_set(get_body, 0)\n    emit_local_get(get_body, 0)\n    emit_i32_const(get_body, 15)\n    emit_i32_and(get_body)\n    emit_i32_const(get_body, 2)\n    emit_i32_ne(get_body)\n    emit_if_void(get_body)\n    bytebuf_push(get_body, 0)\n    emit_end(get_body)\n    emit_i32_const(get_body, 8)\n    emit_i32_load(get_body, 2, 0)\n    emit_local_set(get_body, 1)\n    emit_local_get(get_body, 1)\n    emit_i32_const(get_body, comp_hf_max_handles())\n    emit_i32_gt_u(get_body)\n    emit_if_void(get_body)\n    bytebuf_push(get_body, 0)\n    emit_end(get_body)\n    emit_local_get(get_body, 1)\n    emit_i32_const(get_body, 2)\n    emi