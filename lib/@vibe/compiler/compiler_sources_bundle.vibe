fn_body) =>\n    compile_lambda_gc(buf, params, fn_body, local_names, next_local, ctx, ld, compile_expr_gc),\n    EDot(obj, field, _, _) => {\n      let fc0 = String::char_code_at(field, 0)\n      if fc0 >= 48 && fc0 <= 57 {\n        let mut tidx = 0\n        let mut tp = 0\n        while tp < String::length(field) {\n          tidx = tidx * 10 + (String::char_code_at(field, tp) - 48)\n          tp = tp + 1\n        }\n        let nl_t = ce(buf, obj, local_names, next_local, ld)\n        emit_i32_wrap_i64(buf)\n        emit_i64_load(buf, 3, tidx * 8)\n        return nl_t\n      }\n      let cands = struct_field_candidates(ctx.gc_ctor_table, field)\n      if Array::length(cands) == 0 {\n        throw(String::concat(\"unknown struct field: \", field))\n      }\n      let (_, idx0) = Array::get(cands, 0)\n      let dispatch = struct_field_dispatch_cases(cands)\n      let nl1 = ce(buf, obj, local_names, next_local, ld)\n      emit_i64_const(buf, -2)\n      emit_i64_and(buf)\n      if Array::length(dispatch) == 0 {\n        emit_i32_wrap_i64(buf)\n        emit_i64_load(buf, 3, 8 + idx0 * 8)\n        nl1\n      } else {\n        let obj_l = nl1\n        Array::push(local_names, \"__dot_obj\")\n        emit_local_set(buf, obj_l)\n        let mut di = 0\n        while di < Array::length(dispatch) {\n          let (dtag, didx) = Array::get(dispatch, di)\n          emit_local_get(buf, obj_l)\n          emit_i32_wrap_i64(buf)\n          emit_i32_load(buf, 2, 0)\n          emit_i32_const(buf, dtag)\n          emit_i32_eq(buf)\n          emit_if_i64(buf)\n          emit_local_get(buf, obj_l)\n          emit_i32_wrap_i64(buf)\n          emit_i64_load(buf, 3, 8 + didx * 8)\n          emit_else(buf)\n          di = di + 1\n        }\n        emit_local_get(buf, obj_l)\n        emit_i32_wrap_i64(buf)\n        emit_i64_load(buf, 3, 8 + idx0 * 8)\n        let mut de = 0\n        while de < Array::length(dispatch) {\n          emit_end(buf)\n          de = de + 1\n        }\n        nl1 + 1\n      }\n    },\n    ERecord(_, fields, _) => {\n      let flen = Array::length(fields)\n      let lit_names = array_empty()\n      let mut lni = 0\n      while lni < flen {\n        let (lfn, _) = Array::get(fields, lni)\n        Array::push(lit_names, lfn)\n        lni = lni + 1\n      }\n      let rec_si = struct_index_by_field_set(ctx.gc_ctor_table, lit_names)\n      let rec_tag = if rec_si >= 0 {\n        struct_tag_by_index(ctx.gc_ctor_table, rec_si)\n      } else {\n        0\n      }\n      let rec_fields = if rec_si >= 0 {\n        let def_fnames = Array::get(ctx.gc_ctor_table.struct_field_names, rec_si)\n        let ordered = array_empty()\n        let mut oi = 0\n        while oi < Array::length(def_fnames) {\n          let target_name = Array::get(def_fnames, oi)\n          let mut ri2 = 0\n          while ri2 < flen {\n            let (rfn, rfv) = Array::get(fields, ri2)\n            if rfn == target_name {\n              Array::push(ordered, (rfn, rfv))\n              ri2 = flen\n            } else {\n              ri2 = ri2 + 1\n            }\n          }\n          oi = oi + 1\n        }\n        ordered\n      } else {\n        fields\n      }\n      let obj_size = 8 + flen * 8\n      let ptr_local = next_local\n      Array::push(local_names, \"__rec_ptr\")\n      emit_global_get(buf, 0)\n      emit_i64_extend_i32_u(buf)\n      emit_local_set(buf, ptr_local)\n      emit_global_get(buf, 0)\n      emit_i32_const(buf, obj_size)\n      emit_i32_add(buf)\n      emit_global_set(buf, 0)\n      emit_heap_memory_grow_check(buf)\n      emit_local_get(buf, ptr_local)\n      emit_i32_wrap_i64(buf)\n      emit_i32_const(buf, rec_tag)\n      emit_i32_store(buf, 2, 0)\n      emit_local_get(buf, ptr_local)\n      emit_i32_wrap_i64(buf)\n      emit_i32_const(buf, flen)\n      emit_i32_store(buf, 2, 4)\n      let mut nl_r = next_local + 1\n      let mut ri = 0\n      while ri < flen {\n        let (_, fexpr) = Array::get(rec_fields, ri)\n        nl_r = ce(buf, fexpr, local_names, nl_r, ld)\n        let val_local = nl_r\n        Array::push(local_names, \"__rec_val\")\n        emit_local_set(buf, val_local)\n        nl_r = nl_r + 1\n        emit_local_get(buf, ptr_local)\n        emit_i32_wrap_i64(buf)\n        emit_local_get(buf, val_local)\n        emit_i64_store(buf, 3, 8 + ri * 8)\n        ri = ri + 1\n      }\n      emit_local_get(buf, ptr_local)\n      emit_i64_const(buf, 1)\n      emit_i64_or(buf)\n      nl_r\n    },\n    EHandle(body, harms) => {\n      if Array::length(harms) == 0 {\n        ce(buf, body, local_names, next_local, ld)\n      } else {\n        let (hpat, hexpr) = Array::get(harms, 0)\n        let mut hpat_ok = false\n        match hpat {\n          PCtor(hname, _) => {\n            if is_exception_throw_handler_name(hname) {\n              hpat_ok = true\n            }\n          },\n          _ => ()\n        }\n        if !hpat_ok {\n          throw(\"GC codegen: only `with Error` or `with Exception` abortive Throw handlers are supported (algebraic effect handlers need the linear backend)\")\n        }\n        emit_block_i64(buf)\n        emit_block_i64(buf)\n        bytebuf_push(buf, 31)\n        bytebuf_push(buf, 126)\n        leb128_encode_u32(buf, 1)\n        bytebuf_push(buf, 0)\n        leb128_encode_u32(buf, 0)\n        leb128_encode_u32(buf, 0)\n        let body_ld = if ld >= 0 {\n          ld + 3\n        } else {\n          -1\n        }\n        let nl_b = ce(buf, body, local_names, next_local, body_ld)\n        emit_end(buf)\n        emit_br(buf, 1)\n        emit_end(buf)\n        let names_before_h = Array::length(local_names)\n        let mut nl_h = nl_b\n        match hpat {\n          PCtor(_, hargs) => {\n            if Array::length(hargs) > 0 {\n              match Array::get(hargs, 0) {\n                PBind(hbname) => {\n                  let hb_l = Array::length(local_names)\n                  emit_local_set(buf, hb_l)\n                  Array::push(local_names, hbname)\n                  if hb_l + 1 > nl_h {\n                    nl_h = hb_l + 1\n                  }\n                },\n                _ => emit_drop(buf)\n              }\n            } else {\n              emit_drop(buf)\n            }\n          },\n          _ => emit_drop(buf)\n        }\n        let harm_ld = if ld >= 0 {\n          ld + 1\n        } else {\n          -1\n        }\n        let nl_h2 = ce(buf, hexpr, local_names, Array::length(local_names), harm_ld)\n        emit_end(buf)\n        Array::truncate(local_names, names_before_h)\n        agg_log_reset_above(ctx.gc_agg_local_slots, names_before_h)\n        gc_slot_log_reset_above(ctx.gc_bool_locals, names_before_h)\n        gc_slot_log_reset_above(ctx.gc_float_locals, names_before_h)\n        if nl_h2 > nl_h {\n          nl_h = nl_h2\n        }\n        nl_h\n      }\n    },\n    ELabeledArg(_, _, lval) => ce(buf, lval, local_names, next_local, ld),\n    EMap(mfields) => {\n      let mflen = Array::length(mfields)\n      let mcap = if mflen > 32 {\n        mflen\n      } else {\n        32\n      }\n      let malloc_size = 8 + mcap * 16\n      let mptr = next_local\n      Array::push(local_names, \"__maplit_ptr\")\n      emit_global_get(buf, 0)\n      emit_i64_extend_i32_u(buf)\n      emit_local_set(buf, mptr)\n      emit_global_get(buf, 0)\n      emit_i32_const(buf, malloc_size)\n      emit_i32_add(buf)\n      emit_global_set(buf, 0)\n      emit_heap_memory_grow_check(buf)\n      emit_local_get(buf, mptr)\n      emit_i32_wrap_i64(buf)\n      emit_i32_const(buf, mflen)\n      emit_i32_store(buf, 2, 0)\n      emit_local_get(buf, mptr)\n      emit_i32_wrap_i64(buf)\n      emit_i32_const(buf, mcap)\n      emit_i32_store(buf, 2, 4)\n      let mut mnl = next_local + 1\n      let mut mi = 0\n      while mi < mflen {\n        let (mkey, mval) = Array::get(mfields, mi)\n        let mk_idx = str_table_lookup(ctx.str_table.strs, mkey)\n        emit_local_get(buf, mptr)\n        emit_i32_wrap_i64(buf)\n        emit_str_ref(buf, Array::get(ctx.str_table.offsets, mk_idx), Array::get(ctx.str_table.lengths, mk_idx))\n        emit_i64_store(buf, 3, 8 + mi * 16)\n        emit_local_get(buf, mptr)\n        emit_i32_wrap_i64(buf)\n        mnl = ce(buf, mval, local_names, mnl, ld)\n        emit_i64_store(buf, 3, 16 + mi * 16)\n        mi = mi + 1\n      }\n      emit_local_get(buf, mptr)\n      mnl\n    },\n    EStringInterp(_) => throw(\"GC codegen: EStringInterp must be resolved before codegen (call resolve_interp_stmts first)\"),\n    _ => throw(String::concat(\"unsupported expression in gc codegen: tag \", __to_string(expr_tag(expr))))\n  }\n}\n\n\nexport {\n  compile_expr_gc\n}\n")
}

let source_148 = () -> (String, String) {
  ("lib/@vibe/compiler/codegen/gc/backend_call.vibe",
"\nimport @vibe/compiler/core {\n  Expr,\n  Pat,\n  Stmt,\n  TypeExpr,\n  bytebuf_length,\n  bytebuf_new,\n  bytebuf_push,\n  bytebuf_push_section,\n  bytebuf_push_vec_header,\n  bytebuf_to_bytes,\n  is_exception_operation_name,\n  is_exception_throw_operation,\n  leb128_encode_s64,\n  leb128_encode_u32\n}\n\nimport @vibe/core {\n  array_empty\n}\n\nimport @vibe/compiler/codegen/common_analysis {\n  collect_free_vars, collect_strings_stmts, emit_closure_call_tail, emit_closure_resolve, emit_i64_extend_i32_u, is_mut_captured_in\n}\n\nimport @vibe/compiler/codegen/common_base {\n  CompileCtxGc,\n  CtorTable,\n  FuncTable,\n  LambdaTable,\n  StrTable,\n  canonical_builtin_name,\n  ctor_table_index_of,\n  double_to_string_expr,\n  emit_binop_op,\n  emit_i32_eq,\n  emit_i32_eqz,\n  emit_i32_ge_u,\n  emit_i32_gt_u,\n  emit_i32_mul,\n  emit_i32_ne,\n  emit_i32_sub,\n  emit_i64_load,\n  emit_i64_store,\n  emit_str_ref,\n  expr_tag,\n  find_func_stmt,\n  find_local_slot,\n  is_eident,\n  resolve_func,\n  resolve_local,\n  struct_field_candidates,\n  struct_field_dispatch_cases\n}\n\nimport @vibe/compiler/codegen/common_extractors {\n  array_contains_int,\n  emit_assignop_op,\n  emit_memory_copy,\n  find_catchall_idx,\n  get_ecall_args,\n  get_ecall_callee,\n  get_eident_name,\n  get_estring_value,\n  str_table_lookup\n}\n\nimport @vibe/compiler/codegen/wasm_emit {\n  emit_block_i64,\n  emit_block_void,\n  emit_br,\n  emit_br_if,\n  emit_call,\n  emit_call_indirect,\n  emit_code_section,\n  emit_code_section_with_locals,\n  emit_data_section,\n  emit_data_section_multi,\n  emit_drop,\n  emit_element_section_active,\n  emit_else,\n  emit_end,\n  emit_export_section,\n  emit_export_section_multi,\n  emit_exports_with_memory,\n  emit_f64_add,\n  emit_f64_const_bits,\n  emit_f64_convert_i64_s,\n  emit_f64_div,\n  emit_f64_eq,\n  emit_f64_ge,\n  emit_f64_gt,\n  emit_f64_le,\n  emit_f64_lt,\n  emit_f64_mul,\n  emit_f64_ne,\n  emit_f64_neg,\n  emit_f64_reinterpret_i64,\n  emit_f64_sub,\n  emit_func_type_raw,\n  emit_function_section,\n  emit_global_get,\n  emit_global_section_i32_mut,\n  emit_global_set,\n  emit_header,\n  emit_heap_memory_grow_check,\n  emit_i32_add,\n  emit_i32_const,\n  emit_i32_load,\n  emit_i32_load8_u,\n  emit_i32_store,\n  emit_i32_store8,\n  emit_i32_wrap_i64,\n  emit_i64_add,\n  emit_i64_and,\n  emit_i64_const,\n  emit_i64_div_s,\n  emit_i64_eq,\n  emit_i64_eqz,\n  emit_i64_extend_i32_s,\n  emit_i64_ge_s,\n  emit_i64_gt_s,\n  emit_i64_le_s,\n  emit_i64_lt_s,\n  emit_i64_mul,\n  emit_i64_ne,\n  emit_i64_or,\n  emit_i64_reinterpret_f64,\n  emit_i64_rem_s,\n  emit_i64_shl,\n  emit_i64_shr_s,\n  emit_i64_sub,\n  emit_i64_trunc_f64_s,\n  emit_i64_xor,\n  emit_if_i64,\n  emit_if_void,\n  emit_import_section_func,\n  emit_local_get,\n  emit_local_set,\n  emit_local_tee,\n  emit_loop_void,\n  emit_memory_section,\n  emit_name,\n  emit_return,\n  emit_struct_get,\n  emit_struct_new,\n  emit_struct_set,\n  emit_struct_type_raw,\n  emit_table_section_funcref,\n  emit_type_section,\n  emit_type_section_multi,\n  string_to_data\n}\n\n\n\n\n\n\n\n\n\n\nfn emit_call_resolved(buf: Bytes, ctx: CompileCtxGc, fidx: Int) -> Unit {\n  if ctx.func_offset > 0 && fidx >= ctx.func_offset {\n    emit_i64_const(buf, 0)\n  } else {\n    ()\n  }\n  emit_call(buf, fidx)\n}\n\nfn gc_resolve_builtin_last(ft: FuncTable, name: String) -> Int {\n  let mut i = Array::length(ft.names) - 1\n  let mut found = -1\n  while i >= 0 {\n    if found < 0 && Array::get(ft.names, i) == name {\n      found = Array::get(ft.indices, i)\n      i = -1\n    } else {\n      i = i - 1\n    }\n  }\n  found\n}\n\nfn bc_expr_is_floatish(e: Expr, local_names: Array[String], ctx: CompileCtxGc) -> Bool {\n  match e {\n    EFloat(_) => true,\n    EIdent(fname, _) => {\n      let slot = find_local_slot(local_names, fname)\n      slot >= 0 && array_contains_int(ctx.gc_float_locals, slot)\n    },\n    EBinOp(op, l, r) => (op == \"+\" || op == \"-\" || op == \"*\" || op == \"/\") && (bc_expr_is_floatish(l, local_names, ctx) || bc_expr_is_floatish(r, local_names, ctx)),\n    EUnaryOp(op, x) => op == \"-\" && bc_expr_is_floatish(x, local_names, ctx),\n    ECall(fcallee, _, _) => match fcallee {\n      EIdent(cn, _) => cn == \"Int::to_double\" || cn == \"Double::from_i64_bits\" || cn == \"Float::to_double\" || cn == \"Double::to_float\" || cn == \"Int::to_float\",\n      _ => false\n    },\n    _ => false\n  }\n}\n\nfn bc_expr_is_boolish(e: Expr, local_names: Array[String], ctx: CompileCtxGc) -> Bool {\n  match e {\n    EBool(_) => true,\n    EIdent(fname, _) => {\n      let slot = find_local_slot(local_names, fname)\n      slot >= 0 && array_contains_int(ctx.gc_bool_locals, slot)\n    },\n    EBinOp(op, _, _) => op == \"==\" || op == \"!=\" || op == \"<\" || op == \">\" || op == \"<=\" || op == \">=\" || op == \"&&\" || op == \"||\",\n    EUnaryOp(op, _) => op == \"!\",\n    _ => false\n  }\n}\n\nfn compile_call_gc(buf: Bytes, callee: Expr, args: Array[Expr], local_names: Array[String], next_local: Int, ctx: CompileCtxGc, ld: Int, ce: (Bytes, Expr, Array[String], Int, Int) -> Int with { Error }) -> Int with { Error } {\n  match callee {\n    EIdent(fname, _) => {\n      let ctor_lookup_idx = ctor_table_index_of(ctx.gc_ctor_table, fname)\n      if ctor_lookup_idx >= 0 {\n        let tag = Array::get(ctx.gc_ctor_table.tags, ctor_lookup_idx)\n        let fc = Array::get(ctx.gc_ctor_table.field_counts, ctor_lookup_idx)\n        let obj_size = 8 + fc * 8\n        let ptr_local = next_local\n        Array::push(local_names, \"__ctor_ptr\")\n        emit_global_get(buf, 0)\n        emit_i64_extend_i32_u(buf)\n        emit_local_set(buf, ptr_local)\n        emit_global_get(buf, 0)\n        emit_i32_const(buf, obj_size)\n        emit_i32_add(buf)\n        emit_global_set(buf, 0)\n        emit_heap_memory_grow_check(buf)\n        emit_local_get(buf, ptr_local)\n        emit_i32_wrap_i64(buf)\n        emit_i32_const(buf, tag)\n        emit_i32_store(buf, 2, 0)\n        emit_local_get(buf, ptr_local)\n        emit_i32_wrap_i64(buf)\n        emit_i32_const(buf, fc)\n        emit_i32_store(buf, 2, 4)\n        let actual_args = if Array::length(args) == 1 {\n          match Array::get(args, 0) {\n            ERecord(_, rec_fields, _) => {\n              let rec find_sn: (Int) -> Int = (sni) -> {\n                if sni >= Array::length(ctx.gc_ctor_table.struct_names) {\n                  -1\n                }\n                else if Array::get(ctx.gc_ctor_table.struct_names, sni) == fname {\n                  sni\n                }\n                else find_sn(sni + 1)\n              }\n              let sn_idx = find_sn(0)\n              if sn_idx >= 0 {\n                let def_fnames = Array::get(ctx.gc_ctor_table.struct_field_names, sn_idx)\n                let ordered = array_empty()\n                let mut oi = 0\n                while oi < Array::length(def_fnames) {\n                  let target_name = Array::get(def_fnames, oi)\n                  let rec find_rf: (Int) -> Expr = (ri) -> {\n                    if ri >= Array::length(rec_fields) {\n                      EUnit\n                    }\n                    else {\n                      let (rfn, rfv) = Array::get(rec_fields, ri)\n                      if rfn == target_name {\n                        rfv\n                      }\n                      else find_rf(ri + 1)\n                    }\n                  }\n                  Array::push(ordered, find_rf(0))\n                  oi = oi + 1\n                }\n                ordered\n              } else {\n                args\n              }\n            },\n            _ => args\n          }\n        } else {\n          args\n        }\n        let mut nl_c = next_local + 1\n        let mut fi_c = 0\n        while fi_c < Array::length(actual_args) {\n          nl_c = ce(buf, Array::get(actual_args, fi_c), local_names, nl_c, ld)\n          let val_local = nl_c\n          Array::push(local_n