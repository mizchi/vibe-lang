let source_107 = () -> (String, String) {
  ("lib/@vibe/compiler/codegen/common_base/inline_wat.vibe",
"\nimport @vibe/compiler/core {\n  bytebuf_new, bytebuf_push, bytebuf_push_buf, leb128_encode_s32, leb128_encode_s64, leb128_encode_u32\n}\n\nimport @vibe/core {\n  array_empty\n}\n\n\n\nfn iw_err(fn_name: String, msg: String, off: Int) -> String {\n  \"inline wasm (fn \\{fn_name}): \\{msg} (WAT offset \\{off})\"\n}\n\nfn iw_fresh_ints() -> Array[Int] {\n  array_empty()\n}\n\nfn iw_fresh_strings() -> Array[String] {\n  array_empty()\n}\n\nfn iw_fresh_locals() -> Array[(String, Int)] {\n  array_empty()\n}\n\nfn iw_is_space(c: Int) -> Bool {\n  c == 32 || c == 9 || c == 10 || c == 13\n}\n\nfn iw_tokenize(fn_name: String, src: String) -> (Array[Int], Array[String], Array[Int]) with { Error } {\n  let kinds = iw_fresh_ints()\n  let texts = iw_fresh_strings()\n  let offs = iw_fresh_ints()\n  let n = String::length(src)\n  let mut i = 0\n  while i < n {\n    let c = String::char_code_at(src, i)\n    if iw_is_space(c) {\n      i = i + 1\n    } else if c == 59 {\n      if i + 1 < n && String::char_code_at(src, i + 1) == 59 {\n        while i < n && String::char_code_at(src, i) != 10 {\n          i = i + 1\n        }\n      } else {\n        throw(iw_err(fn_name, \"stray ';' (use ';;' line comments)\", i))\n      }\n    } else if c == 40 {\n      if i + 1 < n && String::char_code_at(src, i + 1) == 59 {\n        let mut j = i + 2\n        let mut closed = false\n        while j + 1 < n && !closed {\n          if String::char_code_at(src, j) == 59 && String::char_code_at(src, j + 1) == 41 {\n            closed = true\n          } else {\n            j = j + 1\n          }\n        }\n        if !closed {\n          throw(iw_err(fn_name, \"unterminated '(;' block comment\", i))\n        } else {\n          ()\n        }\n        i = j + 2\n      } else {\n        Array::push(kinds, 1)\n        Array::push(texts, \"\")\n        Array::push(offs, i)\n        i = i + 1\n      }\n    } else if c == 41 {\n      Array::push(kinds, 2)\n      Array::push(texts, \"\")\n      Array::push(offs, i)\n      i = i + 1\n    } else {\n      let start = i\n      let mut j = i\n      let mut stop = false\n      while j < n && !stop {\n        let wc = String::char_code_at(src, j)\n        if iw_is_space(wc) || wc == 40 || wc == 41 || wc == 59 {\n          stop = true\n        } else {\n          j = j + 1\n        }\n      }\n      Array::push(kinds, 3)\n      Array::push(texts, String::substring(src, start, j))\n      Array::push(offs, start)\n      i = j\n    }\n  }\n  (kinds, texts, offs)\n}\n\nfn iw_parse_int(fn_name: String, s: String, off: Int) -> Int with { Error } {\n  let n = String::length(s)\n  let mut i = 0\n  let mut neg = false\n  if i < n && String::char_code_at(s, i) == '-' {\n    neg = true\n    i = i + 1\n  } else {\n    ()\n  }\n  let mut hex = false\n  if i + 1 < n && String::char_code_at(s, i) == '0' {\n    let x = String::char_code_at(s, i + 1)\n    if x == 'x' || x == 'X' {\n      hex = true\n      i = i + 2\n    } else {\n      ()\n    }\n  } else {\n    ()\n  }\n  let mut v = 0\n  let mut any = false\n  while i < n {\n    let c = String::char_code_at(s, i)\n    if c == '_' {\n      i = i + 1\n    } else if hex {\n      let d = if c >= '0' && c <= '9' {\n        c - '0'\n      } else if c >= 'a' && c <= 'f' {\n        c - 'a' + 10\n      } else if c >= 'A' && c <= 'F' {\n        c - 'A' + 10\n      } else {\n        0 - 1\n      }\n      if d < 0 {\n        throw(iw_err(fn_name, \"invalid integer literal '\\{s}'\", off))\n      } else {\n        ()\n      }\n      v = v * 16 + d\n      any = true\n      i = i + 1\n    } else {\n      if c >= '0' && c <= '9' {\n        v = v * 10 + (c - '0')\n        any = true\n        i = i + 1\n      } else {\n        throw(iw_err(fn_name, \"invalid integer literal '\\{s}'\", off))\n      }\n    }\n  }\n  if !any {\n    throw(iw_err(fn_name, \"invalid integer literal '\\{s}'\", off))\n  } else {\n    ()\n  }\n  if neg {\n    0 - v\n  } else {\n    v\n  }\n}\n\nfn iw_core_table() -> Array[(String, Int)] {\n  [\n    (\"unreachable\", 0x00),\n    (\"nop\", 0x01),\n    (\"return\", 0x0F),\n    (\"drop\", 0x1A),\n    (\"select\", 0x1B),\n    (\"i32.eqz\", 0x45),\n    (\"i32.eq\", 0x46),\n    (\"i32.ne\", 0x47),\n    (\"i32.lt_s\", 0x48),\n    (\"i32.lt_u\", 0x49),\n    (\"i32.gt_s\", 0x4A),\n    (\"i32.gt_u\", 0x4B),\n    (\"i32.le_s\", 0x4C),\n    (\"i32.le_u\", 0x4D),\n    (\"i32.ge_s\", 0x4E),\n    (\"i32.ge_u\", 0x4F),\n    (\"i64.eqz\", 0x50),\n    (\"i64.eq\", 0x51),\n    (\"i64.ne\", 0x52),\n    (\"i64.lt_s\", 0x53),\n    (\"i64.lt_u\", 0x54),\n    (\"i64.gt_s\", 0x55),\n    (\"i64.gt_u\", 0x56),\n    (\"i64.le_s\", 0x57),\n    (\"i64.le_u\", 0x58),\n    (\"i64.ge_s\", 0x59),\n    (\"i64.ge_u\", 0x5A),\n    (\"f32.eq\", 0x5B),\n    (\"f32.ne\", 0x5C),\n    (\"f32.lt\", 0x5D),\n    (\"f32.gt\", 0x5E),\n    (\"f32.le\", 0x5F),\n    (\"f32.ge\", 0x60),\n    (\"f64.eq\", 0x61),\n    (\"f64.ne\", 0x62),\n    (\"f64.lt\", 0x63),\n    (\"f64.gt\", 0x64),\n    (\"f64.le\", 0x65),\n    (\"f64.ge\", 0x66),\n    (\"i32.clz\", 0x67),\n    (\"i32.ctz\", 0x68),\n    (\"i32.popcnt\", 0x69),\n    (\"i32.add\", 0x6A),\n    (\"i32.sub\", 0x6B),\n    (\"i32.mul\", 0x6C),\n    (\"i32.div_s\", 0x6D),\n    (\"i32.div_u\", 0x6E),\n    (\"i32.rem_s\", 0x6F),\n    (\"i32.rem_u\", 0x70),\n    (\"i32.and\", 0x71),\n    (\"i32.or\", 0x72),\n    (\"i32.xor\", 0x73),\n    (\"i32.shl\", 0x74),\n    (\"i32.shr_s\", 0x75),\n    (\"i32.shr_u\", 0x76),\n    (\"i32.rotl\", 0x77),\n    (\"i32.rotr\", 0x78),\n    (\"i64.clz\", 0x79),\n    (\"i64.ctz\", 0x7A),\n    (\"i64.popcnt\", 0x7B),\n    (\"i64.add\", 0x7C),\n    (\"i64.sub\", 0x7D),\n    (\"i64.mul\", 0x7E),\n    (\"i64.div_s\", 0x7F),\n    (\"i64.div_u\", 0x80),\n    (\"i64.rem_s\", 0x81),\n    (\"i64.rem_u\", 0x82),\n    (\"i64.and\", 0x83),\n    (\"i64.or\", 0x84),\n    (\"i64.xor\", 0x85),\n    (\"i64.shl\", 0x86),\n    (\"i64.shr_s\", 0x87),\n    (\"i64.shr_u\", 0x88),\n    (\"i64.rotl\", 0x89),\n    (\"i64.rotr\", 0x8A),\n    (\"f32.abs\", 0x8B),\n    (\"f32.neg\", 0x8C),\n    (\"f32.ceil\", 0x8D),\n    (\"f32.floor\", 0x8E),\n    (\"f32.trunc\", 0x8F),\n    (\"f32.nearest\", 0x90),\n    (\"f32.sqrt\", 0x91),\n    (\"f32.add\", 0x92),\n    (\"f32.sub\", 0x93),\n    (\"f32.mul\", 0x94),\n    (\"f32.div\", 0x95),\n    (\"f32.min\", 0x96),\n    (\"f32.max\", 0x97),\n    (\"f32.copysign\", 0x98),\n    (\"f64.abs\", 0x99),\n    (\"f64.neg\", 0x9A),\n    (\"f64.ceil\", 0x9B),\n    (\"f64.floor\", 0x9C),\n    (\"f64.trunc\", 0x9D),\n    (\"f64.nearest\", 0x9E),\n    (\"f64.sqrt\", 0x9F),\n    (\"f64.add\", 0xA0),\n    (\"f64.sub\", 0xA1),\n    (\"f64.mul\", 0xA2),\n    (\"f64.div\", 0xA3),\n    (\"f64.min\", 0xA4),\n    (\"f64.max\", 0xA5),\n    (\"f64.copysign\", 0xA6),\n    (\"i32.wrap_i64\", 0xA7),\n    (\"i32.trunc_f32_s\", 0xA8),\n    (\"i32.trunc_f32_u\", 0xA9),\n    (\"i32.trunc_f64_s\", 0xAA),\n    (\"i32.trunc_f64_u\", 0xAB),\n    (\"i64.extend_i32_s\", 0xAC),\n    (\"i64.extend_i32_u\", 0xAD),\n    (\"i64.trunc_f32_s\", 0xAE),\n    (\"i64.trunc_f32_u\", 0xAF),\n    (\"i64.trunc_f64_s\", 0xB0),\n    (\"i64.trunc_f64_u\", 0xB1),\n    (\"f32.convert_i32_s\", 0xB2),\n    (\"f32.convert_i32_u\", 0xB3),\n    (\"f32.convert_i64_s\", 0xB4),\n    (\"f32.convert_i64_u\", 0xB5),\n    (\"f32.demote_f64\", 0xB6),\n    (\"f64.convert_i32_s\", 0xB7),\n    (\"f64.convert_i32_u\", 0xB8),\n    (\"f64.convert_i64_s\", 0xB9),\n    (\"f64.convert_i64_u\", 0xBA),\n    (\"f64.promote_f32\", 0xBB),\n    (\"i32.reinterpret_f32\", 0xBC),\n    (\"i64.reinterpret_f64\", 0xBD),\n    (\"f32.reinterpret_i32\", 0xBE),\n    (\"f64.reinterpret_i64\", 0xBF),\n    (\"i32.extend8_s\", 0xC0),\n    (\"i32.extend16_s\", 0xC1),\n    (\"i64.extend8_s\", 0xC2),\n    (\"i64.extend16_s\", 0xC3),\n    (\"i64.extend32_s\", 0xC4)\n  ]\n}\n\nfn iw_simd_table() -> Array[(String, Int)] {\n  [\n    (\"i8x16.swizzle\", 14),\n    (\"i8x16.splat\", 15),\n    (\"i16x8.splat\", 16),\n    (\"i32x4.splat\", 17),\n    (\"i64x2.splat\", 18),\n    (\"f32x4.splat\", 19),\n    (\"f64x2.splat\", 20),\n    (\"i8x16.eq\", 35),\n    (\"i8x16.ne\", 36),\n    (\"i8x16.lt_s\", 37),\n    (\"i8x16.lt_u\", 38),\n    (\"i8x16.gt_s\", 39),\n    (\"i8x16.gt_u\", 40),\n    (\"i8x16.le_s\", 41),\n    (\"i8x16.le_u\", 42),\n    (\"i8x16.ge_s\", 43),\n    (\"i8x16.ge_u\", 44),\n    (\"i16x8.eq\", 45),\n    (\"i16x8.ne\", 46),\n    (\"i16x8.lt_s\", 47),\n    (\"i16x8.lt_u\", 48),\n    (\"i16x8.gt_s\", 49),\n    (\"i16x8.gt_u\", 50),\n    (\"i16x8.le_s\", 51),\n    (\"i16x8.le_u\", 52),\n    (\"i16x8.ge_s\", 53),\n    (\"i16x8.ge_u\", 54),\n    (\"i32x4.eq\", 55),\n    (\"i32x4.ne\", 56),\n    (\"i32x4.lt_s\", 57),\n    (\"i32x4.lt_u\", 58),\n    (\"i32x4.gt_s\", 59),\n    (\"i32x4.gt_u\", 60),\n    (\"i32x4.le_s\", 61),\n    (\"i32x4.le_u\", 62),\n    (\"i32x4.ge_s\", 63),\n    (\"i32x4.ge_u\", 64),\n    (\"f32x4.eq\", 65),\n    (\"f32x4.ne\", 66),\n    (\"f32x4.lt\", 67),\n    (\"f32x4.gt\", 68),\n    (\"f32x4.le\", 69),\n    (\"f32x4.ge\", 70),\n    (\"f64x2.eq\", 71),\n    (\"f64x2.ne\", 72),\n    (\"f64x2.lt\", 73),\n    (\"f64x2.gt\", 74),\n    (\"f64x2.le\", 75),\n    (\"f64x2.ge\", 76),\n    (\"v128.not\", 77),\n    (\"v128.and\", 78),\n    (\"v128.andnot\", 79),\n    (\"v128.or\", 80),\n    (\"v128.xor\", 81),\n    (\"v128.bitselect\", 82),\n    (\"v128.any_true\", 83),\n    (\"i8x16.abs\", 96),\n    (\"i8x16.neg\", 97),\n    (\"i8x16.popcnt\", 98),\n    (\"i8x16.all_true\", 99),\n    (\"i8x16.bitmask\", 100),\n    (\"i8x16.shl\", 107),\n    (\"i8x16.shr_s\", 108),\n    (\"i8x16.shr_u\", 109),\n    (\"i8x16.add\", 110),\n    (\"i8x16.add_sat_s\", 111),\n    (\"i8x16.add_sat_u\", 112),\n    (\"i8x16.sub\", 113),\n    (\"i8x16.sub_sat_s\", 114),\n    (\"i8x16.sub_sat_u\", 115),\n    (\"i8x16.min_s\", 118),\n    (\"i8x16.min_u\", 119),\n    (\"i8x16.max_s\", 120),\n    (\"i8x16.max_u\", 121),\n    (\"i8x16.avgr_u\", 123),\n    (\"i16x8.abs\", 128),\n    (\"i16x8.neg\", 129),\n    (\"i16x8.all_true\", 131),\n    (\"i16x8.bitmask\", 132),\n    (\"i16x8.shl\", 139),\n    (\"i16x8.shr_s\", 140),\n    (\"i16x8.shr_u\", 141),\n    (\"i16x8.add\", 142),\n    (\"i16x8.sub\", 145),\n    (\"i16x8.mul\", 149),\n    (\"i16x8.min_s\", 150),\n    (\"i16x8.min_u\", 151),\n    (\"i16x8.max_s\", 152),\n    (\"i16x8.max_u\", 153),\n    (\"i16x8.avgr_u\", 155),\n    (\"i32x4.abs\", 160),\n    (\"i32x4.neg\", 161),\n    (\"i32x4.all_true\", 163),\n    (\"i32x4.bitmask\", 164),\n    (\"i32x4.shl\", 171),\n    (\"i32x4.shr_s\", 172),\n    (\"i32x4.shr_u\", 173),\n    (\"i32x4.add\", 174),\n    (\"i32x4.sub\", 177),\n    (\"i32x4.mul\", 181),\n    (\"i32x4.min_s\", 182),\n    (\"i32x4.min_u\", 183),\n    (\"i32x4.max_s\", 184),\n    (\"i32x4.max_u\", 185),\n    (\"i32x4.dot_i16x8_s\", 186),\n    (\"i64x2.abs\", 192),\n    (\"i64x2.neg\", 193),\n    (\"i64x2.all_true\", 195),\n    (\"i64x2.bitmask\", 196),\n    (\"i64x2.shl\", 203),\n    (\"i64x2.shr_s\", 204),\n    (\"i64x2.shr_u\", 205),\n    (\"i64x2.add\", 206),\n    (\"i64x2.sub\", 209),\n    (\"i64x2.mul\", 213),\n    (\"i64x2.eq\", 214),\n    (\"i64x2.ne\", 215),\n    (\"i64x2.lt_s\", 216),\n    (\"i64x2.gt_s\", 217),\n    (\"i64x2.le_s\", 218),\n    (\"i64x2.ge_s\", 219),\n    (\"f32x4.abs\", 224),\n    (\"f32x4.neg\", 225),\n    (\"f32x4.sqrt\", 227),\n    (\"f32x4.add\", 228),\n    (\"f32x4.sub\", 229),\n    (\"f32x4.mul\", 230),\n    (\"f32x4.div\", 231),\n    (\"f32x4.min\", 232),\n    (\"f32x4.max\", 233),\n    (\"f64x2.abs\", 236),\n    (\"f64x2.neg\", 237),\n    (\"f64x2.sqrt\", 239),\n    (\"f64x2.add\", 240),\n    (\"f64x2.sub\", 241),\n    (\"f64x2.mul\", 242),\n    (\"f64x2.div\", 243),\n    (\"f64x2.min\", 244),\n    (\"f64x2.max\", 245)\n  ]\n}\n\nfn iw_lane_count(name: String) -> Int {\n  if String::starts_with(name, \"i8x16.\") {\n    16\n  } else if String::starts_with(name, \"i16x8.\") {\n    8\n  } else if String::starts_with(name, \"i32x4.\") || String::starts_with(name, \"f32x4.\") {\n    4\n  } else {\n    2\n  }\n}\n\nfn iw_simd_lane_table() -> Array[(String, Int)] {\n  [\n    (\"i8x16.extract_lane_s\", 21),\n    (\"i8x16.extract_lane_u\", 22),\n    (\"i8x16.replace_lane\", 23),\n    (\"i16x8.extract_lane_s\", 24),\n    (\"i16x8.extract_lane_u\", 25),\n    (\"i16x8.replace_lane\", 26),\n    (\"i32x4.extract_lane\", 27),\n    (\"i32x4.replace_lane\", 28),\n    (\"i64x2.extract_lane\", 29),\n    (\"i64x2.replace_lane\", 30),\n    (\"f32x4.extract_lane\", 31),\n    (\"f32x4.replace_lane\", 32),\n    (\"f64x2.extract_lane\", 33),\n    (\"f64x2.replace_lane\", 34)\n  ]\n}\n\nfn iw_mem_table() -> Array[(String, Int, Int)] {\n  [\n    (\"i32.load\", 0x28, 2),\n    (\"i64.load\", 0x29, 3),\n    (\"f32.load\", 0x2A, 2),\n    (\"f64.load\", 0x2B, 3),\n    (\"i32.load8_s\", 0x2C, 0),\n    (\"i32.load8_u\", 0x2D, 0),\n    (\"i32.load16_s\", 0x2E, 1),\n    (\"i32.load16_u\", 0x2F, 1),\n    (\"i64.load8_s\", 0x30, 0),\n    (\"i64.load8_u\", 0x31, 0),\n    (\"i64.load16_s\", 0x32, 1),\n    (\"i64.load16_u\", 0x33, 1),\n    (\"i64.load32_s\", 0x34, 2),\n    (\"i64.load32_u\", 0x35, 2),\n    (\"i32.store\", 0x36, 2),\n    (\"i64.store\", 0x37, 3),\n    (\"f32.store\", 0x38, 2),\n    (\"f64.store\", 0x39, 3),\n    (\"i32.store8\", 0x3A, 0),\n    (\"i32.store16\", 0x3B, 1),\n    (\"i64.store8\", 0x3C, 0),\n    (\"i64.store16\", 0x3D, 1),\n    (\"i64.store32\", 0x3E, 2)\n  ]\n}\n\nfn iw_lookup(table: Array[(String, Int)], name: String) -> Int {\n  let n = Array::length(table)\n  let mut i = 0\n  let mut found = 0 - 1\n  while i < n {\n    let (tn, tv) = Array::get(table, i)\n    if tn == name {\n      found = tv\n      i = n\n    } else {\n      i = i + 1\n    }\n  }\n  found\n}\n\nfn iw_mem_lookup(name: String) -> (Int, Int) {\n  let table = iw_mem_table()\n  let n = Array::length(table)\n  let mut i = 0\n  let mut op = 0 - 1\n  let mut al = 0\n  while i < n {\n    let (tn, tv, ta) = Array::get(table, i)\n    if tn == name {\n      op = tv\n      al = ta\n      i = n\n    } else {\n      i = i + 1\n    }\n  }\n  (op, al)\n}\n\nfn iw_local_idx(fn_name: String, locals: Array[(String, Int)], tok: String, off: Int) -> Int with { Error } {\n  if String::length(tok) > 0 && String::char_code_at(tok, 0) == '$' {\n    let want = String::substring(tok, 1, String::length(tok))\n    let n = Array::length(locals)\n    let mut i = 0\n    let mut found = 0 - 1\n    while i < n {\n      let (ln, li) = Array::get(locals, i)\n      if ln == want {\n        found = li\n        i = n\n      } else {\n        i = i + 1\n      }\n    }\n    if found < 0 {\n      throw(iw_err(fn_name, \"unknown local '\\{tok}' — not a param or a declared (local ...)\", off))\n    } else {\n      found\n    }\n  } else {\n    iw_parse_int(fn_name, tok, off)\n  }\n}\n\nfn iw_label_rel(fn_name: String, lbl_names: Array[String], lbl_depths: Array[Int], tok: String, depth: Int, off: Int) -> Int with { Error } {\n  if String::length(tok) > 0 && String::char_code_at(tok, 0) == '$' {\n    let n = Array::length(lbl_names)\n    let mut i = n\n    let mut bound = 0 - 1\n    while i > 0 {\n      i = i - 1\n      if Array::get(lbl_names, i) == tok {\n        bound = Array::get(lbl_depths, i)\n        i = 0\n      } else {\n        ()\n      }\n    }\n    if bound < 0 {\n      throw(iw_err(fn_name, \"unknown label '\\{tok}'\", off))\n    } else {\n      depth - bound - 1\n    }\n  } else {\n    iw_parse_int(fn_name, tok, off)\n  }\n}\n\nfn iw_valtype_code(fn_name: String, name: String, off: Int) -> Int with { Error } {\n  match name {\n    \"i32\" => 0x7F,\n    \"i64\" => 0x7E,\n    \"f32\" => 0x7D,\n    \"f64\" => 0x7C,\n    \"v128\" => 0x7B,\n    _ => throw(iw_err(fn_name, \"unknown value type '\\{name}'\", off))\n  }\n}\n\nfn iw_blocktype(fn_name: String, kinds: Array[Int], texts: Array[String], offs: Array[Int], pos: Int, end: Int) -> (Int, Int) with { Error } {\n  if pos + 1 < end && Array::get(kinds, pos) == 1 && Array::get(kinds, pos + 1) == 3 && Array::get(texts, pos + 1) == \"result\" {\n    if pos + 3 < end && Array::get(kinds, pos + 2) == 3 && Array::get(kinds, pos + 3) == 2 {\n      let vt = iw_valtype_code(fn_name, Array::get(texts, pos + 2), Array::get(offs, pos + 2));\n      (vt, pos + 4)\n    } else {\n      throw(iw_err(fn_name, \"malformed (result T) clause\", Array::get(offs, pos)))\n    }\n  } else {\n    (0x40, pos)\n  }\n}\n\nfn iw_memarg(fn_name: String, kinds: Array[Int], texts: Array[String], offs: Array[Int], pos: Int, end: Int, default_align: Int) -> (Int, Int, Int) with { Error } {\n  let mut align = default_align\n  let mut offset = 0\n  let mut p = pos\n  let mut done = false\n  while !done {\n    if p < end && Array::get(kinds, p) == 3 {\n      let t = Array::get(texts, p)\n      if String::starts_with(t, \"offset=\") {\n        offset = iw_parse_int(fn_name, String::substring(t, 7, String::length(t)), Array::get(offs, p))\n        p = p + 1\n      } else if String::starts_with(t, \"align=\") {\n        let a = iw_parse_int(fn_name, String::substring(t, 6, String::length(t)), Array::get(offs, p))\n        if a <= 0 || (a&(a - 1)) != 0 {\n          throw(iw_err(fn_name, \"align=\\{a} is invalid (must be a positive power of two)\", Array::get(offs, p)))\n        }\n        let mut e = 0\n        let mut av = a\n        while av > 1 {\n          e = e + 1\n          av = av / 2\n        }\n        if e > default_align {\n          throw(iw_err(fn_name, \"align=\\{a} exceeds the instruction's natural alignment (\\{1 << default_align})\", Array::get(offs, p)))\n        }\n        align = e\n        p = p + 1\n      } else {\n        done = true\n      }\n    } else {\n      done = true\n    }\n  }\n  (align, offset, p)\n}\n\nfn iw_want_word(fn_name: String, kinds: Array[Int], texts: Array[String], offs: Array[Int], pos: Int, end: Int, opname: String) -> String with { Error } {\n  if pos < end && Array::get(kinds, pos) == 3 {\n    Array::get(texts, pos)\n  } else {\n    let off = if pos < Array::length(offs) {\n      Array::get(offs, pos)\n    } else {\n      0 - 1\n    }\n    throw(iw_err(fn_name, \"'\\{opname}' expects an immediate operand\", off))\n  }\n}\n\nfn iw_v128_const(buf: Bytes, fn_name: String, kinds: Array[Int], texts: Array[String], offs: Array[Int], pos: Int, end: Int) -> Int with { Error } {\n  let shape = iw_want_word(fn_name, kinds, texts, offs, pos, end, \"v128.const\")\n  let (lane_count, lane_bytes) = match shape {\n    \"i8x16\" => (16, 1),\n    \"i16x8\" => (8, 2),\n    \"i32x4\" => (4, 4),\n    \"i64x2\" => (2, 8),\n    _ => throw(iw_err(fn_name, \"v128.const shape must be i8x16/i16x8/i32x4/i64x2, got '\\{shape}'\", Array::get(offs, pos)))\n  }\n  bytebuf_push(buf, 0xFD)\n  leb128_encode_u32(buf, 12)\n  let mut p = pos + 1\n  let mut li = 0\n  while li < lane_count {\n    let t = iw_want_word(fn_name, kinds, texts, offs, p, end, \"v128.const\")\n    let v = iw_parse_int(fn_name, t, Array::get(offs, p))\n    let mut bi = 0\n    while bi < lane_bytes {\n      bytebuf_push(buf, (v>>(bi * 8))&255)\n      bi = bi + 1\n    }\n    p = p + 1\n    li = li + 1\n  }\n  p\n}\n\nfn iw_plain_op(buf: Bytes, fn_name: String, kinds: Array[Int], texts: Array[String], offs: Array[Int], pos: Int, end: Int, locals: Array[(String, Int)], lbl_names: Array[String], lbl_depths: Array[Int], depth: Int) -> Int with { Error } {\n  let name = Array::get(texts, pos)\n  let off = Array::get(offs, pos)\n  if name == \"block\" || name == \"loop\" || name == \"if\" || name == \"else\" || name == \"end\" || name == \"then\" {\n    throw(iw_err(fn_name, \"structured control must use the folded form: (block ...) / (loop ...) / (if <cond> (then ...) (else ...))\", off))\n  } else if name == \"local.get\" || name == \"local.set\" || name == \"local.tee\" {\n    let opc = if name == \"local.get\" {\n      0x20\n    } else if name == \"local.set\" {\n      0x21\n    } else {\n      0x22\n    }\n    let t = iw_want_word(fn_name, kinds, texts, offs, pos + 1, end, name)\n    let idx = iw_local_idx(fn_name, locals, t, Array::get(offs, pos + 1))\n    bytebuf_push(buf, opc)\n    leb128_encode_u32(buf, idx)\n    pos + 2\n  } else if name == \"br\" || name == \"br_if\" {\n    let t = iw_want_word(fn_name, kinds, texts, offs, pos + 1, end, name)\n    let rel = iw_label_rel(fn_name, lbl_names, lbl_depths, t, depth, Array::get(offs, pos + 1))\n    if rel < 0 {\n      throw(iw_err(fn_name, \"label '\\{t}' is not visible from this branch\", Array::get(offs, pos + 1)))\n    } else {\n      ()\n    }\n    bytebuf_push(buf, if name == \"br\" {\n      0x0C\n    } else {\n      0x0D\n    })\n    leb128_encode_u32(buf, rel)\n    pos + 2\n  } else if name == \"i32.const\" {\n    let t = iw_want_word(fn_name, kinds, texts, offs, pos + 1, end, name)\n    let v = iw_parse_int(fn_name, t, Array::get(offs, pos + 1))\n    bytebuf_push(buf, 0x41)\n    leb128_encode_s32(buf, v)\n    pos + 2\n  } else if name == \"i64.const\" {\n    let t = iw_want_word(fn_name, kinds, texts, offs, pos + 1, end, name)\n    let v = iw_parse_int(fn_name, t, Array::get(offs, pos + 1))\n    bytebuf_push(buf, 0x42)\n    leb128_encode_s64(buf, v)\n    pos + 2\n  } else if name == \"f32.const\" || name == \"f64.const\" {\n    throw(iw_err(fn_name, \"'\\{name}' is not supported in inline wasm (v0.3 slice); build the bit pattern with i64.const + f64.reinterpret_i64\", off))\n  } else if name == \"memory.size\" || name == \"memory.grow\" {\n    bytebuf_push(buf, if name == \"memory.size\" {\n      0x3F\n    } else {\n      0x40\n    })\n    bytebuf_push(buf, 0x00)\n    pos + 1\n  } else if name == \"v128.const\" {\n    iw_v128_const(buf, fn_name, kinds, texts, offs, pos + 1, end)\n  } else if name == \"v128.load\" || name == \"v128.store\" {\n    let (align, offset, next) = iw_memarg(fn_name, kinds, texts, offs, pos + 1, end, 4)\n    bytebuf_push(buf, 0xFD)\n    leb128_encode_u32(buf, if name == \"v128.load\" {\n      0\n    } else {\n      11\n    })\n    leb128_encode_u32(buf, align)\n    leb128_encode_u32(buf, offset)\n    next\n  } else if name == \"call\" || name == \"call_indirect\" || name == \"return_call\" {\n    throw(iw_err(fn_name, \"'\\{name}' is not supported in inline wasm (v0.3 slice: bodies cannot reference other functions)\", off))\n  } else if name == \"global.get\" || name == \"global.set\" {\n    throw(iw_err(fn_name, \"'\\{name}' is not supported in inline wasm (v0.3 slice: runtime globals are not addressable)\", off))\n  } else if name == \"br_table\" {\n    throw(iw_err(fn_name, \"'br_table' is not supported in inline wasm (v0.3 slice)\", off))\n  } else if name == \"local\" {\n    throw(iw_err(fn_name, \"'(local ...)' declarations must sit at the START of the body, before any instruction\", off))\n  } else if name == \"i8x16.shuffle\" {\n    bytebuf_push(buf, 0xFD)\n    leb128_encode_u32(buf, 13)\n    let mut sp = pos + 1\n    let mut sl = 0\n    while sl < 16 {\n      let t = iw_want_word(fn_name, kinds, texts, offs, sp, end, name)\n      let v = iw_parse_int(fn_name, t, Array::get(offs, sp))\n      if v < 0 || v > 31 {\n        throw(iw_err(fn_name, \"shuffle lane byte \\{v} is out of range (0..31)\", Array::get(offs, sp)))\n      }\n      bytebuf_push(buf, v)\n      sl = sl + 1\n      sp = sp + 1\n    }\n    sp\n  } else {\n    let core_opc = iw_lookup(iw_core_table(), name)\n    if core_opc >= 0 {\n      bytebuf_push(buf, core_opc)\n      pos + 1\n    } else {\n      let lane_sub = iw_lookup(iw_simd_lane_table(), name)\n      if lane_sub >= 0 {\n        let t = iw_want_word(fn_name, kinds, texts, offs, pos + 1, end, name)\n        let lane = iw_parse_int(fn_name, t, Array::get(offs, pos + 1))\n        let lane_cnt = iw_lane_count(name)\n        if lane < 0 || lane >= lane_cnt {\n          throw(iw_err(fn_name, \"lane index \\{lane} is out of range for '\\{name}' (0..\\{lane_cnt - 1})\", Array::get(offs, pos + 1)))\n        }\n        bytebuf_push(buf, 0xFD)\n        leb128_encode_u32(buf, lane_sub)\n        bytebuf_push(buf, lane&255)\n        pos + 2\n      } else {\n        let (mem_opc, mem_align) = iw_mem_lookup(name)\n        if mem_opc >= 0 {\n          let (align, offset, next) = iw_memarg(fn_name, kinds, texts, offs, pos + 1, end, mem_align)\n          bytebuf_push(buf, mem_opc)\n          leb128_encode_u32(buf, align)\n          leb128_encode_u32(buf, offset)\n          next\n        } else {\n          let simd_sub = iw_lookup(iw_simd_table(), name)\n          if simd_sub >= 0 {\n            bytebuf_push(buf, 0xFD)\n            leb128_encode_u32(buf, simd_sub)\n            pos + 1\n          } else {\n            throw(iw_err(fn_name, \"unknown or unsupported instruction '\\{name}'\", off))\n          }\n        }\n      }\n    }\n  }\n}\n\nfn iw_item(out: Bytes, fn_name: String, kinds: Array[Int], texts: Array[String], offs: Array[Int], pos: Int, end: Int, locals: Array[(String, Int)], lbl_names: Array[String], lbl_depths: Array[Int], depth: Int) -> Int with { Error } {\n  let k = Array::get(kinds, pos)\n  if k == 3 {\n    iw_plain_op(out, fn_name, kinds, texts, offs, pos, end, locals, lbl_names, lbl_depths, depth)\n  } else if k == 1 {\n    if pos + 1 >= end || Array::get(kinds, pos + 1) != 3 {\n      throw(iw_err(fn_name, \"expected an instruction name after '('\", Array::get(offs, pos)))\n    } else {\n      ()\n    }\n    let head = Array::get(texts, pos + 1)\n    if head == \"block\" || head == \"loop\" {\n      iw_folded_block(out, fn_name, kinds, texts, offs, pos, end, locals, lbl_names, lbl_depths, depth)\n    } else if head == \"if\" {\n      iw_folded_if(out, fn_name, kinds, texts, offs, pos, end, locals, lbl_names, lbl_depths, depth)\n    } else if head == \"then\" || head == \"else\" || head == \"result\" {\n      throw(iw_err(fn_name, \"misplaced '(\\{head} ...)' clause\", Array::get(offs, pos)))\n    } else {\n      iw_folded_op(out, fn_name, kinds, texts, offs, pos, end, locals, lbl_names, lbl_depths, depth)\n    }\n  } else {\n    throw(iw_err(fn_name, \"unexpected ')'\", Array::get(offs, pos)))\n  }\n}\n\nfn iw_seq(out: Bytes, fn_name: String, kinds: Array[Int], texts: Array[String], offs: Array[Int], pos: Int, end: Int, locals: Array[(String, Int)], lbl_names: Array[String], lbl_depths: Array[Int], depth: Int) -> Int with { Error } {\n  let mut p = pos\n  let mut done = false\n  while !done {\n    if p >= end {\n      done = true\n    } else if Array::get(kinds, p) == 2 {\n      done = true\n    } else {\n      p = iw_item(out, fn_name, kinds, texts, offs, p, end, locals, lbl_names, lbl_depths, depth)\n    }\n  }\n  p\n}\n\nfn iw_folded_op(out: Bytes, fn_name: String, kinds: Array[Int], texts: Array[String], offs: Array[Int], pos: Int, end: Int, locals: Array[(String, Int)], lbl_names: Array[String], lbl_depths: Array[Int], depth: Int) -> Int with { Error } {\n  let opb = bytebuf_new()\n  let after_imm = iw_plain_op(opb, fn_name, kinds, texts, offs, pos + 1, end, locals, lbl_names, lbl_depths, depth)\n  let mut p = after_imm\n  let mut done = false\n  while !done {\n    if p >= end {\n      throw(iw_err(fn_name, \"missing ')' closing folded '\\{Array::get(texts, pos + 1)}'\", Array::get(offs, pos)))\n    } else if Array::get(kinds, p) == 2 {\n      done = true\n    } else if Array::get(kinds, p) == 1 {\n      p = iw_item(out, fn_name, kinds, texts, offs, p, end, locals, lbl_names, lbl_depths, depth)\n    } else {\n      throw(iw_err(fn_name, \"unexpected '\\{Array::get(texts, p)}' inside folded '\\{Array::get(texts, pos + 1)}' — operands must be parenthesized\", Array::get(offs, p)))\n    }\n  }\n  bytebuf_push_buf(out, opb)\n  p + 1\n}\n\nfn iw_folded_block(out: Bytes, fn_name: String, kinds: Array[Int], texts: Array[String], offs: Array[Int], pos: Int, end: Int, locals: Array[(String, Int)], lbl_names: Array[String], lbl_depths: Array[Int], depth: Int) -> Int with { Error } {\n  let head = Array::get(texts, pos + 1)\n  bytebuf_push(out, if head == \"loop\" {\n    0x03\n  } else {\n    0x02\n  })\n  let lbl_mark = Array::length(lbl_names)\n  let mut q = pos + 2\n  if q < end && Array::get(kinds, q) == 3 && String::length(Array::get(texts, q)) > 0 && String::char_code_at(Array::get(texts, q), 0) == '$' {\n    Array::push(lbl_names, Array::get(texts, q))\n    Array::push(lbl_depths, depth)\n    q = q + 1\n  } else {\n    ()\n  }\n  let (bt, after_bt) = iw_blocktype(fn_name, kinds, texts, offs, q, end)\n  bytebuf_push(out, bt)\n  let bq = iw_seq(out, fn_name, kinds, texts, offs, after_bt, end, locals, lbl_names, lbl_depths, depth + 1)\n  if bq >= end || Array::get(kinds, bq) != 2 {\n    throw(iw_err(fn_name, \"missing ')' closing '\\{head}'\", Array::get(offs, pos)))\n  } else {\n    ()\n  }\n  bytebuf_push(out, 0x0B)\n  Array::truncate(lbl_names, lbl_mark)\n  Array::truncate(lbl_depths, lbl_mark)\n  bq + 1\n}\n\nfn iw_folded_if(out: Bytes, fn_name: String, kinds: Array[Int], texts: Array[String], offs: Array[Int], pos: Int, end: Int, locals: Array[(String, Int)], lbl_names: Array[String], lbl_depths: Array[Int], depth: Int) -> Int with { Error } {\n  let lbl_mark = Array::length(lbl_names)\n  let mut q = pos + 2\n  if q < end && Array::get(kinds, q) == 3 && String::length(Array::get(texts, q)) > 0 && String::char_code_at(Array::get(texts, q), 0) == '$' {\n    Array::push(lbl_names, Array::get(texts, q))\n    Array::push(lbl_depths, depth)\n    q = q + 1\n  } else {\n    ()\n  }\n  let (bt, after_bt) = iw_blocktype(fn_name, kinds, texts, offs, q, end)\n  let mut p = after_bt\n  let mut cond_done = false\n  while !cond_done {\n    if p >= end {\n      throw(iw_err(fn_name, \"missing '(then ...)' clause in folded 'if'\", Array::get(offs, pos)))\n    } else if Array::get(kinds, p) == 1 && p + 1 < end && Array::get(kinds, p + 1) == 3 && Array::get(texts, p + 1) == \"then\" {\n      cond_done = true\n    } else if Array::get(kinds, p) == 1 {\n      p = iw_item(out, fn_name, kinds, texts, offs, p, end, locals, lbl_names, lbl_depths, depth)\n    } else {\n      throw(iw_err(fn_name, \"unexpected token in folded 'if' condition (condition operands must be parenthesized)\", Array::get(offs, p)))\n    }\n  }\n  bytebuf_push(out, 0x04)\n  bytebuf_push(out, bt)\n  let tq = iw_seq(out, fn_name, kinds, texts, offs, p + 2, end, locals, lbl_names, lbl_depths, depth + 1)\n  if tq >= end || Array::get(kinds, tq) != 2 {\n    throw(iw_err(fn_name, \"missing ')' closing '(then ...)'\", Array::get(offs, p)))\n  } else {\n    ()\n  }\n  let mut r = tq + 1\n  if r + 1 < end && Array::get(kinds, r) == 1 && Array::get(kinds, r + 1) == 3 && Array::get(texts, r + 1) == \"else\" {\n    bytebuf_push(out, 0x05)\n    let eq = iw_seq(out, fn_name, kinds, texts, offs, r + 2, end, locals, lbl_names, lbl_depths, depth + 1)\n    if eq >= end || Array::get(kinds, eq) != 2 {\n      throw(iw_err(fn_name, \"missing ')' closing '(else ...)'\", Array::get(offs, r)))\n    } else {\n      ()\n    }\n    r = eq + 1\n  } else {\n    ()\n  }\n  if r >= end || Array::get(kinds, r) != 2 {\n    throw(iw_err(fn_name, \"missing ')' closing folded 'if'\", Array::get(offs, pos)))\n  } else {\n    ()\n  }\n  bytebuf_push(out, 0x0B)\n  Array::truncate(lbl_names, lbl_mark)\n  Array::truncate(lbl_depths, lbl_mark)\n  r + 1\n}\n\nfn iw_parse_local_decls(fn_name: String, kinds: Array[Int], texts: Array[String], offs: Array[Int], end: Int, locals: Array[(String, Int)], extra_base: Int) -> (Int, Int, Int, Int) with { Error } {\n  let mut p = 0\n  let mut n32 = 0\n  let mut n64 = 0\n  let mut nv = 0\n  let mut last_rank = 0 - 1\n  let mut done = false\n  while !done {\n    if p + 4 < end && Array::get(kinds, p) == 1 && Array::get(kinds, p + 1) == 3 && Array::get(texts, p + 1) == \"local\" {\n      let decl_off = Array::get(offs, p)\n      let name_tok = Array::get(texts, p + 2)\n      if Array::get(kinds, p + 2) != 3 || String::length(name_tok) < 2 || String::char_code_at(name_tok, 0) != '$' {\n        throw(iw_err(fn_name, \"(local ...) expects a $name followed by a type\", decl_off))\n      }\n      if Array::get(kinds, p + 3) != 3 {\n        throw(iw_err(fn_name, \"(local \\{name_tok} ...) is missing its type\", decl_off))\n      }\n      let ty_tok = Array::get(texts, p + 3)\n      let rank = match ty_tok {\n        \"i32\" => 0,\n        \"i64\" => 1,\n        \"v128\" => 2,\n        _ => throw(iw_err(fn_name, \"(local ...) type must be i32, i64 or v128, got '\\{ty_tok}'\", Array::get(offs, p + 3)))\n      }\n      if Array::get(kinds, p + 4) != 2 {\n        throw(iw_err(fn_name, \"(local \\{name_tok} \\{ty_tok}) takes exactly one name and one type\", decl_off))\n      }\n      if rank < last_rank {\n        throw(iw_err(fn_name, \"(local ...) declarations must be grouped by type in the order i32, i64, v128\", decl_off))\n      }\n      let want = String::substring(name_tok, 1, String::length(name_tok))\n      let mut di = 0\n      while di < Array::length(locals) {\n        let (dn, _dx) = Array::get(locals, di)\n        if dn == want {\n          throw(iw_err(fn_name, \"duplicate local name '\\{name_tok}'\", decl_off))\n        } else {\n          ()\n        }\n        di = di + 1\n      }\n      Array::push(locals, (want, extra_base + n32 + n64 + nv))\n      if rank == 0 {\n        n32 = n32 + 1\n      } else if rank == 1 {\n        n64 = n64 + 1\n      } else {\n        nv = nv + 1\n      }\n      last_rank = rank\n      p = p + 5\n    } else {\n      done = true\n    }\n  }\n  (p, n32, n64, nv)\n}\n\nexport fn compile_inline_wat_full(fn_name: String, wat: String, param_names: Array[String], extra_base: Int) -> (Bytes, Int, Int, Int) with { Error } {\n  let (kinds, texts, offs) = iw_tokenize(fn_name, wat)\n  let out = bytebuf_new()\n  let lbl_names = iw_fresh_strings()\n  let lbl_depths = iw_fresh_ints()\n  let end = Array::length(kinds)\n  if end == 0 {\n    throw(iw_err(fn_name, \"empty inline wasm body\", 0))\n  } else {\n    ()\n  }\n  let locals = iw_fresh_locals()\n  let mut pi = 0\n  while pi < Array::length(param_names) {\n    Array::push(locals, (Array::get(param_names, pi), pi))\n    pi = pi + 1\n  }\n  let (body_start, n32, n64, nv) = iw_parse_local_decls(fn_name, kinds, texts, offs, end, locals, extra_base)\n  if body_start >= end {\n    throw(iw_err(fn_name, \"empty inline wasm body (only local declarations)\", 0))\n  } else {\n    ()\n  }\n  let final_pos = iw_seq(out, fn_name, kinds, texts, offs, body_start, end, locals, lbl_names, lbl_depths, 0)\n  if final_pos != end {\n    throw(iw_err(fn_name, \"unbalanced ')'\", Array::get(offs, final_pos)))\n  } else {\n    ()\n  }\n  (out, n32, n64, nv)\n}\n\nexport fn compile_inline_wat(fn_name: String, wat: String, param_names: Array[String]) -> Bytes with { Error } {\n  let (out, _n32, _n64, _nv) = compile_inline_wat_full(fn_name, wat, param_names, Array::length(param_names) + 1)\n  out\n}\n\n\nexport {\n  compile_inline_wat, compile_inline_wat_full\n}\n")
}

let source_108 = () -> (String, String) {
  ("lib/@vibe/compiler/codegen/wasi/linked_helpers.vibe",
"\nimport @vibe/compiler/codegen/common_base {\n  canonical_builtin_name\n}\n\nimport @vibe/core {\n  array_empty\n}\n\nimport @vibe/compiler/core {\n  Expr, Stmt, sorted_names_of\n}\n\nimport @vibe/compiler/codegen/common_analysis {\n  collect_free_vars, collect_free_vars_used_builtins\n}\n\nimport @vibe/compiler/codegen/common_extractors {\n  array_contains_str\n}\n\n\nfn expr_uses_builtin(expr: Expr, fn_names: Array[String], target: String) -> Bool {\n  let free_vars = collect_free_vars(expr, array_empty(), fn_names)\n  let normalized_target = canonical_builtin_name(target)\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(free_vars) && !found {\n    found = canonical_builtin_name(Array::get(free_vars, i)) == normalized_target\n    i = i + 1\n  }\n  found\n}\n\nexport fn stmts_use_builtin(stmts: Array[Stmt], fn_names: Array[String], target: String) -> Bool {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(stmts) && !found {\n    found = match Array::get(stmts, i) {\n      SLet(_, _, _, _, expr) => expr_uses_builtin(expr, fn_names, target),\n      SLetMut(_, _, expr) => expr_uses_builtin(expr, fn_names, target),\n      STest(_, expr) => expr_uses_builtin(expr, fn_names, target),\n      SBench(_, expr) => expr_uses_builtin(expr, fn_names, target),\n      SExpr(expr) => expr_uses_builtin(expr, fn_names, target),\n      SModule(_, _, inner) => stmts_use_builtin(inner, fn_names, target),\n      _ => false\n    }\n    i = i + 1\n  }\n  found\n}\n\nfn push_free_canonical(expr: Expr, fn_name_index: Array[String], sink: Array[(String, Bool)]) -> Unit {\n  let fvs = collect_free_vars_used_builtins(expr, array_empty(), fn_name_index)\n  let mut j = 0\n  while j < Array::length(fvs) {\n    Array::push(sink, (canonical_builtin_name(Array::get(fvs, j)), true))\n    j = j + 1\n  }\n}\n\nexport fn collect_used_builtin_names_into(stmts: Array[Stmt], fn_names: Array[String], fn_name_index: Array[String], sink: Array[(String, Bool)]) -> Unit {\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SLet(_, _, _, _, expr) => push_free_canonical(expr, fn_name_index, sink),\n      SLetMut(_, _, expr) => push_free_canonical(expr, fn_name_index, sink),\n      STest(_, expr) => push_free_canonical(expr, fn_name_index, sink),\n      SBench(_, expr) => push_free_canonical(expr, fn_name_index, sink),\n      SExpr(expr) => push_free_canonical(expr, fn_name_index, sink),\n      SModule(_, _, inner) => collect_used_builtin_names_into(inner, fn_names, fn_name_index, sink),\n      _ => ()\n    }\n    i = i + 1\n  }\n}\n\nexport fn collect_used_builtin_names(stmts: Array[Stmt], fn_names: Array[String]) -> Map[String, Bool] {\n  let fn_name_index = sorted_names_of(fn_names)\n  let sink = array_empty()\n  collect_used_builtin_names_into(stmts, fn_names, fn_name_index, sink)\n  let set_b = MapBuilder::new()\n  let mut k = 0\n  while k < Array::length(sink) {\n    let (nm, _) = Array::get(sink, k)\n    MapBuilder::set(set_b, nm, true)\n    k = k + 1\n  }\n  MapBuilder::freeze(set_b)\n}\n")
}

let source_109 = () -> (String, String) {
  ("lib/@vibe/compiler/codegen/wasi/linked_compile.vibe",
"\nimport @vibe/compiler/core {\n  Expr,\n  Pat,\n  Stmt,\n  TypeExpr,\n  bsearch_leftmost,\n  bytebuf_length,\n  bytebuf_new,\n  bytebuf_push,\n  bytebuf_push_buf,\n  bytebuf_push_section,\n  bytebuf_push_vec_header,\n  bytebuf_to_bytes,\n  exception_effect_labels_equal,\n  is_exception_effect_name,\n  leb128_encode_s64,\n  leb128_encode_u32,\n  rewrite_top_level_fn_alias_refs,\n  sorted_names_of\n}\n\nimport @vibe/core {\n  array_empty\n}\n\nimport @vibe/compiler/normalize {\n  lift_match_scrutinees, uniquify_shadowed_bindings\n}\n\nimport @vibe/compiler/perceus {\n  PerceusAction,\n  build_perceus_plan,\n  build_perceus_plan_with_params,\n  compute_borrow_returning_names,\n  compute_heap_returning,\n  compute_scalar_returning_names,\n  elaborate_heap_params,\n  pa_is_alias_dup,\n  pa_is_drop,\n  pa_is_dup,\n  param_is_heap_in_body\n}\n\nimport @vibe/compiler/codegen/builtin_bodies {\n  gen_arr_concat_body,\n  gen_arr_get_body,\n  gen_arr_len_body,\n  gen_arr_new_body,\n  gen_arr_push_all_body,\n  gen_arr_push_body,\n  gen_arr_set_body,\n  gen_arr_slice_body,\n  gen_arr_truncate_body,\n  gen_bytes_append_body,\n  gen_bytes_concat_body,\n  gen_bytes_from_array_body,\n  gen_bytes_get_body,\n  gen_bytes_len_body,\n  gen_bytes_new_body,\n  gen_bytes_push_body,\n  gen_bytes_set_body,\n  gen_bytes_slice_body,\n  gen_bytes_to_array_body,\n  gen_eq_body,\n  gen_generic_add_body,\n  gen_generic_rel_diff_body,\n  gen_map_build_index_body,\n  gen_map_cap_body,\n  gen_map_hash_body,\n  gen_map_index_insert_body,\n  gen_map_probe_index_body,\n  gen_rc_alloc_body,\n  gen_rc_drop_body,\n  gen_simd_scan_alnum_body,\n  gen_simd_skip_ws_body,\n  gen_sources_proper_body,\n  gen_sources_stub_body,\n  gen_str_char_code_at_body,\n  gen_str_concat_body,\n  gen_str_eq_body,\n  gen_str_from_char_code_body,\n  gen_str_len_body,\n  gen_str_lex_diff_body,\n  gen_str_substring_body,\n  gen_string_contains_body,\n  gen_string_ends_with_body,\n  gen_string_index_of_body,\n  gen_string_join_body,\n  gen_string_last_index_of_body,\n  gen_string_split_body,\n  gen_string_starts_with_body,\n  gen_string_trim_body,\n  static_arr_get_body,\n  static_arr_len_body,\n  static_arr_set_body,\n  static_arr_truncate_body,\n  static_double_to_int_body,\n  static_fs_stub_body,\n  static_fs_write_bytes_stub_body,\n  static_identity_body,\n  static_int_to_double_body,\n  static_print_i64_body,\n  static_print_str_body,\n  static_str_char_code_at_body,\n  static_str_eq_body,\n  static_str_len_body\n}\n\nimport @vibe/compiler/codegen/common_analysis {\n  bmask_has,\n  collect_free_vars,\n  collect_strings_stmts,\n  compute_borrow_param_user_fns,\n  compute_may_return_view_fns,\n  count_lambda_sites_expr,\n  emit_closure_call_tail,\n  emit_closure_resolve,\n  emit_i64_extend_i32_u,\n  is_mut_captured_in,\n  scope_tail_proj_root,\n  stmts_contain_exceptions,\n  zero_alloc_check\n}\n\nimport @vibe/compiler/codegen/common_base {\n  CodegenBodyCache,\n  CompileCtx,\n  CovState,\n  CtorTable,\n  DbgProv,\n  FuncTable,\n  LambdaTable,\n  LineMapState,\n  StrTable,\n  agg_info_of_type_expr,\n  await_poll_pass,\n  builtin_registry,\n  codegen_body_cache_find,\n  codegen_body_cache_merge,\n  codegen_body_cache_new,\n  codegen_body_cache_record,\n  codegen_body_cache_replay,\n  compile_inline_wat_full,\n  compute_agg_returning,\n  ctor_sorted_index,\n  desugar_trait_dicts,\n  emit_binop_op,\n  emit_i32_eq,\n  emit_i32_eqz,\n  emit_i32_ge_u,\n  emit_i32_mul,\n  emit_i32_ne,\n  emit_i32_sub,\n  emit_i64_load,\n  emit_i64_store,\n  emit_rc_dup_guarded,\n  emit_str_ref,\n  empty_dbg_prov,\n  ensure_exn_kind_cell,\n  evidence_dict_pass,\n  exn_kind_read_expr,\n  exn_msg_read_expr,\n  expr_tag,\n  fn_type_param_types,\n  get_arm_body,\n  get_arm_pat,\n  get_ebinop_op,\n  get_efn_body,\n  get_eif_cond,\n  get_eif_else,\n  get_eif_then,\n  get_elet_body,\n  get_elet_name,\n  get_elet_val,\n  get_slet_expr,\n  get_slet_name,\n  get_slet_type,\n  inline_direct_performs,\n  is_efn,\n  is_eident,\n  is_etuple,\n  is_pbind,\n  is_pbool,\n  is_pctor,\n  is_pint,\n  is_pstring,\n  is_ptuple,\n  is_pwild,\n  is_slet,\n  lookup_ctor,\n  rc_shadow_reserve,\n  resolve_func,\n  resolve_local,\n  rewrite_self_tail_calls,\n  suspend_cps_pass,\n  verify_lane_builtins\n}\n\nimport @vibe/compiler/codegen/common_extractors {\n  array_contains_str,\n  build_newline_offsets,\n  emit_assignop_op,\n  emit_memory_copy,\n  find_catchall_idx,\n  get_earray_elems,\n  get_eassign_body,\n  get_eassign_name,\n  get_eassign_val,\n  get_eassignop_body,\n  get_eassignop_name,\n  get_eassignop_op,\n  get_eassignop_val,\n  get_ebinop_lhs,\n  get_ebinop_rhs,\n  get_ebool_value,\n  get_ecall_args,\n  get_ecall_callee,\n  get_efloat_value,\n  get_efn_params,\n  get_eforin_body,\n  get_eforin_iter,\n  get_eforin_name,\n  get_eident_name,\n  get_eint_value,\n  get_eletmut_body,\n  get_eletmut_name,\n  get_eletmut_val,\n  get_eletrec_body,\n  get_eletrec_name,\n  get_eletrec_val,\n  get_eseq_first,\n  get_eseq_second,\n  get_estring_value,\n  get_etuple_elems,\n  get_eunaryop_expr,\n  get_eunaryop_op,\n  get_ewhile_body,\n  get_ewhile_cond,\n  get_match_arms,\n  get_match_scrutinee,\n  get_pbind_name,\n  get_pbool_value,\n  get_pctor_args,\n  get_pctor_name,\n  get_pint_value,\n  get_pstring_value,\n  get_ptuple_pats,\n  get_slet_export,\n  str_table_lookup\n}\n\nimport @vibe/compiler/codegen/expr {\n  cc_host_future_named_raw_prefix, cc_host_stream_named_raw_prefix, compile_expr\n}\n\nimport @vibe/compiler/codegen/wasm_emit {\n  emit_block_i64,\n  emit_block_void,\n  emit_br,\n  emit_br_if,\n  emit_call,\n  emit_call_indirect,\n  emit_code_section,\n  emit_code_section_with_locals,\n  emit_data_section,\n  emit_data_section_multi,\n  emit_drop,\n  emit_element_section_active,\n  emit_element_section_active_runs,\n  emit_else,\n  emit_end,\n  emit_export_section,\n  emit_export_section_multi,\n  emit_exports_full,\n  emit_exports_with_memory,\n  emit_f64_add,\n  emit_f64_const_bits,\n  emit_f64_convert_i64_s,\n  emit_f64_div,\n  emit_f64_eq,\n  emit_f64_ge,\n  emit_f64_gt,\n  emit_f64_le,\n  emit_f64_lt,\n  emit_f64_mul,\n  emit_f64_ne,\n  emit_f64_neg,\n  emit_f64_reinterpret_i64,\n  emit_f64_sub,\n  emit_func_type_raw,\n  emit_function_name_section,\n  emit_function_section,\n  emit_global_get,\n  emit_global_section_i32_mut,\n  emit_global_set,\n  emit_header,\n  emit_heap_memory_grow_check,\n  emit_i32_add,\n  emit_i32_const,\n  emit_i32_load,\n  emit_i32_load8_u,\n  emit_i32_store,\n  emit_i32_store8,\n  emit_i32_wrap_i64,\n  emit_i64_add,\n  emit_i64_and,\n  emit_i64_const,\n  emit_i64_div_s,\n  emit_i64_eq,\n  emit_i64_eqz,\n  emit_i64_extend_i32_s,\n  emit_i64_ge_s,\n  emit_i64_gt_s,\n  emit_i64_le_s,\n  emit_i64_lt_s,\n  emit_i64_mul,\n  emit_i64_ne,\n  emit_i64_or,\n  emit_i64_reinterpret_f64,\n  emit_i64_rem_s,\n  emit_i64_shl,\n  emit_i64_shr_s,\n  emit_i64_store,\n  emit_i64_sub,\n  emit_i64_trunc_f64_s,\n  emit_i64_xor,\n  emit_if_i64,\n  emit_if_void,\n  emit_import_section_func,\n  emit_local_get,\n  emit_local_set,\n  emit_local_tee,\n  emit_loop_void,\n  emit_memory_section,\n  emit_name,\n  emit_return,\n  emit_table_section_funcref,\n  emit_type_section,\n  emit_type_section_multi,\n  emit_vibe_abi_custom_section,\n  string_to_data\n}\n\n\n\nlet wasm_page_size = 65536\n\nfn lc_fresh_int_array() -> Array[Int] {\n  ArrayBuilder::freeze(ArrayBuilder::new())\n}\n\nfn lc_fresh_bool_array() -> Array[Bool] {\n  ArrayBuilder::freeze(ArrayBuilder::new())\n}\n\nfn lc_fresh_bytes_array() -> Array[Bytes] {\n  ArrayBuilder::freeze(ArrayBuilder::new())\n}\n\nfn lc_fresh_string_array() -> Array[String] {\n  ArrayBuilder::freeze(ArrayBuilder::new())\n}\n\nfn lc_fresh_expr_array() -> Array[Expr] {\n  ArrayBuilder::freeze(ArrayBuilder::new())\n}\n\nfn lc_fresh_type_expr_array() -> Array[TypeExpr] {\n  ArrayBuilder::freeze(ArrayBuilder::new())\n}\n\nfn lc_fresh_int_array_of_len(n: Int, fill: Int) -> Array[Int] {\n  let arr = lc_fresh_int_array()\n  let mut i = 0\n  while i < n {\n    Array::push(arr, fill)\n    i = i + 1\n  }\n  arr\n}\n\nfn bytebuf_push_i32le(buf: Bytes, v: Int) -> Unit {\n  bytebuf_push(buf, v&255)\n  bytebuf_push(buf, (v>>8)&255)\n  bytebuf_push(buf, (v>>16)&255)\n  bytebuf_push(buf, (v>>24)&255)\n}\n\nfn lc_is_borrow_arg0_call(f: String) -> Bool {\n  f == \"__index\" || f == \"Array::get\" || f == \"Array::length\" || f == \"Array::set\" || f == \"Array::push\" || f == \"ArrayBuilder::push\" || f == \"StringBuilder::push\" || f == \"MapBuilder::set\" || f == \"MapBuilder::has_key\" || f == \"MapBuilder::get\" || f == \"Map::get\" || f == \"Map::keys\" || f == \"Map::has_key\" || f == \"Map::has\" || f == \"Map::set\" || f == \"Map::size\" || f == \"Map::values\" || f == \"Map::delete\" || f == \"Bytes::push\" || f == \"Bytes::set\" || f == \"Bytes::get\" || f == \"Bytes::length\" || f == \"FrozenArray::get\" || f == \"FrozenArray::length\" || f == \"__rec_field\"\n}\n\nfn lc_has_nonloop_consume(e: Expr, name: String) -> Bool {\n  match e {\n    EIdent(n, _) => n == name,\n    ETuple(items) => lc_hnc_any(items, name),\n    EArray(items) => lc_hnc_any(items, name),\n    ERecord(_, fields, _) => {\n      let mut found = false\n      let mut i = 0\n      while i < Array::length(fields) {\n        let (_, v) = Array::get(fields, i)\n        if lc_has_nonloop_consume(v, name) {\n          found = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      found\n    },\n    EMap(fields) => {\n      let mut found = false\n      let mut i = 0\n      while i < Array::length(fields) {\n        let (_, v) = Array::get(fields, i)\n        if lc_has_nonloop_consume(v, name) {\n          found = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      found\n    },\n    EIf(c, t, el) => lc_has_nonloop_consume(c, name) || lc_has_nonloop_consume(t, name) || lc_has_nonloop_consume(el, name),\n    ELet(_, v, b, _) => lc_has_nonloop_consume(v, name) || lc_has_nonloop_consume(b, name),\n    ELetRec(_, v, b) => lc_has_nonloop_consume(v, name) || lc_has_nonloop_consume(b, name),\n    ELetMut(_, v, b, _) => lc_has_nonloop_consume(v, name) || lc_has_nonloop_consume(b, name),\n    EAssign(_, v, b) => lc_has_nonloop_consume(v, name) || lc_has_nonloop_consume(b, name),\n    EAssignOp(_, _, v, b) => lc_has_nonloop_consume(v, name) || lc_has_nonloop_consume(b, name),\n    ESeq(a, b) => lc_has_nonloop_consume(a, name) || lc_has_nonloop_consume(b, name),\n    EMatch(s, arms) => {\n      let scr = match s {\n        EIdent(_, _) => false,\n        _ => lc_has_nonloop_consume(s, name)\n      }\n      let mut found = scr\n      let mut i = 0\n      while i < Array::length(arms) {\n        let (_, ab) = Array::get(arms, i)\n        if lc_has_nonloop_consume(ab, name) {\n          found = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      found\n    },\n    EHandle(s, arms) => {\n      let scr = match s {\n        EIdent(_, _) => false,\n        _ => lc_has_nonloop_consume(s, name)\n      }\n      let mut found = scr\n      let mut i = 0\n      while i < Array::length(arms) {\n        let (_, ab) = Array::get(arms, i)\n        if lc_has_nonloop_consume(ab, name) {\n          found = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      found\n    },\n    EWhile(c, _) => lc_has_nonloop_consume(c, name),\n    ELoop(params, _) => {\n      let mut found = false\n      let mut i = 0\n      while i < Array::length(params) {\n        let (_, v) = Array::get(params, i)\n        if lc_has_nonloop_consume(v, name) {\n          found = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      found\n    },\n    EForIn(_, _, it, _) => lc_has_nonloop_consume(it, name),\n    ECall(callee, args, _) => {\n      let borrow0 = match callee {\n        EIdent(f, _) => lc_is_borrow_arg0_call(f),\n        _ => false\n      }\n      let callee_c = match callee {\n        EIdent(_, _) => false,\n        _ => lc_has_nonloop_consume(callee, name)\n      }\n      let mut found = callee_c\n      let mut i = 0\n      while i < Array::length(args) {\n        let skip_borrowed_head = borrow0 && i == 0 && (match Array::get(args, i) {\n          EIdent(_, _) => true,\n          _ => false\n        })\n        if skip_borrowed_head {\n          ()\n        } else if lc_has_nonloop_consume(Array::get(args, i), name) {\n          found = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      found\n    },\n    EBinOp(_, l, r) => lc_has_nonloop_consume(l, name) || lc_has_nonloop_consume(r, name),\n    EUnaryOp(_, x) => lc_has_nonloop_consume(x, name),\n    EFn(_, _, _, _, _, fb) => lc_has_nonloop_consume(fb, name),\n    EDot(x, _, _, _) => lc_has_nonloop_consume(x, name),\n    ELabeledArg(_, _, v) => lc_has_nonloop_consume(v, name),\n    EReturn(x) => lc_has_nonloop_consume(x, name),\n    EBreak(opt) => match opt {\n      Some(v) => lc_has_nonloop_consume(v, name),\n      None => false\n    },\n    EContinue(args) => lc_hnc_any(args, name),\n    ESpread(x) => lc_has_nonloop_consume(x, name),\n    _ => false\n  }\n}\n\nfn lc_hnc_any(items: Array[Expr], name: String) -> Bool {\n  let mut found = false\n  let mut i = 0\n  while i < Array::length(items) {\n    if lc_has_nonloop_consume(Array::get(items, i), name) {\n      found = true\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  found\n}\n\nfn struct_field_types(sfields: Array[(String, TypeExpr)]) -> Array[TypeExpr] {\n  let out = lc_fresh_type_expr_array()\n  let mut i = 0\n  while i < Array::length(sfields) {\n    let (_, ft) = Array::get(sfields, i)\n    Array::push(out, ft)\n    i = i + 1\n  }\n  out\n}\n\nfn push_ctor_float_fields(out: Array[Int], ctor_idx: Int, field_types: Array[TypeExpr]) -> Unit {\n  let mut fi = 0\n  while fi < Array::length(field_types) {\n    match Array::get(field_types, fi) {\n      TyName(ftn) => if ftn == \"Float\" || ftn == \"Double\" {\n        Array::push(out, ctor_idx * 64 + fi)\n      } else {\n        ()\n      },\n      _ => ()\n    }\n    fi = fi + 1\n  }\n}\n\nfn lc_fresh_string_matrix() -> Array[Array[String]] {\n  ArrayBuilder::freeze(ArrayBuilder::new())\n}\n\nfn gen_heap_grow_check_body() -> Bytes {\n  let b = bytebuf_new()\n  emit_heap_memory_grow_check(b)\n  b\n}\n\nfn lc_extract_inline_wasm(stmts: Array[Stmt], names: Array[String], wats: Array[String]) -> Unit {\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SLet(iw_exp, iw_rec, iw_name, iw_ann, iw_expr) => match iw_expr {\n        EFn(iw_tps, iw_tbs, iw_params, iw_ret, iw_eff, iw_body) => match iw_body {\n          ECall(iw_cal, iw_args, _) => match iw_cal {\n            EIdent(iw_cn, _) => if iw_cn == \"%wasm\" && Array::length(iw_args) == 1 {\n              match Array::get(iw_args, 0) {\n                EString(iw_wat) => {\n                  Array::push(names, iw_name)\n                  Array::push(wats, iw_wat)\n                  Array::set(stmts, i, SLet(iw_exp, iw_rec, iw_name, iw_ann, EFn(iw_tps, iw_tbs, iw_params, iw_ret, iw_eff, EInt(0))))\n                },\n                _ => ()\n              }\n            } else {\n              ()\n            },\n            _ => ()\n          },\n          _ => ()\n        },\n        _ => ()\n      },\n      _ => ()\n    }\n    i = i + 1\n  }\n}\n\nfn lc_compile_iw_body(body_buf: Bytes, fn_name_dbg: String, iw_wats: Array[String], iw_found: Int, iw_param_names: Array[String], param_count: Int, iw_extra_cell: Array[Int]) -> Unit with { Error } {\n  Array::set(iw_extra_cell, 0, 0)\n  Array::set(iw_extra_cell, 1, 0)\n  Array::set(iw_extra_cell, 2, 0)\n  if iw_found < 0 {\n    ()\n  } else {\n    let (iw_bytes, iw_n32, iw_n64, iw_nv) = compile_inline_wat_full(fn_name_dbg, Array::get(iw_wats, iw_found), iw_param_names, param_count)\n    bytebuf_push_buf(body_buf, iw_bytes)\n    Array::set(iw_extra_cell, 0, iw_n32)\n    Array::set(iw_extra_cell, 1, iw_n64)\n    Array::set(iw_extra_cell, 2, iw_nv)\n  }\n}\n\nlet default_wasi_memory_min_pages = 64\n\nexport fn wasi_memory_min_pages_for_heap(heap_start: Int) -> Int {\n  let needed_pages = (heap_start + wasm_page_size - 1) / wasm_page_size\n  if needed_pages > default_wasi_memory_min_pages {\n    needed_pages\n  } else {\n    default_wasi_memory_min_pages\n  }\n}\n\nfn linked_type_expr_is_unit(t: TypeExpr) -> Bool {\n  match t {\n    TyUnit => true,\n    TyName(n) => n == \"Unit\",\n    _ => false\n  }\n}\n\nfn lc_row_has_label(eff: Option[String], label: String) -> Bool {\n  match eff {\n    Some(row) => {\n      let mut found = false\n      let mut start = 0\n      let n = String::length(row)\n      let mut i = 0\n      while i <= n {\n        let at_sep = if i == n {\n          true\n        } else {\n          String::char_code_at(row, i) == 44\n        }\n        if at_sep {\n          if exception_effect_labels_equal(String::trim(String::substring(row, start, i)), label) {\n            found = true\n          } else {\n            ()\n          }\n          start = i + 1\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      found\n    },\n    None => false\n  }\n}\n\nfn lc_row_has_error(eff: Option[String]) -> Bool {\n  lc_row_has_label(eff, \"Error\")\n}\n\nfn lc_wrap_entry_error_boundary(stmts: Array[Stmt], entry_name: String) -> Unit {\n  let mut i = 0\n  let mut wrapped_any = false\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SLet(exported, is_rec, name, ty, EFn(tps, tbs, params, ret, eff, body)) => if name == entry_name && lc_row_has_error(eff) {\n        let kind_ident = EIdent(\"__entry_err_kind\", -1)\n        let msg_ident = EIdent(\"__entry_err_rendered\", -1)\n        let printable = EBinOp(\"||\", ECall(EIdent(\"String::equals\", -1), [\n          kind_ident,\n          EString(\"\")\n        ], -1), EBinOp(\"||\", ECall(EIdent(\"String::equals\", -1), [\n          kind_ident,\n          EString(\"String\")\n        ], -1), ECall(EIdent(\"String::equals\", -1), [\n          kind_ident,\n          EString(\"Int\")\n        ], -1)))\n        let rendered_ok = EBinOp(\"!=\", ECall(EIdent(\"String::length\", -1), [\n          msg_ident\n        ], -1), EInt(0))\n        let text = EIf(printable, ECall(EIdent(\"__to_string\", -1), [\n          EIdent(\"__entry_err_msg\", -1)\n        ], -1), EIf(rendered_ok, msg_ident, ECall(EIdent(\"String::concat\", -1), [\n          EString(\"<\"),\n          ECall(EIdent(\"String::concat\", -1), [\n            kind_ident,\n            EString(\">\")\n          ], -1)\n        ], -1)))\n        let diag = ELet(\"__entry_err_kind\", exn_kind_read_expr(), ELet(\"__entry_err_rendered\", exn_msg_read_expr(), ESeq(ECall(EIdent(\"Stderr::write_stream\", -1), [\n          EString(\"vibe: uncaught error: \")\n        ], -1), ESeq(ECall(EIdent(\"Stderr::write_stream\", -1), [\n          text\n        ], -1), ESeq(ECall(EIdent(\"Stderr::write_stream\", -1), [\n          EString(\"\\n\")\n        ], -1), EInt(1)))), -1), -1)\n        let wrapped = EHandle(body, [\n          (PCtor(\"Error::Throw\", [\n            PBind(\"__entry_err_msg\")\n          ]), diag)\n        ])\n        Array::set(stmts, i, SLet(exported, is_rec, name, ty, EFn(tps, tbs, params, ret, eff, wrapped)))\n        wrapped_any = true\n      } else {\n        ()\n      },\n      _ => ()\n    }\n    i = i + 1\n  }\n  if wrapped_any {\n    ensure_exn_kind_cell(stmts)\n  } else {\n    ()\n  }\n}\n\nfn lc_pat_binds_name(p: Pat, target: String) -> Bool {\n  match p {\n    PBind(n) => n == target,\n    PCtor(_, ps) => lc_pats_bind_name(ps, target),\n    PTuple(ps) => lc_pats_bind_name(ps, target),\n    POr(a, b) => lc_pat_binds_name(a, target) || lc_pat_binds_name(b, target),\n    PStruct(_, fields) => {\n      let mut i = 0\n      let mut hit = false\n      while i < Array::length(fields) {\n        let (_, fp) = Array::get(fields, i)\n        if lc_pat_binds_name(fp, target) {\n          hit = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      hit\n    },\n    _ => false\n  }\n}\n\nfn lc_pats_bind_name(ps: Array[Pat], target: String) -> Bool {\n  let mut i = 0\n  let mut hit = false\n  while i < Array::length(ps) {\n    if lc_pat_binds_name(Array::get(ps, i), target) {\n      hit = true\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  hit\n}\n\nfn lc_pat_binds_sleep(p: Pat) -> Bool {\n  lc_pat_binds_name(p, \"sleep\")\n}\n\nfn lc_rename_sleep_calls(e: Expr, active: Bool) -> Expr {\n  match e {\n    ECall(callee, args, off) => {\n      let new_args = lc_fresh_expr_array()\n      let mut i = 0\n      while i < Array::length(args) {\n        Array::push(new_args, lc_rename_sleep_calls(Array::get(args, i), active))\n        i = i + 1\n      }\n      let new_callee = match callee {\n        EIdent(nm, coff) => if active && nm == \"sleep\" {\n          EIdent(\"__slp_perform\", coff)\n        } else {\n          callee\n        },\n        _ => lc_rename_sleep_calls(callee, active)\n      }\n      ECall(new_callee, new_args, off)\n    },\n    ELet(x, v, b, off) => ELet(x, lc_rename_sleep_calls(v, active), lc_rename_sleep_calls(b, active && x != \"sleep\"), off),\n    ELetMut(x, v, b, off) => ELetMut(x, lc_rename_sleep_calls(v, active), lc_rename_sleep_calls(b, active && x != \"sleep\"), off),\n    ELetRec(x, v, b) => {\n      let inner = active && x != \"sleep\"\n      ELetRec(x, lc_rename_sleep_calls(v, inner), lc_rename_sleep_calls(b, inner))\n    },\n    ESeq(a, b) => ESeq(lc_rename_sleep_calls(a, active), lc_rename_sleep_calls(b, active)),\n    EIf(c, t, el) => EIf(lc_rename_sleep_calls(c, active), lc_rename_sleep_calls(t, active), lc_rename_sleep_calls(el, active)),\n    EMatch(s, arms) => {\n      let out: Array[(Pat, Expr)] = array_empty()\n      let mut i = 0\n      while i < Array::length(arms) {\n        let (mp, mb) = Array::get(arms, i)\n        Array::push(out, (mp, lc_rename_sleep_calls(mb, active && !lc_pat_binds_sleep(mp))))\n        i = i + 1\n      }\n      EMatch(lc_rename_sleep_calls(s, active), out)\n    },\n    EHandle(b, arms) => {\n      let out: Array[(Pat, Expr)] = array_empty()\n      let mut i = 0\n      while i < Array::length(arms) {\n        let (mp, mb) = Array::get(arms, i)\n        Array::push(out, (mp, lc_rename_sleep_calls(mb, active && !lc_pat_binds_sleep(mp))))\n        i = i + 1\n      }\n      EHandle(lc_rename_sleep_calls(b, active), out)\n    },\n    EFn(tps, tbs, params, ret, eff, b) => {\n      let mut shadowed = false\n      let mut i = 0\n      while i < Array::length(params) {\n        let (pn, _) = Array::get(params, i)\n        if pn == \"sleep\" {\n          shadowed = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      EFn(tps, tbs, params, ret, eff, lc_rename_sleep_calls(b, active && !shadowed))\n    },\n    EWhile(c, b) => EWhile(lc_rename_sleep_calls(c, active), lc_rename_sleep_calls(b, active)),\n    EForIn(x, ix, it, b) => {\n      let inner = active && x != \"sleep\"\n      EForIn(x, ix, lc_rename_sleep_calls(it, active), lc_rename_sleep_calls(b, inner))\n    },\n    ELoop(pairs, b) => {\n      let out: Array[(String, Expr)] = array_empty()\n      let mut inner = active\n      let mut i = 0\n      while i < Array::length(pairs) {\n        let (pn, pv) = Array::get(pairs, i)\n        if pn == \"sleep\" {\n          inner = false\n        } else {\n          ()\n        }\n        Array::push(out, (pn, lc_rename_sleep_calls(pv, active)))\n        i = i + 1\n      }\n      ELoop(out, lc_rename_sleep_calls(b, inner))\n    },\n    EBinOp(op, l, r) => EBinOp(op, lc_rename_sleep_calls(l, active), lc_rename_sleep_calls(r, active)),\n    EUnaryOp(op, a) => EUnaryOp(op, lc_rename_sleep_calls(a, active)),\n    EAssign(x, v, b) => EAssign(x, lc_rename_sleep_calls(v, active), lc_rename_sleep_calls(b, active)),\n    EAssignOp(op, x, v, b) => EAssignOp(op, x, lc_rename_sleep_calls(v, active), lc_rename_sleep_calls(b, active)),\n    EReturn(a) => EReturn(lc_rename_sleep_calls(a, active)),\n    EDot(o, f, m, off) => EDot(lc_rename_sleep_calls(o, active), f, m, off),\n    ELabeledArg(l, s, v) => ELabeledArg(l, s, lc_rename_sleep_calls(v, active)),\n    EBreak(opt) => match opt {\n      Some(a) => EBreak(Some(lc_rename_sleep_calls(a, active))),\n      None => e\n    },\n    EContinue(args) => {\n      let out = lc_fresh_expr_array()\n      let mut i = 0\n      while i < Array::length(args) {\n        Array::push(out, lc_rename_sleep_calls(Array::get(args, i), active))\n        i = i + 1\n      }\n      EContinue(out)\n    },\n    ETuple(items) => {\n      let out = lc_fresh_expr_array()\n      let mut i = 0\n      while i < Array::length(items) {\n        Array::push(out, lc_rename_sleep_calls(Array::get(items, i), active))\n        i = i + 1\n      }\n      ETuple(out)\n    },\n    EArray(items) => {\n      let out = lc_fresh_expr_array()\n      let mut i = 0\n      while i < Array::length(items) {\n        Array::push(out, lc_rename_sleep_calls(Array::get(items, i), active))\n        i = i + 1\n      }\n      EArray(out)\n    },\n    ERecord(nm, fields, off) => {\n      let out: Array[(String, Expr)] = array_empty()\n      let mut i = 0\n      while i < Array::length(fields) {\n        let (fn2, fv) = Array::get(fields, i)\n        Array::push(out, (fn2, lc_rename_sleep_calls(fv, active)))\n        i = i + 1\n      }\n      ERecord(nm, out, off)\n    },\n    EMap(fields) => {\n      let out: Array[(String, Expr)] = array_empty()\n      let mut i = 0\n      while i < Array::length(fields) {\n        let (fk, fv) = Array::get(fields, i)\n        Array::push(out, (fk, lc_rename_sleep_calls(fv, active)))\n        i = i + 1\n      }\n      EMap(out)\n    },\n    ESpread(a) => ESpread(lc_rename_sleep_calls(a, active)),\n    _ => e\n  }\n}\n\nfn lc_rename_hs_call(e: Expr, active: Bool, from_name: String, to_name: String) -> Expr {\n  match e {\n    ECall(callee, args, off) => {\n      let new_args = lc_fresh_expr_array()\n      let mut i = 0\n      while i < Array::length(args) {\n        Array::push(new_args, lc_rename_hs_call(Array::get(args, i), active, from_name, to_name))\n        i = i + 1\n      }\n      let new_callee = match callee {\n        EIdent(nm, coff) => if active && nm == from_name {\n          EIdent(to_name, coff)\n        } else {\n          callee\n        },\n        _ => lc_rename_hs_call(callee, active, from_name, to_name)\n      }\n      ECall(new_callee, new_args, off)\n    },\n    ELet(x, v, b, off) => ELet(x, lc_rename_hs_call(v, active, from_name, to_name), lc_rename_hs_call(b, active && x != from_name, from_name, to_name), off),\n    ELetMut(x, v, b, off) => ELetMut(x, lc_rename_hs_call(v, active, from_name, to_name), lc_rename_hs_call(b, active && x != from_name, from_name, to_name), off),\n    ELetRec(x, v, b) => {\n      let inner = active && x != from_name\n      ELetRec(x, lc_rename_hs_call(v, inner, from_name, to_name), lc_rename_hs_call(b, inner, from_name, to_name))\n    },\n    ESeq(a, b) => ESeq(lc_rename_hs_call(a, active, from_name, to_name), lc_rename_hs_call(b, active, from_name, to_name)),\n    EIf(c, t, el) => EIf(lc_rename_hs_call(c, active, from_name, to_name), lc_rename_hs_call(t, active, from_name, to_name), lc_rename_hs_call(el, active, from_name, to_name)),\n    EMatch(s, arms) => {\n      let out: Array[(Pat, Expr)] = array_empty()\n      let mut i = 0\n      while i < Array::length(arms) {\n        let (mp, mb) = Array::get(arms, i)\n        Array::push(out, (mp, lc_rename_hs_call(mb, active && !lc_pat_binds_name(mp, from_name), from_name, to_name)))\n        i = i + 1\n      }\n      EMatch(lc_rename_hs_call(s, active, from_name, to_name), out)\n    },\n    EHandle(b, arms) => {\n      let out: Array[(Pat, Expr)] = array_empty()\n      let mut i = 0\n      while i < Array::length(arms) {\n        let (mp, mb) = Array::get(arms, i)\n        Array::push(out, (mp, lc_rename_hs_call(mb, active && !lc_pat_binds_name(mp, from_name), from_name, to_name)))\n        i = i + 1\n      }\n      EHandle(lc_rename_hs_call(b, active, from_name, to_name), out)\n    },\n    EFn(tps, tbs, params, ret, eff, b) => {\n      let mut shadowed = false\n      let mut i = 0\n      while i < Array::length(params) {\n        let (pn, _) = Array::get(params, i)\n        if pn == from_name {\n          shadowed = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      EFn(tps, tbs, params, ret, eff, lc_rename_hs_call(b, active && !shadowed, from_name, to_name))\n    },\n    EWhile(c, b) => EWhile(lc_rename_hs_call(c, active, from_name, to_name), lc_rename_hs_call(b, active, from_name, to_name)),\n    EForIn(x, ix, it, b) => {\n      let inner = active && x != from_name\n      EForIn(x, ix, lc_rename_hs_call(it, active, from_name, to_name), lc_rename_hs_call(b, inner, from_name, to_name))\n    },\n    ELoop(pairs, b) => {\n      let out: Array[(String, Expr)] = array_empty()\n      let mut inner = active\n      let mut i = 0\n      while i < Array::length(pairs) {\n        let (pn, pv) = Array::get(pairs, i)\n        if pn == from_name {\n          inner = false\n        } else {\n          ()\n        }\n        Array::push(out, (pn, lc_rename_hs_call(pv, active, from_name, to_name)))\n        i = i + 1\n      }\n      ELoop(out, lc_rename_hs_call(b, inner, from_name, to_name))\n    },\n    EBinOp(op, l, r) => EBinOp(op, lc_rename_hs_call(l, active, from_name, to_name), lc_rename_hs_call(r, active, from_name, to_name)),\n    EUnaryOp(op, a) => EUnaryOp(op, lc_rename_hs_call(a, active, from_name, to_name)),\n    EAssign(x, v, b) => EAssign(x, lc_rename_hs_call(v, active, from_name, to_name), lc_rename_hs_call(b, active, from_name, to_name)),\n    EAssignOp(op, x, v, b) => EAssignOp(op, x, lc_rename_hs_call(v, active, from_name, to_name), lc_rename_hs_call(b, active, from_name, to_name)),\n    EReturn(a) => EReturn(lc_rename_hs_call(a, active, from_name, to_name)),\n    EDot(o, f, m, off) => EDot(lc_rename_hs_call(o, active, from_name, to_name), f, m, off),\n    ELabeledArg(l, s, v) => ELabeledArg(l, s, lc_rename_hs_call(v, active, from_name, to_name)),\n    EBreak(opt) => match opt {\n      Some(a) => EBreak(Some(lc_rename_hs_call(a, active, from_name, to_name))),\n      None => e\n    },\n    EContinue(args) => {\n      let out = lc_fresh_expr_array()\n      let mut i = 0\n      while i < Array::length(args) {\n        Array::push(out, lc_rename_hs_call(Array::get(args, i), active, from_name, to_name))\n        i = i + 1\n      }\n      EContinue(out)\n    },\n    ETuple(items) => {\n      let out = lc_fresh_expr_array()\n      let mut i = 0\n      while i < Array::length(items) {\n        Array::push(out, lc_rename_hs_call(Array::get(items, i), active, from_name, to_name))\n        i = i + 1\n      }\n      ETuple(out)\n    },\n    EArray(items) => {\n      let out = lc_fresh_expr_array()\n      let mut i = 0\n      while i < Array::length(items) {\n        Array::push(out, lc_rename_hs_call(Array::get(items, i), active, from_name, to_name))\n        i = i + 1\n      }\n      EArray(out)\n    },\n    ERecord(nm, fields, off) => {\n      let out: Array[(String, Expr)] = array_empty()\n      let mut i = 0\n      while i < Array::length(fields) {\n        let (fn2, fv) = Array::get(fields, i)\n        Array::push(out, (fn2, lc_rename_hs_call(fv, active, from_name, to_name)))\n        i = i + 1\n      }\n      ERecord(nm, out, off)\n    },\n    EMap(fields) => {\n      let out: Array[(String, Expr)] = array_empty()\n      let mut i = 0\n      while i < Array::length(fields) {\n        let (fk, fv) = Array::get(fields, i)\n        Array::push(out, (fk, lc_rename_hs_call(fv, active, from_name, to_name)))\n        i = i + 1\n      }\n      EMap(out)\n    },\n    ESpread(a) => ESpread(lc_rename_hs_call(a, active, from_name, to_name)),\n    _ => e\n  }\n}\n\nfn lc_rename_hs_next_calls(e: Expr, active: Bool) -> Expr {\n  lc_rename_hs_call(e, active, \"host_stream_next\", \"__hs_next\")\n}\n\nfn lc_rename_hs_close_calls(e: Expr, active: Bool) -> Expr {\n  lc_rename_hs_call(e, active, \"host_stream_close\", \"__hs_close\")\n}\n\nfn lc_rename_hs_maybe_close(enabled: Bool, e: Expr, active: Bool) -> Expr {\n  if enabled {\n    lc_rename_hs_close_calls(e, active)\n  } else {\n    e\n  }\n}\n\nfn lc_expr_has_async_handle(e: Expr) -> Bool {\n  match e {\n    EHandle(b, arms) => {\n      let mut hit = false\n      let mut i = 0\n      while i < Array::length(arms) {\n        let (p, ab) = Array::get(arms, i)\n        match p {\n          PCtor(cname, _) => if String::starts_with(cname, \"Async::\") {\n            hit = true\n          } else {\n            ()\n          },\n          _ => ()\n        }\n        if lc_expr_has_async_handle(ab) {\n          hit = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      hit || lc_expr_has_async_handle(b)\n    },\n    ELet(_, v, b, _) => lc_expr_has_async_handle(v) || lc_expr_has_async_handle(b),\n    ELetMut(_, v, b, _) => lc_expr_has_async_handle(v) || lc_expr_has_async_handle(b),\n    ELetRec(_, v, b) => lc_expr_has_async_handle(v) || lc_expr_has_async_handle(b),\n    ESeq(a, b) => lc_expr_has_async_handle(a) || lc_expr_has_async_handle(b),\n    EIf(c, t, el) => lc_expr_has_async_handle(c) || lc_expr_has_async_handle(t) || lc_expr_has_async_handle(el),\n    EMatch(s, arms) => {\n      let mut hit = lc_expr_has_async_handle(s)\n      let mut i = 0\n      while i < Array::length(arms) {\n        let (_, ab) = Array::get(arms, i)\n        if lc_expr_has_async_handle(ab) {\n          hit = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      hit\n    },\n    EFn(_, _, _, _, _, b) => lc_expr_has_async_handle(b),\n    EWhile(c, b) => lc_expr_has_async_handle(c) || lc_expr_has_async_handle(b),\n    EForIn(_, _, it, b) => lc_expr_has_async_handle(it) || lc_expr_has_async_handle(b),\n    ELoop(pairs, b) => {\n      let mut hit = lc_expr_has_async_handle(b)\n      let mut i = 0\n      while i < Array::length(pairs) {\n        let (_, pv) = Array::get(pairs, i)\n        if lc_expr_has_async_handle(pv) {\n          hit = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      hit\n    },\n    ERecord(_, fields, _) => lc_pairs_have_async_handle(fields),\n    EMap(fields) => lc_pairs_have_async_handle(fields),\n    EBreak(opt) => match opt {\n      Some(a) => lc_expr_has_async_handle(a),\n      None => false\n    },\n    EContinue(args) => lc_exprs_have_async_handle(args),\n    ECall(callee, args, _) => {\n      let mut hit = lc_expr_has_async_handle(callee)\n      let mut i = 0\n      while i < Array::length(args) {\n        if lc_expr_has_async_handle(Array::get(args, i)) {\n          hit = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      hit\n    },\n    EBinOp(_, l, r) => lc_expr_has_async_handle(l) || lc_expr_has_async_handle(r),\n    EUnaryOp(_, a) => lc_expr_has_async_handle(a),\n    EAssign(_, v, b) => lc_expr_has_async_handle(v) || lc_expr_has_async_handle(b),\n    EAssignOp(_, _, v, b) => lc_expr_has_async_handle(v) || lc_expr_has_async_handle(b),\n    EReturn(a) => lc_expr_has_async_handle(a),\n    EDot(o, _, _, _) => lc_expr_has_async_handle(o),\n    ELabeledArg(_, _, v) => lc_expr_has_async_handle(v),\n    ETuple(items) => lc_exprs_have_async_handle(items),\n    EArray(items) => lc_exprs_have_async_handle(items),\n    ESpread(a) => lc_expr_has_async_handle(a),\n    _ => false\n  }\n}\n\nfn lc_exprs_have_async_handle(es: Array[Expr]) -> Bool {\n  let mut hit = false\n  let mut i = 0\n  while i < Array::length(es) {\n    if lc_expr_has_async_handle(Array::get(es, i)) {\n      hit = true\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  hit\n}\n\nfn lc_pairs_have_async_handle(pairs: Array[(String, Expr)]) -> Bool {\n  let mut hit = false\n  let mut i = 0\n  while i < Array::length(pairs) {\n    let (_, v) = Array::get(pairs, i)\n    if lc_expr_has_async_handle(v) {\n      hit = true\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  hit\n}\n\nfn lc_expr_calls_name(e: Expr, target: String) -> Bool {\n  match e {\n    ECall(callee, args, _) => {\n      let callee_hit = match callee {\n        EIdent(nm, _) => nm == target,\n        _ => lc_expr_calls_name(callee, target)\n      }\n      let mut hit = callee_hit\n      let mut i = 0\n      while i < Array::length(args) {\n        if lc_expr_calls_name(Array::get(args, i), target) {\n          hit = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      hit\n    },\n    ELet(_, v, b, _) => lc_expr_calls_name(v, target) || lc_expr_calls_name(b, target),\n    ELetMut(_, v, b, _) => lc_expr_calls_name(v, target) || lc_expr_calls_name(b, target),\n    ELetRec(_, v, b) => lc_expr_calls_name(v, target) || lc_expr_calls_name(b, target),\n    ESeq(a, b) => lc_expr_calls_name(a, target) || lc_expr_calls_name(b, target),\n    EIf(c, t, el) => lc_expr_calls_name(c, target) || lc_expr_calls_name(t, target) || lc_expr_calls_name(el, target),\n    EMatch(s, arms) => {\n      let mut hit = lc_expr_calls_name(s, target)\n      let mut i = 0\n      while i < Array::length(arms) {\n        let (_, ab) = Array::get(arms, i)\n        if lc_expr_calls_name(ab, target) {\n          hit = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      hit\n    },\n    EHandle(b, arms) => {\n      let mut hit = lc_expr_calls_name(b, target)\n      let mut i = 0\n      while i < Array::length(arms) {\n        let (_, ab) = Array::get(arms, i)\n        if lc_expr_calls_name(ab, target) {\n          hit = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      hit\n    },\n    EFn(_, _, _, _, _, b) => lc_expr_calls_name(b, target),\n    EWhile(c, b) => lc_expr_calls_name(c, target) || lc_expr_calls_name(b, target),\n    EForIn(_, _, it, b) => lc_expr_calls_name(it, target) || lc_expr_calls_name(b, target),\n    ELoop(pairs, b) => {\n      let mut hit = lc_expr_calls_name(b, target)\n      let mut i = 0\n      while i < Array::length(pairs) {\n        let (_, pv) = Array::get(pairs, i)\n        if lc_expr_calls_name(pv, target) {\n          hit = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      hit\n    },\n    EBinOp(_, l, r) => lc_expr_calls_name(l, target) || lc_expr_calls_name(r, target),\n    EUnaryOp(_, a) => lc_expr_calls_name(a, target),\n    EAssign(_, v, b) => lc_expr_calls_name(v, target) || lc_expr_calls_name(b, target),\n    EAssignOp(_, _, v, b) => lc_expr_calls_name(v, target) || lc_expr_calls_name(b, target),\n    EReturn(a) => lc_expr_calls_name(a, target),\n    EDot(o, _, _, _) => lc_expr_calls_name(o, target),\n    ELabeledArg(_, _, v) => lc_expr_calls_name(v, target),\n    ETuple(items) => lc_exprs_call_name(items, target),\n    EArray(items) => lc_exprs_call_name(items, target),\n    ERecord(_, fields, _) => lc_fields_call_name(fields, target),\n    EMap(fields) => lc_fields_call_name(fields, target),\n    EBreak(opt) => match opt {\n      Some(a) => lc_expr_calls_name(a, target),\n      None => false\n    },\n    EContinue(args) => lc_exprs_call_name(args, target),\n    ESpread(a) => lc_expr_calls_name(a, target),\n    _ => false\n  }\n}\n\nfn lc_fields_call_name(fields: Array[(String, Expr)], target: String) -> Bool {\n  let mut hit = false\n  let mut i = 0\n  while i < Array::length(fields) {\n    let (_, fv) = Array::get(fields, i)\n    if lc_expr_calls_name(fv, target) {\n      hit = true\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  hit\n}\n\nfn lc_exprs_call_name(es: Array[Expr], target: String) -> Bool {\n  let mut hit = false\n  let mut i = 0\n  while i < Array::length(es) {\n    if lc_expr_calls_name(Array::get(es, i), target) {\n      hit = true\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  hit\n}\n\nfn lc_expr_calls_sleep(e: Expr) -> Bool {\n  lc_expr_calls_name(e, \"sleep\")\n}\n\nfn lc_expr_calls_host_future(e: Expr) -> Bool {\n  lc_expr_calls_name(e, \"host_future_get\") || lc_expr_calls_name(e, \"host_future_named\")\n}\n\nfn lc_expr_collect_hf_names(e: Expr, active: Bool, out: Array[String]) -> Unit {\n  match e {\n    ECall(callee, args, _) => {\n      match callee {\n        EIdent(nm, _) => if active && nm == \"host_future_named\" && Array::length(args) == 1 {\n          match Array::get(args, 0) {\n            EString(s) => Array::push(out, s),\n            _ => ()\n          }\n        } else {\n          ()\n        },\n        _ => lc_expr_collect_hf_names(callee, active, out)\n      }\n      lc_exprs_collect_hf_names(args, active, out)\n    },\n    ELet(x, v, b, _) => {\n      lc_expr_collect_hf_names(v, active, out)\n      lc_expr_collect_hf_names(b, active && x != \"host_future_named\", out)\n    },\n    ELetMut(x, v, b, _) => {\n      lc_expr_collect_hf_names(v, active, out)\n      lc_expr_collect_hf_names(b, active && x != \"host_future_named\", out)\n    },\n    ELetRec(x, v, b) => {\n      let inner = active && x != \"host_future_named\"\n      lc_expr_collect_hf_names(v, inner, out)\n      lc_expr_collect_hf_names(b, inner, out)\n    },\n    ESeq(a, b) => {\n      lc_expr_collect_hf_names(a, active, out)\n      lc_expr_collect_hf_names(b, active, out)\n    },\n    EIf(c, t, el) => {\n      lc_expr_collect_hf_names(c, active, out)\n      lc_expr_collect_hf_names(t, active, out)\n      lc_expr_collect_hf_names(el, active, out)\n    },\n    EMatch(s, arms) => {\n      lc_expr_collect_hf_names(s, active, out)\n      lc_arms_collect_hf_names(arms, active, out)\n    },\n    EHandle(b, arms) => {\n      lc_expr_collect_hf_names(b, active, out)\n      lc_arms_collect_hf_names(arms, active, out)\n    },\n    EFn(_, _, params, _, _, b) => {\n      let mut shadowed = false\n      let mut i = 0\n      while i < Array::length(params) {\n        let (pn, _) = Array::get(params, i)\n        if pn == \"host_future_named\" {\n          shadowed = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      lc_expr_collect_hf_names(b, active && !shadowed, out)\n    },\n    EWhile(c, b) => {\n      lc_expr_collect_hf_names(c, active, out)\n      lc_expr_collect_hf_names(b, active, out)\n    },\n    EForIn(x, _, it, b) => {\n      lc_expr_collect_hf_names(it, active, out)\n      lc_expr_collect_hf_names(b, active && x != \"host_future_named\", out)\n    },\n    ELoop(pairs, b) => {\n      let mut inner = active\n      let mut i = 0\n      while i < Array::length(pairs) {\n        let (pn, pv) = Array::get(pairs, i)\n        if pn == \"host_future_named\" {\n          inner = false\n        } else {\n          ()\n        }\n        lc_expr_collect_hf_names(pv, active, out)\n        i = i + 1\n      }\n      lc_expr_collect_hf_names(b, inner, out)\n    },\n    EBinOp(_, l, r) => {\n      lc_expr_collect_hf_names(l, active, out)\n      lc_expr_collect_hf_names(r, active, out)\n    },\n    EUnaryOp(_, a) => lc_expr_collect_hf_names(a, active, out),\n    EAssign(_, v, b) => {\n      lc_expr_collect_hf_names(v, active, out)\n      lc_expr_collect_hf_names(b, active, out)\n    },\n    EAssignOp(_, _, v, b) => {\n      lc_expr_collect_hf_names(v, active, out)\n      lc_expr_collect_hf_names(b, active, out)\n    },\n    EReturn(a) => lc_expr_collect_hf_names(a, active, out),\n    EDot(o, _, _, _) => lc_expr_collect_hf_names(o, active, out),\n    ELabeledArg(_, _, v) => lc_expr_collect_hf_names(v, active, out),\n    EBreak(opt) => match opt {\n      Some(a) => lc_expr_collect_hf_names(a, active, out),\n      None => ()\n    },\n    EContinue(args) => lc_exprs_collect_hf_names(args, active, out),\n    ETuple(items) => lc_exprs_collect_hf_names(items, active, out),\n    EArray(items) => lc_exprs_collect_hf_names(items, active, out),\n    ERecord(_, fields, _) => lc_fields_collect_hf_names(fields, active, out),\n    EMap(fields) => lc_fields_collect_hf_names(fields, active, out),\n    ESpread(a) => lc_expr_collect_hf_names(a, active, out),\n    _ => ()\n  }\n}\n\nfn lc_exprs_collect_hf_names(es: Array[Expr], active: Bool, out: Array[String]) -> Unit {\n  let mut i = 0\n  while i < Array::length(es) {\n    lc_expr_collect_hf_names(Array::get(es, i), active, out)\n    i = i + 1\n  }\n}\n\nfn lc_fields_collect_hf_names(fields: Array[(String, Expr)], active: Bool, out: Array[String]) -> Unit {\n  let mut i = 0\n  while i < Array::length(fields) {\n    let (_, fv) = Array::get(fields, i)\n    lc_expr_collect_hf_names(fv, active, out)\n    i = i + 1\n  }\n}\n\nfn lc_arms_collect_hf_names(arms: Array[(Pat, Expr)], active: Bool, out: Array[String]) -> Unit {\n  let mut i = 0\n  while i < Array::length(arms) {\n    let (ap, ab) = Array::get(arms, i)\n    lc_expr_collect_hf_names(ab, active && !lc_pat_binds_name(ap, \"host_future_named\"), out)\n    i = i + 1\n  }\n}\n\nfn lc_program_defines_top_level(stmts: Array[Stmt], name: String) -> Bool {\n  let mut found = false\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SLet(_, _, nm, _, _) => if nm == name {\n        found = true\n      } else {\n        ()\n      },\n      SLetMut(nm, _, _) => if nm == name {\n        found = true\n      } else {\n        ()\n      },\n      _ => ()\n    }\n    i = i + 1\n  }\n  found\n}\n\nfn lc_collect_host_future_names(stmts: Array[Stmt]) -> Array[String] {\n  if lc_program_defines_top_level(stmts, \"host_future_named\") {\n    array_empty()\n  } else {\n    lc_collect_host_future_names_go(stmts)\n  }\n}\n\nfn lc_collect_host_future_names_go(stmts: Array[Stmt]) -> Array[String] {\n  let raw = array_empty()\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SLet(_, _, _, _, v) => lc_expr_collect_hf_names(v, true, raw),\n      SLetMut(_, _, v) => lc_expr_collect_hf_names(v, true, raw),\n      SExpr(v) => lc_expr_collect_hf_names(v, true, raw),\n      STest(_, v) => lc_expr_collect_hf_names(v, true, raw),\n      SBench(_, v) => lc_expr_collect_hf_names(v, true, raw),\n      _ => ()\n    }\n    i = i + 1\n  }\n  let sorted = sorted_names_of(raw)\n  let out = array_empty()\n  let mut k = 0\n  while k < Array::length(sorted) {\n    let nm = Array::get(sorted, k)\n    if k == 0 || Array::get(sorted, k - 1) != nm {\n      Array::push(out, nm)\n    } else {\n      ()\n    }\n    k = k + 1\n  }\n  out\n}\n\nfn lc_hs_req_base() -> Int {\n  2048\n}\n\nfn lc_expr_calls_host_stream(e: Expr) -> Bool {\n  lc_expr_calls_name(e, \"host_stream_named\") || lc_expr_calls_name(e, \"host_stream_next\") || lc_expr_calls_name(e, \"host_stream_close\")\n}\n\nfn lc_expr_collect_hs_names(e: Expr, active: Bool, out: Array[String]) -> Unit {\n  match e {\n    ECall(callee, args, _) => {\n      match callee {\n        EIdent(nm, _) => if active && nm == \"host_stream_named\" && Array::length(args) == 1 {\n          match Array::get(args, 0) {\n            EString(s) => Array::push(out, s),\n            _ => ()\n          }\n        } else {\n          ()\n        },\n        _ => lc_expr_collect_hs_names(callee, active, out)\n      }\n      lc_exprs_collect_hs_names(args, active, out)\n    },\n    ELet(x, v, b, _) => {\n      lc_expr_collect_hs_names(v, active, out)\n      lc_expr_collect_hs_names(b, active && x != \"host_stream_named\", out)\n    },\n    ELetMut(x, v, b, _) => {\n      lc_expr_collect_hs_names(v, active, out)\n      lc_expr_collect_hs_names(b, active && x != \"host_stream_named\", out)\n    },\n    ELetRec(x, v, b) => {\n      let inner = active && x != \"host_stream_named\"\n      lc_expr_collect_hs_names(v, inner, out)\n      lc_expr_collect_hs_names(b, inner, out)\n    },\n    ESeq(a, b) => {\n      lc_expr_collect_hs_names(a, active, out)\n      lc_expr_collect_hs_names(b, active, out)\n    },\n    EIf(c, t, el) => {\n      lc_expr_collect_hs_names(c, active, out)\n      lc_expr_collect_hs_names(t, active, out)\n      lc_expr_collect_hs_names(el, active, out)\n    },\n    EMatch(s, arms) => {\n      lc_expr_collect_hs_names(s, active, out)\n      lc_arms_collect_hs_names(arms, active, out)\n    },\n    EHandle(b, arms) => {\n      lc_expr_collect_hs_names(b, active, out)\n      lc_arms_collect_hs_names(arms, active, out)\n    },\n    EFn(_, _, params, _, _, b) => {\n      let mut shadowed = false\n      let mut i = 0\n      while i < Array::length(params) {\n        let (pn, _) = Array::get(params, i)\n        if pn == \"host_stream_named\" {\n          shadowed = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      lc_expr_collect_hs_names(b, active && !shadowed, out)\n    },\n    EWhile(c, b) => {\n      lc_expr_collect_hs_names(c, active, out)\n      lc_expr_collect_hs_names(b, active, out)\n    },\n    EForIn(x, _, it, b) => {\n      lc_expr_collect_hs_names(it, active, out)\n      lc_expr_collect_hs_names(b, active && x != \"host_stream_named\", out)\n    },\n    ELoop(pairs, b) => {\n      let mut inner = active\n      let mut i = 0\n      while i < Array::length(pairs) {\n        let (pn, pv) = Array::get(pairs, i)\n        if pn == \"host_stream_named\" {\n          inner = false\n        } else {\n          ()\n        }\n        lc_expr_collect_hs_names(pv, active, out)\n        i = i + 1\n      }\n      lc_expr_collect_hs_names(b, inner, out)\n    },\n    EBinOp(_, l, r) => {\n      lc_expr_collect_hs_names(l, active, out)\n      lc_expr_collect_hs_names(r, active, out)\n    },\n    EUnaryOp(_, a) => lc_expr_collect_hs_names(a, active, out),\n    EAssign(_, v, b) => {\n      lc_expr_collect_hs_names(v, active, out)\n      lc_expr_collect_hs_names(b, active, out)\n    },\n    EAssignOp(_, _, v, b) => {\n      lc_expr_collect_hs_names(v, active, out)\n      lc_expr_collect_hs_names(b, active, out)\n    },\n    EReturn(a) => lc_expr_collect_hs_names(a, active, out),\n    EDot(o, _, _, _) => lc_expr_collect_hs_names(o, active, out),\n    ELabeledArg(_, _, v) => lc_expr_collect_hs_names(v, active, out),\n    EBreak(opt) => match opt {\n      Some(a) => lc_expr_collect_hs_names(a, active, out),\n      None => ()\n    },\n    EContinue(args) => lc_exprs_collect_hs_names(args, active, out),\n    ETuple(items) => lc_exprs_collect_hs_names(items, active, out),\n    EArray(items) => lc_exprs_collect_hs_names(items, active, out),\n    ERecord(_, fields, _) => lc_fields_collect_hs_names(fields, active, out),\n    EMap(fields) => lc_fields_collect_hs_names(fields, active, out),\n    ESpread(a) => lc_expr_collect_hs_names(a, active, out),\n    _ => ()\n  }\n}\n\nfn lc_exprs_collect_hs_names(es: Array[Expr], active: Bool, out: Array[String]) -> Unit {\n  let mut i = 0\n  while i < Array::length(es) {\n    lc_expr_collect_hs_names(Array::get(es, i), active, out)\n    i = i + 1\n  }\n}\n\nfn lc_fields_collect_hs_names(fields: Array[(String, Expr)], active: Bool, out: Array[String]) -> Unit {\n  let mut i = 0\n  while i < Array::length(fields) {\n    let (_, fv) = Array::get(fields, i)\n    lc_expr_collect_hs_names(fv, active, out)\n    i = i + 1\n  }\n}\n\nfn lc_arms_collect_hs_names(arms: Array[(Pat, Expr)], active: Bool, out: Array[String]) -> Unit {\n  let mut i = 0\n  while i < Array::length(arms) {\n    let (ap, ab) = Array::get(arms, i)\n    lc_expr_collect_hs_names(ab, active && !lc_pat_binds_name(ap, \"host_stream_named\"), out)\n    i = i + 1\n  }\n}\n\nfn lc_collect_host_stream_names(stmts: Array[Stmt]) -> Array[String] {\n  if lc_program_defines_top_level(stmts, \"host_stream_named\") {\n    array_empty()\n  } else {\n    lc_collect_host_stream_names_go(stmts)\n  }\n}\n\nfn lc_collect_host_stream_names_go(stmts: Array[Stmt]) -> Array[String] {\n  let raw = array_empty()\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SLet(_, _, _, _, v) => lc_expr_collect_hs_names(v, true, raw),\n      SLetMut(_, _, v) => lc_expr_collect_hs_names(v, true, raw),\n      SExpr(v) => lc_expr_collect_hs_names(v, true, raw),\n      STest(_, v) => lc_expr_collect_hs_names(v, true, raw),\n      SBench(_, v) => lc_expr_collect_hs_names(v, true, raw),\n      _ => ()\n    }\n    i = i + 1\n  }\n  let sorted = sorted_names_of(raw)\n  let out = array_empty()\n  let mut k = 0\n  while k < Array::length(sorted) {\n    let nm = Array::get(sorted, k)\n    if k == 0 || Array::get(sorted, k - 1) != nm {\n      Array::push(out, nm)\n    } else {\n      ()\n    }\n    k = k + 1\n  }\n  out\n}\n\nfn lc_stmts_call_host_future(stmts: Array[Stmt]) -> Bool {\n  let mut hit = false\n  let mut i = 0\n  while i < Array::length(stmts) {\n    let se = match Array::get(stmts, i) {\n      SLet(_, _, _, _, v) => lc_expr_calls_host_future(v),\n      SLetMut(_, _, v) => lc_expr_calls_host_future(v),\n      SExpr(v) => lc_expr_calls_host_future(v),\n      STest(_, v) => lc_expr_calls_host_future(v),\n      SBench(_, v) => lc_expr_calls_host_future(v),\n      _ => false\n    }\n    if se {\n      hit = true\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  hit\n}\n\nfn lc_waiter_hooks_available(stmts: Array[Stmt], linked_imports: Array[(String, String, Int, Int)]) -> Bool {\n  let mut has_wait = false\n  let mut has_notify = false\n  let mut li = 0\n  while li < Array::length(linked_imports) {\n    let (_, lname, _, _) = Array::get(linked_imports, li)\n    if lname == \"__aw_wait\" {\n      has_wait = true\n    } else {\n      ()\n    }\n    if lname == \"__aw_notify_resolve\" {\n      has_notify = true\n    } else {\n      ()\n    }\n    li = li + 1\n  }\n  let mut si = 0\n  while si < Array::length(stmts) {\n    match Array::get(stmts, si) {\n      SLet(_, _, nm, _, _) => {\n        if nm == \"__aw_wait\" {\n          has_wait = true\n        } else {\n          ()\n        }\n        if nm == \"__aw_notify_resolve\" {\n          has_notify = true\n        } else {\n          ()\n        }\n      },\n      _ => ()\n    }\n    si = si + 1\n  }\n  has_wait && has_notify\n}\n\nfn lc_rename_sleep_scoped(e: Expr) -> Expr {\n  match e {\n    EHandle(b, arms) => {\n      let mut is_async_handle = false\n      let out: Array[(Pat, Expr)] = array_empty()\n      let mut i = 0\n      while i < Array::length(arms) {\n        let (p, ab) = Array::get(arms, i)\n        match p {\n          PCtor(cname, _) => if String::starts_with(cname, \"Async::\") {\n            is_async_handle = true\n          } else {\n            ()\n          },\n          _ => ()\n        }\n        Array::push(out, (p, lc_rename_sleep_scoped(ab)))\n        i = i + 1\n      }\n      if is_async_handle {\n        EHandle(lc_rename_sleep_calls(b, true), out)\n      } else {\n        EHandle(lc_rename_sleep_scoped(b), out)\n      }\n    },\n    EFn(tps, tbs, params, ret, eff, b) => if lc_row_has_label(eff, \"Async\") {\n      EFn(tps, tbs, params, ret, eff, lc_rename_sleep_calls(b, true))\n    } else {\n      EFn(tps, tbs, params, ret, eff, lc_rename_sleep_scoped(b))\n    },\n    ELet(x, v, b, off) => ELet(x, lc_rename_sleep_scoped(v), lc_rename_sleep_scoped(b), off),\n    ELetMut(x, v, b, off) => ELetMut(x, lc_rename_sleep_scoped(v), lc_rename_sleep_scoped(b), off),\n    ELetRec(x, v, b) => ELetRec(x, lc_rename_sleep_scoped(v), lc_rename_sleep_scoped(b)),\n    ESeq(a, b) => ESeq(lc_rename_sleep_scoped(a), lc_rename_sleep_scoped(b)),\n    EIf(c, t, el) => EIf(lc_rename_sleep_scoped(c), lc_rename_sleep_scoped(t), lc_rename_sleep_scoped(el)),\n    EMatch(s, arms) => {\n      let out: Array[(Pat, Expr)] = array_empty()\n      let mut i = 0\n      while i < Array::length(arms) {\n        let (mp, mb) = Array::get(arms, i)\n        Array::push(out, (mp, lc_rename_sleep_scoped(mb)))\n        i = i + 1\n      }\n      EMatch(lc_rename_sleep_scoped(s), out)\n    },\n    EWhile(c, b) => EWhile(lc_rename_sleep_scoped(c), lc_rename_sleep_scoped(b)),\n    EForIn(x, ix, it, b) => EForIn(x, ix, lc_rename_sleep_scoped(it), lc_rename_sleep_scoped(b)),\n    ELoop(pairs, b) => {\n      let out: Array[(String, Expr)] = array_empty()\n      let mut i = 0\n      while i < Array::length(pairs) {\n        let (pn, pv) = Array::get(pairs, i)\n        Array::push(out, (pn, lc_rename_sleep_scoped(pv)))\n        i = i + 1\n      }\n      ELoop(out, lc_rename_sleep_scoped(b))\n    },\n    ECall(callee, args, off) => {\n      let out = lc_fresh_expr_array()\n      let mut i = 0\n      while i < Array::length(args) {\n        Array::push(out, lc_rename_sleep_scoped(Array::get(args, i)))\n        i = i + 1\n      }\n      ECall(lc_rename_sleep_scoped(callee), out, off)\n    },\n    EBinOp(op, l, r) => EBinOp(op, lc_rename_sleep_scoped(l), lc_rename_sleep_scoped(r)),\n    EUnaryOp(op, a) => EUnaryOp(op, lc_rename_sleep_scoped(a)),\n    EAssign(x, v, b) => EAssign(x, lc_rename_sleep_scoped(v), lc_rename_sleep_scoped(b)),\n    EAssignOp(op, x, v, b) => EAssignOp(op, x, lc_rename_sleep_scoped(v), lc_rename_sleep_scoped(b)),\n    EReturn(a) => EReturn(lc_rename_sleep_scoped(a)),\n    EDot(o, f, m, off) => EDot(lc_rename_sleep_scoped(o), f, m, off),\n    ELabeledArg(l, s, v) => ELabeledArg(l, s, lc_rename_sleep_scoped(v)),\n    EBreak(opt) => match opt {\n      Some(a) => EBreak(Some(lc_rename_sleep_scoped(a))),\n      None => e\n    },\n    EContinue(args) => {\n      let out = lc_fresh_expr_array()\n      let mut i = 0\n      while i < Array::length(args) {\n        Array::push(out, lc_rename_sleep_scoped(Array::get(args, i)))\n        i = i + 1\n      }\n      EContinue(out)\n    },\n    ETuple(items) => {\n      let out = lc_fresh_expr_array()\n      let mut i = 0\n      while i < Array::length(items) {\n        Array::push(out, lc_rename_sleep_scoped(Array::get(items, i)))\n        i = i + 1\n      }\n      ETuple(out)\n    },\n    EArray(items) => {\n      let out = lc_fresh_expr_array()\n      let mut i = 0\n      while i < Array::length(items) {\n        Array::push(out, lc_rename_sleep_scoped(Array::get(items, i)))\n        i = i + 1\n      }\n      EArray(out)\n    },\n    ERecord(nm, fields, off) => {\n      let out: Array[(String, Expr)] = array_empty()\n      let mut i = 0\n      while i < Array::length(fields) {\n        let (fn2, fv) = Array::get(fields, i)\n        Array::push(out, (fn2, lc_rename_sleep_scoped(fv)))\n        i = i + 1\n      }\n      ERecord(nm, out, off)\n    },\n    EMap(fields) => {\n      let out: Array[(String, Expr)] = array_empty()\n      let mut i = 0\n      while i < Array::length(fields) {\n        let (fk, fv) = Array::get(fields, i)\n        Array::push(out, (fk, lc_rename_sleep_scoped(fv)))\n        i = i + 1\n      }\n      EMap(out)\n    },\n    ESpread(a) => ESpread(lc_rename_sleep_scoped(a)),\n    _ => e\n  }\n}\n\nfn lc_expr_has_spawn_suspend(e: Expr) -> Bool {\n  match e {\n    ECall(EIdent(name, _), args, _) => {\n      if name == \"TaskGroup::spawn_suspend\" || name == \"spawn_suspend\" {\n        true\n      } else {\n        lc_exprs_have_spawn_suspend(args)\n      }\n    },\n    ECall(callee, args, _) => lc_expr_has_spawn_suspend(callee) || lc_exprs_have_spawn_suspend(args),\n    ELet(_, value, body, _) => lc_expr_has_spawn_suspend(value) || lc_expr_has_spawn_suspend(body),\n    ELetMut(_, value, body, _) => lc_expr_has_spawn_suspend(value) || lc_expr_has_spawn_suspend(body),\n    ELetRec(_, value, body) => lc_expr_has_spawn_suspend(value) || lc_expr_has_spawn_suspend(body),\n    ESeq(a, b) => lc_expr_has_spawn_suspend(a) || lc_expr_has_spawn_suspend(b),\n    EIf(c, t, el) => lc_expr_has_spawn_suspend(c) || lc_expr_has_spawn_suspend(t) || lc_expr_has_spawn_suspend(el),\n    EFn(_, _, _, _, _, body) => lc_expr_has_spawn_suspend(body),\n    _ => false\n  }\n}\n\nfn lc_exprs_have_spawn_suspend(es: Array[Expr]) -> Bool {\n  let mut found = false\n  let mut i = 0\n  while i < Array::length(es) {\n    if lc_expr_has_spawn_suspend(Array::get(es, i)) {\n      found = true\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  found\n}\n\nfn lc_inject_async_sleep_boundary(stmts: Array[Stmt], entry_name: String) -> String {\n  let mut entry_has_async = false\n  let mut user_defines_sleep = false\n  let mut has_async_decl = false\n  let mut has_async_handle = false\n  let mut calls_sleep = false\n  let mut calls_host_future = false\n  let mut user_defines_host_future = false\n  let mut calls_host_stream = false\n  let mut calls_host_stream_close = false\n  let mut user_defines_host_stream = false\n  let mut has_spawn_suspend = false\n  let mut has_aw_poll = false\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SLet(_, _, name, _, EFn(_, _, _, _, eff, fbody)) => {\n        if name == entry_name && lc_row_has_label(eff, \"Async\") {\n          entry_has_async = true\n        } else {\n          ()\n        }\n        if name == \"sleep\" {\n          user_defines_sleep = true\n        } else {\n          ()\n        }\n        if name == \"__aw_poll\" {\n          has_aw_poll = true\n        } else {\n          ()\n        }\n        if lc_expr_has_async_handle(fbody) {\n          has_async_handle = true\n        } else {\n          ()\n        }\n        if lc_expr_calls_sleep(fbody) {\n          calls_sleep = true\n        } else {\n          ()\n        }\n        if name == \"host_future_get\" || name == \"host_future_named\" {\n          user_defines_host_future = true\n        } else {\n          ()\n        }\n        if lc_expr_calls_host_future(fbody) {\n          calls_host_future = true\n        } else {\n          ()\n        }\n        if name == \"host_stream_named\" || name == \"host_stream_next\" || name == \"host_stream_close\" {\n          user_defines_host_stream = true\n        } else {\n          ()\n        }\n        if lc_expr_calls_host_stream(fbody) {\n          calls_host_stream = true\n        } else {\n          ()\n        }\n        if lc_expr_calls_name(fbody, \"host_stream_close\") {\n          calls_host_stream_close = true\n        } else {\n          ()\n        }\n        if lc_expr_has_spawn_suspend(fbody) {\n          has_spawn_suspend = true\n        } else {\n          ()\n        }\n      },\n      SLet(_, _, name, _, sv) => {\n        if name == \"sleep\" {\n          user_defines_sleep = true\n        } else {\n          ()\n        }\n        if name == \"host_future_get\" || name == \"host_future_named\" {\n          user_defines_host_future = true\n        } else {\n          ()\n        }\n        if name == \"host_stream_named\" || name == \"host_stream_next\" || name == \"host_stream_close\" {\n          user_defines_host_stream = true\n        } else {\n          ()\n        }\n        if lc_expr_has_async_handle(sv) {\n          has_async_handle = true\n        } else {\n          ()\n        }\n        if lc_expr_calls_sleep(sv) {\n          calls_sleep = true\n        } else {\n          ()\n        }\n        if lc_expr_calls_host_future(sv) {\n          calls_host_future = true\n        } else {\n          ()\n        }\n        if lc_expr_calls_host_stream(sv) {\n          calls_host_stream = true\n        } else {\n          ()\n        }\n        if lc_expr_calls_name(sv, \"host_stream_close\") {\n          calls_host_stream_close = true\n        } else {\n          ()\n        }\n      },\n      SLetMut(_, _, mv) => {\n        if lc_expr_has_async_handle(mv) {\n          has_async_handle = true\n        } else {\n          ()\n        }\n        if lc_expr_calls_sleep(mv) {\n          calls_sleep = true\n        } else {\n          ()\n        }\n        if lc_expr_calls_host_future(mv) {\n          calls_host_future = true\n        } else {\n          ()\n        }\n        if lc_expr_calls_host_stream(mv) {\n          calls_host_stream = true\n        } else {\n          ()\n        }\n        if lc_expr_calls_name(mv, \"host_stream_close\") {\n          calls_host_stream_close = true\n        } else {\n          ()\n        }\n      },\n      SExpr(se) => {\n        if lc_expr_has_async_handle(se) {\n          has_async_handle = true\n        } else {\n          ()\n        }\n        if lc_expr_calls_sleep(se) {\n          calls_sleep = true\n        } else {\n          ()\n        }\n        if lc_expr_calls_host_future(se) {\n          calls_host_future = true\n        } else {\n          ()\n        }\n        if lc_expr_calls_host_stream(se) {\n          calls_host_stream = true\n        } else {\n          ()\n        }\n        if lc_expr_calls_name(se, \"host_stream_close\") {\n          calls_host_stream_close = true\n        } else {\n          ()\n        }\n      },\n      STest(_, te) => {\n        if lc_expr_has_async_handle(te) {\n          has_async_handle = true\n        } else {\n          ()\n        }\n        if lc_expr_calls_sleep(te) {\n          calls_sleep = true\n        } else {\n          ()\n        }\n        if lc_expr_calls_host_future(te) {\n          calls_host_future = true\n        } else {\n          ()\n        }\n        if lc_expr_calls_host_stream(te) {\n          calls_host_stream = true\n        } else {\n          ()\n        }\n        if lc_expr_calls_name(te, \"host_stream_close\") {\n          calls_host_stream_close = true\n        } else {\n          ()\n        }\n      },\n      SBench(_, be) => {\n        if lc_expr_has_async_handle(be) {\n          has_async_handle = true\n        } else {\n          ()\n        }\n        if lc_expr_calls_sleep(be) {\n          calls_sleep = true\n        } else {\n          ()\n        }\n        if lc_expr_calls_host_future(be) {\n          calls_host_future = true\n        } else {\n          ()\n        }\n        if lc_expr_calls_host_stream(be) {\n          calls_host_stream = true\n        } else {\n          ()\n        }\n        if lc_expr_calls_name(be, \"host_stream_close\") {\n          calls_host_stream_close = true\n        } else {\n          ()\n        }\n      },\n      SEffectDef(_, ename, _, _) => if ename == \"Async\" {\n        has_async_decl = true\n      } else {\n        ()\n      },\n      _ => ()\n    }\n    i = i + 1\n  }\n  if entry_has_async && (calls_sleep || calls_host_future || calls_host_stream) && has_spawn_suspend {\n    \"Async entry boundary and TaskGroup::spawn_suspend are mixing the step convention; handle Async inside the entry instead\"\n  } else {\n    let sleep_machinery = calls_sleep && !user_defines_sleep && (entry_has_async || has_async_handle)\n    let hf_machinery = calls_host_future && !user_defines_host_future && entry_has_async\n    let hs_machinery = calls_host_stream && !user_defines_host_stream && entry_has_async\n    let decl_needed = !has_async_decl && (sleep_machinery || hf_machinery || hs_machinery || (has_aw_poll && has_async_handle))\n    if decl_needed {\n      let ops: Array[(String, Array[TypeExpr], TypeExpr)] = [\n        (\"Suspend\", [\n          TyName(\"Int\")\n        ], TyName(\"Int\"))\n      ]\n      Array::push(stmts, SEffectDef(false, \"Async\", lc_fresh_string_array(), ops))\n    } else {\n      ()\n    }\n    if !sleep_machinery {\n      ()\n    } else {\n      let ms = EIdent(\"__slp_ms\", -1)\n      let suspend = ECall(EIdent(\"perform\", -1), [\n        ECall(EIdent(\"Async::Suspend\", -1), [\n          EBinOp(\"-\", EInt(0), ms)\n        ], -1)\n      ], -1)\n      let sleep_body = EIf(EBinOp(\"<\", EInt(0), ms), ELet(\"__slp_w\", suspend, EUnit, -1), EUnit)\n      let sleep_params: Array[(String, Option[TypeExpr])] = [\n        (\"__slp_ms\", Some(TyName(\"Int\")))\n      ]\n      Array::push(stmts, SLet(false, false, \"__slp_perform\", None, EFn(lc_fresh_string_array(), array_empty(), sleep_params, Some(TyName(\"Unit\")), Some(\"Async\"), sleep_body)))\n      let rename_stmt_expr = (rexpr: Expr) -> Expr {\n        if entry_has_async {\n          lc_rename_sleep_calls(rexpr, true)\n        } else {\n          match rexpr {\n            EFn(rtps, rtbs, rparams, rret, reff, rbody) => EFn(rtps, rtbs, rparams, rret, reff, lc_rename_sleep_scoped(rbody)),\n            _ => lc_rename_sleep_scoped(rexpr)\n          }\n        }\n      }\n      let mut r = 0\n      while r < Array::length(stmts) {\n        match Array::get(stmts, r) {\n          SLet(rex, rrec, rname, rty, rexpr) => if rname == \"__slp_perform\" {\n            ()\n          } else {\n            Array::set(stmts, r, SLet(rex, rrec, rname, rty, rename_stmt_expr(rexpr)))\n          },\n          SLetMut(mname, mty, mexpr) => {\n            Array::set(stmts, r, SLetMut(mname, mty, rename_stmt_expr(mexpr)))\n          },\n          STest(tname, texpr) => {\n            Array::set(stmts, r, STest(tname, rename_stmt_expr(texpr)))\n          },\n          SBench(bname, bexpr) => {\n            Array::set(stmts, r, SBench(bname, rename_stmt_expr(bexpr)))\n          },\n          SExpr(sexpr) => {\n            Array::set(stmts, r, SExpr(rename_stmt_expr(sexpr)))\n          },\n          _ => ()\n        }\n        r = r + 1\n      }\n    }\n    if !hs_machinery {\n      ()\n    } else {\n      let hsn_s = EIdent(\"__hsn_s\", -1)\n      let hsn_state = ECall(EIdent(\"Array::get\", -1), [\n        hsn_s,\n        EInt(0)\n      ], -1)\n      let hsn_hnd = ECall(EIdent(\"Array::get\", -1), [\n        hsn_s,\n        EInt(1)\n      ], -1)\n      let hsn_suspend = ECall(EIdent(\"perform\", -1), [\n        ECall(EIdent(\"Async::Suspend\", -1), [\n          EBinOp(\"+\", hsn_hnd, EInt(lc_hs_req_base()))\n        ], -1)\n      ], -1)\n      let hsn_body = EIf(EBinOp(\"==\", hsn_state, EInt(3)), ELet(\"__hsn_v\", hsn_suspend, ECall(EIdent(\"__hs_fin\", -1), [\n        hsn_s,\n        EIdent(\"__hsn_v\", -1)\n      ], -1), -1), EBinOp(\"-\", EInt(0), EInt(1)))\n      let hsn_params: Array[(String, Option[TypeExpr])] = [\n        (\"__hsn_s\", None)\n      ]\n      Array::push(stmts, SLet(false, false, \"__hs_next\", None, EFn(lc_fresh_string_array(), array_empty(), hsn_params, Some(TyName(\"Int\")), Some(\"Async\"), hsn_body)))\n      let hsf_s = EIdent(\"__hsf_s\", -1)\n      let hsf_v = EIdent(\"__hsf_v\", -1)\n      let hsf_close = ECall(EIdent(\"Array::set\", -1), [\n        hsf_s,\n        EInt(0),\n        EInt(0)\n      ], -1)\n      let hsf_body = EIf(EBinOp(\"<\", hsf_v, EInt(0)), ESeq(hsf_close, EBinOp(\"-\", EInt(0), EInt(1))), hsf_v)\n      let hsf_params: Array[(String, Option[TypeExpr])] = [\n        (\"__hsf_s\", None),\n        (\"__hsf_v\", None)\n      ]\n      Array::push(stmts, SLet(false, false, \"__hs_fin\", None, EFn(lc_fresh_string_array(), array_empty(), hsf_params, Some(TyName(\"Int\")), None, hsf_body)))\n      let hsc_s = EIdent(\"__hsc_s\", -1)\n      let hsc_state = ECall(EIdent(\"Array::get\", -1), [\n        hsc_s,\n        EInt(0)\n      ], -1)\n      let hsc_hnd = ECall(EIdent(\"Array::get\", -1), [\n        hsc_s,\n        EInt(1)\n      ], -1)\n      let hsc_drop = ECall(EIdent(\"vibe_hs_close_raw\", -1), [\n        hsc_hnd\n      ], -1)\n      let hsc_mark = ECall(EIdent(\"Array::set\", -1), [\n        hsc_s,\n        EInt(0),\n        EInt(0)\n      ], -1)\n      let hsc_body = EIf(EBinOp(\"==\", hsc_state, EInt(3)), ELet(\"__hsc_r\", hsc_drop, hsc_mark, -1), EUnit)\n      let hsc_params: Array[(String, Option[TypeExpr])] = [\n        (\"__hsc_s\", None)\n      ]\n      if calls_host_stream_close {\n        Array::push(stmts, SLet(false, false, \"__hs_close\", None, EFn(lc_fresh_string_array(), array_empty(), hsc_params, Some(TyName(\"Unit\")), None, hsc_body)))\n      } else {\n        ()\n      }\n      let mut hsr = 0\n      while hsr < Array::length(stmts) {\n        match Array::get(stmts, hsr) {\n          SLet(hrex, hrrec, hrname, hrty, hrexpr) => if hrname == \"__hs_next\" || hrname == \"__hs_fin\" || hrname == \"__hs_close\" {\n            ()\n          } else {\n            Array::set(stmts, hsr, SLet(hrex, hrrec, hrname, hrty, lc_rename_hs_maybe_close(calls_host_stream_close, lc_rename_hs_next_calls(hrexpr, true), true)))\n          },\n          SLetMut(hmname, hmty, hmexpr) => {\n            Array::set(stmts, hsr, SLetMut(hmname, hmty, lc_rename_hs_maybe_close(calls_host_stream_close, lc_rename_hs_next_calls(hmexpr, true), true)))\n          },\n          STest(htname, htexpr) => {\n            Array::set(stmts, hsr, STest(htname, lc_rename_hs_maybe_close(calls_host_stream_close, lc_rename_hs_next_calls(htexpr, true), true)))\n          },\n          SBench(hbname, hbexpr) => {\n            Array::set(stmts, hsr, SBench(hbname, lc_rename_hs_maybe_close(calls_host_stream_close, lc_rename_hs_next_calls(hbexpr, true), true)))\n          },\n          SExpr(hsexpr) => {\n            Array::set(stmts, hsr, SExpr(lc_rename_hs_maybe_close(calls_host_stream_close, lc_rename_hs_next_calls(hsexpr, true), true)))\n          },\n          _ => ()\n        }\n        hsr = hsr + 1\n      }\n    }\n    if entry_has_async && (sleep_machinery || hf_machinery || hs_machinery) {\n      let req = EIdent(\"__entry_slp_req\", -1)\n      let arm = if hf_machinery || hs_machinery {\n        let q = EIdent(\"__entry_hf_q\", -1)\n        let wait_call = ECall(EIdent(\"vibe_hf_wait_raw\", -1), [\n          EBinOp(\"-\", q, EInt(2))\n        ], -1)\n        let trap_zero = ESeq(ECall(EIdent(\"assert\", -1), [\n          EBinOp(\"==\", q, EInt(0))\n        ], -1), EInt(0))\n        let low = if sleep_machinery {\n          EIf(EBinOp(\"<\", q, EInt(0)), ESeq(ECall(EIdent(\"sleep_blocking\", -1), [\n            EBinOp(\"-\", EInt(0), q)\n          ], -1), EInt(0)), trap_zero)\n        } else {\n          trap_zero\n        }\n        let mid = if hf_machinery {\n          EIf(EBinOp(\"<\", EInt(1), q), wait_call, low)\n        } else {\n          low\n        }\n        let settle_body = if hs_machinery {\n          let hs_read_call = ECall(EIdent(\"vibe_hs_read_raw\", -1), [\n            EBinOp(\"-\", q, EInt(lc_hs_req_base()))\n          ], -1)\n          EIf(EBinOp(\"<\", EInt(lc_hs_req_base() - 1), q), hs_read_call, mid)\n        } else {\n          mid\n        }\n        let settle_params: Array[(String, Option[TypeExpr])] = [\n          (\"__entry_hf_q\", Some(TyName(\"Int\")))\n        ]\n        Array::push(stmts, SLet(false, false, \"__entry_settle\", None, EFn(lc_fresh_string_array(), array_empty(), settle_params, Some(TyName(\"Int\")), None, settle_body)))\n        ELet(\"__entry_slp_v\", ECall(EIdent(\"__entry_settle\", -1), [\n          req\n        ], -1), ECall(EIdent(\"resume\", -1), [\n          EIdent(\"__entry_slp_v\", -1)\n        ], -1), -1)\n      } else {\n        let settle = EIf(EBinOp(\"<\", req, EInt(0)), ECall(EIdent(\"sleep_blocking\", -1), [\n          EBinOp(\"-\", EInt(0), req)\n        ], -1), ECall(EIdent(\"assert\", -1), [\n          EBinOp(\"<\", req, EInt(1))\n        ], -1))\n        ESeq(settle, ECall(EIdent(\"resume\", -1), [\n          EInt(0)\n        ], -1))\n      }\n      let mut j = 0\n      while j < Array::length(stmts) {\n        match Array::get(stmts, j) {\n          SLet(exported, is_rec, name, ty, EFn(tps, tbs, params, ret, eff, body)) => if name == entry_name {\n            let wrapped = EHandle(body, [\n              (PCtor(\"Async::Suspend\", [\n                PBind(\"__entry_slp_req\")\n              ]), arm)\n            ])\n            Array::set(stmts, j, SLet(exported, is_rec, name, ty, EFn(tps, tbs, params, ret, eff, wrapped)))\n          } else {\n            ()\n          },\n          _ => ()\n        }\n        j = j + 1\n      }\n    } else {\n      ()\n    }\n    \"\"\n  }\n}\n\nexport fn compile_wasi_module_linked_impl(stmts: Array[Stmt], entry_name: String, srcs: Array[(String, String)], linked_imports: Array[(String, String, Int, Int)], library_mode: Bool, enable_rc: Bool, coverage: Bool, debug_trace: Bool, debug_break: Bool, rc_shadow: Bool, prov: DbgProv, body_cache_in: CodegenBodyCache, body_cache_out: CodegenBodyCache, slice_lo: Int, slice_hi: Int) -> Bytes with { Error } {\n  let za_msg = zero_alloc_check(stmts)\n  if za_msg != \"\" {\n    throw(za_msg)\n  } else {\n    ()\n  }\n  desugar_trait_dicts(stmts)\n  rewrite_top_level_fn_alias_refs(stmts)\n  let iw_names = lc_fresh_string_array()\n  let iw_wats = lc_fresh_string_array()\n  lc_extract_inline_wasm(stmts, iw_names, iw_wats)\n  await_poll_pass(stmts, lc_stmts_call_host_future(stmts), lc_waiter_hooks_available(stmts, linked_imports))\n  rewrite_self_tail_calls(stmts)\n  lc_wrap_entry_error_boundary(stmts, entry_name)\n  let async_sleep_boundary_err = lc_inject_async_sleep_boundary(stmts, entry_name)\n  if async_sleep_boundary_err != \"\" {\n    throw(async_sleep_boundary_err)\n  } else {\n    ()\n  }\n  let scps_errs = suspend_cps_pass(stmts)\n  if Array::length(scps_errs) > 0 {\n    throw(Array::get(scps_errs, 0))\n  } else {\n    ()\n  }\n  inline_direct_performs(stmts)\n  let edp_errs = evidence_dict_pass(stmts, entry_name)\n  if Array::length(edp_errs) > 0 {\n    throw(Array::get(edp_errs, 0))\n  } else {\n    ()\n  }\n  let lc_borrow_ret_names = sorted_names_of(compute_borrow_returning_names(stmts))\n  let lc_borrow_arg0_enabled = true\n  let lc_borrow_param_mask = lc_fresh_int_array()\n  let lc_borrow_param_user_srt = if lc_borrow_arg0_enabled {\n    compute_borrow_param_user_fns(stmts, [\n      entry_name,\n      \"main\",\n      \"_start\",\n      \"cli_main\"\n    ], lc_borrow_param_mask)\n  } else {\n    lc_fresh_string_array()\n  }\n  let lc_borrow_view_ret = if lc_borrow_arg0_enabled {\n    sorted_names_of(compute_may_return_view_fns(stmts))\n  } else {\n    lc_fresh_string_array()\n  }\n  let lc_scalar_ret_names = sorted_names_of(compute_scalar_returning_names(stmts))\n  let fn_names_list = lc_fresh_string_array()\n  let fn_param_counts = lc_fresh_int_array()\n  let fn_needs_env_list = lc_fresh_bool_array()\n  let fn_stmt_indices = lc_fresh_int_array()\n  let thunk_names_list = lc_fresh_string_array()\n  let const_int_names_list = lc_fresh_string_array()\n  let const_int_values_list = lc_fresh_int_array()\n  let export_fn_names = lc_fresh_string_array()\n  let export_fn_user_indices = lc_fresh_int_array()\n  let test_fn_names = lc_fresh_string_array()\n  let empty_tp = array_empty()\n  let empty_bounds = array_empty()\n  let empty_params = array_empty()\n  let mut pi = 0\n  while pi < Array::length(stmts) {\n    match Array::get(stmts, pi) {\n      STest(tname, tbody) => {\n        let test_fn = String::concat(\"__test_\", tname)\n        Array::push(test_fn_names, test_fn)\n        Array::set(stmts, pi, SLet(false, false, test_fn, None, EFn(empty_tp, empty_bounds, empty_params, None, None, ESeq(tbody, EInt(0)))))\n      },\n      SBench(bname, bbody) => {\n        let bench_fn = String::concat(\"__bench_\", bname)\n        Array::push(test_fn_names, bench_fn)\n        Array::set(stmts, pi, SLet(false, false, bench_fn, None, EFn(empty_tp, empty_bounds, empty_params, None, None, ESeq(bbody, EInt(0)))))\n      },\n      SLet(sl_exp, sl_rec, sl_name, sl_ann, sl_expr) => match sl_expr {\n        EFn(tparams, _, params, ret, eff, body) => if Array::length(tparams) > 0 {\n          Array::set(stmts, pi, SLet(sl_exp, sl_rec, sl_name, sl_ann, EFn(empty_tp, empty_bounds, params, ret, eff, body)))\n        }\n        ,\n        _ => ()\n      },\n      _ => ()\n    }\n    pi = pi + 1\n  }\n  if Array::length(test_fn_names) > 0 {\n    let mut has_entry = false\n    let mut ei = 0\n    while ei < Array::length(stmts) {\n      match Array::get(stmts, ei) {\n        SLet(is_exp, _, name, _, _) => if is_exp && name == entry_name {\n          has_entry = true\n        },\n        _ => ()\n      }\n      ei = ei + 1\n    }\n    if !has_entry {\n      ()\n    }\n  }\n  let mut i = 0\n  while i < Array::length(stmts) {\n    let stmt = Array::get(stmts, i)\n    if is_slet(stmt) {\n      let name = get_slet_name(stmt)\n      let expr = get_slet_expr(stmt)\n      let is_export = get_slet_export(stmt)\n      let user_idx = Array::length(fn_names_list)\n      let __sf_etag = expr_tag(expr)\n      if is_efn(expr) {\n        let params = get_efn_params(expr)\n        Array::push(fn_names_list, name)\n        Array::push(fn_param_counts, Array::length(params))\n        Array::push(fn_needs_env_list, true)\n        Array::push(fn_stmt_indices, i)\n      } else {\n        if (__sf_etag == 0) && !is_export {\n          Array::push(const_int_names_list, name)\n          Array::push(const_int_values_list, get_eint_value(expr))\n        } else {\n          let __sf_thunk_expr = expr\n          Array::push(fn_names_list, name)\n          Array::push(fn_param_counts, 0)\n          Array::push(fn_needs_env_list, true)\n          Array::push(fn_stmt_indices, i)\n          Array::push(thunk_names_list, name)\n        }\n      }\n      if is_export || library_mode {\n        Array::push(export_fn_names, name)\n        Array::push(export_fn_user_indices, user_idx)\n      }\n    }\n    i = i + 1\n  }\n  let ctor_names_list = lc_fresh_string_array()\n  Array::push(ctor_names_list, \"None\")\n  Array::push(ctor_names_list, \"Some\")\n  let ctor_tags_list = lc_fresh_int_array()\n  Array::push(ctor_tags_list, 0)\n  Array::push(ctor_tags_list, 1)\n  let ctor_field_counts_list = lc_fresh_int_array()\n  Array::push(ctor_field_counts_list, 0)\n  Array::push(ctor_field_counts_list, 1)\n  let ctor_type_names_list = lc_fresh_string_array()\n  Array::push(ctor_type_names_list, \"Option\")\n  Array::push(ctor_type_names_list, \"Option\")\n  let ctor_float_fields_list = lc_fresh_int_array()\n  let mut type_index = 1\n  let mut ei2 = 0\n  while ei2 < Array::length(stmts) {\n    match Array::get(stmts, ei2) {\n      SEnum(_, ename, _, variants, _) => {\n        type_index = type_index + 1\n        let mut vi = 0\n        while vi < Array::length(variants) {\n          let (vname, vfields) = Array::get(variants, vi)\n          Array::push(ctor_names_list, vname)\n          Array::push(ctor_tags_list, (type_index<<16)|vi)\n          Array::push(ctor_field_counts_list, Array::length(vfields))\n          Array::push(ctor_type_names_list, ename)\n          push_ctor_float_fields(ctor_float_fields_list, Array::length(ctor_names_list) - 1, vfields)\n          vi = vi + 1\n        }\n        0\n      },\n      SStruct(_, sname, sfields, _, _, _) => {\n        type_index = type_index + 1\n        Array::push(ctor_names_list, sname)\n        Array::push(ctor_tags_list, type_index<<16)\n        Array::push(ctor_field_counts_list, Array::length(sfields))\n        Array::push(ctor_type_names_list, sname)\n        push_ctor_float_fields(ctor_float_fields_list, Array::length(ctor_names_list) - 1, struct_field_types(sfields))\n        0\n      },\n      SSuberror(_, ename, variants) => {\n        type_index = type_index + 1\n        let mut vi = 0\n        while vi < Array::length(variants) {\n          let (vname, vfields) = Array::get(variants, vi)\n          Array::push(ctor_names_list, vname)\n          Array::push(ctor_tags_list, (type_index<<16)|vi)\n          Array::push(ctor_field_counts_list, Array::length(vfields))\n          Array::push(ctor_type_names_list, ename)\n          push_ctor_float_fields(ctor_float_fields_list, Array::length(ctor_names_list) - 1, vfields)\n          vi = vi + 1\n        }\n        0\n      },\n      _ => 0\n    }\n    ei2 = ei2 + 1\n  }\n  let struct_names = lc_fresh_string_array()\n  let struct_field_names = lc_fresh_string_matrix()\n  let mut si = 0\n  while si < Array::length(stmts) {\n    match Array::get(stmts, si) {\n      SStruct(_, sname, sfields, _, _, _) => {\n        Array::push(struct_names, sname)\n        let fnames = lc_fresh_string_array()\n        let mut sfi = 0\n        while sfi < Array::length(sfields) {\n          let (fname, _) = Array::get(sfields, sfi)\n          Array::push(fnames, fname)\n          sfi = sfi + 1\n        }\n        Array::push(struct_field_names, fnames)\n        ()\n      },\n      _ => ()\n    }\n    si = si + 1\n  }\n  let (lc_ctor_names_sorted, lc_ctor_names_sorted_pos) = ctor_sorted_index(ctor_names_list)\n  let lc_agg_ret_names = lc_fresh_string_array()\n  let lc_agg_ret_infos = lc_fresh_int_array()\n  compute_agg_returning(stmts, CtorTable::{\n    names: ctor_names_list, tags: ctor_tags_list, field_counts: ctor_field_counts_list, type_names: ctor_type_names_list, struct_names: struct_names, struct_field_names: struct_field_names, names_sorted: lc_ctor_names_sorted, names_sorted_pos: lc_ctor_names_sorted_pos\n  }, lc_agg_ret_names, lc_agg_ret_infos)\n  let lc_heap_ret_names = sorted_names_of(compute_heap_returning(stmts))\n  let num_user_funcs = Array::length(fn_names_list)\n  if num_user_funcs == 0 {\n    throw(\"no functions found to compile\")\n  }\n  let mut entry_user_idx = -1\n  let mut ei = 0\n  while ei < num_user_funcs {\n    if Array::get(fn_names_list, ei) == entry_name {\n      entry_user_idx = ei\n    }\n    ei = ei + 1\n  }\n  if entry_user_idx < 0 && !library_mode && entry_name != \"__no_entry__\" {\n    throw(\"entry `\\{entry_name}` not found: no exported function named `\\{entry_name}` (use __no_entry__ to build a test runner)\")\n  }\n  let str_strs = collect_strings_stmts(stmts)\n  let rec add_map_keys_expr: (Expr) -> Unit = (e) -> {\n    match e {\n      EMap(fields) => {\n        let mut mi = 0\n        while mi < Array::length(fields) {\n          let (key, val) = Array::get(fields, mi)\n          if !array_contains_str(str_strs, key) {\n            Array::push(str_strs, key)\n          }\n          add_map_keys_expr(val)\n          mi = mi + 1\n        }\n      },\n      EStringInterp(parts) => {\n        let mut pi3 = 0\n        while pi3 < Array::length(parts) {\n          if pi3 % 2 == 0 {\n            let part = Array::get(parts, pi3)\n            if String::length(part) > 0 && !array_contains_str(str_strs, part) {\n              Array::push(str_strs, part)\n            }\n          }\n          pi3 = pi3 + 1\n        }\n      },\n      ELet(_, val, body, _) => {\n        add_map_keys_expr(val); add_map_keys_expr(body)\n      },\n      ELetMut(_, val, body, _) => {\n        add_map_keys_expr(val); add_map_keys_expr(body)\n      },\n      ELetRec(_, val, body) => {\n        add_map_keys_expr(val); add_map_keys_expr(body)\n      },\n      ESeq(a, b) => {\n        add_map_keys_expr(a); add_map_keys_expr(b)\n      },\n      EIf(c, t, e) => {\n        add_map_keys_expr(c); add_map_keys_expr(t); add_map_keys_expr(e)\n      },\n      EFn(_, _, _, _, _, body) => add_map_keys_expr(body),\n      EHandle(body, _) => add_map_keys_expr(body),\n      ECall(callee, args, _) => {\n        add_map_keys_expr(callee)\n        let mut ai = 0\n        while ai < Array::length(args) {\n          add_map_keys_expr(Array::get(args, ai))\n          ai = ai + 1\n        }\n      },\n      _ => ()\n    }\n  }\n  let mut __mk = 0\n  while __mk < Array::length(stmts) {\n    match Array::get(stmts, __mk) {\n      SLet(_, _, _, _, expr) => add_map_keys_expr(expr),\n      STest(_, expr) => add_map_keys_expr(expr),\n      SBench(_, expr) => add_map_keys_expr(expr),\n      _ => ()\n    }\n    __mk = __mk + 1\n  }\n  if !array_contains_str(str_strs, \"\") {\n    Array::push(str_strs, \"\")\n  }\n  let src_str_base = Array::length(str_strs)\n  let num_src_pairs = Array::length(srcs)\n  let mut __src_i = 0\n  while __src_i < num_src_pairs {\n    let (__src_path, __src_content) = Array::get(srcs, __src_i)\n    Array::push(str_strs, __src_path)\n    Array::push(str_strs, __src_content)\n    __src_i = __src_i + 1\n  }\n  let num_strings = Array::length(str_strs)\n  let data_base = 64\n  let str_offsets = lc_fresh_int_array()\n  let str_lengths = lc_fresh_int_array()\n  let mut str_pos = data_base\n  let mut si = 0\n  while si < num_strings {\n    let s = Array::get(str_strs, si)\n    let slen = String::length(s)\n    Array::push(str_offsets, str_pos)\n    Array::push(str_lengths, slen)\n    str_pos = str_pos + slen\n    si = si + 1\n  }\n  let heap_start = ((str_pos + 7) / 8) * 8\n  let effect_names_list = lc_fresh_string_array()\n  let effect_op_keys_list = lc_fresh_string_array()\n  let effect_op_arities_list = array_empty()\n  let mut eff_collect_i = 0\n  while eff_collect_i < Array::length(stmts) {\n    match Array::get(stmts, eff_collect_i) {\n      SEffectDef(_, eff_name, _, ops) => {\n        if !is_exception_effect_name(eff_name) && !array_contains_str(effect_names_list, eff_name) {\n          Array::push(effect_names_list, eff_name)\n        } else {\n          ()\n        }\n        let mut op_i = 0\n        while op_i < Array::length(ops) {\n          let (op_name, op_params, _) = Array::get(ops, op_i)\n          Array::push(effect_op_keys_list, String::concat(String::concat(eff_name, \"::\"), op_name))\n          Array::push(effect_op_arities_list, Array::length(op_params))\n          op_i = op_i + 1\n        }\n      },\n      _ => ()\n    }\n    eff_collect_i = eff_collect_i + 1\n  }\n  let eff_reserve = 0\n  let cov_count = num_user_funcs\n  let cov_base = heap_start + eff_reserve\n  let cov_reserve = if coverage {\n    ((cov_count + 7) / 8) * 8\n  } else {\n    0\n  }\n  let cov_branch_cap = 65536\n  let cov_branch_base = cov_base + cov_reserve\n  let cov_branch_reserve = if coverage {\n    cov_branch_cap\n  } else {\n    0\n  }\n  let trace_cap = 4096\n  let trace_counter_addr = cov_branch_base + cov_branch_reserve\n  let trace_log_base = trace_counter_addr + 4\n  let trace_reserve = if debug_trace {\n    4 + trace_cap * 4\n  } else {\n    0\n  }\n  let dbgargs_cap = 16\n  let dbgargs_count_addr = trace_counter_addr + trace_reserve\n  let dbgargs_base = dbgargs_count_addr + 8\n  let dbgargs_reserve = if debug_break {\n    8 + dbgargs_cap * 8\n  } else {\n    0\n  }\n  let rc_bins_base = heap_start + eff_reserve + cov_reserve + cov_branch_reserve + trace_reserve + dbgargs_reserve\n  let rc_bins_reserve = if enable_rc {\n    256\n  } else {\n    0\n  }\n  let cov_state = CovState::{\n    enabled: coverage,\n    base: cov_branch_base,\n    cap: cov_branch_cap,\n    next: [\n      0\n    ],\n    cur_fn: [\n      0\n    ],\n    owners: ArrayBuilder::freeze(ArrayBuilder::new())\n  }\n  let used_builtin_names = collect_used_builtin_names(stmts, fn_names_list)\n  let need_env_get_builtin = Map::has_key(used_builtin_names, \"Env::get\")\n  let need_env_args_len_builtin = Map::has_key(used_builtin_names, \"Env::args_len\")\n  let need_env_args_get_builtin = Map::has_key(used_builtin_names, \"Env::args_get\")\n  let need_fs_read_file_builtin = Map::has_key(used_builtin_names, \"Fs::read_file\")\n  let need_fs_exists_builtin = Map::has_key(used_builtin_names, \"Fs::exists\")\n  let need_fs_stat_token_builtin = Map::has_key(used_builtin_names, \"Fs::stat_token\") || Map::has_key(used_builtin_names, \"vibe_fs_stat_token_raw\")\n  let need_fs_write_file_builtin = Map::has_key(used_builtin_names, \"Fs::write_file\")\n  let need_fs_write_bytes_builtin = Map::has_key(used_builtin_names, \"Fs::write_bytes\")\n  let need_fs_read_bytes_builtin = Map::has_key(used_builtin_names, \"Fs::read_bytes\")\n  let need_fs_readdir_builtin = Map::has_key(used_builtin_names, \"Fs::readdir\")\n  let need_profiler_now_us_builtin = Map::has_key(used_builtin_names, \"Profiler::now_us\")\n  let need_profiler_heap_bytes_builtin = Map::has_key(used_builtin_names, \"Profiler::heap_bytes\")\n  let need_sleep_builtin = Map::has_key(used_builtin_names, \"sleep\") || Map::has_key(used_builtin_names, \"sleep_blocking\")\n  let need_stdin_read_char_builtin = Map::has_key(used_builtin_names, \"Stdin::read_char\")\n  let hf_named_names = lc_collect_host_future_names(stmts)\n  let need_host_future_builtin = Map::has_key(used_builtin_names, \"host_future_get\") || Map::has_key(used_builtin_names, \"vibe_hf_get_raw\")\n  let need_host_future_wait_builtin = need_host_future_builtin || Map::has_key(used_builtin_names, \"vibe_hf_wait_raw\") || Array::length(hf_named_names) > 0\n  let hs_named_names = lc_collect_host_stream_names(stmts)\n  let need_host_stream_read_builtin = Map::has_key(used_builtin_names, \"vibe_hs_read_raw\") || Array::length(hs_named_names) > 0\n  let need_host_stream_close_builtin = Map::has_key(used_builtin_names, \"vibe_hs_close_raw\")\n  let need_sh_builtin = Map::has_key(used_builtin_names, \"sh\")\n  let need_sh_lines_builtin = Map::has_key(used_builtin_names, \"sh_lines\")\n  let need_sh_capture_builtin = Map::has_key(used_builtin_names, \"vibe_sh_capture_raw\")\n  let need_sh_capture_exit_code_builtin = Map::has_key(used_builtin_names, \"vibe_sh_capture_exit_code_raw\")\n  let need_sh_capture_stdout_builtin = Map::has_key(used_builtin_names, \"vibe_sh_capture_stdout_raw\")\n  let need_sh_capture_stderr_builtin = Map::has_key(used_builtin_names, \"vibe_sh_capture_stderr_raw\")\n  let need_sh_capture_close_builtin = Map::has_key(used_builtin_names, \"vibe_sh_capture_close_raw\")\n  let need_process_exit_builtin = Map::has_key(used_builtin_names, \"vibe_process_exit_raw\")\n  let need_stdin_read_stream_builtin = Map::has_key(used_builtin_names, \"Stdin::read_stream\")\n  let used_print_builtin = Map::has_key(used_builtin_names, \"println\") || Map::has_key(used_builtin_names, \"print\")\n  let need_stdout_write_stream_builtin = Map::has_key(used_builtin_names, \"Stdout::write_stream\") || used_print_builtin\n  let need_stdout_write_char_builtin = Map::has_key(used_builtin_names, \"Stdout::write_char\") || used_print_builtin\n  let need_stderr_write_stream_builtin = Map::has_key(used_builtin_names, \"Stderr::write_stream\")\n  let need_stderr_write_char_builtin = Map::has_key(used_builtin_names, \"Stderr::write_char\")\n  let need_resolve_path_builtin = Map::has_key(used_builtin_names, \"Path::ref\") || Map::has_key(used_builtin_names, \"Path::resolve\")\n  let need_fs_remove_builtin = Map::has_key(used_builtin_names, \"Fs::remove\")\n  let need_fs_mkdir_p_builtin = Map::has_key(used_builtin_names, \"Fs::mkdir_p\")\n  let need_fs_mkdir_builtin = Map::has_key(used_builtin_names, \"Fs::mkdir\")\n  let need_fs_chdir_builtin = Map::has_key(used_builtin_names, \"Fs::chdir\")\n  let need_fs_copy_builtin = Map::has_key(used_builtin_names, \"Fs::copy\")\n  let need_fs_append_builtin = Map::has_key(used_builtin_names, \"Fs::append\")\n  let need_fs_rename_builtin = Map::has_key(used_builtin_names, \"Fs::rename\")\n  let need_fs_is_dir_builtin = Map::has_key(used_builtin_names, \"Fs::is_dir\")\n  let need_fs_is_file_builtin = Map::has_key(used_builtin_names, \"Fs::is_file\")\n  let need_fs_getcwd_builtin = Map::has_key(used_builtin_names, \"Fs::getcwd\")\n  let need_tcp_connect_builtin = Map::has_key(used_builtin_names, \"vibe_tcp_connect_raw\")\n  let need_tcp_read_builtin = Map::has_key(used_builtin_names, \"vibe_tcp_read_raw\")\n  let need_tcp_write_builtin = Map::has_key(used_builtin_names, \"vibe_tcp_write_raw\")\n  let need_tcp_close_builtin = Map::has_key(used_builtin_names, \"vibe_tcp_close_raw\")\n  let need_http_request_builtin = Map::has_key(used_builtin_names, \"vibe_http_request_raw\")\n  let need_http_response_status_builtin = Map::has_key(used_builtin_names, \"vibe_http_response_status_raw\")\n  let need_http_response_header_builtin = Map::has_key(used_builtin_names, \"vibe_http_response_header_raw\")\n  let need_http_response_body_builtin = Map::has_key(used_builtin_names, \"vibe_http_response_body_raw\")\n  let need_http_close_builtin = Map::has_key(used_builtin_names, \"vibe_http_close_raw\")\n  let mut next_import_idx = 1\n  let env_get_import_idx = if need_env_get_builtin {\n    let idx = next_import_idx\n    next_import_idx = next_import_idx + 1\n    idx\n  } else {\n    -1\n  }\n  let env_args_len_import_idx = if need_env_args_len_builtin {\n    let idx = next_import_idx\n    next_import_idx = next_import_idx + 1\n    idx\n  } else {\n    -1\n  }\n  let env_args_get_import_idx = if need_env_args_get_builtin {\n    let idx = next_import_idx\n    next_import_idx = next_import_idx + 1\n    idx\n  } else {\n    -1\n  }\n  let fs_read_file_import_idx = if need_fs