}

let source_242 = () -> (String, String) {
  ("lib/@vibe/compiler/entry/source_compile/wasi_only/preprocess_interp_string_fold_nonempty.vibe",
"\nimport @vibe/compiler/core {\n  Expr\n}\n\n\n\nexport fn fold_interp_exprs_nonempty(result_arr: Array[Expr], result_len: Int) -> Expr {\n  let first = Array::get(result_arr, 0)\n  fold_interp_exprs_loop(result_arr, result_len, first, 1)\n}\n")
}

let source_243 = () -> (String, String) {
  ("lib/@vibe/compiler/entry/source_compile/wasi_only/preprocess_interp_string_fold_loop.vibe",
"\nimport @vibe/compiler/core {\n  Expr\n}\n\n\nfn concat_exprs(lhs: Expr, rhs: Expr) -> Expr {\n  let b = ArrayBuilder::new()\n  ArrayBuilder::push(b, lhs)\n  ArrayBuilder::push(b, rhs)\n  let args = ArrayBuilder::freeze(b)\n  ECall(EIdent(\"String::concat\", -1), args, -1)\n}\n\nexport fn fold_interp_exprs_loop(result_arr: Array[Expr], result_len: Int, result0: Expr, j0: Int) -> Expr {\n  let mut result = result0\n  let mut j = j0\n  while j < result_len {\n    let rhs = Array::get(result_arr, j)\n    result = concat_exprs(result, rhs)\n    j = j + 1\n  }\n  result\n}\n")
}

