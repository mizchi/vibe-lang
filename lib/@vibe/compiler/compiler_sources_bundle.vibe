"\n\n\n\n\n\n\n\n\n\nfn efn_param_count(expr: Expr) -> Int {\n  match expr {\n    EFn(_, _, params, _, _, _) => Array::length(params),\n    _ => -1\n  }\n}\n\nfn read_program(path: String) -> Array[Stmt] with { Error, Fs } {\n  let source = Fs::read_file(path)\n  parse_program(lex(source))\n}\n\nfn append_stmt_array(dst: Array[Stmt], src: Array[Stmt]) -> Unit {\n  let mut i = 0\n  while i < Array::length(src) {\n    Array::push(dst, Array::get(src, i))\n    i = i + 1\n  }\n}\n\nfn collect_direct_dep_paths(entry_stmts: Array[Stmt], entry_dir: String) -> (Array[String], Array[Array[String]]) {\n  let dep_paths = Array::slice([\n    \"\"\n  ], 0, 0)\n  let dep_wanted_names = Array::slice([\n    Array::slice([\n      \"\"\n    ], 0, 0)\n  ], 0, 0)\n  let dep_path_names_for: (String) -> Array[String] = (resolved) -> {\n    let mut fi = 0\n    let mut idx = -1\n    while fi < Array::length(dep_paths) {\n      if Array::get(dep_paths, fi) == resolved {\n        idx = fi\n        fi = Array::length(dep_paths)\n      } else {\n        fi = fi + 1\n      }\n    }\n    if idx < 0 {\n      let fresh = Array::slice([\n        \"\"\n      ], 0, 0)\n      Array::push(dep_paths, resolved)\n      Array::push(dep_wanted_names, fresh)\n      fresh\n    } else {\n      Array::get(dep_wanted_names, idx)\n    }\n  }\n  let mut ei = 0\n  while ei < Array::length(entry_stmts) {\n    match Array::get(entry_stmts, ei) {\n      SImport(raw_path, items) => if Array::length(items) > 0 {\n        let resolved = resolve_import_path(entry_dir, raw_path)\n        let names = dep_path_names_for(resolved)\n        let mut ii = 0\n        while ii < Array::length(items) {\n          let (iname, _) = Array::get(items, ii)\n          Array::push(names, iname)\n          ii = ii + 1\n        }\n      }\n      ,\n      SReExport(raw_path, items) => {\n        let resolved = resolve_import_path(entry_dir, raw_path)\n        let names = dep_path_names_for(resolved)\n        let mut ii = 0\n        while ii < Array::length(items) {\n          let (iname, _) = Array::get(items, ii)\n          Array::push(names, iname)\n          ii = ii + 1\n        }\n      },\n      _ => ()\n    }\n    ei = ei + 1\n  }\n  (dep_paths, dep_wanted_names)\n}\n\nfn collect_linked_dep_artifacts(dep_paths: Array[String], wanted_names: Array[Array[String]]) -> (Array[Stmt], Array[(String, String, Int, Int)], Array[(String, String)]) with { Error, Fs } {\n  let linked_imports = Array::slice([\n    (\"\", \"\", 0, 0)\n  ], 0, 0)\n  let linked_dep_specs = Array::slice([\n    (\"\", \"\")\n  ], 0, 0)\n  let resolved_type_stmts = Array::slice([\n    SExpr(EInt(0))\n  ], 0, 0)\n  let mut di = 0\n  while di < Array::length(dep_paths) {\n    let dep_path = Array::get(dep_paths, di)\n    let dep_stmts = read_program(dep_path)\n    let module_name = path_to_module_name(dep_path)\n    let dep_dir = dir_of_path(dep_path)\n    let wanted = Array::get(wanted_names, di)\n    let mut has_linked = false\n    let mut dsi = 0\n    while dsi < Array::length(dep_stmts) {\n      match Array::get(dep_stmts, dsi) {\n        SLet(true, _, name, _, expr) => {\n          let param_count = efn_param_count(expr)\n          if param_count >= 0 && contains_name(wanted, name) {\n            Array::push(linked_imports, (module_name, name, param_count, 1))\n            has_linked = true\n          }\n        },\n        SReExport(raw_path, items) => {\n          let filtered = Array::slice([\n            (\"\", None)\n          ], 0, 0)\n          let mut fi2 = 0\n          while fi2 < Array::length(items) {\n            let (iname, irename) = Array::get(items, fi2)\n            let public_name = match irename {\n              Some(alias) => alias,\n              None => iname\n            }\n            if contains_name(wanted, public_name) {\n              Array::push(filtered, (iname, irename))\n            }\n            fi2 = fi2 + 1\n          }\n          if Array::length(filtered) > 0 {\n            let resolved = resolve_import_path(dep_dir, raw_path)\n            resolve_reexport_chain(resolved, filtered, module_name, linked_imports, resolved_type_stmts, 0)\n            has_linked = true\n          }\n        },\n        SEnum(true, _, _, _, _) => Array::push(resolved_type_stmts, Array::get(dep_stmts, dsi))\n        ,\n        _ => ()\n      }\n      dsi = dsi + 1\n    }\n    if has_linked {\n      Array::push(linked_dep_specs, (module_name, dep_path))\n    }\n    di = di + 1\n  }\n  (resolved_type_stmts, linked_imports, linked_dep_specs)\n}\n\nexport fn collect_linked_compile_inputs(entry_path: String) -> (Array[Stmt], Array[Stmt], Array[(String, String, Int, Int)], Array[(String, String)]) with { Error, Fs } {\n  let entry_stmts = read_program(entry_path)\n  let (dep_paths, dep_wanted_names) = collect_direct_dep_paths(entry_stmts, dir_of_path(entry_path))\n  let (resolved_type_stmts, linked_imports, linked_dep_specs) = collect_linked_dep_artifacts(dep_paths, dep_wanted_names)\n  (entry_stmts, resolved_type_stmts, linked_imports, linked_dep_specs)\n}\n\nexport fn compile_file_wasi_linked_artifacts(entry_path: String, entry_name: String) -> (Bytes, Array[(String, String, Int, Int)], Array[(String, String)]) with { Error, Fs } {\n  let (entry_stmts, resolved_type_stmts, linked_imports, linked_dep_specs) = collect_linked_compile_inputs(entry_path)\n  let stmts = empty_stmt_array()\n  append_stmt_array(stmts, resolved_type_stmts)\n  append_stmt_array(stmts, entry_stmts)\n  expand_interp_stmts(stmts)\n  let _ = check_program(stmts)\n  strip_generic_type_params(stmts)\n  let wasm = compile_wasi_module_linked_impl(stmts, entry_name, Array::slice([\n    (\"\", \"\")\n  ], 0, 0), linked_imports, false, false, false, false, false, false, empty_dbg_prov())\n  (wasm, linked_imports, linked_dep_specs)\n}\n\nexport fn compile_file_wasi_linked(entry_path: String, entry_name: String) -> (Bytes, Array[(String, String, Int, Int)]) with { Error, Fs } {\n  let (wasm, linked_imports, _) = compile_file_wasi_linked_artifacts(entry_path, entry_name)\n  (wasm, linked_imports)\n}\n")
}

