pr, local_names: Array[String], next_local: Int, ctx: CompileCtx, ld: Int, compile_expr: (Bytes, Expr, Array[String], Int, CompileCtx, Int) -> Int with { Error }) -> Int with { Error } {\\n  match expr {\\n    EDot(obj, field, _, _) => {\\n      let fc = String::char_code_at(field, 0)\\n      if fc >= 48 && fc <= 57 {\\n        // `t.N` tuple projection: purely positional.\\n        let mut vi = 0\\n        let mut vp = 0\\n        while vp < String::length(field) {\\n          vi = vi * 10 + (String::char_code_at(field, vp) - 48)\\n          vp = vp + 1\\n        }\\n        let nl1 = compile_expr(buf, obj, local_names, next_local, ctx, ld)\\n        // RC mode: the tuple value is an odd pointer (Stage 2); untag before use.\\n        if ctx.enable_rc {\\n          emit_i64_const(buf, -2)\\n          emit_i64_and(buf)\\n        }\\n        emit_i32_wrap_i64(buf)\\n        // RC mode: tuples carry an 8-byte header, so the payload starts at +8.\\n        let toff = if ctx.enable_rc {\\n          8 + vi * 8\\n        } else {\\n          vi * 8\\n        }\\n        emit_i64_load(buf, 3, toff)\\n        nl1\\n      } else {\\n        // #722: name-based struct field access. The slot index depends on\\n        // WHICH struct the value is — a same-named field can live at a\\n        // different slot in another struct. When every declaring struct\\n        // agrees on the slot, load it statically (the common case). When\\n        // they disagree, dispatch at runtime on the value's ctor tag\\n        // (value+0), falling back to the first-declared struct's slot for\\n        // legacy untagged records.\\n        let cands = struct_field_candidates(ctx.ctor_table, field)\\n        if Array::length(cands) == 0 {\\n          throw(String::concat(\\\"unknown struct field: \\\", field))\\n        }\\n        let (_, idx0) = Array::get(cands, 0)\\n        let dispatch = struct_field_dispatch_cases(cands)\\n        let nl1 = compile_expr(buf, obj, local_names, next_local, ctx, ld)\\n        emit_i64_const(buf, -2)\\n        emit_i64_and(buf)\\n        if Array::length(dispatch) == 0 {\\n          emit_i32_wrap_i64(buf)\\n          emit_i64_load(buf, 3, 8 + idx0 * 8)\\n          nl1\\n        } else {\\n          let obj_l = nl1\\n          Array::push(local_names, \\\"__dot_obj\\\")\\n          emit_local_set(buf, obj_l)\\n          let mut di = 0\\n          while di < Array::length(dispatch) {\\n            let (dtag, didx) = Array::get(dispatch, di)\\n            emit_local_get(buf, obj_l)\\n            emit_i32_wrap_i64(buf)\\n            emit_i32_load(buf, 2, 0)\\n            emit_i32_const(buf, dtag)\\n            emit_i32_eq(buf)\\n            emit_if_i64(buf)\\n            emit_local_get(buf, obj_l)\\n            emit_i32_wrap_i64(buf)\\n            emit_i64_load(buf, 3, 8 + didx * 8)\\n            emit_else(buf)\\n            di = di + 1\\n          }\\n          emit_local_get(buf, obj_l)\\n          emit_i32_wrap_i64(buf)\\n          emit_i64_load(buf, 3, 8 + idx0 * 8)\\n          let mut de = 0\\n          while de < Array::length(dispatch) {\\n            emit_end(buf)\\n            de = de + 1\\n          }\\n          nl1 + 1\\n        }\\n      }\\n    },\\n    ERecord(_, fields, _) => {\\n      let flen = Array::length(fields)\\n      // #722: resolve the record to a struct by exact field-name set and, on a\\n      // match, lay it out in the struct's DECLARED field order with the\\n      // struct's ctor tag stamped at value+0 — byte-compatible with the\\n      // `S::{...}` ctor construction path (which already reorders). This is\\n      // what makes the tag-dispatching field access above type-correct for\\n      // bare-record construction (hand-built ASTs, name-dropped literals).\\n      // Unmatched (anonymous) records keep the legacy literal order + tag 0.\\n      let lit_names = Array::slice([\\n        \\\"\\\"\\n      ], 0, 0)\\n      let mut lni = 0\\n      while lni < flen {\\n        let (lfn, _) = Array::get(fields, lni)\\n        Array::push(lit_names, lfn)\\n        lni = lni + 1\\n      }\\n      let rec_si = struct_index_by_field_set(ctx.ctor_table, lit_names)\\n      let rec_tag = if rec_si >= 0 {\\n        struct_tag_by_index(ctx.ctor_table, rec_si)\\n      } else {\\n        0\\n      }\\n      let rec_fields = if rec_si >= 0 {\\n        let def_fnames = Array::get(ctx.ctor_table.struct_field_names, rec_si)\\n        let ordered = Array::slice([\\n          (\\\"\\\", EUnit)\\n        ], 0, 0)\\n        let mut oi = 0\\n        while oi < Array::length(def_fnames) {\\n          let target_name = Array::get(def_fnames, oi)\\n          let mut ri2 = 0\\n          while ri2 < flen {\\n            let (rfn, rfv) = Array::get(fields, ri2)\\n            if rfn == target_name {\\n              Array::push(ordered, (rfn, rfv))\\n              ri2 = flen\\n            } else {\\n              ri2 = ri2 + 1\\n            }\\n          }\\n          oi = oi + 1\\n        }\\n        ordered\\n      } else {\\n        fields\\n      }\\n      let ptr_local = next_local\\n      Array::push(local_names, \\\"__rec_ptr\\\")\\n      if ctx.enable_rc {\\n        // RC layout (mirrors the tuple in compile_expr_tail2.vibe):\\n        //   block_start: [alloc_size@0][rc_count@4][type_id@8][length@12][payload@16...]\\n        // The record value is (block_start+8) | 1 (records stay tagged), so the\\n        // live header is [alloc_size@ptr-8][rc_count@ptr-4][type_id@ptr+0]\\n        // [length@ptr+4] and field access stays at +8 (untag cancels the +8\\n        // pointer shift). type_id 0 preserves the existing record read semantics.\\n        let total = 16 + flen * 8\\n        // ADR-0055 Stage 4: allocate via the free-list search helper (vibe_rc_alloc).\\n        emit_i64_const(buf, total)\\n        emit_call(buf, ctx.rc_alloc_func_idx)\\n        emit_local_set(buf, ptr_local)\\n        emit_local_get(buf, ptr_local)\\n        emit_i32_wrap_i64(buf)\\n        emit_i32_const(buf, total)\\n        emit_i32_store(buf, 2, 0)\\n        emit_local_get(buf, ptr_local)\\n        emit_i32_wrap_i64(buf)\\n        emit_i32_const(buf, 1)\\n        emit_i32_store(buf, 2, 4)\\n        // ADR-0055 Stage 2c/3: drop-class byte (block+7) = 1 (field-vector); a\\n        // record is [type_id@value+0][len@value+4][fields@value+8+i*8], the same\\n        // shape the recursive rc_drop loops.\\n        emit_local_get(buf, ptr_local)\\n        emit_i32_wrap_i64(buf)\\n        emit_i32_const(buf, 1)\\n        emit_i32_store8(buf, 0, 7)\\n        emit_local_get(buf, ptr_local)\\n        emit_i32_wrap_i64(buf)\\n        emit_i32_const(buf, rec_tag)\\n        emit_i32_store(buf, 2, 8)\\n        emit_local_get(buf, ptr_local)\\n        emit_i32_wrap_i64(buf)\\n        emit_i32_const(buf, flen)\\n        emit_i32_store(buf, 2, 12)\\n        let mut nl_r = next_local + 1\\n        let mut ri = 0\\n        while ri < flen {\\n          let (_, fexpr) = Array::get(rec_fields, ri)\\n          nl_r = compile_expr(buf, fexpr, local_names, nl_r, ctx, ld)\\n          let val_local = nl_r\\n          Array::push(local_names, \\\"__rec_val\\\")\\n          emit_local_set(buf, val_local)\\n          nl_r = nl_r + 1\\n          // #708 follow-up (Codex review): a record field sourced from a\\n          // borrow-returning call (Array::get/Map::get/__rec_field/a user\\n          // wrapper) is exactly as much a borrow as a bare projection `a.f`\\n          // (see the comment above) -- without this retain, dropping the\\n          // source container after storing its element into an owning\\n          // record double-frees the element once the record is later\\n          // dropped too.\\n          // #715: also retain a bare-ident field whose binding is borrow-bound\\n          // or loop-borrowed (cc_is_loop_borrowed_ident) -- same gap as the\\n          // ETuple case in compile_expr_tail2.vibe (see the comment there).\\n          if ctx.enable_rc && (expr_is_projection(fexpr) || cc_is_borrow_ret_call(fexpr, ctx) || cc_is_loop_borrowed_ident(fexpr, ctx)) {\\n            emit_rc_dup_guarded(buf, val_local, ctx.rc_shadow)\\n          } else {\\n            ()\\n          }\\n          emit_local_get(buf, ptr_local)\\n          emit_i32_wrap_i64(buf)\\n          emit_local_get(buf, val_local)\\n          emit_i64_store(buf, 3, 16 + ri * 8)\\n          ri = ri + 1\\n        }\\n        // record value = (block_start + 8) | 1\\n        emit_local_get(buf, ptr_local)\\n        emit_i64_const(buf, 8)\\n        emit_i64_add(buf)\\n        emit_i64_const(buf, 1)\\n        emit_i64_or(buf)\\n        nl_r\\n      } else {\\n        let obj_size = 8 + flen * 8\\n        emit_global_get(buf, 0)\\n        emit_i64_extend_i32_u(buf)\\n        emit_local_set(buf, ptr_local)\\n        emit_global_get(buf, 0)\\n        emit_i32_const(buf, obj_size)\\n        emit_i32_add(buf)\\n        emit_global_set(buf, 0)\\n        emit_heap_grow_after_heap_set(buf, ctx)\\n        emit_local_get(buf, ptr_local)\\n        emit_i32_wrap_i64(buf)\\n        emit_i32_const(buf, rec_tag)\\n        emit_i32_store(buf, 2, 0)\\n        emit_local_get(buf, ptr_local)\\n        emit_i32_wrap_i64(buf)\\n        emit_i32_const(buf, flen)\\n        emit_i32_store(buf, 2, 4)\\n        let mut nl_r = next_local + 1\\n        let mut ri = 0\\n        while ri < flen {\\n          let (_, fexpr) = Array::get(rec_fields, ri)\\n          nl_r = compile_expr(buf, fexpr, local_names, nl_r, ctx, ld)\\n          let val_local = nl_r\\n          Array::push(local_names, \\\"__rec_val\\\")\\n          emit_local_set(buf, val_local)\\n          nl_r = nl_r + 1\\n          emit_local_get(buf, ptr_local)\\n          emit_i32_wrap_i64(buf)\\n          emit_local_get(buf, val_local)\\n          emit_i64_store(buf, 3, 8 + ri * 8)\\n          ri = ri + 1\\n        }\\n        emit_local_get(buf, ptr_local)\\n        emit_i64_const(buf, 1)\\n        emit_i64_or(buf)\\n        nl_r\\n      }\\n    },\\n    EMap(fields) => {\\n      let flen = Array::length(fields)\\n      let obj_size = 8 + flen * 2 * 8\\n      let ptr_local = next_local\\n      Array::push(local_names, \\\"__map_ptr\\\")\\n      emit_global_get(buf, 0)\\n      emit_i64_extend_i32_u(buf)\\n      emit_local_set(buf, ptr_local)\\n      emit_global_get(buf, 0)\\n      emit_i32_const(buf, obj_size)\\n      emit_i32_add(buf)\\n      emit_global_set(buf, 0)\\n      emit_heap_grow_after_heap_set(buf, ctx)\\n      emit_local_get(buf, ptr_local)\\n      emit_i32_wrap_i64(buf)\\n      emit_i32_const(buf, flen)\\n      emit_i32_store(buf, 2, 0)\\n      let mut nl_m = next_local + 1\\n      let mut mi = 0\\n      while mi < flen {\\n        let (key, val_expr) = Array::get(fields, mi)\\n        emit_local_get(buf, ptr_local)\\n        emit_i32_wrap_i64(buf)\\n        let key_idx = str_table_lookup(ctx.str_table.strs, key)\\n        if key_idx >= 0 {\\n          emit_str_ref(buf, Array::get(ctx.str_table.offsets, key_idx), Array::get(ctx.str_table.lengths, key_idx))\\n        } else {\\n          emit_i64_const(buf, 0)\\n        }\\n        emit_i64_store(buf, 3, 8 + mi * 16)\\n        emit_local_get(buf, ptr_local)\\n        emit_i32_wrap_i64(buf)\\n        nl_m = compile_expr(buf, val_expr, local_names, nl_m, ctx, ld)\\n        let val_local = nl_m\\n        Array::push(local_names, \\\"__map_val\\\")\\n        emit_local_set(buf, val_local)\\n        nl_m = nl_m + 1\\n        emit_local_get(buf, val_local)\\n        emit_i64_store(buf, 3, 8 + mi * 16 + 8)\\n        mi = mi + 1\\n      }\\n      emit_local_get(buf, ptr_local)\\n      nl_m\\n    },\\n    _ => compile_expr_tail5(buf, expr, local_names, next_local, ctx, ld, compile_expr)\\n  }\\n}\\n\")\n}\n\nlet cli_adapter_source_81 = () -> (String, String) {\n  (\"lib/@vibe/compiler/codegen/expr/compile_expr_tail3.vibe\",\n\"//# Imports\\n\\nimport ../../core {\\n  Expr, Pat, Stmt, TypeExpr, bytebuf_length, bytebuf_new, bytebuf_push, bytebuf_push_section