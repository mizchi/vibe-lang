"\nimport @vibe/compiler/core {\n  Expr,\n  Pat,\n  Stmt,\n  TypeExpr,\n  bytebuf_length,\n  bytebuf_new,\n  bytebuf_push,\n  bytebuf_push_section,\n  bytebuf_push_vec_header,\n  bytebuf_to_bytes,\n  leb128_encode_s64,\n  leb128_encode_u32\n}\n\nimport @vibe/core {\n  array_empty\n}\n\nimport @vibe/compiler/perceus {\n  build_perceus_plan_with_params, pa_is_alias_dup, pa_is_drop, pa_is_dup, param_is_heap_in_body\n}\n\nimport @vibe/compiler/codegen/common_analysis {\n  collect_free_vars,\n  collect_free_vars_indexed,\n  collect_free_vars_indexed_self,\n  collect_strings_stmts,\n  emit_closure_call_tail,\n  emit_closure_resolve,\n  emit_i64_extend_i32_u,\n  is_mut_captured_in,\n  md_consume_count_pre,\n  md_shadow_zeroed_bmasks,\n  scope_tail_proj_root\n}\n\nimport @vibe/compiler/codegen/common_base {\n  CompileCtx,\n  CtorTable,\n  FuncTable,\n  LambdaTable,\n  StrTable,\n  emit_binop_op,\n  emit_heap_grow_after_heap_set,\n  emit_i32_eq,\n  emit_i32_eqz,\n  emit_i32_ge_u,\n  emit_i32_mul,\n  emit_i32_ne,\n  emit_i32_sub,\n  emit_i64_load,\n  emit_i64_store,\n  emit_rc_dup_guarded,\n  emit_rc_word_inc_saturating,\n  emit_str_ref,\n  expr_tag,\n  get_arm_body,\n  get_arm_pat,\n  get_ebinop_op,\n  get_efn_body,\n  get_eif_cond,\n  get_eif_else,\n  get_eif_then,\n  get_elet_body,\n  get_elet_name,\n  get_elet_val,\n  get_slet_expr,\n  get_slet_name,\n  is_efn,\n  is_eident,\n  is_etuple,\n  is_pbind,\n  is_pbool,\n  is_pctor,\n  is_pint,\n  is_pstring,\n  is_ptuple,\n  is_pwild,\n  is_slet,\n  linemap_disabled,\n  lookup_ctor,\n  resolve_func,\n  resolve_local\n}\n\nimport @vibe/compiler/codegen/common_extractors {\n  array_contains_str,\n  emit_assignop_op,\n  emit_memory_copy,\n  find_catchall_idx,\n  get_earray_elems,\n  get_eassign_body,\n  get_eassign_name,\n  get_eassign_val,\n  get_eassignop_body,\n  get_eassignop_name,\n  get_eassignop_op,\n  get_eassignop_val,\n  get_ebinop_lhs,\n  get_ebinop_rhs,\n  get_ebool_value,\n  get_ecall_args,\n  get_ecall_callee,\n  get_efloat_value,\n  get_efn_params,\n  get_eforin_body,\n  get_eforin_iter,\n  get_eforin_name,\n  get_eident_name,\n  get_eint_value,\n  get_eletmut_body,\n  get_eletmut_name,\n  get_eletmut_val,\n  get_eletrec_body,\n  get_eletrec_name,\n  get_eletrec_val,\n  get_eseq_first,\n  get_eseq_second,\n  get_estring_value,\n  get_etuple_elems,\n  get_eunaryop_expr,\n  get_eunaryop_op,\n  get_ewhile_body,\n  get_ewhile_cond,\n  get_match_arms,\n  get_match_scrutinee,\n  get_pbind_name,\n  get_pbool_value,\n  get_pctor_args,\n  get_pctor_name,\n  get_pint_value,\n  get_pstring_value,\n  get_ptuple_pats,\n  get_slet_export,\n  str_table_lookup\n}\n\nimport @vibe/compiler/codegen/wasm_emit {\n  emit_block_i64,\n  emit_block_void,\n  emit_br,\n  emit_br_if,\n  emit_call,\n  emit_call_indirect,\n  emit_code_section,\n  emit_code_section_with_locals,\n  emit_data_section,\n  emit_data_section_multi,\n  emit_drop,\n  emit_element_section_active,\n  emit_else,\n  emit_end,\n  emit_export_section,\n  emit_export_section_multi,\n  emit_exports_full,\n  emit_exports_with_memory,\n  emit_f64_add,\n  emit_f64_const_bits,\n  emit_f64_convert_i64_s,\n  emit_f64_div,\n  emit_f64_eq,\n  emit_f64_ge,\n  emit_f64_gt,\n  emit_f64_le,\n  emit_f64_lt,\n  emit_f64_mul,\n  emit_f64_ne,\n  emit_f64_neg,\n  emit_f64_reinterpret_i64,\n  emit_f64_sub,\n  emit_func_type_raw,\n  emit_function_section,\n  emit_global_get,\n  emit_global_section_i32_mut,\n  emit_global_set,\n  emit_header,\n  emit_i32_add,\n  emit_i32_const,\n  emit_i32_load,\n  emit_i32_load8_u,\n  emit_i32_store,\n  emit_i32_store8,\n  emit_i32_wrap_i64,\n  emit_i64_add,\n  emit_i64_and,\n  emit_i64_const,\n  emit_i64_div_s,\n  emit_i64_eq,\n  emit_i64_eqz,\n  emit_i64_extend_i32_s,\n  emit_i64_ge_s,\n  emit_i64_gt_s,\n  emit_i64_le_s,\n  emit_i64_lt_s,\n  emit_i64_mul,\n  emit_i64_ne,\n  emit_i64_or,\n  emit_i64_reinterpret_f64,\n  emit_i64_rem_s,\n  emit_i64_shl,\n  emit_i64_shr_s,\n  emit_i64_sub,\n  emit_i64_trunc_f64_s,\n  emit_i64_xor,\n  emit_if_i64,\n  emit_if_void,\n  emit_import_section_func,\n  emit_local_get,\n  emit_local_set,\n  emit_local_tee,\n  emit_loop_void,\n  emit_memory_section,\n  emit_name,\n  emit_return,\n  emit_table_section_funcref,\n  emit_type_section,\n  emit_type_section_multi,\n  string_to_data\n}\n\n\nexport fn compile_lambda(buf: Bytes, params: Array[(String, Option[TypeExpr])], fn_body: Expr, local_names: Array[String], next_local: Int, ctx: CompileCtx, ld: Int, compile_fn: (Bytes, Expr, Array[String], Int, CompileCtx, Int) -> Int with { Error }) -> Int with { Error } {\n  let param_names_arr = array_empty()\n  let mut pi = 0\n  while pi < Array::length(params) {\n    let (pname, _) = Array::get(params, pi)\n    Array::push(param_names_arr, pname)\n    pi = pi + 1\n  }\n  let self_name = if Array::length(ctx.pending_letrec_self_name) > 0 {\n    let sn = Array::get(ctx.pending_letrec_self_name, 0)\n    Array::truncate(ctx.pending_letrec_self_name, 0)\n    sn\n  } else {\n    \"\"\n  }\n  let captures = collect_free_vars_indexed_self(fn_body, param_names_arr, ctx.capture_name_index, self_name, local_names)\n  let num_captures = Array::length(captures)\n  let user_params = Array::length(params)\n  let lam_buf = bytebuf_new()\n  let lam_locals = array_empty()\n  let mut lpi = 0\n  while lpi < user_params {\n    let (lpname_raw, _) = Array::get(params, lpi)\n    let lpnlen = String::length(lpname_raw)\n    let lpname = if lpnlen > 0 {\n      let lpc = String::char_code_at(lpname_raw, lpnlen - 1)\n      if lpc == '~' {\n        lpname_raw[0: lpnlen - 1]\n      } else if lpc == '?' {\n        lpname_raw[0: lpnlen - 1]\n      } else {\n        lpname_raw\n      }\n    } else lpname_raw\n    Array::push(lam_locals, lpname)\n    lpi = lpi + 1\n  }\n  Array::push(lam_locals, \"__env\")\n  let env_param_idx = user_params\n  let lam_nl_start = user_params + 1\n  let lam_ref_cells = array_empty()\n  let mut ci3 = 0\n  let mut lam_nl = lam_nl_start\n  let cl_md_bmasks = md_shadow_zeroed_bmasks(fn_body, ctx.borrow_param_user, ctx.borrow_param_mask)\n  while ci3 < num_captures {\n    let cap_local = lam_nl\n    let cap_name = Array::get(captures, ci3)\n    emit_local_get(lam_buf, env_param_idx)\n    emit_i32_wrap_i64(lam_buf)\n    emit_i64_load(lam_buf, 3, 8 + ci3 * 8)\n    if ctx.enable_rc && array_contains_str(ctx.ref_cell_names, cap_name) {\n      emit_i64_const(lam_buf, -2)\n      emit_i64_and(lam_buf)\n    }\n    emit_local_set(lam_buf, cap_local)\n    Array::push(lam_locals, cap_name)\n    if array_contains_str(ctx.ref_cell_names, cap_name) {\n      Array::push(lam_ref_cells, cap_name)\n    } else {\n      ()\n    }\n    if ctx.enable_rc && !array_contains_str(ctx.ref_cell_names, cap_name) {\n      let cap_consumes = md_consume_count_pre(fn_body, cap_name, ctx.borrow_param_user, cl_md_bmasks)\n      let mut cdup = 0\n      while cdup < cap_consumes {\n        emit_rc_dup_guarded(lam_buf, cap_local, ctx.rc_shadow)\n        cdup = cdup + 1\n      }\n    } else {\n      ()\n    }\n    lam_nl = lam_nl + 1\n    ci3 = ci3 + 1\n  }\n  let norm_params = Array::slice(params, 0, 0)\n  let mut npi = 0\n  while npi < Array::length(params) {\n    let (rawn, pty) = Array::get(params, npi)\n    let rnlen = String::length(rawn)\n    let sn = if rnlen > 0 {\n      let lc = String::char_code_at(rawn, rnlen - 1)\n      if lc == '~' || lc == '?' {\n        rawn[0: rnlen - 1]\n      } else {\n        rawn\n      }\n    } else {\n      rawn\n    }\n    Array::push(norm_params, (sn, pty))\n    npi = npi + 1\n  }\n  let lam_drops = array_empty()\n  let lam_alias_dups = array_empty()\n  let lam_dups = array_empty()\n  let lam_heap_params = array_empty()\n  if ctx.enable_rc {\n    let lam_plan = build_perceus_plan_with_params(norm_params, fn_body, ctx.borrow_ret_names, ctx.borrow_param_user, ctx.borrow_param_mask, ctx.borrow_view_ret)\n    let mut ldi = 0\n    while ldi < Array::length(lam_plan) {\n      let lpa = Array::get(lam_plan, ldi)\n      if pa_is_drop(lpa) {\n        Array::push(lam_drops, lpa.name)\n      } else if pa_is_alias_dup(lpa) {\n        Array::push(lam_alias_dups, lpa.name)\n      } else if pa_is_dup(lpa) {\n        Array::push(lam_dups, lpa.name)\n      } else {\n        ()\n      }\n      ldi = ldi + 1\n    }\n    let mut hpi = 0\n    while hpi < Array::length(norm_params) {\n      let (hpn, hpt) = Array::get(norm_params, hpi)\n      if param_is_heap_in_body(hpn, hpt, fn_body) {\n        Array::push(lam_heap_params, hpn)\n      } else {\n        ()\n      }\n      hpi = hpi + 1\n    }\n  }\n  let lam_float_slots = array_empty()\n  let lam_bool_slots = array_empty()\n  let mut lfs_i = 0\n  while lfs_i < user_params {\n    let (_, lfs_ann) = Array::get(norm_params, lfs_i)\n    match lfs_ann {\n      Some(lfs_ty) => match lfs_ty {\n        TyName(lfs_tn) => if lfs_tn == \"Float\" || lfs_tn == \"Double\" {\n          Array::push(lam_float_slots, lfs_i * 2 + 1)\n        } else if lfs_tn == \"Bool\" {\n          Array::push(lam_bool_slots, lfs_i * 4 + 3)\n        } else {\n          ()\n        },\n        _ => ()\n      },\n      None => ()\n    }\n    lfs_i = lfs_i + 1\n  }\n  let lam_ctx = CompileCtx::{\n    func_table: ctx.func_table, str_table: ctx.str_table,\n    lambda_table: ctx.lambda_table,\n    num_user_funcs: ctx.num_user_funcs, func_offset: ctx.func_offset,\n    ref_cell_names: lam_ref_cells, ctor_table: ctx.ctor_table,\n    ctor_float_fields: ctx.ctor_float_fields,\n    thunk_names: ctx.thunk_names,\n    const_int_names: ctx.const_int_names,\n    const_int_values: ctx.const_int_values,\n    enable_rc: ctx.enable_rc,\n    rc_shadow: ctx.rc_shadow,\n    rc_drop_names: lam_drops,\n    rc_alias_dup_names: lam_alias_dups,\n    heap_binding_names: lam_heap_params,\n    rc_drop_func_idx: ctx.rc_drop_func_idx,\n    rc_alloc_func_idx: ctx.rc_alloc_func_idx,\n    heap_grow_check_func_idx: ctx.heap_grow_check_func_idx,\n    map_hash_func_idx: ctx.map_hash_func_idx,\n    map_cap_func_idx: ctx.map_cap_func_idx,\n    map_build_index_func_idx: ctx.map_build_index_func_idx,\n    map_probe_func_idx: ctx.map_probe_func_idx,\n    rc_dup_names: lam_dups,\n    capture_name_index: ctx.capture_name_index,\n    float_local_slots: lam_float_slots,\n    int_local_slots: lam_bool_slots,\n    agg_local_slots: array_empty(),\n    agg_local_exprs: array_empty(),\n    agg_ret_names: ctx.agg_ret_names,\n    agg_ret_infos: ctx.agg_ret_infos,\n    heap_ret_names: ctx.heap_ret_names,\n    effect_names: ctx.effect_names,\n    effect_op_keys: ctx.effect_op_keys,\n    effect_op_arities: ctx.effect_op_arities,\n    cov: ctx.cov,\n    dbg_line_idx: ctx.dbg_line_idx,\n    dbg_line_nl: ctx.dbg_line_nl,\n    dbg_line_file_id: ctx.dbg_line_file_id,\n    loop_borrowed_names: array_empty(),\n    loop_consumed_names: array_empty(),\n    reuse_scrutinee_names: array_empty(),\n    reuse_flag_locals: array_empty(),\n    borrow_ret_names: ctx.borrow_ret_names,\n    borrow_param_user: ctx.borrow_param_user,\n    borrow_param_mask: ctx.borrow_param_mask,\n    borrow_view_ret: ctx.borrow_view_ret,\n    scalar_ret_names: ctx.scalar_ret_names,\n    pending_letrec_self_name: array_empty(),\n    table_slots_used: ctx.table_slots_used,\n    lambda_plan_next: ctx.lambda_plan_next,\n    linemap: linemap_disabled()\n  }\n  if ctx.enable_rc {\n    let mut dpi = 0\n    while dpi < Array::length(norm_params) {\n      let (dpn, dpt) = Array::get(norm_params, dpi)\n      if param_is_heap_in_body(dpn, dpt, fn_body) {\n        let mut dcount = 0\n        let mut dqi = 0\n        while dqi < Array::length(lam_dups) {\n          if Array::get(lam_dups, dqi) == dpn {\n            dcount = dcount + 1\n          } else {\n            ()\n          }\n          dqi = dqi + 1\n        }\n        let mut de = 0\n        while de < dcount {\n          emit_rc_dup_guarded(lam_buf, dpi, ctx.rc_shadow)\n          de = de + 1\n        }\n      } else {\n        ()\n      }\n      dpi = dpi + 1\n    }\n  } else {\n    ()\n  }\n  let final_lam_nl = compile_fn(lam_buf, fn_body, lam_locals, lam_nl, lam_ctx, -1)\n  let mut tail_lam_nl = final_lam_nl\n  if ctx.enable_rc && ctx.rc_drop_func_idx >= 0 {\n    let tail_root = scope_tail_proj_root(fn_body)\n    let mut need_dup = false\n    let mut ti = 0\n    while ti < Array::length(norm_params) {\n      let (tpn, tpt) = Array::get(norm_params, ti)\n      if param_is_heap_in_body(tpn, tpt, fn_body) && array_contains_str(lam_drops, tpn) && tpn == tail_root {\n        need_dup = true\n      } else {\n        ()\n      }\n      ti = ti + 1\n    }\n    let rtemp = final_lam_nl\n    if need_dup {\n      emit_local_set(lam_buf, rtemp)\n      emit_rc_dup_guarded(lam_buf, rtemp, ctx.rc_shadow)\n      tail_lam_nl = final_lam_nl + 1\n    } else {\n      ()\n    }\n    let mut tj = 0\n    while tj < Array::length(norm_params) {\n      let (dpn2, dpt2) = Array::get(norm_params, tj)\n      if param_is_heap_in_body(dpn2, dpt2, fn_body) && array_contains_str(lam_drops, dpn2) {\n        emit_local_get(lam_buf, tj)\n        emit_call(lam_buf, ctx.rc_drop_func_idx)\n      } else {\n        ()\n      }\n      tj = tj + 1\n    }\n    if need_dup {\n      emit_local_get(lam_buf, rtemp)\n    } else {\n      ()\n    }\n  } else {\n    ()\n  }\n  let live_idx = Array::length(ctx.lambda_table.bodies)\n  let lambda_idx = if Array::length(ctx.lambda_plan_next) > 0 {\n    let planned = Array::get(ctx.lambda_plan_next, 0)\n    if planned != live_idx {\n      throw(String::concat(\"lambda plan mismatch: planned index \", String::concat(__to_string(planned), String::concat(\", walk allocated \", __to_string(live_idx)))))\n    } else {\n      ()\n    }\n    Array::set(ctx.lambda_plan_next, 0, planned + 1)\n    planned\n  } else {\n    live_idx\n  }\n  Array::push(ctx.lambda_table.bodies, lam_buf)\n  Array::push(ctx.lambda_table.param_counts, user_params + 1)\n  Array::push(ctx.lambda_table.captures, captures)\n  let mut extra_lam = 0\n  let min_lam_nl = user_params + 1\n  if tail_lam_nl > min_lam_nl {\n    extra_lam = tail_lam_nl - min_lam_nl\n  }\n  Array::push(ctx.lambda_table.meta_i32, 0)\n  Array::push(ctx.lambda_table.meta_i64, extra_lam)\n  let table_slot = ctx.num_user_funcs + lambda_idx\n  Array::push(ctx.table_slots_used, table_slot)\n  if num_captures == 0 {\n    emit_i64_const(buf, (table_slot<<2)|2)\n    next_local\n  } else {\n    let ptr_local = next_local\n    let nl2 = next_local + 1\n    Array::push(local_names, \"__closure_ptr\")\n    let cap_off = if ctx.enable_rc {\n      16\n    } else {\n      8\n    }\n    if ctx.enable_rc {\n      let total = 16 + num_captures * 8\n      emit_i64_const(buf, total)\n      emit_call(buf, ctx.rc_alloc_func_idx)\n      emit_local_set(buf, ptr_local)\n      emit_local_get(buf, ptr_local)\n      emit_i32_wrap_i64(buf)\n      emit_i32_const(buf, total)\n      emit_i32_store(buf, 2, 0)\n      emit_local_get(buf, ptr_local)\n      emit_i32_wrap_i64(buf)\n      emit_i32_const(buf, 1)\n      emit_i32_store(buf, 2, 4)\n      emit_local_get(buf, ptr_local)\n      emit_i32_wrap_i64(buf)\n      emit_i32_const(buf, 7)\n      emit_i32_store8(buf, 0, 7)\n      emit_local_get(buf, ptr_local)\n      emit_i32_wrap_i64(buf)\n      emit_i32_const(buf, table_slot)\n      emit_i32_store(buf, 2, 8)\n      emit_local_get(buf, ptr_local)\n      emit_i32_wrap_i64(buf)\n      emit_i32_const(buf, num_captures)\n      emit_i32_store(buf, 2, 12)\n    } else {\n      emit_global_get(buf, 0)\n      emit_i64_extend_i32_u(buf)\n      emit_local_tee(buf, ptr_local)\n      emit_i32_wrap_i64(buf)\n      emit_i32_const(buf, 8 + num_captures * 8)\n      emit_i32_add(buf)\n      emit_global_set(buf, 0)\n      emit_heap_grow_after_heap_set(buf, ctx)\n      emit_local_get(buf, ptr_local)\n      emit_i32_wrap_i64(buf)\n      emit_i32_const(buf, table_slot)\n      emit_i32_store(buf, 2, 0)\n      emit_local_get(buf, ptr_local)\n      emit_i32_wrap_i64(buf)\n      emit_i32_const(buf, num_captures)\n      emit_i32_store(buf, 2, 4)\n    }\n    let mut csi = 0\n    while csi < num_captures {\n      let cap_name = Array::get(captures, csi)\n      let mut __cap_resolve = -1\n      let mut __cri = Array::length(local_names) - 1\n      while __cri >= 0 {\n        if Array::get(local_names, __cri) == cap_name {\n          __cap_resolve = __cri\n          __cri = -1\n        } else {\n          __cri = __cri - 1\n        }\n      }\n      if __cap_resolve >= 0 {\n        if ctx.enable_rc && array_contains_str(ctx.ref_cell_names, cap_name) {\n          emit_local_get(buf, ptr_local)\n          emit_i32_wrap_i64(buf)\n          emit_local_get(buf, __cap_resolve)\n          emit_i64_const(buf, 1)\n          emit_i64_or(buf)\n          emit_i64_store(buf, 3, cap_off + csi * 8)\n          emit_rc_word_inc_saturating(buf, () -> {\n            emit_local_get(buf, __cap_resolve)\n            emit_i32_wrap_i64(buf)\n            emit_i32_const(buf, 4)\n            emit_i32_sub(buf)\n          })\n        } else {\n          emit_local_get(buf, ptr_local)\n          emit_i32_wrap_i64(buf)\n          emit_local_get(buf, __cap_resolve)\n          emit_i64_store(buf, 3, cap_off + csi * 8)\n          if ctx.enable_rc && cap_name != self_name {\n            emit_rc_dup_guarded(buf, __cap_resolve, ctx.rc_shadow)\n          } else {\n            ()\n          }\n        }\n      } else {\n        emit_local_get(buf, ptr_local)\n        emit_i32_wrap_i64(buf)\n        emit_i64_const(buf, 0)\n        emit_i64_store(buf, 3, cap_off + csi * 8)\n      }\n      csi = csi + 1\n    }\n    if ctx.enable_rc {\n      emit_local_get(buf, ptr_local)\n      emit_i64_const(buf, 8)\n      emit_i64_add(buf)\n      emit_i64_const(buf, 1)\n      emit_i64_or(buf)\n    } else {\n      emit_local_get(buf, ptr_local)\n      emit_i64_const(buf, 1)\n      emit_i64_or(buf)\n    }\n    nl2\n  }\n}\n")
}

let source_91 = () -> (String, String) {
  ("lib/@vibe/compiler/codegen/common_base/builtin_registry.vibe",
"\nimport @vibe/compiler/core {\n  Type\n}\n\nimport @vibe/core {\n  array_empty\n}\n\n\n\nfn reg_p0() -> Array[Type] {\n  array_empty()\n}\n\nfn reg_p1(a: Type) -> Array[Type] {\n  let arr = reg_p0()\n  Array::push(arr, a)\n  arr\n}\n\nfn reg_p2(a: Type, b: Type) -> Array[Type] {\n  let arr = reg_p1(a)\n  Array::push(arr, b)\n  arr\n}\n\nfn reg_p3(a: Type, b: Type, c: Type) -> Array[Type] {\n  let arr = reg_p2(a, b)\n  Array::push(arr, c)\n  arr\n}\n\nfn reg_p4(a: Type, b: Type, c: Type, d: Type) -> Array[Type] {\n  let arr = reg_p3(a, b, c)\n  Array::push(arr, d)\n  arr\n}\n\nfn reg_p5(a: Type, b: Type, c: Type, d: Type, e: Type) -> Array[Type] {\n  let arr = reg_p4(a, b, c, d)\n  Array::push(arr, e)\n  arr\n}\n\nlet registry_typed_rows: Array[(String, Type, Bool, Bool, Bool)] = [\n  (\"Env::get\", CtFn(reg_p1(CtString), CtString, Some(\"Env\")), true, false, true),\n  (\"Env::args_len\", CtFn(reg_p0(), CtInt, Some(\"Env\")), true, false, true),\n  (\"Env::args_get\", CtFn(reg_p1(CtInt), CtString, Some(\"Env\")), true, false, true),\n  (\"Fs::read_file\", CtFn(reg_p1(CtString), CtString, Some(\"Fs\")), true, false, true),\n  (\"Fs::exists\", CtFn(reg_p1(CtString), CtBool, Some(\"Fs\")), true, false, true),\n  (\"Fs::stat_token\", CtFn(reg_p1(CtString), CtInt, Some(\"Fs\")), true, false, true),\n  (\"vibe_fs_stat_token_raw\", CtFn(reg_p1(CtString), CtInt, Some(\"Fs\")), true, false, true),\n  (\"Fs::write_file\", CtFn(reg_p2(CtString, CtString), CtUnit, Some(\"Fs\")), true, false, true),\n  (\"Fs::write_bytes\", CtFn(reg_p2(CtString, CtBytes), CtUnit, Some(\"Fs\")), true, false, true),\n  (\"Fs::read_bytes\", CtFn(reg_p1(CtString), CtBytes, Some(\"Fs\")), true, false, true),\n  (\"vibe_fs_read_dir_raw\", CtFn(reg_p1(CtString), CtString, Some(\"Fs\")), true, false, false),\n  (\"sh\", CtFn(reg_p1(CtString), CtString, Some(\"Process\")), true, false, true),\n  (\"vibe_sh_lines_raw\", CtFn(reg_p1(CtString), CtString, Some(\"Process\")), true, false, false),\n  (\"vibe_sh_capture_raw\", CtFn(reg_p1(CtString), CtInt, Some(\"Process\")), true, false, true),\n  (\"vibe_sh_capture_exit_code_raw\", CtFn(reg_p1(CtInt), CtInt, Some(\"Process\")), true, false, true),\n  (\"vibe_sh_capture_stdout_raw\", CtFn(reg_p1(CtInt), CtString, Some(\"Process\")), true, false, true),\n  (\"vibe_sh_capture_stderr_raw\", CtFn(reg_p1(CtInt), CtString, Some(\"Process\")), true, false, true),\n  (\"vibe_sh_capture_close_raw\", CtFn(reg_p1(CtInt), CtUnit, Some(\"Process\")), true, false, true),\n  (\"vibe_process_exit_raw\", CtFn(reg_p1(CtInt), CtUnit, Some(\"Process\")), true, false, true),\n  (\"Stdin::read_stream\", CtFn(reg_p1(CtInt), CtString, Some(\"Stdin\")), true, false, true),\n  (\"Stdout::write_stream\", CtFn(reg_p1(CtString), CtUnit, Some(\"Stdout\")), true, false, true),\n  (\"Stdout::write_char\", CtFn(reg_p1(CtInt), CtUnit, Some(\"Stdout\")), true, false, true),\n  (\"Stderr::write_stream\", CtFn(reg_p1(CtString), CtUnit, Some(\"Stderr\")), true, false, true),\n  (\"Stderr::write_char\", CtFn(reg_p1(CtInt), CtUnit, Some(\"Stderr\")), true, false, true),\n  (\"resolve_path\", CtFn(reg_p1(CtString), CtString, None), true, false, false),\n  (\"Fs::remove\", CtFn(reg_p1(CtString), CtUnit, Some(\"Fs\")), true, false, true),\n  (\"Fs::mkdir_p\", CtFn(reg_p1(CtString), CtUnit, Some(\"Fs\")), true, false, true),\n  (\"Fs::mkdir\", CtFn(reg_p1(CtString), CtUnit, Some(\"Fs\")), true, false, true),\n  (\"Fs::chdir\", CtFn(reg_p1(CtString), CtUnit, Some(\"Fs\")), true, false, true),\n  (\"Fs::copy\", CtFn(reg_p2(CtString, CtString), CtUnit, Some(\"Fs\")), true, false, true),\n  (\"Fs::append\", CtFn(reg_p2(CtString, CtString), CtUnit, Some(\"Fs\")), true, false, true),\n  (\"Fs::rename\", CtFn(reg_p2(CtString, CtString), CtUnit, Some(\"Fs\")), true, false, true),\n  (\"Fs::is_dir\", CtFn(reg_p1(CtString), CtBool, Some(\"Fs\")), true, false, true),\n  (\"Fs::is_file\", CtFn(reg_p1(CtString), CtBool, Some(\"Fs\")), true, false, true),\n  (\"Fs::getcwd\", 