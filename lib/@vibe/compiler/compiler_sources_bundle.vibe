on. Reproduced via\\n// checker_pattern_test.vibe: passes against baseline, fails once this\\n// import routes through codegen/index.vibe. See #847.\\nimport ../codegen/builtin_registry.vibe {\\n  lookup_registry_builtin\\n}\\n\\nimport ../core/index.vibe {\\n  Type\\n}\\n\\nimport ./builtins_array.vibe {\\n  lookup_array\\n}\\n\\nimport ./builtins_async.vibe {\\n  lookup_async\\n}\\n\\nimport ./builtins_builders.vibe {\\n  lookup_array_builder, lookup_string_builder\\n}\\n\\nimport ./builtins_bytes.vibe {\\n  lookup_bytes\\n}\\n\\nimport ./builtins_fixed_array.vibe {\\n  lookup_fixed_array\\n}\\n\\nimport ./builtins_fs.vibe {\\n  lookup_fs\\n}\\n\\nimport ./builtins_map.vibe {\\n  lookup_map\\n}\\n\\nimport ./builtins_misc.vibe {\\n  lookup_misc\\n}\\n\\nimport ./builtins_simd.vibe {\\n  lookup_simd\\n}\\n\\nimport ./builtins_net.vibe {\\n  lookup_net\\n}\\n\\nimport ./builtins_string1.vibe {\\n  lookup_string1\\n}\\n\\nimport ./builtins_string2.vibe {\\n  lookup_string2\\n}\\n\\nimport ./builtins_system.vibe {\\n  lookup_io\\n}\\n\\n//# Functions\\n\\nexport fn lookup_builtin(name: String) -> Option[Type] {\\n  let normalized = canonical_builtin_name(name)\\n  match lookup_registry_builtin(normalized) {\\n    Some(t) => Some(t),\\n    None => match lookup_array(normalized) {\\n    Some(t) => Some(t),\\n    None => match lookup_fixed_array(normalized) {\\n      Some(t) => Some(t),\\n      None => match lookup_array_builder(normalized) {\\n        Some(t) => Some(t),\\n        None => match lookup_string1(normalized) {\\n          Some(t) => Some(t),\\n          None => match lookup_string2(normalized) {\\n            Some(t) => Some(t),\\n            None => match lookup_string_builder(normalized) {\\n              Some(t) => Some(t),\\n              None => match lookup_bytes(normalized) {\\n                Some(t) => Some(t),\\n                None => match lookup_simd(normalized) {\\n                Some(t) => Some(t),\\n                None => match lookup_map(