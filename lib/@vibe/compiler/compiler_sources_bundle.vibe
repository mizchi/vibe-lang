let source_65 = () -> (String, String) {
  ("lib/@vibe/compiler/codegen/wasm_emit/sections.vibe",
"\n\n\n\n\nexport {\n  emit_code_section,\n  emit_code_section_with_locals,\n  emit_data_section,\n  emit_end,\n  emit_export_memory,\n  emit_export_section,\n  emit_export_section_multi,\n  emit_exports_full,\n  emit_exports_with_memory,\n  emit_func_type,\n  emit_func_type_raw,\n  emit_function_name_section,\n  emit_function_section,\n  emit_global_get,\n  emit_global_section_i32_mut,\n  emit_global_set,\n  emit_header,\n  emit_heap_memory_grow_check,\n  emit_i32_const,\n  emit_import_section_func,\n  emit_memory_section,\n  emit_name,\n  emit_type_section,\n  emit_type_section_multi,\n  emit_vibe_abi_custom_section\n}\n")
}

let source_66 = () -> (String, String) {
  ("lib/@vibe/compiler/codegen/wasm_emit/metadata.vibe",
"\nimport @vibe/compiler/core {\n  bytebuf_new, bytebuf_push, bytebuf_push_section, bytebuf_push_string, leb128_encode_u32\n}\n\n\nexport fn emit_function_name_section(out: Bytes, names: Array[String], base_index: Int) -> Unit {\n  let count = Array::length(names)\n  if count == 0 {\n    ()\n  } else {\n    let content = bytebuf_new()\n    bytebuf_push_string(content, \"name\")\n    let namemap = bytebuf_new()\n    leb128_encode_u32(namemap, count)\n    let mut i = 0\n    while i < count {\n      leb128_encode_u32(namemap, base_index + i)\n      bytebuf_push_string(namemap, Array::get(names, i))\n      i = i + 1\n    }\n    bytebuf_push_section(content, 1, namemap)\n    bytebuf_push_section(out, 0, content)\n  }\n}\n\nfn emit_ascii_payload(buf: Bytes, text: String) -> Unit {\n  let len = String::length(text)\n  let mut i = 0\n  while i < len {\n    bytebuf_push(buf, String::char_code_at(text, i))\n    i = i + 1\n  }\n}\n\nexport fn emit_vibe_abi_custom_section(out: Bytes, host_import_abi: String) -> Unit {\n  let content = bytebuf_new()\n  bytebuf_push_string(content, \"vibe.abi\")\n  emit_ascii_payload(content, \"version=1\\n\")\n  emit_ascii_payload(content, String::concat(\"host_import_abi=\", host_import_abi))\n  emit_ascii_payload(content, \"\\n\")\n  bytebuf_push_section(out, 0, content)\n}\n")
}

