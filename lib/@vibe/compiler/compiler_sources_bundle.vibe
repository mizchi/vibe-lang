ch lookup_fixed_array_make(name) {\n    Some(t) => Some(t),\n    None => match lookup_fixed_array_length(name) {\n      Some(t) => Some(t),\n      None => lookup_fixed_array_get(name)\n    }\n  }\n}\n\nfn lookup_fixed_array_unsafe_set(name: String) -> Option[Type] {\n  if name == \"FixedArray::unsafe_set\" {\n    Some(CtFn(fixed_array_three_params(CtArray(CtUnknown), CtInt, CtUnknown), CtUnit, None))\n  }\n  else None\n}\n\nfn lookup_fixed_array_group_b(name: String) -> Option[Type] {\n  match lookup_fixed_array_set(name) {\n    Some(t) => Some(t),\n    None => match lookup_fixed_array_unsafe_set(name) {\n      Some(t) => Some(t),\n      None => lookup_fixed_array_blit(name)\n    }\n  }\n}\n\nexport fn lookup_fixed_array(name: String) -> Option[Type] {\n  match lookup_fixed_array_group_a(name) {\n    Some(t) => Some(t),\n    None => lookup_fixed_array_group_b(name)\n  }\n}\n")
