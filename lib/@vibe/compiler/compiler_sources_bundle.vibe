"\n\n\n\n\n\n\nfn efn_param_count(expr: Expr) -> Int {\n  match expr {\n    EFn(_, _, params, _, _, _) => Array::length(params),\n    _ => -1\n  }\n}\n\nfn resolve_reexport_chain(source_path: String, items: Array[(String, Option[String])], module_name: String, linked_imports: Array[(String, String, Int, Int)], type_stmts: Array[Stmt], depth: Int) -> Unit with { Error, Fs } {\n  if depth > 10 {\n    ()\n  }\n  else {\n    let source = Fs::read_file(source_path)\n    let stmts = parse_program(lex(source))\n    let source_dir = dir_of_path(source_path)\n    let wanted_names = Array::slice([\n      \"\"\n    ], 0, 0)\n    let mut wi = 0\n    while wi < Array::length(items) {\n      let (name, _) = Array::get(items, wi)\n      Array::push(wanted_names, name)\n      wi = wi + 1\n    }\n    let mut si = 0\n    while si < Array::length(stmts) {\n      match Array::get(stmts, si) {\n        SLet(true, _, name, _, expr) => if contains_name(wanted_names, name) {\n          let param_count = efn_param_count(expr)\n          if param_count >= 0 {\n            let export_name = get_export_name(items, name)\n            Array::push(linked_imports, (module_name, export_name, param_count, 1))\n          }\n        }\n        ,\n        SEnum(true, name, _, _, _) => if contains_name(wanted_names, name) {\n          Array::push(type_stmts, Array::get(stmts, si))\n        }\n        ,\n        SReExport(raw_path, inner_items) => {\n          let filtered = Array::slice([\n            (\"\", None)\n          ], 0, 0)\n          let mut fi = 0\n          while fi < Array::length(inner_items) {\n            let (iname, irename) = Array::get(inner_items, fi)\n            if contains_name(wanted_names, iname) {\n              Array::push(filtered, (iname, irename))\n            }\n            fi = fi + 1\n          }\n          if Array::length(filtered) > 0 {\n            let resolved = resolve_import_path(source_dir, raw_path)\n            resolve_reexport_chain(resolved, filtered, module_name, linked_imports, type_stmts, depth + 1)\n          }\n        },\n        _ => ()\n      }\n      si = si + 1\n    }\n  }\n}\n\n\nexport {\n  path_to_module_name, resolve_reexport_chain\n}\n")
