"\nimport @vibe/compiler/core {\n  Expr,\n  Pat,\n  Stmt,\n  TypeExpr,\n  bytebuf_length,\n  bytebuf_new,\n  bytebuf_push,\n  bytebuf_push_section,\n  bytebuf_push_vec_header,\n  bytebuf_to_bytes,\n  leb128_encode_s64,\n  leb128_encode_u32\n}\n\nimport @vibe/compiler/codegen/common_analysis {\n  collect_free_vars, collect_strings_stmts, emit_closure_call_tail, emit_closure_resolve, emit_i64_extend_i32_u, is_mut_captured_in\n}\n\nimport @vibe/compiler/codegen/common_base {\n  CompileCtxGc,\n  CtorTable,\n  FuncTable,\n  LambdaTable,\n  StrTable,\n  agg_log_reset_above,\n  ctor_table_index_of,\n  emit_binop_op,\n  emit_i32_eq,\n  emit_i32_eqz,\n  emit_i32_ge_u,\n  emit_i32_mul,\n  emit_i32_ne,\n  emit_i32_sub,\n  emit_i64_load,\n  emit_i64_store,\n  emit_str_ref,\n  find_func_stmt,\n  gc_slot_log_reset_above,\n  resolve_func,\n  resolve_local\n}\n\nimport @vibe/compiler/codegen/common_extractors {\n  array_contains_str, emit_assignop_op, emit_memory_copy, find_catchall_idx, str_table_lookup\n}\n\nimport @vibe/compiler/codegen/wasm_emit {\n  emit_block_i64,\n  emit_block_void,\n  emit_br,\n  emit_br_if,\n  emit_call,\n  emit_call_indirect,\n  emit_code_section,\n  emit_code_section_with_locals,\n  emit_data_section,\n  emit_data_section_multi,\n  emit_drop,\n  emit_element_section_active,\n  emit_else,\n  emit_end,\n  emit_export_section,\n  emit_export_section_multi,\n  emit_exports_with_memory,\n  emit_f64_add,\n  emit_f64_const_bits,\n  emit_f64_const_lohi,\n  emit_f64_convert_i64_s,\n  emit_f64_div,\n  emit_f64_eq,\n  emit_f64_ge,\n  emit_f64_gt,\n  emit_f64_le,\n  emit_f64_lt,\n  emit_f64_mul,\n  emit_f64_ne,\n  emit_f64_neg,\n  emit_f64_reinterpret_i64,\n  emit_f64_sub,\n  emit_func_type_raw,\n  emit_function_section,\n  emit_global_get,\n  emit_global_section_i32_mut,\n  emit_global_set,\n  emit_header,\n  emit_i32_add,\n  emit_i32_const,\n  emit_i32_load,\n  emit_i32_load8_u,\n  emit_i32_store,\n  emit_i32_store8,\n  emit_i32_wrap_i64,\n  emit_i64_add,\n  emit_i64_and,\n  emit_i64_const,\n  emit_i64_div_s,\n  emit_i64_eq,\n  emit_i64_eqz,\n  emit_i64_extend_i32_s,\n  emit_i64_ge_s,\n  emit_i64_gt_s,\n  emit_i64_le_s,\n  emit_i64_lt_s,\n  emit_i64_mul,\n  emit_i64_ne,\n  emit_i64_or,\n  emit_i64_reinterpret_f64,\n  emit_i64_rem_s,\n  emit_i64_shl,\n  emit_i64_shr_s,\n  emit_i64_sub,\n  emit_i64_trunc_f64_s,\n  emit_i64_xor,\n  emit_if_i64,\n  emit_if_void,\n  emit_import_section_func,\n  emit_local_get,\n  emit_local_set,\n  emit_local_tee,\n  emit_loop_void,\n  emit_memory_section,\n  emit_name,\n  emit_return,\n  emit_struct_get,\n  emit_struct_new,\n  emit_struct_set,\n  emit_struct_type_raw,\n  emit_table_section_funcref,\n  emit_type_section,\n  emit_type_section_multi,\n  string_to_data\n}\n\n\n\n\n\n\n\n\n\n\nfn field_index_in_gc(fnames: Array[String], field: String) -> Int {\n  let mut fi = 0\n  let mut found = -1\n  while fi < Array::length(fnames) {\n    if Array::get(fnames, fi) == field {\n      found = fi\n      fi = Array::length(fnames)\n    } else {\n      fi = fi + 1\n    }\n  }\n  found\n}\n\nfn struct_field_index_gc(ctx: CompileCtxGc, sname: String, field: String) -> Int with { Error } {\n  let names = ctx.gc_ctor_table.struct_names\n  let mut si = 0\n  let mut sidx = -1\n  while si < Array::length(names) {\n    if Array::get(names, si) == sname {\n      sidx = si\n      si = Array::length(names)\n    } else {\n      si = si + 1\n    }\n  }\n  if sidx >= 0 {\n    let found = field_index_in_gc(Array::get(ctx.gc_ctor_table.struct_field_names, sidx), field)\n    if found < 0 {\n      throw(String::concat(String::concat(String::concat(\"unknown field `\", field), \"` in struct \"), sname))\n    } else {\n      found\n    }\n  } else {\n    let mut gsi = 0\n    let mut gfound = -1\n    while gsi < Array::length(names) {\n      let f = field_index_in_gc(Array::get(ctx.gc_ctor_table.struct_field_names, gsi), field)\n      if f >= 0 {\n        gfound = f\n        gsi = Array::length(names)\n      } else {\n        gsi = gsi + 1\n      }\n    }\n    if gfound < 0 {\n      throw(String::concat(\"unknown struct field in pattern: \", field))\n    } else {\n      gfound\n    }\n  }\n}\n\n\nfn gc_pat_needs_test(p: Pat) -> Bool {\n  match p {\n    PBind(_) => false,\n    PWild => false,\n    PTuple(ps) => {\n      let mut any = false\n      let mut i = 0\n      while i < Array::length(ps) {\n        if gc_pat_needs_test(Array::get(ps, i)) {\n          any = true\n        }\n        i = i + 1\n      }\n      any\n    },\n    PStruct(_, fields) => {\n      let mut any = false\n      let mut i = 0\n      while i < Array::length(fields) {\n        let (_, sub) = Array::get(fields, i)\n        if gc_pat_needs_test(sub) {\n          any = true\n        }\n        i = i + 1\n      }\n      any\n    },\n    _ => true\n  }\n}\n\nfn gc_pat_has_binds(p: Pat) -> Bool {\n  match p {\n    PBind(_) => true,\n    PCtor(_, args) => {\n      let mut any = false\n      let mut i = 0\n      while i < Array::length(args) {\n        if gc_pat_has_binds(Array::get(args, i)) {\n          any = true\n        }\n        i = i + 1\n      }\n      any\n    },\n    PTuple(ps) => {\n      let mut any = false\n      let mut i = 0\n      while i < Array::length(ps) {\n        if gc_pat_has_binds(Array::get(ps, i)) {\n          any = true\n        }\n        i = i + 1\n      }\n      any\n    },\n    PStruct(_, fields) => {\n      let mut any = false\n      let mut i = 0\n      while i < Array::length(fields) {\n        let (_, sub) = Array::get(fields, i)\n        if gc_pat_has_binds(sub) {\n          any = true\n        }\n        i = i + 1\n      }\n      any\n    },\n    POr(l, r) => gc_pat_has_binds(l) || gc_pat_has_binds(r),\n    _ => false\n  }\n}\n\nfn gc_extract_ctor_payload(buf: Bytes, local_names: Array[String], vloc: Int, idx: Int) -> Int {\n  let tl = Array::length(local_names)\n  emit_local_get(buf, vloc)\n  emit_i64_const(buf, -2)\n  emit_i64_and(buf)\n  emit_i32_wrap_i64(buf)\n  emit_i64_load(buf, 3, 8 + idx * 8)\n  emit_local_set(buf, tl)\n  Array::push(local_names, \"__pat_tmp\")\n  tl\n}\n\nfn gc_extract_tuple_elem(buf: Bytes, local_names: Array[String], vloc: Int, idx: Int) -> Int {\n  let tl = Array::length(local_names)\n  emit_local_get(buf, vloc)\n  emit_i32_wrap_i64(buf)\n  emit_i64_load(buf, 3, idx * 8)\n  emit_local_set(buf, tl)\n  Array::push(local_names, \"__pat_tmp\")\n  tl\n}\n\nfn emit_gc_pat_test(buf: Bytes, local_names: Array[String], vloc: Int, pat: Pat, ctx: CompileCtxGc) -> Unit with { Error } {\n  match pat {\n    PInt(n) => {\n      emit_local_get(buf, vloc)\n      emit_i64_const(buf, n)\n      emit_i64_eq(buf)\n    },\n    PFloat(fv) => {\n      emit_local_get(buf, vloc)\n      emit_f64_reinterpret_i64(buf)\n      emit_f64_const_lohi(buf, Double::to_i64_bits_lo(fv), Double::to_i64_bits_hi(fv))\n      emit_f64_eq(buf)\n    },\n    PBool(bv) => {\n      emit_local_get(buf, vloc)\n      emit_i64_const(buf, if bv {\n        1\n      } else {\n        0\n      })\n      emit_i64_eq(buf)\n    },\n    PString(sval) => {\n      let str_idx = str_table_lookup(ctx.str_table.strs, sval)\n      if str_idx >= 0 {\n        let (streq_idx, _, _) = resolve_func(ctx.func_table, \"String::equals\")\n        emit_local_get(buf, vloc)\n        emit_str_ref(buf, Array::get(ctx.str_table.offsets, str_idx), Array::get(ctx.str_table.lengths, str_idx))\n        if ctx.func_offset > 0 && streq_idx >= ctx.func_offset {\n          emit_i64_const(buf, 0)\n        } else {\n          ()\n        }\n        emit_call(buf, streq_idx)\n        emit_i64_const(buf, 1)\n        emit_i64_eq(buf)\n      } else {\n        emit_i32_const(buf, 0)\n      }\n    },\n    PBind(_) => emit_i32_const(buf, 1),\n    PWild => emit_i32_const(buf, 1),\n    POr(l, r) => {\n      emit_gc_pat_test(buf, local_names, vloc, l, ctx)\n      bytebuf_push(buf, 4)\n      bytebuf_push(buf, 127)\n      emit_i32_const(buf, 1)\n      emit_else(buf)\n      emit_gc_pat_test(buf, local_names, vloc, r, ctx)\n      emit_end(buf)\n    },\n    PCtor(cname, cargs) => {\n      let ctor_ci = ctor_table_index_of(ctx.gc_ctor_table, cname)\n      let expected_tag = if ctor_ci >= 0 {\n        Array::get(ctx.gc_ctor_table.tags, ctor_ci)\n      } else {\n        -1\n      }\n      emit_local_get(buf, vloc)\n      emit_i64_const(buf, -2)\n      emit_i64_and(buf)\n      emit_i32_wrap_i64(buf)\n      emit_i32_load(buf, 2, 0)\n      emit_i32_const(buf, expected_tag)\n      emit_i32_eq(buf)\n      let mut any_sub = false\n      let mut ci = 0\n      while ci < Array::length(cargs) {\n        if gc_pat_needs_test(Array::get(cargs, ci)) {\n          any_sub = true\n        }\n        ci = ci + 1\n      }\n      if any_sub {\n        bytebuf_push(buf, 4)\n        bytebuf_push(buf, 127)\n        emit_i32_const(buf, 1)\n        let mut si = 0\n        while si < Array::length(cargs) {\n          let sub = Array::get(cargs, si)\n          if gc_pat_needs_test(sub) {\n            bytebuf_push(buf, 4)\n            bytebuf_push(buf, 127)\n            let tl = gc_extract_ctor_payload(buf, local_names, vloc, si)\n            emit_gc_pat_test(buf, local_names, tl, sub, ctx)\n            emit_else(buf)\n            emit_i32_const(buf, 0)\n            emit_end(buf)\n          } else {\n            ()\n          }\n          si = si + 1\n        }\n        emit_else(buf)\n        emit_i32_const(buf, 0)\n        emit_end(buf)\n      } else {\n        ()\n      }\n    },\n    PTuple(ps) => {\n      emit_i32_const(buf, 1)\n      let mut ti = 0\n      while ti < Array::length(ps) {\n        let sub = Array::get(ps, ti)\n        if gc_pat_needs_test(sub) {\n          bytebuf_push(buf, 4)\n          bytebuf_push(buf, 127)\n          let tl = gc_extract_tuple_elem(buf, local_names, vloc, ti)\n          emit_gc_pat_test(buf, local_names, tl, sub, ctx)\n          emit_else(buf)\n          emit_i32_const(buf, 0)\n          emit_end(buf)\n        } else {\n          ()\n        }\n        ti = ti + 1\n      }\n    },\n    PStruct(sname, fields) => {\n      emit_i32_const(buf, 1)\n      let mut fi = 0\n      while fi < Array::length(fields) {\n        let (fname, sub) = Array::get(fields, fi)\n        if gc_pat_needs_test(sub) {\n          bytebuf_push(buf, 4)\n          bytebuf_push(buf, 127)\n          let off_idx = struct_field_index_gc(ctx, sname, fname)\n          let tl = gc_extract_ctor_payload(buf, local_names, vloc, off_idx)\n          emit_gc_pat_test(buf, local_names, tl, sub, ctx)\n          emit_else(buf)\n          emit_i32_const(buf, 0)\n          emit_end(buf)\n        } else {\n          ()\n        }\n        fi = fi + 1\n      }\n    }\n  }\n}\n\nfn emit_gc_pat_binds(buf: Bytes, local_names: Array[String], vloc: Int, pat: Pat, ctx: CompileCtxGc) -> Unit with { Error } {\n  match pat {\n    PBind(name) => {\n      let bl = Array::length(local_names)\n      emit_local_get(buf, vloc)\n      emit_local_set(buf, bl)\n      Array::push(local_names, name)\n    },\n    PCtor(_, cargs) => {\n      let mut i = 0\n      while i < Array::length(cargs) {\n        let sub = Array::get(cargs, i)\n        if gc_pat_has_binds(sub) {\n          let tl = gc_extract_ctor_payload(buf, local_names, vloc, i)\n          emit_gc_pat_binds(buf, local_names, tl, sub, ctx)\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n    },\n    PTuple(ps) => {\n      let mut i = 0\n      while i < Array::length(ps) {\n        let sub = Array::get(ps, i)\n        if gc_pat_has_binds(sub) {\n          let tl = gc_extract_tuple_elem(buf, local_names, vloc, i)\n          emit_gc_pat_binds(buf, local_names, tl, sub, ctx)\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n    },\n    PStruct(sname, fields) => {\n      let mut i = 0\n      while i < Array::length(fields) {\n        let (fname, sub) = Array::get(fields, i)\n        if gc_pat_has_binds(sub) {\n          let off_idx = struct_field_index_gc(ctx, sname, fname)\n          let tl = gc_extract_ctor_payload(buf, local_names, vloc, off_idx)\n          emit_gc_pat_binds(buf, local_names, tl, sub, ctx)\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n    },\n    POr(l, r) => {\n      if gc_pat_has_binds(l) || gc_pat_has_binds(r) {\n        throw(\"GC codegen: or-pattern with variable binds is unsupported\")\n      } else {\n        ()\n      }\n    },\n    _ => ()\n  }\n}\n\nfn compile_match_gc(buf: Bytes, scrutinee: Expr, arms: Array[(Pat, Expr)], local_names: Array[String], next_local: Int, ctx: CompileCtxGc, ld: Int, ce: (Bytes, Expr, Array[String], Int, Int) -> Int with { Error }) -> Int with { Error } {\n  let scrut_local = next_local\n  Array::push(local_names, \"__match_scrut\")\n  let nl1 = ce(buf, scrutinee, local_names, next_local + 1, ld)\n  emit_local_set(buf, scrut_local)\n  let num_arms = Array::length(arms)\n  let catchall_idx = find_catchall_idx(arms)\n  let num_cond_arms = catchall_idx\n  let mut max_nl = nl1\n  let mut ai = 0\n  while ai < num_cond_arms {\n    let names_len_at_arm = Array::length(local_names)\n    let (p, arm_body) = Array::get(arms, ai)\n    let ld_arm = if ld >= 0 {\n      ld + ai + 1\n    } else {\n      -1\n    }\n    emit_gc_pat_test(buf, local_names, scrut_local, p, ctx)\n    emit_if_i64(buf)\n    emit_gc_pat_binds(buf, local_names, scrut_local, p, ctx)\n    let arm_nl = ce(buf, arm_body, local_names, Array::length(local_names), ld_arm)\n    if arm_nl > max_nl {\n      max_nl = arm_nl\n    }\n    if Array::length(local_names) > max_nl {\n      max_nl = Array::length(local_names)\n    }\n    emit_else(buf)\n    Array::truncate(local_names, names_len_at_arm)\n    agg_log_reset_above(ctx.gc_agg_local_slots, names_len_at_arm)\n    gc_slot_log_reset_above(ctx.gc_bool_locals, names_len_at_arm)\n    gc_slot_log_reset_above(ctx.gc_float_locals, names_len_at_arm)\n    ai = ai + 1\n  }\n  let ld_catch = if ld >= 0 {\n    ld + num_cond_arms\n  } else {\n    -1\n  }\n  let _names_len_at_catch = Array::length(local_names)\n  if catchall_idx < num_arms {\n    let (cp, cbody) = Array::get(arms, catchall_idx)\n    emit_gc_pat_binds(buf, local_names, scrut_local, cp, ctx)\n    let catch_nl = ce(buf, cbody, local_names, Array::length(local_names), ld_catch)\n    if catch_nl > max_nl {\n      max_nl = catch_nl\n    }\n    0\n  } else {\n    bytebuf_push(buf, 0)\n    0\n  }\n  let mut ci2 = 0\n  while ci2 < num_cond_arms {\n    emit_end(buf)\n    ci2 = ci2 + 1\n  }\n  while Array::length(local_names) < max_nl {\n    Array::push(local_names, \"\")\n  }\n  max_nl\n}\n\n\nexport {\n  compile_match_gc\n}\n")
}

