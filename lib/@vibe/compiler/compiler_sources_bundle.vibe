emit_global_get, emit_global_section_i32_mut, emit_global_set, emit_header, emit_i32_add, emit_i32_const, emit_i32_load, emit_i32_load8_u, emit_i32_store, emit_i32_store8, emit_i32_wrap_i64, emit_i64_add, emit_i64_and, emit_i64_const, emit_i64_div_s, emit_i64_eq, emit_i64_eqz, emit_i64_extend_i32_s, emit_i64_ge_s, emit_i64_gt_s, emit_i64_le_s, emit_i64_lt_s, emit_i64_mul, emit_i64_ne, emit_i64_or, emit_i64_reinterpret_f64, emit_i64_rem_s, emit_i64_shl, emit_i64_shr_s, emit_i64_sub, emit_i64_trunc_f64_s, emit_i64_xor, emit_if_i64, emit_if_void, emit_import_section_func, emit_local_get, emit_local_set, emit_local_tee, emit_loop_void, emit_memory_section, emit_name, emit_return, emit_struct_get, emit_struct_new, emit_struct_set, emit_struct_type_raw, emit_table_section_funcref, emit_type_section, emit_type_section_multi, string_to_data\\n}\\n\\nimport ./backend_builtins_array_alloc.vibe {\\n  gc_gen_arr_len_body, gc_gen_arr_new_body\\n}\\n\\nimport ./backend_builtins_array_get.vibe {\\n  gc_gen_arr_get_body\\n}\\n\\nimport ./backend_builtins_array_push.vibe {\\n  gc_gen_arr_push_body\\n}\\n\\nimport ./backend_builtins_array_set.vibe {\\n  gc_gen_arr_set_body\\n}\\n\\nimport ./backend_builtins_numeric.vibe {\\n  gc_gen_double_to_int_body, gc_gen_identity_body, gc_gen_int_to_double_body\\n}\\n\\nimport ./backend_builtins_print.vibe {\\n  gc_gen_print_i64_body, gc_gen_print_str_body\\n}\\n\\nimport ./backend_builtins_string.vibe {\\n  gc_gen_str_concat_body, gc_gen_str_eq_body, gc_gen_str_len_body\\n}\\n\\nimport ./backend_builtins_string_extra.vibe {\\n  gc_gen_str_char_code_at_body, gc_gen_str_from_char_code_body, gc_gen_str_substring_body\\n}\\n\\n//# Functions\\n\\n// The storage index of struct field `field`, mirroring the field-access lookup\\n// in backend_expr (search the struct-field-name matrix; first struct that\\n// declares the field wins). A struct lays its fields out like a constructor —\\n// field i at `8 + i*8`, pointer tag-cleared — so the offset is `8 + index*8`,\\n// identical to what `obj.field` reads.\\nfn field_index_in_gc(fnames: Array[String], field: String) -> Int {\\n  let mut fi = 0\\n  let mut found = -1\\n  while fi < Array::length(fnames) {\\n    if Array::get(fnames, fi) == field {\\n      found = fi\\n      fi = Array::length(fnames)\\n    } else {\\n      fi = fi + 1\\n    }\\n  }\\n  found\\n}\\n\\n// The index of `field` WITHIN the struct named `sname`. The matched struct name\\n// MUST drive the lookup: two structs can share a field name at different\\n// positions (`A { x; y }` vs `B { y; x }`), so a name-agnostic scan binds the\\n// wrong offset. Falls back to a global first-match scan only when `sname` is\\n// absent from the table.\\nfn struct_field_index_gc(ctx: CompileCtxGc, sname: String, field: String) -> Int with { Error } {\\n  let names = ctx.gc_ctor_table.struct_names\\n  let mut si = 0\\n  let mut sidx = -1\\n  while si < Array::length(names) {\\n    if Array::get(names, si) == sname {\\n      sidx = si\\n      si = Array::length(names)\\n    } else {\\n      si = si + 1\\n    }\\n  }\\n  if sidx >= 0 {\\n    let found = field_index_in_gc(Array::get(ctx.gc_ctor_table.struct_field_names, sidx), field)\\n    if found < 0 {\\n      throw(String::concat(String::concat(String::concat(\\\"unknown field `\\\", field), \\\"` in struct \\\"), sname))\\n    } else {\\n      found\\n    }\\n  } else {\\n    let mut gsi = 0\\n    let mut gfound = -1\\n    while gsi < Array::length(names) {\\n      let f = field_index_in_gc(Array::get(ctx.gc_ctor_table.struct_field_names, gsi), field)\\n      if f >= 0 {\\n        gfound = f\\n        gsi = Array::length(names)\\n      } else {\\n        gsi = gsi + 1\\n      }\\n    }\\n    if gfound < 0 {\\n      throw(String::concat(\\\"unknown struct field in pattern: \\\", field))\\n    } else {\\n      gfound\\n    }\\n  }\\n}\\n\\n\\n// #538 recursive pattern support. The old cond-arm compiler tested only the\\n// TOP-LEVEL tag and bound only top-level PBind args: a nested ctor pattern\\n// (`Node(Leaf(a), r)`) neither narrowed the match (wrong arm taken) nor bound\\n// its variables (\\\"undefined variable: a\\\"). The helpers below mirror the\\n// linear backend's #705 short-circuit shape: a test leaves exactly one i32 on\\n// the stack, nested payload tests run INSIDE `if (result i32)` blocks guarded\\n// by the parent tag test, and binds recurse through fresh temp locals.\\n\\n// Does `pat` constrain the value at all (vs matching anything)?\\nfn gc_pat_needs_test(p: Pat) -> Bool {\\n  match p {\\n    PBind(_) => false,\\n    PWild => false,\\n    PTuple(ps) => {\\n      let mut any = false\\n      let mut i = 0\\n      while i < Array::length(ps) {\\n        if gc_pat_needs_test(Array::get(ps, i)) {\\n          any = true\\n        }\\n        i = i + 1\\n      }\\n      any\\n    },\\n    PStruct(_, fields) => {\\n      let mut any = false\\n      let mut i = 0\\n      while i < Array::length(fields) {\\n        let (_, sub) = Array::get(fields, i)\\n        if gc_pat_needs_test(sub) {\\n          any = true\\n        }\\n        i = i + 1\\n      }\\n      any\\n    },\\n    _ => true\\n  }\\n}\\n\\n// Does `pat` bind any variables?\\nfn gc_pat_has_binds(p: Pat) -> Bool {\\n  match p {\\n    PBind(_) => true,\\n    PCtor(_, args) => {\\n      let mut any = false\\n      let mut i = 0\\n      while i < Array::length(args) {\\n        if gc_pat_has_binds(Array::get(args, i)) {\\n          any = true\\n        }\\n        i = i + 1\\n      }\\n      any\\n    },\\n    PTuple(ps) => {\\n      let mut any = false\\n      let mut i = 0\\n      while i < Array::length(ps) {\\n        if gc_pat_has_binds(Array::get(ps, i)) {\\n          any = true\\n        }\\n        i = i + 1\\n      }\\n      any\\n    },\\n    PStruct(_, fields) => {\\n      let mut any = false\\n      let mut i = 0\\n      while i < Array::length(fields) {\\n        let (_, sub) = Array::get(fields, i)\\n        if gc_pat_has_binds(sub) {\\n          any = true\\n        }\\n        i = i + 1\\n      }\\n      any\\n    },\\n    POr(l, r) => gc_pat_has_binds(l) || gc_pat_has_binds(r),\\n    _ => false\\n  }\\n}\\n\\n// Load ctor payload `idx` of the tagged ctor value in `vloc` into a fresh\\n// local (ctor layout: value|1 -> [tag@0][argc@4][payload@8+i*8]).\\nfn gc_extract_ctor_payload(buf: Bytes, local_names: Array[String], vloc: Int, idx: Int) -> Int {\\n  let tl = Array::length(local_names)\\n  emit_local_get(buf, vloc)\\n  emit_i64_const(buf, -2)\\n  emit_i64_and(buf)\\n  emit_i32_wrap_i64(buf)\\n  emit_i64_load(buf, 3, 8 + idx * 8)\\n  emit_local_set(buf, tl)\\n  Array::push(local_names, \\\"__pat_tmp\\\")\\n  tl\\n}\\n\\n// Load tuple element `idx` of the untagged tuple pointer in `vloc` (tuple\\n// layout: raw even pointer, elements at i*8, no header).\\nfn gc_extract_tuple_elem(buf: Bytes, local_names: Array[String], vloc: Int, idx: Int) -> Int {\\n  let tl = Array::length(local_names)\\n  emit_local_get(buf, vloc)\\n  emit_i32_wrap_i64(buf)\\n  emit_i64_load(buf, 3, idx * 8)\\n  emit_local_set(buf, tl)\\n  Array::push(local_names, \\\"__pat_tmp\\\")\\n  tl\\n}\\n\\n// Emit the truth test for `pat` against the value in `vloc`: pushes exactly\\n// one i32 (1 = matched). Sub-tests short-circuit behind the parent test via\\n// `if (result i32)` (bytes 4, 127) so payload loads never run on a value of\\n// the wrong shape.\\nfn emit_gc_pat_test(buf: Bytes, local_names: Array[String], vloc: Int, pat: Pat, ctx: CompileCtxGc) -> Unit with { Error } {\\n  match pat {\\n    PInt(n) => {\\n      emit_local_get(buf, vloc)\\n      emit_i64_const(buf, n)\\n      emit_i64_eq(buf)\\n    },\\n    PFloat(fv) => {\\n      // gc lane holds raw f64 bits in i64 locals; f64.eq gives `==` semantics.\\n      emit_local_get(buf, vloc)\\n      emit_f64_reinterpret_i64(buf)\\n      emit_f64_const_lohi(buf, Double::to_i64_bits_lo(fv), Double::to_i64_bits_hi(fv))\\n      emit_f64_eq(buf)\\n    },\\n    PBool(bv) => {\\n      emit_local_get(buf, vloc)\\n      emit_i64_const(buf, if bv {\\n        1\\n      } else {\\n        0\\n      })\\n      emit_i64_eq(buf)\\n    },\\n    PString(sval) => {\\n      let str_idx = str_table_lookup(ctx.str_table.strs, sval)\\n      if str_idx >= 0 {\\n        let (streq_idx, _, _) = resolve_func(ctx.func_table, \\\"String::equals\\\")\\n        emit_local_get(buf, vloc)\\n        emit_str_ref(buf, Array::get(ctx.str_table.offsets, str_idx), Array::get(ctx.str_table.lengths, str_idx))\\n        // A user-shadowed String::equals would need a trailing env; the\\n        // builtin does not (idx < func_offset).\\n        if ctx.func_offset > 0 && streq_idx >= ctx.func_offset {\\n          emit_i64_const(buf, 0)\\n        } else {\\n          ()\\n        }\\n        emit_call(buf, streq_idx)\\n        emit_i64_const(buf, 1)\\n        emit_i64_eq(buf)\\n      } else {\\n        emit_i32_const(buf, 0)\\n      }\\n    },\\n    PBind(_) => emit_i32_const(buf, 1),\\n    PWild => emit_i32_const(buf, 1),\\n    POr(l, r) => {\\n      emit_gc_pat_test(buf, local_names, vloc, l, ctx)\\n      bytebuf_push(buf, 4)\\n      bytebuf_push(buf, 127)\\n      emit_i32_const(buf, 1)\\n      emit_else(buf)\\n      emit_gc_pat_test(buf, local_names, vloc, r, ctx)\\n      emit_end(buf)\\n    },\\n    PCtor(cname, cargs) => {\\n      let ctor_ci = ctor_table_index_of(ctx.gc_ctor_table, cname)\\n      let expected_tag = if ctor_ci >= 0 {\\n        Array::get(ctx.gc_ctor_table.tags, ctor_ci)\\n      } else {\\n        -1\\n      }\\n      emit_local_get(buf, vloc)\\n      emit_i64_const(buf, -2)\\n      emit_i64_and(buf)\\n      emit_i32_wrap_i64(buf)\\n      emit_i32_load(buf, 2, 0)\\n      emit_i32_const(buf, expected_tag)\\n      emit_i32_eq(buf)\\n      let mut any_sub = false\\n      let mut ci = 0\\n      while ci < Array::length(cargs) {\\n        if gc_pat_needs_test(Array::get(cargs, ci)) {\\n          any_sub = true\\n        }\\n        ci = ci + 1\\n      }\\n      if any_sub {\\n        bytebuf_push(buf, 4)\\n        bytebuf_push(buf, 127)\\n        emit_i32_const(buf, 1)\\n        let mut si = 0\\n        while si < Array::length(cargs) {\\n          let sub = Array::get(cargs, si)\\n          if gc_pat_needs_test(sub) {\\n            bytebuf_push(buf, 4)\\n            bytebuf_push(buf, 127)\\n            let tl = gc_extract_ctor_payload(buf, local_names, vloc, si)\\n            emit_gc_pat_test(buf, local_names, tl, sub, ctx)\\n            emit_else(buf)\\n            emit_i32_const(buf, 0)\\n            emit_end(buf)\\n          } else {\\n            ()\\n          }\\n          si = si + 1\\n        }\\n        emit_else(buf)\\n        emit_i32_const(buf, 0)\\n        emit_end(buf)\\n      } else {\\n        ()\\n      }\\n    },\\n    PTuple(ps) => {\\n      emit_i32_const(buf, 1)\\n      let mut ti = 0\\n      while ti < Array::length(ps) {\\n        let sub = Array::get(ps, ti)\\n        if gc_pat_needs_test(sub) {\\n          bytebuf_push(buf, 4)\\n          bytebuf_push(buf, 127)\\n          let tl = gc_extract_tuple_elem(buf, local_names, vloc, ti)\\n          emit_gc_pat_test(buf, local_names, tl, sub, ctx)\\n          emit_else(buf)\\n          emit_i32_const(buf, 0)\\n          emit_end(buf)\\n        } else {\\n          ()\\n        }\\n        ti = ti + 1\\n      }\\n    },\\n    PStruct(sname, fields) => {\\n      emit_i32_const(buf, 1)\\n      let mut fi = 0\\n      while fi < Array::length(fields) {\\n        let (fname, sub) = Array::get(fields, fi)\\n        if gc_pat_needs_test(sub) {\\n          bytebuf_push(buf, 4)\\n          bytebuf_push(buf, 127)\\n          let off_idx = struct_field_index_gc(ctx, sname, fname)\\n          let tl = gc_extract_ctor_payload(buf, local_names, vloc, off_idx)\\n          emit_gc_pat_test(buf, local_names, tl, sub, ctx)\\n          emit_else(buf)\\n          emit_i32_const(buf, 0)\\n          emit_end(buf)\\n        } else {\\n          ()\\n        }\\n        fi = fi + 1\\n      }\\n    }\\n  }\\n}\\n\\n// Bind every variable under `pat` from the value in `vloc` (recursing through\\n// payload extraction). Or-patterns that bind are rejected: the two sides may\\n// bind from different shapes and this backend has no phi for that yet.\\nfn emit_gc_pat_binds(buf: Bytes, local_names: Array[String], vloc: Int, pat: Pat, ctx: CompileCtxGc) -> Unit with { Error } {\\n  match pat {\\n    PBind(name) => {\\n      let bl = Array::length(local_names)\\n      emit_local_get(buf, vloc)\\n      emit_local_set(buf, bl)\\n      Array::push(local_names, name)\\n    },\\n    PCtor(_, cargs) => {\\n      let mut i = 0\\n      while i < Array::length(cargs) {\\n        let sub = Array::get(cargs, i)\\n        if gc_pat_has_binds(sub) {\\n          let tl = gc_extract_ctor_payload(buf, local_names, vloc, i)\\n          emit_gc_pat_binds(buf, local_names, tl, sub, ctx)\\n        } else {\\n          ()\\n        }\\n        i = i + 1\\n      }\\n    },\\n    PTuple(ps) => {\\n      let mut i = 0\\n      while i < Array::length(ps) {\\n        let sub = Array::get(ps, i)\\n        if gc_pat_has_binds(sub) {\\n          let tl = gc_extract_tuple_elem(buf, local_names, vloc, i)\\n          emit_gc_pat_binds(buf, local_names, tl, sub, ctx)\\n        } else {\\n          ()\\n        }\\n        i = i + 1\\n      }\\n    },\\n    PStruct(sname, fields) => {\\n      let mut i = 0\\n      while i < Array::length(fields) {\\n        let (fname, sub) = Array::get(fields, i)\\n        if gc_pat_has_binds(sub) {\\n          let off_idx = struct_field_index_gc(ctx, sname, fname)\\n          let tl = gc_extract_ctor_payload(buf, local_names, vloc, off_idx)\\n          emit_gc_pat_binds(buf, local_names, tl, sub, ctx)\\n        } else {\\n          ()\\n        }\\n        i = i + 1\\n      }\\n    },\\n    POr(l, r) => {\\n      if gc_pat_has_binds(l) || gc_pat_has_binds(r) {\\n        throw(\\\"GC codegen: or-pattern with variable binds is unsupported\\\")\\n      } else {\\n        ()\\n      }\\n    },\\n    _ => ()\\n  }\\n}\\n\\nfn compile_match_gc(buf: Bytes, scrutinee: Expr, arms: Array[(Pat, Expr)], local_names: Array[String], next_local: Int, ctx: CompileCtxGc, ld: Int, ce: (Bytes, Expr, Array[String], Int, Int) -> Int with { Error }) -> Int with { Error } {\\n  let scrut_local = next_local\\n  Array::push(local_names, \\\"__match_scrut\\\")\\n  let nl1 = ce(buf, scrutinee, local_names, next_local + 1, ld)\\n  emit_local_set(buf, scrut_local)\\n  let num_arms = Array::length(arms)\\n  let catchall_idx = find_catchall_idx(arms)\\n  let num_cond_arms = catchall_idx\\n  let mut max_nl = nl1\\n  let mut ai = 0\\n  while ai < num_cond_arms {\\n    let names_len_at_arm = Array::length(local_names)\\n    let (p, arm_body) = Array::get(arms, ai)\\n    let ld_arm = if ld >= 0 {\\n      ld + ai + 1\\n    } else {\\n      -1\\n    }\\n    // Recursive test (nested payload sub-tests narrow the arm correctly)...\\n    emit_gc_pat_test(buf, local_names, scrut_local, p, ctx)\\n    emit_if_i64(buf)\\n    // ...then recursive binds (nested PBinds included).\\n    emit_gc_pat_binds(buf, local_names, scrut_local, p, ctx)\\n    let arm_nl = ce(buf, arm_body, local_names, Array::length(local_names), ld_arm)\\n    if arm_nl > max_nl {\\n      max_nl = arm_nl\\n    }\\n    if Array::length(local_names) > max_nl {\\n      max_nl = Array::length(local_names)\\n    }\\n    emit_else(buf)\\n    Array::truncate(local_names, names_len_at_arm)\\n    agg_log_reset_above(ctx.gc_agg_local_slots, names_len_at_arm)\\n    ai = ai + 1\\n  }\\n  let ld_catch = if ld >= 0 {\\n    ld + num_cond_arms\\n  } else {\\n    -1\\n  }\\n  let _names_len_at_catch = Array::length(local_names)\\n  if catchall_idx < num_arms {\\n    let (cp, cbody) = Array::get(arms, catchall_idx)\\n    // Catch-all arm: recursive binds handle PBind / PCtor / PTuple / PStruct\\n    // uniformly, including nested payload binds (and fix the old tuple-bind\\n    // offset bug: tuples have no header, elements sit at i*8).\\n    emit_gc_pat_binds(buf, local_names, scrut_local, cp, ctx)\\n    let catch_nl = ce(buf, cbody, local_names, Array::length(local_names), ld_catch)\\n    if catch_nl > max_nl {\\n      max_nl = catch_nl\\n    }\\n    0\\n  } else {\\n    bytebuf_push(buf, 0)\\n    0\\n  }\\n  let mut ci2 = 0\\n  while ci2 < num_cond_arms {\\n    emit_end(buf)\\n    ci2 = ci2 + 1\\n  }\\n  while Array::length(local_names) < max_nl {\\n    Array::push(local_names, \\\"\\\")\\n  }\\n  max_nl\\n}\\n\\n//# Misc\\n\\nexport {\\n  compile_match_gc\\n}\\n\")\n}\n\nlet cli_adapter_source_118 = () -> (String, String) {\n  (\"lib/@vibe/compiler/codegen/gc/backend_lambda_ctx.vibe\",\n\"//# Imports\\n\\nimport ../common_base {\\n  CompileCtxGc\\n}\\n\\n//# Functions\\n\\nfn make_lambda_ctx_gc(ctx: CompileCtxGc, ref_cell_names: Array[String], ref_local_indices: Array[Int]) -> CompileCtxGc {\\n  CompileCtxGc::{\\n    func_table: ctx.func_table, str_table: ctx.str_table,\\n    lambda_table: ctx.lambda_table,\\n    num_user_funcs: ctx.num_user_funcs, func_offset: ctx.func_offset,\\n    ref_cell_names: ref_cell_names, ref_local_indices: ref_local_indices,\\n    refcell_type_idx: ctx.refcell_type_idx, closure_type_base: ctx.closure_type_base,\\n    gc_ctor_table: ctx.gc_ctor_table,\\n    gc_const_names: ctx.gc_const_names, gc_const_kinds: ctx.gc_const_kinds,\\n    gc_const_ivals: ctx.gc_const_ivals, gc_const_svals: ctx.gc_const_svals,\\n    gc_global_names: ctx.gc_global_names,\\n    // Fresh per lambda: float tracking is scope-local (captured floats are\\n    // not tracked — best-effort, same as annotated Double params).\\n    gc_float_locals: Array::slice([\\n      \\\"\\\"\\n    ], 0, 0),\\n    gc_agg_local_slots: Array::slice([\\n      0\\n    ], 0, 0),\\n    gc_agg_ret_names: ctx.gc_agg_ret_names,\\n    gc_agg_ret_infos: ctx.gc_agg_ret_infos\\n  }\\n}\\n\\n//# Misc\\n\\nexport {\\n  make_lambda_ctx_gc\\n}\\n\")\n}\n\nlet cli_adapter_source_119 = () -> (String, String) {\n  (\"lib/@vibe/compiler/codegen/gc/backend_lambda_emit.vibe\",\n\"//# Imports\\n\\nimport ../../core {\\n  bytebuf_new\\n}\\n\\nimport ../common_analysis {\\n  emit_i64_extend_i32_u\\n}\\n\\nimport ../common_base {\\n  emit_i64_store, resolve_local\\n}\\n\\nimport ../wasm_emit {\\n  emit_global_get, emit_global_set, emit_heap_memory_grow_check, emit_i32_add, emit_i32_const, emit_i32_store, emit_i32_wrap_i64, emit_i64_const, emit_i64_or, emit_local_get, emit_local_tee\\n}\\n\\n//# Functions\\n\\nfn emit_lambda_closure_gc(buf: Bytes, captures: Array[String], num_captures: Int, local_names: Array[String], next_local: Int, table_slot: Int) -> Int with { Error } {\\n  if num_captures == 0 {\\n    emit_i64_const(buf, (table_slot<<2)|2)\\n    next_local\\n  } else {\\n    let alloc_size = 8 + num_captures * 8\\n    let ptr_local = next_local\\n    let nl2 = next_local + 1\\n    Array::push(local_names, \\\"__closure_ptr\\\")\\n    emit_global_get(buf, 0)\\n    emit_i64_extend_i32_u(buf)\\n    emit_local_tee(buf, ptr_local)\\n    emit_i32_wrap_i64(buf)\\n    emit_i32_const(buf, alloc_size)\\n    emit_i32_add(buf)\\n    emit_global_set(buf, 0)\\n    // #415: gc-lane heap bump must grow linear memory like the linear\\n    // backend does -- without this any allocation past the initial page\\n    // traps OOB (the gc smoke fixture only ever allocated a few bytes).\\n    emit_heap_memory_grow_check(buf)\\n    emit_local_get(buf, ptr_local)\\n    emit_i32_wrap_i64(buf)\\n    emit_i32_const(buf, table_slot)\\n    emit_i32_store(buf, 2, 0)\\n    emit_local_get(buf, ptr_local)\\n    emit_i32_wrap_i64(buf)\\n    emit_i32_const(buf, num_captures)\\n    emit_i32_store(buf, 2, 4)\\n    let mut csi = 0\\n    while csi < num_captures {\\n      let cap_name = Array::get(captures, csi)\\n      let cap_idx = resolve_local(local_names, cap_name, \\\"gc_cap\\\")\\n      emit_local_get(buf, ptr_local)\\n      emit_i32_wrap_i64(buf)\\n      emit_local_get(buf, cap_idx)\\n      emit_i64_store(buf, 3, 8 + csi * 8)\\n      csi = csi + 1\\n    }\\n    emit_local_get(buf, ptr_local)\\n    emit_i64_const(buf, 1)\\n    emit_i64_or(buf)\\n    nl2\\n  }\\n}\\n\\n//# Misc\\n\\nexport {\\n  emit_lambda_closure_gc\\n}\\n\")\n}\n\nlet cli_adapter_source_120 = () -> (String, String) {\n  (\"lib/@vibe/compiler/codegen/gc/backend_lambda_sig.vibe\",\n\"//# Imports\\n\\nimport ../../core {\\n  Expr\\n}\\n\\nimport ../common_base {\\n  CompileCtxGc\\n}\\n\\n//# Types\\n\\nexport type CompileLambdaGcFn = (Bytes, Expr, Array[String], Int, CompileCtxGc, Int) -> Int with { Error }\\n\")\n}\n\nlet cli_adapter_source_121 = () -> (String, String) {\n  (\"lib/@vibe/compiler/codegen/gc/backend_lambda_body.vibe\",\n\"//# Imports\\n\\nimport ../../core {\\n  Expr, TypeExpr\\n}\\n\\nimport ../common_base {\\n  CompileCtxGc\\n}\\n\\nimport ./backend_lambda_collect.vibe {\\n  collect_lambda_captures_gc\\n}\\n\\nimport ./backend_lambda_emit.vibe {\\n  emit_lambda_closure_gc\\n}\\n\\nimport ./backend_lambda_inner.vibe {\\n  compile_lambda_inner_gc\\n}\\n\\nimport ./backend_lambda_record.vibe {\\n  record_lambda_meta_gc\\n}\\n\\nimport ./backend_lambda_sig.vibe {\\n  CompileLambdaGcFn\\n}\\n\\n//# Functions\\n\\nexport fn compile_lambda_gc(buf: Bytes, params: Array[(String, Option[TypeExpr])], fn_body: Expr, local_names: Array[String], next_local: Int, ctx: CompileCtxGc, ld: Int, compile_fn: CompileLambdaGcFn) -> Int with { Error } {\\n  let (captures, num_captures, user_params) = collect_lambda_captures_gc(params, fn_body, ctx)\\n  let (lam_buf, final_lam_nl) = compile_lambda_inner_gc(params, fn_body, captures, user_params, ctx, compile_fn, ld)\\n  let lambda_idx = record_lambda_meta_gc(ctx, lam_buf, user_params, captures, final_lam_nl)\\n  let table_slot = ctx.num_user_funcs + lambda_idx\\n  emit_lambda_closure_gc(buf, captures, num_captures, local_names, next_local, table_slot)\\n}\\n\")\n}\n\nlet cli_adapter_source_122 = () -> (String, String) {\n  (\"lib/@vibe/compiler/codegen/gc/backend_lambda_collect.vibe\",\n\"//# Imports\\n\\nimport ../../core {\\n  Expr, TypeExpr\\n}\\n\\nimport ../common_analysis {\\n  collect_free_vars\\n}\\n\\nimport ../common_base {\\n  CompileCtxGc, CtorTable, FuncTable\\n}\\n\\n//# Functions\\n\\nexport fn collect_lambda_captures_gc(params: Array[(String, Option[TypeExpr])], fn_body: Expr, ctx: CompileCtxGc) -> (Array[String], Int, Int) {\\n  let param_names_arr = Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n  let func_table = ctx.func_table\\n  let ctor_table = ctx.gc_ctor_table\\n  let mut pi = 0\\n  while pi < Array::length(params) {\\n    let (pname, _) = Array::get(params, pi)\\n    Array::push(param_names_arr, pname)\\n    pi = pi + 1\\n  }\\n  let mut globals = Array::concat(func_table.names, ctor_table.names)\\n  // #538: names that resolve globally must not be captured as env slots --\\n  // module-level literal constants and the call-site-only desugar builtins\\n  // (handled by name in compile_call_gc, absent from the func table).\\n  globals = Array::concat(globals, ctx.gc_const_names)\\n  globals = Array::concat(globals, ctx.gc_global_names)\\n  globals = Array::concat(globals, [\\n    \\\"__index\\\",\\n    \\\"__len\\\",\\n    \\\"__set_field\\\",\\n    \\\"__set_index\\\",\\n    \\\"__slice\\\",\\n    \\\"__rec_field\\\"\\n  ])\\n  let captures = collect_free_vars(fn_body, param_names_arr, globals)\\n  let num_captures = Array::length(captures)\\n  let user_params = Array::length(params)\\n  (captures, num_captures, user_params)\\n}\\n\")\n}\n\nlet cli_adapter_source_123 = () -> (String, String) {\n  (\"lib/@vibe/compiler/codegen/gc/backend_lambda_inner.vibe\",\n\"//# Imports\\n\\nimport ../../core {\\n  Expr, TypeExpr, bytebuf_new\\n}\\n\\nimport ../common_base {\\n  CompileCtxGc, emit_i64_load\\n}\\n\\nimport ../common_extractors {\\n  array_contains_str\\n}\\n\\nimport ../wasm_emit {\\n  emit_i32_wrap_i64, emit_local_get, emit_local_set\\n}\\n\\nimport ./backend_lambda_ctx.vibe {\\n  make_lambda_ctx_gc\\n}\\n\\nimport ./backend_lambda_sig.vibe {\\n  CompileLambdaGcFn\\n}\\n\\n//# Functions\\n\\nexport fn compile_lambda_inner_gc(params: Array[(String, Option[TypeExpr])], fn_body: Expr, captures: Array[String], user_params: Int, ctx: CompileCtxGc, compile_fn: CompileLambdaGcFn, ld: Int) -> (Bytes, Int) with { Error } {\\n  let lam_buf = bytebuf_new()\\n  let lam_locals = Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n  let mut lpi = 0\\n  while lpi < user_params {\\n    let (lpname, _) = Array::get(params, lpi)\\n    Array::push(lam_locals, lpname)\\n    lpi = lpi + 1\\n  }\\n  Array::push(lam_locals, \\\"__env\\\")\\n  let env_param_idx = user_params\\n  let lam_nl_start = user_params + 1\\n  let lam_ref_cells = Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n  let lam_ref_local_indices = Array::slice([\\n    0\\n  ], 0, 0)\\n  let num_captures = Array::length(captures)\\n  let mut ci3 = 0\\n  let mut lam_nl = lam_nl_start\\n  while ci3 < num_captures {\\n    let cap_local = lam_nl\\n    let cap_name = Array::get(captures, ci3)\\n    emit_local_get(lam_buf, env_param_idx)\\n    emit_i32_wrap_i64(lam_buf)\\n    emit_i64_load(lam_buf, 3, 8 + ci3 * 8)\\n    emit_local_set(lam_buf, cap_local)\\n    Array::push(lam_locals, cap_name)\\n    if array_contains_str(ctx.ref_cell_names, cap_name) {\\n      Array::push(lam_ref_cells, cap_name)\\n    }\\n    lam_nl = lam_nl + 1\\n    ci3 = ci3 + 1\\n  }\\n  let lam_ctx = make_lambda_ctx_gc(ctx, lam_ref_cells, lam_ref_local_indices)\\n  // #744 (gc mirror of the linear lam_float_slots seeding): annotated\\n  // Float/Double params join the fresh scope's float tracking, so closure\\n  // bodies get real f64 arithmetic/comparisons and the Double __to_string\\n  // formatter instead of raw-bits integer ops.\\n  let mut lfs_i = 0\\n  while lfs_i < user_params {\\n    let (lfs_name, lfs_ann) = Array::get(params, lfs_i)\\n    match lfs_ann {\\n      Some(lfs_ty) => match lfs_ty {\\n        TyName(lfs_tn) => if lfs_tn == \\\"Float\\\" || lfs_tn == \\\"Double\\\" {\\n          Array::push(lam_ctx.gc_float_locals, lfs_name)\\n        } else {\\n          ()\\n        },\\n        _ => ()\\n      },\\n      None => ()\\n    }\\n    lfs_i = lfs_i + 1\\n  }\\n  let final_lam_nl = compile_fn(lam_buf, fn_body, lam_locals, lam_nl, lam_ctx, ld)\\n  (lam_buf, final_lam_nl)\\n}\\n\")\n}\n\nlet cli_adapter_source_124 = () -> (String, String) {\n  (\"lib/@vibe/compiler/codegen/gc/backend_lambda_record.vibe\",\n\"//# Imports\\n\\nimport ../common_base {\\n  CompileCtxGc, LambdaTable\\n}\\n\\n//# Functions\\n\\nexport fn record_lambda_meta_gc(ctx: CompileCtxGc, lam_buf: Bytes, user_params: Int, captures: Array[String], final_lam_nl: Int) -> Int {\\n  let lambda_table = ctx.lambda_table\\n  let lambda_idx = Array::length(lambda_table.bodies)\\n  Array::push(lambda_table.bodies, lam_buf)\\n  Array::push(lambda_table.param_counts, user_params + 1)\\n  Array::push(lambda_table.captures, captures)\\n  let mut extra_lam = 0\\n  let min_lam_nl = user_params + 1\\n  if final_lam_nl > min_lam_nl {\\n    extra_lam = final_lam_nl - min_lam_nl\\n  }\\n  Array::push(lambda_table.meta_i32, 0)\\n  Array::push(lambda_table.meta_i64, extra_lam)\\n  lambda_idx\\n}\\n\")\n}\n\nlet cli_adapter_source_125 = () -> (String, String) {\n  (\"lib/@vibe/compiler/codegen/index.vibe\",\n\"//# Imports\\n\\nimport ../core/index.vibe {\\n  Stmt\\n}\\n\\nimport ./common_base/index.vibe {\\n  DbgProv\\n}\\n\\nimport ./expr/index.vibe {\\n  compile_module_expr\\n}\\n\\nimport ./wasi/index.vibe {\\n  compile_wasi_module_impl,\\n  compile_wasi_module_coverage_impl,\\n  compile_wasi_module_trace_impl,\\n  compile_wasi_module_break_impl,\\n  compile_wasi_module_with_sources_impl,\\n  compile_wasi_module_rc_impl,\\n  compile_wasi_module_rc_shadow_impl\\n}\\n\\n// #847 Phase C: facade re-export so external callers reach builtin_registry.vibe\\n// only through codegen/index.vibe, not the internal file directly.\\nexport ./builtin_registry.vibe {\\n  lookup_registry_builtin, builtin_registry, verify_lane_builtins\\n}\\n\\n//# Functions\\n\\nexport fn compile_module(stmts: Array[Stmt]) -> Bytes with { Error } {\\n  compile_module_expr(stmts)\\n}\\n\\nexport fn compile_wasi_module_with_sources(stmts: Array[Stmt], entry_name: String, selfhost_srcs: Array[(String, String)]) -> Bytes with { Error } {\\n  compile_wasi_module_with_sources_impl(stmts, entry_name, selfhost_srcs)\\n}\\n\\nexport fn compile_wasi_module(stmts: Array[Stmt], entry_name: String) -> Bytes with { Error } {\\n  compile_wasi_module_impl(stmts, entry_name)\\n}\\n\\n// #701 RC variant: the Perceus RC codegen path (enable_rc) for the FS-compile\\n// entry, so `vibe run`/import-resolving programs honor VIBE_RC instead of\\n// silently using the bump path. Same merged stmts as compile_wasi_module.\\nexport fn compile_wasi_module_rc(stmts: Array[Stmt], entry_name: String) -> Bytes with { Error } {\\n  compile_wasi_module_rc_impl(stmts, entry_name)\\n}\\n\\n// #715/#768 debug variant: RC codegen + shadow-liveness double-free traps\\n// (VIBE_RC=shadow) for the FS-compile entry, so import-resolving test builds\\n// can be shadow-instrumented too -- previously only the single-source path\\n// (compile_source_wasi_only_rc_shadow) supported shadow, so `vibe test`-shaped\\n// heap corruption could not be pinned to its first bad free.\\nexport fn compile_wasi_module_rc_shadow(stmts: Array[Stmt], entry_name: String) -> Bytes with { Error } {\\n  compile_wasi_module_rc_shadow_impl(stmts, entry_name)\\n}\\n\\n// Coverage variant (#cov): function-level hit instrumentation + `vibe_cov`\\n// custom section. Used by the coverage self-compile entry.\\nexport fn compile_wasi_module_coverage(stmts: Array[Stmt], entry_name: String) -> Bytes with { Error } {\\n  compile_wasi_module_coverage_impl(stmts, entry_name)\\n}\\n\\n// Trace variant (debugger / DAP P1 groundwork): function-call execution-trace\\n// instrumentation + `vibe.trace` custom section. Used by the FS-compile trace\\n// entry under VIBE_DEBUG=1.\\nexport fn compile_wasi_module_trace(stmts: Array[Stmt], entry_name: String) -> Bytes with { Error } {\\n  compile_wasi_module_trace_impl(stmts, entry_name)\\n}\\n\\n// Break variant (debugger / DAP P1): `vibe::dbg_break` host-hook instrumentation\\n// at each user function entry. Used by the FS-compile break entry under\\n// VIBE_DEBUG_BREAK=1.\\nexport fn compile_wasi_module_break(stmts: Array[Stmt], entry_name: String, prov: DbgProv) -> Bytes with { Error } {\\n  compile_wasi_module_break_impl(stmts, entry_name, prov)\\n}\\n\\n// (A second, identical `compile_wasi_module_rc` definition used to live here —\\n// the flat bundle's first-match tolerated it; the #726 merge flatten surfaced\\n// it as the last remaining duplicate top-level def.)\\n\")\n}\n\nlet cli_adapter_source_126 = () -> (String, String) {\n  (\"lib/@vibe/compiler/runtime/eval_loader/index.vibe\",\n\"//# Imports\\n\\nimport ../../syntax {\\n  lex, parse_program, parse\\n}\\n\\nimport ../../core/index.vibe {\\n  Expr, Pat, Stmt, TypeExpr\\n}\\n\\n//# Functions\\n\\nfn resolve_interp_expr(expr: Expr) -> Expr with { Error } {\\n  match expr {\\n    EStringInterp(parts) => {\\n      let plen = Array::length(parts)\\n      let exprs = ArrayBuilder::new()\\n      let mut i = 0\\n      while i < plen {\\n        let lit = Array::get(parts, i)\\n        if String::length(lit) > 0 {\\n          ArrayBuilder::push(exprs, EString(lit))\\n        }\\n        if i + 1 < plen {\\n          let expr_src = Array::get(parts, i + 1)\\n          let resolved = resolve_interp_expr(parse(lex(expr_src)))\\n          ArrayBuilder::push(exprs, ECall(EIdent(\\\"__to_string\\\", -1), [\\n            resolved\\n          ], -1))\\n        }\\n        i = i + 2\\n      }\\n      let out = ArrayBuilder::freeze(exprs)\\n      let len = Array::length(out)\\n      if len == 0 {\\n        EString(\\\"\\\")\\n      }\\n      else {\\n        let mut acc = Array::get(out, 0)\\n        let mut j = 1\\n        while j < len {\\n          acc = ECall(EIdent(\\\"String::concat\\\", -1), [\\n            acc,\\n            Array::get(out, j)\\n          ], -1)\\n          j = j + 1\\n        }\\n        acc\\n      }\\n    },\\n    EInt(_) => expr,\\n    EFloat(_) => expr,\\n    EString(_) => expr,\\n    EBool(_) => expr,\\n    EUnit => expr,\\n    EIdent(_, _) => expr,\\n    ETuple(elems) => ETuple(for elem in elems {\\n      resolve_interp_expr(elem)\\n    }),\\n    EArray(elems) => EArray(for elem in elems {\\n      resolve_interp_expr(elem)\\n    }),\\n    ERecord(rn, fields, targs) => ERecord(rn, for field in fields { let (name, value) = field; (name, resolve_interp_expr(value)) }, targs),\\n    EMap(fields) => EMap(for field in fields { let (name, value) = field; (name, resolve_interp_expr(value)) }),\\n    EIf(cond, then_expr, else_expr) => EIf(resolve_interp_expr(cond), resolve_interp_expr(then_expr), resolve_interp_expr(else_expr)),\\n    ELet(name, value, body, soff) => ELet(name, resolve_interp_expr(value), resolve_interp_expr(body), soff),\\n    ELetRec(name, value, body) => ELetRec(name, resolve_interp_expr(value), resolve_interp_expr(body)),\\n    ELetMut(name, value, body, soff) => ELetMut(name, resolve_interp_expr(value), resolve_interp_expr(body), soff),\\n    EAssign(name, value, body) => EAssign(name, resolve_interp_expr(value), resolve_interp_expr(body)),\\n    EAssignOp(name, op, value, body) => EAssignOp(name, op, resolve_interp_expr(value), resolve_interp_expr(body)),\\n    ESeq(left, right) => ESeq(resolve_interp_expr(left), resolve_interp_expr(right)),\\n    EMatch(scrutinee, arms) => EMatch(resolve_interp_expr(scrutinee), for arm in arms { let (pat, body) = arm; (pat, resolve_interp_expr(body)) }),\\n    EHandle(scrutinee, arms) => EHandle(resolve_interp_expr(scrutinee), for arm in arms { let (pat, body) = arm; (pat, resolve_interp_expr(body)) }),\\n    EWhile(cond, body) => EWhile(resolve_interp_expr(cond), resolve_interp_expr(body)),\\n    ELoop(params, body) => ELoop(for param in params { let (name, init) = param; (name, resolve_interp_expr(init)) }, resolve_interp_expr(body)),\\n    EForIn(name, index_name, iter, body) => EForIn(name, index_name, resolve_interp_expr(iter), resolve_interp_expr(body)),\\n    ECall(callee, args, off) => ECall(resolve_interp_expr(callee), for arg in args {\\n      resolve_interp_expr(arg)\\n    }, off),\\n    EBinOp(op, left, right) => EBinOp(op, resolve_interp_expr(left), resolve_interp_expr(right)),\\n    EUnaryOp(op, inner) => EUnaryOp(op, resolve_interp_expr(inner)),\\n    EFn(type_params, bounds, params, ret_ty, effect, body) => EFn(type_params, bounds, params, ret_ty, effect, resolve_interp_expr(body)),\\n    EDot(inner, field, off, fdoff) => EDot(resolve_interp_expr(inner), field, off, fdoff),\\n    EReturn(inner) => EReturn(resolve_interp_expr(inner)),\\n    EBreak(opt) => match opt {\\n      None => expr,\\n      Some(value) => EBreak(Some(resolve_interp_expr(value)))\\n    },\\n    EContinue(args) => EContinue(for arg in args {\\n      resolve_interp_expr(arg)\\n    }),\\n    ELabeledArg(label, name, value) => ELabeledArg(label, name, resolve_interp_expr(value)),\\n    ESpread(inner) => ESpread(resolve_interp_expr(inner))\\n  }\\n}\\n\\nfn resolve_interp_stmt(stmt: Stmt) -> Stmt with { Error } {\\n  match stmt {\\n    SLet(exported, is_rec, name, ty, value) => SLet(exported, is_rec, name, ty, resolve_interp_expr(value)),\\n    SLetMut(name, ty, value) => SLetMut(name, ty, resolve_interp_expr(value)),\\n    STest(name, body) => STest(name, resolve_interp_expr(body)),\\n    SBench(name, body) => SBench(name, resolve_interp_expr(body)),\\n    SExpr(expr) => SExpr(resolve_interp_expr(expr)),\\n    _ => stmt\\n  }\\n}\\n\\nexport fn contains_str(arr: Array[String], target: String) -> Bool {\\n  let rec go: (Int) -> Bool = (i) -> {\\n    if i >= Array::length(arr) {\\n      false\\n    }\\n    else {\\n      if Array::get(arr, i) == target {\\n        true\\n      }\\n      else {\\n        go(i + 1)\\n      }\\n    }\\n  }\\n  go(0)\\n}\\n\\nexport fn source_lookup(sources: Array[(String, String)], path_key: String) -> Option[String] {\\n  let rec go: (Int) -> Option[String] = (i) -> {\\n    if i >= Array::length(sources) {\\n      None\\n    }\\n    else {\\n      let (p, src) = Array::get(sources, i)\\n      if p == path_key {\\n        Some(src)\\n      }\\n      else {\\n        go(i + 1)\\n      }\\n    }\\n  }\\n  go(0)\\n}\\n\\nexport fn load_and_parse(source: String) -> Array[Stmt] with { Error } {\\n  let tokens = lex(source)\\n  for stmt in parse_program(tokens) {\\n    resolve_interp_stmt(stmt)\\n  }\\n}\\n\\nexport fn collect_exports(stmts: Array[Stmt]) -> Array[String] {\\n  // Out-param accumulation: each match arm pushes directly into `out`.\\n  // Previously each `Array::concat(acc, [x])` allocated and copied the\\n  // entire growing prefix — total O(N^2) for N exports across the file.\\n  let out = Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n  let mut i = 0\\n  while i < Array::length(stmts) {\\n    match Array::get(stmts, i) {\\n      SLet(true, _, name, _, _) => Array::push(out, name),\\n      SEnum(true, _, _, variants, _) => {\\n        let mut j = 0\\n        while j < Array::length(variants) {\\n          let (cname, _) = Array::get(variants, j)\\n          Array::push(out, cname)\\n          j = j + 1\\n        }\\n      },\\n      SExport(names) => {\\n        let mut j = 0\\n        while j < Array::length(names) {\\n          Array::push(out, Array::get(names, j))\\n          j = j + 1\\n        }\\n      },\\n      SReExport(_, names) => {\\n        let mut j = 0\\n        while j < Array::length(names) {\\n          let (name, _) = Array::get(names, j)\\n          Array::push(out, name)\\n          j = j + 1\\n        }\\n      },\\n      _ => ()\\n    }\\n    i = i + 1\\n  }\\n  out\\n}\\n\")\n}\n\nlet cli_adapter_source_127 = () -> (String, String) {\n  (\"lib/@vibe/graph/index.vpkg\",\n\"version 0.0.1\\n\\n// @vibe/graph — the selfhost compiler's incremental module DB (ADR-0070\\n// Phase 3, #897): maps module path -> source, path -> fingerprint, path ->\\n// dependency list, plus an eval counter, as one fixed-bucket hash-map-backed\\n// linear value (callers must thread the returned db, not reuse a stale one\\n// -- see graph.vibe's header comment). `RippleDb` is declared `opaque`: no\\n// consumer (in-repo, including the compiler's own runtime/index.vibe,\\n// confirmed via repo-wide grep) ever constructs or pattern-matches it\\n// directly, only through ripple_new/ripple_get_*/ripple_set_source/\\n// ripple_record_eval. `StrMap`/`DepsMap` (graph.vibe's internal bucket-map\\n// representation, used only inside RippleDb's own variant payload) are\\n// likewise never referenced outside graph.vibe -- but `check_contract`\\n// still requires every exported type declared regardless of external\\n// usage (same rule as fns; confirmed by a real conformance-check failure\\n// when they were first left undeclared), so they're declared `opaque`\\n// here too. `version` was `export let\\n// version = \\\"0.0.1\\\"` directly in the old index.vibe facade -- a real\\n// importable binding, not just contract metadata -- so it is preserved\\n// verbatim as an implementation-file value (graph.vibe) with a matching\\n// bodyless declaration here (Codex review precedent, PR #914).\\n\\nimport ./graph.vibe {}\\n\\nlet version: String\\n\\nopaque type StrMap\\nopaque type DepsMap\\nopaque type RippleDb\\n\\nfn ripple_new() -> RippleDb\\nfn ripple_set_source(db: RippleDb, path: String, source: String) -> RippleDb\\nfn ripple_get_source(db: RippleDb, path: String) -> Option[String]\\nfn ripple_get_fingerprint(db: RippleDb, path: String) -> Option[String]\\nfn ripple_get_deps(db: RippleDb, path: String) -> Option[Array[String]]\\nfn ripple_record_eval(db: RippleDb, path: String, fingerprint: String, deps: Array[String]) -> RippleDb\\nfn ripple_eval_count(db: RippleDb) -> Int\\n\")\n}\n\nlet cli_adapter_source_128 = () -> (String, String) {\n  (\"lib/@vibe/graph/graph.vibe\",\n\"//# Types\\n\\n// RippleDb is the selfhost compiler's incremental module DB: it maps module\\n// path -> source, path -> fingerprint, and path -> dependency list.\\n//\\n// Previously each map was a flat association array (`Array[(String, _)]`):\\n// every lookup was O(n) and every upsert rebuilt the whole array O(n), so\\n// threading the DB through N modules was O(N^2) time AND allocations (matching\\n// the alloc-bound compile profile from moon-pprof). This replaces them with\\n// fixed-bucket hash maps: hash the path to one of NBUCKETS buckets and scan\\n// only that (small) bucket. Lookup/insert are O(1) amortized, so a full\\n// N-module compile is O(N).\\n//\\n// The maps mutate their buckets in place, so the DB is *linear*: callers must\\n// use the returned db and discard the old one. The selfhost compiler always\\n// threads `next_db`, so this is safe. eval_count lives in a 1-element array so\\n// it is bumped without rebuilding the enum payload.\\n\\n//# Values\\n\\n// #897 (ADR-0070 Phase 3): preserved from the old index.vibe facade, which\\n// defined `export let version = \\\"0.0.1\\\"` directly (a real importable\\n// binding, not just contract metadata) — Codex review precedent from PR\\n// #914.\\nexport let version: String = \\\"0.0.1\\\"\\n\\n//# Types\\n\\nexport enum StrMap {\\n  StrMap(Array[Array[(String, String)]])\\n}\\n\\nexport enum DepsMap {\\n  DepsMap(Array[Array[(String, Array[String])]])\\n}\\n\\nexport enum RippleDb {\\n  RippleDb(StrMap, StrMap, DepsMap, Array[Int])\\n}\\n\\n//# Functions\\n\\nfn nbuckets() -> Int {\\n  256\\n}\\n\\nfn bucket_mask() -> Int {\\n  255\\n}\\n\\n// FNV-1a-style string hash, masked to a non-negative bucket index. NBUCKETS is\\n// a power of two so we mask with `& 255` instead of `%`. Intermediate values\\n// are kept within 30 bits so the multiply stays well under the 2^61 tag limit.\\nfn hash_bucket(key: String) -> Int {\\n  let len = String::length(key)\\n  let rec go: (Int, Int) -> Int = (i, acc) -> {\\n    if i >= len {\\n      acc\\n    } else {\\n      let c = String::char_code_at(key, i)\\n      let mixed = (acc ^ c) * 16777619\\n      let bounded = mixed & 1073741823\\n      go(i + 1, bounded)\\n    }\\n  }\\n  let h = go(0, 2166136261 & 1073741823)\\n  h & bucket_mask()\\n}\\n\\nfn empty_strings() -> Array[String] {\\n  Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n}\\n\\nfn empty_string_pairs() -> Array[(String, String)] {\\n  Array::slice([\\n    (\\\"\\\", \\\"\\\")\\n  ], 0, 0)\\n}\\n\\nfn empty_deps_pairs() -> Array[(String, Array[String])] {\\n  Array::slice([\\n    (\\\"\\\", empty_strings())\\n  ], 0, 0)\\n}\\n\\n// Build a bucket array of NBUCKETS DISTINCT empty assoc arrays. (Array::make\\n// would alias one array across every slot, so push fresh empties instead.)\\nfn new_string_buckets() -> Array[Array[(String, String)]] {\\n  let n = nbuckets()\\n  let b = ArrayBuilder::new()\\n  let rec go: (Int) -> Unit = (i) -> {\\n    if i >= n {\\n      ()\\n    } else {\\n      ArrayBuilder::push(b, empty_string_pairs())\\n      go(i + 1)\\n    }\\n  }\\n  go(0)\\n  ArrayBuilder::freeze(b)\\n}\\n\\nfn new_deps_buckets() -> Array[Array[(String, Array[String])]] {\\n  let n = nbuckets()\\n  let b = ArrayBuilder::new()\\n  let rec go: (Int) -> Unit = (i) -> {\\n    if i >= n {\\n      ()\\n    } else {\\n      ArrayBuilder::push(b, empty_deps_pairs())\\n      go(i + 1)\\n    }\\n  }\\n  go(0)\\n  ArrayBuilder::freeze(b)\\n}\\n\\nfn strmap_new() -> StrMap {\\n  StrMap(new_string_buckets())\\n}\\n\\nfn assoc_get_string(bucket: Array[(String, String)], key: String, i: Int) -> Option[String] {\\n  if i >= Array::length(bucket) {\\n    None\\n  } else {\\n    let (k, v) = Array::get(bucket, i)\\n    if k == key {\\n      Some(v)\\n    } else {\\n      assoc_get_string(bucket, key, i + 1)\\n    }\\n  }\\n}\\n\\nfn strmap_get(m: StrMap, key: String) -> Option[String] {\\n  match m {\\n    StrMap(buckets) => {\\n      let idx = hash_bucket(key)\\n      let bucket = Array::get(buckets, idx)\\n      assoc_get_string(bucket, key, 0)\\n    }\\n  }\\n}\\n\\n// In-place upsert into the bucket for `key`.\\nfn strmap_set(m: StrMap, key: String, value: String) -> Unit {\\n  match m {\\n    StrMap(buckets) => {\\n      let idx = hash_bucket(key)\\n      let bucket = Array::get(buckets, idx)\\n      let len = Array::length(bucket)\\n      let rec go: (Int) -> Unit = (i) -> {\\n        if i >= len {\\n          Array::push(bucket, (key, value))\\n        } else {\\n          let (k, _) = Array::get(bucket, i)\\n          if k == key {\\n            Array::set(bucket, i, (key, value))\\n          } else {\\n            go(i + 1)\\n          }\\n        }\\n      }\\n      go(0)\\n    }\\n  }\\n}\\n\\nfn depsmap_new() -> DepsMap {\\n  DepsMap(new_deps_buckets())\\n}\\n\\nfn assoc_get_deps(bucket: Array[(String, Array[String])], key: String, i: Int) -> Option[Array[String]] {\\n  if i >= Array::length(bucket) {\\n    None\\n  } else {\\n    let (k, v) = Array::get(bucket, i)\\n    if k == key {\\n      Some(v)\\n    } else {\\n      assoc_get_deps(bucket, key, i + 1)\\n    }\\n  }\\n}\\n\\nfn depsmap_get(m: DepsMap, key: String) -> Option[Array[String]] {\\n  match m {\\n    DepsMap(buckets) => {\\n      let idx = hash_bucket(key)\\n      let bucket = Array::get(buckets, idx)\\n      assoc_get_deps(bucket, key, 0)\\n    }\\n  }\\n}\\n\\nfn depsmap_set(m: DepsMap, key: String, deps: Array[String]) -> Unit {\\n  match m {\\n    DepsMap(buckets) => {\\n      let idx = hash_bucket(key)\\n      let bucket = Array::get(buckets, idx)\\n      let len = Array::length(bucket)\\n      let rec go: (Int) -> Unit = (i) -> {\\n        if i >= len {\\n          Array::push(bucket, (key, deps))\\n        } else {\\n          let (k, _) = Array::get(bucket, i)\\n          if k == key {\\n            Array::set(bucket, i, (key, deps))\\n          } else {\\n            go(i + 1)\\n          }\\n        }\\n      }\\n      go(0)\\n    }\\n  }\\n}\\n\\nexport fn ripple_new() -> RippleDb {\\n  let count = ArrayBuilder::new()\\n  ArrayBuilder::push(count, 0)\\n  RippleDb(strmap_new(), strmap_new(), depsmap_new(), ArrayBuilder::freeze(count))\\n}\\n\\nexport fn ripple_get_source(db: RippleDb, path: String) -> Option[String] {\\n  match db {\\n    RippleDb(sources, _, _, _) => strmap_get(sources, path)\\n  }\\n}\\n\\nexport fn ripple_get_fingerprint(db: RippleDb, path: String) -> Option[String] {\\n  match db {\\n    RippleDb(_, fingerprints, _, _) => strmap_get(fingerprints, path)\\n  }\\n}\\n\\nexport fn ripple_get_deps(db: RippleDb, path: String) -> Option[Array[String]] {\\n  match db {\\n    RippleDb(_, _, deps_map, _) => depsmap_get(deps_map, path)\\n  }\\n}\\n\\nexport fn ripple_eval_count(db: RippleDb) -> Int {\\n  match db {\\n    RippleDb(_, _, _, count) => Array::get(count, 0)\\n  }\\n}\\n\\nexport fn ripple_set_source(db: RippleDb, path: String, source: String) -> RippleDb {\\n  match db {\\n    RippleDb(sources, _, _, _) => {\\n      strmap_set(sources, path, source)\\n      db\\n    }\\n  }\\n}\\n\\nexport fn ripple_record_eval(db: RippleDb, path: String, fingerprint: String, deps: Array[String]) -> RippleDb {\\n  match db {\\n    RippleDb(_, fingerprints, deps_map, count) => match strmap_get(fingerprints, path) {\\n      Some(prev_fp) => if prev_fp == fingerprint {\\n        db\\n      } else {\\n        strmap_set(fingerprints, path, fingerprint)\\n        depsmap_set(deps_map, path, deps)\\n        Array::set(count, 0, Array::get(count, 0) + 1)\\n        db\\n      },\\n      None => {\\n        strmap_set(fingerprints, path, fingerprint)\\n        depsmap_set(deps_map, path, deps)\\n        Array::set(count, 0, Array::get(count, 0) + 1)\\n        db\\n      }\\n    }\\n  }\\n}\\n\")\n}\n\nlet cli_adapter_source_129 = () -> (String, String) {\n  (\"lib/@vibe/compiler/runtime/typecheck_fs.vibe\",\n\"//# Imports\\n\\nimport ../cache/persistent_cache.vibe {\\n  compact_string_fingerprint, normalize_persistent_cache_text, persistent_dep_list_cache_path, persistent_leaf_fingerprint_cache_path, persistent_type_env_cache_path\\n}\\n\\nimport ../checker/index.vibe {\\n  check_program, check_program_with_env\\n}\\n\\nimport ../core {\\n  Stmt, Type, TypeEnv, env_bind, env_flat_bindings, env_lookup_flat\\n}\\n\\nimport ../module_graph_path.vibe {\\n  dir_of_path, resolve_import_path, resolve_import_path_candidates\\n}\\n\\nimport ../loader {\\n  load_or_parse_module_header_fs\\n}\\n\\nimport ../../../../lib/@vibe/graph {\\n  RippleDb, ripple_get_deps, ripple_get_fingerprint, ripple_get_source, ripple_record_eval\\n}\\n\\nimport ../syntax {\\n  lex_with_offsets, lex_with_offsets_recovering, parse_program_located, parse_program_recovering, offset_to_line_col\\n}\\n\\nimport ./eval_loader {\\n  contains_str\\n}\\n\\nexport ./persistent_env_codec.vibe {\\n  load_persistent_dep_list, load_persistent_leaf_fingerprint, load_persistent_type_env, persistent_dep_list_text, persistent_leaf_fingerprint_text, persistent_type_env_cache_text\\n}\\n\\n//# Functions\\n\\nfn empty_stack() -> Array[String] {\\n  Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n}\\n\\nfn empty_dep_fps() -> Array[(String, String)] {\\n  Array::slice([\\n    (\\\"\\\", \\\"\\\")\\n  ], 0, 0)\\n}\\n\\nfn lookup_env_cache(cache: Array[(String, TypeEnv)], path: String) -> Option[TypeEnv] {\\n  let len = Array::length(cache)\\n  let mut i = 0\\n  let mut result = None\\n  let mut done = false\\n  while !done {\\n    if i >= len {\\n      done = true\\n    } else {\\n      let (p, env) = Array::get(cache, i)\\n      if p == path {\\n        result = Some(env)\\n        done = true\\n      } else {\\n        i = i + 1\\n      }\\n    }\\n  }\\n  result\\n}\\n\\nfn resolve_cached_import_path(base_dir: String, raw_path: String, cache: Array[(String, TypeEnv)]) -> String {\\n  let candidates = resolve_import_path_candidates(base_dir, raw_path)\\n  let mut selected = \\\"\\\"\\n  let mut i = 0\\n  while i < Array::length(candidates) && selected == \\\"\\\" {\\n    let candidate = Array::get(candidates, i)\\n    match lookup_env_cache(cache, candidate) {\\n      Some(_) => {\\n        selected = candidate\\n      },\\n      None => ()\\n    }\\n    i = i + 1\\n  }\\n  if selected == \\\"\\\" {\\n    resolve_import_path(base_dir, raw_path)\\n  } else {\\n    selected\\n  }\\n}\\n\\nfn starts_with_upper(name: String) -> Bool {\\n  if String::length(name) == 0 {\\n    false\\n  } else {\\n    let c = String::char_code_at(name, 0)\\n    c >= 65 && c <= 90\\n  }\\n}\\n\\nfn type_returns_name(ty: Type, type_name: String) -> Bool {\\n  match ty {\\n    CtEnum(name) => name == type_name,\\n    CtNamed(name, _) => name == type_name,\\n    CtFn(_, ret, _) => type_returns_name(ret, type_name),\\n    CtForAll(_, _, body) => type_returns_name(body, type_name),\\n    _ => false\\n  }\\n}\\n\\nfn bind_enum_constructor_companions(acc: TypeEnv, dep_bindings: Array[(String, Type)], enum_name: String) -> TypeEnv {\\n  let mut out = acc\\n  let mut i = 0\\n  while i < Array::length(dep_bindings) {\\n    let (candidate_name, candidate_ty) = Array::get(dep_bindings, i)\\n    if candidate_name != enum_name && starts_with_upper(candidate_name) && type_returns_name(candidate_ty, enum_name) {\\n      out = env_bind(out, candidate_name, candidate_ty)\\n    }\\n    i = i + 1\\n  }\\n  out\\n}\\n\\nfn bind_import_names_from_cache(acc: TypeEnv, resolved: String, names: Array[(String, Option[String])], cache: Array[(String, TypeEnv)]) -> TypeEnv {\\n  let dep_env = match lookup_env_cache(cache, resolved) {\\n    Some(e) => e,\\n    None => EnvEmpty\\n  }\\n  let dep_bindings = env_flat_bindings(dep_env)\\n  let nlen = Array::length(names)\\n  let rec bind_names: (Int, TypeEnv) -> TypeEnv = (j, nacc) -> {\\n    if j >= nlen {\\n      nacc\\n    } else {\\n      let (name, alias) = Array::get(names, j)\\n      let bound_name = match alias {\\n        Some(a) => a,\\n        None => name\\n      }\\n      let ty = match env_lookup_flat(dep_bindings, name) {\\n        Some(t) => t,\\n        None => CtUnknown\\n      }\\n      let with_name = env_bind(nacc, bound_name, ty)\\n      let with_companions = match ty {\\n        CtEnum(enum_name) => bind_enum_constructor_companions(with_name, dep_bindings, enum_name),\\n        _ => if starts_with_upper(name) {\\n          bind_enum_constructor_companions(with_name, dep_bindings, name)\\n        } else {\\n          with_name\\n        }\\n      }\\n      bind_names(j + 1, with_companions)\\n    }\\n  }\\n  bind_names(0, acc)\\n}\\n\\nfn build_import_env(stmts: Array[Stmt], base_dir: String, cache: Array[(String, TypeEnv)]) -> TypeEnv {\\n  let len = Array::length(stmts)\\n  let rec go: (Int, TypeEnv) -> TypeEnv = (i, acc) -> {\\n    if i >= len {\\n      acc\\n    } else {\\n      let next = match Array::get(stmts, i) {\\n        SImport(raw_path, names) => {\\n          let resolved = resolve_cached_import_path(base_dir, raw_path, cache)\\n          bind_import_names_from_cache(acc, resolved, names, cache)\\n        },\\n        SReExport(raw_path, names) => {\\n          let resolved = resolve_cached_import_path(base_dir, raw_path, cache)\\n          bind_import_names_from_cache(acc, resolved, names, cache)\\n        },\\n        _ => acc\\n      }\\n      go(i + 1, next)\\n    }\\n  }\\n  go(0, EnvEmpty)\\n}\\n\\nfn upsert_env_cache(cache: Array[(String, TypeEnv)], path: String, env: TypeEnv) -> Array[(String, TypeEnv)] {\\n  let len = Array::length(cache)\\n  let mut i = 0\\n  let mut found = false\\n  while i < len && !found {\\n    let (p, _) = Array::get(cache, i)\\n    if p == path {\\n      Array::set(cache, i, (path, env))\\n      found = true\\n    } else {\\n      i = i + 1\\n    }\\n  }\\n  if !found {\\n    Array::push(cache, (path, env))\\n  }\\n  cache\\n}\\n\\nfn ensure_env_cache_for_path(rdb: RippleDb, env_cache: Array[(String, TypeEnv)], path: String) -> Array[(String, TypeEnv)] with { Error, Fs } {\\n  match lookup_env_cache(env_cache, path) {\\n    Some(_) => env_cache,\\n    None =>\\n    match ripple_get_fingerprint(rdb, path) {\\n      Some(fingerprint) =>\\n      match load_persistent_type_env(fingerprint) {\\n        Some(cached_env) => upsert_env_cache(env_cache, path, cached_env),\\n        None => env_cache\\n      },\\n      None => env_cache\\n    }\\n  }\\n}\\n\\nfn ensure_env_cache_for_paths(rdb: RippleDb, env_cache: Array[(String, TypeEnv)], paths: Array[String]) -> Array[(String, TypeEnv)] with { Error, Fs } {\\n  let mut cache = env_cache\\n  let mut i = 0\\n  while i < Array::length(paths) {\\n    cache = ensure_env_cache_for_path(rdb, cache, Array::get(paths, i))\\n    i = i + 1\\n  }\\n  cache\\n}\\n\\nfn build_fingerprint(source: String, dep_fps: Array[(String, String)]) -> String {\\n  let mut acc = compact_string_fingerprint(source)\\n  let mut i = 0\\n  while i < Array::length(dep_fps) {\\n    let dep_pair = Array::get(dep_fps, i)\\n    let dep_path = dep_pair.0\\n    let dep_fp = dep_pair.1\\n    let next = String::concat(acc, String::concat(\\\"|\\\", String::concat(dep_path, String::concat(\\\"=\\\", dep_fp))))\\n    acc = compact_string_fingerprint(next)\\n    i = i + 1\\n  }\\n  acc\\n}\\n\\nfn copy_string_array(items: Array[String]) -> Array[String] {\\n  // Iterative push: previous recursive Array::concat(acc, [x]) was\\n  // O(N^2) — copied the full prefix on each step.\\n  let out = empty_stack()\\n  let mut i = 0\\n  let len = Array::length(items)\\n  while i < len {\\n    Array::push(out, Array::get(items, i))\\n    i = i + 1\\n  }\\n  out\\n}\\n\\nfn lookup_string_pair(pairs: Array[(String, String)], key: String) -> Option[String] {\\n  let len = Array::length(pairs)\\n  let mut i = 0\\n  let mut result = None\\n  let mut done = false\\n  while !done {\\n    if i >= len {\\n      done = true\\n    } else {\\n      let (k, v) = Array::get(pairs, i)\\n      if k == key {\\n        result = Some(v)\\n        done = true\\n      } else {\\n        i = i + 1\\n      }\\n    }\\n  }\\n  result\\n}\\n\\nfn upsert_string_pair(pairs: Array[(String, String)], key: String, value: String) -> Array[(String, String)] {\\n  let len = Array::length(pairs)\\n  let mut i = 0\\n  let mut found = false\\n  while i < len && !found {\\n    let (k, _) = Array::get(pairs, i)\\n    if k == key {\\n      Array::set(pairs, i, (key, value))\\n      found = true\\n    } else {\\n      i = i + 1\\n    }\\n  }\\n  if !found {\\n    Array::push(pairs, (key, value))\\n  }\\n  pairs\\n}\\n\\nfn parse_program_with_path(path: String, source: String) -> Array[Stmt] with { Error } {\\n  handle {\\n    // Located lex+parse so EIdent (and other) nodes carry real source char\\n    // offsets; the checker rides those offsets into type diagnostics via the\\n    // [@off=N] marker (decoded by locate_type_error). The plain\\n    // `parse_program(lex(source))` passed an empty starts array, leaving every\\n    // offset at -1, so located type errors fell back to a first-occurrence scan.\\n    let (tokens, starts, _ends) = lex_with_offsets(source)\\n    parse_program_located(tokens, starts, source)\\n  } with Error {\\n    Throw(msg) => throw(String::concat(String::concat(path, \\\": \\\"), msg))\\n  }\\n}\\n\\nfn store_persistent_type_env(fingerprint: String, env: TypeEnv) -> Unit with { Error, Fs } {\\n  Fs::write_file(persistent_type_env_cache_path(fingerprint), persistent_type_env_cache_text(env))\\n}\\n\\nfn write_persistent_dep_list_if_missing(path: String, source: String, deps: Array[String]) -> Unit with { Fs } {\\n  let dep_cache_path = persistent_dep_list_cache_path(path, compact_string_fingerprint(source))\\n  if !(Fs::exists(dep_cache_path)) {\\n    Fs::write_file(dep_cache_path, persistent_dep_list_text(deps))\\n  } else {\\n    ()\\n  }\\n}\\n\\n// Span of an identifier run starting at `start` (returns the end offset).\\nfn typecheck_ident_run(s: String, start: Int) -> Int {\\n  let len = String::length(s)\\n  let mut e = start\\n  let mut go = true\\n  while go && e < len {\\n    let c = String::char_code_at(s, e)\\n    let is_id = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_'\\n    if is_id {\\n      e = e + 1\\n    } else {\\n      go = false\\n    }\\n  }\\n  e\\n}\\n\\n// Best-effort `line:col` for a type error: pull the symbol out of\\n// `unknown name: X` and locate its first occurrence in the source. Real\\n// expression-level spans (AST node positions) remain future work; this gives\\n// the common case a line number in both CLI and LSP (which parses the prefix).\\n// Built with String::concat only (not `+`) to avoid the selfhost NUL fragility.\\n// Prefix `msg` with the source `line:col` of the symbol that follows `marker`\\n// in `msg` (if both are found); otherwise return `msg` unchanged.\\nfn locate_by_marker(source: String, msg: String, marker: String) -> String {\\n  let mi = String::index_of(msg, marker)\\n  if mi < 0 {\\n    msg\\n  } else {\\n    let sstart = mi + String::length(marker)\\n    let send = typecheck_ident_run(msg, sstart)\\n    if send <= sstart {\\n      msg\\n    } else {\\n      let sym = String::substring(msg, sstart, send)\\n      let off = String::index_of(source, sym)\\n      if off < 0 {\\n        msg\\n      } else {\\n        let (line, col) = offset_to_line_col(source, off)\\n        let loc = String::concat(\\\"line \\\", String::concat(__to_string(line), String::concat(\\\":\\\", String::concat(__to_string(col), \\\": \\\"))))\\n        String::concat(loc, msg)\\n      }\\n    }\\n  }\\n}\\n\\n// First-occurrence heuristic locator (the original behavior). Kept separate so\\n// the offset-marker path can fall through to it on the marker-stripped message.\\nfn locate_type_error_heuristic(source: String, msg: String) -> String {\\n  // Already located (e.g. a parse error that bubbled here)? leave it.\\n  if String::index_of(msg, \\\"line \\\") == 0 {\\n    msg\\n  } else {\\n    let with_name = locate_by_marker(source, msg, \\\"unknown name: \\\")\\n    if with_name != msg {\\n      with_name\\n    } else {\\n      let with_arity = locate_by_marker(source, msg, \\\"function arity mismatch for \\\")\\n      if with_arity != msg {\\n        with_arity\\n      } else {\\n        let with_field = locate_by_marker(source, msg, \\\"unknown field \\\")\\n        if with_field != msg {\\n          with_field\\n        } else {\\n          locate_by_marker(source, msg, \\\"unknown constructor \\\")\\n        }\\n      }\\n    }\\n  }\\n}\\n\\n// Build the `line L:col C: ` prefix for a source char offset (same format as\\n// locate_by_marker). String::concat only — the selfhost `+`/interpolation NUL\\n// hazard applies here too.\\nfn offset_line_col_prefix(source: String, off: Int) -> String {\\n  let (line, col) = offset_to_line_col(source, off)\\n  String::concat(\\\"line \\\", String::concat(__to_string(line), String::concat(\\\":\\\", String::concat(__to_string(col), \\\": \\\"))))\\n}\\n\\n// Build a `line L:colC-E: ` RANGE prefix from a (start, end) char-offset span.\\n// When start and end fall on the same source line this carries the exact end\\n// column so the LSP can highlight the precise token (incl. qualified names);\\n// when end is on a later line (or not greater than start) it degrades to the\\n// point prefix. Backward compatible: `line L:` still leads, so existing\\n// `grep -F \\\"line N:\\\"` assertions keep matching. String::concat only.\\nfn offset_line_col_range_prefix(source: String, start: Int, endo: Int) -> String {\\n  let (l1, c1) = offset_to_line_col(source, start)\\n  let (l2, c2) = offset_to_line_col(source, endo)\\n  if l1 == l2 && endo > start {\\n    String::concat(\\\"line \\\", String::concat(__to_string(l1), String::concat(\\\":\\\", String::concat(__to_string(c1), String::concat(\\\"-\\\", String::concat(__to_string(c2), \\\": \\\"))))))\\n  } else {\\n    offset_line_col_prefix(source, start)\\n  }\\n}\\n\\n// Parse a non-negative decimal integer from msg[start..end). Returns -1 if the\\n// span is empty or contains a non-digit (callers then fall through to the text\\n// heuristic).\\nfn parse_offset_digits(msg: String, start: Int, end: Int) -> Int {\\n  if end <= start {\\n    -1\\n  } else {\\n    let mut i = start\\n    let mut acc = 0\\n    let mut ok = true\\n    while ok && i < end {\\n      let c = String::char_code_at(msg, i)\\n      if c >= '0' && c <= '9' {\\n        acc = acc * 10 + (c - '0')\\n        i = i + 1\\n      } else {\\n        ok = false\\n      }\\n    }\\n    if ok {\\n      acc\\n    } else {\\n      -1\\n    }\\n  }\\n}\\n\\n// Decode (and ALWAYS strip) the ` [@off=N]` marker the checker may have\\n// appended. If N is a valid in-range offset, prefix the stripped message with\\n// its exact `line:col`. Otherwise strip the marker and fall through to the\\n// existing first-occurrence heuristics on the cleaned message. If no marker is\\n// present, returns msg unchanged.\\nfn locate_type_error(source: String, msg: String) -> String {\\n  let marker = \\\" [@off=\\\"\\n  let mi = String::index_of(msg, marker)\\n  if mi < 0 {\\n    locate_type_error_heuristic(source, msg)\\n  } else {\\n    let inner_start = mi + String::length(marker)\\n    let rel_end = String::index_of(String::substring(msg, inner_start, String::length(msg)), \\\"]\\\")\\n    if rel_end < 0 {\\n      // Malformed marker (no closing `]`): strip from the marker onward.\\n      locate_type_error_heuristic(source, String::substring(msg, 0, mi))\\n    } else {\\n      let close = inner_start + rel_end\\n      // inner is `N` (start only) or `N:M` (start:end). Split on `:`.\\n      let inner = String::substring(msg, inner_start, close)\\n      let colon = String::index_of(inner, \\\":\\\")\\n      let n = if colon < 0 {\\n        parse_offset_digits(inner, 0, String::length(inner))\\n      } else {\\n        parse_offset_digits(inner, 0, colon)\\n      }\\n      let m = if colon < 0 {\\n        -1\\n      } else {\\n        parse_offset_digits(inner, colon + 1, String::length(inner))\\n      }\\n      // Strip the full ` [@off=...]` segment (marker .. closing `]` inclusive).\\n      let stripped = String::concat(String::substring(msg, 0, mi), String::substring(msg, close + 1, String::length(msg)))\\n      let slen = String::length(source)\\n      if n >= 0 && n < slen {\\n        if m > n && m <= slen {\\n          String::concat(offset_line_col_range_prefix(source, n, m), stripped)\\n        } else {\\n          String::concat(offset_line_col_prefix(source, n), stripped)\\n        }\\n      } else {\\n        locate_type_error_heuristic(source, stripped)\\n      }\\n    }\\n  }\\n}\\n\\nfn finish_typecheck_fs_impl(rdb: RippleDb, env_cache: Array[(String, TypeEnv)], dep_source_cache: Array[(String, String)], parse_count: Int, path: String, source: String, deps: Array[String], fingerprint: String) -> (String, RippleDb, Array[(String, TypeEnv)], Array[(String, String)], Int) with { Error, Fs } {\\n  if Fs::exists(persistent_type_env_cache_path(fingerprint)) {\\n    let next_db = ripple_record_eval(rdb, path, fingerprint, deps)\\n    (fingerprint, next_db, env_cache, dep_source_cache, parse_count)\\n  } else {\\n    let stmts = parse_program_with_path(path, source)\\n    let final_parse_count = parse_count + 1\\n    let import_env_cache = ensure_env_cache_for_paths(rdb, env_cache, deps)\\n    let import_env = build_import_env(stmts, dir_of_path(path), import_env_cache)\\n    let checked_env = handle {\\n      match import_env {\\n        EnvEmpty => check_program(stmts),\\n        _ => check_program_with_env(stmts, import_env)\\n      }\\n    } with Error {\\n      Throw(msg) => throw(String::concat(String::concat(path, \\\": \\\"), locate_type_error(source, msg)))\\n    }\\n    store_persistent_type_env(fingerprint, checked_env)\\n    if Array::length(deps) == 0 {\\n      Fs::write_file(persistent_leaf_fingerprint_cache_path(path, compact_string_fingerprint(source)), persistent_leaf_fingerprint_text(fingerprint))\\n    } else {\\n      ()\\n    }\\n    let next_env_cache = upsert_env_cache(import_env_cache, path, checked_env)\\n    let next_db = ripple_record_eval(rdb, path, fingerprint, deps)\\n    (fingerprint, next_db, next_env_cache, dep_source_cache, final_parse_count)\\n  }\\n}\\n\\nfn collect_import_deps_from_stmts(stmts: Array[Stmt], base_dir: String) -> Array[String] {\\n  // Iterative push: previously the recursive `Array::concat(acc, [x])`\\n  // copied the full prefix on each new dep — O(N^2) for files with\\n  // many imports.\\n  let out = empty_stack()\\n  let mut i = 0\\n  let len = Array::length(stmts)\\n  while i < len {\\n    match Array::get(stmts, i) {\\n      SImport(raw_path, _) => if String::length(raw_path) > 0 {\\n        let resolved = resolve_import_path(base_dir, raw_path)\\n        if !contains_str(out, resolved) {\\n          Array::push(out, resolved)\\n        }\\n      },\\n      SReExport(raw_path, _) => if String::length(raw_path) > 0 {\\n        let resolved = resolve_import_path(base_dir, raw_path)\\n        if !contains_str(out, resolved) {\\n          Array::push(out, resolved)\\n        }\\n      },\\n      _ => ()\\n    }\\n    i = i + 1\\n  }\\n  out\\n}\\n\\nfn load_or_parse_deps_for_source_fs(dep_source_cache: Array[(String, String)], path: String, source: String, parse_count: Int) -> (Array[String], Array[(String, String)], Int) with { Error, Fs } {\\n  match load_persistent_dep_list(path, source) {\\n    Some(deps) => (deps, upsert_string_pair(dep_source_cache, path, source), parse_count),\\n    None => {\\n      let (deps, _, next_parse_count) = load_or_parse_module_header_fs(path, source, parse_count)\\n      (deps, upsert_string_pair(dep_source_cache, path, source), next_parse_count)\\n    }\\n  }\\n}\\n\\nfn resolve_deps_for_source_fs(rdb: RippleDb, dep_source_cache: Array[(String, String)], path: String, source: String, parse_count: Int) -> (Array[String], Array[(String, String)], Int) with { Error, Fs } {\\n  match lookup_string_pair(dep_source_cache, path) {\\n    Some(cached_source) =>\\n    if cached_source == source {\\n      match ripple_get_deps(rdb, path) {\\n        Some(deps) => (deps, dep_source_cache, parse_count),\\n        None => load_or_parse_deps_for_source_fs(dep_source_cache, path, source, parse_count)\\n      }\\n    } else {\\n      load_or_parse_deps_for_source_fs(dep_source_cache, path, source, parse_count)\\n    },\\n    None => load_or_parse_deps_for_source_fs(dep_source_cache, path, source, parse_count)\\n  }\\n}\\n\\nfn ensure_fingerprint_fs_go(rdb: RippleDb, env_cache: Array[(String, TypeEnv)], dep_source_cache: Array[(String, String)], parse_count: Int, path: String, stack: Array[String]) -> (String, RippleDb, Array[(String, TypeEnv)], Array[(String, String)], Int) with { Error, Fs } {\\n  if contains_str(stack, path) {\\n    throw(String::concat(\\\"type_db: import cycle detected at \\\", path))\\n  } else {\\n    match ripple_get_source(rdb, path) {\\n      None => (String::concat(\\\"missing:\\\", path), rdb, env_cache, dep_source_cache, parse_count),\\n      Some(source) => match lookup_string_pair(dep_source_cache, path) {\\n        Some(cached_source) => if cached_source == source {\\n          match ripple_get_fingerprint(rdb, path) {\\n            Some(cached_fingerprint) =>\\n            // The fingerprint is enough for dependency fingerprint folding.\\n            // Loading the env here caused shared leaf modules to re-read their\\n            // persistent leaf cache every time they were reached before a\\n            // parent needed their bindings.\\n            (cached_fingerprint, rdb, env_cache, dep_source_cache, parse_count),\\n            None => match load_persistent_leaf_fingerprint(path, source) {\\n              Some(leaf_fingerprint) => {\\n                write_persistent_dep_list_if_missing(path, source, empty_stack())\\n                let next_dep_source_cache = upsert_string_pair(dep_source_cache, path, source)\\n                let next_db = ripple_record_eval(rdb, path, leaf_fingerprint, empty_stack())\\n                (leaf_fingerprint, next_db, env_cache, next_dep_source_cache, parse_count)\\n              },\\n              None => {\\n                let (deps_raw, next_dep_source_cache, initial_parse_count) = resolve_deps_for_source_fs(rdb, dep_source_cache, path, source, parse_count)\\n                let deps = copy_string_array(deps_raw)\\n                write_persistent_dep_list_if_missing(path, source, deps)\\n                let dlen = Array::length(deps)\\n                let saved_stack_len = Array::length(stack)\\n                Array::push(stack, path)\\n                let mut i = 0\\n                let mut db_after_deps = rdb\\n                let mut env_cache_after_deps = env_cache\\n                let mut dep_source_cache_after_deps = next_dep_source_cache\\n                let mut parse_count_after_deps = initial_parse_count\\n                let dep_fps = empty_dep_fps()\\n                while i < dlen {\\n                  let dep_path = Array::get(deps, i)\\n                  let (dep_fp, next_db, next_env_cache, next_dep_source_cache2, next_parse_count) = ensure_fingerprint_fs_go(db_after_deps, env_cache_after_deps, dep_source_cache_after_deps, parse_count_after_deps, dep_path, stack)\\n                  db_after_deps = next_db\\n                  env_cache_after_deps = next_env_cache\\n                  dep_source_cache_after_deps = next_dep_source_cache2\\n                  parse_count_after_deps = next_parse_count\\n                  Array::push(dep_fps, (dep_path, dep_fp))\\n                  i = i + 1\\n                }\\n                Array::truncate(stack, saved_stack_len)\\n                let fingerprint = build_fingerprint(source, dep_fps)\\n                match ripple_get_fingerprint(db_after_deps, path) {\\n                  Some(cached_fp) =>\\n                  if cached_fp == fingerprint {\\n                    (fingerprint, db_after_deps, env_cache_after_deps, dep_source_cache_after_deps, parse_count_after_deps)\\n                  } else {\\n                    finish_typecheck_fs_impl(db_after_deps, env_cache_after_deps, dep_source_cache_after_deps, parse_count_after_deps, path, source, deps, fingerprint)\\n                  },\\n                  None =>\\n                  finish_typecheck_fs_impl(db_after_deps, env_cache_after_deps, dep_source_cache_after_deps, parse_count_after_deps, path, source, deps, fingerprint)\\n                }\\n              }\\n            }\\n          }\\n        } else {\\n          match load_persistent_leaf_fingerprint(path, source) {\\n            Some(leaf_fingerprint) => {\\n              write_persistent_dep_list_if_missing(path, source, empty_stack())\\n              let next_dep_source_cache = upsert_string_pair(dep_source_cache, path, source)\\n              let next_db = ripple_record_eval(rdb, path, leaf_fingerprint, empty_stack())\\n              (leaf_fingerprint, next_db, env_cache, next_dep_source_cache, parse_count)\\n            },\\n            None => {\\n              let (deps_raw, next_dep_source_cache, initial_parse_count) = resolve_deps_for_source_fs(rdb, dep_source_cache, path, source, parse_count)\\n              let deps = copy_string_array(deps_raw)\\n              write_persistent_dep_list_if_missing(path, source, deps)\\n              let dlen = Array::length(deps)\\n              let saved_stack_len = Array::length(stack)\\n              Array::push(stack, path)\\n              let mut i = 0\\n              let mut db_after_deps = rdb\\n              let mut env_cache_after_deps = env_cache\\n              let mut dep_source_cache_after_deps = next_dep_source_cache\\n              let mut parse_count_after_deps = initial_parse_count\\n              let dep_fps = empty_dep_fps()\\n              while i < dlen {\\n                let dep_path = Array::get(deps, i)\\n                let (dep_fp, next_db, next_env_cache, next_dep_source_cache2, next_parse_count) = ensure_fingerprint_fs_go(db_after_deps, env_cache_after_deps, dep_source_cache_after_deps, parse_count_after_deps, dep_path, stack)\\n                db_after_deps = next_db\\n                env_cache_after_deps = next_env_cache\\n                dep_source_cache_after_deps = next_dep_source_cache2\\n                parse_count_after_deps = next_parse_count\\n                Array::push(dep_fps, (dep_path, dep_fp))\\n                i = i + 1\\n              }\\n              Array::truncate(stack, saved_stack_len)\\n              let fingerprint = build_fingerprint(source, dep_fps)\\n              match ripple_get_fingerprint(db_after_deps, path) {\\n                Some(cached_fp) =>\\n                if cached_fp == fingerprint {\\n                  (fingerprint, db_after_deps, env_cache_after_deps, dep_source_cache_after_deps, parse_count_after_deps)\\n                } else {\\n                  finish_typecheck_fs_impl(db_after_deps, env_cache_after_deps, dep_source_cache_after_deps, parse_count_after_deps, path, source, deps, fingerprint)\\n                },\\n                None =>\\n                finish_typecheck_fs_impl(db_after_deps, env_cache_after_deps, dep_source_cache_after_deps, parse_count_after_deps, path, source, deps, fingerprint)\\n              }\\n            }\\n          }\\n        },\\n        None =>\\n        match load_persistent_leaf_fingerprint(path, source) {\\n          Some(leaf_fingerprint) => {\\n            write_persistent_dep_list_if_missing(path, source, empty_stack())\\n            let next_dep_source_cache = upsert_string_pair(dep_source_cache, path, source)\\n            let next_db = ripple_record_eval(rdb, path, leaf_fingerprint, empty_stack())\\n            (leaf_fingerprint, next_db, env_cache, next_dep_source_cache, parse_count)\\n          },\\n          None => {\\n            let (deps_raw, next_dep_source_cache, initial_parse_count) = resolve_deps_for_source_fs(rdb, dep_source_cache, path, source, parse_count)\\n            let deps = copy_string_array(deps_raw)\\n            write_persistent_dep_list_if_missing(path, source, deps)\\n            let dlen = Array::length(deps)\\n            let saved_stack_len = Array::length(stack)\\n            Array::push(stack, path)\\n            let mut i = 0\\n            let mut db_after_deps = rdb\\n            let mut env_cache_after_deps = env_cache\\n            let mut dep_source_cache_after_deps = next_dep_source_cache\\n            let mut parse_count_after_deps = initial_parse_count\\n            let dep_fps = empty_dep_fps()\\n            while i < dlen {\\n              let dep_path = Array::get(deps, i)\\n              let (dep_fp, next_db, next_env_cache, next_dep_source_cache2, next_parse_count) = ensure_fingerprint_fs_go(db_after_deps, env_cache_after_deps, dep_source_cache_after_deps, parse_count_after_deps, dep_path, stack)\\n              db_after_deps = next_db\\n              env_cache_after_deps = next_env_cache\\n              dep_source_cache_after_deps = next_dep_source_cache2\\n              parse_count_after_deps = next_parse_count\\n              Array::push(dep_fps, (dep_path, dep_fp))\\n              i = i + 1\\n            }\\n            Array::truncate(stack, saved_stack_len)\\n            let fingerprint = build_fingerprint(source, dep_fps)\\n            match ripple_get_fingerprint(db_after_deps, path) {\\n              Some(cached_fp) =>\\n              if cached_fp == fingerprint {\\n                (fingerprint, db_after_deps, env_cache_after_deps, dep_source_cache_after_deps, parse_count_after_deps)\\n              } else {\\n                finish_typecheck_fs_impl(db_after_deps, env_cache_after_deps, dep_source_cache_after_deps, parse_count_after_deps, path, source, deps, fingerprint)\\n              },\\n              None =>\\n              finish_typecheck_fs_impl(db_after_deps, env_cache_after_deps, dep_source_cache_after_deps, parse_count_after_deps, path, source, deps, fingerprint)\\n            }\\n          }\\n        }\\n      }\\n    }\\n  }\\n}\\n\\nexport fn ensure_fingerprint_fs_impl(rdb: RippleDb, env_cache: Array[(String, TypeEnv)], dep_source_cache: Array[(String, String)], parse_count: Int, path: String, stack: Array[String]) -> (String, RippleDb, Array[(String, TypeEnv)], Array[(String, String)], Int) with { Error, Fs } {\\n  let (fingerprint, next_db, next_env_cache, next_dep_source_cache, next_parse_count) = ensure_fingerprint_fs_go(rdb, env_cache, dep_source_cache, parse_count, path, stack)\\n  let final_env_cache = ensure_env_cache_for_path(next_db, next_env_cache, path)\\n  (fingerprint, next_db, final_env_cache, next_dep_source_cache, next_parse_count)\\n}\\n\\n// #946: drop exact duplicates from a diagnostics list, preserving first-seen\\n// order. Each entry already embeds its location (\\\"line L:C: msg\\\"), so string\\n// equality IS (position, message) identity. O(N^2) — diagnostic lists are tiny.\\nfn dedupe_diagnostics(diags: Array[String]) -> Array[String] {\\n  let out = Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n  let mut i = 0\\n  while i < Array::length(diags) {\\n    let d = Array::get(diags, i)\\n    if contains_str(out, d) {\\n      ()\\n    } else {\\n      Array::push(out, d)\\n    }\\n    i = i + 1\\n  }\\n  out\\n}\\n\\n// Collect ALL diagnostics for `source` as located (`line:col`) message strings.\\n// Lexer errors come first (#946): the recovering lexer records every offending\\n// position instead of throwing, so a lex-broken file reports located lexer\\n// diagnostics rather than an empty (\\\"clean\\\") result. Only when the lex is clean\\n// does the recovering parser gather every top-level syntax error; only if the\\n// parse is also clean does it run the type checker and report the (single,\\n// located) type error. Identical (position, message) pairs are deduped.\\n// Returns [] when the source lexes, parses, and checks cleanly.\\n// Foundation for `vibe check` / LSP multi-diagnostic reporting.\\nexport fn collect_all_diagnostics(source: String) -> Array[String] with { Error } {\\n  let (tokens, starts, _ends, lex_err_offsets, lex_err_msgs) = lex_with_offsets_recovering(source)\\n  if Array::length(lex_err_msgs) > 0 {\\n    // Report ONLY the lexer errors: the recovered token stream has holes, so\\n    // parse/type diagnostics on it would be follow-on noise.\\n    let located = Array::slice([\\n      \\\"\\\"\\n    ], 0, 0)\\n    let mut i = 0\\n    while i < Array::length(lex_err_msgs) {\\n      let off = Array::get(lex_err_offsets, i)\\n      let (line, col) = offset_to_line_col(source, off)\\n      let loc = String::concat(\\\"line \\\", String::concat(__to_string(line), String::concat(\\\":\\\", String::concat(__to_string(col), \\\": \\\"))))\\n      Array::push(located, String::concat(loc, Array::get(lex_err_msgs, i)))\\n      i = i + 1\\n    }\\n    dedupe_diagnostics(located)\\n  } else {\\n    let (stmts, parse_diags) = parse_program_recovering(tokens, starts, source)\\n    if Array::length(parse_diags) > 0 {\\n      dedupe_diagnostics(parse_diags)\\n    } else {\\n      handle {\\n        let _env = check_program(stmts)\\n        Array::slice([\\n          \\\"_\\\"\\n        ], 0, 0)\\n      } with Error {\\n        Throw(msg) => [\\n          locate_type_error(source, msg)\\n        ]\\n      }\\n    }\\n  }\\n}\\n\")\n}\n\nlet cli_adapter_source_130 = () -> (String, String) {\n  (\"lib/@vibe/compiler/runtime/type_at.vibe\",\n\"//# Imports\\n\\n// `vibe type-at` — first typed-hover (LSP) consumer of the real EIdent source\\n// offsets. Given a (line, col), locate the identifier node whose source span\\n// covers that position, typecheck the program, and return the inferred type of\\n// that name via env_lookup + type_to_string.\\n//\\n// MVP scope / LIMITATION: only env-visible names resolve — top-level bindings\\n// and imported names that the checker records in the returned TypeEnv. Locals\\n// and function parameters are NOT in that env (they live in nested scopes during\\n// inference and are gone by the time check_program returns), so hovering one\\n// yields \\\"\\\". A future per-node type table would lift this restriction.\\n//\\n// All strings are built with String::concat only (never `+`, never \\\"\\\\{x}\\\"\\n// interpolation): both mis-codegen to NUL in selfhost. Ints stringify via\\n// __to_string.\\n\\nimport ../core {\\n  Stmt, Expr, Pat, Type, TypeEnv, Subst, env_lookup, subst_apply, type_to_string\\n}\\n\\nimport ../checker/index.vibe {\\n  check_program, check_program_type_table\\n}\\n\\nimport ../syntax {\\n  lex_with_offsets, parse_program_located, parse_program_spans, offset_to_line_col\\n}\\n\\n//# Functions\\n\\n// 1-based (line, col) -> 0-based char offset, the inverse of offset_to_line_col.\\n// `col` is the position WITHIN a line (col 1 = first char of the line, col\\n// length+1 = just past the last char — a valid cursor position). We count\\n// newlines: the offset of the start of line L is just past the (L-1)th\\n// newline, then add (col - 1).\\n//\\n// Returns -1 (invalid / no position) for anything out of range, rather than\\n// silently clamping (#947):\\n//   - `line < 1` or `col < 1`: never valid (1-based).\\n//   - `line` beyond the last line in `source`.\\n//   - `col` past the END of that line's content — previously this fell\\n//     through to `linestart + col - 1` unclamped, which for a large enough\\n//     `col` landed on/inside the NEXT line (a col-past-EOL query silently\\n//     resolved to an unrelated identifier a line down).\\n// CRLF (#947): a line's addressable content excludes a trailing '\\\\r' before\\n// the '\\\\n' — otherwise every query position (and reported span) on a CRLF\\n// file drifts by one byte per preceding CRLF line, since the line's `\\\\r` was\\n// being counted as ordinary content here but not consistently elsewhere.\\nfn line_col_to_offset(source: String, line: Int, col: Int) -> Int {\\n  if line < 1 || col < 1 {\\n    -1\\n  } else {\\n    let len = String::length(source)\\n    let mut i = 0\\n    let mut cur_line = 1\\n    // Advance to the first char of the target line.\\n    while cur_line < line && i < len {\\n      if String::char_code_at(source, i) == 10 {\\n        cur_line = cur_line + 1\\n      } else {\\n        ()\\n      }\\n      i = i + 1\\n    }\\n    if cur_line < line {\\n      // `line` is past the last line in `source`.\\n      -1\\n    } else {\\n      // i is the start of line `line`. Find the end of its content: the\\n      // offset of the terminating '\\\\n' (or `len` for the final line), then\\n      // exclude a preceding '\\\\r' (CRLF) so it isn't counted as content.\\n      let mut line_end = i\\n      while line_end < len && String::char_code_at(source, line_end) != 10 {\\n        line_end = line_end + 1\\n      }\\n      let content_end = if line_end > i && String::char_code_at(source, line_end - 1) == 13 {\\n        line_end - 1\\n      } else {\\n        line_end\\n      }\\n      let off = i + (col - 1)\\n      if off > content_end {\\n        -1\\n      } else {\\n        off\\n      }\\n    }\\n  }\\n}\\n\\n// A located EIdent hit: name + source span [off, off + length(name)). `off` is\\n// -1 for synthetic / non-located idents (those are ignored by the search).\\nenum IdentHit {\\n  IdentHit(String, Int)\\n}\\n\\nfn empty_hits() -> Array[IdentHit] {\\n  Array::slice([\\n    IdentHit(\\\"\\\", -1)\\n  ], 0, 0)\\n}\\n\\n// Read-only walker over the Expr structure (templated on normalize/index.vibe's\\n// `fold_expr`, but it only COLLECTS located EIdent nodes — it never rebuilds the\\n// tree). Every variant is enumerated so a new Expr arm is a compile error here,\\n// keeping the collector in sync with the AST.\\nfn collect_expr(expr: Expr, acc: Array[IdentHit]) -> Unit {\\n  match expr {\\n    EInt(_) => (),\\n    EFloat(_) => (),\\n    EString(_) => (),\\n    EBool(_) => (),\\n    EIdent(name, off) => {\\n      if off >= 0 {\\n        Array::push(acc, IdentHit(name, off))\\n      } else {\\n        ()\\n      }\\n    },\\n    EUnit => (),\\n    EStringInterp(_) => (),\\n    ETuple(items) => collect_exprs(items, acc),\\n    EArray(items) => collect_exprs(items, acc),\\n    ERecord(_, fields, _) => collect_field_exprs(fields, acc),\\n    EIf(c, t, e) => {\\n      collect_expr(c, acc)\\n      collect_expr(t, acc)\\n      collect_expr(e, acc)\\n    },\\n    ELet(_, v, b, _) => {\\n      collect_expr(v, acc)\\n      collect_expr(b, acc)\\n    },\\n    ELetRec(_, v, b) => {\\n      collect_expr(v, acc)\\n      collect_expr(b, acc)\\n    },\\n    ELetMut(_, v, b, _) => {\\n      collect_expr(v, acc)\\n      collect_expr(b, acc)\\n    },\\n    EAssign(_, v, b) => {\\n      collect_expr(v, acc)\\n      collect_expr(b, acc)\\n    },\\n    EAssignOp(_, _, v, b) => {\\n      collect_expr(v, acc)\\n      collect_expr(b, acc)\\n    },\\n    ESeq(a, b) => {\\n      collect_expr(a, acc)\\n      collect_expr(b, acc)\\n    },\\n    EMatch(s, arms) => {\\n      collect_expr(s, acc)\\n      collect_arm_exprs(arms, acc)\\n    },\\n    EHandle(s, arms) => {\\n      collect_expr(s, acc)\\n      collect_arm_exprs(arms, acc)\\n    },\\n    EWhile(c, b) => {\\n      collect_expr(c, acc)\\n      collect_expr(b, acc)\\n    },\\n    ELoop(params, b) => {\\n      collect_loop_param_exprs(params, acc)\\n      collect_expr(b, acc)\\n    },\\n    EForIn(_, _, it, b) => {\\n      collect_expr(it, acc)\\n      collect_expr(b, acc)\\n    },\\n    ECall(callee, args, _) => {\\n      collect_expr(callee, acc)\\n      collect_exprs(args, acc)\\n    },\\n    EBinOp(_, l, r) => {\\n      collect_expr(l, acc)\\n      collect_expr(r, acc)\\n    },\\n    EUnaryOp(_, e) => collect_expr(e, acc),\\n    EFn(_, _, _, _, _, body) => collect_expr(body, acc),\\n    EDot(e, field, _, field_off) => {\\n      // #645: the field name is hoverable — EDot carries the field token's\\n      // offset, and the checker records the projection type at that offset.\\n      if field_off >= 0 {\\n        Array::push(acc, IdentHit(field, field_off))\\n      } else {\\n        ()\\n      }\\n      collect_expr(e, acc)\\n    },\\n    ELabeledArg(_, _, v) => collect_expr(v, acc),\\n    EReturn(e) => collect_expr(e, acc),\\n    EBreak(opt) => match opt {\\n      Some(v) => collect_expr(v, acc),\\n      None => ()\\n    },\\n    EContinue(args) => collect_exprs(args, acc),\\n    EMap(fields) => collect_field_exprs(fields, acc),\\n    ESpread(e) => collect_expr(e, acc)\\n  }\\n}\\n\\nfn collect_exprs(items: Array[Expr], acc: Array[IdentHit]) -> Unit {\\n  let mut i = 0\\n  while i < Array::length(items) {\\n    collect_expr(Array::get(items, i), acc)\\n    i = i + 1\\n  }\\n}\\n\\nfn collect_field_exprs(fields: Array[(String, Expr)], acc: Array[IdentHit]) -> Unit {\\n  let mut i = 0\\n  while i < Array::length(fields) {\\n    let (_, v) = Array::get(fields, i)\\n    collect_expr(v, acc)\\n    i = i + 1\\n  }\\n}\\n\\nfn collect_arm_exprs(arms: Array[(Pat, Expr)], acc: Array[IdentHit]) -> Unit {\\n  let mut i = 0\\n  while i < Array::length(arms) {\\n    let (_, e) = Array::get(arms, i)\\n    collect_expr(e, acc)\\n    i = i + 1\\n  }\\n}\\n\\nfn collect_loop_param_exprs(params: Array[(String, Expr)], acc: Array[IdentHit]) -> Unit {\\n  let mut i = 0\\n  while i < Array::length(params) {\\n    let (_, init) = Array::get(params, i)\\n    collect_expr(init, acc)\\n    i = i + 1\\n  }\\n}\\n\\nfn collect_stmt(stmt: Stmt, acc: Array[IdentHit]) -> Unit {\\n  match stmt {\\n    SLet(_, _, _, _, body) => collect_expr(body, acc),\\n    SLetMut(_, _, body) => collect_expr(body, acc),\\n    STest(_, body) => collect_expr(body, acc),\\n    SBench(_, body) => collect_expr(body, acc),\\n    SExpr(e) => collect_expr(e, acc),\\n    SLetPat(_, body) => collect_expr(body, acc),\\n    SModule(_, _, body) => collect_stmts(body, acc),\\n    _ => ()\\n  }\\n}\\n\\nfn collect_stmts(stmts: Array[Stmt], acc: Array[IdentHit]) -> Unit {\\n  let mut i = 0\\n  while i < Array::length(stmts) {\\n    collect_stmt(Array::get(stmts, i), acc)\\n    i = i + 1\\n  }\\n}\\n\\n// True when `source[off]` is NOT an identifier char (or off is out of range) —\\n// i.e. a valid word boundary. Used to match a binding name as a whole word.\\nfn is_boundary_at(source: String, off: Int) -> Bool {\\n  if off < 0 || off >= String::length(source) {\\n    true\\n  } else {\\n    let c = String::char_code_at(source, off)\\n    let is_id = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_'\\n    !is_id\\n  }\\n}\\n\\n// Find the first whole-word occurrence of `name` in `source[start..end)` and, if\\n// found, push a located IdentHit for it. This recovers a source offset for a\\n// let-binding NAME, which the parser stores only as a String on the Stmt (it is\\n// not an EIdent and so carries no offset). Binding names are exactly the\\n// env-visible top-level names, so making their definition site hoverable is the\\n// useful case for this MVP.\\nfn push_binding_name_hit(source: String, start: Int, end: Int, name: String, acc: Array[IdentHit]) -> Unit {\\n  let nlen = String::length(name)\\n  if nlen == 0 {\\n    ()\\n  } else {\\n    let limit = if end > String::length(source) { String::length(source) } else { end }\\n    let mut i = if start < 0 { 0 } else { start }\\n    let mut found = false\\n    while !found && i + nlen <= limit {\\n      if String::substring(source, i, i + nlen) == name && is_boundary_at(source, i - 1) && is_boundary_at(source, i + nlen) {\\n        Array::push(acc, IdentHit(name, i))\\n        found = true\\n      } else {\\n        i = i + 1\\n      }\\n    }\\n  }\\n}\\n\\n// Add located hits for the NAMES of top-level (and module-body) value bindings,\\n// using each statement's source span (from parse_program_spans) to scope the\\n// whole-word search. Only SLet/SLetMut names are env-visible value bindings.\\nfn collect_binding_name_hits(stmts: Array[Stmt], span_start: Array[Int], span_end: Array[Int], source: String, acc: Array[IdentHit]) -> Unit {\\n  let mut i = 0\\n  while i < Array::length(stmts) {\\n    let start = if i < Array::length(span_start) { Array::get(span_start, i) } else { 0 }\\n    let end = if i < Array::length(span_end) { Array::get(span_end, i) } else { String::length(source) }\\n    match Array::get(stmts, i) {\\n      SLet(_, _, name, _, _) => push_binding_name_hit(source, start, end, name, acc),\\n      SLetMut(name, _, _) => push_binding_name_hit(source, start, end, name, acc),\\n      _ => ()\\n    }\\n    i = i + 1\\n  }\\n}\\n\\n// Among all collected idents whose span [off, off+len(name)) contains `tgt`,\\n// pick the one with the largest `off` (innermost / closest start). Returns \\\"\\\"\\n// when no ident covers the position.\\nfn pick_ident_at(hits: Array[IdentHit], tgt: Int) -> String {\\n  let mut best_name = \\\"\\\"\\n  let mut best_off = -1\\n  let mut i = 0\\n  while i < Array::length(hits) {\\n    match Array::get(hits, i) {\\n      IdentHit(name, off) => {\\n        let span_end = off + String::length(name)\\n        if off <= tgt && tgt < span_end && off > best_off {\\n          best_name = name\\n          best_off = off\\n        } else {\\n          ()\\n        }\\n      }\\n    }\\n    i = i + 1\\n  }\\n  best_name\\n}\\n\\n// Same selection as pick_ident_at, but returns the chosen ident's source\\n// `off` (the innermost / largest-off hit covering `tgt`), or -1 when none.\\n// Used to query the per-node type table by the hovered EIdent's offset.\\nfn pick_ident_off(hits: Array[IdentHit], tgt: Int) -> Int {\\n  let mut best_off = -1\\n  let mut i = 0\\n  while i < Array::length(hits) {\\n    match Array::get(hits, i) {\\n      IdentHit(name, off) => {\\n        let span_end = off + String::length(name)\\n        if off <= tgt && tgt < span_end && off > best_off {\\n          best_off = off\\n        } else {\\n          ()\\n        }\\n      }\\n    }\\n    i = i + 1\\n  }\\n  best_off\\n}\\n\\n// Look up the recorded type for source offset `off` in the per-node type table\\n// produced by check_program_type_table. Returns None when no node recorded that\\n// exact offset. When multiple entries share an offset (re-checked node), the\\n// last recorded one wins (closest to the final inference state).\\nfn tytab_lookup(table: Array[(Int, Type)], off: Int) -> Option[Type] {\\n  let mut found = None\\n  let mut i = 0\\n  while i < Array::length(table) {\\n    let (toff, tty) = Array::get(table, i)\\n    if toff == off {\\n      found = Some(tty)\\n    } else {\\n      ()\\n    }\\n    i = i + 1\\n  }\\n  found\\n}\\n\\n// Locate the identifier at (line, col), typecheck the program, and return its\\n// inferred type as a string. Resolution order:\\n//   1. per-node type table (covers LOCALS and PARAMETERS — names that live in\\n//      nested inference scopes and are gone from the returned TypeEnv);\\n//   2. fall back to the top-level TypeEnv lookup (top-level / imported names,\\n//      and let-binding definition sites whose offset is not an EIdent node).\\n// Returns \\\"\\\" when the position is not over a located identifier, or the name\\n// resolves nowhere. Any failure is swallowed and yields \\\"\\\".\\nexport fn type_at_source(source: String, line: Int, col: Int) -> String {\\n  handle {\\n    let tgt = line_col_to_offset(source, line, col)\\n    if tgt < 0 {\\n      // Out-of-range (line, col): invalid `line`/`col` (< 1), `line` beyond\\n      // EOF, or `col` past the end of that line's content (#947). No position\\n      // to resolve, so no hover — matches the \\\"position not over a located\\n      // identifier\\\" empty-result convention below.\\n      \\\"\\\"\\n    } else {\\n    let (tokens, starts, ends) = lex_with_offsets(source)\\n    let stmts = parse_program_located(tokens, starts, source)\\n    let hits = empty_hits()\\n    // Identifier USES carry real offsets on their EIdent nodes.\\n    collect_stmts(stmts, hits)\\n    // Identifier DEFINITIONS (let-binding names) carry none, so recover their\\n    // source offset from each statement's span and the source text.\\n    let (span_stmts, span_start, span_end) = parse_program_spans(tokens, starts, ends)\\n    collect_binding_name_hits(span_stmts, span_start, span_end, source, hits)\\n    let name = pick_ident_at(hits, tgt)\\n    if name == \\\"\\\" {\\n      \\\"\\\"\\n    } else {\\n      let chosen_off = pick_ident_off(hits, tgt)\\n      // 1. per-node type table (locals + parameters).\\n      let (table, final_s) = check_program_type_table(stmts)\\n      let table_hit = if chosen_off >= 0 {\\n        tytab_lookup(table, chosen_off)\\n      } else {\\n        None\\n      }\\n      match table_hit {\\n        Some(rec_ty) => type_to_string(subst_apply(final_s, rec_ty)),\\n        None => {\\n          // 2. fall back to the top-level env (top-level / imported names).\\n          let env = check_program(stmts)\\n          match env_lookup(env, name) {\\n            Some(t) => type_to_string(t),\\n            None => \\\"\\\"\\n          }\\n        }\\n      }\\n    }\\n    }\\n  } with Error {\\n    Throw(_) => \\\"\\\"\\n  }\\n}\\n\")\n}\n\nlet cli_adapter_source_131 = () -> (String, String) {\n  (\"lib/@vibe/compiler/runtime/binding_at.vibe\",\n\"//# Imports\\n\\n// `vibe binding-at` — AST-accurate, scope-aware binding occurrences: the\\n// foundation for scope-precision rename / references (テーマ4). Given a\\n// (line, col), locate the identifier under the cursor and return the source\\n// spans of every occurrence that resolves to the SAME binding — not merely the\\n// same NAME.\\n//\\n// Why this is better than a text scan: occurrences are taken from the real\\n// parsed AST, so there are NO false matches inside string literals, comments, or\\n// as substrings of a longer word — only actual identifier nodes count.\\n//\\n// SCOPE AWARENESS (テーマ4): a scope-stack walk resolves every `EIdent(name,off)`\\n// REFERENCE to the nearest enclosing introduction of `name` — a `let` / `let mut`\\n// local, a function/lambda parameter, a `for` binder, a `loop` parameter, or a\\n// match/handle pattern binder. Each introduction gets a unique binding id;\\n// references that resolve to the same introduction share it, so two distinct\\n// same-named locals (e.g. `x` in one function vs `x` in another, or a shadowing\\n// inner `let x`) are NOT conflated. A reference that resolves to no local\\n// introduction is treated as a module-level / free name and grouped FILE-WIDE by\\n// name (canonical key 0), so top-level `export let f` references across the file\\n// still resolve together.\\n//\\n// BINDER OFFSET RECOVERY: the AST stores binder NAMES as plain Strings without\\n// offsets (only `EIdent` carries an offset). We recover a binder's source span by\\n// scanning the source for the next whole-word occurrence of the name from a\\n// monotonically-advancing floor, walking constructs in source order. This is the\\n// same whole-word-scan machinery the previous name-wide implementation used for\\n// top-level binding names, generalized to nested binders.\\n//\\n// FALLBACK (honest): for `match`/`handle` arms whose patterns introduce nested\\n// sub-binders (ctor / tuple / struct / or patterns) the names ARE introduced into\\n// scope so references resolve correctly, but if a particular binder's source\\n// offset cannot be recovered from the floor its own occurrence span is omitted\\n// (the rename set may miss the binder site itself, never a crash). Resolution\\n// never crashes: any failure is swallowed and yields an empty list.\\n//\\n// All strings are built with String::concat only (never `+`, never \\\"\\\\{x}\\\"\\n// interpolation): both mis-codegen to NUL in selfhost.\\n\\nimport ../core {\\n  Stmt, Expr, Pat\\n}\\n\\nimport ../syntax {\\n  lex_with_offsets, parse_program_located\\n}\\n\\n//# Functions\\n\\n// 1-based (line, col) -> 0-based char offset. Mirror of type_at.vibe's\\n// line_col_to_offset (kept in sync — see its comment for the full rationale):\\n// count newlines to reach the target line, add (col - 1). Returns -1\\n// (invalid / no position) rather than clamping (#947) for `line`/`col` < 1,\\n// `line` beyond EOF, or `col` past the end of that line's content (previously\\n// unclamped, so a large `col` silently resolved into the NEXT line's\\n// identifier). CRLF: a line's addressable content excludes a trailing '\\\\r'\\n// before the '\\\\n', so query positions on CRLF files don't drift.\\nfn bind_line_col_to_offset(source: String, line: Int, col: Int) -> Int {\\n  if line < 1 || col < 1 {\\n    -1\\n  } else {\\n    let len = String::length(source)\\n    let mut i = 0\\n    let mut cur_line = 1\\n    while cur_line < line && i < len {\\n      if String::char_code_at(source, i) == 10 {\\n        cur_line = cur_line + 1\\n      } else {\\n        ()\\n      }\\n      i = i + 1\\n    }\\n    if cur_line < line {\\n      -1\\n    } else {\\n      let mut line_end = i\\n      while line_end < len && String::char_code_at(source, line_end) != 10 {\\n        line_end = line_end + 1\\n      }\\n      let content_end = if line_end > i && String::char_code_at(source, line_end - 1) == 13 {\\n        line_end - 1\\n      } else {\\n        line_end\\n      }\\n      let off = i + (col - 1)\\n      if off > content_end {\\n        -1\\n      } else {\\n        off\\n      }\\n    }\\n  }\\n}\\n\\n// A located occurrence resolved to a binding:\\n//   BindHit(name, off, key)\\n// where `off` is the start source offset (its span is [off, off+length(name)))\\n// and `key` is the canonical binding id this occurrence resolves to. key 0 means\\n// \\\"module-level / free name, grouped file-wide by name\\\". `off` is -1 for\\n// synthetic / non-located nodes, which the search ignores.\\nenum BindHit {\\n  BindHit(String, Int, Int)\\n}\\n\\nfn bind_empty_hits() -> Array[BindHit] {\\n  Array::slice([\\n    BindHit(\\\"\\\", -1, 0)\\n  ], 0, 0)\\n}\\n\\n// True when `source[off]` is NOT an identifier char (or off out of range) — a\\n// word boundary. Used to match a binding name as a whole word.\\nfn bind_is_boundary_at(source: String, off: Int) -> Bool {\\n  if off < 0 || off >= String::length(source) {\\n    true\\n  } else {\\n    let c = String::char_code_at(source, off)\\n    let is_id = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_'\\n    !is_id\\n  }\\n}\\n\\n// Find the start offset of the first whole-word occurrence of `name` in\\n// `source` at or after `from`. Returns -1 when not found. Recovers a source\\n// offset for a binder NAME, which the parser stores only as a String.\\nfn bind_find_word(source: String, name: String, from: Int) -> Int {\\n  let nlen = String::length(name)\\n  if nlen == 0 {\\n    -1\\n  } else {\\n    let limit = String::length(source)\\n    let mut i = if from < 0 { 0 } else { from }\\n    let mut found = -1\\n    while found < 0 && i + nlen <= limit {\\n      if String::substring(source, i, i + nlen) == name && bind_is_boundary_at(source, i - 1) && bind_is_boundary_at(source, i + nlen) {\\n        found = i\\n      } else {\\n        i = i + 1\\n      }\\n    }\\n    found\\n  }\\n}\\n\\n// Mutable walk state threaded through the AST traversal:\\n//   hits        — collected occurrences (references + recovered binders)\\n//   scope_names — scope-stack of in-scope binder names (parallel to scope_ids)\\n//   scope_ids   — scope-stack of binder ids (parallel to scope_names)\\n//   floor       — boxed monotonically-advancing scan floor for binder recovery\\n//   source      — the program text\\n//\\n// Binding ids are NOT a separate counter: each binder's canonical id is its\\n// recovered source offset + 1 (unique per binder, and >= 1 so it never collides\\n// with the module/free key 0). This avoids a separate mutable id-counter field.\\nstruct BindState {\\n  hits: Array[BindHit];\\n  scope_names: Array[String];\\n  scope_ids: Array[Int];\\n  floor: Array[Int];\\n  source: String\\n}\\n\\n// A fresh single-cell mutable Int array holding `v` (a poor-man's mutable box).\\n// Built via the slice+push idiom so the cell is a heap array supporting\\n// Array::set, not a static read-only literal.\\nfn bind_box_int(v: Int) -> Array[Int] {\\n  let arr = Array::slice([0], 0, 0)\\n  Array::push(arr, v)\\n  arr\\n}\\n\\nfn bind_new_state(source: String) -> BindState {\\n  BindState::{\\n    hits: bind_empty_hits(),\\n    scope_names: Array::slice([\\\"\\\"], 0, 0),\\n    scope_ids: Array::slice([0], 0, 0),\\n    floor: bind_box_int(0),\\n    source: source\\n  }\\n}\\n\\n// Resolve `name` to the nearest enclosing scope id, scanning the scope stack from\\n// the top (end) down. Returns 0 (module-level / free, grouped file-wide) when no\\n// local introduction is in scope.\\nfn bind_resolve(st: BindState, name: String) -> Int {\\n  let n = Array::length(st.scope_names)\\n  let mut i = n - 1\\n  let mut found = 0\\n  while i >= 0 && found == 0 {\\n    if Array::get(st.scope_names, i) == name {\\n      found = Array::get(st.scope_ids, i)\\n    } else {\\n      ()\\n    }\\n    i = i - 1\\n  }\\n  found\\n}\\n\\n// Pop the scope stack back down to `mark` entries.\\nfn bind_pop_scope(st: BindState, mark: Int) -> Unit {\\n  Array::truncate(st.scope_names, mark)\\n  Array::truncate(st.scope_ids, mark)\\n}\\n\\n// Recover a binder's source offset (from the scan floor forward), record it as an\\n// occurrence, advance the floor past it, and return its unique binding id (off+1,\\n// always >= 1; or 0 when the offset cannot be recovered — see file header\\n// FALLBACK note). Does NOT push to scope — callers control when the binder enters\\n// scope (e.g. a non-recursive `let x = v` must recover x's offset textually\\n// before v, yet not have x in scope while walking v).\\nfn bind_recover_binder(st: BindState, name: String) -> Int {\\n  let from = Array::get(st.floor, 0)\\n  let off = bind_find_word(st.source, name, from)\\n  let id = if off >= 0 { off + 1 } else { 0 }\\n  if off >= 0 {\\n    Array::push(st.hits, BindHit(name, off, id))\\n    Array::set(st.floor, 0, off + String::length(name))\\n  } else {\\n    ()\\n  }\\n  id\\n}\\n\\n// Push a binder (name, id) onto the current scope.\\nfn bind_push_binder(st: BindState, name: String, id: Int) -> Unit {\\n  Array::push(st.scope_names, name)\\n  Array::push(st.scope_ids, id)\\n}\\n\\n// Introduce a binder: recover its offset/id then immediately push it into scope.\\n// Used where the binder's scope begins right at the binder site (params, for /\\n// loop binders, match-pattern binders).\\nfn bind_introduce(st: BindState, name: String) -> Unit {\\n  let id = bind_recover_binder(st, name)\\n  bind_push_binder(st, name, id)\\n}\\n\\n// Record a reference `EIdent(name, off)`: resolve it to the nearest enclosing\\n// binding (or 0 = module-level/free) and store its located span. Advance the\\n// floor past it so later binder recovery does not re-find an earlier position.\\nfn bind_record_ref(st: BindState, name: String, off: Int) -> Unit {\\n  if off >= 0 {\\n    let key = bind_resolve(st, name)\\n    Array::push(st.hits, BindHit(name, off, key))\\n    if off >= Array::get(st.floor, 0) {\\n      Array::set(st.floor, 0, off + String::length(name))\\n    } else {\\n      ()\\n    }\\n  } else {\\n    ()\\n  }\\n}\\n\\n// Record an assignment target `name = ...` / `name op= ...`. Resolve to the\\n// enclosing binding and recover the name's source offset from the floor (the\\n// target name has no stored offset).\\nfn bind_record_assign_target(st: BindState, name: String) -> Unit {\\n  let key = bind_resolve(st, name)\\n  let from = Array::get(st.floor, 0)\\n  let off = bind_find_word(st.source, name, from)\\n  if off >= 0 {\\n    Array::push(st.hits, BindHit(name, off, key))\\n    Array::set(st.floor, 0, off + String::length(name))\\n  } else {\\n    ()\\n  }\\n}\\n\\n// Introduce the names bound by a pattern (PBind directly; nested binders in\\n// ctor / tuple / struct / or patterns recursively). Each is introduced into the\\n// current scope.\\nfn bind_introduce_pat(st: BindState, pat: Pat) -> Unit {\\n  match pat {\\n    PWild => (),\\n    PBind(name) => bind_introduce(st, name),\\n    PInt(_) => (),\\n    PFloat(_) => (),\\n    PString(_) => (),\\n    PBool(_) => (),\\n    PCtor(_, sub) => bind_introduce_pats(st, sub),\\n    PTuple(sub) => bind_introduce_pats(st, sub),\\n    POr(a, b) => {\\n      bind_introduce_pat(st, a)\\n      bind_introduce_pat(st, b)\\n    },\\n    PStruct(_, fields) => {\\n      let mut i = 0\\n      while i < Array::length(fields) {\\n        let (_, fp) = Array::get(fields, i)\\n        bind_introduce_pat(st, fp)\\n        i = i + 1\\n      }\\n    }\\n  }\\n}\\n\\nfn bind_introduce_pats(st: BindState, sub: Array[Pat]) -> Unit {\\n  let mut i = 0\\n  while i < Array::length(sub) {\\n    bind_introduce_pat(st, Array::get(sub, i))\\n    i = i + 1\\n  }\\n}\\n\\n// Scope-aware walker. `st.hits` accumulates references (resolved to a binding id)\\n// and recovered binders. Every Expr arm is enumerated so a new variant is a\\n// compile error here, keeping the collector in sync with the AST.\\nfn bind_walk_expr(st: BindState, expr: Expr) -> Unit {\\n  match expr {\\n    EInt(_) => (),\\n    EFloat(_) => (),\\n    EString(_) => (),\\n    EBool(_) => (),\\n    EIdent(name, off) => bind_record_ref(st, name, off),\\n    EUnit => (),\\n    EStringInterp(_) => (),\\n    ETuple(items) => bind_walk_exprs(st, items),\\n    EArray(items) => bind_walk_exprs(st, items),\\n    ERecord(_, fields, _) => bind_walk_field_exprs(st, fields),\\n    EIf(c, t, e) => {\\n      bind_walk_expr(st, c)\\n      bind_walk_expr(st, t)\\n      bind_walk_expr(st, e)\\n    },\\n    ELet(name, v, b, _) => {\\n      // `let name = v; b`: the binder is textually BEFORE v, so recover its\\n      // offset first (advancing the floor past it), but keep it OUT of scope while\\n      // walking v — a non-recursive `let x = x + 1` references the OUTER x. Then\\n      // push it into scope for b only.\\n      let id = bind_recover_binder(st, name)\\n      bind_walk_expr(st, v)\\n      let mark = Array::length(st.scope_names)\\n      bind_push_binder(st, name, id)\\n      bind_walk_expr(st, b)\\n      bind_pop_scope(st, mark)\\n    },\\n    ELetRec(name, v, b) => {\\n      // recursive let: name is in scope for both v and b.\\n      let mark = Array::length(st.scope_names)\\n      bind_introduce(st, name)\\n      bind_walk_expr(st, v)\\n      bind_walk_expr(st, b)\\n      bind_pop_scope(st, mark)\\n    },\\n    ELetMut(name, v, b, _) => {\\n      // same binder-before-value ordering as ELet.\\n      let id = bind_recover_binder(st, name)\\n      bind_walk_expr(st, v)\\n      let mark = Array::length(st.scope_names)\\n      bind_push_binder(st, name, id)\\n      bind_walk_expr(st, b)\\n      bind_pop_scope(st, mark)\\n    },\\n    EAssign(name, v, b) => {\\n      // assignment target is a reference to an in-scope binding.\\n      bind_record_assign_target(st, name)\\n      bind_walk_expr(st, v)\\n      bind_walk_expr(st, b)\\n    },\\n    EAssignOp(name, _, v, b) => {\\n      bind_record_assign_target(st, name)\\n      bind_walk_expr(st, v)\\n      bind_walk_expr(st, b)\\n    },\\n    ESeq(a, b) => {\\n      bind_walk_expr(st, a)\\n      bind_walk_expr(st, b)\\n    },\\n    EMatch(s, arms) => {\\n      bind_walk_expr(st, s)\\n      bind_walk_arms(st, arms)\\n    },\\n    EHandle(s, arms) => {\\n      bind_walk_expr(st, s)\\n      bind_walk_arms(st, arms)\\n    },\\n    EWhile(c, b) => {\\n      bind_walk_expr(st, c)\\n      bind_walk_expr(st, b)\\n    },\\n    ELoop(params, b) => {\\n      // loop params introduce names scoped to b; init exprs are outside scope.\\n      let mark = Array::length(st.scope_names)\\n      let mut i = 0\\n      while i < Array::length(params) {\\n        let (pname, init) = Array::get(params, i)\\n        bind_walk_expr(st, init)\\n        bind_introduce(st, pname)\\n        i = i + 1\\n      }\\n      bind_walk_expr(st, b)\\n      bind_pop_scope(st, mark)\\n    },\\n    EForIn(name, idx_opt, it, b) => {\\n      bind_walk_expr(st, it)\\n      let mark = Array::length(st.scope_names)\\n      bind_introduce(st, name)\\n      match idx_opt {\\n        Some(idx) => bind_introduce(st, idx),\\n        None => ()\\n      }\\n      bind_walk_expr(st, b)\\n      bind_pop_scope(st, mark)\\n    },\\n    ECall(callee, args, _) => {\\n      bind_walk_expr(st, callee)\\n      bind_walk_exprs(st, args)\\n    },\\n    EBinOp(_, l, r) => {\\n      bind_walk_expr(st, l)\\n      bind_walk_expr(st, r)\\n    },\\n    EUnaryOp(_, e) => bind_walk_expr(st, e),\\n    EFn(_, _, params, _, _, body) => {\\n      // function / lambda parameters are scoped to body.\\n      let mark = Array::length(st.scope_names)\\n      let mut i = 0\\n      while i < Array::length(params) {\\n        let (pname, _) = Array::get(params, i)\\n        bind_introduce(st, pname)\\n        i = i + 1\\n      }\\n      bind_walk_expr(st, body)\\n      bind_pop_scope(st, mark)\\n    },\\n    EDot(e, _, _, _) => bind_walk_expr(st, e),\\n    ELabeledArg(_, _, v) => bind_walk_expr(st, v),\\n    EReturn(e) => bind_walk_expr(st, e),\\n    EBreak(opt) => match opt {\\n      Some(v) => bind_walk_expr(st, v),\\n      None => ()\\n    },\\n    EContinue(args) => bind_walk_exprs(st, args),\\n    EMap(fields) => bind_walk_field_exprs(st, fields),\\n    ESpread(e) => bind_walk_expr(st, e)\\n  }\\n}\\n\\nfn bind_walk_exprs(st: BindState, items: Array[Expr]) -> Unit {\\n  let mut i = 0\\n  while i < Array::length(items) {\\n    bind_walk_expr(st, Array::get(items, i))\\n    i = i + 1\\n  }\\n}\\n\\nfn bind_walk_field_exprs(st: BindState, fields: Array[(String, Expr)]) -> Unit {\\n  let mut i = 0\\n  while i < Array::length(fields) {\\n    let (_, v) = Array::get(fields, i)\\n    bind_walk_expr(st, v)\\n    i = i + 1\\n  }\\n}\\n\\n// A match/handle arm: the pattern binders are scoped to the arm body only.\\nfn bind_walk_arms(st: BindState, arms: Array[(Pat, Expr)]) -> Unit {\\n  let mut i = 0\\n  while i < Array::length(arms) {\\n    let (pat, e) = Array::get(arms, i)\\n    let mark = Array::length(st.scope_names)\\n    bind_introduce_pat(st, pat)\\n    bind_walk_expr(st, e)\\n    bind_pop_scope(st, mark)\\n    i = i + 1\\n  }\\n}\\n\\n// Record a top-level / module-level binder NAME. These group file-wide (key 0),\\n// so all references to the same module name resolve together. We recover the\\n// binder's offset from the floor.\\nfn bind_record_module_binder(st: BindState, name: String) -> Unit {\\n  let from = Array::get(st.floor, 0)\\n  let off = bind_find_word(st.source, name, from)\\n  if off >= 0 {\\n    Array::push(st.hits, BindHit(name, off, 0))\\n    Array::set(st.floor, 0, off + String::length(name))\\n  } else {\\n    ()\\n  }\\n}\\n\\n// Walk a statement. Top-level value bindings (SLet/SLetMut) introduce a\\n// module-level name (key 0 => grouped file-wide); we record the binder's located\\n// NAME and walk the body. SModule recurses.\\nfn bind_walk_stmt(st: BindState, stmt: Stmt) -> Unit {\\n  match stmt {\\n    SLet(_, _, name, _, body) => {\\n      bind_record_module_binder(st, name)\\n      bind_walk_expr(st, body)\\n    },\\n    SLetMut(name, _, body) => {\\n      bind_record_module_binder(st, name)\\n      bind_walk_expr(st, body)\\n    },\\n    STest(_, body) => bind_walk_expr(st, body),\\n    SBench(_, body) => bind_walk_expr(st, body),\\n    SExpr(e) => bind_walk_expr(st, e),\\n    SLetPat(_, body) => bind_walk_expr(st, body),\\n    SModule(_, _, body) => bind_walk_stmts(st, body),\\n    _ => ()\\n  }\\n}\\n\\nfn bind_walk_stmts(st: BindState, stmts: Array[Stmt]) -> Unit {\\n  let mut i = 0\\n  while i < Array::length(stmts) {\\n    bind_walk_stmt(st, Array::get(stmts, i))\\n    i = i + 1\\n  }\\n}\\n\\n// Among all hits whose span [off, off+len(name)) contains `tgt`, pick the one\\n// with the largest `off` (innermost / closest start). Returns the (name, key) of\\n// that hit, or (\\\"\\\", 0) when none.\\nfn bind_pick_at(hits: Array[BindHit], tgt: Int) -> (String, Int) {\\n  let mut best_name = \\\"\\\"\\n  let mut best_key = 0\\n  let mut best_off = -1\\n  let mut i = 0\\n  while i < Array::length(hits) {\\n    match Array::get(hits, i) {\\n      BindHit(name, off, key) => {\\n        let span_end = off + String::length(name)\\n        if off >= 0 && off <= tgt && tgt < span_end && off > best_off {\\n          best_name = name\\n          best_key = key\\n          best_off = off\\n        } else {\\n          ()\\n        }\\n      }\\n    }\\n    i = i + 1\\n  }\\n  (best_name, best_key)\\n}\\n\\n// Insert (start, end) into `out` keeping it sorted by start ascending and\\n// de-duplicated (skip when an identical start is already present — equal starts\\n// imply equal spans because the name length is fixed).\\nfn bind_insert_sorted_unique(out: Array[(Int, Int)], start: Int, end: Int) -> Unit {\\n  let n = Array::length(out)\\n  let mut dup = false\\n  let mut idx = n\\n  let mut j = 0\\n  while j < n {\\n    let (s, _) = Array::get(out, j)\\n    if s == start {\\n      dup = true\\n    } else {\\n      ()\\n    }\\n    if s > start && idx == n {\\n      idx = j\\n    } else {\\n      ()\\n    }\\n    j = j + 1\\n  }\\n  if dup {\\n    ()\\n  } else if idx == n {\\n    Array::push(out, (start, end))\\n  } else {\\n    Array::push(out, Array::get(out, n - 1))\\n    let mut k = n - 1\\n    while k > idx {\\n      Array::set(out, k, Array::get(out, k - 1))\\n      k = k - 1\\n    }\\n    Array::set(out, idx, (start, end))\\n  }\\n}\\n\\n// Collect the (start, end) source spans of every occurrence that resolves to the\\n// SAME binding as the identifier under the cursor at 1-based (line, col). Steps:\\n//   1. lex + parse located; scope-aware walk collecting located references\\n//      (resolved to a binding id) plus recovered binders.\\n//   2. find the (name, key) covering the cursor offset; \\\"\\\" -> no occurrences.\\n//   3. emit a span for every hit with the same name AND key (key 0 = module /\\n//      free name grouped file-wide), de-duplicated and sorted by start.\\n// AST-accurate and scope-aware (see file header). Any failure is swallowed and\\n// yields an empty list.\\nfn binding_occurrences_impl(source: String, line: Int, col: Int) -> Array[(Int, Int)] with { Error } {\\n  {\\n    let tgt = bind_line_col_to_offset(source, line, col)\\n    let empty_out = Array::slice([\\n      (0, 0)\\n    ], 0, 0)\\n    if tgt < 0 {\\n      // Out-of-range (line, col) — see bind_line_col_to_offset (#947): no\\n      // position to resolve, so no occurrences.\\n      empty_out\\n    } else {\\n    let (tokens, starts, _ends) = lex_with_offsets(source)\\n    let stmts = parse_program_located(tokens, starts, source)\\n    let st = bind_new_state(source)\\n    bind_walk_stmts(st, stmts)\\n    let hits = st.hits\\n    let (name, key) = bind_pick_at(hits, tgt)\\n    let out = Array::slice([\\n      (0, 0)\\n    ], 0, 0)\\n    if name == \\\"\\\" {\\n      out\\n    } else {\\n      let mut i = 0\\n      while i < Array::length(hits) {\\n        match Array::get(hits, i) {\\n          BindHit(hname, hoff, hkey) => {\\n            if hname == name && hkey == key && hoff >= 0 {\\n              bind_insert_sorted_unique(out, hoff, hoff + String::length(hname))\\n            } else {\\n              ()\\n            }\\n          }\\n        }\\n        i = i + 1\\n      }\\n      out\\n    }\\n    }\\n  }\\n}\\n\\nexport fn binding_occurrences(source: String, line: Int, col: Int) -> Array[(Int, Int)] {\\n  handle {\\n    binding_occurrences_impl(source, line, col)\\n  } with Error {\\n    Throw(_) => Array::slice([\\n      (0, 0)\\n    ], 0, 0)\\n  }\\n}\\n\")\n}\n\nlet cli_adapter_source_132 = () -> (String, String) {\n  (\"lib/@vibe/compiler/runtime/symbol_spans.vibe\",\n\"//# Imports\\n\\n// `vibe symbols` — AST-accurate top-level (and module-nested) declaration spans:\\n// the foundation for scope-precision document outline / go-to-definition\\n// (テーマ4 LSP). Given a source string, return one record per declared symbol:\\n//   (name, kind, start, end)\\n// where `kind` is an LSP SymbolKind number and [start, end) is the source span\\n// of the declaration NAME (char offsets).\\n//\\n// Why this beats the LSP server's previous line-regex scan: declarations are\\n// taken from the real parsed AST, so multi-line declarations, declarations not\\n// starting at column 0, and names that merely look like keywords inside strings\\n// or comments are handled correctly — only actual declaration nodes count. The\\n// name's source offset is recovered by a whole-word scan SCOPED to that\\n// statement's parse span (from parse_program_spans), so a name that also appears\\n// elsewhere in the statement body cannot be mis-located.\\n//\\n// FALLBACK (honest): a name whose offset cannot be recovered within its span is\\n// simply omitted (never a crash). Resolution never throws: any failure is\\n// swallowed and yields an empty list, so the LSP degrades to its regex scan.\\n//\\n// All strings are built with String::concat only (never `+`, never \\\"\\\\{x}\\\"\\n// interpolation): both mis-codegen to NUL in selfhost.\\n\\nimport ../core {\\n  Stmt, Expr\\n}\\n\\nimport ../syntax {\\n  lex_with_offsets, parse_program_spans\\n}\\n\\n//# Functions\\n\\n// True when `source[off]` is NOT an identifier char (or off out of range) — a\\n// word boundary. Used to match a declaration name as a whole word.\\nfn sym_is_boundary_at(source: String, off: Int) -> Bool {\\n  if off < 0 || off >= String::length(source) {\\n    true\\n  } else {\\n    let c = String::char_code_at(source, off)\\n    let is_id = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_'\\n    !is_id\\n  }\\n}\\n\\n// A fresh single-cell mutable Int array holding `v` (a poor-man's mutable box),\\n// built via slice+push so the cell is a heap array supporting Array::set.\\nfn sym_box_int(v: Int) -> Array[Int] {\\n  let arr = Array::slice([0], 0, 0)\\n  Array::push(arr, v)\\n  arr\\n}\\n\\nfn sym_empty_items() -> Array[(String, Int, Int, Int)] {\\n  Array::slice([\\n    (\\\"\\\", 0, 0, 0)\\n  ], 0, 0)\\n}\\n\\n// Find the first whole-word occurrence of `name` in `source[from..hi)` and, when\\n// found, push `(name, kind, off, off+len)` and advance `floor` past it (so a\\n// later sibling declaration in the same window keeps scanning forward). No-op\\n// when the name cannot be located in the window.\\nfn sym_emit(out: Array[(String, Int, Int, Int)], source: String, name: String, kind: Int, floor: Array[Int], hi: Int) -> Unit {\\n  let nlen = String::length(name)\\n  if nlen == 0 {\\n    ()\\n  } else {\\n    let limit = if hi > String::length(source) { String::length(source) } else { hi }\\n    let mut i = Array::get(floor, 0)\\n    if i < 0 {\\n      i = 0\\n    } else {\\n      ()\\n    }\\n    let mut found = false\\n    while !found && i + nlen <= limit {\\n      if String::substring(source, i, i + nlen) == name && sym_is_boundary_at(source, i - 1) && sym_is_boundary_at(source, i + nlen) {\\n        Array::push(out, (name, kind, i, i + nlen))\\n        Array::set(floor, 0, i + nlen)\\n        found = true\\n      } else {\\n        i = i + 1\\n      }\\n    }\\n  }\\n}\\n\\n// LSP SymbolKind for a top-level value binding: Function (12) when its body is a\\n// lambda, else Variable (13).\\nfn sym_let_kind(body: Expr) -> Int {\\n  match body {\\n    EFn(_, _, _, _, _, _) => 12,\\n    _ => 13\\n  }\\n}\\n\\n// Emit the symbol for one statement within the window [floor, hi). SModule emits\\n// the module name (kind 2 = Module) then recurses into its body, threading the\\n// SAME advancing floor so nested declarations are located in source order.\\nfn sym_walk_stmt(out: Array[(String, Int, Int, Int)], source: String, stmt: Stmt, floor: Array[Int], hi: Int) -> Unit {\\n  match stmt {\\n    SLet(_, _, name, _, body) => sym_emit(out, source, name, sym_let_kind(body), floor, hi),\\n    SLetMut(name, _, _) => sym_emit(out, source, name, 13, floor, hi),\\n    SEnum(_, name, _, _, _) => sym_emit(out, source, name, 10, floor, hi),\\n    SSuberror(_, name, _) => sym_emit(out, source, name, 10, floor, hi),\\n    SStruct(_, name, _, _, _, _) => sym_emit(out, source, name, 23, floor, hi),\\n    STypeAlias(_, name, _, _) => sym_emit(out, source, name, 26, floor, hi),\\n    STrait(_, name, _, _, _) => sym_emit(out, source, name, 11, floor, hi),\\n    SEffectDef(_, name, _, _) => sym_emit(out, source, name, 24, floor, hi),\\n    SModule(_, name, body) => {\\n      sym_emit(out, source, name, 2, floor, hi)\\n      let mut j = 0\\n      while j < Array::length(body) {\\n        sym_walk_stmt(out, source, Array::get(body, j), floor, hi)\\n        j = j + 1\\n      }\\n    },\\n    _ => ()\\n  }\\n}\\n\\n// Collect declaration symbols. Steps:\\n//   1. lex + parse with per-statement spans (parse_program_spans).\\n//   2. for each top-level statement, scan its own [start, end) span for the\\n//      declaration name and emit (name, kind, start, end); SModule recurses.\\n// AST-accurate (see file header). Any failure is swallowed -> empty list.\\nfn symbol_spans_impl(source: String) -> Array[(String, Int, Int, Int)] with { Error } {\\n  {\\n    let (tokens, starts, ends) = lex_with_offsets(source)\\n    let (span_stmts, span_start, span_end) = parse_program_spans(tokens, starts, ends)\\n    let out = sym_empty_items()\\n    let mut i = 0\\n    while i < Array::length(span_stmts) {\\n      let lo = if i < Array::length(span_start) { Array::get(span_start, i) } else { 0 }\\n      let hi = if i < Array::length(span_end) { Array::get(span_end, i) } else { String::length(source) }\\n      let floor = sym_box_int(lo)\\n      sym_walk_stmt(out, source, Array::get(span_stmts, i), floor, hi)\\n      i = i + 1\\n    }\\n    out\\n  }\\n}\\n\\nexport fn symbol_spans(source: String) -> Array[(String, Int, Int, Int)] {\\n  handle {\\n    symbol_spans_impl(source)\\n  } with Error {\\n    Throw(_) => Array::slice([\\n      (\\\"\\\", 0, 0, 0)\\n    ], 0, 0)\\n  }\\n}\\n\")\n}\n\nlet cli_adapter_source_133 = () -> (String, String) {\n  (\"lib/@vibe/compiler/runtime/persistent_env_codec.vibe\",\n\"//# Imports\\n\\nimport ../cache/persistent_cache.vibe {\\n  compact_string_fingerprint, normalize_persistent_cache_text, package_index_deps_are_current, persistent_dep_list_cache_path, persistent_leaf_fingerprint_cache_path, persistent_type_env_cache_path\\n}\\n\\nimport ../core {\\n  Type, TypeEnv, env_flat_bindings\\n}\\n\\n//# Functions\\n\\nfn parse_int_unwrap(raw: String, fallback: Int) -> Int {\\n  let len = String::length(raw)\\n  let mut result = 0\\n  let mut i = 0\\n  let mut neg = false\\n  let mut valid = true\\n  if len == 0 { valid = false }\\n  if valid {\\n    if String::char_code_at(raw, 0) == 45 { neg = true; i = 1 }\\n  }\\n  while valid {\\n    if i >= len { break }\\n    let c = String::char_code_at(raw, i)\\n    if c < 48 { valid = false }\\n    else if c > 57 { valid = false }\\n    else {\\n      result = result * 10 + (c - 48)\\n      i = i + 1\\n    }\\n  }\\n  if valid {\\n    if neg { 0 - result } else result\\n  } else fallback\\n}\\n\\nfn serialize_segment(text: String) -> String {\\n  let len = String::length(text)\\n  let len_str = __to_string(len)\\n  let colon_text = String::concat(\\\":\\\", text)\\n  String::concat(len_str, colon_text)\\n}\\n\\nfn decode_effect_name(raw: String) -> String {\\n  if raw == \\\"\\\" || raw == \\\"0\\\" {\\n    \\\"\\\"\\n  } else if raw == \\\"1\\\" {\\n    \\\"Error\\\"\\n  } else {\\n    raw\\n  }\\n}\\n\\nfn parse_count_header(text: String, pos: Int, terminator: Int) -> (Int, Int) with { Error } {\\n  let len = String::length(text)\\n  let mut i = pos\\n  while i < len && String::char_code_at(text, i) != terminator {\\n    i = i + 1\\n  }\\n  if i >= len {\\n    throw(\\\"invalid persistent type env payload\\\")\\n  } else {\\n    let parsed = parse_int_unwrap(text[pos: i], 0)\\n    (parsed, i + 1)\\n  }\\n}\\n\\nfn parse_segment(text: String, pos: Int) -> (String, Int) with { Error } {\\n  let (seg_len, start) = parse_count_header(text, pos, 58)\\n  let end = start + seg_len\\n  if end > String::length(text) {\\n    throw(\\\"invalid persistent type env segment\\\")\\n  } else {\\n    (text[start: end], end)\\n  }\\n}\\n\\nfn parse_int_array(text: String, pos: Int) -> (Array[Int], Int) with { Error } {\\n  let (count, start) = parse_count_header(text, pos, 91)\\n  let items = Array::slice([\\n    0\\n  ], 0, 0)\\n  let mut i = 0\\n  let mut cursor = start\\n  while i < count {\\n    let (raw, next_cursor) = parse_segment(text, cursor)\\n    let parsed_val = parse_int_unwrap(raw, 0)\\n    Array::push(items, parsed_val)\\n    cursor = next_cursor\\n    i = i + 1\\n  }\\n  if cursor >= String::length(text) || String::char_code_at(text, cursor) != 93 {\\n    throw(\\\"invalid persistent type env int array\\\")\\n  } else {\\n    (items, cursor + 1)\\n  }\\n}\\n\\nfn parse_string_array(text: String, pos: Int) -> (Array[String], Int) with { Error } {\\n  let (count, start) = parse_count_header(text, pos, 91)\\n  let items = Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n  let mut i = 0\\n  let mut cursor = start\\n  while i < count {\\n    let (item, next_cursor) = parse_segment(text, cursor)\\n    Array::push(items, item)\\n    cursor = next_cursor\\n    i = i + 1\\n  }\\n  if cursor >= String::length(text) || String::char_code_at(text, cursor) != 93 {\\n    throw(\\\"invalid persistent type env string array\\\")\\n  } else {\\n    (items, cursor + 1)\\n  }\\n}\\n\\nfn parse_bounds_array(text: String, pos: Int) -> (Array[(Int, Array[String])], Int) with { Error } {\\n  let (count, start) = parse_count_header(text, pos, 91)\\n  let items = Array::slice([\\n    (0, Array::slice([\\n      \\\"\\\"\\n    ], 0, 0))\\n  ], 0, 0)\\n  let mut i = 0\\n  let mut cursor = start\\n  while i < count {\\n    let (raw_id, next_cursor) = parse_segment(text, cursor)\\n    let (bounds, next_cursor2) = parse_string_array(text, next_cursor)\\n    let parsed_id = parse_int_unwrap(raw_id, 0)\\n    Array::push(items, (parsed_id, bounds))\\n    cursor = next_cursor2\\n    i = i + 1\\n  }\\n  if cursor >= String::length(text) || String::char_code_at(text, cursor) != 93 {\\n    throw(\\\"invalid persistent type env bounds array\\\")\\n  } else {\\n    (items, cursor + 1)\\n  }\\n}\\n\\nfn parse_cached_type(source: String, pos: Int) -> (Type, Int) with { Error } {\\n  let rec parse_type_array: (String, Int) -> (Array[Type], Int) with { Error } = (text, pos) -> {\\n    let (count, start) = parse_count_header(text, pos, 91)\\n    let items = Array::slice([\\n      CtUnknown\\n    ], 0, 0)\\n    let mut i = 0\\n    let mut cursor = start\\n    while i < count {\\n      let (raw, next_cursor) = parse_segment(text, cursor)\\n      let (item, end_cursor) = parse_cached_type(raw, 0)\\n      if end_cursor != String::length(raw) {\\n        throw(\\\"invalid persistent type env nested type\\\")\\n      } else {\\n        Array::push(items, item)\\n        cursor = next_cursor\\n        i = i + 1\\n      }\\n    }\\n    if cursor >= String::length(text) || String::char_code_at(text, cursor) != 93 {\\n      throw(\\\"invalid persistent type env type array\\\")\\n    } else {\\n      (items, cursor + 1)\\n    }\\n  }\\n  if pos >= String::length(source) {\\n    throw(\\\"invalid persistent type env type\\\")\\n  } else {\\n    let tag = String::char_code_at(source, pos)\\n    match tag {\\n      73 => (CtInt, pos + 1),\\n      68 => (CtDouble, pos + 1),\\n      66 => (CtBool, pos + 1),\\n      71 => (CtString, pos + 1),\\n      72 => (CtChar, pos + 1),\\n      85 => (CtUnit, pos + 1),\\n      89 => (CtBytes, pos + 1),\\n      88 => (CtUnknown, pos + 1),\\n      86 => {\\n        let (raw, next_pos) = parse_segment(source, pos + 1)\\n        let var_id = parse_int_unwrap(raw, 0)\\n        (CtVar(var_id), next_pos)\\n      },\\n      69 => {\\n        let (name, next_pos) = parse_segment(source, pos + 1)\\n        (CtEnum(name), next_pos)\\n      },\\n      82 => {\\n        let (name, next_pos) = parse_segment(source, pos + 1)\\n        (CtStruct(name), next_pos)\\n      },\\n      65 => {\\n        let (elem, next_pos) = parse_cached_type(source, pos + 1)\\n        (CtArray(elem), next_pos)\\n      },\\n      79 => {\\n        let (elem, next_pos) = parse_cached_type(source, pos + 1)\\n        (CtOption(elem), next_pos)\\n      },\\n      84 => {\\n        let (elems, next_pos) = parse_type_array(source, pos + 1)\\n        (CtTuple(elems), next_pos)\\n      },\\n      70 => {\\n        let (raw_effect, next_pos1) = parse_segment(source, pos + 1)\\n        let (params, next_pos2) = parse_type_array(source, next_pos1)\\n        let (ret, next_pos3) = parse_cached_type(source, next_pos2)\\n        let eff_raw = decode_effect_name(raw_effect)\\n        let eff_name = if String::length(eff_raw) > 0 { Some(eff_raw) } else { None }\\n        (CtFn(params, ret, eff_name), next_pos3)\\n      },\\n      78 => {\\n        let (name, next_pos1) = parse_segment(source, pos + 1)\\n        let (args, next_pos2) = parse_type_array(source, next_pos1)\\n        (CtNamed(name, args), next_pos2)\\n      },\\n      81 => {\\n        let (vars, next_pos1) = parse_int_array(source, pos + 1)\\n        let (bounds, next_pos2) = parse_bounds_array(source, next_pos1)\\n        let (body, next_pos3) = parse_cached_type(source, next_pos2)\\n        (CtForAll(vars, bounds, body), next_pos3)\\n      },\\n      _ => throw(\\\"invalid persistent type env type tag\\\")\\n    }\\n  }\\n}\\n\\n// All `serialize_*_array` helpers below used a `String::concat(out, ...)`\\n// accumulator that was O(N²) over the array length. Cache-serialisation\\n// runs them on every TypeEnv save, and large modules hit thousands of\\n// bindings — the cumulative cost shows up in `vibe check` cold runs.\\n// StringBuilder collapses each one to O(N).\\nfn serialize_int_array(items: Array[Int]) -> String {\\n  let buf = StringBuilder::new()\\n  StringBuilder::push(buf, __to_string(Array::length(items)))\\n  StringBuilder::push(buf, \\\"[\\\")\\n  let mut i = 0\\n  while i < Array::length(items) {\\n    StringBuilder::push(buf, serialize_segment(__to_string(Array::get(items, i))))\\n    i = i + 1\\n  }\\n  StringBuilder::push(buf, \\\"]\\\")\\n  StringBuilder::freeze(buf)\\n}\\n\\nfn serialize_effect_name_str(effect_name: String) -> String {\\n  effect_name\\n}\\n\\nfn serialize_string_array(items: Array[String]) -> String {\\n  let buf = StringBuilder::new()\\n  StringBuilder::push(buf, __to_string(Array::length(items)))\\n  StringBuilder::push(buf, \\\"[\\\")\\n  let mut i = 0\\n  while i < Array::length(items) {\\n    StringBuilder::push(buf, serialize_segment(Array::get(items, i)))\\n    i = i + 1\\n  }\\n  StringBuilder::push(buf, \\\"]\\\")\\n  StringBuilder::freeze(buf)\\n}\\n\\nfn serialize_bounds_array(items: Array[(Int, Array[String])]) -> String {\\n  let buf = StringBuilder::new()\\n  StringBuilder::push(buf, __to_string(Array::length(items)))\\n  StringBuilder::push(buf, \\\"[\\\")\\n  let mut i = 0\\n  while i < Array::length(items) {\\n    let (id, bounds) = Array::get(items, i)\\n    StringBuilder::push(buf, serialize_segment(__to_string(id)))\\n    StringBuilder::push(buf, serialize_string_array(bounds))\\n    i = i + 1\\n  }\\n  StringBuilder::push(buf, \\\"]\\\")\\n  StringBuilder::freeze(buf)\\n}\\n\\nfn serialize_type(ty: Type) -> String {\\n  let rec serialize_type_array: (Array[Type]) -> String = (items) -> {\\n    let buf = StringBuilder::new()\\n    StringBuilder::push(buf, __to_string(Array::length(items)))\\n    StringBuilder::push(buf, \\\"[\\\")\\n    let mut i = 0\\n    while i < Array::length(items) {\\n      StringBuilder::push(buf, serialize_segment(serialize_type(Array::get(items, i))))\\n      i = i + 1\\n    }\\n    StringBuilder::push(buf, \\\"]\\\")\\n    StringBuilder::freeze(buf)\\n  }\\n  match ty {\\n    CtInt => \\\"I\\\",\\n    CtDouble => \\\"D\\\",\\n    CtBool => \\\"B\\\",\\n    CtString => \\\"G\\\",\\n    CtChar => \\\"H\\\",\\n    CtUnit => \\\"U\\\",\\n    CtBytes => \\\"Y\\\",\\n    CtUnknown => \\\"X\\\",\\n    CtVar(id) => String::concat(\\\"V\\\", serialize_segment(__to_string(id))),\\n    CtEnum(name) => String::concat(\\\"E\\\", serialize_segment(name)),\\n    CtStruct(name) => String::concat(\\\"R\\\", serialize_segment(name)),\\n    CtArray(elem) => String::concat(\\\"A\\\", serialize_type(elem)),\\n    CtOption(elem) => String::concat(\\\"O\\\", serialize_type(elem)),\\n    CtTuple(elems) => String::concat(\\\"T\\\", serialize_type_array(elems)),\\n    CtFn(params, ret, effect_name) => {\\n      let eff_str = if effect_name is Some(n) { n } else { \\\"\\\" }\\n      String::concat(\\\"F\\\", String::concat(serialize_segment(eff_str), String::concat(serialize_type_array(params), serialize_type(ret))))\\n    },\\n    CtNamed(name, args) =>\\n    String::concat(\\\"N\\\", String::concat(serialize_segment(name), serialize_type_array(args))),\\n    CtForAll(vars, bounds, body) =>\\n    String::concat(\\\"Q\\\", String::concat(serialize_int_array(vars), String::concat(serialize_bounds_array(bounds), serialize_type(body))))\\n  }\\n}\\n\\nexport fn persistent_dep_list_text(deps: Array[String]) -> String {\\n  if Array::length(deps) == 0 {\\n    \\\"\\\"\\n  } else if Array::length(deps) == 1 {\\n    String::concat(\\\"version\\\\t3\\\\n\\\", Array::get(deps, 0))\\n  } else {\\n    String::concat(\\\"version\\\\t2\\\\n\\\", serialize_string_array(deps))\\n  }\\n}\\n\\nexport fn load_persistent_dep_list(path: String, source: String) -> Option[Array[String]] with { Error, Fs } {\\n  let cache_path = persistent_dep_list_cache_path(path, compact_string_fingerprint(source))\\n  if !(Fs::exists(cache_path)) {\\n    None\\n  } else {\\n    let text = normalize_persistent_cache_text(Fs::read_file(cache_path))\\n    if String::length(text) == 0 {\\n      Some(Array::slice([\\n        \\\"\\\"\\n      ], 0, 0))\\n    } else {\\n      let v2_prefix = \\\"version\\\\t2\\\\n\\\"\\n      let v3_prefix = \\\"version\\\\t3\\\\n\\\"\\n      let text_len = String::length(text)\\n      let v2_len = String::length(v2_prefix)\\n      let v3_len = String::length(v3_prefix)\\n      if text_len >= v2_len &&\\n      text[0: v2_len] == v2_prefix {\\n        let body = text[v2_len: text_len]\\n        let (deps, end_pos) = parse_string_array(body, 0)\\n        if end_pos == String::length(body) {\\n          // #801 follow-up: deps are RESOLVED paths — refuse a list whose\\n          // package-index deps no longer match the current resolution winners\\n          // (written while a store copy existed, or vice versa).\\n          if package_index_deps_are_current(deps) {\\n            Some(deps)\\n          } else {\\n            None\\n          }\\n        } else {\\n          throw(String::concat(\\\"invalid persistent dep list body: \\\", cache_path))\\n        }\\n      } else if text_len >= v3_len &&\\n      text[0: v3_len] == v3_prefix {\\n        let dep = text[v3_len: text_len]\\n        if String::length(dep) == 0 {\\n          Some(Array::slice([\\n            \\\"\\\"\\n          ], 0, 0))\\n        } else {\\n          if package_index_deps_are_current([dep]) {\\n            Some([dep])\\n          } else {\\n            None\\n          }\\n        }\\n      } else {\\n        throw(String::concat(\\\"invalid persistent dep list header: \\\", cache_path))\\n      }\\n    }\\n  }\\n}\\n\\nfn rebuild_persistent_type_env(bindings: Array[(String, Type)]) -> TypeEnv {\\n  EnvFlat(bindings)\\n}\\n\\nexport fn load_persistent_type_env(fingerprint: String) -> Option[TypeEnv] with { Error, Fs } {\\n  let path = persistent_type_env_cache_path(fingerprint)\\n  if !(Fs::exists(path)) {\\n    None\\n  } else {\\n    let lines = String::split(normalize_persistent_cache_text(Fs::read_file(path)), \\\"\\\\n\\\")\\n    let len = Array::length(lines)\\n    let rec go: (Int, Bool, Array[(String, Type)]) -> Option[TypeEnv] with { Error } = (index, version_ok, bindings) -> {\\n      if index >= len {\\n        if version_ok {\\n          Some(rebuild_persistent_type_env(bindings))\\n        } else {\\n          None\\n        }\\n      } else {\\n        let line = Array::get(lines, index)\\n        if String::length(line) == 0 {\\n          go(index + 1, version_ok, bindings)\\n        } else {\\n          let parts = String::split(line, \\\"\\\\t\\\")\\n          if !version_ok {\\n            if Array::length(parts) == 2 &&\\n            Array::get(parts, 0) == \\\"version\\\" &&\\n            Array::get(parts, 1) == \\\"1\\\" {\\n              go(index + 1, true, bindings)\\n            } else {\\n              throw(String::concat(\\\"invalid persistent type env header: \\\", line))\\n            }\\n          } else if Array::length(parts) == 3 && Array::get(parts, 0) == \\\"bind\\\" {\\n            let raw_type = Array::get(parts, 2)\\n            let (ty, end_pos) = parse_cached_type(raw_type, 0)\\n            if end_pos != String::length(raw_type) {\\n              throw(String::concat(\\\"invalid persistent type env bind row: \\\", line))\\n            } else {\\n              // Was `Array::concat(bindings, [tuple])` — O(N) copy per\\n              // row, O(N²) over the file. Linear-recursive accumulation\\n              // through `go`, so push-mutating the shared `bindings`\\n              // is equivalent to the per-call rebuild.\\n              Array::push(bindings, (Array::get(parts, 1), ty))\\n              go(index + 1, true, bindings)\\n            }\\n          } else {\\n            throw(String::concat(\\\"invalid persistent type env row: \\\", line))\\n          }\\n        }\\n      }\\n    }\\n    go(0, false, Array::slice([\\n      (\\\"\\\", CtUnknown)\\n    ], 0, 0))\\n  }\\n}\\n\\nexport fn persistent_type_env_cache_text(env: TypeEnv) -> String {\\n  let bindings = env_flat_bindings(env)\\n  // StringBuilder over the bindings list — was O(N²) via `out =\\n  // String::concat(out, ...)` for N bindings.\\n  let buf = StringBuilder::new()\\n  StringBuilder::push(buf, \\\"version\\\\t1\\\\n\\\")\\n  let mut i = 0\\n  while i < Array::length(bindings) {\\n    let (name, ty) = Array::get(bindings, i)\\n    StringBuilder::push(buf, \\\"bind\\\\t\\\")\\n    StringBuilder::push(buf, name)\\n    StringBuilder::push(buf, \\\"\\\\t\\\")\\n    StringBuilder::push(buf, serialize_type(ty))\\n    StringBuilder::push(buf, \\\"\\\\n\\\")\\n    i = i + 1\\n  }\\n  StringBuilder::freeze(buf)\\n}\\n\\nexport fn load_persistent_leaf_fingerprint(path: String, source: String) -> Option[String] with { Error, Fs } {\\n  let cache_path = persistent_leaf_fingerprint_cache_path(path, compact_string_fingerprint(source))\\n  if !(Fs::exists(cache_path)) {\\n    None\\n  } else {\\n    let text = normalize_persistent_cache_text(Fs::read_file(cache_path))\\n    let prefix = \\\"version\\\\t1\\\\n\\\"\\n    if String::length(text) > String::length(prefix) &&\\n    text[0: String::length(prefix)] == prefix {\\n      Some(String::substring(text, String::length(prefix), String::length(text) - 1))\\n    } else {\\n      None\\n    }\\n  }\\n}\\n\\nexport fn persistent_leaf_fingerprint_text(fingerprint: String) -> String {\\n  String::concat(\\\"version\\\\t1\\\\n\\\", String::concat(fingerprint, \\\"\\\\n\\\"))\\n}\\n\")\n}\n\nlet cli_adapter_source_134 = () -> (String, String) {\n  (\"lib/@vibe/compiler/runtime/module_source.vibe\",\n\"//# Imports\\n\\nimport ../core/index.vibe {\\n  Stmt,\\n  Expr,\\n  dce_keep_flags\\n}\\n\\nimport ../syntax/index.vibe {\\n  lex_with_offsets,\\n  parse_program_spans,\\n  offset_to_line_col\\n}\\n\\n//# Module source emission (selfhost port of host `emit-module-source`)\\n\\n// Reconstruct a flat module source containing only the top-level statements\\n// reachable from `entry_name` (via DCE), emitted as their original source text.\\n//\\n// Mirrors the MoonBit host `emit-module-source`\\n// (`src/cmd/vibe/cli_module_source.mbt`) but recovers statement source spans\\n// from the selfhost lexer (`lex_with_offsets`) + parser (`parse_program_spans`)\\n// instead of AST node spans, since the selfhost AST does not carry offsets.\\n// Pure: no filesystem or host calls.\\nexport let build_module_source_from_source: (String, String) -> String with { Error } = (source, entry_name) -> {\\n  let lexed = lex_with_offsets(source)\\n  let tokens = lexed.0\\n  let starts = lexed.1\\n  let ends = lexed.2\\n  let parsed = parse_program_spans(tokens, starts, ends)\\n  let stmts = parsed.0\\n  let span_start = parsed.1\\n  let span_end = parsed.2\\n  let keep = dce_keep_flags(stmts, [entry_name])\\n  let buf = StringBuilder::new()\\n  let mut i = 0\\n  while i < Array::length(stmts) {\\n    if Array::get(keep, i) {\\n      let s = Array::get(span_start, i)\\n      let e = Array::get(span_end, i)\\n      if e > s {\\n        let snippet = String::substring(source, s, e)\\n        StringBuilder::push(buf, snippet)\\n        let n = String::length(snippet)\\n        if n == 0 || String::char_code_at(snippet, n - 1) != '\\\\n' {\\n          StringBuilder::push(buf, \\\"\\\\n\\\")\\n        }\\n      }\\n    }\\n    i = i + 1\\n  }\\n  StringBuilder::freeze(buf)\\n}\\n\\n// debugger テーマ3 / M2: build a `.funcmap` sidecar text mapping each ENTRY-file\\n// top-level function definition to its 1-based source line, one `name<TAB>line\\\\n`\\n// per function. The launcher (`runtime/vibe`) reads this to annotate runtime trap\\n// backtrace frames (which name user functions via the wasm \\\"name\\\" section) with\\n// `(file:line)`.\\n//\\n// MVP scope: ENTRY-file top-level functions only. Imported-module functions are\\n// not yet covered (future work) — they are flattened into the program at compile\\n// time but their original source lines are not recovered here.\\n//\\n// Reuses the lexer offsets + parse_program_spans span table (same as\\n// build_module_source_from_source) so it needs no checker. A top-level `SLet`\\n// whose bound expr is a function (`EFn`) maps `name` -> line of the statement's\\n// start offset. All strings via String::concat + __to_string only (never `+`,\\n// never \\\"\\\\{}\\\" interpolation): both mis-codegen to NUL in selfhost.\\nexport let build_funcmap_from_source: (String) -> String with { Error } = (source) -> {\\n  let lexed = lex_with_offsets(source)\\n  let tokens = lexed.0\\n  let starts = lexed.1\\n  let ends = lexed.2\\n  let parsed = parse_program_spans(tokens, starts, ends)\\n  let stmts = parsed.0\\n  let span_start = parsed.1\\n  let buf = StringBuilder::new()\\n  let mut i = 0\\n  while i < Array::length(stmts) {\\n    let stmt = Array::get(stmts, i)\\n    let entry = match stmt {\\n      SLet(_, _, name, _, expr) => match expr {\\n        EFn(_, _, _, _, _, _) => {\\n          let off = Array::get(span_start, i)\\n          let lc = offset_to_line_col(source, off)\\n          let line = lc.0\\n          String::concat(name, String::concat(\\\"\\\\t\\\", String::concat(__to_string(line), \\\"\\\\n\\\")))\\n        },\\n        _ => \\\"\\\"\\n      },\\n      _ => \\\"\\\"\\n    }\\n    StringBuilder::push(buf, entry)\\n    i = i + 1\\n  }\\n  StringBuilder::freeze(buf)\\n}\\n\")\n}\n\nlet cli_adapter_source_135 = () -> (String, String) {\n  (\"lib/@vibe/compiler/runtime/index.vibe\",\n\"//# Imports\\n\\nimport ../core/index.vibe {\\n  Stmt,\\n  Type,\\n  TypeEnv,\\n  env_bind,\\n  env_flat_bindings,\\n  env_lookup_flat,\\n  ExportRenamePlan,\\n  append_import_alias_rewritten_non_import_stmts_with_renames,\\n  append_non_import_stmts_without_alias_rewrite,\\n  apply_export_renames_stmts,\\n  build_export_rename_plan,\\n  collect_import_alias_collision_locals,\\n  collect_import_alias_collision_refs,\\n  collect_import_value_renames,\\n  export_plan_fingerprint_text,\\n  export_plan_renames_for,\\n  import_value_rename_locals,\\n  namespace_private_value_stmts,\\n  rewrite_imported_value_stmt_to_local,\\n  stmts_have_import_deep\\n}\\n\\nimport ../checker/index.vibe {\\n  check_program_with_env\\n}\\n\\nimport ./eval_loader/index.vibe {\\n  contains_str\\n}\\n\\nimport ./typecheck_fs.vibe {\\n  ensure_fingerprint_fs_impl,\\n  load_persistent_dep_list,\\n  load_persistent_leaf_fingerprint,\\n  persistent_dep_list_text,\\n  persistent_leaf_fingerprint_text,\\n  persistent_type_env_cache_text,\\n  load_persistent_type_env\\n}\\n\\nimport ../syntax/index.vibe {\\n  lex,\\n  parse_program,\\n  print_program\\n}\\n\\nimport ../loader {\\n  load_or_parse_module_header_fs\\n}\\n\\nimport ../module_graph_path.vibe {\\n  dir_of_path,\\n  resolve_import_path,\\n  resolve_import_path_candidates\\n}\\n\\nimport ../cache/persistent_cache.vibe {\\n  persistent_dep_list_cache_path, persistent_leaf_fingerprint_cache_path,\\n  persistent_type_env_cache_path\\n}\\n\\nimport ../../../../lib/@vibe/graph {\\n  RippleDb,\\n  ripple_eval_count,\\n  ripple_get_deps,\\n  ripple_get_fingerprint,\\n  ripple_get_source,\\n  ripple_new,\\n  ripple_record_eval,\\n  ripple_set_source\\n}\\n\\n// #847 Phase C: facade re-exports so external callers reach this directory\\n// only through runtime/index.vibe, not its internal files directly.\\nexport ./module_source.vibe {\\n  build_module_source_from_source, build_funcmap_from_source\\n}\\n\\nexport ./type_at.vibe {\\n  type_at_source\\n}\\n\\nexport ./binding_at.vibe {\\n  binding_occurrences\\n}\\n\\nexport ./symbol_spans.vibe {\\n  symbol_spans\\n}\\n\\nexport ./typecheck_fs.vibe {\\n  collect_all_diagnostics\\n}\\n\\n// Note: `eval_loader/` has its own `index.vibe` and is already its own\\n// boundary (ADR-0063 applies recursively) — its two external callers\\n// (`loader/index.vibe`, `loader/header_cache.vibe`) already import it via\\n// that index, not an internal file, so it needs no re-export here. Routing\\n// it through this facade instead would also create an import cycle: this\\n// file already imports `../loader { load_or_parse_module_header_fs }`, so\\n// `loader/index.vibe` importing back through `runtime/index.vibe` would be\\n// `loader -> runtime/index.vibe -> loader`.\\n\\n//# Types\\n\\nenum StringTriple {\\n  StringTriple(String, String, String)\\n}\\n\\nenum TypeDbState {\\n  TypeDbState(\\n    RippleDb,\\n    Array[(String, TypeEnv)],\\n    Array[(String, String)],\\n    Array[StringTriple],\\n    Array[StringTriple],\\n    Array[StringTriple],\\n    Int,\\n    Int,\\n    Int,\\n    Int\\n  )\\n}\\n\\nexport enum TypeDb {\\n  TypeDb(TypeDbState)\\n}\\n\\n//# Functions\\n\\nfn unwrap_db(db: TypeDb) -> TypeDbState {\\n  match db {\\n    TypeDb(state) => state\\n  }\\n}\\n\\nfn wrap_db(state: TypeDbState) -> TypeDb {\\n  TypeDb(state)\\n}\\n\\nfn parse_program_with_path(path: String, source: String) -> Array[Stmt] with { Error } {\\n  handle {\\n    parse_program(lex(source))\\n  } with Error {\\n    Throw(msg) => throw(String::concat(String::concat(path, \\\": \\\"), msg))\\n  }\\n}\\n\\nfn add_dep(acc: Array[String], raw_path: String, base_dir: String) -> Array[String] {\\n  // Mutates `acc` in place. Caller pattern is `acc = add_dep(acc, ...)`\\n  // so the same reference is returned either way.\\n  if String::length(raw_path) == 0 {\\n    acc\\n  } else {\\n    let resolved = resolve_import_path(base_dir, raw_path)\\n    if contains_str(acc, resolved) {\\n      acc\\n    } else {\\n      Array::push(acc, resolved)\\n      acc\\n    }\\n  }\\n}\\n\\nfn empty_strings() -> Array[String] {\\n  Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n}\\n\\nfn empty_dep_fps() -> Array[(String, String)] {\\n  Array::slice([\\n    (\\\"\\\", \\\"\\\")\\n  ], 0, 0)\\n}\\n\\nfn empty_env_cache() -> Array[(String, TypeEnv)] {\\n  Array::slice([\\n    (\\\"\\\", EnvEmpty)\\n  ], 0, 0)\\n}\\n\\nfn empty_string_pairs() -> Array[(String, String)] {\\n  Array::slice([\\n    (\\\"\\\", \\\"\\\")\\n  ], 0, 0)\\n}\\n\\nfn empty_string_triples() -> Array[StringTriple] {\\n  Array::slice([\\n    StringTriple(\\\"\\\", \\\"\\\", \\\"\\\")\\n  ], 0, 0)\\n}\\n\\nfn empty_stmt_array() -> Array[Stmt] {\\n  Array::slice([\\n    SExport([\\\"_dummy\\\"])\\n  ], 0, 0)\\n}\\n\\nexport fn db_new() -> TypeDb {\\n  wrap_db(\\n    TypeDbState(\\n      ripple_new(),\\n      empty_env_cache(),\\n      empty_string_pairs(),\\n      empty_string_triples(),\\n      empty_string_triples(),\\n      empty_string_triples(),\\n      0,\\n      0,\\n      0,\\n      0\\n    )\\n  )\\n}\\n\\nfn lookup_string_pair(pairs: Array[(String, String)], key: String) -> Option[String] {\\n  let len = Array::length(pairs)\\n  let rec go: (Int) -> Option[String] = (i) -> {\\n    if i >= len {\\n      None\\n    } else {\\n      let (k, v) = Array::get(pairs, i)\\n      if k == key {\\n        Some(v)\\n      } else {\\n        go(i + 1)\\n      }\\n    }\\n  }\\n  go(0)\\n}\\n\\nfn upsert_string_pair(pairs: Array[(String, String)], key: String, value: String) -> Array[(String, String)] {\\n  let len = Array::length(pairs)\\n  let b = ArrayBuilder::new()\\n  let rec build: (Int) -> Array[(String, String)] = (i) -> {\\n    if i >= len {\\n      ArrayBuilder::push(b, (key, value))\\n      ArrayBuilder::freeze(b)\\n    } else {\\n      let (k, v) = Array::get(pairs, i)\\n      if k == key {\\n        build(i + 1)\\n      } else {\\n        ArrayBuilder::push(b, (k, v))\\n        build(i + 1)\\n      }\\n    }\\n  }\\n  build(0)\\n}\\n\\nfn lookup_source_cache(cache: Array[StringTriple], path: String, fingerprint: String) -> Option[String] {\\n  let len = Array::length(cache)\\n  let rec go: (Int) -> Option[String] = (i) -> {\\n    if i >= len {\\n      None\\n    } else {\\n      match Array::get(cache, i) {\\n        StringTriple(p, fp, source) =>\\n          if p == path && fp == fingerprint {\\n            Some(source)\\n          } else {\\n            go(i + 1)\\n          }\\n      }\\n    }\\n  }\\n  go(0)\\n}\\n\\nfn upsert_source_cache(cache: Array[StringTriple], path: String, fingerprint: String, source: String) -> Array[StringTriple] {\\n  // O(N) in-place rebuild: previously each `Array::concat(acc, [x])`\\n  // copied the entire prefix per iteration → O(N^2) for large source\\n  // caches.\\n  let out = empty_string_triples()\\n  let mut i = 0\\n  let len = Array::length(cache)\\n  while i < len {\\n    match Array::get(cache, i) {\\n      StringTriple(p, fp, existing) =>\\n        if p == path && fp == fingerprint {\\n          ()\\n        } else {\\n          Array::push(out, StringTriple(p, fp, existing))\\n        }\\n    }\\n    i = i + 1\\n  }\\n  Array::push(out, StringTriple(path, fingerprint, source))\\n  out\\n}\\n\\nfn append_source_cache_entries(cache: Array[StringTriple], entries: Array[StringTriple]) -> Array[StringTriple] {\\n  if Array::length(entries) == 0 {\\n    cache\\n  } else {\\n    let out = empty_string_triples()\\n    let mut i = 0\\n    while i < Array::length(cache) {\\n      Array::push(out, Array::get(cache, i))\\n      i = i + 1\\n    }\\n    let mut j = 0\\n    while j < Array::length(entries) {\\n      Array::push(out, Array::get(entries, j))\\n      j = j + 1\\n    }\\n    out\\n  }\\n}\\n\\nexport fn db_set_source(db: TypeDb, path: String, source: String) -> TypeDb {\\n  match unwrap_db(db) {\\n    TypeDbState(rdb, env_cache, dep_source_cache, merged_cache, module_source_cache, artifact_cache, parse_count, merge_count, module_source_count, codegen_count) =>\\n      wrap_db(\\n        TypeDbState(\\n          ripple_set_source(rdb, path, source),\\n          env_cache,\\n          dep_source_cache,\\n          merged_cache,\\n          module_source_cache,\\n          artifact_cache,\\n          parse_count,\\n          merge_count,\\n          module_source_count,\\n          codegen_count\\n        )\\n      )\\n  }\\n}\\n\\nfn lookup_env_cache(cache: Array[(String, TypeEnv)], path: String) -> Option[TypeEnv] {\\n  let len = Array::length(cache)\\n  let rec go: (Int) -> Option[TypeEnv] = (i) -> {\\n    if i >= len {\\n      None\\n    } else {\\n      let (p, env) = Array::get(cache, i)\\n      if p == path {\\n        Some(env)\\n      } else {\\n        go(i + 1)\\n      }\\n    }\\n  }\\n  go(0)\\n}\\n\\nfn resolve_cached_import_path(base_dir: String, raw_path: String, cache: Array[(String, TypeEnv)]) -> String {\\n  let candidates = resolve_import_path_candidates(base_dir, raw_path)\\n  let mut selected = \\\"\\\"\\n  let mut i = 0\\n  while i < Array::length(candidates) && selected == \\\"\\\" {\\n    let candidate = Array::get(candidates, i)\\n    match lookup_env_cache(cache, candidate) {\\n      Some(_) => {\\n        selected = candidate\\n      },\\n      None => ()\\n    }\\n    i = i + 1\\n  }\\n  if selected == \\\"\\\" {\\n    resolve_import_path(base_dir, raw_path)\\n  } else {\\n    selected\\n  }\\n}\\n\\nexport fn db_check_env(db: TypeDb, path: String) -> Option[TypeEnv] {\\n  match unwrap_db(db) {\\n    TypeDbState(_, cache, _, _, _, _, _, _, _, _) => lookup_env_cache(cache, path)\\n  }\\n}\\n\\nfn starts_with_upper(name: String) -> Bool {\\n  if String::length(name) == 0 {\\n    false\\n  } else {\\n    let c = String::char_code_at(name, 0)\\n    c >= 65 && c <= 90\\n  }\\n}\\n\\nfn type_returns_name(ty: Type, type_name: String) -> Bool {\\n  match ty {\\n    CtEnum(name) => name == type_name,\\n    CtNamed(name, _) => name == type_name,\\n    CtFn(_, ret, _) => type_returns_name(ret, type_name),\\n    CtForAll(_, _, body) => type_returns_name(body, type_name),\\n    _ => false\\n  }\\n}\\n\\nfn bind_enum_constructor_companions(acc: TypeEnv, dep_bindings: Array[(String, Type)], enum_name: String) -> TypeEnv {\\n  let mut out = acc\\n  let mut i = 0\\n  while i < Array::length(dep_bindings) {\\n    let (candidate_name, candidate_ty) = Array::get(dep_bindings, i)\\n    if candidate_name != enum_name && starts_with_upper(candidate_name) && type_returns_name(candidate_ty, enum_name) {\\n      out = env_bind(out, candidate_name, candidate_ty)\\n    }\\n    i = i + 1\\n  }\\n  out\\n}\\n\\nfn bind_import_names_from_cache(acc: TypeEnv, resolved: String, names: Array[(String, Option[String])], cache: Array[(String, TypeEnv)]) -> TypeEnv {\\n  let dep_env = match lookup_env_cache(cache, resolved) {\\n    Some(e) => e,\\n    None => EnvEmpty\\n  }\\n  let dep_bindings = env_flat_bindings(dep_env)\\n  let nlen = Array::length(names)\\n  let rec bind_names: (Int, TypeEnv) -> TypeEnv = (j, nacc) -> {\\n    if j >= nlen {\\n      nacc\\n    } else {\\n      let (name, alias) = Array::get(names, j)\\n      let bound_name = match alias {\\n        Some(a) => a,\\n        None => name\\n      }\\n      let ty = match env_lookup_flat(dep_bindings, name) {\\n        Some(t) => t,\\n        None => CtUnknown\\n      }\\n      let with_name = env_bind(nacc, bound_name, ty)\\n      let with_companions = match ty {\\n        CtEnum(enum_name) => bind_enum_constructor_companions(with_name, dep_bindings, enum_name),\\n        _ => if starts_with_upper(name) {\\n          bind_enum_constructor_companions(with_name, dep_bindings, name)\\n        } else {\\n          with_name\\n        }\\n      }\\n      bind_names(j + 1, with_companions)\\n    }\\n  }\\n  bind_names(0, acc)\\n}\\n\\nfn build_import_env(stmts: Array[Stmt], base_dir: String, cache: Array[(String, TypeEnv)]) -> TypeEnv {\\n  let len = Array::length(stmts)\\n  let rec go: (Int, TypeEnv) -> TypeEnv = (i, acc) -> {\\n    if i >= len {\\n      acc\\n    } else {\\n      let next = match Array::get(stmts, i) {\\n        SImport(raw_path, names) => {\\n          let resolved = resolve_cached_import_path(base_dir, raw_path, cache)\\n          bind_import_names_from_cache(acc, resolved, names, cache)\\n        },\\n        SReExport(raw_path, names) => {\\n          let resolved = resolve_cached_import_path(base_dir, raw_path, cache)\\n          bind_import_names_from_cache(acc, resolved, names, cache)\\n        },\\n        _ => acc\\n      }\\n      go(i + 1, next)\\n    }\\n  }\\n  go(0, EnvEmpty)\\n}\\n\\nfn upsert_env_cache(cache: Array[(String, TypeEnv)], path: String, env: TypeEnv) -> Array[(String, TypeEnv)] {\\n  let len = Array::length(cache)\\n  let b = ArrayBuilder::new()\\n  let rec build: (Int) -> Array[(String, TypeEnv)] = (i) -> {\\n    if i >= len {\\n      ArrayBuilder::push(b, (path, env))\\n      ArrayBuilder::freeze(b)\\n    } else {\\n      let (p, e) = Array::get(cache, i)\\n      if p == path {\\n        build(i + 1)\\n      } else {\\n        ArrayBuilder::push(b, (p, e))\\n        build(i + 1)\\n      }\\n    }\\n  }\\n  build(0)\\n}\\n\\nfn compact_string_fingerprint(source: String) -> String {\\n  let mod1 = 2147483647\\n  let mod2 = 2147483629\\n  let step1 = 131\\n  let step2 = 65599\\n  let len = String::length(source)\\n  let mut h1 = 17\\n  let mut h2 = 29\\n  let mut i = 0\\n  while i < len {\\n    let c = String::char_code_at(source, i)\\n    h1 = (h1 * step1 + c + 1) % mod1\\n    h2 = (h2 * step2 + c + i + 1) % mod2\\n    i = i + 1\\n  }\\n  String::concat(\\n    __to_string(len),\\n    String::concat(\\\":\\\", String::concat(__to_string(h1), String::concat(\\\":\\\", __to_string(h2))))\\n  )\\n}\\n\\nfn store_persistent_type_env(fingerprint: String, env: TypeEnv) -> Unit with { Error, Fs } {\\n  Fs::write_file(\\n    persistent_type_env_cache_path(fingerprint),\\n    persistent_type_env_cache_text(env)\\n  )\\n}\\n\\nfn build_fingerprint(source: String, dep_fps: Array[(String, String)]) -> String {\\n  let mut acc = compact_string_fingerprint(source)\\n  let mut i = 0\\n  while i < Array::length(dep_fps) {\\n    let dep_pair = Array::get(dep_fps, i)\\n    let dep_path = dep_pair.0\\n    let dep_fp = dep_pair.1\\n    let next = String::concat(\\n      acc,\\n      String::concat(\\\"|\\\", String::concat(dep_path, String::concat(\\\"=\\\", dep_fp)))\\n    )\\n    acc = compact_string_fingerprint(next)\\n    i = i + 1\\n  }\\n  acc\\n}\\n\\nexport fn db_typecheck_count(db: TypeDb) -> Int {\\n  match unwrap_db(db) {\\n    TypeDbState(rdb, _, _, _, _, _, _, _, _, _) => ripple_eval_count(rdb)\\n  }\\n}\\n\\nexport fn db_parse_count(db: TypeDb) -> Int {\\n  match unwrap_db(db) {\\n    TypeDbState(_, _, _, _, _, _, parse_count, _, _, _) => parse_count\\n  }\\n}\\n\\nexport fn db_merge_count(db: TypeDb) -> Int {\\n  match unwrap_db(db) {\\n    TypeDbState(_, _, _, _, _, _, _, merge_count, _, _) => merge_count\\n  }\\n}\\n\\nexport fn db_module_source_count(db: TypeDb) -> Int {\\n  match unwrap_db(db) {\\n    TypeDbState(_, _, _, _, _, _, _, _, module_source_count, _) => module_source_count\\n  }\\n}\\n\\nexport fn db_codegen_count(db: TypeDb) -> Int {\\n  match unwrap_db(db) {\\n    TypeDbState(_, _, _, _, _, _, _, _, _, codegen_count) => codegen_count\\n  }\\n}\\n\\nfn collect_import_deps_from_stmts(stmts: Array[Stmt], base_dir: String) -> Array[String] {\\n  let len = Array::length(stmts)\\n  let rec go: (Int, Array[String]) -> Array[String] = (i, acc) -> {\\n    if i >= len {\\n      acc\\n    } else {\\n      let next = match Array::get(stmts, i) {\\n        SImport(raw_path, _) => add_dep(acc, raw_path, base_dir),\\n        SReExport(raw_path, _) => add_dep(acc, raw_path, base_dir),\\n        _ => acc\\n      }\\n      go(i + 1, next)\\n    }\\n  }\\n  go(0, empty_strings())\\n}\\n\\nfn resolve_deps_for_source(rdb: RippleDb, dep_source_cache: Array[(String, String)], path: String, source: String, parse_count: Int) -> (Array[String], Array[(String, String)], Int) with { Error } {\\n  match lookup_string_pair(dep_source_cache, path) {\\n    Some(cached_source) =>\\n      if cached_source == source {\\n        match ripple_get_deps(rdb, path) {\\n          Some(deps) => (deps, dep_source_cache, parse_count),\\n          None => {\\n            let stmts = parse_program_with_path(path, source)\\n            let deps = collect_import_deps_from_stmts(stmts, dir_of_path(path))\\n            (\\n              deps,\\n              upsert_string_pair(dep_source_cache, path, source),\\n              parse_count + 1\\n            )\\n          }\\n        }\\n      } else {\\n        let stmts = parse_program_with_path(path, source)\\n        let deps = collect_import_deps_from_stmts(stmts, dir_of_path(path))\\n        (\\n          deps,\\n          upsert_string_pair(dep_source_cache, path, source),\\n          parse_count + 1\\n        )\\n      },\\n    None => {\\n      let stmts = parse_program_with_path(path, source)\\n      let deps = collect_import_deps_from_stmts(stmts, dir_of_path(path))\\n      (\\n        deps,\\n        upsert_string_pair(dep_source_cache, path, source),\\n        parse_count + 1\\n      )\\n    }\\n  }\\n}\\n\\nfn load_or_parse_deps_for_source_fs(dep_source_cache: Array[(String, String)], path: String, source: String, parse_count: Int) -> (Array[String], Array[(String, String)], Int) with { Error, Fs } {\\n  match load_persistent_dep_list(path, source) {\\n    Some(deps) => (\\n      deps,\\n      upsert_string_pair(dep_source_cache, path, source),\\n      parse_count\\n    ),\\n    None => {\\n      let (deps, _, next_parse_count) = load_or_parse_module_header_fs(path, source, parse_count)\\n      (\\n        deps,\\n        upsert_string_pair(dep_source_cache, path, source),\\n        next_parse_count\\n      )\\n    }\\n  }\\n}\\n\\nfn resolve_deps_for_source_fs(rdb: RippleDb, dep_source_cache: Array[(String, String)], path: String, source: String, parse_count: Int) -> (Array[String], Array[(String, String)], Int) with { Error, Fs } {\\n  match lookup_string_pair(dep_source_cache, path) {\\n    Some(cached_source) =>\\n      if cached_source == source {\\n        match ripple_get_deps(rdb, path) {\\n          Some(deps) => (deps, dep_source_cache, parse_count),\\n          None => load_or_parse_deps_for_source_fs(dep_source_cache, path, source, parse_count)\\n        }\\n      } else {\\n        load_or_parse_deps_for_source_fs(dep_source_cache, path, source, parse_count)\\n      },\\n    None => load_or_parse_deps_for_source_fs(dep_source_cache, path, source, parse_count)\\n  }\\n}\\n\\nfn ensure_fingerprint(rdb: RippleDb, env_cache: Array[(String, TypeEnv)], dep_source_cache: Array[(String, String)], parse_count: Int, path: String, stack: Array[String]) -> (String, RippleDb, Array[(String, TypeEnv)], Array[(String, String)], Int) with { Error } {\\n  if contains_str(stack, path) {\\n    throw(String::concat(\\\"type_db: import cycle detected at \\\", path))\\n  } else {\\n    match ripple_get_source(rdb, path) {\\n      None => (String::concat(\\\"missing:\\\", path), rdb, env_cache, dep_source_cache, parse_count),\\n      Some(source) => {\\n        let (deps, next_dep_source_cache, initial_parse_count) = resolve_deps_for_source(\\n          rdb,\\n          dep_source_cache,\\n          path,\\n          source,\\n          parse_count\\n        )\\n        let dlen = Array::length(deps)\\n        // Cycle-detection stack: push self before recursing, truncate back after.\\n        // O(1) per frame vs. previous Array::concat(stack, [path]) which was O(depth) per frame.\\n        let saved_stack_len = Array::length(stack)\\n        Array::push(stack, path)\\n        // Tail-recursive over `deps`, accumulating (dep_path, dep_fp)\\n        // pairs into `dep_acc`. Previously each recursion did\\n        // `Array::concat(dep_acc, [tuple])` — O(N) copy per step,\\n        // O(N²) over the deps list. Mutating in place is safe because\\n        // `dep_acc` flows linearly down the recursion (one path, no\\n        // sibling branches that need the old prefix).\\n        let rec resolve_nested: (Int, Array[(String, String)], RippleDb, Array[(String, TypeEnv)], Array[(String, String)], Int) -> (Array[(String, String)], RippleDb, Array[(String, TypeEnv)], Array[(String, String)], Int) with { Error } = (i, dep_acc, dep_db, dep_env_cache, dep_source_cache2, dep_parse_count) -> {\\n          if i >= dlen {\\n            (dep_acc, dep_db, dep_env_cache, dep_source_cache2, dep_parse_count)\\n          } else {\\n            let dep_path = Array::get(deps, i)\\n            let (\\n              dep_fp,\\n              next_db,\\n              next_env_cache,\\n              next_dep_source_cache2,\\n              next_parse_count\\n            ) = ensure_fingerprint(\\n              dep_db,\\n              dep_env_cache,\\n              dep_source_cache2,\\n              dep_parse_count,\\n              dep_path,\\n              stack\\n            )\\n            Array::push(dep_acc, (dep_path, dep_fp))\\n            resolve_nested(\\n              i + 1,\\n              dep_acc,\\n              next_db,\\n              next_env_cache,\\n              next_dep_source_cache2,\\n              next_parse_count\\n            )\\n          }\\n        }\\n        let resolved_nested = resolve_nested(\\n          0,\\n          empty_dep_fps(),\\n          rdb,\\n          env_cache,\\n          next_dep_source_cache,\\n          initial_parse_count\\n        )\\n        Array::truncate(stack, saved_stack_len)\\n        let dep_fps = resolved_nested.0\\n        let db_after_deps = resolved_nested.1\\n        let env_cache_after_deps = resolved_nested.2\\n        let dep_source_cache_after_deps = resolved_nested.3\\n        let parse_count_after_deps = resolved_nested.4\\n        let fingerprint = build_fingerprint(source, dep_fps)\\n        match ripple_get_fingerprint(db_after_deps, path) {\\n          Some(cached_fp) =>\\n            if cached_fp == fingerprint {\\n              (\\n                fingerprint,\\n                db_after_deps,\\n                env_cache_after_deps,\\n                dep_source_cache_after_deps,\\n                parse_count_after_deps\\n              )\\n            } else {\\n              let stmts = parse_program_with_path(path, source)\\n              let final_parse_count = parse_count_after_deps + 1\\n              let import_env = build_import_env(stmts, dir_of_path(path), env_cache_after_deps)\\n              let checked_env = check_program_with_env(stmts, import_env)\\n              let next_env_cache = upsert_env_cache(env_cache_after_deps, path, checked_env)\\n              let next_db = ripple_record_eval(db_after_deps, path, fingerprint, deps)\\n              (\\n                fingerprint,\\n                next_db,\\n                next_env_cache,\\n                dep_source_cache_after_deps,\\n                final_parse_count\\n              )\\n            },\\n          None => {\\n            let stmts = parse_program_with_path(path, source)\\n            let final_parse_count = parse_count_after_deps + 1\\n            let import_env = build_import_env(stmts, dir_of_path(path), env_cache_after_deps)\\n            let checked_env = check_program_with_env(stmts, import_env)\\n            let next_env_cache = upsert_env_cache(env_cache_after_deps, path, checked_env)\\n            let next_db = ripple_record_eval(db_after_deps, path, fingerprint, deps)\\n            (\\n              fingerprint,\\n              next_db,\\n              next_env_cache,\\n              dep_source_cache_after_deps,\\n              final_parse_count\\n            )\\n          }\\n        }\\n      }\\n    }\\n  }\\n}\\n\\nexport fn db_typecheck(db: TypeDb, path: String) -> TypeDb with { Error } {\\n  match unwrap_db(db) {\\n    TypeDbState(rdb, env_cache, dep_source_cache, merged_cache, module_source_cache, artifact_cache, parse_count, merge_count, module_source_count, codegen_count) => {\\n      let (\\n        _,\\n        next_rdb,\\n        next_env_cache,\\n        next_dep_source_cache,\\n        next_parse_count\\n      ) = ensure_fingerprint(\\n        rdb,\\n        env_cache,\\n        dep_source_cache,\\n        parse_count,\\n        path,\\n        empty_strings()\\n      )\\n      wrap_db(\\n        TypeDbState(\\n          next_rdb,\\n          next_env_cache,\\n          next_dep_source_cache,\\n          merged_cache,\\n          module_source_cache,\\n          artifact_cache,\\n          next_parse_count,\\n          merge_count,\\n          module_source_count,\\n          codegen_count\\n        )\\n      )\\n    }\\n  }\\n}\\n\\nexport fn db_typecheck_fs(db: TypeDb, path: String) -> TypeDb with { Error, Fs } {\\n  match unwrap_db(db) {\\n    TypeDbState(rdb, env_cache, dep_source_cache, merged_cache, module_source_cache, artifact_cache, parse_count, merge_count, module_source_count, codegen_count) => {\\n      let (\\n        _,\\n        next_rdb,\\n        next_env_cache,\\n        next_dep_source_cache,\\n        next_parse_count\\n      ) = ensure_fingerprint_fs_impl(\\n        rdb,\\n        env_cache,\\n        dep_source_cache,\\n        parse_count,\\n        path,\\n        empty_strings()\\n      )\\n      wrap_db(\\n        TypeDbState(\\n          next_rdb,\\n          next_env_cache,\\n          next_dep_source_cache,\\n          merged_cache,\\n          module_source_cache,\\n          artifact_cache,\\n          next_parse_count,\\n          merge_count,\\n          module_source_count,\\n          codegen_count\\n        )\\n      )\\n    }\\n  }\\n}\\n\\nexport fn db_program_source(db: TypeDb, path: String) -> (String, String, TypeDb) with { Error } {\\n  let checked = db_typecheck(db, path)\\n  match unwrap_db(checked) {\\n    TypeDbState(rdb, _, _, _, _, _, _, _, _, _) =>\\n      match ripple_get_source(rdb, path) {\\n        None => throw(String::concat(\\\"missing:\\\", path)),\\n        Some(source) =>\\n          match ripple_get_fingerprint(rdb, path) {\\n            Some(fingerprint) => (source, fingerprint, checked),\\n            None => (source, source, checked)\\n          }\\n      }\\n  }\\n}\\n\\nfn build_merge_fingerprint(sources: Array[(String, String)]) -> String {\\n  let mut acc = \\\"merged\\\"\\n  let mut i = 0\\n  while i < Array::length(sources) {\\n    let (_, source) = Array::get(sources, i)\\n    let next = String::concat(\\n      acc,\\n      String::concat(\\\"|\\\", compact_string_fingerprint(source))\\n    )\\n    acc = compact_string_fingerprint(next)\\n    i = i + 1\\n  }\\n  acc\\n}\\n\\nfn lookup_source_by_path(sources: Array[(String, String)], target_path: String) -> Option[String] {\\n  let mut i = 0\\n  let mut found = None\\n  while i < Array::length(sources) {\\n    let (path, source) = Array::get(sources, i)\\n    if path == target_path {\\n      found = Some(source)\\n      i = Array::length(sources)\\n    } else {\\n      i = i + 1\\n    }\\n  }\\n  found\\n}\\n\\n// #716: collision-def fallback (see merge_sources.vibe). `excluded_locals`\\n// are the locals the export-rename plan already rewrites; the inline copy gets\\n// the target file's export renames applied first.\\nfn append_import_alias_collision_defs_from_sources(merged: Array[Stmt], current_path: String, stmts: Array[Stmt], sources: Array[(String, String)], plan: ExportRenamePlan, excluded_locals: Array[String]) -> Unit with { Error } {\\n  let refs = collect_import_alias_collision_refs(stmts)\\n  let emitted = Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n  let base_dir = dir_of_path(current_path)\\n  let mut i = 0\\n  while i < Array::length(refs) {\\n    let (raw_path, original, local) = Array::get(refs, i)\\n    if !contains_str(emitted, local) && !contains_str(excluded_locals, local) {\\n      let resolved = resolve_import_path(base_dir, raw_path)\\n      match lookup_source_by_path(sources, resolved) {\\n        Some(source) => {\\n          let source_stmts = namespace_private_value_stmts(\\n            resolved,\\n            apply_export_renames_stmts(\\n              parse_program_with_path(resolved, source),\\n              export_plan_renames_for(plan, resolved)\\n            )\\n          )\\n          let mut j = 0\\n          let mut done = false\\n          while j < Array::length(source_stmts) && !done {\\n            match rewrite_imported_value_stmt_to_local(Array::get(source_stmts, j), original, local) {\\n              Some(local_stmt) => {\\n                Array::push(merged, local_stmt)\\n                Array::push(emitted, local)\\n                done = true\\n              },\\n              None => ()\\n            }\\n            j = j + 1\\n          }\\n        },\\n        None => ()\\n      }\\n    }\\n    i = i + 1\\n  }\\n}\\n\\n// #716: parse every source once and expose (paths, stmts) for the export-\\n// rename plan; the merge itself reuses the parsed statements.\\nfn parse_merge_sources(sources: Array[(String, String)]) -> (Array[String], Array[Array[Stmt]]) with { Error } {\\n  let file_paths = Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n  let file_stmts = Array::slice([\\n    empty_stmt_array()\\n  ], 0, 0)\\n  let mut si = 0\\n  while si < Array::length(sources) {\\n    let (path, source) = Array::get(sources, si)\\n    Array::push(file_paths, path)\\n    Array::push(file_stmts, parse_program_with_path(path, source))\\n    si = si + 1\\n  }\\n  (file_paths, file_stmts)\\n}\\n\\n// One (sub)list of sources merged under a whole-program rename plan.\\n// `collision_sources` spans the whole program so a collision-def import that\\n// crosses a group boundary still resolves.\\nfn build_merged_source_with_plan(entry_path: String, sources: Array[(String, String)], file_paths: Array[String], file_stmts: Array[Array[Stmt]], plan: ExportRenamePlan, collision_sources: Array[(String, String)]) -> String with { Error } {\\n  let merged = empty_stmt_array()\\n  let source_count = Array::length(sources)\\n  let mut si = 0\\n  while si < source_count {\\n    let path = Array::get(file_paths, si)\\n    let stmts = Array::get(file_stmts, si)\\n    let is_entry_source = if entry_path == \\\"\\\" {\\n      si == source_count - 1\\n    } else {\\n      path == entry_path\\n    }\\n    let export_renamed = if is_entry_source {\\n      stmts\\n    } else {\\n      apply_export_renames_stmts(stmts, export_plan_renames_for(plan, path))\\n    }\\n    let namespaced_stmts = if is_entry_source {\\n      export_renamed\\n    } else {\\n      namespace_private_value_stmts(path, export_renamed)\\n    }\\n    if stmts_have_import_deep(stmts) {\\n      let import_renames = collect_import_value_renames(plan, path, stmts)\\n      let skipped_locals = collect_import_alias_collision_locals(stmts)\\n      append_import_alias_collision_defs_from_sources(merged, path, stmts, collision_sources, plan, import_value_rename_locals(import_renames))\\n      append_import_alias_rewritten_non_import_stmts_with_renames(merged, namespaced_stmts, skipped_locals, import_renames)\\n    } else {\\n      append_non_import_stmts_without_alias_rewrite(merged, namespaced_stmts)\\n    }\\n    si = si + 1\\n  }\\n  print_program(merged)\\n}\\n\\nfn build_merged_source(entry_path: String, sources: Array[(String, String)]) -> String with { Error } {\\n  let (file_paths, file_stmts) = parse_merge_sources(sources)\\n  let plan_entry = if entry_path == \\\"\\\" {\\n    if Array::length(file_paths) > 0 {\\n      Array::get(file_paths, Array::length(file_paths) - 1)\\n    } else {\\n      \\\"\\\"\\n    }\\n  } else {\\n    entry_path\\n  }\\n  let plan = build_export_rename_plan(file_paths, file_stmts, plan_entry)\\n  build_merged_source_with_plan(entry_path, sources, file_paths, file_stmts, plan, sources)\\n}\\n\\nfn join_group_sources(group_sources: Array[String]) -> String {\\n  let len = Array::length(group_sources)\\n  // O(N) via StringBuilder; the recursive `String::concat(acc, ...)` was\\n  // O(N²) over the source-group count.\\n  let buf = StringBuilder::new()\\n  let mut i = 0\\n  while i < len {\\n    let source = Array::get(group_sources, i)\\n    if i > 0 {\\n      StringBuilder::push(buf, \\\"\\\\n\\\")\\n    }\\n    StringBuilder::push(buf, source)\\n    i = i + 1\\n  }\\n  StringBuilder::freeze(buf)\\n}\\n\\nexport fn db_merged_source(db: TypeDb, _entry_path: String, sources: Array[(String, String)]) -> (String, String, TypeDb) with { Error } {\\n  match unwrap_db(db) {\\n    TypeDbState(rdb, env_cache, dep_source_cache, merged_cache, module_source_cache, artifact_cache, parse_count, merge_count, module_source_count, codegen_count) => {\\n      let merge_fingerprint = build_merge_fingerprint(sources)\\n      let merge_cache_key = \\\"merged\\\"\\n      match lookup_source_cache(merged_cache, merge_cache_key, merge_fingerprint) {\\n        Some(merged_source) => (merged_source, merge_fingerprint, db),\\n        None => {\\n          let merged_source = build_merged_source(_entry_path, sources)\\n          let next_merged_cache = upsert_source_cache(\\n            merged_cache,\\n            merge_cache_key,\\n            merge_fingerprint,\\n            merged_source\\n          )\\n          (\\n            merged_source,\\n            merge_fingerprint,\\n            wrap_db(\\n              TypeDbState(\\n                rdb,\\n                env_cache,\\n                dep_source_cache,\\n                next_merged_cache,\\n                module_source_cache,\\n                artifact_cache,\\n                parse_count,\\n                merge_count + 1,\\n                module_source_count,\\n                codegen_count\\n              )\\n            )\\n          )\\n        }\\n      }\\n    }\\n  }\\n}\\n\\nexport fn db_grouped_merged_source(db: TypeDb, groups: Array[(String, Array[(String, String)])]) -> (String, String, TypeDb) with { Error } {\\n  match unwrap_db(db) {\\n    TypeDbState(rdb, env_cache, dep_source_cache, merged_cache, module_source_cache, artifact_cache, parse_count, merge_count, module_source_count, codegen_count) => {\\n      // Keep per-group results in side buffers, then append cache misses\\n      // once. Rebuilding the full cache on every group miss is O(N^2) for\\n      // the ~150-group selfhost compiler manifest.\\n      let group_sources = empty_strings()\\n      let mut grouped_fingerprint = \\\"merged-groups\\\"\\n      let new_group_cache_entries = empty_string_triples()\\n      let mut merge_count_acc = merge_count\\n      // #716: the export-rename plan spans ALL groups (imports cross group\\n      // boundaries), so every source is parsed once up front and the plan\\n      // fingerprint is folded into each group's cache fingerprint — a change\\n      // to the program's ambiguous-export set invalidates cached group merges\\n      // even when the group's own sources are unchanged.\\n      let flat_sources = Array::slice([\\n        (\\\"\\\", \\\"\\\")\\n      ], 0, 0)\\n      let mut fgi = 0\\n      while fgi < Array::length(groups) {\\n        let (_, gsources) = Array::get(groups, fgi)\\n        let mut fsi = 0\\n        while fsi < Array::length(gsources) {\\n          Array::push(flat_sources, Array::get(gsources, fsi))\\n          fsi = fsi + 1\\n        }\\n        fgi = fgi + 1\\n      }\\n      let (flat_paths, flat_stmts) = parse_merge_sources(flat_sources)\\n      let plan_entry = if Array::length(flat_paths) > 0 {\\n        Array::get(flat_paths, Array::length(flat_paths) - 1)\\n      } else {\\n        \\\"\\\"\\n      }\\n      let plan = build_export_rename_plan(flat_paths, flat_stmts, plan_entry)\\n      let plan_fp = compact_string_fingerprint(export_plan_fingerprint_text(plan))\\n      let mut flat_idx = 0\\n      let mut i = 0\\n      while i < Array::length(groups) {\\n        let (group_name, sources) = Array::get(groups, i)\\n        let group_start = flat_idx\\n        flat_idx = flat_idx + Array::length(sources)\\n        let fingerprint = compact_string_fingerprint(\\n          String::concat(build_merge_fingerprint(sources), String::concat(\\\"#\\\", plan_fp))\\n        )\\n        let grouped_next = String::concat(\\n          grouped_fingerprint,\\n          String::concat(\\\"|\\\", String::concat(group_name, String::concat(\\\"=\\\", fingerprint)))\\n        )\\n        grouped_fingerprint = compact_string_fingerprint(grouped_next)\\n        let cache_key = String::concat(\\\"merged-group|\\\", group_name)\\n        match lookup_source_cache(merged_cache, cache_key, fingerprint) {\\n          Some(source) => {\\n            Array::push(group_sources, source)\\n          },\\n          None =>\\n            match lookup_source_cache(new_group_cache_entries, cache_key, fingerprint) {\\n              Some(source) => {\\n                Array::push(group_sources, source)\\n              },\\n              None => {\\n                let group_paths = Array::slice(flat_paths, group_start, group_start + Array::length(sources))\\n                let group_stmts = Array::slice(flat_stmts, group_start, group_start + Array::length(sources))\\n                // #740: pass the WHOLE-merge plan entry, not \\\"\\\" — the empty\\n                // entry made build_merged_source_with_plan treat the last\\n                // file of EVERY GROUP as the entry (exports unrenamed), so\\n                // group tails (ripple.vibe, desugar_trait_dict.vibe, ...)\\n                // were missing their `_exp_` defs while callers referenced\\n                // them.\\n                let source = build_merged_source_with_plan(plan_entry, sources, group_paths, group_stmts, plan, flat_sources)\\n                Array::push(new_group_cache_entries, StringTriple(cache_key, fingerprint, source))\\n                merge_count_acc = merge_count_acc + 1\\n                Array::push(group_sources, source)\\n              }\\n            }\\n        }\\n        i = i + 1\\n      }\\n      let next_merged_cache = append_source_cache_entries(merged_cache, new_group_cache_entries)\\n      let next_merge_count = merge_count_acc\\n      let grouped_cache_key = \\\"merged-groups\\\"\\n      match lookup_source_cache(next_merged_cache, grouped_cache_key, grouped_fingerprint) {\\n        Some(source) =>\\n          (\\n            source,\\n            grouped_fingerprint,\\n            wrap_db(\\n              TypeDbState(\\n                rdb,\\n                env_cache,\\n                dep_source_cache,\\n                next_merged_cache,\\n                module_source_cache,\\n                artifact_cache,\\n                parse_count,\\n                next_merge_count,\\n                module_source_count,\\n                codegen_count\\n              )\\n            )\\n          ),\\n        None => {\\n          let source = join_group_sources(group_sources)\\n          let final_merged_cache = upsert_source_cache(\\n            next_merged_cache,\\n            grouped_cache_key,\\n            grouped_fingerprint,\\n            source\\n          )\\n          (\\n            source,\\n            grouped_fingerprint,\\n            wrap_db(\\n              TypeDbState(\\n                rdb,\\n                env_cache,\\n                dep_source_cache,\\n                final_merged_cache,\\n                module_source_cache,\\n                artifact_cache,\\n                parse_count,\\n                next_merge_count + 1,\\n                module_source_count,\\n                codegen_count\\n              )\\n            )\\n          )\\n        }\\n      }\\n    }\\n  }\\n}\\n\\nfn build_module_source(source: String) -> String with { Error } {\\n  let stmts = parse_program(lex(source))\\n  let filtered = empty_stmt_array()\\n  let mut i = 0\\n  while i < Array::length(stmts) {\\n    let stmt = Array::get(stmts, i)\\n    let keep = match stmt {\\n      SLet(_, _, _, _, expr) => {\\n        match expr {\\n          EFn(_, _, _, _, _, _) => true,\\n          _ => false\\n        }\\n      },\\n      _ => false\\n    }\\n    if keep {\\n      Array::push(filtered, stmt)\\n    }\\n    i = i + 1\\n  }\\n  print_program(filtered)\\n}\\n\\nexport fn db_module_source(db: TypeDb, fingerprint: String, source: String) -> (String, TypeDb) with { Error } {\\n  match unwrap_db(db) {\\n    TypeDbState(rdb, env_cache, dep_source_cache, merged_cache, module_source_cache, artifact_cache, parse_count, merge_count, module_source_count, codegen_count) => {\\n      let module_cache_key = \\\"module-source\\\"\\n      match lookup_source_cache(module_source_cache, module_cache_key, fingerprint) {\\n        Some(module_source) => (module_source, db),\\n        None => {\\n          let module_source = build_module_source(source)\\n          let next_module_source_cache = upsert_source_cache(\\n            module_source_cache,\\n            module_cache_key,\\n            fingerprint,\\n            module_source\\n          )\\n          (\\n            module_source,\\n            wrap_db(\\n              TypeDbState(\\n                rdb,\\n                env_cache,\\n                dep_source_cache,\\n                merged_cache,\\n                next_module_source_cache,\\n                artifact_cache,\\n                parse_count,\\n                merge_count,\\n                module_source_count + 1,\\n                codegen_count\\n              )\\n            )\\n          )\\n        }\\n      }\\n    }\\n  }\\n}\\n\\nfn artifact_cache_key(kind: String, entry_name: String) -> String {\\n  String::concat(kind, String::concat(\\\"|\\\", entry_name))\\n}\\n\\nfn bytes_to_hex_digit(n: Int) -> String {\\n  if n < 10 {\\n    __to_string(n)\\n  } else if n == 10 {\\n    \\\"a\\\"\\n  } else if n == 11 {\\n    \\\"b\\\"\\n  } else if n == 12 {\\n    \\\"c\\\"\\n  } else if n == 13 {\\n    \\\"d\\\"\\n  } else if n == 14 {\\n    \\\"e\\\"\\n  } else {\\n    \\\"f\\\"\\n  }\\n}\\n\\nfn nibble_from_hex_char(c: Int) -> Int with { Error } {\\n  if c >= 48 && c <= 57 {\\n    c - 48\\n  } else if c >= 97 && c <= 102 {\\n    c - 87\\n  } else if c >= 65 && c <= 70 {\\n    c - 55\\n  } else {\\n    throw(\\\"invalid hex digit\\\")\\n  }\\n}\\n\\nfn bytes_to_hex(bytes: Bytes) -> String {\\n  let len = Bytes::length(bytes)\\n  let mut i = 0\\n  // O(N) via StringBuilder; previously each `String::concat(out, ...)`\\n  // copied the growing buffer, making this O(N²) for the N-byte module\\n  // hashes this routine serialises.\\n  let buf = StringBuilder::new()\\n  while i < len {\\n    let byte = Bytes::get(bytes, i)\\n    let hi = byte / 16\\n    let lo = byte % 16\\n    StringBuilder::push(buf, bytes_to_hex_digit(hi))\\n    StringBuilder::push(buf, bytes_to_hex_digit(lo))\\n    i = i + 1\\n  }\\n  StringBuilder::freeze(buf)\\n}\\n\\nfn hex_to_bytes(hex: String) -> Bytes with { Error } {\\n  let len = String::length(hex)\\n  if len % 2 != 0 {\\n    throw(\\\"invalid hex length\\\")\\n  } else {\\n    let out = Bytes::new()\\n    let mut i = 0\\n    while i < len {\\n      let hi = nibble_from_hex_char(String::char_code_at(hex, i))\\n      let lo = nibble_from_hex_char(String::char_code_at(hex, i + 1))\\n      Bytes::push(out, hi * 16 + lo)\\n      i = i + 2\\n    }\\n    out\\n  }\\n}\\n\\nexport fn db_load_artifact(db: TypeDb, _path: String, kind: String, entry_name: String, fingerprint: String) -> Option[Bytes] with { Error } {\\n  match unwrap_db(db) {\\n    TypeDbState(_, _, _, _, _, artifact_cache, _, _, _, _) =>\\n      match lookup_source_cache(artifact_cache, artifact_cache_key(kind, entry_name), fingerprint) {\\n        Some(hex) => Some(hex_to_bytes(hex)),\\n        None => None\\n      }\\n  }\\n}\\n\\nexport fn db_store_artifact(db: TypeDb, _path: String, kind: String, entry_name: String, fingerprint: String, bytes: Bytes) -> TypeDb {\\n  match unwrap_db(db) {\\n    TypeDbState(rdb, env_cache, dep_source_cache, merged_cache, module_source_cache, artifact_cache, parse_count, merge_count, module_source_count, codegen_count) =>\\n      wrap_db(\\n        TypeDbState(\\n          rdb,\\n          env_cache,\\n          dep_source_cache,\\n          merged_cache,\\n          module_source_cache,\\n          upsert_source_cache(\\n            artifact_cache,\\n            artifact_cache_key(kind, entry_name),\\n            fingerprint,\\n            bytes_to_hex(bytes)\\n          ),\\n          parse_count,\\n          merge_count,\\n          module_source_count,\\n          codegen_count + 1\\n        )\\n      )\\n  }\\n}\\n\")\n}\n\nlet cli_adapter_source_136 = () -> (String, String) {\n  (\"lib/@vibe/compiler/cache/selfhost_codegen_fingerprint.vibe\",\n\"// AUTO-GENERATED by scripts/generate_bundle.sh (#630).\\n// Do not edit manually. Regenerate with: bash scripts/generate_bundle.sh\\n//\\n// A hash of every compiler source file in compiler_sources_manifest.tsv (the\\n// codegen included). persistent_cache folds it into the artifact cache key so a\\n// codegen change — which produces different wasm from the SAME user source —\\n// automatically invalidates stale compiled .hex artifacts (#630).\\n\\n//# Functions\\n\\nexport let selfhost_codegen_fingerprint: () -> String = () -> {\\n  \\\"99f55472bca5a5bc\\\"\\n}\\n\")\n}\n\nlet cli_adapter_source_137 = () -> (String, String) {\n  (\"lib/@vibe/compiler/cache/cache_underlying.vibe\",\n\"//# Imports\\n\\n// #769: `cache_`-prefixed forwarding wrappers around the generic @vibe/cache\\n// primitives, replacing persistent_cache.vibe's `import ... { x as cache_x }`\\n// aliases. Rationale: generate_selfhost_bundle.sh strips relative import\\n// lines from every embedded .vibe source on the assumption that\\n// collect_merged_stmts resolves references BY NAME -- an `as` alias only\\n// exists in the import line, so the stripped bundle's merged program had\\n// calls to `cache_persistent_artifact_cache_path` with no such definition\\n// (\\\"undefined variable (local): ... @call\\\", the selfhost_s5_entry/size/wasm/\\n// determinism_test failure). Real wrapper functions survive the strip: their\\n// bodies call the @vibe/cache definitions by their own exported names, which\\n// the merge resolves. Keep this file alias-free.\\nimport ../../../../lib/@vibe/cache {\\n  persistent_artifact_cache_path,\\n  store_persistent_artifact,\\n  load_persistent_artifact,\\n  persistent_dep_list_cache_path,\\n  persistent_type_env_cache_path,\\n  persistent_source_list_cache_path,\\n  persistent_source_group_cache_path,\\n  persistent_module_header_cache_path,\\n  persistent_manifest_header_cache_path,\\n  persistent_leaf_fingerprint_cache_path\\n}\\n\\n//# Functions\\n\\n// #849 (Codex review, PR #899): VIBE_BUILD_CACHE_DIR override lives HERE,\\n// not in @vibe/cache/cache.vibe — this compiler-specific wrapper layer\\n// already requires host Fs/Error imports for every consumer, so an\\n// `Env::get` reference here forces nothing new. Putting it in the generic\\n// package instead would force a `vibe.env_get` host import onto every\\n// consumer of @vibe/cache's whole linked program (even ones only using pure\\n// helpers like compact_string_fingerprint), since collect_used_builtin_names\\n// scans all top-level statements of the linked program, not just ones\\n// reachable from the entry point. Private effect + checker-only discharge,\\n// mirroring module_graph_path.vibe's ADR-0065 pattern (VIBE_LIB / VIBE_HOME\\n// / HOME / VIBE_REQUIRE_PINS) so the 8 path-returning wrappers below don't\\n// need an `Env` row on their own signatures or their ~20-30 call sites.\\neffect Env {\\n  Get(String) -> String\\n}\\n\\nfn env_get_raw(name: String) -> String with { Env } {\\n  Env::get(name)\\n}\\n\\nfn read_env_discharged(name: String) -> String {\\n  handle {\\n    env_get_raw(name)\\n  } with Env {\\n    Get(_n) => resume(\\\"\\\")\\n  }\\n}\\n\\n// @vibe/cache/cache.vibe's stable_cache_path always roots paths under the\\n// literal \\\"_build/vibe_\\\" prefix. When VIBE_BUILD_CACHE_DIR is set, rebase\\n// that prefix onto the override directory (still ending in \\\"vibe_\\\", so the\\n// existing \\\"<prefix>_<token>_<suffix>\\\" filename convention appends\\n// unchanged) so parallel `git worktree` checkouts can share one physical\\n// cache directory (the cache KEY is already content/relative-path based —\\n// see #849 audit comment).\\nfn rebase_cache_path(path: String) -> String {\\n  let override_root = read_env_discharged(\\\"VIBE_BUILD_CACHE_DIR\\\")\\n  let default_prefix = \\\"_build/vibe_\\\"\\n  if String::length(override_root) == 0 {\\n    path\\n  } else if !(String::starts_with(path, default_prefix)) {\\n    path\\n  } else {\\n    let override_len = String::length(override_root)\\n    let override_prefix = if String::char_code_at(override_root, override_len - 1) == 47 {\\n      String::concat(override_root, \\\"vibe_\\\")\\n    } else {\\n      String::concat(override_root, \\\"/vibe_\\\")\\n    }\\n    String::concat(override_prefix, path[String::length(default_prefix): String::length(path)])\\n  }\\n}\\n\\nexport fn cache_persistent_artifact_cache_path(version_tag: String, kind: String, entry_name: String, fingerprint: String) -> String {\\n  rebase_cache_path(persistent_artifact_cache_path(version_tag, kind, entry_name, fingerprint))\\n}\\n\\nexport fn cache_store_persistent_artifact(version_tag: String, kind: String, entry_name: String, fingerprint: String, bytes: Bytes) -> Unit with { Error, Fs } {\\n  store_persistent_artifact(version_tag, kind, entry_name, fingerprint, bytes)\\n}\\n\\nexport fn cache_load_persistent_artifact(version_tag: String, kind: String, entry_name: String, fingerprint: String) -> Option[Bytes] with { Error, Fs } {\\n  load_persistent_artifact(version_tag, kind, entry_name, fingerprint)\\n}\\n\\nexport fn cache_persistent_dep_list_cache_path(version_tag: String, path: String, source_fingerprint: String, resolution_seed: String) -> String {\\n  rebase_cache_path(persistent_dep_list_cache_path(version_tag, path, source_fingerprint, resolution_seed))\\n}\\n\\nexport fn cache_persistent_type_env_cache_path(version_tag: String, fingerprint: String) -> String {\\n  rebase_cache_path(persistent_type_env_cache_path(version_tag, fingerprint))\\n}\\n\\nexport fn cache_persistent_source_list_cache_path(version_tag: String, entry_path: String, resolution_seed: String) -> String {\\n  rebase_cache_path(persistent_source_list_cache_path(version_tag, entry_path, resolution_seed))\\n}\\n\\nexport fn cache_persistent_source_group_cache_path(version_tag: String, entry_path: String, resolution_seed: String) -> String {\\n  rebase_cache_path(persistent_source_group_cache_path(version_tag, entry_path, resolution_seed))\\n}\\n\\nexport fn cache_persistent_module_header_cache_path(version_tag: String, path: String, source_fingerprint: String, resolution_seed: String) -> String {\\n  rebase_cache_path(persistent_module_header_cache_path(version_tag, path, source_fingerprint, resolution_seed))\\n}\\n\\nexport fn cache_persistent_manifest_header_cache_path(version_tag: String, entry_path: String) -> String {\\n  rebase_cache_path(persistent_manifest_header_cache_path(version_tag, entry_path))\\n}\\n\\nexport fn cache_persistent_leaf_fingerprint_cache_path(version_tag: String, path: String, source_fingerprint: String) -> String {\\n  rebase_cache_path(persistent_leaf_fingerprint_cache_path(version_tag, path, source_fingerprint))\\n}\\n\")\n}\n\nlet cli_adapter_source_138 = () -> (String, String) {\n  (\"lib/@vibe/compiler/cache/persistent_cache.vibe\",\n\"//# Imports\\n\\n// #766: the generic disk-cache primitives live in @vibe/cache (no compiler\\n// dependency). This file is the compiler-specific adapter: it supplies the\\n// two identity components a generic cache can't know about — the compiler's\\n// own codegen fingerprint (so a codegen change invalidates stale artifacts,\\n// #630) and VIBE_LIB's module-resolution env seed (#758) — and re-exports\\n// the ORIGINAL wrapper names/signatures so every existing call site in the\\n// compiler keeps working unchanged.\\n// #769: the `cache_`-prefixed underlying names come from real forwarding\\n// wrappers (cache_underlying.vibe), NOT `x as cache_x` import aliases -- an\\n// alias only exists in the import line, which generate_selfhost_bundle.sh\\n// strips from embedded sources, so the bundle-merge lane\\n// (collect_merged_stmts, selfhost_s5_entry/size/wasm/determinism_test) had\\n// no definition for the aliased names (\\\"undefined variable (local):\\n// cache_persistent_artifact_cache_path @call\\\"). See cache_underlying.vibe.\\nimport ../../../../lib/@vibe/cache {\\n  compact_string_fingerprint,\\n  build_source_groups_fingerprint,\\n  normalize_persistent_cache_text,\\n  build_source_groups_fingerprint_from_compact_fingerprints,\\n  build_fs_compile_wasi_artifact_fingerprint_from_group_fingerprint,\\n  build_fs_compile_wasi_artifact_fingerprint,\\n  build_file_compile_wasi_artifact_fingerprint_from_group_fingerprint,\\n  build_file_compile_wasi_artifact_fingerprint,\\n  build_fs_compile_module_artifact_fingerprint_from_group_fingerprint,\\n  build_fs_compile_module_artifact_fingerprint,\\n  build_file_compile_module_artifact_fingerprint_from_group_fingerprint,\\n  build_file_compile_module_artifact_fingerprint\\n}\\n\\nimport ./cache_underlying.vibe {\\n  cache_persistent_artifact_cache_path,\\n  cache_store_persistent_artifact,\\n  cache_load_persistent_artifact,\\n  cache_persistent_dep_list_cache_path,\\n  cache_persistent_type_env_cache_path,\\n  cache_persistent_source_list_cache_path,\\n  cache_persistent_source_group_cache_path,\\n  cache_persistent_module_header_cache_path,\\n  cache_persistent_manifest_header_cache_path,\\n  cache_persistent_leaf_fingerprint_cache_path\\n}\\n\\nimport ./selfhost_codegen_fingerprint.vibe {\\n  selfhost_codegen_fingerprint\\n}\\n\\nimport ../module_graph_path.vibe {\\n  is_contract_ext,\\n  resolution_env_seed,\\n  resolve_import_path_candidates\\n}\\n\\n//# Misc\\n\\nexport {\\n  compact_string_fingerprint,\\n  build_source_groups_fingerprint,\\n  normalize_persistent_cache_text,\\n  build_source_groups_fingerprint_from_compact_fingerprints,\\n  build_fs_compile_wasi_artifact_fingerprint_from_group_fingerprint,\\n  build_fs_compile_wasi_artifact_fingerprint,\\n  build_file_compile_wasi_artifact_fingerprint_from_group_fingerprint,\\n  build_file_compile_wasi_artifact_fingerprint,\\n  build_fs_compile_module_artifact_fingerprint_from_group_fingerprint,\\n  build_fs_compile_module_artifact_fingerprint,\\n  build_file_compile_module_artifact_fingerprint_from_group_fingerprint,\\n  build_file_compile_module_artifact_fingerprint\\n}\\n\\n//# Functions\\n\\n// Cache key version tag. TWO independent reasons to bump it (#630):\\n//  - cache FORMAT change (how `.hex` / `.tsv` entries are serialized): bump `vNN`.\\n//  - CODEGEN / wasm-ABI change (the SAME source now compiles to DIFFERENT wasm):\\n//    bump `cgNN`. The artifact cache is keyed by the source fingerprint only, so\\n//    without a codegen segment a codegen change returns a STALE compiled wasm for\\n//    unchanged source. Bump `cg` on any change to emitted wasm / runtime ABI.\\n//    The `cg` segment is `selfhost_codegen_fingerprint()` — a build-time hash of\\n//    all compiler source files (compiler_sources_manifest.tsv), regenerated with\\n//    the bundle. So any codegen-source change automatically changes the key and\\n//    invalidates stale artifacts; no manual bump needed (#630). `vNN` is still a\\n//    manual knob for pure cache-FORMAT changes that don't change the source hash.\\nfn persistent_cache_version_tag() -> String {\\n  // v12 (#801): source list/group cache text gained a mandatory `resctx` row\\n  // (resolution-context fingerprint) and its version row moved to 3 — a cache\\n  // FORMAT change. Loaders written before #801 throw on the unknown row tag,\\n  // so the manual `vNN` knob is bumped to keep old and new writers in\\n  // disjoint key spaces (this also orphans any #801-poisoned entries).\\n  // v11 (#632): artifact cache switched from hex text (`.hex`) to raw binary\\n  // (`.bin`, via Fs::write_bytes / Fs::read_bytes) — a cache FORMAT change, so\\n  // the manual `vNN` knob is bumped. Old `.hex` entries are now unreferenced\\n  // (different key + suffix) and reclaimable via `pkf run cache-clean` (#631).\\n  String::concat(\\\"v12|cg-\\\", selfhost_codegen_fingerprint())\\n}\\n\\nexport fn persistent_artifact_cache_path(kind: String, entry_name: String, fingerprint: String) -> String {\\n  cache_persistent_artifact_cache_path(persistent_cache_version_tag(), kind, entry_name, fingerprint)\\n}\\n\\nexport fn store_persistent_artifact(kind: String, entry_name: String, fingerprint: String, bytes: Bytes) -> Unit with { Error, Fs } {\\n  cache_store_persistent_artifact(persistent_cache_version_tag(), kind, entry_name, fingerprint, bytes)\\n}\\n\\nexport fn load_persistent_artifact(kind: String, entry_name: String, fingerprint: String) -> Option[Bytes] with { Error, Fs } {\\n  cache_load_persistent_artifact(persistent_cache_version_tag(), kind, entry_name, fingerprint)\\n}\\n\\nexport fn persistent_dep_list_cache_path(path: String, source_fingerprint: String) -> String {\\n  cache_persistent_dep_list_cache_path(persistent_cache_version_tag(), path, source_fingerprint, resolution_env_seed())\\n}\\n\\nexport fn persistent_type_env_cache_path(fingerprint: String) -> String {\\n  cache_persistent_type_env_cache_path(persistent_cache_version_tag(), fingerprint)\\n}\\n\\nexport fn persistent_source_list_cache_path(entry_path: String) -> String {\\n  // #758 review (P1): the cached artifact is a RESOLVED graph — the external\\n  // lib roots and the freeze switch (#751) are part of its identity, or a\\n  // graph resolved without pins replays under VIBE_REQUIRE_PINS=1 (and a\\n  // VIBE_LIB change replays the previous roots). Same seed on the dep-list\\n  // and module-header caches below.\\n  cache_persistent_source_list_cache_path(persistent_cache_version_tag(), entry_path, resolution_env_seed())\\n}\\n\\nexport fn persistent_source_group_cache_path(entry_path: String) -> String {\\n  cache_persistent_source_group_cache_path(persistent_cache_version_tag(), entry_path, resolution_env_seed())\\n}\\n\\nexport fn persistent_module_header_cache_path(path: String, source_fingerprint: String) -> String {\\n  cache_persistent_module_header_cache_path(persistent_cache_version_tag(), path, source_fingerprint, resolution_env_seed())\\n}\\n\\nexport fn persistent_manifest_header_cache_path(entry_path: String) -> String {\\n  cache_persistent_manifest_header_cache_path(persistent_cache_version_tag(), entry_path)\\n}\\n\\nexport fn persistent_leaf_fingerprint_cache_path(path: String, source_fingerprint: String) -> String {\\n  cache_persistent_leaf_fingerprint_cache_path(persistent_cache_version_tag(), path, source_fingerprint)\\n}\\n\\n// #801 follow-up: the module-header and dep-list caches store RESOLVED dep\\n// paths, and a `@scope/name` import resolves to a DIFFERENT package root\\n// (.vibe/store wins over lib/ wins over external roots) depending on what\\n// exists at resolve time. A header cached while a store copy existed lists\\n// the store index.vibei as a dep; replayed after the store copy is gone (or\\n// vice versa) it aims the walk at the wrong root. Unlike the source-group\\n// cache (#801's resctx row), the poison here is VISIBLE in the cached rows —\\n// the importing file's dep always names the winning package index — so no\\n// context enumeration is needed: re-derive the `@scope/name` ref from each\\n// package-index dep and check it still wins today.\\nfn package_ref_of_index_dep(dep: String) -> Option[String] {\\n  // #897: a resolved package-index dep only ever ends in `.vibei` or (once a\\n  // directory has migrated) `.vpkg` — no other on-disk file uses either\\n  // extension — so the shared `is_contract_ext` boolean is exact here, not\\n  // an approximation of the \\\"/index.<ext>\\\" filename check.\\n  if is_contract_ext(dep) {\\n    let parts = String::split(dep, \\\"/\\\")\\n    let n = Array::length(parts)\\n    if n >= 3 && String::starts_with(Array::get(parts, n - 3), \\\"@\\\") {\\n      Some(String::concat(Array::get(parts, n - 3), String::concat(\\\"/\\\", Array::get(parts, n - 2))))\\n    } else {\\n      None\\n    }\\n  } else {\\n    None\\n  }\\n}\\n\\nexport fn package_index_dep_is_current(dep: String) -> Bool with { Fs } {\\n  match package_ref_of_index_dep(dep) {\\n    None => true,\\n    Some(pkg_ref) => {\\n      let candidates = resolve_import_path_candidates(\\\"\\\", pkg_ref)\\n      let mut i = 0\\n      let mut winner = \\\"\\\"\\n      while i < Array::length(candidates) {\\n        if winner == \\\"\\\" {\\n          let candidate = Array::get(candidates, i)\\n          if Fs::exists(candidate) {\\n            winner = candidate\\n          } else {\\n            ()\\n          }\\n        } else {\\n          ()\\n        }\\n        i = i + 1\\n      }\\n      // Mirror resolve_path_fs: no existing candidate falls back to the\\n      // first (store) spelling.\\n      if winner == \\\"\\\" {\\n        Array::get(candidates, 0) == dep\\n      } else {\\n        winner == dep\\n      }\\n    }\\n  }\\n}\\n\\nexport fn package_index_deps_are_current(deps: Array[String]) -> Bool with { Fs } {\\n  let mut i = 0\\n  let mut ok = true\\n  while i < Array::length(deps) {\\n    if ok && !(package_index_dep_is_current(Array::get(deps, i))) {\\n      ok = false\\n    } else {\\n      ()\\n    }\\n    i = i + 1\\n  }\\n  ok\\n}\\n\")\n}\n\nlet cli_adapter_source_139 = () -> (String, String) {\n  (\"lib/@vibe/compiler/module_graph_path.vibe\",\n\"//# Functions\\n\\n// #897 (ADR-0070 Phase 1): `index.vpkg` is the target spelling `index.vibei`\\n// is being renamed to (76 directories, migrated in later phases). Every site\\n// that currently recognizes a `.vibei` contract file by extension must also\\n// recognize `.vpkg` during the migration, so a directory may use EITHER\\n// spelling. This is the ONE shared boolean test — string-comparison sites\\n// that only need a yes/no \\\"is this a contract-grammar file\\\" answer should\\n// call this instead of duplicating the `String::ends_with` pair. Sites that\\n// need to build a candidate path (e.g. `dir + \\\"/index.vpkg\\\"`) still spell the\\n// literal suffix themselves.\\nexport fn is_contract_ext(path: String) -> Bool {\\n  String::ends_with(path, \\\".vibei\\\") || String::ends_with(path, \\\".vpkg\\\")\\n}\\n\\nexport fn dir_of_path(file_path: String) -> String {\\n  let idx = String::last_index_of(file_path, \\\"/\\\")\\n  if idx < 0 {\\n    \\\"\\\"\\n  } else if idx == 0 {\\n    \\\"/\\\"\\n  } else {\\n    file_path[0: idx]\\n  }\\n}\\n\\n// Module/package sources must be regular filesystem entries.\\nexport fn ensure_regular_source_fs(path: String) -> Unit with { Error, Fs } {\\n  // The Fs::stat_token host ABI reserves -1 for a symbolic link. This keeps\\n  // symlink rejection bootstrap-compatible without adding a new builtin that\\n  // the pinned seed compiler could not yet type-check.\\n  if Fs::stat_token(path) == -1 {\\n    throw(\\\"symlink module source is not allowed: \\\\{path}\\\")\\n  } else {\\n    ()\\n  }\\n}\\n\\n// Linear membership scan used by `resolve_reexport_chain` to filter\\n// re-exported names. Bounded per-module, not whole-program: `items`\\n// (`wanted_names`) is a single re-export selection (typically 1-5 names)\\n// and it is scanned once per pub statement of one source file. The\\n// original O(N^2)-accumulator survey (#366) classified this as \\\"small N,\\n// refactor pointless\\\" and #533 re-confirms it. A `Map[String, Bool]`\\n// would NOT help: the selfhost runtime emits `Map::has_key` as a linear\\n// search (#395, closed not-planned). See\\n// bench/selfhost_perf/README.md (\\\"String-keyed lookup\\\" postmortem).\\nexport fn contains_name(items: Array[String], name: String) -> Bool {\\n  let mut i = 0\\n  let mut found = false\\n  while i < Array::length(items) && !found {\\n    if Array::get(items, i) == name {\\n      found = true\\n    } else {\\n      i = i + 1\\n    }\\n  }\\n  found\\n}\\n\\n// Linear membership scan used by `collect_direct_dep_paths` to dedup the\\n// direct dependency paths of one entry file. Bounded by that file's\\n// unique imports (≈5-30), so the dedup is O(D^2) with small D (≤ ~900\\n// ops, per #366's survey). NOTE: the whole-graph visited/scheduled sets\\n// that used to route through this helper (merge recursion, FS collect,\\n// manifest worklists) moved to the bucketed `path_set` below (#533);\\n// only genuinely small, per-module dedups should keep using this. Kept\\n// linear deliberately for those (#533):\\n//   - `Map[String, Bool]` is a no-op — the selfhost runtime emits\\n//     `Map::has_key`/`Map::get` as linear searches (#395 not-planned).\\n//   - A sort+merge dedup is UNSAFE: the resulting `dep_paths` order is\\n//     preserved into `linked_imports`, which the linked codegen turns\\n//     into wasm import-section indices (see\\n//     lib/@vibe/compiler/codegen/wasi/linked_compile.vibe). Reordering would\\n//     change the emitted binary, breaking reproducibility/parity.\\n// First-occurrence insertion order must therefore be preserved.\\nexport fn contains_path(visited: Array[String], path: String) -> Bool {\\n  let mut i = 0\\n  let mut found = false\\n  while i < Array::length(visited) && !found {\\n    if Array::get(visited, i) == path {\\n      found = true\\n    } else {\\n      i = i + 1\\n    }\\n  }\\n  found\\n}\\n\\n// #533: mutable bucketed string set for whole-graph membership tests.\\n//\\n// The per-module `contains_name` / `contains_path` scans above are fine\\n// (small bounded N — see the notes on each), but the graph-traversal\\n// dedup sites (`collect_sources_rec`, `collect_merged_stmts_recursive`,\\n// the manifest worklist loops) test membership against a set that grows\\n// to ALL modules, once per import edge — O(edges × modules) string\\n// compares, plus O(modules²) entry copying where the set was a\\n// `Map[String, Bool]` (the runtime `Map::set` copies the whole map per\\n// insert; `Map::has_key` is a linear scan — #395, closed not-planned).\\n//\\n// This set is plain `Array[Array[String]]` buckets + `Array::push`, so\\n// it relies on nothing but O(1)-amortized array ops: membership and\\n// insert are O(len(path)) hash + a short bucket scan, independent of\\n// module count. Insert-only; iteration order is NOT meaningful — callers\\n// that need ordered output must keep their own insertion-ordered array\\n// (see the reorder hazard on `contains_path` above).\\nlet path_set_bucket_count = 64\\n\\nfn path_set_hash(s: String) -> Int {\\n  let len = String::length(s)\\n  let mut h = 5381\\n  let mut i = 0\\n  while i < len {\\n    // djb2-xor, masked to 30 bits so `h * 33` stays far below the 61-bit\\n    // tagged-int range.\\n    h = ((h * 33) ^ String::char_code_at(s, i)) & 0x3FFFFFFF\\n    i = i + 1\\n  }\\n  h\\n}\\n\\nexport fn path_set_new() -> Array[Array[String]] {\\n  let buckets = Array::slice([\\n    Array::slice([\\n      \\\"\\\"\\n    ], 0, 0)\\n  ], 0, 0)\\n  let mut i = 0\\n  while i < path_set_bucket_count {\\n    Array::push(buckets, Array::slice([\\n      \\\"\\\"\\n    ], 0, 0))\\n    i = i + 1\\n  }\\n  buckets\\n}\\n\\nexport fn path_set_contains(set: Array[Array[String]], path: String) -> Bool {\\n  let bucket = Array::get(set, path_set_hash(path) & (path_set_bucket_count - 1))\\n  let mut i = 0\\n  let mut found = false\\n  while i < Array::length(bucket) && !found {\\n    if Array::get(bucket, i) == path {\\n      found = true\\n    } else {\\n      i = i + 1\\n    }\\n  }\\n  found\\n}\\n\\n// No membership check: callers gate on `path_set_contains` first (every\\n// site below is check-then-add), so adding unconditionally here avoids a\\n// second hash walk.\\nexport fn path_set_add(set: Array[Array[String]], path: String) -> Unit {\\n  Array::push(Array::get(set, path_set_hash(path) & (path_set_bucket_count - 1)), path)\\n}\\n\\nexport fn normalize_path(path: String) -> String {\\n  let is_absolute = String::length(path) > 0 && String::char_code_at(path, 0) == 47\\n  let mut parts = Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n  let len = String::length(path)\\n  let mut start = 0\\n  let mut i = 0\\n  while i <= len {\\n    let at_sep = if i == len {\\n      true\\n    } else {\\n      String::char_code_at(path, i) == 47\\n    }\\n    if at_sep {\\n      let part = path[start: i]\\n      let skip_part = if String::length(part) == 0 {\\n        true\\n      } else {\\n        part == \\\".\\\"\\n      }\\n      if skip_part {\\n        ()\\n      } else if part == \\\"..\\\" {\\n        // O(1) truncate vs. previous O(N) copy of `parts[0:N-1]` into a\\n        // fresh Array.\\n        if Array::length(parts) > 0 {\\n          Array::truncate(parts, Array::length(parts) - 1)\\n        }\\n      } else {\\n        Array::push(parts, part)\\n      }\\n      start = i + 1\\n    }\\n    i = i + 1\\n  }\\n  // Build the joined output via StringBuilder. The previous code did\\n  // `out = String::concat(out, ...)` in a loop, which is O(N²) over the\\n  // segment count because each concat allocates and copies the growing\\n  // string. Same shape as the StringBuilder migrations issue #366\\n  // tracks for the rest of selfhost.\\n  let buf = StringBuilder::new()\\n  if is_absolute {\\n    StringBuilder::push(buf, \\\"/\\\")\\n  }\\n  let mut pi = 0\\n  while pi < Array::length(parts) {\\n    if pi > 0 {\\n      StringBuilder::push(buf, \\\"/\\\")\\n    }\\n    StringBuilder::push(buf, Array::get(parts, pi))\\n    pi = pi + 1\\n  }\\n  StringBuilder::freeze(buf)\\n}\\n\\nexport fn get_export_name(items: Array[(String, Option[String])], name: String) -> String {\\n  let mut result = name\\n  let mut i = 0\\n  while i < Array::length(items) {\\n    let (iname, irename) = Array::get(items, i)\\n    if iname == name {\\n      match irename {\\n        Some(alias) => {\\n          result = alias\\n        },\\n        None => ()\\n      }\\n    }\\n    i = i + 1\\n  }\\n  result\\n}\\n\\nfn join_relative_path(base_dir: String, raw_path: String) -> String {\\n  if base_dir == \\\"\\\" || base_dir == \\\"/\\\" {\\n    String::concat(base_dir, raw_path)\\n  } else {\\n    String::concat(base_dir, String::concat(\\\"/\\\", raw_path))\\n  }\\n}\\n\\nexport fn path_to_module_name(path: String) -> String {\\n  let len = String::length(path)\\n  let mut last_slash = -1\\n  let mut i = 0\\n  while i < len {\\n    if String::char_code_at(path, i) == 47 {\\n      last_slash = i\\n    }\\n    i = i + 1\\n  }\\n  let base = if last_slash >= 0 {\\n    path[last_slash + 1: len]\\n  } else {\\n    path\\n  }\\n  let base_len = String::length(base)\\n  if String::ends_with(base, \\\".vibe\\\") {\\n    base[0: base_len - 5]\\n  } else {\\n    base\\n  }\\n}\\n\\nexport fn path_has_relative_prefix(raw_path: String, len: Int) -> Bool {\\n  // Bare `.` / `..` are relative too: `import . { x }` targets the importing\\n  // file's own directory index. They were previously treated as workspace-\\n  // root-relative raw paths, so `.` normalized to \\\"\\\" and the first candidate\\n  // became \\\".vibe\\\" — the workspace STORE DIRECTORY — which fs_read trapped on\\n  // with no diagnostic (EISDIR from the host).\\n  if raw_path == \\\".\\\" || raw_path == \\\"..\\\" {\\n    true\\n  } else if len >= 2 {\\n    if raw_path[0: 2] == \\\"./\\\" {\\n      true\\n    } else if len >= 3 {\\n      raw_path[0: 3] == \\\"../\\\"\\n    } else {\\n      false\\n    }\\n  } else {\\n    false\\n  }\\n}\\n\\nexport fn resolve_import_path(base_dir: String, raw_path: String) -> String {\\n  let len = String::length(raw_path)\\n  let joined = if path_has_relative_prefix(raw_path, len) {\\n    join_relative_path(base_dir, raw_path)\\n  } else {\\n    raw_path\\n  }\\n  let normalized = normalize_path(joined)\\n  if String::ends_with(normalized, \\\".vibe\\\") {\\n    normalized\\n  } else {\\n    String::concat(normalized, \\\".vibe\\\")\\n  }\\n}\\n\\n// #751 (ADR-0065): the private Env effect + checker-only discharge below\\n// let this module read VIBE_LIB / VIBE_HOME / HOME without carrying an\\n// `Env` row on every resolver in the loader chain: builtin `Env::get`\\n// compiles to the env-get host import DIRECTLY, so the handler arm is never\\n// invoked at runtime (same mechanism as the Fs handles in\\n// fixtures/fs_readdir_test.vibe). The effect declaration is private —\\n// nothing outside this module sees it.\\neffect Env {\\n  Get(String) -> String\\n}\\n\\nfn env_get_raw(name: String) -> String with { Env } {\\n  Env::get(name)\\n}\\n\\nfn read_env_discharged(name: String) -> String {\\n  handle {\\n    env_get_raw(name)\\n  } with Env {\\n    Get(_n) => resume(\\\"\\\")\\n  }\\n}\\n\\nfn strip_trailing_slash(p: String) -> String {\\n  let len = String::length(p)\\n  if len > 1 && String::ends_with(p, \\\"/\\\") {\\n    p[0: len - 1]\\n  } else {\\n    p\\n  }\\n}\\n\\n// #751 (ADR-0065): external library roots, PATH-style. Pure so it is\\n// testable: VIBE_LIB (\\\":\\\"-separated, empty segments dropped) wins;\\n// otherwise the default single root is $VIBE_HOME/lib, falling back to\\n// $HOME/.vibe/lib. No environment at all -> no external roots\\n// (workspace-only resolution).\\nexport fn parse_vibe_lib_roots(vibe_lib: String, vibe_home: String, home: String) -> Array[String] {\\n  let roots = Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n  if String::length(vibe_lib) > 0 {\\n    let parts = String::split(vibe_lib, \\\":\\\")\\n    let mut i = 0\\n    while i < Array::length(parts) {\\n      let part = Array::get(parts, i)\\n      if String::length(part) > 0 {\\n        Array::push(roots, strip_trailing_slash(part))\\n      } else {\\n        ()\\n      }\\n      i = i + 1\\n    }\\n  } else if String::length(vibe_home) > 0 {\\n    Array::push(roots, String::concat(strip_trailing_slash(vibe_home), \\\"/lib\\\"))\\n  } else if String::length(home) > 0 {\\n    Array::push(roots, String::concat(strip_trailing_slash(home), \\\"/.vibe/lib\\\"))\\n  } else {\\n    ()\\n  }\\n  roots\\n}\\n\\nexport fn external_lib_roots() -> Array[String] {\\n  parse_vibe_lib_roots(read_env_discharged(\\\"VIBE_LIB\\\"), read_env_discharged(\\\"VIBE_HOME\\\"), read_env_discharged(\\\"HOME\\\"))\\n}\\n\\n// #751: \\\"is the environment flag set to 1\\\" — the loader's freeze switch\\n// (VIBE_REQUIRE_PINS) reads through the same checker-only discharge so its\\n// signature stays effect-free.\\nexport fn vibe_env_flag(name: String) -> Bool {\\n  read_env_discharged(name) == \\\"1\\\"\\n}\\n\\n// #758 review (P1): the RESOLUTION ENVIRONMENT as a cache-key seed. The\\n// persistent header/dep-list/source-list caches store RESOLVED graphs, and\\n// resolution depends on the external lib roots (#751) and the freeze switch\\n// — a graph cached without pins under one VIBE_LIB must not be replayed\\n// under VIBE_REQUIRE_PINS=1 or a different root list (the freeze gate and\\n// the pin verification only run on the cold walk). Folding this seed into\\n// the cache paths makes each environment its own cache universe instead of\\n// re-verifying cached graphs on load.\\nexport fn resolution_env_seed() -> String {\\n  let roots = external_lib_roots()\\n  let pins = if vibe_env_flag(\\\"VIBE_REQUIRE_PINS\\\") {\\n    \\\"1\\\"\\n  } else {\\n    \\\"0\\\"\\n  }\\n  String::concat(\\\"|roots=\\\", String::concat(String::join(roots, \\\":\\\"), String::concat(\\\"|pins=\\\", pins)))\\n}\\n\\nexport fn resolve_import_path_candidates(base_dir: String, raw_path: String) -> Array[String] {\\n  // #730 (ADR-0063 §5/§6): `@scope/name` package refs resolve to the\\n  // workspace store, laid out BY NAME and verified BY HASH against the\\n  // importer's require pin (verification happens in the loader; this\\n  // function stays pure). Root-relative, independent of base_dir.\\n  // #751 (ADR-0065): `lib/@scope/name` is the SECOND candidate — dev-mode\\n  // resolution for in-repo packages and the materialize target for\\n  // distributed ones. The pinned store wins when both exist; a lib/-resolved\\n  // package is a contract package like the store (index.vibei required,\\n  // boundary + conformance apply by path) but is NOT pin-verified — pins\\n  // stay mandatory on the store/release path only. External roots (VIBE_LIB,\\n  // default $VIBE_HOME/lib -> ~/.vibe/lib) come LAST, in list order — the\\n  // workspace always wins over the installation. Both runners' raw fs lanes\\n  // read absolute paths, so external roots need no extra preopen.\\n  if String::starts_with(raw_path, \\\"@\\\") {\\n    let candidates = Array::slice([\\n      \\\"\\\"\\n    ], 0, 0)\\n    // #897 (ADR-0070 Phase 1): each root probes `.vpkg` (the target spelling)\\n    // BEFORE `.vibei` (legacy, still valid during the migration), so a\\n    // directory that has switched to `.vpkg` resolves without needing the\\n    // pin/verify lanes to change at all — only the candidate list grows.\\n    Array::push(candidates, String::concat(\\\".vibe/store/\\\", String::concat(raw_path, \\\"/index.vpkg\\\")))\\n    Array::push(candidates, String::concat(\\\".vibe/store/\\\", String::concat(raw_path, \\\"/index.vibei\\\")))\\n    Array::push(candidates, String::concat(\\\"lib/\\\", String::concat(raw_path, \\\"/index.vpkg\\\")))\\n    Array::push(candidates, String::concat(\\\"lib/\\\", String::concat(raw_path, \\\"/index.vibei\\\")))\\n    let roots = external_lib_roots()\\n    let mut ri = 0\\n    while ri < Array::length(roots) {\\n      Array::push(candidates, String::concat(Array::get(roots, ri), String::concat(\\\"/\\\", String::concat(raw_path, \\\"/index.vpkg\\\"))))\\n      Array::push(candidates, String::concat(Array::get(roots, ri), String::concat(\\\"/\\\", String::concat(raw_path, \\\"/index.vibei\\\"))))\\n      ri = ri + 1\\n    }\\n    return candidates\\n  } else ()\\n  let len = String::length(raw_path)\\n  let joined = if path_has_relative_prefix(raw_path, len) {\\n    join_relative_path(base_dir, raw_path)\\n  } else {\\n    raw_path\\n  }\\n  let normalized = normalize_path(joined)\\n  if String::ends_with(normalized, \\\".vibe\\\") {\\n    [\\n      normalized\\n    ]\\n  } else {\\n    // #729: a bare (directory-style) import may target a contract package —\\n    // `<dir>/index.vibei` (or, #897, `<dir>/index.vpkg`) is probed between\\n    // the plain-file and index.vibe forms. Existence-probing resolvers pick\\n    // it up when present; index-0 stays the plain-file form so no-match\\n    // fallbacks are unchanged. `.vpkg` is tried before `.vibei` (#897:\\n    // target spelling wins when a directory somehow has neither yet\\n    // resolved, matching the `@scope/name` root ordering above).\\n    [\\n      String::concat(normalized, \\\".vibe\\\"),\\n      String::concat(normalized, \\\"/index.vpkg\\\"),\\n      String::concat(normalized, \\\"/index.vibei\\\"),\\n      String::concat(normalized, \\\"/index.vibe\\\")\\n    ]\\n  }\\n}\\n\")\n}\n\nlet cli_adapter_source_140 = () -> (String, String) {\n  (\"lib/@vibe/compiler/loader/header_cache.vibe\",\n\"//# Imports\\n\\nimport ../../../../lib/@vibe/cache {\\n  parse_persistent_module_header_text, persistent_module_header_text\\n}\\n\\nimport ../cache/persistent_cache.vibe {\\n  compact_string_fingerprint, normalize_persistent_cache_text, package_index_deps_are_current, persistent_module_header_cache_path\\n}\\n\\nimport ../core/index.vibe {\\n  Stmt\\n}\\n\\nimport ../module_graph_path.vibe {\\n  dir_of_path, ensure_regular_source_fs, is_contract_ext, resolve_import_path_candidates\\n}\\n\\nimport ../runtime/eval_loader {\\n  collect_exports\\n}\\n\\nimport ../syntax {\\n  lex, lex_with_offsets, offset_to_line_col, parse_program, parse_program_located\\n}\\nimport ../contract {\\n  classify_contract_stmts, contract_facade_marker, extract_require_pins, parse_contract_program\\n}\\n\\n//# Functions\\n\\nfn resolve_path_fs(base_dir: String, raw_path: String, self_path: String) -> String with { Fs } {\\n  let candidates = resolve_import_path_candidates(base_dir, raw_path)\\n  let mut i = 0\\n  let mut found = \\\"\\\"\\n  let mut fallback = \\\"\\\"\\n  while i < Array::length(candidates) {\\n    let candidate = Array::get(candidates, i)\\n    // A directory-style import from a same-named facade file resolves its\\n    // plain-file candidate to the IMPORTING file itself (`export ./codegen`\\n    // inside codegen.vibe -> codegen.vibe): a self-dep is never meant, it\\n    // only manufactures \\\"type_db: import cycle detected\\\". Skip it so the\\n    // probe falls through to <dir>/index.vibe(i).\\n    if candidate == self_path {\\n      ()\\n    } else {\\n      if fallback == \\\"\\\" {\\n        fallback = candidate\\n      } else {\\n        ()\\n      }\\n      if found == \\\"\\\" && Fs::exists(candidate) {\\n        found = candidate\\n      } else {\\n        ()\\n      }\\n    }\\n    i = i + 1\\n  }\\n  if found == \\\"\\\" {\\n    if fallback == \\\"\\\" {\\n      Array::get(candidates, 0)\\n    } else {\\n      fallback\\n    }\\n  } else {\\n    found\\n  }\\n}\\n\\nfn is_special_bundle_path(path: String) -> Bool {\\n  String::ends_with(path, \\\"compiler_sources_bundle.vibe\\\") || String::ends_with(path, \\\"cli_adapter_bundle.vibe\\\") || String::ends_with(path, \\\"selfbuild_runtime_entry_bundle.vibe\\\")\\n}\\n\\nfn special_bundle_header(path: String) -> Option[(Array[String], Array[String])] {\\n  if String::ends_with(path, \\\"compiler_sources_bundle.vibe\\\") {\\n    Some((Array::slice([\\n      \\\"\\\"\\n    ], 0, 0), [\\n      \\\"selfhost_sources\\\",\\n      \\\"selfhost_source_groups\\\"\\n    ]))\\n  } else if String::ends_with(path, \\\"cli_adapter_bundle.vibe\\\") {\\n    Some((Array::slice([\\n      \\\"\\\"\\n    ], 0, 0), [\\n      \\\"selfhost_cli_adapter_sources\\\",\\n      \\\"selfhost_cli_adapter_source_groups\\\",\\n      \\\"selfhost_cli_adapter_ordered_sources\\\",\\n      \\\"selfhost_cli_adapter_merged_source\\\",\\n      \\\"selfhost_cli_adapter_module_source\\\"\\n    ]))\\n  } else if String::ends_with(path, \\\"selfbuild_runtime_entry_bundle.vibe\\\") {\\n    Some((Array::slice([\\n      \\\"\\\"\\n    ], 0, 0), [\\n      \\\"selfbuild_runtime_entry_source\\\"\\n    ]))\\n  } else {\\n    None\\n  }\\n}\\n\\n// #831: a plain relative/workspace-absolute import (`import ./x.vibe { .. }`,\\n// `export ./x.vibe { .. }`) whose resolved candidate does not exist on disk\\n// used to reach `Fs::read_file` unguarded further down the pipeline\\n// (`collect_sources_rec`), which is a raw host primitive -- a missing file\\n// there is a JS-level throw from the host runner, NOT a guest `Error` effect,\\n// so it crosses the wasm/JS boundary uncaught and prints a \\\"[crash debug]\\\"\\n// dump instead of a located diagnostic. Catch it HERE, at the import\\n// resolution call site, where the raw import spelling and the importing\\n// module's source text (for a line:col lookup) are still both in scope.\\n// `@scope/name` package refs are exempt: their resolution has its own,\\n// more specific existence + pin checks downstream (`verify_store_package_fs`,\\n// `verify_lib_package_fs` in loader/index.vibe), which report a better\\n// message (pin/store-install guidance) than a generic \\\"cannot resolve\\n// import\\\" would.\\nfn located_missing_import_error(source: String, keyword: String, raw_path: String, resolved: String) -> String {\\n  let base_msg = String::concat(\\\"cannot resolve import '\\\", String::concat(raw_path, String::concat(\\\"' (resolved to \\\", String::concat(resolved, \\\")\\\"))))\\n  let needle = String::concat(keyword, String::concat(\\\" \\\", raw_path))\\n  let needle_off = String::index_of(source, needle)\\n  let off = if needle_off >= 0 {\\n    needle_off + String::length(keyword) + 1\\n  } else {\\n    String::index_of(source, raw_path)\\n  }\\n  if off < 0 {\\n    base_msg\\n  } else {\\n    let (line, col) = offset_to_line_col(source, off)\\n    String::concat(\\\"line \\\", String::concat(__to_string(line), String::concat(\\\":\\\", String::concat(__to_string(col), String::concat(\\\": \\\", base_msg)))))\\n  }\\n}\\n\\nfn resolve_checked_path_fs(base_dir: String, raw_path: String, self_path: String, source: String, keyword: String) -> String with { Error, Fs } {\\n  let resolved = resolve_path_fs(base_dir, raw_path, self_path)\\n  if String::starts_with(raw_path, \\\"@\\\") || Fs::exists(resolved) {\\n    resolved\\n  } else {\\n    throw(located_missing_import_error(source, keyword, raw_path, resolved))\\n  }\\n}\\n\\n// #943: `import <pkg> { a, b }` / `export <pkg> { a, b }` names used to bind\\n// blindly against whatever the resolved module's CHECKED env happened to\\n// contain (runtime/index.vibe's `bind_import_names_from_cache` does a flat,\\n// export-UNAWARE lookup): a nonexistent name silently became `CtUnknown` (no\\n// error unless later used somewhere that needed a real type), and a\\n// genuinely PRIVATE name silently bound its REAL type (every top-level def\\n// is present in a checked module's env, exported or not) and only failed\\n// much later, UNLOCATED, deep inside the codegen merge's export-aware\\n// private-namespacing pass (\\\"undefined variable (local): <name>\\\", no\\n// file/line, no mention of the import). Catch it HERE instead, at the same\\n// call site that already resolves the raw import path and has the\\n// importing module's own source text in scope for a line:col lookup\\n// (mirrors `located_missing_import_error` above).\\n//\\n// Scope (deliberately conservative -- see #943 discussion): only checked\\n// when the import target is a CONTRACT package boundary (`.../index.vpkg`\\n// or `.../index.vibei` -- ADR-0063/ADR-0070's declared-surface packages,\\n// the same shape #729/#847's boundary-enforcement machinery treats as the\\n// sole authoritative entry point), and only for plain lowercase-leading\\n// value names (see `is_lowercase_leading_plain_ident`). Shapes left\\n// UNVALIDATED on purpose:\\n//   - plain `index.vibe` facade directories: their effective surface is\\n//     historically LEAKIER than the facade's own re-export list --\\n//     fixtures/import_visibility_float_eq_test.vibe (#716) deliberately\\n//     imports `eq` through prelude/index.vibe even though the facade only\\n//     lists `Float::eq` (the merge-level export of float.vibe's `export\\n//     let eq` is what actually binds). A facade's collect_exports list is\\n//     therefore not a positive proof of absence.\\n//   - direct-file imports (`import ../checker_effects.vibe { ... }`, the\\n//     common compiler-internal shape): same-package edges are not a\\n//     package-contract question at all.\\n//   - a package whose store/lib copy is not materialized (unresolved\\n//     `@scope/name` pin) -- the `Fs::exists` guard below.\\nfn is_contract_boundary_path(path: String) -> Bool {\\n  String::ends_with(path, \\\"/index.vibei\\\") || String::ends_with(path, \\\"/index.vpkg\\\")\\n}\\n\\n// Type names, enum-variant constructors, and `Type::member` qualified items\\n// (`import ../ast { type Json, Type::method }`) are excluded on purpose:\\n// `collect_exports` (reused below for the VALUE namespace) enumerates enum\\n// VARIANT constructors but never the enum/struct/alias/trait NAME itself, so\\n// a routine, entirely legitimate `import ../core/index.vibe { Stmt, Expr,\\n// TypeEnv, ... }` (used all over this compiler) would false-positive as \\\"not\\n// exported\\\" if type-shaped names were checked against the same list. The\\n// vibe convention is snake_case values / UpperCamelCase types (CLAUDE.md),\\n// so a lowercase first letter reliably selects the VALUE namespace this\\n// check can actually speak to.\\nfn is_lowercase_leading_plain_ident(name: String) -> Bool {\\n  if String::length(name) == 0 {\\n    false\\n  } else if String::index_of(name, \\\"::\\\") >= 0 {\\n    false\\n  } else {\\n    let c = String::char_code_at(name, 0)\\n    c >= 97 && c <= 122\\n  }\\n}\\n\\nfn string_array_contains_hc(items: Array[String], target: String) -> Bool {\\n  let mut i = 0\\n  let mut found = false\\n  while i < Array::length(items) && !found {\\n    if Array::get(items, i) == target {\\n      found = true\\n    } else {\\n      i = i + 1\\n    }\\n  }\\n  found\\n}\\n\\n// The target's OWN export surface only -- deliberately NOT recursive (never\\n// walks the target's own imports/deps). Reusing\\n// `load_or_parse_module_header_fs_impl(resolved, ..)` here would recurse\\n// into this same validation for the target's own import list, which\\n// recurses again for ITS deps, and so on -- effectively re-validating the\\n// whole transitive import graph from every single edge. This reads +\\n// (contract-)parses `resolved` exactly once instead, mirroring the same\\n// decls/opaques/collect_exports combination the contract-header branch above\\n// already uses for its own `exports` result.\\nfn resolved_export_names_fs(resolved: String) -> Array[String] with { Error, Fs } {\\n  let source = Fs::read_file(resolved)\\n  if is_contract_ext(resolved) && !String::starts_with(source, contract_facade_marker) {\\n    let (_, pin_blanked) = extract_require_pins(source)\\n    let (cdecls, copaques, cextra) = parse_contract_program(lex(pin_blanked))\\n    let names = collect_exports(cextra)\\n    let mut cdi = 0\\n    while cdi < Array::length(cdecls) {\\n      let (cdname, _) = Array::get(cdecls, cdi)\\n      Array::push(names, cdname)\\n      cdi = cdi + 1\\n    }\\n    let mut coi = 0\\n    while coi < Array::length(copaques) {\\n      let (coname, _) = Array::get(copaques, coi)\\n      Array::push(names, coname)\\n      coi = coi + 1\\n    }\\n    names\\n  } else {\\n    collect_exports(parse_program(lex(source)))\\n  }\\n}\\n\\nfn located_import_name_error(source: String, keyword: String, raw_path: String, name: String, display: String) -> String {\\n  let base_msg = String::concat(\\\"\\\\\\\"\\\", String::concat(name, String::concat(\\\"\\\\\\\" is not exported by \\\", display)))\\n  let needle = String::concat(keyword, String::concat(\\\" \\\", raw_path))\\n  let needle_off = String::index_of(source, needle)\\n  let off = if needle_off >= 0 {\\n    needle_off + String::length(keyword) + 1\\n  } else {\\n    String::index_of(source, raw_path)\\n  }\\n  if off < 0 {\\n    base_msg\\n  } else {\\n    let (line, col) = offset_to_line_col(source, off)\\n    String::concat(\\\"line \\\", String::concat(__to_string(line), String::concat(\\\":\\\", String::concat(__to_string(col), String::concat(\\\": \\\", base_msg)))))\\n  }\\n}\\n\\n// A friendly `@scope/name` label for the error message when derivable from\\n// the resolved on-disk path (`.../lib/@vibe/json/index.vpkg` -> `@vibe/json`);\\n// falls back to the raw import spelling otherwise.\\nfn import_display_name(raw_path: String, resolved: String) -> String {\\n  if String::starts_with(raw_path, \\\"@\\\") {\\n    raw_path\\n  } else {\\n    let at = String::last_index_of(resolved, \\\"@\\\")\\n    if at < 0 {\\n      raw_path\\n    } else {\\n      let rest = String::substring(resolved, at, String::length(resolved))\\n      let slash1 = String::index_of(rest, \\\"/\\\")\\n      if slash1 < 0 {\\n        raw_path\\n      } else {\\n        let after_scope = String::substring(rest, slash1 + 1, String::length(rest))\\n        let slash2 = String::index_of(after_scope, \\\"/\\\")\\n        if slash2 < 0 {\\n          rest\\n        } else {\\n          String::substring(rest, 0, slash1 + 1 + slash2)\\n        }\\n      }\\n    }\\n  }\\n}\\n\\nfn validate_import_names_fs(source: String, keyword: String, raw_path: String, resolved: String, names: Array[(String, Option[String])]) -> Unit with { Error, Fs } {\\n  if is_contract_boundary_path(resolved) && Fs::exists(resolved) {\\n    let mut dep_exports = Array::slice([\\n      \\\"\\\"\\n    ], 0, 0)\\n    let mut loaded = false\\n    let mut i = 0\\n    while i < Array::length(names) {\\n      let (name, _alias) = Array::get(names, i)\\n      if is_lowercase_leading_plain_ident(name) {\\n        if !loaded {\\n          dep_exports = resolved_export_names_fs(resolved)\\n          loaded = true\\n        } else ()\\n        if string_array_contains_hc(dep_exports, name) {\\n          ()\\n        } else {\\n          throw(located_import_name_error(source, keyword, raw_path, name, import_display_name(raw_path, resolved)))\\n        }\\n      } else ()\\n      i = i + 1\\n    }\\n  } else ()\\n}\\n\\nfn collect_import_deps_from_stmts(stmts: Array[Stmt], base_dir: String, self_path: String, source: String) -> Array[String] with { Error, Fs } {\\n  let deps = Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n  let mut i = 0\\n  while i < Array::length(stmts) {\\n    match Array::get(stmts, i) {\\n      SImport(raw_path, names) => {\\n        let resolved = resolve_checked_path_fs(base_dir, raw_path, self_path, source, \\\"import\\\")\\n        validate_import_names_fs(source, \\\"import\\\", raw_path, resolved, names)\\n        Array::push(deps, resolved)\\n      },\\n      SReExport(raw_path, names) => {\\n        let resolved = resolve_checked_path_fs(base_dir, raw_path, self_path, source, \\\"export\\\")\\n        validate_import_names_fs(source, \\\"export\\\", raw_path, resolved, names)\\n        Array::push(deps, resolved)\\n      },\\n      _ => ()\\n    }\\n    i = i + 1\\n  }\\n  deps\\n}\\n\\n// Direct production siblings of a contract package, as raw import spellings\\n// (`./<name>`). Subdirectories are never scanned implicitly: their sources\\n// enter the graph only through an explicit relative import from a direct root.\\n// Fs::readdir is byte-sorted, so facade, hash, and dependency order remain\\n// deterministic.\\nfn directory_entry_path(dir: String, name: String) -> String {\\n  if dir == \\\"\\\" {\\n    name\\n  } else if dir == \\\"/\\\" {\\n    String::concat(\\\"/\\\", name)\\n  } else {\\n    String::concat(dir, String::concat(\\\"/\\\", name))\\n  }\\n}\\n\\nexport fn contract_sibling_impl_raws(dir: String) -> Array[String] with { Error, Fs } {\\n  let out = Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n  let scan_dir = if dir == \\\"\\\" { \\\".\\\" } else { dir }\\n  let names = Fs::readdir(scan_dir)\\n  let mut i = 0\\n  while i < Array::length(names) {\\n    let name = Array::get(names, i)\\n    if name != \\\"index.vibei\\\" && name != \\\"index.vibe\\\" && name != \\\"index.vpkg\\\" && String::ends_with(name, \\\".vibe\\\") && !String::ends_with(name, \\\"_test.vibe\\\") && !String::ends_with(name, \\\"_bench.vibe\\\") && !String::ends_with(name, \\\".draft.vibe\\\") && !String::starts_with(name, \\\"_\\\") {\\n      let full = directory_entry_path(dir, name)\\n      ensure_regular_source_fs(full)\\n      Array::push(out, String::concat(\\\"./\\\", name))\\n    } else {\\n      ()\\n    }\\n    i = i + 1\\n  }\\n  out\\n}\\n\\n// #897/#855 (ADR-0070 Phase 1): a .vpkg contract gets implicit membership\\n// unconditionally (unlike .vibei's legacy all-or-nothing gate) -- explicit\\n// `import ./x.vibe {}` declarations are merged with auto-discovered\\n// siblings rather than suppressing discovery. `explicit` wins ordering (its\\n// declared spelling is part of the package hash); newly-discovered names\\n// are appended after, de-duplicated, preserving contract_sibling_impl_raws'\\n// deterministic byte-sorted discovery order for anything not already listed.\\nexport fn merge_impl_raws_dedupe(explicit: Array[String], discovered: Array[String]) -> Array[String] {\\n  let out = Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n  let mut i = 0\\n  while i < Array::length(explicit) {\\n    Array::push(out, Array::get(explicit, i))\\n    i = i + 1\\n  }\\n  let mut j = 0\\n  while j < Array::length(discovered) {\\n    let d = Array::get(discovered, j)\\n    let mut k = 0\\n    let mut found = false\\n    while k < Array::length(out) && !found {\\n      if Array::get(out, k) == d {\\n        found = true\\n      } else {\\n        k = k + 1\\n      }\\n    }\\n    if !found {\\n      Array::push(out, d)\\n    } else {\\n      ()\\n    }\\n    j = j + 1\\n  }\\n  out\\n}\\n\\nexport fn load_or_parse_module_header_fs_impl(path: String, source: String, parse_count: Int) -> (Array[String], Array[String], Int) with { Error, Fs } {\\n  let cache_path = persistent_module_header_cache_path(path, compact_string_fingerprint(source))\\n  // #801 follow-up: a warm header whose package-index deps no longer match\\n  // the current resolution winners was written under a different resolution\\n  // context (a store copy appeared or vanished) — fall through to the cold\\n  // lane and re-resolve. Plain Bool dispatch (mut flag), NOT an Option match\\n  // wrapping the parser calls below — see the #708 note in the cold lane.\\n  let mut warm_deps = Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n  let mut warm_exports = Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n  let mut warm_ok = false\\n  if Fs::exists(cache_path) {\\n    let parsed = parse_persistent_module_header_text(normalize_persistent_cache_text(Fs::read_file(cache_path)))\\n    // #943 review (Codex P2): the cache key only covers the IMPORTER's\\n    // source, so editing a target contract (dropping/renaming an export)\\n    // while the importer is unchanged used to replay the stale header and\\n    // skip import-name validation entirely. v2 entries record each\\n    // contract-boundary dep's content fingerprint at build time; any\\n    // mismatch (or a pre-v2 entry, which recorded none) falls through to\\n    // the cold lane, which re-validates the import list against the\\n    // CURRENT contract surface.\\n    if parsed.3 && package_index_deps_are_current(parsed.0) && contract_dep_fingerprints_current(parsed.2) {\\n      warm_deps = parsed.0\\n      warm_exports = parsed.1\\n      warm_ok = true\\n    } else {\\n      ()\\n    }\\n  } else {\\n    ()\\n  }\\n  if warm_ok {\\n    (warm_deps, warm_exports, parse_count)\\n  } else {\\n    // #708: dispatch on `is_special_bundle_path` (a plain Bool) rather than\\n    // matching `special_bundle_header(path)`'s Option result directly here,\\n    // and never nest the `Some((deps, exports))` tuple-in-option pattern in\\n    // the same match as the `None` arm's parse call. A compiler that is\\n    // itself self-hosted under RC traps (\\\"wasm unreachable\\\" in `tk_name`,\\n    // reached via `parse_stmt`) reading a corrupted Token tag when\\n    // `load_or_parse_module_header_fs_impl` is compiled with the call chain\\n    // that reaches `tk_name` (lex_with_offsets/parse_program_located, or\\n    // even the plain lex/parse_program pair) sitting inside ONE arm of a\\n    // `match` on `special_bundle_header(path)`'s `Option` result — even\\n    // though that arm is never taken for ordinary (non-bundle-file) input.\\n    // Splitting the dispatch into this Bool `if` (special_bundle_header is\\n    // then only ever called, and only ever `match`ed, inside the branch that\\n    // does NOT also reach the parser) reproducibly avoids the trap for the\\n    // simplest repro. NOT a full fix for #708: a structurally similar crash\\n    // still reproduces one level deeper (`parse_type_impl`, reached once the\\n    // input has a type annotation) -- root cause remains uncharacterized, and\\n    // this workaround likely needs to be repeated at that/other call sites.\\n    // #753: an already-desugared facade can reach this parse under its\\n    // .vibei path (type_db re-reads COLLECTED sources, and collection\\n    // replaces a contract's text with its facade). A facade is ordinary\\n    // program syntax — re-parsing it as contract grammar mis-reads its\\n    // surface (a facade with only type defs has zero impl imports, which\\n    // would trigger sibling auto-discovery below and pull `_test.vibe`\\n    // neighbors into the package's dep set — \\\"import cycle detected\\\" for\\n    // any `import .` test). Route it to the ordinary branch instead.\\n    let is_contract_source = is_contract_ext(path) && !String::starts_with(source, contract_facade_marker)\\n    let header_result = if is_contract_source {\\n      // #740 fallout: a .vibei contract is not ordinary program syntax\\n      // (bodyless fn/type declarations), so the full-program parse below\\n      // threw \\\"expected = but got type\\\". Only the COLD-cache lane reaches\\n      // this parse (warm runs read the cached header), which is why it\\n      // survived until the whole-graph cold repro. Parse with the contract\\n      // grammar instead: deps come from the implementation imports, the\\n      // export surface from decls + opaques + transparent type stmts.\\n      let (_, pin_blanked) = extract_require_pins(source)\\n      let (cdecls, copaques, cextra) = parse_contract_program(lex(pin_blanked))\\n      let cexports = collect_exports(cextra)\\n      let mut cdi = 0\\n      while cdi < Array::length(cdecls) {\\n        let (cdname, _) = Array::get(cdecls, cdi)\\n        Array::push(cexports, cdname)\\n        cdi = cdi + 1\\n      }\\n      let mut coi = 0\\n      while coi < Array::length(copaques) {\\n        let (coname, _) = Array::get(copaques, coi)\\n        Array::push(cexports, coname)\\n        coi = coi + 1\\n      }\\n      // #730: a contract with no implementation imports auto-discovers its\\n      // siblings — those files are deps of the header too, or an impl edit\\n      // would not invalidate this cache entry.\\n      // #897/#855: a .vpkg contract always merges discovered siblings with\\n      // its explicit deps (implicit membership is unconditional for .vpkg),\\n      // so its header deps must include both, not just whichever won under\\n      // the old either/or gate.\\n      let cdeps = collect_import_deps_from_stmts(cextra, dir_of_path(path), path, pin_blanked)\\n      let is_vpkg_contract = String::ends_with(path, \\\".vpkg\\\")\\n      let cdeps2 = if is_vpkg_contract || Array::length(cdeps) == 0 {\\n        let craws = if is_vpkg_contract {\\n          let (craws0, _) = classify_contract_stmts(cextra)\\n          merge_impl_raws_dedupe(craws0, contract_sibling_impl_raws(dir_of_path(path)))\\n        } else {\\n          contract_sibling_impl_raws(dir_of_path(path))\\n        }\\n        let resolved = Array::slice([\\n          \\\"\\\"\\n        ], 0, 0)\\n        let mut cri = 0\\n        while cri < Array::length(craws) {\\n          Array::push(resolved, resolve_path_fs(dir_of_path(path), Array::get(craws, cri), path))\\n          cri = cri + 1\\n        }\\n        resolved\\n      } else {\\n        cdeps\\n      }\\n      (cdeps2, cexports, parse_count + 1)\\n    } else if is_special_bundle_path(path) {\\n      match special_bundle_header(path) {\\n        Some(pair) => {\\n          let deps = pair.0\\n          let exports = pair.1\\n          (deps, exports, parse_count)\\n        },\\n        None => (Array::slice([\\n          \\\"\\\"\\n        ], 0, 0), Array::slice([\\n          \\\"\\\"\\n        ], 0, 0), parse_count)\\n      }\\n    } else {\\n      let (tokens, starts, _ends) = lex_with_offsets(source)\\n      let stmts = handle {\\n        parse_program_located(tokens, starts, source)\\n      } with Error {\\n        Throw(msg) => throw(String::concat(path, String::concat(\\\": \\\", msg)))\\n      }\\n      (collect_import_deps_from_stmts(stmts, dir_of_path(path), path, source), collect_exports(stmts), parse_count + 1)\\n    }\\n    let deps = header_result.0\\n    let exports = header_result.1\\n    let next_parse_count = header_result.2\\n    Fs::write_file(cache_path, persistent_module_header_text(deps, exports, contract_dep_fingerprints_now(deps)))\\n    (deps, exports, next_parse_count)\\n  }\\n}\\n\\n// Snapshot each contract-boundary dep's content fingerprint for the v2\\n// header entry (#943 review). A dep that is not a contract boundary — or\\n// whose file is not materialized — records nothing: the warm gate only\\n// compares what was recorded, and a contract that APPEARS later changes\\n// resolution winners, which the #801 package_index_deps_are_current gate\\n// already catches.\\nfn contract_dep_fingerprints_now(deps: Array[String]) -> Array[(String, String)] with { Fs } {\\n  let out = Array::slice([\\n    (\\\"\\\", \\\"\\\")\\n  ], 0, 0)\\n  let mut i = 0\\n  while i < Array::length(deps) {\\n    let d = Array::get(deps, i)\\n    if is_contract_boundary_path(d) && Fs::exists(d) {\\n      Array::push(out, (d, compact_string_fingerprint(Fs::read_file(d))))\\n    } else {\\n      ()\\n    }\\n    i = i + 1\\n  }\\n  out\\n}\\n\\n// Warm-gate check: every recorded contract fingerprint must still match the\\n// on-disk contract text. A vanished or edited contract fails the gate and\\n// forces a cold re-parse + re-validation of the importer's names.\\nfn contract_dep_fingerprints_current(cdeps: Array[(String, String)]) -> Bool with { Fs } {\\n  let mut i = 0\\n  let mut ok = true\\n  while i < Array::length(cdeps) {\\n    let (cpath, cfp) = Array::get(cdeps, i)\\n    if ok {\\n      if Fs::exists(cpath) {\\n        ok = compact_string_fingerprint(Fs::read_file(cpath)) == cfp\\n      } else {\\n        ok = false\\n      }\\n    } else {\\n      ()\\n    }\\n    i = i + 1\\n  }\\n  ok\\n}\\n\")\n}\n\nlet cli_adapter_source_141 = () -> (String, String) {\n  (\"lib/@vibe/compiler/loader/manifest_sources.vibe\",\n\"//# Imports\\n\\nimport ./header_cache.vibe {\\n  load_or_parse_module_header_fs_impl\\n}\\n\\nimport ../cache/persistent_cache.vibe {\\n  compact_string_fingerprint, normalize_persistent_cache_text, persistent_manifest_header_cache_path\\n}\\n\\nimport ../module_graph_path.vibe {\\n  contains_path, dir_of_path, normalize_path, path_set_add, path_set_contains, path_set_new,\\n  resolve_import_path_candidates\\n}\\n\\nimport ../syntax {\\n  lex, Token, collect_import_path, peek, skip_semi\\n}\\n\\n//# Path helpers\\n\\n// #740: NORMALIZED join. Manifest rows may point outside the compiler dir\\n// (\\\"../../lib/@vibe/core/...\\\"); the joined spelling must match what import\\n// resolution produces (resolve_import_path normalizes), or the merge plan\\n// keys the file under one spelling while importers resolve the other and\\n// every cross-reference silently misses (bare `sha1 @call` in the merge).\\n// #769: exported for loader_hotspot_probe's linear baseline -- it must build\\n// row paths with the SAME `../` normalization the real builders apply, or the\\n// manifest's `../../../lib/@vibe/...` rows never match the collected sources.\\nexport fn join_path(base_dir: String, rel_path: String) -> String {\\n  if base_dir == \\\"\\\" {\\n    normalize_path(rel_path)\\n  } else {\\n    normalize_path(String::concat(base_dir, String::concat(\\\"/\\\", rel_path)))\\n  }\\n}\\n\\nfn resolve_manifest_dep_path(base_dir: String, raw_path: String, manifest_path_index: Map[String, Bool]) -> String with { Error, Fs } {\\n  if String::length(raw_path) > 0 && String::char_code_at(raw_path, 0) == 64 {\\n    raw_path\\n  } else {\\n    let candidates = resolve_import_path_candidates(base_dir, raw_path)\\n    let mut i = 0\\n    let mut found = \\\"\\\"\\n    while i < Array::length(candidates) {\\n      if found == \\\"\\\" {\\n        let candidate = Array::get(candidates, i)\\n        if Map::has_key(manifest_path_index, candidate) || Fs::exists(candidate) {\\n          found = candidate\\n        }\\n      }\\n      i = i + 1\\n    }\\n    if found == \\\"\\\" {\\n      Array::get(candidates, 0)\\n    } else {\\n      found\\n    }\\n  }\\n}\\n\\nfn starts_with_reexport_path_token(tok: Token) -> Bool {\\n  match tok {\\n    TDot => true,\\n    _ => false\\n  }\\n}\\n\\nfn is_ident_char(c: Int) -> Bool {\\n  (c >= 'a' && c <= 'z') ||\\n    (c >= 'A' && c <= 'Z') ||\\n    (c >= '0' && c <= '9') ||\\n    c == '_'\\n}\\n\\nfn slice_eq_text(s: String, start: Int, text: String) -> Bool {\\n  let text_len = String::length(text)\\n  if start + text_len > String::length(s) {\\n    false\\n  } else {\\n    let mut i = 0\\n    let mut ok = true\\n    while ok && i < text_len {\\n      ok = String::char_code_at(s, start + i) == String::char_code_at(text, i)\\n      i = i + 1\\n    }\\n    ok\\n  }\\n}\\n\\nfn starts_with_keyword_at(s: String, pos: Int, keyword: String) -> Bool {\\n  let keyword_len = String::length(keyword)\\n  if !(slice_eq_text(s, pos, keyword)) {\\n    false\\n  } else {\\n    let before_ok = if pos == 0 {\\n      true\\n    } else {\\n      !(is_ident_char(String::char_code_at(s, pos - 1)))\\n    }\\n    let after_pos = pos + keyword_len\\n    let after_ok = if after_pos >= String::length(s) {\\n      true\\n    } else {\\n      !(is_ident_char(String::char_code_at(s, after_pos)))\\n    }\\n    before_ok && after_ok\\n  }\\n}\\n\\nfn skip_header_ws_and_comments(s: String, len: Int, start: Int) -> Int {\\n  let mut pos = start\\n  let mut done = false\\n  while !done && pos < len {\\n    let c = String::char_code_at(s, pos)\\n    if c == ' ' || c == '\\\\n' || c == '\\\\t' || c == '\\\\r' || c == ';' {\\n      pos = pos + 1\\n    } else if c == '/' && pos + 1 < len && String::char_code_at(s, pos + 1) == '/' {\\n      pos = pos + 2\\n      while pos < len && String::char_code_at(s, pos) != '\\\\n' {\\n        pos = pos + 1\\n      }\\n    } else {\\n      done = true\\n    }\\n  }\\n  pos\\n}\\n\\nfn scan_header_stmt_end(s: String, len: Int, start: Int) -> Int with { Error } {\\n  let mut pos = start\\n  let mut brace_depth = 0\\n  let mut in_string = false\\n  let mut string_quote = 0\\n  let mut escape = false\\n  let mut done = false\\n  while pos < len && !done {\\n    let c = String::char_code_at(s, pos)\\n    if in_string {\\n      if escape {\\n        escape = false\\n      } else if c == '\\\\\\\\' {\\n        escape = true\\n      } else if c == string_quote {\\n        in_string = false\\n      }\\n      pos = pos + 1\\n    } else if c == '\\\"' || c == '\\\\'' {\\n      in_string = true\\n      string_quote = c\\n      pos = pos + 1\\n    } else if c == '/' && pos + 1 < len && String::char_code_at(s, pos + 1) == '/' {\\n      while pos < len && String::char_code_at(s, pos) != '\\\\n' {\\n        pos = pos + 1\\n      }\\n    } else if c == '{' {\\n      brace_depth = brace_depth + 1\\n      pos = pos + 1\\n    } else if c == '}' {\\n      if brace_depth > 0 {\\n        brace_depth = brace_depth - 1\\n      }\\n      pos = pos + 1\\n    } else if brace_depth == 0 && (c == '\\\\n' || c == ';') {\\n      done = true\\n    } else {\\n      pos = pos + 1\\n    }\\n  }\\n  pos\\n}\\n\\nfn skip_brace_list(tokens: Array[Token], pos: Int) -> Int with { Error } {\\n  match peek(tokens, pos) {\\n    TLBrace => {\\n      let mut depth = 1\\n      let mut i = pos + 1\\n      while depth > 0 {\\n        match peek(tokens, i) {\\n          TLBrace => {\\n            depth = depth + 1\\n          },\\n          TRBrace => {\\n            depth = depth - 1\\n          },\\n          TEof => throw(\\\"unterminated brace list in manifest import scanner\\\"),\\n          _ => ()\\n        }\\n        i = i + 1\\n      }\\n      i\\n    }\\n    _ => throw(\\\"expected '{' in manifest import scanner\\\")\\n  }\\n}\\n\\nfn scan_header_import_dep(tokens: Array[Token], pos: Int, base_dir: String, manifest_path_index: Map[String, Bool]) -> (String, Int) with { Error, Fs } {\\n  let (raw_path, next_pos) = match peek(tokens, pos) {\\n    TIdent(name) =>\\n      if String::length(name) > 1 && String::char_code_at(name, 0) == 64 {\\n        (name, pos + 1)\\n      } else {\\n        collect_import_path(tokens, pos, \\\"\\\")\\n      },\\n    _ => collect_import_path(tokens, pos, \\\"\\\")\\n  }\\n  let after_path = match peek(tokens, next_pos) {\\n    TIdent(alias_name) =>\\n      if String::length(alias_name) > 1 && String::char_code_at(alias_name, 0) == 64 {\\n        next_pos + 1\\n      } else {\\n        next_pos\\n      },\\n    _ => next_pos\\n  }\\n  let end_pos = match peek(tokens, after_path) {\\n    TLBrace => skip_brace_list(tokens, after_path),\\n    _ => after_path\\n  }\\n  (resolve_manifest_dep_path(base_dir, raw_path, manifest_path_index), end_pos)\\n}\\n\\nfn collect_manifest_header_deps_from_source(path: String, source: String, manifest_path_index: Map[String, Bool]) -> Array[String] with { Error, Fs } {\\n  let deps = Array::slice([\\\"\\\"], 0, 0)\\n  let base_dir = dir_of_path(path)\\n  let len = String::length(source)\\n  let mut pos = 0\\n  let mut done = false\\n  while !done {\\n    pos = skip_header_ws_and_comments(source, len, pos)\\n    if pos >= len {\\n      done = true\\n    } else {\\n      let is_import = starts_with_keyword_at(source, pos, \\\"import\\\")\\n      let is_export = starts_with_keyword_at(source, pos, \\\"export\\\")\\n      if !(is_import || is_export) {\\n        done = true\\n      } else {\\n        let stmt_end = scan_header_stmt_end(source, len, pos)\\n        let stmt_source = source[pos:stmt_end]\\n        let tokens = lex(stmt_source)\\n        let stmt_pos = skip_semi(tokens, 0)\\n        match peek(tokens, stmt_pos) {\\n          TImport => {\\n            let (dep_path, _) = scan_header_import_dep(\\n              tokens,\\n              stmt_pos + 1,\\n              base_dir,\\n              manifest_path_index\\n            )\\n            Array::push(deps, dep_path)\\n          },\\n          TExport => {\\n            if starts_with_reexport_path_token(peek(tokens, stmt_pos + 1)) {\\n              let (dep_path, _) = scan_header_import_dep(\\n                tokens,\\n                stmt_pos + 1,\\n                base_dir,\\n                manifest_path_index\\n              )\\n              Array::push(deps, dep_path)\\n            }\\n          },\\n          _ => {\\n            done = true\\n          }\\n        }\\n        pos = stmt_end\\n      }\\n    }\\n  }\\n  deps\\n}\\n\\nfn collect_manifest_header_deps_from_source_with_context(path: String, source: String, manifest_path_index: Map[String, Bool]) -> Array[String] with { Error, Fs } {\\n  handle {\\n    collect_manifest_header_deps_from_source(path, source, manifest_path_index)\\n  } with Error {\\n    Throw(err) => throw(\\\"manifest header scan failed for \\\" + path + \\\": \\\" + err)\\n  }\\n}\\n\\nfn is_manifest_external_terminal_dep(path: String) -> Bool {\\n  String::ends_with(path, \\\"compiler_sources_bundle.vibe\\\")\\n}\\n\\nfn should_schedule_manifest_dep(dep_path: String, manifest_path_index: Map[String, Bool]) -> Bool {\\n  if Map::has_key(manifest_path_index, dep_path) {\\n    true\\n  } else {\\n    !(is_manifest_external_terminal_dep(dep_path))\\n  }\\n}\\n\\nfn load_or_parse_module_header_deps_with_context(path: String, source: String) -> Array[String] with { Error, Fs } {\\n  handle {\\n    let (deps, _, _) = load_or_parse_module_header_fs_impl(path, source, 0)\\n    deps\\n  } with Error {\\n    Throw(err) => throw(\\\"module header parse failed for \\\" + path + \\\": \\\" + err)\\n  }\\n}\\n\\nexport fn build_manifest_source_index(sources: Array[(String, String)]) -> Map[String, String] {\\n  let builder = MapBuilder::new()\\n  let mut i = 0\\n  while i < Array::length(sources) {\\n    let (path, source) = Array::get(sources, i)\\n    MapBuilder::set(builder, path, source)\\n    i = i + 1\\n  }\\n  MapBuilder::freeze(builder)\\n}\\n\\nfn source_lookup_in_index(source_index: Map[String, String], path_key: String) -> Option[String] {\\n  if Map::has_key(source_index, path_key) {\\n    Some(Map::get(source_index, path_key))\\n  } else {\\n    None\\n  }\\n}\\n\\nexport fn build_manifest_path_index(paths: Array[String]) -> Map[String, Bool] {\\n  let builder = MapBuilder::new()\\n  let mut i = 0\\n  while i < Array::length(paths) {\\n    MapBuilder::set(builder, Array::get(paths, i), true)\\n    i = i + 1\\n  }\\n  MapBuilder::freeze(builder)\\n}\\n\\nfn empty_path_index() -> Map[String, Bool] {\\n  let builder = MapBuilder::new()\\n  MapBuilder::freeze(builder)\\n}\\n\\nfn build_manifest_path_index_from_rows(base_dir: String, rows: Array[(String, String)]) -> Map[String, Bool] {\\n  let builder = MapBuilder::new()\\n  let mut i = 0\\n  while i < Array::length(rows) {\\n    let (_, rel_path) = Array::get(rows, i)\\n    MapBuilder::set(builder, join_path(base_dir, rel_path), true)\\n    i = i + 1\\n  }\\n  MapBuilder::freeze(builder)\\n}\\n\\nfn find_manifest_base_dir(entry_path: String) -> Option[String] with { Fs } {\\n  let mut base_dir = dir_of_path(entry_path)\\n  let mut found = None\\n  let mut done = false\\n  loop {\\n    if done {\\n      break\\n    }\\n    let manifest_path = join_path(base_dir, \\\"compiler_sources_manifest.tsv\\\")\\n    if Fs::exists(manifest_path) {\\n      found = Some(base_dir)\\n      done = true\\n    } else if base_dir == \\\"\\\" {\\n      done = true\\n    } else {\\n      let parent = dir_of_path(base_dir)\\n      if parent == base_dir {\\n        done = true\\n      } else {\\n        base_dir = parent\\n      }\\n    }\\n  }\\n  found\\n}\\n\\nfn strip_trailing_cr(line: String) -> String {\\n  let len = String::length(line)\\n  if len > 0 {\\n    if String::char_code_at(line, len - 1) == 13 {\\n      line[0:len - 1]\\n    } else {\\n      line\\n    }\\n  } else {\\n    line\\n  }\\n}\\n\\nfn find_char(s: String, target: Int) -> Int {\\n  let len = String::length(s)\\n  let mut i = 0\\n  let mut result = -1\\n  while i < len {\\n    if String::char_code_at(s, i) == target {\\n      result = i\\n      i = len\\n    } else {\\n      i = i + 1\\n    }\\n  }\\n  result\\n}\\n\\nfn split_tsv_fields(line: String) -> Array[String] {\\n  let fields = Array::slice([\\\"\\\"], 0, 0)\\n  let len = String::length(line)\\n  let mut start = 0\\n  let mut i = 0\\n  while i <= len {\\n    let at_field_end = if i == len {\\n      true\\n    } else {\\n      String::char_code_at(line, i) == 9\\n    }\\n    if at_field_end {\\n      Array::push(fields, line[start:i])\\n      start = i + 1\\n    }\\n    i = i + 1\\n  }\\n  fields\\n}\\n\\nlet header_value_separator = String::from_char_code(31)\\n\\nfn join_header_values(values: Array[String]) -> String {\\n  // O(N) join via StringBuilder; per-value String::concat was O(N²) (issue #366).\\n  let out = StringBuilder::new()\\n  let mut i = 0\\n  while i < Array::length(values) {\\n    if i > 0 {\\n      StringBuilder::push(out, header_value_separator)\\n    }\\n    StringBuilder::push(out, Array::get(values, i))\\n    i = i + 1\\n  }\\n  StringBuilder::freeze(out)\\n}\\n\\nfn split_header_values(text: String) -> Array[String] {\\n  let values = Array::slice([\\\"\\\"], 0, 0)\\n  if String::length(text) == 0 {\\n    values\\n  } else {\\n    let sep = String::char_code_at(header_value_separator, 0)\\n    let len = String::length(text)\\n    let mut start = 0\\n    let mut i = 0\\n    while i <= len {\\n      let at_value_end = if i == len {\\n        true\\n      } else {\\n        String::char_code_at(text, i) == sep\\n      }\\n      if at_value_end {\\n        Array::push(values, text[start:i])\\n        start = i + 1\\n      }\\n      i = i + 1\\n    }\\n    values\\n  }\\n}\\n\\nfn empty_manifest_header_cache_rows() -> Array[(String, String, String, String)] {\\n  Array::slice([(\\\"\\\", \\\"\\\", \\\"\\\", \\\"\\\")], 0, 0)\\n}\\n\\nfn empty_grouped_sources() -> Array[(String, Array[(String, String)])] {\\n  Array::slice([(\\\"\\\", Array::slice([(\\\"\\\", \\\"\\\")], 0, 0))], 0, 0)\\n}\\n\\n// #801 (系統2 follow-up): a bucket that does not exist yet MUST have its first\\n// element pushed BEFORE the (group_name, bucket) tuple is embedded into\\n// `groups` -- never the other way around. Pushing an EMPTY bucket into\\n// `groups` first and mutating the returned handle afterward (the previous\\n// shape of this function) let a `groups`-array growth event land between the\\n// two pushes; the bucket handle the caller went on to push the first real\\n// element into was then observed to diverge from the copy embedded in\\n// `groups`, leaving a corrupted `path=\\\"0\\\"` row behind (reproduced\\n// deterministically for entry \\\"lib/@vibe/compiler/loader/index.vibe\\\": the\\n// 11th distinct group, \\\"vibe_core\\\", landed exactly on this hazard while\\n// every other group -- multi-row groups whose bucket is already \\\"live\\\" by\\n// the time any subsequent `groups` growth happens, and single-row groups\\n// created before the hazard's growth boundary -- did not). The already-safe\\n// sibling `push_grouped_source` (loader/index.vibe) avoids this by always\\n// populating a brand-new bucket with its first item BEFORE pushing the tuple\\n// into the outer array; this seeded variant applies the same ordering here.\\nfn ensure_grouped_source_bucket_seeded(groups: Array[(String, Array[(String, String)])], group_name: String, path: String, value: String) -> Array[(String, String)] {\\n  let mut i = 0\\n  let mut found = None\\n  while i < Array::length(groups) {\\n    let (name, sources) = Array::get(groups, i)\\n    if name == group_name {\\n      found = Some(sources)\\n      i = Array::length(groups)\\n    } else {\\n      i = i + 1\\n    }\\n  }\\n  match found {\\n    Some(sources) => {\\n      Array::push(sources, (path, value))\\n      sources\\n    },\\n    None => {\\n      let sources = Array::slice([(\\\"\\\", \\\"\\\")], 0, 0)\\n      Array::push(sources, (path, value))\\n      Array::push(groups, (group_name, sources))\\n      sources\\n    }\\n  }\\n}\\n\\nfn build_grouped_sources_from_manifest_rows_with_lookup(base_dir: String, rows: Array[(String, String)], on_path: (String) -> Option[String]) -> Array[(String, Array[(String, String)])] {\\n  let groups = empty_grouped_sources()\\n  let mut last_group_name = \\\"\\\"\\n  let mut last_group_sources = Array::slice([(\\\"\\\", \\\"\\\")], 0, 0)\\n  let mut has_last_group = false\\n  let mut i = 0\\n  while i < Array::length(rows) {\\n    let (group_name, rel_path) = Array::get(rows, i)\\n    let path = join_path(base_dir, rel_path)\\n    match on_path(path) {\\n      Some(source) => {\\n        if has_last_group && last_group_name == group_name {\\n          Array::push(last_group_sources, (path, source))\\n        } else {\\n          let ensured = ensure_grouped_source_bucket_seeded(groups, group_name, path, source)\\n          last_group_name = group_name\\n          last_group_sources = ensured\\n          has_last_group = true\\n        }\\n      },\\n      None => ()\\n    }\\n    i = i + 1\\n  }\\n  groups\\n}\\n\\n//# Manifest parsing\\n\\nfn parse_source_manifest_rows(manifest_source: String) -> Array[(String, String)] with { Error } {\\n  let rows = Array::slice([(\\\"\\\", \\\"\\\")], 0, 0)\\n  let len = String::length(manifest_source)\\n  let mut line_start = 0\\n  let mut i = 0\\n  while i <= len {\\n    let at_line_end = if i == len {\\n      true\\n    } else {\\n      String::char_code_at(manifest_source, i) == 10\\n    }\\n    if at_line_end {\\n      let raw_line = strip_trailing_cr(manifest_source[line_start:i])\\n      let line_len = String::length(raw_line)\\n      let has_content = line_len > 0\\n      let is_comment = if has_content {\\n        String::char_code_at(raw_line, 0) == 35\\n      } else {\\n        false\\n      }\\n      if has_content {\\n        if is_comment {\\n          ()\\n        } else {\\n          let tab_idx = find_char(raw_line, 9)\\n          let invalid_row = if tab_idx < 0 {\\n            true\\n          } else {\\n            tab_idx + 1 >= line_len\\n          }\\n          if invalid_row {\\n            throw(String::concat(\\\"invalid source manifest row: \\\", raw_line))\\n          }\\n          let group = raw_line[0:tab_idx]\\n          let path = raw_line[tab_idx + 1:line_len]\\n          Array::push(rows, (group, path))\\n        }\\n      }\\n      line_start = i + 1\\n    }\\n    i = i + 1\\n  }\\n  rows\\n}\\n\\nexport fn try_load_manifest_rows(entry_path: String) -> Option[(String, Array[(String, String)])] with { Error, Fs } {\\n  match find_manifest_base_dir(entry_path) {\\n    Some(base_dir) => {\\n      let manifest_path = join_path(base_dir, \\\"compiler_sources_manifest.tsv\\\")\\n      let rows = parse_source_manifest_rows(Fs::read_file(manifest_path))\\n      let mut has_entry = false\\n      let mut i = 0\\n      while i < Array::length(rows) {\\n        let (_, rel_path) = Array::get(rows, i)\\n        let path = join_path(base_dir, rel_path)\\n        if path == entry_path {\\n          has_entry = true\\n        }\\n        i = i + 1\\n      }\\n      if has_entry {\\n        Some((base_dir, rows))\\n      } else {\\n        None\\n      }\\n    },\\n    None => None\\n  }\\n}\\n\\nexport fn load_manifest_full_sources(base_dir: String, rows: Array[(String, String)]) -> Array[(String, String)] with { Error, Fs } {\\n  let full_sources = Array::slice([(\\\"\\\", \\\"\\\")], 0, 0)\\n  let mut i = 0\\n  while i < Array::length(rows) {\\n    let (_, rel_path) = Array::get(rows, i)\\n    let path = join_path(base_dir, rel_path)\\n    Array::push(full_sources, (path, Fs::read_file(path)))\\n    i = i + 1\\n  }\\n  full_sources\\n}\\n\\nfn load_manifest_sources_by_path_index(base_dir: String, rows: Array[(String, String)], needed_path_index: Map[String, Bool]) -> Array[(String, String)] with { Error, Fs } {\\n  let sources = Array::slice([(\\\"\\\", \\\"\\\")], 0, 0)\\n  let mut i = 0\\n  while i < Array::length(rows) {\\n    let (_, rel_path) = Array::get(rows, i)\\n    let path = join_path(base_dir, rel_path)\\n    if Map::has_key(needed_path_index, path) {\\n      Array::push(sources, (path, Fs::read_file(path)))\\n    }\\n    i = i + 1\\n  }\\n  sources\\n}\\n\\nfn load_manifest_source_groups_by_path_index(base_dir: String, rows: Array[(String, String)], needed_path_index: Map[String, Bool]) -> Array[(String, Array[(String, String)])] with { Error, Fs } {\\n  let groups = empty_grouped_sources()\\n  let mut last_group_name = \\\"\\\"\\n  let mut last_group_sources = Array::slice([(\\\"\\\", \\\"\\\")], 0, 0)\\n  let mut has_last_group = false\\n  let mut i = 0\\n  while i < Array::length(rows) {\\n    let (group_name, rel_path) = Array::get(rows, i)\\n    let path = join_path(base_dir, rel_path)\\n    if Map::has_key(needed_path_index, path) {\\n      if has_last_group && last_group_name == group_name {\\n        Array::push(last_group_sources, (path, Fs::read_file(path)))\\n      } else {\\n        let ensured = ensure_grouped_source_bucket_seeded(groups, group_name, path, Fs::read_file(path))\\n        last_group_name = group_name\\n        last_group_sources = ensured\\n        has_last_group = true\\n      }\\n    }\\n    i = i + 1\\n  }\\n  groups\\n}\\n\\nexport fn build_grouped_sources_from_manifest_row_source_index(base_dir: String, rows: Array[(String, String)], source_index: Map[String, String]) -> Array[(String, Array[(String, String)])] {\\n  build_grouped_sources_from_manifest_rows_with_lookup(\\n    base_dir,\\n    rows,\\n    (path: String) -> Option[String] {\\n      source_lookup_in_index(source_index, path)\\n    }\\n  )\\n}\\n\\nexport fn build_grouped_sources_from_manifest_rows(base_dir: String, rows: Array[(String, String)], sources: Array[(String, String)]) -> Array[(String, Array[(String, String)])] {\\n  let source_index = build_manifest_source_index(sources)\\n  build_grouped_sources_from_manifest_row_source_index(base_dir, rows, source_index)\\n}\\n\\nexport fn filter_manifest_sources_by_path_index(preloaded_sources: Array[(String, String)], needed_path_index: Map[String, Bool]) -> Array[(String, String)] {\\n  let filtered_sources = Array::slice([(\\\"\\\", \\\"\\\")], 0, 0)\\n  let mut i = 0\\n  while i < Array::length(preloaded_sources) {\\n    let (path, source) = Array::get(preloaded_sources, i)\\n    if Map::has_key(needed_path_index, path) {\\n      Array::push(filtered_sources, (path, source))\\n    }\\n    i = i + 1\\n  }\\n  filtered_sources\\n}\\n\\nexport fn filter_manifest_sources_by_paths(preloaded_sources: Array[(String, String)], needed_paths: Array[String]) -> Array[(String, String)] {\\n  let needed_path_index = build_manifest_path_index(needed_paths)\\n  filter_manifest_sources_by_path_index(preloaded_sources, needed_path_index)\\n}\\n\\nexport fn filter_manifest_sources_by_paths_linear(preloaded_sources: Array[(String, String)], needed_paths: Array[String]) -> Array[(String, String)] {\\n  let filtered_sources = Array::slice([(\\\"\\\", \\\"\\\")], 0, 0)\\n  let mut i = 0\\n  while i < Array::length(preloaded_sources) {\\n    let (path, source) = Array::get(preloaded_sources, i)\\n    if contains_path(needed_paths, path) {\\n      Array::push(filtered_sources, (path, source))\\n    }\\n    i = i + 1\\n  }\\n  filtered_sources\\n}\\n\\nexport fn filter_manifest_sources_by_source_index(needed_paths: Array[String], preloaded_source_index: Map[String, String]) -> Array[(String, String)] {\\n  let filtered_sources = Array::slice([(\\\"\\\", \\\"\\\")], 0, 0)\\n  let mut i = 0\\n  while i < Array::length(needed_paths) {\\n    let path = Array::get(needed_paths, i)\\n    match source_lookup_in_index(preloaded_source_index, path) {\\n      Some(source) => Array::push(filtered_sources, (path, source)),\\n      None => ()\\n    }\\n    i = i + 1\\n  }\\n  filtered_sources\\n}\\n\\n//# Manifest header cache\\n\\nfn parse_persistent_manifest_header_cache(raw: String) -> (Int, Option[(String, String, String)], Array[(String, String, String, String)]) with { Error } {\\n  let len = String::length(raw)\\n  let mut line_start = 0\\n  let mut i = 0\\n  let mut version = 0\\n  let mut manifest = None\\n  let rows = empty_manifest_header_cache_rows()\\n  while i <= len {\\n    let at_line_end = if i == len {\\n      true\\n    } else {\\n      String::char_code_at(raw, i) == 10\\n    }\\n    if at_line_end {\\n      let line = strip_trailing_cr(raw[line_start:i])\\n      if String::length(line) > 0 {\\n        let fields = split_tsv_fields(line)\\n        let tag = Array::get(fields, 0)\\n        if tag == \\\"version\\\" {\\n          if Array::length(fields) != 2 {\\n            throw(\\\"invalid persistent manifest header cache version\\\")\\n          }\\n          let version_text = Array::get(fields, 1)\\n          if version_text == \\\"1\\\" {\\n            version = 1\\n          } else if version_text == \\\"2\\\" {\\n            version = 2\\n          } else {\\n            throw(\\\"invalid persistent manifest header cache version\\\")\\n          }\\n        } else if tag == \\\"manifest\\\" {\\n          if Array::length(fields) != 4 {\\n            throw(\\\"invalid persistent manifest header cache manifest row\\\")\\n          }\\n          manifest = Some((Array::get(fields, 1), Array::get(fields, 2), Array::get(fields, 3)))\\n        } else if tag == \\\"header\\\" {\\n          if version == 1 {\\n            if Array::length(fields) != 6 {\\n              throw(\\\"invalid persistent manifest header cache header row\\\")\\n            }\\n            Array::push(\\n              rows,\\n              (\\n                Array::get(fields, 1),\\n                Array::get(fields, 2),\\n                Array::get(fields, 3),\\n                Array::get(fields, 4)\\n              )\\n            )\\n          } else {\\n            if Array::length(fields) != 5 {\\n              throw(\\\"invalid persistent manifest header cache header row\\\")\\n            }\\n            Array::push(\\n              rows,\\n              (\\n                Array::get(fields, 1),\\n                Array::get(fields, 2),\\n                Array::get(fields, 3),\\n                Array::get(fields, 4)\\n              )\\n            )\\n          }\\n        } else {\\n          throw(String::concat(\\\"invalid persistent manifest header cache row: \\\", line))\\n        }\\n      }\\n      line_start = i + 1\\n    }\\n    i = i + 1\\n  }\\n  (version, manifest, rows)\\n}\\n\\nfn matches_cached_file_spec(path: String, stat_token_text: String, source_fingerprint: String) -> Bool with { Error, Fs } {\\n  if !(Fs::exists(path)) {\\n    false\\n  } else {\\n    let has_stat_token = String::length(stat_token_text) > 0\\n    if has_stat_token {\\n      if __to_string(Fs::stat_token(path)) == stat_token_text {\\n        true\\n      } else if String::length(source_fingerprint) > 0 {\\n        compact_string_fingerprint(Fs::read_file(path)) == source_fingerprint\\n      } else {\\n        false\\n      }\\n    } else if String::length(source_fingerprint) > 0 {\\n      compact_string_fingerprint(Fs::read_file(path)) == source_fingerprint\\n    } else {\\n      false\\n    }\\n  }\\n}\\n\\nfn load_persistent_manifest_header_cache_if_valid(entry_path: String, manifest_path: String, manifest_path_index: Map[String, Bool]) -> Option[Array[(String, String, String, String)]] with { Error, Fs } {\\n  let cache_path = persistent_manifest_header_cache_path(entry_path)\\n  if !(Fs::exists(cache_path)) {\\n    None\\n  } else {\\n    let (_, manifest, rows) = parse_persistent_manifest_header_cache(\\n      normalize_persistent_cache_text(Fs::read_file(cache_path))\\n    )\\n    let manifest_ok = match manifest {\\n      Some((cached_path, stat_token_text, source_fingerprint)) =>\\n        cached_path == manifest_path &&\\n          matches_cached_file_spec(manifest_path, stat_token_text, source_fingerprint),\\n      None => false\\n    }\\n    if !manifest_ok {\\n      None\\n    } else {\\n      let mut valid = true\\n      let mut i = 0\\n      while i < Array::length(rows) {\\n        if valid {\\n          let (path, stat_token_text, source_fingerprint, _) = Array::get(rows, i)\\n          if !(Map::has_key(manifest_path_index, path)) {\\n            valid = false\\n          } else if !(matches_cached_file_spec(path, stat_token_text, source_fingerprint)) {\\n            valid = false\\n          }\\n        }\\n        i = i + 1\\n      }\\n      if valid {\\n        Some(rows)\\n      } else {\\n        None\\n      }\\n    }\\n  }\\n}\\n\\nfn build_persistent_manifest_header_cache_text(manifest_path: String, rows: Array[(String, String, String, String)]) -> String with { Error, Fs } {\\n  let mut out = \\\"version\\\\t2\\\\n\\\"\\n  out = String::concat(\\n    out,\\n    String::concat(\\n      \\\"manifest\\\\t\\\",\\n      String::concat(\\n        manifest_path,\\n        String::concat(\\n          \\\"\\\\t\\\",\\n          String::concat(\\n            __to_string(Fs::stat_token(manifest_path)),\\n            String::concat(\\\"\\\\t\\\", String::concat(compact_string_fingerprint(Fs::read_file(manifest_path)), \\\"\\\\n\\\"))\\n          )\\n        )\\n      )\\n    )\\n  )\\n  let mut i = 0\\n  while i < Array::length(rows) {\\n    let (path, stat_token_text, source_fingerprint, deps_text) = Array::get(rows, i)\\n    out = String::concat(\\n      out,\\n      String::concat(\\n        \\\"header\\\\t\\\",\\n        String::concat(\\n          path,\\n          String::concat(\\n            \\\"\\\\t\\\",\\n            String::concat(\\n              stat_token_text,\\n              String::concat(\\n                \\\"\\\\t\\\",\\n                String::concat(\\n                  source_fingerprint,\\n                  String::concat(\\\"\\\\t\\\", String::concat(deps_text, \\\"\\\\n\\\"))\\n                )\\n              )\\n            )\\n          )\\n        )\\n      )\\n    )\\n    i = i + 1\\n  }\\n  out\\n}\\n\\nfn store_persistent_manifest_header_cache(entry_path: String, manifest_path: String, rows: Array[(String, String, String, String)]) -> Unit with { Error, Fs } {\\n  Fs::write_file(\\n    persistent_manifest_header_cache_path(entry_path),\\n    build_persistent_manifest_header_cache_text(manifest_path, rows)\\n  )\\n}\\n\\nfn manifest_header_deps_lookup(rows: Array[(String, String, String, String)], path: String) -> Option[Array[String]] {\\n  let mut i = 0\\n  let mut found = None\\n  while i < Array::length(rows) {\\n    let (row_path, _, _, deps_text) = Array::get(rows, i)\\n    if row_path == path {\\n      found = Some(split_header_values(deps_text))\\n      i = Array::length(rows)\\n    } else {\\n      i = i + 1\\n    }\\n  }\\n  found\\n}\\n\\n// #533: schedule-time dedup via a mutable `path_set`. The previous\\n// `Map[String, Bool]` scheduled-set copied the whole map on every\\n// `Map::set` (O(N) per insert → O(N²) total) and linearly scanned it per\\n// `Map::has_key`; the pop-time `contains_path(visited, current)` guard\\n// was another O(edges × modules) scan that could never fire, because\\n// every worklist push is gated on the scheduled set, making worklist\\n// entries unique by construction. `visited` stays an insertion-ordered\\n// array — it is the returned needed-paths list. (Same pattern in the two\\n// sibling collectors below.)\\nfn collect_needed_paths_from_manifest_headers(path: String, manifest_path_index: Map[String, Bool], rows: Array[(String, String, String, String)]) -> Array[String] with { Error, Fs } {\\n  let visited = Array::slice([\\\"\\\"], 0, 0)\\n  let worklist = Array::slice([\\\"\\\"], 0, 0)\\n  let scheduled = path_set_new()\\n  Array::push(worklist, path)\\n  path_set_add(scheduled, path)\\n  let mut work_len = 1\\n  let mut work_i = 0\\n  loop {\\n    if work_i >= work_len {\\n      break\\n    }\\n    let current = Array::get(worklist, work_i)\\n    Array::push(visited, current)\\n    let deps = match manifest_header_deps_lookup(rows, current) {\\n      Some(found) => found,\\n      None => {\\n        let source = Fs::read_file(current)\\n        if Map::has_key(manifest_path_index, current) {\\n          collect_manifest_header_deps_from_source_with_context(\\n            current,\\n            source,\\n            manifest_path_index\\n          )\\n        } else {\\n          load_or_parse_module_header_deps_with_context(current, source)\\n        }\\n      }\\n    }\\n    let mut dep_i = 0\\n    while dep_i < Array::length(deps) {\\n      let dep_path = Array::get(deps, dep_i)\\n      if should_schedule_manifest_dep(dep_path, manifest_path_index) &&\\n        !(path_set_contains(scheduled, dep_path)) {\\n        Array::push(worklist, dep_path)\\n        path_set_add(scheduled, dep_path)\\n        work_len = work_len + 1\\n      }\\n      dep_i = dep_i + 1\\n    }\\n    work_i = work_i + 1\\n  }\\n  visited\\n}\\n\\nfn collect_needed_paths_and_manifest_headers(path: String, manifest_path_index: Map[String, Bool]) -> (Array[(String, String, String, String)], Array[String]) with { Error, Fs } {\\n  let rows = empty_manifest_header_cache_rows()\\n  let visited = Array::slice([\\\"\\\"], 0, 0)\\n  let worklist = Array::slice([\\\"\\\"], 0, 0)\\n  let scheduled = path_set_new()\\n  Array::push(worklist, path)\\n  path_set_add(scheduled, path)\\n  let mut work_len = 1\\n  let mut work_i = 0\\n  loop {\\n    if work_i >= work_len {\\n      break\\n    }\\n    let current = Array::get(worklist, work_i)\\n    Array::push(visited, current)\\n    let source = Fs::read_file(current)\\n    let deps = match manifest_header_deps_lookup(rows, current) {\\n      Some(found) => found,\\n      None => {\\n        let parsed_deps = if Map::has_key(manifest_path_index, current) {\\n          collect_manifest_header_deps_from_source_with_context(\\n            current,\\n            source,\\n            manifest_path_index\\n          )\\n        } else {\\n          load_or_parse_module_header_deps_with_context(current, source)\\n        }\\n        Array::push(\\n          rows,\\n          (\\n            current,\\n            __to_string(Fs::stat_token(current)),\\n            compact_string_fingerprint(source),\\n            join_header_values(parsed_deps)\\n          )\\n        )\\n        parsed_deps\\n      }\\n    }\\n    let mut dep_i = 0\\n    while dep_i < Array::length(deps) {\\n      let dep_path = Array::get(deps, dep_i)\\n      if should_schedule_manifest_dep(dep_path, manifest_path_index) &&\\n        !(path_set_contains(scheduled, dep_path)) {\\n        Array::push(worklist, dep_path)\\n        path_set_add(scheduled, dep_path)\\n        work_len = work_len + 1\\n      }\\n      dep_i = dep_i + 1\\n    }\\n    work_i = work_i + 1\\n  }\\n  (rows, visited)\\n}\\n\\nfn collect_needed_paths_from_manifest_scan(path: String, manifest_path_index: Map[String, Bool]) -> Array[String] with { Error, Fs } {\\n  let visited = Array::slice([\\\"\\\"], 0, 0)\\n  let worklist = Array::slice([\\\"\\\"], 0, 0)\\n  let scheduled = path_set_new()\\n  Array::push(worklist, path)\\n  path_set_add(scheduled, path)\\n  let mut work_len = 1\\n  let mut work_i = 0\\n  loop {\\n    if work_i >= work_len {\\n      break\\n    }\\n    let current = Array::get(worklist, work_i)\\n    Array::push(visited, current)\\n    let source = Fs::read_file(current)\\n    let deps = if Map::has_key(manifest_path_index, current) {\\n      collect_manifest_header_deps_from_source_with_context(\\n        current,\\n        source,\\n        manifest_path_index\\n      )\\n    } else {\\n      load_or_parse_module_header_deps_with_context(current, source)\\n    }\\n    let mut dep_i = 0\\n    while dep_i < Array::length(deps) {\\n      let dep_path = Array::get(deps, dep_i)\\n      if should_schedule_manifest_dep(dep_path, manifest_path_index) &&\\n        !(path_set_contains(scheduled, dep_path)) {\\n        Array::push(worklist, dep_path)\\n        path_set_add(scheduled, dep_path)\\n        work_len = work_len + 1\\n      }\\n      dep_i = dep_i + 1\\n    }\\n    work_i = work_i + 1\\n  }\\n  visited\\n}\\n\\nfn load_or_collect_manifest_header_rows(entry_path: String, manifest_path: String, manifest_path_index: Map[String, Bool]) -> Array[(String, String, String, String)] with { Error, Fs } {\\n  match load_persistent_manifest_header_cache_if_valid(\\n    entry_path,\\n    manifest_path,\\n    manifest_path_index\\n  ) {\\n    Some(cached_rows) => cached_rows,\\n    None => {\\n      let (built_rows, _) = collect_needed_paths_and_manifest_headers(\\n        entry_path,\\n        manifest_path_index\\n      )\\n      store_persistent_manifest_header_cache(entry_path, manifest_path, built_rows)\\n      built_rows\\n    }\\n  }\\n}\\n\\nexport fn probe_manifest_header_rows_count(entry_path: String) -> Int with { Error, Fs } {\\n  match try_load_manifest_rows(entry_path) {\\n    Some((base_dir, rows)) => {\\n      let manifest_path = join_path(base_dir, \\\"compiler_sources_manifest.tsv\\\")\\n      let manifest_path_index = build_manifest_path_index_from_rows(base_dir, rows)\\n      let header_rows = load_or_collect_manifest_header_rows(\\n        entry_path,\\n        manifest_path,\\n        manifest_path_index\\n      )\\n      Array::length(header_rows)\\n    },\\n    None => throw(\\\"manifest rows unavailable\\\")\\n  }\\n}\\n\\nexport fn probe_manifest_header_rows_uncached_count(entry_path: String) -> Int with { Error, Fs } {\\n  match try_load_manifest_rows(entry_path) {\\n    Some((base_dir, rows)) => {\\n      let manifest_path_index = build_manifest_path_index_from_rows(base_dir, rows)\\n      let (header_rows, _) = collect_needed_paths_and_manifest_headers(\\n        entry_path,\\n        manifest_path_index\\n      )\\n      Array::length(header_rows)\\n    },\\n    None => throw(\\\"manifest rows unavailable\\\")\\n  }\\n}\\n\\nexport fn probe_manifest_needed_paths_count(entry_path: String) -> Int with { Error, Fs } {\\n  match try_load_manifest_rows(entry_path) {\\n    Some((base_dir, rows)) => {\\n      let manifest_path = join_path(base_dir, \\\"compiler_sources_manifest.tsv\\\")\\n      let manifest_path_index = build_manifest_path_index_from_rows(base_dir, rows)\\n      let header_rows = load_or_collect_manifest_header_rows(\\n        entry_path,\\n        manifest_path,\\n        manifest_path_index\\n      )\\n      let needed_paths = collect_needed_paths_from_manifest_headers(\\n        entry_path,\\n        manifest_path_index,\\n        header_rows\\n      )\\n      Array::length(needed_paths)\\n    },\\n    None => throw(\\\"manifest rows unavailable\\\")\\n  }\\n}\\n\\nexport fn probe_manifest_scan_paths_count(entry_path: String) -> Int with { Error, Fs } {\\n  match try_load_manifest_rows(entry_path) {\\n    Some((base_dir, rows)) => {\\n      let manifest_path_index = build_manifest_path_index_from_rows(base_dir, rows)\\n      let needed_paths = collect_needed_paths_from_manifest_scan(\\n        entry_path,\\n        manifest_path_index\\n      )\\n      Array::length(needed_paths)\\n    },\\n    None => throw(\\\"manifest rows unavailable\\\")\\n  }\\n}\\n\\n//# Source collection\\n\\nexport fn try_collect_manifest_sources_fs(entry_path: String) -> Option[(String, Array[(String, String)])] with { Error, Fs } {\\n  match try_load_manifest_rows(entry_path) {\\n    Some((base_dir, rows)) => {\\n      let manifest_path = join_path(base_dir, \\\"compiler_sources_manifest.tsv\\\")\\n      let manifest_path_index = build_manifest_path_index_from_rows(base_dir, rows)\\n      let header_rows = load_or_collect_manifest_header_rows(\\n        entry_path,\\n        manifest_path,\\n        manifest_path_index\\n      )\\n      let needed_paths = collect_needed_paths_from_manifest_headers(\\n        entry_path,\\n        manifest_path_index,\\n        header_rows\\n      )\\n      let needed_path_index = build_manifest_path_index(needed_paths)\\n      let sources = load_manifest_sources_by_path_index(base_dir, rows, needed_path_index)\\n      Some((manifest_path, sources))\\n    },\\n    None => None\\n  }\\n}\\n\\nexport fn try_collect_manifest_source_groups_fs(entry_path: String) -> Option[(String, Array[(String, Array[(String, String)])])] with { Error, Fs } {\\n  match try_load_manifest_rows(entry_path) {\\n    Some((base_dir, rows)) => {\\n      let manifest_path = join_path(base_dir, \\\"compiler_sources_manifest.tsv\\\")\\n      let manifest_path_index = build_manifest_path_index_from_rows(base_dir, rows)\\n      let header_rows = load_or_collect_manifest_header_rows(\\n        entry_path,\\n        manifest_path,\\n        manifest_path_index\\n      )\\n      let needed_paths = collect_needed_paths_from_manifest_headers(\\n        entry_path,\\n        manifest_path_index,\\n        header_rows\\n      )\\n      let needed_path_index = build_manifest_path_index(needed_paths)\\n      let groups = load_manifest_source_groups_by_path_index(base_dir, rows, needed_path_index)\\n      Some((manifest_path, groups))\\n    },\\n    None => None\\n  }\\n}\\n\")\n}\n\nlet cli_adapter_source_142 = () -> (String, String) {\n  (\"lib/@vibe/cache/index.vpkg\",\n\"version 0.0.1\\n\\n// @vibe/cache — content-addressed persistent build/artifact cache path\\n// derivation + fingerprinting, and the module-header text codec (ADR-0070\\n// Phase 3, #897). No opaque/transparent types: every declared name is a\\n// pure fn over String/Bytes/Array/tuple primitives, never a struct/enum.\\n// `version` was `export let version = \\\"0.0.1\\\"` directly in the old\\n// index.vibe facade -- a real importable binding, not just contract\\n// metadata -- so it is preserved verbatim as an implementation-file value\\n// (cache.vibe) with a matching bodyless declaration here (Codex review\\n// precedent, PR #914).\\n\\nimport ./cache.vibe {}\\nimport ./header_codec.vibe {}\\n\\nlet version: String\\n\\n// --- cache\\nfn compact_string_fingerprint(source: String) -> String\\nfn stable_cache_path(version_tag: String, prefix: String, seed: String, suffix: String) -> String\\nfn persistent_artifact_cache_path(version_tag: String, kind: String, entry_name: String, fingerprint: String) -> String\\nfn store_persistent_artifact(version_tag: String, kind: String, entry_name: String, fingerprint: String, bytes: Bytes) -> Unit with { Error, Fs }\\nfn persistent_dep_list_cache_path(version_tag: String, path: String, source_fingerprint: String, resolution_seed: String) -> String\\nfn persistent_type_env_cache_path(version_tag: String, fingerprint: String) -> String\\nfn build_source_groups_fingerprint(groups: Array[(String, Array[(String, String)])]) -> String\\nfn normalize_persistent_cache_text(text: String) -> String\\nfn load_persistent_artifact(version_tag: String, kind: String, entry_name: String, fingerprint: String) -> Option[Bytes] with { Error, Fs }\\nfn persistent_source_list_cache_path(version_tag: String, entry_path: String, resolution_seed: String) -> String\\nfn persistent_source_group_cache_path(version_tag: String, entry_path: String, resolution_seed: String) -> String\\nfn persistent_module_header_cache_path(version_tag: String, path: String, source_fingerprint: String, resolution_seed: String) -> String\\nfn persistent_manifest_header_cache_path(version_tag: String, entry_path: String) -> String\\nfn persistent_leaf_fingerprint_cache_path(version_tag: String, path: String, source_fingerprint: String) -> String\\nfn build_source_groups_fingerprint_from_compact_fingerprints(groups: Array[(String, Array[(String, String)])]) -> String\\nfn build_fs_compile_wasi_artifact_fingerprint_from_group_fingerprint(source_groups_fingerprint: String, entry_name: String) -> String\\nfn build_fs_compile_wasi_artifact_fingerprint(source_groups: Array[(String, Array[(String, String)])], entry_name: String) -> String\\nfn build_file_compile_wasi_artifact_fingerprint_from_group_fingerprint(source_groups_fingerprint: String, entry_name: String, mode: String) -> String\\nfn build_file_compile_wasi_artifact_fingerprint(source_groups: Array[(String, Array[(String, String)])], entry_name: String, mode: String) -> String\\nfn build_fs_compile_module_artifact_fingerprint_from_group_fingerprint(source_groups_fingerprint: String) -> String\\nfn build_fs_compile_module_artifact_fingerprint(source_groups: Array[(String, Array[(String, String)])]) -> String\\nfn build_file_compile_module_artifact_fingerprint_from_group_fingerprint(source_groups_fingerprint: String) -> String\\nfn build_file_compile_module_artifact_fingerprint(source_groups: Array[(String, Array[(String, String)])]) -> String\\n\\n// --- header_codec\\nfn persistent_module_header_text(deps: Array[String], exports: Array[String], contract_fps: Array[(String, String)]) -> String\\nfn parse_persistent_module_header_text(raw: String) -> (Array[String], Array[String], Array[(String, String)], Bool) with { Error }\\n\")\n}\n\nlet cli_adapter_source_143 = () -> (String, String) {\n  (\"lib/@vibe/cache/cache.vibe\",\n\"//# Functions\\n\\n// #849/Codex review (PR #899): this package is a general, dependency-free\\n// disk-cache primitive (#766) that pure/component consumers can import for\\n// just `compact_string_fingerprint` etc. `collect_used_builtin_names` scans\\n// every top-level statement of the WHOLE linked program for builtin free\\n// names, not just ones reachable from the entry point (#799 perf note in\\n// linked_helpers.vibe) — so an `Env::get` reference ANYWHERE in this module,\\n// even in dead/unused code, would force a `vibe.env_get` host import onto\\n// every consumer of this package, breaking pure/component targets that don't\\n// provide it. VIBE_BUILD_CACHE_DIR override support therefore lives in the\\n// compiler-specific wrapper (lib/@vibe/compiler/cache/cache_underlying.vibe)\\n// instead, which rebases the path string this returns — that layer already\\n// requires host Fs/Error imports, so adding Env costs it nothing.\\nfn cache_root_prefix() -> String {\\n  \\\"_build/vibe_\\\"\\n}\\n\\n//# Values\\n\\n// #897 (ADR-0070 Phase 3): preserved from the old index.vibe facade, which\\n// defined `export let version = \\\"0.0.1\\\"` directly (a real importable\\n// binding, not just contract metadata) — Codex review precedent from PR\\n// #914.\\nexport let version: String = \\\"0.0.1\\\"\\n\\nexport fn compact_string_fingerprint(source: String) -> String {\\n  let mod1 = 2147483647\\n  let mod2 = 2147483629\\n  let step1 = 131\\n  let step2 = 65599\\n  let len = String::length(source)\\n  let mut h1 = 17\\n  let mut h2 = 29\\n  let mut i = 0\\n  while i < len {\\n    let c = String::char_code_at(source, i)\\n    h1 = (h1 * step1 + c + 1) % mod1\\n    h2 = (h2 * step2 + c + i + 1) % mod2\\n    i = i + 1\\n  }\\n  String::concat(__to_string(len), String::concat(\\\":\\\", String::concat(__to_string(h1), String::concat(\\\":\\\", __to_string(h2)))))\\n}\\n\\n// `version_tag` folds in whatever cache-invalidation identity the caller\\n// needs (cache format version, codegen fingerprint, ...) — this package has\\n// no opinion on what belongs in it, it only mixes it into the key.\\nexport fn stable_cache_path(version_tag: String, prefix: String, seed: String, suffix: String) -> String {\\n  let raw = compact_string_fingerprint(String::concat(\\\"persistent-cache-\\\", String::concat(version_tag, String::concat(\\\"|\\\", seed))))\\n  // O(N) build via StringBuilder; the previous `token = String::concat(token, ...)`\\n  // per char was O(N²) over the fingerprint length (issue #366).\\n  let token_sb = StringBuilder::new()\\n  let mut i = 0\\n  while i < String::length(raw) {\\n    let c = String::char_code_at(raw, i)\\n    let piece = if c == 58 {\\n      \\\"_\\\"\\n    } else {\\n      String::from_char_code(c)\\n    }\\n    StringBuilder::push(token_sb, piece)\\n    i = i + 1\\n  }\\n  let token = StringBuilder::freeze(token_sb)\\n  String::concat(cache_root_prefix(), String::concat(prefix, String::concat(\\\"_\\\", String::concat(token, suffix))))\\n}\\n\\nfn build_sources_fingerprint(sources: Array[(String, String)]) -> String {\\n  let mut acc = \\\"merged\\\"\\n  let mut i = 0\\n  while i < Array::length(sources) {\\n    let (_, source) = Array::get(sources, i)\\n    let next = String::concat(acc, String::concat(\\\"|\\\", compact_string_fingerprint(source)))\\n    acc = compact_string_fingerprint(next)\\n    i = i + 1\\n  }\\n  acc\\n}\\n\\nexport fn persistent_artifact_cache_path(version_tag: String, kind: String, entry_name: String, fingerprint: String) -> String {\\n  stable_cache_path(version_tag, \\\"selfhost_artifact\\\", String::concat(kind, String::concat(\\\"|\\\", String::concat(entry_name, String::concat(\\\"|\\\", fingerprint)))), \\\".bin\\\")\\n}\\n\\nexport fn store_persistent_artifact(version_tag: String, kind: String, entry_name: String, fingerprint: String, bytes: Bytes) -> Unit with { Error, Fs } {\\n  let path = persistent_artifact_cache_path(version_tag, kind, entry_name, fingerprint)\\n  Fs::write_bytes(path, bytes)\\n}\\n\\nexport fn persistent_dep_list_cache_path(version_tag: String, path: String, source_fingerprint: String, resolution_seed: String) -> String {\\n  stable_cache_path(version_tag, \\\"selfhost_dep_list\\\", String::concat(path, String::concat(\\\"|\\\", String::concat(source_fingerprint, resolution_seed))), \\\".tsv\\\")\\n}\\n\\nexport fn persistent_type_env_cache_path(version_tag: String, fingerprint: String) -> String {\\n  stable_cache_path(version_tag, \\\"selfhost_type_env_v2\\\", fingerprint, \\\".tsv\\\")\\n}\\n\\nexport fn build_source_groups_fingerprint(groups: Array[(String, Array[(String, String)])]) -> String {\\n  let mut acc = \\\"merged-groups\\\"\\n  let mut i = 0\\n  while i < Array::length(groups) {\\n    let (group_name, sources) = Array::get(groups, i)\\n    let fingerprint = build_sources_fingerprint(sources)\\n    let next = String::concat(acc, String::concat(\\\"|\\\", String::concat(group_name, String::concat(\\\"=\\\", fingerprint))))\\n    acc = compact_string_fingerprint(next)\\n    i = i + 1\\n  }\\n  acc\\n}\\n\\nexport fn normalize_persistent_cache_text(text: String) -> String {\\n  let len = String::length(text)\\n  let mut start = 0\\n  while start < len && String::char_code_at(text, start) == 0 {\\n    start = start + 1\\n  }\\n  if start == 0 {\\n    text\\n  } else {\\n    text[start: len]\\n  }\\n}\\n\\nexport fn load_persistent_artifact(version_tag: String, kind: String, entry_name: String, fingerprint: String) -> Option[Bytes] with { Error, Fs } {\\n  let path = persistent_artifact_cache_path(version_tag, kind, entry_name, fingerprint)\\n  if !(Fs::exists(path)) {\\n    None\\n  } else {\\n    Some(Fs::read_bytes(path))\\n  }\\n}\\n\\nexport fn persistent_source_list_cache_path(version_tag: String, entry_path: String, resolution_seed: String) -> String {\\n  stable_cache_path(version_tag, \\\"selfhost_source_list\\\", String::concat(entry_path, resolution_seed), \\\".tsv\\\")\\n}\\n\\nexport fn persistent_source_group_cache_path(version_tag: String, entry_path: String, resolution_seed: String) -> String {\\n  stable_cache_path(version_tag, \\\"selfhost_source_groups\\\", String::concat(entry_path, resolution_seed), \\\".tsv\\\")\\n}\\n\\nexport fn persistent_module_header_cache_path(version_tag: String, path: String, source_fingerprint: String, resolution_seed: String) -> String {\\n  stable_cache_path(version_tag, \\\"selfhost_module_header_v2\\\", String::concat(path, String::concat(\\\"|\\\", String::concat(source_fingerprint, resolution_seed))), \\\".tsv\\\")\\n}\\n\\nexport fn persistent_manifest_header_cache_path(version_tag: String, entry_path: String) -> String {\\n  stable_cache_path(version_tag, \\\"selfhost_manifest_headers\\\", entry_path, \\\".tsv\\\")\\n}\\n\\nexport fn persistent_leaf_fingerprint_cache_path(version_tag: String, path: String, source_fingerprint: String) -> String {\\n  stable_cache_path(version_tag, \\\"selfhost_leaf_fp_v2\\\", String::concat(path, String::concat(\\\"|\\\", source_fingerprint)), \\\".tsv\\\")\\n}\\n\\nfn build_sources_fingerprint_from_compact_fingerprints(source_fingerprints: Array[String]) -> String {\\n  let mut acc = \\\"merged\\\"\\n  let mut i = 0\\n  while i < Array::length(source_fingerprints) {\\n    let next = String::concat(acc, String::concat(\\\"|\\\", Array::get(source_fingerprints, i)))\\n    acc = compact_string_fingerprint(next)\\n    i = i + 1\\n  }\\n  acc\\n}\\n\\nexport fn build_source_groups_fingerprint_from_compact_fingerprints(groups: Array[(String, Array[(String, String)])]) -> String {\\n  let mut acc = \\\"merged-groups\\\"\\n  let mut i = 0\\n  while i < Array::length(groups) {\\n    let (group_name, specs) = Array::get(groups, i)\\n    let source_fingerprints = Array::slice([\\n      \\\"\\\"\\n    ], 0, 0)\\n    let mut j = 0\\n    while j < Array::length(specs) {\\n      let (_, source_fingerprint) = Array::get(specs, j)\\n      Array::push(source_fingerprints, source_fingerprint)\\n      j = j + 1\\n    }\\n    let fingerprint = build_sources_fingerprint_from_compact_fingerprints(source_fingerprints)\\n    let next = String::concat(acc, String::concat(\\\"|\\\", String::concat(group_name, String::concat(\\\"=\\\", fingerprint))))\\n    acc = compact_string_fingerprint(next)\\n    i = i + 1\\n  }\\n  acc\\n}\\n\\nexport fn build_fs_compile_wasi_artifact_fingerprint_from_group_fingerprint(source_groups_fingerprint: String, entry_name: String) -> String {\\n  compact_string_fingerprint(String::concat(\\\"fs-compile|\\\", String::concat(source_groups_fingerprint, String::concat(\\\"|\\\", entry_name))))\\n}\\n\\nexport fn build_fs_compile_wasi_artifact_fingerprint(source_groups: Array[(String, Array[(String, String)])], entry_name: String) -> String {\\n  build_fs_compile_wasi_artifact_fingerprint_from_group_fingerprint(build_source_groups_fingerprint(source_groups), entry_name)\\n}\\n\\nexport fn build_file_compile_wasi_artifact_fingerprint_from_group_fingerprint(source_groups_fingerprint: String, entry_name: String, mode: String) -> String {\\n  compact_string_fingerprint(String::concat(\\\"file-compile|\\\", String::concat(source_groups_fingerprint, String::concat(\\\"|\\\", String::concat(entry_name, String::concat(\\\"|\\\", mode))))))\\n}\\n\\nexport fn build_file_compile_wasi_artifact_fingerprint(source_groups: Array[(String, Array[(String, String)])], entry_name: String, mode: String) -> String {\\n  build_file_compile_wasi_artifact_fingerprint_from_group_fingerprint(build_source_groups_fingerprint(source_groups), entry_name, mode)\\n}\\n\\nexport fn build_fs_compile_module_artifact_fingerprint_from_group_fingerprint(source_groups_fingerprint: String) -> String {\\n  compact_string_fingerprint(String::concat(\\\"fs-compile-module|\\\", source_groups_fingerprint))\\n}\\n\\nexport fn build_fs_compile_module_artifact_fingerprint(source_groups: Array[(String, Array[(String, String)])]) -> String {\\n  build_fs_compile_module_artifact_fingerprint_from_group_fingerprint(build_source_groups_fingerprint(source_groups))\\n}\\n\\nexport fn build_file_compile_module_artifact_fingerprint_from_group_fingerprint(source_groups_fingerprint: String) -> String {\\n  compact_string_fingerprint(String::concat(\\\"file-compile-module|\\\", source_groups_fingerprint))\\n}\\n\\nexport fn build_file_compile_module_artifact_fingerprint(source_groups: Array[(String, Array[(String, String)])]) -> String {\\n  build_file_compile_module_artifact_fingerprint_from_group_fingerprint(build_source_groups_fingerprint(source_groups))\\n}\\n\")\n}\n\nlet cli_adapter_source_144 = () -> (String, String) {\n  (\"lib/@vibe/cache/header_codec.vibe\",\n\"//# Functions\\n\\nfn has_prefix(line: String, prefix: String) -> Bool {\\n  let prefix_len = String::length(prefix)\\n  if String::length(line) < prefix_len {\\n    false\\n  } else {\\n    let mut ok = true\\n    let mut i = 0\\n    while ok && i < prefix_len {\\n      ok = String::char_code_at(line, i) == String::char_code_at(prefix, i)\\n      i = i + 1\\n    }\\n    ok\\n  }\\n}\\n\\nfn strip_trailing_cr(line: String) -> String {\\n  let len = String::length(line)\\n  if len > 0 {\\n    if String::char_code_at(line, len - 1) == 13 {\\n      line[0: len - 1]\\n    } else {\\n      line\\n    }\\n  } else {\\n    line\\n  }\\n}\\n\\n// Returns the version seen so far (0 = no version row yet). Version 2\\n// (#943 review) adds `cdep\\\\t<path>\\\\t<fingerprint>` rows recording each\\n// contract-boundary dep's content fingerprint at header-build time, so the\\n// warm lane can detect a contract edited AFTER the importer was cached\\n// (importer-keyed cache alone cannot see a target-side change). Version 1\\n// entries still parse (no cdep rows, ver stays 1) — the warm gate treats\\n// them as stale exactly once and rebuilds them as v2.\\nfn parse_persistent_module_header_line(deps: Array[String], exports: Array[String], cdeps: Array[(String, String)], line: String, ver: Int) -> Int with { Error } {\\n  if String::length(line) == 0 {\\n    ver\\n  } else if has_prefix(line, \\\"version\\\\t\\\") {\\n    let value = line[8: String::length(line)]\\n    if value == \\\"1\\\" {\\n      1\\n    } else if value == \\\"2\\\" {\\n      2\\n    } else {\\n      throw(\\\"invalid persistent module header version\\\")\\n    }\\n  } else if has_prefix(line, \\\"dep\\\\t\\\") {\\n    let value = line[4: String::length(line)]\\n    if String::length(value) == 0 {\\n      throw(\\\"invalid persistent module header dep row\\\")\\n    } else {\\n      Array::push(deps, value)\\n      ver\\n    }\\n  } else if has_prefix(line, \\\"cdep\\\\t\\\") {\\n    let value = line[5: String::length(line)]\\n    let tab = String::index_of(value, \\\"\\\\t\\\")\\n    if tab <= 0 || tab >= String::length(value) - 1 {\\n      throw(\\\"invalid persistent module header cdep row\\\")\\n    } else {\\n      Array::push(cdeps, (value[0: tab], value[tab + 1: String::length(value)]))\\n      ver\\n    }\\n  } else if has_prefix(line, \\\"export\\\\t\\\") {\\n    let value = line[7: String::length(line)]\\n    if String::length(value) == 0 {\\n      throw(\\\"invalid persistent module header export row\\\")\\n    } else {\\n      Array::push(exports, value)\\n      ver\\n    }\\n  } else {\\n    throw(String::concat(\\\"invalid persistent module header row: \\\", line))\\n  }\\n}\\n\\n// `contract_fps`: (resolved contract path, content fingerprint) per\\n// contract-boundary dep, captured when the header was built (#943 review —\\n// see parse_persistent_module_header_line).\\nexport fn persistent_module_header_text(deps: Array[String], exports: Array[String], contract_fps: Array[(String, String)]) -> String {\\n  // O(N) via StringBuilder; previously `out = String::concat(out, ...)`\\n  // over both `deps` and `exports` was O((D+E)²).\\n  let buf = StringBuilder::new()\\n  StringBuilder::push(buf, \\\"version\\\\t2\\\\n\\\")\\n  let mut i = 0\\n  while i < Array::length(deps) {\\n    StringBuilder::push(buf, \\\"dep\\\\t\\\")\\n    StringBuilder::push(buf, Array::get(deps, i))\\n    StringBuilder::push(buf, \\\"\\\\n\\\")\\n    i = i + 1\\n  }\\n  let mut c = 0\\n  while c < Array::length(contract_fps) {\\n    let (cpath, cfp) = Array::get(contract_fps, c)\\n    StringBuilder::push(buf, \\\"cdep\\\\t\\\")\\n    StringBuilder::push(buf, cpath)\\n    StringBuilder::push(buf, \\\"\\\\t\\\")\\n    StringBuilder::push(buf, cfp)\\n    StringBuilder::push(buf, \\\"\\\\n\\\")\\n    c = c + 1\\n  }\\n  let mut j = 0\\n  while j < Array::length(exports) {\\n    StringBuilder::push(buf, \\\"export\\\\t\\\")\\n    StringBuilder::push(buf, Array::get(exports, j))\\n    StringBuilder::push(buf, \\\"\\\\n\\\")\\n    j = j + 1\\n  }\\n  StringBuilder::freeze(buf)\\n}\\n\\n// Returns (deps, exports, contract_fps, is_v2). A version-1 entry parses\\n// with empty contract_fps and is_v2 = false — the caller decides whether\\n// that means \\\"rebuild\\\" (the warm gate does; see #943 review).\\nexport fn parse_persistent_module_header_text(raw: String) -> (Array[String], Array[String], Array[(String, String)], Bool) with { Error } {\\n  let deps = Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n  let exports = Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n  let cdeps = Array::slice([\\n    (\\\"\\\", \\\"\\\")\\n  ], 0, 0)\\n  let mut ver = 0\\n  let len = String::length(raw)\\n  let mut line_start = 0\\n  let mut i = 0\\n  while i < len {\\n    if String::char_code_at(raw, i) == 10 {\\n      let line = strip_trailing_cr(raw[line_start: i])\\n      ver = parse_persistent_module_header_line(deps, exports, cdeps, line, ver)\\n      line_start = i + 1\\n    }\\n    i = i + 1\\n  }\\n  let line = strip_trailing_cr(raw[line_start: len])\\n  ver = parse_persistent_module_header_line(deps, exports, cdeps, line, ver)\\n  if ver == 0 {\\n    throw(\\\"missing persistent module header version\\\")\\n  } else {\\n    (deps, exports, cdeps, ver == 2)\\n  }\\n}\\n\")\n}\n\nlet cli_adapter_source_145 = () -> (String, String) {\n  (\"lib/@vibe/core/index.vpkg\",\n\"version 0.1.0\\n\\n// @vibe/core — vibe standard core library (ADR-0063 contract package).\\n// Modeled on moonbitlang/core's per-domain organization. The top level of\\n// this contract IS the public API: transparent type definitions + fn\\n// declarations, implemented by the sibling .vibe files. Consumed in-repo\\n// via a bare directory import (`import ../lib/@vibe/core { ... }`) and\\n// externally via the content-addressed store (`require @vibe/core ...` +\\n// `import @vibe/core { ... }`; install with scripts/vibe_core_install.sh).\\n//\\n// v1 contents: sha1, leb128, list, set, hex, maps. map.vibe's `[K: Hash]`\\n// generic-key family is now declared below (#897/#912): trait-bounded\\n// bodyless fn declarations parse and fingerprint through the same\\n// parse_fn_signature/fn_sig_text path as unbounded ones (verified\\n// empirically — the \\\".vibei grammar cannot express a trait\\\" note that\\n// used to live here was stale). `Hash` itself is declared `opaque type\\n// Hash` — a trait has no SStruct/SEnum implementation for conformance to\\n// find, but maps.vibe's `export ./r#map.vibe { ..., trait Hash }`\\n// re-export discharges the declaration at face value (#847's re-export\\n// trust), and the trait rides the merged program globally, so consumers\\n// can `import @vibe/core { Hash }` and `impl Hash for TheirType`.\\n//\\n// map.vibe's `length`/`is_empty` (Map[String, V]) and math_extra.vibe's\\n// `sum` (Array[Int]) stay UNDECLARED: each collides with a same-named\\n// declaration for a different type below (List's length/sum, StringSet's\\n// is_empty), and the facade can only allocate a declared name to one\\n// definer. The exported-but-undeclared conformance sweep matches by NAME,\\n// so these exports are legal — they remain reachable only from files\\n// inside this package (map_test.vibe / math_prop_test.vibe import the\\n// impl files directly), exactly the pre-.vpkg status quo.\\n//\\n// v2 (#766): base64, math (+ math_double), diff, uuid folded in from\\n// @vibex (pure algorithms, zero prior consumers).\\n//\\n// v3 (#841): bigint (arbitrary-precision signed integers) and rational\\n// (arbitrary-precision rationals, built directly on bigint — both now\\n// live in this same package so rational's `import ./bigint.vibe` needs no\\n// cross-package directory import). Both promoted straight from @vibex with\\n// no @vibex stop (moved in during #841's data-structure sweep).\\n\\nimport ./sha1.vibe {}\\nimport ./leb128.vibe {}\\nimport ./list.vibe {}\\nimport ./set.vibe {}\\nimport ./hex.vibe {}\\nimport ./map_get.vibe {}\\nimport ./map.vibe {}\\nimport ./maps.vibe {}\\nimport ./math_extra.vibe {}\\nimport ./base64.vibe {}\\nimport ./diff.vibe {}\\nimport ./uuid.vibe {}\\nimport ./math.vibe {}\\nimport ./math_double.vibe {}\\nimport ./bigint.vibe {}\\nimport ./rational.vibe {}\\n\\ntype List[T]\\ntype StringSet\\ntype BigInt\\ntype Rational\\n\\n// --- map (the [K: Hash] generic-key family; see header comment)\\nopaque type Hash\\n\\nfn map_key_to_string[K: Hash](key: K) -> String\\nfn get_by[K: Hash, V](m: Map[String, V], key: K) -> Option[V]\\nfn has_by[K: Hash, V](m: Map[String, V], key: K) -> Bool\\nfn get_or_by[K: Hash, V](m: Map[String, V], key: K, default: V) -> V\\nfn get_or_else_by[K: Hash, V](m: Map[String, V], key: K, default: () -> V) -> V\\n\\n// --- sha1\\nfn sha1(msg: String) -> String\\n\\n// --- hex\\nfn hex_encode(s: String) -> String\\nfn hex_decode(hex: String) -> String with { Error }\\n\\n// --- leb128\\nfn read_sleb128(buf: Bytes, offset: Int) -> (Int, Int)\\nfn read_uleb128(buf: Bytes, offset: Int) -> (Int, Int)\\nfn sleb128_size(n: Int) -> Int\\nfn uleb128_size(n: Int) -> Int\\nfn write_sleb128(buf: Bytes, n: Int) -> Unit\\nfn write_uleb128(buf: Bytes, n: Int) -> Unit\\nfn encode_sleb128(n: Int) -> Bytes\\nfn encode_uleb128(n: Int) -> Bytes\\n\\n// --- list\\nfn list_nth[T](xs: List[T], n: Int) -> Option[T]\\nfn nth[T](xs: List[T], n: Int) -> Option[T]\\nfn list_of3[T](a: T, b: T, c: T) -> List[T]\\nfn of3[T](a: T, b: T, c: T) -> List[T]\\nfn list_of5[T](a: T, b: T, c: T, d: T, e: T) -> List[T]\\nfn of5[T](a: T, b: T, c: T, d: T, e: T) -> List[T]\\nfn list_cons[T](x: T, xs: List[T]) -> List[T]\\nfn list_drop[T](n: Int, xs: List[T]) -> List[T]\\nfn drop[T](xs: List[T], n: Int) -> List[T]\\nfn list_fold[A, B](f: (B, A) -> B, init: B, xs: List[A]) -> B\\nfn list_sum(xs: List[Int]) -> Int\\nfn sum(xs: List[Int]) -> Int\\nfn list_head[T](xs: List[T]) -> Option[T]\\nfn head[T](xs: List[T]) -> Option[T]\\nfn list_iter[T, R](f: (T) -> R, xs: List[T]) -> Int\\nfn iter[T, R](xs: List[T], f: (T) -> R) -> Int\\nfn list_tail[T](xs: List[T]) -> List[T]\\nfn tail[T](xs: List[T]) -> List[T]\\nfn list_empty[T]() -> List[T]\\nfn list_length[T](xs: List[T]) -> Int\\nfn length[T](xs: List[T]) -> Int\\nfn iter_length[T](xs: List[T]) -> Int\\nfn list_reverse[T](xs: List[T]) -> List[T]\\nfn reverse[T](xs: List[T]) -> List[T]\\nfn list_map[A, B](f: (A) -> B, xs: List[A]) -> List[B]\\nfn list_zip[A, B](xs: List[A], ys: List[B]) -> List[(A, B)]\\nfn zip[A, B](xs: List[A], ys: List[B]) -> List[(A, B)]\\nfn list_take[T](n: Int, xs: List[T]) -> List[T]\\nfn take[T](xs: List[T], n: Int) -> List[T]\\nfn list_append[T](xs: List[T], ys: List[T]) -> List[T]\\nfn append[T](xs: List[T], ys: List[T]) -> List[T]\\nfn list_filter[T](pred: (T) -> Bool, xs: List[T]) -> List[T]\\nfn filter[T](xs: List[T], pred: (T) -> Bool) -> List[T]\\nfn list_flatmap[A, B](f: (A) -> List[B], xs: List[A]) -> List[B]\\nfn flatmap[A, B](xs: List[A], f: (A) -> List[B]) -> List[B]\\nfn list_is_empty[T](xs: List[T]) -> Bool\\nfn list_iter_get[T](xs: List[T], index: Int) -> T\\nfn iter_get[T](xs: List[T], index: Int) -> T\\nfn list_singleton[T](x: T) -> List[T]\\nfn singleton[T](x: T) -> List[T]\\nfn list_contains_by[T](eq: (T, T) -> Bool, value: T, xs: List[T]) -> Bool\\nfn List::nth[T](xs: List[T], n: Int) -> Option[T]\\nfn List::sum(xs: List[Int]) -> Int\\nfn List::zip[A, B](xs: List[A], ys: List[B]) -> List[(A, B)]\\nfn List::drop[T](xs: List[T], n: Int) -> List[T]\\nfn List::head[T](xs: List[T]) -> Option[T]\\nfn List::iter[T, R](xs: List[T], f: (T) -> R) -> Int\\nfn List::tail[T](xs: List[T]) -> List[T]\\nfn List::take[T](xs: List[T], n: Int) -> List[T]\\nfn List::append[T](xs: List[T], ys: List[T]) -> List[T]\\nfn List::filter[T](xs: List[T], pred: (T) -> Bool) -> List[T]\\nfn List::length[T](xs: List[T]) -> Int\\nfn List::flatmap[A, B](xs: List[A], f: (A) -> List[B]) -> List[B]\\nfn List::reverse[T](xs: List[T]) -> List[T]\\nfn List::is_empty[T](xs: List[T]) -> Bool\\nfn List::iter_get[T](xs: List[T], index: Int) -> T\\nfn List::contains_by[T](xs: List[T], eq: (T, T) -> Bool, value: T) -> Bool\\nfn List::iter_length[T](xs: List[T]) -> Int\\n\\n// --- set\\nfn size(s: StringSet) -> Int\\nfn empty() -> StringSet\\nfn remove(s: StringSet, value: String) -> StringSet\\nfn contains(s: StringSet, value: String) -> Bool\\nfn add(s: StringSet, value: String) -> StringSet\\nfn is_empty(s: StringSet) -> Bool\\nfn set_union(a: StringSet, b: StringSet) -> StringSet\\nfn from_array(values: Array[String]) -> StringSet\\nfn set_intersect(a: StringSet, b: StringSet) -> StringSet\\nfn set_difference(a: StringSet, b: StringSet) -> StringSet\\nfn set_value_to_string[T](value: T) -> String\\nfn add_by[T](s: StringSet, value: T) -> StringSet\\nfn remove_by[T](s: StringSet, value: T) -> StringSet\\nfn contains_by[T](s: StringSet, value: T) -> Bool\\nfn from_array_by[T](values: Array[T]) -> StringSet\\n\\n// --- maps (plain Map[String, V] helpers; the `[K: Hash]` generic-key\\n// variants and the Hash trait itself are not part of this contract yet)\\nfn get[V](m: Map[String, V], key: String) -> Option[V]\\nfn get_or[V](m: Map[String, V], key: String, default: V) -> V\\nfn get_or_else[V](m: Map[String, V], key: String, default: () -> V) -> V\\nfn has_key[V](m: Map[String, V], key: String) -> Bool\\nfn keys[V](m: Map[String, V]) -> Array[String]\\nfn values[V](m: Map[String, V]) -> Array[V]\\n\\n// --- base64\\nfn decode(input: String) -> String\\nfn encode(input: String) -> String\\nfn encode_url_safe(input: String) -> String\\n\\n// --- diff\\ntype DiffOp\\nfn diff_lines(old_text: String, new_text: String) -> Array[DiffOp]\\nfn format_unified(ops: Array[DiffOp]) -> String\\nfn has_changes(ops: Array[DiffOp]) -> Bool\\nfn count_additions(ops: Array[DiffOp]) -> Int\\nfn count_deletions(ops: Array[DiffOp]) -> Int\\n\\n// --- uuid\\nfn v4(seed_state: Int) -> (String, Int)\\nfn is_valid_v4(s: String) -> Bool\\n\\n// --- math (Int)\\nfn abs(n: Int) -> Int\\nfn gcd(a: Int, b: Int) -> Int\\nfn lcm(a: Int, b: Int) -> Int\\nfn max(a: Int, b: Int) -> Int\\nfn min(a: Int, b: Int) -> Int\\nfn pow(base: Int, exp: Int) -> Int\\nfn comb(n: Int, k: Int) -> Int\\nfn log2(n: Int) -> Int\\nfn perm(n: Int, k: Int) -> Int\\nfn sign(n: Int) -> Int\\nfn clamp(n: Int, lo: Int, hi: Int) -> Int\\nfn divmod(a: Int, d: Int) -> (Int, Int)\\nfn is_odd(n: Int) -> Bool\\nfn is_even(n: Int) -> Bool\\nfn product(arr: Array[Int]) -> Int\\nfn sqrt_int(n: Int) -> Int\\nfn max_array(arr: Array[Int]) -> Int\\nfn min_array(arr: Array[Int]) -> Int\\nfn is_power_of_two(n: Int) -> Bool\\n\\n// --- math (Double)\\nfn ln(x: Double) -> Double\\nfn sqrt(x: Double) -> Double\\nfn hypot(x: Double, y: Double) -> Double\\nfn log10(x: Double) -> Double\\nfn degrees(rad: Double) -> Double\\nfn radians(deg: Double) -> Double\\nfn atan(x: Double) -> Double\\nfn asin(x: Double) -> Double\\nfn acos(x: Double) -> Double\\nfn atan2(y: Double, x: Double) -> Double\\nfn exp_double(x: Double) -> Double\\nfn pow_double(base: Double, exponent: Double) -> Double\\nfn log2_double(x: Double) -> Double\\nfn sin(x: Double) -> Double\\nfn cos(x: Double) -> Double\\nfn tan(x: Double) -> Double\\nlet pi: Double\\nlet tau: Double\\nlet e_const: Double\\n\\n// --- bigint (arbitrary-precision signed integers)\\nfn BigInt::from_int(n: Int) -> BigInt\\nfn BigInt::to_int(a: BigInt) -> Option[Int]\\nfn BigInt::parse(s: String) -> Option[BigInt]\\nfn BigInt::to_string(a: BigInt) -> String\\nfn BigInt::add(a: BigInt, b: BigInt) -> BigInt\\nfn BigInt::sub(a: BigInt, b: BigInt) -> BigInt\\nfn BigInt::mul(a: BigInt, b: BigInt) -> BigInt\\nfn BigInt::divmod(a: BigInt, b: BigInt) -> Option[(BigInt, BigInt)]\\nfn BigInt::div(a: BigInt, b: BigInt) -> Option[BigInt]\\nfn BigInt::mod(a: BigInt, b: BigInt) -> Option[BigInt]\\nfn BigInt::cmp(a: BigInt, b: BigInt) -> Int\\nfn BigInt::equals(a: BigInt, b: BigInt) -> Bool\\nfn BigInt::neg(a: BigInt) -> BigInt\\nfn BigInt::abs(a: BigInt) -> BigInt\\nfn BigInt::is_zero(a: BigInt) -> Bool\\nfn BigInt::pow(base_v: BigInt, exp: Int) -> BigInt\\n\\n// --- rational (arbitrary-precision rationals, built on bigint)\\nfn Rational::from_int(n: Int) -> Rational\\nfn Rational::from_ints(num: Int, den: Int) -> Option[Rational]\\nfn Rational::from_bigints(num: BigInt, den: BigInt) -> Option[Rational]\\nfn Rational::parse(s: String) -> Option[Rational]\\nfn Rational::to_string(a: Rational) -> String\\nfn Rational::add(a: Rational, b: Rational) -> Rational\\nfn Rational::sub(a: Rational, b: Rational) -> Rational\\nfn Rational::mul(a: Rational, b: Rational) -> Rational\\nfn Rational::div(a: Rational, b: Rational) -> Option[Rational]\\nfn Rational::cmp(a: Rational, b: Rational) -> Int\\nfn Rational::equals(a: Rational, b: Rational) -> Bool\\nfn Rational::neg(a: Rational) -> Rational\\nfn Rational::abs(a: Rational) -> Rational\\nfn Rational::is_zero(a: Rational) -> Bool\\n\")\n}\n\nlet cli_adapter_source_146 = () -> (String, String) {\n  (\"lib/@vibe/core/sha1.vibe\",\n\"//# @vibe/core/sha1 — SHA1 digest (hex). CANONICAL copy; the compiler\\n//# consumes it through the @vibe/core contract import (#741 — the old\\n//# vendored twin at lib/@vibe/compiler/cache/sha1.vibe and gate 6e are retired).\\n\\n//# Functions\\n\\nlet k0: Int = 1518500249\\n\\nlet k1: Int = 1859775393\\n\\nlet k2: Int = ((36635 << 16) | 48348)\\n\\nlet k3: Int = ((51810 << 16) | 49622)\\n\\nfn ushr(x: Int, n: Int) -> Int {\\n  if n == 0 {\\n    x\\n  }\\n  else if n >= 32 {\\n    0\\n  }\\n  else {\\n    (x>>n)&((1<<(32 - n)) - 1)\\n  }\\n}\\n\\nlet mask32: Int = ((65535 << 16) | 65535)\\n\\nfn rotl(x: Int, n: Int) -> Int {\\n  ((x<<n)|ushr(x, 32 - n))&mask32\\n}\\n\\nfn add32(a: Int, b: Int) -> Int {\\n  (a + b)&mask32\\n}\\n\\nlet h0_init: Int = 1732584193\\n\\nlet h1_init: Int = ((61389 << 16) | 43913)\\n\\nlet h2_init: Int = ((39098 << 16) | 56574)\\n\\nlet h3_init: Int = 271733878\\n\\nlet h4_init: Int = ((50130 << 16) | 57840)\\n\\nlet hex_table: String = \\\"0123456789abcdef\\\"\\n\\nfn read_word(s: String, idx: Int) -> Int {\\n  let offset = idx * 4\\n  let b0 = s|>String::char_code_at(offset)\\n  let b1 = s|>String::char_code_at(offset + 1)\\n  let b2 = s|>String::char_code_at(offset + 2)\\n  let b3 = s|>String::char_code_at(offset + 3)\\n  ((b0<<24)|(b1<<16)|(b2<<8)|b3)&mask32\\n}\\n\\n/// Read a 32-bit big-endian word from a `Bytes` buffer. Used by the\\n/// `build_schedule` / `process_rounds` path that stores the SHA-1\\n/// schedule in a `Bytes` (1 byte per cell, no truncation) instead of\\n/// a `String` (which forced `acc|>String::concat(word_to_bytes(w))`\\n/// on every iteration — O(N²) bytes copied per block on wasm-gc, see\\n/// `docs/report/profile-wasm-gc-vs-linear-2026-05-26.md`).\\nfn read_word_bytes(b: Bytes, idx: Int) -> Int {\\n  let offset = idx * 4\\n  let b0 = Bytes::get(b, offset)\\n  let b1 = Bytes::get(b, offset + 1)\\n  let b2 = Bytes::get(b, offset + 2)\\n  let b3 = Bytes::get(b, offset + 3)\\n  ((b0<<24)|(b1<<16)|(b2<<8)|b3)&mask32\\n}\\n\\n/// Append the 4 big-endian bytes of `w` to a growing `Bytes`. Each\\n/// `Bytes::push` is amortised O(1) (the underlying buffer grows by\\n/// 2× when full), so the full 80-word schedule build is O(N) total\\n/// instead of the O(N²) tower the original `String::concat`-based\\n/// version produced on wasm-gc.\\nfn push_word_bytes(b: Bytes, w: Int) -> Unit {\\n  Bytes::push(b, ushr(w, 24)&255)\\n  Bytes::push(b, ushr(w, 16)&255)\\n  Bytes::push(b, ushr(w, 8)&255)\\n  Bytes::push(b, w&255)\\n}\\n\\n/// Pad the message to a multiple of 64 bytes per the SHA-1 spec.\\n/// Builds via `StringBuilder` so the zero-fill loop doesn't re-copy\\n/// the accumulator each iteration — O(N²) → O(N) on wasm-gc.\\nfn pad_message(msg: String) -> String {\\n  let len = msg|>String::length()\\n  let bit_len = len * 8\\n  let sb = StringBuilder::new()\\n  StringBuilder::push(sb, msg)\\n  StringBuilder::push(sb, String::from_char_code(128))\\n  let mut cur_len = len + 1\\n  while cur_len % 64 != 56 {\\n    StringBuilder::push(sb, String::from_char_code(0))\\n    cur_len = cur_len + 1\\n  }\\n  // 64-bit big-endian bit-length tail. High 32 bits are always zero\\n  // for the input sizes we feed (≤ 2^32 / 8 bytes); the low 32 bits\\n  // are emitted explicitly.\\n  StringBuilder::push(sb, String::from_char_code(0))\\n  StringBuilder::push(sb, String::from_char_code(0))\\n  StringBuilder::push(sb, String::from_char_code(0))\\n  StringBuilder::push(sb, String::from_char_code(0))\\n  StringBuilder::push(sb, String::from_char_code(ushr(bit_len, 24)&255))\\n  StringBuilder::push(sb, String::from_char_code(ushr(bit_len, 16)&255))\\n  StringBuilder::push(sb, String::from_char_code(ushr(bit_len, 8)&255))\\n  StringBuilder::push(sb, String::from_char_code(bit_len&255))\\n  StringBuilder::freeze(sb)\\n}\\n\\nfn to_hex_char(i: Int) -> String {\\n  String::substring(hex_table, i, i + 1)\\n}\\n\\nfn byte_to_hex(b: Int) -> String {\\n  to_hex_char((b>>4)&15)|>String::concat(to_hex_char(b&15))\\n}\\n\\nfn word_to_hex(w: Int) -> String {\\n  let sb = StringBuilder::new()\\n  StringBuilder::push(sb, byte_to_hex(ushr(w, 24)&255))\\n  StringBuilder::push(sb, byte_to_hex(ushr(w, 16)&255))\\n  StringBuilder::push(sb, byte_to_hex(ushr(w, 8)&255))\\n  StringBuilder::push(sb, byte_to_hex(w&255))\\n  StringBuilder::freeze(sb)\\n}\\n\\n/// Build the 320-byte (80-word) SHA-1 schedule into a `Bytes` buffer.\\n/// Bytes is i8-per-cell so each codepoint stays within a byte (no\\n/// 32-bit truncation problem the `Array[Int]` route hits). Random\\n/// read access via `read_word_bytes` is O(1); each `push_word_bytes`\\n/// is amortised O(1) — so the 80-iteration expand loop is O(N) instead\\n/// of the original String-accumulator's O(N²).\\nfn build_schedule(msg: String, block_start: Int) -> Bytes {\\n  let arr = Bytes::new()\\n  let mut i = 0\\n  while i < 16 {\\n    let w = read_word(msg, block_start / 4 + i)\\n    push_word_bytes(arr, w)\\n    i = i + 1\\n  }\\n  while i < 80 {\\n    let w = rotl(\\n      read_word_bytes(arr, i - 3) ^\\n      read_word_bytes(arr, i - 8) ^\\n      read_word_bytes(arr, i - 14) ^\\n      read_word_bytes(arr, i - 16),\\n      1\\n    )\\n    push_word_bytes(arr, w)\\n    i = i + 1\\n  }\\n  arr\\n}\\n\\n/// Drive the 80 SHA-1 rounds. `w` is the schedule as `Bytes` (see\\n/// `build_schedule`) so each word read is `read_word_bytes(w, i)` —\\n/// O(1) lookup, no per-call allocation. The result is returned as a\\n/// 5-element `Bytes` buffer (20 bytes) via the same compact write\\n/// path the schedule uses, dodging a second tower of `String::concat`\\n/// calls.\\nfn process_rounds(i: Int, a: Int, b: Int, c: Int, d: Int, e: Int, w: Bytes) -> Bytes {\\n  if i >= 80 {\\n    let out = Bytes::new()\\n    push_word_bytes(out, a)\\n    push_word_bytes(out, b)\\n    push_word_bytes(out, c)\\n    push_word_bytes(out, d)\\n    push_word_bytes(out, e)\\n    out\\n  } else {\\n    let f = if i < 20 {\\n      (b&c)^((b^mask32)&d)\\n    } else if i < 40 {\\n      b^c^d\\n    } else if i < 60 {\\n      (b&c)^(b&d)^(c&d)\\n    } else {\\n      b^c^d\\n    }\\n    let k = if i < 20 {\\n      k0\\n    }\\n    else if i < 40 {\\n      k1\\n    }\\n    else if i < 60 {\\n      k2\\n    }\\n    else {\\n      k3\\n    }\\n    let temp = add32(add32(add32(add32(rotl(a, 5), f), e), k), read_word_bytes(w, i))\\n    process_rounds(i + 1, temp, a, rotl(b, 30), c, d, w)\\n  }\\n}\\n\\nfn process_blocks(msg: String, block_idx: Int, num_blocks: Int, h0: Int, h1: Int, h2: Int, h3: Int, h4: Int) -> String {\\n  if block_idx >= num_blocks {\\n    // Final 40-char hex digest assembled through a single StringBuilder\\n    // freeze (5 word_to_hex pushes), not a tower of String::concat.\\n    let sb = StringBuilder::new()\\n    StringBuilder::push(sb, word_to_hex(h0))\\n    StringBuilder::push(sb, word_to_hex(h1))\\n    StringBuilder::push(sb, word_to_hex(h2))\\n    StringBuilder::push(sb, word_to_hex(h3))\\n    StringBuilder::push(sb, word_to_hex(h4))\\n    StringBuilder::freeze(sb)\\n  } else {\\n    let w = build_schedule(msg, block_idx * 64)\\n    let result = process_rounds(0, h0, h1, h2, h3, h4, w)\\n    let new_h0 = add32(h0, read_word_bytes(result, 0))\\n    let new_h1 = add32(h1, read_word_bytes(result, 1))\\n    let new_h2 = add32(h2, read_word_bytes(result, 2))\\n    let new_h3 = add32(h3, read_word_bytes(result, 3))\\n    let new_h4 = add32(h4, read_word_bytes(result, 4))\\n    process_blocks(msg, block_idx + 1, num_blocks, new_h0, new_h1, new_h2, new_h3, new_h4)\\n  }\\n}\\n\\nexport fn sha1(msg: String) -> String {\\n  let padded = pad_message(msg)\\n  let num_blocks = (padded|>String::length()) / 64\\n  process_blocks(padded, 0, num_blocks, h0_init, h1_init, h2_init, h3_init, h4_init)\\n}\\n\")\n}\n\nlet cli_adapter_source_147 = () -> (String, String) {\n  (\"lib/@vibe/core/hex.vibe\",\n\"//# @vibe/core/hex — lowercase hex encode/decode over byte-strings (one char\\n//# code per byte, the same convention sha1's padding and the compiler's\\n//# `.hex` artifacts use). decode throws on odd length / non-hex digits.\\n\\n//# Functions\\n\\nlet hex_chars: String = \\\"0123456789abcdef\\\"\\n\\nexport fn hex_encode(s: String) -> String {\\n  let len = String::length(s)\\n  let sb = StringBuilder::new()\\n  let mut i = 0\\n  while i < len {\\n    let b = String::char_code_at(s, i) & 255\\n    let hi = (b >> 4) & 15\\n    let lo = b & 15\\n    StringBuilder::push(sb, String::substring(hex_chars, hi, hi + 1))\\n    StringBuilder::push(sb, String::substring(hex_chars, lo, lo + 1))\\n    i = i + 1\\n  }\\n  StringBuilder::freeze(sb)\\n}\\n\\nfn hex_digit_value(c: Int) -> Int with { Error } {\\n  if c >= '0' && c <= '9' {\\n    c - '0'\\n  } else if c >= 'a' && c <= 'f' {\\n    c - 'a' + 10\\n  } else if c >= 'A' && c <= 'F' {\\n    c - 'A' + 10\\n  } else {\\n    throw(\\\"invalid hex digit\\\")\\n  }\\n}\\n\\nexport fn hex_decode(hex: String) -> String with { Error } {\\n  let len = String::length(hex)\\n  if len % 2 != 0 {\\n    throw(\\\"odd-length hex string\\\")\\n  } else {\\n    let sb = StringBuilder::new()\\n    let mut i = 0\\n    while i < len {\\n      let hi = hex_digit_value(String::char_code_at(hex, i))\\n      let lo = hex_digit_value(String::char_code_at(hex, i + 1))\\n      StringBuilder::push(sb, String::from_char_code((hi << 4) | lo))\\n      i = i + 2\\n    }\\n    StringBuilder::freeze(sb)\\n  }\\n}\\n\")\n}\n\nlet cli_adapter_source_148 = () -> (String, String) {\n  (\"lib/@vibe/core/leb128.vibe\",\n\"//# Functions\\n\\nexport fn read_sleb128(buf: Bytes, offset: Int) -> (Int, Int) {\\n  let len = Bytes::length(buf)\\n  let rec go = (i: Int, result: Int, shift: Int) -> (Int, Int) {\\n    if i >= len {\\n      (result, i)\\n    } else {\\n      let byte = buf[i]\\n      let value = result|((byte&0x7F)<<shift)\\n      let next_shift = shift + 7\\n      if eq(byte&0x80, 0) {\\n        if (byte&0x40) > 0 {\\n          let sign_extend = value|((-1)<<next_shift)\\n          (sign_extend, i + 1)\\n        } else {\\n          (value, i + 1)\\n        }\\n      } else {\\n        go(i + 1, value, next_shift)\\n      }\\n    }\\n  }\\n  go(offset, 0, 0)\\n}\\n\\nexport fn read_uleb128(buf: Bytes, offset: Int) -> (Int, Int) {\\n  let len = Bytes::length(buf)\\n  let rec go = (i: Int, result: Int, shift: Int) -> (Int, Int) {\\n    if i >= len {\\n      (result, i)\\n    } else {\\n      let byte = buf[i]\\n      let value = result|((byte&0x7F)<<shift)\\n      if eq(byte&0x80, 0) {\\n        (value, i + 1)\\n      } else {\\n        go(i + 1, value, shift + 7)\\n      }\\n    }\\n  }\\n  go(offset, 0, 0)\\n}\\n\\nexport fn sleb128_size(n: Int) -> Int {\\n  let rec go = (val: Int, count: Int) -> Int {\\n    let byte = val&0x7F\\n    let next = val>>7\\n    if (eq(next, 0) && eq(byte&0x40, 0)) || (eq(next, -1) && (byte&0x40) > 0) {\\n      count\\n    } else go(next, count + 1)\\n  }\\n  go(n, 1)\\n}\\n\\nexport fn uleb128_size(n: Int) -> Int {\\n  let rec go = (val: Int, count: Int) -> Int {\\n    let next = (val>>7)&((1<<25) - 1)\\n    if eq(next, 0) {\\n      count\\n    }\\n    else go(next, count + 1)\\n  }\\n  go(n, 1)\\n}\\n\\nexport fn write_sleb128(buf: Bytes, n: Int) -> Unit {\\n  let mut val = n\\n  let mut more = true\\n  while more {\\n    let byte = val&0x7F\\n    val = val>>7\\n    if (eq(val, 0) && eq(byte&0x40, 0)) || (eq(val, -1) && (byte&0x40) > 0) {\\n      Bytes::push(buf, byte)\\n      more = false\\n    } else {\\n      Bytes::push(buf, byte|0x80)\\n    }\\n  }\\n}\\n\\nexport fn write_uleb128(buf: Bytes, n: Int) -> Unit {\\n  let mut val = n\\n  while true {\\n    let byte = val&0x7F\\n    val = (val>>7)&((1<<25) - 1)\\n    if eq(val, 0) {\\n      Bytes::push(buf, byte)\\n      break\\n    } else {\\n      Bytes::push(buf, byte|0x80)\\n    }\\n  }\\n}\\n\\nexport fn encode_sleb128(n: Int) -> Bytes {\\n  let buf = Bytes::new()\\n  write_sleb128(buf, n)\\n  buf\\n}\\n\\nexport fn encode_uleb128(n: Int) -> Bytes {\\n  let buf = Bytes::new()\\n  write_uleb128(buf, n)\\n  buf\\n}\\n\")\n}\n\nlet cli_adapter_source_149 = () -> (String, String) {\n  (\"lib/@vibe/core/list.vibe\",\n\"//# @vibe/core/list — cons-list. The contract (index.vibei) re-exports the\\n//# List enum via its bodyless `type List[T]` declaration.\\n\\n//# Types\\n\\nexport enum List[T] {\\n  Nil;\\n  Cons(T, List[T])\\n}\\n\\nimpl [T] Iterable for List[T]\\n\\n//# Functions\\n\\nexport fn list_nth[T](xs: List[T], n: Int) -> Option[T] {\\n  match xs {\\n    Nil => None,\\n    Cons(h, t) => if n == 0 {\\n      Some(h)\\n    } else list_nth(t, n - 1)\\n  }\\n}\\n\\nexport fn nth[T](xs: List[T], n: Int) -> Option[T] {\\n  list_nth(xs, n)\\n}\\n\\nexport fn list_of3[T](a: T, b: T, c: T) -> List[T] {\\n  Cons(a, Cons(b, Cons(c, Nil)))\\n}\\n\\nexport fn of3[T](a: T, b: T, c: T) -> List[T] {\\n  list_of3(a, b, c)\\n}\\n\\nexport fn list_of5[T](a: T, b: T, c: T, d: T, e: T) -> List[T] {\\n  Cons(a, Cons(b, Cons(c, Cons(d, Cons(e, Nil)))))\\n}\\n\\nexport fn of5[T](a: T, b: T, c: T, d: T, e: T) -> List[T] {\\n  list_of5(a, b, c, d, e)\\n}\\n\\nexport fn list_cons[T](x: T, xs: List[T]) -> List[T] {\\n  Cons(x, xs)\\n}\\n\\nexport fn list_drop[T](n: Int, xs: List[T]) -> List[T] {\\n  if n <= 0 {\\n    xs\\n  }\\n  else match xs {\\n    Nil => Nil,\\n    Cons(_, t) => list_drop(n - 1, t)\\n  }\\n}\\n\\nexport fn drop[T](xs: List[T], n: Int) -> List[T] {\\n  list_drop(n, xs)\\n}\\n\\nexport fn list_fold[A, B](f: (acc: B, x: A) -> B, init: B, xs: List[A]) -> B {\\n  let rec go = (acc: B, rest: List[A]) -> B {\\n    match rest {\\n      Nil => acc,\\n      Cons(h, t) => go(f(acc, h), t)\\n    }\\n  }\\n  go(init, xs)\\n}\\n\\nexport fn list_sum(xs: List[Int]) -> Int {\\n  list_fold((acc: Int, x: Int) -> Int {\\n    acc + x\\n  }, 0, xs)\\n}\\n\\nexport fn sum(xs: List[Int]) -> Int {\\n  list_sum(xs)\\n}\\n\\nexport fn list_head[T](xs: List[T]) -> Option[T] {\\n  match xs {\\n    Cons(h, _) => Some(h),\\n    _ => None\\n  }\\n}\\n\\nexport fn head[T](xs: List[T]) -> Option[T] {\\n  list_head(xs)\\n}\\n\\nexport fn list_iter[T, R](f: (x: T) -> R, xs: List[T]) -> Int {\\n  let rec go = (count: Int, rest: List[T]) -> Int {\\n    match rest {\\n      Nil => count,\\n      Cons(h, t) => {\\n        f(h)\\n        go(count + 1, t)\\n      }\\n    }\\n  }\\n  go(0, xs)\\n}\\n\\nexport fn iter[T, R](xs: List[T], f: (x: T) -> R) -> Int {\\n  list_iter(f, xs)\\n}\\n\\nexport fn list_tail[T](xs: List[T]) -> List[T] {\\n  match xs {\\n    Cons(_, t) => t,\\n    _ => Nil\\n  }\\n}\\n\\nexport fn tail[T](xs: List[T]) -> List[T] {\\n  list_tail(xs)\\n}\\n\\nexport fn list_empty[T]() -> List[T] {\\n  Nil\\n}\\n\\n// package-private: bare alias collides with set.vibe in the flat\\n// @vibe/core contract; the canonical name is list_empty.\\nfn empty[T]() -> List[T] {\\n  list_empty()\\n}\\n\\nexport fn list_length[T](xs: List[T]) -> Int {\\n  match xs {\\n    Nil => 0,\\n    Cons(_, t) => 1 + list_length(t)\\n  }\\n}\\n\\nexport fn length[T](xs: List[T]) -> Int {\\n  list_length(xs)\\n}\\n\\nexport fn iter_length[T](xs: List[T]) -> Int {\\n  list_length(xs)\\n}\\n\\nexport fn list_reverse[T](xs: List[T]) -> List[T] {\\n  let rec go = (acc: List[T], rest: List[T]) -> List[T] {\\n    match rest {\\n      Nil => acc,\\n      Cons(h, t) => go(Cons(h, acc), t)\\n    }\\n  }\\n  go(Nil, xs)\\n}\\n\\nexport fn reverse[T](xs: List[T]) -> List[T] {\\n  list_reverse(xs)\\n}\\n\\nexport fn list_map[A, B](f: (x: A) -> B, xs: List[A]) -> List[B] {\\n  let rec go = (acc: List[B], rest: List[A]) -> List[B] {\\n    match rest {\\n      Nil => acc,\\n      Cons(h, t) => go(Cons(f(h), acc), t)\\n    }\\n  }\\n  list_reverse(go(Nil, xs))\\n}\\n\\nexport fn list_zip[A, B](xs: List[A], ys: List[B]) -> List[(A, B)] {\\n  let rec go = (acc: List[(A, B)], left: List[A], right: List[B]) -> List[(A, B)] {\\n    match (left, right) {\\n      (Cons(x, xt), Cons(y, yt)) => go(Cons((x, y), acc), xt, yt),\\n      _ => list_reverse(acc)\\n    }\\n  }\\n  go(Nil, xs, ys)\\n}\\n\\nexport fn zip[A, B](xs: List[A], ys: List[B]) -> List[(A, B)] {\\n  list_zip(xs, ys)\\n}\\n\\nexport fn list_take[T](n: Int, xs: List[T]) -> List[T] {\\n  let rec go = (acc: List[T], rest: List[T], count: Int) -> List[T] {\\n    if count <= 0 {\\n      acc\\n    }\\n    else match rest {\\n      Nil => acc,\\n      Cons(h, t) => go(Cons(h, acc), t, count - 1)\\n    }\\n  }\\n  list_reverse(go(Nil, xs, n))\\n}\\n\\nexport fn take[T](xs: List[T], n: Int) -> List[T] {\\n  list_take(n, xs)\\n}\\n\\nexport fn list_append[T](xs: List[T], ys: List[T]) -> List[T] {\\n  let rec go = (acc: List[T], rest: List[T]) -> List[T] {\\n    match rest {\\n      Nil => acc,\\n      Cons(h, t) => go(Cons(h, acc), t)\\n    }\\n  }\\n  go(ys, list_reverse(xs))\\n}\\n\\nexport fn append[T](xs: List[T], ys: List[T]) -> List[T] {\\n  list_append(xs, ys)\\n}\\n\\nexport fn list_filter[T](pred: (x: T) -> Bool, xs: List[T]) -> List[T] {\\n  let rec go = (acc: List[T], rest: List[T]) -> List[T] {\\n    match rest {\\n      Nil => acc,\\n      Cons(h, t) =>\\n      if pred(h) {\\n        go(Cons(h, acc), t)\\n      }\\n      else go(acc, t)\\n    }\\n  }\\n  list_reverse(go(Nil, xs))\\n}\\n\\nexport fn filter[T](xs: List[T], pred: (x: T) -> Bool) -> List[T] {\\n  list_filter(pred, xs)\\n}\\n\\nexport fn list_flatmap[A, B](f: (x: A) -> List[B], xs: List[A]) -> List[B] {\\n  let rec go = (rest: List[A]) -> List[B] {\\n    match rest {\\n      Nil => Nil,\\n      Cons(h, t) => list_append(f(h), go(t))\\n    }\\n  }\\n  go(xs)\\n}\\n\\nexport fn flatmap[A, B](xs: List[A], f: (x: A) -> List[B]) -> List[B] {\\n  list_flatmap(f, xs)\\n}\\n\\nexport fn list_is_empty[T](xs: List[T]) -> Bool {\\n  xs is Nil\\n}\\n\\n// package-private: bare alias collides with set.vibe in the flat\\n// @vibe/core contract; the canonical name is list_is_empty.\\nfn is_empty[T](xs: List[T]) -> Bool {\\n  list_is_empty(xs)\\n}\\n\\nexport fn list_iter_get[T](xs: List[T], index: Int) -> T {\\n  match xs {\\n    Cons(h, t) =>\\n    if index == 0 {\\n      h\\n    } else list_iter_get(t, index - 1)\\n    Nil => list_iter_get(xs, index)\\n  }\\n}\\n\\nexport fn iter_get[T](xs: List[T], index: Int) -> T {\\n  list_iter_get(xs, index)\\n}\\n\\nexport fn list_singleton[T](x: T) -> List[T] {\\n  Cons(x, Nil)\\n}\\n\\nexport fn singleton[T](x: T) -> List[T] {\\n  list_singleton(x)\\n}\\n\\nexport fn list_contains_by[T](eq: (a: T, b: T) -> Bool, value: T, xs: List[T]) -> Bool {\\n  match xs {\\n    Nil => false,\\n    Cons(h, t) => if eq(h, value) {\\n      true\\n    } else list_contains_by(eq, value, t)\\n  }\\n}\\n\\n// package-private: bare alias collides with set.vibe in the flat\\n// @vibe/core contract; the canonical name is list_contains_by.\\nfn contains_by[T](xs: List[T], eq: (a: T, b: T) -> Bool, value: T) -> Bool {\\n  list_contains_by(eq, value, xs)\\n}\\n\\nexport fn List::nth[T](xs: List[T], n: Int) -> Option[T] {\\n  list_nth(xs, n)\\n}\\n\\nexport fn List::sum(xs: List[Int]) -> Int {\\n  list_sum(xs)\\n}\\n\\nexport fn List::zip[A, B](xs: List[A], ys: List[B]) -> List[(A, B)] {\\n  list_zip(xs, ys)\\n}\\n\\nexport fn List::drop[T](xs: List[T], n: Int) -> List[T] {\\n  list_drop(n, xs)\\n}\\n\\nexport fn List::head[T](xs: List[T]) -> Option[T] {\\n  list_head(xs)\\n}\\n\\nexport fn List::iter[T, R](xs: List[T], f: (x: T) -> R) -> Int {\\n  list_iter(f, xs)\\n}\\n\\nexport fn List::tail[T](xs: List[T]) -> List[T] {\\n  list_tail(xs)\\n}\\n\\nexport fn List::take[T](xs: List[T], n: Int) -> List[T] {\\n  list_take(n, xs)\\n}\\n\\nexport fn List::append[T](xs: List[T], ys: List[T]) -> List[T] {\\n  list_append(xs, ys)\\n}\\n\\nexport fn List::filter[T](xs: List[T], pred: (x: T) -> Bool) -> List[T] {\\n  list_filter(pred, xs)\\n}\\n\\nexport fn List::length[T](xs: List[T]) -> Int {\\n  list_length(xs)\\n}\\n\\nexport fn List::flatmap[A, B](xs: List[A], f: (x: A) -> List[B]) -> List[B] {\\n  list_flatmap(f, xs)\\n}\\n\\nexport fn List::reverse[T](xs: List[T]) -> List[T] {\\n  list_reverse(xs)\\n}\\n\\nexport fn List::is_empty[T](xs: List[T]) -> Bool {\\n  list_is_empty(xs)\\n}\\n\\nexport fn List::iter_get[T](xs: List[T], index: Int) -> T {\\n  iter_get(xs, index)\\n}\\n\\nexport fn List::contains_by[T](xs: List[T], eq: (a: T, b: T) -> Bool, value: T) -> Bool {\\n  list_contains_by(eq, value, xs)\\n}\\n\\nexport fn List::iter_length[T](xs: List[T]) -> Int {\\n  iter_length(xs)\\n}\\n\")\n}\n\nlet cli_adapter_source_150 = () -> (String, String) {\n  (\"lib/@vibe/core/set.vibe\",\n\"//# @vibe/core/set — string set. The contract (index.vibei) re-exports the\\n//# StringSet enum via its bodyless `type StringSet` declaration.\\n\\n//# Types\\n\\nexport enum StringSet {\\n  Empty;\\n  Node(String, StringSet)\\n}\\n\\n//# Functions\\n\\nexport fn size(s: StringSet) -> Int {\\n  match s {\\n    Empty => 0,\\n    Node(_, tail) => 1 + size(tail)\\n  }\\n}\\n\\nexport fn empty() -> StringSet {\\n  Empty\\n}\\n\\nexport fn remove(s: StringSet, value: String) -> StringSet {\\n  match s {\\n    Empty => Empty,\\n    Node(head, tail) => if head == value {\\n      tail\\n    } else Node(head, remove(tail, value))\\n  }\\n}\\n\\nexport fn contains(s: StringSet, value: String) -> Bool {\\n  match s {\\n    Empty => false,\\n    Node(head, tail) => if head == value {\\n      true\\n    } else contains(tail, value)\\n  }\\n}\\n\\nexport fn add(s: StringSet, value: String) -> StringSet {\\n  if contains(s, value) {\\n    s\\n  } else Node(value, s)\\n}\\n\\nexport fn is_empty(s: StringSet) -> Bool {\\n  s is Empty\\n}\\n\\nexport fn set_union(a: StringSet, b: StringSet) -> StringSet {\\n  let rec go = (rest: StringSet, acc: StringSet) -> StringSet {\\n    match rest {\\n      Empty => acc,\\n      Node(head, tail) => go(tail, add(acc, head))\\n    }\\n  }\\n  go(b, a)\\n}\\n\\nexport fn from_array(values: Array[String]) -> StringSet {\\n  let len = Array::length(values)\\n  let rec go = (i: Int, acc: StringSet) -> StringSet {\\n    if i >= len {\\n      acc\\n    } else go(i + 1, add(acc, Array::get(values, i)))\\n  }\\n  go(0, Empty)\\n}\\n\\nexport fn set_intersect(a: StringSet, b: StringSet) -> StringSet {\\n  let rec go = (rest: StringSet, acc: StringSet) -> StringSet {\\n    match rest {\\n      Empty => acc,\\n      Node(head, tail) => if contains(b, head) {\\n        go(tail, add(acc, head))\\n      } else go(tail, acc)\\n    }\\n  }\\n  go(a, Empty)\\n}\\n\\nexport fn set_difference(a: StringSet, b: StringSet) -> StringSet {\\n  let rec go = (rest: StringSet, acc: StringSet) -> StringSet {\\n    match rest {\\n      Empty => acc,\\n      Node(head, tail) => if contains(b, head) {\\n        go(tail, acc)\\n      } else go(tail, add(acc, head))\\n    }\\n  }\\n  go(a, Empty)\\n}\\n\\nexport fn set_value_to_string[T](value: T) -> String {\\n  __to_string(value)\\n}\\n\\nexport fn add_by[T](s: StringSet, value: T) -> StringSet {\\n  add(s, set_value_to_string(value))\\n}\\n\\nexport fn remove_by[T](s: StringSet, value: T) -> StringSet {\\n  remove(s, set_value_to_string(value))\\n}\\n\\nexport fn contains_by[T](s: StringSet, value: T) -> Bool {\\n  contains(s, set_value_to_string(value))\\n}\\n\\nexport fn from_array_by[T](values: Array[T]) -> StringSet {\\n  let len = Array::length(values)\\n  let rec go = (i: Int, acc: StringSet) -> StringSet {\\n    if i >= len {\\n      acc\\n    } else go(i + 1, add_by(acc, Array::get(values, i)))\\n  }\\n  go(0, Empty)\\n}\\n\")\n}\n\nlet cli_adapter_source_151 = () -> (String, String) {\n  (\"lib/@vibe/core/map_get.vibe\",\n\"//# Functions\\n\\n// Split from map.vibe (#766): everything here is declared in ../index.vibei\\n// and header-imported by it, so every export in this file MUST match a\\n// contract decl exactly (undeclared exports are a conformance violation).\\n// `length`/`is_empty` stay in map.vibe instead — they'd collide with the\\n// bare `length` (List) / `is_empty` (StringSet) contract names already taken.\\n\\nexport fn get[V](m: Map[String, V], key: String) -> Option[V] {\\n  if Map::has_key(m, key) {\\n    Some(Map::get(m, key))\\n  } else None\\n}\\n\\nexport fn keys[V](m: Map[String, V]) -> Array[String] {\\n  Map::keys(m)\\n}\\n\\nexport fn get_or[V](m: Map[String, V], key: String, default: V) -> V {\\n  match get(m, key) {\\n    Some(value) => value,\\n    _ => default\\n  }\\n}\\n\\nexport fn values[V](m: Map[String, V]) -> Array[V] {\\n  // `Map::values` is not a selfhost builtin (host-era relic); collect via\\n  // keys + get, which are.\\n  let ks = Map::keys(m)\\n  let out = ArrayBuilder::new()\\n  let n = Array::length(ks)\\n  let mut i = 0\\n  while i < n {\\n    ArrayBuilder::push(out, Map::get(m, Array::get(ks, i)))\\n    i = i + 1\\n  }\\n  ArrayBuilder::freeze(out)\\n}\\n\\nexport fn has_key[V](m: Map[String, V], key: String) -> Bool {\\n  Map::has_key(m, key)\\n}\\n\\nexport fn get_or_else[V](m: Map[String, V], key: String, default: () -> V) -> V {\\n  match get(m, key) {\\n    Some(value) => value,\\n    _ => default()\\n  }\\n}\\n\")\n}\n\nlet cli_adapter_source_152 = () -> (String, String) {\n  (\"lib/@vibe/core/map.vibe\",\n\"//# Imports\\n\\n// get/has_key/get_or/get_or_else moved to ./map_get.vibe (#766): that file\\n// is header-imported by ../index.vibei (contract), so every export there\\n// must be a declared contract fn. Hash, the `[K: Hash]` generic-key family,\\n// and length/is_empty (name collisions with List::length / StringSet's\\n// bare is_empty) stay here, undeclared — reachable only from inside this\\n// package (../index.vibei's `import ./r#map.vibe {}` header line pulls\\n// this file in too, but only the map_get.vibe subset is contract-checked).\\nimport ./map_get.vibe {\\n  get, has_key, get_or, get_or_else\\n}\\n\\n//# Types\\n\\n// `Hash` is method-be