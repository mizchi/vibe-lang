let selfhost_source_195 = () -> (String, String) {
  ("lib/@vibe/compiler/entry/compiler/fs_compile/index.vibe",
"\n\n\n\n\n\n\n\n\n\n\n\nfn empty_stmt_array() -> Array[Stmt] {\n  Array::slice([\n    SExport([\"_dummy\"])\n  ], 0, 0)\n}\n\nfn seed_type_db(db: TypeDb, main_path: String, main_source: String, sources: Array[(String, String)]) -> TypeDb {\n  let mut seeded = db\n  let mut i = 0\n  while i < Array::length(sources) {\n    let (path, source) = Array::get(sources, i)\n    seeded = db_set_source(seeded, path, source)\n    i = i + 1\n  }\n  db_set_source(seeded, main_path, main_source)\n}\n\nfn flatten_source_groups(source_groups: Array[(String, Array[(String, String)])]) -> Array[(String, String)] {\n  let flat = Array::slice([(\"\", \"\")], 0, 0)\n  let mut gi = 0\n  while gi < Array::length(source_groups) {\n    let (_, sources) = Array::get(source_groups, gi)\n    let mut si = 0\n    while si < Array::length(sources) {\n      Array::push(flat, Array::get(sources, si))\n      si = si + 1\n    }\n    gi = gi + 1\n  }\n  flat\n}\n\nfn normalize_source_groups(source_groups: Array[(String, Array[(String, String)])], main_path: String, main_source: String) -> Array[(String, Array[(String, String)])] {\n  let normalized = Array::slice([(\"\", Array::slice([(\"\", \"\")], 0, 0))], 0, 0)\n  let mut found = false\n  let mut gi = 0\n  while gi < Array::length(source_groups) {\n    let (group_name, sources) = Array::get(source_groups, gi)\n    let next_sources = Array::slice([(\"\", \"\")], 0, 0)\n    let mut si = 0\n    while si < Array::length(sources) {\n      let (path, source) = Array::get(sources, si)\n      if path == main_path {\n        Array::push(next_sources, (path, main_source))\n        found = true\n      } else {\n        Array::push(next_sources, (path, source))\n      }\n      si = si + 1\n    }\n    Array::push(normalized, (group_name, next_sources))\n    gi = gi + 1\n  }\n  if !found {\n    let entry_sources = Array::slice([(\"\", \"\")], 0, 0)\n    Array::push(entry_sources, (main_path, main_source))\n    Array::push(normalized, (\"entry\", entry_sources))\n  }\n  normalized\n}\n\nfn contains_source_path(sources: Array[(String, String)], target_path: String) -> Bool {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(sources) && !found {\n    let (path, _) = Array::get(sources, i)\n    if path == target_path {\n      found = true\n    } else {\n      i = i + 1\n    }\n  }\n  found\n}\n\nfn filter_source_groups(source_groups: Array[(String, Array[(String, String)])], ordered_sources: Array[(String, String)]) -> Array[(String, Array[(String, String)])] {\n  let filtered_groups = Array::slice([(\"\", Array::slice([(\"\", \"\")], 0, 0))], 0, 0)\n  let mut gi = 0\n  while gi < Array::length(source_groups) {\n    let (group_name, sources) = Array::get(source_groups, gi)\n    let next_sources = Array::slice([(\"\", \"\")], 0, 0)\n    let mut si = 0\n    while si < Array::length(sources) {\n      let pair = Array::get(sources, si)\n      let (path, _) = pair\n      if contains_source_path(ordered_sources, path) {\n        Array::push(next_sources, pair)\n      }\n      si = si + 1\n    }\n    if Array::length(next_sources) > 0 {\n      Array::push(filtered_groups, (group_name, next_sources))\n    }\n    gi = gi + 1\n  }\n  filtered_groups\n}\n\nexport fn source_group_total_source_count(source_groups: Array[(String, Array[(String, String)])]) -> Int {\n  let mut total = 0\n  let mut gi = 0\n  while gi < Array::length(source_groups) {\n    let (_, sources) = Array::get(source_groups, gi)\n    total = total + Array::length(sources)\n    gi = gi + 1\n  }\n  total\n}\n\nexport fn source_group_ordered_source_count(main_source: String, main_path: String, source_groups: Array[(String, Array[(String, String)])]) -> Int with { Error } {\n  let normalized_groups = normalize_source_groups(source_groups, main_path, main_source)\n  let ordered_sources = collect_inline_sources_ordered(\n    main_path,\n    main_source,\n    flatten_source_groups(normalized_groups)\n  )\n  Array::length(ordered_sources)\n}\n\nexport fn source_group_filtered_group_count(main_source: String, main_path: String, source_groups: Array[(String, Array[(String, String)])]) -> Int with { Error } {\n  let normalized_groups = normalize_source_groups(source_groups, main_path, main_source)\n  let ordered_sources = collect_inline_sources_ordered(\n    main_path,\n    main_source,\n    flatten_source_groups(normalized_groups)\n  )\n  let filtered_groups = filter_source_groups(normalized_groups, ordered_sources)\n  Array::length(filtered_groups)\n}\n\nfn string_array_contains_local(items: Array[String], target: String) -> Bool {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(items) && !found {\n    if Array::get(items, i) == target {\n      found = true\n    } else {\n      i = i + 1\n    }\n  }\n  found\n}\n\nfn append_inline_import_alias_collision_defs(merged: Array[Stmt], current_path: String, stmts: Array[Stmt], sources: Array[(String, String)], plan: ExportRenamePlan, excluded_locals: Array[String]) -> Unit with { Error } {\n  let refs = collect_import_alias_collision_refs(stmts)\n  let emitted = Array::slice([\n    \"\"\n  ], 0, 0)\n  let base_dir = dir_of_path(current_path)\n  let mut i = 0\n  while i < Array::length(refs) {\n    let (raw_path, original, local) = Array::get(refs, i)\n    if !string_array_contains_local(emitted, local) && !string_array_contains_local(excluded_locals, local) {\n      let resolved = resolve_import_path(base_dir, raw_path)\n      let source = source_lookup_or_throw(sources, resolved)\n      let source_stmts = namespace_private_value_stmts(\n        resolved,\n        apply_export_renames_stmts(\n          parse_program(lex(source)),\n          export_plan_renames_for(plan, resolved)\n        )\n      )\n      let mut j = 0\n      let mut done = false\n      while j < Array::length(source_stmts) && !done {\n        match rewrite_imported_value_stmt_to_local(Array::get(source_stmts, j), original, local) {\n          Some(local_stmt) => {\n            Array::push(merged, local_stmt)\n            Array::push(emitted, local)\n            done = true\n          },\n          None => ()\n        }\n        j = j + 1\n      }\n    }\n    i = i + 1\n  }\n}\n\nexport fn prepare_modules_cached(db: TypeDb, main_path: String, main_source: String, sources: Array[(String, String)]) -> TypeDb with { Error } {\n  let seeded = seed_type_db(db, main_path, main_source, sources)\n  db_typecheck(seeded, main_path)\n}\n\nfn prepare_modules_persistent_fs_cached(db: TypeDb, main_path: String, main_source: String, sources: Array[(String, String)]) -> TypeDb with { Error, Fs } {\n  let seeded = seed_type_db(db, main_path, main_source, sources)\n  db_typecheck_fs(seeded, main_path)\n}\n\nexport fn source_group_prepare_typecheck_count(db: TypeDb, main_source: String, main_path: String, source_groups: Array[(String, Array[(String, String)])]) -> Int with { Error } {\n  let normalized_groups = normalize_source_groups(source_groups, main_path, main_source)\n  let ordered_sources = collect_inline_sources_ordered(\n    main_path,\n    main_source,\n    flatten_source_groups(normalized_groups)\n  )\n  let next_db = prepare_modules_cached(\n    db,\n    main_path,\n    main_source,\n    ordered_sources\n  )\n  db_typecheck_count(next_db)\n}\n\nexport fn grouped_source_merged_len(db: TypeDb, main_source: String, main_path: String, source_groups: Array[(String, Array[(String, String)])]) -> Int with { Error } {\n  let normalized_groups = normalize_source_groups(source_groups, main_path, main_source)\n  let ordered_sources = collect_inline_sources_ordered(\n    main_path,\n    main_source,\n    flatten_source_groups(normalized_groups)\n  )\n  let filtered_groups = filter_source_groups(normalized_groups, ordered_sources)\n  let next_db = prepare_modules_cached(\n    db,\n    main_path,\n    main_source,\n    ordered_sources\n  )\n  let (merged_source, _, _) = db_grouped_merged_source(next_db, filtered_groups)\n  String::length(merged_source)\n}\n\nexport fn source_group_module_source_len(db: TypeDb, main_source: String, main_path: String, source_groups: Array[(String, Array[(String, String)])]) -> Int with { Error } {\n  let normalized_groups = normalize_source_groups(source_groups, main_path, main_source)\n  let ordered_sources = collect_inline_sources_ordered(\n    main_path,\n    main_source,\n    flatten_source_groups(normalized_groups)\n  )\n  let filtered_groups = filter_source_groups(normalized_groups, ordered_sources)\n  let (merged_source, merge_fingerprint, module_db) = db_grouped_merged_source(db, filtered_groups)\n  let (module_source, _) = db_module_source(module_db, merge_fingerprint, merged_source)\n  String::length(module_source)\n}\n\nexport fn compile_with_modules(main_source: String, main_path: String, sources: Array[(String, String)]) -> Bytes with { Error } {\n  let (bytes, _) = compile_with_modules_cached(db_new(), main_source, main_path, sources)\n  bytes\n}\n\nexport fn compile_with_modules_wasi(main_source: String, main_path: String, sources: Array[(String, String)], entry_name: String) -> Bytes with { Error } {\n  let (bytes, _) = compile_with_modules_wasi_cached(db_new(), main_source, main_path, sources, entry_name)\n  bytes\n}\n\nfn artifact_fingerprint_from_source(source: String) -> String {\n  let mod1 = 2147483647\n  let mod2 = 2147483629\n  let step1 = 131\n  let step2 = 65599\n  let len = String::length(source)\n  let mut h1 = 17\n  let mut h2 = 29\n  let mut i = 0\n  while i < len {\n    let c = String::char_code_at(source, i)\n    h1 = (h1 * step1 + c + 1) % mod1\n    h2 = (h2 * step2 + c + i + 1) % mod2\n    i = i + 1\n  }\n  String::concat(\n    __to_string(len),\n    String::concat(\":\", String::concat(__to_string(h1), String::concat(\":\", __to_string(h2))))\n  )\n}\n\nfn build_merge_fingerprint_inline(sources: Array[(String, String)]) -> String {\n  let mut acc = \"merged\"\n  let mut i = 0\n  while i < Array::length(sources) {\n    let (_, source) = Array::get(sources, i)\n    let next = String::concat(\n      acc,\n      String::concat(\"|\", artifact_fingerprint_from_source(source))\n    )\n    acc = artifact_fingerprint_from_source(next)\n    i = i + 1\n  }\n  acc\n}\n\nfn build_merged_stmts_inline(sources: Array[(String, String)]) -> Array[Stmt] with { Error } {\n  let merged = empty_stmt_array()\n  let source_count = Array::length(sources)\n  let file_paths = Array::slice([\n    \"\"\n  ], 0, 0)\n  let file_stmts = Array::slice([\n    empty_stmt_array()\n  ], 0, 0)\n  let mut pi = 0\n  while pi < source_count {\n    let (path, source) = Array::get(sources, pi)\n    Array::push(file_paths, path)\n    Array::push(file_stmts, parse_program(lex(source)))\n    pi = pi + 1\n  }\n  let plan_entry = if source_count > 0 {\n    Array::get(file_paths, source_count - 1)\n  } else {\n    \"\"\n  }\n  let plan = build_export_rename_plan(file_paths, file_stmts, plan_entry)\n  let mut si = 0\n  while si < source_count {\n    let path = Array::get(file_paths, si)\n    let stmts = Array::get(file_stmts, si)\n    let is_entry_source = si == source_count - 1\n    let export_renamed = if is_entry_source {\n      stmts\n    } else {\n      apply_export_renames_stmts(stmts, export_plan_renames_for(plan, path))\n    }\n    let namespaced_stmts = if is_entry_source {\n      export_renamed\n    } else {\n      namespace_private_value_stmts(path, export_renamed)\n    }\n    let import_renames = collect_import_value_renames(plan, path, stmts)\n    let skipped_locals = collect_import_alias_collision_locals(stmts)\n    append_inline_import_alias_collision_defs(merged, path, stmts, sources, plan, import_value_rename_locals(import_renames))\n    append_import_alias_rewritten_non_import_stmts_with_renames(merged, namespaced_stmts, skipped_locals, import_renames)\n    si = si + 1\n  }\n  merged\n}\n\nfn prune_entry_stmts(stmts: Array[Stmt], entry_name: String) -> Array[Stmt] {\n  dce_stmts(stmts, [entry_name])\n}\n\nexport fn closure_ordered_source_count(main_source: String, main_path: String, sources: Array[(String, String)]) -> Int with { Error } {\n  Array::length(collect_inline_sources_ordered(main_path, main_source, sources))\n}\n\nexport fn closure_merged_stmt_count(main_source: String, main_path: String, sources: Array[(String, String)]) -> Int with { Error } {\n  let ordered_sources = collect_inline_sources_ordered(main_path, main_source, sources)\n  let merged_stmts = build_merged_stmts_inline(ordered_sources)\n  Array::length(merged_stmts)\n}\n\nexport fn closure_pruned_stmt_count(main_source: String, main_path: String, sources: Array[(String, String)], entry_name: String) -> Int with { Error } {\n  let ordered_sources = collect_inline_sources_ordered(main_path, main_source, sources)\n  let merged_stmts = build_merged_stmts_inline(ordered_sources)\n  let pruned_stmts = prune_entry_stmts(merged_stmts, entry_name)\n  Array::length(pruned_stmts)\n}\n\nexport fn source_group_pruned_stmt_count(db: TypeDb, main_source: String, main_path: String, source_groups: Array[(String, Array[(String, String)])], entry_name: String) -> Int with { Error } {\n  let normalized_groups = normalize_source_groups(source_groups, main_path, main_source)\n  let ordered_sources = collect_inline_sources_ordered(\n    main_path,\n    main_source,\n    flatten_source_groups(normalized_groups)\n  )\n  let _ = db\n  let merged_stmts = build_merged_stmts_inline(ordered_sources)\n  let pruned_stmts = prune_entry_stmts(merged_stmts, entry_name)\n  Array::length(pruned_stmts)\n}\n\nexport fn compile_with_modules_cached(db: TypeDb, main_source: String, main_path: String, sources: Array[(String, String)]) -> (Bytes, TypeDb) with { Error } {\n  let next_db = prepare_modules_cached(db, main_path, main_source, sources)\n  let ordered_sources = collect_inline_sources_ordered(main_path, main_source, sources)\n  let (merged_source, merge_fingerprint, merge_db) = db_merged_source(next_db, main_path, ordered_sources)\n  let (module_source, codegen_db) = db_module_source(merge_db, merge_fingerprint, merged_source)\n  let artifact_fingerprint = artifact_fingerprint_from_source(module_source)\n  match db_load_artifact(codegen_db, main_path, \"module\", \"\", artifact_fingerprint) {\n    Some(bytes) => (bytes, codegen_db),\n    None => {\n      let stmts = parse_program(lex(module_source))\n      let bytes = compile_module(stmts)\n      (bytes, db_store_artifact(codegen_db, main_path, \"module\", \"\", artifact_fingerprint, bytes))\n    }\n  }\n}\n\nexport fn compile_with_modules_wasi_cached(db: TypeDb, main_source: String, main_path: String, sources: Array[(String, String)], entry_name: String) -> (Bytes, TypeDb) with { Error } {\n  let next_db = prepare_modules_cached(db, main_path, main_source, sources)\n  let ordered_sources = collect_inline_sources_ordered(main_path, main_source, sources)\n  let merge_fingerprint = build_merge_fingerprint_inline(ordered_sources)\n  let artifact_fingerprint = artifact_fingerprint_from_source(\n    String::concat(merge_fingerprint, String::concat(\"|\", entry_name))\n  )\n  match db_load_artifact(next_db, main_path, \"wasi\", entry_name, artifact_fingerprint) {\n    Some(bytes) => (bytes, next_db),\n    None => {\n      let merged_stmts = build_merged_stmts_inline(ordered_sources)\n      let pruned_stmts = prune_entry_stmts(merged_stmts, entry_name)\n      let bytes = compile_wasi_module(pruned_stmts, entry_name)\n      (bytes, db_store_artifact(next_db, main_path, \"wasi\", entry_name, artifact_fingerprint, bytes))\n    }\n  }\n}\n\nexport fn compile_with_closure_sources_wasi_cached(db: TypeDb, main_source: String, main_path: String, sources: Array[(String, String)], entry_name: String) -> (Bytes, TypeDb) with { Error } {\n  let ordered_sources = collect_inline_sources_ordered(main_path, main_source, sources)\n  let next_db = prepare_modules_cached(db, main_path, main_source, ordered_sources)\n  let merge_fingerprint = build_merge_fingerprint_inline(ordered_sources)\n  let artifact_fingerprint = artifact_fingerprint_from_source(\n    String::concat(merge_fingerprint, String::concat(\"|\", entry_name))\n  )\n  match db_load_artifact(next_db, main_path, \"wasi\", entry_name, artifact_fingerprint) {\n    Some(bytes) => (bytes, next_db),\n    None => {\n      let merged_stmts = build_merged_stmts_inline(ordered_sources)\n      let pruned_stmts = prune_entry_stmts(merged_stmts, entry_name)\n      let bytes = compile_wasi_module(pruned_stmts, entry_name)\n      (bytes, db_store_artifact(next_db, main_path, \"wasi\", entry_name, artifact_fingerprint, bytes))\n    }\n  }\n}\n\nexport fn compile_with_closure_sources_wasi_mode_cached(db: TypeDb, main_source: String, main_path: String, sources: Array[(String, String)], entry_name: String, mode: String) -> (Bytes, TypeDb) with { Error } {\n  let ordered_sources = collect_inline_sources_ordered(main_path, main_source, sources)\n  let next_db = prepare_modules_cached(db, main_path, main_source, ordered_sources)\n  let merge_fingerprint = build_merge_fingerprint_inline(ordered_sources)\n  let artifact_kind = if mode == \"mvp\" {\n    \"wasi-mvp\"\n  } else if mode == \"no-dce\" {\n    \"wasi\"\n  } else {\n    throw(String::concat(\"unsupported compile mode: \", mode))\n  }\n  let artifact_fingerprint = artifact_fingerprint_from_source(\n    String::concat(merge_fingerprint, String::concat(\"|\", String::concat(entry_name, String::concat(\"|\", mode))))\n  )\n  match db_load_artifact(next_db, main_path, artifact_kind, entry_name, artifact_fingerprint) {\n    Some(bytes) => (bytes, next_db),\n    None => {\n      let merged_stmts = build_merged_stmts_inline(ordered_sources)\n      let bytes = if mode == \"mvp\" {\n        let pruned_stmts = prune_entry_stmts(merged_stmts, entry_name)\n        compile_wasi_module_impl(pruned_stmts, entry_name)\n      } else {\n        compile_wasi_module(merged_stmts, entry_name)\n      }\n      (bytes, db_store_artifact(next_db, main_path, artifact_kind, entry_name, artifact_fingerprint, bytes))\n    }\n  }\n}\n\nexport fn compile_with_closure_sources_wasi_unchecked_cached(db: TypeDb, main_source: String, main_path: String, sources: Array[(String, String)], entry_name: String) -> (Bytes, TypeDb) with { Error } {\n  let ordered_sources = collect_inline_sources_ordered(main_path, main_source, sources)\n  let merge_fingerprint = build_merge_fingerprint_inline(ordered_sources)\n  let artifact_fingerprint = artifact_fingerprint_from_source(\n    String::concat(merge_fingerprint, String::concat(\"|\", entry_name))\n  )\n  match db_load_artifact(db, main_path, \"wasi\", entry_name, artifact_fingerprint) {\n    Some(bytes) => (bytes, db),\n    None => {\n      let merged_stmts = build_merged_stmts_inline(ordered_sources)\n      let pruned_stmts = prune_entry_stmts(merged_stmts, entry_name)\n      let bytes = compile_wasi_module(pruned_stmts, entry_name)\n      (bytes, db_store_artifact(db, main_path, \"wasi\", entry_name, artifact_fingerprint, bytes))\n    }\n  }\n}\n\nexport fn compile_with_closure_sources_wasi_mode_unchecked_cached(db: TypeDb, main_source: String, main_path: String, sources: Array[(String, String)], entry_name: String, mode: String) -> (Bytes, TypeDb) with { Error } {\n  let ordered_sources = collect_inline_sources_ordered(main_path, main_source, sources)\n  let merge_fingerprint = build_merge_fingerprint_inline(ordered_sources)\n  let artifact_kind = if mode == \"mvp\" {\n    \"wasi-mvp-unchecked\"\n  } else if mode == \"no-dce\" {\n    \"wasi-unchecked\"\n  } else {\n    throw(String::concat(\"unsupported compile mode: \", mode))\n  }\n  let artifact_fingerprint = artifact_fingerprint_from_source(\n    String::concat(merge_fingerprint, String::concat(\"|\", String::concat(entry_name, String::concat(\"|\", mode))))\n  )\n  match db_load_artifact(db, main_path, artifact_kind, entry_name, artifact_fingerprint) {\n    Some(bytes) => (bytes, db),\n    None => {\n      let merged_stmts = build_merged_stmts_inline(ordered_sources)\n      let bytes = if mode == \"mvp\" {\n        let pruned_stmts = prune_entry_stmts(merged_stmts, entry_name)\n        compile_wasi_module_impl(pruned_stmts, entry_name)\n      } else {\n        compile_wasi_module(merged_stmts, entry_name)\n      }\n      (bytes, db_store_artifact(db, main_path, artifact_kind, entry_name, artifact_fingerprint, bytes))\n    }\n  }\n}\n\nexport fn compile_with_closure_sources_wasi_mode_unchecked(main_source: String, main_path: String, sources: Array[(String, String)], entry_name: String, mode: String) -> Bytes with { Error } {\n  let (bytes, _) = compile_with_closure_sources_wasi_mode_unchecked_cached(\n    db_new(),\n    main_source,\n    main_path,\n    sources,\n    entry_name,\n    mode\n  )\n  bytes\n}\n\nexport fn compile_with_closure_sources_wasi_mode_uncached(main_source: String, main_path: String, sources: Array[(String, String)], entry_name: String, mode: String) -> Bytes with { Error } {\n  let ordered_sources = collect_inline_sources_ordered(main_path, main_source, sources)\n  let merged_stmts = build_merged_stmts_inline(ordered_sources)\n  if mode == \"mvp\" {\n    let pruned_stmts = prune_entry_stmts(merged_stmts, entry_name)\n    compile_wasi_module_impl(pruned_stmts, entry_name)\n  } else if mode == \"no-dce\" {\n    compile_wasi_module(merged_stmts, entry_name)\n  } else {\n    throw(String::concat(\"unsupported compile mode: \", mode))\n  }\n}\n\nexport fn compile_with_source_groups_wasi_cached(db: TypeDb, main_source: String, main_path: String, source_groups: Array[(String, Array[(String, String)])], entry_name: String) -> (Bytes, TypeDb) with { Error } {\n  let normalized_groups = normalize_source_groups(source_groups, main_path, main_source)\n  let ordered_sources = collect_inline_sources_ordered(\n    main_path,\n    main_source,\n    flatten_source_groups(normalized_groups)\n  )\n  let filtered_groups = filter_source_groups(normalized_groups, ordered_sources)\n  let next_db = prepare_modules_cached(\n    db,\n    main_path,\n    main_source,\n    ordered_sources\n  )\n  let (merged_source, merge_fingerprint, codegen_db) = db_grouped_merged_source(next_db, filtered_groups)\n  let artifact_fingerprint = artifact_fingerprint_from_source(\n    String::concat(merge_fingerprint, String::concat(\"|\", entry_name))\n  )\n  match db_load_artifact(codegen_db, main_path, \"wasi\", entry_name, artifact_fingerprint) {\n    Some(bytes) => (bytes, codegen_db),\n    None => {\n      let merged_stmts = parse_program(lex(merged_source))\n      let pruned_stmts = prune_entry_stmts(merged_stmts, entry_name)\n      let bytes = compile_wasi_module(pruned_stmts, entry_name)\n      (bytes, db_store_artifact(codegen_db, main_path, \"wasi\", entry_name, artifact_fingerprint, bytes))\n    }\n  }\n}\n\nexport fn compile_with_source_groups_wasi_unchecked_cached(db: TypeDb, main_source: String, main_path: String, source_groups: Array[(String, Array[(String, String)])], entry_name: String) -> (Bytes, TypeDb) with { Error } {\n  let normalized_groups = normalize_source_groups(source_groups, main_path, main_source)\n  let ordered_sources = collect_inline_sources_ordered(\n    main_path,\n    main_source,\n    flatten_source_groups(normalized_groups)\n  )\n  let filtered_groups = filter_source_groups(normalized_groups, ordered_sources)\n  let (merged_source, merge_fingerprint, merge_db) = db_grouped_merged_source(db, filtered_groups)\n  let artifact_fingerprint = artifact_fingerprint_from_source(\n    String::concat(merge_fingerprint, String::concat(\"|\", entry_name))\n  )\n  match db_load_artifact(merge_db, main_path, \"wasi\", entry_name, artifact_fingerprint) {\n    Some(bytes) => (bytes, merge_db),\n    None => {\n      let merged_stmts = parse_program(lex(merged_source))\n      let pruned_stmts = prune_entry_stmts(merged_stmts, entry_name)\n      let bytes = compile_wasi_module(pruned_stmts, entry_name)\n      (bytes, db_store_artifact(merge_db, main_path, \"wasi\", entry_name, artifact_fingerprint, bytes))\n    }\n  }\n}\n\nexport fn compile_with_source_groups_via_module_source_wasi_unchecked_cached(db: TypeDb, main_source: String, main_path: String, source_groups: Array[(String, Array[(String, String)])], entry_name: String) -> (Bytes, TypeDb) with { Error } {\n  let normalized_groups = normalize_source_groups(source_groups, main_path, main_source)\n  let ordered_sources = collect_inline_sources_ordered(\n    main_path,\n    main_source,\n    flatten_source_groups(normalized_groups)\n  )\n  let filtered_groups = filter_source_groups(normalized_groups, ordered_sources)\n  let (merged_source, merge_fingerprint, module_db) = db_grouped_merged_source(db, filtered_groups)\n  let (module_source, codegen_db) = db_module_source(module_db, merge_fingerprint, merged_source)\n  let artifact_fingerprint = artifact_fingerprint_from_source(\n    String::concat(module_source, String::concat(\"|\", entry_name))\n  )\n  match db_load_artifact(codegen_db, main_path, \"wasi-module-source\", entry_name, artifact_fingerprint) {\n    Some(bytes) => (bytes, codegen_db),\n    None => {\n      let module_stmts = parse_program(lex(module_source))\n      let pruned_stmts = prune_entry_stmts(module_stmts, entry_name)\n      let bytes = compile_wasi_module_impl(pruned_stmts, entry_name)\n      (bytes, db_store_artifact(codegen_db, main_path, \"wasi-module-source\", entry_name, artifact_fingerprint, bytes))\n    }\n  }\n}\n\nexport fn compile_with_source_groups_via_module_source_wasi_unchecked_rc(db: TypeDb, main_source: String, main_path: String, source_groups: Array[(String, Array[(String, String)])], entry_name: String) -> (Bytes, TypeDb) with { Error } {\n  let normalized_groups = normalize_source_groups(source_groups, main_path, main_source)\n  let ordered_sources = collect_inline_sources_ordered(\n    main_path,\n    main_source,\n    flatten_source_groups(normalized_groups)\n  )\n  let filtered_groups = filter_source_groups(normalized_groups, ordered_sources)\n  let (merged_source, merge_fingerprint, module_db) = db_grouped_merged_source(db, filtered_groups)\n  let (module_source, codegen_db) = db_module_source(module_db, merge_fingerprint, merged_source)\n  let artifact_fingerprint = artifact_fingerprint_from_source(\n    String::concat(module_source, String::concat(\"|\", entry_name))\n  )\n  match db_load_artifact(codegen_db, main_path, \"wasi-module-source-rc\", entry_name, artifact_fingerprint) {\n    Some(bytes) => (bytes, codegen_db),\n    None => {\n      let module_stmts = parse_program(lex(module_source))\n      let pruned_stmts = prune_entry_stmts(module_stmts, entry_name)\n      let bytes = compile_wasi_module_rc_impl(pruned_stmts, entry_name)\n      (bytes, db_store_artifact(codegen_db, main_path, \"wasi-module-source-rc\", entry_name, artifact_fingerprint, bytes))\n    }\n  }\n}\n\nexport fn compile_file_fs(entry_path: String, entry_name: String) -> Bytes with { Error, Fs, Env } {\n  let (bytes, _) = compile_file_fs_cached(db_new(), entry_path, entry_name)\n  bytes\n}\n\nexport fn compile_file_fs_module(entry_path: String) -> Bytes with { Error, Fs } {\n  let (bytes, _) = compile_file_fs_module_cached(db_new(), entry_path)\n  bytes\n}\n\nexport fn prepare_file_fs_cached(db: TypeDb, entry_path: String) -> TypeDb with { Error, Fs } {\n  let source_groups = collect_source_groups_fs(entry_path)\n  prepare_file_fs_from_source_groups_persistent_cached(db, entry_path, source_groups)\n}\n\nfn prepare_file_fs_from_source_groups_cached(db: TypeDb, entry_path: String, source_groups: Array[(String, Array[(String, String)])]) -> TypeDb with { Error } {\n  let sources = flatten_source_groups(source_groups)\n  let main_source = source_lookup_or_throw(sources, entry_path)\n  prepare_modules_cached(db, entry_path, main_source, sources)\n}\n\nfn prepare_file_fs_from_source_groups_persistent_cached(db: TypeDb, entry_path: String, source_groups: Array[(String, Array[(String, String)])]) -> TypeDb with { Error, Fs } {\n  let sources = flatten_source_groups(source_groups)\n  let main_source = source_lookup_or_throw(sources, entry_path)\n  prepare_modules_persistent_fs_cached(db, entry_path, main_source, sources)\n}\n\nfn compile_file_fs_cached_slow(db: TypeDb, entry_path: String, entry_name: String) -> (Bytes, TypeDb) with { Error, Fs, Env } {\n  let source_groups = collect_source_groups_fs(entry_path)\n  let persistent_artifact_fingerprint = build_fs_compile_wasi_artifact_fingerprint(\n    source_groups,\n    entry_name\n  )\n  match load_persistent_artifact(\"fs-compile-wasi\", entry_name, persistent_artifact_fingerprint) {\n    Some(bytes) => (bytes, db),\n    None => {\n      let next_db = prepare_file_fs_from_source_groups_persistent_cached(db, entry_path, source_groups)\n      let (merged_source, _, codegen_db) = db_grouped_merged_source(next_db, source_groups)\n      let dump_path = Env::get(\"VIBE_DUMP_FS_MERGED\")\n      if dump_path == \"\" {\n        ()\n      } else {\n        Fs::write_file(dump_path, merged_source)\n      }\n      let artifact_fingerprint = artifact_fingerprint_from_source(merged_source)\n      match db_load_artifact(codegen_db, entry_path, \"wasi\", entry_name, artifact_fingerprint) {\n        Some(bytes) => (bytes, codegen_db),\n        None => {\n          let merged_stmts = parse_program(lex(merged_source))\n          let pruned_stmts = prune_entry_stmts(merged_stmts, entry_name)\n          let bytes = compile_wasi_module(pruned_stmts, entry_name)\n          store_persistent_artifact(\n            \"fs-compile-wasi\",\n            entry_name,\n            persistent_artifact_fingerprint,\n            bytes\n          )\n          (bytes, db_store_artifact(codegen_db, entry_path, \"wasi\", entry_name, artifact_fingerprint, bytes))\n        }\n      }\n    }\n  }\n}\n\nexport fn compile_file_fs_cached(db: TypeDb, entry_path: String, entry_name: String) -> (Bytes, TypeDb) with { Error, Fs, Env } {\n  match load_persistent_source_group_fingerprint_if_valid(entry_path) {\n    Some(source_groups_fingerprint) =>\n      match load_persistent_artifact(\n        \"fs-compile-wasi\",\n        entry_name,\n        build_fs_compile_wasi_artifact_fingerprint_from_group_fingerprint(\n          source_groups_fingerprint,\n          entry_name\n        )\n      ) {\n        Some(bytes) => (bytes, db),\n        None => compile_file_fs_cached_slow(db, entry_path, entry_name)\n      },\n    None => compile_file_fs_cached_slow(db, entry_path, entry_name)\n  }\n}\n\nfn compile_file_fs_module_cached_slow(db: TypeDb, entry_path: String) -> (Bytes, TypeDb) with { Error, Fs } {\n  let source_groups = collect_source_groups_fs(entry_path)\n  let persistent_artifact_fingerprint = build_fs_compile_module_artifact_fingerprint(\n    source_groups\n  )\n  match load_persistent_artifact(\"fs-compile-module\", \"\", persistent_artifact_fingerprint) {\n    Some(bytes) => (bytes, db),\n    None => {\n      let next_db = prepare_file_fs_from_source_groups_persistent_cached(db, entry_path, source_groups)\n      let (merged_source, merge_fingerprint, module_db) = db_grouped_merged_source(next_db, source_groups)\n      let (module_source, codegen_db) = db_module_source(module_db, merge_fingerprint, merged_source)\n      let artifact_fingerprint = artifact_fingerprint_from_source(module_source)\n      match db_load_artifact(codegen_db, entry_path, \"module\", \"\", artifact_fingerprint) {\n        Some(bytes) => (bytes, codegen_db),\n        None => {\n          let merged_stmts = parse_program(lex(module_source))\n          let bytes = compile_module(merged_stmts)\n          store_persistent_artifact(\n            \"fs-compile-module\",\n            \"\",\n            persistent_artifact_fingerprint,\n            bytes\n          )\n          (bytes, db_store_artifact(codegen_db, entry_path, \"module\", \"\", artifact_fingerprint, bytes))\n        }\n      }\n    }\n  }\n}\n\nexport fn compile_file_fs_module_cached(db: TypeDb, entry_path: String) -> (Bytes, TypeDb) with { Error, Fs } {\n  match load_persistent_source_group_fingerprint_if_valid(entry_path) {\n    Some(source_groups_fingerprint) =>\n      match load_persistent_artifact(\n        \"fs-compile-module\",\n        \"\",\n        build_fs_compile_module_artifact_fingerprint_from_group_fingerprint(\n          source_groups_fingerprint\n        )\n      ) {\n        Some(bytes) => (bytes, db),\n        None => compile_file_fs_module_cached_slow(db, entry_path)\n      },\n    None => compile_file_fs_module_cached_slow(db, entry_path)\n  }\n}\n")
}

let selfhost_source_196 = () -> (String, String) {
  ("lib/@vibe/compiler/entry/compiler/fs_compile/closure_order.vibe",
"\n\nfn dir_of(file_path: String) -> String {\n  let idx = String::last_index_of(file_path, \"/\")\n  if idx < 0 {\n    \"\"\n  } else {\n    file_path[0: idx]\n  }\n}\n\nfn contains_int(arr: Array[Int], target: Int) -> Bool {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(arr) {\n    if !found && Array::get(arr, i) == target {\n      found = true\n    } else {\n      i = i + 1\n    }\n  }\n  found\n}\n\nfn normalize_path(path: String) -> String {\n  let mut parts = Array::slice([\n    \"\"\n  ], 0, 0)\n  let len = String::length(path)\n  let mut start = 0\n  let mut i = 0\n  while i <= len {\n    if i == len || String::char_code_at(path, i) == 47 {\n      let part = path[start: i]\n      if String::length(part) == 0 || part == \".\" {\n        ()\n      } else if part == \"..\" {\n        if Array::length(parts) > 0 {\n          parts = Array::slice(parts, 0, Array::length(parts) - 1)\n        }\n      } else {\n        Array::push(parts, part)\n      }\n      start = i + 1\n    }\n    i = i + 1\n  }\n  let out = StringBuilder::new()\n  i = 0\n  while i < Array::length(parts) {\n    if i > 0 {\n      StringBuilder::push(out, \"/\")\n    }\n    StringBuilder::push(out, Array::get(parts, i))\n    i = i + 1\n  }\n  StringBuilder::freeze(out)\n}\n\nfn resolve_path(base_dir: String, raw_path: String) -> String {\n  let len = String::length(raw_path)\n  let joined = if (len >= 2 && raw_path[0: 2] == \"./\") ||\n  (len >= 3 && raw_path[0: 3] == \"../\") {\n    if base_dir == \"\" {\n      raw_path\n    } else {\n      String::concat(base_dir, String::concat(\"/\", raw_path))\n    }\n  } else {\n    raw_path\n  }\n  let normalized = normalize_path(joined)\n  if String::ends_with(normalized, \".vibe\") {\n    normalized\n  } else {\n    String::concat(normalized, \".vibe\")\n  }\n}\n\nfn source_find_index(sources: Array[(String, String)], path_key: String) -> Int {\n  let mut i = 0\n  let mut found = -1\n  while i < Array::length(sources) {\n    let (path, _) = Array::get(sources, i)\n    if path == path_key {\n      found = i\n      i = Array::length(sources)\n    } else {\n      i = i + 1\n    }\n  }\n  found\n}\n\nexport fn source_lookup_exists(sources: Array[(String, String)], path_key: String) -> Bool {\n  source_find_index(sources, path_key) >= 0\n}\n\nfn normalize_all_sources(main_path: String, main_source: String, sources: Array[(String, String)]) -> (Array[(String, String)], Int) {\n  let all_sources = Array::slice([\n    (\"\", \"\")\n  ], 0, 0)\n  let mut si = 0\n  while si < Array::length(sources) {\n    Array::push(all_sources, Array::get(sources, si))\n    si = si + 1\n  }\n  let mut main_index = source_find_index(all_sources, main_path)\n  if main_index < 0 {\n    Array::push(all_sources, (main_path, main_source))\n    main_index = Array::length(all_sources) - 1\n  }\n  (all_sources, main_index)\n}\n\nexport fn source_lookup_or_throw(sources: Array[(String, String)], path_key: String) -> String with { Error } {\n  let idx = source_find_index(sources, path_key)\n  if idx < 0 {\n    throw(String::concat(\"module not found: \", path_key))\n  } else {\n    let (_, source) = Array::get(sources, idx)\n    source\n  }\n}\n\nexport fn source_lookup_exists_for_test(sources: Array[(String, String)], path_key: String) -> Bool {\n  source_lookup_exists(sources, path_key)\n}\n\nexport fn resolve_relative_path_for_test(base_dir: String, raw_path: String) -> String {\n  resolve_path(base_dir, raw_path)\n}\n\nexport fn first_import_resolved_path_for_test(main_source: String, main_path: String) -> String with { Error } {\n  let stmts = parse_program(lex(main_source))\n  let base_dir = dir_of(main_path)\n  let mut i = 0\n  let mut resolved = \"\"\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SImport(raw_path, _) => {\n        resolved = resolve_path(base_dir, raw_path)\n        i = Array::length(stmts)\n      },\n      SReExport(raw_path, _) => {\n        resolved = resolve_path(base_dir, raw_path)\n        i = Array::length(stmts)\n      },\n      _ => {\n        i = i + 1\n      }\n    }\n  }\n  resolved\n}\n\nexport fn first_import_source_len_for_test(main_source: String, main_path: String, sources: Array[(String, String)]) -> Int with { Error } {\n  let resolved = first_import_resolved_path_for_test(main_source, main_path)\n  let mut si = 0\n  let mut found = None\n  while si < Array::length(sources) {\n    let (path, source) = Array::get(sources, si)\n    if path == resolved {\n      found = Some(source)\n      si = Array::length(sources)\n    } else {\n      si = si + 1\n    }\n  }\n  match found {\n    Some(source) => String::length(source),\n    None => throw(String::concat(\"module not found: \", resolved))\n  }\n}\n\nexport fn source_lookup_or_throw_len_for_test(sources: Array[(String, String)], path_key: String) -> Int with { Error } {\n  String::length(source_lookup_or_throw(sources, path_key))\n}\n\nfn collect_inline_source_indexes_ordered(all_sources: Array[(String, String)], main_index: Int) -> Array[Int] with { Error } {\n  let ordered_indexes = Array::slice([\n    0\n  ], 0, 0)\n  let visited = Array::slice([\n    0\n  ], 0, 0)\n  let mut stack = Array::slice([\n    (0, false)\n  ], 0, 0)\n  Array::push(stack, (main_index, false))\n  while Array::length(stack) > 0 {\n    let stack_len = Array::length(stack)\n    let (source_index, expanded) = Array::get(stack, stack_len - 1)\n    stack = Array::slice(stack, 0, stack_len - 1)\n    if expanded {\n      Array::push(ordered_indexes, source_index)\n    } else if contains_int(visited, source_index) {\n      ()\n    } else {\n      Array::push(visited, source_index)\n      Array::push(stack, (source_index, true))\n      let deps = Array::slice([\n        0\n      ], 0, 0)\n      let (path, source) = Array::get(all_sources, source_index)\n      let stmts = parse_program(lex(source))\n      let base_dir = dir_of(path)\n      let mut i = 0\n      while i < Array::length(stmts) {\n        match Array::get(stmts, i) {\n          SImport(raw_path, _) => {\n            let resolved = resolve_path(base_dir, raw_path)\n            let dep_index = source_find_index(all_sources, resolved)\n            if dep_index < 0 {\n              throw(String::concat(\"module not found: \", resolved))\n            }\n            Array::push(deps, dep_index)\n          },\n          SReExport(raw_path, _) => {\n            let resolved = resolve_path(base_dir, raw_path)\n            let dep_index = source_find_index(all_sources, resolved)\n            if dep_index < 0 {\n              throw(String::concat(\"module not found: \", resolved))\n            }\n            Array::push(deps, dep_index)\n          },\n          _ => ()\n        }\n        i = i + 1\n      }\n      let mut di = Array::length(deps)\n      while di > 0 {\n        let dep_index = Array::get(deps, di - 1)\n        Array::push(stack, (dep_index, false))\n        di = di - 1\n      }\n    }\n  }\n  ordered_indexes\n}\n\nexport fn closure_ordered_source_count(main_source: String, main_path: String, sources: Array[(String, String)]) -> Int with { Error } {\n  let (all_sources, main_index) = normalize_all_sources(main_path, main_source, sources)\n  Array::length(collect_inline_source_indexes_ordered(all_sources, main_index))\n}\n\nexport fn collect_inline_sources_ordered(main_path: String, main_source: String, sources: Array[(String, String)]) -> Array[(String, String)] with { Error } {\n  let (all_sources, main_index) = normalize_all_sources(main_path, main_source, sources)\n  let ordered_indexes = collect_inline_source_indexes_ordered(all_sources, main_index)\n  let ordered = Array::slice([\n    (\"\", \"\")\n  ], 0, 0)\n  let mut oi = 0\n  while oi < Array::length(ordered_indexes) {\n    let source_index = Array::get(ordered_indexes, oi)\n    Array::push(ordered, Array::get(all_sources, source_index))\n    oi = oi + 1\n  }\n  ordered\n}\n")
}

let selfhost_source_197 = () -> (String, String) {
  ("lib/@vibe/compiler/entry/compiler/file_compile/index.vibe",
"\n\n\n\n\n\n\n\n\n\n\n\n\nexport effect Profiler {\n  NowUs -> Int\n}\n\n\nfn profiler_now_us() -> Int with { Profiler } {\n  perform Profiler::NowUs\n}\n\nfn elapsed_us_since(start_us: Int) -> Int with { Profiler } {\n  let elapsed = profiler_now_us() - start_us\n  if elapsed < 0 {\n    0\n  } else {\n    elapsed\n  }\n}\n\nfn artifact_fingerprint_from_source(source: String) -> String {\n  let mod1 = 2147483647\n  let mod2 = 2147483629\n  let step1 = 131\n  let step2 = 65599\n  let len = String::length(source)\n  let mut h1 = 17\n  let mut h2 = 29\n  let mut i = 0\n  while i < len {\n    let c = String::char_code_at(source, i)\n    h1 = (h1 * step1 + c + 1) % mod1\n    h2 = (h2 * step2 + c + i + 1) % mod2\n    i = i + 1\n  }\n  String::concat(\n    __to_string(len),\n    String::concat(\":\", String::concat(__to_string(h1), String::concat(\":\", __to_string(h2))))\n  )\n}\n\nfn seed_type_db_from_source_groups(db: TypeDb, source_groups: Array[(String, Array[(String, String)])]) -> TypeDb {\n  let mut seeded = db\n  let mut gi = 0\n  while gi < Array::length(source_groups) {\n    let (_, sources) = Array::get(source_groups, gi)\n    let mut si = 0\n    while si < Array::length(sources) {\n      let (path, source) = Array::get(sources, si)\n      seeded = db_set_source(seeded, path, source)\n      si = si + 1\n    }\n    gi = gi + 1\n  }\n  seeded\n}\n\nfn append_stmt_array(dst: Array[Stmt], src: Array[Stmt]) -> Unit {\n  let mut i = 0\n  while i < Array::length(src) {\n    Array::push(dst, Array::get(src, i))\n    i = i + 1\n  }\n}\n\nfn flatten_source_groups_local(source_groups: Array[(String, Array[(String, String)])]) -> Array[(String, String)] {\n  let flat = Array::slice([\n    (\"\", \"\")\n  ], 0, 0)\n  let mut gi = 0\n  while gi < Array::length(source_groups) {\n    let (_, sources) = Array::get(source_groups, gi)\n    let mut si = 0\n    while si < Array::length(sources) {\n      Array::push(flat, Array::get(sources, si))\n      si = si + 1\n    }\n    gi = gi + 1\n  }\n  flat\n}\n\nfn string_array_contains(items: Array[String], target: String) -> Bool {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(items) && !found {\n    if Array::get(items, i) == target {\n      found = true\n    } else {\n      i = i + 1\n    }\n  }\n  found\n}\n\nfn lookup_source_by_path(sources: Array[(String, String)], target_path: String) -> Option[String] {\n  let mut i = 0\n  let mut found = None\n  while i < Array::length(sources) {\n    let (path, source) = Array::get(sources, i)\n    if path == target_path {\n      found = Some(source)\n      i = Array::length(sources)\n    } else {\n      i = i + 1\n    }\n  }\n  found\n}\n\nfn parse_program_for_path(path: String, source: String) -> Array[Stmt] with { Error } {\n  handle {\n    let (tokens, starts, _ends) = lex_with_offsets(source)\n    parse_program_located(tokens, starts, source)\n  } with Error {\n    Throw(msg) => throw(String::concat(String::concat(path, \": \"), msg))\n  }\n}\n\nfn append_import_alias_collision_defs_from_sources(merged: Array[Stmt], current_path: String, stmts: Array[Stmt], sources: Array[(String, String)], plan: ExportRenamePlan, excluded_locals: Array[String]) -> Unit with { Error } {\n  let refs = collect_import_alias_collision_refs(stmts)\n  let emitted = Array::slice([\n    \"\"\n  ], 0, 0)\n  let base_dir = dir_of_path(current_path)\n  let mut i = 0\n  while i < Array::length(refs) {\n    let (raw_path, original, local) = Array::get(refs, i)\n    if !string_array_contains(emitted, local) && !string_array_contains(excluded_locals, local) {\n      let resolved = resolve_import_path(base_dir, raw_path)\n      match lookup_source_by_path(sources, resolved) {\n        Some(source) => {\n          let source_stmts = namespace_private_value_stmts(\n            resolved,\n            apply_export_renames_stmts(\n              parse_program_for_path(resolved, source),\n              export_plan_renames_for(plan, resolved)\n            )\n          )\n          let mut j = 0\n          let mut done = false\n          while j < Array::length(source_stmts) && !done {\n            match rewrite_imported_value_stmt_to_local(Array::get(source_stmts, j), original, local) {\n              Some(local_stmt) => {\n                Array::push(merged, local_stmt)\n                Array::push(emitted, local)\n                done = true\n              },\n              None => ()\n            }\n            j = j + 1\n          }\n        },\n        None => ()\n      }\n    }\n    i = i + 1\n  }\n}\n\nfn parse_sources_for_merge(sources: Array[(String, String)]) -> (Array[String], Array[Array[Stmt]]) with { Error } {\n  let file_paths = Array::slice([\n    \"\"\n  ], 0, 0)\n  let file_stmts = Array::slice([\n    empty_stmt_array()\n  ], 0, 0)\n  let mut si = 0\n  while si < Array::length(sources) {\n    let (path, source) = Array::get(sources, si)\n    Array::push(file_paths, path)\n    Array::push(file_stmts, parse_program_for_path(path, source))\n    si = si + 1\n  }\n  (file_paths, file_stmts)\n}\n\nfn append_merged_stmts_for_file(merged: Array[Stmt], path: String, stmts: Array[Stmt], is_entry_source: Bool, plan: ExportRenamePlan, sources: Array[(String, String)]) -> Unit with { Error } {\n  let export_renamed = if is_entry_source {\n    stmts\n  } else {\n    apply_export_renames_stmts(stmts, export_plan_renames_for(plan, path))\n  }\n  let namespaced_stmts = if is_entry_source {\n    export_renamed\n  } else {\n    namespace_private_value_stmts(path, export_renamed)\n  }\n  if stmts_have_import_deep(stmts) {\n    let import_renames = collect_import_value_renames(plan, path, stmts)\n    let skipped_locals = collect_import_alias_collision_locals(stmts)\n    append_import_alias_collision_defs_from_sources(merged, path, stmts, sources, plan, import_value_rename_locals(import_renames))\n    append_import_alias_rewritten_non_import_stmts_with_renames(merged, namespaced_stmts, skipped_locals, import_renames)\n  } else {\n    append_non_import_stmts_without_alias_rewrite(merged, namespaced_stmts)\n  }\n}\n\nfn build_merged_stmts_from_sources(entry_path: String, sources: Array[(String, String)]) -> Array[Stmt] with { Error } {\n  let merged = empty_stmt_array()\n  let source_count = Array::length(sources)\n  let (file_paths, file_stmts) = parse_sources_for_merge(sources)\n  let plan_entry = if entry_path == \"\" {\n    if source_count > 0 {\n      Array::get(file_paths, source_count - 1)\n    } else {\n      \"\"\n    }\n  } else {\n    entry_path\n  }\n  let plan = build_export_rename_plan(file_paths, file_stmts, plan_entry)\n  let mut si = 0\n  while si < source_count {\n    let path = Array::get(file_paths, si)\n    let is_entry_source = if entry_path == \"\" {\n      si == source_count - 1\n    } else {\n      path == entry_path\n    }\n    append_merged_stmts_for_file(merged, path, Array::get(file_stmts, si), is_entry_source, plan, sources)\n    si = si + 1\n  }\n  merged\n}\n\nfn build_grouped_merged_stmts(source_groups: Array[(String, Array[(String, String)])]) -> Array[Stmt] with { Error } {\n  let merged = empty_stmt_array()\n  let flat_sources = flatten_source_groups_local(source_groups)\n  let (file_paths, file_stmts) = parse_sources_for_merge(flat_sources)\n  let plan_entry = if Array::length(file_paths) > 0 {\n    Array::get(file_paths, Array::length(file_paths) - 1)\n  } else {\n    \"\"\n  }\n  let plan = build_export_rename_plan(file_paths, file_stmts, plan_entry)\n  let flat_total = Array::length(file_paths)\n  let mut flat_idx = 0\n  let mut gi = 0\n  while gi < Array::length(source_groups) {\n    let (_, sources) = Array::get(source_groups, gi)\n    let source_count = Array::length(sources)\n    let mut si = 0\n    while si < source_count {\n      let path = Array::get(file_paths, flat_idx)\n      let stmts = Array::get(file_stmts, flat_idx)\n      append_merged_stmts_for_file(merged, path, stmts, flat_idx == flat_total - 1, plan, flat_sources)\n      flat_idx = flat_idx + 1\n      si = si + 1\n    }\n    gi = gi + 1\n  }\n  merged\n}\n\nfn path_basename(p: String) -> String {\n  let n = String::length(p)\n  let mut last = 0 - 1\n  let mut i = 0\n  while i < n {\n    if String::char_code_at(p, i) == 47 {\n      last = i\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  String::substring(p, last + 1, n)\n}\n\nfn file_newline_offsets(src: String) -> Array[Int] {\n  let arr = Array::slice([\n    0\n  ], 0, 0)\n  let n = String::length(src)\n  let mut i = 0\n  while i < n {\n    if String::char_code_at(src, i) == 10 {\n      Array::push(arr, i)\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  arr\n}\n\nfn build_grouped_merged_stmts_prov(source_groups: Array[(String, Array[(String, String)])]) -> (Array[Stmt], Array[String], Array[Array[Int]], Array[Int]) with { Error } {\n  let merged = empty_stmt_array()\n  let files = Array::slice([\n    \"\"\n  ], 0, 0)\n  let file_nls = Array::slice([\n    Array::slice([\n      0\n    ], 0, 0)\n  ], 0, 0)\n  let stmt_file_id = Array::slice([\n    0\n  ], 0, 0)\n  let flat_sources = flatten_source_groups_local(source_groups)\n  let (file_paths, file_stmts) = parse_sources_for_merge(flat_sources)\n  let plan_entry = if Array::length(file_paths) > 0 {\n    Array::get(file_paths, Array::length(file_paths) - 1)\n  } else {\n    \"\"\n  }\n  let plan = build_export_rename_plan(file_paths, file_stmts, plan_entry)\n  let mut flat_idx = 0\n  let mut gi = 0\n  while gi < Array::length(source_groups) {\n    let (_, sources) = Array::get(source_groups, gi)\n    let source_count = Array::length(sources)\n    let mut si = 0\n    while si < source_count {\n      let (path, source) = Array::get(sources, si)\n      let file_id = Array::length(files)\n      Array::push(files, path_basename(path))\n      Array::push(file_nls, file_newline_offsets(source))\n      let before = Array::length(merged)\n      append_merged_stmts_for_file(merged, path, Array::get(file_stmts, flat_idx), flat_idx == Array::length(file_paths) - 1, plan, flat_sources)\n      let after = Array::length(merged)\n      let mut k = before\n      while k < after {\n        Array::push(stmt_file_id, file_id)\n        k = k + 1\n      }\n      flat_idx = flat_idx + 1\n      si = si + 1\n    }\n    gi = gi + 1\n  }\n  (merged, files, file_nls, stmt_file_id)\n}\n\nfn prepare_file_fs_from_source_groups_cached(db: TypeDb, entry_path: String, source_groups: Array[(String, Array[(String, String)])]) -> TypeDb with { Error } {\n  let seeded = seed_type_db_from_source_groups(db, source_groups)\n  db_typecheck(seeded, entry_path)\n}\n\nfn prepare_file_fs_from_source_groups_persistent_cached(db: TypeDb, entry_path: String, source_groups: Array[(String, Array[(String, String)])]) -> TypeDb with { Error, Fs } {\n  let seeded = seed_type_db_from_source_groups(db, source_groups)\n  db_typecheck_fs(seeded, entry_path)\n}\n\nexport fn prepare_file_fs_cached(db: TypeDb, entry_path: String) -> TypeDb with { Error, Fs } {\n  let source_groups = collect_source_groups_fs(entry_path)\n  prepare_file_fs_from_source_groups_persistent_cached(db, entry_path, source_groups)\n}\n\nexport fn compile_file_fs_mode(entry_path: String, entry_name: String, mode: String) -> Bytes with { Error, Fs } {\n  let source_groups = collect_source_groups_fs(entry_path)\n  let next_db = prepare_file_fs_from_source_groups_persistent_cached(db_new(), entry_path, source_groups)\n  let _ = next_db\n  let merged_stmts = build_grouped_merged_stmts(source_groups)\n  if mode == \"mvp\" {\n    let pruned_stmts = dce_stmts(merged_stmts, [entry_name])\n    compile_wasi_module_impl(pruned_stmts, entry_name)\n  } else if mode == \"no-dce\" {\n    compile_wasi_module(merged_stmts, entry_name)\n  } else {\n    throw(String::concat(\"unsupported compile mode: \", mode))\n  }\n}\n\nexport fn compile_file_fs_mode_rc(entry_path: String, entry_name: String) -> Bytes with { Error, Fs } {\n  let source_groups = collect_source_groups_fs(entry_path)\n  let next_db = prepare_file_fs_from_source_groups_persistent_cached(db_new(), entry_path, source_groups)\n  let _ = next_db\n  let merged_stmts = build_grouped_merged_stmts(source_groups)\n  compile_wasi_module_rc(merged_stmts, entry_name)\n}\n\nexport fn compile_file_fs_mode_rc_shadow(entry_path: String, entry_name: String) -> Bytes with { Error, Fs } {\n  let source_groups = collect_source_groups_fs(entry_path)\n  let next_db = prepare_file_fs_from_source_groups_persistent_cached(db_new(), entry_path, source_groups)\n  let _ = next_db\n  let merged_stmts = build_grouped_merged_stmts(source_groups)\n  compile_wasi_module_rc_shadow(merged_stmts, entry_name)\n}\n\nexport fn compile_file_fs_mode_testmeta(entry_path: String, entry_name: String, mode: String, meta_out: String) -> Bytes with { Error, Fs } {\n  let source_groups = collect_source_groups_fs(entry_path)\n  let next_db = prepare_file_fs_from_source_groups_persistent_cached(db_new(), entry_path, source_groups)\n  let _ = next_db\n  let merged_stmts = build_grouped_merged_stmts(source_groups)\n  let cacheable = if meta_out != \"\" {\n    file_tests_cacheable(merged_stmts)\n  } else {\n    false\n  }\n  let bytes = if mode == \"mvp\" {\n    let pruned_stmts = dce_stmts(merged_stmts, [entry_name])\n    compile_wasi_module_impl(pruned_stmts, entry_name)\n  } else if mode == \"no-dce\" {\n    compile_wasi_module(merged_stmts, entry_name)\n  } else {\n    throw(String::concat(\"unsupported compile mode: \", mode))\n  }\n  if meta_out != \"\" {\n    Fs::write_file(meta_out, if cacheable {\n      \"1\"\n    } else {\n      \"0\"\n    })\n  } else {\n    ()\n  }\n  bytes\n}\n\nexport fn compile_file_fs_mode_coverage(entry_path: String, entry_name: String) -> Bytes with { Error, Fs } {\n  let source_groups = collect_source_groups_fs(entry_path)\n  let next_db = prepare_file_fs_from_source_groups_persistent_cached(db_new(), entry_path, source_groups)\n  let _ = next_db\n  let merged_stmts = build_grouped_merged_stmts(source_groups)\n  compile_wasi_module_coverage(merged_stmts, entry_name)\n}\n\nexport fn compile_file_fs_mode_trace(entry_path: String, entry_name: String) -> Bytes with { Error, Fs } {\n  let source_groups = collect_source_groups_fs(entry_path)\n  let next_db = prepare_file_fs_from_source_groups_persistent_cached(db_new(), entry_path, source_groups)\n  let _ = next_db\n  let merged_stmts = build_grouped_merged_stmts(source_groups)\n  compile_wasi_module_trace(merged_stmts, entry_name)\n}\n\nexport fn compile_file_fs_mode_break(entry_path: String, entry_name: String) -> Bytes with { Error, Fs } {\n  let source_groups = collect_source_groups_fs(entry_path)\n  let next_db = prepare_file_fs_from_source_groups_persistent_cached(db_new(), entry_path, source_groups)\n  let _ = next_db\n  let (merged_stmts, dbg_files, dbg_file_nls, dbg_stmt_file_id) = build_grouped_merged_stmts_prov(source_groups)\n  compile_wasi_module_break(merged_stmts, entry_name, DbgProv::{\n    files: dbg_files,\n    file_nls: dbg_file_nls,\n    stmt_file_id: dbg_stmt_file_id\n  })\n}\n\nexport fn compile_file_fs_mode_profiled(entry_path: String, entry_name: String, mode: String) -> (Bytes, Int, Int, Int, Int, Int, Int) with { Error, Fs, Profiler } {\n  let total_start = profiler_now_us()\n  let load_start = profiler_now_us()\n  let source_groups = collect_source_groups_fs(entry_path)\n  let load_us = elapsed_us_since(load_start)\n  let type_start = profiler_now_us()\n  let next_db = prepare_file_fs_from_source_groups_persistent_cached(db_new(), entry_path, source_groups)\n  let _ = next_db\n  let type_us = elapsed_us_since(type_start)\n  let bundle_start = profiler_now_us()\n  let _ = build_source_groups_fingerprint(source_groups)\n  let bundle_us = elapsed_us_since(bundle_start)\n  let parse_start = profiler_now_us()\n  let merged_stmts = build_grouped_merged_stmts(source_groups)\n  let parse_us = elapsed_us_since(parse_start)\n  let compile_start = profiler_now_us()\n  let bytes = if mode == \"mvp\" {\n    let pruned_stmts = dce_stmts(merged_stmts, [entry_name])\n    compile_wasi_module_impl(pruned_stmts, entry_name)\n  } else if mode == \"no-dce\" {\n    compile_wasi_module(merged_stmts, entry_name)\n  } else {\n    throw(String::concat(\"unsupported compile mode: \", mode))\n  }\n  let compile_us = elapsed_us_since(compile_start)\n  (bytes, load_us, type_us, bundle_us, parse_us, compile_us, elapsed_us_since(total_start))\n}\n\nfn compile_file_fs_mode_cached_slow_profiled(db: TypeDb, entry_path: String, entry_name: String, mode: String, persistent_artifact_kind: String) -> (Bytes, TypeDb, Int, Int, Int, Int, Int) with { Error, Fs, Profiler } {\n  let load_start = profiler_now_us()\n  let source_groups = collect_source_groups_fs(entry_path)\n  let persistent_artifact_fingerprint = build_file_compile_wasi_artifact_fingerprint(\n    source_groups,\n    entry_name,\n    mode\n  )\n  match load_persistent_artifact(\n    persistent_artifact_kind,\n    entry_name,\n    persistent_artifact_fingerprint\n  ) {\n    Some(bytes) => (bytes, db, elapsed_us_since(load_start), 0, 0, 0, 0),\n    None => {\n      let load_us = elapsed_us_since(load_start)\n      let type_start = profiler_now_us()\n      let next_db = prepare_file_fs_from_source_groups_persistent_cached(db, entry_path, source_groups)\n      let type_us = elapsed_us_since(type_start)\n      let bundle_start = profiler_now_us()\n      let merge_fingerprint = build_source_groups_fingerprint(source_groups)\n      let bundle_us = elapsed_us_since(bundle_start)\n      let artifact_fingerprint = merge_fingerprint\n      let artifact_kind = if mode == \"mvp\" {\n        \"wasi-mvp\"\n      } else if mode == \"no-dce\" {\n        \"wasi\"\n      } else {\n        throw(String::concat(\"unsupported compile mode: \", mode))\n      }\n      match db_load_artifact(next_db, entry_path, artifact_kind, entry_name, artifact_fingerprint) {\n        Some(bytes) => (bytes, next_db, load_us, type_us, bundle_us, 0, 0),\n        None => {\n          let parse_start = profiler_now_us()\n          let merged_stmts = build_grouped_merged_stmts(source_groups)\n          let parse_us = elapsed_us_since(parse_start)\n          let compile_start = profiler_now_us()\n          let bytes = if mode == \"mvp\" {\n            let pruned_stmts = dce_stmts(merged_stmts, [entry_name])\n            compile_wasi_module_impl(pruned_stmts, entry_name)\n          } else {\n            compile_wasi_module(merged_stmts, entry_name)\n          }\n          store_persistent_artifact(\n            persistent_artifact_kind,\n            entry_name,\n            persistent_artifact_fingerprint,\n            bytes\n          )\n          let compile_us = elapsed_us_since(compile_start)\n          (bytes, db_store_artifact(next_db, entry_path, artifact_kind, entry_name, artifact_fingerprint, bytes), load_us, type_us, bundle_us, parse_us, compile_us)\n        }\n      }\n    }\n  }\n}\n\nfn compile_file_fs_mode_cached_slow(db: TypeDb, entry_path: String, entry_name: String, mode: String, persistent_artifact_kind: String) -> (Bytes, TypeDb) with { Error, Fs } {\n  let source_groups = collect_source_groups_fs(entry_path)\n  let persistent_artifact_fingerprint = build_file_compile_wasi_artifact_fingerprint(\n    source_groups,\n    entry_name,\n    mode\n  )\n  match load_persistent_artifact(\n    persistent_artifact_kind,\n    entry_name,\n    persistent_artifact_fingerprint\n  ) {\n    Some(bytes) => (bytes, db),\n    None => {\n      let next_db = prepare_file_fs_from_source_groups_persistent_cached(db, entry_path, source_groups)\n      let merge_fingerprint = build_source_groups_fingerprint(source_groups)\n      let artifact_fingerprint = merge_fingerprint\n      let artifact_kind = if mode == \"mvp\" {\n        \"wasi-mvp\"\n      } else if mode == \"no-dce\" {\n        \"wasi\"\n      } else {\n        throw(String::concat(\"unsupported compile mode: \", mode))\n      }\n      match db_load_artifact(next_db, entry_path, artifact_kind, entry_name, artifact_fingerprint) {\n        Some(bytes) => (bytes, next_db),\n        None => {\n          let merged_stmts = build_grouped_merged_stmts(source_groups)\n          let bytes = if mode == \"mvp\" {\n            let pruned_stmts = dce_stmts(merged_stmts, [entry_name])\n            compile_wasi_module_impl(pruned_stmts, entry_name)\n          } else {\n            compile_wasi_module(merged_stmts, entry_name)\n          }\n          store_persistent_artifact(\n            persistent_artifact_kind,\n            entry_name,\n            persistent_artifact_fingerprint,\n            bytes\n          )\n          (bytes, db_store_artifact(next_db, entry_path, artifact_kind, entry_name, artifact_fingerprint, bytes))\n        }\n      }\n    }\n  }\n}\n\nexport fn compile_file_fs_mode_cached(db: TypeDb, entry_path: String, entry_name: String, mode: String) -> (Bytes, TypeDb) with { Error, Fs } {\n  let persistent_artifact_kind = if mode == \"mvp\" {\n    \"file-compile-wasi-mvp\"\n  } else if mode == \"no-dce\" {\n    \"file-compile-wasi\"\n  } else {\n    throw(String::concat(\"unsupported compile mode: \", mode))\n  }\n  match load_persistent_source_group_fingerprint_if_valid(entry_path) {\n    Some(source_groups_fingerprint) =>\n      match load_persistent_artifact(\n        persistent_artifact_kind,\n        entry_name,\n        build_file_compile_wasi_artifact_fingerprint_from_group_fingerprint(\n          source_groups_fingerprint,\n          entry_name,\n          mode\n        )\n      ) {\n        Some(bytes) => (bytes, db),\n        None => compile_file_fs_mode_cached_slow(db, entry_path, entry_name, mode, persistent_artifact_kind)\n      },\n    None => compile_file_fs_mode_cached_slow(db, entry_path, entry_name, mode, persistent_artifact_kind)\n  }\n}\n\nexport fn compile_file_fs_cached(db: TypeDb, entry_path: String, entry_name: String) -> (Bytes, TypeDb) with { Error, Fs } {\n  compile_file_fs_mode_cached(db, entry_path, entry_name, \"no-dce\")\n}\n\nexport fn compile_file_fs(entry_path: String, entry_name: String) -> Bytes with { Error, Fs } {\n  let (bytes, _) = compile_file_fs_cached(db_new(), entry_path, entry_name)\n  bytes\n}\n\nexport fn compile_file_fs_mode_cached_profiled(db: TypeDb, entry_path: String, entry_name: String, mode: String) -> (Bytes, TypeDb, Int, Int, Int, Int, Int, Int) with { Error, Fs, Profiler } {\n  let total_start = profiler_now_us()\n  let persistent_artifact_kind = if mode == \"mvp\" {\n    \"file-compile-wasi-mvp\"\n  } else if mode == \"no-dce\" {\n    \"file-compile-wasi\"\n  } else {\n    throw(String::concat(\"unsupported compile mode: \", mode))\n  }\n  let load_start = profiler_now_us()\n  match load_persistent_source_group_fingerprint_if_valid(entry_path) {\n    Some(source_groups_fingerprint) =>\n      match load_persistent_artifact(\n        persistent_artifact_kind,\n        entry_name,\n        build_file_compile_wasi_artifact_fingerprint_from_group_fingerprint(\n          source_groups_fingerprint,\n          entry_name,\n          mode\n        )\n      ) {\n        Some(bytes) => (bytes, db, elapsed_us_since(load_start), 0, 0, 0, 0, elapsed_us_since(total_start)),\n        None => {\n          let prefix_load_us = elapsed_us_since(load_start)\n          let (bytes, next_db, load_us, type_us, bundle_us, parse_us, compile_us) = compile_file_fs_mode_cached_slow_profiled(db, entry_path, entry_name, mode, persistent_artifact_kind)\n          (bytes, next_db, prefix_load_us + load_us, type_us, bundle_us, parse_us, compile_us, elapsed_us_since(total_start))\n        }\n      },\n    None => {\n      let prefix_load_us = elapsed_us_since(load_start)\n      let (bytes, next_db, load_us, type_us, bundle_us, parse_us, compile_us) = compile_file_fs_mode_cached_slow_profiled(db, entry_path, entry_name, mode, persistent_artifact_kind)\n      (bytes, next_db, prefix_load_us + load_us, type_us, bundle_us, parse_us, compile_us, elapsed_us_since(total_start))\n    }\n  }\n}\n\nfn compile_file_fs_module_cached_slow(db: TypeDb, entry_path: String) -> (Bytes, TypeDb) with { Error, Fs } {\n  let source_groups = collect_source_groups_fs(entry_path)\n  let persistent_artifact_fingerprint = build_file_compile_module_artifact_fingerprint(\n    source_groups\n  )\n  match load_persistent_artifact(\n    \"file-compile-module\",\n    \"\",\n    persistent_artifact_fingerprint\n  ) {\n    Some(bytes) => (bytes, db),\n    None => {\n      let next_db = prepare_file_fs_from_source_groups_persistent_cached(db, entry_path, source_groups)\n      let (merged_source, merge_fingerprint, module_db) = db_grouped_merged_source(next_db, source_groups)\n      let (module_source, codegen_db) = db_module_source(module_db, merge_fingerprint, merged_source)\n      let artifact_fingerprint = artifact_fingerprint_from_source(module_source)\n      match db_load_artifact(codegen_db, entry_path, \"module\", \"\", artifact_fingerprint) {\n        Some(bytes) => (bytes, codegen_db),\n        None => {\n          let merged_stmts = parse_program(lex(module_source))\n          let bytes = compile_module(merged_stmts)\n          store_persistent_artifact(\n            \"file-compile-module\",\n            \"\",\n            persistent_artifact_fingerprint,\n            bytes\n          )\n          (bytes, db_store_artifact(codegen_db, entry_path, \"module\", \"\", artifact_fingerprint, bytes))\n        }\n      }\n    }\n  }\n}\n\nexport fn compile_file_fs_module_cached(db: TypeDb, entry_path: String) -> (Bytes, TypeDb) with { Error, Fs } {\n  match load_persistent_source_group_fingerprint_if_valid(entry_path) {\n    Some(source_groups_fingerprint) =>\n      match load_persistent_artifact(\n        \"file-compile-module\",\n        \"\",\n        build_file_compile_module_artifact_fingerprint_from_group_fingerprint(\n          source_groups_fingerprint\n        )\n      ) {\n        Some(bytes) => (bytes, db),\n        None => compile_file_fs_module_cached_slow(db, entry_path)\n      },\n    None => compile_file_fs_module_cached_slow(db, entry_path)\n  }\n}\n\nexport fn compile_file_fs_module(entry_path: String) -> Bytes with { Error, Fs } {\n  let (bytes, _) = compile_file_fs_module_cached(db_new(), entry_path)\n  bytes\n}\n")
}

let selfhost_source_198 = () -> (String, String) {
  ("lib/@vibe/compiler/entry/cli_cache/index.vibe",
"\n\n\n\n\nfn strip_trailing_cr(line: String) -> String {\n  let len = String::length(line)\n  if len > 0 && String::char_code_at(line, len - 1) == 13 {\n    line[0:len - 1]\n  } else {\n    line\n  }\n}\n\nfn split_tsv_fields(line: String) -> Array[String] {\n  let fields = Array::slice([\"\"], 0, 0)\n  let len = String::length(line)\n  let mut start = 0\n  let mut i = 0\n  while i < len {\n    if String::char_code_at(line, i) == 9 {\n      Array::push(fields, line[start:i])\n      start = i + 1\n    }\n    i = i + 1\n  }\n  Array::push(fields, line[start:len])\n  fields\n}\n\nfn string_to_bytes(s: String) -> Bytes {\n  let out = Bytes::new()\n  let len = String::length(s)\n  let mut i = 0\n  while i < len {\n    Bytes::push(out, String::char_code_at(s, i))\n    i = i + 1\n  }\n  out\n}\n\nfn remove_file_if_exists(path: String) -> Unit with { Fs } {\n  if Fs::exists(path) {\n    Fs::remove(path)\n  } else {\n    ()\n  }\n}\n\nfn build_type_db_fingerprint(source: String, dep_fps: Array[(String, String)]) -> String {\n  let mut acc = compact_string_fingerprint(source)\n  let mut i = 0\n  while i < Array::length(dep_fps) {\n    let dep_pair = Array::get(dep_fps, i)\n    let dep_path = dep_pair.0\n    let dep_fp = dep_pair.1\n    acc = compact_string_fingerprint(\n      String::concat(\n        acc,\n        String::concat(\"|\", String::concat(dep_path, String::concat(\"=\", dep_fp)))\n      )\n    )\n    i = i + 1\n  }\n  acc\n}\n\nexport fn parse_batch_jobs_tsv(raw: String) -> Array[(String, String, String)] with { Error } {\n  let jobs = Array::slice([(\"\", \"\", \"\")], 0, 0)\n  let len = String::length(raw)\n  let mut line_start = 0\n  let mut i = 0\n  while i <= len {\n    if i == len || String::char_code_at(raw, i) == 10 {\n      let line = strip_trailing_cr(raw[line_start:i])\n      if String::length(line) > 0 {\n        let fields = split_tsv_fields(line)\n        let field_count = Array::length(fields)\n        if field_count < 2 || field_count > 3 {\n          throw(\"invalid VIBE_BATCH_TSV row: expected 2 or 3 tab-separated columns\")\n        }\n        let input_path = Array::get(fields, 0)\n        let output_path = Array::get(fields, 1)\n        let entry_name = if field_count == 3 { Array::get(fields, 2) } else { \"\" }\n        if String::length(input_path) == 0 || String::length(output_path) == 0 {\n          throw(\"invalid VIBE_BATCH_TSV row: input/output path must be non-empty\")\n        }\n        Array::push(jobs, (input_path, output_path, entry_name))\n      }\n      line_start = i + 1\n    }\n    i = i + 1\n  }\n  jobs\n}\n\nfn compile_job_cached(db: TypeDb, input_path: String, entry_name: String) -> (Bytes, TypeDb) with { Error, Fs } {\n  if entry_name == \"\" {\n    compile_file_fs_module_cached(db, input_path)\n  } else {\n    compile_file_fs_cached(db, input_path, entry_name)\n  }\n}\n\nfn prepare_jobs_cached_impl(db: TypeDb, jobs: Array[(String, String, String)]) -> TypeDb with { Error, Fs } {\n  let mut next_db = db\n  let mut i = 0\n  while i < Array::length(jobs) {\n    let (input_path, _, _) = Array::get(jobs, i)\n    next_db = prepare_file_fs_cached(next_db, input_path)\n    i = i + 1\n  }\n  next_db\n}\n\nexport fn prepare_jobs_cached(db: TypeDb, jobs: Array[(String, String, String)]) -> TypeDb with { Error, Fs } {\n  prepare_jobs_cached_impl(db, jobs)\n}\n\nexport fn compile_jobs_cached(db: TypeDb, jobs: Array[(String, String, String)]) -> TypeDb with { Error, Fs } {\n  let mut next_db = if Array::length(jobs) > 1 {\n    prepare_jobs_cached_impl(db, jobs)\n  } else {\n    db\n  }\n  let mut i = 0\n  while i < Array::length(jobs) {\n    let (input_path, output_path, entry_name) = Array::get(jobs, i)\n    let (bytes, compiled_db) = compile_job_cached(next_db, input_path, entry_name)\n    Fs::write_bytes(output_path, bytes)\n    next_db = compiled_db\n    i = i + 1\n  }\n  next_db\n}\n\nexport fn selfbuild_probe_cli_cache_counts() -> Int with { Error, Fs } {\n  let helper_path = \"/tmp/vibe_selfhost_cli_cache_v4_helper.vibe\"\n  let main_path = \"/tmp/vibe_selfhost_cli_cache_v4_main.vibe\"\n  Fs::write_file(\"_build/cli_cache_counts_inner_v1.txt\", \"before_write_sources\")\n  Fs::write_bytes(\n    helper_path,\n    string_to_bytes(\"export let add: (Int, Int) -> Int = (a, b) -> { a + b }\")\n  )\n  Fs::write_bytes(\n    main_path,\n    string_to_bytes(\"import ./vibe_selfhost_cli_cache_v4_helper.vibe { add }\\nlet run: () -> Int = () -> { add(1, 2) }\")\n  )\n  let jobs = [(main_path, \"/tmp/vibe_selfhost_cli_cache_v4_out.wasm\", \"run\")]\n  Fs::write_file(\"_build/cli_cache_counts_inner_v1.txt\", \"before_prepare1\")\n  let db1 = prepare_jobs_cached_impl(db_new(), jobs)\n  Fs::write_file(\n    \"_build/cli_cache_counts_inner_v1.txt\",\n    String::concat(\"after_prepare1:\", __to_string(db_typecheck_count(db1)))\n  )\n  let count1 = db_typecheck_count(db1)\n  Fs::write_file(\"_build/cli_cache_counts_inner_v1.txt\", \"before_prepare2\")\n  let db2 = prepare_jobs_cached_impl(db1, jobs)\n  Fs::write_file(\n    \"_build/cli_cache_counts_inner_v1.txt\",\n    String::concat(\"after_prepare2:\", __to_string(db_typecheck_count(db2)))\n  )\n  let count2 = db_typecheck_count(db2)\n  count1 * 1000 + count2\n}\n\nexport fn selfbuild_probe_cli_file_cache_counts() -> Int with { Error, Fs } {\n  selfbuild_probe_cli_cache_counts()\n}\n\nfn clear_prepare_probe_caches(helper_path: String, helper_source: String, main1_path: String, main1_source: String, main2_path: String, main2_source: String) -> Unit with { Fs } {\n  let helper_fp = build_type_db_fingerprint(helper_source, Array::slice([(\"\", \"\")], 0, 0))\n  let main1_fp = build_type_db_fingerprint(main1_source, [(helper_path, helper_fp)])\n  let main2_fp = build_type_db_fingerprint(main2_source, [(helper_path, helper_fp)])\n  remove_file_if_exists(\n    persistent_dep_list_cache_path(helper_path, compact_string_fingerprint(helper_source))\n  )\n  remove_file_if_exists(\n    persistent_dep_list_cache_path(main1_path, compact_string_fingerprint(main1_source))\n  )\n  remove_file_if_exists(\n    persistent_dep_list_cache_path(main2_path, compact_string_fingerprint(main2_source))\n  )\n  remove_file_if_exists(persistent_type_env_cache_path(helper_fp))\n  remove_file_if_exists(persistent_type_env_cache_path(main1_fp))\n  remove_file_if_exists(persistent_type_env_cache_path(main2_fp))\n}\n\nfn prepare_probe_sources(helper_path: String, main1_path: String, main2_path: String) -> (String, String, String) {\n  let helper_source = \"export let add: (Int, Int) -> Int = (a, b) -> { a + b }\"\n  let main1_source = String::concat(\n    \"import ./\",\n    String::concat(\n      String::substring(helper_path, String::last_index_of(helper_path, \"/\") + 1, String::length(helper_path)),\n      \" { add }\\nlet run: () -> Int = () -> { add(1, 2) }\"\n    )\n  )\n  let main2_source = String::concat(\n    \"import ./\",\n    String::concat(\n      String::substring(helper_path, String::last_index_of(helper_path, \"/\") + 1, String::length(helper_path)),\n      \" { add }\\nlet run: () -> Int = () -> { add(3, 4) }\"\n    )\n  )\n  (helper_source, main1_source, main2_source)\n}\n\nexport fn selfbuild_probe_cli_prepare_batch_parse_counts() -> Int with { Error, Fs } {\n  let fresh_helper_path = \"/tmp/vibe_selfhost_cli_prepare_fresh_helper.vibe\"\n  let fresh_main1_path = \"/tmp/vibe_selfhost_cli_prepare_fresh_main1.vibe\"\n  let fresh_main2_path = \"/tmp/vibe_selfhost_cli_prepare_fresh_main2.vibe\"\n  let shared_helper_path = \"/tmp/vibe_selfhost_cli_prepare_shared_helper.vibe\"\n  let shared_main1_path = \"/tmp/vibe_selfhost_cli_prepare_shared_main1.vibe\"\n  let shared_main2_path = \"/tmp/vibe_selfhost_cli_prepare_shared_main2.vibe\"\n  let (fresh_helper_source, fresh_main1_source, fresh_main2_source) = prepare_probe_sources(\n    fresh_helper_path,\n    fresh_main1_path,\n    fresh_main2_path\n  )\n  let (shared_helper_source, shared_main1_source, shared_main2_source) = prepare_probe_sources(\n    shared_helper_path,\n    shared_main1_path,\n    shared_main2_path\n  )\n  Fs::write_bytes(fresh_helper_path, string_to_bytes(fresh_helper_source))\n  Fs::write_bytes(fresh_main1_path, string_to_bytes(fresh_main1_source))\n  Fs::write_bytes(fresh_main2_path, string_to_bytes(fresh_main2_source))\n  Fs::write_bytes(shared_helper_path, string_to_bytes(shared_helper_source))\n  Fs::write_bytes(shared_main1_path, string_to_bytes(shared_main1_source))\n  Fs::write_bytes(shared_main2_path, string_to_bytes(shared_main2_source))\n  clear_prepare_probe_caches(\n    fresh_helper_path,\n    fresh_helper_source,\n    fresh_main1_path,\n    fresh_main1_source,\n    fresh_main2_path,\n    fresh_main2_source\n  )\n  clear_prepare_probe_caches(\n    shared_helper_path,\n    shared_helper_source,\n    shared_main1_path,\n    shared_main1_source,\n    shared_main2_path,\n    shared_main2_source\n  )\n  let fresh_count1 = db_typecheck_count(prepare_jobs_cached_impl(db_new(), [\n    (fresh_main1_path, \"/tmp/vibe_selfhost_cli_prepare_fresh_main1.wasm\", \"run\")\n  ]))\n  let fresh_count2 = db_typecheck_count(prepare_jobs_cached_impl(db_new(), [\n    (fresh_main2_path, \"/tmp/vibe_selfhost_cli_prepare_fresh_main2.wasm\", \"run\")\n  ]))\n  let shared_count = db_typecheck_count(prepare_jobs_cached_impl(db_new(), [\n    (shared_main1_path, \"/tmp/vibe_selfhost_cli_prepare_shared_main1.wasm\", \"run\"),\n    (shared_main2_path, \"/tmp/vibe_selfhost_cli_prepare_shared_main2.wasm\", \"run\")\n  ]))\n  (fresh_count1 + fresh_count2) * 1000 + shared_count\n}\n")
}

let selfhost_source_199 = () -> (String, String) {
  ("lib/@vibe/compiler/cache_probe_support.vibe",
"\n\n\n\n\nfn string_to_bytes(s: String) -> Bytes {\n  let out = Bytes::new()\n  let len = String::length(s)\n  let mut i = 0\n  while i < len {\n    Bytes::push(out, String::char_code_at(s, i))\n    i = i + 1\n  }\n  out\n}\n\nfn remove_file_if_exists(path: String) -> Unit with { Fs } {\n  if Fs::exists(path) {\n    Fs::remove(path)\n  } else {\n    ()\n  }\n}\n\nfn build_type_db_fingerprint(source: String, dep_fps: Array[(String, String)]) -> String {\n  let mut acc = compact_string_fingerprint(source)\n  let mut i = 0\n  while i < Array::length(dep_fps) {\n    let dep_pair = Array::get(dep_fps, i)\n    let dep_path = dep_pair.0\n    let dep_fp = dep_pair.1\n    acc = compact_string_fingerprint(String::concat(acc, String::concat(\"|\", String::concat(dep_path, String::concat(\"=\", dep_fp)))))\n    i = i + 1\n  }\n  acc\n}\n\nexport fn selfbuild_probe_type_db_cache_counts() -> Int with { Error } {\n  let main_source = \"let main: () -> Int = () -> { 1 + 2 }\"\n  let db1 = db_set_source(db_new(), \"main.vibe\", main_source)\n  let db2 = db_typecheck(db1, \"main.vibe\")\n  let count1 = db_typecheck_count(db2)\n  let db3 = db_typecheck(db2, \"main.vibe\")\n  let count2 = db_typecheck_count(db3)\n  count1 * 1000 + count2\n}\n\nexport fn selfbuild_probe_type_db_merge_counts() -> Int with { Error } {\n  let sources = [\n    (\"helpers.vibe\", \"export let add: (Int, Int) -> Int = (a, b) -> { a + b }\"),\n    (\"main.vibe\", \"import ./helpers.vibe { add }\\nlet main: () -> Int = () -> { add(1, 2) }\")\n  ]\n  let result1 = db_merged_source(db_new(), \"main.vibe\", sources)\n  let db1 = result1.2\n  let count1 = db_merge_count(db1)\n  let result2 = db_merged_source(db1, \"main.vibe\", sources)\n  let db2 = result2.2\n  let count2 = db_merge_count(db2)\n  count1 * 1000 + count2\n}\n\nexport fn selfbuild_probe_type_db_parse_counts() -> Int with { Error } {\n  let helper_source = \"export let add: (Int, Int) -> Int = (a, b) -> { a + b }\"\n  let main_source = \"import ./helpers.vibe { add }\\nlet main: () -> Int = () -> { add(1, 2) }\"\n  let sources = [\n    (\"helpers.vibe\", helper_source)\n  ]\n  let db1 = prepare_modules_cached(db_new(), \"main.vibe\", main_source, sources)\n  let count1 = db_parse_count(db1)\n  let db2 = prepare_modules_cached(db1, \"main.vibe\", main_source, sources)\n  let count2 = db_parse_count(db2)\n  count1 * 1000 + count2\n}\n\nexport fn selfbuild_probe_type_db_codegen_counts() -> Int with { Error } {\n  let main_source = \"let main: () -> Int = () -> { 1 + 2 }\"\n  let sources = Array::slice([\n    (\"\", \"\")\n  ], 0, 0)\n  let result1 = compile_with_modules_cached(db_new(), main_source, \"main.vibe\", sources)\n  let db1 = result1.1\n  let count1 = db_codegen_count(db1)\n  let result2 = compile_with_modules_cached(db1, main_source, \"main.vibe\", sources)\n  let db2 = result2.1\n  let count2 = db_codegen_count(db2)\n  count1 * 1000 + count2\n}\n\nexport fn selfbuild_probe_type_db_fs_parse_counts() -> Int with { Error, Fs } {\n  let helper_path = \"_build/persistent_type_env_probe_helper.vibe\"\n  let main_path = \"_build/persistent_type_env_probe_main.vibe\"\n  let helper_source = \"export let add: () -> Int = () -> { 1 }\"\n  let main_source = \"import ./persistent_type_env_probe_helper.vibe { add }\\nlet run: () -> Int = () -> { add() }\"\n  let helper_fp = build_type_db_fingerprint(helper_source, Array::slice([\n    (\"\", \"\")\n  ], 0, 0))\n  let main_fp = build_type_db_fingerprint(main_source, [\n    (helper_path, helper_fp)\n  ])\n  Fs::write_bytes(helper_path, string_to_bytes(helper_source))\n  Fs::write_bytes(main_path, string_to_bytes(main_source))\n  remove_file_if_exists(persistent_dep_list_cache_path(helper_path, compact_string_fingerprint(helper_source)))\n  remove_file_if_exists(persistent_dep_list_cache_path(main_path, compact_string_fingerprint(main_source)))\n  remove_file_if_exists(persistent_module_header_cache_path(helper_path, compact_string_fingerprint(helper_source)))\n  remove_file_if_exists(persistent_module_header_cache_path(main_path, compact_string_fingerprint(main_source)))\n  remove_file_if_exists(persistent_leaf_fingerprint_cache_path(helper_path, compact_string_fingerprint(helper_source)))\n  remove_file_if_exists(persistent_leaf_fingerprint_cache_path(main_path, compact_string_fingerprint(main_source)))\n  remove_file_if_exists(persistent_type_env_cache_path(helper_fp))\n  remove_file_if_exists(persistent_type_env_cache_path(main_fp))\n  let db1 = db_typecheck_fs(db_set_source(db_set_source(db_new(), helper_path, helper_source), main_path, main_source), main_path)\n  let count1 = db_parse_count(db1)\n  let db2 = db_typecheck_fs(db_set_source(db_set_source(db_new(), helper_path, helper_source), main_path, main_source), main_path)\n  let count2 = db_parse_count(db2)\n  count1 * 1000 + count2\n}\n\nexport fn selfbuild_probe_type_db_group_merge_counts() -> Int with { Error } {\n  let groups = [\n    (\"core\", [\n      (\"helpers.vibe\", \"export let add: (Int, Int) -> Int = (a, b) -> { a + b }\")\n    ]),\n    (\"entry\", [\n      (\"main.vibe\", \"import ./helpers.vibe { add }\\nlet main: () -> Int = () -> { add(1, 2) }\")\n    ])\n  ]\n  let result1 = db_grouped_merged_source(db_new(), groups)\n  let db1 = result1.2\n  let count1 = db_merge_count(db1)\n  let result2 = db_grouped_merged_source(db1, groups)\n  let db2 = result2.2\n  let count2 = db_merge_count(db2)\n  count1 * 1000 + count2\n}\n\nexport fn selfbuild_probe_type_db_module_source_counts() -> Int with { Error } {\n  let main_source = \"let main: () -> Int = () -> { 1 + 2 }\"\n  let sources = Array::slice([\n    (\"\", \"\")\n  ], 0, 0)\n  let result1 = compile_with_modules_cached(db_new(), main_source, \"main_a.vibe\", sources)\n  let db1 = result1.1\n  let count1 = db_module_source_count(db1)\n  let result2 = compile_with_modules_cached(db1, main_source, \"main_b.vibe\", sources)\n  let db2 = result2.1\n  let count2 = db_module_source_count(db2)\n  count1 * 1000 + count2\n}\n\nexport fn selfbuild_probe_type_db_fs_multi_dep_parse_counts() -> Int with { Error, Fs } {\n  let helper1_path = \"_build/persistent_type_env_multi_dep_helper1.vibe\"\n  let helper2_path = \"_build/persistent_type_env_multi_dep_helper2.vibe\"\n  let main_path = \"_build/persistent_type_env_multi_dep_main.vibe\"\n  let helper1_source = \"export let add1: () -> Int = () -> { 1 }\"\n  let helper2_source = \"export let add2: () -> Int = () -> { 2 }\"\n  let main_source = String::concat(\"import ./persistent_type_env_multi_dep_helper1.vibe { add1 }\\n\", String::concat(\"import ./persistent_type_env_multi_dep_helper2.vibe { add2 }\\n\", \"let run: () -> Int = () -> { add1() + add2() }\"))\n  Fs::write_bytes(helper1_path, string_to_bytes(helper1_source))\n  Fs::write_bytes(helper2_path, string_to_bytes(helper2_source))\n  Fs::write_bytes(main_path, string_to_bytes(main_source))\n  let helper1_fp = build_type_db_fingerprint(helper1_source, Array::slice([\n    (\"\", \"\")\n  ], 0, 0))\n  let helper2_fp = build_type_db_fingerprint(helper2_source, Array::slice([\n    (\"\", \"\")\n  ], 0, 0))\n  let main_fp = build_type_db_fingerprint(main_source, [\n    (helper1_path, helper1_fp),\n    (helper2_path, helper2_fp)\n  ])\n  remove_file_if_exists(persistent_dep_list_cache_path(helper1_path, compact_string_fingerprint(helper1_source)))\n  remove_file_if_exists(persistent_dep_list_cache_path(helper2_path, compact_string_fingerprint(helper2_source)))\n  remove_file_if_exists(persistent_dep_list_cache_path(main_path, compact_string_fingerprint(main_source)))\n  remove_file_if_exists(persistent_module_header_cache_path(helper1_path, compact_string_fingerprint(helper1_source)))\n  remove_file_if_exists(persistent_module_header_cache_path(helper2_path, compact_string_fingerprint(helper2_source)))\n  remove_file_if_exists(persistent_module_header_cache_path(main_path, compact_string_fingerprint(main_source)))\n  remove_file_if_exists(persistent_leaf_fingerprint_cache_path(helper1_path, compact_string_fingerprint(helper1_source)))\n  remove_file_if_exists(persistent_leaf_fingerprint_cache_path(helper2_path, compact_string_fingerprint(helper2_source)))\n  remove_file_if_exists(persistent_leaf_fingerprint_cache_path(main_path, compact_string_fingerprint(main_source)))\n  remove_file_if_exists(persistent_type_env_cache_path(helper1_fp))\n  remove_file_if_exists(persistent_type_env_cache_path(helper2_fp))\n  remove_file_if_exists(persistent_type_env_cache_path(main_fp))\n  let db1 = db_typecheck_fs(db_set_source(db_set_source(db_set_source(db_new(), helper1_path, helper1_source), helper2_path, helper2_source), main_path, main_source), main_path)\n  let count1 = db_parse_count(db1)\n  let db2 = db_typecheck_fs(db_set_source(db_set_source(db_set_source(db_new(), helper1_path, helper1_source), helper2_path, helper2_source), main_path, main_source), main_path)\n  let count2 = db_parse_count(db2)\n  count1 * 1000 + count2\n}\n")
}

let selfhost_source_200 = () -> (String, String) {
  ("lib/@vibe/compiler/selfhost_cli_adapter.vibe",
"\n\n\n\n\n\n\n\n\n\n\n\nfn adapter_basename_no_vibe(path: String) -> String {\n  let len = String::length(path)\n  let mut last_slash = 0 - 1\n  let mut i = 0\n  while i < len {\n    if String::char_code_at(path, i) == 47 {\n      last_slash = i\n    }\n    i = i + 1\n  }\n  let base = path[last_slash + 1: len]\n  let blen = String::length(base)\n  if blen >= 5 && base[blen - 5: blen] == \".vibe\" {\n    base[0: blen - 5]\n  } else {\n    base\n  }\n}\n\nfn join_lines(items: Array[String]) -> String {\n  let n = Array::length(items)\n  if n == 0 {\n    \"\"\n  } else {\n    let acc = StringBuilder::new()\n    StringBuilder::push(acc, Array::get(items, 0))\n    let mut i = 1\n    while i < n {\n      StringBuilder::push(acc, \"\\n\")\n      StringBuilder::push(acc, Array::get(items, i))\n      i = i + 1\n    }\n    StringBuilder::freeze(acc)\n  }\n}\n\nfn join_symbol_spans(syms: Array[(String, Int, Int, Int)]) -> String {\n  let n = Array::length(syms)\n  let acc = StringBuilder::new()\n  let mut first = true\n  let mut i = 0\n  while i < n {\n    let (name, kind, s, e) = Array::get(syms, i)\n    if String::length(name) == 0 {\n      ()\n    } else {\n      let line = String::concat(name, String::concat(\" \", String::concat(__to_string(kind), String::concat(\" \", String::concat(__to_string(s), String::concat(\" \", __to_string(e)))))))\n      if first {\n        StringBuilder::push(acc, line)\n        first = false\n      } else {\n        StringBuilder::push(acc, \"\\n\")\n        StringBuilder::push(acc, line)\n      }\n    }\n    i = i + 1\n  }\n  StringBuilder::freeze(acc)\n}\n\nfn join_binding_occurrences(occ: Array[(Int, Int)]) -> String {\n  let n = Array::length(occ)\n  if n == 0 {\n    \"\"\n  } else {\n    let (s0, e0) = Array::get(occ, 0)\n    let acc = StringBuilder::new()\n    StringBuilder::push(acc, String::concat(__to_string(s0), String::concat(\" \", __to_string(e0))))\n    let mut i = 1\n    while i < n {\n      let (s, e) = Array::get(occ, i)\n      let line = String::concat(__to_string(s), String::concat(\" \", __to_string(e)))\n      StringBuilder::push(acc, \"\\n\")\n      StringBuilder::push(acc, line)\n      i = i + 1\n    }\n    StringBuilder::freeze(acc)\n  }\n}\n\nfn parse_int_or(s: String, default: Int) -> Int {\n  let len = String::length(s)\n  if len == 0 {\n    default\n  } else {\n    let mut i = 0\n    let mut acc = 0\n    let mut ok = true\n    while ok && i < len {\n      let c = String::char_code_at(s, i)\n      if c >= '0' && c <= '9' {\n        acc = acc * 10 + (c - '0')\n        i = i + 1\n      } else {\n        ok = false\n      }\n    }\n    if ok {\n      acc\n    } else {\n      default\n    }\n  }\n}\n\nfn adapter_string_to_bytes(s: String) -> Bytes {\n  let out = Array::slice([\n    0\n  ], 0, 0)\n  let len = String::length(s)\n  let mut i = 0\n  while i < len {\n    Array::push(out, String::char_code_at(s, i))\n    i = i + 1\n  }\n  Bytes::from_array(out)\n}\n\nfn read_arg_or_env(index: Int, env_name: String) -> String with { Env } {\n  let value = Env::args_get(index)\n  if value != \"\" {\n    value\n  } else {\n    Env::get(env_name)\n  }\n}\n\nfn own_host_string(value: String) -> String {\n  String::concat(\"\", value)\n}\n\nfn profile_memory_mark(enabled: Bool) -> Unit with { Env } {\n  if enabled {\n    let _ = Env::get(\"VIBE_PROFILE_MEMORY_MARK\")\n    ()\n  } else {\n    ()\n  }\n}\n\nfn apply_cfg_env(source: String, cfg_csv: String) -> String {\n  if cfg_csv == \"\" {\n    source\n  } else {\n    let parts = String::split(cfg_csv, \",\")\n    let mut out = source\n    let mut i = 0\n    while i < Array::length(parts) {\n      let flag = String::trim(Array::get(parts, i))\n      if String::length(flag) > 0 {\n        out = String::concat(out, String::concat(\"\\n#cfg_enable(\", String::concat(flag, \")\")))\n      } else {\n        ()\n      }\n      i = i + 1\n    }\n    out\n  }\n}\n\nfn compile_source_for_rc_flag(source: String, entry_name: String, rc_flag: String) -> Bytes with { Error } {\n  if rc_flag == \"shadow\" {\n    compile_source_wasi_only_rc_shadow(source, entry_name)\n  } else if rc_flag != \"0\" {\n    compile_source_wasi_only_rc(source, entry_name)\n  } else {\n    compile_source_wasi_only(source, entry_name)\n  }\n}\n\nfn emit_compile_diag(output_path: String, msg: String) -> Int with { Fs } {\n  Fs::write_file(String::concat(output_path, \".diag\"), msg)\n  1\n}\n\nfn write_funcmap_sidecar(input_path: String, output_path: String) -> Int with { Fs, Error } {\n  let src = Fs::read_file(input_path)\n  let text = build_funcmap_from_source(src)\n  Fs::write_bytes(String::concat(output_path, \".funcmap\"), adapter_string_to_bytes(text))\n  0\n}\n\nfn adapter_emit_wit(input_path: String, output_path: String) -> Int with { Fs, Env } {\n  handle {\n    let entry_stmts = parse_program(lex(Fs::read_file(input_path)))\n    let wit = wit_from_program(entry_stmts, entry_stmts, adapter_basename_no_vibe(input_path))\n    Fs::write_bytes(output_path, adapter_string_to_bytes(wit))\n    0\n  } with Error {\n    Throw(msg) => emit_compile_diag(output_path, msg)\n  }\n}\n\nfn adapter_serve_component(input_path: String, output_path: String) -> Int with { Fs, Env } {\n  handle {\n    let entry_stmts = parse_program(lex(Fs::read_file(input_path)))\n    validate_serve_handler(entry_stmts)\n    let core = compile_file_fs_mode(input_path, \"__no_entry__\", \"no-dce\")\n    let component = comp_emit_component_wasm_string_handler(core, \"handler\", \"handler\", serve_handler_param_names())\n    Fs::write_bytes(output_path, component)\n    let wit_out = Env::get(\"VIBE_SERVE_WIT_OUT\")\n    if wit_out != \"\" {\n      Fs::write_bytes(wit_out, adapter_string_to_bytes(wit_from_program(entry_stmts, entry_stmts, adapter_basename_no_vibe(input_path))))\n    } else {\n      ()\n    }\n    0\n  } with Error {\n    Throw(msg) => emit_compile_diag(output_path, msg)\n  }\n}\n\nexport fn cli_main() -> Int with { Error, Fs, Env } {\n  let input_path = own_host_string(read_arg_or_env(0, \"VIBE_INPUT\"))\n  let output_path = own_host_string(read_arg_or_env(1, \"VIBE_OUTPUT\"))\n  let entry_name = own_host_string(read_arg_or_env(2, \"VIBE_ENTRY\"))\n  let mark_memory = Env::get(\"VIBE_PROFILE_MEMORY_MARKS\") == \"1\"\n  if Env::get(\"VIBE_HASH\") == \"1\" {\n    return handle {\n      let (pkg_hash, ct_hash) = contract_package_hashes_fs(input_path)\n      Fs::write_file(output_path, \"package #\\{pkg_hash}\\ncontract \\{ct_hash}\\n\")\n      0\n    } with Error {\n      Throw(msg) => emit_compile_diag(output_path, msg)\n    }\n  } else ()\n  if Env::get(\"VIBE_MISSING_VPKG_SCAN\") == \"1\" {\n    return handle {\n      let missing = find_missing_vpkg_dirs(input_path)\n      if Array::length(missing) == 0 {\n        Fs::write_file(output_path, \"ok: no directories missing index.vpkg under \\{input_path}\\n\")\n      } else {\n        Fs::write_file(output_path, String::concat(String::join(missing, \"\\n\"), \"\\n\"))\n      }\n      0\n    } with Error {\n      Throw(msg) => emit_compile_diag(output_path, msg)\n    }\n  } else ()\n  if Env::get(\"VIBE_FILL_PINS\") == \"1\" {\n    return handle {\n      let filled = fill_require_pins_fs_mode(Fs::read_file(input_path), Env::get(\"VIBE_REPIN\") == \"1\")\n      Fs::write_file(output_path, filled)\n      0\n    } with Error {\n      Throw(msg) => emit_compile_diag(output_path, msg)\n    }\n  } else ()\n  if Env::get(\"VIBE_PUBLISH_CHECK\") == \"1\" {\n    return handle {\n      let perrors = publish_check_fs(\n        Env::get(\"VIBE_PUBLISH_PREV\"),\n        input_path,\n        Env::get(\"VIBE_PUBLISH_PREV_VERSION\"),\n        Env::get(\"VIBE_PUBLISH_VERSION\")\n      )\n      if Array::length(perrors) > 0 {\n        throw(String::join(perrors, \"; \"))\n      } else ()\n      Fs::write_file(output_path, \"ok\\n\")\n      0\n    } with Error {\n      Throw(msg) => emit_compile_diag(output_path, msg)\n    }\n  } else ()\n  if Env::get(\"VIBE_FS_COMPILE\") == \"1\" {\n    return handle {\n      let bytes = if Env::get(\"VIBE_COVERAGE\") == \"1\" {\n        compile_file_fs_mode_coverage(input_path, entry_name)\n      } else if Env::get(\"VIBE_DEBUG_BREAK\") == \"1\" {\n        compile_file_fs_mode_break(input_path, entry_name)\n      } else if Env::get(\"VIBE_DEBUG\") == \"1\" {\n        compile_file_fs_mode_trace(input_path, entry_name)\n      } else if Env::get(\"VIBE_RC\") == \"shadow\" {\n        compile_file_fs_mode_rc_shadow(input_path, entry_name)\n      } else if Env::get(\"VIBE_RC\") != \"0\" {\n        compile_file_fs_mode_rc(input_path, entry_name)\n      } else {\n        let testmeta_out = Env::get(\"VIBE_TESTMETA_OUT\")\n        if testmeta_out != \"\" {\n          compile_file_fs_mode_testmeta(input_path, entry_name, \"no-dce\", testmeta_out)\n        } else {\n          compile_file_fs_mode(input_path, entry_name, \"no-dce\")\n        }\n      }\n      Fs::write_bytes(output_path, bytes)\n      let _funcmap_rc = handle {\n        write_funcmap_sidecar(input_path, output_path)\n      } with Error {\n        Throw(_) => 0\n      }\n      0\n    } with Error {\n      Throw(msg) => emit_compile_diag(output_path, msg)\n    }\n  }\n  if Env::get(\"VIBE_NORMALIZE\") == \"1\" {\n    let normalized = normalize_source(Fs::read_file(input_path))\n    Fs::write_bytes(output_path, adapter_string_to_bytes(normalized))\n    return 0\n  }\n  if Env::get(\"VIBE_TYPE_AT\") == \"1\" {\n    let src = Fs::read_file(input_path)\n    let line = parse_int_or(Env::get(\"VIBE_TYPE_LINE\"), 1)\n    let col = parse_int_or(Env::get(\"VIBE_TYPE_COL\"), 1)\n    let ty = type_at_source(src, line, col)\n    Fs::write_bytes(output_path, adapter_string_to_bytes(ty))\n    return 0\n  }\n  if Env::get(\"VIBE_BINDING_AT\") == \"1\" {\n    let src = Fs::read_file(input_path)\n    let line = parse_int_or(Env::get(\"VIBE_TYPE_LINE\"), 1)\n    let col = parse_int_or(Env::get(\"VIBE_TYPE_COL\"), 1)\n    let occ = binding_occurrences(src, line, col)\n    Fs::write_bytes(output_path, adapter_string_to_bytes(join_binding_occurrences(occ)))\n    return 0\n  }\n  if Env::get(\"VIBE_SYMBOLS\") == \"1\" {\n    let src = Fs::read_file(input_path)\n    let syms = symbol_spans(src)\n    Fs::write_bytes(output_path, adapter_string_to_bytes(join_symbol_spans(syms)))\n    return 0\n  }\n  if Env::get(\"VIBE_DIAGNOSTICS\") == \"1\" {\n    let src = Fs::read_file(input_path)\n    let diags = collect_all_diagnostics(src)\n    Fs::write_bytes(output_path, adapter_string_to_bytes(join_lines(diags)))\n    return 0\n  }\n  if Env::get(\"VIBE_EMIT_MERGED_SOURCE\") == \"1\" {\n    return handle {\n      let merged_src = merged_program_source_fs(input_path)\n      Fs::write_file(output_path, merged_src)\n      0\n    } with Error {\n      Throw(msg) => emit_compile_diag(output_path, msg)\n    }\n  }\n  if Env::get(\"VIBE_EMIT_WIT\") == \"1\" {\n    return adapter_emit_wit(input_path, output_path)\n  }\n  if Env::get(\"VIBE_SERVE_COMPONENT\") == \"1\" {\n    return adapter_serve_component(input_path, output_path)\n  }\n  let source = Fs::read_file(input_path)\n  profile_memory_mark(mark_memory)\n  if Env::get(\"VIBE_EMIT_MODULE_SOURCE\") == \"1\" {\n    let module_source = build_module_source_from_source(source, entry_name)\n    Fs::write_bytes(output_path, adapter_string_to_bytes(module_source))\n    profile_memory_mark(mark_memory)\n    0\n  } else {\n    handle {\n      let rc_flag = Env::get(\"VIBE_RC\")\n      let source_cfg = apply_cfg_env(source, Env::get(\"VIBE_CFG\"))\n      let bytes = if Env::get(\"VIBE_COVERAGE\") == \"1\" {\n        compile_source_wasi_only_coverage(source_cfg, entry_name)\n      } else if Env::get(\"VIBE_BACKEND\") == \"gc\" {\n        compile_source_gc_only(source_cfg, entry_name)\n      } else {\n        compile_source_for_rc_flag(source_cfg, entry_name, rc_flag)\n      }\n      profile_memory_mark(mark_memory)\n      Fs::write_bytes(output_path, bytes)\n      profile_memory_mark(mark_memory)\n      0\n    } with Error {\n      Throw(msg) => emit_compile_diag(output_path, msg)\n    }\n  }\n}\n")
}

let selfhost_source_201 = () -> (String, String) {
  ("lib/@vibe/compiler/cli_adapter_bundle.vibe",
"\n\nlet cli_adapter_empty_grouped_sources = () -> Array[(String, Array[(String, String)])] {\n  Array::slice([(\"\", Array::slice([(\"\", \"\")], 0, 0))], 0, 0)\n}\n\nlet cli_adapter_push_grouped_source_pair = (groups: Array[(String, Array[(String, String)])], group_name: String, pair: (String, String)) -> Unit {\n  let (path, source) = pair\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(groups) {\n    let (name, sources) = Array::get(groups, i)\n    if String::equals(name, group_name) {\n      Array::push(sources, (path, source))\n      found = true\n      i = Array::length(groups)\n    } else {\n      i = i + 1\n    }\n  }\n  if !found {\n    let sources = Array::slice([(\"\", \"\")], 0, 0)\n    Array::push(sources, (path, source))\n    Array::push(groups, (group_name, sources))\n  }\n}\n\nlet cli_adapter_source_0 = () -> (String, String) {\n  (\"lib/@vibe/ast/index.vpkg\",\n\"version 0.1.0\\n\\n// @vibe/ast — the vibe surface-syntax AST (ADR-0065 Phase 3, #753).\\n// The top level of this contract IS the package: the AST enums are\\n// TRANSPARENT type definitions (checker/codegen/printer pattern-match and\\n// construct them, so the definition itself is the public contract — changing\\n// a variant is a breaking change by construction). The implementation stub\\n// exists only so the explicit impl import suppresses sibling auto-discovery\\n// (tests beside this file must not join the facade).\\n//\\n// Node shapes deliberately expose the compiler's internal representation\\n// (e.g. the Int byte-offset slot on EIdent/ECall/EDot): this package is the\\n// compiler's own working AST, not an abstraction over it. Consumers that\\n// need stability should pin (#751).\\n\\nimport ./ast.vibe {}\\n\\nlet version: String\\n\\nexport enum Pat {\\n  PWild;\\n  PBind(String);\\n  PInt(Int);\\n  PFloat(Double);\\n  PString(String);\\n  PBool(Bool);\\n  PCtor(String, Array[Pat]);\\n  PTuple(Array[Pat]);\\n  POr(Pat, Pat);\\n  PStruct(String, Array[(String, Pat)])\\n}\\n\\nexport enum TypeExpr {\\n  TyName(String);\\n  TyApp(String, Array[TypeExpr]);\\n  TyFn(Array[TypeExpr], TypeExpr, Option[String]);\\n  TyTuple(Array[TypeExpr]);\\n  TyUnit\\n}\\n\\nexport enum Expr {\\n  EInt(Int);\\n  EFloat(Double);\\n  EString(String);\\n  EBool(Bool);\\n  EIdent(String, Int);\\n  ETuple(Array[Expr]);\\n  EArray(Array[Expr]);\\n  // #886: the third slot carries EXPLICIT struct type arguments\\n  // (`Pair[Int]::{ .. }`); empty for the inferred form (`Pair::{ .. }`,\\n  // #829's field-driven instantiation) and for anonymous `record { .. }`.\\n  ERecord(String, Array[(String, Expr)], Array[TypeExpr]);\\n  EIf(Expr, Expr, Expr);\\n  ELet(String, Expr, Expr, Int);\\n  ELetRec(String, Expr, Expr);\\n  ELetMut(String, Expr, Expr, Int);\\n  EAssign(String, Expr, Expr);\\n  EAssignOp(String, String, Expr, Expr);\\n  ESeq(Expr, Expr);\\n  EMatch(Expr, Array[(Pat, Expr)]);\\n  EHandle(Expr, Array[(Pat, Expr)]);\\n  EWhile(Expr, Expr);\\n  ELoop(Array[(String, Expr)], Expr);\\n  EForIn(String, Option[String], Expr, Expr);\\n  ECall(Expr, Array[Expr], Int);\\n  EBinOp(String, Expr, Expr);\\n  EUnaryOp(String, Expr);\\n  EFn(Array[String], Array[(String, Array[String])], Array[(String, Option[TypeExpr])], Option[TypeExpr], Option[String], Expr);\\n  EDot(Expr, String, Int, Int);\\n  ELabeledArg(String, String, Expr);\\n  EReturn(Expr);\\n  EBreak(Option[Expr]);\\n  EContinue(Array[Expr]);\\n  EMap(Array[(String, Expr)]);\\n  ESpread(Expr);\\n  EStringInterp(Array[String]);\\n  EUnit\\n}\\n\\nexport enum Stmt {\\n  SLet(Bool, Bool, String, Option[TypeExpr], Expr);\\n  SLetMut(String, Option[TypeExpr], Expr);\\n  SEnum(Bool, String, Array[String], Array[(String, Array[TypeExpr])], Array[String]);\\n  SSuberror(Bool, String, Array[(String, Array[TypeExpr])]);\\n  // #829: (exported, name, fields, derives, mut field names, type params).\\n  // Type params are APPENDED so positional matches of the older 5-field form\\n  // stay aligned.\\n  SStruct(Bool, String, Array[(String, TypeExpr)], Array[String], Array[String], Array[String]);\\n  STypeAlias(Bool, String, Array[String], TypeExpr);\\n  STrait(Bool, String, Array[String], Array[(String, Array[TypeExpr], TypeExpr)], Array[(String, Array[String], Array[(String, Array[String])])]);\\n  SImpl(Array[String], Array[(String, Array[String])], String, String);\\n  SExternLet(String, TypeExpr);\\n  SImport(String, Array[(String, Option[String])]);\\n  STest(String, Expr);\\n  SBench(String, Expr);\\n  SExpr(Expr);\\n  SExport(Array[String]);\\n  SReExport(String, Array[(String, Option[String])]);\\n  SAliasDecl(String, String);\\n  SLetPat(Pat, Expr);\\n  SModule(Bool, String, Array[Stmt]);\\n  SEffectDef(Bool, String, Array[String], Array[(String, Array[TypeExpr], TypeExpr)]);\\n  // ADR-0064 (#727/#731): a `fn` declaration kept in declaration form —\\n  // (exported, name, EFn value, requires conditions, ensures conditions).\\n  // The parser's default program entry points lower this to the legacy\\n  // `SLet(exported, true, name, None, EFn(..))` shape (contracts desugared\\n  // to runtime asserts) via lower_fn_decl_stmt BEFORE checker/codegen, so\\n  // only the printer / normalize (which parse with the *_preserving entry\\n  // points) ever see this constructor.\\n  SFnDecl(Bool, String, Expr, Array[Expr], Array[Expr])\\n}\\n\")\n}\n\nlet cli_adapter_source_1 = () -> (String, String) {\n  (\"lib/@vibe/ast/ast.vibe\",\n\"// @vibe/ast implementation stub (#753). The package's public surface is the\\n// transparent type definitions in index.vibei; this file carries the one\\n// declared value (version) and, as the explicit impl import target,\\n// suppresses sibling auto-discovery (test files beside the contract must\\n// not join the facade).\\n\\nexport let version: String = \\\"0.1.0\\\"\\n\")\n}\n\nlet cli_adapter_source_2 = () -> (String, String) {\n  (\"lib/@vibe/parser/index.vpkg\",\n\"version 0.1.0\\n\\n// @vibe/parser — the vibe lexer / parser / printer (ADR-0065 Phase 3, #753).\\n// Depends on @vibe/ast (the impl files import ../ast for the node types;\\n// Expr/Pat/Stmt/TypeExpr in the signatures below are those types). Token is\\n// a bodyless type declaration: the enum definition lives in token.vibe (the\\n// lexer/parser construct and match it, so a transparent contract definition\\n// would hit the impl-before-facade check order, #752 rule), and the facade\\n// re-exports it with ctors intact.\\n//\\n// The surface deliberately includes the parser-combinator primitives\\n// (peek/tk_name/parse_type/parse_fn_signature/...) — the compiler's contract\\n// engine, cst lowering, and editor tooling build on them, and conformance\\n// requires every `export let` of the impl files to be declared here.\\n\\nimport ./polyfill.vibe {}\\nimport ./token.vibe {}\\nimport ./float_format.vibe {}\\nimport ./lexer.vibe {}\\nimport ./parser_base.vibe {}\\nimport ./parser_expr_primary.vibe {}\\nimport ./parser_expr_core.vibe {}\\nimport ./parser_expr_dispatch.vibe {}\\nimport ./parser_expr.vibe {}\\nimport ./parser.vibe {}\\nimport ./expand_interp.vibe {}\\nimport ./printer.vibe {}\\n\\ntype Token\\n\\n// --- polyfill\\nlet version: String\\n\\n// --- token\\nfn token_to_string(t: Token) -> String\\n\\n// --- float_format\\nfn double_to_string_compiler(d: Double) -> String\\nfn parse_decimal_float(int_str: String, frac_str: String) -> Double\\n\\n// --- lexer\\nfn lex(src: String) -> Array[Token] with { Error }\\nfn lex_ok(src: String) -> Bool\\nfn lex_with_offsets(src: String) -> (Array[Token], Array[Int], Array[Int]) with { Error }\\nfn lex_with_offsets_recovering(src: String) -> (Array[Token], Array[Int], Array[Int], Array[Int], Array[String])\\nfn offset_to_line_col(src: String, offset: Int) -> (Int, Int)\\n\\n// --- parser_base\\nfn peek(tokens: Array[Token], pos: Int) -> Token\\nfn tk_name(t: Token) -> String\\nfn skip_semi(tokens: Array[Token], pos: Int) -> Int\\nfn parse_derive_names(tokens: Array[Token], pos: Int) -> (Array[String], Int) with { Error }\\nfn skip_derive(tokens: Array[Token], pos: Int) -> Int with { Error }\\nfn skip_braced_body(tokens: Array[Token], pos: Int) -> Int\\nfn collect_import_path(tokens: Array[Token], pos: Int, acc: String) -> (String, Int) with { Error }\\nfn parse_type(tokens: Array[Token], pos: Int) -> (TypeExpr, Int) with { Error }\\n\\n// --- parser_expr (+ primary/core/dispatch stages)\\nfn parse(tokens: Array[Token]) -> Expr with { Error }\\nfn parse_ok(tokens: Array[Token]) -> Bool\\nfn parse_expr(tokens: Array[Token], pos: Int) -> (Expr, Int) with { Error }\\nfn parse_impl(tokens: Array[Token], starts: Array[Int], pos: Int, min_prec: Int) -> (Expr, Int) with { Error }\\nfn parse_fn_signature(tokens: Array[Token], pos: Int) -> ((String, Array[String], Array[(String, Array[String])]), (Array[(String, Option[TypeExpr])], TypeExpr, Option[String]), (Array[Expr], Array[Expr]), Int) with { Error }\\nfn parse_primary(tokens: Array[Token], starts: Array[Int], pos: Int, k: (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error }\\nfn parse_infix(tokens: Array[Token], starts: Array[Int], pos: Int, min_prec: Int, depth: Int, k: (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error }\\nfn parse_infix_no_is(tokens: Array[Token], starts: Array[Int], pos: Int, min_prec: Int, depth: Int, k: (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error }\\nfn parse_impl_dispatch(tokens: Array[Token], starts: Array[Int], pos: Int, depth: Int, k: (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error }\\n\\n// --- parser_expr (fn-declaration lowering, ADR-0064 #727/#731)\\nfn lower_fn_decl_stmt(stmt: Stmt) -> Stmt\\nfn lower_fn_decl_stmts(stmts: Array[Stmt]) -> Array[Stmt]\\n\\n// --- parser\\nfn parse_stmt(tokens: Array[Token], starts: Array[Int], pos: Int) -> (Stmt, Int) with { Error }\\nfn parse_stmt_preserving(tokens: Array[Token], starts: Array[Int], pos: Int) -> (Stmt, Int) with { Error }\\nfn parse_program(tokens: Array[Token]) -> Array[Stmt] with { Error }\\nfn parse_program_preserving(tokens: Array[Token]) -> Array[Stmt] with { Error }\\nfn parse_program_located(tokens: Array[Token], starts: Array[Int], src: String) -> Array[Stmt] with { Error }\\nfn parse_program_recovering(tokens: Array[Token], starts: Array[Int], src: String) -> (Array[Stmt], Array[String]) with { Error }\\nfn parse_program_spans(tokens: Array[Token], starts: Array[Int], ends: Array[Int]) -> (Array[Stmt], Array[Int], Array[Int]) with { Error }\\n\\n// --- expand_interp\\nfn resolve_interp_expr(e: Expr) -> Expr with { Error }\\nfn resolve_interp_stmts(stmts: Array[Stmt]) -> Array[Stmt] with { Error }\\n\\n// --- printer\\nfn print_pat(p: Pat) -> String\\nfn print_type_expr(t: TypeExpr) -> String\\nfn print_expr(e: Expr) -> String\\nfn print_stmt(s: Stmt) -> String\\nfn print_program(stmts: Array[Stmt]) -> String\\n\")\n}\n\nlet cli_adapter_source_3 = () -> (String, String) {\n  (\"lib/@vibe/parser/polyfill.vibe\",\n\"// @vibe/parser-private int-to-string polyfill (#753). A verbatim copy of the\\n// compiler's core/polyfill.vibe __to_string: the parser package cannot\\n// depend on compiler internals, and the printer/token error paths need it.\\n// Private via the bare export block (a contract-undeclared `export let`\\n// would be a conformance violation); version is the declared contract value.\\n\\nfn __to_string(n: Int) -> String {\\n  if n == 0 {\\n    \\\"0\\\"\\n  } else {\\n    let mut val = n\\n    let mut neg = false\\n    if val < 0 {\\n      neg = true\\n      val = 0 - val\\n    }\\n    let digits = Array::slice([\\n      \\\"\\\"\\n    ], 0, 0)\\n    while val > 0 {\\n      let d = val - (val / 10) * 10\\n      let ch = if d == 0 {\\n        \\\"0\\\"\\n      }\\n      else if d == 1 {\\n        \\\"1\\\"\\n      }\\n      else if d == 2 {\\n        \\\"2\\\"\\n      }\\n      else if d == 3 {\\n        \\\"3\\\"\\n      }\\n      else if d == 4 {\\n        \\\"4\\\"\\n      }\\n      else if d == 5 {\\n        \\\"5\\\"\\n      }\\n      else if d == 6 {\\n        \\\"6\\\"\\n      }\\n      else if d == 7 {\\n        \\\"7\\\"\\n      }\\n      else if d == 8 {\\n        \\\"8\\\"\\n      }\\n      else {\\n        \\\"9\\\"\\n      }\\n      Array::push(digits, ch)\\n      val = val / 10\\n    }\\n    let mut result = if neg {\\n      \\\"-\\\"\\n    } else {\\n      \\\"\\\"\\n    }\\n    let mut i = Array::length(digits) - 1\\n    while i >= 0 {\\n      result = String::concat(result, Array::get(digits, i))\\n      i = i - 1\\n    }\\n    result\\n  }\\n}\\n\\nexport let version: String = \\\"0.1.0\\\"\\n\\nexport {\\n  __to_string\\n}\\n\")\n}\n\nlet cli_adapter_source_4 = () -> (String, String) {\n  (\"lib/@vibe/parser/token.vibe\",\n\"//# Imports\\n\\nimport ./polyfill.vibe {\\n  __to_string\\n}\\n\\nimport ./float_format.vibe {\\n  double_to_string_compiler\\n}\\n\\n//# Types\\n\\nexport enum Token {\\n  TInt(Int);\\n  TFloat(Double);\\n  TString(String);\\n  TIdent(String);\\n  TLet;\\n  TRec;\\n  TMut;\\n  TFn;\\n  TIf;\\n  TElse;\\n  TMatch;\\n  TIs;\\n  TDo;\\n  TEnum;\\n  TStruct;\\n  TType;\\n  TTrait;\\n  TImpl;\\n  TExport;\\n  TTest;\\n  TWhile;\\n  TFor;\\n  TIn;\\n  TLoop;\\n  TBreak;\\n  TContinue;\\n  TReturn;\\n  TWith;\\n  THandle;\\n  TThrow;\\n  TRaise;\\n  TYield;\\n  TBench;\\n  TDeclare;\\n  TAs;\\n  TModule;\\n  TSuberror;\\n  TDerive;\\n  TOpen;\\n  TImport;\\n  TPlus;\\n  TMinus;\\n  TStar;\\n  TSlash;\\n  TPercent;\\n  TEqEq;\\n  TNeq;\\n  TLt;\\n  TLte;\\n  TGt;\\n  TGte;\\n  TAnd;\\n  TOr;\\n  TNot;\\n  TBitAnd;\\n  TBitOr;\\n  TBitXor;\\n  TLShift;\\n  TRShift;\\n  TPipeGt;\\n  TArrow;\\n  TThinArrow;\\n  TEq;\\n  TDot;\\n  TColon;\\n  TDoubleColon;\\n  TComma;\\n  TSemicolon;\\n  THash;\\n  TTilde;\\n  TQuestion;\\n  TPlusEq;\\n  TMinusEq;\\n  TStarEq;\\n  TSlashEq;\\n  TPercentEq;\\n  TLParen;\\n  TRParen;\\n  TLBrace;\\n  TRBrace;\\n  TLBracket;\\n  TRBracket;\\n  TDotDot;\\n  TDotDotDot;\\n  // #947: the second array carries, in lockstep with `parts`, the ABSOLUTE\\n  // source offset of each part's start (odd indices = embedded expression\\n  // fragments, the ones that matter; even/literal indices carry -1, unused).\\n  // Without this, re-lexing a fragment in isolation (build_interp_expr)\\n  // produces offsets relative to the fragment (starting at 0), so hovering an\\n  // identifier inside `\\\\{...}` used to resolve to a bogus span at the file\\n  // start instead of the identifier's real location.\\n  TStringInterp(Array[String], Array[Int]);\\n  TEof\\n}\\n\\n//# Functions\\n\\nexport fn token_to_string(t: Token) -> String {\\n  match t {\\n    TInt(n) => String::concat(\\\"TInt(\\\", String::concat(__to_string(n), \\\")\\\")),\\n    TFloat(n) =>\\n    String::concat(\\\"TFloat(\\\", String::concat(double_to_string_compiler(n), \\\")\\\")),\\n    TString(s) => String::concat(\\\"TString(\\\\\\\"\\\", String::concat(s, \\\"\\\\\\\")\\\")),\\n    TIdent(s) => String::concat(\\\"TIdent(\\\", String::concat(s, \\\")\\\")),\\n    TLet => \\\"TLet\\\",\\n    TRec => \\\"TRec\\\",\\n    TMut => \\\"TMut\\\",\\n    TFn => \\\"TFn\\\",\\n    TIf => \\\"TIf\\\",\\n    TElse => \\\"TElse\\\",\\n    TMatch => \\\"TMatch\\\",\\n    TIs => \\\"TIs\\\",\\n    TDo => \\\"TDo\\\",\\n    TEnum => \\\"TEnum\\\",\\n    TStruct => \\\"TStruct\\\",\\n    TType => \\\"TType\\\",\\n    TTrait => \\\"TTrait\\\",\\n    TImpl => \\\"TImpl\\\",\\n    TExport => \\\"TExport\\\",\\n    TTest => \\\"TTest\\\",\\n    TWhile => \\\"TWhile\\\",\\n    TFor => \\\"TFor\\\",\\n    TIn => \\\"TIn\\\",\\n    TLoop => \\\"TLoop\\\",\\n    TBreak => \\\"TBreak\\\",\\n    TContinue => \\\"TContinue\\\",\\n    TReturn => \\\"TReturn\\\",\\n    TWith => \\\"TWith\\\",\\n    THandle => \\\"THandle\\\",\\n    TThrow => \\\"TThrow\\\",\\n    TRaise => \\\"TRaise\\\",\\n    TYield => \\\"TYield\\\",\\n    TBench => \\\"TBench\\\",\\n    TDeclare => \\\"TDeclare\\\",\\n    TAs => \\\"TAs\\\",\\n    TModule => \\\"TModule\\\",\\n    TSuberror => \\\"TSuberror\\\",\\n    TDerive => \\\"TDerive\\\",\\n    TOpen => \\\"TOpen\\\",\\n    TImport => \\\"TImport\\\",\\n    TPlus => \\\"TPlus\\\",\\n    TMinus => \\\"TMinus\\\",\\n    TStar => \\\"TStar\\\",\\n    TSlash => \\\"TSlash\\\",\\n    TPercent => \\\"TPercent\\\",\\n    TEqEq => \\\"TEqEq\\\",\\n    TNeq => \\\"TNeq\\\",\\n    TLt => \\\"TLt\\\",\\n    TLte => \\\"TLte\\\",\\n    TGt => \\\"TGt\\\",\\n    TGte => \\\"TGte\\\",\\n    TAnd => \\\"TAnd\\\",\\n    TOr => \\\"TOr\\\",\\n    TNot => \\\"TNot\\\",\\n    TBitAnd => \\\"TBitAnd\\\",\\n    TBitOr => \\\"TBitOr\\\",\\n    TBitXor => \\\"TBitXor\\\",\\n    TLShift => \\\"TLShift\\\",\\n    TRShift => \\\"TRShift\\\",\\n    TPipeGt => \\\"TPipeGt\\\",\\n    TArrow => \\\"TArrow\\\",\\n    TThinArrow => \\\"TThinArrow\\\",\\n    TEq => \\\"TEq\\\",\\n    TDot => \\\"TDot\\\",\\n    TColon => \\\"TColon\\\",\\n    TDoubleColon => \\\"TDoubleColon\\\",\\n    TComma => \\\"TComma\\\",\\n    TSemicolon => \\\"TSemicolon\\\",\\n    THash => \\\"THash\\\",\\n    TTilde => \\\"TTilde\\\",\\n    TQuestion => \\\"TQuestion\\\",\\n    TPlusEq => \\\"TPlusEq\\\",\\n    TMinusEq => \\\"TMinusEq\\\",\\n    TStarEq => \\\"TStarEq\\\",\\n    TSlashEq => \\\"TSlashEq\\\",\\n    TPercentEq => \\\"TPercentEq\\\",\\n    TLParen => \\\"TLParen\\\",\\n    TRParen => \\\"TRParen\\\",\\n    TLBrace => \\\"TLBrace\\\",\\n    TRBrace => \\\"TRBrace\\\",\\n    TLBracket => \\\"TLBracket\\\",\\n    TRBracket => \\\"TRBracket\\\",\\n    TDotDot => \\\"TDotDot\\\",\\n    TDotDotDot => \\\"TDotDotDot\\\",\\n    TStringInterp(_, _) => \\\"TStringInterp\\\",\\n    TEof => \\\"TEof\\\"\\n  }\\n}\\n\")\n}\n\nlet cli_adapter_source_5 = () -> (String, String) {\n  (\"lib/@vibe/parser/float_format.vibe\",\n\"//# Imports\\n\\nimport ./polyfill.vibe {\\n  __to_string\\n}\\n\\n//# Functions\\n\\n// ---- #956: correctly-rounded decimal -> Double literal construction ----\\n//\\n// Float literals used to funnel their integer digits through the 62-bit\\n// tagged Int (`parse_int_from_string`, which silently wraps past ~2.3e18) and\\n// their fraction through a per-digit `d / scale` sum (one rounding error per\\n// digit). `parse_decimal_float` below instead builds the IEEE-754 nearest\\n// Double of the decimal digit string:\\n//   - <= 15 significant digits and |exp10| <= 22: exact fast path (mantissa\\n//     exact in Int -> Double, power of ten exact through 1e22, one rounding).\\n//   - otherwise: accumulate up to 31 significant digits exactly in a\\n//     double-double (hi/lo) value, apply the decimal exponent with dd\\n//     multiplies/divides at power-of-two-rescaled magnitudes so nothing\\n//     overflows/underflows mid-computation, and round once at the end\\n//     (explicit ties-to-even handling on the subnormal grid).\\n// Literals with more than 31 significant digits are correctly rounded unless\\n// the discarded tail straddles a rounding boundary (error <= 1 ulp there;\\n// exact decimal expansions of doubles always round-trip bit-identically\\n// because a representable value sits half an ulp from any boundary).\\n\\n// NOTE on style: the whole algorithm is written as ONE function over `let\\n// mut` locals rooted at float literals, with every float binop containing a\\n// tracked-floatish operand, and NO user-fn calls inside float arithmetic.\\n// The linear/RC backends classify float ops syntactically (#772/#797:\\n// `expr_is_floatish`); helper functions returning Doubles / annotated lets\\n// bound to calls are NOT recognized and silently miscompile to integer ops\\n// (verified while fixing #956), so do not refactor this into small helpers.\\n\\nexport fn parse_decimal_float(int_str: String, frac_str: String) -> Double {\\n  let flen = String::length(frac_str)\\n  let all = String::concat(int_str, frac_str)\\n  let total = String::length(all)\\n  let mut exp10 = 0 - flen\\n  let mut start = 0\\n  while start < total - 1 && String::char_code_at(all, start) == '0' {\\n    start = start + 1\\n  }\\n  let mut end = total\\n  while end - start > 1 && String::char_code_at(all, end - 1) == '0' {\\n    end = end - 1\\n    exp10 = exp10 + 1\\n  }\\n  if String::char_code_at(all, start) == '0' {\\n    0.0\\n  } else {\\n    let nsig = end - start\\n    if nsig <= 15 && exp10 + 22 >= 0 && exp10 <= 22 {\\n      let mut m = 0\\n      let mut k = start\\n      while k < end {\\n        m = m * 10 + (String::char_code_at(all, k) - 48)\\n        k = k + 1\\n      }\\n      let mut pw = 1.0\\n      let mut pj = 0\\n      let pe = if exp10 >= 0 {\\n        exp10\\n      } else {\\n        0 - exp10\\n      }\\n      while pj < pe {\\n        pw = pw * 10.0\\n        pj = pj + 1\\n      }\\n      if exp10 >= 0 {\\n        Int::to_double(m) * pw\\n      } else {\\n        Int::to_double(m) / pw\\n      }\\n    } else {\\n      let mut hi = 0.0\\n      let mut lo = 0.0\\n      let mut tp = 0.0\\n      let mut tc = 0.0\\n      let mut terr = 0.0\\n      let mut ah = 0.0\\n      let mut al = 0.0\\n      let mut bh = 0.0\\n      let mut bl = 0.0\\n      let mut td = 0.0\\n      let mut ph = 0.0\\n      let mut pl = 0.0\\n      let mut psmall = 0.0\\n      let mut mph = 0.0\\n      let mut mpl = 0.0\\n      let mut tneg = 0.0\\n      let mut q1 = 0.0\\n      let mut q2 = 0.0\\n      let mut p22 = 1.0\\n      let mut p22i = 0\\n      while p22i < 22 {\\n        p22 = p22 * 10.0\\n        p22i = p22i + 1\\n      }\\n      let mut absorb = 0\\n      while exp10 > 0 && nsig + absorb < 31 {\\n        absorb = absorb + 1\\n        exp10 = exp10 - 1\\n      }\\n      let mut used = 0\\n      let mut sticky = false\\n      let mut k = start\\n      let mut phase = 0\\n      while phase < 2 {\\n        let dostep = if phase == 0 {\\n          k < end\\n        } else {\\n          k < absorb\\n        }\\n        if dostep {\\n          let dig = if phase == 0 {\\n            String::char_code_at(all, k) - 48\\n          } else {\\n            0\\n          }\\n          if phase == 1 || used < 31 {\\n            // (hi, lo) = dd_mul_d(hi, lo, 10.0)\\n            td = 10.0\\n            tp = hi * (td * 1.0)\\n            tc = 134217729.0 * hi\\n            ah = tc - (tc - hi * 1.0)\\n            al = hi - ah * 1.0\\n            tc = 134217729.0 * td\\n            bh = tc - (tc - td * 1.0)\\n            bl = td - bh * 1.0\\n            terr = ((ah * (bh * 1.0) - tp) + ah * (bl * 1.0) + al * (bh * 1.0)) + al * (bl * 1.0)\\n            terr = terr + lo * (td * 1.0)\\n            hi = tp + terr * 1.0\\n            lo = terr - (hi - tp * 1.0)\\n            if phase == 0 {\\n              // (hi, lo) = dd_add_d(hi, lo, dig)\\n              td = Int::to_double(dig)\\n              tp = hi + td * 1.0\\n              tc = tp - hi * 1.0\\n              terr = (hi - (tp - tc * 1.0)) + (td - tc * 1.0)\\n              terr = terr + lo * 1.0\\n              hi = tp + terr * 1.0\\n              lo = terr - (hi - tp * 1.0)\\n            } else {\\n              ()\\n            }\\n            used = used + 1\\n          } else {\\n            exp10 = exp10 + 1\\n            if dig != 0 {\\n              sticky = true\\n            } else {\\n              ()\\n            }\\n          }\\n          k = k + 1\\n        } else {\\n          phase = phase + 1\\n          k = if phase == 1 {\\n            0\\n          } else {\\n            k\\n          }\\n        }\\n      }\\n      if sticky {\\n        // (hi, lo) = dd_add_d(hi, lo, 0.5)\\n        td = 0.5\\n        tp = hi + td * 1.0\\n        tc = tp - hi * 1.0\\n        terr = (hi - (tp - tc * 1.0)) + (td - tc * 1.0)\\n        terr = terr + lo * 1.0\\n        hi = tp + terr * 1.0\\n        lo = terr - (hi - tp * 1.0)\\n      } else {\\n        ()\\n      }\\n      let e_dec = exp10 + used - 1\\n      if e_dec > 308 {\\n        let mut infv = 1.0\\n        let mut infi = 0\\n        while infi < 1100 {\\n          infv = infv * 2.0\\n          infi = infi + 1\\n        }\\n        infv\\n      } else if e_dec + 324 < 0 {\\n        0.0\\n      } else if exp10 > 0 {\\n        // ---- positive decimal exponent ----\\n        let big = exp10 > 270\\n        let e_first = if big {\\n          exp10 - 270\\n        } else {\\n          exp10\\n        }\\n        // (ph, pl) = dd 10^e_first\\n        ph = 1.0\\n        pl = 0.0\\n        let mut ke = e_first\\n        while ke > 22 {\\n          tp = ph * (p22 * 1.0)\\n          tc = 134217729.0 * ph\\n          ah = tc - (tc - ph * 1.0)\\n          al = ph - ah * 1.0\\n          tc = 134217729.0 * p22\\n          bh = tc - (tc - p22 * 1.0)\\n          bl = p22 - bh * 1.0\\n          terr = ((ah * (bh * 1.0) - tp) + ah * (bl * 1.0) + al * (bh * 1.0)) + al * (bl * 1.0)\\n          terr = terr + pl * (p22 * 1.0)\\n          ph = tp + terr * 1.0\\n          pl = terr - (ph - tp * 1.0)\\n          ke = ke - 22\\n        }\\n        psmall = 1.0\\n        while ke > 0 {\\n          psmall = psmall * 10.0\\n          ke = ke - 1\\n        }\\n        tp = ph * (psmall * 1.0)\\n        tc = 134217729.0 * ph\\n        ah = tc - (tc - ph * 1.0)\\n        al = ph - ah * 1.0\\n        tc = 134217729.0 * psmall\\n        bh = tc - (tc - psmall * 1.0)\\n        bl = psmall - bh * 1.0\\n        terr = ((ah * (bh * 1.0) - tp) + ah * (bl * 1.0) + al * (bh * 1.0)) + al * (bl * 1.0)\\n        terr = terr + pl * (psmall * 1.0)\\n        ph = tp + terr * 1.0\\n        pl = terr - (ph - tp * 1.0)\\n        // (hi, lo) = dd_mul_dd(hi, lo, ph, pl)\\n        tp = hi * (ph * 1.0)\\n        tc = 134217729.0 * hi\\n        ah = tc - (tc - hi * 1.0)\\n        al = hi - ah * 1.0\\n        tc = 134217729.0 * ph\\n        bh = tc - (tc - ph * 1.0)\\n        bl = ph - bh * 1.0\\n        terr = ((ah * (bh * 1.0) - tp) + ah * (bl * 1.0) + al * (bh * 1.0)) + al * (bl * 1.0)\\n        terr = terr + (hi * (pl * 1.0) + lo * (ph * 1.0))\\n        hi = tp + terr * 1.0\\n        lo = terr - (hi - tp * 1.0)\\n        if big {\\n          // scale to 2^-128, multiply by 10^270, rescale exactly with an\\n          // explicit overflow-boundary compare (B*2^-128 = 2^896 - 2^842)\\n          let mut p128 = 1.0\\n          let mut p128i = 0\\n          while p128i < 128 {\\n            p128 = p128 * 2.0\\n            p128i = p128i + 1\\n          }\\n          let inv128 = 1.0 / p128\\n          hi = hi * (inv128 * 1.0)\\n          lo = lo * (inv128 * 1.0)\\n          // (ph, pl) = dd 10^270\\n          ph = 1.0\\n          pl = 0.0\\n          let mut ke2 = 270\\n          while ke2 > 22 {\\n            tp = ph * (p22 * 1.0)\\n            tc = 134217729.0 * ph\\n            ah = tc - (tc - ph * 1.0)\\n            al = ph - ah * 1.0\\n            tc = 134217729.0 * p22\\n            bh = tc - (tc - p22 * 1.0)\\n            bl = p22 - bh * 1.0\\n            terr = ((ah * (bh * 1.0) - tp) + ah * (bl * 1.0) + al * (bh * 1.0)) + al * (bl * 1.0)\\n            terr = terr + pl * (p22 * 1.0)\\n            ph = tp + terr * 1.0\\n            pl = terr - (ph - tp * 1.0)\\n            ke2 = ke2 - 22\\n          }\\n          psmall = 1.0\\n          while ke2 > 0 {\\n            psmall = psmall * 10.0\\n            ke2 = ke2 - 1\\n          }\\n          tp = ph * (psmall * 1.0)\\n          tc = 134217729.0 * ph\\n          ah = tc - (tc - ph * 1.0)\\n          al = ph - ah * 1.0\\n          tc = 134217729.0 * psmall\\n          bh = tc - (tc - psmall * 1.0)\\n          bl = psmall - bh * 1.0\\n          terr = ((ah * (bh * 1.0) - tp) + ah * (bl * 1.0) + al * (bh * 1.0)) + al * (bl * 1.0)\\n          terr = terr + pl * (psmall * 1.0)\\n          ph = tp + terr * 1.0\\n          pl = terr - (ph - tp * 1.0)\\n          // (hi, lo) = dd_mul_dd(hi, lo, ph, pl)\\n          tp = hi * (ph * 1.0)\\n          tc = 134217729.0 * hi\\n          ah = tc - (tc - hi * 1.0)\\n          al = hi - ah * 1.0\\n          tc = 134217729.0 * ph\\n          bh = tc - (tc - ph * 1.0)\\n          bl = ph - bh * 1.0\\n          terr = ((ah * (bh * 1.0) - tp) + ah * (bl * 1.0) + al * (bh * 1.0)) + al * (bl * 1.0)\\n          terr = terr + (hi * (pl * 1.0) + lo * (ph * 1.0))\\n          hi = tp + terr * 1.0\\n          lo = terr - (hi - tp * 1.0)\\n          let mut b1 = 1.0\\n          let mut b1i = 0\\n          while b1i < 896 {\\n            b1 = b1 * 2.0\\n            b1i = b1i + 1\\n          }\\n          let mut b2 = 1.0\\n          let mut b2i = 0\\n          while b2i < 842 {\\n            b2 = b2 * 2.0\\n            b2i = b2i + 1\\n          }\\n          if hi > b1 * 1.0 || (hi == b1 * 1.0 && lo >= 0.0 - b2) {\\n            let mut infv2 = 1.0\\n            let mut infi2 = 0\\n            while infi2 < 1100 {\\n              infv2 = infv2 * 2.0\\n              infi2 = infi2 + 1\\n            }\\n            infv2\\n          } else {\\n            hi * (p128 * 1.0) + lo * (p128 * 1.0)\\n          }\\n        } else {\\n          hi + lo * 1.0\\n        }\\n      } else if exp10 < 0 {\\n        // ---- negative decimal exponent: work at scale 2^660 ----\\n        let mut p = 0 - exp10\\n        let mut s660 = 1.0\\n        let mut s660i = 0\\n        while s660i < 660 {\\n          s660 = s660 * 2.0\\n          s660i = s660i + 1\\n        }\\n        hi = hi * (s660 * 1.0)\\n        lo = lo * (s660 * 1.0)\\n        let mut divs = if p > 292 {\\n          2\\n        } else {\\n          1\\n        }\\n        if divs == 2 {\\n          p = p - 146\\n        } else {\\n          ()\\n        }\\n        while divs > 0 {\\n          let e_div = if divs == 2 {\\n            146\\n          } else {\\n            p\\n          }\\n          // (ph, pl) = dd 10^e_div\\n          ph = 1.0\\n          pl = 0.0\\n          let mut ke3 = e_div\\n          while ke3 > 22 {\\n            tp = ph * (p22 * 1.0)\\n            tc = 134217729.0 * ph\\n            ah = tc - (tc - ph * 1.0)\\n            al = ph - ah * 1.0\\n            tc = 134217729.0 * p22\\n            bh = tc - (tc - p22 * 1.0)\\n            bl = p22 - bh * 1.0\\n            terr = ((ah * (bh * 1.0) - tp) + ah * (bl * 1.0) + al * (bh * 1.0)) + al * (bl * 1.0)\\n            terr = terr + pl * (p22 * 1.0)\\n            ph = tp + terr * 1.0\\n            pl = terr - (ph - tp * 1.0)\\n            ke3 = ke3 - 22\\n          }\\n          psmall = 1.0\\n          while ke3 > 0 {\\n            psmall = psmall * 10.0\\n            ke3 = ke3 - 1\\n          }\\n          tp = ph * (psmall * 1.0)\\n          tc = 134217729.0 * ph\\n          ah = tc - (tc - ph * 1.0)\\n          al = ph - ah * 1.0\\n          tc = 134217729.0 * psmall\\n          bh = tc - (tc - psmall * 1.0)\\n          bl = psmall - bh * 1.0\\n          terr = ((ah * (bh * 1.0) - tp) + ah * (bl * 1.0) + al * (bh * 1.0)) + al * (bl * 1.0)\\n          terr = terr + pl * (psmall * 1.0)\\n          ph = tp + terr * 1.0\\n          pl = terr - (ph - tp * 1.0)\\n          // (hi, lo) = dd_div_dd(hi, lo, ph, pl)\\n          q1 = hi / (ph * 1.0)\\n          tp = ph * (q1 * 1.0)\\n          tc = 134217729.0 * ph\\n          ah = tc - (tc - ph * 1.0)\\n          al = ph - ah * 1.0\\n          tc = 134217729.0 * q1\\n          bh = tc - (tc - q1 * 1.0)\\n          bl = q1 - bh * 1.0\\n          terr = ((ah * (bh * 1.0) - tp) + ah * (bl * 1.0) + al * (bh * 1.0)) + al * (bl * 1.0)\\n          terr = terr + pl * (q1 * 1.0)\\n          mph = tp + terr * 1.0\\n          mpl = terr - (mph - tp * 1.0)\\n          tneg = 0.0 - mph\\n          tp = hi + tneg * 1.0\\n          tc = tp - hi * 1.0\\n          terr = (hi - (tp - tc * 1.0)) + (tneg - tc * 1.0)\\n          terr = terr + lo * 1.0 - mpl\\n          q2 = (tp + terr * 1.0) / ph\\n          hi = q1 + q2 * 1.0\\n          lo = q2 - (hi - q1 * 1.0)\\n          divs = divs - 1\\n        }\\n        let mut mns = 1.0\\n        let mut mnsi = 0\\n        while mnsi < 362 {\\n          mns = mns * 0.5\\n          mnsi = mnsi + 1\\n        }\\n        let inv660 = 1.0 / s660\\n        if hi >= mns * 1.0 {\\n          hi * (inv660 * 1.0)\\n        } else {\\n          let r0 = hi * (inv660 * 1.0)\\n          let back = r0 * (s660 * 1.0)\\n          let rem = (hi - back * 1.0) + lo * 1.0\\n          let mut half = 1.0\\n          let mut halfi = 0\\n          while halfi < 415 {\\n            half = half * 0.5\\n            halfi = halfi + 1\\n          }\\n          let mut h537 = 1.0\\n          let mut h537i = 0\\n          while h537i < 537 {\\n            h537 = h537 * 0.5\\n            h537i = h537i + 1\\n          }\\n          let minsub = h537 * (h537 * 1.0)\\n          if rem > half * 1.0 {\\n            r0 + minsub * 1.0\\n          } else if rem < 0.0 - half {\\n            r0 - minsub * 1.0\\n          } else if rem == half * 1.0 || rem == 0.0 - half {\\n            let mut d537 = 1.0\\n            let mut d537i = 0\\n            while d537i < 537 {\\n              d537 = d537 * 2.0\\n              d537i = d537i + 1\\n            }\\n            let kunits = r0 * (d537 * 1.0) * (d537 * 1.0)\\n            if Double::to_int(kunits) % 2 == 1 {\\n              if rem > 0.0 {\\n                r0 + minsub * 1.0\\n              } else {\\n                r0 - minsub * 1.0\\n              }\\n            } else {\\n              r0\\n            }\\n          } else {\\n            r0\\n          }\\n        }\\n      } else {\\n        hi + lo * 1.0\\n      }\\n    }\\n  }\\n}\\n\\n// ---- #956: exact decimal printing for doubles past the Int range ----\\n//\\n// `double_to_string_compiler` used `Double::to_int` on the integer part,\\n// which breaks past 2^61. For such values (all of which are exact integers —\\n// every double >= 2^53 is) we print the EXACT decimal expansion instead:\\n// halve the value into the Int-safe range (exact), take the mantissa digits,\\n// and double the decimal digit array back up. The exact expansion re-parses\\n// bit-identically under `parse_decimal_float`.\\n\\nfn big_double_exact_int_decimal(abs_d: Double) -> String {\\n  // 2^61 built by doubling a tracked literal-rooted mut (see the style NOTE\\n  // above parse_decimal_float — annotated lets / big literals miscompile).\\n  let mut two_61 = 1.0\\n  let mut t61i = 0\\n  while t61i < 61 {\\n    two_61 = two_61 * 2.0\\n    t61i = t61i + 1\\n  }\\n  let mut x = abs_d\\n  let mut halvings = 0\\n  // int-condition loop: a float-compare `while` condition miscompiles in the\\n  // imported-module lane (see style NOTE above parse_decimal_float); the\\n  // equivalent `if` compare inside an int-condition loop compiles correctly.\\n  let mut halving_go = 1\\n  while halving_go == 1 {\\n    if x >= two_61 * 1.0 {\\n      x = x * 0.5\\n      halvings = halvings + 1\\n    } else {\\n      halving_go = 0\\n    }\\n  }\\n  let m = Double::to_int(x)\\n  let ms = __to_string(m)\\n  let mlen = String::length(ms)\\n  // decimal digits, least-significant first (finite doubles need <= 309)\\n  let digits = Int64Array::make(340, 0)\\n  let mut i = 0\\n  while i < mlen {\\n    Int64Array::set(digits, i, String::char_code_at(ms, mlen - 1 - i) - 48)\\n    i = i + 1\\n  }\\n  let mut ndig = mlen\\n  let mut h = 0\\n  while h < halvings {\\n    let mut carry = 0\\n    let mut j = 0\\n    while j < ndig {\\n      let v = Int64Array::get(digits, j) * 2 + carry\\n      Int64Array::set(digits, j, v % 10)\\n      carry = v / 10\\n      j = j + 1\\n    }\\n    if carry > 0 {\\n      Int64Array::set(digits, ndig, carry)\\n      ndig = ndig + 1\\n    }\\n    h = h + 1\\n  }\\n  let b = ArrayBuilder::new()\\n  let mut j2 = ndig - 1\\n  while j2 >= 0 {\\n    ArrayBuilder::push(b, String::from_char_code(Int64Array::get(digits, j2) + 48))\\n    j2 = j2 - 1\\n  }\\n  String::join(ArrayBuilder::freeze(b), \\\"\\\")\\n}\\n\\nfn pos_inf_decimal_string() -> String {\\n  // 10^309 overflows every double, so this re-parses to +inf\\n  let b = ArrayBuilder::new()\\n  ArrayBuilder::push(b, \\\"1\\\")\\n  let mut i = 0\\n  while i < 309 {\\n    ArrayBuilder::push(b, \\\"0\\\")\\n    i = i + 1\\n  }\\n  String::join(ArrayBuilder::freeze(b), \\\"\\\")\\n}\\n\\nfn zero_pad_6(n: Int) -> String {\\n  let s = __to_string(n)\\n  let len = String::length(s)\\n  if len >= 6 {\\n    s\\n  } else {\\n    let mut out = \\\"\\\"\\n    let mut i = len\\n    while i < 6 {\\n      out = String::concat(out, \\\"0\\\")\\n      i = i + 1\\n    }\\n    String::concat(out, s)\\n  }\\n}\\n\\nfn trim_trailing_zeros(s: String) -> String {\\n  let mut end = String::length(s)\\n  while end > 0 && String::char_code_at(s, end - 1) == 48 {\\n    end = end - 1\\n  }\\n  if end <= 0 {\\n    \\\"\\\"\\n  } else {\\n    s[0: end]\\n  }\\n}\\n\\nexport fn double_to_string_compiler(d: Double) -> String {\\n  if d != d {\\n    \\\"nan\\\"\\n  } else {\\n    let neg = d < 0.0\\n    let abs_d = if neg {\\n      0.0 - d\\n    } else {\\n      d\\n    }\\n    let mut two_61 = 1.0\\n    let mut t61i = 0\\n    while t61i < 61 {\\n      two_61 = two_61 * 2.0\\n      t61i = t61i + 1\\n    }\\n    if abs_d >= two_61 * 1.0 {\\n      // #956: Double::to_int overflows past 2^61 — print the exact decimal\\n      // expansion instead (re-parses bit-identically; infinities print as\\n      // 10^309, which re-parses to inf).\\n      let body = if abs_d * 0.5 == abs_d {\\n        pos_inf_decimal_string()\\n      } else {\\n        big_double_exact_int_decimal(abs_d)\\n      }\\n      if neg {\\n        String::concat(\\\"-\\\", body)\\n      } else {\\n        body\\n      }\\n    } else {\\n    let int_part = Double::to_int(abs_d)\\n    let frac = abs_d - Int::to_double(int_part)\\n    let scaled_raw = Double::to_int(frac * 1000000.0 + 0.5)\\n    let int_norm = if scaled_raw == 1000000 {\\n      int_part + 1\\n    } else {\\n      int_part\\n    }\\n    let frac_norm = if scaled_raw == 1000000 {\\n      0\\n    } else {\\n      scaled_raw\\n    }\\n    let int_s = __to_string(int_norm)\\n    let frac_s = if frac_norm == 0 {\\n      \\\"\\\"\\n    } else {\\n      trim_trailing_zeros(zero_pad_6(frac_norm))\\n    }\\n    let body = if String::length(frac_s) == 0 {\\n      int_s\\n    } else {\\n      String::concat(int_s, String::concat(\\\".\\\", frac_s))\\n    }\\n    if neg {\\n      String::concat(\\\"-\\\", body)\\n    } else {\\n      body\\n    }\\n    }\\n  }\\n}\\n\")\n}\n\nlet cli_adapter_source_6 = () -> (String, String) {\n  (\"lib/@vibe/parser/lexer.vibe\",\n\"//# Imports\\n\\nimport ./token.vibe {\\n  Token\\n}\\n\\nimport ./float_format.vibe {\\n  parse_decimal_float\\n}\\n\\n//# Functions\\n\\nfn is_ws(c: Int) -> Bool {\\n  c == ' ' || c == '\\\\n' || c == '\\\\t' || c == '\\\\r'\\n}\\n\\nfn is_alpha(c: Int) -> Bool {\\n  (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == '_'\\n}\\n\\nfn is_digit(c: Int) -> Bool {\\n  c >= '0' && c <= '9'\\n}\\n\\nfn is_alnum(c: Int) -> Bool {\\n  is_alpha(c) || is_digit(c)\\n}\\n\\nfn lex_char(s: String, len: Int, i: Int) -> (Token, Int) with { Error } {\\n  let start = i + 1\\n  if start >= len {\\n    throw(\\\"unterminated char literal\\\")\\n  }\\n  let c = String::char_code_at(s, start)\\n  if c == '\\\\\\\\' {\\n    let esc_pos = start + 1\\n    if esc_pos >= len {\\n      throw(\\\"unterminated char escape\\\")\\n    }\\n    let esc = String::char_code_at(s, esc_pos)\\n    let val = if esc == 'n' {\\n      10\\n    }\\n    else if esc == 't' {\\n      9\\n    }\\n    else if esc == 'r' {\\n      13\\n    }\\n    else if esc == '\\\\\\\\' {\\n      92\\n    }\\n    else if esc == '\\\\'' {\\n      39\\n    }\\n    else if esc == '0' {\\n      0\\n    }\\n    else throw(\\\"invalid char escape\\\")\\n    let close = esc_pos + 1\\n    if close >= len || String::char_code_at(s, close) != '\\\\'' {\\n      throw(\\\"expected closing quote for char literal\\\")\\n    };\\n    (TInt(val), close + 1)\\n  } else {\\n    let close = start + 1\\n    if close >= len || String::char_code_at(s, close) != '\\\\'' {\\n      throw(\\\"expected closing quote for char literal\\\")\\n    };\\n    (TInt(c), close + 1)\\n  }\\n}\\n\\nfn slice_eq(source: String, start: Int, end: Int, text: String) -> Bool {\\n  let len = end - start\\n  let text_len = String::length(text)\\n  if len != text_len {\\n    false\\n  } else {\\n    let mut i = 0\\n    let mut ok = true\\n    while ok && i < text_len {\\n      ok = String::char_code_at(source, start + i) == String::char_code_at(text, i)\\n      i = i + 1\\n    }\\n    ok\\n  }\\n}\\n\\nfn is_hex_digit(c: Int) -> Bool {\\n  (c >= '0' && c <= '9') || (c >= 'a' && c <= 'f') || (c >= 'A' && c <= 'F')\\n}\\n\\nfn keyword_lookup(source: String, start: Int, end: Int) -> Option[Token] {\\n  let len = end - start\\n  if len == 2 {\\n    let c0 = String::char_code_at(source, start)\\n    if c0 == 'f' {\\n      if slice_eq(source, start, end, \\\"fn\\\") {\\n        Some(TIdent(\\\"fn\\\"))\\n      } else None\\n    } else if c0 == 'i' {\\n      if slice_eq(source, start, end, \\\"if\\\") {\\n        Some(TIf)\\n      } else if slice_eq(source, start, end, \\\"in\\\") {\\n        Some(TIn)\\n      } else if slice_eq(source, start, end, \\\"is\\\") {\\n        // ADR-0023: `expr is pattern` is a Bool-returning pattern test.\\n        Some(TIs)\\n      } else None\\n    } else if c0 == 'd' {\\n      if slice_eq(source, start, end, \\\"do\\\") {\\n        Some(TDo)\\n      } else None\\n    } else if c0 == 'a' {\\n      if slice_eq(source, start, end, \\\"as\\\") {\\n        Some(TAs)\\n      } else None\\n    } else None\\n  } else if len == 3 {\\n    let c0 = String::char_code_at(source, start)\\n    if c0 == 'l' {\\n      if slice_eq(source, start, end, \\\"let\\\") {\\n        Some(TLet)\\n      } else None\\n    } else if c0 == 'r' {\\n      if slice_eq(source, start, end, \\\"rec\\\") {\\n        Some(TRec)\\n      } else None\\n    } else if c0 == 'm' {\\n      if slice_eq(source, start, end, \\\"mut\\\") {\\n        Some(TMut)\\n      } else None\\n    } else if c0 == 'f' {\\n      if slice_eq(source, start, end, \\\"for\\\") {\\n        Some(TFor)\\n      } else None\\n    } else None\\n  } else if len == 4 {\\n    let c0 = String::char_code_at(source, start)\\n    if c0 == 'e' {\\n      if slice_eq(source, start, end, \\\"else\\\") {\\n        Some(TElse)\\n      } else if slice_eq(source, start, end, \\\"enum\\\") {\\n        Some(TEnum)\\n      } else None\\n    } else if c0 == 't' {\\n      if slice_eq(source, start, end, \\\"true\\\") {\\n        Some(TIdent(\\\"true\\\"))\\n      } else if slice_eq(source, start, end, \\\"type\\\") {\\n        Some(TType)\\n      } else if slice_eq(source, start, end, \\\"test\\\") {\\n        Some(TTest)\\n      } else None\\n    } else if c0 == 'w' {\\n      if slice_eq(source, start, end, \\\"with\\\") {\\n        Some(TWith)\\n      } else None\\n    } else if c0 == 'l' {\\n      if slice_eq(source, start, end, \\\"loop\\\") {\\n        Some(TLoop)\\n      } else None\\n    } else if c0 == 'o' {\\n      if slice_eq(source, start, end, \\\"open\\\") {\\n        Some(TOpen)\\n      } else None\\n    } else if c0 == 'i' {\\n      if slice_eq(source, start, end, \\\"impl\\\") {\\n        Some(TImpl)\\n      } else None\\n    } else None\\n  } else if len == 5 {\\n    let c0 = String::char_code_at(source, start)\\n    if c0 == 'f' {\\n      if slice_eq(source, start, end, \\\"false\\\") {\\n        Some(TIdent(\\\"false\\\"))\\n      } else None\\n    } else if c0 == 'm' {\\n      if slice_eq(source, start, end, \\\"match\\\") {\\n        Some(TMatch)\\n      } else None\\n    } else if c0 == 't' {\\n      if slice_eq(source, start, end, \\\"trait\\\") {\\n        Some(TTrait)\\n      } else if slice_eq(source, start, end, \\\"throw\\\") {\\n        Some(TThrow)\\n      } else None\\n    } else if c0 == 'w' {\\n      if slice_eq(source, start, end, \\\"while\\\") {\\n        Some(TWhile)\\n      } else None\\n    } else if c0 == 'b' {\\n      if slice_eq(source, start, end, \\\"break\\\") {\\n        Some(TBreak)\\n      } else if slice_eq(source, start, end, \\\"bench\\\") {\\n        Some(TBench)\\n      } else None\\n    } else if c0 == 'r' {\\n      if slice_eq(source, start, end, \\\"raise\\\") {\\n        Some(TRaise)\\n      } else None\\n    } else if c0 == 'y' {\\n      if slice_eq(source, start, end, \\\"yield\\\") {\\n        Some(TYield)\\n      } else None\\n    } else None\\n  } else if len == 6 {\\n    let c0 = String::char_code_at(source, start)\\n    if c0 == 's' {\\n      if slice_eq(source, start, end, \\\"struct\\\") {\\n        Some(TStruct)\\n      } else None\\n    } else if c0 == 'e' {\\n      if slice_eq(source, start, end, \\\"export\\\") {\\n        Some(TExport)\\n      } else None\\n    } else if c0 == 'r' {\\n      if slice_eq(source, start, end, \\\"return\\\") {\\n        Some(TReturn)\\n      } else None\\n    } else if c0 == 'h' {\\n      if slice_eq(source, start, end, \\\"handle\\\") {\\n        Some(THandle)\\n      } else None\\n    } else if c0 == 'm' {\\n      if slice_eq(source, start, end, \\\"module\\\") {\\n        Some(TModule)\\n      } else None\\n    } else if c0 == 'd' {\\n      if slice_eq(source, start, end, \\\"derive\\\") {\\n        Some(TDerive)\\n      } else None\\n    } else if c0 == 'i' {\\n      if slice_eq(source, start, end, \\\"import\\\") {\\n        Some(TImport)\\n      } else None\\n    } else None\\n  } else if len == 7 {\\n    if slice_eq(source, start, end, \\\"declare\\\") {\\n      Some(TDeclare)\\n    } else None\\n  } else if len == 8 {\\n    let c0 = String::char_code_at(source, start)\\n    if c0 == 'c' {\\n      if slice_eq(source, start, end, \\\"continue\\\") {\\n        Some(TContinue)\\n      } else None\\n    } else if c0 == 's' {\\n      if slice_eq(source, start, end, \\\"suberror\\\") {\\n        Some(TSuberror)\\n      } else None\\n    } else None\\n  } else None\\n}\\n\\nfn scan_ident_end(s: String, len: Int, i: Int) -> Int {\\n  let mut out = i\\n  while out < len && is_alnum(String::char_code_at(s, out)) {\\n    out = out + 1\\n  }\\n  out\\n}\\n\\nfn lex_ident(s: String, len: Int, i: Int) -> (Token, Int) {\\n  let end = scan_ident_end(s, len, i)\\n  if end == i + 1 && String::char_code_at(s, i) == 'r' && end < len && String::char_code_at(s, end) == '#' {\\n    let ri_start = end + 1\\n    let ri_end = scan_ident_end(s, len, ri_start)\\n    (TIdent(s[ri_start: ri_end]), ri_end)\\n  }\\n  else if end == i + 1 && String::char_code_at(s, i) == 'r' && end < len && String::char_code_at(s, end) == '\\\"' {\\n    let mut ri = end + 1\\n    while ri < len && String::char_code_at(s, ri) != '\\\"' {\\n      ri = ri + 1\\n    }\\n    (TString(s[end + 1: ri]), if ri >= len {\\n      ri\\n    } else {\\n      ri + 1\\n    })\\n  } else {\\n    match keyword_lookup(s, i, end) {\\n      Some(tok) => (tok, end),\\n      None => (TIdent(s[i: end]), end)\\n    }\\n  }\\n}\\n\\nfn scan_digits_end(s: String, len: Int, i: Int) -> Int {\\n  let mut out = i\\n  while out < len && is_digit(String::char_code_at(s, out)) {\\n    out = out + 1\\n  }\\n  out\\n}\\n\\nfn scan_interp_end(s: String, len: Int, idx: Int, depth: Int) -> Int with { Error } {\\n  let mut out = idx\\n  let mut current_depth = depth\\n  let mut found = -1\\n  while out < len && found < 0 {\\n    let c = String::char_code_at(s, out)\\n    if c == '{' {\\n      current_depth = current_depth + 1\\n    } else if c == '}' {\\n      if current_depth == 1 {\\n        found = out\\n      } else {\\n        current_depth = current_depth - 1\\n      }\\n    }\\n    if found < 0 {\\n      out = out + 1\\n    }\\n  }\\n  if found >= 0 {\\n    found\\n  } else {\\n    throw(\\\"unterminated string interpolation\\\")\\n  }\\n}\\n\\n// #997: 1-based \\\"line L:C: \\\" prefix for a 0-based char offset, matching the\\n// located-diagnostic convention used elsewhere in this lexer (see the\\n// `\\\\(expr)`-removal message below). The generic offset-based diagnostic\\n// collector (`lex_with_offsets_recovering`) always records the START offset\\n// of the enclosing `lex_one_token` call as the error location, so a throw\\n// raised partway through a multi-char token (e.g. at the `e`/`E` of a long\\n// numeric literal, not at its first digit) would otherwise be misattributed\\n// to the token's start. Embedding the precise location directly in the\\n// message — the same workaround already used for the `\\\\(expr)` message —\\n// keeps the report pointing at the actual offending character.\\nfn located_prefix(s: String, pos: Int) -> String {\\n  let mut eline = 1\\n  let mut ecol = 1\\n  let mut ei = 0\\n  while ei < pos {\\n    if String::char_code_at(s, ei) == '\\\\n' {\\n      eline = eline + 1\\n      ecol = 1\\n    } else {\\n      ecol = ecol + 1\\n    }\\n    ei = ei + 1\\n  }\\n  String::concat(\\\"line \\\", String::concat(__to_string(eline), String::concat(\\\":\\\", String::concat(__to_string(ecol), \\\": \\\"))))\\n}\\n\\n// #956/#997: numeric literal followed directly by `e`/`E` + digits (or +/-\\n// digits) looks like scientific notation, which vibe does not support — it\\n// used to lex as `<number>` + identifier and surface as a confusing\\n// downstream `unknown name: e20`. Reject it at the lexer with an\\n// explanatory error, precisely located at the `e`/`E` (not the start of the\\n// number — #997: the generic offset-based collector would otherwise blame\\n// the wrong column for anything but a single-digit literal).\\n//\\n// #997: `e`/`E` immediately followed by a bare `+`/`-` with no digit after\\n// it (`1e+`, `2e-`) is unambiguously a botched exponent, unlike a plain\\n// identifier continuation (`1even` still lexes as `1` + `even`, #956's\\n// `e_prefixed_identifier_after_number_still_lexes`) — a sign can never\\n// legally continue an identifier, so there's no ambiguity to preserve for\\n// that shape, and it used to silently fall through to the same confusing\\n// `unknown name: e` diagnostic.\\nfn check_no_scientific_suffix(s: String, len: Int, pos: Int) -> Unit with { Error } {\\n  if pos < len {\\n    let c = String::char_code_at(s, pos)\\n    if c == 'e' || c == 'E' {\\n      let has_sign = pos + 1 < len && (String::char_code_at(s, pos + 1) == '+' || String::char_code_at(s, pos + 1) == '-')\\n      let digits_start = if has_sign {\\n        pos + 2\\n      } else {\\n        pos + 1\\n      }\\n      let has_digits = digits_start < len && is_digit(String::char_code_at(s, digits_start))\\n      if has_digits {\\n        throw(String::concat(located_prefix(s, pos), \\\"scientific notation is not supported; write the digits out or compute the value\\\"))\\n      } else if has_sign {\\n        throw(String::concat(located_prefix(s, pos), \\\"incomplete exponent: expected digit(s) after the sign in scientific notation\\\"))\\n      } else {\\n        ()\\n      }\\n    } else {\\n      ()\\n    }\\n  } else {\\n    ()\\n  }\\n}\\n\\nfn empty_string_array() -> Array[String] {\\n  Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n}\\n\\nfn skip_until_newline(s: String, len: Int, i: Int) -> Int {\\n  let mut out = i\\n  let mut done = false\\n  while out < len && !done {\\n    if String::char_code_at(s, out) == '\\\\n' {\\n      out = out + 1\\n      done = true\\n    } else {\\n      out = out + 1\\n    }\\n  }\\n  out\\n}\\n\\nfn skip_ws_with_newline(s: String, len: Int, i: Int) -> (Int, Bool) {\\n  let mut out = i\\n  let mut saw_newline = false\\n  let mut skipping = true\\n  while skipping && out < len {\\n    let c = String::char_code_at(s, out)\\n    if is_ws(c) {\\n      if c == '\\\\n' {\\n        saw_newline = true\\n      } else {\\n        ()\\n      }\\n      out = out + 1\\n    } else if c == '/' && out + 1 < len && String::char_code_at(s, out + 1) == '/' {\\n      let next = skip_until_newline(s, len, out + 2)\\n      if next > out + 2 && String::char_code_at(s, next - 1) == '\\\\n' {\\n        saw_newline = true\\n      } else {\\n        ()\\n      }\\n      out = next\\n    } else {\\n      skipping = false\\n    }\\n  }\\n  (out, saw_newline)\\n}\\n\\nfn concat_string_parts(parts: Array[String], tail: String) -> String {\\n  // O(N) join via StringBuilder; the previous `out = String::concat(out, ...)`\\n  // per part was O(N²) over the joined length (issue #366).\\n  let out = StringBuilder::new()\\n  let mut i = 0\\n  while i < Array::length(parts) {\\n    StringBuilder::push(out, Array::get(parts, i))\\n    i = i + 1\\n  }\\n  StringBuilder::push(out, tail)\\n  StringBuilder::freeze(out)\\n}\\n\\nfn lex_string_go(s: String, len: Int, idx: Int, start: Int, parts_acc: Array[String], has_interp: Bool, parts: ArrayBuilder[String], offsets: ArrayBuilder[Int]) -> (Token, Int) with { Error } {\\n  let mut current_idx = idx\\n  let mut current_start = start\\n  let mut current_parts_acc = parts_acc\\n  let mut current_has_interp = has_interp\\n  let mut out_tok = TEof\\n  let mut out_next = -1\\n  let mut done = false\\n  while !done {\\n    if current_idx >= len {\\n      throw(\\\"unterminated string\\\")\\n    }\\n    let c = String::char_code_at(s, current_idx)\\n    if c == '\\\"' {\\n      let value = concat_string_parts(current_parts_acc, s[current_start: current_idx])\\n      if current_has_interp {\\n        ArrayBuilder::push(parts, value)\\n        ArrayBuilder::push(offsets, -1)\\n        out_tok = TStringInterp(ArrayBuilder::freeze(parts), ArrayBuilder::freeze(offsets))\\n        out_next = current_idx + 1\\n      } else {\\n        out_tok = TString(value)\\n        out_next = current_idx + 1\\n      }\\n      done = true\\n    } else if c == '\\\\\\\\' {\\n      let chunk = s[current_start: current_idx]\\n      let next = current_idx + 1\\n      if next >= len {\\n        throw(\\\"unterminated string escape\\\")\\n      }\\n      let esc = String::char_code_at(s, next)\\n      if esc == '(' {\\n        // 0.3.0 redundant-syntax removal (#805): the `\\\\(expr)` interpolation\\n        // spelling is gone — only `\\\\{expr}` remains. Reject with a located\\n        // (1-based `line L:C:` of the backslash) message, matching the\\n        // parser's located diagnostic prefix.\\n        let mut eline = 1\\n        let mut ecol = 1\\n        let mut ei = 0\\n        while ei < current_idx {\\n          if String::char_code_at(s, ei) == '\\\\n' {\\n            eline = eline + 1\\n            ecol = 1\\n          } else {\\n            ecol = ecol + 1\\n          }\\n          ei = ei + 1\\n        }\\n        let eloc = String::concat(\\\"line \\\", String::concat(__to_string(eline), String::concat(\\\":\\\", String::concat(__to_string(ecol), \\\": \\\"))))\\n        throw(String::concat(eloc, \\\"string interpolation \\\\\\\\(expr) was removed in 0.3.0; use \\\\\\\\{expr}\\\"))\\n      } else if esc == '{' {\\n        ArrayBuilder::push(parts, concat_string_parts(current_parts_acc, chunk))\\n        ArrayBuilder::push(offsets, -1)\\n        let interp_end = scan_interp_end(s, len, next + 1, 1)\\n        let expr_src = s[next + 1: interp_end]\\n        ArrayBuilder::push(parts, expr_src)\\n        // #947: absolute source offset of `expr_src`'s first char, so a\\n        // fragment re-lexed in isolation (build_interp_expr) can shift its\\n        // (fragment-relative) offsets back to real file positions.\\n        ArrayBuilder::push(offsets, next + 1)\\n        current_idx = interp_end + 1\\n        current_start = interp_end + 1\\n        current_parts_acc = empty_string_array()\\n        current_has_interp = true\\n      } else {\\n        let escaped = if esc == '\\\"' {\\n          \\\"\\\\\\\"\\\"\\n        }\\n        else if esc == '\\\\\\\\' {\\n          \\\"\\\\\\\\\\\"\\n        }\\n        else if esc == 'n' {\\n          \\\"\\\\n\\\"\\n        }\\n        else if esc == 't' {\\n          \\\"\\\\t\\\"\\n        }\\n        else if esc == 'r' {\\n          String::from_char_code(13)\\n        }\\n        else if esc == '0' {\\n          String::from_char_code(0)\\n        }\\n        else throw(\\\"invalid escape sequence\\\")\\n        Array::push(current_parts_acc, chunk)\\n        Array::push(current_parts_acc, escaped)\\n        current_idx = next + 1\\n        current_start = next + 1\\n      }\\n    } else {\\n      current_idx = current_idx + 1\\n    }\\n  }\\n  (out_tok, out_next)\\n}\\n\\nfn lex_string(s: String, len: Int, i: Int) -> (Token, Int) with { Error } {\\n  lex_string_go(s, len, i + 1, i + 1, empty_string_array(), false, ArrayBuilder::new(), ArrayBuilder::new())\\n}\\n\\nfn scan_hex_digits_end(s: String, len: Int, i: Int) -> Int {\\n  let mut out = i\\n  while out < len && is_hex_digit(String::char_code_at(s, out)) {\\n    out = out + 1\\n  }\\n  out\\n}\\n\\n// #997: Int is 62-bit tagged (range -2^61..2^61-1); a literal magnitude\\n// above Int::max_value (2305843009213693951) cannot be represented.\\n// Without a guard, the digit-accumulation loop below overflows vibe's OWN\\n// `Int` (the accumulator is a plain tagged Int too) and silently wraps into\\n// a bogus in-range value instead of raising `IntLiteralOverflow` — this\\n// used to happen on EVERY numeric literal path (decimal AND hex; see\\n// fixtures/err_parse_int_overflow_tagged.vibe, which predates any actual\\n// check). The bound is checked digit-by-digit, BEFORE each multiply/add,\\n// using the standard `acc > (max / base)`-style pre-check (mirrors the\\n// runtime `Int::parse` guard in codegen/int_parse_expr.vibe) so the\\n// overflow is caught at the exact moment it would occur, never after the\\n// accumulator has already wrapped.\\n\\nfn parse_hex_from_string(s: String) -> Int with { Error } {\\n  let len = String::length(s)\\n  // Int::max_value (0x1FFFFFFFFFFFFFFF) in base 16: floor(max/16) and\\n  // max%16, precomputed so the per-digit check below never itself overflows.\\n  let max_div_16 = 144115188075855871\\n  let max_mod_16 = 15\\n  let mut i = 0\\n  let mut acc = 0\\n  while i < len {\\n    let c = String::char_code_at(s, i)\\n    let digit = if c >= '0' && c <= '9' {\\n      c - 48\\n    } else if c >= 'a' && c <= 'f' {\\n      c - 87\\n    } else c - 55\\n    if acc > max_div_16 || (acc == max_div_16 && digit > max_mod_16) {\\n      throw(\\\"IntLiteralOverflow: hex integer literal exceeds Int::max_value (2305843009213693951)\\\")\\n    } else {\\n      ()\\n    }\\n    acc = acc * 16 + digit\\n    i = i + 1\\n  }\\n  acc\\n}\\n\\nfn parse_int_from_string(s: String) -> Int with { Error } {\\n  let len = String::length(s)\\n  // Int::max_value in base 10: floor(max/10) and max%10.\\n  let max_div_10 = 230584300921369395\\n  let max_mod_10 = 1\\n  let mut i = 0\\n  let mut acc = 0\\n  while i < len {\\n    let c = String::char_code_at(s, i)\\n    let digit = c - 48\\n    if acc > max_div_10 || (acc == max_div_10 && digit > max_mod_10) {\\n      throw(\\\"IntLiteralOverflow: integer literal exceeds Int::max_value (2305843009213693951)\\\")\\n    } else {\\n      ()\\n    }\\n    acc = acc * 10 + digit\\n    i = i + 1\\n  }\\n  acc\\n}\\n\\nfn lex_decimal(s: String, len: Int, i: Int) -> (Token, Int) with { Error } {\\n  let int_end = scan_digits_end(s, len, i)\\n  if int_end == i {\\n    throw(\\\"expected digit\\\")\\n  }\\n  // Tuple field access `t.0.0`: a number immediately preceded by a single field\\n  // dot must NOT absorb a trailing `.<digit>` as a float decimal — that `.` is\\n  // the next tuple-index projection, not this number's fraction. (Mirrors\\n  // src/parser/lexer.mbt `after_field_dot`.) Excludes `..`/`...` (range/spread)\\n  // by requiring the char two back to not also be a dot.\\n  let after_field_dot = i >= 1 && String::char_code_at(s, i - 1) == '.' && (i < 2 || String::char_code_at(s, i - 2) != '.')\\n  if !after_field_dot && int_end < len && String::char_code_at(s, int_end) == '.' {\\n    if int_end + 1 < len && is_digit(String::char_code_at(s, int_end + 1)) {\\n      let frac_end = scan_digits_end(s, len, int_end + 1)\\n      // #956: build the Double from the full digit strings (correctly\\n      // rounded), instead of routing the mantissa through Int (which\\n      // silently wrapped past ~2.3e18).\\n      let value = parse_decimal_float(s[i: int_end], s[int_end + 1: frac_end])\\n      check_no_scientific_suffix(s, len, frac_end)\\n      if frac_end < len && String::char_code_at(s, frac_end) == 'f' {\\n        (TFloat(value), frac_end + 1)\\n      } else {\\n        (TFloat(value), frac_end)\\n      }\\n    } else {\\n      let int_str = s[i: int_end];\\n      (TInt(parse_int_from_string(int_str)), int_end)\\n    }\\n  } else if int_end < len && String::char_code_at(s, int_end) == 'f' {\\n    // Integer-form float literal with an `f` suffix, e.g. `10f`, `0f`.\\n    let value = parse_decimal_float(s[i: int_end], \\\"\\\")\\n    (TFloat(value), int_end + 1)\\n  } else {\\n    check_no_scientific_suffix(s, len, int_end)\\n    let int_str = s[i: int_end];\\n    (TInt(parse_int_from_string(int_str)), int_end)\\n  }\\n}\\n\\nfn lex_number(s: String, len: Int, i: Int) -> (Token, Int) with { Error } {\\n  if i + 1 < len && String::char_code_at(s, i) == '0' {\\n    let next_c = String::char_code_at(s, i + 1)\\n    if next_c == 'x' || next_c == 'X' {\\n      let hex_start = i + 2\\n      let hex_end = scan_hex_digits_end(s, len, hex_start)\\n      if hex_end == hex_start {\\n        throw(\\\"expected hex digit after 0x\\\")\\n      }\\n      let hex_str = s[hex_start: hex_end];\\n      (TInt(parse_hex_from_string(hex_str)), hex_end)\\n    } else lex_decimal(s, len, i)\\n  } else lex_decimal(s, len, i)\\n}\\n\\n// Can this token end a complete (primary) expression? After such a token, a\\n// newline followed by `[` starts a NEW statement (an array literal), not a\\n// postfix subscript — the lexer inserts a synthetic `;` to disambiguate.\\nfn is_expr_ending_tok(t: Token) -> Bool {\\n  match t {\\n    TRParen => true,\\n    TRBracket => true,\\n    TRBrace => true,\\n    TIdent(_) => true,\\n    TInt(_) => true,\\n    TFloat(_) => true,\\n    TString(_) => true,\\n    _ => false\\n  }\\n}\\n\\n// Classify and consume a single token starting at byte `pos`, returning the\\n// token and the byte offset just past it. Shared by `lex` and\\n// `lex_with_offsets` so the large classification logic (and its codegen) exists\\n// only once.\\nfn lex_one_token(source: String, len: Int, pos: Int) -> (Token, Int) with { Error } {\\n  let c = String::char_code_at(source, pos)\\n  if is_alpha(c) {\\n    lex_ident(source, len, pos)\\n  } else if is_digit(c) {\\n    lex_number(source, len, pos)\\n  } else if c == '\\\"' {\\n    lex_string(source, len, pos)\\n  } else if c == '+' {\\n    if pos + 1 < len && String::char_code_at(source, pos + 1) == '=' {\\n      (TPlusEq, pos + 2)\\n    } else (TPlus, pos + 1)\\n  } else if c == '-' {\\n    if pos + 1 < len && String::char_code_at(source, pos + 1) == '>' {\\n      (TThinArrow, pos + 2)\\n    } else if pos + 1 < len && String::char_code_at(source, pos + 1) == '=' {\\n      (TMinusEq, pos + 2)\\n    } else (TMinus, pos + 1)\\n  } else if c == '*' {\\n    if pos + 1 < len && String::char_code_at(source, pos + 1) == '=' {\\n      (TStarEq, pos + 2)\\n    } else (TStar, pos + 1)\\n  } else if c == '/' {\\n    if pos + 1 < len && String::char_code_at(source, pos + 1) == '=' {\\n      (TSlashEq, pos + 2)\\n    } else (TSlash, pos + 1)\\n  } else if c == '%' {\\n    if pos + 1 < len && String::char_code_at(source, pos + 1) == '=' {\\n      (TPercentEq, pos + 2)\\n    } else (TPercent, pos + 1)\\n  } else if c == '=' {\\n    if pos + 1 < len && String::char_code_at(source, pos + 1) == '=' {\\n      (TEqEq, pos + 2)\\n    } else if pos + 1 < len && String::char_code_at(source, pos + 1) == '>' {\\n      (TArrow, pos + 2)\\n    } else (TEq, pos + 1)\\n  } else if c == '!' {\\n    if pos + 1 < len && String::char_code_at(source, pos + 1) == '=' {\\n      (TNeq, pos + 2)\\n    } else (TNot, pos + 1)\\n  } else if c == '<' {\\n    if pos + 1 < len && String::char_code_at(source, pos + 1) == '=' {\\n      (TLte, pos + 2)\\n    } else if pos + 1 < len && String::char_code_at(source, pos + 1) == '<' {\\n      (TLShift, pos + 2)\\n    } else (TLt, pos + 1)\\n  } else if c == '>' {\\n    if pos + 1 < len && String::char_code_at(source, pos + 1) == '=' {\\n      (TGte, pos + 2)\\n    } else if pos + 1 < len && String::char_code_at(source, pos + 1) == '>' {\\n      (TRShift, pos + 2)\\n    } else (TGt, pos + 1)\\n  } else if c == '&' {\\n    if pos + 1 < len && String::char_code_at(source, pos + 1) == '&' {\\n      (TAnd, pos + 2)\\n    } else (TBitAnd, pos + 1)\\n  } else if c == '|' {\\n    if pos + 1 < len && String::char_code_at(source, pos + 1) == '|' {\\n      (TOr, pos + 2)\\n    } else if pos + 1 < len && String::char_code_at(source, pos + 1) == '>' {\\n      (TPipeGt, pos + 2)\\n    } else (TBitOr, pos + 1)\\n  } else if c == '^' {\\n    (TBitXor, pos + 1)\\n  } else if c == '(' {\\n    (TLParen, pos + 1)\\n  } else if c == ')' {\\n    (TRParen, pos + 1)\\n  } else if c == '{' {\\n    (TLBrace, pos + 1)\\n  } else if c == '}' {\\n    (TRBrace, pos + 1)\\n  } else if c == '[' {\\n    (TLBracket, pos + 1)\\n  } else if c == ']' {\\n    (TRBracket, pos + 1)\\n  } else if c == ',' {\\n    (TComma, pos + 1)\\n  } else if c == ';' {\\n    (TSemicolon, pos + 1)\\n  } else if c == '.' {\\n    if pos + 2 < len && String::char_code_at(source, pos + 1) == '.' && String::char_code_at(source, pos + 2) == '.' {\\n      (TDotDotDot, pos + 3)\\n    } else if pos + 1 < len && String::char_code_at(source, pos + 1) == '.' {\\n      (TDotDot, pos + 2)\\n    } else (TDot, pos + 1)\\n  } else if c == ':' {\\n    if pos + 1 < len && String::char_code_at(source, pos + 1) == ':' {\\n      (TDoubleColon, pos + 2)\\n    } else (TColon, pos + 1)\\n  } else if c == '#' {\\n    (THash, pos + 1)\\n  } else if c == '~' {\\n    (TTilde, pos + 1)\\n  } else if c == '?' {\\n    (TQuestion, pos + 1)\\n  } else if c == '@' {\\n    // Package refs: `@scope/name` — '/', '-', '_' are part of the name after\\n    // '@' (#730; matches the documented `@lib/path` form). A trailing '/'\\n    // is not consumed (so `@a/` is `@a` + '/').\\n    let mut end = pos + 1\\n    while end < len {\\n      let ec = String::char_code_at(source, end)\\n      if is_alnum(ec) || ec == '_' || ec == '-' {\\n        end = end + 1\\n      } else if ec == '/' && end + 1 < len && is_alnum(String::char_code_at(source, end + 1)) {\\n        end = end + 1\\n      } else {\\n        break\\n      }\\n    }\\n    if end > pos + 1 {\\n      (TIdent(String::substring(source, pos, end)), end)\\n    } else {\\n      throw(\\\"unexpected '@' without identifier\\\")\\n    }\\n  } else if c == '\\\\'' {\\n    lex_char(source, len, pos)\\n  } else throw(String::concat(\\\"unexpected character: \\\", String::from_char_code(c)))\\n}\\n\\n// Position-tracking lexer: identical token production to `lex`, but also returns\\n// per emitted token its start and end byte offset in `source` (three parallel\\n// arrays — one entry per token, including any synthetic `;` separators and the\\n// trailing `TEof`). Used by module-source emission to recover top-level\\n// statement source spans.\\nexport fn lex_with_offsets(source: String) -> (Array[Token], Array[Int], Array[Int]) with { Error } {\\n  let len = String::length(source)\\n  {\\n    let b = ArrayBuilder::new()\\n    let starts = ArrayBuilder::new()\\n    let ends = ArrayBuilder::new()\\n    let mut prev_tok = TEof\\n    let first_skip = skip_ws_with_newline(source, len, 0)\\n    let mut pos = first_skip.0\\n    let mut nl_before = first_skip.1\\n    while pos < len {\\n      let c = String::char_code_at(source, pos)\\n      let (tok, next) = lex_one_token(source, len, pos)\\n      if (c == '[' || c == '(') && nl_before && is_expr_ending_tok(prev_tok) {\\n        ArrayBuilder::push(b, TSemicolon)\\n        ArrayBuilder::push(starts, pos)\\n        ArrayBuilder::push(ends, pos)\\n      } else {\\n        ()\\n      }\\n      ArrayBuilder::push(b, tok)\\n      ArrayBuilder::push(starts, pos)\\n      ArrayBuilder::push(ends, next)\\n      prev_tok = tok\\n      let skipped = skip_ws_with_newline(source, len, next)\\n      pos = skipped.0\\n      nl_before = skipped.1\\n    }\\n    ArrayBuilder::push(b, TEof)\\n    ArrayBuilder::push(starts, len)\\n    ArrayBuilder::push(ends, len)\\n    (ArrayBuilder::freeze(b), ArrayBuilder::freeze(starts), ArrayBuilder::freeze(ends))\\n  }\\n}\\n\\n// #946: recovering variant of `lex_with_offsets` — NEVER throws. On a lex\\n// error (unexpected character, bad escape, unterminated string, ...) it\\n// records the 0-based char offset of the offending position plus the raw\\n// error message into two parallel diagnostic arrays, skips ONE char (progress\\n// guarantee), and keeps lexing. Returns (tokens, starts, ends, err_offsets,\\n// err_msgs); err arrays empty = clean lex, identical token stream to\\n// `lex_with_offsets`. Foundation for `vibe diagnostics` reporting lexer\\n// errors as located diagnostics instead of an empty (\\\"clean\\\") report.\\nexport fn lex_with_offsets_recovering(source: String) -> (Array[Token], Array[Int], Array[Int], Array[Int], Array[String]) {\\n  let len = String::length(source)\\n  let b = ArrayBuilder::new()\\n  let starts = ArrayBuilder::new()\\n  let ends = ArrayBuilder::new()\\n  let err_offsets = ArrayBuilder::new()\\n  let err_msgs = ArrayBuilder::new()\\n  let mut prev_tok = TEof\\n  let first_skip = skip_ws_with_newline(source, len, 0)\\n  let mut pos = first_skip.0\\n  let mut nl_before = first_skip.1\\n  while pos < len {\\n    let c = String::char_code_at(source, pos)\\n    let res = handle {\\n      let (tok, next) = lex_one_token(source, len, pos)\\n      Some((tok, next))\\n    } with Error {\\n      Throw(msg) => {\\n        ArrayBuilder::push(err_offsets, pos)\\n        ArrayBuilder::push(err_msgs, msg)\\n        None\\n      }\\n    }\\n    match res {\\n      Some((tok, next)) => {\\n        if (c == '[' || c == '(') && nl_before && is_expr_ending_tok(prev_tok) {\\n          ArrayBuilder::push(b, TSemicolon)\\n          ArrayBuilder::push(starts, pos)\\n          ArrayBuilder::push(ends, pos)\\n        } else {\\n          ()\\n        }\\n        ArrayBuilder::push(b, tok)\\n        ArrayBuilder::push(starts, pos)\\n        ArrayBuilder::push(ends, next)\\n        prev_tok = tok\\n        let skipped = skip_ws_with_newline(source, len, next)\\n        pos = skipped.0\\n        nl_before = skipped.1\\n      },\\n      None => {\\n        // #963: resume PAST the failed construct, not inside it. A failure\\n        // in a multi-char quoted token (string/char literal with a bad\\n        // escape) would otherwise re-lex the token's interior and invent\\n        // follow-on diagnostics (the backslash as an unexpected char, the\\n        // closing quote as a new unterminated string). For quote-delimited\\n        // constructs skip to just past the matching close quote (honoring\\n        // backslash escapes; stop at newline/EOF for unterminated ones);\\n        // anything else advances one char (progress guarantee).\\n        let resume = if c == '\\\"' || c == '\\\\'' {\\n          let mut j = pos + 1\\n          let mut stop = false\\n          while !stop {\\n            if j >= len {\\n              stop = true\\n            } else {\\n              let cc = String::char_code_at(source, j)\\n              if cc == c {\\n                j = j + 1\\n                stop = true\\n              } else if cc == 10 {\\n                stop = true\\n              } else if cc == 92 && j + 1 < len {\\n                j = j + 2\\n              } else {\\n                j = j + 1\\n              }\\n            }\\n          }\\n          j\\n        } else {\\n          pos + 1\\n        }\\n        let skipped = skip_ws_with_newline(source, len, resume)\\n        pos = skipped.0\\n        nl_before = skipped.1\\n      }\\n    }\\n  }\\n  ArrayBuilder::push(b, TEof)\\n  ArrayBuilder::push(starts, len)\\n  ArrayBuilder::push(ends, len)\\n  (ArrayBuilder::freeze(b), ArrayBuilder::freeze(starts), ArrayBuilder::freeze(ends), ArrayBuilder::freeze(err_offsets), ArrayBuilder::freeze(err_msgs))\\n}\\n\\n// Convert a 0-based char offset (from lex_with_offsets) to 1-based (line, col).\\n// Source-span foundation: lets diagnostics report a real `line:col`.\\nexport fn offset_to_line_col(source: String, offset: Int) -> (Int, Int) {\\n  let len = String::length(source)\\n  let bound = if offset < len { offset } else { len }\\n  let mut i = 0\\n  let mut line = 1\\n  let mut col = 1\\n  while i < bound {\\n    if String::char_code_at(source, i) == 10 {\\n      line = line + 1\\n      col = 1\\n    } else {\\n      col = col + 1\\n    }\\n    i = i + 1\\n  }\\n  (line, col)\\n}\\n\\nexport fn lex(source: String) -> Array[Token] with { Error } {\\n  let len = String::length(source)\\n  {\\n    let b = ArrayBuilder::new()\\n    let mut prev_tok = TEof\\n    let first_skip = skip_ws_with_newline(source, len, 0)\\n    let mut pos = first_skip.0\\n    let mut nl_before = first_skip.1\\n    while pos < len {\\n      let c = String::char_code_at(source, pos)\\n      let (tok, next) = lex_one_token(source, len, pos)\\n      // Newline-sensitive disambiguation: `expr <newline> [ ... ]` is two\\n      // statements (the `[...]` is an array literal), not a postfix subscript\\n      // `expr[...]`; likewise `expr <newline> ( ... )` is two statements (the\\n      // `(...)` is a paren/tuple expression), not a call `expr(...)`. The lexer\\n      // discards newlines, so insert a synthetic `;` when a `[`/`(` is\\n      // newline-preceded and follows an expression-ending token; the statement\\n      // parser already treats `;` as a separator. A same-line `(`/`[` (no\\n      // newline) still attaches as a call/subscript suffix.\\n      if (c == '[' || c == '(') && nl_before && is_expr_ending_tok(prev_tok) {\\n        ArrayBuilder::push(b, TSemicolon)\\n      } else {\\n        ()\\n      }\\n      ArrayBuilder::push(b, tok)\\n      prev_tok = tok\\n      let skipped = skip_ws_with_newline(source, len, next)\\n      pos = skipped.0\\n      nl_before = skipped.1\\n    }\\n    ArrayBuilder::push(b, TEof)\\n    ArrayBuilder::freeze(b)\\n  }\\n}\\n\\nexport fn lex_ok(source: String) -> Bool {\\n  handle {\\n    let _ = lex(source)\\n    true\\n  } with Error {\\n    Throw(_) => false\\n  }\\n}\\n\")\n}\n\nlet cli_adapter_source_7 = () -> (String, String) {\n  (\"lib/@vibe/parser/parser_base.vibe\",\n\"//# Imports\\n\\nimport ../ast {\\n  Expr, Pat, Stmt, TypeExpr\\n}\\n\\nimport ./token.vibe {\\n  Token\\n}\\n\\n//# Functions\\n\\nexport fn peek(tokens: Array[Token], pos: Int) -> Token {\\n  if pos < Array::length(tokens) {\\n    Array::get(tokens, pos)\\n  } else TEof\\n}\\n\\nfn _no_tp() -> Array[String] {\\n  Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n}\\n\\nfn _no_tb() -> Array[(String, Array[String])] {\\n  Array::slice([\\n    (\\\"\\\", _no_tp())\\n  ], 0, 0)\\n}\\n\\nlet mode_if = 21\\n\\nexport fn tk_name(tok: Token) -> String {\\n  match tok {\\n    TInt(_) => \\\"int\\\",\\n    TFloat(_) => \\\"float\\\",\\n    TString(_) => \\\"string\\\",\\n    TStringInterp(_, _) => \\\"string\\\",\\n    TIdent(_) => \\\"ident\\\",\\n    TLet => \\\"let\\\",\\n    TRec => \\\"rec\\\",\\n    TMut => \\\"mut\\\",\\n    TFn => \\\"fn\\\",\\n    TIf => \\\"if\\\",\\n    TElse => \\\"else\\\",\\n    TMatch => \\\"match\\\",\\n    TIs => \\\"is\\\",\\n    TDo => \\\"do\\\",\\n    TEnum => \\\"enum\\\",\\n    TStruct => \\\"struct\\\",\\n    TType => \\\"type\\\",\\n    TTrait => \\\"trait\\\",\\n    TImpl => \\\"impl\\\",\\n    TExport => \\\"export\\\",\\n    TTest => \\\"test\\\",\\n    TWhile => \\\"while\\\",\\n    TFor => \\\"for\\\",\\n    TIn => \\\"in\\\",\\n    TLoop => \\\"loop\\\",\\n    TBreak => \\\"break\\\",\\n    TContinue => \\\"continue\\\",\\n    TReturn => \\\"return\\\",\\n    TWith => \\\"with\\\",\\n    THandle => \\\"handle\\\",\\n    TThrow => \\\"throw\\\",\\n    TRaise => \\\"raise\\\",\\n    TYield => \\\"yield\\\",\\n    TBench => \\\"bench\\\",\\n    TDeclare => \\\"declare\\\",\\n    TAs => \\\"as\\\",\\n    TModule => \\\"module\\\",\\n    TSuberror => \\\"suberror\\\",\\n    TDerive => \\\"derive\\\",\\n    TOpen => \\\"open\\\",\\n    TImport => \\\"import\\\",\\n    TPlus => \\\"+\\\",\\n    TMinus => \\\"-\\\",\\n    TStar => \\\"*\\\",\\n    TSlash => \\\"/\\\",\\n    TPercent => \\\"%\\\",\\n    TEqEq => \\\"==\\\",\\n    TNeq => \\\"!=\\\",\\n    TLt => \\\"<\\\",\\n    TLte => \\\"<=\\\",\\n    TGt => \\\">\\\",\\n    TGte => \\\">=\\\",\\n    TAnd => \\\"&&\\\",\\n    TOr => \\\"||\\\",\\n    TNot => \\\"!\\\",\\n    TBitAnd => \\\"&\\\",\\n    TBitOr => \\\"|\\\",\\n    TBitXor => \\\"^\\\",\\n    TLShift => \\\"<<\\\",\\n    TRShift => \\\">>\\\",\\n    TPipeGt => \\\"|>\\\",\\n    TArrow => \\\"=>\\\",\\n    TThinArrow => \\\"->\\\",\\n    TEq => \\\"=\\\",\\n    TDot => \\\".\\\",\\n    TColon => \\\":\\\",\\n    TDoubleColon => \\\"::\\\",\\n    TComma => \\\",\\\",\\n    TSemicolon => \\\";\\\",\\n    THash => \\\"#\\\",\\n    TTilde => \\\"~\\\",\\n    TQuestion => \\\"?\\\",\\n    TPlusEq => \\\"+=\\\",\\n    TMinusEq => \\\"-=\\\",\\n    TStarEq => \\\"*=\\\",\\n    TSlashEq => \\\"/=\\\",\\n    TPercentEq => \\\"%=\\\",\\n    TLParen => \\\"(\\\",\\n    TRParen => \\\")\\\",\\n    TLBrace => \\\"{\\\",\\n    TRBrace => \\\"}\\\",\\n    TLBracket => \\\"[\\\",\\n    TRBracket => \\\"]\\\",\\n    TDotDot => \\\"..\\\",\\n    TDotDotDot => \\\"...\\\",\\n    TStringInterp(_, _) => \\\"string\\\",\\n    TEof => \\\"eof\\\"\\n  }\\n}\\n\\nfn is_tk(tok: Token, name: String) -> Bool {\\n  tk_name(tok) == name\\n}\\n\\nfn expect_tk(tokens: Array[Token], pos: Int, expected: String) -> Int with { Error } {\\n  if is_tk(peek(tokens, pos), expected) {\\n    pos + 1\\n  } else {\\n    let actual = tk_name(peek(tokens, pos))\\n    // #816: carry the failing TOKEN index; parse_program_located decodes it\\n    // to a real line:col (and strips it from the user-facing message).\\n    throw(\\\"expected \\\\{expected} but got \\\\{actual} at #\\\\{pos}\\\")\\n  }\\n}\\n\\nexport fn skip_semi(tokens: Array[Token], pos: Int) -> Int {\\n  match peek(tokens, pos) {\\n    TSemicolon => pos + 1,\\n    _ => pos\\n  }\\n}\\n\\nfn empty_arms() -> Array[(Pat, Expr)] {\\n  Array::slice([\\n    (PWild, EUnit)\\n  ], 0, 0)\\n}\\n\\nfn empty_pats() -> Array[Pat] {\\n  Array::slice([\\n    PWild\\n  ], 0, 0)\\n}\\n\\nlet mode_block = 20\\n\\nlet mode_match = 22\\n\\nlet mode_while = 23\\n\\nfn empty_ctors() -> Array[(String, Array[TypeExpr])] {\\n  Array::slice([\\n    (\\\"_\\\", Array::slice([\\n      TyUnit\\n    ], 0, 0))\\n  ], 0, 0)\\n}\\n\\nfn empty_exprs() -> Array[Expr] {\\n  Array::slice([\\n    EUnit\\n  ], 0, 0)\\n}\\n\\nlet mode_for_in = 25\\n\\nlet mode_handle = 24\\n\\n// Parse a `derive(A, B, ...)` clause into the list of derived trait names plus\\n// the position after the clause. Any identifier is accepted (the set of\\n// structurally-derivable traits is validated later); a missing clause yields an\\n// empty list. Supports multiple comma-separated names (#638).\\nexport fn parse_derive_names(tokens: Array[Token], pos: Int) -> (Array[String], Int) with { Error } {\\n  let names = Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n  match peek(tokens, pos) {\\n    TDerive => match peek(tokens, pos + 1) {\\n      TLParen => {\\n        let mut dp = pos + 2\\n        let mut dd = true\\n        while dd {\\n          match peek(tokens, dp) {\\n            TRParen => {\\n              dd = false\\n              dp = dp + 1\\n            },\\n            TComma => {\\n              dp = dp + 1\\n            },\\n            TIdent(name) => {\\n              Array::push(names, name)\\n              dp = dp + 1\\n            },\\n            _ => throw(\\\"expected derive identifier\\\")\\n          }\\n        }\\n        (names, dp)\\n      },\\n      _ => (names, pos)\\n    },\\n    _ => (names, pos)\\n  }\\n}\\n\\nexport fn skip_derive(tokens: Array[Token], pos: Int) -> Int with { Error } {\\n  let (_, next) = parse_derive_names(tokens, pos)\\n  next\\n}\\n\\nfn empty_fields() -> Array[(String, TypeExpr)] {\\n  Array::slice([\\n    (\\\"_\\\", TyUnit)\\n  ], 0, 0)\\n}\\n\\nfn empty_params() -> Array[(String, Option[TypeExpr])] {\\n  Array::slice([\\n    (\\\"\\\", None)\\n  ], 0, 0)\\n}\\n\\nfn parse_pattern(tokens: Array[Token], pos: Int) -> (Pat, Int) with { Error } {\\n  let rec parse_pat_cont: (Array[Token], Int, ArrayBuilder[Pat]) -> (Array[Pat], Int) with { Error } = (tokens, pos, b) -> {\\n    match peek(tokens, pos) {\\n      TComma => {\\n        let (p, pn) = parse_pattern(tokens, pos + 1)\\n        ArrayBuilder::push(b, p)\\n        parse_pat_cont(tokens, pn, b)\\n      },\\n      TRParen => (ArrayBuilder::freeze(b), pos + 1),\\n      _ => throw(\\\"expected ',' or ')' in pattern list\\\")\\n    }\\n  }\\n  let parse_pats_until_rparen: (Array[Token], Int) -> (Array[Pat], Int) with { Error } = (tokens, pos) -> {\\n    match peek(tokens, pos) {\\n      TRParen => (empty_pats(), pos + 1),\\n      _ => {\\n        let (f, fn1) = parse_pattern(tokens, pos)\\n        let b = ArrayBuilder::new()\\n        ArrayBuilder::push(b, f)\\n        parse_pat_cont(tokens, fn1, b)\\n      }\\n    }\\n  }\\n  let (pat, next) = match peek(tokens, pos) {\\n    TInt(n) => (PInt(n), pos + 1),\\n    // A negative literal pattern `-5` / `-1.5` (lexed as TMinus + number).\\n    // Float literal patterns used to silently become PWild — the first\\n    // float arm then matched EVERYTHING (`match d { 0.0 => .., 1.0 => .. }`\\n    // always took \\\"0.0\\\"); they are real PFloat patterns now (bit-exact via\\n    // f64.eq at codegen, so 0.0 == -0.0 and NaN never matches, like `==`).\\n    TMinus => match peek(tokens, pos + 1) {\\n      TInt(n) => (PInt(0 - n), pos + 2),\\n      TFloat(n) => (PFloat(0.0 - n), pos + 2),\\n      _ => throw(\\\"expected number literal after '-' in pattern\\\")\\n    },\\n    TFloat(n) => (PFloat(n), pos + 1),\\n    TString(s) => (PString(s), pos + 1),\\n    TIdent(name) => {\\n      let next_is_lbrace = match peek(tokens, pos + 1) {\\n        TLBrace => true,\\n        _ => false\\n      }\\n      if name == \\\"true\\\" {\\n        (PBool(true), pos + 1)\\n      }\\n      else if name == \\\"false\\\" {\\n        (PBool(false), pos + 1)\\n      }\\n      else if name == \\\"_\\\" {\\n        (PWild, pos + 1)\\n      }\\n      else if name == \\\"record\\\" && next_is_lbrace {\\n        let mut rp = pos + 2\\n        let field_pats_b = ArrayBuilder::new()\\n        let mut rd = true\\n        while rd {\\n          match peek(tokens, rp) {\\n            TRBrace => {\\n              rd = false\\n            },\\n            TIdent(fname) => {\\n              match peek(tokens, rp + 1) {\\n                TColon => {\\n                  let (fp, fnext) = parse_pattern(tokens, rp + 2)\\n                  ArrayBuilder::push(field_pats_b, fp)\\n                  rp = fnext\\n                },\\n                TComma => {\\n                  ArrayBuilder::push(field_pats_b, PBind(fname)); rp = rp + 1\\n                },\\n                TRBrace => {\\n                  ArrayBuilder::push(field_pats_b, PBind(fname)); rp = rp + 1\\n                },\\n                _ => {\\n                  ArrayBuilder::push(field_pats_b, PBind(fname)); rp = rp + 1\\n                }\\n              }\\n              match peek(tokens, rp) {\\n                TComma => {\\n                  rp = rp + 1\\n                },\\n                _ => ()\\n              }\\n            },\\n            _ => {\\n              rp = rp + 1\\n            }\\n          }\\n        }\\n        let rp2 = rp + 1\\n        (PTuple(ArrayBuilder::freeze(field_pats_b)), rp2)\\n      }\\n      else {\\n        let fc = String::char_code_at(name, 0)\\n        if fc >= 65 && fc <= 90 {\\n          match peek(tokens, pos + 1) {\\n            TLParen => {\\n              let (args, end) = parse_pats_until_rparen(tokens, pos + 2);\\n              (PCtor(name, args), end)\\n            },\\n            TDoubleColon => match peek(tokens, pos + 2) {\\n              TLBrace => {\\n                let mut sp = pos + 3\\n                let field_pats = ArrayBuilder::new()\\n                let mut sd = true\\n                while sd {\\n                  match peek(tokens, sp) {\\n                    TRBrace => {\\n                      sd = false\\n                    },\\n                    TIdent(fname) => {\\n                      ArrayBuilder::push(field_pats, (fname, PBind(fname)))\\n                      sp = sp + 1\\n                      match peek(tokens, sp) {\\n                        TComma => {\\n                          sp = sp + 1\\n                        },\\n                        _ => ()\\n                      }\\n                    },\\n                    _ => {\\n                      sd = false\\n                    }\\n                  }\\n                }\\n                (PStruct(name, ArrayBuilder::freeze(field_pats)), sp + 1)\\n              },\\n              // #742: qualified variant pattern `Enum::Variant(..)` /\\n              // `Enum::Variant`. The qualifier is dropped, mirroring the\\n              // expression side (#672): codegen's ctor table is keyed\\n              // unqualified, and handle-arm dispatch re-prefixes the effect\\n              // name onto a bare op pattern, so `Fs::ReadFile(p)` in a\\n              // `with Fs` arm also lands on the same name it does today.\\n              TIdent(vname) => {\\n                let vc = String::char_code_at(vname, 0)\\n                if vc >= 65 && vc <= 90 {\\n                  match peek(tokens, pos + 3) {\\n                    TLParen => {\\n                      let (args, end) = parse_pats_until_rparen(tokens, pos + 4);\\n                      (PCtor(vname, args), end)\\n                    },\\n                    _ => (PCtor(vname, empty_pats()), pos + 3)\\n                  }\\n                } else {\\n                  (PCtor(name, empty_pats()), pos + 1)\\n                }\\n              },\\n              _ => (PCtor(name, empty_pats()), pos + 1)\\n            },\\n            _ => (PCtor(name, empty_pats()), pos + 1)\\n          }\\n        } else (PBind(name), pos + 1)\\n      }\\n    },\\n    TLParen => match peek(tokens, pos + 1) {\\n      TRParen => (PTuple(empty_pats()), pos + 2),\\n      _ => {\\n        let (f, n1) = parse_pattern(tokens, pos + 1)\\n        match peek(tokens, n1) {\\n          TRParen => (f, n1 + 1),\\n          TComma => {\\n            let b = ArrayBuilder::new()\\n            ArrayBuilder::push(b, f)\\n            let (rest, end) = parse_pat_cont(tokens, n1, b);\\n            (PTuple(rest), end)\\n          },\\n          _ => throw(\\\"expected ')' or ',' in pattern\\\")\\n        }\\n      }\\n    },\\n    _ => {\\n      let actual = tk_name(peek(tokens, pos))\\n      throw(\\\"unexpected in pattern: \\\\{actual}\\\")\\n    }\\n  }\\n  match peek(tokens, next) {\\n    TBitOr => {\\n      let (right, end) = parse_pattern(tokens, next + 1);\\n      (POr(pat, right), end)\\n    },\\n    _ => (pat, next)\\n  }\\n}\\n\\nfn empty_type_exprs() -> Array[TypeExpr] {\\n  Array::slice([\\n    TyUnit\\n  ], 0, 0)\\n}\\n\\nexport fn skip_braced_body(tokens: Array[Token], pos: Int) -> Int {\\n  match peek(tokens, pos) {\\n    TLBrace => {\\n      let mut bp = pos + 1\\n      let mut depth = 1\\n      while depth > 0 {\\n        match peek(tokens, bp) {\\n          TLBrace => {\\n            depth = depth + 1\\n            bp = bp + 1\\n          },\\n          TRBrace => {\\n            depth = depth - 1\\n            bp = bp + 1\\n          },\\n          _ => {\\n            bp = bp + 1\\n          }\\n        }\\n      }\\n      bp\\n    },\\n    _ => pos\\n  }\\n}\\n\\n// Parse `Bound + Bound2 + ...` (one type parameter's bound trait names) in a\\n// method-level `[X: Bound]` binder. Local equivalent of parser_expr's\\n// `parse_type_param_bound_names` (not visible from parser_base).\\nfn parse_method_tp_bound_names(tokens: Array[Token], pos: Int) -> (Array[String], Int) with { Error } {\\n  let b = ArrayBuilder::new()\\n  let mut p = pos\\n  let mut done = false\\n  while !done {\\n    match peek(tokens, p) {\\n      TIdent(name) => {\\n        ArrayBuilder::push(b, name)\\n        p = p + 1\\n        match peek(tokens, p) {\\n          TPlus => {\\n            p = p + 1\\n          },\\n          _ => {\\n            done = true\\n          }\\n        }\\n      },\\n      _ => throw(\\\"expected trait bound name\\\")\\n    }\\n  }\\n  (ArrayBuilder::freeze(b), p)\\n}\\n\\n// Parse a method-level `[X: Bound, Y, ...]` binder (the first param name token\\n// is at `pos`, the `[` already consumed). Local equivalent of parser_expr's\\n// `parse_let_type_params`. Returns (type-param names, per-param bounds, next\\n// position after `]`).\\nfn parse_method_type_params(tokens: Array[Token], pos: Int) -> (Array[String], Array[(String, Array[String])], Int) with { Error } {\\n  let names = ArrayBuilder::new()\\n  let bounds = ArrayBuilder::new()\\n  let mut p = pos\\n  while true {\\n    match peek(tokens, p) {\\n      TRBracket => {\\n        p = p + 1\\n        break\\n      },\\n      TIdent(name) => {\\n        ArrayBuilder::push(names, name)\\n        p = p + 1\\n        match peek(tokens, p) {\\n          TColon => {\\n            let (bound_names, next) = parse_method_tp_bound_names(tokens, p + 1)\\n            ArrayBuilder::push(bounds, (name, bound_names))\\n            p = next\\n          },\\n          _ => ()\\n        }\\n        match peek(tokens, p) {\\n          TComma => {\\n            p = p + 1\\n          },\\n          TRBracket => {\\n            p = p + 1\\n            break\\n          },\\n          _ => throw(\\\"expected ',' or ']' in method type params\\\")\\n        }\\n      },\\n      _ => throw(\\\"expected type parameter name or ']'\\\")\\n    }\\n  }\\n  (ArrayBuilder::freeze(names), ArrayBuilder::freeze(bounds), p)\\n}\\n\\nfn parse_trait_methods(tokens: Array[Token], pos: Int) -> (Array[(String, Array[TypeExpr], TypeExpr)], Array[(String, Array[String], Array[(String, Array[String])])], Int) with { Error } {\\n  match peek(tokens, pos) {\\n    TLBrace => {\\n      let sigs_b = ArrayBuilder::new()\\n      let gens_b = ArrayBuilder::new()\\n      let mut p = pos + 1\\n      while true {\\n        match peek(tokens, p) {\\n          TRBrace => {\\n            p = p + 1\\n            break\\n          },\\n          TIdent(method_name) => {\\n            // Optional `:` after the method name, so both\\n            // `m(Self) -> R` and `m: [X: Bound](Self, X) -> R` parse (#684).\\n            let after_colon = match peek(tokens, p + 1) {\\n              TColon => p + 2,\\n              _ => p + 1\\n            }\\n            // Optional method-level generic binder `[X: Bound]`, declared on the\\n            // trait method only (rank-1 method generics, #684). The impl never\\n            // repeats it; the desugar reattaches it to the impl's free function.\\n            let (mtparams, mtbounds, after_binder) = match peek(tokens, after_colon) {\\n              TLBracket => parse_method_type_params(tokens, after_colon + 1),\\n              _ => (_no_tp(), _no_tb(), after_colon)\\n            }\\n            let (params, after_method_params) = match peek(tokens, after_binder) {\\n              TLParen => {\\n                let (params_ty, after_paren) = parse_type_impl(tokens, after_binder, 1)\\n                let params = match params_ty {\\n                  TyUnit => empty_type_exprs(),\\n                  TyTuple(elems) => elems,\\n                  _ => [\\n                    params_ty\\n                  ]\\n                }\\n                (params, after_paren)\\n              },\\n              _ => (empty_type_exprs(), after_binder)\\n            }\\n            let arrow_pos = expect_tk(tokens, after_method_params, \\\"->\\\")\\n            let (ret_type, after_ret) = parse_type_impl(tokens, arrow_pos, 0)\\n            ArrayBuilder::push(sigs_b, (method_name, params, ret_type))\\n            ArrayBuilder::push(gens_b, (method_name, mtparams, mtbounds))\\n            p = match peek(tokens, after_ret) {\\n              TSemicolon => after_ret + 1,\\n              _ => after_ret\\n            }\\n          },\\n          _ => throw(\\\"expected trait method signature or '}'\\\")\\n        }\\n      }\\n      (ArrayBuilder::freeze(sigs_b), ArrayBuilder::freeze(gens_b), p)\\n    },\\n    _ => (ArrayBuilder::freeze(ArrayBuilder::new()), ArrayBuilder::freeze(ArrayBuilder::new()), pos)\\n  }\\n}\\n\\nfn parse_trait_stmt(tokens: Array[Token], pos: Int, exported: Bool) -> (Stmt, Int) with { Error } {\\n  let empty_strings = Array::slice([\\n    \\\"_\\\"\\n  ], 0, 0)\\n  match peek(tokens, pos) {\\n    TIdent(name) => {\\n      // Optional type-parameter header `trait Iterator[T] { ... }`. Consumed\\n      // and discarded — the uniform tagged representation erases type params, so\\n      // the element type T only constrains the method signatures (#636).\\n      let after_name = skip_bracketed_args(tokens, pos + 1)\\n      match peek(tokens, after_name) {\\n        TColon => {\\n          let supers = empty_strings\\n          let mut p = after_name + 1\\n          let mut done = false\\n          while !done {\\n            match peek(tokens, p) {\\n              TIdent(sname) => match peek(tokens, p + 1) {\\n                TPlus => {\\n                  Array::push(supers, sname)\\n                  p = p + 2\\n                },\\n                _ => {\\n                  Array::push(supers, sname)\\n                  p = p + 1\\n                  done = true\\n                }\\n              },\\n              _ => {\\n                done = true\\n              }\\n            }\\n          }\\n          let np = p\\n          let (methods, method_gens, body_end) = parse_trait_methods(tokens, np)\\n          (STrait(exported, name, supers, methods, method_gens), body_end)\\n        },\\n        _ => {\\n          let (methods, method_gens, body_end) = parse_trait_methods(tokens, after_name)\\n          (STrait(exported, name, empty_strings, methods, method_gens), body_end)\\n        }\\n      }\\n    },\\n    _ => throw(\\\"expected trait name\\\")\\n  }\\n}\\n\\nfn is_expr_end_token(tok: Token) -> Bool {\\n  match tok {\\n    TInt(_) => true,\\n    TFloat(_) => true,\\n    TString(_) => true,\\n    TStringInterp(_, _) => true,\\n    TIdent(_) => true,\\n    TRParen => true,\\n    TRBracket => true,\\n    TRBrace => true,\\n    _ => false\\n  }\\n}\\n\\nfn is_non_pipe_infix(tok: Token) -> Bool {\\n  match tok {\\n    TOr => true,\\n    TAnd => true,\\n    TEqEq => true,\\n    TNeq => true,\\n    TLt => true,\\n    TLte => true,\\n    TGt => true,\\n    TGte => true,\\n    TBitOr => true,\\n    TBitXor => true,\\n    TBitAnd => true,\\n    TLShift => true,\\n    TRShift => true,\\n    TPlus => true,\\n    TMinus => true,\\n    TStar => true,\\n    TSlash => true,\\n    TPercent => true,\\n    _ => false\\n  }\\n}\\n\\nfn parse_import_item(tokens: Array[Token], pos: Int) -> ((String, Option[String]), Int) with { Error } {\\n  let parse_import_name: (Int) -> ((String, Option[String]), Int) with { Error } = (name_pos) -> {\\n    match peek(tokens, name_pos) {\\n      TIdent(name) => {\\n        let (base, after) = match peek(tokens, name_pos + 1) {\\n          TDoubleColon => match peek(tokens, name_pos + 2) {\\n            TIdent(member) =>\\n            (String::concat(name, String::concat(\\\"::\\\", member)), name_pos + 3),\\n            _ => throw(\\\"expected qualified member name after '::'\\\")\\n          },\\n          _ => (name, name_pos + 1)\\n        }\\n        match peek(tokens, after) {\\n          TAs => match peek(tokens, after + 1) {\\n            TIdent(alias) => ((base, Some(alias)), after + 2),\\n            _ => throw(\\\"expected alias name after 'as'\\\")\\n          },\\n          _ => ((base, None), after)\\n        }\\n      },\\n      _ => throw(\\\"expected import item name\\\")\\n    }\\n  }\\n  match peek(tokens, pos) {\\n    TIdent(_) => parse_import_name(pos),\\n    TType => parse_import_name(pos + 1),\\n    TTrait => parse_import_name(pos + 1),\\n    _ => throw(\\\"expected import item name\\\")\\n  }\\n}\\n\\nfn empty_import_items() -> Array[(String, Option[String])] {\\n  Array::slice([\\n    (\\\"_\\\", None)\\n  ], 0, 0)\\n}\\n\\nfn parse_binding_name(tokens: Array[Token], pos: Int) -> (String, Int) with { Error } {\\n  match peek(tokens, pos) {\\n    TIdent(name) => match peek(tokens, pos + 1) {\\n      TDoubleColon => match peek(tokens, pos + 2) {\\n        TIdent(member) => (String::concat(name, String::concat(\\\"::\\\", member)), pos + 3),\\n        _ => throw(\\\"expected qualified member name after '::'\\\")\\n      },\\n      _ => (name, pos + 1)\\n    },\\n    _ => throw(\\\"expected name after 'let'\\\")\\n  }\\n}\\n\\nexport fn collect_import_path(tokens: Array[Token], pos: Int, acc: String) -> (String, Int) with { Error } {\\n  match peek(tokens, pos) {\\n    TLBrace => (acc, pos),\\n    // #897: `as <mod> only { ... }` starts right after the path -- stop here\\n    // (mirrors the TLBrace/`@alias` early-outs above) so parse_import_path_tail\\n    // sees the 'as' token instead of this loop absorbing it as path text.\\n    TAs => (acc, pos),\\n    TDot => collect_import_path(tokens, pos + 1, String::concat(acc, \\\".\\\")),\\n    TDotDot => collect_import_path(tokens, pos + 1, String::concat(acc, \\\"..\\\")),\\n    TSlash => collect_import_path(tokens, pos + 1, String::concat(acc, \\\"/\\\")),\\n    // #769: a `@name` identifier only continues the PATH when it directly\\n    // follows a '/' (a scoped package segment, e.g. `lib/@vibe/json`). One\\n    // that follows a completed path with no separating '/' is the trailing\\n    // `import <path> @alias` alias token (parse_import_stmt peeks for it\\n    // right after this call returns) — stop here and let the caller see it,\\n    // instead of silently absorbing it into the path text and running on\\n    // into the NEXT statement's tokens looking for a '{' that will never\\n    // come (surfaced as \\\"unexpected token in import path: import\\\").\\n    TIdent(name) => if String::length(name) > 0 && String::char_code_at(name, 0) == '@' && !String::ends_with(acc, \\\"/\\\") {\\n      (acc, pos)\\n    } else {\\n      collect_import_path(tokens, pos + 1, String::concat(acc, name))\\n    },\\n    TMinus => collect_import_path(tokens, pos + 1, String::concat(acc, \\\"-\\\")),\\n    TModule => collect_import_path(tokens, pos + 1, String::concat(acc, \\\"module\\\")),\\n    TImpl => collect_import_path(tokens, pos + 1, String::concat(acc, \\\"impl\\\")),\\n    TType => collect_import_path(tokens, pos + 1, String::concat(acc, \\\"type\\\")),\\n    TMatch => collect_import_path(tokens, pos + 1, String::concat(acc, \\\"match\\\")),\\n    TTest => collect_import_path(tokens, pos + 1, String::concat(acc, \\\"test\\\")),\\n    _ => {\\n      let actual = tk_name(peek(tokens, pos))\\n      throw(String::concat(\\\"unexpected token in import path: \\\", actual))\\n    }\\n  }\\n}\\n\\nfn skip_bracketed_args(tokens: Array[Token], pos: Int) -> Int {\\n  match peek(tokens, pos) {\\n    TLBracket => {\\n      let mut bp = pos + 1\\n      let mut depth = 1\\n      while depth > 0 {\\n        match peek(tokens, bp) {\\n          TLBracket => {\\n            depth = depth + 1\\n            bp = bp + 1\\n          },\\n          TRBracket => {\\n            depth = depth - 1\\n            bp = bp + 1\\n          },\\n          TEof => {\\n            depth = 0\\n          },\\n          _ => {\\n            bp = bp + 1\\n          }\\n        }\\n      }\\n      bp\\n    },\\n    _ => pos\\n  }\\n}\\n\\n// #829: collect the declared type-parameter NAMES of a `[T, U, ...]` header\\n// (returning ([], pos) when there is no bracket). Mirrors parse_enum_stmt's\\n// inline collector: only depth-1 identifiers in name position are kept, so a\\n// bound like `[T: Eq]` still records just `T`.\\nfn parse_tparam_names(tokens: Array[Token], pos: Int) -> (Array[String], Int) {\\n  match peek(tokens, pos) {\\n    TLBracket => {\\n      let b = ArrayBuilder::new()\\n      let mut skip = pos + 1\\n      let mut depth = 1\\n      let mut expect_name = true\\n      while depth > 0 {\\n        match peek(tokens, skip) {\\n          TLBracket => {\\n            depth = depth + 1; skip = skip + 1\\n          },\\n          TRBracket => {\\n            depth = depth - 1; skip = skip + 1\\n          },\\n          TComma => {\\n            if depth == 1 {\\n              expect_name = true\\n            }\\n            skip = skip + 1\\n          },\\n          TIdent(nm) => {\\n            if depth == 1 && expect_name {\\n              ArrayBuilder::push(b, nm)\\n              expect_name = false\\n            }\\n            skip = skip + 1\\n          },\\n          TEof => {\\n            depth = 0\\n          },\\n          _ => {\\n            skip = skip + 1\\n          }\\n        }\\n      }\\n      (ArrayBuilder::freeze(b), skip)\\n    },\\n    _ => (Array::slice([\\n      \\\"\\\"\\n    ], 0, 0), pos)\\n  }\\n}\\n\\nfn collect_effect_names(tokens: Array[Token], pos: Int, acc: String) -> (String, Int) with { Error } {\\n  match peek(tokens, pos) {\\n    TRBrace => (acc, pos + 1),\\n    TIdent(name) => {\\n      let new_acc = if String::length(acc) == 0 {\\n        name\\n      } else \\\"\\\\{acc}, \\\\{name}\\\"\\n      match peek(tokens, pos + 1) {\\n        TComma => collect_effect_names(tokens, pos + 2, new_acc),\\n        TRBrace => (new_acc, pos + 2),\\n        _ => throw(\\\"expected ',' or '}' in effect list\\\")\\n      }\\n    },\\n    _ => throw(\\\"expected effect name or '}'\\\")\\n  }\\n}\\n\\nfn parse_type_impl(tokens: Array[Token], pos: Int, mode: Int) -> (TypeExpr, Int) with { Error } {\\n  let rec type_list_rest: (Array[Token], Int, ArrayBuilder[TypeExpr]) -> (Array[TypeExpr], Int) with { Error } = (tokens, pos, b) -> {\\n    match peek(tokens, pos) {\\n      TComma => match peek(tokens, pos + 1) {\\n        TRParen|TRBracket => (ArrayBuilder::freeze(b), pos + 1),\\n        _ => {\\n          let ts = match peek(tokens, pos + 1) {\\n            TIdent(_) => match peek(tokens, pos + 2) {\\n              TColon => pos + 3,\\n              TTilde => match peek(tokens, pos + 3) {\\n                TColon => pos + 4,\\n                _ => pos + 1\\n              },\\n              TQuestion => match peek(tokens, pos + 3) {\\n                TColon => pos + 4,\\n                _ => pos + 1\\n              },\\n              _ => pos + 1\\n            },\\n            _ => pos + 1\\n          }\\n          let (ty, next) = parse_type_impl(tokens, ts, 0)\\n          ArrayBuilder::push(b, ty)\\n          type_list_rest(tokens, next, b)\\n        }\\n      }\\n      ,\\n      _ => (ArrayBuilder::freeze(b), pos)\\n    }\\n  }\\n  // The optional `with { E1, E2 }` effect row after a function type's return.\\n  let parse_effect_suffix: (Array[Token], Int) -> (Option[String], Int) with { Error } = (tokens, rn) -> {\\n    match peek(tokens, rn) {\\n      TWith => {\\n        let with_pos = expect_tk(tokens, rn + 1, \\\"{\\\")\\n        let effect_name_pair = collect_effect_names(tokens, with_pos, \\\"\\\")\\n        (Some(effect_name_pair.0), effect_name_pair.1)\\n      },\\n      _ => (None, rn)\\n    }\\n  }\\n  if mode == 0 {\\n    // Leading-paren handling parses the group's TOP-LEVEL elements with arity\\n    // preserved, so a function parameter list is read by element count rather\\n    // than by reinterpreting a (already-unwrapped) tuple atom. This keeps\\n    // `(A, B) -> R` (two params) distinct from `((A, B)) -> R` (one tuple\\n    // param): the latter's outer group has a single element `(A, B)`. (#664-adjacent\\n    // type-annotation fix: previously both flattened to a two-param list.)\\n    match peek(tokens, pos) {\\n      TLParen => match peek(tokens, pos + 1) {\\n        TRParen => {\\n          // `()` — empty group: a zero-param function `() -> R`, else Unit.\\n          let after = pos + 2\\n          match peek(tokens, after) {\\n            TThinArrow => {\\n              let (ret, rn) = parse_type_impl(tokens, after + 1, 0)\\n              let eff = parse_effect_suffix(tokens, rn)\\n              (TyFn(empty_type_exprs(), ret, eff.0), eff.1)\\n            },\\n            _ => (TyUnit, after)\\n          }\\n        },\\n        _ => {\\n          // A first element may be a labeled param (`x: T` / `x~: T` / `x?: T`);\\n          // skip the label so the element's TYPE is what gets recorded.\\n          let ty_start = match peek(tokens, pos + 1) {\\n            TIdent(_) => match peek(tokens, pos + 2) {\\n              TColon => pos + 3,\\n              TTilde => match peek(tokens, pos + 3) {\\n                TColon => pos + 4,\\n                _ => pos + 1\\n              },\\n              TQuestion => match peek(tokens, pos + 3) {\\n                TColon => pos + 4,\\n                _ => pos + 1\\n              },\\n              _ => pos + 1\\n            },\\n            _ => pos + 1\\n          }\\n          let (first, n1) = parse_type_impl(tokens, ty_start, 0)\\n          let (elems, after) = match peek(tokens, n1) {\\n            TRParen => ([\\n              first\\n            ], n1 + 1),\\n            TComma => {\\n              let b = ArrayBuilder::new()\\n              ArrayBuilder::push(b, first)\\n              let (rest, end) = type_list_rest(tokens, n1, b)\\n              let en = expect_tk(tokens, end, \\\")\\\");\\n              (rest, en)\\n            },\\n            _ => throw(\\\"expected ')' or ',' in type\\\")\\n          }\\n          match peek(tokens, after) {\\n            TThinArrow => {\\n              let (ret, rn) = parse_type_impl(tokens, after + 1, 0)\\n              let eff = parse_effect_suffix(tokens, rn)\\n              (TyFn(elems, ret, eff.0), eff.1)\\n            },\\n            _ => {\\n              // Not a function: a single element is a parenthesized type (the\\n              // parens are just grouping); two or more elements are a tuple.\\n              let atom = if Array::length(elems) == 1 {\\n                Array::get(elems, 0)\\n              } else {\\n                TyTuple(elems)\\n              }\\n              match peek(tokens, after) {\\n                TQuestion => (TyApp(\\\"Option\\\", [\\n                  atom\\n                ]), after + 1),\\n                _ => (atom, after)\\n              }\\n            }\\n          }\\n        }\\n      },\\n      _ => {\\n        let (atom_ty, atom_next) = parse_type_impl(tokens, pos, 1)\\n        match peek(tokens, atom_next) {\\n          TThinArrow => {\\n            let (ret, rn) = parse_type_impl(tokens, atom_next + 1, 0)\\n            let eff = parse_effect_suffix(tokens, rn)\\n            (TyFn([\\n              atom_ty\\n            ], ret, eff.0), eff.1)\\n          },\\n          _ => (atom_ty, atom_next)\\n        }\\n      }\\n    }\\n  } else {\\n    let (base_ty, base_next) = match peek(tokens, pos) {\\n      TLParen => match peek(tokens, pos + 1) {\\n        TRParen => (TyUnit, pos + 2),\\n        _ => {\\n          let ty_start = match peek(tokens, pos + 1) {\\n            TIdent(_) => match peek(tokens, pos + 2) {\\n              TColon => pos + 3,\\n              TTilde => match peek(tokens, pos + 3) {\\n                TColon => pos + 4,\\n                _ => pos + 1\\n              },\\n              TQuestion => match peek(tokens, pos + 3) {\\n                TColon => pos + 4,\\n                _ => pos + 1\\n              },\\n              _ => pos + 1\\n            },\\n            _ => pos + 1\\n          }\\n          let (first, n1) = parse_type_impl(tokens, ty_start, 0)\\n          match peek(tokens, n1) {\\n            TRParen => (first, n1 + 1),\\n            TComma => {\\n              let b = ArrayBuilder::new()\\n              ArrayBuilder::push(b, first)\\n              let (rest, end) = type_list_rest(tokens, n1, b)\\n              let en = expect_tk(tokens, end, \\\")\\\");\\n              (TyTuple(rest), en)\\n            },\\n            _ => throw(\\\"expected ')' or ',' in type\\\")\\n          }\\n        }\\n      },\\n      TIdent(name) => match peek(tokens, pos + 1) {\\n        TLBracket => {\\n          let (first, n1) = parse_type_impl(tokens, pos + 2, 0)\\n          match peek(tokens, n1) {\\n            TRBracket => (TyApp(name, [\\n              first\\n            ]), n1 + 1),\\n            TComma => {\\n              let b = ArrayBuilder::new()\\n              ArrayBuilder::push(b, first)\\n              let (rest, end) = type_list_rest(tokens, n1, b)\\n              let en = expect_tk(tokens, end, \\\"]\\\");\\n              (TyApp(name, rest), en)\\n            },\\n            _ => throw(\\\"expected ']' or ',' in type application\\\")\\n          }\\n        },\\n        _ => (TyName(name), pos + 1)\\n      },\\n      _ => {\\n        let actual = tk_name(peek(tokens, pos))\\n        throw(\\\"expected type but got \\\\{actual}\\\")\\n      }\\n    }\\n    match peek(tokens, base_next) {\\n      TQuestion => (TyApp(\\\"Option\\\", [\\n        base_ty\\n      ]), base_next + 1),\\n      _ => (base_ty, base_next)\\n    }\\n  }\\n}\\n\\nexport fn parse_type(tokens: Array[Token], pos: Int) -> (TypeExpr, Int) with { Error } {\\n  parse_type_impl(tokens, pos, 0)\\n}\\n\\nfn parse_one_param(tokens: Array[Token], pos: Int) -> ((String, Option[TypeExpr]), Int) with { Error } {\\n  match peek(tokens, pos) {\\n    TIdent(name) => match peek(tokens, pos + 1) {\\n      TTilde => {\\n        let labeled_name = \\\"\\\\{name}~\\\"\\n        match peek(tokens, pos + 2) {\\n          TColon => {\\n            let (ty, tp) = parse_type_impl(tokens, pos + 3, 0);\\n            ((labeled_name, Some(ty)), tp)\\n          },\\n          _ => ((labeled_name, None), pos + 2)\\n        }\\n      },\\n      TQuestion => {\\n        let opt_name = \\\"\\\\{name}?\\\"\\n        match peek(tokens, pos + 2) {\\n          TColon => {\\n            let (ty, tp) = parse_type_impl(tokens, pos + 3, 0);\\n            ((opt_name, Some(ty)), tp)\\n          },\\n          _ => ((opt_name, None), pos + 2)\\n        }\\n      },\\n      TColon => {\\n        let (ty, tp) = parse_type_impl(tokens, pos + 2, 0);\\n        let tp2 = match peek(tokens, tp) {\\n          TColon => {\\n            let mut bp = tp + 1\\n            let mut bd = true\\n            while bd {\\n              match peek(tokens, bp) {\\n                TIdent(_) => {\\n                  bp = bp + 1; match peek(tokens, bp) {\\n                    TPlus => {\\n                      bp = bp + 1\\n                    },\\n                    _ => {\\n                      bd = false\\n                    }\\n                  }\\n                },\\n                _ => {\\n                  bd = false\\n                }\\n              }\\n            }\\n            bp\\n          },\\n          _ => tp\\n        }\\n        ((name, Some(ty)), tp2)\\n      },\\n      _ => ((name, None), pos + 1)\\n    },\\n    _ => {\\n      let actual = tk_name(peek(tokens, pos))\\n      throw(\\\"expected parameter name at #\\\\{pos} token=\\\\{actual}\\\")\\n    }\\n  }\\n}\\n\\nfn parse_param_cont(tokens: Array[Token], pos: Int, b: ArrayBuilder[(String, Option[TypeExpr])]) -> (Array[(String, Option[TypeExpr])], Int) with { Error } {\\n  match peek(tokens, pos) {\\n    TComma => match peek(tokens, pos + 1) {\\n      TRParen => (ArrayBuilder::freeze(b), pos + 2),\\n      _ => {\\n        let (p, pn) = parse_one_param(tokens, pos + 1)\\n        ArrayBuilder::push(b, p)\\n        parse_param_cont(tokens, pn, b)\\n      }\\n    },\\n    TRParen => (ArrayBuilder::freeze(b), pos + 1),\\n    _ => {\\n      let actual = tk_name(peek(tokens, pos))\\n      throw(\\\"expected ',' or ')' in param list at #\\\\{pos} token=\\\\{actual}\\\")\\n    }\\n  }\\n}\\n\\nfn parse_param_list(tokens: Array[Token], pos: Int) -> (Array[(String, Option[TypeExpr])], Int) with { Error } {\\n  match peek(tokens, pos) {\\n    TRParen => (empty_params(), pos + 1),\\n    _ => {\\n      let (f, fn1) = parse_one_param(tokens, pos)\\n      let b = ArrayBuilder::new()\\n      ArrayBuilder::push(b, f)\\n      parse_param_cont(tokens, fn1, b)\\n    }\\n  }\\n}\\n\\nfn parse_struct_field(tokens: Array[Token], pos: Int) -> ((String, TypeExpr), Bool, Int) with { Error } {\\n  let (is_mut, p) = match peek(tokens, pos) {\\n    TMut => (true, pos + 1),\\n    _ => (false, pos)\\n  }\\n  match peek(tokens, p) {\\n    TIdent(name) => {\\n      let cn = expect_tk(tokens, p + 1, \\\":\\\")\\n      let (ty, next) = parse_type_impl(tokens, cn, 0);\\n      ((name, ty), is_mut, next)\\n    },\\n    _ => throw(\\\"expected field name\\\")\\n  }\\n}\\n\\nfn is_lambda_start_impl(tokens: Array[Token], pos: Int, depth: Int, bdepth: Int, has_colon: Bool) -> Bool {\\n  match peek(tokens, pos) {\\n    // A colon only signals an annotated lambda param when it sits directly\\n    // inside the candidate parens — a colon inside BRACKETS is a slice bound\\n    // (`raw_path[0: 2]`), and counting it made `(len >= 2 && s[0: 2] == x) {`\\n    // (a parenthesized if-condition followed by the if body's brace) parse as\\n    // a no-arrow lambda, failing with \\\"expected ',' or ')' in param list\\\".\\n    TColon => if depth == 0 && bdepth == 0 {\\n      is_lambda_start_impl(tokens, pos + 1, depth, bdepth, true)\\n    } else is_lambda_start_impl(tokens, pos + 1, depth, bdepth, has_colon),\\n    TRParen => if depth == 0 {\\n      match peek(tokens, pos + 1) {\\n        TThinArrow => true,\\n        TLBrace => has_colon,\\n        _ => false\\n      }\\n    } else is_lambda_start_impl(tokens, pos + 1, depth - 1, bdepth, has_colon),\\n    TLParen => is_lambda_start_impl(tokens, pos + 1, depth + 1, bdepth, has_colon),\\n    TLBracket => is_lambda_start_impl(tokens, pos + 1, depth, bdepth + 1, has_colon),\\n    TRBracket => is_lambda_start_impl(tokens, pos + 1, depth, bdepth - 1, has_colon),\\n    TEof => false,\\n    _ => is_lambda_start_impl(tokens, pos + 1, depth, bdepth, has_colon)\\n  }\\n}\\n\\nfn is_lambda_start(tokens: Array[Token], pos: Int) -> Bool {\\n  is_lambda_start_impl(tokens, pos, 0, 0, false)\\n}\\n\\nfn parse_ctor_types_rest(tokens: Array[Token], pos: Int, b: ArrayBuilder[TypeExpr]) -> (Array[TypeExpr], Int) with { Error } {\\n  match peek(tokens, pos) {\\n    TComma => {\\n      let (ty, next) = parse_type_impl(tokens, pos + 1, 0)\\n      ArrayBuilder::push(b, ty)\\n      parse_ctor_types_rest(tokens, next, b)\\n    },\\n    TRParen => (ArrayBuilder::freeze(b), pos + 1),\\n    _ => throw(\\\"expected ',' or ')' in constructor types\\\")\\n  }\\n}\\n\\nfn parse_enum_ctor(tokens: Array[Token], pos: Int) -> ((String, Array[TypeExpr]), Int) with { Error } {\\n  match peek(tokens, pos) {\\n    TIdent(name) => match peek(tokens, pos + 1) {\\n      TLParen => match peek(tokens, pos + 2) {\\n        TRParen => ((name, empty_type_exprs()), pos + 3),\\n        _ => {\\n          let (first, n1) = parse_type_impl(tokens, pos + 2, 0)\\n          let b = ArrayBuilder::new()\\n          ArrayBuilder::push(b, first)\\n          let (types, end) = parse_ctor_types_rest(tokens, n1, b);\\n          ((name, types), end)\\n        }\\n      },\\n      _ => ((name, empty_type_exprs()), pos + 1)\\n    },\\n    _ => throw(\\\"expected constructor name\\\")\\n  }\\n}\\n\\nfn parse_enum_ctors_rest(tokens: Array[Token], pos: Int, b: ArrayBuilder[(String, Array[TypeExpr])]) -> (Array[(String, Array[TypeExpr])], Int) with { Error } {\\n  match peek(tokens, pos) {\\n    TSemicolon => match peek(tokens, pos + 1) {\\n      TRBrace => (ArrayBuilder::freeze(b), pos + 2),\\n      _ => {\\n        let (ctor, next) = parse_enum_ctor(tokens, pos + 1)\\n        ArrayBuilder::push(b, ctor)\\n        parse_enum_ctors_rest(tokens, next, b)\\n      }\\n    },\\n    // 0.3.0 redundant-syntax removal: ',' is no longer a declaration-body\\n    // separator (canonical form is ';'; printer/docs/compiler tree all use it).\\n    // The \\\" at #pos\\\" suffix anchors the located wrapper (#816) at the comma.\\n    TComma => throw(\\\"use ';' to separate declaration members; ',' was removed in 0.3.0 at #\\\\{pos}\\\"),\\n    TRBrace => (ArrayBuilder::freeze(b), pos + 1),\\n    _ => throw(\\\"expected ';' or '}' in enum at #\\\\{pos}\\\")\\n  }\\n}\\n\\nfn parse_enum_ctors(tokens: Array[Token], pos: Int) -> (Array[(String, Array[TypeExpr])], Int) with { Error } {\\n  match peek(tokens, pos) {\\n    TRBrace => (empty_ctors(), pos + 1),\\n    _ => {\\n      let (first, next) = parse_enum_ctor(tokens, pos)\\n      let b = ArrayBuilder::new()\\n      ArrayBuilder::push(b, first)\\n      parse_enum_ctors_rest(tokens, next, b)\\n    }\\n  }\\n}\\n\\nfn parse_enum_stmt(tokens: Array[Token], pos: Int, exported: Bool) -> (Stmt, Int) with { Error } {\\n  match peek(tokens, pos) {\\n    TIdent(name) => {\\n      let (params, after_name) = match peek(tokens, pos + 1) {\\n        TLBracket => {\\n          let b = ArrayBuilder::new()\\n          let mut skip = pos + 2\\n          let mut depth = 1\\n          let mut expect_name = true\\n          while depth > 0 {\\n            match peek(tokens, skip) {\\n              TLBracket => {\\n                depth = depth + 1; skip = skip + 1\\n              },\\n              TRBracket => {\\n                depth = depth - 1; skip = skip + 1\\n              },\\n              TComma => {\\n                if depth == 1 {\\n                  expect_name = true\\n                }\\n                skip = skip + 1\\n              },\\n              TIdent(nm) => {\\n                if depth == 1 && expect_name {\\n                  ArrayBuilder::push(b, nm)\\n                  expect_name = false\\n                }\\n                skip = skip + 1\\n              },\\n              _ => {\\n                skip = skip + 1\\n              }\\n            }\\n          }\\n          (ArrayBuilder::freeze(b), skip)\\n        },\\n        _ => (Array::slice([\\n          \\\"\\\"\\n        ], 0, 0), pos + 1)\\n      }\\n      let br = expect_tk(tokens, after_name, \\\"{\\\")\\n      let (ctors, end) = parse_enum_ctors(tokens, br);\\n      let (derives, final_pos) = parse_derive_names(tokens, end)\\n      (SEnum(exported, name, params, ctors, derives), final_pos)\\n    },\\n    _ => throw(\\\"expected enum name\\\")\\n  }\\n}\\n\\nfn parse_suberror_stmt(tokens: Array[Token], pos: Int, exported: Bool) -> (Stmt, Int) with { Error } {\\n  match peek(tokens, pos) {\\n    TIdent(name) => match peek(tokens, pos + 1) {\\n      TLParen => match peek(tokens, pos + 2) {\\n        TRParen => {\\n          let b = ArrayBuilder::new()\\n          ArrayBuilder::push(b, (name, empty_type_exprs()))\\n          (SSuberror(exported, name, ArrayBuilder::freeze(b)), pos + 3)\\n        },\\n        _ => {\\n          let (first, n1) = parse_type_impl(tokens, pos + 2, 0)\\n          let args_b = ArrayBuilder::new()\\n          ArrayBuilder::push(args_b, first)\\n          let (args, end) = parse_ctor_types_rest(tokens, n1, args_b)\\n          let ctors_b = ArrayBuilder::new()\\n          ArrayBuilder::push(ctors_b, (name, args))\\n          (SSuberror(exported, name, ArrayBuilder::freeze(ctors_b)), end)\\n        }\\n      },\\n      TLBrace => {\\n        let (ctors, end) = parse_enum_ctors(tokens, pos + 2);\\n        (SSuberror(exported, name, ctors), end)\\n      },\\n      _ => throw(\\\"expected '(' or '{' after suberror name\\\")\\n    },\\n    _ => throw(\\\"expected suberror name\\\")\\n  }\\n}\\n\\nfn parse_impl_bound_names(tokens: Array[Token], pos: Int) -> (Array[String], Int) with { Error } {\\n  let b = ArrayBuilder::new()\\n  let mut p = pos\\n  let mut done = false\\n  while !done {\\n    match peek(tokens, p) {\\n      TIdent(name) => {\\n        ArrayBuilder::push(b, name)\\n        p = p + 1\\n        match peek(tokens, p) {\\n          TPlus => {\\n            p = p + 1\\n          },\\n          _ => {\\n            done = true\\n          }\\n        }\\n      },\\n      _ => throw(\\\"expected trait bound name\\\")\\n    }\\n  }\\n  (ArrayBuilder::freeze(b), p)\\n}\\n\\nfn parse_impl_type_params(tokens: Array[Token], pos: Int) -> (Array[String], Array[(String, Array[String])], Int) with { Error } {\\n  let names = ArrayBuilder::new()\\n  let bounds = ArrayBuilder::new()\\n  let mut p = pos\\n  while true {\\n    match peek(tokens, p) {\\n      TRBracket => {\\n        p = p + 1\\n        break\\n      },\\n      TIdent(name) => {\\n        ArrayBuilder::push(names, name)\\n        p = p + 1\\n        match peek(tokens, p) {\\n          TColon => {\\n            let (bound_names, next) = parse_impl_bound_names(tokens, p + 1)\\n            ArrayBuilder::push(bounds, (name, bound_names))\\n            p = next\\n          },\\n          _ => ()\\n        }\\n        match peek(tokens, p) {\\n          TComma => {\\n            p = p + 1\\n          },\\n          TRBracket => {\\n            p = p + 1\\n            break\\n          },\\n          _ => throw(\\\"expected ',' or ']' in impl type params\\\")\\n        }\\n      },\\n      _ => throw(\\\"expected type parameter name or ']'\\\")\\n    }\\n  }\\n  (ArrayBuilder::freeze(names), ArrayBuilder::freeze(bounds), p)\\n}\\n\\nfn parse_impl_stmt(tokens: Array[Token], pos: Int) -> (Stmt, Int) with { Error } {\\n  let (type_params, type_bounds, after_tp) = match peek(tokens, pos) {\\n    TLBracket => parse_impl_type_params(tokens, pos + 1),\\n    _ => (_no_tp(), _no_tb(), pos)\\n  }\\n  match peek(tokens, after_tp) {\\n    TIdent(trait_name) => {\\n      let fp = expect_tk(tokens, after_tp + 1, \\\"for\\\")\\n      match peek(tokens, fp) {\\n        TIdent(type_name) => {\\n          // Return the position at the impl body `{` (or the next token when\\n          // the impl is body-less). The caller (parser.vibe) either expands the\\n          // method block into `Type::method` let-bindings or skips it; this\\n          // parser layer cannot reach `parse_expr` to parse method bodies.\\n          let after_targs = skip_bracketed_args(tokens, fp + 1)\\n          (SImpl(type_params, type_bounds, trait_name, type_name), after_targs)\\n        },\\n        _ => throw(\\\"expected type name after 'for'\\\")\\n      }\\n    },\\n    _ => throw(\\\"expected trait name after 'impl'\\\")\\n  }\\n}\\n\\nfn parse_type_params_list(tokens: Array[Token], pos: Int) -> (Array[String], Int) with { Error } {\\n  let b = ArrayBuilder::new()\\n  let mut p = pos\\n  while true {\\n    match peek(tokens, p) {\\n      TRBracket => {\\n        p = p + 1\\n        break\\n      },\\n      TIdent(name) => {\\n        ArrayBuilder::push(b, name)\\n        p = p + 1\\n        match peek(tokens, p) {\\n          TComma => {\\n            p = p + 1\\n          },\\n          TRBracket => {\\n            p = p + 1\\n            break\\n          },\\n          _ => throw(\\\"expected ',' or ']' in type params\\\")\\n        }\\n      },\\n      _ => throw(\\\"expected type parameter name or ']'\\\")\\n    }\\n  }\\n  (ArrayBuilder::freeze(b), p)\\n}\\n\\n// Parse effect declaration: effect Name[T] { Op(Args) -> Ret; ... }\\nfn parse_effect_stmt(tokens: Array[Token], pos: Int, exported: Bool) -> (Stmt, Int) with { Error } {\\n  match peek(tokens, pos) {\\n    TIdent(name) => {\\n      let (type_params, after_params) = match peek(tokens, pos + 1) {\\n        TLBracket => parse_type_params_list(tokens, pos + 2),\\n        _ => (ArrayBuilder::freeze(ArrayBuilder::new()), pos + 1)\\n      }\\n      let br = expect_tk(tokens, after_params, \\\"{\\\")\\n      let ops_b = ArrayBuilder::new()\\n      let mut p = br\\n      while true {\\n        match peek(tokens, p) {\\n          TRBrace => {\\n            p = p + 1\\n            break\\n          },\\n          TIdent(op_name) => {\\n            let (params, after_op_params) = match peek(tokens, p + 1) {\\n              TLParen => {\\n                let (params_ty, after_paren) = parse_type_impl(tokens, p + 1, 1)\\n                let params = match params_ty {\\n                  TyUnit => empty_type_exprs(),\\n                  TyTuple(elems) => elems,\\n                  _ => [\\n                    params_ty\\n                  ]\\n                }\\n                (params, after_paren)\\n              },\\n              _ => (empty_type_exprs(), p + 1)\\n            }\\n            let arrow_pos = expect_tk(tokens, after_op_params, \\\"->\\\")\\n            let (ret_type, after_ret) = parse_type_impl(tokens, arrow_pos, 0)\\n            ArrayBuilder::push(ops_b, (op_name, params, ret_type))\\n            p = match peek(tokens, after_ret) {\\n              TSemicolon => after_ret + 1,\\n              _ => after_ret\\n            }\\n          },\\n          _ => throw(\\\"expected effect operation name or '}'\\\")\\n        }\\n      }\\n      (SEffectDef(exported, name, type_params, ArrayBuilder::freeze(ops_b)), p)\\n    },\\n    _ => throw(\\\"expected effect name\\\")\\n  }\\n}\\n\\nfn parse_type_alias_stmt(tokens: Array[Token], pos: Int, exported: Bool) -> (Stmt, Int) with { Error } {\\n  match peek(tokens, pos) {\\n    TIdent(name) => {\\n      let (params, after_name) = match peek(tokens, pos + 1) {\\n        TLBracket => parse_type_params_list(tokens, pos + 2),\\n        _ => (Array::slice([\\n          \\\"\\\"\\n        ], 0, 0), pos + 1)\\n      }\\n      let ep = expect_tk(tokens, after_name, \\\"=\\\")\\n      let (ty, next) = parse_type_impl(tokens, ep, 0);\\n      (STypeAlias(exported, name, params, ty), next)\\n    },\\n    _ => throw(\\\"expected type alias name\\\")\\n  }\\n}\\n\\nfn parse_impl_stmt_dispatch(tokens: Array[Token], pos: Int) -> (Stmt, Int) with { Error } {\\n  parse_impl_stmt(tokens, pos)\\n}\\n\\nfn push_mut_name(mb: ArrayBuilder[String], field: (String, TypeExpr), is_mut: Bool) -> Unit {\\n  if is_mut {\\n    let (fname, _) = field\\n    ArrayBuilder::push(mb, fname)\\n  } else {\\n    ()\\n  }\\n}\\n\\nfn parse_struct_fields_rest(tokens: Array[Token], pos: Int, b: ArrayBuilder[(String, TypeExpr)], mb: ArrayBuilder[String]) -> (Array[(String, TypeExpr)], Array[String], Int) with { Error } {\\n  match peek(tokens, pos) {\\n    TSemicolon => match peek(tokens, pos + 1) {\\n      TRBrace => (ArrayBuilder::freeze(b), ArrayBuilder::freeze(mb), pos + 2),\\n      _ => {\\n        let (field, is_mut, next) = parse_struct_field(tokens, pos + 1)\\n        ArrayBuilder::push(b, field)\\n        push_mut_name(mb, field, is_mut)\\n        parse_struct_fields_rest(tokens, next, b, mb)\\n      }\\n    },\\n    // 0.3.0 redundant-syntax removal: ',' is no longer a declaration-body\\n    // separator (see parse_enum_ctors_rest).\\n    TComma => throw(\\\"use ';' to separate declaration members; ',' was removed in 0.3.0 at #\\\\{pos}\\\"),\\n    TRBrace => (ArrayBuilder::freeze(b), ArrayBuilder::freeze(mb), pos + 1),\\n    _ => throw(\\\"expected ';' or '}' in struct at #\\\\{pos}\\\")\\n  }\\n}\\n\\nfn parse_struct_fields(tokens: Array[Token], pos: Int) -> (Array[(String, TypeExpr)], Array[String], Int) with { Error } {\\n  match peek(tokens, pos) {\\n    TRBrace => (empty_fields(), Array::slice([\\n      \\\"\\\"\\n    ], 0, 0), pos + 1),\\n    _ => {\\n      let (first, is_mut, next) = parse_struct_field(tokens, pos)\\n      let b = ArrayBuilder::new()\\n      let mb = ArrayBuilder::new()\\n      ArrayBuilder::push(b, first)\\n      push_mut_name(mb, first, is_mut)\\n      parse_struct_fields_rest(tokens, next, b, mb)\\n    }\\n  }\\n}\\n\\nfn parse_struct_stmt(tokens: Array[Token], pos: Int, exported: Bool) -> (Stmt, Int) with { Error } {\\n  match peek(tokens, pos) {\\n    TIdent(name) => {\\n      // #829: keep the `[T]` type-parameter names (previously skipped and\\n      // discarded) so the checker can instantiate generic struct literals.\\n      let (tparams, after_name) = parse_tparam_names(tokens, pos + 1)\\n      let br = expect_tk(tokens, after_name, \\\"{\\\")\\n      let (fields, mut_names, end) = parse_struct_fields(tokens, br);\\n      let (derives, final_pos) = parse_derive_names(tokens, end)\\n      (SStruct(exported, name, fields, derives, mut_names, tparams), final_pos)\\n    },\\n    _ => throw(\\\"expected struct name\\\")\\n  }\\n}\\n\\n//# Misc\\n\\nexport {\\n  _no_tb, _no_tp, collect_effect_names, collect_import_path, empty_arms, empty_exprs, empty_fields, empty_import_items, empty_params, empty_pats, empty_type_exprs, expect_tk, is_expr_end_token, is_lambda_start, is_non_pipe_infix, is_tk, mode_block, mode_for_in, mode_handle, mode_if, mode_match, mode_while, parse_binding_name, parse_effect_stmt, parse_enum_stmt, parse_impl_stmt_dispatch, parse_import_item, parse_param_list, parse_pattern, parse_struct_field, parse_struct_stmt, parse_suberror_stmt, parse_tparam_names, parse_trait_stmt, parse_type, parse_type_alias_stmt, parse_type_impl, parse_derive_names, peek, skip_derive, skip_semi, tk_name\\n}\\n\\nexport {\\n  peek, is_tk, _no_tb, _no_tp, mode_if, tk_name, expect_tk, skip_semi, skip_derive, parse_derive_names, empty_arms, empty_pats, mode_block, mode_match, mode_while, parse_type, empty_exprs, mode_for_in, mode_handle, empty_fields, empty_params, parse_pattern, is_lambda_start, parse_enum_stmt, parse_type_impl, empty_type_exprs, parse_param_list, parse_trait_stmt, is_expr_end_token, is_non_pipe_infix, parse_effect_stmt, parse_import_item, parse_struct_stmt, parse_tparam_names, empty_import_items, parse_binding_name, parse_struct_field, collect_import_path, parse_suberror_stmt, collect_effect_names, parse_type_alias_stmt, parse_impl_stmt_dispatch\\n}\\n\\nexport {\\n  peek, is_tk, _no_tb, _no_tp, mode_if, tk_name, expect_tk, skip_semi, empty_arms, empty_pats, mode_block, mode_match, mode_while, parse_type, empty_exprs, mode_for_in, mode_handle, skip_derive, parse_derive_names, empty_fields, empty_params, parse_pattern, is_lambda_start, parse_enum_stmt, parse_type_impl, empty_type_exprs, parse_param_list, parse_trait_stmt, is_expr_end_token, is_non_pipe_infix, parse_effect_stmt, parse_import_item, parse_struct_stmt, parse_tparam_names, empty_import_items, parse_binding_name, parse_struct_field, collect_import_path, parse_suberror_stmt, collect_effect_names, parse_type_alias_stmt, parse_impl_stmt_dispatch\\n}\\n\")\n}\n\nlet cli_adapter_source_8 = () -> (String, String) {\n  (\"lib/@vibe/parser/parser_expr_primary.vibe\",\n\"//# Imports\\n\\nimport ../ast {\\n  Expr, Pat, TypeExpr\\n}\\n\\nimport ./parser_base.vibe {\\n  _no_tb, _no_tp, collect_effect_names, empty_exprs, empty_type_exprs, expect_tk, is_lambda_start, parse_param_list, parse_type_impl, peek, tk_name\\n}\\n\\nimport ./token.vibe {\\n  Token\\n}\\n\\nimport ./lexer.vibe {\\n  lex_with_offsets\\n}\\n\\n//# Functions\\n\\n// #947: rewrite every LOCATED offset in an interpolation fragment's parsed\\n// Expr tree (EIdent, ECall, ELet/ELetMut, EDot, ...) through `f`, so hover /\\n// go-to-def / rename on an identifier referenced inside `\\\\{...}` resolves to\\n// its real file position (see `remap_frag_off` below for the mapping used).\\n// Every Expr variant is enumerated so a new variant is a compile error here,\\n// keeping this walker in sync with the AST. Non-located constructs\\n// (string/int/bool literals, bare structural nodes) pass through unchanged;\\n// -1 (synthetic/non-located) offsets stay -1 and never reach `f`.\\nfn map_located_off(off: Int, f: (Int) -> Int) -> Int {\\n  if off < 0 {\\n    off\\n  } else {\\n    f(off)\\n  }\\n}\\n\\nfn map_expr_offsets(expr: Expr, f: (Int) -> Int) -> Expr {\\n  {\\n    match expr {\\n      EInt(_) => expr,\\n      EFloat(_) => expr,\\n      EString(_) => expr,\\n      EBool(_) => expr,\\n      EUnit => expr,\\n      EIdent(name, off) => EIdent(name, map_located_off(off, f)),\\n      ETuple(items) => ETuple(map_exprs(items, f)),\\n      EArray(items) => EArray(map_exprs(items, f)),\\n      ERecord(rn, fields, targs) => ERecord(rn, map_field_exprs(fields, f), targs),\\n      EIf(c, t, e) => EIf(map_expr_offsets(c, f), map_expr_offsets(t, f), map_expr_offsets(e, f)),\\n      ELet(n, v, b, soff) => ELet(n, map_expr_offsets(v, f), map_expr_offsets(b, f), map_located_off(soff, f)),\\n      ELetRec(n, v, b) => ELetRec(n, map_expr_offsets(v, f), map_expr_offsets(b, f)),\\n      ELetMut(n, v, b, soff) => ELetMut(n, map_expr_offsets(v, f), map_expr_offsets(b, f), map_located_off(soff, f)),\\n      EAssign(n, v, b) => EAssign(n, map_expr_offsets(v, f), map_expr_offsets(b, f)),\\n      EAssignOp(n, op, v, b) => EAssignOp(n, op, map_expr_offsets(v, f), map_expr_offsets(b, f)),\\n      ESeq(a, b) => ESeq(map_expr_offsets(a, f), map_expr_offsets(b, f)),\\n      EMatch(s, arms) => EMatch(map_expr_offsets(s, f), map_arm_exprs(arms, f)),\\n      EHandle(s, arms) => EHandle(map_expr_offsets(s, f), map_arm_exprs(arms, f)),\\n      EWhile(c, b) => EWhile(map_expr_offsets(c, f), map_expr_offsets(b, f)),\\n      ELoop(params, b) => ELoop(map_loop_param_exprs(params, f), map_expr_offsets(b, f)),\\n      EForIn(n, idx, it, b) => EForIn(n, idx, map_expr_offsets(it, f), map_expr_offsets(b, f)),\\n      ECall(callee, args, off) => ECall(map_expr_offsets(callee, f), map_exprs(args, f), map_located_off(off, f)),\\n      EBinOp(op, l, r) => EBinOp(op, map_expr_offsets(l, f), map_expr_offsets(r, f)),\\n      EUnaryOp(op, e) => EUnaryOp(op, map_expr_offsets(e, f)),\\n      EFn(tp, tb, params, ret, eff, body) => EFn(tp, tb, params, ret, eff, map_expr_offsets(body, f)),\\n      EDot(e, field, off, fdoff) => EDot(map_expr_offsets(e, f), field, map_located_off(off, f), map_located_off(fdoff, f)),\\n      ELabeledArg(l, n, v) => ELabeledArg(l, n, map_expr_offsets(v, f)),\\n      EReturn(e) => EReturn(map_expr_offsets(e, f)),\\n      EBreak(opt) => match opt {\\n        Some(v) => EBreak(Some(map_expr_offsets(v, f))),\\n        None => expr\\n      },\\n      EContinue(args) => EContinue(map_exprs(args, f)),\\n      EMap(fields) => EMap(map_field_exprs(fields, f)),\\n      ESpread(e) => ESpread(map_expr_offsets(e, f)),\\n      EStringInterp(_) => expr\\n    }\\n  }\\n}\\n\\nfn map_exprs(items: Array[Expr], f: (Int) -> Int) -> Array[Expr] {\\n  for it in items {\\n    map_expr_offsets(it, f)\\n  }\\n}\\n\\nfn map_field_exprs(fields: Array[(String, Expr)], f: (Int) -> Int) -> Array[(String, Expr)] {\\n  for fld in fields {\\n    let (n, v) = fld\\n    (n, map_expr_offsets(v, f))\\n  }\\n}\\n\\nfn map_arm_exprs(arms: Array[(Pat, Expr)], f: (Int) -> Int) -> Array[(Pat, Expr)] {\\n  for a in arms {\\n    let (p, e) = a\\n    (p, map_expr_offsets(e, f))\\n  }\\n}\\n\\nfn map_loop_param_exprs(params: Array[(String, Expr)], f: (Int) -> Int) -> Array[(String, Expr)] {\\n  for p in params {\\n    let (n, init) = p\\n    (n, map_expr_offsets(init, f))\\n  }\\n}\\n\\n// Invert `offset_at(outer_starts, p)`: parse_recur (a closure over the\\n// OUTER file's token-starts table) anchors every located node in a\\n// fragment parse at `outer_starts[p]` where p is a FRAGMENT token index —\\n// meaningless as a file position (Codex P2 on #975; only the\\n// single-token-at-fragment-start case lined up by accident). outer_starts\\n// is nondecreasing, so binary-search the smallest p with\\n// outer_starts[p] == off, then re-anchor at the fragment's OWN start for\\n// that token (frag_starts[p], from lex_with_offsets on the fragment text)\\n// plus the fragment's absolute base. Anything unrecoverable becomes -1\\n// (unlocated) rather than pointing at the wrong character.\\nfn remap_frag_off(off: Int, outer_starts: Array[Int], frag_starts: Array[Int], frag_base: Int) -> Int {\\n  let n = Array::length(outer_starts)\\n  let mut lo = 0\\n  let mut hi = n - 1\\n  let mut found = -1\\n  while lo <= hi {\\n    let mid = (lo + hi) / 2\\n    let v = Array::get(outer_starts, mid)\\n    if v < off {\\n      lo = mid + 1\\n    } else {\\n      if v == off {\\n        found = mid\\n      } else {\\n        ()\\n      }\\n      hi = mid - 1\\n    }\\n  }\\n  if found >= 0 && found < Array::length(frag_starts) {\\n    frag_base + Array::get(frag_starts, found)\\n  } else {\\n    -1\\n  }\\n}\\n\\n// Desugar a string-interpolation token's parts into a `String::concat` chain.\\n// Parts alternate literal/expression by index (even = literal chunk, odd =\\n// embedded expression SOURCE). The embedded expression is lexed and parsed as a\\n// full expression (not treated as a bare identifier), so `\\\"\\\\{1 + 1}\\\"`,\\n// `\\\"\\\\{f(x)}\\\"`, `\\\"\\\\{p.field}\\\"` etc. all work — matching the documented behavior.\\n// Each interpolated value is rendered via `__to_string`. Bare-identifier parts\\n// parse to the same `EIdent` the previous (ident-only) path produced, so\\n// existing interpolations are unchanged.\\n//\\n// `offsets` (#947) carries, in lockstep with `parts`, the absolute source\\n// offset of each part's start (-1 for literal/even parts, which don't need\\n// one). Each fragment is lexed in isolation with its OWN token-starts table\\n// (lex_with_offsets), parsed via `parse_recur` — which anchors located nodes\\n// using the OUTER file's starts table it closed over, i.e. at\\n// outer_starts[fragment-token-index] — and then remapped node-by-node via\\n// `remap_frag_off` (invert outer_starts, re-anchor at frag_starts[p] +\\n// fragment base), so identifiers referenced inside `\\\\{...}` carry their real\\n// file position for any fragment shape (leading spaces, multi-token\\n// expressions), not just a single token at the fragment start.\\nfn build_interp_expr(parts: Array[String], offsets: Array[Int], outer_starts: Array[Int], parse_recur: (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> Expr with { Error } {\\n  let concat_expr: (Expr, Expr) -> Expr = (a, b) -> {\\n    ECall(EIdent(\\\"String::concat\\\", -1), [\\n      a,\\n      b\\n    ], -1)\\n  }\\n  let plen = Array::length(parts)\\n  let mut result = EString(\\\"\\\")\\n  let mut has_val = false\\n  let mut i = 0\\n  while i < plen {\\n    let part = Array::get(parts, i)\\n    if i % 2 == 0 {\\n      if String::length(part) > 0 {\\n        let piece = EString(part)\\n        result = if has_val {\\n          concat_expr(result, piece)\\n        } else {\\n          piece\\n        }\\n        has_val = true\\n      } else {\\n        ()\\n      }\\n    } else {\\n      let (ftoks, fstarts, _fends) = lex_with_offsets(part)\\n      let (pe0, _) = parse_recur(ftoks, 0, 0)\\n      let frag_off = if i < Array::length(offsets) { Array::get(offsets, i) } else { -1 }\\n      let pe = if frag_off >= 0 {\\n        map_expr_offsets(pe0, (o) -> remap_frag_off(o, outer_starts, fstarts, frag_off))\\n      } else {\\n        pe0\\n      }\\n      let piece = ECall(EIdent(\\\"__to_string\\\", -1), [\\n        pe\\n      ], -1)\\n      result = if has_val {\\n        concat_expr(result, piece)\\n      } else {\\n        piece\\n      }\\n      has_val = true\\n    }\\n    i = i + 1\\n  }\\n  result\\n}\\n\\n// Transform break(val) and continue(args) inside a loop body for desugaring.\\n// break(val) → { __loop_result = val; break }\\n// continue(a, b) → { let __lt0 = a; let __lt1 = b; p0 = __lt0; p1 = __lt1; continue }\\nfn desugar_loop_body(expr: Expr, param_names: Array[String]) -> Expr {\\n  match expr {\\n    EBreak(opt) => match opt {\\n      Some(val) => EAssign(\\\"__loop_result\\\", desugar_loop_body(val, param_names), EBreak(None)),\\n      None => EBreak(None)\\n    },\\n    EContinue(args) => {\\n      if Array::length(args) == 0 {\\n        EContinue(args)\\n      } else {\\n        let nargs = Array::length(args)\\n        let nparams = Array::length(param_names)\\n        if nargs > nparams {\\n          // Guard: more args than params → use only param count to avoid OOB\\n          EContinue(args)\\n        } else {\\n        let mut result = EContinue(Array::slice([EUnit], 0, 0))\\n        let mut ci = nargs - 1\\n        while ci >= 0 {\\n          result = EAssign(Array::get(param_names, ci), EIdent(String::concat(\\\"__lt\\\", __to_string(ci)), -1), result)\\n          ci = ci - 1\\n        }\\n        let mut ci2 = nargs - 1\\n        while ci2 >= 0 {\\n          result = ELet(String::concat(\\\"__lt\\\", __to_string(ci2)), desugar_loop_body(Array::get(args, ci2), param_names), result, -1)\\n          ci2 = ci2 - 1\\n        }\\n        result\\n        }\\n      }\\n    },\\n    EWhile(_, _) => expr,\\n    ELoop(_, _) => expr,\\n    EFn(_, _, _, _, _, _) => expr,\\n    EIf(c, t, e) => EIf(desugar_loop_body(c, param_names), desugar_loop_body(t, param_names), desugar_loop_body(e, param_names)),\\n    ELet(n, v, b, soff) => ELet(n, desugar_loop_body(v, param_names), desugar_loop_body(b, param_names), soff),\\n    ELetMut(n, v, b, soff) => ELetMut(n, desugar_loop_body(v, param_names), desugar_loop_body(b, param_names), soff),\\n    ESeq(a, b) => ESeq(desugar_loop_body(a, param_names), desugar_loop_body(b, param_names)),\\n    EAssign(n, v, c) => EAssign(n, desugar_loop_body(v, param_names), desugar_loop_body(c, param_names)),\\n    // #808: recurse into match/handle arm bodies so `break v` / `continue(args)`\\n    // inside an arm get the loop desugar (the raw EBreak/EContinue otherwise\\n    // reach codegen with their payloads dropped — `continue(i + 1)` looped\\n    // without updating `i` = compile-clean infinite loop). The old pass-through\\n    // was a workaround for the retired MoonBit host (#594) crashing on\\n    // (Pat, Expr) tuple ops; the selfhost parser handles arm tuples fine\\n    // (same idiom as expand_interp.vibe). Patterns are left untouched.\\n    EMatch(s, arms) => EMatch(desugar_loop_body(s, param_names), for a in arms {\\n      let (p, ex) = a\\n      (p, desugar_loop_body(ex, param_names))\\n    }),\\n    EHandle(body, arms) => EHandle(desugar_loop_body(body, param_names), for a in arms {\\n      let (p, ex) = a\\n      (p, desugar_loop_body(ex, param_names))\\n    }),\\n    EBinOp(op, l, r) => EBinOp(op, desugar_loop_body(l, param_names), desugar_loop_body(r, param_names)),\\n    ECall(_, _, _) => expr,\\n    ELetRec(n, v, b) => ELetRec(n, desugar_loop_body(v, param_names), desugar_loop_body(b, param_names)),\\n    EUnaryOp(op, e) => EUnaryOp(op, desugar_loop_body(e, param_names)),\\n    EDot(obj, field, off, fdoff) => EDot(desugar_loop_body(obj, param_names), field, off, fdoff),\\n    EAssignOp(n, op, v, c) => EAssignOp(n, op, desugar_loop_body(v, param_names), desugar_loop_body(c, param_names)),\\n    _ => expr\\n  }\\n}\\n\\n\\nfn parse_loop_primary(tokens: Array[Token], starts: Array[Int], pos: Int, parse_recur: (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } {\\n  match peek(tokens, pos + 1) {\\n    TLParen => {\\n      let param_names_b = ArrayBuilder::new()\\n      let param_inits_b = ArrayBuilder::new()\\n      let mut cur = pos + 2\\n      let mut done = false\\n      while !done {\\n        match peek(tokens, cur) {\\n          TRParen => {\\n            cur = cur + 1\\n            done = true\\n          },\\n          TIdent(name) => {\\n            let eq_pos = expect_tk(tokens, cur + 1, \\\"=\\\")\\n            let (init, next_pos) = parse_recur(tokens, eq_pos, 0)\\n            ArrayBuilder::push(param_names_b, name)\\n            ArrayBuilder::push(param_inits_b, init)\\n            match peek(tokens, next_pos) {\\n              TComma => {\\n                cur = next_pos + 1\\n              },\\n              TRParen => {\\n                cur = next_pos + 1\\n                done = true\\n              },\\n              _ => throw(\\\"expected ',' or ')' in loop params\\\")\\n            }\\n          },\\n          _ => throw(\\\"expected loop parameter name or ')'\\\")\\n        }\\n      }\\n      let body_pos = expect_tk(tokens, cur, \\\"{\\\")\\n      let (body, end_pos) = parse_recur(tokens, body_pos, 20)\\n      // Desugar ELoop into ELetMut + EWhile\\n      let pnames = ArrayBuilder::freeze(param_names_b)\\n      let pinits = ArrayBuilder::freeze(param_inits_b)\\n      let transformed_body = desugar_loop_body(body, pnames)\\n      let while_expr = EWhile(EBool(true), transformed_body)\\n      let result = ELetMut(\\\"__loop_result\\\", EInt(0),\\n        ESeq(while_expr, EIdent(\\\"__loop_result\\\", -1)), -1)\\n      let mut wrapped = result\\n      let mut wi = Array::length(pnames) - 1\\n      while wi >= 0 {\\n        wrapped = ELetMut(Array::get(pnames, wi), Array::get(pinits, wi), wrapped, -1)\\n        wi = wi - 1\\n      }\\n      (wrapped, end_pos)\\n    },\\n    _ => {\\n      let body_pos = expect_tk(tokens, pos + 1, \\\"{\\\")\\n      let (body, end_pos) = parse_recur(tokens, body_pos, 20)\\n      (EWhile(EBool(true), body), end_pos)\\n    }\\n  }\\n}\\n\\nfn parse_break_primary(tokens: Array[Token], starts: Array[Int], pos: Int, parse_recur: (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } {\\n  match peek(tokens, pos + 1) {\\n    TRBrace => (EBreak(None), pos + 1),\\n    TSemicolon => (EBreak(None), pos + 1),\\n    TEof => (EBreak(None), pos + 1),\\n    _ => {\\n      let (expr, next_pos) = parse_recur(tokens, pos + 1, 0)\\n      (EBreak(Some(expr)), next_pos)\\n    }\\n  }\\n}\\n\\n// #640 Stage 2: `throw(x)` is sugar for `perform Error::Throw(x)` — the\\n// parser desugars it to the exact AST shape parse_perform_primary produces\\n// for the explicit spelling (ECall(EIdent(\\\"perform\\\"), [ECall(\\n// EIdent(\\\"Error::Throw\\\"), [x])])), so every downstream stage (checker,\\n// normalize, both codegen backends) sees ONE form. The printer re-sugars\\n// this shape back to `throw(x)` (printer.vibe), keeping print round-trips\\n// and the regenerated flat module source spelling-stable (no seed bump\\n// needed). The `EThrow` AST node this desugar replaced was fully retired\\n// in #640 Stage 4 (ctor removed from @vibe/ast); this parse shape is now\\n// the only form of `throw`. All synthesized nodes carry the `throw`\\n// token's offset so located diagnostics keep pointing at the keyword.\\nfn parse_throw_primary(tokens: Array[Token], starts: Array[Int], pos: Int, parse_recur: (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } {\\n  let open_pos = expect_tk(tokens, pos + 1, \\\"(\\\")\\n  let (expr, next_pos) = parse_recur(tokens, open_pos, 0)\\n  let close_pos = expect_tk(tokens, next_pos, \\\")\\\")\\n  let off = offset_at(starts, pos)\\n  (ECall(EIdent(\\\"perform\\\", off), [\\n    ECall(EIdent(\\\"Error::Throw\\\", off), [\\n      expr\\n    ], off)\\n  ], off), close_pos)\\n}\\n\\nfn parse_return_primary(tokens: Array[Token], starts: Array[Int], pos: Int, parse_recur: (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } {\\n  match peek(tokens, pos + 1) {\\n    TRBrace => (EReturn(EUnit), pos + 1),\\n    TSemicolon => (EReturn(EUnit), pos + 1),\\n    TEof => (EReturn(EUnit), pos + 1),\\n    _ => {\\n      let (expr, next_pos) = parse_recur(tokens, pos + 1, 0)\\n      (EReturn(expr), next_pos)\\n    }\\n  }\\n}\\n\\nfn parse_perform_primary(tokens: Array[Token], starts: Array[Int], pos: Int, parse_recur: (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } {\\n  match peek(tokens, pos + 1) {\\n    TRParen => (EIdent(\\\"perform\\\", -1), pos + 1),\\n    TRBracket => (EIdent(\\\"perform\\\", -1), pos + 1),\\n    TRBrace => (EIdent(\\\"perform\\\", -1), pos + 1),\\n    TComma => (EIdent(\\\"perform\\\", -1), pos + 1),\\n    TSemicolon => (EIdent(\\\"perform\\\", -1), pos + 1),\\n    TEof => (EIdent(\\\"perform\\\", -1), pos + 1),\\n    _ => {\\n      // `perform` binds tighter than binary operators: parse only the\\n      // effect-op application (primary + postfix), not a trailing binary\\n      // expression, so `perform A::Op + perform B::Op` groups as\\n      // `(perform A::Op) + (perform B::Op)` rather than\\n      // `perform (A::Op + perform B::Op)` (#550). min_prec 10 is above the\\n      // highest binop precedence (9, see binop_prec), so parse_infix_loop\\n      // stops before consuming any operator.\\n      let (arg, next_pos) = parse_recur(tokens, pos + 1, 10)\\n      (ECall(EIdent(\\\"perform\\\", -1), [\\n        arg\\n      ], offset_at(starts, pos)), next_pos)\\n    }\\n  }\\n}\\n\\nfn parse_array_elems_rest(tokens: Array[Token], starts: Array[Int], pos: Int, b: ArrayBuilder[Expr], parse_recur: (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Array[Expr], Int) with { Error } {\\n  match peek(tokens, pos) {\\n    TComma => {\\n      let next_pos = pos + 1\\n      match peek(tokens, next_pos) {\\n        TRBracket => (ArrayBuilder::freeze(b), next_pos),\\n        TDotDotDot => {\\n          let (expr, end_pos) = parse_recur(tokens, next_pos + 1, 0)\\n          ArrayBuilder::push(b, ESpread(expr))\\n          parse_array_elems_rest(tokens, starts, end_pos, b, parse_recur)\\n        },\\n        _ => {\\n          let (expr, end_pos) = parse_recur(tokens, next_pos, 0)\\n          ArrayBuilder::push(b, expr)\\n          parse_array_elems_rest(tokens, starts, end_pos, b, parse_recur)\\n        }\\n      }\\n    },\\n    _ => (ArrayBuilder::freeze(b), pos)\\n  }\\n}\\n\\nfn parse_array_primary(tokens: Array[Token], starts: Array[Int], pos: Int, parse_recur: (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } {\\n  match peek(tokens, pos + 1) {\\n    TRBracket => (EArray(empty_exprs()), pos + 2),\\n    TDotDotDot => {\\n      let b = ArrayBuilder::new()\\n      let (first, next_pos) = parse_recur(tokens, pos + 2, 0)\\n      ArrayBuilder::push(b, ESpread(first))\\n      let (items, end_pos) = parse_array_elems_rest(tokens, starts, next_pos, b, parse_recur)\\n      let close_pos = expect_tk(tokens, end_pos, \\\"]\\\")\\n      (EArray(items), close_pos)\\n    },\\n    _ => {\\n      let b = ArrayBuilder::new()\\n      let (first, next_pos) = parse_recur(tokens, pos + 1, 0)\\n      ArrayBuilder::push(b, first)\\n      let (items, end_pos) = parse_array_elems_rest(tokens, starts, next_pos, b, parse_recur)\\n      let close_pos = expect_tk(tokens, end_pos, \\\"]\\\")\\n      (EArray(items), close_pos)\\n    }\\n  }\\n}\\n\\nfn parse_comma_exprs_rest(tokens: Array[Token], starts: Array[Int], pos: Int, b: ArrayBuilder[Expr], parse_recur: (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Array[Expr], Int) with { Error } {\\n  match peek(tokens, pos) {\\n    TComma => {\\n      // Allow a trailing comma before the closing `)` in tuples and call\\n      // argument lists (`(a, b,)` / `f(a, b,)`).\\n      match peek(tokens, pos + 1) {\\n        TRParen => (ArrayBuilder::freeze(b), pos + 1),\\n        _ => {\\n          let (e, next) = parse_recur(tokens, pos + 1, 0)\\n          ArrayBuilder::push(b, e)\\n          parse_comma_exprs_rest(tokens, starts, next, b, parse_recur)\\n        }\\n      }\\n    },\\n    _ => (ArrayBuilder::freeze(b), pos)\\n  }\\n}\\n\\nfn parse_continue_primary(tokens: Array[Token], starts: Array[Int], pos: Int, parse_recur: (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } {\\n  match peek(tokens, pos + 1) {\\n    TLParen => {\\n      let b = ArrayBuilder::new()\\n      match peek(tokens, pos + 2) {\\n        TRParen => (EContinue(empty_exprs()), pos + 3),\\n        _ => {\\n          let (first, next_pos) = parse_recur(tokens, pos + 2, 0)\\n          ArrayBuilder::push(b, first)\\n          let (args, end_pos) = parse_comma_exprs_rest(tokens, starts, next_pos, b, parse_recur)\\n          let close_pos = expect_tk(tokens, end_pos, \\\")\\\")\\n          (EContinue(args), close_pos)\\n        }\\n      }\\n    },\\n    _ => (EContinue(empty_exprs()), pos + 1)\\n  }\\n}\\n\\nfn parse_control_primary(tokens: Array[Token], starts: Array[Int], pos: Int, parse_recur: (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } {\\n  match peek(tokens, pos) {\\n    TLBrace => parse_recur(tokens, pos + 1, 20),\\n    TIf => parse_recur(tokens, pos + 1, 21),\\n    TMatch => parse_recur(tokens, pos + 1, 22),\\n    THandle => parse_recur(tokens, pos + 1, 24),\\n    TWhile => parse_recur(tokens, pos + 1, 23),\\n    TFor => parse_recur(tokens, pos + 1, 25),\\n    TThrow => parse_throw_primary(tokens, starts, pos, parse_recur),\\n    TBreak => parse_break_primary(tokens, starts, pos, parse_recur),\\n    TContinue => parse_continue_primary(tokens, starts, pos, parse_recur),\\n    TRaise => throw(\\\"'raise' is deprecated, use 'throw(expr)' instead\\\"),\\n    TReturn => parse_return_primary(tokens, starts, pos, parse_recur),\\n    TDo => throw(\\\"'do' is reserved; use 'while' or 'for' instead\\\"),\\n    TLoop => parse_loop_primary(tokens, starts, pos, parse_recur),\\n    TYield => throw(\\\"'yield' is not supported\\\"),\\n    TDeclare => throw(\\\"'declare' is not supported\\\"),\\n    _ => {\\n      let prev_name = if pos > 0 {\\n        tk_name(peek(tokens, pos - 1))\\n      } else {\\n        \\\"start\\\"\\n      }\\n      let actual = tk_name(peek(tokens, pos))\\n      let next_name = tk_name(peek(tokens, pos + 1))\\n      throw(\\\"unexpected token at #\\\\{pos}: \\\\{actual} (prev=\\\\{prev_name}, next=\\\\{next_name})\\\")\\n    }\\n  }\\n}\\n\\n// #836: named struct constructor literals (`Name::{ ... }`) accept the same\\n// field-shorthand as anonymous record literals (`record { ... }`, see\\n// `parse_record_literal_fields` below) — `Name::{ left, right }` desugars to\\n// `Name::{ left: left, right: right }` by matching a bare identifier field to\\n// an in-scope binding of the same name. Mirrors `parse_record_literal_fields`\\n// exactly so both literal forms stay in sync.\\nfn parse_ctor_record_fields(tokens: Array[Token], starts: Array[Int], pos: Int, b: ArrayBuilder[(String, Expr)], parse_recur: (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Array[(String, Expr)], Int) with { Error } {\\n  match peek(tokens, pos) {\\n    TRBrace => (ArrayBuilder::freeze(b), pos + 1),\\n    TIdent(fname) => {\\n      let (val, next_pos) = match peek(tokens, pos + 1) {\\n        TComma => (EIdent(fname, -1), pos + 1),\\n        TRBrace => (EIdent(fname, -1), pos + 1),\\n        _ => {\\n          let colon_pos = expect_tk(tokens, pos + 1, \\\":\\\")\\n          parse_recur(tokens, colon_pos, 0)\\n        }\\n      }\\n      ArrayBuilder::push(b, (fname, val))\\n      match peek(tokens, next_pos) {\\n        TComma => parse_ctor_record_fields(tokens, starts, next_pos + 1, b, parse_recur),\\n        TRBrace => (ArrayBuilder::freeze(b), next_pos + 1),\\n        _ => throw(\\\"expected ',' or '}' in record literal\\\")\\n      }\\n    },\\n    _ => throw(\\\"expected field name or '}' in record literal\\\")\\n  }\\n}\\n\\nfn parse_generic_fn_primary(tokens: Array[Token], starts: Array[Int], pos: Int, parse_recur: (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } {\\n  let mut skip_pos = pos + 1\\n  let mut depth = 1\\n  while depth > 0 {\\n    match peek(tokens, skip_pos) {\\n      TLBracket => {\\n        depth = depth + 1\\n      },\\n      TRBracket => {\\n        depth = depth - 1\\n      },\\n      _ => ()\\n    }\\n    skip_pos = skip_pos + 1\\n  }\\n  let (params, after_params) = parse_param_list(tokens, skip_pos)\\n  match peek(tokens, after_params) {\\n    TThinArrow => {\\n      let (ret_ty, ret_pos) = parse_type_impl(tokens, after_params + 1, 0)\\n      let effect_pair = match peek(tokens, ret_pos) {\\n        TWith => {\\n          let with_pos = expect_tk(tokens, ret_pos + 1, \\\"{\\\")\\n          let effect_name_pair = collect_effect_names(tokens, with_pos, \\\"\\\")\\n          let effect_name = effect_name_pair.0\\n          let end_pos = effect_name_pair.1\\n          (Some(effect_name), end_pos)\\n        },\\n        _ => (None, ret_pos)\\n      }\\n      let effect = effect_pair.0\\n      let effect_next = effect_pair.1\\n      let body_pos = expect_tk(tokens, effect_next, \\\"{\\\")\\n      let (body, end_pos) = parse_recur(tokens, body_pos, 20)\\n      (EFn(_no_tp(), _no_tb(), params, Some(ret_ty), effect, body), end_pos)\\n    },\\n    TLBrace => {\\n      let (body, end_pos) = parse_recur(tokens, after_params + 1, 20)\\n      (EFn(_no_tp(), _no_tb(), params, None, None, body), end_pos)\\n    },\\n    _ => throw(\\\"expected '->' or '{' after generic function params\\\")\\n  }\\n}\\n\\nfn is_generic_fn_start(tokens: Array[Token], pos: Int) -> Bool {\\n  match peek(tokens, pos + 1) {\\n    TIdent(_) => {\\n      let mut p = pos + 2\\n      let mut depth = 1\\n      while depth > 0 {\\n        match peek(tokens, p) {\\n          TLBracket => {\\n            depth = depth + 1\\n          },\\n          TRBracket => {\\n            depth = depth - 1\\n          },\\n          TEof => {\\n            depth = 0\\n          },\\n          _ => ()\\n        }\\n        p = p + 1\\n      }\\n      match peek(tokens, p) {\\n        TLParen => true,\\n        _ => false\\n      }\\n    },\\n    _ => false\\n  }\\n}\\n\\nfn parse_bracket_primary(tokens: Array[Token], starts: Array[Int], pos: Int, parse_recur: (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } {\\n  if is_generic_fn_start(tokens, pos) {\\n    parse_generic_fn_primary(tokens, starts, pos, parse_recur)\\n  } else {\\n    parse_array_primary(tokens, starts, pos, parse_recur)\\n  }\\n}\\n\\nfn parse_paren_tuple_primary(tokens: Array[Token], starts: Array[Int], pos: Int, parse_recur: (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } {\\n  match peek(tokens, pos + 1) {\\n    TRParen => (EUnit, pos + 2),\\n    _ => {\\n      let (first, next_pos) = parse_recur(tokens, pos + 1, 0)\\n      match peek(tokens, next_pos) {\\n        TRParen => (first, next_pos + 1),\\n        TComma => {\\n          let b = ArrayBuilder::new()\\n          ArrayBuilder::push(b, first)\\n          let (items, end_pos) = parse_comma_exprs_rest(tokens, starts, next_pos, b, parse_recur)\\n          let close_pos = expect_tk(tokens, end_pos, \\\")\\\")\\n          (ETuple(items), close_pos)\\n        },\\n        _ => throw(\\\"expected ')' or ','\\\")\\n      }\\n    }\\n  }\\n}\\n\\n\\nfn parse_paren_lambda_primary(tokens: Array[Token], starts: Array[Int], pos: Int, parse_recur: (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } {\\n  let (params, after_params) = parse_param_list(tokens, pos + 1)\\n  match peek(tokens, after_params) {\\n    TThinArrow => {\\n      let after_arrow = after_params + 1\\n      match peek(tokens, after_arrow) {\\n        TIdent(_) => {\\n          let (ty, ty_pos) = parse_type_impl(tokens, after_arrow, 0)\\n          match peek(tokens, ty_pos) {\\n            TLBrace => {\\n              let (body, end) = parse_recur(tokens, ty_pos + 1, 20)\\n              (EFn(_no_tp(), _no_tb(), params, Some(ty), None, body), end)\\n            },\\n            TWith => {\\n              let with_pos = expect_tk(tokens, ty_pos + 1, \\\"{\\\")\\n              let effect_pair = collect_effect_names(tokens, with_pos, \\\"\\\")\\n              let effect_name = effect_pair.0\\n              let effect_next = effect_pair.1\\n              let body_pos = expect_tk(tokens, effect_next, \\\"{\\\")\\n              let (body, end) = parse_recur(tokens, body_pos, 20)\\n              (EFn(_no_tp(), _no_tb(), params, Some(ty), Some(effect_name), body), end)\\n            },\\n            _ => {\\n              let (body, end) = parse_recur(tokens, after_arrow, 0)\\n              (EFn(_no_tp(), _no_tb(), params, None, None, body), end)\\n            }\\n          }\\n        },\\n        TLParen => {\\n          // The parens after `->` are ambiguous: a return-type annotation\\n          // `(A, B) { body }` / `(A, B) with { E } { body }` (incl. a curried\\n          // `(A) -> B { body }`), OR a body that merely starts with `(`, e.g.\\n          // `(t) -> (t.1, t.0)`. Speculatively parse a type; a body expression\\n          // makes parse_type_impl throw (\\\"expected ')' or ',' in type\\\" at the\\n          // `.`), so recover and parse the parens as the body instead. When the\\n          // type parse SUCCEEDS but is not followed by `{`/`with` it is likewise\\n          // a body (the `_` arm) — e.g. a nested-lambda body `(x) -> f`. #788.\\n          let ty_opt = handle {\\n            let (ty, ty_pos) = parse_type_impl(tokens, after_arrow, 0)\\n            Some((ty, ty_pos))\\n          } with Error {\\n            Throw(_) => None\\n          }\\n          match ty_opt {\\n            Some(pair) => {\\n              let (ty, ty_pos) = pair\\n              match peek(tokens, ty_pos) {\\n                TLBrace => {\\n                  let (body, end) = parse_recur(tokens, ty_pos + 1, 20)\\n                  (EFn(_no_tp(), _no_tb(), params, Some(ty), None, body), end)\\n                },\\n                TWith => {\\n                  let with_pos = expect_tk(tokens, ty_pos + 1, \\\"{\\\")\\n                  let effect_pair = collect_effect_names(tokens, with_pos, \\\"\\\")\\n                  let effect_name = effect_pair.0\\n                  let effect_next = effect_pair.1\\n                  let body_pos = expect_tk(tokens, effect_next, \\\"{\\\")\\n                  let (body, end) = parse_recur(tokens, body_pos, 20)\\n                  (EFn(_no_tp(), _no_tb(), params, Some(ty), Some(effect_name), body), end)\\n                },\\n                _ => {\\n                  let (body, end) = parse_recur(tokens, after_arrow, 0)\\n                  (EFn(_no_tp(), _no_tb(), params, None, None, body), end)\\n                }\\n              }\\n            },\\n            None => {\\n              let (body, end) = parse_recur(tokens, after_arrow, 0)\\n              (EFn(_no_tp(), _no_tb(), params, None, None, body), end)\\n            }\\n          }\\n        },\\n        _ => {\\n          let (body, end) = parse_recur(tokens, after_arrow, 0)\\n          (EFn(_no_tp(), _no_tb(), params, None, None, body), end)\\n        }\\n      }\\n    },\\n    TLBrace => {\\n      let (body, end) = parse_recur(tokens, after_params + 1, 20)\\n      (EFn(_no_tp(), _no_tb(), params, None, None, body), end)\\n    },\\n    _ => throw(\\\"expected '->' or '{' after fn params\\\")\\n  }\\n}\\n\\nfn parse_paren_primary(tokens: Array[Token], starts: Array[Int], pos: Int, parse_recur: (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } {\\n  if is_lambda_start(tokens, pos + 1) {\\n    parse_paren_lambda_primary(tokens, starts, pos, parse_recur)\\n  } else {\\n    parse_paren_tuple_primary(tokens, starts, pos, parse_recur)\\n  }\\n}\\n\\nfn parse_record_literal_fields(tokens: Array[Token], starts: Array[Int], pos: Int, b: ArrayBuilder[(String, Expr)], parse_recur: (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Array[(String, Expr)], Int) with { Error } {\\n  match peek(tokens, pos) {\\n    TRBrace => (ArrayBuilder::freeze(b), pos + 1),\\n    TIdent(fname) => {\\n      let (val, next_pos) = match peek(tokens, pos + 1) {\\n        TComma => (EIdent(fname, -1), pos + 1),\\n        TRBrace => (EIdent(fname, -1), pos + 1),\\n        _ => {\\n          let colon_pos = expect_tk(tokens, pos + 1, \\\":\\\")\\n          parse_recur(tokens, colon_pos, 0)\\n        }\\n      }\\n      ArrayBuilder::push(b, (fname, val))\\n      match peek(tokens, next_pos) {\\n        TComma => parse_record_literal_fields(tokens, starts, next_pos + 1, b, parse_recur),\\n        TRBrace => (ArrayBuilder::freeze(b), next_pos + 1),\\n        _ => throw(\\\"expected ',' or '}' in record literal\\\")\\n      }\\n    },\\n    _ => throw(\\\"expected field name or '}' in record literal\\\")\\n  }\\n}\\n\\n// Look up the source char offset of the token at position `p` in the\\n// parallel `starts` array produced by the offset-tracking lexer. Returns\\n// -1 when `starts` has no entry for `p` (e.g. the empty-array entry points\\n// `parse`/`parse_expr` that do not thread real offsets).\\nfn offset_at(starts: Array[Int], p: Int) -> Int {\\n  if p >= 0 && p < Array::length(starts) {\\n    Array::get(starts, p)\\n  } else {\\n    -1\\n  }\\n}\\n\\n// #836/#886: detect `Name[...]::{` (explicit struct type arguments on a named\\n// struct constructor literal, e.g. `Pair[Int]::{ left: 1, right: 2 }`).\\n// `pos` is the TLBracket immediately after the constructor name. Skips the\\n// balanced `[...]` span (mirrors `is_generic_fn_start`'s bracket-depth scan)\\n// and checks whether it is immediately followed by `::{`. Disambiguates the\\n// explicit-type-args constructor form from postfix indexing (`arr[i]`) before\\n// `parse_ident_primary` commits to parsing the type-argument list (#886).\\nfn is_struct_targs_ctor_start(tokens: Array[Token], pos: Int) -> Bool {\\n  let mut p = pos + 1\\n  let mut depth = 1\\n  while depth > 0 {\\n    match peek(tokens, p) {\\n      TLBracket => {\\n        depth = depth + 1\\n      },\\n      TRBracket => {\\n        depth = depth - 1\\n      },\\n      TEof => {\\n        depth = 0\\n      },\\n      _ => ()\\n    }\\n    p = p + 1\\n  }\\n  match peek(tokens, p) {\\n    TDoubleColon => match peek(tokens, p + 1) {\\n      TLBrace => true,\\n      _ => false\\n    },\\n    _ => false\\n  }\\n}\\n\\n// #886: parse the comma-separated type-argument list of an explicit struct\\n// constructor literal `Name[T1, T2, ...]::{ ... }`. `pos` is the token just\\n// after the opening `[`. Returns the parsed arguments and the position just\\n// after the closing `]`. Full type grammar (nested generics, tuples, fn\\n// types) via `parse_type_impl`, same as annotation positions.\\nfn parse_struct_ctor_targs(tokens: Array[Token], pos: Int, name: String) -> (Array[TypeExpr], Int) with { Error } {\\n  match peek(tokens, pos) {\\n    TRBracket => throw(\\\"expected at least one type argument in `\\\\{name}[...]::{ ... }` at #\\\\{pos}: write `\\\\{name}::{ ... }` to infer the type arguments from the field values\\\"),\\n    _ => {\\n      let (first, after_first) = parse_type_impl(tokens, pos, 0)\\n      let targs = [\\n        first\\n      ]\\n      let mut p = after_first\\n      while tk_name(peek(tokens, p)) == \\\",\\\" {\\n        let (next, after_next) = parse_type_impl(tokens, p + 1, 0)\\n        Array::push(targs, next)\\n        p = after_next\\n      }\\n      let end_pos = expect_tk(tokens, p, \\\"]\\\")\\n      (targs, end_pos)\\n    }\\n  }\\n}\\n\\nfn parse_ident_primary(tokens: Array[Token], starts: Array[Int], pos: Int, name: String, parse_recur: (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } {\\n  if name == \\\"true\\\" {\\n    (EBool(true), pos + 1)\\n  } else if name == \\\"false\\\" {\\n    (EBool(false), pos + 1)\\n  } else if name == \\\"perform\\\" {\\n    parse_perform_primary(tokens, starts, pos, parse_recur)\\n  } else if name == \\\"record\\\" {\\n    match peek(tokens, pos + 1) {\\n      TLBrace => {\\n        let b = ArrayBuilder::new()\\n        let (fields, end_pos) = parse_record_literal_fields(tokens, starts, pos + 2, b, parse_recur)\\n        (ERecord(\\\"\\\", fields, empty_type_exprs()), end_pos)\\n      },\\n      _ => (EIdent(name, offset_at(starts, pos)), pos + 1)\\n    }\\n  } else if name == \\\"map\\\" {\\n    match peek(tokens, pos + 1) {\\n      // #960 Stage 2: the `map { ... }` literal is retired. `map` before `{`\\n      // stays detected here solely to give a located, actionable diagnostic\\n      // (a plain unknown-name error would be misleading). Everywhere else\\n      // `map` is an ordinary identifier (Iterator::map etc. need no `r#`).\\n      TLBrace => throw(\\\"the `map { ... }` literal was removed (#960): use Map::from_pairs([(\\\\\\\"key\\\\\\\", value), ...]) or Map::new() at #\\\\{pos}\\\"),\\n      _ => (EIdent(name, offset_at(starts, pos)), pos + 1)\\n    }\\n  } else {\\n    match peek(tokens, pos + 1) {\\n      TDoubleColon => match peek(tokens, pos + 2) {\\n        TIdent(member) => (EIdent(String::concat(name, String::concat(\\\"::\\\", member)), offset_at(starts, pos)), pos + 3),\\n        TLBrace => {\\n          let b = ArrayBuilder::new()\\n          let (fields, end_pos) = parse_ctor_record_fields(tokens, starts, pos + 3, b, parse_recur)\\n          (ERecord(name, fields, empty_type_exprs()), end_pos)\\n        },\\n        _ => (EIdent(name, offset_at(starts, pos)), pos + 1)\\n      },\\n      // #886: `Name[Args]::{ ... }` — explicit struct type arguments on a\\n      // named struct constructor literal (deferred from #836). The bracket\\n      // scan disambiguates from postfix indexing (`arr[i]`): only a balanced\\n      // `[...]` immediately followed by `::{` parses as type arguments. The\\n      // parsed list rides in ERecord's third slot; the checker validates it\\n      // against the struct's declared type params and pins the instantiation\\n      // (#829's inference otherwise derives the args from the field values).\\n      TLBracket => if is_struct_targs_ctor_start(tokens, pos + 1) {\\n        let (targs, after_targs) = parse_struct_ctor_targs(tokens, pos + 2, name)\\n        let dc_pos = expect_tk(tokens, after_targs, \\\"::\\\")\\n        let brace_pos = expect_tk(tokens, dc_pos, \\\"{\\\")\\n        let b = ArrayBuilder::new()\\n        let (fields, end_pos) = parse_ctor_record_fields(tokens, starts, brace_pos, b, parse_recur)\\n        (ERecord(name, fields, targs), end_pos)\\n      } else {\\n        (EIdent(name, offset_at(starts, pos)), pos + 1)\\n      },\\n      _ => (EIdent(name, offset_at(starts, pos)), pos + 1)\\n    }\\n  }\\n}\\n\\nexport fn parse_primary(tokens: Array[Token], starts: Array[Int], pos: Int, parse_recur: (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } {\\n  match peek(tokens, pos) {\\n    TInt(n) => (EInt(n), pos + 1),\\n    TFloat(n) => (EFloat(n), pos + 1),\\n    TString(s) => (EString(s), pos + 1),\\n    TStringInterp(parts, offs) => (build_interp_expr(parts, offs, starts, parse_recur), pos + 1),\\n    TIdent(name) => parse_ident_primary(tokens, starts, pos, name, parse_recur),\\n    TLParen => parse_paren_primary(tokens, starts, pos, parse_recur),\\n    TLBracket => parse_bracket_primary(tokens, starts, pos, parse_recur),\\n    _ => parse_control_primary(tokens, starts, pos, parse_recur)\\n  }\\n}\\n\")\n}\n\nlet cli_adapter_source_9 = () -> (String, String) {\n  (\"lib/@vibe/parser/parser_expr_core.vibe\",\n\"//# Imports\\n\\nimport ../ast {\\n  Expr, Pat\\n}\\n\\nimport ./parser_base.vibe {\\n  _no_tb, _no_tp, empty_exprs, expect_tk, is_expr_end_token, is_non_pipe_infix, parse_pattern, peek\\n}\\n\\nimport ./parser_expr_primary.vibe {\\n  parse_primary\\n}\\n\\nimport ./token.vibe {\\n  Token\\n}\\n\\n//# Functions\\n\\nfn binop_op(tok: Token) -> String with { Error } {\\n  match tok {\\n    TOr => \\\"||\\\",\\n    TAnd => \\\"&&\\\",\\n    TPipeGt => \\\"|>\\\",\\n    TEqEq => \\\"==\\\",\\n    TNeq => \\\"!=\\\",\\n    TLt => \\\"<\\\",\\n    TLte => \\\"<=\\\",\\n    TGt => \\\">\\\",\\n    TGte => \\\">=\\\",\\n    TBitOr => \\\"|\\\",\\n    TBitXor => \\\"^\\\",\\n    TBitAnd => \\\"&\\\",\\n    TLShift => \\\"<<\\\",\\n    TRShift => \\\">>\\\",\\n    TPlus => \\\"+\\\",\\n    TMinus => \\\"-\\\",\\n    TStar => \\\"*\\\",\\n    TSlash => \\\"/\\\",\\n    TPercent => \\\"%\\\",\\n    _ => throw(\\\"internal parser error: not a binary operator\\\")\\n  }\\n}\\n\\nfn binop_prec(tok: Token) -> Int {\\n  match tok {\\n    TOr => 0,\\n    TAnd => 1,\\n    TPipeGt => 2,\\n    TEqEq => 3,\\n    TNeq => 3,\\n    TLt => 3,\\n    TLte => 3,\\n    TGt => 3,\\n    TGte => 3,\\n    TBitOr => 4,\\n    TBitXor => 5,\\n    TBitAnd => 6,\\n    TLShift => 7,\\n    TRShift => 7,\\n    TPlus => 8,\\n    TMinus => 8,\\n    TStar => 9,\\n    TSlash => 9,\\n    TPercent => 9,\\n    _ => -1\\n  }\\n}\\n\\n// Extract the source char offset of a callee expression so that the ECall\\n// node can carry the call-site offset (callee start). Mirrors how EIdent\\n// threads `offset_at(starts, pos)`. Falls back to -1 for callees that do\\n// not carry an offset (synthetic / nested forms).\\nfn callee_offset(callee: Expr) -> Int {\\n  match callee {\\n    EIdent(_, off) => off,\\n    EDot(inner, _, off, _) => if off >= 0 { off } else { callee_offset(inner) },\\n    ECall(inner, _, off) => if off >= 0 { off } else { callee_offset(inner) },\\n    _ => -1\\n  }\\n}\\n\\n// Source char offset of the token at `p` (#645: the field-name token of an\\n// EDot). Mirrors parser_expr_primary's offset_at; -1 when `starts` has no\\n// entry (offset-less parse entry points).\\nfn field_offset_at(starts: Array[Int], p: Int) -> Int {\\n  if p >= 0 && p < Array::length(starts) {\\n    Array::get(starts, p)\\n  } else {\\n    -1\\n  }\\n}\\n\\nfn index_expr(cur_expr: Expr, idx: Expr) -> Expr {\\n  let args = empty_exprs()\\n  Array::push(args, cur_expr)\\n  Array::push(args, idx)\\n  ECall(EIdent(\\\"__index\\\", -1), args, -1)\\n}\\n\\n// `x |> f(a, _)` substitutes the piped value at each bare `_` placeholder\\n// (`f(a, x)`) instead of prepending. With no `_`, the piped value is\\n// prepended as the first argument (`x |> f(a)` => `f(x, a)`). Bare `_`\\n// call arguments are preserved as `EIdent(\\\"_\\\")` holes by\\n// `desugar_placeholder_args`; compound placeholders like `_ * 2` are already\\n// lowered to section lambdas before they reach here.\\nfn pipe_arg_is_hole(arg: Expr) -> Bool {\\n  match arg {\\n    EIdent(n, _) => n == \\\"_\\\",\\n    _ => false\\n  }\\n}\\n\\nfn pipe_desugar(lhs: Expr, rhs: Expr) -> Expr {\\n  match rhs {\\n    ECall(callee, args, off) => {\\n      let mut has_hole = false\\n      let mut i = 0\\n      while i < Array::length(args) {\\n        if pipe_arg_is_hole(Array::get(args, i)) {\\n          has_hole = true\\n          i = Array::length(args)\\n        } else {\\n          i = i + 1\\n        }\\n      }\\n      if has_hole {\\n        let out = empty_exprs()\\n        let mut j = 0\\n        while j < Array::length(args) {\\n          let a = Array::get(args, j)\\n          if pipe_arg_is_hole(a) {\\n            Array::push(out, lhs)\\n          } else {\\n            Array::push(out, a)\\n          }\\n          j = j + 1\\n        }\\n        ECall(callee, out, off)\\n      } else {\\n        ECall(callee, Array::concat([\\n          lhs\\n        ], args), off)\\n      }\\n    },\\n    _ => {\\n      // #770: route the bare-callee case through the same `Array::concat`\\n      // path as the arg-bearing case above. Storing an array *literal*\\n      // `[lhs]` directly as the ECall args field trips an RC double-free when\\n      // `lhs` is a value accumulated through `parse_infix_loop`'s tail\\n      // recursion (chained `a |> f |> g`): the literal aliases the moved\\n      // accumulator without a retain, so printing the resulting tree later\\n      // reads freed memory. `Array::concat` dups its inputs, so the same\\n      // single-element array built via concat is RC-safe. `off` is hoisted so\\n      // `rhs` is read once before being moved into the ECall callee slot.\\n      let off = callee_offset(rhs)\\n      ECall(rhs, Array::concat([\\n        lhs\\n      ], empty_exprs()), off)\\n    }\\n  }\\n}\\n\\nfn parse_call_arg(tokens: Array[Token], starts: Array[Int], pos: Int, parse_recur: (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } {\\n  match peek(tokens, pos) {\\n    TIdent(name) => match peek(tokens, pos + 1) {\\n      TThinArrow => {\\n        let (body, end) = parse_recur(tokens, pos + 2, 0)\\n        (EFn(_no_tp(), _no_tb(), [\\n          (name, None)\\n        ], None, None, body), end)\\n      },\\n      TTilde => match peek(tokens, pos + 2) {\\n        TEq => {\\n          let (val, end) = parse_recur(tokens, pos + 3, 0)\\n          (ELabeledArg(name, \\\"~\\\", val), end)\\n        },\\n        _ => parse_recur(tokens, pos, 0)\\n      },\\n      TQuestion => match peek(tokens, pos + 2) {\\n        TEq => {\\n          let (val, end) = parse_recur(tokens, pos + 3, 0)\\n          (ELabeledArg(name, \\\"?\\\", val), end)\\n        },\\n        _ => parse_recur(tokens, pos, 0)\\n      },\\n      TEq => {\\n        let (val, end) = parse_recur(tokens, pos + 2, 0)\\n        (ELabeledArg(name, \\\"~\\\", val), end)\\n      },\\n      _ => parse_recur(tokens, pos, 0)\\n    },\\n    _ => parse_recur(tokens, pos, 0)\\n  }\\n}\\n\\n// Recurses into nested EBinOp trees so placeholders buried below the\\n// top-level operator (e.g. `_ % 2 == 0`, where `_` sits inside the `%`\\n// sub-expression of the outer `==`) are still detected.\\nfn has_placeholder_arg(arg: Expr) -> Bool {\\n  match arg {\\n    EIdent(n, _) => n == \\\"_\\\",\\n    EBinOp(_, l, r) => has_placeholder_arg(l) || has_placeholder_arg(r),\\n    _ => false\\n  }\\n}\\n\\nfn slice_from_idx_expr(cur_expr: Expr, idx: Expr, end_expr: Expr) -> Expr {\\n  let args = empty_exprs()\\n  Array::push(args, cur_expr)\\n  Array::push(args, idx)\\n  Array::push(args, end_expr)\\n  ECall(EIdent(\\\"__slice\\\", -1), args, -1)\\n}\\n\\nfn has_placeholder_args(args: Array[Expr]) -> Bool {\\n  let mut i = 0\\n  let mut found = false\\n  while i < Array::length(args) {\\n    if has_placeholder_arg(Array::get(args, i)) {\\n      found = true\\n      i = Array::length(args)\\n    } else {\\n      i = i + 1\\n    }\\n  }\\n  found\\n}\\n\\nfn parse_call_args_rest(tokens: Array[Token], starts: Array[Int], pos: Int, b: ArrayBuilder[Expr], parse_recur: (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Array[Expr], Int) with { Error } {\\n  let mut p = pos\\n  let mut done = false\\n  while !done {\\n    match peek(tokens, p) {\\n      TComma => match peek(tokens, p + 1) {\\n        TRParen => {\\n          p = p + 1\\n          done = true\\n        },\\n        _ => {\\n          let (e, next) = parse_call_arg(tokens, starts, p + 1, parse_recur)\\n          ArrayBuilder::push(b, e)\\n          p = next\\n        }\\n      }\\n      ,\\n      _ => {\\n        done = true\\n      }\\n    }\\n  }\\n  (ArrayBuilder::freeze(b), p)\\n}\\n\\nfn slice_from_zero_expr(cur_expr: Expr, end_expr: Expr) -> Expr {\\n  let args = empty_exprs()\\n  Array::push(args, cur_expr)\\n  Array::push(args, EInt(0))\\n  Array::push(args, end_expr)\\n  ECall(EIdent(\\\"__slice\\\", -1), args, -1)\\n}\\n\\nfn wrap_placeholder_arg(arg: Expr) -> Expr {\\n  let mut pc = 0\\n  let params = Array::slice([\\n    (\\\"\\\", None)\\n  ], 0, 0)\\n  // Walks nested EBinOp trees (mirrors has_placeholder_arg) so every `_`\\n  // hole, however deeply nested under binary operators, becomes its own\\n  // lambda parameter in left-to-right order.\\n  let rec replace_placeholders: (Expr) -> Expr = (e) -> {\\n    match e {\\n      EIdent(n, _) => if n == \\\"_\\\" {\\n        let pn = String::concat(\\\"__ph\\\", __to_string(pc))\\n        Array::push(params, (pn, None))\\n        pc = pc + 1\\n        EIdent(pn, -1)\\n      } else {\\n        e\\n      }\\n      ,\\n      EBinOp(op, l, r) => {\\n        let nl = replace_placeholders(l)\\n        let nr = replace_placeholders(r)\\n        EBinOp(op, nl, nr)\\n      },\\n      _ => e\\n    }\\n  }\\n  let replaced = replace_placeholders(arg)\\n  EFn(_no_tp(), _no_tb(), params, None, None, replaced)\\n}\\n\\nfn has_non_pipe_infix_top(tokens: Array[Token], start: Int, end: Int) -> Bool {\\n  let rec go: (Int, Int, Bool) -> Bool = (i, depth, prev_top_end) -> {\\n    if i >= end {\\n      false\\n    } else {\\n      let tok = peek(tokens, i)\\n      if depth == 0 {\\n        if is_non_pipe_infix(tok) {\\n          if prev_top_end {\\n            true\\n          } else {\\n            go(i + 1, 0, false)\\n          }\\n        } else {\\n          match tok {\\n            TLParen => go(i + 1, 1, false),\\n            TLBracket => go(i + 1, 1, false),\\n            TLBrace => go(i + 1, 1, false),\\n            _ => go(i + 1, 0, is_expr_end_token(tok))\\n          }\\n        }\\n      } else {\\n        match tok {\\n          TLParen => go(i + 1, depth + 1, prev_top_end),\\n          TLBracket => go(i + 1, depth + 1, prev_top_end),\\n          TLBrace => go(i + 1, depth + 1, prev_top_end),\\n          TRParen => if depth == 1 {\\n            go(i + 1, 0, true)\\n          } else {\\n            go(i + 1, depth - 1, prev_top_end)\\n          },\\n          TRBracket => if depth == 1 {\\n            go(i + 1, 0, true)\\n          } else {\\n            go(i + 1, depth - 1, prev_top_end)\\n          },\\n          TRBrace => if depth == 1 {\\n            go(i + 1, 0, true)\\n          } else {\\n            go(i + 1, depth - 1, prev_top_end)\\n          },\\n          _ => go(i + 1, depth, prev_top_end)\\n        }\\n      }\\n    }\\n  }\\n  go(start, 0, false)\\n}\\n\\nfn desugar_placeholder_args(args: Array[Expr]) -> Array[Expr] {\\n  let out = Array::slice([\\n    EUnit\\n  ], 0, 0)\\n  let mut i = 0\\n  while i < Array::length(args) {\\n    let arg = Array::get(args, i)\\n    if pipe_arg_is_hole(arg) {\\n      // Bare `_` stays a hole so a surrounding `|>` can substitute the\\n      // piped value at this position; compound placeholders still lower.\\n      Array::push(out, arg)\\n    } else if has_placeholder_arg(arg) {\\n      Array::push(out, wrap_placeholder_arg(arg))\\n    } else {\\n      Array::push(out, arg)\\n    }\\n    i = i + 1\\n  }\\n  out\\n}\\n\\n// #960: `Map::new()` / `Map::from_pairs([(\\\"k\\\", v), ...])` are the ONLY\\n// spellings for building a string-keyed map (Stage 2 removed the\\n// `map { ... }` literal; the printer emits these spellings for EMap). They\\n// are desugared HERE, at the parse-postfix call-build site — the same layer\\n// as the `throw(x)` -> `perform Error::Throw(x)` desugar (#640 Stage 2) —\\n// into the exact `EMap` node the literal used to produce, so every\\n// downstream stage (checker, normalize, both codegen backends) sees ONE\\n// form and needs ZERO changes. Parse-level\\n// placement also keeps the two names from ever reaching the checker's\\n// generic `Map::` builtin lookup (a residual non-call mention, e.g.\\n// `x |> Map::from_pairs`, is rejected there as `unknown name` — an error,\\n// never a silent miscompile). Only an array LITERAL of (string-literal,\\n// value) tuple LITERALS is accepted for now; anything else throws a located\\n// parse error. `pos` is the token index of the call's `(`, the \\\"at #N\\\"\\n// located-diagnostic anchor (#816).\\nfn empty_map_fields() -> Array[(String, Expr)] {\\n  Array::slice([\\n    (\\\"\\\", EUnit)\\n  ], 0, 0)\\n}\\n\\nfn map_from_pairs_fields(args: Array[Expr], pos: Int) -> Array[(String, Expr)] with { Error } {\\n  if Array::length(args) != 1 {\\n    throw(\\\"Map::from_pairs requires an array literal of (string literal, value) pairs for now (#960) at #\\\\{pos}\\\")\\n  }\\n  match Array::get(args, 0) {\\n    EArray(elems) => {\\n      let b = ArrayBuilder::new()\\n      let mut i = 0\\n      while i < Array::length(elems) {\\n        match Array::get(elems, i) {\\n          ETuple(kv) => if Array::length(kv) == 2 {\\n            match Array::get(kv, 0) {\\n              EString(k) => ArrayBuilder::push(b, (k, Array::get(kv, 1))),\\n              _ => throw(\\\"Map::from_pairs requires an array literal of (string literal, value) pairs for now (#960): pair key is not a string literal at #\\\\{pos}\\\")\\n            }\\n          } else {\\n            throw(\\\"Map::from_pairs requires an array literal of (string literal, value) pairs for now (#960): each pair must be a 2-tuple literal at #\\\\{pos}\\\")\\n          },\\n          _ => throw(\\\"Map::from_pairs requires an array literal of (string literal, value) pairs for now (#960): each element must be a tuple literal at #\\\\{pos}\\\")\\n        }\\n        i = i + 1\\n      }\\n      ArrayBuilder::freeze(b)\\n    },\\n    _ => throw(\\\"Map::from_pairs requires an array literal of (string literal, value) pairs for now (#960) at #\\\\{pos}\\\")\\n  }\\n}\\n\\nfn build_call_expr(expr: Expr, args: Array[Expr], pos: Int) -> Expr with { Error } {\\n  let ctor_name = match expr {\\n    EIdent(name, _) => name,\\n    _ => \\\"\\\"\\n  }\\n  if ctor_name == \\\"Map::new\\\" {\\n    if Array::length(args) == 0 {\\n      EMap(empty_map_fields())\\n    } else {\\n      throw(\\\"Map::new takes no arguments (#960): use Map::from_pairs([(\\\\\\\"key\\\\\\\", value), ...]) to build a non-empty map at #\\\\{pos}\\\")\\n    }\\n  } else if ctor_name == \\\"Map::from_pairs\\\" {\\n    EMap(map_from_pairs_fields(args, pos))\\n  } else {\\n    ECall(expr, args, callee_offset(expr))\\n  }\\n}\\n\\nfn parse_postfix(tokens: Array[Token], starts: Array[Int], pos: Int, expr: Expr, parse_recur: (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } {\\n  match peek(tokens, pos) {\\n    TLParen => match expr {\\n      // NOTE: an ECall left is deliberately NOT blocked here — a same-line\\n      // `(` after a call/index result is a chained call (`f()()`, `arr[i](x)`,\\n      // `f()()()`). The statement-boundary case (`f(1)` then `(2)` on the next\\n      // line) is already separated by the lexer, which inserts a synthetic `;`\\n      // for a newline-then-`(` after an expr-ending token (see is_expr_ending_tok\\n      // + the synthetic-`;` insertion in lexer.vibe), so no newline-merge can\\n      // reach here. `arr[i]` desugars to `ECall(__index, ...)`, so this also\\n      // enables subscript-then-call.\\n      EArray(_) => (expr, pos),\\n      ETuple(_) => (expr, pos),\\n      ERecord(_, _, _) => (expr, pos),\\n      EMap(_) => (expr, pos),\\n      EInt(_) => (expr, pos),\\n      EFloat(_) => (expr, pos),\\n      EString(_) => (expr, pos),\\n      EStringInterp(_) => (expr, pos),\\n      EBool(_) => (expr, pos),\\n      EUnit => (expr, pos),\\n      EWhile(_, _) => (expr, pos),\\n      EIf(_, _, _) => (expr, pos),\\n      EMatch(_, _) => (expr, pos),\\n      ELoop(_, _) => (expr, pos),\\n      EForIn(_, _, _, _) => (expr, pos),\\n      EHandle(_, _) => (expr, pos),\\n      _ => match peek(tokens, pos + 1) {\\n        TRParen => parse_postfix(tokens, starts, pos + 2, build_call_expr(expr, empty_exprs(), pos), parse_recur),\\n        _ => {\\n          let b = ArrayBuilder::new()\\n          let (first_arg, next_pos) = parse_call_arg(tokens, starts, pos + 1, parse_recur)\\n          ArrayBuilder::push(b, first_arg)\\n          let (args, end_pos) = parse_call_args_rest(tokens, starts, next_pos, b, parse_recur)\\n          let close_pos = expect_tk(tokens, end_pos, \\\")\\\")\\n          let call_args = if has_placeholder_args(args) {\\n            desugar_placeholder_args(args)\\n          } else {\\n            args\\n          }\\n          parse_postfix(tokens, starts, close_pos, build_call_expr(expr, call_args, pos), parse_recur)\\n        }\\n      },\\n    },\\n    TLBracket => match peek(tokens, pos + 1) {\\n      TColon => match peek(tokens, pos + 2) {\\n        TRBracket => {\\n          let end_expr = ECall(EIdent(\\\"__len\\\", -1), [\\n            expr\\n          ], -1)\\n          parse_postfix(tokens, starts, pos + 3, slice_from_zero_expr(expr, end_expr), parse_recur)\\n        },\\n        _ => {\\n          let (end_expr, end_next) = parse_recur(tokens, pos + 2, 0)\\n          let close_pos = match peek(tokens, end_next) {\\n            TRBracket => end_next + 1,\\n            _ => throw(\\\"expected ']'\\\")\\n          }\\n          parse_postfix(tokens, starts, close_pos, slice_from_zero_expr(expr, end_expr), parse_recur)\\n        }\\n      },\\n      _ => {\\n        let (idx, idx_next) = parse_recur(tokens, pos + 1, 0)\\n        match peek(tokens, idx_next) {\\n          TColon => match peek(tokens, idx_next + 1) {\\n            TRBracket => {\\n              let end_expr = ECall(EIdent(\\\"__len\\\", -1), [\\n                expr\\n              ], -1)\\n              parse_postfix(tokens, starts, idx_next + 2, slice_from_idx_expr(expr, idx, end_expr), parse_recur)\\n            },\\n            _ => {\\n              let (end_expr, end_next) = parse_recur(tokens, idx_next + 1, 0)\\n              let close_pos = match peek(tokens, end_next) {\\n                TRBracket => end_next + 1,\\n                _ => throw(\\\"expected ']'\\\")\\n              }\\n              parse_postfix(tokens, starts, close_pos, slice_from_idx_expr(expr, idx, end_expr), parse_recur)\\n            }\\n          },\\n          _ => {\\n            let close_pos = match peek(tokens, idx_next) {\\n              TRBracket => idx_next + 1,\\n              _ => throw(\\\"expected ']'\\\")\\n            }\\n            parse_postfix(tokens, starts, close_pos, index_expr(expr, idx), parse_recur)\\n          }\\n        }\\n      }\\n    },\\n    TDot => match peek(tokens, pos + 1) {\\n      TIdent(field) => parse_postfix(tokens, starts, pos + 2, EDot(expr, field, callee_offset(expr), field_offset_at(starts, pos + 1)), parse_recur),\\n      TInt(idx) => parse_postfix(tokens, starts, pos + 2, EDot(expr, __to_string(idx), callee_offset(expr), field_offset_at(starts, pos + 1)), parse_recur),\\n      _ => (expr, pos)\\n    },\\n    // `expr?` (railway try, #635): emit the type-directed sentinel\\n    // `__try_op(expr)` that the pre-check desugar lowers by `expr`'s head type —\\n    // Option -> yield inner on Some, early-`return None` on None; Result (the\\n    // default) -> yield inner on Ok, early-`return Err(e)` on Err. The parser\\n    // has no type info, so it defers the choice to the desugar. Continue postfix\\n    // parsing so `f(x)?.field` chains.\\n    TQuestion => parse_postfix(tokens, starts, pos + 1, ECall(EIdent(\\\"__try_op\\\", -1), [\\n      expr\\n    ], -1), parse_recur),\\n    _ => (expr, pos)\\n  }\\n}\\n\\nfn parse_prefix(tokens: Array[Token], starts: Array[Int], pos: Int, parse_recur: (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } {\\n  match peek(tokens, pos) {\\n    TMinus => {\\n      let (e, next) = parse_prefix(tokens, starts, pos + 1, parse_recur)\\n      (EUnaryOp(\\\"-\\\", e), next)\\n    },\\n    TNot => {\\n      let (e, next) = parse_prefix(tokens, starts, pos + 1, parse_recur)\\n      (EUnaryOp(\\\"!\\\", e), next)\\n    },\\n    _ => {\\n      let (e, next) = parse_primary(tokens, starts, pos, parse_recur)\\n      parse_postfix(tokens, starts, next, e, parse_recur)\\n    }\\n  }\\n}\\n\\n// #760(5): a loop-form expression (while / loop / for-in) evaluates to Unit,\\n// so it can never be a meaningful left operand of an infix operator. When one\\n// appears at statement position followed by a new line beginning with `-`/`+`\\n// (e.g. a bare `-1` after a `while` loop, or `return -1` mis-split), the\\n// greedy infix ladder used to fold it into `loop_result - 1`, which then failed\\n// as `Unit - Int`. Treat such a left as a completed statement and stop the\\n// ladder, so the `-1` parses as the next statement's unary-minus literal.\\nfn left_is_stmt_form(e: Expr) -> Bool {\\n  match e {\\n    EWhile(_, _) => true,\\n    ELoop(_, _) => true,\\n    EForIn(_, _, _, _) => true,\\n    _ => false\\n  }\\n}\\n\\nfn parse_infix_loop(tokens: Array[Token], starts: Array[Int], left: Expr, next: Int, min_prec: Int, expr_start: Int, cmp_locked: Bool, parse_recur: (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } {\\n  let tok = peek(tokens, next)\\n  let prec = binop_prec(tok)\\n  let should_stop = if prec < min_prec {\\n    true\\n  } else if cmp_locked {\\n    prec == 3\\n  } else if left_is_stmt_form(left) {\\n    // #760(5): a loop-form (while/loop/for-in) at statement position must not\\n    // swallow a trailing unary `-1`/`+1` on the next line as binary +/-. Only\\n    // `+`/`-` are ambiguous (they double as unary prefixes that begin a fresh\\n    // statement); an unambiguously-infix operator must still fold, so a\\n    // for-expression (which yields an array) stays pipeable, e.g.\\n    // `(for x in xs { x }) |> Array::length`. (#763 review)\\n    match tok {\\n      TPlus => true,\\n      TMinus => true,\\n      _ => false\\n    }\\n  } else {\\n    false\\n  }\\n  if should_stop {\\n    (left, next)\\n  } else {\\n    let is_pipe = match tok {\\n      TPipeGt => true,\\n      _ => false\\n    }\\n    let op = binop_op(tok)\\n    if is_pipe {\\n      if has_non_pipe_infix_top(tokens, expr_start, next) {\\n        throw(\\\"cannot mix '|>' with other infix operators without explicit parentheses\\\")\\n      }\\n    }\\n    let (right0, right_next0) = parse_prefix(tokens, starts, next + 1, parse_recur)\\n    let (right, rn) = parse_infix_loop(tokens, starts, right0, right_next0, prec + 1, next + 1, false, parse_recur)\\n    if is_pipe {\\n      if has_non_pipe_infix_top(tokens, next + 1, rn) {\\n        throw(\\\"cannot mix '|>' with other infix operators without explicit parentheses\\\")\\n      }\\n    }\\n    let combined = if is_pipe {\\n      pipe_desugar(left, right)\\n    } else {\\n      EBinOp(op, left, right)\\n    }\\n    let next_cmp_locked = if prec == 3 {\\n      true\\n    } else {\\n      cmp_locked\\n    }\\n    parse_infix_loop(tokens, starts, combined, rn, min_prec, expr_start, next_cmp_locked, parse_recur)\\n  }\\n}\\n\\n// `parse_infix_no_is` walks the operator-precedence ladder *without*\\n// consuming a trailing `expr is pattern` test at the end. The `if-cond is\\n// pat { ... }` special form (parsed in `parse_impl_dispatch` mode_if)\\n// needs the pattern to remain on the token stream so it can capture it\\n// as the if-cond's pattern arm; without this split the `is` gets\\n// swallowed here and the outer dispatch sees a stray `{` it cannot match\\n// against the if-cond pattern slot.\\nexport fn parse_infix_no_is(tokens: Array[Token], starts: Array[Int], pos: Int, min_prec: Int, expr_start: Int, parse_recur: (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } {\\n  let (left0, next0) = parse_prefix(tokens, starts, pos, parse_recur)\\n  parse_infix_loop(tokens, starts, left0, next0, min_prec, expr_start, false, parse_recur)\\n}\\n\\nexport fn parse_infix(tokens: Array[Token], starts: Array[Int], pos: Int, min_prec: Int, expr_start: Int, parse_recur: (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } {\\n  let (expr, en) = parse_infix_no_is(tokens, starts, pos, min_prec, expr_start, parse_recur)\\n  match peek(tokens, en) {\\n    TIs => {\\n      let (pat, pn) = parse_pattern(tokens, en + 1)\\n      (EMatch(expr, [\\n        (pat, EBool(true)),\\n        (PWild, EBool(false))\\n      ]), pn)\\n    },\\n    TIdent(kw) => if kw == \\\"is\\\" {\\n      let (pat, pn) = parse_pattern(tokens, en + 1)\\n      (EMatch(expr, [\\n        (pat, EBool(true)),\\n        (PWild, EBool(false))\\n      ]), pn)\\n    } else {\\n      (expr, en)\\n    },\\n    _ => (expr, en)\\n  }\\n}\\n\")\n}\n\nlet cli_adapter_source_10 = () -> (String, String) {\n  (\"lib/@vibe/parser/parser_expr_dispatch.vibe\",\n\"//# Imports\\n\\nimport ../ast {\\n  Expr, Pat, TypeExpr\\n}\\n\\nimport ./parser_base.vibe {\\n  empty_arms, empty_exprs, expect_tk, parse_enum_stmt, parse_pattern, parse_struct_stmt, parse_type_impl, peek, skip_semi, tk_name\\n}\\n\\nimport ./parser_expr_core.vibe {\\n  parse_infix_no_is\\n}\\n\\nimport ./token.vibe {\\n  Token\\n}\\n\\n//# Functions\\n\\n// Wrap `val` so that `((__asc: ty) -> __asc)(val)` forces `val` to have type\\n// `ty` (enforced by the call-argument check) while evaluating to `val` itself.\\n// Used to type-check a local `let x: T = e`, whose annotation `ELet` cannot\\n// store. Uses only EFn/ECall, so every downstream pass handles it unchanged.\\nfn ascribe_wrap(val: Expr, ty: TypeExpr) -> Expr {\\n  let tparams = Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n  let tbounds = Array::slice([\\n    (\\\"\\\", Array::slice([\\n      \\\"\\\"\\n    ], 0, 0))\\n  ], 0, 0)\\n  let params = [\\n    (\\\"__asc\\\", Some(ty))\\n  ]\\n  let lam = EFn(tparams, tbounds, params, None, None, EIdent(\\\"__asc\\\", 0 - 1))\\n  ECall(lam, [\\n    val\\n  ], 0 - 1)\\n}\\n\\n// #705: a local `let f: (A) -> R = (x) -> ..` must behave like the top-level\\n// form (parse_let_stmt / apply_generic_let_annotation): distribute the TyFn\\n// annotation onto the lambda's unannotated params / ret / effect. Hiding the\\n// lambda behind ascribe_wrap's `((__asc: T) -> __asc)(lam)` instead means the\\n// Perceus param heap-inference (fill_lambda_params / param_is_heap_in_body)\\n// never sees an annotation for the lambda's params, plans a heap param as\\n// scalar, and under-provisions its rc dups -- the callee-owns drops inside the\\n// body then free a still-live argument (use-after-free under VIBE_RC=1).\\n// Returns None when the annotation is not a TyFn, the value is not a lambda,\\n// or the arity does not match; callers fall back to ascribe_wrap (plain let)\\n// or the bare value (let rec, which previously discarded the annotation).\\nfn distribute_local_fn_ann(ann_ty: TypeExpr, val: Expr) -> Option[Expr] {\\n  match ann_ty {\\n    TyFn(param_types, ret_ty, effect_name) => match val {\\n      EFn(tp, tb, params, ret_opt, effect_opt, body) => {\\n        if Array::length(params) != Array::length(param_types) {\\n          None\\n        } else {\\n          let out = ArrayBuilder::new()\\n          let mut i = 0\\n          while i < Array::length(params) {\\n            let (pname, pann) = Array::get(params, i)\\n            let next_ann = match pann {\\n              Some(_) => pann,\\n              None => Some(Array::get(param_types, i))\\n            }\\n            ArrayBuilder::push(out, (pname, next_ann))\\n            i = i + 1\\n          }\\n          let next_ret = match ret_opt {\\n            Some(_) => ret_opt,\\n            None => Some(ret_ty)\\n          }\\n          let next_eff = match effect_opt {\\n            Some(_) => effect_opt,\\n            None => effect_name\\n          }\\n          Some(EFn(tp, tb, ArrayBuilder::freeze(out), next_ret, next_eff, body))\\n        }\\n      },\\n      _ => None\\n    },\\n    _ => None\\n  }\\n}\\n\\n// #789: `[T: A + B]` per-param trait-bound names (first name at `pos`). Private\\n// copy of parser_base.parse_method_tp_bound_names (not re-exportable across the\\n// package contract boundary).\\nfn dispatch_tp_bound_names(tokens: Array[Token], pos: Int) -> (Array[String], Int) with { Error } {\\n  let b = ArrayBuilder::new()\\n  let mut p = pos\\n  let mut done = false\\n  while !done {\\n    match peek(tokens, p) {\\n      TIdent(bname) => {\\n        ArrayBuilder::push(b, bname)\\n        p = p + 1\\n        match peek(tokens, p) {\\n          TPlus => {\\n            p = p + 1\\n          },\\n          _ => {\\n            done = true\\n          }\\n        }\\n      },\\n      _ => throw(\\\"expected trait bound name\\\")\\n    }\\n  }\\n  (ArrayBuilder::freeze(b), p)\\n}\\n\\n// #789: parse a `[T, U: Bound]` binder (`[` already consumed; first name token at\\n// `pos`). Private copy of parser_base.parse_method_type_params. Returns\\n// (type-param names, per-param bounds, next-after-`]`).\\nfn dispatch_type_params(tokens: Array[Token], pos: Int) -> (Array[String], Array[(String, Array[String])], Int) with { Error } {\\n  let names = ArrayBuilder::new()\\n  let bounds = ArrayBuilder::new()\\n  let mut p = pos\\n  let mut done = false\\n  while !done {\\n    match peek(tokens, p) {\\n      TRBracket => {\\n        p = p + 1\\n        done = true\\n      },\\n      TIdent(name) => {\\n        ArrayBuilder::push(names, name)\\n        p = p + 1\\n        match peek(tokens, p) {\\n          TColon => {\\n            let (bound_names, next) = dispatch_tp_bound_names(tokens, p + 1)\\n            ArrayBuilder::push(bounds, (name, bound_names))\\n            p = next\\n          },\\n          _ => ()\\n        }\\n        match peek(tokens, p) {\\n          TComma => {\\n            p = p + 1\\n          },\\n          TRBracket => {\\n            p = p + 1\\n            done = true\\n          },\\n          _ => throw(\\\"expected ',' or ']' in type params\\\")\\n        }\\n      },\\n      _ => throw(\\\"expected type parameter name or ']'\\\")\\n    }\\n  }\\n  (ArrayBuilder::freeze(names), ArrayBuilder::freeze(bounds), p)\\n}\\n\\n// #789: parse a local `let f: TYPE = ..` annotation, consuming an optional\\n// generic binder `[T, U: Bound]` first (like the top-level parse_let_annotation /\\n// parse_let_type_params, which the local block-let path previously lacked — a\\n// leading `[` gave `expected type but got [`). `pos` is the first annotation\\n// token (just after `:`). Returns (type-param names, per-param bounds, type,\\n// next position).\\nfn parse_local_let_annotation(tokens: Array[Token], pos: Int) -> (Array[String], Array[(String, Array[String])], TypeExpr, Int) with { Error } {\\n  match peek(tokens, pos) {\\n    TLBracket => {\\n      let (tps, tbs, after_binder) = dispatch_type_params(tokens, pos + 1)\\n      let (ty, next) = parse_type_impl(tokens, after_binder, 0)\\n      (tps, tbs, ty, next)\\n    },\\n    _ => {\\n      let (ty, next) = parse_type_impl(tokens, pos, 0)\\n      let no_tp = Array::slice([\\n        \\\"\\\"\\n      ], 0, 0)\\n      let no_tb = Array::slice([\\n        (\\\"\\\", Array::slice([\\n          \\\"\\\"\\n        ], 0, 0))\\n      ], 0, 0)\\n      (no_tp, no_tb, ty, next)\\n    }\\n  }\\n}\\n\\n// #789: attach a local generic-let's `[T]` binder to its (annotation-distributed)\\n// lambda, mirroring apply_generic_fn_annotation so the local function stays\\n// polymorphic. No-op when there are no type params or the value is not a lambda.\\nfn apply_local_let_tp(tps: Array[String], tbs: Array[(String, Array[String])], val: Expr) -> Expr {\\n  if Array::length(tps) > 0 {\\n    match val {\\n      EFn(_, _, params, ret, eff, body) => EFn(tps, tbs, params, ret, eff, body),\\n      _ => val\\n    }\\n  } else {\\n    val\\n  }\\n}\\n\\n// #644: source char offset of the token at `p` (the `let` keyword of a block\\n// statement) -- ELet/ELetMut carry it so break-mode codegen can emit a\\n// dbg_line probe even when the bound value is a bare literal with no offset.\\nfn blk_offset_at(starts: Array[Int], p: Int) -> Int {\\n  if p >= 0 && p < Array::length(starts) {\\n    Array::get(starts, p)\\n  } else {\\n    -1\\n  }\\n}\\n\\nenum BlockStep {\\n  StepSeq(Expr);\\n  StepValue(Expr);\\n  StepLet(String, Expr, Int);\\n  StepLetMut(String, Expr, Int);\\n  StepLetRec(String, Expr);\\n  StepAssign(String, Expr);\\n  StepAssignOp(String, String, Expr);\\n  StepPattern(Pat, Expr);\\n  StepPatternElse(Pat, Expr, Expr);\\n  StepStructDestr(Pat, Expr);\\n  StepRecordDestr(Pat, Expr);\\n  StepBind(String, Expr)\\n}\\n\\n// #666: desugar match-arm guards into existing constructs. `arms` is the\\n// collected arm list as (pattern, guard-or-EBool(true)-sentinel, body). A\\n// guarded arm `pat if g => body` becomes `pat => if g { body } else { match\\n// scrut { remaining } }` so a FAILED guard falls through to later arms; the\\n// remaining arms are also appended (for the pattern-doesn't-match case). The\\n// guard's Bool-check and codegen come for free via `EIf`. `scrut` must be a\\n// re-evaluable reference (the caller binds the scrutinee to a temp), so the\\n// nested match never re-runs a side-effecting scrutinee.\\nfn desugar_guarded(arms: Array[(Pat, Expr, Expr)], i: Int, scrut: Expr) -> Array[(Pat, Expr)] {\\n  if i >= Array::length(arms) {\\n    empty_arms()\\n  } else {\\n    let (pat, guard, body) = Array::get(arms, i)\\n    let rest = desugar_guarded(arms, i + 1, scrut)\\n    let no_guard = match guard {\\n      EBool(bv) => bv,\\n      _ => false\\n    }\\n    let arm_body = if no_guard {\\n      body\\n    } else {\\n      EIf(guard, body, EMatch(scrut, rest))\\n    }\\n    let out = ArrayBuilder::new()\\n    ArrayBuilder::push(out, (pat, arm_body))\\n    let mut j = 0\\n    while j < Array::length(rest) {\\n      ArrayBuilder::push(out, Array::get(rest, j))\\n      j = j + 1\\n    }\\n    ArrayBuilder::freeze(out)\\n  }\\n}\\n\\n// #666: parse all match arms into `b` as (pattern, guard|EBool(true), body),\\n// setting hg[0] when any arm carries a guard. Arms are comma-separated, ending\\n// at `}` (optionally with a trailing comma).\\nfn collect_match_arms(tokens: Array[Token], starts: Array[Int], pos: Int, b: ArrayBuilder[(Pat, Expr, Expr)], hg: Array[Bool], parse_recur: (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> Int with { Error } {\\n  let (pat, pa) = parse_pattern(tokens, pos)\\n  let (guard, after_g) = match peek(tokens, pa) {\\n    TIf => {\\n      Array::set(hg, 0, true)\\n      parse_recur(tokens, pa + 1, 0)\\n    },\\n    _ => (EBool(true), pa)\\n  }\\n  let arrow = expect_tk(tokens, after_g, \\\"=>\\\")\\n  let (body, bn) = parse_recur(tokens, arrow, 0)\\n  ArrayBuilder::push(b, (pat, guard, body))\\n  match peek(tokens, bn) {\\n    TComma => match peek(tokens, bn + 1) {\\n      TRBrace => bn + 2,\\n      _ => collect_match_arms(tokens, starts, bn + 1, b, hg, parse_recur)\\n    },\\n    TRBrace => bn + 1,\\n    // Comma-less arm separation: mirror the old parse_match_rest fall-through,\\n    // which parsed the next arm's pattern without consuming a separator.\\n    _ => collect_match_arms(tokens, starts, bn, b, hg, parse_recur)\\n  }\\n}\\n\\nfn qualify_handle_arm_pattern(effect_name: String, pat: Pat) -> Pat {\\n  match pat {\\n    PCtor(name, args) => if String::contains(name, \\\"::\\\") {\\n      PCtor(name, args)\\n    } else {\\n      PCtor(String::concat(effect_name, String::concat(\\\"::\\\", name)), args)\\n    },\\n    POr(left, right) => POr(qualify_handle_arm_pattern(effect_name, left), qualify_handle_arm_pattern(effect_name, right)),\\n    _ => pat\\n  }\\n}\\n\\nfn parse_handle_arm(tokens: Array[Token], starts: Array[Int], pos: Int, effect_name: String, parse_recur: (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> ((Pat, Expr), Int) with { Error } {\\n  let (pat, pat_next) = parse_pattern(tokens, pos)\\n  let qualified_pat = qualify_handle_arm_pattern(effect_name, pat)\\n  let arrow_pos = expect_tk(tokens, pat_next, \\\"=>\\\")\\n  let (expr, next) = parse_recur(tokens, arrow_pos, 0)\\n  ((qualified_pat, expr), next)\\n}\\n\\nfn parse_handle_rest(tokens: Array[Token], starts: Array[Int], pos: Int, body: Expr, effect_name: String, b: ArrayBuilder[(Pat, Expr)], parse_recur: (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } {\\n  match peek(tokens, pos) {\\n    TSemicolon => match peek(tokens, pos + 1) {\\n      TRBrace => (EHandle(body, ArrayBuilder::freeze(b)), pos + 2),\\n      _ => {\\n        let (arm, next) = parse_handle_arm(tokens, starts, pos + 1, effect_name, parse_recur)\\n        ArrayBuilder::push(b, arm)\\n        parse_handle_rest(tokens, starts, next, body, effect_name, b, parse_recur)\\n      }\\n    },\\n    TRBrace => (EHandle(body, ArrayBuilder::freeze(b)), pos + 1),\\n    _ => throw(\\\"expected ';' or '}' in handle arm list\\\")\\n  }\\n}\\n\\nfn parse_block_after_expr(tokens: Array[Token], pos: Int, e: Expr, parse_recur: (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } {\\n  match peek(tokens, pos) {\\n    TRBrace => (e, pos + 1),\\n    TSemicolon => {\\n      let (rest, end) = parse_recur(tokens, pos + 1, 20)\\n      (ESeq(e, rest), end)\\n    },\\n    TEq => match e {\\n      EIdent(name, _) => {\\n        let val_pair = parse_recur(tokens, pos + 1, 0)\\n        let val = val_pair.0\\n        let val_next = val_pair.1\\n        let a = skip_semi(tokens, val_next)\\n        let (rest, end) = parse_recur(tokens, a, 20)\\n        (EAssign(name, val, rest), end)\\n      },\\n      EDot(obj, field, _, _) => {\\n        let val_pair = parse_recur(tokens, pos + 1, 0)\\n        let val = val_pair.0\\n        let val_next = val_pair.1\\n        let a = skip_semi(tokens, val_next)\\n        let (rest, end) = parse_recur(tokens, a, 20)\\n        let set_args = empty_exprs()\\n        Array::push(set_args, obj)\\n        Array::push(set_args, EString(field))\\n        Array::push(set_args, val)\\n        (ESeq(ECall(EIdent(\\\"__set_field\\\", -1), set_args, -1), rest), end)\\n      },\\n      ECall(idx_callee, idx_args, _) => {\\n        // `arr[i] = v` (indexing parses as `__index(arr, i)`) desugars to\\n        // `Array::set(arr, i, v)` — host-era index assignment used across\\n        // vibe/shell and vibe/wasm sources previously died here with\\n        // \\\"invalid assignment target\\\". Array-only: a non-Array receiver\\n        // fails in the checker on Array::set's signature.\\n        let is_index = match idx_callee {\\n          EIdent(icn, _) => icn == \\\"__index\\\",\\n          _ => false\\n        }\\n        if is_index && Array::length(idx_args) == 2 {\\n          let val_pair = parse_recur(tokens, pos + 1, 0)\\n          let val = val_pair.0\\n          let val_next = val_pair.1\\n          let a = skip_semi(tokens, val_next)\\n          let (rest, end) = parse_recur(tokens, a, 20)\\n          let set_args = empty_exprs()\\n          Array::push(set_args, Array::get(idx_args, 0))\\n          Array::push(set_args, Array::get(idx_args, 1))\\n          Array::push(set_args, val)\\n          (ESeq(ECall(EIdent(\\\"Array::set\\\", -1), set_args, -1), rest), end)\\n        } else {\\n          throw(\\\"invalid assignment target\\\")\\n        }\\n      },\\n      _ => throw(\\\"invalid assignment target\\\")\\n    },\\n    TPlusEq => match e {\\n      EIdent(name, _) => {\\n        let val_pair = parse_recur(tokens, pos + 1, 0)\\n        let val = val_pair.0\\n        let val_next = val_pair.1\\n        let a = skip_semi(tokens, val_next)\\n        let (rest, end) = parse_recur(tokens, a, 20)\\n        (EAssignOp(name, \\\"+\\\", val, rest), end)\\n      },\\n      _ => throw(\\\"invalid assignment target\\\")\\n    },\\n    TMinusEq => match e {\\n      EIdent(name, _) => {\\n        let val_pair = parse_recur(tokens, pos + 1, 0)\\n        let val = val_pair.0\\n        let val_next = val_pair.1\\n        let a = skip_semi(tokens, val_next)\\n        let (rest, end) = parse_recur(tokens, a, 20)\\n        (EAssignOp(name, \\\"-\\\", val, rest), end)\\n      },\\n      _ => throw(\\\"invalid assignment target\\\")\\n    },\\n    TStarEq => match e {\\n      EIdent(name, _) => {\\n        let val_pair = parse_recur(tokens, pos + 1, 0)\\n        let val = val_pair.0\\n        let val_next = val_pair.1\\n        let a = skip_semi(tokens, val_next)\\n        let (rest, end) = parse_recur(tokens, a, 20)\\n        (EAssignOp(name, \\\"*\\\", val, rest), end)\\n      },\\n      _ => throw(\\\"invalid assignment target\\\")\\n    },\\n    TSlashEq => match e {\\n      EIdent(name, _) => {\\n        let val_pair = parse_recur(tokens, pos + 1, 0)\\n        let val = val_pair.0\\n        let val_next = val_pair.1\\n        let a = skip_semi(tokens, val_next)\\n        let (rest, end) = parse_recur(tokens, a, 20)\\n        (EAssignOp(name, \\\"/\\\", val, rest), end)\\n      },\\n      _ => throw(\\\"invalid assignment target\\\")\\n    },\\n    TPercentEq => match e {\\n      EIdent(name, _) => {\\n        let val_pair = parse_recur(tokens, pos + 1, 0)\\n        let val = val_pair.0\\n        let val_next = val_pair.1\\n        let a = skip_semi(tokens, val_next)\\n        let (rest, end) = parse_recur(tokens, a, 20)\\n        (EAssignOp(name, \\\"%\\\", val, rest), end)\\n      },\\n      _ => throw(\\\"invalid assignment target\\\")\\n    },\\n    _ => {\\n      let (rest, end) = parse_recur(tokens, pos, 20)\\n      if end <= pos {\\n        throw(\\\"internal parser error: block continuation did not advance\\\")\\n      } else {\\n        (ESeq(e, rest), end)\\n      }\\n    }\\n  }\\n}\\n\\nfn parse_block_value_body(tokens: Array[Token], eq: Int, parse_recur: (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Expr, Int, Int) with { Error } {\\n  let val_pair = parse_recur(tokens, eq, 0)\\n  let val = val_pair.0\\n  let val_next = val_pair.1\\n  let a = skip_semi(tokens, val_next)\\n  let (body, end) = parse_recur(tokens, a, 20)\\n  (val, body, end, a)\\n}\\n\\nfn parse_block_value_only(tokens: Array[Token], value_pos: Int, parse_recur: (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } {\\n  let val_pair = parse_recur(tokens, value_pos, 0)\\n  (val_pair.0, skip_semi(tokens, val_pair.1))\\n}\\n\\nfn apply_struct_destr(pat: Pat, val: Expr, rest: Expr) -> Expr {\\n  let val_name = \\\"__struct_destr\\\"\\n  let mut desugar = rest\\n  match pat {\\n    PStruct(_, fields) => {\\n      let mut di = Array::length(fields) - 1\\n      while di >= 0 {\\n        let (fname, fpat) = Array::get(fields, di)\\n        match fpat {\\n          PBind(bname) => {\\n            desugar = ELet(bname, EDot(EIdent(val_name, -1), fname, -1, -1), desugar, -1)\\n          },\\n          _ => ()\\n        }\\n        di = di - 1\\n      }\\n    },\\n    _ => ()\\n  }\\n  ELet(val_name, val, desugar, -1)\\n}\\n\\nfn apply_record_destr(pat: Pat, val: Expr, rest: Expr) -> Expr {\\n  let val_name = \\\"__rec_destr\\\"\\n  let mut desugar = rest\\n  match pat {\\n    PTuple(field_pats) => {\\n      let mut di = Array::length(field_pats) - 1\\n      while di >= 0 {\\n        let fp = Array::get(field_pats, di)\\n        match fp {\\n          PBind(bname) => {\\n            desugar = ELet(bname, ECall(EIdent(\\\"__rec_field\\\", -1), [\\n              EIdent(val_name, -1),\\n              EInt(di)\\n            ], -1), desugar, -1)\\n          },\\n          PTuple(sub_pats) => {\\n            let sub_name = String::concat(\\\"__rec_sub_\\\", __to_string(di))\\n            let mut si = Array::length(sub_pats) - 1\\n            while si >= 0 {\\n              match Array::get(sub_pats, si) {\\n                PBind(sname) => {\\n                  desugar = ELet(sname, EDot(EIdent(sub_name, -1), __to_string(si), -1, -1), desugar, -1)\\n                },\\n                _ => ()\\n              }\\n              si = si - 1\\n            }\\n            desugar = ELet(sub_name, ECall(EIdent(\\\"__rec_field\\\", -1), [\\n              EIdent(val_name, -1),\\n              EInt(di)\\n            ], -1), desugar, -1)\\n          },\\n          _ => ()\\n        }\\n        di = di - 1\\n      }\\n    },\\n    _ => ()\\n  }\\n  ELet(val_name, val, desugar, -1)\\n}\\n\\nfn apply_block_step(step: BlockStep, rest: Expr) -> Expr {\\n  match step {\\n    StepSeq(expr) => ESeq(expr, rest),\\n    StepValue(expr) => expr,\\n    StepLet(name, val, soff) => ELet(name, val, rest, soff),\\n    StepLetMut(name, val, soff) => ELetMut(name, val, rest, soff),\\n    StepLetRec(name, val) => ELetRec(name, val, rest),\\n    StepAssign(name, val) => EAssign(name, val, rest),\\n    StepAssignOp(name, op, val) => EAssignOp(name, op, val, rest),\\n    StepPattern(pat, val) => EMatch(val, [\\n      (pat, rest)\\n    ]),\\n    // #760(1): `let PAT = val else { alt }` — bind on match, else run the\\n    // diverging fallback. Desugars to a two-arm match whose wildcard arm is\\n    // the else body; the checker unifies both arms, so a fallback that\\n    // `return`s / `break`s / `throw`s (or yields the same type) type-checks.\\n    StepPatternElse(pat, val, alt) => EMatch(val, [\\n      (pat, rest),\\n      (PWild, alt)\\n    ]),\\n    StepStructDestr(pat, val) => apply_struct_destr(pat, val, rest),\\n    StepRecordDestr(pat, val) => apply_record_destr(pat, val, rest),\\n    // `let* x = e` (railway bind, #635): short-circuit on the failure case,\\n    // continue on the success case. The parser has no type info, so it emits a\\n    // type-directed sentinel `__try_bind(val, (x) -> rest)` that the pre-check\\n    // desugar (`desugar_trait_dict.vibe::rewrite_expr`) lowers by `val`'s head\\n    // type: `Option` -> `match val { Some(x) => rest, None => None }`, else\\n    // (`Result` or undeterminable) the original Result match\\n    //   `match val { Ok(x) => rest, Err(__bind_err) => Err(__bind_err) }`.\\n    // The continuation closure carries `x` + `rest` so `rest`'s scope is exact.\\n    StepBind(name, val) => ECall(EIdent(\\\"__try_bind\\\", -1), [\\n      val,\\n      EFn(Array::slice([\\n        \\\"\\\"\\n      ], 0, 0), Array::slice([\\n        (\\\"\\\", Array::slice([\\n          \\\"\\\"\\n        ], 0, 0))\\n      ], 0, 0), [\\n        (name, None)\\n      ], None, None, rest)\\n    ], -1)\\n  }\\n}\\n\\nfn fold_block_steps(steps: Array[BlockStep]) -> Expr {\\n  let mut result = EUnit\\n  let mut i = Array::length(steps) - 1\\n  while i >= 0 {\\n    result = apply_block_step(Array::get(steps, i), result)\\n    i = i - 1\\n  }\\n  result\\n}\\n\\n// #760(1): after a pattern-let's value, consume an optional `else { body }`\\n// (let-else) and return the body block. `else` is not an infix continuation,\\n// so parse_block_value_only stops before it; an `if/else`-valued RHS already\\n// consumed its own `else`, so only a genuine let-else `else` remains here.\\nfn parse_optional_let_else(tokens: Array[Token], pos: Int, parse_recur: (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Option[Expr], Int) with { Error } {\\n  match peek(tokens, pos) {\\n    TElse => {\\n      let br = expect_tk(tokens, pos + 1, \\\"{\\\")\\n      let (body, end) = parse_recur(tokens, br, 20)\\n      (Some(body), end)\\n    },\\n    _ => (None, pos)\\n  }\\n}\\n\\n// Push a refutable pattern-let step, folding in a let-else fallback when one\\n// follows. Returns the position past the (optional) else block.\\nfn push_pattern_let_step(tokens: Array[Token], steps: ArrayBuilder[BlockStep], pat: Pat, val: Expr, next_pos: Int, parse_recur: (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> Int with { Error } {\\n  let (else_body, after) = parse_optional_let_else(tokens, next_pos, parse_recur)\\n  match else_body {\\n    Some(alt) => ArrayBuilder::push(steps, StepPatternElse(pat, val, alt)),\\n    None => ArrayBuilder::push(steps, StepPattern(pat, val))\\n  }\\n  after\\n}\\n\\nfn parse_impl_block(tokens: Array[Token], starts: Array[Int], pos: Int, parse_recur: (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } {\\n  let steps = ArrayBuilder::new()\\n  let mut p = pos\\n  let mut end_pos = pos\\n  let mut done = false\\n  while !done {\\n    match peek(tokens, p) {\\n      TRBrace => {\\n        end_pos = p + 1\\n        done = true\\n      },\\n      TEof => throw(\\\"unexpected eof in block\\\"),\\n      TEnum => {\\n        let (enum_stmt, enum_end) = parse_enum_stmt(tokens, p + 1, false)\\n        match enum_stmt {\\n          SEnum(_, _, _, variants, _) => {\\n            let mut vi = 0\\n            while vi < Array::length(variants) {\\n              let (vname, vfields) = Array::get(variants, vi)\\n              if Array::length(vfields) == 0 {\\n                ArrayBuilder::push(steps, StepLet(vname, EInt(vi), -1))\\n              }\\n              vi = vi + 1\\n            }\\n          },\\n          _ => ()\\n        }\\n        p = enum_end\\n      },\\n      TStruct => {\\n        let (_, struct_end) = parse_struct_stmt(tokens, p + 1, false)\\n        p = struct_end\\n      },\\n      TLet => {\\n        let next = p + 1\\n        match peek(tokens, next) {\\n          TRec => match peek(tokens, next + 1) {\\n            TIdent(name) => {\\n              // #789: consume an optional `[T]` binder before the type, as for\\n              // the plain local let below.\\n              let (rtps, rtbs, rec_ann, eq_pos_r) = match peek(tokens, next + 2) {\\n                TColon => {\\n                  let (tps, tbs, rty, tp) = parse_local_let_annotation(tokens, next + 3)\\n                  (tps, tbs, Some(rty), tp)\\n                },\\n                _ => {\\n                  let no_tp = Array::slice([\\n                    \\\"\\\"\\n                  ], 0, 0)\\n                  let no_tb = Array::slice([\\n                    (\\\"\\\", Array::slice([\\n                      \\\"\\\"\\n                    ], 0, 0))\\n                  ], 0, 0)\\n                  (no_tp, no_tb, None, next + 2)\\n                }\\n              }\\n              let eq = expect_tk(tokens, eq_pos_r, \\\"=\\\")\\n              let (val, next_pos) = parse_block_value_only(tokens, eq, parse_recur)\\n              if next_pos <= eq {\\n                throw(\\\"internal parser error: block let-rec parser did not advance\\\")\\n              } else {\\n                // #705: same TyFn-annotation distribution as the plain local\\n                // let below. The annotation used to be parsed and discarded\\n                // here; keep that as the fallback (no ascribe_wrap -- a\\n                // wrapped value would break letrec's direct-lambda shape).\\n                // #789: re-attach a `[T]` binder to the distributed lambda.\\n                let val2 = match rec_ann {\\n                  Some(the_type) => match distribute_local_fn_ann(the_type, val) {\\n                    Some(distributed) => apply_local_let_tp(rtps, rtbs, distributed),\\n                    None => val\\n                  },\\n                  None => val\\n                }\\n                ArrayBuilder::push(steps, StepLetRec(name, val2))\\n                p = next_pos\\n              }\\n            },\\n            _ => throw(\\\"expected identifier after 'let rec'\\\")\\n          },\\n          TMut => match peek(tokens, next + 1) {\\n            TIdent(name) => {\\n              // #824: the annotation used to be parsed only to locate `=` and\\n              // then discarded — `let mut x: Bool = 5` compiled silently.\\n              // Enforce it exactly like the immutable branch: distribute a\\n              // TyFn annotation onto a lambda value, otherwise ascribe-wrap.\\n              let (m_ann, eq_pos_m) = match peek(tokens, next + 2) {\\n                TColon => {\\n                  let (mty, tp) = parse_type_impl(tokens, next + 3, 0)\\n                  (Some(mty), tp)\\n                },\\n                _ => (None, next + 2)\\n              }\\n              let eq = expect_tk(tokens, eq_pos_m, \\\"=\\\")\\n              let (val, next_pos) = parse_block_value_only(tokens, eq, parse_recur)\\n              if next_pos <= eq {\\n                throw(\\\"internal parser error: block let-mut parser did not advance\\\")\\n              } else {\\n                let val2 = match m_ann {\\n                  Some(the_type) => match distribute_local_fn_ann(the_type, val) {\\n                    Some(distributed) => distributed,\\n                    None => ascribe_wrap(val, the_type)\\n                  },\\n                  None => val\\n                }\\n                ArrayBuilder::push(steps, StepLetMut(name, val2, blk_offset_at(starts, next - 1)))\\n                p = next_pos\\n              }\\n            },\\n            _ => throw(\\\"expected identifier after 'let mut'\\\")\\n          },\\n          TStar => match peek(tokens, next + 1) {\\n            TIdent(name) => {\\n              let eq = expect_tk(tokens, next + 2, \\\"=\\\")\\n              let (val, next_pos) = parse_block_value_only(tokens, eq, parse_recur)\\n              if next_pos <= eq {\\n                throw(\\\"internal parser error: block let* parser did not advance\\\")\\n              } else {\\n                ArrayBuilder::push(steps, StepBind(name, val))\\n                p = next_pos\\n              }\\n            },\\n            _ => throw(\\\"expected identifier after 'let*'\\\")\\n          },\\n          TIdent(name) => {\\n            let after_name = peek(tokens, next + 1)\\n            let next_is_struct_destr = match after_name {\\n              TDoubleColon => {\\n                let fc = String::char_code_at(name, 0)\\n                if fc >= 65 && fc <= 90 {\\n                  match peek(tokens, next + 2) {\\n                    TLBrace => true,\\n                    _ => false\\n                  }\\n                } else {\\n                  false\\n                }\\n              },\\n              _ => false\\n            }\\n            let next_is_record_destr = match after_name {\\n              TLBrace => name == \\\"record\\\",\\n              _ => false\\n            }\\n            if next_is_struct_destr {\\n              let (pat, pn) = parse_pattern(tokens, next)\\n              let eq = expect_tk(tokens, pn, \\\"=\\\")\\n              let (val, next_pos) = parse_block_value_only(tokens, eq, parse_recur)\\n              ArrayBuilder::push(steps, StepStructDestr(pat, val))\\n              p = next_pos\\n            } else if next_is_record_destr {\\n              let (pat, pn) = parse_pattern(tokens, next)\\n              let eq = expect_tk(tokens, pn, \\\"=\\\")\\n              let (val, next_pos) = parse_block_value_only(tokens, eq, parse_recur)\\n              ArrayBuilder::push(steps, StepRecordDestr(pat, val))\\n              p = next_pos\\n            } else {\\n              match after_name {\\n                TLParen => {\\n                  let (pat, pn) = parse_pattern(tokens, next)\\n                  let eq = expect_tk(tokens, pn, \\\"=\\\")\\n                  let (val, next_pos) = parse_block_value_only(tokens, eq, parse_recur)\\n                  if next_pos <= eq {\\n                    throw(\\\"internal parser error: block let-ctor-pat parser did not advance\\\")\\n                  } else {\\n                    p = push_pattern_let_step(tokens, steps, pat, val, next_pos, parse_recur)\\n                  }\\n                },\\n                _ => {\\n                  // #789: parse an optional `[T]` binder before the type so a\\n                  // local generic `let f: [T](T) -> T = ..` parses like top-level.\\n                  let (ltps, ltbs, ann_type, eq_pos) = match after_name {\\n                    TColon => {\\n                      let (tps, tbs, the_type, tp) = parse_local_let_annotation(tokens, next + 2)\\n                      (tps, tbs, Some(the_type), tp)\\n                    },\\n                    _ => {\\n                      let no_tp = Array::slice([\\n                        \\\"\\\"\\n                      ], 0, 0)\\n                      let no_tb = Array::slice([\\n                        (\\\"\\\", Array::slice([\\n                          \\\"\\\"\\n                        ], 0, 0))\\n                      ], 0, 0)\\n                      (no_tp, no_tb, None, next + 1)\\n                    }\\n                  }\\n                  let eq = expect_tk(tokens, eq_pos, \\\"=\\\")\\n                  let (val, next_pos) = parse_block_value_only(tokens, eq, parse_recur)\\n                  if next_pos <= eq {\\n                    throw(\\\"internal parser error: block let parser did not advance\\\")\\n                  } else {\\n                    // A local `let x: T = e` carries no type field on `ELet`, so\\n                    // enforce `e : T` by wrapping the value in an identity\\n                    // application `((__asc: T) -> __asc)(e)` whose argument check\\n                    // (unify_call_args) rejects a mismatch — no new AST node, and\\n                    // codegen sees only ordinary EFn/ECall. Exception (#705): a\\n                    // TyFn annotation on a lambda value is distributed onto the\\n                    // lambda itself instead (see distribute_local_fn_ann) so the\\n                    // Perceus param heap-inference sees the param types. #789: a\\n                    // `[T]` binder is re-attached to the distributed lambda.\\n                    let val2 = match ann_type {\\n                      Some(the_type) => match distribute_local_fn_ann(the_type, val) {\\n                        Some(distributed) => apply_local_let_tp(ltps, ltbs, distributed),\\n                        None => ascribe_wrap(val, the_type)\\n                      },\\n                      None => val\\n                    }\\n                    ArrayBuilder::push(steps, StepLet(name, val2, blk_offset_at(starts, next - 1)))\\n                    p = next_pos\\n                  }\\n                }\\n              }\\n            }\\n          },\\n          TLParen => {\\n            let (pat, pn) = parse_pattern(tokens, next)\\n            let eq = expect_tk(tokens, pn, \\\"=\\\")\\n            let (val, next_pos) = parse_block_value_only(tokens, eq, parse_recur)\\n            if next_pos <= eq {\\n              throw(\\\"internal parser error: block let-pat parser did not advance\\\")\\n            } else {\\n              p = push_pattern_let_step(tokens, steps, pat, val, next_pos, parse_recur)\\n            }\\n          },\\n          _ => throw(\\\"expected identifier after 'let'\\\")\\n        }\\n      },\\n      _ => {\\n        let (e, next) = parse_recur(tokens, p, 0)\\n        if next <= p {\\n          throw(\\\"internal parser error: block expr parser did not advance\\\")\\n        } else {\\n          match peek(tokens, next) {\\n            TRBrace => {\\n              ArrayBuilder::push(steps, StepValue(e))\\n              end_pos = next + 1\\n              done = true\\n            },\\n            TSemicolon => {\\n              ArrayBuilder::push(steps, StepSeq(e))\\n              p = next + 1\\n            },\\n            TEq => match e {\\n              EIdent(name, _) => {\\n                let (val, next_pos) = parse_block_value_only(tokens, next + 1, parse_recur)\\n                ArrayBuilder::push(steps, StepAssign(name, val))\\n                p = next_pos\\n              },\\n              EDot(obj, field, _, _) => {\\n                let (val, next_pos) = parse_block_value_only(tokens, next + 1, parse_recur)\\n                let set_args = empty_exprs()\\n                Array::push(set_args, obj)\\n                Array::push(set_args, EString(field))\\n                Array::push(set_args, val)\\n                ArrayBuilder::push(steps, StepSeq(ECall(EIdent(\\\"__set_field\\\", -1), set_args, -1)))\\n                p = next_pos\\n              },\\n              ECall(sidx_callee, sidx_args, _) => {\\n                // `arr[i] = v` in the step-block path (same desugar as the\\n                // parse_block_after_expr TEq arm above).\\n                let s_is_index = match sidx_callee {\\n                  EIdent(sicn, _) => sicn == \\\"__index\\\",\\n                  _ => false\\n                }\\n                if s_is_index && Array::length(sidx_args) == 2 {\\n                  let (val, next_pos) = parse_block_value_only(tokens, next + 1, parse_recur)\\n                  let set_args = empty_exprs()\\n                  Array::push(set_args, Array::get(sidx_args, 0))\\n                  Array::push(set_args, Array::get(sidx_args, 1))\\n                  Array::push(set_args, val)\\n                  ArrayBuilder::push(steps, StepSeq(ECall(EIdent(\\\"Array::set\\\", -1), set_args, -1)))\\n                  p = next_pos\\n                } else {\\n                  throw(\\\"invalid assignment target\\\")\\n                }\\n              },\\n              _ => throw(\\\"invalid assignment target\\\")\\n            },\\n            TPlusEq => match e {\\n              EIdent(name, _) => {\\n                let (val, next_pos) = parse_block_value_only(tokens, next + 1, parse_recur)\\n                ArrayBuilder::push(steps, StepAssignOp(name, \\\"+\\\", val))\\n                p = next_pos\\n              },\\n              _ => throw(\\\"invalid assignment target\\\")\\n            },\\n            TMinusEq => match e {\\n              EIdent(name, _) => {\\n                let (val, next_pos) = parse_block_value_only(tokens, next + 1, parse_recur)\\n                ArrayBuilder::push(steps, StepAssignOp(name, \\\"-\\\", val))\\n                p = next_pos\\n              },\\n              _ => throw(\\\"invalid assignment target\\\")\\n            },\\n            TStarEq => match e {\\n              EIdent(name, _) => {\\n                let (val, next_pos) = parse_block_value_only(tokens, next + 1, parse_recur)\\n                ArrayBuilder::push(steps, StepAssignOp(name, \\\"*\\\", val))\\n                p = next_pos\\n              },\\n              _ => throw(\\\"invalid assignment target\\\")\\n            },\\n            TSlashEq => match e {\\n              EIdent(name, _) => {\\n                let (val, next_pos) = parse_block_value_only(tokens, next + 1, parse_recur)\\n                ArrayBuilder::push(steps, StepAssignOp(name, \\\"/\\\", val))\\n                p = next_pos\\n              },\\n              _ => throw(\\\"invalid assignment target\\\")\\n            },\\n            TPercentEq => match e {\\n              EIdent(name, _) => {\\n                let (val, next_pos) = parse_block_value_only(tokens, next + 1, parse_recur)\\n                ArrayBuilder::push(steps, StepAssignOp(name, \\\"%\\\", val))\\n                p = next_pos\\n              },\\n              _ => throw(\\\"invalid assignment target\\\")\\n            },\\n            _ => {\\n              ArrayBuilder::push(steps, StepSeq(e))\\n              p = next\\n            }\\n          }\\n        }\\n      }\\n    }\\n  }\\n  (fold_block_steps(ArrayBuilder::freeze(steps)), end_pos)\\n}\\n\\n// `for await x in s { body }` is parsed to `EForIn(x, _, __await_iter(s), body)`\\n// — the iterable wrapped in a `__await_iter` marker call. The marker carries the\\n// `await` intent past the parser (which has no type information) to the\\n// dict-passing desugar (`desugar_trait_dict.vibe`), which picks the iterator vs\\n// pull-closure loop by `s`'s type and strips the marker. The checker unwraps the\\n// marker so it never sees `__await_iter` as a real function (docs/spec §M2c-3).\\n\\nexport fn parse_impl_dispatch(tokens: Array[Token], starts: Array[Int], pos: Int, mode: Int, parse_recur: (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } {\\n  if mode == 20 {\\n    parse_impl_block(tokens, starts, pos, parse_recur)\\n  } else if mode == 21 {\\n    // Parse cond with the no-is variant so a trailing `is pattern` belongs\\n    // to the if-cond pattern slot rather than collapsing into a Bool match.\\n    let (cond, cn) = parse_infix_no_is(tokens, starts, pos, 0, pos, parse_recur)\\n    let mut is_mode = false\\n    let mut is_pat_val = PWild\\n    let mut brace_pos = cn\\n    match peek(tokens, cn) {\\n      TIs => {\\n        let (pat, pn) = parse_pattern(tokens, cn + 1)\\n        is_mode = true\\n        is_pat_val = pat\\n        brace_pos = pn\\n      },\\n      TIdent(kw) => if kw == \\\"is\\\" {\\n        let (pat, pn) = parse_pattern(tokens, cn + 1)\\n        is_mode = true\\n        is_pat_val = pat\\n        brace_pos = pn\\n      },\\n      _ => ()\\n    }\\n    let br = expect_tk(tokens, brace_pos, \\\"{\\\")\\n    let (then_e, tn) = parse_recur(tokens, br, 20)\\n    let (else_e, end_pos) = match peek(tokens, tn) {\\n      TElse => match peek(tokens, tn + 1) {\\n        TIf => parse_recur(tokens, tn + 2, 21),\\n        TLBrace => parse_recur(tokens, tn + 2, 20),\\n        _ => parse_recur(tokens, tn + 1, 0)\\n      },\\n      _ => (EUnit, tn)\\n    }\\n    if is_mode {\\n      (EMatch(cond, [\\n        (is_pat_val, then_e),\\n        (PWild, else_e)\\n      ]), end_pos)\\n    } else {\\n      (EIf(cond, then_e, else_e), end_pos)\\n    }\\n  } else if mode == 22 {\\n    let (scrutinee, sn) = parse_recur(tokens, pos, 0)\\n    let br = expect_tk(tokens, sn, \\\"{\\\")\\n    match peek(tokens, br) {\\n      TRBrace => (EMatch(scrutinee, empty_arms()), br + 1),\\n      _ => {\\n        // #666: collect arms as (pattern, guard|EBool(true), body). If any arm\\n        // carries a guard, bind the scrutinee to a temp `__mg` (so a failed\\n        // guard can re-match it without re-evaluating a side-effecting\\n        // scrutinee) and desugar guards into nested EIf/EMatch. Otherwise emit\\n        // a plain EMatch.\\n        let ab = ArrayBuilder::new()\\n        let hg = [false]\\n        let endpos = collect_match_arms(tokens, starts, br, ab, hg, parse_recur)\\n        let arms3 = ArrayBuilder::freeze(ab)\\n        if Array::get(hg, 0) {\\n          let final_arms = desugar_guarded(arms3, 0, EIdent(\\\"__mg\\\", 0 - 1))\\n          (ELet(\\\"__mg\\\", scrutinee, EMatch(EIdent(\\\"__mg\\\", 0 - 1), final_arms), -1), endpos)\\n        } else {\\n          let plain = ArrayBuilder::new()\\n          let mut k = 0\\n          while k < Array::length(arms3) {\\n            let (p, _, bd) = Array::get(arms3, k)\\n            ArrayBuilder::push(plain, (p, bd))\\n            k = k + 1\\n          }\\n          (EMatch(scrutinee, ArrayBuilder::freeze(plain)), endpos)\\n        }\\n      }\\n    }\\n  } else if mode == 23 {\\n    let (cond, cn) = parse_recur(tokens, pos, 0)\\n    let br = expect_tk(tokens, cn, \\\"{\\\")\\n    let (body, end) = parse_recur(tokens, br, 20)\\n    (EWhile(cond, body), end)\\n  } else if mode == 24 {\\n    let br = expect_tk(tokens, pos, \\\"{\\\")\\n    let (body, bn) = parse_recur(tokens, br, 20)\\n    let wp = expect_tk(tokens, bn, \\\"with\\\")\\n    let (effect_name, effect_next) = match peek(tokens, wp) {\\n      TIdent(name) => (name, wp + 1),\\n      _ => throw(\\\"expected effect name after 'with'\\\")\\n    }\\n    let hb = expect_tk(tokens, effect_next, \\\"{\\\")\\n    match peek(tokens, hb) {\\n      TRBrace => (EHandle(body, empty_arms()), hb + 1),\\n      _ => {\\n        let b = ArrayBuilder::new()\\n        let (arm, next) = parse_handle_arm(tokens, starts, hb, effect_name, parse_recur)\\n        ArrayBuilder::push(b, arm)\\n        parse_handle_rest(tokens, starts, next, body, effect_name, b, parse_recur)\\n      }\\n    }\\n  } else if mode == 25 {\\n    // `for await x in stream { ... }`: `await` is not a keyword (it is the\\n    // builtin call `await(...)`), so detect the async-iterator marker as an\\n    // `await` identifier immediately followed by the binding name. When present,\\n    // the iterable is wrapped in a `__await_iter(..)` marker so the desugar can\\n    // pick the iterator vs pull-closure loop by type (docs/spec §M2c-3). Without\\n    // the marker, `for x in arr` iterates an eager Array[T] via EForIn. A loop\\n    // variable literally named `await` (`for await in e`) is still parsed as a\\n    // binding because `await` is then followed by `in`, so `is_await` stays\\n    // false.\\n    let mut start = pos\\n    let mut is_await = false\\n    match peek(tokens, pos) {\\n      TIdent(marker) => if marker == \\\"await\\\" {\\n        match peek(tokens, pos + 1) {\\n          TIdent(_) => { start = pos + 1; is_await = true },\\n          _ => ()\\n        }\\n      } else (),\\n      _ => ()\\n    }\\n    match peek(tokens, start) {\\n      TIdent(first_name) => match peek(tokens, start + 1) {\\n        TComma => match peek(tokens, start + 2) {\\n          TIdent(second_name) => {\\n            let ip = expect_tk(tokens, start + 3, \\\"in\\\")\\n            match parse_recur(tokens, ip, 0) {\\n              (iterable, after_iter) => {\\n                let bb = expect_tk(tokens, after_iter, \\\"{\\\")\\n                let (body, end) = parse_recur(tokens, bb, 20)\\n                let loop_expr = if is_await {\\n                  EForIn(second_name, Some(first_name), ECall(EIdent(\\\"__await_iter\\\", -1), [\\n                    iterable\\n                  ], -1), body)\\n                } else {\\n                  EForIn(second_name, Some(first_name), iterable, body)\\n                }\\n                (loop_expr, end)\\n              },\\n              _ => throw(\\\"unreachable: parse_recur for for-in\\\")\\n            }\\n          },\\n          _ => throw(\\\"expected value binding name after ','\\\")\\n        },\\n        _ => {\\n          let ip = expect_tk(tokens, start + 1, \\\"in\\\")\\n          match parse_recur(tokens, ip, 0) {\\n            (iterable, after_iter) => {\\n              let bb = expect_tk(tokens, after_iter, \\\"{\\\")\\n              let (body, end) = parse_recur(tokens, bb, 20)\\n              let loop_expr = if is_await {\\n                EForIn(first_name, None, ECall(EIdent(\\\"__await_iter\\\", -1), [\\n                  iterable\\n                ], -1), body)\\n              } else {\\n                EForIn(first_name, None, iterable, body)\\n              }\\n              (loop_expr, end)\\n            },\\n            _ => throw(\\\"unreachable: parse_recur for for-in\\\")\\n          }\\n        }\\n      }\\n      ,\\n      _ => throw(\\\"expected identifier after 'for'\\\")\\n    }\\n  } else {\\n    let actual = tk_name(peek(tokens, pos))\\n    throw(\\\"internal parser error: unknown parse mode \\\\{mode} at #\\\\{pos} token=\\\\{actual}\\\")\\n  }\\n}\\n\")\n}\n\nlet cli_adapter_source_11 = () -> (String, String) {\n  (\"lib/@vibe/parser/parser_expr.vibe\",\n\"//# Imports\\n\\nimport ../ast {\\n  Expr, Stmt, TypeExpr\\n}\\n\\nimport ./parser_base.vibe {\\n  _no_tb, _no_tp, collect_effect_names, collect_import_path, empty_exprs, empty_fields, empty_import_items, empty_params, expect_tk, is_tk, mode_block, parse_binding_name, parse_effect_stmt, parse_enum_stmt, parse_impl_stmt_dispatch, parse_import_item, parse_param_list, parse_struct_field, parse_suberror_stmt, parse_trait_stmt, parse_type, parse_type_alias_stmt, parse_type_impl, peek, skip_braced_body, tk_name\\n}\\n\\nimport ./parser_expr_core.vibe {\\n  parse_infix\\n}\\n\\nimport ./parser_expr_dispatch.vibe {\\n  parse_impl_dispatch\\n}\\n\\nimport ./token.vibe {\\n  Token\\n}\\n\\n//# Functions\\n\\nexport fn parse_impl(tokens: Array[Token], starts: Array[Int], pos: Int, mode: Int) -> (Expr, Int) with { Error } {\\n  let rec parse_recur: (Array[Token], Int, Int) -> (Expr, Int) with { Error } = (rtoks, rpos, rmode) -> {\\n    if rmode >= 0 && rmode <= 10 {\\n      parse_infix(rtoks, starts, rpos, rmode, rpos, parse_recur)\\n    } else {\\n      parse_impl_dispatch(rtoks, starts, rpos, rmode, parse_recur)\\n    }\\n  }\\n  parse_recur(tokens, pos, mode)\\n}\\n\\nexport fn parse(tokens: Array[Token]) -> Expr with { Error } {\\n  let (e, next) = parse_impl(tokens, [], 0, 0)\\n  match peek(tokens, next) {\\n    TEof => e,\\n    _ => {\\n      let actual = tk_name(peek(tokens, next))\\n      throw(\\\"unexpected after expression: \\\\{actual}\\\")\\n    }\\n  }\\n}\\n\\nexport fn parse_ok(tokens: Array[Token]) -> Bool {\\n  handle {\\n    let _ = parse(tokens)\\n    true\\n  } with Error {\\n    Throw(_) => false\\n  }\\n}\\n\\nexport fn parse_expr(tokens: Array[Token], pos: Int) -> (Expr, Int) with { Error } {\\n  parse_impl(tokens, [], pos, 0)\\n}\\n\\nfn parse_type_param_bound_names(tokens: Array[Token], pos: Int) -> (Array[String], Int) with { Error } {\\n  let b = ArrayBuilder::new()\\n  let mut p = pos\\n  let mut done = false\\n  while !done {\\n    match peek(tokens, p) {\\n      TIdent(name) => {\\n        ArrayBuilder::push(b, name)\\n        p = p + 1\\n        match peek(tokens, p) {\\n          TPlus => {\\n            p = p + 1\\n          },\\n          _ => {\\n            done = true\\n          }\\n        }\\n      },\\n      _ => throw(\\\"expected trait bound name\\\")\\n    }\\n  }\\n  (ArrayBuilder::freeze(b), p)\\n}\\n\\nfn parse_let_type_params(tokens: Array[Token], pos: Int) -> (Array[String], Array[(String, Array[String])], Int) with { Error } {\\n  let names = ArrayBuilder::new()\\n  let bounds = ArrayBuilder::new()\\n  let mut p = pos\\n  while true {\\n    match peek(tokens, p) {\\n      TRBracket => {\\n        p = p + 1\\n        break\\n      },\\n      TIdent(name) => {\\n        ArrayBuilder::push(names, name)\\n        p = p + 1\\n        match peek(tokens, p) {\\n          TColon => {\\n            let (bound_names, next) = parse_type_param_bound_names(tokens, p + 1)\\n            ArrayBuilder::push(bounds, (name, bound_names))\\n            p = next\\n          },\\n          _ => ()\\n        }\\n        match peek(tokens, p) {\\n          TComma => {\\n            p = p + 1\\n          },\\n          TRBracket => {\\n            p = p + 1\\n            break\\n          },\\n          _ => throw(\\\"expected ',' or ']' in type params\\\")\\n        }\\n      },\\n      _ => throw(\\\"expected type parameter name or ']'\\\")\\n    }\\n  }\\n  (ArrayBuilder::freeze(names), ArrayBuilder::freeze(bounds), p)\\n}\\n\\nfn parse_let_annotation(tokens: Array[Token], pos: Int) -> (Array[String], Array[(String, Array[String])], TypeExpr, Int) with { Error } {\\n  match peek(tokens, pos) {\\n    TLBracket => {\\n      let (type_params, type_bounds, after_params) = parse_let_type_params(tokens, pos + 1)\\n      let (ty, next) = parse_type_impl(tokens, after_params, 0)\\n      (type_params, type_bounds, ty, next)\\n    },\\n    _ => {\\n      let (ty, next) = parse_type_impl(tokens, pos, 0)\\n      (_no_tp(), _no_tb(), ty, next)\\n    }\\n  }\\n}\\n\\nfn apply_fn_annotation_params(params: Array[(String, Option[TypeExpr])], param_types: Array[TypeExpr]) -> Array[(String, Option[TypeExpr])] {\\n  if Array::length(params) != Array::length(param_types) {\\n    params\\n  } else {\\n    let out = ArrayBuilder::new()\\n    let mut i = 0\\n    while i < Array::length(params) {\\n      let (name, ann) = Array::get(params, i)\\n      let next_ann = match ann {\\n        Some(_) => ann,\\n        None => Some(Array::get(param_types, i))\\n      }\\n      ArrayBuilder::push(out, (name, next_ann))\\n      i = i + 1\\n    }\\n    ArrayBuilder::freeze(out)\\n  }\\n}\\n\\nfn apply_generic_fn_annotation(type_params: Array[String], type_bounds: Array[(String, Array[String])], ann: Option[TypeExpr], val: Expr, param_types: Array[TypeExpr], ret_ty: TypeExpr, effect_name: Option[String]) -> (Option[TypeExpr], Expr) {\\n  match val {\\n    EFn(existing_type_params, existing_type_bounds, params, ret_opt, effect_opt, body) => {\\n      let next_params = apply_fn_annotation_params(params, param_types)\\n      let next_ret = match ret_opt {\\n        Some(_) => ret_opt,\\n        None => Some(ret_ty)\\n      }\\n      let next_effect = match effect_opt {\\n        Some(_) => effect_opt,\\n        None => effect_name\\n      }\\n      let next_type_params = if Array::length(type_params) > 0 {\\n        type_params\\n      } else existing_type_params\\n      let next_type_bounds = if Array::length(type_params) > 0 {\\n        type_bounds\\n      } else existing_type_bounds\\n      let next_ann = if Array::length(type_params) > 0 {\\n        None\\n      } else ann\\n      (next_ann, EFn(next_type_params, next_type_bounds, next_params, next_ret, next_effect, body))\\n    },\\n    _ => (ann, val)\\n  }\\n}\\n\\nfn apply_generic_let_annotation(type_params: Array[String], type_bounds: Array[(String, Array[String])], ann: Option[TypeExpr], val: Expr) -> (Option[TypeExpr], Expr) {\\n  match ann {\\n    Some(ann_ty) => match ann_ty {\\n      TyFn(param_types, ret_ty, effect_name) => apply_generic_fn_annotation(type_params, type_bounds, ann, val, param_types, ret_ty, effect_name),\\n      _ => (ann, val)\\n    },\\n    _ => (ann, val)\\n  }\\n}\\n\\n// Inject a value-position type-parameter header `[T: Ord]` (from\\n// `let f = [T: Ord](...)`) into the resulting lambda's EFn type_params/bounds.\\n// Previously these were skipped and discarded, so the lambda had no type\\n// params: the body checked with `T` as a concrete `CtNamed(\\\"T\\\")` rather than a\\n// bound type variable. That happened to work standalone (unresolved type names\\n// are tolerated) but broke once the module was re-exported and re-checked.\\nfn apply_value_bracket_type_params(tps: Array[String], tbs: Array[(String, Array[String])], val: Expr) -> Expr {\\n  if Array::length(tps) == 0 {\\n    val\\n  } else {\\n    match val {\\n      EFn(existing_tp, existing_tb, params, ret, eff, body) => {\\n        let next_tp = if Array::length(existing_tp) > 0 {\\n          existing_tp\\n        } else tps\\n        let next_tb = if Array::length(existing_tp) > 0 {\\n          existing_tb\\n        } else tbs\\n        EFn(next_tp, next_tb, params, ret, eff, body)\\n      },\\n      _ => val\\n    }\\n  }\\n}\\n\\nfn skip_generic_value_start(tokens: Array[Token], pos: Int) -> Int {\\n  match peek(tokens, pos) {\\n    TLBracket => match peek(tokens, pos + 1) {\\n      TIdent(_) => {\\n        let maybe_generic = match peek(tokens, pos + 2) {\\n          TRBracket => match peek(tokens, pos + 3) {\\n            TLParen => true,\\n            _ => false\\n          },\\n          TColon => true,\\n          TComma => true,\\n          _ => false\\n        }\\n        if maybe_generic {\\n          let mut scan_pos = pos + 1\\n          let mut depth = 1\\n          while depth > 0 {\\n            match peek(tokens, scan_pos) {\\n              TLBracket => {\\n                depth = depth + 1\\n              },\\n              TRBracket => {\\n                depth = depth - 1\\n              },\\n              _ => ()\\n            }\\n            scan_pos = scan_pos + 1\\n          }\\n          scan_pos\\n        } else {\\n          pos\\n        }\\n      },\\n      _ => pos\\n    },\\n    _ => pos\\n  }\\n}\\n\\n// Parse a value-position generic header `[T: Ord]` at `pos` (just after `=`)\\n// when one is present, returning its type params/bounds plus the position of\\n// the value that follows. When there is no generic header (e.g. an array\\n// literal `[1, 2]`), returns empty params and `pos` unchanged.\\nfn parse_value_bracket_header(tokens: Array[Token], pos: Int) -> (Array[String], Array[(String, Array[String])], Int) with { Error } {\\n  let skipped = skip_generic_value_start(tokens, pos)\\n  if skipped == pos {\\n    (_no_tp(), _no_tb(), pos)\\n  } else {\\n    match peek(tokens, pos) {\\n      TLBracket => {\\n        let (tps, tbs, _after) = parse_let_type_params(tokens, pos + 1)\\n        (tps, tbs, skipped)\\n      },\\n      _ => (_no_tp(), _no_tb(), skipped)\\n    }\\n  }\\n}\\n\\nfn parse_let_stmt(tokens: Array[Token], starts: Array[Int], pos: Int, exported: Bool) -> (Stmt, Int) with { Error } {\\n  match peek(tokens, pos) {\\n    TRec => {\\n      let (name, name_next) = parse_binding_name(tokens, pos + 1)\\n      let (type_params, type_bounds, ty_opt, eq_pos) = match peek(tokens, name_next) {\\n        TColon => {\\n          let (tparams, tbounds, ty, tp) = parse_let_annotation(tokens, name_next + 1)\\n          (tparams, tbounds, Some(ty), tp)\\n        },\\n        _ => (_no_tp(), _no_tb(), None, name_next)\\n      }\\n      let ep = expect_tk(tokens, eq_pos, \\\"=\\\")\\n      let (bracket_tps, bracket_tbs, val_start_r) = parse_value_bracket_header(tokens, ep)\\n      let val_pair = parse_impl(tokens, starts, val_start_r, 0)\\n      let val_with_tp = apply_value_bracket_type_params(bracket_tps, bracket_tbs, val_pair.0)\\n      let (final_ty_opt, val) = apply_generic_let_annotation(type_params, type_bounds, ty_opt, val_with_tp)\\n      let val_next = val_pair.1\\n      (SLet(exported, true, name, final_ty_opt, val), val_next)\\n    },\\n    TMut => match peek(tokens, pos + 1) {\\n      TIdent(name) => {\\n        let (ty_opt, eq_pos) = match peek(tokens, pos + 2) {\\n          TColon => {\\n            let (ty, tp) = parse_type_impl(tokens, pos + 3, 0)\\n            (Some(ty), tp)\\n          },\\n          _ => (None, pos + 2)\\n        }\\n        let ep = expect_tk(tokens, eq_pos, \\\"=\\\")\\n        let val_pair = parse_impl(tokens, starts, ep, 0)\\n        let val = val_pair.0\\n        let val_next = val_pair.1\\n        (SLetMut(name, ty_opt, val), val_next)\\n      },\\n      _ => throw(\\\"expected name after 'let mut'\\\")\\n    },\\n    // #859: top-level pattern `let` (tuple destructure `let (a, b) = pair`,\\n    // and the `Name::{ .. }` struct-destructure case below) parses fine and\\n    // type-checks fine (`checker_stmt.vibe`'s `SLetPat` arm happily binds the\\n    // pattern names into the type environment) but codegen has no case for\\n    // a top-level `SLetPat` at all -- ANY pattern shape, including a bare\\n    // `let (x) = 5` that degenerates to a single `PBind`, crashes with a raw\\n    // \\\"undefined variable (ident): x\\\" at compile time instead of either\\n    // working or producing a proper diagnostic. Root cause (full writeup on\\n    // #859): pattern-`let` lowering only exists as a block-level mechanism\\n    // (`parser_expr_dispatch.vibe`'s `apply_struct_destr`/`apply_record_destr`,\\n    // which wrap the REST of an enclosing expression continuation in nested\\n    // `ELet`s) -- top-level statements have no such enclosing continuation\\n    // (each top-level `let` is its own independent global binding), so\\n    // properly supporting this needs a real multi-statement lowering\\n    // plumbed through every `parse_program*` variant plus the checker/\\n    // codegen pipeline, not a local parser change. Until that lands (#859),\\n    // reject with a clear, LOCATED error instead of the misleading internal\\n    // crash -- same treatment #830 already gave the `record { .. }` form.\\n    TLParen => {\\n      throw(\\\"top-level 'let (..) = <expr>' tuple destructuring is not supported (#859); move it into a function body (e.g. 'fn main() { let (a, b) = <expr>; .. }')\\\")\\n    },\\n    TIdent(_name0) => {\\n      // #830: `let record { a, b } = r` (record-pattern destructuring, #760)\\n      // parses fine as a *local* `let` (parser_expr_dispatch's block-step\\n      // parser special-cases `TIdent(\\\"record\\\") + TLBrace` into\\n      // StepRecordDestr, desugared via positional `__rec_field` reads) but\\n      // this top-level `let` parser had no matching case: `record` fell\\n      // through to the plain-binding-name path below, which expects `=`\\n      // right after the name and instead hit `{` -- a confusing raw\\n      // \\\"expected = but got {\\\" error that gives no hint the syntax itself\\n      // is the problem.\\n      //\\n      // Top-level statements don't go through the block-step machinery (no\\n      // single enclosing `ELet`/`EMatch` continuation to desugar into: each\\n      // top-level `let` becomes its own independent global binding), so\\n      // accepting the pattern here would need a real multi-statement\\n      // expansion (one destructured field per top-level binding) plumbed\\n      // through every `parse_program*` variant plus the checker/codegen\\n      // pipeline -- not a local change (top-level tuple/struct-name pattern\\n      // `let`s already silently miscompile the same way, #830 investigation).\\n      // Until that lands, fail fast with a clear, LOCATED error instead of\\n      // the misleading parse error (see docs/doctest-report-2026-07-12.md\\n      // §2 class E / #830).\\n      let is_top_level_record_destr = match peek(tokens, pos + 1) {\\n        TLBrace => _name0 == \\\"record\\\",\\n        _ => false\\n      }\\n      if is_top_level_record_destr {\\n        throw(\\\"top-level 'let record { .. } = <expr>' destructuring is not supported (#830); move it into a function body (e.g. 'fn main() { let record { .. } = <expr>; .. }')\\\")\\n      }\\n      let is_struct_destructure = match peek(tokens, pos + 1) {\\n        TDoubleColon => match peek(tokens, pos + 2) {\\n          TLBrace => true,\\n          _ => false\\n        },\\n        _ => false\\n      }\\n      if is_struct_destructure {\\n        // #859: same root cause as the tuple-destructure case above -- a\\n        // named-struct pattern let (`let Name::{ x, y } = v`) parses and\\n        // type-checks fine at top level but codegen has no `SLetPat` case,\\n        // crashing with a raw \\\"undefined variable\\\" instead of working.\\n        throw(\\\"top-level 'let Name::{ .. } = <expr>' struct destructuring is not supported (#859); move it into a function body (e.g. 'fn main() { let Name::{ x, y } = <expr>; .. }')\\\")\\n      } else {\\n        let (name, name_next) = parse_binding_name(tokens, pos)\\n        let (type_params, type_bounds, ty_opt, eq_pos) = match peek(tokens, name_next) {\\n          TColon => {\\n            let (tparams, tbounds, ty, tp) = parse_let_annotation(tokens, name_next + 1)\\n            (tparams, tbounds, Some(ty), tp)\\n          },\\n          _ => (_no_tp(), _no_tb(), None, name_next)\\n        }\\n        let ep = expect_tk(tokens, eq_pos, \\\"=\\\")\\n        let (bracket_tps, bracket_tbs, val_start) = parse_value_bracket_header(tokens, ep)\\n        let val_pair = parse_impl(tokens, starts, val_start, 0)\\n        let val_with_tp = apply_value_bracket_type_params(bracket_tps, bracket_tbs, val_pair.0)\\n        let (final_ty_opt, val) = apply_generic_let_annotation(type_params, type_bounds, ty_opt, val_with_tp)\\n        let val_next = val_pair.1\\n        (SLet(exported, false, name, final_ty_opt, val), val_next)\\n      }\\n    },\\n    _ => throw(\\\"expected name after 'let'\\\")\\n  }\\n}\\n\\n// #727 (ADR-0064 Phase A): top-level `fn` sugar.\\n//   fn name[T: Eq](x: Int, y: Int) -> Int with { E } where { ... } { body }\\n// desugars to the same SLet + EFn shape impl methods lower to\\n// (SLet(exported, rec, name, None, EFn(tps, tbs, params, Some(ret), eff, body))),\\n// so checker/codegen are untouched. Full annotations are required (every\\n// param typed + explicit return type): ADR-0037's forward-reference\\n// conditions then always hold, so the binding is always `rec`. The\\n// `where { ... }` contract clause is brace-balance skipped for now —\\n// retention + assert semantics land with Phase E (#731); until then\\n// fmt/normalize reject it (same guardrail pattern as #cfg, ADR-0061).\\n// Shared fn-signature head: `name[T: Eq](x: Int, y: Int) -> Ret with { E }\\n// where { ... }` starting AFTER the `fn` keyword. Returns\\n// ((name, tps, tbs), (params, ret_ty, eff_opt), (requires, ensures), next)\\n// with `next` positioned after the where clause — at the body `{` for a\\n// definition, or at the following statement for a .vibei contract\\n// declaration (#729). The `where { requires: e, ensures: e }` contract\\n// clause (#731, ADR-0064 §7) parses each condition as an ordinary Bool\\n// expression; `ensures` conditions may reference the function result as\\n// `result`. Multiple requires/ensures entries are allowed.\\nexport fn parse_fn_signature(tokens: Array[Token], pos: Int) -> ((String, Array[String], Array[(String, Array[String])]), (Array[(String, Option[TypeExpr])], TypeExpr, Option[String]), (Array[Expr], Array[Expr]), Int) with { Error } {\\n  let (name, name_next) = parse_binding_name(tokens, pos)\\n  let (tps, tbs, after_gen) = parse_value_bracket_header(tokens, name_next)\\n  let lp = expect_tk(tokens, after_gen, \\\"(\\\")\\n  let (params, after_params) = parse_param_list(tokens, lp)\\n  let mut pi = 0\\n  while pi < Array::length(params) {\\n    let param = Array::get(params, pi)\\n    let pty = param.1\\n    match pty {\\n      Some(_) => (),\\n      None => throw(\\\"fn parameter '\\\\{param.0}' requires a type annotation\\\")\\n    }\\n    pi = pi + 1\\n  }\\n  let arrow = expect_tk(tokens, after_params, \\\"->\\\")\\n  let (ret_ty, ret_next) = parse_type_impl(tokens, arrow, 0)\\n  let (eff_opt, eff_next) = match peek(tokens, ret_next) {\\n    TWith => {\\n      let wb = expect_tk(tokens, ret_next + 1, \\\"{\\\")\\n      let (eff_names, en) = collect_effect_names(tokens, wb, \\\"\\\")\\n      (Some(eff_names), en)\\n    },\\n    _ => (None, ret_next)\\n  }\\n  let reqs = Array::slice([\\n    EIdent(\\\"\\\", 0 - 1)\\n  ], 0, 0)\\n  let enss = Array::slice([\\n    EIdent(\\\"\\\", 0 - 1)\\n  ], 0, 0)\\n  let where_next = match peek(tokens, eff_next) {\\n    TIdent(w) => if w == \\\"where\\\" {\\n      let mut wp = expect_tk(tokens, eff_next + 1, \\\"{\\\")\\n      let mut wdone = false\\n      while !wdone {\\n        match peek(tokens, wp) {\\n          TRBrace => {\\n            wp = wp + 1\\n            wdone = true\\n          },\\n          TIdent(kind) => {\\n            let cp = expect_tk(tokens, wp + 1, \\\":\\\")\\n            let (cond, cnext) = parse_impl(tokens, [], cp, 0)\\n            if kind == \\\"requires\\\" {\\n              Array::push(reqs, cond)\\n            } else if kind == \\\"ensures\\\" {\\n              Array::push(enss, cond)\\n            } else {\\n              throw(\\\"expected 'requires' or 'ensures' in where clause, got '\\\\{kind}'\\\")\\n            }\\n            wp = match peek(tokens, cnext) {\\n              TComma => cnext + 1,\\n              _ => cnext\\n            }\\n          },\\n          _ => throw(\\\"expected 'requires', 'ensures', or '}' in where clause\\\")\\n        }\\n      }\\n      wp\\n    } else eff_next,\\n    _ => eff_next\\n  }\\n  ((name, tps, tbs), (params, ret_ty, eff_opt), (reqs, enss), where_next)\\n}\\n\\n// ADR-0069 Phase 1: `fn main { ... }` / `fn main with { Fs } { ... }` — the ONE\\n// fn form allowed to omit the parens and all annotations. It is a pure sugar\\n// for `fn main() -> Unit [with { .. }] { ... }`: the branch below builds the\\n// exact SFnDecl shape the general path would produce for that spelling\\n// (EFn([], [], [], Some(TyName(\\\"Unit\\\")), eff_opt, body)), so lower_fn_decl_stmt,\\n// checker, codegen, and the printer round-trip (which prints the annotated\\n// `fn main() -> Unit` spelling — same meaning) are all untouched.\\nfn parse_fn_main_stmt(tokens: Array[Token], starts: Array[Int], pos: Int, exported: Bool) -> (Stmt, Int) with { Error } {\\n  // pos points at the `main` identifier; the caller verified the next token\\n  // is `{` (body) or `with` (capability row then body).\\n  let (eff_opt, body_start) = match peek(tokens, pos + 1) {\\n    TWith => {\\n      let wb = expect_tk(tokens, pos + 2, \\\"{\\\")\\n      let (eff_names, en) = collect_effect_names(tokens, wb, \\\"\\\")\\n      (Some(eff_names), en)\\n    },\\n    _ => (None, pos + 1)\\n  }\\n  let br = expect_tk(tokens, body_start, \\\"{\\\")\\n  let (body, end) = parse_impl(tokens, starts, br, mode_block)\\n  (SFnDecl(exported, \\\"main\\\", EFn(_no_tp(), _no_tb(), empty_params(), Some(TyName(\\\"Unit\\\")), eff_opt, body), empty_exprs(), empty_exprs()), end)\\n}\\n\\nfn parse_fn_stmt(tokens: Array[Token], starts: Array[Int], pos: Int, exported: Bool) -> (Stmt, Int) with { Error } {\\n  // ADR-0069 Phase 1: dispatch the `fn main {` / `fn main with {` special form\\n  // before the general signature parse (which requires `(`). `fn main(` still\\n  // takes the general path, so an explicit signature keeps working.\\n  let is_main_special = match peek(tokens, pos) {\\n    TIdent(n0) => if n0 == \\\"main\\\" {\\n      match peek(tokens, pos + 1) {\\n        TLBrace => true,\\n        TWith => true,\\n        _ => false\\n      }\\n    } else {\\n      false\\n    },\\n    _ => false\\n  }\\n  if is_main_special {\\n    parse_fn_main_stmt(tokens, starts, pos, exported)\\n  } else {\\n    parse_fn_stmt_general(tokens, starts, pos, exported)\\n  }\\n}\\n\\n// #805 (ADR-0072): `fn name(a: Int, b: Int) -> Int = wasm \\\"(...)\\\"` — an\\n// inline-wasm-bodied fn (linear backend only). The declared signature is\\n// TRUSTED, extern-let style; the body is raw WAT text carried through the\\n// existing AST as the unspoofable marker call `%wasm(\\\"<text>\\\")` (a real\\n// `%`-ident can never be parsed in expression position — TPercent is only\\n// the mod operator — so user source cannot forge it). Multiple adjacent\\n// string literals are joined with newlines (the lexer has no raw/multiline\\n// strings). v0.3 slice restrictions enforced here: monomorphic, empty\\n// effect row, no where-contracts, and every param + the return type spelled\\n// literally `Int` (raw 62-bit tagged i64 at the boundary, ADR-0055).\\nfn parse_fn_wasm_body(tokens: Array[Token], pos: Int, exported: Bool, name: String, tps: Array[String], tbs: Array[(String, Array[String])], params: Array[(String, Option[TypeExpr])], ret_ty: TypeExpr, eff_opt: Option[String], reqs: Array[Expr], enss: Array[Expr]) -> (Stmt, Int) with { Error } {\\n  // pos is at the token AFTER `= wasm`.\\n  if Array::length(tps) > 0 {\\n    throw(\\\"inline wasm fn '\\\\{name}' cannot take type parameters (v0.3: monomorphic only) at #\\\\{pos}\\\")\\n  } else {\\n    ()\\n  }\\n  match eff_opt {\\n    Some(_) => throw(\\\"inline wasm fn '\\\\{name}' must have an empty effect row (remove the 'with { ... }' clause) at #\\\\{pos}\\\"),\\n    None => ()\\n  }\\n  if Array::length(reqs) > 0 || Array::length(enss) > 0 {\\n    throw(\\\"inline wasm fn '\\\\{name}' cannot declare where-contracts at #\\\\{pos}\\\")\\n  } else {\\n    ()\\n  }\\n  let mut wi = 0\\n  while wi < Array::length(params) {\\n    let (pn, pt) = Array::get(params, wi)\\n    let ok = match pt {\\n      Some(TyName(tn)) => tn == \\\"Int\\\",\\n      _ => false\\n    }\\n    if !ok {\\n      throw(\\\"inline wasm fn '\\\\{name}': param '\\\\{pn}' must be typed Int (v0.3 slice: raw tagged i64 params only) at #\\\\{pos}\\\")\\n    } else {\\n      ()\\n    }\\n    wi = wi + 1\\n  }\\n  let ret_ok = match ret_ty {\\n    TyName(rn) => rn == \\\"Int\\\",\\n    _ => false\\n  }\\n  if !ret_ok {\\n    throw(\\\"inline wasm fn '\\\\{name}': return type must be Int (v0.3 slice: raw tagged i64 result only) at #\\\\{pos}\\\")\\n  } else {\\n    ()\\n  }\\n  match peek(tokens, pos) {\\n    TString(first) => {\\n      let mut text = first\\n      let mut sp = pos + 1\\n      let mut more = true\\n      while more {\\n        match peek(tokens, sp) {\\n          TString(nxt) => {\\n            text = String::concat(text, String::concat(\\\"\\\\n\\\", nxt))\\n            sp = sp + 1\\n          },\\n          _ => {\\n            more = false\\n          }\\n        }\\n      }\\n      let marker = ECall(EIdent(\\\"%wasm\\\", -1), [\\n        EString(text)\\n      ], -1);\\n      (SFnDecl(exported, name, EFn(tps, tbs, params, Some(ret_ty), None, marker), reqs, enss), sp)\\n    },\\n    _ => throw(\\\"expected WAT string literal after '= wasm' in fn '\\\\{name}' at #\\\\{pos}\\\")\\n  }\\n}\\n\\nfn parse_fn_stmt_general(tokens: Array[Token], starts: Array[Int], pos: Int, exported: Bool) -> (Stmt, Int) with { Error } {\\n  let (head, sig, contracts, where_next) = parse_fn_signature(tokens, pos)\\n  let (name, tps, tbs) = head\\n  let (params, ret_ty, eff_opt) = sig\\n  let (reqs, enss) = contracts\\n  // #805: `= wasm \\\"...\\\"` inline-wasm body form (see parse_fn_wasm_body).\\n  let is_wasm_body = match peek(tokens, where_next) {\\n    TEq => match peek(tokens, where_next + 1) {\\n      TIdent(kw) => kw == \\\"wasm\\\",\\n      _ => false\\n    },\\n    _ => false\\n  }\\n  if is_wasm_body {\\n    parse_fn_wasm_body(tokens, where_next + 2, exported, name, tps, tbs, params, ret_ty, eff_opt, reqs, enss)\\n  } else {\\n  let br = expect_tk(tokens, where_next, \\\"{\\\")\\n  let (body, end) = parse_impl(tokens, starts, br, mode_block)\\n  // ADR-0064 (#727/#731): keep the declaration form — including the where\\n  // contract's requires/ensures conditions — in the AST so the printer and\\n  // normalize can round-trip `fn`. The runtime contract desugar (identical\\n  // semantics to the old parse-time inline form) lives in\\n  // lower_fn_decl_stmt, applied by parse_stmt / parse_program before the\\n  // checker/codegen ever see the program.\\n  (SFnDecl(exported, name, EFn(tps, tbs, params, Some(ret_ty), eff_opt, body), reqs, enss), end)\\n  }\\n}\\n\\n// #731 (ADR-0064 §7 Phase 1): where-contract desugar + fn-declaration\\n// lowering to the legacy `let rec` shape. requires conditions assert at\\n// entry; ensures conditions bind the body's value as `result` and assert at\\n// exit. v1 semantics are Eiffel-style ALWAYS-ON runtime checks (a violating\\n// call traps); compile-time stripping for release builds is a later\\n// refinement. Known limits (documented): an early `return` inside the body\\n// bypasses ensures; `result` shadows any user binding of that name inside\\n// ensures conditions. Applied by the default parse entry points\\n// (parse_stmt / parse_program*) so checker/codegen keep seeing the\\n// pre-#727 `SLet(exported, true, name, None, EFn(..))` shape; only the\\n// *_preserving entry points hand out SFnDecl.\\nexport fn lower_fn_decl_stmt(stmt: Stmt) -> Stmt {\\n  match stmt {\\n    SFnDecl(exported, name, fn_value, reqs, enss) => match fn_value {\\n      EFn(tps, tbs, params, ret_opt, eff_opt, body) => {\\n        let body_with_ensures = if Array::length(enss) == 0 {\\n          body\\n        } else {\\n          let mut exit_expr = EIdent(\\\"result\\\", 0 - 1)\\n          let mut ei = Array::length(enss)\\n          while ei > 0 {\\n            ei = ei - 1\\n            exit_expr = ESeq(ECall(EIdent(\\\"assert\\\", 0 - 1), [\\n              Array::get(enss, ei)\\n            ], 0 - 1), exit_expr)\\n          }\\n          ELet(\\\"result\\\", body, exit_expr, -1)\\n        }\\n        let mut guarded = body_with_ensures\\n        let mut qi = Array::length(reqs)\\n        while qi > 0 {\\n          qi = qi - 1\\n          guarded = ESeq(ECall(EIdent(\\\"assert\\\", 0 - 1), [\\n            Array::get(reqs, qi)\\n          ], 0 - 1), guarded)\\n        }\\n        SLet(exported, true, name, None, EFn(tps, tbs, params, ret_opt, eff_opt, guarded))\\n      },\\n      _ => SLet(exported, true, name, None, fn_value)\\n    },\\n    _ => stmt\\n  }\\n}\\n\\nexport fn lower_fn_decl_stmts(stmts: Array[Stmt]) -> Array[Stmt] {\\n  for s in stmts {\\n    lower_fn_decl_stmt(s)\\n  }\\n}\\n\\n//# Misc\\n\\nexport {\\n  collect_import_path, empty_fields, empty_import_items, expect_tk, is_tk, lower_fn_decl_stmt, lower_fn_decl_stmts, parse, parse_effect_stmt, parse_enum_stmt, parse_expr, parse_fn_stmt, parse_impl, parse_impl_stmt_dispatch, parse_import_item, parse_let_stmt, parse_ok, parse_struct_field, parse_suberror_stmt, parse_trait_stmt, parse_type, parse_type_alias_stmt, peek, tk_name\\n}\\n\\nexport {\\n  peek, is_tk, parse, tk_name, parse_ok, expect_tk, parse_expr, parse_impl, parse_type, empty_fields, parse_let_stmt, parse_fn_stmt, parse_enum_stmt, parse_trait_stmt, parse_effect_stmt, parse_import_item, empty_import_items, parse_struct_field, collect_import_path, parse_suberror_stmt, parse_type_alias_stmt, parse_impl_stmt_dispatch, lower_fn_decl_stmt, lower_fn_decl_stmts\\n}\\n\")\n}\n\nlet cli_adapter_source_12 = () -> (String, String) {\n  (\"lib/@vibe/parser/parser.vibe\",\n\"//# Imports\\n\\nimport ../ast {\\n  Expr, Pat, Stmt, TypeExpr\\n}\\n\\nimport ./parser_base.vibe {\\n  collect_import_path, empty_fields, empty_import_items, expect_tk, parse_effect_stmt, parse_enum_stmt, parse_impl_stmt_dispatch, parse_import_item, parse_struct_field, parse_suberror_stmt, parse_tparam_names, parse_trait_stmt, parse_type, parse_type_alias_stmt, parse_derive_names, peek, skip_braced_body, skip_derive, tk_name\\n}\\n\\nimport ./parser_expr.vibe {\\n  lower_fn_decl_stmt, lower_fn_decl_stmts, parse, parse_expr, parse_fn_stmt, parse_impl, parse_let_stmt, parse_ok\\n}\\n\\nimport ./token.vibe {\\n  Token\\n}\\n\\nimport ./lexer.vibe {\\n  offset_to_line_col\\n}\\n\\n//# Functions\\n\\nlet parser_mode_block = 20\\n\\nfn empty_names() -> Array[String] {\\n  Array::slice([\\n    \\\"_\\\"\\n  ], 0, 0)\\n}\\n\\nfn parse_test_stmt(tokens: Array[Token], starts: Array[Int], pos: Int) -> (Stmt, Int) with { Error } {\\n  match peek(tokens, pos) {\\n    TString(name) => {\\n      let br = expect_tk(tokens, pos + 1, \\\"{\\\")\\n      let (body, end) = parse_impl(tokens, starts, br, parser_mode_block);\\n      (STest(name, body), end)\\n    },\\n    _ => throw(\\\"expected test name string\\\")\\n  }\\n}\\n\\nfn parse_bench_stmt(tokens: Array[Token], starts: Array[Int], pos: Int) -> (Stmt, Int) with { Error } {\\n  match peek(tokens, pos) {\\n    TString(name) => {\\n      let br = expect_tk(tokens, pos + 1, \\\"{\\\")\\n      let (body, end) = parse_impl(tokens, starts, br, parser_mode_block);\\n      (SBench(name, body), end)\\n    },\\n    _ => throw(\\\"expected bench name string\\\")\\n  }\\n}\\n\\n// Parse one export-list name, accepting a qualified `Ns::member`\\n// (e.g. `JsonSchema::validate`) in addition to a bare ident.\\nfn parse_export_name(tokens: Array[Token], pos: Int) -> (String, Int) with { Error } {\\n  match peek(tokens, pos) {\\n    TIdent(name) => match peek(tokens, pos + 1) {\\n      TDoubleColon => match peek(tokens, pos + 2) {\\n        TIdent(member) =>\\n          (String::concat(name, String::concat(\\\"::\\\", member)), pos + 3),\\n        _ => throw(\\\"expected qualified member name after '::'\\\")\\n      },\\n      _ => (name, pos + 1)\\n    },\\n    _ => throw(\\\"expected name in export list\\\")\\n  }\\n}\\n\\nfn parse_export_names_rest(tokens: Array[Token], pos: Int, b: ArrayBuilder[String]) -> (Array[String], Int) with { Error } {\\n  match peek(tokens, pos) {\\n    TComma => match peek(tokens, pos + 1) {\\n      TRBrace => (ArrayBuilder::freeze(b), pos + 2),\\n      TIdent(_) => {\\n        let (nm, after) = parse_export_name(tokens, pos + 1)\\n        ArrayBuilder::push(b, nm)\\n        parse_export_names_rest(tokens, after, b)\\n      },\\n      _ => throw(\\\"expected name in export list\\\")\\n    },\\n    TRBrace => (ArrayBuilder::freeze(b), pos + 1),\\n    _ => throw(\\\"expected ',' or '}' in export list\\\")\\n  }\\n}\\n\\nfn parse_import_items_rest(tokens: Array[Token], pos: Int, b: ArrayBuilder[(String, Option[String])]) -> (Array[(String, Option[String])], Int) with { Error } {\\n  match peek(tokens, pos) {\\n    TComma => match peek(tokens, pos + 1) {\\n      TRBrace => (ArrayBuilder::freeze(b), pos + 2),\\n      _ => {\\n        let (item, next) = parse_import_item(tokens, pos + 1)\\n        ArrayBuilder::push(b, item)\\n        parse_import_items_rest(tokens, next, b)\\n      }\\n    },\\n    TRBrace => (ArrayBuilder::freeze(b), pos + 1),\\n    _ => throw(\\\"expected ',' or '}' in import list\\\")\\n  }\\n}\\n\\nfn parse_import_items(tokens: Array[Token], pos: Int) -> (Array[(String, Option[String])], Int) with { Error } {\\n  match peek(tokens, pos) {\\n    TRBrace => (empty_import_items(), pos + 1),\\n    _ => {\\n      let (first, next) = parse_import_item(tokens, pos)\\n      let b = ArrayBuilder::new()\\n      ArrayBuilder::push(b, first)\\n      parse_import_items_rest(tokens, next, b)\\n    }\\n  }\\n}\\n\\n// #897: `import <path> as <mod> only { x, y }` binds the imported items\\n// under a namespace, accessed as `mod.x`/`mod.y` in the importing file.\\n// No new Stmt/Expr variant: each item's local alias is desugared to the\\n// dot-joined string \\\"mod.x\\\" (real identifiers can never contain '.', so\\n// this can't collide with anything a user could type) and stored as an\\n// ordinary SImport — the existing import_alias_rewrite.vibe machinery\\n// resolves it exactly like any other aliased import. `only` is a\\n// contextual keyword (matched by ident text, not a reserved token) to\\n// avoid reserving \\\"only\\\" globally.\\nfn qualify_import_items(mod_name: String, items: Array[(String, Option[String])]) -> Array[(String, Option[String])] {\\n  let b = ArrayBuilder::new()\\n  let mut i = 0\\n  while i < Array::length(items) {\\n    let (name, alias_opt) = Array::get(items, i)\\n    let local = match alias_opt {\\n      Some(alias) => alias,\\n      None => name\\n    }\\n    ArrayBuilder::push(b, (name, Some(String::concat(mod_name, String::concat(\\\".\\\", local)))))\\n    i = i + 1\\n  }\\n  ArrayBuilder::freeze(b)\\n}\\n\\nfn parse_qualified_import_tail(tokens: Array[Token], pos: Int, path: String, mod_name: String) -> (Stmt, Int) with { Error } {\\n  match peek(tokens, pos) {\\n    TIdent(only_kw) => if only_kw == \\\"only\\\" {\\n      let br = expect_tk(tokens, pos + 1, \\\"{\\\")\\n      let (items, end) = parse_import_items(tokens, br);\\n      (SImport(path, qualify_import_items(mod_name, items)), end)\\n    } else {\\n      throw(\\\"expected 'only' after 'as <name>' in qualified import\\\")\\n    },\\n    _ => throw(\\\"expected 'only' after 'as <name>' in qualified import\\\")\\n  }\\n}\\n\\n// #769: a trailing `import <path> @alias` alias token must be recognized\\n// regardless of what the path itself starts with. This used to be checked\\n// only on the branch for a path starting with a bare identifier (`import\\n// pkg_name @alias`); a path starting with `.`/`..` (the common case for the\\n// compiler's own facades, e.g. `import ../../../lib/@vibe/json @json`) fell\\n// through the catch-all `_` arm below, which always demanded a `{` next and\\n// never looked for an alias — surfacing as \\\"expected { but got ident\\\" once\\n// collect_import_path correctly stopped just before the alias token.\\nfn parse_import_path_tail(tokens: Array[Token], bp: Int, path: String) -> (Stmt, Int) with { Error } {\\n  match peek(tokens, bp) {\\n    TAs => match peek(tokens, bp + 1) {\\n      TIdent(mod_name) => parse_qualified_import_tail(tokens, bp + 2, path, mod_name),\\n      _ => throw(\\\"expected namespace name after 'as' in import\\\")\\n    },\\n    TIdent(alias_name) => if String::length(alias_name) > 1 && String::char_code_at(alias_name, 0) == '@' {\\n      let alias_str = String::substring(alias_name, 1, String::length(alias_name))\\n      (SAliasDecl(alias_str, path), bp + 1)\\n    } else {\\n      let br = expect_tk(tokens, bp, \\\"{\\\")\\n      let (items, end) = parse_import_items(tokens, br);\\n      (SImport(path, items), end)\\n    },\\n    _ => {\\n      let br = expect_tk(tokens, bp, \\\"{\\\")\\n      let (items, end) = parse_import_items(tokens, br);\\n      (SImport(path, items), end)\\n    }\\n  }\\n}\\n\\nfn parse_import_stmt(tokens: Array[Token], pos: Int) -> (Stmt, Int) with { Error } {\\n  match peek(tokens, pos) {\\n    TIdent(name) => if String::length(name) > 1 && String::char_code_at(name, 0) == '@' {\\n      parse_import_path_tail(tokens, pos + 1, name)\\n    } else {\\n      let (path, bp) = collect_import_path(tokens, pos, \\\"\\\")\\n      parse_import_path_tail(tokens, bp, path)\\n    },\\n    _ => {\\n      let (path, bp) = collect_import_path(tokens, pos, \\\"\\\")\\n      parse_import_path_tail(tokens, bp, path)\\n    }\\n  }\\n}\\n\\nfn tl_push_mut_name(mb: ArrayBuilder[String], field: (String, TypeExpr), is_mut: Bool) -> Unit {\\n  if is_mut {\\n    let (fname, _) = field\\n    ArrayBuilder::push(mb, fname)\\n  } else {\\n    ()\\n  }\\n}\\n\\nfn parse_toplevel_struct_fields_rest(tokens: Array[Token], pos: Int, b: ArrayBuilder[(String, TypeExpr)], mb: ArrayBuilder[String]) -> (Array[(String, TypeExpr)], Array[String], Int) with { Error } {\\n  match peek(tokens, pos) {\\n    TSemicolon => match peek(tokens, pos + 1) {\\n      TRBrace => (ArrayBuilder::freeze(b), ArrayBuilder::freeze(mb), pos + 2),\\n      _ => {\\n        let (field, is_mut, next) = parse_struct_field(tokens, pos + 1)\\n        ArrayBuilder::push(b, field)\\n        tl_push_mut_name(mb, field, is_mut)\\n        parse_toplevel_struct_fields_rest(tokens, next, b, mb)\\n      }\\n    },\\n    // 0.3.0 redundant-syntax removal: ',' is no longer a declaration-body\\n    // separator (see parser_base.vibe parse_enum_ctors_rest).\\n    TComma => throw(\\\"use ';' to separate declaration members; ',' was removed in 0.3.0 at #\\\\{pos}\\\"),\\n    TRBrace => (ArrayBuilder::freeze(b), ArrayBuilder::freeze(mb), pos + 1),\\n    _ => throw(\\\"expected ';' or '}' in struct at #\\\\{pos}\\\")\\n  }\\n}\\n\\nfn parse_toplevel_struct_fields(tokens: Array[Token], pos: Int) -> (Array[(String, TypeExpr)], Array[String], Int) with { Error } {\\n  match peek(tokens, pos) {\\n    TRBrace => (empty_fields(), Array::slice([\\n      \\\"\\\"\\n    ], 0, 0), pos + 1),\\n    _ => {\\n      let (first, is_mut, next) = parse_struct_field(tokens, pos)\\n      let b = ArrayBuilder::new()\\n      let mb = ArrayBuilder::new()\\n      ArrayBuilder::push(b, first)\\n      tl_push_mut_name(mb, first, is_mut)\\n      parse_toplevel_struct_fields_rest(tokens, next, b, mb)\\n    }\\n  }\\n}\\n\\nfn parse_toplevel_struct_stmt(tokens: Array[Token], pos: Int, exported: Bool) -> (Stmt, Int) with { Error } {\\n  match peek(tokens, pos) {\\n    TIdent(name) => {\\n      // Optional type-parameter header `struct Foo[T] { ... }`. #829: the\\n      // param NAMES are kept on the SStruct (they used to be discarded) so\\n      // the checker can instantiate generic struct literals; representation\\n      // stays uniform/tagged like enum type params.\\n      let (tparams, after_name) = parse_tparam_names(tokens, pos + 1)\\n      let br = expect_tk(tokens, after_name, \\\"{\\\")\\n      let (fields, mut_names, end) = parse_toplevel_struct_fields(tokens, br);\\n      let (derives, final_pos) = parse_derive_names(tokens, end)\\n      (SStruct(exported, name, fields, derives, mut_names, tparams), final_pos)\\n    },\\n    _ => throw(\\\"expected struct name\\\")\\n  }\\n}\\n\\nfn parse_export_stmt(tokens: Array[Token], starts: Array[Int], pos: Int) -> (Stmt, Int) with { Error } {\\n  match peek(tokens, pos) {\\n    TLet => parse_let_stmt(tokens, starts, pos + 1, true),\\n    TEnum => parse_enum_stmt(tokens, pos + 1, true),\\n    TSuberror => parse_suberror_stmt(tokens, pos + 1, true),\\n    TStruct => parse_toplevel_struct_stmt(tokens, pos + 1, true),\\n    TIdent(ident_name) => if ident_name == \\\"effect\\\" {\\n      parse_effect_stmt(tokens, pos + 1, true)\\n    } else if ident_name == \\\"fn\\\" {\\n      parse_fn_stmt(tokens, starts, pos + 1, true)\\n    } else {\\n      throw(String::concat(\\\"unexpected token in export: \\\", ident_name))\\n    },\\n    TType => parse_type_alias_stmt(tokens, pos + 1, true),\\n    TTrait => parse_trait_stmt(tokens, pos + 1, true),\\n    TOpen => match peek(tokens, pos + 1) {\\n      TTrait => parse_trait_stmt(tokens, pos + 2, true),\\n      _ => throw(\\\"expected 'trait' after 'open'\\\")\\n    },\\n    TLBrace => match peek(tokens, pos + 1) {\\n      TRBrace => (SExport(empty_names()), pos + 2),\\n      TIdent(_) => {\\n        let (first, after) = parse_export_name(tokens, pos + 1)\\n        let b = ArrayBuilder::new()\\n        ArrayBuilder::push(b, first)\\n        let (names, end) = parse_export_names_rest(tokens, after, b);\\n        (SExport(names), end)\\n      },\\n      _ => throw(\\\"expected name in export list\\\")\\n    },\\n    TDot => {\\n      let (path, bp) = collect_import_path(tokens, pos, \\\"\\\")\\n      let br = expect_tk(tokens, bp, \\\"{\\\")\\n      let (items, end) = parse_import_items(tokens, br);\\n      (SReExport(path, items), end)\\n    },\\n    // #769: `export ../foo/index.vibe { .. }` (a re-export that climbs OUT of\\n    // the current directory, as used by entry/compiler/index.vibe) is exactly\\n    // as valid an import-path start as `export ./foo { .. }` — only the\\n    // single-dot case was wired up here, so a leading `..` fell through to\\n    // the catch-all \\\"unexpected after 'export'\\\" error.\\n    TDotDot => {\\n      let (path, bp) = collect_import_path(tokens, pos, \\\"\\\")\\n      let br = expect_tk(tokens, bp, \\\"{\\\")\\n      let (items, end) = parse_import_items(tokens, br);\\n      (SReExport(path, items), end)\\n    },\\n    _ => {\\n      let actual = tk_name(peek(tokens, pos))\\n      throw(\\\"unexpected after 'export': \\\\{actual}\\\")\\n    }\\n  }\\n}\\n\\nfn parse_percent_symbol_name(tokens: Array[Token], pos: Int, label: String) -> (String, Int) with { Error } {\\n  let pp = expect_tk(tokens, pos, \\\"%\\\")\\n  match peek(tokens, pp) {\\n    TIdent(name) => (\\\"%\\\\{name}\\\", pp + 1),\\n    _ => throw(\\\"expected \\\\{label} after '%'\\\")\\n  }\\n}\\n\\nfn parse_extern_let_stmt(tokens: Array[Token], pos: Int) -> (Stmt, Int) with { Error } {\\n  let lp = expect_tk(tokens, pos, \\\"let\\\")\\n  let (name, np) = parse_percent_symbol_name(tokens, lp, \\\"extern symbol name\\\")\\n  let cp = expect_tk(tokens, np, \\\":\\\")\\n  let (ty, end) = parse_type(tokens, cp);\\n  (SExternLet(name, ty), end)\\n}\\n\\n// Statement parser that KEEPS `fn` declarations in declaration form\\n// (SFnDecl, contracts un-desugared) — the input to printer/normalize\\n// round-tripping (ADR-0064 #727). Everything that feeds the checker or\\n// codegen should use `parse_stmt` / `parse_program*` below, which lower\\n// SFnDecl to the legacy SLet shape.\\nexport fn parse_stmt_preserving(tokens: Array[Token], starts: Array[Int], pos: Int) -> (Stmt, Int) with { Error } {\\n  let head = peek(tokens, pos)\\n  match head {\\n    TLet => parse_let_stmt(tokens, starts, pos + 1, false),\\n    TExport => match peek(tokens, pos + 1) {\\n      // ADR-0063 Phase B (#728): module blocks are removed.\\n      TModule => throw(\\\"'module' blocks are removed (#728); use file boundaries + import/export\\\"),\\n      _ => parse_export_stmt(tokens, starts, pos + 1)\\n    },\\n    TModule => throw(\\\"'module' blocks are removed (#728); use file boundaries + import/export\\\"),\\n    TEnum => parse_enum_stmt(tokens, pos + 1, false),\\n    TSuberror => parse_suberror_stmt(tokens, pos + 1, false),\\n    TStruct => parse_toplevel_struct_stmt(tokens, pos + 1, false),\\n    TType => parse_type_alias_stmt(tokens, pos + 1, false),\\n    TTrait => parse_trait_stmt(tokens, pos + 1, false),\\n    TTest => parse_test_stmt(tokens, starts, pos + 1),\\n    TBench => parse_bench_stmt(tokens, starts, pos + 1),\\n    TImport => parse_import_stmt(tokens, pos + 1),\\n    TIdent(name) => match name {\\n      \\\"effect\\\" => parse_effect_stmt(tokens, pos + 1, false),\\n      \\\"extern\\\" => parse_extern_let_stmt(tokens, pos + 1),\\n      \\\"fn\\\" => parse_fn_stmt(tokens, starts, pos + 1, false),\\n      \\\"use\\\" => throw(\\\"'use' syntax is removed; use 'import <module-ref> { ... }'\\\"),\\n      _ => {\\n      let (e, next) = parse_impl(tokens, starts, pos, 0)\\n      match peek(tokens, next) {\\n        TEq => match e {\\n          EIdent(name, _) => {\\n            let (val, vn) = parse_impl(tokens, starts, next + 1, 0)\\n            (SExpr(EAssign(name, val, EUnit)), vn)\\n          },\\n          ECall(idx_callee, idx_args, _) => {\\n            // `arr[i] = v` at statement level: `__index(arr, i)` receiver\\n            // desugars to Array::set (same as the block-expr TEq arm).\\n            let is_index = match idx_callee {\\n              EIdent(icn, _) => icn == \\\"__index\\\",\\n              _ => false\\n            }\\n            if is_index && Array::length(idx_args) == 2 {\\n              let (val, vn) = parse_impl(tokens, starts, next + 1, 0)\\n              let set_args = Array::slice([\\n                EUnit\\n              ], 0, 0)\\n              Array::push(set_args, Array::get(idx_args, 0))\\n              Array::push(set_args, Array::get(idx_args, 1))\\n              Array::push(set_args, val)\\n              (SExpr(ECall(EIdent(\\\"Array::set\\\", -1), set_args, -1)), vn)\\n            } else {\\n              (SExpr(e), next)\\n            }\\n          },\\n          _ => (SExpr(e), next)\\n        },\\n        TPlusEq => match e {\\n          EIdent(name, _) => {\\n            let (val, vn) = parse_impl(tokens, starts, next + 1, 0)\\n            (SExpr(EAssignOp(name, \\\"+\\\", val, EUnit)), vn)\\n          },\\n          _ => (SExpr(e), next)\\n        },\\n        TMinusEq => match e {\\n          EIdent(name, _) => {\\n            let (val, vn) = parse_impl(tokens, starts, next + 1, 0)\\n            (SExpr(EAssignOp(name, \\\"-\\\", val, EUnit)), vn)\\n          },\\n          _ => (SExpr(e), next)\\n        },\\n        TStarEq => match e {\\n          EIdent(name, _) => {\\n            let (val, vn) = parse_impl(tokens, starts, next + 1, 0)\\n            (SExpr(EAssignOp(name, \\\"*\\\", val, EUnit)), vn)\\n          },\\n          _ => (SExpr(e), next)\\n        },\\n        TSlashEq => match e {\\n          EIdent(name, _) => {\\n            let (val, vn) = parse_impl(tokens, starts, next + 1, 0)\\n            (SExpr(EAssignOp(name, \\\"/\\\", val, EUnit)), vn)\\n          },\\n          _ => (SExpr(e), next)\\n        },\\n        _ => (SExpr(e), next)\\n      }\\n      }\\n    },\\n    _ => {\\n      let (e, next) = parse_impl(tokens, starts, pos, 0);\\n      (SExpr(e), next)\\n    }\\n  }\\n}\\n\\n// Default statement entry: identical to parse_stmt_preserving except that a\\n// `fn` declaration is lowered to the legacy `SLet(exported, true, name,\\n// None, EFn(..))` shape with its where-contract desugared to runtime\\n// asserts — i.e. exactly what this function returned before #727 kept the\\n// declaration form. All existing consumers (checker, codegen, symbols,\\n// contract engine, ...) keep seeing the pre-#727 AST.\\nexport fn parse_stmt(tokens: Array[Token], starts: Array[Int], pos: Int) -> (Stmt, Int) with { Error } {\\n  let (stmt, next) = parse_stmt_preserving(tokens, starts, pos)\\n  (lower_fn_decl_stmt(stmt), next)\\n}\\n\\n// Expand an impl body `{ method(params) -> ret { body } ... }` into the impl\\n// marker plus one `let Type::method = (params) -> ret { body }` per method\\n// (#641 Phase 1: concrete-receiver dispatch). Trait stays marker-only; the\\n// methods become ordinary qualified free functions resolved by name. `pos` is\\n// at the body `{` (or the next token for a body-less impl). Needs `parse_expr`,\\n// which is why this lives here rather than in parser_base.\\nfn parse_impl_methods(tokens: Array[Token], pos: Int, simpl: Stmt) -> (Array[Stmt], Int) with { Error } {\\n  let out = ArrayBuilder::new()\\n  ArrayBuilder::push(out, simpl)\\n  match peek(tokens, pos) {\\n    TLBrace => {\\n      let type_name = match simpl {\\n        SImpl(_, _, _, tn) => tn,\\n        _ => \\\"\\\"\\n      }\\n      // A generic impl `impl [T: Bound] Trait for C { method(self){..} }` binds\\n      // `T` (and its bound) over each method body, so inject the impl's type\\n      // parameters + bounds into every method's `EFn`. This lets the body\\n      // dispatch `T::m(elem)` (resolved via the threaded witness dict, #5\\n      // Increment B). Non-generic impls have an empty list → methods unchanged.\\n      let impl_tparams = match simpl {\\n        SImpl(tp, _, _, _) => tp,\\n        _ => Array::slice([\\n          \\\"\\\"\\n        ], 0, 0)\\n      }\\n      let impl_tbounds = match simpl {\\n        SImpl(_, tb, _, _) => tb,\\n        _ => Array::slice([\\n          (\\\"\\\", Array::slice([\\n            \\\"\\\"\\n          ], 0, 0))\\n        ], 0, 0)\\n      }\\n      let mut p = pos + 1\\n      let mut done = false\\n      while !done {\\n        match peek(tokens, p) {\\n          TRBrace => {\\n            p = p + 1\\n            done = true\\n          },\\n          TIdent(mname) => {\\n            let (efn, p2) = parse_expr(tokens, p + 1)\\n            let efn2 = if Array::length(impl_tparams) > 0 {\\n              match efn {\\n                EFn(mtp, mtb, mparams, mret, meff, mbody) => EFn(Array::concat(impl_tparams, mtp), Array::concat(impl_tbounds, mtb), mparams, mret, meff, mbody),\\n                _ => efn\\n              }\\n            } else {\\n              efn\\n            }\\n            let qname = String::concat(type_name, String::concat(\\\"::\\\", mname))\\n            ArrayBuilder::push(out, SLet(false, true, qname, None, efn2))\\n            p = match peek(tokens, p2) {\\n              TSemicolon => p2 + 1,\\n              _ => p2\\n            }\\n          },\\n          _ => throw(\\\"expected impl method name or '}'\\\")\\n        }\\n      }\\n      (ArrayBuilder::freeze(out), p)\\n    },\\n    _ => (ArrayBuilder::freeze(out), pos)\\n  }\\n}\\n\\n// Compile-time conditional compilation (#cfg). A top-level statement may be\\n// prefixed with `#cfg(flag)`; the statement is KEPT only when `flag` is\\n// active, and otherwise parsed (syntax must stay valid, like Rust's cfg) and\\n// DISCARDED before checking/codegen -- so disabled debug code adds zero bytes\\n// to the output. Flags are activated by `#cfg_enable(flag)` directives, which\\n// the CLI appends to the source when `VIBE_CFG=flag1,flag2` is set (appending\\n// at the END keeps every source offset -- and thus diagnostics -- unchanged).\\n// A pre-scan collects the active set so `#cfg_enable` position is irrelevant.\\n//\\n// NOTE: `#cfg` must not be used in the compiler's own source until the seed\\n// compiler understands it (docs/selfhost-bootstrap.md bump procedure).\\n\\n// Parse the directive after a THash: `cfg(name)` or `cfg_enable(name)`.\\n// Returns (directive_kind, flag_name, next_pos).\\nfn parse_cfg_directive(tokens: Array[Token], pos: Int) -> (String, String, Int) with { Error } {\\n  match peek(tokens, pos) {\\n    TIdent(dname) => {\\n      if dname == \\\"cfg\\\" || dname == \\\"cfg_enable\\\" {\\n        match peek(tokens, pos + 1) {\\n          TLParen => match peek(tokens, pos + 2) {\\n            TIdent(flag) => match peek(tokens, pos + 3) {\\n              TRParen => (dname, flag, pos + 4),\\n              _ => throw(\\\"expected ')' after #cfg flag name\\\")\\n            },\\n            _ => throw(\\\"expected flag name in #cfg(...)\\\")\\n          },\\n          _ => throw(\\\"expected '(' after #cfg\\\")\\n        }\\n      } else {\\n        throw(String::concat(\\\"unknown # directive: \\\", dname))\\n      }\\n    },\\n    _ => throw(\\\"expected directive name after '#'\\\")\\n  }\\n}\\n\\n// Pre-scan the whole token stream for `#cfg_enable(name)` directives and\\n// return the active flag set. O(tokens), no allocation unless a THash exists.\\nfn cfg_scan_enabled(tokens: Array[Token]) -> Array[String] with { Error } {\\n  let out = Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n  let mut i = 0\\n  let n = Array::length(tokens)\\n  while i < n {\\n    match Array::get(tokens, i) {\\n      THash => {\\n        let (dname, flag, next) = parse_cfg_directive(tokens, i + 1)\\n        if dname == \\\"cfg_enable\\\" {\\n          Array::push(out, flag)\\n        } else {\\n          ()\\n        }\\n        i = next\\n      },\\n      _ => {\\n        i = i + 1\\n      }\\n    }\\n  }\\n  out\\n}\\n\\nfn cfg_flag_active(active: Array[String], flag: String) -> Bool {\\n  let mut i = 0\\n  let mut found = false\\n  while i < Array::length(active) {\\n    if Array::get(active, i) == flag {\\n      found = true\\n    } else {\\n      ()\\n    }\\n    i = i + 1\\n  }\\n  found\\n}\\n\\n// Program parser that KEEPS `fn` declarations as SFnDecl (see\\n// parse_stmt_preserving) — used by the printer/normalize round-trip so\\n// `vibe normalize` re-emits `fn name(..) -> T where { .. } { .. }` instead\\n// of rewriting it to `let rec` form (ADR-0064 #727).\\nexport fn parse_program_preserving(tokens: Array[Token]) -> Array[Stmt] with { Error } {\\n  let cfg_active = cfg_scan_enabled(tokens)\\n  let b = ArrayBuilder::new()\\n  let mut pos = 0\\n  let mut done = false\\n  while !done {\\n    match peek(tokens, pos) {\\n      TEof => {\\n        done = true\\n      },\\n      TSemicolon => {\\n        pos = pos + 1\\n      },\\n      THash => {\\n        let (dname, flag, dnext) = parse_cfg_directive(tokens, pos + 1)\\n        if dname == \\\"cfg_enable\\\" || cfg_flag_active(cfg_active, flag) {\\n          // enable directive consumed, or active #cfg: keep the next stmt.\\n          pos = dnext\\n        } else {\\n          // Inactive #cfg: parse the guarded statement and discard it.\\n          match peek(tokens, dnext) {\\n            TImpl => {\\n              let (simpl_d, hp_d) = parse_impl_stmt_dispatch(tokens, dnext + 1)\\n              let (_dropped, dn) = parse_impl_methods(tokens, hp_d, simpl_d)\\n              pos = dn\\n            },\\n            _ => {\\n              let (_dropped, dn) = parse_stmt_preserving(tokens, [], dnext)\\n              pos = dn\\n            }\\n          }\\n        }\\n      },\\n      TImpl => {\\n        let (simpl, hp) = parse_impl_stmt_dispatch(tokens, pos + 1)\\n        let (impl_stmts, next) = parse_impl_methods(tokens, hp, simpl)\\n        let mut ii = 0\\n        while ii < Array::length(impl_stmts) {\\n          ArrayBuilder::push(b, Array::get(impl_stmts, ii))\\n          ii = ii + 1\\n        }\\n        pos = next\\n      },\\n      _ => {\\n        let (stmt, next) = parse_stmt_preserving(tokens, [], pos)\\n        ArrayBuilder::push(b, stmt)\\n        pos = next\\n      }\\n    }\\n  }\\n  ArrayBuilder::freeze(b)\\n}\\n\\n// Default program entry: `fn` declarations lowered to the legacy SLet shape\\n// (where-contracts desugared to runtime asserts) — the exact pre-#727\\n// output, so every checker/codegen consumer is unchanged.\\nexport fn parse_program(tokens: Array[Token]) -> Array[Stmt] with { Error } {\\n  lower_fn_decl_stmts(parse_program_preserving(tokens))\\n}\\n\\n// Like parse_program but, on a syntax error, prefixes the message with the\\n// failing statement's `line:col` (from `lex_with_offsets` token start offsets).\\n// Per-statement wrapping keeps the change local. Build the prefix with\\n// String::concat (not `+` or interpolation) to avoid selfhost string-concat\\n// NUL fragility. Source-span foundation: located parse diagnostics.\\n// #816: in-body parse errors carry the failing TOKEN index as \\\"at #N\\\"\\n// (expect_tk and the primary-dispatch \\\"unexpected token\\\" throw). Decode it so\\n// the located wrapper anchors the diagnostic at the OFFENDING token instead\\n// of the enclosing statement's start (an error on line 6 used to report\\n// \\\"line 2:1\\\"), and strip the index + the lexer-internal \\\"(prev=..., next=...)\\\"\\n// debris from the user-facing message.\\nfn extract_err_token_pos(msg: String, fallback_pos: Int) -> (Int, String) {\\n  let mi = String::index_of(msg, \\\" at #\\\")\\n  if mi < 0 {\\n    (fallback_pos, msg)\\n  } else {\\n    let mlen = String::length(msg)\\n    let mut di = mi + 5\\n    let mut n = 0\\n    let mut any = false\\n    let mut scanning = true\\n    while scanning {\\n      if di < mlen {\\n        let ch = String::char_code_at(msg, di)\\n        if ch >= 48 && ch <= 57 {\\n          n = n * 10 + (ch - 48)\\n          any = true\\n          di = di + 1\\n        } else {\\n          scanning = false\\n        }\\n      } else {\\n        scanning = false\\n      }\\n    }\\n    if !any {\\n      (fallback_pos, msg)\\n    } else {\\n      let head = String::substring(msg, 0, mi)\\n      let tail = String::substring(msg, di, mlen)\\n      let joined = String::concat(head, tail)\\n      let pi = String::index_of(joined, \\\" (prev=\\\")\\n      let cleaned = if pi >= 0 {\\n        String::substring(joined, 0, pi)\\n      } else {\\n        joined\\n      }\\n      (n, cleaned)\\n    }\\n  }\\n}\\n\\nexport fn parse_program_located(tokens: Array[Token], starts: Array[Int], source: String) -> Array[Stmt] with { Error } {\\n  let cfg_active = cfg_scan_enabled(tokens)\\n  let b = ArrayBuilder::new()\\n  let mut pos = 0\\n  let mut done = false\\n  while !done {\\n    match peek(tokens, pos) {\\n      TEof => {\\n        done = true\\n      },\\n      TSemicolon => {\\n        pos = pos + 1\\n      },\\n      THash => {\\n        let (dname, flag, dnext) = parse_cfg_directive(tokens, pos + 1)\\n        if dname == \\\"cfg_enable\\\" || cfg_flag_active(cfg_active, flag) {\\n          pos = dnext\\n        } else {\\n          match peek(tokens, dnext) {\\n            TImpl => {\\n              let (simpl_d, hp_d) = parse_impl_stmt_dispatch(tokens, dnext + 1)\\n              let (_dropped, dn) = parse_impl_methods(tokens, hp_d, simpl_d)\\n              pos = dn\\n            },\\n            _ => {\\n              let (_dropped, dn) = parse_stmt(tokens, starts, dnext)\\n              pos = dn\\n            }\\n          }\\n        }\\n      },\\n      _ => {\\n        let start_pos = pos\\n        let (stmts, next) = handle {\\n          match peek(tokens, pos) {\\n            TImpl => {\\n              let (simpl, hp) = parse_impl_stmt_dispatch(tokens, pos + 1)\\n              parse_impl_methods(tokens, hp, simpl)\\n            },\\n            _ => {\\n              let (stmt, n) = parse_stmt(tokens, starts, pos)\\n              ([\\n                stmt\\n              ], n)\\n            }\\n          }\\n        } with Error {\\n          Throw(msg) => {\\n            let (err_pos, cleaned_msg) = extract_err_token_pos(msg, start_pos)\\n            let anchor_pos = if err_pos < Array::length(starts) {\\n              err_pos\\n            } else {\\n              start_pos\\n            }\\n            let off = if anchor_pos < Array::length(starts) {\\n              Array::get(starts, anchor_pos)\\n            } else {\\n              0\\n            }\\n            let (line, col) = offset_to_line_col(source, off)\\n            let loc = String::concat(\\\"line \\\", String::concat(__to_string(line), String::concat(\\\":\\\", String::concat(__to_string(col), \\\": \\\"))))\\n            throw(String::concat(loc, cleaned_msg))\\n          }\\n        }\\n        let mut ii = 0\\n        while ii < Array::length(stmts) {\\n          ArrayBuilder::push(b, Array::get(stmts, ii))\\n          ii = ii + 1\\n        }\\n        pos = next\\n      }\\n    }\\n  }\\n  ArrayBuilder::freeze(b)\\n}\\n\\n// True when `t` is a resynchronization point for `parse_program_recovering`:\\n// it begins a top-level statement, OR is a statement separator (TSemicolon),\\n// OR ends input (TEof). Folding TSemicolon/TEof in here lets the resync loop\\n// use a single `if is_recovery_point(...)` test instead of a mixed\\n// constructor/catch-all `match` (the latter traps the seed codegen on this\\n// shape — keep this a flat function returning Bool).\\nfn is_recovery_point(t: Token) -> Bool {\\n  match t {\\n    TLet => true,\\n    TExport => true,\\n    TModule => true,\\n    TEnum => true,\\n    TSuberror => true,\\n    TStruct => true,\\n    TType => true,\\n    TTrait => true,\\n    TTest => true,\\n    TBench => true,\\n    TImport => true,\\n    TImpl => true,\\n    TDeclare => true,\\n    TOpen => true,\\n    TSemicolon => true,\\n    TEof => true,\\n    _ => false\\n  }\\n}\\n\\n// Like `parse_program_located`, but NEVER rethrows. On a per-statement syntax\\n// error it records the located (`line:col`) message into a diagnostics array,\\n// then resynchronizes by advancing `pos` to the next top-level statement start\\n// (or TSemicolon / TEof). At least one token is always consumed to guarantee\\n// progress. Returns the partial AST plus all collected diagnostics. Build all\\n// strings with String::concat (not `+`/interpolation) to avoid selfhost\\n// string-concat NUL fragility. Foundation: collect-all parse diagnostics (LSP).\\nexport fn parse_program_recovering(tokens: Array[Token], starts: Array[Int], source: String) -> (Array[Stmt], Array[String]) with { Error } {\\n  let cfg_active = handle {\\n    cfg_scan_enabled(tokens)\\n  } with Error {\\n    Throw(_) => Array::slice([\\n      \\\"\\\"\\n    ], 0, 0)\\n  }\\n  let b = ArrayBuilder::new()\\n  let diags = ArrayBuilder::new()\\n  let n = Array::length(tokens)\\n  let mut pos = 0\\n  let mut done = false\\n  while !done {\\n    match peek(tokens, pos) {\\n      TEof => {\\n        done = true\\n      },\\n      TSemicolon => {\\n        pos = pos + 1\\n      },\\n      THash => {\\n        // #cfg directive: on any malformed directive fall through to the\\n        // recovery machinery below by treating it like a failed statement.\\n        let cfg_res = handle {\\n          let (dname, flag, dnext) = parse_cfg_directive(tokens, pos + 1)\\n          if dname == \\\"cfg_enable\\\" || cfg_flag_active(cfg_active, flag) {\\n            dnext\\n          } else {\\n            match peek(tokens, dnext) {\\n              TImpl => {\\n                let (simpl_d, hp_d) = parse_impl_stmt_dispatch(tokens, dnext + 1)\\n                let (_dropped, dn) = parse_impl_methods(tokens, hp_d, simpl_d)\\n                dn\\n              },\\n              _ => {\\n                let (_dropped, dn) = parse_stmt(tokens, starts, dnext)\\n                dn\\n              }\\n            }\\n          }\\n        } with Error {\\n          Throw(_) => 0 - 1\\n        }\\n        if cfg_res >= 0 {\\n          pos = cfg_res\\n        } else {\\n          // resync: skip to the next recovery point (mirrors the stmt path).\\n          let mut rp = pos + 1\\n          while rp < n && !is_recovery_point(Array::get(tokens, rp)) {\\n            rp = rp + 1\\n          }\\n          pos = rp\\n        }\\n      },\\n      _ => {\\n        let start_pos = pos\\n        let res = handle {\\n          let (stmts, next) = match peek(tokens, pos) {\\n            TImpl => {\\n              let (simpl, hp) = parse_impl_stmt_dispatch(tokens, pos + 1)\\n              parse_impl_methods(tokens, hp, simpl)\\n            },\\n            _ => {\\n              let (stmt, n) = parse_stmt(tokens, starts, pos)\\n              ([\\n                stmt\\n              ], n)\\n            }\\n          }\\n          Some((stmts, next))\\n        } with Error {\\n          Throw(msg) => {\\n            let (err_pos, cleaned_msg) = extract_err_token_pos(msg, start_pos)\\n            let anchor_pos = if err_pos >= start_pos && err_pos < Array::length(starts) {\\n              err_pos\\n            } else {\\n              start_pos\\n            }\\n            let off = if anchor_pos < Array::length(starts) {\\n              Array::get(starts, anchor_pos)\\n            } else {\\n              0\\n            }\\n            let (line, col) = offset_to_line_col(source, off)\\n            let loc = String::concat(\\\"line \\\", String::concat(__to_string(line), String::concat(\\\":\\\", String::concat(__to_string(col), \\\": \\\"))))\\n            ArrayBuilder::push(diags, String::concat(loc, cleaned_msg))\\n            // #946: resynchronize from the ERROR ANCHOR, not the statement\\n            // start. Every token before the anchor was already consumed as\\n            // part of this failed statement, so restarting the parse at each\\n            // intervening recovery-point-looking token (e.g. the TLet inside\\n            // a failed `export let ...`) re-reported the SAME error 4-5x with\\n            // stray positions. Skip at least one token (progress guarantee),\\n            // then advance to the next recovery point (top-level statement\\n            // start, TSemicolon, or TEof — see is_recovery_point) and hand\\n            // the position back through the normal Some path (zero stmts).\\n            // #963: if the anchor token IS itself a recovery point (the\\n            // failed statement ran into the start of the NEXT top-level\\n            // statement, e.g. `export let a =` followed by `test ...`),\\n            // resume AT the anchor so that statement is parsed, not skipped.\\n            // Progress stays guaranteed: this branch is only taken when\\n            // anchor_pos > start_pos (the clamp above enforces\\n            // anchor_pos >= start_pos), and the anchor+1 path always\\n            // consumes at least one token.\\n            let resync_pos = if anchor_pos > start_pos && is_recovery_point(peek(tokens, anchor_pos)) {\\n              anchor_pos\\n            } else {\\n              let mut rp = anchor_pos + 1\\n              let mut sync = false\\n              while !sync {\\n                if rp >= n {\\n                  sync = true\\n                } else {\\n                  let t = peek(tokens, rp)\\n                  if is_recovery_point(t) {\\n                    sync = true\\n                  } else {\\n                    rp = rp + 1\\n                  }\\n                }\\n              }\\n              rp\\n            }\\n            Some((Array::slice([\\n              SExport(empty_names())\\n            ], 0, 0), resync_pos))\\n          }\\n        }\\n        match res {\\n          Some((stmts, next)) => {\\n            let mut ii = 0\\n            while ii < Array::length(stmts) {\\n              ArrayBuilder::push(b, Array::get(stmts, ii))\\n              ii = ii + 1\\n            }\\n            pos = next\\n          },\\n          None => {\\n            // Unreachable: the Throw handler above always returns Some with\\n            // an empty statement list and the resync position. Kept only for\\n            // match exhaustiveness; consume one token if ever reached.\\n            pos = start_pos + 1\\n          }\\n        }\\n      }\\n    }\\n  }\\n  (ArrayBuilder::freeze(b), ArrayBuilder::freeze(diags))\\n}\\n\\n// Like `parse_program`, but also returns per top-level statement its source\\n// byte span (start, end), derived from the token offset arrays produced by\\n// `lex_with_offsets`. start = first token's start offset; end = last token's\\n// end offset. The three returned arrays are parallel (one entry per stmt).\\nexport fn parse_program_spans(tokens: Array[Token], starts: Array[Int], ends: Array[Int]) -> (Array[Stmt], Array[Int], Array[Int]) with { Error } {\\n  let b = ArrayBuilder::new()\\n  let span_start = ArrayBuilder::new()\\n  let span_end = ArrayBuilder::new()\\n  let mut pos = 0\\n  let mut done = false\\n  while !done {\\n    match peek(tokens, pos) {\\n      TEof => {\\n        done = true\\n      },\\n      TSemicolon => {\\n        pos = pos + 1\\n      },\\n      THash => {\\n        // Module-source (flat source) emission re-emits statement spans; a\\n        // #cfg directive sits OUTSIDE its statement's span, so passing it\\n        // through would silently change semantics between the original and\\n        // the re-emitted source. Refuse loudly instead (the compiler's own\\n        // source must not use #cfg until the seed understands it).\\n        throw(\\\"#cfg directives are not supported in module-source emission\\\")\\n      },\\n      TImpl => {\\n        let st = Array::get(starts, pos)\\n        let (simpl, hp) = parse_impl_stmt_dispatch(tokens, pos + 1)\\n        let next = skip_braced_body(tokens, hp)\\n        ArrayBuilder::push(b, simpl)\\n        ArrayBuilder::push(span_start, st)\\n        ArrayBuilder::push(span_end, Array::get(ends, next - 1))\\n        pos = next\\n      },\\n      _ => {\\n        let st = Array::get(starts, pos)\\n        let (stmt, next) = parse_stmt(tokens, starts, pos)\\n        ArrayBuilder::push(b, stmt)\\n        ArrayBuilder::push(span_start, st)\\n        ArrayBuilder::push(span_end, Array::get(ends, next - 1))\\n        pos = next\\n      }\\n    }\\n  }\\n  (ArrayBuilder::freeze(b), ArrayBuilder::freeze(span_start), ArrayBuilder::freeze(span_end))\\n}\\n\\n//# Misc\\n\\nexport {\\n  Pat, Expr, Stmt, TypeExpr, parse, parse_ok, parse_expr, parse_stmt, parse_stmt_preserving, parse_type, parse_program, parse_program_preserving\\n}\\n\\nexport {\\n  Pat, Expr, Stmt, parse, TypeExpr, parse_ok, parse_expr, parse_stmt, parse_stmt_preserving, parse_type, parse_program, parse_program_preserving\\n}\\n\")\n}\n\nlet cli_adapter_source_13 = () -> (String, String) {\n  (\"lib/@vibe/parser/expand_interp.vibe\",\n\"//# Imports\\n\\nimport ../ast {\\n  Expr, Pat, Stmt, TypeExpr\\n}\\n\\nimport ./lexer.vibe {\\n  lex\\n}\\n\\nimport ./parser_expr.vibe {\\n  parse\\n}\\n\\nimport ./token.vibe {\\n  Token\\n}\\n\\n//# Functions\\n\\nfn resolve_expr(e: Expr) -> Expr with { Error } {\\n  let desugar_parts: (Array[String]) -> Expr with { Error } = (parts) -> {\\n    let plen = Array::length(parts)\\n    let exprs = ArrayBuilder::new()\\n    let mut i = 0\\n    while i < plen {\\n      let lit = Array::get(parts, i)\\n      if String::length(lit) > 0 {\\n        ArrayBuilder::push(exprs, EString(lit))\\n      }\\n      if i + 1 < plen {\\n        let expr_src = Array::get(parts, i + 1)\\n        let expr_tokens = lex(expr_src)\\n        let parsed = parse(expr_tokens)\\n        let resolved = resolve_expr(parsed)\\n        ArrayBuilder::push(exprs, ECall(EIdent(\\\"__to_string\\\", -1), [\\n          resolved\\n        ], -1))\\n      }\\n      i = i + 2\\n    }\\n    let result_arr = ArrayBuilder::freeze(exprs)\\n    let result_len = Array::length(result_arr)\\n    if result_len == 0 {\\n      EString(\\\"\\\")\\n    } else {\\n      let mut result = Array::get(result_arr, 0)\\n      let mut j = 1\\n      while j < result_len {\\n        result = ECall(EIdent(\\\"String::concat\\\", -1), [\\n          result,\\n          Array::get(result_arr, j)\\n        ], -1)\\n        j = j + 1\\n      }\\n      result\\n    }\\n  }\\n  let resolve_arr: (Array[Expr]) -> Array[Expr] with { Error } = (exprs) -> {\\n    for ex in exprs {\\n      resolve_expr(ex)\\n    }\\n  }\\n  match e {\\n    EStringInterp(parts) => desugar_parts(parts),\\n    EInt(_) => e,\\n    EFloat(_) => e,\\n    EString(_) => e,\\n    EBool(_) => e,\\n    EUnit => e,\\n    EIdent(_, _) => e,\\n    ETuple(elems) => ETuple(resolve_arr(elems)),\\n    EArray(elems) => EArray(resolve_arr(elems)),\\n    ERecord(rn, fields, targs) => ERecord(rn, for f in fields {\\n      let (n, v) = f; (n, resolve_expr(v))\\n    }, targs),\\n    EMap(fields) => EMap(for f in fields {\\n      let (n, v) = f; (n, resolve_expr(v))\\n    }),\\n    EIf(c, t, el) => EIf(resolve_expr(c), resolve_expr(t), resolve_expr(el)),\\n    ELet(n, v, b, soff) => ELet(n, resolve_expr(v), resolve_expr(b), soff),\\n    ELetRec(n, v, b) => ELetRec(n, resolve_expr(v), resolve_expr(b)),\\n    ELetMut(n, v, b, soff) => ELetMut(n, resolve_expr(v), resolve_expr(b), soff),\\n    EAssign(n, v, b) => EAssign(n, resolve_expr(v), resolve_expr(b)),\\n    EAssignOp(n, op, v, b) => EAssignOp(n, op, resolve_expr(v), resolve_expr(b)),\\n    ESeq(a, b) => ESeq(resolve_expr(a), resolve_expr(b)),\\n    EMatch(s, arms) => EMatch(resolve_expr(s), for a in arms {\\n      let (p, ex) = a; (p, resolve_expr(ex))\\n    }),\\n    EHandle(body, arms) => EHandle(resolve_expr(body), for a in arms {\\n      let (p, ex) = a; (p, resolve_expr(ex))\\n    }),\\n    EWhile(c, b) => EWhile(resolve_expr(c), resolve_expr(b)),\\n    ELoop(params, body) => ELoop(for param in params {\\n      let (name, init) = param; (name, resolve_expr(init))\\n    }, resolve_expr(body)),\\n    EForIn(vn, idx, it, b) => EForIn(vn, idx, resolve_expr(it), resolve_expr(b)),\\n    ECall(callee, args, off) => ECall(resolve_expr(callee), resolve_arr(args), off),\\n    EBinOp(op, l, r) => EBinOp(op, resolve_expr(l), resolve_expr(r)),\\n    EUnaryOp(op, inner) => EUnaryOp(op, resolve_expr(inner)),\\n    EFn(a, b, params, ret, eff, body) => EFn(a, b, params, ret, eff, resolve_expr(body)),\\n    EDot(inner, field, off, fdoff) => EDot(resolve_expr(inner), field, off, fdoff),\\n    EReturn(inner) => EReturn(resolve_expr(inner)),\\n    EBreak(opt) => match opt {\\n      None => e,\\n      Some(v) => EBreak(Some(resolve_expr(v)))\\n    },\\n    EContinue(args) => EContinue(resolve_arr(args)),\\n    ELabeledArg(n, m, v) => ELabeledArg(n, m, resolve_expr(v)),\\n    ESpread(inner) => ESpread(resolve_expr(inner))\\n  }\\n}\\n\\nfn resolve_stmt(s: Stmt) -> Stmt with { Error } {\\n  match s {\\n    SLet(exp, is_rec, name, ty, val) => SLet(exp, is_rec, name, ty, resolve_expr(val)),\\n    SLetMut(name, ty, val) => SLetMut(name, ty, resolve_expr(val)),\\n    STest(name, body) => STest(name, resolve_expr(body)),\\n    SBench(name, body) => SBench(name, resolve_expr(body)),\\n    SExpr(e) => SExpr(resolve_expr(e)),\\n    _ => s\\n  }\\n}\\n\\nexport fn resolve_interp_expr(e: Expr) -> Expr with { Error } {\\n  resolve_expr(e)\\n}\\n\\nexport fn resolve_interp_stmts(stmts: Array[Stmt]) -> Array[Stmt] with { Error } {\\n  for s in stmts {\\n    resolve_stmt(s)\\n  }\\n}\\n\")\n}\n\nlet cli_adapter_source_14 = () -> (String, String) {\n  (\"lib/@vibe/parser/printer.vibe\",\n\"//# Imports\\n\\nimport ../ast {\\n  Expr, Pat, Stmt, TypeExpr\\n}\\n\\nimport ./polyfill.vibe {\\n  __to_string\\n}\\n\\nimport ./float_format.vibe {\\n  double_to_string_compiler\\n}\\n\\n//# Functions\\n\\nfn join(arr: Array[String], sep: String) -> String {\\n  let len = Array::length(arr)\\n  if len == 0 {\\n    \\\"\\\"\\n  } else {\\n    let b = ArrayBuilder::new()\\n    let mut i = 0\\n    while i < len {\\n      if i > 0 {\\n        ArrayBuilder::push(b, sep)\\n      }\\n      ArrayBuilder::push(b, Array::get(arr, i))\\n      i = i + 1\\n    }\\n    String::join(ArrayBuilder::freeze(b), \\\"\\\")\\n  }\\n}\\n\\n// #741: `r#loop`-style raw identifiers lex to a bare TIdent — the r# prefix\\n// is not kept in the AST — so a binding named after a keyword must be\\n// re-escaped on print or the emitted program fails to re-parse (the merge\\n// flatten hit \\\"expected identifier after 'let rec'\\\" on @vibe/core set.vibe's\\n// `let rec r#loop`). Mirror of the lexer's keyword table.\\nfn is_keyword_name(name: String) -> Bool {\\n  name == \\\"fn\\\" || name == \\\"if\\\" || name == \\\"in\\\" || name == \\\"is\\\" || name == \\\"do\\\" ||\\n  name == \\\"as\\\" || name == \\\"let\\\" || name == \\\"rec\\\" || name == \\\"mut\\\" || name == \\\"for\\\" ||\\n  name == \\\"else\\\" || name == \\\"enum\\\" || name == \\\"true\\\" || name == \\\"type\\\" || name == \\\"test\\\" ||\\n  name == \\\"with\\\" || name == \\\"loop\\\" || name == \\\"open\\\" || name == \\\"impl\\\" || name == \\\"false\\\" ||\\n  name == \\\"match\\\" || name == \\\"trait\\\" || name == \\\"throw\\\" || name == \\\"while\\\" || name == \\\"break\\\" ||\\n  name == \\\"bench\\\" || name == \\\"raise\\\" || name == \\\"yield\\\" || name == \\\"struct\\\" || name == \\\"export\\\" ||\\n  name == \\\"return\\\" || name == \\\"handle\\\" || name == \\\"module\\\" || name == \\\"derive\\\" || name == \\\"import\\\" ||\\n  name == \\\"declare\\\" || name == \\\"continue\\\" || name == \\\"suberror\\\"\\n}\\n\\nfn print_name(name: String) -> String {\\n  if is_keyword_name(name) {\\n    String::concat(\\\"r#\\\", name)\\n  } else name\\n}\\n\\nfn escape_string(s: String) -> String {\\n  let len = String::length(s)\\n  let b = ArrayBuilder::new()\\n  let push_chunk: (Int, Int) -> Unit = (start, end) -> {\\n    if end > start {\\n      ArrayBuilder::push(b, s[start: end])\\n    }\\n  }\\n  let mut i = 0\\n  let mut start = 0\\n  while i < len {\\n    let c = String::char_code_at(s, i)\\n    if c == '\\\"' {\\n      push_chunk(start, i)\\n      ArrayBuilder::push(b, \\\"\\\\\\\\\\\\\\\"\\\")\\n      i = i + 1\\n      start = i\\n    } else if c == '\\\\\\\\' {\\n      push_chunk(start, i)\\n      ArrayBuilder::push(b, \\\"\\\\\\\\\\\\\\\\\\\")\\n      i = i + 1\\n      start = i\\n    } else if c == '\\\\n' {\\n      push_chunk(start, i)\\n      ArrayBuilder::push(b, \\\"\\\\\\\\n\\\")\\n      i = i + 1\\n      start = i\\n    } else if c == '\\\\t' {\\n      push_chunk(start, i)\\n      ArrayBuilder::push(b, \\\"\\\\\\\\t\\\")\\n      i = i + 1\\n      start = i\\n    } else if c == 13 {\\n      push_chunk(start, i)\\n      ArrayBuilder::push(b, \\\"\\\\\\\\r\\\")\\n      i = i + 1\\n      start = i\\n    } else if c == 0 {\\n      push_chunk(start, i)\\n      ArrayBuilder::push(b, \\\"\\\\\\\\0\\\")\\n      i = i + 1\\n      start = i\\n    } else {\\n      i = i + 1\\n    }\\n  }\\n  push_chunk(start, len)\\n  String::join(ArrayBuilder::freeze(b), \\\"\\\")\\n}\\n\\nexport fn print_pat(p: Pat) -> String {\\n  match p {\\n    PWild => \\\"_\\\",\\n    PBind(name) => print_name(name),\\n    PInt(n) => __to_string(n),\\n    PFloat(v) => {\\n      // Same int-reparse guard as the EFloat printer arm below.\\n      let fs = double_to_string_compiler(v)\\n      if String::contains(fs, \\\".\\\") || fs == \\\"nan\\\" {\\n        fs\\n      } else {\\n        String::concat(fs, \\\".0\\\")\\n      }\\n    },\\n    PString(s) => String::concat(\\\"\\\\\\\"\\\", String::concat(escape_string(s), \\\"\\\\\\\"\\\")),\\n    PBool(b) => if b {\\n      \\\"true\\\"\\n    } else \\\"false\\\",\\n    PCtor(name, args) => if Array::length(args) == 0 {\\n      name\\n    } else {\\n      let parts = for arg in args {\\n        print_pat(arg)\\n      }\\n      String::concat(name, String::concat(\\\"(\\\", String::concat(join(parts, \\\", \\\"), \\\")\\\")))\\n    },\\n    PTuple(elems) => {\\n      let parts = for elem in elems {\\n        print_pat(elem)\\n      }\\n      String::concat(\\\"(\\\", String::concat(join(parts, \\\", \\\"), \\\")\\\"))\\n    },\\n    POr(left, right) => String::concat(print_pat(left), String::concat(\\\" | \\\", print_pat(right))),\\n    PStruct(name, _) => String::concat(name, \\\"::{...}\\\")\\n  }\\n}\\n\\nfn handle_effect_name_from_ctor(name: String) -> Option[String] {\\n  let idx = String::last_index_of(name, \\\"::\\\")\\n  if idx < 0 {\\n    None\\n  } else {\\n    Some(name[0: idx])\\n  }\\n}\\n\\nfn infer_handle_effect_name_from_pat(pat: Pat) -> Option[String] {\\n  match pat {\\n    PCtor(name, _) => handle_effect_name_from_ctor(name),\\n    POr(left, right) => match infer_handle_effect_name_from_pat(left) {\\n      Some(name) => Some(name),\\n      None => infer_handle_effect_name_from_pat(right)\\n    },\\n    _ => None\\n  }\\n}\\n\\nfn infer_handle_effect_name(arms: Array[(Pat, Expr)]) -> String {\\n  let mut i = 0\\n  let mut effect_name = \\\"Error\\\"\\n  let mut found = false\\n  while i < Array::length(arms) && !found {\\n    let (pat, _) = Array::get(arms, i)\\n    match infer_handle_effect_name_from_pat(pat) {\\n      Some(name) => {\\n        effect_name = name\\n        found = true\\n      },\\n      None => {\\n        i = i + 1\\n      }\\n    }\\n  }\\n  effect_name\\n}\\n\\nfn strip_handle_effect_ctor(effect_name: String, ctor_name: String) -> String {\\n  let prefix = String::concat(effect_name, \\\"::\\\")\\n  if String::starts_with(ctor_name, prefix) {\\n    let prefix_len = String::length(prefix)\\n    let ctor_len = String::length(ctor_name)\\n    ctor_name[prefix_len: ctor_len]\\n  } else {\\n    ctor_name\\n  }\\n}\\n\\nfn print_handle_pat(effect_name: String, pat: Pat) -> String {\\n  match pat {\\n    PCtor(name, args) => {\\n      let short_name = strip_handle_effect_ctor(effect_name, name)\\n      if Array::length(args) == 0 {\\n        short_name\\n      } else {\\n        let parts = for arg in args {\\n          print_pat(arg)\\n        }\\n        String::concat(short_name, String::concat(\\\"(\\\", String::concat(join(parts, \\\", \\\"), \\\")\\\")))\\n      }\\n    },\\n    POr(left, right) => String::concat(print_handle_pat(effect_name, left), String::concat(\\\" | \\\", print_handle_pat(effect_name, right))),\\n    _ => print_pat(pat)\\n  }\\n}\\n\\nfn map_to_strings(exprs: Array[Expr], f: (Expr) -> String) -> Array[String] {\\n  for expr in exprs {\\n    f(expr)\\n  }\\n}\\n\\nexport fn print_type_expr(ty: TypeExpr) -> String {\\n  match ty {\\n    TyName(name) => name,\\n    TyUnit => \\\"()\\\",\\n    TyApp(name, args) => {\\n      let parts = for arg in args {\\n        print_type_expr(arg)\\n      }\\n      String::concat(name, String::concat(\\\"[\\\", String::concat(join(parts, \\\", \\\"), \\\"]\\\")))\\n    },\\n    TyFn(params, ret, effect_name) => {\\n      let parts = for param in params {\\n        print_type_expr(param)\\n      }\\n      let base = String::concat(\\\"(\\\", String::concat(join(parts, \\\", \\\"), String::concat(\\\") -> \\\", print_type_expr(ret))))\\n      match effect_name {\\n        Some(name) => String::concat(base, String::concat(\\\" with { \\\", String::concat(name, \\\" }\\\"))),\\n        None => base\\n      }\\n    },\\n    TyTuple(elems) => {\\n      let parts = for elem in elems {\\n        print_type_expr(elem)\\n      }\\n      String::concat(\\\"(\\\", String::concat(join(parts, \\\", \\\"), \\\")\\\"))\\n    }\\n  }\\n}\\n\\nfn print_ctor(name: String, args: Array[TypeExpr]) -> String {\\n  if Array::length(args) == 0 {\\n    name\\n  }\\n  else {\\n    let parts = for arg in args {\\n      print_type_expr(arg)\\n    }\\n    String::concat(name, String::concat(\\\"(\\\", String::concat(join(parts, \\\", \\\"), \\\")\\\")))\\n  }\\n}\\n\\n// Render a function/lambda type-parameter header `[T: Ord, U]` from the EFn\\n// type_params + bounds. Returns \\\"\\\" when there are no type params. Without\\n// this, print_program (used to round-trip a merged multi-module program back\\n// to source) would drop `[T: Ord]`, so a re-parsed generic function loses its\\n// type-parameter scope and `T` resolves to a concrete `CtNamed(\\\"T\\\", [])`\\n// instead of a bound type variable.\\nfn print_fn_type_params(type_params: Array[String], bounds: Array[(String, Array[String])]) -> String {\\n  if Array::length(type_params) == 0 {\\n    \\\"\\\"\\n  } else {\\n    let parts = for tp in type_params {\\n      let mut found = Array::slice([\\n        \\\"\\\"\\n      ], 0, 0)\\n      let mut bi = 0\\n      while bi < Array::length(bounds) {\\n        let (bname, blist) = Array::get(bounds, bi)\\n        if bname == tp {\\n          found = blist\\n        }\\n        bi = bi + 1\\n      }\\n      if Array::length(found) == 0 {\\n        tp\\n      } else {\\n        String::concat(tp, String::concat(\\\": \\\", join(found, \\\" + \\\")))\\n      }\\n    }\\n    String::concat(\\\"[\\\", String::concat(join(parts, \\\", \\\"), \\\"]\\\"))\\n  }\\n}\\n\\nexport fn print_expr(e: Expr) -> String {\\n  match e {\\n    EInt(n) => __to_string(n),\\n    EFloat(n) => {\\n      // #726: a whole double printed as \\\"2\\\" re-parses as an INT literal —\\n      // `EFloat(2.0)` round-tripped to `EInt(2)` (the merge-flatten stage\\n      // rejected the compiler's own `EFloat(...)` ctor calls; normalize had\\n      // the same silent semantic corruption). Keep the float-ness explicit.\\n      let s = double_to_string_compiler(n)\\n      if String::contains(s, \\\".\\\") || s == \\\"nan\\\" {\\n        s\\n      } else {\\n        String::concat(s, \\\".0\\\")\\n      }\\n    },\\n    EString(s) => String::concat(\\\"\\\\\\\"\\\", String::concat(escape_string(s), \\\"\\\\\\\"\\\")),\\n    EBool(b) => if b {\\n      \\\"true\\\"\\n    } else \\\"false\\\",\\n    EIdent(name, _) => print_name(name),\\n    EUnit => \\\"()\\\",\\n    ETuple(elems) => String::concat(\\\"(\\\", String::concat(join(map_to_strings(elems, print_expr), \\\", \\\"), \\\")\\\")),\\n    EArray(elems) => String::concat(\\\"[\\\", String::concat(join(map_to_strings(elems, print_expr), \\\", \\\"), \\\"]\\\")),\\n    ERecord(rn, fields, targs) => {\\n      let parts = for field in fields {\\n        let (name, val) = field\\n        String::concat(name, String::concat(\\\": \\\", print_expr(val)))\\n      }\\n      // #886: re-emit explicit struct type arguments (`Pair[Int]::{ .. }`)\\n      // so the normalize round-trip preserves the pinned instantiation.\\n      let head = if Array::length(targs) > 0 {\\n        String::concat(rn, String::concat(\\\"[\\\", String::concat(join(for ta in targs {\\n          print_type_expr(ta)\\n        }, \\\", \\\"), \\\"]\\\")))\\n      } else {\\n        rn\\n      }\\n      let prefix = if rn == \\\"\\\" {\\n        \\\"record { \\\"\\n      } else String::concat(head, \\\"::{ \\\")\\n      String::concat(prefix, String::concat(join(parts, \\\", \\\"), \\\" }\\\"))\\n    },\\n    EIf(cond, then_e, else_e) => match else_e {\\n      EUnit => String::concat(\\\"if \\\", String::concat(print_expr(cond), String::concat(\\\" { \\\", String::concat(print_expr(then_e), \\\" }\\\")))),\\n      _ => String::concat(\\\"if \\\", String::concat(print_expr(cond), String::concat(\\\" { \\\", String::concat(print_expr(then_e), String::concat(\\\" } else { \\\", String::concat(print_expr(else_e), \\\" }\\\"))))))\\n    },\\n    ELet(name, val, body, _) => String::concat(\\\"{ let \\\", String::concat(print_name(name), String::concat(\\\" = \\\", String::concat(print_expr(val), String::concat(\\\"; \\\", String::concat(print_expr(body), \\\" }\\\")))))),\\n    ELetRec(name, val, body) => String::concat(\\\"{ let rec \\\", String::concat(print_name(name), String::concat(\\\" = \\\", String::concat(print_expr(val), String::concat(\\\"; \\\", String::concat(print_expr(body), \\\" }\\\")))))),\\n    ELetMut(name, val, body, _) => String::concat(\\\"{ let mut \\\", String::concat(print_name(name), String::concat(\\\" = \\\", String::concat(print_expr(val), String::concat(\\\"; \\\", String::concat(print_expr(body), \\\" }\\\")))))),\\n    EAssign(name, val, body) => String::concat(\\\"{ \\\", String::concat(print_name(name), String::concat(\\\" = \\\", String::concat(print_expr(val), String::concat(\\\"; \\\", String::concat(print_expr(body), \\\" }\\\")))))),\\n    EAssignOp(name, op, val, body) => String::concat(\\\"{ \\\", String::concat(print_name(name), String::concat(\\\" \\\", String::concat(op, String::concat(\\\"= \\\", String::concat(print_expr(val), String::concat(\\\"; \\\", String::concat(print_expr(body), \\\" }\\\")))))))),\\n    ESeq(a, b) => String::concat(\\\"{ \\\", String::concat(print_expr(a), String::concat(\\\"; \\\", String::concat(print_expr(b), \\\" }\\\")))),\\n    EMatch(scrutinee, arms) => {\\n      let parts = for arm in arms {\\n        let (pat, expr) = arm\\n        String::concat(print_pat(pat), String::concat(\\\" => \\\", print_expr(expr)))\\n      }\\n      String::concat(\\\"match \\\", String::concat(print_expr(scrutinee), String::concat(\\\" { \\\", String::concat(join(parts, \\\", \\\"), \\\" }\\\"))))\\n    },\\n    EHandle(body, arms) => {\\n      let effect_name = infer_handle_effect_name(arms)\\n      let parts = for arm in arms {\\n        let (pat, expr) = arm\\n        String::concat(print_handle_pat(effect_name, pat), String::concat(\\\" => \\\", print_expr(expr)))\\n      }\\n      String::concat(\\\"handle { \\\", String::concat(print_expr(body), String::concat(\\\" } with \\\", String::concat(effect_name, String::concat(\\\" { \\\", String::concat(join(parts, \\\"; \\\"), \\\" }\\\"))))))\\n    },\\n    EWhile(cond, body) => String::concat(\\\"while \\\", String::concat(print_expr(cond), String::concat(\\\" { \\\", String::concat(print_expr(body), \\\" }\\\")))),\\n    ELoop(params, body) => {\\n      let parts = for param in params {\\n        let (name, init) = param\\n        String::concat(print_name(name), String::concat(\\\" = \\\", print_expr(init)))\\n      }\\n      String::concat(\\\"loop (\\\", String::concat(join(parts, \\\", \\\"), String::concat(\\\") { \\\", String::concat(print_expr(body), \\\" }\\\"))))\\n    },\\n    EForIn(value_name, index_name, iterable, body) => {\\n      let binding = match index_name {\\n        Some(index_name) => String::concat(print_name(index_name), String::concat(\\\", \\\", print_name(value_name))),\\n        None => print_name(value_name)\\n      }\\n      String::concat(\\\"for \\\", String::concat(binding, String::concat(\\\" in \\\", String::concat(print_expr(iterable), String::concat(\\\" { \\\", String::concat(print_expr(body), \\\" }\\\"))))))\\n    },\\n    ECall(callee, args, _) => match callee {\\n      EIdent(\\\"perform\\\", _) => if Array::length(args) == 1 {\\n        // #640 Stage 2: re-sugar the parser's `throw(x)` desugar (`perform\\n        // Error::Throw(x)` shape) back to `throw(x)`. This keeps print\\n        // round-trips stable for the ubiquitous `throw(` spelling and keeps\\n        // the regenerated flat module source seed-compatible (the committed\\n        // seed predates the Stage-1 tag-2 routing of the perform spelling).\\n        // The explicit no-call `perform Error::Throw` (EIdent op) keeps its\\n        // perform rendering below.\\n        let resugar = match Array::get(args, 0) {\\n          ECall(op_callee, op_args, _) => match op_callee {\\n            EIdent(op_name, _) => if op_name == \\\"Error::Throw\\\" && Array::length(op_args) == 1 {\\n              Some(Array::get(op_args, 0))\\n            } else {\\n              None\\n            },\\n            _ => None\\n          },\\n          _ => None\\n        }\\n        match resugar {\\n          Some(payload) => String::concat(\\\"throw(\\\", String::concat(print_expr(payload), \\\")\\\")),\\n          None => String::concat(\\\"perform \\\", print_expr(Array::get(args, 0)))\\n        }\\n      } else {\\n        String::concat(print_expr(callee), String::concat(\\\"(\\\", String::concat(join(map_to_strings(args, print_expr), \\\", \\\"), \\\")\\\")))\\n      },\\n      // #726: an immediately-invoked lambda callee must be parenthesized —\\n      // `(x: T) -> { x }(args)` re-parses with the CALL inside the lambda\\n      // body (`{ x }(args)`, \\\"calling a non-function value\\\"), so print\\n      // `((x: T) -> { x })(args)`.\\n      EFn(_, _, _, _, _, _) => String::concat(\\\"(\\\", String::concat(print_expr(callee), String::concat(\\\")(\\\", String::concat(join(map_to_strings(args, print_expr), \\\", \\\"), \\\")\\\")))),\\n      _ => String::concat(print_expr(callee), String::concat(\\\"(\\\", String::concat(join(map_to_strings(args, print_expr), \\\", \\\"), \\\")\\\")))\\n    },\\n    EBinOp(op, left, right) => String::concat(\\\"(\\\", String::concat(print_expr(left), String::concat(\\\" \\\", String::concat(op, String::concat(\\\" \\\", String::concat(print_expr(right), \\\")\\\")))))),\\n    EUnaryOp(op, expr) => String::concat(\\\"(\\\", String::concat(op, String::concat(print_expr(expr), \\\")\\\"))),\\n    EFn(type_params, bounds, params, ret_ty, effect, body) => {\\n      let tp_str = print_fn_type_params(type_params, bounds)\\n      let parts = for param in params {\\n        let (name, ty_opt) = param\\n        match ty_opt {\\n          Some(ty) => String::concat(print_name(name), String::concat(\\\": \\\", print_type_expr(ty))),\\n          None => print_name(name)\\n        }\\n      }\\n      let ret_str = match ret_ty {\\n        Some(rt) => {\\n          let eff_str = match effect {\\n            Some(e) => String::concat(\\\" with { \\\", String::concat(e, \\\" }\\\")),\\n            None => \\\"\\\"\\n          }\\n          String::concat(\\\") -> \\\", String::concat(print_type_expr(rt), String::concat(eff_str, String::concat(\\\" { \\\", String::concat(print_expr(body), \\\" }\\\")))))\\n        },\\n        None => String::concat(\\\") -> { \\\", String::concat(print_expr(body), \\\" }\\\"))\\n      }\\n      String::concat(tp_str, String::concat(\\\"(\\\", String::concat(join(parts, \\\", \\\"), ret_str)))\\n    },\\n    EDot(expr, field, _, _) => String::concat(print_expr(expr), String::concat(\\\".\\\", field)),\\n    EReturn(e) => String::concat(\\\"return \\\", print_expr(e)),\\n    EBreak(opt) => match opt {\\n      None => \\\"break\\\",\\n      Some(v) => String::concat(\\\"break \\\", print_expr(v))\\n    },\\n    EContinue(args) => if Array::length(args) == 0 {\\n      \\\"continue\\\"\\n    } else String::concat(\\\"continue(\\\", String::concat(join(map_to_strings(args, print_expr), \\\", \\\"), \\\")\\\")),\\n    ELabeledArg(name, _modifier, val) => String::concat(name, String::concat(\\\"=\\\", print_expr(val))),\\n    // #960 Stage 2: the `map { ... }` literal is retired, so EMap prints as\\n    // the replacement API — the parser desugars these spellings back into the\\n    // same EMap node, keeping flat module source round-trippable.\\n    EMap(fields) => if Array::length(fields) == 0 {\\n      \\\"Map::new()\\\"\\n    } else {\\n      let parts = for field in fields {\\n        let (k, v) = field\\n        String::concat(\\\"(\\\\\\\"\\\", String::concat(escape_string(k), String::concat(\\\"\\\\\\\", \\\", String::concat(print_expr(v), \\\")\\\"))))\\n      }\\n      String::concat(\\\"Map::from_pairs([\\\", String::concat(join(parts, \\\", \\\"), \\\"])\\\"))\\n    },\\n    ESpread(inner) => String::concat(\\\"...\\\", print_expr(inner)),\\n    EStringInterp(parts) => String::concat(\\\"\\\\\\\"\\\", String::concat(join(parts, \\\"\\\"), \\\"\\\\\\\"\\\"))\\n  }\\n}\\n\\nfn print_annotated_let_value(ty_opt: Option[TypeExpr], val: Expr) -> String {\\n  match ty_opt {\\n    Some(TyFn(_, _, _)) => match val {\\n      EFn(type_params, bounds, params, _, _, body) => {\\n        // Type params live only on the EFn (the `: (T) -> T` annotation does\\n        // not carry `[T: Ord]`); emit them so a re-parse keeps the\\n        // type-parameter scope. Without this, print_program round-tripping a\\n        // merged multi-module program drops `[T: Ord]` and `T` resolves to a\\n        // concrete CtNamed instead of a bound type variable.\\n        let tp_str = print_fn_type_params(type_params, bounds)\\n        let parts = for param in params {\\n          let (name, _) = param\\n          print_name(name)\\n        }\\n        String::concat(\\n          tp_str,\\n          String::concat(\\n            \\\"(\\\",\\n            String::concat(\\n              join(parts, \\\", \\\"),\\n              String::concat(\\\") -> { \\\", String::concat(print_expr(body), \\\" }\\\"))\\n            )\\n          )\\n        )\\n      },\\n      _ => print_expr(val)\\n    },\\n    _ => print_expr(val)\\n  }\\n}\\n\\nfn print_ctor_list(ctors: Array[(String, Array[TypeExpr])]) -> String {\\n  let parts = for ctor in ctors {\\n    let (name, args) = ctor\\n    print_ctor(name, args)\\n  }\\n  join(parts, \\\"; \\\")\\n}\\n\\nexport fn print_stmt(s: Stmt) -> String {\\n  let prefix: (Bool) -> String = (exported) -> {\\n    if exported {\\n      \\\"export \\\"\\n    } else \\\"\\\"\\n  }\\n  match s {\\n    SLet(exported, is_rec, name, ty_opt, val) => {\\n      let p = prefix(exported)\\n      let r = if is_rec {\\n        \\\"let rec \\\"\\n      } else \\\"let \\\"\\n      let t = match ty_opt {\\n        Some(ty) => String::concat(\\\": \\\", print_type_expr(ty)),\\n        None => \\\"\\\"\\n      }\\n      String::concat(p, String::concat(r, String::concat(print_name(name), String::concat(t, String::concat(\\\" = \\\", print_annotated_let_value(ty_opt, val))))))\\n    },\\n    // ADR-0064 (#727): a preserved `fn` declaration —\\n    //   fn name[T](x: Int) -> R with { E } where { requires: c, ensures: c } { body }\\n    // Only produced by the *_preserving parse entry points; the default\\n    // pipeline lowers SFnDecl to SLet before printing ever matters.\\n    SFnDecl(exported, name, fn_value, reqs, enss) => {\\n      let p = prefix(exported)\\n      match fn_value {\\n        EFn(type_params, bounds, params, ret_ty, effect, body) => {\\n          let tp_str = print_fn_type_params(type_params, bounds)\\n          let parts = for param in params {\\n            let (pn, ty_opt) = param\\n            match ty_opt {\\n              Some(ty) => String::concat(print_name(pn), String::concat(\\\": \\\", print_type_expr(ty))),\\n              None => print_name(pn)\\n            }\\n          }\\n          let ret_str = match ret_ty {\\n            Some(rt) => print_type_expr(rt),\\n            None => \\\"()\\\"\\n          }\\n          let eff_str = match effect {\\n            Some(e) => String::concat(\\\" with { \\\", String::concat(e, \\\" }\\\")),\\n            None => \\\"\\\"\\n          }\\n          let where_str = if Array::length(reqs) == 0 && Array::length(enss) == 0 {\\n            \\\"\\\"\\n          } else {\\n            let conds = ArrayBuilder::new()\\n            let mut qi = 0\\n            while qi < Array::length(reqs) {\\n              ArrayBuilder::push(conds, String::concat(\\\"requires: \\\", print_expr(Array::get(reqs, qi))))\\n              qi = qi + 1\\n            }\\n            let mut ei = 0\\n            while ei < Array::length(enss) {\\n              ArrayBuilder::push(conds, String::concat(\\\"ensures: \\\", print_expr(Array::get(enss, ei))))\\n              ei = ei + 1\\n            }\\n            String::concat(\\\" where { \\\", String::concat(join(ArrayBuilder::freeze(conds), \\\", \\\"), \\\" }\\\"))\\n          }\\n          let head = String::concat(p, String::concat(\\\"fn \\\", String::concat(print_name(name), tp_str)))\\n          let sig = String::concat(\\\"(\\\", String::concat(join(parts, \\\", \\\"), String::concat(\\\") -> \\\", String::concat(ret_str, String::concat(eff_str, where_str)))))\\n          // #805 (ADR-0072): an inline-wasm body (the parser-internal\\n          // `%wasm(\\\"<WAT>\\\")` marker call) round-trips as `= wasm \\\"...\\\"` —\\n          // printing the marker as a call would not re-parse (`%` is not an\\n          // ident start in expression position).\\n          let wasm_text = match body {\\n            ECall(wcal, wargs, _) => match wcal {\\n              EIdent(wname, _) => if wname == \\\"%wasm\\\" && Array::length(wargs) == 1 {\\n                match Array::get(wargs, 0) {\\n                  EString(wt) => Some(wt),\\n                  _ => None\\n                }\\n              } else {\\n                None\\n              },\\n              _ => None\\n            },\\n            _ => None\\n          }\\n          match wasm_text {\\n            Some(wt) => String::concat(head, String::concat(sig, String::concat(\\\" = wasm \\\\\\\"\\\", String::concat(escape_string(wt), \\\"\\\\\\\"\\\")))),\\n            None => String::concat(head, String::concat(sig, String::concat(\\\" { \\\", String::concat(print_expr(body), \\\" }\\\"))))\\n          }\\n        },\\n        // Defensive: a non-EFn value cannot be spelled in fn syntax; fall\\n        // back to the lowered let-rec form so output stays parseable.\\n        _ => String::concat(p, String::concat(\\\"let rec \\\", String::concat(print_name(name), String::concat(\\\" = \\\", print_expr(fn_value)))))\\n      }\\n    },\\n    SLetMut(name, ty_opt, val) => {\\n      let t = match ty_opt {\\n        Some(ty) => String::concat(\\\": \\\", print_type_expr(ty)),\\n        None => \\\"\\\"\\n      }\\n      String::concat(\\\"let mut \\\", String::concat(print_name(name), String::concat(t, String::concat(\\\" = \\\", print_expr(val)))))\\n    },\\n    SEnum(exported, name, params, ctors, derives) => {\\n      // #735: `[T]` type params and `derive(...)` were dropped, so a printed\\n      // generic enum (e.g. a contract facade embedding `enum List[T]`)\\n      // round-tripped to an ill-typed nullary declaration.\\n      let tp = if Array::length(params) == 0 {\\n        \\\"\\\"\\n      } else {\\n        String::concat(\\\"[\\\", String::concat(join(params, \\\", \\\"), \\\"]\\\"))\\n      }\\n      let base = String::concat(prefix(exported), String::concat(\\\"enum \\\", String::concat(name, String::concat(tp, String::concat(\\\" { \\\", String::concat(print_ctor_list(ctors), \\\" }\\\"))))))\\n      if Array::length(derives) == 0 {\\n        base\\n      } else {\\n        String::concat(base, String::concat(\\\" derive(\\\", String::concat(join(derives, \\\", \\\"), \\\")\\\")))\\n      }\\n    },\\n    SSuberror(exported, name, ctors) => {\\n      let p = prefix(exported)\\n      if Array::length(ctors) == 1 {\\n        let (ctor_name, ctor_args) = Array::get(ctors, 0)\\n        if ctor_name == name {\\n          let parts = for arg in ctor_args {\\n            print_type_expr(arg)\\n          }\\n          String::concat(p, String::concat(\\\"suberror \\\", String::concat(name, String::concat(\\\"(\\\", String::concat(join(parts, \\\", \\\"), \\\")\\\")))))\\n        }\\n        else String::concat(p, String::concat(\\\"suberror \\\", String::concat(name, String::concat(\\\" { \\\", String::concat(print_ctor_list(ctors), \\\" }\\\")))))\\n      } else String::concat(p, String::concat(\\\"suberror \\\", String::concat(name, String::concat(\\\" { \\\", String::concat(print_ctor_list(ctors), \\\" }\\\")))))\\n    },\\n    SStruct(exported, name, fields, derives, mut_names, tparams) => {\\n      let parts = for field in fields {\\n        let (fn1, ty) = field\\n        let mut is_mut = false\\n        let mut mi = 0\\n        while mi < Array::length(mut_names) {\\n          if Array::get(mut_names, mi) == fn1 {\\n            is_mut = true\\n          }\\n          mi = mi + 1\\n        }\\n        let mp = if is_mut {\\n          \\\"mut \\\"\\n        } else {\\n          \\\"\\\"\\n        }\\n        String::concat(mp, String::concat(fn1, String::concat(\\\": \\\", print_type_expr(ty))))\\n      }\\n      // #829 (same class as SEnum/#735): keep `[T]` params on printed structs\\n      // so a generic struct round-trips instead of degrading to a nullary one.\\n      let tp = if Array::length(tparams) == 0 {\\n        \\\"\\\"\\n      } else {\\n        String::concat(\\\"[\\\", String::concat(join(tparams, \\\", \\\"), \\\"]\\\"))\\n      }\\n      let base = String::concat(prefix(exported), String::concat(\\\"struct \\\", String::concat(name, String::concat(tp, String::concat(\\\" { \\\", String::concat(join(parts, \\\"; \\\"), \\\" }\\\"))))))\\n      if Array::length(derives) == 0 {\\n        base\\n      } else {\\n        String::concat(base, String::concat(\\\" derive(\\\", String::concat(join(derives, \\\", \\\"), \\\")\\\")))\\n      }\\n    },\\n    STypeAlias(exported, name, params, ty) => {\\n      // #735 (same class as SEnum): keep `[T]` params on printed aliases.\\n      let tp = if Array::length(params) == 0 {\\n        \\\"\\\"\\n      } else {\\n        String::concat(\\\"[\\\", String::concat(join(params, \\\", \\\"), \\\"]\\\"))\\n      }\\n      String::concat(prefix(exported), String::concat(\\\"type \\\", String::concat(name, String::concat(tp, String::concat(\\\" = \\\", print_type_expr(ty))))))\\n    },\\n    STrait(exported, name, supers, methods, _) => {\\n      let base = String::concat(prefix(exported), String::concat(\\\"trait \\\", name))\\n      let head = if Array::length(supers) == 0 {\\n        base\\n      }\\n      else String::concat(base, String::concat(\\\": \\\", join(supers, \\\" + \\\")))\\n      if Array::length(methods) == 0 {\\n        head\\n      } else {\\n        let method_parts = for m in methods {\\n          let (method_name, params, ret) = m\\n          let params_str = if Array::length(params) > 0 {\\n            String::concat(\\\"(\\\", String::concat(join(for pt in params {\\n              print_type_expr(pt)\\n            }, \\\", \\\"), \\\")\\\"))\\n          } else \\\"\\\"\\n          String::concat(\\\"  \\\", String::concat(method_name, String::concat(params_str, String::concat(\\\" -> \\\", print_type_expr(ret)))))\\n        }\\n        String::concat(head, String::concat(\\\" {\\\\n\\\", String::concat(join(method_parts, \\\";\\\\n\\\"), \\\"\\\\n}\\\")))\\n      }\\n    },\\n    SImpl(tparams, _, trait_name, type_name) => {\\n      let head = if Array::length(tparams) == 0 {\\n        \\\"impl \\\"\\n      } else {\\n        String::concat(\\\"impl [\\\", String::concat(join(tparams, \\\", \\\"), \\\"] \\\"))\\n      }\\n      String::concat(head, String::concat(trait_name, String::concat(\\\" for \\\", type_name)))\\n    },\\n    SExternLet(name, ty) => String::concat(\\\"extern let \\\", String::concat(name, String::concat(\\\": \\\", print_type_expr(ty)))),\\n    SImport(path, items) => {\\n      let parts = for item in items {\\n        let (name, alias) = item\\n        match alias {\\n          Some(a) => String::concat(name, String::concat(\\\" as \\\", a)),\\n          None => name\\n        }\\n      }\\n      String::concat(\\\"import \\\", String::concat(path, String::concat(\\\" { \\\", String::concat(join(parts, \\\", \\\"), \\\" }\\\"))))\\n    },\\n    STest(name, body) => String::concat(\\\"test \\\\\\\"\\\", String::concat(name, String::concat(\\\"\\\\\\\" { \\\", String::concat(print_expr(body), \\\" }\\\")))),\\n    SBench(name, body) => String::concat(\\\"bench \\\\\\\"\\\", String::concat(name, String::concat(\\\"\\\\\\\" { \\\", String::concat(print_expr(body), \\\" }\\\")))),\\n    SExpr(e) => print_expr(e),\\n    SExport(names) => String::concat(\\\"export { \\\", String::concat(join(names, \\\", \\\"), \\\" }\\\")),\\n    SReExport(path, items) => {\\n      let parts = for item in items {\\n        let (name, alias) = item\\n        match alias {\\n          Some(a) => String::concat(name, String::concat(\\\" as \\\", a)),\\n          None => name\\n        }\\n      }\\n      String::concat(\\\"export \\\", String::concat(path, String::concat(\\\" { \\\", String::concat(join(parts, \\\", \\\"), \\\" }\\\"))))\\n    },\\n    SAliasDecl(alias_name, source_path) => String::concat(\\\"import \\\", String::concat(source_path, String::concat(\\\" @\\\", alias_name))),\\n    SLetPat(pat, expr) => String::concat(\\\"let \\\", String::concat(print_pat(pat), String::concat(\\\" = \\\", print_expr(expr)))),\\n    SModule(exported, name, stmts) => {\\n      let parts = for s in stmts {\\n        print_stmt(s)\\n      }\\n      let p = if exported {\\n        \\\"export \\\"\\n      } else \\\"\\\"\\n      String::concat(p, String::concat(\\\"module \\\", String::concat(name, String::concat(\\\" { \\\", String::concat(join(parts, \\\"\\\\n\\\"), \\\" }\\\")))))\\n    },\\n    SEffectDef(exported, name, type_params, ops) => {\\n      let p = if exported {\\n        \\\"export \\\"\\n      } else \\\"\\\"\\n      let tp = if Array::length(type_params) > 0 {\\n        String::concat(\\\"[\\\", String::concat(join(type_params, \\\", \\\"), \\\"]\\\"))\\n      } else \\\"\\\"\\n      let op_parts = for op in ops {\\n        let (op_name, params, ret) = op\\n        let params_str = if Array::length(params) > 0 {\\n          String::concat(\\\"(\\\", String::concat(join(for pt in params {\\n            print_type_expr(pt)\\n          }, \\\", \\\"), \\\")\\\"))\\n        } else \\\"\\\"\\n        String::concat(\\\"  \\\", String::concat(op_name, String::concat(params_str, String::concat(\\\" -> \\\", print_type_expr(ret)))))\\n      }\\n      String::concat(p, String::concat(\\\"effect \\\", String::concat(name, String::concat(tp, String::concat(\\\" {\\\\n\\\", String::concat(join(op_parts, \\\";\\\\n\\\"), \\\"\\\\n}\\\"))))))\\n    }\\n  }\\n}\\n\\nfn needs_program_separator(stmt_text: String) -> Bool {\\n  if String::length(stmt_text) == 0 {\\n    false\\n  } else {\\n    let c = String::char_code_at(stmt_text, 0)\\n    c == '(' || c == '['\\n  }\\n}\\n\\nexport fn print_program(stmts: Array[Stmt]) -> String {\\n  let len = Array::length(stmts)\\n  // O(N) build via ArrayBuilder (matching this file's join/escape_string idiom);\\n  // the previous `out = String::concat(out, ...)` per statement was O(N²) over\\n  // the total printed size, which dominates emit-module-source (issue #366).\\n  let b = ArrayBuilder::new()\\n  let mut i = 0\\n  while i < len {\\n    let stmt_text = print_stmt(Array::get(stmts, i))\\n    if i > 0 {\\n      let sep = if needs_program_separator(stmt_text) {\\n        \\\";\\\\n\\\"\\n      } else \\\"\\\\n\\\"\\n      ArrayBuilder::push(b, sep)\\n    }\\n    ArrayBuilder::push(b, stmt_text)\\n    i = i + 1\\n  }\\n  String::join(ArrayBuilder::freeze(b), \\\"\\\")\\n}\\n\")\n}\n\nlet cli_adapter_source_15 = () -> (String, String) {\n  (\"lib/@vibe/compiler/core/polyfill.vibe\",\n\"//# Functions\\n\\nexport fn __to_string(n: Int) -> String {\\n  if n == 0 {\\n    \\\"0\\\"\\n  } else {\\n    let mut val = n\\n    let mut neg = false\\n    if val < 0 {\\n      neg = true\\n      val = 0 - val\\n    }\\n    let digits = Array::slice([\\n      \\\"\\\"\\n    ], 0, 0)\\n    while val > 0 {\\n      let d = val - (val / 10) * 10\\n      let ch = if d == 0 {\\n        \\\"0\\\"\\n      }\\n      else if d == 1 {\\n        \\\"1\\\"\\n      }\\n      else if d == 2 {\\n        \\\"2\\\"\\n      }\\n      else if d == 3 {\\n        \\\"3\\\"\\n      }\\n      else if d == 4 {\\n        \\\"4\\\"\\n      }\\n      else if d == 5 {\\n        \\\"5\\\"\\n      }\\n      else if d == 6 {\\n        \\\"6\\\"\\n      }\\n      else if d == 7 {\\n        \\\"7\\\"\\n      }\\n      else if d == 8 {\\n        \\\"8\\\"\\n      }\\n      else {\\n        \\\"9\\\"\\n      }\\n      Array::push(digits, ch)\\n      val = val / 10\\n    }\\n    let mut result = if neg {\\n      \\\"-\\\"\\n    } else {\\n      \\\"\\\"\\n    }\\n    let mut i = Array::length(digits) - 1\\n    while i >= 0 {\\n      result = String::concat(result, Array::get(digits, i))\\n      i = i - 1\\n    }\\n    result\\n  }\\n}\\n\")\n}\n\nlet cli_adapter_source_16 = () -> (String, String) {\n  (\"lib/@vibe/compiler/core/bytebuf.vibe\",\n\"//# Functions\\n\\nexport fn bytebuf_new() -> Bytes {\\n  Bytes::new()\\n}\\n\\nexport fn bytebuf_push(buf: Bytes, byte: Int) -> Unit {\\n  Bytes::push(buf, byte)\\n}\\n\\nexport fn bytebuf_push2(buf: Bytes, b1: Int, b2: Int) -> Unit {\\n  bytebuf_push(buf, b1)\\n  bytebuf_push(buf, b2)\\n}\\n\\nexport fn bytebuf_push3(buf: Bytes, b1: Int, b2: Int, b3: Int) -> Unit {\\n  bytebuf_push(buf, b1)\\n  bytebuf_push(buf, b2)\\n  bytebuf_push(buf, b3)\\n}\\n\\nexport fn bytebuf_push9(buf: Bytes, b1: Int, b2: Int, b3: Int, b4: Int, b5: Int, b6: Int, b7: Int, b8: Int, b9: Int) -> Unit {\\n  bytebuf_push(buf, b1)\\n  bytebuf_push(buf, b2)\\n  bytebuf_push(buf, b3)\\n  bytebuf_push(buf, b4)\\n  bytebuf_push(buf, b5)\\n  bytebuf_push(buf, b6)\\n  bytebuf_push(buf, b7)\\n  bytebuf_push(buf, b8)\\n  bytebuf_push(buf, b9)\\n}\\n\\nexport fn bytebuf_length(buf: Bytes) -> Int {\\n  Bytes::length(buf)\\n}\\n\\nexport fn bytebuf_push_buf(dst: Bytes, src: Bytes) -> Unit {\\n  Bytes::append(dst, src)\\n}\\n\\nexport fn bytebuf_to_bytes(buf: Bytes) -> Bytes {\\n  buf\\n}\\n\\nexport fn leb128_encode_s32(buf: Bytes, value: Int) -> Unit {\\n  if value >= (0 - 64) && value < 64 {\\n    Bytes::push(buf, value&127)\\n  } else {\\n    if value >= (0 - 8192) && value < 8192 {\\n      Bytes::push(buf, (value&127)|128)\\n      Bytes::push(buf, (value>>7)&127)\\n    } else {\\n      let mut v = value\\n      let mut more = true\\n      while more {\\n        let byte = v&127\\n        v = v>>7\\n        if (v == 0) && (byte&64) == 0 {\\n          Bytes::push(buf, byte)\\n          more = false\\n        } else {\\n          if (v == 0 - 1) && (byte&64) != 0 {\\n            Bytes::push(buf, byte)\\n            more = false\\n          } else {\\n            Bytes::push(buf, byte|128)\\n          }\\n        }\\n      }\\n    }\\n  }\\n}\\n\\nexport fn leb128_encode_s64(buf: Bytes, value: Int) -> Unit {\\n  leb128_encode_s32(buf, value)\\n}\\n\\nexport fn leb128_encode_u32(buf: Bytes, value: Int) -> Unit {\\n  if value >= 0 && value < 128 {\\n    Bytes::push(buf, value)\\n  } else {\\n    if value >= 128 && value < 16384 {\\n      Bytes::push(buf, (value&127)|128)\\n      Bytes::push(buf, (value>>7)&127)\\n    } else {\\n      let mut v = value\\n      let mut more = true\\n      while more {\\n        let byte = v&127\\n        v = (v>>7)&((1<<25) - 1)\\n        if v == 0 {\\n          Bytes::push(buf, byte)\\n          more = false\\n        } else {\\n          Bytes::push(buf, byte|128)\\n        }\\n      }\\n    }\\n  }\\n}\\n\\nexport fn bytebuf_push_string(buf: Bytes, s: String) -> Unit {\\n  let slen = String::length(s)\\n  leb128_encode_u32(buf, slen)\\n  let mut i = 0\\n  while i < slen {\\n    bytebuf_push(buf, String::char_code_at(s, i))\\n    i = i + 1\\n  }\\n}\\n\\nexport fn bytebuf_push_section(out: Bytes, section_id: Int, content: Bytes) -> Unit {\\n  bytebuf_push(out, section_id)\\n  leb128_encode_u32(out, bytebuf_length(content))\\n  bytebuf_push_buf(out, content)\\n}\\n\\nexport fn bytebuf_push_opcode_s64(buf: Bytes, opcode: Int, value: Int) -> Unit {\\n  bytebuf_push(buf, opcode)\\n  leb128_encode_s32(buf, value)\\n}\\n\\nexport fn bytebuf_push_opcode_u32(buf: Bytes, opcode: Int, value: Int) -> Unit {\\n  if value >= 0 && value < 128 {\\n    Bytes::push(buf, opcode)\\n    Bytes::push(buf, value)\\n  } else {\\n    if value >= 128 && value < 16384 {\\n      Bytes::push(buf, opcode)\\n      Bytes::push(buf, (value&127)|128)\\n      Bytes::push(buf, (value>>7)&127)\\n    } else {\\n      Bytes::push(buf, opcode)\\n      leb128_encode_u32(buf, value)\\n    }\\n  }\\n}\\n\\nexport fn bytebuf_push_vec_header(buf: Bytes, count: Int) -> Unit {\\n  leb128_encode_u32(buf, count)\\n}\\n\\nexport fn bytebuf_push_opcode_u32_u32(buf: Bytes, opcode: Int, a: Int, b: Int) -> Unit {\\n  bytebuf_push(buf, opcode)\\n  leb128_encode_u32(buf, a)\\n  leb128_encode_u32(buf, b)\\n}\\n\")\n}\n\nlet cli_adapter_source_17 = () -> (String, String) {\n  (\"lib/@vibe/compiler/core/ast.vibe\",\n\"//# Imports\\n\\n// #753 (ADR-0065 Phase 3): the AST enums live in the @vibe/ast contract\\n// package; this module is a re-export shim so the compiler's existing\\n// `import ../core/ast.vibe` / `import ../core` spellings keep working.\\n// (`export <path>` re-export requires a ./-prefixed path in the current\\n// seed's parser, so this is spelled import + bare export.)\\nimport ../../../../lib/@vibe/ast {\\n  Expr, Pat, Stmt, TypeExpr\\n}\\n\\n//# Misc\\n\\nexport {\\n  Pat, Expr, Stmt, TypeExpr\\n}\\n\")\n}\n\nlet cli_adapter_source_18 = () -> (String, String) {\n  (\"lib/@vibe/compiler/core/types.vibe\",\n\"//# Imports\\n\\nimport ./ast.vibe {\\n  TypeExpr\\n}\\n\\n//# Types\\n\\nexport enum Type {\\n  CtInt;\\n  CtDouble;\\n  CtBool;\\n  CtString;\\n  CtChar;\\n  CtUnit;\\n  CtTuple(Array[Type]);\\n  CtArray(Type);\\n  CtOption(Type);\\n  CtFn(Array[Type], Type, Option[String]);\\n  CtEnum(String);\\n  CtStruct(String);\\n  CtBytes;\\n  CtNamed(String, Array[Type]);\\n  CtVar(Int);\\n  CtForAll(Array[Int], Array[(Int, Array[String])], Type);\\n  CtUnknown\\n}\\n\\nexport enum TypeDef {\\n  TDEnum(String, Array[String], Array[(String, Array[Type])]);\\n  // #829: (name, fields, mut field names, declared type params). Type params\\n  // are APPENDED so positional matches of the older 3-field form stay aligned.\\n  TDStruct(String, Array[(String, Type)], Array[String], Array[String]);\\n  TDAlias(String, Array[String], Type);\\n  // #813: a declared effect's operation signatures — (op name, param types,\\n  // return type) — so perform arguments, handler arm names/arity/payloads,\\n  // and resume values can be validated. Generic effects are not registered\\n  // (ground gate).\\n  TDEffect(String, Array[(String, Array[Type], Type)])\\n}\\n\\nexport enum TypeEnv {\\n  EnvEmpty;\\n  EnvBind(String, Type, TypeEnv);\\n  EnvTraitDef(String, Array[String], Bool, Array[(String, Array[TypeExpr], TypeExpr)], TypeEnv);\\n  EnvTraitImpl(String, Type, TypeEnv);\\n  EnvTraitImplGen(String, Array[String], Array[(String, Array[String])], Type, TypeEnv);\\n  EnvFlat(Array[(String, Type)]);\\n  EnvCached(Map[String, Type], TypeEnv)\\n}\\n\\nexport enum Subst {\\n  SubstEmpty;\\n  SubstBind(Int, Type, Subst);\\n  SubstBound(Int, Array[String], Subst);\\n  SubstCached(Map[String, Type], Map[String, Array[String]], Subst);\\n  // #626 criterion 4: an effect-variable binding `var := effect-label-string`\\n  // (\\\"\\\" meaning the pure/empty row). Effect variables are no longer a wildcard\\n  // that is compatible with everything — `unify` records their binding here and\\n  // `subst_apply` resolves CtFn effects through it, so `e` actually unifies to\\n  // its first binding and a later conflicting use is a type error.\\n  SubstEffBind(String, String, Subst)\\n}\\n\\n//# Functions\\n\\nexport fn env_bind(env: TypeEnv, name: String, ty: Type) -> TypeEnv {\\n  match env {\\n    EnvCached(cache, rest) => EnvCached(cache, EnvBind(name, ty, rest)),\\n    _ => EnvBind(name, ty, env)\\n  }\\n}\\n\\nexport fn env_cache(env: TypeEnv) -> TypeEnv {\\n  let is_empty = match env {\\n    EnvEmpty => true,\\n    _ => false\\n  }\\n  if is_empty {\\n    EnvEmpty\\n  } else {\\n    let names = ArrayBuilder::new()\\n    let types = ArrayBuilder::new()\\n    let mut cur = env\\n    let mut done = false\\n    while !done {\\n      match cur {\\n        EnvEmpty => {\\n          done = true\\n        },\\n        EnvBind(n, ty, rest) => {\\n          ArrayBuilder::push(names, n)\\n          ArrayBuilder::push(types, ty)\\n          cur = rest\\n        },\\n        EnvTraitDef(_, _, _, _, rest) => {\\n          cur = rest\\n        },\\n        EnvTraitImpl(_, _, rest) => {\\n          cur = rest\\n        },\\n        EnvTraitImplGen(_, _, _, _, rest) => {\\n          cur = rest\\n        },\\n        EnvFlat(bindings) => {\\n          let mut j = 0\\n          while j < Array::length(bindings) {\\n            let (n, ty) = Array::get(bindings, j)\\n            ArrayBuilder::push(names, n)\\n            ArrayBuilder::push(types, ty)\\n            j = j + 1\\n          }\\n          done = true\\n        },\\n        EnvCached(_, rest) => {\\n          cur = rest\\n        }\\n      }\\n    }\\n    let na = ArrayBuilder::freeze(names)\\n    let ta = ArrayBuilder::freeze(types)\\n    let cache = MapBuilder::new()\\n    let len = Array::length(na)\\n    let mut i = 0\\n    while i < len {\\n      let idx = len - i - 1\\n      MapBuilder::set(cache, Array::get(na, idx), Array::get(ta, idx))\\n      i = i + 1\\n    }\\n    EnvCached(MapBuilder::freeze(cache), env)\\n  }\\n}\\n\\nexport fn fresh_var(c: Int) -> (Type, Int) {\\n  (CtVar(c), c + 1)\\n}\\n\\nexport fn occurs_in(id: Int, ty: Type) -> Bool {\\n  match ty {\\n    CtVar(vid) => (id == vid),\\n    CtFn(params, ret, _) => {\\n      let mut i = 0\\n      let mut found = false\\n      while i < Array::length(params) {\\n        if occurs_in(id, Array::get(params, i)) {\\n          found = true\\n          i = Array::length(params)\\n        } else {\\n          i = i + 1\\n        }\\n      }\\n      found || occurs_in(id, ret)\\n    },\\n    CtArray(elem) => occurs_in(id, elem),\\n    CtOption(elem) => occurs_in(id, elem),\\n    CtTuple(elems) => {\\n      let mut i = 0\\n      let mut found = false\\n      while i < Array::length(elems) {\\n        if occurs_in(id, Array::get(elems, i)) {\\n          found = true\\n          i = Array::length(elems)\\n        } else {\\n          i = i + 1\\n        }\\n      }\\n      found\\n    },\\n    CtForAll(_, _, body) => occurs_in(id, body),\\n    _ => false\\n  }\\n}\\n\\nexport fn env_lookup(env: TypeEnv, name: String) -> Option[Type] {\\n  let mut cur = env\\n  let mut result = None\\n  let mut done = false\\n  while !done {\\n    match cur {\\n      EnvEmpty => {\\n        done = true\\n      },\\n      EnvBind(n, ty, rest) => if n == name {\\n        result = Some(ty)\\n        done = true\\n      } else {\\n        cur = rest\\n      },\\n      EnvTraitDef(_, _, _, _, rest) => {\\n        cur = rest\\n      },\\n      EnvTraitImpl(_, _, rest) => {\\n        cur = rest\\n      },\\n      EnvTraitImplGen(_, _, _, _, rest) => {\\n        cur = rest\\n      },\\n      EnvFlat(bindings) => {\\n        let mut j = 0\\n        while j < Array::length(bindings) && !done {\\n          let (n, ty) = Array::get(bindings, j)\\n          if n == name {\\n            result = Some(ty)\\n            done = true\\n          } else {\\n            j = j + 1\\n          }\\n        }\\n        if !done {\\n          done = true\\n        }\\n      },\\n      EnvCached(cache, rest) => if Map::has_key(cache, name) {\\n        result = Some(Map::get(cache, name))\\n        done = true\\n      } else {\\n        cur = rest\\n      }\\n    }\\n  }\\n  result\\n}\\n\\nexport fn env_bind_all(env: TypeEnv, bindings: Array[(String, Type)]) -> TypeEnv {\\n  let len = Array::length(bindings)\\n  let mut i = 0\\n  let mut acc = env\\n  while i < len {\\n    let (name, ty) = Array::get(bindings, i)\\n    acc = env_bind(acc, name, ty)\\n    i = i + 1\\n  }\\n  acc\\n}\\n\\nexport fn find_typedef(defs: Array[TypeDef], name: String) -> Option[TypeDef] {\\n  let len = Array::length(defs)\\n  let mut i = 0\\n  let mut result = None\\n  let mut done = false\\n  while !done {\\n    if i >= len {\\n      done = true\\n    } else {\\n      let d = Array::get(defs, i)\\n      let dname = match d {\\n        TDEnum(n, _, _) => n,\\n        TDStruct(n, _, _, _) => n,\\n        TDAlias(n, _, _) => n,\\n        TDEffect(n, _) => n\\n      }\\n      if dname == name {\\n        result = Some(d)\\n        done = true\\n      } else {\\n        i = i + 1\\n      }\\n    }\\n  }\\n  result\\n}\\n\\nexport fn subst_lookup(s: Subst, id: Int) -> Option[Type] {\\n  let mut cur = s\\n  let mut out = None\\n  let mut done = false\\n  let key = __to_string(id)\\n  while !done {\\n    match cur {\\n      SubstEmpty => {\\n        done = true\\n      },\\n      SubstBind(i, ty, rest) => if i == id {\\n        out = Some(ty)\\n        done = true\\n      } else {\\n        cur = rest\\n      }\\n      ,\\n      SubstBound(_, _, rest) => {\\n        cur = rest\\n      },\\n      SubstCached(cache, _, rest) => if Map::has_key(cache, key) {\\n        out = Some(Map::get(cache, key))\\n        done = true\\n      } else {\\n        cur = rest\\n      }\\n      ,\\n      SubstEffBind(_, _, rest) => {\\n        cur = rest\\n      }\\n    }\\n  }\\n  out\\n}\\n\\nexport fn trait_supers(env: TypeEnv, name: String) -> Array[String] {\\n  let empty = Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n  match env {\\n    EnvEmpty => empty,\\n    EnvBind(_, _, rest) => trait_supers(rest, name),\\n    EnvTraitDef(tname, supers, _, _, rest) => if tname == name {\\n      supers\\n    } else trait_supers(rest, name),\\n    EnvTraitImpl(_, _, rest) => trait_supers(rest, name),\\n    EnvTraitImplGen(_, _, _, _, rest) => trait_supers(rest, name),\\n    EnvFlat(_) => empty,\\n    EnvCached(_, rest) => trait_supers(rest, name)\\n  }\\n}\\n\\n// Look up a trait method's declared signature (param TypeExprs + return\\n// TypeExpr) by trait name + method name. `Self` appears verbatim as\\n// `TyName(\\\"Self\\\")` in the stored signature; the caller substitutes it.\\nexport fn trait_method_sig(env: TypeEnv, trait_name: String, method_name: String) -> Option[(Array[TypeExpr], TypeExpr)] {\\n  match env {\\n    EnvEmpty => None,\\n    EnvBind(_, _, rest) => trait_method_sig(rest, trait_name, method_name),\\n    EnvTraitDef(tname, _, _, methods, rest) => if tname == trait_name {\\n      let mlen = Array::length(methods)\\n      let mut i = 0\\n      let mut found = None\\n      while i < mlen {\\n        let (mname, params, ret) = Array::get(methods, i)\\n        if mname == method_name {\\n          found = Some((params, ret))\\n          i = mlen\\n        } else {\\n          i = i + 1\\n        }\\n      }\\n      match found {\\n        Some(sig) => Some(sig),\\n        None => trait_method_sig(rest, trait_name, method_name)\\n      }\\n    } else trait_method_sig(rest, trait_name, method_name),\\n    EnvTraitImpl(_, _, rest) => trait_method_sig(rest, trait_name, method_name),\\n    EnvTraitImplGen(_, _, _, _, rest) => trait_method_sig(rest, trait_name, method_name),\\n    EnvFlat(_) => None,\\n    EnvCached(_, rest) => trait_method_sig(rest, trait_name, method_name)\\n  }\\n}\\n\\n// The declared name at the head of a (possibly generic) named type, for\\n// matching against a trait impl's target. Impl targets are stored with their\\n// type arguments erased to `CtUnknown` (see the `SImpl` handler), so element\\n// types must be matched by head name, not by `types_equal`.\\nfn trait_target_head_name(ty: Type) -> String {\\n  match ty {\\n    CtNamed(n, _) => n,\\n    CtStruct(n) => n,\\n    CtEnum(n) => n,\\n    _ => \\\"\\\"\\n  }\\n}\\n\\nfn type_name_iterator_impl_scan(scan: TypeEnv, full: TypeEnv, type_name: String) -> Bool {\\n  match scan {\\n    EnvEmpty => false,\\n    EnvBind(_, _, rest) => type_name_iterator_impl_scan(rest, full, type_name),\\n    EnvTraitDef(_, _, _, _, rest) => type_name_iterator_impl_scan(rest, full, type_name),\\n    EnvTraitImpl(tname, target, rest) => {\\n      let hit = trait_target_head_name(target) == type_name && (match trait_method_sig(full, tname, \\\"next\\\") {\\n        Some(_) => true,\\n        None => false\\n      })\\n      if hit {\\n        true\\n      } else type_name_iterator_impl_scan(rest, full, type_name)\\n    },\\n    EnvTraitImplGen(_, _, _, _, rest) => type_name_iterator_impl_scan(rest, full, type_name),\\n    EnvFlat(_) => false,\\n    EnvCached(_, rest) => type_name_iterator_impl_scan(rest, full, type_name)\\n  }\\n}\\n\\n// True iff a type named `type_name` has an `impl Tr for type_name` where the\\n// trait `Tr` declares a `next` method — i.e. the type is iterator-shaped\\n// (`Iterator[T] { next(Self) -> Option[(T, Self)] }`). The checker's `for x in\\n// it` element-type inference uses this to recognise struct-trait iterators\\n// (`LazyIter`, async streams, …) and bind the loop variable to the iterator's\\n// element type instead of `CtUnknown`.\\nexport fn type_name_has_iterator_impl(env: TypeEnv, type_name: String) -> Bool {\\n  type_name_iterator_impl_scan(env, env, type_name)\\n}\\n\\n// Like `trait_method_sig` but follows supertraits transitively, so a method\\n// inherited from a supertrait (`trait B: A` calling an `A` method on `[T: B]`)\\n// resolves. Trait hierarchies are acyclic, so the recursion terminates.\\nexport fn trait_method_sig_deep(env: TypeEnv, trait_name: String, method_name: String) -> Option[(Array[TypeExpr], TypeExpr)] {\\n  match trait_method_sig(env, trait_name, method_name) {\\n    Some(sig) => Some(sig),\\n    None => {\\n      let supers = trait_supers(env, trait_name)\\n      let mut i = 0\\n      let mut result = None\\n      while i < Array::length(supers) {\\n        let pending = match result {\\n          None => true,\\n          _ => false\\n        }\\n        if pending {\\n          match trait_method_sig_deep(env, Array::get(supers, i), method_name) {\\n            Some(sig) => {\\n              result = Some(sig)\\n            },\\n            None => ()\\n          }\\n        } else {\\n          ()\\n        }\\n        i = i + 1\\n      }\\n      result\\n    }\\n  }\\n}\\n\\n// Collect the trait bounds recorded for a specific type variable id in the\\n// current substitution (`subst_add_bound` entries). Used to resolve a\\n// `T::method` call where `T` is a bounded generic parameter.\\nexport fn subst_bounds_for(s: Subst, id: Int) -> Array[String] {\\n  let out = ArrayBuilder::new()\\n  let mut cur = s\\n  let mut done = false\\n  while !done {\\n    match cur {\\n      SubstEmpty => {\\n        done = true\\n      },\\n      SubstBind(_, _, rest) => {\\n        cur = rest\\n      },\\n      SubstBound(bid, bounds, rest) => {\\n        if bid == id {\\n          let mut i = 0\\n          while i < Array::length(bounds) {\\n            ArrayBuilder::push(out, Array::get(bounds, i))\\n            i = i + 1\\n          }\\n        } else {\\n          ()\\n        }\\n        cur = rest\\n      },\\n      SubstCached(_, bounds_cache, rest) => {\\n        let key = __to_string(id)\\n        if Map::has_key(bounds_cache, key) {\\n          let bounds = Map::get(bounds_cache, key)\\n          let mut i = 0\\n          while i < Array::length(bounds) {\\n            ArrayBuilder::push(out, Array::get(bounds, i))\\n            i = i + 1\\n          }\\n        } else {\\n          ()\\n        }\\n        cur = rest\\n      },\\n      SubstEffBind(_, _, rest) => {\\n        cur = rest\\n      }\\n    }\\n  }\\n  ArrayBuilder::freeze(out)\\n}\\n\\nfn array_has_int(arr: Array[Int], val: Int, i: Int) -> Bool {\\n  if i >= Array::length(arr) {\\n    false\\n  }\\n  else if Array::get(arr, i) == val {\\n    true\\n  }\\n  else array_has_int(arr, val, i + 1)\\n}\\n\\nfn int_array_has(arr: Array[Int], v: Int) -> Bool {\\n  let slen = Array::length(arr)\\n  let mut si = 0\\n  let mut sfound = false\\n  let mut sdone = false\\n  while !sdone {\\n    if si >= slen {\\n      sdone = true\\n    } else if Array::get(arr, si) == v {\\n      sfound = true\\n      sdone = true\\n    } else {\\n      si = si + 1\\n    }\\n  }\\n  sfound\\n}\\n\\nfn is_effect_var_name(name: String) -> Bool {\\n  let len = String::length(name)\\n  if len == 1 {\\n    // a source-level effect variable: a single lowercase letter (`with { e }`)\\n    String::char_code_at(name, 0) >= 97 && String::char_code_at(name, 0) <= 122\\n  } else if len >= 2 {\\n    // a FRESH effect variable minted by `instantiate` (`$N`): no real effect\\n    // name starts with `$`, so this marker is unambiguous.\\n    String::char_code_at(name, 0) == 36\\n  } else {\\n    false\\n  }\\n}\\n\\n// Resolve an effect variable name through the effect-binding chain (transitively\\n// following var->var links). Returns the bound effect-label string (\\\"\\\" = pure)\\n// or None if the variable is unbound.\\nfn subst_eff_lookup(s: Subst, name: String) -> Option[String] {\\n  let mut cur = s\\n  let mut out = None\\n  let mut done = false\\n  while !done {\\n    match cur {\\n      SubstEmpty => {\\n        done = true\\n      },\\n      SubstBind(_, _, rest) => {\\n        cur = rest\\n      },\\n      SubstBound(_, _, rest) => {\\n        cur = rest\\n      },\\n      SubstCached(_, _, rest) => {\\n        cur = rest\\n      },\\n      SubstEffBind(v, val, rest) => if v == name {\\n        out = Some(val)\\n        done = true\\n      } else {\\n        cur = rest\\n      }\\n    }\\n  }\\n  match out {\\n    Some(val) => if is_effect_var_name(val) {\\n      match subst_eff_lookup(s, val) {\\n        Some(v2) => Some(v2),\\n        None => Some(val)\\n      }\\n    } else {\\n      Some(val)\\n    },\\n    None => None\\n  }\\n}\\n\\n// Resolve a CtFn effect annotation through the effect-binding chain: a bound\\n// effect variable becomes its binding (an empty binding \\\"\\\" collapses to the\\n// pure row `None`); anything else is returned unchanged.\\nfn resolve_effect_opt(s: Subst, eff: Option[String]) -> Option[String] {\\n  match eff {\\n    None => None,\\n    Some(name) => if is_effect_var_name(name) {\\n      match subst_eff_lookup(s, name) {\\n        Some(val) => if String::length(val) == 0 {\\n          None\\n        } else {\\n          Some(val)\\n        },\\n        None => eff\\n      }\\n    } else {\\n      eff\\n    }\\n  }\\n}\\n\\nexport fn subst_apply(s: Subst, ty: Type) -> Type {\\n  match ty {\\n    CtInt => ty,\\n    CtBool => ty,\\n    CtString => ty,\\n    CtUnit => ty,\\n    CtDouble => ty,\\n    CtChar => ty,\\n    CtBytes => ty,\\n    CtUnknown => ty,\\n    CtVar(_) => {\\n      let mut cur = ty\\n      let mut out = ty\\n      let mut done = false\\n      let mut seen = Array::slice([\\n        0\\n      ], 0, 0)\\n      while !done {\\n        match cur {\\n          CtVar(vid) => if int_array_has(seen, vid) {\\n            out = cur\\n            done = true\\n          } else {\\n            Array::push(seen, vid)\\n            match subst_lookup(s, vid) {\\n              Some(next) => {\\n                cur = next\\n                out = next\\n              },\\n              None => {\\n                out = cur\\n                done = true\\n              }\\n            }\\n          },\\n          _ => {\\n            out = subst_apply(s, cur)\\n            done = true\\n          }\\n        }\\n      }\\n      out\\n    },\\n    CtFn(params, ret, effect_name) => {\\n      let apply_params: (Array[Type]) -> Array[Type] = (items) -> {\\n        let out = Array::slice([\\n          CtUnknown\\n        ], 0, 0)\\n        let mut i = 0\\n        while i < Array::length(items) {\\n          Array::push(out, subst_apply(s, Array::get(items, i)))\\n          i = i + 1\\n        }\\n        out\\n      }\\n      CtFn(apply_params(params), subst_apply(s, ret), resolve_effect_opt(s, effect_name))\\n    },\\n    CtArray(elem) => CtArray(subst_apply(s, elem)),\\n    CtOption(elem) => CtOption(subst_apply(s, elem)),\\n    CtTuple(elems) => CtTuple(for e in elems {\\n      subst_apply(s, e)\\n    }),\\n    CtNamed(name, args) => CtNamed(name, for arg in args {\\n      subst_apply(s, arg)\\n    }),\\n    CtForAll(_, _, _) => ty,\\n    _ => ty\\n  }\\n}\\n\\nexport fn trait_defined(env: TypeEnv, name: String) -> Bool {\\n  match env {\\n    EnvEmpty => false,\\n    EnvBind(_, _, rest) => trait_defined(rest, name),\\n    EnvTraitDef(tname, _, _, _, rest) => if tname == name {\\n      true\\n    } else trait_defined(rest, name),\\n    EnvTraitImpl(_, _, rest) => trait_defined(rest, name),\\n    EnvTraitImplGen(_, _, _, _, rest) => trait_defined(rest, name),\\n    EnvFlat(_) => false,\\n    EnvCached(_, rest) => trait_defined(rest, name)\\n  }\\n}\\n\\nexport fn type_to_string(ty: Type) -> String {\\n  match ty {\\n    CtInt => \\\"Int\\\",\\n    CtDouble => \\\"Double\\\",\\n    CtBool => \\\"Bool\\\",\\n    CtString => \\\"String\\\",\\n    CtChar => \\\"Char\\\",\\n    CtUnit => \\\"()\\\",\\n    CtBytes => \\\"Bytes\\\",\\n    CtVar(id) => \\\"?t\\\\{id}\\\",\\n    CtForAll(vars, _, body) => {\\n      let vlen = Array::length(vars)\\n      let mut vi = 0\\n      let mut vacc = \\\"\\\"\\n      while vi < vlen {\\n        let v = String::concat(\\\"?t\\\", __to_string(Array::get(vars, vi)))\\n        let next = if vi > 0 {\\n          String::concat(vacc, String::concat(\\\" \\\", v))\\n        } else v\\n        vacc = next\\n        vi = vi + 1\\n      }\\n      String::concat(\\\"forall \\\", String::concat(vacc, String::concat(\\\". \\\", type_to_string(body))))\\n    },\\n    CtUnknown => \\\"?\\\",\\n    CtArray(elem) => String::concat(\\\"Array[\\\", String::concat(type_to_string(elem), \\\"]\\\")),\\n    CtOption(elem) => String::concat(\\\"Option[\\\", String::concat(type_to_string(elem), \\\"]\\\")),\\n    CtEnum(name) => name,\\n    CtStruct(name) => name,\\n    CtNamed(name, args) => if Array::length(args) == 0 {\\n      name\\n    } else {\\n      let parts = for arg in args {\\n        type_to_string(arg)\\n      }\\n      let mut i = 0\\n      let mut joined = \\\"\\\"\\n      while i < Array::length(parts) {\\n        joined = if i > 0 {\\n          String::concat(joined, String::concat(\\\", \\\", Array::get(parts, i)))\\n        } else Array::get(parts, i)\\n        i = i + 1\\n      }\\n      String::concat(name, String::concat(\\\"[\\\", String::concat(joined, \\\"]\\\")))\\n    },\\n    CtTuple(elems) => {\\n      let parts = for e in elems {\\n        type_to_string(e)\\n      }\\n      let mut i = 0\\n      let mut joined = \\\"\\\"\\n      while i < Array::length(parts) {\\n        joined = if i > 0 {\\n          String::concat(joined, String::concat(\\\", \\\", Array::get(parts, i)))\\n        } else Array::get(parts, i)\\n        i = i + 1\\n      }\\n      String::concat(\\\"(\\\", String::concat(joined, \\\")\\\"))\\n    },\\n    CtFn(params, ret, effect_name) => {\\n      let parts = for p in params {\\n        type_to_string(p)\\n      }\\n      let mut i = 0\\n      let mut joined = \\\"\\\"\\n      while i < Array::length(parts) {\\n        joined = if i > 0 {\\n          String::concat(joined, String::concat(\\\", \\\", Array::get(parts, i)))\\n        } else Array::get(parts, i)\\n        i = i + 1\\n      }\\n      let ret_text = type_to_string(ret)\\n      let base = String::concat(\\\"(\\\", String::concat(joined, String::concat(\\\") -> \\\", ret_text)))\\n      match effect_name {\\n        Some(name) => String::concat(base, String::concat(\\\" with {\\\", String::concat(name, \\\"}\\\"))),\\n        None => base\\n      }\\n    }\\n  }\\n}\\n\\nfn empty_type_args() -> Array[Type] {\\n  Array::slice([\\n    CtUnknown\\n  ], 0, 0)\\n}\\n\\nexport fn env_lookup_flat(bindings: Array[(String, Type)], name: String) -> Option[Type] {\\n  let len = Array::length(bindings)\\n  let mut i = 0\\n  let mut result = None\\n  let mut done = false\\n  while !done {\\n    if i >= len {\\n      done = true\\n    } else {\\n      let (n, ty) = Array::get(bindings, i)\\n      if n == name {\\n        result = Some(ty)\\n        done = true\\n      } else {\\n        i = i + 1\\n      }\\n    }\\n  }\\n  result\\n}\\n\\nexport fn resolve_builtin(name: String) -> Option[Type] {\\n  if name == \\\"Int\\\" || name == \\\"i32\\\" {\\n    Some(CtInt)\\n  }\\n  else if name == \\\"Double\\\" || name == \\\"f64\\\" || name == \\\"Float\\\" || name == \\\"f32\\\" {\\n    // The selfhost type system has no distinct 32-bit float: `Float` is\\n    // unified with `Double` (codegen is f64-only, and float literals such as\\n    // `0.0f` are already typed CtDouble). Without this, `Float` resolved to an\\n    // opaque CtNamed and `x < 0.0f` mismatched (Float vs Double).\\n    Some(CtDouble)\\n  }\\n  else if name == \\\"Bool\\\" {\\n    Some(CtBool)\\n  }\\n  else if name == \\\"String\\\" {\\n    Some(CtString)\\n  }\\n  else if name == \\\"Char\\\" {\\n    Some(CtChar)\\n  }\\n  else if name == \\\"Unit\\\" {\\n    Some(CtUnit)\\n  }\\n  else if name == \\\"Bytes\\\" {\\n    Some(CtBytes)\\n  }\\n  else if name == \\\"V128\\\" {\\n    // #536: first-class WebAssembly 128-bit SIMD type. Represented structurally\\n    // as CtNamed(\\\"V128\\\", []) (no core Type enum variant), mirroring how\\n    // Future/Stream/Task are represented; a V128 value is a tagged pointer to a\\n    // 16-byte heap box (see codegen in compile_call.vibe).\\n    Some(CtNamed(\\\"V128\\\", empty_type_args()))\\n  }\\n  else if name == \\\"i64\\\"\\n  || name == \\\"u8\\\"\\n  || name == \\\"u16\\\"\\n  || name == \\\"u32\\\"\\n  || name == \\\"u64\\\"\\n  || name == \\\"i16\\\"\\n  || name == \\\"v128\\\" {\\n    Some(CtNamed(name, empty_type_args()))\\n  }\\n  else None\\n}\\n\\nexport fn subst_add_bound(s: Subst, id: Int, bounds: Array[String]) -> Subst {\\n  SubstBound(id, bounds, s)\\n}\\n\\nfn empty_var_bounds() -> Array[(Int, Array[String])] {\\n  Array::slice([\\n    (0, Array::slice([\\n      \\\"\\\"\\n    ], 0, 0))\\n  ], 0, 0)\\n}\\n\\nfn int_bounds_has_id(pairs: Array[(Int, Array[String])], id: Int, i: Int) -> Bool {\\n  if i >= Array::length(pairs) {\\n    false\\n  } else {\\n    let (pid, _) = Array::get(pairs, i)\\n    if pid == id {\\n      true\\n    } else {\\n      int_bounds_has_id(pairs, id, i + 1)\\n    }\\n  }\\n}\\n\\nfn int_bounds_lookup(pairs: Array[(Int, Array[String])], id: Int, i: Int) -> Array[String] {\\n  if i >= Array::length(pairs) {\\n    Array::slice([\\n      \\\"\\\"\\n    ], 0, 0)\\n  } else {\\n    let (pid, bounds) = Array::get(pairs, i)\\n    if pid == id {\\n      bounds\\n    } else {\\n      int_bounds_lookup(pairs, id, i + 1)\\n    }\\n  }\\n}\\n\\nfn int_int_lookup_or(pairs: Array[(Int, Int)], key: Int, fallback: Int, i: Int) -> Int {\\n  if i >= Array::length(pairs) {\\n    fallback\\n  } else {\\n    let (k, v) = Array::get(pairs, i)\\n    if k == key {\\n      v\\n    } else {\\n      int_int_lookup_or(pairs, key, fallback, i + 1)\\n    }\\n  }\\n}\\n\\n// #626 criterion 4: collect the distinct effect-VARIABLE names appearing in a\\n// type scheme body (lone `with { e }` annotations), so `instantiate` can mint a\\n// fresh variable per use site and effect polymorphism survives unification.\\nfn collect_effect_vars_walk(t: Type, out: Array[String]) -> Int {\\n  match t {\\n    CtFn(params, ret, eff) => {\\n      match eff {\\n        Some(name) => if is_effect_var_name(name) {\\n          let mut seen = false\\n          let mut k = 0\\n          while k < Array::length(out) {\\n            if Array::get(out, k) == name {\\n              seen = true\\n            }\\n            k = k + 1\\n          }\\n          if !seen {\\n            Array::push(out, name)\\n          }\\n        },\\n        None => ()\\n      }\\n      for p in params {\\n        let _ = collect_effect_vars_walk(p, out)\\n      }\\n      collect_effect_vars_walk(ret, out)\\n    },\\n    CtArray(elem) => collect_effect_vars_walk(elem, out),\\n    CtOption(elem) => collect_effect_vars_walk(elem, out),\\n    CtTuple(elems) => {\\n      for e in elems {\\n        let _ = collect_effect_vars_walk(e, out)\\n      }\\n      0\\n    },\\n    CtNamed(_, args) => {\\n      for a in args {\\n        let _ = collect_effect_vars_walk(a, out)\\n      }\\n      0\\n    },\\n    CtForAll(_, _, body) => collect_effect_vars_walk(body, out),\\n    _ => 0\\n  }\\n}\\n\\nfn rename_eff_name(name: String, pairs: Array[(String, String)]) -> String {\\n  let mut i = 0\\n  let mut out = name\\n  while i < Array::length(pairs) {\\n    let (k, v) = Array::get(pairs, i)\\n    if k == name {\\n      out = v\\n    }\\n    i = i + 1\\n  }\\n  out\\n}\\n\\nfn rename_effect_vars(t: Type, pairs: Array[(String, String)]) -> Type {\\n  match t {\\n    CtFn(params, ret, eff) => {\\n      let new_params = Array::slice([\\n        CtUnknown\\n      ], 0, 0)\\n      let mut i = 0\\n      while i < Array::length(params) {\\n        Array::push(new_params, rename_effect_vars(Array::get(params, i), pairs))\\n        i = i + 1\\n      }\\n      let new_eff = match eff {\\n        Some(name) => Some(rename_eff_name(name, pairs)),\\n        None => None\\n      }\\n      CtFn(new_params, rename_effect_vars(ret, pairs), new_eff)\\n    },\\n    CtArray(elem) => CtArray(rename_effect_vars(elem, pairs)),\\n    CtOption(elem) => CtOption(rename_effect_vars(elem, pairs)),\\n    CtTuple(elems) => {\\n      let out = Array::slice([\\n        CtUnknown\\n      ], 0, 0)\\n      let mut i = 0\\n      while i < Array::length(elems) {\\n        Array::push(out, rename_effect_vars(Array::get(elems, i), pairs))\\n        i = i + 1\\n      }\\n      CtTuple(out)\\n    },\\n    CtNamed(name, args) => {\\n      let out = Array::slice([\\n        CtUnknown\\n      ], 0, 0)\\n      let mut i = 0\\n      while i < Array::length(args) {\\n        Array::push(out, rename_effect_vars(Array::get(args, i), pairs))\\n        i = i + 1\\n      }\\n      CtNamed(name, out)\\n    },\\n    _ => t\\n  }\\n}\\n\\nexport fn instantiate(ty: Type, c: Int) -> (Type, Int, Array[(Int, Array[String])]) {\\n  match ty {\\n    CtForAll(bound_vars, var_bounds, body) => {\\n      let blen = Array::length(bound_vars)\\n      let id_map = Array::slice([\\n        (0, 0)\\n      ], 0, 0)\\n      let mut bi = 0\\n      let mut bacc = SubstEmpty\\n      // #743: fresh ids must not overlap the scheme's OLD bound ids. An\\n      // IMPORTED scheme carries bound-var ids from the EXPORTING module's\\n      // counter domain (FS-compile checks modules separately and caches\\n      // their envs), so the importing module's counter c can be ≤ an old id.\\n      // A fresh id equal to another old bound id makes subst_apply's\\n      // transitive var resolution chain old→fresh→fresh' and COLLAPSES two\\n      // distinct scheme vars into one — `Err` from the prelude instantiated\\n      // as `(E) -> Result[E, E]` whenever exactly one extra type var had\\n      // been allocated before the use site (json_parse's #743).\\n      let mut bnc = c\\n      let mut bmax_i = 0\\n      while bmax_i < blen {\\n        let bold = Array::get(bound_vars, bmax_i)\\n        if bold >= bnc {\\n          bnc = bold + 1\\n        } else {\\n          ()\\n        }\\n        bmax_i = bmax_i + 1\\n      }\\n      while bi < blen {\\n        let old_id = Array::get(bound_vars, bi)\\n        Array::push(id_map, (old_id, bnc))\\n        bacc = SubstBind(old_id, CtVar(bnc), bacc)\\n        bnc = bnc + 1\\n        bi = bi + 1\\n      }\\n      let inst_s = bacc\\n      let id_map2 = id_map\\n      let c1 = bnc\\n      let new_bounds = Array::slice([\\n        (0, Array::slice([\\n          \\\"\\\"\\n        ], 0, 0))\\n      ], 0, 0)\\n      for var_bound in var_bounds {\\n        let (old_id, bounds) = var_bound\\n        let new_id = int_int_lookup_or(id_map2, old_id, old_id, 0)\\n        Array::push(new_bounds, (new_id, bounds))\\n      };\\n      let inst_body = subst_apply(inst_s, body)\\n      // #626 criterion 4: freshen the scheme's effect variables so each use site\\n      // gets its own variable. Without this, binding `e` at one call site would\\n      // leak to every other call (effect polymorphism would collapse to the\\n      // first concrete effect). Fresh names are `$<counter>` (never a real\\n      // effect name), threaded through the same counter as type variables.\\n      let eff_vars = Array::slice([\\n        \\\"\\\"\\n      ], 0, 0)\\n      let _ = collect_effect_vars_walk(inst_body, eff_vars)\\n      let eff_pairs = Array::slice([\\n        (\\\"\\\", \\\"\\\")\\n      ], 0, 0)\\n      let mut ev_i = 0\\n      let mut ev_c = c1\\n      while ev_i < Array::length(eff_vars) {\\n        let ev = Array::get(eff_vars, ev_i)\\n        Array::push(eff_pairs, (ev, String::concat(\\\"$\\\", __to_string(ev_c))))\\n        ev_c = ev_c + 1\\n        ev_i = ev_i + 1\\n      }\\n      let final_body = if Array::length(eff_pairs) == 0 {\\n        inst_body\\n      } else {\\n        rename_effect_vars(inst_body, eff_pairs)\\n      }\\n      (final_body, ev_c, new_bounds)\\n    },\\n    _ => (ty, c, empty_var_bounds())\\n  }\\n}\\n\\nexport fn trait_is_subtrait(env: TypeEnv, sub: String, super_name: String) -> Bool {\\n  if sub == super_name {\\n    true\\n  }\\n  else {\\n    let supers = trait_supers(env, sub)\\n    let slen = Array::length(supers)\\n    let mut si = 0\\n    let mut sresult = false\\n    let mut sdone = false\\n    while !sdone {\\n      if si >= slen {\\n        sdone = true\\n      } else {\\n        let s = Array::get(supers, si)\\n        if s == super_name {\\n          sresult = true\\n          sdone = true\\n        } else if trait_is_subtrait(env, s, super_name) {\\n          sresult = true\\n          sdone = true\\n        } else {\\n          si = si + 1\\n        }\\n      }\\n    }\\n    sresult\\n  }\\n}\\n\\nfn collect_tvars_walk(t: Type, out: Array[Int]) -> Int {\\n  match t {\\n    CtVar(id) => {\\n      if !array_has_int(out, id, 0) {\\n        Array::push(out, id)\\n      }\\n      0\\n    },\\n    CtFn(params, ret, _) => {\\n      for p in params {\\n        let _ = collect_tvars_walk(p, out)\\n      }\\n      collect_tvars_walk(ret, out)\\n    },\\n    CtArray(elem) => collect_tvars_walk(elem, out),\\n    CtOption(elem) => collect_tvars_walk(elem, out),\\n    CtTuple(elems) => {\\n      for e in elems {\\n        let _ = collect_tvars_walk(e, out)\\n      }\\n      0\\n    },\\n    // #829: type variables inside an APPLIED named type's arguments (e.g. the\\n    // `V` in `SortedMap[K, V]` when only `K` is mentioned by a parameter) must\\n    // be quantified too. They used to be skipped, leaving the scheme with a\\n    // FREE variable whose id is from the exporting module's counter domain —\\n    // an id-collision landmine (#743's hazard, but for free vars, which\\n    // `instantiate` does not rename): once generic struct types became real\\n    // (`CtNamed(S, args)` instead of CtUnknown), a collision bound an\\n    // importing module's own type param through the shared free var.\\n    CtNamed(_, args) => {\\n      for a in args {\\n        let _ = collect_tvars_walk(a, out)\\n      }\\n      0\\n    },\\n    CtForAll(_, _, body) => collect_tvars_walk(body, out),\\n    _ => 0\\n  }\\n}\\n\\nexport fn collect_tvars(ty: Type) -> Array[Int] {\\n  let out = Array::slice([\\n    0\\n  ], 0, 0)\\n  let _ = collect_tvars_walk(ty, out)\\n  out\\n}\\n\\nfn empty_env_bindings() -> Array[(String, Type)] {\\n  Array::slice([\\n    (\\\"\\\", CtUnknown)\\n  ], 0, 0)\\n}\\n\\nexport fn env_flat_bindings(env: TypeEnv) -> Array[(String, Type)] {\\n  match env {\\n    EnvFlat(bindings) => bindings,\\n    _ => {\\n      let out = empty_env_bindings()\\n      let mut cur = env\\n      let mut done = false\\n      while !done {\\n        match cur {\\n          EnvEmpty => {\\n            done = true\\n          },\\n          EnvBind(name, ty, rest) => {\\n            Array::push(out, (name, ty))\\n            cur = rest\\n          },\\n          EnvTraitDef(_, _, _, _, rest) => {\\n            cur = rest\\n          },\\n          EnvTraitImpl(_, _, rest) => {\\n            cur = rest\\n          },\\n          EnvTraitImplGen(_, _, _, _, rest) => {\\n            cur = rest\\n          },\\n          EnvFlat(bindings) => {\\n            let mut j = 0\\n            while j < Array::length(bindings) {\\n              Array::push(out, Array::get(bindings, j))\\n              j = j + 1\\n            }\\n            done = true\\n          },\\n          EnvCached(_, rest) => {\\n            cur = rest\\n          }\\n        }\\n      }\\n      out\\n    }\\n  }\\n}\\n\\nfn string_array_equal(left: Array[String], right: Array[String]) -> Bool {\\n  let len = Array::length(left)\\n  let mut i = 0\\n  let mut result = true\\n  let mut done = false\\n  while !done {\\n    if i >= len {\\n      done = true\\n    } else if Array::get(left, i) != Array::get(right, i) {\\n      result = false\\n      done = true\\n    } else {\\n      i = i + 1\\n    }\\n  }\\n  result\\n}\\n\\nfn option_string_equal(left: Option[String], right: Option[String]) -> Bool {\\n  match left {\\n    Some(left_name) => match right {\\n      Some(right_name) => left_name == right_name,\\n      None => false\\n    },\\n    None => match right {\\n      Some(_) => false,\\n      None => true\\n    }\\n  }\\n}\\n\\n// #626 criterion 3: an effect annotation `with { A, B }` is an unordered SET,\\n// but `collect_effect_names` joins it source-order into one string (\\\"A, B\\\"),\\n// so `{ A, B }` and `{ B, A }` serialize to different strings. Split the\\n// comma-separated annotation back into its labels (trimmed, deduplicated) so\\n// equality can be decided on the set, not the raw ordered string.\\nfn effect_label_list(eff: Option[String]) -> Array[String] {\\n  let out = Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n  match eff {\\n    None => out,\\n    Some(s) => {\\n      let raw = String::split(s, \\\",\\\")\\n      let mut i = 0\\n      while i < Array::length(raw) {\\n        let label = String::trim(Array::get(raw, i))\\n        if String::length(label) > 0 {\\n          let mut seen = false\\n          let mut j = 0\\n          while j < Array::length(out) {\\n            if Array::get(out, j) == label {\\n              seen = true\\n            }\\n            j = j + 1\\n          }\\n          if !seen {\\n            Array::push(out, label)\\n          }\\n        }\\n        i = i + 1\\n      }\\n      out\\n    }\\n  }\\n}\\n\\nfn effect_label_sets_equal(left: Option[String], right: Option[String]) -> Bool {\\n  let ls = effect_label_list(left)\\n  let rs = effect_label_list(right)\\n  if Array::length(ls) != Array::length(rs) {\\n    false\\n  } else {\\n    let mut i = 0\\n    let mut ok = true\\n    while i < Array::length(ls) {\\n      let label = Array::get(ls, i)\\n      let mut found = false\\n      let mut j = 0\\n      while j < Array::length(rs) {\\n        if Array::get(rs, j) == label {\\n          found = true\\n        }\\n        j = j + 1\\n      }\\n      if !found {\\n        ok = false\\n      }\\n      i = i + 1\\n    }\\n    ok\\n  }\\n}\\n\\nfn effect_opt_is_var(eff: Option[String]) -> Bool {\\n  match eff {\\n    Some(name) => is_effect_var_name(name),\\n    None => false\\n  }\\n}\\n\\nfn effect_names_compatible(left: Option[String], right: Option[String]) -> Bool {\\n  if option_string_equal(left, right) {\\n    true\\n  } else if effect_opt_is_var(left) {\\n    // #626 criterion 4: an effect variable is NO LONGER a wildcard. It equals\\n    // only itself (handled by `option_string_equal` above); a variable vs a\\n    // different effect is reported NOT-equal here so that `unify`'s structural\\n    // `types_equal` fast path falls through to the `CtFn` arm, where\\n    // `unify_effects` records the actual binding (and detects a later conflict).\\n    false\\n  } else if effect_opt_is_var(right) {\\n    false\\n  } else {\\n    // Neither side is an effect variable: decide on the unordered label set, so\\n    // `{ A, B }` and `{ B, A }` (and `{ A, A }` vs `{ A }`) are compatible\\n    // (criterion 3). `None` (pure) vs `Some(concrete)` differ in set size and\\n    // stay incompatible.\\n    effect_label_sets_equal(left, right)\\n  }\\n}\\n\\n// Unify two effect annotations, binding an effect VARIABLE to the other side\\n// (#626 criterion 4 — no longer an unconditional wildcard). Returns the extended\\n// substitution, or None on a genuine effect-set conflict.\\nfn unify_effects(ea: Option[String], eb: Option[String], s: Subst) -> Option[Subst] {\\n  let ra = resolve_effect_opt(s, ea)\\n  let rb = resolve_effect_opt(s, eb)\\n  let a_is_var = match ra {\\n    Some(n) => is_effect_var_name(n),\\n    None => false\\n  }\\n  let b_is_var = match rb {\\n    Some(n) => is_effect_var_name(n),\\n    None => false\\n  }\\n  if a_is_var {\\n    match ra {\\n      Some(av) => if Some(av) == rb {\\n        Some(s)\\n      } else {\\n        let bval = match rb {\\n          Some(bv) => bv,\\n          None => \\\"\\\"\\n        }\\n        Some(SubstEffBind(av, bval, s))\\n      },\\n      None => Some(s)\\n    }\\n  } else if b_is_var {\\n    match rb {\\n      Some(bv) => {\\n        let aval = match ra {\\n          Some(av) => av,\\n          None => \\\"\\\"\\n        }\\n        Some(SubstEffBind(bv, aval, s))\\n      },\\n      None => Some(s)\\n    }\\n  } else if effect_names_compatible(ra, rb) {\\n    Some(s)\\n  } else {\\n    None\\n  }\\n}\\n\\nexport fn types_equal(a: Type, b: Type) -> Bool {\\n  match a {\\n    CtInt => match b {\\n      CtInt => true,\\n      _ => false\\n    },\\n    CtDouble => match b {\\n      CtDouble => true,\\n      _ => false\\n    },\\n    CtBool => match b {\\n      CtBool => true,\\n      _ => false\\n    },\\n    CtString => match b {\\n      CtString => true,\\n      _ => false\\n    },\\n    CtChar => match b {\\n      CtChar => true,\\n      _ => false\\n    },\\n    CtUnit => match b {\\n      CtUnit => true,\\n      _ => false\\n    },\\n    CtBytes => match b {\\n      CtBytes => true,\\n      _ => false\\n    },\\n    CtUnknown => match b {\\n      CtUnknown => true,\\n      _ => false\\n    },\\n    CtVar(aid) => match b {\\n      CtVar(bid) => (aid == bid),\\n      _ => false\\n    },\\n    CtArray(aelem) => match b {\\n      CtArray(belem) => types_equal(aelem, belem),\\n      _ => false\\n    },\\n    CtOption(aelem) => match b {\\n      CtOption(belem) => types_equal(aelem, belem),\\n      _ => false\\n    },\\n    CtEnum(aname) => match b {\\n      CtEnum(bname) => aname == bname,\\n      // A bare named type `CtNamed(X, [])` (zero type args) denotes the same\\n      // type as the enum `CtEnum(X)`. Cross-module imports can resolve a\\n      // self-referential enum ctor field type to one form and a function\\n      // annotation to the other; bridge them so they unify.\\n      CtNamed(bname, bargs) => aname == bname && Array::length(bargs) == 0,\\n      _ => false\\n    },\\n    CtStruct(aname) => match b {\\n      CtStruct(bname) => aname == bname,\\n      CtNamed(bname, bargs) => aname == bname && Array::length(bargs) == 0,\\n      _ => false\\n    },\\n    CtNamed(aname, aargs) => match b {\\n      CtEnum(bname) => aname == bname && Array::length(aargs) == 0,\\n      CtStruct(bname) => aname == bname && Array::length(aargs) == 0,\\n      CtNamed(bname, bargs) =>\\n      if aname != bname {\\n        false\\n      } else if Array::length(aargs) != Array::length(bargs) {\\n        false\\n      } else {\\n        let tae_len = Array::length(aargs)\\n        let mut tae_i = 0\\n        let mut tae_result = true\\n        let mut tae_done = false\\n        while !tae_done {\\n          if tae_i >= tae_len {\\n            tae_done = true\\n          } else {\\n            if types_equal(Array::get(aargs, tae_i), Array::get(bargs, tae_i)) {\\n              tae_i = tae_i + 1\\n            } else {\\n              tae_result = false\\n              tae_done = true\\n            }\\n          }\\n        }\\n        tae_result\\n      },\\n      _ => false\\n    },\\n    CtTuple(aelems) => match b {\\n      CtTuple(belems) =>\\n      if Array::length(aelems) != Array::length(belems) {\\n        false\\n      } else {\\n        let tae_len2 = Array::length(aelems)\\n        let mut tae_i2 = 0\\n        let mut tae_result2 = true\\n        let mut tae_done2 = false\\n        while !tae_done2 {\\n          if tae_i2 >= tae_len2 {\\n            tae_done2 = true\\n          } else {\\n            if types_equal(Array::get(aelems, tae_i2), Array::get(belems, tae_i2)) {\\n              tae_i2 = tae_i2 + 1\\n            } else {\\n              tae_result2 = false\\n              tae_done2 = true\\n            }\\n          }\\n        }\\n        tae_result2\\n      },\\n      _ => false\\n    },\\n    CtFn(aparams, aret, aeffect) => match b {\\n      CtFn(bparams, bret, beffect) =>\\n      if Array::length(aparams) != Array::length(bparams) {\\n        false\\n      } else if effect_names_compatible(aeffect, beffect) {\\n        let tae_len3 = Array::length(aparams)\\n        let mut tae_i3 = 0\\n        let mut tae_result3 = true\\n        let mut tae_done3 = false\\n        while !tae_done3 {\\n          if tae_i3 >= tae_len3 {\\n            tae_done3 = true\\n          } else {\\n            if types_equal(Array::get(aparams, tae_i3), Array::get(bparams, tae_i3)) {\\n              tae_i3 = tae_i3 + 1\\n            } else {\\n              tae_result3 = false\\n              tae_done3 = true\\n            }\\n          }\\n        }\\n        if tae_result3 {\\n          types_equal(aret, bret)\\n        } else {\\n          false\\n        }\\n      } else {\\n        false\\n      },\\n      _ => false\\n    },\\n    CtForAll(avars, abounds, abody) => match b {\\n      CtForAll(bvars, bbounds, bbody) => if Array::length(avars) != Array::length(bvars) {\\n        false\\n      } else if Array::length(abounds) != Array::length(bbounds) {\\n        false\\n      } else {\\n        let vlen = Array::length(avars)\\n        let mut vi = 0\\n        let mut vresult = true\\n        let mut vdone = false\\n        while !vdone {\\n          if vi >= vlen {\\n            vdone = true\\n          } else if Array::get(avars, vi) != Array::get(bvars, vi) {\\n            vresult = false\\n            vdone = true\\n          } else {\\n            vi = vi + 1\\n          }\\n        }\\n        if vresult {\\n          let fbe_len = Array::length(abounds)\\n          let mut fbe_i = 0\\n          let mut fbe_result = true\\n          let mut fbe_done = false\\n          while !fbe_done {\\n            if fbe_i >= fbe_len {\\n              fbe_done = true\\n            } else {\\n              let (lvar, lbounds) = Array::get(abounds, fbe_i)\\n              let (rvar, rbounds) = Array::get(bbounds, fbe_i)\\n              if lvar != rvar {\\n                fbe_result = false\\n                fbe_done = true\\n              } else if Array::length(lbounds) != Array::length(rbounds) {\\n                fbe_result = false\\n                fbe_done = true\\n              } else {\\n                if string_array_equal(lbounds, rbounds) {\\n                  fbe_i = fbe_i + 1\\n                } else {\\n                  fbe_result = false\\n                  fbe_done = true\\n                }\\n              }\\n            }\\n          }\\n          if fbe_result {\\n            types_equal(abody, bbody)\\n          } else {\\n            false\\n          }\\n        } else {\\n          false\\n        }\\n      }\\n      ,\\n      _ => false\\n    }\\n  }\\n}\\n\\n// `Char` is a transparent alias of `Int`: char literals (`'A'`) lex to integer\\n// tokens (TInt, see lexer.vibe lex_char), so a value of Char and a value of Int\\n// share one runtime representation and must unify freely — a `Char` annotation\\n// accepts an int value and vice versa (`'A' == 65`, `c + 1`, char_test).\\nfn char_int_compatible(ta: Type, tb: Type) -> Bool {\\n  match ta {\\n    CtChar => match tb {\\n      CtInt => true,\\n      _ => false\\n    },\\n    CtInt => match tb {\\n      CtChar => true,\\n      _ => false\\n    },\\n    _ => false\\n  }\\n}\\n\\n///|\\nexport fn unify(a: Type, b: Type, s: Subst) -> Option[Subst] {\\n  let ta = subst_apply(s, a)\\n  let tb = subst_apply(s, b)\\n  if types_equal(ta, tb) {\\n    Some(s)\\n  }\\n  else if char_int_compatible(ta, tb) {\\n    Some(s)\\n  }\\n  else match ta {\\n    CtVar(id) => if occurs_in(id, tb) {\\n      None\\n    } else Some(SubstBind(id, tb, s)),\\n    _ => match tb {\\n      CtVar(id) => if occurs_in(id, ta) {\\n        None\\n      } else Some(SubstBind(id, ta, s)),\\n      _ => match ta {\\n        CtUnknown => Some(s),\\n        _ => match tb {\\n          CtUnknown => Some(s),\\n          _ => match ta {\\n            CtForAll(_, _, body_a) => match tb {\\n              CtForAll(_, _, body_b) => unify(body_a, body_b, s),\\n              _ => unify(body_a, tb, s)\\n            },\\n            _ => match tb {\\n              CtForAll(_, _, body_b) => unify(ta, body_b, s),\\n              _ => match ta {\\n                CtArray(ea) => match tb {\\n                  CtArray(eb) => unify(ea, eb, s),\\n                  _ => None\\n                },\\n                CtOption(ea) => match tb {\\n                  CtOption(eb) => unify(ea, eb, s),\\n                  _ => None\\n                },\\n                CtFn(pa, ra, aeffect) => match tb {\\n                  CtFn(pb, rb, beffect) => if Array::length(pa) != Array::length(pb) {\\n                    None\\n                  }\\n                  else {\\n                    let ul_len = Array::length(pa)\\n                    let mut ul_i = 0\\n                    let mut ul_acc = s\\n                    let mut ul_result = Some(s)\\n                    let mut ul_done = false\\n                    while !ul_done {\\n                      if ul_i >= ul_len {\\n                        ul_result = Some(ul_acc)\\n                        ul_done = true\\n                      } else {\\n                        match unify(Array::get(pa, ul_i), Array::get(pb, ul_i), ul_acc) {\\n                          Some(s2) => {\\n                            ul_acc = s2\\n                            ul_i = ul_i + 1\\n                          },\\n                          None => {\\n                            ul_result = None\\n                            ul_done = true\\n                          }\\n                        }\\n                      }\\n                    }\\n                    // #626 criterion 4: unify params, then the return type, then\\n                    // the EFFECT row — binding an effect variable to the other\\n                    // side (or failing on a genuine effect conflict) instead of\\n                    // the old unconditional-wildcard accept.\\n                    match ul_result {\\n                      Some(s2) => match unify(ra, rb, s2) {\\n                        Some(s3) => unify_effects(aeffect, beffect, s3),\\n                        None => None\\n                      },\\n                      None => None\\n                    }\\n                  },\\n                  _ => None\\n                },\\n                CtTuple(ea) => match tb {\\n                  CtTuple(eb) => if Array::length(ea) != Array::length(eb) {\\n                    None\\n                  }\\n                  else {\\n                    let ul_len2 = Array::length(ea)\\n                    let mut ul_i2 = 0\\n                    let mut ul_acc2 = s\\n                    let mut ul_result2 = Some(s)\\n                    let mut ul_done2 = false\\n                    while !ul_done2 {\\n                      if ul_i2 >= ul_len2 {\\n                        ul_result2 = Some(ul_acc2)\\n                        ul_done2 = true\\n                      } else {\\n                        match unify(Array::get(ea, ul_i2), Array::get(eb, ul_i2), ul_acc2) {\\n                          Some(s2) => {\\n                            ul_acc2 = s2\\n                            ul_i2 = ul_i2 + 1\\n                          },\\n                          None => {\\n                            ul_result2 = None\\n                            ul_done2 = true\\n                          }\\n                        }\\n                      }\\n                    }\\n                    ul_result2\\n                  },\\n                  _ => None\\n                },\\n                CtEnum(a_name) => match tb {\\n                  CtEnum(b_name) => if a_name == b_name {\\n                    Some(s)\\n                  } else None,\\n                  // Bridge `CtEnum(X)` with `CtNamed(X, args)` of any arity: an\\n                  // enum VALUE carries no type args (constructors yield a bare\\n                  // CtEnum), so it must still unify by name with an applied\\n                  // annotation like `Result[U, E]`.\\n                  CtNamed(b_name, _) => if a_name == b_name {\\n                    Some(s)\\n                  } else None,\\n                  _ => None\\n                },\\n                CtStruct(a_name) => match tb {\\n                  CtStruct(b_name) => if a_name == b_name {\\n                    Some(s)\\n                  } else None,\\n                  // #829: a bare `CtStruct(S)` (unparameterized annotation /\\n                  // pre-bound structural fn signature) unifies by name with an\\n                  // INSTANTIATED `CtNamed(S, args)` of any arity — the bare\\n                  // form carries no argument information to conflict with,\\n                  // exactly like the CtEnum/CtNamed bridge below.\\n                  //\\n                  // #843 review follow-up (Codex P1): this bridge (both this\\n                  // arm and its mirror in the `CtNamed(a_name, _)` case below)\\n                  // lets a value's real #829-instantiated args get discarded\\n                  // when it flows through a bare annotation (`let x: Box =\\n                  // Box::{v:1}` types `x` as bare `Box`, forgetting `[Int]`),\\n                  // and a LATER, unrelated annotation can then silently\\n                  // re-narrow it (`let y: Box[String] = x; y.v` reads a\\n                  // stored Int as String) — this is a real, confirmed hole.\\n                  // It is NOT fixed by restricting the bridge's direction:\\n                  // call sites are inconsistent about which side is\\n                  // \\\"expected\\\" (`check_assignable(expected, actual, ..)` →\\n                  // `unify(expected, actual, ..)`, but the function-body\\n                  // return-type check calls `unify(body_ty, declared_ret,\\n                  // ..)` — actual FIRST) — a one-directional restriction here\\n                  // broke the legitimate mirror case instead (a trait `impl\\n                  // Trait for S { ... }` method's bare-`S`-typed return\\n                  // accepting a freshly `S::{...}`-constructed `S[X]`, gate\\n                  // section 18) without closing the hole (the erasure\\n                  // happens earlier, in the ascription-lambda / `let`\\n                  // annotation machinery that decides which of {declared,\\n                  // inferred} type to keep — not in `unify` itself). Full\\n                  // bridge restored pending a real fix (tracked in #844:\\n                  // thread fresh type vars through bare generic-struct\\n                  // annotations instead of erasing to `CtStruct`, so the\\n                  // annotation's own vars — not a name-only bridge — carry\\n                  // the value's real args forward).\\n                  CtNamed(b_name, _) => if a_name == b_name {\\n                    Some(s)\\n                  } else None,\\n                  _ => None\\n                },\\n                CtNamed(a_name, a_args) => match tb {\\n                  // Symmetric to the CtEnum bridge: an applied `CtNamed(X, args)`\\n                  // unifies with the bare enum value `CtEnum(X)` by name.\\n                  CtEnum(b_name) => if a_name == b_name {\\n                    Some(s)\\n                  } else None,\\n                  // #829: symmetric bridge — an applied `CtNamed(S, args)`\\n                  // unifies with the bare struct `CtStruct(S)` by name. See\\n                  // the long #843/#844 note on the `CtStruct(a_name)` arm\\n                  // above — restored (not narrowed) for the same reason.\\n                  CtStruct(b_name) => if a_name == b_name {\\n                    Some(s)\\n                  } else None,\\n                  CtNamed(b_name, b_args) => if a_name != b_name {\\n                    None\\n                  }\\n                  else if Array::length(a_args) != Array::length(b_args) {\\n                    None\\n                  }\\n                  else {\\n                    let ul_len3 = Array::length(a_args)\\n                    let mut ul_i3 = 0\\n                    let mut ul_acc3 = s\\n                    let mut ul_result3 = Some(s)\\n                    let mut ul_done3 = false\\n                    while !ul_done3 {\\n                      if ul_i3 >= ul_len3 {\\n                        ul_result3 = Some(ul_acc3)\\n                        ul_done3 = true\\n                      } else {\\n                        match unify(Array::get(a_args, ul_i3), Array::get(b_args, ul_i3), ul_acc3) {\\n                          Some(s2) => {\\n                            ul_acc3 = s2\\n                            ul_i3 = ul_i3 + 1\\n                          },\\n                          None => {\\n                            ul_result3 = None\\n                            ul_done3 = true\\n                          }\\n                        }\\n                      }\\n                    }\\n                    ul_result3\\n                  },\\n                  _ => None\\n                },\\n                _ => None\\n              }\\n            }\\n          }\\n        }\\n      }\\n    }\\n  }\\n}\\n\\nexport fn types_compatible(expected: Type, actual: Type) -> Bool {\\n  match expected {\\n    CtUnknown => true,\\n    _ => match actual {\\n      CtUnknown => true,\\n      _ => types_equal(expected, actual)\\n    }\\n  }\\n}\\n\\nexport fn impls_overlap_for(env: TypeEnv, trait_name: String, new_target: Type) -> Bool {\\n  match env {\\n    EnvEmpty => false,\\n    EnvBind(_, _, rest) => impls_overlap_for(rest, trait_name, new_target),\\n    EnvTraitDef(_, _, _, _, rest) => impls_overlap_for(rest, trait_name, new_target),\\n    EnvTraitImpl(tname, target, rest) => if tname == trait_name {\\n      if types_equal(target, new_target) {\\n        true\\n      }\\n      else impls_overlap_for(rest, trait_name, new_target)\\n    } else impls_overlap_for(rest, trait_name, new_target),\\n    EnvTraitImplGen(_, _, _, _, rest) => impls_overlap_for(rest, trait_name, new_target),\\n    EnvFlat(_) => false,\\n    EnvCached(_, rest) => impls_overlap_for(rest, trait_name, new_target)\\n  }\\n}\\n\\n// #829: an `impl Trait for S` stores its target with the type arguments\\n// ERASED (the SImpl handler registers `CtNamed(S, [])` / `CtStruct(S)`), but\\n// an instantiated generic struct value is now typed `CtNamed(S, args)`.\\n// Bridge the two by head name — the unparameterized impl covers every\\n// instantiation — mirroring the CtEnum/CtNamed unify bridge.\\nfn struct_impl_target_matches(target: Type, resolved: Type) -> Bool {\\n  match resolved {\\n    CtNamed(rname, rargs) => if Array::length(rargs) > 0 {\\n      match target {\\n        CtStruct(tname) => tname == rname,\\n        CtNamed(tname, targs) => tname == rname && Array::length(targs) == 0,\\n        _ => false\\n      }\\n    } else {\\n      false\\n    },\\n    _ => false\\n  }\\n}\\n\\nfn type_implements_check_env(e: TypeEnv, trait_name: String, resolved: Type) -> Bool {\\n  match e {\\n    EnvEmpty => false,\\n    EnvBind(_, _, rest) => type_implements_check_env(rest, trait_name, resolved),\\n    EnvTraitDef(_, _, _, _, rest) => type_implements_check_env(rest, trait_name, resolved),\\n    EnvTraitImpl(tname, target, rest) => if tname == trait_name {\\n      if types_equal(target, resolved) || struct_impl_target_matches(target, resolved) {\\n        true\\n      }\\n      else type_implements_check_env(rest, trait_name, resolved)\\n    } else type_implements_check_env(rest, trait_name, resolved),\\n    EnvTraitImplGen(_, _, _, _, rest) => type_implements_check_env(rest, trait_name, resolved),\\n    EnvFlat(_) => false,\\n    EnvCached(_, rest) => type_implements_check_env(rest, trait_name, resolved)\\n  }\\n}\\n\\nexport fn collect_subst_bounds_pairs(s: Subst) -> Array[(Int, Array[String])] {\\n  let out = Array::slice([\\n    (0, Array::slice([\\n      \\\"\\\"\\n    ], 0, 0))\\n  ], 0, 0)\\n  let mut cur = s\\n  let mut done = false\\n  while !done {\\n    match cur {\\n      SubstEmpty => {\\n        done = true\\n      },\\n      SubstBind(_, _, rest) => {\\n        cur = rest\\n      },\\n      SubstBound(id, bounds, rest) => {\\n        if !int_bounds_has_id(out, id, 0) {\\n          Array::push(out, (id, bounds))\\n        }\\n        cur = rest\\n      },\\n      SubstCached(_, _, rest) => {\\n        cur = rest\\n      },\\n      SubstEffBind(_, _, rest) => {\\n        cur = rest\\n      }\\n    }\\n  }\\n  out\\n}\\n\\nexport fn generalize(s: Subst, ty: Type) -> Type {\\n  let resolved = subst_apply(s, ty)\\n  let tvars = collect_tvars(resolved)\\n  if Array::length(tvars) == 0 {\\n    resolved\\n  }\\n  else {\\n    let bounds_pairs = collect_subst_bounds_pairs(s)\\n    let var_bounds = Array::slice([\\n      (0, Array::slice([\\n        \\\"\\\"\\n      ], 0, 0))\\n    ], 0, 0)\\n    for vid in tvars {\\n      let bounds = int_bounds_lookup(bounds_pairs, vid, 0)\\n      if Array::length(bounds) != 0 {\\n        Array::push(var_bounds, (vid, bounds))\\n      }\\n    }\\n    CtForAll(tvars, var_bounds, resolved)\\n  }\\n}\\n\\nfn type_implements_check_super(e2: TypeEnv, full_env: TypeEnv, trait_name: String, resolved: Type) -> Bool {\\n  match e2 {\\n    EnvEmpty => false,\\n    EnvBind(_, _, rest) => type_implements_check_super(rest, full_env, trait_name, resolved),\\n    EnvTraitDef(_, _, _, _, rest) => type_implements_check_super(rest, full_env, trait_name, resolved),\\n    EnvTraitImpl(tname, target, rest) => if types_equal(target, resolved) || struct_impl_target_matches(target, resolved) {\\n      if trait_is_subtrait(full_env, tname, trait_name) {\\n        true\\n      }\\n      else type_implements_check_super(rest, full_env, trait_name, resolved)\\n    } else type_implements_check_super(rest, full_env, trait_name, resolved),\\n    EnvTraitImplGen(_, _, _, _, rest) => type_implements_check_super(rest, full_env, trait_name, resolved),\\n    EnvFlat(_) => false,\\n    EnvCached(_, rest) => type_implements_check_super(rest, full_env, trait_name, resolved)\\n  }\\n}\\n\\n// Constructor/head name of a type, for matching a generic impl's erased target\\n// against a concrete type (`Array[Int]` and the impl target `Array` both have\\n// head \\\"Array\\\"). Returns \\\"\\\" for types with no nominal constructor (tuples,\\n// primitives, vars) so they never match a generic impl.\\nfn type_constructor_name(ty: Type) -> String {\\n  match ty {\\n    CtArray(_) => \\\"Array\\\",\\n    CtOption(_) => \\\"Option\\\",\\n    CtNamed(n, _) => n,\\n    CtStruct(n) => n,\\n    CtEnum(n) => n,\\n    _ => \\\"\\\"\\n  }\\n}\\n\\n// True iff `trait_name` declares at least one method (a method-bearing trait).\\n// Marker traits (Eq/Ord/Add/…, declared `trait Eq` with no body) and undeclared\\n// bound names (e.g. `Iterable`) return false. This is the soundness gate for\\n// generic-impl resolution: a method-bearing trait dispatches through the threaded\\n// witness dictionary (so a generic impl runs the correct per-type method),\\n// whereas a marker trait \\\"dispatches\\\" via a builtin operator (`==`, `<`) that\\n// does NOT structurally handle a container — so matching a marker-trait generic\\n// impl would let `==` be used on e.g. `Option[Int]` where it silently misbehaves.\\nfn trait_is_method_bearing(env: TypeEnv, trait_name: String) -> Bool {\\n  match env {\\n    EnvEmpty => false,\\n    EnvBind(_, _, rest) => trait_is_method_bearing(rest, trait_name),\\n    EnvTraitDef(tname, _, _, methods, rest) => if tname == trait_name {\\n      Array::length(methods) > 0\\n    } else trait_is_method_bearing(rest, trait_name),\\n    EnvTraitImpl(_, _, rest) => trait_is_method_bearing(rest, trait_name),\\n    EnvTraitImplGen(_, _, _, _, rest) => trait_is_method_bearing(rest, trait_name),\\n    EnvFlat(_) => false,\\n    EnvCached(_, rest) => trait_is_method_bearing(rest, trait_name)\\n  }\\n}\\n\\n// True iff a type-parameter bound list carries no real trait bound (only the\\n// empty / `\\\"\\\"` sentinel entries). Increment A of generic-impl support matches\\n// the per-parameter trait bounds of a generic impl. Increment A (`impl [T]\\n// Trait for C`) has empty bounds; Increment B (`impl [T: Bound] Trait for\\n// C[T]`) carries them and is satisfied only when every type argument of the\\n// concrete type satisfies them — a dictionary-of-dictionaries: `C[K]: Trait`\\n// iff `K: Bound`.\\n\\n// Type arguments of a (possibly generic) type, for checking a generic impl's\\n// per-parameter bounds against the concrete element types.\\nfn type_args_of(ty: Type) -> Array[Type] {\\n  match ty {\\n    CtArray(e) => Array::slice([\\n      e\\n    ], 0, 1),\\n    CtOption(e) => Array::slice([\\n      e\\n    ], 0, 1),\\n    CtNamed(_, args) => args,\\n    _ => Array::slice([\\n      CtUnit\\n    ], 0, 0)\\n  }\\n}\\n\\n// Does an in-env method-bearing generic impl `impl [T(: Bound)?] Trait for C`\\n// cover the concrete `resolved` type? Matched by constructor name (the impl\\n// target's args are erased); for a bounded impl, EVERY type argument of\\n// `resolved` must satisfy EVERY bound (recursively via `type_implements_trait`),\\n// which is the dictionary-of-dictionaries condition. The dict-passing desugar\\n// synthesizes a `{ method: C::method }` witness (unbounded) or a nested closure\\n// witness supplying the element dict (bounded). (#5 generic impls.)\\nfn generic_impl_satisfies(scan: TypeEnv, full: TypeEnv, s: Subst, trait_name: String, resolved: Type) -> Bool {\\n  match scan {\\n    EnvEmpty => false,\\n    EnvBind(_, _, rest) => generic_impl_satisfies(rest, full, s, trait_name, resolved),\\n    EnvTraitDef(_, _, _, _, rest) => generic_impl_satisfies(rest, full, s, trait_name, resolved),\\n    EnvTraitImpl(_, _, rest) => generic_impl_satisfies(rest, full, s, trait_name, resolved),\\n    EnvTraitImplGen(itrait, _tparams, bounds, target, rest) => {\\n      let head = type_constructor_name(resolved)\\n      let shape_ok = itrait == trait_name && head != \\\"\\\" && type_constructor_name(target) == head && trait_is_method_bearing(full, trait_name)\\n      if shape_ok && generic_bounds_hold(full, s, bounds, type_args_of(resolved)) {\\n        true\\n      } else generic_impl_satisfies(rest, full, s, trait_name, resolved)\\n    },\\n    EnvFlat(_) => false,\\n    EnvCached(_, rest) => generic_impl_satisfies(rest, full, s, trait_name, resolved)\\n  }\\n}\\n\\n// Every non-empty per-parameter bound is satisfied by every concrete type\\n// argument. Empty bound lists (Increment A) hold trivially.\\nfn generic_bounds_hold(full: TypeEnv, s: Subst, bounds: Array[(String, Array[String])], args: Array[Type]) -> Bool {\\n  let mut bi = 0\\n  let mut ok = true\\n  while bi < Array::length(bounds) {\\n    let (_, btraits) = Array::get(bounds, bi)\\n    let mut ti = 0\\n    while ti < Array::length(btraits) {\\n      let bt = Array::get(btraits, ti)\\n      if bt != \\\"\\\" {\\n        let mut ai = 0\\n        while ai < Array::length(args) {\\n          // A still-unknown element type (e.g. a struct literal, which the\\n          // checker types as `CtUnknown`) defers its bound to the dict-passing\\n          // desugar — which infers the element type syntactically and either\\n          // threads the nested witness or fails loudly. This mirrors how a\\n          // `CtUnknown` receiver skips the top-level bound check, so accepting\\n          // it here is no less sound.\\n          match subst_apply(s, Array::get(args, ai)) {\\n            CtUnknown => (),\\n            _ => if not(type_implements_trait(full, s, Array::get(args, ai), bt)) {\\n              ok = false\\n            } else {\\n              ()\\n            }\\n          }\\n          ai = ai + 1\\n        }\\n      } else {\\n        ()\\n      }\\n      ti = ti + 1\\n    }\\n    bi = bi + 1\\n  }\\n  ok\\n}\\n\\nexport fn type_implements_trait(env: TypeEnv, s: Subst, ty: Type, trait_name: String) -> Bool {\\n  let resolved = subst_apply(s, ty)\\n  if type_implements_check_env(env, trait_name, resolved) {\\n    true\\n  }\\n  else if generic_impl_satisfies(env, env, s, trait_name, resolved) {\\n    true\\n  }\\n  else {\\n    let supers = trait_supers(env, trait_name)\\n    let slen = Array::length(supers)\\n    if slen == 0 {\\n      false\\n    }\\n    else {\\n      type_implements_check_super(env, env, trait_name, resolved)\\n    }\\n  }\\n}\\n\")\n}\n\nlet cli_adapter_source_19 = () -> (String, String) {\n  (\"lib/@vibe/compiler/core/dce.vibe\",\n\"//# Imports\\n\\nimport ./ast.vibe {\\n  Expr, Pat, Stmt, TypeExpr\\n}\\n\\n//# Functions\\n\\nfn clone_arr(arr: Array[String]) -> Array[String] {\\n  Array::slice(arr, 0, Array::length(arr))\\n}\\n\\nfn stmt_name(stmt: Stmt) -> Option[String] {\\n  match stmt {\\n    SLet(_, _, name, _, _) => Some(name),\\n    // Preserved `fn` declaration (ADR-0064 #727): a value binding for DCE\\n    // purposes, exactly like the SLet it lowers to.\\n    SFnDecl(_, name, _, _, _) => Some(name),\\n    SLetMut(name, _, _) => Some(name),\\n    _ => None\\n  }\\n}\\n\\nfn dce_array_contains_str(arr: Array[String], s: String) -> Bool {\\n  let len = Array::length(arr)\\n  let rec search: (Int) -> Bool = (i) -> {\\n    if i >= len {\\n      false\\n    }\\n    else if Array::get(arr, i) == s {\\n      true\\n    }\\n    else search(i + 1)\\n  }\\n  search(0)\\n}\\n\\nfn add_ref(out: Array[String], bound: Array[String], name: String) -> Int {\\n  if not(dce_array_contains_str(bound, name)) {\\n    if not(dce_array_contains_str(out, name)) {\\n      Array::push(out, name)\\n    }\\n  }\\n  0\\n}\\n\\nfn collect_pat_bindings(pat: Pat, bound: Array[String]) -> Int {\\n  match pat {\\n    PWild => 0,\\n    PBind(name) => {\\n      Array::push(bound, name)\\n      0\\n    },\\n    PInt(_) => 0,\\n    PFloat(_) => 0,\\n    PString(_) => 0,\\n    PBool(_) => 0,\\n    PCtor(_, pats) => {\\n      let mut i = 0\\n      while i < Array::length(pats) {\\n        collect_pat_bindings(Array::get(pats, i), bound)\\n        i = i + 1\\n      }\\n      0\\n    },\\n    PTuple(pats) => {\\n      let mut i = 0\\n      while i < Array::length(pats) {\\n        collect_pat_bindings(Array::get(pats, i), bound)\\n        i = i + 1\\n      }\\n      0\\n    },\\n    POr(p1, p2) => {\\n      collect_pat_bindings(p1, bound)\\n      collect_pat_bindings(p2, bound)\\n      0\\n    },\\n    PStruct(_, _) => 0\\n  }\\n}\\n\\nfn collect_refs_into(expr: Expr, bound: Array[String], out: Array[String]) -> Int {\\n  match expr {\\n    EIdent(name, _) => add_ref(out, bound, name),\\n    EInt(_) => 0,\\n    EFloat(_) => 0,\\n    EString(_) => 0,\\n    EBool(_) => 0,\\n    EUnit => 0,\\n    EBreak(_) => 0,\\n    EContinue(_) => 0,\\n    EReturn(e) => collect_refs_into(e, bound, out),\\n    EUnaryOp(_, e) => collect_refs_into(e, bound, out),\\n    ETuple(items) => {\\n      let mut i = 0\\n      while i < Array::length(items) {\\n        collect_refs_into(Array::get(items, i), bound, out)\\n        i = i + 1\\n      }\\n      0\\n    },\\n    EArray(items) => {\\n      let mut i = 0\\n      while i < Array::length(items) {\\n        collect_refs_into(Array::get(items, i), bound, out)\\n        i = i + 1\\n      }\\n      0\\n    },\\n    ERecord(_, fields, _) => {\\n      let mut i = 0\\n      while i < Array::length(fields) {\\n        let (_, val) = Array::get(fields, i)\\n        collect_refs_into(val, bound, out)\\n        i = i + 1\\n      }\\n      0\\n    },\\n    EBinOp(_, l, r) => {\\n      collect_refs_into(l, bound, out)\\n      collect_refs_into(r, bound, out)\\n      0\\n    },\\n    ECall(callee, args, _) => {\\n      collect_refs_into(callee, bound, out)\\n      let mut i = 0\\n      while i < Array::length(args) {\\n        collect_refs_into(Array::get(args, i), bound, out)\\n        i = i + 1\\n      }\\n      0\\n    },\\n    EIf(cond, then_e, else_e) => {\\n      collect_refs_into(cond, bound, out)\\n      collect_refs_into(then_e, bound, out)\\n      collect_refs_into(else_e, bound, out)\\n      0\\n    },\\n    ELet(name, val, body, _) => {\\n      collect_refs_into(val, bound, out)\\n      let bound2 = clone_arr(bound)\\n      Array::push(bound2, name)\\n      collect_refs_into(body, bound2, out)\\n      0\\n    },\\n    ELetRec(name, val, body) => {\\n      let bound2 = clone_arr(bound)\\n      Array::push(bound2, name)\\n      collect_refs_into(val, bound2, out)\\n      collect_refs_into(body, bound2, out)\\n      0\\n    },\\n    ELetMut(name, val, body, _) => {\\n      collect_refs_into(val, bound, out)\\n      let bound2 = clone_arr(bound)\\n      Array::push(bound2, name)\\n      collect_refs_into(body, bound2, out)\\n      0\\n    },\\n    EAssign(_, val, body) => {\\n      collect_refs_into(val, bound, out)\\n      collect_refs_into(body, bound, out)\\n      0\\n    },\\n    EAssignOp(_, _, val, body) => {\\n      collect_refs_into(val, bound, out)\\n      collect_refs_into(body, bound, out)\\n      0\\n    },\\n    ESeq(l, r) => {\\n      collect_refs_into(l, bound, out)\\n      collect_refs_into(r, bound, out)\\n      0\\n    },\\n    EMatch(scr, arms) => {\\n      collect_refs_into(scr, bound, out)\\n      let mut i = 0\\n      while i < Array::length(arms) {\\n        let (pat, body) = Array::get(arms, i)\\n        let bound2 = clone_arr(bound)\\n        collect_pat_bindings(pat, bound2)\\n        collect_refs_into(body, bound2, out)\\n        i = i + 1\\n      }\\n      0\\n    },\\n    EHandle(body_expr, arms) => {\\n      collect_refs_into(body_expr, bound, out)\\n      let mut i = 0\\n      while i < Array::length(arms) {\\n        let (pat, arm_body) = Array::get(arms, i)\\n        let bound2 = clone_arr(bound)\\n        collect_pat_bindings(pat, bound2)\\n        collect_refs_into(arm_body, bound2, out)\\n        i = i + 1\\n      }\\n      0\\n    },\\n    EWhile(cond, body) => {\\n      collect_refs_into(cond, bound, out)\\n      collect_refs_into(body, bound, out)\\n      0\\n    },\\n    ELoop(params, body) => {\\n      let bound2 = clone_arr(bound)\\n      let mut i = 0\\n      while i < Array::length(params) {\\n        let (name, init) = Array::get(params, i)\\n        collect_refs_into(init, bound2, out)\\n        Array::push(bound2, name)\\n        i = i + 1\\n      }\\n      collect_refs_into(body, bound2, out)\\n      0\\n    },\\n    EForIn(name, index_name, iter, body) => {\\n      collect_refs_into(iter, bound, out)\\n      let bound2 = clone_arr(bound)\\n      Array::push(bound2, name)\\n      match index_name {\\n        Some(index_name) => Array::push(bound2, index_name),\\n        None => ()\\n      }\\n      collect_refs_into(body, bound2, out)\\n      0\\n    },\\n    EFn(_, _, params, _, _, body) => {\\n      let bound2 = clone_arr(bound)\\n      let mut i = 0\\n      while i < Array::length(params) {\\n        let (pname, _) = Array::get(params, i)\\n        Array::push(bound2, pname)\\n        i = i + 1\\n      }\\n      collect_refs_into(body, bound2, out)\\n      0\\n    },\\n    EDot(obj, _, _, _) => {\\n      collect_refs_into(obj, bound, out)\\n      0\\n    },\\n    ELabeledArg(_, _, e) => {\\n      collect_refs_into(e, bound, out)\\n      0\\n    },\\n    EMap(fields) => {\\n      let mut i = 0\\n      while i < Array::length(fields) {\\n        let (_, val) = Array::get(fields, i)\\n        collect_refs_into(val, bound, out)\\n        i = i + 1\\n      }\\n      0\\n    },\\n    ESpread(e) => {\\n      collect_refs_into(e, bound, out)\\n      0\\n    },\\n    EStringInterp(_) => 0\\n  }\\n}\\n\\nfn collect_refs(expr: Expr, bound: Array[String]) -> Array[String] {\\n  let out = Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n  collect_refs_into(expr, bound, out)\\n  out\\n}\\n\\nfn enqueue_reachable(reachable: Array[String], queue: Array[String], name: String) -> Unit {\\n  if not(dce_array_contains_str(reachable, name)) {\\n    Array::push(reachable, name)\\n    Array::push(queue, name)\\n  }\\n}\\n\\nfn collect_structural_refs_into_queue(stmt: Stmt, bound: Array[String], reachable: Array[String], queue: Array[String]) -> Unit {\\n  let refs = match stmt {\\n    STest(_, expr) => collect_refs(expr, bound),\\n    SBench(_, expr) => collect_refs(expr, bound),\\n    SExpr(expr) => collect_refs(expr, bound),\\n    _ => Array::slice([\\n      \\\"\\\"\\n    ], 0, 0)\\n  }\\n  let mut i = 0\\n  while i < Array::length(refs) {\\n    enqueue_reachable(reachable, queue, Array::get(refs, i))\\n    i = i + 1\\n  }\\n}\\n\\nfn is_type_or_structural(stmt: Stmt) -> Bool {\\n  match stmt {\\n    SEnum(_, _, _, _, _) => true,\\n    SSuberror(_, _, _) => true,\\n    SEffectDef(_, _, _, _) => true,\\n    SStruct(_, _, _, _, _, _) => true,\\n    STypeAlias(_, _, _, _) => true,\\n    STrait(_, _, _, _, _) => true,\\n    SImpl(_, _, _, _) => true,\\n    SExternLet(_, _) => true,\\n    SImport(_, _) => true,\\n    SAliasDecl(_, _) => true,\\n    STest(_, _) => true,\\n    SBench(_, _) => true,\\n    SExpr(_) => true,\\n    SExport(_) => true,\\n    SReExport(_, _) => true,\\n    SModule(_, _, _) => true,\\n    _ => false\\n  }\\n}\\n\\nexport fn dce_stmts(stmts: Array[Stmt], entry_names: Array[String]) -> Array[Stmt] {\\n  // Early-return on empty input: downstream code uses\\n  //   `Array::slice([Array::get(stmts, 0)], 0, 0)`\\n  // to construct a typed empty `Array[Stmt]`, which traps out-of-bounds\\n  // when stmts itself is empty. (See `dce_test.vibe: \\\"empty stmts\\n  // returns empty\\\"`, tracked in #266.)\\n  if Array::length(stmts) == 0 {\\n    Array::slice(stmts, 0, 0)\\n  } else {\\n  let empty_bound = Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n  let def_names = Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n  let def_refs = Array::slice([\\n    Array::slice([\\n      \\\"\\\"\\n    ], 0, 0)\\n  ], 0, 0)\\n  let mut i = 0\\n  while i < Array::length(stmts) {\\n    let stmt = Array::get(stmts, i)\\n    match stmt_name(stmt) {\\n      Some(name) => {\\n        Array::push(def_names, name)\\n        let refs = match stmt {\\n          SLet(_, _, _, _, expr) => collect_refs(expr, empty_bound),\\n          // Preserved fn decl (ADR-0064 #727): body refs plus contract-\\n          // condition refs (requires/ensures execute inside the function\\n          // after lowering, so helpers they call must stay live).\\n          SFnDecl(_, _, fn_value, reqs, enss) => {\\n            let out = collect_refs(fn_value, empty_bound)\\n            let mut cri = 0\\n            while cri < Array::length(reqs) {\\n              let _ = collect_refs_into(Array::get(reqs, cri), empty_bound, out)\\n              cri = cri + 1\\n            }\\n            let mut cei = 0\\n            while cei < Array::length(enss) {\\n              let _ = collect_refs_into(Array::get(enss, cei), empty_bound, out)\\n              cei = cei + 1\\n            }\\n            out\\n          },\\n          SLetMut(_, _, expr) => collect_refs(expr, empty_bound),\\n          _ => Array::slice([\\n            \\\"\\\"\\n          ], 0, 0)\\n        }\\n        Array::push(def_refs, refs)\\n        0\\n      },\\n      None => 0\\n    }\\n    i = i + 1\\n  }\\n  let reachable = Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n  let queue = Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n  let mut j = 0\\n  while j < Array::length(entry_names) {\\n    let name = Array::get(entry_names, j)\\n    enqueue_reachable(reachable, queue, name)\\n    j = j + 1\\n  }\\n  let mut sj = 0\\n  while sj < Array::length(stmts) {\\n    collect_structural_refs_into_queue(Array::get(stmts, sj), empty_bound, reachable, queue)\\n    sj = sj + 1\\n  }\\n  let mut qi = 0\\n  while qi < Array::length(queue) {\\n    let current = Array::get(queue, qi)\\n    qi = qi + 1\\n    let mut k = 0\\n    while k < Array::length(def_names) {\\n      if Array::get(def_names, k) == current {\\n        let refs = Array::get(def_refs, k)\\n        let mut r = 0\\n        while r < Array::length(refs) {\\n          let dep = Array::get(refs, r)\\n          if not(dce_array_contains_str(reachable, dep)) {\\n            Array::push(reachable, dep)\\n            Array::push(queue, dep)\\n          }\\n          r = r + 1\\n        }\\n      }\\n      k = k + 1\\n    }\\n  }\\n  let result = Array::slice([\\n    Array::get(stmts, 0)\\n  ], 0, 0)\\n  let mut m = 0\\n  while m < Array::length(stmts) {\\n    let stmt = Array::get(stmts, m)\\n    if is_type_or_structural(stmt) {\\n      Array::push(result, stmt)\\n    } else {\\n      match stmt_name(stmt) {\\n        Some(name) => if dce_array_contains_str(reachable, name) {\\n          Array::push(result, stmt)\\n        },\\n        None => Array::push(result, stmt)\\n      }\\n    }\\n    m = m + 1\\n  }\\n  result\\n  }\\n}\\n\\n// Compute the set of reachable top-level names from `entry_names`, following\\n// value-definition refs and structural (type/test/expr) refs to a fixpoint.\\n// Mirrors the reachability computation inside `dce_stmts`; kept as a separate\\n// (currently unwired) function so module-source emission can reuse it without\\n// changing `dce_stmts` (a bootstrap-reachable hot path).\\nfn dce_reachable_names(stmts: Array[Stmt], entry_names: Array[String]) -> Array[String] {\\n  let empty_bound = Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n  let def_names = Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n  let def_refs = Array::slice([\\n    Array::slice([\\n      \\\"\\\"\\n    ], 0, 0)\\n  ], 0, 0)\\n  let mut i = 0\\n  while i < Array::length(stmts) {\\n    let stmt = Array::get(stmts, i)\\n    match stmt_name(stmt) {\\n      Some(name) => {\\n        Array::push(def_names, name)\\n        let refs = match stmt {\\n          SLet(_, _, _, _, expr) => collect_refs(expr, empty_bound),\\n          // Preserved fn decl (ADR-0064 #727): body refs plus contract-\\n          // condition refs (requires/ensures execute inside the function\\n          // after lowering, so helpers they call must stay live).\\n          SFnDecl(_, _, fn_value, reqs, enss) => {\\n            let out = collect_refs(fn_value, empty_bound)\\n            let mut cri = 0\\n            while cri < Array::length(reqs) {\\n              let _ = collect_refs_into(Array::get(reqs, cri), empty_bound, out)\\n              cri = cri + 1\\n            }\\n            let mut cei = 0\\n            while cei < Array::length(enss) {\\n              let _ = collect_refs_into(Array::get(enss, cei), empty_bound, out)\\n              cei = cei + 1\\n            }\\n            out\\n          },\\n          SLetMut(_, _, expr) => collect_refs(expr, empty_bound),\\n          _ => Array::slice([\\n            \\\"\\\"\\n          ], 0, 0)\\n        }\\n        Array::push(def_refs, refs)\\n        0\\n      },\\n      None => 0\\n    }\\n    i = i + 1\\n  }\\n  let reachable = Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n  let queue = Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n  let mut j = 0\\n  while j < Array::length(entry_names) {\\n    let name = Array::get(entry_names, j)\\n    enqueue_reachable(reachable, queue, name)\\n    j = j + 1\\n  }\\n  let mut sj = 0\\n  while sj < Array::length(stmts) {\\n    collect_structural_refs_into_queue(Array::get(stmts, sj), empty_bound, reachable, queue)\\n    sj = sj + 1\\n  }\\n  let mut qi = 0\\n  while qi < Array::length(queue) {\\n    let current = Array::get(queue, qi)\\n    qi = qi + 1\\n    let mut k = 0\\n    while k < Array::length(def_names) {\\n      if Array::get(def_names, k) == current {\\n        let refs = Array::get(def_refs, k)\\n        let mut r = 0\\n        while r < Array::length(refs) {\\n          let dep = Array::get(refs, r)\\n          if not(dce_array_contains_str(reachable, dep)) {\\n            Array::push(reachable, dep)\\n            Array::push(queue, dep)\\n          }\\n          r = r + 1\\n        }\\n      }\\n      k = k + 1\\n    }\\n  }\\n  reachable\\n}\\n\\n// Whether DCE keeps `stmt` given the reachable name set: type/structural\\n// statements are always kept; named value defs are kept iff reachable; unnamed\\n// statements are kept. (Same per-statement rule `dce_stmts` applies.)\\nfn dce_keep_stmt(stmt: Stmt, reachable: Array[String]) -> Bool {\\n  if is_type_or_structural(stmt) {\\n    true\\n  } else {\\n    match stmt_name(stmt) {\\n      Some(name) => dce_array_contains_str(reachable, name),\\n      None => true\\n    }\\n  }\\n}\\n\\n// Per-original-index keep flags from DCE, parallel to `stmts`. Lets callers\\n// (e.g. module-source emission) map surviving statements back to their source\\n// spans without relying on statement identity/equality. Result length equals\\n// `Array::length(stmts)`.\\nexport fn dce_keep_flags(stmts: Array[Stmt], entry_names: Array[String]) -> Array[Bool] {\\n  let flags = Array::slice([\\n    true\\n  ], 0, 0)\\n  if Array::length(stmts) == 0 {\\n    flags\\n  } else {\\n    let reachable = dce_reachable_names(stmts, entry_names)\\n    let mut m = 0\\n    while m < Array::length(stmts) {\\n      Array::push(flags, dce_keep_stmt(Array::get(stmts, m), reachable))\\n      m = m + 1\\n    }\\n    flags\\n  }\\n}\\n\")\n}\n\nlet cli_adapter_source_20 = () -> (String, String) {\n  (\"lib/@vibe/compiler/core/sorted_index.vibe\",\n\"//# Functions\\n\\n// Sorted-name index utilities: the compiler's `Map` is a flat assoc list, so\\n// `Map::get` / `Map::has_key` are O(entries) with an `eq` call per entry --\\n// every \\\"Map membership index\\\" over a large name table is still a linear\\n// scan. For per-ident lookups against thousands of names (fn tables, ctor\\n// tables, fn_returns), a one-time stable sort + binary search turns each\\n// lookup into ~log2(N) `String <` comparisons.\\n//\\n// Stability contract: sort_perm_by_names is a STABLE merge sort, and\\n// bsearch_leftmost returns the LEFTMOST slot of an equal run -- together\\n// they preserve linear-scan \\\"first match wins\\\" semantics for tables with\\n// duplicate keys (results are byte-identical to the linear scan they\\n// replace).\\n\\n// Lexicographic (char-code) string less-than. Written char-by-char instead\\n// of `a < b` because the String `<` desugar (str_lex_diff, #746) is newer\\n// than the pinned seed compiler -- this file must stay seed-compilable.\\nexport fn str_lt(a: String, b: String) -> Bool {\\n  let la = String::length(a)\\n  let lb = String::length(b)\\n  let lim = if la < lb {\\n    la\\n  } else {\\n    lb\\n  }\\n  let mut i = 0\\n  let mut res = la < lb\\n  let mut done = false\\n  while i < lim && !done {\\n    let ca = String::char_code_at(a, i)\\n    let cb = String::char_code_at(b, i)\\n    if ca < cb {\\n      res = true\\n      done = true\\n    } else if ca > cb {\\n      res = false\\n      done = true\\n    } else {\\n      i = i + 1\\n    }\\n  }\\n  res\\n}\\n\\n// Stable bottom-up merge sort. Returns the permutation `perm` such that\\n// names[perm[0]] <= names[perm[1]] <= ... (ties keep original order).\\nexport fn sort_perm_by_names(names: Array[String]) -> Array[Int] {\\n  let n = Array::length(names)\\n  let mut src = Array::slice([\\n    0\\n  ], 0, 0)\\n  let mut i = 0\\n  while i < n {\\n    Array::push(src, i)\\n    i = i + 1\\n  }\\n  let mut buf = Array::slice(src, 0, n)\\n  let mut width = 1\\n  while width < n {\\n    let mut lo = 0\\n    while lo < n {\\n      let mid = if lo + width < n {\\n        lo + width\\n      } else {\\n        n\\n      }\\n      let hi = if lo + width + width < n {\\n        lo + width + width\\n      } else {\\n        n\\n      }\\n      let mut a = lo\\n      let mut b = mid\\n      let mut k = lo\\n      while k < hi {\\n        let take_left = if a >= mid {\\n          false\\n        } else if b >= hi {\\n          true\\n        } else {\\n          // names[src[a]] <= names[src[b]] takes the left run: stable.\\n          !str_lt(Array::get(names, Array::get(src, b)), Array::get(names, Array::get(src, a)))\\n        }\\n        if take_left {\\n          Array::set(buf, k, Array::get(src, a))\\n          a = a + 1\\n        } else {\\n          Array::set(buf, k, Array::get(src, b))\\n          b = b + 1\\n        }\\n        k = k + 1\\n      }\\n      lo = hi\\n    }\\n    let tmp = src\\n    src = buf\\n    buf = tmp\\n    width = width + width\\n  }\\n  src\\n}\\n\\nexport fn apply_perm_strings(names: Array[String], perm: Array[Int]) -> Array[String] {\\n  let out = Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n  let mut i = 0\\n  while i < Array::length(perm) {\\n    Array::push(out, Array::get(names, Array::get(perm, i)))\\n    i = i + 1\\n  }\\n  out\\n}\\n\\n// Convenience: names -> sorted copy (membership-only callers).\\nexport fn sorted_names_of(names: Array[String]) -> Array[String] {\\n  apply_perm_strings(names, sort_perm_by_names(names))\\n}\\n\\n// Leftmost binary search over a SORTED name array. Returns the smallest slot\\n// holding `name`, or -1 when absent.\\nexport fn bsearch_leftmost(sorted: Array[String], name: String) -> Int {\\n  let mut lo = 0\\n  let mut hi = Array::length(sorted)\\n  while lo < hi {\\n    let mid = (lo + hi) / 2\\n    if str_lt(Array::get(sorted, mid), name) {\\n      lo = mid + 1\\n    } else {\\n      hi = mid\\n    }\\n  }\\n  if lo < Array::length(sorted) && Array::get(sorted, lo) == name {\\n    lo\\n  } else {\\n    -1\\n  }\\n}\\n\")\n}\n\nlet cli_adapter_source_21 = () -> (String, String) {\n  (\"lib/@vibe/compiler/core/import_alias_rewrite.vibe\",\n\"//# Imports\\n\\nimport ./ast.vibe {\\n  Expr, Pat, Stmt, TypeExpr\\n}\\n\\nimport ../module_graph_path.vibe {\\n  dir_of_path, resolve_import_path_candidates\\n}\\n\\n//# Functions\\n\\nfn empty_aliases() -> Array[(String, String)] {\\n  Array::slice([\\n    (\\\"\\\", \\\"\\\")\\n  ], 0, 0)\\n}\\n\\nfn empty_strings() -> Array[String] {\\n  Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n}\\n\\nfn empty_import_refs() -> Array[(String, String, String)] {\\n  Array::slice([\\n    (\\\"\\\", \\\"\\\", \\\"\\\")\\n  ], 0, 0)\\n}\\n\\nfn string_array_contains(items: Array[String], target: String) -> Bool {\\n  let mut i = 0\\n  let mut found = false\\n  while i < Array::length(items) && !found {\\n    if Array::get(items, i) == target {\\n      found = true\\n    } else {\\n      i = i + 1\\n    }\\n  }\\n  found\\n}\\n\\nfn import_ref_array_contains_local(items: Array[(String, String, String)], target: String) -> Bool {\\n  let mut i = 0\\n  let mut found = false\\n  while i < Array::length(items) && !found {\\n    let (_, _, local) = Array::get(items, i)\\n    if local == target {\\n      found = true\\n    } else {\\n      i = i + 1\\n    }\\n  }\\n  found\\n}\\n\\nfn import_ref_has_other_path_for_original(items: Array[(String, String, String)], raw_path: String, original: String) -> Bool {\\n  let mut i = 0\\n  let mut found = false\\n  while i < Array::length(items) && !found {\\n    let (other_path, other_original, _) = Array::get(items, i)\\n    if other_original == original && other_path != raw_path {\\n      found = true\\n    } else {\\n      i = i + 1\\n    }\\n  }\\n  found\\n}\\n\\nfn lookup_alias(aliases: Array[(String, String)], name: String) -> Option[String] {\\n  let mut i = 0\\n  let mut found = None\\n  while i < Array::length(aliases) {\\n    let (alias, original) = Array::get(aliases, i)\\n    if alias == name {\\n      found = Some(original)\\n      i = Array::length(aliases)\\n    } else {\\n      i = i + 1\\n    }\\n  }\\n  found\\n}\\n\\n// #897/Codex P2: a local binder named `ns` must also shadow any qualified-\\n// import namespace aliases it introduces (\\\"ns.x\\\", \\\"ns.y\\\" from `import ...\\n// as ns only { x, y }`) -- otherwise `ns.add` inside that binder's scope,\\n// where `ns` is a genuine local value with its own `add` field, gets\\n// mis-rewritten to the IMPORTED `add` instead of the real field access\\n// (silently wrong codegen, not just a diagnostic gap). `alias_is_shadowed`\\n// centralizes the \\\"does binder `name` shadow this alias key\\\" test so the\\n// exact-match and dotted-namespace-prefix cases can never drift apart.\\nfn alias_is_shadowed(alias: String, name: String) -> Bool {\\n  alias == name || (String::starts_with(alias, name) && String::length(alias) > String::length(name) && String::char_code_at(alias, String::length(name)) == '.')\\n}\\n\\n// Perf: the without_* family runs at EVERY binder (let/lambda/match arm)\\n// while rewriting every expression, but a binder that shadows an alias is\\n// rare -- in the common case nothing is removed. Pre-scan and return the\\n// input map unchanged (alias maps are read-only after construction, so\\n// sharing is safe); only allocate the filtered copy when a removal is real.\\n// A full-closure compile profile showed this trio as the #2 __rt_arr_push /\\n// __rt_heap_grow_check caller after perceus copy_ints.\\nfn alias_map_has_name(aliases: Array[(String, String)], name: String) -> Bool {\\n  let mut i = 0\\n  let mut found = false\\n  while i < Array::length(aliases) && !found {\\n    let (alias, _) = Array::get(aliases, i)\\n    if alias_is_shadowed(alias, name) {\\n      found = true\\n    } else {\\n      i = i + 1\\n    }\\n  }\\n  found\\n}\\n\\nfn alias_map_without_name(aliases: Array[(String, String)], name: String) -> Array[(String, String)] {\\n  if !alias_map_has_name(aliases, name) {\\n    aliases\\n  } else {\\n    let out = empty_aliases()\\n    let mut i = 0\\n    while i < Array::length(aliases) {\\n      let (alias, original) = Array::get(aliases, i)\\n      if !alias_is_shadowed(alias, name) {\\n        Array::push(out, (alias, original))\\n      }\\n      i = i + 1\\n    }\\n    out\\n  }\\n}\\n\\n// #897/Codex P2: same dotted-namespace-prefix shadowing as alias_is_shadowed\\n// above, generalized to a whole array of shadowing names (this helper's\\n// callers pass collision/rename-local lists, not a single binder name).\\nfn names_shadow_alias(names: Array[String], alias: String) -> Bool {\\n  let mut i = 0\\n  let mut found = false\\n  while i < Array::length(names) && !found {\\n    if alias_is_shadowed(alias, Array::get(names, i)) {\\n      found = true\\n    } else {\\n      i = i + 1\\n    }\\n  }\\n  found\\n}\\n\\nfn alias_map_without_names(aliases: Array[(String, String)], names: Array[String]) -> Array[(String, String)] {\\n  let mut any = false\\n  let mut j = 0\\n  while j < Array::length(aliases) && !any {\\n    let (alias, _) = Array::get(aliases, j)\\n    if names_shadow_alias(names, alias) {\\n      any = true\\n    } else {\\n      j = j + 1\\n    }\\n  }\\n  if !any {\\n    aliases\\n  } else {\\n    let out = empty_aliases()\\n    let mut i = 0\\n    while i < Array::length(aliases) {\\n      let (alias, original) = Array::get(aliases, i)\\n      if !names_shadow_alias(names, alias) {\\n        Array::push(out, (alias, original))\\n      }\\n      i = i + 1\\n    }\\n    out\\n  }\\n}\\n\\nfn pat_binds_name(pat: Pat, name: String) -> Bool {\\n  match pat {\\n    PBind(bound) => bound == name,\\n    PCtor(_, pats) => {\\n      let mut found = false\\n      let mut i = 0\\n      while i < Array::length(pats) && !found {\\n        if pat_binds_name(Array::get(pats, i), name) {\\n          found = true\\n        } else {\\n          i = i + 1\\n        }\\n      }\\n      found\\n    },\\n    PTuple(pats) => {\\n      let mut found = false\\n      let mut i = 0\\n      while i < Array::length(pats) && !found {\\n        if pat_binds_name(Array::get(pats, i), name) {\\n          found = true\\n        } else {\\n          i = i + 1\\n        }\\n      }\\n      found\\n    },\\n    POr(left, right) => pat_binds_name(left, name) || pat_binds_name(right, name),\\n    PStruct(_, fields) => {\\n      let mut found = false\\n      let mut i = 0\\n      while i < Array::length(fields) && !found {\\n        let (_, field_pat) = Array::get(fields, i)\\n        if pat_binds_name(field_pat, name) {\\n          found = true\\n        } else {\\n          i = i + 1\\n        }\\n      }\\n      found\\n    },\\n    _ => false\\n  }\\n}\\n\\n// #897/Codex P2: same dotted-namespace-prefix shadowing as alias_is_shadowed\\n// -- extracts the \\\"ns\\\" of a \\\"ns.field\\\" alias key (None for a plain alias).\\nfn alias_namespace_prefix(alias: String) -> Option[String] {\\n  let dot = String::index_of(alias, \\\".\\\")\\n  if dot < 0 {\\n    None\\n  } else {\\n    Some(String::substring(alias, 0, dot))\\n  }\\n}\\n\\nfn pat_shadows_alias(pat: Pat, alias: String) -> Bool {\\n  pat_binds_name(pat, alias) || match alias_namespace_prefix(alias) {\\n    Some(ns) => pat_binds_name(pat, ns),\\n    None => false\\n  }\\n}\\n\\nfn alias_map_without_pat(aliases: Array[(String, String)], pat: Pat) -> Array[(String, String)] {\\n  let mut any = false\\n  let mut j = 0\\n  while j < Array::length(aliases) && !any {\\n    let (alias, _) = Array::get(aliases, j)\\n    if pat_shadows_alias(pat, alias) {\\n      any = true\\n    } else {\\n      j = j + 1\\n    }\\n  }\\n  if !any {\\n    aliases\\n  } else {\\n    let out = empty_aliases()\\n    let mut i = 0\\n    while i < Array::length(aliases) {\\n      let (alias, original) = Array::get(aliases, i)\\n      if !pat_shadows_alias(pat, alias) {\\n        Array::push(out, (alias, original))\\n      }\\n      i = i + 1\\n    }\\n    out\\n  }\\n}\\n\\nfn param_binds_name(params: Array[(String, Option[TypeExpr])], name: String) -> Bool {\\n  let mut found = false\\n  let mut i = 0\\n  while i < Array::length(params) && !found {\\n    let (param_name, _) = Array::get(params, i)\\n    if param_name == name {\\n      found = true\\n    } else {\\n      i = i + 1\\n    }\\n  }\\n  found\\n}\\n\\nfn params_shadow_alias(params: Array[(String, Option[TypeExpr])], alias: String) -> Bool {\\n  param_binds_name(params, alias) || match alias_namespace_prefix(alias) {\\n    Some(ns) => param_binds_name(params, ns),\\n    None => false\\n  }\\n}\\n\\nfn alias_map_without_params(aliases: Array[(String, String)], params: Array[(String, Option[TypeExpr])]) -> Array[(String, String)] {\\n  let mut any = false\\n  let mut j = 0\\n  while j < Array::length(aliases) && !any {\\n    let (alias, _) = Array::get(aliases, j)\\n    if params_shadow_alias(params, alias) {\\n      any = true\\n    } else {\\n      j = j + 1\\n    }\\n  }\\n  if !any {\\n    aliases\\n  } else {\\n    let out = empty_aliases()\\n    let mut i = 0\\n    while i < Array::length(aliases) {\\n      let (alias, original) = Array::get(aliases, i)\\n      if !params_shadow_alias(params, alias) {\\n        Array::push(out, (alias, original))\\n      }\\n      i = i + 1\\n    }\\n    out\\n  }\\n}\\n\\nexport fn rewrite_import_alias_expr(expr: Expr, aliases: Array[(String, String)]) -> Expr {\\n  // Perf: with no aliases the rewrite is the identity, but the match below\\n  // still rebuilt EVERY node of the tree. Alias maps only shrink on the way\\n  // down (without_*), so an empty map stays empty for the whole subtree --\\n  // return the shared node instead of an allocated copy (AST nodes are\\n  // immutable; `None => expr` below already shares subtrees).\\n  if Array::length(aliases) == 0 {\\n    expr\\n  } else {\\n  match expr {\\n    EIdent(name, _) => match lookup_alias(aliases, name) {\\n      Some(original) => EIdent(original, -1),\\n      None => expr\\n    },\\n    ETuple(items) => ETuple(for item in items {\\n      rewrite_import_alias_expr(item, aliases)\\n    }),\\n    EArray(items) => EArray(for item in items {\\n      rewrite_import_alias_expr(item, aliases)\\n    }),\\n    ERecord(rn, fields, targs) => ERecord(rn, for field in fields {\\n      let (name, value) = field\\n      (name, rewrite_import_alias_expr(value, aliases))\\n    }, targs),\\n    EIf(cond, then_expr, else_expr) => EIf(\\n      rewrite_import_alias_expr(cond, aliases),\\n      rewrite_import_alias_expr(then_expr, aliases),\\n      rewrite_import_alias_expr(else_expr, aliases)\\n    ),\\n    ELet(name, value, body, soff) => ELet(\\n      name,\\n      rewrite_import_alias_expr(value, aliases),\\n      rewrite_import_alias_expr(body, alias_map_without_name(aliases, name)),\\n      soff\\n    ),\\n    ELetRec(name, value, body) => {\\n      let body_aliases = alias_map_without_name(aliases, name)\\n      ELetRec(\\n        name,\\n        rewrite_import_alias_expr(value, body_aliases),\\n        rewrite_import_alias_expr(body, body_aliases)\\n      )\\n    },\\n    ELetMut(name, value, body, soff) => ELetMut(\\n      name,\\n      rewrite_import_alias_expr(value, aliases),\\n      rewrite_import_alias_expr(body, alias_map_without_name(aliases, name)),\\n      soff\\n    ),\\n    EAssign(name, value, body) => EAssign(\\n      name,\\n      rewrite_import_alias_expr(value, aliases),\\n      rewrite_import_alias_expr(body, aliases)\\n    ),\\n    EAssignOp(name, op, value, body) => EAssignOp(\\n      name,\\n      op,\\n      rewrite_import_alias_expr(value, aliases),\\n      rewrite_import_alias_expr(body, aliases)\\n    ),\\n    ESeq(left, right) => ESeq(\\n      rewrite_import_alias_expr(left, aliases),\\n      rewrite_import_alias_expr(right, aliases)\\n    ),\\n    EMatch(scrutinee, arms) => EMatch(rewrite_import_alias_expr(scrutinee, aliases), for arm in arms {\\n      let (pat, body) = arm\\n      (pat, rewrite_import_alias_expr(body, alias_map_without_pat(aliases, pat)))\\n    }),\\n    EHandle(body, arms) => EHandle(rewrite_import_alias_expr(body, aliases), for arm in arms {\\n      let (pat, arm_body) = arm\\n      (pat, rewrite_import_alias_expr(arm_body, alias_map_without_pat(aliases, pat)))\\n    }),\\n    EWhile(cond, body) => EWhile(\\n      rewrite_import_alias_expr(cond, aliases),\\n      rewrite_import_alias_expr(body, aliases)\\n    ),\\n    ELoop(params, body) => {\\n      let out_params = for param in params {\\n        let (name, init) = param\\n        (name, rewrite_import_alias_expr(init, aliases))\\n      }\\n      let mut body_aliases = aliases\\n      let mut i = 0\\n      while i < Array::length(params) {\\n        let (name, _) = Array::get(params, i)\\n        body_aliases = alias_map_without_name(body_aliases, name)\\n        i = i + 1\\n      }\\n      ELoop(out_params, rewrite_import_alias_expr(body, body_aliases))\\n    },\\n    EForIn(name, index_name, iter, body) => {\\n      let body_aliases = match index_name {\\n        Some(index_name) => alias_map_without_name(alias_map_without_name(aliases, name), index_name),\\n        None => alias_map_without_name(aliases, name)\\n      }\\n      EForIn(\\n        name,\\n        index_name,\\n        rewrite_import_alias_expr(iter, aliases),\\n        rewrite_import_alias_expr(body, body_aliases)\\n      )\\n    },\\n    ECall(callee, args, off) => ECall(rewrite_import_alias_expr(callee, aliases), for arg in args {\\n      rewrite_import_alias_expr(arg, aliases)\\n    }, off),\\n    EBinOp(op, left, right) => EBinOp(\\n      op,\\n      rewrite_import_alias_expr(left, aliases),\\n      rewrite_import_alias_expr(right, aliases)\\n    ),\\n    EUnaryOp(op, value) => EUnaryOp(op, rewrite_import_alias_expr(value, aliases)),\\n    EFn(type_params, bounds, params, ret_ty, effect, body) => EFn(\\n      type_params,\\n      bounds,\\n      params,\\n      ret_ty,\\n      effect,\\n      rewrite_import_alias_expr(body, alias_map_without_params(aliases, params))\\n    ),\\n    // #897: `mod.x` written against a qualified-import namespace (`import\\n    // ... as mod only { x }`) is encoded as the alias key \\\"mod.x\\\" -- see\\n    // qualify_import_items in lib/@vibe/parser/parser.vibe. A real\\n    // identifier can never contain '.', so this lookup only ever hits for\\n    // that desugaring; anything else falls through to the ordinary EDot\\n    // rewrite (ordinary struct/record field access).\\n    EDot(obj, field, off, fdoff) => match obj {\\n      EIdent(ns, _) => match lookup_alias(aliases, String::concat(ns, String::concat(\\\".\\\", field))) {\\n        Some(original) => EIdent(original, -1),\\n        None => EDot(rewrite_import_alias_expr(obj, aliases), field, off, fdoff)\\n      },\\n      _ => EDot(rewrite_import_alias_expr(obj, aliases), field, off, fdoff)\\n    },\\n    ELabeledArg(label, name, body) => ELabeledArg(label, name, rewrite_import_alias_expr(body, aliases)),\\n    EReturn(value) => EReturn(rewrite_import_alias_expr(value, aliases)),\\n    EBreak(value) => match value {\\n      Some(value) => EBreak(Some(rewrite_import_alias_expr(value, aliases))),\\n      None => expr\\n    },\\n    EContinue(values) => EContinue(for value in values {\\n      rewrite_import_alias_expr(value, aliases)\\n    }),\\n    EMap(fields) => EMap(for field in fields {\\n      let (name, value) = field\\n      (name, rewrite_import_alias_expr(value, aliases))\\n    }),\\n    ESpread(value) => ESpread(rewrite_import_alias_expr(value, aliases)),\\n    _ => expr\\n  }\\n  }\\n}\\n\\nexport fn collect_import_aliases(stmts: Array[Stmt]) -> Array[(String, String)] {\\n  let aliases = empty_aliases()\\n  let mut i = 0\\n  while i < Array::length(stmts) {\\n    match Array::get(stmts, i) {\\n      SImport(_, items) => {\\n        let mut j = 0\\n        while j < Array::length(items) {\\n          let (original, alias_opt) = Array::get(items, j)\\n          match alias_opt {\\n            Some(alias) => if alias != original {\\n              Array::push(aliases, (alias, original))\\n            },\\n            None => ()\\n          }\\n          j = j + 1\\n        }\\n      },\\n      _ => ()\\n    }\\n    i = i + 1\\n  }\\n  aliases\\n}\\n\\nfn collect_import_refs(stmts: Array[Stmt]) -> Array[(String, String, String)] {\\n  let refs = empty_import_refs()\\n  let mut i = 0\\n  while i < Array::length(stmts) {\\n    match Array::get(stmts, i) {\\n      SImport(raw_path, items) => {\\n        let mut j = 0\\n        while j < Array::length(items) {\\n          let (original, alias_opt) = Array::get(items, j)\\n          let local = match alias_opt {\\n            Some(alias) => alias,\\n            None => original\\n          }\\n          Array::push(refs, (raw_path, original, local))\\n          j = j + 1\\n        }\\n      },\\n      _ => ()\\n    }\\n    i = i + 1\\n  }\\n  refs\\n}\\n\\nexport fn collect_import_alias_collision_refs(stmts: Array[Stmt]) -> Array[(String, String, String)] {\\n  let refs = collect_import_refs(stmts)\\n  let out = empty_import_refs()\\n  let mut i = 0\\n  while i < Array::length(refs) {\\n    let (raw_path, original, local) = Array::get(refs, i)\\n    if import_ref_has_other_path_for_original(refs, raw_path, original) && !import_ref_array_contains_local(out, local) {\\n      Array::push(out, (raw_path, original, local))\\n    }\\n    i = i + 1\\n  }\\n  out\\n}\\n\\nexport fn collect_import_alias_collision_locals(stmts: Array[Stmt]) -> Array[String] {\\n  let refs = collect_import_alias_collision_refs(stmts)\\n  let out = empty_strings()\\n  let mut i = 0\\n  while i < Array::length(refs) {\\n    let (_, _, local) = Array::get(refs, i)\\n    if !string_array_contains(out, local) {\\n      Array::push(out, local)\\n    }\\n    i = i + 1\\n  }\\n  out\\n}\\n\\nexport fn rewrite_import_alias_stmt(stmt: Stmt, aliases: Array[(String, String)]) -> Stmt {\\n  match stmt {\\n    SLet(exported, is_rec, name, ty, body) => SLet(\\n      exported,\\n      is_rec,\\n      name,\\n      ty,\\n      rewrite_import_alias_expr(body, alias_map_without_name(aliases, name))\\n    ),\\n    SLetMut(name, ty, body) => SLetMut(\\n      name,\\n      ty,\\n      rewrite_import_alias_expr(body, alias_map_without_name(aliases, name))\\n    ),\\n    STest(name, body) => STest(name, rewrite_import_alias_expr(body, aliases)),\\n    SBench(name, body) => SBench(name, rewrite_import_alias_expr(body, aliases)),\\n    SExpr(body) => SExpr(rewrite_import_alias_expr(body, aliases)),\\n    SLetPat(pat, body) => SLetPat(pat, rewrite_import_alias_expr(body, aliases)),\\n    SModule(exported, name, stmts) => {\\n      let module_aliases = collect_import_aliases(stmts)\\n      SModule(exported, name, for inner_stmt in stmts {\\n        rewrite_import_alias_stmt(inner_stmt, module_aliases)\\n      })\\n    },\\n    _ => stmt\\n  }\\n}\\n\\nexport fn stmts_have_import_deep(stmts: Array[Stmt]) -> Bool {\\n  let rec stmt_has_import_deep: (Stmt) -> Bool = (stmt) -> {\\n    match stmt {\\n      SImport(_, _) => true,\\n      SModule(_, _, inner_stmts) => stmts_have_import_deep(inner_stmts),\\n      _ => false\\n    }\\n  }\\n  let mut found = false\\n  let mut i = 0\\n  while i < Array::length(stmts) && !found {\\n    if stmt_has_import_deep(Array::get(stmts, i)) {\\n      found = true\\n    } else {\\n      i = i + 1\\n    }\\n  }\\n  found\\n}\\n\\nexport fn append_non_import_stmts_without_alias_rewrite(merged: Array[Stmt], stmts: Array[Stmt]) -> Unit {\\n  let mut i = 0\\n  while i < Array::length(stmts) {\\n    let stmt = Array::get(stmts, i)\\n    match stmt {\\n      SImport(_, _) => (),\\n      SReExport(_, _) => (),\\n      SAliasDecl(_, _) => (),\\n      _ => Array::push(merged, stmt)\\n    }\\n    i = i + 1\\n  }\\n}\\n\\nexport fn append_import_alias_rewritten_non_import_stmts_skipping(merged: Array[Stmt], stmts: Array[Stmt], skipped_locals: Array[String]) -> Unit {\\n  let aliases = alias_map_without_names(collect_import_aliases(stmts), skipped_locals)\\n  let should_rewrite = Array::length(aliases) > 0\\n  let mut i = 0\\n  while i < Array::length(stmts) {\\n    let stmt = Array::get(stmts, i)\\n    match stmt {\\n      SImport(_, _) => (),\\n      SReExport(_, _) => (),\\n      SAliasDecl(_, _) => (),\\n      SModule(_, _, _) => Array::push(merged, rewrite_import_alias_stmt(stmt, aliases)),\\n      _ => if should_rewrite {\\n        Array::push(merged, rewrite_import_alias_stmt(stmt, aliases))\\n      } else {\\n        Array::push(merged, stmt)\\n      }\\n    }\\n    i = i + 1\\n  }\\n}\\n\\nexport fn append_import_alias_rewritten_non_import_stmts(merged: Array[Stmt], stmts: Array[Stmt]) -> Unit {\\n  append_import_alias_rewritten_non_import_stmts_skipping(merged, stmts, empty_strings())\\n}\\n\\nexport fn rewrite_imported_value_stmt_to_local(stmt: Stmt, original: String, local: String) -> Option[Stmt] {\\n  let aliases = Array::slice([\\n    (original, local)\\n  ], 0, 1)\\n  let rewrite_value: (Expr) -> Expr = (expr) -> {\\n    if original == local {\\n      expr\\n    } else {\\n      rewrite_import_alias_expr(expr, aliases)\\n    }\\n  }\\n  match stmt {\\n    SLet(_, is_rec, name, ty, body) => if name == original {\\n      Some(SLet(false, is_rec, local, ty, rewrite_value(body)))\\n    } else {\\n      None\\n    },\\n    SLetMut(name, ty, body) => if name == original {\\n      Some(SLetMut(local, ty, rewrite_value(body)))\\n    } else {\\n      None\\n    },\\n    _ => None\\n  }\\n}\\n\\nfn sanitize_namespace_char(code: Int) -> String {\\n  if (code >= 'a' && code <= 'z') || (code >= 'A' && code <= 'Z') || (code >= '0' && code <= '9') || code == '_' {\\n    String::from_char_code(code)\\n  } else {\\n    \\\"_\\\"\\n  }\\n}\\n\\nfn sanitize_namespace_path(path: String) -> String {\\n  // O(N) build via StringBuilder; the previous `out = String::concat(out, ...)`\\n  // per char was O(N²) over the path length (issue #366).\\n  let out = StringBuilder::new()\\n  let mut i = 0\\n  while i < String::length(path) {\\n    StringBuilder::push(out, sanitize_namespace_char(String::char_code_at(path, i)))\\n    i = i + 1\\n  }\\n  StringBuilder::freeze(out)\\n}\\n\\nfn namespace_private_name(path: String, name: String) -> String {\\n  String::concat(name, String::concat(\\\"_dep_\\\", sanitize_namespace_path(path)))\\n}\\n\\nfn namespace_private_name_with_suffix(namespace_suffix: String, name: String) -> String {\\n  String::concat(name, String::concat(\\\"_dep_\\\", namespace_suffix))\\n}\\n\\nfn namespace_private_name_lazy(path: String, name: String, suffix_box: Array[String]) -> String {\\n  let current = Array::get(suffix_box, 0)\\n  let suffix = if String::length(current) == 0 {\\n    let sanitized = sanitize_namespace_path(path)\\n    Array::set(suffix_box, 0, sanitized)\\n    sanitized\\n  } else {\\n    current\\n  }\\n  namespace_private_name_with_suffix(suffix, name)\\n}\\n\\nfn collect_exported_value_names(stmts: Array[Stmt]) -> Array[String] {\\n  let names = empty_strings()\\n  let mut i = 0\\n  while i < Array::length(stmts) {\\n    match Array::get(stmts, i) {\\n      SLet(true, _, name, _, _) => if !string_array_contains(names, name) {\\n        Array::push(names, name)\\n      },\\n      SExport(items) => {\\n        let mut j = 0\\n        while j < Array::length(items) {\\n          let name = Array::get(items, j)\\n          if !string_array_contains(names, name) {\\n            Array::push(names, name)\\n          }\\n          j = j + 1\\n        }\\n      },\\n      _ => ()\\n    }\\n    i = i + 1\\n  }\\n  names\\n}\\n\\n// The names of types declared `export` in `stmts` (struct/enum/trait/alias/\\n// suberror). A qualified method `Type::m` whose `Type` is exported is part of\\n// that type's public surface, so it must NOT be module-private-renamed.\\nfn collect_exported_type_names(stmts: Array[Stmt]) -> Array[String] {\\n  let names = empty_strings()\\n  let mut i = 0\\n  while i < Array::length(stmts) {\\n    match Array::get(stmts, i) {\\n      SStruct(true, name, _, _, _, _) => Array::push(names, name),\\n      SEnum(true, name, _, _, _) => Array::push(names, name),\\n      STrait(true, name, _, _, _) => Array::push(names, name),\\n      STypeAlias(true, name, _, _) => Array::push(names, name),\\n      SSuberror(true, name, _) => Array::push(names, name),\\n      _ => ()\\n    }\\n    i = i + 1\\n  }\\n  names\\n}\\n\\n// The names of ALL types declared in `stmts` (exported or not). Used with\\n// collect_exported_type_names to decide which qualified methods are private.\\nfn collect_declared_type_names(stmts: Array[Stmt]) -> Array[String] {\\n  let names = empty_strings()\\n  let mut i = 0\\n  while i < Array::length(stmts) {\\n    match Array::get(stmts, i) {\\n      SStruct(_, name, _, _, _, _) => Array::push(names, name),\\n      SEnum(_, name, _, _, _) => Array::push(names, name),\\n      STrait(_, name, _, _, _) => Array::push(names, name),\\n      STypeAlias(_, name, _, _) => Array::push(names, name),\\n      SSuberror(_, name, _) => Array::push(names, name),\\n      _ => ()\\n    }\\n    i = i + 1\\n  }\\n  names\\n}\\n\\n// A qualified `Head::member` value (an impl/trait method `let Type::m = ..`)\\n// on a PUBLIC receiver type. Such methods are resolved globally by the\\n// receiver type and are referenced unqualified by that type's name, so\\n// path-suffixing them in an imported module (`Strm::next` -> `Strm::next$path`)\\n// would orphan them from `Strm` — breaking method dispatch and the trait /\\n// `for`-iterator desugar's `Type::method` lookup. Public means the head is\\n// either exported from this module OR not declared in it at all — the latter\\n// covers impls on BUILTIN types (`impl Iterable for Array` desugars to a\\n// non-exported `let Array::iter_length = ..` whose head \\\"Array\\\" no module\\n// declares; #736 hit this when the prelude's builtin Iterable impls were\\n// private-renamed and orphaned from the witness dispatch). Only methods whose\\n// head is a type declared in this module and NOT exported keep the old\\n// whole-name renaming: that private type is itself renamed and its call sites\\n// are rewritten through the same value-rename map, so they stay consistent.\\nfn qualified_method_of_exported_type(name: String, exported_types: Array[String], declared_types: Array[String]) -> Bool {\\n  let idx = String::index_of(name, \\\"::\\\")\\n  if idx < 0 {\\n    false\\n  } else {\\n    let head = String::substring(name, 0, idx)\\n    if string_array_contains(exported_types, head) {\\n      true\\n    } else {\\n      !string_array_contains(declared_types, head)\\n    }\\n  }\\n}\\n\\nfn collect_private_value_renames(path: String, stmts: Array[Stmt], namespace_suffix_box: Array[String], exported: Array[String]) -> Array[(String, String)] {\\n  let renames = empty_aliases()\\n  let exported_types = collect_exported_type_names(stmts)\\n  let declared_types = collect_declared_type_names(stmts)\\n  let mut i = 0\\n  while i < Array::length(stmts) {\\n    match Array::get(stmts, i) {\\n      SLet(false, _, name, _, _) => if !string_array_contains(exported, name) && !qualified_method_of_exported_type(name, exported_types, declared_types) {\\n        Array::push(renames, (name, namespace_private_name_lazy(path, name, namespace_suffix_box)))\\n      },\\n      SLetMut(name, _, _) => if !string_array_contains(exported, name) {\\n        Array::push(renames, (name, namespace_private_name_lazy(path, name, namespace_suffix_box)))\\n      },\\n      _ => ()\\n    }\\n    i = i + 1\\n  }\\n  renames\\n}\\n\\nfn rewrite_private_type_expr(ty: TypeExpr, renames: Array[(String, String)]) -> TypeExpr {\\n  match ty {\\n    TyName(name) => match lookup_alias(renames, name) {\\n      Some(renamed) => TyName(renamed),\\n      None => ty\\n    },\\n    TyApp(name, args) => {\\n      let next_name = match lookup_alias(renames, name) {\\n        Some(renamed) => renamed,\\n        None => name\\n      }\\n      TyApp(next_name, for arg in args {\\n        rewrite_private_type_expr(arg, renames)\\n      })\\n    },\\n    TyFn(params, ret, effect_name) => TyFn(\\n      for param in params {\\n        rewrite_private_type_expr(param, renames)\\n      },\\n      rewrite_private_type_expr(ret, renames),\\n      effect_name\\n    ),\\n    TyTuple(items) => TyTuple(for item in items {\\n      rewrite_private_type_expr(item, renames)\\n    }),\\n    TyUnit => ty\\n  }\\n}\\n\\nfn rewrite_private_type_opt(ty: Option[TypeExpr], renames: Array[(String, String)]) -> Option[TypeExpr] {\\n  match ty {\\n    Some(inner) => Some(rewrite_private_type_expr(inner, renames)),\\n    None => None\\n  }\\n}\\n\\nfn rewrite_private_params(params: Array[(String, Option[TypeExpr])], type_renames: Array[(String, String)]) -> Array[(String, Option[TypeExpr])] {\\n  for param in params {\\n    let (name, ty) = param\\n    (name, rewrite_private_type_opt(ty, type_renames))\\n  }\\n}\\n\\nfn rewrite_private_type_ctor_pat(pat: Pat, type_renames: Array[(String, String)], ctor_renames: Array[(String, String)]) -> Pat {\\n  match pat {\\n    PCtor(name, pats) => {\\n      let next_name = match lookup_alias(ctor_renames, name) {\\n        Some(renamed) => renamed,\\n        None => name\\n      }\\n      PCtor(next_name, for item in pats {\\n        rewrite_private_type_ctor_pat(item, type_renames, ctor_renames)\\n      })\\n    },\\n    PTuple(pats) => PTuple(for item in pats {\\n      rewrite_private_type_ctor_pat(item, type_renames, ctor_renames)\\n    }),\\n    POr(left, right) => POr(\\n      rewrite_private_type_ctor_pat(left, type_renames, ctor_renames),\\n      rewrite_private_type_ctor_pat(right, type_renames, ctor_renames)\\n    ),\\n    PStruct(name, fields) => {\\n      let next_name = match lookup_alias(type_renames, name) {\\n        Some(renamed) => renamed,\\n        None => name\\n      }\\n      PStruct(next_name, for field in fields {\\n        let (field_name, field_pat) = field\\n        (field_name, rewrite_private_type_ctor_pat(field_pat, type_renames, ctor_renames))\\n      })\\n    },\\n    _ => pat\\n  }\\n}\\n\\nfn rewrite_private_type_ctor_expr(expr: Expr, type_renames: Array[(String, String)], ctor_renames: Array[(String, String)]) -> Expr {\\n  match expr {\\n    EIdent(name, _) => match lookup_alias(ctor_renames, name) {\\n      Some(renamed) => EIdent(renamed, -1),\\n      None => expr\\n    },\\n    ETuple(items) => ETuple(for item in items {\\n      rewrite_private_type_ctor_expr(item, type_renames, ctor_renames)\\n    }),\\n    EArray(items) => EArray(for item in items {\\n      rewrite_private_type_ctor_expr(item, type_renames, ctor_renames)\\n    }),\\n    ERecord(rn, fields, targs) => {\\n      // #810: the struct-literal name now travels in the AST — rename it\\n      // alongside the type (same as PStruct below), or the checker's named\\n      // field validation would see the pre-rename spelling after merge.\\n      let next_rn = match lookup_alias(type_renames, rn) {\\n        Some(renamed) => renamed,\\n        None => rn\\n      }\\n      // #886: explicit struct type arguments are TypeExprs and may mention\\n      // renamed private types — rewrite them like any other type position.\\n      ERecord(next_rn, for field in fields {\\n        let (name, value) = field\\n        (name, rewrite_private_type_ctor_expr(value, type_renames, ctor_renames))\\n      }, for ta in targs {\\n        rewrite_private_type_expr(ta, type_renames)\\n      })\\n    },\\n    EIf(cond, then_expr, else_expr) => EIf(\\n      rewrite_private_type_ctor_expr(cond, type_renames, ctor_renames),\\n      rewrite_private_type_ctor_expr(then_expr, type_renames, ctor_renames),\\n      rewrite_private_type_ctor_expr(else_expr, type_renames, ctor_renames)\\n    ),\\n    ELet(name, value, body, soff) => ELet(\\n      name,\\n      rewrite_private_type_ctor_expr(value, type_renames, ctor_renames),\\n      rewrite_private_type_ctor_expr(body, type_renames, alias_map_without_name(ctor_renames, name)),\\n      soff\\n    ),\\n    ELetRec(name, value, body) => {\\n      let body_ctors = alias_map_without_name(ctor_renames, name)\\n      ELetRec(\\n        name,\\n        rewrite_private_type_ctor_expr(value, type_renames, body_ctors),\\n        rewrite_private_type_ctor_expr(body, type_renames, body_ctors)\\n      )\\n    },\\n    ELetMut(name, value, body, soff) => ELetMut(\\n      name,\\n      rewrite_private_type_ctor_expr(value, type_renames, ctor_renames),\\n      rewrite_private_type_ctor_expr(body, type_renames, alias_map_without_name(ctor_renames, name)),\\n      soff\\n    ),\\n    EAssign(name, value, body) => EAssign(\\n      name,\\n      rewrite_private_type_ctor_expr(value, type_renames, ctor_renames),\\n      rewrite_private_type_ctor_expr(body, type_renames, ctor_renames)\\n    ),\\n    EAssignOp(name, op, value, body) => EAssignOp(\\n      name,\\n      op,\\n      rewrite_private_type_ctor_expr(value, type_renames, ctor_renames),\\n      rewrite_private_type_ctor_expr(body, type_renames, ctor_renames)\\n    ),\\n    ESeq(left, right) => ESeq(\\n      rewrite_private_type_ctor_expr(left, type_renames, ctor_renames),\\n      rewrite_private_type_ctor_expr(right, type_renames, ctor_renames)\\n    ),\\n    EMatch(scrutinee, arms) => EMatch(\\n      rewrite_private_type_ctor_expr(scrutinee, type_renames, ctor_renames),\\n      for arm in arms {\\n        let (pat, body) = arm\\n        let next_pat = rewrite_private_type_ctor_pat(pat, type_renames, ctor_renames)\\n        (next_pat, rewrite_private_type_ctor_expr(body, type_renames, alias_map_without_pat(ctor_renames, next_pat)))\\n      }\\n    ),\\n    EHandle(body, arms) => EHandle(\\n      rewrite_private_type_ctor_expr(body, type_renames, ctor_renames),\\n      for arm in arms {\\n        let (pat, arm_body) = arm\\n        let next_pat = rewrite_private_type_ctor_pat(pat, type_renames, ctor_renames)\\n        (next_pat, rewrite_private_type_ctor_expr(arm_body, type_renames, alias_map_without_pat(ctor_renames, next_pat)))\\n      }\\n    ),\\n    EWhile(cond, body) => EWhile(\\n      rewrite_private_type_ctor_expr(cond, type_renames, ctor_renames),\\n      rewrite_private_type_ctor_expr(body, type_renames, ctor_renames)\\n    ),\\n    ELoop(params, body) => {\\n      let out_params = for param in params {\\n        let (name, init) = param\\n        (name, rewrite_private_type_ctor_expr(init, type_renames, ctor_renames))\\n      }\\n      let mut body_ctors = ctor_renames\\n      let mut i = 0\\n      while i < Array::length(params) {\\n        let (name, _) = Array::get(params, i)\\n        body_ctors = alias_map_without_name(body_ctors, name)\\n        i = i + 1\\n      }\\n      ELoop(out_params, rewrite_private_type_ctor_expr(body, type_renames, body_ctors))\\n    },\\n    EForIn(name, index_name, iter, body) => {\\n      let body_ctors = match index_name {\\n        Some(index_name) => alias_map_without_name(alias_map_without_name(ctor_renames, name), index_name),\\n        None => alias_map_without_name(ctor_renames, name)\\n      }\\n      EForIn(\\n        name,\\n        index_name,\\n        rewrite_private_type_ctor_expr(iter, type_renames, ctor_renames),\\n        rewrite_private_type_ctor_expr(body, type_renames, body_ctors)\\n      )\\n    },\\n    ECall(callee, args, off) => ECall(\\n      rewrite_private_type_ctor_expr(callee, type_renames, ctor_renames),\\n      for arg in args {\\n        rewrite_private_type_ctor_expr(arg, type_renames, ctor_renames)\\n      },\\n      off\\n    ),\\n    EBinOp(op, left, right) => EBinOp(\\n      op,\\n      rewrite_private_type_ctor_expr(left, type_renames, ctor_renames),\\n      rewrite_private_type_ctor_expr(right, type_renames, ctor_renames)\\n    ),\\n    EUnaryOp(op, value) => EUnaryOp(op, rewrite_private_type_ctor_expr(value, type_renames, ctor_renames)),\\n    EFn(type_params, bounds, params, ret_ty, effect, body) => EFn(\\n      type_params,\\n      bounds,\\n      rewrite_private_params(params, type_renames),\\n      rewrite_private_type_opt(ret_ty, type_renames),\\n      effect,\\n      rewrite_private_type_ctor_expr(body, type_renames, alias_map_without_params(ctor_renames, params))\\n    ),\\n    EDot(obj, field, off, fdoff) => EDot(rewrite_private_type_ctor_expr(obj, type_renames, ctor_renames), field, off, fdoff),\\n    ELabeledArg(label, name, body) => ELabeledArg(label, name, rewrite_private_type_ctor_expr(body, type_renames, ctor_renames)),\\n    EReturn(value) => EReturn(rewrite_private_type_ctor_expr(value, type_renames, ctor_renames)),\\n    EBreak(value) => match value {\\n      Some(value) => EBreak(Some(rewrite_private_type_ctor_expr(value, type_renames, ctor_renames))),\\n      None => expr\\n    },\\n    EContinue(values) => EContinue(for value in values {\\n      rewrite_private_type_ctor_expr(value, type_renames, ctor_renames)\\n    }),\\n    EMap(fields) => EMap(for field in fields {\\n      let (name, value) = field\\n      (name, rewrite_private_type_ctor_expr(value, type_renames, ctor_renames))\\n    }),\\n    ESpread(value) => ESpread(rewrite_private_type_ctor_expr(value, type_renames, ctor_renames)),\\n    _ => expr\\n  }\\n}\\n\\nfn collect_private_type_renames(path: String, stmts: Array[Stmt], namespace_suffix_box: Array[String], exported: Array[String]) -> Array[(String, String)] {\\n  let renames = empty_aliases()\\n  let mut i = 0\\n  while i < Array::length(stmts) {\\n    match Array::get(stmts, i) {\\n      SEnum(false, name, _, _, _) => if !string_array_contains(exported, name) {\\n        Array::push(renames, (name, namespace_private_name_lazy(path, name, namespace_suffix_box)))\\n      },\\n      SStruct(false, name, _, _, _, _) => if !string_array_contains(exported, name) {\\n        Array::push(renames, (name, namespace_private_name_lazy(path, name, namespace_suffix_box)))\\n      },\\n      STypeAlias(false, name, _, _) => if !string_array_contains(exported, name) {\\n        Array::push(renames, (name, namespace_private_name_lazy(path, name, namespace_suffix_box)))\\n      },\\n      SSuberror(false, name, _) => if !string_array_contains(exported, name) {\\n        Array::push(renames, (name, namespace_private_name_lazy(path, name, namespace_suffix_box)))\\n      },\\n      _ => ()\\n    }\\n    i = i + 1\\n  }\\n  renames\\n}\\n\\nfn collect_private_ctor_renames(path: String, stmts: Array[Stmt], type_renames: Array[(String, String)], namespace_suffix_box: Array[String], exported: Array[String]) -> Array[(String, String)] {\\n  let renames = empty_aliases()\\n  let mut i = 0\\n  while i < Array::length(stmts) {\\n    match Array::get(stmts, i) {\\n      SEnum(false, type_name, _, ctors, _) => if !string_array_contains(exported, type_name) {\\n        let mut j = 0\\n        while j < Array::length(ctors) {\\n          let (ctor_name, _) = Array::get(ctors, j)\\n          Array::push(renames, (ctor_name, namespace_private_name_lazy(path, ctor_name, namespace_suffix_box)))\\n          j = j + 1\\n        }\\n      },\\n      SSuberror(false, type_name, ctors) => if !string_array_contains(exported, type_name) {\\n        let mut j = 0\\n        while j < Array::length(ctors) {\\n          let (ctor_name, _) = Array::get(ctors, j)\\n          Array::push(renames, (ctor_name, namespace_private_name_lazy(path, ctor_name, namespace_suffix_box)))\\n          j = j + 1\\n        }\\n      },\\n      _ => ()\\n    }\\n    i = i + 1\\n  }\\n  type_renames\\n  renames\\n}\\n\\nexport fn namespace_private_value_stmts(path: String, stmts: Array[Stmt]) -> Array[Stmt] {\\n  let namespace_private_type_ctor_stmt_local: (Stmt, Array[(String, String)], Array[(String, String)]) -> Stmt = (stmt, type_renames, ctor_renames) -> {\\n    match stmt {\\n      SLet(exported, is_rec, name, ty, body) => SLet(\\n        exported,\\n        is_rec,\\n        name,\\n        rewrite_private_type_opt(ty, type_renames),\\n        rewrite_private_type_ctor_expr(body, type_renames, alias_map_without_name(ctor_renames, name))\\n      ),\\n      SLetMut(name, ty, body) => SLetMut(\\n        name,\\n        rewrite_private_type_opt(ty, type_renames),\\n        rewrite_private_type_ctor_expr(body, type_renames, alias_map_without_name(ctor_renames, name))\\n      ),\\n      SEnum(exported, name, params, ctors, derives) => {\\n        let next_name = if exported {\\n          name\\n        } else {\\n          match lookup_alias(type_renames, name) {\\n            Some(renamed) => renamed,\\n            None => name\\n          }\\n        }\\n        SEnum(exported, next_name, params, for ctor in ctors {\\n          let (ctor_name, args) = ctor\\n          let next_ctor = if exported {\\n            ctor_name\\n          } else {\\n            match lookup_alias(ctor_renames, ctor_name) {\\n              Some(renamed) => renamed,\\n              None => ctor_name\\n            }\\n          }\\n          (next_ctor, for arg in args {\\n            rewrite_private_type_expr(arg, type_renames)\\n          })\\n        }, derives)\\n      },\\n      SSuberror(exported, name, ctors) => {\\n        let next_name = if exported {\\n          name\\n        } else {\\n          match lookup_alias(type_renames, name) {\\n            Some(renamed) => renamed,\\n            None => name\\n          }\\n        }\\n        SSuberror(exported, next_name, for ctor in ctors {\\n          let (ctor_name, args) = ctor\\n          let next_ctor = if exported {\\n            ctor_name\\n          } else {\\n            match lookup_alias(ctor_renames, ctor_name) {\\n              Some(renamed) => renamed,\\n              None => ctor_name\\n            }\\n          }\\n          (next_ctor, for arg in args {\\n            rewrite_private_type_expr(arg, type_renames)\\n          })\\n        })\\n      },\\n      SStruct(exported, name, fields, derives, mut_fields, tparams) => {\\n        let next_name = if exported {\\n          name\\n        } else {\\n          match lookup_alias(type_renames, name) {\\n            Some(renamed) => renamed,\\n            None => name\\n          }\\n        }\\n        SStruct(exported, next_name, for field in fields {\\n          let (field_name, field_ty) = field\\n          (field_name, rewrite_private_type_expr(field_ty, type_renames))\\n        }, derives, mut_fields, tparams)\\n      },\\n      STypeAlias(exported, name, params, target) => {\\n        let next_name = if exported {\\n          name\\n        } else {\\n          match lookup_alias(type_renames, name) {\\n            Some(renamed) => renamed,\\n            None => name\\n          }\\n        }\\n        STypeAlias(exported, next_name, params, rewrite_private_type_expr(target, type_renames))\\n      },\\n      SImpl(tparams, bounds, trait_name, target_name) => {\\n        let next_target = match lookup_alias(type_renames, target_name) {\\n          Some(renamed) => renamed,\\n          None => target_name\\n        }\\n        SImpl(tparams, bounds, trait_name, next_target)\\n      },\\n      SExternLet(name, ty) => SExternLet(name, rewrite_private_type_expr(ty, type_renames)),\\n      STest(name, body) => STest(name, rewrite_private_type_ctor_expr(body, type_renames, ctor_renames)),\\n      SBench(name, body) => SBench(name, rewrite_private_type_ctor_expr(body, type_renames, ctor_renames)),\\n      SExpr(body) => SExpr(rewrite_private_type_ctor_expr(body, type_renames, ctor_renames)),\\n      SLetPat(pat, body) => {\\n        let next_pat = rewrite_private_type_ctor_pat(pat, type_renames, ctor_renames)\\n        SLetPat(next_pat, rewrite_private_type_ctor_expr(body, type_renames, alias_map_without_pat(ctor_renames, next_pat)))\\n      },\\n      SModule(exported, name, body_stmts) => SModule(exported, name, namespace_private_value_stmts(name, body_stmts)),\\n      SEffectDef(exported, name, params, ops) => SEffectDef(exported, name, params, for op in ops {\\n        let (op_name, op_params, ret_ty) = op\\n        (op_name, for param in op_params {\\n          rewrite_private_type_expr(param, type_renames)\\n        }, rewrite_private_type_expr(ret_ty, type_renames))\\n      }),\\n      _ => stmt\\n    }\\n  }\\n  let namespace_private_stmt_local: (Stmt, Array[(String, String)]) -> Stmt = (stmt, renames) -> {\\n    match stmt {\\n      SLet(exported, is_rec, name, ty, body) => {\\n        let next_name = match lookup_alias(renames, name) {\\n          Some(renamed) => renamed,\\n          None => name\\n        }\\n        SLet(exported, is_rec, next_name, ty, rewrite_import_alias_expr(body, renames))\\n      },\\n      SLetMut(name, ty, body) => {\\n        let next_name = match lookup_alias(renames, name) {\\n          Some(renamed) => renamed,\\n          None => name\\n        }\\n        SLetMut(next_name, ty, rewrite_import_alias_expr(body, renames))\\n      },\\n      STest(name, body) => STest(name, rewrite_import_alias_expr(body, renames)),\\n      SBench(name, body) => SBench(name, rewrite_import_alias_expr(body, renames)),\\n      SExpr(body) => SExpr(rewrite_import_alias_expr(body, renames)),\\n      SLetPat(pat, body) => SLetPat(pat, rewrite_import_alias_expr(body, renames)),\\n      SModule(exported, name, body_stmts) => SModule(exported, name, namespace_private_value_stmts(name, body_stmts)),\\n      _ => stmt\\n    }\\n  }\\n  let namespace_suffix_box = [\\\"\\\"]\\n  let exported = collect_exported_value_names(stmts)\\n  let renames = collect_private_value_renames(path, stmts, namespace_suffix_box, exported)\\n  let value_renamed = if Array::length(renames) == 0 {\\n    stmts\\n  } else {\\n    for stmt in stmts {\\n      namespace_private_stmt_local(stmt, renames)\\n    }\\n  }\\n  let type_renames = collect_private_type_renames(path, value_renamed, namespace_suffix_box, exported)\\n  let ctor_renames = collect_private_ctor_renames(path, value_renamed, type_renames, namespace_suffix_box, exported)\\n  if Array::length(type_renames) == 0 && Array::length(ctor_renames) == 0 {\\n    value_renamed\\n  } else {\\n    for stmt in value_renamed {\\n      namespace_private_type_ctor_stmt_local(stmt, type_renames, ctor_renames)\\n    }\\n  }\\n}\\n\\nfn namespace_private_type_ctor_stmt(stmt: Stmt, type_renames: Array[(String, String)], ctor_renames: Array[(String, String)]) -> Stmt {\\n  match stmt {\\n    SLet(exported, is_rec, name, ty, body) => SLet(\\n      exported,\\n      is_rec,\\n      name,\\n      rewrite_private_type_opt(ty, type_renames),\\n      rewrite_private_type_ctor_expr(body, type_renames, alias_map_without_name(ctor_renames, name))\\n    ),\\n    SLetMut(name, ty, body) => SLetMut(\\n      name,\\n      rewrite_private_type_opt(ty, type_renames),\\n      rewrite_private_type_ctor_expr(body, type_renames, alias_map_without_name(ctor_renames, name))\\n    ),\\n    SEnum(exported, name, params, ctors, derives) => {\\n      let next_name = if exported {\\n        name\\n      } else {\\n        match lookup_alias(type_renames, name) {\\n          Some(renamed) => renamed,\\n          None => name\\n        }\\n      }\\n      SEnum(exported, next_name, params, for ctor in ctors {\\n        let (ctor_name, args) = ctor\\n        let next_ctor = if exported {\\n          ctor_name\\n        } else {\\n          match lookup_alias(ctor_renames, ctor_name) {\\n            Some(renamed) => renamed,\\n            None => ctor_name\\n          }\\n        }\\n        (next_ctor, for arg in args {\\n          rewrite_private_type_expr(arg, type_renames)\\n        })\\n      }, derives)\\n    },\\n    SSuberror(exported, name, ctors) => {\\n      let next_name = if exported {\\n        name\\n      } else {\\n        match lookup_alias(type_renames, name) {\\n          Some(renamed) => renamed,\\n          None => name\\n        }\\n      }\\n      SSuberror(exported, next_name, for ctor in ctors {\\n        let (ctor_name, args) = ctor\\n        let next_ctor = if exported {\\n          ctor_name\\n        } else {\\n          match lookup_alias(ctor_renames, ctor_name) {\\n            Some(renamed) => renamed,\\n            None => ctor_name\\n          }\\n        }\\n        (next_ctor, for arg in args {\\n          rewrite_private_type_expr(arg, type_renames)\\n        })\\n      })\\n    },\\n    SStruct(exported, name, fields, derives, mut_fields, tparams) => {\\n      let next_name = if exported {\\n        name\\n      } else {\\n        match lookup_alias(type_renames, name) {\\n          Some(renamed) => renamed,\\n          None => name\\n        }\\n      }\\n      SStruct(exported, next_name, for field in fields {\\n        let (field_name, field_ty) = field\\n        (field_name, rewrite_private_type_expr(field_ty, type_renames))\\n      }, derives, mut_fields, tparams)\\n    },\\n    STypeAlias(exported, name, params, target) => {\\n      let next_name = if exported {\\n        name\\n      } else {\\n        match lookup_alias(type_renames, name) {\\n          Some(renamed) => renamed,\\n          None => name\\n        }\\n      }\\n      STypeAlias(exported, next_name, params, rewrite_private_type_expr(target, type_renames))\\n    },\\n    SImpl(tparams, bounds, trait_name, target_name) => {\\n      let next_target = match lookup_alias(type_renames, target_name) {\\n        Some(renamed) => renamed,\\n        None => target_name\\n      }\\n      SImpl(tparams, bounds, trait_name, next_target)\\n    },\\n    SExternLet(name, ty) => SExternLet(name, rewrite_private_type_expr(ty, type_renames)),\\n    STest(name, body) => STest(name, rewrite_private_type_ctor_expr(body, type_renames, ctor_renames)),\\n    SBench(name, body) => SBench(name, rewrite_private_type_ctor_expr(body, type_renames, ctor_renames)),\\n    SExpr(body) => SExpr(rewrite_private_type_ctor_expr(body, type_renames, ctor_renames)),\\n    SLetPat(pat, body) => {\\n      let next_pat = rewrite_private_type_ctor_pat(pat, type_renames, ctor_renames)\\n      SLetPat(next_pat, rewrite_private_type_ctor_expr(body, type_renames, alias_map_without_pat(ctor_renames, next_pat)))\\n    },\\n    SModule(exported, name, stmts) => SModule(exported, name, namespace_private_value_stmts(name, stmts)),\\n    SEffectDef(exported, name, params, ops) => SEffectDef(exported, name, params, for op in ops {\\n      let (op_name, op_params, ret_ty) = op\\n      (op_name, for param in op_params {\\n        rewrite_private_type_expr(param, type_renames)\\n      }, rewrite_private_type_expr(ret_ty, type_renames))\\n    }),\\n    _ => stmt\\n  }\\n}\\n\\nfn namespace_private_stmt(stmt: Stmt, renames: Array[(String, String)]) -> Stmt {\\n  match stmt {\\n    SLet(exported, is_rec, name, ty, body) => {\\n      let next_name = match lookup_alias(renames, name) {\\n        Some(renamed) => renamed,\\n        None => name\\n      }\\n      SLet(exported, is_rec, next_name, ty, rewrite_import_alias_expr(body, renames))\\n    },\\n    SLetMut(name, ty, body) => {\\n      let next_name = match lookup_alias(renames, name) {\\n        Some(renamed) => renamed,\\n        None => name\\n      }\\n      SLetMut(next_name, ty, rewrite_import_alias_expr(body, renames))\\n    },\\n    STest(name, body) => STest(name, rewrite_import_alias_expr(body, renames)),\\n    SBench(name, body) => SBench(name, rewrite_import_alias_expr(body, renames)),\\n    SExpr(body) => SExpr(rewrite_import_alias_expr(body, renames)),\\n    SLetPat(pat, body) => SLetPat(pat, rewrite_import_alias_expr(body, renames)),\\n    SModule(exported, name, stmts) => SModule(exported, name, namespace_private_value_stmts(name, stmts)),\\n    _ => stmt\\n  }\\n}\\n\\nfn namespace_private_value_stmts_legacy_ordered(path: String, stmts: Array[Stmt]) -> Array[Stmt] {\\n  let namespace_suffix_box = [\\\"\\\"]\\n  let exported = collect_exported_value_names(stmts)\\n  let renames = collect_private_value_renames(path, stmts, namespace_suffix_box, exported)\\n  let value_renamed = if Array::length(renames) == 0 {\\n    stmts\\n  } else {\\n    for stmt in stmts {\\n      namespace_private_stmt(stmt, renames)\\n    }\\n  }\\n  let type_renames = collect_private_type_renames(path, value_renamed, namespace_suffix_box, exported)\\n  let ctor_renames = collect_private_ctor_renames(path, value_renamed, type_renames, namespace_suffix_box, exported)\\n  if Array::length(type_renames) == 0 && Array::length(ctor_renames) == 0 {\\n    value_renamed\\n  } else {\\n    for stmt in value_renamed {\\n      namespace_private_type_ctor_stmt(stmt, type_renames, ctor_renames)\\n    }\\n  }\\n}\\n\\n//# #716 export-name visibility\\n\\n// The merge flattens every file's top-level statements into one program, so a\\n// bare exported name used to be globally visible: two files exporting the\\n// same name collided (function-table first match, by merge order), an export\\n// shadowing a bare BUILTIN name (float.vibe's `eq`) raced the builtin\\n// fast-path in every file, and any file could call an export it never\\n// imported. The plan below renames EVERY exported value def of a non-entry\\n// file to `name_exp_<path>` at its defining file and rewrites the references\\n// of files that actually `import` it — full import visibility (#716): a name\\n// resolves exactly where it is imported (or defined). The ENTRY file's own\\n// defs and the names its re-export surface resolves to are never renamed:\\n// they are the program's wasm-export / linked-library ABI.\\n\\nexport fn namespace_exported_name(path: String, name: String) -> String {\\n  String::concat(name, String::concat(\\\"_exp_\\\", sanitize_namespace_path(path)))\\n}\\n\\n// Top-level VALUE defs this file exports under a bare (unqualified) name:\\n// `export let f` plus a plain `let f` listed in an `export { ... }` block.\\n// Excludes qualified `Type::method` lets (dispatched globally by receiver\\n// type), `let mut` globals (an `EAssign` target is a plain string the\\n// expression rewriter cannot rename), and extern lets (host import names).\\nexport fn collect_export_def_value_names(stmts: Array[Stmt]) -> Array[String] {\\n  let extern_names = empty_strings()\\n  let let_names = empty_strings()\\n  let exported_lets = empty_strings()\\n  let export_items = empty_strings()\\n  let mut i = 0\\n  while i < Array::length(stmts) {\\n    match Array::get(stmts, i) {\\n      SLet(exported, _, name, _, _) => {\\n        Array::push(let_names, name)\\n        if exported {\\n          Array::push(exported_lets, name)\\n        } else {\\n          ()\\n        }\\n      },\\n      SExternLet(name, _) => Array::push(extern_names, name),\\n      SExport(items) => {\\n        let mut j = 0\\n        while j < Array::length(items) {\\n          Array::push(export_items, Array::get(items, j))\\n          j = j + 1\\n        }\\n      },\\n      _ => ()\\n    }\\n    i = i + 1\\n  }\\n  let out = empty_strings()\\n  let push_def_name: (String) -> Unit = (name) -> {\\n    if String::index_of(name, \\\"::\\\") < 0 && !string_array_contains(extern_names, name) && !string_array_contains(out, name) {\\n      Array::push(out, name)\\n    } else {\\n      ()\\n    }\\n  }\\n  let mut k = 0\\n  while k < Array::length(exported_lets) {\\n    push_def_name(Array::get(exported_lets, k))\\n    k = k + 1\\n  }\\n  let mut m = 0\\n  while m < Array::length(export_items) {\\n    let name = Array::get(export_items, m)\\n    if string_array_contains(let_names, name) {\\n      push_def_name(name)\\n    } else {\\n      ()\\n    }\\n    m = m + 1\\n  }\\n  out\\n}\\n\\nexport struct ExportRenamePlan {\\n  plan_paths: Array[String];\\n  rename_paths: Array[String];\\n  rename_names: Array[String];\\n  rename_mangled: Array[String]\\n}\\n\\n// Resolve a raw import path against the set of files in this merge; a\\n// directory import (`import ./codegen/wasi { .. }`) has two candidates and we\\n// pick the one that is actually part of the program.\\nfn resolve_known_import_path(known_paths: Array[String], base_dir: String, raw_path: String, self_path: String) -> String {\\n  let candidates = resolve_import_path_candidates(base_dir, raw_path)\\n  let mut chosen = \\\"\\\"\\n  let mut i = 0\\n  let mut found = false\\n  while i < Array::length(candidates) && !found {\\n    let candidate = Array::get(candidates, i)\\n    // Never resolve to the importing file itself (`export ./codegen` inside\\n    // codegen.vibe targets the directory) — mirrors header_cache/merge_sources.\\n    if candidate == self_path {\\n      i = i + 1\\n    } else {\\n      if chosen == \\\"\\\" {\\n        chosen = candidate\\n      } else {\\n        ()\\n      }\\n      if string_array_contains(known_paths, candidate) {\\n        chosen = candidate\\n        found = true\\n      } else {\\n        i = i + 1\\n      }\\n    }\\n  }\\n  if chosen == \\\"\\\" {\\n    Array::get(candidates, 0)\\n  } else {\\n    chosen\\n  }\\n}\\n\\nfn plan_triple_lookup(tpaths: Array[String], tnames: Array[String], tvalues: Array[String], path: String, name: String) -> Option[String] {\\n  let mut i = 0\\n  let mut found = None\\n  while i < Array::length(tpaths) {\\n    if Array::get(tpaths, i) == path && Array::get(tnames, i) == name {\\n      found = Some(Array::get(tvalues, i))\\n      i = Array::length(tpaths)\\n    } else {\\n      i = i + 1\\n    }\\n  }\\n  found\\n}\\n\\n// Re-export edges of one file: `export ./dep.vibe { a, b as c }` plus the\\n// `import { x } ... export { x }` facade idiom (an `export {}` item with no\\n// local let def but a matching import). Pushed as parallel arrays\\n// (from-path, public-name, target-path, target-name).\\nfn collect_reexport_edges_into(path: String, stmts: Array[Stmt], known_paths: Array[String], edge_from: Array[String], edge_pub: Array[String], edge_tpath: Array[String], edge_tname: Array[String]) -> Unit {\\n  let base_dir = dir_of_path(path)\\n  let let_names = empty_strings()\\n  let mut i = 0\\n  while i < Array::length(stmts) {\\n    match Array::get(stmts, i) {\\n      SLet(_, _, name, _, _) => Array::push(let_names, name),\\n      SLetMut(name, _, _) => Array::push(let_names, name),\\n      _ => ()\\n    }\\n    i = i + 1\\n  }\\n  let import_refs = collect_import_refs(stmts)\\n  let mut si = 0\\n  while si < Array::length(stmts) {\\n    match Array::get(stmts, si) {\\n      SReExport(raw_path, items) => {\\n        let target = resolve_known_import_path(known_paths, base_dir, raw_path, path)\\n        let mut j = 0\\n        while j < Array::length(items) {\\n          let (iname, alias_opt) = Array::get(items, j)\\n          let public_name = match alias_opt {\\n            Some(alias) => alias,\\n            None => iname\\n          }\\n          Array::push(edge_from, path)\\n          Array::push(edge_pub, public_name)\\n          Array::push(edge_tpath, target)\\n          Array::push(edge_tname, iname)\\n          j = j + 1\\n        }\\n      },\\n      SExport(items) => {\\n        let mut j = 0\\n        while j < Array::length(items) {\\n          let name = Array::get(items, j)\\n          if !string_array_contains(let_names, name) {\\n            let mut ri = 0\\n            let mut done = false\\n            while ri < Array::length(import_refs) && !done {\\n              let (raw_path, original, local) = Array::get(import_refs, ri)\\n              if local == name {\\n                Array::push(edge_from, path)\\n                Array::push(edge_pub, name)\\n                Array::push(edge_tpath, resolve_known_import_path(known_paths, base_dir, raw_path, path))\\n                Array::push(edge_tname, original)\\n                done = true\\n              } else {\\n                ri = ri + 1\\n              }\\n            }\\n          } else {\\n            ()\\n          }\\n          j = j + 1\\n        }\\n      },\\n      _ => ()\\n    }\\n    si = si + 1\\n  }\\n}\\n\\nexport fn build_export_rename_plan(paths: Array[String], stmts_list: Array[Array[Stmt]], entry_path: String) -> ExportRenamePlan {\\n  let file_count = Array::length(paths)\\n  let def_names_list = Array::slice([\\n    empty_strings()\\n  ], 0, 0)\\n  let mut fi = 0\\n  while fi < file_count {\\n    Array::push(def_names_list, collect_export_def_value_names(Array::get(stmts_list, fi)))\\n    fi = fi + 1\\n  }\\n  let edge_from = empty_strings()\\n  let edge_pub = empty_strings()\\n  let edge_tpath = empty_strings()\\n  let edge_tname = empty_strings()\\n  let mut ei = 0\\n  while ei < file_count {\\n    collect_reexport_edges_into(Array::get(paths, ei), Array::get(stmts_list, ei), paths, edge_from, edge_pub, edge_tpath, edge_tname)\\n    ei = ei + 1\\n  }\\n  // The origins of the entry file's re-export surface are program ABI (wasm\\n  // export names of a linked library / component entry) and stay bare.\\n  let excluded_paths = empty_strings()\\n  let excluded_names = empty_strings()\\n  let file_idx_of: (String) -> Int = (path) -> {\\n    let mut i = 0\\n    let mut found = -1\\n    while i < file_count {\\n      if Array::get(paths, i) == path {\\n        found = i\\n        i = file_count\\n      } else {\\n        i = i + 1\\n      }\\n    }\\n    found\\n  }\\n  let mut xi = 0\\n  while xi < Array::length(edge_from) {\\n    if Array::get(edge_from, xi) == entry_path {\\n      let mut cur_path = Array::get(edge_tpath, xi)\\n      let mut cur_name = Array::get(edge_tname, xi)\\n      let mut depth = 0\\n      while depth < 16 {\\n        let idx = file_idx_of(cur_path)\\n        let is_def = if idx < 0 {\\n          false\\n        } else {\\n          string_array_contains(Array::get(def_names_list, idx), cur_name)\\n        }\\n        if is_def {\\n          Array::push(excluded_paths, cur_path)\\n          Array::push(excluded_names, cur_name)\\n          depth = 16\\n        } else {\\n          match plan_triple_lookup(edge_from, edge_pub, edge_tpath, cur_path, cur_name) {\\n            Some(next_path) => {\\n              match plan_triple_lookup(edge_from, edge_pub, edge_tname, cur_path, cur_name) {\\n                Some(next_name) => {\\n                  cur_path = next_path\\n                  cur_name = next_name\\n                  depth = depth + 1\\n                },\\n                None => {\\n                  depth = 16\\n                }\\n              }\\n            },\\n            None => {\\n              depth = 16\\n            }\\n          }\\n        }\\n      }\\n    } else {\\n      ()\\n    }\\n    xi = xi + 1\\n  }\\n  let rename_paths = empty_strings()\\n  let rename_names = empty_strings()\\n  let rename_mangled = empty_strings()\\n  let mut ri = 0\\n  while ri < file_count {\\n    let path = Array::get(paths, ri)\\n    if path == entry_path {\\n      ()\\n    } else {\\n      let def_names = Array::get(def_names_list, ri)\\n      let mut ni = 0\\n      while ni < Array::length(def_names) {\\n        let name = Array::get(def_names, ni)\\n        let excluded = match plan_triple_lookup(excluded_paths, excluded_names, excluded_names, path, name) {\\n          Some(_) => true,\\n          None => false\\n        }\\n        if excluded {\\n          ()\\n        } else {\\n          Array::push(rename_paths, path)\\n          Array::push(rename_names, name)\\n          Array::push(rename_mangled, namespace_exported_name(path, name))\\n        }\\n        ni = ni + 1\\n      }\\n    }\\n    ri = ri + 1\\n  }\\n  // Close the rename table over re-export facades so an import THROUGH a\\n  // facade (`import ./index.vibe { eq }` where index re-exports float's `eq`)\\n  // resolves to the renamed origin in one lookup.\\n  let mut changed = true\\n  while changed {\\n    changed = false\\n    let mut ci = 0\\n    while ci < Array::length(edge_from) {\\n      let from = Array::get(edge_from, ci)\\n      let pub_name = Array::get(edge_pub, ci)\\n      if from == entry_path {\\n        ()\\n      } else {\\n        match plan_triple_lookup(rename_paths, rename_names, rename_mangled, Array::get(edge_tpath, ci), Array::get(edge_tname, ci)) {\\n          Some(mangled) => {\\n            match plan_triple_lookup(rename_paths, rename_names, rename_mangled, from, pub_name) {\\n              Some(_) => (),\\n              None => {\\n                Array::push(rename_paths, from)\\n                Array::push(rename_names, pub_name)\\n                Array::push(rename_mangled, mangled)\\n                changed = true\\n              }\\n            }\\n          },\\n          None => ()\\n        }\\n      }\\n      ci = ci + 1\\n    }\\n  }\\n  ExportRenamePlan::{\\n    plan_paths: paths,\\n    rename_paths: rename_paths,\\n    rename_names: rename_names,\\n    rename_mangled: rename_mangled\\n  }\\n}\\n\\nexport fn export_plan_rename_count(plan: ExportRenamePlan) -> Int {\\n  Array::length(plan.rename_paths)\\n}\\n\\n// (name -> mangled) pairs for the defs of one file.\\nexport fn export_plan_renames_for(plan: ExportRenamePlan, path: String) -> Array[(String, String)] {\\n  let out = empty_aliases()\\n  let rename_paths = plan.rename_paths\\n  let rename_names = plan.rename_names\\n  let rename_mangled = plan.rename_mangled\\n  let mut i = 0\\n  while i < Array::length(rename_paths) {\\n    if Array::get(rename_paths, i) == path {\\n      Array::push(out, (Array::get(rename_names, i), Array::get(rename_mangled, i)))\\n    } else {\\n      ()\\n    }\\n    i = i + 1\\n  }\\n  out\\n}\\n\\n// Deterministic text summary of the plan; callers fold it into merge cache\\n// fingerprints so a rename-set change invalidates cached merged sources.\\nexport fn export_plan_fingerprint_text(plan: ExportRenamePlan) -> String {\\n  let rename_paths = plan.rename_paths\\n  let rename_names = plan.rename_names\\n  let rename_mangled = plan.rename_mangled\\n  let buf = StringBuilder::new()\\n  StringBuilder::push(buf, \\\"export-renames\\\")\\n  let mut i = 0\\n  while i < Array::length(rename_paths) {\\n    StringBuilder::push(buf, \\\"|\\\")\\n    StringBuilder::push(buf, Array::get(rename_paths, i))\\n    StringBuilder::push(buf, \\\">\\\")\\n    StringBuilder::push(buf, Array::get(rename_names, i))\\n    StringBuilder::push(buf, \\\">\\\")\\n    StringBuilder::push(buf, Array::get(rename_mangled, i))\\n    i = i + 1\\n  }\\n  StringBuilder::freeze(buf)\\n}\\n\\n// (local -> mangled) reference renames for one importing file, derived from\\n// its `import` statements against the plan.\\nexport fn collect_import_value_renames(plan: ExportRenamePlan, path: String, stmts: Array[Stmt]) -> Array[(String, String)] {\\n  let out = empty_aliases()\\n  let locals_seen = empty_strings()\\n  let rename_paths = plan.rename_paths\\n  let rename_names = plan.rename_names\\n  let rename_mangled = plan.rename_mangled\\n  if Array::length(rename_paths) == 0 {\\n    out\\n  } else {\\n    let base_dir = dir_of_path(path)\\n    let mut i = 0\\n    while i < Array::length(stmts) {\\n      match Array::get(stmts, i) {\\n        SImport(raw_path, items) => {\\n          let target = resolve_known_import_path(plan.plan_paths, base_dir, raw_path, path)\\n          let mut j = 0\\n          while j < Array::length(items) {\\n            let (original, alias_opt) = Array::get(items, j)\\n            let local = match alias_opt {\\n              Some(alias) => alias,\\n              None => original\\n            }\\n            if String::index_of(original, \\\"::\\\") < 0 && !string_array_contains(locals_seen, local) {\\n              match plan_triple_lookup(rename_paths, rename_names, rename_mangled, target, original) {\\n                Some(mangled) => {\\n                  Array::push(out, (local, mangled))\\n                  Array::push(locals_seen, local)\\n                },\\n                None => ()\\n              }\\n            } else {\\n              ()\\n            }\\n            j = j + 1\\n          }\\n        },\\n        _ => ()\\n      }\\n      i = i + 1\\n    }\\n    out\\n  }\\n}\\n\\nexport fn import_value_rename_locals(renames: Array[(String, String)]) -> Array[String] {\\n  let out = empty_strings()\\n  let mut i = 0\\n  while i < Array::length(renames) {\\n    let (local, _) = Array::get(renames, i)\\n    Array::push(out, local)\\n    i = i + 1\\n  }\\n  out\\n}\\n\\n// Apply (name -> mangled) def renames to one file's statements: SLet def\\n// names, `export { ... }` items, and every value reference (shadow-aware via\\n// rewrite_import_alias_expr).\\nexport fn apply_export_renames_stmts(stmts: Array[Stmt], renames: Array[(String, String)]) -> Array[Stmt] {\\n  if Array::length(renames) == 0 {\\n    stmts\\n  } else {\\n    for stmt in stmts {\\n      match stmt {\\n        SLet(exported, is_rec, name, ty, body) => {\\n          let next_name = match lookup_alias(renames, name) {\\n            Some(renamed) => renamed,\\n            None => name\\n          }\\n          SLet(exported, is_rec, next_name, ty, rewrite_import_alias_expr(body, renames))\\n        },\\n        SLetMut(name, ty, body) => SLetMut(name, ty, rewrite_import_alias_expr(body, renames)),\\n        SExport(items) => SExport(for item in items {\\n          match lookup_alias(renames, item) {\\n            Some(renamed) => renamed,\\n            None => item\\n          }\\n        }),\\n        STest(name, body) => STest(name, rewrite_import_alias_expr(body, renames)),\\n        SBench(name, body) => SBench(name, rewrite_import_alias_expr(body, renames)),\\n        SExpr(body) => SExpr(rewrite_import_alias_expr(body, renames)),\\n        SLetPat(pat, body) => SLetPat(pat, rewrite_import_alias_expr(body, renames)),\\n        _ => stmt\\n      }\\n    }\\n  }\\n}\\n\\n// `export let eq: (Float, Float) -> Bool = float_eq` binds a NAME to another\\n// top-level function. The backend function tables register such non-EFn lets\\n// as 0-parameter thunks, so a CALL through the alias emits N arguments\\n// against a 0-param function — invalid wasm (stack imbalance), on every\\n// backend and for any arity (found while fixing #716: vibe/prelude/float.vibe\\n// exports its whole API this way). Rewrite every reference to a top-level\\n// function alias (chains followed, ≤16) to the final EFn def's name. The\\n// alias def itself stays: it is inert once nothing refers to it, and its\\n// export flag keeps the wasm export surface unchanged.\\nexport fn rewrite_top_level_fn_alias_refs(stmts: Array[Stmt]) -> Unit {\\n  let fn_names = empty_strings()\\n  let alias_names = empty_strings()\\n  let alias_targets = empty_strings()\\n  let mut i = 0\\n  while i < Array::length(stmts) {\\n    match Array::get(stmts, i) {\\n      SLet(_, _, name, _, expr) => match expr {\\n        EFn(_, _, _, _, _, _) => Array::push(fn_names, name),\\n        EIdent(target, _) => {\\n          Array::push(alias_names, name)\\n          Array::push(alias_targets, target)\\n        },\\n        _ => ()\\n      },\\n      _ => ()\\n    }\\n    i = i + 1\\n  }\\n  if Array::length(alias_names) == 0 {\\n    ()\\n  } else {\\n    let renames = empty_aliases()\\n    let mut ai = 0\\n    while ai < Array::length(alias_names) {\\n      let mut target = Array::get(alias_targets, ai)\\n      let mut final_target = \\\"\\\"\\n      let mut depth = 0\\n      while depth < 16 {\\n        if string_array_contains(fn_names, target) {\\n          final_target = target\\n          depth = 16\\n        } else {\\n          let mut hop = false\\n          let mut aj = 0\\n          while aj < Array::length(alias_names) && !hop {\\n            if Array::get(alias_names, aj) == target {\\n              target = Array::get(alias_targets, aj)\\n              hop = true\\n            } else {\\n              aj = aj + 1\\n            }\\n          }\\n          if hop {\\n            depth = depth + 1\\n          } else {\\n            depth = 16\\n          }\\n        }\\n      }\\n      if final_target != \\\"\\\" && final_target != Array::get(alias_names, ai) {\\n        Array::push(renames, (Array::get(alias_names, ai), final_target))\\n      } else {\\n        ()\\n      }\\n      ai = ai + 1\\n    }\\n    if Array::length(renames) == 0 {\\n      ()\\n    } else {\\n      let mut si = 0\\n      while si < Array::length(stmts) {\\n        match Array::get(stmts, si) {\\n          SLet(exported, is_rec, name, ty, body) => Array::set(stmts, si, SLet(exported, is_rec, name, ty, rewrite_import_alias_expr(body, renames))),\\n          SLetMut(name, ty, body) => Array::set(stmts, si, SLetMut(name, ty, rewrite_import_alias_expr(body, renames))),\\n          STest(name, body) => Array::set(stmts, si, STest(name, rewrite_import_alias_expr(body, renames))),\\n          SBench(name, body) => Array::set(stmts, si, SBench(name, rewrite_import_alias_expr(body, renames))),\\n          SExpr(body) => Array::set(stmts, si, SExpr(rewrite_import_alias_expr(body, renames))),\\n          SLetPat(pat, body) => Array::set(stmts, si, SLetPat(pat, rewrite_import_alias_expr(body, renames))),\\n          _ => ()\\n        }\\n        si = si + 1\\n      }\\n    }\\n  }\\n}\\n\\n// Like append_import_alias_rewritten_non_import_stmts_skipping, but with\\n// extra (local -> mangled) import-value renames applied in the same pass.\\n// Locals covered by `extra_renames` are removed from the legacy alias map\\n// (which would rewrite alias -> original instead).\\nexport fn append_import_alias_rewritten_non_import_stmts_with_renames(merged: Array[Stmt], stmts: Array[Stmt], skipped_locals: Array[String], extra_renames: Array[(String, String)]) -> Unit {\\n  let legacy = alias_map_without_names(\\n    alias_map_without_names(collect_import_aliases(stmts), skipped_locals),\\n    import_value_rename_locals(extra_renames)\\n  )\\n  let combined = empty_aliases()\\n  let mut li = 0\\n  while li < Array::length(legacy) {\\n    Array::push(combined, Array::get(legacy, li))\\n    li = li + 1\\n  }\\n  let mut xi = 0\\n  while xi < Array::length(extra_renames) {\\n    Array::push(combined, Array::get(extra_renames, xi))\\n    xi = xi + 1\\n  }\\n  let should_rewrite = Array::length(combined) > 0\\n  let mut i = 0\\n  while i < Array::length(stmts) {\\n    let stmt = Array::get(stmts, i)\\n    match stmt {\\n      SImport(_, _) => (),\\n      SReExport(_, _) => (),\\n      SAliasDecl(_, _) => (),\\n      SModule(_, _, _) => Array::push(merged, rewrite_import_alias_stmt(stmt, combined)),\\n      _ => if should_rewrite {\\n        Array::push(merged, rewrite_import_alias_stmt(stmt, combined))\\n      } else {\\n        Array::push(merged, stmt)\\n      }\\n    }\\n    i = i + 1\\n  }\\n}\\n\")\n}\n\nlet cli_adapter_source_22 = () -> (String, String) {\n  (\"lib/@vibe/compiler/core/index.vibe\",\n\"export ./ast.vibe {\\n  Expr, Pat, Stmt, TypeExpr\\n}\\n\\nexport ./polyfill.vibe {\\n  __to_string\\n}\\n\\nexport ./bytebuf.vibe {\\n  bytebuf_new, bytebuf_push, bytebuf_length, bytebuf_to_bytes, leb128_encode_s32, leb128_encode_s64, leb128_encode_u32, bytebuf_push_section, bytebuf_push_vec_header, bytebuf_push_buf, bytebuf_push2, bytebuf_push3, bytebuf_push9, bytebuf_push_opcode_u32, bytebuf_push_opcode_s64, bytebuf_push_opcode_u32_u32, bytebuf_push_string\\n}\\n\\nexport ./dce.vibe {\\n  dce_stmts, dce_keep_flags\\n}\\n\\nexport ./types.vibe {\\n  Type, TypeDef, TypeEnv, Subst, env_bind, fresh_var, occurs_in, env_lookup, env_cache, env_flat_bindings, env_lookup_flat, types_equal, env_bind_all, find_typedef, subst_lookup, subst_apply, unify, trait_supers, collect_tvars, generalize, trait_defined, type_to_string, resolve_builtin, subst_add_bound, instantiate, types_compatible, impls_overlap_for, trait_is_subtrait, type_implements_trait, collect_subst_bounds_pairs, subst_bounds_for, trait_method_sig, trait_method_sig_deep, type_name_has_iterator_impl\\n}\\n\\nexport ./import_alias_rewrite.vibe {\\n  ExportRenamePlan, append_import_alias_rewritten_non_import_stmts, append_import_alias_rewritten_non_import_stmts_skipping, append_import_alias_rewritten_non_import_stmts_with_renames, append_non_import_stmts_without_alias_rewrite, apply_export_renames_stmts, build_export_rename_plan, collect_export_def_value_names, collect_import_aliases, collect_import_alias_collision_locals, collect_import_alias_collision_refs, collect_import_value_renames, export_plan_fingerprint_text, export_plan_rename_count, export_plan_renames_for, import_value_rename_locals, namespace_exported_name, namespace_private_value_stmts, rewrite_imported_value_stmt_to_local, rewrite_import_alias_expr, rewrite_import_alias_stmt, rewrite_top_level_fn_alias_refs, stmts_have_import_deep\\n}\\n\\nexport ./sorted_index.vibe {\\n  str_lt, sort_perm_by_names, apply_perm_strings, sorted_names_of, bsearch_leftmost\\n}\\n\\nexport let version = \\\"0.0.1\\\"\\n\")\n}\n\nlet cli_adapter_source_23 = () -> (String, String) {\n  (\"lib/@vibe/compiler/bytebuf.vibe\",\n\"//# Imports\\n\\nexport ./core {\\n  bytebuf_length, bytebuf_new, bytebuf_push, bytebuf_push2, bytebuf_push3, bytebuf_push9, bytebuf_push_buf, bytebuf_push_opcode_s64, bytebuf_push_opcode_u32, bytebuf_push_opcode_u32_u32, bytebuf_push_section, bytebuf_push_string, bytebuf_push_vec_header, bytebuf_to_bytes, leb128_encode_s32, leb128_encode_s64, leb128_encode_u32\\n}\\n\\n//# Misc\\n\\nexport {\\n  bytebuf_new, bytebuf_push, bytebuf_length, bytebuf_to_bytes, leb128_encode_s32, leb128_encode_s64, leb128_encode_u32, bytebuf_push_section, bytebuf_push_vec_header, bytebuf_push_buf, bytebuf_push2, bytebuf_push3, bytebuf_push9, bytebuf_push_opcode_u32, bytebuf_push_opcode_s64, bytebuf_push_opcode_u32_u32, bytebuf_push_string\\n}\\n\\nexport {\\n  bytebuf_new, bytebuf_push, bytebuf_push2, bytebuf_push3, bytebuf_push9, bytebuf_length, bytebuf_push_buf, bytebuf_to_bytes, leb128_encode_s32, leb128_encode_s64, leb128_encode_u32, bytebuf_push_string, bytebuf_push_section, bytebuf_push_opcode_s64, bytebuf_push_opcode_u32, bytebuf_push_vec_header, bytebuf_push_opcode_u32_u32\\n}\\n\")\n}\n\nlet cli_adapter_source_24 = () -> (String, String) {\n  (\"lib/@vibe/compiler/syntax/index.vibe\",\n\"//# Imports\\n\\n// #753 (ADR-0065 Phase 3): the lexer/parser/printer live in the\\n// @vibe/parser contract package; this module is a re-export shim so the\\n// compiler's existing import spellings keep working.\\nimport ../../../../lib/@vibe/parser {\\n  Token, double_to_string_compiler, lex, lex_ok, lex_with_offsets, lex_with_offsets_recovering, offset_to_line_col, parse, parse_expr, parse_ok, parse_program, parse_program_located, parse_program_preserving, parse_program_recovering, parse_program_spans, parse_stmt, parse_stmt_preserving, print_expr, print_pat, print_program, print_stmt, print_type_expr, token_to_string, parse_type, peek, tk_name, skip_semi, collect_import_path, parse_fn_signature\\n}\\n\\n//# Misc\\n\\nexport {\\n  Token, double_to_string_compiler, lex, lex_ok, lex_with_offsets, lex_with_offsets_recovering, offset_to_line_col, parse, parse_expr, parse_ok, parse_program, parse_program_located, parse_program_preserving, parse_program_recovering, parse_program_spans, parse_s