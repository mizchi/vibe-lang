let selfhost_source_80 = () -> (String, String) {
  ("lib/@vibe/compiler/codegen/expr/compile_expr_tail5.vibe",
"\n\n\n\n\n\n\n\n\n\n\n\nexport fn compile_expr_tail5(buf: Bytes, expr: Expr, local_names: Array[String], next_local: Int, ctx: CompileCtx, ld: Int, compile_expr: (Bytes, Expr, Array[String], Int, CompileCtx, Int) -> Int with { Error }) -> Int with { Error } {\n  match expr {\n    EForIn(_, _, _, _) => throw(\"unsupported expression in codegen: EForIn\"),\n    EHandle(body, arms) => compile_expr_tail6(buf, body, arms, local_names, next_local, ctx, ld, compile_expr)\n    ,\n    EStringInterp(parts) => compile_expr_tail7(buf, parts, local_names, next_local, ctx, ld, compile_expr)\n    ,\n    ELabeledArg(_, _, val) => compile_expr(buf, val, local_names, next_local, ctx, ld)\n    ,\n    _ => throw(\"unsupported expression in codegen: unknown\")\n  }\n}\n")
}

