let mut ii = 0\n  while ii < import_count {\n    let im = Array::get(imp_modules, ii)\n    let ifn = Array::get(imp_names, ii)\n    if im == \"wasi_snapshot_preview1\" && ifn == \"fd_write\" {\n      ()\n    } else if im == \"vibe\" && (comp_is_host_future_get_import(ifn) || ifn == \"host_future_wait\" || comp_is_host_stream_get_import(ifn) || ifn == \"host_stream_read\" || ifn == \"host_stream_close\") {\n      ()\n    } else {\n      throw(\"component(async-hostfuture): core module uses host import '\\{im}.\\{ifn}' (only fd_write and the host-future/host-stream imports are satisfiable in this composition)\")\n    }\n    ii = ii + 1\n  }\n  let hf_names = comp_core_host_future_names(main_core_wasm)\n  let nhf = Array::length(hf_names)\n  let hs_names = comp_core_host_stream_names(main_core_wasm)\n  let hs_wants_close = comp_core_imports_host_stream_close(main_core_wasm)\n  let nhs = Array::length(hs_names)\n  let nt = nhf + nhs\n  if nt == 0 {\n    throw(\"component(async-hostfuture): core module imports no vibe.host_future_get[$name] / vibe.host_stream_get$name (this wrap is keyed on those imports)\")\n  } else {\n    ()\n  }\n  let buf = bytebuf_new()\n  emit_component_header(buf)\n  let future_type_idx = 0\n  let fut_functype_idx = 1\n  if nhf > 0 {\n    emit_comp_future_type_section(buf, comp_valtype_u32)\n    emit_comp_async_functype_section_result_type(buf, future_type_idx)\n  } else {\n    ()\n  }\n  let stream_type_idx = if nhf > 0 {\n    2\n  } else {\n    0\n  }\n  let stream_functype_idx = stream_type_idx + 1\n  if nhs > 0 {\n    emit_comp_stream_type_section(buf, comp_valtype_u8)\n    emit_comp_async_functype_section_result_type(buf, stream_type_idx)\n  } else {\n    ()\n  }\n  let export_functype_idx = if nhs > 0 {\n    stream_functype_idx + 1\n  } else {\n    fut_functype_idx + 1\n  }\n  let mut himp_i = 0\n  while himp_i < nhf {\n    emit_comp_import_section_typed(buf, comp_hostfuture_import_label(Array::get(hf_names, himp_i)), fut_functype_idx)\n   