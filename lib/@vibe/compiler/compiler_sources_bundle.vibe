let source_238 = () -> (String, String) {
  ("lib/@vibe/compiler/entry/source_compile/wasi_only/preprocess_interp_string_collect.vibe",
"\nimport @vibe/compiler/core {\n  Expr\n}\n\nimport @vibe/compiler/syntax {\n  lex\n}\n\n\nexport fn collect_interp_exprs(parts: Array[String]) -> Array[Expr] with { Error } {\n  let plen = Array::length(parts)\n  let exprs = ArrayBuilder::new()\n  let mut i = 0\n  while i < plen {\n    let lit = Array::get(parts, i)\n    if String::length(lit) > 0 {\n      ArrayBuilder::push(exprs, EString(lit))\n    }\n    if i + 1 < plen {\n      let expr_src = Array::get(parts, i + 1)\n      let part_tokens = lex(expr_src)\n      let part_expr = parse_interp_expr(part_tokens)\n      ArrayBuilder::push(exprs, ECall(EIdent(\"__to_string\", -1), [\n        part_expr\n      ], -1))\n    }\n    i = i + 2\n  }\n  ArrayBuilder::freeze(exprs)\n}\n")
}

