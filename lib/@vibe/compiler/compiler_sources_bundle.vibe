\n    } else {\\n      compile_expr(buf, fallback_expr, local_names, Array::length(local_names), ctx, ld)\\n    }\\n    emit_end(buf)\\n    emit_br(buf, 2)\\n    emit_end(buf)\\n    emit_drop(buf)\\n    emit_br(buf, 0)\\n    emit_end(buf)\\n    bytebuf_push(buf, 0)\\n    emit_end(buf)\\n    // #965: retire everything this handle introduced (payload binds,\\n    // __eff_raw/__eff_payload temps, arm-body lets) before compilation\\n    // continues past the handle expression — same last-wins leak one level\\n    // out. Indices stay allocated (no truncate, #665).\\n    let mut post_mask_i = body_names_start\\n    while post_mask_i < Array::length(local_names) {\\n      Array::set(local_names, post_mask_i, \\\"\\\")\\n      post_mask_i = post_mask_i + 1\\n    }\\n    Array::truncate(ctx.ref_cell_names, body_ref_cells_start)\\n    nl2\\n  } else {\\n    compile_expr(buf, body, local_names, next_local, ctx, ld)\\n  }\\n}\\n\")\n}\n\nlet cli_adapter_source_79 = () -> (String, String) {\n  (\"lib/@vibe/compiler/codegen/expr/compile_expr_tail5.vibe\",\n\"//# Imports\\n\\nimport ../../core {\\n  Expr, Pat, Stmt, TypeExpr, bytebuf_length, bytebuf_new, bytebuf_push, bytebuf_push_section, bytebuf_push_vec_header, bytebuf_to_bytes, leb128_encode_s64, leb128_encode_u32\\n}\\n\\nimport ../common_analysis {\\n  collect_free_vars, collect_strings_stmts, emit_closure_call_tail, emit_closure_resolve, emit_i64_extend_i32_u, is_mut_captured_in\\n}\\n\\nimport ../common_base {\\n  CompileCtx, CtorTable, FuncTable, LambdaTable, StrTable, emit_binop_op, emit_i32_eq, emit_i32_eqz, emit_i32_ge_u, emit_i32_mul, emit_i32_ne, emit_i32_sub, emit_i64_load, emit_i64_store, emit_str_ref, expr_tag, get_arm_body, get_arm_pat, get_ebinop_op, get_efn_body, get_eif_cond, get_eif_else, get_eif_then, get_elet_body, get_elet_name, get_elet_val, get_slet_expr, get_slet_name, is_efn, is_eident, is_etuple, is_pbind, is_pbool, is_pctor, is_pint, is_pstring, is_ptuple, is_pwild, is_slet, lookup_ctor, resolve_fu