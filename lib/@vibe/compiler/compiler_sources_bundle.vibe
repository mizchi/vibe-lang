"\n\n\n\n\n\n\n\n\n\n\nexport fn compile_expr_tail3(buf: Bytes, expr: Expr, local_names: Array[String], next_local: Int, ctx: CompileCtx, ld: Int, compile_expr: (Bytes, Expr, Array[String], Int, CompileCtx, Int) -> Int with { Error }) -> Int with { Error } {\n  let __tag = expr_tag(expr)\n  if __tag == 19 {\n    let cond = get_ewhile_cond(expr)\n    let body = get_ewhile_body(expr)\n    let lb_base = Array::length(ctx.loop_borrowed_names)\n    if ctx.enable_rc {\n      let mut lbi = 0\n      while lbi < Array::length(local_names) {\n        Array::push(ctx.loop_borrowed_names, Array::get(local_names, lbi))\n        lbi = lbi + 1\n      }\n    } else {\n      ()\n    }\n    emit_block_void(buf)\n    emit_loop_void(buf)\n    let w_ld_in = 0\n    let w_cond_tag = expr_tag(cond)\n    let nl1 = if w_cond_tag == 5 {\n      let wcop = get_ebinop_op(cond)\n      if wcop == \"<\" || wcop == \">\" || wcop == \"<=\" || wcop == \">=\" {\n        let wlhs = get_ebinop_lhs(cond)\n        let wrhs = get_ebinop_rhs(cond)\n        let wnl1 = compile_expr(buf, wlhs, local_names, next_local, ctx, w_ld_in)\n        let wnl2 = compile_expr(buf, wrhs, local_names, wnl1, ctx, w_ld_in)\n        if wcop == \"<\" {\n          emit_i64_lt_s(buf); emit_i32_eqz(buf)\n        }\n        else if wcop == \">\" {\n          emit_i64_gt_s(buf); emit_i32_eqz(buf)\n        }\n        else if wcop == \"<=\" {\n          emit_i64_le_s(buf); emit_i32_eqz(buf)\n        }\n        else {\n          emit_i64_ge_s(buf); emit_i32_eqz(buf)\n        }\n        wnl2\n      } else {\n        let wnl = compile_expr(buf, cond, local_names, next_local, ctx, w_ld_in)\n        emit_i64_eqz(buf)\n        wnl\n      }\n    } else {\n      let wnl = compile_expr(buf, cond, local_names, next_local, ctx, w_ld_in)\n      emit_i64_eqz(buf)\n      wnl\n    }\n    emit_br_if(buf, 1)\n    let nl2 = compile_expr(buf, body, local_names, nl1, ctx, w_ld_in)\n    emit_drop(buf)\n    emit_br(buf, 0)\n    emit_end(buf)\n    emit_end(buf)\n    Array::truncate(ctx.loop_borrowed_names, lb_base)\n    emit_i64_const(buf, 0)\n    nl2\n  } else if __tag == 20 {\n    emit_br(buf, ld + 1)\n    emit_i64_const(buf, 0)\n    next_local\n  } else if __tag == 21 {\n    emit_br(buf, ld)\n    emit_i64_const(buf, 0)\n    next_local\n  } else if __tag == 22 {\n    emit_i64_const(buf, 0)\n    next_local\n  } else if __tag == 24 {\n    compile_lambda(buf, get_efn_params(expr), get_efn_body(expr), local_names, next_local, ctx, ld, compile_expr)\n  } else if __tag == 26 {\n    let ret_expr = get_ereturn_expr(expr)\n    let nl = compile_expr(buf, ret_expr, local_names, next_local, ctx, ld)\n    emit_return(buf)\n    nl\n  } else {\n    compile_expr_tail4(buf, expr, local_names, next_local, ctx, ld, compile_expr)\n  }\n}\n")
}

