let source_43 = () -> (String, String) {
  ("lib/@vibe/compiler/checker/builtins_simd.vibe",
"\nimport @vibe/compiler/core {\n  Type\n}\n\nimport @vibe/core {\n  array_empty\n}\n\n\n\nfn simd_no_params() -> Array[Type] {\n  array_empty()\n}\n\nfn simd_v128_ty() -> Type {\n  CtNamed(\"V128\", simd_no_params())\n}\n\nfn simd_one_param(a: Type) -> Array[Type] {\n  let arr = simd_no_params()\n  Array::push(arr, a)\n  arr\n}\n\nfn simd_two_params(a: Type, b: Type) -> Array[Type] {\n  let arr = simd_no_params()\n  Array::push(arr, a)\n  Array::push(arr, b)\n  arr\n}\n\nfn simd_three_params(a: Type, b: Type, c: Type) -> Array[Type] {\n  let arr = simd_no_params()\n  Array::push(arr, a)\n  Array::push(arr, b)\n  Array::push(arr, c)\n  arr\n}\n\nfn lookup_simd_mem(name: String) -> Option[Type] {\n  if name == \"v128_load\" {\n    Some(CtFn(simd_two_params(CtBytes, CtInt), simd_v128_ty(), None))\n  } else if name == \"v128_store\" {\n    Some(CtFn(simd_three_params(CtBytes, CtInt, simd_v128_ty()), CtUnit, None))\n  } else if name == \"simd_skip_ws\" {\n    Some(CtFn(simd_three_params(CtBytes, CtInt, CtInt), CtInt, None))\n  } else {\n    None\n  }\n}\n\nfn lookup_simd_lane_a(name: String) -> Option[Type] {\n  if name == \"v128_splat_i8x16\" {\n    Some(CtFn(simd_one_param(CtInt), simd_v128_ty(), None))\n  } else if name == \"v128_eq_i8x16\" {\n    Some(CtFn(simd_two_params(simd_v128_ty(), simd_v128_ty()), simd_v128_ty(), None))\n  } else if name == \"v128_le_u_i8x16\" {\n    Some(CtFn(simd_two_params(simd_v128_ty(), simd_v128_ty()), simd_v128_ty(), None))\n  } else if name == \"v128_ge_u_i8x16\" {\n    Some(CtFn(simd_two_params(simd_v128_ty(), simd_v128_ty()), simd_v128_ty(), None))\n  } else {\n    None\n  }\n}\n\nfn lookup_simd_lane_b(name: String) -> Option[Type] {\n  if name == \"v128_and\" {\n    Some(CtFn(simd_two_params(simd_v128_ty(), simd_v128_ty()), simd_v128_ty(), None))\n  } else if name == \"v128_or\" {\n    Some(CtFn(simd_two_params(simd_v128_ty(), simd_v128_ty()), simd_v128_ty(), None))\n  } else if name == \"v128_not\" {\n    Some(CtFn(simd_one_param(simd_v128_ty()), simd_v128_ty(), None))\n  } else {\n    None\n  }\n}\n\nfn lookup_simd_reduce(name: String) -> Option[Type] {\n  if name == \"v128_bitmask_i8x16\" {\n    Some(CtFn(simd_one_param(simd_v128_ty()), CtInt, None))\n  } else if name == \"v128_any_true\" {\n    Some(CtFn(simd_one_param(simd_v128_ty()), CtBool, None))\n  } else if name == \"v128_all_true_i8x16\" {\n    Some(CtFn(simd_one_param(simd_v128_ty()), CtBool, None))\n  } else {\n    None\n  }\n}\n\nexport fn lookup_simd(name: String) -> Option[Type] {\n  match lookup_simd_mem(name) {\n    Some(t) => Some(t),\n    None => match lookup_simd_lane_a(name) {\n      Some(t) => Some(t),\n      None => match lookup_simd_lane_b(name) {\n        Some(t) => Some(t),\n        None => lookup_simd_reduce(name)\n      }\n    }\n  }\n}\n")
}

