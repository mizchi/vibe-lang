let source_70 = () -> (String, String) {
  ("lib/@vibe/compiler/codegen/wasm_emit/header_magic.vibe",
"\nimport @vibe/compiler/core {\n  bytebuf_push, bytebuf_push3\n}\n\n\nexport fn emit_header(buf: Bytes) -> Unit {\n  bytebuf_push3(buf, 0, 97, 115)\n  bytebuf_push3(buf, 109, 1, 0)\n  bytebuf_push(buf, 0)\n  bytebuf_push(buf, 0)\n}\n")
}

let source_71 = () -> (String, String) {
  ("lib/@vibe/compiler/codegen/wasm_emit/header_type_sections.vibe",
"\nimport @vibe/compiler/core {\n  bytebuf_new, bytebuf_push, bytebuf_push_section, bytebuf_push_vec_header, leb128_encode_u32\n}\n\nimport @vibe/core {\n  array_empty\n}\n\n\nexport fn emit_func_type(buf: Bytes, param_count: Int, result_count: Int) -> Unit {\n  bytebuf_push(buf, 96)\n  leb128_encode_u32(buf, param_count)\n  let mut i = 0\n  while i < param_count {\n    bytebuf_push(buf, 126)\n    i = i + 1\n  }\n  leb128_encode_u32(buf, result_count)\n  let mut j = 0\n  while j < result_count {\n    bytebuf_push(buf, 126)\n    j = j + 1\n  }\n}\n\nexport fn emit_type_section_multi(out: Bytes, type_defs: Array[Int]) -> Unit {\n  let count = Array::length(type_defs) / 2\n  let content = bytebuf_new()\n  bytebuf_push_vec_header(content, count)\n  let mut i = 0\n  while i < count {\n    emit_func_type(content, Array::get(type_defs, i * 2), Array::get(type_defs, (i * 2) + 1))\n    i = i + 1\n  }\n  bytebuf_push_section(out, 1, content)\n}\n\nexport fn emit_type_section(out: Bytes, param_count: Int, result_count: Int) -> Unit {\n  let type_defs = array_empty()\n  Array::push(type_defs, param_count)\n  Array::push(type_defs, result_count)\n  emit_type_section_multi(out, type_defs)\n}\n")
}

let source_72 = () -> (String, String) {
  ("lib/@vibe/compiler/codegen/wasm_emit/header_exports.vibe",
"\nimport @vibe/compiler/core {\n  bytebuf_new, bytebuf_push, bytebuf_push_section, bytebuf_push_string, bytebuf_push_vec_header, leb128_encode_u32\n}\n\n\nexport fn emit_name(buf: Bytes, name: String) -> Unit {\n  bytebuf_push_string(buf, name)\n}\n\nexport fn emit_function_section(out: Bytes, type_indices: Array[Int]) -> Unit {\n  let content = bytebuf_new()\n  bytebuf_push_vec_header(content, Array::length(type_indices))\n  let mut i = 0\n  while i < Array::length(type_indices) {\n    leb128_encode_u32(content, Array::get(type_indices, i))\n    i = i + 1\n  }\n  bytebuf_push_section(out, 3, content)\n}\n\nexport fn emit_export_section_multi(out: Bytes, names: Array[String], func_indices: Array[Int]) -> Unit {\n  let count = Array::length(names)\n  let content = bytebuf_new()\n  bytebuf_push_vec_header(content, count)\n  let mut i = 0\n  while i < count {\n    emit_name(content, Array::get(names, i))\n    bytebuf_push(content, 0)\n    leb128_encode_u32(content, Array::get(func_indices, i))\n    i = i + 1\n  }\n  bytebuf_push_section(out, 7, content)\n}\n\nexport fn emit_export_section(out: Bytes, name: String, func_idx: Int) -> Unit {\n  emit_export_section_multi(out, [\n    name\n  ], [\n    func_idx\n  ])\n}\n")
}

let source_73 = () -> (String, String) {
  ("lib/@vibe/compiler/codegen/wasm_emit/code_helpers.vibe",
"\nimport @vibe/compiler/core {\n  bytebuf_length,\n  bytebuf_new,\n  bytebuf_push,\n  bytebuf_push_buf,\n  bytebuf_push_opcode_s64,\n  bytebuf_push_section,\n  bytebuf_push_vec_header,\n  leb128_encode_u32\n}\n\n\nexport fn emit_end(buf: Bytes) -> Unit {\n  bytebuf_push(buf, 11)\n}\n\nexport fn emit_i32_const(buf: Bytes, value: Int) -> Unit {\n  bytebuf_push_opcode_s64(buf, 65, value)\n}\n\nexport fn emit_code_section(out: Bytes, bodies: Array[Bytes]) -> Unit {\n  let content = bytebuf_new()\n  bytebuf_push_vec_header(content, Array::length(bodies))\n  let mut i = 0\n  while i < Array::length(bodies) {\n    let body = Array::get(bodies, i)\n    let func_buf = bytebuf_new()\n    leb128_encode_u32(func_buf, 0)\n    bytebuf_push_buf(func_buf, body)\n    bytebuf_push(func_buf, 11)\n    leb128_encode_u32(content, bytebuf_length(func_buf))\n    bytebuf_push_buf(content, func_buf)\n    i = i + 1\n  }\n  bytebuf_push_section(out, 10, content)\n}\n\nexport fn emit_memory_section(out: Bytes, min_pages: Int) -> Unit {\n  let content = bytebuf_new()\n  bytebuf_push_vec_header(content, 1)\n  bytebuf_push(content, 0)\n  leb128_encode_u32(content, min_pages)\n  bytebuf_push_section(out, 5, content)\n}\n\nexport fn emit_code_section_with_locals(out: Bytes, bodies: Array[Bytes], local_counts: Array[Int]) -> Unit {\n  let content = bytebuf_new()\n  bytebuf_push_vec_header(content, Array::length(bodies))\n  let mut i = 0\n  while i < Array::length(bodies) {\n    let body = Array::get(bodies, i)\n    let num_locals = Array::get(local_counts, i)\n    let func_buf = bytebuf_new()\n    if num_locals == 0 {\n      leb128_encode_u32(func_buf, 0)\n    } else {\n      leb128_encode_u32(func_buf, 1)\n      leb128_encode_u32(func_buf, num_locals)\n      bytebuf_push(func_buf, 126)\n    }\n    bytebuf_push_buf(func_buf, body)\n    bytebuf_push(func_buf, 11)\n    leb128_encode_u32(content, bytebuf_length(func_buf))\n    bytebuf_push_buf(content, func_buf)\n    i = i + 1\n  }\n  bytebuf_push_section(out, 10, content)\n}\n")
}

let source_74 = () -> (String, String) {
  ("lib/@vibe/compiler/codegen/wasm_emit/extra.vibe",
"\nimport @vibe/compiler/core {\n  bytebuf_new,\n  bytebuf_push,\n  bytebuf_push2,\n  bytebuf_push_buf,\n  bytebuf_push_opcode_u32,\n  bytebuf_push_section,\n  bytebuf_push_vec_header,\n  leb128_encode_u32\n}\n\n\n\nlet vt_i32 = 127\n\nlet sec_data = 11\n\nlet type_func = 96\n\nlet sec_export = 7\n\nlet sec_global = 6\n\nlet sec_import = 2\n\nlet export_func = 0\n\nlet export_memory = 2\n\nlet op_global_get = 35\n\nlet op_global_set = 36\n\nlet op_i32_add = 106\n\nlet op_i32_sub = 107\n\nlet op_i32_shr_u = 118\n\nlet op_i32_gt_u = 75\n\nlet op_memory_size = 63\n\nlet op_memory_grow = 64\n\nlet op_drop = 26\n\nlet op_select = 27\n\nlet op_i32_eq = 70\n\nlet op_if = 4\n\nlet bt_void = 64\n\nexport fn emit_global_get(buf: Bytes, idx: Int) -> Unit {\n  bytebuf_push_opcode_u32(buf, op_global_get, idx)\n}\n\nfn emit_heap_page_deficit(buf: Bytes) -> Unit {\n  emit_global_get(buf, 0)\n  emit_i32_const(buf, 65536)\n  bytebuf_push(buf, op_i32_add)\n  emit_i32_const(buf, 16)\n  bytebuf_push(buf, op_i32_shr_u)\n  bytebuf_push2(buf, op_memory_size, 0)\n  bytebuf_push(buf, op_i32_sub)\n}\n\nfn emit_heap_half_current(buf: Bytes) -> Unit {\n  bytebuf_push2(buf, op_memory_size, 0)\n  emit_i32_const(buf, 1)\n  bytebuf_push(buf, op_i32_shr_u)\n}\n\nexport fn emit_heap_memory_grow_check(buf: Bytes) -> Unit {\n  emit_global_get(buf, 0)\n  emit_i32_const(buf, 65536)\n  bytebuf_push(buf, op_i32_add)\n  emit_i32_const(buf, 16)\n  bytebuf_push(buf, op_i32_shr_u)\n  bytebuf_push2(buf, op_memory_size, 0)\n  bytebuf_push(buf, op_i32_gt_u)\n  bytebuf_push2(buf, op_if, bt_void)\n  emit_heap_page_deficit(buf)\n  emit_heap_half_current(buf)\n  emit_heap_page_deficit(buf)\n  emit_heap_half_current(buf)\n  bytebuf_push(buf, op_i32_gt_u)\n  bytebuf_push(buf, op_select)\n  bytebuf_push2(buf, op_memory_grow, 0)\n  emit_i32_const(buf, -1)\n  bytebuf_push(buf, op_i32_eq)\n  bytebuf_push2(buf, op_if, bt_void)\n  emit_heap_page_deficit(buf)\n  bytebuf_push2(buf, op_memory_grow, 0)\n  bytebuf_push(buf, op_drop)\n  emit_end(buf)\n  emit_end(buf)\n}\n\nexport fn emit_global_set(buf: Bytes, idx: Int) -> Unit {\n  bytebuf_push_opcode_u32(buf, op_global_set, idx)\n}\n\nexport fn emit_data_section(out: Bytes, offset: Int, data: Bytes) -> Unit {\n  let content = bytebuf_new()\n  bytebuf_push_vec_header(content, 1)\n  bytebuf_push(content, 0)\n  emit_i32_const(content, offset)\n  emit_end(content)\n  leb128_encode_u32(content, Bytes::length(data))\n  bytebuf_push_buf(content, data)\n  bytebuf_push_section(out, sec_data, content)\n}\n\nexport fn emit_exports_full(out: Bytes, fn_names: Array[String], fn_indices: Array[Int], mem_name: String, mem_idx: Int, global_names: Array[String], global_indices: Array[Int]) -> Unit {\n  let count = Array::length(fn_names) + 1 + Array::length(global_names)\n  let content = bytebuf_new()\n  bytebuf_push_vec_header(content, count)\n  let mut i = 0\n  while i < Array::length(fn_names) {\n    emit_name(content, Array::get(fn_names, i))\n    bytebuf_push(content, export_func)\n    leb128_encode_u32(content, Array::get(fn_indices, i))\n    i = i + 1\n  }\n  emit_name(content, mem_name)\n  bytebuf_push(content, export_memory)\n  leb128_encode_u32(content, mem_idx)\n  let mut gi = 0\n  while gi < Array::length(global_names) {\n    emit_name(content, Array::get(global_names, gi))\n    bytebuf_push(content, 3)\n    leb128_encode_u32(content, Array::get(global_indices, gi))\n    gi = gi + 1\n  }\n  bytebuf_push_section(out, sec_export, content)\n}\n\nexport fn emit_export_memory(out: Bytes, name: String, mem_idx: Int) -> Unit {\n  let content = bytebuf_new()\n  bytebuf_push_vec_header(content, 1)\n  emit_name(content, name)\n  bytebuf_push(content, export_memory)\n  leb128_encode_u32(content, mem_idx)\n  bytebuf_push_section(out, sec_export, content)\n}\n\nexport fn emit_func_type_raw(buf: Bytes, param_types: Array[Int], result_types: Array[Int]) -> Unit {\n  bytebuf_push(buf, type_func)\n  leb128_encode_u32(buf, Array::length(param_types))\n  let mut i = 0\n  while i < Array::length(param_types) {\n    bytebuf_push(buf, Array::get(param_types, i))\n    i = i + 1\n  }\n  leb128_encode_u32(buf, Array::length(result_types))\n  let mut j = 0\n  while j < Array::length(result_types) {\n    bytebuf_push(buf, Array::get(result_types, j))\n    j = j + 1\n  }\n}\n\nexport fn emit_exports_with_memory(out: Bytes, fn_names: Array[String], fn_indices: Array[Int], mem_name: String, mem_idx: Int) -> Unit {\n  let count = Array::length(fn_names) + 1\n  let content = bytebuf_new()\n  bytebuf_push_vec_header(content, count)\n  let mut i = 0\n  while i < Array::length(fn_names) {\n    emit_name(content, Array::get(fn_names, i))\n    bytebuf_push(content, export_func)\n    leb128_encode_u32(content, Array::get(fn_indices, i))\n    i = i + 1\n  }\n  emit_name(content, mem_name)\n  bytebuf_push(content, export_memory)\n  leb128_encode_u32(content, mem_idx)\n  bytebuf_push_section(out, sec_export, content)\n}\n\nexport fn emit_import_section_func(out: Bytes, module_name: String, field_name: String, type_idx: Int) -> Unit {\n  let content = bytebuf_new()\n  bytebuf_push_vec_header(content, 1)\n  emit_name(content, module_name)\n  emit_name(content, field_name)\n  bytebuf_push(content, export_func)\n  leb128_encode_u32(content, type_idx)\n  bytebuf_push_section(out, sec_import, content)\n}\n\nexport fn emit_global_section_i32_mut(out: Bytes, init_value: Int) -> Unit {\n  let content = bytebuf_new()\n  bytebuf_push_vec_header(content, 1)\n  bytebuf_push2(content, vt_i32, 1)\n  emit_i32_const(content, init_value)\n  emit_end(content)\n  bytebuf_push_section(out, sec_global, content)\n}\n")
}

let source_75 = () -> (String, String) {
  ("lib/@vibe/compiler/codegen/wasm_emit/instructions.vibe",
"\nimport @vibe/compiler/core {\n  bytebuf_new,\n  bytebuf_push,\n  bytebuf_push2,\n  bytebuf_push3,\n  bytebuf_push9,\n  bytebuf_push_opcode_s64,\n  bytebuf_push_opcode_u32,\n  bytebuf_push_opcode_u32_u32,\n  bytebuf_push_section,\n  bytebuf_push_vec_header,\n  leb128_encode_u32\n}\n\n\n\nlet op_br = 12\n\nlet op_if = 4\n\nlet bt_i64 = 126\n\nlet bt_void = 64\n\nexport fn emit_br(buf: Bytes, label: Int) -> Unit {\n  bytebuf_push_opcode_u32(buf, op_br, label)\n}\n\nlet op_call = 16\n\nlet op_drop = 26\n\nlet op_else = 5\n\nlet op_loop = 3\n\nlet op_block = 2\n\nlet op_br_if = 13\n\nexport fn emit_call(buf: Bytes, func_idx: Int) -> Unit {\n  bytebuf_push_opcode_u32(buf, op_call, func_idx)\n}\n\nexport fn emit_drop(buf: Bytes) -> Unit {\n  bytebuf_push(buf, op_drop)\n}\n\nexport fn emit_else(buf: Bytes) -> Unit {\n  bytebuf_push(buf, op_else)\n}\n\nlet op_f64_eq = 97\n\nlet op_f64_ge = 102\n\nlet op_f64_gt = 100\n\nlet op_f64_le = 101\n\nlet op_f64_lt = 99\n\nlet op_f64_ne = 98\n\nlet op_i64_eq = 81\n\nlet op_i64_ne = 82\n\nlet op_i64_or = 132\n\nlet op_return = 15\n\nlet sec_table = 4\n\nexport fn emit_br_if(buf: Bytes, label: Int) -> Unit {\n  bytebuf_push_opcode_u32(buf, op_br_if, label)\n}\n\nlet op_f64_abs = 153\n\nlet op_f64_ceil = 155\n\nlet op_f64_floor = 156\n\nlet op_f64_add = 160\n\nlet op_f64_div = 163\n\nlet op_f64_max = 165\n\nlet op_f64_min = 164\n\nlet op_f64_mul = 162\n\nlet op_f64_neg = 154\n\nlet op_f64_sub = 161\n\nlet op_i32_add = 106\n\nlet op_i32_and = 113\n\nlet op_i32_eq = 70\n\nlet op_i32_eqz = 69\n\nlet op_i32_gt_u = 75\n\nlet op_i32_ne = 71\n\nlet op_i32_shr_u = 118\nlet op_i32_shl = 116\n\nlet op_i32_sub = 107\n\nlet op_i64_add = 124\n\nlet op_i64_and = 131\n\nlet op_i64_eqz = 80\n\nlet op_i64_mul = 126\n\nlet op_i64_shl = 134\n\nlet op_i64_sub = 125\n\nlet op_i64_xor = 133\n\nexport fn emit_f64_eq(buf: Bytes) -> Unit {\n  bytebuf_push(buf, op_f64_eq)\n}\n\nexport fn emit_f64_ge(buf: Bytes) -> Unit {\n  bytebuf_push(buf, op_f64_ge)\n}\n\nexport fn emit_f64_gt(buf: Bytes) -> Unit {\n  bytebuf_push(buf, op_f64_gt)\n}\n\nexport fn emit_f64_le(buf: Bytes) -> Unit {\n  bytebuf_push(buf, op_f64_le)\n}\n\nexport fn emit_f64_lt(buf: Bytes) -> Unit {\n  bytebuf_push(buf, op_f64_lt)\n}\n\nexport fn emit_f64_ne(buf: Bytes) -> Unit {\n  bytebuf_push(buf, op_f64_ne)\n}\n\nexport fn emit_i64_eq(buf: Bytes) -> Unit {\n  bytebuf_push(buf, op_i64_eq)\n}\n\nexport fn emit_i64_ne(buf: Bytes) -> Unit {\n  bytebuf_push(buf, op_i64_ne)\n}\n\nexport fn emit_i64_or(buf: Bytes) -> Unit {\n  bytebuf_push(buf, op_i64_or)\n}\n\nexport fn emit_if_i64(buf: Bytes) -> Unit {\n  bytebuf_push2(buf, op_if, bt_i64)\n}\n\nexport fn emit_return(buf: Bytes) -> Unit {\n  bytebuf_push(buf, op_return)\n}\n\nlet op_i32_load = 40\n\nlet op_i64_ge_s = 89\n\nlet op_i64_gt_s = 85\n\nlet op_i64_le_s = 87\n\nlet op_i64_lt_s = 83\n\nlet sec_element = 9\n\nexport fn emit_f64_add(buf: Bytes) -> Unit {\n  bytebuf_push(buf, op_f64_add)\n}\n\nexport fn emit_f64_div(buf: Bytes) -> Unit {\n  bytebuf_push(buf, op_f64_div)\n}\n\nexport fn emit_f64_mul(buf: Bytes) -> Unit {\n  bytebuf_push(buf, op_f64_mul)\n}\n\nexport fn emit_f64_neg(buf: Bytes) -> Unit {\n  bytebuf_push(buf, op_f64_neg)\n}\n\nexport fn emit_f64_sub(buf: Bytes) -> Unit {\n  bytebuf_push(buf, op_f64_sub)\n}\n\nexport fn emit_f64_abs(buf: Bytes) -> Unit {\n  bytebuf_push(buf, op_f64_abs)\n}\n\nexport fn emit_f64_ceil(buf: Bytes) -> Unit {\n  bytebuf_push(buf, op_f64_ceil)\n}\n\nexport fn emit_f64_floor(buf: Bytes) -> Unit {\n  bytebuf_push(buf, op_f64_floor)\n}\n\nexport fn emit_f64_max(buf: Bytes) -> Unit {\n  bytebuf_push(buf, op_f64_max)\n}\n\nexport fn emit_f64_min(buf: Bytes) -> Unit {\n  bytebuf_push(buf, op_f64_min)\n}\n\nexport fn emit_i32_add(buf: Bytes) -> Unit {\n  bytebuf_push(buf, op_i32_add)\n}\n\nexport fn emit_i32_and(buf: Bytes) -> Unit {\n  bytebuf_push(buf, op_i32_and)\n}\n\nexport fn emit_i32_eq(buf: Bytes) -> Unit {\n  bytebuf_push(buf, op_i32_eq)\n}\n\nexport fn emit_i32_