\n  emit_end(global_content)\n  if enable_rc {\n    bytebuf_push(global_content, 127)\n    bytebuf_push(global_content, 1)\n    emit_i32_const(global_content, 0)\n    emit_end(global_content)\n  }\n  bytebuf_push(global_content, 126)\n  bytebuf_push(global_content, 1)\n  emit_i64_const(global_content, 0)\n  emit_end(global_content)\n  bytebuf_push(global_content, 126)\n  bytebuf_push(global_content, 1)\n  emit_i64_const(global_content, 0)\n  emit_end(global_content)\n  bytebuf_push(global_content, 127)\n  bytebuf_push(global_content, 1)\n  emit_i32_const(global_content, heap_start)\n  emit_end(global_content)\n  bytebuf_push(global_content, 126)\n  bytebuf_push(global_content, 1)\n  emit_i64_const(global_content, 0)\n  emit_end(global_content)\n  let mut tg_gi = 0\n  while tg_gi < tg_num_thunks * 2 {\n    bytebuf_push(global_content, 126)\n    bytebuf_push(global_content, 1)\n    emit_i64_const(global_content, 0)\n    emit_end(global_content)\n    tg_gi = tg_gi + 1\n  }\n  bytebuf_push_section(out, 6, global_content)\n  let start_func_idx = func_offset + num_user_funcs\n  let run_func_idx = start_func_idx + 1\n  let all_export_names = lc_fresh_string_array()\n  let all_export_indices = lc_fresh_int_array()\n  if !library_mode {\n    Array::push(all_export_names, \"_start\")\n    Array::push(all_export_indices, start_func_idx)\n  }\n  if !library_mode && entry_func_idx >= 0 && !array_contains_str(all_export_names, entry_name) {\n    Array::push(all_export_names, entry_name)\n    Array::push(all_export_indices, entry_func_idx)\n  }\n  let mut exi = 0\n  while exi < Array::length(export_fn_names) {\n    let ename = Array::get(export_fn_names, exi)\n    let skip_export = library_mode && ename == entry_name\n    if !skip_export && !array_contains_str(all_export_names, ename) {\n      Array::push(all_export_names, ename)\n      Array::push(all_export_indices, Array::get(export_fn_user_indices, exi) + func_offset)\n    }\n    exi = exi + 1\n  }\n  let mut bxi = 0\n  while bxi < Array::length(test_fn_names) {\n    let bname = Array::get(test_fn_names, bxi)\n    if String::starts_with(bname, \"__bench_\") && !array_contains_str(all_export_names, bname) {\n      let mut bj = 0\n      let mut bfound = 0 - 1\n      while bj < num_user_funcs {\n        if Array::get(fn_names_list, bj) == bname {\n          bfound = bj\n          bj = num_user_funcs\n        } else {\n          bj = bj + 1\n        }\n      }\n      if bfound >= 0 {\n        Array::push(all_export_names, bname)\n        Array::push(all_export_indices, bfound + func_offset)\n      }\n    }\n    bxi = bxi + 1\n  }\n  let export_content = bytebuf_new()\n  let export_count = Array::length(all_export_names) + 1 +\n  (if library_mode {\n    0\n  } else {\n    1 + (if uses_exceptions {\n      1\n    } else {\n      0\n    })\n  })\n  bytebuf_push_vec_header(export_content, export_count)\n  let mut efi = 0\n  while efi < Array::length(all_export_names) {\n    emit_name(export_content, Array::get(all_export_names, efi))\n    bytebuf_push(export_content, 0)\n    leb128_encode_u32(export_content, Array::get(all_export_indices, efi))\n    efi = efi + 1\n  }\n  emit_name(export_content, \"memory\")\n  bytebuf_push(export_content, 2)\n  leb128_encode_u32(export_content, 0)\n  if !library_mode {\n    emit_name(export_content, \"__heap_ptr\")\n    bytebuf_push(export_content, 3)\n    leb128_encode_u32(export_content, 0)\n    if uses_exceptions {\n      emit_name(export_content, \"error\")\n      bytebuf_push(export_content, 4)\n      leb128_encode_u32(export_content, 0)\n    } else {\n      ()\n    }\n  }\n  bytebuf_push_section(out, 7, export_content)\n  if total_table_entries > 0 {\n    let slot_used_flags = lc_fresh_bool_array()\n    let mut sfi = 0\n    while sfi < total_table_entries {\n      Array::push(slot_used_flags, false)\n      sfi = sfi + 1\n    }\n    let mut tsu = 0\n    while tsu < Array::length(table_slots_used) {\n      let ts = Array::get(table_slots_used, tsu)\n      if ts >= 0 && ts < total_table_entries {\n        Array::set(slot_used_flags, ts, true)\n      } else {\n        ()\n      }\n      tsu = tsu + 1\n    }\n    let table_slots = lc_fresh_int_array()\n    let table_func_indices = lc_fresh_int_array()\n    let mut tei = 0\n    while tei < total_table_entries {\n      if Array::get(slot_used_flags, tei) {\n        Array::push(table_slots, tei)\n        Array::push(table_func_indices, if tei < num_user_funcs {\n          func_offset + tei\n        } else {\n          run_func_idx + 1 + (tei - num_user_funcs)\n        })\n      } else {\n        ()\n      }\n      tei = tei + 1\n    }\n    if Array::length(table_slots) > 0 {\n      emit_element_section_active_runs(out, table_slots, table_func_indices)\n    } else {\n      ()\n    }\n  }\n  if !coverage && !debug_trace && !debug_break && !rc_shadow {\n    let builtin_used = lc_fresh_bool_array()\n    let mut sbu_i = 0\n    while sbu_i < num_generated {\n      Array::push(builtin_used, false)\n      sbu_i = sbu_i + 1\n    }\n    let scan_queue = lc_fresh_int_array()\n    let mut sbr = num_generated\n    while sbr < Array::length(bodies) {\n      Array::push(scan_queue, sbr)\n      sbr = sbr + 1\n    }\n    let mut sq_i = 0\n    while sq_i < Array::length(scan_queue) {\n      let sb_body = Array::get(bodies, Array::get(scan_queue, sq_i))\n      sq_i = sq_i + 1\n      let sb_len = Bytes::length(sb_body)\n      let mut sb_p = 0\n      while sb_p < sb_len {\n        let sb_op = Bytes::get(sb_body, sb_p)\n        if sb_op == 16 || sb_op == 210 {\n          let mut sb_q = sb_p + 1\n          let mut sb_v = 0\n          let mut sb_shift = 0\n          let mut sb_more = true\n          let mut sb_valid = false\n          while sb_more && sb_q < sb_len && sb_shift < 35 {\n            let sb_byte = Bytes::get(sb_body, sb_q)\n            sb_v = sb_v|((sb_byte&127)<<sb_shift)\n            sb_q = sb_q + 1\n            if (sb_byte&128) == 0 {\n              sb_more = false\n              sb_valid = true\n            } else {\n              sb_shift = sb_shift + 7\n            }\n          }\n          if sb_valid && sb_v >= num_imported_funcs && sb_v < func_offset {\n            let sb_pos = sb_v - num_imported_funcs\n            if !Array::get(builtin_used, sb_pos) {\n              Array::set(builtin_used, sb_pos, true)\n              Array::push(scan_queue, sb_pos)\n            } else {\n              ()\n            }\n          } else {\n            ()\n          }\n        } else {\n          ()\n        }\n        sb_p = sb_p + 1\n      }\n    }\n    let mut sb_k = 0\n    while sb_k < num_generated {\n      if !Array::get(builtin_used, sb_k) {\n        let sb_stub = bytebuf_new()\n        bytebuf_push(sb_stub, 0)\n        Array::set(bodies, sb_k, sb_stub)\n        Array::set(meta_i32, sb_k, 0)\n        Array::set(meta_i64, sb_k, 0)\n      } else {\n        ()\n      }\n      sb_k = sb_k + 1\n    }\n  } else {\n    ()\n  }\n  let code_content = bytebuf_new()\n  bytebuf_push_vec_header(code_content, Array::length(bodies))\n  let linemap_hdrlen_by_bi = if linemap_state.enabled {\n    lc_fresh_int_array_of_len(num_user_funcs, 0)\n  } else {\n    lc_fresh_int_array()\n  }\n  if Array::length(meta_v128) != Array::length(bodies) {\n    throw(String::concat(\"meta_v128/bodies misalignment: \", String::concat(__to_string(Array::length(meta_v128)), String::concat(\" vs \", __to_string(Array::length(bodies))))))\n  } else {\n    ()\n  }\n  let mut ci = 0\n  while ci < Array::length(bodies) {\n    let body = Array::get(bodies, ci)\n    let func_buf = bytebuf_new()\n    let ni32 = Array::get(meta_i32, ci)\n    let ni64 = Array::get(meta_i64, ci)\n    let nv128 = Array::get(meta_v128, ci)\n    let mut ngroups = 0\n    if ni32 > 0 {\n      ngroups = ngroups + 1\n    } else {\n      ()\n    }\n    if ni64 > 0 {\n      ngroups = ngroups + 1\n    } else {\n      ()\n    }\n    if nv128 > 0 {\n      ngroups = ngroups + 1\n    } else {\n      ()\n    }\n    leb128_encode_u32(func_buf, ngroups)\n    if ni32 > 0 {\n      leb128_encode_u32(func_buf, ni32)\n      bytebuf_push(func_buf, 127)\n    } else {\n      ()\n    }\n    if ni64 > 0 {\n      leb128_encode_u32(func_buf, ni64)\n      bytebuf_push(func_buf, 126)\n    } else {\n      ()\n    }\n    if nv128 > 0 {\n      leb128_encode_u32(func_buf, nv128)\n      bytebuf_push(func_buf, 123)\n    } else {\n      ()\n    }\n    if linemap_state.enabled {\n      let lm_bi = ci - num_generated\n      if lm_bi >= 0 && lm_bi < num_user_funcs {\n        Array::set(linemap_hdrlen_by_bi, lm_bi, bytebuf_length(func_buf))\n      } else {\n        ()\n      }\n    } else {\n      ()\n    }\n    bytebuf_push_buf(func_buf, body)\n    bytebuf_push(func_buf, 11)\n    leb128_encode_u32(code_content, bytebuf_length(func_buf))\n    bytebuf_push_buf(code_content, func_buf)\n    ci = ci + 1\n  }\n  bytebuf_push_section(out, 10, code_content)\n  if linemap_state.enabled {\n    let lm_content = bytebuf_new()\n    let lm_name = \"vibe.linemap\"\n    leb128_encode_u32(lm_content, String::length(lm_name))\n    let mut lmni = 0\n    while lmni < String::length(lm_name) {\n      bytebuf_push(lm_content, String::char_code_at(lm_name, lmni))\n      lmni = lmni + 1\n    }\n    let mut lm_k = 0\n    while lm_k < Array::length(linemap_state.offsets) {\n      let lm_bi = Array::get(linemap_state.funcs, lm_k)\n      let lm_func_idx = func_offset + lm_bi\n      let lm_off = Array::get(linemap_state.offsets, lm_k) + Array::get(linemap_hdrlen_by_bi, lm_bi)\n      let lm_file_id = Array::get(linemap_state.file_ids, lm_k)\n      let lm_line = Array::get(linemap_state.lines, lm_k)\n      bytebuf_push_i32le(lm_content, lm_func_idx)\n      bytebuf_push_i32le(lm_content, lm_off)\n      bytebuf_push_i32le(lm_content, lm_file_id)\n      bytebuf_push_i32le(lm_content, lm_line)\n      lm_k = lm_k + 1\n    }\n    bytebuf_push_section(out, 0, lm_content)\n  } else {\n    ()\n  }\n  if num_strings > 0 {\n    let data_offsets = lc_fresh_int_array()\n    let data_bufs = lc_fresh_bytes_array()\n    let mut di = 0\n    while di < num_strings {\n      Array::push(data_offsets, Array::get(str_offsets, di))\n      Array::push(data_bufs, string_to_data(Array::get(str_strs, di)))\n      di = di + 1\n    }\n    emit_data_section_multi(out, data_offsets, data_bufs)\n  }\n  let gen_sec_names = lc_fresh_string_array()\n  let mut gsn_i = 0\n  while gsn_i < num_generated {\n    Array::push(gen_sec_names, \"__rt_gen\")\n    gsn_i = gsn_i + 1\n  }\n  Array::set(gen_sec_names, print_int_idx - num_imported_funcs, \"__rt_print_int\")\n  Array::set(gen_sec_names, print_str_idx - num_imported_funcs, \"__rt_print_str\")\n  Array::set(gen_sec_names, str_len_idx - num_imported_funcs, \"__rt_str_len\")\n  Array::set(gen_sec_names, str_eq_idx - num_imported_funcs, \"__rt_str_eq\")\n  Array::set(gen_sec_names, str_concat_idx - num_imported_funcs, \"__rt_str_concat\")\n  Array::set(gen_sec_names, arr_new_idx - num_imported_funcs, \"__rt_arr_new\")\n  Array::set(gen_sec_names, arr_len_idx - num_imported_funcs, \"__rt_arr_len\")\n  Array::set(gen_sec_names, arr_get_idx - num_imported_funcs, \"__rt_arr_get\")\n  Array::set(gen_sec_names, arr_push_idx - num_imported_funcs, \"__rt_arr_push\")\n  Array::set(gen_sec_names, arr_set_idx - num_imported_funcs, \"__rt_arr_set\")\n  Array::set(gen_sec_names, double_to_int_idx - num_imported_funcs, \"__rt_double_to_int\")\n  Array::set(gen_sec_names, int_to_double_idx - num_imported_funcs, \"__rt_int_to_double\")\n  Array::set(gen_sec_names, str_char_code_at_idx - num_imported_funcs, \"__rt_str_char_code_at\")\n  Array::set(gen_sec_names, str_from_char_code_idx - num_imported_funcs, \"__rt_str_from_char_code\")\n  Array::set(gen_sec_names, str_substring_idx - num_imported_funcs, \"__rt_str_substring\")\n  Array::set(gen_sec_names, identity_idx - num_imported_funcs, \"__rt_identity\")\n  Array::set(gen_sec_names, arr_slice_idx - num_imported_funcs, \"__rt_arr_slice\")\n  Array::set(gen_sec_names, arr_concat_idx - num_imported_funcs, \"__rt_arr_concat\")\n  Array::set(gen_sec_names, arr_truncate_idx - num_imported_funcs, \"__rt_arr_truncate\")\n  Array::set(gen_sec_names, string_join_idx - num_imported_funcs, \"__rt_string_join\")\n  Array::set(gen_sec_names, fs_read_file_stub_idx - num_imported_funcs, \"__rt_stub_a\")\n  Array::set(gen_sec_names, fs_exists_stub_idx - num_imported_funcs, \"__rt_stub_b\")\n  Array::set(gen_sec_names, fs_stat_token_stub_idx - num_imported_funcs, \"__rt_stub_c\")\n  Array::set(gen_sec_names, fs_write_file_stub_idx - num_imported_funcs, \"__rt_stub_d\")\n  Array::set(gen_sec_names, fs_write_bytes_stub_idx - num_imported_funcs, \"__rt_stub_e\")\n  Array::set(gen_sec_names, eq_idx - num_imported_funcs, \"__rt_eq\")\n  Array::set(gen_sec_names, string_ends_with_idx - num_imported_funcs, \"__rt_string_ends_with\")\n  Array::set(gen_sec_names, string_last_index_of_idx - num_imported_funcs, \"__rt_string_last_index_of\")\n  Array::set(gen_sec_names, arr_push_all_idx - num_imported_funcs, \"__rt_arr_push_all\")\n  Array::set(gen_sec_names, string_index_of_idx - num_imported_funcs, \"__rt_string_index_of\")\n  Array::set(gen_sec_names, string_contains_idx - num_imported_funcs, \"__rt_string_contains\")\n  Array::set(gen_sec_names, string_starts_with_idx - num_imported_funcs, \"__rt_string_starts_with\")\n  Array::set(gen_sec_names, string_split_idx - num_imported_funcs, \"__rt_string_split\")\n  Array::set(gen_sec_names, string_trim_idx - num_imported_funcs, \"__rt_string_trim\")\n  Array::set(gen_sec_names, sources_idx - num_imported_funcs, \"__rt_sources\")\n  Array::set(gen_sec_names, bytes_new_idx - num_imported_funcs, \"__rt_bytes_new\")\n  Array::set(gen_sec_names, bytes_len_idx - num_imported_funcs, \"__rt_bytes_len\")\n  Array::set(gen_sec_names, bytes_get_idx - num_imported_funcs, \"__rt_bytes_get\")\n  Array::set(gen_sec_names, bytes_set_idx - num_imported_funcs, \"__rt_bytes_set\")\n  Array::set(gen_sec_names, bytes_push_idx - num_imported_funcs, \"__rt_bytes_push\")\n  Array::set(gen_sec_names, bytes_append_idx - num_imported_funcs, \"__rt_bytes_append\")\n  Array::set(gen_sec_names, bytes_concat_idx - num_imported_funcs, \"__rt_bytes_concat\")\n  Array::set(gen_sec_names, bytes_slice_idx - num_imported_funcs, \"__rt_bytes_slice\")\n  Array::set(gen_sec_names, bytes_from_array_idx - num_imported_funcs, \"__rt_bytes_from_array\")\n  Array::set(gen_sec_names, bytes_to_array_idx - num_imported_funcs, \"__rt_bytes_to_array\")\n  if enable_rc {\n    Array::set(gen_sec_names, rc_drop_idx - num_imported_funcs, \"__rt_rc_drop\")\n    Array::set(gen_sec_names, rc_alloc_idx - num_imported_funcs, \"__rt_rc_alloc\")\n  } else {\n    ()\n  }\n  Array::set(gen_sec_names, heap_grow_check_idx - num_imported_funcs, \"__rt_heap_grow_check\")\n  Array::set(gen_sec_names, simd_skip_ws_idx - num_imported_funcs, \"__rt_simd_skip_ws\")\n  Array::set(gen_sec_names, simd_scan_alnum_idx - num_imported_funcs, \"__rt_simd_scan_alnum\")\n  Array::set(gen_sec_names, simd_scan_alnum_str_idx - num_imported_funcs, \"__rt_simd_scan_alnum_str\")\n  Array::set(gen_sec_names, str_lex_diff_idx - num_imported_funcs, \"__rt_str_lex_diff\")\n  Array::set(gen_sec_names, generic_rel_diff_idx - num_imported_funcs, \"__rt_generic_rel_diff\")\n  Array::set(gen_sec_names, generic_add_idx - num_imported_funcs, \"__rt_generic_add\")\n  let name_sec_names = gen_sec_names\n  let mut usn_i = 0\n  while usn_i < num_user_funcs {\n    Array::push(name_sec_names, Array::get(fn_names_list, usn_i))\n    usn_i = usn_i + 1\n  }\n  Array::push(name_sec_names, \"_start\")\n  Array::push(name_sec_names, \"run\")\n  emit_function_name_section(out, name_sec_names, num_imported_funcs)\n  bytebuf_to_bytes(out)\n}\n\nexport fn compile_wasi_module_rc_impl(stmts_in: Array[Stmt], entry_name: String) -> Bytes with { Error } {\n  let stmts = elaborate_heap_params(stmts_in)\n  compile_wasi_module_linked_impl(stmts, entry_name, array_empty(), array_empty(), false, true, false, false, false, false, empty_dbg_prov(), codegen_body_cache_new(), codegen_body_cache_new(), 0, 0 - 1)\n}\n\nexport fn compile_wasi_module_rc_shadow_impl(stmts_in: Array[Stmt], entry_name: String) -> Bytes with { Error } {\n  let stmts = elaborate_heap_params(stmts_in)\n  compile_wasi_module_linked_impl(stmts, entry_name, array_empty(), array_empty(), false, true, false, false, false, true, empty_dbg_prov(), codegen_body_cache_new(), codegen_body_cache_new(), 0, 0 - 1)\n}\n\nexport fn compile_wasi_module_sliced_impl(stmts: Array[Stmt], entry_name: String) -> Bytes with { Error } {\n  let whole = compile_wasi_module_linked_impl(stmts, entry_name, array_empty(), array_empty(), false, false, false, false, false, false, empty_dbg_prov(), codegen_body_cache_new(), codegen_body_cache_new(), 0, 0 - 1)\n  let probe = codegen_body_cache_new()\n  let _probe_bytes = compile_wasi_module_linked_impl(stmts, entry_name, array_empty(), array_empty(), false, false, false, false, false, false, empty_dbg_prov(), codegen_body_cache_new(), probe, 0, 0 - 1)\n  let nfns = Array::length(probe.fn_indices)\n  let mid = nfns / 2\n  let low = codegen_body_cache_new()\n  let high = codegen_body_cache_new()\n  let _low_bytes = compile_wasi_module_linked_impl(stmts, entry_name, array_empty(), array_empty(), false, false, false, false, false, false, empty_dbg_prov(), codegen_body_cache_new(), low, 0, mid)\n  let _high_bytes = compile_wasi_module_linked_impl(stmts, entry_name, array_empty(), array_empty(), false, false, false, false, false, false, empty_dbg_prov(), codegen_body_cache_new(), high, mid, 0 - 1)\n  let merged = codegen_body_cache_merge(low, high)\n  let nmerged = Array::length(merged.fn_indices)\n  if nmerged != nfns {\n    throw(String::concat(\"codegen slice merge lost functions: whole \", String::concat(__to_string(nfns), String::concat(\", merged \", __to_string(nmerged)))))\n  } else {\n    ()\n  }\n  let sliced = compile_wasi_module_linked_impl(stmts, entry_name, array_empty(), array_empty(), false, false, false, false, false, false, empty_dbg_prov(), merged, codegen_body_cache_new(), 0, 0 - 1)\n  let wn = Bytes::length(whole)\n  let sn = Bytes::length(sliced)\n  if wn != sn {\n    throw(String::concat(\"codegen slice length mismatch: whole \", String::concat(__to_string(wn), String::concat(\" B, sliced \", String::concat(__to_string(sn), \" B\")))))\n  } else {\n    ()\n  }\n  let mut i = 0\n  let mut bad = 0 - 1\n  while bad < 0 && i < wn {\n    if Bytes::get(whole, i) != Bytes::get(sliced, i) {\n      bad = i\n    } else {\n      i = i + 1\n    }\n  }\n  if bad >= 0 {\n    throw(String::concat(\"codegen slice byte mismatch at offset \", __to_string(bad)))\n  } else {\n    ()\n  }\n  sliced\n}\n\nexport fn compile_wasi_module_replayed_impl(stmts: Array[Stmt], entry_name: String) -> Bytes with { Error } {\n  let harvest = codegen_body_cache_new()\n  let compiled = compile_wasi_module_linked_impl(stmts, entry_name, array_empty(), array_empty(), false, false, false, false, false, false, empty_dbg_prov(), codegen_body_cache_new(), harvest, 0, 0 - 1)\n  let replayed = compile_wasi_module_linked_impl(stmts, entry_name, array_empty(), array_empty(), false, false, false, false, false, false, empty_dbg_prov(), harvest, codegen_body_cache_new(), 0, 0 - 1)\n  let ln = Bytes::length(compiled)\n  let rn = Bytes::length(replayed)\n  if ln != rn {\n    throw(String::concat(\"codegen replay length mismatch: compiled \", String::concat(__to_string(ln), String::concat(\" B, replayed \", String::concat(__to_string(rn), \" B\")))))\n  } else {\n    ()\n  }\n  let mut i = 0\n  let mut bad = 0 - 1\n  while bad < 0 && i < ln {\n    if Bytes::get(compiled, i) != Bytes::get(replayed, i) {\n      bad = i\n    } else {\n      i = i + 1\n    }\n  }\n  if bad >= 0 {\n    throw(String::concat(\"codegen replay byte mismatch at offset \", __to_string(bad)))\n  } else {\n    ()\n  }\n  replayed\n}\n\nexport fn compile_wasi_module_with_sources_impl(stmts: Array[Stmt], entry_name: String, srcs: Array[(String, String)]) -> Bytes with { Error } {\n  compile_wasi_module_linked_impl(stmts, entry_name, srcs, array_empty(), false, false, false, false, false, false, empty_dbg_prov(), codegen_body_cache_new(), codegen_body_cache_new(), 0, 0 - 1)\n}\n\nexport fn compile_wasi_module_with_sources_coverage_impl(stmts: Array[Stmt], entry_name: String, srcs: Array[(String, String)]) -> Bytes with { Error } {\n  compile_wasi_module_linked_impl(stmts, entry_name, srcs, array_empty(), false, true, true, false, false, false, empty_dbg_prov(), codegen_body_cache_new(), codegen_body_cache_new(), 0, 0 - 1)\n}\n\nexport fn compile_wasi_module_with_sources_trace_impl(stmts: Array[Stmt], entry_name: String, srcs: Array[(String, String)]) -> Bytes with { Error } {\n  compile_wasi_module_linked_impl(stmts, entry_name, srcs, array_empty(), false, true, false, true, false, false, empty_dbg_prov(), codegen_body_cache_new(), codegen_body_cache_new(), 0, 0 - 1)\n}\n\nexport fn compile_wasi_module_with_sources_break_impl(stmts: Array[Stmt], entry_name: String, srcs: Array[(String, String)], prov: DbgProv) -> Bytes with { Error } {\n  compile_wasi_module_linked_impl(stmts, entry_name, srcs, array_empty(), false, true, false, false, true, false, prov, codegen_body_cache_new(), codegen_body_cache_new(), 0, 0 - 1)\n}\n")
}

let source_110 = () -> (String, String) {
  ("lib/@vibe/compiler/entry/source_compile/wasi_only/component_codegen.vibe",
"\nimport @vibe/compiler/core {\n  bytebuf_new,\n  bytebuf_push,\n  bytebuf_push_buf,\n  bytebuf_push_section,\n  bytebuf_push_vec_header,\n  bytebuf_to_bytes,\n  leb128_encode_s64,\n  leb128_encode_u32\n}\n\nimport @vibe/core {\n  array_empty\n}\n\nimport @vibe/compiler/codegen/wasm_emit {\n  emit_block_void,\n  emit_br,\n  emit_br_if,\n  emit_call,\n  emit_code_section,\n  emit_end,\n  emit_export_memory,\n  emit_export_section,\n  emit_export_section_multi,\n  emit_func_type_raw,\n  emit_function_section,\n  emit_header,\n  emit_i32_add,\n  emit_i32_and,\n  emit_i32_const,\n  emit_i32_eq,\n  emit_i32_eqz,\n  emit_i32_gt_u,\n  emit_i32_load,\n  emit_i32_load8_u,\n  emit_i32_ne,\n  emit_i32_shl,\n  emit_i32_shr_u,\n  emit_i32_store,\n  emit_i32_store8,\n  emit_i32_sub,\n  emit_i32_wrap_i64,\n  emit_i64_const,\n  emit_i64_shl,\n  emit_i64_shr_s,\n  emit_if_void,\n  emit_local_get,\n  emit_local_set,\n  emit_loop_void,\n  emit_memory_section,\n  emit_name,\n  emit_return\n}\n\n\nfn read_uleb(bytes: Bytes, start: Int) -> (Int, Int) {\n  let mut value = 0\n  let mut shift = 0\n  let mut i = start\n  let len = Bytes::length(bytes)\n  let mut done = false\n  while (i < len) && (done == false) {\n    let b = Bytes::get(bytes, i)\n    value = value|((b&127)<<shift)\n    i = i + 1\n    if (b&128) == 0 {\n      done = true\n    } else {\n      shift = shift + 7\n    }\n  }\n  (value, i)\n}\n\nlet section_type = 7\n\nlet core_sort_mem = 2\n\nfn new_int_array() -> Array[Int] {\n  array_empty()\n}\n\nlet section_alias = 6\n\nlet section_canon = 8\n\nlet core_sort_func = 0\n\nfn read_name_info(bytes: Bytes, start: Int) -> (Int, Int) {\n  read_uleb(bytes, start)\n}\n\nfn skip_name(bytes: Bytes, start: Int) -> Int {\n  let (name_len, after_len) = read_name_info(bytes, start)\n  after_len + name_len\n}\n\nlet section_export = 11\n\nlet section_import = 10\n\nlet section_module = 1\n\nfn parse_type_sigs(bytes: Bytes, sec_start: Int, sec_end: Int, out_sigs: Array[Array[Int]]) -> Unit {\n  let mut j = sec_start\n  let (type_count, next_j) = read_uleb(bytes, j)\n  j = next_j\n  let mut t = 0\n  while t < type_count {\n    if j >= sec_end {\n      t = type_count\n    }\n    else {\n      let form = Bytes::get(bytes, j)\n      j = j + 1\n      if form != 96 {\n        t = type_count\n      }\n      else {\n        let sig = new_int_array()\n        let (param_count, next_j2) = read_uleb(bytes, j)\n        j = next_j2\n        Array::push(sig, param_count)\n        let mut p = 0\n        while p < param_count {\n          if j >= sec_end {\n            p = param_count\n          }\n          else {\n            Array::push(sig, Bytes::get(bytes, j))\n            j = j + 1\n            p = p + 1\n          }\n        }\n        let (result_count, next_j3) = read_uleb(bytes, j)\n        j = next_j3\n        Array::push(sig, result_count)\n        let mut rv = 0\n        while rv < result_count {\n          if j >= sec_end {\n            rv = result_count\n          }\n          else {\n            Array::push(sig, Bytes::get(bytes, j))\n            j = j + 1\n            rv = rv + 1\n          }\n        }\n        Array::push(out_sigs, sig)\n        t = t + 1\n      }\n    }\n  }\n}\n\nlet comp_extern_func = 1\n\nlet comp_valtype_f32 = 118\n\nlet comp_valtype_f64 = 117\n\nlet comp_valtype_s32 = 122\n\nlet comp_valtype_s64 = 120\n\nfn emit_raw_content(buf: Bytes, content: Bytes) -> Unit {\n  leb128_encode_u32(buf, Bytes::length(content))\n  bytebuf_push_buf(buf, content)\n}\n\nfn read_name_string(bytes: Bytes, start: Int) -> String {\n  let (name_len, after_len) = read_name_info(bytes, start)\n  let buf = StringBuilder::new()\n  let mut i = 0\n  while i < name_len {\n    StringBuilder::push(buf, String::from_char_code(Bytes::get(bytes, after_len + i)))\n    i = i + 1\n  }\n  StringBuilder::freeze(buf)\n}\n\nfn skip_wasm_limits(bytes: Bytes, start: Int, end_pos: Int) -> Int {\n  let mut i = start\n  if i >= end_pos {\n    end_pos\n  }\n  else {\n    let flags = Bytes::get(bytes, i)\n    i = i + 1\n    let (min_limit, next_i1) = read_uleb(bytes, i)\n    let _ = min_limit\n    i = next_i1\n    if (flags&1) != 0 {\n      let (max_limit, next_i2) = read_uleb(bytes, i)\n      let _ = max_limit\n      i = next_i2\n    }\n    if (flags&4) != 0 {\n      let (page_size, next_i3) = read_uleb(bytes, i)\n      let _ = page_size\n      i = next_i3\n    }\n    if i > end_pos {\n      end_pos\n    } else {\n      i\n    }\n  }\n}\n\nlet component_magic_0 = 0\n\nlet component_magic_1 = 97\n\nlet component_magic_2 = 115\n\nlet component_magic_3 = 109\n\nfn emit_alias_section(buf: Bytes, core_instance_idx: Int, names: Array[String], sorts: Array[Int]) -> Unit {\n  let count = Array::length(names)\n  if count == 0 {\n    ()\n  }\n  else {\n    bytebuf_push(buf, section_alias)\n    let content = bytebuf_new()\n    leb128_encode_u32(content, count)\n    let mut i = 0\n    while i < count {\n      bytebuf_push(content, 0)\n      bytebuf_push(content, Array::get(sorts, i))\n      bytebuf_push(content, 1)\n      leb128_encode_u32(content, core_instance_idx)\n      emit_name(content, Array::get(names, i))\n      i = i + 1\n    }\n    emit_raw_content(buf, content)\n  }\n}\n\nlet comp_valtype_string = 115\n\nlet comp_valtype_bool = 127\n\nlet component_version_0 = 13\n\nlet component_version_1 = 0\n\nlet component_version_2 = 1\n\nlet component_version_3 = 0\n\nfn core_to_comp_valtype(v: Int) -> Int {\n  if v == 127 {\n    comp_valtype_s32\n  }\n  else {\n    if v == 126 {\n      comp_valtype_s64\n    }\n    else {\n      if v == 125 {\n        comp_valtype_f32\n      }\n      else {\n        if v == 124 {\n          comp_valtype_f64\n        }\n        else {\n          0 - 1\n        }\n      }\n    }\n  }\n}\n\nfn emit_canon_lift_func(content: Bytes, core_func_idx: Int, type_idx: Int, need_string: Int, memory_idx: Int, realloc_idx: Int) -> Unit {\n  bytebuf_push(content, 0)\n  bytebuf_push(content, 0)\n  leb128_encode_u32(content, core_func_idx)\n  if need_string != 0 {\n    leb128_encode_u32(content, 3)\n    bytebuf_push(content, 0)\n    bytebuf_push(content, 3)\n    leb128_encode_u32(content, memory_idx)\n    bytebuf_push(content, 4)\n    leb128_encode_u32(content, realloc_idx)\n  } else {\n    leb128_encode_u32(content, 0)\n  }\n  leb128_encode_u32(content, type_idx)\n}\n\nfn emit_component_header(buf: Bytes) -> Unit {\n  bytebuf_push(buf, component_magic_0)\n  bytebuf_push(buf, component_magic_1)\n  bytebuf_push(buf, component_magic_2)\n  bytebuf_push(buf, component_magic_3)\n  bytebuf_push(buf, component_version_0)\n  bytebuf_push(buf, component_version_1)\n  bytebuf_push(buf, component_version_2)\n  bytebuf_push(buf, component_version_3)\n}\n\nlet section_core_instance = 2\n\nfn skip_core_import_desc(bytes: Bytes, start: Int, kind: Int, end_pos: Int) -> Int {\n  let mut i = start\n  if kind == 1 {\n    if i < end_pos {\n      i = i + 1\n    }\n    i = skip_wasm_limits(bytes, i, end_pos)\n  } else {\n    if kind == 2 {\n      i = skip_wasm_limits(bytes, i, end_pos)\n    } else {\n      if kind == 3 {\n        if (i + 2) <= end_pos {\n          i = i + 2\n        } else {\n          i = end_pos\n        }\n      } else {\n        if kind == 4 {\n          if i < end_pos {\n            i = i + 1\n          }\n          let (type_idx, next_i) = read_uleb(bytes, i)\n          let _ = type_idx\n          i = next_i\n        } else {\n          i = end_pos\n        }\n      }\n    }\n  }\n  if i > end_pos {\n    end_pos\n  } else {\n    i\n  }\n}\n\nfn parse_core_exports(core_wasm: Bytes, out_names: Array[String], out_func_indices: Array[Int], out_type_sigs: Array[Array[Int]]) -> Int {\n  let len = Bytes::length(core_wasm)\n  if len < 8 {\n    0\n  }\n  else {\n    let type_sigs = array_empty()\n    let func_type_indices = new_int_array()\n    let mut import_func_count = 0\n    let mut i = 8\n    let mut export_count = 0\n    while i < len {\n      let sec_id = Bytes::get(core_wasm, i)\n      i = i + 1\n      let (sec_size, next_i) = read_uleb(core_wasm, i)\n      i = next_i\n      let sec_end = i + sec_size\n      if sec_end > len {\n        i = len\n      }\n      else {\n        if sec_id == 1 {\n          parse_type_sigs(core_wasm, i, sec_end, type_sigs)\n        } else {\n          if sec_id == 2 {\n            let mut j = i\n            let (imp_count, next_j) = read_uleb(core_wasm, j)\n            j = next_j\n            let mut imp = 0\n            while imp < imp_count {\n              if j >= sec_end {\n                imp = imp_count\n              }\n              else {\n                j = skip_name(core_wasm, j)\n                j = skip_name(core_wasm, j)\n                if j >= sec_end {\n                  imp = imp_count\n                }\n                else {\n                  let kind = Bytes::get(core_wasm, j)\n                  j = j + 1\n                  if kind == 0 {\n                    let (type_idx, next_j2) = read_uleb(core_wasm, j)\n                    let _ = type_idx\n                    j = next_j2\n                    import_func_count = import_func_count + 1\n                  } else {\n                    j = skip_core_import_desc(core_wasm, j, kind, sec_end)\n                  }\n                  imp = imp + 1\n                }\n              }\n            }\n          } else {\n            if sec_id == 3 {\n              let mut j = i\n              let (func_count, next_j) = read_uleb(core_wasm, j)\n              j = next_j\n              let mut f = 0\n              while f < func_count {\n                if j >= sec_end {\n                  f = func_count\n                }\n                else {\n                  let (type_idx, next_j2) = read_uleb(core_wasm, j)\n                  Array::push(func_type_indices, type_idx)\n                  j = next_j2\n                  f = f + 1\n                }\n              }\n            } else {\n              if sec_id == 7 {\n                let mut j = i\n                let (exp_count, next_j) = read_uleb(core_wasm, j)\n                j = next_j\n                let mut e = 0\n                while e < exp_count {\n                  if j >= sec_end {\n                    e = exp_count\n                  }\n                  else {\n                    let name = read_name_string(core_wasm, j)\n                    j = skip_name(core_wasm, j)\n                    if j >= sec_end {\n                      e = exp_count\n                    }\n                    else {\n                      let kind = Bytes::get(core_wasm, j)\n                      j = j + 1\n                      let (index, next_j2) = read_uleb(core_wasm, j)\n                      j = next_j2\n                      if kind == 0 {\n                        let type_idx = if index < import_func_count {\n                          0 - 1\n                        }\n                        else {\n                          let local_idx = index - import_func_count\n                          if local_idx < Array::length(func_type_indices) {\n                            Array::get(func_type_indices, local_idx)\n                          } else {\n                            0 - 1\n                          }\n                        }\n                        if (type_idx >= 0) && (type_idx < Array::length(type_sigs)) {\n                          Array::push(out_names, name)\n                          Array::push(out_func_indices, index)\n                          Array::push(out_type_sigs, Array::get(type_sigs, type_idx))\n                          export_count = export_count + 1\n                        }\n                      }\n                      e = e + 1\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n        i = sec_end\n      }\n    }\n    export_count\n  }\n}\n\nfn parse_core_imports(core_wasm: Bytes, out_module_names: Array[String], out_func_names: Array[String], out_type_indices: Array[Int], out_type_sigs: Array[Array[Int]]) -> Int {\n  let len = Bytes::length(core_wasm)\n  if len < 8 {\n    0\n  }\n  else {\n    let mut i = 8\n    let mut import_count = 0\n    while i < len {\n      let sec_id = Bytes::get(core_wasm, i)\n      i = i + 1\n      let (sec_size, next_i) = read_uleb(core_wasm, i)\n      i = next_i\n      let sec_end = i + sec_size\n      if sec_end > len {\n        i = len\n      }\n      else {\n        if sec_id == 1 {\n          parse_type_sigs(core_wasm, i, sec_end, out_type_sigs)\n        } else {\n          if sec_id == 2 {\n            let mut j = i\n            let (imp_count, next_j) = read_uleb(core_wasm, j)\n            j = next_j\n            let mut imp = 0\n            while imp < imp_count {\n              if j >= sec_end {\n                imp = imp_count\n              }\n              else {\n                let mod_name = read_name_string(core_wasm, j)\n                j = skip_name(core_wasm, j)\n                let fn_name = read_name_string(core_wasm, j)\n                j = skip_name(core_wasm, j)\n                if j >= sec_end {\n                  imp = imp_count\n                }\n                else {\n                  let kind = Bytes::get(core_wasm, j)\n                  j = j + 1\n                  if kind == 0 {\n                    let (type_idx, next_j2) = read_uleb(core_wasm, j)\n                    j = next_j2\n                    Array::push(out_module_names, mod_name)\n                    Array::push(out_func_names, fn_name)\n                    Array::push(out_type_indices, type_idx)\n                    import_count = import_count + 1\n                  } else {\n                    j = skip_core_import_desc(core_wasm, j, kind, sec_end)\n                  }\n                  imp = imp + 1\n                }\n              }\n            }\n          }\n        }\n        i = sec_end\n      }\n    }\n    import_count\n  }\n}\n\nfn build_import_plan(core_wasm: Bytes, out_import_names: Array[String], out_binding_func_names: Array[String], out_binding_func_indices: Array[Int], out_unique_module_names: Array[String], out_module_binding_counts: Array[Int], out_comp_params: Array[Array[Int]], out_comp_param_names: Array[Array[String]], out_comp_results: Array[Array[Int]]) -> Int {\n  let imp_module_names = array_empty()\n  let imp_func_names = array_empty()\n  let imp_type_indices = new_int_array()\n  let type_sigs = array_empty()\n  let _ = parse_core_imports(core_wasm, imp_module_names, imp_func_names, imp_type_indices, type_sigs)\n  let seen_keys = array_empty()\n  let module_idx_map_keys = array_empty()\n  let module_idx_map_vals = new_int_array()\n  let mut binding_count = 0\n  let mut i = 0\n  while i < Array::length(imp_module_names) {\n    let mod_name = Array::get(imp_module_names, i)\n    let fn_name = Array::get(imp_func_names, i)\n    let key = \"\\{mod_name}||\\{fn_name}\"\n    let mut already = false\n    let mut s = 0\n    while s < Array::length(seen_keys) {\n      if Array::get(seen_keys, s) == key {\n        already = true\n      }\n      s = s + 1\n    }\n    if already == false {\n      Array::push(seen_keys, key)\n      let type_idx = Array::get(imp_type_indices, i)\n      if type_idx < Array::length(type_sigs) {\n        let sig = Array::get(type_sigs, type_idx)\n        let param_count = Array::get(sig, 0)\n        let result_count_index = 1 + param_count\n        let result_count = Array::get(sig, result_count_index)\n        let comp_params = new_int_array()\n        let mut valid = true\n        let mut p = 0\n        while p < param_count {\n          let cv = core_to_comp_valtype(Array::get(sig, 1 + p))\n          if cv < 0 {\n            valid = false\n          }\n          else {\n            Array::push(comp_params, cv)\n          }\n          p = p + 1\n        }\n        let comp_results = new_int_array()\n        let mut r = 0\n        while r < result_count {\n          let cv = core_to_comp_valtype(Array::get(sig, result_count_index + 1 + r))\n          if cv < 0 {\n            valid = false\n          }\n          else {\n            Array::push(comp_results, cv)\n          }\n          r = r + 1\n        }\n        if valid {\n          let mut mod_idx = 0 - 1\n          let mut mi = 0\n          while mi < Array::length(module_idx_map_keys) {\n            if Array::get(module_idx_map_keys, mi) == mod_name {\n              mod_idx = Array::get(module_idx_map_vals, mi)\n            }\n            mi = mi + 1\n          }\n          if mod_idx < 0 {\n            mod_idx = Array::length(out_unique_module_names)\n            Array::push(out_unique_module_names, mod_name)\n            Array::push(out_module_binding_counts, 0)\n            Array::push(module_idx_map_keys, mod_name)\n            Array::push(module_idx_map_vals, mod_idx)\n          }\n          let import_name = \"import-\\{binding_count}\"\n          Array::push(out_import_names, import_name)\n          Array::push(out_binding_func_names, fn_name)\n          Array::push(out_binding_func_indices, binding_count)\n          Array::push(out_comp_params, comp_params)\n          let empty_names = array_empty()\n          Array::push(out_comp_param_names, empty_names)\n          Array::push(out_comp_results, comp_results)\n          let cur = Array::get(out_module_binding_counts, mod_idx)\n          Array::set(out_module_binding_counts, mod_idx, cur + 1)\n          binding_count = binding_count + 1\n        }\n      }\n    }\n    i = i + 1\n  }\n  binding_count\n}\n\nlet comp_inst_arg_instance = 18\n\nfn emit_canon_lift_section(buf: Bytes, core_func_idx: Int, type_idx: Int) -> Unit {\n  bytebuf_push(buf, section_canon)\n  let content = bytebuf_new()\n  leb128_encode_u32(content, 1)\n  emit_canon_lift_func(content, core_func_idx, type_idx, 0, 0, 0)\n  emit_raw_content(buf, content)\n}\n\nfn emit_canon_lower_section(buf: Bytes, count: Int) -> Unit {\n  if count == 0 {\n    ()\n  }\n  else {\n    bytebuf_push(buf, section_canon)\n    let content = bytebuf_new()\n    leb128_encode_u32(content, count)\n    let mut i = 0\n    while i < count {\n      bytebuf_push(content, 1)\n      bytebuf_push(content, 0)\n      leb128_encode_u32(content, i)\n      leb128_encode_u32(content, 0)\n      i = i + 1\n    }\n    emit_raw_content(buf, content)\n  }\n}\n\nfn emit_comp_import_section(buf: Bytes, import_names: Array[String], count: Int) -> Unit {\n  if count == 0 {\n    ()\n  }\n  else {\n    bytebuf_push(buf, section_import)\n    let content = bytebuf_new()\n    leb128_encode_u32(content, count)\n    let mut i = 0\n    while i < count {\n      bytebuf_push(content, 0)\n      emit_name(content, Array::get(import_names, i))\n      bytebuf_push(content, comp_extern_func)\n      leb128_encode_u32(content, i)\n      i = i + 1\n    }\n    emit_raw_content(buf, content)\n  }\n}\n\nfn emit_core_module_section(buf: Bytes, core_wasm: Bytes) -> Unit {\n  bytebuf_push(buf, section_module)\n  let wasm_len = Bytes::length(core_wasm)\n  leb128_encode_u32(buf, wasm_len)\n  bytebuf_push_buf(buf, core_wasm)\n}\n\nfn emit_alias_run_and_memory(buf: Bytes, core_instance_idx: Int) -> Unit {\n  emit_alias_section(buf, core_instance_idx, [\n    \"_start\",\n    \"memory\"\n  ], [\n    core_sort_func,\n    core_sort_mem\n  ])\n}\n\nfn comp_underscores_to_dashes(name: String) -> String {\n  let len = String::length(name)\n  let mut out = \"\"\n  let mut i = 0\n  while i < len {\n    let c = String::char_code_at(name, i)\n    if c == 95 {\n      out = String::concat(out, \"-\")\n    } else {\n      out = String::concat(out, String::from_char_code(c))\n    }\n    i = i + 1\n  }\n  out\n}\n\nfn normalize_comp_param_name(name: String) -> String {\n  comp_underscores_to_dashes(name)\n}\n\nfn emit_comp_func_type(content: Bytes, param_types: Array[Int], param_names: Array[String], result_types: Array[Int], is_async: Int) -> Unit {\n  if is_async != 0 {\n    bytebuf_push(content, 67)\n  } else {\n    bytebuf_push(content, 64)\n  }\n  leb128_encode_u32(content, Array::length(param_types))\n  let mut i = 0\n  while i < Array::length(param_types) {\n    let name = if i < Array::length(param_names) {\n      normalize_comp_param_name(Array::get(param_names, i))\n    }\n    else {\n      \"p\\{i}\"\n    }\n    emit_name(content, name)\n    bytebuf_push(content, Array::get(param_types, i))\n    i = i + 1\n  }\n  if Array::length(result_types) == 0 {\n    bytebuf_push(content, 1)\n    leb128_encode_u32(content, 0)\n  } else {\n    if Array::length(result_types) == 1 {\n      bytebuf_push(content, 0)\n      bytebuf_push(content, Array::get(result_types, 0))\n    } else {\n      bytebuf_push(content, 1)\n      leb128_encode_u32(content, Array::length(result_types))\n      let mut r = 0\n      while r < Array::length(result_types) {\n        emit_name(content, \"r\\{r}\")\n        bytebuf_push(content, Array::get(result_types, r))\n        r = r + 1\n      }\n    }\n  }\n}\n\nfn emit_comp_type_section(buf: Bytes, sigs_params: Array[Array[Int]], sigs_param_names: Array[Array[String]], sigs_results: Array[Array[Int]], sigs_async: Array[Int]) -> Unit {\n  let count = Array::length(sigs_params)\n  if count == 0 {\n    ()\n  }\n  else {\n    bytebuf_push(buf, section_type)\n    let content = bytebuf_new()\n    leb128_encode_u32(content, count)\n    let mut i = 0\n    while i < count {\n      emit_comp_func_type(content, Array::get(sigs_params, i), Array::get(sigs_param_names, i), Array::get(sigs_results, i), Array::get(sigs_async, i))\n      i = i + 1\n    }\n    emit_raw_content(buf, content)\n  }\n}\n\nfn emit_comp_type_section_run(buf: Bytes) -> Unit {\n  bytebuf_push(buf, section_type)\n  let content = bytebuf_new()\n  leb128_encode_u32(content, 1)\n  emit_comp_func_type(content, array_empty(), array_empty(), [\n    comp_valtype_s64\n  ], 0)\n  emit_raw_content(buf, content)\n}\n\nfn normalize_comp_export_name(name: String) -> String {\n  comp_underscores_to_dashes(name)\n}\n\nfn emit_comp_export_section(buf: Bytes, name: String, func_idx: Int) -> Unit {\n  let export_name = normalize_comp_export_name(name)\n  bytebuf_push(buf, section_export)\n  let content = bytebuf_new()\n  leb128_encode_u32(content, 1)\n  bytebuf_push(content, 0)\n  emit_name(content, export_name)\n  bytebuf_push(content, comp_extern_func)\n  leb128_encode_u32(content, func_idx)\n  leb128_encode_u32(content, 0)\n  emit_raw_content(buf, content)\n}\n\nexport fn comp_generate_string_trampoline(string_param_count: Int, call_run_init: Int) -> Bytes {\n  let buf = bytebuf_new()\n  bytebuf_push(buf, 0)\n  bytebuf_push(buf, 97)\n  bytebuf_push(buf, 115)\n  bytebuf_push(buf, 109)\n  bytebuf_push(buf, 1)\n  bytebuf_push(buf, 0)\n  bytebuf_push(buf, 0)\n  bytebuf_push(buf, 0)\n  let body = bytebuf_new()\n  let type_sec = bytebuf_new()\n  leb128_encode_u32(type_sec, if call_run_init != 0 {\n    4\n  } else {\n    3\n  })\n  bytebuf_push(type_sec, 96)\n  leb128_encode_u32(type_sec, string_param_count + 1)\n  let mut ti = 0\n  while ti < string_param_count {\n    bytebuf_push(type_sec, 126)\n    ti = ti + 1\n  }\n  bytebuf_push(type_sec, 127)\n  bytebuf_push(type_sec, 1)\n  bytebuf_push(type_sec, 126)\n  bytebuf_push(type_sec, 96)\n  bytebuf_push(type_sec, 4)\n  bytebuf_push(type_sec, 127)\n  bytebuf_push(type_sec, 127)\n  bytebuf_push(type_sec, 127)\n  bytebuf_push(type_sec, 127)\n  bytebuf_push(type_sec, 1)\n  bytebuf_push(type_sec, 127)\n  bytebuf_push(type_sec, 96)\n  leb128_encode_u32(type_sec, string_param_count * 2)\n  let mut ci = 0\n  while ci < (string_param_count * 2) {\n    bytebuf_push(type_sec, 127)\n    ci = ci + 1\n  }\n  bytebuf_push(type_sec, 1)\n  bytebuf_push(type_sec, 126)\n  if call_run_init != 0 {\n    bytebuf_push(type_sec, 96)\n    leb128_encode_u32(type_sec, 0)\n    bytebuf_push(type_sec, 1)\n    bytebuf_push(type_sec, 126)\n  }\n  bytebuf_push_section(body, 1, type_sec)\n  let import_sec = bytebuf_new()\n  leb128_encode_u32(import_sec, if call_run_init != 0 {\n    4\n  } else {\n    3\n  })\n  emit_name(import_sec, \"env\")\n  emit_name(import_sec, \"target_func\")\n  bytebuf_push(import_sec, 0)\n  leb128_encode_u32(import_sec, 0)\n  emit_name(import_sec, \"env\")\n  emit_name(import_sec, \"cabi_realloc\")\n  bytebuf_push(import_sec, 0)\n  leb128_encode_u32(import_sec, 1)\n  if call_run_init != 0 {\n    emit_name(import_sec, \"env\")\n    emit_name(import_sec, \"run_init\")\n    bytebuf_push(import_sec, 0)\n    leb128_encode_u32(import_sec, 3)\n  }\n  emit_name(import_sec, \"env\")\n  emit_name(import_sec, \"memory\")\n  bytebuf_push(import_sec, 2)\n  bytebuf_push(import_sec, 0)\n  leb128_encode_u32(import_sec, 0)\n  bytebuf_push_section(body, 2, import_sec)\n  let func_sec = bytebuf_new()\n  leb128_encode_u32(func_sec, 1)\n  leb128_encode_u32(func_sec, 2)\n  bytebuf_push_section(body, 3, func_sec)\n  let export_sec = bytebuf_new()\n  leb128_encode_u32(export_sec, 1)\n  emit_name(export_sec, \"canon_func\")\n  bytebuf_push(export_sec, 0)\n  leb128_encode_u32(export_sec, if call_run_init != 0 {\n    3\n  } else {\n    2\n  })\n  bytebuf_push_section(body, 7, export_sec)\n  let code_sec = bytebuf_new()\n  leb128_encode_u32(code_sec, 1)\n  let func_body = bytebuf_new()\n  leb128_encode_u32(func_body, 2)\n  leb128_encode_u32(func_body, string_param_count)\n  bytebuf_push(func_body, 126)\n  leb128_encode_u32(func_body, string_param_count)\n  bytebuf_push(func_body, 127)\n  if call_run_init != 0 {\n    bytebuf_push(func_body, 16)\n    leb128_encode_u32(func_body, 2)\n    bytebuf_push(func_body, 26)\n  }\n  let tagged_base = string_param_count * 2\n  let obj_base = tagged_base + string_param_count\n  let mut si = 0\n  while si < string_param_count {\n    let ptr_local = si * 2\n    let len_local = (si * 2) + 1\n    let tagged_local = tagged_base + si\n    let obj_local = obj_base + si\n    emit_i32_const(func_body, 0)\n    emit_i32_const(func_body, 0)\n    emit_i32_const(func_body, 4)\n    emit_local_get(func_body, len_local)\n    emit_i32_const(func_body, 8)\n    emit_i32_add(func_body)\n    bytebuf_push(func_body, 16)\n    leb128_encode_u32(func_body, 1)\n    emit_local_set(func_body, obj_local)\n    emit_local_get(func_body, obj_local)\n    emit_i32_const(func_body, 1)\n    emit_i32_store(func_body, 0, 0)\n    emit_local_get(func_body, obj_local)\n    emit_local_get(func_body, len_local)\n    emit_i32_store(func_body, 0, 4)\n    emit_local_get(func_body, obj_local)\n    emit_i32_const(func_body, 8)\n    emit_i32_add(func_body)\n    emit_local_get(func_body, ptr_local)\n    emit_local_get(func_body, len_local)\n    bytebuf_push(func_body, 252)\n    leb128_encode_u32(func_body, 10)\n    bytebuf_push(func_body, 0)\n    bytebuf_push(func_body, 0)\n    emit_local_get(func_body, obj_local)\n    bytebuf_push(func_body, 173)\n    bytebuf_push(func_body, 66)\n    leb128_encode_s64(func_body, 1)\n    bytebuf_push(func_body, 132)\n    emit_local_set(func_body, tagged_local)\n    si = si + 1\n  }\n  let mut ci2 = 0\n  while ci2 < string_param_count {\n    emit_local_get(func_body, tagged_base + ci2)\n    ci2 = ci2 + 1\n  }\n  emit_i32_const(func_body, 0)\n  bytebuf_push(func_body, 16)\n  leb128_encode_u32(func_body, 0)\n  bytebuf_push(func_body, 11)\n  leb128_encode_u32(code_sec, Bytes::length(func_body))\n  bytebuf_push_buf(code_sec, func_body)\n  bytebuf_push_section(body, 10, code_sec)\n  bytebuf_push_buf(buf, body)\n  bytebuf_to_bytes(buf)\n}\n\nfn emit_core_instance_from_exports(buf: Bytes, num_modules: Int, module_binding_counts: Array[Int], binding_func_names: Array[String], binding_func_indices: Array[Int]) -> Unit {\n  if num_modules == 0 {\n    ()\n  }\n  else {\n    bytebuf_push(buf, section_core_instance)\n    let content = bytebuf_new()\n    leb128_encode_u32(content, num_modules)\n    let mut offset = 0\n    let mut m = 0\n    while m < num_modules {\n      let count = Array::get(module_binding_counts, m)\n      bytebuf_push(content, 1)\n      leb128_encode_u32(content, count)\n      let mut b = 0\n      while b < count {\n        emit_name(content, Array::get(binding_func_names, offset + b))\n        bytebuf_push(content, core_sort_func)\n        leb128_encode_u32(content, Array::get(binding_func_indices, offset + b))\n        b = b + 1\n      }\n      offset = offset + count\n      m = m + 1\n    }\n    emit_raw_content(buf, content)\n  }\n}\n\nfn emit_core_instance_instantiate_section(buf: Bytes, module_index: Int, module_names: Array[String]) -> Unit {\n  bytebuf_push(buf, section_core_instance)\n  let content = bytebuf_new()\n  leb128_encode_u32(content, 1)\n  bytebuf_push(content, 0)\n  leb128_encode_u32(content, module_index)\n  leb128_encode_u32(content, Array::length(module_names))\n  let mut i = 0\n  while i < Array::length(module_names) {\n    emit_name(content, Array::get(module_names, i))\n    bytebuf_push(content, comp_inst_arg_instance)\n    leb128_encode_u32(content, i)\n    i = i + 1\n  }\n  emit_raw_content(buf, content)\n}\n\nexport fn comp_emit_component_wasm(core_wasm: Bytes) -> Bytes {\n  let buf = bytebuf_new()\n  emit_component_header(buf)\n  emit_core_module_section(buf, core_wasm)\n  emit_core_instance_instantiate_section(buf, 0, array_empty())\n  emit_alias_run_and_memory(buf, 0)\n  bytebuf_to_bytes(buf)\n}\n\nexport fn comp_emit_component_wasm_with_lift(core_wasm: Bytes, export_name: String) -> Bytes {\n  let import_names = array_empty()\n  let binding_func_names = array_empty()\n  let binding_func_indices = new_int_array()\n  let unique_module_names = array_empty()\n  let module_binding_counts = new_int_array()\n  let comp_params = array_empty()\n  let comp_param_names = array_empty()\n  let comp_results = array_empty()\n  let import_func_count = build_import_plan(core_wasm, import_names, binding_func_names, binding_func_indices, unique_module_names, module_binding_counts, comp_params, comp_param_names, comp_results)\n  let main_instance_idx = Array::length(unique_module_names)\n  let run_core_func_idx = import_func_count\n  let run_type_idx = import_func_count\n  let run_func_idx = import_func_count\n  let buf = bytebuf_new()\n  emit_component_header(buf)\n  emit_core_module_section(buf, core_wasm)\n  let async_flags = new_int_array()\n  let mut af = 0\n  while af < import_func_count {\n    Array::push(async_flags, 0)\n    af = af + 1\n  }\n  emit_comp_type_section(buf, comp_params, comp_param_names, comp_results, async_flags)\n  emit_comp_import_section(buf, import_names, import_func_count)\n  emit_canon_lower_section(buf, import_func_count)\n  emit_core_instance_from_exports(buf, Array::length(unique_module_names), module_binding_counts, binding_func_names, binding_func_indices)\n  emit_core_instance_instantiate_section(buf, 0, unique_module_names)\n  emit_alias_run_and_memory(buf, main_instance_idx)\n  emit_comp_type_section_run(buf)\n  emit_canon_lift_section(buf, run_core_func_idx, run_type_idx)\n  emit_comp_export_section(buf, export_name, run_func_idx)\n  bytebuf_to_bytes(buf)\n}\n\nexport fn comp_emit_component_wasm_with_string_lift(core_wasm: Bytes, target_func_name: String, export_name: String, string_param_count: Int, param_names: Array[String], is_async: Int) -> Bytes {\n  let import_names = array_empty()\n  let binding_func_names = array_empty()\n  let binding_func_indices = new_int_array()\n  let unique_module_names = array_empty()\n  let module_binding_counts = new_int_array()\n  let comp_params = array_empty()\n  let comp_param_names = array_empty()\n  let comp_results = array_empty()\n  let export_names = array_empty()\n  let export_func_indices = new_int_array()\n  let export_type_sigs = array_empty()\n  let import_func_count = build_import_plan(core_wasm, import_names, binding_func_names, binding_func_indices, unique_module_names, module_binding_counts, comp_params, comp_param_names, comp_results)\n  let _ = parse_core_exports(core_wasm, export_names, export_func_indices, export_type_sigs)\n  let mut call_run_init = 0\n  let mut ei = 0\n  while ei < Array::length(export_names) {\n    if Array::get(export_names, ei) == \"_start\" {\n      call_run_init = 1\n      ei = Array::length(export_names)\n    } else {\n      ei = ei + 1\n    }\n  }\n  let has_distinct_run_alias =\n  if (call_run_init != 0) && (target_func_name != \"_start\") {\n    1\n  } else {\n    0\n  }\n  let main_instance_idx = Array::length(unique_module_names)\n  let trampoline_wasm = comp_generate_string_trampoline(string_param_count, call_run_init)\n  let buf = bytebuf_new()\n  emit_component_header(buf)\n  emit_core_module_section(buf, core_wasm)\n  emit_core_module_section(buf, trampoline_wasm)\n  let async_flags = new_int_array()\n  let mut af = 0\n  while af < import_func_count {\n    Array::push(async_flags, 0)\n    af = af + 1\n  }\n  emit_comp_type_section(buf, comp_params, comp_param_names, comp_results, async_flags)\n  emit_comp_import_section(buf, import_names, import_func_count)\n  emit_canon_lower_section(buf, import_func_count)\n  emit_core_instance_from_exports(buf, Array::length(unique_module_names), module_binding_counts, binding_func_names, binding_func_indices)\n  emit_core_instance_instantiate_section(buf, 0, unique_module_names)\n  let alias_names = array_empty()\n  let alias_sorts = new_int_array()\n  Array::push(alias_names, target_func_name)\n  Array::push(alias_sorts, core_sort_func)\n  Array::push(alias_names, \"cabi_realloc\")\n  Array::push(alias_sorts, core_sort_func)\n  if has_distinct_run_alias != 0 {\n    Array::push(alias_names, \"_start\")\n    Array::push(alias_sorts, core_sort_func)\n  }\n  Array::push(alias_names, \"memory\")\n  Array::push(alias_sorts, core_sort_mem)\n  emit_alias_section(buf, main_instance_idx, alias_names, alias_sorts)\n  let target_func_core_idx = import_func_count\n  let cabi_realloc_core_idx = import_func_count + 1\n  let run_init_core_idx =\n  if call_run_init != 0 {\n    if has_distinct_run_alias != 0 {\n      import_func_count + 2\n    } else {\n      target_func_core_idx\n    }\n  } else {\n    0 - 1\n  }\n  bytebuf_push(buf, section_core_instance)\n  let tramp_env = bytebuf_new()\n  leb128_encode_u32(tramp_env, 1)\n  bytebuf_push(tramp_env, 1)\n  leb128_encode_u32(tramp_env, if call_run_init != 0 {\n    4\n  } else {\n    3\n  })\n  emit_name(tramp_env, \"target_func\")\n  bytebuf_push(tramp_env, core_sort_func)\n  leb128_encode_u32(tramp_env, target_func_core_idx)\n  emit_name(tramp_env, \"cabi_realloc\")\n  bytebuf_push(tramp_env, core_sort_func)\n  leb128_encode_u32(tramp_env, cabi_realloc_core_idx)\n  if call_run_init != 0 {\n    emit_name(tramp_env, \"run_init\")\n    bytebuf_push(tramp_env, core_sort_func)\n    leb128_encode_u32(tramp_env, run_init_core_idx)\n  }\n  emit_name(tramp_env, \"memory\")\n  bytebuf_push(tramp_env, core_sort_mem)\n  leb128_encode_u32(tramp_env, 0)\n  emit_raw_content(buf, tramp_env)\n  let env_instance_idx = main_instance_idx + 1\n  bytebuf_push(buf, section_core_instance)\n  let tramp_inst = bytebuf_new()\n  leb128_encode_u32(tramp_inst, 1)\n  bytebuf_push(tramp_inst, 0)\n  leb128_encode_u32(tramp_inst, 1)\n  leb128_encode_u32(tramp_inst, 1)\n  emit_name(tramp_inst, \"env\")\n  bytebuf_push(tramp_inst, comp_inst_arg_instance)\n  leb128_encode_u32(tramp_inst, env_instance_idx)\n  emit_raw_content(buf, tramp_inst)\n  let trampoline_instance_idx = env_instance_idx + 1\n  emit_alias_section(buf, trampoline_instance_idx, [\n    \"canon_func\"\n  ], [\n    core_sort_func\n  ])\n  let alias_func_count = if has_distinct_run_alias != 0 {\n    3\n  } else {\n    2\n  }\n  let canon_func_core_idx = import_func_count + alias_func_count\n  bytebuf_push(buf, section_type)\n  let type_content = bytebuf_new()\n  leb128_encode_u32(type_content, 1)\n  if is_async != 0 {\n    bytebuf_push(type_content, 67)\n  } else {\n    bytebuf_push(type_content, 64)\n  }\n  leb128_encode_u32(type_content, string_param_count)\n  let mut pi = 0\n  while pi < string_param_count {\n    let pname = if pi < Array::length(param_names) {\n      normalize_comp_param_name(Array::get(param_names, pi))\n    }\n    else {\n      \"p\\{pi}\"\n    }\n    emit_name(type_content, pname)\n    bytebuf_push(type_content, comp_valtype_string)\n    pi = pi + 1\n  }\n  bytebuf_push(type_content, 0)\n  bytebuf_push(type_content, comp_valtype_s64)\n  emit_raw_content(buf, type_content)\n  let component_type_idx = import_func_count\n  bytebuf_push(buf, section_canon)\n  let canon_content = bytebuf_new()\n  leb128_encode_u32(canon_content, 1)\n  emit_canon_lift_func(canon_content, canon_func_core_idx, component_type_idx, 1, 0, cabi_realloc_core_idx)\n  emit_raw_content(buf, canon_content)\n  let lifted_func_idx = import_func_count\n  emit_comp_export_section(buf, export_name, lifted_func_idx)\n  bytebuf_to_bytes(buf)\n}\n\nfn emit_canon_task_return(buf: Bytes, result_valtype: Int) -> Unit {\n  bytebuf_push(buf, section_canon)\n  let content = bytebuf_new()\n  leb128_encode_u32(content, 1)\n  bytebuf_push(content, 9)\n  bytebuf_push(content, 0)\n  bytebuf_push(content, result_valtype)\n  bytebuf_push(content, 0)\n  emit_raw_content(buf, content)\n}\n\nfn emit_canon_lift_async_section(buf: Bytes, core_func_idx: Int, type_idx: Int) -> Unit {\n  bytebuf_push(buf, section_canon)\n  let content = bytebuf_new()\n  leb128_encode_u32(content, 1)\n  bytebuf_push(content, 0)\n  bytebuf_push(content, 0)\n  leb128_encode_u32(content, core_func_idx)\n  leb128_encode_u32(content, 1)\n  bytebuf_push(content, 6)\n  leb128_encode_u32(content, type_idx)\n  emit_raw_content(buf, content)\n}\n\nfn emit_comp_async_functype_section(buf: Bytes, result_valtype: Int) -> Unit {\n  bytebuf_push(buf, section_type)\n  let content = bytebuf_new()\n  leb128_encode_u32(content, 1)\n  bytebuf_push(content, 67)\n  bytebuf_push(content, 0)\n  bytebuf_push(content, 0)\n  bytebuf_push(content, result_valtype)\n  emit_raw_content(buf, content)\n}\n\nexport fn comp_emit_component_wasm_async(core_wasm: Bytes, export_name: String, result_valtype: Int) -> Bytes {\n  let buf = bytebuf_new()\n  emit_component_header(buf)\n  emit_core_module_section(buf, core_wasm)\n  emit_canon_task_return(buf, result_valtype)\n  emit_core_instance_from_exports(buf, 1, [\n    1\n  ], [\n    \"task-return\"\n  ], [\n    0\n  ])\n  emit_core_instance_instantiate_section(buf, 0, [\n    \"cm\"\n  ])\n  emit_comp_async_functype_section(buf, result_valtype)\n  emit_alias_section(buf, 1, [\n    \"run\"\n  ], [\n    core_sort_func\n  ])\n  emit_canon_lift_async_section(buf, 1, 0)\n  emit_comp_export_section(buf, export_name, 0)\n  bytebuf_to_bytes(buf)\n}\n\nfn comp_valtype_to_core(v: Int) -> Int {\n  if v == comp_valtype_s64 {\n    126\n  }\n  else {\n    if v == comp_valtype_s32 {\n      127\n    }\n    else {\n      if v == comp_valtype_f32 {\n        125\n      }\n      else {\n        if v == comp_valtype_f64 {\n          124\n        }\n        else {\n          127\n        }\n      }\n    }\n  }\n}\n\nfn comp_generate_async_trampoline(core_valtype: Int) -> Bytes {\n  let out = bytebuf_new()\n  emit_header(out)\n  let tc = bytebuf_new()\n  bytebuf_push_vec_header(tc, 3)\n  emit_func_type_raw(tc, [\n    126\n  ], [\n    core_valtype\n  ])\n  emit_func_type_raw(tc, [\n    core_valtype\n  ], array_empty())\n  emit_func_type_raw(tc, array_empty(), array_empty())\n  bytebuf_push_section(out, 1, tc)\n  let ic = bytebuf_new()\n  bytebuf_push_vec_header(ic, 2)\n  emit_name(ic, \"main\")\n  emit_name(ic, \"run\")\n  bytebuf_push(ic, 0)\n  bytebuf_push(ic, 0)\n  emit_name(ic, \"cm\")\n  emit_name(ic, \"task-return\")\n  bytebuf_push(ic, 0)\n  bytebuf_push(ic, 1)\n  bytebuf_push_section(out, 2, ic)\n  emit_function_section(out, [\n    2\n  ])\n  emit_export_section(out, \"run\", 2)\n  let body = bytebuf_new()\n  emit_i64_const(body, 0)\n  bytebuf_push(body, 16)\n  leb128_encode_u32(body, 0)\n  bytebuf_push(body, 16)\n  leb128_encode_u32(body, 1)\n  emit_code_section(out, [\n    body\n  ])\n  bytebuf_to_bytes(out)\n}\n\nfn emit_core_instance_instantiate_args(buf: Bytes, module_index: Int, arg_names: Array[String], arg_instance_indices: Array[Int]) -> Unit {\n  bytebuf_push(buf, section_core_instance)\n  let content = bytebuf_new()\n  leb128_encode_u32(content, 1)\n  bytebuf_push(content, 0)\n  leb128_encode_u32(content, module_index)\n  leb128_encode_u32(content, Array::length(arg_names))\n  let mut i = 0\n  while i < Array::length(arg_names) {\n    emit_name(content, Array::get(arg_names, i))\n    bytebuf_push(content, comp_inst_arg_instance)\n    leb128_encode_u32(content, Array::get(arg_instance_indices, i))\n    i = i + 1\n  }\n  emit_raw_content(buf, content)\n}\n\nexport fn comp_emit_component_wasm_async_trampolined(main_core_wasm: Bytes, export_name: String, comp_result_valtype: Int) -> Bytes {\n  let buf = bytebuf_new()\n  emit_component_header(buf)\n  emit_core_module_section(buf, main_core_wasm)\n  emit_core_module_section(buf, comp_generate_async_trampoline(comp_valtype_to_core(comp_result_valtype)))\n  emit_core_instance_instantiate_section(buf, 0, array_empty())\n  emit_canon_task_return(buf, comp_result_valtype)\n  emit_core_instance_from_exports(buf, 1, [\n    1\n  ], [\n    \"task-return\"\n  ], [\n    0\n  ])\n  emit_alias_section(buf, 0, [\n    \"run\"\n  ], [\n    core_sort_func\n  ])\n  emit_core_instance_from_exports(buf, 1, [\n    1\n  ], [\n    \"run\"\n  ], [\n    1\n  ])\n  emit_core_instance_instantiate_args(buf, 1, [\n    \"main\",\n    \"cm\"\n  ], [\n    2,\n    1\n  ])\n  emit_comp_async_functype_section(buf, comp_result_valtype)\n  emit_alias_section(buf, 3, [\n    \"run\"\n  ], [\n    core_sort_func\n  ])\n  emit_canon_lift_async_section(buf, 2, 0)\n  emit_comp_export_section(buf, export_name, 0)\n  bytebuf_to_bytes(buf)\n}\n\nfn comp_generate_wasi_fd_write_stub() -> Bytes {\n  let out = bytebuf_new()\n  emit_header(out)\n  let tc = bytebuf_new()\n  bytebuf_push_vec_header(tc, 1)\n  emit_func_type_raw(tc, [\n    127,\n    127,\n    127,\n    127\n  ], [\n    127\n  ])\n  bytebuf_push_section(out, 1, tc)\n  emit_func