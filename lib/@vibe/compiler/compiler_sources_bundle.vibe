f_push(hello_data, 108)\\n  bytebuf_push(hello_data, 108)\\n  bytebuf_push(hello_data, 111)\\n  bytebuf_push(hello_data, 32)\\n  bytebuf_push(hello_data, 119)\\n  bytebuf_push(hello_data, 111)\\n  bytebuf_push(hello_data, 114)\\n  bytebuf_push(hello_data, 108)\\n  bytebuf_push(hello_data, 100)\\n  bytebuf_push(hello_data, 10)\\n  emit_data_section(out, 8, hello_data)\\n  bytebuf_to_bytes(out)\\n}\\n\\nexport fn build_arithmetic_module() -> Bytes {\\n  let out = bytebuf_new()\\n  emit_header(out)\\n  emit_type_section(out, 2, 1)\\n  emit_function_section(out, triple_int_array(0, 0, 0))\\n  emit_export_section_multi(out, triple_string_array(\\\"add\\\", \\\"sub\\\", \\\"mul\\\"), triple_int_array(0, 1, 2))\\n  let add_body = bytebuf_new()\\n  emit_local_get(add_body, 0)\\n  emit_local_get(add_body, 1)\\n  emit_i64_add(add_body)\\n  let sub_body = bytebuf_new()\\n  emit_local_get(sub_body, 0)\\n  emit_local_get(sub_body, 1)\\n  emit_i64_sub(sub_body)\\n  let mul_body = bytebuf_new()\\n  emit_local_get(mul_body, 0)\\n  emit_local_get(mul_body, 1)\\n  emit_i64_mul(mul_body)\\n  emit_code_section(out, triple_bytes_array(add_body, sub_body, mul_body))\\n  bytebuf_to_bytes(out)\\n}\\n\\nexport fn emit_data_section_multi(out: Bytes, offsets: Array[Int], datas: Array[Bytes]) -> Unit {\\n  let count = Array::length(offsets)\\n  let content = bytebuf_new()\\n  bytebuf_push_vec_header(content, count)\\n  let mut i = 0\\n  while i < count {\\n    bytebuf_push(content, 0)\\n    emit_i32_const(content, Array::get(offsets, i))\\n    emit_end(content)\\n    let data = Array::get(datas, i)\\n    leb128_encode_u32(content, Bytes::length(data))\\n    bytebuf_push_buf(content, data)\\n    i = i + 1\\n  }\\n  bytebuf_push_section(out, builders_sec_data, content)\\n}\\n\\nexport fn build_print_string_module(msg: String) -> Bytes {\\n  let out = bytebuf_new()\\n  emit_header(out)\\n  let type_content = bytebuf_new()\\n  bytebuf_push_vec_header(type_content, 2)\\n  emit_func_type_raw(type_content, quad_int_array(builders_vt_i32, builders_vt_i32, builders_vt_i32, builders_vt_i32), singleton_int_array(builders_vt_i32))\\n  emit_func_type_raw(type_content, Array::slice([\\n    0\\n  ], 0, 0), Array::slice([\\n    0\\n  ], 0, 0))\\n  bytebuf_push_section(out, sec_type, type_content)\\n  emit_import_section_func(out, \\\"wasi_snapshot_preview1\\\", \\\"fd_write\\\", 0)\\n  emit_function_section(out, singleton_int_array(1))\\n  emit_memory_section(out, 1)\\n  emit_exports_with_memory(out, singleton_string_array(\\\"_start\\\"), singleton_int_array(1), \\\"memory\\\", 0)\\n  let str_data = string_to_data(msg)\\n  let str_len = Bytes::length(str_data)\\n  let b = bytebuf_new()\\n  emit_i32_const(b, 0)\\n  emit_i32_const(b, 16)\\n  emit_i32_store(b, 2, 0)\\n  emit_i32_const(b, 4)\\n  emit_i32_const(b, str_len)\\n  emit_i32_store(b, 2, 0)\\n  emit_i32_const(b, 1)\\n  emit_i32_const(b, 0)\\n  emit_i32_const(b, 1)\\n  emit_i32_const(b, 8)\\n  emit_call(b, 0)\\n  emit_drop(b)\\n  emit_code_section(out, singleton_bytes_array(b))\\n  emit_data_section(out, 16, str_data)\\n  bytebuf_to_bytes(out)\\n}\\n\")\n}\n\nlet cli_adapter_source_63 = () -> (String, String) {\n  (\"lib/@vibe/compiler/codegen/wasm_emit/simd.vibe\",\n\"//# WASM SIMD Instruction Emitters\\n//\\n// WASM SIMD (128-bit) instructions for v128 operations.\\n// Prefix: 0xFD (253) followed by LEB128-encoded sub-opcode.\\n//\\n// Reference: https://webassembly.github.io/spec/core/binary/instructions.html#simd-instructions\\n\\nimport ../../core/index.vibe {\\n  bytebuf_push, leb128_encode_u32\\n}\\n\\n//# Constants\\n\\nlet simd_prefix = 253\\n\\n// Memory ops (prefix + LEB128 opcode + memarg)\\nlet simd_v128_load = 0\\nlet simd_v128_store = 11\\n\\n// Splat ops\\nlet simd_i8x16_splat = 15\\n\\n// Shuffle / swizzle (i8x16.swizzle = 0x0E)\\nlet simd_i8x16_swizzle = 14\\n\\n// Comparison ops (spec sub-opcodes, see binary/instructions SIMD table)\\nlet simd_i8x16_eq = 35\\n// i8x16.le_u = 0x2A, i8x16.ge_u = 0x2C. NB: 38/40 are lt_u/gt_u, not le/ge.\\nlet simd_i8x16_le_u = 42\\nlet simd_i8x16_ge_u = 44\\n\\n// i8x16 arithmetic\\nlet simd_i8x16_sub = 113\\nlet simd_i8x16_min_u = 119\\n\\n// Boolean reduction\\nlet simd_v128_any_true = 83\\n\\n// Bitwise\\nlet simd_v128_and = 78\\nlet simd_v128_not = 77\\n\\n// i8x16 specific\\nlet simd_i8x16_all_true = 99\\nlet simd_i8x16_bitmask = 100\\n\\n// v128.const (opcode 12, followed by 16 immediate bytes)\\nlet simd_v128_const = 12\\n\\n//# Memory Instructions\\n\\n// v128.load memarg  -- load 128 bits from memory\\nexport fn emit_v128_load(buf: Bytes, align: Int, offset: Int) -> Unit {\\n  bytebuf_push(buf, simd_prefix)\\n  leb128_encode_u32(buf, simd_v128_load)\\n  leb128_encode_u32(buf, align)\\n  leb128_encode_u32(buf, offset)\\n}\\n\\n// v128.store memarg  -- store 128 bits to memory\\nexport fn emit_v128_store(buf: Bytes, align: Int, offset: Int) -> Unit {\\n  bytebuf_push(buf, simd_prefix)\\n  leb128_encode_u32(buf, simd_v128_store)\\n  leb128_encode_u32(buf, align)\\n  leb128_encode_u32(buf, offset)\\n}\\n\\n//# Splat Instructions\\n\\n// i8x16.splat  -- broadcast i32 to all 16 lanes\\nexport fn emit_i8x16_splat(buf: Bytes) -> Unit {\\n  bytebuf_push(buf, simd_prefix)\\n  leb128_encode_u32(buf, simd_i8x16_splat)\\n}\\n\\n//# Comparison Instructions\\n\\n// i8x16.eq  -- lane-wise equality, result: 0xFF or 0x00 per lane\\nexport fn emit_i8x16_eq(buf: Bytes) -> Unit {\\n  bytebuf_push(buf, simd_prefix)\\n  leb128_encode_u32(buf, simd_i8x16_eq)\\n}\\n\\n// i8x16.le_u  -- lane-wise unsigned less-or-equal (0xFD 0x2A)\\nexport fn emit_i8x16_le_u(buf: Bytes) -> Unit {\\n  bytebuf_push(buf, simd_prefix)\\n  leb128_encode_u32(buf, simd_i8x16_le_u)\\n}\\n\\n// i8x16.ge_u  -- lane-wise unsigned greater-or-equal (0xFD 0x2C)\\nexport fn emit_i8x16_ge_u(buf: Bytes) -> Unit {\\n  bytebuf_push(buf, simd_prefix)\\n  leb128_encode_u32(buf, simd_i8x16_ge_u)\\n}\\n\\n// i8x16.swizzle  -- byte shuffle of first operand by indices in second (0xFD 0x0E)\\nexport fn emit_i8x16_swizzle(buf: Bytes) -> Unit {\\n  bytebuf_push(buf, simd_prefix)\\n  leb128_encode_u32(buf, simd_i8x16_swizzle)\\n}\\n\\n// i8x16.sub  -- lane-wise wrapping subtraction (0xFD 0x71)\\nexport fn emit_i8x16_sub(buf: Bytes) -> Unit {\\n  bytebuf_push(buf, simd_prefix)\\n  leb128_encode_u32(buf, simd_i8x16_sub)\\n}\\n\\n// i8x16.min_u  -- lane-wise unsigned minimum (0xFD 0x77)\\nexport fn emit_i8x16_min_u(buf: Bytes) -> Unit {\\n  bytebuf_push(buf, simd_prefix)\\n  leb128_encode_u32(buf, simd_i8x16_min_u)\\n}\\n\\n//# Boolean Reduction\\n\\n// v128.any_true  -- 1 if any bit is non-zero\\nexport fn emit_v128_any_true(buf: Bytes) -> Unit {\\n  bytebuf_push(buf, simd_prefix)\\n  leb128_encode_u32(buf, simd_v128_any_true)\\n}\\n\\n// i8x16.all_true  -- 1 if all lanes are non-zero\\nexport fn emit_i8x16_all_true(buf: Bytes) -> Unit {\\n  bytebuf_push(buf, simd_prefix)\\n  leb128_encode_u32(buf, simd_i8x16_all_true)\\n}\\n\\n// i8x16.bitmask  -- extract MSB of each lane into i32 bitmask\\nexport fn emit_i8x16_bitmask(buf: Bytes) -> Unit {\\n  bytebuf_push(buf, simd_prefix)\\n  leb128_encode_u32(buf, simd_i8x16_bitmask)\\n}\\n\\n//# Bitwise Instructions\\n\\n// v128.and\\nexport fn emit_v128_and(buf: Bytes) -> Unit {\\n  bytebuf_push(buf, simd_prefix)\\n  leb128_encode_u32(buf, simd_v128_and)\\n}\\n\\n// v128.or  (sub-opcode 0x50 = 80; 0x4F/79 is v128.andnot — see #536)\\nexport fn emit_v128_or(buf: Bytes) -> Unit {\\n  bytebuf_push(buf, simd_prefix)\\n  leb128_encode_u32(buf, 80)\\n}\\n\\n// v128.not\\nexport fn emit_v128_not(buf: Bytes) -> Unit {\\n  bytebuf_push(buf, simd_prefix)\\n  leb128_encode_u32(buf, simd_v128_not)\\n}\\n\\n//# v128.const\\n\\n// v128.const with an explicit 16-byte little-endian immediate (0xFD 0x0C).\\n// Shorter arrays are zero-padded; longer arrays are truncated to 16 lanes.\\nexport fn emit_v128_const(buf: Bytes, lanes: Array[Int]) -> Unit {\\n  bytebuf_push(buf, simd_prefix)\\n  leb128_encode_u32(buf, simd_v128_const)\\n  let n = Array::length(lanes)\\n  let mut i = 0\\n  while i < 16 {\\n    let b = if i < n {\\n      Array::get(lanes, i)\\n    } else {\\n      0\\n    }\\n    bytebuf_push(buf, b & 255)\\n    i = i + 1\\n  }\\n}\\n\\n// v128.const -- push 16-byte immediate constant onto stack\\n// The 16 bytes are written directly after the opcode.\\nexport fn emit_v128_const_zero(buf: Bytes) -> Unit {\\n  bytebuf_push(buf, simd_prefix)\\n  leb128_encode_u32(buf, simd_v128_const)\\n  // 16 zero bytes\\n  let mut i = 0\\n  while i < 16 {\\n    bytebuf_push(buf, 0)\\n    i = i + 1\\n  }\\n}\\n\\n// v128.const with all lanes set to the same byte value\\nexport fn emit_v128_const_splat_byte(buf: Bytes, byte_val: Int) -> Unit {\\n  bytebuf_push(buf, simd_prefix)\\n  leb128_encode_u32(buf, simd_v128_const)\\n  let mut i = 0\\n  while i < 16 {\\n    bytebuf_push(buf, byte_val & 255)\\n    i = i + 1\\n  }\\n}\\n\")\n}\n\nlet cli_adapter_source_64 = () -> (String, String) {\n  (\"lib/@vibe/compiler/codegen/wasm_emit/simd_patterns.vibe\",\n\"//# SIMD Higher-Level Patterns\\n//\\n// Composable SIMD instruction sequences for common compiler operations.\\n// Each pattern emits a WASM function body into a bytebuf.\\n//\\n// Convention: all functions use i64 params/results (vibe's tagged int ABI).\\n// Memory addresses are passed as i64 and wrapped to i32 for memory ops.\\n\\nimport ../../core/index.vibe {\\n  bytebuf_push, leb128_encode_u32\\n}\\n\\nimport ./simd.vibe {\\n  emit_v128_load, emit_i8x16_splat, emit_i8x16_eq,\\n  emit_i8x16_all_true, emit_i8x16_bitmask,\\n  emit_v128_and, emit_v128_or, emit_v128_not\\n}\\n\\nimport ./instructions.vibe {\\n  emit_local_get, emit_local_set,\\n  emit_i32_wrap_i64, emit_i64_extend_i32_s, emit_i64_const,\\n  emit_i64_add, emit_i64_eq,\\n  emit_i32_load8_u,\\n  emit_return,\\n  emit_if_i64, emit_else\\n}\\n\\nimport ./code_helpers.vibe {\\n  emit_end\\n}\\n\\n//# Pattern: SIMD memcmp_16\\n//\\n// Compare 16 bytes at two memory addresses using SIMD.\\n// Params: local0=addr_a:i64, local1=addr_b:i64\\n// Returns: i64 (1 if all 16 bytes equal, 0 otherwise)\\n//\\n// Instructions (7 total):\\n//   local.get 0 / i32.wrap_i64 / v128.load\\n//   local.get 1 / i32.wrap_i64 / v128.load\\n//   i8x16.eq / i8x16.all_true / i64.extend_i32_s\\n\\nexport fn emit_simd_memcmp_16(buf: Bytes) -> Unit {\\n  emit_local_get(buf, 0)\\n  emit_i32_wrap_i64(buf)\\n  emit_v128_load(buf, 0, 0)\\n\\n  emit_local_get(buf, 1)\\n  emit_i32_wrap_i64(buf)\\n  emit_v128_load(buf, 0, 0)\\n\\n  emit_i8x16_eq(buf)\\n  emit_i8x16_all_true(buf)\\n  emit_i64_extend_i32_s(buf)\\n}\\n\\n//# Pattern: SIMD find_byte_16\\n//\\n// Find a byte in a 16-byte memory chunk using SIMD.\\n// Params: local0=addr:i64, local1=target_byte:i64\\n// Returns: i64 bitmask (bit N set if byte at offset N matches)\\n//\\n// Instructions (7 total):\\n//   local.get 0 / i32.wrap_i64 / v128.load\\n//   local.get 1 / i32.wrap_i64 / i8x16.splat\\n//   i8x16.eq / i8x16.bitmask / i64.extend_i32_s\\n\\nexport fn emit_simd_find_byte_16(buf: Bytes) -> Unit {\\n  emit_local_get(buf, 0)\\n  emit_i32_wrap_i64(buf)\\n  emit_v128_load(buf, 0, 0)\\n\\n  emit_local_get(buf, 1)\\n  emit_i32_wrap_i64(buf)\\n  emit_i8x16_splat(buf)\\n\\n  emit_i8x16_eq(buf)\\n  emit_i8x16_bitmask(buf)\\n  emit_i64_extend_i32_s(buf)\\n}\\n\\n//# Pattern: SIMD skip_whitespace_16\\n//\\n// Check a 16-byte chunk for whitespace characters (' ', '\\\\t', '\\\\n', '\\\\r').\\n// Params: local0=addr:i64\\n// Returns: i64 bitmask of NON-whitespace positions (bit set = not whitespace)\\n//\\n// Strategy: compare chunk against each whitespace byte, OR the masks,\\n// then NOT to get non-whitespace positions, then bitmask.\\n//\\n// Instructions:\\n//   v128.load chunk\\n//   4x (i8x16.splat + i8x16.eq) for ' ', '\\\\t', '\\\\n', '\\\\r'\\n//   3x v128.or to combine\\n//   v128.not → non-whitespace mask\\n//   i8x16.bitmask → i32 → i64\\n\\nexport fn emit_simd_skip_whitespace_16(buf: Bytes) -> Unit {\\n  // Load chunk: local.get 0 / i32.wrap / v128.load\\n  emit_local_get(buf, 0)\\n  emit_i32_wrap_i64(buf)\\n  emit_v128_load(buf, 0, 0)\\n  emit_local_set(buf, 2)  // local2 = chunk\\n\\n  // is_space = i8x16.eq(chunk, splat(0x20))\\n  emit_local_get(buf, 2)\\n  emit_i64_const(buf, 0x20)\\n  emit_i32_wrap_i64(buf)\\n  emit_i8x16_splat(buf)\\n  emit_i8x16_eq(buf)\\n  // stack: is_space\\n\\n  // is_tab = i8x16.eq(chunk, splat(0x09))\\n  emit_local_get(buf, 2)\\n  emit_i64_const(buf, 0x09)\\n  emit_i32_wrap_i64(buf)\\n  emit_i8x16_splat(buf)\\n  emit_i8x16_eq(buf)\\n  // stack: is_space, is_tab\\n\\n  emit_v128_or(buf)\\n  // stack: is_space|is_tab\\n\\n  // is_nl = i8x16.eq(chunk, splat(0x0A))\\n  emit_local_get(buf, 2)\\n  emit_i64_const(buf, 0x0A)\\n  emit_i32_wrap_i64(buf)\\n  emit_i8x16_splat(buf)\\n  emit_i8x16_eq(buf)\\n  // stack: (is_space|is_tab), is_nl\\n\\n  emit_v128_or(buf)\\n  // stack: is_space|is_tab|is_nl\\n\\n  // is_cr = i8x16.eq(chunk, splat(0x0D))\\n  emit_local_get(buf, 2)\\n  emit_i64_const(buf, 0x0D)\\n  emit_i32_wrap_i64(buf)\\n  emit_i8x16_splat(buf)\\n  emit_i8x16_eq(buf)\\n  // stack: (is_space|is_tab|is_nl), is_cr\\n\\n  emit_v128_or(buf)\\n  // stack: is_ws (all whitespace positions)\\n\\n  // NOT → non-whitespace, then bitmask\\n  emit_v128_not(buf)\\n  emit_i8x16_bitmask(buf)\\n  emit_i64_extend_i32_s(buf)\\n  // result: bitmask where bit N set = byte N is NOT whitespace\\n  // caller uses ctz to find first non-whitespace position\\n}\\n\\n//# Pattern: SIMD in_range_16\\n//\\n// Check if each byte in a 16-byte chunk is within [low, high] range.\\n// Params: local0=addr:i64, local1=low:i64, local2=high:i64\\n// Returns: i64 bitmask of bytes OUTSIDE range (bit set = out of range)\\n//\\n// Uses: v128_le_u_i8x16 is not yet in our emit set, so we use\\n// a subtraction trick: (byte - low) <= (high - low) using unsigned comparison.\\n// For simplicity, we use splat + eq for exact byte matching instead.\\n//\\n// Actually: since we don't have le_u yet, provide an alternative pattern\\n// that checks membership in a character set via multiple eq + or.\\n\\nexport fn emit_simd_is_identifier_char_16(buf: Bytes) -> Unit {\\n  // Load chunk\\n  emit_local_get(buf, 0)\\n  emit_i32_wrap_i64(buf)\\n  emit_v128_load(buf, 0, 0)\\n  emit_local_set(buf, 1)  // local1 = chunk\\n\\n  // Check '_' (0x5F)\\n  emit_local_get(buf, 1)\\n  emit_i64_const(buf, 0x5F)\\n  emit_i32_wrap_i64(buf)\\n  emit_i8x16_splat(buf)\\n  emit_i8x16_eq(buf)\\n  // stack: is_underscore\\n\\n  // For [a-z], [A-Z], [0-9] we'd need le_u.\\n  // Emit the underscore check as a starting point; full range check\\n  // requires adding emit_i8x16_le_u to simd.vibe (opcode 0xFD 0x26).\\n\\n  // For now, bitmask the underscore-only result as a prototype\\n  emit_i8x16_bitmask(buf)\\n  emit_i64_extend_i32_s(buf)\\n}\\n\\n//# Scalar baselines (for code size comparison)\\n\\n// i64.load instruction (opcode 0x29 = 41, followed by memarg)\\nfn emit_i64_load(buf: Bytes, align: Int, offset: Int) -> Unit {\\n  bytebuf_push(buf, 41)\\n  leb128_encode_u32(buf, align)\\n  leb128_encode_u32(buf, offset)\\n}\\n\\n//# Scalar memcmp_16 (unrolled, 2x i64.load)\\n//\\n// Compare 16 bytes as two 8-byte i64 loads.\\n// Params: local0=addr_a:i64, local1=addr_b:i64\\n// Returns: i64 (1 if equal, 0 otherwise)\\n//\\n// This is the realistic scalar baseline -- compilers unroll small memcmp\\n// into word-sized loads. Still more instructions than SIMD.\\n\\nexport fn emit_scalar_memcmp_16_unrolled(buf: Bytes) -> Unit {\\n  // Compare first 8 bytes\\n  emit_local_get(buf, 0)\\n  emit_i32_wrap_i64(buf)\\n  emit_i64_load(buf, 0, 0)\\n\\n  emit_local_get(buf, 1)\\n  emit_i32_wrap_i64(buf)\\n  emit_i64_load(buf, 0, 0)\\n\\n  emit_i64_eq(buf)\\n  // if first 8 bytes equal, check second 8 bytes\\n  emit_if_i64(buf)\\n    emit_local_get(buf, 0)\\n    emit_i32_wrap_i64(buf)\\n    emit_i64_load(buf, 0, 8)\\n\\n    emit_local_get(buf, 1)\\n    emit_i32_wrap_i64(buf)\\n    emit_i64_load(buf, 0, 8)\\n\\n    emit_i64_eq(buf)\\n    emit_i64_extend_i32_s(buf)\\n  emit_else(buf)\\n    emit_i64_const(buf, 0)\\n  emit_end(buf)\\n}\\n\\n//# Scalar find_byte_16 (unrolled, 4 bytes checked)\\n//\\n// Check bytes one by one with conditional branches.\\n// Params: local0=addr:i64, local1=target_byte:i64\\n// Returns: i64 bitmask (1<<pos for first match, 0 if not found)\\n//\\n// Only checks first 4 bytes for code brevity. A full 16-byte unroll\\n// would be 4x larger, making the SIMD advantage even more dramatic.\\n\\nexport fn emit_scalar_find_byte_16_unrolled(buf: Bytes) -> Unit {\\n  // Byte 0\\n  emit_local_get(buf, 0)\\n  emit_i32_wrap_i64(buf)\\n  emit_i32_load8_u(buf, 0, 0)\\n  emit_i64_extend_i32_s(buf)\\n  emit_local_get(buf, 1)\\n  emit_i64_eq(buf)\\n  emit_if_i64(buf)\\n    emit_i64_const(buf, 1)\\n    emit_return(buf)\\n  emit_else(buf)\\n    // Byte 1\\n    emit_local_get(buf, 0)\\n    emit_i32_wrap_i64(buf)\\n    emit_i32_load8_u(buf, 0, 1)\\n    emit_i64_extend_i32_s(buf)\\n    emit_local_get(buf, 1)\\n    emit_i64_eq(buf)\\n    emit_if_i64(buf)\\n      emit_i64_const(buf, 2)\\n      emit_return(buf)\\n    emit_else(buf)\\n      // Byte 2\\n      emit_local_get(buf, 0)\\n      emit_i32_wrap_i64(buf)\\n      emit_i32_load8_u(buf, 0, 2)\\n      emit_i64_extend_i32_s(buf)\\n      emit_local_get(buf, 1)\\n      emit_i64_eq(buf)\\n      emit_if_i64(buf)\\n        emit_i64_const(buf, 4)\\n        emit_return(buf)\\n      emit_else(buf)\\n        // Byte 3\\n        emit_local_get(buf, 0)\\n        emit_i32_wrap_i64(buf)\\n        emit_i32_load8_u(buf, 0, 3)\\n        emit_i64_extend_i32_s(buf)\\n        emit_local_get(buf, 1)\\n        emit_i64_eq(buf)\\n        emit_if_i64(buf)\\n          emit_i64_const(buf, 8)\\n          emit_return(buf)\\n        emit_else(buf)\\n          emit_i64_const(buf, 0)\\n        emit_end(buf)\\n      emit_end(buf)\\n    emit_end(buf)\\n  emit_end(buf)\\n}\\n\")\n}\n\nlet cli_adapter_source_65 = () -> (String, String) {\n  (\"lib/@vibe/compiler/codegen/common_base/index.vibe\",\n\"//# Imports\\n\\nimport ../../core {\\n  Expr, Pat, Stmt, TypeExpr, __to_string, bytebuf_push, leb128_encode_u32,\\n  apply_perm_strings, bsearch_leftmost, sort_perm_by_names\\n}\\n\\nimport ../wasm_emit {\\n  emit_call, emit_call_indirect, emit_else, emit_end, emit_i32_add, emit_i32_const, emit_i32_load, emit_i32_load8_u, emit_i32_store, emit_i32_store8, emit_i32_wrap_i64, emit_i64_add, emit_i64_and, emit_i64_const, emit_i64_div_s, emit_i64_eq, emit_i64_eqz, emit_i64_extend_i32_s, emit_i64_ge_s, emit_i64_gt_s, emit_i64_le_s, emit_i64_lt_s, emit_i64_mul, emit_i64_ne, emit_i64_or, emit_i64_rem_s, emit_i64_shl, emit_i64_shr_s, emit_i64_store, emit_i64_sub, emit_i64_xor, emit_if_void, emit_local_get, emit_local_set\\n}\\n\\n//# Types\\n\\nexport struct FuncTable {\\n  names: Array[String];\\n  indices: Array[Int];\\n  params: Array[Int];\\n  returns: Array[Int];\\n  needs_env: Array[Bool]\\n}\\n\\nexport struct StrTable {\\n  strs: Array[String];\\n  offsets: Array[Int];\\n  lengths: Array[Int]\\n}\\n\\nexport struct LambdaTable {\\n  bodies: Array[Bytes];\\n  param_counts: Array[Int];\\n  captures: Array[Array[String]];\\n  meta_i32: Array[Int];\\n  meta_i64: Array[Int]\\n}\\n\\nexport struct CtorTable {\\n  names: Array[String];\\n  tags: Array[Int];\\n  field_counts: Array[Int];\\n  type_names: Array[String];\\n  struct_names: Array[String];\\n  struct_field_names: Array[Array[String]];\\n  // Sorted view of `names` + original-position payload (ctor_sorted_index).\\n  // ctor_table_index_of binary-searches these instead of linearly scanning\\n  // `names` per constructor reference -- lookup_ctor was a top-10 self-time\\n  // entry in compiler-closure compile profiles. Keep in sync with `names`\\n  // (same length); ctor_table_index_of falls back to the linear scan when a\\n  // hand-built table skips them.\\n  names_sorted: Array[String];\\n  names_sorted_pos: Array[Int]\\n}\\n\\n// #cov branch coverage state, threaded via CompileCtx. Linear-backend only;\\n// active only when `enabled` (VIBE_COVERAGE=1 build). `base`/`cap` bound a fixed\\n// reserved memory region (1 byte per branch id). `next` is a 1-element mutable\\n// counter cell assigning sequential branch ids in codegen-traversal order;\\n// `cur_fn` is a 1-element cell holding the index of the function currently being\\n// compiled (set before each top-level body). `owners` accumulates, per branch\\n// id in id order, the owning function index so the report attributes branches to\\n// functions (reusing the `vibe_cov` function-name table). When disabled all of\\n// this is inert and codegen output is byte-identical to a normal build.\\nexport struct CovState {\\n  enabled: Bool;\\n  base: Int;\\n  cap: Int;\\n  next: Array[Int];\\n  cur_fn: Array[Int];\\n  owners: Array[Int]\\n}\\n\\n// A disabled CovState (coverage off): inert, used by the normal compile path and\\n// the non-WASI module entry. Fresh 1-element cells keep Array::get safe.\\nexport fn cov_disabled() -> CovState {\\n  CovState::{\\n    enabled: false,\\n    base: 0,\\n    cap: 0,\\n    next: [\\n      0\\n    ],\\n    cur_fn: [\\n      0\\n    ],\\n    owners: ArrayBuilder::freeze(ArrayBuilder::new())\\n  }\\n}\\n\\n// #cov: emit a stack-neutral hit store for one branch target and assign it the\\n// next sequential branch id, recording the owning function index. No-op when\\n// coverage is off or the fixed-cap region is full. Called at the start of each\\n// branch arm's instruction sequence (if/else, match arm), so the store runs\\n// only when that branch is actually taken at run time.\\nexport fn cov_emit_branch(buf: Bytes, cov: CovState) -> Unit {\\n  if cov.enabled {\\n    let id = Array::get(cov.next, 0)\\n    if id < cov.cap {\\n      Array::set(cov.next, 0, id + 1)\\n      Array::push(cov.owners, Array::get(cov.cur_fn, 0))\\n      emit_i32_const(buf, cov.base + id)\\n      emit_i32_const(buf, 1)\\n      emit_i32_store8(buf, 0, 0)\\n    } else {\\n      ()\\n    }\\n  } else {\\n    ()\\n  }\\n}\\n\\nexport struct CompileCtx {\\n  func_table: FuncTable;\\n  str_table: StrTable;\\n  lambda_table: LambdaTable;\\n  num_user_funcs: Int;\\n  func_offset: Int;\\n  ref_cell_names: Array[String];\\n  ctor_table: CtorTable;\\n  thunk_names: Array[String];\\n  const_int_names: Array[String];\\n  const_int_values: Array[Int];\\n  // Perceus RC mode (docs/spec/selfhost-rc-port.md). When true, heap objects\\n  // carry a uniform `[type_id@0][length@4][payload@8...]` header so the (future)\\n  // RC drop helper can dispatch and recurse. Default false: layout unchanged.\\n  // Threaded as a parameter on the WASI compile path (a module-level flag is\\n  // not usable: a getter capturing it is `missing closure env` in the native\\n  // CLI codegen, and a cross-module `let` reference is `unknown name`).\\n  enable_rc: Bool;\\n  // #715 recurrence guard (VIBE_RC=shadow): emit shadow-liveness traps -- a\\n  // byte per heap address marks freed blocks; the FIRST dup-of-freed or\\n  // drop-of-freed executes `unreachable` instead of silently corrupting the\\n  // free list. Debug-only; false (byte-identical output) on normal builds.\\n  rc_shadow: Bool;\\n  // RC: names of `let` bindings whose value the Perceus analysis says to drop\\n  // at scope end (computed per function from build_perceus_plan). compile_expr\\n  // emits an rc_drop for a tuple binding whose name appears here.\\n  rc_drop_names: Array[String];\\n  // RC: alias bindings (`let a = t`) whose source `t` is multiply-used, so the\\n  // alias takes a duplicated reference — compile_expr emits an rc_dup of the\\n  // source at the alias `let`. (PaAliasDup from the Perceus plan.)\\n  rc_alias_dup_names: Array[String];\\n  // RC: bindings known at codegen time to hold a heap object (bound to a\\n  // tuple/record/enum literal, or an alias of such). Built as `let`s compile.\\n  // Gates rc_dup / rc_drop so we never touch a non-heap (e.g. Int-returning\\n  // call) binding the static Perceus `scalar` flag over-approximates as heap.\\n  heap_binding_names: Array[String];\\n  // RC: wasm function index of the generic recursive `vibe_rc_drop` helper\\n  // (ADR-0055 Stage 3), or -1 when unavailable (non-RC, or the legacy inline\\n  // drop). When >= 0, scope-end drops emit a `call` to it so nested heap is\\n  // reclaimed to arbitrary depth.\\n  rc_drop_func_idx: Int;\\n  // RC: wasm function index of the free-list search allocator `vibe_rc_alloc`\\n  // (ADR-0055 Stage 4), or -1 when unavailable (non-RC). When >= 0, heap-object\\n  // construction calls it with the block size so an exact-fit free block is found\\n  // anywhere in the free-list (not just the head), eliminating the size-ordering\\n  // fragmentation a head-only check leaves when interleaved sizes are freed.\\n  rc_alloc_func_idx: Int;\\n  // Linear-memory backend: wasm function index of `vibe_heap_grow_check`, or -1\\n  // when the surrounding module does not define the helper. Bump allocations\\n  // call it after updating global 0 so low initial memory can grow on demand.\\n  heap_grow_check_func_idx: Int;\\n  // RC: names of `let` bindings the Perceus plan marks with a non-alias `PaDup`\\n  // (a heap value used in more than one *owning* position, e.g. `let u = (t, t)`\\n  // dups `t`). One entry per dup (so a name's multiplicity = its dup budget).\\n  // compile_expr emits that many guarded rc_dups at the binding site, giving the\\n  // block the extra references its container/owning uses consume — without this\\n  // the recursive drop visits the shared child more times than it has refs.\\n  // (ADR-0055 Stage 4.)\\n  rc_dup_names: Array[String];\\n  // Blocker-3 (ADR-0055): append-only log of `slot*2 + flag` entries (flag 1 =\\n  // a `let`/`let mut` binding whose value is statically floatish; flag 0 = a\\n  // non-float rebind overriding a previously-float slot). The MOST RECENT entry\\n  // for a local slot wins, so `expr_is_floatish` can recognise a *variable*\\n  // holding a float (`let x = 1.5; x + y` takes the f64 path) while a shadowing\\n  // rebind of another type — nested block or if/match branch reusing the slot —\\n  // is classified by its own binding. Append-only (not truncated) because the\\n  // wasm-gc backend cannot truncate a struct-field array; the log only grows for\\n  // float-related bindings, which are rare. Still a syntactic over-\\n  // approximation (the AST is untyped): float function params / lambda-captured\\n  // floats are not tracked.\\n  // #799 perf: membership index over func_table.names + ctor_table.names,\\n  // built ONCE per compile. collect_free_vars_indexed consults it per ident\\n  // instead of linearly scanning the flat name arrays (which was ~70% of a\\n  // compiler-closure compile's profile).\\n  // Round 2: the Map representation was itself a linear assoc scan per\\n  // lookup (Map::has_key is O(entries)); now a SORTED name array consulted\\n  // via binary search (core/sorted_index.vibe).\\n  capture_name_index: Array[String];\\n  float_local_slots: Array[Int];\\n  // #678: append-only log of `slot*2 + flag` entries, the integer dual of\\n  // float_local_slots. flag 1 marks a `let`/`let mut` slot whose value is\\n  // statically integral (Int/Bool); flag 0 a non-int rebind overriding a\\n  // previously-int slot. Most-recent entry per slot wins, so a bare integer\\n  // variable in `==`/`!=` takes the direct `i64.eq` path instead of the\\n  // polymorphic `eq` whose string fall-back misreads a large int as a string\\n  // fat-pointer (two unequal ints with a zero low word compare EQUAL). UNLIKE\\n  // the float log this one IS pruned: `int_log_reset_above` drops entries for\\n  // slots a branch/arm is about to reuse, so a slot rebound by a NON-`let`\\n  // binder (match-arm / for-in / catch-all pattern var) — which never logs an\\n  // entry — is never read as a stale int. Without that pruning a reused slot\\n  // holding a string would be misclassified and string `==` would break.\\n  int_local_slots: Array[Int];\\n  // #724: append-only log of `slot*256 + kind*64 + n` entries tracking\\n  // let-bound AGGREGATE literals, so `a == b` with BOTH sides non-literal\\n  // bindings can still take the structural comparators (the generic runtime\\n  // `eq` pointer-compares tuples, which carry no runtime header to walk).\\n  // kind 1 = tuple literal (n = arity), kind 2 = ctor / record literal\\n  // (n = field count), kind 0 = non-aggregate rebind overriding a reused\\n  // slot. Most-recent entry per slot wins; pruned at the same branch/arm\\n  // boundaries as int_local_slots (agg_log_reset_above) so a slot reused by\\n  // a non-`let` binder is never read as a stale aggregate. Bindings whose\\n  // value shape is not statically known (params, call results, match binds)\\n  // are NOT tracked and keep the generic-eq fallback.\\n  agg_local_slots: Array[Int];\\n  // #672 (post-#724): parallel array to agg_local_slots, SAME length and\\n  // index correspondence (every push to agg_local_slots pushes exactly one\\n  // entry here too, in the same call). Holds the actual shape LITERAL\\n  // expression (ETuple / ctor ECall / nullary-ctor EIdent) backing a kind-1\\n  // (tuple) or kind-2 (ctor/record) entry, or an inert EInt(0) placeholder\\n  // for kind-0 / untracked entries (never consulted — callers only read this\\n  // after confirming kind via agg_slot_lookup). This lets `a == b` on a\\n  // TRACKED variable recurse into NESTED aggregate elements (e.g. `let a =\\n  // ((1,2),3)`) the same way a literal operand does, instead of only\\n  // comparing the top-level shape and falling back to pointer `eq` for any\\n  // element that is itself an aggregate. See agg_expr_lookup / emit_eq_shape_slots\\n  // (compile_expr.vibe).\\n  agg_local_exprs: Array[Expr];\\n  // #724 round 2: program-wide (fn name -> declared aggregate return shape)\\n  // parallel arrays (see compute_agg_returning). Shared across functions —\\n  // NOT per-function like agg_local_slots.\\n  agg_ret_names: Array[String];\\n  agg_ret_infos: Array[Int];\\n  // #791: program-wide (fn name) set for top-level functions whose DECLARED\\n  // return type is heap (see compute_heap_returning / type_expr_is_heap).\\n  // Consulted by classify_let_value_heap so `let mut s = Set::new()` reads\\n  // Set::new's own `-> Set[T]` signature instead of over-approximating every\\n  // ECall-valued let/let-mut as heap. Shared across functions, like\\n  // agg_ret_names.\\n  heap_ret_names: Array[String];\\n  // #545 nesting: declared effect names (excluding `Error`), in tag-assignment\\n  // order. Effect `effect_names[i]` is routed through wasm exception tag `3 + i`\\n  // with its own resume frontier; `perform` and `handle` both derive the tag\\n  // from this list so a perform reaches its own handler through an unrelated\\n  // inner handle (which catches a different tag) and uses an independent\\n  // frontier. See effect_name_to_tag.\\n  effect_names: Array[String];\\n  // #548 multi-value payloads: parallel arrays keyed by full op name\\n  // (\\\"Effect::Op\\\") giving each effect op's DECLARED parameter count. The handle\\n  // arm uses the declared arity (not the pattern arity) to decide whether the\\n  // thrown payload is a packed tuple to destructure (arity > 1) or a single\\n  // value — so an extra continuation-slot bind like `Question(q, k)` on a\\n  // 1-arg op is not mistaken for a 2-tuple. See effect_op_declared_arity.\\n  effect_op_keys: Array[String];\\n  effect_op_arities: Array[Int];\\n  // #cov branch coverage state (linear backend). cov_disabled() when off.\\n  cov: CovState;\\n  // Interior-line breakpoints (span-arc step5): wasm function index of the\\n  // `vibe::dbg_line` host import, or -1 when off (default / non-break /\\n  // multi-file). When >= 0, the ELet/ELetMut/ESeq handlers emit\\n  // `i32.const <line>` + `call dbg_line_idx` at each statement boundary so the\\n  // runner can pause at interior source lines. Default -1: codegen unchanged.\\n  dbg_line_idx: Int;\\n  // Interior-line breakpoints: sorted newline char-offsets of THIS function's\\n  // source file, used to map a statement's char-offset to a 1-based line. Empty\\n  // when off.\\n  dbg_line_nl: Array[Int];\\n  // Interior-line breakpoints (multi-file): the file id of THIS function's source\\n  // file (index into `vibe.dbgfiles`), emitted alongside the line so the runner\\n  // matches `--break <file>:<line>` against the right file. 0 when off.\\n  dbg_line_file_id: Int;\\n  // #706 (RC): names live-in to the innermost enclosing `while` loop. A loop body\\n  // re-executes, so passing such an owned heap value to a consuming call frees it\\n  // on iteration 1 and dangles on the next (use-after-free). compile_call emits a\\n  // guarded rc_dup for a bare-ident owning arg whose name is in this set, so each\\n  // iteration's consume is balanced and the loop-carried reference survives. The\\n  // EWhile codegen sets this to the live-in locals around the body and restores\\n  // it after (a shared mutable array; bindings declared inside the body are never\\n  // added). Empty outside any loop; rc_dup is a no-op under bump, so the\\n  // bump-built selfhost compiler is unaffected.\\n  loop_borrowed_names: Array[String];\\n  // #706 leak follow-up: append-only per-function log — one entry per loop-\\n  // borrowed identifier name each time compile_call emits the protective\\n  // rc_dup (see loop_borrowed_names above). That dup+the callee's own internal\\n  // drop cancel out across the loop, so the textual occurrence the Perceus plan\\n  // treated as \\\"one real consume\\\" of the binding actually consumes NOTHING from\\n  // it — the plan's `remaining` count is therefore one too low per occurrence,\\n  // and it omits the function-exit drop the binding still needs. The function\\n  // epilogue (linked_compile.vibe) counts each function param's occurrences in\\n  // this log and emits that many EXTRA rc_drop calls, exactly compensating\\n  // without touching the plan's borrow/consume decisions anywhere else (so it\\n  // cannot perturb a path the plan and codegen already agree on).\\n  loop_consumed_names: Array[String];\\n  // #707: names of user-defined `let`s whose body provably tail-reaches only\\n  // `Array::get`/`Map::get`/`__index` (transitively, through if/match/wrapper\\n  // calls to other names already in this list) — computed once per compile via\\n  // `compute_borrow_returning_names` over the merged program. compile_call's\\n  // `cc_is_borrow_ret_call` treats a call to one of these exactly like a direct\\n  // `Array::get`/`Map::get`/`__index` call: its result is a borrowed view of a\\n  // heap element (no refcount bump), so passing it into an OWNING position\\n  // (ctor field / consuming call arg) needs the same guarded rc_dup or the\\n  // element is double-freed when its container is later dropped (e.g. a\\n  // `peek(tokens, pos)` wrapper around `Array::get`). Empty outside RC.\\n  borrow_ret_names: Array[String];\\n  // #710: names of top-level functions whose DECLARED return type (from\\n  // their `let f: (...) -> R = ...` signature) is provably scalar (Int/Bool/\\n  // Unit) — computed once via `compute_scalar_returning_names` over the\\n  // merged program. The ELet ECall branch (compile_expr_tail.vibe) consults\\n  // this to skip `heap_binding_names` for `let n = f(...)` when `f` is one of\\n  // these: without it, ANY non-borrow-ret call result defaults to heap, so a\\n  // binding that is really a plain Int (e.g. `build_import_plan(...) -> Int`)\\n  // gets treated as a tagged pointer. If that binding is later aliased more\\n  // than once, the Perceus plan schedules a PaAliasDup for it, and\\n  // `emit_rc_dup_local` untags-and-derefs the \\\"pointer\\\" — for a small int\\n  // like 0 that reads/writes near address -4, a `memory access out of\\n  // bounds` trap, not a leak. Empty outside RC.\\n  scalar_ret_names: Array[String];\\n  // #875 fix 2: single-slot mutable hint (0 = unset, 1 entry = pending name),\\n  // set by the ELetRec codegen handler (compile_expr_tail.vibe, `__tag == 10`)\\n  // immediately before compiling a `let rec NAME = (...) -> { ... }` closure's\\n  // OWN value, and consumed (read + cleared) as the very first action of\\n  // compile_lambda -- the sole, immediate callee that dispatch to an EFn value\\n  // reaches (compile_expr -> compile_expr_tail chain -> compile_expr_tail3\\n  // `__tag == 24`), so the window between set and consume contains no\\n  // throwable code and no other codegen call. Lets compile_lambda force NAME\\n  // into its own capture list (collect_free_vars_indexed_self) even when NAME\\n  // collides by bare string equality with an unrelated entry already in\\n  // capture_name_index (see collect_free_vars_indexed_self's doc comment in\\n  // common_analysis/index.vibe) -- without this, a colliding let-rec closure's\\n  // self-reference is wrongly treated as \\\"resolves globally\\\" and never\\n  // captured, so it has no way to call itself (#875). Any OTHER EFn value\\n  // (anonymous lambda, non-rec `let`) leaves this empty, so capture\\n  // computation is byte-identical to before. Reset to empty in every\\n  // freshly-derived per-lambda CompileCtx (see compile_lambda.vibe's\\n  // `lam_ctx`) so a nested let-rec inside a closure body starts with no\\n  // stale hint from its enclosing scope.\\n  pending_letrec_self_name: Array[String]\\n}\\n\\n// Interior-line breakpoints (span-arc step5, multi-file): per-file provenance the\\n// break codegen needs to emit `vibe::dbg_line(<file_id>, <line>)` and a\\n// `vibe.dbgfiles` section. `files[k]` is the basename of source file id k;\\n// `file_nls[k]` its newline char-offsets; `stmt_file_id[s]` the file id of merged\\n// top-level statement s. Empty (via empty_dbg_prov) on non-break builds.\\nexport struct DbgProv {\\n  files: Array[String];\\n  file_nls: Array[Array[Int]];\\n  stmt_file_id: Array[Int]\\n}\\n\\nexport fn empty_dbg_prov() -> DbgProv {\\n  DbgProv::{\\n    files: Array::slice([\\n      \\\"\\\"\\n    ], 0, 0),\\n    file_nls: Array::slice([\\n      Array::slice([\\n        0\\n      ], 0, 0)\\n    ], 0, 0),\\n    stmt_file_id: Array::slice([\\n      0\\n    ], 0, 0)\\n  }\\n}\\n\\nexport struct CompileCtxGc {\\n  func_table: FuncTable;\\n  str_table: StrTable;\\n  lambda_table: LambdaTable;\\n  num_user_funcs: Int;\\n  func_offset: Int;\\n  ref_cell_names: Array[String];\\n  ref_local_indices: Array[Int];\\n  refcell_type_idx: Int;\\n  closure_type_base: Int;\\n  // Named gc_ctor_table, NOT ctor_table: codegen resolves record fields by\\n  // name-first-match across ALL struct declarations (compile_expr_tail4 EDot),\\n  // so a field name shared with CompileCtx at a DIFFERENT position reads the\\n  // wrong slot. CompileCtx.ctor_table sits at index 6; this one is index 9 --\\n  // sharing the name made every gc-lane ctor lookup read ref_local_indices\\n  // (empty) instead of the table. See the field-collision issue for the\\n  // root-cause fix direction.\\n  gc_ctor_table: CtorTable;\\n  // #538: module-level literal constants (`let op_call = 16` etc.). Kind 0 =\\n  // Int/Bool (value in gc_const_ivals), kind 1 = String (value in\\n  // gc_const_svals, rendered via the string table). All fields gc_-prefixed\\n  // for the same collision reason as gc_ctor_table (CompileCtx carries\\n  // const_int_names/const_int_values at different slots).\\n  gc_const_names: Array[String];\\n  gc_const_kinds: Array[Int];\\n  gc_const_ivals: Array[Int];\\n  gc_const_svals: Array[String];\\n  // #538: module-level COMPUTED values (`let t = Bytes::from_array([..])`):\\n  // one mutable i64 wasm global each (index 1 + position; global 0 is the\\n  // heap pointer), initialized at the top of _start in statement order.\\n  gc_global_names: Array[String];\\n  // #538 P4.5: locals KNOWN to hold f64 raw bits (shape-tracked at let-bind:\\n  // float literal / Int::to_double / float arithmetic). Fresh per function\\n  // (like ref_cell_names). Arithmetic on a floatish operand emits real f64\\n  // ops — the unconditional i64 ops silently zeroed float-literal parsing\\n  // (lexer parse_frac_digits) when the gc-compiled compiler ran. Best-effort:\\n  // annotated Double params and tuple-destructured floats are NOT tracked.\\n  gc_float_locals: Array[String];\\n  // #724: gc twin of CompileCtx.agg_local_slots (same encoding + pruning\\n  // discipline) so the gc lane's structural ==/!= also covers non-literal\\n  // aggregate bindings. gc_-prefixed per the #722 field-collision convention.\\n  gc_agg_local_slots: Array[Int];\\n  // #724 round 2: gc twins of agg_ret_names/agg_ret_infos.\\n  gc_agg_ret_names: Array[String];\\n  gc_agg_ret_infos: Array[Int]\\n}\\n\\n//# Functions\\n\\n// #678: prune the integer-slot log so it carries NO entry for any slot index\\n// >= `floor`. Called right after `local_names` is truncated to `floor` at a\\n// branch / match-arm / for-in boundary, where those high slots are about to be\\n// reused by the sibling scope. A `let`/`let mut` reusing a slot re-logs its own\\n// int-ness, but a NON-`let` binder (match-arm / catch-all / for-in pattern var)\\n// logs nothing — so without this prune its slot would still read the previous\\n// sibling's stale `int=1` and a string bound there would wrongly take the\\n// `i64.eq` path. Compacts the array IN PLACE (entries are unordered, so a plain\\n// truncate-by-count will not do): keep entries for slots < floor, then truncate.\\n// No temporary allocation — this runs at every branch / arm boundary while\\n// compiling, and a fresh array per call piles up on the bump/RC heap during one\\n// big function and can trip a heap-marginal compile.\\nexport fn int_log_reset_above(ctx: CompileCtx, floor: Int) -> Unit {\\n  let arr = ctx.int_local_slots\\n  let n = Array::length(arr)\\n  let mut w = 0\\n  let mut i = 0\\n  while i < n {\\n    let e = Array::get(arr, i)\\n    // #769: entries are slot*4 + kind now (see slot_is_intish).\\n    if e / 4 < floor {\\n      Array::set(arr, w, e)\\n      w = w + 1\\n    } else {\\n      ()\\n    }\\n    i = i + 1\\n  }\\n  Array::truncate(arr, w)\\n}\\n\\n// #724: prune the aggregate-shape log (see CompileCtx.agg_local_slots) at the\\n// same branch/arm boundaries as int_log_reset_above — a slot reused by a\\n// non-`let` binder must not be read as a stale tuple/ctor, or the structural\\n// comparator would walk a non-aggregate value.\\nexport fn agg_log_reset_above(arr: Array[Int], floor: Int) -> Unit {\\n  let n = Array::length(arr)\\n  let mut w = 0\\n  let mut i = 0\\n  while i < n {\\n    let e = Array::get(arr, i)\\n    if e / 256 < floor {\\n      Array::set(arr, w, e)\\n      w = w + 1\\n    } else {\\n      ()\\n    }\\n    i = i + 1\\n  }\\n  Array::truncate(arr, w)\\n}\\n\\n// #672 (post-#724): dual-array twin of agg_log_reset_above — prunes\\n// agg_local_slots AND its parallel agg_local_exprs in lockstep (same\\n// keep/drop decision, driven by the slots array, applied to both), so the\\n// two arrays stay the same length / index-aligned after a branch/arm\\n// boundary prunes stale entries. See CompileCtx.agg_local_exprs.\\nexport fn agg_log_reset_above2(arr: Array[Int], exprs: Array[Expr], floor: Int) -> Unit {\\n  let n = Array::length(arr)\\n  let mut w = 0\\n  let mut i = 0\\n  while i < n {\\n    let e = Array::get(arr, i)\\n    if e / 256 < floor {\\n      Array::set(arr, w, e)\\n      Array::set(exprs, w, Array::get(exprs, i))\\n      w = w + 1\\n    } else {\\n      ()\\n    }\\n    i = i + 1\\n  }\\n  Array::truncate(arr, w)\\n  Array::truncate(exprs, w)\\n}\\n\\n// #724: most-recent aggregate-shape entry for `slot` — `kind*64 + n`\\n// (kind 1 = tuple/arity, 2 = ctor/field count), or -1 when untracked /\\n// overridden by a non-aggregate rebind.\\nexport fn agg_slot_lookup(arr: Array[Int], slot: Int) -> Int {\\n  let mut i = Array::length(arr) - 1\\n  let mut out = 0 - 1\\n  while i >= 0 {\\n    let e = Array::get(arr, i)\\n    if e / 256 == slot {\\n      out = e % 256\\n      i = 0 - 1\\n    } else {\\n      i = i - 1\\n    }\\n  }\\n  if out == 0 {\\n    0 - 1\\n  } else {\\n    out\\n  }\\n}\\n\\n// #672 (post-#724): companion to agg_slot_lookup — the shape-literal Expr\\n// paired with the most-recent tracked entry for `slot` (same rightmost-match\\n// scan), or EInt(0) when the slot has no entry at all. Callers only read the\\n// result after agg_slot_lookup has confirmed a kind 1 (tuple) or kind 2\\n// (ctor/record) entry exists for the slot, so the EInt(0) fallback is never\\n// actually consulted as a shape in practice — it just keeps this total.\\nexport fn agg_expr_lookup(arr: Array[Int], exprs: Array[Expr], slot: Int) -> Expr {\\n  let mut i = Array::length(arr) - 1\\n  let mut out = EInt(0)\\n  while i >= 0 {\\n    let e = Array::get(arr, i)\\n    if e / 256 == slot {\\n      out = Array::get(exprs, i)\\n      i = 0 - 1\\n    } else {\\n      i = i - 1\\n    }\\n  }\\n  out\\n}\\n\\n// #724 round 2: aggregate-shape classification from a DECLARED TypeExpr —\\n// the static dual of the shape log below, used for function RETURN types\\n// (`let a = mk_pt(...)` — the value shape is invisible at the ELet, but the\\n// callee's signature names it) and annotated params. Same `kind*64 + n`\\n// encoding; n = 63 is the \\\"dynamic field count\\\" sentinel: enum-typed values\\n// have a variant-dependent argc, so the comparator reads argc@4 from the\\n// value at runtime instead of unrolling a static count.\\nexport fn agg_info_of_type_name(ct: CtorTable, tname: String) -> Int {\\n  let mut si = 0\\n  let mut out = 0\\n  while si < Array::length(ct.struct_names) {\\n    if Array::get(ct.struct_names, si) == tname {\\n      out = 128 + Array::length(Array::get(ct.struct_field_names, si))\\n      si = Array::length(ct.struct_names)\\n    } else {\\n      si = si + 1\\n    }\\n  }\\n  if out > 0 {\\n    out\\n  } else {\\n    let mut ti = 0\\n    let mut is_enum = false\\n    while ti < Array::length(ct.type_names) {\\n      if Array::get(ct.type_names, ti) == tname {\\n        is_enum = true\\n        ti = Array::length(ct.type_names)\\n      } else {\\n        ti = ti + 1\\n      }\\n    }\\n    if is_enum {\\n      128 + 63\\n    } else {\\n      0\\n    }\\n  }\\n}\\n\\nexport fn agg_info_of_type_expr(ct: CtorTable, te: TypeExpr) -> Int {\\n  match te {\\n    TyTuple(tels) => 64 + Array::length(tels),\\n    TyName(tname) => agg_info_of_type_name(ct, tname),\\n    TyApp(tname, _) => agg_info_of_type_name(ct, tname),\\n    _ => 0\\n  }\\n}\\n\\n// #724 round 2: program-wide (fn name -> aggregate return shape) table,\\n// filled from each top-level `let f: (..) -> R = (..) -> {..}`'s declared\\n// return type (the SLet annotation's TyFn ret, falling back to the EFn's\\n// own return annotation). The `==` codegen consults it for `let a = f(..)`\\n// bindings. Structural, all-lane-safe knowledge — unannotated returns stay\\n// untracked (generic-eq fallback), preserving backend parity.\\nexport fn compute_agg_returning(stmts: Array[Stmt], ct: CtorTable, out_names: Array[String], out_infos: Array[Int]) -> Unit {\\n  let mut i = 0\\n  while i < Array::length(stmts) {\\n    match Array::get(stmts, i) {\\n      SLet(_, _, name, ann, value) => match value {\\n        EFn(_, _, _, fn_ret, _, _) => {\\n          let ret = match ann {\\n            Some(at) => match at {\\n              TyFn(_, r, _) => Some(r),\\n              _ => fn_ret\\n            },\\n            None => fn_ret\\n          }\\n          match ret {\\n            Some(rte) => {\\n              let info = agg_info_of_type_expr(ct, rte)\\n              if info > 0 {\\n                Array::push(out_names, name)\\n                Array::push(out_infos, info)\\n              } else {\\n                ()\\n              }\\n            },\\n            None => ()\\n          }\\n        },\\n        _ => ()\\n      },\\n      _ => ()\\n    }\\n    i = i + 1\\n  }\\n}\\n\\nexport fn agg_ret_lookup(names: Array[String], infos: Array[Int], fname: String) -> Int {\\n  let mut i = 0\\n  let mut out = 0 - 1\\n  while i < Array::length(names) {\\n    if Array::get(names, i) == fname {\\n      out = Array::get(infos, i)\\n      i = Array::length(names)\\n    } else {\\n      i = i + 1\\n    }\\n  }\\n  out\\n}\\n\\n// #724: non-throwing last-match local lookup (resolve_local throws on a\\n// missing name, which is wrong for OPTIONAL classification — a bare ident\\n// can name a global function or ctor instead of a local).\\nexport fn find_local_slot(names: Array[String], name: String) -> Int {\\n  let mut i = Array::length(names) - 1\\n  let mut result = 0 - 1\\n  while i >= 0 {\\n    if Array::get(names, i) == name {\\n      result = i\\n      i = 0 - 1\\n    } else {\\n      i = i - 1\\n    }\\n  }\\n  result\\n}\\n\\n// #724: aggregate-shape info for a bare-ident operand of `==`/`!=`:\\n// resolves the ident's CURRENT slot and returns its latest log entry\\n// (`kind*64 + n`), or -1 for non-idents / untracked slots.\\nexport fn agg_info_of_ident(arr: Array[Int], e: Expr, local_names: Array[String]) -> Int {\\n  match e {\\n    EIdent(nm, _) => {\\n      let slot = find_local_slot(local_names, nm)\\n      if slot >= 0 {\\n        agg_slot_lookup(arr, slot)\\n      } else {\\n        0 - 1\\n      }\\n    },\\n    _ => 0 - 1\\n  }\\n}\\n\\n// #672 (post-#724): companion to agg_info_of_ident — the tracked shape-\\n// literal Expr for a bare-ident operand (same ident -> slot resolution), or\\n// EInt(0) when the ident is not a tracked slot. Callers gate on\\n// agg_info_of_ident's kind first, same discipline as agg_expr_lookup.\\nexport fn agg_expr_of_ident(arr: Array[Int], exprs: Array[Expr], e: Expr, local_names: Array[String]) -> Expr {\\n  match e {\\n    EIdent(nm, _) => {\\n      let slot = find_local_slot(local_names, nm)\\n      if slot >= 0 {\\n        agg_expr_lookup(arr, exprs, slot)\\n      } else {\\n        EInt(0)\\n      }\\n    },\\n    _ => EInt(0)\\n  }\\n}\\n\\nexport fn is_efn(expr: Expr) -> Bool {\\n  match expr {\\n    EFn(_, _, _, _, _, _) => true,\\n    _ => false\\n  }\\n}\\n\\nexport fn is_pint(p: Pat) -> Bool {\\n  match p {\\n    PInt(_) => true,\\n    _ => false\\n  }\\n}\\n\\nexport fn is_pfloat(p: Pat) -> Bool {\\n  match p {\\n    PFloat(_) => true,\\n    _ => false\\n  }\\n}\\n\\nexport fn is_slet(stmt: Stmt) -> Bool {\\n  match stmt {\\n    SLet(_, _, _, _, _) => true,\\n    _ => false\\n  }\\n}\\n\\nexport fn expr_tag(expr: Expr) -> Int {\\n  match expr {\\n    EInt(_) => 0,\\n    EBool(_) => 1,\\n    EFloat(_) => 2,\\n    EString(_) => 3,\\n    EIdent(_, _) => 4,\\n    EBinOp(_, _, _) => 5,\\n    EUnaryOp(_, _) => 6,\\n    EIf(_, _, _) => 7,\\n    ECall(_, _, _) => 8,\\n    ELet(_, _, _, _) => 9,\\n    ELetRec(_, _, _) => 10,\\n    ELetMut(_, _, _, _) => 11,\\n    EAssign(_, _, _) => 12,\\n    EAssignOp(_, _, _, _) => 13,\\n    ESeq(_, _) => 14,\\n    ETuple(_) => 15,\\n    EMatch(_, _) => 16,\\n    EArray(_) => 17,\\n    EForIn(_, _, _, _) => 18,\\n    EWhile(_, _) => 19,\\n    EBreak(_) => 20,\\n    EContinue(_) => 21,\\n    EUnit => 22,\\n    EFn(_, _, _, _, _, _) => 24,\\n    ELoop(_, _) => 25,\\n    EReturn(_) => 26,\\n    _ => -1\\n  }\\n}\\n\\nexport fn is_pbind(p: Pat) -> Bool {\\n  match p {\\n    PBind(_) => true,\\n    _ => false\\n  }\\n}\\n\\nexport fn is_pbool(p: Pat) -> Bool {\\n  match p {\\n    PBool(_) => true,\\n    _ => false\\n  }\\n}\\n\\nexport fn is_pctor(p: Pat) -> Bool {\\n  match p {\\n    PCtor(_, _) => true,\\n    _ => false\\n  }\\n}\\n\\nexport fn is_pwild(p: Pat) -> Bool {\\n  match p {\\n    PWild => true,\\n    _ => false\\n  }\\n}\\n\\nexport fn is_earray(expr: Expr) -> Bool {\\n  match expr {\\n    EArray(_) => true,\\n    _ => false\\n  }\\n}\\n\\nexport fn is_eident(expr: Expr) -> Bool {\\n  match expr {\\n    EIdent(_, _) => true,\\n    _ => false\\n  }\\n}\\n\\nexport fn is_etuple(expr: Expr) -> Bool {\\n  match expr {\\n    ETuple(_) => true,\\n    _ => false\\n  }\\n}\\n\\nexport fn is_ptuple(p: Pat) -> Bool {\\n  match p {\\n    PTuple(_) => true,\\n    _ => false\\n  }\\n}\\n\\nlet op_i32_eq = 70\\n\\nlet op_i32_ne = 71\\n\\nexport fn is_erecord(expr: Expr) -> Bool {\\n  match expr {\\n    ERecord(_, _, _) => true,\\n    _ => false\\n  }\\n}\\n\\nexport fn is_pstring(p: Pat) -> Bool {\\n  match p {\\n    PString(_) => true,\\n    _ => false\\n  }\\n}\\n\\nlet op_i32_eqz = 69\\n\\nlet op_i32_mul = 108\\n\\nlet op_i32_sub = 107\\n\\nexport fn emit_i32_eq(buf: Bytes) -> Unit {\\n  bytebuf_push(buf, op_i32_eq)\\n}\\n\\nexport fn emit_i32_ne(buf: Bytes) -> Unit {\\n  bytebuf_push(buf, op_i32_ne)\\n}\\n\\nexport fn get_arm_pat(arm: (Pat, Expr)) -> Pat {\\n  let (p, _) = arm\\n  p\\n}\\n\\nexport fn lookup_ctor(ctor_names: Array[String], name: String, i: Int) -> Int {\\n  if i >= Array::length(ctor_names) {\\n    -1\\n  }\\n  else if Array::get(ctor_names, i) == name {\\n    i\\n  }\\n  else lookup_ctor(ctor_names, name, i + 1)\\n}\\n\\n// Build CtorTable.names_sorted / names_sorted_pos from the name list: a\\n// stable sort permutation, so equal names keep insertion order and the\\n// leftmost binary-search hit maps to the same index the linear scan found.\\nexport fn ctor_sorted_index(names: Array[String]) -> (Array[String], Array[Int]) {\\n  let perm = sort_perm_by_names(names)\\n  (apply_perm_strings(names, perm), perm)\\n}\\n\\n// O(log N) replacement for `lookup_ctor(ct.names, name, 0)` at CtorTable\\n// call sites. Falls back to the linear scan when the sorted view is absent\\n// (defensive: a table built without ctor_sorted_index stays correct).\\nexport fn ctor_table_index_of(ct: CtorTable, name: String) -> Int {\\n  if Array::length(ct.names_sorted) != Array::length(ct.names) {\\n    lookup_ctor(ct.names, name, 0)\\n  } else {\\n    let slot = bsearch_leftmost(ct.names_sorted, name)\\n    if slot < 0 {\\n      -1\\n    } else {\\n      Array::get(ct.names_sorted_pos, slot)\\n    }\\n  }\\n}\\n\\n// #722: candidates for a NAME-based struct field access. Returns\\n// (ctor_tag, field_idx) for every struct whose field list contains `field`,\\n// in struct-declaration order. Field resolution used to take the FIRST\\n// struct containing the name (type-blind), so a same-named field living at\\n// a DIFFERENT slot in a later struct silently read the wrong slot — which\\n// program shapes hit this depended on the declaration set/order, i.e. the\\n// flat-bundle vs FS-linked lane divergence observed in #722. Callers keep\\n// the first candidate as the static fast path when every candidate agrees\\n// on the slot, and otherwise dispatch at runtime on the value's ctor tag\\n// (struct construction — both the `S::{...}` ctor path and the set-matched\\n// bare-record path — stamps the struct's unique tag at value+0).\\nexport fn struct_field_candidates(ct: CtorTable, field: String) -> Array[(Int, Int)] {\\n  let out = Array::slice([\\n    (0, 0)\\n  ], 0, 0)\\n  let mut si = 0\\n  while si < Array::length(ct.struct_names) {\\n    let fnames = Array::get(ct.struct_field_names, si)\\n    let mut fi = 0\\n    while fi < Array::length(fnames) {\\n      if Array::get(fnames, fi) == field {\\n        let ci = ctor_table_index_of(ct, Array::get(ct.struct_names, si))\\n        let tag = if ci >= 0 {\\n          Array::get(ct.tags, ci)\\n        } else {\\n          -1\\n        }\\n        Array::push(out, (tag, fi))\\n        fi = Array::length(fnames)\\n      } else {\\n        fi = fi + 1\\n      }\\n    }\\n    si = si + 1\\n  }\\n  out\\n}\\n\\n// #722: the subset of `candidates` (beyond the first) whose slot index\\n// DISAGREES with the first candidate's — exactly the cases the static\\n// first-match resolution used to miscompile. Empty result = the static\\n// fast path is sound; non-empty = the caller must emit a runtime tag\\n// dispatch over these, with candidate 0 as the untagged/legacy fallback.\\nexport fn struct_field_dispatch_cases(cands: Array[(Int, Int)]) -> Array[(Int, Int)] {\\n  let (_, idx0) = Array::get(cands, 0)\\n  let out = Array::slice([\\n    (0, 0)\\n  ], 0, 0)\\n  let mut i = 1\\n  while i < Array::length(cands) {\\n    let (tag_i, idx_i) = Array::get(cands, i)\\n    if idx_i != idx0 && tag_i >= 0 {\\n      Array::push(out, (tag_i, idx_i))\\n    } else {\\n      ()\\n    }\\n    i = i + 1\\n  }\\n  out\\n}\\n\\n// #722: resolve a bare record literal to a struct by exact field-name-set\\n// match (the same rule the checker uses — `S::{...}` drops the name at\\n// parse time in some construction paths, and hand-built ASTs build ERecord\\n// directly). Returns the struct index or -1. Callers use it to lay the\\n// record out in the struct's DECLARED field order and stamp the struct's\\n// ctor tag, making bare records byte-compatible with `S::{...}` ctor-path\\n// construction (which already reorders to declared order).\\nexport fn struct_index_by_field_set(ct: CtorTable, lit_names: Array[String]) -> Int {\\n  let mut si = 0\\n  let mut found = -1\\n  while si < Array::length(ct.struct_names) {\\n    let fnames = Array::get(ct.struct_field_names, si)\\n    if Array::length(fnames) == Array::length(lit_names) {\\n      let mut all = true\\n      let mut fi = 0\\n      while fi < Array::length(fnames) {\\n        let dn = Array::get(fnames, fi)\\n        let mut present = false\\n        let mut li = 0\\n        while li < Array::length(lit_names) {\\n          if Array::get(lit_names, li) == dn {\\n            present = true\\n            li = Array::length(lit_names)\\n          } else {\\n            li = li + 1\\n          }\\n        }\\n        if present {\\n          fi = fi + 1\\n        } else {\\n          all = false\\n          fi = Array::length(fnames)\\n        }\\n      }\\n      if all {\\n        found = si\\n        si = Array::length(ct.struct_names)\\n      } else {\\n        si = si + 1\\n      }\\n    } else {\\n      si = si + 1\\n    }\\n  }\\n  found\\n}\\n\\n// #722: ctor tag for struct index `si`, or 0 (the legacy anonymous-record\\n// type id) when the struct is not in the ctor table.\\nexport fn struct_tag_by_index(ct: CtorTable, si: Int) -> Int {\\n  let ci = ctor_table_index_of(ct, Array::get(ct.struct_names, si))\\n  if ci >= 0 {\\n    Array::get(ct.tags, ci)\\n  } else {\\n    0\\n  }\\n}\\n\\nlet op_i32_ge_u = 79\\n\\nlet op_i32_gt_u = 75\\n\\nlet op_i64_load = 41\\n\\nexport fn emit_i32_eqz(buf: Bytes) -> Unit {\\n  bytebuf_push(buf, op_i32_eqz)\\n}\\n\\nexport fn emit_i32_mul(buf: Bytes) -> Unit {\\n  bytebuf_push(buf, op_i32_mul)\\n}\\n\\nexport fn emit_i32_sub(buf: Bytes) -> Unit {\\n  bytebuf_push(buf, op_i32_sub)\\n}\\n\\nexport fn emit_str_ref(buf: Bytes, offset: Int, length: Int) -> Unit {\\n  emit_i64_const(buf, offset)\\n  emit_i64_const(buf, 32)\\n  emit_i64_shl(buf)\\n  emit_i64_const(buf, length)\\n  emit_i64_or(buf)\\n}\\n\\nexport fn get_arm_body(arm: (Pat, Expr)) -> Expr {\\n  let (_, b) = arm\\n  b\\n}\\n\\nexport fn get_efn_body(expr: Expr) -> Expr with { Error } {\\n  match expr {\\n    EFn(_, _, _, _, _, body) => body,\\n    _ => throw(\\\"not EFn\\\")\\n  }\\n}\\n\\nexport fn get_eif_cond(expr: Expr) -> Expr with { Error } {\\n  match expr {\\n    EIf(c, _, _) => c,\\n    _ => throw(\\\"not EIf\\\")\\n  }\\n}\\n\\nexport fn get_eif_else(expr: Expr) -> Expr with { Error } {\\n  match expr {\\n    EIf(_, _, e) => e,\\n    _ => throw(\\\"not EIf\\\")\\n  }\\n}\\n\\nexport fn get_eif_then(expr: Expr) -> Expr with { Error } {\\n  match expr {\\n    EIf(_, t, _) => t,\\n    _ => throw(\\\"not EIf\\\")\\n  }\\n}\\n\\nexport fn get_elet_val(expr: Expr) -> Expr with { Error } {\\n  match expr {\\n    ELet(_, val, _, _) => val,\\n    _ => throw(\\\"not ELet\\\")\\n  }\\n}\\n\\nexport fn is_ctor_call(value: Expr, ct: CtorTable) -> Bool {\\n  match value {\\n    ECall(callee, _, _) => match callee {\\n      EIdent(nm, _) => ctor_table_index_of(ct, nm) >= 0,\\n      _ => false\\n    },\\n    _ => false\\n  }\\n}\\n\\nlet op_i64_store = 55\\n\\nexport fn resolve_func(ft: FuncTable, name: String) -> (Int, Int, Int) with { Error } {\\n  let len = Array::length(ft.names)\\n  let mut i = 0\\n  let mut found = -1\\n  while i < len {\\n    if Array::get(ft.names, i) == name {\\n      found = i\\n      i = len\\n    } else {\\n      i = i + 1\\n    }\\n  }\\n  if found < 0 {\\n    throw(String::concat(\\\"undefined function: \\\", name))\\n  };\\n  (Array::get(ft.indices, found), Array::get(ft.params, found), Array::get(ft.returns, found))\\n}\\n\\nexport fn emit_binop_op(buf: Bytes, op: String) -> Unit with { Error } {\\n  if op == \\\"+\\\" {\\n    emit_i64_add(buf)\\n  }\\n  else if op == \\\"-\\\" {\\n    emit_i64_sub(buf)\\n  }\\n  else if op == \\\"*\\\" {\\n    emit_i64_mul(buf)\\n  }\\n  else if op == \\\"/\\\" {\\n    emit_i64_div_s(buf)\\n  }\\n  else if op == \\\"%\\\" {\\n    emit_i64_rem_s(buf)\\n  }\\n  else if op == \\\"&\\\" {\\n    emit_i64_and(buf)\\n  }\\n  else if op == \\\"|\\\" {\\n    emit_i64_or(buf)\\n  }\\n  else if op == \\\"^\\\" {\\n    emit_i64_xor(buf)\\n  }\\n  else if op == \\\"<<\\\" {\\n    emit_i64_shl(buf)\\n  }\\n  else if op == \\\">>\\\" {\\n    emit_i64_shr_s(buf)\\n  }\\n  else if op == \\\"==\\\" {\\n    emit_i64_eq(buf); emit_i64_extend_i32_s(buf)\\n  }\\n  else if op == \\\"!=\\\" {\\n    emit_i64_ne(buf); emit_i64_extend_i32_s(buf)\\n  }\\n  else if op == \\\"<\\\" {\\n    emit_i64_lt_s(buf); emit_i64_extend_i32_s(buf)\\n  }\\n  else if op == \\\">\\\" {\\n    emit_i64_gt_s(buf); emit_i64_extend_i32_s(buf)\\n  }\\n  else if op == \\\"<=\\\" {\\n    emit_i64_le_s(buf); emit_i64_extend_i32_s(buf)\\n  }\\n  else if op == \\\">=\\\" {\\n    emit_i64_ge_s(buf); emit_i64_extend_i32_s(buf)\\n  }\\n  else if op == \\\"&&\\\" {\\n    emit_i64_and(buf)\\n  }\\n  else if op == \\\"||\\\" {\\n    emit_i64_or(buf)\\n  }\\n  else {\\n    throw(String::concat(\\\"unsupported binop: \\\", op))\\n  }\\n}\\n\\nexport fn emit_i32_ge_u(buf: Bytes) -> Unit {\\n  bytebuf_push(buf, op_i32_ge_u)\\n}\\n\\nexport fn emit_i32_gt_u(buf: Bytes) -> Unit {\\n  bytebuf_push(buf, op_i32_gt_u)\\n}\\n\\nexport fn emit_i64_load(buf: Bytes, align: Int, offset: Int) -> Unit {\\n  bytebuf_push(buf, op_i64_load)\\n  leb128_encode_u32(buf, align)\\n  leb128_encode_u32(buf, offset)\\n}\\n\\nexport fn get_ebinop_op(expr: Expr) -> String with { Error } {\\n  match expr {\\n    EBinOp(op, _, _) => op,\\n    _ => throw(\\\"not EBinOp\\\")\\n  }\\n}\\n\\nexport fn get_elet_body(expr: Expr) -> Expr with { Error } {\\n  match expr {\\n    ELet(_, _, body, _) => body,\\n    _ => throw(\\\"not ELet\\\")\\n  }\\n}\\n\\n// #644: the let-statement's source offset (the `let` keyword token), -1 for\\n// synthesized lets. Break-mode codegen uses it as the dbg_line fallback when\\n// the bound value is a bare literal that carries no offset of its own.\\nexport fn get_elet_off(expr: Expr) -> Int with { Error } {\\n  match expr {\\n    ELet(_, _, _, soff) => soff,\\n    _ => throw(\\\"not ELet\\\")\\n  }\\n}\\n\\nexport fn get_eletmut_off(expr: Expr) -> Int with { Error } {\\n  match expr {\\n    ELetMut(_, _, _, soff) => soff,\\n    _ => throw(\\\"not ELetMut\\\")\\n  }\\n}\\n\\nexport fn get_elet_name(expr: Expr) -> String with { Error } {\\n  match expr {\\n    ELet(name, _, _, _) => name,\\n    _ => throw(\\\"not ELet\\\")\\n  }\\n}\\n\\nexport fn get_func_body(stmt: Stmt) -> Expr with { Error } {\\n  match stmt {\\n    SLet(_, _, _, _, expr) => match expr {\\n      EFn(_, _, _, _, _, body) => body,\\n      _ => throw(\\\"get_func_body: not a function\\\")\\n    },\\n    _ => throw(\\\"get_func_body: not a let statement\\\")\\n  }\\n}\\n\\nexport fn get_slet_expr(stmt: Stmt) -> Expr with { Error } {\\n  match stmt {\\n    SLet(_, _, _, _, expr) => expr,\\n    _ => throw(\\\"not SLet\\\")\\n  }\\n}\\n\\nexport fn get_slet_name(stmt: Stmt) -> String with { Error } {\\n  match stmt {\\n    SLet(_, _, name, _, _) => name,\\n    _ => throw(\\\"not SLet\\\")\\n  }\\n}\\n\\nexport fn get_slet_type(stmt: Stmt) -> Option[TypeExpr] {\\n  match stmt {\\n    SLet(_, _, _, ty, _) => ty,\\n    _ => None\\n  }\\n}\\n\\nexport fn resolve_local(names: Array[String], name: String, tag: String) -> Int with { Error } {\\n  let mut i = Array::length(names) - 1\\n  let mut result = -1\\n  while i >= 0 {\\n    if Array::get(names, i) == name {\\n      result = i\\n      i = -1\\n    } else {\\n      i = i - 1\\n    }\\n  }\\n  if result < 0 {\\n    throw(String::concat(String::concat(\\\"undefined variable (local): \\\", name), String::concat(\\\" @\\\", tag)))\\n  }\\n  result\\n}\\n\\nexport fn emit_i64_store(buf: Bytes, align: Int, offset: Int) -> Unit {\\n  bytebuf_push(buf, op_i64_store)\\n  leb128_encode_u32(buf, align)\\n  leb128_encode_u32(buf, offset)\\n}\\n\\nexport fn emit_box_float(buf: Bytes, ctx: CompileCtx, bits_local: Int, box_local: Int) -> Unit {\\n  emit_local_set(buf, bits_local)\\n  emit_i64_const(buf, 16)\\n  emit_call(buf, ctx.rc_alloc_func_idx)\\n  emit_local_set(buf, box_local)\\n  emit_local_get(buf, box_local)\\n  emit_i32_wrap_i64(buf)\\n  emit_i32_const(buf, 16)\\n  emit_i32_store(buf, 2, 0)\\n  emit_local_get(buf, box_local)\\n  emit_i32_wrap_i64(buf)\\n  emit_i32_const(buf, 1)\\n  emit_i32_store(buf, 2, 4)\\n  emit_local_get(buf, box_local)\\n  emit_i32_wrap_i64(buf)\\n  emit_local_get(buf, bits_local)\\n  emit_i64_store(buf, 3, 8)\\n  emit_local_get(buf, box_local)\\n  emit_i64_const(buf, 8)\\n  emit_i64_add(buf)\\n  emit_i64_const(buf, 1)\\n  emit_i64_or(buf)\\n}\\n\\nexport fn find_func_stmt(stmts: Array[Stmt], name: String) -> Stmt with { Error } {\\n  let len = Array::length(stmts)\\n  let mut i = 0\\n  let mut found = -1\\n  while i < len {\\n    let stmt = Array::get(stmts, i)\\n    match stmt {\\n      SLet(_, _, sname, _, _) => if sname == name {\\n        found = i\\n        i = len\\n      },\\n      _ => ()\\n    }\\n    if found < 0 {\\n      i = i + 1\\n    }\\n  }\\n  if found < 0 {\\n    throw(String::concat(\\\"function not found: \\\", name))\\n  }\\n  Array::get(stmts, found)\\n}\\n\\nexport fn emit_unbox_float(buf: Bytes) -> Unit {\\n  emit_i64_const(buf, -2)\\n  emit_i64_and(buf)\\n  emit_i32_wrap_i64(buf)\\n  emit_i64_load(buf, 3, 0)\\n}\\n\\n// Push the i64 increment that advances an array INDEX counter by ONE LOGICAL\\n// element. Under RC a scalar Int is tagged `n << 1`, and the inline array loops\\n// compare their counter against `Array::length` (which returns a tagged length)\\n// and feed it to `Array::get` (which untags the index). So the counter must\\n// live in tagged space too — stepping by raw 2 (= logical 1). Without RC the\\n// counter is a raw index and steps by 1. Using a raw 1 under RC makes the loop\\n// run twice per element (each read/processed twice; #704).\\nexport fn emit_index_one(buf: Bytes, ctx: CompileCtx) -> Unit {\\n  if ctx.enable_rc {\\n    emit_i64_const(buf, 2)\\n  } else {\\n    emit_i64_const(buf, 1)\\n  }\\n}\\n\\n// Guarded rc_dup of the heap value in `local_idx` (no-op for scalars/strings):\\n// if it is odd (a heap pointer) with a zero high word (not a string fat\\n// pointer), increment its rc_count at block-4. The single canonical copy — the\\n// codegen files (compile_expr_tail / _tail4 / _tail6 / compile_match /\\n// compile_lambda / compile_call / linked_compile) call this instead of keeping\\n// per-file duplicates.\\n// #715 recurrence guard: base address of the shadow-liveness byte table\\n// (1 byte per heap address at base+vptr) and the reservation pad that keeps\\n// it inside linear memory. Only referenced when compiling with rc_shadow.\\nexport fn rc_shadow_base() -> Int {\\n  268435456\\n}\\n\\nexport fn rc_shadow_reserve() -> Int {\\n  536870912\\n}\\n\\n// #720: the rc field is the LOW 24 BITS of the rc word (the class id lives in\\n// the high byte of the same word at vptr-1). A raw `store(load(addr)+1)` at\\n// rc == 0xFFFFFF carries into the class byte and wraps rc to 0 -- a couple of\\n// rc ops later the block frees itself with millions of references still\\n// outstanding. Hot shared structures (func/ctor tables, analysis accumulator\\n// arrays) cross 2^24 refs only on large compiles (the entry-dup budgets leak\\n// by design), which made the corruption look layout- and size-dependent.\\n// Saturate instead: once rc hits 0xFFFFFF the block is immortal (never\\n// incremented, never decremented, never freed -- see gen_rc_drop_body's\\n// matching skip). `push_addr` emits the i32 address of the rc word; it is\\n// invoked up to three times, so it must be a pure push.\\nexport fn emit_rc_word_inc_saturating(buf: Bytes, push_addr: () -> Unit) -> Unit {\\n  push_addr()\\n  emit_i32_load(buf, 2, 0)\\n  emit_i32_const(buf, 16777215)\\n  // i32.and (0x71) -- no emit_i32_and helper exists\\n  bytebuf_push(buf, 113)\\n  emit_i32_const(buf, 16777215)\\n  emit_i32_ne(buf)\\n  emit_if_void(buf)\\n  push_addr()\\n  push_addr()\\n  emit_i32_load(buf, 2, 0)\\n  emit_i32_const(buf, 1)\\n  emit_i32_add(buf)\\n  emit_i32_store(buf, 2, 0)\\n  emit_end(buf)\\n}\\n\\nexport fn emit_rc_dup_guarded(buf: Bytes, local_idx: Int, rc_shadow: Bool) -> Unit {\\n  emit_local_get(buf, local_idx)\\n  emit_i64_const(buf, 1)\\n  emit_i64_and(buf)\\n  emit_i32_wrap_i64(buf)\\n  emit_if_void(buf)\\n  emit_local_get(buf, local_idx)\\n  emit_i64_const(buf, 32)\\n  emit_i64_shr_s(buf)\\n  emit_i64_eqz(buf)\\n  emit_if_void(buf)\\n  // #715 recurrence guard (VIBE_RC=shadow): trap via `unreachable` if the\\n  // shadow byte at RC_SHADOW_BASE+vptr says this block was already freed --\\n  // a dup-of-freed would otherwise increment the free-list NEXT link.\\n  if rc_shadow {\\n    emit_local_get(buf, local_idx)\\n    emit_i64_const(buf, -2)\\n    emit_i64_and(buf)\\n    emit_i32_wrap_i64(buf)\\n    emit_i32_const(buf, rc_shadow_base())\\n    emit_i32_add(buf)\\n    emit_i32_load8_u(buf, 0, 0)\\n    emit_if_void(buf)\\n    bytebuf_push(buf, 0)\\n    emit_end(buf)\\n  } else {\\n    ()\\n  }\\n  emit_rc_word_inc_saturating(buf, () -> {\\n    emit_local_get(buf, local_idx)\\n    emit_i64_const(buf, -2)\\n    emit_i64_and(buf)\\n    emit_i32_wrap_i64(buf)\\n    emit_i32_const(buf, 4)\\n    emit_i32_sub(buf)\\n  })\\n  emit_end(buf)\\n  emit_end(buf)\\n}\\n\\nexport fn fn_type_param_types(ty: Option[TypeExpr]) -> Option[Array[TypeExpr]] {\\n  match ty {\\n    Some(t) =>\\n    match t {\\n      TyFn(args, _, _) => Some(args),\\n      _ => None\\n    },\\n    None => None\\n  }\\n}\\n\\nexport fn is_nullary_ctor_ident(value: Expr, ct: CtorTable) -> Bool {\\n  match value {\\n    EIdent(nm, _) => ctor_table_index_of(ct, nm) >= 0,\\n    _ => false\\n  }\\n}\\n\\nexport fn name_has_effect_prefix(full: String, eff: String) -> Bool {\\n  let el = String::length(eff)\\n  let fl = String::length(full)\\n  if fl < el + 2 {\\n    false\\n  } else {\\n    let mut ok = true\\n    let mut j = 0\\n    while j < el {\\n      if String::char_code_at(full, j) != String::char_code_at(eff, j) {\\n        ok = false\\n        j = el\\n      } else {\\n        j = j + 1\\n      }\\n    }\\n    ok && String::char_code_at(full, el) == 58 && String::char_code_at(full, el + 1) == 58\\n  }\\n}\\n\\nexport fn effect_name_to_tag(effect_names: Array[String], full: String) -> Int {\\n  let n = Array::length(effect_names)\\n  let mut result = 3 + n\\n  let mut i = 0\\n  while i < n {\\n    if name_has_effect_prefix(full, Array::get(effect_names, i)) {\\n      result = 3 + i\\n      i = n\\n    } else {\\n      i = i + 1\\n    }\\n  }\\n  result\\n}\\n\\nexport fn effect_op_declared_arity(keys: Array[String], arities: Array[Int], full: String) -> Int {\\n  let n = Array::length(keys)\\n  let mut result = -1\\n  let mut i = 0\\n  while i < n {\\n    if Array::get(keys, i) == full {\\n      result = Array::get(arities, i)\\n      i = n\\n    } else {\\n      i = i + 1\\n    }\\n  }\\n  result\\n}\\n\\n// #665: index of a qualified op key (`Eff::Op`) in the global effect_op_keys\\n// table — the operation discriminant for multi-operation handler dispatch.\\nexport fn effect_op_index(keys: Array[String], full: String) -> Int {\\n  let n = Array::length(keys)\\n  let mut result = 0 - 1\\n  let mut i = 0\\n  while i < n {\\n    if Array::get(keys, i) == full {\\n      result = i\\n      i = n\\n    } else {\\n      i = i + 1\\n    }\\n  }\\n  result\\n}\\n\\nexport fn emit_heap_grow_after_heap_set(buf: Bytes, ctx: CompileCtx) -> Unit {\\n  if ctx.heap_grow_check_func_idx >= 0 {\\n    emit_call(buf, ctx.heap_grow_check_func_idx)\\n  } else {\\n    ()\\n  }\\n}\\n\")\n}\n\nlet cli_adapter_source_66 = () -> (String, String) {\n  (\"lib/@vibe/compiler/codegen/common_extractors/index.vibe\",\n\"//# Imports\\n\\nimport ../../core/index.vibe {\\n  Expr, Pat, Stmt, TypeExpr,\\n  bytebuf_push, leb128_encode_u32\\n}\\n\\nimport ../wasm_emit/index.vibe {\\n  emit_i64_add, emit_i64_div_s, emit_i64_mul, emit_i64_rem_s, emit_i64_sub\\n}\\n\\nlet op_prefix = 252\\n\\n//# Functions\\n\\n// Interior-line breakpoints (span-arc step5): return the first available source\\n// char-offset for `e`, walking into the most-representative child until an\\n// offset-carrying node is found, or -1 if none. EIdent/ECall/EDot carry real\\n// char-offsets; for ECall/EDot prefer the node's own offset, else recurse into\\n// the callee/base. A statement's offset is thus derived from its VALUE\\n// subexpression. Flat single match, tail-recursive into one child per arm.\\nexport fn first_offset(e: Expr) -> Int {\\n  match e {\\n    EIdent(_, off) => off,\\n    ECall(callee, _, off) => if off >= 0 { off } else { first_offset(callee) },\\n    EDot(base, _, off, _) => if off >= 0 { off } else { first_offset(base) },\\n    EBinOp(_, lhs, _) => first_offset(lhs),\\n    EUnaryOp(_, inner) => first_offset(inner),\\n    ELet(_, val, _, _) => first_offset(val),\\n    ELetRec(_, val, _) => first_offset(val),\\n    ELetMut(_, val, _, _) => first_offset(val),\\n    EAssign(_, val, _) => first_offset(val),\\n    EAssignOp(_, _, val, _) => first_offset(val),\\n    ESeq(first, _) => first_offset(first),\\n    EIf(cond, _, _) => first_offset(cond),\\n    EMatch(scrut, _) => first_offset(scrut),\\n    EReturn(inner) => first_offset(inner),\\n    _ => -1\\n  }\\n}\\n\\n// Interior-line breakpoints: convert a 0-based source char-offset to a 1-based\\n// line number using a sorted array of newline char-offsets: line = 1 + (count of\\n// newline offsets strictly less than `off`). Linear scan (programs are small).\\nexport fn offset_to_line(nl: Array[Int], off: Int) -> Int {\\n  let n = Array::length(nl)\\n  let mut i = 0\\n  let mut count = 0\\n  while i < n {\\n    if Array::get(nl, i) < off {\\n      count = count + 1\\n    } else {\\n      ()\\n    }\\n    i = i + 1\\n  }\\n  count + 1\\n}\\n\\n// Interior-line breakpoints: build a sorted array of the char-offsets of each\\n// '\\\\n' in `src`. Empty when `src` is empty.\\nexport fn build_newline_offsets(src: String) -> Array[Int] {\\n  let arr = Array::slice([\\n    0\\n  ], 0, 0)\\n  let n = String::length(src)\\n  let mut i = 0\\n  while i < n {\\n    if String::char_code_at(src, i) == 10 {\\n      Array::push(arr, i)\\n    } else {\\n      ()\\n    }\\n    i = i + 1\\n  }\\n  arr\\n}\\n\\nexport fn get_ebinop_lhs(expr: Expr) -> Expr with { Error } {\\n  match expr {\\n    EBinOp(_, lhs, _) => lhs,\\n    _ => throw(\\\"not EBinOp\\\")\\n  }\\n}\\n\\nexport fn get_ebinop_rhs(expr: Expr) -> Expr with { Error } {\\n  match expr {\\n    EBinOp(_, _, rhs) => rhs,\\n    _ => throw(\\\"not EBinOp\\\")\\n  }\\n}\\n\\nexport fn get_ecall_args(expr: Expr) -> Array[Expr] with { Error } {\\n  match expr {\\n    ECall(_, args, _) => args,\\n    _ => throw(\\\"not ECall\\\")\\n  }\\n}\\n\\nexport fn get_efn_params(expr: Expr) -> Array[(String, Option[TypeExpr])] with { Error } {\\n  match expr {\\n    EFn(_, _, params, _, _, _) => params,\\n    _ => throw(\\\"not EFn\\\")\\n  }\\n}\\n\\nexport fn get_eint_value(expr: Expr) -> Int with { Error } {\\n  match expr {\\n    EInt(n) => n,\\n    _ => throw(\\\"not EInt\\\")\\n  }\\n}\\n\\nexport fn get_eseq_first(expr: Expr) -> Expr with { Error } {\\n  match expr {\\n    ESeq(first, _) => first,\\n    _ => throw(\\\"not ESeq\\\")\\n  }\\n}\\n\\n// Extract arms from EMatch (non-recursive to avoid stale binding bug in let rec)\\nexport fn get_match_arms(expr: Expr) -> Array[(Pat, Expr)] with { Error } {\\n  match expr {\\n    EMatch(_, arms) => arms,\\n    _ => throw(\\\"get_match_arms: not an EMatch\\\")\\n  }\\n}\\n\\n// Extract name from PBind\\nexport fn get_pbind_name(p: Pat) -> String with { Error } {\\n  match p {\\n    PBind(name) => name,\\n    _ => throw(\\\"get_pbind_name: not a PBind\\\")\\n  }\\n}\\n\\nexport fn get_pctor_args(p: Pat) -> Array[Pat] with { Error } {\\n  match p {\\n    PCtor(_, args) => args,\\n    _ => throw(\\\"get_pctor_args: not a PCtor\\\")\\n  }\\n}\\n\\n// Extract PCtor name and args\\nexport fn get_pctor_name(p: Pat) -> String with { Error } {\\n  match p {\\n    PCtor(name, _) => name,\\n    _ => throw(\\\"get_pctor_name: not a PCtor\\\")\\n  }\\n}\\n\\n// Extract PInt value\\nexport fn get_pint_value(p: Pat) -> Int with { Error } {\\n  match p {\\n    PInt(n) => n,\\n    _ => throw(\\\"get_pint_value: not a PInt\\\")\\n  }\\n}\\n\\nexport fn get_pfloat_value(p: Pat) -> Double with { Error } {\\n  match p {\\n    PFloat(v) => v,\\n    _ => throw(\\\"get_pfloat_value: not a PFloat\\\")\\n  }\\n}\\n\\nexport fn get_eassign_val(expr: Expr) -> Expr with { Error } {\\n  match expr {\\n    EAssign(_, val, _) => val,\\n    _ => throw(\\\"not EAssign\\\")\\n  }\\n}\\n\\nexport fn get_ebool_value(expr: Expr) -> Bool with { Error } {\\n  match expr {\\n    EBool(b) => b,\\n    _ => throw(\\\"not EBool\\\")\\n  }\\n}\\n\\nexport fn get_eforin_body(expr: Expr) -> Expr with { Error } {\\n  match expr {\\n    EForIn(_, _, _, body) => body,\\n    _ => throw(\\\"not EForIn\\\")\\n  }\\n}\\n\\nexport fn get_eforin_iter(expr: Expr) -> Expr with { Error } {\\n  match expr {\\n    EForIn(_, _, iter, _) => iter,\\n    _ => throw(\\\"not EForIn\\\")\\n  }\\n}\\n\\nexport fn get_eforin_name(expr: Expr) -> String with { Error } {\\n  match expr {\\n    EForIn(name, _, _, _) => name,\\n    _ => throw(\\\"not EForIn\\\")\\n  }\\n}\\n\\nexport fn get_eforin_index(expr: Expr) -> Option[String] with { Error } {\\n  match expr {\\n    EForIn(_, index_name, _, _) => index_name,\\n    _ => throw(\\\"not EForIn\\\")\\n  }\\n}\\n\\nexport fn get_eident_name(expr: Expr) -> String with { Error } {\\n  match expr {\\n    EIdent(name, _) => name,\\n    _ => throw(\\\"not EIdent\\\")\\n  }\\n}\\n\\nexport fn get_eletmut_val(expr: Expr) -> Expr with { Error } {\\n  match expr {\\n    ELetMut(_, val, _, _) => val,\\n    _ => throw(\\\"not ELetMut\\\")\\n  }\\n}\\n\\nexport fn get_eletrec_val(expr: Expr) -> Expr with { Error } {\\n  match expr {\\n    ELetRec(_, val, _) => val,\\n    _ => throw(\\\"not ELetRec\\\")\\n  }\\n}\\n\\nexport fn get_eseq_second(expr: Expr) -> Expr with { Error } {\\n  match expr {\\n    ESeq(_, second) => second,\\n    _ => throw(\\\"not ESeq\\\")\\n  }\\n}\\n\\nexport fn get_ereturn_expr(expr: Expr) -> Expr with { Error } {\\n  match expr {\\n    EReturn(e) => e,\\n    _ => throw(\\\"not EReturn\\\")\\n  }\\n}\\n\\nexport fn get_eunaryop_op(expr: Expr) -> String with { Error } {\\n  match expr {\\n    EUnaryOp(op, _) => op,\\n    _ => throw(\\\"not EUnaryOp\\\")\\n  }\\n}\\n\\nexport fn get_ewhile_body(expr: Expr) -> Expr with { Error } {\\n  match expr {\\n    EWhile(_, body) => body,\\n    _ => throw(\\\"not EWhile\\\")\\n  }\\n}\\n\\nexport fn get_ewhile_cond(expr: Expr) -> Expr with { Error } {\\n  match expr {\\n    EWhile(cond, _) => cond,\\n    _ => throw(\\\"not EWhile\\\")\\n  }\\n}\\n\\n// Extract PBool value\\nexport fn get_pbool_value(p: Pat) -> Bool with { Error } {\\n  match p {\\n    PBool(v) => v,\\n    _ => throw(\\\"get_pbool_value: not a PBool\\\")\\n  }\\n}\\n\\n// Extract sub-patterns from PTuple\\nexport fn get_ptuple_pats(p: Pat) -> Array[Pat] with { Error } {\\n  match p {\\n    PTuple(pats) => pats,\\n    _ => throw(\\\"get_ptuple_pats: not a PTuple\\\")\\n  }\\n}\\n\\nexport fn get_slet_export(stmt: Stmt) -> Bool with { Error } {\\n  match stmt {\\n    SLet(is_export, _, _, _, _) => is_export,\\n    _ => throw(\\\"not SLet\\\")\\n  }\\n}\\n\\n// Check if a pattern is unconditionally matching (catch-all)\\nexport fn is_catchall_pat(p: Pat) -> Bool {\\n  match p {\\n    PWild => true,\\n    PBind(_) => true,\\n    PTuple(pats) => {\\n      // PTuple is catch-all only if ALL sub-patterns are catch-all\\n      let mut i = 0\\n      let mut all_catch = true\\n      while i < Array::length(pats) {\\n        if !is_catchall_pat(Array::get(pats, i)) {\\n          all_catch = false\\n        }\\n        i = i + 1\\n      }\\n      all_catch\\n    },\\n    PStruct(_, fields) => {\\n      // A struct pattern is irrefutable (catch-all) exactly when every field\\n      // sub-pattern is — a struct has a single shape, so the only thing that can\\n      // make it refutable is a literal field sub-pattern. (`S::{ x, y }` binds;\\n      // `S::{ x: 5 }` is refutable and needs a discriminating test instead.)\\n      let mut i = 0\\n      let mut all_catch = true\\n      while i < Array::length(fields) {\\n        let (_, sp) = Array::get(fields, i)\\n        if !is_catchall_pat(sp) {\\n          all_catch = false\\n        }\\n        i = i + 1\\n      }\\n      all_catch\\n    },\\n    _ => false\\n  }\\n}\\n\\n// Emit WASM instruction for an assign operator (+=, -=, etc.)\\nexport fn emit_assignop_op(buf: Bytes, op: String) -> Unit with { Error } {\\n  if op == \\\"+\\\" {\\n    emit_i64_add(buf)\\n  }\\n  else if op == \\\"-\\\" {\\n    emit_i64_sub(buf)\\n  }\\n  else if op == \\\"*\\\" {\\n    emit_i64_mul(buf)\\n  }\\n  else if op == \\\"/\\\" {\\n    emit_i64_div_s(buf)\\n  }\\n  else if op == \\\"%\\\" {\\n    emit_i64_rem_s(buf)\\n  }\\n  else {\\n    throw(String::concat(\\\"unsupported assign op: \\\", op))\\n  }\\n}\\n\\nexport fn emit_memory_copy(buf: Bytes) -> Unit {\\n  bytebuf_push(buf, op_prefix)\\n  leb128_encode_u32(buf, 10)\\n  bytebuf_push(buf, 0)\\n  bytebuf_push(buf, 0)\\n}\\n\\nexport fn get_earray_elems(expr: Expr) -> Array[Expr] with { Error } {\\n  match expr {\\n    EArray(elems) => elems,\\n    _ => throw(\\\"not EArray\\\")\\n  }\\n}\\n\\nexport fn get_eassign_body(expr: Expr) -> Expr with { Error } {\\n  match expr {\\n    EAssign(_, _, body) => body,\\n    _ => throw(\\\"not EAssign\\\")\\n  }\\n}\\n\\nexport fn get_eassign_name(expr: Expr) -> String with { Error } {\\n  match expr {\\n    EAssign(name, _, _) => name,\\n    _ => throw(\\\"not EAssign\\\")\\n  }\\n}\\n\\nexport fn get_eassignop_op(expr: Expr) -> String with { Error } {\\n  match expr {\\n    EAssignOp(_, op, _, _) => op,\\n    _ => throw(\\\"not EAssignOp\\\")\\n  }\\n}\\n\\nexport fn get_ecall_callee(expr: Expr) -> Expr with { Error } {\\n  match expr {\\n    ECall(callee, _, _) => callee,\\n    _ => throw(\\\"not ECall\\\")\\n  }\\n}\\n\\nexport fn get_efloat_value(expr: Expr) -> Double with { Error } {\\n  match expr {\\n    EFloat(v) => v,\\n    _ => throw(\\\"not EFloat\\\")\\n  }\\n}\\n\\nexport fn get_eletmut_body(expr: Expr) -> Expr with { Error } {\\n  match expr {\\n    ELetMut(_, _, body, _) => body,\\n    _ => throw(\\\"not ELetMut\\\")\\n  }\\n}\\n\\nexport fn get_eletmut_name(expr: Expr) -> String with { Error } {\\n  match expr {\\n    ELetMut(name, _, _, _) => name,\\n    _ => throw(\\\"not ELetMut\\\")\\n  }\\n}\\n\\nexport fn get_eletrec_body(expr: Expr) -> Expr with { Error } {\\n  match expr {\\n    ELetRec(_, _, body) => body,\\n    _ => throw(\\\"not ELetRec\\\")\\n  }\\n}\\n\\nexport fn get_eletrec_name(expr: Expr) -> String with { Error } {\\n  match expr {\\n    ELetRec(name, _, _) => name,\\n    _ => throw(\\\"not ELetRec\\\")\\n  }\\n}\\n\\n// Extract elements from ETuple\\nexport fn get_etuple_elems(expr: Expr) -> Array[Expr] with { Error } {\\n  match expr {\\n    ETuple(elems) => elems,\\n    _ => throw(\\\"get_etuple_elems: not an ETuple\\\")\\n  }\\n}\\n\\nexport fn str_table_lookup(strs: Array[String], s: String) -> Int with { Error } {\\n  let len = Array::length(strs)\\n  let mut i = 0\\n  let mut found = -1\\n  while i < len {\\n    if Array::get(strs, i) == s {\\n      found = i\\n      i = len\\n    } else {\\n      i = i + 1\\n    }\\n  }\\n  if found < 0 {\\n    throw(String::concat(\\\"string not in table: \\\", s))\\n  }\\n  found\\n}\\n\\n// Find the index of the first catch-all pattern in match arms\\n// Returns num_arms if no catch-all found\\nexport fn find_catchall_idx(arms: Array[(Pat, Expr)]) -> Int {\\n  let num = Array::length(arms)\\n  let mut idx = 0\\n  let mut result = num\\n  while idx < num {\\n    let (p, _) = Array::get(arms, idx)\\n    if is_catchall_pat(p) {\\n      result = idx\\n      idx = num\\n    } else {\\n      idx = idx + 1\\n    }\\n  }\\n  result\\n}\\n\\nexport fn get_eassignop_val(expr: Expr) -> Expr with { Error } {\\n  match expr {\\n    EAssignOp(_, _, val, _) => val,\\n    _ => throw(\\\"not EAssignOp\\\")\\n  }\\n}\\n\\nexport fn get_estring_value(expr: Expr) -> String with { Error } {\\n  match expr {\\n    EString(s) => s,\\n    _ => throw(\\\"not EString\\\")\\n  }\\n}\\n\\nexport fn get_eunaryop_expr(expr: Expr) -> Expr with { Error } {\\n  match expr {\\n    EUnaryOp(_, e) => e,\\n    _ => throw(\\\"not EUnaryOp\\\")\\n  }\\n}\\n\\n// Extract PString value\\nexport fn get_pstring_value(p: Pat) -> String with { Error } {\\n  match p {\\n    PString(s) => s,\\n    _ => throw(\\\"get_pstring_value: not a PString\\\")\\n  }\\n}\\n\\nexport fn array_contains_str(arr: Array[String], s: String) -> Bool {\\n  let len = Array::length(arr)\\n  let mut i = 0\\n  let mut found = false\\n  while i < len {\\n    if Array::get(arr, i) == s {\\n      found = true\\n      i = len\\n    } else {\\n      i = i + 1\\n    }\\n  }\\n  found\\n}\\n\\nexport fn get_eassignop_body(expr: Expr) -> Expr with { Error } {\\n  match expr {\\n    EAssignOp(_, _, _, body) => body,\\n    _ => throw(\\\"not EAssignOp\\\")\\n  }\\n}\\n\\nexport fn get_eassignop_name(expr: Expr) -> String with { Error } {\\n  match expr {\\n    EAssignOp(name, _, _, _) => name,\\n    _ => throw(\\\"not EAssignOp\\\")\\n  }\\n}\\n\\n// Extract scrutinee from EMatch (non-recursive to avoid stale binding bug in let rec)\\nexport fn get_match_scrutinee(expr: Expr) -> Expr with { Error } {\\n  match expr {\\n    EMatch(scrutinee, _) => scrutinee,\\n    _ => throw(\\\"get_match_scrutinee: not an EMatch\\\")\\n  }\\n}\\n\")\n}\n\nlet cli_adapter_source_67 = () -> (String, String) {\n  (\"lib/@vibe/compiler/codegen/common_analysis/index.vibe\",\n\"//# Imports\\n\\nimport ../../core/index.vibe {\\n  Expr, Pat, Stmt, TypeExpr,\\n  bytebuf_push,\\n  bsearch_leftmost, sorted_names_of\\n}\\n\\nimport ../common_extractors/index.vibe {\\n  array_contains_str\\n}\\n\\nimport ../wasm_emit/index.vibe {\\n  emit_call_indirect, emit_else, emit_end, emit_i32_load, emit_i32_wrap_i64, emit_i64_and, emit_i64_const, emit_i64_eq, emit_i64_or, emit_i64_shl, emit_i64_shr_s, emit_if_void, emit_local_get, emit_local_set\\n}\\n\\nlet op_i64_extend_i32_u = 173\\n\\n//# Functions\\n\\nfn common_analysis_fresh_string_array() -> Array[String] {\\n  ArrayBuilder::freeze(ArrayBuilder::new())\\n}\\n\\n// Collect string literals appearing anywhere in a pattern, including inside\\n// constructor / tuple / or / struct sub-patterns. #603: codegen now tests a\\n// `PString` sub-pattern of a `PCtor`, so its literal must be registered in the\\n// string table (previously only top-level `PString` arms were collected).\\nfn collect_strings_pat(pat: Pat, out: Array[String]) -> Int {\\n  match pat {\\n    PString(s) => {\\n      let mut pf = false\\n      let mut pi = 0\\n      while pi < Array::length(out) {\\n        if Array::get(out, pi) == s {\\n          pf = true\\n        }\\n        pi = pi + 1\\n      }\\n      if !pf {\\n        Array::push(out, s)\\n      }\\n      0\\n    },\\n    PCtor(_, args) => {\\n      let mut i = 0\\n      while i < Array::length(args) {\\n        let _ = collect_strings_pat(Array::get(args, i), out)\\n        i = i + 1\\n      }\\n      0\\n    },\\n    PTuple(pats) => {\\n      let mut i = 0\\n      while i < Array::length(pats) {\\n        let _ = collect_strings_pat(Array::get(pats, i), out)\\n        i = i + 1\\n      }\\n      0\\n    },\\n    POr(l, r) => {\\n      let _ = collect_strings_pat(l, out)\\n      let _ = collect_strings_pat(r, out)\\n      0\\n    },\\n    PStruct(_, fields) => {\\n      let mut i = 0\\n      while i < Array::length(fields) {\\n        let (_, fp) = Array::get(fields, i)\\n        let _ = collect_strings_pat(fp, out)\\n        i = i + 1\\n      }\\n      0\\n    },\\n    _ => 0\\n  }\\n}\\n\\nexport fn collect_strings_expr(expr: Expr, out: Array[String]) -> Int {\\n  match expr {\\n    EString(s) => {\\n      let mut found = false\\n      let mut i = 0\\n      while i < Array::length(out) {\\n        if Array::get(out, i) == s {\\n          found = true\\n        }\\n        i = i + 1\\n      }\\n      if !found {\\n        Array::push(out, s)\\n      }\\n      0\\n    },\\n    EBinOp(_, lhs, rhs) => {\\n      collect_strings_expr(lhs, out)\\n      collect_strings_expr(rhs, out)\\n    },\\n    EUnaryOp(_, operand) => collect_strings_expr(operand, out),\\n    EIf(cond, then_e, else_e) => {\\n      collect_strings_expr(cond, out)\\n      collect_strings_expr(then_e, out)\\n      collect_strings_expr(else_e, out)\\n    },\\n    ECall(callee, args, _) => {\\n      collect_strings_expr(callee, out)\\n      // #784: the bool→string codegen path (compile_call.vibe) synthesizes\\n      // `if b { \\\"true\\\" } else { \\\"false\\\" }` for a statically-boolean `__to_string`\\n      // arg. Those EString nodes are created during codegen — AFTER this\\n      // collection pass — so their literals are otherwise absent from the string\\n      // table (`string not in table: true`, Codex #785 review, P1). Seed them\\n      // whenever `__to_string` is called. Over-approximates (also seeds for a\\n      // purely-integer `__to_string`), which is harmless: two small interned\\n      // strings.\\n      match callee {\\n        EIdent(nm, _) => if nm == \\\"__to_string\\\" {\\n          collect_strings_expr(EString(\\\"true\\\"), out)\\n          collect_strings_expr(EString(\\\"false\\\"), out)\\n        } else {\\n          0\\n        },\\n        _ => 0\\n      }\\n      let mut i = 0\\n      while i < Array::length(args) {\\n        collect_strings_expr(Array::get(args, i), out)\\n        i = i + 1\\n      }\\n      0\\n    },\\n    ELet(_, value, body, _) => {\\n      collect_strings_expr(value, out)\\n      collect_strings_expr(body, out)\\n    },\\n    ELetRec(_, value, body) => {\\n      collect_strings_expr(value, out)\\n      collect_strings_expr(body, out)\\n    },\\n    ELetMut(_, value, body, _) => {\\n      collect_strings_expr(value, out)\\n      collect_strings_expr(body, out)\\n    },\\n    EAssign(_, value, body) => {\\n      collect_strings_expr(value, out)\\n      collect_strings_expr(body, out)\\n    },\\n    EAssignOp(_, _, value, body) => {\\n      collect_strings_expr(value, out)\\n      collect_strings_expr(body, out)\\n    },\\n    ESeq(first, second) => {\\n      collect_strings_expr(first, out)\\n      collect_strings_expr(second, out)\\n    },\\n    EWhile(cond, body) => {\\n      collect_strings_expr(cond, out)\\n      collect_strings_expr(body, out)\\n    },\\n    EForIn(_, _, iter_e, body) => {\\n      collect_strings_expr(iter_e, out)\\n      collect_strings_expr(body, out)\\n    },\\n    ETuple(elems) => {\\n      let mut i = 0\\n      while i < Array::length(elems) {\\n        collect_strings_expr(Array::get(elems, i), out)\\n        i = i + 1\\n      }\\n      0\\n    },\\n    EArray(elems) => {\\n      let mut i = 0\\n      while i < Array::length(elems) {\\n        collect_strings_expr(Array::get(elems, i), out)\\n        i = i + 1\\n      }\\n      0\\n    },\\n    EMatch(scrutinee, arms) => {\\n      collect_strings_expr(scrutinee, out)\\n      let mut i = 0\\n      while i < Array::length(arms) {\\n        let (pat, arm_expr) = Array::get(arms, i)\\n        let _ = collect_strings_pat(pat, out)\\n        collect_strings_expr(arm_expr, out)\\n        i = i + 1\\n      }\\n      0\\n    },\\n    EFn(_, _, _, _, _, body) => collect_strings_expr(body, out),\\n    EReturn(msg) => collect_strings_expr(msg, out),\\n    EStringInterp(parts) => {\\n      let mut si_p = 0\\n      while si_p < Array::length(parts) {\\n        if si_p % 2 == 0 {\\n          let part = Array::get(parts, si_p)\\n          if String::length(part) > 0 {\\n            let mut found = false\\n            let mut fi2 = 0\\n            while fi2 < Array::length(out) {\\n              if Array::get(out, fi2) == part { found = true }\\n              fi2 = fi2 + 1\\n            }\\n            if !found { Array::push(out, part) }\\n          }\\n        }\\n        si_p = si_p + 1\\n      }\\n      0\\n    },\\n    EHandle(body, arms) => {\\n      collect_strings_expr(body, out)\\n      let mut hi = 0\\n      while hi < Array::length(arms) {\\n        let (_, arm_expr) = Array::get(arms, hi)\\n        collect_strings_expr(arm_expr, out)\\n        hi = hi + 1\\n      }\\n      0\\n    },\\n    EMap(fields) => {\\n      let mut mi = 0\\n      while mi < Array::length(fields) {\\n        let (key, val) = Array::get(fields, mi)\\n        let mut kf = false\\n        let mut ki = 0\\n        while ki < Array::length(out) {\\n          if Array::get(out, ki) == key { kf = true }\\n          ki = ki + 1\\n        }\\n        if !kf { Array::push(out, key) }\\n        collect_strings_expr(val, out)\\n        mi = mi + 1\\n      }\\n      0\\n    },\\n    ERecord(_, fields, _) => {\\n      let mut ri = 0\\n      while ri < Array::length(fields) {\\n        let (_, fval) = Array::get(fields, ri)\\n        collect_strings_expr(fval, out)\\n        ri = ri + 1\\n      }\\n      0\\n    },\\n    EDot(obj, _, _, _) => collect_strings_expr(obj, out),\\n    ELabeledArg(_, _, val) => collect_strings_expr(val, out),\\n    _ => 0\\n  }\\n}\\n\\n// Extract function param names from SLet(_, _, _, _, EFn(_, _, params, _, _, _))\\nexport fn get_func_param_names(stmt: Stmt) -> Array[String] with { Error } {\\n  match stmt {\\n    SLet(_, _, _, _, expr) => match expr {\\n      EFn(_, _, params, _, _, _) => {\\n        let names = common_analysis_fresh_string_array()\\n        let mut i = 0\\n        while i < Array::length(params) {\\n          let (pname, _) = Array::get(params, i)\\n          // Strip labeled/optional markers from param names\\n          let plen2 = String::length(pname)\\n          let clean_name = if plen2 > 0 {\\n            let last_char = String::char_code_at(pname, plen2 - 1)\\n            if last_char == '~' || last_char == '?' {\\n              pname[0:plen2 - 1]\\n            } else pname\\n          } else pname\\n          Array::push(names, clean_name)\\n          i = i + 1\\n        }\\n        names\\n      },\\n      _ => throw(\\\"get_func_param_names: not a function\\\")\\n    },\\n    _ => throw(\\\"get_func_param_names: not a let statement\\\")\\n  }\\n}\\n\\n// #721: does the program reference the exception machinery anywhere? EThrow\\n// compiles to `throw 2`, EHandle to try_table over tags 0-3, and effect op\\n// performs to `throw <eff_tag>` (guarded separately by the effect declaration\\n// list). When NONE of these appear, the tag section and the \\\"error\\\" tag\\n// export can be omitted entirely -- V8 runs exnref-bearing modules on a\\n// slower path, costing pure-compute code ~35% (fib(38): 0.32s with tags vs\\n// 0.20s without; wasmtime shows parity, so it is engine behavior, not\\n// codegen). Conservative: any EThrow/EHandle at ANY nesting depth counts.\\nexport fn expr_contains_exceptions(expr: Expr) -> Bool {\\n  match expr {\\n    EHandle(_, _) => true,\\n    EBinOp(_, lhs, rhs) => expr_contains_exceptions(lhs) || expr_contains_exceptions(rhs),\\n    EUnaryOp(_, operand) => expr_contains_exceptions(operand),\\n    EIf(cond, then_e, else_e) =>\\n    expr_contains_exceptions(cond) || expr_contains_exceptions(then_e) || expr_contains_exceptions(else_e),\\n    ECall(callee, args, _) => {\\n      // A bare `resume(..)` call compiles to `throw 1` (continuation resume)\\n      // even without a surrounding EHandle in this expression -- a resume\\n      // misused outside a handler must still produce a VALID module. A user\\n      // function actually named `resume` merely keeps the tags (harmless\\n      // over-approximation).\\n      //\\n      // #774: `perform Eff::Op(..)` compiles to `throw <eff_tag>`\\n      // (compile_call.vibe) EVEN WHEN the enclosing file declares no\\n      // `effect Eff { .. }` of its own (e.g. lib/@vibe/http/http.vibe /\\n      // lib/@vibe/socket/tcp.vibe perform `Http::*`/`Socket::*` ops whose\\n      // names never appear as an `SEffectDef` in the compiled unit) --\\n      // `effect_name_to_tag` falls back to a sentinel tag index in that\\n      // case. Missing \\\"perform\\\" here (like \\\"resume\\\") made `uses_exceptions`\\n      // false whenever a compiled unit's ONLY exception-shaped construct was\\n      // an un-declared-effect `perform` with no `handle`/`throw` anywhere\\n      // else, so the tag section was omitted -- and the emitted `throw\\n      // <eff_tag>` then referenced a tag index that plain does not exist,\\n      // failing wasm validation (\\\"Invalid tag index: N\\\") the moment the\\n      // function's body is compiled, whether or not it is ever called.\\n      let mut found = match callee {\\n        EIdent(cname, _) => cname == \\\"resume\\\" || cname == \\\"perform\\\",\\n        _ => expr_contains_exceptions(callee)\\n      }\\n      let mut i = 0\\n      while i < Array::length(args) {\\n        if expr_contains_exceptions(Array::get(args, i)) {\\n          found = true\\n        } else {\\n          ()\\n        }\\n        i = i + 1\\n      }\\n      found\\n    },\\n    ELet(_, value, body, _) => expr_contains_exceptions(value) || expr_contains_exceptions(body),\\n    ELetRec(_, value, body) => expr_contains_exceptions(value) || expr_contains_exceptions(body),\\n    ELetMut(_, value, body, _) => expr_contains_exceptions(value) || expr_contains_exceptions(body),\\n    EAssign(_, value, body) => expr_contains_exceptions(value) || expr_contains_exceptions(body),\\n    EAssignOp(_, _, value, body) => expr_contains_exceptions(value) || expr_contains_exceptions(body),\\n    ESeq(first, second) => expr_contains_exceptions(first) || expr_contains_exceptions(second),\\n    EWhile(cond, body) => expr_contains_exceptions(cond) || expr_contains_exceptions(body),\\n    EForIn(_, _, iter_e, body) => expr_contains_exceptions(iter_e) || expr_contains_exceptions(body),\\n    ELoop(params, body) => {\\n      let mut i = 0\\n      let mut found = expr_contains_exceptions(body)\\n      while i < Array::length(params) {\\n        let (_, iv) = Array::get(params, i)\\n        if expr_contains_exceptions(iv) {\\n          found = true\\n        } else {\\n          ()\\n        }\\n        i = i + 1\\n      }\\n      found\\n    },\\n    EMatch(scrut, arms) => {\\n      let mut i = 0\\n      let mut found = expr_contains_exceptions(scrut)\\n      while i < Array::length(arms) {\\n        let (_, arm_body) = Array::get(arms, i)\\n        if expr_contains_exceptions(arm_body) {\\n          found = true\\n        } else {\\n          ()\\n        }\\n        i = i + 1\\n      }\\n      found\\n    },\\n    EFn(_, _, _, _, _, body) => expr_contains_exceptions(body),\\n    ETuple(elems) => {\\n      let mut i = 0\\n      let mut found = false\\n      while i < Array::length(elems) {\\n        if expr_contains_exceptions(Array::get(elems, i)) {\\n          found = true\\n        } else {\\n          ()\\n        }\\n        i = i + 1\\n      }\\n      found\\n    },\\n    EArray(elems) => {\\n      let mut i = 0\\n      let mut found = false\\n      while i < Array::length(elems) {\\n        if expr_contains_exceptions(Array::get(elems, i)) {\\n          found = true\\n        } else {\\n          ()\\n        }\\n        i = i + 1\\n      }\\n      found\\n    },\\n    ERecord(_, fields, _) => {\\n      let mut i = 0\\n      let mut found = false\\n      while i < Array::length(fields) {\\n        let (_, fval) = Array::get(fields, i)\\n        if expr_contains_exceptions(fval) {\\n          found = true\\n        } else {\\n          ()\\n        }\\n        i = i + 1\\n      }\\n      found\\n    },\\n    EMap(fields) => {\\n      let mut i = 0\\n      let mut found = false\\n      while i < Array::length(fields) {\\n        let (_, fval) = Array::get(fields, i)\\n        if expr_contains_exceptions(fval) {\\n          found = true\\n        } else {\\n          ()\\n        }\\n        i = i + 1\\n      }\\n      found\\n    },\\n    EDot(obj, _, _, _) => expr_contains_exceptions(obj),\\n    ELabeledArg(_, _, inner) => expr_contains_exceptions(inner),\\n    EReturn(inner) => expr_contains_exceptions(inner),\\n    ESpread(inner) => expr_contains_exceptions(inner),\\n    EBreak(opt) => match opt {\\n      Some(inner) => expr_contains_exceptions(inner),\\n      None => false\\n    },\\n    EContinue(args) => {\\n      let mut i = 0\\n      let mut found = false\\n      while i < Array::length(args) {\\n        if expr_contains_exceptions(Array::get(args, i)) {\\n          found = true\\n        } else {\\n          ()\\n        }\\n        i = i + 1\\n      }\\n      found\\n    },\\n    EInt(_) => false,\\n    EFloat(_) => false,\\n    EString(_) => false,\\n    EBool(_) => false,\\n    EIdent(_, _) => false,\\n    EStringInterp(_) => false,\\n    EUnit => false\\n  }\\n}\\n\\nexport fn stmts_contain_exceptions(stmts: Array[Stmt]) -> Bool {\\n  let mut i = 0\\n  let mut found = false\\n  while i < Array::length(stmts) {\\n    match Array::get(stmts, i) {\\n      SLet(_, _, _, _, expr) => if expr_contains_exceptions(expr) {\\n        found = true\\n      } else {\\n        ()\\n      },\\n      SLetMut(_, _, expr) => if expr_contains_exceptions(expr) {\\n        found = true\\n      } else {\\n        ()\\n      },\\n      SLetPat(_, expr) => if expr_contains_exceptions(expr) {\\n        found = true\\n      } else {\\n        ()\\n      },\\n      SExpr(expr) => if expr_contains_exceptions(expr) {\\n        found = true\\n      } else {\\n        ()\\n      },\\n      STest(_, expr) => if expr_contains_exceptions(expr) {\\n        found = true\\n      } else {\\n        ()\\n      },\\n      SBench(_, expr) => if expr_contains_exceptions(expr) {\\n        found = true\\n      } else {\\n        ()\\n      },\\n      SModule(_, _, inner) => if stmts_contain_exceptions(inner) {\\n        found = true\\n      } else {\\n        ()\\n      },\\n      _ => ()\\n    }\\n    i = i + 1\\n  }\\n  found\\n}\\n\\nexport fn collect_strings_stmts(stmts: Array[Stmt]) -> Array[String] {\\n  let out = common_analysis_fresh_string_array()\\n  let mut i = 0\\n  while i < Array::length(stmts) {\\n    match Array::get(stmts, i) {\\n      SLet(_, _, _, _, expr) => collect_strings_expr(expr, out),\\n      _ => 0\\n    }\\n    i = i + 1\\n  }\\n  out\\n}\\n\\nexport fn emit_i64_extend_i32_u(buf: Bytes) -> Unit {\\n  bytebuf_push(buf, op_i64_extend_i32_u)\\n}\\n\\n// Resolve closure/fn value tag and fill slot_local/env_local\\n// After this: slot_local = table slot index, env_local = env pointer (0 for bare fn)\\nexport fn emit_closure_resolve(buf: Bytes, fn_val_local: Int, slot_local: Int, env_local: Int) -> Unit {\\n  emit_local_get(buf, fn_val_local)\\n  emit_i64_const(buf, 3)\\n  emit_i64_and(buf)\\n  emit_i64_const(buf, 2)\\n  emit_i64_eq(buf)\\n  emit_if_void(buf)\\n  // Bare fn: table_slot = fn_val >> 2, env = 0\\n  emit_local_get(buf, fn_val_local)\\n  emit_i64_const(buf, 2)\\n  emit_i64_shr_s(buf)\\n  emit_local_set(buf, slot_local)\\n  emit_i64_const(buf, 0)\\n  emit_local_set(buf, env_local)\\n  emit_else(buf)\\n  // Closure: env = fn_val & ~3, slot = i32.load(env, 0)\\n  emit_local_get(buf, fn_val_local)\\n  emit_i64_const(buf, -4)\\n  emit_i64_and(buf)\\n  emit_local_set(buf, env_local)\\n  emit_local_get(buf, env_local)\\n  emit_i32_wrap_i64(buf)\\n  emit_i32_load(buf, 2, 0)\\n  emit_i64_extend_i32_u(buf)\\n  emit_local_set(buf, slot_local)\\n  emit_end(buf)\\n}\\n\\n// Emit the tail of an indirect closure call (push env, push slot, call_indirect)\\nexport fn emit_closure_call_tail(buf: Bytes, env_local: Int, slot_local: Int, closure_type_base: Int, num_args: Int) -> Unit {\\n  emit_local_get(buf, env_local)\\n  emit_local_get(buf, slot_local)\\n  emit_i32_wrap_i64(buf)\\n  emit_call_indirect(buf, closure_type_base + num_args)\\n}\\n\\nfn collect_pattern_bindings(pat: Pat, bindings: Array[String]) -> Int {\\n  match pat {\\n    PBind(name) => {\\n      Array::push(bindings, name); 0\\n    },\\n    PTuple(pats) => {\\n      let mut i = 0\\n      while i < Array::length(pats) {\\n        collect_pattern_bindings(Array::get(pats, i), bindings)\\n        i = i + 1\\n      }\\n      0\\n    },\\n    PCtor(_, args) => {\\n      let mut i = 0\\n      while i < Array::length(args) {\\n        collect_pattern_bindings(Array::get(args, i), bindings)\\n        i = i + 1\\n      }\\n      0\\n    },\\n    POr(l, r) => {\\n      collect_pattern_bindings(l, bindings); collect_pattern_bindings(r, bindings)\\n    },\\n    PStruct(_, fields) => {\\n      let mut i = 0\\n      while i < Array::length(fields) {\\n        let (_, fpat) = Array::get(fields, i)\\n        collect_pattern_bindings(fpat, bindings)\\n        i = i + 1\\n      }\\n      0\\n    },\\n    _ => 0\\n  }\\n}\\n\\n// Inlined async builtins (docs/spec/wasi-p3-async.md) are lowered directly by\\n// compile_call rather than living in the func table, so — like operators — they\\n// must never be treated as free variables when they appear inside a nested\\n// lambda body. Otherwise a thunk such as `() -> { Task::join(t) }` would capture\\n// `Task::join` as a closure value and mis-lower the call as an indirect apply.\\nfn is_inlined_async_builtin(name: String) -> Bool {\\n  name == \\\"await\\\" || name == \\\"Future::ready\\\" || name == \\\"Task::spawn\\\" || name == \\\"Task::join\\\" || name == \\\"Task::cancel\\\" || name == \\\"Task::race\\\" || name == \\\"Task::timeout\\\" || name == \\\"Stream::empty\\\" || name == \\\"Stream::once\\\" || name == \\\"Stream::map\\\" || name == \\\"Stream::filter\\\" || name == \\\"Stream::fold\\\" || name == \\\"Stream::next\\\" || name == \\\"String::to_bytes\\\" || name == \\\"Stream::to_string\\\"\\n}\\n\\n// #773: the scalar arithmetic/logic intrinsics (\\\"not\\\"/\\\"add\\\"/\\\"sub\\\"/\\\"mul\\\"/\\\"lt\\\")\\n// are, like the async builtins above, lowered INLINE by compile_call.vibe\\n// (`!prefer_bound_call && fname == \\\"not\\\"` etc.) rather than living in the func\\n// table -- UNLESS a user top-level function of the same bare name shadows them,\\n// in which case they're already present in `fn_names` (ctx.func_table.names)\\n// and excluded by the check above. (\\\"eq\\\"/\\\"Array::length\\\"/\\\"Bytes::length\\\"/\\n// \\\"String::length\\\" are unconditionally registered in the func table for every\\n// compile, so they never reach this fallback and need no entry here.)\\n//\\n// Before this fix, a closure/lambda literal that referenced one of these bare\\n// names as a call callee (e.g. `(b: Bool) -> Bool { not(b) }`) — and did NOT\\n// shadow it with a same-named top-level function — fell through to the `else`\\n// branch below and was wrongly recorded as a FREE VARIABLE to capture from the\\n// enclosing scope. compile_lambda.vibe then allocated a captured-env slot named\\n// \\\"not\\\" and, back in compile_call.vibe, `local_idx_hint` found \\\"not\\\" among the\\n// closure's own `local_names` (the just-added capture), forcing\\n// `prefer_bound_call = true` -- i.e. treating the wrongly captured (and\\n// nonexistent-in-the-enclosing-scope) \\\"not\\\" value as a closure to invoke via\\n// `call_indirect`. That corrupted the closure's environment and crashed with\\n// \\\"unreachable\\\" / \\\"null function or function signature mismatch\\\" at runtime\\n// (reported against @vibex/quickcheck's check_int/check_bool + is_ok, whose\\n// property closures call `not(...)`).\\nfn is_inlined_scalar_builtin(name: String) -> Bool {\\n  name == \\\"not\\\" || name == \\\"add\\\" || name == \\\"sub\\\" || name == \\\"mul\\\" || name == \\\"lt\\\"\\n}\\n\\n// Stack-based free variable analysis: uses in-place push/truncate on bound array\\n// to avoid O(n) array copies at every scope boundary. This dramatically reduces\\n// heap allocation during meta-circular self-compilation.\\n// #799 perf: `fn_names` is a MEMBERSHIP INDEX (Map), not an array. The flat\\n// fn+ctor name table is thousands of entries in a compiler-closure compile,\\n// and this walker consulted it linearly PER IDENT -- ~70% of a full compile's\\n// profile was string-equality scans under this function. Callers with a hot\\n// loop pass a prebuilt index (ctx.capture_name_index); the Array-taking\\n// wrapper below builds one per call for small/cold callers.\\n// #640 Stage 2: recognize the parse-time desugar of `throw(x)` —\\n// `ECall(EIdent(\\\"perform\\\"), [ECall(EIdent(\\\"Error::Throw\\\"), payload_args)])`\\n// — and return its payload args. None for every other perform (or shape).\\nfn ca_perform_error_throw_op_args(args: Array[Expr]) -> Option[Array[Expr]] {\\n  if Array::length(args) == 1 {\\n    match Array::get(args, 0) {\\n      ECall(op_callee, op_args, _) => match op_callee {\\n        EIdent(op_name, _) => if op_name == \\\"Error::Throw\\\" {\\n          Some(op_args)\\n        } else {\\n          None\\n        },\\n        _ => None\\n      },\\n      _ => None\\n    }\\n  } else {\\n    None\\n  }\\n}\\n\\nexport fn collect_free_vars_expr(expr: Expr, bound: Array[String], fn_names: Array[String], out: Array[String]) -> Int {\\n  match expr {\\n    EIdent(name, _) => if array_contains_str(bound, name) {\\n      0\\n    }\\n    else if bsearch_leftmost(fn_names, name) >= 0 {\\n      0\\n    }\\n    else if array_contains_str(out, name) {\\n      0\\n    }\\n    else {\\n      Array::push(out, name)\\n      0\\n    },\\n    EInt(_) => 0,\\n    EBool(_) => 0,\\n    EFloat(_) => 0,\\n    EString(_) => 0,\\n    EUnit => 0,\\n    EBinOp(_, lhs, rhs) => {\\n      collect_free_vars_expr(lhs, bound, fn_names, out); collect_free_vars_expr(rhs, bound, fn_names, out)\\n    },\\n    EUnaryOp(_, operand) => collect_free_vars_expr(operand, bound, fn_names, out),\\n    EIf(cond, then_e, else_e) => {\\n      collect_free_vars_expr(cond, bound, fn_names, out); collect_free_vars_expr(then_e, bound, fn_names, out); collect_free_vars_expr(else_e, bound, fn_names, out)\\n    },\\n    // #773/regression fix: the inlined-builtin skip only applies to a bare\\n    // name used as a CALL CALLEE (`sub(a, b)`), never to a plain identifier\\n    // reference. Checking it in the generic EIdent branch above would also\\n    // swallow a real bound-elsewhere variable that merely happens to share\\n    // one of these short names (e.g. a `sub: String` parameter in\\n    // lib/@vibe/prelude/string.vibe's string_index_of_from), wrongly\\n    // skipping its capture into a nested closure and crashing with\\n    // \\\"undefined variable (ident)\\\" at runtime.\\n    ECall(EIdent(cname, _), args, _) => if cname == \\\"perform\\\" {\\n      // #640 Stage 2: `throw(x)` parses to `perform Error::Throw(x)`. The\\n      // magic `perform` callee and the `Error::Throw` op name are keywords,\\n      // not capturable values — collecting them as free vars made every\\n      // throw-bearing LOCAL closure capture a garbage \\\"perform\\\" slot and\\n      // call through it (null call_indirect / signature mismatch at\\n      // runtime; the #786 perform-in-closure shape, which throw never had\\n      // as EThrow). Skip both and recurse into the payload only. A real\\n      // `perform Eff::Op(..)` keeps the historical collection verbatim\\n      // (those lambdas are dlh-hoisted before this analysis runs).\\n      match ca_perform_error_throw_op_args(args) {\\n        Some(op_args) => {\\n          let mut i = 0\\n          while i < Array::length(op_args) {\\n            collect_free_vars_expr(Array::get(op_args, i), bound, fn_names, out)\\n            i = i + 1\\n          }\\n          0\\n        },\\n        None => {\\n          collect_free_vars_expr(EIdent(cname, 0), bound, fn_names, out)\\n          let mut i = 0\\n          while i < Array::length(args) {\\n            collect_free_vars_expr(Array::get(args, i), bound, fn_names, out)\\n            i = i + 1\\n          }\\n          0\\n        }\\n      }\\n    } else if !array_contains_str(bound, cname) && !(bsearch_leftmost(fn_names, cname) >= 0) && (is_inlined_async_builtin(cname) || is_inlined_scalar_builtin(cname)) {\\n      let mut i = 0\\n      while i < Array::length(args) {\\n        collect_free_vars_expr(Array::get(args, i), bound, fn_names, out)\\n        i = i + 1\\n      }\\n      0\\n    } else {\\n      collect_free_vars_expr(EIdent(cname, 0), bound, fn_names, out)\\n      let mut i = 0\\n      while i < Array::length(args) {\\n        collect_free_vars_expr(Array::get(args, i), bound, fn_names, out)\\n        i = i + 1\\n      }\\n      0\\n    },\\n    ECall(callee, args, _) => {\\n      collect_free_vars_expr(callee, bound, fn_names, out)\\n      let mut i = 0\\n      while i < Array::length(args) {\\n        collect_free_vars_expr(Array::get(args, i), bound, fn_names, out)\\n        i = i + 1\\n      }\\n      0\\n    },\\n    ELet(name, value, body, _) => {\\n      collect_free_vars_expr(value, bound, fn_names, out)\\n      let saved = Array::length(bound)\\n      Array::push(bound, name)\\n      collect_free_vars_expr(body, bound, fn_names, out)\\n      Array::truncate(bound, saved)\\n      0\\n    },\\n    ELetRec(name, value, body) => {\\n      let saved = Array::length(bound)\\n      Array::push(bound, name)\\n      collect_free_vars_expr(value, bound, fn_names, out)\\n      collect_free_vars_expr(body, bound, fn_names, out)\\n      Array::truncate(bound, saved)\\n      0\\n    },\\n    ELetMut(name, value, body, _) => {\\n      collect_free_vars_expr(value, bound, fn_names, out)\\n      let saved = Array::length(bound)\\n      Array::push(bound, name)\\n      collect_free_vars_expr(body, bound, fn_names, out)\\n      Array::truncate(bound, saved)\\n      0\\n    },\\n    EAssign(name, value, body) => {\\n      // The assignment TARGET is a variable reference too: a lambda whose only\\n      // use of an outer `let mut` is `x = 1` (no read) must still capture it —\\n      // previously only value/body mentions were collected, so `count += 1` /\\n      // write-only assigns in closures failed codegen with\\n      // \\\"undefined variable (local): count\\\" (and is_mut_captured_in, which\\n      // rides this collector, never promoted the cell).\\n      if array_contains_str(bound, name) || bsearch_leftmost(fn_names, name) >= 0 || array_contains_str(out, name) {\\n        0\\n      } else {\\n        Array::push(out, name)\\n        0\\n      }\\n      collect_free_vars_expr(value, bound, fn_names, out); collect_free_vars_expr(body, bound, fn_names, out)\\n    },\\n    EAssignOp(name, _, value, body) => {\\n      if array_contains_str(bound, name) || bsearch_leftmost(fn_names, name) >= 0 || array_contains_str(out, name) {\\n        0\\n      } else {\\n        Array::push(out, name)\\n        0\\n      }\\n      collect_free_vars_expr(value, bound, fn_names, out); collect_free_vars_expr(body, bound, fn_names, out)\\n    },\\n    ESeq(first, second) => {\\n      collect_free_vars_expr(first, bound, fn_names, out); collect_free_vars_expr(second, bound, fn_names, out)\\n    },\\n    EWhile(cond, body) => {\\n      collect_free_vars_expr(cond, bound, fn_names, out); collect_free_vars_expr(body, bound, fn_names, out)\\n    },\\n    EForIn(var_name, index_name, iter_e, body) => {\\n      collect_free_vars_expr(iter_e, bound, fn_names, out)\\n      let saved = Array::length(bound)\\n      Array::push(bound, var_name)\\n      match index_name {\\n        Some(index_name) => Array::push(bound, index_name),\\n        None => ()\\n      }\\n      collect_free_vars_expr(body, bound, fn_names, out)\\n      Array::truncate(bound, saved)\\n      0\\n    },\\n    ETuple(elems) => {\\n      let mut i = 0\\n      while i < Array::length(elems) {\\n        collect_free_vars_expr(Array::get(elems, i), bound, fn_names, out)\\n        i = i + 1\\n      }\\n      0\\n    },\\n    EArray(elems) => {\\n      let mut i = 0\\n      while i < Array::length(elems) {\\n        collect_free_vars_expr(Array::get(elems, i), bound, fn_names, out)\\n        i = i + 1\\n      }\\n      0\\n    },\\n    EMatch(scrutinee, arms) => {\\n      collect_free_vars_expr(scrutinee, bound, fn_names, out)\\n      let mut i = 0\\n      while i < Array::length(arms) {\\n        let (arm_pat, arm_expr) = Array::get(arms, i)\\n        let saved = Array::length(bound)\\n        collect_pattern_bindings(arm_pat, bound)\\n        collect_free_vars_expr(arm_expr, bound, fn_names, out)\\n        Array::truncate(bound, saved)\\n        i = i + 1\\n      }\\n      0\\n    },\\n    EFn(_, _, params, _, _, body) => {\\n      let saved = Array::length(bound)\\n      let mut pi = 0\\n      while pi < Array::length(params) {\\n        let (pname_raw, _) = Array::get(params, pi)\\n        let pnl = String::length(pname_raw)\\n        let pname = if pnl > 0 {\\n          let plc = String::char_code_at(pname_raw, pnl - 1)\\n          if plc == '~' || plc == '?' { pname_raw[0:pnl - 1] } else pname_raw\\n        } else pname_raw\\n        Array::push(bound, pname)\\n        pi = pi + 1\\n      }\\n      collect_free_vars_expr(body, bound, fn_names, out)\\n      Array::truncate(bound, saved)\\n      0\\n    },\\n    EBreak(_) => 0,\\n    EContinue(_) => 0,\\n    EReturn(msg) => collect_free_vars_expr(msg, bound, fn_names, out),\\n    EHandle(body, arms) => {\\n      collect_free_vars_expr(body, bound, fn_names, out)\\n      let mut hi = 0\\n      while hi < Array::length(arms) {\\n        let (_, arm_expr) = Array::get(arms, hi)\\n        collect_free_vars_expr(arm_expr, bound, fn_names, out)\\n        hi = hi + 1\\n      }\\n      0\\n    },\\n    EDot(obj, _, _, _) => collect_free_vars_expr(obj, bound, fn_names, out),\\n    ERecord(_, fields, _) => {\\n      let mut ri = 0\\n      while ri < Array::length(fields) {\\n        let (_, fval) = Array::get(fields, ri)\\n        collect_free_vars_expr(fval, bound, fn_names, out)\\n        ri = ri + 1\\n      }\\n      0\\n    },\\n    ELabeledArg(_, _, arg_expr) => collect_free_vars_expr(arg_expr, bound, fn_names, out),\\n    _ => 0\\n  }\\n}\\n\\n// Array-taking compatibility entry: builds the membership index per call.\\n// Fine for small fn_names (tests, perceus probes); HOT loops over the full\\n// fn+ctor table must use collect_free_vars_indexed with a prebuilt index.\\nexport fn collect_free_vars(body: Expr, param_names: Array[String], fn_names: Array[String]) -> Array[String] {\\n  collect_free_vars_indexed(body, param_names, sorted_names_of(fn_names))\\n}\\n\\n// #799 perf: index-taking entry -- the index is built ONCE per compile\\n// (linked_compile) and reused for every lambda.\\nexport fn collect_free_vars_indexed(body: Expr, param_names: Array[String], fn_name_index: Array[String]) -> Array[String] {\\n  let out = common_analysis_fresh_string_array()\\n  // Make a mutable copy of param_names for stack-based push/truncate\\n  let bound = Array::slice(param_names, 0, Array::length(param_names))\\n  collect_free_vars_expr(body, bound, fn_name_index, out)\\n  out\\n}\\n\\n// #875 fix 2: like collect_free_vars_indexed, but forces `self_name` (the\\n// closure's OWN `let rec NAME = (...) -> { ... }` binding name, or \\\"\\\" for\\n// \\\"no self-reference to force\\\") into the result when `body` genuinely\\n// references it as a free (lexically unshadowed) identifier -- even if\\n// `self_name` ALSO happens to collide, by bare string equality, with an\\n// unrelated entry already present in `fn_name_index` (ctx.capture_name_index,\\n// a shared whole-program name index used to skip capturing bona fide global\\n// func/ctor references).\\n//\\n// Why this is needed: collect_free_vars_expr's EIdent case treats ANY name\\n// found in fn_name_index as \\\"resolves globally, no capture needed\\\" --\\n// correct when the name really is only reachable as a global, but wrong when\\n// it is ALSO the closure's own let-rec name. A `let rec check = (i) -> Bool\\n// { ... check(i + 1) ... }` closure normally captures \\\"check\\\" as a free\\n// variable precisely BECAUSE \\\"check\\\" is otherwise unknown to fn_name_index;\\n// the failure mode only appears once some unrelated top-level function\\n// (reachable via a widened whole-program-merge import graph, e.g. the\\n// compile entry file's own unqualified top-level names) happens to share the\\n// bare name \\\"check\\\". When that happens, compile_lambda's capture list\\n// silently omits the self-reference, self_cap_idx (compile_expr_tail.vibe)\\n// never fires, and the closure's own recursive call site falls through to\\n// compile_call's func-table direct-call path -- calling the unrelated global\\n// instead of itself (#875).\\n//\\n// Implementation: re-run the SAME free-var walk with an EMPTY fn_name_index\\n// (so nothing is excluded as \\\"a global\\\") whenever the normal result doesn't\\n// already contain self_name -- this reuses collect_free_vars_expr's existing,\\n// well-tested lexical-shadowing logic (bound push/truncate per scope) exactly\\n// as-is, so a self_name that IS legitimately shadowed by an inner binding of\\n// the same name (e.g. a nested lambda parameter also named \\\"check\\\") is still\\n// correctly excluded, matching normal shadowing semantics. Only runs the\\n// second walk in the (rare) collision case, so the common case -- no\\n// collision, self_name already present -- costs one array-membership check.\\nexport fn collect_free_vars_indexed_self(body: Expr, param_names: Array[String], fn_name_index: Array[String], self_name: String) -> Array[String] {\\n  let captures = collect_free_vars_indexed(body, param_names, fn_name_index)\\n  if self_name == \\\"\\\" || array_contains_str(captures, self_name) {\\n    captures\\n  } else {\\n    let no_globals = common_analysis_fresh_string_array()\\n    let unfiltered = collect_free_vars_indexed(body, param_names, no_globals)\\n    if array_contains_str(unfiltered, self_name) {\\n      Array::push(captures, self_name)\\n      captures\\n    } else {\\n      captures\\n    }\\n  }\\n}\\n\\n// The root identifier of a projection chain (EDot(...EDot(EIdent(root))...)), or\\n// \\\"\\\" if `e` is not a projection. (ADR-0055 Stage 4: shared with compile_expr_tail\\n// so function-tail param drops can detect an escaping projection of a param.)\\nexport fn proj_root_ident(e: Expr) -> String {\\n  match e {\\n    EDot(obj, _, _, _) => proj_root_ident(obj),\\n    EIdent(nm, _) => nm,\\n    _ => \\\"\\\"\\n  }\\n}\\n\\n// If the *tail* (result) expression of a scope is a projection chain, return its\\n// root identifier; otherwise \\\"\\\". Follows let/seq/assign wrappers to the tail.\\nexport fn scope_tail_proj_root(e: Expr) -> String {\\n  match e {\\n    ELet(_, _, b, _) => scope_tail_proj_root(b),\\n    ELetMut(_, _, b, _) => scope_tail_proj_root(b),\\n    ELetRec(_, _, b) => scope_tail_proj_root(b),\\n    ESeq(_, b) => scope_tail_proj_root(b),\\n    EAssign(_, _, b) => scope_tail_proj_root(b),\\n    EAssignOp(_, _, _, b) => scope_tail_proj_root(b),\\n    EDot(obj, _, _, _) => proj_root_ident(obj),\\n    _ => \\\"\\\"\\n  }\\n}\\n\\n// Check if a mutable variable is captured by any nested EFn in the given expression\\nexport fn is_mut_captured_in(expr: Expr, name: String) -> Bool {\\n  match expr {\\n    EIdent(_, _) => false,\\n    EInt(_) => false,\\n    EBool(_) => false,\\n    EFloat(_) => false,\\n    EString(_) => false,\\n    EUnit => false,\\n    EBinOp(_, lhs, rhs) => is_mut_captured_in(lhs, name) || is_mut_captured_in(rhs, name),\\n    EUnaryOp(_, operand) => is_mut_captured_in(operand, name),\\n    EIf(cond, then_e, else_e) => is_mut_captured_in(cond, name) || is_mut_captured_in(then_e, name) || is_mut_captured_in(else_e, name),\\n    ECall(callee, args, _) => if is_mut_captured_in(callee, name) {\\n      true\\n    }\\n    else {\\n      let mut i = 0\\n      let mut found = false\\n      while i < Array::length(args) {\\n        if is_mut_captured_in(Array::get(args, i), name) {\\n          found = true\\n        }\\n        i = i + 1\\n      }\\n      found\\n    },\\n    ELet(n, value, body, _) => if n == name {\\n      is_mut_captured_in(value, name)\\n    }\\n    else {\\n      is_mut_captured_in(value, name) || is_mut_captured_in(body, name)\\n    },\\n    ELetRec(n, value, body) => if n == name {\\n      false\\n    }\\n    else {\\n      is_mut_captured_in(value, name) || is_mut_captured_in(body, name)\\n    },\\n    ELetMut(n, value, body, _) => if n == name {\\n      is_mut_captured_in(value, name)\\n    }\\n    else {\\n      is_mut_captured_in(value, name) || is_mut_captured_in(body, name)\\n    },\\n    EAssign(_, value, body) => is_mut_captured_in(value, name) || is_mut_captured_in(body, name),\\n    EAssignOp(_, _, value, body) => is_mut_captured_in(value, name) || is_mut_captured_in(body, name),\\n    ESeq(first, second) => is_mut_captured_in(first, name) || is_mut_captured_in(second, name),\\n    EWhile(cond, body) => is_mut_captured_in(cond, name) || is_mut_captured_in(body, name),\\n    EForIn(_, _, iter_e, body) => is_mut_captured_in(iter_e, name) || is_mut_captured_in(body, name),\\n    ETuple(elems) => {\\n      let mut i = 0\\n      let mut found = false\\n      while i < Array::length(elems) {\\n        if is_mut_captured_in(Array::get(elems, i), name) {\\n          found = true\\n        }\\n        i = i + 1\\n      }\\n      found\\n    },\\n    EArray(elems) => {\\n      let mut i = 0\\n      let mut found = false\\n      while i < Array::length(elems) {\\n        if is_mut_captured_in(Array::get(elems, i), name) {\\n          found = true\\n        }\\n        i = i + 1\\n      }\\n      found\\n    },\\n    EMatch(scrutinee, arms) => if is_mut_captured_in(scrutinee, name) {\\n      true\\n    }\\n    else {\\n      let mut i = 0\\n      let mut found = false\\n      while i < Array::length(arms) {\\n        let (_, arm_expr) = Array::get(arms, i)\\n        if is_mut_captured_in(arm_expr, name) {\\n          found = true\\n        }\\n        i = i + 1\\n      }\\n      found\\n    },\\n    EFn(_, _, params, _, _, fn_body) => {\\n      // Check if name is shadowed by params\\n      let mut shadowed = false\\n      let mut pi = 0\\n      while pi < Array::length(params) {\\n        let (pname, _) = Array::get(params, pi)\\n        if pname == name {\\n          shadowed = true\\n        }\\n        pi = pi + 1\\n      }\\n      if shadowed {\\n        false\\n      }\\n      else {\\n        // Check if name is free in this EFn\\n        let param_names = Array::slice([\\n          \\\"\\\"\\n        ], 0, 0)\\n        let mut pi2 = 0\\n        while pi2 < Array::length(params) {\\n          let (pname2, _) = Array::get(params, pi2)\\n          Array::push(param_names, pname2)\\n          pi2 = pi2 + 1\\n        }\\n        let fv = collect_free_vars(fn_body, param_names, Array::slice([\\n          \\\"\\\"\\n        ], 0, 0))\\n        if array_contains_str(fv, name) {\\n          true\\n        }\\n        else {\\n          // Also check recursively for deeper nesting\\n          is_mut_captured_in(fn_body, name)\\n        }\\n      }\\n    },\\n    EBreak(_) => false,\\n    EContinue(_) => false,\\n    EReturn(msg) => is_mut_captured_in(msg, name),\\n    // #629 step 2: forms that carry sub-expressions which may hold a capturing\\n    // closure. Previously these fell through to `_ => false`, so a mut captured\\n    // by a closure INSIDE a struct/record literal, handler, loop, projection,\\n    // labeled argument, map literal, or spread was not detected — the cell was\\n    // left a stack-local and the closure captured it by value (snapshot),\\n    // silently losing the shared mutation. Recursing here is always sound\\n    // (over-detection only boxes more).\\n    ERecord(_, fields, _) => {\\n      let mut i = 0\\n      let mut found = false\\n      while i < Array::length(fields) {\\n        let (_, fval) = Array::get(fields, i)\\n        if is_mut_captured_in(fval, name) {\\n          found = true\\n        }\\n        i = i + 1\\n      }\\n      found\\n    },\\n    EMap(entries) => {\\n      let mut i = 0\\n      let mut found = false\\n      while i < Array::length(entries) {\\n        let (_, mval) = Array::get(entries, i)\\n        if is_mut_captured_in(mval, name) {\\n          found = true\\n        }\\n        i = i + 1\\n      }\\n      found\\n    },\\n    EHandle(body, arms) => if is_mut_captured_in(body, name) {\\n      true\\n    } else {\\n      let mut i = 0\\n      let mut found = false\\n      while i < Array::length(arms) {\\n        let (_, arm_expr) = Array::get(arms, i)\\n        if is_mut_captured_in(arm_expr, name) {\\n          found = true\\n        }\\n        i = i + 1\\n      }\\n      found\\n    },\\n    ELoop(params, body) => if is_mut_captured_in(body, name) {\\n      true\\n    } else {\\n      let mut i = 0\\n      let mut found = false\\n      while i < Array::length(params) {\\n        let (_, init) = Array::get(params, i)\\n        if is_mut_captured_in(init, name) {\\n          found = true\\n        }\\n        i = i + 1\\n      }\\n      found\\n    },\\n    EDot(obj, _, _, _) => is_mut_captured_in(obj, name),\\n    ELabeledArg(_, _, inner) => is_mut_captured_in(inner, name),\\n    ESpread(inner) => is_mut_captured_in(inner, name),\\n    _ => false\\n  }\\n}\\n\\n// Region-lifetime decision for a `let mut name` cell (#629 region inference).\\n// Returns true when the cell must be heap-boxed because its region lifetime can\\n// extend beyond the binding block (a capturing closure may escape); false keeps\\n// it a plain stack-local (region = lexical block). Both backends gate boxing on\\n// this single predicate (linear compile_expr_tail / wasm-gc backend_expr).\\n//\\n// Step 1 baseline: a mut captured by ANY nested closure is conservatively\\n// treated as escaping — identical to the prior `is_mut_captured_in` gate, so\\n// behavior is unchanged. Later steps refine this into a real escape analysis\\n// (a capture whose closure provably cannot escape its binding scope stays\\n// stack-local). The predicate stays conservative: when escape cannot be ruled\\n// out it returns true (box), which is always sound.\\nexport fn mut_needs_ref_cell(body: Expr, name: String) -> Bool {\\n  is_mut_captured_in(body, name)\\n}\\n\\n// Builtins whose arg0 is BORROWED (read in place, not consumed/dropped). Kept\\n// in sync with is_borrow_arg0_call in perceus/index.vibe.\\nexport fn md_is_borrow_arg0_call(f: String) -> Bool {\\n  f == \\\"__index\\\" || f == \\\"Array::get\\\" || f == \\\"Array::length\\\" || f == \\\"Array::set\\\" || f == \\\"Array::push\\\" || f == \\\"ArrayBuilder::push\\\" || f == \\\"StringBuilder::push\\\" || f == \\\"MapBuilder::set\\\" || f == \\\"Map::get\\\" || f == \\\"Map::keys\\\" || f == \\\"Map::has_key\\\" || f == \\\"Map::set\\\" || f == \\\"Bytes::push\\\" || f == \\\"Bytes::set\\\" || f == \\\"Bytes::get\\\" || f == \\\"Bytes::length\\\" || f == \\\"__rec_field\\\"\\n}\\n\\nfn md_max(a: Int, b: Int) -> Int {\\n  if a > b { a } else { b }\\n}\\n\\n// How many times is `name` consumed (owning position) along the LONGEST control\\n// path of `e`? Used to balance the rc of a value that is referenced but NOT\\n// owned at its definition site — a matched ctor field (a borrowed view sharing\\n// the scrutinee's refcount; compile_match) or a captured free variable (a\\n// borrowed view of the defining scope's binding; compile_lambda). Each owning\\n// consume of such a value decrements a refcount it does not own, so the value\\n// must be dup'd once PER consume or it is freed more times than dup'd -> double\\n// free. Sequential children SUM; alternative children (if-branches, match/handle\\n// arms) take the MAX, so the count is an upper bound on the consumes of any\\n// executed path (>= actual everywhere -> never under-dup -> no double free;\\n// tight on straight-line code -> no over-dup leak). MUST enumerate every Expr\\n// variant (modeled on fold_expr): skipping recursion into a child could miss a\\n// real consume and wrongly suppress the dup. A bare `EIdent(name)` passed as\\n// arg0 of a borrow-arg0 builtin does not consume (it is read in place).\\nexport fn md_consume_count(e: Expr, name: String) -> Int {\\n  match e {\\n    EInt(_) => 0,\\n    EFloat(_) => 0,\\n    EString(_) => 0,\\n    EBool(_) => 0,\\n    EUnit => 0,\\n    EStringInterp(_) => 0,\\n    EIdent(n, _) => if n == name { 1 } else { 0 },\\n    ETuple(items) => {\\n      let mut acc = 0\\n      let mut i = 0\\n      while i < Array::length(items) {\\n        acc = acc + md_consume_count(Array::get(items, i), name)\\n        i = i + 1\\n      }\\n      acc\\n    },\\n    EArray(items) => {\\n      let mut acc = 0\\n      let mut i = 0\\n      while i < Array::length(items) {\\n        acc = acc + md_consume_count(Array::get(items, i), name)\\n        i = i + 1\\n      }\\n      acc\\n    },\\n    ERecord(_, fields, _) => {\\n      let mut acc = 0\\n      let mut i = 0\\n      while i < Array::length(fields) {\\n        let (_, v) = Array::get(fields, i)\\n        acc = acc + md_consume_count(v, name)\\n        i = i + 1\\n      }\\n      acc\\n    },\\n    EMap(fields) => {\\n      let mut acc = 0\\n      let mut i = 0\\n      while i < Array::length(fields) {\\n        let (_, v) = Array::get(fields, i)\\n        acc = acc + md_consume_count(v, name)\\n        i = i + 1\\n      }\\n      acc\\n    },\\n    EIf(c, t, el) =>\\n    md_consume_count(c, name) + md_max(md_consume_count(t, name), md_consume_count(el, name)),\\n    ELet(_, v, b, _) => md_consume_count(v, name) + md_consume_count(b, name),\\n    ELetRec(_, v, b) => md_consume_count(v, name) + md_consume_count(b, name),\\n    ELetMut(_, v, b, _) => md_consume_count(v, name) + md_consume_count(b, name),\\n    EAssign(_, v, b) => md_consume_count(v, name) + md_consume_count(b, name),\\n    EAssignOp(_, _, v, b) => md_consume_count(v, name) + md_consume_count(b, name),\\n    ESeq(a, b) => md_consume_count(a, name) + md_consume_count(b, name),\\n    EMatch(s, arms) => {\\n      let mut mx = 0\\n      let mut i = 0\\n      while i < Array::length(arms) {\\n        let (_, v) = Array::get(arms, i)\\n        mx = md_max(mx, md_consume_count(v, name))\\n        i = i + 1\\n      }\\n      // A bare `match name { .. }` BORROWS the scrutinee (its fields become\\n      // borrowed views reclaimed by the owner's recursive drop); it does not\\n      // consume `name`. Counting it as a consume would over-dup a re-matched\\n      // borrowed tail (e.g. deeply-nested `match restN`), leaking/corrupting\\n      // the chain. A non-ident scrutinee may still consume `name` in a\\n      // sub-expression, so recurse there.\\n      let scr = match s {\\n        EIdent(_, _) => 0,\\n        _ => md_consume_count(s, name)\\n      }\\n      scr + mx\\n    },\\n    EHandle(s, arms) => {\\n      let mut mx = 0\\n      let mut i = 0\\n      while i < Array::length(arms) {\\n        let (_, v) = Array::get(arms, i)\\n        mx = md_max(mx, md_consume_count(v, name))\\n        i = i + 1\\n      }\\n      let scr = match s {\\n        EIdent(_, _) => 0,\\n        _ => md_consume_count(s, name)\\n      }\\n      scr + mx\\n    },\\n    EWhile(c, b) => md_consume_count(c, name) + md_consume_count(b, name),\\n    ELoop(params, b) => {\\n      let mut acc = md_consume_count(b, name)\\n      let mut i = 0\\n      while i < Array::length(params) {\\n        let (_, v) = Array::get(params, i)\\n        acc = acc + md_consume_count(v, name)\\n        i = i + 1\\n      }\\n      acc\\n    },\\n    EForIn(_, _, it, b) => md_consume_count(it, name) + md_consume_count(b, name),\\n    ECall(callee, args, _) => {\\n      let borrow0 = match callee {\\n        EIdent(f, _) => md_is_borrow_arg0_call(f),\\n        _ => false\\n      }\\n      let start = if borrow0 && Array::length(args) >= 1 {\\n        1\\n      } else {\\n        0\\n      }\\n      let head = if start == 1 {\\n        match Array::get(args, 0) {\\n          EIdent(_, _) => 0,\\n          _ => md_consume_count(Array::get(args, 0), name)\\n        }\\n      } else {\\n        0\\n      }\\n      // A bare-ident CALLEE is invoked, not consumed — calling a function or a\\n      // captured closure (incl. a recursive closure's own self-reference) does\\n      // not drop it. Counting `f(..)` as a consume of `f` over-dups the captured\\n      // closure once per call (#705: a nested self-recursive closure's self-\\n      // capture corrupted under RC). Only a non-ident callee can consume `name`\\n      // in a sub-expression.\\n      let callee_c = match callee {\\n        EIdent(_, _) => 0,\\n        _ => md_consume_count(callee, name)\\n      }\\n      let mut acc = callee_c + head\\n      let mut ri = start\\n      while ri < Array::length(args) {\\n        acc = acc + md_consume_count(Array::get(args, ri), name)\\n        ri = ri + 1\\n      }\\n      acc\\n    },\\n    EBinOp(_, l, r) => md_consume_count(l, name) + md_consume_count(r, name),\\n    EUnaryOp(_, x) => md_consume_count(x, name),\\n    EFn(_, _, _, _, _, body) => md_consume_count(body, name),\\n    EDot(x, _, _, _) => md_consume_count(x, name),\\n    ELabeledArg(_, _, v) => md_consume_count(v, name),\\n    EReturn(x) => md_consume_count(x, name),\\n    EBreak(opt) => match opt {\\n      Some(v) => md_consume_count(v, name),\\n      None => 0\\n    },\\n    EContinue(args) => {\\n      let mut acc = 0\\n      let mut i = 0\\n      while i < Array::length(args) {\\n        acc = acc + md_consume_count(Array::get(args, i), name)\\n        i = i + 1\\n      }\\n      acc\\n    },\\n    ESpread(x) => md_consume_count(x, name)\\n  }\\n}\\n\")\n}\n\nlet cli_adapter_source_68 = () -> (String, String) {\n  (\"lib/@vibe/compiler/perceus/index.vpkg\",\n\"version 0.0.1\\n\\n// @vibe/compiler/perceus — the RC backend's Perceus dup/drop planner\\n// (count + emit passes over a function body), the program-wide\\n// borrow-return / scalar-return / heap-return name scans, and the\\n// heap-param elaboration rewrite (ADR-0055/#702..#715 lineage). First\\n// COMPILER-INTERNAL contract batch (ADR-0070 Phase 3, #897) — compiled\\n// into the compiler itself via compiler_sources_manifest.tsv (group\\n// `codegen`, dual-row: this contract + perceus.vibe).\\n//\\n// The old index.vibe was not a facade but the whole implementation (the\\n// package is single-file), so it moved verbatim to perceus.vibe.\\n//\\n// `PerceusAction` is declared TRANSPARENT (defined verbatim here, deleted\\n// from the impl): tests/perceus_rc_test.vibe reads `.kind`/`.name`\\n// directly, so the field layout is real public API surface (@vibe/process\\n// ShResult precedent, PR #920). `PerceusActionKind` stays `opaque` with\\n// its `export enum` kept in perceus.vibe: the impl file itself constructs\\n// and pattern-matches PaDup/PaDrop/PaAliasDup, and enum VARIANTS do not\\n// resolve across units from a facade-only definition (@vibe/json\\n// precedent — \\\"unknown name: JNull\\\"). Consumers keep full variant\\n// visibility through the same #716 re-export machinery as before.\\n//\\n// `PCtx` (the planner's mutable count/emit state, parameter of\\n// pc_emit/pc_count) is intentionally NOT declared: it was never exported\\n// by the old index.vibe either — the exported pc_emit/pc_count signatures\\n// name it as structural signature text only, and conformance compares\\n// signatures textually, so declaring it `opaque` would have forced a new\\n// `export struct PCtx` (a surface WIDENING this migration must not make).\\n// No `version` binding existed (compiler-internal package).\\n\\nimport ./perceus.vibe {}\\n\\nopaque type PerceusActionKind\\n\\nstruct PerceusAction {\\n  kind: PerceusActionKind;\\n  name: String\\n}\\n\\n// --- plan-action predicates\\nfn pa_is_dup(a: PerceusAction) -> Bool\\nfn pa_is_drop(a: PerceusAction) -> Bool\\nfn pa_is_alias_dup(a: PerceusAction) -> Bool\\n\\n// --- program-wide name scans (threaded into every function's plan)\\nfn compute_borrow_returning_names(stmts: Array[Stmt]) -> Array[String]\\nfn compute_scalar_returning_names(stmts: Array[Stmt]) -> Array[String]\\nfn compute_heap_returning(stmts: Array[Stmt]) -> Array[String]\\n\\n// --- heap-ness classification\\nfn type_expr_is_heap(ot: Option[TypeExpr]) -> Bool\\nfn param_is_heap_in_body(name: String, otype: Option[TypeExpr], body: Expr) -> Bool\\n\\n// --- planner passes and entry points\\nfn pc_count(ctx: PCtx, scope: Map[String, Int], expr: Expr) -> Int\\nfn pc_emit(ctx: PCtx, scope: Map[String, Int], expr: Expr) -> Int\\nfn build_perceus_plan(body: Expr) -> Array[PerceusAction]\\nfn build_perceus_plan_with_params(params: Array[(String, Option[TypeExpr])], body: Expr, borrow_ret_names: Array[String]) -> Array[PerceusAction]\\n\\n// --- heap-param elaboration (run at the head of the RC pipeline)\\nfn elaborate_heap_params(stmts: Array[Stmt]) -> Array[Stmt]\\n\")\n}\n\nlet cli_adapter_source_69 = () -> (String, String) {\n  (\"lib/@vibe/compiler/perceus/perceus.vibe\",\n\"//# Imports\\n\\nimport ../codegen/common_analysis {\\n  collect_free_vars\\n}\\n\\nimport ../core {\\n  Expr, Pat, Stmt, TypeExpr\\n}\\n\\n//# Types\\n\\nexport enum PerceusActionKind {\\n  PaDup;\\n  PaDrop;\\n  // A `dup` attributed to an *alias* binding `let a = t`: the source `t` is\\n  // used in more than one owning position, so this alias takes a duplicated\\n  // reference. Keyed by the ALIAS name `a` (not the source), which makes it\\n  // occurrence-precise without tree-order bookkeeping: the codegen dups the\\n  // source exactly at `let a = …`. (docs/spec/selfhost-rc-port.md)\\n  PaAliasDup\\n}\\n\\n// PerceusAction is defined transparently in this package's contract\\n// (index.vpkg): its field layout (.kind/.name) is real public API surface\\n// read directly by tests/perceus_rc_test.vibe. Struct record literals and\\n// field access resolve fine from impl units against the facade definition\\n// (@vibe/process ShResult precedent, PR #920), so no local def is kept.\\n\\nstruct PCtx {\\n  mut next_id: Int;\\n  mut seq_id: Int;\\n  pctx_names: Array[String];\\n  uses: Array[Int];\\n  borrows: Array[Int];\\n  scalar: Array[Bool];\\n  remaining: Array[Int];\\n  actions: Array[PerceusAction]\\n}\\n\\nstruct HeapInferCtx {\\n  ctors: Array[String];\\n  heap_fns: Array[String]\\n}\\n\\n//# Functions\\n\\nfn zeros(n: Int) -> Array[Int] {\\n  let out: Array[Int] = [\\n  ]\\n  let mut i = 0\\n  while i < n {\\n    Array::push(out, 0)\\n    i = i + 1\\n  }\\n  out\\n}\\n\\nfn int_max(a: Int, b: Int) -> Int {\\n  if a > b {\\n    a\\n  } else {\\n    b\\n  }\\n}\\n\\nfn name_in(arr: Array[String], s: String) -> Bool {\\n  let mut i = 0\\n  let mut found = false\\n  while i < Array::length(arr) {\\n    if Array::get(arr, i) == s {\\n      found = true\\n    } else {\\n      ()\\n    }\\n    i = i + 1\\n  }\\n  found\\n}\\n\\nfn pe_push(ctx: PCtx, kind: PerceusActionKind, name: String) -> Int {\\n  Array::push(ctx.actions, PerceusAction::{\\n    kind: kind, name: name\\n  })\\n  0\\n}\\n\\nfn pe_use(ctx: PCtx, scope: Map[String, Int], name: String) -> Int {\\n  if Map::has_key(scope, name) {\\n    let id = Map::get(scope, name)\\n    let rem = Array::get(ctx.remaining, id)\\n    if rem > 1 && !Array::get(ctx.scalar, id) {\\n      pe_push(ctx, PaDup, name)\\n    } else {\\n      0\\n    }\\n    if rem > 0 {\\n      Array::set(ctx.remaining, id, rem - 1)\\n    }\\n  }\\n  0\\n}\\n\\nfn pctx_new() -> PCtx {\\n  PCtx::{\\n    next_id: 0,\\n    seq_id: 0,\\n    pctx_names: [\\n    ],\\n    uses: [\\n    ],\\n    borrows: [\\n    ],\\n    scalar: [\\n    ],\\n    remaining: [\\n    ],\\n    actions: [\\n    ],\\n  }\\n}\\n\\n// Perf: this snapshot runs in every branch/match arm of the perceus plan --\\n// the push-per-element version was the single largest __rt_arr_push caller in\\n// a full-closure compile profile (253ms of 439ms). Array::slice is one\\n// allocation + one memory.copy and yields an equally independent buffer.\\nfn copy_ints(src: Array[Int]) -> Array[Int] {\\n  Array::slice(src, 0, Array::length(src))\\n}\\n\\nexport fn pa_is_dup(a: PerceusAction) -> Bool {\\n  match a.kind {\\n    PaDup => true,\\n    PaDrop => false,\\n    PaAliasDup => false\\n  }\\n}\\n\\nfn pat_names(pat: Pat, out: Array[String]) -> Int {\\n  match pat {\\n    PBind(name) => {\\n      Array::push(out, name)\\n      0\\n    },\\n    PCtor(_n, args) => {\\n      let mut i = 0\\n      while i < Array::length(args) {\\n        pat_names(Array::get(args, i), out)\\n        i = i + 1\\n      }\\n      0\\n    },\\n    PTuple(pats) => {\\n      let mut i = 0\\n      while i < Array::length(pats) {\\n        pat_names(Array::get(pats, i), out)\\n        i = i + 1\\n      }\\n      0\\n    },\\n    POr(l, _r) => pat_names(l, out),\\n    PStruct(_n, fields) => {\\n      let mut i = 0\\n      while i < Array::length(fields) {\\n        pat_names((Array::get(fields, i)).1, out)\\n        i = i + 1\\n      }\\n      0\\n    },\\n    _ => 0\\n  }\\n}\\n\\nexport fn pa_is_drop(a: PerceusAction) -> Bool {\\n  match a.kind {\\n    PaDrop => true,\\n    PaDup => false,\\n    PaAliasDup => false\\n  }\\n}\\n\\nfn pc_declare(ctx: PCtx, name: String, scalar: Bool) -> Int {\\n  let id = ctx.next_id\\n  Array::push(ctx.pctx_names, name)\\n  Array::push(ctx.uses, 0)\\n  Array::push(ctx.borrows, 0)\\n  Array::push(ctx.scalar, scalar)\\n  ctx.next_id = id + 1\\n  id\\n}\\n\\nfn pe_declare(ctx: PCtx, _name: String) -> Int {\\n  let id = ctx.next_id\\n  let owning = Array::get(ctx.uses, id)\\n  let init = if owning == 0 {\\n    1\\n  } else {\\n    owning\\n  }\\n  Array::push(ctx.remaining, init)\\n  ctx.next_id = id + 1\\n  id\\n}\\n\\nfn pc_count_use(ctx: PCtx, scope: Map[String, Int], name: String) -> Int {\\n  if Map::has_key(scope, name) {\\n    let id = Map::get(scope, name)\\n    Array::set(ctx.uses, id, Array::get(ctx.uses, id) + 1)\\n  }\\n  0\\n}\\n\\nfn pe_scope_end(ctx: PCtx, id: Int, name: String) -> Int {\\n  if Array::get(ctx.remaining, id) > 0 && !Array::get(ctx.scalar, id) {\\n    pe_push(ctx, PaDrop, name)\\n    Array::set(ctx.remaining, id, 0)\\n  }\\n  0\\n}\\n\\nfn next_seq_name(ctx: PCtx) -> String {\\n  let nm = \\\"__seq\\\" + __to_string(ctx.seq_id)\\n  ctx.seq_id = ctx.seq_id + 1\\n  nm\\n}\\n\\nfn fn_param_names(params: Array[(String, Option[TypeExpr])]) -> Array[String] {\\n  let out: Array[String] = [\\n  ]\\n  let mut i = 0\\n  while i < Array::length(params) {\\n    Array::push(out, (Array::get(params, i)).0)\\n    i = i + 1\\n  }\\n  out\\n}\\n\\nfn is_v128_box_call(fname: String) -> Bool {\\n  fname == \\\"v128_load\\\" || fname == \\\"v128_splat_i8x16\\\" || fname == \\\"v128_eq_i8x16\\\" || fname == \\\"v128_le_u_i8x16\\\" || fname == \\\"v128_ge_u_i8x16\\\" || fname == \\\"v128_and\\\" || fname == \\\"v128_or\\\" || fname == \\\"v128_not\\\"\\n}\\n\\nfn array_contains_str_pctx(arr: Array[String], s: String) -> Bool {\\n  let mut i = 0\\n  let mut found = false\\n  while i < Array::length(arr) {\\n    if Array::get(arr, i) == s {\\n      found = true\\n    } else {\\n      ()\\n    }\\n    i = i + 1\\n  }\\n  found\\n}\\n\\n// #707: marker prefix (control char, cannot appear in a vibe identifier) used\\n// to smuggle the borrow-returning-function-name set through PCtx.pctx_names\\n// (a write-only \\\"declared binding names\\\" log that nothing else reads --\\n// see build_perceus_plan_with_params). A genuine dedicated PCtx field for\\n// this was tried and hit an unexplained \\\"memory access out of bounds\\\" reading\\n// it back specifically when the whole compiler self-compiles under RC\\n// (reproduces with the field's content/position/construction all varied;\\n// substituting pctx_names for the same read in the same call chain does NOT\\n// crash) -- see #707 for the investigation. Piggybacking on the\\n// known-safe field sidesteps it.\\nlet borrow_ret_marker = \\\"BR:\\\"\\n\\n// #707: is `fname` a call whose return value is a BORROWED VIEW sharing a\\n// call argument's refcount, rather than a fresh owned reference -- either one\\n// of the 3 builtins that read an element in place, or a user function whose\\n// own body is (transitively) nothing but a tail-call to one of those (see\\n// compute_borrow_returning_names). Bindings holding such a value must never\\n// be dup/drop'd themselves: the compiler-self-hosted-under-RC crash (#707)\\n// was exactly this -- `let peek = (toks, pos) -> Array::get(toks, pos)` was\\n// NOT recognized as borrow-returning (only a literal `Array::get` callee\\n// was), so `let __m_scrut = peek(toks, pos) in match __m_scrut { ... }`\\n// (the match-scrutinee-lift's desugaring, see normalize/index.vibe\\n// lift_match_scrutinees) planned a drop for `__m_scrut` as if it independently\\n// owned a reference -- double-freeing the array element peek merely borrowed.\\nfn is_borrow_ret_fname(ctx: PCtx, fname: String) -> Bool {\\n  fname == \\\"Array::get\\\" || fname == \\\"Map::get\\\" || fname == \\\"__index\\\" || fname == \\\"__rec_field\\\" || array_contains_str_pctx(ctx.pctx_names, String::concat(borrow_ret_marker, fname))\\n}\\n\\n// #707: fixed-point closure over top-level function definitions, starting\\n// from the 3 borrow-returning builtins: a function whose entire body is\\n// (after stripping let/seq/assign wrappers) a single tail-call to an\\n// already-known borrow-returning name is itself borrow-returning. Handles\\n// arbitrarily deep wrapper chains (`peek` -> `Array::get`,\\n// `peek2` -> `peek` -> `Array::get`, ...). Computed once over the whole\\n// merged program (see linked_compile.vibe) and threaded into every\\n// function's Perceus plan via build_perceus_plan_with_params.\\n// #707: does every value `e` can tail-produce come from a known\\n// borrow-returning name, or a \\\"safe to never drop\\\" fallback? Recurses through\\n// let/seq/assign wrappers and BOTH sides of if/match (a bare tail call alone\\n// missed `peek`'s actual shape: `if pos < len { Array::get(tokens, pos) }\\n// else TEof` -- a bounds-check guard around the real access, with a bare\\n// nullary-ctor-ish identifier as the out-of-range fallback). A bare EIdent\\n// tail (e.g. a sentinel like TEof) is accepted as safe even though it isn't\\n// proven borrow-returning: marking its binding \\\"never dup/drop\\\" can at worst\\n// leak that one value (the existing runtime dup/drop guards already no-op on\\n// non-heap-tagged values), never corrupt -- the failure mode this whole fix\\n// targets is a double-free from treating a genuinely-borrowed value as owned,\\n// not a leak from treating a small/rare owned value as borrowed.\\n// Iterative (NOT self-recursive) worklist walk over child expressions, rather\\n// than a `let rec` recursive-descent function. Also: the `ECall` case matches\\n// its callee via a NESTED constructor pattern one step at a time (`ECall(e,\\n// _, _)` then a separate `match e { EIdent(callee, _) => ... }`), never\\n// `ECall(EIdent(callee, _), _, _)` in one pattern. Both of these are\\n// load-bearing workarounds, not style: a `let rec` self-recursive version of\\n// this walk, AND a single-arm version using the nested `ECall(EIdent(...),\\n// _, _)` pattern, each independently reproduce a \\\"memory access out of\\n// bounds\\\" trap (reproducible under bump too -- not RC-specific) that is only\\n// exposed when this function runs over a derive(Ord)-generated `T::compare`\\n// body (a chain of `EIf(cmp, EInt(-1/1), ...)` with no further wrapper/call\\n// -- e.g. `struct P { x: Int; y: Int } derive(Ord)`). An equivalent shape\\n// recursing into an `Array::get` call / `EIdent` sentinel branch (`peek`'s\\n// actual body) does not crash either broken variant, and the crash persists\\n// even when the offending match arm is never reached at runtime for the\\n// crashing input -- so this is a codegen bug in this compiler triggered by\\n// those two source *shapes*, not a logic bug in this function's checks.\\n// True root cause not isolated; swap either workaround for the \\\"more natural\\\"\\n// form only after confirming compute_borrow_returning_names_test.vibe (or an\\n// equivalent derive(Ord) regression) still passes.\\nfn tail_is_borrow_ret_safe(known: Array[String], e0: Expr) -> Bool {\\n  let worklist = [e0]\\n  let mut all_safe = true\\n  let mut i = 0\\n  while i < Array::length(worklist) {\\n    match Array::get(worklist, i) {\\n      ELet(_, _, b, _) => Array::push(worklist, b),\\n      ELetMut(_, _, b, _) => Array::push(worklist, b),\\n      ELetRec(_, _, b) => Array::push(worklist, b),\\n      ESeq(_, b) => Array::push(worklist, b),\\n      EAssign(_, _, b) => Array::push(worklist, b),\\n      EAssignOp(_, _, _, b) => Array::push(worklist, b),\\n      EIf(_, t, el) => {\\n        Array::push(worklist, t)\\n        Array::push(worklist, el)\\n      },\\n      EMatch(_, arms) => {\\n        let mut ai = 0\\n        while ai < Array::length(arms) {\\n          let (_p, ae) = Array::get(arms, ai)\\n          Array::push(worklist, ae)\\n          ai = ai + 1\\n        }\\n      },\\n      ECall(callee_e, cargs, _) =>\\n      match callee_e {\\n        EIdent(callee, _) =>\\n        if callee == \\\"perform\\\" && Array::length(cargs) == 1 {\\n          // #640 Stage 2: `throw(x)` now parses to `perform Error::Throw(x)`,\\n          // so the #715 throwing-tail exemption below (EThrow) must also\\n          // recognize this shape — a throwing tail never produces a value, so\\n          // it cannot violate the borrow-returning invariant. Without this,\\n          // every `match x { Ctor(..) => field, _ => throw(..) }` accessor is\\n          // again rejected as borrow-returning and the #715 same-address\\n          // double-free returns. Matched step-by-step (NOT one nested\\n          // ECall(EIdent(..)) pattern) per the workaround note above.\\n          let mut op_is_throw = false\\n          match Array::get(cargs, 0) {\\n            ECall(op_e, _, _) =>\\n            match op_e {\\n              EIdent(op_n, _) => if op_n == \\\"Error::Throw\\\" {\\n                op_is_throw = true\\n              } else {\\n                ()\\n              },\\n              _ => ()\\n            },\\n            _ => ()\\n          }\\n          if op_is_throw {\\n            ()\\n          } else if !array_contains_str_pctx(known, callee) {\\n            all_safe = false\\n          } else {\\n            ()\\n          }\\n        } else if !array_contains_str_pctx(known, callee) {\\n          all_safe = false\\n        } else {\\n          ()\\n        },\\n        _ => {\\n          all_safe = false\\n        }\\n      },\\n      EIdent(_, _) => (),\\n      // #715: a throwing tail (the ubiquitous `match x { Ctor(..) => field, _\\n      // => throw(\\\"not X\\\") }` shape used by every common_extractors.vibe\\n      // accessor) never actually produces a value along that path, so it\\n      // cannot violate the borrow-returning invariant -- there is nothing to\\n      // mismanage. Without this, EVERY such accessor (get_efn_params,\\n      // get_efn_body, get_ecall_args, ...) fell through to the catch-all\\n      // below and was rejected solely because of its own error arm, even\\n      // though its real (non-throwing) arm is a plain borrowed field\\n      // projection. That misclassification made the caller treat the\\n      // extracted field as an independently owned value while the\\n      // scrutinee's own later structural drop also reclaims it -- a\\n      // same-address double-free (the #715 self-hosting free-list\\n      // corruption).\\n      _ => {\\n        all_safe = false\\n      }\\n    }\\n    i = i + 1\\n  }\\n  all_safe\\n}\\n\\n// Strip let/seq/assign wrappers, same as tail_is_borrow_ret_safe, to find the\\n// expression whose SHAPE decides eligibility at the top level.\\nfn strip_wrappers_for_borrow_ret(e: Expr) -> Expr {\\n  match e {\\n    ELet(_, _, b, _) => strip_wrappers_for_borrow_ret(b),\\n    ELetMut(_, _, b, _) => strip_wrappers_for_borrow_ret(b),\\n    ELetRec(_, _, b) => strip_wrappers_for_borrow_ret(b),\\n    ESeq(_, b) => strip_wrappers_for_borrow_ret(b),\\n    EAssign(_, _, b) => strip_wrappers_for_borrow_ret(b),\\n    EAssignOp(_, _, _, b) => strip_wrappers_for_borrow_ret(b),\\n    _ => e\\n  }\\n}\\n\\nexport fn compute_borrow_returning_names(stmts: Array[Stmt]) -> Array[String] {\\n  let known: Array[String] = [\\n    \\\"Array::get\\\", \\\"Map::get\\\", \\\"__index\\\", \\\"__rec_field\\\"\\n  ]\\n  let mut changed = true\\n  while changed {\\n    changed = false\\n    let mut i = 0\\n    while i < Array::length(stmts) {\\n      match Array::get(stmts, i) {\\n        SLet(_, _, name, _, value) =>\\n        if !array_contains_str_pctx(known, name) {\\n          match value {\\n            EFn(_, _, _, _, _, body) => {\\n              // A function is borrow-returning only if its (wrapper-stripped)\\n              // top-level shape is itself a call/if/match reaching a known\\n              // borrow-return name on every branch -- a BARE identifier tail\\n              // at the *top level* (an identity-like function) is NOT eligible\\n              // here even though tail_is_borrow_ret_safe accepts a bare ident\\n              // as a safe fallback *inside* an if/match branch (e.g. peek's\\n              // `else TEof`). This keeps `let f = (x) -> T { x }` (a genuine\\n              // passthrough of a normally-owned argument) from being\\n              // misclassified as a Array::get-style borrowed view.\\n              let top = strip_wrappers_for_borrow_ret(body)\\n              let eligible_shape = match top {\\n                ECall(_, _, _) => true,\\n                EIf(_, _, _) => true,\\n                EMatch(_, _) => true,\\n                _ => false\\n              }\\n              if eligible_shape && tail_is_borrow_ret_safe(known, top) {\\n                Array::push(known, name)\\n                changed = true\\n              } else {\\n                ()\\n              }\\n            },\\n            _ => ()\\n          }\\n        } else {\\n          ()\\n        },\\n        _ => ()\\n      }\\n      i = i + 1\\n    }\\n  }\\n  known\\n}\\n\\n// A top-level function's declared return type, from its `let f: (T1,...) ->\\n// R = ...` signature -- `None` when untyped (no signature to consult).\\nfn fn_sig_return_type(ty: Option[TypeExpr]) -> Option[TypeExpr] {\\n  match ty {\\n    Some(t) =>\\n    match t {\\n      TyFn(_, ret, _) => Some(ret),\\n      _ => None\\n    },\\n    None => None\\n  }\\n}\\n\\n// #710 out-param crash: `let n = f(...)` for a user function `f` whose body\\n// is not one of the 3 hardcoded borrow-returning builtins falls through to\\n// `heap_binding_names`'s default -- \\\"any non-borrow-ret call result is heap\\\"\\n// (compile_expr_tail.vibe's ELet ECall branch; see that struct field's own\\n// doc comment, which already promises \\\"we never touch a non-heap (e.g.\\n// Int-returning call) binding\\\"). When `f` actually returns a scalar (Int/\\n// Bool/Unit) -- e.g. `build_import_plan(...) -> Int` -- the binding is a\\n// plain integer, not a tagged heap pointer. If that binding is later\\n// ALIASED more than once (`let a = n; let b = n`), the Perceus plan schedules\\n// a PaAliasDup for the 2nd+ alias, and compile_expr_tail.vibe's `is_eident`\\n// branch used to call the unguarded `emit_rc_dup_local` on it: untag (AND -2)\\n// then read/write 4 bytes before the \\\"pointer\\\". For a small scalar like 0\\n// that computes a near-null address -- `RuntimeError: memory access out of\\n// bounds`, not a leak (component_codegen_test.vibe's \\\"component async: sync\\n// lift\\\" hit this via `import_func_count` aliased into run_core_func_idx/\\n// run_type_idx/run_func_idx). That call site now uses the runtime-tag-checked\\n// `emit_rc_dup_guarded` instead (a misclassified scalar is a silent no-op\\n// there rather than a wild write) -- this was the one remaining unguarded RC\\n// increment anywhere in codegen, so it is now fixed on general principle even\\n// though it was empirically NOT the cause of the *other* still-open #709\\n// self-hosting crash (a free-list node with corrupted size/next fields,\\n// surfacing later inside `fn_type_param_types`'s `vibe_rc_alloc`; confirmed via a\\n// differential rebuild that the crash persists byte-for-byte unchanged with\\n// this fix in place). Names collected here still matter for perf/precision\\n// (avoiding unnecessary heap_binding_names churn) and let the ELet ECall\\n// branch skip `heap_binding_names` for a call whose declared return type is\\n// provably scalar, matching the exemption the field's own doc comment already\\n// describes. Untyped functions are conservatively left out (stay in the\\n// existing heap over-approximation) since there is no signature to consult --\\n// no longer a correctness cliff-edge now that the alias-dup site is guarded,\\n// only a missed optimization.\\nexport fn compute_scalar_returning_names(stmts: Array[Stmt]) -> Array[String] {\\n  let out: Array[String] = [\\n  ]\\n  let mut i = 0\\n  while i < Array::length(stmts) {\\n    match Array::get(stmts, i) {\\n      SLet(_, _, name, ty, value) =>\\n      match value {\\n        EFn(_, _, _, _, _, _) =>\\n        match fn_sig_return_type(ty) {\\n          Some(ret) =>\\n          if !type_expr_is_heap(Some(ret)) {\\n            Array::push(out, name)\\n          } else {\\n            ()\\n          },\\n          None => ()\\n        },\\n        _ => ()\\n      },\\n      _ => ()\\n    }\\n    i = i + 1\\n  }\\n  out\\n}\\n\\nfn is_scalar_expr(ctx: PCtx, e: Expr) -> Bool {\\n  match e {\\n    EInt(_) => true,\\n    EBool(_) => true,\\n    EFloat(_) => true,\\n    EUnit => true,\\n    // #705: v128_load/splat/binary-op/not return a tagged pointer to a 16-byte\\n    // box with NO rc header (type_id/refcount) -- see compile_call.vibe. The\\n    // tag makes it look like a heap pointer to the runtime dup/drop guards\\n    // (odd low bit), so planning a PaDup/PaDrop for a binding holding one would\\n    // make those guards misread the v128 payload bytes as a refcount and\\n    // corrupt it (or an adjacent allocation). Treat the binding as scalar\\n    // (never dup/drop'd), matching the box's actual bump-only, never-freed\\n    // lifetime under both backends.\\n    ECall(EIdent(fname, _), _, _) => is_v128_box_call(fname) || is_borrow_ret_fname(ctx, fname),\\n    _ => false\\n  }\\n}\\n\\nfn pat_shadow_env(pat: Pat, env: Map[String, Bool]) -> Map[String, Bool] {\\n  let names: Array[String] = [\\n  ]\\n  pat_names(pat, names)\\n  let mut env2 = env\\n  let mut j = 0\\n  while j < Array::length(names) {\\n    env2 = Map::set(env2, Array::get(names, j), false)\\n    j = j + 1\\n  }\\n  env2\\n}\\n\\nfn restore_prefix(dst: Array[Int], src: Array[Int]) -> Int {\\n  let mut i = 0\\n  while i < Array::length(src) {\\n    Array::set(dst, i, Array::get(src, i))\\n    i = i + 1\\n  }\\n  0\\n}\\n\\nfn is_heap_literal(e: Expr) -> Bool {\\n  match e {\\n    ETuple(_) => true,\\n    EArray(_) => true,\\n    ERecord(_, _, _) => true,\\n    _ => false\\n  }\\n}\\n\\nfn is_heap_value(e: Expr, env: Map[String, Bool], hctx: HeapInferCtx) -> Bool {\\n  if is_heap_literal(e) {\\n    true\\n  } else {\\n    match e {\\n      ECall(callee, args, _) =>\\n      match callee {\\n        EIdent(c, _) =>\\n        if Map::has_key(env, c) {\\n          false\\n        } else {\\n          (Array::length(args) > 0 && name_in(hctx.ctors, c)) ||\\n          name_in(hctx.heap_fns, c)\\n        },\\n        _ => false\\n      },\\n      _ => false\\n    }\\n  }\\n}\\n\\nfn arg_class(arg: Expr, env: Map[String, Bool], hctx: HeapInferCtx) -> Bool {\\n  if is_heap_value(arg, env, hctx) {\\n    true\\n  } else {\\n    match arg {\\n      EIdent(n, _) => if Map::has_key(env, n) {\\n        Map::get(env, n)\\n      } else {\\n        false\\n      },\\n      _ => false\\n    }\\n  }\\n}\\n\\nfn analyze_calls(name: String, e_in: Expr, env_in: Map[String, Bool], calls: Array[Array[Bool]], esc: Array[Bool], hctx: HeapInferCtx) -> Int {\\n  // #556: iterate the let / seq / assign \\\"spine\\\" instead of recursing on its\\n  // tail, so a deeply-nested (flattened) expression — e.g. the whole compiler\\n  // compiled as a single unit under RC — no longer exhausts the wasm stack in\\n  // this pass. The shallow side of each spine node is still analyzed\\n  // recursively; the visit order and env threading are identical to the former\\n  // pure recursion (fixpoint-verified), so the RC analysis result is unchanged.\\n  let mut e = e_in\\n  let mut env = env_in\\n  let mut looping = true\\n  while looping {\\n    looping = false\\n    match e {\\n    EIdent(n, _) => {\\n      if n == name {\\n        Array::set(esc, 0, true)\\n      } else {\\n        ()\\n      }\\n      0\\n    },\\n    ECall(callee, args, _) => {\\n      let is_self = match callee {\\n        EIdent(cn, _) => cn == name,\\n        _ => false\\n      }\\n      if is_self {\\n        let cls: Array[Bool] = [\\n        ]\\n        let mut k = 0\\n        while k < Array::length(args) {\\n          Array::push(cls, arg_class(Array::get(args, k), env, hctx))\\n          k = k + 1\\n        }\\n        Array::push(calls, cls)\\n      } else {\\n        let _ = analyze_calls(name, callee, env, calls, esc, hctx)\\n        ()\\n      }\\n      let mut i = 0\\n      while i < Array::length(args) {\\n        analyze_calls(name, Array::get(args, i), env, calls, esc, hctx)\\n        i = i + 1\\n      }\\n      0\\n    },\\n    EDot(obj, _, _, _) => analyze_calls(name, obj, env, calls, esc, hctx),\\n    ELet(n, v, b, _) => {\\n      analyze_calls(name, v, env, calls, esc, hctx)\\n      env = Map::set(env, n, is_heap_value(v, env, hctx))\\n      e = b\\n      looping = true\\n    },\\n    ELetRec(n, v, b) => {\\n      env = Map::set(env, n, false)\\n      analyze_calls(name, v, env, calls, esc, hctx)\\n      e = b\\n      looping = true\\n    },\\n    ELetMut(n, v, b, _) => {\\n      analyze_calls(name, v, env, calls, esc, hctx)\\n      env = Map::set(env, n, false)\\n      e = b\\n      looping = true\\n    },\\n    EAssign(_, v, c) => {\\n      analyze_calls(name, v, env, calls, esc, hctx)\\n      e = c\\n      looping = true\\n    },\\n    EAssignOp(_, _, v, c) => {\\n      analyze_calls(name, v, env, calls, esc, hctx)\\n      e = c\\n      looping = true\\n    },\\n    ESeq(a, b) => {\\n      analyze_calls(name, a, env, calls, esc, hctx)\\n      e = b\\n      looping = true\\n    },\\n    EIf(c, t, el) => {\\n      analyze_calls(name, c, env, calls, esc, hctx)\\n      analyze_calls(name, t, env, calls, esc, hctx)\\n      analyze_calls(name, el, env, calls, esc, hctx)\\n      0\\n    },\\n    EWhile(c, b) => {\\n      analyze_calls(name, c, env, calls, esc, hctx)\\n      analyze_calls(name, b, env, calls, esc, hctx)\\n      0\\n    },\\n    EForIn(v0, ix, it, b) => {\\n      analyze_calls(name, it, env, calls, esc, hctx)\\n      let env1 = Map::set(env, v0, false)\\n      let env2 = match ix {\\n        Some(ixn) => Map::set(env1, ixn, false),\\n        None => env1\\n      }\\n      analyze_calls(name, b, env2, calls, esc, hctx)\\n      0\\n    },\\n    EBinOp(_, l, r) => {\\n      analyze_calls(name, l, env, calls, esc, hctx)\\n      analyze_calls(name, r, env, calls, esc, hctx)\\n      0\\n    },\\n    EUnaryOp(_, o) => analyze_calls(name, o, env, calls, esc, hctx),\\n    EFn(_, _, params, _, _, b) => {\\n      let mut env2 = env\\n      let mut pi = 0\\n      while pi < Array::length(params) {\\n        let (pn, _) = Array::get(params, pi)\\n        env2 = Map::set(env2, pn, false)\\n        pi = pi + 1\\n      }\\n      analyze_calls(name, b, env2, calls, esc, hctx)\\n      0\\n    },\\n    ETuple(xs) => {\\n      let mut i = 0\\n      while i < Array::length(xs) {\\n        analyze_calls(name, Array::get(xs, i), env, calls, esc, hctx)\\n        i = i + 1\\n      }\\n      0\\n    },\\n    EArray(xs) => {\\n      let mut i = 0\\n      while i < Array::length(xs) {\\n        analyze_calls(name, Array::get(xs, i), env, calls, esc, hctx)\\n        i = i + 1\\n      }\\n      0\\n    },\\n    EMatch(s, arms) => {\\n      analyze_calls(name, s, env, calls, esc, hctx)\\n      let mut i = 0\\n      while i < Array::length(arms) {\\n        let (pat, ab) = Array::get(arms, i)\\n        analyze_calls(name, ab, pat_shadow_env(pat, env), calls, esc, hctx)\\n        i = i + 1\\n      }\\n      0\\n    },\\n    EHandle(b, arms) => {\\n      analyze_calls(name, b, env, calls, esc, hctx)\\n      let mut i = 0\\n      while i < Array::length(arms) {\\n        let (pat, ab) = Array::get(arms, i)\\n        analyze_calls(name, ab, pat_shadow_env(pat, env), calls, esc, hctx)\\n        i = i + 1\\n      }\\n      0\\n    },\\n    ELoop(ps, b) => {\\n      let mut env2 = env\\n      let mut i = 0\\n      while i < Array::length(ps) {\\n        let (pn, iv) = Array::get(ps, i)\\n        analyze_calls(name, iv, env2, calls, esc, hctx)\\n        env2 = Map::set(env2, pn, false)\\n        i = i + 1\\n      }\\n      analyze_calls(name, b, env2, calls, esc, hctx)\\n      0\\n    },\\n    ERecord(_, fs, _) => {\\n      let mut i = 0\\n      while i < Array::length(fs) {\\n        let (_, fv) = Array::get(fs, i)\\n        analyze_calls(name, fv, env, calls, esc, hctx)\\n        i = i + 1\\n      }\\n      0\\n    },\\n    EMap(fs) => {\\n      let mut i = 0\\n      while i < Array::length(fs) {\\n        let (_, fv) = Array::get(fs, i)\\n        analyze_calls(name, fv, env, calls, esc, hctx)\\n        i = i + 1\\n      }\\n      0\\n    },\\n    ELabeledArg(_, _, x) => analyze_calls(name, x, env, calls, esc, hctx),\\n    EReturn(x) => analyze_calls(name, x, env, calls, esc, hctx),\\n    ESpread(x) => analyze_calls(name, x, env, calls, esc, hctx),\\n    EBreak(o) =>\\n    match o {\\n      Some(x) => analyze_calls(name, x, env, calls, esc, hctx),\\n      None => 0\\n    },\\n    EContinue(xs) => {\\n      let mut i = 0\\n      while i < Array::length(xs) {\\n        analyze_calls(name, Array::get(xs, i), env, calls, esc, hctx)\\n        i = i + 1\\n      }\\n      0\\n    },\\n    EInt(_) => 0,\\n    EFloat(_) => 0,\\n    EString(_) => 0,\\n    EBool(_) => 0,\\n    EStringInterp(_) => 0,\\n    EUnit => 0\\n  }\\n  }\\n  0\\n}\\n\\n// An alias-attributed dup: `let a = t` where `t` is multiply-used and owned.\\n// Keyed by the alias name.\\nexport fn pa_is_alias_dup(a: PerceusAction) -> Bool {\\n  match a.kind {\\n    PaAliasDup => true,\\n    PaDup => false,\\n    PaDrop => false\\n  }\\n}\\n\\nfn pc_count_borrow(ctx: PCtx, scope: Map[String, Int], name: String) -> Int {\\n  if Map::has_key(scope, name) {\\n    let id = Map::get(scope, name)\\n    Array::set(ctx.borrows, id, Array::get(ctx.borrows, id) + 1)\\n  }\\n  0\\n}\\n\\nfn type_contains_fn(t: TypeExpr) -> Bool {\\n  match t {\\n    TyFn(_, _, _) => true,\\n    TyTuple(elems) => {\\n      let mut i = 0\\n      let mut found = false\\n      while i < Array::length(elems) {\\n        if type_contains_fn(Array::get(elems, i)) {\\n          found = true\\n        } else {\\n          ()\\n        }\\n        i = i + 1\\n      }\\n      found\\n    },\\n    TyApp(_, args) => {\\n      let mut i = 0\\n      let mut found = false\\n      while i < Array::length(args) {\\n        if type_contains_fn(Array::get(args, i)) {\\n          found = true\\n        } else {\\n          ()\\n        }\\n        i = i + 1\\n      }\\n      found\\n    },\\n    TyName(_) => false,\\n    TyUnit => false\\n  }\\n}\\n\\nfn all_calls_heap_at(idx: Int, calls: Array[Array[Bool]]) -> Bool {\\n  let mut ci = 0\\n  let mut all_heap = true\\n  while ci < Array::length(calls) {\\n    let cls = Array::get(calls, ci)\\n    if idx >= Array::length(cls) {\\n      all_heap = false\\n    } else if !Array::get(cls, idx) {\\n      all_heap = false\\n    } else {\\n      ()\\n    }\\n    ci = ci + 1\\n  }\\n  all_heap\\n}\\n\\nfn type_name_is_heap(n: String) -> Bool {\\n  if String::length(n) == 0 {\\n    false\\n  } else {\\n    let c0 = String::char_code_at(n, 0)\\n    if c0 < 'A' || c0 > 'Z' {\\n      false\\n    } else if n == \\\"Int\\\" || n == \\\"Bool\\\" || n == \\\"Double\\\" || n == \\\"Float\\\" || n == \\\"String\\\" || n == \\\"Bytes\\\" || n == \\\"Char\\\" || n == \\\"Unit\\\" || n == \\\"V128\\\" {\\n      // #705: V128 is a tagged pointer to a 16-byte box (see compile_call.vibe\\n      // v128_load/v128_splat_i8x16/etc), but the box has NO rc header\\n      // (type_id/refcount) -- it's a bare payload written directly by\\n      // v128.store. Treating it as heap would make Perceus emit __rc_dup /\\n      // vibe_rc_drop calls that misread the v128 payload bytes as a type_id and\\n      // refcount, corrupting the box (or freeing arbitrary memory at the\\n      // implied \\\"next\\\"/size fields). Excluding it here keeps V128 boxes exactly\\n      // as they behave under the bump backend: forward-only bump allocations\\n      // that are simply never reclaimed, not memory-unsafe ones.\\n      false\\n    } else {\\n      true\\n    }\\n  }\\n}\\n\\nexport fn type_expr_is_heap(ot: Option[TypeExpr]) -> Bool {\\n  match ot {\\n    None => false,\\n    Some(t) =>\\n    match t {\\n      // #702: a bare function-typed binding/param is a closure — heap when it\\n      // captures (an odd RC block), a scalar constant when it doesn't. Treating\\n      // it as heap lets the owning function drop it (vibe_rc_drop's odd-check makes\\n      // the non-capturing constant a no-op), reclaiming capturing closures passed\\n      // as arguments to higher-order fns instead of leaking them.\\n      TyFn(_, _, _) => true,\\n      _ =>\\n      if type_contains_fn(t) {\\n        false\\n      } else {\\n        match t {\\n          TyTuple(_) => true,\\n          TyApp(_, _) => true,\\n          TyName(n) => type_name_is_heap(n),\\n          TyFn(_, _, _) => false,\\n          TyUnit => false\\n        }\\n      }\\n    }\\n  }\\n}\\n\\n// #791: program-wide (name of every top-level function whose DECLARED return\\n// type is heap), mirroring compute_agg_returning's scan but reading\\n// type_expr_is_heap instead of agg_info_of_type_expr. This is the \\\"read the\\n// declared signature\\\" alternative to threading checker-inferred types\\n// through codegen: `let mut s = Set::new()` can be classified correctly by\\n// looking up `Set::new`'s OWN `-> Set[T]` annotation (already sitting on the\\n// AST, no unification/inference needed) instead of guessing from the RHS\\n// expression's shape. Only covers named, annotated top-level functions --\\n// classify_let_value_heap (compile_expr_tail.vibe) falls back to its\\n// existing \\\"any ECall is heap by default\\\" over-approximation when a callee\\n// isn't found here (unannotated function, local closure, shadowed name),\\n// so this is a precision refinement, not a completeness requirement.\\nexport fn compute_heap_returning(stmts: Array[Stmt]) -> Array[String] {\\n  let out: Array[String] = [\\n  ]\\n  let mut i = 0\\n  while i < Array::length(stmts) {\\n    match Array::get(stmts, i) {\\n      SLet(_, _, name, ann, value) => match value {\\n        EFn(_, _, _, fn_ret, _, _) => {\\n          let ret = match ann {\\n            Some(at) => match at {\\n              TyFn(_, r, _) => Some(r),\\n              _ => fn_ret\\n            },\\n            None => fn_ret\\n          }\\n          if type_expr_is_heap(ret) {\\n            Array::push(out, name)\\n          } else {\\n            ()\\n          }\\n        },\\n        _ => ()\\n      },\\n      _ => ()\\n    }\\n    i = i + 1\\n  }\\n  out\\n}\\n\\nfn collect_ctor_names(stmts: Array[Stmt]) -> Array[String] {\\n  let out: Array[String] = [\\n  ]\\n  let mut i = 0\\n  while i < Array::length(stmts) {\\n    match Array::get(stmts, i) {\\n      SEnum(_, _, _, variants, _) => {\\n        let mut j = 0\\n        while j < Array::length(variants) {\\n          let (vn, _) = Array::get(variants, j)\\n          Array::push(out, vn)\\n          j = j + 1\\n        }\\n      },\\n      SSuberror(_, _, variants) => {\\n        let mut j = 0\\n        while j < Array::length(variants) {\\n          let (vn, _) = Array::get(variants, j)\\n          Array::push(out, vn)\\n          j = j + 1\\n        }\\n      },\\n      _ => ()\\n    }\\n    i = i + 1\\n  }\\n  out\\n}\\n\\nfn inferred_heap_type() -> TypeExpr {\\n  TyTuple(Array::slice([\\n    TyUnit\\n  ], 0, 0))\\n}\\n\\nfn fill_lambda_params(name: String, efn: Expr, body: Expr, hctx: HeapInferCtx) -> Expr {\\n  match efn {\\n    EFn(tps, bounds, params, ret, eff, fnbody) => {\\n      let calls: Array[Array[Bool]] = [\\n      ]\\n      let esc = [\\n        false\\n      ]\\n      let env0: Map[String, Bool] = Map::new()\\n      analyze_calls(name, body, env0, calls, esc, hctx)\\n      if Array::get(esc, 0) || Array::length(calls) == 0 {\\n        efn\\n      } else {\\n        let new_params = Array::slice(params, 0, 0)\\n        let mut pi = 0\\n        while pi < Array::length(params) {\\n          let (pname, pty) = Array::get(params, pi)\\n          let filled = match pty {\\n            Some(_) => (pname, pty),\\n            None =>\\n            if all_calls_heap_at(pi, calls) {\\n              (pname, Some(inferred_heap_type()))\\n            } else {\\n              (pname, pty)\\n            }\\n          }\\n          Array::push(new_params, filled)\\n          pi = pi + 1\\n        }\\n        EFn(tps, bounds, new_params, ret, eff, fnbody)\\n      }\\n    },\\n    _ => efn\\n  }\\n}\\n\\nfn elaborate_rw(e: Expr, hctx: HeapInferCtx) -> Expr {\\n  match e {\\n    ELet(n, v, b, soff) => {\\n      let v2 = elaborate_rw(v, hctx)\\n      let v3 = fill_lambda_params(n, v2, b, hctx)\\n      ELet(n, v3, elaborate_rw(b, hctx), soff)\\n    },\\n    ELetRec(n, v, b) => {\\n      let v2 = elaborate_rw(v, hctx)\\n      let v3 = fill_lambda_params(n, v2, b, hctx)\\n      ELetRec(n, v3, elaborate_rw(b, hctx))\\n    },\\n    ELetMut(n, v, b, soff) => ELetMut(n, elaborate_rw(v, hctx), elaborate_rw(b, hctx), soff),\\n    EAssign(n, v, c) => EAssign(n, elaborate_rw(v, hctx), elaborate_rw(c, hctx)),\\n    EAssignOp(n, op, v, c) => EAssignOp(n, op, elaborate_rw(v, hctx), elaborate_rw(c, hctx)),\\n    ESeq(a, b) => ESeq(elaborate_rw(a, hctx), elaborate_rw(b, hctx)),\\n    EIf(c, t, el) => EIf(elaborate_rw(c, hctx), elaborate_rw(t, hctx), elaborate_rw(el, hctx)),\\n    EWhile(c, b) => EWhile(elaborate_rw(c, hctx), elaborate_rw(b, hctx)),\\n    EForIn(n, ix, it, b) => EForIn(n, ix, elaborate_rw(it, hctx), elaborate_rw(b, hctx)),\\n    EFn(tps, bounds, params, ret, eff, fb) =>\\n    EFn(tps, bounds, params, ret, eff, elaborate_rw(fb, hctx)),\\n    ECall(callee, args, off) => {\\n      let new_args = Array::slice(args, 0, 0)\\n      let mut i = 0\\n      while i < Array::length(args) {\\n        Array::push(new_args, elaborate_rw(Array::get(args, i), hctx))\\n        i = i + 1\\n      }\\n      ECall(elaborate_rw(callee, hctx), new_args, off)\\n    },\\n    EBinOp(op, l, r) => EBinOp(op, elaborate_rw(l, hctx), elaborate_rw(r, hctx)),\\n    EUnaryOp(op, o) => EUnaryOp(op, elaborate_rw(o, hctx)),\\n    EDot(o, f, off, fdoff) => EDot(elaborate_rw(o, hctx), f, off, fdoff),\\n    ETuple(xs) => {\\n      let ys = Array::slice(xs, 0, 0)\\n      let mut i = 0\\n      while i < Array::length(xs) {\\n        Array::push(ys, elaborate_rw(Array::get(xs, i), hctx))\\n        i = i + 1\\n      }\\n      ETuple(ys)\\n    },\\n    EArray(xs) => {\\n      let ys = Array::slice(xs, 0, 0)\\n      let mut i = 0\\n      while i < Array::length(xs) {\\n        Array::push(ys, elaborate_rw(Array::get(xs, i), hctx))\\n        i = i + 1\\n      }\\n      EArray(ys)\\n    },\\n    EMatch(s, arms) => {\\n      let new_arms = Array::slice(arms, 0, 0)\\n      let mut i = 0\\n      while i < Array::length(arms) {\\n        let (p, ab) = Array::get(arms, i)\\n        Array::push(new_arms, (p, elaborate_rw(ab, hctx)))\\n        i = i + 1\\n      }\\n      EMatch(elaborate_rw(s, hctx), new_arms)\\n    },\\n    EHandle(b, arms) => {\\n      let new_arms = Array::slice(arms, 0, 0)\\n      let mut i = 0\\n      while i < Array::length(arms) {\\n        let (p, ab) = Array::get(arms, i)\\n        Array::push(new_arms, (p, elaborate_rw(ab, hctx)))\\n        i = i + 1\\n      }\\n      EHandle(elaborate_rw(b, hctx), new_arms)\\n    },\\n    ELoop(ps, b) => {\\n      let new_ps = Array::slice(ps, 0, 0)\\n      let mut i = 0\\n      while i < Array::length(ps) {\\n        let (pn, iv) = Array::get(ps, i)\\n        Array::push(new_ps, (pn, elaborate_rw(iv, hctx)))\\n        i = i + 1\\n      }\\n      ELoop(new_ps, elaborate_rw(b, hctx))\\n    },\\n    ERecord(rn, fs, targs) => {\\n      let new_fs = Array::slice(fs, 0, 0)\\n      let mut i = 0\\n      while i < Array::length(fs) {\\n        let (fn0, fv) = Array::get(fs, i)\\n        Array::push(new_fs, (fn0, elaborate_rw(fv, hctx)))\\n        i = i + 1\\n      }\\n      ERecord(rn, new_fs, targs)\\n    },\\n    EMap(fs) => {\\n      let new_fs = Array::slice(fs, 0, 0)\\n      let mut i = 0\\n      while i < Array::length(fs) {\\n        let (fn0, fv) = Array::get(fs, i)\\n        Array::push(new_fs, (fn0, elaborate_rw(fv, hctx)))\\n        i = i + 1\\n      }\\n      EMap(new_fs)\\n    },\\n    ELabeledArg(l, k, x) => ELabeledArg(l, k, elaborate_rw(x, hctx)),\\n    EReturn(x) => EReturn(elaborate_rw(x, hctx)),\\n    ESpread(x) => ESpread(elaborate_rw(x, hctx)),\\n    EBreak(o) =>\\n    match o {\\n      Some(x) => EBreak(Some(elaborate_rw(x, hctx))),\\n      None => EBreak(None)\\n    },\\n    EContinue(xs) => {\\n      let ys = Array::slice(xs, 0, 0)\\n      let mut i = 0\\n      while i < Array::length(xs) {\\n        Array::push(ys, elaborate_rw(Array::get(xs, i), hctx))\\n        i = i + 1\\n      }\\n      EContinue(ys)\\n    },\\n    EInt(_) => e,\\n    EFloat(_) => e,\\n    EString(_) => e,\\n    EBool(_) => e,\\n    EIdent(_, _) => e,\\n    EStringInterp(_) => e,\\n    EUnit => e\\n  }\\n}\\n\\nfn is_borrow_arg0_call(f: String) -> Bool {\\n  f == \\\"__index\\\" || f == \\\"Array::get\\\" || f == \\\"Array::length\\\" || f == \\\"Array::set\\\" || f == \\\"Array::push\\\" || f == \\\"ArrayBuilder::push\\\" || f == \\\"StringBuilder::push\\\" || f == \\\"MapBuilder::set\\\" || f == \\\"Map::get\\\" || f == \\\"Map::keys\\\" || f == \\\"Map::has_key\\\" || f == \\\"Map::has\\\" || f == \\\"Map::set\\\" || f == \\\"Map::size\\\" || f == \\\"Map::values\\\" || f == \\\"Map::delete\\\" || f == \\\"Bytes::push\\\" || f == \\\"Bytes::set\\\" || f == \\\"Bytes::get\\\" || f == \\\"Bytes::length\\\" || f == \\\"__rec_field\\\"\\n}\\n\\nexport fn pc_emit(ctx: PCtx, scope: Map[String, Int], expr: Expr) -> Int {\\n  match expr {\\n    EInt(_) => 0,\\n    EFloat(_) => 0,\\n    EString(_) => 0,\\n    EBool(_) => 0,\\n    EUnit => 0,\\n    EStringInterp(_) => 0,\\n    EIdent(x, _) => pe_use(ctx, scope, x),\\n    ECall(callee, args, _) => {\\n      let is_index = match callee {\\n        EIdent(f, _) => is_borrow_arg0_call(f),\\n        _ => false\\n      }\\n      match callee {\\n        EIdent(_, _) => 0,\\n        _ => pc_emit(ctx, scope, callee)\\n      }\\n      let mut i = 0\\n      while i < Array::length(args) {\\n        let arg = Array::get(args, i)\\n        if is_index && i == 0 {\\n          match arg {\\n            EIdent(_, _) => 0,\\n            _ => pc_emit(ctx, scope, arg)\\n          }\\n        } else {\\n          pc_emit(ctx, scope, arg)\\n        }\\n        i = i + 1\\n      }\\n      0\\n    },\\n    EDot(obj, _field, _, _) => match obj {\\n      EIdent(_, _) => 0,\\n      _ => pc_emit(ctx, scope, obj)\\n    }\\n    ,\\n    ELet(name, value, body, _) => {\\n      match value {\\n        EIdent(src, _) => {\\n          if Map::has_key(scope, src) {\\n            let sid = Map::get(scope, src)\\n            let rem = Array::get(ctx.remaining, sid)\\n            if rem > 1 && !Array::get(ctx.scalar, sid) {\\n              pe_push(ctx, PaAliasDup, name)\\n            } else {\\n              0\\n            }\\n            if rem > 0 {\\n              Array::set(ctx.remaining, sid, rem - 1)\\n            }\\n          } else {\\n            ()\\n          }\\n          0\\n        },\\n        _ => pc_emit(ctx, scope, value)\\n      }\\n      let id = pe_declare(ctx, name)\\n      pc_emit(ctx, Map::set(scope, name, id), body)\\n      pe_scope_end(ctx, id, name)\\n    },\\n    ELetMut(name, value, body, _) => {\\n      pc_emit(ctx, scope, value)\\n      let id = pe_declare(ctx, name)\\n      pc_emit(ctx, Map::set(scope, name, id), body)\\n      pe_scope_end(ctx, id, name)\\n    },\\n    ELetRec(name, value, body) => {\\n      let id = pe_declare(ctx, name)\\n      let s2 = Map::set(scope, name, id)\\n      pc_emit(ctx, s2, value)\\n      pc_emit(ctx, s2, body)\\n      pe_scope_end(ctx, id, name)\\n    },\\n    EAssign(_name, value, body) => {\\n      pc_emit(ctx, scope, value)\\n      pc_emit(ctx, scope, body)\\n    },\\n    EAssignOp(_op, _name, value, body) => {\\n      pc_emit(ctx, scope, value)\\n      pc_emit(ctx, scope, body)\\n    },\\n    ESeq(a, b) => {\\n      pc_emit(ctx, scope, a)\\n      let nm = next_seq_name(ctx)\\n      let id = pe_declare(ctx, nm)\\n      pc_emit(ctx, scope, b)\\n      pe_scope_end(ctx, id, nm)\\n    },\\n    EBinOp(_op, l, r) => {\\n      pc_emit(ctx, scope, l)\\n      pc_emit(ctx, scope, r)\\n    },\\n    EUnaryOp(_op, e) => pc_emit(ctx, scope, e),\\n    ETuple(items) => {\\n      let mut i = 0\\n      while i < Array::length(items) {\\n        pc_emit(ctx, scope, Array::get(items, i))\\n        i = i + 1\\n      }\\n      0\\n    },\\n    EArray(items) => {\\n      let mut i = 0\\n      while i < Array::length(items) {\\n        pc_emit(ctx, scope, Array::get(items, i))\\n        i = i + 1\\n      }\\n      0\\n    },\\n    ERecord(_, fields, _) => {\\n      let mut i = 0\\n      while i < Array::length(fields) {\\n        pc_emit(ctx, scope, (Array::get(fields, i)).1)\\n        i = i + 1\\n      }\\n      0\\n    },\\n    EMap(fields) => {\\n      let mut i = 0\\n      while i < Array::length(fields) {\\n        pc_emit(ctx, scope, (Array::get(fields, i)).1)\\n        i = i + 1\\n      }\\n      0\\n    },\\n    EIf(cond, then_e, else_e) => {\\n      pc_emit(ctx, scope, cond)\\n      let snap = copy_ints(ctx.remaining)\\n      pc_emit(ctx, scope, then_e)\\n      let then_rem = copy_ints(ctx.remaining)\\n      restore_prefix(ctx.remaining, snap)\\n      pc_emit(ctx, scope, else_e)\\n      // #705: leave the MIN remaining over both branches. A binding consumed in\\n      // one branch (e.g. a param threaded into a ctor in the `then`) but not the\\n      // other was previously left at the `else` branch's (higher) remaining, so\\n      // the scope-end drop fired on a value the taken branch already moved out —\\n      // a double free. Min means a binding consumed on ANY path is not\\n      // re-dropped (the non-consuming path leaks one ref, which is safe) instead\\n      // of the consuming path double-freeing (crash). Prefix-only (outer ids).\\n      let mut i = 0\\n      while i < Array::length(snap) {\\n        if Array::get(then_rem, i) < Array::get(ctx.remaining, i) {\\n          Array::set(ctx.remaining, i, Array::get(then_rem, i))\\n        } else {\\n          ()\\n        }\\n        i = i + 1\\n      }\\n      0\\n    },\\n    EWhile(cond, body) => {\\n      pc_emit(ctx, scope, cond)\\n      pc_emit(ctx, scope, body)\\n    },\\n    EReturn(e) => pc_emit(ctx, scope, e),\\n    ESpread(e) => pc_emit(ctx, scope, e),\\n    ELabeledArg(_l, _n, e) => pc_emit(ctx, scope, e),\\n    EBreak(opt) => match opt {\\n      Some(e) => pc_emit(ctx, scope, e),\\n      None => 0\\n    }\\n    ,\\n    EFn(_tp, _tb, params, _ret, _eff, fbody) => {\\n      let caps = collect_free_vars(fbody, fn_param_names(params), [\\n      ])\\n      let mut i = 0\\n      while i < Array::length(caps) {\\n        pe_use(ctx, scope, Array::get(caps, i))\\n        i = i + 1\\n      }\\n      0\\n    },\\n    EForIn(value_name, index_opt, iterable, fbody) => {\\n      pc_emit(ctx, scope, iterable)\\n      let idv = pe_declare(ctx, value_name)\\n      let s2 = Map::set(scope, value_name, idv)\\n      let s3 = match index_opt {\\n        Some(idx) => {\\n          let idi = pe_declare(ctx, idx)\\n          Map::set(s2, idx, idi)\\n        },\\n        None => s2\\n      }\\n      pc_emit(ctx, s3, fbody)\\n      pe_scope_end(ctx, idv, value_name)\\n    },\\n    ELoop(params, lbody) => {\\n      let mut s = scope\\n      let pids: Array[Int] = [\\n      ]\\n      let pnames: Array[String] = [\\n      ]\\n      let mut i = 0\\n      while i < Array::length(params) {\\n        let p = Array::get(params, i)\\n        pc_emit(ctx, scope, p.1)\\n        let pid = pe_declare(ctx, p.0)\\n        s = Map::set(s, p.0, pid)\\n        Array::push(pids, pid)\\n        Array::push(pnames, p.0)\\n        i = i + 1\\n      }\\n      pc_emit(ctx, s, lbody)\\n      let mut j = 0\\n      while j < Array::length(pids) {\\n        pe_scope_end(ctx, Array::get(pids, j), Array::get(pnames, j))\\n        j = j + 1\\n      }\\n      0\\n    },\\n    EMatch(scrut, arms) => {\\n      match scrut {\\n        EIdent(_, _) => 0,\\n        _ => pc_emit(ctx, scope, scrut)\\n      }\\n      let snap = copy_ints(ctx.remaining)\\n      // #705: track the MIN remaining over all arms (see EIf). An arm that\\n      // consumes an outer binding (e.g. a param re-stored into a ctor) leaves it\\n      // at a lower remaining; leaving the LAST arm's (higher) value made the\\n      // scope-end drop double-free that binding on the arm that consumed it.\\n      let minrem = copy_ints(snap)\\n      let mut a = 0\\n      while a < Array::length(arms) {\\n        let arm = Array::get(arms, a)\\n        restore_prefix(ctx.remaining, snap)\\n        let pnames: Array[String] = [\\n        ]\\n        pat_names(arm.0, pnames)\\n        let mut s = scope\\n        let pids: Array[Int] = [\\n        ]\\n        let mut k = 0\\n        while k < Array::length(pnames) {\\n          let nm = Array::get(pnames, k)\\n          let pid = pe_declare(ctx, nm)\\n          s = Map::set(s, nm, pid)\\n          Array::push(pids, pid)\\n          k = k + 1\\n        }\\n        pc_emit(ctx, s, arm.1)\\n        let mut j = 0\\n        while j < Array::length(pids) {\\n          pe_scope_end(ctx, Array::get(pids, j), Array::get(pnames, j))\\n          j = j + 1\\n        }\\n        let mut mi = 0\\n        while mi < Array::length(snap) {\\n          if Array::get(ctx.remaining, mi) < Array::get(minrem, mi) {\\n            Array::set(minrem, mi, Array::get(ctx.remaining, mi))\\n          } else {\\n            ()\\n          }\\n          mi = mi + 1\\n        }\\n        a = a + 1\\n      }\\n      restore_prefix(ctx.remaining, minrem)\\n      0\\n    },\\n    EHandle(hbody, arms) => {\\n      let snap = copy_ints(ctx.remaining)\\n      pc_emit(ctx, scope, hbody)\\n      let minrem = copy_ints(ctx.remaining)\\n      let mut a = 0\\n      while a < Array::length(arms) {\\n        let arm = Array::get(arms, a)\\n        restore_prefix(ctx.remaining, snap)\\n        let pnames: Array[String] = [\\n        ]\\n        pat_names(arm.0, pnames)\\n        let mut s = scope\\n        let pids: Array[Int] = [\\n        ]\\n        let mut k = 0\\n        while k < Array::length(pnames) {\\n          let nm = Array::get(pnames, k)\\n          let pid = pe_declare(ctx, nm)\\n          s = Map::set(s, nm, pid)\\n          Array::push(pids, pid)\\n          k = k + 1\\n        }\\n        pc_emit(ctx, s, arm.1)\\n        let mut j = 0\\n        while j < Array::length(pids) {\\n          pe_scope_end(ctx, Array::get(pids, j), Array::get(pnames, j))\\n          j = j + 1\\n        }\\n        let mut mi = 0\\n        while mi < Array::length(snap) {\\n          if Array::get(ctx.remaining, mi) < Array::get(minrem, mi) {\\n            Array::set(minrem, mi, Array::get(ctx.remaining, mi))\\n          } else {\\n            ()\\n          }\\n          mi = mi + 1\\n        }\\n        a = a + 1\\n      }\\n      restore_prefix(ctx.remaining, minrem)\\n      0\\n    },\\n    _ => 0\\n  }\\n}\\n\\nexport fn pc_count(ctx: PCtx, scope: Map[String, Int], expr: Expr) -> Int {\\n  match expr {\\n    EInt(_) => 0,\\n    EFloat(_) => 0,\\n    EString(_) => 0,\\n    EBool(_) => 0,\\n    EUnit => 0,\\n    EStringInterp(_) => 0,\\n    EIdent(x, _) => pc_count_use(ctx, scope, x),\\n    ECall(callee, args, _) => {\\n      match callee {\\n        EIdent(f, _) => if is_borrow_arg0_call(f) {\\n          0\\n        } else {\\n          pc_count_borrow(ctx, scope, f)\\n        }\\n        ,\\n        _ => pc_count(ctx, scope, callee)\\n      }\\n      let is_index = match callee {\\n        EIdent(f, _) => is_borrow_arg0_call(f),\\n        _ => false\\n      }\\n      let mut i = 0\\n      while i < Array::length(args) {\\n        let arg = Array::get(args, i)\\n        if is_index && i == 0 {\\n          match arg {\\n            EIdent(obj, _) => pc_count_borrow(ctx, scope, obj),\\n            _ => pc_count(ctx, scope, arg)\\n          }\\n        } else {\\n          pc_count(ctx, scope, arg)\\n        }\\n        i = i + 1\\n      }\\n      0\\n    },\\n    EDot(obj, _field, _, _) => match obj {\\n      EIdent(x, _) => pc_count_borrow(ctx, scope, x),\\n      _ => pc_count(ctx, scope, obj)\\n    }\\n    ,\\n    ELet(name, value, body, _) => {\\n      pc_count(ctx, scope, value)\\n      let id = pc_declare(ctx, name, is_scalar_expr(ctx, value))\\n      pc_count(ctx, Map::set(scope, name, id), body)\\n    },\\n    ELetMut(name, value, body, _) => {\\n      pc_count(ctx, scope, value)\\n      let id = pc_declare(ctx, name, is_scalar_expr(ctx, value))\\n      pc_count(ctx, Map::set(scope, name, id), body)\\n    },\\n    ELetRec(name, value, body) => {\\n      let id = pc_declare(ctx, name, false)\\n      let s2 = Map::set(scope, name, id)\\n      pc_count(ctx, s2, value)\\n      pc_count(ctx, s2, body)\\n    },\\n    EAssign(_name, value, body) => {\\n      pc_count(ctx, scope, value)\\n      pc_count(ctx, scope, body)\\n    },\\n    EAssignOp(_op, _name, value, body) => {\\n      pc_count(ctx, scope, value)\\n      pc_count(ctx, scope, body)\\n    },\\n    ESeq(a, b) => {\\n      pc_count(ctx, scope, a)\\n      let nm = next_seq_name(ctx)\\n      let _id = pc_declare(ctx, nm, is_scalar_expr(ctx, a))\\n      pc_count(ctx, scope, b)\\n    },\\n    EBinOp(_op, l, r) => {\\n      pc_count(ctx, scope, l)\\n      pc_count(ctx, scope, r)\\n    },\\n    EUnaryOp(_op, e) => pc_count(ctx, scope, e),\\n    ETuple(items) => {\\n      let mut i = 0\\n      while i < Array::length(items) {\\n        pc_count(ctx, scope, Array::get(items, i))\\n        i = i + 1\\n      }\\n      0\\n    },\\n    EArray(items) => {\\n      let mut i = 0\\n      while i < Array::length(items) {\\n        pc_count(ctx, scope, Array::get(items, i))\\n        i = i + 1\\n      }\\n      0\\n    },\\n    ERecord(_, fields, _) => {\\n      let mut i = 0\\n      while i < Array::length(fields) {\\n        pc_count(ctx, scope, (Array::get(fields, i)).1)\\n        i = i + 1\\n      }\\n      0\\n    },\\n    EMap(fields) => {\\n      let mut i = 0\\n      while i < Array::length(fields) {\\n        pc_count(ctx, scope, (Array::get(fields, i)).1)\\n        i = i + 1\\n      }\\n      0\\n    },\\n    EIf(cond, then_e, else_e) => {\\n      pc_count(ctx, scope, cond)\\n      let snap_u = copy_ints(ctx.uses)\\n      let snap_b = copy_ints(ctx.borrows)\\n      pc_count(ctx, scope, then_e)\\n      let then_u = copy_ints(ctx.uses)\\n      let then_b = copy_ints(ctx.borrows)\\n      restore_prefix(ctx.uses, snap_u)\\n      restore_prefix(ctx.borrows, snap_b)\\n      pc_count(ctx, scope, else_e)\\n      let mut id = 0\\n      while id < Array::length(snap_u) {\\n        let base_u = Array::get(snap_u, id)\\n        let dt = Array::get(then_u, id) - base_u\\n        let de = Array::get(ctx.uses, id) - base_u\\n        Array::set(ctx.uses, id, base_u + int_max(dt, de))\\n        let base_b = Array::get(snap_b, id)\\n        let dtb = Array::get(then_b, id) - base_b\\n        let deb = Array::get(ctx.borrows, id) - base_b\\n        Array::set(ctx.borrows, id, base_b + int_max(dtb, deb))\\n        id = id + 1\\n      }\\n      0\\n    },\\n    EWhile(cond, body) => {\\n      pc_count(ctx, scope, cond)\\n      pc_count(ctx, scope, body)\\n    },\\n    EReturn(e) => pc_count(ctx, scope, e),\\n    ESpread(e) => pc_count(ctx, scope, e),\\n    ELabeledArg(_l, _n, e) => pc_count(ctx, scope, e),\\n    EBreak(opt) => match opt {\\n      Some(e) => pc_count(ctx, scope, e),\\n      None => 0\\n    }\\n    ,\\n    EFn(_tp, _tb, params, _ret, _eff, fbody) => {\\n      let caps = collect_free_vars(fbody, fn_param_names(params), [\\n      ])\\n      let mut i = 0\\n      while i < Array::length(caps) {\\n        pc_count_use(ctx, scope, Array::get(caps, i))\\n        i = i + 1\\n      }\\n      0\\n    },\\n    EForIn(value_name, index_opt, iterable, fbody) => {\\n      pc_count(ctx, scope, iterable)\\n      let idv = pc_declare(ctx, value_name, false)\\n      let s2 = Map::set(scope, value_name, idv)\\n      let s3 = match index_opt {\\n        Some(idx) => {\\n          let idi = pc_declare(ctx, idx, true)\\n          Map::set(s2, idx, idi)\\n        },\\n        None => s2\\n      }\\n      pc_count(ctx, s3, fbody)\\n    },\\n    ELoop(params, lbody) => {\\n      let mut s = scope\\n      let mut i = 0\\n      while i < Array::length(params) {\\n        let p = Array::get(params, i)\\n        pc_count(ctx, scope, p.1)\\n        let pid = pc_declare(ctx, p.0, is_scalar_expr(ctx, p.1))\\n        s = Map::set(s, p.0, pid)\\n        i = i + 1\\n      }\\n      pc_count(ctx, s, lbody)\\n    },\\n    EMatch(scrut, arms) => {\\n      match scrut {\\n        EIdent(sx, _) => pc_count_borrow(ctx, scope, sx),\\n        _ => pc_count(ctx, scope, scrut)\\n      }\\n      let snap_u = copy_ints(ctx.uses)\\n      let snap_b = copy_ints(ctx.borrows)\\n      let max_u = zeros(Array::length(snap_u))\\n      let max_b = zeros(Array::length(snap_b))\\n      let mut a = 0\\n      while a < Array::length(arms) {\\n        let arm = Array::get(arms, a)\\n        restore_prefix(ctx.uses, snap_u)\\n        restore_prefix(ctx.borrows, snap_b)\\n        let pnames: Array[String] = [\\n        ]\\n        pat_names(arm.0, pnames)\\n        let mut s = scope\\n        let mut k = 0\\n        while k < Array::length(pnames) {\\n          let nm = Array::get(pnames, k)\\n          let pid = pc_declare(ctx, nm, false)\\n          s = Map::set(s, nm, pid)\\n          k = k + 1\\n        }\\n        pc_count(ctx, s, arm.1)\\n        let mut id = 0\\n        while id < Array::length(snap_u) {\\n          let du = Array::get(ctx.uses, id) - Array::get(snap_u, id)\\n          if du > Array::get(max_u, id) {\\n            Array::set(max_u, id, du)\\n          }\\n          let db = Array::get(ctx.borrows, id) - Array::get(snap_b, id)\\n          if db > Array::get(max_b, id) {\\n            Array::set(max_b, id, db)\\n          }\\n          id = id + 1\\n        }\\n        a = a + 1\\n      }\\n      restore_prefix(ctx.uses, snap_u)\\n      restore_prefix(ctx.borrows, snap_b)\\n      let mut id2 = 0\\n      while id2 < Array::length(snap_u) {\\n        Array::set(ctx.uses, id2, Array::get(snap_u, id2) + Array::get(max_u, id2))\\n        Array::set(ctx.borrows, id2, Array::get(snap_b, id2) + Array::get(max_b, id2))\\n        id2 = id2 + 1\\n      }\\n      0\\n    },\\n    EHandle(hbody, arms) => {\\n      let snap_u = copy_ints(ctx.uses)\\n      let snap_b = copy_ints(ctx.borrows)\\n      let max_u = zeros(Array::length(snap_u))\\n      let max_b = zeros(Array::length(snap_b))\\n      pc_count(ctx, scope, hbody)\\n      let mut id0 = 0\\n      while id0 < Array::length(snap_u) {\\n        let du = Array::get(ctx.uses, id0) - Array::get(snap_u, id0)\\n        if du > Array::get(max_u, id0) {\\n          Array::set(max_u, id0, du)\\n        }\\n        let db = Array::get(ctx.borrows, id0) - Array::get(snap_b, id0)\\n        if db > Array::get(max_b, id0) {\\n          Array::set(max_b, id0, db)\\n        }\\n        id0 = id0 + 1\\n      }\\n      let mut a = 0\\n      while a < Array::length(arms) {\\n        let arm = Array::get(arms, a)\\n        restore_prefix(ctx.uses, snap_u)\\n        restore_prefix(ctx.borrows, snap_b)\\n        let pnames: Array[String] = [\\n        ]\\n        pat_names(arm.0, pnames)\\n        let mut s = scope\\n        let mut k = 0\\n        while k < Array::length(pnames) {\\n          let nm = Array::get(pnames, k)\\n          let pid = pc_declare(ctx, nm, false)\\n          s = Map::set(s, nm, pid)\\n          k = k + 1\\n        }\\n        pc_count(ctx, s, arm.1)\\n        let mut id = 0\\n        while id < Array::length(snap_u) {\\n          let du = Array::get(ctx.uses, id) - Array::get(snap_u, id)\\n          if du > Array::get(max_u, id) {\\n            Array::set(max_u, id, du)\\n          }\\n          let db = Array::get(ctx.borrows, id) - Array::get(snap_b, id)\\n          if db > Array::get(max_b, id) {\\n            Array::set(max_b, id, db)\\n          }\\n          id = id + 1\\n        }\\n        a = a + 1\\n      }\\n      restore_prefix(ctx.uses, snap_u)\\n      restore_prefix(ctx.borrows, snap_b)\\n      let mut id2 = 0\\n      while id2 < Array::length(snap_u) {\\n        Array::set(ctx.uses, id2, Array::get(snap_u, id2) + Array::get(max_u, id2))\\n        Array::set(ctx.borrows, id2, Array::get(snap_b, id2) + Array::get(max_b, id2))\\n        id2 = id2 + 1\\n      }\\n      0\\n    },\\n    _ => 0\\n  }\\n}\\n\\n// #706 follow-up (borrow-after-move): a binding with any BORROW occurrence\\n// (ctx.borrows[id] > 0 — computed branch-aware, max-across-if/match-arms,\\n// alongside ctx.uses above) must stay alive through that borrow, regardless of\\n// whether the borrow comes BEFORE or AFTER the binding's owning (consuming)\\n// occurrences. `pc_emit`/`pe_use` only track OWNING occurrences (ctx.uses) when\\n// deciding dup vs. free-transfer — borrows are invisible to that decision. If a\\n// binding's textually LAST owning occurrence is treated as \\\"the final, free\\n// consume\\\" (no dup; ownership transfers to the callee) and a borrow occurs\\n// AFTER that point, the borrow reads through a reference the callee may already\\n// have dropped — a silent use-after-free. This was masked in practice by other\\n// RC leaks (loop-consume before #706's core fix; the loop-consume LEAK before\\n// its own follow-up fix) that happened to keep the value alive by accident; see\\n// #706 for the wat_exports/parse_module_sections repro that exposed it once\\n// those leaks were tightened.\\n//\\n// Fix: bump the binding's counted `uses` by exactly one whenever it has ANY\\n// borrow occurrence. This is a pure post-processing step over the FINAL,\\n// branch-merge-complete `uses`/`borrows` arrays (called after `pc_count`\\n// finishes, before the emission pass begins), so it does not interact with the\\n// max-across-branches counting logic itself — it only adjusts the total input\\n// the REST of the system (pe_declare's `remaining` init, pc_emit's sequential\\n// dup decisions, pe_scope_end's drop decision) already handles correctly for \\\"K\\n// owning occurrences\\\": with K bumped to K+1, the occurrence that used to be a\\n// free-transfer gets a dup like any other, and the binding's normal scope-end\\n// drop (already emitted whenever `remaining` ends > 0 — e.g. the existing\\n// borrow-only / K=0 baseline) picks up the now-nonzero leftover. No new\\n// PerceusAction kind, no change to pc_emit or the codegen dup/drop realization.\\n// For a binding with ZERO owning occurrences (pure borrow — the already-correct\\n// baseline), this is a no-op: pe_declare already treats uses==0 like uses==1.\\nfn pctx_apply_borrow_retention(ctx: PCtx) -> Int {\\n  let mut bid = 0\\n  while bid < ctx.next_id {\\n    if Array::get(ctx.borrows, bid) > 0 {\\n      Array::set(ctx.uses, bid, Array::get(ctx.uses, bid) + 1)\\n    } else {\\n      ()\\n    }\\n    bid = bid + 1\\n  }\\n  0\\n}\\n\\n// Build the dup/drop plan for a function body expression.\\nexport fn build_perceus_plan(body: Expr) -> Array[PerceusAction] {\\n  let ctx = pctx_new()\\n  let empty: Map[String, Int] = Map::new()\\n  pc_count(ctx, empty, body)\\n  pctx_apply_borrow_retention(ctx)\\n  ctx.next_id = 0\\n  ctx.seq_id = 0\\n  pc_emit(ctx, empty, body)\\n  ctx.actions\\n}\\n\\nfn collect_heap_ret_fns(stmts: Array[Stmt]) -> Array[String] {\\n  let out: Array[String] = [\\n  ]\\n  let mut i = 0\\n  while i < Array::length(stmts) {\\n    match Array::get(stmts, i) {\\n      SLet(_, _, fname, oty, _) =>\\n      match oty {\\n        Some(ty) =>\\n        match ty {\\n          TyFn(_, ret, _) =>\\n          if type_expr_is_heap(Some(ret)) {\\n            Array::push(out, fname)\\n          } else {\\n            ()\\n          },\\n          _ => ()\\n        },\\n        None => ()\\n      },\\n      _ => ()\\n    }\\n    i = i + 1\\n  }\\n  out\\n}\\n\\nexport fn elaborate_heap_params(stmts: Array[Stmt]) -> Array[Stmt] {\\n  let hctx = HeapInferCtx::{\\n    ctors: collect_ctor_names(stmts),\\n    heap_fns: collect_heap_ret_fns(stmts),\\n  }\\n  let out = Array::slice(stmts, 0, 0)\\n  let mut i = 0\\n  while i < Array::length(stmts) {\\n    let s = Array::get(stmts, i)\\n    let s2 = match s {\\n      SLet(a, b, n, t, e) => SLet(a, b, n, t, elaborate_rw(e, hctx)),\\n      SExpr(e) => SExpr(elaborate_rw(e, hctx)),\\n      _ => s\\n    }\\n    Array::push(out, s2)\\n    i = i + 1\\n  }\\n  out\\n}\\n\\nfn expr_projects_or_matches(name: String, e: Expr) -> Bool {\\n  match e {\\n    EDot(obj, _, _, _) =>\\n    match obj {\\n      EIdent(n, _) => n == name,\\n      _ => expr_projects_or_matches(name, obj)\\n    },\\n    EMatch(scrut, arms) => {\\n      let hit = match scrut {\\n        EIdent(n, _) => n == name,\\n        _ => expr_projects_or_matches(name, scrut)\\n      }\\n      if hit {\\n        true\\n      } else {\\n        let mut i = 0\\n        let mut found = false\\n        while i < Array::length(arms) {\\n          let (_, arm_body) = Array::get(arms, i)\\n          if expr_projects_or_matches(name, arm_body) {\\n            found = true\\n          } else {\\n            ()\\n          }\\n          i = i + 1\\n        }\\n        found\\n      }\\n    },\\n    EHandle(body, arms) => {\\n      let mut i = 0\\n      let mut found = expr_projects_or_matches(name, body)\\n      while i < Array::length(arms) {\\n        let (_, arm_body) = Array::get(arms, i)\\n        if expr_projects_or_matches(name, arm_body) {\\n          found = true\\n        } else {\\n          ()\\n        }\\n        i = i + 1\\n      }\\n      found\\n    },\\n    ELet(_, val, body, _) =>\\n    expr_projects_or_matches(name, val) || expr_projects_or_matches(name, body),\\n    ELetRec(_, val, body) =>\\n    expr_projects_or_matches(name, val) || expr_projects_or_matches(name, body),\\n    ELetMut(_, val, body, _) =>\\n    expr_projects_or_matches(name, val) || expr_projects_or_matches(name, body),\\n    EAssign(_, val, cont) =>\\n    expr_projects_or_matches(name, val) || expr_projects_or_matches(name, cont),\\n    EAssignOp(_, _, val, cont) =>\\n    expr_projects_or_matches(name, val) || expr_projects_or_matches(name, cont),\\n    ESeq(a, b) =>\\n    expr_projects_or_matches(name, a) || expr_projects_or_matches(name, b),\\n    EIf(c, t, el) =>\\n    expr_projects_or_matches(name, c) ||\\n    expr_projects_or_matches(name, t) ||\\n    expr_projects_or_matches(name, el),\\n    EWhile(c, b) =>\\n    expr_projects_or_matches(name, c) || expr_projects_or_matches(name, b),\\n    EForIn(_, _, iter, body) =>\\n    expr_projects_or_matches(name, iter) || expr_projects_or_matches(name, body),\\n    ECall(callee, args, _) => {\\n      let mut i = 0\\n      let mut found = expr_projects_or_matches(name, callee)\\n      while i < Array::length(args) {\\n        if expr_projects_or_matches(name, Array::get(args, i)) {\\n          found = true\\n        } else {\\n          ()\\n        }\\n        i = i + 1\\n      }\\n      found\\n    },\\n    EBinOp(_, l, r) =>\\n    expr_projects_or_matches(name, l) || expr_projects_or_matches(name, r),\\n    EUnaryOp(_, o) => expr_projects_or_matches(name, o),\\n    EFn(_, _, _, _, _, body) => expr_projects_or_matches(name, body),\\n    ETuple(elems) => {\\n      let mut i = 0\\n      let mut found = false\\n      while i < Array::length(elems) {\\n        if expr_projects_or_matches(name, Array::get(elems, i)) {\\n          found = true\\n        } else {\\n          ()\\n        }\\n        i = i + 1\\n      }\\n      found\\n    },\\n    EArray(elems) => {\\n      let mut i = 0\\n      let mut found = false\\n      while i < Array::length(elems) {\\n        if expr_projects_or_matches(name, Array::get(elems, i)) {\\n          found = true\\n        } else {\\n          ()\\n        }\\n        i = i + 1\\n      }\\n      found\\n    },\\n    ELoop(params, body) => {\\n      let mut i = 0\\n      let mut found = expr_projects_or_matches(name, body)\\n      while i < Array::length(params) {\\n        let (_, init) = Array::get(params, i)\\n        if expr_projects_or_matches(name, init) {\\n          found = true\\n        } else {\\n          ()\\n        }\\n        i = i + 1\\n      }\\n      found\\n    },\\n    ERecord(_, fields, _) => {\\n      let mut i = 0\\n      let mut found = false\\n      while i < Array::length(fields) {\\n        let (_, fval) = Array::get(fields, i)\\n        if expr_projects_or_matches(name, fval) {\\n          found = true\\n        } else {\\n          ()\\n        }\\n        i = i + 1\\n      }\\n      found\\n    },\\n    EMap(fields) => {\\n      let mut i = 0\\n      let mut found = false\\n      while i < Array::length(fields) {\\n        let (_, fval) = Array::get(fields, i)\\n        if expr_projects_or_matches(name, fval) {\\n          found = true\\n        } else {\\n          ()\\n        }\\n        i = i + 1\\n      }\\n      found\\n    },\\n    ELabeledArg(_, _, inner) => expr_projects_or_matches(name, inner),\\n    EReturn(inner) => expr_projects_or_matches(name, inner),\\n    ESpread(inner) => expr_projects_or_matches(name, inner),\\n    EBreak(opt) =>\\n    match opt {\\n      Some(inner) => expr_projects_or_matches(name, inner),\\n      None => false\\n    },\\n    EContinue(args) => {\\n      let mut i = 0\\n      let mut found = false\\n      while i < Array::length(args) {\\n        if expr_projects_or_matches(name, Array::get(args, i)) {\\n          found = true\\n        } else {\\n          ()\\n        }\\n        i = i + 1\\n      }\\n      found\\n    },\\n    EInt(_) => false,\\n    EFloat(_) => false,\\n    EString(_) => false,\\n    EBool(_) => false,\\n    EIdent(_, _) => false,\\n    EStringInterp(_) => false,\\n    EUnit => false\\n  }\\n}\\n\\n// Heap-ness decision for an owned parameter: the type annotation says heap, or\\n// (when unannotated) the body proves it via projection/match. Used by the\\n// Perceus plan and codegen so an unannotated nested-closure param that is\\n// projected no longer leaks its owned argument (ADR-0055 Stage 4).\\nexport fn param_is_heap_in_body(name: String, otype: Option[TypeExpr], body: Expr) -> Bool {\\n  if type_expr_is_heap(otype) {\\n    true\\n  } else {\\n    match otype {\\n      None => expr_projects_or_matches(name, body),\\n      Some(_) => false\\n    }\\n  }\\n}\\n\\n// Build the plan for a function whose parameters are owned heap values. Params\\n// are declared as bindings (in count + emit lockstep, same ids) so the existing\\n// machinery emits a PaDrop for a borrowed-only/unused heap param and a PaDup for\\n// one used in multiple owning positions. Heap-ness comes from the param's type\\n// annotation (scalar params get scalar=true so they are never dropped).\\nexport fn build_perceus_plan_with_params(params: Array[(String, Option[TypeExpr])], body: Expr, borrow_ret_names: Array[String]) -> Array[PerceusAction] {\\n  let ctx = pctx_new()\\n  // #707: seed the borrow-returning-function-name set (see is_borrow_ret_fname)\\n  // directly into pctx_names, bypassing pc_declare -- these markers are never\\n  // looked up by id, only linearly searched by content, so being out of step\\n  // with ctx.next_id / uses / scalar / etc. is harmless.\\n  let mut bri = 0\\n  while bri < Array::length(borrow_ret_names) {\\n    Array::push(ctx.pctx_names, String::concat(borrow_ret_marker, Array::get(borrow_ret_names, bri)))\\n    bri = bri + 1\\n  }\\n  let mut scope: Map[String, Int] = Map::new()\\n  let mut pi = 0\\n  while pi < Array::length(params) {\\n    let (pname, ptype) = Array::get(params, pi)\\n    let id = pc_declare(ctx, pname, !param_is_heap_in_body(pname, ptype, body))\\n    scope = Map::set(scope, pname, id)\\n    pi = pi + 1\\n  }\\n  pc_count(ctx, scope, body)\\n  pctx_apply_borrow_retention(ctx)\\n  ctx.next_id = 0\\n  ctx.seq_id = 0\\n  let mut scope2: Map[String, Int] = Map::new()\\n  let param_ids = Array::slice([\\n    0\\n  ], 0, 0)\\n  let mut pj = 0\\n  while pj < Array::length(params) {\\n    let (pname, _) = Array::get(params, pj)\\n    let id = pe_declare(ctx, pname)\\n    scope2 = Map::set(scope2, pname, id)\\n    Array::push(param_ids, id)\\n    pj = pj + 1\\n  }\\n  pc_emit(ctx, scope2, body)\\n  let mut pk = 0\\n  while pk < Array::length(params) {\\n    let (pname, _) = Array::get(params, pk)\\n    pe_scope_end(ctx, Array::get(param_ids, pk), pname)\\n    pk = pk + 1\\n  }\\n  ctx.actions\\n}\\n\")\n}\n\nlet cli_adapter_source_70 = () -> (String, String) {\n  (\"lib/@vibe/compiler/codegen/expr/index.vibe\",\n\"export ./core.vibe {\\n  compile_expr, compile_module_expr\\n}\\n\")\n}\n\nlet cli_adapter_source_71 = () -> (String, String) {\n  (\"lib/@vibe/compiler/codegen/expr/compile_match.vibe\",\n\"//# Imports\\n\\nimport ../../core {\\n  Expr, Pat, Stmt, TypeExpr, bytebuf_length, bytebuf_new, bytebuf_push, bytebuf_push_section, bytebuf_push_vec_header, bytebuf_to_bytes, leb128_encode_s64, leb128_encode_u32\\n}\\n\\nimport ../common_analysis {\\n  collect_free_vars, collect_strings_stmts, emit_closure_call_tail, emit_closure_resolve, emit_i64_extend_i32_u, is_mut_captured_in, md_consume_count\\n}\\n\\nimport ../common_base {\\n  CompileCtx, CtorTable, FuncTable, LambdaTable, StrTable, emit_rc_dup_guarded, cov_emit_branch, emit_binop_op, emit_i32_eq, emit_i32_eqz, emit_i32_ge_u, emit_i32_mul, emit_i32_ne, emit_i32_sub, emit_i64_load, emit_i64_store, emit_str_ref, expr_tag, agg_log_reset_above2, int_log_reset_above, get_ebinop_op, get_efn_body, get_eif_cond, get_eif_else, get_eif_then, get_elet_body, get_elet_name, get_elet_val, get_slet_expr, get_slet_name, is_efn, is_eident, is_etuple, is_pbind, is_pbool, is_pctor, is_pfloat, is_pint, is_pstring, is_ptuple, is_pwild, is_slet, ctor_table_index_of, resolve_func, resolve_local, emit_unbox_float\\n}\\n\\nimport ../common_extractors {\\n  array_contains_str, emit_assignop_op, emit_memory_copy, find_catchall_idx, get_earray_elems, get_eassign_body, get_eassign_name, get_eassign_val, get_eassignop_body, get_eassignop_name, get_eassignop_op, get_eassignop_val, get_ebinop_lhs, get_ebinop_rhs, get_ebool_value, get_ecall_args, get_ecall_callee, get_efloat_value, get_efn_params, get_eforin_body, get_eforin_iter, get_eforin_name, get_eident_name, get_eint_value, get_eletmut_body, get_eletmut_name, get_eletmut_val, get_eletrec_body, get_eletrec_name, get_eletrec_val, get_eseq_first, get_eseq_second, get_estring_value, get_etuple_elems, get_eunaryop_expr, get_eunaryop_op, get_ewhile_body, get_ewhile_cond, get_match_arms, get_match_scrutinee, get_pbind_name, get_pbool_value, get_pctor_args, get_pctor_name, get_pfloat_value, get_pint_value, get_pstring_value, get_ptuple_pats, get_slet_export, str_table_lookup\\n}\\n\\nimport ../wasm_emit {\\n  emit_block_i64, emit_block_void, emit_br, emit_br_if, emit_call, emit_call_indirect, emit_code_section, emit_code_section_with_locals, emit_data_section, emit_data_section_multi, emit_drop, emit_element_section_active, emit_else, emit_end, emit_export_section, emit_export_section_multi, emit_exports_full, emit_exports_with_memory, emit_f64_add, emit_f64_const_bits, emit_f64_const_lohi, emit_f64_convert_i64_s, emit_f64_div, emit_f64_eq, emit_f64_ge, emit_f64_gt, emit_f64_le, emit_f64_lt, emit_f64_mul, emit_f64_ne, emit_f64_neg, emit_f64_reinterpret_i64, emit_f64_sub, emit_func_type_raw, emit_function_section, emit_global_get, emit_global_section_i32_mut, emit_global_set, emit_header, emit_i32_add, emit_i32_const, emit_i32_load, emit_i32_load8_u, emit_i32_store, emit_i32_store8, emit_i32_wrap_i64, emit_i64_add, emit_i64_and, emit_i64_const, emit_i64_div_s, emit_i64_eq, emit_i64_eqz, emit_i64_extend_i32_s, emit_i64_ge_s, emit_i64_gt_s, emit_i64_le_s, emit_i64_lt_s, emit_i64_mul, emit_i64_ne, emit_i64_or, emit_i64_reinterpret_f64, emit_i64_rem_s, emit_i64_shl, emit_i64_shr_s, emit_i64_sub, emit_i64_trunc_f64_s, emit_i64_xor, emit_if_i64, emit_if_void, emit_import_section_func, emit_local_get, emit_local_set, emit_local_tee, emit_loop_void, emit_memory_section, emit_name, emit_return, emit_table_section_funcref, emit_type_section, emit_type_section_multi, string_to_data\\n}\\n\\n//# Functions\\n\\n// #613 follow-up: bind every `PBind` reachable under a container pattern\\n// (tuple or constructor) at ANY nesting depth, skipping literal / wildcard\\n// sub-patterns. `base_local` holds the (possibly tagged) pointer to the\\n// container whose fields hold the sub-pattern values. `is_ctor_layout`\\n// selects the field layout: a constructor stores its tag at offset 0 and\\n// fields at `8 + i*8` with the pointer always tag-cleared; a tuple stores\\n// fields at `8 + i*8` (RC, tagged) or `i*8` (non-RC, untagged). Used for\\n// conditional match arms whose top pattern is a bare tuple with literal\\n// siblings (`(false, n) => ..`), where the binding pass previously emitted\\n// nothing and any use of `n` trapped codegen with \\\"undefined variable\\\".\\n\\n// Emit `n` guarded rc_dups of `local_idx` (one per owning consume of a matched\\n// field; see md_consume_count). n<=0 emits nothing.\\nfn emit_rc_dup_guarded_n(buf: Bytes, local_idx: Int, n: Int, rc_shadow: Bool) -> Unit {\\n  let mut k = 0\\n  while k < n {\\n    emit_rc_dup_guarded(buf, local_idx, rc_shadow)\\n    k = k + 1\\n  }\\n}\\n\\nfn bind_match_pat(buf: Bytes, base_local: Int, container_pat: Pat, is_ctor_layout: Bool, local_names: Array[String], ctx: CompileCtx, body: Expr) -> Unit {\\n  let elems = if is_ctor_layout {\\n    get_pctor_args(container_pat)\\n  } else {\\n    get_ptuple_pats(container_pat)\\n  }\\n  let mut i = 0\\n  while i < Array::length(elems) {\\n    let ep = Array::get(elems, i)\\n    let off = if is_ctor_layout {\\n      8 + i * 8\\n    } else if ctx.enable_rc {\\n      8 + i * 8\\n    } else {\\n      i * 8\\n    }\\n    let clear_tag = is_ctor_layout || ctx.enable_rc\\n    if is_pbind(ep) {\\n      let nm = get_pbind_name(ep)\\n      let fl = Array::length(local_names)\\n      emit_local_get(buf, base_local)\\n      if clear_tag {\\n        emit_i64_const(buf, -2)\\n        emit_i64_and(buf)\\n      } else {\\n        ()\\n      }\\n      emit_i32_wrap_i64(buf)\\n      emit_i64_load(buf, 3, off)\\n      emit_local_set(buf, fl)\\n      // #715 follow-up: this helper previously bound the field without ever\\n      // dup'ing it, regardless of how many owning uses `nm` has in `body` — a\\n      // matched field is a borrowed view sharing the container's refcount\\n      // (see #702/#705 at the inline call sites in `compile_match`), so an\\n      // owning consume plus the container's own recursive drop double-frees\\n      // the same block. Mirror the inline sites' guarded per-consume dup.\\n      if ctx.enable_rc {\\n        emit_rc_dup_guarded_n(buf, fl, md_consume_count(body, nm), ctx.rc_shadow)\\n      } else {\\n        ()\\n      }\\n      Array::push(local_names, nm)\\n    } else if is_ptuple(ep) {\\n      let sl = Array::length(local_names)\\n      emit_local_get(buf, base_local)\\n      if clear_tag {\\n        emit_i64_const(buf, -2)\\n        emit_i64_and(buf)\\n      } else {\\n        ()\\n      }\\n      emit_i32_wrap_i64(buf)\\n      emit_i64_load(buf, 3, off)\\n      emit_local_set(buf, sl)\\n      Array::push(local_names, \\\"__bind_sub\\\")\\n      bind_match_pat(buf, sl, ep, false, local_names, ctx, body)\\n    } else if is_pctor(ep) {\\n      let sl = Array::length(local_names)\\n      emit_local_get(buf, base_local)\\n      if clear_tag {\\n        emit_i64_const(buf, -2)\\n        emit_i64_and(buf)\\n      } else {\\n        ()\\n      }\\n      emit_i32_wrap_i64(buf)\\n      emit_i64_load(buf, 3, off)\\n      emit_local_set(buf, sl)\\n      Array::push(local_names, \\\"__bind_sub\\\")\\n      bind_match_pat(buf, sl, ep, true, local_names, ctx, body)\\n    } else {\\n      ()\\n    }\\n    i = i + 1\\n  }\\n}\\n\\n// The index of `field` WITHIN the struct named `sname`. A struct value lays its\\n// fields out exactly like a constructor — tag/header at 0, field i at `8 + i*8`,\\n// pointer tag-cleared — so the offset is `8 + index*8`, identical to what\\n// `obj.field` reads. The matched struct name MUST drive the lookup: two structs\\n// can share a field name at different positions (`A { x; y }` vs `B { y; x }`),\\n// so a name-agnostic \\\"first struct that declares the field\\\" scan binds the wrong\\n// offset. Only when `sname` is not in the table do we fall back to that scan.\\nfn find_struct_index(ctx: CompileCtx, sname: String) -> Int {\\n  let names = ctx.ctor_table.struct_names\\n  let mut si = 0\\n  let mut sidx = -1\\n  while si < Array::length(names) {\\n    if Array::get(names, si) == sname {\\n      sidx = si\\n      si = Array::length(names)\\n    } else {\\n      si = si + 1\\n    }\\n  }\\n  sidx\\n}\\n\\nfn field_index_in(fnames: Array[String], field: String) -> Int {\\n  let mut fi = 0\\n  let mut found = -1\\n  while fi < Array::length(fnames) {\\n    if Array::get(fnames, fi) == field {\\n      found = fi\\n      fi = Array::length(fnames)\\n    } else {\\n      fi = fi + 1\\n    }\\n  }\\n  found\\n}\\n\\nfn struct_field_index(ctx: CompileCtx, sname: String, field: String) -> Int with { Error } {\\n  let sidx = find_struct_index(ctx, sname)\\n  if sidx >= 0 {\\n    let found = field_index_in(Array::get(ctx.ctor_table.struct_field_names, sidx), field)\\n    if found < 0 {\\n      throw(String::concat(String::concat(String::concat(\\\"unknown field `\\\", field), \\\"` in struct \\\"), sname))\\n    } else {\\n      found\\n    }\\n  } else {\\n    // `sname` not found in the struct table: fall back to the legacy global\\n    // first-match scan so unqualified / synthetic names still resolve.\\n    let names = ctx.ctor_table.struct_names\\n    let mut gsi = 0\\n    let mut gfound = -1\\n    while gsi < Array::length(names) {\\n      let f = field_index_in(Array::get(ctx.ctor_table.struct_field_names, gsi), field)\\n      if f >= 0 {\\n        gfound = f\\n        gsi = Array::length(names)\\n      } else {\\n        gsi = gsi + 1\\n      }\\n    }\\n    if gfound < 0 {\\n      throw(String::concat(\\\"unknown struct field in pattern: \\\", field))\\n    } else {\\n      gfound\\n    }\\n  }\\n}\\n\\n// Bind every variable in a struct pattern `S::{ f1: p1, f2: p2, ... }` whose\\n// value is the (tagged) struct pointer in `base_local`. Each field is loaded by\\n// NAME (offset `8 + struct_field_index*8`), then its sub-pattern is bound:\\n// a `PBind` becomes a local; a tuple/constructor sub-pattern recurses through\\n// the positional `bind_match_pat`; a nested struct recurses here. Literal /\\n// wildcard sub-patterns bind nothing (a struct pattern with a literal field is\\n// refutable and is not routed here — see `is_catchall_pat`).\\nfn bind_struct_pat(buf: Bytes, base_local: Int, sname: String, fields: Array[(String, Pat)], local_names: Array[String], ctx: CompileCtx, body: Expr) -> Unit with { Error } {\\n  let mut i = 0\\n  while i < Array::length(fields) {\\n    let (fname, subpat) = Array::get(fields, i)\\n    let off = 8 + struct_field_index(ctx, sname, fname) * 8\\n    if is_pbind(subpat) {\\n      let nm = get_pbind_name(subpat)\\n      let fl = Array::length(local_names)\\n      emit_local_get(buf, base_local)\\n      emit_i64_const(buf, -2)\\n      emit_i64_and(buf)\\n      emit_i32_wrap_i64(buf)\\n      emit_i64_load(buf, 3, off)\\n      emit_local_set(buf, fl)\\n      // #715 follow-up: same missing-dup gap as `bind_match_pat` above, for an\\n      // irrefutable struct-pattern field.\\n      if ctx.enable_rc {\\n        emit_rc_dup_guarded_n(buf, fl, md_consume_count(body, nm), ctx.rc_shadow)\\n      } else {\\n        ()\\n      }\\n      Array::push(local_names, nm)\\n    } else if is_ptuple(subpat) {\\n      let sl = Array::length(local_names)\\n      emit_local_get(buf, base_local)\\n      emit_i64_const(buf, -2)\\n      emit_i64_and(buf)\\n      emit_i32_wrap_i64(buf)\\n      emit_i64_load(buf, 3, off)\\n      emit_local_set(buf, sl)\\n      Array::push(local_names, \\\"__bind_sub\\\")\\n      bind_match_pat(buf, sl, subpat, false, local_names, ctx, body)\\n    } else if is_pctor(subpat) {\\n      let sl = Array::length(local_names)\\n      emit_local_get(buf, base_local)\\n      emit_i64_const(buf, -2)\\n      emit_i64_and(buf)\\n      emit_i32_wrap_i64(buf)\\n      emit_i64_load(buf, 3, off)\\n      emit_local_set(buf, sl)\\n      Array::push(local_names, \\\"__bind_sub\\\")\\n      bind_match_pat(buf, sl, subpat, true, local_names, ctx, body)\\n    } else {\\n      match subpat {\\n        PStruct(__sname, sfields) => {\\n          let sl = Array::length(local_names)\\n          emit_local_get(buf, base_local)\\n          emit_i64_const(buf, -2)\\n          emit_i64_and(buf)\\n          emit_i32_wrap_i64(buf)\\n          emit_i64_load(buf, 3, off)\\n          emit_local_set(buf, sl)\\n          Array::push(local_names, \\\"__bind_sub\\\")\\n          bind_struct_pat(buf, sl, __sname, sfields, local_names, ctx, body)\\n        },\\n        _ => ()\\n      }\\n    }\\n    i = i + 1\\n  }\\n}\\n\\nexport fn compile_match(buf: Bytes, expr: Expr, local_names: Array[String], next_local: Int, ctx: CompileCtx, ld: Int, ce: (Bytes, Expr, Array[String], Int, CompileCtx, Int) -> Int with { Error }) -> Int with { Error } {\\n  let __match_scrutinee = get_match_scrutinee(expr)\\n  let __match_arms = get_match_arms(expr)\\n  let scrut_local = next_local\\n  Array::push(local_names, \\\"__match_scrut\\\")\\n  let nl1 = ce(buf, __match_scrutinee, local_names, next_local + 1, ctx, ld)\\n  emit_local_set(buf, scrut_local)\\n  let num_arms = Array::length(__match_arms)\\n  let catchall_idx = find_catchall_idx(__match_arms)\\n  let num_cond_arms = catchall_idx\\n  let mut ai = 0\\n  let mut max_nl = nl1\\n  let names_len_at_match = Array::length(local_names)\\n  // #965 review (#984): ref_cell_names is name-keyed. An arm's captured\\n  // `let mut n` stayed registered as a ref cell after the local_names\\n  // truncate below, so a LATER arm's `n` resolved to the outer scalar slot\\n  // but was loaded through the ref-cell path (garbage in the bump lane; the\\n  // RC lane α-renames shadows first). Restore it with the same discipline.\\n  let ref_cells_at_match = Array::length(ctx.ref_cell_names)\\n  // #613 follow-up: discriminate literal sub-patterns at EVERY nesting level,\\n  // not just the top constructor-argument level. `load_field` is a thunk that\\n  // pushes the (tagged) value at this position. `emit_pat_test` emits a single\\n  // i32 boolean (\\\"does the value at this position match `sp`?\\\") with NO trailing\\n  // AND, recursing through ctor args, tuple elements, and or-branches. Without\\n  // recursing, `N(W(false), n)` matched `N(W(true), _)`, `T((false, n))` matched\\n  // `T((true, _))`, and or-branches `(1, _) | (2, _)` / `\\\"a\\\" | \\\"b\\\"` matched\\n  // anything — silent wrong results. Bindings/wildcards always match (push 1).\\n  let rec emit_pat_test: (Pat, () -> Unit) -> Unit = (sp, load_field) -> {\\n    match sp {\\n      POr(__l, __r) => {\\n        // (left matches) OR (right matches) at this same position.\\n        emit_pat_test(__l, load_field)\\n        emit_pat_test(__r, load_field)\\n        bytebuf_push(buf, 114)\\n      },\\n      _ => {\\n        if is_pfloat(sp) {\\n          // Bit-exact f64 compare: bump lane holds raw bits, RC lane a boxed\\n          // pointer (unbox first). f64.eq gives `==` semantics (0.0 == -0.0).\\n          load_field()\\n          if ctx.enable_rc {\\n            emit_unbox_float(buf)\\n          } else {\\n            ()\\n          }\\n          emit_f64_reinterpret_i64(buf)\\n          let __pfv = get_pfloat_value(sp)\\n          emit_f64_const_lohi(buf, Double::to_i64_bits_lo(__pfv), Double::to_i64_bits_hi(__pfv))\\n          emit_f64_eq(buf)\\n        } else if is_pint(sp) {\\n          load_field()\\n          emit_i64_const(buf, get_pint_value(sp))\\n          if ctx.enable_rc {\\n            emit_i64_const(buf, 1)\\n            emit_i64_shl(buf)\\n          }\\n          emit_i64_eq(buf)\\n        } else if is_pbool(sp) {\\n          load_field()\\n          emit_i64_const(buf, if get_pbool_value(sp) {\\n            1\\n          } else {\\n            0\\n          })\\n          if ctx.enable_rc {\\n            emit_i64_const(buf, 1)\\n            emit_i64_shl(buf)\\n          }\\n          emit_i64_eq(buf)\\n        } else if is_pstring(sp) {\\n          let __sv = get_pstring_value(sp)\\n          let __si = str_table_lookup(ctx.str_table.strs, __sv)\\n          if __si >= 0 {\\n            let (__seq_fi, _, _) = resolve_func(ctx.func_table, \\\"eq\\\")\\n            load_field()\\n            emit_str_ref(buf, Array::get(ctx.str_table.offsets, __si), Array::get(ctx.str_table.lengths, __si))\\n            emit_call(buf, __seq_fi)\\n            emit_i32_wrap_i64(buf)\\n          } else {\\n            // String literal absent from the table: conservatively match (the\\n            // prior behavior emitted no test at all).\\n            emit_i32_const(buf, 1)\\n          }\\n        } else if is_pctor(sp) {\\n          let __ncname = get_pctor_name(sp)\\n          let __nci = ctor_table_index_of(ctx.ctor_table, __ncname)\\n          let __ntag = if __nci >= 0 {\\n            Array::get(ctx.ctor_table.tags, __nci)\\n          } else {\\n            -1\\n          }\\n          load_field()\\n          emit_i64_const(buf, -2)\\n          emit_i64_and(buf)\\n          emit_i32_wrap_i64(buf)\\n          emit_i32_load(buf, 2, 0)\\n          emit_i32_const(buf, __ntag)\\n          emit_i32_eq(buf)\\n          let __nargs = get_pctor_args(sp)\\n          // #705: payload sub-tests must NOT run when the tag test above\\n          // failed. The value may be a different constructor (or a scalar)\\n          // whose slot at `8 + k*8` is not a valid value of this ctor's field\\n          // type; a nested tag test would dereference that garbage — a\\n          // data-dependent OOB that crashed the RC-built compiler's\\n          // check_expr / seed_var_types on `Some(TDEnum(..))`-style patterns.\\n          // Guard the sub-tests behind the tag test with `if (result i32)`\\n          // so the AND short-circuits. Binds/wildcards add no test.\\n          let mut __nany = false\\n          let mut __nj = 0\\n          while __nj < Array::length(__nargs) {\\n            let __np = Array::get(__nargs, __nj)\\n            if is_pbind(__np) || is_pwild(__np) {\\n              ()\\n            } else {\\n              __nany = true\\n            }\\n            __nj = __nj + 1\\n          }\\n          if __nany {\\n            bytebuf_push(buf, 4)\\n            bytebuf_push(buf, 127)\\n            emit_i32_const(buf, 1)\\n            let mut __nk = 0\\n            while __nk < Array::length(__nargs) {\\n              let __nkk = __nk\\n              let __np2 = Array::get(__nargs, __nkk)\\n              if is_pbind(__np2) || is_pwild(__np2) {\\n                ()\\n              } else {\\n                let __nload: () -> Unit = () -> {\\n                  load_field()\\n                  emit_i64_const(buf, -2)\\n                  emit_i64_and(buf)\\n                  emit_i32_wrap_i64(buf)\\n                  emit_i64_load(buf, 3, 8 + __nkk * 8)\\n                }\\n                emit_pat_test(__np2, __nload)\\n                bytebuf_push(buf, 113)\\n              }\\n              __nk = __nk + 1\\n            }\\n            emit_else(buf)\\n            emit_i32_const(buf, 0)\\n            emit_end(buf)\\n          } else {\\n            ()\\n          }\\n        } else if is_ptuple(sp) {\\n          emit_i32_const(buf, 1)\\n          let __tpats = get_ptuple_pats(sp)\\n          let mut __tk = 0\\n          while __tk < Array::length(__tpats) {\\n            let __tkk = __tk\\n            let __tload: () -> Unit = () -> {\\n              load_field()\\n              if ctx.enable_rc {\\n                emit_i64_const(buf, -2)\\n                emit_i64_and(buf)\\n              }\\n              emit_i32_wrap_i64(buf)\\n              emit_i64_load(buf, 3, if ctx.enable_rc {\\n                8 + __tkk * 8\\n              } else {\\n                __tkk * 8\\n              })\\n            }\\n            emit_pat_test(Array::get(__tpats, __tkk), __tload)\\n            bytebuf_push(buf, 113)\\n            __tk = __tk + 1\\n          }\\n        } else {\\n          // PBind / PWild: always matches.\\n          emit_i32_const(buf, 1)\\n        }\\n      }\\n    }\\n  }\\n  // AND a position's match test onto the accumulator already on the stack.\\n  // Bindings/wildcards add no constraint, so they emit nothing (keeping the\\n  // accumulator untouched) rather than `const 1; and`.\\n  let emit_sub_tests: (Pat, () -> Unit) -> Unit = (sp, load_field) -> {\\n    if is_pbind(sp) || is_pwild(sp) {\\n      ()\\n    } else {\\n      emit_pat_test(sp, load_field)\\n      bytebuf_push(buf, 113)\\n    }\\n  }\\n  while ai < num_cond_arms {\\n    Array::truncate(local_names, names_len_at_match)\\n    Array::truncate(ctx.ref_cell_names, ref_cells_at_match)\\n    // #678: a previous arm may have logged integral slots >= names_len_at_match\\n    // that this arm's pattern binders (non-`let`, so they log nothing) reuse;\\n    // drop them so a string bound there is not misread as int by `==`.\\n    int_log_reset_above(ctx, names_len_at_match)\\n    agg_log_reset_above2(ctx.agg_local_slots, ctx.agg_local_exprs, names_len_at_match)\\n    let (__cond_p, __arm_body) = Array::get(__match_arms, ai)\\n    let __cond_done = if is_pfloat(__cond_p) {\\n      // Top-level float literal arm (`match d { 0.0 => .. }`): same f64\\n      // compare as emit_pat_test's PFloat branch.\\n      emit_local_get(buf, scrut_local)\\n      if ctx.enable_rc {\\n        emit_unbox_float(buf)\\n      } else {\\n        ()\\n      }\\n      emit_f64_reinterpret_i64(buf)\\n      let __apfv = get_pfloat_value(__cond_p)\\n      emit_f64_const_lohi(buf, Double::to_i64_bits_lo(__apfv), Double::to_i64_bits_hi(__apfv))\\n      emit_f64_eq(buf)\\n      emit_if_i64(buf)\\n      0\\n    } else if is_pint(__cond_p) {\\n      emit_local_get(buf, scrut_local)\\n      emit_i64_const(buf, get_pint_value(__cond_p))\\n      // ADR-0055 Stage 1: scrutinee is a tagged int; tag the literal to match.\\n      if ctx.enable_rc {\\n        emit_i64_const(buf, 1)\\n        emit_i64_shl(buf)\\n      }\\n      emit_i64_eq(buf)\\n      emit_if_i64(buf)\\n      0\\n    } else {\\n      if is_pbool(__cond_p) {\\n        emit_local_get(buf, scrut_local)\\n        emit_i64_const(buf, if get_pbool_value(__cond_p) {\\n          if ctx.enable_rc { 2 } else { 1 }\\n        } else {\\n          0\\n        })\\n        emit_i64_eq(buf)\\n        emit_if_i64(buf)\\n        0\\n      } else {\\n        if is_pctor(__cond_p) {\\n          let cname_cond = get_pctor_name(__cond_p)\\n          let ctor_ci = ctor_table_index_of(ctx.ctor_table, cname_cond)\\n          let expected_tag = if ctor_ci >= 0 {\\n            Array::get(ctx.ctor_table.tags, ctor_ci)\\n          } else {\\n            -1\\n          }\\n          emit_local_get(buf, scrut_local)\\n          emit_i64_const(buf, -2)\\n          emit_i64_and(buf)\\n          emit_i32_wrap_i64(buf)\\n          emit_i32_load(buf, 2, 0)\\n          emit_i32_const(buf, expected_tag)\\n          emit_i32_eq(buf)\\n          // #603/#608/#613: the tag test alone is not enough — literal\\n          // sub-patterns must be checked at EVERY nesting level, else\\n          // `I(1)`/`I(\\\"x\\\")` match `I(2)`/`I(\\\"y\\\")`, nested `N(W(false),_)` matches\\n          // `N(W(true),_)`, and tuple `T((false,_))` matches `T((true,_))`. AND-in\\n          // a recursive field-vs-literal test per constructor argument. Bindings\\n          // and wildcards add no test. This bug silently broke\\n          // `match stmt { SEnum(false, ...) => ... }` in the compiler's own\\n          // namespace pass, mis-namespacing exported enums.\\n          let __cargs_cond = get_pctor_args(__cond_p)\\n          // #705: same short-circuit guard as `emit_pat_test` — payload\\n          // sub-tests only run when the arm's tag test matched, else a nested\\n          // tag test dereferences a slot that is not a valid tagged value.\\n          let mut __cany = false\\n          let mut __cj = 0\\n          while __cj < Array::length(__cargs_cond) {\\n            let __cp = Array::get(__cargs_cond, __cj)\\n            if is_pbind(__cp) || is_pwild(__cp) {\\n              ()\\n            } else {\\n              __cany = true\\n            }\\n            __cj = __cj + 1\\n          }\\n          if __cany {\\n            bytebuf_push(buf, 4)\\n            bytebuf_push(buf, 127)\\n            emit_i32_const(buf, 1)\\n            let mut __ck = 0\\n            while __ck < Array::length(__cargs_cond) {\\n              let __ckk = __ck\\n              let __cload: () -> Unit = () -> {\\n                emit_local_get(buf, scrut_local)\\n                emit_i64_const(buf, -2)\\n                emit_i64_and(buf)\\n                emit_i32_wrap_i64(buf)\\n                emit_i64_load(buf, 3, 8 + __ckk * 8)\\n              }\\n              emit_sub_tests(Array::get(__cargs_cond, __ckk), __cload)\\n              __ck = __ck + 1\\n            }\\n            emit_else(buf)\\n            emit_i32_const(buf, 0)\\n            emit_end(buf)\\n          } else {\\n            ()\\n          }\\n          emit_if_i64(buf)\\n          0\\n        } else {\\n          if is_pstring(__cond_p) {\\n            let sval = get_pstring_value(__cond_p)\\n            let str_idx = str_table_lookup(ctx.str_table.strs, sval)\\n            if str_idx >= 0 {\\n              let (str_eq_fi, _, _) = resolve_func(ctx.func_table, \\\"eq\\\")\\n              emit_local_get(buf, scrut_local)\\n              emit_str_ref(buf, Array::get(ctx.str_table.offsets, str_idx), Array::get(ctx.str_table.lengths, str_idx))\\n              emit_call(buf, str_eq_fi)\\n              emit_i32_wrap_i64(buf)\\n              emit_if_i64(buf)\\n            }\\n            0\\n          } else if is_ptuple(__cond_p) {\\n            // A bare tuple cond pattern (`(false, n) => ..`) has no tag to test;\\n            // previously it fell through to `emit_or_check`'s `_ => const 1`,\\n            // making the arm UNCONDITIONALLY match — `(false, n)` matched\\n            // `(true, 5)` (silent wrong result, the #613 unsoundness for bare\\n            // tuples). Start from a `true` accumulator and AND-in a recursive\\n            // field-vs-literal test for every literal element (binds/wildcards\\n            // add no test, so an all-bind tuple stays always-true).\\n            emit_i32_const(buf, 1)\\n            let __tpats_cond = get_ptuple_pats(__cond_p)\\n            let mut __tck = 0\\n            while __tck < Array::length(__tpats_cond) {\\n              let __tckk = __tck\\n              let __tcload: () -> Unit = () -> {\\n                emit_local_get(buf, scrut_local)\\n                if ctx.enable_rc {\\n                  emit_i64_const(buf, -2)\\n                  emit_i64_and(buf)\\n                } else {\\n                  ()\\n                }\\n                emit_i32_wrap_i64(buf)\\n                emit_i64_load(buf, 3, if ctx.enable_rc {\\n                  8 + __tckk * 8\\n                } else {\\n                  __tckk * 8\\n                })\\n              }\\n              emit_sub_tests(Array::get(__tpats_cond, __tckk), __tcload)\\n              __tck = __tck + 1\\n            }\\n            emit_if_i64(buf)\\n            0\\n          } else {\\n            let rec emit_or_check: (Pat) -> Unit = (pat) -> {\\n              match pat {\\n                POr(left, right) => {\\n                  emit_or_check(left)\\n                  emit_or_check(right)\\n                  bytebuf_push(buf, 114)\\n                },\\n                PInt(n) => {\\n                  emit_local_get(buf, scrut_local)\\n                  emit_i64_const(buf, n)\\n                  if ctx.enable_rc {\\n                    emit_i64_const(buf, 1)\\n                    emit_i64_shl(buf)\\n                  }\\n                  emit_i64_eq(buf)\\n                },\\n                PFloat(fv) => {\\n                  // A float or-branch (`0.0|180.0`) previously fell through to\\n                  // `_ => const 1` (always-true). Same f64 compare as\\n                  // emit_pat_test's PFloat branch.\\n                  emit_local_get(buf, scrut_local)\\n                  if ctx.enable_rc {\\n                    emit_unbox_float(buf)\\n                  } else {\\n                    ()\\n                  }\\n                  emit_f64_reinterpret_i64(buf)\\n                  emit_f64_const_lohi(buf, Double::to_i64_bits_lo(fv), Double::to_i64_bits_hi(fv))\\n                  emit_f64_eq(buf)\\n                },\\n                PCtor(cname, cargs) => {\\n                  let ci = ctor_table_index_of(ctx.ctor_table, cname)\\n                  let ctag = if ci >= 0 {\\n                    Array::get(ctx.ctor_table.tags, ci)\\n                  } else {\\n                    -1\\n                  }\\n                  emit_local_get(buf, scrut_local)\\n                  emit_i64_const(buf, -2)\\n                  emit_i64_and(buf)\\n                  emit_i32_wrap_i64(buf)\\n                  emit_i32_load(buf, 2, 0)\\n                  emit_i32_const(buf, ctag)\\n                  emit_i32_eq(buf)\\n                  if Array::length(cargs) == 1 {\\n                    match Array::get(cargs, 0) {\\n                      PInt(n) => {\\n                        emit_local_get(buf, scrut_local)\\n                        emit_i64_const(buf, -2)\\n                        emit_i64_and(buf)\\n                        emit_i32_wrap_i64(buf)\\n                        emit_i64_load(buf, 3, 8)\\n                        emit_i64_const(buf, n)\\n                        if ctx.enable_rc {\\n                          emit_i64_const(buf, 1)\\n                          emit_i64_shl(buf)\\n                        }\\n                        emit_i64_eq(buf)\\n                        bytebuf_push(buf, 113)\\n                      },\\n                      _ => ()\\n                    }\\n                  }\\n                },\\n                PBool(b) => {\\n                  // An or-branch boolean literal (`true | ..`) previously fell\\n                  // through to `_ => const 1` (always-true), so `\\\"a\\\"|\\\"b\\\"` /\\n                  // `(1,_)|(2,_)` / bool ors silently matched everything.\\n                  emit_local_get(buf, scrut_local)\\n                  emit_i64_const(buf, if b {\\n                    if ctx.enable_rc { 2 } else { 1 }\\n                  } else {\\n                    0\\n                  })\\n                  emit_i64_eq(buf)\\n                },\\n                PString(sv) => {\\n                  let __si = str_table_lookup(ctx.str_table.strs, sv)\\n                  if __si >= 0 {\\n                    let (__eqfi, _, _) = resolve_func(ctx.func_table, \\\"eq\\\")\\n                    emit_local_get(buf, scrut_local)\\n                    emit_str_ref(buf, Array::get(ctx.str_table.offsets, __si), Array::get(ctx.str_table.lengths, __si))\\n                    emit_call(buf, __eqfi)\\n                    emit_i32_wrap_i64(buf)\\n                  } else {\\n                    emit_i32_const(buf, 1)\\n                  }\\n                },\\n                PTuple(tpats) => {\\n                  // A tuple or-branch (`(1, _) | (2, _)`): no tag to test, so\\n                  // start from `true` and AND-in a field-vs-literal test for\\n                  // every literal element (binds/wildcards add none).\\n                  emit_i32_const(buf, 1)\\n                  let mut __ok = 0\\n                  while __ok < Array::length(tpats) {\\n                    let __okk = __ok\\n                    let __oload: () -> Unit = () -> {\\n                      emit_local_get(buf, scrut_local)\\n                      if ctx.enable_rc {\\n                        emit_i64_const(buf, -2)\\n                        emit_i64_and(buf)\\n                      } else {\\n                        ()\\n                      }\\n                      emit_i32_wrap_i64(buf)\\n                      emit_i64_load(buf, 3, if ctx.enable_rc {\\n                        8 + __okk * 8\\n                      } else {\\n                        __okk * 8\\n                      })\\n                    }\\n                    emit_sub_tests(Array::get(tpats, __okk), __oload)\\n                    __ok = __ok + 1\\n                  }\\n                },\\n                _ => emit_i32_const(buf, 1)\\n              }\\n            }\\n            emit_or_check(__cond_p)\\n            emit_if_i64(buf)\\n            0\\n          }\\n        }\\n      }\\n    }\\n    // #cov branch: this conditional arm was taken (start of the if-then block).\\n    cov_emit_branch(buf, ctx.cov)\\n    let ld_arm = if ld >= 0 {\\n      ld + ai + 1\\n    } else {\\n      -1\\n    }\\n    let arm_nl = if is_pctor(__cond_p) {\\n      // #703/#705: the #702 dup of a matched heap field must give the binding\\n      // ONE owned reference per owning consume in the arm body (see\\n      // bind_match_pat's md_consume_count note). Binding is delegated to the\\n      // recursive bind_match_pat so nested ctor/tuple sub-patterns bind at ANY\\n      // depth — the previous inline loop stopped at depth 2, so the `v` in\\n      // `Some(Some(Some(v)))` was never emitted and its use trapped codegen\\n      // (resolve_local fails). Discrimination already recurses (#603/#608).\\n      bind_match_pat(buf, scrut_local, __cond_p, true, local_names, ctx, __arm_body)\\n      ce(buf, __arm_body, local_names, Array::length(local_names), ctx, ld_arm)\\n    } else if is_ptuple(__cond_p) {\\n      // A bare tuple arm pattern with literal siblings (`(false, n) => ..`):\\n      // discrimination already tested the literals above, but the binding pass\\n      // emitted nothing here, so `n` was undefined. Load the scrutinee tuple\\n      // pointer and bind every reachable PBind (skipping literals/wildcards).\\n      let tup_ptr = Array::length(local_names)\\n      emit_local_get(buf, scrut_local)\\n      emit_local_set(buf, tup_ptr)\\n      Array::push(local_names, \\\"__cond_tup\\\")\\n      bind_match_pat(buf, tup_ptr, __cond_p, false, local_names, ctx, __arm_body)\\n      ce(buf, __arm_body, local_names, Array::length(local_names), ctx, ld_arm)\\n    } else {\\n      ce(buf, __arm_body, local_names, nl1, ctx, ld_arm)\\n    }\\n    if arm_nl > max_nl {\\n      max_nl = arm_nl\\n    }\\n    emit_else(buf)\\n    ai = ai + 1\\n  }\\n  Array::truncate(local_names, names_len_at_match)\\n  Array::truncate(ctx.ref_cell_names, ref_cells_at_match)\\n  // #678: same prune before the catch-all arm's pattern binders reuse the slots.\\n  int_log_reset_above(ctx, names_len_at_match)\\n  agg_log_reset_above2(ctx.agg_local_slots, ctx.agg_local_exprs, names_len_at_match)\\n  let ld_catch = if ld >= 0 {\\n    ld + num_cond_arms\\n  } else {\\n    -1\\n  }\\n  let catch_nl = if catchall_idx < num_arms {\\n    let __catch_arm = Array::get(__match_arms, catchall_idx)\\n    let (__catch_p, __catch_body) = __catch_arm\\n    0\\n    // #cov branch: the catch-all (none of the conditional arms matched). Only a\\n    // real decision point when there is at least one conditional arm.\\n    if num_cond_arms > 0 {\\n      cov_emit_branch(buf, ctx.cov)\\n    } else {\\n      ()\\n    }\\n    if is_pbind(__catch_p) {\\n      let bname = get_pbind_name(__catch_p)\\n      let bind_local = Array::length(local_names)\\n      emit_local_get(buf, scrut_local)\\n      emit_local_set(buf, bind_local)\\n      Array::push(local_names, bname)\\n      ce(buf, __catch_body, local_names, Array::length(local_names), ctx, ld_catch)\\n    } else {\\n      if is_pctor(__catch_p) {\\n        // #705 dup note as above; recursive bind_match_pat replaces the\\n        // depth-1 inline loop (same depth-3 gap as the cond arms).\\n        bind_match_pat(buf, scrut_local, __catch_p, true, local_names, ctx, __catch_body)\\n        ce(buf, __catch_body, local_names, Array::length(local_names), ctx, ld_catch)\\n      } else {\\n        if is_ptuple(__catch_p) {\\n          let ptr_local2 = Array::length(local_names)\\n          emit_local_get(buf, scrut_local)\\n          emit_local_set(buf, ptr_local2)\\n          Array::push(local_names, \\\"__tup_ptr2\\\")\\n          // Recursive bind (was a depth-2 inline loop; nested ctor elements\\n          // inside the tuple were never bound).\\n          bind_match_pat(buf, ptr_local2, __catch_p, false, local_names, ctx, __catch_body)\\n          ce(buf, __catch_body, local_names, Array::length(local_names), ctx, ld_catch)\\n        } else {\\n          match __catch_p {\\n            PStruct(__sname, __sfields) => {\\n              // An irrefutable struct pattern `S::{ x, y }` as the catch-all arm:\\n              // bind every field by name from the scrutinee struct pointer.\\n              let __sp_ptr = Array::length(local_names)\\n              emit_local_get(buf, scrut_local)\\n              emit_local_set(buf, __sp_ptr)\\n              Array::push(local_names, \\\"__struct_ptr\\\")\\n              bind_struct_pat(buf, __sp_ptr, __sname, __sfields, local_names, ctx, __catch_body)\\n              ce(buf, __catch_body, local_names, Array::length(local_names), ctx, ld_catch)\\n            },\\n            _ => ce(buf, __catch_body, local_names, Array::length(local_names), ctx, ld_catch)\\n          }\\n        }\\n      }\\n    }\\n  } else {\\n    bytebuf_push(buf, 0)\\n    0\\n  }\\n  if catch_nl > max_nl {\\n    max_nl = catch_nl\\n  }\\n  let mut ci2 = 0\\n  while ci2 < num_cond_arms {\\n    emit_end(buf)\\n    ci2 = ci2 + 1\\n  }\\n  while Array::length(local_names) < max_nl {\\n    Array::push(local_names, \\\"\\\")\\n  }\\n  max_nl\\n}\\n\")\n}\n\nlet cli_adapter_source_72 = () -> (String, String) {\n  (\"lib/@vibe/compiler/codegen/expr/compile_lambda.vibe\",\n\"//# Imports\\n\\nimport ../../core {\\n  Expr, Pat, Stmt, TypeExpr, bytebuf_length, bytebuf_new, bytebuf_push, bytebuf_push_section, bytebuf_push_vec_header, bytebuf_to_bytes, leb128_encode_s64, leb128_encode_u32\\n}\\n\\nimport ../../perceus {\\n  build_perceus_plan_with_params, pa_is_alias_dup, pa_is_drop, pa_is_dup, param_is_heap_in_body\\n}\\n\\nimport ../common_analysis {\\n  collect_free_vars, collect_free_vars_indexed, collect_free_vars_indexed_self, collect_strings_stmts, emit_closure_call_tail, emit_closure_resolve, emit_i64_extend_i32_u, is_mut_captured_in, md_consume_count, scope_tail_proj_root\\n}\\n\\nimport ../common_base {\\n  emit_rc_word_inc_saturating, CompileCtx, CtorTable, FuncTable, LambdaTable, StrTable, emit_rc_dup_guarded, emit_binop_op, emit_heap_grow_after_heap_set, emit_i32_eq, emit_i32_eqz, emit_i32_ge_u, emit_i32_mul, emit_i32_ne, emit_i32_sub, emit_i64_load, emit_i64_store, emit_str_ref, expr_tag, get_arm_body, get_arm_pat, get_ebinop_op, get_efn_body, get_eif_cond, get_eif_else, get_eif_then, get_elet