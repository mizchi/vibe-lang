_end(buf)\\n      // Under RC a scalar Int is tagged `n << 1` (low bit 0 marks a non-heap\\n      // value; see `Int::to_double` / `Double::to_int` which shift to/from this\\n      // form). Arithmetic stays in tagged space and compares correctly, but the\\n      // digit loop below renders the RAW i64 — so without untagging it prints\\n      // `2n` (e.g. 42 -> \\\"84\\\"). Recover the logical value with an arithmetic\\n      // (sign-preserving) shift right by 1. Strings already returned above via\\n      // the `br`, so this only touches the integer path.\\n      if ctx.enable_rc {\\n        emit_local_get(buf, val_l)\\n        emit_i64_const(buf, 1)\\n        emit_i64_shr_s(buf)\\n        emit_local_set(buf, val_l)\\n      }\\n      emit_i64_const(buf, 46)\\n      emit_local_set(buf, cur_l)\\n      emit_local_get(buf, val_l)\\n      emit_i64_const(buf, 0)\\n      emit_i64_lt_s(buf)\\n      emit_i64_extend_i32_s(buf)\\n      emit_local_set(buf, neg_l)\\n      emit_local_get(buf, val_l)\\n      emit_i64_const(buf, 0)\\n      emit_i64_lt_s(buf)\\n      emit_if_i64(buf)\\n      emit_i64_const(buf, 0)\\n      emit_local_get(buf, val_l)\\n      emit_i64_sub(buf)\\n      emit_else(buf)\\n      emit_local_get(buf, val_l)\\n      emit_end(buf)\\n      emit_local_set(buf, abs_l)\\n      emit_local_get(buf, abs_l)\\n      emit_i64_eqz(buf)\\n      emit_if_void(buf)\\n      emit_local_get(buf, cur_l)\\n      emit_i32_wrap_i64(buf)\\n      emit_i32_const(buf, 48)\\n      emit_i32_store8(buf, 0, 0)\\n      emit_local_get(buf, cur_l)\\n      emit_i64_const(buf, 1)\\n      emit_i64_sub(buf)\\n      emit_local_set(buf, cur_l)\\n      emit_end(buf)\\n      emit_block_void(buf)\\n      emit_loop_void(buf)\\n      emit_local_get(buf, abs_l)\\n      emit_i64_eqz(buf)\\n      emit_br_if(buf, 1)\\n      emit_local_get(buf, cur_l)\\n      emit_i32_wrap_i64(buf)\\n      emit_local_get(buf, abs_l)\\n      emit_i64_const(buf, 10)\\n      emit_i64_rem_s(buf)\\n      emit_i32_wrap_i64(buf)\\n      emit_i32_const(buf, 48)\\n      emit_i32_add(buf)\\n      emit_i32_store8(buf, 0, 0)\\n      emit_local_get(buf, cur_l)\\n      emit_i64_const(buf, 1)\\n      emit_i64_sub(buf)\\n      emit_local_set(buf, cur_l)\\n      emit_local_get(buf, abs_l)\\n      emit_i64_const(buf, 10)\\n      emit_i64_div_s(buf)\\n      emit_local_set(buf, abs_l)\\n      emit_br(buf, 0)\\n      emit_end(buf)\\n      emit_end(buf)\\n      emit_local_get(buf, neg_l)\\n      emit_i32_wrap_i64(buf)\\n      emit_if_void(buf)\\n      emit_local_get(buf, cur_l)\\n      emit_i32_wrap_i64(buf)\\n      emit_i32_const(buf, 45)\\n      emit_i32_store8(buf, 0, 0)\\n      emit_local_get(buf, cur_l)\\n      emit_i64_const(buf, 1)\\n      emit_i64_sub(buf)\\n      emit_local_set(buf, cur_l)\\n      emit_end(buf)\\n      emit_global_get(buf, 0)\\n      emit_i64_extend_i32_u(buf)\\n      emit_local_set(buf, hp_l)\\n      emit_i64_const(buf, 46)\\n      emit_local_get(buf, cur_l)\\n      emit_i64_sub(buf)\\n      emit_local_set(buf, len_l)\\n      // Bump the heap pointer and run the grow check BEFORE the memory.copy\\n      // into the fresh allocation. The copy used to come first, which traps\\n      // with \\\"memory access out of bounds\\\" whenever the previous allocation\\n      // left global 0 within `len` bytes of the current memory end (the grow\\n      // check only guarantees the heap pointer itself is addressable, not a\\n      // full page of headroom). Hit in practice by large multi-module FS\\n      // compiles (#533 measurement: ~200-file cold-cache walk).\\n      emit_local_get(buf, hp_l)\\n      emit_i32_wrap_i64(buf)\\n      emit_local_get(buf, len_l)\\n      emit_i32_wrap_i64(buf)\\n      emit_i32_const(buf, 7)\\n      emit_i32_add(buf)\\n      emit_i32_const(buf, -8)\\n      bytebuf_push(buf, 113)\\n      emit_i32_add(buf)\\n      emit_global_set(buf, 0)\\n      emit_heap_grow_after_heap_set(buf, ctx)\\n      emit_local_get(buf, hp_l)\\n      emit_i32_wrap_i64(buf)\\n      emit_local_get(buf, cur_l)\\n      emit_i64_const(buf, 1)\\n      emit_i64_add(buf)\\n      emit_i32_wrap_i64(buf)\\n      emit_local_get(buf, len_l)\\n      emit_i32_wrap_i64(buf)\\n      emit_memory_copy(buf)\\n      emit_local_get(buf, hp_l)\\n      emit_i64_const(buf, 32)\\n      emit_i64_shl(buf)\\n      emit_local_get(buf, len_l)\\n      emit_i64_or(buf)\\n      emit_end(buf)\\n      nl + 6\\n    }\\n    else if fname == \\\"Double::to_int\\\" || fname == \\\"Float::to_int\\\" {\\n      // #997: `i64.trunc_f64_s` TRAPS (an unhandled wasm trap, not a\\n      // catchable vibe `Error`) on NaN, +-Infinity, or any magnitude\\n      // outside the i64 range -- this is the inline lowering for a direct\\n      // `Double::to_int(...)` call, which is the COMMON case and bypasses\\n      // the builtin-body function table entirely (see\\n      // gen_double_to_int_body / gc_gen_double_to_int_body for the\\n      // indirect-call / first-class-value path, which carries the\\n      // identical guard). No feature flag on this wasm target makes\\n      // `i64.trunc_sat_f64_s` available, so NaN and out-of-i64-range\\n      // values saturate to 0 by hand instead of trunc'ing at all.\\n      let nl = ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)\\n      if ctx.enable_rc {\\n        emit_unbox_float(buf)\\n      }\\n      let val_l = nl\\n      Array::push(local_names, \\\"__d2i_val\\\")\\n      emit_local_set(buf, val_l)\\n      // NaN: x != x is only true for NaN.\\n      emit_local_get(buf, val_l)\\n      emit_f64_reinterpret_i64(buf)\\n      emit_local_get(buf, val_l)\\n      emit_f64_reinterpret_i64(buf)\\n      emit_f64_ne(buf)\\n      emit_if_i64(buf)\\n      emit_i64_const(buf, 0)\\n      emit_else(buf)\\n      // Upper bound: trunc_f64_s is defined for x < 2^63.\\n      emit_local_get(buf, val_l)\\n      emit_f64_reinterpret_i64(buf)\\n      emit_f64_const_lohi(buf, 0, 1138753536)\\n      emit_f64_lt(buf)\\n      emit_if_i64(buf)\\n      // Lower bound