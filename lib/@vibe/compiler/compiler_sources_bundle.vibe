let source_45 = () -> (String, String) {
  ("lib/@vibe/compiler/checker/builtins_string2.vibe",
"\nimport @vibe/compiler/core {\n  Type\n}\n\nimport @vibe/core {\n  array_empty\n}\n\n\nfn string2_no_params() -> Array[Type] {\n  array_empty()\n}\n\nfn string2_one_param(a: Type) -> Array[Type] {\n  let arr = string2_no_params()\n  Array::push(arr, a)\n  arr\n}\n\nfn string2_two_params(a: Type, b: Type) -> Array[Type] {\n  let arr = string2_no_params()\n  Array::push(arr, a)\n  Array::push(arr, b)\n  arr\n}\n\nfn lookup_string_trim(name: String) -> Option[Type] {\n  if name == \"String::trim\" {\n    Some(CtFn(string2_one_param(CtString), CtString, None))\n  }\n  else None\n}\n\nfn lookup_string_split(name: String) -> Option[Type] {\n  if name == \"String::split\" {\n    Some(CtFn(string2_two_params(CtString, CtString), CtArray(CtString), None))\n  }\n  else None\n}\n\nfn lookup_string_contains(name: String) -> Option[Type] {\n  if name == \"String::contains\" {\n    Some(CtFn(string2_two_params(CtString, CtString), CtBool, None))\n  }\n  else None\n}\n\nfn lookup_string_index_of(name: String) -> Option[Type] {\n  if name == \"String::index_of\" {\n    Some(CtFn(string2_two_params(CtString, CtString), CtInt, None))\n  }\n  else None\n}\n\nfn lookup_string_to_lower(name: String) -> Option[Type] {\n  if name == \"String::to_lower\" {\n    Some(CtFn(string2_one_param(CtString), CtString, None))\n  }\n  else None\n}\n\nfn lookup_string_to_upper(name: String) -> Option[Type] {\n  if name == \"String::to_upper\" {\n    Some(CtFn(string2_one_param(CtString), CtString, None))\n  }\n  else None\n}\n\nfn lookup_string_group_c(name: String) -> Option[Type] {\n  match lookup_string_trim(name) {\n    Some(t) => Some(t),\n    None => match lookup_string_to_upper(name) {\n      Some(t) => Some(t),\n      None => lookup_string_to_lower(name)\n    }\n  }\n}\n\nfn lookup_string_ends_with(name: String) -> Option[Type] {\n  if name == \"String::ends_with\" {\n    Some(CtFn(string2_two_params(CtString, CtString), CtBool, None))\n  }\n  else None\n}\n\nfn lookup_string_starts_with(name: String) -> Option[Type] {\n  if name == \"String::starts_with\" {\n    Some(CtFn(string2_two_params(CtString, CtString), CtBool, None))\n  }\n  else None\n}\n\nfn lookup_string2_group_a(name: String) -> Option[Type] {\n  match lookup_string_index_of(name) {\n    Some(t) => Some(t),\n    None => match lookup_string_contains(name) {\n      Some(t) => Some(t),\n      None => match lookup_string_starts_with(name) {\n        Some(t) => Some(t),\n        None => lookup_string_ends_with(name)\n      }\n    }\n  }\n}\n\nfn lookup_string_char_code_at(name: String) -> Option[Type] {\n  if name == \"String::char_code_at\" {\n    Some(CtFn(string2_two_params(CtString, CtInt), CtInt, None))\n  }\n  else None\n}\n\nfn lookup_string_last_index_of(name: String) -> Option[Type] {\n  if name == \"String::last_index_of\" {\n    Some(CtFn(string2_two_params(CtString, CtString), CtInt, None))\n  }\n  else None\n}\n\nfn lookup_string_from_char_code(name: String) -> Option[Type] {\n  if name == \"String::from_char_code\" {\n    Some(CtFn(string2_one_param(CtInt), CtString, None))\n  }\n  else None\n}\n\nfn lookup_string2_group_b(name: String) -> Option[Type] {\n  match lookup_string_from_char_code(name) {\n    Some(t) => Some(t),\n    None => match lookup_string_char_code_at(name) {\n      Some(t) => Some(t),\n      None => match lookup_string_last_index_of(name) {\n        Some(t) => Some(t),\n        None => lookup_string_split(name)\n      }\n    }\n  }\n}\n\nexport fn lookup_string2(name: String) -> Option[Type] {\n  match lookup_string2_group_a(name) {\n    Some(t) => Some(t),\n    None => match lookup_string2_group_b(name) {\n      Some(t) => Some(t),\n      None => lookup_string_group_c(name)\n    }\n  }\n}\n")
}

let source_46 = () -> (String, String) {
  ("lib/@vibe/compiler/checker/builtins_builders.vibe",
"\nimport @vibe/compiler/core {\n  Type\n}\n\nimport @vibe/core {\n  array_empty\n}\n\n\nfn builders_no_params() -> Array[Type] {\n  array_empty()\n}\n\nfn builders_one_param(a: Type) -> Array[Type] {\n  let arr = builders_no_params()\n  Array::push(arr, a)\n  arr\n}\n\nfn builders_two_params(a: Type, b: Type) -> Array[Type] {\n  let arr = builders_no_params()\n  Array::push(arr, a)\n  Array::push(arr, b)\n  arr\n}\n\nfn lookup_array_builder_new(name: String) -> Option[Type] {\n  if name == \"ArrayBuilder::new\" {\n    Some(CtFn(builders_no_params(), CtUnknown, None))\n  }\n  else None\n}\n\nfn lookup_array_builder_push(name: String) -> Option[Type] {\n  if name == \"ArrayBuilder::push\" {\n    Some(CtFn(builders_two_params(CtUnknown, CtUnknown), CtUnit, None))\n  }\n  else None\n}\n\nfn lookup_string_builder_new(name: String) -> Option[Type] {\n  if name == \"StringBuilder::new\" {\n    Some(CtFn(builders_no_params(), CtUnknown, None))\n  }\n  else None\n}\n\nfn lookup_string_builder_push(name: String) -> Option[Type] {\n  if name == \"StringBuilder::push\" {\n    Some(CtFn(builders_two_params(CtUnknown, CtString), CtUnit, None))\n  }\n  else None\n}\n\nfn lookup_array_builder_freeze(name: String) -> Option[Type] {\n  if name == \"ArrayBuilder::freeze\" {\n    Some(CtFn(builders_one_param(CtUnknown), CtArray(CtUnknown), None))\n  }\n  else None\n}\n\nexport fn lookup_array_builder(name: String) -> Option[Type] {\n  match lookup_array_builder_new(name) {\n    Some(t) => Some(t),\n    None => match lookup_array_builder_push(name) {\n      Some(t) => Some(t),\n      None => lookup_array_builder_freeze(name)\n    }\n  }\n}\n\nfn lookup_string_builder_freeze(name: String) -> Option[Type] {\n  if name == \"StringBuilder::freeze\" {\n    Some(CtFn(builders_one_param(CtUnknown), CtString, None))\n  }\n  else None\n}\n\nexport fn lookup_string_builder(name: String) -> Option[Type] {\n  match lookup_string_builder_new(name) {\n    Some(t) => Some(t),\n    None => match lookup_string_builder_push(name) {\n      Some(t) => Some(t),\n      None => lookup_string_builder_freeze(name)\n    }\n  }\n}\n")
}

let source_47 = () -> (String, String) {
  ("lib/@vibe/compiler/checker/builtins_async.vibe",
"\nimport @vibe/compiler/core {\n  Type\n}\n\nimport @vibe/core {\n  array_empty\n}\n\n\n\nfn async_no_params() -> Array[Type] {\n  array_empty()\n}\n\nfn lookup_future(name: String) -> Option[Type] {\n  if name == \"await\" {\n    Some(CtFn([\n      CtNamed(\"Future\", [\n        CtUnknown\n      ])\n    ], CtUnknown, Some(\"Async\")))\n  } else if name == \"Future::ready\" {\n    Some(CtFn([\n      CtUnknown\n    ], CtNamed(\"Future\", [\n      CtUnknown\n    ]), None))\n  } else {\n    None\n  }\n}\n\nfn lookup_stream(name: String) -> Option[Type] {\n  if name == \"Stream::empty\" {\n    Some(CtFn(async_no_params(), CtNamed(\"Stream\", [\n      CtUnknown\n    ]), None))\n  } else if name == \"Stream::once\" {\n    Some(CtFn([\n      CtUnknown\n    ], CtNamed(\"Stream\", [\n      CtUnknown\n    ]), None))\n  } else if name == \"Stream::next\" {\n    Some(CtFn([\n      CtNamed(\"Stream\", [\n        CtUnknown\n      ])\n    ], CtNamed(\"Future\", [\n      CtOption(CtUnknown)\n    ]), Some(\"Async\")))\n  } else if name == \"Stream::map\" {\n    Some(CtFn([\n      CtNamed(\"Stream\", [\n        CtUnknown\n      ]),\n      CtUnknown\n    ], CtNamed(\"Stream\", [\n      CtUnknown\n    ]), None))\n  } else if name == \"Stream::filter\" {\n    Some(CtFn([\n      CtNamed(\"Stream\", [\n        CtUnknown\n      ]),\n      CtUnknown\n    ], CtNamed(\"Stream\", [\n      CtUnknown\n    ]), None))\n  } else if name == \"Stream::fold\" {\n    Some(CtFn([\n      CtNamed(\"Stream\", [\n        CtUnknown\n      ]),\n      CtUnknown,\n      CtUnknown\n    ], CtNamed(\"Future\", [\n      CtUnknown\n    ]), Some(\"Async\")))\n  } else {\n    None\n  }\n}\n\nfn lookup_concurrency(name: String) -> Option[Type] {\n  if name == \"Task::spawn\" {\n    Some(CtFn([\n      CtUnknown\n    ], CtNamed(\"Task\", [\n      CtUnknown\n    ]), Some(\"Async\")))\n  } else if name == \"Task::join\" {\n    Some(CtFn([\n      CtNamed(\"Task\", [\n        CtUnknown\n      ])\n    ], CtUnknown, Some(\"Async\")))\n  } else if name == \"Task::cancel\" {\n    Some(CtFn([\n      CtNamed(\"Task\", [\n        CtUnknown\n      ])\n    ], CtUnit, Some(\"Async\")))\n  } else if name == \"Task::race\" {\n    Some(CtFn([\n      CtNamed(\"Task\", [\n        CtUnknown\n      ]),\n      CtNamed(\"Task\", [\n        CtUnknown\n      ])\n    ], CtUnknown, Some(\"Async\")))\n  } else if name == \"Task::timeout\" {\n    Some(CtFn([\n      CtInt,\n      CtUnknown\n    ], CtOption(CtUnknown), Some(\"Async\")))\n  } else {\n    None\n  }\n}\n\nfn lookup_bytestream(name: String) -> Option[Type] {\n  if name == \"String::to_bytes\" {\n    Some(CtFn([\n      CtString\n    ], CtNamed(\"Stream\", [\n      CtInt\n    ]), None))\n  } else if name == \"Stream::to_string\" {\n    Some(CtFn([\n      CtNamed(\"Stream\", [\n        CtInt\n      ])\n    ], CtString, None))\n  } else {\n    None\n  }\n}\n\nexport fn lookup_async(name: String) -> Option[Type] {\n  match lookup_future(name) {\n    Some(t) => Some(t),\n    None => match lookup_stream(name) {\n      Some(t) => Some(t),\n      None => match lookup_concurrency(name) {\n        Some(t) => Some(t),\n        None => lookup_bytestream(name)\n      }\n    }\n  }\n}\n")
}

