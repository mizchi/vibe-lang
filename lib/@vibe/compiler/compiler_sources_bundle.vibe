"\nimport @vibe/compiler/core {\n  Expr,\n  Pat,\n  Stmt,\n  TypeExpr,\n  bsearch_leftmost,\n  bytebuf_length,\n  bytebuf_new,\n  bytebuf_push,\n  bytebuf_push_section,\n  bytebuf_push_vec_header,\n  bytebuf_to_bytes,\n  leb128_encode_s64,\n  leb128_encode_u32\n}\n\nimport @vibe/core {\n  array_empty\n}\n\nimport @vibe/compiler/codegen/common_analysis {\n  collect_free_vars,\n  collect_free_vars_indexed,\n  collect_free_vars_indexed_self,\n  collect_strings_stmts,\n  emit_closure_call_tail,\n  emit_closure_resolve,\n  emit_i64_extend_i32_u,\n  mut_needs_ref_cell,\n  proj_root_ident,\n  scope_tail_proj_root\n}\n\nimport @vibe/compiler/codegen/common_base {\n  CompileCtx,\n  CtorTable,\n  FuncTable,\n  LambdaTable,\n  LineMapState,\n  StrTable,\n  agg_expr_lookup,\n  agg_ret_lookup,\n  agg_slot_lookup,\n  emit_binop_op,\n  emit_heap_grow_after_heap_set,\n  emit_i32_eq,\n  emit_i32_eqz,\n  emit_i32_ge_u,\n  emit_i32_mul,\n  emit_i32_ne,\n  emit_i32_sub,\n  emit_i64_load,\n  emit_i64_store,\n  emit_rc_dup_guarded,\n  emit_str_ref,\n  expr_tag,\n  find_local_slot,\n  get_arm_body,\n  get_arm_pat,\n  get_ebinop_op,\n  get_efn_body,\n  get_eif_cond,\n  get_eif_else,\n  get_eif_then,\n  get_elet_body,\n  get_elet_name,\n  get_elet_off,\n  get_elet_val,\n  get_eletmut_off,\n  get_slet_expr,\n  get_slet_name,\n  is_ctor_call,\n  is_earray,\n  is_efn,\n  is_eident,\n  is_erecord,\n  is_etuple,\n  is_nullary_ctor_ident,\n  is_pbind,\n  is_pbool,\n  is_pctor,\n  is_pint,\n  is_pstring,\n  is_ptuple,\n  is_pwild,\n  is_slet,\n  lookup_ctor,\n  resolve_func,\n  resolve_local\n}\n\nimport @vibe/compiler/codegen/common_extractors {\n  array_contains_str,\n  emit_assignop_op,\n  emit_memory_copy,\n  find_catchall_idx,\n  first_offset,\n  get_earray_elems,\n  get_eassign_body,\n  get_eassign_name,\n  get_eassign_val,\n  get_eassignop_body,\n  get_eassignop_name,\n  get_eassignop_op,\n  get_eassignop_val,\n  get_ebinop_lhs,\n  get_ebinop_rhs,\n  get_ebool_value,\n  get_ecall_args,\n  get_ecall_callee,\n  get_efloat_value,\n  get_efn_params,\n  get_eforin_body,\n  get_eforin_iter,\n  get_eforin_name,\n  get_eident_name,\n  get_eint_value,\n  get_eletmut_body,\n  get_eletmut_name,\n  get_eletmut_val,\n  get_eletrec_body,\n  get_eletrec_name,\n  get_eletrec_val,\n  get_eseq_first,\n  get_eseq_second,\n  get_estring_value,\n  get_etuple_elems,\n  get_eunaryop_expr,\n  get_eunaryop_op,\n  get_ewhile_body,\n  get_ewhile_cond,\n  get_match_arms,\n  get_match_scrutinee,\n  get_pbind_name,\n  get_pbool_value,\n  get_pctor_args,\n  get_pctor_name,\n  get_pint_value,\n  get_pstring_value,\n  get_ptuple_pats,\n  get_slet_export,\n  offset_to_line,\n  str_table_lookup\n}\n\nimport @vibe/compiler/codegen/wasm_emit {\n  emit_block_i64,\n  emit_block_void,\n  emit_br,\n  emit_br_if,\n  emit_call,\n  emit_call_indirect,\n  emit_code_section,\n  emit_code_section_with_locals,\n  emit_data_section,\n  emit_data_section_multi,\n  emit_drop,\n  emit_element_section_active,\n  emit_else,\n  emit_end,\n  emit_export_section,\n  emit_export_section_multi,\n  emit_exports_full,\n  emit_exports_with_memory,\n  emit_f64_add,\n  emit_f64_const_bits,\n  emit_f64_convert_i64_s,\n  emit_f64_div,\n  emit_f64_eq,\n  emit_f64_ge,\n  emit_f64_gt,\n  emit_f64_le,\n  emit_f64_lt,\n  emit_f64_mul,\n  emit_f64_ne,\n  emit_f64_neg,\n  emit_f64_reinterpret_i64,\n  emit_f64_sub,\n  emit_func_type_raw,\n  emit_function_section,\n  emit_global_get,\n  emit_global_section_i32_mut,\n  emit_global_set,\n  emit_header,\n  emit_i32_add,\n  emit_i32_const,\n  emit_i32_load,\n  emit_i32_load8_u,\n  emit_i32_store,\n  emit_i32_store8,\n  emit_i32_wrap_i64,\n  emit_i64_add,\n  emit_i64_and,\n  emit_i64_const,\n  emit_i64_div_s,\n  emit_i64_eq,\n  emit_i64_eqz,\n  emit_i64_extend_i32_s,\n  emit_i64_ge_s,\n  emit_i64_gt_s,\n  emit_i64_le_s,\n  emit_i64_lt_s,\n  emit_i64_mul,\n  emit_i64_ne,\n  emit_i64_or,\n  emit_i64_reinterpret_f64,\n  emit_i64_rem_s,\n  emit_i64_shl,\n  emit_i64_shr_s,\n  emit_i64_sub,\n  emit_i64_trunc_f64_s,\n  emit_i64_xor,\n  emit_if_i64,\n  emit_if_void,\n  emit_import_section_func,\n  emit_local_get,\n  emit_local_set,\n  emit_local_tee,\n  emit_loop_void,\n  emit_memory_section,\n  emit_name,\n  emit_return,\n  emit_table_section_funcref,\n  emit_type_section,\n  emit_type_section_multi,\n  string_to_data\n}\n\n\n\n\n\n\nfn emit_assignop_rc_tag_fix(buf: Bytes, enable_rc: Bool, op: String) -> Unit {\n  if enable_rc && op == \"*\" {\n    emit_i64_const(buf, 1)\n    emit_i64_shr_s(buf)\n  } else if enable_rc && op == \"/\" {\n    emit_i64_const(buf, 1)\n    emit_i64_shl(buf)\n  } else {\n    ()\n  }\n}\n\nfn emit_dbg_line_for(buf: Bytes, value: Expr, ctx: CompileCtx) -> Unit {\n  emit_dbg_line_stmt(buf, value, -1, ctx)\n}\n\nfn linemap_record(lm: LineMapState, buf: Bytes, file_id: Int, line: Int) -> Unit {\n  if lm.enabled {\n    Array::push(lm.funcs, Array::get(lm.cur_fn, 0))\n    Array::push(lm.offsets, bytebuf_length(buf))\n    Array::push(lm.file_ids, file_id)\n    Array::push(lm.lines, line)\n  } else {\n    ()\n  }\n}\n\nfn emit_dbg_line_stmt(buf: Bytes, value: Expr, stmt_off: Int, ctx: CompileCtx) -> Unit {\n  if ctx.dbg_line_idx >= 0 {\n    let voff = first_offset(value)\n    let off = if voff >= 0 {\n      voff\n    } else {\n      stmt_off\n    }\n    if off >= 0 {\n      let line = offset_to_line(ctx.dbg_line_nl, off)\n      linemap_record(ctx.linemap, buf, ctx.dbg_line_file_id, line)\n      emit_i32_const(buf, ctx.dbg_line_file_id)\n      emit_i32_const(buf, line)\n      emit_call(buf, ctx.dbg_line_idx)\n    } else {\n      ()\n    }\n  } else {\n    ()\n  }\n}\n\nfn is_edot(e: Expr) -> Bool {\n  match e {\n    EDot(_, _, _, _) => true,\n    _ => false\n  }\n}\n\nfn efn_is_capturing(value: Expr, ctx: CompileCtx) -> Bool with { Error } {\n  let params = get_efn_params(value)\n  let pnames = array_empty()\n  let mut pi = 0\n  while pi < Array::length(params) {\n    let (pn, _) = Array::get(params, pi)\n    Array::push(pnames, pn)\n    pi = pi + 1\n  }\n  let caps = collect_free_vars_indexed(get_efn_body(value), pnames, ctx.capture_name_index)\n  Array::length(caps) > 0\n}\n\nfn slot_is_floatish(ctx: CompileCtx, slot: Int) -> Bool {\n  let arr = ctx.float_local_slots\n  let mut j = Array::length(arr) - 1\n  let mut result = false\n  while j >= 0 {\n    let entry = Array::get(arr, j)\n    if entry / 2 == slot {\n      result = (entry % 2) == 1\n      j = -1\n    } else {\n      j = j - 1\n    }\n  }\n  result\n}\n\nfn slot_is_intish(ctx: CompileCtx, slot: Int) -> Bool {\n  let arr = ctx.int_local_slots\n  let mut j = Array::length(arr) - 1\n  let mut result = false\n  while j >= 0 {\n    let entry = Array::get(arr, j)\n    if entry / 4 == slot {\n      result = (entry % 2) == 1\n      j = -1\n    } else {\n      j = j - 1\n    }\n  }\n  result\n}\n\nfn slot_is_boolish(ctx: CompileCtx, slot: Int) -> Bool {\n  let arr = ctx.int_local_slots\n  let mut j = Array::length(arr) - 1\n  let mut result = false\n  while j >= 0 {\n    let entry = Array::get(arr, j)\n    if entry / 4 == slot {\n      result = (entry % 4) == 3\n      j = -1\n    } else {\n      j = j - 1\n    }\n  }\n  result\n}\n\nfn slot_is_stringish(ctx: CompileCtx, slot: Int) -> Bool {\n  let arr = ctx.int_local_slots\n  let mut j = Array::length(arr) - 1\n  let mut result = false\n  while j >= 0 {\n    let entry = Array::get(arr, j)\n    if entry / 4 == slot {\n      result = (entry % 4) == 2\n      j = -1\n    } else {\n      j = j - 1\n    }\n  }\n  result\n}\n\nexport fn expr_is_boolish(e: Expr, local_names: Array[String], ctx: CompileCtx) -> Bool with { Error } {\n  let tag = expr_tag(e)\n  if tag == 1 {\n    true\n  } else if tag == 4 {\n    let nm = get_eident_name(e)\n    let mut i = Array::length(local_names) - 1\n    let mut slot = -1\n    while i >= 0 {\n      if Array::get(local_names, i) == nm {\n        slot = i\n        i = -1\n      } else {\n        i = i - 1\n      }\n    }\n    if slot >= 0 {\n      slot_is_boolish(ctx, slot)\n    } else {\n      false\n    }\n  } else if tag == 5 {\n    let op = get_ebinop_op(e)\n    op == \"==\" || op == \"!=\" || op == \"<\" || op == \">\" || op == \"<=\" || op == \">=\" || op == \"&&\" || op == \"||\"\n  } else if tag == 6 {\n    get_eunaryop_op(e) == \"!\"\n  } else if tag == 16 {\n    let arms = get_match_arms(e)\n    let alen2 = Array::length(arms)\n    if alen2 == 0 {\n      false\n    } else {\n      let mut all_bool = true\n      let mut bi2 = 0\n      while bi2 < alen2 {\n        if !expr_is_boolish(get_arm_body(Array::get(arms, bi2)), local_names, ctx) {\n          all_bool = false\n        } else {\n          ()\n        }\n        bi2 = bi2 + 1\n      }\n      all_bool\n    }\n  } else if tag == 9 {\n    expr_is_boolish(get_elet_body(e), local_names, ctx)\n  } else if tag == 10 {\n    expr_is_boolish(get_eletrec_body(e), local_names, ctx)\n  } else if tag == 11 {\n    expr_is_boolish(get_eletmut_body(e), local_names, ctx)\n  } else if tag == 14 {\n    expr_is_boolish(get_eseq_second(e), local_names, ctx)\n  } else if tag == 7 {\n    expr_is_boolish(get_eif_then(e), local_names, ctx) && expr_is_boolish(get_eif_else(e), local_names, ctx)\n  } else if tag == 8 {\n    let bcallee = get_ecall_callee(e)\n    if is_eident(bcallee) {\n      let bcn = get_eident_name(bcallee)\n      String::starts_with(bcn, \"__arr_equals__\") || (String::ends_with(bcn, \"::equals\") && Array::length(get_ecall_args(e)) == 2) || (bcn == \"not\" && Array::length(get_ecall_args(e)) == 1 && find_local_slot(local_names, \"not\") < 0 && expr_is_boolish(Array::get(get_ecall_args(e), 0), local_names, ctx)) || cc_builtin_call_ret_kind(e, local_names, ctx) == 1\n    } else if is_efn(bcallee) && Array::length(get_ecall_args(e)) == 1 {\n      let fparams = get_efn_params(bcallee)\n      if Array::length(fparams) == 1 {\n        let (asc_name, asc_ty) = Array::get(fparams, 0)\n        (asc_name == \"__asc\" || (String::starts_with(asc_name, \"__shadow_\") && String::ends_with(asc_name, \"___asc\"))) && (match asc_ty {\n          Some(TyName(tn)) => tn == \"Bool\",\n          _ => false\n        })\n      } else {\n        false\n      }\n    } else {\n      false\n    }\n  } else {\n    false\n  }\n}\n\nexport fn expr_is_floatish(e: Expr, local_names: Array[String], ctx: CompileCtx) -> Bool with { Error } {\n  let dot_float = match e {\n    EDot(dobj, dfield, _, _) => {\n      let fc = String::char_code_at(dfield, 0)\n      if fc >= 48 && fc <= 57 && is_eident(dobj) {\n        let slot = find_local_slot(local_names, get_eident_name(dobj))\n        if slot >= 0 {\n          let info = agg_slot_lookup(ctx.agg_local_slots, slot)\n          if info >= 0 && info / 64 == 1 {\n            let backing = agg_expr_lookup(ctx.agg_local_slots, ctx.agg_local_exprs, slot)\n            if is_etuple(backing) {\n              let elems = get_etuple_elems(backing)\n              let mut k = 0\n              let mut fp = 0\n              while fp < String::length(dfield) {\n                k = k * 10 + (String::char_code_at(dfield, fp) - 48)\n                fp = fp + 1\n              }\n              if k >= 0 && k < Array::length(elems) {\n                expr_is_floatish(Array::get(elems, k), local_names, ctx)\n              } else {\n                false\n              }\n            } else {\n              false\n            }\n          } else {\n            false\n          }\n        } else {\n          false\n        }\n      } else {\n        false\n      }\n    },\n    _ => false\n  }\n  let tag = expr_tag(e)\n  if dot_float {\n    true\n  } else if tag == 2 {\n    true\n  } else if tag == 4 {\n    let nm = get_eident_name(e)\n    let len = Array::length(local_names)\n    let mut i = len - 1\n    let mut slot = -1\n    while i >= 0 {\n      if Array::get(local_names, i) == nm {\n        slot = i\n        i = -1\n      } else {\n        i = i - 1\n      }\n    }\n    if slot >= 0 {\n      slot_is_floatish(ctx, slot)\n    } else {\n      false\n    }\n  } else if tag == 5 {\n    let op = get_ebinop_op(e)\n    if op == \"+\" || op == \"-\" || op == \"*\" || op == \"/\" {\n      expr_is_floatish(get_ebinop_lhs(e), local_names, ctx) || expr_is_floatish(get_ebinop_rhs(e), local_names, ctx)\n    } else {\n      false\n    }\n  } else if tag == 6 {\n    let op = get_eunaryop_op(e)\n    if op == \"-\" {\n      expr_is_floatish(get_eunaryop_expr(e), local_names, ctx)\n    } else {\n      false\n    }\n  } else if tag == 8 {\n    let callee = get_ecall_callee(e)\n    if is_eident(callee) {\n      let fname = get_eident_name(callee)\n      if fname == \"Int::to_double\" || fname == \"Int::to_float\" || fname == \"Float::to_double\" || fname == \"Double::to_float\" || fname == \"Double::from_i64_bits\" {\n        true\n      } else if fname == \"__rec_field\" {\n        let args = get_ecall_args(e)\n        if Array::length(args) == 2 && is_eident(Array::get(args, 0)) && expr_tag(Array::get(args, 1)) == 0 {\n          let slot = find_local_slot(local_names, get_eident_name(Array::get(args, 0)))\n          if slot >= 0 {\n            let info = agg_slot_lookup(ctx.agg_local_slots, slot)\n            if info >= 0 && info / 64 == 1 {\n              let backing = agg_expr_lookup(ctx.agg_local_slots, ctx.agg_local_exprs, slot)\n              if is_etuple(backing) {\n                let elems = get_etuple_elems(backing)\n                let k = get_eint_value(Array::get(args, 1))\n                if k >= 0 && k < Array::length(elems) {\n                  expr_is_floatish(Array::get(elems, k), local_names, ctx)\n                } else {\n                  false\n                }\n              } else {\n                false\n              }\n            } else {\n              false\n            }\n          } else {\n            false\n          }\n        } else {\n          false\n        }\n      } else {\n        false\n      }\n    } else if is_efn(callee) && Array::length(get_ecall_args(e)) == 1 {\n      match callee {\n        EFn(tparams, _, params, ret_ty, effect, body) => if Array::length(tparams) == 0 && Array::length(params) == 1 && (match ret_ty {\n          None => true,\n          Some(_) => false\n        }) && (match effect {\n          None => true,\n          Some(_) => false\n        }) {\n          let (asc_name, asc_ty) = Array::get(params, 0)\n          if asc_name == \"__asc\" || (String::starts_with(asc_name, \"__shadow_\") && String::ends_with(asc_name, \"___asc\")) {\n            match body {\n              EIdent(bname, _) => if bname == asc_name {\n                match asc_ty {\n                  Some(TyName(tn)) => tn == \"Double\" || tn == \"Float\",\n                  _ => false\n                }\n              } else {\n                false\n              },\n              _ => false\n            }\n          } else {\n            false\n          }\n        } else {\n          false\n        },\n        _ => false\n      }\n    } else {\n      false\n    }\n  } else {\n    false\n  }\n}\n\nexport fn expr_is_intish(e: Expr, local_names: Array[String], ctx: CompileCtx) -> Bool with { Error } {\n  let tag = expr_tag(e)\n  if tag == 0 {\n    true\n  } else if tag == 1 {\n    true\n  } else if tag == 4 {\n    let nm = get_eident_name(e)\n    let len = Array::length(local_names)\n    let mut i = len - 1\n    let mut slot = -1\n    while i >= 0 {\n      if Array::get(local_names, i) == nm {\n        slot = i\n        i = -1\n      } else {\n        i = i - 1\n      }\n    }\n    if slot >= 0 {\n      slot_is_intish(ctx, slot)\n    } else {\n      false\n    }\n  } else if tag == 5 {\n    let op = get_ebinop_op(e)\n    if op == \"&\" || op == \"|\" || op == \"^\" || op == \"<<\" || op == \">>\" || op == \"%\" || op == \"<\" || op == \">\" || op == \"<=\" || op == \">=\" || op == \"==\" || op == \"!=\" || op == \"&&\" || op == \"||\" {\n      true\n    } else if op == \"+\" || op == \"-\" || op == \"*\" || op == \"/\" {\n      !expr_is_floatish(e, local_names, ctx)\n    } else {\n      false\n    }\n  } else if tag == 6 {\n    let op = get_eunaryop_op(e)\n    op == \"!\"\n  } else {\n    false\n  }\n}\n\nfn assign_value_mentions(value: Expr, name: String) -> Bool {\n  let empty1 = array_empty()\n  let empty2 = array_empty()\n  array_contains_str(collect_free_vars(value, empty1, empty2), name)\n}\n\nfn reassign_carry_safe(e: Expr, name: String) -> Bool {\n  if !assign_value_mentions(e, name) {\n    true\n  } else {\n    match e {\n      EIdent(_, _) => true,\n      EDot(_, _, _, _) => proj_root_ident(e) == name,\n      EBinOp(_, l, r) => reassign_carry_safe(l, name) && reassign_carry_safe(r, name),\n      EUnaryOp(_, x) => reassign_carry_safe(x, name),\n      _ => false\n    }\n  }\n}\n\nfn emit_rc_value_ptr_i32(buf: Bytes, local_idx: Int, tagged: Bool) -> Unit {\n  emit_local_get(buf, local_idx)\n  if tagged {\n    emit_i64_const(buf, -2)\n    emit_i64_and(buf)\n  } else {\n    ()\n  }\n  emit_i32_wrap_i64(buf)\n}\n\nfn emit_rc_drop_local(buf: Bytes, local_idx: Int, tagged: Bool) -> Unit {\n  emit_rc_value_ptr_i32(buf, local_idx, tagged)\n  emit_i32_const(buf, 4)\n  emit_i32_sub(buf)\n  emit_i32_load(buf, 2, 0)\n  emit_i32_const(buf, 16777215)\n  bytebuf_push(buf, 113)\n  emit_i32_const(buf, 16777215)\n  emit_i32_ne(buf)\n  emit_if_void(buf)\n  emit_rc_value_ptr_i32(buf, local_idx, tagged)\n  emit_i32_const(buf, 4)\n  emit_i32_sub(buf)\n  emit_rc_value_ptr_i32(buf, local_idx, tagged)\n  emit_i32_const(buf, 4)\n  emit_i32_sub(buf)\n  emit_i32_load(buf, 2, 0)\n  emit_i32_const(buf, 1)\n  emit_i32_sub(buf)\n  emit_i32_store(buf, 2, 0)\n  emit_rc_value_ptr_i32(buf, local_idx, tagged)\n  emit_i32_const(buf, 4)\n  emit_i32_sub(buf)\n  emit_i32_load(buf, 2, 0)\n  emit_i32_const(buf, 256)\n  emit_i32_mul(buf)\n  emit_i32_eqz(buf)\n  emit_if_void(buf)\n  emit_rc_value_ptr_i32(buf, local_idx, tagged)\n  emit_i32_const(buf, 4)\n  emit_i32_sub(buf)\n  emit_global_get(buf, 2)\n  emit_i32_store(buf, 2, 0)\n  emit_rc_value_ptr_i32(buf, local_idx, tagged)\n  emit_global_set(buf, 2)\n  emit_end(buf)\n  emit_end(buf)\n}\n\nfn reassign_self_reusable(value: Expr, name: String) -> Bool with { Error } {\n  if is_etuple(value) {\n    let elems = get_etuple_elems(value)\n    let mut i = 0\n    let mut ok = true\n    while i < Array::length(elems) {\n      if !reassign_carry_safe(Array::get(elems, i), name) {\n        ok = false\n      } else {\n        ()\n      }\n      i = i + 1\n    }\n    ok\n  } else {\n    false\n  }\n}\n\nfn classify_let_value_heap(buf: Bytes, value: Expr, name: String, local_idx: Int, local_names: Array[String], ctx: CompileCtx) -> (Int, Bool) with { Error } {\n  let mut rc_kind = 0\n  let mut is_borrow_ret_ext = false\n  if ctx.enable_rc {\n    if expr_is_floatish(value, local_names, ctx) {\n      rc_kind = 2\n      Array::push(ctx.heap_binding_names, name)\n    } else if is_etuple(value) {\n      rc_kind = 2\n      Array::push(ctx.heap_binding_names, name)\n    } else if is_earray(value) {\n      rc_kind = 2\n      Array::push(ctx.heap_binding_names, name)\n    } else if is_erecord(value) {\n      rc_kind = 2\n      Array::push(ctx.heap_binding_names, name)\n    } else if is_ctor_call(value, ctx.ctor_table) {\n      rc_kind = 2\n      Array::push(ctx.heap_binding_names, name)\n    } else if is_nullary_ctor_ident(value, ctx.ctor_table) {\n      rc_kind = 2\n      Array::push(ctx.heap_binding_names, name)\n    } else if is_eident(value) {\n      let src = get_eident_name(value)\n      if array_contains_str(ctx.heap_binding_names, src) {\n        rc_kind = 2\n        Array::push(ctx.heap_binding_names, name)\n        if array_contains_str(ctx.rc_alias_dup_names, name) {\n          emit_rc_dup_guarded(buf, local_idx, ctx.rc_shadow)\n        } else {\n          ()\n        }\n      } else {\n        ()\n      }\n    } else if expr_tag(value) == 8 {\n      let callee = get_ecall_callee(value)\n      let is_borrow_ret = if is_eident(callee) {\n        let cn = get_eident_name(callee)\n        cn == \"Array::get\" || cn == \"__index\" || cn == \"Map::get\" || cn == \"__rec_field\" || bsearch_leftmost(ctx.borrow_ret_names, cn) >= 0\n      } else {\n        false\n      }\n      let is_declared_heap_ret = if is_eident(callee) {\n        bsearch_leftmost(ctx.heap_ret_names, get_eident_name(callee)) >= 0\n      } else {\n        false\n      }\n      let is_builtin_scalar_ret = if is_eident(callee) {\n        let cn = get_eident_name(callee)\n        let is_always_registered = cn == \"Array::length\" || cn == \"Bytes::length\" || cn == \"String::length\" || cn == \"eq\"\n        let is_user_shadowed = !is_always_registered && array_contains_str(ctx.func_table.names, cn)\n        !is_user_shadowed && (cn == \"Array::length\" || cn == \"Bytes::length\" || cn == \"String::length\" || cn == \"Map::has_key\" || cn == \"MapBuilder::has_key\" || cn == \"Array::contains\" || cn == \"eq\" || cn == \"not\" || cn == \"add\" || cn == \"sub\" || cn == \"mul\" || cn == \"lt\")\n      } else {\n        false\n      }\n      let is_scalar_ret = if is_eident(callee) {\n        bsearch_leftmost(ctx.scalar_ret_names, get_eident_name(callee)) >= 0 || is_builtin_scalar_ret\n      } else {\n        false\n      }\n      if is_borrow_ret || is_scalar_ret {\n        ()\n      } else if is_declared_heap_ret {\n        rc_kind = 2\n        Array::push(ctx.heap_binding_names, name)\n      } else {\n        rc_kind = 2\n        Array::push(ctx.heap_binding_names, name)\n      }\n      is_borrow_ret_ext = is_borrow_ret\n    } else if is_edot(value) {\n      rc_kind = 2\n      Array::push(ctx.heap_binding_names, name)\n      emit_rc_dup_guarded(buf, local_idx, ctx.rc_shadow)\n    } else if is_efn(value) {\n      if efn_is_capturing(value, ctx) {\n        rc_kind = 2\n        Array::push(ctx.heap_binding_names, name)\n      } else {\n        ()\n      }\n    } else if expr_tag(value) == 7 {\n      rc_kind = 2\n      Array::push(ctx.heap_binding_names, name)\n    } else if expr_tag(value) == 16 {\n      rc_kind = 2\n      Array::push(ctx.heap_binding_names, name)\n    } else if expr_tag(value) == 9 || expr_tag(value) == 14 {\n      rc_kind = 2\n      Array::push(ctx.heap_binding_names, name)\n    } else {\n      let __sf_tag = expr_tag(value)\n      if is_eident(value) || __sf_tag == 0 || __sf_tag == 1 || __sf_tag == 2 || __sf_tag == 3 || __sf_tag == 22 {\n        ()\n      } else {\n        rc_kind = 2\n        Array::push(ctx.heap_binding_names, name)\n      }\n    }\n  } else {\n    ()\n  }\n  (rc_kind, is_borrow_ret_ext)\n}\n\nfn retain_wrap_branch_tails(e: Expr, ctx: CompileCtx) -> Expr with { Error } {\n  match e {\n    EIdent(x, p) => if array_contains_str(ctx.loop_borrowed_names, x) && !array_contains_str(ctx.ref_cell_names, x) {\n      ECall(EIdent(\"__loop_tail_retain\", -1), [\n        EIdent(x, p)\n      ], -1)\n    } else {\n      e\n    },\n    EDot(_, _, _, _) => {\n      let root = proj_root_ident(e)\n      if String::length(root) > 0 && array_contains_str(ctx.loop_borrowed_names, root) && !array_contains_str(ctx.ref_cell_names, root) {\n        ECall(EIdent(\"__loop_tail_retain\", -1), [\n          e\n        ], -1)\n      } else {\n        e\n      }\n    },\n    EIf(c, t, el) => EIf(c, retain_wrap_branch_tails(t, ctx), retain_wrap_branch_tails(el, ctx)),\n    EMatch(scrut, arms) => {\n      if Array::length(arms) == 0 {\n        e\n      } else {\n        let out = array_empty()\n        let mut ai = 0\n        while ai < Array::length(arms) {\n          let (apat, abody) = Array::get(arms, ai)\n          Array::push(out, (apat, retain_wrap_branch_tails(abody, ctx)))\n          ai = ai + 1\n        }\n        EMatch(scrut, out)\n      }\n    },\n    ELet(n, v, b, soff) => ELet(n, v, retain_wrap_branch_tails(b, ctx), soff),\n    ELetMut(n, v, b, soff) => ELetMut(n, v, retain_wrap_branch_tails(b, ctx), soff),\n    ESeq(a, b) => ESeq(a, retain_wrap_branch_tails(b, ctx)),\n    EAssign(n, v, b) => EAssign(n, v, retain_wrap_branch_tails(b, ctx)),\n    EAssignOp(o, n, v, b) => EAssignOp(o, n, v, retain_wrap_branch_tails(b, ctx)),\n    _ => e\n  }\n}\n\nfn value_has_borrowed_branch_tail(e: Expr, ctx: CompileCtx) -> Bool {\n  match e {\n    EIdent(x, _) => array_contains_str(ctx.loop_borrowed_names, x) && !array_contains_str(ctx.ref_cell_names, x),\n    EDot(_, _, _, _) => true,\n    ECall(callee, _, _) => match callee {\n      EIdent(cn, _) => cn == \"Array::get\" || cn == \"__index\" || cn == \"Map::get\" || cn == \"__rec_field\" || bsearch_leftmost(ctx.borrow_ret_names, cn) >= 0,\n      _ => false\n    },\n    EIf(_, t, el) => value_has_borrowed_branch_tail(t, ctx) || value_has_borrowed_branch_tail(el, ctx),\n    EMatch(_, arms) => {\n      let mut found = false\n      let mut ai = 0\n      while ai < Array::length(arms) {\n        let (_, abody) = Array::get(arms, ai)\n        if value_has_borrowed_branch_tail(abody, ctx) {\n          found = true\n          ai = Array::length(arms)\n        } else {\n          ai = ai + 1\n        }\n      }\n      found\n    },\n    ELet(_, _, b, _) => value_has_borrowed_branch_tail(b, ctx),\n    ELetMut(_, _, b, _) => value_has_borrowed_branch_tail(b, ctx),\n    ESeq(_, b) => value_has_borrowed_branch_tail(b, ctx),\n    EAssign(_, _, b) => value_has_borrowed_branch_tail(b, ctx),\n    EAssignOp(_, _, _, b) => value_has_borrowed_branch_tail(b, ctx),\n    _ => false\n  }\n}\n\nfn retain_wrap_let_value(value: Expr, name: String, ctx: CompileCtx) -> Expr with { Error } {\n  if ctx.enable_rc && (expr_tag(value) == 7 || expr_tag(value) == 16) && Array::length(ctx.loop_borrowed_names) > 0 && array_contains_str(ctx.rc_drop_names, name) {\n    retain_wrap_branch_tails(value, ctx)\n  } else {\n    value\n  }\n}\n\nexport fn compile_expr_tail(buf: Bytes, expr: Expr, local_names: Array[String], next_local: Int, ctx: CompileCtx, ld: Int, compile_expr: (Bytes, Expr, Array[String], Int, CompileCtx, Int) -> Int with { Error }) -> Int with { Error } {\n  let __tag = expr_tag(expr)\n  if __tag == 9 {\n    let name = get_elet_name(expr)\n    let value = get_elet_val(expr)\n    let body = get_elet_body(expr)\n    let local_idx = next_local\n    emit_dbg_line_stmt(buf, value, get_elet_off(expr), ctx)\n    Array::push(local_names, name)\n    Array::set(local_names, local_idx, \"\")\n    let nl = compile_expr(buf, retain_wrap_let_value(value, name, ctx), local_names, next_local + 1, ctx, ld)\n    Array::set(local_names, local_idx, name)\n    emit_local_set(buf, local_idx)\n    let val_is_float = expr_is_floatish(value, local_names, ctx)\n    if val_is_float {\n      Array::push(ctx.float_local_slots, local_idx * 2 + 1)\n    } else if slot_is_floatish(ctx, local_idx) {\n      Array::push(ctx.float_local_slots, local_idx * 2)\n    }\n    if expr_is_boolish(value, local_names, ctx) {\n      Array::push(ctx.int_local_slots, local_idx * 4 + 3)\n    } else if expr_is_intish(value, local_names, ctx) {\n      Array::push(ctx.int_local_slots, local_idx * 4 + 1)\n    } else if cc_expr_is_stringish(value, local_names, ctx) {\n      Array::push(ctx.int_local_slots, local_idx * 4 + 2)\n    } else if slot_is_intish(ctx, local_idx) || slot_is_stringish(ctx, local_idx) {\n      Array::push(ctx.int_local_slots, local_idx * 4)\n    }\n    let agg_entry = if is_etuple(value) {\n      64 + Array::length(get_etuple_elems(value))\n    } else if is_ctor_call(value, ctx.ctor_table) {\n      let cargs = get_ecall_args(value)\n      let fcnt = if Array::length(cargs) == 1 {\n        match Array::get(cargs, 0) {\n          ERecord(_, rfields, _) => Array::length(rfields),\n          _ => Array::length(cargs)\n        }\n      } else {\n        Array::length(cargs)\n      }\n      128 + fcnt\n    } else if is_nullary_ctor_ident(value, ctx.ctor_table) {\n      128\n    } else if is_erecord(value) {\n      match value {\n        ERecord(_, rfields, _) => 128 + Array::length(rfields),\n        _ => 0\n      }\n    } else if expr_tag(value) == 8 {\n      match get_ecall_callee(value) {\n        EIdent(cfn, _) => if find_local_slot(local_names, cfn) < 0 {\n          let rinfo = agg_ret_lookup(ctx.agg_ret_names, ctx.agg_ret_infos, cfn)\n          if rinfo > 0 {\n            rinfo\n          } else {\n            0\n          }\n        } else {\n          0\n        },\n        _ => 0\n      }\n    } else if is_eident(value) {\n      let src_slot = find_local_slot(local_names, get_eident_name(value))\n      if src_slot >= 0 {\n        let src_info = agg_slot_lookup(ctx.agg_local_slots, src_slot)\n        if src_info > 0 {\n          src_info\n        } else {\n          0\n        }\n      } else {\n        0\n      }\n    } else {\n      0\n    }\n    let agg_shape_expr = if is_etuple(value) {\n      value\n    } else if is_ctor_call(value, ctx.ctor_table) {\n      value\n    } else if is_nullary_ctor_ident(value, ctx.ctor_table) {\n      value\n    } else if is_erecord(value) {\n      value\n    } else if is_eident(value) {\n      let src_slot = find_local_slot(local_names, get_eident_name(value))\n      if src_slot >= 0 {\n        agg_expr_lookup(ctx.agg_local_slots, ctx.agg_local_exprs, src_slot)\n      } else {\n        EInt(0)\n      }\n    } else {\n      EInt(0)\n    }\n    Array::push(ctx.agg_local_slots, local_idx * 256 + agg_entry)\n    Array::push(ctx.agg_local_exprs, agg_shape_expr)\n    let (rc_kind, is_borrow_ret_ext) = classify_let_value_heap(buf, value, name, local_idx, local_names, ctx)\n    if ctx.enable_rc && rc_kind > 0 {\n      let mut dbi = 0\n      while dbi < Array::length(ctx.rc_dup_names) {\n        if Array::get(ctx.rc_dup_names, dbi) == name {\n          emit_rc_dup_guarded(buf, local_idx, ctx.rc_shadow)\n        } else {\n          ()\n        }\n        dbi = dbi + 1\n      }\n    } else {\n      ()\n    }\n    let mut lb_shadow_removed = 0\n    if ctx.enable_rc {\n      let lb_arr = ctx.loop_borrowed_names\n      let lb_n = Array::length(lb_arr)\n      let mut lb_w = 0\n      let mut lb_i = 0\n      while lb_i < lb_n {\n        let e = Array::get(lb_arr, lb_i)\n        if e == name {\n          lb_shadow_removed = lb_shadow_removed + 1\n        } else {\n          Array::set(lb_arr, lb_w, e)\n          lb_w = lb_w + 1\n        }\n        lb_i = lb_i + 1\n      }\n      Array::truncate(lb_arr, lb_w)\n    } else {\n      ()\n    }\n    let lb_mark = Array::length(ctx.loop_borrowed_names)\n    let value_borrow_like = ctx.enable_rc && (expr_tag(value) == 7 || expr_tag(value) == 16) && value_has_borrowed_branch_tail(value, ctx)\n    if ctx.enable_rc && (is_borrow_ret_ext || value_borrow_like) {\n      Array::push(ctx.loop_borrowed_names, name)\n    } else {\n      ()\n    }\n    let reuse_fusion = ctx.enable_rc && rc_kind > 0 && ctx.rc_drop_func_idx >= 0 && array_contains_str(ctx.rc_drop_names, name) && expr_tag(body) == 16 && is_eident(get_match_scrutinee(body)) && get_eident_name(get_match_scrutinee(body)) == name\n    let reuse_flag_l = if reuse_fusion {\n      Array::push(local_names, \"__reuse_flag\")\n      emit_i64_const(buf, 0)\n      emit_local_set(buf, nl)\n      Array::push(ctx.reuse_scrutinee_names, name)\n      Array::push(ctx.reuse_flag_locals, nl)\n      nl\n    } else {\n      0 - 1\n    }\n    let nl_body = if reuse_fusion {\n      nl + 1\n    } else {\n      nl\n    }\n    let nl2 = compile_expr(buf, body, local_names, nl_body, ctx, ld)\n    if reuse_fusion {\n      Array::truncate(ctx.reuse_scrutinee_names, Array::length(ctx.reuse_scrutinee_names) - 1)\n      Array::truncate(ctx.reuse_flag_locals, Array::length(ctx.reuse_flag_locals) - 1)\n    } else {\n      ()\n    }\n    if ctx.enable_rc && (is_borrow_ret_ext || value_borrow_like) {\n      Array::truncate(ctx.loop_borrowed_names, lb_mark)\n    } else {\n      ()\n    }\n    let mut lb_restore_i = 0\n    while lb_restore_i < lb_shadow_removed {\n      Array::push(ctx.loop_borrowed_names, name)\n      lb_restore_i = lb_restore_i + 1\n    }\n    if ctx.enable_rc && rc_kind > 0 && array_contains_str(ctx.rc_drop_names, name) {\n      if reuse_fusion {\n        emit_local_get(buf, reuse_flag_l)\n        emit_i64_eqz(buf)\n        emit_if_void(buf)\n        emit_local_get(buf, local_idx)\n        emit_call(buf, ctx.rc_drop_func_idx)\n        emit_end(buf)\n        nl2\n      } else if ctx.rc_drop_func_idx >= 0 && scope_tail_proj_root(body) == name {\n        emit_local_set(buf, nl2)\n        emit_rc_dup_guarded(buf, nl2, ctx.rc_shadow)\n        emit_local_get(buf, local_idx)\n        emit_call(buf, ctx.rc_drop_func_idx)\n        emit_local_get(buf, nl2)\n        nl2 + 1\n      } else {\n        if ctx.rc_drop_func_idx >= 0 {\n          emit_local_get(buf, local_idx)\n          emit_call(buf, ctx.rc_drop_func_idx)\n        } else if rc_kind == 1 {\n          emit_rc_drop_local(buf, local_idx, false)\n        } else {\n          emit_rc_drop_local(buf, local_idx, true)\n        }\n        nl2\n      }\n    } else {\n      nl2\n    }\n  } else if __tag == 10 {\n    let name = get_eletrec_name(expr)\n    let value = get_eletrec_val(expr)\n    let body = get_eletrec_body(expr)\n    let local_idx = next_local\n    Array::push(local_names, name)\n    if is_efn(value) {\n      Array::truncate(ctx.pending_letrec_self_name, 0)\n      Array::push(ctx.pending_letrec_self_name, name)\n    } else {\n      ()\n    }\n    let nl = compile_expr(buf, value, local_names, next_local + 1, ctx, ld)\n    emit_local_set(buf, local_idx)\n    if is_efn(value) {\n      let params = get_efn_params(value)\n      let fn_body = get_efn_body(value)\n      let param_names_bp = array_empty()\n      let mut bpi = 0\n      while bpi < Array::length(params) {\n        let (pn, _) = Array::get(params, bpi)\n        Array::push(param_names_bp, pn)\n        bpi = bpi + 1\n      }\n      let caps = collect_free_vars_indexed_self(fn_body, param_names_bp, ctx.capture_name_index, name, local_names)\n      let mut self_cap_idx = -1\n      let mut bci = 0\n      while bci < Array::length(caps) {\n        if Array::get(caps, bci) == name {\n          self_cap_idx = bci\n        }\n        bci = bci + 1\n      }\n      if self_cap_idx >= 0 {\n        emit_local_get(buf, local_idx)\n        emit_i64_const(buf, -4)\n        emit_i64_and(buf)\n        emit_i32_wrap_i64(buf)\n        emit_local_get(buf, local_idx)\n        emit_i64_store(buf, 3, 8 + self_cap_idx * 8)\n      }\n      0\n    } else {\n      0\n    }\n    let nl2 = compile_expr(buf, body, local_names, nl, ctx, ld)\n    nl2\n  } else if __tag == 11 {\n    let name = get_eletmut_name(expr)\n    let value = get_eletmut_val(expr)\n    let body = get_eletmut_body(expr)\n    let local_idx = next_local\n    emit_dbg_line_stmt(buf, value, get_eletmut_off(expr), ctx)\n    Array::push(local_names, name)\n    Array::set(local_names, local_idx, \"\")\n    if expr_is_floatish(value, local_names, ctx) {\n      Array::push(ctx.float_local_slots, local_idx * 2 + 1)\n    } else if slot_is_floatish(ctx, local_idx) {\n      Array::push(ctx.float_local_slots, local_idx * 2)\n    }\n    if expr_is_boolish(value, local_names, ctx) {\n      Array::push(ctx.int_local_slots, local_idx * 4 + 3)\n    } else if expr_is_intish(value, local_names, ctx) {\n      Array::push(ctx.int_local_slots, local_idx * 4 + 1)\n    } else if cc_expr_is_stringish(value, local_names, ctx) {\n      Array::push(ctx.int_local_slots, local_idx * 4 + 2)\n    } else if slot_is_intish(ctx, local_idx) || slot_is_stringish(ctx, local_idx) {\n      Array::push(ctx.int_local_slots, local_idx * 4)\n    }\n    if mut_needs_ref_cell(body, name) {\n      Array::push(ctx.ref_cell_names, name)\n      if ctx.enable_rc && ctx.rc_alloc_func_idx >= 0 && ctx.rc_drop_func_idx >= 0 && expr_is_intish(value, local_names, ctx) {\n        emit_i64_const(buf, 16)\n        emit_call(buf, ctx.rc_alloc_func_idx)\n        emit_local_set(buf, local_idx)\n        emit_local_get(buf, local_idx)\n        emit_i32_wrap_i64(buf)\n        emit_i32_const(buf, 16)\n        emit_i32_store(buf, 2, 0)\n        emit_local_get(buf, local_idx)\n        emit_i32_wrap_i64(buf)\n        emit_i32_const(buf, 1)\n        emit_i32_store(buf, 2, 4)\n        emit_local_get(buf, local_idx)\n        emit_i32_wrap_i64(buf)\n        emit_i32_const(buf, 8)\n        emit_i32_store8(buf, 0, 7)\n        emit_local_get(buf, local_idx)\n        emit_i64_const(buf, 8)\n        emit_i64_add(buf)\n        emit_local_set(buf, local_idx)\n        emit_local_get(buf, local_idx)\n        emit_i32_wrap_i64(buf)\n        let nl = compile_expr(buf, value, local_names, next_local + 1, ctx, ld)\n        Array::set(local_names, local_idx, name)\n        emit_i64_store(buf, 3, 0)\n        let nl2 = compile_expr(buf, body, local_names, nl, ctx, ld)\n        emit_local_get(buf, local_idx)\n        emit_i64_const(buf, 1)\n        emit_i64_or(buf)\n        emit_call(buf, ctx.rc_drop_func_idx)\n        nl2\n      } else {\n        emit_global_get(buf, 0)\n        emit_i64_extend_i32_u(buf)\n        emit_local_tee(buf, local_idx)\n        emit_i32_wrap_i64(buf)\n        emit_i32_const(buf, 8)\n        emit_i32_add(buf)\n        emit_global_set(buf, 0)\n        emit_heap_grow_after_heap_set(buf, ctx)\n        emit_local_get(buf, local_idx)\n        emit_i32_wrap_i64(buf)\n        let nl = compile_expr(buf, value, local_names, next_local + 1, ctx, ld)\n        Array::set(local_names, local_idx, name)\n        emit_i64_store(buf, 3, 0)\n        let nl2 = compile_expr(buf, body, local_names, nl, ctx, ld)\n        nl2\n      }\n    } else {\n      let nl = compile_expr(buf, retain_wrap_let_value(value, name, ctx), local_names, next_local + 1, ctx, ld)\n      Array::set(local_names, local_idx, name)\n      emit_local_set(buf, local_idx)\n      let (_mut_rc_kind, _mut_is_borrow_ret_ext) = classify_let_value_heap(buf, value, name, local_idx, local_names, ctx)\n      if ctx.enable_rc {\n        let mut mdbi = 0\n        while mdbi < Array::length(ctx.rc_dup_names) {\n          if Array::get(ctx.rc_dup_names, mdbi) == name {\n            emit_rc_dup_guarded(buf, local_idx, ctx.rc_shadow)\n          } else {\n            ()\n          }\n          mdbi = mdbi + 1\n        }\n      } else {\n        ()\n      }\n      let nl2 = compile_expr(buf, body, local_names, nl, ctx, ld)\n      if ctx.enable_rc && array_contains_str(ctx.heap_binding_names, name) && array_contains_str(ctx.rc_drop_names, name) && ctx.rc_drop_func_idx >= 0 {\n        if scope_tail_proj_root(body) == name {\n          emit_local_set(buf, nl2)\n          emit_rc_dup_guarded(buf, nl2, ctx.rc_shadow)\n          emit_local_get(buf, local_idx)\n          emit_call(buf, ctx.rc_drop_func_idx)\n          emit_local_get(buf, nl2)\n          nl2 + 1\n        } else {\n          emit_local_get(buf, local_idx)\n          emit_call(buf, ctx.rc_drop_func_idx)\n          nl2\n        }\n      } else {\n        nl2\n      }\n    }\n  } else if __tag == 12 {\n    let name = get_eassign_name(expr)\n    let value = get_eassign_val(expr)\n    let body = get_eassign_body(expr)\n    let idx = resolve_local(local_names, name, \"assign\")\n    if array_contains_str(ctx.ref_cell_names, name) {\n      emit_local_get(buf, idx)\n      emit_i32_wrap_i64(buf)\n      let nl = compile_expr(buf, value, local_names, next_local, ctx, ld)\n      emit_i64_store(buf, 3, 0)\n      compile_expr(buf, body, local_names, nl, ctx, ld)\n    } else {\n      let is_heap_mut = ctx.enable_rc && ctx.rc_drop_func_idx >= 0 && array_contains_str(ctx.heap_binding_names, name)\n      let is_self = assign_value_mentions(value, name)\n      if is_heap_mut && is_self && reassign_self_reusable(value, name) {\n        let old_temp = next_local\n        let scratch = next_local + 1\n        let base = next_local + 2\n        emit_local_get(buf, idx)\n        emit_local_set(buf, old_temp)\n        let elems = get_etuple_elems(value)\n        let mut ei = 0\n        while ei < Array::length(elems) {\n          let elem = Array::get(elems, ei)\n          if (is_eident(elem) && get_eident_name(elem) == name) || (is_edot(elem) && proj_root_ident(elem) == name) {\n            let _ = compile_expr(buf, elem, local_names, base, ctx, ld)\n            emit_local_set(buf, scratch)\n            emit_rc_dup_guarded(buf, scratch, ctx.rc_shadow)\n          } else {\n            ()\n          }\n          ei = ei + 1\n        }\n        let nl = compile_expr(buf, value, local_names, base, ctx, ld)\n        emit_local_set(buf, idx)\n        emit_local_get(buf, old_temp)\n        emit_call(buf, ctx.rc_drop_func_idx)\n        compile_expr(buf, body, local_names, nl, ctx, ld)\n      } else {\n        if is_heap_mut && !is_self {\n          emit_local_get(buf, idx)\n          emit_call(buf, ctx.rc_drop_func_idx)\n        } else {\n          ()\n        }\n        let nl = compile_expr(buf, value, local_names, next_local, ctx, ld)\n        emit_local_set(buf, idx)\n        if is_heap_mut && !is_self && is_edot(value) {\n          emit_rc_dup_guarded(buf, idx, ctx.rc_shadow)\n        } else {\n          ()\n        }\n        if ctx.enable_rc && is_heap_mut {\n          let mut adbi = 0\n          while adbi < Array::length(ctx.rc_dup_names) {\n            if Array::get(ctx.rc_dup_names, adbi) == name {\n              emit_rc_dup_guarded(buf, idx, ctx.rc_shadow)\n            } else {\n              ()\n            }\n            adbi = adbi + 1\n          }\n        } else {\n          ()\n        }\n        compile_expr(buf, body, local_names, nl, ctx, ld)\n      }\n    }\n  } else if __tag == 13 {\n    let name = get_eassignop_name(expr)\n    let op = get_eassignop_op(expr)\n    let value = get_eassignop_val(expr)\n    let body = get_eassignop_body(expr)\n    let idx = resolve_local(local_names, name, \"assignop\")\n    if array_contains_str(ctx.ref_cell_names, name) {\n      emit_local_get(buf, idx)\n      emit_i32_wrap_i64(buf)\n      emit_local_get(buf, idx)\n      emit_i32_wrap_i64(buf)\n      emit_i64_load(buf, 3, 0)\n      let nl = compile_expr(buf, value, local_names, next_local, ctx, ld)\n      emit_assignop_op(buf, op)\n      emit_assignop_rc_tag_fix(buf, ctx.enable_rc, op)\n      emit_i64_store(buf, 3, 0)\n      compile_expr(buf, body, local_names, nl, ctx, ld)\n    } else {\n      emit_local_get(buf, idx)\n      let nl = compile_expr(buf, value, local_names, next_local, ctx, ld)\n      emit_assignop_op(buf, op)\n      emit_assignop_rc_tag_fix(buf, ctx.enable_rc, op)\n      emit_local_set(buf, idx)\n      compile_expr(buf, body, local_names, nl, ctx, ld)\n    }\n  } else if __tag == 14 {\n    let first = get_eseq_first(expr)\n    let second = get_eseq_second(expr)\n    emit_dbg_line_for(buf, first, ctx)\n    let nl = compile_expr(buf, first, local_names, next_local, ctx, ld)\n    emit_drop(buf)\n    compile_expr(buf, second, local_names, nl, ctx, ld)\n  } else {\n    compile_expr_tail2(buf, expr, local_names, next_local, ctx, ld, compile_expr)\n  }\n}\n")
}

