"\n\n\n\n\n\n\n\n\n\nfn t6_bind_from_raw(buf: Bytes, arm_pat: Pat, raw_l: Int, ctx: CompileCtx, local_names: Array[String]) -> Unit with { Error } {\n  if is_pctor(arm_pat) {\n    let cargs = get_pctor_args(arm_pat)\n    let decl_arity = effect_op_declared_arity(ctx.effect_op_keys, ctx.effect_op_arities, get_pctor_name(arm_pat))\n    if decl_arity > 1 {\n      let ncargs = Array::length(cargs)\n      let mut ci = 0\n      while ci < decl_arity {\n        if ci < ncargs {\n          let cp = Array::get(cargs, ci)\n          if is_pbind(cp) {\n            let pname = get_pbind_name(cp)\n            let fl = Array::length(local_names)\n            emit_local_get(buf, raw_l)\n            if ctx.enable_rc {\n              emit_i64_const(buf, -2)\n              emit_i64_and(buf)\n            } else {\n              ()\n            }\n            emit_i32_wrap_i64(buf)\n            emit_i64_load(buf, 3, if ctx.enable_rc {\n              8 + ci * 8\n            } else {\n              ci * 8\n            })\n            emit_local_set(buf, fl)\n            Array::push(local_names, pname)\n            if ctx.enable_rc {\n              emit_rc_dup_guarded(buf, fl, ctx.rc_shadow)\n            } else {\n              ()\n            }\n          } else if is_pwild(cp) {\n            ()\n          } else {\n            throw(\"handle: only simple bindings or '_' are supported in multi-argument effect op patterns (see #548)\")\n          }\n        } else {\n          ()\n        }\n        ci = ci + 1\n      }\n      if ctx.enable_rc && ctx.rc_drop_func_idx >= 0 {\n        emit_local_get(buf, raw_l)\n        emit_call(buf, ctx.rc_drop_func_idx)\n      } else {\n        ()\n      }\n    } else if Array::length(cargs) > 0 && is_pbind(Array::get(cargs, 0)) {\n      let pname = get_pbind_name(Array::get(cargs, 0))\n      let bl = Array::length(local_names)\n      emit_local_get(buf, raw_l)\n      emit_local_set(buf, bl)\n      Array::push(local_names, pname)\n    } else {\n      ()\n    }\n  } else {\n    ()\n  }\n}\n\nfn t6_effect_op_count(op_keys: Array[String], eff_name: String) -> Int {\n  let mut c = 0\n  let mut i = 0\n  while i < Array::length(op_keys) {\n    let k = Array::get(op_keys, i)\n    let sep = String::index_of(k, \"::\")\n    if sep > 0 && k[0:sep] == eff_name {\n      c = c + 1\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  c\n}\n\n\nexport fn compile_expr_tail6(buf: Bytes, body: Expr, arms: Array[(Pat, Expr)], local_names: Array[String], next_local: Int, ctx: CompileCtx, ld: Int, compile_expr: (Bytes, Expr, Array[String], Int, CompileCtx, Int) -> Int with { Error }) -> Int with { Error } {\n  if Array::length(arms) > 0 {\n    let (catch_pat, fallback_expr) = Array::get(arms, 0)\n    let is_error = is_pctor(catch_pat) && get_pctor_name(catch_pat) == \"Error::Throw\"\n    let handled_eff = if is_pctor(catch_pat) {\n      let op_full = get_pctor_name(catch_pat)\n      let sep = String::index_of(op_full, \"::\")\n      if sep > 0 {\n        op_full[0:sep]\n      } else {\n        \"\"\n      }\n    } else {\n      \"\"\n    }\n    let needs_op_dispatch = !is_error && String::length(handled_eff) > 0 && t6_effect_op_count(ctx.effect_op_keys, handled_eff) > 1\n    let g_op_idx_global = if ctx.enable_rc {\n      6\n    } else {\n      5\n    }\n    let catch_tag = if is_error {\n      2\n    } else if is_pctor(catch_pat) {\n      effect_name_to_tag(ctx.effect_names, get_pctor_name(catch_pat))\n    } else {\n      3 + Array::length(ctx.effect_names)\n    }\n    let uses_frontier = !is_error\n    let eff_off = (catch_tag - 3) * 131072\n    let g_rbuf = if ctx.enable_rc {\n      5\n    } else {\n      4\n    }\n    let g_cur = if ctx.enable_rc {\n      3\n    } else {\n      2\n    }\n    if uses_frontier {\n      emit_global_get(buf, g_rbuf)\n      emit_i32_const(buf, eff_off)\n      emit_i32_add(buf)\n      emit_i64_const(buf, 0)\n      emit_i64_store(buf, 3, 8)\n    } else {\n      ()\n    }\n    emit_block_i64(buf)\n    emit_loop_void(buf)\n    if uses_frontier {\n      emit_global_get(buf, g_rbuf)\n      emit_i32_const(buf, eff_off)\n      emit_i32_add(buf)\n      emit_i64_const(buf, 0)\n      emit_i64_store(buf, 3, 0)\n    } else {\n      ()\n    }\n    emit_block_i64(buf)\n    bytebuf_push(buf, 31)\n    bytebuf_push(buf, 126)\n    bytebuf_push(buf, 1)\n    bytebuf_push(buf, 0)\n    bytebuf_push(buf, catch_tag)\n    bytebuf_push(buf, 0)\n    let body_names_start = Array::length(local_names)\n    let body_ref_cells_start = Array::length(ctx.ref_cell_names)\n    let _nl1 = compile_expr(buf, body, local_names, next_local, ctx, ld)\n    let mut mask_i = body_names_start\n    while mask_i < Array::length(local_names) {\n      Array::set(local_names, mask_i, \"\")\n      mask_i = mask_i + 1\n    }\n    Array::truncate(ctx.ref_cell_names, body_ref_cells_start)\n    emit_end(buf)\n    emit_br(buf, 2)\n    emit_end(buf)\n    let raw_l = Array::length(local_names)\n    if needs_op_dispatch {\n      emit_local_set(buf, raw_l)\n      Array::push(local_names, \"__eff_raw\")\n    } else if is_pctor(catch_pat) {\n      let cargs = get_pctor_args(catch_pat)\n      let decl_arity = effect_op_declared_arity(ctx.effect_op_keys, ctx.effect_op_arities, get_pctor_name(catch_pat))\n      if decl_arity > 1 {\n        let ptr_l = Array::length(local_names)\n        emit_local_set(buf, ptr_l)\n        Array::push(local_names, \"__eff_payload\")\n        let ncargs = Array::length(cargs)\n        let mut ci = 0\n        while ci < decl_arity {\n          if ci < ncargs {\n            let cp = Array::get(cargs, ci)\n            if is_pbind(cp) {\n              let pname = get_pbind_name(cp)\n              let fl = Array::length(local_names)\n              emit_local_get(buf, ptr_l)\n              if ctx.enable_rc {\n                emit_i64_const(buf, -2)\n                emit_i64_and(buf)\n              } else {\n                ()\n              }\n              emit_i32_wrap_i64(buf)\n              emit_i64