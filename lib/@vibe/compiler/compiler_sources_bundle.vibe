fn emit_ref_func(buf: Bytes, func_idx: Int) -> Unit {\n  bytebuf_push_opcode_u32(buf, 210, func_idx)\n}\n\nexport fn emit_ref_null(buf: Bytes, heap_type_byte: Int) -> Unit {\n  bytebuf_push2(buf, 208, heap_type_byte)\n}\n\nlet op_i32_store8 = 58\n\nexport fn emit_block_i64(buf: Bytes) -> Unit {\n  bytebuf_push2(buf, op_block, bt_i64)\n}\n\nexport fn emit_i32_store(buf: Bytes, align: Int, offset: Int) -> Unit {\n  bytebuf_push_opcode_u32_u32(buf, op_i32_store, align, offset)\n}\n\nexport fn emit_i64_store(buf: Bytes, align: Int, offset: Int) -> Unit {\n  bytebuf_push_opcode_u32_u32(buf, 55, align, offset)\n}\n\nexport fn emit_i64_const(buf: Bytes, value: Int) -> Unit {\n  bytebuf_push_opcode_s64(buf, op_i64_const, value)\n}\n\nexport fn emit_i64_div_s(buf: Bytes) -> Unit {\n  bytebuf_push(buf, op_i64_div_s)\n}\n\nexport fn emit_i64_rem_s(buf: Bytes) -> Unit {\n  bytebuf_push(buf, op_i64_rem_s)\n}\n\nexport fn emit_i64_shr_s(buf: Bytes) -> Unit {\n  bytebuf_push(buf, op_i64_shr_s)\n}\n\nexport fn emit_local_get(buf: Bytes, idx: Int) -> Unit {\n  bytebuf_push_opcode_u32(buf, op_local_get, idx)\n}\n\nexport fn emit_local_set(buf: Bytes, idx: Int) -> Unit {\n  bytebuf_push_opcode_u32(buf, op_local_set, idx)\n}\n\nexport fn emit_local_tee(buf: Bytes, idx: Int) -> Unit {\n  bytebuf_push_opcode_u32(buf, op_local_tee, idx)\n}\n\nexport fn emit_loop_void(buf: Bytes) -> Unit {\n  bytebuf_push2(buf, op_loop, bt_void)\n}\n\nlet op_i32_load8_u = 45\n\nexport fn emit_block_void(buf: Bytes) -> Unit {\n  bytebuf_push2(buf, op_block, bt_void)\n}\n\nexport fn emit_i32_store8(buf: Bytes, align: Int, offset: Int) -> Unit {\n  bytebuf_push_opcode_u32_u32(buf, op_i32_store8, align, offset)\n}\n\nexport fn emit_struct_get(buf: Bytes, type_idx: Int, field_idx: Int) -> Unit {\n  bytebuf_push_opcode_u32_u32(buf, 251, 2, type_idx)\n  leb128_encode_u32(buf, field_idx)\n}\n\nexport fn emit_struct_new(buf: Bytes, type_idx: Int) -> Unit {\n  bytebuf_push_opcode_u32_u32(buf, 251, 0, type_idx)\n}\n\