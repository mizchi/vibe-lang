  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SLet(_, _, iw_name, _, iw_expr) => match iw_expr {\n        EFn(_, _, _, _, _, iw_body) => match iw_body {\n          ECall(iw_cal, iw_args, _) => match iw_cal {\n            EIdent(iw_cn, _) => if iw_cn == \"%wasm\" && Array::length(iw_args) == 1 {\n              throw(\"inline wasm fn '\\{iw_name}' (= wasm \\\"...\\\") is linear-backend only; the wasm-gc backend does not support it (#805)\")\n            } else {\n              ()\n            },\n            _ => ()\n          },\n          _ => ()\n        },\n        _ => ()\n      },\n      _ => ()\n    }\n    i = i + 1\n  }\n}\n\nexport fn gc_to_string_resolves_to_show_wrapper(stmts: Array[Stmt]) -> Bool {\n  let mut i = 0\n  let mut found = false\n  let mut found_value = EUnit\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SLet(_, _, tsw_name, _, tsw_value) => if tsw_name == \"to_string\" {\n        found = true\n        found_value = tsw_value\n      } else {\n        ()\n      },\n      _ => ()\n    }\n    i = i + 1\n  }\n  if found {\n    gc_efn_is_show_to_string_wrapper(found_value)\n  } else {\n    false\n  }\n}\n\nfn gc_efn_is_show_to_string_wrapper(value: Expr) -> Bool {\n  match value {\n    EFn(tsw_tparams, tsw_bounds, tsw_params, _, _, tsw_body) => if Array::length(tsw_tparams) == 1 && Array::length(tsw_params) == 1 {\n      let tsw_tparam = Array::get(tsw_tparams, 0)\n      let (tsw_pname, tsw_pty) = Array::get(tsw_params, 0)\n      let tsw_ty_matches = match tsw_pty {\n        Some(TyName(tsw_ptn)) => tsw_ptn == tsw_tparam,\n        _ => false\n      }\n      tsw_ty_matches && gc_bounds_has_show(tsw_bounds, tsw_tparam) && gc_body_is_to_string_forward(tsw_body, tsw_pname)\n    } else {\n      false\n    },\n    _ => false\n  }\n}\n\nfn gc_bounds_has_show(bounds: Array[(String, Array[String])], tparam: String) -> Bool {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(bounds) {\n    let (bname, btraits) = Array::get(bounds, i)\n    if bname == tparam {\n      let mut j = 0\n      while j < Array::length(btraits) {\n        if Array::get(btraits, j) == \"Show\" {\n          found = true\n        } else {\n          ()\n        }\n        j = j + 1\n      }\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  found\n}\n\nfn gc_body_is_to_string_forward(body: Expr, pname: String) -> Bool {\n  match body {\n    ECall(tsf_callee, tsf_args, _) => match tsf_callee {\n      EIdent(tsf_cn, _) => tsf_cn == \"__to_string\" && Array::length(tsf_args) == 1 && (match Array::get(tsf_args, 0) {\n        EIdent(tsf_an, _) => tsf_an == pname,\n        _ => false\n      }),\n      _ => false\n    },\n    _ => false\n  }\n}\n\nexport fn compile_wasi_module_gc(stmts: Array[Stmt], entry_name: String, gc_to_string_is_wrapper: Bool) -> Bytes with { Error } {\n  gc_reject_inline_wasm(stmts)\n  rewrite_top_level_fn_alias_refs(stmts)\n  rewrite_self_tail_calls(stmts)\n  inline_direct_performs(stmts)\n  let edp_errs = evidence_dict_pass(stmts, entry_name)\n  if Array::length(edp_errs) > 0 {\n    throw(Array::get(edp_errs, 0))\n  } else {\n    ()\n  }\n  let fn_names_list = array_empty()\n  let fn_param_counts = array_empty()\n  let fn_needs_env_list = array_empty()\n  let user_func_stmts = array_empty()\n  let mut i = 0\n  while i < Array::length(stmts) {\n    let stmt = Array::get(stmts, i)\n    match stmt {\n      SLet(_, _, name, _, expr) => match expr {\n        EFn(_, _, params, _, _, _) => {\n          Array::push(fn_names_list, name)\n          Array::push(fn_param_counts, Array::length(params))\n          Array::push(fn_needs_env_list, true)\n          Array::push(user_func_stmts, stmt)\n          0\n        },\n        _ => 0\n      }\n      ,\n      _ => 0\n    }\n    i = i + 1\n  }\n  let ctor_names_list = Array::slice([\n    \"None\",\n    \"Some\"\n  ], 0, 2)\n  let ctor_tags_list = Array::slice([\n    0,\n    1\n  ], 0, 2)\n  let ctor_field_counts_list = Array::slice([\n    0,\n    1\n  ], 0, 2)\n  let ctor_type_names_list = Array::slice([\n    \"Option\",\n    \"Option\"\n  ], 0, 2)\n  let mut type_index = 1\n  let mut ei2 = 0\n  while ei2 < Array::length(stmts) {\n    match Array::get(stmts, ei2) {\n      SEnum(_, ename, _, variants, _) => {\n        type_index = type_index + 1\n        let mut vi = 0\n        while vi < Array::length(variants) {\n          let (vname, vfields) = Array::get(variants, vi)\n          Array::push(ctor_names_list, vname)\n          Array::push(ctor_tags_list, (type_index<<16)|vi)\n          Array::push(ctor_field_counts_list, Array::length(vfields))\n          Array::push(ctor_type_names_list, ename)\n          vi = vi + 1\n        }\n        0\n      },\n      SStruct(_, sname, sfields, _, _, _) => {\n        type_index = type_index + 1\n        Array::push(ctor_names_list, sname)\n        Array::push(ctor_tags_list, type_index<<16)\n        Array::push(ctor_field_counts_list, Array::length(sfields))\n        Array::push(ctor_type_names_list, sname)\n        0\n      },\n      SSuberror(_, ename, variants) => {\n        type_index = type_index + 1\n        let mut vi = 0\n        while vi < Array::length(variants) {\n          let (vname, vfields) = Array::get(variants, vi)\n          Array::push(ctor_names_list, vname)\n          Array::push(ctor_tags_list, (type_index<<16)|vi)\n          Array::push(ctor_field_counts_list, Array::length(vfields))\n          Array::push(ctor_type_names_list, ename)\n          vi = vi + 1\n        }\n        0\n      },\n      _ => 0\n    }\n    ei2 = ei2 + 1\n  }\n  let (gc_ctor_names_sorted, gc_ctor_names_sorted_pos) = ctor_sorted_index(ctor_names_list)\n  let gc_const_names_l = array_empty()\n  let gc_const_kinds_l = array_empty()\n  let gc_const_ivals_l = array_empty()\n  let gc_const_svals_l = array_empty()\n  let gc_global_names_l = array_empty()\n  let gc_global_exprs_l = array_empty()\n  let mut gci = 0\n  while gci < Array::length(stmts) {\n    match Array::get(stmts, gci) {\n      SLet(_, _, cname, _, cval) => match cval {\n        EInt(iv) => {\n          Array::push(gc_const_names_l, cname)\n          Array::push(gc_const_kinds_l, 0)\n          Array::push(gc_const_ivals_l, iv)\n          Array::push(gc_const_svals_l, \"\")\n        },\n        EBool(bv) => {\n          Array::push(gc_const_names_l, cname)\n          Array::push(gc_const_kinds_l, 0)\n          Array::push(gc_const_ivals_l, if bv {\n            1\n          } else {\n            0\n          })\n          Array::push(gc_const_svals_l, \"\")\n        },\n        EString(sv) => {\n          Array::push(gc_const_names_l, cname)\n          Array::push(gc_const_kinds_l, 1)\n          Array::push(gc_const_ivals_l, 0)\n          Array::push(gc_const_svals_l, sv)\n        },\n        EFn(_, _, _, _, _, _) => (),\n        _ => {\n          Array::push(gc_global_names_l, cname)\n          Array::push(gc_global_exprs_l, cval)\n        }\n      },\n      _ => ()\n    }\n    gci = gci + 1\n  }\n  let struct_names = array_empty()\n  let struct_field_names = array_empty()\n  let mut si = 0\n  while si < Array::length(stmts) {\n    match Array::get(stmts, si) {\n      SStruct(_, sname, sfields, _, _, _) => {\n        Array::push(struct_names, sname)\n        let fnames = array_empty()\n        let mut sfi = 0\n        while sfi < Array::length(sfields) {\n          let (fname, _) = Array::get(sfields, sfi)\n          Array::push(fnames, fname)\n          sfi = sfi + 1\n        }\n        Array::push(struct_field_names, fnames)\n        ()\n      },\n      _ => ()\n    }\n    si = si + 1\n  }\n  let num_user_funcs = Array::length(fn_names_list)\n  if num_user_funcs == 0 {\n    throw(\"no functions found to compile\")\n  }\n  let mut entry_user_idx = -1\n  let mut ei = 0\n  while ei < num_user_funcs {\n    if Array::get(fn_names_list, ei) == entry_name {\n      entry_user_idx = ei\n    }\n    ei = ei + 1\n  }\n  if entry_user_idx < 0 {\n    throw(String::concat(\"entry function not found: \", entry_name))\n  }\n  let str_strs = collect_strings_stmts(stmts)\n  if !array_contains_str(str_strs, \"\") {\n    Array::push(str_strs, \"\")\n  }\n  if !array_contains_str(str_strs, \"\\n\") {\n    Array::push(str_strs, \"\\n\")\n  }\n  let num_strings = Array::length(str_strs)\n  let data_base = 64\n  let str_offsets = array_empty()\n  let str_lengths = array_empty()\n  let mut str_pos = data_base\n  let mut si = 0\n  while si < num_strings {\n    let s = Array::get(str_strs, si)\n    let slen = String::length(s)\n    Array::push(str_offsets, str_pos)\n    Array::push(str_lengths, slen)\n    str_pos = str_pos + slen\n    si = si + 1\n  }\n  let heap_start = ((str_pos + 7) / 8) * 8\n  let num_generated = 42\n  let use_host = stmts_use_builtin(stmts, fn_names_list, \"Env::get\") || stmts_use_builtin(stmts, fn_names_list, \"Env::args_len\") || stmts_use_builtin(stmts, fn_names_list, \"Env::args_get\") || stmts_use_builtin(stmts, fn_names_list, \"Fs::read_file\") || stmts_use_builtin(stmts, fn_names_list, \"Fs::exists\") || stmts_use_builtin(stmts, fn_names_list, \"Fs::stat_token\") || stmts_use_builtin(stmts, fn_names_list, \"Fs::write_file\") || stmts_use_builtin(stmts, fn_names_list, \"Fs::write_bytes\") || stmts_use_builtin(stmts, fn_names_list, \"Fs::read_bytes\") || stmts_use_builtin(stmts, fn_names_list, \"Profiler::now_us\")\n  let hbo = if use_host {\n    10\n  } else {\n    0\n  }\n  let func_offset = 1 + hbo + num_generated\n  let builtin_defs = array_empty()\n  let gc_registry_rows = builtin_registry()\n  let mut gc_reg_i = 0\n  while gc_reg_i < Array::length(gc_registry_rows) {\n    let (gc_name, gc_params, gc_returns, _, gc_in_gc) = Array::get(gc_registry_rows, gc_reg_i)\n    if gc_in_gc {\n      let gc_body_idx = match gc_name {\n        \"print_int\" => 1,\n        \"print_str\" => 2,\n        \"String::length\" => 3,\n        \"String::equals\" => 4,\n        \"String::concat\" => 5,\n        \"array_new\" => 6,\n        \"Array::length\" => 7,\n        \"Array::get\" => 8,\n        \"Array::push\" => 9,\n        \"Array::set\" => 10,\n        \"Double::to_int\" => 11,\n        \"Int::to_double\" => 12,\n        \"String::char_code_at\" => 13,\n        \"String::from_char_code\" => 14,\n        \"String::substring\" => 15,\n        \"ArrayBuilder::new\" => 6,\n        \"ArrayBuilder::push\" => 9,\n        \"ArrayBuilder::freeze\" => 16,\n        \"FrozenArray::from_array\" => 16,\n        \"FrozenArray::to_array\" => 16,\n        \"FrozenArray::get\" => 8,\n        \"FrozenArray::length\" => 7,\n        \"Array::slice\" => 38,\n        \"Array::concat\" => 39,\n        \"Array::truncate\" => 40,\n        \"Array::push_all\" => 41,\n        \"str_lex_diff\" => 42,\n        \"eq\" => 29,\n        \"not\" => 6,\n        \"String::join\" => 35,\n        \"String::ends_with\" => 33,\n        \"String::last_index_of\" => 34,\n        \"String::starts_with\" => 32,\n        \"String::contains\" => 31,\n        \"String::index_of\" => 30,\n        \"String::split\" => 36,\n        \"String::trim\" => 37,\n        \"Bytes::new\" => 18,\n        \"Bytes::length\" => 7,\n        \"Bytes::get\" => 19,\n        \"Bytes::set\" => 20,\n        \"Bytes::push\" => 21,\n        \"Bytes::append\" => 22,\n        \"Bytes::concat\" => 23,\n        \"Bytes::slice\" => 24,\n        \"Bytes::from_array\" => 25,\n        \"Bytes::to_array\" => 26,\n        \"Bytes::blit\" => 27,\n        \"Bytes::fill\" => 28,\n        \"Double::to_i64_bits\" => 16,\n        \"Double::from_i64_bits\" => 16,\n        \"Double::to_float\" => 16,\n        \"Float::to_double\" => 16,\n        \"Char::to_int\" => 16,\n        \"Char::from_int\" => 16,\n        \"Int::to_float\" => 12,\n        \"FixedArray::make\" => 6,\n        \"FixedArray::length\" => 6,\n        \"FixedArray::get\" => 6,\n        \"FixedArray::set\" => 6,\n        \"FixedArray::unsafe_set\" => 6,\n        \"FixedArray::blit\" => 6,\n        \"Int64Array::make\" => 6,\n        \"Int64Array::length\" => 6,\n        \"Int64Array::get\" => 6,\n        \"Int64Array::set\" => 6,\n        \"StringBuilder::new\" => 6,\n        \"StringBuilder::push\" => 6,\n        \"StringBuilder::freeze\" => 6,\n        \"Map::get\" => 6,\n        \"Map::keys\" => 6,\n        \"MapBuilder::new\" => 6,\n        \"MapBuilder::set\" => 6,\n        \"MapBuilder::freeze\" => 6,\n        \"MapBuilder::has_key\" => 6,\n        \"MapBuilder::get\" => 6,\n        \"__to_string\" => 17,\n        \"assert\" => 6,\n        \"assert_true\" => 6,\n        \"assert_eq\" => 6,\n        \"println\" => 6,\n        \"print\" => 6,\n        \"map_has\" => 6,\n        _ => 0 - 1\n      }\n      if gc_body_idx < 0 {\n        throw(\"builtin registry drift: no gc body-index mapping for builtin '\\{gc_name}' (add a match arm in backend_body.vibe, #415)\")\n      } else {\n        ()\n      }\n      Array::push(builtin_defs, (gc_name, gc_params, gc_body_idx, gc_returns))\n    } else {\n      ()\n    }\n    gc_reg_i = gc_reg_i + 1\n  }\n  let __reg_names = array_empty()\n  let __reg_params = array_empty()\n  let __reg_returns = array_empty()\n  let mut __ri = 0\n  while __ri < Array::length(builtin_defs) {\n    let (rbname, rbparams, _, rbreturns) = Array::get(builtin_defs, __ri)\n    Array::push(__reg_names, rbname)\n    Array::push(__reg_params, rbparams)\n    Array::push(__reg_returns, rbreturns)\n    __ri = __ri + 1\n  }\n  verify_lane_builtins(\"gc\", __reg_names, __reg_params, __reg_returns)\n  let mut __bi = 0\n  while __bi < Array::length(builtin_defs) {\n    let (bname, bparams, _, _) = Array::get(builtin_defs, __bi)\n    Array::push(fn_names_list, bname)\n    Array::push(fn_param_counts, bparams)\n    Array::push(fn_needs_env_list, false)\n    __bi = __bi + 1\n  }\n  let fn_indices_list = array_empty()\n  let fn_returns_list = array_empty()\n  let mut fi = 0\n  while fi < num_user_funcs {\n    Array::push(fn_indices_list, fi + func_offset)\n    Array::push(fn_returns_list, 1)\n    fi = fi + 1\n  }\n  let mut __bi2 = 0\n  while __bi2 < Array::length(builtin_defs) {\n    let (_, _, bwasm_idx, breturns) = Array::get(builtin_defs, __bi2)\n    Array::push(fn_indices_list, bwasm_idx + hbo)\n    Array::push(fn_returns_list, breturns)\n    __bi2 = __bi2 + 1\n  }\n  if use_host {\n    let host_defs = [\n      (\"Env::get\", 1, 1, 1),\n      (\"Env::args_len\", 0, 2, 1),\n      (\"Env::args_get\", 1, 3, 1),\n      (\"Fs::read_file\", 1, 4, 1),\n      (\"Fs::exists\", 1, 5, 1),\n      (\"Fs::stat_token\", 1, 6, 1),\n      (\"Fs::write_file\", 2, 7, 0),\n      (\"Fs::write_bytes\", 2, 8, 0),\n      (\"Fs::read_bytes\", 1, 9, 1),\n      (\"Profiler::now_us\", 0, 10, 1)\n    ]\n    let mut __hd = 0\n    while __hd < Array::length(host_defs) {\n      let (hname, hparams, hidx, hret) = Array::get(host_defs, __hd)\n      Array::push(fn_names_list, hname)\n      Array::push(fn_param_counts, hparams)\n      Array::push(fn_needs_env_list, false)\n      Array::push(fn_indices_list, hidx)\n      Array::push(fn_returns_list, hret)\n      __hd = __hd + 1\n    }\n  } else {\n    ()\n  }\n  let ft_names = array_empty()\n  let ft_indices = array_empty()\n  let gc_agg_ret_names_l = array_empty()\n  let gc_agg_ret_infos_l = array_empty()\n  compute_agg_returning(stmts, CtorTable::{\n    names: ctor_names_list, tags: ctor_tags_list, field_counts: ctor_field_counts_list, type_names: ctor_type_names_list, struct_names: struct_names, struct_field_names: struct_field_names, names_sorted: gc_ctor_names_sorted, names_sorted_pos: gc_ctor_names_sorted_pos\n  }, gc_agg_ret_names_l, gc_agg_ret_infos_l)\n  let ft_params = array_empty()\n  let ft_returns = array_empty()\n  let ft_needs_env = array_empty()\n  let mut ft_copy_i = 0\n  while ft_copy_i < Array::length(fn_names_list) {\n    Array::push(ft_names, Array::get(fn_names_list, ft_copy_i))\n    Array::push(ft_indices, Array::get(fn_indices_list, ft_copy_i))\n    Array::push(ft_params,