let selfhost_source_67 = () -> (String, String) {
  ("lib/@vibe/compiler/codegen/common_extractors/index.vibe",
"\n\n\nlet op_prefix = 252\n\n\nexport fn first_offset(e: Expr) -> Int {\n  match e {\n    EIdent(_, off) => off,\n    ECall(callee, _, off) => if off >= 0 { off } else { first_offset(callee) },\n    EDot(base, _, off, _) => if off >= 0 { off } else { first_offset(base) },\n    EBinOp(_, lhs, _) => first_offset(lhs),\n    EUnaryOp(_, inner) => first_offset(inner),\n    ELet(_, val, _, _) => first_offset(val),\n    ELetRec(_, val, _) => first_offset(val),\n    ELetMut(_, val, _, _) => first_offset(val),\n    EAssign(_, val, _) => first_offset(val),\n    EAssignOp(_, _, val, _) => first_offset(val),\n    ESeq(first, _) => first_offset(first),\n    EIf(cond, _, _) => first_offset(cond),\n    EMatch(scrut, _) => first_offset(scrut),\n    EReturn(inner) => first_offset(inner),\n    _ => -1\n  }\n}\n\nexport fn offset_to_line(nl: Array[Int], off: Int) -> Int {\n  let n = Array::length(nl)\n  let mut i = 0\n  let mut count = 0\n  while i < n {\n    if Array::get(nl, i) < off {\n      count = count + 1\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  count + 1\n}\n\nexport fn build_newline_offsets(src: String) -> Array[Int] {\n  let arr = Array::slice([\n    0\n  ], 0, 0)\n  let n = String::length(src)\n  let mut i = 0\n  while i < n {\n    if String::char_code_at(src, i) == 10 {\n      Array::push(arr, i)\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  arr\n}\n\nexport fn get_ebinop_lhs(expr: Expr) -> Expr with { Error } {\n  match expr {\n    EBinOp(_, lhs, _) => lhs,\n    _ => throw(\"not EBinOp\")\n  }\n}\n\nexport fn get_ebinop_rhs(expr: Expr) -> Expr with { Error } {\n  match expr {\n    EBinOp(_, _, rhs) => rhs,\n    _ => throw(\"not EBinOp\")\n  }\n}\n\nexport fn get_ecall_args(expr: Expr) -> Array[Expr] with { Error } {\n  match expr {\n    ECall(_, args, _) => args,\n    _ => throw(\"not ECall\")\n  }\n}\n\nexport fn get_efn_params(expr: Expr) -> Array[(String, Option[TypeExpr])] with { Error } {\n  match expr {\n    EFn(_, _, params, _, _, _) => params,\n    _ => throw(\"not EFn\")\n  }\n}\n\nexport fn get_eint_value(expr: Expr) -> Int with { Error } {\n  match expr {\n    EInt(n) => n,\n    _ => throw(\"not EInt\")\n  }\n}\n\nexport fn get_eseq_first(expr: Expr) -> Expr with { Error } {\n  match expr {\n    ESeq(first, _) => first,\n    _ => throw(\"not ESeq\")\n  }\n}\n\nexport fn get_match_arms(expr: Expr) -> Array[(Pat, Expr)] with { Error } {\n  match expr {\n    EMatch(_, arms) => arms,\n    _ => throw(\"get_match_arms: not an EMatch\")\n  }\n}\n\nexport fn get_pbind_name(p: Pat) -> String with { Error } {\n  match p {\n    PBind(name) => name,\n    _ => throw(\"get_pbind_name: not a PBind\")\n  }\n}\n\nexport fn get_pctor_args(p: Pat) -> Array[Pat] with { Error } {\n  match p {\n    PCtor(_, args) => args,\n    _ => throw(\"get_pctor_args: not a PCtor\")\n  }\n}\n\nexport fn get_pctor_name(p: Pat) -> String with { Error } {\n  match p {\n    PCtor(name, _) => name,\n    _ => throw(\"get_pctor_name: not a PCtor\")\n  }\n}\n\nexport fn get_pint_value(p: Pat) -> Int with { Error } {\n  match p {\n    PInt(n) => n,\n    _ => throw(\"get_pint_value: not a PInt\")\n  }\n}\n\nexport fn get_pfloat_value(p: Pat) -> Double with { Error } {\n  match p {\n    PFloat(v) => v,\n    _ => throw(\"get_pfloat_value: not a PFloat\")\n  }\n}\n\nexport fn get_eassign_val(expr: Expr) -> Expr with { Error } {\n  match expr {\n    EAssign(_, val, _) => val,\n    _ => throw(\"not EAssign\")\n  }\n}\n\nexport fn get_ebool_value(expr: Expr) -> Bool with { Error } {\n  match expr {\n    EBool(b) => b,\n    _ => throw(\"not EBool\")\n  }\n}\n\nexport fn get_eforin_body(expr: Expr) -> Expr with { Error } {\n  match expr {\n    EForIn(_, _, _, body) => body,\n    _ => throw(\"not EForIn\")\n  }\n}\n\nexport fn get_eforin_iter(expr: Expr) -> Expr with { Error } {\n  match expr {\n    EForIn(_, _, iter, _) => iter,\n    _ => throw(\"not EForIn\")\n  }\n}\n\nexport fn get_eforin_name(expr: Expr) -> String with { Error } {\n  match expr {\n    EForIn(name, _, _, _) => name,\n    _ => throw(\"not EForIn\")\n  }\n}\n\nexport fn get_eforin_index(expr: Expr) -> Option[String] with { Error } {\n  match expr {\n    EForIn(_, index_name, _, _) => index_name,\n    _ => throw(\"not EForIn\")\n  }\n}\n\nexport fn get_eident_name(expr: Expr) -> String with { Error } {\n  match expr {\n    EIdent(name, _) => name,\n    _ => throw(\"not EIdent\")\n  }\n}\n\nexport fn get_eletmut_val(expr: Expr) -> Expr with { Error } {\n  match expr {\n    ELetMut(_, val, _, _) => val,\n    _ => throw(\"not ELetMut\")\n  }\n}\n\nexport fn get_eletrec_val(expr: Expr) -> Expr with { Error } {\n  match expr {\n    ELetRec(_, val, _) => val,\n    _ => throw(\"not ELetRec\")\n  }\n}\n\nexport fn get_eseq_second(expr: Expr) -> Expr with { Error } {\n  match expr {\n    ESeq(_, second) => second,\n    _ => throw(\"not ESeq\")\n  }\n}\n\nexport fn get_ereturn_expr(expr: Expr) -> Expr with { Error } {\n  match expr {\n    EReturn(e) => e,\n    _ => throw(\"not EReturn\")\n  }\n}\n\nexport fn get_eunaryop_op(expr: Expr) -> String with { Error } {\n  match expr {\n    EUnaryOp(op, _) => op,\n    _ => throw(\"not EUnaryOp\")\n  }\n}\n\nexport fn get_ewhile_body(expr: Expr) -> Expr with { Error } {\n  match expr {\n    EWhile(_, body) => body,\n    _ => throw(\"not EWhile\")\n  }\n}\n\nexport fn get_ewhile_cond(expr: Expr) -> Expr with { Error } {\n  match expr {\n    EWhile(cond, _) => cond,\n    _ => throw(\"not EWhile\")\n  }\n}\n\nexport fn get_pbool_value(p: Pat) -> Bool with { Error } {\n  match p {\n    PBool(v) => v,\n    _ => throw(\"get_pbool_value: not a PBool\")\n  }\n}\n\nexport fn get_ptuple_pats(p: Pat) -> Array[Pat] with { Error } {\n  match p {\n    PTuple(pats) => pats,\n    _ => throw(\"get_ptuple_pats: not a PTuple\")\n  }\n}\n\nexport fn get_slet_export(stmt: Stmt) -> Bool with { Error } {\n  match stmt {\n    SLet(is_export, _, _, _, _) => is_export,\n    _ => throw(\"not SLet\")\n  }\n}\n\nexport fn is_catchall_pat(p: Pat) -> Bool {\n  match p {\n    PWild => true,\n    PBind(_) => true,\n    PTuple(pats) => {\n      let mut i = 0\n      let mut all_catch = true\n      while i < Array::length(pats) {\n        if !is_catchall_pat(Array::get(pats, i)) {\n          all_catch = false\n        }\n        i = i + 1\n      }\n      all_catch\n    },\n    PStruct(_, fields) => {\n      let mut i = 0\n      let mut all_catch = true\n      while i < Array::length(fields) {\n        let (_, sp) = Array::get(fields, i)\n        if !is_catchall_pat(sp) {\n          all_catch = false\n        }\n        i = i + 1\n      }\n      all_catch\n    },\n    _ => false\n  }\n}\n\nexport fn emit_assignop_op(buf: Bytes, op: String) -> Unit with { Error } {\n  if op == \"+\" {\n    emit_i64_add(buf)\n  }\n  else if op == \"-\" {\n    emit_i64_sub(buf)\n  }\n  else if op == \"*\" {\n    emit_i64_mul(buf)\n  }\n  else if op == \"/\" {\n    emit_i64_div_s(buf)\n  }\n  else if op == \"%\" {\n    emit_i64_rem_s(buf)\n  }\n  else {\n    throw(String::concat(\"unsupported assign op: \", op))\n  }\n}\n\nexport fn emit_memory_copy(buf: Bytes) -> Unit {\n  bytebuf_push(buf, op_prefix)\n  leb128_encode_u32(buf, 10)\n  bytebuf_push(buf, 0)\n  bytebuf_push(buf, 0)\n}\n\nexport fn get_earray_elems(expr: Expr) -> Array[Expr] with { Error } {\n  match expr {\n    EArray(elems) => elems,\n    _ => throw(\"not EArray\")\n  }\n}\n\nexport fn get_eassign_body(expr: Expr) -> Expr with { Error } {\n  match expr {\n    EAssign(_, _, body) => body,\n    _ => throw(\"not EAssign\")\n  }\n}\n\nexport fn get_eassign_name(expr: Expr) -> String with { Error } {\n  match expr {\n    EAssign(name, _, _) => name,\n    _ => throw(\"not EAssign\")\n  }\n}\n\nexport fn get_eassignop_op(expr: Expr) -> String with { Error } {\n  match expr {\n    EAssignOp(_, op, _, _) => op,\n    _ => throw(\"not EAssignOp\")\n  }\n}\n\nexport fn get_ecall_callee(expr: Expr) -> Expr with { Error } {\n  match expr {\n    ECall(callee, _, _) => callee,\n    _ => throw(\"not ECall\")\n  }\n}\n\nexport fn get_efloat_value(expr: Expr) -> Double with { Error } {\n  match expr {\n    EFloat(v) => v,\n    _ => throw(\"not EFloat\")\n  }\n}\n\nexport fn get_eletmut_body(expr: Expr) -> Expr with { Error } {\n  match expr {\n    ELetMut(_, _, body, _) => body,\n    _ => throw(\"not ELetMut\")\n  }\n}\n\nexport fn get_eletmut_name(expr: Expr) -> String with { Error } {\n  match expr {\n    ELetMut(name, _, _, _) => name,\n    _ => throw(\"not ELetMut\")\n  }\n}\n\nexport fn get_eletrec_body(expr: Expr) -> Expr with { Error } {\n  match expr {\n    ELetRec(_, _, body) => body,\n    _ => throw(\"not ELetRec\")\n  }\n}\n\nexport fn get_eletrec_name(expr: Expr) -> String with { Error } {\n  match expr {\n    ELetRec(name, _, _) => name,\n    _ => throw(\"not ELetRec\")\n  }\n}\n\nexport fn get_etuple_elems(expr: Expr) -> Array[Expr] with { Error } {\n  match expr {\n    ETuple(elems) => elems,\n    _ => throw(\"get_etuple_elems: not an ETuple\")\n  }\n}\n\nexport fn str_table_lookup(strs: Array[String], s: String) -> Int with { Error } {\n  let len = Array::length(strs)\n  let mut i = 0\n  let mut found = -1\n  while i < len {\n    if Array::get(strs, i) == s {\n      found = i\n      i = len\n    } else {\n      i = i + 1\n    }\n  }\n  if found < 0 {\n    throw(String::concat(\"string not in table: \", s))\n  }\n  found\n}\n\nexport fn find_catchall_idx(arms: Array[(Pat, Expr)]) -> Int {\n  let num = Array::length(arms)\n  let mut idx = 0\n  let mut result = num\n  while idx < num {\n    let (p, _) = Array::get(arms, idx)\n    if is_catchall_pat(p) {\n      result = idx\n      idx = num\n    } else {\n      idx = idx + 1\n    }\n  }\n  result\n}\n\nexport fn get_eassignop_val(expr: Expr) -> Expr with { Error } {\n  match expr {\n    EAssignOp(_, _, val, _) => val,\n    _ => throw(\"not EAssignOp\")\n  }\n}\n\nexport fn get_estring_value(expr: Expr) -> String with { Error } {\n  match expr {\n    EString(s) => s,\n    _ => throw(\"not EString\")\n  }\n}\n\nexport fn get_eunaryop_expr(expr: Expr) -> Expr with { Error } {\n  match expr {\n    EUnaryOp(_, e) => e,\n    _ => throw(\"not EUnaryOp\")\n  }\n}\n\nexport fn get_pstring_value(p: Pat) -> String with { Error } {\n  match p {\n    PString(s) => s,\n    _ => throw(\"get_pstring_value: not a PString\")\n  }\n}\n\nexport fn array_contains_str(arr: Array[String], s: String) -> Bool {\n  let len = Array::length(arr)\n  let mut i = 0\n  let mut found = false\n  while i < len {\n    if Array::get(arr, i) == s {\n      found = true\n      i = len\n    } else {\n      i = i + 1\n    }\n  }\n  found\n}\n\nexport fn get_eassignop_body(expr: Expr) -> Expr with { Error } {\n  match expr {\n    EAssignOp(_, _, _, body) => body,\n    _ => throw(\"not EAssignOp\")\n  }\n}\n\nexport fn get_eassignop_name(expr: Expr) -> String with { Error } {\n  match expr {\n    EAssignOp(name, _, _, _) => name,\n    _ => throw(\"not EAssignOp\")\n  }\n}\n\nexport fn get_match_scrutinee(expr: Expr) -> Expr with { Error } {\n  match expr {\n    EMatch(scrutinee, _) => scrutinee,\n    _ => throw(\"get_match_scrutinee: not an EMatch\")\n  }\n}\n")
}

let selfhost_source_68 = () -> (String, String) {
  ("lib/@vibe/compiler/codegen/common_analysis/index.vibe",
"\n\n\n\nlet op_i64_extend_i32_u = 173\n\n\nfn common_analysis_fresh_string_array() -> Array[String] {\n  ArrayBuilder::freeze(ArrayBuilder::new())\n}\n\nfn collect_strings_pat(pat: Pat, out: Array[String]) -> Int {\n  match pat {\n    PString(s) => {\n      let mut pf = false\n      let mut pi = 0\n      while pi < Array::length(out) {\n        if Array::get(out, pi) == s {\n          pf = true\n        }\n        pi = pi + 1\n      }\n      if !pf {\n        Array::push(out, s)\n      }\n      0\n    },\n    PCtor(_, args) => {\n      let mut i = 0\n      while i < Array::length(args) {\n        let _ = collect_strings_pat(Array::get(args, i), out)\n        i = i + 1\n      }\n      0\n    },\n    PTuple(pats) => {\n      let mut i = 0\n      while i < Array::length(pats) {\n        let _ = collect_strings_pat(Array::get(pats, i), out)\n        i = i + 1\n      }\n      0\n    },\n    POr(l, r) => {\n      let _ = collect_strings_pat(l, out)\n      let _ = collect_strings_pat(r, out)\n      0\n    },\n    PStruct(_, fields) => {\n      let mut i = 0\n      while i < Array::length(fields) {\n        let (_, fp) = Array::get(fields, i)\n        let _ = collect_strings_pat(fp, out)\n        i = i + 1\n      }\n      0\n    },\n    _ => 0\n  }\n}\n\nexport fn collect_strings_expr(expr: Expr, out: Array[String]) -> Int {\n  match expr {\n    EString(s) => {\n      let mut found = false\n      let mut i = 0\n      while i < Array::length(out) {\n        if Array::get(out, i) == s {\n          found = true\n        }\n        i = i + 1\n      }\n      if !found {\n        Array::push(out, s)\n      }\n      0\n    },\n    EBinOp(_, lhs, rhs) => {\n      collect_strings_expr(lhs, out)\n      collect_strings_expr(rhs, out)\n    },\n    EUnaryOp(_, operand) => collect_strings_expr(operand, out),\n    EIf(cond, then_e, else_e) => {\n      collect_strings_expr(cond, out)\n      collect_strings_expr(then_e, out)\n      collect_strings_expr(else_e, out)\n    },\n    ECall(callee, args, _) => {\n      collect_strings_expr(callee, out)\n      match callee {\n        EIdent(nm, _) => if nm == \"__to_string\" {\n          collect_strings_expr(EString(\"true\"), out)\n          collect_strings_expr(EString(\"false\"), out)\n        } else {\n          0\n        },\n        _ => 0\n      }\n      let mut i = 0\n      while i < Array::length(args) {\n        collect_strings_expr(Array::get(args, i), out)\n        i = i + 1\n      }\n      0\n    },\n    ELet(_, value, body, _) => {\n      collect_strings_expr(value, out)\n      collect_strings_expr(body, out)\n    },\n    ELetRec(_, value, body) => {\n      collect_strings_expr(value, out)\n      collect_strings_expr(body, out)\n    },\n    ELetMut(_, value, body, _) => {\n      collect_strings_expr(value, out)\n      collect_strings_expr(body, out)\n    },\n    EAssign(_, value, body) => {\n      collect_strings_expr(value, out)\n      collect_strings_expr(body, out)\n    },\n    EAssignOp(_, _, value, body) => {\n      collect_strings_expr(value, out)\n      collect_strings_expr(body, out)\n    },\n    ESeq(first, second) => {\n      collect_strings_expr(first, out)\n      collect_strings_expr(second, out)\n    },\n    EWhile(cond, body) => {\n      collect_strings_expr(cond, out)\n      collect_strings_expr(body, out)\n    },\n    EForIn(_, _, iter_e, body) => {\n      collect_strings_expr(iter_e, out)\n      collect_strings_expr(body, out)\n    },\n    ETuple(elems) => {\n      let mut i = 0\n      while i < Array::length(elems) {\n        collect_strings_expr(Array::get(elems, i), out)\n        i = i + 1\n      }\n      0\n    },\n    EArray(elems) => {\n      let mut i = 0\n      while i < Array::length(elems) {\n        collect_strings_expr(Array::get(elems, i), out)\n        i = i + 1\n      }\n      0\n    },\n    EMatch(scrutinee, arms) => {\n      collect_strings_expr(scrutinee, out)\n      let mut i = 0\n      while i < Array::length(arms) {\n        let (pat, arm_expr) = Array::get(arms, i)\n        let _ = collect_strings_pat(pat, out)\n        collect_strings_expr(arm_expr, out)\n        i = i + 1\n      }\n      0\n    },\n    EFn(_, _, _, _, _, body) => collect_strings_expr(body, out),\n    EReturn(msg) => collect_strings_expr(msg, out),\n    EStringInterp(parts) => {\n      let mut si_p = 0\n      while si_p < Array::length(parts) {\n        if si_p % 2 == 0 {\n          let part = Array::get(parts, si_p)\n          if String::length(part) > 0 {\n            let mut found = false\n            let mut fi2 = 0\n            while fi2 < Array::length(out) {\n              if Array::get(out, fi2) == part { found = true }\n              fi2 = fi2 + 1\n            }\n            if !found { Array::push(out, part) }\n          }\n        }\n        si_p = si_p + 1\n      }\n      0\n    },\n    EHandle(body, arms) => {\n      collect_strings_expr(body, out)\n      let mut hi = 0\n      while hi < Array::length(arms) {\n        let (_, arm_expr) = Array::get(arms, hi)\n        collect_strings_expr(arm_expr, out)\n        hi = hi + 1\n      }\n      0\n    },\n    EMap(fields) => {\n      let mut mi = 0\n      while mi < Array::length(fields) {\n        let (key, val) = Array::get(fields, mi)\n        let mut kf = false\n        let mut ki = 0\n        while ki < Array::length(out) {\n          if Array::get(out, ki) == key { kf = true }\n          ki = ki + 1\n        }\n        if !kf { Array::push(out, key) }\n        collect_strings_expr(val, out)\n        mi = mi + 1\n      }\n      0\n    },\n    ERecord(_, fields, _) => {\n      let mut ri = 0\n      while ri < Array::length(fields) {\n        let (_, fval) = Array::get(fields, ri)\n        collect_strings_expr(fval, out)\n        ri = ri + 1\n      }\n      0\n    },\n    EDot(obj, _, _, _) => collect_strings_expr(obj, out),\n    ELabeledArg(_, _, val) => collect_strings_expr(val, out),\n    _ => 0\n  }\n}\n\nexport fn get_func_param_names(stmt: Stmt) -> Array[String] with { Error } {\n  match stmt {\n    SLet(_, _, _, _, expr) => match expr {\n      EFn(_, _, params, _, _, _) => {\n        let names = common_analysis_fresh_string_array()\n        let mut i = 0\n        while i < Array::length(params) {\n          let (pname, _) = Array::get(params, i)\n          let plen2 = String::length(pname)\n          let clean_name = if plen2 > 0 {\n            let last_char = String::char_code_at(pname, plen2 - 1)\n            if last_char == '~' || last_char == '?' {\n              pname[0:plen2 - 1]\n            } else pname\n          } else pname\n          Array::push(names, clean_name)\n          i = i + 1\n        }\n        names\n      },\n      _ => throw(\"get_func_param_names: not a function\")\n    },\n    _ => throw(\"get_func_param_names: not a let statement\")\n  }\n}\n\nexport fn expr_contains_exceptions(expr: Expr) -> Bool {\n  match expr {\n    EHandle(_, _) => true,\n    EBinOp(_, lhs, rhs) => expr_contains_exceptions(lhs) || expr_contains_exceptions(rhs),\n    EUnaryOp(_, operand) => expr_contains_exceptions(operand),\n    EIf(cond, then_e, else_e) =>\n    expr_contains_exceptions(cond) || expr_contains_exceptions(then_e) || expr_contains_exceptions(else_e),\n    ECall(callee, args, _) => {\n      let mut found = match callee {\n        EIdent(cname, _) => cname == \"resume\" || cname == \"perform\",\n        _ => expr_contains_exceptions(callee)\n      }\n      let mut i = 0\n      while i < Array::length(args) {\n        if expr_contains_exceptions(Array::get(args, i)) {\n          found = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      found\n    },\n    ELet(_, value, body, _) => expr_contains_exceptions(value) || expr_contains_exceptions(body),\n    ELetRec(_, value, body) => expr_contains_exceptions(value) || expr_contains_exceptions(body),\n    ELetMut(_, value, body, _) => expr_contains_exceptions(value) || expr_contains_exceptions(body),\n    EAssign(_, value, body) => expr_contains_exceptions(value) || expr_contains_exceptions(body),\n    EAssignOp(_, _, value, body) => expr_contains_exceptions(value) || expr_contains_exceptions(body),\n    ESeq(first, second) => expr_contains_exceptions(first) || expr_contains_exceptions(second),\n    EWhile(cond, body) => expr_contains_exceptions(cond) || expr_contains_exceptions(body),\n    EForIn(_, _, iter_e, body) => expr_contains_exceptions(iter_e) || expr_contains_exceptions(body),\n    ELoop(params, body) => {\n      let mut i = 0\n      let mut found = expr_contains_exceptions(body)\n      while i < Array::length(params) {\n        let (_, iv) = Array::get(params, i)\n        if expr_contains_exceptions(iv) {\n          found = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      found\n    },\n    EMatch(scrut, arms) => {\n      let mut i = 0\n      let mut found = expr_contains_exceptions(scrut)\n      while i < Array::length(arms) {\n        let (_, arm_body) = Array::get(arms, i)\n        if expr_contains_exceptions(arm_body) {\n          found = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      found\n    },\n    EFn(_, _, _, _, _, body) => expr_contains_exceptions(body),\n    ETuple(elems) => {\n      let mut i = 0\n      let mut found = false\n      while i < Array::length(elems) {\n        if expr_contains_exceptions(Array::get(elems, i)) {\n          found = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      found\n    },\n    EArray(elems) => {\n      let mut i = 0\n      let mut found = false\n      while i < Array::length(elems) {\n        if expr_contains_exceptions(Array::get(elems, i)) {\n          found = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      found\n    },\n    ERecord(_, fields, _) => {\n      let mut i = 0\n      let mut found = false\n      while i < Array::length(fields) {\n        let (_, fval) = Array::get(fields, i)\n        if expr_contains_exceptions(fval) {\n          found = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      found\n    },\n    EMap(fields) => {\n      let mut i = 0\n      let mut found = false\n      while i < Array::length(fields) {\n        let (_, fval) = Array::get(fields, i)\n        if expr_contains_exceptions(fval) {\n          found = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      found\n    },\n    EDot(obj, _, _, _) => expr_contains_exceptions(obj),\n    ELabeledArg(_, _, inner) => expr_contains_exceptions(inner),\n    EReturn(inner) => expr_contains_exceptions(inner),\n    ESpread(inner) => expr_contains_exceptions(inner),\n    EBreak(opt) => match opt {\n      Some(inner) => expr_contains_exceptions(inner),\n      None => false\n    },\n    EContinue(args) => {\n      let mut i = 0\n      let mut found = false\n      while i < Array::length(args) {\n        if expr_contains_exceptions(Array::get(args, i)) {\n          found = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      found\n    },\n    EInt(_) => false,\n    EFloat(_) => false,\n    EString(_) => false,\n    EBool(_) => false,\n    EIdent(_, _) => false,\n    EStringInterp(_) => false,\n    EUnit => false\n  }\n}\n\nexport fn stmts_contain_exceptions(stmts: Array[Stmt]) -> Bool {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SLet(_, _, _, _, expr) => if expr_contains_exceptions(expr) {\n        found = true\n      } else {\n        ()\n      },\n      SLetMut(_, _, expr) => if expr_contains_exceptions(expr) {\n        found = true\n      } else {\n        ()\n      },\n      SLetPat(_, expr) => if expr_contains_exceptions(expr) {\n        found = true\n      } else {\n        ()\n      },\n      SExpr(expr) => if expr_contains_exceptions(expr) {\n        found = true\n      } else {\n        ()\n      },\n      STest(_, expr) => if expr_contains_exceptions(expr) {\n        found = true\n      } else {\n        ()\n      },\n      SBench(_, expr) => if expr_contains_exceptions(expr) {\n        found = true\n      } else {\n        ()\n      },\n      SModule(_, _, inner) => if stmts_contain_exceptions(inner) {\n        found = true\n      } else {\n        ()\n      },\n      _ => ()\n    }\n    i = i + 1\n  }\n  found\n}\n\nexport fn collect_strings_stmts(stmts: Array[Stmt]) -> Array[String] {\n  let out = common_analysis_fresh_string_array()\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SLet(_, _, _, _, expr) => collect_strings_expr(expr, out),\n      _ => 0\n    }\n    i = i + 1\n  }\n  out\n}\n\nexport fn emit_i64_extend_i32_u(buf: Bytes) -> Unit {\n  bytebuf_push(buf, op_i64_extend_i32_u)\n}\n\nexport fn emit_closure_resolve(buf: Bytes, fn_val_local: Int, slot_local: Int, env_local: Int) -> Unit {\n  emit_local_get(buf, fn_val_local)\n  emit_i64_const(buf, 3)\n  emit_i64_and(buf)\n  emit_i64_const(buf, 2)\n  emit_i64_eq(buf)\n  emit_if_void(buf)\n  emit_local_get(buf, fn_val_local)\n  emit_i64_const(buf, 2)\n  emit_i64_shr_s(buf)\n  emit_local_set(buf, slot_local)\n  emit_i64_const(buf, 0)\n  emit_local_set(buf, env_local)\n  emit_else(buf)\n  emit_local_get(buf, fn_val_local)\n  emit_i64_const(buf, -4)\n  emit_i64_and(buf)\n  emit_local_set(buf, env_local)\n  emit_local_get(buf, env_local)\n  emit_i32_wrap_i64(buf)\n  emit_i32_load(buf, 2, 0)\n  emit_i64_extend_i32_u(buf)\n  emit_local_set(buf, slot_local)\n  emit_end(buf)\n}\n\nexport fn emit_closure_call_tail(buf: Bytes, env_local: Int, slot_local: Int, closure_type_base: Int, num_args: Int) -> Unit {\n  emit_local_get(buf, env_local)\n  emit_local_get(buf, slot_local)\n  emit_i32_wrap_i64(buf)\n  emit_call_indirect(buf, closure_type_base + num_args)\n}\n\nfn collect_pattern_bindings(pat: Pat, bindings: Array[String]) -> Int {\n  match pat {\n    PBind(name) => {\n      Array::push(bindings, name); 0\n    },\n    PTuple(pats) => {\n      let mut i = 0\n      while i < Array::length(pats) {\n        collect_pattern_bindings(Array::get(pats, i), bindings)\n        i = i + 1\n      }\n      0\n    },\n    PCtor(_, args) => {\n      let mut i = 0\n      while i < Array::length(args) {\n        collect_pattern_bindings(Array::get(args, i), bindings)\n        i = i + 1\n      }\n      0\n    },\n    POr(l, r) => {\n      collect_pattern_bindings(l, bindings); collect_pattern_bindings(r, bindings)\n    },\n    PStruct(_, fields) => {\n      let mut i = 0\n      while i < Array::length(fields) {\n        let (_, fpat) = Array::get(fields, i)\n        collect_pattern_bindings(fpat, bindings)\n        i = i + 1\n      }\n      0\n    },\n    _ => 0\n  }\n}\n\nfn is_inlined_async_builtin(name: String) -> Bool {\n  name == \"await\" || name == \"Future::ready\" || name == \"Task::spawn\" || name == \"Task::join\" || name == \"Task::cancel\" || name == \"Task::race\" || name == \"Task::timeout\" || name == \"Stream::empty\" || name == \"Stream::once\" || name == \"Stream::map\" || name == \"Stream::filter\" || name == \"Stream::fold\" || name == \"Stream::next\" || name == \"String::to_bytes\" || name == \"Stream::to_string\"\n}\n\nfn is_inlined_scalar_builtin(name: String) -> Bool {\n  name == \"not\" || name == \"add\" || name == \"sub\" || name == \"mul\" || name == \"lt\"\n}\n\nfn ca_perform_error_throw_op_args(args: Array[Expr]) -> Option[Array[Expr]] {\n  if Array::length(args) == 1 {\n    match Array::get(args, 0) {\n      ECall(op_callee, op_args, _) => match op_callee {\n        EIdent(op_name, _) => if op_name == \"Error::Throw\" {\n          Some(op_args)\n        } else {\n          None\n        },\n        _ => None\n      },\n      _ => None\n    }\n  } else {\n    None\n  }\n}\n\nexport fn collect_free_vars_expr(expr: Expr, bound: Array[String], fn_names: Array[String], out: Array[String]) -> Int {\n  match expr {\n    EIdent(name, _) => if array_contains_str(bound, name) {\n      0\n    }\n    else if bsearch_leftmost(fn_names, name) >= 0 {\n      0\n    }\n    else if array_contains_str(out, name) {\n      0\n    }\n    else {\n      Array::push(out, name)\n      0\n    },\n    EInt(_) => 0,\n    EBool(_) => 0,\n    EFloat(_) => 0,\n    EString(_) => 0,\n    EUnit => 0,\n    EBinOp(_, lhs, rhs) => {\n      collect_free_vars_expr(lhs, bound, fn_names, out); collect_free_vars_expr(rhs, bound, fn_names, out)\n    },\n    EUnaryOp(_, operand) => collect_free_vars_expr(operand, bound, fn_names, out),\n    EIf(cond, then_e, else_e) => {\n      collect_free_vars_expr(cond, bound, fn_names, out); collect_free_vars_expr(then_e, bound, fn_names, out); collect_free_vars_expr(else_e, bound, fn_names, out)\n    },\n    ECall(EIdent(cname, _), args, _) => if cname == \"perform\" {\n      match ca_perform_error_throw_op_args(args) {\n        Some(op_args) => {\n          let mut i = 0\n          while i < Array::length(op_args) {\n            collect_free_vars_expr(Array::get(op_args, i), bound, fn_names, out)\n            i = i + 1\n          }\n          0\n        },\n        None => {\n          collect_free_vars_expr(EIdent(cname, 0), bound, fn_names, out)\n          let mut i = 0\n          while i < Array::length(args) {\n            collect_free_vars_expr(Array::get(args, i), bound, fn_names, out)\n            i = i + 1\n          }\n          0\n        }\n      }\n    } else if !array_contains_str(bound, cname) && !(bsearch_leftmost(fn_names, cname) >= 0) && (is_inlined_async_builtin(cname) || is_inlined_scalar_builtin(cname)) {\n      let mut i = 0\n      while i < Array::length(args) {\n        collect_free_vars_expr(Array::get(args, i), bound, fn_names, out)\n        i = i + 1\n      }\n      0\n    } else {\n      collect_free_vars_expr(EIdent(cname, 0), bound, fn_names, out)\n      let mut i = 0\n      while i < Array::length(args) {\n        collect_free_vars_expr(Array::get(args, i), bound, fn_names, out)\n        i = i + 1\n      }\n      0\n    },\n    ECall(callee, args, _) => {\n      collect_free_vars_expr(callee, bound, fn_names, out)\n      let mut i = 0\n      while i < Array::length(args) {\n        collect_free_vars_expr(Array::get(args, i), bound, fn_names, out)\n        i = i + 1\n      }\n      0\n    },\n    ELet(name, value, body, _) => {\n      collect_free_vars_expr(value, bound, fn_names, out)\n      let saved = Array::length(bound)\n      Array::push(bound, name)\n      collect_free_vars_expr(body, bound, fn_names, out)\n      Array::truncate(bound, saved)\n      0\n    },\n    ELetRec(name, value, body) => {\n      let saved = Array::length(bound)\n      Array::push(bound, name)\n      collect_free_vars_expr(value, bound, fn_names, out)\n      collect_free_vars_expr(body, bound, fn_names, out)\n      Array::truncate(bound, saved)\n      0\n    },\n    ELetMut(name, value, body, _) => {\n      collect_free_vars_expr(value, bound, fn_names, out)\n      let saved = Array::length(bound)\n      Array::push(bound, name)\n      collect_free_vars_expr(body, bound, fn_names, out)\n      Array::truncate(bound, saved)\n      0\n    },\n    EAssign(name, value, body) => {\n      if array_contains_str(bound, name) || bsearch_leftmost(fn_names, name) >= 0 || array_contains_str(out, name) {\n        0\n      } else {\n        Array::push(out, name)\n        0\n      }\n      collect_free_vars_expr(value, bound, fn_names, out); collect_free_vars_expr(body, bound, fn_names, out)\n    },\n    EAssignOp(name, _, value, body) => {\n      if array_contains_str(bound, name) || bsearch_leftmost(fn_names, name) >= 0 || array_contains_str(out, name) {\n        0\n      } else {\n        Array::push(out, name)\n        0\n      }\n      collect_free_vars_expr(value, bound, fn_names, out); collect_free_vars_expr(body, bound, fn_names, out)\n    },\n    ESeq(first, second) => {\n      collect_free_vars_expr(first, bound, fn_names, out); collect_free_vars_expr(second, bound, fn_names, out)\n    },\n    EWhile(cond, body) => {\n      collect_free_vars_expr(cond, bound, fn_names, out); collect_free_vars_expr(body, bound, fn_names, out)\n    },\n    EForIn(var_name, index_name, iter_e, body) => {\n      collect_free_vars_expr(iter_e, bound, fn_names, out)\n      let saved = Array::length(bound)\n      Array::push(bound, var_name)\n      match index_name {\n        Some(index_name) => Array::push(bound, index_name),\n        None => ()\n      }\n      collect_free_vars_expr(body, bound, fn_names, out)\n      Array::truncate(bound, saved)\n      0\n    },\n    ETuple(elems) => {\n      let mut i = 0\n      while i < Array::length(elems) {\n        collect_free_vars_expr(Array::get(elems, i), bound, fn_names, out)\n        i = i + 1\n      }\n      0\n    },\n    EArray(elems) => {\n      let mut i = 0\n      while i < Array::length(elems) {\n        collect_free_vars_expr(Array::get(elems, i), bound, fn_names, out)\n        i = i + 1\n      }\n      0\n    },\n    EMatch(scrutinee, arms) => {\n      collect_free_vars_expr(scrutinee, bound, fn_names, out)\n      let mut i = 0\n      while i < Array::length(arms) {\n        let (arm_pat, arm_expr) = Array::get(arms, i)\n        let saved = Array::length(bound)\n        collect_pattern_bindings(arm_pat, bound)\n        collect_free_vars_expr(arm_expr, bound, fn_names, out)\n        Array::truncate(bound, saved)\n        i = i + 1\n      }\n      0\n    },\n    EFn(_, _, params, _, _, body) => {\n      let saved = Array::length(bound)\n      let mut pi = 0\n      while pi < Array::length(params) {\n        let (pname_raw, _) = Array::get(params, pi)\n        let pnl = String::length(pname_raw)\n        let pname = if pnl > 0 {\n          let plc = String::char_code_at(pname_raw, pnl - 1)\n          if plc == '~' || plc == '?' { pname_raw[0:pnl - 1] } else pname_raw\n        } else pname_raw\n        Array::push(bound, pname)\n        pi = pi + 1\n      }\n      collect_free_vars_expr(body, bound, fn_names, out)\n      Array::truncate(bound, saved)\n      0\n    },\n    EBreak(_) => 0,\n    EContinue(_) => 0,\n    EReturn(msg) => collect_free_vars_expr(msg, bound, fn_names, out),\n    EHandle(body, arms) => {\n      collect_free_vars_expr(body, bound, fn_names, out)\n      let mut hi = 0\n      while hi < Array::length(arms) {\n        let (_, arm_expr) = Array::get(arms, hi)\n        collect_free_vars_expr(arm_expr, bound, fn_names, out)\n        hi = hi + 1\n      }\n      0\n    },\n    EDot(obj, _, _, _) => collect_free_vars_expr(obj, bound, fn_names, out),\n    ERecord(_, fields, _) => {\n      let mut ri = 0\n      while ri < Array::length(fields) {\n        let (_, fval) = Array::get(fields, ri)\n        collect_free_vars_expr(fval, bound, fn_names, out)\n        ri = ri + 1\n      }\n      0\n    },\n    ELabeledArg(_, _, arg_expr) => collect_free_vars_expr(arg_expr, bound, fn_names, out),\n    _ => 0\n  }\n}\n\nexport fn collect_free_vars(body: Expr, param_names: Array[String], fn_names: Array[String]) -> Array[String] {\n  collect_free_vars_indexed(body, param_names, sorted_names_of(fn_names))\n}\n\nexport fn collect_free_vars_indexed(body: Expr, param_names: Array[String], fn_name_index: Array[String]) -> Array[String] {\n  let out = common_analysis_fresh_string_array()\n  let bound = Array::slice(param_names, 0, Array::length(param_names))\n  collect_free_vars_expr(body, bound, fn_name_index, out)\n  out\n}\n\nexport fn collect_free_vars_indexed_self(body: Expr, param_names: Array[String], fn_name_index: Array[String], self_name: String) -> Array[String] {\n  let captures = collect_free_vars_indexed(body, param_names, fn_name_index)\n  if self_name == \"\" || array_contains_str(captures, self_name) {\n    captures\n  } else {\n    let no_globals = common_analysis_fresh_string_array()\n    let unfiltered = collect_free_vars_indexed(body, param_names, no_globals)\n    if array_contains_str(unfiltered, self_name) {\n      Array::push(captures, self_name)\n      captures\n    } else {\n      captures\n    }\n  }\n}\n\nexport fn proj_root_ident(e: Expr) -> String {\n  match e {\n    EDot(obj, _, _, _) => proj_root_ident(obj),\n    EIdent(nm, _) => nm,\n    _ => \"\"\n  }\n}\n\nexport fn scope_tail_proj_root(e: Expr) -> String {\n  match e {\n    ELet(_, _, b, _) => scope_tail_proj_root(b),\n    ELetMut(_, _, b, _) => scope_tail_proj_root(b),\n    ELetRec(_, _, b) => scope_tail_proj_root(b),\n    ESeq(_, b) => scope_tail_proj_root(b),\n    EAssign(_, _, b) => scope_tail_proj_root(b),\n    EAssignOp(_, _, _, b) => scope_tail_proj_root(b),\n    EDot(obj, _, _, _) => proj_root_ident(obj),\n    _ => \"\"\n  }\n}\n\nexport fn is_mut_captured_in(expr: Expr, name: String) -> Bool {\n  match expr {\n    EIdent(_, _) => false,\n    EInt(_) => false,\n    EBool(_) => false,\n    EFloat(_) => false,\n    EString(_) => false,\n    EUnit => false,\n    EBinOp(_, lhs, rhs) => is_mut_captured_in(lhs, name) || is_mut_captured_in(rhs, name),\n    EUnaryOp(_, operand) => is_mut_captured_in(operand, name),\n    EIf(cond, then_e, else_e) => is_mut_captured_in(cond, name) || is_mut_captured_in(then_e, name) || is_mut_captured_in(else_e, name),\n    ECall(callee, args, _) => if is_mut_captured_in(callee, name) {\n      true\n    }\n    else {\n      let mut i = 0\n      let mut found = false\n      while i < Array::length(args) {\n        if is_mut_captured_in(Array::get(args, i), name) {\n          found = true\n        }\n        i = i + 1\n      }\n      found\n    },\n    ELet(n, value, body, _) => if n == name {\n      is_mut_captured_in(value, name)\n    }\n    else {\n      is_mut_captured_in(value, name) || is_mut_captured_in(body, name)\n    },\n    ELetRec(n, value, body) => if n == name {\n      false\n    }\n    else {\n      is_mut_captured_in(value, name) || is_mut_captured_in(body, name)\n    },\n    ELetMut(n, value, body, _) => if n == name {\n      is_mut_captured_in(value, name)\n    }\n    else {\n      is_mut_captured_in(value, name) || is_mut_captured_in(body, name)\n    },\n    EAssign(_, value, body) => is_mut_captured_in(value, name) || is_mut_captured_in(body, name),\n    EAssignOp(_, _, value, body) => is_mut_captured_in(value, name) || is_mut_captured_in(body, name),\n    ESeq(first, second) => is_mut_captured_in(first, name) || is_mut_captured_in(second, name),\n    EWhile(cond, body) => is_mut_captured_in(cond, name) || is_mut_captured_in(body, name),\n    EForIn(_, _, iter_e, body) => is_mut_captured_in(iter_e, name) || is_mut_captured_in(body, name),\n    ETuple(elems) => {\n      let mut i = 0\n      let mut found = false\n      while i < Array::length(elems) {\n        if is_mut_captured_in(Array::get(elems, i), name) {\n          found = true\n        }\n        i = i + 1\n      }\n      found\n    },\n    EArray(elems) => {\n      let mut i = 0\n      let mut found = false\n      while i < Array::length(elems) {\n        if is_mut_captured_in(Array::get(elems, i), name) {\n          found = true\n        }\n        i = i + 1\n      }\n      found\n    },\n    EMatch(scrutinee, arms) => if is_mut_captured_in(scrutinee, name) {\n      true\n    }\n    else {\n      let mut i = 0\n      let mut found = false\n      while i < Array::length(arms) {\n        let (_, arm_expr) = Array::get(arms, i)\n        if is_mut_captured_in(arm_expr, name) {\n          found = true\n        }\n        i = i + 1\n      }\n      found\n    },\n    EFn(_, _, params, _, _, fn_body) => {\n      let mut shadowed = false\n      let mut pi = 0\n      while pi < Array::length(params) {\n        let (pname, _) = Array::get(params, pi)\n        if pname == name {\n          shadowed = true\n        }\n        pi = pi + 1\n      }\n      if shadowed {\n        false\n      }\n      else {\n        let param_names = Array::slice([\n          \"\"\n        ], 0, 0)\n        let mut pi2 = 0\n        while pi2 < Array::length(params) {\n          let (pname2, _) = Array::get(params, pi2)\n          Array::push(param_names, pname2)\n          pi2 = pi2 + 1\n        }\n        let fv = collect_free_vars(fn_body, param_names, Array::slice([\n          \"\"\n        ], 0, 0))\n        if array_contains_str(fv, name) {\n          true\n        }\n        else {\n          is_mut_captured_in(fn_body, name)\n        }\n      }\n    },\n    EBreak(_) => false,\n    EContinue(_) => false,\n    EReturn(msg) => is_mut_captured_in(msg, name),\n    ERecord(_, fields, _) => {\n      let mut i = 0\n      let mut found = false\n      while i < Array::length(fields) {\n        let (_, fval) = Array::get(fields, i)\n        if is_mut_captured_in(fval, name) {\n          found = true\n        }\n        i = i + 1\n      }\n      found\n    },\n    EMap(entries) => {\n      let mut i = 0\n      let mut found = false\n      while i < Array::length(entries) {\n        let (_, mval) = Array::get(entries, i)\n        if is_mut_captured_in(mval, name) {\n          found = true\n        }\n        i = i + 1\n      }\n      found\n    },\n    EHandle(body, arms) => if is_mut_captured_in(body, name) {\n      true\n    } else {\n      let mut i = 0\n      let mut found = false\n      while i < Array::length(arms) {\n        let (_, arm_expr) = Array::get(arms, i)\n        if is_mut_captured_in(arm_expr, name) {\n          found = true\n        }\n        i = i + 1\n      }\n      found\n    },\n    ELoop(params, body) => if is_mut_captured_in(body, name) {\n      true\n    } else {\n      let mut i = 0\n      let mut found = false\n      while i < Array::length(params) {\n        let (_, init) = Array::get(params, i)\n        if is_mut_captured_in(init, name) {\n          found = true\n        }\n        i = i + 1\n      }\n      found\n    },\n    EDot(obj, _, _, _) => is_mut_captured_in(obj, name),\n    ELabeledArg(_, _, inner) => is_mut_captured_in(inner, name),\n    ESpread(inner) => is_mut_captured_in(inner, name),\n    _ => false\n  }\n}\n\nexport fn mut_needs_ref_cell(body: Expr, name: String) -> Bool {\n  is_mut_captured_in(body, name)\n}\n\nexport fn md_is_borrow_arg0_call(f: String) -> Bool {\n  f == \"__index\" || f == \"Array::get\" || f == \"Array::length\" || f == \"Array::set\" || f == \"Array::push\" || f == \"ArrayBuilder::push\" || f == \"StringBuilder::push\" || f == \"MapBuilder::set\" || f == \"Map::get\" || f == \"Map::keys\" || f == \"Map::has_key\" || f == \"Map::set\" || f == \"Bytes::push\" || f == \"Bytes::set\" || f == \"Bytes::get\" || f == \"Bytes::length\" || f == \"__rec_field\"\n}\n\nfn md_max(a: Int, b: Int) -> Int {\n  if a > b { a } else { b }\n}\n\nexport fn md_consume_count(e: Expr, name: String) -> Int {\n  match e {\n    EInt(_) => 0,\n    EFloat(_) => 0,\n    EString(_) => 0,\n    EBool(_) => 0,\n    EUnit => 0,\n    EStringInterp(_) => 0,\n    EIdent(n, _) => if n == name { 1 } else { 0 },\n    ETuple(items) => {\n      let mut acc = 0\n      let mut i = 0\n      while i < Array::length(items) {\n        acc = acc + md_consume_count(Array::get(items, i), name)\n        i = i + 1\n      }\n      acc\n    },\n    EArray(items) => {\n      let mut acc = 0\n      let mut i = 0\n      while i < Array::length(items) {\n        acc = acc + md_consume_count(Array::get(items, i), name)\n        i = i + 1\n      }\n      acc\n    },\n    ERecord(_, fields, _) => {\n      let mut acc = 0\n      let mut i = 0\n      while i < Array::length(fields) {\n        let (_, v) = Array::get(fields, i)\n        acc = acc + md_consume_count(v, name)\n        i = i + 1\n      }\n      acc\n    },\n    EMap(fields) => {\n      let mut acc = 0\n      let mut i = 0\n      while i < Array::length(fields) {\n        let (_, v) = Array::get(fields, i)\n        acc = acc + md_consume_count(v, name)\n        i = i + 1\n      }\n      acc\n    },\n    EIf(c, t, el) =>\n    md_consume_count(c, name) + md_max(md_consume_count(t, name), md_consume_count(el, name)),\n    ELet(_, v, b, _) => md_consume_count(v, name) + md_consume_count(b, name),\n    ELetRec(_, v, b) => md_consume_count(v, name) + md_consume_count(b, name),\n    ELetMut(_, v, b, _) => md_consume_count(v, name) + md_consume_count(b, name),\n    EAssign(_, v, b) => md_consume_count(v, name) + md_consume_count(b, name),\n    EAssignOp(_, _, v, b) => md_consume_count(v, name) + md_consume_count(b, name),\n    ESeq(a, b) => md_consume_count(a, name) + md_consume_count(b, name),\n    EMatch(s, arms) => {\n      let mut mx = 0\n      let mut i = 0\n      while i < Array::length(arms) {\n        let (_, v) = Array::get(arms, i)\n        mx = md_max(mx, md_consume_count(v, name))\n        i = i + 1\n      }\n      let scr = match s {\n        EIdent(_, _) => 0,\n        _ => md_consume_count(s, name)\n      }\n      scr + mx\n    },\n    EHandle(s, arms) => {\n      let mut mx = 0\n      let mut i = 0\n      while i < Array::length(arms) {\n        let (_, v) = Array::get(arms, i)\n        mx = md_max(mx, md_consume_count(v, name))\n        i = i + 1\n      }\n      let scr = match s {\n        EIdent(_, _) => 0,\n        _ => md_consume_count(s, name)\n      }\n      scr + mx\n    },\n    EWhile(c, b) => md_consume_count(c, name) + md_consume_count(b, name),\n    ELoop(params, b) => {\n      let mut acc = md_consume_count(b, name)\n      let mut i = 0\n      while i < Array::length(params) {\n        let (_, v) = Array::get(params, i)\n        acc = acc + md_consume_count(v, name)\n        i = i + 1\n      }\n      acc\n    },\n    EForIn(_, _, it, b) => md_consume_count(it, name) + md_consume_count(b, name),\n    ECall(callee, args, _) => {\n      let borrow0 = match callee {\n        EIdent(f, _) => md_is_borrow_arg0_call(f),\n        _ => false\n      }\n      let start = if borrow0 && Array::length(args) >= 1 {\n        1\n      } else {\n        0\n      }\n      let head = if start == 1 {\n        match Array::get(args, 0) {\n          EIdent(_, _) => 0,\n          _ => md_consume_count(Array::get(args, 0), name)\n        }\n      } else {\n        0\n      }\n      let callee_c = match callee {\n        EIdent(_, _) => 0,\n        _ => md_consume_count(callee, name)\n      }\n      let mut acc = callee_c + head\n      let mut ri = start\n      while ri < Array::length(args) {\n        acc = acc + md_consume_count(Array::get(args, ri), name)\n        ri = ri + 1\n      }\n      acc\n    },\n    EBinOp(_, l, r) => md_consume_count(l, name) + md_consume_count(r, name),\n    EUnaryOp(_, x) => md_consume_count(x, name),\n    EFn(_, _, _, _, _, body) => md_consume_count(body, name),\n    EDot(x, _, _, _) => md_consume_count(x, name),\n    ELabeledArg(_, _, v) => md_consume_count(v, name),\n    EReturn(x) => md_consume_count(x, name),\n    EBreak(opt) => match opt {\n      Some(v) => md_consume_count(v, name),\n      None => 0\n    },\n    EContinue(args) => {\n      let mut acc = 0\n      let mut i = 0\n      while i < Array::length(args) {\n        acc = acc + md_consume_count(Array::get(args, i), name)\n        i = i + 1\n      }\n      acc\n    },\n    ESpread(x) => md_consume_count(x, name)\n  }\n}\n")
}

let selfhost_source_69 = () -> (String, String) {
  ("lib/@vibe/compiler/perceus/index.vpkg",
"version 0.0.1\n\n// @vibe/compiler/perceus — the RC backend's Perceus dup/drop planner\n// (count + emit passes over a function body), the program-wide\n// borrow-return / scalar-return / heap-return name scans, and the\n// heap-param elaboration rewrite (ADR-0055/#702..#715 lineage). First\n// COMPILER-INTERNAL contract batch (ADR-0070 Phase 3, #897) — compiled\n// into the compiler itself via compiler_sources_manifest.tsv (group\n// `codegen`, dual-row: this contract + perceus.vibe).\n//\n// The old index.vibe was not a facade but the whole implementation (the\n// package is single-file), so it moved verbatim to perceus.vibe.\n//\n// `PerceusAction` is declared TRANSPARENT (defined verbatim here, deleted\n// from the impl): tests/perceus_rc_test.vibe reads `.kind`/`.name`\n// directly, so the field layout is real public API surface (@vibe/process\n// ShResult precedent, PR #920). `PerceusActionKind` stays `opaque` with\n// its `export enum` kept in perceus.vibe: the impl file itself constructs\n// and pattern-matches PaDup/PaDrop/PaAliasDup, and enum VARIANTS do not\n// resolve across units from a facade-only definition (@vibe/json\n// precedent — \"unknown name: JNull\"). Consumers keep full variant\n// visibility through the same #716 re-export machinery as before.\n//\n// `PCtx` (the planner's mutable count/emit state, parameter of\n// pc_emit/pc_count) is intentionally NOT declared: it was never exported\n// by the old index.vibe either — the exported pc_emit/pc_count signatures\n// name it as structural signature text only, and conformance compares\n// signatures textually, so declaring it `opaque` would have forced a new\n// `export struct PCtx` (a surface WIDENING this migration must not make).\n// No `version` binding existed (compiler-internal package).\n\nimport ./perceus.vibe {}\n\nopaque type PerceusActionKind\n\nstruct PerceusAction {\n  kind: PerceusActionKind;\n  name: String\n}\n\n// --- plan-action predicates\nfn pa_is_dup(a: PerceusAction) -> Bool\nfn pa_is_drop(a: PerceusAction) -> Bool\nfn pa_is_alias_dup(a: PerceusAction) -> Bool\n\n// --- program-wide name scans (threaded into every function's plan)\nfn compute_borrow_returning_names(stmts: Array[Stmt]) -> Array[String]\nfn compute_scalar_returning_names(stmts: Array[Stmt]) -> Array[String]\nfn compute_heap_returning(stmts: Array[Stmt]) -> Array[String]\n\n// --- heap-ness classification\nfn type_expr_is_heap(ot: Option[TypeExpr]) -> Bool\nfn param_is_heap_in_body(name: String, otype: Option[TypeExpr], body: Expr) -> Bool\n\n// --- planner passes and entry points\nfn pc_count(ctx: PCtx, scope: Map[String, Int], expr: Expr) -> Int\nfn pc_emit(ctx: PCtx, scope: Map[String, Int], expr: Expr) -> Int\nfn build_perceus_plan(body: Expr) -> Array[PerceusAction]\nfn build_perceus_plan_with_params(params: Array[(String, Option[TypeExpr])], body: Expr, borrow_ret_names: Array[String]) -> Array[PerceusAction]\n\n// --- heap-param elaboration (run at the head of the RC pipeline)\nfn elaborate_heap_params(stmts: Array[Stmt]) -> Array[Stmt]\n")
}

let selfhost_source_70 = () -> (String, String) {
  ("lib/@vibe/compiler/perceus/perceus.vibe",
"\n\n\n\nexport enum PerceusActionKind {\n  PaDup;\n  PaDrop;\n  PaAliasDup\n}\n\n\nstruct PCtx {\n  mut next_id: Int;\n  mut seq_id: Int;\n  pctx_names: Array[String];\n  uses: Array[Int];\n  borrows: Array[Int];\n  scalar: Array[Bool];\n  remaining: Array[Int];\n  actions: Array[PerceusAction]\n}\n\nstruct HeapInferCtx {\n  ctors: Array[String];\n  heap_fns: Array[String]\n}\n\n\nfn zeros(n: Int) -> Array[Int] {\n  let out: Array[Int] = [\n  ]\n  let mut i = 0\n  while i < n {\n    Array::push(out, 0)\n    i = i + 1\n  }\n  out\n}\n\nfn int_max(a: Int, b: Int) -> Int {\n  if a > b {\n    a\n  } else {\n    b\n  }\n}\n\nfn name_in(arr: Array[String], s: String) -> Bool {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(arr) {\n    if Array::get(arr, i) == s {\n      found = true\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  found\n}\n\nfn pe_push(ctx: PCtx, kind: PerceusActionKind, name: String) -> Int {\n  Array::push(ctx.actions, PerceusAction::{\n    kind: kind, name: name\n  })\n  0\n}\n\nfn pe_use(ctx: PCtx, scope: Map[String, Int], name: String) -> Int {\n  if Map::has_key(scope, name) {\n    let id = Map::get(scope, name)\n    let rem = Array::get(ctx.remaining, id)\n    if rem > 1 && !Array::get(ctx.scalar, id) {\n      pe_push(ctx, PaDup, name)\n    } else {\n      0\n    }\n    if rem > 0 {\n      Array::set(ctx.remaining, id, rem - 1)\n    }\n  }\n  0\n}\n\nfn pctx_new() -> PCtx {\n  PCtx::{\n    next_id: 0,\n    seq_id: 0,\n    pctx_names: [\n    ],\n    uses: [\n    ],\n    borrows: [\n    ],\n    scalar: [\n    ],\n    remaining: [\n    ],\n    actions: [\n    ],\n  }\n}\n\nfn copy_ints(src: Array[Int]) -> Array[Int] {\n  Array::slice(src, 0, Array::length(src))\n}\n\nexport fn pa_is_dup(a: PerceusAction) -> Bool {\n  match a.kind {\n    PaDup => true,\n    PaDrop => false,\n    PaAliasDup => false\n  }\n}\n\nfn pat_names(pat: Pat, out: Array[String]) -> Int {\n  match pat {\n    PBind(name) => {\n      Array::push(out, name)\n      0\n    },\n    PCtor(_n, args) => {\n      let mut i = 0\n      while i < Array::length(args) {\n        pat_names(Array::get(args, i), out)\n        i = i + 1\n      }\n      0\n    },\n    PTuple(pats) => {\n      let mut i = 0\n      while i < Array::length(pats) {\n        pat_names(Array::get(pats, i), out)\n        i = i + 1\n      }\n      0\n    },\n    POr(l, _r) => pat_names(l, out),\n    PStruct(_n, fields) => {\n      let mut i = 0\n      while i < Array::length(fields) {\n        pat_names((Array::get(fields, i)).1, out)\n        i = i + 1\n      }\n      0\n    },\n    _ => 0\n  }\n}\n\nexport fn pa_is_drop(a: PerceusAction) -> Bool {\n  match a.kind {\n    PaDrop => true,\n    PaDup => false,\n    PaAliasDup => false\n  }\n}\n\nfn pc_declare(ctx: PCtx, name: String, scalar: Bool) -> Int {\n  let id = ctx.next_id\n  Array::push(ctx.pctx_names, name)\n  Array::push(ctx.uses, 0)\n  Array::push(ctx.borrows, 0)\n  Array::push(ctx.scalar, scalar)\n  ctx.next_id = id + 1\n  id\n}\n\nfn pe_declare(ctx: PCtx, _name: String) -> Int {\n  let id = ctx.next_id\n  let owning = Array::get(ctx.uses, id)\n  let init = if owning == 0 {\n    1\n  } else {\n    owning\n  }\n  Array::push(ctx.remaining, init)\n  ctx.next_id = id + 1\n  id\n}\n\nfn pc_count_use(ctx: PCtx, scope: Map[String, Int], name: String) -> Int {\n  if Map::has_key(scope, name) {\n    let id = Map::get(scope, name)\n    Array::set(ctx.uses, id, Array::get(ctx.uses, id) + 1)\n  }\n  0\n}\n\nfn pe_scope_end(ctx: PCtx, id: Int, name: String) -> Int {\n  if Array::get(ctx.remaining, id) > 0 && !Array::get(ctx.scalar, id) {\n    pe_push(ctx, PaDrop, name)\n    Array::set(ctx.remaining, id, 0)\n  }\n  0\n}\n\nfn next_seq_name(ctx: PCtx) -> String {\n  let nm = \"__seq\" + __to_string(ctx.seq_id)\n  ctx.seq_id = ctx.seq_id + 1\n  nm\n}\n\nfn fn_param_names(params: Array[(String, Option[TypeExpr])]) -> Array[String] {\n  let out: Array[String] = [\n  ]\n  let mut i = 0\n  while i < Array::length(params) {\n    Array::push(out, (Array::get(params, i)).0)\n    i = i + 1\n  }\n  out\n}\n\nfn is_v128_box_call(fname: String) -> Bool {\n  fname == \"v128_load\" || fname == \"v128_splat_i8x16\" || fname == \"v128_eq_i8x16\" || fname == \"v128_le_u_i8x16\" || fname == \"v128_ge_u_i8x16\" || fname == \"v128_and\" || fname == \"v128_or\" || fname == \"v128_not\"\n}\n\nfn array_contains_str_pctx(arr: Array[String], s: String) -> Bool {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(arr) {\n    if Array::get(arr, i) == s {\n      found = true\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  found\n}\n\nlet borrow_ret_marker = \"BR:\"\n\nfn is_borrow_ret_fname(ctx: PCtx, fname: String) -> Bool {\n  fname == \"Array::get\" || fname == \"Map::get\" || fname == \"__index\" || fname == \"__rec_field\" || array_contains_str_pctx(ctx.pctx_names, String::concat(borrow_ret_marker, fname))\n}\n\nfn tail_is_borrow_ret_safe(known: Array[String], e0: Expr) -> Bool {\n  let worklist = [e0]\n  let mut all_safe = true\n  let mut i = 0\n  while i < Array::length(worklist) {\n    match Array::get(worklist, i) {\n      ELet(_, _, b, _) => Array::push(worklist, b),\n      ELetMut(_, _, b, _) => Array::push(worklist, b),\n      ELetRec(_, _, b) => Array::push(worklist, b),\n      ESeq(_, b) => Array::push(worklist, b),\n      EAssign(_, _, b) => Array::push(worklist, b),\n      EAssignOp(_, _, _, b) => Array::push(worklist, b),\n      EIf(_, t, el) => {\n        Array::push(worklist, t)\n        Array::push(worklist, el)\n      },\n      EMatch(_, arms) => {\n        let mut ai = 0\n        while ai < Array::length(arms) {\n          let (_p, ae) = Array::get(arms, ai)\n          Array::push(worklist, ae)\n          ai = ai + 1\n        }\n      },\n      ECall(callee_e, cargs, _) =>\n      match callee_e {\n        EIdent(callee, _) =>\n        if callee == \"perform\" && Array::length(cargs) == 1 {\n          let mut op_is_throw = false\n          match Array::get(cargs, 0) {\n            ECall(op_e, _, _) =>\n            match op_e {\n              EIdent(op_n, _) => if op_n == \"Error::Throw\" {\n                op_is_throw = true\n              } else {\n                ()\n              },\n              _ => ()\n            },\n            _ => ()\n          }\n          if op_is_throw {\n            ()\n          } else if !array_contains_str_pctx(known, callee) {\n            all_safe = false\n          } else {\n            ()\n          }\n        } else if !array_contains_str_pctx(known, callee) {\n          all_safe = false\n        } else {\n          ()\n        },\n        _ => {\n          all_safe = false\n        }\n      },\n      EIdent(_, _) => (),\n      _ => {\n        all_safe = false\n      }\n    }\n    i = i + 1\n  }\n  all_safe\n}\n\nfn strip_wrappers_for_borrow_ret(e: Expr) -> Expr {\n  match e {\n    ELet(_, _, b, _) => strip_wrappers_for_borrow_ret(b),\n    ELetMut(_, _, b, _) => strip_wrappers_for_borrow_ret(b),\n    ELetRec(_, _, b) => strip_wrappers_for_borrow_ret(b),\n    ESeq(_, b) => strip_wrappers_for_borrow_ret(b),\n    EAssign(_, _, b) => strip_wrappers_for_borrow_ret(b),\n    EAssignOp(_, _, _, b) => strip_wrappers_for_borrow_ret(b),\n    _ => e\n  }\n}\n\nexport fn compute_borrow_returning_names(stmts: Array[Stmt]) -> Array[String] {\n  let known: Array[String] = [\n    \"Array::get\", \"Map::get\", \"__index\", \"__rec_field\"\n  ]\n  let mut changed = true\n  while changed {\n    changed = false\n    let mut i = 0\n    while i < Array::length(stmts) {\n      match Array::get(stmts, i) {\n        SLet(_, _, name, _, value) =>\n        if !array_contains_str_pctx(known, name) {\n          match value {\n            EFn(_, _, _, _, _, body) => {\n              let top = strip_wrappers_for_borrow_ret(body)\n              let eligible_shape = match top {\n                ECall(_, _, _) => true,\n                EIf(_, _, _) => true,\n                EMatch(_, _) => true,\n                _ => false\n              }\n              if eligible_shape && tail_is_borrow_ret_safe(known, top) {\n                Array::push(known, name)\n                changed = true\n              } else {\n                ()\n              }\n            },\n            _ => ()\n          }\n        } else {\n          ()\n        },\n        _ => ()\n      }\n      i = i + 1\n    }\n  }\n  known\n}\n\nfn fn_sig_return_type(ty: Option[TypeExpr]) -> Option[TypeExpr] {\n  match ty {\n    Some(t) =>\n    match t {\n      TyFn(_, ret, _) => Some(ret),\n      _ => None\n    },\n    None => None\n  }\n}\n\nexport fn compute_scalar_returning_names(stmts: Array[Stmt]) -> Array[String] {\n  let out: Array[String] = [\n  ]\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SLet(_, _, name, ty, value) =>\n      match value {\n        EFn(_, _, _, _, _, _) =>\n        match fn_sig_return_type(ty) {\n          Some(ret) =>\n          if !type_expr_is_heap(Some(ret)) {\n            Array::push(out, name)\n          } else {\n            ()\n          },\n          None => ()\n        },\n        _ => ()\n      },\n      _ => ()\n    }\n    i = i + 1\n  }\n  out\n}\n\nfn is_scalar_expr(ctx: PCtx, e: Expr) -> Bool {\n  match e {\n    EInt(_) => true,\n    EBool(_) => true,\n    EFloat(_) => true,\n    EUnit => true,\n    ECall(EIdent(fname, _), _, _) => is_v128_box_call(fname) || is_borrow_ret_fname(ctx, fname),\n    _ => false\n  }\n}\n\nfn pat_shadow_env(pat: Pat, env: Map[String, Bool]) -> Map[String, Bool] {\n  let names: Array[String] = [\n  ]\n  pat_names(pat, names)\n  let mut env2 = env\n  let mut j = 0\n  while j < Array::length(names) {\n    env2 = Map::set(env2, Array::get(names, j), false)\n    j = j + 1\n  }\n  env2\n}\n\nfn restore_prefix(dst: Array[Int], src: Array[Int]) -> Int {\n  let mut i = 0\n  while i < Array::length(src) {\n    Array::set(dst, i, Array::get(src, i))\n    i = i + 1\n  }\n  0\n}\n\nfn is_heap_literal(e: Expr) -> Bool {\n  match e {\n    ETuple(_) => true,\n    EArray(_) => true,\n    ERecord(_, _, _) => true,\n    _ => false\n  }\n}\n\nfn is_heap_value(e: Expr, env: Map[String, Bool], hctx: HeapInferCtx) -> Bool {\n  if is_heap_literal(e) {\n    true\n  } else {\n    match e {\n      ECall(callee, args, _) =>\n      match callee {\n        EIdent(c, _) =>\n        if Map::has_key(env, c) {\n          false\n        } else {\n          (Array::length(args) > 0 && name_in(hctx.ctors, c)) ||\n          name_in(hctx.heap_fns, c)\n        },\n        _ => false\n      },\n      _ => false\n    }\n  }\n}\n\nfn arg_class(arg: Expr, env: Map[String, Bool], hctx: HeapInferCtx) -> Bool {\n  if is_heap_value(arg, env, hctx) {\n    true\n  } else {\n    match arg {\n      EIdent(n, _) => if Map::has_key(env, n) {\n        Map::get(env, n)\n      } else {\n        false\n      },\n      _ => false\n    }\n  }\n}\n\nfn analyze_calls(name: String, e_in: Expr, env_in: Map[String, Bool], calls: Array[Array[Bool]], esc: Array[Bool], hctx: HeapInferCtx) -> Int {\n  let mut e = e_in\n  let mut env = env_in\n  let mut looping = true\n  while looping {\n    looping = false\n    match e {\n    EIdent(n, _) => {\n      if n == name {\n        Array::set(esc, 0, true)\n      } else {\n        ()\n      }\n      0\n    },\n    ECall(callee, args, _) => {\n      let is_self = match callee {\n        EIdent(cn, _) => cn == name,\n        _ => false\n      }\n      if is_self {\n        let cls: Array[Bool] = [\n        ]\n        let mut k = 0\n        while k < Array::length(args) {\n          Array::push(cls, arg_class(Array::get(args, k), env, hctx))\n          k = k + 1\n        }\n        Array::push(calls, cls)\n      } else {\n        let _ = analyze_calls(name, callee, env, calls, esc, hctx)\n        ()\n      }\n      let mut i = 0\n      while i < Array::length(args) {\n        analyze_calls(name, Array::get(args, i), env, calls, esc, hctx)\n        i = i + 1\n      }\n      0\n    },\n    EDot(obj, _, _, _) => analyze_calls(name, obj, env, calls, esc, hctx),\n    ELet(n, v, b, _) => {\n      analyze_calls(name, v, env, calls, esc, hctx)\n      env = Map::set(env, n, is_heap_value(v, env, hctx))\n      e = b\n      looping = true\n    },\n    ELetRec(n, v, b) => {\n      env = Map::set(env, n, false)\n      analyze_calls(name, v, env, calls, esc, hctx)\n      e = b\n      looping = true\n    },\n    ELetMut(n, v, b, _) => {\n      analyze_calls(name, v, env, calls, esc, hctx)\n      env = Map::set(env, n, false)\n      e = b\n      looping = true\n    },\n    EAssign(_, v, c) => {\n      analyze_calls(name, v, env, calls, esc, hctx)\n      e = c\n      looping = true\n    },\n    EAssignOp(_, _, v, c) => {\n      analyze_calls(name, v, env, calls, esc, hctx)\n      e = c\n      looping = true\n    },\n    ESeq(a, b) => {\n      analyze_calls(name, a, env, calls, esc, hctx)\n      e = b\n      looping = true\n    },\n    EIf(c, t, el) => {\n      analyze_calls(name, c, env, calls, esc, hctx)\n      analyze_calls(name, t, env, calls, esc, hctx)\n      analyze_calls(name, el, env, calls, esc, hctx)\n      0\n    },\n    EWhile(c, b) => {\n      analyze_calls(name, c, env, calls, esc, hctx)\n      analyze_calls(name, b, env, calls, esc, hctx)\n      0\n    },\n    EForIn(v0, ix, it, b) => {\n      analyze_calls(name, it, env, calls, esc, hctx)\n      let env1 = Map::set(env, v0, false)\n      let env2 = match ix {\n        Some(ixn) => Map::set(env1, ixn, false),\n        None => env1\n      }\n      analyze_calls(name, b, env2, calls, esc, hctx)\n      0\n    },\n    EBinOp(_, l, r) => {\n      analyze_calls(name, l, env, calls, esc, hctx)\n      analyze_calls(name, r, env, calls, esc, hctx)\n      0\n    },\n    EUnaryOp(_, o) => analyze_calls(name, o, env, calls, esc, hctx),\n    EFn(_, _, params, _, _, b) => {\n      let mut env2 = env\n      let mut pi = 0\n      while pi < Array::length(params) {\n        let (pn, _) = Array::get(params, pi)\n        env2 = Map::set(env2, pn, false)\n        pi = pi + 1\n      }\n      analyze_calls(name, b, env2, calls, esc, hctx)\n      0\n    },\n    ETuple(xs) => {\n      let mut i = 0\n      while i < Array::length(xs) {\n        analyze_calls(name, Array::get(xs, i), env, calls, esc, hctx)\n        i = i + 1\n      }\n      0\n    },\n    EArray(xs) => {\n      let mut i = 0\n      while i < Array::length(xs) {\n        analyze_calls(name, Array::get(xs, i), env, calls, esc, hctx)\n        i = i + 1\n      }\n      0\n    },\n    EMatch(s, arms) => {\n      analyze_calls(name, s, env, calls, esc, hctx)\n      let mut i = 0\n      while i < Array::length(arms) {\n        let (pat, ab) = Array::get(arms, i)\n        analyze_calls(name, ab, pat_shadow_env(pat, env), calls, esc, hctx)\n        i = i + 1\n      }\n      0\n    },\n    EHandle(b, arms) => {\n      analyze_calls(name, b, env, calls, esc, hctx)\n      let mut i = 0\n      while i < Array::length(arms) {\n        let (pat, ab) = Array::get(arms, i)\n        analyze_calls(name, ab, pat_shadow_env(pat, env), calls, esc, hctx)\n        i = i + 1\n      }\n      0\n    },\n    ELoop(ps, b) => {\n      let mut env2 = env\n      let mut i = 0\n      while i < Array::length(ps) {\n        let (pn, iv) = Array::get(ps, i)\n        analyze_calls(name, iv, env2, calls, esc, hctx)\n        env2 = Map::set(env2, pn, false)\n        i = i + 1\n      }\n      analyze_calls(name, b, env2, calls, esc, hctx)\n      0\n    },\n    ERecord(_, fs, _) => {\n      let mut i = 0\n      while i < Array::length(fs) {\n        let (_, fv) = Array::get(fs, i)\n        analyze_calls(name, fv, env, calls, esc, hctx)\n        i = i + 1\n      }\n      0\n    },\n    EMap(fs) => {\n      let mut i = 0\n      while i < Array::length(fs) {\n        let (_, fv) = Array::get(fs, i)\n        analyze_calls(name, fv, env, calls, esc, hctx)\n        i = i + 1\n      }\n      0\n    },\n    ELabeledArg(_, _, x) => analyze_calls(name, x, env, calls, esc, hctx),\n    EReturn(x) => analyze_calls(name, x, env, calls, esc, hctx),\n    ESpread(x) => analyze_calls(name, x, env, calls, esc, hctx),\n    EBreak(o) =>\n    match o {\n      Some(x) => analyze_calls(name, x, env, calls, esc, hctx),\n      None => 0\n    },\n    EContinue(xs) => {\n      let mut i = 0\n      while i < Array::length(xs) {\n        analyze_calls(name, Array::get(xs, i), env, calls, esc, hctx)\n        i = i + 1\n      }\n      0\n    },\n    EInt(_) => 0,\n    EFloat(_) => 0,\n    EString(_) => 0,\n    EBool(_) => 0,\n    EStringInterp(_) => 0,\n    EUnit => 0\n  }\n  }\n  0\n}\n\nexport fn pa_is_alias_dup(a: PerceusAction) -> Bool {\n  match a.kind {\n    PaAliasDup => true,\n    PaDup => false,\n    PaDrop => false\n  }\n}\n\nfn pc_count_borrow(ctx: PCtx, scope: Map[String, Int], name: String) -> Int {\n  if Map::has_key(scope, name) {\n    let id = Map::get(scope, name)\n    Array::set(ctx.borrows, id, Array::get(ctx.borrows, id) + 1)\n  }\n  0\n}\n\nfn type_contains_fn(t: TypeExpr) -> Bool {\n  match t {\n    TyFn(_, _, _) => true,\n    TyTuple(elems) => {\n      let mut i = 0\n      let mut found = false\n      while i < Array::length(elems) {\n        if type_contains_fn(Array::get(elems, i)) {\n          found = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      found\n    },\n    TyApp(_, args) => {\n      let mut i = 0\n      let mut found = false\n      while i < Array::length(args) {\n        if type_contains_fn(Array::get(args, i)) {\n          found = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      found\n    },\n    TyName(_) => false,\n    TyUnit => false\n  }\n}\n\nfn all_calls_heap_at(idx: Int, calls: Array[Array[Bool]]) -> Bool {\n  let mut ci = 0\n  let mut all_heap = true\n  while ci < Array::length(calls) {\n    let cls = Array::get(calls, ci)\n    if idx >= Array::length(cls) {\n      all_heap = false\n    } else if !Array::get(cls, idx) {\n      all_heap = false\n    } else {\n      ()\n    }\n    ci = ci + 1\n  }\n  all_heap\n}\n\nfn type_name_is_heap(n: String) -> Bool {\n  if String::length(n) == 0 {\n    false\n  } else {\n    let c0 = String::char_code_at(n, 0)\n    if c0 < 'A' || c0 > 'Z' {\n      false\n    } else if n == \"Int\" || n == \"Bool\" || n == \"Double\" || n == \"Float\" || n == \"String\" || n == \"Bytes\" || n == \"Char\" || n == \"Unit\" || n == \"V128\" {\n      false\n    } else {\n      true\n    }\n  }\n}\n\nexport fn type_expr_is_heap(ot: Option[TypeExpr]) -> Bool {\n  match ot {\n    None => false,\n    Some(t) =>\n    match t {\n      TyFn(_, _, _) => true,\n      _ =>\n      if type_contains_fn(t) {\n        false\n      } else {\n        match t {\n          TyTuple(_) => true,\n          TyApp(_, _) => true,\n          TyName(n) => type_name_is_heap(n),\n          TyFn(_, _, _) => false,\n          TyUnit => false\n        }\n      }\n    }\n  }\n}\n\nexport fn compute_heap_returning(stmts: Array[Stmt]) -> Array[String] {\n  let out: Array[String] = [\n  ]\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SLet(_, _, name, ann, value) => match value {\n        EFn(_, _, _, fn_ret, _, _) => {\n          let ret = match ann {\n            Some(at) => match at {\n              TyFn(_, r, _) => Some(r),\n              _ => fn_ret\n            },\n            None => fn_ret\n          }\n          if type_expr_is_heap(ret) {\n            Array::push(out, name)\n          } else {\n            ()\n          }\n        },\n        _ => ()\n      },\n      _ => ()\n    }\n    i = i + 1\n  }\n  out\n}\n\nfn collect_ctor_names(stmts: Array[Stmt]) -> Array[String] {\n  let out: Array[String] = [\n  ]\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SEnum(_, _, _, variants, _) => {\n        let mut j = 0\n        while j < Array::length(variants) {\n          let (vn, _) = Array::get(variants, j)\n          Array::push(out, vn)\n          j = j + 1\n        }\n      },\n      SSuberror(_, _, variants) => {\n        let mut j = 0\n        while j < Array::length(variants) {\n          let (vn, _) = Array::get(variants, j)\n          Array::push(out, vn)\n          j = j + 1\n        }\n      },\n      _ => ()\n    }\n    i = i + 1\n  }\n  out\n}\n\nfn inferred_heap_type() -> TypeExpr {\n  TyTuple(Array::slice([\n    TyUnit\n  ], 0, 0))\n}\n\nfn fill_lambda_params(name: String, efn: Expr, body: Expr, hctx: HeapInferCtx) -> Expr {\n  match efn {\n    EFn(tps, bounds, params, ret, eff, fnbody) => {\n      let calls: Array[Array[Bool]] = [\n      ]\n      let esc = [\n        false\n      ]\n      let env0: Map[String, Bool] = Map::new()\n      analyze_calls(name, body, env0, calls, esc, hctx)\n      if Array::get(esc, 0) || Array::length(calls) == 0 {\n        efn\n      } else {\n        let new_params = Array::slice(params, 0, 0)\n        let mut pi = 0\n        while pi < Array::length(params) {\n          let (pname, pty) = Array::get(params, pi)\n          let filled = match pty {\n            Some(_) => (pname, pty),\n            None =>\n            if all_calls_heap_at(pi, calls) {\n              (pname, Some(inferred_heap_type()))\n            } else {\n              (pname, pty)\n            }\n          }\n          Array::push(new_params, filled)\n          pi = pi + 1\n        }\n        EFn(tps, bounds, new_params, ret, eff, fnbody)\n      }\n    },\n    _ => efn\n  }\n}\n\nfn elaborate_rw(e: Expr, hctx: HeapInferCtx) -> Expr {\n  match e {\n    ELet(n, v, b, soff) => {\n      let v2 = elaborate_rw(v, hctx)\n      let v3 = fill_lambda_params(n, v2, b, hctx)\n      ELet(n, v3, elaborate_rw(b, hctx), soff)\n    },\n    ELetRec(n, v, b) => {\n      let v2 = elaborate_rw(v, hctx)\n      let v3 = fill_lambda_params(n, v2, b, hctx)\n      ELetRec(n, v3, elaborate_rw(b, hctx))\n    },\n    ELetMut(n, v, b, soff) => ELetMut(n, elaborate_rw(v, hctx), elaborate_rw(b, hctx), soff),\n    EAssign(n, v, c) => EAssign(n, elaborate_rw(v, hctx), elaborate_rw(c, hctx)),\n    EAssignOp(n, op, v, c) => EAssignOp(n, op, elaborate_rw(v, hctx), elaborate_rw(c, hctx)),\n    ESeq(a, b) => ESeq(elaborate_rw(a, hctx), elaborate_rw(b, hctx)),\n    EIf(c, t, el) => EIf(elaborate_rw(c, hctx), elaborate_rw(t, hctx), elaborate_rw(el, hctx)),\n    EWhile(c, b) => EWhile(elaborate_rw(c, hctx), elaborate_rw(b, hctx)),\n    EForIn(n, ix, it, b) => EForIn(n, ix, elaborate_rw(it, hctx), elaborate_rw(b, hctx)),\n    EFn(tps, bounds, params, ret, eff, fb) =>\n    EFn(tps, bounds, params, ret, eff, elaborate_rw(fb, hctx)),\n    ECall(callee, args, off) => {\n      let new_args = Array::slice(args, 0, 0)\n      let mut i = 0\n      while i < Array::length(args) {\n        Array::push(new_args, elaborate_rw(Array::get(args, i), hctx))\n        i = i + 1\n      }\n      ECall(elaborate_rw(callee, hctx), new_args, off)\n    },\n    EBinOp(op, l, r) => EBinOp(op, elaborate_rw(l, hctx), elaborate_rw(r, hctx)),\n    EUnaryOp(op, o) => EUnaryOp(op, elaborate_rw(o, hctx)),\n    EDot(o, f, off, fdoff) => EDot(elaborate_rw(o, hctx), f, off, fdoff),\n    ETuple(xs) => {\n      let ys = Array::slice(xs, 0, 0)\n      let mut i = 0\n      while i < Array::length(xs) {\n        Array::push(ys, elaborate_rw(Array::get(xs, i), hctx))\n        i = i + 1\n      }\n      ETuple(ys)\n    },\n    EArray(xs) => {\n      let ys = Array::slice(xs, 0, 0)\n      let mut i = 0\n      while i < Array::length(xs) {\n        Array::push(ys, elaborate_rw(Array::get(xs, i), hctx))\n        i = i + 1\n      }\n      EArray(ys)\n    },\n    EMatch(s, arms) => {\n      let new_arms = Array::slice(arms, 0, 0)\n      let mut i = 0\n      while i < Array::length(arms) {\n        let (p, ab) = Array::get(arms, i)\n        Array::push(new_arms, (p, elaborate_rw(ab, hctx)))\n        i = i + 1\n      }\n      EMatch(elaborate_rw(s, hctx), new_arms)\n    },\n    EHandle(b, arms) => {\n      let new_arms = Array::slice(arms, 0, 0)\n      let mut i = 0\n      while i < Array::length(arms) {\n        let (p, ab) = Array::get(arms, i)\n        Array::push(new_arms, (p, elaborate_rw(ab, hctx)))\n        i = i + 1\n      }\n      EHandle(elaborate_rw(b, hctx), new_arms)\n    },\n    ELoop(ps, b) => {\n      let new_ps = Array::slice(ps, 0, 0)\n      let mut i = 0\n      while i < Array::length(ps) {\n        let (pn, iv) = Array::get(ps, i)\n        Array::push(new_ps, (pn, elaborate_rw(iv, hctx)))\n        i = i + 1\n      }\n      ELoop(new_ps, elaborate_rw(b, hctx))\n    },\n    ERecord(rn, fs, targs) => {\n      let new_fs = Array::slice(fs, 0, 0)\n      let mut i = 0\n      while i < Array::length(fs) {\n        let (fn0, fv) = Array::get(fs, i)\n        Array::push(new_fs, (fn0, elaborate_rw(fv, hctx)))\n        i = i + 1\n      }\n      ERecord(rn, new_fs, targs)\n    },\n    EMap(fs) => {\n      let new_fs = Array::slice(fs, 0, 0)\n      let mut i = 0\n      while i < Array::length(fs) {\n        let (fn0, fv) = Array::get(fs, i)\n        Array::push(new_fs, (fn0, elaborate_rw(fv, hctx)))\n        i = i + 1\n      }\n      EMap(new_fs)\n    },\n    ELabeledArg(l, k, x) => ELabeledArg(l, k, elaborate_rw(x, hctx)),\n    EReturn(x) => EReturn(elaborate_rw(x, hctx)),\n    ESpread(x) => ESpread(elaborate_rw(x, hctx)),\n    EBreak(o) =>\n    match o {\n      Some(x) => EBreak(Some(elaborate_rw(x, hctx))),\n      None => EBreak(None)\n    },\n    EContinue(xs) => {\n      let ys = Array::slice(xs, 0, 0)\n      let mut i = 0\n      while i < Array::length(xs) {\n        Array::push(ys, elaborate_rw(Array::get(xs, i), hctx))\n        i = i + 1\n      }\n      EContinue(ys)\n    },\n    EInt(_) => e,\n    EFloat(_) => e,\n    EString(_) => e,\n    EBool(_) => e,\n    EIdent(_, _) => e,\n    EStringInterp(_) => e,\n    EUnit => e\n  }\n}\n\nfn is_borrow_arg0_call(f: String) -> Bool {\n  f == \"__index\" || f == \"Array::get\" || f == \"Array::length\" || f == \"Array::set\" || f == \"Array::push\" || f == \"ArrayBuilder::push\" || f == \"StringBuilder::push\" || f == \"MapBuilder::set\" || f == \"Map::get\" || f == \"Map::keys\" || f == \"Map::has_key\" || f == \"Map::has\" || f == \"Map::set\" || f == \"Map::size\" || f == \"Map::values\" || f == \"Map::delete\" || f == \"Bytes::push\" || f == \"Bytes::set\" || f == \"Bytes::get\" || f == \"Bytes::length\" || f == \"__rec_field\"\n}\n\nexport fn pc_emit(ctx: PCtx, scope: Map[String, Int], expr: Expr) -> Int {\n  match expr {\n    EInt(_) => 0,\n    EFloat(_) => 0,\n    EString(_) => 0,\n    EBool(_) => 0,\n    EUnit => 0,\n    EStringInterp(_) => 0,\n    EIdent(x, _) => pe_use(ctx, scope, x),\n    ECall(callee, args, _) => {\n      let is_index = match callee {\n        EIdent(f, _) => is_borrow_arg0_call(f),\n        _ => false\n      }\n      match callee {\n        EIdent(_, _) => 0,\n        _ => pc_emit(ctx, scope, callee)\n      }\n      let mut i = 0\n      while i < Array::length(args) {\n        let arg = Array::get(args, i)\n        if is_index && i == 0 {\n          match arg {\n            EIdent(_, _) => 0,\n            _ => pc_emit(ctx, scope, arg)\n          }\n        } else {\n          pc_emit(ctx, scope, arg)\n        }\n        i = i + 1\n      }\n      0\n    },\n    EDot(obj, _field, _, _) => match obj {\n      EIdent(_, _) => 0,\n      _ => pc_emit(ctx, scope, obj)\n    }\n    ,\n    ELet(name, value, body, _) => {\n      match value {\n        EIdent(src, _) => {\n          if Map::has_key(scope, src) {\n            let sid = Map::get(scope, src)\n            let rem = Array::get(ctx.remaining, sid)\n            if rem > 1 && !Array::get(ctx.scalar, sid) {\n              pe_push(ctx, PaAliasDup, name)\n            } else {\n              0\n            }\n            if rem > 0 {\n              Array::set(ctx.remaining, sid, rem - 1)\n            }\n          } else {\n            ()\n          }\n          0\n        },\n        _ => pc_emit(ctx, scope, value)\n      }\n      let id = pe_declare(ctx, name)\n      pc_emit(ctx, Map::set(scope, name, id), body)\n      pe_scope_end(ctx, id, name)\n    },\n    ELetMut(name, value, body, _) => {\n      pc_emit(ctx, scope, value)\n      let id = pe_declare(ctx, name)\n      pc_emit(ctx, Map::set(scope, name, id), body)\n      pe_scope_end(ctx, id, name)\n    },\n    ELetRec(name, value, body) => {\n      let id = pe_declare(ctx, name)\n      let s2 = Map::set(scope, name, id)\n      pc_emit(ctx, s2, value)\n      pc_emit(ctx, s2, body)\n      pe_scope_end(ctx, id, name)\n    },\n    EAssign(_name, value, body) => {\n      pc_emit(ctx, scope, value)\n      pc_emit(ctx, scope, body)\n    },\n    EAssignOp(_op, _name, value, body) => {\n      pc_emit(ctx, scope, value)\n      pc_emit(ctx, scope, body)\n    },\n    ESeq(a, b) => {\n      pc_emit(ctx, scope, a)\n      let nm = next_seq_name(ctx)\n      let id = pe_declare(ctx, nm)\n      pc_emit(ctx, scope, b)\n      pe_scope_end(ctx, id, nm)\n    },\n    EBinOp(_op, l, r) => {\n      pc_emit(ctx, scope, l)\n      pc_emit(ctx, scope, r)\n    },\n    EUnaryOp(_op, e) => pc_emit(ctx, scope, e),\n    ETuple(items) => {\n      let mut i = 0\n      while i < Array::length(items) {\n        pc_emit(ctx, scope, Array::get(items, i))\n        i = i + 1\n      }\n      0\n    },\n    EArray(items) => {\n      let mut i = 0\n      while i < Array::length(items) {\n        pc_emit(ctx, scope, Array::get(items, i))\n        i = i + 1\n      }\n      0\n    },\n    ERecord(_, fields, _) => {\n      let mut i = 0\n      while i < Array::length(fields) {\n        pc_emit(ctx, scope, (Array::get(fields, i)).1)\n        i = i + 1\n      }\n      0\n    },\n    EMap(fields) => {\n      let mut i = 0\n      while i < Array::length(fields) {\n        pc_emit(ctx, scope, (Array::get(fields, i)).1)\n        i = i + 1\n      }\n      0\n    },\n    EIf(cond, then_e, else_e) => {\n      pc_emit(ctx, scope, cond)\n      let snap = copy_ints(ctx.remaining)\n      pc_emit(ctx, scope, then_e)\n      let then_rem = copy_ints(ctx.remaining)\n      restore_prefix(ctx.remaining, snap)\n      pc_emit(ctx, scope, else_e)\n      let mut i = 0\n      while i < Array::length(snap) {\n        if Array::get(then_rem, i) < Array::get(ctx.remaining, i) {\n          Array::set(ctx.remaining, i, Array::get(then_rem, i))\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      0\n    },\n    EWhile(cond, body) => {\n      pc_emit(ctx, scope, cond)\n      pc_emit(ctx, scope, body)\n    },\n    EReturn(e) => pc_emit(ctx, scope, e),\n    ESpread(e) => pc_emit(ctx, scope, e),\n    ELabeledArg(_l, _n, e) => pc_emit(ctx, scope, e),\n    EBreak(opt) => match opt {\n      Some(e) => pc_emit(ctx, scope, e),\n      None => 0\n    }\n    ,\n    EFn(_tp, _tb, params, _ret, _eff, fbody) => {\n      let caps = collect_free_vars(fbody, fn_param_names(params), [\n      ])\n      let mut i = 0\n      while i < Array::length(caps) {\n        pe_use(ctx, scope, Array::get(caps, i))\n        i = i + 1\n      }\n      0\n    },\n    EForIn(value_name, index_opt, iterable, fbody) => {\n      pc_emit(ctx, scope, iterable)\n      let idv = pe_declare(ctx, value_name)\n      let s2 = Map::set(scope, value_name, idv)\n      let s3 = match index_opt {\n        Some(idx) => {\n          let idi = pe_declare(ctx, idx)\n          Map::set(s2, idx, idi)\n        },\n        None => s2\n      }\n      pc_emit(ctx, s3, fbody)\n      pe_scope_end(ctx, idv, value_name)\n    },\n    ELoop(params, lbody) => {\n      let mut s = scope\n      let pids: Array[Int] = [\n      ]\n      let pnames: Array[String] = [\n      ]\n      let mut i = 0\n      while i < Array::length(params) {\n        let p = Array::get(params, i)\n        pc_emit(ctx, scope, p.1)\n        let pid = pe_declare(ctx, p.0)\n        s = Map::set(s, p.0, pid)\n        Array::push(pids, pid)\n        Array::push(pnames, p.0)\n        i = i + 1\n      }\n      pc_emit(ctx, s, lbody)\n      let mut j = 0\n      while j < Array::length(pids) {\n        pe_scope_end(ctx, Array::get(pids, j), Array::get(pnames, j))\n        j = j + 1\n      }\n      0\n    },\n    EMatch(scrut, arms) => {\n      match scrut {\n        EIdent(_, _) => 0,\n        _ => pc_emit(ctx, scope, scrut)\n      }\n      let snap = copy_ints(ctx.remaining)\n      let minrem = copy_ints(snap)\n      let mut a = 0\n      while a < Array::length(arms) {\n        let arm = Array::get(arms, a)\n        restore_prefix(ctx.remaining, snap)\n        let pnames: Array[String] = [\n        ]\n        pat_names(arm.0, pnames)\n        let mut s = scope\n        let pids: Array[Int] = [\n        ]\n        let mut k = 0\n        while k < Array::length(pnames) {\n          let nm = Array::get(pnames, k)\n          let pid = pe_declare(ctx, nm)\n          s = Map::set(s, nm, pid)\n          Array::push(pids, pid)\n          k = k + 1\n        }\n        pc_emit(ctx, s, arm.1)\n        let mut j = 0\n        while j < Array::length(pids) {\n          pe_scope_end(ctx, Array::get(pids, j), Array::get(pnames, j))\n          j = j + 1\n        }\n        let mut mi = 0\n        while mi < Array::length(snap) {\n          if Array::get(ctx.remaining, mi) < Array::get(minrem, mi) {\n            Array::set(minrem, mi, Array::get(ctx.remaining, mi))\n          } else {\n            ()\n          }\n          mi = mi + 1\n        }\n        a = a + 1\n      }\n      restore_prefix(ctx.remaining, minrem)\n      0\n    },\n    EHandle(hbody, arms) => {\n      let snap = copy_ints(ctx.remaining)\n      pc_emit(ctx, scope, hbody)\n      let minrem = copy_ints(ctx.remaining)\n      let mut a = 0\n      while a < Array::length(arms) {\n        let arm = Array::get(arms, a)\n        restore_prefix(ctx.remaining, snap)\n        let pnames: Array[String] = [\n        ]\n        pat_names(arm.0, pnames)\n        let mut s = scope\n        let pids: Array[Int] = [\n        ]\n        let mut k = 0\n        while k < Array::length(pnames) {\n          let nm = Array::get(pnames, k)\n          let pid = pe_declare(ctx, nm)\n          s = Map::set(s, nm, pid)\n          Array::push(pids, pid)\n          k = k + 1\n        }\n        pc_emit(ctx, s, arm.1)\n        let mut j = 0\n        while j < Array::length(pids) {\n          pe_scope_end(ctx, Array::get(pids, j), Array::get(pnames, j))\n          j = j + 1\n        }\n        let mut mi = 0\n        while mi < Array::length(snap) {\n          if Array::get(ctx.remaining, mi) < Array::get(minrem, mi) {\n            Array::set(minrem, mi, Array::get(ctx.remaining, mi))\n          } else {\n            ()\n          }\n          mi = mi + 1\n        }\n        a = a + 1\n      }\n      restore_prefix(ctx.remaining, minrem)\n      0\n    },\n    _ => 0\n  }\n}\n\nexport fn pc_count(ctx: PCtx, scope: Map[String, Int], expr: Expr) -> Int {\n  match expr {\n    EInt(_) => 0,\n    EFloat(_) => 0,\n    EString(_) => 0,\n    EBool(_) => 0,\n    EUnit => 0,\n    EStringInterp(_) => 0,\n    EIdent(x, _) => pc_count_use(ctx, scope, x),\n    ECall(callee, args, _) => {\n      match callee {\n        EIdent(f, _) => if is_borrow_arg0_call(f) {\n          0\n        } else {\n          pc_count_borrow(ctx, scope, f)\n        }\n        ,\n        _ => pc_count(ctx, scope, callee)\n      }\n      let is_index = match callee {\n        EIdent(f, _) => is_borrow_arg0_call(f),\n        _ => false\n      }\n      let mut i = 0\n      while i < Array::length(args) {\n        let arg = Array::get(args, i)\n        if is_index && i == 0 {\n          match arg {\n            EIdent(obj, _) => pc_count_borrow(ctx, scope, obj),\n            _ => pc_count(ctx, scope, arg)\n          }\n        } else {\n          pc_count(ctx, scope, arg)\n        }\n        i = i + 1\n      }\n      0\n    },\n    EDot(obj, _field, _, _) => match obj {\n      EIdent(x, _) => pc_count_borrow(ctx, scope, x),\n      _ => pc_count(ctx, scope, obj)\n    }\n    ,\n    ELet(name, value, body, _) => {\n      pc_count(ctx, scope, value)\n      let id = pc_declare(ctx, name, is_scalar_expr(ctx, value))\n      pc_count(ctx, Map::set(scope, name, id), body)\n    },\n    ELetMut(name, value, body, _) => {\n      pc_count(ctx, scope, value)\n      let id = pc_declare(ctx, name, is_scalar_expr(ctx, value))\n      pc_count(ctx, Map::set(scope, name, id), body)\n    },\n    ELetRec(name, value, body) => {\n      let id = pc_declare(ctx, name, false)\n      let s2 = Map::set(scope, name, id)\n      pc_count(ctx, s2, value)\n      pc_count(ctx, s2, body)\n    },\n    EAssign(_name, value, body) => {\n      pc_count(ctx, scope, value)\n      pc_count(ctx, scope, body)\n    },\n    EAssignOp(_op, _name, value, body) => {\n      pc_count(ctx, scope, value)\n      pc_count(ctx, scope, body)\n    },\n    ESeq(a, b) => {\n      pc_count(ctx, scope, a)\n      let nm = next_seq_name(ctx)\n      let _id = pc_declare(ctx, nm, is_scalar_expr(ctx, a))\n      pc_count(ctx, scope, b)\n    },\n    EBinOp(_op, l, r) => {\n      pc_count(ctx, scope, l)\n      pc_count(ctx, scope, r)\n    },\n    EUnaryOp(_op, e) => pc_count(ctx, scope, e),\n    ETuple(items) => {\n      let mut i = 0\n      while i < Array::length(items) {\n        pc_count(ctx, scope, Array::get(items, i))\n        i = i + 1\n      }\n      0\n    },\n    EArray(items) => {\n      let mut i = 0\n      while i < Array::length(items) {\n        pc_count(ctx, scope, Array::get(items, i))\n        i = i + 1\n      }\n      0\n    },\n    ERecord(_, fields, _) => {\n      let mut i = 0\n      while i < Array::length(fields) {\n        pc_count(ctx, scope, (Array::get(fields, i)).1)\n        i = i + 1\n      }\n      0\n    },\n    EMap(fields) => {\n      let mut i = 0\n      while i < Array::length(fields) {\n        pc_count(ctx, scope, (Array::get(fields, i)).1)\n        i = i + 1\n      }\n      0\n    },\n    EIf(cond, then_e, else_e) => {\n      pc_count(ctx, scope, cond)\n      let snap_u = copy_ints(ctx.uses)\n      let snap_b = copy_ints(ctx.borrows)\n      pc_count(ctx, scope, then_e)\n      let then_u = copy_ints(ctx.uses)\n      let then_b = copy_ints(ctx.borrows)\n      restore_prefix(ctx.uses, snap_u)\n      restore_prefix(ctx.borrows, snap_b)\n      pc_count(ctx, scope, else_e)\n      let mut id = 0\n      while id < Array::length(snap_u) {\n        let base_u = Array::get(snap_u, id)\n        let dt = Array::get(then_u, id) - base_u\n        let de = Array::get(ctx.uses, id) - base_u\n        Array::set(ctx.uses, id, base_u + int_max(dt, de))\n        let base_b = Array::get(snap_b, id)\n        let dtb = Array::get(then_b, id) - base_b\n        let deb = Array::get(ctx.borrows, id) - base_b\n        Array::set(ctx.borrows, id, base_b + int_max(dtb, deb))\n        id = id + 1\n      }\n      0\n    },\n    EWhile(cond, body) => {\n      pc_count(ctx, scope, cond)\n      pc_count(ctx, scope, body)\n    },\n    EReturn(e) => pc_count(ctx, scope, e),\n    ESpread(e) => pc_count(ctx, scope, e),\n    ELabeledArg(_l, _n, e) => pc_count(ctx, scope, e),\n    EBreak(opt) => match opt {\n      Some(e) => pc_count(ctx, scope, e),\n      None => 0\n    }\n    ,\n    EFn(_tp, _tb, params, _ret, _eff, fbody) => {\n      let caps = collect_free_vars(fbody, fn_param_names(params), [\n      ])\n      let mut i = 0\n      while i < Array::length(caps) {\n        pc_count_use(ctx, scope, Array::get(caps, i))\n        i = i + 1\n      }\n      0\n    },\n    EForIn(value_name, index_opt, iterable, fbody) => {\n      pc_count(ctx, scope, iterable)\n      let idv = pc_declare(ctx, value_name, false)\n      let s2 = Map::set(scope, value_name, idv)\n      let s3 = match index_opt {\n        Some(idx) => {\n          let idi = pc_declare(ctx, idx, true)\n          Map::set(s2, idx, idi)\n        },\n        None => s2\n      }\n      pc_count(ctx, s3, fbody)\n    },\n    ELoop(params, lbody) => {\n      let mut s = scope\n      let mut i = 0\n      while i < Array::length(params) {\n        let p = Array::get(params, i)\n        pc_count(ctx, scope, p.1)\n        let pid = pc_declare(ctx, p.0, is_scalar_expr(ctx, p.1))\n        s = Map::set(s, p.0, pid)\n        i = i + 1\n      }\n      pc_count(ctx, s, lbody)\n    },\n    EMatch(scrut, arms) => {\n      match scrut {\n        EIdent(sx, _) => pc_count_borrow(ctx, scope, sx),\n        _ => pc_count(ctx, scope, scrut)\n      }\n      let snap_u = copy_ints(ctx.uses)\n      let snap_b = copy_ints(ctx.borrows)\n      let max_u = zeros(Array::length(snap_u))\n      let max_b = zeros(Array::length(snap_b))\n      let mut a = 0\n      while a < Array::length(arms) {\n        let arm = Array::get(arms, a)\n        restore_prefix(ctx.uses, snap_u)\n        restore_prefix(ctx.borrows, snap_b)\n        let pnames: Array[String] = [\n        ]\n        pat_names(arm.0, pnames)\n        let mut s = scope\n        let mut k = 0\n        while k < Array::length(pnames) {\n          let nm = Array::get(pnames, k)\n          let pid = pc_declare(ctx, nm, false)\n          s = Map::set(s, nm, pid)\n          k = k + 1\n        }\n        pc_count(ctx, s, arm.1)\n        let mut id = 0\n        while id < Array::length(snap_u) {\n          let du = Array::get(ctx.uses, id) - Array::get(snap_u, id)\n          if du > Array::get(max_u, id) {\n            Array::set(max_u, id, du)\n          }\n          let db = Array::get(ctx.borrows, id) - Array::get(snap_b, id)\n          if db > Array::get(max_b, id) {\n            Array::set(max_b, id, db)\n          }\n          id = id + 1\n        }\n        a = a + 1\n      }\n      restore_prefix(ctx.uses, snap_u)\n      restore_prefix(ctx.borrows, snap_b)\n      let mut id2 = 0\n      while id2 < Array::length(snap_u) {\n        Array::set(ctx.uses, id2, Array::get(snap_u, id2) + Array::get(max_u, id2))\n        Array::set(ctx.borrows, id2, Array::get(snap_b, id2) + Array::get(max_b, id2))\n        id2 = id2 + 1\n      }\n      0\n    },\n    EHandle(hbody, arms) => {\n      let snap_u = copy_ints(ctx.uses)\n      let snap_b = copy_ints(ctx.borrows)\n      let max_u = zeros(Array::length(snap_u))\n      let max_b = zeros(Array::length(snap_b))\n      pc_count(ctx, scope, hbody)\n      let mut id0 = 0\n      while id0 < Array::length(snap_u) {\n        let du = Array::get(ctx.uses, id0) - Array::get(snap_u, id0)\n        if du > Array::get(max_u, id0) {\n          Array::set(max_u, id0, du)\n        }\n        let db = Array::get(ctx.borrows, id0) - Array::get(snap_b, id0)\n        if db > Array::get(max_b, id0) {\n          Array::set(max_b, id0, db)\n        }\n        id0 = id0 + 1\n      }\n      let mut a = 0\n      while a < Array::length(arms) {\n        let arm = Array::get(arms, a)\n        restore_prefix(ctx.uses, snap_u)\n        restore_prefix(ctx.borrows, snap_b)\n        let pnames: Array[String] = [\n        ]\n        pat_names(arm.0, pnames)\n        let mut s = scope\n        let mut k = 0\n        while k < Array::length(pnames) {\n          let nm = Array::get(pnames, k)\n          let pid = pc_declare(ctx, nm, false)\n          s = Map::set(s, nm, pid)\n          k = k + 1\n        }\n        pc_count(ctx, s, arm.1)\n        let mut id = 0\n        while id < Array::length(snap_u) {\n          let du = Array::get(ctx.uses, id) - Array::get(snap_u, id)\n          if du > Array::get(max_u, id) {\n            Array::set(max_u, id, du)\n          }\n          let db = Array::get(ctx.borrows, id) - Array::get(snap_b, id)\n          if db > Array::get(max_b, id) {\n            Array::set(max_b, id, db)\n          }\n          id = id + 1\n        }\n        a = a + 1\n      }\n      restore_prefix(ctx.uses, snap_u)\n      restore_prefix(ctx.borrows, snap_b)\n      let mut id2 = 0\n      while id2 < Array::length(snap_u) {\n        Array::set(ctx.uses, id2, Array::get(snap_u, id2) + Array::get(max_u, id2))\n        Array::set(ctx.borrows, id2, Array::get(snap_b, id2) + Array::get(max_b, id2))\n        id2 = id2 + 1\n      }\n      0\n    },\n    _ => 0\n  }\n}\n\nfn pctx_apply_borrow_retention(ctx: PCtx) -> Int {\n  let mut bid = 0\n  while bid < ctx.next_id {\n    if Array::get(ctx.borrows, bid) > 0 {\n      Array::set(ctx.uses, bid, Array::get(ctx.uses, bid) + 1)\n    } else {\n      ()\n    }\n    bid = bid + 1\n  }\n  0\n}\n\nexport fn build_perceus_plan(body: Expr) -> Array[PerceusAction] {\n  let ctx = pctx_new()\n  let empty: Map[String, Int] = Map::new()\n  pc_count(ctx, empty, body)\n  pctx_apply_borrow_retention(ctx)\n  ctx.next_id = 0\n  ctx.seq_id = 0\n  pc_emit(ctx, empty, body)\n  ctx.actions\n}\n\nfn collect_heap_ret_fns(stmts: Array[Stmt]) -> Array[String] {\n  let out: Array[String] = [\n  ]\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SLet(_, _, fname, oty, _) =>\n      match oty {\n        Some(ty) =>\n        match ty {\n          TyFn(_, ret, _) =>\n          if type_expr_is_heap(Some(ret)) {\n            Array::push(out, fname)\n          } else {\n            ()\n          },\n          _ => ()\n        },\n        None => ()\n      },\n      _ => ()\n    }\n    i = i + 1\n  }\n  out\n}\n\nexport fn elaborate_heap_params(stmts: Array[Stmt]) -> Array[Stmt] {\n  let hctx = HeapInferCtx::{\n    ctors: collect_ctor_names(stmts),\n    heap_fns: collect_heap_ret_fns(stmts),\n  }\n  let out = Array::slice(stmts, 0, 0)\n  let mut i = 0\n  while i < Array::length(stmts) {\n    let s = Array::get(stmts, i)\n    let s2 = match s {\n      SLet(a, b, n, t, e) => SLet(a, b, n, t, elaborate_rw(e, hctx)),\n      SExpr(e) => SExpr(elaborate_rw(e, hctx)),\n      _ => s\n    }\n    Array::push(out, s2)\n    i = i + 1\n  }\n  out\n}\n\nfn expr_projects_or_matches(name: String, e: Expr) -> Bool {\n  match e {\n    EDot(obj, _, _, _) =>\n    match obj {\n      EIdent(n, _) => n == name,\n      _ => expr_projects_or_matches(name, obj)\n    },\n    EMatch(scrut, arms) => {\n      let hit = match scrut {\n        EIdent(n, _) => n == name,\n        _ => expr_projects_or_matches(name, scrut)\n      }\n      if hit {\n        true\n      } else {\n        let mut i = 0\n        let mut found = false\n        while i < Array::length(arms) {\n          let (_, arm_body) = Array::get(arms, i)\n          if expr_projects_or_matches(name, arm_body) {\n            found = true\n          } else {\n            ()\n          }\n          i = i + 1\n        }\n        found\n      }\n    },\n    EHandle(body, arms) => {\n      let mut i = 0\n      let mut found = expr_projects_or_matches(name, body)\n      while i < Array::length(arms) {\n        let (_, arm_body) = Array::get(arms, i)\n        if expr_projects_or_matches(name, arm_body) {\n          found = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      found\n    },\n    ELet(_, val, body, _) =>\n    expr_projects_or_matches(name, val) || expr_projects_or_matches(name, body),\n    ELetRec(_, val, body) =>\n    expr_projects_or_matches(name, val) || expr_projects_or_matches(name, body),\n    ELetMut(_, val, body, _) =>\n    expr_projects_or_matches(name, val) || expr_projects_or_matches(name, body),\n    EAssign(_, val, cont) =>\n    expr_projects_or_matches(name, val) || expr_projects_or_matches(name, cont),\n    EAssignOp(_, _, val, cont) =>\n    expr_projects_or_matches(name, val) || expr_projects_or_matches(name, cont),\n    ESeq(a, b) =>\n    expr_projects_or_matches(name, a) || expr_projects_or_matches(name, b),\n    EIf(c, t, el) =>\n    expr_projects_or_matches(name, c) ||\n    expr_projects_or_matches(name, t) ||\n    expr_projects_or_matches(name, el),\n    EWhile(c, b) =>\n    expr_projects_or_matches(name, c) || expr_projects_or_matches(name, b),\n    EForIn(_, _, iter, body) =>\n    expr_projects_or_matches(name, iter) || expr_projects_or_matches(name, body),\n    ECall(callee, args, _) => {\n      let mut i = 0\n      let mut found = expr_projects_or_matches(name, callee)\n      while i < Array::length(args) {\n        if expr_projects_or_matches(name, Array::get(args, i)) {\n          found = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      found\n    },\n    EBinOp(_, l, r) =>\n    expr_projects_or_matches(name, l) || expr_projects_or_matches(name, r),\n    EUnaryOp(_, o) => expr_projects_or_matches(name, o),\n    EFn(_, _, _, _, _, body) => expr_projects_or_matches(name, body),\n    ETuple(elems) => {\n      let mut i = 0\n      let mut found = false\n      while i < Array::length(elems) {\n        if expr_projects_or_matches(name, Array::get(elems, i)) {\n          found = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      found\n    },\n    EArray(elems) => {\n      let mut i = 0\n      let mut found = false\n      while i < Array::length(elems) {\n        if expr_projects_or_matches(name, Array::get(elems, i)) {\n          found = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      found\n    },\n    ELoop(params, body) => {\n      let mut i = 0\n      let mut found = expr_projects_or_matches(name, body)\n      while i < Array::length(params) {\n        let (_, init) = Array::get(params, i)\n        if expr_projects_or_matches(name, init) {\n          found = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      found\n    },\n    ERecord(_, fields, _) => {\n      let mut i = 0\n      let mut found = false\n      while i < Array::length(fields) {\n        let (_, fval) = Array::get(fields, i)\n        if expr_projects_or_matches(name, fval) {\n          found = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      found\n    },\n    EMap(fields) => {\n      let mut i = 0\n      let mut found = false\n      while i < Array::length(fields) {\n        let (_, fval) = Array::get(fields, i)\n        if expr_projects_or_matches(name, fval) {\n          found = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      found\n    },\n    ELabeledArg(_, _, inner) => expr_projects_or_matches(name, inner),\n    EReturn(inner) => expr_projects_or_matches(name, inner),\n    ESpread(inner) => expr_projects_or_matches(name, inner),\n    EBreak(opt) =>\n    match opt {\n      Some(inner) => expr_projects_or_matches(name, inner),\n      None => false\n    },\n    EContinue(args) => {\n      let mut i = 0\n      let mut found = false\n      while i < Array::length(args) {\n        if expr_projects_or_matches(name, Array::get(args, i)) {\n          found = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      found\n    },\n    EInt(_) => false,\n    EFloat(_) => false,\n    EString(_) => false,\n    EBool(_) => false,\n    EIdent(_, _) => false,\n    EStringInterp(_) => false,\n    EUnit => false\n  }\n}\n\nexport fn param_is_heap_in_body(name: String, otype: Option[TypeExpr], body: Expr) -> Bool {\n  if type_expr_is_heap(otype) {\n    true\n  } else {\n    match otype {\n      None => expr_projects_or_matches(name, body),\n      Some(_) => false\n    }\n  }\n}\n\nexport fn build_perceus_plan_with_params(params: Array[(String, Option[TypeExpr])], body: Expr, borrow_ret_names: Array[String]) -> Array[PerceusAction] {\n  let ctx = pctx_new()\n  let mut bri = 0\n  while bri < Array::length(borrow_ret_names) {\n    Array::push(ctx.pctx_names, String::concat(borrow_ret_marker, Array::get(borrow_ret_names, bri)))\n    bri = bri + 1\n  }\n  let mut scope: Map[String, Int] = Map::new()\n  let mut pi = 0\n  while pi < Array::length(params) {\n    let (pname, ptype) = Array::get(params, pi)\n    let id = pc_declare(ctx, pname, !param_is_heap_in_body(pname, ptype, body))\n    scope = Map::set(scope, pname, id)\n    pi = pi + 1\n  }\n  pc_count(ctx, scope, body)\n  pctx_apply_borrow_retention(ctx)\n  ctx.next_id = 0\n  ctx.seq_id = 0\n  let mut scope2: Map[String, Int] = Map::new()\n  let param_ids = Array::slice([\n    0\n  ], 0, 0)\n  let mut pj = 0\n  while pj < Array::length(params) {\n    let (pname, _) = Array::get(params, pj)\n    let id = pe_declare(ctx, pname)\n    scope2 = Map::set(scope2, pname, id)\n    Array::push(param_ids, id)\n    pj = pj + 1\n  }\n  pc_emit(ctx, scope2, body)\n  let mut pk = 0\n  while pk < Array::length(params) {\n    let (pname, _) = Array::get(params, pk)\n    pe_scope_end(ctx, Array::get(param_ids, pk), pname)\n    pk = pk + 1\n  }\n  ctx.actions\n}\n")
}

