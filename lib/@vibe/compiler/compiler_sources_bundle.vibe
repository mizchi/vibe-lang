\\"Double::ceil\\\" {\\n      let nl = ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)\\n      if ctx.enable_rc {\\n        emit_unbox_float(buf)\\n      }\\n      emit_f64_reinterpret_i64(buf)\\n      if fname == \\\"Double::abs\\\" {\\n        emit_f64_abs(buf)\\n      } else if fname == \\\"Double::floor\\\" {\\n        emit_f64_floor(buf)\\n      } else {\\n        emit_f64_ceil(buf)\\n      }\\n      emit_i64_reinterpret_f64(buf)\\n      if ctx.enable_rc {\\n        Array::push(local_names, \\\"__fop_bits\\\")\\n        Array::push(local_names, \\\"__fop_box\\\")\\n        emit_box_float(buf, ctx, nl, nl + 1)\\n        nl + 2\\n      } else {\\n        nl\\n      }\\n    }\\n    else if fname == \\\"Double::max\\\" || fname == \\\"Double::min\\\" {\\n      let mut nl = ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)\\n      if ctx.enable_rc {\\n        emit_unbox_float(buf)\\n      }\\n      emit_f64_reinterpret_i64(buf)\\n      nl = ce(buf, Array::get(args, 1), local_names, nl, ctx, ld)\\n      if ctx.enable_rc {\\n        emit_unbox_float(buf)\\n      }\\n      emit_f64_reinterpret_i64(buf)\\n      if fname == \\\"Double::max\\\" {\\n        emit_f64_max(buf)\\n      } else {\\n        emit_f64_min(buf)\\n      }\\n      emit_i64_reinterpret_f64(buf)\\n      if ctx.enable_rc {\\n        Array::push(local_names, \\\"__fminmax_bits\\\")\\n        Array::push(local_names, \\\"__fminmax_box\\\")\\n        emit_box_float(buf, ctx, nl, nl + 1)\\n        nl + 2\\n      } else {\\n        nl\\n      }\\n    }\\n    else if fname == \\\"Char::to_int\\\" || fname == \\\"Char::from_int\\\" {\\n      // Char's runtime representation IS the (tagged) code point; both\\n      // conversions are identities. Char::from_int used to sneak through a\\n      // fallback path while Char::to_int died with \\\"undefined variable\\n      // (local): Char::to_int @call\\\" (bench/bench_char_conversion.vibe,\\n      // vibe/prelude/char.vibe's lower/upper)